{
  "name": "foil-language",
  "displayName": "Foil Language Support",
  "description": "Syntax highlighting and editor support for the Foil language.",
  "version": "0.1.0",
  "publisher": "shrine-plan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axsys-org/shrine-plan.git",
    "directory": "editor/foil-vscode"
  },
  "files": [
    "language-configuration.json",
    "syntaxes",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "foil",
    "plan",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "foil",
        "aliases": [
          "Foil",
          "foil"
        ],
        "extensions": [
          ".foil"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "foil",
        "scopeName": "source.foil",
        "path": "./syntaxes/foil.tmLanguage.json"
      }
    ]
  }
}
