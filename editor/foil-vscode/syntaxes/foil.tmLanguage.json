{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Foil",
  "scopeName": "source.foil",
  "patterns": [
    { "include": "#comments" },
    { "include": "#definitions" },
    { "include": "#tags" },
    { "include": "#numbers" },
    { "include": "#runes" },
    { "include": "#arms" },
    { "include": "#binderEquals" },
    { "include": "#members" },
    { "include": "#brackets" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.foil",
          "match": "(?<!\\S)'(?=\\s).*$"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(^\\s*)(\\+)(\\s+)([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "2": { "name": "keyword.declaration.foil" },
            "4": { "name": "entity.name.function.foil" }
          }
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "constant.other.tag.foil",
          "match": "(?:#|%|')(?=[A-Za-z_])[A-Za-z_][A-Za-z0-9_-]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.foil",
          "match": "(?<![A-Za-z0-9_-])\\d+(?![A-Za-z0-9_-])"
        }
      ]
    },
    "runes": {
      "patterns": [
        {
          "name": "keyword.control.rune.foil",
          "match": "(?<!\\S)[+|^?$=@;:&](?=\\s|\\(|$)"
        },
        {
          "name": "keyword.control.rune.foil",
          "match": "(?<!\\S)%(?=\\s|\\()"
        },
        {
          "name": "keyword.declaration.import.foil",
          "match": "(?<!\\S)-(?=\\s)"
        },
        {
          "name": "keyword.control.rune.foil",
          "match": "(?<!\\S)\\\\(?=\\s|\\()"
        }
      ]
    },
    "arms": {
      "patterns": [
        {
          "name": "keyword.operator.arm.foil",
          "match": "(?<!\\S)>(?=\\s)"
        }
      ]
    },
    "binderEquals": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.foil",
          "match": "(?<=[A-Za-z0-9_-])=(?=[A-Za-z_(])"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.foil" },
            "2": { "name": "variable.other.member.foil" }
          }
        },
        {
          "name": "punctuation.separator.namespace.foil",
          "match": "(?<=[A-Za-z0-9_-]):(?=[A-Za-z_])"
        },
        {
          "name": "punctuation.separator.path.foil",
          "match": "/"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.foil",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
