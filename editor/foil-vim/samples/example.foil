' Current Foil syntax; also used for manual highlighting checks.
/ stdlib/base

+ color
  + red :
  + blue :
  & #/red #/blue

+ palette
  + parse
    \ text=str
    ^ either[str color]
    (color/read_str text).ok_or("Unknown color.")
  + default
    ^ color
    ;/parse("red").or(color/red)

+ identity
  @ t
  \ value=(@ t)
  ^ (@ t)
  value

+ example
  = parsed | color/read_str "blue"
  ? parsed
    > .none "Unknown ""color""."
    > (./some value) (show value)

+ quoted_path '@/y/%/cards
