#import text=lib/grove/types/text

status =
  @type
  ! foil
  + ready :
  + waiting :
  & #/ready #/waiting

note =
  @role
  title: text

summary =
  @view
  #on ; ;/note
  #for ; /sys/slot/summary
  ! goo
  note => {
    show(note.title, '/sys/slot/label)
    action("Edit", become = '/sys/slot/edit)
  }

"/notes" =
  @tree
  title: "Notes"
