'  example cairn file -- exercises all runes and the trickier corners
'  of the surface syntax so highlighting can be eyeballed.

'  ---- constants (+) and tree-shaped declarations -------------------

+  point
   $  [x=nat y=nat]

+  example_point
   ^(point 3 4)

'  ---- functions (|) with binders and tall body ---------------------

+  add
   |  a=nat  b=nat
   ^  nat
   %  (if (eq a 0) b)
   (add (dec a) (inc b))
   +  add_one
      |  a=nat
      ^  nat
      (inc a)
   +  add_two
      |  a=nat
      ^  nat
      (inc (inc a))

'  ---- casts (^) wide and tall -------------------------------------

+  add_both
   |  a=nat  p=point
   ^(point (add p.x a) (add p.y a))

'  ---- type variables (@) and sum types (&) ------------------------

+  maybe
   '  @ introduces a type variable
   @  x
   '  & is sum
   &  [#some x]
      #none
   +  map
      @  x  y
      |  f={(maybe x) (maybe y)}
      ^  (maybe y)
      ?  a
         >  [#some v=x]  [#some (f v)]
         >  #none        #none
   +  or_else
      @  x
      |  def=x  a=(maybe x)
      ^  x
      ?  a
         >  [#some v=x]  v
         >  'none        def

'  ---- let bindings (=) -------------------------------------------

+  example_let
  =  > a (do-some-call b)
     > b (depends-on c)
     > c 3
  (combine a b c)

'  ---- door (;) ---------------------------------------------------

+  door
   ;  foo=nat
   +  func
      |  a=nat
      ^  nat
      (add a foo)
   +  try
      (door (add 2 foo))

'  ---- ufcs / member syntax / qualified names ---------------------

+  num  3
+  via_member  num.add(3)
+  via_qualified  (nat:add 3 num)
