#!/usr/bin/env python3
"""Run application suites against a disposable combined test fixture tree."""
import argparse
import concurrent.futures
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

from fixture_sources import materialize

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--core-root', type=Path, default=ROOT.parent)
parser.add_argument('--extras-root', type=Path, default=ROOT,
                    help='Mount catalogue, including explicitly selected test fixtures')
parser.add_argument('--mount', action='append')
parser.add_argument('--suite', action='append', help='Run only these mounted native suites (repeatable)')
parser.add_argument('--jobs', type=int, default=2)
parser.add_argument('--timeout', type=int, default=1200)
parser.add_argument('--contracts-only', action='store_true', help='Typecheck selected activation, HTTP and driver entrypoints')
parser.add_argument('--goo-application', action='store_true', help='After native checks, run the real Eden/Goo/Mash browser application gate')
args = parser.parse_args()
ROOT = args.extras_root.resolve()
sys.path.insert(0, str(args.core_root.resolve() / 'x'))
from eden_mounts import select, catalog
import test_runner as runner
mounts = select(ROOT, args.mount or list(catalog(ROOT)))
helpers = {'app_test_world', 'eden_srs', 'eden_debug', 'tests/eden_srs',
           'tests/debug_http', 'tests/grove_debugger'}
if any(m.name == 'flow-authoring' for m in mounts) and not args.contracts_only:
    # These suites include authored examples and the optional HTTP provider.
    mounts = select(ROOT, [m.name for m in mounts] + ['flow-examples'])
if args.suite:
    registered = {name for m in mounts for name in m.manifest.get('tests', {}) if name not in helpers}
    if any(m.name == 'nenex' for m in mounts):
        registered.add('nenex-document-tests')
    if any(m.name == 'flow-authoring' for m in mounts):
        registered.update(['flow-reflected-authoring-tests', 'flow-authoring-only-tests', 'cartography-publication-tests', 'flow-boundary-cost-tests'])
    unknown = set(args.suite) - registered
    if unknown:
        parser.error('unknown mounted suites: ' + ', '.join(sorted(unknown)))
# Mounted Goo consumes the same verified profile as standalone production.
# Catch stale generated Foil/CSS before a native pass can mask asset drift.
if any(m.name == 'goo' for m in mounts):
    profile_scripts = ROOT / 'mounts/goo/scripts'
    for script, options in [('sync-mash-profile.py', ['--check']),
                            ('generate-fonts.py', ['--check']),
                            ('test-sync-mash-profile.py', [])]:
        subprocess.run([sys.executable, str(profile_scripts / script), *options], check=True)
# Test-only helper dependencies do not become runtime dependencies.
if any(m.name == 'debugger' for m in mounts):
    mounts = select(ROOT, [m.name for m in mounts] + ['srs'])
if any(m.name == 'flow-authoring' for m in mounts) and not args.contracts_only and (
        not args.suite or any(name in args.suite for name in ['flow-reflected-authoring-tests', 'flow-boundary-cost-tests'])):
    # The reflected authoring fixture includes the Codex surface. This is a
    # test dependency even when that one suite is selected explicitly.
    mounts = select(ROOT, [m.name for m in mounts] + ['codex'])
    if not args.suite or 'flow-reflected-authoring-tests' in args.suite:
        mounts = select(ROOT, [m.name for m in mounts] + ['conversation'])
if any(m.name == 'flow-authoring' for m in mounts) and not args.contracts_only and (
        not args.suite or any(name.startswith('flow_cartography') or name == 'cartography-publication-tests' for name in args.suite)):
    # The example's compiled Grove boundary is a test dependency, not a runtime
    # dependency of the native flow installer.
    mounts = select(ROOT, [m.name for m in mounts] + ['graph'])
runtime = os.environ.get('WISP') or shutil.which('wisp')
if not runtime:
    parser.error('Set WISP or enter the core Nix shell')
template = runner.stage(runtime, False, args.timeout)
cache = args.core_root.resolve() / '.check'
cache.mkdir(exist_ok=True)
work = Path(tempfile.mkdtemp(prefix='extras-', dir=cache))
materialize(args.core_root, ROOT, work / 'src', {m.name for m in mounts}, native_tests=True)
groups = []
contracts = ['- http_foot']
declarations = ['+ mount_contracts']
signatures = {'activate': r'{\ namespace}either[pail namespace]',
              'http': r'{\ row[[str nat]] namespace}http_foot/config',
              'start': r'{\ nat row[str]}nat'}
for mount in mounts:
    for kind, signature in signatures.items():
        hook = mount.manifest.get(kind)
        if hook:
            alias = 'hook_' + str(len(contracts))
            contracts.append('- ' + hook['module'] + ' [at=' + alias + ']')
            declarations.extend(['  + ' + alias, '    ^ ' + signature,
                                 '    ' + alias + '/' + '/'.join(hook['entry'])])
if len(contracts) > 1:
    (work / 'src/foil/mount_contracts.foil').write_text('\n'.join(contracts + declarations) + '\n')
    (work / 'src/reaver/extras-mount-contract-tests.rvr').write_text('''(#bind std (#module std))
(#import std)
(#bind source (#module foil-source))
(#bind fixture (#module foil-test-context))
(define (check ignored)
  (define outcome (Try (lambda (ignored)
    (DeepSeq (source:compile (fixture:files 0 ["mount_contracts"]) 0 "mount_contracts") 1)) 0))
  (If (Eq 1 (Hd outcome)) (Seq (print outcome) 0) 1))
(#export check)
''')
    groups.append([dict(name='extras-mount-contract-tests', target='extras-mount-contract-tests',
                        kind='reaver', group='mount-contracts', entrypoint='check', timeout=args.timeout)])
for mount in ([] if args.contracts_only else mounts):
    suites = [dict(name='foil:' + name, target=name, kind='native',
                   group=mount.name, timeout=args.timeout)
              for name in mount.manifest.get('tests', {}) if name not in helpers
              and (not args.suite or name in args.suite)]
    if suites:
        groups.append(suites)
    if mount.name == 'debugger':
        groups.append([dict(name='foil-grove-debugger-tests', target='foil-grove-debugger-tests',
                            kind='reaver', group='grove-debugger', timeout=args.timeout)])
    if mount.name == 'nenex' and (not args.suite or 'nenex-document-tests' in args.suite):
        groups.append([dict(name='nenex-document-tests', target='nenex-document-tests', kind='reaver',
                            group='nenex-document', entrypoint='check', timeout=args.timeout)])
    if mount.name == 'flow-authoring':
        if args.suite and 'flow-boundary-cost-tests' in args.suite:
            groups.append([dict(name='flow-boundary-cost-tests', target='flow-boundary-cost-tests',
                                kind='reaver', group='flow-boundary-cost', entrypoint='check', timeout=args.timeout)])
        if args.suite and 'flow-authoring-only-tests' in args.suite:
            groups.append([dict(name='flow-authoring-only-tests', target='flow-reflected-authoring-tests',
                                kind='reaver', group='flow-authoring-only', entrypoint='check-authoring', timeout=args.timeout)])
        for name, group in [('flow-reflected-authoring-tests', 'flow-authoring-reflected'),
                            ('cartography-publication-tests', 'cartography-publication')]:
            if not args.suite or name in args.suite:
                groups.append([dict(name=name, target=name, kind='reaver',
                                    group=group, entrypoint='check', timeout=args.timeout)])
print('Extras test results: ' + str(work), flush=True)
with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
    futures = [pool.submit(runner.run_group, group, runtime, template, work, args.timeout)
               for group in groups]
    results = [future.result() for future in futures]
(work / 'results.json').write_text(json.dumps(results, indent=2))
passed = all(result['passed'] for result in results)
if passed and args.goo_application:
    application = subprocess.run([sys.executable,
        str(ROOT / 'mounts/explorer/scripts/check-integration.py'),
        '--output', str(work / 'goo-application')])
    passed = application.returncode == 0
raise SystemExit(int(not passed))
