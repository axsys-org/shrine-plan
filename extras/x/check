#!/usr/bin/env python3
"""Run application suites against a disposable combined test fixture tree."""
import argparse
import concurrent.futures
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

from fixture_sources import materialize

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--core-root', type=Path, default=ROOT.parent)
parser.add_argument('--extras-root', type=Path, default=ROOT,
                    help='Mount catalogue, including explicitly selected test fixtures')
parser.add_argument('--mount', action='append')
parser.add_argument('--suite', action='append', help='Run only these registered mounted suites (repeatable)')
parser.add_argument('--jobs', type=int, default=2)
parser.add_argument('--timeout', type=int, default=1200)
parser.add_argument('--contracts-only', action='store_true', help='Typecheck selected activation, HTTP and driver entrypoints')
parser.add_argument('--goo-application', action='store_true', help='After native checks, run the real Eden/Goo/Mash browser application gate')
args = parser.parse_args()
ROOT = args.extras_root.resolve()
sys.path.insert(0, str(args.core_root.resolve() / 'x'))
from eden_mounts import select, catalog
import test_runner as runner
mounts = select(ROOT, args.mount or list(catalog(ROOT)))
# Test-only source dependencies stay in their owners' descriptors. They never
# become runtime mount dependencies or select additional provider processes.
if not args.contracts_only:
    while True:
        names = {m.name for m in mounts}
        required = {dep for m in mounts for dep in m.manifest.get('test_dependencies', [])}
        if required <= names:
            break
        mounts = select(ROOT, sorted(names | required))
suites = []
for mount in mounts:
    suites.extend(dict(name='foil:' + name, target=name, kind='native',
                       selection=name, group=mount.name, timeout=args.timeout)
                  for name in mount.manifest.get('tests', {}))
    suites.extend(dict(dict(name=name, target=name, group=name, timeout=args.timeout),
                       **spec, selection=name)
                  for name, spec in mount.manifest.get('test_suites', {}).items())
if args.suite:
    unknown = set(args.suite) - {s['selection'] for s in suites}
    if unknown:
        parser.error('unknown mounted suites: ' + ', '.join(sorted(unknown)))
if args.contracts_only:
    suites = []
elif args.suite:
    suites = [s for s in suites if s['selection'] in args.suite]
else:
    suites = [s for s in suites if not s.get('manual')]
mounts = select(ROOT, sorted({m.name for m in mounts} |
    {dep for suite in suites for dep in suite.get('dependencies', [])}))
# Mounted Goo consumes the same verified profile as standalone production.
# Catch stale generated Foil/CSS before a native pass can mask asset drift.
if any(m.name == 'goo' for m in mounts):
    profile_scripts = ROOT / 'mounts/goo/scripts'
    for script, options in [('sync-mash-profile.py', ['--check']),
                            ('generate-fonts.py', ['--check']),
                            ('test-sync-mash-profile.py', [])]:
        subprocess.run([sys.executable, str(profile_scripts / script), *options], check=True)
runtime = os.environ.get('WISP') or shutil.which('wisp')
if not runtime:
    parser.error('Set WISP or enter the core Nix shell')
template = runner.stage(runtime, False, args.timeout)
cache = args.core_root.resolve() / '.check'
cache.mkdir(exist_ok=True)
work = Path(tempfile.mkdtemp(prefix='extras-', dir=cache))
materialize(args.core_root, ROOT, work / 'src', {m.name for m in mounts}, native_tests=True)
groups = []
contracts = ['- http_foot']
declarations = ['+ mount_contracts']
signatures = {'activate': r'{\ namespace}either[pail namespace]',
              'http': r'{\ row[[str nat]] namespace}http_foot/config',
              'start': r'{\ nat row[str]}nat'}
for mount in mounts:
    for kind, signature in signatures.items():
        hook = mount.manifest.get(kind)
        if hook:
            alias = 'hook_' + str(len(contracts))
            contracts.append('- ' + hook['module'] + ' [at=' + alias + ']')
            declarations.extend(['  + ' + alias, '    ^ ' + signature,
                                 '    ' + alias + '/' + '/'.join(hook['entry'])])
if len(contracts) > 1:
    (work / 'src/foil/mount_contracts.foil').write_text('\n'.join(contracts + declarations) + '\n')
    (work / 'src/reaver/extras-mount-contract-tests.rvr').write_text('''(#bind std (#module std))
(#import std)
(#bind source (#module foil-source))
(#bind fixture (#module foil-test-context))
(define (check ignored)
  (define outcome (Try (lambda (ignored)
    (DeepSeq (source:compile (fixture:files 0 ["mount_contracts"]) 0 "mount_contracts") 1)) 0))
  (If (Eq 1 (Hd outcome)) (Seq (print outcome) 0) 1))
(#export check)
''')
    groups.append([dict(name='extras-mount-contract-tests', target='extras-mount-contract-tests',
                        kind='reaver', group='mount-contracts', entrypoint='check', timeout=args.timeout)])
by_group = {}
for suite in suites:
    by_group.setdefault(suite['group'], []).append(suite)
groups.extend(by_group.values())
print('Extras test results: ' + str(work), flush=True)
with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
    futures = [pool.submit(runner.run_group, group, runtime, template, work, args.timeout)
               for group in groups]
    results = [future.result() for future in futures]
(work / 'results.json').write_text(json.dumps(results, indent=2))
passed = all(result['passed'] for result in results)
if passed and args.goo_application:
    application = subprocess.run([sys.executable,
        str(ROOT / 'mounts/explorer/scripts/check-integration.py'),
        '--output', str(work / 'goo-application')])
    passed = application.returncode == 0
raise SystemExit(int(not passed))
