#!/usr/bin/env python3
"""Exercise live republication against an owned disposable extras checkout."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--core-root', type=Path, default=root.parent)
parser.add_argument('--port', type=int, default=18410)
args = parser.parse_args()
work = Path(tempfile.mkdtemp(prefix='shrine-rescan-check-'))
shutil.copytree(root, work / 'extras', ignore=shutil.ignore_patterns('.git', '.check', '__pycache__'))
manifest = work / 'extras/mounts/srs/mount.json'
data = json.loads(manifest.read_text())
data['host'] = 'rescan_check.py'
manifest.write_text(json.dumps(data, indent=2) + '\n')
print('Disposable rescan checkout: ' + str(work), flush=True)
raise SystemExit(subprocess.call([str(args.core_root.resolve() / 'x/eden'),
    '--extras-root', str(work / 'extras'), '--mount', 'debugger', '--mount', 'srs',
    '--check', '--port', str(args.port), '--request-timeout', '1200', '--startup-timeout', '2400']))
