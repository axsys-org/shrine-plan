- grove_install

+ tree_pages_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'tree_pages]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing development template")
    ? (grove_install/instantiate source version
        [state.self 'app 'tree_pages] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (tree_pages_mount/failure why))
