#import text=lib/grove/types/text
#import path_type=lib/grove/types/path

state_type =
  @type
  ! foil
  block_document/document
  + read
    \ value=pail
    ^ maybe[state_type]
    ?> value=block_document/document value .none
    | ./some value
  + write
    \ value=state_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ block_document/document)

rich_type =
  @type
  ! foil
  goo/text
  + read
    \ value=pail
    ^ maybe[rich_type]
    < decoded (goo_edit/decode value)
    | ./some decoded.value
  + write
    \ value=rich_type
    ^ pail
    | goo/text/pail value
  + contract
    ^ curb
    | curb/of_type (^ goo/text/pail)

document =
  @slot

page =
  @slot

summary =
  @slot

board =
  @role
  %/document: %/state_type
  %/page: %/rich_type
  %/summary: text

save_page =
  @action
  #on ; %/board
  %/page: %/rich_type
  ! foil
  \ page=goo/text board=%/board
  ^ %/board
  ?> (./ok next) (block_document/save_page board.document page)
    | Seq[%/board] (error (pails/t "Document could not be saved: use at most 100 blocks and 64 runs per block.")) board
  | board.set_document(next).set_page(page).set_summary((str/cat_all ["Revision " (nat/show next.revision) " / " (nat/show next.blocks.len) " blocks"]))

editor =
  @view
  #on ; %/board
  #for ; /sys/slot/content
  board => {
    text("Notebook", '/sys/slot/title)
    text("Write, explore, and connect your ideas.", '/sys/slot/caption)
    group(on = board, action = %/save_page, myth = { %/page = .input(board.page) }) {
      col('/sys/slot/content) {
        input(%/page)
        action("Save document")
      }
    }
    show(board.summary, '/sys/slot/summary)
  }

text_toolbar =
  @view
  #on ; %/board
  #for ; /sys/slot/text_toolbar
  board => row('/sys/slot/overlay) {
    button("Bold", '/sys/edit/bold)
    button("Italic", '/sys/edit/italic)
    button("Underline", '/sys/edit/underline)
    button("Clear", '/sys/edit/clear)
  }

text_commands =
  @view
  #on ; %/board
  #for ; /sys/slot/text_commands
  board => col('/sys/slot/overlay) {
    button("Text", '/sys/edit/paragraph)
    button("Heading", '/sys/edit/heading)
    button("Bullet list", '/sys/edit/bullet)
    button("Code", '/sys/edit/code)
  }

"/document" =
  @tree
  %/document: block_document/initial
  %/page: (goo/text/pail (block_document/page block_document/initial))
  %/summary: "Revision 0 / 5 blocks"

source_path =
  @slot

context =
  @role
  %/source_path: path_type

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/block_document_workspace
  context => selection('/current, source = context.source_path) {
    list('/documents, source = context.source_path, selection = '/current, slot = '/sys/slot/content)
  }
