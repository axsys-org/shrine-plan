- grove_install

+ goo_examples_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'examples]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing Goo examples template")
    ? (grove_install/instantiate source version
        [state.self 'app 'examples] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (goo_examples_mount/failure why))
