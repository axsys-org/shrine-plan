' Source: ../goo/examples/access-form.goo

access_form_view =
  @view
  #on ; %/access_form_role
  #for ; "/demo/goo/views/access_form"
  ! goo
  item => {
    col("form") {
      col("header") {
        text("Project access", "title")
        opt(2) {
          text({[optionLabel]: "introductory summary"}, "Invite a teammate and choose what they can change.", "summary")
        }
      }
      col("content") {
        col("field") {
          text("Email address", "label")
          opt(1) {
            text({[optionLabel]: "email hint"}, "Use the address tied to their workspace.", "hint")
          }
          input({[label]: "Email address"}, "mara@example.invalid", "input")
          text({[optionLabel]: "validation error", [toggle]: true}, "This address already has access.", "error")
        }
        col("field") {
          text("Role", "label")
          input({[label]: "Role"}, "Contributor", "input")
          opt(2) {
            text({[optionLabel]: "role hint"}, "Can edit content, but cannot manage billing.", "hint")
          }
        }
      }
      row({[grow]: 0}, "actions") {
        button({[primary]: true}, "Save access", "action/primary")
        button("Cancel", "action/secondary")
      }
    }
  }

