  ! goo
  item => {
    col("content") {
      text("Index updates are delayed", "title")
      text("major", "badge")
      text("mitigating", "status")
      text("Backlog is draining.", "summary")
      col("content") {
        col("identity") {
          row("title") {
            text("indexer", "title")
            text("degraded", "status")
          }
          text("staging", "badge")
          opt(1) {
            text("0.8.4", "metadata")
          }
          opt(2) {
            text("Maintains namespace search indexes.", "summary")
          }
        }
      }
      col("identity") {
        row("identity") {
          avatar("MC", "avatar")
          text("Mara Chen", "title")
        }
        row("identity") {
          avatar("SR", "avatar")
          text("Sol Reyes", "title")
        }
      }
      col("collection") {
        col("field") {
          row("field") {
            text("Time", "label")
            text("2026-09-18T13:50:00Z", "value")
          }
          row("field") {
            text("Text", "label")
            text("Delay detected", "value")
          }
        }
        col("field") {
          row("field") {
            text("Time", "label")
            text("2026-09-18T14:10:00Z", "value")
          }
          row("field") {
            text("Text", "label")
            text("Queue capacity increased", "value")
          }
        }
      }
      row("field") {
        text("Mitigation", "label")
        text("Extra worker online", "value")
      }
      row("field") {
        text("Next update", "label")
        text("2026-09-18T14:40:00Z", "value")
      }
    }
  }

