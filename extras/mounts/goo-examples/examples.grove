namespace_inspector_key =
  @slot

namespace_inspector_role =
  @role
  %/namespace_inspector_key: text

' Source: ../goo/examples/namespace-inspector.goo

namespace_inspector_view =
  @view
  #on ; %/namespace_inspector_role
  #for ; "/demo/goo/views/namespace_inspector"
  ! goo
  item => {
    col("inspector") {
      row("header") {
        text("[Unicode]", "icon")
        text("/projects/aurora", "title")
      }
      col("content") {
        col("field") {
          text("Reachable closure", "label")
          row({[grow]: 0}, "value") {
            text("128", "value")
            text("KiB", "unit")
            opt(1) {
              text({[optionLabel]: "value qualifier"}, "reachable", "qualifier")
            }
            text("pinned", "status")
          }
          opt(2) {
            text({[optionLabel]: "provenance"}, "computed at /sys/index/closure", "provenance")
          }
        }
        col("field") {
          text("Root hash", "label")
          row("value") {
            text({[maxIdeal]: 205}, "a04b7f92...d8e1", "value")
            button("Copy", "action/copy")
          }
        }
        col("field") {
          text("Inspection result", "label")
          code(escaped("pin-count: 12\n             root: committed"), "code")
          opt(1) {
            text({[optionLabel]: "evaluation output"}, "ok  /  12 reachable pins", "output")
          }
          text("0 dangling references", "diagnostic")
        }
      }
      row({[grow]: 0}, "actions") {
        button({[primary]: true}, "Open root", "action")
        opt(2) {
          button({[optionLabel]: "history action"}, "History", "action")
        }
      }
      opt(2) {
        col({[optionLabel]: "danger zone"}, "danger-zone") {
          text("Destructive operations", "label")
          button("Remove root", "action/destructive")
        }
      }
    }
  }

"/namespace_inspector" =
  @tree
  lede: "namespace-inspector"
  %/namespace_inspector_key: "namespace-inspector"

