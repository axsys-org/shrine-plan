g094_repository_overview_object_view =
  @view
  #on ; %/g094_repository_overview_object_role
  #for ; "/demo/goo/views/g094_repository_overview_object"
  ! goo
  item => {
    col("content") {
      col("header") {
        text("Glasshouse", "label")
        text("goo", "title")
        text("public", "badge")
        opt(1) {
          text("Semantic object views and their renderer.", "summary")
        }
        opt(2) {
          text("Haskell", "metadata")
        }
      }
      opt(1) {
        text("Goo separates object meaning from rendering geometry.", "body")
      }
      col("section") {
        text("Branches", "heading")
        col("field") {
          col("field") {
            row("field") {
              text("Name", "label")
              text("main", "value")
            }
            row("field") {
              text("Checks", "label")
              text("passed", "value")
            }
          }
          col("field") {
            row("field") {
              text("Name", "label")
              text("identity-boundary", "value")
            }
            row("field") {
              text("Checks", "label")
              text("running", "value")
            }
          }
        }
      }
      row("section") {
        col("header") {
          text("Glasshouse", "label")
          text("goo", "title")
          text("public", "badge")
          opt(1) {
            text("Semantic object views and their renderer.", "summary")
          }
          opt(2) {
            text("Haskell", "metadata")
          }
        }
        col("collection") {
          col("field") {
            text("0.8.4", "title")
            text("stable", "status")
            text("2026-09-18", "timestamp")
            text("3", "metadata")
          }
          col("field") {
            text("0.9.0-rc1", "title")
            text("prerelease", "status")
            text("2026-09-19", "timestamp")
            text("2", "metadata")
          }
        }
      }
      col("section") {
        text("Contributors", "heading")
        col("collection") {
          row("identity") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
          row("identity") {
            avatar("IP", "avatar")
            text("Ivo Park", "title")
          }
          row("identity") {
            avatar("SR", "avatar")
            text("Sol Reyes", "title")
          }
        }
      }
      col("section") {
        col("content") {
          col("identity") {
            text("GOO-148", "label")
            text("Keep copy actions beside their values", "title")
            text("open", "status")
          }
          text("high", "badge")
          row("identity") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
          opt(1) {
            col("metadata") {
              text("layout", "metadata")
              text("regression", "metadata")
            }
          }
        }
      }
      col("metadata") {
        row("field") {
          text("Author", "label")
          row("value") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
        }
        row("field") {
          text("Summary", "label")
          text("Retain public slots", "value")
        }
        row("field") {
          text("Time", "label")
          text("2026-09-18T14:20:00Z", "value")
        }
      }
    }
  }

