                text("Kind", "label")
                text("chat", "value")
              }
              row("field") {
                text("Value", "label")
                text("mara", "value")
              }
            }
          }
        }
      }
      col("content") {
        text("ORD-1042", "header")
        col("collection") {
          col("field") {
            col("identity") {
              avatar("fixture:product/canopy", "avatar")
