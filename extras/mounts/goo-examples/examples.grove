g083_pull_request_review_summary_view =
  @view
  #on ; %/g083_pull_request_review_summary_role
  #for ; "/demo/goo/views/g083_pull_request_review_summary"
  ! goo
  item => {
    col("content") {
      text("Keep compound identities intact", "title")
      text("open", "status")
      row("identity") {
        text("identity-boundary", "value")
        text("main", "value")
      }
      row("identity") {
        avatar("MC", "avatar")
        text("Mara Chen", "title")
      }
      col("field") {
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("IP", "avatar")
              text("Ivo Park", "title")
            }
          }
          row("field") {
            text("Decision", "label")
            text("approved", "value")
          }
        }
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("SR", "avatar")
              text("Sol Reyes", "title")
            }
          }
          row("field") {
            text("Decision", "label")
            text("pending", "value")
          }
        }
      }
      col("field") {
        col("field") {
          row("field") {
            text("Name", "label")
            text("tests", "value")
          }
          row("field") {
            text("State", "label")
            text("passed", "value")
          }
        }
        col("field") {
          row("field") {
            text("Name", "label")
            text("lint", "value")
          }
          row("field") {
            text("State", "label")
            text("passed", "value")
          }
        }
      }
      text("Conflicts: false", "notice")
      col("metadata") {
        row("field") {
          text("Files", "label")
          text("4", "value")
        }
        row("field") {
          text("Added", "label")
          text("82", "value")
        }
        row("field") {
          text("Removed", "label")
          text("19", "value")
        }
      }
    }
  }

