g089_split_shipment_order_view =
  @view
  #on ; %/g089_split_shipment_order_role
  #for ; "/demo/goo/views/g089_split_shipment_order"
  ! goo
  item => {
    col("content") {
      col("header") {
        text("ORD-1042", "header")
        col("collection") {
          col("field") {
            col("identity") {
              avatar("fixture:product/canopy", "avatar")
              text("Canopy sensor", "title")
              text("Fern / indoor", "subtitle")
            }
            text("2", "value")
            row("field") {
              text("Unit price", "label")
              text("$49.00", "value")
            }
            row("field") {
              text("Subtotal", "label")
              text("$98.00", "value")
            }
          }
          col("field") {
            col("identity") {
              avatar("fixture:product/canopy", "avatar")
              text("Mounting bracket", "title")
              text("Standard", "subtitle")
            }
            text("2", "value")
            row("field") {
              text("Unit price", "label")
              text("$9.00", "value")
            }
            row("field") {
              text("Subtotal", "label")
              text("$18.00", "value")
            }
          }
        }
        row("field") {
          text("Subtotal", "label")
          text("$116.00", "value")
        }
      }
      col("collection") {
        row("section") {
          col("identity") {
            text("Fixture Parcel", "title")
            text("in-transit", "status")
            row("field") {
              text("Tracking", "label")
              text("GH-7294-4810", "value")
              button("Copy", "action/copy")
            }
            row("field") {
              text("Origin", "label")
              text("Assembly studio", "value")
            }
            col("field") {
              text("Receiving studio", "label")
              row("value") {
                text("Ivo Park", "title")
                text(escaped("Glasshouse\nBuilding C\n17 Example Court\nSampleton CA 90000\nUS"), "body")
              }
              opt(1) {
                text("Use the side entrance.", "hint")
              }
              text("unverified", "status")
            }
            row("field") {
              text("Last update", "label")
              text("2026-09-18T10:30:00Z", "value")
            }
            opt(1) {
              row("field") {
                text("Estimated arrival", "label")
                text("2026-09-22", "value")
              }
            }
          }
          col("field") {
            col("field") {
              row("field") {
                text("Sku", "label")
                text("CAN-02", "value")
              }
              row("field") {
                text("Quantity", "label")
                text("1", "value")
              }
            }
          }
        }
        row("section") {
          col("identity") {
            text("Fixture Parcel", "title")
            text("preparing", "status")
            row("field") {
              text("Tracking", "label")
              text("GH-7294-4811", "value")
              button("Copy", "action/copy")
            }
            row("field") {
              text("Origin", "label")
              text("Assembly studio", "value")
            }
            col("field") {
              text("Receiving studio", "label")
              row("value") {
                text("Ivo Park", "title")
                text(escaped("Glasshouse\nBuilding C\n17 Example Court\nSampleton CA 90000\nUS"), "body")
              }
              opt(1) {
                text("Use the side entrance.", "hint")
              }
              text("unverified", "status")
            }
            row("field") {
              text("Last update", "label")
              text("2026-09-18T10:30:00Z", "value")
            }
          }
          col("field") {
            col("field") {
              row("field") {
                text("Sku", "label")
                text("CAN-02", "value")
              }
              row("field") {
                text("Quantity", "label")
                text("1", "value")
              }
            }
            col("field") {
              row("field") {
                text("Sku", "label")
                text("BRK-01", "value")
              }
              row("field") {
                text("Quantity", "label")
                text("2", "value")
              }
            }
          }
        }
      }
      col("section") {
        text("Unallocated items", "heading")
        text("None", "metadata")
      }
    }
  }

