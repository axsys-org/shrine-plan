g097_device_diagnostic_object_view =
  @view
  #on ; %/g097_device_diagnostic_object_role
  #for ; "/demo/goo/views/g097_device_diagnostic_object"
  ! goo
  item => {
    col("content") {
      col("header") {
        text("North studio sensor", "title")
        text("online", "status")
        opt(1) {
          text("Canopy v2", "subtitle")
        }
        opt(2) {
          text("CAN-02-1048", "metadata")
        }
        opt(2) {
          text("2026-09-18T14:20:00Z", "timestamp")
        }
      }
      col("collection") {
        col("field") {
          text("Temperature", "label")
          text("23.4", "value")
          text(" deg C", "unit")
          text("current", "status")
        }
        col("field") {
          text("Humidity", "label")
          text("48", "value")
          text("%", "unit")
          text("current", "status")
        }
      }
      col("content") {
        row("field") {
          text("Sample interval seconds", "label")
          text("30", "value")
        }
        row("field") {
          text("Upload interval seconds", "label")
          text("60", "value")
        }
      }
      row("field") {
        text("Firmware", "label")
        text("2.3.1", "value")
      }
      row("field") {
        text("Firmware update", "label")
        text("2.3.2", "value")
      }
      text("complete", "status")
      col("field") {
        col("field") {
          row("field") {
            text("Name", "label")
            text("Sensor bus", "value")
          }
          row("field") {
            text("State", "label")
            text("passed", "value")
          }
        }
        col("field") {
          row("field") {
            text("Name", "label")
            text("Battery", "value")
          }
          row("field") {
            text("State", "label")
            text("warning", "value")
          }
        }
      }
      opt(1) {
        code(escaped("Boot complete\nBattery at 18%"), "code")
      }
    }
  }

