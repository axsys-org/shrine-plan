g081_person_organizational_profile_view =
  @view
  #on ; %/g081_person_organizational_profile_role
  #for ; "/demo/goo/views/g081_person_organizational_profile"
  ! goo
  item => {
    col("content") {
      col("header") {
        row("identity") {
          avatar("MC", "avatar")
          col("identity") {
            text("Mara Chen", "title")
            text("available", "status")
            opt(1) {
              text("Runtime engineer", "subtitle")
            }
            opt(2) {
              text("Infrastructure", "metadata")
            }
          }
        }
        opt(1) {
          text("Builds small systems that compose.", "summary")
        }
        opt(2) {
          col("field") {
            col("field") {
              row("field") {
                text("Kind", "label")
                text("email", "value")
              }
              row("field") {
                text("Value", "label")
                text("mara@example.invalid", "value")
              }
