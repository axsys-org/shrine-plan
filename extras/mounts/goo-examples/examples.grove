g095_document_review_object_view =
  @view
  #on ; %/g095_document_review_object_role
  #for ; "/demo/goo/views/g095_document_review_object"
  ! goo
  item => {
    col("content") {
      col("header") {
        text("Shrine field notes", "title")
        text("draft", "status")
        opt(1) {
          row("metadata") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
        }
        opt(2) {
          text("12", "badge")
        }
        opt(2) {
          text("2026-09-18T14:20:00Z", "timestamp")
        }
      }
      row("field") {
        text("Revision", "label")
        text("12", "value")
      }
      text("in-review", "status")
      text("A namespace value should retain its identity when its presentation changes.", "body")
      col("field") {
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("IP", "avatar")
              text("Ivo Park", "title")
            }
          }
          row("field") {
            text("State", "label")
            text("approved", "value")
          }
        }
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("SR", "avatar")
              text("Sol Reyes", "title")
            }
          }
          row("field") {
            text("State", "label")
            text("requested", "value")
          }
        }
      }
      col("collection") {
        col("section") {
          text("section:boundaries", "label")
          row("author") {
            avatar("IP", "avatar")
            text("Ivo Park", "title")
          }
          text("Keep the identity wrapper explicit.", "body")
          text("Resolved: false", "status")
        }
      }
      col("section") {
        col("content") {
          row("identity") {
            text("document", "icon")
            text("greenpaper.typ", "label")
          }
          opt(1) {
            text("86016", "value")
          }
          opt(2) {
            text("2026-09-18T14:20:00Z", "timestamp")
          }
          text("synced", "status")
        }
      }
    }
  }

