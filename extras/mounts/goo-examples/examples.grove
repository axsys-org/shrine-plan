  #on ; %/g093_customer_account_object_role
  #for ; "/demo/goo/views/g093_customer_account_object"
  ! goo
  item => {
    col("content") {
      text("Glasshouse", "title")
      text("Studio", "badge")
      text("active", "status")
      col("identity") {
        row("identity") {
          avatar("MC", "avatar")
          col("identity") {
            text("Mara Chen", "title")
            text("available", "status")
            opt(1) {
              text("Runtime engineer", "subtitle")
            }
            opt(2) {
              text("Infrastructure", "metadata")
            }
          }
        }
        opt(1) {
          text("Builds small systems that compose.", "summary")
        }
        opt(2) {
          col("field") {
            col("field") {
              row("field") {
                text("Kind", "label")
                text("email", "value")
              }
              row("field") {
                text("Value", "label")
                text("mara@example.invalid", "value")
              }
            }
            col("field") {
              row("field") {
                text("Kind", "label")
                text("chat", "value")
              }
              row("field") {
                text("Value", "label")
                text("mara", "value")
              }
            }
          }
        }
      }
      col("section") {
        text("Contacts", "heading")
        col("collection") {
          col("content") {
            row("identity") {
              avatar("MC", "avatar")
              text("Mara Chen", "title")
            }
            row("metadata") {
              text("mara@example.invalid", "value")
              opt(1) {
                text("Glasshouse", "metadata")
              }
            }
            text("Selected: false", "status")
          }
          col("content") {
            row("identity") {
              avatar("IP", "avatar")
              text("Ivo Park", "title")
            }
            row("metadata") {
              text("ivo@example.invalid", "value")
              opt(1) {
                text("Glasshouse", "metadata")
              }
            }
            text("Selected: false", "status")
          }
        }
      }
      col("section") {
        text("Subscriptions", "heading")
        col("field") {
          col("field") {
            row("field") {
              text("Name", "label")
              text("Namespace hosting", "value")
            }
            row("field") {
              text("State", "label")
              text("active", "value")
            }
            row("field") {
              text("Renews", "label")
              text("2026-10-01", "value")
            }
          }
        }
      }
      col("section") {
        text("Open tickets", "heading")
        col("field") {
          col("field") {
            row("field") {
              text("Number", "label")
              text("SUP-84", "value")
            }
            row("field") {
              text("Subject", "label")
              text("Shared snapshot access", "value")
            }
            row("field") {
              text("State", "label")
              text("open", "value")
            }
          }
        }
      }
      col("section") {
        text("Invoices", "heading")
        col("collection") {
          col("content") {
            text("INV-1042", "title")
            text("partially-paid", "status")
            row("identity") {
              avatar("MC", "avatar")
              text("Mara Chen", "title")
            }
            row("field") {
              text("Period", "label")
              text("September 2026", "value")
            }
            row("field") {
              text("Total", "label")
              text("$119.48", "value")
            }
            row("field") {
              text("Paid", "label")
              text("$50.00", "value")
            }
            row("field") {
              text("Balance", "label")
              text("$69.48", "value")
            }
            row("field") {
              text("Due", "label")
              text("2026-10-01", "value")
            }
          }
        }
      }
    }
  }

