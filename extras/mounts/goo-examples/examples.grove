' Source: ../goo/examples/g091-project-overview-object.goo

g091_project_overview_object_view =
  @view
  #on ; %/g091_project_overview_object_role
  #for ; "/demo/goo/views/g091_project_overview_object"
  ! goo
  item => {
    col("content") {
      text("Aurora", "title")
      text("active", "status")
      text("Make namespace values inspectable.", "summary")
      col("identity") {
        text("Lead", "label")
        row("identity") {
          avatar("MC", "avatar")
          text("Mara Chen", "title")
        }
        opt(1) {
          text("Runtime engineer", "metadata")
        }
      }
      col("section") {
        text("Milestone", "heading")
        text("Inspector preview", "title")
        bar({[max]: 10, [value]: 6}, "6 / 10", "progress")
        text("2026-09-30", "timestamp")
      }
      col("section") {
        col("title") {
          text("hexagon", "icon")
          text("Infrastructure", "title")
          text("3 members", "qualifier")
        }
        opt(1) {
          text("Shared runtime and namespace tools.", "summary")
        }
        opt(2) {
          row("metadata") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
        }
      }
      col("section") {
        col("content") {
          col("identity") {
            text("GOO-148", "label")
            text("Keep copy actions beside their values", "title")
            text("open", "status")
          }
          text("high", "badge")
          row("identity") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
          opt(1) {
            col("metadata") {
              text("layout", "metadata")
              text("regression", "metadata")
            }
          }
        }
      }
      col("section") {
        col("content") {
          row("identity") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
          text("committed", "body")
          col("content") {
            row("identity") {
              text("document", "icon")
              text("greenpaper.typ", "label")
            }
            opt(1) {
              text("12", "badge")
            }
            opt(2) {
              text("Typst document", "metadata")
            }
          }
          text("2026-09-18T14:20:00Z", "timestamp")
        }
      }
    }
  }

