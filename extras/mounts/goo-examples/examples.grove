g099_saved_query_object_view =
  @view
  #on ; %/g099_saved_query_object_role
  #for ; "/demo/goo/views/g099_saved_query_object"
  ! goo
  item => {
    col("content") {
      text("Large pinned roots", "title")
      text("Find root values with more than ten reachable pins.", "summary")
      text("team", "status")
      col("collection") {
        row("field") {
          text("min_pins", "label")
          text("10", "value")
        }
        row("field") {
          text("owner", "label")
          text("Not set", "value")
        }
      }
      code("roots where reachable_pins > $min_pins", "code")
      text("current", "status")
      col("section") {
        text("ready", "status")
        col("collection") {
          col("field") {
            col("field") {
              text("Name", "label")
              text("inspector", "value")
            }
            col("field") {
              text("Pins", "label")
              text("12", "value")
            }
            col("field") {
              text("Owner", "label")
              row("value") {
                avatar("MC", "avatar")
                text("Mara Chen", "title")
              }
            }
          }
          col("field") {
            col("field") {
              text("Name", "label")
              text("renderer", "value")
            }
            col("field") {
              text("Pins", "label")
              text("28", "value")
            }
            col("field") {
              text("Owner", "label")
              row("value") {
                avatar("IP", "avatar")
                text("Ivo Park", "title")
              }
            }
