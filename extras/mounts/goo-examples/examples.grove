              text("Standard", "subtitle")
            }
            text("2", "value")
            row("field") {
              text("Unit price", "label")
              text("$9.00", "value")
            }
            row("field") {
              text("Subtotal", "label")
              text("$18.00", "value")
            }
          }
        }
        row("field") {
          text("Subtotal", "label")
          text("$116.00", "value")
        }
      }
      col("field") {
        row("field") {
          text("Subtotal", "label")
          text("$116.00", "value")
        }
        row("field") {
          text("Discount", "label")
          text("$10.00", "value")
        }
        row("field") {
          text("Tax", "label")
          text("$8.48", "value")
        }
        row("field") {
          text("Shipping", "label")
          text("$5.00", "value")
        }
        row("field") {
          text("Total", "label")
          text("$119.48", "value")
        }
      }
      col("section") {
        text("Receiving studio", "label")
        row("value") {
          text("Ivo Park", "title")
          text(escaped("Glasshouse\nBuilding C\n17 Example Court\nSampleton CA 90000\nUS"), "body")
        }
        opt(1) {
          text("Use the side entrance.", "hint")
        }
        text("unverified", "status")
      }
      col("section") {
        col("field") {
          row("field") {
            text("Reference", "label")
