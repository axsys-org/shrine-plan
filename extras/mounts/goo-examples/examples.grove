' Source: ../goo/examples/g050-message-content-card.goo

g050_message_content_card_view =
  @view
  #on ; %/g050_message_content_card_role
  #for ; "/demo/goo/views/g050_message_content_card"
  ! goo
  item => {
    row("content") {
      col("header") {
        row("identity") {
          avatar("IP", "avatar")
          text("Ivo Park", "title")
        }
        text("2026-09-18T14:18:00Z", "timestamp")
        text("Edited: false", "status")
      }
      col("content") {
        text("The ownership boundaries look right. Could you check the narrow view?", "body")
        opt(1) {
          col("collection") {
            col("field") {
              row("field") {
                text("Name", "label")
                text("notes.txt", "value")
              }
              row("field") {
                text("Kind", "label")
                text("text", "value")
              }
              row("field") {
                text("Size bytes", "label")
                text("2104", "value")
              }
              row("field") {
                text("State", "label")
                text("ready", "value")
              }
            }
          }
        }
        opt(2) {
          col("metadata") {
            col("field") {
              row("field") {
                text("Emoji", "label")
                text("[yes]", "value")
              }
              row("field") {
                text("Count", "label")
                text("2", "value")
              }
            }
          }
        }
      }
    }
  }

