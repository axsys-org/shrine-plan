        opt(1) {
          row({[grow]: 0, [optionLabel]: "byline"}, "metadata") {
            text("Mara Chen", "author")
            opt(1) {
              text({[optionLabel]: "timestamp"}, "23 Sep 2026", "timestamp")
            }
          }
