  @view
  #on ; %/g052_measurement_with_evidence_role
  #for ; "/demo/goo/views/g052_measurement_with_evidence"
  ! goo
  item => {
    col("content") {
      text("Round-trip latency", "label")
      row("value") {
        text("18.4", "value")
        text("ms", "unit")
      }
      text("-2.5 ms", "delta")
      opt(1) {
        col("range") {
          row("field") {
            text("Low", "label")
            text("14.0", "value")
          }
          row("field") {
            text("High", "label")
            text("31.2", "value")
          }
        }
      }
      opt(2) {
        text("240", "qualifier")
      }
      opt(2) {
        text("2026-09-18T14:20:00Z", "timestamp")
      }
      opt(2) {
        text("/services/indexer/observations/latency", "provenance")
      }
      text("current", "status")
    }
  }

