  #on ; %/g054_structured_postal_address_role
  #for ; "/demo/goo/views/g054_v2_structured_postal_address"
  ! goo
  item => {
    col("field") {
      text("Receiving studio", "label")
      row("value") {
        text("Ivo Park", "title")
        text(escaped("Glasshouse\nBuilding C\n17 Example Court\nSampleton CA 90000\nUS"), "body")
      }
      opt(1) {
        text("Use the side entrance.", "hint")
      }
      text("needs-review", "status")
    }
  }

