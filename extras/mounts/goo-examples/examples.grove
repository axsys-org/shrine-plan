' Source: ../goo/examples/g100-multi-object-change-proposal.goo

g100_multi_object_change_proposal_view =
  @view
  #on ; %/g100_multi_object_change_proposal_role
  #for ; "/demo/goo/views/g100_multi_object_change_proposal"
  ! goo
  item => {
    col("content") {
      text("Retain release snapshots for longer", "title")
      text("awaiting-approval", "status")
      row("identity") {
        avatar("MC", "avatar")
        text("Mara Chen", "title")
      }
      col("collection") {
        col("field") {
          row("field") {
            text("Path", "label")
            text("/policies/retention/days", "value")
            button("Copy", "action/copy")
          }
          col("field") {
            text("Before", "label")
            text("30", "value")
          }
          col("field") {
            text("After", "label")
            text("45", "value")
          }
        }
        col("field") {
          row("field") {
            text("Path", "label")
            text("/policies/retention/exceptions", "value")
            button("Copy", "action/copy")
          }
          col("field") {
            text("Before", "label")
            text("[]", "value")
          }
          col("field") {
            text("After", "label")
            col("value") {
              text("tag:release", "value")
            }
          }
        }
      }
      col("section") {
        text("/policies/retention", "section")
        text("/jobs/prune-snapshots", "section")
      }
      col("field") {
        col("field") {
          row("field") {
            text("Check", "label")
            text("schema", "value")
          }
          row("field") {
            text("State", "label")
            text("passed", "value")
          }
        }
        col("field") {
          row("field") {
            text("Check", "label")
            text("estimated-capacity", "value")
          }
          row("field") {
            text("State", "label")
            text("passed", "value")
          }
        }
      }
      col("field") {
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("IP", "avatar")
              text("Ivo Park", "title")
            }
          }
          row("field") {
            text("State", "label")
            text("approved", "value")
          }
        }
        col("field") {
          row("field") {
            text("Person", "label")
            row("value") {
              avatar("SR", "avatar")
              text("Sol Reyes", "title")
            }
          }
          row("field") {
            text("State", "label")
            text("pending", "value")
          }
        }
      }
      col("section") {
        col("field") {
          row("field") {
            text("Kind", "label")
            text("reschedule-job", "value")
          }
          row("field") {
            text("Target", "label")
            text("/jobs/prune-snapshots", "value")
          }
        }
      }
      row("field") {
        text("Committed version", "label")
        text("Not set", "value")
      }
    }
  }

