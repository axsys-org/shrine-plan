g078_experiment_run_comparison_view =
  @view
  #on ; %/g078_experiment_run_comparison_role
  #for ; "/demo/goo/views/g078_experiment_run_comparison"
  ! goo
  item => {
    col("content") {
      text("Compact identity trial", "title")
      text("complete", "status")
      text("A named identity preserves outer spacing under omission.", "summary")
      col("content") {
        row("field") {
          text("Baseline", "label")
          text("flat boundary", "value")
        }
        row("field") {
          text("Treatment", "label")
          text("named identity", "value")
        }
        col("collection") {
          col("field") {
            text("Correct outer edge", "label")
            text("31", "value")
            text("40", "value")
            text("cases", "unit")
          }
        }
      }
      row("field") {
        text("Sample count", "label")
        text("40", "value")
      }
      text("fixture-only", "status")
      opt(1) {
        text("Illustrative results, not an empirical study.", "metadata")
      }
    }
  }

