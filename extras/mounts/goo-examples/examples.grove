g085_typed_object_version_diff_view =
  @view
  #on ; %/g085_typed_object_version_diff_role
  #for ; "/demo/goo/views/g085_typed_object_version_diff"
  ! goo
  item => {
    col("content") {
      col("header") {
        text("Shrine field notes", "title")
        text("draft", "status")
        opt(1) {
          row("metadata") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
        }
        opt(2) {
          text("12", "badge")
        }
        opt(2) {
          text("2026-09-18T14:20:00Z", "timestamp")
        }
      }
      col("metadata") {
        row("field") {
          text("Before version", "label")
          text("11", "value")
        }
        row("field") {
          text("After version", "label")
          text("12", "value")
        }
        row("author") {
          avatar("MC", "avatar")
          text("Mara Chen", "title")
        }
      }
      col("collection") {
        col("field") {
          text("summary", "label")
          text("modified", "status")
          col("field") {
            text("Before", "label")
            text("Initial notes", "value")
          }
          col("field") {
            text("After", "label")
            text("A proposal for a small, continuous namespace.", "value")
          }
        }
        col("field") {
          text("reviewer", "label")
          text("added", "status")
          col("field") {
            text("Before", "label")
            text("Not set", "value")
          }
          col("field") {
            text("After", "label")
            row("value") {
              avatar("IP", "avatar")
              text("Ivo Park", "title")
            }
          }
        }
        col("field") {
          text("draft_note", "label")
          text("removed", "status")
          col("field") {
            text("Before", "label")
            text("TODO examples", "value")
          }
          col("field") {
            text("After", "label")
            text("Not set", "value")
          }
        }
      }
    }
  }

