' Source: ../goo/examples/g061-team-roster.goo

g061_team_roster_view =
  @view
  #on ; %/g061_team_roster_role
  #for ; "/demo/goo/views/g061_team_roster"
  ! goo
  item => {
    row("content") {
      col("header") {
        col("title") {
          text("hexagon", "icon")
          text("Infrastructure", "title")
          text("3 members", "qualifier")
        }
        opt(1) {
          text("Shared runtime and namespace tools.", "summary")
        }
        opt(2) {
          row("metadata") {
            avatar("MC", "avatar")
            text("Mara Chen", "title")
          }
        }
      }
      col("collection") {
        col("field") {
          row("identity") {
            avatar("MC", "avatar")
            col("identity") {
              text("Mara Chen", "title")
              text("available", "status")
              opt(1) {
                text("Runtime engineer", "subtitle")
              }
              opt(2) {
                text("Infrastructure", "metadata")
              }
            }
          }
          text("Lead", "status")
          opt(1) {
            text("2026-08-01", "metadata")
          }
        }
        col("field") {
          row("identity") {
            avatar("IP", "avatar")
            col("identity") {
              text("Ivo Park", "title")
              text("away", "status")
              opt(1) {
                text("Designer", "subtitle")
              }
              opt(2) {
                text("Infrastructure", "metadata")
              }
            }
          }
          text("Contributor", "status")
          opt(1) {
            text("2026-08-12", "metadata")
          }
        }
        col("field") {
          row("identity") {
            avatar("SR", "avatar")
            col("identity") {
              text("Sol Reyes", "title")
              text("offline", "status")
              opt(1) {
                text("Maintainer", "subtitle")
              }
              opt(2) {
                text("Infrastructure", "metadata")
              }
            }
          }
          text("Maintainer", "status")
          opt(1) {
            text("2026-09-01", "metadata")
          }
        }
      }
    }
  }

