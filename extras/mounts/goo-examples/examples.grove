        row("field") {
          text("Before version", "label")
          text("11", "value")
        }
        row("field") {
          text("After version", "label")
          text("12", "value")
        }
        row("author") {
          avatar("MC", "avatar")
          text("Mara Chen", "title")
        }
      }
      col("collection") {
        col("field") {
          text("draft_note", "label")
          text("removed", "status")
          col("field") {
            text("Before", "label")
            text("TODO examples", "value")
          }
          col("field") {
            text("After", "label")
            text("Not set", "value")
          }
        }
      }
    }
  }

