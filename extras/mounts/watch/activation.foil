- apps/watch/main [at=application]
- stdlib/runtime

+ watch_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'watch]
      card
        | (pact/card application/app "apps/watch/main" 0 0).put
          limb_slot (kook [[state.self 'kook 'pact]])
      [next reply]
        | helm/supervisor/handle (helm/card/step root (writ/make card))
          state
    > (./ack failure) reply
      | ./err (pails/t "Application activation failed")
    ? (maybe/is_some failure)
      | ./err (pails/t "Application activation failed")
    | ./ok next
