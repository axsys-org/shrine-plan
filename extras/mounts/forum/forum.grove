#import lede=sys/lede
#import text=lib/grove/types/text

' A conversation one world keeps. A member hands a message in: a record of
' its own that only the keeper reads. The keeper accepts it, by writing the
' message into the conversation itself, numbered in the order it accepted
' them. Every member reads the conversation and nobody but the keeper
' writes it, so it has one order, the keeper's. While the keeper is away
' nothing is accepted. Accepting is the keeper's own hand (forum_mount):
' nothing in the kernel knows what a message is.

card =
  @role
  #meta ;
    lede: "Anything here that has a title"
  title: text

line =
  @role
  #meta ;
    lede: "Something a member hands in to be said"
  said: text

entry =
  @role
  #meta ;
    lede: "Something said in the conversation, who handed it in, and under what name"
  said: text
  from: text
  at: text

members =
  @stencil
  #meta ;
    lede: "A seat for whoever takes part"
  #here ; '/members/[m=@tas]
  #with ; card
  #by ; maker
  #for ; '/members/[any]

handed =
  @stencil
  #meta ;
    lede: "What a member hands in: its own to write, the keeper's to read"
  #here ; '/members/[m=@tas]/said/[i=@tas]
  #with ; line
  #by ; '/members/[m]
  #for ; maker

messages =
  @stencil
  #meta ;
    lede: "The conversation: the keeper's to write, every member's to read"
  #here ; '/messages/[n=@u]
  #with ; entry
  #by ; maker
  #for ; '/members/[any]

"/" =
  @tree
  title: "A forum"

"/members" =
  @tree

"/messages" =
  @tree

"/members/first" =
  @tree
  title: "A member"
  invite: 1

"/members/second" =
  @tree
  title: "Another member"
  invite: 2
