  + breakdowns
    \ ignored=unit
    ^ row[testing/check]
    [(testing/text "AQ breakdown" "g16 o24 d13" (gematria/breakdown 0 "God"))
     (testing/text "spaces and punctuation skipped" "a10 b11" (gematria/breakdown 0 "a, b!"))
     (testing/nat "uncounted characters add no prime" 0 (gematria/total 6 "!? "))
     (testing/nat "NQ digit zero is nine" 9 (gematria/value 1 48))]

+ tests
  ^ row[testing/case]
  [(testing/case "test vectors" gematria_tests/vectors)
   (testing/case "breakdowns" gematria_tests/breakdowns)]
