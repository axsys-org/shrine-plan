    ^ row[testing/check]
    = v0 (gematria/values "gematria")
      v1 (gematria/values "the beast")
      v2 (gematria/values "god")
      v3 (gematria/values "jesus christ")
      v4 (gematria/values "hell")
      v5 (gematria/values "GOD 93!")
      v6 (gematria/values "a")
