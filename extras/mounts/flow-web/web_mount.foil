- flow_web_foot
- eden
- flow_install

+ flow_web_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    = operations (flow_ops/key state.self 'operations)
      commands=row[[path writ]]
        [[operations.snoc('web_fetch) (writ/make (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['urls] (flow_web_ops/request [state.self 'io 'web]))))]
         [operations.snoc('web_sources) (writ/make (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['responses] flow_web_ops/sources)))]]
      writes (flow_web_ops/registrations state).weld(commands)
    ? (grove_install/changes writes.keep((flow_install/changed state)) state)
     > (./err why) (./err (pails/q why))
     > (./ok next) (./ok next)
  + start
    ' Use Eden's existing foot registration. The ordinary activation installs
    ' the home and forms; this hook owns no work, timer or scheduler.
    \ server=nat arguments=row[str]
    ^ nat
    ?> (./some home) (path_parse arguments.at(0))
      | error (pails/t "Missing HTTP provider home")
    ; (eden/register_foot server (helm/supervisor/register home flow_web_foot/run))
    server
