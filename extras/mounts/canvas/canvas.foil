- booking_rules
- interaction_runtime
- grove_dev
- source_mount
- canvas_surface

+ canvas
  + world
    : installed=development/installed[booking_rules/program]
      candidate=maybe[development/candidate[booking_rules/program]]
      serial=nat events=row[interaction_runtime/request] intentions=row[str] source=str
  + state_slot
    ^ path
    ['canvas 'world]
  + reservation_slot
    ^ path
    ['canvas 'reservation]
  + record
    \ target=path state=namespace
    ^ myth
    | (sovereign_care .x target state).fil.fall(myth/new)
  + reservations
    \ root=path state=namespace
    ^ row[booking_rules/reservation]
    | (sovereign_care .y root.snoc('reservations) state).tap.bind
      \ [path record]
      ^ row[booking_rules/reservation]
      ?> (./some held) record.get(canvas/reservation_slot) []
      ?> reservation=booking_rules/reservation held []
      [reservation]
  + number
    \ number=nat
    ^ json
    | json/str (nat/show number)
  + get
    \ name=str input=json
    ^ str
    | grove_dev/text (grove_dev/field name input)
  + nat
    \ name=str input=json
    ^ maybe[nat]
    | nat/parse (canvas/get name input)
  + query
    \ input=json root=path state=namespace
    ^ maybe[booking_rules/query]
    < person (path_parse (canvas/get "person" input))
    < equipment (path_parse (canvas/get "equipment" input))
    < start (canvas/nat "start" input)
    < finish (canvas/nat "finish" input)
    ? !(pith_prefix root.snoc('people) person) .none
    ? !(pith_prefix root.snoc('equipment) equipment) .none
    ? ((eq (canvas/record person state).tap.len 0) || (eq (canvas/record equipment state).tap.len 0)) .none
    | ./some (booking_rules/query person equipment start finish (canvas/reservations root state))
  + policy
    \ input=json
    ^ maybe[booking_rules/program]
    < minutes (canvas/nat "turnaround" input)
    ? (gt minutes 120) .none
    = flag (canvas/get "same_person" input)
    ? !((eq flag "true") || (eq flag "false")) .none
    | ./some (booking_rules/create minutes (eq flag "true"))
  + outcome_json
    \ outcome=booking_rules/outcome
    ^ json
    ? outcome
     > ./available (json/obj [(jkv "kind" (json/str "available")) (jkv "label" (json/str "Available"))])
     > (./unknown reason) (json/obj [(jkv "kind" (json/str "unknown")) (jkv "label" (json/str reason))])
     > (./unavailable reservation until reason)
      | json/obj [(jkv "kind" (json/str "unavailable")) (jkv "label" (json/str reason))
          (jkv "reservation" (json/str (path_show reservation))) (jkv "until" (canvas/number until))]
  + policy_json
    \ program=booking_rules/program
    ^ json
    | json/obj [(jkv "turnaround" (canvas/number program.turnaround)) (jkv "same_person" (json/boo program.same_person))]
  + finding_json
    \ item=commitment/finding
    ^ json
    = kind=str
        ? item.verdict
         > ./holding "holding"
         > (./failed _) "failed"
         > (./unknown _) "unknown"
      detail=str
        ? item.verdict
         > ./holding "Required outcome holds"
         > (./failed reason) reason
         > (./unknown reason) reason
    | json/obj [(jkv "key" (json/str (path_show item.key)))
        (jkv "statement" (json/str item.statement)) (jkv "provenance" (json/str item.provenance))
        (jkv "kind" (json/str kind)) (jkv "detail" (json/str detail))]
  + case_row
    \ label=str origin=str query=booking_rules/query live=booking_rules/program candidate=booking_rules/program
    ^ json
    = old live.run
      next candidate.run
      before (old query)
      after (next query)
    | json/obj [(jkv "label" (json/str label)) (jkv "origin" (json/str origin))
       (jkv "before" (canvas/outcome_json before)) (jkv "after" (canvas/outcome_json after))
       (jkv "changed" (json/boo !(equal before after)))
       (jkv "query" (json/obj [(jkv "person" (json/str (path_show query.person)))
         (jkv "equipment" (json/str (path_show query.equipment)))
         (jkv "start" (canvas/number query.start)) (jkv "finish" (canvas/number query.finish))]))]
  + comparison
    \ root=path world=canvas/world program=booking_rules/program state=namespace
    ^ row[json]
    = records (canvas/reservations root state)
      equipment root.weld(['equipment 'camera_a])
      alex root.weld(['people 'alex])
      sam root.weld(['people 'sam])
      make (\ who=path start=nat finish=nat (booking_rules/query who equipment start finish records))
      row (\ label=str query=booking_rules/query (canvas/case_row label "declared boundary + retained reservations" query world.installed.implementation program))
    [(row "Alex continues at 11:00" (make alex 660 720))
     (row "Sam starts at 11:00" (make sam 660 720))
     (row "Sam starts at 11:15" (make sam 675 735))
     (row "Sam starts at 11:30" (make sam 690 750))
     (row "Alex overlaps at 10:45" (make alex 645 705))
     (row "Sam finishes at 09:50" (make sam 540 590))]
  + frame
    \ root=path world=canvas/world state=namespace
    ^ json
    = installed world.installed
      proposed=booking_rules/program
        ? world.candidate
         > (./some candidate) candidate.implementation
        installed.implementation
      findings=row[commitment/finding]
        ? world.candidate
         > (./some candidate) (development/assess[booking_rules/program] installed candidate)
        | commitment/assess[booking_rules/program] installed.commitments proposed
      candidate_json=json
        ? world.candidate
         > (./some candidate)
          | json/obj [(jkv "revision" (canvas/number candidate.revision)) (jkv "basis" (canvas/number candidate.basis))
              (jkv "intent" (json/str candidate.intent)) (jkv "policy" (canvas/policy_json candidate.implementation))
              (jkv "admissible" (json/boo (commitment/admissible .true findings)))
              (jkv "new_commitments" (canvas/number candidate.examples.len))]
        jnull
      record_json
        \ reservation=booking_rules/reservation
        ^ json
        | json/obj [(jkv "id" (json/str (path_show reservation.identity)))
           (jkv "equipment" (json/str (path_show reservation.equipment)))
           (jkv "person" (json/str (path_show reservation.person)))
           (jkv "start" (canvas/number reservation.start)) (jkv "finish" (canvas/number reservation.finish))]
      records (row/map[booking_rules/reservation json] record_json (canvas/reservations root state))
      entities
        \ branch=iota
        ^ json
        = items (sovereign_care .y root.snoc(branch) state).tap
          as_json
            \ pair=[path myth]
            ^ json
            = [relative record] pair
            | json/obj [(jkv "id" (json/str (path_show root.snoc(branch).weld(relative))))
                (jkv "label" (json/str (record.txt_at(['sys 'lede]))))]
        | json/arr (row/map[[path myth] json] as_json items)
    | json/obj [(jkv "protocol" (json/str "canvas/1")) (jkv "subject" (json/str (path_show root)))
       (jkv "expected" (canvas/number (state.case(.z root)).fall(0)))
       (jkv "revision" (canvas/number installed.revision)) (jkv "policy" (canvas/policy_json installed.implementation))
       (jkv "candidate" candidate_json) (jkv "equipment" (entities 'equipment)) (jkv "people" (entities 'people))
       (jkv "reservations" (json/arr records)) (jkv "cases" (json/arr (canvas/comparison root world proposed state)))
       (jkv "commitments" (json/arr (findings.map(canvas/finding_json))))
       (jkv "intentions" (json/arr (world.intentions.map((\ value=str (json/str value))))))
       (jkv "coverage" (json/str "All retained commitments and the six declared situations; not every possible booking."))
       (jkv "source" (json/str "extras/mounts/booking/rules.foil"))]
  + fail
    \ state=namespace code=nat message=str
    ^ [namespace nat str]
    [state code (show (json/obj [(jkv "error" (json/str message))]))]
  + commit
    \ request=interaction_runtime/request world=canvas/world state=namespace
    ^ [namespace nat str]
    = next world.set_events(world.events.snoc(request))
    ? (grove_install/change request.target (writ/poke (myth/sing canvas/state_slot next)) state)
     > (./err _) (canvas/fail state 409 "A native consumer rejected this change.")
     > (./ok state) [state 200 (show (canvas/frame request.target next state))]
  + handle
    \ request=interaction_runtime/request state=namespace
    ^ [namespace nat str]
    = root request.target
      record (canvas/record root state)
    ?> (./some held) record.get(canvas/state_slot) (canvas/fail state 404 "Workspace is absent.")
    ?> world=canvas/world held (canvas/fail state 409 "Workspace identity does not match.")
    ? !((eq request.principal "administrator") || (eq request.principal "agent"))
      | canvas/fail state 403 "Unknown principal."
    ? (eq request.operation "source")
      ?> (jres/ok input rest) (parse request.body) (canvas/fail state 400 "Invalid source request.")
      ? !(eq rest 0) (canvas/fail state 400 "Trailing input.")
      ? (gt (canvas/get "target" input).len 0) (canvas_surface/source input state)
      [state 200 (show (json/obj [(jkv "source" (json/str world.source))
        (jkv "revision" (canvas/number world.installed.revision))]))]
    ? (eq request.operation "present")
      ?> (jres/ok input rest) (parse request.body) (canvas/fail state 400 "Invalid input.")
      ? !(eq rest 0) (canvas/fail state 400 "Trailing input.")
      | canvas_surface/read input state
    ? (eq request.operation "evaluate")
      ?> (jres/ok input rest) (parse request.body) (canvas/fail state 400 "Invalid evaluation input.")
      ? !(eq rest 0) (canvas/fail state 400 "Trailing input.")
      ? (eq (canvas/get "kind" input) "presentation") (canvas_surface/refine input state)
      | canvas/dispatch request root record world state
    | canvas/dispatch request root record world state
  + dispatch
    \ request=interaction_runtime/request root=path record=myth world=canvas/world state=namespace
    ^ [namespace nat str]
    = reading ((eq request.operation "read") || (eq request.operation "context"))
    ? reading [state 200 (show (canvas/frame root world state))]
    ? !((eq request.principal "administrator") || (eq request.principal "agent"))
      | canvas/fail state 403 "Unknown principal."
    ? (world.events.any((\ previous (eq previous.event request.event))))
      ? (world.events.has(request))
        ? (eq request.operation "construct")
          [state 200 (show (json/obj [(jkv "created" (canvas_surface/path [state.self 'app 'workspace ($ta request.event)]))
            (jkv "frame" (canvas/frame root world state))]))]
        [state 200 (show (canvas/frame root world state))]
      | canvas/fail state 409 "This event identity already names a different action."
    ? (and (eq request.principal "agent") !(maybe/is_some world.candidate))
      | canvas/fail state 403 "An agent may continue an existing candidate; start one in Canvas."
    ? !(eq request.expected (state.case(.z root)).fall(0)) (canvas/fail state 409 "This workspace changed. Refresh and try again.")
    ?> (jres/ok input rest) (parse request.body) (canvas/fail state 400 "Invalid input.")
    ? !(eq rest 0) (canvas/fail state 400 "Trailing input.")
    ? (eq request.operation "perform")
      ? !(eq request.principal "administrator") (canvas/fail state 403 "Only the application user can operate this surface.")
      ? ((eq request.event.len 0) || (gt request.event.len 80)) (canvas/fail state 400 "A bounded event identity is required.")
      = [next code response] (canvas_surface/action input state)
      ? !(eq code 200) [state code response]
      = [committed status response] (canvas/commit request world next)
      ? !(eq status 200) [state status response]
      [committed status response]
    ? (eq request.operation "construct")
      ? !(eq request.principal "administrator") (canvas/fail state 403 "Only the application user can create a concept.")
      ? ((eq request.event.len 0) || (gt request.event.len 80)) (canvas/fail state 400 "A bounded event identity is required.")
      = source=path [state.self 'gov 'canvas]
        target=path [state.self 'app 'workspace ($ta request.event)]
        label (canvas/get "label" input)
      ? ((eq label.len 0) || (gt label.len 160)) (canvas/fail state 400 "Name the concept in 1–160 characters.")
      ?> (./some version) state.case(.x source) (canvas/fail state 409 "The concept template has not been published.")
      ?> (./ok next) (grove_install/instantiate source version target state)
        | canvas/fail state 409 "Concept construction was rejected."
      ?> (./ok next) (grove_install/change target (writ/poke (myth/sing bond/lede (pails/t label))) next)
        | canvas/fail state 409 "Concept naming was rejected."
      = [committed status response] (canvas/commit request world next)
      ? !(eq status 200) [state status response]
      [committed 200 (show (json/obj [(jkv "created" (canvas_surface/path target))
        (jkv "frame" (canvas/frame root world.set_events(world.events.snoc(request)) committed))]))]
    ? ((eq request.operation "evaluate") || (eq request.operation "stage"))
      ?> (./some program) (canvas/policy input) (canvas/fail state 400 "Turnaround must be 0–120 minutes, with an explicit exception policy.")
      = examples=row[commitment/retained[booking_rules/program]]
          ? world.candidate
           > (./some candidate) candidate.examples
          []
        candidate (development/candidate[booking_rules/program] root world.installed.revision world.serial.inc program
          (canvas/get "intent" input) examples)
        next world.set_candidate((./some candidate)).set_serial(world.serial.inc)
      ? (eq request.operation "evaluate") [state 200 (show (canvas/frame root next state))]
      ? ((eq request.event.len 0) || (gt request.event.len 80)) (canvas/fail state 400 "A bounded event identity is required.")
      | canvas/commit request next state
    ? ((eq request.event.len 0) || (gt request.event.len 80)) (canvas/fail state 400 "A bounded event identity is required.")
    ? (eq request.operation "demonstrate")
      ?> (./some candidate) world.candidate (canvas/fail state 409 "Start an experiment first.")
      ?> (./some query) (canvas/query input root state) (canvas/fail state 400 "Choose actual subjects and valid times.")
      = expected (canvas/get "available" input)
      ? !((eq expected "true") || (eq expected "false")) (canvas/fail state 400 "Demonstrate the required outcome explicitly.")
      = proof (booking_rules/demonstrate root.weld(['commitments ($ta request.event)]) root
          (canvas/get "label" input) (? (eq request.principal "administrator") "user demonstration" "agent proposal")
          world.installed.revision query (eq expected "true"))
        candidate candidate.set_examples(candidate.examples.snoc(proof)).set_revision(world.serial.inc)
      | canvas/commit request world.set_candidate((./some candidate)).set_serial(world.serial.inc) state
    ? (eq request.operation "publish")
      ? !(eq request.principal "administrator") (canvas/fail state 403 "Only the customer can approve publication.")
      ?> (./some candidate) world.candidate (canvas/fail state 409 "There is no candidate to publish.")
      ?> (./some approved) (canvas/nat "revision" input) (canvas/fail state 400 "Approval must name the candidate revision.")
      ? (development/publish[booking_rules/program] approved .true world.installed candidate)
       > (./err reason) (canvas/fail state 409 reason)
       > (./ok installed)
        | canvas/commit request world.set_installed(installed).set_candidate(.none).set_intentions(world.intentions.snoc(candidate.intent)) state
    ? (eq request.operation "discard")
      | canvas/commit request world.set_candidate(.none) state
    ? (eq request.operation "reserve")
      ? !(eq request.principal "administrator") (canvas/fail state 403 "Agent operation parity is not enabled in this stage.")
      ?> (./some query) (canvas/query input root state) (canvas/fail state 400 "Choose actual subjects and valid times.")
      = run world.installed.implementation.run
        result (run query)
      ? !(booking_rules/available result) (canvas/fail state 409 (booking_rules/describe result))
      = identity root.weld(['reservations ($ta request.event)])
        reservation (booking_rules/reservation identity query.equipment query.person query.start query.finish)
      ? (grove_install/change identity (writ/make (myth/sing canvas/reservation_slot reservation)) state)
       > (./err _) (canvas/fail state 409 "Native reservation creation failed.")
       > (./ok changed)
        = [next code body] (canvas/commit request world changed)
        ? !(eq code 200) (canvas/fail state 409 "Reservation publication was rejected.")
        [next code body]
    | canvas/fail state 400 "Unknown native action."
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'canvas]
      program (booking_rules/create 0 .false)
      installed (development/installed[booking_rules/program] root 1 program [])
      files (source_mount/snapshot [state.self 'io 'fs (source_mount/mount_key "booking")] state)
      source_bytes=nat
        % idx=nat 0 out=nat 0
        ? (eq idx files.len) out
        = [name content] files.at(idx)
        | _ idx.inc (? (eq name "rules.foil") content out)
      source=str
        ? (le source_bytes 1) "Source fixture unavailable."
        | str/from_atom (mod source_bytes (bex (mul 8 (dec (wid source_bytes)))))
      world (canvas/world installed .none 0 [] [] source)
      record (myth/sing canvas/state_slot world)
      record record.put(interaction_runtime/slot (interaction_runtime/endpoint canvas/handle))
      record record.put(['sys 'lede] (pails/t "Studio equipment"))
      named (\ label=str (myth/sing ['sys 'lede] (pails/t label)))
      camera root.weld(['equipment 'camera_a])
      alex root.weld(['people 'alex])
      sample root.weld(['reservations 'morning])
      records=row[[path myth]]
        [[root record]
         [camera (named "Camera A")]
         [root.weld(['equipment 'camera_b]) (named "Camera B")]
         [alex (named "Alex")]
         [root.weld(['people 'sam]) (named "Sam")]
         [sample (myth/sing canvas/reservation_slot (booking_rules/reservation sample camera alex 600 660))]]
    ? (grove_install/mount root records state)
     > (./ok next) (./ok next)
     > (./err why) (./err (pails/t "Canvas installation failed."))
