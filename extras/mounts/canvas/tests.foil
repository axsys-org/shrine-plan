- canvas
- tests/grove_install [at=fixture]
- tests/goo_runtime [at=ui_fixture]
- tests/grove_template [at=tree_fixture]
- tests/presentation_edit [at=presentation_fixture]
- testing

+ canvas_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial (fixture/grove_install_checks/bootstrap [])
      state (either/ok_val (canvas/install initial))
      root=path [state.self 'app 'canvas]
      expected (state.case(.z root)).fall(0)
      request (interaction_runtime/request root "administrator" "read" expected "" "{}")
      [same status body] (interaction_runtime/run request state)
      stage request.set_operation("stage").set_event("first").set_body((show (json/obj [(jkv "turnaround" (json/str "15")) (jkv "same_person" (json/str "true")) (jkv "intent" (json/str "Allow the same person to continue"))])))
      [staged stage_status stage_body] (interaction_runtime/run stage state)
      [duplicate duplicate_status duplicate_body] (interaction_runtime/run stage staged)
      [collision collision_status collision_body] (interaction_runtime/run stage.set_body("{}") staged)
      [agent_start agent_start_status agent_start_body] (interaction_runtime/run stage.set_principal("agent") state)
      [stale stale_status stale_body] (interaction_runtime/run stage.set_event("different") staged)
      publish request.set_expected((staged.case(.z root)).fall(0)).set_operation("publish").set_event("publish").set_body((show (json/obj [(jkv "revision" (json/str "1"))])))
      [denied denied_status denied_body] (interaction_runtime/run publish.set_principal("agent") staged)
      [installed installed_status installed_body] (interaction_runtime/run publish staged)
    [(testing/nat "native read does not mutate namespace" 1 (equal state same))
     (testing/nat "native read returns a frame" 200 status)
     (testing/nat "stage a native candidate" 200 stage_status)
     (testing/nat "duplicate event is idempotent" 1 (equal staged duplicate))
     (testing/nat "event identity cannot name another payload" 409 collision_status)
     (testing/nat "collision cannot change state" 1 (equal staged collision))
     (testing/nat "agent cannot start a new candidate" 403 agent_start_status)
     (testing/nat "stale event rejected" 409 stale_status)
     (testing/nat "stale event preserves installed state" 1 (equal staged stale))
     (testing/nat "agent cannot approve publication" 403 denied_status)
     (testing/nat "denied approval preserves state" 1 (equal denied staged))
     (testing/nat "human publishes exact candidate" 200 installed_status)]

  + retention
    \ ignored=unit
    ^ row[testing/check]
    = initial (fixture/grove_install_checks/bootstrap [])
      state (either/ok_val (canvas/install initial))
      root=path [state.self 'app 'canvas]
      call
        \ operation=str event=str body=json state=namespace
        ^ [namespace nat str]
        | interaction_runtime/run (interaction_runtime/request root "administrator" operation
            (state.case(.z root)).fall(0) event (show body)) state
      policy
        \ flag=str
        ^ json
        | json/obj [(jkv "turnaround" (json/str "15")) (jkv "same_person" (json/str flag))
            (jkv "intent" (json/str "The same person may continue"))]
      approval
        \ revision=str
        ^ json
        | json/obj [(jkv "revision" (json/str revision))]
      example
        | json/obj [(jkv "person" (json/str (path_show root.weld(['people 'alex]))))
            (jkv "equipment" (json/str (path_show root.weld(['equipment 'camera_a]))))
            (jkv "start" (json/str "660")) (jkv "finish" (json/str "720"))
            (jkv "available" (json/str "true")) (jkv "label" (json/str "Alex can continue at 11:00"))]
      [staged code_stage _] (call "stage" "first" (policy "true") state)
      [shown code_example _] (call "demonstrate" "436bddd1-f5e3-4480-9c9f-f41de9f92dc7" example staged)
      [published code_publish _] (call "publish" "approval" (approval "2") shown)
      [regressed code_regress _] (call "stage" "regress" (policy "false") published)
      [rejected code_reject _] (call "publish" "reject" (approval "3") regressed)
      [repaired code_repair _] (call "stage" "repair" (policy "true") regressed)
      [operating code_operate _] (call "publish" "approve_repair" (approval "4") repaired)
      [reserved code_reserve _] (call "reserve" "1436bddd1-f5e3-4480-9c9f-f41de9f92dc7" example operating)
    [(testing/nat "stage a demonstrable rule" 200 code_stage)
     (testing/nat "opaque browser UUID can identify a retained demonstration" 200 code_example)
     (testing/nat "publish demonstration with the rule" 200 code_publish)
     (testing/nat "a regressing candidate can be inspected" 200 code_regress)
     (testing/nat "retained user demonstration rejects the later regression" 409 code_reject)
     (testing/nat "rejection leaves native state intact" 1 (equal rejected regressed))
     (testing/nat "repair can restore the retained commitment" 200 code_repair)
     (testing/nat "repaired rule can be published" 200 code_operate)
     (testing/nat "published behavior makes a real booking with opaque identity" 200 code_reserve)
     (testing/nat "original shared reservation survives publication" 2 (canvas/reservations root reserved).len)]

  + surfaces
    \ ignored=unit
    ^ row[testing/check]
    = [base query] (ui_fixture/goo_runtime_checks/setup [])
      state (either/ok_val (canvas/install base))
      root=path [state.self 'app 'canvas]
      target=path [state.self 'app 'workspace 'custom]
      card (myth/sing ['sys 'req] (pails/t "Before")).put(['unrelated 'name] (pails/t "Preserved"))
      state (tree_fixture/grove_template_checks/seed target (note/make card) state)
      body (json/obj [(jkv "target" (canvas_surface/path target))])
      [same read_status read_body] (canvas_surface/read body state)
      request (interaction_runtime/request root "administrator" "perform" (state.case(.z root)).fall(0) "generic-edit"
        (show (json/obj [(jkv "target" (canvas_surface/path target)) (jkv "subject" (canvas_surface/path target))
          (jkv "view" (canvas_surface/path query.view)) (jkv "control" (json/str "0.0"))
          (jkv "expected" (canvas_surface/number (state.case(.x target)).fall(0)))
          (jkv "displayed" (canvas_surface/number (state.case(.y target)).fall(0)))
          (jkv "publication" (canvas_surface/number (goo_runtime/publication state)))
          (jkv "inputs" (json/obj [(jkv "/sys/req" (json/str "After"))]))])))
      [edited status response] (interaction_runtime/run request state)
      current (goo_runtime/record .x target edited).fall(myth/new)
      [duplicate duplicate_status _] (interaction_runtime/run request edited)
      [denied denied_status _] (interaction_runtime/run request.set_principal("agent") state)
      [stale stale_status _] (interaction_runtime/run request.set_event("stale").set_expected((edited.case(.z root)).fall(0)) edited)
      [private private_status _] (canvas_surface/read (json/obj [(jkv "target" (canvas_surface/path [state.self 'sys]))]) state)
    [(testing/nat "native surface discovery does not mutate" 1 (equal same state))
     (testing/nat "native surface reads an independently authored view" 200 read_status)
     (testing/nat "generic declared action operates" 200 status)
     (testing/text "action updates its exact slot" "After" (current.txt_at(['sys 'req])))
     (testing/text "action preserves unrelated slots" "Preserved" (current.txt_at(['unrelated 'name])))
     (testing/nat "generic action retry is idempotent" 1 (equal edited duplicate))
     (testing/nat "generic duplicate action returns success" 200 duplicate_status)
     (testing/nat "agent cannot invoke ordinary workspace action" 403 denied_status)
     (testing/nat "denied action changes nothing" 1 (equal denied state))
     (testing/nat "old surface case is rejected even with a fresh envelope" 409 stale_status)
     (testing/nat "stale surface does not mutate" 1 (equal stale edited))
     (testing/nat "presentation read cannot escape application scope" 403 private_status)]

  + presentation
    \ ignored=unit
    ^ row[testing/check]
    = initial (fixture/grove_install_checks/bootstrap [])
      state (either/ok_val (canvas/install initial))
      root=path [state.self 'app 'canvas]
      target=path [state.self 'app 'workspace 'editable]
      location=path [state.self 'gov 'sample 'edit]
      original presentation_fixture/presentation_edit_checks/original
      published original.set_view(original.view.set_name(location)).set_result((./ok (either/ok_val original.result).set_name(location)))
      state (tree_fixture/grove_template_checks/seed target
        (note/make (myth/sing ['sys 'req] (pails/t "Native content"))) state)
      state (tree_fixture/grove_template_checks/seed location
        (note/make (myth/sing publisher_vocabulary/grove/view published)) state)
      source (presentation_fixture/presentation_edit_checks/source
        (presentation_fixture/presentation_edit_checks/group "input('/sys/req)|    action(`Keep`)"))
      body
        \ revision=nat
        ^ str
        | show (json/obj [(jkv "kind" (json/str "presentation"))
          (jkv "target" (canvas_surface/path target))
          (jkv "view" (canvas_surface/path location))
          (jkv "revision" (canvas_surface/number revision))
          (jkv "publication" (canvas_surface/number (goo_runtime/publication state)))
          (jkv "source" (json/str source))])
      revision (state.case(.x location)).fall(0)
      request (interaction_runtime/request root "agent" "evaluate" 0 "" (body revision))
      [same status response] (interaction_runtime/run request state)
      [stale stale_status _] (interaction_runtime/run request.set_body((body revision.inc)) state)
      [untrusted untrusted_status _] (interaction_runtime/run request.set_principal("untrusted") state)
    [(testing/nat "agent may preview an authored presentation" 200 status)
     (testing/nat "native compilation and rendering do not install source or mutate state" 1 (equal same state))
     (testing/nat "changed presentation revision requires reassessment" 409 stale_status)
     (testing/nat "stale preview leaves installed behavior intact" 1 (equal stale state))
     (testing/nat "preview still requires a recognized principal" 403 untrusted_status)
     (testing/nat "untrusted preview leaves state intact" 1 (equal untrusted state))]

+ tests
  ^ row[testing/case]
  [(testing/case "Canvas native lifecycle" canvas_checks/checks)
   (testing/case "Retained demonstration across future changes" canvas_checks/retention)
   (testing/case "Native authored surfaces" canvas_checks/surfaces)
   (testing/case "Authored presentation previews" canvas_checks/presentation)]
