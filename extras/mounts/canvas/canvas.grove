#import lede=sys/lede
#import content=sys/content
#import text=lib/grove/types/text

concept =
  @role
  lede: text
  content: text

surface =
  @view
  #on ; %/concept
  #for ; /sys/slot/detail
  card => {
    col("identity") {
      show(card.lede, '/sys/slot/title)
      show(card.content, '/sys/slot/content)
    }
    action("Shape this", become = '/sys/slot/edit)
  }

edit =
  @view
  #on ; %/concept
  #for ; /sys/slot/edit
  card => group(on = card, action = .poke, myth = {
    '/sys/lede = .input(card.lede)
    '/sys/content = .input(card.content)
  }) {
    col("identity") {
      show("Name", '/sys/slot/label)
      input('/sys/lede)
      show("What is this for?", '/sys/slot/label)
      input('/sys/content)
    }
    action("Save", become = '/sys/slot/detail)
  }

"/" =
  @tree
  lede: "Untitled concept"
  content: ""
