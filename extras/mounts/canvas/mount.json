{
  "version": 1,
  "name": "canvas",
  "dependencies": [
    "booking",
    "goo",
    "codecs"
  ],
  "modules": {
    "canvas": "canvas.foil",
    "canvas_mount": "canvas_mount.foil",
    "canvas_surface": "canvas_surface.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "canvas"
      ],
      "files": [
        "canvas.grove"
      ]
    }
  ],
  "assets": {},
  "files": {},
  "roots": [
    [
      "lib",
      "canvas"
    ],
    [
      "lib",
      "canvas_mount"
    ],
    [
      "lib",
      "canvas_surface"
    ],
    [
      "gov",
      "canvas"
    ]
  ],
  "tests": {
    "tests/canvas": "tests.foil"
  },
  "activate": {
    "module": "canvas",
    "entry": [
      "canvas",
      "install"
    ]
  },
  "http": {
    "module": "canvas_mount",
    "entry": [
      "canvas_mount",
      "http"
    ]
  },
  "routes": [
    "/canvas-native"
  ],
  "host": "host.py"
}
