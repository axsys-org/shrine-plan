- explorer_mount
- goo_workspace

+ community_mount
  + endpoint
    \ self=iota
    ^ goo_workspace/endpoint
    | goo_workspace/endpoint [self 'gov 'community 'workspace]
        [self 'gov 'community 'source_path] [self 'app 'community 'home]
        community_mount/validate [] (community_mount/page self)
  + validate
    \ selected=axal[myth]
    ^ maybe[str]
    ? selected.wyt .none
    | ./some "Choose an existing community tree."
  + query_valid
    \ target=str
    ^ bool
    = parts (http_foot/split 63 target)
    ? (gt parts.len 2) .false
    = query=str (? (eq parts.len 2) parts.at(1) "")
    ? (eq query.len 0) .true
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) .false
    ? !(eq fields.len 1) .false
    = [key value] fields.at(0)
    | and (eq key "path") (maybe/is_some (browser_routes/value_path value))
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? ((eq url "/community") || (eq url "/community/"))
          ? !(community_mount/query_valid request.target)
            | ./reply (http_driver/response 400 "Use one canonical absolute namespace path.")
          | goo_workspace/request (community_mount/endpoint state.self) request now
        | ./reply (http_driver/response 404 "Not found")
    | http_foot/add_routes [(http_foot/route "/community" plan)] http_foot/empty
  + page
    \ self=iota target=path content=row[weft/node]
    ^ nat
    = assets (goo_browser/presentation_assets).snoc((weft/el "script" [(weft/att "src" "/static/goo-workspace.js") (weft/att "defer" "defer")] []))
    | weft/page_with_assets "Community" assets
      [(weft/el "header" [] [(weft/leaf "h1" [] "Community")
         (weft/leaf "p" [] "Select a record in the outline to read or change it.")])
       (weft/el "main" [] content)]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'community]
      target=path [state.self 'app 'community]
    ?> (./some version) state.case(.x source) (./err (pails/t "The community publication is missing."))
    ?> (./ok next) (grove_install/instantiate source version target state)
      | ./err (pails/t "The community instance could not be installed.")
    | goo_workspace/install (community_mount/endpoint state.self) goo_browser/talk next
