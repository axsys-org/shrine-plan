#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import lede=sys/lede
#import content=sys/content
#import about=sys/about

within =
  @slot
  #meta ;
    lede: "The scope a record belongs to"

answers =
  @slot
  #meta ;
    lede: "The record this one answers"

member =
  @slot
  #meta ;
    lede: "The world an entry lists"

lens =
  @slot
  #meta ;
    lede: "The package a scope is seen through"

key =
  @slot
  #meta ;
    lede: "The public key an invitation is held for"

terms =
  @slot
  #meta ;
    lede: "Whether a request by this invitation is admitted at once or waits"

by_invite =
  @slot
  #meta ;
    lede: "The invitation a request to join relies on"

state =
  @slot
  #meta ;
    lede: "Where a request stands, as a word"

of =
  @slot
  #meta ;
    lede: "The request a decision is about"

world =
  @slot
  #meta ;
    lede: "A world being introduced"

consent =
  @slot
  #meta ;
    lede: "The introduced world's own word allowing it"

item =
  @role
  #meta ;
    lede: "Anything a scope shows: a name and what it says"
  lede: text
  content: text

word =
  @role
  #meta ;
    lede: "Something one world says to another, with its context, its subject and what it answers"
  #with ; item
  #opt ;
    about: path_type
    %/within: path_type
    %/answers: path_type

entry =
  @role
  #meta ;
    lede: "A place in this scope: planned, open to be claimed, or filled by a world"
  #with ; item
  #opt ;
    %/member: path_type
    %/by_invite: text
    %/lens: path_type

invite =
  @role
  #meta ;
    lede: "An invitation: a card held for a key"
  #with ; item
  %/key: text
  %/terms: text
  #opt ;
    %/lens: path_type

join =
  @role
  #meta ;
    lede: "A request to join, published by the world that asks"
  #with ; word
  %/by_invite: text

verdict =
  @role
  #meta ;
    lede: "The scope's answer to a request"
  #with ; word
  %/state: text

admit =
  @role
  #meta ;
    lede: "A member's request that the scope decide a request to join"
  #with ; word
  %/of: path_type
  %/state: text

introduce =
  @role
  #meta ;
    lede: "A member introducing another world, with that world's consent"
  #with ; word
  %/world: path_type
  #opt ;
    %/consent: path_type
