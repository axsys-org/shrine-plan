source_path =
  @slot

context =
  @role
  %/source_path: path_type

announcement =
  @role
  #meta ;
    lede: "Something the community tells its members"
  #with ; item
  #opt ;
    about: path_type

project =
  @role
  #meta ;
    lede: "Work the community has taken up"
  #with ; item
  #opt ;
    about: path_type

document =
  @role
  #meta ;
    lede: "A document the community keeps"
  #with ; item
  #opt ;
    about: path_type

summary =
  @view
  #on ; %/item
  #for ; /sys/slot/community_summary
  item => { show(item.lede, '/sys/slot/label) }

detail =
  @view
  #on ; %/item
  #for ; /sys/slot/community_detail
  item => {
    show(item.lede, '/sys/slot/title)
    show(item.content, '/sys/slot/content)
    action("Edit", become = '/sys/slot/community_edit)
  }

edit =
  @view
  #on ; %/item
  #for ; /sys/slot/community_edit
  item => group(on = item, action = .poke, myth = {
    '/sys/lede = .input(item.lede)
    '/sys/content = .input(item.content)
  }) {
    input('/sys/lede)
    input('/sys/content)
    action("Save and read", become = '/sys/slot/community_detail)
  }

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/community_workspace
  context => selection('/current, source = context.source_path, topology = "tree") {
    split {
      pane(%/Outline, ports = { '/current = '/current })
      pane(%/Reader, ports = { '/current = '/current })
    }
  }

Outline =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/CommunityOutline
  #port ; /current
  context => {
    list_tree('/outline, source = context.source_path, selection = '/current, slot = '/sys/slot/community_summary)
  }

Reader =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/CommunityReader
  #port ; /current
  context => {
    follow('/record, selection = '/current, slot = '/sys/slot/community_detail)
  }

"/" =
  @tree

"/home" =
  @tree
  lede: "Computing Society"
  content: "A community is a world with a catalog of members. This tree is its first state."

"/home/members" =
  @tree
  lede: "Members"
  content: "The catalog. One entry for each world this community lists."

"/home/members/founder" =
  @tree
  lede: "Founder"
  content: "The world that founded this community and was its first member."

"/home/announcements" =
  @tree
  lede: "Announcements"
  content: "What the community tells all of its members."

"/home/announcements/welcome" =
  @tree
  lede: "Welcome"
  content: "This community was made from the Community Starter package."

"/home/projects" =
  @tree
  lede: "Projects"
  content: "Work proposed by members and taken up by the community."

"/home/projects/railway" =
  @tree
  lede: "Railway dashboard"
  content: "Proposed by a member. Accepted into the community with its source kept."

"/home/documents" =
  @tree
  lede: "Documents"
  content: "Documents the community keeps."

"/home/exchanges" =
  @tree
  lede: "Exchanges"
  content: "Questions and answers between members in this community, found by their references."

"/home/invitations" =
  @tree
  lede: "Invitations"
  content: "Cards held for keys. Each link can ask to join once."

"/home/requests" =
  @tree
  lede: "Requests"
  content: "Requests to join that wait for a decision."
