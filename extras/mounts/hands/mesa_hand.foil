  +  mesa
    '  Mesa's rows (note/mesa.md): under /net/mesa, what this world
    '  publishes to each peer and what it wants from each, as records
    '  the sidecar reads and moves bytes for.  out/<X>/<p…>: this
    '  world's /<p…> goes to X, because X subscribed to it (the record
    '  X landed at /her/<X>/subs/<p…>).  want/<X>/<p…>: a record of
    '  this world holds a reference to /her/<X>/<p…>, so it
    '  subscribes.  Each row's source is the record it was read from.
    '  Rows are made once and never culled here: a stale row costs one
    '  harmless resend.  References are found in the content roots
    '  (every top folder but the world's own machinery), hunted whole:
    '  the reverse index is not huntable from a hand yet.  A crew key
    '  with a variable in it is built with snoc: inside a path literal
    '  a name is a literal segment.
    +  content
      '  A top folder that holds content, not machinery or acquisitions.
      \  k=iota
      ^  bool
      ?  (eq_iota k 'her)  .false
      ?  (eq_iota k 'net)  .false
      ?  (eq_iota k 'app)  .false
      ?  (eq_iota k 'io)  .false
      ?  (eq_iota k 'r)  .false
      ?  (eq_iota k 'x)  .false
      ?  (eq_iota k 'h)  .false
      ?  (eq_iota k 'c)  .false
      ?  (eq_iota k 'sys)  .false
      ?  (eq_iota k 'log)  .false
      ?  (eq_iota k 'lib)  .false
      ?  (eq_iota k 'clock)  .false
      ?  (eq_iota k 'drafts)  .false
      ?  (eq_iota k 'pages)  .false
      ?  (eq_iota k 'our)  .false
      .true
    +  has_iota
      \  ks=row[iota] k=iota
      ^  bool
      %  i=nat 0
      ^  bool
      ?  (ge i ks.len)  .false
      ?  (eq_iota ks.at(i) k)  .true
      (_ i.inc)
    +  kids
      '  The children a y view holds: its structure's keys and its
      '  entries one segment long, together.
      \  view=axal[myth]
      ^  row[iota]
      =  es view.tap
         ks0 (axal/kid_keys view)
      %  i=nat 0  ks=row[iota] ks0
      ^  row[iota]
      ?  (ge i es.len)  ks
      =  [p t] es.at(i)
      ?  !(eq p.len 1)  (_ i.inc ks)
      ?  (hands/mesa/has_iota ks p.at(0))  (_ i.inc ks)
      (_ i.inc ks.snoc(p.at(0)))
    +  rootkey
      \  k=iota
      ^  path
      =  rk=path ['root]
      rk.snoc(k)
    +  aim_roots
      '  One hunt per content root, at z.
      \  home=path roots=row[iota] i=nat c=crew
      ^  crew
      ?  (ge i roots.len)  c
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/aim_roots home roots i.inc c)
      =  one=path [k]
      =  at home.weld(one)
      (hands/mesa/aim_roots home roots i.inc c.put((hands/mesa/rootkey k) (dep .z at)))
    +  aim
      '  The crew: the world's top at y (its roots), /her at z (what
      '  every peer sent, their subscriptions among it), each content
      '  root at z, and /net/mesa at z (the rows as they stand).
      \  b=bowl t=myth
      ^  myth
      =  home b.here.take(1)
         herseg=path ['her]
         mesa=path ['net 'mesa]
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
      =  her home.weld(herseg)
         rows home.weld(mesa)
      =  c0 (crew/sing ['top] (dep .y home))
      =  c1 c0.put(['her] (dep .z her)).put(['rows] (dep .z rows))
      |  t.put(crew_slot (cpail (hands/mesa/aim_roots home roots 0 c1)))
    +  init
      \  b=bowl t=myth
      ^  yell
      |  yell [] (hands/mesa/aim b t)
    +  talk
      \  b=bowl cur=myth nu=myth
      ^  yell
      =  d (def_talk b cur nu)
      |  yell d.cards (hands/mesa/aim b d.out)
    +  row
      '  One row made under /net/mesa, unless it stands already.
      \  home=path have=axal[myth] rel=path source=path cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (axal/has[myth] rel have)  cards
      =  mesa=path ['net 'mesa]
      =  root home.weld(mesa)
      =  at root.weld(rel)
      cards.snoc([at (writ/make (myth/sing ['source] (pt (path_show source))))])
    +  outs
      '  The out rows: every /her/<X>/subs/<p…> is out/<X>/<p…>.
      \  home=path have=axal[myth] view=axal[myth] cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es view.tap
         out=path ['out]
         herseg=path ['her]
      =  her home.weld(herseg)
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  [p t] es.at(i)
      ?  (lt p.len 3)  (_ i.inc cs)
      ?  !(eq_iota p.at(1) 'subs)  (_ i.inc cs)
      =  rel out.snoc(p.at(0)).weld(p.drop(2))
      (_ i.inc (hands/mesa/row home have rel her.weld(p) cs))
    +  ref_at
      '  A reference-valued slot (a pinned safe, as blocks and cells
      '  keep their references): its path.
      \  slot=path t=myth
      ^  maybe[path]
      > (./some held) t.get(slot)
        .none
      > s=safe held
        .none
      | ./some s.path
    +  wants_of
      '  The want rows one record's reference slots mean: each
      '  reference to /<home>/her/<X>/<p…> is want/<X>/<p…>, sourced
      '  to the record.
      \  home=path have=axal[myth] at=path t=myth cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es t.tap
         want=path ['want]
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  e es.at(i)
      ?>  (./some p) (hands/mesa/ref_at e.key t)
          (_ i.inc cs)
      ?  (lt p.len 4)  (_ i.inc cs)
      ?  !(eq_iota p.at(0) home.at(0))  (_ i.inc cs)
      ?  !(eq_iota p.at(1) 'her)  (_ i.inc cs)
      ?  (eq_iota p.at(3) 'subs)  (_ i.inc cs)
      =  rel p.drop(2)
      (_ i.inc (hands/mesa/row home have want.weld(rel) at cs))
    +  want_rows
      '  For one content root: the want rows of every record in it.
      \  home=path have=axal[myth] k=iota view=axal[myth] cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es view.tap
         one=path [k]
      =  root home.weld(one)
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  [p t] es.at(i)
      (_ i.inc (hands/mesa/wants_of home have root.weld(p) t cs))
    +  wants
      \  b=bowl home=path have=axal[myth] roots=row[iota] i=nat cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (ge i roots.len)  cards
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/wants b home have roots i.inc cards)
      =  view b.crew.gut((hands/mesa/rootkey k) (axal/new[myth] .none))
      (hands/mesa/wants b home have roots i.inc (hands/mesa/want_rows home have k view cards))
    +  hear
      '  Anything moved: every row recomputed from the crew's views and
      '  the missing ones made; the crew aimed again (a new root).
      '  heard says what moved last, for the log.
      \  b=bowl cur=myth r=row[dep]
      ^  yell
      =  home b.here.take(1)
         have b.crew.gut(['rows] (axal/new[myth] .none))
         hers b.crew.gut(['her] (axal/new[myth] .none))
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
         none=row[[p=path q=writ]] []
         empty=path []
      =  first (? (gt r.len 0) r.at(0).p empty)
         second (? (gt r.len 1) r.at(1).p empty)
         docs_view b.crew.gut((hands/mesa/rootkey 'docs) (axal/new[myth] .none))
      =  c1 (hands/mesa/outs home have hers none)
      =  all (hands/mesa/wants b home have roots 0 c1)
      =  traced cur.put(['heard] (pt (path_show first))).put(['heard2] (pt (path_show second))).put(['heard_n] (pt (nat/show r.len))).put(['roots_n] (pt (nat/show roots.len))).put(['docs_n] (pt (nat/show docs_view.tap.len))).put(['cards_n] (pt (nat/show all.len)))
      |  yell all (hands/mesa/aim b traced)
    +  form
      ^  form
      def_form.set_init(hands/mesa/init).set_talk(hands/mesa/talk).set_hear(hands/mesa/hear)
