  +  mesa
    '  Mesa's rows (note/mesa.md): under /net/mesa, what this world
    '  publishes to each peer and what it wants from each, as records
    '  the sidecar reads and moves bytes for.  A peer X is a row of
    '  /net/mesa/peers; /<X>/… in this world is the doc shared with X
    '  (X's names as this world has them, and what this world writes
    '  to X), both sides writing in it.  out/<X>/<p…>: this world's
    '  /<p…> goes to X, because X subscribed to it (landed at
    '  /<X>/subs/<p…>).  want/<X>/<p…>: a record of this world holds
    '  a reference to /<X>/<p…>, so it subscribes.  Each row's source
    '  is the record it was read from.  Rows are made once and never
    '  culled here: a stale row costs one harmless resend.  References
    '  are found in the content roots (every top folder but the
    '  world's own machinery), hunted whole: the reverse index is not
    '  huntable from a hand yet.
    +  content
      '  A top folder that holds content, not machinery.
      \  k=iota
      ^  bool
      ?  (eq_iota k 'net)  .false
      ?  (eq_iota k 'app)  .false
      ?  (eq_iota k 'io)  .false
      ?  (eq_iota k 'r)  .false
      ?  (eq_iota k 'x)  .false
      ?  (eq_iota k 'h)  .false
      ?  (eq_iota k 'c)  .false
      ?  (eq_iota k 'sys)  .false
      ?  (eq_iota k 'log)  .false
      ?  (eq_iota k 'lib)  .false
      ?  (eq_iota k 'clock)  .false
      ?  (eq_iota k 'drafts)  .false
      ?  (eq_iota k 'pages)  .false
      .true
    +  has_iota
      \  ks=row[iota] k=iota
      ^  bool
      %  i=nat 0
      ^  bool
      ?  (ge i ks.len)  .false
      ?  (eq_iota ks.at(i) k)  .true
      (_ i.inc)
    +  kids
      '  The children a y view holds: its structure's keys and its
      '  entries one segment long, together.
      \  view=axal[myth]
      ^  row[iota]
      =  es view.tap
         ks0 (axal/kid_keys view)
      %  i=nat 0  ks=row[iota] ks0
      ^  row[iota]
      ?  (ge i es.len)  ks
      =  [p t] es.at(i)
      ?  !(eq p.len 1)  (_ i.inc ks)
      ?  (hands/mesa/has_iota ks p.at(0))  (_ i.inc ks)
      (_ i.inc ks.snoc(p.at(0)))
    +  rootkey
      \  k=iota
      ^  path
      =  rk=path ['root]
      rk.snoc(k)
    +  aim_roots
      '  One hunt per content root, at z.
      \  home=path roots=row[iota] i=nat c=crew
      ^  crew
      ?  (ge i roots.len)  c
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/aim_roots home roots i.inc c)
      =  one=path [k]
      =  at home.weld(one)
      (hands/mesa/aim_roots home roots i.inc c.put((hands/mesa/rootkey k) (dep .z at)))
    +  aim
      '  The crew: the world's top at y (its roots), the peers at y
      '  (who is a peer), each content root at z (a peer's folder
      '  among them, its subscriptions inside), and /net/mesa at z
      '  (the rows as they stand).
      \  b=bowl t=myth
      ^  myth
      =  home b.here.take(1)
         peerseg=path ['net 'mesa 'peers]
         mesa=path ['net 'mesa]
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
      =  ps home.weld(peerseg)
         rows home.weld(mesa)
      =  c0 (crew/sing ['top] (dep .y home))
      =  c1 c0.put(['peers] (dep .y ps)).put(['rows] (dep .z rows))
      |  t.put(crew_slot (cpail (hands/mesa/aim_roots home roots 0 c1)))
    +  init
      \  b=bowl t=myth
      ^  yell
      |  yell [] (hands/mesa/aim b t)
    +  talk
      \  b=bowl cur=myth nu=myth
      ^  yell
      =  d (def_talk b cur nu)
      |  yell d.cards (hands/mesa/aim b d.out)
    +  row
      '  One row made under /net/mesa, unless it stands already.
      \  home=path have=axal[myth] rel=path source=path cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (axal/has[myth] rel have)  cards
      =  mesa=path ['net 'mesa]
      =  root home.weld(mesa)
      =  at root.weld(rel)
      cards.snoc([at (writ/make (myth/sing ['source] (pt (path_show source))))])
    +  subs_of
      '  The out rows one peer's folder means: every /<X>/subs/<p…>
      '  is out/<X>/<p…>, sourced to the subscription.
      \  home=path have=axal[myth] x=iota view=axal[myth] cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es view.tap
         out=path ['out]
         one=path [x]
      =  xroot home.weld(one)
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  [p t] es.at(i)
      ?  (lt p.len 2)  (_ i.inc cs)
      ?  !(eq_iota p.at(0) 'subs)  (_ i.inc cs)
      =  rel out.snoc(x).weld(p.drop(1))
      (_ i.inc (hands/mesa/row home have rel xroot.weld(p) cs))
    +  outs
      '  The out rows: one peer's folder at a time.
      \  b=bowl home=path have=axal[myth] peers=row[iota] i=nat cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (ge i peers.len)  cards
      =  x peers.at(i)
      =  view b.crew.gut((hands/mesa/rootkey x) (axal/new[myth] .none))
      (hands/mesa/outs b home have peers i.inc (hands/mesa/subs_of home have x view cards))
    +  ref_at
      '  A reference-valued slot (a pinned safe, as blocks and cells
      '  keep their references): its path.
      \  slot=path t=myth
      ^  maybe[path]
      > (./some held) t.get(slot)
        .none
      > s=safe held
        .none
      | ./some s.path
    +  wants_of
      '  The want rows one record's reference slots mean: each
      '  reference to /<home>/<X>/<p…>, X a peer, is want/<X>/<p…>,
      '  sourced to the record.
      \  home=path have=axal[myth] peers=row[iota] at=path t=myth cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es t.tap
         want=path ['want]
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  e es.at(i)
      ?>  (./some p) (hands/mesa/ref_at e.key t)
          (_ i.inc cs)
      ?  (lt p.len 3)  (_ i.inc cs)
      ?  !(eq_iota p.at(0) home.at(0))  (_ i.inc cs)
      ?  !(hands/mesa/has_iota peers p.at(1))  (_ i.inc cs)
      ?  (eq_iota p.at(2) 'subs)  (_ i.inc cs)
      =  rel p.drop(1)
      (_ i.inc (hands/mesa/row home have want.weld(rel) at cs))
    +  want_rows
      '  For one content root: the want rows of every record in it.
      \  home=path have=axal[myth] peers=row[iota] k=iota view=axal[myth] cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      =  es view.tap
         one=path [k]
      =  root home.weld(one)
      %  i=nat 0  cs=row[[p=path q=writ]] cards
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  cs
      =  [p t] es.at(i)
      (_ i.inc (hands/mesa/wants_of home have peers root.weld(p) t cs))
    +  wants
      \  b=bowl home=path have=axal[myth] peers=row[iota] roots=row[iota] i=nat cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (ge i roots.len)  cards
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/wants b home have peers roots i.inc cards)
      =  view b.crew.gut((hands/mesa/rootkey k) (axal/new[myth] .none))
      (hands/mesa/wants b home have peers roots i.inc (hands/mesa/want_rows home have peers k view cards))
    +  hear
      '  Anything moved: every row recomputed from the crew's views and
      '  the missing ones made; the crew aimed again (a new root, a new
      '  peer).
      \  b=bowl cur=myth r=row[dep]
      ^  yell
      =  home b.here.take(1)
         have b.crew.gut(['rows] (axal/new[myth] .none))
         peers (hands/mesa/kids b.crew.gut(['peers] (axal/new[myth] .none)))
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
         none=row[[p=path q=writ]] []
      =  c1 (hands/mesa/outs b home have peers 0 none)
      =  all (hands/mesa/wants b home have peers roots 0 c1)
      |  yell all (hands/mesa/aim b cur)
    +  form
      ^  form
      def_form.set_init(hands/mesa/init).set_talk(hands/mesa/talk).set_hear(hands/mesa/hear)
