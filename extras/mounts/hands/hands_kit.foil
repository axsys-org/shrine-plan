- system_vocabulary
-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=60]

'  hands_kit: helpers for this world's hands.  A hand is a form
'  the agent writes in hands.foil, carried by a record of its own
'  under /app/hands/<name> that names, as text, what it watches
'  (['watch]) and the record it acts on (['target]).  The kit's
'  init aims a crew at both; the hand's own hear decides, and acts
'  by poking its target: a write in this world, in the same event
'  as what woke it.  Nothing here says what a hand is for.
+  hands_kit
  +  at
    '  A path in this world, spelled as text ("/her/0x40/answer/q1").
    \  b=bowl text=str
    ^  path
    ?>  (./some p) (path_parse text)
        []
    |  b.here.take(1).weld(p)
  +  aim
    '  The crew: what the hand watches, all of it, and its target.
    \  b=bowl t=myth
    ^  myth
    =  watch (hands_kit/at b (myth/txt_at ['watch] t))
       target (hands_kit/at b (myth/txt_at ['target] t))
    =  c (crew/sing ['watch] (dep .z watch))
    |  t.put(crew_slot (cpail c.put(['target] (dep .x target))))
  +  init
    \  b=bowl t=myth
    ^  yell
    |  yell [] (hands_kit/aim b t)
  +  talk
    '  Default merge, then aim again: a hand poked with a new watch
    '  watches that.
    \  b=bowl cur=myth nu=myth
    ^  yell
    =  d (def_talk b cur nu)
    |  yell d.cards (hands_kit/aim b d.out)
  +  target_says
    '  Does the hand's target hold this text in this slot?
    \  b=bowl slot=path text=str
    ^  bool
    =  view b.crew.gut(['target] (axal/new[myth] .none))
    ?  view.fil
     >  .none  .false
     >  (./some c=myth)  (equal[str] (myth/txt_at slot c) text)
  +  holds
    '  Does anything the hand watches (the record or anything
    '  beneath it) hold this slot?  An answer may be a record, or a
    '  page whose blocks hold it.
    \  b=bowl slot=path
    ^  bool
    =  view b.crew.gut(['watch] (axal/new[myth] .none))
    =  own
         ?  view.fil
          >  .none  .false
          >  (./some t=myth)  (myth/has_at slot t)
    ?  own  .true
    =  es view.tap
    %  i=nat 0
    ^  bool
    ?  (ge i es.len)  .false
    =  [p t] es.at(i)
    ?  (myth/has_at slot t)  .true
    |  _ i.inc
  +  exists
    '  Is there anything at what the hand watches?
    \  b=bowl
    ^  bool
    =  view b.crew.gut(['watch] (axal/new[myth] .none))
    ?  view.fil
     >  .none  (gt view.tap.len 0)
     >  (./some t=myth)  .true
  +  now
    '  The time the clock record says (['now'], seconds), when a hand
    '  watches /clock.
    \  b=bowl
    ^  nat
    =  view b.crew.gut(['watch] (axal/new[myth] .none))
    ?  view.fil
     >  .none  0
     >  (./some t=myth)  t.nat_at(['now] 0)
  +  poke
    '  Act: these slots poked onto the hand's target, and the hand's
    '  own record marked with when it last acted.
    \  b=bowl cur=myth slots=myth
    ^  yell
    =  target (hands_kit/at b (myth/txt_at ['target] cur))
    |  yell [[target (writ/poke slots)]] cur.put(['acted] (pd (b.now)))
  +  rest
    \  cur=myth
    ^  yell
    |  yell [] cur
  +  seed
    '  A hand's record: its behavior (the kook of the same name in
    '  this app), what it watches and its target, as text paths.
    \  name=iota watch=str target=str
    ^  myth
    =  t (kooked [(pact/rel ['kook name])])
    =  t t.put(['watch] (pails/t watch))
    |  t.put(['target] (pails/t target))
  +  form
    '  A hand's form: aimed by the kit, its hear its own.
    \  hear={\ bowl myth row[dep]}yell
    ^  form
    |  def_form.set_init(hands_kit/init).set_talk(hands_kit/talk).set_hear(hear)
