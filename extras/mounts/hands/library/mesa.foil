  +  mesa
    '  Publication by mention (note/mesa.md).  A doc anywhere in this
    '  world that references a peer X's name for it (a slot holding a
    '  reference into /her/X/…, the kernel's spelling of X's
    '  /our/<me>/…) is published to X: an entry /our/X/<doc> whose
    '  ref slot references the doc live and whole (care z), sourced
    '  to the record the mention was found in.  The sidecar carries
    '  the entry's referent, with what it references among this
    '  world's own names.  Every hear recomputes the entries that
    '  should stand: a missing one is made; one that stands with a
    '  source and is no longer meant is culled; one without a source
    '  (the host's share of a folder or a doc) is left alone, as is
    '  everything else under /our (this world's answers).  The crew:
    '  the world's top at y (its roots), the peers at y (who is a
    '  peer), each content root at z, and /our at z (the entries as
    '  they stand).
    +  content
      '  A top folder that holds content, not machinery or a channel.
      \  k=iota
      ^  bool
      ?  (eq_iota k 'net)  .false
      ?  (eq_iota k 'her)  .false
      ?  (eq_iota k 'our)  .false
      ?  (eq_iota k 'app)  .false
      ?  (eq_iota k 'io)  .false
      ?  (eq_iota k 'r)  .false
      ?  (eq_iota k 'x)  .false
      ?  (eq_iota k 'h)  .false
      ?  (eq_iota k 'c)  .false
      ?  (eq_iota k 'sys)  .false
      ?  (eq_iota k 'log)  .false
      ?  (eq_iota k 'lib)  .false
      ?  (eq_iota k 'clock)  .false
      ?  (eq_iota k 'drafts)  .false
      ?  (eq_iota k 'pages)  .false
      ?  (eq_iota k 'hands)  .false
      .true
    +  has_iota
      \  ks=row[iota] k=iota
      ^  bool
      %  i=nat 0
      ^  bool
      ?  (ge i ks.len)  .false
      ?  (eq_iota ks.at(i) k)  .true
      (_ i.inc)
    +  kids
      '  The children a y view holds: its structure's keys and its
      '  entries one segment long, together.
      \  view=axal[myth]
      ^  row[iota]
      =  es view.tap
         ks0 (axal/kid_keys view)
      %  i=nat 0  ks=row[iota] ks0
      ^  row[iota]
      ?  (ge i es.len)  ks
      =  [p t] es.at(i)
      ?  !(eq p.len 1)  (_ i.inc ks)
      ?  (hands/mesa/has_iota ks p.at(0))  (_ i.inc ks)
      (_ i.inc ks.snoc(p.at(0)))
    +  rootkey
      \  k=iota
      ^  path
      =  rk=path ['root]
      rk.snoc(k)
    +  aim_roots
      '  One hunt per content root, at z.
      \  home=path roots=row[iota] i=nat c=crew
      ^  crew
      ?  (ge i roots.len)  c
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/aim_roots home roots i.inc c)
      =  one=path [k]
      =  at home.weld(one)
      (hands/mesa/aim_roots home roots i.inc c.put((hands/mesa/rootkey k) (dep .z at)))
    +  aim
      '  The crew: the world's top at y (its roots), the peers at y
      '  (who is a peer), each content root at z, and /our at z (the
      '  entries as they stand).
      \  b=bowl t=myth
      ^  myth
      =  home b.here.take(1)
         peerseg=path ['net 'mesa 'peers]
         ourseg=path ['our]
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
      =  ps home.weld(peerseg)
         ours home.weld(ourseg)
      =  c0 (crew/sing ['top] (dep .y home))
      =  c1 c0.put(['peers] (dep .y ps)).put(['ours] (dep .z ours))
      |  t.put(crew_slot (cpail (hands/mesa/aim_roots home roots 0 c1)))
    +  init
      \  b=bowl t=myth
      ^  yell
      |  yell [] (hands/mesa/aim b t)
    +  talk
      \  b=bowl cur=myth nu=myth
      ^  yell
      =  d (def_talk b cur nu)
      |  yell d.cards (hands/mesa/aim b d.out)
    +  is_page
      '  Does the record at this path, in the root's view, say it is
      '  a page (kind = page)?
      \  view=axal[myth] q=path
      ^  bool
      ?>  (./some t) view.get(q)
          .false
      ?>  (./some pl) t.get(['kind])
          .false
      ?  pl
       > x=pails/t  (eq x.t "page")
      .false
    +  doc_of
      '  The doc a record belongs to: the nearest ancestor (itself
      '  included) that is a page; else the record itself (a row).
      \  view=axal[myth] p=path
      ^  path
      %  n=nat p.len
      ^  path
      ?  (eq n 0)  p
      =  q p.take(n)
      ?  (hands/mesa/is_page view q)  q
      (_ n.dec)
    +  entry
      '  One entry that should stand: /our/<X>/<doc>, referencing the
      '  doc live and whole, sourced to the mentioning record.
      \  x=iota doc=path source=path should=axal[myth]
      ^  axal[myth]
      =  one=path [x]
      =  rel one.weld(doc)
      =  t (myth/sing ['source] (pt (path_show source)))
      =  t2 t.put(['ref] (safe 0 .z source.take(1).weld(doc)))
      (axal/put[myth] rel t2 should)
    +  mentions_of
      '  The entries one record's reference slots mean: each
      '  reference to /<home>/her/<X>/…, X a peer, publishes the
      '  record's doc to X.
      \  home=path peers=row[iota] view=axal[myth] one=path p=path at=path t=myth should=axal[myth]
      ^  axal[myth]
      =  es t.tap
      %  i=nat 0  s=axal[myth] should
      ^  axal[myth]
      ?  (ge i es.len)  s
      =  e es.at(i)
      ?>  (./some held) t.get(e.key)
          (_ i.inc s)
      ?  held
       > sf=safe
         =  q sf.path
         ?  (lt q.len 3)  (_ i.inc s)
         ?  !(eq_iota q.at(0) home.at(0))  (_ i.inc s)
         ?  !(eq_iota q.at(1) 'her)  (_ i.inc s)
         ?  !(hands/mesa/has_iota peers q.at(2))  (_ i.inc s)
         (_ i.inc (hands/mesa/entry q.at(2) one.weld((hands/mesa/doc_of view p)) at s))
      (_ i.inc s)
    +  root_entries
      '  For one content root: the entries every record in it means.
      \  home=path peers=row[iota] k=iota view=axal[myth] should=axal[myth]
      ^  axal[myth]
      =  es view.tap
         one=path [k]
      =  root home.weld(one)
      %  i=nat 0  s=axal[myth] should
      ^  axal[myth]
      ?  (ge i es.len)  s
      =  [p t] es.at(i)
      (_ i.inc (hands/mesa/mentions_of home peers view one p root.weld(p) t s))
    +  entries
      \  b=bowl home=path peers=row[iota] roots=row[iota] i=nat should=axal[myth]
      ^  axal[myth]
      ?  (ge i roots.len)  should
      =  k roots.at(i)
      ?  !(hands/mesa/content k)  (hands/mesa/entries b home peers roots i.inc should)
      =  view b.crew.gut((hands/mesa/rootkey k) (axal/new[myth] .none))
      (hands/mesa/entries b home peers roots i.inc (hands/mesa/root_entries home peers k view should))
    +  sourced
      '  An entry of ours: it carries a source.
      \  t=myth
      ^  bool
      ?=((./some _) t.get(['source]))
    +  culls
      '  The entries that stand with a source and should not: culled.
      \  root=path should=axal[myth] hs=row[[p=path q=myth]] i=nat cards=row[[p=path q=writ]]
      ^  row[[p=path q=writ]]
      ?  (ge i hs.len)  cards
      =  [p t] hs.at(i)
      ?  (axal/has[myth] p should)  (hands/mesa/culls root should hs i.inc cards)
      ?  !(hands/mesa/sourced t)  (hands/mesa/culls root should hs i.inc cards)
      (hands/mesa/culls root should hs i.inc cards.snoc([root.weld(p) (writ/cull)]))
    +  diff
      '  The cards: an entry that should stand and does not is made;
      '  one of ours that stands and should not is culled.
      \  home=path have=axal[myth] should=axal[myth]
      ^  row[[p=path q=writ]]
      =  ourseg=path ['our]
      =  root home.weld(ourseg)
         es should.tap
      %  i=nat 0  cs=row[[p=path q=writ]] []
      ^  row[[p=path q=writ]]
      ?  (ge i es.len)  (hands/mesa/culls root should have.tap 0 cs)
      =  [p t] es.at(i)
      ?  (axal/has[myth] p have)  (_ i.inc cs)
      (_ i.inc cs.snoc([root.weld(p) (writ/make t)]))
    +  hear
      '  Anything moved: the entries that should stand recomputed
      '  from the crew's views; the missing made, the stale culled;
      '  the crew aimed again (a new root, a new peer).
      \  b=bowl cur=myth r=row[dep]
      ^  yell
      =  home b.here.take(1)
         have b.crew.gut(['ours] (axal/new[myth] .none))
         peers (hands/mesa/kids b.crew.gut(['peers] (axal/new[myth] .none)))
         roots (hands/mesa/kids b.crew.gut(['top] (axal/new[myth] .none)))
         none=axal[myth] (axal/new[myth] .none)
      =  should (hands/mesa/entries b home peers roots 0 none)
      |  yell (hands/mesa/diff home have should) (hands/mesa/aim b cur)
    +  form
      ^  form
      def_form.set_init(hands/mesa/init).set_talk(hands/mesa/talk).set_hear(hands/mesa/hear)
