- system_vocabulary
-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  pact [order=60]
-  hands_kit [order=70]

'  This world's own hands, written by its agent for logic the
'  page grammar cannot say, and compiled live: each a kook (a
'  form) and the records that carry it.  See hands_kit.
+  hands
  +  app
    '  The app: each hand a kook (its form) and the record that carries
    '  it (hands_kit/seed), named alike.
    ^  mani
    =  kooks=row[kook/decl] []
       seeds=row[[p=path t=myth]] []
    |  mani 'hands (lore/line "This world's hands, written by its agent.") kooks seeds []
