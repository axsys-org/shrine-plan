- system_vocabulary
-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  pact [order=60]
-  helm [order=70]
-  hands [order=80]

'  The hands mount: the app at /app/hands installed on first boot,
'  and on every boot its manifest from the newest publication of
'  hands.foil, so the pact re-expands it (kooks poked with their new
'  forms, new hands made).
+  hands_mount
  +  install
    \  state=namespace
    ^  either[pail namespace]
    =  root=path [state.self 'app 'hands]
       card
         |  (pact/card hands/app "hands" 0 0).put
            limb_slot (kook [[state.self 'kook 'pact]])
       [next index reply]
         |  helm/supervisor/handle (helm/card/step root (writ/make card))
            state (sovereign_hive state)
    ?>  (./ack failure) reply
        |  ./err (pails/t "Hands activation failed")
    ?  (maybe/is_some failure)
       |  ./err (pails/t "Hands activation failed")
    |  ./ok next
  +  start
    \  server=nat arguments=row[str]
    ^  nat
    ?>  (./some root) (path_parse arguments.at(0))
        |  error (pails/t "Invalid hands root")
    =  request  |  helm/card/step root (writ/poke (myth/sing pact/slot hands/app))
    ;  (SendCaps server request [0])
    =  ;[made caps] | Recv[feet/task[unit]] 0
    ;  |  helm/supervisor/close_caps caps
    server
