#import text=lib/grove/types/text
#import lede=sys/lede

agent_id =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Agent ID")

model =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Model")

instructions =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Instructions")

read_dependencies =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Read dependencies")

write_dependencies =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Write dependencies")

pending =
  @slot

dependency_status =
  @slot

hunts_type =
  @type
  ! foil
  goo_paths/hunts
  + read
    \ value=pail
    ^ maybe[hunts_type]
    ?> held=goo_paths/hunts value .none
    | ./some held
  + write
    \ value=hunts_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo_paths/hunts)

draft =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Task")

command =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Requested operation")

status =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Status")

answer =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Answer")

reasoning =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Provider reasoning")

mode =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Workspace page")

catalog =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Agent list")

catalog_type =
  @type
  ! foil
  goo_composition/items
  + read
    \ value=pail
    ^ maybe[catalog_type]
    ?> held=goo_composition/items value .none
    | ./some held
  + write
    \ value=catalog_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo_composition/items)

agents_role =
  @role
  lede: text
  %/agent_id: text
  %/model: text
  %/instructions: text
  %/read_dependencies: %/hunts_type
  %/write_dependencies: %/hunts_type
  %/draft: text
  %/command: text
  %/status: text
  %/answer: text
  %/reasoning: text
  %/mode: text
  %/catalog: %/catalog_type
  %/pending: %/catalog_type
  %/dependency_status: text

send =
  @action
  #meta ;
    "/sys/lede": (pails/t "Send task")
  #on ; %/agents_role
  %/draft: text
  ! foil
  \ draft=text item=%/agents_role
  ^ %/agents_role
  | item.set_draft(draft).set_command("send")

resume =
  @action
  #meta ;
    "/sys/lede": (pails/t "Resume / retry")
  #on ; %/agents_role
  %/draft: text
  ! foil
  \ draft=text item=%/agents_role
  ^ %/agents_role
  | item.set_draft(draft).set_command("resume")

open_agent =
  @action
  #on ; %/agents_role
  %/agent_id: text
  ! foil
  \ agent_id=text item=%/agents_role
  ^ %/agents_role
  | item.set_agent_id(agent_id).set_command("open")

add_agent =
  @action
  #on ; %/agents_role
  ! foil
  \ item=%/agents_role
  ^ %/agents_role
  | item.set_command("new")

create =
  @action
  #on ; %/agents_role
  %/agent_id: text
  %/model: text
  %/instructions: text
  %/read_dependencies: %/hunts_type
  %/write_dependencies: %/hunts_type
  %/draft: text
  ! foil
  \ agent_id=text model=text instructions=text read_dependencies=%/hunts_type write_dependencies=%/hunts_type draft=text item=%/agents_role
  ^ %/agents_role
  | item.set_agent_id(agent_id).set_model(model).set_instructions(instructions).set_read_dependencies(read_dependencies).set_write_dependencies(write_dependencies).set_draft(draft).set_command("create")

save_dependencies =
  @action
  #on ; %/agents_role
  %/read_dependencies: %/hunts_type
  %/write_dependencies: %/hunts_type
  ! foil
  \ read_dependencies=%/hunts_type write_dependencies=%/hunts_type item=%/agents_role
  ^ %/agents_role
  = change (myth/sing ['id] (pails/t item.agent_id)).put(['read_dependencies] read_dependencies).put(['write_dependencies] write_dependencies)
    pending item.pending.rows.keep((\ row=myth !(eq row.txt_at(['id]) item.agent_id))).snoc(change)
    active ((eq item.status "running") || (eq item.status.slice(0 7) "Running"))
  | item.set_read_dependencies(read_dependencies).set_write_dependencies(write_dependencies).set_pending((goo_composition/items pending)).set_dependency_status((? active "Applies after this turn" "Dependencies saved"))

agents =
  @view
  #meta ;
    "/sys/lede": (pails/t "Agents")
    "/sys/help": (pails/t "Choose an agent or add a new one.")
  #on ; %/agents_role
  #for ; /sys/slot/body
  item => columns(tracks = [220 fr(1)]) {
    row {
      col(context = .compact) {
        text("Agents", role = .heading)
        group(on = item, action = %/add_agent) { action("+ Add agent", key = "add-agent") }
        group(each = item.catalog, as = "agent") {
          group(on = item, action = %/open_agent) {
            action(agent.label, %/agent_id = agent.id, key = agent.key, significance = .quiet)
          }
          text(agent.status, role = .caption)
        }
      }
      col {
        group(when = item.mode, is = "empty") {
          text("Your agents", role = .title)
          text("Choose an agent from the sidebar, or add one to get started.")
        }
        group(when = item.mode, is = "new") {
          group(on = item, action = %/create, myth = { %/agent_id = .input(item.agent_id), %/model = .input(item.model), %/instructions = .input(item.instructions), %/read_dependencies = .input(item.read_dependencies), %/write_dependencies = .input(item.write_dependencies), %/draft = .input(item.draft) }) {
            col {
              text("New agent", role = .title)
              text("Give it instructions and a place to work.", role = .caption)
              input(%/agent_id, kind = .text, label = "Name", key = "agent-id")
              input(%/model, kind = .text, label = "Model", key = "model")
              input(%/instructions, kind = .text, label = "Instructions", key = "instructions", multiline = 1)
              input(%/read_dependencies, kind = .path, many = 1, care = .choose, access = .read, label = "Read dependencies", key = "read-dependencies")
              input(%/write_dependencies, kind = .path, many = 1, care = .choose, access = .write, label = "Write dependencies", key = "write-dependencies")
              input(%/draft, kind = .text, label = "First task · optional", key = "first-task", multiline = 1)
              text(item.status, role = .caption)
              action("Create agent", key = "create-agent")
            }
          }
        }
        group(when = item.mode, is = "detail") {
          col {
            text(item.agent_id, role = .title)
            text(item.status, role = .caption)
            text(item.model, role = .caption)
            group(on = item, myth = { %/draft = .input(item.draft) }) {
              col {
                input(%/draft, kind = .text, label = "New task", key = "task", multiline = 1)
                row {
                  group(action = %/send) { action("Send task", key = "send") }
                  group(action = %/resume) { action("Resume / retry", key = "resume") }
                }
              }
            }
            group(on = item, action = %/save_dependencies, myth = { %/read_dependencies = .input(item.read_dependencies), %/write_dependencies = .input(item.write_dependencies) }) {
              col {
                text("Dependencies", role = .heading)
                input(%/read_dependencies, kind = .path, many = 1, care = .choose, access = .read, label = "Read dependencies", key = "read-dependencies")
                input(%/write_dependencies, kind = .path, many = 1, care = .choose, access = .write, label = "Write dependencies", key = "write-dependencies")
                text("Write access also includes read access. File selects one record; Folder includes its frontier; Subtree includes all descendants.", role = .caption)
                text(item.dependency_status, role = .caption)
                action("Save dependencies", key = "save-dependencies", significance = .quiet)
              }
            }
            text("Answer", role = .heading)
            text(item.answer)
            text("Provider reasoning", role = .heading)
            text(item.reasoning)
          }
        }
      }
    }
  }
