#import text=lib/grove/types/text
#import content=sys/content
#import author=sys/author
#import channel=gov/shuin_chat/channel
#import message=gov/shuin_chat/message

post_message =
  @stencil
  #on ; /channel
  #for ; /message
  #meta ;
    "/sys/lede": (pails/t "Post message")
    "/sys/help": (pails/t "Create a message in this channel. Supply content and author; Shrine supplies the timestamp and allocates a fresh child name.")
  content: text
  author: text
  ! foil
  \ body=str by=str parent=channel created_at=nat
  ^ message
  ; (? (and body.len by.len) 0 (error (pails/t "Message content and author must not be empty.")))
  | message body by created_at myth/new
