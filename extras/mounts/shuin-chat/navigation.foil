- stdlib/runtime
- stdlib/runtime
- stdlib/runtime

' The mounted adapter fixes the source, port and pane. HTTP cannot choose them.
+ shuin_navigation
  + channel_slot
    ^ path
    ['channel]
  + thread_slot
    ^ path
    ['thread]
  + member
    \ held=pail
    ^ either[str goo_context/member]
    ? held
     > value=goo_context/member (./ok value)
     > value=goo_context/unavailable (shuin_navigation/member value.value)
    | ./err "Invalid selected member."
  + request
    : session=str operation=str id=str expected=nat target=str dirty=bool suspend=bool
  + receipt
    : request=shuin_navigation/request
  + home
    \ session=str state=namespace
    ^ path
    [state.self 'app 'shuin_navigation ($ts (str/cat_all ["session_" session]))]
  + bridge
    \ session=str state=namespace
    ^ path
    [state.self 'io 'shuin_navigation ($ts (str/cat_all ["session_" session]))]
  + emit
    \ bowl=bowl cur=myth add=myth
    ^ yell
    ?> (./some home) cur.path_at(['context]) (yell [] cur)
    ?> (./some held) add.get(goo_context/intent_slot) (yell [] cur)
    | yell [[home (writ/poke (myth/sing goo_context/intent_slot held))]] cur
  + install
    \ state=namespace
    ^ either[iota namespace]
    < state (grove_install/change [state.self 'kook 'shuin_context]
        (writ/make (form/card (def_form.set_talk(goo_context/talk)) (lore/line "Standard navigation context"))) state)
    | grove_install/change [state.self 'kook 'shuin_context_bridge]
        (writ/make (form/card (def_form.set_talk(shuin_navigation/emit)) (lore/line "Shuin channel port bridge"))) state
  + capture
    \ target=path state=namespace
    ^ either[str goo_context/member]
    = source=path [state.self 'app 'shuin_chat]
    ? !(row/has[path] target [source.snoc('festival) source.snoc('planning)]) (./err "Target is not a declared channel.")
    = value (goo_context/member source (goo_context/lifetime source state) target target
        (goo_context/lifetime target state) (state.case(.x target)).fall(0) .y)
    < valid (goo_context/validate_member value state)
    | ./ok value
  + change
    \ target=path command=writ state=namespace
    ^ either[str namespace]
    ? (grove_install/change target command state)
     > (./ok next) (./ok next)
     > (./err _) (./err "Navigation namespace transaction refused.")
  + open
    \ session=str state=namespace
    ^ either[str namespace]
    = home (shuin_navigation/home session state)
      bridge (shuin_navigation/bridge session state)
    ? (maybe/is_some (sovereign_care .x home state).fil) (./ok state)
    < initial (shuin_navigation/capture [state.self 'app 'shuin_chat 'festival] state)
    < declarations (goo_context/declare
        [(goo_context/slot shuin_navigation/channel_slot "address" "member" [['channels]] "push" [] .true)
         (goo_context/slot shuin_navigation/thread_slot "selection" "member" [['threads]] "push" [shuin_navigation/channel_slot] .false)] bridge)
    = record (goo_context/record declarations [state.self 'kook 'shuin_context]
        (myth/sing shuin_navigation/channel_slot initial))
      record (myth/meld record (root/named "Chat workspace" "The followed channel, thread and navigation history for this workspace."))
      bridge_record (myth/sing ['context] (pails/p home)).put(limb_slot (kook [[state.self 'kook 'shuin_context_bridge]]))
      bridge_record (myth/meld bridge_record (root/named "Chat navigation" "Accepts channel and thread navigation requests for this workspace."))
    < next (shuin_navigation/change bridge (writ/make bridge_record) state)
    | shuin_navigation/change home (writ/make record) next
  + project
    \ session=str state=namespace
    ^ either[str json]
    = home (shuin_navigation/home session state)
    ?> (./some card) (sovereign_care .x home state).fil (./err "Navigation context is unavailable.")
    ?> (./some held) card.get(shuin_navigation/channel_slot) (./err "Channel slot is unavailable.")
    < member (shuin_navigation/member held)
    = available !(goo_context/stale member state)
    = pane=path [state.self 'gov 'shuin_chat 'room]
    ?> (./some pane_record) (goo_runtime/record .x pane state) (./err "Room pane is unavailable.")
    < published (goo_runtime/published pane_record)
    ? !(and published.view.is_pane (published.view.ports.has(['channel]))) (./err "Room must declare its consumed channel port.")
    = matching=either[str unit]
        ? !available (./ok [])
        ?> (./some subject) (goo_runtime/record .x member.subject state) (./err "Channel subject is unavailable.")
        < matched (goo_runtime/matching_view published subject)
        | ./ok []
    < matching matching
    < thread (shuin_navigation/project_thread card member state)
    ?> (./some held) card.get(goo_context/history_slot) (./err "Context history is unavailable.")
    ?> history=goo_context/history held (./err "Invalid context history.")
    | ./ok (json/obj [
        (jkv "version" (json/num .false 1)) (jkv "session" (json/str session))
        (jkv "context" (json/str (path_show home))) (jkv "revision" (json/str (nat/show (state.case(.x home)).fall(0))))
        (jkv "slot" (json/str "/channel")) (jkv "kind" (json/str "address"))
        (jkv "channel" (json/str (path_show member.subject))) (jkv "life" (json/str (nat/show member.life)))
        (jkv "order" (json/str (nat/show history.orders.gut(shuin_navigation/channel_slot 0))))
        (jkv "historyLength" (json/num .false history.entries.len))
        (jkv "historyIndex" (json/num .false history.index))
        (jkv "available" (json/boo available)) (jkv "thread" thread)
        (jkv "pane" (json/str (path_show pane))) (jkv "paneVersion" (json/str (nat/show (state.case(.x pane)).fall(0))))
        (jkv "port" (json/str "/channel"))
        (jkv "composer" (json/str (path_show [state.self 'gov 'shuin_chat 'native_composer])))
        (jkv "entry" (json/str (path_show [state.self 'gov 'shuin_chat 'entry])))])
  + project_thread
    \ card=myth channel=goo_context/member state=namespace
    ^ either[str json]
    ?> (./some held) card.get(shuin_navigation/thread_slot) (./ok (json/nul 0))
    < member (shuin_navigation/member held)
    ? !(and (equal member.source channel.subject) (eq member.source_life channel.life)) (./err "Thread belongs to a different channel incarnation.")
    = pane=path [state.self 'gov 'shuin_chat 'thread_room]
      available !(goo_context/stale member state)
    ?> (./some pane_record) (goo_runtime/record .x pane state) (./err "Thread pane is unavailable.")
    < published (goo_runtime/published pane_record)
    ? !(and published.view.is_pane (published.view.ports.has(['thread]))) (./err "Thread pane must declare its consumed thread port.")
    = matching=either[str unit]
        ? !available (./ok [])
        ?> (./some subject) (goo_runtime/record .x member.subject state) (./err "Thread subject is unavailable.")
        < matched (goo_runtime/matching_view published subject)
        | ./ok []
    < matching matching
    | ./ok (json/obj [
        (jkv "subject" (json/str (path_show member.subject))) (jkv "life" (json/str (nat/show member.life)))
        (jkv "available" (json/boo available))
        (jkv "pane" (json/str (path_show pane))) (jkv "paneVersion" (json/str (nat/show (state.case(.x pane)).fall(0))))
        (jkv "port" (json/str "/thread"))
        (jkv "composer" (json/str (path_show [state.self 'gov 'shuin_chat 'thread_composer])))])
  + intent
    \ query=shuin_navigation/request card=myth history=goo_context/history state=namespace
    ^ either[str pail]
    = order (history.orders.tap.fold(0 (\ n=nat entry (? (gt n entry.val) n entry.val)))).inc
    ? (eq query.operation "back")
      ? !(history.index) (./err "Already at the beginning of history.")
      | ./ok (goo_context/traversal history.index.dec)
    ? (eq query.operation "forward")
      ? (ge history.index.inc history.entries.len) (./err "Already at the end of history.")
      | ./ok (goo_context/traversal history.index.inc)
    ? (eq query.operation "hide")
      | ./ok (goo_context/clear ['threads] order [shuin_navigation/thread_slot])
    ?> (./some target) (path_parse query.target) (./err "Invalid navigation target.")
    ? (eq query.operation "move")
      < member (shuin_navigation/capture target state)
      | ./ok (goo_context/stamp ['channels] order (myth/sing shuin_navigation/channel_slot member))
    ?> (./some held) card.get(shuin_navigation/channel_slot) (./err "Channel slot is unavailable.")
    < channel (shuin_navigation/member held)
    ? (goo_context/stale channel state) (./err "Selected channel was removed or replaced. Select its new incarnation explicitly.")
    = member (goo_context/member channel.subject channel.life target target
        (goo_context/lifetime target state) (state.case(.x target)).fall(0) .y)
    < valid (goo_context/validate_member member state)
    | ./ok (goo_context/stamp ['threads] order (myth/sing shuin_navigation/thread_slot member))
  + move
    \ query=shuin_navigation/request state=namespace
    ^ either[str namespace]
    = home (shuin_navigation/home query.session state)
      bridge (shuin_navigation/bridge query.session state)
    ?> (./some card) (sovereign_care .x home state).fil (./err "Open the context before moving.")
    = replay=maybe[shuin_navigation/request]
        < held card.get(['receipt])
        ?> receipt=shuin_navigation/receipt held .none
        | ./some receipt.request
    ? (replay.run((\ old=shuin_navigation/request (eq old.id query.id))).fall(.false))
      ? (equal replay.fall(query) query) (./ok state)
      | ./err "Navigation request ID was reused with different content."
    ? !(eq query.expected (state.case(.x home)).fall(0)) (./err "Context changed; this navigation intent is stale.")
    ?> (./some held) card.get(goo_context/history_slot) (./err "Context history is unavailable.")
    ?> history=goo_context/history held (./err "Invalid context history.")
    < intent (shuin_navigation/intent query card history state)
    = guarded (and query.dirty !(query.suspend))
      guards=row[path]
        ? !guarded []
        ? (row/has[str] query.operation ["thread" "hide"]) [shuin_navigation/thread_slot]
        [shuin_navigation/channel_slot shuin_navigation/thread_slot]
      candidate card.put(goo_context/guard_slot (goo_context/guard guards))
      checked (goo_context/command bridge candidate intent)
    ' The actual hand authenticates the namespace sender for every command,
    ' including clear and Back/Forward. A refusal rolls back the entire candidate.
    < next (shuin_navigation/change home (writ/make candidate) state)
    < next (shuin_navigation/change bridge (writ/poke (myth/sing goo_context/intent_slot intent)) next)
    < checked checked
    ?> (./some accepted) (sovereign_care .x home next).fil (./err "Context hand did not accept navigation.")
    ? !(and (equal (accepted.get(shuin_navigation/channel_slot)) (checked.get(shuin_navigation/channel_slot)))
        (and (equal (accepted.get(shuin_navigation/thread_slot)) (checked.get(shuin_navigation/thread_slot)))
          (equal (accepted.get(goo_context/history_slot)) (checked.get(goo_context/history_slot)))))
      | ./err "Context hand did not accept navigation."
    = accepted accepted.put(['receipt] (shuin_navigation/receipt query))
    | shuin_navigation/change home (writ/make accepted) next
  + reply
    \ query=shuin_navigation/request accepted=bool why=str state=namespace
    ^ [nat str]
    ? (shuin_navigation/project query.session state)
     > (./err error) [409 (show (json/obj [(jkv "error" (json/str error))]))]
     > (./ok snapshot)
      [(? accepted 200 409) (show (json/obj [(jkv "accepted" (json/boo accepted))
        (jkv "message" (json/str why)) (jkv "state" snapshot)]))]
  + run
    \ query=shuin_navigation/request state=namespace
    ^ [namespace nat str]
    = result=either[str namespace]
        ? (eq query.operation "open") (shuin_navigation/open query.session state)
        ? (eq query.operation "read") (./ok state)
        | shuin_navigation/move query state
    ? result
     > (./err why)
      = [status body] (shuin_navigation/reply query .false why state)
      [state status body]
     > (./ok next)
      = refreshed (goo_context/refresh (shuin_navigation/home query.session next) next)
      = next=namespace
          ? refreshed
           > (./ok fresh) fresh
           > (./err _) next
      = [status body] (shuin_navigation/reply query .true "" next)
      [(? (eq status 200) next state) status body]
  + identity
    \ text=str
    ^ bool
    | and (eq text.len 32) ((list/range 0 text.len).all((\ i=nat ((and (ge text.at(i) 48) (le text.at(i) 57)) || (and (ge text.at(i) 97) (le text.at(i) 102))))))
  + parse
    \ fields=row[[str str]]
    ^ either[str shuin_navigation/request]
    = get (\ key=str (http_foot/field key fields))
      allowed=row[str] ["session" "operation" "id" "expected" "target" "dirty" "suspend"]
    ? !(and (le fields.len 7) (fields.all((\ [key value] (allowed.has(key)))))) (./err "Unknown navigation field; port and pane are fixed by the mount.")
    ? !(fields.all((\ [key value] (eq (fields.keep((\ [other value] (eq key other)))).len 1)))) (./err "Duplicate navigation field.")
    ? !(shuin_navigation/identity (get "session")) (./err "Invalid navigation session.")
    = op (get "operation")
    ? !(row/has[str] op ["open" "read" "move" "thread" "hide" "back" "forward"]) (./err "Unknown navigation operation.")
    ? (row/has[str] op ["open" "read"]) (./ok (shuin_navigation/request (get "session") op "" 0 "" .false .false))
    ? !(shuin_navigation/identity (get "id")) (./err "Invalid navigation request ID.")
    ?> (./some expected) (nat/parse (get "expected")) (./err "Invalid context revision.")
    ? !(and (row/has[str] (get "dirty") ["0" "1"]) (row/has[str] (get "suspend") ["0" "1"])) (./err "Explicit owner guard and suspension values are required.")
    | ./ok (shuin_navigation/request (get "session") op (get "id") expected (get "target") (eq (get "dirty") "1") (eq (get "suspend") "1"))
  + http
    \ body=str
    ^ http_foot/action
    ? (gt body.len 4096) (./reply (http_driver/response 413 "Navigation request too large"))
    ? (shuin_navigation/parse (http_foot/fields body))
     > (./err why) (./reply (http_driver/response 400 why))
     > (./ok query) (./transact (shuin_navigation/run query))
