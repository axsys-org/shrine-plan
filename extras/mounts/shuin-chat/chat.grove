#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import time_type=lib/grove/types/time
#import lede=sys/lede
#import help=sys/help
#import content=sys/content
#import author=sys/author
#import now=sys/now

address =
  @slot

channel =
  @role
  lede: text
  %/address: path_type

message =
  @role
  content: text
  author: text
  now: time_type

composer =
  @view
  #on ; %/channel
  #for ; /sys/slot/shuin_composer
  channel => col {
    show(channel.lede, '/sys/slot/title)
    group(make = channel, allocation = "child", role = %/message, myth = {
      '/sys/content = .input("")
      '/sys/author = "Ren Takeda"
      '/sys/now = .provider
    }) {
      input('/sys/content)
      action("Send", significance = .significant)
    }
  }

entry =
  @view
  #on ; %/message
  #for ; /sys/slot/shuin_entry
  message => col {
    row {
      show(message.author, '/sys/slot/label)
      show(message.now, '/sys/slot/summary)
    }
    show(message.content, '/sys/slot/body)
  }

"/" =
  @tree
  lede: "Festival chat"
  help: "Channels, messages and reference notes for the autumn festival."

"/footnotes" =
  @tree
  lede: "Reference notes"
  help: "Linked notes used by the conversation studies."

"/festival" =
  @tree
  lede: "Festival autumn"
  help: "Festival announcements, questions and conversation."
  %/address: (pails/p [($x 17) 'app 'shuin_chat 'festival])

"/festival/welcome" =
  @tree
  lede: "Festival dates"
  help: "The opening announcement for the autumn festival."
  content: "Festival dates are confirmed: 28 and 29 November."
  author: "Kenji Ota"
  now: '@2026.11.17..9.2.0

native_composer =
  @view
  #on ; %/channel
  #for ; /sys/slot/shuin_native_composer
  channel => col {
    show(channel.lede, '/sys/slot/title)
    group(make = channel, allocation = "child", role = %/message, myth = {
      '/sys/content = .input("")
      '/sys/author = "Ren Takeda"
      '/sys/now = .provider
    }) {
      input('/sys/content, kind = .text, label = "Message", multiline = 1, submit = "enter")
      action("Send", significance = .significant)
    }
  }

thread_composer =
  @view
  #on ; %/message
  #for ; /sys/slot/shuin_thread_composer
  message => group(make = message, allocation = "child", role = %/message, myth = {
    '/sys/content = .input("")
    '/sys/author = "Ren Takeda"
    '/sys/now = .provider
  }) {
    input('/sys/content, kind = .text, label = "Message", multiline = 1, submit = "enter")
    action("Reply", significance = .significant)
  }

"/planning" =
  @tree
  lede: "Festival planning"
  help: "Coordinate preparations for the autumn festival."
  %/address: (pails/p [($x 17) 'app 'shuin_chat 'planning])

bounded_history =
  @view
  #on ; %/channel
  #for ; /sys/slot/shuin_bounded_history
  channel => repeat(channel.address, '/sys/slot/shuin_entry, max = 2)

reply_to =
  @slot

footnote =
  @role
  content: text
  %/reply_to: path_type

footnote_entry =
  @view
  #on ; %/footnote
  #for ; /sys/slot/shuin_footnote
  note => text(note.content, role = .quote)

footnote_chain =
  @view
  #on ; %/channel
  #for ; /sys/slot/shuin_footnote_chain
  channel => chain('/0x11/app/shuin_chat/footnotes/n1, via = %/reply_to, slot = '/sys/slot/shuin_footnote, depth = 5)

"/footnotes/n1" =
  @tree
  lede: "Order two pins"
  content: "Order two pins, not one."
  %/reply_to: (pails/p [($x 17) 'app 'shuin_chat 'footnotes 'n2])

"/footnotes/n2" =
  @tree
  lede: "Which hinge?"
  content: "Which hinge?"
  %/reply_to: (pails/p [($x 17) 'app 'shuin_chat 'footnotes 'n3])

"/footnotes/n3" =
  @tree
  lede: "The gate sticks"
  content: "The gate sticks."
  %/reply_to: (pails/p [($x 17) 'app 'shuin_chat 'footnotes 'n4])

"/footnotes/n4" =
  @tree
  lede: "Oil the lower pin"
  content: "Oil the lower pin."
  %/reply_to: (pails/p [($x 17) 'app 'shuin_chat 'footnotes 'n5])

"/footnotes/n5" =
  @tree
  lede: "A note that links to itself"
  content: "See this note again."
  %/reply_to: (pails/p [($x 17) 'app 'shuin_chat 'footnotes 'n5])

constraint_examples =
  @view
  #on ; %/channel
  #for ; /sys/slot/shuin_constraints
  channel => col {
    columns(tracks = [.content fr(1)]) {
      row { text("Room", role = .label) show(channel.lede, '/sys/slot/body) }
      row { text("Description", role = .label) text("Shared content and fractional tracks") }
    }
    lines {
      row { text("Root") }
      row(indent = 1) { text("Child") }
      row(indent = 2) { text("Grandchild") }
    }
  }

room =
  @pane
  #on ; %/channel
  #for ; /sys/slot/shuin_room
  #port ; /channel
  channel => selection('/thread, source = channel.address) {
    present(channel, '/sys/slot/shuin_native_composer)
  }

thread_room =
  @pane
  #on ; %/message
  #for ; /sys/slot/shuin_thread_room
  #port ; /thread
  message => present(message, '/sys/slot/shuin_thread_composer)

namespace_subject =
  @role
  #opt ;
    lede: text

namespace_scene =
  @pane
  #on ; %/namespace_subject
  #for ; /sys/slot/shuin_namespace_scene
  #port ; /folder
  node => text("Namespace", role = .title)

namespace_record =
  @pane
  #on ; %/namespace_subject
  #for ; /sys/slot/shuin_namespace_record
  #port ; /selected
  node => text("Record", role = .heading)
