- change_workbench
- source_mount
- shuin_stencils
- shuin_scenes
- shuin_views
- shuin_presentation

' Target kinds own compatibility and isolated behavioral tests. The lifecycle
' knows neither these policies nor their application paths.
+ shuin_workbench
  + stencil_policy
    : declaration=path parent=path result=path arguments=row[path] timestamp=path
  + view_policy
    : declaration=path role=path slot=path controls=row[str]
  + stencil_policy_at
    \ registration=change_workbench/registration
    ^ maybe[shuin_workbench/stencil_policy]
    < held registration.policy.get((change_workbench/key 'policy))
    ?> value=shuin_workbench/stencil_policy held .none
    | ./some value
  + view_policy_at
    \ registration=change_workbench/registration
    ^ maybe[shuin_workbench/view_policy]
    < held registration.policy.get((change_workbench/key 'policy))
    ?> value=shuin_workbench/view_policy held .none
    | ./some value
  + namespace_activation
    \ registration=change_workbench/registration outputs=row[path]
    ^ either[str change_workbench/activation_plan]
    | ./ok (change_workbench/activation_plan registration.activation outputs [])
  + stencil_validate
    \ registration=change_workbench/registration state=namespace
    ^ either[str unit]
    ?> (./some policy) (shuin_workbench/stencil_policy_at registration) (./err "Missing stencil compatibility policy.")
    = card (change_workbench/record policy.declaration state)
    ?> (./some held) card.get(system_vocabulary/grove/stencil) (./err "The required stencil is missing.")
    ?> schema=grove_stencil_schema held (./err "Invalid stencil schema.")
    ? !(and (equal schema.receiver policy.parent) (equal schema.result policy.result)) (./err "The stencil parent and result roles must remain compatible.")
    ? !(equal (schema.arguments.fields.map((\ field field.slot))) policy.arguments) (./err "The required argument interface changed.")
    ? (schema.arguments.fields.any((\ field field.optional))) (./err "Required arguments cannot become optional.")
    ?> (./some held) card.get(grove_backend/module_slot) (./err "Compiler metadata is missing.")
    ?> bundle=grove_backend/bundle held (./err "Invalid compiler metadata.")
    = text_contract (curb/of_type (^ pails/t))
      text_arguments
        | schema.arguments.fields.all
        \ field
        ?> (./some exported) bundle.exports.get(['fields ($ts (str/to_atom field.name)) 'contract]) .false
        | equal[any] exported.value text_contract
      definitions
        | registration.units.map
        \ unit
        | (sovereign_care .z unit.root state).tap.keep((\ [path record] record.has(system_vocabulary/grove/stencil))).len
    ? !(text_arguments) (./err "Stencil arguments must retain their text codecs.")
    ? !(eq (row/fold[nat nat] 0 (\ total count (add total count)) definitions) 1) (./err "This target must publish exactly one stencil.")
    | ./ok unit/unit
  + typed_json
    \ text=str
    ^ either[str myth]
    ?> (jres/ok value rest) (parse text) (./err "Expected a JSON object of typed slot values.")
    ?> (json/obj fields) value (./err "Expected a JSON object of typed slot values.")
    % rest=row[jkv] fields out=myth myth/new
    ^ either[str myth]
    ? !(rest.len) (./ok out)
    = item rest.at(0)
    ?> (./some slot) (path_parse item.k) (./err "Invalid expected slot path.")
    < value (namespace_text/data (goo_runtime/json_text (goo_runtime/json_field "type" item.v)) (goo_runtime/json_field "value" item.v))
    | _ rest.drop(1) out.put(slot value)
  + diagnostic_text
    ' Review code uses explicit UTF-8 byte escapes outside ASCII. Actual values
    ' stay unchanged in the candidate and typed test expectations.
    \ text=str
    ^ str
    = pieces
        % index=nat 0 out=list[str] .nil
        ^ row[str]
        ? text.eof(index) out.row.rev
        = byte text.at(index)
          part (? (lt byte 128) text.slice(index 1) (str/cat_all [(str/from_atom 92) "x" (hex/byte byte)]))
        | _ index.inc out.cons(part)
    | str/cat_all pieces
  + stencil_test
    \ registration=change_workbench/registration case=myth state=namespace
    ^ either[str str]
    ?> (./some policy) (shuin_workbench/stencil_policy_at registration) (./err "Missing stencil test policy.")
    ?> (./some fixture) case.path_at((change_workbench/key 'fixture)) (./err "Choose a captured parent fixture.")
    = parent (change_workbench/record fixture state)
      declaration (change_workbench/record policy.declaration state)
    ?> (./some matched) (shuin_stencils/compatible declaration parent state) (./err "Fixture does not satisfy the fixed parent contract.")
    = [schema contract] matched
    ?> (./some held) declaration.get(system_vocabulary/grove/stencil_handler) (./err "Stencil handler missing.")
    ?> handler=grove_stencil_handler held (./err "Stencil handler is invalid.")
    < arguments (shuin_workbench/typed_json case.txt_at(system_vocabulary/content))
    < expected (shuin_workbench/typed_json case.txt_at((change_workbench/key 'outputs)))
    ?> (./some now) (nat/parse case.txt_at((change_workbench/key 'time))) (./err "Fixture time must be an integer.")
    = apply handler.apply
      attempt (Try (apply now arguments) parent)
      output=maybe[myth]
        ? attempt
         > (./err why) .none
         > (./ok output) output
      accepts (eq case.txt_at((change_workbench/key 'expect)) "accept")
    ? !((eq case.txt_at((change_workbench/key 'expect)) "accept") || (eq case.txt_at((change_workbench/key 'expect)) "reject")) (./err "Expected outcome must be accept or reject.")
    ? !(accepts) (? (maybe/is_none output) (./ok "Rejected as expected") (./err "Expected rejection, but the stencil accepted."))
    ?> (./some output) output (./err "Expected acceptance, but the stencil rejected.")
    ? (maybe/is_some (fit_check output.put(system_vocabulary/lash contract))) (./err "Output violates the fixed result contract.")
    ? !(eq output.nat_at(policy.timestamp 0) now) (./err "Output did not use the supplied timestamp.")
    ? !(expected.tap.all((\ [slot value] (equal output.get(slot) (maybe/some[pail] value))))) (./err "Output slots differ from the expected values.")
    < rendered (namespace_text/record (namespace_text/value state) fixture fixture output)
    | ./ok (str/cat_all ["Accepted; contract and timestamp passed. Output (non-ASCII UTF-8 bytes escaped):" (str/from_atom 10) (shuin_workbench/diagnostic_text rendered)])
  + view_validate
    \ registration=change_workbench/registration state=namespace
    ^ either[str unit]
    ?> (./some policy) (shuin_workbench/view_policy_at registration) (./err "Missing Goo compatibility policy.")
    < published (goo_runtime/published (change_workbench/record policy.declaration state))
    ? !(and (equal published.view.role policy.role) (equal published.view.slot policy.slot)) (./err "The Goo receiver and presentation slot must remain compatible.")
    ? published.result
     > (./err why) (./err "Goo lowering failed.")
     > (./ok view)
      = controls (shuin_workbench/control_keys view.children)
      ? !(equal controls policy.controls) (./err "The renderer must preserve its editing control keys.")
      | ./ok unit/unit
  + control_keys
    \ nodes=list[goo/node]
    ^ row[str]
    = append
        \ out=row[str] node=goo/node
        = key (goo_vocabulary/attr "key" node)
        | (? key.len out.snoc(key) out).weld((shuin_workbench/control_keys node.children))
    | list/fold[goo/node row[str]] [] append nodes
  + constructors
    \ nodes=list[goo/node]
    ^ row[str]
    = append
        \ out=row[str] node=goo/node
        | out.snoc(node.constructor).weld((shuin_workbench/constructors node.children))
    | list/fold[goo/node row[str]] [] append nodes
  + view_test
    \ registration=change_workbench/registration case=myth state=namespace
    ^ either[str str]
    ?> (./some policy) (shuin_workbench/view_policy_at registration) (./err "Missing Goo test policy.")
    ?> (./some fixture) case.path_at((change_workbench/key 'fixture)) (./err "Choose a captured example record.")
    = card (change_workbench/record fixture state)
    < published (goo_runtime/published (change_workbench/record policy.declaration state))
    < view (goo_runtime/matching_view published card)
    < prepared (shuin_views/render fixture policy.declaration state)
    = constructors (shuin_workbench/constructors view.children)
      required (str/split_byte 10 case.txt_at((change_workbench/key 'expect)))
    ? !(required.all((\ name ((eq name.len 0) || constructors.has(name))))) (./err "Lowered view is missing an expected constructor.")
    < expected (shuin_workbench/typed_json case.txt_at((change_workbench/key 'outputs)))
    ? !(expected.tap.all((\ [slot value] (equal card.get(slot) (maybe/some[pail] value))))) (./err "Captured displayed values differ from expectations.")
    = rendered (show prepared)
      visible
        | expected.tap.all
        \ [slot value]
        ?> value=pails/t value .false
        | maybe/is_some (str/find (show (json/str value.t)) rendered)
    ? !(visible) (./err "An expected text value is absent from the rendered view.")
    | ./ok (str/cat_all ["Goo lowered and rendered; constructors: " (str/join ", " constructors)])
  + named
    \ title=str description=str
    ^ myth
    | (myth/sing system_vocabulary/lede (pails/t title)).put(system_vocabulary/help (pails/t description))
  + source_record
    \ title=str code=str control=path
    ^ myth
    | (shuin_workbench/named title "Edit source, build an isolated candidate, then run its tests. Publication requires review on the target's control record.").put(system_vocabulary/content (pails/t code)).put((change_workbench/key 'command) (pails/t "")).put((change_workbench/key 'owner) (pails/p control)).put((change_workbench/key 'status) (pails/t "Not built")).put((change_workbench/key 'review) (pails/t ""))
  + register
    ' Trusted namespace operation: callers own registration authority under /weft.
    \ name=iota title=str registration=change_workbench/registration state=namespace
    ^ namespace
    = home (change_workbench/registry state.self).snoc(name)
      card (shuin_workbench/named title "Build, test, review, then publish this target. Publication activates the exact tested candidate.").put((change_workbench/key 'command) (pails/t "")).put((change_workbench/key 'status) (pails/t "Not built")).put((change_workbench/key 'review) (pails/t "")).put((change_workbench/key 'active) (pails/t "0")).put((change_workbench/key 'source) (pails/p registration.units.at(0).source)).put((change_workbench/key 'tests) (pails/p registration.tests))
      sources (goo_composition/items (registration.units.map((\ unit (myth/sing ['path] (pails/p unit.source)).put(['label] (pails/t (change_workbench/record unit.source state).txt_at(system_vocabulary/lede)))))))
      card card.put((change_workbench/key 'sources) sources)
      card=myth
        | registration.units.fold card
          \ card=myth unit
          | card.put unit.source (pails/p unit.source)
      next (change_workbench/put registration.tests (shuin_workbench/named "Test cases" "Edit expectations and fixtures, then rerun the complete suite.") state)
      next (change_workbench/put registration.control card next)
    = next (change_workbench/put home (myth/sing (change_workbench/key 'registration) registration) next)
      presentation (shuin_presentation/config [[state.self 'gov 'shuin_workbench 'control]] [] [] [] "" ((registration.units.map((\ unit unit.source))).weld([(change_workbench/key 'tests) (change_workbench/key 'candidate) (change_workbench/key 'run)])))
      next (change_workbench/put registration.control (myth/sing (shuin_presentation/slot state.self) presentation) next)
      navigation registration.control.take(registration.control.len.dec)
      catalog=goo_composition/items
        | goo_composition/items (change_workbench/registrations next).map((\ [home reg] (myth/sing ['path] (pails/p reg.control)).put(['label] (pails/t (change_workbench/record reg.control next).txt_at(system_vocabulary/lede)))))
      entries (change_workbench/registrations next)
      nav_card=myth
        | entries.fold (myth/sing (change_workbench/key 'targets) catalog)
          \ card=myth [home reg]
          | card.put reg.control (pails/p reg.control)
      nav_card nav_card.put((shuin_presentation/slot state.self) (shuin_presentation/config [[state.self 'gov 'shuin_workbench 'navigation]] [] [] [] "" (entries.map((\ [home reg] reg.control)))))
      next (change_workbench/put navigation nav_card next)
    | registration.units.fold next
      \ next=namespace unit
      = current (change_workbench/record unit.source next)
      ? (current.has((shuin_presentation/slot state.self))) next
      = presentation (shuin_presentation/config [[state.self 'gov 'shuin_workbench 'source_editor]] [] [] [] "" [(change_workbench/key 'owner)])
      | change_workbench/put unit.source (myth/sing (shuin_presentation/slot state.self) presentation) next
  + case
    \ title=str args=str expected=str outcome=str time=str fixture=path view=path
    ^ myth
    | (shuin_workbench/named title "Behavioral expectations are editable. Fixed interface and result contracts are enforced separately.").put(system_vocabulary/content (pails/t args)).put((change_workbench/key 'outputs) (pails/t expected)).put((change_workbench/key 'expect) (pails/t outcome)).put((change_workbench/key 'time) (pails/t time)).put((change_workbench/key 'fixture) (pails/p fixture)).put((shuin_presentation/slot view.at(0)) (shuin_presentation/config [view] [] [] [] "" [(change_workbench/key 'fixture)]))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = home=path [state.self 'app 'workbench]
      registry=path (change_workbench/registry state.self)
      stencil_adapter=path registry.weld(['adapters 'stencil])
      view_adapter=path registry.weld(['adapters 'view])
      next (change_workbench/put stencil_adapter (myth/sing (change_workbench/key 'adapter) (change_workbench/adapter shuin_workbench/stencil_validate shuin_workbench/stencil_test shuin_workbench/namespace_activation)) state)
      next (change_workbench/put view_adapter (myth/sing (change_workbench/key 'adapter) (change_workbench/adapter shuin_workbench/view_validate shuin_workbench/view_test shuin_workbench/namespace_activation)) next)
      next (change_workbench/put home (shuin_workbench/named "Change workbench" "Choose a registered target. Edit → build → test → review → publish.") next)
      target=path home.snoc('post_message)
      source=path target.snoc('source)
      files (source_mount/snapshot [state.self 'io 'fs ($ta "shuin-chat")] state)
      matches (files.keep((\ [name bytes] (eq name "post_message.grove"))))
    ? !(matches.len) (./err (pails/t "The post_message source asset is missing."))
    = [filename bytes] matches.at(0)
      blob (str/from_atom bytes)
      code blob.slice(0 blob.len.dec)
      next (change_workbench/put source (shuin_workbench/source_record "Post message source" code target) next)
      declaration=path [state.self 'gov 'shuin_chat 'post_message]
      implementation=path [state.self 'lib 'shuin_post_message]
      policy (shuin_workbench/stencil_policy declaration [state.self 'gov 'shuin_chat 'channel] [state.self 'gov 'shuin_chat 'message] [system_vocabulary/content ['sys 'author]] ['sys 'now])
      registration (change_workbench/registration target [(change_workbench/unit source implementation "grove_role_runtime")] target.snoc('tests) [implementation declaration] stencil_adapter (myth/sing (change_workbench/key 'policy) policy) "namespace" .true [target source] [(change_workbench/export implementation.snoc('post_message) declaration)])
      next (shuin_workbench/register 'post_message "Post message" registration next)
      fixture=path target.snoc('fixture)
      parent (shuin_workbench/named "Captured channel" "An isolated channel fixture.").put([state.self 'gov 'shuin_chat 'address] (pails/p fixture))
      next (change_workbench/put fixture parent next)
      args=str "{""/sys/content"":{""type"":""text"",""value"":""Hello""},""/sys/author"":{""type"":""text"",""value"":""Tester""}}"
      unicode=str "{""/sys/content"":{""type"":""text"",""value"":""שלום\nHello 🌱""},""/sys/author"":{""type"":""text"",""value"":""テスト""}}"
      empty=str "{""/sys/content"":{""type"":""text"",""value"":""""},""/sys/author"":{""type"":""text"",""value"":""Tester""}}"
      next (change_workbench/put target.weld(['tests 'normal]) (shuin_workbench/case "Normal message" args args "accept" "1700000000" fixture [state.self 'gov 'shuin_workbench 'stencil_case_editor]) next)
      next (change_workbench/put target.weld(['tests 'unicode]) (shuin_workbench/case "Unicode and multiline" unicode unicode "accept" "1700000001" fixture [state.self 'gov 'shuin_workbench 'stencil_case_editor]) next)
      next (change_workbench/put target.weld(['tests 'missing]) (shuin_workbench/case "Missing arguments" "{}" "{}" "reject" "1700000002" fixture [state.self 'gov 'shuin_workbench 'stencil_case_editor]) next)
      next (change_workbench/put target.weld(['tests 'empty]) (shuin_workbench/case "Empty content" empty "{}" "reject" "1700000003" fixture [state.self 'gov 'shuin_workbench 'stencil_case_editor]) next)
      target=path home.snoc('reflection)
      source=path [state.self 'app 'shuin_reflection 'renderer]
      root=path [state.self 'gov 'shuin_reflection 'published]
      next (change_workbench/put source (shuin_workbench/source_record "Variant editor" (change_workbench/record source next).txt_at(system_vocabulary/content) target) next)
      policy (shuin_workbench/view_policy root.snoc('variant) root.snoc('editor) ['sys 'slot 'shuin_variant] ["first" "second" "third"])
      registration (change_workbench/registration target [(change_workbench/unit source root "grove_role_runtime")] target.snoc('tests) [root] view_adapter (myth/sing (change_workbench/key 'policy) policy) "namespace" .true [target source] [])
      next (shuin_workbench/register 'reflection "Reflection renderer" registration next)
      expected (show (json/obj [(jkv (path_show [state.self 'gov 'shuin_reflection 'selected]) (json/obj [(jkv "type" (json/str "text")) (jkv "value" (json/str "Curious"))]))]))
      next (change_workbench/put target.weld(['tests 'example]) (shuin_workbench/case "Choice buttons" "{}" expected (str/join (str/from_atom 10) ["col" "action"]) "0" [state.self 'app 'shuin_reflection 'note] [state.self 'gov 'shuin_workbench 'view_case_editor]) next)
      next (change_workbench/put [state.self 'app 'shuin_scenes 'workbench] (shuin_scenes/scene state.self "Workbench" "Edit, test and publish namespace definitions." "record" 70 home [state.self 'gov 'shuin_workbench 'navigation]) next)
    | ./ok next
