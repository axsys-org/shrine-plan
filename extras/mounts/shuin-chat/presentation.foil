- stdlib/runtime
- stdlib/runtime
- stdlib/runtime

' A record may declare its ordinary Goo presentations and an optional registered
' source owner. This is mounted application vocabulary, not a new Goo primitive.
+ shuin_presentation
  + config
    : views=row[path] follow=path member=path source_slot=path publish_key=str links=row[path]
  + slot
    \ self=iota
    ^ path
    [self 'gov 'shuin_presentation 'config]
  + registration
    \ target=path state=namespace
    ^ maybe[[path change_workbench/registration]]
    = matches ((change_workbench/registrations state).keep((\ [home reg] (reg.units.any((\ unit (equal unit.source target)))))))
    ? matches.len (./some matches.at(0)) .none
  + link
    \ target=path relation=str description=str state=namespace
    ^ json
    = card (goo_runtime/record .x target state).fall(myth/new)
      title (card.txt_at(system_vocabulary/lede))
    | json/obj [(jkv "target" (json/str (path_show target)))
        (jkv "title" (json/str (? title.len title (path_show target))))
        (jkv "relation" (json/str relation)) (jkv "description" (json/str description))]
  + slot_link
    \ slot=path target=path state=namespace
    ^ json
    = card (goo_runtime/record .x slot state).fall(myth/new)
      title (card.txt_at(system_vocabulary/lede))
    | shuin_presentation/link target (? title.len title (path_show slot)) (card.txt_at(system_vocabulary/help)) state
  + source_link
    \ target=path state=namespace
    ^ json
    = matches ((change_workbench/registrations state).keep((\ [home reg] ((pith_prefix home.snoc('previews) target) || (reg.outputs.any((\ root (pith_prefix root target))))))))
    ? !(matches.len) jnull
    = [home reg] matches.at(0)
    | json/obj [(jkv "views" (json/arr [])) (jkv "draft" jnull)
        (jkv "links" (json/arr [(shuin_presentation/link reg.units.at(0).source "Source" "Editable source owner." state) (shuin_presentation/link reg.control "Workbench" "Review, test and publish this target." state)]))]
  + describe
    \ target=path state=namespace
    ^ json
    = card (goo_runtime/record .x target state).fall(myth/new)
    ?> (./some held) card.get((shuin_presentation/slot state.self)) (shuin_presentation/source_link target state)
    ?> config=shuin_presentation/config held jnull
    = registration=maybe[[path change_workbench/registration]] (shuin_presentation/registration config.follow state)
      views=row[path]
        ?> (./some entry) registration config.views
        = [home reg] entry
        = journal (change_workbench/journal_at home state)
        = live=row[path]
            ? !(and journal.revision config.member.len) config.views
            | config.views.drop(1).cons(reg.units.at(0).root.weld(config.member))
        ? !(and (equal config.follow target) (and config.source_slot.len config.member.len)) live
        ?> (./some candidate) (change_workbench/candidate_at journal.candidate state) live
        ? !(change_workbench/sources_current candidate state) live
        ? (equal journal.published journal.candidate) live
        | live.drop(1).cons((change_workbench/preview_path home journal.candidate reg.units.at(0).root.weld(config.member)))
      draft=json
        ? !(and (equal config.follow target) config.source_slot.len) jnull
        ?> (./some entry) registration jnull
        = [home reg] entry
        = journal (change_workbench/journal_at home state)
        ?> (./some candidate) (change_workbench/candidate_at journal.candidate state) jnull
        = ready (change_workbench/sources_current candidate state)
          preview (change_workbench/preview_path home journal.candidate reg.units.at(0).root.weld(config.member))
        | json/obj [(jkv "sourceSlot" (json/str (path_show config.source_slot)))
            (jkv "publishKey" (json/str config.publish_key))
            (jkv "previewRecipe" (json/str (path_show preview)))
            (jkv "revision" (json/str (nat/show journal.sequence))) (jkv "ready" (json/str (nat/show (? ready journal.sequence 0))))
            (jkv "published" (json/str (nat/show journal.revision))) (jkv "source" (json/str card.txt_at(config.source_slot)))
            (jkv "message" (json/str card.txt_at((change_workbench/key 'status)))) (jkv "line" (json/str "0"))]
      links (config.links.keep((\ slot (maybe/is_some card.path_at(slot)))).map((\ slot (shuin_presentation/slot_link slot card.path_at(slot).fall([]) state))))
      links (? views.len links.snoc((shuin_presentation/link views.at(0) "View" "The active Goo view." state)) links)
      links=row[json]
        ?> (./some entry) registration links
        = [home reg] entry
        | links.snoc((shuin_presentation/link reg.control "Workbench" "Review and publish the tested candidate." state))
    | json/obj [(jkv "views" (json/arr (views.map((\ path (json/str (path_show path)))))))
        (jkv "draft" draft) (jkv "links" (json/arr links))]
  + response
    \ fields=row[[str str]] state=namespace
    ^ [nat str]
    ? !(and (eq fields.len 1) (gt (http_foot/field "target" fields).len 0))
      [400 "Invalid presentation request"]
    ?> (./some target) (path_parse (http_foot/field "target" fields)) [400 "Invalid presentation path"]
    | [200 (show (shuin_presentation/describe target state))]
