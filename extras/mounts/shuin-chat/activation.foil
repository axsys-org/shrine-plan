- stdlib/runtime
- shuin_navigation
- shuin_reflection
- shuin_wallet
- shuin_scenes
- shuin_talmud
- namespace_search
- shuin_agents
- shuin_workbench

+ shuin_chat_mount
  + failure
    : reason=iota
  + view_copy
    \ state=namespace
    ^ either[iota namespace]
    = entries=row[[iota str str]]
        [['composer "Message composer" "Compose a message for this channel."]
         ['native_composer "Channel composer" "The native channel composition view."]
         ['thread_composer "Thread composer" "Compose a reply to this message."]
         ['entry "Message" "The author, time and content of this message."]
         ['bounded_history "Recent messages" "A bounded list of messages in this channel."]
         ['footnote_entry "Reference note" "The title and text of this reference note."]
         ['footnote_chain "Linked notes" "Follow the chain of reference notes."]
         ['constraint_examples "Layout example" "This channel in columns and indented lines."]
         ['room "Channel room" "The channel workspace and its selected thread."]
         ['thread_room "Thread room" "The workspace for a selected message thread."]
         ['namespace_scene "Namespace" "The current folder in the namespace explorer."]
         ['namespace_record "Record" "The currently inspected namespace record."]]
    % rest=row[[iota str str]] entries state=namespace state
    ^ either[iota namespace]
    ? !(rest.len) (./ok state)
    = [name title description] rest.at(0)
      target=path [state.self 'gov 'shuin_chat name]
    ?> (./some card) (sovereign_care .x target state).fil (_ rest.drop(1) state)
    = card (? (card.has(system_vocabulary/lede)) card card.put(system_vocabulary/lede (pails/t title)))
      card (? (card.has(system_vocabulary/help)) card card.put(system_vocabulary/help (pails/t description)))
    < next (grove_install/change target (writ/make card) state)
    | _ rest.drop(1) next
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'shuin_chat]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing development template")
    ? (grove_install/instantiate source version
        [state.self 'app 'shuin_chat] state)
     > (./ok next)
      ? (shuin_navigation/install next)
       > (./ok next)
        ? (shuin_chat_mount/view_copy next)
         > (./ok next)
          < next (shuin_reflection/install next)
          < next (shuin_wallet/install next)
          < next (shuin_scenes/install next)
          < next (shuin_talmud/install next)
          < next (shuin_agents/install next)
          < next (shuin_workbench/install next)
          | namespace_search/install next
         > (./err why) (./err (shuin_chat_mount/failure why))
       > (./err why) (./err (shuin_chat_mount/failure why))
     > (./err why) (./err (shuin_chat_mount/failure why))
