- stdlib/runtime
- stdlib/runtime
- shuin_navigation
- shuin_presentation

' A deliberately small reflected editor: exact, nullary three-way sums.
' Labels and constructor identities come from type descriptors, not UI enums.
+ shuin_reflection
  + mood
    & shuin_reflection/mood/Calm shuin_reflection/mood/Curious shuin_reflection/mood/Excited
    + Calm
      :
    + Curious
      :
    + Excited
      :
  + arrangement
    & shuin_reflection/arrangement/Row shuin_reflection/arrangement/Column shuin_reflection/arrangement/Lines
    + Row
      :
    + Column
      :
    + Lines
      :
  + choice
    : declared=type shape=type value=any
  + definitions
    ' Explicit descriptor registry for the demo's declared types. A reflected
    ' sum carries exact references; each constructor supplies its own shape.
    ^ row[type]
    [(^ shuin_reflection/mood/Calm) (^ shuin_reflection/mood/Curious) (^ shuin_reflection/mood/Excited)
     (^ shuin_reflection/arrangement/Row) (^ shuin_reflection/arrangement/Column) (^ shuin_reflection/arrangement/Lines)]
  + resolve
    \ shape=type
    ^ type
    ? shape
     > (./ref identity arguments)
      = found ((shuin_reflection/definitions).keep((\ descriptor (eq (shuin_reflection/brand descriptor) identity))))
      ? found.len found.at(0) shape
    shape
  + make
    \ declared=type value=any
    ^ shuin_reflection/choice
    = shape=type
        ? declared
         > (./sum variants) (./sum (variants.map((\ shape (shuin_reflection/resolve shape)))))
        declared
    | shuin_reflection/choice declared shape value
  + variants
    \ shape=type
    ^ row[type]
    ? shape
     > (./sum variants) variants
    []
  + brand
    \ shape=type
    ^ nat
    ? shape
     > (./rec brand fields) (? fields.len 0 brand)
    0
  + valid
    \ choice=shuin_reflection/choice
    ^ bool
    = variants (shuin_reflection/variants choice.shape)
    | and (eq variants.len 3) (and (variants.all((\ shape (shuin_reflection/brand shape))))
        (variants.any((\ shape (eq (shuin_reflection/brand shape) (nominal_brand choice.value))))))
  + label
    \ choice=shuin_reflection/choice index=nat
    ^ str
    = brand (shuin_reflection/brand (shuin_reflection/variants choice.shape).at(index))
    ?> (./some definition) (brand_decode brand) "Unknown constructor"
    = [path version] definition
    | str/from_atom (iota_show path.at(path.len.dec))
  + selected
    \ choice=shuin_reflection/choice
    ^ str
    % i=nat 0
    ? (eq i 3) "Unknown constructor"
    ? (eq (shuin_reflection/brand (shuin_reflection/variants choice.shape).at(i)) (nominal_brand choice.value))
      | shuin_reflection/label choice i
    | _ i.inc
  + choose
    \ choice=shuin_reflection/choice index=nat
    ^ shuin_reflection/choice
    ? !(and (shuin_reflection/valid choice) (lt index 3)) choice
    | choice.set_value((shuin_reflection/brand (shuin_reflection/variants choice.shape).at(index)))
  + source
    \ arrangement=str
    ^ str
    = opening=str (? (eq arrangement "Column") "    col {" (? (eq arrangement "Lines") "    lines {" "    row {"))
      first=str (? (eq arrangement "Lines") "      row { group(on = item, action = /first_action) { action(item.first, key = `first`) } }" "      group(on = item, action = /first_action) { action(item.first, key = `first`) }")
      second=str (? (eq arrangement "Lines") "      row { group(on = item, action = /second_action) { action(item.second, key = `second`) } }" "      group(on = item, action = /second_action) { action(item.second, key = `second`) }")
      third=str (? (eq arrangement "Lines") "      row { group(on = item, action = /third_action) { action(item.third, key = `third`) } }" "      group(on = item, action = /third_action) { action(item.third, key = `third`) }")
    = text (str/join (str/from_atom 10)
      ["#import text=lib/grove/types/text"
       "#import content=sys/content"
       "#import choice=gov/shuin_reflection/choice" "#import choice_type=gov/shuin_reflection/choice_type"
       "#import first=gov/shuin_reflection/first" "#import second=gov/shuin_reflection/second"
       "#import third=gov/shuin_reflection/third" "#import selected=gov/shuin_reflection/selected"
       "#import first_action=gov/shuin_reflection/choose_first"
       "#import second_action=gov/shuin_reflection/choose_second"
       "#import third_action=gov/shuin_reflection/choose_third"
       "#import lede=sys/lede" ""
       "editor =" "  @role" "  #meta ;" "    `/sys/lede`: (pails/t `Variant editor`)" "  lede: text" "  content: text" "  choice: choice_type"
       "  first: text" "  second: text" "  third: text" "  selected: text" ""
       "variant =" "  @view" "  #meta ;" "    `/sys/lede`: (pails/t `Reflected variant`)" "  #on ; ;/editor" "  #for ; /sys/slot/shuin_variant"
       "  item => col {" "    show(item.selected, '/sys/slot/label)"
       opening first second third "    }" "  }" ""
       "`/` =" "  @tree" "  lede: `Reflected variant renderer`" ""])
    | str/join (str/from_atom 34) (str/split_byte 96 text)
  + home
    \ self=iota
    ^ path
    [self 'app 'shuin_reflection]
  + schema
    \ self=iota
    ^ path
    [self 'gov 'shuin_reflection]
  + record
    \ title=str content=str choice=shuin_reflection/choice self=iota
    ^ myth
    = schema (shuin_reflection/schema self)
    | (myth/sing system_vocabulary/lede (pails/t title)).put(system_vocabulary/content (pails/t content)).put(schema.snoc('choice) choice).put(schema.snoc('first) (pails/t (shuin_reflection/label choice 0))).put(schema.snoc('second) (pails/t (shuin_reflection/label choice 1))).put(schema.snoc('third) (pails/t (shuin_reflection/label choice 2))).put(schema.snoc('selected) (pails/t (shuin_reflection/selected choice)))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = home (shuin_reflection/home state.self) schema (shuin_reflection/schema state.self)
      mood_choice (shuin_reflection/make (^ shuin_reflection/mood) (shuin_reflection/mood/Curious))
      arrangement_choice (shuin_reflection/make (^ shuin_reflection/arrangement) (shuin_reflection/arrangement/Row))
      note (shuin_reflection/record "Note" "Keep an unfinished sentence here while you rebuild its editor." mood_choice state.self)
      note note.put((shuin_presentation/slot state.self) (shuin_presentation/config [schema.snoc('variant) schema.snoc('note_controls)] home.snoc('renderer) ['variant] [] "" [schema.snoc('renderer) schema.snoc('type_definition)]))
      note note.put(schema.snoc('renderer) (pails/p home.snoc('renderer))).put(schema.snoc('type_definition) (pails/p home.weld(['types 'mood])))
      code (shuin_reflection/source "Row")
      renderer (shuin_reflection/record "Variant editor" code arrangement_choice state.self)
      renderer renderer.put((shuin_presentation/slot state.self) (shuin_presentation/config [schema.snoc('variant) [state.self 'gov 'shuin_workbench 'source_editor]] home.snoc('renderer) ['variant] system_vocabulary/content "publish" [schema.snoc('example) schema.snoc('type_definition)]))
      renderer renderer.put(schema.snoc('example) (pails/p home.snoc('note))).put(schema.snoc('type_definition) (pails/p home.weld(['types 'arrangement])))
      root (myth/sing system_vocabulary/lede (pails/t "Examples")).put(system_vocabulary/help (pails/t "Records, their types, and the views used to edit them."))
    ? !(and (shuin_reflection/valid mood_choice) (shuin_reflection/valid arrangement_choice))
      | ./err (pails/t (str/cat_all ["Unresolved reflection descriptors: " (str/from_atom (tyshow/pretty arrangement_choice.shape))]))
    ?> (./ok next) (grove_install/change home (writ/make root) state) (./err (pails/t "Reflection root installation failed"))
    ?> (./ok next) (grove_install/change home.snoc('note) (writ/make note) next) (./err (pails/t "Reflection note installation failed"))
    ?> (./ok next) (grove_install/change home.snoc('renderer) (writ/make renderer) next) (./err (pails/t "Reflection renderer installation failed"))
    ?> (./ok next) (grove_install/change home.snoc('types) (writ/make (myth/sing system_vocabulary/lede (pails/t "Types"))) next) (./err (pails/t "Type folder installation failed"))
    ?> (./ok next) (grove_install/change home.weld(['types 'mood]) (writ/make (myth/sing system_vocabulary/lede (pails/t "Mood")).put(system_vocabulary/mold (pails/ty mood_choice.shape))) next) (./err (pails/t "Mood descriptor installation failed"))
    ?> (./ok next) (grove_install/change home.weld(['types 'arrangement]) (writ/make (myth/sing system_vocabulary/lede (pails/t "Arrangement")).put(system_vocabulary/mold (pails/ty arrangement_choice.shape))) next) (./err (pails/t "Arrangement descriptor installation failed"))
    ?> (./ok next) (grove_install/change (shuin_presentation/slot state.self) (writ/make (myth/sing system_vocabulary/lede (pails/t "Presentation")).put(system_vocabulary/help (pails/t "The ordinary Goo views and source owner declared by this record."))) next) (./err (pails/t "Presentation slot installation failed"))
    | ./ok next
