- stdlib/runtime

' Scenes are ordinary namespace records. The shell only knows host capabilities.
+ shuin_scenes
  + home
    \ self=iota
    ^ path
    [self 'app 'shuin_scenes]
  + schema
    \ self=iota
    ^ path
    [self 'gov 'shuin_scenes]
  + named
    \ title=str description=str
    ^ myth
    | (myth/sing system_vocabulary/lede (pails/t title)).put(system_vocabulary/help (pails/t description))
  + scene
    \ self=iota title=str description=str host=str order=nat target=path view=path
    ^ myth
    = schema (shuin_scenes/schema self)
    | (shuin_scenes/named title description).put(schema.snoc('host) (pails/t host)).put(schema.snoc('order) (pails/n order)).put(schema.snoc('target) (pails/p target)).put(schema.snoc('view) (pails/p view))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = self state.self home (shuin_scenes/home self) schema (shuin_scenes/schema self)
      registry (shuin_scenes/named "Scenes" "Each child defines a scene. Titles, order, hosts and view bindings are read by the native shell.").put(schema.snoc('default) (pails/p home.snoc('chat))).put(schema.snoc('follow) (pails/p home.snoc('namespace)))
      entries=row[[path myth]]
        [[home registry]
         [home.snoc('chat) (shuin_scenes/scene self "Chat" "Channels, threads and retained message drafts." "workspace" 10 [] [])]
         [home.snoc('namespace) (shuin_scenes/scene self "Explorer" "Explore records, slots, views and actions." "explorer" 20 [] [])]
         [home.snoc('wallet) (shuin_scenes/scene self "Wallet" "Local development accounts, test ETH and transfers." "record" 30 [self 'app 'shuin_wallet] [self 'gov 'shuin_wallet 'wallet])]
         [home.snoc('agents) (shuin_scenes/scene self "Agents" "" "record" 50 home.snoc('agents) schema.snoc('empty))]
         [home.snoc('spreadsheets) (shuin_scenes/scene self "Spreadsheets" "" "record" 60 home.snoc('spreadsheets) schema.snoc('empty))]]
    % rest=row[[path myth]] entries state=namespace state
    ^ either[pail namespace]
    ? !(rest.len) (./ok state)
    = [target card] rest.at(0)
    ?> (./ok next) (grove_install/change target (writ/make card) state) (./err (pails/t "Scene installation failed"))
    | _ rest.drop(1) next
  + project
    \ state=namespace
    ^ either[str json]
    = home (shuin_scenes/home state.self) schema (shuin_scenes/schema state.self)
    ?> (./some registry) (sovereign_care_value .x home state).fil (./err "Scene registry is unavailable.")
    ?> (./some initial) registry.path_at(schema.snoc('default)) (./err "Default scene is missing.")
    ?> (./some follow) registry.path_at(schema.snoc('follow)) (./err "Scene link destination is missing.")
    = children (sovereign_care_value .y home state).kid_tap
    ? (gt children.len 64) (./err "Scene registry exceeds 64 entries.")
    % rest=row[bee/kv[axal[myth]]] children out=row[json] []
    ^ either[str json]
    ? !(rest.len) (./ok (json/obj [(jkv "version" (json/num .false 1)) (jkv "root" (json/str (path_show home))) (jkv "default" (json/str (path_show initial))) (jkv "follow" (json/str (path_show follow))) (jkv "scenes" (json/arr out))]))
    = [key node] rest.at(0)
    ?> (./some card) node.fil (_ rest.drop(1) out)
    = path home.snoc(key)
      host (card.txt_at(schema.snoc('host)))
      title (card.txt_at(system_vocabulary/lede))
    ?> (./some held) card.get(schema.snoc('order)) (./err "Scene order is missing.")
    ?> order=pails/n held (./err "Scene order must be a natural number.")
    ?> (./some target) card.path_at(schema.snoc('target)) (./err "Scene target is missing.")
    ?> (./some view) card.path_at(schema.snoc('view)) (./err "Scene view is missing.")
    = entry (json/obj [(jkv "path" (json/str (path_show path))) (jkv "title" (json/str (? title.len title (path_show path)))) (jkv "description" (json/str (card.txt_at(system_vocabulary/help)))) (jkv "host" (json/str host)) (jkv "order" (json/str (nat/show order.n))) (jkv "target" (json/str (path_show target))) (jkv "view" (json/str (path_show view)))])
    | _ rest.drop(1) out.snoc(entry)
  + response
    \ state=namespace
    ^ [nat str]
    ? (shuin_scenes/project state)
     > (./ok value) [200 (show value)]
     > (./err why) [409 (show (json/obj [(jkv "error" (json/str why))]))]
