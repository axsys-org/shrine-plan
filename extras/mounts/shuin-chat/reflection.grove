#import text=lib/grove/types/text
#import lede=sys/lede
#import content=sys/content

renderer =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Renderer source")
    "/sys/help": (pails/t "The record containing the editable source for the choice buttons. Publish changes there to update their appearance.")

example =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Example")
    "/sys/help": (pails/t "A record using this renderer. Open it to see the published view in use.")

type_definition =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Choice type")
    "/sys/help": (pails/t "The type definition that supplies this record's available choices.")

choice_type =
  #meta ;
    "/sys/lede": (pails/t "Reflected choice")
  @type
  ! foil
  shuin_reflection/choice
  + read
    \ value=pail
    ^ maybe[choice_type]
    ?> held=shuin_reflection/choice value .none
    ? !(shuin_reflection/valid held) .none
    | ./some held
  + write
    \ value=choice_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ shuin_reflection/choice)

choice =
  #meta ;
    "/sys/lede": (pails/t "Choice")
  @slot

first =
  #meta ;
    "/sys/lede": (pails/t "First constructor")
  @slot

second =
  #meta ;
    "/sys/lede": (pails/t "Second constructor")
  @slot

third =
  #meta ;
    "/sys/lede": (pails/t "Third constructor")
  @slot

selected =
  #meta ;
    "/sys/lede": (pails/t "Selected constructor")
  @slot

editor =
  #meta ;
    "/sys/lede": (pails/t "Variant editor")
  @role
  lede: text
  content: text
  %/choice: %/choice_type
  %/first: text
  %/second: text
  %/third: text
  %/selected: text

choose_first =
  #meta ;
    "/sys/lede": (pails/t "Choose first constructor")
  @action
  #on ; %/editor
  ! foil
  \ item=%/editor
  ^ %/editor
  = choice (shuin_reflection/choose item.choice 0)
    source (? (equal choice.declared (^ shuin_reflection/arrangement)) (shuin_reflection/source (shuin_reflection/selected choice)) item.content)
  | item.set_choice(choice).set_selected((shuin_reflection/selected choice)).set_content(source)

choose_second =
  #meta ;
    "/sys/lede": (pails/t "Choose second constructor")
  @action
  #on ; %/editor
  ! foil
  \ item=%/editor
  ^ %/editor
  = choice (shuin_reflection/choose item.choice 1)
    source (? (equal choice.declared (^ shuin_reflection/arrangement)) (shuin_reflection/source (shuin_reflection/selected choice)) item.content)
  | item.set_choice(choice).set_selected((shuin_reflection/selected choice)).set_content(source)

choose_third =
  #meta ;
    "/sys/lede": (pails/t "Choose third constructor")
  @action
  #on ; %/editor
  ! foil
  \ item=%/editor
  ^ %/editor
  = choice (shuin_reflection/choose item.choice 2)
    source (? (equal choice.declared (^ shuin_reflection/arrangement)) (shuin_reflection/source (shuin_reflection/selected choice)) item.content)
  | item.set_choice(choice).set_selected((shuin_reflection/selected choice)).set_content(source)

save =
  #meta ;
    "/sys/lede": (pails/t "Save note")
  @action
  #on ; %/editor
  content: text
  ! foil
  \ content=text item=%/editor
  ^ %/editor
  | item.set_content(content)

variant =
  #meta ;
    "/sys/lede": (pails/t "Reflected variant")
  @view
  #on ; %/editor
  #for ; /sys/slot/shuin_variant
  item => col {
    show(item.selected, '/sys/slot/label)
    row {
      group(on = item, action = %/choose_first) { action(item.first, key = "first") }
      group(on = item, action = %/choose_second) { action(item.second, key = "second") }
      group(on = item, action = %/choose_third) { action(item.third, key = "third") }
    }
  }

note_controls =
  #meta ;
    "/sys/lede": (pails/t "Note editor")
  @view
  #on ; %/editor
  #for ; /sys/slot/shuin_note_controls
  item => group(on = item, action = %/save, myth = { '/sys/content = .input(item.content) }) {
    input('/sys/content, kind = .text, label = "Note draft", multiline = 1, key = "content")
    action("Save note", key = "save")
  }
