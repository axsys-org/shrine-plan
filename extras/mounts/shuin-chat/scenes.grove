#import text=lib/grove/types/text

host =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Scene host")
    "/sys/help": (pails/t "Native host capability: record, workspace, explorer or commentary.")

order =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Tab order")
    "/sys/help": (pails/t "Scenes appear in ascending order, then by their namespace path.")

target =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Scene record")
    "/sys/help": (pails/t "The namespace record displayed by a record or commentary host.")

view =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Scene view")
    "/sys/help": (pails/t "The published Goo view used by a record or commentary host.")

default =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Default scene")
    "/sys/help": (pails/t "The scene opened when no initial scene is requested.")

follow =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Link destination")
    "/sys/help": (pails/t "The explorer scene that receives namespace record links.")

scene_record =
  @role
  %/host: text

empty =
  @view
  #meta ;
    "/sys/lede": (pails/t "Empty scene")
    "/sys/help": (pails/t "A blank surface for a scene awaiting content.")
  #on ; %/scene_record
  #for ; /sys/slot/body
  scene => col {}
