#import context_menu=sys/slot/context_menu
#import path_type=lib/grove/types/path
#import lede=sys/lede
#import text=lib/grove/types/text

library =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Reading library")
    "/sys/help": (pails/t "Pages, commentary layers and the collection of anchored glosses.")

page =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Page")
    "/sys/help": (pails/t "Ordered source passages and edition reference.")

passage =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Bilingual passage")
    "/sys/help": (pails/t "Primary and secondary text, with its source reference.")

gloss =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Anchored gloss")
    "/sys/help": (pails/t "A comment on an exact, versioned range of source text.")

reading =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Reading context")
    "/sys/help": (pails/t "The accepted page, text range, gloss and layer visibility for one reader.")

receipt =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Accepted intent")
    "/sys/help": (pails/t "The exact request body accepted once, retained for safe retry.")

library_type =
  @type
  ! foil
  shuin_commentary/library
  + read
    \ value=pail
    ^ maybe[library_type]
    ?> held=shuin_commentary/library value .none
    | ./some held
  + write
    \ value=library_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ shuin_commentary/library)

library_role =
  @role
  lede: text
  %/library: %/library_type

draft =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Your gloss")

reader =
  @pane
  #meta ;
    "/sys/lede": (pails/t "Commenting reader")
    "/sys/help": (pails/t "A central bilingual text with anchored glosses in two margins. Selection, layers and comments belong to the namespace.")
  #on ; %/library_role
  #for ; /sys/slot/commentary
  book => commentary(book.address) {
    columns(tracks=[170 fr(1)]) {
      row {
        col {
          reading_value("title", role="heading")
          text("Pages", role="label")
          reading_index("pages")
          text("Layers", role="label")
          reading_index("layers")
          text("Passages", role="label")
          reading_index("passages")
        }
        col {
          reading_value("pageTitle", role="title")
          reading_value("description", role="caption")
          anchored_columns(tracks=[fr(1) fr(2) fr(1)]) {
            reading_stream("glosses", side="left", label="Glosses") {
              reading_value("title", role="caption")
              reading_value("primary", role="gloss_primary", max=180)
              reading_value("secondary", role="gloss_secondary", max=220)
            }
            reading_stream("passages", label="Text") {
              reading_value("title", role="caption")
              reading_value("primary", role="reading_primary")
              reading_value("secondary", role="reading_secondary")
            }
            reading_stream("glosses", side="right", label="Glosses") {
              reading_value("title", role="caption")
              reading_value("primary", role="gloss_primary", max=180)
              reading_value("secondary", role="gloss_secondary", max=220)
            }
          }
          text("Highlight text, then right-click for gematria or a gloss. Right-click a gloss to reply.", role="caption")
          reading_value("status", role="caption")
          reading_when("unresolved") {
            operation("retry", operation="retry", label="Retry original request")
          }
        }
      }
    }
  }

menu_machine =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Reading menu state")

menu_title =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Menu heading")

menu_quote =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Quoted source")

gematria =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Gematria")

margin =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Gloss margin")

menu_type =
  @type
  ! foil
  shuin_commentary/menu
  + read
    \ value=pail
    ^ maybe[menu_type]
    ?> held=shuin_commentary/menu value .none
    | ./some held
  + write
    \ value=menu_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ shuin_commentary/menu)

menu_role =
  @role
  context_menu: path_type
  %/menu_machine: %/menu_type
  %/menu_title: text
  %/menu_quote: text
  %/gematria: text
  %/draft: text
  %/margin: text

begin_add =
  @action
  #on ; %/menu_role
  ! foil
  \ item=%/menu_role
  ^ %/menu_role
  = menu item.menu_machine.set_phase("compose").set_mode("add")
  | item.set_menu_machine(menu).set_menu_title("Add gloss").set_context_menu((shuin_commentary/menu_view menu "gloss_form"))

begin_reply =
  @action
  #on ; %/menu_role
  ! foil
  \ item=%/menu_role
  ^ %/menu_role
  = menu item.menu_machine.set_phase("compose").set_mode("reply")
  | item.set_menu_machine(menu).set_menu_title("Reply to gloss").set_context_menu((shuin_commentary/menu_view menu "gloss_form"))

save_left =
  @action
  #on ; %/menu_role
  %/draft: text
  ! foil
  \ draft=text item=%/menu_role
  ^ %/menu_role
  | item.set_draft(draft).set_margin("left").set_menu_machine(item.menu_machine.set_phase("save"))

save_right =
  @action
  #on ; %/menu_role
  %/draft: text
  ! foil
  \ draft=text item=%/menu_role
  ^ %/menu_role
  | item.set_draft(draft).set_margin("right").set_menu_machine(item.menu_machine.set_phase("save"))

cancel_menu =
  @action
  #on ; %/menu_role
  %/draft: text
  ! foil
  \ draft=text item=%/menu_role
  ^ %/menu_role
  | item.set_draft(draft).set_margin("left").set_menu_machine(item.menu_machine.set_phase("cancel"))

range_menu =
  @view
  #on ; %/menu_role
  #for ; /sys/slot/context_menu
  item => col {
    text(item.menu_title, role = "heading")
    text(item.menu_quote, role = "quote")
    text(item.gematria, role = "caption")
    group(on = item, action = %/begin_add) { action("Add gloss…", key = "add", significance = "quiet") }
  }

gloss_menu =
  @view
  #on ; %/menu_role
  #for ; /sys/slot/context_menu
  item => col {
    text(item.menu_title, role = "heading")
    text(item.menu_quote, role = "quote")
    text(item.gematria, role = "caption")
    group(on = item, action = %/begin_add) { action("Add gloss…", key = "add", significance = "quiet") }
    group(on = item, action = %/begin_reply) { action("Reply to gloss…", key = "reply", significance = "quiet") }
  }

gloss_form =
  @view
  #on ; %/menu_role
  #for ; /sys/slot/context_menu
  item => group(on = item, myth = { %/draft = .input(item.draft) }) {
    col {
      text(item.menu_title, role = "heading")
      text(item.menu_quote, role = "quote")
      text(item.gematria, role = "caption")
      input(%/draft, kind = .text, label = "Your gloss", multiline = 1, key = "draft")
      row {
        group(action = %/save_left) { action("Save left", key = "left") }
        group(action = %/save_right) { action("Save right", key = "right") }
      }
      group(action = %/cancel_menu) { action("Cancel", key = "cancel", significance = "quiet") }
    }
  }

menu_done =
  @view
  #on ; %/menu_role
  #for ; /sys/slot/context_menu
  item => text("Closed", role = "caption")
