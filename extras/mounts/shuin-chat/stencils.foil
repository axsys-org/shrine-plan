- shuin_actions
- namespace_text

' Generic creation admission. Callers must authorize the returned destination
' before committing it. No handler receives namespace mutation capabilities.
+ shuin_stencils
  + compatible
    \ declaration=myth current=myth state=namespace
    ^ maybe[[grove_stencil_schema lash]]
    < held declaration.get(system_vocabulary/grove/stencil)
    ?> schema=grove_stencil_schema held .none
    < held declaration.get(system_vocabulary/grove/stencil_handler)
    ?> handler=grove_stencil_handler held .none
    < role (goo_runtime/record .x schema.receiver state)
    < held role.get(system_vocabulary/grove/role_contract)
    ?> parent=lash held .none
    ? (maybe/is_some (fit_check current.put(system_vocabulary/lash parent))) .none
    < role (goo_runtime/record .x schema.result state)
    < held role.get(system_vocabulary/grove/role_contract)
    ?> result=lash held .none
    | ./some [schema result]
  + list
    \ target=path after=str epoch=str state=namespace
    ^ either[str json]
    ?> (./some current) (goo_runtime/record .x target state) (./err "Stencil discovery requires a live parent record.")
    = revision (nat/show state.local.rec.len)
    ? (and epoch.len !(eq epoch revision)) (./err "Stencil listing changed; discover again.")
    ?> (./some offset) (nat/parse (? after.len after "0")) (./err "Invalid stencil cursor.")
    ? (and offset !(epoch.len)) (./err "Stencil continuation requires its epoch.")
    = root=path [state.self 'gov]
      matches ((sovereign_care .z root state).tap.keep((\ [path card] (maybe/is_some (shuin_stencils/compatible card current state)))))
      remaining matches.drop(offset)
      page remaining.take((? (gt remaining.len 24) 24 remaining.len))
      entries
        | page.map
        \ [relative card]
        = path root.weld(relative)
          [schema contract] (shuin_stencils/compatible card current state).fall([(grove_stencil_schema [] [] (grove_role_schema [] [])) lash/new])
          title (json/str card.txt_at(system_vocabulary/lede))
          description (json/str card.txt_at(system_vocabulary/help))
          arguments
            | schema.arguments.fields.map
            \ field
            | json/obj [(jkv "slot" (json/str (path_show field.slot))) (jkv "name" (json/str field.name)) (jkv "optional" (json/boo field.optional))]
        | json/obj [(jkv "path" (json/str (path_show path))) (jkv "title" title) (jkv "description" description)
            (jkv "publication" (json/str (nat/show (state.case(.x path)).fall(0))))
            (jkv "roleVersion" (json/str (nat/show (state.case(.x schema.receiver)).fall(0))))
            (jkv "resultRoleVersion" (json/str (nat/show (state.case(.x schema.result)).fall(0))))
            (jkv "resultRole" (json/str (path_show schema.result)))
            (jkv "arguments" (json/arr arguments))]
    | ./ok (json/obj [(jkv "version" (json/num .false 1)) (jkv "target" (json/str (path_show target)))
        (jkv "recordVersion" (json/str (nat/show (state.case(.x target)).fall(0))))
        (jkv "epoch" (json/str revision)) (jkv "stencils" (json/arr entries))
        (jkv "next" (? (gt matches.len (add offset page.len)) (json/str (nat/show (add offset page.len))) jnull))])
  + arguments
    \ schema=grove_role_schema source=json
    ^ either[str myth]
    ?> (./obj fields) source (./err "Arguments must be a JSON object.")
    % rest=row[jkv] fields out=myth myth/new
    ^ either[str myth]
    ? !(rest.len)
      ? !(schema.fields.all((\ field (field.optional || out.has(field.slot))))) (./err "Missing required stencil argument.")
      | ./ok out
    = field rest.at(0)
    ?> (./some slot) (path_parse field.k) (./err "Invalid argument slot.")
    ? !(schema.fields.any((\ field (equal field.slot slot)))) (./err "Undeclared stencil argument.")
    ? (out.has(slot)) (./err "Duplicate stencil argument.")
    < value (namespace_text/data (goo_runtime/json_text (goo_runtime/json_field "type" field.v)) (goo_runtime/json_field "value" field.v))
    | _ rest.drop(1) out.put(slot value)
  + fresh
    \ parent=path state=namespace
    ^ path
    % number=nat state.local.rec.len
    ^ path
    = target parent.snoc(($ts (str/to_atom (str/cat_all ["entry_" (nat/show number)]))))
    ? (sovereign_peek target state).wyt (_ number.inc)
    target
  + prepare
    \ now=nat target=path args=json state=namespace
    ^ either[str [path myth]]
    = get (\ key=str (goo_runtime/json_text (goo_runtime/json_field key args)))
    ? !(now) (./err "Stencil creation requires a trusted timestamp.")
    ?> (./some current) (goo_runtime/record .x target state) (./err "Stencil parent no longer exists.")
    ?> (./some path) (path_parse (get "stencil")) (./err "Invalid stencil path.")
    ? !(pith_prefix [state.self 'gov] path) (./err "Stencil must be a published Grove declaration.")
    ?> (./some declaration) (goo_runtime/record .x path state) (./err "Stencil no longer exists.")
    ?> (./some matched) (shuin_stencils/compatible declaration current state) (./err "Stencil does not match this parent or result role.")
    = [schema contract] matched
    ? !(and (eq (get "recordVersion") (nat/show (state.case(.x target)).fall(0)))
        (and (eq (get "publication") (nat/show (state.case(.x path)).fall(0)))
          (and (eq (get "roleVersion") (nat/show (state.case(.x schema.receiver)).fall(0)))
            (eq (get "resultRoleVersion") (nat/show (state.case(.x schema.result)).fall(0))))))
      | ./err "Stencil, parent or roles changed; discover stencils again."
    < arguments (shuin_stencils/arguments schema.arguments (goo_runtime/json_field "arguments" args))
    ?> (./some held) declaration.get(system_vocabulary/grove/stencil_handler) (./err "Stencil handler missing.")
    ?> handler=grove_stencil_handler held (./err "Invalid stencil handler.")
    = invoke handler.apply
    ?> (./ok accepted) (Try (invoke now arguments) current) (./err "Stencil failed; nothing was created.")
    ?> (./some created) accepted (./err "Stencil rejected its arguments or parent.")
    = created created.put(system_vocabulary/lash contract)
    ? (maybe/is_some (fit_check created)) (./err "Stencil result violates its result role.")
    | ./ok [(shuin_stencils/fresh target state) created]
