#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import lede=sys/lede
#import help=sys/help
#import content=sys/content
#import command=sys/workbench/command
#import owner=sys/workbench/owner
#import status=sys/workbench/status
#import review=sys/workbench/review
#import active=sys/workbench/active
#import source=sys/workbench/source
#import sources=sys/workbench/sources
#import tests=sys/workbench/tests
#import expect=sys/workbench/expect
#import outputs=sys/workbench/outputs
#import time=sys/workbench/time
#import fixture=sys/workbench/fixture
#import targets=sys/workbench/targets

catalog_type =
  @type
  ! foil
  goo_composition/items
  + read
    \ value=pail
    ^ maybe[catalog_type]
    ?> held=goo_composition/items value .none
    | ./some held
  + write
    \ value=catalog_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo_composition/items)

source_role =
  @role
  lede: text
  content: text
  command: text
  owner: path_type
  status: text
  review: text

control_role =
  @role
  lede: text
  help: text
  command: text
  status: text
  review: text
  active: text
  source: path_type
  sources: %/catalog_type
  tests: path_type

case_role =
  @role
  lede: text
  content: text
  expect: text
  outputs: text
  time: text
  fixture: path_type

build =
  @action
  #on ; %/source_role
  content: text
  ! foil
  \ content=str item=%/source_role
  ^ %/source_role
  | item.set_content(content).set_command("build")

run_tests =
  @action
  #on ; %/source_role
  content: text
  ! foil
  \ content=str item=%/source_role
  ^ %/source_role
  | item.set_content(content).set_command("test")

build_control =
  @action
  #on ; %/control_role
  ! foil
  \ item=%/control_role
  ^ %/control_role
  | item.set_command("build")

test_control =
  @action
  #on ; %/control_role
  ! foil
  \ item=%/control_role
  ^ %/control_role
  | item.set_command("test")

publish =
  @action
  #on ; %/control_role
  ! foil
  \ item=%/control_role
  ^ %/control_role
  | item.set_command("publish")

save_case =
  @action
  #on ; %/case_role
  content: text
  expect: text
  outputs: text
  time: text
  ! foil
  \ content=str expect=str outputs=str time=str item=%/case_role
  ^ %/case_role
  | item.set_content(content).set_expect(expect).set_outputs(outputs).set_time(time)

source_editor =
  @view
  #meta ;
    "/sys/lede": (pails/t "Source workbench")
  #on ; %/source_role
  #for ; /sys/slot/workbench_source
  item => col {
    show(item.lede, '/sys/slot/title)
    show(item.status, '/sys/slot/summary)
    group(on = item, myth = { '/sys/content = .input(item.content) }) {
      input('/sys/content, kind = .text, multiline = 1, label = "Grove source", key = "content")
      row {
        group(action = %/build) { action("Build", key = "build") }
        group(action = %/run_tests) { action("Run tests", key = "test") }
      }
    }
    text("Follow the workbench link to review test results and publish.")
  }

control =
  @view
  #meta ;
    "/sys/lede": (pails/t "Change workbench")
  #on ; %/control_role
  #for ; /sys/slot/workbench
  item => col {
    show(item.lede, '/sys/slot/title)
    show(item.help, '/sys/slot/caption)
    text("Source units")
    group(each = item.sources, as = "source") {
      text(source.label)
    }
    text("Test cases")
    show(item.status, '/sys/slot/summary)
    row {
      group(on = item, action = %/build_control) { action("Build", key = "build") }
      group(on = item, action = %/test_control) { action("Run tests", key = "test") }
    }
    text("Review candidate", role = .heading)
    show(item.review, '/sys/slot/content)
    text("Active version")
    show(item.active, '/sys/slot/label)
    group(on = item, action = %/publish) { action("Publish reviewed candidate", key = "publish") }
  }

stencil_case_editor =
  @view
  #meta ;
    "/sys/lede": (pails/t "Behavioral test")
  #on ; %/case_role
  #for ; /sys/slot/workbench_case
  item => col {
    show(item.lede, '/sys/slot/title)
    group(on = item, action = %/save_case, myth = { '/sys/content = .input(item.content), '/sys/workbench/expect = .input(item.expect), '/sys/workbench/outputs = .input(item.outputs), '/sys/workbench/time = .input(item.time) }) {
      input('/sys/content, kind = .text, multiline = 1, label = "Typed arguments (JSON)", key = "arguments")
      input('/sys/workbench/expect, kind = .text, multiline = 1, label = "Expected outcome: accept or reject", key = "expect")
      input('/sys/workbench/outputs, kind = .text, multiline = 1, label = "Expected typed slots (JSON)", key = "outputs")
      input('/sys/workbench/time, kind = .text, label = "Deterministic time", key = "time")
      action("Save test case", key = "save")
    }
  }

navigation_role =
  @role
  lede: text
  help: text
  targets: %/catalog_type

navigation =
  @view
  #meta ;
    "/sys/lede": (pails/t "Registered targets")
  #on ; %/navigation_role
  #for ; /sys/slot/body
  item => col {
    show(item.lede, '/sys/slot/title)
    show(item.help, '/sys/slot/caption)
    group(each = item.targets, as = "target") {
      text(target.label, role = .heading)
    }
  }

view_case_editor =
  @view
  #meta ;
    "/sys/lede": (pails/t "Goo semantic test")
  #on ; %/case_role
  #for ; /sys/slot/workbench_case
  item => col {
    show(item.lede, '/sys/slot/title)
    group(on = item, action = %/save_case, myth = { '/sys/content = item.content, '/sys/workbench/time = item.time, '/sys/workbench/expect = .input(item.expect), '/sys/workbench/outputs = .input(item.outputs) }) {
      input('/sys/workbench/expect, kind = .text, multiline = 1, label = "Required lowered constructors (one per line)", key = "expect")
      input('/sys/workbench/outputs, kind = .text, multiline = 1, label = "Expected displayed text slots (typed JSON)", key = "outputs")
      action("Save test case", key = "save")
    }
  }
