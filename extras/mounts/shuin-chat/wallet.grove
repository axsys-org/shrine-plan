#import text=lib/grove/types/text
#import lede=sys/lede

machine =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Wallet state")

status =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Network status")

overview =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Development accounts")

review =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Transfer review")

history =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Recent transfers")

sender =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Sender address")

recipient =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Recipient address")

amount =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Amount in ETH")

address =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Ethereum address")

balance =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Balance in wei")

transaction =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Transaction")

accounts_link =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Accounts")

transfers_link =
  @slot
  #meta ;
    "/sys/lede": (pails/t "Transfers")

machine_type =
  #meta ;
    "/sys/lede": (pails/t "Wallet machine")
  @type
  ! foil
  shuin_wallet/machine
  + read
    \ value=pail
    ^ maybe[machine_type]
    ?> held=shuin_wallet/machine value .none
    | ./some held
  + write
    \ value=machine_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ shuin_wallet/machine)

wallet_role =
  #meta ;
    "/sys/lede": (pails/t "Local Ethereum wallet")
  @role
  lede: text
  %/machine: %/machine_type
  %/status: text
  %/overview: text
  %/review: text
  %/history: text
  %/sender: text
  %/recipient: text
  %/amount: text

refresh =
  #meta ;
    "/sys/lede": (pails/t "Refresh balances and receipts")
  @action
  #on ; %/wallet_role
  %/sender: text
  %/recipient: text
  %/amount: text
  ! foil
  \ sender=text recipient=text amount=text item=%/wallet_role
  ^ %/wallet_role
  = state (shuin_wallet/queue "refresh" item.machine)
  | item.set_machine(state).set_status((shuin_wallet/status state)).set_review((shuin_wallet/review state)).set_sender(sender).set_recipient(recipient).set_amount(amount)

prepare =
  #meta ;
    "/sys/lede": (pails/t "Review transfer")
  @action
  #on ; %/wallet_role
  %/sender: text
  %/recipient: text
  %/amount: text
  ! foil
  \ sender=text recipient=text amount=text item=%/wallet_role
  ^ %/wallet_role
  = state (shuin_wallet/queue "prepare" item.machine)
  | item.set_machine(state).set_status((shuin_wallet/status state)).set_review((shuin_wallet/review state)).set_sender(sender).set_recipient(recipient).set_amount(amount)

send =
  #meta ;
    "/sys/lede": (pails/t "Send test ETH")
  @action
  #on ; %/wallet_role
  %/sender: text
  %/recipient: text
  %/amount: text
  ! foil
  \ sender=text recipient=text amount=text item=%/wallet_role
  ^ %/wallet_role
  = state (shuin_wallet/queue "send" item.machine)
    tx state.transfers.at(0)
    effective_sender (? sender.len sender state.accounts.at(0).address)
  ; (shuin_wallet/require (and (eq effective_sender tx.sender) (and (eq recipient tx.recipient) (eq (shuin_wallet/wei amount) tx.value))) "The form changed after review. Review the updated transfer before sending.")
  | item.set_machine(state).set_status((shuin_wallet/status state)).set_review((shuin_wallet/review state)).set_sender(sender).set_recipient(recipient).set_amount(amount)

cancel =
  #meta ;
    "/sys/lede": (pails/t "Cancel review")
  @action
  #on ; %/wallet_role
  %/sender: text
  %/recipient: text
  %/amount: text
  ! foil
  \ sender=text recipient=text amount=text item=%/wallet_role
  ^ %/wallet_role
  = state (shuin_wallet/queue "cancel" item.machine)
  | item.set_machine(state).set_status((shuin_wallet/status state)).set_review((shuin_wallet/review state)).set_sender(sender).set_recipient(recipient).set_amount(amount)

wallet =
  #meta ;
    "/sys/lede": (pails/t "Ethereum wallet")
    "/sys/help": (pails/t "Local Anvil accounts and transfers, managed by Shrine.")
  @view
  #on ; %/wallet_role
  #for ; /sys/slot/shuin_wallet
  item => group(on = item, myth = { %/sender = .input(item.sender), %/recipient = .input(item.recipient), %/amount = .input(item.amount) }) {
   col {
    text(item.lede, role = .title)
    show(item.status, '/sys/slot/body)
    group(action = %/refresh) { action("Refresh balances and receipts", key = "refresh") }
    text("Accounts", role = .heading)
    show(item.overview, '/sys/slot/body)
    text("Send test ETH", role = .heading)
    group(action = %/prepare) {
      input(%/sender, kind = .text, label = "From · leave blank to use the first account", key = "sender")
      input(%/recipient, kind = .text, label = "Recipient address", key = "recipient")
      input(%/amount, kind = .text, label = "Amount in ETH", key = "amount")
      action("Review transfer", key = "prepare")
    }
    show(item.review, '/sys/slot/body)
    row {
      group(action = %/send) { action("Send test ETH", key = "send") }
      group(action = %/cancel) { action("Cancel review", key = "cancel") }
    }
    text("Transfers", role = .heading)
    show(item.history, '/sys/slot/body)
  }
  }
