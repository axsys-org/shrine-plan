- shuin_menus
- shuin_navigation
- stdlib/runtime

' A generic, namespace-owned commenting topos. No corpus-specific policy lives here.
+ shuin_commentary
  + library
    : pages=row[path] layers=row[path] notes=path direction=str
  + page
    : passages=row[path] source=str
  + passage
    : primary=str secondary=str source=str
  + anchor
    : document=path life=nat revision=nat language=str start=nat end=nat quote=str
  + gloss
    : anchor=shuin_commentary/anchor layer=path side=str primary=str secondary=str parent=path source=str
  + reading
    : library=path view=path page=path anchor=maybe[shuin_commentary/anchor] gloss=path hidden=row[path]
  + receipt
    : body=str
  + schema
    \ self=iota
    ^ path
    [self 'gov 'shuin_commentary]
  + home
    \ session=str self=iota
    ^ path
    [self 'app 'shuin_commentary ($ts (str/cat_all ["session_" session]))]
  + named
    \ title=str help=str
    ^ myth
    | (myth/sing system_vocabulary/lede (pails/t title)).put(system_vocabulary/help (pails/t help))
  + change
    \ target=path command=writ state=namespace
    ^ either[str namespace]
    = result (sovereign_cycle (task/vine target command) 0 128 0 0 state)
    ? result
     > (./fail why) (./err (str/cat_all [(path_show target) ": " (path_show [why])]))
     > (./spun next effects rounds ack spill)
      ?> .none spill (./err (str/cat_all [(path_show target) ": commentary reaction failed"]))
      ? effects.len (./err (str/cat_all [(path_show target) ": commentary produced unexpected effects"]))
      | ./ok next
  + record
    \ target=path state=namespace
    ^ either[str myth]
    ?> (./some card) (sovereign_care .x target state).fil (./err "Record is unavailable.")
    | ./ok card
  + lib
    \ target=path state=namespace
    ^ either[str shuin_commentary/library]
    < card (shuin_commentary/record target state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('library)) (./err "Not a commentary library.")
    ?> lib=shuin_commentary/library held (./err "Invalid library.")
    ? !(and (and lib.pages.len (le lib.pages.len 64)) (le lib.layers.len 16)) (./err "Library exceeds the supported page/layer bound.")
    | ./ok lib
  + page_at
    \ target=path state=namespace
    ^ either[str shuin_commentary/page]
    < card (shuin_commentary/record target state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('page)) (./err "Not a commentary page.")
    ?> page=shuin_commentary/page held (./err "Invalid page.")
    ? !(and page.passages.len (le page.passages.len 64)) (./err "Page exceeds 64 passages.")
    | ./ok page
  + passage_at
    \ target=path state=namespace
    ^ either[str shuin_commentary/passage]
    < card (shuin_commentary/record target state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('passage)) (./err "Not a passage.")
    ?> passage=shuin_commentary/passage held (./err "Invalid passage.")
    | ./ok passage
  + gloss_at
    \ target=path state=namespace
    ^ either[str shuin_commentary/gloss]
    < card (shuin_commentary/record target state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('gloss)) (./err "Not a gloss.")
    ?> gloss=shuin_commentary/gloss held (./err "Invalid gloss.")
    | ./ok gloss
  + reading_at
    \ home=path state=namespace
    ^ either[str shuin_commentary/reading]
    < card (shuin_commentary/record home state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('reading)) (./err "Reading session is unavailable.")
    ?> reading=shuin_commentary/reading held (./err "Invalid reading session.")
    | ./ok reading
  + text
    \ anchor=shuin_commentary/anchor state=namespace
    ^ either[str str]
    < passage (shuin_commentary/passage_at anchor.document state)
    ? !(row/has[str] anchor.language ["primary" "secondary"]) (./err "Unknown text language.")
    | ./ok (? (eq anchor.language "primary") passage.primary passage.secondary)
  + valid
    \ anchor=shuin_commentary/anchor state=namespace
    ^ either[str unit]
    < text (shuin_commentary/text anchor state)
    ? !(and (eq anchor.life (goo_runtime/lifetime anchor.document state)) (eq anchor.revision (state.case(.x anchor.document)).fall(0))) (./err "Source changed. Select the passage again; this anchor has not been moved.")
    ? !(and (lt anchor.start anchor.end) (le anchor.end text.len)) (./err "Invalid text range.")
    ? !(eq anchor.quote (text.slice(anchor.start (sub anchor.end anchor.start)))) (./err "The quotation does not match the source range.")
    | ./ok []
  + title
    \ target=path state=namespace
    ^ str
    = card (sovereign_care .x target state).fil.fall(myth/new)
      title card.txt_at(system_vocabulary/lede)
    | ? title.len title (path_show target)
  + help
    \ target=path state=namespace
    ^ str
    | (sovereign_care .x target state).fil.fall(myth/new).txt_at(system_vocabulary/help)
  + link
    \ target=path state=namespace
    ^ json
    | json/obj [(jkv "path" (json/str (path_show target))) (jkv "title" (json/str (shuin_commentary/title target state)))]
  + anchor_json
    \ a=shuin_commentary/anchor
    ^ json
    | json/obj [(jkv "document" (json/str (path_show a.document))) (jkv "life" (json/str (nat/show a.life))) (jkv "revision" (json/str (nat/show a.revision))) (jkv "language" (json/str a.language)) (jkv "start" (json/num .false a.start)) (jkv "end" (json/num .false a.end)) (jkv "quote" (json/str a.quote))]
  + selected_json
    \ value=maybe[shuin_commentary/anchor]
    ^ json
    ? value
     > (./some anchor) (shuin_commentary/anchor_json anchor)
     > .none jnull
  + presentation
    ' Transport the checked Goo tree, not a second parser or native layout constants.
    \ node=goo/node depth=nat
    ^ either[str json]
    ? (gt depth 16) (./err "Commentary presentation exceeds depth 16.")
    ? !(row/has[str] node.constructor ["row" "col" "columns" "group" "text" "input" "operation" "reading_value" "reading_index" "reading_when" "anchored_columns" "reading_stream"]) (./err "Unsupported constructor in commentary presentation.")
    = allowed=row[str]
        ? (eq node.constructor "input") ["kind" "label" "key" "multiline"]
        ? (eq node.constructor "operation") ["operation" "label" "significance"]
        ? (eq node.constructor "reading_stream") ["side" "label"]
        ? (row/has[str] node.constructor ["columns" "anchored_columns"]) ["tracks"]
        ? (row/has[str] node.constructor ["text" "reading_value"]) ["role" "max"]
        []
      arguments=either[str unit]
        % rest=list[rex] node.arguments index=nat 0
        ^ either[str unit]
        ? rest.is_nil (./ok [])
        ?> (./nest _ _ rune kids) rest.head (? (eq index 0) (_ rest.tail index.inc) (./err "Commentary arguments after the value must be named."))
        ? !(and (eq rune "=") (eq kids.len 2)) (./err (str/cat_all ["Unsupported commentary argument: " rest.head.print]))
        ? !(allowed.has(kids.at(0).print)) (./err (str/cat_all ["Unsupported commentary attribute: " kids.at(0).print]))
        | _ rest.tail index.inc
    < arguments arguments
    ? (and (eq node.constructor "input") !(eq (goo_vocabulary/attr "kind" node) "text")) (./err "Commentary draft requires text input.")
    ? (and (eq node.constructor "input") !(eq (goo_vocabulary/attr "multiline" node) "1")) (./err "Commentary draft requires multiline input.")
    = word (\ key=str (goo_vocabulary/attr key node))
      value=str (? node.arguments.len (goo_vocabulary/word node.arguments.head) "")
      tracks=either[str row[json]]
        ?> (./some spec) (goo_vocabulary/named "tracks" node) (./ok [])
        % rest=list[rex] spec.children.stream out=row[json] []
        ^ either[str row[json]]
        ? rest.is_nil (./ok out)
        < track (goo_vocabulary/track rest.head)
        = [kind amount] track
        | _ rest.tail out.snoc((json/obj [(jkv "kind" (json/str kind)) (jkv "value" (json/num .false amount))]))
      children=either[str row[json]]
        % rest=list[goo/node] node.children out=row[json] []
        ^ either[str row[json]]
        ? rest.is_nil (./ok out)
        < child (shuin_commentary/presentation rest.head depth.inc)
        | _ rest.tail out.snoc(child)
    < tracks tracks
    < children children
    | ./ok (json/obj [(jkv "kind" (json/str node.constructor)) (jkv "value" (json/str value))
        (jkv "role" (json/str (word "role"))) (jkv "key" (json/str (word "key"))) (jkv "label" (json/str (word "label")))
        (jkv "operation" (json/str (word "operation"))) (jkv "side" (json/str (word "side"))) (jkv "significance" (json/str (word "significance"))) (jkv "limit" (json/str (word "max")))
        (jkv "tracks" (json/arr tracks)) (jkv "children" (json/arr children))])
  + project
    \ session=str state=namespace
    ^ either[str json]
    = home (shuin_commentary/home session state.self)
    < reading (shuin_commentary/reading_at home state)
    < owner (shuin_commentary/pane reading.library reading.view state)
    < lib (shuin_commentary/lib reading.library state)
    < page (shuin_commentary/page_at reading.page state)
    = passages=either[str row[json]]
        % rest=row[path] page.passages out=row[json] []
        ^ either[str row[json]]
        ? !(rest.len) (./ok out)
        = target rest.at(0)
        < p (shuin_commentary/passage_at target state)
        = value (json/obj [(jkv "path" (json/str (path_show target))) (jkv "title" (json/str (shuin_commentary/title target state)))
            (jkv "life" (json/str (nat/show (goo_runtime/lifetime target state)))) (jkv "revision" (json/str (nat/show (state.case(.x target)).fall(0))))
            (jkv "primary" (json/str p.primary)) (jkv "secondary" (json/str p.secondary)) (jkv "source" (json/str p.source))])
        | _ rest.drop(1) out.snoc(value)
    < passages passages
    = children (sovereign_care .y lib.notes state).kid_tap
    ? (gt children.len 256) (./err "This library exceeds 256 glosses; split it into another study.")
    = glosses=either[str row[json]]
        % rest=row[bee/kv[axal[myth]]] children out=row[json] []
        ^ either[str row[json]]
        ? !(rest.len) (./ok out)
        = [key node] rest.at(0) target lib.notes.snoc(key)
        < g (shuin_commentary/gloss_at target state)
        ? !(row/has[path] g.anchor.document page.passages) (_ rest.drop(1) out)
        ? (row/has[path] g.layer reading.hidden) (_ rest.drop(1) out)
        = value (json/obj [(jkv "path" (json/str (path_show target))) (jkv "title" (json/str (shuin_commentary/title target state))) (jkv "anchor" (shuin_commentary/anchor_json g.anchor))
            (jkv "layer" (json/str (path_show g.layer))) (jkv "author" (json/str (shuin_commentary/title g.layer state))) (jkv "side" (json/str g.side))
            (jkv "primary" (json/str g.primary)) (jkv "secondary" (json/str g.secondary)) (jkv "parent" (json/str (path_show g.parent))) (jkv "source" (json/str g.source))
            (jkv "stale" (json/boo !(either/is_ok (shuin_commentary/valid g.anchor state))))])
        | _ rest.drop(1) out.snoc(value)
    < glosses glosses
    < presentation (shuin_commentary/presentation owner.children.head 0)
    | ./ok (json/obj [(jkv "version" (json/num .false 2))
        (jkv "slots" (json/obj [(jkv (path_show shuin_menus/slot) (json/obj [(jkv "scope" (json/str (path_show home))) (jkv "revision" (json/str (nat/show (state.case(.x home)).fall(0))))]))]))
        (jkv "publication" (json/str (nat/show (state.case(.x reading.view)).fall(0)))) (jkv "presentation" presentation) (jkv "session" (json/str session)) (jkv "revision" (json/str (nat/show (state.case(.x home)).fall(0))))
        (jkv "library" (json/str (path_show reading.library))) (jkv "view" (json/str (path_show reading.view))) (jkv "title" (json/str (shuin_commentary/title reading.library state))) (jkv "description" (json/str (shuin_commentary/help reading.library state)))
        (jkv "primaryDirection" (json/str lib.direction)) (jkv "page" (json/str (path_show reading.page))) (jkv "pageTitle" (json/str (shuin_commentary/title reading.page state))) (jkv "source" (json/str page.source))
        (jkv "pages" (json/arr (lib.pages.map((\ p=path (shuin_commentary/link p state))))))
        (jkv "layers" (json/arr (lib.layers.map((\ p=path (json/obj [(jkv "path" (json/str (path_show p))) (jkv "title" (json/str (shuin_commentary/title p state))) (jkv "description" (json/str (shuin_commentary/help p state))) (jkv "visible" (json/boo !(row/has[path] p reading.hidden)))]))))))
        (jkv "passages" (json/arr passages)) (jkv "glosses" (json/arr glosses)) (jkv "selectedGloss" (json/str (path_show reading.gloss)))
        (jkv "selection" (shuin_commentary/selected_json reading.anchor))])
  + pane
    \ target=path view=path state=namespace
    ^ either[str goo/node]
    < card (shuin_commentary/record target state)
    < recipe (shuin_commentary/record view state)
    < published (goo_runtime/published recipe)
    = checked=either[str goo/view]
        ? published.result
         > (./err why)
          ?> diagnostic=grove/error/syntax why (./err "View parser error.")
          | ./err diagnostic.message
         > (./ok _) (goo_runtime/matching_view published card)
    < declaration checked
    ? !(declaration.is_pane) (./err "Commentary requires an owning @pane declaration.")
    ? declaration.ports.len (./err "The commenting host cannot bind external pane ports yet.")
    ? !(and (eq declaration.children.len 1) (eq declaration.children.head.constructor "pane")) (./err "Commentary requires a compiled pane instance.")
    = owner declaration.children.head
    ? !(and (eq owner.arguments.len 1) (equal (goo_runtime/read_path owner.arguments.head) (maybe/some[path] view))) (./err "Commentary pane identity does not match its declaration.")
    ? !(and (eq owner.children.len 1) (eq owner.children.head.constructor "commentary")) (./err "Pane does not declare the commenting topos.")
    = node owner.children.head
    ? !(and (eq node.arguments.len 1) (eq node.children.len 1)) (./err "Commentary requires one bound library address and one composed body.")
    | ./ok node
  + open
    \ fields=row[[str str]] state=namespace
    ^ either[str namespace]
    = get (\ key=str (http_foot/field key fields))
      home (shuin_commentary/home (get "session") state.self)
    ?> (./some target) (path_parse (get "library")) (./err "Invalid library path.")
    ?> (./some view) (path_parse (get "view")) (./err "Invalid view path.")
    < lib (shuin_commentary/lib target state)
    < owner (shuin_commentary/pane target view state)
    ? (maybe/is_some (sovereign_care .x home state).fil)
      < current (shuin_commentary/reading_at home state)
      ? !(and (equal current.library target) (equal current.view view)) (./err "Session belongs to another library or view.")
      | ./ok state
    = reading (shuin_commentary/reading target view lib.pages.at(0) .none [] [])
      card (shuin_commentary/named "Reading session" "Accepted page, range, gloss and layer visibility for one reader.").put((shuin_commentary/schema state.self).snoc('reading) reading)
      card card.put(shuin_menus/slot (shuin_menus/provider shuin_commentary/menu_open))
    = root=path [state.self 'app 'shuin_commentary]
      ready=either[str namespace]
        ? (maybe/is_some (sovereign_care .x root state).fil) (./ok state)
        | shuin_commentary/change root (writ/make (shuin_commentary/named "Reading sessions" "Accepted reading contexts and their request receipts.")) state
    < next ready
    < next (shuin_commentary/change home (writ/make card) next)
    | shuin_commentary/change home.snoc('requests) (writ/make (shuin_commentary/named "Accepted intents" "Exact request receipts prevent duplicate glosses on retry.")) next
  + menu
    : scope=path target=path anchor=shuin_commentary/anchor expected=nat publication=nat identity=str phase=str mode=str reply=bool
  + menu_view
    \ menu=shuin_commentary/menu name=str
    ^ path
    | (shuin_commentary/schema menu.scope.at(0)).snoc(($ts name))
  + gematria
    ' Mispar hechrechi: final forms use ordinary values; marks and non-Hebrew characters contribute zero.
    \ text=str
    ^ nat
    = letters=row[[str nat]] [["א" 1] ["ב" 2] ["ג" 3] ["ד" 4] ["ה" 5] ["ו" 6] ["ז" 7] ["ח" 8] ["ט" 9] ["י" 10] ["כ" 20] ["ך" 20] ["ל" 30] ["מ" 40] ["ם" 40] ["נ" 50] ["ן" 50] ["ס" 60] ["ע" 70] ["פ" 80] ["ף" 80] ["צ" 90] ["ץ" 90] ["ק" 100] ["ר" 200] ["ש" 300] ["ת" 400]]
    % index=nat 0 total=nat 0
    ^ nat
    ? (ge index.inc text.len) total
    = letter text.slice(index 2)
      matches (letters.keep((\ [key value] (eq key letter))))
      value=nat (? matches.len (row/fold[[str nat] nat] 0 (\ total [key value] (add total value)) matches) 0)
    | _ index.inc (add total value)
  + menu_at
    \ target=path state=namespace
    ^ either[str shuin_commentary/menu]
    < card (shuin_commentary/record target state)
    ?> (./some held) card.get((shuin_commentary/schema state.self).snoc('menu_machine)) (./err "Not a reading menu.")
    ?> menu=shuin_commentary/menu held (./err "Invalid reading menu.")
    | ./ok menu
  + menu_open
    \ scope=path target=path identity=str state=namespace
    ^ either[str [namespace path]]
    < reading (shuin_commentary/reading_at scope state)
    < owner (shuin_commentary/pane reading.library reading.view state)
    < lib (shuin_commentary/lib reading.library state)
    < page (shuin_commentary/page_at reading.page state)
    = reply=bool (and (eq target.len lib.notes.len.inc) (equal target.take(lib.notes.len) lib.notes))
      anchor=either[str shuin_commentary/anchor]
        ? reply
          < gloss (shuin_commentary/gloss_at target state)
          ? (row/has[path] gloss.layer reading.hidden) (./err "This gloss is hidden.")
          | ./ok gloss.anchor
        ? !(row/has[path] target page.passages) (./err "This record is outside the reading page.")
        ?> (./some selected) reading.anchor (./err "Highlight a phrase before opening its menu.")
        ? !(equal selected.document target) (./err "Highlight text in this passage before opening its menu.")
        | ./ok selected
    < anchor anchor
    ? !(row/has[path] anchor.document page.passages) (./err "The source is outside the reading page.")
    < valid (shuin_commentary/valid anchor state)
    = root scope.snoc('menus) destination root.snoc(($ts (str/cat_all ["menu_" identity])))
    ? (maybe/is_some (goo_runtime/record .x destination state))
      < prior (shuin_commentary/menu_at destination state)
      ? !(and (equal prior.scope scope) (equal prior.target target)) (./err "Menu identity was reused for another target.")
      | ./ok [state destination]
    ? (ge (sovereign_care .y root state).kid_tap.len 128) (./err "Close this reader and open a new one to start a fresh menu history.")
    = menu (shuin_commentary/menu scope target anchor (state.case(.x scope)).fall(0) (state.case(.x reading.view)).fall(0) identity "menu" "add" reply)
      schema (shuin_commentary/schema state.self)
      card (shuin_commentary/named "Reading menu" "A frozen source range and its namespace-owned menu actions.")
      card card.put(schema.snoc('menu_machine) menu).put(schema.snoc('menu_title) (pails/t (shuin_commentary/title target state))).put(schema.snoc('menu_quote) (pails/t anchor.quote))
      card card.put(schema.snoc('gematria) (pails/t (str/cat_all ["Gematria · " (nat/show (shuin_commentary/gematria anchor.quote)) " · standard Hebrew values"])))
      card card.put(schema.snoc('draft) (pails/t "")).put(schema.snoc('margin) (pails/t "left"))
      card card.put(shuin_menus/slot (pails/p (shuin_commentary/menu_view menu (? reply "gloss_menu" "range_menu")))).put(shuin_menus/commit_slot (shuin_menus/committer shuin_commentary/menu_commit))
      ready=either[str namespace]
        ? (maybe/is_some (goo_runtime/record .x root state)) (./ok state)
        | shuin_commentary/change root (writ/make (shuin_commentary/named "Reading menus" "Frozen menu contexts and accepted drafts.")) state
    < next ready
    < next (shuin_commentary/change destination (writ/make card) next)
    | ./ok [next destination]
  + menu_commit
    \ target=path before=namespace state=namespace
    ^ either[str namespace]
    < menu (shuin_commentary/menu_at target state)
    ? (eq menu.phase "cancel")
      < card (shuin_commentary/record target state)
      = done card.put(shuin_menus/closed_slot (pails/b .true)).put(shuin_menus/slot (pails/p (shuin_commentary/menu_view menu "menu_done")))
      | shuin_commentary/change target (writ/poke done) state
    ? !(eq menu.phase "save") (./ok state)
    < reading (shuin_commentary/reading_at menu.scope state)
    ? !(eq menu.expected (state.case(.x menu.scope)).fall(0)) (./err "Reading context changed; your draft is retained. Reopen the menu on the intended text.")
    ? !(eq menu.publication (state.case(.x reading.view)).fall(0)) (./err "Reader changed; reopen its menu.")
    < valid (shuin_commentary/valid menu.anchor state)
    < card (shuin_commentary/record target state)
    = schema (shuin_commentary/schema state.self)
      parent (? (eq menu.mode "reply") menu.target [])
    ? (and (eq menu.mode "reply") !(menu.reply)) (./err "This menu has no reply target.")
    ? parent.len
      < gloss (shuin_commentary/gloss_at parent state)
      ? !(equal gloss.anchor menu.anchor) (./err "The reply target changed; reopen its menu.")
      | shuin_commentary/menu_save target menu reading card schema parent state
    | shuin_commentary/menu_save target menu reading card schema parent state
  + menu_save
    \ target=path menu=shuin_commentary/menu reading=shuin_commentary/reading card=myth schema=path parent=path state=namespace
    ^ either[str namespace]
    = reading reading.set_anchor((./some menu.anchor)).set_gloss(parent)
    < next (shuin_commentary/change menu.scope (writ/poke (myth/sing schema.snoc('reading) reading)) state)
    = address (path_show menu.scope)
      session address.slice((sub address.len 32) 32)
      fields=row[[str str]] [["session" session] ["id" menu.identity] ["operation" menu.mode] ["expected" (nat/show (next.case(.x menu.scope)).fall(0))] ["publication" (nat/show menu.publication)] ["dirty" "0"] ["text" (card.txt_at(schema.snoc('draft)))] ["side" (card.txt_at(schema.snoc('margin)))]]
      body (str/cat_all ["menu:" (path_show target) ":" (card.txt_at(schema.snoc('draft))) ":" (card.txt_at(schema.snoc('margin)))])
    < next (shuin_commentary/move fields body next)
    = done card.put(schema.snoc('menu_machine) menu.set_phase("done")).put(shuin_menus/closed_slot (pails/b .true)).put(shuin_menus/slot (pails/p (shuin_commentary/menu_view menu "menu_done")))
    | shuin_commentary/change target (writ/poke done) next
  + offers
    \ operation=str node=goo/node
    ^ bool
    ? (and (eq node.constructor "operation") (eq (goo_vocabulary/attr "operation" node) operation)) .true
    | node.children.any((shuin_commentary/offers operation))
  + move
    \ fields=row[[str str]] body=str state=namespace
    ^ either[str namespace]
    = get (\ key=str (http_foot/field key fields))
      home (shuin_commentary/home (get "session") state.self) schema (shuin_commentary/schema state.self)
      receipt (row/weld[iota] ['requests ($ts (str/cat_all ["intent_" (get "id")]))] home) op (get "operation")
    ? (maybe/is_some (sovereign_care .x receipt state).fil)
      < prior (shuin_commentary/record receipt state)
      ?> (./some held) prior.get(schema.snoc('receipt)) (./err "Receipt is missing.")
      ?> saved=shuin_commentary/receipt held (./err "Receipt is invalid.")
      ? !(eq saved.body body) (./err "Request ID reused with different content.")
      | ./ok state
    < reading (shuin_commentary/reading_at home state)
    < owner (shuin_commentary/pane reading.library reading.view state)
    < lib (shuin_commentary/lib reading.library state)
    < page (shuin_commentary/page_at reading.page state)
    ? (and (row/has[str] op ["add" "reply"]) !((shuin_commentary/offers op owner) || (maybe/is_some (goo_runtime/record .x home state).fall(myth/new).get(shuin_menus/slot)))) (./err "This pane does not offer that operation.")
    ? !(eq (get "publication") (nat/show (state.case(.x reading.view)).fall(0))) (./err "Reader presentation changed. Refresh before using this control.")
    ? !(eq (get "expected") (nat/show (state.case(.x home)).fall(0))) (./err "Reading session changed. Refresh before retrying this choice.")
    ? !(row/has[str] (get "dirty") ["0" "1"]) (./err "Missing draft status.")
    ? (eq (get "dirty") "1") (./err "Finish or discard the current gloss before changing its anchor.")
    = result=either[str [shuin_commentary/reading namespace]]
        ? (eq op "page")
          ?> (./some target) (path_parse (get "target")) (./err "Invalid page.")
          ? !(row/has[path] target lib.pages) (./err "Page is outside this library.")
          | ./ok [(reading.set_page(target).set_anchor(.none).set_gloss([])) state]
        ? (eq op "layer")
          ?> (./some target) (path_parse (get "target")) (./err "Invalid layer.")
          ? !(row/has[path] target lib.layers) (./err "Layer is outside this library.")
          = hidden (? (row/has[path] target reading.hidden) (reading.hidden.keep((\ p=path !(equal p target)))) reading.hidden.snoc(target))
          | ./ok [(reading.set_hidden(hidden).set_gloss([])) state]
        ? (eq op "select")
          ?> (./some doc) (path_parse (get "target")) (./err "Invalid document.")
          ? !(row/has[path] doc page.passages) (./err "Document is outside the current page.")
          ?> (./some life) (nat/parse (get "life")) (./err "Missing document lifetime.")
          ?> (./some revision) (nat/parse (get "revision")) (./err "Missing document revision.")
          ?> (./some start) (nat/parse (get "start")) (./err "Invalid range start.")
          ?> (./some end) (nat/parse (get "end")) (./err "Invalid range end.")
          = anchor (shuin_commentary/anchor doc life revision (get "language") start end (get "quote"))
          < valid (shuin_commentary/valid anchor state)
          | ./ok [(reading.set_anchor((./some anchor)).set_gloss([])) state]
        ? (eq op "gloss")
          ?> (./some target) (path_parse (get "target")) (./err "Invalid gloss.")
          ? !(and (eq target.len lib.notes.len.inc) (equal target.take(lib.notes.len) lib.notes)) (./err "Gloss is outside this library.")
          < gloss (shuin_commentary/gloss_at target state)
          ? !(and (row/has[path] gloss.anchor.document page.passages) !(row/has[path] gloss.layer reading.hidden)) (./err "Gloss is not in the visible source.")
          < valid (shuin_commentary/valid gloss.anchor state)
          | ./ok [(reading.set_anchor((./some gloss.anchor)).set_gloss(target)) state]
        ? (row/has[str] op ["add" "reply"])
          ?> (./some anchor) reading.anchor (./err "Select text before writing a gloss.")
          < valid (shuin_commentary/valid anchor state)
          ? !(and (gt (get "text").len 0) (le (get "text").len 8192)) (./err "A gloss needs 1–8192 UTF-8 bytes.")
          ? !(row/has[str] (get "side") ["left" "right"]) (./err "Choose the left or right margin.")
          ? (ge (sovereign_care .y lib.notes state).kid_tap.len 256) (./err "This study has reached its 256-gloss bound.")
          = parent (? (eq op "reply") reading.gloss [])
          ? (and (eq op "reply") !(parent.len)) (./err "Choose a gloss before replying.")
          = target lib.notes.snoc(($ts (str/cat_all ["note_" (get "id")])))
            layer (row/weld[iota] ['layers 'personal] reading.library)
          ? !(row/has[path] layer lib.layers) (./err "This library does not admit personal glosses.")
          = gloss (shuin_commentary/gloss anchor layer (get "side") "" (get "text") parent "Personal note")
            card (shuin_commentary/named "Personal gloss" anchor.quote).put(schema.snoc('gloss) gloss).put(system_vocabulary/content (pails/t (get "text")))
          < next (shuin_commentary/change target (writ/make card) state)
          | ./ok [(reading.set_gloss(target).set_hidden((reading.hidden.keep((\ p=path !(equal p layer)))))) next]
        | ./err "Unknown commentary operation."
    < result result
    = [reading next] result
    < next (shuin_commentary/change home (writ/poke (myth/sing schema.snoc('reading) reading)) next)
    | shuin_commentary/change receipt (writ/make ((shuin_commentary/named "Accepted reading intent" "An exact retry returns the accepted result without duplicating a comment.").put(schema.snoc('receipt) (shuin_commentary/receipt body)))) next
  + run
    \ fields=row[[str str]] body=str state=namespace
    ^ [namespace nat str]
    = get (\ key=str (http_foot/field key fields))
      op (get "operation")
      result=either[str namespace]
        ? (eq op "open") (shuin_commentary/open fields state)
        ? (eq op "read") (./ok state)
        | shuin_commentary/move fields body state
    ? result
     > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
     > (./ok next)
      ? (shuin_commentary/project (get "session") next)
       > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
       > (./ok value) [next 200 (show value)]
  + http
    \ body=str
    ^ http_foot/action
    ? (gt body.len 65536) (./reply (http_driver/response 413 "Commentary request too large"))
    = fields (http_foot/fields body) get (\ key=str (http_foot/field key fields))
      allowed=row[str] ["session" "operation" "library" "view" "id" "expected" "publication" "dirty" "target" "life" "revision" "language" "start" "end" "quote" "text" "side"]
    ? !(fields.all((\ [key value] (and (row/has[str] key allowed) (eq (fields.keep((\ [other _] (eq key other)))).len 1))))) (./reply (http_driver/response 400 "Unknown or duplicate commentary field"))
    ? !(shuin_navigation/identity (get "session")) (./reply (http_driver/response 400 "Invalid session"))
    ? (and !(row/has[str] (get "operation") ["open" "read"]) !(shuin_navigation/identity (get "id"))) (./reply (http_driver/response 400 "Invalid intent identity"))
    | ./transact (shuin_commentary/run fields body)
