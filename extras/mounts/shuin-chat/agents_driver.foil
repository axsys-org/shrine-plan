- shuin_agents
- shuin_wallet_driver

+ shuin_agents_driver
  + reply
    \ request=nat
    ^ [nat str]
    = ;[message caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? message
     > (./develop id status body)
      ? (eq id request) [status body]
      | _ request
    | _ request
  + loop
    \ parent=nat endpoint=str sequence=nat
    ^ nat
    ; (Send parent (feet/gift/transact sequence (shuin_agents/begin endpoint)))
    = ;[status body] (shuin_agents_driver/reply sequence)
    ? !(eq status 200)
      ; (namespace_http/wait 0)
      | _ parent endpoint sequence.inc
    = job (shuin_agents/json body)
      request (path_parse (shuin_agents/field "request" job)).fall([])
      ;response (namespace_http/await parent request sequence)
    = ;now (div (Now 0) 1000000000)
    ; (Send parent (feet/gift/transact sequence.inc (shuin_agents/finish job response.put(['completed_at] (pails/n now)))))
    = ;ack (shuin_agents_driver/reply sequence.inc)
    | _ parent endpoint (add sequence 2)
  + run
    \ endpoint=str initial=feet/task/init actor=nat
    ^ nat
    | shuin_agents_driver/loop initial.parent endpoint 1
  + start
    \ server=nat arguments=row[str]
    ^ nat
    = ;server (shuin_wallet_driver/start server arguments)
    ?> (./some wallet) (path_parse arguments.at(1)) (error (pails/t "Invalid node identity"))
    = ;server (namespace_http/start server [wallet.at(0) 'io 'http 'outbound] arguments.at(2) arguments.at(3))
      home (shuin_agents/home wallet.at(0))
    ; (SendCaps server (helm/supervisor/register home (shuin_agents_driver/run arguments.at(2))) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ?> (./ack err) reply (error (pails/t "Agent driver registration failed"))
    ; (shuin_wallet/require !(maybe/is_some err) "Agent driver registration rejected")
    server
