#import path_type=lib/grove/types/path

source_path =
  @slot

context =
  @role
  %/source_path: path_type

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/documentation_workspace
  documentation => {
    navigate('/address, source = documentation.source_path, mode = "input", label = "Go to path")
    navigate('/parent, source = documentation.source_path, mode = "parent", label = "Parent")
    selection('/entry, source = documentation.source_path, topology = "tree", axis = "z", initial = .member(documentation.source_path)) {
      split {
        pane(%/Namespace, ports = { '/entry = '/entry })
        deck('/reading) {
          pane(%/Documentation, ports = { '/entry = '/entry })
          pane(%/Values, ports = { '/entry = '/entry })
          pane(%/Views, ports = { '/entry = '/entry })
          pane(%/Panes, ports = { '/entry = '/entry })
        }
      }
    }
  }

Namespace =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Namespace
  #port ; /entry
  documentation => {
    list_tree('/outline, source = documentation.source_path, selection = '/entry, slot = '/sys/slot/documentation_summary, browse = "Browse")
  }

Documentation =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Documentation
  #port ; /entry
  documentation => {
    follow('/article, selection = '/entry, slot = '/sys/slot/documentation)
  }

Values =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Values
  #port ; /entry
  documentation => {
    follow('/values, selection = '/entry, slot = '/sys/slot/synthetic)
  }

Views =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Views
  #port ; /entry
  documentation => {
    follow('/views, selection = '/entry, slot = '/sys/slot/views)
  }

Panes =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Panes
  #port ; /entry
  documentation => {
    follow('/panes, selection = '/entry, slot = '/sys/slot/panes)
  }
