- goo_workspace_mount
- slot_documentation
- testing
- tests/namespace [at=ns_fixture]
- tests/overlay_cache [at=cache_fixture]

+ documentation_checks
  + has
    \ needle=str text=str
    ^ bool
    | maybe/is_some (http_foot/find needle text)
  + fixture
    ^ myth
    = card (myth/sing bond/lede (pails/t "Readable café"))
      card card.put(bond/help (lore "Readable café" ["A distinct first paragraph." "<script>alert(1)</script>" "Use λ without losing Unicode."] [["(add 1 1)" "2"]]))
      card card.put(bond/src (pails/t "<source>& remains literal"))
    | card.put(bond/mold (pails/ty (^ nat)))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = render (\ card=myth (str/from_atom (weft/render (goo_documentation/article ['demo 'entry] card))))
      article (render documentation_checks/fixture)
      plain (render (myth/sing bond/help (pails/t "Plain help")))
      legacy (render (mirror/doc "Documentation-only record"))
      compiled (mirror/entry 42 "value" "42" .true .false "" [] [])
      empty (render myth/new)
      slot_seeds slot_documentation/cards
      about (render slot_seeds.dip(['sys 'about]).fil.fall(myth/new))
      summary (str/from_atom (weft/render (goo_documentation/summary ['demo 'entry] documentation_checks/fixture)))
      has documentation_checks/has
      field (goo/field "source_path" ['source] ['path] .false)
      seed_view (goo/view rex/zero_span ['doc] ['context] ['slot] "reader" .nil .true .nil)
      published (goo/published seed_view (list/one field) lash/new (./ok seed_view))
      seed (rex/rune "|" [(rex/word "member") (rex/rune "." [(rex/word "reader") (rex/word "source_path")])])
      resolved (goo_panes/initial_path published (myth/sing ['source] (pails/p ['target])) seed)
      derived (goo_documentation/metadata documentation_checks/fixture "normalized" "function")
      branded=type (./rec (brand_encode ['sys 'demo 'entry] 2) [["long_field_name_that_forces_a_multiline_record_signature" .any] ["second" .any]])
      valid goo_workspace_mount/query_valid
    [(testing/nat "multiline nominal types preserve readable identity" 1 (has "/sys/demo/entry@x2[" (str/from_atom (tyshow/pretty branded))))
     (testing/text "stored documentation takes precedence" "Readable café" (goo_documentation/lede derived))
     (testing/nat "derived source is explicitly normalized" 1 (has "Definition (normalized source)" (render (goo_documentation/metadata myth/new "source" "function"))))
     (testing/nat "inspection does not invent stored documentation" 1
       (has "No documentation has been published" (render (goo_documentation/metadata myth/new "source" "function"))))
     (testing/nat "noncompiler records have no artifact" 1 (maybe/is_none (goo_documentation/artifact ['artifact] myth/new)))
     (testing/nat "initial membership resolves receiver path" 1 (equal resolved (maybe/some[path] ['target])))
     (testing/nat "missing seed receiver rejected" 1 (maybe/is_none (goo_panes/initial_path published myth/new seed)))
     (testing/nat "literal initial membership still supported" 1 (equal (goo_panes/initial_path published myth/new (rex/quip "'/literal")) (maybe/some[path] ['literal])))
     (testing/nat "Unicode prose preserved" 1 (has "Use λ" article))
     (testing/nat "Unicode lede preserved" 1 (has "Readable café" article))
     (testing/nat "distinct first lore paragraph retained" 1 (has "A distinct first paragraph." article))
     (testing/nat "lore HTML escaped" 1 (has "&lt;script&gt;" article))
     (testing/nat "no injected script" 0 (has "<script>" article))
     (testing/nat "source HTML escaped" 1 (has "&lt;source&gt;&amp;" article))
     (testing/nat "examples are authored not executed" 1 (has "does not execute" article))
     (testing/nat "type signature included" 1 (has "doc-signature" article))
     (testing/nat "subject identity attached" 1 (has "data-subject=""/demo/entry""" article))
     (testing/nat "plain help supported" 1 (has "Plain help" plain))
     (testing/nat "publisher documentation supported" 1 (has "Documentation-only record" legacy))
     (testing/text "documentation-only records use help" "Documentation-only record"
       (mirror/doc "Documentation-only record").txt_at(bond/help))
     (testing/nat "compiler mirror stores code as content" 1
       (equal[maybe[pail]] compiled.get(bond/content) (./some (pails/code 42))))
     (testing/nat "undocumented record explained" 1 (has "No documentation has been published" empty))
     (testing/nat "slot page shows catalog documentation" 1 (has "Subject described by this record." about))
     (testing/nat "slot page has no compiler type section" 0 (has "doc-signature" about))
     (testing/nat "slot page has no compiler source section" 0 (has "doc-source" about))
     (testing/nat "compact summary has entry name" 1 (has ">entry<" summary))
     (testing/nat "compact summary omits full prose" 0 (has "Readable café" summary))
     (testing/nat "default route accepted" 1 (valid "/goo-documentation"))
     (testing/nat "root accepted" 1 (valid "/goo-documentation?path=%2F"))
     (testing/nat "canonical path accepted" 1 (valid "/goo-documentation?path=%2Fsys%2Fhelp"))
     (testing/nat "relative path rejected" 0 (valid "/goo-documentation?path=sys/help"))
     (testing/nat "duplicate query rejected" 0 (valid "/goo-documentation?path=/sys&path=/app"))
     (testing/nat "unknown query rejected" 0 (valid "/goo-documentation?slot=/sys"))
     (testing/nat "dot traversal rejected" 0 (valid "/goo-documentation?path=/sys/../app"))]
  + integration
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 1) 'app 'documented]
      state (cache_fixture/overlay_cache_tests/write target (writ/make documentation_checks/fixture) ns_fixture/namespace_tests/initial)
      values (either/ok_val (goo_browser/render_result goo_bridge/initial_context target goo_reflection/slot [] [] [] .none state))
      values_html (grove_dev/text (grove_dev/field "html" values))
      context goo_bridge/initial_context
      slot goo_documentation/slot
      result (either/ok_val (goo_browser/render_result context target [] slot [] [] .none state))
      direct (goo_browser/render_result context target slot [] [] [] .none state)
      bundle (goo_browser/pane_layouts context target [] slot [] [] .none state)
      variants (grove_dev/items (grove_dev/field "layouts" (either/ok_val bundle)))
      first (grove_dev/field "snapshot" (grove_dev/field "render" variants.at(0)))
      same (variants.all((\ item (equal first (grove_dev/field "snapshot" (grove_dev/field "render" item))))))
      values (either/ok_val (goo_browser/pane_layouts context target [] goo_reflection/slot [] [] .none state))
      value_variants (grove_dev/items (grove_dev/field "layouts" values))
      value_snapshot (grove_dev/field "snapshot" (grove_dev/field "render" value_variants.at(0)))
      same_values (value_variants.all((\ item (equal value_snapshot (grove_dev/field "snapshot" (grove_dev/field "render" item))))))
      query (goo_runtime/request "tree-page" target [] [] [] 0 0 0 [] 0)
      tree (goo_browser/tree_layouts context query [goo_documentation/summary_slot] state)
      changed (cache_fixture/overlay_cache_tests/write target (writ/make (myth/sing bond/lede (pails/t "Updated documentation"))) state)
      latest (either/ok_val (goo_browser/render_result context target [] slot [] [] .none changed))
      html (grove_dev/text (grove_dev/field "html" result))
    [(testing/nat "ordinary render boundary serves documentation" 1 (documentation_checks/has "Readable café" html))
     (testing/nat "Values reflects lore without an external descriptor" 0 (documentation_checks/has "[opaque]" values_html))
     (testing/nat "Values shows lore body" 1 (documentation_checks/has "A distinct first paragraph." values_html))
     (testing/nat "Values escapes lore body" 1 (documentation_checks/has "&lt;script&gt;" values_html))
     (testing/nat "Values renders nested Unicode lore as text" 1 (documentation_checks/has (goo_reflection/display_text "Use λ without losing Unicode.") values_html))
     (testing/nat "Values shows authored examples" 1 (documentation_checks/has "(add 1 1)" values_html))
     (testing/nat "Values shows expected example results" 1 (documentation_checks/has ">2<" values_html))
     (testing/nat "Values labels expected results" 1 (documentation_checks/has "Expected result" values_html))
     (testing/nat "direct recipe identity serves documentation" 1 (either/is_ok direct))
     (testing/nat "documentation has no action bindings" 0 (grove_dev/items (grove_dev/field "controls" result)).len)
     (testing/nat "documentation has no claimed fixed display" 1 (equal jnull (grove_dev/field "display" result)))
     (testing/nat "pane variants carry identical snapshot evidence" 1 same)
     (testing/nat "Values variants carry identical snapshot evidence" 1 same_values)
     (testing/nat "pane width variants supported" 1 (either/is_ok bundle))
     (testing/nat "incremental tree prepares compact summaries" 1 (either/is_ok tree))
     (testing/nat "fresh snapshot changes displayed docs" 1 (documentation_checks/has "Updated documentation" (grove_dev/text (grove_dev/field "html" latest))))
     (testing/nat "fresh snapshot changes subject evidence" 0 (equal (grove_dev/field "snapshot" result) (grove_dev/field "snapshot" latest)))
     (testing/nat "missing subject rejected" 1 (either/is_err (goo_browser/render_result context [($x 1) 'missing] [] slot [] [] .none state)))
     (testing/nat "native control route rejected" 1 (either/is_err (goo_browser/render_result context target slot [] [] [] (./some [0]) state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Documentation content and routes" documentation_checks/checks)
   (testing/case "Documentation through live Goo boundary" documentation_checks/integration)]
