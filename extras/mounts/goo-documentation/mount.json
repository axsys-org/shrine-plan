{
  "version": 1,
  "name": "goo-documentation",
  "dependencies": [
    "explorer",
    "codecs"
  ],
  "modules": {},
  "grove": [
    {
      "root": [
        "gov",
        "goo_documentation"
      ],
      "files": [
        "documentation.grove"
      ]
    }
  ],
  "assets": {
    "/goo-documentation/style.css": "style.css"
  },
  "files": {},
  "roots": [
    [
      "gov",
      "goo_documentation"
    ]
  ],
  "tests": {
    "tests/goo_documentation": "test_documentation.foil"
  },
  "host": "host.py",
  "workspaces": [
    {
      "name": "browser",
      "route": "/goo-documentation",
      "entry": [
        "gov",
        "goo_documentation",
        "workspace"
      ],
      "receiver": {
        "slot": [
          "gov",
          "goo_documentation",
          "source_path"
        ],
        "initial": [
          "lib",
          "pact",
          "lore"
        ],
        "admission": "namespace"
      },
      "shell": {
        "title": "Goo documentation",
        "brand": "goo / documentation",
        "subtitle": "Read the system. Follow the names.",
        "stylesheet": "/goo-documentation/style.css",
        "breadcrumbs": true,
        "navigation": [
          [
            "Library",
            [
              "lib"
            ]
          ],
          [
            "Declarations",
            [
              "gov"
            ]
          ],
          [
            "Applications",
            [
              "app"
            ]
          ],
          [
            "System",
            [
              "sys"
            ]
          ]
        ],
        "footer": "Live namespace documentation \u00b7 select a name to read \u00b7 expand a branch to explore"
      }
    }
  ]
}
