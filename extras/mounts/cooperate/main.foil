- namespace_command
- weft_std

' A document-local harness. External agents execute; Shrine retains coherent
' context, branching traces and reusable output references. All operations are
' pure planners run by shared namespace admission. No model call occurs here.
+ cooperate
  + captured
    : source=safe observed=maybe[nat] value=pin[axal[myth]]
  + request
    : operation=str input=pin[myth]
  + key
    \ self=iota name=iota
    ^ path
    | [self 'gov 'cooperate name]
  + record
    \ target=path state=namespace
    ^ maybe[myth]
    | (sovereign_care .x target state).fil
  + identifier
    \ input=myth
    ^ either[iota iota]
    = text (input.txt_at(['id]))
    ? ((eq text.len 0) || (gt text.len 64)) (./err 'invalid_work_id)
    ?> (./some name) (path_parse (str/cat_all ["/" text])) (./err 'invalid_work_id)
    ? !(eq name.len 1) (./err 'invalid_work_id)
    ? !(is_text name.at(0)) (./err 'invalid_work_id)
    | ./ok name.at(0)
  + reference
    \ key=path input=myth
    ^ either[iota safe]
    ?> (./some held) input.get(key) (./err 'missing_reference)
    ?> link=safe held (./err 'invalid_reference)
    | ./ok link
  + path_bytes
    \ name=path
    ^ nat
    | name.fold 0 (\ total=nat part=iota (add total (add 1 (wid (quip_val part)))))
  + pail_bytes
    ' Borrowed compiled/native payloads cost a fixed reference allowance. The
    ' budget covers materialized records and scalar content, not compiler heaps.
    \ value=pail
    ^ nat
    ? value
     > t=pails/t t.t.len
     > n=pails/n (wid n.n)
     > z=pails/z (add 1 (wid z.n))
     > p=pails/p (cooperate/path_bytes p.p)
     > s=safe (add 24 (cooperate/path_bytes s.path))
    64
  + bytes
    \ tree=axal[myth]
    ^ nat
    | tree.tap.fold 0
      \ count=nat [name record]
      | record.tap.fold (add count (cooperate/path_bytes name))
        \ size=nat entry
        | add size (add (cooperate/path_bytes entry.key) (cooperate/pail_bytes entry.val))
  + arguments
    \ operation=str input=myth
    ^ bool
    ? (gt (cooperate/bytes (axal/new[myth] (./some input))) 65536) .false
    ? !(input.has(['content])) .false
    | input.tap.all
      \ entry
      ? ((equal[path] entry.key ['id]) || (equal[path] entry.key ['content]))
        | ?=(text=pails/t entry.val)
      ? (and (eq operation "append") (equal[path] entry.key ['kind]))
        | ?=(text=pails/t entry.val)
      = reference
          ? (pith_prefix ['context] entry.key) !(eq operation "finish")
          ? (equal[path] entry.key ['artifact]) !(eq operation "open")
          ? (equal[path] entry.key ['reply_to]) (eq operation "append")
          ? ((equal[path] entry.key ['parent]) || (equal[path] entry.key ['procedure])) (eq operation "open")
          .false
      | (and reference ?=(ref=safe entry.val))
  + resolve
    \ source=safe state=namespace
    ^ either[iota axal[myth]]
    ?> (./known tree) (sovereign_view source.care source.ver source.path state)
      | ./err 'missing_context
    ? (eq tree.wyt 0) (./err 'missing_context)
    ? (gt tree.wyt 64) (./err 'context_record_limit)
    = bytes (cooperate/bytes tree)
    ? (gt bytes 65536) (./err 'context_size_limit)
    | ./ok tree
  + capture
    \ source=safe state=namespace
    ^ either[iota cooperate/captured]
    < tree (cooperate/resolve source state)
    | ./ok (cooperate/captured source (state.case(source.care source.path)) (pin tree))
  + pin_link
    ' Parent and reply edges name actual historical records, never a moving head.
    \ source=safe state=namespace
    ^ either[iota safe]
    ? !(equal[care] source.care .x) (./err 'edge_requires_record_reference)
    < tree (cooperate/resolve source state)
    ? source.ver (./ok source)
    ?> (./some version) state.case(.x source.path) (./err 'edge_requires_record_reference)
    | ./ok (source.set_ver(version))
  + duplicate
    ' Existing IDs are retry keys. Their original request survives later edits.
    \ operation=str input=myth target=path state=namespace
    ^ either[iota bool]
    = found (cooperate/record target state)
    ? (maybe/is_none found)
      ? (maybe/is_some (state.case(.x target))) (./err 'work_id_retired)
      ? (gt (sovereign_peek target state).wyt 0) (./err 'work_id_exists)
      | ./ok .false
    ?> (./some current) found (./err 'missing_work)
    ?> (./some held) current.get((cooperate/key state.self 'request))
      | ./err 'work_id_exists
    ?> saved=cooperate/request held (./err 'work_id_exists)
    ? (and (eq saved.operation operation) (equal[myth] (unpin saved.input) input))
      | ./ok .true
    | ./err 'work_id_conflict
  + stamped
    \ operation=str input=myth state=namespace
    ^ myth
    | (myth/sing ((cooperate/key state.self 'request)) (cooperate/request operation (pin input))).put(system_vocabulary/content (pails/t (input.txt_at(['content]))))
  + snapshot
    ' The frozen tree is data. /x exposes it through the existing cell mechanism.
    \ context=myth ignored=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some held) context.get(['capture]) [context (axal/new[myth] .none)]
    ?> saved=cooperate/captured held [context (axal/new[myth] .none)]
    | [context (unpin saved.value)]
  + unchanged
    \ context=myth current=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some held) context.get(['capture]) [context (axal/new[myth] .none)]
    ?> saved=cooperate/captured held [context (axal/new[myth] .none)]
    = same (equal[axal[myth]] current (unpin saved.value))
    | [context (axal/new[myth] (./some (myth/sing ['unchanged] (pails/b same))))]
  + source_link
    \ saved=cooperate/captured
    ^ safe
    ? saved.source.ver saved.source
    ?> (./some version) saved.observed saved.source
    | saved.source.set_ver(version)
  + frozen
    \ target=path saved=cooperate/captured
    ^ myth
    | (myth/sing ['capture] saved).put(['source] (pails/p saved.source.path)).put(['source_case] (pails/n saved.source.ver)).put(['source_care] (pails/q (care/seg saved.source.care))).put(['observed_case] (pails/n saved.observed.fall(0))).put(bond/weft (cell cooperate/snapshot)).put(bond/tack (safe 1 .x [target.at(0) 'gov 'cooperate 'empty]))
  + checking
    \ target=path saved=cooperate/captured
    ^ myth
    | (cooperate/frozen target saved).put(bond/weft (cell cooperate/unchanged)).put(bond/tack saved.source)
  + captures
    ' Input aliases deliberately bound context. No implicit whole-document scan.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = selected (input.tap.keep((\ entry (pith_prefix ['context] entry.key))))
    ? (gt selected.len 16) (./err 'context_input_limit)
    % remaining=row[mop/kv[path pail]] selected out=row[[p=path q=writ]] [] records=nat 0 bytes=nat 0
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some hit) remaining.pull (./ok out)
    = [entry rest] hit
    ? !(eq entry.key.len 2) (./err 'invalid_context_alias)
    ? !(is_text entry.key.at(1)) (./err 'invalid_context_alias)
    ?> source=safe entry.val (./err 'invalid_reference)
    < saved (cooperate/capture source state)
    = tree (unpin saved.value)
      total (add records tree.wyt)
    ? (gt total 64) (./err 'context_record_limit)
    = size (cooperate/bytes tree)
      bytes (add bytes size)
    ? (gt bytes 65536) (./err 'context_size_limit)
    = card (cooperate/frozen (target.weld(entry.key)) saved)
      check (cooperate/checking (target.weld(['checks entry.key.at(1)])) saved)
    | _ rest (out.weld([[target.weld(entry.key) (writ/make card)]
        [target.weld(['checks entry.key.at(1)]) (writ/make check)]])) total bytes
  + edge
    \ name=iota input=myth record=myth state=namespace
    ^ either[iota myth]
    ? !(input.has([name])) (./ok record)
    < source (cooperate/reference [name] input)
    < pinned (cooperate/pin_link source state)
    | ./ok (record.put((cooperate/key state.self name) pinned))
  + open
    \ document=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(cooperate/arguments "open" input) (./err 'invalid_work_arguments)
    ? (and input.has(['procedure]) input.has(['context 'procedure])) (./err 'duplicate_procedure_context)
    ? !(state.permitted(document)) (./err 'write_outside_authority)
    ?> (./some doc) (cooperate/record document state) (./err 'missing_document)
    < id (cooperate/identifier input)
    = target document.weld(['work id])
    < repeated (cooperate/duplicate "open" input target state)
    ? repeated (./ok [])
    ? (gt (input.txt_at(['content])).len 16384) (./err 'content_limit)
    = selected
        ? input.has(['procedure])
          | input.put(['context 'procedure] (input.pail_at(['procedure])))
        input
    < context (cooperate/captures target selected state)
    = own (cooperate/stamped "open" input state)
      own own.put((cooperate/key state.self 'document) (pails/p document))
      own own.put((cooperate/key state.self 'status) (pails/t "open"))
      own own.put((cooperate/key state.self 'sequence) (pails/n 0))
    < own (cooperate/edge 'parent input own state)
    = writes=row[[p=path q=writ]] [[target (writ/make own)]]
    | ./ok writes.weld(context)
  + active
    \ target=path state=namespace
    ^ either[iota myth]
    ?> (./some record) (cooperate/record target state) (./err 'missing_work)
    ? !(eq (record.txt_at((cooperate/key state.self 'status))) "open")
      | ./err 'work_not_open
    | ./ok record
  + append
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(cooperate/arguments "append" input) (./err 'invalid_work_arguments)
    < id (cooperate/identifier input)
    = event=path target.weld(['trace id])
    < repeated (cooperate/duplicate "append" input event state)
    ? repeated (./ok [])
    < current (cooperate/active target state)
    = kind (input.txt_at(['kind]))
    = kinds=row[str] ["message" "observation" "tool-result" "output"]
    ? !(kinds.has(kind))
      | ./err 'invalid_trace_kind
    ? (gt (input.txt_at(['content])).len 16384) (./err 'content_limit)
    < context (cooperate/captures event input state)
    ? (ge (current.nat_at((cooperate/key state.self 'sequence) 0)) 128) (./err 'trace_limit)
    = sequence (current.nat_at((cooperate/key state.self 'sequence) 0)).inc
      own (cooperate/stamped "append" input state)
      own own.put((cooperate/key state.self 'kind) (pails/t kind))
      own own.put((cooperate/key state.self 'sequence) (pails/n sequence))
      own own.put((cooperate/key state.self 'work) (pails/p target))
      own (myth/copy_slot (cooperate/key state.self 'head) current own)
    < own (cooperate/edge 'reply_to input own state)
    = artifact=either[iota [myth row[[p=path q=writ]]]]
        ? !(input.has(['artifact])) (./ok [own []])
        < source (cooperate/reference ['artifact] input)
        < saved (cooperate/capture source state)
        = at=path event.weld(['artifact])
        | ./ok [(own.put((cooperate/key state.self 'artifact) (cooperate/source_link saved)))
            [[at (writ/make (cooperate/frozen at saved))]]]
    < material artifact
    = [own artifacts] material
    = updated current.put((cooperate/key state.self 'head) (pails/p event))
      updated updated.put((cooperate/key state.self 'sequence) (pails/n sequence))
    = writes=row[[p=path q=writ]] [[event (writ/make own)] [target (writ/make updated)]]
    | ./ok writes.weld(context).weld(artifacts)
  + current
    \ saved=cooperate/captured state=namespace
    ^ bool
    ? saved.source.ver .true
    ? !(equal[maybe[nat]] saved.observed (state.case(saved.source.care saved.source.path))) .false
    ? (cooperate/resolve saved.source state)
     > (./ok now) (equal[axal[myth]] now (unpin saved.value))
    .false
  + all_current
    ' Only context roots and observation captures participate, not arbitrary
    ' fields in evidence. Checks are derived; the trace is never rewritten.
    \ target=path state=namespace
    ^ bool
    = tree (sovereign_peek target state)
    | tree.tap.all
      \ [name card]
      ? !((eq name.len 2) || (eq name.len 4)) .true
      = selected
          ? (eq name.len 2) (eq_iota name.at(0) 'context)
          | (and (eq_iota name.at(0) 'trace) (eq_iota name.at(2) 'context))
      ? !selected .true
      ?> (./some held) card.get(['capture]) .false
      ?> saved=cooperate/captured held .false
      | cooperate/current saved state
  + finish
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(cooperate/arguments "finish" input) (./err 'invalid_work_arguments)
    < id (cooperate/identifier input)
    = receipt target.weld(['commands id])
    < repeated (cooperate/duplicate "finish" input receipt state)
    ? repeated (./ok [])
    < current (cooperate/active target state)
    ? !(cooperate/all_current target state) (./err 'stale_context)
    ? (gt (input.txt_at(['content])).len 16384) (./err 'content_limit)
    = result target.weld(['result])
      body (cooperate/stamped "finish" input state)
    ? (gt (sovereign_peek result state).wyt 0) (./err 'result_exists)
    = captured=either[iota myth]
        ? !(input.has(['artifact])) (./ok body)
        < source (cooperate/reference ['artifact] input)
        < saved (cooperate/capture source state)
        | ./ok ((cooperate/frozen result saved).meld(body))
    < output captured
    = updated current.put((cooperate/key state.self 'status) (pails/t "complete"))
      updated updated.put((cooperate/key state.self 'result) (pails/p result))
      audit (cooperate/stamped "finish" input state)
    = linked=either[iota myth]
        ? !(input.has(['artifact])) (./ok updated)
        < source (cooperate/reference ['artifact] input)
        < saved (cooperate/capture source state)
        | ./ok (updated.put((cooperate/key state.self 'artifact) (cooperate/source_link saved)))
    < updated linked
    | ./ok [[result (writ/make output)] [receipt (writ/make audit)] [target (writ/make updated)]]
