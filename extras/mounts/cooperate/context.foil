- native_work_ops
- graph_references

' A context lens selects incoming holders in an explicit wiki scope. /r owns
' membership and ordinary cell dependencies own content subscriptions.
+ native_context
  + retained
    \ record=myth entry=mop/kv[path pail]
    ^ myth
    ? (pith_prefix ['evidence] entry.key) record
    | record.put(entry.key entry.val)
  + select
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    ?> subject=safe record.pail_at(bond/tack) (yell [] record)
    ?> (./some scope) record.path_at(['scope]) (yell [] record)
    = incoming b.crew.gut(['incoming] native_work_ops/empty)
      bindings=row[[path safe]] (graph_references/incoming_bindings scope incoming).keep((\ [alias source] !(equal[path] source.path b.here)))
      retained=myth (row/fold[mop/kv[path pail] myth] myth/new native_context/retained record.tap)
      selected=myth (row/fold[[path safe] myth] retained (\ out=myth [slot source] out.put(slot source)) bindings)
    ? (equal[myth] selected record) (yell [] record)
    | yell [[b.here (writ/make selected)]] record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | native_context/select b record.meld(input) []
  + form
    ^ form
    | def_form.set_init(native_work_ops/wake).set_hear(native_context/select).set_talk(native_context/talk)
  + lens
    \ self=iota subject=safe scope=path bindings=row[[path safe]]
    ^ myth
    = record (native_work_ops/lens subject 'subject bindings)
    | record.put(['scope] (pails/p scope)).put(limb_slot (kook [[self 'gov 'cooperate 'context_hand]])).put(crew_slot (cpail (crew/sing ['incoming] (dep .z (r_spell subject.path)))))
