- cooperate_ops
- answering_ops
- grove_install

+ cooperate_mount
  + failure
    : reason=iota
  + records
    \ self=iota
    ^ row[[path myth]]
    = root=path [self 'gov 'cooperate]
      operations=row[[path myth]]
        [[root.weld(['empty]) myth/new]
         [root.weld(['hole_hand]) (myth/sing system_vocabulary/form native_work_ops/hole_form)]
         [root.weld(['answer_hand]) (myth/sing system_vocabulary/form answering_ops/form)]
         [root.weld(['answer]) (myth/sing system_vocabulary/op (namespace_op answering_ops/start))]
         [root.weld(['answer_enabled]) (myth/sing system_vocabulary/op (namespace_op answering_ops/enabled))]
         [root.weld(['open]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/open))]
         [root.weld(['append]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/append))]
         [root.weld(['delegate]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/delegate))]
         [root.weld(['ask]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/ask))]
         [root.weld(['resolve_hole]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/resolve_hole))]
         [root.weld(['finish]) (myth/sing system_vocabulary/op (namespace_op cooperate_ops/finish))]]
    | operations
  + install
    \ state=namespace
    ^ either[pail namespace]
    = operations (cooperate_mount/records state.self)
    % remaining=row[[path myth]] operations next=namespace state
    ^ either[pail namespace]
    ?> (./some hit) remaining.pull (./ok next)
    = [entry rest] hit
    = [name record] entry
    ? (grove_install/change name (writ/make record) next)
     > (./err why) (./err (cooperate_mount/failure why))
     > (./ok installed) (_ rest installed)
