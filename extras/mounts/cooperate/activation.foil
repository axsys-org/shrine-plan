- cooperate
- answering
- grove_install

+ cooperate_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'gov 'cooperate]
      operations=row[[path myth]]
        [[root.weld(['empty]) myth/new]
         [root.weld(['hole_hand]) (myth/sing system_vocabulary/form native_work/hole_form)]
         [root.weld(['answer_hand]) (myth/sing system_vocabulary/form answering/form)]
         [root.weld(['answer]) (myth/sing system_vocabulary/op (namespace_op answering/start))]
         [root.weld(['answer_enabled]) (myth/sing system_vocabulary/op (namespace_op answering/enabled))]
         [root.weld(['open]) (myth/sing system_vocabulary/op (namespace_op cooperate/open))]
         [root.weld(['append]) (myth/sing system_vocabulary/op (namespace_op cooperate/append))]
         [root.weld(['delegate]) (myth/sing system_vocabulary/op (namespace_op cooperate/delegate))]
         [root.weld(['ask]) (myth/sing system_vocabulary/op (namespace_op cooperate/ask))]
         [root.weld(['resolve_hole]) (myth/sing system_vocabulary/op (namespace_op cooperate/resolve_hole))]
         [root.weld(['finish]) (myth/sing system_vocabulary/op (namespace_op cooperate/finish))]]
    % remaining=row[[path myth]] operations next=namespace state
    ^ either[pail namespace]
    ?> (./some hit) remaining.pull (./ok next)
    = [entry rest] hit
    = [name record] entry
    ? (grove_install/change name (writ/make record) next)
     > (./err why) (./err (cooperate_mount/failure why))
     > (./ok installed) (_ rest installed)
