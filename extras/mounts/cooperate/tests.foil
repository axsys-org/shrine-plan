- cooperate
- cooperate_mount
- helm
- testing
- tests/namespace [at=fixture]

+ harness_tests
  + doc
    ^ path
    [($x 17) 'user 'document]
  + input
    ^ path
    [($x 17) 'user 'document 'inputs 'numbers]
  + run
    ^ path
    [($x 17) 'user 'document 'work 'first]
  + get
    \ name=path state=namespace
    ^ myth
    | (sovereign_care .x name state).fil.fall(myth/new)
  + apply
    \ operation=iota target=path input=myth state=namespace
    ^ namespace
    = [next index reply]
        | helm/supervisor/admit
          (namespace_command/plan target [state.self 'gov 'cooperate operation] input)
          state (sovereign_hive state)
    next
  + seed
    ^ namespace
    = initial (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
      [state index reply]
        | helm/supervisor/steps
          [[harness_tests/doc (writ/make (myth/sing system_vocabulary/content (pails/t "A document")))]
           [harness_tests/input (writ/make (myth/sing ['amount] (pails/n 10)))]]
          0 0 initial (sovereign_hive initial)
    ? (cooperate_mount/install state)
     > (./ok next) next
    state
  + request
    ^ myth
    | (myth/sing ['id] (pails/t "first")).put(['content] (pails/t "Investigate these inputs")).put(['context 'numbers] (safe 0 .x harness_tests/input))
  + edit
    \ value=nat state=namespace
    ^ namespace
    = [next index reply]
        | helm/supervisor/step harness_tests/input
          (writ/poke (myth/sing ['amount] (pails/n value)))
          0 0 state (sovereign_hive state)
    next
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = seed harness_tests/seed
      opened (harness_tests/apply 'open harness_tests/doc harness_tests/request seed)
      retry (harness_tests/apply 'open harness_tests/doc harness_tests/request opened)
      collision (harness_tests/apply 'open harness_tests/doc ((harness_tests/request).put(['content] (pails/t "Different"))) opened)
      event (myth/sing ['id] (pails/t "step")).put(['kind] (pails/t "observation")).put(['content] (pails/t "Read the input"))
      appended (harness_tests/apply 'append harness_tests/run event opened)
      finish (myth/sing ['id] (pails/t "done")).put(['content] (pails/t "Result"))
      complete (harness_tests/apply 'finish harness_tests/run finish appended)
      repeated (harness_tests/apply 'finish harness_tests/run finish complete)
      late (harness_tests/apply 'append harness_tests/run (event.put(['id] (pails/t "late"))) complete)
    [(testing/nat "open arguments recognized" 1 (cooperate/arguments "open" harness_tests/request))
     (testing/text "document seeded" "A document" (harness_tests/get harness_tests/doc seed).txt_at(system_vocabulary/content))
     (testing/text "work opens" "open" (harness_tests/get harness_tests/run opened).txt_at((cooperate/key ($x 17) 'status)))
     (testing/nat "retry makes no event" opened.local.top retry.local.top)
     (testing/nat "changed payload cannot reuse id" 1 (equal collision opened))
     (testing/text "trace content" "Read the input" (harness_tests/get ((harness_tests/run).weld(['trace 'step])) appended).txt_at(system_vocabulary/content))
     (testing/text "work completes" "complete" (harness_tests/get harness_tests/run complete).txt_at((cooperate/key ($x 17) 'status)))
     (testing/nat "completion retry is idempotent" 1 (equal complete repeated))
     (testing/nat "closed work rejects new events" 1 (equal complete late))]
  + capture
    \ ignored=unit
    ^ row[testing/check]
    = opened (harness_tests/apply 'open harness_tests/doc harness_tests/request harness_tests/seed)
      changed (harness_tests/edit 20 opened)
      frozen (harness_tests/get (row/cons[iota] 'x ((harness_tests/run).weld(['context 'numbers]))) changed)
      checked (harness_tests/get (row/cons[iota] 'x ((harness_tests/run).weld(['checks 'numbers]))) changed)
      reverted (harness_tests/edit 10 changed)
      equal_value (harness_tests/get (row/cons[iota] 'x ((harness_tests/run).weld(['checks 'numbers]))) reverted)
      finish (myth/sing ['id] (pails/t "done")).put(['content] (pails/t "Result"))
      refused (harness_tests/apply 'finish harness_tests/run finish changed)
      reverted_refused (harness_tests/apply 'finish harness_tests/run finish reverted)
      parent (safe 0 .x harness_tests/run)
      fresh ((harness_tests/request).put(['id] (pails/t "second"))).put(['parent] parent)
      branched (harness_tests/apply 'open harness_tests/doc fresh changed)
      branch ((harness_tests/doc).weld(['work 'second]))
      link (harness_tests/get branch branched).pail_at((cooperate/key ($x 17) 'parent))
      linked
        ? link
         > s=safe (and (gt s.ver 0) (equal[path] s.path harness_tests/run))
        .false
      closed (harness_tests/apply 'finish branch finish branched)
    [(testing/nat "frozen context retains original value" 10 frozen.nat_at(['amount] 0))
     (testing/nat "check reports changed value" 1 (equal[pail] (pails/b .false) checked.pail_at(['unchanged])))
     (testing/nat "stale completion changes nothing" 1 (equal changed refused))
     (testing/nat "reverted value compares equal" 1 (equal[pail] (pails/b .true) equal_value.pail_at(['unchanged])))
     (testing/nat "reverted direct revision still refuses completion" 1 (equal reverted reverted_refused))
     (testing/nat "parent edge is pinned" 1 linked)
     (testing/text "fresh branch can finish" "complete" (harness_tests/get branch closed).txt_at((cooperate/key ($x 17) 'status)))]
  + refusal
    \ ignored=unit
    ^ row[testing/check]
    = state harness_tests/seed
      missing ((harness_tests/request).put(['context 'numbers] (safe 0 .x [($x 17) 'missing])))
      refused (harness_tests/apply 'open harness_tests/doc missing state)
      escape ((harness_tests/request).put(['id] (pails/t "bad/path")))
      escaped (harness_tests/apply 'open harness_tests/doc escape state)
      oversized ((harness_tests/request).put(['content] (pails/t (str/repeat 16385 "a"))))
      too_long (cooperate/open harness_tests/doc oversized state)
      extra ((harness_tests/request).put(['unknown] (pails/t "unexpected")))
      unknown (cooperate/open harness_tests/doc extra state)
      aliases
        | (row/range 0 17).fold harness_tests/request
          \ input=myth n=nat
          | input.put(['context ($ts (str/cat_all ["alias" (nat/show n)]))] (safe 0 .x harness_tests/input))
      too_many (cooperate/open harness_tests/doc aliases state)
    [(testing/nat "missing context creates no partial work" 1 (equal state refused))
     (testing/nat "work id cannot escape document" 1 (equal state escaped))
     (testing/nat "content budget refuses" 1 (equal too_long (either/err[iota row[[p=path q=writ]]] 'content_limit)))
     (testing/nat "unknown arguments refuse" 1 (equal unknown (either/err[iota row[[p=path q=writ]]] 'invalid_work_arguments)))
     (testing/nat "alias budget refuses" 1 (equal too_many (either/err[iota row[[p=path q=writ]]] 'context_input_limit)))]

+ tests
  ^ row[testing/case]
  [(testing/case "document work lifecycle" harness_tests/lifecycle)
   (testing/case "frozen context, staleness and branching" harness_tests/capture)
   (testing/case "bounded atomic refusal" harness_tests/refusal)]
