- namespace_command
- weft_std
- json

' Shared native work records. Providers produce evidence; domain operations
' decide whether that evidence may change a document or another destination.
+ native_work
  + captured
    : source=safe observed=maybe[nat] value=pin[axal[myth]]
  + activity
    : owner=path kind=str status=str sequence=nat head=maybe[path]
  + event
    : activity=path kind=str previous=maybe[path]
  + request
    : owner=path prompt=str schema=str guard=safe
  + outcome
    : status=str text=str guard=pin[native_work/captured]
  + provider
    : start={\ path native_work/request}myth
  + hole
    : owner=path subject=path context=safe question=str shape=str
  + hole_state
    : observed=maybe[pin[axal[myth]]] generation=nat attempt=maybe[path]
  + lens_view
    ' A live, explicitly selected namespace view. Attempts freeze its reading,
    ' not its references. Named secondary bindings work just like other cells.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    = focus context.pail_at(['work 'focus])
      name=iota
        ?> value=pails/q focus 'subject
        value.q
    | context.tap.fold ((native_work/empty).rep([name] input))
      \ out=axal[myth] entry
      ? !(pith_prefix ['views] entry.key) out
      ?> view=cell_view entry.val out
      | out.rep(entry.key.drop(1) (unpin view.tree))
  + lens
    \ source=safe focus=iota bindings=row[[path safe]]
    ^ myth
    = record (myth/sing bond/tack source).put(bond/weft (spun native_work/lens_view .none)).put(['work 'focus] (pails/q focus))
    | bindings.fold record (\ out=myth [name reference] out.put(name reference))
  + retain_hole
    ' Stable subject-owned demand; a new attempt changes the head, never the
    ' older attempt's captures or result. A different owner cannot adopt it.
    \ target=path config=native_work/hole observed=pin[axal[myth]] attempt=path current=myth
    ^ either[iota myth]
    = prior=native_work/hole_state (native_work/hole_state .none 0 .none)
      prior
        ?> (./some held) current.get(['work 'hole_state]) prior
        ?> saved=native_work/hole_state held prior
        saved
    ? current.get(['work 'hole])
     > (./some held)
      ?> saved=native_work/hole held (./err 'work_hole_collision)
      ? !(and (equal[path] saved.owner config.owner) (and (equal[path] saved.subject config.subject) (equal[safe] saved.context config.context))) (./err 'work_hole_collision)
      | native_work/retained target config observed attempt prior current
    ? (gt current.tap.len 0) (./err 'work_hole_collision)
    | native_work/retained target config observed attempt prior (native_work/open config.subject "hole" myth/new)
  + retained
    \ target=path config=native_work/hole observed=pin[axal[myth]] attempt=path prior=native_work/hole_state current=myth
    ^ either[iota myth]
    = generation (? (equal[maybe[path]] prior.attempt (./some attempt)) prior.generation prior.generation.inc)
      progress (native_work/hole_state (./some observed) generation (./some attempt))
      deps (crew/sing ['context] (dep config.context.care config.context.path))
      current (? (equal[maybe[path]] prior.attempt (./some attempt)) current (native_work/append attempt current))
      record (native_work/status "waiting" current).put(['work 'hole] config).put(['work 'hole_state] progress)
      record record.put(['work 'reason] (pails/t "Waiting for a result or changed evidence")).put(['work 'attempt] (pails/p attempt))
      record record.put(['work 'question] (pails/t config.question)).put(['work 'shape] (pails/t config.shape))
      record record.put(['work 'owner] (pails/p config.owner)).put(['work 'subject] (pails/p config.subject)).put(['work 'context] config.context)
      record record.put(['work 'generation] (pails/n generation))
      record record.put(system_vocabulary/lede (pails/t config.question)).put(system_vocabulary/content (pails/t config.question))
    | ./ok record.put(limb_slot (kook [[target.at(0) 'gov 'cooperate 'hole_hand]])).put(crew_slot (cpail deps))
  + hole_advance
    \ b=bowl record=myth
    ^ yell
    ?> (./some held) record.get(['work 'hole]) (yell [] record)
    ?> config=native_work/hole held (yell [] record)
    ?> (./some held) record.get(['work 'hole_state]) (yell [] record)
    ?> progress=native_work/hole_state held (yell [] record)
    = seen b.crew.gut(['context] native_work/empty)
    ' Missing evidence is still unresolved. Empty output when a flow is no
    ' longer pending must not reopen a just-completed hole or form a cycle.
    ? !(seen.wyt) (yell [] record)
    ? (equal[maybe[pin[axal[myth]]]] progress.observed (./some (pin seen))) (yell [] record)
    = progress progress.set_observed((./some (pin seen))).set_generation(progress.generation.inc)
      next (native_work/status "ready" record).put(['work 'hole_state] progress)
      next next.put(['work 'generation] (pails/n progress.generation))
      next next.put(['work 'reason] (pails/t "Context changed; ready to resume"))
    | yell [[config.owner (writ/poke (myth/sing ['work 'resume] (pails/p b.here)))]] next
  + hole_hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | native_work/hole_advance b record
  + hole_talk
    \ b=bowl record=myth input=myth
    ^ yell
    = next record.meld(input)
    | native_work/hole_advance b (native_work/status next.txt_at(['work 'status]) next)
  + hole_form
    ^ form
    | def_form.set_init(native_work/wake).set_hear(native_work/hole_hear).set_talk(native_work/hole_talk)
  + hole_result
    \ target=path status=str reason=str
    ^ [p=path q=writ]
    | [target (writ/poke (myth/sing ['work 'status] (pails/t status)).put(['work 'reason] (pails/t reason)))]
  + only_holes
    ' Unwritten subjects may already own demand annotations. These two known
    ' records are the only pre-existing content a document writer may adopt.
    \ subject=path tree=axal[myth]
    ^ bool
    | tree.tap.all
      \ [name record]
      = root=path
          ? record.has(['work 'hole]) name
          ? (and (gt name.len 0) (eq_iota name.at(name.len.dec) 'context)) name.take(name.len.dec)
          []
      ?> (./some held) tree.get(root).fall(myth/new).get(['work 'hole]) .false
      ?> hole=native_work/hole held .false
      = relative hole.subject.drop(subject.len)
      ? !(pith_prefix subject hole.subject) .false
      ? !(equal[path] root.take(relative.len) relative) .false
      ? !(and (eq root.len (add relative.len 3)) (eq_iota root.at(relative.len) 'holes)) .false
      | equal[safe] hole.context (safe 0 .z (row/cons[iota] 'x (row/snoc[iota] 'context subject.weld(root))))
  + text_schema
    \ names=row[str]
    ^ str
    = string (json/obj [(jkv "type" (json/str "string"))])
    | show (json/obj [(jkv "type" (json/str "object"))
        (jkv "properties" (json/obj (names.map((\ name (jkv name string))))))
        (jkv "required" (json/arr (names.map((\ name (json/str name))))))
        (jkv "additionalProperties" (json/boo .false))])
  + empty
    ^ axal[myth]
    | axal/new[myth] .none
  + wake
    ' init sees the previous record's crew. A self-poke hydrates the installed
    ' crew, including dependencies that already exist and will not emit news.
    \ b=bowl record=myth
    ^ yell
    | yell [[b.here (writ/poke myth/new)]] record
  + open
    \ owner=path kind=str record=myth
    ^ myth
    | record.put(['work 'activity] (native_work/activity owner kind "open" 0 .none)).put(['work 'status] (pails/t "open"))
  + state
    \ record=myth
    ^ maybe[native_work/activity]
    ?> (./some held) record.get(['work 'activity]) .none
    ?> activity=native_work/activity held .none
    | ./some activity
  + status
    \ status=str record=myth
    ^ myth
    ?> (./some activity) (native_work/state record) record
    | record.put(['work 'activity] activity.set_status(status)).put(['work 'status] (pails/t status))
  + append
    \ event=path record=myth
    ^ myth
    ?> (./some activity) (native_work/state record) record
    | record.put(['work 'activity] activity.set_sequence(activity.sequence.inc).set_head((./some event)))
  + active
    \ record=myth
    ^ bool
    ?> (./some activity) (native_work/state record) .false
    | ((eq activity.status "open") || (eq activity.status "running"))
  + settled
    ' For an attempt, waiting means its result did not satisfy the demand.
    ' The subject's hole may remain waiting while that attempt is settled.
    \ record=myth
    ^ bool
    ?> (./some activity) (native_work/state record) .false
    | !(native_work/active record)
  + attempt
    \ owner=path kind=str captured=native_work/captured record=myth
    ^ myth
    | native_work/open owner kind record.put(['capture] captured)
  + start_provider
    \ target=path request=native_work/request provider=native_work/provider
    ^ myth
    = make provider.start
    | (make target request).put(['work 'request] request)
  + dispatch
    ' Claim the attempt and create its worker in one native card batch. The
    ' request is the durable dispatch receipt; no controller-local sent flag.
    \ worker=path request=native_work/request provider=native_work/provider record=myth
    ^ either[iota [myth row[[p=path q=writ]]]]
    ? record.get(['work 'request])
     > (./some held)
      ? (equal[pail] held request) (./ok [record []])
      | ./err 'work_request_conflict
    ? !(native_work/active record) (./err 'work_not_open)
    = next (native_work/status "running" record).put(['work 'request] request)
    | ./ok [next [[worker (writ/make (native_work/start_provider worker request provider))]]]
  + outcome_at
    \ tree=axal[myth]
    ^ maybe[native_work/outcome]
    ?> (./some held) tree.fil.fall(myth/new).get(['work 'outcome]) .none
    ?> outcome=native_work/outcome held .none
    | ./some outcome
  + check_outcome
    ' Providers finish execution. A domain still decides whether this outcome
    ' satisfies its task and whether its proposed changes may be admitted.
    \ outcome=native_work/outcome guard=axal[myth]
    ^ either[iota unit]
    ? !(eq outcome.status "complete") (./err 'work_provider_failed)
    ?> (./some captured) (native_work/captured_at guard) (./err 'work_guard_unavailable)
    ? !(equal[pin[native_work/captured]] (pin captured) outcome.guard) (./err 'work_stale_guard)
    | ./ok []
  + settle
    \ status=str reason=str record=myth
    ^ myth
    | (native_work/status status record).put(['work 'reason] (pails/t reason))
  + interrupted
    \ target=path guard=pin[native_work/captured] record=myth
    ^ maybe[yell]
    ? record.has(['work 'outcome]) .none
    | ./some (native_work/result target
        (native_work/outcome "failed" "Provider connection ended at world restart; attempt retained and not replayed" guard) record)
  + event_record
    \ owner=path kind=str current=myth record=myth
    ^ myth
    = previous=maybe[path]
        ?> (./some activity) (native_work/state current) .none
        activity.head
    | record.put(['work 'event] (native_work/event owner kind previous))
  + traces
    \ target=path values=row[[iota pin[axal[myth]]]] record=myth
    ^ [myth row[[p=path q=writ]]]
    % todo=row[[iota pin[axal[myth]]]] values current=myth record writes=row[[p=path q=writ]] []
    ^ [myth row[[p=path q=writ]]]
    ?> (./some pair) todo.pull [current writes]
    = [entry rest] pair
      [name value] entry
      event=path target.weld(['trace name])
      body (native_work/event_record target "evaluation" current (native_work/value target.at(0) value))
    | _ rest (native_work/append event current) writes.snoc([event (writ/make body)])
  + snapshot
    \ context=myth ignored=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some held) context.get(['capture]) [context native_work/empty]
    ?> saved=native_work/captured held [context native_work/empty]
    | [context (unpin saved.value)]
  + frozen
    \ target=path saved=native_work/captured
    ^ myth
    | (myth/sing ['capture] saved).put(['source] (pails/p saved.source.path)).put(['source_case] (pails/n saved.source.ver)).put(['source_care] (pails/q (care/seg saved.source.care))).put(['observed_case] (pails/n saved.observed.fall(0))).put(bond/weft (cell native_work/snapshot)).put(bond/tack (safe 1 .x [target.at(0) 'gov 'cooperate 'empty]))
  + value
    \ self=iota value=pin[axal[myth]]
    ^ myth
    = source (safe 1 .x [self 'gov 'cooperate 'empty])
    | native_work/frozen source.path (native_work/captured source .none value)
  + current
    \ saved=native_work/captured state=namespace
    ^ bool
    ? saved.source.ver .true
    ? !(equal[maybe[nat]] saved.observed (state.case(saved.source.care saved.source.path))) .false
    ?> (./known now) (sovereign_view saved.source.care 0 saved.source.path state) .false
    | equal[axal[myth]] now (unpin saved.value)
  + capture_view
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> (./some held) context.get(bond/tack) native_work/empty
    ?> source=safe held native_work/empty
    = version context.nat_at(['sys 'tack 'case] 0)
      saved (native_work/captured source (? version (./some version) .none) (pin input))
    | axal/new[myth] (./some (myth/sing ['capture] saved))
  + watching
    \ source=safe
    ^ myth
    | (myth/sing bond/tack source).put(bond/weft (spun native_work/capture_view .none))
  + captured_at
    \ tree=axal[myth]
    ^ maybe[native_work/captured]
    ?> (./some held) tree.fil.fall(myth/new).get(['capture]) .none
    ?> saved=native_work/captured held .none
    | ./some saved
  + result
    \ target=path outcome=native_work/outcome record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    = value (native_work/empty).put([] (myth/sing ['work 'outcome] outcome))
      next (native_work/status outcome.status record).put(['work 'outcome] outcome)
    | yell [[target.snoc('result) (writ/make (native_work/value target.at(0) (pin value)))]] next
