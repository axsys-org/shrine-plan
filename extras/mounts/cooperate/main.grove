#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import content=sys/content

status =
  @slot

sequence =
  @slot

document =
  @slot

head =
  @slot

result =
  @slot

parent =
  @slot

kind =
  @slot

work =
  @slot

reply_to =
  @slot

artifact =
  @slot

request =
  @slot

run =
  @role
  content: text
  %/status: text
  %/document: path_type
  #opt ;
    %/head: path_type
    %/result: path_type

entry =
  @role
  content: text
  %/kind: text
  %/work: path_type

activity =
  @role
  "/work/status": text
  #opt ;
    "/work/reason": text

activity_status =
  @view
  #on ; %/activity
  #for ; /sys/slot/work_status
  activity => col {
    show(activity.status, '/sys/slot/label)
    show(activity.reason, '/sys/slot/content)
  }
