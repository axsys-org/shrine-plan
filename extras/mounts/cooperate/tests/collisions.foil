- cooperate_ops
- helm
- testing
- tests/cooperate [at=harness]

+ collision_tests
  + put
    \ name=path value=nat state=namespace
    ^ namespace
    = [next index reply]
        | helm/supervisor/step name (writ/make (myth/sing ['sentinel] (pails/n value)))
          0 0 state (sovereign_hive state)
    next
  + refuses
    \ expected=iota result=either[iota row[[p=path q=writ]]]
    ^ bool
    ? result
     > (./err found) (eq_iota expected found)
    .false
  + finish
    ^ myth
    | (myth/sing ['id] (pails/t "done")).put(['content] (pails/t "Finished"))
  + lens
    \ ignored=unit
    ^ row[testing/check]
    = before harness/harness_tests/seed
      doc=path harness/harness_tests/doc
      run=path harness/harness_tests/run
      input=path harness/harness_tests/input
      request harness/harness_tests/request
      collision request.put(['context 'subject] (safe 0 .x input))
      after (harness/harness_tests/apply 'open doc collision before)
      opened (harness/harness_tests/apply 'open doc request before)
      changed (harness/harness_tests/edit 20 opened)
      view (sovereign_care .z (row/cons[iota] 'x run.snoc('lens)) changed)
      captured (sovereign_care .x (row/cons[iota] 'x run.weld(['context 'numbers])) changed)
      reference (safe 0 .x input)
    [(testing/nat "context alias cannot replace the investigation subject" 1
       (collision_tests/refuses 'invalid_context_alias (cooperate_ops/open doc collision before)))
     (testing/nat "refused alias changes no world state" 1 (equal[namespace] before after))
     (testing/text "lens retains its primary document beside live evidence" "A document"
       view.get(['subject]).fall(myth/new).txt_at(system_vocabulary/content))
     (testing/nat "distinct context alias follows live evidence" 20 view.get(['numbers]).fall(myth/new).nat_at(['amount] 0))
     (testing/nat "the original attempt keeps frozen evidence" 10 captured.fil.fall(myth/new).nat_at(['amount] 0))
     (testing/nat "lens refuses overlapping secondary coordinates" 0
       (native_work_ops/lens_bindings 'subject [[['evidence] reference] [['evidence 'nested] reference]]))
     (testing/nat "lens refuses constructor coordinate replacement" 0
       (native_work_ops/lens_bindings 'subject [[bond/tack reference]]))]
  + open
    \ ignored=unit
    ^ row[testing/check]
    = doc=path harness/harness_tests/doc
      request ((harness/harness_tests/request).put(['id] (pails/t "occupied")))
      target=path doc.weld(['work 'occupied])
      child=path target.weld(['context 'numbers])
      before (collision_tests/put child 77 harness/harness_tests/seed)
      after (harness/harness_tests/apply 'open doc request before)
    [(testing/nat "structural work root has no record" 1
       (maybe/is_none (cooperate_ops/record target before)))
     (testing/nat "open refuses an occupied structural destination" 1
       (collision_tests/refuses 'work_id_exists (cooperate_ops/open doc request before)))
     (testing/nat "refused open preserves all state" 1 (equal before after))]
  + append
    \ ignored=unit
    ^ row[testing/check]
    = doc=path harness/harness_tests/doc
      run=path harness/harness_tests/run
      opened (harness/harness_tests/apply 'open doc harness/harness_tests/request harness/harness_tests/seed)
      child=path run.weld(['trace 'occupied 'context 'numbers])
      before (collision_tests/put child 88 opened)
      input (myth/sing ['id] (pails/t "occupied")).put(['kind] (pails/t "observation")).put(['content] (pails/t "Observation")).put(['context 'numbers] (safe 0 .x harness/harness_tests/input))
      after (harness/harness_tests/apply 'append run input before)
    [(testing/text "collision fixture run is open" "open"
       (harness/harness_tests/get run opened).txt_at((cooperate_ops/key ($x 17) 'status)))
     (testing/nat "append refuses an occupied structural destination" 1
       (collision_tests/refuses 'work_id_exists (cooperate_ops/append run input before)))
     (testing/nat "refused append preserves trace and head" 1 (equal before after))]
  + result
    \ ignored=unit
    ^ row[testing/check]
    = doc=path harness/harness_tests/doc
      run=path harness/harness_tests/run
      opened (harness/harness_tests/apply 'open doc harness/harness_tests/request harness/harness_tests/seed)
      result=path run.weld(['result])
      own (collision_tests/put result 99 opened)
      own_after (harness/harness_tests/apply 'finish run collision_tests/finish own)
      nested (collision_tests/put result.weld(['existing]) 100 opened)
      nested_after (harness/harness_tests/apply 'finish run collision_tests/finish nested)
      receipt (collision_tests/put run.weld(['commands 'done 'existing]) 101 opened)
      receipt_after (harness/harness_tests/apply 'finish run collision_tests/finish receipt)
    [(testing/nat "finish refuses an existing result record" 1
       (collision_tests/refuses 'result_exists (cooperate_ops/finish run collision_tests/finish own)))
     (testing/nat "refused finish preserves existing result and run" 1 (equal own own_after))
     (testing/nat "finish refuses a structural result subtree" 1
       (collision_tests/refuses 'result_exists (cooperate_ops/finish run collision_tests/finish nested)))
     (testing/nat "refused finish preserves result descendants" 1 (equal nested nested_after))
     (testing/nat "finish refuses an occupied structural receipt" 1
       (collision_tests/refuses 'work_id_exists (cooperate_ops/finish run collision_tests/finish receipt)))
     (testing/nat "receipt collision commits no partial result" 1 (equal receipt receipt_after))]

+ answering_allocation_tests
  + started
    ^ namespace
    = provider=path [($x 17) 'user 'provider]
      initial harness/harness_tests/seed
      [state index reply] (helm/supervisor/step provider (writ/make (myth/sing ['work 'provider] (native_work/provider harness/delegation_tests/provider))) 0 0 initial (sovereign_hive initial))
      input (myth/sing ['id] (pails/t "q1")).put(['content] (pails/t "What is the amount?"))
      input input.put(['context] (safe 0 .x harness/harness_tests/input)).put(['provider] (safe 0 .x provider))
    | harness/harness_tests/apply 'answer harness/harness_tests/doc input state
  + ownership
    ' These are real supervisor cascades, including probe hydration, provider
    ' dispatch and hole wakes. Each foreign location is independently occupied.
    \ ignored=unit
    ^ row[testing/check]
    = done (harness/answering_tests/reply (harness/answering_tests/json "10" "Captured amount") answering_allocation_tests/started)
      attempt (harness/answering_tests/attempt 2)
      old (harness/answering_tests/attempt 1)
      controller harness/answering_tests/controller
      locations=row[path] [[] ['child] ['worker] ['worker 'child]]
    | locations.bind
      \ suffix=path
      = target attempt.weld(suffix)
        occupied (collision_tests/put target 77 done)
        changed (harness/harness_tests/edit 20 occupied)
        [repeated repeat_index repeat_reply] (helm/supervisor/step controller (writ/poke myth/new) 0 0 changed (sovereign_hive changed))
        [released release_index release_reply] (helm/supervisor/step target .cull 0 0 repeated (sovereign_hive repeated))
        [duplicate duplicate_index duplicate_reply] (helm/supervisor/step controller (writ/poke myth/new) 0 0 released (sovereign_hive released))
        after (harness/harness_tests/get controller released)
        history (row/all[care] (\ car (equal (namespace/page car occupied.case(car target) target occupied) (namespace/page car occupied.case(car target) target duplicate))) [.x .y .z])
        retained (row/all[care] (\ car (equal (namespace/page car done.case(car old) old done) (namespace/page car done.case(car old) old duplicate))) [.x .y .z])
      [(testing/nat "foreign allocation remains current through evidence and duplicate wakes" 77 (harness/harness_tests/get target repeated).nat_at(['sentinel] 0))
       (testing/text "occupied allocation blocks the answering hand" "blocked" (harness/harness_tests/get controller changed).txt_at(['work 'status]))
       (testing/text "vacating the observed collision resumes the same hand" "running" after.txt_at(['work 'status]))
       (testing/nat "vacant allocation dispatches one worker" 1 (harness/harness_tests/get attempt.snoc('worker) released).has(['work 'request]))
       (testing/nat "duplicate wake does not replace the worker" released.case(.x attempt.snoc('worker)).fall(0) duplicate.case(.x attempt.snoc('worker)).fall(0))
       (testing/nat "foreign record x y z history survives release" 1 history)
       (testing/nat "earlier attempt x y z history survives retry" 1 retained)]

  + holes
    \ ignored=unit
    ^ row[testing/check]
    = done (harness/answering_tests/reply (harness/answering_tests/json "10" "Captured amount") answering_allocation_tests/started)
      original harness/answering_tests/hole
      hole original.snoc('rebound)
      old (harness/answering_tests/attempt 1)
      controller harness/answering_tests/controller
    ?> config=answering/config (harness/harness_tests/get controller done).pail_at(['answer 'config])
      [(testing/nat "answer fixture retains typed configuration" 1 0)]
    = [rebound rebind_index rebind_reply] (helm/supervisor/step controller
        (writ/poke (myth/sing ['answer 'config] config.set_hole(hole))) 0 0 done (sovereign_hive done))
      locations=row[path] [['annotation] ['context 'annotation]]
      collisions=row[testing/check]
        | locations.bind
          \ suffix=path
          = target hole.weld(suffix)
            occupied (collision_tests/put target 79 rebound)
            changed (harness/harness_tests/edit 20 occupied)
            [repeated repeat_index repeat_reply] (helm/supervisor/step controller (writ/poke myth/new) 0 0 changed (sovereign_hive changed))
            [released release_index release_reply] (helm/supervisor/step target .cull 0 0 repeated (sovereign_hive repeated))
            history (row/all[care] (\ car (equal (namespace/page car occupied.case(car target) target occupied) (namespace/page car occupied.case(car target) target released))) [.x .y .z])
            retained (row/all[care] (\ car (equal (namespace/page car done.case(car old) old done) (namespace/page car done.case(car old) old released))) [.x .y .z])
          [(testing/nat "rootless foreign hole descendants remain current" 79 (harness/harness_tests/get target repeated).nat_at(['sentinel] 0))
           (testing/nat "foreign descendants do not acquire a new owning hole" 0 (sovereign_care .x hole repeated).wyt)
           (testing/text "rootless hole blocks answer retry" "blocked" (harness/harness_tests/get controller repeated).txt_at(['work 'status]))
           (testing/nat "blocked hole creates no next attempt" 0 (sovereign_care .z (harness/answering_tests/attempt 2) repeated).wyt)
           (testing/text "releasing the last foreign descendant resumes through native crew" "running" (harness/harness_tests/get controller released).txt_at(['work 'status]))
           (testing/nat "foreign descendant x y z history is retained" 1 history)
           (testing/nat "old answer attempt x y z history is retained" 1 retained)]
      annotation original.snoc('annotation)
      owned (collision_tests/put annotation 81 done)
      advanced (harness/harness_tests/edit 20 owned)
      preserved (row/all[care] (\ car (equal (namespace/page car owned.case(car annotation) annotation owned) (namespace/page car owned.case(car annotation) annotation advanced))) [.x .y .z])
    | collisions.weld
      [(testing/text "owned annotated hole may advance" "running" (harness/harness_tests/get controller advanced).txt_at(['work 'status]))
       (testing/nat "owned hole retains current annotation" 81 (harness/harness_tests/get annotation advanced).nat_at(['sentinel] 0))
       (testing/nat "owned hole annotation history remains" 1 preserved)]

+ tests
  ^ row[testing/case]
  [(testing/case "work destination collisions" collision_tests/open)
   (testing/case "context lens ownership" collision_tests/lens)
   (testing/case "trace destination collisions" collision_tests/append)
   (testing/case "result and receipt collisions" collision_tests/result)
   (testing/case "answering claims only observed vacant subtrees" answering_allocation_tests/ownership)
   (testing/case "answering retains owned holes and refuses orphan descendants" answering_allocation_tests/holes)]
