- semidoc
- cooperate_ops

' Shared Semidoc flow compiler. Only explicitly marked regions are executable.
' Operations are ordinary published Foil laws; values travel as namespace trees.
' Structured metadata stays in typed values rather than a slot per struct field.
- flow

+ flow_ops
  + key
    \ self=iota name=iota
    ^ path
    [self 'gov 'flows name]
  + empty
    ^ axal[myth]
    | axal/new[myth] .none
  + children
    \ node=snode
    ^ row[snode]
    ? node
     > (./doc _ _ kids) kids
     > (./sect _ _ kids) kids
     > (./item _ _ kids) kids
     > (./quote _ _ kids) kids
    []
  + flatten
    \ nodes=row[snode]
    ^ row[snode]
    = me (_)
    | nodes.bind (\ node=snode (row/cons[snode] node (me (flow_ops/children node))))
  + attributes
    \ name=nat node=snode
    ^ row[sattr]
    | (attrs_of node).keep((\ a=sattr (equal[row[nat]] a.pred ["flow" name])))
  + valid_path
    \ parts=row[nat]
    ^ bool
    = parts (? (and parts.len (eq parts.at(0) ".")) parts.drop(1) parts)
    | parts.all((\ part=nat (maybe/is_some (path_parse (str/cat_all ["/" (str/from_atom part)])))))
  + valid_value
    \ value=sval
    ^ bool
    ? value
     > (./ref parts) (flow_ops/valid_path parts)
    .true
  + valid_document
    \ text=str
    ^ bool
    | (flow_ops/flatten (parse (str/to_atom text))).all
      \ node=snode
      = own=row[nat]
          ? node
           > (./doc id _ _) id
           > (./ref path _) path
          []
      | and (flow_ops/valid_path own)
        ((attrs_of node).all((\ attr=sattr (and (flow_ops/valid_path attr.pred) (attr.vals.all(flow_ops/valid_value))))))
  + one
    \ name=nat node=snode
    ^ either[iota row[sval]]
    = found (flow_ops/attributes name node)
    ? !(eq found.len 1) (./err 'flow_attribute_count)
    | ./ok found.at(0).vals
  + name
    \ value=sval
    ^ either[iota iota]
    ?> (./word word) value (./err 'flow_name_required)
    = text (str/from_atom word)
    ? ((eq text.len 0) || (gt text.len 64)) (./err 'flow_invalid_name)
    ?> (./some symbol) (str/sym text) (./err 'flow_invalid_name)
    | ./ok ($ts word)
  + names
    \ values=row[sval]
    ^ either[iota row[iota]]
    % todo=row[sval] values out=row[iota] []
    ^ either[iota row[iota]]
    ?> (./some pair) todo.pull (./ok out)
    = [value rest] pair
    < name (flow_ops/name value)
    ? (out.any((\ x (eq_iota x name)))) (./err 'flow_duplicate_name)
    | _ rest out.snoc(name)
  + has
    \ name=iota names=row[iota]
    ^ bool
    | names.any((\ x (eq_iota x name)))
  + bind
    \ available=row[iota] attrs=row[sattr]
    ^ either[iota row[flow/binding]]
    % todo=row[sattr] attrs out=row[flow/binding] []
    ^ either[iota row[flow/binding]]
    ?> (./some pair) todo.pull (./ok out)
    = [attr rest] pair
    ? !(eq attr.vals.len 2) (./err 'flow_invalid_binding)
    < port (flow_ops/name attr.vals.at(0))
    < value (flow_ops/name attr.vals.at(1))
    ? !(flow_ops/has value available) (./err 'flow_unbound_value)
    ? (out.any((\ b=flow/binding (eq_iota b.port port)))) (./err 'flow_duplicate_port)
    | _ rest out.snoc((flow/binding port value))
  + is_region
    \ id=iota node=snode
    ^ bool
    = attrs (flow_ops/attributes "definition" node)
    ? !(eq attrs.len 1) .false
    ? !(eq attrs.at(0).vals.len 1) .false
    ? (flow_ops/name attrs.at(0).vals.at(0))
     > (./ok name) (eq_iota name id)
    .false
  + unknown_attribute
    \ attr=sattr
    ^ bool
    = allowed=row[nat] ["input" "step" "bind" "result" "page" "uses"]
    !(row/any[nat] (\ name=nat (equal[row[nat]] attr.pred ["flow" name])) allowed)
  + ports_match
    \ ports=row[iota] bindings=row[flow/binding]
    ^ bool
    | and (eq ports.len bindings.len)
      (row/all[iota] (\ port=iota (row/any[flow/binding] (\ b=flow/binding (eq_iota b.port port)) bindings)) ports)
  + compile
    \ id=iota source=safe text=str state=namespace
    ^ either[iota flow/definition]
    ? (gt text.len 65536) (./err 'flow_source_limit)
    ? !(flow_ops/valid_document text) (./err 'flow_invalid_document_path)
    = nodes (flow_ops/flatten (parse (str/to_atom text)))
      regions (nodes.keep((\ node=snode (gt (flow_ops/attributes "definition" node).len 0))))
    = selected regions.keep((flow_ops/is_region id))
    ? !(eq selected.len 1) (./err 'flow_definition_not_unique)
    = region selected.at(0)
      body (flow_ops/flatten (flow_ops/children region))
    ? (gt body.len 512) (./err 'flow_node_limit)
    % todo=row[snode] body available=row[iota] ['document]
      inputs=row[iota] [] steps=row[flow/step] [] pages=axal[myth] flow_ops/empty result=maybe[iota] .none
    ^ either[iota flow/definition]
    ?> (./some pair) todo.pull (flow_ops/finish source text available inputs steps pages result)
    = [node rest] pair
      attrs (attrs_of node).keep((\ a=sattr (equal[row[nat]] a.pred.take(1) ["flow"])))
    ? (row/any[sattr] flow_ops/unknown_attribute attrs)
      | ./err 'flow_unknown_attribute
    = choices=row[nat] ["input" "step" "result" "page"]
      modes choices.keep((\ name=nat (gt (flow_ops/attributes name node).len 0)))
    ? (gt modes.len 1) (./err 'flow_conflicting_attributes)
    ? !(modes.len)
      ? attrs.len (./err 'flow_orphan_attribute)
      | _ rest available inputs steps pages result
    = mode modes.at(0)
    < vals (flow_ops/one mode node)
    ? (and (gt (flow_ops/attributes "bind" node).len 0) !(eq mode "step")) (./err 'flow_orphan_binding)
    ? (and (gt (flow_ops/attributes "uses" node).len 0) !(eq mode "page")) (./err 'flow_orphan_uses)
    ? (eq mode "input")
      ? !(eq vals.len 1) (./err 'flow_invalid_input)
      < name (flow_ops/name vals.at(0))
      ? (flow_ops/has name available) (./err 'flow_duplicate_name)
      ? (gt inputs.len 15) (./err 'flow_input_limit)
      | _ rest available.snoc(name) inputs.snoc(name) steps pages result
    ? (eq mode "result")
      ? ((maybe/is_some result) || !(eq vals.len 1)) (./err 'flow_invalid_result)
      < name (flow_ops/name vals.at(0))
      | _ rest available inputs steps pages (./some name)
    ? (eq mode "page")
      ?> (./sect title _ kids) node (./err 'flow_page_requires_section)
      ? !(eq vals.len 1) (./err 'flow_invalid_page)
      ?> (./word raw) vals.at(0) (./err 'flow_invalid_page)
      < parts (flow_ops/names ((split_byte 47 raw).map((\ word (sval/word word)))))
      = at=path (? (eq raw "/") [] parts)
      ? ((gt at.len 4) || (and !(at.len) !(eq raw "/"))) (./err 'flow_invalid_page)
      ? (row/any[iota] (\ name=iota (flow_ops/has name ['flows 'work 'inputs 'cells 'reference])) at) (./err 'flow_reserved_page)
      ? (pages.has(at)) (./err 'flow_duplicate_page)
      ? (gt pages.wyt 31) (./err 'flow_page_limit)
      = uses (flow_ops/attributes "uses" node)
      ? (gt uses.len 1) (./err 'flow_attribute_count)
      < names (flow_ops/names (? uses.len uses.at(0).vals []))
      = card (myth/sing ['flow 'page] (flow/page title kids names))
      | _ rest available inputs steps pages.put(at card) result
    ? !(eq vals.len 2) (./err 'flow_invalid_step)
    < name (flow_ops/name vals.at(0))
    ? (flow_ops/has name available) (./err 'flow_duplicate_name)
    ? (gt steps.len 15) (./err 'flow_step_limit)
    ?> (./ref ref) vals.at(1) (./err 'flow_operation_reference_required)
    = origin (safe 0 .x (seg_iotas ref))
    < origin (cooperate_ops/pin_link origin state)
    ?> (./some held) (cooperate_ops/record origin.path state).fall(myth/new).get((flow_ops/key state.self 'operation))
      | ./err 'flow_unknown_operation
    ?> law=flow/operation held (./err 'flow_invalid_operation)
    < bindings (flow_ops/bind available (flow_ops/attributes "bind" node))
    ? !(flow_ops/ports_match law.ports bindings)
      | ./err 'flow_port_mismatch
    | _ rest available.snoc(name) inputs steps.snoc((flow/step name origin (pin law) bindings)) pages result
  + finish
    \ source=safe text=str available=row[iota] inputs=row[iota] steps=row[flow/step] pages=axal[myth] result=maybe[iota]
    ^ either[iota flow/definition]
    ?> (./some output) result (./err 'flow_missing_result)
    ? !(flow_ops/has output available) (./err 'flow_unbound_result)
    ? !(steps.len) (./err 'flow_no_steps)
    | ./ok (flow/definition source text inputs steps (pin pages) output)
  + bounded
    \ tree=axal[myth]
    ^ bool
    | and (le tree.wyt 256) (le (cooperate_ops/bytes tree) 2097152)
  + evaluate
    \ definition=flow/definition values=axal[axal[myth]]
    ^ either[iota flow/evaluation]
    | flow_ops/evaluate_with definition values flow_ops/empty
  + resolve
    \ step=iota tasks=axal[myth] answers=axal[myth]
    ^ either[iota axal[myth]]
    % todo=row[[p=path q=myth]] tasks.tap ready=axal[myth] flow_ops/empty missing=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull
      | ./ok (? missing.wyt (axal/new[myth] (./some (myth/sing ['flow 'pending] (flow/pending step (pin missing) (pin ready))))) ready)
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'task]) (./err 'flow_invalid_task)
    ?> task=flow/task held (./err 'flow_invalid_task)
    = answer=maybe[flow/resolution]
        ?> (./some held) answers.get((row/cons[iota] step name)).fall(myth/new).get(['flow 'resolution]) .none
        ?> answer=flow/resolution held .none
        ? !(equal[flow/task] task (unpin answer.task)) .none
        | ./some answer
    ? answer
     > (./some result) (_ rest ready.put(name (myth/sing ['flow 'page] result.page).put(['flow 'resolution] result)) missing)
    | _ rest ready missing.put(name card)
  + evaluate_with
    \ definition=flow/definition values=axal[axal[myth]] answers=axal[myth]
    ^ either[iota flow/evaluation]
    ? !(definition.inputs.all((\ name values.has([name])))) (./err 'flow_missing_input)
    ? !(eq values.wyt definition.inputs.len) (./err 'flow_extra_input)
    % todo=row[flow/step] definition.steps env=axal[axal[myth]] values.put(['document] (unpin definition.pages))
      trace=row[flow/event] []
    ^ either[iota flow/evaluation]
    ?> (./some pair) todo.pull
      | ./ok (flow/evaluation (pin env.gut([definition.result] flow_ops/empty)) trace)
    = [step rest] pair
      args step.bindings.fold(flow_ops/empty
        (\ tree binding tree.rep([binding.port] env.gut([binding.value] flow_ops/empty))))
      run (unpin step.law).run
    < computed (run args)
    = value=either[iota axal[myth]]
        ?> (./some held) computed.fil.fall(myth/new).get(['flow 'judgment]) (./ok computed)
        ?> judgment=flow/judgment held (./err 'flow_invalid_judgment)
        | flow_ops/resolve step.name (unpin judgment.tasks) answers
    < value value
    ? !(flow_ops/bounded value) (./err 'flow_output_limit)
    ? (value.fil.fall(myth/new).has(['flow 'pending]))
      | ./ok (flow/evaluation (pin value) trace.snoc((flow/event step.name (pin value))))
    | _ rest env.put([step.name] value) trace.snoc((flow/event step.name (pin value)))
