- flow_runtime
- flow_work

' A spun computes a proposal; a hand materializes it. Reads stay pure.
' Both manual and automatic writes share the destination writer's checks.
+ flow_maintenance
  + proposal
    : definition=pin[flow/definition] captures=row[flow_runtime/capture] output=flow/evaluation
  + candidate
    : result=either[iota flow_maintenance/proposal]
  + config
    : request=pin[myth] definition=path destination=path writer=pin[flow_runtime/writer] writer_origin=safe
      provider=maybe[pin[native_work/provider]]
  + progress
    : enabled=bool generation=nat observed=maybe[pin[axal[myth]]] before=pin[axal[myth]] reason=maybe[iota]
  + run
    : proposal=pin[flow_maintenance/proposal] before=pin[axal[myth]] writer_origin=safe
  + claims
    : entries=axal[path]
  + feed
    : source=safe value=pin[axal[myth]] fault=maybe[str]
  + overlaps
    \ left=path right=path
    ^ bool
    | ((pith_prefix left right) || (pith_prefix right left))
  + compute
    \ context=myth tree=axal[myth]
    ^ either[iota flow_maintenance/proposal]
    ?> (./some held) context.get(['flow 'config]) (./err 'flow_maintenance_config)
    ?> config=flow_maintenance/config held (./err 'flow_maintenance_config)
    = self config.definition.at(0)
    ?> (./some held) tree.fil.fall(myth/new).get((flow/key self 'definition)) (./err 'flow_missing_definition)
    ?> definition=flow/definition held (./err 'flow_invalid_definition)
    % todo=row[iota] definition.inputs values=axal[axal[myth]] (axal/new[axal[myth]] .none)
      captures=row[flow_runtime/capture] []
    ^ either[iota flow_maintenance/proposal]
    ?> (./some pair) todo.pull (flow_maintenance/evaluate_answers definition captures values context)
    = [name rest] pair
    < reference (cooperate/reference ['input name] context)
    ?> (./some held) context.get(['views 'input name]) (./err 'flow_missing_input)
    ?> view=cell_view held (./err 'flow_missing_input)
    = value (unpin view.tree)
    ? !(value.wyt) (./err 'flow_missing_input)
    ? !(flow/bounded value) (./err 'flow_input_limit)
    | _ rest values.put([name] value) captures.snoc((flow_runtime/capture name (native_work/captured reference .none view.tree)))
  + evaluate
    \ definition=flow/definition captures=row[flow_runtime/capture] values=axal[axal[myth]]
    ^ either[iota flow_maintenance/proposal]
    < output (flow/evaluate definition values)
    | ./ok (flow_maintenance/proposal (pin definition) captures output)
  + evaluate_answers
    \ definition=flow/definition captures=row[flow_runtime/capture] values=axal[axal[myth]] context=myth
    ^ either[iota flow_maintenance/proposal]
    = answers=axal[myth]
        ?> (./some held) context.get(['views 'resolutions]) flow/empty
        ?> view=cell_view held flow/empty
        | unpin view.tree
    < output (flow/evaluate_with definition values answers)
    | ./ok (flow_maintenance/proposal (pin definition) captures output)
  + derive
    \ context=myth input=axal[myth]
    ^ axal[myth]
    = result=either[iota flow_maintenance/proposal]
        ? (Try (flow_maintenance/compute context) input)
         > (./ok result) result
         > (./err _) (./err 'flow_evaluation_failed)
    = record (myth/sing ['flow 'candidate] (flow_maintenance/candidate result))
      record=myth
        ?> (./ok proposal) result record
        ?> (./some held) (unpin proposal.output.result).fil.fall(myth/new).get(['flow 'pending]) record
        ?> pending=flow/pending held record
        | record.put(['flow 'demands] (flow_work/candidate_view pending.step pending.tasks))
    | axal/new[myth] (./some record)
  + source_view
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> (./some held) context.get(['flow 'feed]) flow/empty
    ?> feed=flow_maintenance/feed held flow/empty
    ? (maybe/is_some feed.fault) flow/empty
    | unpin feed.value
  + candidate_of
    \ view=axal[myth]
    ^ either[iota flow_maintenance/proposal]
    ?> (./some held) view.fil.fall(myth/new).get(['flow 'candidate]) (./err 'flow_view_unavailable)
    ?> candidate=flow_maintenance/candidate held (./err 'flow_view_unavailable)
    candidate.result
  + failure_reason
    \ result=either[iota flow_maintenance/proposal]
    ^ iota
    ? result
     > (./err why) why
    'flow_view_unavailable
  + status
    \ record=myth progress=flow_maintenance/progress
    ^ myth
    = text=str
        ? !(progress.enabled) "Paused"
        ? progress.reason
         > (./some why) (str/cat_all ["Blocked: " (str/from_atom (quip_val why))])
        "Watching published definition and source inputs"
    | (native_work/status (? !(progress.enabled) "paused" (? (maybe/is_some progress.reason) "blocked" "running")) record).put(['flow 'progress] progress).put(system_vocabulary/content (pails/t text))
  + blocked
    \ record=myth progress=flow_maintenance/progress seen=axal[myth] before=axal[myth] why=iota
    ^ yell
    = next progress.set_observed((./some (pin seen))).set_before((pin before)).set_reason((./some why))
    | yell [] (flow_maintenance/status record next)
  + advance
    \ b=bowl record=myth
    ^ yell
    ?> (./some held) record.get(['flow 'config]) (yell [] record)
    ?> config=flow_maintenance/config held (yell [] record)
    ?> (./some held) record.get(['flow 'progress]) (yell [] record)
    ?> progress=flow_maintenance/progress held (yell [] record)
    ? !(progress.enabled) (yell [] (flow_maintenance/status record progress))
    = seen b.crew.gut(['candidate] flow/empty)
      before b.crew.gut(['destination] flow/empty)
    ? (flow_maintenance/responses b record progress seen before)
     > (./some reply) reply
    = dispatch=maybe[yell]
        ? !(equal[maybe[pin[axal[myth]]]] progress.observed (./some (pin seen))) .none
        ?> (./some held) record.get(['flow 'jobs]) .none
        ?> jobs=flow_work/jobs held .none
        = [entries writes] (flow_work/dispatch b jobs.entries config.provider [])
        ? !(writes.len) .none
        | ./some (yell writes record.put(['flow 'jobs] (flow_work/jobs entries jobs.serial)))
    ? dispatch
     > (./some reply) reply
    ? (and (equal[maybe[pin[axal[myth]]]] progress.observed (./some (pin seen)))
           ((maybe/is_none progress.reason) || (equal[axal[myth]] before (unpin progress.before))))
      | yell [] record
    = outcome (flow_maintenance/candidate_of seen)
    ?> (./ok proposal) outcome
      | flow_maintenance/blocked record progress seen before (flow_maintenance/failure_reason outcome)
    ? (unpin proposal.output.result).fil.fall(myth/new).get(['flow 'pending])
     > (./some held)
      ?> pending=flow/pending held (flow_maintenance/blocked record progress seen before 'flow_invalid_pending)
      = progress progress.set_observed((./some (pin seen))).set_before((pin before)).set_reason(.none)
      | flow_work/stage b record.put(['flow 'progress] progress) pending before proposal.definition config.provider
    = materialize (unpin config.writer).materialize
      planned=either[iota row[[p=path q=writ]]]
        ? (Try (materialize config.destination (unpin proposal.output.result)) before)
         > (./ok result) result
         > (./err _) (./err 'flow_writer_failed)
    ? planned
     > (./err why) (flow_maintenance/blocked record progress seen before why)
     > (./ok writes)
      ? !(writes.all((\ [name ignored] (pith_prefix config.destination name))))
        | flow_maintenance/blocked record progress seen before 'flow_writer_outside_destination
      = receipt config.destination.weld(['flows 'latest])
      ? (writes.any((\ [name ignored] (equal[path] name receipt))))
        | flow_maintenance/blocked record progress seen before 'flow_writer_receipt_collision
      | flow_maintenance/finish b record config progress seen before proposal writes
  + finish
    \ b=bowl record=myth config=flow_maintenance/config progress=flow_maintenance/progress
      seen=axal[myth] before=axal[myth] proposal=flow_maintenance/proposal writes=row[[p=path q=writ]]
    ^ yell
    = generation=nat progress.generation.inc
      run=path b.here.weld(['work ($u generation)])
      self=iota b.here.at(0)
      frozen (flow_runtime/frozen self proposal.output.result)
      evidence (native_work/status "complete" (native_work/open b.here "flow" (myth/sing ['flow 'automatic_run] (flow_maintenance/run (pin proposal) (pin before) config.writer_origin))))
      evidence (native_work/event_record b.here "publication" record evidence).put(system_vocabulary/lede (pails/t "Automatic flow run"))
      receipt (myth/sing ['flow 'receipt] (flow_runtime/receipt (safe 0 .x run) (unpin proposal.definition).source))
      receipt receipt.put(system_vocabulary/content (pails/t (str/cat_all ["Maintained by " (path_show b.here) "; frozen run " (path_show run)])))
      [evidence trace] (native_work/traces run (proposal.output.trace.map((\ event [event.name event.value]))) evidence)
      writes writes.snoc([run (writ/make evidence)]).snoc([run.snoc('result) (writ/make frozen)])
      inputs (proposal.captures.map((\ capture [run.weld(['inputs capture.name]) (writ/make (flow_runtime/frozen self capture.snapshot.value))])))
      writes writes.weld(trace).weld(inputs).snoc([config.destination.weld(['flows 'latest]) (writ/make receipt)])
      surface (native_work/lens (safe 0 .z (row/cons[iota] 'x b.here.weld(['cells 'work]))) 'maintenance [])
      surface surface.put(system_vocabulary/lede (pails/t "Maintenance work"))
      writes writes.snoc([config.destination.weld(['cells 'maintenance]) (writ/make surface)])
      writes writes.snoc([b.here.snoc('queue) (writ/make (flow_runtime/frozen self (pin flow/empty)))])
      next progress.set_generation(generation).set_observed((./some (pin seen))).set_before((pin flow/empty)).set_reason(.none)
    | yell writes (flow_maintenance/status (native_work/append run record) next)
  + hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | flow_maintenance/advance b record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_maintenance/advance b record.meld(input)
  + form
    ^ form
    | def_form.set_hear(flow_maintenance/hear).set_talk(flow_maintenance/talk)
  + follow
    \ controller=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < definition_ref (cooperate/reference ['definition] input)
    ? !(and (eq definition_ref.ver 0) (equal[care] definition_ref.care .x)) (./err 'flow_live_definition_required)
    ?> (./some held) (cooperate/record definition_ref.path state).fall(myth/new).get((flow/key state.self 'definition)) (./err 'flow_missing_definition)
    ?> definition=flow/definition held (./err 'flow_invalid_definition)
    = arguments=row[path] (row/weld[path] [['definition] ['destination] ['writer] ['provider]] (row/map[iota path] flow_runtime/input_argument definition.inputs))
    ? !(flow_runtime/valid_arguments arguments input) (./err 'flow_invalid_arguments)
    ?> (./some destination) input.path_at(['destination]) (./err 'flow_missing_destination)
    ? !(state.permitted(destination)) (./err 'write_outside_authority)
    ? ((flow_maintenance/overlaps controller destination) || (flow_maintenance/overlaps definition_ref.path controller)) (./err 'flow_overlapping_destination)
    ? (flow_maintenance/overlaps definition_ref.path destination) (./err 'flow_overlapping_destination)
    < writer_ref (cooperate/reference ['writer] input)
    ? !(and (eq writer_ref.ver 0) (equal[care] writer_ref.care .x)) (./err 'flow_writer_requires_live_record)
    < writer_origin (cooperate/pin_link writer_ref state)
    ?> (./some held) (cooperate/record writer_ref.path state).fall(myth/new).get((flow/key state.self 'writer)) (./err 'flow_missing_writer)
    ?> writer=flow_runtime/writer held (./err 'flow_invalid_writer)
    < provider (flow_maintenance/provider input state)
    ? (cooperate/record controller state)
     > (./some current)
      ?> (./some held) current.get(['flow 'config]) (./err 'flow_controller_collision)
      ?> existing=flow_maintenance/config held (./err 'flow_controller_collision)
      ? (equal[myth] input (unpin existing.request)) (./ok [])
      | ./err 'flow_controller_conflict
    ? ((maybe/is_some (state.case(.x controller))) || (gt (sovereign_peek controller state).wyt 0)) (./err 'flow_controller_collision)
    = config (flow_maintenance/config (pin input) definition_ref.path destination (pin writer) writer_origin provider)
      view (myth/sing ['flow 'config] config).put(bond/weft (spun flow_maintenance/derive .none)).put(bond/tack definition_ref)
      view view.put(['resolutions] (safe 0 .z controller.snoc('resolutions)))
    % todo=row[iota] definition.inputs view=myth view
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (flow_maintenance/register controller config view state)
    = [name rest] pair
    < reference (cooperate/reference ['input name] input)
    ? ((flow_maintenance/overlaps reference.path controller) || (flow_maintenance/overlaps reference.path destination)) (./err 'flow_overlapping_input)
    | _ rest view.put(['input name] reference)
  + provider
    \ input=myth state=namespace
    ^ either[iota maybe[pin[native_work/provider]]]
    ? !(input.has(['provider])) (./ok .none)
    < reference (cooperate/reference ['provider] input)
    ?> (./known tree) (sovereign_view reference.care reference.ver reference.path state) (./err 'flow_missing_provider)
    ?> (./some held) tree.fil.fall(myth/new).get(['work 'provider]) (./err 'flow_missing_provider)
    ?> provider=native_work/provider held (./err 'flow_invalid_provider)
    | ./ok (./some (pin provider))
  + register
    \ controller=path config=flow_maintenance/config view=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = registry (flow/key state.self 'claims)
    ? ((flow_maintenance/overlaps controller registry) || (flow_maintenance/overlaps config.destination registry)) (./err 'flow_controller_collision)
    = entries=either[iota axal[path]]
        ? (cooperate/record registry state)
         > (./some record)
          ?> (./some held) record.get(['flow 'claims]) (./err 'flow_claims_invalid)
          ?> claims=flow_maintenance/claims held (./err 'flow_claims_invalid)
          | ./ok claims.entries
        | ./ok (axal/new[path] .none)
    < entries entries
    ? (entries.keys.any((\ name (flow_maintenance/overlaps name config.destination)))) (./err 'flow_destination_claimed)
    = claims (myth/sing ['flow 'claims] (flow_maintenance/claims entries.put(config.destination controller)))
      view_path=path (row/cons[iota] 'x (row/snoc[iota] 'view controller))
      deps=crew (crew/sing ['candidate] (dep .x view_path)).put(['destination] (dep .z config.destination))
      progress (flow_maintenance/progress .true 0 .none (pin flow/empty) .none)
      record (native_work/open config.definition "maintenance" (myth/sing ['flow 'config] config)).put(['flow 'progress] progress).put(['flow 'destination] (pails/p config.destination))
      record record.put(limb_slot (kook [(flow/key state.self 'hand)])).put(crew_slot (cpail deps)).put(system_vocabulary/lede (pails/t "Flow maintenance"))
      surface (myth/sing bond/weft (spun flow_maintenance/surface .none)).put(bond/tack (safe 0 .x controller))
      surface surface.put(['requests] (safe 0 .z controller.snoc('work))).put(system_vocabulary/lede (pails/t "Flow work"))
    | ./ok [[controller (writ/make (flow_maintenance/status record progress))]
              [controller.snoc('view) (writ/make view)]
              [controller.weld(['cells 'work]) (writ/make surface)] [registry (writ/make claims)]]
  + surface
    ' A readable projection of existing work, not a second lifecycle. Both
    ' Nenex and the Cells surface read this same ordinary spun cell.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    = record input.fil.fall(myth/new)
    ?> (./some held) record.get(['flow 'config]) flow/empty
    ?> config=flow_maintenance/config held flow/empty
    ?> (./some held) record.get(['flow 'progress]) flow/empty
    ?> progress=flow_maintenance/progress held flow/empty
    = status (myth/sing ['status] record.pail_at(['work 'status])).put(['message] record.pail_at(system_vocabulary/content))
      status status.put(['generation] (pails/n progress.generation)).put(['enabled] (pails/b progress.enabled))
      status status.put(['output] (pails/p config.destination)).put(['definition] (pails/p config.definition))
      out (axal/new[myth] (./some status))
      out (unpin config.request).tap.fold(out flow_maintenance/surface_input)
      requests=axal[myth]
        ?> (./some held) context.get(['views 'requests]) flow/empty
        ?> selected=cell_view held flow/empty
        | unpin selected.tree
    ?> (./some held) record.get(['flow 'jobs]) out
    ?> jobs=flow_work/jobs held out
    | jobs.entries.fold(out (flow_maintenance/surface_job requests))
  + surface_input
    \ out=axal[myth] entry=mop/kv[path pail]
    ^ axal[myth]
    ? !(and (eq entry.key.len 2) (eq_iota entry.key.at(0) 'input)) out
    | out.put(['inputs entry.key.at(1)] (myth/sing ['source] entry.val))
  + surface_job
    \ requests=axal[myth] out=axal[myth] job=flow_work/job
    ^ axal[myth]
    = key job.request.at(job.request.len.dec)
      request requests.get([key]).fall(myth/new)
      worker requests.get([key 'worker]).fall(myth/new)
      row (myth/sing ['concept] (pails/p job.target)).put(['title] request.pail_at(system_vocabulary/lede))
      row row.put(['status] request.pail_at(['work 'status])).put(['reason] request.pail_at(system_vocabulary/content))
      row row.put(['worker] worker.pail_at(['work 'status])).put(['draft] (pails/p job.request.snoc('draft)))
      row row.put(['context] (safe 0 .z (row/cons[iota] 'x job.request.snoc('view))))
      row row.put(['evidence] (safe 0 .z (row/cons[iota] 'x job.request.snoc('evidence))))
      row row.put(['hole] request.pail_at(['work 'hole_path]))
    | out.put(['concepts key] row)
  + set_enabled
    \ controller=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['enabled]] input) (./err 'flow_invalid_arguments)
    ?> (./some held) input.get(['enabled]) (./err 'flow_enabled_required)
    ?> enabled=pails/b held (./err 'flow_enabled_required)
    ?> (./some held) (cooperate/record controller state).fall(myth/new).get(['flow 'progress]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress held (./err 'flow_missing_controller)
    ?> (./some held) (cooperate/record controller state).fall(myth/new).get(['flow 'config]) (./err 'flow_missing_controller)
    ?> config=flow_maintenance/config held (./err 'flow_missing_controller)
    ?> (./some held) (cooperate/record (flow/key state.self 'claims) state).fall(myth/new).get(['flow 'claims]) (./err 'flow_claims_invalid)
    ?> claims=flow_maintenance/claims held (./err 'flow_claims_invalid)
    ? (and enabled.b !(equal[maybe[path]] (./some controller) claims.entries.get(config.destination))) (./err 'flow_controller_detached)
    ? (eq enabled.b progress.enabled) (./ok [])
    | ./ok [[controller (writ/poke (myth/sing ['flow 'progress] progress.set_enabled(enabled.b).set_observed(.none)))]]
  + retry_revision
    ' Explicitly replace a failed current job with a new native attempt. The
    ' old request, draft, captured evidence and worker outcome remain untouched.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['expected]] input) (./err 'flow_invalid_arguments)
    = record (cooperate/record target state).fall(myth/new)
    ?> (./some held) record.get(['flow 'request]) (./err 'flow_missing_request)
    ?> request=flow_work/request held (./err 'flow_missing_request)
    = controller (cooperate/record request.controller state).fall(myth/new)
      children=axal[myth] (sovereign_care .y request.controller state)
      requests=axal[myth] (sovereign_care .y request.controller.snoc('work) state)
    ' A submitted retry form is safe to repeat, including after publication.
    ? (row/any[[path myth]] (\ [name card] (equal[maybe[path]] (./some target) card.path_at(['work 'retry_of]))) requests.tap) (./ok [])
    ?> (./some held) controller.get(['flow 'config]) (./err 'flow_missing_controller)
    ?> config=flow_maintenance/config held (./err 'flow_missing_controller)
    ?> (./some held) controller.get(['flow 'progress]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress held (./err 'flow_missing_controller)
    ? !(progress.enabled) (./err 'flow_controller_paused)
    ?> (./some held) (cooperate/record (flow/key state.self 'claims) state).fall(myth/new).get(['flow 'claims]) (./err 'flow_claims_invalid)
    ?> claims=flow_maintenance/claims held (./err 'flow_claims_invalid)
    ? !(equal[maybe[path]] (./some request.controller) claims.entries.get(config.destination)) (./err 'flow_controller_detached)
    ?> (./some held) controller.get(['flow 'jobs]) (./err 'flow_stale_revision)
    ?> jobs=flow_work/jobs held (./err 'flow_stale_revision)
    ? !(jobs.entries.any((\ job=flow_work/job (equal[path] job.request target)))) (./err 'flow_stale_revision)
    ? !(and (native_work/settled record) record.has(['flow 'refused])) (./err 'flow_request_not_failed)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_request)
    = worker (cooperate/record target.snoc('worker) state).fall(myth/new)
    ? (and (gt worker.tap.len 0) !(worker.has(['work 'outcome]))) (./err 'flow_worker_active)
    ?> (./known view) (sovereign_view .x 0 (row/cons[iota] 'x request.controller.snoc('view)) state) (./err 'flow_view_unavailable)
    < proposal (flow_maintenance/candidate_of view)
    ?> (./some held) (unpin proposal.output.result).fil.fall(myth/new).get(['flow 'pending]) (./err 'flow_stale_revision)
    ?> pending=flow/pending held (./err 'flow_stale_revision)
    ?> (./some held) (unpin pending.tasks).get(request.target).fall(myth/new).get(['flow 'task]) (./err 'flow_stale_revision)
    ?> task=flow/task held (./err 'flow_stale_revision)
    ? !(and (eq_iota pending.step request.step) (equal[pin[flow/task]] (pin task) request.task)) (./err 'flow_stale_revision)
    = remaining jobs.entries.keep((\ job=flow_work/job !(equal[path] job.request target)))
      controller controller.put(['flow 'jobs] (flow_work/jobs remaining jobs.serial)).put(['flow 'progress] progress.set_observed(.none))
      before (sovereign_care .z config.destination state)
      b (bowl [] request.controller 0 0 children (mop/empty))
      staged (flow_work/stage b controller pending before proposal.definition config.provider)
    ?> (./some held) staged.out.get(['flow 'jobs]) (./err 'flow_retry_unavailable)
    ?> staged_jobs=flow_work/jobs held (./err 'flow_retry_unavailable)
    = selected staged_jobs.entries.keep((\ job=flow_work/job (and (eq_iota job.step request.step) (equal[path] job.target request.target))))
    ? !(eq selected.len 1) (./err 'flow_retry_unavailable)
    = next=path selected.at(0).request
      draft (cooperate/record target.snoc('draft) state).fall(myth/new).txt_at(['src])
      writes=row[[p=path q=writ]]
        | staged.cards.map
          \ entry=[p=path q=writ]
          = [name write] entry
          ?> (./make card) write [name write]
          ? (equal[path] name next) [name (writ/make card.put(['work 'retry_of] (pails/p target)))]
          ? (and (equal[path] name next.snoc('draft)) (gt draft.len 0)) [name (writ/make card.put(['src] (pails/t draft)))]
          [name write]
    ? !(row/any[[path writ]] (\ [name write] (equal[path] name next)) writes) (./err 'flow_retry_unavailable)
    | ./ok writes.snoc([request.controller (writ/make staged.out)])
  + submit_revision
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['source] ['note] ['expected]] input) (./err 'flow_invalid_arguments)
    = record (cooperate/record target state).fall(myth/new)
    ?> (./some held) record.get(['flow 'request]) (./err 'flow_missing_request)
    ?> request=flow_work/request held (./err 'flow_missing_request)
    = source input.txt_at(['source])
      note input.txt_at(['note])
    < answer (flow_work/response (unpin request.task) source note)
    ? record.get(['flow 'response])
     > (./some prior)
      ? (equal[pail] prior answer) (./ok [])
      | ./err 'flow_response_conflict
    ?> (./some held) (cooperate/record request.controller state).fall(myth/new).get(['flow 'progress]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress held (./err 'flow_missing_controller)
    ? !(progress.enabled) (./err 'flow_controller_paused)
    ?> (./some held) (cooperate/record request.controller state).fall(myth/new).get(['flow 'jobs]) (./err 'flow_stale_revision)
    ?> jobs=flow_work/jobs held (./err 'flow_stale_revision)
    ? !(jobs.entries.any((\ job=flow_work/job (equal[path] job.request target)))) (./err 'flow_stale_revision)
    ?> (./known view) (sovereign_view .x 0 (row/cons[iota] 'x request.controller.snoc('view)) state) (./err 'flow_view_unavailable)
    < answer (flow_maintenance/answer request source note view)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target.snoc('draft)).fall(0)) (./err 'flow_draft_edited)
    | ./ok (flow_work/complete_record target request answer record)
  + answer
    \ request=flow_work/request source=str note=str view=axal[myth]
    ^ either[iota flow/resolution]
    < proposal (flow_maintenance/candidate_of view)
    ?> (./some held) (unpin proposal.output.result).fil.fall(myth/new).get(['flow 'pending]) (./err 'flow_stale_revision)
    ?> pending=flow/pending held (./err 'flow_stale_revision)
    ?> (./some held) (unpin pending.tasks).get(request.target).fall(myth/new).get(['flow 'task]) (./err 'flow_stale_revision)
    ?> current=flow/task held (./err 'flow_stale_revision)
    ? !(and (eq_iota request.step pending.step) (equal[pin[flow/task]] request.task (pin current))) (./err 'flow_stale_revision)
    | flow_work/response (unpin request.task) source note
  + responses
    \ b=bowl record=myth progress=flow_maintenance/progress seen=axal[myth] before=axal[myth]
    ^ maybe[yell]
    ?> (./some held) record.get(['flow 'jobs]) .none
    ?> jobs=flow_work/jobs held .none
    % todo=row[flow_work/job] jobs.entries
    ^ maybe[yell]
    ?> (./some pair) todo.pull .none
    = [job rest] pair
      key job.request.at(job.request.len.dec)
      current b.crew.gut(['requests] flow/empty).get([key]).fall(myth/new)
    ? (native_work/settled current) (_ rest)
    ? (current.has(['flow 'response]) || current.has(['flow 'refused])) (_ rest)
    ' Worker and request dependencies can hydrate in separate rounds. Wait
    ' for the request instead of inventing a refusal with no demand address.
    ?> (./some held) current.get(['flow 'request]) (_ rest)
    ?> request=flow_work/request held (_ rest)
    ?> (./some outcome) (native_work/outcome_at b.crew.gut(['worker key] flow/empty)) (_ rest)
    = result (flow_maintenance/accept_outcome job current outcome b.crew.gut(['guard key] flow/empty) seen)
    ? result
     > (./err why)
      = reason=str
          ? (flow_work/decode outcome.text)
           > (./ok pair)
            = [source note] pair
            | ? (eq_iota why 'flow_revision_unresolved) note (str/from_atom (quip_val why))
          | str/from_atom (quip_val why)
        refused current.put(['flow 'refused] (pails/q why)).put(system_vocabulary/content (pails/t reason))
        refused (native_work/settle "waiting" reason refused)
      | ./some (yell [[job.request (writ/make refused)]
          (native_work/hole_result request.hole "waiting" reason)]
          (flow_maintenance/status record progress.set_reason((./some why))))
     > (./ok writes)
      | ./some (yell writes record)
  + accept_outcome
    \ job=flow_work/job current=myth outcome=native_work/outcome guard=axal[myth] seen=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    ? (native_work/check_outcome outcome guard)
     > (./err why)
      ? (eq_iota why 'work_provider_failed) (./err 'flow_worker_failed)
      ? (eq_iota why 'work_guard_unavailable) (./err 'flow_draft_unavailable)
      | ./err 'flow_draft_edited
    ?> (./some held) current.get(['flow 'request]) (./err 'flow_missing_request)
    ?> request=flow_work/request held (./err 'flow_missing_request)
    < pair (flow_work/decode outcome.text)
    = [source note] pair
    < answer (flow_maintenance/answer request source note seen)
    | ./ok (flow_work/complete_record job.request request answer current)
  + detach
    ' Release the destination while retaining all frozen execution evidence.
    \ controller=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    = current (cooperate/record controller state).fall(myth/new)
    ?> (./some held) current.get(['flow 'config]) (./err 'flow_missing_controller)
    ?> config=flow_maintenance/config held (./err 'flow_missing_controller)
    ?> (./some held) current.get(['flow 'progress]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress held (./err 'flow_missing_controller)
    = registry (flow/key state.self 'claims)
    ?> (./some held) (cooperate/record registry state).fall(myth/new).get(['flow 'claims]) (./err 'flow_claims_invalid)
    ?> claims=flow_maintenance/claims held (./err 'flow_claims_invalid)
    ? !(equal[maybe[path]] (./some controller) claims.entries.get(config.destination)) (./ok [])
    = out (flow_maintenance/status current progress.set_enabled(.false)).put(crew_slot (cpail (mop/empty)))
      out out.put(system_vocabulary/content (pails/t "Detached; frozen runs retained"))
      next (myth/sing ['flow 'claims] (flow_maintenance/claims claims.entries.del(config.destination)))
    | ./ok [[controller (writ/make out)] [registry (writ/make next)]]
  + source_failed
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['reason]] input) (./err 'flow_invalid_arguments)
    = reason input.txt_at(['reason])
    ? ((eq reason.len 0) || (gt reason.len 2048)) (./err 'flow_invalid_source_error)
    ?> (./some record) (cooperate/record target state) (./err 'flow_missing_feed)
    ?> (./some held) record.get(['flow 'feed]) (./err 'flow_missing_feed)
    ?> feed=flow_maintenance/feed held (./err 'flow_missing_feed)
    = out record.put(['flow 'feed] feed.set_fault((./some reason))).put(system_vocabulary/content (pails/t reason))
    ? (equal[myth] record out) (./ok [])
    | ./ok [[target (writ/make out)]]
  + observe
    ' Atomically replace a spun's captured collection. Folder inputs need no
    ' invented record version; the exact tree is retained as a native pin.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['source]] input) (./err 'flow_invalid_arguments)
    < source (cooperate/reference ['source] input)
    ? !(equal[care] source.care .z) (./err 'flow_source_collection_required)
    ? (flow_maintenance/overlaps target source.path) (./err 'flow_overlapping_input)
    ?> (./known tree) (sovereign_view source.care source.ver source.path state) (./err 'flow_missing_input)
    ? !(and (gt tree.wyt 0) (flow/bounded tree)) (./err 'flow_input_limit)
    = feed (flow_maintenance/feed source (pin tree) .none)
      record (myth/sing ['flow 'feed] feed).put(bond/weft (spun flow_maintenance/source_view .none)).put(bond/tack (safe 0 .x (flow/key state.self 'empty)))
      record record.put(system_vocabulary/lede (pails/t "Observed source collection"))
    ? (cooperate/record target state)
     > (./some old)
      ?> (./some held) old.get(['flow 'feed]) (./err 'flow_source_collision)
      ?> prior=flow_maintenance/feed held (./err 'flow_source_collision)
      ? (equal[flow_maintenance/feed] prior feed) (./ok [])
      | ./ok [[target (writ/make record)]]
    ? (gt (sovereign_peek target state).wyt 0) (./err 'flow_source_collision)
    | ./ok [[target (writ/make record)]]
