(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind context (#module foil-test-context))
(#bind driver (#module foil-new-env))

;; No timing threshold. Compile and force each fixture before timing the native
;; transaction/read. Provider replies are controlled; no network or live world.
(define (timed label dimension count state run)
  (define forced (DeepSeq state 0))
  (define start (Seq forced (Now 0)))
  (define result (Seq start (run state)))
  (define end (Seq (DeepSeq result 0) (Now 0)))
  (Seq end (Seq (print ["FLOW-BOUNDARY-COST" label "dimension" dimension
      "count" count "elapsed_ns" (Sub end start)]) result)))

(define (run fixture)
  (define (helper name) (driver:get-perc ["flow_boundary_cost_fixture" name] fixture))
  (define make (helper "make"))
  (define execute (helper "run"))
  (define (sample dimension count)
    (define state (make dimension count (Add count 71)))
    (define after (timed "evidence-to-publication" dimension count state execute))
    (define checked (Seq (DeepSeq after 0)
      (Seq (assert ((helper "valid") state after))
        (print ["FLOW-BOUNDARY-SHAPE" dimension count
          "destination_records" ((helper "destination_size") state)
          "source_records" ((helper "source_size") state)
          "retained_work_records" ((helper "work_size") state)
          "destination_holes" ((helper "hole_count") state)
          "selected_work_records" ((helper "selected_size") state)
          "committed_events" ((helper "events") state after)]))))
    (define history (Seq checked (timed "work-history-cell" dimension count after (helper "history"))))
    (define recovery (Seq (DeepSeq history 0)
      (timed "provider-recovery-negative-scan" dimension count after (helper "recover"))))
    (Seq (DeepSeq recovery 0) (assert (Eq 0 (Sz recovery)))))
  (define (document count)
    (define state ((helper "make_document") count (Add count 91)))
    (define response (timed "document-manifest" "paragraphs" count state (helper "document")))
    (Seq (assert (Eq 200 (_0 response)))
      (Seq (assert (Gt (Bytes (_1 response)) 0))
        (print ["FLOW-DOCUMENT-SHAPE" count "serialized_bytes" (Bytes (_1 response))]))))
  (Seq (DeepSeq (map (lambda (dimension)
      (map (sample dimension) [0 32 128])) ["history" "destination" "holes" "context"]) 0)
    (Seq (DeepSeq (map document [0 32 128]) 0) 1)))

(define (check ignored)
  (define fixture (_1 (source:compile
    (context:files 0 ["flow_boundary_cost_fixture"]) 0 "flow_boundary_cost_fixture")))
  (run fixture))
(#export check run)
