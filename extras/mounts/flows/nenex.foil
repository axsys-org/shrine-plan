- flow_runtime
- apps/nenex/main [at=wiki]

' Destination adapter: only the generated pages belong to this writer. Named
' annotations/work/cells survive; edits to generated prose cause a conflict.
+ flow_nenex
  + author
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['source] ['expected]] input) (./err 'flow_invalid_arguments)
    = corpus=path [state.self 'app 'nenex 'w]
    ? !(and (pith_prefix corpus target) (eq target.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(wiki/valid_page_name (quip_val target.at(corpus.len))) (./err 'flow_nenex_destination)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    = source input.txt_at(['source])
    ? ((eq source.len 0) || (gt source.len 65536)) (./err 'flow_source_limit)
    ? !(flow/valid_document source) (./err 'flow_invalid_document_path)
    = form=path [state.self 'app 'nenex 'kook 'doc]
    ? (maybe/is_none (cooperate/record form state)) (./err 'flow_nenex_not_installed)
    ? (cooperate/record target state)
     > (./some old)
      ? !(equal[pail] old.pail_at(limb_slot) (kook [form])) (./err 'flow_page_behavior_changed)
      | ./ok [[target (writ/poke (myth/sing ['src] (pails/t source)))]]
    ? (gt (sovereign_peek target state).wyt 0) (./err 'flow_page_collision)
    | ./ok [[target (writ/make ((myth/sing ['src] (pails/t source)).put(limb_slot (kook [form]))))]]
  + ownership
    : pages=pin[axal[str]]
  + source
    \ destination=path relative=path page=flow/page pages=axal[myth]
    ^ str
    = target destination.weld(relative)
      links (pages.keys.keep((\ name (and (pith_prefix relative name) (eq name.len relative.len.inc)))))
      children (links.map((\ name (snode/ref (seg_texts destination.weld(name)) []))))
      citations (page.uses.map((\ name (snode/ref (seg_texts destination.weld(['reference name])) []))))
      body page.body
      body (? children.len body.snoc((snode/sect "Child documents" [] children)) body)
      body (? citations.len body.snoc((snode/sect "Source evidence" [] citations)) body)
      provenance (snode/sect "Flow provenance" [] [(snode/ref (seg_texts destination.weld(['flows 'latest])) [])])
      body (? relative.len body body.snoc(provenance))
    | str/from_atom (unparse [(snode/doc (seg_texts target) [] [(snode/sect page.title [] body)])])
  + plan
    \ destination=path pages=axal[myth] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = form=path [state.self 'app 'nenex 'kook 'doc]
    ? (maybe/is_none (cooperate/record form state)) (./err 'flow_nenex_not_installed)
    | flow_nenex/materialize destination pages (sovereign_peek destination state)
  + materialize
    ' Shared pure writer: manual admission and reactive hands use the same checks.
    \ destination=path pages=axal[myth] before=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    ? !(destination.len) (./err 'flow_nenex_destination)
    = corpus=path [destination.at(0) 'app 'nenex 'w]
    ? !(and (pith_prefix corpus destination) (eq destination.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(wiki/valid_page_name (quip_val destination.at(corpus.len))) (./err 'flow_nenex_destination)
    ? (maybe/is_none pages.fil) (./err 'flow_missing_root_page)
    ? (gt pages.wyt 128) (./err 'flow_page_limit)
    = form=path [destination.at(0) 'app 'nenex 'kook 'doc]
    = owner destination.weld(['flows 'ownership])
      card before.get(['flows 'ownership])
      old=either[iota axal[str]]
        ? card
         > (./some record)
          ?> (./some held) record.get(['flow 'ownership]) (./err 'flow_ownership_collision)
          ?> ownership=flow_nenex/ownership held (./err 'flow_ownership_collision)
          | ./ok (unpin ownership.pages)
        ? !(native_work/only_holes destination before) (./err 'flow_destination_exists)
        | ./ok (axal/new[str] .none)
    < old old
    ? !(old.keys.all((\ name=path (pages.has(name))))) (./err 'flow_page_removal_requires_migration)
    % todo=row[[p=path q=myth]] pages.tap writes=row[[p=path q=writ]] [] saved=axal[str] (axal/new[str] .none)
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull
      | ./ok writes.snoc([owner (writ/make (myth/sing ['flow 'ownership] (flow_nenex/ownership (pin saved))))])
    = [entry rest] pair
      [name card] entry
    ? !(name.all((\ part (wiki/valid_page_name (quip_val part))))) (./err 'flow_invalid_page)
    ? (name.any((\ part (flow/has part ['flows 'work 'inputs 'cells 'holes])))) (./err 'flow_reserved_page)
    ?> (./some held) card.get(['flow 'page]) (./err 'flow_missing_page)
    ?> page=flow/page held (./err 'flow_invalid_page)
    = target destination.weld(name)
      current before.get(name)
      previous old.get(name)
    ? (and (maybe/is_none previous) !(native_work/only_holes target before.dip(name))) (./err 'flow_page_collision)
    ? previous
     > (./some source)
      ? !(eq current.fall(myth/new).txt_at(['src]) source) (./err 'flow_generated_page_edited)
      ? !(equal[pail] current.fall(myth/new).pail_at(limb_slot) (kook [form])) (./err 'flow_page_behavior_changed)
      = source (flow_nenex/source destination name page pages)
      ? (gt source.len 196608) (./err 'flow_page_size)
      = next (? (eq source current.fall(myth/new).txt_at(['src])) writes writes.snoc([target (writ/poke (myth/sing ['src] (pails/t source)))]))
      | _ rest next saved.put(name source)
    = source (flow_nenex/source destination name page pages)
    ? (gt source.len 196608) (./err 'flow_page_size)
    = record (myth/sing ['src] (pails/t source)).put(limb_slot (kook [form]))
    | _ rest writes.snoc([target (writ/make record)]) saved.put(name source)
