- flow_interface
- json [at=author_json]

' Presentation adapters only. Goo guards the selected receiver/publication;
' existing native planners retain source, selection, ownership and work rules.
+ flow_author_controls
  + refresh
    ' Follow explicit behavior publication through this published action.
    ' Reuse the existing registration planner; retained work is not rewritten.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_ui/refresh [state.self 'gov 'flows] input state
  + fields
    \ allowed=row[str] input=myth
    ^ either[iota row[[str str]]]
    ? !(flow_runtime_ops/valid_arguments (allowed.map((\ name=str [($ts name)]))) input) (./err 'flow_invalid_arguments)
    | ./ok (allowed.map((\ name=str [name input.txt_at([($ts name)])])))
  + pairs
    ' JSON supplies dynamic ports without another command schema. Preserve
    ' duplicates until they are rejected; never silently choose one binding.
    \ text=str prefix=str
    ^ either[iota row[[str str]]]
    ?> (./ok value end) (author_json/parse text) (./err 'flow_invalid_bindings)
    ?> (./obj members) value (./err 'flow_invalid_bindings)
    % rest=row[jkv] members out=row[[str str]] []
    ^ either[iota row[[str str]]]
    ?> (./some next) rest.pull (./ok out)
    = [member rest] next
    ?> (./str value) member.v (./err 'flow_invalid_bindings)
    < name (flow_ops/name (sval/word (str/to_atom member.k)))
    ? !(eq member.k (str/from_atom (quip_val name))) (./err 'flow_invalid_binding)
    = key (str/cat_all [prefix member.k])
    ? (out.any((\ [prior text] (eq prior key)))) (./err 'flow_duplicate_binding)
    | _ rest out.snoc([key value])
  + ports
    ' Legacy forms supply one field per port. Reflected JSON must have exactly
    ' that same set, including refusing unused extra keys.
    \ fields=row[[str str]] ports=row[iota] prefix=str
    ^ bool
    = expected ports.map((\ port=iota (str/cat_all [prefix (str/from_atom (quip_val port))])))
    | (and (eq fields.len expected.len) (fields.all((\ [key value] (row/has[str] key expected)))))
  + source_input
    ' Semidoc is multiline plain text. Reuse Goo's native code editor and text
    ' wire codec; reject formatting rather than silently erase metadata.
    \ input=myth
    ^ either[iota myth]
    ?> wire=pails/t input.pail_at(['source]) (./err 'flow_invalid_source_input)
    ?> (./ok value end) (author_json/parse wire.t) (./err 'flow_invalid_source_input)
    ?> (./some source) (goo_text/decode value) (./err 'flow_invalid_source_input)
    ? !(source.all((\ run=goo/runt (eq run.myth.size 0)))) (./err 'flow_source_requires_plain_text)
    | ./ok input.put(['source] (pails/t source.plain))
  + create_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["new_name" "source"] input)
    < name (flow_ops/name (sval/word (str/to_atom input.txt_at(['new_name]))))
    = destination=path [state.self 'app 'nenex 'w name]
      request (myth/sing ['source] input.pail_at(['source])).put(['expected] (pails/n 0))
    | namespace_command/plan destination (flow_ops/key state.self 'author) request state
  + save_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["source"] input)
    = request input.put(['expected] (pails/n state.case(.x target).fall(0)))
    | namespace_command/plan target (flow_ops/key state.self 'author) request state
  + inspect_callables
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["selection_name" "scope"] input)
    = fields fields.cons(["action" "inspect_callables"])
    | flow_ui/plan_inspect_callables target fields state
  + select_step
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["selection_name" "mode" "definition"] input)
    = fields fields.cons(["action" "select_step"])
    | flow_ui/plan_select_step target fields state
  + compose
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["name" "selected_version" "selected_definition" "source" "flow_name" "step_name" "result" "new_inputs" "bindings"] input)
    = fields fields.cons(["action" "compose"])
    < bindings (flow_author_controls/pairs input.txt_at(['bindings]) "binding/")
    < selection (flow_ops/name (sval/word (str/to_atom input.txt_at(['name]))))
    = card (cooperate_ops/record target.weld(['cells selection]) state).fall(myth/new)
    ?> saved=native_work/captured card.pail_at(['capture]) (./err 'flow_missing_selection)
    = ports (flow_ui/callable_ports card.txt_at(['flow 'author_mode]) (unpin saved.value).fil.fall(myth/new) state.self)
    ? !(flow_author_controls/ports bindings ports "binding/") (./err 'flow_port_mismatch)
    = fields fields.weld(bindings)
    | flow_ui/plan_compose target fields state
  + select
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["occurrence_name" "definition"] input)
    = fields fields.cons(["action" "select"])
    | flow_ui/plan_select target fields state
  + embed
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["name" "selected_version" "selected_definition" "source" "destination" "writer" "provider" "bindings"] input)
    = fields fields.cons(["action" "embed"])
    < bindings (flow_author_controls/pairs input.txt_at(['bindings]) "input/")
    < selection (flow_ops/name (sval/word (str/to_atom input.txt_at(['name]))))
    = card (cooperate_ops/record target.weld(['cells selection]) state).fall(myth/new)
    ?> saved=native_work/captured card.pail_at(['capture]) (./err 'flow_missing_selection)
    ?> definition=flow/definition (unpin saved.value).fil.fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_invalid_definition)
    = ports definition.inputs
    ? !(flow_author_controls/ports bindings ports "input/") (./err 'flow_port_mismatch)
    = fields fields.weld(bindings)
    | flow_ui/plan_embed target fields state
  + bind_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_page"] input)
    = fields fields.cons(["action" "bind_source"])
    | flow_ui/plan_bind_source target fields state
  + bind_file
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_file" "source_mount"] input)
    = fields fields.cons(["action" "bind_file"])
    | flow_ui/source_binding target "bind_file" fields state
  + bind_url
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_url"] input)
    = fields fields.cons(["action" "bind_url"])
    | flow_ui/source_binding target "bind_url" fields state
  + retry
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["request"] input)
    = fields fields.cons(["action" "retry"])
    | flow_ui/plan_retry target fields state
  + pause
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller"] input)
    = fields fields.cons(["action" "pause"])
    | flow_ui/plan_control target fields state
  + resume
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller"] input)
    = fields fields.cons(["action" "resume"])
    | flow_ui/plan_control target fields state
  + detach
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller"] input)
    = fields fields.cons(["action" "detach"])
    | flow_ui/plan_control target fields state
  + adopt
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller" "selection" "previous"] input)
    = fields fields.cons(["action" "adopt"])
    | flow_ui/plan_adopt target fields state
  + references
    \ pairs=row[[str str]] prefix=iota input=myth
    ^ either[iota myth]
    ?> (./some next) pairs.pull (./ok input)
    = [entry rest] next
      [name text] entry
    < path (flow_ui/address text)
    | flow_author_controls/references rest prefix input.put([prefix ($ts name)] (safe 0 .z path))
  + open_work
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["id" "content" "context"] input)
    < context (flow_author_controls/pairs input.txt_at(['context]) "")
    < request (flow_author_controls/references context 'context input.del(['context]))
    | namespace_command/plan target (cooperate_ops/key state.self 'open) request state
  + delegate
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["activity" "id" "prompt" "response_schema" "provider" "guard"] input)
    < activity (flow_ui/address input.txt_at(['activity]))
    < provider (flow_ui/address input.txt_at(['provider]))
    < guard (flow_ui/address input.txt_at(['guard]))
    = request input.del(['activity]).del(['response_schema]).put(['schema] input.pail_at(['response_schema]))
      request request.put(['provider] (safe 0 .x provider)).put(['guard] (safe 0 .z guard))
    | namespace_command/plan activity (cooperate_ops/key state.self 'delegate) request state
  + ask
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["id" "content" "shape" "context" "resume"] input)
    < context (flow_ui/address input.txt_at(['context]))
    < resume (flow_ui/address input.txt_at(['resume]))
    = request input.put(['context] (safe 0 .z context)).put(['resume] (pails/p resume))
    | namespace_command/plan target (cooperate_ops/key state.self 'ask) request state
