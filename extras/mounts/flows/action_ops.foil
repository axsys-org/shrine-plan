- flow_operations
- flow_runtime_ops
- goo_runtime
- flow_request_ops
- goo_app/ascii

' Goo supplies the declaration interpreter. The hand emits a native command;
' admission rechecks current work and Goo guards before effect and receipt.
' Cell evaluation only describes work and never executes the action.
+ flow_action_ops
  + rich_inputs
    \ nodes=list[goo/node]
    ^ row[path]
    | row/bind[goo/node path] flow_action_ops/rich_input nodes.row
  + rich_input
    \ node=goo/node
    ^ row[path]
    = nested (flow_action_ops/rich_inputs node.children)
    ? !(and (eq node.constructor "input") (gt node.arguments.len 1)) nested
    ?> (./some slot) (goo_runtime/read_path node.arguments.at(0)) nested
    ?> (./leaf _ _ role) node.arguments.at(1) nested
    ? !(goo_ascii/rich_role role) nested
    | nested.snoc(slot)
  + input_field
    \ rich=row[path] card=myth field=rex
    ^ myth
    ?> (./nest _ _ rune kids) field card
    ? !(and (eq rune "=") (eq kids.len 2)) card
    ?> (./some slot) (goo_runtime/read_path kids.at(0)) card
    ? (goo_runtime/mentions "capture" kids.at(1)) (card.put((row/weld[iota] slot ['goo 'input]) (pails/t "selection")))
    ? (goo_runtime/mentions "provider" kids.at(1)) card
    ? (goo_runtime/mentions "input" kids.at(1)) (card.put((row/weld[iota] slot ['goo 'input]) (pails/t (? (row/has[path] slot rich) "rich_text" "text"))))
    card
  + controls
    ' Reflection walks Goo's compiled declarations and scopes, retaining the
    ' original control address. No second action schema or interpreter.
    \ nodes=list[goo/node] prefix=row[nat] scope=goo_runtime/scope query=goo_runtime/request binding=str rich=row[path]
    ^ axal[myth]
    % offset=nat 0 out=axal[myth] flow_ops/empty
    ^ axal[myth]
    ? (eq offset nodes.len) out
    = node nodes.at(offset)
      route=row[nat] prefix.snoc(offset)
      entered (goo_runtime/enter scope node)
      nested (flow_action_ops/controls node.children route entered query binding rich)
      out (axal/gas[myth] nested.tap out)
      out=axal[myth]
        ? !(eq node.constructor "action") out
        ?> (./ok _) (goo_runtime/bound_control binding [node entered]) out
        = fields=list[rex] entered.values.weld(node.arguments.drop(1).keep((\ arg=rex (maybe/is_none (goo_runtime/named "become" (list/one arg))))))
          label=str
            ? !(node.arguments.len) "Action"
            ?> (./leaf _ _ text) node.arguments.head node.arguments.head.print
            text
          card (myth/sing ['goo 'request] query.set_control(route)).put(['title] (pails/t label))
          card card.put(['goo 'bindings] (pails/t (str/join "; " fields.row.map((\ field=rex field.print)))))
          card (row/fold[rex myth] card (flow_action_ops/input_field rich) fields.row)
        | out.put(route.map((\ n=nat ($u n))) card)
    | _ offset.inc out
  + inspect
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['target] ['view]] input) (./err 'flow_invalid_arguments)
    ? !(and (state.permitted(target)) (pith_prefix [state.self 'app] target)) (./err 'write_outside_authority)
    ? ((state.case(.x target).is_some) || (sovereign_peek target state).wyt) (./err 'flow_action_capture_collision)
    ?> (./some object) input.path_at(['target]) (./err 'flow_missing_action)
    ?> (./some view_path) input.path_at(['view]) (./err 'flow_missing_action)
    ?> (./some subject) (goo_runtime/target object state) (./err 'flow_invalid_action)
    ?> (./some current) (goo_runtime/record .x subject state) (./err 'flow_invalid_action)
    ?> (./some published) (goo_runtime/record .x view_path state) (./err 'flow_invalid_action)
    ?> (./ok view) (goo_runtime/published published) (./err 'flow_invalid_action)
    ?> (./ok lowered) (goo_runtime/matching_view view current) (./err 'flow_invalid_action)
    = query (goo_runtime/request "act" object subject view_path [] state.case(.x subject).fall(0)
        state.case(.y object).fall(0) (goo_runtime/publication state) [] 0)
      controls (flow_action_ops/controls lowered.children [] (goo_runtime/scope .none .none .nil .none .none) query view.view.binding (flow_action_ops/rich_inputs lowered.children))
      root (myth/sing ['goo 'subject] (cell_view (pin (flow_ops/empty).put([] current))))
      root root.put(['goo 'publication] (cell_view (pin (flow_ops/empty).put([] published))))
      root root.put(['goo 'origin] (safe state.case(.x view_path).fall(0) .x view_path))
    | ./ok [[target (writ/make ((native_work_ops/value state.self (pin controls.put([] root))).put(['flow 'action_catalog] (pails/b .true))))]]
  + valid
    \ query=goo_runtime/request
    ^ bool
    = fields query.inputs.all((\ [key value] (and !(eq key "$invocation") (eq (query.inputs.keep((\ [other ignored] (eq key other)))).len 1))))
    | and (eq query.operation "act") (and (gt query.control.len 0) (and (le query.inputs.len 64) fields))
  + prepare
    ' Select against one native snapshot. Versions are deliberately captured
    ' here; submission still goes through Goo's current authority and guards.
    ' Arguments are a preparation preview: Goo's provider clock remains bound
    ' at invocation, and its existing receipt contract normalizes now to zero.
    \ query=goo_runtime/request state=namespace
    ^ either[str axal[myth]]
    ? !(flow_action_ops/valid query) (./err "Expected a declared Goo action without an invocation identity.")
    ?> (./some subject) (goo_runtime/target query.target state) (./err "Presentation has no writable source object.")
    ? !(and (state.permitted(subject)) (pith_prefix [state.self 'app] subject)) (./err "Object is outside application authority.")
    ?> (./some current) (goo_runtime/record .x subject state) (./err "Object is unavailable.")
    ?> (./some published) (goo_runtime/record .x query.view state) (./err "View is unavailable.")
    = query query.set_subject(subject).set_expected(state.case(.x subject).fall(0))
      query query.set_displayed(state.case(.y query.target).fall(0)).set_publication((goo_runtime/publication state)).set_now(0)
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
    ? !(scope.make.is_some || scope.action.is_some) (./err "Declared control has no action.")
    < arguments (goo_runtime/prepared query published current state)
    = root (myth/sing ['goo 'request] query).put(['goo 'arguments] (cell_view (pin (flow_ops/empty).put([] arguments))))
      root root.put(['goo 'subject] (cell_view (pin (flow_ops/empty).put([] current))))
      root root.put(['goo 'publication] (cell_view (pin (flow_ops/empty).put([] published))))
      root root.put(['goo 'origin] (safe state.case(.x query.view).fall(0) .x query.view))
      root root.put(['goo 'subject_origin] (safe query.expected .x subject))
    | ./ok (flow_ops/empty).put([] root)
  + capture
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['goo 'request]] input) (./err 'flow_invalid_arguments)
    ? !(and (state.permitted(target)) (pith_prefix [state.self 'app] target)) (./err 'write_outside_authority)
    ? ((state.case(.x target).is_some) || (sovereign_peek target state).wyt) (./err 'flow_action_capture_collision)
    ?> query=goo_runtime/request input.pail_at(['goo 'request]) (./err 'flow_missing_action)
    ?> (./ok prepared) (flow_action_ops/prepare query state) (./err 'flow_invalid_action)
    | ./ok [[target (writ/make (native_work_ops/value state.self (pin prepared)))]]
  + request
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = actions args.dip(['actions])
    ? !(actions.wyt) (./err 'flow_empty_actions)
    ? (gt actions.wyt 16) (./err 'flow_action_request_limit)
    % todo=row[[path myth]] actions.tap tasks=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull
      | ./ok (axal/new[myth] (./some (myth/sing ['flow 'judgment] (flow/judgment (pin tasks)))))
    = [entry rest] pair
      [name card] entry
    ?> query=goo_runtime/request card.pail_at(['goo 'request]) (./err 'flow_missing_action)
    ? !(flow_action_ops/valid query) (./err 'flow_invalid_action)
    = prompt (str/cat_all ["Invoke the retained declared Goo action on " (path_show query.target) "; completion requires its native invocation receipt."])
      task (myth/sing ['work 'prompt] (pails/t prompt)).put(['work 'schema] (pails/t "{}"))
      task task.put(['work 'provider] (native_work/provider (flow_action_ops/make query)))
      task task.put(['work 'evidence] (cell_view (pin (flow_ops/empty).put([] card)))).put(['goo 'request] query)
    | _ rest tasks.put(name task)
  + identity
    \ worker=path
    ^ str
    | str/cat_all ["flow:" (path_show worker)]
  + make
    \ query=goo_runtime/request target=path request=native_work/request
    ^ myth
    = query query.set_now(0).set_inputs(query.inputs.snoc(["$invocation" (flow_action_ops/identity target)]))
      record (native_work_ops/open request.owner "goo-action" (myth/sing ['work 'request] request))
      deps (crew/sing ['guard] (dep request.guard.care request.guard.path))
      deps deps.put(['receipts] (dep .x [target.at(0) 'weft 'goo_receipts]))
      record record.put(['goo 'request] query).put(['goo 'fields] (pails/t (flow_action_ops/fields query)))
      record record.put(limb_slot (kook [[target.at(0) 'gov 'flows 'action_work]]))
    | record.put(crew_slot (cpail deps)).put(system_vocabulary/content (pails/t "Awaiting guarded native action admission"))
  + authorized
    \ target=path record=myth state=namespace
    ^ either[iota unit]
    ?> request=native_work/request record.pail_at(['work 'request]) (./err 'work_request_missing)
    ?> retained=native_work/captured record.pail_at(['capture]) (./err 'work_guard_unavailable)
    < guard (cooperate_ops/resolve request.guard state)
    < checked (native_work_ops/check_outcome (native_work/outcome "complete" "" (pin retained)) guard)
    = owner (cooperate_ops/record request.owner state).fall(myth/new)
    ? !(and (equal[path] target request.owner.snoc('worker)) (equal[pail] owner.pail_at(['work 'request]) request)) (./err 'work_request_conflict)
    ? !(native_work_ops/active owner) (./err 'work_not_open)
    ? !(flow_request_ops/native owner) (./ok [])
    ?> query=goo_runtime/request record.pail_at(['goo 'request]) (./err 'flow_missing_action)
    = original query.set_inputs(query.inputs.keep((\ [key value] !(eq key "$invocation"))))
    ? !(equal[pail] (flow_request_ops/saved_task owner).pail_at(['goo 'request]) original) (./err 'work_request_conflict)
    ?> (./some controller_path) owner.path_at(['flow 'request_controller]) (./err 'flow_missing_controller)
    = controller (cooperate_ops/record controller_path state).fall(myth/new)
    ?> config=flow_maintenance/config controller.pail_at(['flow 'config]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress controller.pail_at(['flow 'progress]) (./err 'flow_missing_controller)
    ? !(progress.enabled) (./err 'flow_controller_paused)
    ?> claims=flow_maintenance/claims (cooperate_ops/record (flow_ops/key state.self 'claims) state).fall(myth/new).pail_at(['flow 'claims]) (./err 'flow_claims_invalid)
    ? !(equal[maybe[path]] claims.entries.get(config.destination) (./some controller_path)) (./err 'flow_controller_detached)
    = seen (sovereign_care .x (row/cons[iota] 'x controller_path.snoc('view)) state)
    ? !(flow_request_ops/current owner seen) (./err 'flow_stale_request)
    ? !(flow_request_ops/head request.owner owner config.destination (sovereign_peek config.destination state)) (./err 'flow_stale_request)
    | ./ok []
  + failed
    \ target=path record=myth reason=str
    ^ either[iota row[[p=path q=writ]]]
    ?> retained=native_work/captured record.pail_at(['capture]) (./err 'work_guard_unavailable)
    = result (native_work_ops/result target (native_work/outcome "failed" reason (pin retained)) record)
    | ./ok result.cards.snoc([target (writ/make result.out.put(system_vocabulary/content (pails/t reason)))])
  + execute
    ' One native plan: evidence, current hole, controller and declared control
    ' are checked on the settled candidate, before effect and receipt writes.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    = record (cooperate_ops/record target state).fall(myth/new)
    ? record.has(['work 'outcome]) (./ok [])
    ? (flow_action_ops/authorized target record state)
     > (./err why)
      | flow_action_ops/failed target record (str/cat_all ["Action was not executed: " (str/from_atom (quip_val why))])
    ?> query=goo_runtime/request record.pail_at(['goo 'request]) (./err 'flow_missing_action)
    = identities query.inputs.keep((\ [key value] (eq key "$invocation")))
    ? !(equal[row[[str str]]] identities [["$invocation" (flow_action_ops/identity target)]])
      | flow_action_ops/failed target record "Invocation identity differs from this work attempt"
    = body (show (json/obj [(jkv "outcome" (json/str "accepted"))
        (jkv "operationId" (json/str (flow_action_ops/identity target)))
        (jkv "target" (json/str (path_show query.subject)))]))
    = planned_receipt (goo_runtime/receipt_plan query body state)
    ? planned_receipt
     > (./err why) (flow_action_ops/failed target record (str/cat_all ["Invocation receipt refused: " why]))
    = receipt (either/ok_val planned_receipt)
    ? !(receipt.len) (./ok [[target (writ/poke myth/new)]])
    = planned_action (goo_runtime/plan query state)
    ? planned_action
     > (./err why) (flow_action_ops/failed target record (str/cat_all ["Declared action refused: " why]))
    = writes (either/ok_val planned_action)
    | ./ok writes.weld(receipt)
  + fields
    ' Form fields for the existing /goo/act entry point, not a second action
    ' protocol. Native clients may pass the typed request to helm/interact.
    \ query=goo_runtime/request
    ^ str
    = inputs query.inputs.map((\ [key value] (jkv (? (eq key "$invocation") "invocation" (str/cat_all ["input:" key])) (json/str value))))
      fields=row[jkv] [
        (jkv "target" (json/str (path_show query.target)))
        (jkv "subject" (json/str (path_show query.subject)))
        (jkv "view" (json/str (path_show query.view)))
        (jkv "control" (json/str (str/join "." query.control.map(nat/show))))
        (jkv "expected" (json/str (nat/show query.expected)))
        (jkv "displayed" (json/str (nat/show query.displayed)))
        (jkv "publication" (json/str (nat/show query.publication)))]
    | show (json/obj fields.weld(inputs))
  + advance
    \ b=bowl record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    ?> query=goo_runtime/request record.pail_at(['goo 'request]) (yell [] record)
    ?> (./some current) (native_work_ops/captured_at b.crew.gut(['guard] flow_ops/empty)) (yell [] record)
    = retained=native_work/captured
        ?> held=native_work/captured record.pail_at(['capture]) current
        held
      record record.put(['capture] retained)
    ? !(equal[pin[native_work/captured]] (pin current) (pin retained))
      | native_work_ops/result b.here (native_work/outcome "failed" "Action evidence changed; this worker cannot accept its invocation receipt" (pin retained)) record
    = journal b.crew.gut(['receipts] flow_ops/empty).fil.fall(myth/new)
    = entries=list[goo_runtime/receipt]
        ?> receipts=goo_runtime/receipts journal.pail_at(goo_runtime/receipt_slot) .nil
        receipts.entries
      matched entries.keep((\ entry (eq entry.identity (flow_action_ops/identity b.here))))
    ? !(matched.len)
      ? record.has(['goo 'submitted]) (yell [] record)
      | yell [[b.here (writ/warp (flow_ops/key b.here.at(0) 'execute_action) myth/new)]]
          record.put(['goo 'submitted] (pails/b .true))
    ? !(and (eq matched.len 1) (equal[goo_runtime/request] matched.head.request query.set_now(0)))
      | native_work_ops/result b.here (native_work/outcome "failed" "Goo invocation identity was reused with a different request" (pin retained)) record
    | native_work_ops/result b.here (native_work/outcome "complete" matched.head.body (pin retained)) record
  + hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | flow_action_ops/advance b record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_action_ops/advance b record.meld(input)
  + form
    ^ form
    | def_form.set_init(native_work_ops/wake).set_hear(flow_action_ops/hear).set_talk(flow_action_ops/talk)
