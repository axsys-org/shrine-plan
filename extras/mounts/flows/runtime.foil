- flow

+ flow_runtime
  + capture
    : name=iota snapshot=native_work/captured
  + writer
    : plan={\ path axal[myth] namespace}either[iota row[[p=path q=writ]]]
      materialize={\ path axal[myth] axal[myth]}either[iota row[[p=path q=writ]]]
  + attempt
    : request=pin[myth] definition=pin[flow/definition] captures=row[flow_runtime/capture]
      destination=path revision=maybe[nat] before=pin[axal[myth]] writer=pin[flow_runtime/writer]
      writer_origin=safe output=flow/evaluation
  + receipt
    : attempt=safe source=safe
  + valid_arguments
    \ names=row[path] input=myth
    ^ bool
    | input.tap.all((\ e (names.any((\ name=path (equal[path] name e.key))))))
  + input_argument
    \ name=iota
    ^ path
    ['input name]
  + preview_arguments
    \ names=row[iota]
    ^ row[path]
    = ports=row[path] (row/map[iota path] flow_runtime/input_argument names)
    | row/weld[path] [['id] ['destination] ['writer]] ports
  + publish
    \ document=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['id] ['expected]] input) (./err 'flow_invalid_arguments)
    < id (cooperate/identifier input)
    ? !(eq input.nat_at(['expected] 0) state.case(.x document).fall(0)) (./err 'flow_stale_source)
    ?> (./some card) (cooperate/record document state) (./err 'flow_missing_document)
    = text card.txt_at(['src])
    < origin (cooperate/pin_link (safe 0 .x document) state)
    < definition (flow/compile id origin text state)
    = target document.weld(['flows id])
      old (cooperate/record target state)
      record (myth/sing (flow/key state.self 'definition) definition).put(system_vocabulary/lede (pails/t (str/cat_all ["Flow: " (str/from_atom (quip_val id))])))
    ? old
     > (./some current)
      ? !(current.has((flow/key state.self 'definition))) (./err 'flow_definition_collision)
      ? (equal[myth] current record) (./ok [])
      | ./ok [[target (writ/make record)]]
    ? (gt (sovereign_peek target state).wyt 0) (./err 'flow_definition_collision)
    | ./ok [[target (writ/make record)]]
  + frozen
    \ self=iota value=pin[axal[myth]]
    ^ myth
    | native_work/value self value
  + preview
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < id (cooperate/identifier input)
    = run target.weld(['work id])
    ?> (./some held) (cooperate/record target state).fall(myth/new).get((flow/key state.self 'definition))
      | ./err 'flow_missing_definition
    ?> definition=flow/definition held (./err 'flow_invalid_definition)
    = allowed (flow_runtime/preview_arguments definition.inputs)
    ? !(flow_runtime/valid_arguments allowed input) (./err 'flow_invalid_arguments)
    ? (cooperate/record run state)
     > (./some record)
      ?> (./some held) record.get((flow/key state.self 'attempt)) (./err 'flow_run_collision)
      ?> previous=flow_runtime/attempt held (./err 'flow_run_collision)
      ? (equal[myth] input (unpin previous.request)) (./ok [])
      | ./err 'flow_run_id_conflict
    ? (maybe/is_some (state.case(.x run))) (./err 'flow_run_id_retired)
    ? (gt (sovereign_peek run state).wyt 0) (./err 'flow_run_collision)
    ?> (./some destination) input.path_at(['destination]) (./err 'flow_missing_destination)
    ? !(state.permitted(destination)) (./err 'write_outside_authority)
    ? ((pith_prefix destination target) || (pith_prefix target destination)) (./err 'flow_overlapping_destination)
    < writer_ref (cooperate/reference ['writer] input)
    ? !(and (eq writer_ref.ver 0) (equal[care] writer_ref.care .x)) (./err 'flow_writer_requires_live_record)
    < writer_origin (cooperate/pin_link writer_ref state)
    ?> (./some held) (cooperate/record writer_ref.path state).fall(myth/new).get((flow/key state.self 'writer))
      | ./err 'flow_missing_writer
    ?> writer=flow_runtime/writer held (./err 'flow_invalid_writer)
    % todo=row[iota] definition.inputs captures=row[flow_runtime/capture] [] values=axal[axal[myth]] (axal/new[axal[myth]] .none)
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (flow_runtime/finish_preview run input definition captures destination writer writer_origin values state)
    = [name rest] pair
    < ref (cooperate/reference ['input name] input)
    ? ((pith_prefix destination ref.path) || (pith_prefix ref.path destination)) (./err 'flow_overlapping_input)
    ?> (./known value) (sovereign_view ref.care ref.ver ref.path state) (./err 'flow_missing_input)
    ? !(flow/bounded value) (./err 'flow_input_limit)
    ? !(value.wyt) (./err 'flow_missing_input)
    | _ rest captures.snoc((flow_runtime/capture name (native_work/captured ref (state.case(ref.care ref.path)) (pin value)))) values.put([name] value)
  + finish_preview
    \ run=path input=myth definition=flow/definition captures=row[flow_runtime/capture] destination=path writer=flow_runtime/writer writer_origin=safe values=axal[axal[myth]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < output (flow/evaluate definition values)
    ? (unpin output.result).fil.fall(myth/new).has(['flow 'pending]) (./err 'flow_revision_requires_follow)
    = plan writer.plan
    < proposed (plan destination (unpin output.result) state)
    ? !(proposed.all((\ [name ignored] (pith_prefix destination name)))) (./err 'flow_writer_outside_destination)
    = attempt (flow_runtime/attempt (pin input) (pin definition) captures destination (state.case(.z destination)) (pin (sovereign_peek destination state)) (pin writer) writer_origin output)
      record (native_work/open definition.source.path "flow" (myth/sing (flow/key state.self 'attempt) attempt)).put(system_vocabulary/lede (pails/t "Flow preview")).put(system_vocabulary/content (pails/t "Preview ready; commit is a separate guarded operation."))
      [record trace] (native_work/traces run (output.trace.map((\ event [event.name event.value]))) record)
      writes=row[[p=path q=writ]] [[run (writ/make record)] [run.snoc('result) (writ/make (flow_runtime/frozen state.self output.result))]]
      inputs (captures.map((\ capture [run.weld(['inputs capture.name]) (writ/make (flow_runtime/frozen state.self capture.snapshot.value))])))
    | ./ok writes.weld(trace).weld(inputs)
  + current
    \ capture=flow_runtime/capture state=namespace
    ^ bool
    | native_work/current capture.snapshot state
  + commit
    \ run=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    ?> (./some record) (cooperate/record run state) (./err 'flow_missing_run)
    ?> (./some held) record.get((flow/key state.self 'attempt)) (./err 'flow_missing_run)
    ?> attempt=flow_runtime/attempt held (./err 'flow_invalid_run)
    ?> (./some activity) (native_work/state record) (./err 'flow_invalid_run)
    ? (eq activity.status "complete") (./ok [])
    ? !(attempt.captures.all((\ capture (flow_runtime/current capture state)))) (./err 'flow_stale_input)
    ? !(equal[maybe[nat]] attempt.revision (state.case(.z attempt.destination))) (./err 'flow_stale_destination)
    ? !(equal[axal[myth]] (unpin attempt.before) (sovereign_peek attempt.destination state)) (./err 'flow_stale_destination)
    = plan (unpin attempt.writer).plan
    < writes (plan attempt.destination (unpin attempt.output.result) state)
    ? !(writes.all((\ [name ignored] (pith_prefix attempt.destination name)))) (./err 'flow_writer_outside_destination)
    = provenance attempt.destination.weld(['flows 'latest])
    ? (writes.any((\ [name ignored] (equal[path] name provenance)))) (./err 'flow_writer_receipt_collision)
    < origin (cooperate/pin_link (safe 0 .x run) state)
    = receipt (myth/sing ['flow 'receipt] (flow_runtime/receipt origin (unpin attempt.definition).source)).put(system_vocabulary/content (pails/t (str/cat_all ["Produced by the frozen preview at " (path_show run)])))
    = updated (native_work/status "complete" record).put((flow/key state.self 'attempt) attempt).put(system_vocabulary/content (pails/t "Committed"))
    | ./ok writes.snoc([provenance (writ/make receipt)]).snoc([run (writ/make updated)])
  + import_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['location] ['digest] ['format] ['content] ['title]] input) (./err 'flow_invalid_arguments)
    = source (flow/source input.txt_at(['location]) input.txt_at(['digest]) input.txt_at(['format]) input.txt_at(['content]))
    ? !(and (gt source.location.len 0) (eq source.digest.len 64)) (./err 'flow_incomplete_source)
    ? ((eq source.content.len 0) || (gt source.content.len 131072)) (./err 'flow_source_size)
    = card (myth/sing ['flow 'source] source).put(system_vocabulary/lede input.pail_at(['title])).put(system_vocabulary/content (pails/t source.content))
    ? (cooperate/record target state)
     > (./some old)
      ? (equal[myth] old card) (./ok [])
      | ./err 'flow_source_is_immutable
    ? (gt (sovereign_peek target state).wyt 0) (./err 'flow_source_collision)
    | ./ok [[target (writ/make card)]]
