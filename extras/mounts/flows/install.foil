- flow_sources_ops
- flow_maintenance_ops
- grove_install
- lain_peek [at=flow_peek]

' Native flow commands and laws. No Nenex routes, example catalogue, or UI.
' Mount ownership and public operation addresses remain unchanged.
+ flow_install
  + records
    \ self=iota
    ^ row[[path myth]]
    = root (flow_ops/key self 'operations)
      commands=row[[iota namespace_op]]
        [['publish (namespace_op flow_runtime_ops/publish)]
         ['preview (namespace_op flow_runtime_ops/preview)]
         ['commit (namespace_op flow_runtime_ops/commit)]
         ['submit_revision (namespace_op flow_maintenance_ops/submit_revision)]
         ['retry_revision (namespace_op flow_maintenance_ops/retry_revision)]
         ['follow (namespace_op flow_maintenance_ops/follow)]
         ['adopt (namespace_op flow_maintenance_ops/adopt)]
         ['set_enabled (namespace_op flow_maintenance_ops/set_enabled)]
         ['detach (namespace_op flow_maintenance_ops/detach)]
         ['observe (namespace_op flow_maintenance_ops/observe)]
         ['source_failed (namespace_op flow_maintenance_ops/source_failed)]
         ['watch_sources (namespace_op flow_sources_ops/watch)]
         ['unwatch_sources (namespace_op flow_sources_ops/unwatch)]
         ['import_source (namespace_op flow_runtime_ops/import_source)]]
      operations=row[[iota flow/operation]]
        [['inventory (flow/operation ['sources] flow_operations/inventory)]
         ['combine_sources (flow/operation ['left 'right] flow_operations/combine_sources)]
         ['revise (flow/operation ['pages 'sources] flow_operations/revise)]
         ['evidence (flow/operation ['pages 'sources] flow_operations/evidence)]
         ['decompose (flow/operation ['sources] flow_operations/decompose)]
         ['documents (flow/operation ['pages 'sources] flow_operations/documents)]
         ['interactive_requests (flow/operation ['tasks 'provider] flow_request_ops/interactive_requests)]
         ['identity (flow/operation ['value] flow_operations/identity)]]
      records=row[[path myth]]
        [[(flow_ops/key self 'retain_result) (myth/sing (flow_ops/key self 'writer) (flow_runtime/writer flow_runtime_ops/retain_plan flow_runtime_ops/retain_materialize))]
         [(flow_ops/key self 'source_hand) (myth/sing system_vocabulary/form flow_sources_ops/form)]
         [(flow_ops/key self 'empty) myth/new]
         [(flow_ops/key self 'hand) (myth/sing system_vocabulary/form flow_maintenance_ops/form)]]
      records records.weld(commands.map((\ [name operation] [(flow_ops/key self name) (myth/sing system_vocabulary/op operation)])))
      records records.weld(operations.map((\ [name operation] [root.snoc(name) (myth/sing (flow_ops/key self 'operation) operation)])))
    | records
  + registrations
    \ state=namespace
    ^ row[[p=path q=writ]]
    = cards (flow_install/records state.self)
      writes (cards.map((\ [name card] [name (writ/make card)])))
    | writes.keep((flow_install/changed state))
  + install
    \ state=namespace
    ^ either[iota namespace]
    | grove_install/changes (flow_install/registrations state) state
  + changed
    \ state=namespace entry=[p=path q=writ]
    ^ bool
    = [name write] entry
    ?> (./make card) write .true
    | !(equal[maybe[myth]] (cooperate_ops/record name state) (./some card))
  + compatible_runtime
    ' Rebinding code must not strand live records at another nominal moment.
    ' Frozen attempts keep their own laws; no data is rebranded here.
    \ entry=[p=path q=myth]
    ^ bool
    = [name card] entry
    ' Cells can carry configuration without owning controller progress.
    ' Validate each present slot independently; absence is not a type change.
    = claims=bool
        ?> (./some held) card.get(['flow 'claims]) .true
        ?> value=flow_maintenance/claims held .false
        .true
    = flow_config=bool
        ?> (./some held) card.get(['flow 'config]) .true
        ?> value=flow_maintenance/config held .false
        .true
    = flow_progress=bool
        ?> (./some held) card.get(['flow 'progress]) .true
        ?> value=flow_maintenance/progress held .false
        .true
    = feed=bool
        ? !(card.has(limb_slot)) .true
        ?> (./some held) card.get(['flow 'feed]) .true
        ?> value=flow_maintenance/feed held .false
        .true
    | row/all[bool] (\ checked checked) [claims flow_config flow_progress feed]
  + compatible
    ' Claims already identify the controllers whose flow hand is rebound.
    ' Inspect those records and their bound source feeds, not every application
    ' record in the authority. Other owners validate their own retained types.
    \ state=namespace
    ^ bool
    ?> (./some registry) (cooperate_ops/record (flow_ops/key state.self 'claims) state) .true
    ?> claims=flow_maintenance/claims registry.pail_at(['flow 'claims]) .false
    | claims.entries.tap.all
      \ [destination controller]
      ?> (./some record) (cooperate_ops/record controller state) .false
      ?> config=flow_maintenance/config record.pail_at(['flow 'config]) .false
      ?> progress=flow_maintenance/progress record.pail_at(['flow 'progress]) .false
      ? !(equal[path] destination config.destination) .false
      = view=path controller.snoc('view)
      ? !(flow_install/compatible_runtime [view (cooperate_ops/record view state).fall(myth/new)]) .false
      | (unpin config.request).tap.all
        \ [slot held]
        ? !(and (eq slot.len 2) (eq_iota slot.at(0) 'input)) .true
        ?> reference=safe held .false
        | flow_install/compatible_source reference state
  + compatible_source
    \ reference=safe state=namespace
    ^ bool
    ? (gt reference.ver 0) .true
    = owner=maybe[path]
        ? (is_xv reference.path)
          ?> (./some found) (flow_peek/cell_address 0 reference.path.drop(1) (flow_peek/sovereign_reader state)) .none
          = [name relative] found
          | ./some name
        | ./some reference.path
    ?> (./some owner) owner .true
    ' Historical/overlay readings do not select a current physical feed owner.
    ? !(state.permitted(owner)) .true
    = source (cooperate_ops/record owner state).fall(myth/new)
    ?> forms=kook source.pail_at(limb_slot) .true
    ? !(forms.refs.has((flow_ops/key state.self 'source_hand))) .true
    | flow_install/compatible_runtime [owner source]
