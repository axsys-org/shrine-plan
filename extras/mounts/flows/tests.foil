- flows_mount
- helm
- testing
- tests/namespace [at=fixture]
- apps/nenex/main [at=wiki]
- json [at=fixture_json]
- nenex_editor

+ flow_tests
  + initial
    ^ namespace
    = base (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
    = [seed index reply] (helm/supervisor/step [($x 17) 'app 'nenex 'kook 'doc]
        (writ/make (myth/sing system_vocabulary/form wiki/doc_form)) 0 0 base (sovereign_hive base))
      [seed index reply] (helm/supervisor/step [($x 17) 'app 'nenex 'kook 'hub]
        (writ/make (myth/sing system_vocabulary/form wiki/hub_form)) 0 0 seed (sovereign_hive seed))
      [seed index reply] (helm/supervisor/step [($x 17) 'app 'nenex 'w]
        (writ/make (myth/sing limb_slot (kook [[($x 17) 'app 'nenex 'kook 'hub]]))) 0 0 seed (sovereign_hive seed))
    ? (flows_mount/install seed)
     > (./ok state) state
     > (./err cause) (Seq[namespace] (error cause) seed)
  + author
    ^ path
    [($x 17) 'app 'nenex 'w 'flow_spec]
  + destination
    ^ path
    [($x 17) 'app 'nenex 'w 'flow_book]
  + definition
    ^ path
    | (flow_tests/author).weld(['flows 'handbook])
  + run
    ^ path
    | (flow_tests/definition).weld(['work 'first])
  + input_path
    ^ path
    [($x 17) 'user 'flow_sources 'readme]
  + get
    \ name=path state=namespace
    ^ myth
    | (cooperate/record name state).fall(myth/new)
  + apply
    \ operation=iota target=path input=myth state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit
        (namespace_command/plan target (flow/key state.self operation) input)
        state (sovereign_hive state))
    next
  + poke
    \ target=path input=myth state=namespace
    ^ namespace
    = write (? (maybe/is_some (cooperate/record target state)) (writ/poke input) (writ/make input))
    = [next index reply] (helm/supervisor/step target write 0 0 state (sovereign_hive state))
    next
  + reason
    \ result=either[iota row[[p=path q=writ]]]
    ^ str
    ? result
     > (./err why) (str/from_atom (quip_val why))
    "ok"
  + book_source
    \ title=nat
    ^ str
    | str/from_atom (joined 10
      [";. /author" "  ;@ /flow/definition handbook" "  ;= Handbook flow"
       "    ;@ /flow/input sources" "    ;= Source input"
       "    ;@ /flow/step checked ;/0x11/gov/flows/operations/inventory"
       "    ;@ /flow/bind sources sources" "    ;= Check"
       "    ;@ /flow/step decomposed ;/0x11/gov/flows/operations/decompose"
       "    ;@ /flow/bind sources checked" "    ;= Decompose"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/documents"
       "    ;@ /flow/bind pages document" "    ;@ /flow/bind sources decomposed" "    ;= Sew"
       "    ;@ /flow/result pages" "    ;= Result"
       "    ;@ /flow/page /" "    ;@ /flow/uses readme" (cord/cat "    ;= " title)
       "      Authored instructions." "    ;@ /flow/page child" "    ;= Child document"
       "      Child content."])
  + prepared
    ^ namespace
    = imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record flow_tests/initial)
      authored (flow_tests/apply 'author flow_tests/author ((myth/sing ['source] (pails/t (flow_tests/book_source "First title")))).put(['expected] (pails/n 0)) imported)
      request (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x flow_tests/author).fall(0)))
    | flow_tests/apply 'publish flow_tests/author request authored
  + source_record
    ^ myth
    | (myth/sing ['location] (pails/t "README.md")).put(['digest] (pails/t (str/repeat 64 "a"))).put(['format] (pails/t "md")).put(['content] (pails/t "# Source material")).put(['title] (pails/t "Readme"))
  + preview_request
    ^ myth
    | (myth/sing ['id] (pails/t "first")).put(['destination] (pails/p flow_tests/destination)).put(['writer] (safe 0 .x [($x 17) 'gov 'flows 'nenex])).put(['input 'sources] (safe 0 .z [($x 17) 'user 'flow_sources]))
  + source
    ^ str
    | flow_tests/identity_source "value" "values"
  + identity_source
    \ port=nat value=nat
    ^ str
    | str/from_atom (joined 10
      [";. /example" "  ;@ /flow/definition example" "  ;= Example flow"
       "    ;@ /flow/input values" "    ;= Input"
       "    ;@ /flow/step copied ;/0x11/gov/flows/operations/identity"
       (cord/cat_all ["    ;@ /flow/bind " port " " value]) "    ;= Copy"
       "    ;@ /flow/result copied" "    ;= Result"])
  + compilation
    \ ignored=unit
    ^ row[testing/check]
    = compiled (flow/compile 'example (safe 1 .x [($x 17) 'source]) flow_tests/source flow_tests/initial)
    ? compiled
     > (./err why) [(testing/text "compiled flow" "ok" (str/from_atom (quip_val why)))]
     > (./ok definition)
      = value (axal/new[myth] (./some (myth/sing ['amount] (pails/n 42))))
        inputs (axal/new[axal[myth]] .none).put(['values] value)
        run (flow/evaluate definition inputs)
        correct
          ? run
           > (./ok result) (equal[axal[myth]] (unpin result.result) value)
          .false
      [(testing/nat "authored Semidoc compiles a pinned operation" 1 definition.steps.len)
       (testing/nat "ordinary tree input is reusable" 1 correct)
       (testing/nat "operation has a captured definition moment" 1 (gt definition.steps.at(0).origin.ver 0))]
  + compile_reason
    \ source=str
    ^ str
    ? (flow/compile 'example (safe 1 .x [($x 17) 'source]) source flow_tests/initial)
     > (./err why) (str/from_atom (quip_val why))
    "ok"
  + input_names
    \ state=namespace
    ^ str
    ?> (./some held) (flow_tests/get flow_tests/definition state).get((flow/key state.self 'definition)) "missing"
    ?> definition=flow/definition held "invalid"
    | path_show definition.inputs
  + one_commit
    \ epoch=nat state=namespace
    ^ bool
    ?> (./some held) (flow_tests/get [state.self 'log ($u epoch)] state).get(system_vocabulary/content) .false
    ?> event=namespace_event held .false
    = changes (unpin event.changes)
    | and (changes.has(flow_tests/destination))
      (and (changes.has((flow_tests/destination).weld(['flows 'latest]))) (changes.has(flow_tests/run)))
  + invalid
    \ ignored=unit
    ^ row[testing/check]
    = duplicate (str/cat_all [flow_tests/source (str/from_atom (joined 10 ["" "    ;@ /flow/input values" "    ;= Duplicate"]))])
      stale (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n 0))
    [(testing/text "plain prose does not define an executable flow" "flow_definition_not_unique" (flow_tests/compile_reason ";. /note"))
     (testing/text "duplicate names rejected" "flow_duplicate_name" (flow_tests/compile_reason duplicate))
     (testing/text "forward bindings rejected" "flow_unbound_value" (flow_tests/compile_reason (flow_tests/identity_source "value" "later")))
     (testing/text "port contract checked" "flow_port_mismatch" (flow_tests/compile_reason (flow_tests/identity_source "wrong" "values")))
     (testing/text "noncanonical names refuse before execution" "flow_invalid_name" (flow_tests/compile_reason (flow_tests/identity_source "value" "bad-name")))
     (testing/text "invalid source paths refuse before document admission" "flow_invalid_document_path" (flow_tests/reason (flow_nenex/author flow_tests/author (myth/sing ['source] (pails/t ";. /bad-name")) flow_tests/initial)))
     (testing/text "stale publication rejected" "flow_stale_source" (flow_tests/reason (flow_runtime/publish flow_tests/author stale flow_tests/prepared)))]
  + is_reference
    \ node=snode
    ^ bool
    ? node
     > (./ref _ _) .true
    .false
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = prepared flow_tests/prepared
      preview (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request prepared)
      retry (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request preview)
      conflict (flow_runtime/preview flow_tests/definition ((flow_tests/preview_request).put(['destination] (pails/p [($x 17) 'app 'nenex 'w 'elsewhere]))) preview)
      frozen (flow_tests/get (row/cons[iota] 'x ((flow_tests/run).snoc('result))) preview)
      committed (flow_tests/apply 'commit flow_tests/run myth/new preview)
      repeated (flow_tests/apply 'commit flow_tests/run myth/new committed)
      page (flow_tests/get flow_tests/destination committed)
      child (flow_tests/get ((flow_tests/destination).snoc('child)) committed)
    [(testing/text "published input names retained" "/sources" (flow_tests/input_names prepared))
     (testing/text "preview planned" "ok" (flow_tests/reason (flow_runtime/preview flow_tests/definition flow_tests/preview_request prepared)))
     (testing/nat "preview creates no destination" 0 (sovereign_peek flow_tests/destination preview).wyt)
     (testing/nat "preview result is an ordinary readable cell" 1 frozen.has(['flow 'page]))
     (testing/nat "preview retry does not write" 1 (equal preview retry))
     (testing/text "changed retry input refuses" "flow_run_id_conflict" (flow_tests/reason conflict))
     (testing/nat "root page uses authored template" 1 (cord/has "First title" (str/to_atom page.txt_at(['src]))))
     (testing/nat "child page is a real document" 1 (cord/has "Child content" (str/to_atom child.txt_at(['src]))))
     (testing/nat "reference is decomposed rather than a Markdown literal" 0 (cord/has "# Source material" (str/to_atom (flow_tests/get ((flow_tests/destination).weld(['reference 'readme])) committed).txt_at(['src]))))
     (testing/nat "result and receipt share the admitted event before hand reactions" 1 (flow_tests/one_commit preview.local.top.inc committed))
     (testing/nat "commit retry is idempotent" 1 (equal committed repeated))]
  + stale
    \ ignored=unit
    ^ row[testing/check]
    = preview (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      changed (flow_tests/poke flow_tests/input_path (myth/sing ['note] (pails/t "changed")) preview)
      refused (flow_tests/apply 'commit flow_tests/run myth/new changed)
      competing (flow_tests/poke ((flow_tests/destination).snoc('notes)) (myth/sing ['text] (pails/t "a user note")) preview)
      immutable (flow_runtime/import_source flow_tests/input_path ((flow_tests/source_record).put(['content] (pails/t "Changed source"))) preview)
    [(testing/text "changed input refuses" "flow_stale_input" (flow_tests/reason (flow_runtime/commit flow_tests/run myth/new changed)))
     (testing/nat "stale refusal makes no partial writes" 1 (equal refused changed))
     (testing/text "changed destination refuses" "flow_stale_destination" (flow_tests/reason (flow_runtime/commit flow_tests/run myth/new competing)))
     (testing/text "source snapshots are immutable" "flow_source_is_immutable" (flow_tests/reason immutable))]
  + refresh
    \ ignored=unit
    ^ row[testing/check]
    = preview (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      first (flow_tests/apply 'commit flow_tests/run myth/new preview)
      notes (flow_tests/poke ((flow_tests/destination).snoc('notes)) (myth/sing ['text] (pails/t "Keep this")) first)
      edited (flow_tests/poke flow_tests/author (myth/sing ['src] (pails/t (flow_tests/book_source "Second title"))) notes)
      request (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n edited.case(.x flow_tests/author).fall(0)))
      published (flow_tests/apply 'publish flow_tests/author request edited)
      second_request ((flow_tests/preview_request).put(['id] (pails/t "second")))
      second (flow_tests/apply 'preview flow_tests/definition second_request published)
      complete (flow_tests/apply 'commit ((flow_tests/definition).weld(['work 'second])) myth/new second)
      manual (flow_tests/poke flow_tests/destination (myth/sing ['src] (pails/t ";.\n  User changed the generated prose.")) complete)
    [(testing/nat "new Semidoc authoring changes generated output" 1 (cord/has "Second title" (str/to_atom (flow_tests/get flow_tests/destination complete).txt_at(['src]))))
     (testing/text "named annotation survives refresh" "Keep this" (flow_tests/get ((flow_tests/destination).snoc('notes)) complete).txt_at(['text]))
     (testing/nat "old attempt retains its frozen definition/result" 1 (equal (flow_tests/get flow_tests/run first) (flow_tests/get flow_tests/run complete)))
     (testing/text "generated edits are protected" "flow_generated_page_edited" (flow_tests/reason (flow_runtime/preview flow_tests/definition (second_request.put(['id] (pails/t "third"))) manual)))]
  + controller
    ^ path
    [($x 17) 'user 'flow_maintenance 'test]
  + follow_request
    ^ myth
    | (flow_tests/preview_request).del(['id]).put(['definition] (safe 0 .x flow_tests/definition))
  + automatic
    ^ namespace
    | flow_tests/apply 'follow flow_tests/controller flow_tests/follow_request flow_tests/prepared
  + progress
    \ state=namespace
    ^ flow_maintenance/progress
    ?> (./some held) (flow_tests/get flow_tests/controller state).get(['flow 'progress])
      | flow_maintenance/progress .false 0 .none (pin flow/empty) (./some 'missing)
    ?> progress=flow_maintenance/progress held
      | flow_maintenance/progress .false 0 .none (pin flow/empty) (./some 'bad)
    progress
  + change_source
    \ text=str state=namespace
    ^ namespace
    = source (flow/source "README.md" (str/repeat 64 "b") "md" text)
    | flow_tests/poke flow_tests/input_path (myth/sing ['flow 'source] source) state
  + maintained
    \ ignored=unit
    ^ row[testing/check]
    = first flow_tests/automatic
      repeated (flow_tests/apply 'follow flow_tests/controller flow_tests/follow_request first)
      changed (flow_tests/change_source "Changed evidence" first)
      same (flow_tests/change_source "Changed evidence" changed)
      notes (flow_tests/poke ((flow_tests/destination).snoc('notes)) (myth/sing ['text] (pails/t "Keep this note")) changed)
      next (flow_tests/change_source "Changed again" notes)
      old_result (sovereign_care .z (row/cons[iota] 'x ((flow_tests/controller).weld(['work ($u 1) 'result]))) next)
      claimed (flow_maintenance/follow ((flow_tests/controller).snoc('other)) flow_tests/follow_request next)
    [(testing/nat "hand materializes its initial spun proposal" 1 (flow_tests/progress first).generation)
     (testing/nat "follow retries do not write" 1 (equal first repeated))
     (testing/nat "changed input runs exactly once" 2 (flow_tests/progress changed).generation)
     (testing/nat "identical input and own writes do not feed back" 2 (flow_tests/progress same).generation)
     (testing/nat "notes alone do not rerun" 2 (flow_tests/progress notes).generation)
     (testing/text "notes survive automatic refresh" "Keep this note" (flow_tests/get ((flow_tests/destination).snoc('notes)) next).txt_at(['text]))
     (testing/nat "reference source refreshes automatically" 1 (cord/has "Changed again" (str/to_atom (flow_tests/get ((flow_tests/destination).weld(['reference 'readme])) next).txt_at(['src]))))
     (testing/nat "old automatic result remains frozen" 1 (cord/has "Source material" (str/to_atom old_result.gut(['reference 'readme] myth/new).txt_at(system_vocabulary/content))))
     (testing/text "competing materializer refused" "flow_destination_claimed" (flow_tests/reason claimed))]
  + automatic_controls
    \ ignored=unit
    ^ row[testing/check]
    = first flow_tests/automatic
      paused (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .false)) first)
      pending (flow_tests/change_source "While paused" paused)
      resumed (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .true)) pending)
      edited (flow_tests/poke flow_tests/destination (myth/sing ['src] (pails/t ";.\n  Manual prose.")) resumed)
      blocked (flow_tests/change_source "Conflicting source" edited)
      restore (flow_tests/get flow_tests/destination resumed).pail_at(['src])
      repaired (flow_tests/poke flow_tests/destination (myth/sing ['src] restore) blocked)
      authored (flow_tests/poke flow_tests/author (myth/sing ['src] (pails/t (flow_tests/book_source "Republished title"))) repaired)
      publish (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x flow_tests/author).fall(0)))
      published (flow_tests/apply 'publish flow_tests/author publish authored)
      detached (flow_tests/apply 'detach flow_tests/controller myth/new published)
      detached_change (flow_tests/change_source "After detach" detached)
      revive (flow_maintenance/set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .true)) detached_change)
    [(testing/nat "paused hand does not materialize" 1 (flow_tests/progress pending).generation)
     (testing/nat "resume catches up once" 2 (flow_tests/progress resumed).generation)
     (testing/nat "conflict retains generation" 2 (flow_tests/progress blocked).generation)
     (testing/nat "conflict is visible in hand state" 1 (equal[maybe[iota]] (./some 'flow_generated_page_edited) (flow_tests/progress blocked).reason))
     (testing/text "conflict preserves manual prose" (flow_tests/get flow_tests/destination edited).txt_at(['src]) (flow_tests/get flow_tests/destination blocked).txt_at(['src]))
     (testing/nat "fixing destination retries pending input" 3 (flow_tests/progress repaired).generation)
     (testing/nat "published Semidoc revision refreshes output" 1 (cord/has "Republished title" (str/to_atom (flow_tests/get flow_tests/destination published).txt_at(['src]))))
     (testing/nat "detach stops changes and retains generations" (flow_tests/progress published).generation (flow_tests/progress detached_change).generation)
     (testing/text "detached controller cannot steal a released claim" "flow_controller_detached" (flow_tests/reason revive))]
  + observed_sources
    \ ignored=unit
    ^ row[testing/check]
    = feed=path [($x 17) 'user 'observed_sources]
      request (myth/sing ['source] (safe 0 .z [($x 17) 'user 'flow_sources]))
      observed (flow_tests/apply 'observe feed request flow_tests/prepared)
      follow (flow_tests/follow_request).put(['input 'sources] (safe 0 .z feed.cons('x)))
      attached (flow_tests/apply 'follow flow_tests/controller follow observed)
      changed (flow_tests/change_source "New scan" attached)
      refreshed (flow_tests/apply 'observe feed request changed)
      repeated (flow_tests/apply 'observe feed request refreshed)
      failed (flow_tests/apply 'source_failed feed (myth/sing ['reason] (pails/t "Missing file")) repeated)
      recovered (flow_tests/apply 'observe feed request failed)
      removal=writ .cull
      [missing index reply] (helm/supervisor/step flow_tests/input_path removal 0 0 refreshed (sovereign_hive refreshed))
      refused (flow_maintenance/observe feed request missing)
    [(testing/nat "source feed uses an ordinary spun" 1 (flow_tests/progress attached).generation)
     (testing/nat "partial scan cannot change captured feed" 1 (flow_tests/progress changed).generation)
     (testing/nat "publishing a complete observation wakes the hand" 2 (flow_tests/progress refreshed).generation)
     (testing/nat "identical observation is a no-op" 1 (equal refreshed repeated))
     (testing/nat "source failure blocks without overwriting output" 2 (flow_tests/progress failed).generation)
     (testing/nat "source failure is visible" 1 (maybe/is_some (flow_tests/progress failed).reason))
     (testing/nat "same source can recover after an observation error" 1 (maybe/is_none (flow_tests/progress recovered).reason))
     (testing/nat "missing capture refuses publication" 1 (either/is_err refused))]
+ flow_documentation_tests
  + source
    ^ str
    | str/from_atom (joined 10
      ["# Example guide" "" "Use `values` with **care**." ""
       "## Authoring contract" "" "- Keep the source" "  Keep its provenance too." ""
       "| Attribute | Meaning |" "| --- | --- |" "| `mode` | `x|y` or default |" ""
       "```foil" "## This stays inside the example" ";@ /doc/interpret_as /formats/test" "```" ""
       "### Details" "" "Nested guidance." ""
       "## Authoring contract" "" ";@ /doc/interpret_as /formats/test"])
  + page
    \ name=path tree=axal[myth]
    ^ flow/page
    ?> (./some held) tree.gut(name myth/new).get(['flow 'page]) (flow/page "missing" [] [])
    ?> page=flow/page held (flow/page "missing" [] [])
    page
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = source (flow/source "guide.md" (str/repeat 64 "a") "md" flow_documentation_tests/source)
      card (myth/sing ['flow 'source] source).put(system_vocabulary/lede (pails/t "Source guide"))
      sources=axal[myth] (flow/empty).put(['manual] card)
      decomposed (flow_operations/decompose ((flow/empty).rep(['sources] sources)))
    ?> (./ok structured) decomposed [(testing/text "decomposition" "ok" "failed")]
    = page (flow/page "Handbook" [] ['manual])
      pages (flow/empty).put([] (myth/sing ['flow 'page] page))
      composed (flow_operations/documents ((flow/empty).rep(['sources] structured).rep(['pages] pages)))
    ?> (./ok output) composed [(testing/text "composition" "ok" "failed")]
    = overview (flow_documentation_tests/page ['reference 'manual] output)
      chapter (flow_documentation_tests/page ['reference 'manual 'section_authoring_contract] output)
      duplicate (flow_documentation_tests/page ['reference 'manual 'section_authoring_contract_2] output)
      flattened (flow/flatten chapter.body)
      text (unparse chapter.body)
      inert (parse (unparse duplicate.body))
      unsafe=bool
        | (flow/flatten inert).any((\ node (gt (attrs_of node).keep((\ attr (equal[row[nat]] attr.pred ["doc" "interpret_as"]))).len 0)))
      literal=bool
        | flattened.any
          \ node=snode
          ? node
           > (./lit _ _ body) (cord/has "## This stays inside the example" body)
          .false
      item=bool
        | flattened.any
          \ node=snode
          ? node
           > (./item lead _ _) (eq lead "mode")
          .false
    [(testing/text "Markdown title becomes the source guide title" "Example guide" (str/from_atom overview.title))
     (testing/nat "top-level sections become named child documents" 1 (output.has(['reference 'manual 'section_authoring_contract])))
     (testing/text "repeated headings get distinct document addresses" "Authoring contract" (str/from_atom duplicate.title))
     (testing/nat "table rows become native items" 1 item)
     (testing/nat "pipe inside inline code stays in its cell" 1 (cord/has "x|y or default" text))
     (testing/nat "fenced examples remain opaque literals" 1 literal)
     (testing/nat "nested headings remain native sections" 1 (cord/has ";= Details" text))
     (testing/nat "rune-looking imported prose cannot supply executable attributes" 0 unsafe)
     (testing/nat "quoted prose remains valid native rich text" 1 (rich_valid inert))
     (testing/nat "raw source is retained unchanged in the input envelope" 1 (equal[maybe[pail]] card.get(['flow 'source]) structured.gut(['manual] myth/new).get(['flow 'source])))
     (testing/nat "incomplete fence refuses instead of swallowing remaining text" 1 (either/is_err (flow_markdown/parse "```foil")))
     (testing/nat "malformed table refuses instead of dropping a column" 1 (either/is_err (flow_markdown/parse (str/from_atom (joined 10 ["| A | B |" "| --- | --- |" "| one | two | three |"])))))]
+ flow_revision_tests
  + worker_form
    ^ path
    [($x 17) 'gov 'flows 'test_worker]
  + worker
    \ target=path request=native_work/request
    ^ myth
    | (native_work/open request.owner "test-provider" myth/new).put(limb_slot (kook [flow_revision_tests/worker_form])).put(crew_slot (cpail (crew/sing ['guard] (dep request.guard.care request.guard.path))))
  + produce
    \ b=bowl record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    ?> (./some guard) (native_work/captured_at b.crew.gut(['guard] flow/empty)) (yell [] record)
    = source (str/from_atom (joined 10 [";= Authored by a native provider" "  This concept was synthesized from its captured evidence."]))
      text (fixture_json/show (fixture_json/json/obj
        [(fixture_json/jkv "source" (fixture_json/json/str source))
         (fixture_json/jkv "note" (fixture_json/json/str "Based on readme."))]))
    | native_work/result b.here (native_work/outcome "complete" text (pin guard)) record
  + worker_hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | flow_revision_tests/produce b record
  + worker_talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_revision_tests/produce b record.meld(input)
  + hole_worker
    \ target=path request=native_work/request
    ^ myth
    | (flow_revision_tests/worker target request).put(['work 'request] request)
  + hole_produce
    \ b=bowl record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    ?> (./some guard) (native_work/captured_at b.crew.gut(['guard] flow/empty)) (yell [] record)
    ?> (./some held) record.get(['work 'request]) (yell [] record)
    ?> request=native_work/request held (yell [] record)
    = ready (cord/has "now available" (str/to_atom request.prompt))
      source=str (? ready (str/from_atom (joined 10 [";= Supported concept" "  Required evidence is now available."])) "")
      note=str (? ready "Supported by updated readme." "Readme lacks the evidence required for this concept.")
      text (fixture_json/show (fixture_json/json/obj
        [(fixture_json/jkv "source" (fixture_json/json/str source))
         (fixture_json/jkv "note" (fixture_json/json/str note))]))
    | native_work/result b.here (native_work/outcome "complete" text (pin guard)) record
  + hole_hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | flow_revision_tests/hole_produce b record
  + hole_talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_revision_tests/hole_produce b record.meld(input)
  + holes
    \ ignored=unit
    ^ row[testing/check]
    = imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record flow_tests/initial)
      authored (flow_tests/apply 'author flow_tests/author (myth/sing ['source] (pails/t flow_revision_tests/source)) imported)
      published (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x flow_tests/author).fall(0))) authored)
      installed (flow_tests/poke flow_revision_tests/worker_form (myth/sing system_vocabulary/form (def_form.set_init(native_work/wake).set_hear(flow_revision_tests/hole_hear).set_talk(flow_revision_tests/hole_talk))) published)
      provider=path [($x 17) 'gov 'flows 'test_provider]
      installed (flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider flow_revision_tests/hole_worker)) installed)
      followed (flow_tests/apply 'follow flow_tests/controller (flow_tests/follow_request).put(['provider] (safe 0 .x provider)) installed)
      first=path (flow_revision_tests/request 1)
      old=flow_work/request
        ?> (./some held) (flow_tests/get first followed).get(['flow 'request]) (flow_work/request [] 'none [] (pin (flow/task (flow/page "" [] []) (pin flow/empty))) [])
        ?> request=flow_work/request held (flow_work/request [] 'none [] (pin (flow/task (flow/page "" [] []) (pin flow/empty))) [])
        request
      unrelated_path=path (row/snoc[iota] 'unrelated (flow_tests/input_path).take((flow_tests/input_path).len.dec))
      unrelated (flow_tests/apply 'import_source unrelated_path flow_tests/source_record followed)
      repeated (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record unrelated)
      changed (flow_tests/change_source "Required evidence is now available." repeated)
      hole (flow_tests/get old.hole changed)
      latest=maybe[path]
        ?> (./some held) hole.get(['work 'hole_state]) .none
        ?> progress=native_work/hole_state held .none
        progress.attempt
      current=bool
        ?> (./some target) latest .false
        | !(equal[path] target first)
    [(testing/nat "model can explicitly leave concept unresolved" 1 (equal[pail] (pails/q 'flow_revision_unresolved) (flow_tests/get first followed).pail_at(['flow 'refused])))
     (testing/text "unresolved reason stays on subject" "Readme lacks the evidence required for this concept." (flow_tests/get old.hole followed).txt_at(['work 'reason]))
     (testing/nat "unresolved flow publishes no fabricated prose" 0 (flow_tests/progress followed).generation)
     (testing/nat "unrelated or unchanged evidence does not dispatch again" 0 (flow_tests/get (flow_revision_tests/request 3) repeated).has(['flow 'request]))
     (testing/nat "changed evidence resumes through native hands" 1 (flow_tests/progress changed).generation)
     (testing/text "same subject hole resolves after evidence arrives" "resolved" hole.txt_at(['work 'status]))
     (testing/nat "resumption links a fresh attempt" 1 current)
     (testing/nat "old attempt keeps original captured task" 1 (equal[pail] (flow_tests/get first followed).pail_at(['flow 'request]) (flow_tests/get first changed).pail_at(['flow 'request])))
     (testing/nat "publication preserves named hole annotations" 1 hole.has(['work 'hole]))]
  + automatic
    \ ignored=unit
    ^ row[testing/check]
    = imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record flow_tests/initial)
      authored (flow_tests/apply 'author flow_tests/author (myth/sing ['source] (pails/t flow_revision_tests/source)) imported)
      published (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x flow_tests/author).fall(0))) authored)
      installed (flow_tests/poke flow_revision_tests/worker_form (myth/sing system_vocabulary/form (def_form.set_init(native_work/wake).set_hear(flow_revision_tests/worker_hear).set_talk(flow_revision_tests/worker_talk))) published)
      provider=path [($x 17) 'gov 'flows 'test_provider]
      installed (flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider flow_revision_tests/worker)) installed)
      request (flow_tests/follow_request).put(['provider] (safe 0 .x provider))
      done (flow_tests/apply 'follow flow_tests/controller request installed)
      first (flow_revision_tests/request 1)
      second (flow_revision_tests/request 2)
      duplicate (flow_tests/apply 'follow flow_tests/controller request done)
    [(testing/nat "native provider resumes both concept requests without a client loop" 1 (flow_tests/progress done).generation)
     (testing/text "provider controller status" "running" (flow_tests/get flow_tests/controller done).txt_at(['work 'status]))
     (testing/text "first provider status" "complete" (flow_tests/get first.snoc('worker) done).txt_at(['work 'status]))
     (testing/nat "draft guard exposes a captured record" 1 (flow_tests/get (row/cons[iota] 'x first.snoc('guard)) done).has(['capture]))
     (testing/text "revision uses shared activity completion" "complete" (flow_tests/get first done).txt_at(['work 'status]))
     (testing/text "provider uses shared activity completion" "complete" (flow_tests/get second.snoc('worker) done).txt_at(['work 'status]))
     (testing/nat "accepted resolution is a shared frozen result" 1 (flow_tests/get first.snoc('result) done).has(['capture]))
     (testing/nat "provider follow retry is idempotent" done.local.top duplicate.local.top)]
  + source
    ^ str
    | str/from_atom (joined 10
      [";." "  ;@ /flow/definition handbook" "  ;= Concept authoring"
       "    ;@ /flow/input sources" "    ;= Evidence"
       "    ;@ /flow/step authored ;/0x11/gov/flows/operations/revise"
       "    ;@ /flow/bind pages document" "    ;@ /flow/bind sources sources" "    ;= Revise"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/evidence"
       "    ;@ /flow/bind pages authored" "    ;@ /flow/bind sources sources" "    ;= Compose"
       "    ;@ /flow/result pages" "    ;= Result"
       "    ;@ /flow/page /" "    ;@ /flow/uses readme" "    ;= Root concept" "      Explain the source."
       "    ;@ /flow/page child" "    ;@ /flow/uses readme" "    ;= Child concept" "      Give an example."])
  + prepared
    ^ namespace
    = imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record flow_tests/initial)
      authored (flow_tests/apply 'author flow_tests/author (myth/sing ['source] (pails/t flow_revision_tests/source)) imported)
      published (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x flow_tests/author).fall(0))) authored)
    | flow_tests/apply 'follow flow_tests/controller flow_tests/follow_request published
  + request
    \ n=nat
    ^ path
    | (flow_tests/controller).weld(['work ($ts (str/cat_all ["revision_" (nat/show n)]))])
  + response
    \ request=path state=namespace
    ^ myth
    = record (myth/sing ['source] (pails/t (str/from_atom (joined 10 [";= Synthesized concept" "  An explanation grounded in readme."]))))
    | record.put(['note] (pails/t "Synthesized from readme.")).put(['expected] (pails/n state.case(.x request.snoc('draft)).fall(0)))
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = first=namespace flow_revision_tests/prepared
      one=path (flow_revision_tests/request 1)
      two=path (flow_revision_tests/request 2)
      request1 (flow_revision_tests/response one first)
      half (flow_tests/apply 'submit_revision one request1 first)
      workspace (flow_tests/get (flow_tests/controller).snoc('workspace) half).txt_at(['src])
      workspace_links (flow/flatten (parse (str/to_atom workspace))).keep(flow_tests/is_reference)
      request2 (flow_revision_tests/response two half)
      ready (flow_tests/apply 'submit_revision two request2 half)
      retry (flow_tests/apply 'submit_revision two request2 ready)
      overlay (sovereign_view .z 0 (row/cons[iota] 'x one.snoc('view)) ready)
      has_overlay
        ? overlay
         > (./known tree) (and (tree.has(['document])) (gt tree.dip(['evidence]).wyt 0))
        .false
    [(testing/nat "revision requests are native hand work" 1 (flow_tests/get one first).has(['flow 'request]))
     (testing/text "first response admitted" "ok" (flow_tests/reason (flow_maintenance/submit_revision one request1 first)))
     (testing/text "second response admitted" "ok" (flow_tests/reason (flow_maintenance/submit_revision two request2 half)))
     (testing/text "completed work status" "running" (flow_tests/get flow_tests/controller ready).txt_at(['work 'status]))
     (testing/nat "briefs are not published as completed prose" 0 (flow_tests/get flow_tests/destination first).has(['src]))
     (testing/nat "partial replies do not publish a partial handbook" 0 (flow_tests/progress half).generation)
     (testing/nat "pending workspace removes completed links without duplicate tails" 1 workspace_links.len)
     (testing/nat "all replies resume downstream operations and publish" 1 (flow_tests/progress ready).generation)
     (testing/nat "concept prose differs from its editorial brief" 1 (cord/has "An explanation grounded" (str/to_atom (flow_tests/get flow_tests/destination ready).txt_at(['src]))))
     (testing/nat "retrying a response does not create another generation" ready.local.top retry.local.top)
     (testing/nat "working overlay exposes native draft and frozen evidence" 1 has_overlay)]
  + refusals
    \ ignored=unit
    ^ row[testing/check]
    = first=namespace flow_revision_tests/prepared
      request=path (flow_revision_tests/request 1)
      reply (flow_revision_tests/response request first)
      edited (flow_tests/poke request.snoc('draft) (myth/sing ['src] (pails/t ";= Human draft")) first)
      changed_source (flow/source "README.md" (str/repeat 64 "b") "md" "Changed source meaning")
      changed (flow_tests/poke flow_tests/input_path (myth/sing ['flow 'source] changed_source) first)
      paused (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .false)) first)
      malicious reply.put(['source] (pails/t (str/from_atom (joined 10 [";@ /flow/step execute ;/bad" ";= Content" "  Text"]))))
      nested reply.put(['source] (pails/t (str/from_atom (joined 10 [";= Concept" "  Opening paragraph." "" "  ;= Example" "    A supported example."]))))
      siblings reply.put(['source] (pails/t (str/from_atom (joined 10 [";= Concept" "  Opening paragraph." "" ";= Example" "  A second top-level section."]))))
    [(testing/text "human draft edits win over late workers" "flow_draft_edited" (flow_tests/reason (flow_maintenance/submit_revision request reply edited)))
     (testing/text "changed captured source rejects stale prose" "flow_stale_revision" (flow_tests/reason (flow_maintenance/submit_revision request reply changed)))
     (testing/text "paused controllers cannot accept worker writes" "flow_controller_paused" (flow_tests/reason (flow_maintenance/submit_revision request reply paused)))
     (testing/text "generated prose cannot introduce executable attributes" "flow_revision_inert_content_required" (flow_tests/reason (flow_maintenance/submit_revision request malicious first)))
     (testing/text "concept subsections remain inside one document section" "ok" (flow_tests/reason (flow_maintenance/submit_revision request nested first)))
     (testing/text "sibling top-level sections are refused" "flow_revision_section_required" (flow_tests/reason (flow_maintenance/submit_revision request siblings first)))]
  + native_phase
    \ ignored=unit
    ^ row[testing/check]
    = state=namespace flow_revision_tests/prepared
      request=path (flow_revision_tests/request 1)
      record (flow_tests/get request state)
      jobs=flow_work/jobs (flow_work/jobs [] 0)
      jobs
        ?> held=flow_work/jobs (flow_tests/get flow_tests/controller state).pail_at(['flow 'jobs]) jobs
        held
      job jobs.entries.at(0).set_dispatched(.true).set_settled(.true)
      requests (flow/empty).put([request.at(request.len.dec)] record)
      settled (native_work/settle "waiting" "Needs evidence" record)
    [(testing/nat "legacy job flags cannot suppress an open native request" 1 (flow_work/undispatched requests job))
     (testing/nat "native settlement suppresses dispatch despite old flags" 0 (flow_work/undispatched requests.put([request.at(request.len.dec)] settled) job.set_dispatched(.false).set_settled(.false)))]
  + provider_refusals
    \ ignored=unit
    ^ row[testing/check]
    = state=namespace flow_revision_tests/prepared
      path=path (flow_revision_tests/request 1)
      record (flow_tests/get path state)
    ?> (./some held) record.get(['flow 'request]) [(testing/nat "fixture has revision request" 1 0)]
    ?> request=flow_work/request held [(testing/nat "fixture has typed revision request" 1 0)]
    = job (flow_work/job request.step request.target request.task path .true .false)
      guard (sovereign_care .x (row/cons[iota] 'x path.snoc('guard)) state)
    ?> (./some saved) (native_work/captured_at guard) [(testing/nat "fixture has captured guard" 1 0)]
    = input (flow_revision_tests/response path state)
      text (fixture_json/show (fixture_json/json/obj
        [(fixture_json/jkv "source" (fixture_json/json/str input.txt_at(['source])))
         (fixture_json/jkv "note" (fixture_json/json/str input.txt_at(['note])))]))
      outcome (native_work/outcome "complete" text (pin saved))
      view (sovereign_care .x (row/cons[iota] 'x (flow_tests/controller).snoc('view)) state)
      accepted (flow_maintenance/accept_outcome job record outcome guard view)
      edited (flow_tests/poke path.snoc('draft) (myth/sing ['src] (pails/t ";= Human change")) state)
      newguard (sovereign_care .x (row/cons[iota] 'x path.snoc('guard)) edited)
      stale_draft (flow_maintenance/accept_outcome job record outcome newguard view)
      changed_source (flow/source "README.md" (str/repeat 64 "b") "md" "Changed meaning")
      changed (flow_tests/poke flow_tests/input_path (myth/sing ['flow 'source] changed_source) state)
      newview (sovereign_care .x (row/cons[iota] 'x (flow_tests/controller).snoc('view)) changed)
      stale_source (flow_maintenance/accept_outcome job record outcome guard newview)
      failed (flow_maintenance/accept_outcome job record outcome.set_status("failed") guard view)
      worker (flow/empty).put([] (myth/sing ['work 'outcome] outcome))
      views=mop[path axal[myth] lt_pith] (mop/empty)
      views views.put(['worker path.at(path.len.dec)] worker)
      partial (bowl [] flow_tests/controller 0 0 flow/empty views)
      waiting (flow_maintenance/responses partial (flow_tests/get flow_tests/controller state) (flow_tests/progress state) view flow/empty)
      paused (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .false)) state)
      delivered (flow_tests/poke path.snoc('worker) (myth/sing ['work 'outcome] outcome) paused)
      resumed (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .true)) delivered)
    [(testing/text "provider result uses the native admission path" "ok" (flow_tests/reason accepted))
     (testing/text "provider cannot overwrite an edited draft" "flow_draft_edited" (flow_tests/reason stale_draft))
     (testing/text "provider cannot accept obsolete evidence" "flow_stale_revision" (flow_tests/reason stale_source))
     (testing/text "failed provider cannot publish partial text" "flow_worker_failed" (flow_tests/reason failed))
     (testing/nat "worker news waits for its request dependency" 1 (maybe/is_none waiting))
     (testing/nat "paused hand retains completed provider output without accepting it" 0 (flow_tests/get path delivered).has(['flow 'response]))
     (testing/nat "resume accepts a still-current completed provider result" 1 (flow_tests/get path resumed).has(['flow 'response]))]
+ maintenance_cell_tests
  + colliding_writer
    \ destination=path output=axal[myth] before=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    < writes (flow_nenex/materialize destination output before)
    | ./ok writes.snoc([destination.weld(['cells 'maintenance]) (writ/make myth/new)])
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state flow_tests/automatic
      target (flow_tests/destination).weld(['cells 'maintenance])
      edited (flow_tests/poke target (myth/sing ['user_note] (pails/t "Preserve this")) state)
      next (flow_tests/change_source "Changed again" edited)
      foreign (flow/empty).put(['cells 'maintenance] (myth/sing ['user_note] (pails/t "Another cell")))
      refused (flow_maintenance/surface_write flow_tests/controller foreign)
      controller (flow_tests/get flow_tests/controller next)
    ?> config=flow_maintenance/config controller.pail_at(['flow 'config]) [(testing/nat "controller config" 1 0)]
    = writer (flow_runtime/writer flow_nenex/plan maintenance_cell_tests/colliding_writer)
      changed (flow_tests/poke flow_tests/controller (myth/sing ['flow 'config] config.set_writer((pin writer))) next)
      collision (flow_tests/change_source "Writer collision" changed)
    [(testing/nat "source refresh publishes" 2 (flow_tests/progress next).generation)
     (testing/text "maintenance cell retains annotations" "Preserve this" (flow_tests/get target next).txt_at(['user_note]))
     (testing/nat "foreign cell refuses adoption" 1 (either/is_err refused))
     (testing/nat "writer collision does not publish" 2 (flow_tests/progress collision).generation)
     (testing/nat "writer collision has explicit reason" 1 (equal (flow_tests/progress collision).reason (maybe/some[iota] 'flow_writer_cell_collision)))
     (testing/text "writer collision preserves existing cell" "Preserve this" (flow_tests/get target collision).txt_at(['user_note]))]

+ flow_source_tests
  + sources
    \ ignored=unit
    ^ row[testing/check]
    = envelope (json/obj [(jkv "location" (json/str "README.md"))
        (jkv "digest" (json/str "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
        (jkv "title" (json/str "Source")) (jkv "format" (json/str "md")) (jkv "content" (json/str "Evidence"))])
      text (show (json/obj [(jkv "readme" envelope)]))
      bytes (add (str/to_atom text) (bex (mul 8 text.len)))
      decoded (flow_sources/decode bytes)
      record decoded.get(['readme]).fall(myth/new)
      mount=path [($x 17) 'io 'fs 'capture_test]
      bundle=path [($x 17) 'io 'fs 'capture_test 'bundle]
      feed=path [($x 17) 'user 'captured_sources]
      cell (myth/sing bond/weft (spun flow_maintenance/source_view .none)).put(bond/tack (safe 0 .x (flow/key ($x 17) 'empty)))
      cell cell.put(['source] (safe 0 .x bundle)).put(limb_slot (kook [(flow/key ($x 17) 'source_hand)]))
      cell cell.put(crew_slot (cpail ((crew/sing ['bundle] (dep .x bundle)).put(['mount] (dep .x mount)))))
      seeded (flow_tests/poke bundle (myth/sing bond/content (pails/n bytes)) flow_tests/initial)
      ' Supply completed driver snapshots; this fixture exercises the feed
      ' hand, not fs/talk's admission of scan completions.
      ready (fs/cfg "fixture" mount (fs/extensions (mop/empty)) [($x 17) 'kook 'fs]).del(limb_slot).put(bond/res (fs/report 0 mount ["bundle"] []))
      seeded (flow_tests/poke mount ready seeded)
      captured (flow_tests/poke feed cell seeded)
      failed (flow_tests/poke mount (myth/sing bond/res (fs/failure 1 myth/new "Unavailable")) captured)
      restored (flow_tests/poke mount ready failed)
      reading (sovereign_care .z (row/cons[iota] 'x feed) restored)
      missing (flow_tests/poke mount (myth/sing bond/res (fs/report 0 mount ["bundle"] ["bundle"])) restored)
      unknown (flow_tests/poke mount (myth/sing bond/res (fs/report 0 mount [] [])) restored)
      stale (flow_tests/poke mount (myth/sing bond/res (fs/report 1 mount ["bundle"] [])) restored)
      foreign (flow_tests/poke mount (myth/sing bond/res (fs/report 0 [($x 17) 'elsewhere] ["bundle"] [])) restored)
      returned (flow_tests/poke mount ready missing)
      request (myth/sing ['mount] (pails/p mount)).put(['source] (safe 0 .x bundle))
      other_feed=path [($x 17) 'user 'other_sources]
    [(testing/nat "filesystem envelopes become native source values" 1 record.has(['flow 'source]))
     (testing/text "capture retains its evidence identity" "README.md" record.txt_at(['location]))
     (testing/nat "re-reading identical evidence is pure and stable" 1 (equal decoded (flow_sources/decode bytes)))
     (testing/nat "missing capture cannot appear as valid evidence" 0 (flow_sources/decode 0).wyt)
     (testing/nat "native capture hand retains decoded evidence" 1 (flow_tests/get feed captured).has(['flow 'source_capture]))
     (testing/nat "failed capture hides stale evidence" 0 (sovereign_care .z (row/cons[iota] 'x feed) failed).wyt)
     (testing/nat "restoring identical evidence recovers its original reading" 1 (equal decoded reading))
     (testing/nat "removed bundle retains its stored bytes" bytes (flow_tests/get bundle missing).nat_at(bond/content 0))
     (testing/nat "removed bundle cannot expose retained bytes as live evidence" 0 (sovereign_care .z (row/cons[iota] 'x feed) missing).wyt)
     (testing/nat "unreported bundle is unavailable" 0 (sovereign_care .z (row/cons[iota] 'x feed) unknown).wyt)
     (testing/nat "obsolete scan epoch is unavailable" 0 (sovereign_care .z (row/cons[iota] 'x feed) stale).wyt)
     (testing/nat "another destination's scan is unavailable" 0 (sovereign_care .z (row/cons[iota] 'x feed) foreign).wyt)
     (testing/nat "returning identical bytes restores the feed" 1 (equal decoded (sovereign_care .z (row/cons[iota] 'x feed) returned)))
     (testing/text "watch accepts a file owned by its mount" "ok" (flow_tests/reason (flow_sources/watch other_feed request restored)))
     (testing/text "watch refuses an unrelated file" "flow_invalid_capture_source" (flow_tests/reason (flow_sources/watch other_feed request.put(['source] (safe 0 .x [($x 17) 'elsewhere 'bundle])) restored)))
     (testing/text "watch refuses a historical input disguised as live" "flow_invalid_capture_source" (flow_tests/reason (flow_sources/watch other_feed request.put(['source] (safe 1 .x bundle)) restored)))
     (testing/text "watch refuses a subtree input disguised as one file" "flow_invalid_capture_source" (flow_tests/reason (flow_sources/watch other_feed request.put(['source] (safe 0 .z bundle)) restored)))]
  + watch_ownership
    \ ignored=unit
    ^ row[testing/check]
    = a=path [($x 17) 'io 'fs 'a]
      b=path [($x 17) 'io 'fs 'b]
      one=path [($x 17) 'user 'flow_a 'sources]
      two=path [($x 17) 'user 'flow_b 'sources]
      hand=path [($x 17) 'kook 'fs]
      seed (flow_tests/poke hand (myth/sing bond/form fs/form) flow_tests/initial)
      seed (flow_tests/poke a (fs/cfg "a" a.snoc('source) (fs/extensions (mop/empty)) hand) seed)
      seed (flow_tests/poke b (fs/cfg "b" b.snoc('source) (fs/extensions (mop/empty)) hand) seed)
      input (myth/sing ['mount] (pails/p a)).put(['source] (safe 0 .x a.weld(['source ($ta "bundle")])))
      first (flow_tests/apply 'watch_sources one input seed)
      shared (flow_tests/apply 'watch_sources two input first)
      rebound_input input.put(['mount] (pails/p b)).put(['source] (safe 0 .x b.weld(['source ($ta "bundle")]))).put(['expected] (pails/n shared.case(.x one).fall(0)))
      rebound (flow_tests/apply 'watch_sources one rebound_input shared)
      detached (flow_tests/apply 'unwatch_sources two (myth/sing ['expected] (pails/n rebound.case(.x two).fall(0))) rebound)
      last (flow_tests/apply 'unwatch_sources one (myth/sing ['expected] (pails/n detached.case(.x one).fall(0))) detached)
      restored (flow_tests/apply 'watch_sources one input.put(['expected] (pails/n last.case(.x one).fall(0))) last)
    [(testing/nat "first consumer activates the existing filesystem config" 1 (fs/watch_enabled (flow_tests/get a first)))
     (testing/nat "shared consumer reuses the same config without rewriting it" shared.case(.x a).fall(0) first.case(.x a).fall(0))
     (testing/nat "rebind releases only its own native dependency" 1 (equal[maybe[path]] (flow_sources/mount_of (flow_tests/get one rebound)) (./some b)))
     (testing/nat "remaining consumer keeps old source watched" 1 (fs/watch_enabled (flow_tests/get a rebound)))
     (testing/nat "new source starts watching after rebind" 1 (fs/watch_enabled (flow_tests/get b rebound)))
     (testing/nat "last old consumer releases its watch" 0 (fs/watch_enabled (flow_tests/get a detached)))
     (testing/nat "detaching another source does not stop the new source" 1 (fs/watch_enabled (flow_tests/get b detached)))
     (testing/nat "last new consumer releases its watch" 0 (fs/watch_enabled (flow_tests/get b last)))
     (testing/nat "detached source record is retained" 1 (flow_tests/get one last).has(['source]))
     (testing/nat "detached source has no live dependency" 0 (flow_sources/mount_of (flow_tests/get one last)).is_some)
     (testing/nat "reattach starts the watch again" 1 (fs/watch_enabled (flow_tests/get a restored)))
     (testing/nat "old native source binding remains historically addressable" 1
       (equal (shared.page(.x shared.case(.x one) one)) (restored.page(.x shared.case(.x one) one))))]
  + pages
    \ ignored=unit
    ^ row[testing/check]
    = page=path [($x 17) 'app 'nenex 'w 'brief_flow]
      evidence=path [($x 17) 'app 'nenex 'w 'brief_evidence]
      cell=path page.weld(['cells 'document_source])
      input (myth/sing ['source] (safe 0 .x evidence)).put(['name] (pails/p ['document]))
      seeded (flow_tests/poke page (myth/sing ['src] (pails/t ";.\n  ;= Procedure")) flow_tests/initial)
      seeded (flow_tests/poke evidence (myth/sing ['src] (pails/t ";.\n  ;= Pending decision")) seeded)
      bound (flow_tests/apply 'bind_page_source page input seeded)
      first (sovereign_care .z (row/cons[iota] 'x cell) bound)
      repeated (flow_tests/apply 'bind_page_source page input bound)
      changed (flow_tests/poke evidence (myth/sing ['src] (pails/t ";.\n  ;= Approved decision")) bound)
      second (sovereign_care .z (row/cons[iota] 'x cell) changed)
      original=flow/source
        ?> value=flow/source first.get(['document]).fall(myth/new).pail_at(['flow 'source]) (flow/source "" "" "" "")
        value
      origin=safe
        ?> value=safe first.get(['document]).fall(myth/new).pail_at(['flow 'origin]) (safe 0 .x [])
        value
      frozen (sovereign_view origin.care origin.ver origin.path changed)
      forged first.put(['document] first.get(['document]).fall(myth/new).del(['flow 'origin]))
      inventory (flow_operations/inventory ((flow/empty).rep(['sources] first)))
      invalid (flow_operations/inventory ((flow/empty).rep(['sources] forged)))
      collided (flow_tests/poke cell (myth/sing ['src] (pails/t "Keep this")) seeded)
    [(testing/text "Nenex page binding uses native admission" "ok" (flow_tests/reason (flow_sources/bind_page page input seeded)))
     (testing/nat "Nenex evidence is an ordinary spun cell" 1 (flow_tests/get cell bound).has(bond/weft))
     (testing/nat "native evidence passes inventory without a filesystem digest" 0 (either/is_err inventory))
     (testing/nat "evidence identity is the exact historical x address" 1 (eq original.digest (path_show (safe/spell origin))))
     (testing/nat "source edits invalidate the live evidence cell" 0 (equal first second))
     (testing/nat "the prior source remains readable through native history" 1 (equal frozen (sovereign_view .x 0 evidence bound)))
     (testing/nat "repeating a source binding adds no writes" bound.local.top repeated.local.top)
     (testing/text "binding refuses an occupied source cell" "flow_source_collision" (flow_tests/reason (flow_sources/bind_page page input collided)))
     (testing/nat "native evidence cannot omit its pinned origin" 1 (either/is_err invalid))]

+ flow_retry_tests
  + retry
    \ ignored=unit
    ^ row[testing/check]
    = base=namespace flow_revision_tests/prepared
      target=path (flow_revision_tests/request 1)
      root (flow_tests/get target base)
      worker (myth/sing ['work 'outcome] (native_work/outcome "failed" "Connection ended" (pin (native_work/captured (safe 0 .x target) .none (pin flow/empty))))).put(['work 'status] (pails/t "failed"))
      failed (flow_tests/poke target.snoc('worker) worker base)
      failed (flow_tests/poke target (native_work/settle "waiting" "flow_worker_failed" root).put(['flow 'refused] (pails/q 'flow_worker_failed)) failed)
      edited (flow_tests/poke target.snoc('draft) (myth/sing ['src] (pails/t (str/from_atom (joined 10 [";= Retain this edit" "  Human wording."])))) failed)
      expected (myth/sing ['expected] (pails/n edited.case(.x target).fall(0)))
      controller=path flow_tests/controller
      native=namespace
        = [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision target expected) edited (sovereign_hive edited))
        next
      next=path (flow_revision_tests/request 3)
      repeated=namespace
        = [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision target expected) native (sovereign_hive native))
        next
      paused (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) edited)
      detached (flow_tests/apply 'detach controller myth/new edited)
      changed (flow_tests/change_source "New evidence" edited)
      newreply (flow_revision_tests/response next native)
      half (flow_tests/apply 'submit_revision next newreply native)
      done (flow_tests/apply 'submit_revision (flow_revision_tests/request 2) (flow_revision_tests/response (flow_revision_tests/request 2) half) half)
      other=path (flow_revision_tests/request 2)
      lagged (flow_tests/poke other (native_work/settle "waiting" "failed" (flow_tests/get other edited)).put(['flow 'refused] (pails/q 'flow_worker_failed)) edited)
      lag_jobs=flow_work/jobs
        ?> (./some held) (flow_tests/get controller lagged).get(['flow 'jobs]) (flow_work/jobs [] 0)
        ?> jobs=flow_work/jobs held (flow_work/jobs [] 0)
        jobs
      lagged (flow_tests/poke controller (myth/sing ['flow 'jobs] (flow_work/jobs lag_jobs.entries.keep((\ job=flow_work/job (equal[path] job.request other))) lag_jobs.serial)) lagged)
      lagged_next=namespace
        = input (myth/sing ['expected] (pails/n lagged.case(.x other).fall(0)))
          [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision other input) lagged (sovereign_hive lagged))
        next
    [(testing/text "retry uses native admission" "ok" (flow_tests/reason (flow_maintenance/retry_revision target expected edited)))
     (testing/nat "retry retains failed request exactly" 1 (equal[myth] (flow_tests/get target edited) (flow_tests/get target native)))
     (testing/nat "retry retains failed worker exactly" 1 (equal[myth] (flow_tests/get target.snoc('worker) edited) (flow_tests/get target.snoc('worker) native)))
     (testing/nat "retry preserves failed x history identity" edited.case(.x target).fall(0) native.case(.x target).fall(0))
     (testing/nat "new attempt links retained failure" 1 (equal[maybe[path]] (./some target) (flow_tests/get next native).path_at(['work 'retry_of])))
     (testing/text "retry carries the edited working draft" (flow_tests/get target.snoc('draft) edited).txt_at(['src]) (flow_tests/get next.snoc('draft) native).txt_at(['src]))
     (testing/nat "repeated retry cannot dispatch another attempt" native.local.top repeated.local.top)
     (testing/text "paused controller refuses retry" "flow_controller_paused" (flow_tests/reason (flow_maintenance/retry_revision target expected paused)))
     (testing/text "detached controller refuses retry" "flow_controller_paused" (flow_tests/reason (flow_maintenance/retry_revision target expected detached)))
     (testing/text "changed request form refuses retry" "flow_stale_request" (flow_tests/reason (flow_maintenance/retry_revision target (myth/sing ['expected] (pails/n 999)) edited)))
     (testing/text "changed evidence cannot retry old task" "flow_stale_revision" (flow_tests/reason (flow_maintenance/retry_revision target expected changed)))
     (testing/text "open requests cannot be retried" "flow_request_not_failed" (flow_tests/reason (flow_maintenance/retry_revision target (myth/sing ['expected] (pails/n base.case(.x target).fall(0))) base)))
     (testing/text "late manual completion cannot satisfy a replaced attempt" "flow_stale_revision" (flow_tests/reason (flow_maintenance/submit_revision target (flow_revision_tests/response target native) native)))
     (testing/nat "new native completion unblocks publication" 1 (flow_tests/progress done).generation)
     (testing/nat "publication leaves failed outcome intact" 1 (equal[myth] (flow_tests/get target.snoc('worker) edited) (flow_tests/get target.snoc('worker) done)))
     (testing/nat "retry links its own target when another demand also needs staging" 1 (equal[maybe[path]] (./some other) (flow_tests/get (flow_revision_tests/request 4) lagged_next).path_at(['work 'retry_of])))
     (testing/nat "other newly staged tasks cannot inherit the retry draft or link" 0 (flow_tests/get (flow_revision_tests/request 3) lagged_next).has(['work 'retry_of]))]
+ flow_fidelity_tests
  + edit
    \ command=str target=path value=str state=namespace
    ^ namespace
    = input (myth/sing ['title] (goo/text/pail (goo/text/en value))).put(['command] (pails/t command))
      input input.put(['start] (pails/t "0")).put(['end] (pails/t "0")).put(['epoch] (pails/t (nat/show state.local.top)))
      [next index reply] (helm/supervisor/admit (nenex_edit/operate ['title] target input) state (sovereign_hive state))
    next
  + compile
    \ state=namespace
    ^ either[iota flow/definition]
    | flow/compile 'handbook (safe state.case(.x flow_tests/author).fall(0) .x flow_tests/author)
        (flow_tests/get flow_tests/author state).txt_at(['src]) state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state flow_tests/prepared
      author flow_tests/author
      target author.weld([($u 0) ($u 3)])
      note author.weld(['cells 'annotation])
      state (flow_tests/poke note (myth/sing ['note] (pails/t "Keep me")) state)
      source (flow_tests/get author state).txt_at(['src])
      input (myth/sing ['src] (pails/t source)).put(['epoch] (pails/t (nat/show state.local.top)))
      [saved index reply] (helm/supervisor/admit (nenex_edit/source author input) state (sovereign_hive state))
      edited (flow_fidelity_tests/edit "save" target "Compose the authored pages" saved)
      moved (flow_fidelity_tests/edit "down" target "Compose the authored pages" edited)
      restored (flow_fidelity_tests/edit "up" author.weld([($u 0) ($u 4)]) "Compose the authored pages" moved)
    ?> (./ok original) (flow_fidelity_tests/compile state) [(testing/nat "original compiles" 1 0)]
    ?> (./ok after) (flow_fidelity_tests/compile restored) [(testing/nat "Goo-edited flow compiles" 1 0)]
    = published (flow_tests/apply 'publish author ((myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n restored.case(.x author).fall(0)))) restored)
      ' An older projection retained only the final binding. Its existing
      ' source and captured image still distinguish that loss from an edit.
      tree (sovereign_care .z author published)
      flat (flow_tests/get target published).put(['flow 'bind] (pails/t "sources decomposed"))
      oldtree tree.put(target.drop(author.len) flat)
      oldsource (flow_tests/get author published).txt_at(['src])
      baseline (wiki/document_image (str/to_atom oldsource) (pin (wiki/page_nodes oldtree)))
      writes=row[[p=path q=writ]] [[target (writ/poke (myth/sing ['flow 'bind] (pails/t "sources decomposed")))]
        [author (writ/poke (myth/sing wiki/image_slot baseline))]]
      [older index reply] (helm/supervisor/admit (\ ignored=namespace (either/ok[iota row[[p=path q=writ]]] writes)) published (sovereign_hive published))
      direct (flow_tests/poke target (myth/sing ['title] (pails/t "Direct native edit")) older)
      recovered (flow_fidelity_tests/edit "save" target "Recovered bindings" direct)
    ?> (./ok recovered_definition) (flow_fidelity_tests/compile recovered) [(testing/nat "existing authored flow still compiles" 1 0)]
    ?> (./ok direct_definition) (flow_fidelity_tests/compile direct) [(testing/nat "native record edit preserves original flow" 1 0)]
    = historical (row/all[care] (\ car (equal (namespace/page car state.case(car author) author state) (namespace/page car state.case(car author) author recovered))) [.x .y .z])
    [(testing/nat "source and Goo preserve the same operation laws and bindings" 1 (equal original.steps after.steps))
     (testing/nat "repeated ports remain independently bound" 2 after.steps.at(2).bindings.len)
     (testing/text "Goo edit was admitted" "Compose the authored pages" (str/from_atom (text_at ['title] (flow_tests/get target restored))))
     (testing/nat "edited flow publishes through the native operation" 1 (gt published.case(.x flow_tests/definition).fall(0) state.case(.x flow_tests/definition).fall(0)))
     (testing/text "old projection fixture keeps authored source" oldsource (flow_tests/get author older).txt_at(['src]))
     (testing/nat "direct native edit preserves bindings missing from old projection" 1 (equal original.steps direct_definition.steps))
     (testing/nat "Goo edit preserves bindings missing from old projection" 1 (equal original.steps recovered_definition.steps))
     (testing/nat "Goo save re-expands the complete native relation value" 1 (equal (flow_tests/get target recovered).pail_at(['flow 'bind]) (flow_tests/get target state).pail_at(['flow 'bind])))
     (testing/text "named cell survives all edits" "Keep me" (flow_tests/get note recovered).txt_at(['note]))
     (testing/nat "captured x/y/z history is unchanged" 1 historical)]

+ tests
  ^ row[testing/case]
  [(testing/case "Native revision retries" flow_retry_tests/retry)
   (testing/case "Native document evidence" flow_source_tests/pages)
   (testing/case "Shared filesystem source ownership" flow_source_tests/watch_ownership)
   (testing/case "Mounted repository evidence" flow_source_tests/sources)
   (testing/case "Semidoc and Goo flow fidelity" flow_fidelity_tests/checks)
   (testing/case "Maintenance cell ownership" maintenance_cell_tests/checks)
   (testing/case "Native work phase owns revision dispatch" flow_revision_tests/native_phase)
   (testing/case "Persistent holes resume from changed evidence" flow_revision_tests/holes)
   (testing/case "Concept authoring lifecycle" flow_revision_tests/lifecycle)
   (testing/case "Shared native provider drives authored flow" flow_revision_tests/automatic)
   (testing/case "Concept revision refusals" flow_revision_tests/refusals)
   (testing/case "Provider results retain domain admission" flow_revision_tests/provider_refusals)
   (testing/case "Source documentation decomposition" flow_documentation_tests/checks)
   (testing/case "Semidoc flow compilation" flow_tests/compilation)
   (testing/case "Invalid flow definitions" flow_tests/invalid)
   (testing/case "Native flow lifecycle" flow_tests/lifecycle)
   (testing/case "Atomic stale refusal" flow_tests/stale)
   (testing/case "Owned document refresh" flow_tests/refresh)
   (testing/case "Spun and hands maintain flows" flow_tests/maintained)
   (testing/case "Maintenance controls and conflicts" flow_tests/automatic_controls)
   (testing/case "Complete source observations" flow_tests/observed_sources)]
