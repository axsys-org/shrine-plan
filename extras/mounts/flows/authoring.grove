  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/pause)
  #on ; %/document
  controller: plain
  ! foil
  \ controller=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

