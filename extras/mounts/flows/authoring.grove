#import plain=lib/grove/types/text

document =
  @role
  src: plain

publication =
  @slot

publish =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_ops/publish)
  #on ; %/document
  id: plain
  ! foil
  \ id=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native flow publication.")) page

publish_flow =
  @view
  #on ; %/document
  #for ; %/publication
  page => group(on = page, action = %/publish, myth = { '/id = .input("") }) {
    col('/sys/slot/content) {
      text("Flow name from this page", '/sys/slot/label)
      input('/id, "text")
      action("Publish flow")
    }
  }

authoring =
  @slot

create_source =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/create_source)
  #on ; %/document
  new_name: plain
  source: plain
  ! foil
  \ new_name=str source=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

save_source =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/save_source)
  #on ; %/document
  source: plain
  ! foil
  \ source=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

inspect_callables =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/inspect_callables)
  #on ; %/document
  selection_name: plain
  scope: plain
  ! foil
  \ selection_name=str scope=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

select_step =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/select_step)
  #on ; %/document
  selection_name: plain
  mode: plain
  definition: plain
  ! foil
  \ selection_name=str mode=str definition=str page=%/document
  ^ %/document
