  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/compose)
  #on ; %/document
  name: plain
  selected_version: plain
  selected_definition: plain
  source: plain
  flow_name: plain
  step_name: plain
  result: plain
  new_inputs: plain
  bindings: plain
  ! foil
  \ name=str selected_version=str selected_definition=str source=str flow_name=str step_name=str result=str new_inputs=str bindings=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

