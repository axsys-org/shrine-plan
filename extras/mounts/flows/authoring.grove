#import plain=lib/grove/types/text

document =
  @role
  src: plain

publication =
  @slot

publish =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_ops/publish)
  #on ; %/document
  id: plain
  ! foil
  \ id=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native flow publication.")) page

publish_flow =
  @view
  #on ; %/document
  #for ; %/publication
  page => group(on = page, action = %/publish, myth = { '/id = .input("") }) {
    col('/sys/slot/content) {
      text("Flow name from this page", '/sys/slot/label)
      input('/id, "text")
      action("Publish flow")
    }
  }
