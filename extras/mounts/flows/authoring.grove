  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/adopt)
  #on ; %/document
  controller: plain
  selection: plain
  previous: plain
  ! foil
  \ controller=str selection=str previous=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

