  #on ; %/document
  id: plain
  content: plain
  context: plain
  ! foil
  \ id=str content=str context=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

delegate =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/delegate)
  #on ; %/document
  activity: plain
  id: plain
  prompt: plain
  response_schema: plain
  provider: plain
