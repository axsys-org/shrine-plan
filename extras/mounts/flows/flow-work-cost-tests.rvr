(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind context (#module foil-test-context))
(#bind driver (#module foil-new-env))

;; Warm read costs only. Compilation and world construction are excluded.
;; There is no timing threshold and this is not an end-to-end latency promise.
(define (timed label state run size count)
  (define forced (DeepSeq state 0))
  (define start (Seq forced (Now 0)))
  (define result (Seq start (run state)))
  (define end (Seq (DeepSeq result 0) (Now 0)))
  (Seq end (Seq (print ["FLOW-WORK-COST" label "retained_attempts" count
      "read_records" (size result) "elapsed_ns" (Sub end start)]) result)))

(define (check ignored)
  (define fixture (_1 (source:compile (context:files 0 ["flow_work_cost_fixture"]) 0 "flow_work_cost_fixture")))
  (define (helper name) (driver:get-perc ["flow_work_cost_fixture" name] fixture))
  (define make (helper "make"))
  (define selected (helper "selected"))
  (define prior (helper "prior_read"))
  (define size (helper "size"))
  (define warm (make 2 999))
  (define warmed (DeepSeq [(selected warm) (prior warm)] 0))
  (define (sample count)
    (define state (Seq warmed (make count count)))
    (define broad (timed "prior-subtree" state prior size count))
    (define exact (Seq (DeepSeq broad 0) (timed "current-crew" state selected size count)))
    (Seq (DeepSeq exact 0)
      (Seq (assert (Eq (Add 2 (Mul count 5)) (size broad)))
        (assert (Eq 2 (size exact))))))
  (Seq (sample 0) (Seq (sample 128) (Seq (sample 512) 1))))
(#export check)
