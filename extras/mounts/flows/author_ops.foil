- flow_nenex_ops
- apps/nenex/main [at=wiki]

' Authoring changes Semidoc itself. Published definitions and work captures
' remain ordinary retained records, untouched by editing the procedure.
+ flow_author_ops
  + select
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['name] ['mode] ['selected]] input) (./err 'flow_invalid_arguments)
    ?> (./some owner) (nenex_edit/owner target state) (./err 'flow_missing_document)
    ? !(equal[path] owner target) (./err 'flow_nenex_destination)
    < name (flow_author_ops/name ['name] input)
    = mode (str/to_atom input.txt_at(['mode]))
    ? !((eq mode "step") || (eq mode "invoke")) (./err 'flow_invalid_step)
    < selected (cooperate_ops/reference ['selected] input)
    < selected (cooperate_ops/pin_link selected state)
    < law (flow_ops/select mode selected state)
    < capture (cooperate_ops/capture selected state)
    = cell=path target.weld(['cells name])
    ? !(state.permitted(cell)) (./err 'write_outside_authority)
    ? ((maybe/is_some (state.case(.x cell))) || (gt (sovereign_peek cell state).wyt 0)) (./err 'flow_selection_collision)
    = record (native_work_ops/frozen cell capture).put(['flow 'author_mode] (pails/t (str/from_atom mode)))
    | ./ok [[cell (writ/make record)]]
  + save
    \ target=path input=myth nodes=row[snode] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some owner) (nenex_edit/owner target state) (./err 'flow_missing_document)
    ? !(equal[path] owner target) (./err 'flow_nenex_destination)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    ? !(eq input.txt_at(['source]) (nenex_edit/record target state).txt_at(['src])) (./err 'flow_stale_source)
    = source (unparse nodes)
    ? !(equal[row[snode]] nodes (wiki/src_image source)) (./err 'nenex_non_roundtrippable_edit)
    ?> (./some history) state.history(target) (./err 'nenex_not_document_content)
    = edit (myth/sing ['src] (pails/t (str/from_atom source))).put(['epoch] (pails/t (nat/show history.top)))
    | nenex_edit/source target edit state
  + name
    \ field=path input=myth
    ^ either[iota iota]
    ?> (./some names) input.path_at(field) (./err 'flow_invalid_name)
    ? !(eq names.len 1) (./err 'flow_invalid_name)
    < checked (flow_ops/name (sval/word (quip_val names.at(0))))
    ? !(equal[iota] checked names.at(0)) (./err 'flow_invalid_name)
    | ./ok checked
  + attrs
    \ node=snode attrs=row[sattr]
    ^ snode
    = attrs (attrs_back (put_attrs attrs myth/new))
    ? node
     > (./doc id _ kids) (snode/doc id attrs kids)
     > (./sect title _ kids) (snode/sect title attrs kids)
     > (./item lead _ kids) (snode/item lead attrs kids)
     > (./quote lead _ kids) (snode/quote lead attrs kids)
     > (./lit lang _ body) (snode/lit lang attrs body)
     > (./ref path _) (snode/ref path attrs)
     > (./prose text _) (snode/prose text attrs)
  + named
    \ mode=nat name=iota node=snode
    ^ bool
    = found (flow_ops/attributes mode node)
    ? !(eq found.len 1) .false
    ? !(found.at(0).vals.len) .false
    ? (flow_ops/name found.at(0).vals.at(0))
     > (./ok value) (equal[iota] name value)
    .false
  + step_named
    \ name=iota node=snode
    ^ bool
    ((flow_author_ops/named "step" name node) || (flow_author_ops/named "invoke" name node))
  + step_attrs
    \ mode=nat name=iota source=safe bindings=row[flow/binding]
    ^ row[sattr]
    = attrs=row[sattr] [(sattr ["flow" mode] [(sval/word (quip_val name)) (sval/ref (seg_texts (safe/spell source)))])]
    = attrs attrs.weld((bindings.map((\ binding=flow/binding (sattr ["flow" "bind"] [(sval/word (quip_val binding.port)) (sval/word (quip_val binding.value))])))))
    | attrs_back (put_attrs attrs myth/new)
  + rewrite
    \ name=iota attrs=row[sattr] result=iota nodes=row[snode]
    ^ row[snode]
    = recur (_ name attrs result)
    | nodes.map
      \ node=snode
      = node (nenex_edit/children node (recur (flow_ops/children node)))
      ? (flow_author_ops/step_named name node)
        = kept (attrs_of node).keep((\ attr=sattr !((equal[row[nat]] attr.pred ["flow" "step"]) || (equal[row[nat]] attr.pred ["flow" "invoke"]) || (equal[row[nat]] attr.pred ["flow" "bind"]))))
        | flow_author_ops/attrs node kept.weld(attrs)
      ? (gt (flow_ops/attributes "result" node).len 0)
        = kept (attrs_of node).keep((\ attr=sattr !(equal[row[nat]] attr.pred ["flow" "result"])))
        | flow_author_ops/attrs node kept.snoc((sattr ["flow" "result"] [(sval/word (quip_val result))]))
      node
  + region
    \ node=snode name=iota attrs=row[sattr] inputs=row[iota] result=iota
    ^ snode
    = old (flow_ops/children node)
      flat (flow_ops/flatten old)
      additions inputs.keep((\ input=iota !(flat.any((flow_author_ops/named "input" input))))).map((\ input=iota (snode/sect (quip_val input) [(sattr ["flow" "input"] [(sval/word (quip_val input))])] [])))
      kids additions.weld((flow_author_ops/rewrite name attrs result old))
      kids (? (flat.any((flow_author_ops/step_named name))) kids kids.snoc((snode/sect (quip_val name) attrs [])))
      kids (? (flat.any((\ item=snode (gt (flow_ops/attributes "result" item).len 0)))) kids kids.snoc((snode/sect "Result" [(sattr ["flow" "result"] [(sval/word (quip_val result))])] [])))
    | nenex_edit/children node kids
  + regions
    \ id=iota name=iota attrs=row[sattr] inputs=row[iota] result=iota nodes=row[snode]
    ^ row[snode]
    = recur (_ id name attrs inputs result)
    | nodes.map
      \ node=snode
      ? (flow_ops/is_region id node) (flow_author_ops/region node name attrs inputs result)
      | nenex_edit/children node (recur (flow_ops/children node))
  + bindings
    \ input=myth
    ^ either[iota row[flow/binding]]
    = entries input.tap.keep((\ entry (pith_prefix ['binding] entry.key)))
    % todo=row[mop/kv[path pail]] entries out=row[flow/binding] []
    ^ either[iota row[flow/binding]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
    ? !(eq entry.key.len 2) (./err 'flow_invalid_binding)
    < port (flow_ops/name (sval/word (quip_val entry.key.at(1))))
    ? !(equal[iota] port entry.key.at(1)) (./err 'flow_invalid_binding)
    < value (flow_author_ops/name entry.key input)
    | _ rest out.snoc((flow/binding port value))
  + compose
    ' Add or revise a named step and result in one guarded source edit. New
    ' inputs are explicit; existing input declarations and explanation survive.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = allowed=row[path] [['source] ['expected] ['flow] ['step] ['mode] ['selected] ['inputs] ['result]]
    ? !(input.tap.all((\ entry ((allowed.any((\ field=path (equal[path] field entry.key)))) || (and (eq entry.key.len 2) (pith_prefix ['binding] entry.key)))))) (./err 'flow_invalid_arguments)
    < id (flow_author_ops/name ['flow] input)
    < name (flow_author_ops/name ['step] input)
    < result (flow_author_ops/name ['result] input)
    = mode (str/to_atom input.txt_at(['mode]))
    ? !((eq mode "step") || (eq mode "invoke")) (./err 'flow_invalid_step)
    ?> (./some inputs) input.path_at(['inputs]) (./err 'flow_invalid_input)
    < checked (flow_ops/names (inputs.map((\ name=iota (sval/word (quip_val name))))))
    ? !(equal[row[iota]] inputs checked) (./err 'flow_invalid_input)
    < selected (cooperate_ops/reference ['selected] input)
    < selected (cooperate_ops/pin_link selected state)
    < law (flow_ops/select mode selected state)
    < bindings (flow_author_ops/bindings input)
    ? !(flow_ops/ports_match law.ports bindings) (./err 'flow_port_mismatch)
    < nodes (wiki/authored_nodes (sovereign_peek target state))
    = matches (flow_ops/flatten nodes).keep((flow_ops/is_region id))
    ? (gt matches.len 1) (./err 'flow_definition_not_unique)
    = attrs (flow_author_ops/step_attrs mode name selected bindings)
      updated=row[snode]
        ? matches.len (flow_author_ops/regions id name attrs inputs result nodes)
        = region (snode/sect (quip_val id) [(sattr ["flow" "definition"] [(sval/word (quip_val id))])] [])
        | flow_nenex_ops/embedded_source nodes (flow_author_ops/region region name attrs inputs result)
      source (str/from_atom (unparse updated))
    < compiled (flow_ops/compile id (safe state.case(.x target).fall(0) .x target) source state)
    | flow_author_ops/save target input updated state
