- flow_maintenance_ops
- flow_runtime_ops
- apps/nenex/main [at=wiki]
- nenex_editor

' Destination adapter: only the generated pages belong to this writer. Named
' annotations/work/cells survive; edits to generated prose cause a conflict.
- flow_nenex

+ flow_nenex_ops
  + select
    ' A selection is an ordinary frozen cell, retaining the published record.
    ' It is not a controller or another publication/lifecycle registry.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['name] ['definition]] input) (./err 'flow_invalid_arguments)
    ?> (./some owner) (nenex_edit/owner target state) (./err 'flow_missing_document)
    ? !(equal[path] owner target) (./err 'flow_nenex_destination)
    ?> (./some name) input.path_at(['name]) (./err 'flow_invalid_name)
    ? !(eq name.len 1) (./err 'flow_invalid_name)
    < checked (flow_ops/name (sval/word (quip_val name.at(0))))
    ? !(equal[iota] checked name.at(0)) (./err 'flow_invalid_name)
    = cell=path target.snoc('cells).weld(name)
      controller=path target.snoc('work).weld(name)
    ? !(and (state.permitted(cell)) (state.permitted(controller))) (./err 'write_outside_authority)
    ? ((maybe/is_some (state.case(.x cell))) || (gt (sovereign_peek cell state).wyt 0)) (./err 'flow_selection_collision)
    ? ((maybe/is_some (state.case(.x controller))) || (gt (sovereign_peek controller state).wyt 0)) (./err 'flow_controller_collision)
    < source (cooperate_ops/reference ['definition] input)
    < source (cooperate_ops/pin_link source state)
    < saved (cooperate_ops/capture source state)
    ?> (./some held) (unpin saved.value).fil.fall(myth/new).get((flow_ops/key state.self 'definition)) (./err 'flow_missing_definition)
    ?> definition=flow/definition held (./err 'flow_invalid_definition)
    | ./ok [[cell (writ/make (native_work_ops/frozen cell saved))]]
  + embedded_source
    ' Add a reference using Semidoc's own tree, preserving its authored attrs.
    \ nodes=row[snode] reference=snode
    ^ row[snode]
    ? (eq nodes.len 1)
      ? nodes.at(0)
       > (./doc id attrs kids) [(snode/doc id attrs kids.snoc(reference))]
      | nodes.snoc(reference)
    | nodes.snoc(reference)
  + embed
    ' Source editing and attachment are planned against the same namespace,
    ' then admitted together by the existing native transaction boundary.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some owner) (nenex_edit/owner target state) (./err 'flow_missing_document)
    ? !(equal[path] owner target) (./err 'flow_nenex_destination)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    ? !(eq input.txt_at(['source]) (nenex_edit/record target state).txt_at(['src])) (./err 'flow_stale_source)
    < selection (cooperate_ops/reference ['selection] input)
    ? !(and (equal[care] selection.care .x) (and (eq selection.path.len (add target.len 2)) (pith_prefix target.snoc('cells) selection.path))) (./err 'flow_invalid_selection)
    < chosen (cooperate_ops/resolve selection state)
    ?> (./some saved) (native_work_ops/captured_at chosen) (./err 'flow_invalid_selection)
    ? !(and (gt saved.source.ver 0) (equal[care] saved.source.care .x)) (./err 'flow_invalid_selection)
    ' The remaining fields are the ordinary follow input; follow validates
    ' its complete argument set, including the selected definition's ports.
    = request input.del(['selection]).del(['expected]).del(['source])
    < selected (cooperate_ops/reference ['definition] request)
    ? !(equal[safe] selected saved.source) (./err 'flow_stale_definition)
    = name selection.path.at(target.len.inc)
      controller=path target.weld(['work name])
    ? !(state.permitted(controller)) (./err 'write_outside_authority)
    ' A second embed must not change a detached or existing controller.
    ? ((maybe/is_some (state.case(.x controller))) || (gt (sovereign_peek controller state).wyt 0)) (./err 'flow_controller_collision)
    < nodes (wiki/authored_nodes (sovereign_peek target state))
    = reference (snode/ref (seg_texts controller) [(sattr ["doc" "embed"] [(sval/ref (seg_texts (flow_ops/key state.self 'occurrence_view)))])])
      nodes (flow_nenex_ops/embedded_source nodes reference)
      source (unparse nodes)
    ? !(equal[row[snode]] nodes (wiki/src_image source)) (./err 'nenex_non_roundtrippable_edit)
    ' The source case above guards the requested page record. The editor's
    ' epoch instead names the settled namespace, including source reactions.
    ?> (./some history) state.history(target) (./err 'nenex_not_document_content)
    = edit (myth/sing ['src] (pails/t (str/from_atom source))).put(['epoch] (pails/t (nat/show history.top)))
    < edits (nenex_edit/source target edit state)
    < writes (flow_maintenance_ops/follow controller request state)
    | ./ok writes.weld(edits)
  + writer
    ' Document work opts into Nenex through the selected writer record.
    ' The controller captures this declaration with the writer's exact origin.
    \ self=iota
    ^ myth
    | (myth/sing (flow_ops/key self 'writer) (flow_runtime/writer flow_nenex_ops/plan flow_nenex_ops/materialize)).put(['flow 'document] (kook [[self 'app 'nenex 'kook 'doc]]))
  + author
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['source] ['expected]] input) (./err 'flow_invalid_arguments)
    = corpus=path [state.self 'app 'nenex 'w]
    ? !(and (pith_prefix corpus target) (eq target.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(wiki/valid_page_name (quip_val target.at(corpus.len))) (./err 'flow_nenex_destination)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    = source input.txt_at(['source])
    ? ((eq source.len 0) || (gt source.len 65536)) (./err 'flow_source_limit)
    ? !(flow_ops/valid_document source) (./err 'flow_invalid_document_path)
    = form=path [state.self 'app 'nenex 'kook 'doc]
    ? (maybe/is_none (cooperate_ops/record form state)) (./err 'flow_nenex_not_installed)
    ? (cooperate_ops/record target state)
     > (./some old)
      ? !(equal[pail] old.pail_at(limb_slot) (kook [form])) (./err 'flow_page_behavior_changed)
      | ./ok [[target (writ/poke (myth/sing ['src] (pails/t source)))]]
    ? (gt (sovereign_peek target state).wyt 0) (./err 'flow_page_collision)
    | ./ok [[target (writ/make ((myth/sing ['src] (pails/t source)).put(limb_slot (kook [form]))))]]
  + source
    \ destination=path relative=path page=flow/page pages=axal[myth]
    ^ str
    = target destination.weld(relative)
      links (pages.keys.keep((\ name (and (pith_prefix relative name) (eq name.len relative.len.inc)))))
      children (links.map((\ name (snode/ref (seg_texts destination.weld(name)) []))))
      citations (page.uses.map((\ name (snode/ref (seg_texts destination.weld(['reference name])) []))))
      body page.body
      body (? children.len body.snoc((snode/sect "Child documents" [] children)) body)
      body (? citations.len body.snoc((snode/sect "Source evidence" [] citations)) body)
      provenance (snode/sect "Flow provenance" [] [(snode/ref (seg_texts destination.weld(['flows 'latest])) [])])
      body (? relative.len body body.snoc(provenance))
    | str/from_atom (unparse [(snode/doc (seg_texts target) [] [(snode/sect page.title [] body)])])
  + plan
    \ destination=path pages=axal[myth] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = form=path [state.self 'app 'nenex 'kook 'doc]
    ? (maybe/is_none (cooperate_ops/record form state)) (./err 'flow_nenex_not_installed)
    | flow_nenex_ops/materialize destination pages (sovereign_peek destination state)
  + materialize
    ' Shared pure writer: manual admission and reactive hands use the same checks.
    \ destination=path pages=axal[myth] before=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    ? !(destination.len) (./err 'flow_nenex_destination)
    = corpus=path [destination.at(0) 'app 'nenex 'w]
    ? !(and (pith_prefix corpus destination) (eq destination.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(wiki/valid_page_name (quip_val destination.at(corpus.len))) (./err 'flow_nenex_destination)
    ? (maybe/is_none pages.fil) (./err 'flow_missing_root_page)
    ? (gt pages.wyt 128) (./err 'flow_page_limit)
    = form=path [destination.at(0) 'app 'nenex 'kook 'doc]
    = owner destination.weld(['flows 'ownership])
      card before.get(['flows 'ownership])
      old=either[iota axal[str]]
        ? card
         > (./some record)
          ?> (./some held) record.get(['flow 'ownership]) (./err 'flow_ownership_collision)
          ?> ownership=flow_nenex/ownership held (./err 'flow_ownership_collision)
          | ./ok (unpin ownership.pages)
        ? !(flow_nenex_ops/only_holes destination before) (./err 'flow_destination_exists)
        | ./ok (axal/new[str] .none)
    < old old
    ? !(old.keys.all((\ name=path (pages.has(name))))) (./err 'flow_page_removal_requires_migration)
    % todo=row[[p=path q=myth]] pages.tap writes=row[[p=path q=writ]] [] saved=axal[str] (axal/new[str] .none)
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull
      | ./ok writes.snoc([owner (writ/make (myth/sing ['flow 'ownership] (flow_nenex/ownership (pin saved))))])
    = [entry rest] pair
      [name card] entry
    ? !(name.all((\ part (wiki/valid_page_name (quip_val part))))) (./err 'flow_invalid_page)
    ? (name.any((\ part (flow_ops/has part ['flows 'work 'inputs 'cells 'holes])))) (./err 'flow_reserved_page)
    ?> (./some held) card.get(['flow 'page]) (./err 'flow_missing_page)
    ?> page=flow/page held (./err 'flow_invalid_page)
    = target destination.weld(name)
      current before.get(name)
      previous old.get(name)
    ? (and (maybe/is_none previous) !(flow_nenex_ops/only_holes target before.dip(name))) (./err 'flow_page_collision)
    ? previous
     > (./some source)
      ? !(eq current.fall(myth/new).txt_at(['src]) source) (./err 'flow_generated_page_edited)
      ? !(equal[pail] current.fall(myth/new).pail_at(limb_slot) (kook [form])) (./err 'flow_page_behavior_changed)
      = source (flow_nenex_ops/source destination name page pages)
      ? (gt source.len 196608) (./err 'flow_page_size)
      ? !(rich_valid (parse (str/to_atom source))) (./err 'flow_invalid_page)
      = next (? (eq source current.fall(myth/new).txt_at(['src])) writes writes.snoc([target (writ/poke (myth/sing ['src] (pails/t source)))]))
      | _ rest next saved.put(name source)
    = source (flow_nenex_ops/source destination name page pages)
    ? (gt source.len 196608) (./err 'flow_page_size)
    ? !(rich_valid (parse (str/to_atom source))) (./err 'flow_invalid_page)
    = record (myth/sing ['src] (pails/t source)).put(limb_slot (kook [form]))
    | _ rest writes.snoc([target (writ/make record)]) saved.put(name source)
  + page_view
    ' A native page is evidence in the same world. Its identity is its exact
    ' historical x reference, not an invented filesystem digest.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> source=safe context.pail_at(bond/tack) flow_ops/empty
    ?> (./some names) context.path_at(['flow 'source_name]) flow_ops/empty
    ? !(eq names.len 1) flow_ops/empty
    = version context.nat_at(['sys 'tack 'case] 0)
      content input.fil.fall(myth/new).txt_at(['src])
    ? ((eq version 0) || (eq content.len 0) || (gt content.len 131072)) flow_ops/empty
    = origin (safe version .x source.path)
      identity (path_show (safe/spell origin))
      record (myth/sing ['flow 'source] (flow/source (path_show source.path) identity "nenex" content))
      record record.put(['flow 'origin] origin).put(['location] (pails/t (path_show source.path))).put(['digest] (pails/t identity))
      record record.put(system_vocabulary/lede (pails/t (str/from_atom (quip_val names.at(0)))))
    | (flow_ops/empty).put(names record)
  + bind_page
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['source] ['name]] input) (./err 'flow_invalid_arguments)
    < source (cooperate_ops/reference ['source] input)
    ?> (./some names) input.path_at(['name]) (./err 'flow_invalid_name)
    ? !(eq names.len 1) (./err 'flow_invalid_name)
    < name (flow_ops/name (sval/word (quip_val names.at(0))))
    = corpus=path [state.self 'app 'nenex 'w]
    ? !(and (pith_prefix corpus target) (eq target.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(and (pith_prefix corpus source.path) (ge source.path.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(and (eq source.ver 0) (equal[care] source.care .x)) (./err 'flow_invalid_page_source)
    = author (cooperate_ops/record target state).fall(myth/new)
      evidence (cooperate_ops/record source.path state).fall(myth/new)
    ? !(author.has(['src])) (./err 'flow_missing_source)
    ? !(evidence.has(['src])) (./err 'flow_missing_source)
    = cell=path target.weld(['cells ($ts (weft/cat2 (quip_val name) "_source"))])
      settings=path target.weld(['flows 'defaults])
    ? (flow_maintenance_ops/overlaps cell source.path) (./err 'flow_overlapping_input)
    ? !(and (state.permitted(cell)) (state.permitted(settings))) (./err 'write_outside_authority)
    = record (myth/sing bond/weft (spun flow_nenex_ops/page_view .none)).put(bond/tack source).put(['flow 'source_name] (pails/p [name]))
      defaults (cooperate_ops/record settings state).fall(myth/new).put(['input 'sources] (safe 0 .z (row/cons[iota] 'x cell)))
      writes=row[[p=path q=writ]]
        ? (equal[maybe[myth]] (cooperate_ops/record settings state) (./some defaults)) []
        [[settings (writ/make defaults)]]
    ? (cooperate_ops/record cell state)
     > (./some prior)
      ? !(equal[myth] prior record) (./err 'flow_source_collision)
      | ./ok writes
    ? (gt (sovereign_peek cell state).wyt 0) (./err 'flow_source_collision)
    | ./ok writes.snoc([cell (writ/make record)])
  + only_holes
    ' Unwritten subjects may already own demand annotations. These two known
    ' records are the only pre-existing content a document writer may adopt.
    \ subject=path tree=axal[myth]
    ^ bool
    | tree.tap.all
      \ [name record]
      = root=path
          ? record.has(['work 'hole]) name
          ? (and (gt name.len 0) (eq_iota name.at(name.len.dec) 'context)) name.take(name.len.dec)
          []
      ?> (./some held) tree.get(root).fall(myth/new).get(['work 'hole]) .false
      ?> hole=native_work/hole held .false
      = relative hole.subject.drop(subject.len)
      ? !(pith_prefix subject hole.subject) .false
      ? !(equal[path] root.take(relative.len) relative) .false
      ? !(and (eq root.len (add relative.len 3)) (eq_iota root.at(relative.len) 'holes)) .false
      | equal[safe] hole.context (safe 0 .z (row/cons[iota] 'x (row/snoc[iota] 'context subject.weld(root))))
