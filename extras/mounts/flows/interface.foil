- semidoc [at=flow_doc]
- flow_install
- flow_examples
- flow_operations
- flow_nenex_ops
- flow_author_ops
- flow_extract_ops
- flow_maintenance_ops
- flow_web_ops
- nenex_interface
- namespace_command
- tyshow

' Nenex forms over the published commands. No browser-owned work lifecycle.
+ flow_ui
  + records
    \ self=iota
    ^ row[[path myth]]
    = commands=row[[iota namespace_op]]
        [['refresh_harness (namespace_op flow_ui/refresh)]
         ['author (namespace_op flow_nenex_ops/author)]
         ['select (namespace_op flow_nenex_ops/select)]
         ['select_step (namespace_op flow_author_ops/select)]
         ['inspect_callables (namespace_op flow_author_ops/inspect)]
         ['compose (namespace_op flow_author_ops/compose)]
         ['extract (namespace_op flow_extract_ops/extract)]
         ['extract_trace (namespace_op flow_trace_ops/extract)]
         ['review_trace (namespace_op flow_trace_ops/review)]
         ['embed (namespace_op flow_nenex_ops/embed)]
         ['bind_page_source (namespace_op flow_nenex_ops/bind_page)]]
      records=row[[path myth]]
        [[[self 'gov 'nenex_ui 'tools 'flows] (myth/sing ['nenex 'tool] (nenex_ui/page_tool flow_ui/render))]
         [(flow_ops/key self 'nenex) (flow_nenex_ops/writer self)]
         [(flow_ops/key self 'occurrence_view) (weft_card (felt flow_ui/occurrence_html .none) [self 'app 'nenex 'w 'home] (lore/line "An embedded flow's native work, bindings, holes and controls"))]]
    | records.weld(commands.map((\ [name operation] [(flow_ops/key self name) (myth/sing system_vocabulary/op operation)])))
  + registrations
    \ state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < examples (flow_examples/registrations state)
    = cards (flow_ui/records state.self)
      writes (cards.map((\ [name card] [name (writ/make card)])))
    | ./ok (flow_install/registrations state).weld(writes).weld(examples).keep((flow_install/changed state))
  + refresh
    ' Rebind published code records through ordinary namespace admission.
    ' Application data and the native world remain outside this write set.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(equal[path] target [state.self 'gov 'flows]) (./err 'flow_invalid_refresh_target)
    ? input.tap.len (./err 'flow_invalid_arguments)
    ? !((sovereign_peek [state.self] state).tap.all(flow_install/compatible_runtime)) (./err 'flow_runtime_requires_type_migration)
    | flow_ui/registrations state
  + hidden
    \ name=nat value=nat
    ^ weft/node
    | nenex_ui/field name value
  + input
    \ name=nat label=nat value=nat required=bool
    ^ weft/node
    = attrs=row[weft/att] [(weft/att "name" name) (weft/att "value" value) (weft/att "autocomplete" "off")]
      attrs (? required attrs.snoc((weft/att "required" "required")) attrs)
    | weft/el "label" [(weft/cls "flow-field")]
      [(weft/tx label)
       (weft/el "input" attrs [])]
  + form
    \ action=nat page=path name=iota content=row[weft/node] button=nat
    ^ weft/node
    = fields=row[weft/node]
        [(flow_ui/hidden "action" action) (flow_ui/hidden "page" (show/path page))
         (flow_ui/hidden "name" (quip_val name))]
      footer=row[weft/node]
        [(weft/leaf "button" [(weft/att "type" "submit") (weft/att "disabled" "disabled")] button)
         (weft/leaf "span" [(weft/att "role" "status") (weft/att "data-flow-status" "")] "")]
    | weft/el "form" [(weft/cls "flow-form") (weft/att "method" "post") (weft/att "action" "/nenex/flows") (weft/att "data-native-flow" "")]
      fields.weld(content).weld(footer)
  + node_name
    \ node=snode
    ^ row[iota]
    = attrs (flow_ops/attributes "definition" node)
    ? !(eq attrs.len 1) []
    ? !(eq attrs.at(0).vals.len 1) []
    ? (flow_ops/name attrs.at(0).vals.at(0))
     > (./ok name) [name]
    []
  + names
    \ source=nat
    ^ row[iota]
    | row/uniq[iota] (flow_ops/flatten (flow_doc/parse source)).bind(flow_ui/node_name)
  + attached
    \ definition=path tree=axal[myth]
    ^ row[[path myth]]
    | tree.dip(['work]).tap.bind
      \ [relative record]
      ? !(eq relative.len 1) []
      ?> (./some held) record.get(['flow 'config]) []
      ?> config=flow_maintenance/config held []
      ? !(equal[path] definition config.definition) []
      | [[(row/cons[iota] 'work relative) record]]
  + controller
    \ page=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
      target=path page.weld(relative)
    ?> (./some held) record.get(['flow 'config]) []
    ?> config=flow_maintenance/config held []
    ?> (./some held) record.get(['flow 'progress]) []
    ?> progress=flow_maintenance/progress held []
    = detached (equal[pail] record.pail_at(crew_slot) (cpail (mop/empty)))
      controls (? detached (weft/leaf "p" [(weft/cls "hint")] "Detached; work and history retained.") (flow_ui/form (? progress.enabled "pause" "resume") page 'control
        [(flow_ui/hidden "controller" (show/path target))]
        (? progress.enabled "Pause maintenance" "Resume maintenance")))
      links=row[weft/node]
        [(weft/leaf "a" [(weft/href (nenex_ui/url config.destination))] "Read output")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path target)))] "Work and drafts")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns/x" (show/path (row/snoc[iota] 'view target))))] "Working overlay")]
      bindings=row[weft/node] (row/bind[mop/kv[path pail] weft/node] flow_ui/bound_input (unpin config.request).tap)
      publication=nat
        ?> origin=safe (unpin config.request).pail_at(['definition]) "Definition unavailable"
        | cord/cat "Active definition: " (show/path (? origin.ver (safe/spell origin) origin.path))
      content=row[weft/node]
        [(weft/leaf "p" [(weft/cls "flow-status")] (myth/txt_at system_vocabulary/content record))
         (weft/leaf "p" [(weft/cls "page-address")] publication)
         (weft/leaf "p" [(weft/cls "page-address")] (show/path config.destination))
         (weft/el "div" [(weft/cls "flow-links")] links) controls
         (? detached (weft/tx "") (flow_ui/form "detach" page 'detach [(flow_ui/hidden "controller" (show/path target))] "Detach and retain history"))]
      content=row[weft/node]
        ? detached content
        ?> previous=safe (unpin config.request).pail_at(['definition]) content
        | content.snoc((flow_ui/form "adopt" page 'adopt
            [(flow_ui/hidden "controller" (show/path target))
             (flow_ui/hidden "previous" (show/path (safe/spell previous)))
             (flow_ui/input "selection" "Captured replacement cell path" "" .true)
             (weft/leaf "p" [(weft/cls "hint")] "Select the revised publication into a new cell first. Adoption retains input bindings, destination, writer, provider and history. Changed input ports require a new occurrence.")]
            "Adopt selected publication"))
      pending=row[weft/node]
        ?> (./some held) record.get(['flow 'jobs]) []
        ?> jobs=flow_work/jobs held []
        | jobs.entries.bind((flow_ui/pending_work page tree))
      pending pending.weld((tree.dip(relative.snoc('work)).tap.bind((flow_ui/pending_request page target tree))))
    | content.weld(bindings.weld(pending)).snoc((nenex_ui/cell target.weld(['cells 'work]) "Live flow work"))
  + occurrence_html
    ' The embed reads the same controller subtree used by the page tools.
    \ tree=axal[myth]
    ^ myth
    = record tree.fil.fall(myth/new)
    ' The ordinary work cell already names its controller through its tack.
    ?> source=safe tree.get(['cells 'work]).fall(myth/new).pail_at(bond/tack) (frag/html "div" [] [(weft/tx "Flow occurrence unavailable")])
    = target source.path
    ? (lt target.len 2) (frag/html "div" [] [])
    = page target.take((sub target.len 2))
      relative target.drop(page.len)
      document (tree.tap.fold((axal/new[myth] .none) (\ out [name card] out.put(relative.weld(name) card))))
    | frag/html "div" [(weft/cls "flow-occurrence")] (flow_ui/controller page document [relative record])
  + pending_request
    \ page=path controller=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [name record] entry
    ? !(and (eq name.len 1) (flow_request_ops/native record)) []
    = target=path controller.snoc('work).weld(name)
      failure=str
        ?> outcome=native_work/outcome tree.get(target.snoc('worker).drop(page.len)).fall(myth/new).pail_at(['work 'outcome]) ""
        ? (eq outcome.status "complete") ""
        outcome.text
      links=row[weft/node]
        [(weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path target)))] "Retained attempt")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns/x" (show/path target.snoc('view))))] "Context lens")]
      links=row[weft/node]
        ?> (./some hole) record.path_at(['work 'hole_path]) links
        | links.snoc((weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path hole)))] "Persistent hole"))
      retry=row[weft/node]
        ? !(record.has(['flow 'refused])) []
        ? record.has(['work 'retry_requested]) []
        | [(flow_ui/form "retry" page 'retry [(flow_ui/hidden "request" (show/path target))] "Retry work")]
    | [(weft/el "details" []
      (row/weld[weft/node] [(weft/leaf "summary" [] (str/to_atom record.txt_at(system_vocabulary/lede)))
        (weft/leaf "p" [] (str/to_atom record.txt_at(['work 'status])))
        (weft/leaf "p" [] (str/to_atom record.txt_at(system_vocabulary/content)))
        (weft/leaf "p" [] (str/to_atom failure))
        (weft/el "div" [(weft/cls "flow-links")] links)] retry))]
  + pending_work
    \ page=path tree=axal[myth] job=flow_work/job
    ^ row[weft/node]
    = record tree.get(job.request.drop(page.len)).fall(myth/new)
    ? record.has(['flow 'response]) []
    = title record.txt_at(system_vocabulary/lede)
      reason record.txt_at(system_vocabulary/content)
      failure=str
        ?> (./some held) tree.get((row/snoc[iota] 'worker job.request.drop(page.len))).fall(myth/new).get(['work 'outcome]) ""
        ?> outcome=native_work/outcome held ""
        ? (eq outcome.status "complete") ""
        outcome.text
      links=row[weft/node]
        [(weft/leaf "a" [(weft/href (nenex_ui/url job.request.snoc('draft)))] "Open draft")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns/x" (show/path job.request.snoc('view))))] "Context lens")]
      links=row[weft/node]
        ?> (./some hole) record.path_at(['work 'hole_path]) links
        | links.snoc((weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path hole)))] "Persistent hole"))
    = retry=row[weft/node]
        ? !(record.has(['flow 'refused])) []
        | [(flow_ui/form "retry" page 'retry
            [(flow_ui/hidden "request" (show/path job.request))] "Retry revision")]
    | [(weft/el "details" []
        (row/weld[weft/node] [(weft/leaf "summary" [] (str/to_atom title))
         (weft/leaf "p" [] (str/to_atom reason))
         (weft/leaf "p" [] (str/to_atom failure))
         (weft/el "div" [(weft/cls "flow-links")] links)] retry))]
  + bound_input
    \ entry=mop/kv[path pail]
    ^ row[weft/node]
    = [key value] entry
    ? !(and (eq key.len 2) (eq_iota key.at(0) 'input)) []
    ?> reference=safe value []
    | [(weft/leaf "p" [(weft/cls "page-address")] (cord/cat_all ["Input " (quip_val key.at(1)) ": " (show/path reference.path)]))]
  + holes
    \ page=path tree=axal[myth]
    ^ row[weft/node]
    = items (tree.dip(['holes]).tap.bind((flow_ui/hole page)))
    ? !(items.len) []
    | [(weft/el "section" [(weft/att "aria-label" "Persistent work")]
        (row/cons[weft/node] (weft/leaf "h2" [] "Persistent work") items))]
  + hole
    \ page=path entry=[p=path q=myth]
    ^ row[weft/node]
    = [relative record] entry
    ?> (./some held) record.get(['work 'hole]) []
    ?> hole=native_work/hole held []
    ? !(equal[path] hole.subject page) []
    = links=row[weft/node]
        [(weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path hole.context.path)))] "Live context lens")]
      links=row[weft/node]
        ?> (./some attempt) record.path_at(['work 'attempt]) links
        | links.snoc((weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path attempt)))] "Current attempt"))
    | [(weft/el "details" []
        [(weft/leaf "summary" [] (cord/cat_all [(str/to_atom hole.question) " — " (str/to_atom record.txt_at(['work 'status]))]))
         (weft/leaf "p" [] (str/to_atom record.txt_at(['work 'reason])))
         (weft/el "div" [(weft/cls "flow-links")] links)])]
  + definition
    \ page=path tree=axal[myth] name=iota
    ^ weft/node
    = source tree.fil.fall(myth/new).txt_at(['src])
      target page.weld(['flows name])
      published tree.get(['flows name]).fall(myth/new)
      body=row[weft/node]
        ?> (./some held) published.get((flow_ops/key page.at(0) 'definition))
          | [(weft/leaf "p" [(weft/cls "hint")] "Unpublished. Edit and save the Semidoc source, then publish its definition here.")]
        ?> compiled=flow/definition held []
        | flow_ui/published page tree name source compiled
    | weft/el "details" [(weft/cls "flow-definition") (weft/att "open" "open")]
      body.cons((weft/leaf "summary" [] (quip_val name)))
  + publisher
    ' The ordinary Goo presentation host supplies browser interaction and
    ' reflective controls from one published declaration.
    \ page=path
    ^ weft/node
    = slot=path [page.at(0) 'gov 'flows 'authoring 'publication]
      url (str/cat_all ["/goo-presentation?path=" (value_read/percent (path_show page))
        "&slot=" (value_read/percent (path_show slot))])
    | weft/el "div" []
      [(weft/el "iframe" [(weft/att "src" (str/to_atom url))
         (weft/att "title" "Publish flow from saved Semidoc")
         (weft/att "data-goo-presentation-frame" (show/path page))
         (weft/att "data-nenex-publication" "")
         (weft/att "style" "width:100%;height:190px;border:0")] [])
       (weft/leaf "p" [(weft/att "role" "status") (weft/att "data-publication-status" "")] "")]
  + authoring
    \ page=path
    ^ weft/node
    = slot=path [page.at(0) 'gov 'flows 'authoring 'authoring]
      url (str/cat_all ["/goo-presentation?path=" (value_read/percent (path_show page))
        "&slot=" (value_read/percent (path_show slot))])
    | weft/el "details" []
      [(weft/leaf "summary" [] "Declared authoring actions")
       (weft/el "iframe" [(weft/att "src" (str/to_atom url))
         (weft/att "title" "Author and operate native flows")
         (weft/att "data-goo-presentation-frame" (show/path page))
         (weft/att "data-nenex-action" "")
         (weft/att "style" "width:100%;height:600px;border:0")] [])
       (weft/leaf "p" [(weft/att "role" "status") (weft/att "data-action-status" "")] "")]
  + default_input
    \ record=myth port=iota
    ^ str
    ?> (./some held) record.get(['input port]) ""
    ?> source=safe held ""
    | path_show source.path
  + published
    \ page=path tree=axal[myth] name=iota source=str compiled=flow/definition
    ^ row[weft/node]
    = status (? (eq source compiled.text) "Saved source is published." "Saved source has changes. Publish to update the definition.")
      bindings (compiled.inputs.map((\ port=iota (flow_ui/input (weft/cat2 "input/" (quip_val port)) (weft/cat2 "Input: " (quip_val port)) (flow_ui/default_input tree.get(['flows 'defaults]).fall(myth/new) port) .true))))
      attach=row[weft/node]
        [(flow_ui/input "destination" "Output document path" (show/path [page.at(0) 'app 'nenex 'w name]) .true)
         (weft/leaf "p" [(weft/cls "hint")] (? (unpin compiled.pages).wyt "Bind namespace paths; use /x/... for a cell or overlay result. Bind a Nenex source page below to create live evidence." "Bind namespace paths; use /x/... for a cell or overlay result. Choose a writer for the returned value."))]
      attach attach.weld(bindings).snoc((flow_ui/input "provider" "Provider path (leave empty for manual authoring)" (? (unpin compiled.pages).wyt (show/path [page.at(0) 'io 'codex 'work_provider]) "") .false))
      attach attach.snoc((weft/el "details" [] [(weft/leaf "summary" [] "Output writer")
        (flow_ui/input "writer" "Published writer path" (? (unpin compiled.pages).wyt (show/path (flow_ops/key page.at(0) 'nenex)) "") .true)]))
      attach attach.snoc((flow_ui/hidden "published" (str/to_atom compiled.text)))
      attachments (flow_ui/attached page.weld(['flows name]) tree)
      maintenance (? attachments.len (attachments.bind((flow_ui/controller page tree))) [(flow_ui/form "attach" page name attach "Attach maintenance")])
    | maintenance.cons((weft/leaf "p" [(weft/cls "hint")] status))
  + selection
    \ page=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(eq relative.len 1) []
    ? record.has(['flow 'author_mode]) []
    ?> saved=native_work/captured record.pail_at(['capture]) []
    ?> compiled=flow/definition (unpin saved.value).fil.fall(myth/new).pail_at((flow_ops/key page.at(0) 'definition)) []
    = name relative.at(0)
      source tree.fil.fall(myth/new).txt_at(['src])
      version (cooperate_ops/source_link saved).ver
      description (cord/cat_all ["Selected " (show/path saved.source.path) " at version " (str/to_atom (nat/show version)) ". Later publication leaves this selection unchanged."])
      fields=row[weft/node]
        [(flow_ui/hidden "source" (str/to_atom source))
         (flow_ui/hidden "selected_version" (str/to_atom (nat/show saved.source.ver)))
         (flow_ui/hidden "selected_definition" (show/path saved.source.path))
         (flow_ui/input "destination" "Output namespace path" (show/path [page.at(0) 'app 'nenex 'w name]) .true)]
      fields fields.weld(compiled.inputs.map((\ port=iota (flow_ui/input (weft/cat2 "input/" (quip_val port)) (weft/cat2 "Input: " (quip_val port)) (flow_ui/default_input tree.get(['flows 'defaults]).fall(myth/new) port) .true))))
      fields fields.weld(
        [(flow_ui/input "provider" "Provider path (leave empty for manual authoring)" (? (unpin compiled.pages).wyt (show/path [page.at(0) 'io 'codex 'work_provider]) "") .false)
         (flow_ui/input "writer" "Published writer path" (? (unpin compiled.pages).wyt (show/path (flow_ops/key page.at(0) 'nenex)) "") .true)])
    = attached tree.get(['work name]).is_some
      body=row[weft/node]
        [(weft/leaf "p" [(weft/cls "hint")] description)]
      body (? attached body body.snoc((flow_ui/form "embed" page name fields "Bind and embed flow")))
    | [(weft/el "details" [(weft/att "open" "open")] body.cons((weft/leaf "summary" [] (weft/cat2 "Selected flow: " (quip_val name)))))]
  + callable_ports
    \ mode=str card=myth self=iota
    ^ row[iota]
    ? (eq mode "invoke")
      ?> definition=flow/definition card.pail_at((flow_ops/key self 'definition)) []
      | definition.inputs
    ?> law=flow/operation card.pail_at((flow_ops/key self 'operation)) []
    | law.ports
  + callable_entry
    \ page=path origin=safe catalogue=myth entry=[path myth]
    ^ row[weft/node]
    = [relative card] entry
      target origin.path.weld(relative)
      mode=str
        ? card.has((flow_ops/key page.at(0) 'operation)) "step"
        ? card.has((flow_ops/key page.at(0) 'definition)) "invoke"
        ""
    ? !(mode.len || card.has(bond/mold) || card.has(['law])) []
    ?> source=safe catalogue.pail_at((row/weld[iota] relative ['flow 'callable_origin])) []
    = signature=nat
        ?> descriptor=pails/ty card.pail_at(bond/mold) ""
        | tyshow/show descriptor.t
      ports (flow_ui/callable_ports mode card page.at(0))
      body=row[weft/node]
        [(weft/leaf "p" [] (show/path (safe/spell source)))
         (weft/leaf "pre" [] signature)
         (weft/leaf "pre" [] (str/to_atom card.txt_at(bond/src)))
         (weft/leaf "pre" [] (str/to_atom card.txt_at(['law])))]
      body=row[weft/node]
        ? !(mode.len)
          | body.snoc((weft/leaf "p" [(weft/cls "hint")] "Reflected native definition. It needs a declared flow operation or Goo control before it can be composed as an action."))
        | body.snoc((flow_ui/form "select_step" page 'callable
            [(flow_ui/hidden "definition" (show/path (safe/spell source)))
             (flow_ui/hidden "mode" (str/to_atom mode))
             (weft/leaf "p" [] (weft/cat2 "Declared inputs: " (cord/join ", " ports.map(quip_val))))
             (flow_ui/input "selection_name" "Capture this callable as" "" .true)] "Select captured callable"))
    | [(weft/el "details" [] body.cons((weft/leaf "summary" [] (show/path target))))]
  + callable_catalogue
    \ page=path entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(and (eq relative.len 1) (record.has(['flow 'callable_catalog]))) []
    ?> saved=native_work/captured record.pail_at(['capture]) []
    | (unpin saved.value).tap.bind((flow_ui/callable_entry page saved.source record))
  + callable_selection
    \ page=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(eq relative.len 1) []
    ? !(record.has(['flow 'author_mode])) []
    ?> saved=native_work/captured record.pail_at(['capture]) []
    = mode record.txt_at(['flow 'author_mode])
      ports (flow_ui/callable_ports mode (unpin saved.value).fil.fall(myth/new) page.at(0))
      names (flow_ui/names (str/to_atom tree.fil.fall(myth/new).txt_at(['src])))
      name relative.at(0)
      fields=row[weft/node]
        [(flow_ui/hidden "source" (str/to_atom tree.fil.fall(myth/new).txt_at(['src])))
         (flow_ui/hidden "selected_version" (str/to_atom (nat/show saved.source.ver)))
         (flow_ui/hidden "selected_definition" (show/path saved.source.path))
         (flow_ui/input "flow_name" "Flow to compose" (? (eq names.len 1) (quip_val names.at(0)) "") .true)
         (flow_ui/input "step_name" "Step name (existing name revises that step)" (quip_val name) .true)
         (flow_ui/input "new_inputs" "New input names, separated by spaces" "" .false)]
      fields fields.weld(ports.map((\ port=iota (flow_ui/input (weft/cat2 "binding/" (quip_val port)) (weft/cat2 "Bind port to input or earlier step: " (quip_val port)) "" .true))))
      fields fields.snoc((flow_ui/input "result" "Flow result (input or step name)" (quip_val name) .true))
      description (cord/cat_all ["Captured " (show/path (safe/spell saved.source)) ". Composing saves this exact implementation in Semidoc. Publish the edited flow when ready."])
    | [(weft/el "details" [(weft/att "open" "open")]
        [(weft/leaf "summary" [] (weft/cat2 "Compose with: " (quip_val name)))
         (weft/leaf "p" [(weft/cls "hint")] description)
         (flow_ui/form "compose" page name fields "Save composed step")])]
  + extraction
    \ page=path entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ?> (./ok proposal) (flow_extract_ops/proposal record page.at(0)) []
    = executed (unpin proposal.definition).steps.keep((\ step=flow/step (proposal.output.trace.any((\ event=flow/event (equal[iota] step.name event.name))))))
      names executed.map((\ step=flow/step (quip_val step.name)))
      attempt page.weld(relative)
    | [(weft/el "details" []
        [(weft/leaf "summary" [] (weft/cat2 "Extract retained run: " (show/path relative)))
         (weft/leaf "p" [(weft/cls "hint")] "Selected executed steps become editable Semidoc. Dependencies outside the selection become inputs; captured implementations and the original attempt remain retained.")
         (flow_ui/form "extract" page 'extraction
           [(flow_ui/hidden "attempt" (show/path attempt))
            (flow_ui/input "steps" "Top-level steps to extract, separated by spaces" (joined 32 names) .true)
            (flow_ui/input "new_name" "New flow name (creates NAME_flow)" "" .true)]
           "Extract authored flow")])]
  + trace_draft
    \ page=path run=path tree=axal[myth] title=str
    ^ row[weft/node]
    ?> (./ok entries) (flow_trace_ops/entries run tree) []
    ? !(entries.len) []
    ?> (./some activity) (native_work_ops/state tree.fil.fall(myth/new)) []
    = items=row[weft/node] entries.map((\ [at card] (weft/el "li" []
        [(weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path at)))] (quip_val at.at(at.len.dec)))
         (weft/leaf "pre" [] (str/to_atom card.txt_at(system_vocabulary/content)))])))
    | [(weft/el "details" []
        [(weft/leaf "summary" [] (weft/cat2 title (show/path run.drop(page.len))))
         (weft/el "ol" [] items)
         (flow_ui/form "extract_trace" page 'extraction
           [(flow_ui/hidden "run" (show/path run))
            (flow_ui/hidden "sequence" (str/to_atom (nat/show activity.sequence)))
            (flow_ui/input "events" "Event names to retain, separated by spaces" "" .true)
            (flow_ui/input "new_name" "New flow name (creates NAME_flow)" "" .true)
            (weft/leaf "p" [] "Selected records become frozen evidence and editable Semidoc inputs. Pending model tool calls refuse; completed and failed calls remain evidence. Choose executable operations and dependencies explicitly; a native hole retains the unfinished authoring work.")]
           "Draft flow from investigation")])]
  + worker_trace
    \ page=path run=path root=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [child record] entry
    ? !(eq child.len 1) []
    ?> (./some activity) (native_work_ops/state record) []
    ? !(eq activity.kind "model") []
    | flow_ui/trace_draft page run.weld(['workers]).weld(child) root.dip(['workers]).dip(child) "Extract agent trace: "
  + investigation
    \ page=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(and (eq relative.len 2) (equal[iota] relative.at(0) 'work)) []
    ?> (./some activity) (native_work_ops/state record) []
    ? !(eq activity.kind "investigation") []
    = run=path page.weld(relative)
      root tree.dip(relative)
      workers root.dip(['workers]).tap.bind((flow_ui/worker_trace page run root))
    | (flow_ui/trace_draft page run root "Extract investigation: ").weld(workers)
  + trace_review
    \ page=path tree=axal[myth]
    ^ row[weft/node]
    ? !(tree.get(['work 'extraction]).fall(myth/new).has(['flow 'trace_name])) []
    | [(flow_ui/form "review_trace" page 'extraction
        [(flow_ui/hidden "source" (str/to_atom tree.fil.fall(myth/new).txt_at(['src])))
         (weft/leaf "p" [] "Compose the procedure and inspect its bindings. Review resolves the authoring hole only when the source compiles; subsequent source edits reopen it. Publish separately.")]
        "Review extracted procedure")]
  + foreign_controller
    \ page=path tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(eq relative.len 1) []
    ?> config=flow_maintenance/config record.pail_at(['flow 'config]) []
    ? (and (pith_prefix page.weld(['flows]) config.definition) (eq config.definition.len (add page.len 2))) []
    | [(weft/el "details" [(weft/att "open" "open")]
        (flow_ui/controller page tree [(row/cons[iota] 'work relative) record]).cons((weft/leaf "summary" [] (weft/cat2 "Flow occurrence: " (quip_val relative.at(0))))))]
  + action_input
    \ field=mop/kv[path pail]
    ^ weft/node
    ? (equal[pail] field.val (pails/t "rich_text"))
      | weft/el "label" [(weft/cls "flow-field")]
          [(weft/tx (show/path field.key.drop(2)))
           (weft/el "textarea" [(weft/att "name" (weft/cat2 "argument" (show/path field.key.drop(2)))) (weft/att "rows" "4")] [])
           (weft/leaf "span" [(weft/cls "hint")] "Text for the declared rich-text control. Goo encodes its native text value.")]
    | flow_ui/input (weft/cat2 "argument" (show/path field.key.drop(2))) (show/path field.key.drop(2)) "" .true
  + action_control
    \ page=path catalogue=iota entry=[path myth]
    ^ row[weft/node]
    = [route card] entry
    ?> query=goo_runtime/request card.pail_at(['goo 'request]) []
    = inputs=row[mop/kv[path pail]] card.tap.keep((\ field (pith_prefix ['goo 'input] field.key)))
      text_only (row/all[mop/kv[path pail]] (\ field ((equal[pail] field.val (pails/t "text")) || (equal[pail] field.val (pails/t "rich_text")))) inputs)
      fields=row[weft/node]
        [(flow_ui/hidden "catalogue" (quip_val catalogue))
         (flow_ui/hidden "control" (show/path route))
         (flow_ui/input "selection_name" "Name for this selected action" "" .true)]
      fields fields.weld(inputs.map(flow_ui/action_input))
      body=row[weft/node]
        [(weft/leaf "summary" [] (str/to_atom card.txt_at(['title])))
         (weft/leaf "p" [] (cord/cat_all ["Object: " (show/path query.subject) ". View: " (show/path query.view)]))
         (weft/leaf "pre" [] (str/to_atom card.txt_at(['goo 'bindings])))
         (weft/leaf "p" [(weft/cls "hint")] "Selection captures this declared action and its arguments. Execution checks the object, publication, current work and evidence again.")]
      body=row[weft/node]
        ? text_only
          | body.snoc((flow_ui/form "select_action" page catalogue fields "Select action for a flow"))
        | body.snoc((weft/leaf "p" [] "This control requires a retained Goo selection capture; use its declared selection interface."))
    | [(weft/el "details" [] body)]
  + action_catalogue
    \ page=path entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(eq relative.len 1) []
    ?> saved=native_work/captured record.pail_at(['capture]) []
    ? record.has(['flow 'action_catalog])
      | (unpin saved.value).tap.bind((flow_ui/action_control page relative.at(0)))
    ?> query=goo_runtime/request (unpin saved.value).fil.fall(myth/new).pail_at(['goo 'request]) []
    | [(weft/leaf "p" [] (cord/cat_all ["Selected action " (quip_val relative.at(0)) ". Bind a request_actions step to "
        (show/path (row/cons[iota] 'x page.weld(['cells relative.at(0)]))) ". Target: " (show/path query.subject)]))]
  + render
    \ page=path tree=axal[myth]
    ^ row[weft/node]
    = source tree.fil.fall(myth/new).txt_at(['src])
      authored (flow_ui/names (str/to_atom source))
      published (tree.dip(['flows]).tap.keep((\ [relative card] (and (eq relative.len 1) (card.has((flow_ops/key page.at(0) 'definition))))))).map((\ [relative card] relative.at(0)))
      names (row/uniq[iota] authored.weld(published))
      selections (tree.dip(['cells]).tap.bind((flow_ui/selection page tree)))
      callables (tree.dip(['cells]).tap.bind((flow_ui/callable_selection page tree)))
      has_flows ((gt names.len 0) || (gt selections.len 0))
      creation (flow_ui/form "create" page 'new
        [(flow_ui/input "new_name" "Flow name (creates NAME_flow)" "" .true)
         (weft/el "label" [(weft/cls "flow-field")] [(weft/tx "Starter")
           (weft/el "select" [(weft/att "name" "kind")]
             [(weft/leaf "option" [(weft/att "value" "composition")] "Composition")
              (weft/leaf "option" [(weft/att "value" "document")] "Document revision")])])
         (flow_ui/input "uses" "Evidence keys (document revision only)" "" .false)
         (weft/el "label" [(weft/cls "flow-field")]
           [(weft/tx "What should this procedure do?")
            (weft/el "textarea" [(weft/att "name" "brief") (weft/att "rows" "4")] [])])]
        "Create flow")
      heading=row[weft/node]
        [(weft/leaf "h2" [] "Flows")
         (weft/leaf "p" [(weft/cls "hint")] "Compose selected operations and flows below, or edit Semidoc source. Publish the saved procedure, then bind inputs and attach a native maintenance hand.")]
      heading heading.snoc((flow_ui/authoring page))
      heading (? authored.len heading.snoc((flow_ui/publisher page)) heading)
      heading=row[weft/node]
        ?> (./some capture) tree.get(['flows 'defaults]).fall(myth/new).path_at(['capture]) heading
        | heading.snoc((flow_ui/form "capture" page 'sources [(flow_ui/hidden "capture" (show/path capture))] "Capture source changes"))
      heading heading.snoc((flow_ui/form "refresh" page 'harness [] "Refresh harness code"))
      heading (? has_flows heading.snoc((flow_ui/form "bind_source" page 'source
        [(flow_ui/input "source_page" "Nenex evidence page path" "" .true)
         (flow_ui/input "source_name" "Evidence key" "document" .true)
         (weft/leaf "p" [(weft/cls "hint")] "Creates an ordinary live source cell and fills Input: sources. Page edits wake the same maintenance hand; attempts retain exact native snapshots.")]
        "Bind Nenex source page")) heading)
      heading (? has_flows heading.snoc((flow_ui/form "bind_url" page 'url
        [(flow_ui/input "source_url" "HTTP source URL" "" .true)
         (flow_ui/input "source_name" "Source key" "source" .true)
         (weft/leaf "p" [(weft/cls "hint")] "Binds Input: urls. The authored web_fetch step requests native work; attaching the flow starts it.")]
        "Bind web source")) heading)
      heading (? has_flows heading.snoc((flow_ui/form "bind_file" page 'file
        [(flow_ui/input "source_file" "Captured filesystem record path" "" .true)
         (flow_ui/input "source_mount" "Filesystem mount path" "" .true)
         (flow_ui/input "source_name" "Evidence key" "manual" .true)
         (weft/leaf "p" [(weft/cls "hint")] "Binds Input: sources to a Markdown file in an existing filesystem mount. Its native foot owns the watch.")]
        "Bind filesystem source")) heading)
      selection (flow_ui/form "select" page 'selection
        [(flow_ui/input "occurrence_name" "Occurrence name on this page" "" .true)
         (flow_ui/input "definition" "Published flow path" "" .true)
         (weft/leaf "p" [(weft/cls "hint")] "Select a published flow, bind its inputs, then embed its native work here. Removing an embed does not detach its work.")]
        "Select published flow")
      content heading.weld(names.map((flow_ui/definition page tree)))
      content content.weld(selections).weld(callables)
      content content.weld(tree.dip(['cells]).tap.bind((flow_ui/callable_catalogue page)))
      content content.snoc((weft/el "details" []
        [(weft/leaf "summary" [] "Discover native operations and reflected definitions")
         (flow_ui/form "inspect_callables" page 'catalogue
           [(flow_ui/input "selection_name" "Catalogue name on this page" "" .true)
            (flow_ui/input "scope" "Namespace subtree to inspect" (show/path (flow_ops/key page.at(0) 'operations)) .true)
            (weft/leaf "p" [(weft/cls "hint")] "Inspect published operations, flow definitions, or compiler mirrors. The captured cell retains the selected code and declared inputs; raw reflected functions are inspectable without being granted effects.")]
           "Inspect native definitions")]))
      content content.weld(tree.dip(['cells]).tap.bind((flow_ui/action_catalogue page)))
      content content.snoc((weft/el "details" []
        [(weft/leaf "summary" [] "Inspect declared Goo actions")
         (flow_ui/form "inspect_actions" page 'actions
           [(flow_ui/input "selection_name" "Inspection name on this page" "" .true)
            (flow_ui/input "object" "Object or presentation path" "" .true)
            (flow_ui/input "view" "Published Goo view path" "" .true)] "Inspect actions")]))
      content content.weld(tree.dip(['work]).tap.bind((flow_ui/foreign_controller page tree))).snoc(selection)
      content content.snoc((weft/el "details" []
        [(weft/leaf "summary" [] "Compose an operation or child flow")
         (flow_ui/form "select_step" page 'callable
           [(flow_ui/input "selection_name" "Selection name on this page" "" .true)
            (flow_ui/input "definition" "Published operation or flow path" "" .true)
            (weft/el "label" [(weft/cls "flow-field")]
              [(weft/tx "Callable kind")
               (weft/el "select" [(weft/att "name" "mode")]
                 [(weft/leaf "option" [(weft/att "value" "step")] "Operation")
                  (weft/leaf "option" [(weft/att "value" "invoke")] "Child flow")])])]
           "Select callable")]))
      content content.weld(tree.tap.bind((flow_ui/extraction page)))
      content content.weld(tree.tap.bind((flow_ui/investigation page tree))).weld((flow_ui/trace_review page tree))
      content content.snoc((weft/el "details" [(weft/cls "flow-new")]
        [(weft/leaf "summary" [] "Author a new flow") creation]))
      tools (row/snoc[weft/node] (weft/el "section" [(weft/cls "flow-tools") (weft/att "aria-label" "Flows")] content) (flow_ui/holes page tree))
    | row/weld[weft/node] (flow_ui/revision page tree) tools
  + revision
    \ page=path tree=axal[myth]
    ^ row[weft/node]
    = record tree.fil.fall(myth/new)
    ?> (./some request) tree.get(['work 'revision]).fall(myth/new).path_at(['request]) []
    | [(weft/leaf "h2" [] "Document revision")
       (nenex_ui/cell request.snoc('view) "Working context and evidence")
       (flow_ui/form "submit" page 'revision
        [(flow_ui/hidden "request" (show/path request))
         (flow_ui/hidden "source" (str/to_atom record.txt_at(['src])))
         (flow_ui/input "note" "What changed, and which evidence supports it?" "" .true)] "Accept saved draft")]
  + composition
    \ self=iota name=iota brief=str
    ^ str
    = heading=row[nat]
        [";." (weft/cat2 "  ;@ /flow/definition " (quip_val name))
         (weft/cat2 "  ;= " (quip_val name))]
      lines ((http_foot/split 10 brief).map((\ line (str/to_atom (str/cat_all ["    " line])))))
      steps=row[nat]
        ["    ;@ /flow/input value" "    ;= Input"
         (weft/cat2 "    ;@ /flow/step result ;" (show/path [self 'gov 'flows 'operations 'identity]))
         "    ;@ /flow/bind value value" "    ;= Transform"
         "    ;@ /flow/result result" "    ;= Result"]
    | str/from_atom (joined 10 heading.weld(lines).weld(steps))
  + template
    \ self=iota name=iota uses=row[iota] brief=str
    ^ str
    = operation (str/cat_all [";" (path_show [self]) "/gov/flows/operations/"])
      names (str/from_atom (joined 32 (uses.map(quip_val))))
      lines (http_foot/split 10 brief)
      source=row[str]
        [";." (str/cat_all ["  ;@ /flow/definition " (str/from_atom (quip_val name))])
         (str/cat_all ["  ;= " (str/from_atom (quip_val name))])
         "    ;@ /flow/input sources" "    ;= Captured evidence"
         (str/cat_all ["    ;@ /flow/step checked " operation "inventory"])
         "    ;@ /flow/bind sources sources" "    ;= Check evidence"
         (str/cat_all ["    ;@ /flow/step concepts " operation "revise"])
         "    ;@ /flow/bind pages document" "    ;@ /flow/bind sources checked" "    ;= Author or revise concepts"
         (str/cat_all ["    ;@ /flow/step pages " operation "evidence"])
         "    ;@ /flow/bind pages concepts" "    ;@ /flow/bind sources checked" "    ;= Attach provenance"
         "    ;@ /flow/result pages" "    ;= Completed documents"
         "    ;@ /flow/page /" (str/cat_all ["    ;@ /flow/uses " names])
         (str/cat_all ["    ;= " (str/from_atom (quip_val name))])]
    | str/from_atom (joined 10 (source.weld(lines.map((\ line (str/cat_all ["      " line])))).map(str/to_atom)))
  + address
    \ text=str
    ^ either[iota path]
    ?> (./some path) (browser_routes/value_path text) (./err 'flow_invalid_address)
    | ./ok path
  + bindings
    \ fields=row[[str str]] ports=row[iota] input=myth
    ^ either[iota myth]
    ?> (./some pair) ports.pull (./ok input)
    = [port rest] pair
    < target (flow_ui/address (http_foot/field (str/cat_all ["input/" (str/from_atom (quip_val port))]) fields))
    | flow_ui/bindings fields rest input.put(['input port] (safe 0 .z target))
  + provider
    \ text=str input=myth
    ^ either[iota myth]
    ? !(text.len) (./ok input)
    < provider (flow_ui/address text)
    | ./ok input.put(['provider] (safe 0 .x provider))
  + word_list
    \ text=str
    ^ either[iota row[iota]]
    = words (split_byte 32 (str/to_atom text)).keep((\ word=nat !(eq word 0)))
    | flow_ops/names (words.map((\ word=nat (sval/word word))))
  + composition_bindings
    \ fields=row[[str str]] ports=row[iota] input=myth
    ^ either[iota myth]
    ?> (./some pair) ports.pull (./ok input)
    = [port rest] pair
    < value (flow_ops/name (sval/word (str/to_atom (http_foot/field (str/cat_all ["binding/" (str/from_atom (quip_val port))]) fields))))
    | flow_ui/composition_bindings fields rest input.put(['binding port] (pails/p [value]))
  + plan
    ' Keep action bodies in separate laws. P6 optimizes a whole law on first
    ' invocation; one large branch tree made a cold authoring request time out.
    ' These helpers still plan through the same namespace admission boundary.
    \ fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < page (flow_ui/address (field "page"))
    ? !(nenex_ui/reader_path [state.self 'app 'nenex 'w] page) (./err 'flow_nenex_destination)
    ? (eq action "inspect_callables")
      | flow_ui/plan_inspect_callables page fields state
    ? (eq action "inspect_actions")
      | flow_ui/plan_inspect_actions page fields state
    ? (eq action "select_action")
      | flow_ui/plan_select_action page fields state
    ? (eq action "select_step")
      | flow_ui/plan_select_step page fields state
    ? (eq action "compose")
      | flow_ui/plan_compose page fields state
    ? (eq action "extract_trace")
      | flow_ui/plan_trace page fields state
    ? (eq action "review_trace")
      = input (myth/sing ['source] (pails/t (field "source"))).put(['expected] (pails/n state.case(.x page).fall(0)))
      | namespace_command/plan page (flow_ops/key state.self 'review_trace) input state
    ? (eq action "extract")
      | flow_ui/plan_extract page fields state
    ? (eq action "select")
      | flow_ui/plan_select page fields state
    ? (eq action "adopt")
      | flow_ui/plan_adopt page fields state
    ? (eq action "embed")
      | flow_ui/plan_embed page fields state
    ? ((eq action "bind_url") || (eq action "bind_file"))
      | flow_ui/source_binding page action fields state
    ? (eq action "refresh")
      | flow_ui/refresh [state.self 'gov 'flows] myth/new state
    ? (eq action "example")
      | flow_ui/plan_example page fields state
    ? (eq action "capture")
      | flow_ui/plan_capture page fields state
    ? (eq action "bind_source")
      | flow_ui/plan_bind_source page fields state
    ? (eq action "retry")
      | flow_ui/plan_retry page fields state
    ? (eq action "submit")
      | flow_ui/plan_submit page fields state
    ? (eq action "create")
      | flow_ui/plan_create page fields state
    ? ((eq action "pause") || (eq action "resume") || (eq action "detach"))
      | flow_ui/plan_control page fields state
    | flow_ui/plan_publication page fields state
  + plan_inspect_callables
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < scope (flow_ui/address (field "scope"))
    = input (myth/sing ['name] (pails/p [name])).put(['source] (safe 0 .z scope))
    | namespace_command/plan page (flow_ops/key state.self 'inspect_callables) input state
  + plan_inspect_actions
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    ?> (./some owner) (nenex_edit/owner page state) (./err 'flow_missing_document)
    ? !(equal[path] owner page) (./err 'flow_nenex_destination)
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < target (flow_ui/address (field "object"))
    < view (flow_ui/address (field "view"))
    | namespace_command/plan page.weld(['cells name]) (flow_ops/key state.self 'inspect_actions)
        ((myth/sing ['target] (pails/p target)).put(['view] (pails/p view))) state
  + plan_select_action
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    ?> (./some owner) (nenex_edit/owner page state) (./err 'flow_missing_document)
    ? !(equal[path] owner page) (./err 'flow_nenex_destination)
    < catalogue (flow_ops/name (sval/word (str/to_atom (field "catalogue"))))
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < route (flow_ui/address (field "control"))
    = card (cooperate_ops/record page.weld(['cells catalogue]) state).fall(myth/new)
    ? !(card.has(['flow 'action_catalog])) (./err 'flow_missing_selection)
    ?> saved=native_work/captured card.pail_at(['capture]) (./err 'flow_missing_selection)
    = selected (unpin saved.value).get(route).fall(myth/new)
    ?> query=goo_runtime/request selected.pail_at(['goo 'request]) (./err 'flow_invalid_action)
    ? !(and (eq query.expected state.case(.x query.subject).fall(0))
        (and (eq query.displayed state.case(.y query.target).fall(0)) (eq query.publication (goo_runtime/publication state)))) (./err 'flow_stale_selection)
    = supplied fields.keep((\ [key value] (eq key.slice(0 9) "argument/")))
      inputs supplied.map((flow_ui/action_argument selected))
    | namespace_command/plan page.weld(['cells name]) (flow_ops/key state.self 'capture_action)
        (myth/sing ['goo 'request] query.set_inputs(inputs)) state
  + action_argument
    \ selected=myth field=[str str]
    ^ [str str]
    = [key value] field
      key key.slice(8 (sub key.len 8))
      slot (path_parse key).fall([])
      rich (eq selected.txt_at((row/weld[iota] slot ['goo 'input])) "rich_text")
      encoded (? rich (show (goo_text/encode (goo/text/en value))) value)
    | [key encoded]
  + plan_select_step
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < definition (flow_ui/address (field "definition"))
    < origin (flow_ops/origin (seg_texts definition))
    = input (myth/sing ['name] (pails/p [name])).put(['selected] origin).put(['mode] (pails/t (field "mode")))
    | namespace_command/plan page (flow_ops/key state.self 'select_step) input state
  + plan_compose
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < selection_name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = record (cooperate_ops/record page.weld(['cells selection_name]) state).fall(myth/new)
    ?> saved=native_work/captured record.pail_at(['capture]) (./err 'flow_missing_selection)
    ? !(record.has(['flow 'author_mode])) (./err 'flow_invalid_selection)
    ? !(eq (field "selected_version") (nat/show saved.source.ver)) (./err 'flow_stale_selection)
    ? !(eq (field "selected_definition") (path_show saved.source.path)) (./err 'flow_stale_selection)
    < id (flow_ops/name (sval/word (str/to_atom (field "flow_name"))))
    < step (flow_ops/name (sval/word (str/to_atom (field "step_name"))))
    < result (flow_ops/name (sval/word (str/to_atom (field "result"))))
    < inputs (flow_ui/word_list (field "new_inputs"))
    = mode record.txt_at(['flow 'author_mode])
      ports (flow_ui/callable_ports mode (unpin saved.value).fil.fall(myth/new) state.self)
      input (myth/sing ['flow] (pails/p [id])).put(['step] (pails/p [step])).put(['result] (pails/p [result]))
      input input.put(['mode] (pails/t mode)).put(['selected] saved.source).put(['inputs] (pails/p inputs))
      input input.put(['source] (pails/t (field "source"))).put(['expected] (pails/n state.case(.x page).fall(0)))
    < input (flow_ui/composition_bindings fields ports input)
    | namespace_command/plan page (flow_ops/key state.self 'compose) input state
  + plan_trace
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < run (flow_ui/address (field "run"))
    = relative run.drop(page.len)
      direct (eq relative.len 2)
      worker (and (eq relative.len 4) (equal[iota] relative.at(2) 'workers))
    ? !(and (pith_prefix page.weld(['work]) run) (direct || worker)) (./err 'flow_missing_investigation)
    < events (flow_ui/word_list (field "events"))
    ?> (./some sequence) (nat/parse (field "sequence")) (./err 'flow_stale_trace)
    = target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['name] (pails/p [name])).put(['run] (pails/p run)).put(['events] (pails/p events)).put(['sequence] (pails/n sequence))
    | namespace_command/plan target (flow_ops/key state.self 'extract_trace) input state
  + plan_extract
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < attempt (flow_ui/address (field "attempt"))
    < origin (flow_ops/origin (seg_texts attempt))
    < steps (flow_ui/word_list (field "steps"))
    = target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['name] (pails/p [name])).put(['attempt] origin).put(['steps] (pails/p steps)).put(['expected] (pails/n 0))
    | namespace_command/plan target (flow_ops/key state.self 'extract) input state
  + plan_select
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "occurrence_name"))))
    < definition (flow_ui/address (field "definition"))
    = input (myth/sing ['name] (pails/p [name])).put(['definition] (safe 0 .x definition))
    | namespace_command/plan page (flow_ops/key state.self 'select) input state
  + plan_adopt
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < controller (flow_ui/address (field "controller"))
    ? !(and (pith_prefix page.snoc('work) controller) (eq controller.len (add page.len 2))) (./err 'flow_invalid_controller)
    < selection (flow_ui/address (field "selection"))
    ? !(and (pith_prefix page.snoc('cells) selection) (eq selection.len (add page.len 2))) (./err 'flow_invalid_selection)
    ?> saved=native_work/captured (cooperate_ops/record selection state).fall(myth/new).pail_at(['capture]) (./err 'flow_invalid_selection)
    < previous_path (flow_ui/address (field "previous"))
    < previous (flow_ops/origin (seg_texts previous_path))
    = input (myth/sing ['definition] saved.source).put(['previous] previous)
    | namespace_command/plan controller (flow_ops/key state.self 'adopt) input state
  + plan_embed
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = selection=path page.weld(['cells name])
      record (cooperate_ops/record selection state).fall(myth/new)
    ?> saved=native_work/captured record.pail_at(['capture]) (./err 'flow_missing_selection)
    ? !(eq (field "selected_version") (nat/show saved.source.ver)) (./err 'flow_stale_selection)
    ? !(eq (field "selected_definition") (path_show saved.source.path)) (./err 'flow_stale_selection)
    ?> compiled=flow/definition (unpin saved.value).fil.fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_invalid_definition)
    < destination (flow_ui/address (field "destination"))
    < writer (flow_ui/address (field "writer"))
    = request (myth/sing ['definition] saved.source).put(['destination] (pails/p destination)).put(['writer] (safe 0 .x writer))
    < request (flow_ui/bindings fields compiled.inputs request)
    < request (flow_ui/provider (field "provider") request)
    = input request.put(['selection] (safe 0 .x selection)).put(['expected] (pails/n state.case(.x page).fall(0)))
      input input.put(['source] (pails/t (field "source")))
    | namespace_command/plan page (flow_ops/key state.self 'embed) input state
  + plan_example
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
    | namespace_command/plan target [state.self 'gov 'flows 'examples name] myth/new state
  + plan_capture
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < mount (flow_ui/address (field "capture"))
    | namespace_command/plan mount mount.weld(['op 'rescan]) myth/new state
  + plan_bind_source
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < source (flow_ui/address (field "source_page"))
    < name (flow_ops/name (sval/word (str/to_atom (field "source_name"))))
    = input (myth/sing ['source] (safe 0 .x source)).put(['name] (pails/p [name]))
    | namespace_command/plan page (flow_ops/key state.self 'bind_page_source) input state
  + plan_retry
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < request (flow_ui/address (field "request"))
    ? !(and (pith_prefix page.weld(['work]) request) (eq request.len (add page.len 4))) (./err 'flow_invalid_revision_target)
    = input (myth/sing ['expected] (pails/n state.case(.x request).fall(0)))
    | namespace_command/plan request (flow_ops/key state.self 'retry_revision) input state
  + plan_submit
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < request (flow_ui/address (field "request"))
    ? !(equal[path] page request.snoc('draft)) (./err 'flow_invalid_revision_target)
    ? !(eq (field "source") (cooperate_ops/record page state).fall(myth/new).txt_at(['src])) (./err 'flow_draft_edited)
    = input (myth/sing ['source] (pails/t (field "source"))).put(['note] (pails/t (field "note")))
      input input.put(['expected] (pails/n state.case(.x page).fall(0)))
    | namespace_command/plan request (flow_ops/key state.self 'submit_revision) input state
  + plan_create
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < uses (flow_ops/names ((split_byte 32 (str/to_atom (field "uses"))).map((\ word (sval/word word)))))
    = document (eq (field "kind") "document")
    ? (and document !(uses.len)) (./err 'flow_missing_page_sources)
    = brief (field "brief")
    ? (gt brief.len 8192) (./err 'flow_invalid_brief)
    = source (? document (flow_ui/template state.self name uses brief) (flow_ui/composition state.self name brief))
      target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0))
    | namespace_command/plan target (flow_ops/key state.self 'author) input state
  + plan_control
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < controller (flow_ui/address (field "controller"))
    ? !(and (pith_prefix page.weld(['work]) controller) (eq controller.len (add page.len 2))) (./err 'flow_invalid_controller)
    = input (? (eq action "detach") myth/new (myth/sing ['enabled] (pails/b (eq action "resume"))))
      operation=iota (? (eq action "detach") 'detach 'set_enabled)
    | namespace_command/plan controller (flow_ops/key state.self operation) input state
  + plan_publication
    \ page=path fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    < name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = definition page.weld(['flows name])
    ? (eq action "publish")
      ? !(eq (field "source") (cooperate_ops/record page state).fall(myth/new).txt_at(['src])) (./err 'flow_stale_source)
      = input (myth/sing ['id] (pails/t (str/from_atom (quip_val name))))
      | flow_author_ops/publish page input state
    ? !(eq action "attach") (./err 'flow_invalid_action)
    ?> (./some held) (cooperate_ops/record definition state).fall(myth/new).get((flow_ops/key state.self 'definition)) (./err 'flow_missing_definition)
    ?> published=flow/definition held (./err 'flow_invalid_definition)
    ? !(eq (field "published") published.text) (./err 'flow_stale_definition)
    < destination (flow_ui/address (field "destination"))
    < writer (flow_ui/address (? (field "writer").len (field "writer") (path_show (flow_ops/key state.self 'nenex))))
    = controller page.weld(['work ($ts (weft/cat2 "maintenance_" (quip_val name)))])
      input (myth/sing ['definition] (safe 0 .x definition)).put(['destination] (pails/p destination)).put(['writer] (safe 0 .x writer))
    < input (flow_ui/bindings fields published.inputs input)
    < input (flow_ui/provider (field "provider") input)
    | namespace_command/plan controller (flow_ops/key state.self 'follow) input state
  + source_binding
    ' Browser forms plan the same native writes and source-watch operation.
    \ page=path action=str fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < name (flow_ops/name (sval/word (str/to_atom (http_foot/field "source_name" fields))))
    ? !((cooperate_ops/record page state).fall(myth/new).has(['src])) (./err 'flow_missing_document)
    = settings=path page.weld(['flows 'defaults])
      existing_defaults (cooperate_ops/record settings state)
      defaults existing_defaults.fall(myth/new)
    ? (eq action "bind_file")
      < source (flow_ui/address (http_foot/field "source_file" fields))
      < mount (flow_ui/address (http_foot/field "source_mount" fields))
      = feed=path page.weld(['inputs ($ts (str/cat_all [(str/from_atom (quip_val name)) "_file"]))])
        input (myth/sing ['source] (safe 0 .x source)).put(['mount] (pails/p mount)).put(['name] (pails/p [name])).put(['format] (pails/t "md"))
        input input.put(['expected] (pails/n state.case(.x feed).fall(0)))
      < writes (flow_sources_ops/watch feed input state)
      = value defaults.put(['input 'sources] (safe 0 .z (row/cons[iota] 'x feed)))
      | ./ok writes.snoc([settings (? existing_defaults.is_some (writ/poke value) (writ/make value))])
    = url (http_foot/field "source_url" fields)
    ? !(flow_web_ops/valid_url url) (./err 'flow_invalid_url)
    = collection=path page.weld(['inputs 'urls])
      target=path collection.snoc(name)
      value (myth/sing ['url] (pails/t url))
      existing (cooperate_ops/record target state)
    ? (and existing.is_some !(equal[maybe[myth]] existing (./some value))) (./err 'flow_source_collision)
    = writes=row[[path writ]] (? existing.is_some [] [[target (writ/make value)]])
    = value defaults.put(['input 'urls] (safe 0 .z collection))
    | ./ok writes.snoc([settings (? existing_defaults.is_some (writ/poke value) (writ/make value))])
  + response
    \ fields=row[[str str]] refused=maybe[pail] state=namespace
    ^ [nat str]
    = error=str
        ?> (./some why) refused ""
        | http_foot/reason why
      page (http_foot/field "page" fields)
      destination=str
        ? !((eq (http_foot/field "action" fields) "create") || (eq (http_foot/field "action" fields) "example") || (eq (http_foot/field "action" fields) "extract") || (eq (http_foot/field "action" fields) "extract_trace")) page
        | path_show [state.self 'app 'nenex 'w ($ts (str/to_atom (str/cat_all [(? (eq (http_foot/field "action" fields) "example") (http_foot/field "name" fields) (http_foot/field "new_name" fields)) "_flow"])))]
      url (str/cat_all ["/nenex?path=" (value_read/percent destination) "#page-tools"])
    | [(? refused.is_some 409 200) (show (json/obj [(jkv "error" (json/str error)) (jkv "redirect" (json/str url))]))]
  + request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    ? !(eq request.target "/nenex/flows") (./reply (http_driver/response 404 "Not found"))
    ? (gt request.body.len 262144) (./reply (http_driver/response 413 "Flow form too large"))
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields request.body)
      | ./reply (http_driver/response 400 "Invalid form")
    ? !(eq fields.len (row/uniq[str] (fields.map((\ [key value] key)))).len)
      | ./reply (http_driver/response 400 "Duplicate form fields")
    | ./admit (flow_ui/plan fields) (flow_ui/response fields) (\ outcome before state "")
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    | http_foot/add_routes [(http_foot/route "/nenex/flows" flow_ui/request)] http_foot/empty
