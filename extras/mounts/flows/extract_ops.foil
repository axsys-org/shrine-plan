- flow_nenex_ops

' Extraction is an editable authored procedure, not a replay of provider
' answers. Only retained, executed top-level steps have enough bindings and
' captured laws to extract honestly. Nested calls remain captured operations.
+ flow_extract_ops
  + proposal
    \ record=myth self=iota
    ^ either[iota flow_maintenance/proposal]
    ? record.get((flow_ops/key self 'attempt))
     > (./some held)
      ?> saved=flow_runtime/attempt held (./err 'flow_invalid_run)
      | ./ok (flow_maintenance/proposal saved.definition saved.captures saved.output)
    ?> saved=flow_maintenance/run record.pail_at(['flow 'automatic_run]) (./err 'flow_extraction_requires_retained_run)
    | ./ok (unpin saved.proposal)
  + selected
    \ proposal=flow_maintenance/proposal names=row[iota]
    ^ either[iota row[flow/step]]
    ? !(names.len) (./err 'flow_extraction_requires_steps)
    = definition (unpin proposal.definition)
      steps definition.steps.keep((\ step=flow/step (flow_ops/has step.name names)))
    ? !(eq names.len steps.len) (./err 'flow_extraction_unknown_or_duplicate_step)
    ? !(row/all[flow/step] (\ step=flow/step (row/any[flow/event] (\ event=flow/event (equal[iota] step.name event.name)) proposal.output.trace)) steps)
      | ./err 'flow_extraction_unexecuted_step
    | ./ok steps
  + external
    \ names=row[iota] current=row[iota] binding=flow/binding
    ^ row[iota]
    ? ((equal[iota] binding.value 'document) || (flow_ops/has binding.value names) || (flow_ops/has binding.value current)) current
    | current.snoc(binding.value)
  + inputs
    \ steps=row[flow/step]
    ^ row[iota]
    = names steps.map((\ step=flow/step step.name))
      empty=row[iota] []
      bindings=row[flow/binding] steps.bind((\ step=flow/step step.bindings))
    | bindings.fold(empty (flow_extract_ops/external names))
  + example
    \ name=iota proposal=flow_maintenance/proposal
    ^ either[iota pin[axal[myth]]]
    = captures proposal.captures.keep((\ captured=flow_runtime/capture (equal[iota] name captured.name)))
    ? captures.len (./ok captures.at(0).snapshot.value)
    = events proposal.output.trace.keep((\ event=flow/event (equal[iota] name event.name)))
    ? !(eq events.len 1) (./err 'flow_extraction_missing_dependency)
    = value events.at(0).value
    ? (unpin value).fil.fall(myth/new).has(['flow 'pending]) (./err 'flow_extraction_pending_dependency)
    | ./ok value
  + mode
    ' The captured law is authoritative. Native history must still select
    ' that exact implementation; never fall through to current publication.
    \ step=flow/step state=namespace
    ^ either[iota nat]
    ? !(and (gt step.origin.ver 0) (equal[care] step.origin.care .x)) (./err 'flow_extraction_unretained_origin)
    ?> (./known tree) (sovereign_view step.origin.care step.origin.ver step.origin.path state) (./err 'flow_extraction_origin_unavailable)
    ? (maybe/is_none tree.fil) (./err 'flow_extraction_origin_unavailable)
    = matches=bool
        ?> (./ok law) (flow_ops/select "step" step.origin state) .false
        | equal[pin[flow/operation]] step.law (pin law)
    ? matches (./ok "step")
    = matches=bool
        ?> (./ok law) (flow_ops/select "invoke" step.origin state) .false
        | equal[pin[flow/operation]] step.law (pin law)
    ? matches (./ok "invoke")
    | ./err 'flow_extraction_captured_behavior_unavailable
  + modes
    \ steps=row[flow/step] state=namespace
    ^ either[iota axal[nat]]
    % todo=row[flow/step] steps modes=axal[nat] (axal/new[nat] .none)
    ^ either[iota axal[nat]]
    ?> (./some pair) todo.pull (./ok modes)
    = [step rest] pair
    < mode (flow_extract_ops/mode step state)
    | _ rest modes.put([step.name] mode)
  + page_node
    \ entry=[p=path q=myth]
    ^ snode
    = [relative record] entry
    ?> page=flow/page record.pail_at(['flow 'page]) (snode/sect "Invalid retained page" [] [])
    = name (? relative.len (str/to_atom (str/join "/" (relative.map((\ part=iota (str/from_atom (quip_val part))))))) "/")
      attrs=row[sattr] [(sattr ["flow" "page"] [(sval/word name)])]
      attrs (? page.uses.len attrs.snoc((sattr ["flow" "uses"] (page.uses.map((\ use=iota (sval/word (quip_val use))))))) attrs)
    | snode/sect page.title attrs page.body
  + input_node
    \ input=iota
    ^ snode
    | snode/sect (quip_val input) [(sattr ["flow" "input"] [(sval/word (quip_val input))])] []
  + binding_attr
    \ binding=flow/binding
    ^ sattr
    | sattr ["flow" "bind"] [(sval/word (quip_val binding.port)) (sval/word (quip_val binding.value))]
  + step_node
    \ modes=axal[nat] step=flow/step
    ^ snode
    = attrs=row[sattr] [(sattr ["flow" modes.gut([step.name] "step")] [(sval/word (quip_val step.name)) (sval/ref (seg_texts (safe/spell step.origin)))])]
      attrs attrs.weld(step.bindings.map(flow_extract_ops/binding_attr))
    | snode/sect (quip_val step.name) attrs []
  + source
    \ target=path name=iota steps=row[flow/step] inputs=row[iota] pages=axal[myth] modes=axal[nat]
    ^ str
    = nodes=row[snode] (inputs.map(flow_extract_ops/input_node))
      nodes nodes.weld(pages.tap.map(flow_extract_ops/page_node)).weld(steps.map((flow_extract_ops/step_node modes)))
      result steps.at(steps.len.dec).name
      nodes nodes.snoc((snode/sect "Result" [(sattr ["flow" "result"] [(sval/word (quip_val result))])] []))
      region (snode/sect "Extracted procedure" [(sattr ["flow" "definition"] [(sval/word (quip_val name))])] nodes)
    | str/from_atom (unparse [(snode/doc (seg_texts target) [] [region])])
  + admitted_writes
    \ state=namespace writes=row[[p=path q=writ]]
    ^ either[iota row[[p=path q=writ]]]
    ? !(writes.all((\ [path ignored] state.permitted(path)))) (./err 'write_outside_authority)
    | ./ok writes
  + extract
    ' Requires a new page. Existing native author admission guards source
    ' creation; provenance and example input cells commit atomically.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['attempt] ['name] ['steps] ['expected]] input) (./err 'flow_invalid_arguments)
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ? ((maybe/is_some (state.case(.x target))) || (gt (sovereign_peek target state).wyt 0)) (./err 'flow_extraction_page_exists)
    ?> (./some names) input.path_at(['name]) (./err 'flow_invalid_name)
    ? !(eq names.len 1) (./err 'flow_invalid_name)
    = name names.at(0)
    < checked (flow_ops/name (sval/word (quip_val name)))
    ? !(equal[iota] name checked) (./err 'flow_invalid_name)
    ?> (./some selected) input.path_at(['steps]) (./err 'flow_extraction_requires_steps)
    < origin (cooperate_ops/reference ['attempt] input)
    ? !(equal[care] origin.care .x) (./err 'flow_extraction_requires_retained_run)
    < origin (cooperate_ops/pin_link origin state)
    < capture (cooperate_ops/capture origin state)
    < proposal (flow_extract_ops/proposal (unpin capture.value).fil.fall(myth/new) state.self)
    < steps (flow_extract_ops/selected proposal selected)
    < modes (flow_extract_ops/modes steps state)
    = inputs (flow_extract_ops/inputs steps)
    ? (gt inputs.len 16) (./err 'flow_input_limit)
    = definition (unpin proposal.definition)
      document (steps.any((\ step=flow/step step.bindings.any((\ binding=flow/binding (equal[iota] binding.value 'document))))))
      pages (? document (unpin definition.pages) flow_ops/empty)
      source (flow_extract_ops/source target name steps inputs pages modes)
      author (myth/sing ['source] (pails/t source)).put(['expected] (pails/n input.nat_at(['expected] 0)))
    < writes (flow_nenex_ops/author target author state)
    = provenance=path target.weld(['cells 'extraction])
      writes writes.snoc([provenance (writ/make (native_work_ops/frozen provenance capture))])
      defaults=myth (inputs.fold(myth/new (\ record=myth name=iota record.put(['input name] (safe 0 .z (row/cons[iota] 'x target.weld(['cells 'inputs name])))))))
      writes writes.snoc([target.weld(['flows 'defaults]) (writ/make defaults)])
    % todo=row[iota] inputs writes=row[[p=path q=writ]] writes
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (flow_extract_ops/admitted_writes state writes)
    = [external rest] pair
    < value (flow_extract_ops/example external proposal)
    = cell=path target.weld(['cells 'inputs external])
      record (native_work_ops/value state.self value).put(['flow 'attempt] origin).put(['flow 'value] (pails/q external))
    | _ rest writes.snoc([cell (writ/make record)])

' Investigation notes and model tool calls are evidence, not executable laws.
' Drafting retains selected native events; composition supplies behavior.
+ flow_trace_ops
  + entries
    \ run=path tree=axal[myth]
    ^ either[iota row[[path myth]]]
    ?> (./some activity) (native_work_ops/state tree.fil.fall(myth/new)) (./err 'flow_missing_investigation)
    ? !((eq activity.kind "investigation") || (eq activity.kind "model")) (./err 'flow_missing_investigation)
    % head=maybe[path] activity.head left=nat 128 out=row[[path myth]] []
    ^ either[iota row[[path myth]]]
    ?> (./some at) head (./ok out)
    ? !(left) (./err 'flow_invalid_trace)
    ? !(and (pith_prefix run.weld(['trace]) at) (eq at.len (add run.len 2))) (./err 'flow_invalid_trace)
    ?> (./some card) tree.get(at.drop(run.len)) (./err 'flow_invalid_trace)
    ?> event=native_work/event card.pail_at(['work 'event]) (./err 'flow_invalid_trace)
    ? !(equal[path] event.activity run) (./err 'flow_invalid_trace)
    | _ event.previous left.dec (row/cons[[path myth]] [at card] out)
  + evidence
    ' Prefer the explicitly recorded artifact, otherwise the named captured
    ' context. A note with neither remains an inert text example.
    \ tree=axal[myth]
    ^ axal[myth]
    = context (row/fold[[path myth] axal[myth]] flow_ops/empty flow_trace_ops/context (tree.dip(['context]).tap))
      note ((flow_ops/empty).put([] (myth/sing system_vocabulary/content tree.fil.fall(myth/new).pail_at(system_vocabulary/content))))
      fallback (? context.wyt context (? tree.fil.fall(myth/new).has(['work 'status]) tree note))
    ?> saved=native_work/captured tree.get(['artifact]).fall(myth/new).pail_at(['capture]) fallback
    | unpin saved.value
  + context
    \ out=axal[myth] entry=[path myth]
    ^ axal[myth]
    = [name card] entry
    ?> saved=native_work/captured card.pail_at(['capture]) out
    | out.rep(name (unpin saved.value))
  + input_name
    \ index=nat
    ^ iota
    | $ts (str/to_atom (str/cat_all ["evidence_" (nat/show index.inc)]))
  + settled_tool
    \ entry=[path myth]
    ^ bool
    = [at card] entry
    ?> event=native_work/event card.pail_at(['work 'event]) .false
    | and (eq event.kind "tool-call") (native_work_ops/settled card)
  + node
    \ target=path index=nat entry=[path myth]
    ^ snode
    = [at card] entry
      name (flow_trace_ops/input_name index)
    | snode/sect (quip_val name) [(sattr ["flow" "input"] [(sval/word (quip_val name))])]
        [(snode/prose "Retained example; choose whether this should be an input, an intermediate result, or explanation when composing the procedure." [])
         (snode/ref (seg_texts target.weld(['cells 'trace name])) [])
         (snode/lit "text" [] (str/to_atom card.txt_at(system_vocabulary/content)))]
  + source
    \ target=path name=iota entries=row[[path myth]]
    ^ str
    % index=nat 0 nodes=row[snode] []
    ^ str
    ? (eq index entries.len)
      = region (snode/sect "Procedure to author" [(sattr ["flow" "definition"] [(sval/word (quip_val name))])] nodes)
      | str/from_atom (unparse [(snode/doc (seg_texts target) []
          [(snode/sect (quip_val name) []
          [(snode/prose "Draft extracted from retained work. Selected observations and actions are retained examples, not a replay. Compose captured operations, choose explicit dependencies and a result, then review and publish." [])]) region])])
    | _ index.inc nodes.snoc((flow_trace_ops/node target index entries.at(index)))
  + extract
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['run] ['name] ['events] ['sequence]] input) (./err 'flow_invalid_arguments)
    ? ((state.case(.x target).is_some) || (sovereign_peek target state).wyt) (./err 'flow_extraction_page_exists)
    ?> (./some names) input.path_at(['name]) (./err 'flow_invalid_name)
    ? !(eq names.len 1) (./err 'flow_invalid_name)
    < name (flow_ops/name (sval/word (quip_val names.at(0))))
    ?> (./some run) input.path_at(['run]) (./err 'flow_missing_investigation)
    = tree (sovereign_peek run state)
    < entries (flow_trace_ops/entries run tree)
    ?> (./some activity) (native_work_ops/state tree.fil.fall(myth/new)) (./err 'flow_missing_investigation)
    ? !(eq activity.sequence input.nat_at(['sequence] 0)) (./err 'flow_stale_trace)
    ?> (./some names) input.path_at(['events]) (./err 'flow_extraction_requires_steps)
    ? ((eq names.len 0) || (gt names.len 16)) (./err 'flow_input_limit)
    = selected entries.keep((\ [at card] (row/has[iota] at.at(at.len.dec) names)))
    ? !(eq selected.len names.len) (./err 'flow_extraction_unknown_or_duplicate_step)
    ? !(eq (row/uniq[iota] names).len names.len) (./err 'flow_extraction_unknown_or_duplicate_step)
    ? (and (eq activity.kind "model") !(row/all[[path myth]] flow_trace_ops/settled_tool selected)) (./err 'flow_extraction_unsettled_event)
    = source (flow_trace_ops/source target name selected)
    < writes (flow_nenex_ops/author target (myth/sing ['source] (pails/t source)) state)
    < origin (cooperate_ops/pin_link (safe 0 .x run) state)
    < captured (cooperate_ops/capture origin state)
    = owner=path target.weld(['work 'extraction])
      record (native_work_ops/open target "authoring" (myth/sing ['flow 'trace_name] (pails/q name)))
      record record.put(['flow 'trace_origin] origin).put(['flow 'trace_events] (pails/p names))
      writes writes.snoc([owner (writ/make record)])
      writes writes.snoc([target.weld(['cells 'extraction]) (writ/make (native_work_ops/frozen target captured))])
      context (safe 0 .x target)
      hole=path target.weld(['holes 'extraction])
      question=str "Choose executable operations, explicit inputs and dependencies for the retained investigation; review the authored procedure."
      config (native_work/hole owner target context question "An explicitly composed Semidoc flow")
    < demand (native_work_ops/retain_hole hole config (pin flow_ops/empty) owner myth/new)
    = writes writes.snoc([hole (writ/make demand)])
    % todo=row[[path myth]] selected index=nat 0 writes=row[[p=path q=writ]] writes defaults=myth myth/new
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull
      | flow_extract_ops/admitted_writes state writes.snoc([target.weld(['flows 'defaults]) (writ/make defaults)])
    = [entry rest] pair
      [at card] entry
      name (flow_trace_ops/input_name index)
    ?> (./some version) state.case(.z at) (./err 'flow_invalid_trace)
    < saved (cooperate_ops/capture (safe version .z at) state)
    = cell=path target.weld(['cells 'inputs name])
      trace=path target.weld(['cells 'trace name])
      value (native_work_ops/value state.self (pin (flow_trace_ops/evidence (unpin saved.value)))).put(['flow 'trace_origin] saved.source)
      writes writes.snoc([trace (writ/make (native_work_ops/frozen trace saved))]).snoc([cell (writ/make value)])
      defaults defaults.put(['input name] (safe 0 .z (row/cons[iota] 'x cell)))
    | _ rest index.inc writes defaults
  + review
    ' Review is an explicit domain decision over a compilable authored source.
    ' The ordinary hole keeps watching source edits after this acknowledgement.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['source] ['expected]] input) (./err 'flow_invalid_arguments)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    = source (cooperate_ops/record target state).fall(myth/new).txt_at(['src])
    ? !(eq source input.txt_at(['source])) (./err 'flow_stale_source)
    = owner=path target.weld(['work 'extraction])
      record (cooperate_ops/record owner state).fall(myth/new)
    ?> name=pails/q record.pail_at(['flow 'trace_name]) (./err 'flow_missing_investigation)
    < compiled (flow_ops/compile name.q (safe state.case(.x target).fall(0) .x target) source state)
    = hole=path target.weld(['holes 'extraction])
      demand (cooperate_ops/record hole state).fall(myth/new)
    ?> config=native_work/hole demand.pail_at(['work 'hole]) (./err 'missing_work_hole)
    ? !(and (equal[path] config.owner owner) (equal[path] config.subject target)) (./err 'work_hole_collision)
    ?> progress=native_work/hole_state demand.pail_at(['work 'hole_state]) (./err 'missing_work_hole)
    = resolve (myth/sing ['attempt] (pails/p owner)).put(['expected] (pails/n progress.generation))
      resolve resolve.put(['content] (pails/t "Reviewed the authored operations and bindings. Publication remains explicit."))
    < writes (cooperate_ops/resolve_hole hole resolve state)
    | flow_extract_ops/admitted_writes state writes
