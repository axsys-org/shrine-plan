{
  "version": 1,
  "name": "flows",
  "dependencies": [
    "cooperate",
    "nenex"
  ],
  "modules": {
    "flow": "flow.foil",
    "flow_markdown": "markdown.foil",
    "flow_operations": "operations.foil",
    "flow_runtime": "runtime.foil",
    "flow_work": "work.foil",
    "flow_nenex": "nenex.foil",
    "flow_maintenance": "maintenance.foil",
    "flows_mount": "activation.foil",
    "flow_interface": "interface.foil",
    "flow_sources": "sources.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "flows"
      ],
      "files": [
        "main.grove"
      ]
    }
  ],
  "roots": [
    [
      "lib",
      "flow"
    ],
    [
      "lib",
      "flow_markdown"
    ],
    [
      "lib",
      "flow_operations"
    ],
    [
      "lib",
      "flow_runtime"
    ],
    [
      "lib",
      "flow_work"
    ],
    [
      "lib",
      "flow_nenex"
    ],
    [
      "lib",
      "flow_maintenance"
    ],
    [
      "lib",
      "flows_mount"
    ],
    [
      "lib",
      "flow_interface"
    ],
    [
      "lib",
      "flow_sources"
    ],
    [
      "gov",
      "flows"
    ]
  ],
  "tests": {
    "tests/flows": "tests.foil",
    "flow_ui_tests": "interface_tests.foil"
  },
  "activate": {
    "module": "flows_mount",
    "entry": [
      "flows_mount",
      "install"
    ]
  },
  "http": {
    "module": "flow_interface",
    "entry": [
      "flow_ui",
      "http"
    ]
  },
  "routes": [
    "/nenex/flows"
  ],
  "assets": {},
  "files": {},
  "host": "host.py"
}
