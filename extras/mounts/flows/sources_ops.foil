- flow_operations
- flow_nenex_ops
- source_mount
- grove_install
- flow_maintenance_ops
- json [at=source_json]
- nenex_interface

' Files enter through the existing source mount. Reading its evidence cell is
' pure; the same flow hands react to changed captures as to any other input.
- flow_sources

+ flow_sources_ops
  + page_view
    ' A native page is evidence in the same world. Its identity is its exact
    ' historical x reference, not an invented filesystem digest.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> source=safe context.pail_at(bond/tack) flow_ops/empty
    ?> (./some names) context.path_at(['flow 'source_name]) flow_ops/empty
    ? !(eq names.len 1) flow_ops/empty
    = version context.nat_at(['sys 'tack 'case] 0)
      content input.fil.fall(myth/new).txt_at(['src])
    ? ((eq version 0) || (eq content.len 0) || (gt content.len 131072)) flow_ops/empty
    = origin (safe version .x source.path)
      identity (path_show (safe/spell origin))
      record (myth/sing ['flow 'source] (flow/source (path_show source.path) identity "nenex" content))
      record record.put(['flow 'origin] origin).put(['location] (pails/t (path_show source.path))).put(['digest] (pails/t identity))
      record record.put(system_vocabulary/lede (pails/t (str/from_atom (quip_val names.at(0)))))
    | (flow_ops/empty).put(names record)
  + bind_page
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['source] ['name]] input) (./err 'flow_invalid_arguments)
    < source (cooperate_ops/reference ['source] input)
    ?> (./some names) input.path_at(['name]) (./err 'flow_invalid_name)
    ? !(eq names.len 1) (./err 'flow_invalid_name)
    < name (flow_ops/name (sval/word (quip_val names.at(0))))
    = corpus=path [state.self 'app 'nenex 'w]
    ? !(and (pith_prefix corpus target) (eq target.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(and (pith_prefix corpus source.path) (ge source.path.len corpus.len.inc)) (./err 'flow_nenex_destination)
    ? !(and (eq source.ver 0) (equal[care] source.care .x)) (./err 'flow_invalid_page_source)
    = author (cooperate_ops/record target state).fall(myth/new)
      evidence (cooperate_ops/record source.path state).fall(myth/new)
    ? !(author.has(['src])) (./err 'flow_missing_source)
    ? !(evidence.has(['src])) (./err 'flow_missing_source)
    = cell=path target.weld(['cells ($ts (weft/cat2 (quip_val name) "_source"))])
      settings=path target.weld(['flows 'defaults])
    ? (flow_maintenance_ops/overlaps cell source.path) (./err 'flow_overlapping_input)
    ? !(and (state.permitted(cell)) (state.permitted(settings))) (./err 'write_outside_authority)
    = record (myth/sing bond/weft (spun flow_sources_ops/page_view .none)).put(bond/tack source).put(['flow 'source_name] (pails/p [name]))
      defaults (cooperate_ops/record settings state).fall(myth/new).put(['input 'sources] (safe 0 .z (row/cons[iota] 'x cell)))
      writes=row[[p=path q=writ]]
        ? (equal[maybe[myth]] (cooperate_ops/record settings state) (./some defaults)) []
        [[settings (writ/make defaults)]]
    ? (cooperate_ops/record cell state)
     > (./some prior)
      ? !(equal[myth] prior record) (./err 'flow_source_collision)
      | ./ok writes
    ? (gt (sovereign_peek cell state).wyt 0) (./err 'flow_source_collision)
    | ./ok writes.snoc([cell (writ/make record)])
  + text
    \ key=str value=json
    ^ str
    ?> (./obj fields) value ""
    = matches=row[jkv] fields.keep((\ field=jkv (eq field.k key)))
    ? !(eq matches.len 1) ""
    ?> (./str text) matches.at(0).v ""
    text
  + decode
    \ bytes=nat
    ^ axal[myth]
    ? (le bytes 1) flow_ops/empty
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ? (gt text.len 1500000) flow_ops/empty
    ?> (./ok parsed _) (source_json/parse text) flow_ops/empty
    ?> (./obj fields) parsed flow_ops/empty
    ? ((eq fields.len 0) || (gt fields.len 64)) flow_ops/empty
    % todo=row[jkv] fields out=axal[myth] flow_ops/empty
    ^ axal[myth]
    ?> (./some pair) todo.pull out
    = [field rest] pair
    ?> (./ok name) (flow_ops/name (sval/word (str/to_atom field.k))) flow_ops/empty
    ? out.has([name]) flow_ops/empty
    = location (flow_sources_ops/text "location" field.v)
      digest (flow_sources_ops/text "digest" field.v)
      format (flow_sources_ops/text "format" field.v)
      content (flow_sources_ops/text "content" field.v)
      title (flow_sources_ops/text "title" field.v)
    ? ((eq location.len 0) || !(eq digest.len 64) || (eq content.len 0) || (gt content.len 131072)) flow_ops/empty
    = record (myth/sing ['flow 'source] (flow/source location digest format content))
      record record.put(system_vocabulary/lede (pails/t title)).put(['location] (pails/t location)).put(['digest] (pails/t digest))
    | _ rest out.put([name] record)
  + bundle_name
    ' A feed observes one live file owned by this filesystem capture. Retained
    ' bytes alone do not establish that the file is in its latest scan.
    \ source=safe root=path
    ^ maybe[str]
    ? !(and (eq source.ver 0) (equal[care] source.care .x)) .none
    ? !(and (eq source.path.len root.len.inc) (pith_prefix root source.path)) .none
    = key source.path.at(root.len)
    ? !(is_text key) .none
    | ./some (str/from_atom (quip_val key))
  + available
    \ source=safe mount=myth
    ^ bool
    ?> (./some root) (fs/destination mount) .false
    ?> (./some name) (flow_sources_ops/bundle_name source root) .false
    ?> report=fs/report mount.pail_at(bond/res) .false
    ?> pending=pails/b mount.pail_at(bond/pending) .false
    ? pending.b .false
    ? !(and (equal[path] report.target root) (eq report.epoch mount.nat_at(bond/epoch 0))) .false
    | and (report.known.any((\ file=str (equal[str] file name))))
        !(report.missing.any((\ file=str (equal[str] file name))))
  + advance
    \ b=bowl record=myth
    ^ yell
    ?> source=safe record.pail_at(['source]) (yell [] record)
    = mount b.crew.gut(['mount] flow_ops/empty).fil.fall(myth/new)
      bytes b.crew.gut(['bundle] flow_ops/empty).fil.fall(myth/new).nat_at(bond/content 0)
      prior=flow_maintenance/feed
        ?> held=flow_maintenance/feed record.pail_at(['flow 'feed]) (flow_maintenance/feed source (pin flow_ops/empty) .none)
        held
      ready (flow_sources_ops/available source mount)
    ? !ready
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Repository capture unavailable; last good documents retained")))
    = same=bool
        ?> held=flow_sources/seen record.pail_at(['flow 'source_capture]) .false
        | and (eq held.bytes bytes) (equal[safe] prior.source source)
    ? same
      | yell [] record.put(['flow 'feed] prior.set_fault(.none))
    = value (flow_sources_ops/decode bytes)
    ? !(value.wyt)
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Invalid repository evidence capture")))
    | yell [] record.put(['flow 'source_capture] (flow_sources/seen bytes)).put(['flow 'feed] (flow_maintenance/feed source (pin value) .none))
  + hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | flow_sources_ops/advance b record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_sources_ops/advance b record.meld(input)
  + form
    ^ form
    | def_form.set_init(native_work_ops/wake).set_hear(flow_sources_ops/hear).set_talk(flow_sources_ops/talk)
  + record
    \ source=safe mount=path
    ^ myth
    = cell (myth/sing bond/weft (spun flow_maintenance_ops/source_view .none)).put(bond/tack (safe 0 .x (flow_ops/key mount.at(0) 'empty)))
      cell cell.put(['source] source).put(limb_slot (kook [(flow_ops/key mount.at(0) 'source_hand)]))
    | cell.put(crew_slot (cpail ((crew/sing ['bundle] (dep source.care source.path)).put(['mount] (dep .x mount)))))
  + mount_of
    ' Ownership is the live native dependency, not a second owner table.
    \ record=myth
    ^ maybe[path]
    ?> source=safe record.pail_at(['source]) .none
    ?> (./some bundle) record.crew_at(crew_slot).get(['bundle]) .none
    ? !(equal[dep] bundle (dep source.care source.path)) .none
    | record.crew_at(crew_slot).get(['mount]).run(dep/p)
  + watch_change
    \ target=path mount=path attached=bool state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(state.permitted(mount)) (./err 'write_outside_authority)
    ? !(and (eq mount.len 4) (pith_prefix [state.self 'io 'fs] mount)) (./err 'flow_invalid_source_mount)
    ?> (./some configured) (cooperate_ops/record mount state)
      (? attached (./err 'flow_missing_source_mount) (./ok []))
    = shared
        | (sovereign_hive state).keys.any
          \ owner=path
          ? (equal[path] owner target) .false
          = record (cooperate_ops/record owner state).fall(myth/new)
          | equal[maybe[path]] (flow_sources_ops/mount_of record) (./some mount)
      active (attached || shared)
      seconds configured.nat_at(['fs 'watch_seconds] 0)
      seconds (? (and (ge seconds 5) (le seconds 3600)) seconds 15)
      update (myth/sing ['fs 'watch_active] (pails/b active)).put(['fs 'watch_seconds] (pails/n seconds))
    ? (equal[myth] configured configured.meld(update)) (./ok [])
    | ./ok [[mount (writ/poke update)]]
  + watch
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['source] ['mount] ['expected]] input) (./err 'flow_invalid_arguments)
    < source (cooperate_ops/reference ['source] input)
    ?> (./some mount) input.path_at(['mount]) (./err 'flow_missing_source_mount)
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ? !(sovereign_observer target state) (./err 'flow_invalid_source_target)
    ?> (./some configured) (cooperate_ops/record mount state) (./err 'flow_missing_source_mount)
    ?> (./some root) (fs/destination configured) (./err 'flow_missing_source_mount)
    ?> (./some name) (flow_sources_ops/bundle_name source root) (./err 'flow_invalid_capture_source)
    ? (flow_maintenance_ops/overlaps target source.path) (./err 'flow_overlapping_input)
    = binding (flow_sources_ops/record source mount)
      prior (cooperate_ops/record target state).fall(myth/new)
      identical (and (equal[pail] prior.pail_at(['source]) source)
          (equal[pail] prior.pail_at(crew_slot) binding.pail_at(crew_slot)))
    ? (and prior.tap.len !identical)
      ? !(equal[pail] prior.pail_at(limb_slot) binding.pail_at(limb_slot)) (./err 'flow_source_collision)
      ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
      | flow_sources_ops/rebind target mount binding prior state
    < watches (flow_sources_ops/watch_change target mount .true state)
    ? identical (./ok watches)
    | ./ok watches.snoc([target (writ/make binding)])
  + rebind
    \ target=path mount=path binding=myth prior=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < attached (flow_sources_ops/watch_change target mount .true state)
    = release=either[iota row[[p=path q=writ]]]
        ?> (./some old) (flow_sources_ops/mount_of prior) (./ok [])
        ? (equal[path] old mount) (./ok [])
        | flow_sources_ops/watch_change target old .false state
    < released release
    ' Keep retained evidence and annotations, including the last good bytes.
    ' advance checks the captured source identity before reusing its decode.
    = record prior.meld(binding)
    | ./ok released.weld(attached).snoc([target (writ/make record)])
  + unwatch
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['expected]] input) (./err 'flow_invalid_arguments)
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ?> (./some prior) (cooperate_ops/record target state) (./err 'flow_missing_source)
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_source)
    ?> (./some mount) (flow_sources_ops/mount_of prior) (./ok [])
    < released (flow_sources_ops/watch_change target mount .false state)
    = record prior.put(crew_slot (cpail (mop/empty)))
    | ./ok released.snoc([target (writ/make record)])
  + relative
    \ self=iota name=str
    ^ path
    | (row/cons[iota] self (path_parse name).fall([]))
  + example_defaults
    \ self=iota spec=source_json/json
    ^ myth
    = feed (flow_sources_ops/text "feed" spec)
      capture (flow_sources_ops/text "capture" spec)
      port (flow_sources_ops/text "port" spec)
      out=myth myth/new
      out (? capture.len (out.put(['capture] (pails/p (flow_sources_ops/relative self capture)))) out)
    ? !(and feed.len port.len) out
    ?> (./ok name) (flow_ops/name (sval/word (str/to_atom port))) out
    | out.put(['input name] (safe 0 .z (row/cons[iota] 'x (flow_sources_ops/relative self feed))))
  + instantiate
    ' Examples declare setup data, not another flow lifecycle. Source pages
    ' still use author/publish/follow; opening an existing page preserves it.
    \ spec=source_json/json target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    = capture_text (flow_sources_ops/text "capture" spec)
      feed_text (flow_sources_ops/text "feed" spec)
    ? !(eq (gt capture_text.len 0) (gt feed_text.len 0)) (./err 'flow_example_catalog)
    ? (and capture_text.len ((eq (flow_sources_ops/relative state.self capture_text).len 1) || (eq (flow_sources_ops/relative state.self feed_text).len 1))) (./err 'flow_example_catalog)
    = defaults (flow_sources_ops/example_defaults state.self spec)
      settings target.weld(['flows 'defaults])
      defaults_writes=row[[p=path q=writ]]
        ? !(defaults.tap.len) []
        ? (equal[maybe[myth]] (cooperate_ops/record settings state) (./some defaults)) []
        [[settings (writ/make defaults)]]
    ? (cooperate_ops/record target state)
     > (./some current)
      ? !(current.has(['src])) (./err 'flow_page_collision)
      | ./ok defaults_writes
    = leaf (flow_sources_ops/text "source" spec)
      source_path=path [state.self 'io 'fs 'flows 'source ($ta (str/to_atom leaf))]
      bytes (cooperate_ops/record source_path state).fall(myth/new).nat_at(bond/content 0)
    ? (le bytes 1) (./err 'flow_example_unavailable)
    = source (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    < authored (flow_nenex_ops/author target (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0)) state)
    = authored authored.weld(defaults_writes)
    ? !(and capture_text.len feed_text.len) (./ok authored)
    = capture (flow_sources_ops/relative state.self capture_text)
      feed (flow_sources_ops/relative state.self feed_text)
      bundle=path capture.weld(['source ($ta (str/to_atom (flow_sources_ops/text "file" spec)))])
      config (fs/cfg (flow_sources_ops/text "folder" spec) capture.snoc('source) (fs/extensions (mop/empty)) [state.self 'kook 'fs])
      config config.put(bond/pending (pails/b .true)).put(['fs 'watch_seconds] (pails/n 15)).put(['fs 'watch_active] (pails/b .true))
      rescan (myth/sing system_vocabulary/op (op 'rescan 'host [] 'scan "Capture source evidence" source_mount/rescan))
      writes=row[[p=path q=writ]] []
      writes (? (cooperate_ops/record capture state).is_some writes writes.weld([[capture (writ/make config)] [capture.weld(['op 'rescan]) (writ/make rescan)]]))
      writes (? (cooperate_ops/record feed state).is_some writes writes.snoc([feed (writ/make (flow_sources_ops/record (safe 0 .x bundle) capture))]))
    | ./ok writes.weld(authored)
  + example_ui
    \ name=iota title=str page=path tree=axal[myth]
    ^ row[weft/node]
    | [(weft/el "details" [] [(weft/leaf "summary" [] "Flow examples")
        (weft/el "form" [(weft/att "method" "post") (weft/att "action" "/nenex/flows") (weft/att "data-native-flow" "")]
          [(nenex_ui/field "action" "example") (nenex_ui/field "page" (show/path page))
           (nenex_ui/field "name" (quip_val name))
           (weft/leaf "button" [(weft/att "type" "submit") (weft/att "disabled" "disabled")] (str/to_atom title))
           (weft/leaf "span" [(weft/att "role" "status") (weft/att "data-flow-status" "")] "")])])]
  + registrations
    ' Register declared examples without instantiating any of their work.
    \ state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = source_path=path [state.self 'io 'fs 'flows 'source ($ta "examples.json")]
      bytes (cooperate_ops/record source_path state).fall(myth/new).nat_at(bond/content 0)
    ? (le bytes 1) (./ok [])
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ?> (./ok value _) (source_json/parse text) (./err 'flow_example_catalog)
    ?> (./obj fields) value (./err 'flow_example_catalog)
    % todo=row[source_json/jkv] fields writes=row[[p=path q=writ]] []
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (./ok writes)
    = [entry rest] pair
    < name (flow_ops/name (sval/word (str/to_atom entry.k)))
    = operation=path [state.self 'gov 'flows 'examples name]
      tool=path [state.self 'gov 'nenex_ui 'tools ($ts (str/to_atom (str/cat_all ["flow_example_" entry.k]))) ]
      title (flow_sources_ops/text "title" entry.v)
      law (namespace_op (flow_sources_ops/instantiate entry.v))
      view (nenex_ui/page_tool (flow_sources_ops/example_ui name title))
    | _ rest writes.weld([[operation (writ/make (myth/sing system_vocabulary/op law))]
        [tool (writ/make (myth/sing ['nenex 'tool] view))]])
  + install
    \ state=namespace
    ^ either[iota namespace]
    < writes (flow_sources_ops/registrations state)
    | grove_install/changes writes state
