- flow_web_foot
- eden

+ flow_web_mount
  + start
    ' Use Eden's existing foot registration. The ordinary activation installs
    ' the home and forms; this hook owns no work, timer or scheduler.
    \ server=nat arguments=row[str]
    ^ nat
    ?> (./some home) (path_parse arguments.at(0))
      | error (pails/t "Missing HTTP provider home")
    ; (eden/register_foot server (helm/supervisor/register home flow_web_foot/run))
    server
