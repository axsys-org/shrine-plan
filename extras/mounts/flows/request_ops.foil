- flow_runtime_ops
- flow_work
- flow_maintenance

' Effectful steps use the same native requests, attempts, holes and providers
' as document revision. The work subtree is the dispatch receipt; no queue or
' process-local cursor decides what is pending. Task cards are ordinary records.
+ flow_request_ops
  + interactive_requests
    ' An authored operation explicitly selects both its task cards and the
    ' native provider capability. Ordinary revision tasks stay tool-inert.
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = tasks args.dip(['tasks])
    ? (!(tasks.wyt) || (gt tasks.wyt 16)) (./err 'flow_request_limit)
    ?> provider=native_work/provider args.get(['provider]).fall(myth/new).pail_at(['work 'provider]) (./err 'flow_missing_provider)
    ? !(tasks.tap.all((\ [name task] (and (gt name.len 0)
        (and (and (gt task.txt_at(['work 'prompt]).len 0) (le task.txt_at(['work 'prompt]).len 24576))
          (and (gt task.txt_at(['work 'schema]).len 0) (le task.txt_at(['work 'schema]).len 8192)))))))
      | ./err 'flow_invalid_request
    = tasks (axal/run[myth myth] (\ task=myth task.put(['work 'provider] provider).put(['work 'interactive] (pails/b .true))) tasks)
    | ./ok (axal/new[myth] (./some (myth/sing ['flow 'judgment] (flow/judgment (pin tasks)))))
  + interactive
    \ task=myth
    ^ bool
    ?> enabled=pails/b task.pail_at(['work 'interactive]) .false
    | enabled.b
  + authorize_current
    ' The same current demand, destination claim and hole head authorize
    ' declared actions and explicitly delegated interactive provider work.
    \ target=path owner=myth state=namespace
    ^ either[iota unit]
    ?> (./some controller_path) owner.path_at(['flow 'request_controller]) (./err 'flow_missing_controller)
    = controller (cooperate_ops/record controller_path state).fall(myth/new)
    ?> config=flow_maintenance/config controller.pail_at(['flow 'config]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress controller.pail_at(['flow 'progress]) (./err 'flow_missing_controller)
    ? !(progress.enabled) (./err 'flow_controller_paused)
    ?> claims=flow_maintenance/claims (cooperate_ops/record (flow_ops/key state.self 'claims) state).fall(myth/new).pail_at(['flow 'claims]) (./err 'flow_claims_invalid)
    ? !(equal[maybe[path]] claims.entries.get(config.destination) (./some controller_path)) (./err 'flow_controller_detached)
    = seen (sovereign_care .x (row/cons[iota] 'x controller_path.snoc('view)) state)
    ? !(flow_request_ops/current owner seen) (./err 'flow_stale_request)
    ? !(flow_request_ops/head target owner config.destination (sovereign_peek config.destination state)) (./err 'flow_stale_request)
    | ./ok []
  + authorize_worker
    ' A captured ordinary namespace operation is the delegation boundary;
    ' Codex need not import flow contracts or infer authority from a path.
    \ worker=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'invalid_work_arguments)
    = record (cooperate_ops/record worker state).fall(myth/new)
    ?> request=native_work/request record.pail_at(['work 'request]) (./err 'work_request_missing)
    = owner (cooperate_ops/record request.owner state).fall(myth/new)
    ? !(and (equal[path] worker request.owner.snoc('worker))
        (and (native_work_ops/active owner) (equal[pail] owner.pail_at(['work 'request]) request))) (./err 'work_not_delegated)
    ? !(and (flow_request_ops/native owner) (flow_request_ops/interactive (flow_request_ops/saved_task owner))) (./err 'work_not_delegated)
    < authorized (flow_request_ops/authorize_current request.owner owner state)
    | ./ok []
  + requests
    ' The controller's native crew selects current work. Retained descendants
    ' are history, not pending work; do not hydrate the whole work subtree.
    \ b=bowl
    ^ axal[myth]
    | b.crew.tap.fold flow_ops/empty
      \ out=axal[myth] entry
      ? !(eq entry.key.len 2) out
      = kind entry.key.at(0)
        key entry.key.at(1)
      ? (eq_iota kind 'request)
        ?> (./some record) entry.val.fil out
        | out.put([key] record)
      ? (eq_iota kind 'worker) out.rep([key 'worker] entry.val)
      ? (eq_iota kind 'draft) out.rep([key 'draft] entry.val)
      out
  + dependency
    \ deps=crew request=path
    ^ crew
    = key request.at(request.len.dec)
      deps deps.put(['request key] (dep .x request)).put(['worker key] (dep .z request.snoc('worker)))
    | deps.put(['guard key] (dep .x (row/cons[iota] 'x request.snoc('guard))))
  + retire
    ' Replaced current attempts become settled before their subscriptions are
    ' removed. A late provider keeps its outcome under the old worker; it can
    ' no longer satisfy current work. Already settled attempts stay untouched.
    \ b=bowl deps=crew
    ^ row[[path writ]]
    | (flow_request_ops/requests b).tap.bind
      \ [name record]
      ? !(eq name.len 1) []
      ? (deps.has(['request name.at(0)])) []
      ? !(native_work_ops/active record) []
      = reason=str "Demand is no longer current; retained attempt does not authorize a result"
        next (native_work_ops/settle "waiting" reason record).put(['flow 'refused] (pails/q 'flow_stale_request))
      | [[b.here.snoc('work).weld(name) (writ/make next.put(system_vocabulary/content (pails/t reason)))]]
  + withdraw_holes
    ' Live hole registrations follow the selected attempts. Withdrawn holes
    ' retain their heads, captures and history; another owner is untouched.
    \ controller=path destination=path before=axal[myth] selected=crew
    ^ row[[path writ]]
    | before.tap.bind
      \ [name record]
      ?> hole=native_work/hole record.pail_at(['work 'hole]) []
      ? !(equal[path] hole.owner controller) []
      ?> subscriptions=cpail record.pail_at(crew_slot) []
      ? !(subscriptions.crew.tap.len) []
      = retained=bool
          ?> head=native_work/hole_state record.pail_at(['work 'hole_state]) .false
          ?> (./some attempt) head.attempt .false
          ? !(eq attempt.len (add controller.len 2)) .false
          ? !(pith_prefix controller.snoc('work) attempt) .false
          | selected.has(['request attempt.at(attempt.len.dec)])
      ? retained []
      | [[destination.weld(name) (writ/poke (myth/sing crew_slot (cpail (mop/empty))))]]
  + task
    \ card=myth
    ^ bool
    | card.has(['work 'prompt])
  + saved_task
    \ record=myth
    ^ myth
    ?> saved=cell_view record.pail_at(['flow 'request_task]) myth/new
    | (unpin saved.tree).fil.fall(myth/new)
  + native
    \ record=myth
    ^ bool
    | record.has(['flow 'request_task])
  + same
    \ step=iota target=path task=myth record=myth
    ^ bool
    | and (equal record.pail_at(['flow 'request_step]) (pails/q step))
      (and (equal[maybe[path]] record.path_at(['flow 'request_target]) (./some target))
        (equal[myth] task (flow_request_ops/saved_task record)))
  + demand_view
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> selected=flow_work/demand context.pail_at(['flow 'demand]) flow_ops/empty
    ?> candidate=flow_work/candidate_view input.fil.fall(myth/new).pail_at(['flow 'demands]) flow_ops/empty
    ? !(eq_iota selected.step candidate.step) flow_ops/empty
    | axal/new[myth] (unpin candidate.tasks).get(selected.target)
  + current
    \ record=myth seen=axal[myth]
    ^ bool
    ?> candidate=flow_maintenance/candidate seen.fil.fall(myth/new).pail_at(['flow 'candidate]) .false
    ?> (./ok proposal) candidate.result .false
    ?> pending=flow/pending (unpin proposal.output.result).fil.fall(myth/new).pail_at(['flow 'pending]) .false
    ?> (./some target) record.path_at(['flow 'request_target]) .false
    ?> (./some task) (unpin pending.tasks).get(target) .false
    | and (equal[pail] record.pail_at(['flow 'definition]) (unpin proposal.definition))
      (flow_request_ops/same pending.step target task record)
  + head
    ' Returning to equal evidence must not revive an obsolete attempt. The
    ' native hole owns the current attempt, independently of value equality.
    \ target=path record=myth destination=path before=axal[myth]
    ^ bool
    ?> (./some hole) record.path_at(['work 'hole_path]) .false
    ? !(pith_prefix destination hole) .false
    = held before.get(hole.drop(destination.len)).fall(myth/new)
    ?> config=native_work/hole held.pail_at(['work 'hole]) .false
    ?> captured=native_work/captured record.pail_at(['capture]) .false
    ? !(and (equal[maybe[path]] (./some config.owner) record.path_at(['flow 'request_controller])) (equal[safe] config.context captured.source)) .false
    ?> progress=native_work/hole_state held.pail_at(['work 'hole_state]) .false
    | equal[maybe[path]] progress.attempt (./some target)
  + blocked
    \ record=myth reason=str
    ^ yell
    = next (native_work_ops/status "blocked" record).put(system_vocabulary/content (pails/t reason))
      next=myth
        ?> progress=flow_maintenance/progress record.pail_at(['flow 'progress]) next
        | next.put(['flow 'progress] progress.set_observed(.none))
    | yell [] next
  + retain_demand
    ' Both ordinary requests and document revisions own the same hole/context
    ' pair. Retain the old head and capture; never replace an edited lens while
    ' merely allocating another attempt at its unchanged address.
    \ hole=path config=native_work/hole context=myth observed=pin[axal[myth]] attempt=path prior=axal[myth]
    ^ either[str myth]
    = previous prior.get(['context])
    ? (and previous.is_none (gt prior.dip(['context]).wyt 0)) (./err "Native work context collision")
    ? (and previous.is_some !(equal[maybe[myth]] previous (./some context))) (./err "Native work context collision")
    ? (and previous.is_some prior.fil.is_none) (./err "Native work context has no owning hole")
    ? (native_work_ops/retain_hole hole config observed attempt prior)
     > (./ok held) (./ok held)
     > (./err why) (./err "Native work hole collision")
  + resumption
    ' The hole already owns the predecessor. This is a navigable work cell,
    ' outside the evidence lens: reading receipts never changes demand guards.
    \ request=path hole=myth
    ^ myth
    = bindings=row[[path safe]] []
      bindings=row[[path safe]]
        ?> head=native_work/hole_state hole.pail_at(['work 'hole_state]) bindings
        ?> (./some previous) head.attempt bindings
        | [[['previous] (safe 0 .x previous)]
           [['actions] (safe 0 .z previous.weld(['worker 'trace]))]]
    | native_work_ops/lens (safe 0 .x request) 'attempt bindings
  + prompt
    \ target=path task=myth
    ^ str
    ? !(flow_request_ops/interactive task) task.txt_at(['work 'prompt])
    | str/cat_all [task.txt_at(['work 'prompt])
        "\nNATIVE WORK: Before performing effects, read the resumption cell at "
        (path_show (row/cons[iota] 'x target.snoc('resumption)))
        ". It exposes the previous attempt and its action trace. Follow previous attempts' resumption links when needed. Inspect accepted receipts and the existing selected cells, occurrences and results before repeating an action. An obsolete answer does not undo accepted effects. Reuse the same selection and occurrence address for the same intended work; a new name means deliberately new work. History is navigation, not current evidence: recheck current inputs and guards. Return the answer once the requested effect is already satisfied."]
  + stage
    \ b=bowl record=myth pending=flow/pending before=axal[myth] definition=pin[flow/definition]
      provider=maybe[pin[native_work/provider]]
    ^ yell
    ?> (./some destination) record.path_at(['flow 'destination]) (yell [] record)
    = requests=axal[myth] (flow_request_ops/requests b)
      deps (crew/sing ['candidate] (dep .x (row/cons[iota] 'x b.here.snoc('view))))
      deps deps.put(['destination] (dep .z destination))
    % todo=row[[path myth]] (unpin pending.tasks).tap current=myth record writes=row[[path writ]] [] deps=crew deps probes=crew (mop/empty)
    ^ yell
    ?> (./some pair) todo.pull (flow_request_ops/finish_stage b record current deps probes writes)
    = [entry rest] pair
      [target task] entry
      prior=row[[path myth]] (requests.tap.keep((\ [name held] (and (eq name.len 1) (flow_request_ops/same pending.step target task held)))))
      usable=row[[path myth]] (prior.keep((\ [name held] (and (flow_request_ops/head b.here.snoc('work).weld(name) held destination before)
        (and !(held.has(['work 'retry_requested])) (equal[pail] held.pail_at(['flow 'definition]) (unpin definition)))))))
    ? usable.len
      = [name held] usable.at(0)
      | _ rest current writes (flow_request_ops/dependency deps b.here.snoc('work).weld(name)) probes
    = sequence (native_work_ops/state current).fall((native_work/activity b.here "flow" "open" 0 .none)).sequence.inc
      name=iota ($ts (str/cat_all ["request_" sequence.show]))
      request=path b.here.weld(['work name])
      subject=path destination.weld(target)
      hole=path subject.weld(['holes (unpin definition).source.path.at((unpin definition).source.path.len.dec) pending.step])
      lens=path hole.snoc('context)
      context (myth/sing ['flow 'demand] (flow_work/demand pending.step target)).put(bond/weft (spun flow_request_ops/demand_view .none)).put(bond/tack (safe 0 .x (row/cons[iota] 'x b.here.snoc('view))))
      config (native_work/hole b.here subject (safe 0 .z (row/cons[iota] 'x lens)) task.txt_at(['work 'prompt]) task.txt_at(['work 'schema]))
      captured (native_work/captured config.context .none (pin (axal/new[myth] (./some task))))
      vacant b.crew.get(['probe name])
    ?> (./ok available) (native_work_ops/vacant vacant)
      | flow_request_ops/blocked record "Native work request collision"
    = probes (? available probes (probes.put(['probe name] (dep .z request))))
    = admitted (flow_request_ops/retain_demand hole config context captured.value request before.dip(hole.drop(destination.len)))
    ? admitted
     > (./err reason) (flow_request_ops/blocked record reason)
    = held (either/ok_val admitted)
    = root (native_work_ops/event_record b.here "attempt" current (native_work_ops/attempt b.here "flow_request" captured myth/new))
      root root.put(['work 'resumption] (pails/p request.snoc('resumption)))
      root root.put(['flow 'request_controller] (pails/p b.here)).put(['flow 'request_step] (pails/q pending.step)).put(['flow 'request_target] (pails/p target))
      root root.put(['flow 'request_task] (cell_view captured.value)).put(['flow 'definition] (unpin definition)).put(['work 'hole_path] (pails/p hole))
      root (? (flow_request_ops/interactive task) root.put(['work 'authorize] (namespace_op flow_request_ops/authorize_worker)) root)
      root root.put(system_vocabulary/lede (pails/t task.txt_at(['work 'prompt]))).put(system_vocabulary/content (pails/t "Awaiting native provider"))
      root=myth
        ? task.has(['work 'provider]) root.put(['work 'provider] task.pail_at(['work 'provider]))
        ?> (./some provider) provider root
        | root.put(['work 'provider] (unpin provider))
      root=myth
        = retried=row[[path myth]] (prior.keep((\ [name held] (and held.has(['work 'retry_requested]) (flow_request_ops/head b.here.snoc('work).weld(name) held destination before)))))
        ? !(retried.len) root
        = [name ignored] retried.at(retried.len.dec)
        | root.put(['work 'retry_of] (pails/p b.here.snoc('work).weld(name)))
      view (native_work_ops/lens (safe 0 .x request) 'attempt
        [[['evidence] (safe 0 .z (row/cons[iota] 'x request.snoc('evidence)))]
         [['live] config.context]])
      writes=row[[path writ]] (row/weld[[path writ]] [[hole (writ/make held)] [lens (writ/make context)] [request (writ/make root)]
        [request.snoc('resumption) (writ/make (flow_request_ops/resumption request before.get(hole.drop(destination.len)).fall(myth/new)))]
        [request.snoc('guard) (writ/make (native_work_ops/watching config.context))]
        [request.snoc('evidence) (writ/make (native_work_ops/frozen request captured))]
        [request.snoc('view) (writ/make view)]] writes)
    | _ rest (native_work_ops/append request current) writes (flow_request_ops/dependency deps request) probes
  + finish_stage
    \ b=bowl original=myth record=myth deps=crew probes=crew writes=row[[path writ]]
    ^ yell
    ? probes.tap.len (flow_request_ops/probe b original probes)
    = current=myth
        ?> jobs=flow_work/jobs record.pail_at(['flow 'jobs]) record
        | record.put(['flow 'jobs] (flow_work/jobs [] jobs.serial))
      withdrawn=row[[path writ]]
        ?> (./some destination) record.path_at(['flow 'destination]) []
        | flow_request_ops/withdraw_holes b.here destination b.crew.gut(['destination] flow_ops/empty) deps
    | yell ((flow_request_ops/retire b deps).weld(withdrawn).weld(writes)) (native_work_ops/status "blocked" current).put(crew_slot (cpail deps)).put(system_vocabulary/content (pails/t "Waiting for native work results"))
  + probe
    ' Native crews establish absence at the exact allocation paths before
    ' creation. Self-wake hydrates empty probes too; no history scan or queue.
    \ b=bowl record=myth probes=crew
    ^ yell
    = next=myth
        ?> progress=flow_maintenance/progress record.pail_at(['flow 'progress]) record
        | record.put(['flow 'progress] progress.set_observed(.none))
    | native_work_ops/probe b next probes
  + allocation_views
    ' Explicit commands already have the admitted namespace. Hydrate only
    ' the bounded possible allocation paths, using the same probe names.
    \ owner=path prefix=str serial=nat count=nat state=namespace views=mop[path axal[myth] lt_pith]
    ^ mop[path axal[myth] lt_pith]
    % n=nat 0 out=mop[path axal[myth] lt_pith] views
    ? (ge n count) out
    = key=iota ($ts (str/cat_all [prefix (add serial n.inc).show]))
    | _ n.inc out.put(['probe key] (sovereign_peek owner.weld(['work key]) state))
  + dispatch
    \ b=bowl record=myth seen=axal[myth]
    ^ maybe[yell]
    = requests=axal[myth] (flow_request_ops/requests b)
    % todo=row[[path myth]] requests.tap
    ^ maybe[yell]
    ?> (./some pair) todo.pull .none
    = [entry rest] pair
      [name attempt] entry
    ? !(and (eq name.len 1) (flow_request_ops/native attempt)) (_ rest)
    ? !(native_work_ops/active attempt) (_ rest)
    ? (attempt.has(['work 'request])) (_ rest)
    ? !(flow_request_ops/current attempt seen) (_ rest)
    ?> (./some destination) record.path_at(['flow 'destination]) (_ rest)
    ? !(flow_request_ops/head b.here.snoc('work).weld(name) attempt destination b.crew.gut(['destination] flow_ops/empty)) (_ rest)
    ?> provider=native_work/provider attempt.pail_at(['work 'provider]) (_ rest)
    ?> (./some guard) (native_work_ops/captured_at b.crew.gut(['guard name.at(0)] flow_ops/empty)) (_ rest)
    ?> captured=native_work/captured attempt.pail_at(['capture]) (_ rest)
    ? !(and (equal[safe] guard.source captured.source) (equal[pin[axal[myth]]] guard.value captured.value)) (_ rest)
    = target=path b.here.snoc('work).weld(name)
      task (flow_request_ops/saved_task attempt)
      request (native_work/request target (flow_request_ops/prompt target task) task.txt_at(['work 'schema]) (safe 0 .x (row/cons[iota] 'x target.snoc('guard))))
    ?> (./ok pair) (native_work_ops/dispatch target.snoc('worker) request provider attempt b.crew.get(['worker name.at(0)]))
      | ./some (yell [] (native_work_ops/status "blocked" record).put(system_vocabulary/content (pails/t "Native work worker collision")))
    = [claimed writes] pair
    | ./some (yell (row/snoc[[path writ]] [target (writ/make claimed)] writes) record)
  + accept
    \ target=path record=myth outcome=native_work/outcome guard=axal[myth] seen=axal[myth] destination=path before=axal[myth]
    ^ either[iota row[[path writ]]]
    < checked (native_work_ops/check_outcome outcome guard)
    ?> captured=native_work/captured record.pail_at(['capture]) (./err 'flow_missing_capture)
    ? !(and (equal[safe] (unpin outcome.guard).source captured.source) (equal[pin[axal[myth]]] (unpin outcome.guard).value captured.value)) (./err 'flow_stale_request)
    ? !(flow_request_ops/current record seen) (./err 'flow_stale_request)
    ? !(flow_request_ops/head target record destination before) (./err 'flow_stale_request)
    < validated (flow_ops/validate_response (flow_request_ops/saved_task record) outcome)
    ?> (./some controller) record.path_at(['flow 'request_controller]) (./err 'flow_missing_controller)
    ?> step=pails/q record.pail_at(['flow 'request_step]) (./err 'flow_missing_request)
    ?> (./some relative) record.path_at(['flow 'request_target]) (./err 'flow_missing_request)
    ?> (./some hole) record.path_at(['work 'hole_path]) (./err 'flow_missing_request)
    = value (myth/sing ['work 'outcome] outcome).put(['work 'result] (safe 1 .x target.weld(['worker 'result]))).put(['work 'attempt] (pails/p target))
      value=myth
        ?> (./some selected) validated value
        | value.put(['work 'value] (cell_view selected))
      resolution value.put(['work 'task] record.pail_at(['flow 'request_task])).put(['flow 'definition] record.pail_at(['flow 'definition]))
      settled (native_work_ops/settle "complete" "Native work completed" record).put(['flow 'response] (cell_view (pin (axal/new[myth] (./some value)))))
      resolved (native_work_ops/status "resolved" before.get(hole.drop(destination.len)).fall(myth/new))
      patch (myth/sing ['work 'status] (pails/t "resolved")).put(['work 'activity] resolved.pail_at(['work 'activity])).put(['work 'reason] (pails/t "Native work completed")).put(crew_slot (cpail (mop/empty)))
      writes=row[[path writ]] [[target (writ/make settled)]
        [target.snoc('result) (writ/make (native_work_ops/value target.at(0) (pin (axal/new[myth] (./some value)))))]
        [controller.weld(['resolutions step.q]).weld(relative) (writ/make resolution)]
        [hole (writ/poke patch)]]
      writes=row[[path writ]]
        ?> (./some selected) validated writes
        | writes.snoc([target.snoc('value) (writ/make (native_work_ops/value target.at(0) selected))])
    | ./ok writes
  + responses
    \ b=bowl record=myth seen=axal[myth]
    ^ maybe[yell]
    = requests=axal[myth] (flow_request_ops/requests b)
    ?> (./some destination) record.path_at(['flow 'destination]) .none
    % todo=row[[path myth]] requests.tap
    ^ maybe[yell]
    ?> (./some pair) todo.pull .none
    = [entry rest] pair
      [name attempt] entry
    ? !(and (eq name.len 1) (flow_request_ops/native attempt)) (_ rest)
    ? !(native_work_ops/active attempt) (_ rest)
    ?> receipt=native_work/request attempt.pail_at(['work 'request]) (_ rest)
    ? !(equal[pail] requests.get(name.snoc('worker)).fall(myth/new).pail_at(['work 'request]) receipt) (_ rest)
    ?> (./some outcome) (native_work_ops/outcome_at requests.dip(name.snoc('worker))) (_ rest)
    = target=path b.here.snoc('work).weld(name)
      result (flow_request_ops/accept target attempt outcome b.crew.gut(['guard name.at(0)] flow_ops/empty) seen destination b.crew.gut(['destination] flow_ops/empty))
    ? result
     > (./ok writes) (./some (yell writes record))
     > (./err why)
      = reason (str/from_atom (quip_val why))
        refused (native_work_ops/settle "waiting" reason attempt).put(['flow 'refused] (pails/q why)).put(system_vocabulary/content (pails/t reason))
        writes=row[[path writ]] [[target (writ/make refused)]]
        writes=row[[path writ]]
          ? !(flow_request_ops/current attempt seen) writes
          ? !(flow_request_ops/head target attempt destination b.crew.gut(['destination] flow_ops/empty)) writes
          ?> (./some hole) attempt.path_at(['work 'hole_path]) writes
          | writes.snoc((native_work_ops/hole_result hole "waiting" reason))
      | ./some (yell writes record)
  + retry
    \ target=path input=myth state=namespace
    ^ either[iota row[[path writ]]]
    ? !(flow_runtime_ops/valid_arguments [['expected]] input) (./err 'flow_invalid_arguments)
    = record (cooperate_ops/record target state).fall(myth/new)
    ? !(flow_request_ops/native record) (./err 'flow_missing_request)
    ? record.has(['work 'retry_requested]) (./ok [])
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_request)
    ? !(and (native_work_ops/settled record) record.has(['flow 'refused])) (./err 'flow_request_not_failed)
    ?> (./some owner) record.path_at(['flow 'request_controller]) (./err 'flow_missing_controller)
    = controller (cooperate_ops/record owner state).fall(myth/new)
    ?> config=flow_maintenance/config controller.pail_at(['flow 'config]) (./err 'flow_missing_controller)
    ?> progress=flow_maintenance/progress controller.pail_at(['flow 'progress]) (./err 'flow_missing_controller)
    ? !(progress.enabled) (./err 'flow_controller_paused)
    ?> claims=flow_maintenance/claims (cooperate_ops/record (flow_ops/key state.self 'claims) state).fall(myth/new).pail_at(['flow 'claims]) (./err 'flow_claims_invalid)
    ? !(equal[maybe[path]] claims.entries.get(config.destination) (./some owner)) (./err 'flow_controller_detached)
    ?> (./known seen) (sovereign_view .x 0 (row/cons[iota] 'x owner.snoc('view)) state) (./err 'flow_view_unavailable)
    ? !(flow_request_ops/current record seen) (./err 'flow_stale_request)
    ? !(flow_request_ops/head target record config.destination (sovereign_peek config.destination state)) (./err 'flow_stale_request)
    ' Like document retries, plan the replacement against this admission's
    ' namespace. A flag followed by a controller poke can read the prior crew
    ' and record the candidate as observed before the retry flag reaches it.
    ?> candidate=flow_maintenance/candidate seen.fil.fall(myth/new).pail_at(['flow 'candidate]) (./err 'flow_view_unavailable)
    ?> (./ok proposal) candidate.result (./err 'flow_view_unavailable)
    ?> pending=flow/pending (unpin proposal.output.result).fil.fall(myth/new).pail_at(['flow 'pending]) (./err 'flow_stale_request)
    = marked record.put(['work 'retry_requested] (pails/b .true))
      views (sovereign_crew_of (./some controller) state).put(['request target.at(target.len.dec)] (axal/new[myth] (./some marked)))
      serial (native_work_ops/state controller).fall((native_work/activity owner "flow" "open" 0 .none)).sequence
      views (flow_request_ops/allocation_views owner "request_" serial (unpin pending.tasks).wyt state views)
      b (bowl [] owner 0 0 flow_ops/empty views)
      staged (flow_request_ops/stage b controller.put(['flow 'progress] progress.set_observed(.none)) pending
        (sovereign_peek config.destination state) proposal.definition config.provider)
      linked=bool
        | staged.cards.any
          \ [name write]
          ?> (./make card) write .false
          | equal[maybe[path]] card.path_at(['work 'retry_of]) (./some target)
    ? !linked (./err 'flow_retry_unavailable)
    | ./ok (row/weld[[path writ]] [[target (writ/make marked)] [owner (writ/make staged.out)]] staged.cards)
