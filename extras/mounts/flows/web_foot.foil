- flow_web_ops
- helm

' Native HTTP transport. The namespace owns commands and work attempts. This
' foot performs one bounded GET for a newly observed command, with no retries,
' timer, Python worker queue, or second work registry.
+ flow_web_foot
  + task
    & feet/task/fact feet/task/ack feet/task/admitted
  + bar
    \ text=str
    ^ nat
    | add (str/to_atom text) (bex (mul 8 text.len))
  + unbar
    \ bytes=nat
    ^ str
    ? (le bytes 1) ""
    | str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes)))))
  + media
    \ headers=row[[name=nat value=nat]]
    ^ str
    % rest=row[[name=nat value=nat]] headers
    ?> (./some pair) rest.pull "application/octet-stream"
    = [entry tail] pair
      [name value] entry
      label (flow_web_foot/unbar name)
    ? ((eq label "content-type") || (eq label "Content-Type")) (flow_web_foot/unbar value)
    | _ tail
  + fetch
    \ url=str
    ^ flow_web/reply
    ? !(flow_web_ops/valid_url url) (flow_web/reply url (./err "Invalid HTTP URL"))
    = ;result (Fetch [(flow_web_foot/bar "GET") (flow_web_foot/bar url) [] []] [[] 30000 3 [131072]])
    ? result
     > (./err code)
      | flow_web/reply url (./err (str/cat_all ["HTTP transport failed: " (nat/show code)]))
     > (./ok response)
      = [status final_url headers body] response
      | flow_web/reply url (./ok (flow_web/response status (flow_web_foot/unbar final_url) (flow_web_foot/media headers) (flow_web_foot/unbar body)))
  + pending
    \ record=myth
    ^ bool
    | and record.has(['web 'url]) !(record.has(['web 'reply]))
  + writes
    ' Shared fact binding is the foot's existing delivery cursor. Commands
    ' already present at startup are uncertain old attempts, never replayed.
    \ fetch={\ str}flow_web/reply old=axal[saga] new=axal[saga] restored=bool
    ^ row[[path writ]]
    % todo=row[[path saga]] new.tap writes=row[[path writ]] []
    ^ row[[path writ]]
    ?> (./some pair) todo.pull writes
    = [entry rest] pair
      [name held] entry
      record (unpin held.myth)
    ? !(eq name.len 1) (_ rest writes)
    ? !(flow_web_foot/pending record) (_ rest writes)
    ? (and !(restored) old.has(name)) (_ rest writes)
    = url record.txt_at(['web 'url])
      ;reply=flow_web/reply
        ? restored (flow_web/reply url (./err "HTTP attempt interrupted by restart; retry through native work"))
        ?> (./ok answer) (Try fetch url) (flow_web/reply url (./err "HTTP transport threw"))
        answer
    | _ rest writes.snoc([name (writ/poke (myth/sing ['web 'reply] reply))])
  + admit
    ' A late transport result cannot resurrect a removed/rebound command or
    ' overwrite a settled response. Work completion remains separately guarded.
    \ home=path name=path reply=flow_web/reply state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = target home.weld(name)
    ?> (./some record) (cooperate_ops/record target state) (./ok [])
    ? !(flow_web_foot/pending record) (./ok [])
    ? !(eq record.txt_at(['web 'url]) reply.requested) (./ok [])
    | ./ok [[target (writ/poke (myth/sing ['web 'reply] reply))]]
  + publish
    \ parent=nat home=path ignored=nat entry=[path writ]
    ^ nat
    ; ignored
    = [path write] entry
    ?> (./poke patch) write 0
    ?> reply=flow_web/reply patch.pail_at(['web 'reply]) 0
    | Send parent (feet/gift/admit 0 (flow_web_foot/admit home path reply)
        (\ error=maybe[pail] before=nat state=namespace [(? error.is_none 200 409) "HTTP result" ""]))
  + run_with
    \ fetch={\ str}flow_web/reply initial=feet/task/init self=nat
    ^ nat
    = home=path
        ?> (./some held) initial.ax.fil []
        | (unpin held.myth).path_at(['web 'home]).fall([])
    ? !(home.len) (error (pails/t "HTTP foot home is missing"))
    ; (row/fold[[path writ] nat] 0 (flow_web_foot/publish initial.parent home) (flow_web_foot/writes fetch (axal/new[saga] .none) initial.ax .true))
    % previous=axal[saga] initial.ax
    = ;[message caps] (Recv[flow_web_foot/task] 0)
    ; (helm/supervisor/close_caps caps)
    ? message
     > (./fact current)
      ? (maybe/is_none current.fil) (CloseHandle initial.parent)
      ; (row/fold[[path writ] nat] 0 (flow_web_foot/publish initial.parent home) (flow_web_foot/writes fetch previous current .false))
      | _ current
     > (./ack _) (_ previous)
     > (./admitted _ _ _ _) (_ previous)
  + run
    \ initial=feet/task/init self=nat
    ^ nat
    | flow_web_foot/run_with flow_web_foot/fetch initial self
