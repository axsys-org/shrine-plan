- flow_markdown

' Pure building blocks. Handbook policy and prose belong to its Semidoc source.
+ flow_operations
  + source_identity
    \ source=flow/source card=myth
    ^ bool
    ? !(eq source.format "nenex") (eq source.digest.len 64)
    ?> origin=safe card.pail_at(['flow 'origin]) .false
    | and origin.ver (and (equal[care] origin.care .x)
        (and (eq source.location (path_show origin.path)) (eq source.digest (path_show (safe/spell origin)))))
  + provenance
    \ source=flow/source
    ^ str
    | str/cat_all [(? (eq source.format "nenex") "Native snapshot: " "Capture SHA-256: ") source.digest]
  + revise
    ' A pure request for judgment. The hand and worker fulfill it separately.
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = sources args.dip(['sources])
      pages args.dip(['pages])
    ? (maybe/is_none pages.fil) (./err 'flow_missing_root_page)
    % todo=row[[p=path q=myth]] pages.tap tasks=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull
      | ./ok (axal/new[myth] (./some (myth/sing ['flow 'judgment] (flow/judgment (pin tasks)))))
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'page]) (./err 'flow_missing_page)
    ?> brief=flow/page held (./err 'flow_invalid_page)
    ? !(and (gt brief.uses.len 0) (brief.uses.all((\ name=iota (sources.has([name])))))) (./err 'flow_missing_citation)
    = evidence (brief.uses.fold(flow_ops/empty (\ tree name tree.put([name] sources.get([name]).fall(myth/new)))))
    | _ rest tasks.put(name (myth/sing ['flow 'task] (flow/task brief (pin evidence))))
  + evidence
    ' Compose concept pages with a compact provenance index, not README mirrors.
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = sources args.dip(['sources])
      pages args.dip(['pages])
      index (flow/page "Source evidence" [(snode/prose "These are the sources used to author the concept documents. Exact captures, revision briefs and proposed documents are retained in the maintenance work cells." [])] [])
    ? (maybe/is_none pages.fil) (./err 'flow_missing_root_page)
    % todo=row[[p=path q=myth]] sources.tap out=axal[myth] pages.put(['reference] (flow_operations/expose index))
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'source]) (./err 'flow_missing_source)
    ?> source=flow/source held (./err 'flow_invalid_source)
    = body=row[snode] [(snode/prose (str/to_atom source.location) [])
        (snode/prose (str/to_atom (flow_operations/provenance source)) [])]
      page (flow/page (str/to_atom card.txt_at(system_vocabulary/lede)) body [])
    | _ rest out.put((row/cons[iota] 'reference name) (flow_operations/expose page))
  + expose
    \ page=flow/page
    ^ myth
    | (myth/sing ['flow 'page] page).put(system_vocabulary/lede (pails/t (str/from_atom page.title))).put(system_vocabulary/content (pails/t (str/from_atom (unparse [(snode/sect page.title [] page.body)]))))
  + inventory
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = tree args.dip(['sources])
    ? !(tree.wyt) (./err 'flow_empty_sources)
    % todo=row[[p=path q=myth]] tree.tap
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (./ok tree)
    = [entry rest] pair
      [name card] entry
    ? !(eq name.len 1) (./err 'flow_source_collection_shape)
    ?> (./some held) card.get(['flow 'source]) (./err 'flow_missing_source)
    ?> source=flow/source held (./err 'flow_invalid_source)
    ? !(and (gt source.location.len 0) (and (flow_operations/source_identity source card) (gt source.content.len 0)))
      | ./err 'flow_incomplete_source
    | _ rest
  + documents
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = pages args.dip(['pages])
      sources args.dip(['sources])
    ? (maybe/is_none pages.fil) (./err 'flow_missing_root_page)
    = reference (flow/page "Source guides" [(snode/prose "Source documentation is decomposed into native sections, instructions and examples. Each guide links to its child documents. Exact source captures remain in the flow's frozen inputs." [])] [])
    % todo=row[[p=path q=myth]] pages.tap out=axal[myth] (flow_ops/empty).put(['reference] (flow_operations/expose reference))
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (flow_operations/references sources out)
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'page]) (./err 'flow_missing_page)
    ?> page=flow/page held (./err 'flow_invalid_page)
    ? !(page.uses.all((\ name=iota (sources.has([name]))))) (./err 'flow_missing_citation)
    | _ rest out.put(name (flow_operations/expose page))
  + references
    \ sources=axal[myth] pages=axal[myth]
    ^ either[iota axal[myth]]
    % refs=row[[p=path q=myth]] sources.tap out=axal[myth] pages
    ^ either[iota axal[myth]]
    ?> (./some pair) refs.pull (./ok out)
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'source]) (./err 'flow_missing_source)
    ?> source=flow/source held (./err 'flow_invalid_source)
    ?> (./some held) card.get(['flow 'documentation]) (./err 'flow_source_not_decomposed)
    ?> documentation=flow/documentation held (./err 'flow_source_not_decomposed)
    = title documentation.title
      prefix=path (row/cons[iota] 'reference name)
      origin (snode/sect "Source provenance" []
        [(snode/prose (str/to_atom source.location) [])
         (snode/prose (str/to_atom (flow_operations/provenance source)) [])])
    < expanded (flow_operations/sections prefix title documentation.body origin out)
    | _ rest expanded
  + decompose
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = sources args.dip(['sources])
    % todo=row[[p=path q=myth]] sources.tap out=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name card] entry
    ?> (./some held) card.get(['flow 'source]) (./err 'flow_missing_source)
    ?> source=flow/source held (./err 'flow_invalid_source)
    = parsed=either[iota row[snode]]
        ? ((eq source.format "md") || (eq source.format "markdown")) (flow_markdown/parse source.content)
        | ./ok [(snode/lit (str/to_atom source.format) [] (str/to_atom source.content))]
    < nodes parsed
    = documented (flow/documentation (str/to_atom card.txt_at(system_vocabulary/lede)) nodes)
      documented=flow/documentation
        ? (and (eq nodes.len 1) (eq (flow_markdown/heading source.content.trim_ascii) 1))
          ? nodes.at(0)
           > (./sect title _ children) (flow/documentation title children)
          documented
        documented
    | _ rest out.put(name card.put(['flow 'documentation] documented))
  + section_name
    \ prefix=path stem=iota pages=axal[myth]
    ^ path
    % ordinal=nat 1
    ^ path
    = name (? (eq ordinal 1) stem ($ts (str/cat_all [(str/from_atom (quip_val stem)) "_" (nat/show ordinal)])))
      target prefix.snoc(name)
    ? (pages.has(target)) (_ ordinal.inc)
    target
  + sections
    \ prefix=path title=nat nodes=row[snode] origin=snode pages=axal[myth]
    ^ either[iota axal[myth]]
    % todo=row[snode] nodes intro=row[snode] [] out=axal[myth] pages
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull
      | ./ok out.put(prefix (flow_operations/expose (flow/page title intro.snoc(origin) [])))
    = [node rest] pair
    ? node
     > (./sect heading attrs body)
      = target (flow_operations/section_name prefix (flow_markdown/slug heading) out)
        page (flow/page heading body.snoc(origin) [])
      | _ rest intro out.put(target (flow_operations/expose page))
    | _ rest intro.snoc(node) out
  + identity
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    | ./ok args.dip(['value])
