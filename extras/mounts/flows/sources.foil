- flow_operations
- flow_nenex
- source_mount
- grove_install
- flow_maintenance
- json [at=source_json]
- nenex_interface

' Files enter through the existing source mount. Reading its evidence cell is
' pure; the same flow hands react to changed captures as to any other input.
+ flow_sources
  + text
    \ key=str value=json
    ^ str
    ?> (./obj fields) value ""
    = matches=row[jkv] fields.keep((\ field=jkv (eq field.k key)))
    ? !(eq matches.len 1) ""
    ?> (./str text) matches.at(0).v ""
    text
  + decode
    \ bytes=nat
    ^ axal[myth]
    ? (le bytes 1) flow/empty
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ? (gt text.len 1500000) flow/empty
    ?> (./ok parsed _) (source_json/parse text) flow/empty
    ?> (./obj fields) parsed flow/empty
    ? ((eq fields.len 0) || (gt fields.len 64)) flow/empty
    % todo=row[jkv] fields out=axal[myth] flow/empty
    ^ axal[myth]
    ?> (./some pair) todo.pull out
    = [field rest] pair
    ?> (./ok name) (flow/name (sval/word (str/to_atom field.k))) flow/empty
    ? out.has([name]) flow/empty
    = location (flow_sources/text "location" field.v)
      digest (flow_sources/text "digest" field.v)
      format (flow_sources/text "format" field.v)
      content (flow_sources/text "content" field.v)
      title (flow_sources/text "title" field.v)
    ? ((eq location.len 0) || !(eq digest.len 64) || (eq content.len 0) || (gt content.len 131072)) flow/empty
    = record (myth/sing ['flow 'source] (flow/source location digest format content))
      record record.put(system_vocabulary/lede (pails/t title)).put(['location] (pails/t location)).put(['digest] (pails/t digest))
    | _ rest out.put([name] record)
  + seen
    : bytes=nat
  + advance
    \ b=bowl record=myth
    ^ yell
    ?> source=safe record.pail_at(['source]) (yell [] record)
    = mount b.crew.gut(['mount] flow/empty).fil.fall(myth/new)
      bytes b.crew.gut(['bundle] flow/empty).fil.fall(myth/new).nat_at(bond/content 0)
      prior=flow_maintenance/feed
        ?> held=flow_maintenance/feed record.pail_at(['flow 'feed]) (flow_maintenance/feed source (pin flow/empty) .none)
        held
      ready=bool
        ?> report=fs/report mount.pail_at(bond/res) .false
        ?> pending=pails/b mount.pail_at(bond/pending) .false
        ? pending.b .false .true
    ? !ready
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Repository capture unavailable; last good documents retained")))
    = same=bool
        ?> held=flow_sources/seen record.pail_at(['flow 'source_capture]) .false
        | eq held.bytes bytes
    ? same
      | yell [] record.put(['flow 'feed] prior.set_fault(.none))
    = value (flow_sources/decode bytes)
    ? !(value.wyt)
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Invalid repository evidence capture")))
    | yell [] record.put(['flow 'source_capture] (flow_sources/seen bytes)).put(['flow 'feed] (flow_maintenance/feed source (pin value) .none))
  + hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | flow_sources/advance b record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_sources/advance b record.meld(input)
  + form
    ^ form
    | def_form.set_init(native_work/wake).set_hear(flow_sources/hear).set_talk(flow_sources/talk)
  + record
    \ source=safe mount=path
    ^ myth
    = cell (myth/sing bond/weft (spun flow_maintenance/source_view .none)).put(bond/tack (safe 0 .x (flow/key mount.at(0) 'empty)))
      cell cell.put(['source] source).put(limb_slot (kook [(flow/key mount.at(0) 'source_hand)]))
    | cell.put(crew_slot (cpail ((crew/sing ['bundle] (dep source.care source.path)).put(['mount] (dep .x mount)))))
  + watch
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime/valid_arguments [['source] ['mount]] input) (./err 'flow_invalid_arguments)
    < source (cooperate/reference ['source] input)
    ?> (./some mount) input.path_at(['mount]) (./err 'flow_missing_source_mount)
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ?> (./some configured) (cooperate/record mount state) (./err 'flow_missing_source_mount)
    ?> (./some root) (fs/destination configured) (./err 'flow_missing_source_mount)
    ? (flow_maintenance/overlaps target source.path) (./err 'flow_overlapping_input)
    = record (flow_sources/record source mount)
    ? (cooperate/record target state)
     > (./some prior)
      ? (and (equal[pail] prior.pail_at(['source]) source)
          (equal[pail] prior.pail_at(crew_slot) record.pail_at(crew_slot))) (./ok [])
      | ./err 'flow_source_collision
    | ./ok [[target (writ/make record)]]
  + relative
    \ self=iota name=str
    ^ path
    | (row/cons[iota] self (path_parse name).fall([]))
  + example_defaults
    \ self=iota spec=source_json/json
    ^ myth
    = feed (flow_sources/text "feed" spec)
      capture (flow_sources/text "capture" spec)
      port (flow_sources/text "port" spec)
      out=myth myth/new
      out (? capture.len (out.put(['capture] (pails/p (flow_sources/relative self capture)))) out)
    ? !(and feed.len port.len) out
    ?> (./ok name) (flow/name (sval/word (str/to_atom port))) out
    | out.put(['input name] (safe 0 .z (row/cons[iota] 'x (flow_sources/relative self feed))))
  + instantiate
    ' Examples declare setup data, not another flow lifecycle. Source pages
    ' still use author/publish/follow; opening an existing page preserves it.
    \ spec=source_json/json target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    = capture_text (flow_sources/text "capture" spec)
      feed_text (flow_sources/text "feed" spec)
    ? !(eq (gt capture_text.len 0) (gt feed_text.len 0)) (./err 'flow_example_catalog)
    ? (and capture_text.len ((eq (flow_sources/relative state.self capture_text).len 1) || (eq (flow_sources/relative state.self feed_text).len 1))) (./err 'flow_example_catalog)
    = defaults (flow_sources/example_defaults state.self spec)
      settings target.weld(['flows 'defaults])
      defaults_writes=row[[p=path q=writ]]
        ? !(defaults.tap.len) []
        ? (equal[maybe[myth]] (cooperate/record settings state) (./some defaults)) []
        [[settings (writ/make defaults)]]
    ? (cooperate/record target state)
     > (./some current)
      ? !(current.has(['src])) (./err 'flow_page_collision)
      | ./ok defaults_writes
    = leaf (flow_sources/text "source" spec)
      source_path=path [state.self 'io 'fs 'flows 'source ($ta (str/to_atom leaf))]
      bytes (cooperate/record source_path state).fall(myth/new).nat_at(bond/content 0)
    ? (le bytes 1) (./err 'flow_example_unavailable)
    = source (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    < authored (flow_nenex/author target (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0)) state)
    = authored authored.weld(defaults_writes)
    ? !(and capture_text.len feed_text.len) (./ok authored)
    = capture (flow_sources/relative state.self capture_text)
      feed (flow_sources/relative state.self feed_text)
      bundle=path capture.weld(['source ($ta (str/to_atom (flow_sources/text "file" spec)))])
      config (fs/cfg (flow_sources/text "folder" spec) capture.snoc('source) (fs/extensions (mop/empty)) [state.self 'kook 'fs])
      config config.put(bond/pending (pails/b .true)).put(['fs 'watch_seconds] (pails/n 15))
      rescan (myth/sing system_vocabulary/op (op 'rescan 'host [] 'scan "Capture source evidence" source_mount/rescan))
      writes=row[[p=path q=writ]] []
      writes (? (cooperate/record capture state).is_some writes writes.weld([[capture (writ/make config)] [capture.weld(['op 'rescan]) (writ/make rescan)]]))
      writes (? (cooperate/record feed state).is_some writes writes.snoc([feed (writ/make (flow_sources/record (safe 0 .x bundle) capture))]))
    | ./ok writes.weld(authored)
  + example_ui
    \ name=iota title=str page=path tree=axal[myth]
    ^ row[weft/node]
    | [(weft/el "details" [] [(weft/leaf "summary" [] "Flow examples")
        (weft/el "form" [(weft/att "method" "post") (weft/att "action" "/nenex/flows") (weft/att "data-native-flow" "")]
          [(nenex_ui/field "action" "example") (nenex_ui/field "page" (show/path page))
           (nenex_ui/field "name" (quip_val name))
           (weft/leaf "button" [(weft/att "type" "submit") (weft/att "disabled" "disabled")] (str/to_atom title))
           (weft/leaf "span" [(weft/att "role" "status") (weft/att "data-flow-status" "")] "")])])]
  + registrations
    ' Register declared examples without instantiating any of their work.
    \ state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = source_path=path [state.self 'io 'fs 'flows 'source ($ta "examples.json")]
      bytes (cooperate/record source_path state).fall(myth/new).nat_at(bond/content 0)
    ? (le bytes 1) (./ok [])
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ?> (./ok value _) (source_json/parse text) (./err 'flow_example_catalog)
    ?> (./obj fields) value (./err 'flow_example_catalog)
    % todo=row[source_json/jkv] fields writes=row[[p=path q=writ]] []
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (./ok writes)
    = [entry rest] pair
    < name (flow/name (sval/word (str/to_atom entry.k)))
    = operation=path [state.self 'gov 'flows 'examples name]
      tool=path [state.self 'gov 'nenex_ui 'tools ($ts (str/to_atom (str/cat_all ["flow_example_" entry.k]))) ]
      title (flow_sources/text "title" entry.v)
      law (namespace_op (flow_sources/instantiate entry.v))
      view (nenex_ui/page_tool (flow_sources/example_ui name title))
    | _ rest writes.weld([[operation (writ/make (myth/sing system_vocabulary/op law))]
        [tool (writ/make (myth/sing ['nenex 'tool] view))]])
  + install
    \ state=namespace
    ^ either[iota namespace]
    < writes (flow_sources/registrations state)
    | grove_install/changes writes state
