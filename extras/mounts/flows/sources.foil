- flow_operations
- flow_nenex
- source_mount
- grove_install
- flow_maintenance
- json [at=source_json]

' Files enter through the existing source mount. Reading its evidence cell is
' pure; the same flow hands react to changed captures as to any other input.
+ flow_sources
  + text
    \ key=str value=json
    ^ str
    ?> (./obj fields) value ""
    = matches=row[jkv] fields.keep((\ field=jkv (eq field.k key)))
    ? !(eq matches.len 1) ""
    ?> (./str text) matches.at(0).v ""
    text
  + decode
    \ bytes=nat
    ^ axal[myth]
    ? (le bytes 1) flow/empty
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ? (gt text.len 1500000) flow/empty
    ?> (./ok parsed _) (source_json/parse text) flow/empty
    ?> (./obj fields) parsed flow/empty
    ? ((eq fields.len 0) || (gt fields.len 64)) flow/empty
    % todo=row[jkv] fields out=axal[myth] flow/empty
    ^ axal[myth]
    ?> (./some pair) todo.pull out
    = [field rest] pair
    ?> (./ok name) (flow/name (sval/word (str/to_atom field.k))) flow/empty
    ? out.has([name]) flow/empty
    = location (flow_sources/text "location" field.v)
      digest (flow_sources/text "digest" field.v)
      format (flow_sources/text "format" field.v)
      content (flow_sources/text "content" field.v)
      title (flow_sources/text "title" field.v)
    ? ((eq location.len 0) || !(eq digest.len 64) || (eq content.len 0) || (gt content.len 131072)) flow/empty
    = record (myth/sing ['flow 'source] (flow/source location digest format content))
      record record.put(system_vocabulary/lede (pails/t title)).put(['location] (pails/t location)).put(['digest] (pails/t digest))
    | _ rest out.put([name] record)
  + seen
    : bytes=nat
  + advance
    \ b=bowl record=myth
    ^ yell
    ?> source=safe record.pail_at(['source]) (yell [] record)
    = mount b.crew.gut(['mount] flow/empty).fil.fall(myth/new)
      bytes b.crew.gut(['bundle] flow/empty).fil.fall(myth/new).nat_at(bond/content 0)
      prior=flow_maintenance/feed
        ?> held=flow_maintenance/feed record.pail_at(['flow 'feed]) (flow_maintenance/feed source (pin flow/empty) .none)
        held
      ready=bool
        ?> report=fs/report mount.pail_at(bond/res) .false
        ?> pending=pails/b mount.pail_at(bond/pending) .false
        ? pending.b .false .true
    ? !ready
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Repository capture unavailable; last good documents retained")))
    = same=bool
        ?> held=flow_sources/seen record.pail_at(['flow 'source_capture]) .false
        | eq held.bytes bytes
    ? same
      | yell [] record.put(['flow 'feed] prior.set_fault(.none))
    = value (flow_sources/decode bytes)
    ? !(value.wyt)
      | yell [] record.put(['flow 'feed] prior.set_fault((./some "Invalid repository evidence capture")))
    | yell [] record.put(['flow 'source_capture] (flow_sources/seen bytes)).put(['flow 'feed] (flow_maintenance/feed source (pin value) .none))
  + hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | flow_sources/advance b record
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | flow_sources/advance b record.meld(input)
  + form
    ^ form
    | def_form.set_init(native_work/wake).set_hear(flow_sources/hear).set_talk(flow_sources/talk)
  + install
    \ state=namespace
    ^ either[iota namespace]
    = mount=path [state.self 'io 'fs 'flows]
      files=path mount.snoc('source)
      source (cooperate/record files.snoc(($ta "handbook.semidoc")) state).fall(myth/new).nat_at(bond/content 0)
    ? (le source 1) (./ok state)
    = source (str/from_atom (mod source (bex (mul 8 (dec (wid source))))))
      feed=path [state.self 'user 'flow_sources 'handbook_live]
      capture=path [state.self 'io 'fs 'flow_sources]
      bundle=path capture.weld(['source ($ta "repository-evidence.json")])
      config (fs/cfg "mounts/flows" capture.snoc('source) (fs/extensions (mop/empty)) [state.self 'kook 'fs])
      config config.put(bond/pending (pails/b .true)).put(['fs 'watch_seconds] (pails/n 15))
      rescan (myth/sing system_vocabulary/op (op 'rescan 'host [] 'scan "Capture repository evidence" source_mount/rescan))
      cell (myth/sing bond/weft (spun flow_maintenance/source_view .none)).put(bond/tack (safe 0 .x (flow/key state.self 'empty)))
      cell cell.put(['source] (safe 0 .x bundle)).put(limb_slot (kook [(flow/key state.self 'source_hand)]))
      cell cell.put(crew_slot (cpail ((crew/sing ['bundle] (dep .x bundle)).put(['mount] (dep .x capture)))))
      cell cell.put(system_vocabulary/lede (pails/t "Captured repository evidence"))
      page=path [state.self 'app 'nenex 'w 'handbook_flow]
    < state (grove_install/changes [[capture (writ/make config)]
        [capture.weld(['op 'rescan]) (writ/make rescan)] [feed (writ/make cell)]] state)
    < writes (flow_nenex/author page (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0)) state)
    < state (grove_install/changes writes state)
    < writes (flow_runtime/publish page (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n state.case(.x page).fall(0))) state)
    | grove_install/changes writes state
