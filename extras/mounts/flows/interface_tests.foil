- tests/flows

+ flow_ui_tests
  + act
    \ fields=row[[str str]] state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (flow_ui/plan fields) state (sovereign_hive state))
    next
  + base
    \ action=str
    ^ row[[str str]]
    | [["action" action] ["page" (path_show flow_tests/author)] ["name" "handbook"]]
  + authoring
    \ ignored=unit
    ^ row[testing/check]
    = fields (flow_ui_tests/base "create").weld([["new_name" "onboarding"] ["kind" "document"] ["uses" "readme"] ["brief" "Explain the evidence in practical terms."]])
      created (flow_ui_tests/act fields flow_tests/initial)
      page=path [created.self 'app 'nenex 'w 'onboarding_flow]
      source (flow_tests/get page created).txt_at(['src])
      published_fields=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "onboarding"] ["source" source]]
      published (flow_ui_tests/act published_fields created)
      duplicate (flow_ui/plan fields created)
      stale (flow_ui/plan (row/snoc[[str str]] ["source" "old source"] published_fields.take(3)) published)
      rendered (weft/render (weft/el "div" [] (flow_ui/render page (sovereign_peek page published))))
    [(testing/nat "new flow is an editable native Nenex document" 1 (gt source.len 0))
     (testing/text "saved starter passes native publication checks" "ok" (flow_tests/reason (flow_ui/plan published_fields created)))
     (testing/nat "starter is compiled by the published operation" 1 (flow_tests/get page.weld(['flows 'onboarding]) published).has((flow/key created.self 'definition)))
     (testing/text "creation cannot overwrite an existing authored flow" "flow_stale_source" (flow_tests/reason duplicate))
     (testing/text "publication refuses an obsolete source form" "flow_stale_source" (flow_tests/reason stale))
     (testing/nat "page tools render the published composition" 1 (gt (wid rendered) 0))]
  + generic_install
    \ ignored=unit
    ^ row[testing/check]
    = state flow_tests/initial
      fields (flow_ui_tests/base "create").weld([["new_name" "transform"] ["kind" "composition"]])
      created (flow_ui_tests/act fields state)
      page=path [created.self 'app 'nenex 'w 'transform_flow]
      source (flow_tests/get page created).txt_at(['src])
      request (myth/sing ['id] (pails/t "transform")).put(['expected] (pails/n created.case(.x page).fall(0)))
      published (flow_tests/apply 'publish page request created)
      definition (flow_tests/get page.weld(['flows 'transform]) published)
      sample (flow_ui/plan (flow_ui_tests/base "example") state)
    [(testing/nat "installing the harness creates no handbook page" 0 (flow_tests/get [state.self 'app 'nenex 'w 'handbook_flow] state).has(['src]))
     (testing/nat "installing the harness creates no handbook capture feed" 0 (flow_tests/get [state.self 'user 'flow_sources 'handbook_live] state).has(['source]))
     (testing/nat "composition starter does not require source inventory" 1 (gt source.len 0))
     (testing/nat "composition starter publishes through native operations" 1 definition.has((flow/key state.self 'definition)))
     (testing/nat "handbook example refuses absent evidence instead of inventing it" 1 (either/is_err sample))]
  + example_install
    \ ignored=unit
    ^ row[testing/check]
    = spec (json/obj [(jkv "title" (json/str "Open declared example"))
        (jkv "source" (json/str "sample.semidoc")) (jkv "capture" (json/str "/io/fs/sample_sources"))
        (jkv "feed" (json/str "/user/sample_sources")) (jkv "port" (json/str "sources"))
        (jkv "folder" (json/str "mounts/flows")) (jkv "file" (json/str "repository-evidence.json"))])
      catalog (show (json/obj [(jkv "sample" spec)]))
      bytes (add (str/to_atom catalog) (bex (mul 8 catalog.len)))
      source (flow_tests/book_source "Declared example")
      source_bytes (add (str/to_atom source) (bex (mul 8 source.len)))
      base=path [($x 17) 'io 'fs 'flows 'source]
      filesystem (flow_tests/poke [($x 17) 'kook 'fs] (myth/sing bond/form fs/form) flow_tests/initial)
      seeded (flow_tests/poke base.snoc(($ta "examples.json")) (myth/sing bond/content (pails/n bytes)) filesystem)
      seeded (flow_tests/poke base.snoc(($ta "sample.semidoc")) (myth/sing bond/content (pails/n source_bytes)) seeded)
      installed=namespace
        ?> (./ok next) (flow_sources/install seeded) seeded
        next
      fields=row[[str str]] [["action" "example"] ["page" (path_show flow_tests/author)] ["name" "sample"]]
      created (flow_ui_tests/act fields installed)
      page=path [created.self 'app 'nenex 'w 'sample_flow]
      repeated (flow_ui_tests/act fields created)
      edited (flow_tests/poke page (myth/sing ['src] (pails/t "An authored edit")) created)
      reopened (flow_ui_tests/act fields edited)
    [(testing/nat "declared examples install operations without creating pages" 0 (flow_tests/get page installed).has(['src]))
     (testing/text "example action passes native admission" "ok" (flow_tests/reason (flow_ui/plan fields installed)))
     (testing/text "explicit example creates the authored source" source (flow_tests/get page created).txt_at(['src]))
     (testing/nat "explicit example creates its declared source hand" 1 (flow_tests/get [created.self 'user 'sample_sources] created).has(['source]))
     (testing/nat "opening an existing example is idempotent" created.local.top repeated.local.top)
     (testing/text "opening preserves authored source edits" (flow_tests/get page edited).txt_at(['src]) (flow_tests/get page reopened).txt_at(['src]))]
  + refresh
    \ ignored=unit
    ^ row[testing/check]
    = state=namespace flow_tests/automatic
      target=path [state.self 'gov 'flows]
      hand=path [state.self 'gov 'cooperate 'answer_hand]
      old (flow_tests/get flow_tests/author state)
      stale (flow_tests/poke hand (myth/sing system_vocabulary/form def_form) state)
      fields=row[[str str]] [["action" "refresh"] ["page" (path_show flow_tests/author)]]
      incompatible (flow_tests/poke (flow/key state.self 'claims) (myth/sing ['flow 'claims] (pails/n 1)) stale)
      refused (flow_ui/plan fields incompatible)
      view=path (flow_tests/controller).snoc('view)
      view_card (flow_tests/get view stale)
      bad_progress (flow_tests/poke view (myth/sing ['flow 'progress] (pails/n 1)) stale)
      rejected_progress (flow_ui/plan fields bad_progress)
      refreshed (flow_ui_tests/act fields stale)
      repeated (flow_ui_tests/act fields refreshed)
    [(testing/nat "a spun view has config without controller progress" 1 (and view_card.has(['flow 'config]) !(view_card.has(['flow 'progress]))))
     (testing/nat "config-only cell views retain compatible native types" 1 (flow_ui/compatible_runtime [view view_card]))
     (testing/text "present progress slots still require the exact native type" "flow_runtime_requires_type_migration" (flow_tests/reason rejected_progress))
     (testing/text "refresh refuses incompatible persisted runtime types before rebinding" "flow_runtime_requires_type_migration" (flow_tests/reason refused))
     (testing/nat "refresh restores the published shared hand" 1 (equal[myth] (flow_tests/get hand state) (flow_tests/get hand refreshed)))
     (testing/nat "refresh preserves authored source and published flow" 1 (equal[myth] old (flow_tests/get flow_tests/author refreshed)))
     (testing/nat "repeated code refresh adds no work" refreshed.local.top repeated.local.top)
     (testing/text "refresh cannot target application data" "flow_invalid_refresh_target" (flow_tests/reason (flow_ui/refresh flow_tests/author myth/new state)))]
  + maintenance
    \ ignored=unit
    ^ row[testing/check]
    = state flow_tests/prepared
      source (flow_tests/get flow_tests/author state).txt_at(['src])
      extra=row[[str str]]
        [["destination" (path_show flow_tests/destination)] ["input/sources" (path_show [state.self 'user 'flow_sources])]
         ["provider" ""] ["published" source]]
      fields (flow_ui_tests/base "attach").weld(extra)
      attached (flow_ui_tests/act fields state)
      controller=path (flow_tests/author).weld(['work 'maintenance_handbook])
      pause (row/snoc[[str str]] ["controller" (path_show controller)] (flow_ui_tests/base "pause"))
      paused (flow_ui_tests/act pause attached)
      resumed (flow_ui_tests/act (row/snoc[[str str]] ["controller" (path_show controller)] (flow_ui_tests/base "resume")) paused)
      bad (flow_ui/plan (row/snoc[[str str]] ["controller" "/0x11/user/other"] (flow_ui_tests/base "pause")) resumed)
      obsolete=row[[str str]] [["destination" (path_show flow_tests/destination)] ["published" "obsolete definition"]]
      stale (flow_ui/plan (flow_ui_tests/base "attach").weld(obsolete) resumed)
      tree (sovereign_peek flow_tests/author resumed)
      surface (sovereign_care .z (row/cons[iota] 'x controller.weld(['cells 'work])) resumed)
      output_surface (weft/render (weft/el "div" [] (nenex_ui/cells flow_tests/destination (sovereign_peek flow_tests/destination resumed))))
    [(testing/nat "browser attachment publishes through the shared hand" 1 (gt (flow_tests/get flow_tests/destination attached).txt_at(['src]).len 0))
     (testing/text "bindings pass native maintenance admission" "ok" (flow_tests/reason (flow_ui/plan fields state)))
     (testing/nat "attachment creates the same spun working view" 1 (flow_tests/get (row/snoc[iota] 'view controller) attached).has(bond/weft))
     (testing/nat "existing controllers are discovered from native work" 1 (flow_ui/attached flow_tests/definition tree).len)
     (testing/text "controls cannot target another page's work" "flow_invalid_controller" (flow_tests/reason bad))
     (testing/text "attachment rejects a changed published definition" "flow_stale_definition" (flow_tests/reason stale))
     (testing/nat "pause and resume preserve controller identity" 1 (flow_tests/get controller resumed).has(['flow 'config]))
     (testing/nat "shared cells expose the actual native generation" 2 surface.fil.fall(myth/new).nat_at(['generation] 0))
     (testing/nat "output embeds the same maintenance cell" 1 (cord/has "data-native-cell" output_surface))]
  + status
    \ action=http_foot/action
    ^ nat
    ?> (./reply response) action 0
    | response.status
  + routes
    \ ignored=unit
    ^ row[testing/check]
    = wrong (flow_ui/request (http_foot/request "GET" "/nenex/flows" "") 0)
      duplicate (flow_ui/request (http_foot/request "POST" "/nenex/flows" "action=publish&action=attach") 0)
    [(testing/nat "flow actions require POST" 405 (flow_ui_tests/status wrong))
     (testing/nat "ambiguous forms are refused before admission" 400 (flow_ui_tests/status duplicate))]
  + holes
    \ ignored=unit
    ^ row[testing/check]
    = base flow_revision_tests/prepared
      destination=path [base.self 'app 'nenex 'w 'flow_demand_ui]
      controller=path (flow_tests/author).weld(['work 'maintenance_handbook])
      state (flow_tests/apply 'follow controller (flow_tests/follow_request).put(['destination] (pails/p destination)) base)
      paused (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) state)
      resumed (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .true)) paused)
      subject (weft/render (weft/el "div" [] (flow_ui/render destination (sovereign_peek destination state))))
      author (weft/render (weft/el "div" [] (flow_ui/render flow_tests/author (sovereign_peek flow_tests/author state))))
    [(testing/text "a pending document flow uses the shared blocked phase" "blocked" (flow_tests/get controller state).txt_at(['work 'status]))
     (testing/text "resuming a persistent demand clears the paused phase" "blocked" (flow_tests/get controller resumed).txt_at(['work 'status]))
     (testing/nat "subject exposes persistent work in Nenex" 1 (cord/has "Persistent work" subject))
     (testing/nat "subject exposes its live context lens" 1 (cord/has "Live context lens" subject))
     (testing/nat "authored flow exposes retained demand links" 1 (cord/has "Persistent hole" author))]
  + retry
    \ ignored=unit
    ^ row[testing/check]
    = base=namespace flow_revision_tests/prepared
      target=path (flow_revision_tests/request 1)
      root (flow_tests/get target base)
      worker (myth/sing ['work 'outcome] (native_work/outcome "failed" "Connection ended" (pin (native_work/captured (safe 0 .x target) .none (pin flow/empty))))).put(['work 'status] (pails/t "failed"))
      failed (flow_tests/poke target.snoc('worker) worker base)
      failed (flow_tests/poke target (native_work/settle "waiting" "flow_worker_failed" root).put(['flow 'refused] (pails/q 'flow_worker_failed)) failed)
      edited (flow_tests/poke target.snoc('draft) (myth/sing ['src] (pails/t (str/from_atom (joined 10 [";= Retain this edit" "  Human wording."])))) failed)
      expected (myth/sing ['expected] (pails/n edited.case(.x target).fall(0)))
      fields=row[[str str]] [["action" "retry"] ["page" (path_show flow_tests/author)] ["request" (path_show target)]]
      controller=path flow_tests/controller
      native=namespace
        = [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision target expected) edited (sovereign_hive edited))
        next
      next=path (flow_revision_tests/request 3)
      repeated=namespace
        = [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision target expected) native (sovereign_hive native))
        next
      paused (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) edited)
      detached (flow_tests/apply 'detach controller myth/new edited)
      changed (flow_tests/change_source "New evidence" edited)
      newreply (flow_revision_tests/response next native)
      half (flow_tests/apply 'submit_revision next newreply native)
      done (flow_tests/apply 'submit_revision (flow_revision_tests/request 2) (flow_revision_tests/response (flow_revision_tests/request 2) half) half)
      other=path (flow_revision_tests/request 2)
      lagged (flow_tests/poke other (native_work/settle "waiting" "failed" (flow_tests/get other edited)).put(['flow 'refused] (pails/q 'flow_worker_failed)) edited)
      lag_jobs=flow_work/jobs
        ?> (./some held) (flow_tests/get controller lagged).get(['flow 'jobs]) (flow_work/jobs [] 0)
        ?> jobs=flow_work/jobs held (flow_work/jobs [] 0)
        jobs
      lagged (flow_tests/poke controller (myth/sing ['flow 'jobs] (flow_work/jobs lag_jobs.entries.keep((\ job=flow_work/job (equal[path] job.request other))) lag_jobs.serial)) lagged)
      lagged_next=namespace
        = input (myth/sing ['expected] (pails/n lagged.case(.x other).fall(0)))
          [next index reply] (helm/supervisor/admit (flow_maintenance/retry_revision other input) lagged (sovereign_hive lagged))
        next
      ui_controller=path (flow_tests/author).weld(['work 'maintenance_handbook])
      ui_followed (flow_tests/apply 'follow ui_controller (flow_tests/follow_request).put(['destination] (pails/p [base.self 'app 'nenex 'w 'retry_ui])) base)
      ui_request=path ui_controller.weld(['work 'revision_1])
      ui_failed (flow_tests/poke ui_request (native_work/settle "waiting" "failed" (flow_tests/get ui_request ui_followed)).put(['flow 'refused] (pails/q 'flow_worker_failed)) ui_followed)
      ui_fields=row[[str str]] [["action" "retry"] ["page" (path_show flow_tests/author)] ["request" (path_show ui_request)]]
      ui_done (flow_ui_tests/act ui_fields ui_failed)
      foreign (flow_ui/plan [["action" "retry"] ["page" "/0x11/app/nenex/w/other"] ["request" (path_show ui_request)]] ui_failed)
      rendered (weft/render (weft/el "div" [] (flow_ui/pending_work flow_tests/author ((flow/empty).put(target.drop((flow_tests/author).len) (flow_tests/get target edited))) (flow_work/job 'authored [] (pin (flow/task (flow/page "" [] []) (pin flow/empty))) target .false .false))))
    [(testing/text "retry uses native admission" "ok" (flow_tests/reason (flow_maintenance/retry_revision target expected edited)))
     (testing/nat "retry retains failed request exactly" 1 (equal[myth] (flow_tests/get target edited) (flow_tests/get target native)))
     (testing/nat "retry retains failed worker exactly" 1 (equal[myth] (flow_tests/get target.snoc('worker) edited) (flow_tests/get target.snoc('worker) native)))
     (testing/nat "retry preserves failed x history identity" edited.case(.x target).fall(0) native.case(.x target).fall(0))
     (testing/nat "new attempt links retained failure" 1 (equal[maybe[path]] (./some target) (flow_tests/get next native).path_at(['work 'retry_of])))
     (testing/text "retry carries the edited working draft" (flow_tests/get target.snoc('draft) edited).txt_at(['src]) (flow_tests/get next.snoc('draft) native).txt_at(['src]))
     (testing/nat "repeated retry cannot dispatch another attempt" native.local.top repeated.local.top)
     (testing/text "paused controller refuses retry" "flow_controller_paused" (flow_tests/reason (flow_maintenance/retry_revision target expected paused)))
     (testing/text "detached controller refuses retry" "flow_controller_paused" (flow_tests/reason (flow_maintenance/retry_revision target expected detached)))
     (testing/text "changed request form refuses retry" "flow_stale_request" (flow_tests/reason (flow_maintenance/retry_revision target (myth/sing ['expected] (pails/n 999)) edited)))
     (testing/text "changed evidence cannot retry old task" "flow_stale_revision" (flow_tests/reason (flow_maintenance/retry_revision target expected changed)))
     (testing/text "open requests cannot be retried" "flow_request_not_failed" (flow_tests/reason (flow_maintenance/retry_revision target (myth/sing ['expected] (pails/n base.case(.x target).fall(0))) base)))
     (testing/text "late manual completion cannot satisfy a replaced attempt" "flow_stale_revision" (flow_tests/reason (flow_maintenance/submit_revision target (flow_revision_tests/response target native) native)))
     (testing/nat "new native completion unblocks publication" 1 (flow_tests/progress done).generation)
     (testing/nat "publication leaves failed outcome intact" 1 (equal[myth] (flow_tests/get target.snoc('worker) edited) (flow_tests/get target.snoc('worker) done)))
     (testing/nat "retry links its own target when another demand also needs staging" 1 (equal[maybe[path]] (./some other) (flow_tests/get (flow_revision_tests/request 4) lagged_next).path_at(['work 'retry_of])))
     (testing/nat "other newly staged tasks cannot inherit the retry draft or link" 0 (flow_tests/get (flow_revision_tests/request 3) lagged_next).has(['work 'retry_of]))
     (testing/text "Nenex retry uses the published native operation" "ok" (flow_tests/reason (flow_ui/plan ui_fields ui_failed)))
     (testing/nat "Nenex retry stages a linked fresh attempt" 1 (flow_tests/get ui_controller.weld(['work 'revision_3]) ui_done).has(['work 'retry_of]))
     (testing/text "Nenex refuses another page's retry target" "flow_invalid_revision_target" (flow_tests/reason foreign))
     (testing/nat "Nenex exposes retry alongside retained context" 1 (cord/has "Retry revision" rendered))]
  + sources
    \ ignored=unit
    ^ row[testing/check]
    = envelope (json/obj [(jkv "location" (json/str "README.md"))
        (jkv "digest" (json/str "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
        (jkv "title" (json/str "Source")) (jkv "format" (json/str "md")) (jkv "content" (json/str "Evidence"))])
      text (show (json/obj [(jkv "readme" envelope)]))
      bytes (add (str/to_atom text) (bex (mul 8 text.len)))
      decoded (flow_sources/decode bytes)
      record decoded.get(['readme]).fall(myth/new)
      mount=path [($x 17) 'io 'fs 'capture_test]
      bundle=path [($x 17) 'io 'fs 'capture_test 'bundle]
      feed=path [($x 17) 'user 'captured_sources]
      cell (myth/sing bond/weft (spun flow_maintenance/source_view .none)).put(bond/tack (safe 0 .x (flow/key ($x 17) 'empty)))
      cell cell.put(['source] (safe 0 .x bundle)).put(limb_slot (kook [(flow/key ($x 17) 'source_hand)]))
      cell cell.put(crew_slot (cpail ((crew/sing ['bundle] (dep .x bundle)).put(['mount] (dep .x mount)))))
      seeded (flow_tests/poke bundle (myth/sing bond/content (pails/n bytes)) flow_tests/initial)
      ready (myth/sing bond/res (fs/report 0 mount ["bundle"] [])).put(bond/pending (pails/b .false))
      seeded (flow_tests/poke mount ready seeded)
      captured (flow_tests/poke feed cell seeded)
      failed (flow_tests/poke mount (myth/sing bond/res (fs/failure 1 myth/new "Unavailable")) captured)
      restored (flow_tests/poke mount ready failed)
      reading (sovereign_care .z (row/cons[iota] 'x feed) restored)
    [(testing/nat "filesystem envelopes become native source values" 1 record.has(['flow 'source]))
     (testing/text "capture retains its evidence identity" "README.md" record.txt_at(['location]))
     (testing/nat "re-reading identical evidence is pure and stable" 1 (equal decoded (flow_sources/decode bytes)))
     (testing/nat "missing capture cannot appear as valid evidence" 0 (flow_sources/decode 0).wyt)
     (testing/nat "native capture hand retains decoded evidence" 1 (flow_tests/get feed captured).has(['flow 'source_capture]))
     (testing/nat "failed capture hides stale evidence" 0 (sovereign_care .z (row/cons[iota] 'x feed) failed).wyt)
     (testing/nat "restoring identical evidence recovers its original reading" 1 (equal decoded reading))]
  + accept_draft
    \ ignored=unit
    ^ row[testing/check]
    = base flow_revision_tests/prepared
      controller=path [($x 17) 'app 'nenex 'w 'flow_spec 'work 'maintenance_review]
      destination=path [($x 17) 'app 'nenex 'w 'reviewed_concepts]
      state (flow_tests/apply 'follow controller (flow_tests/follow_request).put(['destination] (pails/p destination)) base)
      request=path (row/weld[iota] ['work 'revision_1] controller)
      draft=path (row/snoc[iota] 'draft request)
      source (flow_tests/get draft state).txt_at(['src])
      fields=row[[str str]] [["action" "submit"] ["page" (path_show draft)] ["request" (path_show request)] ["source" source] ["note" "Reviewed the captured readme."]]
      accepted (flow_ui_tests/act fields state)
      stale=row[[str str]] [["action" "submit"] ["page" (path_show draft)] ["request" (path_show request)] ["source" "obsolete"] ["note" "Reviewed"]]
      rendered (weft/render (weft/el "div" [] (flow_ui/revision draft (sovereign_peek draft state))))
    [(testing/text "saved draft accepts through shared native admission" "ok" (flow_tests/reason (flow_ui/plan fields state)))
     (testing/nat "acceptance retains the native response" 1 (flow_tests/get request accepted).has(['flow 'response]))
     (testing/text "obsolete draft forms cannot accept a later edit" "flow_draft_edited" (flow_tests/reason (flow_ui/plan stale state)))
     (testing/nat "draft exposes native acceptance and Cells context" 1 (and (cord/has "Accept saved draft" rendered) (cord/has "data-native-cell" rendered)))]
+ tests
  ^ row[testing/case]
  [(testing/case "Explicit retries retain failed native work" flow_ui_tests/retry)
   (testing/case "generic harness installation and composition" flow_ui_tests/generic_install)
   (testing/case "Native harness code refresh" flow_ui_tests/refresh)
   (testing/case "Declared example installation" flow_ui_tests/example_install)
   (testing/case "Nenex flow authoring" flow_ui_tests/authoring)
   (testing/case "Nenex native flow controls" flow_ui_tests/maintenance)
   (testing/case "Nenex flow route" flow_ui_tests/routes)
   (testing/case "Nenex retained work presentation" flow_ui_tests/holes)
   (testing/case "Mounted repository evidence" flow_ui_tests/sources)
   (testing/case "Accept a saved concept draft" flow_ui_tests/accept_draft)]
