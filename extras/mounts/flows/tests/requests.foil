- flow_test_world [at=fixture]
- flow_request_ops

- flow_request_fixture [at=world_fixture]

+ request_tests
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /author" "  ;@ /flow/definition handbook" "  ;= Native request flow"
       "    ;@ /flow/input sources" "    ;= Evidence"
       "    ;@ /flow/step fetched ;/0x11/gov/flows/operations/test_request"
       "    ;@ /flow/bind value sources" "    ;= Request native work"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/test_pages"
       "    ;@ /flow/bind responses fetched" "    ;= Present result"
       "    ;@ /flow/result pages" "    ;= Output"])
  + started
    ^ namespace
    = state fixture/flow_tests/prepared
      state (fixture/flow_tests/poke [($x 17) 'gov 'flows 'request_provider] (myth/sing system_vocabulary/form (def_form.set_init(native_work_ops/wake).set_hear(world_fixture/request_tests/hear).set_talk(world_fixture/request_tests/talk))) state)
      root=path [($x 17) 'gov 'flows 'operations]
      state (fixture/flow_tests/poke root.snoc('test_request) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['value] world_fixture/request_tests/request)) state)
      state (fixture/flow_tests/poke root.snoc('test_pages) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['responses] world_fixture/request_tests/pages)) state)
      state (fixture/flow_tests/apply 'author fixture/flow_tests/author (myth/sing ['source] (pails/t request_tests/source)).put(['expected] (pails/n state.case(.x fixture/flow_tests/author).fall(0))) state)
      state (fixture/flow_tests/apply 'publish fixture/flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n state.case(.x fixture/flow_tests/author).fall(0))) state)
    | fixture/flow_tests/apply 'follow fixture/flow_tests/controller fixture/flow_tests/follow_request state
  + authorization
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      a (world_fixture/request_tests/attempt 1)
      worker a.snoc('worker)
      root (fixture/flow_tests/get a first)
      allowed (flow_request_ops/authorize_worker worker myth/new first)
      changed (fixture/flow_tests/change_source "New task evidence" first)
      obsolete (flow_request_ops/authorize_worker worker myth/new changed)
      paused (fixture/flow_tests/apply 'set_enabled fixture/flow_tests/controller (myth/sing ['enabled] (pails/b .false)) first)
      paused_call (flow_request_ops/authorize_worker worker myth/new paused)
      detached (fixture/flow_tests/apply 'detach fixture/flow_tests/controller myth/new first)
      detached_call (flow_request_ops/authorize_worker worker myth/new detached)
      completed (world_fixture/request_tests/deliver a "complete" "Selected current task is complete" first)
      terminal_call (flow_request_ops/authorize_worker worker myth/new completed)
      delegated=bool
        ?> law=namespace_op root.pail_at(['work 'authorize]) .false
        | equal[either[iota row[[p=path q=writ]]]] (law.plan worker myth/new first) allowed
    [(testing/nat "authored operation captures selected provider capability" 1 (flow_request_ops/interactive (flow_request_ops/saved_task root)))
     (testing/nat "current native request grants read/action delegation" 1 (either/is_ok allowed))
     (testing/nat "delegation is an ordinary captured native operation" 1 delegated)
     (testing/nat "changed evidence revokes obsolete task authority" 1 (either/is_err obsolete))
     (testing/nat "pause revokes task authority" 1 (either/is_err paused_call))
     (testing/nat "detach releases authority" 1 (either/is_err detached_call))
     (testing/nat "retained terminal task grants no new tools" 1 (either/is_err terminal_call))]
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      a (world_fixture/request_tests/attempt 1)
      original (fixture/flow_tests/get a first)
      original_x first.local.x_case(a).fall(0)
      original_y first.local.y_case(a).fall(0)
      original_z first.local.z_case(a).fall(0)
      source (flow/source "README.md" (str/repeat 64 "b") "md" "Changed evidence")
      changed (fixture/flow_tests/poke fixture/flow_tests/input_path (myth/sing ['flow 'source] source) first)
      b (world_fixture/request_tests/attempt 2)
      late (world_fixture/request_tests/deliver a "complete" "Old result must not publish" changed)
      failed (world_fixture/request_tests/deliver b "failed" "Controlled provider failure" late)
      retry (myth/sing ['expected] (pails/n failed.case(.x b).fall(0)))
      retry_reason (fixture/flow_tests/reason (flow_maintenance_ops/retry_revision b retry failed))
      retried (fixture/flow_tests/apply 'retry_revision b retry failed)
      c (world_fixture/request_tests/attempt 3)
      done (world_fixture/request_tests/deliver c "complete" "A current result from the shared provider" retried)
      repeated (fixture/flow_tests/apply 'retry_revision b retry done)
      hole=path (fixture/flow_tests/destination).weld(['readme 'holes 'flow_spec 'fetched])
      view (sovereign_view .z 0 (row/cons[iota] 'x (fixture/flow_tests/controller).weld(['cells 'work])) done)
    [(testing/text "authored flow creates a native request" "running" original.txt_at(['work 'status]))
     (testing/nat "shared provider owns dispatch receipt" 1 original.has(['work 'request]))
     (testing/nat "pending work owns an ordinary hole" 1 (fixture/flow_tests/get hole first).has(['work 'hole]))
     (testing/nat "attempt has a context overlay" 1 (fixture/flow_tests/get a.snoc('view) first).has(bond/weft))
     (testing/nat "changed evidence creates a new attempt" 1 (flow_request_ops/native (fixture/flow_tests/get b changed)))
     (testing/nat "old outcome does not publish a document" 0 (fixture/flow_tests/get fixture/flow_tests/destination late).has(['src]))
     (testing/text "obsolete attempt remains refused" "waiting" (fixture/flow_tests/get a late).txt_at(['work 'status]))
     (testing/text "provider failure stays attached as waiting work" "waiting" (fixture/flow_tests/get b failed).txt_at(['work 'status]))
     (testing/text "retry plans a replacement against current native state" "ok" retry_reason)
     (testing/nat "retry records predecessor" 1 (equal[maybe[path]] (fixture/flow_tests/get c retried).path_at(['work 'retry_of]) (./some b)))
     (testing/text "retry completes through shared lifecycle" "complete" (fixture/flow_tests/get c done).txt_at(['work 'status]))
     (testing/nat "flow publishes once after current result" 1 (fixture/flow_tests/progress done).generation)
     (testing/text "hole resolves with current result" "resolved" (fixture/flow_tests/get hole done).txt_at(['work 'status]))
     (testing/nat "live Cells work view is readable" 1 (?=((./known _) view)))
     (testing/nat "retry form is idempotent after completion" done.local.top repeated.local.top)
     (testing/nat "failed predecessor changes only by its explicit retry receipt" 1 (equal[myth] (fixture/flow_tests/get b failed).del(['work 'retry_requested]) (fixture/flow_tests/get b done).del(['work 'retry_requested])))
     (testing/nat "historical x retained" 1 (equal (sov/x_query original_x a first.local) (sov/x_query original_x a done.local)))
     (testing/nat "historical y retained" 1 (equal (sov/y_query original_y a first.local) (sov/y_query original_y a done.local)))
     (testing/nat "historical z retained" 1 (equal (sov/z_query original_z a first.local) (sov/z_query original_z a done.local)))]
  + detached
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      a (world_fixture/request_tests/attempt 1)
      second=path [first.self 'user 'flow_maintenance 'second]
      output=path [first.self 'app 'nenex 'w 'second_answer]
      both (fixture/flow_tests/apply 'follow second (fixture/flow_tests/follow_request).put(['destination] (pails/p output)) first)
      hole=path (fixture/flow_tests/destination).weld(['readme 'holes 'flow_spec 'fetched])
      detached (fixture/flow_tests/apply 'detach fixture/flow_tests/controller myth/new both)
      held (fixture/flow_tests/get hole detached)
      controller (fixture/flow_tests/get fixture/flow_tests/controller detached)
      changed (fixture/flow_tests/change_source "Evidence after detach" detached)
      late (world_fixture/request_tests/deliver a "complete" "Obsolete answer" changed)
      second_attempt=path second.weld(['work 'request_2])
      done (world_fixture/request_tests/deliver second_attempt "complete" "Other consumer still works" late)
      subscriptions=nat
        ?> crew=cpail held.pail_at(crew_slot) 999
        crew.crew.tap.len
    | [(testing/nat "detach releases owned unresolved hole subscriptions" 0 subscriptions)
       (testing/nat "changed evidence leaves detached hole unchanged" 1 (equal[myth] held (fixture/flow_tests/get hole done)))
       (testing/nat "detached controller does not wake for evidence or late result" 1 (equal[myth] controller (fixture/flow_tests/get fixture/flow_tests/controller done)))
       (testing/text "detach settles current attempt without erasing its capture" "waiting" (fixture/flow_tests/get a detached).txt_at(['work 'status]))
       (testing/nat "detach preserves the exact attempt capture" 1 (equal[pail] (fixture/flow_tests/get a first).pail_at(['capture]) (fixture/flow_tests/get a done).pail_at(['capture])))
       (testing/nat "late provider outcome is retained" 1 (fixture/flow_tests/get a.snoc('worker) done).has(['work 'outcome]))
       (testing/nat "late detached outcome cannot publish" 0 (fixture/flow_tests/get fixture/flow_tests/destination done).has(['src]))
       (testing/text "another source consumer completes independently" "complete" (fixture/flow_tests/get second_attempt done).txt_at(['work 'status]))
       (testing/nat "another source consumer publishes its document" 1 (fixture/flow_tests/get output done).has(['src]))]
  + retained_history
    \ count=nat state=namespace
    ^ namespace
    = writes=row[[path writ]]
        | (row/range 0 count).bind
          \ number=nat
          = root=path (fixture/flow_tests/controller).weld(['work ($ts (str/cat_all ["retained_" number.show]))])
            record (native_work_ops/settle "complete" "Retained result" (native_work_ops/open fixture/flow_tests/controller "fixture" myth/new))
            payload (myth/sing ['text] (pails/t (str/repeat 1024 "x")))
          | [[root (writ/make record)] [root.snoc('evidence) (writ/make payload)] [root.snoc('draft) (writ/make payload)] [root.snoc('worker) (writ/make record)]]
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) (Seq[namespace] (error (pails/q why)) state)
  + selected
    \ state=namespace
    ^ axal[myth]
    = record (fixture/flow_tests/get fixture/flow_tests/controller state)
      views (sovereign_crew_of (./some record) state)
    | flow_request_ops/requests (bowl [] fixture/flow_tests/controller 0 0 flow_ops/empty views)
  + history_scope
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      history (request_tests/retained_history 128 first)
      original (fixture/flow_tests/get fixture/flow_tests/controller first)
      expanded (fixture/flow_tests/get fixture/flow_tests/controller history)
      a (world_fixture/request_tests/attempt 1)
      done (world_fixture/request_tests/deliver a "complete" "Current result alongside retained history" history)
    | [(testing/nat "retained history is present in the same native work subtree" 1 (gt (sovereign_peek (fixture/flow_tests/controller).snoc('work) history).wyt 512))
       (testing/nat "unrelated retained work does not wake controller" 1 (equal[myth] original expanded))
       (testing/nat "active dependency projection ignores unrelated retained history" 1 (equal[axal[myth]] (request_tests/selected first) (request_tests/selected history)))
       (testing/nat "current request and worker projection has fixed size" (request_tests/selected first).wyt (request_tests/selected history).wyt)
       (testing/nat "current native crew does not grow with retained history" 1 (equal[pail] original.pail_at(crew_slot) expanded.pail_at(crew_slot)))
       (testing/nat "current request still completes with a large retained history" 1 (fixture/flow_tests/progress done).generation)]
  + bypassed
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      a (world_fixture/request_tests/attempt 1)
      original (fixture/flow_tests/get a first)
      authored (fixture/flow_tests/apply 'author fixture/flow_tests/author
        (myth/sing ['source] (pails/t (fixture/flow_tests/book_source "Now deterministic"))).put(['expected] (pails/n first.case(.x fixture/flow_tests/author).fall(0))) first)
      published (fixture/flow_tests/apply 'publish fixture/flow_tests/author
        (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x fixture/flow_tests/author).fall(0))) authored)
      hole=path (fixture/flow_tests/destination).weld(['readme 'holes 'flow_spec 'fetched])
      late (world_fixture/request_tests/deliver a "complete" "Obsolete work result" published)
      subscriptions=crew
        ?> held=cpail (fixture/flow_tests/get fixture/flow_tests/controller published).pail_at(crew_slot) (mop/empty)
        held.crew
      hole_subscriptions=nat
        ?> held=cpail (fixture/flow_tests/get hole published).pail_at(crew_slot) 999
        held.crew.tap.len
    | [(testing/nat "new pure definition finishes without the pending provider" 1 (fixture/flow_tests/progress published).generation)
       (testing/text "bypassed pending request is settled before dropping subscriptions" "waiting" (fixture/flow_tests/get a published).txt_at(['work 'status]))
       (testing/nat "bypassed demand releases owned hole subscriptions" 0 hole_subscriptions)
       (testing/nat "pure completion retains only candidate and destination dependencies" 2 subscriptions.tap.len)
       (testing/nat "pure completion keeps captured attempt evidence" 1 (equal[pail] original.pail_at(['capture]) (fixture/flow_tests/get a late).pail_at(['capture])))
       (testing/nat "late bypassed provider result stays retained" 1 (fixture/flow_tests/get a.snoc('worker) late).has(['work 'outcome]))
       (testing/nat "late bypassed result never republishes" 1 (fixture/flow_tests/progress late).generation)]
  + retained_controller
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      owner fixture/flow_tests/controller
      a (world_fixture/request_tests/attempt 1)
      original (fixture/flow_tests/get a first)
      old_crew (crew/sing ['candidate] (dep .x (row/cons[iota] 'x owner.snoc('view)))).put(['destination] (dep .z fixture/flow_tests/destination)).put(['requests] (dep .z owner.snoc('work)))
      resumed (fixture/flow_tests/poke owner (myth/sing crew_slot (cpail old_crew)) first)
      current=crew
        ?> held=cpail (fixture/flow_tests/get owner resumed).pail_at(crew_slot) (mop/empty)
        held.crew
      done (world_fixture/request_tests/deliver a "complete" "Existing selected worker completed" resumed)
    | [(testing/nat "retained controller reconciles from its owned hole head" 1 current.has(['request 'request_1]))
       (testing/nat "retained controller releases broad work subscription" 0 current.has(['requests]))
       (testing/nat "reconciliation does not change source evidence" first.case(.x fixture/flow_tests/input_path).fall(0) resumed.case(.x fixture/flow_tests/input_path).fall(0))
       (testing/nat "reconciliation retains the same attempt record and capture" 1 (equal[myth] original (fixture/flow_tests/get a resumed)))
       (testing/nat "reconciliation does not allocate a replacement request" 0 (fixture/flow_tests/get (world_fixture/request_tests/attempt 2) resumed).has(['capture]))
       (testing/nat "existing retained worker completes without a source edit" 1 (fixture/flow_tests/progress done).generation)]
  + retained_adoption
    \ ignored=unit
    ^ row[testing/check]
    = first request_tests/started
      owner fixture/flow_tests/controller
      a (world_fixture/request_tests/attempt 1)
      original (fixture/flow_tests/get a first)
      record (fixture/flow_tests/get owner first)
    ?> config=flow_maintenance/config record.pail_at(['flow 'config])
      | Seq[row[testing/check]] (error (pails/t "Retained adoption fixture lacks config")) []
    = previous (safe first.case(.x fixture/flow_tests/definition).fall(0) .x fixture/flow_tests/definition)
      config config.set_request((pin (unpin config.request).put(['definition] previous)))
      old_crew (crew/sing ['candidate] (dep .x (row/cons[iota] 'x owner.snoc('view)))).put(['destination] (dep .z fixture/flow_tests/destination)).put(['requests] (dep .z owner.snoc('work)))
      record record.put(['flow 'config] config).put(crew_slot (cpail old_crew))
      view (fixture/flow_tests/get owner.snoc('view) first).put(['flow 'config] config).put(bond/tack previous)
      publication (fixture/flow_tests/get fixture/flow_tests/definition first).put(['fixture 'publication] (pails/t "Explicit successor publication"))
      retained=namespace
        = notes (axal/new[note] .none).put(owner (note/make record)).put(owner.snoc('view) (note/make view)).put(fixture/flow_tests/definition (note/make publication))
        ?> (./accepted committed) (namespace/step notes 0 0 first) (Seq[namespace] (error (pails/t "Retained adoption fixture refused")) first)
        committed.state
      selected (safe retained.case(.x fixture/flow_tests/definition).fall(0) .x fixture/flow_tests/definition)
      adopted (fixture/flow_tests/apply 'adopt owner (myth/sing ['previous] previous).put(['definition] selected) retained)
      late (world_fixture/request_tests/deliver a "complete" "Obsolete answer after direct adoption" adopted)
      history=bool (row/all[care] (\ car=care (equal[res[axal[saga]]] (namespace/page car first.case(car a) a first) (namespace/page car first.case(car a) a late))) [.x .y .z])
    | [(testing/nat "adoption fixture reaches command before crew reconciliation" 1 (equal[pail] (cpail old_crew) (fixture/flow_tests/get owner retained).pail_at(crew_slot)))
       (testing/nat "raw retained adoption fixture preserves pending attempt" 1 (equal[myth] original (fixture/flow_tests/get a retained)))
       (testing/nat "adoption selects a distinct retained publication" 1 (gt selected.ver previous.ver))
       (testing/text "direct adoption settles the retained native hole head" "waiting" (fixture/flow_tests/get a adopted).txt_at(['work 'status]))
       (testing/nat "adoption retains the exact prior capture" 1 (equal[pail] original.pail_at(['capture]) (fixture/flow_tests/get a late).pail_at(['capture])))
       (testing/nat "adoption preserves all earlier request x y z cases" 1 history)
       (testing/nat "direct adoption retains the late old worker outcome" 1 (fixture/flow_tests/get a.snoc('worker) late).has(['work 'outcome]))
       (testing/nat "old adopted worker cannot publish its late result" 0 (fixture/flow_tests/progress late).generation)
       (testing/nat "new publication selects a fresh native attempt" 1 (fixture/flow_tests/get (world_fixture/request_tests/attempt 2) adopted).has(['capture]))]
+ tests
  ^ row[testing/case]
  [(testing/case "explicit interactive provider authority follows current work" request_tests/authorization)
   (testing/case "authored native work lifecycle" request_tests/lifecycle)
   (testing/case "detached unresolved holes stop reacting" request_tests/detached)
   (testing/case "current work ignores unrelated retained history" request_tests/history_scope)
   (testing/case "pure completion withdraws formerly pending work" request_tests/bypassed)
   (testing/case "retained pending controller follows its current native hole head" request_tests/retained_controller)
   (testing/case "direct adoption retires a retained unreconciled controller" request_tests/retained_adoption)]
