- flow_test_world
- flow_extract_ops

+ flow_extraction_tests
  + target
    ^ path
    [($x 17) 'app 'nenex 'w 'extracted_procedure]
  + request
    \ names=row[iota]
    ^ myth
    | (myth/sing ['attempt] (safe 0 .x flow_tests/run)).put(['name] (pails/p ['extracted])).put(['steps] (pails/p names))
  + apply
    \ target=path input=myth state=namespace
    ^ namespace
    = [after index reply] (helm/supervisor/admit (flow_extract_ops/extract target input) state (sovereign_hive state))
    | after
  + exact_step
    \ original=flow/definition step=flow/step
    ^ bool
    = originals original.steps.keep((\ old=flow/step (equal[iota] old.name step.name)))
    | and (eq originals.len 1) (equal[pin[flow/operation]] originals.at(0).law step.law)
  + compilation_reason
    \ result=either[iota flow/definition]
    ^ str
    ? result
     > (./err why) (str/from_atom (quip_val why))
    "ok"
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = before (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      request (flow_extraction_tests/request ['pages 'checked 'decomposed])
      target flow_extraction_tests/target
    ?> (./ok proposal) (flow_extract_ops/proposal (flow_tests/get flow_tests/run before) before.self)
      [(testing/text "retained preview provides extraction evidence" "proposal" "missing")]
    = changed (flow_tests/poke [($x 17) 'gov 'flows 'operations 'decompose]
        (myth/sing (flow_ops/key before.self 'operation) (flow/operation ['value] flow_operations/identity)) before)
      after (flow_extraction_tests/apply target request changed)
      source (flow_tests/get target after).txt_at(['src])
      published (flow_tests/apply 'publish target ((myth/sing ['id] (pails/t "extracted")).put(['expected] (pails/n after.case(.x target).fall(0)))) after)
    = compiled (flow_ops/compile 'extracted (safe after.case(.x target).fall(0) .x target) source after)
    ?> (./ok definition) compiled
      [(testing/text "extracted source compiles" "ok" (flow_extraction_tests/compilation_reason compiled))]
    = original (unpin proposal.definition)
      exact (definition.steps.all((flow_extraction_tests/exact_step original)))
      subset=path [($x 17) 'app 'nenex 'w 'extracted_subset]
      partial (flow_extraction_tests/apply subset (flow_extraction_tests/request ['decomposed]) changed)
      partial_source (flow_tests/get subset partial).txt_at(['src])
    = partial_compiled (flow_ops/compile 'extracted (safe partial.case(.x subset).fall(0) .x subset) partial_source partial)
    ?> (./ok selected) partial_compiled
      [(testing/text "selected step source compiles" "ok" (flow_extraction_tests/compilation_reason partial_compiled))]
    = historical (row/all[care] (\ car (equal[res[axal[saga]]] (namespace/page car before.case(car flow_tests/run) flow_tests/run before)
          (namespace/page car before.case(car flow_tests/run) flow_tests/run after))) [.x .y .z])
      values (proposal.captures.fold((axal/new[axal[myth]] .none)
        (\ values=axal[axal[myth]] capture=flow_runtime/capture values.put([capture.name] (unpin capture.snapshot.value)))))
      output (flow_ops/evaluate definition values)
      equal_output=bool
        ?> (./ok result) output .false
        | equal[pin[axal[myth]]] proposal.output.result result.result
      invalid=flow_maintenance/proposal (flow_maintenance/proposal proposal.definition proposal.captures (flow/evaluation proposal.output.result []))
      selected_reason=str
        ? (flow_extract_ops/selected invalid ['checked])
         > (./err why) (str/from_atom (quip_val why))
        "ok"
    [(testing/text "extraction plans through native author operation" "ok" (flow_tests/reason (flow_extract_ops/extract target request changed)))
     (testing/nat "requested step order cannot change captured dependency order" 1 (equal[row[iota]] ['checked 'decomposed 'pages] (definition.steps.map((\ step=flow/step step.name)))))
     (testing/nat "all captured implementations survive later publication" 1 exact)
     (testing/nat "source publication retains original native history origins" 1 (equal[row[safe]] (original.steps.map((\ step=flow/step step.origin))) (definition.steps.map((\ step=flow/step step.origin)))))
     (testing/nat "captured child calls retain invocation semantics" 1 (equal[either[iota nat]] (./ok "invoke")
       (flow_extract_ops/mode (flow/step 'called (safe before.case(.x flow_tests/definition).fall(0) .x flow_tests/definition) (pin (flow/operation original.inputs (flow_ops/invocation original))) []) before)))
     (testing/nat "extraction does not copy an operation registry" 0 (sovereign_peek target.weld(['cells 'extraction 'operations]) after).wyt)
     (testing/nat "unavailable captured implementation origins refuse" 1 (either/is_err (flow_extract_ops/mode (flow/step 'missing (safe 999999 .x ['missing]) original.steps.at(0).law []) before)))
     (testing/nat "a mismatched retained law cannot silently replace captured behavior" 1 (either/is_err (flow_extract_ops/mode (flow/step 'wrong original.steps.at(0).origin original.steps.at(1).law []) before)))
     (testing/nat "extracted procedure publishes through the existing operation" 1 (flow_tests/get target.weld(['flows 'extracted]) published).has((flow_ops/key published.self 'definition)))
     (testing/nat "document templates survive extraction" 1 (equal[pin[axal[myth]]] original.pages definition.pages))
     (testing/nat "all repeated document step bindings survive" 2 definition.steps.at(2).bindings.len)
     (testing/nat "extracted complete procedure produces retained result" 1 equal_output)
     (testing/nat "excluded dependency becomes an explicit external input" 1 (equal[row[iota]] ['checked] selected.inputs))
     (testing/nat "subset retains exactly selected step" 1 selected.steps.len)
     (testing/nat "subset omits an unused document recipe" 0 (unpin selected.pages).wyt)
     (testing/nat "subset Semidoc has no unrelated page declarations" 0 (cord/has "/flow/page" (str/to_atom partial_source)))
     (testing/nat "external dependency has an ordinary frozen example cell" 1 (flow_tests/get subset.weld(['cells 'inputs 'checked]) partial).has(['capture]))
     (testing/nat "retained attempt is available in provenance cell" 1 (flow_tests/get target.weld(['cells 'extraction]) after).has(['capture]))
     (testing/text "existing pages are never silently overwritten" "flow_extraction_page_exists" (flow_tests/reason (flow_extract_ops/extract target request after)))
     (testing/text "unknown selected steps refuse" "flow_extraction_unknown_or_duplicate_step" (flow_tests/reason (flow_extract_ops/extract target (flow_extraction_tests/request ['unknown]) changed)))
     (testing/text "duplicate selected steps refuse" "flow_extraction_unknown_or_duplicate_step" (flow_tests/reason (flow_extract_ops/extract target (flow_extraction_tests/request ['checked 'checked]) changed)))
     (testing/text "unexecuted steps are not invented" "flow_extraction_unexecuted_step" selected_reason)
     (testing/nat "automatic retained runs use the same extraction evidence" 1 (equal[either[iota flow_maintenance/proposal]] (./ok proposal)
       (flow_extract_ops/proposal (myth/sing ['flow 'automatic_run] (flow_maintenance/run (pin proposal) (pin flow_ops/empty) (safe 1 .x ['writer]))) before.self)))
     (testing/nat "untyped work records are not guessed into flow attempts" 1 (either/is_err (flow_extract_ops/proposal myth/new before.self)))
     (testing/nat "original attempt and x/y/z history are unchanged" 1 historical)]

+ tests
  ^ row[testing/case]
  [(testing/case "Retained native flow trace extraction" flow_extraction_tests/checks)]
