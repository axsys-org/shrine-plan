- flow_examples
- flow_test_world
- flow_maintenance_ops
- apps/nenex/main [at=wiki]

+ flow_ui_tests
  + act
    \ fields=row[[str str]] state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (flow_tests/plan fields) state (sovereign_hive state))
    | flow_tests/accepted reply next
  + base
    \ action=str
    ^ row[[str str]]
    = fields=row[[str str]] [["action" action] ["page" (path_show flow_tests/author)]]
    | fields.weld((? (row/has[str] action ["publish" "example"]) [["name" "handbook"]] []))
  + authoring
    \ ignored=unit
    ^ row[testing/check]
    = fields (flow_ui_tests/base "create").weld([["new_name" "onboarding"] ["kind" "document"] ["uses" "readme"] ["brief" "Explain the evidence in practical terms."]])
      created (flow_ui_tests/act fields flow_tests/initial)
      page=path [created.self 'app 'nenex 'w 'onboarding_flow]
      source (flow_tests/get page created).txt_at(['src])
      published_fields=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "onboarding"]]
      published (flow_ui_tests/act published_fields created)
      duplicate (flow_tests/plan fields created)
    [(testing/nat "new flow is an editable native Nenex document" 1 (gt source.len 0))
     (testing/nat "starter is compiled by the published operation" 1 (flow_tests/get page.weld(['flows 'onboarding]) published).has((flow_ops/key created.self 'definition)))
     (testing/text "creation cannot overwrite an existing authored flow" "flow_stale_source" (flow_tests/reason duplicate))]
  + generic_install
    \ ignored=unit
    ^ row[testing/check]
    = state flow_tests/initial
      fields (flow_ui_tests/base "create").weld([["new_name" "transform"] ["kind" "composition"]])
      created (flow_ui_tests/act fields state)
      page=path [created.self 'app 'nenex 'w 'transform_flow]
      source (flow_tests/get page created).txt_at(['src])
      request (myth/sing ['id] (pails/t "transform")).put(['expected] (pails/n created.case(.x page).fall(0)))
      published (flow_tests/apply 'publish page request created)
      definition (flow_tests/get page.weld(['flows 'transform]) published)
      sample (flow_tests/plan (flow_ui_tests/base "example") state)
    [(testing/nat "installing the harness creates no handbook page" 0 (flow_tests/get [state.self 'app 'nenex 'w 'handbook_flow] state).has(['src]))
     (testing/nat "installing the harness creates no handbook capture feed" 0 (flow_tests/get [state.self 'user 'flow_sources 'handbook_live] state).has(['source]))
     (testing/nat "composition starter does not require source inventory" 1 (gt source.len 0))
     (testing/nat "composition starter publishes through native operations" 1 definition.has((flow_ops/key state.self 'definition)))
     (testing/nat "handbook example refuses absent evidence instead of inventing it" 1 (either/is_err sample))]
  + example_install
    \ ignored=unit
    ^ row[testing/check]
    = spec (json/obj [(jkv "title" (json/str "Open declared example"))
        (jkv "source" (json/str "sample.semidoc")) (jkv "capture" (json/str "/io/fs/sample_sources"))
        (jkv "port" (json/str "sources"))
        (jkv "folder" (json/str "mounts/flows")) (jkv "sources" (json/obj [(jkv "readme" (json/obj [(jkv "file" (json/str "readme.md")) (jkv "format" (json/str "md"))])) (jkv "extra" (json/obj [(jkv "file" (json/str "extra.txt")) (jkv "format" (json/str "txt"))]))]))])
      catalog (show (json/obj [(jkv "sample" spec)]))
      bytes (add (str/to_atom catalog) (bex (mul 8 catalog.len)))
      source (flow_tests/book_source "Declared example")
      source_bytes (add (str/to_atom source) (bex (mul 8 source.len)))
      base=path [($x 17) 'io 'fs (source_mount/mount_key "flow-examples") 'source]
      filesystem (flow_tests/poke [($x 17) 'kook 'fs] (myth/sing bond/form fs/form) flow_tests/initial)
      seeded (flow_tests/poke base.snoc(($ta "examples.json")) (myth/sing bond/content (pails/n bytes)) filesystem)
      seeded (flow_tests/poke base.snoc(($ta "sample.semidoc")) (myth/sing bond/content (pails/n source_bytes)) seeded)
      installed=namespace
        ?> (./ok next) (flow_examples/install seeded) seeded
        next
      fields=row[[str str]] [["action" "example"] ["page" (path_show flow_tests/author)] ["name" "sample"]]
      created (flow_ui_tests/act fields installed)
      page=path [created.self 'app 'nenex 'w 'sample_flow]
      repeated (flow_ui_tests/act fields created)
      edited (flow_tests/poke page (myth/sing ['src] (pails/t "An authored edit")) created)
      reopened (flow_ui_tests/act fields edited)
      capture=path [created.self 'io 'fs 'sample_sources]
      content (add (str/to_atom "Evidence") (bex 64))
      loaded (flow_tests/poke capture.weld(['source ($ta "readme.md")]) (myth/sing bond/content (pails/n content)) created)
      loaded (flow_tests/poke capture.weld(['source ($ta "extra.txt")]) (myth/sing bond/content (pails/n content)) loaded)
      config=myth (flow_tests/get capture loaded).del(limb_slot).put(bond/pending (pails/b .false))
      epoch config.nat_at(bond/epoch 0)
      report (fs/report epoch capture.snoc('source) ["readme.md" "extra.txt"] [])
      [loaded index reply] (helm/supervisor/step capture (writ/make config.put(bond/res report)) 0 0 loaded (sovereign_hive loaded))
      inventory=path (row/cons[iota] 'x page.weld(['cells 'sources]))
      observed (sovereign_care .z inventory loaded)
      missing (flow_tests/poke capture (myth/sing bond/res (fs/report epoch capture.snoc('source) ["readme.md" "extra.txt"] ["readme.md"])) loaded)
      restored (flow_tests/poke capture (myth/sing bond/res report) missing)
    [(testing/nat "declared examples install operations without creating pages" 0 (flow_tests/get page installed).has(['src]))
     (testing/text "example action passes native admission" "ok" (flow_tests/reason (flow_tests/plan fields installed)))
     (testing/text "explicit example creates the authored source" source (flow_tests/get page created).txt_at(['src]))
     (testing/nat "explicit example creates its declared source hand" 1 (flow_tests/get page.weld(['inputs 'sources 'readme]) created).has(['source]))
     (testing/nat "ordinary merge cell composes two native file sources" 1 (and (observed.has(['readme])) (observed.has(['extra]))))
     (testing/nat "deleted file leaves the current collection" 0 (sovereign_care .z inventory missing).has(['readme]))
     (testing/nat "other source remains independently available" 1 (sovereign_care .z inventory missing).has(['extra]))
     (testing/nat "restored file recovers the same native evidence" 1 (equal observed (sovereign_care .z inventory restored)))
     (testing/nat "opening an existing example is idempotent" created.local.top repeated.local.top)
     (testing/text "opening preserves authored source edits" (flow_tests/get page edited).txt_at(['src]) (flow_tests/get page reopened).txt_at(['src]))]
  + same_cases
    \ before=namespace after=namespace name=path
    ^ bool
    | row/all[care] (\ car=care (equal[maybe[nat]] before.case(car name) after.case(car name))) [.x .y .z]
  + retained_history
    \ before=namespace after=namespace name=path
    ^ bool
    | row/all[care] (\ car=care (equal (namespace/page car before.case(car name) name before) (namespace/page car before.case(car name) name after))) [.x .y .z]
  + refresh
    \ ignored=unit
    ^ row[testing/check]
    = state=namespace flow_tests/automatic
      hand=path [state.self 'gov 'cooperate 'answer_hand]
      old (flow_tests/get flow_tests/author state)
      stale (flow_tests/poke hand (myth/sing system_vocabulary/form def_form) state)
      document_hand=path [state.self 'app 'nenex 'kook 'doc]
      stale (flow_tests/poke document_hand (myth/sing system_vocabulary/form def_form) stale)
      operation=path [state.self 'gov 'flows 'operations 'identity]
      stale (flow_tests/poke operation (myth/sing (flow_ops/key state.self 'operation)
        (flow/operation ['value] (\ ignored=axal[myth] (./ok flow_ops/empty)))) stale)
      fields=row[[str str]] [["action" "refresh"] ["page" (path_show flow_tests/author)]]
      incompatible (flow_tests/poke (flow_ops/key state.self 'claims) (myth/sing ['flow 'claims] (pails/n 1)) stale)
      refused (flow_tests/plan fields incompatible)
      view=path (flow_tests/controller).snoc('view)
      view_card (flow_tests/get view stale)
      bad_progress (flow_tests/poke view (myth/sing ['flow 'progress] (pails/n 1)) stale)
      rejected_progress (flow_tests/plan fields bad_progress)
      unrelated (flow_tests/poke [state.self 'user 'foreign] ((myth/sing ['answer 'config] (pails/n 1)).put(['flow 'progress] (pails/n 1))) stale)
      accepted_unrelated (flow_tests/plan fields unrelated)
      refreshed_unrelated (flow_ui_tests/act fields unrelated)
      refreshed (flow_ui_tests/act fields stale)
      repeated (flow_ui_tests/act fields refreshed)
    [(testing/nat "refresh ignores contracts owned by unrelated records" 1 (either/is_ok accepted_unrelated))
     (testing/nat "refresh preserves unrelated records and x/y/z cases" 1 (flow_ui_tests/same_cases unrelated refreshed_unrelated [state.self 'user 'foreign]))
     (testing/nat "a spun view has config without controller progress" 1 (and view_card.has(['flow 'config]) !(view_card.has(['flow 'progress]))))
     (testing/nat "config-only cell views retain compatible native types" 1 (flow_install/compatible_runtime [view view_card]))
     (testing/text "present progress slots still require the exact native type" "flow_runtime_requires_type_migration" (flow_tests/reason rejected_progress))
     (testing/text "refresh refuses incompatible persisted runtime types before rebinding" "flow_runtime_requires_type_migration" (flow_tests/reason refused))
     (testing/nat "flow refresh preserves the dependency owner selected hand" 1 (equal[myth] (flow_tests/get hand stale) (flow_tests/get hand refreshed)))
     (testing/nat "flow refresh preserves the Nenex owner selected behavior" 1
       (equal[myth] (flow_tests/get document_hand stale) (flow_tests/get document_hand refreshed)))
     (testing/nat "flow refresh restores only its own selected implementation" 1
       (equal[myth] (flow_tests/get operation state) (flow_tests/get operation refreshed)))
     (testing/nat "dependency behavior cases do not advance during flow refresh" 1
       (row/all[path] (flow_ui_tests/same_cases stale refreshed) [hand document_hand]))
     (testing/nat "flow refresh retains prior dependency history" 1
       (row/all[path] (flow_ui_tests/retained_history state refreshed) [hand document_hand]))
     (testing/nat "refresh preserves authored source and published flow" 1 (equal[myth] old (flow_tests/get flow_tests/author refreshed)))
     (testing/nat "repeated code refresh adds no work" refreshed.local.top repeated.local.top)
     (testing/text "refresh cannot target application data" "flow_invalid_refresh_target" (flow_tests/reason (flow_ui/refresh flow_tests/author myth/new state)))]
  + maintenance
    \ ignored=unit
    ^ row[testing/check]
    = initial flow_tests/prepared
      selected (myth/sing ['name] (pails/p ['handbook])).put(['definition] (safe 0 .x flow_tests/definition))
      state (flow_tests/apply 'select flow_tests/author selected initial)
      cell=path (flow_tests/author).weld(['cells 'handbook])
      fields=row[[str str]]
        [["action" "attach"] ["page" (path_show cell)]
         ["destination" (path_show flow_tests/destination)] ["input/sources" (path_show [state.self 'user 'flow_sources])]
         ["provider" ""] ["writer" ""]]
      attached (flow_ui_tests/act fields state)
      controller=path (flow_tests/author).weld(['work 'handbook])
      repeated (flow_ui_tests/act fields attached)
      original=myth
        ?> config=flow_maintenance/config (flow_tests/get controller attached).pail_at(['flow 'config]) myth/new
        | unpin config.request
      equivalent=myth original.del(['unused])
      native_repeat (flow_maintenance_ops/follow controller equivalent attached)
      changed_repeat (flow_maintenance_ops/follow controller equivalent.put(['destination] (pails/p (flow_tests/destination).snoc('different))) attached)
      pause (row/snoc[[str str]] ["controller" (path_show controller)] (flow_ui_tests/base "pause"))
      paused (flow_ui_tests/act pause attached)
      resumed (flow_ui_tests/act (row/snoc[[str str]] ["controller" (path_show controller)] (flow_ui_tests/base "resume")) paused)
      detached (flow_tests/apply 'detach controller myth/new resumed)
      bad (flow_tests/plan (row/snoc[[str str]] ["controller" "/0x11/user/other"] (flow_ui_tests/base "pause")) resumed)
      obsolete (flow_tests/plan fields.weld([["published" "Invented definition"]]) resumed)
      surface (sovereign_care .z (row/cons[iota] 'x controller.weld(['cells 'work])) resumed)
    [(testing/nat "selected-cell attachment publishes through the shared hand" 1 (gt (flow_tests/get flow_tests/destination attached).txt_at(['src]).len 0))
     (testing/nat "same selected-cell attachment leaves world unchanged" 1 (equal[namespace] attached repeated))
     (testing/text "native follow accepts identical bindings with a different map shape" "ok" (flow_tests/reason native_repeat))
     (testing/nat "equivalent binding fixture has a distinct native map shape" 0
       (equal[myth] equivalent original))
     (testing/text "native follow still refuses a changed destination" "flow_controller_conflict" (flow_tests/reason changed_repeat))
     (testing/nat "selection supplies bindings from captured ports" 1 (cord/has "sources" (str/to_atom (flow_tests/get cell state).txt_at(['flow 'bindings]))))
     (testing/text "another occurrence path is not controlled by this page" "flow_invalid_controller" (flow_tests/reason bad))
     (testing/nat "attachment creates the same spun working view" 1 (flow_tests/get (row/snoc[iota] 'view controller) attached).has(bond/weft))
     (testing/text "attachment refuses caller-supplied definition text" "flow_invalid_arguments" (flow_tests/reason obsolete))
     (testing/text "replay cannot revive a detached controller" "flow_controller_detached" (flow_tests/reason (flow_tests/plan fields detached)))
     (testing/nat "pause and resume preserve controller identity" 1 (flow_tests/get controller resumed).has(['flow 'config]))
     (testing/nat "shared cells expose the actual native generation" 2 surface.fil.fall(myth/new).nat_at(['generation] 0))]
  + holes
    \ ignored=unit
    ^ row[testing/check]
    = base flow_revision_tests/prepared
      destination=path [base.self 'app 'nenex 'w 'flow_demand_ui]
      controller=path (flow_tests/author).weld(['work 'maintenance_handbook])
      state (flow_tests/apply 'follow controller (flow_tests/follow_request).put(['destination] (pails/p destination)) base)
      paused (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) state)
      resumed (flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .true)) paused)
    [(testing/text "a pending document flow uses the shared blocked phase" "blocked" (flow_tests/get controller state).txt_at(['work 'status]))
     (testing/text "resuming a persistent demand clears the paused phase" "blocked" (flow_tests/get controller resumed).txt_at(['work 'status]))]
  + retry
    \ ignored=unit
    ^ row[testing/check]
    = base=namespace flow_revision_tests/prepared
      ui_controller=path (flow_tests/author).weld(['work 'maintenance_handbook])
      ui_followed (flow_tests/apply 'follow ui_controller (flow_tests/follow_request).put(['destination] (pails/p [base.self 'app 'nenex 'w 'retry_ui])) base)
      ui_request=path ui_controller.weld(['work 'revision_1])
      ui_failed (flow_tests/poke ui_request (native_work_ops/settle "waiting" "failed" (flow_tests/get ui_request ui_followed)).put(['flow 'refused] (pails/q 'flow_worker_failed)) ui_followed)
      ui_fields=row[[str str]] [["action" "retry"] ["page" (path_show flow_tests/author)] ["request" (path_show ui_request)]]
      ui_done (flow_ui_tests/act ui_fields ui_failed)
      foreign (flow_tests/plan [["action" "retry"] ["page" "/0x11/app/nenex/w/other"] ["request" (path_show ui_request)]] ui_failed)
    [(testing/text "Nenex retry uses the published native operation" "ok" (flow_tests/reason (flow_tests/plan ui_fields ui_failed)))
     (testing/nat "Nenex retry stages a linked fresh attempt" 1 (flow_tests/get ui_controller.weld(['work 'revision_3]) ui_done).has(['work 'retry_of]))
     (testing/text "Nenex refuses another page's retry target" "flow_invalid_revision_target" (flow_tests/reason foreign))]
  + page_sources
    \ ignored=unit
    ^ row[testing/check]
    = page=path [($x 17) 'app 'nenex 'w 'brief_flow]
      evidence=path [($x 17) 'app 'nenex 'w 'brief_evidence]
      cell=path page.weld(['cells 'document_source])
      fields=row[[str str]] [["action" "bind_source"] ["page" (path_show page)] ["source_page" (path_show evidence)] ["source_name" "document"]]
      seeded (flow_tests/poke page (myth/sing ['src] (pails/t ";.\n  ;= Procedure")) flow_tests/initial)
      seeded (flow_tests/poke evidence (myth/sing ['src] (pails/t ";.\n  ;= Pending decision")) seeded)
      bound (flow_ui_tests/act fields seeded)
      collided (flow_tests/poke cell (myth/sing ['src] (pails/t "Keep this")) seeded)
    [(testing/nat "binding retains the native input reference" 1 (equal[pail] (safe 0 .z (row/cons[iota] 'x cell)) (flow_tests/get page.weld(['flows 'defaults]) bound).pail_at(['input 'sources])))
     (testing/text "binding refuses an occupied source cell" "flow_source_collision" (flow_tests/reason (flow_tests/plan fields collided)))]
  + web_sources
    \ ignored=unit
    ^ row[testing/check]
    = page=path flow_tests/author
      fields=row[[str str]] [["action" "bind_url"] ["page" (path_show page)] ["source_url" "http://127.0.0.1/source.md"] ["source_name" "manual"]]
      bound (flow_ui_tests/act fields flow_tests/prepared)
      repeated (flow_ui_tests/act fields bound)
      target=path page.weld(['inputs 'urls 'manual])
      changed=row[[str str]] [["action" "bind_url"] ["page" (path_show page)] ["source_url" "http://127.0.0.1/other.md"] ["source_name" "manual"]]
      invalid=row[[str str]] [["action" "bind_url"] ["page" (path_show page)] ["source_url" "file:///etc/passwd"] ["source_name" "manual"]]
    [(testing/text "web binding uses ordinary namespace inputs" "http://127.0.0.1/source.md" (flow_tests/get target bound).txt_at(['url]))
     (testing/nat "web binding retains the native input reference" 1 (equal[pail] (safe 0 .z page.weld(['inputs 'urls])) (flow_tests/get page.weld(['flows 'defaults]) bound).pail_at(['input 'urls])))
     (testing/nat "same web binding is idempotent" bound.local.top repeated.local.top)
     (testing/text "binding refuses an occupied URL input" "flow_source_collision" (flow_tests/reason (flow_tests/plan changed bound)))
     (testing/text "web binding refuses unsupported transport" "flow_invalid_url" (flow_tests/reason (flow_tests/plan invalid bound)))]
  + accept_draft
    \ ignored=unit
    ^ row[testing/check]
    = base flow_revision_tests/prepared
      controller=path [($x 17) 'app 'nenex 'w 'flow_spec 'work 'maintenance_review]
      destination=path [($x 17) 'app 'nenex 'w 'reviewed_concepts]
      state (flow_tests/apply 'follow controller (flow_tests/follow_request).put(['destination] (pails/p destination)) base)
      request=path (row/weld[iota] ['work 'revision_1] controller)
      draft=path (row/snoc[iota] 'draft request)
      source (flow_tests/get draft state).txt_at(['src])
      fields=row[[str str]] [["action" "submit"] ["page" (path_show draft)] ["request" (path_show request)] ["source" source] ["note" "Reviewed the captured readme."]]
      accepted (flow_ui_tests/act fields state)
      stale=row[[str str]] [["action" "submit"] ["page" (path_show draft)] ["request" (path_show request)] ["source" "obsolete"] ["note" "Reviewed"]]
    [(testing/text "saved draft accepts through shared native admission" "ok" (flow_tests/reason (flow_tests/plan fields state)))
     (testing/nat "acceptance retains the native response" 1 (flow_tests/get request accepted).has(['flow 'response]))
     (testing/text "obsolete draft forms cannot accept a later edit" "flow_draft_edited" (flow_tests/reason (flow_tests/plan stale state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native web input binding" flow_ui_tests/web_sources)
   (testing/case "Explicit retries retain failed native work" flow_ui_tests/retry)
   (testing/case "Nenex pages as live native flow evidence" flow_ui_tests/page_sources)
   (testing/case "generic harness installation and composition" flow_ui_tests/generic_install)
   (testing/case "Native harness code refresh" flow_ui_tests/refresh)
   (testing/case "Declared example installation" flow_ui_tests/example_install)
   (testing/case "Nenex flow authoring" flow_ui_tests/authoring)
   (testing/case "Nenex native flow controls" flow_ui_tests/maintenance)
   (testing/case "Nenex resumes retained pending work" flow_ui_tests/holes)
   (testing/case "Accept a saved concept draft" flow_ui_tests/accept_draft)]
