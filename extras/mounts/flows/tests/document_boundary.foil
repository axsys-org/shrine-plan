- flow_test_world
- apps/nenex/main [at=wiki]

+ flow_document_boundary_tests
  + history
    \ target=path before=namespace after=namespace car=care
    ^ bool
    % version=nat before.case(car target).fall(0)
    ^ bool
    ? !(version) .true
    ? !(equal (namespace/page car (./some version) target before) (namespace/page car (./some version) target after)) .false
    | _ version.dec
  + author_guard
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 17) 'app 'nenex 'w 'guarded_author]
      block=path target.weld([($u 0) ($u 0)])
      note=path block.weld(['work 'note])
      source (str/from_atom (joined 10 [";." "  ;= Research" "    First" "" "    Second"]))
      edited (str/from_atom (joined 10 [";." "  ;= Research" "    Updated first" "" "    Second"]))
      removed (str/from_atom (joined 10 [";." "  ;= Research" "    Second"]))
      initial (flow_tests/apply 'author target (myth/sing ['source] (pails/t source)) flow_tests/initial)
      attached (flow_tests/poke note (myth/sing ['sentinel] (pails/t "keep")) initial)
      attached (flow_tests/poke target.weld(['cells 'result]) (myth/sing ['sentinel] (pails/t "page work")) attached)
      request (myth/sing ['source] (pails/t removed)).put(['expected] (pails/n attached.case(.x target).fall(0)))
      rejected (flow_nenex_ops/author target request attached)
      [refused index reply] (helm/supervisor/admit (flow_nenex_ops/author target request) attached (sovereign_hive attached))
      editor (nenex_edit/source target (myth/sing ['src] (pails/t removed)).put(['epoch] (pails/t (nat/show attached.local.top))) attached)
      allowed (flow_nenex_ops/author target request.put(['source] (pails/t edited)) attached)
      [saved index reply] (helm/supervisor/admit (flow_nenex_ops/author target request.put(['source] (pails/t edited))) attached (sovereign_hive attached))
      paths=row[path] [target block note target.weld(['cells 'result])]
      historical (paths.all((\ path=path (row/all[care] (flow_document_boundary_tests/history path attached saved) [.x .y .z]))))
    | [(testing/text "author fixture has the first positional prose block" "First" (flow_tests/get block initial).txt_at(['text]))
       (testing/text "author fixture has a separate second prose block" "Second" (flow_tests/get target.weld([($u 0) ($u 1)]) initial).txt_at(['text]))
       (testing/text "native author refuses structural edits around block work" "nenex_named_descendants_prevent_reordering" (flow_tests/reason rejected))
       (testing/text "native author and source editor use the same attachment guard" (flow_tests/reason editor) (flow_tests/reason rejected))
       (testing/nat "refused author edit leaves the complete namespace unchanged" 1 (equal[namespace] attached refused))
       (testing/text "native author allows safe text edits beside block work" "ok" (flow_tests/reason allowed))
       (testing/text "safe author edit applies the requested text" edited (flow_tests/get target saved).txt_at(['src]))
       (testing/text "safe author edit retains the block's named work" "keep" (flow_tests/get note saved).txt_at(['sentinel]))
       (testing/text "safe author edit retains page-level cells" "page work" (flow_tests/get target.weld(['cells 'result]) saved).txt_at(['sentinel]))
       (testing/nat "author retains every prior x/y/z case at guarded records" 1 historical)]
  + pages
    \ first=nat remaining=bool
    ^ axal[myth]
    = body=row[snode] [(snode/prose first [])]
      body (? remaining body.snoc((snode/prose "Second" [])) body)
    | (flow_ops/empty).put([] (myth/sing ['flow 'page] (flow/page "Research" body [])))
  + writer_guard
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 17) 'app 'nenex 'w 'guarded_writer]
      block=path target.weld([($u 0) ($u 0)])
      note=path block.weld(['work 'note])
      original (flow_document_boundary_tests/pages "First" .true)
      revised (flow_document_boundary_tests/pages "Updated first" .true)
      removed (flow_document_boundary_tests/pages "Second" .false)
      [initial index reply] (helm/supervisor/admit (flow_nenex_ops/plan target original) flow_tests/initial (sovereign_hive flow_tests/initial))
      attached (flow_tests/poke note (myth/sing ['sentinel] (pails/t "keep")) initial)
      attached (flow_tests/poke target.weld(['work 'independent]) (myth/sing ['sentinel] (pails/t "page work")) attached)
      rejected (flow_nenex_ops/plan target removed attached)
      [refused index reply] (helm/supervisor/admit (flow_nenex_ops/plan target removed) attached (sovereign_hive attached))
      allowed (flow_nenex_ops/plan target revised attached)
      [saved index reply] (helm/supervisor/admit (flow_nenex_ops/plan target revised) attached (sovereign_hive attached))
      [again index reply] (helm/supervisor/admit (flow_nenex_ops/plan target revised) saved (sovereign_hive saved))
      root_only (flow_tests/poke target.weld(['work 'independent]) (myth/sing ['sentinel] (pails/t "page work")) initial)
      [restructured index reply] (helm/supervisor/admit (flow_nenex_ops/plan target removed) root_only (sovereign_hive root_only))
      paths=row[path] [target block note target.weld(['flows 'ownership]) target.weld(['work 'independent])]
      historical (paths.all((\ path=path (row/all[care] (flow_document_boundary_tests/history path attached saved) [.x .y .z]))))
    | [(testing/text "writer refuses structural edits around block work" "nenex_named_descendants_prevent_reordering" (flow_tests/reason rejected))
       (testing/nat "refused writer edit leaves the complete namespace unchanged" 1 (equal[namespace] attached refused))
       (testing/text "writer allows safe text edits beside block work" "ok" (flow_tests/reason allowed))
       (testing/nat "safe writer edit publishes revised source" 1 (cord/has "Updated first" (str/to_atom (flow_tests/get target saved).txt_at(['src]))))
       (testing/text "safe writer edit retains the block's named work" "keep" (flow_tests/get note saved).txt_at(['sentinel]))
       (testing/text "safe writer edit retains independent page work" "page work" (flow_tests/get target.weld(['work 'independent]) saved).txt_at(['sentinel]))
       (testing/nat "writer accepts its guarded updated ownership on repeat" saved.local.top again.local.top)
       (testing/nat "page-level work does not prevent source restructuring" 1 !(eq (flow_tests/get target initial).txt_at(['src]) (flow_tests/get target restructured).txt_at(['src])))
       (testing/text "structural edit retains independent page work" "page work" (flow_tests/get target.weld(['work 'independent]) restructured).txt_at(['sentinel]))
       (testing/nat "writer retains every prior x/y/z case at guarded records" 1 historical)]
  + writer_conflict
    ' A retained lossy projection can keep authored source while newer native
    ' block edits conflict with it. Generated ownership must not choose a side.
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 17) 'app 'nenex 'w 'conflicted_writer]
      left=path target.weld([($u 0) ($u 0)])
      right=path target.weld([($u 0) ($u 1)])
      attrs=row[sattr] [(sattr ["rel" "supports"] [(sval/ref ["0x11" "user" "evidence"])])]
      body=row[snode] [(snode/prose "First" attrs) (snode/prose "Second" [])]
      original (flow_ops/empty).put([] (myth/sing ['flow 'page] (flow/page "Research" body [])))
      revised (flow_ops/empty).put([] (myth/sing ['flow 'page] (flow/page "Research" [(snode/prose "Updated first" attrs) (snode/prose "Second" [])] [])))
      [initial index reply] (helm/supervisor/admit (flow_nenex_ops/plan target original) flow_tests/initial (sovereign_hive flow_tests/initial))
      source (flow_tests/get target initial).txt_at(['src])
      old (flow_tests/get left initial).del(['rel 'supports])
      other (flow_tests/get right initial)
      baseline (wiki/page_nodes (sovereign_peek target initial).put(left.drop(target.len) old))
    ?> (./ok retained) (grove_install/changes [[left (writ/make old)]
        [target (writ/poke (myth/sing wiki/image_slot (wiki/document_image (str/to_atom source) (pin baseline))))]] initial)
      [(testing/nat "writer conflict fixture retains the old projection" 1 0)]
    ?> (./ok conflict) (grove_install/changes [[left (writ/make other)] [right (writ/make old)]] retained)
      [(testing/nat "writer conflict fixture retains the native block move" 1 0)]
    = planned (flow_nenex_ops/plan target revised conflict)
      [refused index reply] (helm/supervisor/admit (flow_nenex_ops/plan target revised) conflict (sovereign_hive conflict))
      edit (myth/sing ['src] (pails/t source)).put(['epoch] (pails/t (nat/show conflict.local.top)))
      [resolved index reply] (helm/supervisor/admit (nenex_edit/source target edit) conflict (sovereign_hive conflict))
      [updated index reply] (helm/supervisor/admit (flow_nenex_ops/plan target revised) resolved (sovereign_hive resolved))
      historical (row/all[care] (flow_document_boundary_tests/history target conflict updated) [.x .y .z])
    | [(testing/text "conflicted native records retain the last generated source" source (flow_tests/get target conflict).txt_at(['src]))
       (testing/nat "fixture has a real unresolved Semidoc reconciliation" 1 (either/is_err (wiki/authored_nodes (sovereign_peek target conflict))))
       (testing/text "native block move remains available for explicit resolution" "Second" (flow_tests/get left conflict).txt_at(['text]))
       (testing/text "writer refuses to overwrite unresolved native document changes" "semidoc_reconcile_conflict" (flow_tests/reason planned))
       (testing/nat "refusal preserves both sides of the document conflict" 1 (equal[namespace] conflict refused))
       (testing/text "fresh source editing explicitly resolves the conflict" "" (flow_tests/get target resolved).txt_at(['err]))
       (testing/nat "writer can continue after explicit source resolution" 1 (cord/has "Updated first" (str/to_atom (flow_tests/get target updated).txt_at(['src]))))
       (testing/nat "conflict resolution and later publication retain x/y/z history" 1 historical)]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 17) 'user 'draft]
      body=row[snode] [(snode/prose "Authored explanation." [])]
      plain (flow_work_ops/document myth/new target "Draft" body)
      form (kook [[($x 17) 'user 'custom_document]])
      explicit (flow_work_ops/document (myth/sing ['flow 'document] form) target "Draft" body)
      malformed (flow_work_ops/document (myth/sing ['flow 'document] (pails/t "not a native form")) target "Draft" body)
      first=namespace flow_revision_tests/prepared
      request=path (flow_revision_tests/request 1)
      expected (kook [[($x 17) 'app 'nenex 'kook 'doc]])
      writer=path [($x 17) 'gov 'flows 'nenex]
      changed (flow_tests/poke writer (myth/sing ['flow 'document] form) first)
      done (flow_tests/apply 'submit_revision request (flow_revision_tests/response request changed) changed)
    | [(testing/nat "Semidoc draft has no implicit application behavior" 0 plain.has(limb_slot))
       (testing/nat "explicit native document form is reused exactly" 1 (equal[pail] explicit.pail_at(limb_slot) form))
       (testing/text "form choice preserves authored Semidoc" plain.txt_at(['src]) explicit.txt_at(['src]))
       (testing/nat "invalid form metadata cannot become executable behavior" 0 malformed.has(limb_slot))
       (testing/nat "controller captures selected writer document form" 1 (equal[pail] (flow_tests/get flow_tests/controller first).pail_at(['flow 'document]) expected))
       (testing/nat "retained revision captures the same form" 1 (equal[pail] (flow_tests/get request first).pail_at(['flow 'document]) expected))
       (testing/nat "draft uses the captured form" 1 (equal[pail] (flow_tests/get request.snoc('draft) first).pail_at(limb_slot) expected))
       (testing/nat "completion retains captured form after writer record changes" 1 (equal[pail] (flow_tests/get request.snoc('overview) done).pail_at(limb_slot) expected))
       (testing/text "captured request can still complete" "complete" (flow_tests/get request done).txt_at(['work 'status]))
       (testing/nat "writer changes retain prior request history" 1 (equal (first.page(.x first.case(.x request) request)) (done.page(.x first.case(.x request) request))))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native author shares document attachment protection" flow_document_boundary_tests/author_guard)
   (testing/case "Writer shares document attachment protection" flow_document_boundary_tests/writer_guard)
   (testing/case "Writer respects unresolved native document changes" flow_document_boundary_tests/writer_conflict)
   (testing/case "Selected document adapter stays captured with revision work" flow_document_boundary_tests/checks)]
