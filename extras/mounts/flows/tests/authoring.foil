- flow_author_ops
- flow_composition_editing_tests

+ flow_authoring_tests
  + page
    ^ path
    [($x 17) 'app 'nenex 'w 'authored_composition]
  + fields
    \ selected=safe state=namespace
    ^ myth
    = page flow_authoring_tests/page
    | (myth/sing ['source] (pails/t (flow_tests/get page state).txt_at(['src]))).put(['expected] (pails/n state.case(.x page).fall(0))).put(['flow] (pails/p ['compose])).put(['step] (pails/p ['called])).put(['mode] (pails/t "invoke")).put(['selected] selected).put(['inputs] (pails/p ['alpha 'beta])).put(['result] (pails/p ['called])).put(['binding 'left] (pails/p ['alpha])).put(['binding 'right] (pails/p ['beta]))
  + apply
    \ input=myth state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (flow_author_ops/compose flow_authoring_tests/page input) state (sovereign_hive state))
    next
  + compile
    \ state=namespace
    ^ either[iota flow/definition]
    = page flow_authoring_tests/page
    | flow_ops/compile 'compose (safe state.case(.x page).fall(0) .x page)
        (flow_tests/get page state).txt_at(['src]) state
  + historical
    \ page=path before=namespace after=namespace car=care
    ^ bool
    | equal[res[axal[saga]]] (namespace/page car before.case(car page) page before) (namespace/page car before.case(car page) page after)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = page=path flow_authoring_tests/page
      child=path flow_composition_editing_tests/child
      initial=namespace (flow_tests/apply 'author child
        (myth/sing ['source] (pails/t flow_composition_editing_tests/child_source)) flow_tests/initial)
      initial=namespace (flow_composition_editing_tests/publish child "copy" initial)
      child_definition=path child.weld(['flows 'copy])
      selected=safe (safe initial.case(.x child_definition).fall(0) .x child_definition)
      source=str (str/from_atom (joined 10 [";. /authored_composition" "  ;@ /note/related ;/0x11/user/evidence" "  ;= An authored note" "    Keep this explanation beside the procedure."]))
      initial=namespace (flow_tests/apply 'author page (myth/sing ['source] (pails/t source)) initial)
      note=path page.weld(['cells 'annotation])
      initial=namespace (flow_tests/poke note (myth/sing ['note] (pails/t "Preserve native annotation")) initial)
      choose=myth (myth/sing ['name] (pails/p ['selected_child])).put(['mode] (pails/t "invoke")).put(['selected] selected)
      [chosen chosen_index chosen_reply] (helm/supervisor/admit (flow_author_ops/select page choose) initial (sovereign_hive initial))
      fields=myth (flow_authoring_tests/fields selected initial)
      plan=either[iota row[[p=path q=writ]]] (flow_author_ops/compose page fields initial)
    ? (either/is_err plan)
      [(testing/text "native composition authoring admits" "ok" (flow_tests/reason plan))]
    = composed=namespace (flow_authoring_tests/apply fields initial)
      published=namespace (flow_composition_editing_tests/publish page "compose" composed)
    ?> (./ok original) (flow_authoring_tests/compile published)
      [(testing/nat "authored composition compiles" 1 0)]
    = input=myth (flow_authoring_tests/fields selected published).put(['binding 'left] (pails/p ['beta])).put(['binding 'right] (pails/p ['alpha]))
      updated=namespace (flow_authoring_tests/apply input published)
    ?> (./ok rebound) (flow_authoring_tests/compile updated)
      [(testing/nat "updated composition compiles" 1 0)]
    = child_edit=myth (myth/sing ['src] (pails/t (str/cat_all [flow_composition_editing_tests/child_source "\n  A new explanation.\n"]))).put(['epoch] (pails/t (nat/show updated.local.top)))
      [child_changed index reply] (helm/supervisor/admit (nenex_edit/source child child_edit) updated (sovereign_hive updated))
      child_changed=namespace (flow_composition_editing_tests/publish child "copy" child_changed)
    ?> (./ok retained) (flow_authoring_tests/compile child_changed)
      [(testing/nat "composition survives child publication" 1 0)]
    = step=path page.weld([($u 1) ($u 2)])
      goo=namespace (flow_tests/edit "save" step "Call the retained published child" child_changed)
    ?> (./ok goo_definition) (flow_authoring_tests/compile goo)
      [(testing/nat "composition survives Goo editing" 1 0)]
    = chain=myth (flow_authoring_tests/fields selected goo).put(['mode] (pails/t "step")).put(['step] (pails/p ['finished])).put(['result] (pails/p ['finished])).put(['selected] (safe 0 .x ((flow_ops/key goo.self 'operations).snoc('identity)))).del(['binding 'left]).del(['binding 'right]).put(['binding 'value] (pails/p ['called]))
      chained=namespace (flow_authoring_tests/apply chain goo)
    ?> (./ok completed) (flow_authoring_tests/compile chained)
      [(testing/nat "chained operation compiles" 1 0)]
    | [(testing/nat "selection creates ordinary retained capture" 1 (flow_tests/get page.weld(['cells 'selected_child]) chosen).has(['capture]))
       (testing/text "selection declares the callable kind" "invoke" (flow_tests/get page.weld(['cells 'selected_child]) chosen).txt_at(['flow 'author_mode]))
       (testing/text "selection cannot overwrite an existing capture" "flow_selection_collision" (flow_tests/reason (flow_author_ops/select page choose chosen)))
       (testing/nat "native historical path decodes exact record identity" 1 (equal[either[iota safe]] (./ok selected) (flow_ops/origin (seg_texts (safe/spell selected)))))
       (testing/nat "subtree historical references refuse" 1 (either/is_err (flow_ops/origin ["h" "z" "1" "1" "target"])))
       (testing/nat "sovereign epoch references refuse" 1 (either/is_err (flow_ops/origin ["h" "x" "e1" "1" "target"])))
       (testing/nat "trailing historical projections refuse" 1 (either/is_err (flow_ops/origin ["h" "x" "1" "1" "target" "extra"])))
       (testing/nat "authoring stores repeated bindings independently" 2 original.steps.at(0).bindings.len)
       (testing/nat "authored source names exact retained publication" 1 (equal[safe] original.steps.at(0).origin selected))
       (testing/text "first binding selects alpha" "Alpha evidence" (flow_composition_editing_tests/output original))
       (testing/text "rebind changes value" "Beta evidence" (flow_composition_editing_tests/output rebound))
       (testing/nat "child actually republishes after source edit" 1 (gt child_changed.case(.x child_definition).fall(0) selected.ver))
       (testing/nat "recompilation retains original child law" 1 (equal[pin[flow/operation]] retained.steps.at(0).law original.steps.at(0).law))
       (testing/nat "recompilation retains original child origin" 1 (equal[safe] retained.steps.at(0).origin selected))
       (testing/nat "Goo keeps exact invocation and both bindings" 1 (equal[row[flow/step]] retained.steps goo_definition.steps))
       (testing/text "Goo edits selected step prose" "Call the retained published child" (str/from_atom (text_at ['title] (flow_tests/get step goo))))
       (testing/nat "chaining adds one operation without replacing earlier invocation" 2 completed.steps.len)
       (testing/text "chained result follows prior step" "Beta evidence" (flow_composition_editing_tests/output completed))
       (testing/nat "unrelated authored relationship exists before editing" 1 (flow_tests/get page.snoc(($u 0)) initial).has(['note 'related]))
       (testing/nat "unrelated relationship survives authoring" 1 (equal[pail] (flow_tests/get page.weld([($u 0)]) initial).pail_at(['note 'related]) (flow_tests/get page.weld([($u 0)]) chained).pail_at(['note 'related])))
       (testing/text "named annotation survives authoring" "Preserve native annotation" (flow_tests/get note chained).txt_at(['note]))
       (testing/nat "published definition remains captured across authoring" 1 (equal[myth] (flow_tests/get page.weld(['flows 'compose]) published) (flow_tests/get page.weld(['flows 'compose]) chained)))
       (testing/nat "authoring preserves all prior x/y/z history" 1 (row/all[care] (flow_authoring_tests/historical page published chained) [.x .y .z]))
       (testing/text "obsolete authoring form refuses" "flow_stale_source" (flow_tests/reason (flow_author_ops/compose page fields published)))
       (testing/text "unknown bound values refuse" "flow_unbound_value" (flow_tests/reason (flow_author_ops/compose page fields.put(['binding 'left] (pails/p ['absent])) initial)))
       (testing/text "missing ports refuse" "flow_port_mismatch" (flow_tests/reason (flow_author_ops/compose page fields.del(['binding 'right]) initial)))
       (testing/text "invalid result refuses" "flow_unbound_result" (flow_tests/reason (flow_author_ops/compose page fields.put(['result] (pails/p ['absent])) initial)))
       (testing/text "unrecognized fields refuse" "flow_invalid_arguments" (flow_tests/reason (flow_author_ops/compose page fields.put(['junk] (pails/t "no")) initial)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native Semidoc composition authoring retains published selections" flow_authoring_tests/checks)]
