- flow_occurrence_tests
- flow_extraction_tests

+ flow_authoring_ui_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = create=row[[str str]] [["action" "create"] ["page" (path_show flow_tests/author)] ["new_name" "composed"] ["kind" "composition"] ["brief" "A reusable authored procedure."]]
      created (flow_ui_tests/act create flow_tests/initial)
      page=path [created.self 'app 'nenex 'w 'composed_flow]
      operation=path [created.self 'gov 'flows 'operations 'identity]
      choose=row[[str str]] [["action" "select_step"] ["page" (path_show page)] ["selection_name" "copied"] ["mode" "step"] ["definition" (path_show operation)]]
      [selected index selection_reply] (helm/supervisor/admit (flow_ui/plan choose) created (sovereign_hive created))
      cell=path page.weld(['cells 'copied])
    ?> saved=native_work/captured (flow_tests/get cell selected).pail_at(['capture])
      [(testing/text "callable selection creates native capture" "ok" (flow_tests/reason (flow_ui/plan choose created)))]
    = fields=row[[str str]] [["action" "compose"] ["page" (path_show page)] ["name" "copied"]
        ["source" (flow_tests/get page selected).txt_at(['src])]
        ["selected_version" (nat/show saved.source.ver)] ["selected_definition" (path_show saved.source.path)]
        ["flow_name" "composed"] ["step_name" "finished"] ["result" "finished"] ["new_inputs" ""] ["binding/value" "result"]]
      [composed index compose_reply] (helm/supervisor/admit (flow_ui/plan fields) selected (sovereign_hive selected))
      source (flow_tests/get page composed).txt_at(['src])
      publish=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "composed"] ["source" source]]
      [published index publish_reply] (helm/supervisor/admit (flow_ui/plan publish) composed (sovereign_hive composed))
      rendered (weft/render (weft/el "div" [] (flow_ui/render page (sovereign_peek page published))))
    ?> definition=flow/definition (flow_tests/get page.weld(['flows 'composed]) published).pail_at((flow_ops/key published.self 'definition))
      [(testing/text "composed source publishes" "ok" (flow_tests/reason (flow_ui/plan publish composed)))]
    = stale (flow_ui/plan (flow_occurrence_tests/replace "selected_version" "999999" fields) composed)
      obsolete (flow_ui/plan fields composed)
      selection (flow_tests/get cell selected)
    [(testing/nat "selection is admitted through the existing form route" 1 (flow_occurrence_tests/admitted selection_reply))
     (testing/nat "composition is admitted through the existing form route" 1 (flow_occurrence_tests/admitted compose_reply))
     (testing/nat "composed flow publishes through existing form route" 1 (flow_occurrence_tests/admitted publish_reply))
     (testing/nat "composition adds a dependent step" 2 definition.steps.len)
     (testing/nat "composed step uses exact selected operation" 1 (equal[safe] saved.source definition.steps.at(1).origin))
     (testing/nat "new step consumes earlier result" 1 (equal[iota] 'result definition.steps.at(1).bindings.at(0).value))
     (testing/nat "composition preserves its native capture" 1 (equal[myth] selection (flow_tests/get cell published)))
     (testing/nat "form reflects native operation ports" 1 (cord/has "binding/value" rendered))
     (testing/nat "form explains retained version selection" 1 (cord/has "Captured /h/x/" rendered))
     (testing/text "changed selection version refuses" "flow_stale_selection" (flow_tests/reason stale))
     (testing/text "obsolete source form refuses" "flow_stale_source" (flow_tests/reason obsolete))
     (testing/text "selection cannot overwrite retained cell" "flow_selection_collision" (flow_tests/reason (flow_ui/plan choose selected)))
     (testing/nat "previous source and x/y/z history remain" 1 (row/all[care] (flow_occurrence_tests/history page selected published) [.x .y .z]))]
  + extraction
    \ ignored=unit
    ^ row[testing/check]
    = before (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      fields=row[[str str]] [["action" "extract"] ["page" (path_show flow_tests/author)] ["new_name" "selected_work"]
        ["attempt" (path_show flow_tests/run)] ["steps" "decomposed"]]
      [after index reply] (helm/supervisor/admit (flow_ui/plan fields) before (sovereign_hive before))
      page=path [after.self 'app 'nenex 'w 'selected_work_flow]
      source (flow_tests/get page after).txt_at(['src])
      [status response] (flow_ui/response fields .none after)
      rendered (weft/render (weft/el "div" [] (flow_ui/render flow_tests/author (sovereign_peek flow_tests/author before))))
      publish=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "selected_work"] ["source" source]]
      [published index publish_reply] (helm/supervisor/admit (flow_ui/plan publish) after (sovereign_hive after))
    [(testing/nat "extract form admits native operation" 1 (flow_occurrence_tests/admitted reply))
     (testing/nat "extracted source can publish from Nenex" 1 (flow_occurrence_tests/admitted publish_reply))
     (testing/nat "extracted flow source is populated" 1 (gt source.len 0))
     (testing/nat "retained runs expose extraction form" 1 (cord/has "Extract retained run:" rendered))
     (testing/nat "redirect opens the new authored page" 1 (cord/has "selected_work_flow" (str/to_atom response)))
     (testing/nat "external input keeps captured example cell" 1 (flow_tests/get page.weld(['cells 'inputs 'checked]) after).has(['capture]))
     (testing/text "extract form refuses unknown steps" "flow_extraction_unknown_or_duplicate_step"
       (flow_tests/reason (flow_ui/plan (flow_occurrence_tests/replace "steps" "unknown" fields) before)))
     (testing/nat "original retained run and history survive" 1 (row/all[care] (flow_occurrence_tests/history flow_tests/run before published) [.x .y .z]))]

+ tests
  ^ row[testing/case]
  [(testing/case "Nenex native composition form" flow_authoring_ui_tests/checks)
   (testing/case "Nenex retained trace extraction form" flow_authoring_ui_tests/extraction)]
