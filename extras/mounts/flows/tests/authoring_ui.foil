- flow_occurrence_tests
- flow_extraction_tests

+ flow_authoring_ui_tests
  + adoption
    \ ignored=unit
    ^ row[testing/check]
    = initial=namespace flow_tests/prepared
      page=path flow_tests/author
      controller=path page.weld(['work 'retained])
      previous=safe (safe initial.case(.x flow_tests/definition).fall(0) .x flow_tests/definition)
      before=namespace (flow_tests/apply 'follow controller (flow_tests/follow_request).put(['definition] previous) initial)
      old_run=path controller.weld(['work ($u 1)])
      edit=myth (myth/sing ['source] (pails/t (flow_tests/book_source "Adopted title"))).put(['expected] (pails/n before.case(.x page).fall(0)))
      changed=namespace (flow_tests/apply 'author page edit before)
      published=namespace (flow_tests/apply 'publish page (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n changed.case(.x page).fall(0))) changed)
      select=row[[str str]] [["page" (path_show page)] ["occurrence_name" "replacement"] ["definition" (path_show flow_tests/definition)]]
      selected=namespace (flow_ui_tests/act flow_author_controls/select select published)
      fields=row[[str str]] [["page" (path_show page)] ["controller" (path_show controller)]
        ["previous" (path_show (safe/spell previous))] ["selection" (path_show page.weld(['cells 'replacement]))]]
      [after index reply] (helm/supervisor/admit (flow_tests/plan flow_author_controls/adopt fields) selected (sovereign_hive selected))
      detached=namespace (flow_tests/apply 'detach controller myth/new selected)
    ?> config=flow_maintenance/config (flow_tests/get controller after).pail_at(['flow 'config])
      [(testing/text "adoption keeps controller" "present" "missing")]
    ?> saved=native_work/captured (flow_tests/get page.weld(['cells 'replacement]) after).pail_at(['capture])
      [(testing/text "replacement is captured" "present" "missing")]
    | [(testing/nat "adoption admits through native Nenex form" 1 (flow_occurrence_tests/admitted reply))
       (testing/nat "publication alone leaves retained occurrence unchanged" 1 (cord/has "First title" (str/to_atom (flow_tests/get flow_tests/destination selected).txt_at(['src]))))
       (testing/nat "adoption publishes revised result" 1 (cord/has "Adopted title" (str/to_atom (flow_tests/get flow_tests/destination after).txt_at(['src]))))
       (testing/nat "occurrence selects exact captured publication" 1 (equal[pail] saved.source (unpin config.request).pail_at(['definition])))
       (testing/nat "previous attempt remains intact" 1 (equal[myth] (flow_tests/get old_run before) (flow_tests/get old_run after)))
       (testing/nat "adoption preserves previous x/y/z histories" 1 (row/all[care] (flow_occurrence_tests/history controller before after) [.x .y .z]))
       (testing/text "obsolete adoption form is refused" "flow_stale_definition" (flow_tests/reason (flow_tests/plan flow_author_controls/adopt fields after)))
       (testing/text "detached occurrence cannot be revived through adoption" "flow_controller_detached" (flow_tests/reason (flow_tests/plan flow_author_controls/adopt fields detached)))]
  + pending_adoption
    \ ignored=unit
    ^ row[testing/check]
    = initial=namespace flow_revision_tests/prepared
      page=path flow_tests/author
      controller=path page.weld(['work 'adopting])
      destination=path [initial.self 'app 'nenex 'w 'adopted_concepts]
      previous=safe (safe initial.case(.x flow_tests/definition).fall(0) .x flow_tests/definition)
      request=myth (flow_tests/follow_request).put(['definition] previous).put(['destination] (pails/p destination))
      started=namespace (flow_tests/apply 'follow controller request initial)
      first=path controller.weld(['work 'revision_1])
      second=path controller.weld(['work 'revision_2])
      before=namespace (flow_tests/apply 'submit_revision first (flow_revision_tests/response first started) started)
      source=str (str/cat_all [flow_revision_tests/source "\n  ;= Publication note\n    Reviewed procedure.\n"])
      authored=namespace (flow_tests/apply 'author page (myth/sing ['source] (pails/t source)).put(['expected] (pails/n before.case(.x page).fall(0))) before)
      published=namespace (flow_tests/apply 'publish page (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x page).fall(0))) authored)
      selected=safe (safe published.case(.x flow_tests/definition).fall(0) .x flow_tests/definition)
      input=myth (myth/sing ['definition] selected).put(['previous] previous)
      planned=either[iota row[[p=path q=writ]]] (flow_maintenance_ops/adopt controller input published)
      admitted=either[iota [namespace hive]] (namespace_command/admit (flow_maintenance_ops/adopt controller input) published (sovereign_hive published))
      admission_reason=str
        ?> (./err why) admitted "ok"
        | str/from_atom (quip_val why)
      adopted=namespace (flow_tests/apply 'adopt controller input published)
      late=either[iota row[[p=path q=writ]]] (flow_maintenance_ops/submit_revision second (flow_revision_tests/response second adopted) adopted)
      fresh=path controller.weld(['work 'revision_3])
      last=path controller.weld(['work 'revision_4])
      half=namespace (flow_tests/apply 'submit_revision fresh (flow_revision_tests/response fresh adopted) adopted)
      complete=namespace (flow_tests/apply 'submit_revision last (flow_revision_tests/response last half) half)
    | [(testing/text "partially completed adoption plans" "ok" (flow_tests/reason planned))
       (testing/text "partially completed adoption admits" "ok" admission_reason)
       (testing/text "old pending revision cannot submit after adoption" "flow_stale_revision" (flow_tests/reason late))
       (testing/nat "adoption restages even equal tasks under new definition" 1 (flow_tests/get fresh adopted).has(['flow 'request]))
       (testing/nat "old resolution does not prematurely publish" 0 (flow_tests/get destination adopted).has(['src]))
       (testing/nat "new attempts complete through existing hand" 1 (flow_tests/get destination complete).has(['src]))
       (testing/nat "completed predecessor remains retained" 1 (equal[myth] (flow_tests/get first before) (flow_tests/get first complete)))
       (testing/text "superseded pending predecessor is settled" "waiting" (flow_tests/get second complete).txt_at(['work 'status]))
       (testing/nat "pending predecessor retains its exact capture" 1 (equal[pail] (flow_tests/get second before).pail_at(['capture]) (flow_tests/get second complete).pail_at(['capture])))
       (testing/nat "pending predecessor retains its exact request" 1 (equal[pail] (flow_tests/get second before).pail_at(['flow 'request]) (flow_tests/get second complete).pail_at(['flow 'request])))
       (testing/nat "pending predecessor retains its captured definition" 1 (equal[pail] (flow_tests/get second before).pail_at(['flow 'definition]) (flow_tests/get second complete).pail_at(['flow 'definition])))
       (testing/nat "resolution invalidation retains all prior x/y/z history" 1 (row/all[care] (flow_occurrence_tests/history controller before complete) [.x .y .z]))]
  + discovery
    \ ignored=unit
    ^ row[testing/check]
    = base=namespace flow_tests/prepared
      initial=namespace (flow_tests/poke [base.self 'gov 'flows 'operations 'identity] (myth/sing ['note] (pails/t "New callable record case")) base)
      page=path flow_tests/author
      scope=path (flow_ops/key initial.self 'operations)
      fields=row[[str str]] [["page" (path_show page)] ["selection_name" "available"] ["scope" (path_show scope)]]
      [after index reply] (helm/supervisor/admit (flow_tests/plan flow_author_controls/inspect_callables fields) initial (sovereign_hive initial))
      cell=path page.weld(['cells 'available])
    ?> saved=native_work/captured (flow_tests/get cell after).pail_at(['capture])
      [(testing/text "native discovery captures a subtree" "capture" "missing")]
    ?> origin=safe (flow_tests/get cell after).pail_at(['flow 'callable_origin 'identity])
      [(testing/text "catalogue retains native callable origin" "present" "missing")]
    = edited=namespace (flow_tests/poke scope.snoc('identity) (myth/sing ['note] (pails/t "Later publication")) after)
      choose=myth (myth/sing ['name] (pails/p ['retained_callable])).put(['mode] (pails/t "step")).put(['selected] origin)
      selected=namespace (flow_tests/apply 'select_step page choose edited)
      chosen=path page.weld(['cells 'retained_callable])
      expected (cooperate_ops/capture origin initial)
    ?> held=native_work/captured (flow_tests/get chosen selected).pail_at(['capture])
      [(testing/text "catalogue selects captured callable" "capture" "missing")]
    | [(testing/nat "catalogue captures the callable's own case" initial.case(.x scope.snoc('identity)).fall(0) origin.ver)
       (testing/nat "catalogue selects old callable after publication" 1 (and (equal[safe] held.source origin) (equal[pin[axal[myth]]] held.value (either/ok_val expected).value)))
       (testing/nat "native discovery admits through Nenex" 1 (flow_occurrence_tests/admitted reply))
       (testing/nat "catalogue uses existing captured cell" 1 (unpin saved.value).get(['identity]).is_some)
       (testing/text "catalogue cannot overwrite prior capture" "flow_selection_collision" (flow_tests/reason (flow_tests/plan flow_author_controls/inspect_callables fields after)))]
  + rerun
    \ ignored=unit
    ^ row[testing/check]
    = before=namespace (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      fields=row[[str str]] [["page" (path_show flow_tests/author)] ["new_name" "reusable"]
        ["attempt" (path_show flow_tests/run)] ["steps" "checked decomposed pages"]]
      extracted=namespace (flow_ui_tests/act flow_author_controls/extract fields before)
      page=path [before.self 'app 'nenex 'w 'reusable_flow]
      publish=row[[str str]] [["page" (path_show page)] ["id" "reusable"] ]
      published=namespace (flow_ui_tests/act flow_author_ops/publish publish extracted)
      source=path [before.self 'user 'another_evidence 'readme]
      imported=namespace (flow_tests/apply 'import_source source (flow_tests/source_record).put(['content] (pails/t "Newly bound evidence")).put(['digest] (pails/t (str/repeat 64 "c"))) published)
      output=path [before.self 'app 'nenex 'w 'reused_output]
      follow=myth (flow_tests/follow_request).put(['definition] (safe 0 .x page.weld(['flows 'reusable]))).put(['destination] (pails/p output)).put(['input 'sources] (safe 0 .z source.take(source.len.dec)))
      after=namespace (flow_tests/apply 'follow page.weld(['work 'reused]) follow imported)
    | [(testing/nat "extracted procedure runs against different evidence" 1 (cord/has "Newly bound evidence" (str/to_atom (flow_tests/get output.weld(['reference 'readme]) after).txt_at(['src]))))
       (testing/nat "rerun uses ordinary work cell" 1 (flow_tests/get page.weld(['work 'reused 'cells 'work]) after).has(bond/weft))
       (testing/nat "rerun retains original execution and x/y/z history" 1 (row/all[care] (flow_occurrence_tests/history flow_tests/run before after) [.x .y .z]))
       (testing/nat "extraction supplies editable input defaults" 1 (flow_tests/get page.weld(['flows 'defaults]) extracted).has(['input 'sources]))]
  + extraction
    \ ignored=unit
    ^ row[testing/check]
    = before (flow_tests/apply 'preview flow_tests/definition flow_tests/preview_request flow_tests/prepared)
      fields=row[[str str]] [["page" (path_show flow_tests/author)] ["new_name" "selected_work"]
        ["attempt" (path_show flow_tests/run)] ["steps" "decomposed"]]
      [after index reply] (helm/supervisor/admit (flow_tests/plan flow_author_controls/extract fields) before (sovereign_hive before))
      page=path [after.self 'app 'nenex 'w 'selected_work_flow]
      source (flow_tests/get page after).txt_at(['src])
      publish=row[[str str]] [["page" (path_show page)] ["id" "selected_work"]]
      [published index publish_reply] (helm/supervisor/admit (flow_tests/plan flow_author_ops/publish publish) after (sovereign_hive after))
    [(testing/nat "extract form admits native operation" 1 (flow_occurrence_tests/admitted reply))
     (testing/nat "extracted source can publish from Nenex" 1 (flow_occurrence_tests/admitted publish_reply))
     (testing/nat "extracted flow source is populated" 1 (gt source.len 0))
     (testing/nat "external input keeps captured example cell" 1 (flow_tests/get page.weld(['cells 'inputs 'checked]) after).has(['capture]))
     (testing/text "extract form refuses unknown steps" "flow_extraction_unknown_or_duplicate_step"
       (flow_tests/reason (flow_tests/plan flow_author_controls/extract (flow_occurrence_tests/replace "steps" "unknown" fields) before)))
     (testing/nat "original retained run and history survive" 1 (row/all[care] (flow_occurrence_tests/history flow_tests/run before published) [.x .y .z]))]

+ tests
  ^ row[testing/case]
  [(testing/case "Nenex retained publication adoption" flow_authoring_ui_tests/adoption)
   (testing/case "Adoption invalidates old resolutions and late revisions" flow_authoring_ui_tests/pending_adoption)
   (testing/case "Nenex native callable discovery" flow_authoring_ui_tests/discovery)
   (testing/case "Extracted flow reruns with new bindings" flow_authoring_ui_tests/rerun)
   (testing/case "Nenex retained trace extraction form" flow_authoring_ui_tests/extraction)]
