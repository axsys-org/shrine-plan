- flow_cartography
- graph_publication_fixture

' Exercise the actual compiled Grove boundary, not an untyped policy wrapper.
+ cartography_publication_fixture
  + check
    \ component=myth different=bool
    ^ row[nat]
    = origin (safe 1 .x [($x 17) 'work 'fetch 'result])
      claim (graph_publication_fixture/claim "10" 1).put(['quote] (pails/t "Exact cited evidence")).put(['reason] (pails/t "Retain qualifiers"))
      first (flow_cartography/claim_origin ['a] origin flow_ops/empty [[($u 0)] claim])
      next claim.put(['value] (pails/t (? different "20" "10")))
      claims (flow_cartography/claim_origin ['b] origin first [[($u 0)] next])
      args (flow_ops/empty).rep(['claims] claims).put(['projection] component)
    ?> (./ok projected) (flow_cartography/project args) [999]
    = conflicts (projected.tap.fold(0 (\ total=nat [name card] (add total card.nat_at(['conflicting] 0)))))
      preserved (projected.tap.all((\ [name card] (and (eq name.len 1) (and (eq (aura_tag name.at(0)) "ts")
        (and (eq card.txt_at(['quote]) "Exact cited evidence") (equal[pail] card.pail_at(['proposal]) origin)))))))
    | [projected.wyt conflicts (? preserved 1 0)]
