- flow_test_world
- flow_ui_tests
- flow_request_tests [at=interactive_fixture]
- codex_surface_ops
- conversation_tests
- goo_browser [at=surface_browser]
- goo_bridge [at=surface_bridge]

' Actual published authoring controls are supplied by the Grove gate. Only
' model responses are controlled: inbound tool requests drive ordinary hands.
+ flow_surface_tests
  + report
    \ state=namespace
    ^ row[[str bool str str]]
    | ((flow_surface_tests/descriptions state).weld((flow_surface_tests/checks state)).weld((flow_surface_tests/pagination state)).weld((flow_surface_tests/routing state)).weld((flow_surface_tests/early state)).weld((flow_surface_tests/computed state)).weld((flow_surface_tests/concurrent state)).weld((flow_surface_tests/extraction state)).weld((flow_surface_tests/delegation state)).weld((flow_surface_tests/self_edit state))).map((\ check [check.name check.pass check.want check.got]))
  + descriptions
    \ state=namespace
    ^ row[testing/check]
    = result (codex_surface/actions (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
    ?> (./ok value) result [(testing/nat "action descriptions are available" 1 0)]
    ?> (json/arr items) value [(testing/nat "action descriptions are a catalogue" 1 0)]
    = matching (items.keep((\ item (eq (codex_ops/text (codex_ops/get "label" item)) "Publish flow"))))
    ? !(eq matching.len 1) [(testing/nat "one publish action is described" 1 matching.len)]
    = item matching.at(0)
      action (codex_ops/get "action" item)
      contract (codex_ops/get "contract" item)
      read (codex_ops/text (codex_ops/get "read" action))
      historical (codex_surface/read (codex_ops/object [(jkv "path" (json/str read)) (jkv "axis" (json/str "x"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))]) state)
    | [(testing/text "headless discovery exposes native action address" (path_show [state.self 'gov 'flows 'authoring 'publish]) (codex_ops/text (codex_ops/get "path" action)))
       (testing/nat "headless discovery exposes native argument schema" 0 (equal[json] jnull contract))
       (testing/nat "reflected historical read address resolves" 1 (either/is_ok historical))
       (testing/text "headless discovery exposes reverse reference navigation" (path_show (r_spell [state.self 'gov 'flows 'authoring 'publish])) (codex_ops/text (codex_ops/get "incoming" action)))]
  + delegation
    ' The controlled provider uses the same dispatch receipt and captured
    ' authorization law that the real Codex hand checks before tool calls.
    \ ignored=namespace
    ^ row[testing/check]
    = state=namespace interactive_fixture/request_tests/started
      attempt=path (flow_tests/controller).weld(['work 'request_1])
      worker=path (row/snoc[iota] 'worker attempt)
      record=myth (flow_tests/get worker state)
    ?> guard=native_work/captured record.pail_at(['fixture 'guard])
      [(testing/nat "interactive worker captures its exact guard" 1 0)]
    = waiting=codex_work/waiting (codex_work/waiting [] (pin guard) .none)
      paused=namespace (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .false)) state)
      detached=namespace (flow_tests/apply 'detach flow_tests/controller myth/new state)
      changed=namespace (flow_tests/change_source "Native interactive task evidence changed" state)
    [(testing/nat "Codex accepts an explicitly delegated current flow task" 1
       (either/is_ok (codex_surface_ops/authorized worker record waiting state)))
     (testing/nat "Codex refuses paused flow authority" 1
       (either/is_err (codex_surface_ops/authorized worker record waiting paused)))
     (testing/nat "Codex refuses detached flow authority" 1
       (either/is_err (codex_surface_ops/authorized worker record waiting detached)))
     (testing/nat "Codex refuses outdated flow evidence" 1
       (either/is_err (codex_surface_ops/authorized worker record waiting changed)))]
  + home
    ^ path
    [($x 17) 'io 'surface_test]
  + owner
    ^ path
    | (flow_tests/author).weld(['work 'agent])
  + worker
    ^ path
    | (flow_surface_tests/owner).weld(['workers 'first])
  + start
    \ state=namespace
    ^ namespace
    = home=path flow_surface_tests/home
      cards=row[[path myth]]
        [[home.weld(['kook 'surface_work]) (myth/sing system_vocabulary/form codex_surface_ops/form)]
         [home.weld(['kook 'surface_effect]) (myth/sing system_vocabulary/form codex_surface_ops/effect_form)]
         [home.weld(['kook 'surface_task]) (myth/sing system_vocabulary/form codex_surface_ops/task_form)]
         [home.snoc('surface_capture) (myth/sing system_vocabulary/op (namespace_op codex_surface_ops/capture))]
         [home.snoc('surface_call) (myth/sing system_vocabulary/op (namespace_op codex_surface_ops/execute))]
         [home.snoc('provider) (myth/sing ['work 'provider] (native_work/provider (codex_surface_ops/make home)))]]
      state (cards.fold(state (\ state [path card] (flow_tests/poke path card state))))
      [state index reply] (helm/supervisor/admit
        (cooperate_ops/open flow_tests/author (myth/sing ['id] (pails/t "agent")).put(['content] (pails/t "Build an operable document"))) state (sovereign_hive state))
      state (flow_tests/accepted reply state)
      args (myth/sing ['id] (pails/t "first")).put(['prompt] (pails/t "Author and inspect a working document through the declared surface."))
      args args.put(['schema] (pails/t "{}")).put(['provider] (safe 0 .x home.snoc('provider)))
      args args.put(['guard] (safe 0 .x [state.self 'gov 'cooperate 'empty]))
      [state index reply] (helm/supervisor/admit (cooperate_ops/delegate flow_surface_tests/owner args) state (sovereign_hive state))
      state (flow_tests/accepted reply state)
    state
  + acknowledge
    \ state=namespace
    ^ namespace
    | flow_surface_tests/acknowledge_worker flow_surface_tests/worker "surface-thread" "surface-turn" state
  + acknowledge_worker
    \ worker=path thread=str turn=str state=namespace
    ^ namespace
    ?> waiting=codex_work/waiting (flow_tests/get worker state).pail_at(['codex 'waiting]) (Seq[namespace] (error (pails/t "Provider did not start")) state)
    = ack (myth/sing codex_slots/done (pd 1)).put(codex_slots/ok (pd 1))
      result (codex_ops/object [(jkv "threadId" (json/str thread)) (jkv "turn" (codex_ops/object [(jkv "id" (json/str turn))]))])
    | flow_tests/poke waiting.command ack.put(codex_slots/result (pails/t (show result))) state
  + seed
    \ state=namespace
    ^ namespace
    | flow_surface_tests/acknowledge (flow_surface_tests/start state)
  + call
    \ id=str tool=str arguments=json state=namespace
    ^ namespace
    | flow_surface_tests/call_worker flow_surface_tests/worker "surface-thread" "surface-turn" id tool arguments state
  + call_worker
    \ worker=path thread=str turn=str id=str tool=str arguments=json state=namespace
    ^ namespace
    = args (codex_ops/put "worker" (json/str (path_show worker)) arguments)
      params (codex_ops/object [(jkv "threadId" (json/str thread)) (jkv "turnId" (json/str turn))
        (jkv "callId" (json/str id)) (jkv "tool" (json/str tool)) (jkv "arguments" args)])
    | flow_surface_tests/incoming id params state
  + incoming
    \ id=str params=json state=namespace
    ^ namespace
    = record (codex_ops/request_effect (json/str id) "item/tool/call" params)
      record record.put(limb_slot (kook [(flow_surface_tests/home).weld(['kook 'surface_effect])]))
    | flow_tests/poke (flow_surface_tests/home).snoc(($ts id)) record state
  + response
    \ id=str state=namespace
    ^ json
    = text (flow_tests/get (flow_surface_tests/home).snoc(($ts id)) state).txt_at(codex_slots/reply_result)
    ?> (./ok value rest) (codex_json/decode text) (codex_ops/object [(jkv "success" (json/boo .false))])
    value
  + success
    \ id=str state=namespace
    ^ bool
    | equal[json] (codex_ops/get "success" (flow_surface_tests/response id state)) (json/boo .true)
  + answer
    \ id=str state=namespace
    ^ json
    ?> (json/arr content) (codex_ops/get "contentItems" (flow_surface_tests/response id state)) jnull
    ? !(content.len) jnull
    ?> (./ok value rest) (codex_json/decode (codex_ops/text (codex_ops/get "text" content.at(0)))) jnull
    value
  + selected
    \ label=str catalogue=json
    ^ json
    ?> (json/arr controls) catalogue jnull
    = found controls.keep((\ item (eq label (codex_ops/text (codex_ops/get "label" item)))))
    ? !(eq found.len 1) jnull
    | codex_ops/get "fields" found.at(0)
  + fields
    \ label=str inputs=row[[str str]] state=namespace
    ^ json
    = catalogue (codex_surface/actions (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
    ?> (./ok catalogue) catalogue jnull
    = selected (flow_surface_tests/selected label catalogue)
    | inputs.fold(selected (\ out [name value] (codex_ops/put (str/cat_all ["input:" name]) (json/str value) out)))
  + act
    \ id=str fields=json state=namespace
    ^ namespace
    | flow_surface_tests/call id "shrine_act" (codex_ops/object [(jkv "fields" (json/str (show fields)))]) state
  + count
    \ value=json
    ^ nat
    ?> (json/arr items) value 0
    items.len
  + current_fields
    \ value=json state=namespace
    ^ bool
    ?> (./ok fields) (codex_surface/fields value) .false
    = body=str (str/join "&" (fields.map((\ [key text] (str/cat_all [(value_read/percent key) "=" (value_read/percent text)])))))
    ?> (./interact query) (explorer_dev/interact (http_foot/request "POST" "/goo/act" body) 0) .false
    | either/is_ok (goo_runtime/current query state)
  + concurrent
    ' Force the same declared version to be observed by both native workers.
    ' Only model acknowledgement is controlled; actions use production Goo.
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      second=path (flow_surface_tests/owner).weld(['workers 'second])
      args (myth/sing ['id] (pails/t "second")).put(['prompt] (pails/t "Work on the same authored page."))
      args args.put(['schema] (pails/t "{}")).put(['provider] (safe 0 .x (flow_surface_tests/home).snoc('provider)))
      args args.put(['guard] (safe 0 .x [state.self 'gov 'cooperate 'empty]))
      [state index reply] (helm/supervisor/admit (cooperate_ops/delegate flow_surface_tests/owner args) state (sovereign_hive state))
      state (flow_tests/accepted reply state)
      state (flow_surface_tests/acknowledge_worker second "second-thread" "second-turn" state)
      call_second (flow_surface_tests/call_worker second "second-thread" "second-turn")
      discover (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))])
      observed (call_second "second_discover" "shrine_actions" discover (flow_surface_tests/call "first_discover" "shrine_actions" discover state))
      first_fields=json (flow_surface_tests/selected "Publish flow" (flow_surface_tests/answer "first_discover" observed))
      second_fields=json (flow_surface_tests/selected "Publish flow" (flow_surface_tests/answer "second_discover" observed))
      same_selection=bool
        | (row/all[str] (\ key=str (equal[json] (codex_ops/get key first_fields) (codex_ops/get key second_fields)))
            ["target" "subject" "view" "control" "expected" "displayed"])
      both_current=bool (and (flow_surface_tests/current_fields first_fields observed) (flow_surface_tests/current_fields second_fields observed))
      fields (codex_ops/put "input:/id" (json/str "handbook") first_fields)
      published (flow_surface_tests/act "first_publish" fields observed)
      first (flow_tests/get flow_surface_tests/worker published)
      stale (call_second "second_stale" "shrine_act" (codex_ops/object [(jkv "fields" (json/str (show fields)))]) published)
      foreign (flow_surface_tests/call_worker second "surface-thread" "surface-turn" "cross_turn" "shrine_actions" discover stale)
      refreshed (call_second "second_refresh" "shrine_actions" discover foreign)
      fresh_fields (codex_ops/put "input:/id" (json/str "handbook")
        (flow_surface_tests/selected "Publish flow" (flow_surface_tests/answer "second_refresh" refreshed)))
      retried (call_second "second_retry" "shrine_act" (codex_ops/object [(jkv "fields" (json/str (show fresh_fields)))]) refreshed)
      trace_first (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('first_publish))
      trace_second (codex_surface_ops/trace second (flow_surface_tests/home).snoc('second_stale))
    [(testing/nat "two workers select the same declaration, control and receiver" 1 same_selection)
     (testing/nat "both selections remain current after unrelated tool receipts" 1 both_current)
     (testing/nat "first worker publishes through shared admission" 1 (flow_surface_tests/success "first_publish" published))
     (testing/nat "second worker's stale action refuses" 0 (flow_surface_tests/success "second_stale" stale))
     (testing/nat "stale action preserves first worker's publication" 1
       (equal[myth] (flow_tests/get flow_tests/definition published) (flow_tests/get flow_tests/definition stale)))
     (testing/nat "one worker cannot borrow another worker's turn" 0 (flow_surface_tests/success "cross_turn" foreign))
     (testing/nat "second worker can rediscover and retry" 1 (flow_surface_tests/success "second_retry" retried))
     (testing/nat "second worker never advances first worker's trace" 1 (equal[myth] first (flow_tests/get flow_surface_tests/worker retried)))
     (testing/nat "first event retains first owner" 1
       (native_work_ops/state (flow_tests/get trace_first retried)).run((\ activity (equal[path] activity.owner flow_surface_tests/worker))).fall(.false))
     (testing/nat "second event retains second owner" 1
       (native_work_ops/state (flow_tests/get trace_second retried)).run((\ activity (equal[path] activity.owner second))).fall(.false))
     (testing/nat "both workers retain all x y z history" 1
       (row/all[care] (\ care (and
         (equal (namespace/page care published.case(care flow_surface_tests/worker) flow_surface_tests/worker published)
           (namespace/page care published.case(care flow_surface_tests/worker) flow_surface_tests/worker retried))
         (equal (namespace/page care observed.case(care second) second observed)
           (namespace/page care observed.case(care second) second retried)))) [.x .y .z]))]
  + extraction
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      fields (flow_surface_tests/fields "Publish flow" [["/id" "handbook"]] state)
      published (flow_surface_tests/act "good_action" fields state)
      failed (flow_surface_tests/act "stale_action" fields published)
      worker=path flow_surface_tests/worker
      good=path (codex_surface_ops/trace worker (flow_surface_tests/home).snoc('good_action))
      extract=row[[str str]] [["action" "extract_trace"] ["page" (path_show flow_tests/author)]
        ["run" (path_show worker)] ["sequence" "2"] ["events" "stale_action good_action"] ["new_name" "goo_trace"]]
      drafted (flow_ui_tests/act extract failed)
      target=path [state.self 'app 'nenex 'w 'goo_trace_flow]
      source (flow_tests/get target drafted).txt_at(['src])
      success=path target.weld(['cells 'inputs 'evidence_1])
      failure=path target.weld(['cells 'inputs 'evidence_2])
    ?> good_saved=native_work/captured (flow_tests/get success drafted).pail_at(['capture])
      [(testing/text "successful Goo receipt captured" "capture" "missing")]
    ?> bad_saved=native_work/captured (flow_tests/get failure drafted).pail_at(['capture])
      [(testing/text "failed Goo receipt captured" "capture" "missing")]
    = good_card (unpin good_saved.value).fil.fall(myth/new)
      bad_card (unpin bad_saved.value).fil.fall(myth/new)
      replayed (flow_tests/poke (flow_surface_tests/home).snoc('good_action) myth/new drafted)
      mutated (flow_tests/poke good (myth/sing ['test 'later] (pails/t "Later event change")) replayed)
      old_request (flow_tests/get (flow_surface_tests/home).snoc('good_action) failed)
      publish=row[[str str]] [["action" "publish"] ["page" (path_show target)] ["name" "goo_trace"] ["source" source]]
    [(testing/text "successful declared action is settled evidence" "complete" good_card.txt_at(['work 'status]))
     (testing/text "refused declared action is settled evidence" "failed" bad_card.txt_at(['work 'status]))
     (testing/nat "successful action receipt remains captured" 1 good_card.has(codex_slots/reply_result))
     (testing/nat "failed action reason remains captured" 1 bad_card.has(codex_slots/reply_result))
     (testing/nat "successful action retains its own request address" 1 (equal[maybe[path]] good_card.path_at(['codex 'effect]) (./some (flow_surface_tests/home).snoc('good_action))))
     (testing/nat "extracting actual Goo calls never republishes behavior" 1
       (equal[myth] (flow_tests/get flow_tests/definition failed) (flow_tests/get flow_tests/definition drafted)))
     (testing/nat "extracted Goo calls are inert until composed" 0 (cord/has "/flow/step" (str/to_atom source)))
     (testing/nat "inert Goo draft refuses publication" 1 (either/is_err (flow_tests/plan publish drafted)))
     (testing/nat "draft retains the native authoring hole" 1 (flow_tests/get target.weld(['holes 'extraction]) drafted).has(['work 'hole]))
     (testing/nat "drafting does not alter original request" 1 (equal[myth] old_request (flow_tests/get (flow_surface_tests/home).snoc('good_action) drafted)))
     (testing/nat "later request notifications cannot repeat an action" 1
       (eq drafted.case(.x flow_tests/definition).fall(0) replayed.case(.x flow_tests/definition).fall(0)))
     (testing/nat "later original event edits cannot rewrite captured evidence" 1
       (equal[myth] (flow_tests/get success drafted) (flow_tests/get success mutated)))
     (testing/nat "old action event remains readable at its retained case" 1
       (equal (namespace/page .z failed.case(.z good) good failed) (namespace/page .z failed.case(.z good) good mutated)))]
  + routing
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      params (codex_ops/object [(jkv "threadId" (json/str "surface-thread")) (jkv "turnId" (json/str "surface-turn"))
        (jkv "callId" (json/str "route")) (jkv "tool" (json/str "shrine_actions"))
        (jkv "arguments" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]))])
      missing (flow_surface_tests/incoming "no_worker" params state)
      params (codex_ops/put "arguments" (codex_ops/put "worker" (json/str (path_show flow_surface_tests/worker)) (codex_ops/get "arguments" params)) params)
      foreign (flow_surface_tests/incoming "foreign" (codex_ops/put "turnId" (json/str "another-turn") params) state)
      manual (flow_surface_tests/incoming "manual" (codex_ops/put "tool" (json/str "unrelated_console_tool") params) state)
      request (flow_tests/get (flow_surface_tests/home).snoc('manual) manual)
      namespaced (flow_surface_tests/incoming "namespaced" (codex_ops/put "namespace" (json/str "console") params) state)
      namespaced_request (flow_tests/get (flow_surface_tests/home).snoc('namespaced) namespaced)
      occupied (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('occupied))
      preserved (myth/sing ['keep] (pails/t "Existing trace"))
      conflict (flow_surface_tests/call "occupied" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))])
        (flow_tests/poke occupied preserved state))
      structural (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('structural))
      nested (flow_tests/poke structural.snoc('note) preserved state)
      descendant_conflict (flow_surface_tests/call "structural" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) nested)
      retained (row/all[care] (\ car (equal (namespace/page car nested.case(car structural) structural nested) (namespace/page car nested.case(car structural) structural descendant_conflict))) [.x .y .z])
    [(testing/nat "missing native worker is answered with failure" 1 (flow_tests/get (flow_surface_tests/home).snoc('no_worker) missing).has(codex_slots/reply_result))
     (testing/nat "foreign turn cannot invoke a native action" 0 (flow_surface_tests/success "foreign" foreign))
     (testing/nat "foreign turn receives a settled failure" 1 (flow_tests/get (flow_surface_tests/home).snoc('foreign) foreign).has(codex_slots/reply_result))
     (testing/nat "unrelated console tools with worker arguments remain manual" 1 (codex_surface_ops/pending request))
     (testing/nat "unrelated console tools release native handler" 1 (equal[pail] request.pail_at(limb_slot) (kook [])))
     (testing/nat "namespaced lookalike tools remain manual" 1 (codex_surface_ops/pending namespaced_request))
     (testing/nat "namespaced lookalike tools release native handler" 1 (equal[pail] namespaced_request.pail_at(limb_slot) (kook [])))
     (testing/nat "occupied trace rejects request without leaving it pending" 0 (codex_surface_ops/pending (flow_tests/get (flow_surface_tests/home).snoc('occupied) conflict)))
     (testing/nat "occupied trace content remains intact" 1 (equal[myth] preserved (flow_tests/get occupied conflict)))
     (testing/nat "trace descendant collision settles the tool failure" 0 (codex_surface_ops/pending (flow_tests/get (flow_surface_tests/home).snoc('structural) descendant_conflict)))
     (testing/nat "foreign trace subtree is not adopted as native work" 0 (flow_tests/get structural descendant_conflict).has(['work 'activity]))
     (testing/nat "foreign trace descendant remains current" 1 (equal[myth] preserved (flow_tests/get structural.snoc('note) descendant_conflict)))
     (testing/nat "refused trace allocation preserves x y z history" 1 retained)]
  + early
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/start initial)
      before (flow_surface_tests/call "early" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
      effect (flow_surface_tests/home).snoc('early)
      task (codex_surface_ops/trace flow_surface_tests/worker effect)
      pending (flow_tests/get task before)
      after (flow_surface_tests/acknowledge before)
      settled (flow_tests/get task after)
      event=maybe[native_work/event]
        ?> held=native_work/event settled.pail_at(['work 'event]) .none
        | ./some held
    [(testing/nat "early model request waits for native acknowledgement" 1 (codex_surface_ops/pending (flow_tests/get effect before)))
     (testing/nat "early request owns native trace work outside io" 1 (native_work_ops/active pending))
     (testing/nat "native command change wakes early request" 1 (flow_surface_tests/success "early" after))
     (testing/nat "completed tool clears exact dependencies" 1 (equal[pail] settled.pail_at(crew_slot) (cpail (mop/empty))))
     (testing/nat "completed tool settles retained activity" 0 (native_work_ops/active settled))
     (testing/nat "settlement preserves acyclic trace link" 1 event.run((\ e !(equal[maybe[path]] e.previous (./some task)))).fall(.false))]
  + pagination
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      target=path [state.self 'app 'many_records]
      writes ((row/range 0 66).map((\ n=nat [target.snoc(($ts (str/cat_all ["item_" (nat/show n)]))) (writ/make (myth/sing ['value] (pails/n n)))])))
      state (either/ok_val (grove_install/changes writes state))
      args (codex_ops/object [(jkv "path" (json/str (path_show target))) (jkv "axis" (json/str "z"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      first (flow_surface_tests/call "page1" "shrine_read" args state)
      answer (flow_surface_tests/answer "page1" first)
      args (codex_ops/put "after" (codex_ops/get "next" answer) (codex_ops/put "epoch" (codex_ops/get "epoch" answer) args))
      second (flow_surface_tests/call "page2" "shrine_read" args first)
    [(testing/nat "first read returns a bounded child page" 64 (flow_surface_tests/count (codex_ops/get "children" answer)))
     (testing/nat "second page survives native tool receipt writes" 1 (flow_surface_tests/success "page2" second))
     (testing/nat "second page continues retained namespace snapshot" 2 (flow_surface_tests/count (codex_ops/get "children" (flow_surface_tests/answer "page2" second))))]
  + computed
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      evidence=path [state.self 'app 'computed_evidence]
      lens=path [state.self 'app 'computed_lens]
      input=path [state.self 'app 'computed_input]
      value (myth/sing ['value] (pails/t "Retained evidence"))
      frozen (native_work_ops/value state.self (pin (axal/new[myth] (./some value))))
      identity (\ record=myth record)
      state (either/ok_val (grove_install/changes
        [[evidence (writ/make frozen)] [lens (writ/make (myth/sing bond/weft (dyed identity .none)))] [input (writ/make value)]] state))
      prefix=path ['o ($u 1) ($u lens.len)]
      overlay=path prefix.weld(lens).snoc(($u input.len)).weld(input)
      args (codex_ops/object [(jkv "path" (json/str (path_show evidence.cons('x)))) (jkv "axis" (json/str "x"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      cell_read (flow_surface_tests/call "cell_read" "shrine_read" args state)
      args (codex_ops/put "path" (json/str (path_show overlay)) args)
      overlay_read (flow_surface_tests/call "overlay_read" "shrine_read" args cell_read)
      answer (flow_surface_tests/answer "overlay_read" overlay_read)
      changed (flow_tests/poke input (myth/sing ['value] (pails/t "Changed evidence")) overlay_read)
      args (codex_ops/put "epoch" (codex_ops/get "epoch" answer) args)
      historical (flow_surface_tests/call "historic_overlay" "shrine_read" args changed)
    [(testing/nat "native cell path reads computed evidence" 1 (flow_surface_tests/success "cell_read" cell_read))
     (testing/nat "native cell output has a record" 1 (equal[json] (codex_ops/get "recordAvailable" (flow_surface_tests/answer "cell_read" cell_read)) (json/boo .true)))
     (testing/nat "native overlay path reads projected evidence" 1 (flow_surface_tests/success "overlay_read" overlay_read))
     (testing/nat "retained overlay epoch remains readable after source changes" 1 (flow_surface_tests/success "historic_overlay" historical))
     (testing/nat "retained overlay keeps original computed values" 1 (equal[json] (codex_ops/get "slots" answer) (codex_ops/get "slots" (flow_surface_tests/answer "historic_overlay" historical))))]
  + checks
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      discovered (flow_surface_tests/call "discover" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
      fields (flow_surface_tests/selected "Publish flow" (flow_surface_tests/answer "discover" discovered))
      fields (codex_ops/put "input:/id" (json/str "handbook") fields)
      published (flow_surface_tests/act "publish" fields discovered)
      stale (flow_surface_tests/act "stale" fields published)
      trailing (flow_surface_tests/call "trailing" "shrine_act" (codex_ops/object [(jkv "fields" (json/str (str/cat_all [(show fields) " {}"])))]) discovered)
      repeated (flow_tests/poke (flow_surface_tests/home).snoc('publish) myth/new published)
      read_args (codex_ops/object [(jkv "path" (json/str (path_show flow_tests/author))) (jkv "axis" (json/str "x"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      read (flow_surface_tests/call "read" "shrine_read" read_args published)
      missing (flow_surface_tests/call "missing" "shrine_read" (codex_ops/put "path" (json/str "/0x11/app/absent_source") read_args) read)
      changed (flow_tests/poke [state.self 'gov 'cooperate 'empty] (myth/sing ['changed] (pails/b .true)) read)
      late (flow_surface_tests/call "late" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) changed)
      retained (row/all[care] (\ care (equal (namespace/page care state.case(care flow_tests/author) flow_tests/author state)
        (namespace/page care state.case(care flow_tests/author) flow_tests/author late))) [.x .y .z])
      request (flow_tests/get (flow_surface_tests/home).snoc('publish) published)
      worker (flow_tests/get flow_surface_tests/worker published)
      owner (flow_tests/get flow_surface_tests/owner published)
      closed (flow_tests/poke flow_surface_tests/owner (native_work_ops/status "complete" owner) published)
      after_close (flow_surface_tests/call "closed" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) closed)
    [(testing/nat "agent discovers actual compiled authoring controls through native request hand" 1 (flow_surface_tests/success "discover" discovered))
     (testing/text "agent invokes compiled publication through same native admission" "accepted"
       (? (flow_surface_tests/success "publish" published) "accepted" (show (flow_surface_tests/response "publish" published))))
     (testing/nat "agent publication retains native definition" 1 (flow_tests/get flow_tests/definition published).has((flow_ops/key state.self 'definition)))
     (testing/nat "repeated effect notification cannot publish twice" 1 (eq repeated.case(.x flow_tests/definition).fall(0) published.case(.x flow_tests/definition).fall(0)))
     (testing/nat "old control versions return tool failure" 0 (flow_surface_tests/success "stale" stale))
     (testing/nat "action fields reject trailing JSON" 0 (flow_surface_tests/success "trailing" trailing))
     (testing/nat "malformed action cannot publish" 0 (flow_tests/get flow_tests/definition trailing).has((flow_ops/key state.self 'definition)))
     (testing/nat "agent can read the native document after its effect" 1 (flow_surface_tests/success "read" read))
     (testing/nat "unavailable source is not returned as current evidence" 0 (flow_surface_tests/success "missing" missing))
     (testing/nat "changed guard rejects a late model request" 0 (flow_surface_tests/success "late" late))
     (testing/nat "closed activity refuses late model requests" 0 (flow_surface_tests/success "closed" after_close))
     (testing/nat "tool request retains original model arguments" 1 request.has(codex_slots/payload))
     (testing/nat "tool request links a retained native trace event" 1 (flow_tests/get (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('publish)) published).has(['work 'event]))
     (testing/nat "worker retains ordered tool trace" 1 (native_work_ops/state worker).run((\ activity (gt activity.sequence 0))).fall(.false))
     (testing/nat "agent actions preserve prior x y z document history" 1 retained)]

  + fields_at
    \ target=path label=str inputs=row[[str str]] state=namespace
    ^ json
    ?> (./ok catalogue) (codex_surface/actions (codex_ops/object [(jkv "target" (json/str (path_show target)))]) state) jnull
    = selected (flow_surface_tests/selected label catalogue)
    | inputs.fold(selected (\ out [name value] (codex_ops/put (str/cat_all ["input:" name]) (json/str value) out)))
  + action_worker
    \ worker=path thread=str id=str fields=json state=namespace
    ^ namespace
    | flow_surface_tests/call_worker worker thread "turn" id "shrine_act"
        (codex_ops/object [(jkv "fields" (json/str (show fields)))]) state
  + finish_worker
    \ worker=path thread=str text=str state=namespace
    ^ namespace
    ?> waiting=codex_work/waiting (flow_tests/get worker state).pail_at(['codex 'waiting]) state
    ?> (./some turn) waiting.turn state
    | flow_tests/poke turn (myth/sing codex_slots/result (codex/completion thread "turn" "completed" text)) state
  + current_attempt
    \ controller=path state=namespace
    ^ path
    ?> (./some activity) (native_work_ops/state (flow_tests/get controller state)) []
    | activity.head.fall([])
  + predecessors
    \ request=path state=namespace
    ^ row[path]
    % current=path request seen=row[path] []
    ^ row[path]
    ?> previous=safe (flow_tests/get current.snoc('resumption) state).pail_at(['previous]) seen
    ? (seen.has(previous.path)) seen
    | _ previous.path seen.snoc(previous.path)
  + self_edit
    ' Actual Codex surface hands, compiled Goo actions, namespace admission,
    ' receipts and resumption. Only provider messages are controlled fixtures.
    \ initial=namespace
    ^ row[testing/check]
    = published (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n initial.case(.x flow_tests/author).fall(0))) initial)
      imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record published)
      ready (flow_surface_tests/start (conversation_tests/prepared_in imported))
      page=path [ready.self 'app 'nenex 'w 'resuming_agent]
      wiki=path page.snoc('wiki)
      input (myth/sing ['definition] (safe 0 .x conversation_tests/definition)).put(['provider] (safe 0 .x (flow_surface_tests/home).snoc('provider)))
      input input.put(['roots 'source] (safe 0 .x flow_tests/input_path))
      started (conversation_tests/admit (conversation_ops/start page input) ready)
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "first" "Embed the selected flow once and report its result.")) started)
      controller=path page.weld(['work 'first])
      a=path (flow_surface_tests/current_attempt controller sent)
      worker_a=path a.snoc('worker)
      observed (flow_surface_tests/acknowledge_worker worker_a "self-a" "turn" sent)
      choose_inputs=row[[str str]] [["/occurrence_name" "maintained"] ["/definition" (path_show flow_tests/definition)]]
      selected (flow_surface_tests/action_worker worker_a "self-a" "self_select"
        (flow_surface_tests/fields_at wiki "Select published flow" choose_inputs observed) observed)
      selection=path wiki.weld(['cells 'maintained])
      occurrence=path wiki.weld(['work 'maintained])
      destination=path wiki.snoc('result)
    ?> saved=native_work/captured (flow_tests/get selection selected).pail_at(['capture])
      [(testing/nat "surface self-edit selects a native flow cell" 1 (flow_surface_tests/success "self_select" selected))]
    = bindings (show (json/obj [(jkv "sources" (json/str (path_show (flow_tests/input_path).take((flow_tests/input_path).len.dec))))]))
      embed_inputs=row[[str str]] [["/name" "maintained"] ["/selected_version" saved.source.ver.show] ["/selected_definition" (path_show saved.source.path)]
        ["/source" (show (goo_text/encode (goo/text/en (flow_tests/get wiki selected).txt_at(['src]))))]
        ["/destination" (path_show destination)] ["/writer" (path_show (flow_ops/key ready.self 'nenex))] ["/provider" ""] ["/bindings" bindings]]
      embedded (flow_surface_tests/action_worker worker_a "self-a" "self_embed"
        (flow_surface_tests/fields_at wiki "Embed selected flow" embed_inputs selected) selected)
    ? !(flow_surface_tests/success "self_embed" embedded) [(testing/text "self-edit action admits" "accepted" (show (flow_surface_tests/response "self_embed" embedded)))]
    = b=path (flow_surface_tests/current_attempt controller embedded)
      worker_b=path b.snoc('worker)
      resumed (flow_surface_tests/acknowledge_worker worker_b "self-b" "turn" embedded)
      receipt=path (goo_runtime/receipt_path ready.self (str/cat_all ["codex:" (path_show (flow_surface_tests/home).snoc('self_embed))]))
      trace=path (codex_surface_ops/trace worker_a (flow_surface_tests/home).snoc('self_embed))
      resumption=path b.snoc('resumption)
      predecessors (flow_surface_tests/predecessors b resumed)
      receipt_views (row/cons[path] b predecessors).keep((\ previous=path (equal[pail] (flow_tests/get previous.snoc('resumption) resumed).pail_at(['previous]) (safe 0 .x a))))
      receipt_view=path receipt_views.at(0).snoc('resumption)
      work_view (sovereign_care .z (row/cons[iota] 'x receipt_view) resumed)
      inspected (flow_surface_tests/call_worker worker_b "self-b" "turn" "self_resume_read" "shrine_read"
        (codex_ops/object [(jkv "path" (json/str (path_show (row/cons[iota] 'x resumption)))) (jkv "axis" (json/str "z"))
          (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))]) resumed)
      inspected (flow_surface_tests/call_worker worker_b "self-b" "turn" "self_receipt_read" "shrine_read"
        (codex_ops/object [(jkv "path" (json/str (path_show (row/cons[iota] 'x receipt_view)))) (jkv "axis" (json/str "z"))
          (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))]) inspected)
      reselected (flow_surface_tests/action_worker worker_b "self-b" "self_reselect"
        (flow_surface_tests/fields_at wiki "Select published flow" choose_inputs inspected) inspected)
      replay_source (show (goo_text/encode (goo/text/en (flow_tests/get wiki reselected).txt_at(['src]))))
      replay_inputs (embed_inputs.map((\ [key value] [key (? (eq key "/source") replay_source value)])))
      repeated (flow_surface_tests/action_worker worker_b "self-b" "self_reembed"
        (flow_surface_tests/fields_at wiki "Embed selected flow" replay_inputs reselected) reselected)
      attach_inputs=row[[str str]] [["/destination" (path_show destination)] ["/writer" ""] ["/provider" ""] ["/bindings" bindings]]
      attach_fields (flow_surface_tests/fields_at selection "Attach selected flow" attach_inputs repeated)
      selection_rendered (surface_browser/goo_browser/render_result surface_bridge/goo_bridge/initial_context selection [ready.self 'gov 'flows 'authoring 'selected_flow] [] [] [] .none repeated)
      attached (flow_surface_tests/action_worker worker_b "self-b" "self_attach" attach_fields repeated)
      changed_cell (flow_tests/poke selection (myth/sing ['note] (pails/t "Concurrent selection edit")) repeated)
      stale_selection (flow_surface_tests/action_worker worker_b "self-b" "self_stale_selection" attach_fields changed_cell)
      changed (flow_tests/change_source "New external evidence" attached)
      c=path (flow_surface_tests/current_attempt controller changed)
      worker_c=path c.snoc('worker)
      late (flow_surface_tests/finish_worker worker_b "self-b" (conversation_tests/response (conversation_tests/text [";= Stale" "  Old evidence."])) changed)
      stale_action (flow_surface_tests/action_worker worker_b "self-b" "self_stale_action"
        (flow_surface_tests/fields_at selection "Attach selected flow" attach_inputs late) late)
      current (flow_surface_tests/acknowledge_worker worker_c "self-c" "turn" stale_action)
      done (flow_surface_tests/finish_worker worker_c "self-c" (conversation_tests/response (conversation_tests/text [";= Completed" "  The existing occurrence uses current evidence."])) current)
      old_capture (flow_tests/get a selected).pail_at(['capture])
      current_request (flow_tests/get b attached)
      occurrence_record (flow_tests/get occurrence embedded)
    | [(testing/nat "self-edit accepted through actual tool hand" 1 (flow_surface_tests/success "self_embed" embedded))
       (testing/nat "self-edit retains an actual Goo receipt" 1 (flow_tests/get receipt embedded).has(goo_runtime/receipt_slot))
       (testing/nat "self-edit resumes with its accepted attempt in the native predecessor chain" 1 (predecessors.has(a)))
       (testing/nat "resumption cell exposes prior accepted tool result" 1 (work_view.get(['actions 'self_embed]).fall(myth/new).has(codex_slots/reply_result)))
       (testing/nat "resumed agent can read its work through cells" 1 (flow_surface_tests/success "self_resume_read" inspected))
       (testing/nat "resumed agent follows predecessor cells to accepted receipts" 1 (flow_surface_tests/success "self_receipt_read" inspected))
       (testing/nat "same selection is safely reused" 1 (flow_surface_tests/success "self_reselect" reselected))
       (testing/nat "same embedding is safely reused" 1 (flow_surface_tests/success "self_reembed" repeated))
       (testing/nat "replay adds no source occurrence" embedded.case(.x wiki).fall(0) repeated.case(.x wiki).fall(0))
       (testing/nat "replay preserves exact controller" 1 (equal[myth] occurrence_record (flow_tests/get occurrence attached)))
       (testing/text "captured-cell view renders through the existing Goo host" "ok" (? (either/is_ok selection_rendered) "ok" (either/err_val selection_rendered)))
       (testing/text "captured-cell attach is discovered and admitted" "accepted" (? (flow_surface_tests/success "self_attach" attached) "accepted" (show (flow_surface_tests/response "self_attach" attached))))
       (testing/nat "trace and receipt writes do not obsolete the resumed request" 1 (native_work_ops/active current_request))
       (testing/nat "trace and receipt writes keep the same native head" 1 (equal[path] b (flow_surface_tests/current_attempt controller attached)))
       (testing/nat "selection guard rejects an obsolete form" 0 (flow_surface_tests/success "self_stale_selection" stale_selection))
       (testing/nat "external evidence creates a fresh native request" 1 (flow_tests/get c changed).has(['work 'request]))
       (testing/nat "stale evidence refuses a late answer" 0 (flow_tests/get page.weld(['replies 'first]) late).has(['src]))
       (testing/nat "stale evidence refuses a late effect" 0 (flow_surface_tests/success "self_stale_action" stale_action))
       (testing/text "current evidence completes the resumed answer" "complete" (flow_tests/get c done).txt_at(['work 'status]))
       (testing/nat "answer publishes through the existing writer" 1 (flow_tests/get page.weld(['replies 'first]) done).has(['src]))
       (testing/nat "old capture remains exact" 1 (equal[pail] old_capture (flow_tests/get a done).pail_at(['capture])))
       (testing/nat "accepted receipt remains exact" 1 (equal[myth] (flow_tests/get receipt embedded) (flow_tests/get receipt done)))
       (testing/nat "accepted action trace remains exact" 1 (equal[myth] (flow_tests/get trace embedded) (flow_tests/get trace done)))
       (testing/nat "all earlier x/y/z attempt histories remain readable" 1 (row/all[care]
         (\ care (equal (namespace/page care embedded.case(care a) a embedded) (namespace/page care embedded.case(care a) a done))) [.x .y .z]))]
