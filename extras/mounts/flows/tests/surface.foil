- flow_test_world
- codex_surface_ops

' Actual published authoring controls are supplied by the Grove gate. Only
' model responses are controlled: inbound tool requests drive ordinary hands.
+ flow_surface_tests
  + home
    ^ path
    [($x 17) 'io 'surface_test]
  + owner
    ^ path
    | (flow_tests/author).weld(['work 'agent])
  + worker
    ^ path
    | (flow_surface_tests/owner).weld(['workers 'first])
  + start
    \ state=namespace
    ^ namespace
    = home=path flow_surface_tests/home
      cards=row[[path myth]]
        [[home.weld(['kook 'surface_work]) (myth/sing system_vocabulary/form codex_surface_ops/form)]
         [home.weld(['kook 'surface_effect]) (myth/sing system_vocabulary/form codex_surface_ops/effect_form)]
         [home.weld(['kook 'surface_task]) (myth/sing system_vocabulary/form codex_surface_ops/task_form)]
         [home.snoc('surface_capture) (myth/sing system_vocabulary/op (namespace_op codex_surface_ops/capture))]
         [home.snoc('surface_call) (myth/sing system_vocabulary/op (namespace_op codex_surface_ops/execute))]
         [home.snoc('provider) (myth/sing ['work 'provider] (native_work/provider (codex_surface_ops/make home)))]]
      state (cards.fold(state (\ state [path card] (flow_tests/poke path card state))))
      [state index reply] (helm/supervisor/admit
        (cooperate_ops/open flow_tests/author (myth/sing ['id] (pails/t "agent")).put(['content] (pails/t "Build an operable document"))) state (sovereign_hive state))
      state (flow_tests/accepted reply state)
      args (myth/sing ['id] (pails/t "first")).put(['prompt] (pails/t "Author and inspect a working document through the declared surface."))
      args args.put(['schema] (pails/t "{}")).put(['provider] (safe 0 .x home.snoc('provider)))
      args args.put(['guard] (safe 0 .x [state.self 'gov 'cooperate 'empty]))
      [state index reply] (helm/supervisor/admit (cooperate_ops/delegate flow_surface_tests/owner args) state (sovereign_hive state))
      state (flow_tests/accepted reply state)
    state
  + acknowledge
    \ state=namespace
    ^ namespace
    ?> waiting=codex_work/waiting (flow_tests/get flow_surface_tests/worker state).pail_at(['codex 'waiting]) (Seq[namespace] (error (pails/t "Provider did not start")) state)
    = ack (myth/sing codex_slots/done (pd 1)).put(codex_slots/ok (pd 1))
      result (codex_ops/object [(jkv "threadId" (json/str "surface-thread")) (jkv "turn" (codex_ops/object [(jkv "id" (json/str "surface-turn"))]))])
    | flow_tests/poke waiting.command ack.put(codex_slots/result (pails/t (show result))) state
  + seed
    \ state=namespace
    ^ namespace
    | flow_surface_tests/acknowledge (flow_surface_tests/start state)
  + call
    \ id=str tool=str arguments=json state=namespace
    ^ namespace
    = args (codex_ops/put "worker" (json/str (path_show flow_surface_tests/worker)) arguments)
      params (codex_ops/object [(jkv "threadId" (json/str "surface-thread")) (jkv "turnId" (json/str "surface-turn"))
        (jkv "callId" (json/str id)) (jkv "tool" (json/str tool)) (jkv "arguments" args)])
    | flow_surface_tests/incoming id params state
  + incoming
    \ id=str params=json state=namespace
    ^ namespace
    = record (codex_ops/request_effect (json/str id) "item/tool/call" params)
      record record.put(limb_slot (kook [(flow_surface_tests/home).weld(['kook 'surface_effect])]))
    | flow_tests/poke (flow_surface_tests/home).snoc(($ts id)) record state
  + response
    \ id=str state=namespace
    ^ json
    = text (flow_tests/get (flow_surface_tests/home).snoc(($ts id)) state).txt_at(codex_slots/reply_result)
    ?> (./ok value rest) (codex_json/decode text) (codex_ops/object [(jkv "success" (json/boo .false))])
    value
  + success
    \ id=str state=namespace
    ^ bool
    | equal[json] (codex_ops/get "success" (flow_surface_tests/response id state)) (json/boo .true)
  + answer
    \ id=str state=namespace
    ^ json
    ?> (json/arr content) (codex_ops/get "contentItems" (flow_surface_tests/response id state)) jnull
    ? !(content.len) jnull
    ?> (./ok value rest) (codex_json/decode (codex_ops/text (codex_ops/get "text" content.at(0)))) jnull
    value
  + selected
    \ label=str catalogue=json
    ^ json
    ?> (json/arr controls) catalogue jnull
    = found controls.keep((\ item (eq label (codex_ops/text (codex_ops/get "label" item)))))
    ? !(eq found.len 1) jnull
    | codex_ops/get "fields" found.at(0)
  + fields
    \ label=str inputs=row[[str str]] state=namespace
    ^ json
    = catalogue (codex_surface/actions (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
    ?> (./ok catalogue) catalogue jnull
    = selected (flow_surface_tests/selected label catalogue)
    | inputs.fold(selected (\ out [name value] (codex_ops/put (str/cat_all ["input:" name]) (json/str value) out)))
  + act
    \ id=str fields=json state=namespace
    ^ namespace
    | flow_surface_tests/call id "shrine_act" (codex_ops/object [(jkv "fields" (json/str (show fields)))]) state
  + count
    \ value=json
    ^ nat
    ?> (json/arr items) value 0
    items.len
  + routing
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      params (codex_ops/object [(jkv "threadId" (json/str "surface-thread")) (jkv "turnId" (json/str "surface-turn"))
        (jkv "callId" (json/str "route")) (jkv "tool" (json/str "shrine_actions"))
        (jkv "arguments" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]))])
      missing (flow_surface_tests/incoming "no_worker" params state)
      params (codex_ops/put "arguments" (codex_ops/put "worker" (json/str (path_show flow_surface_tests/worker)) (codex_ops/get "arguments" params)) params)
      foreign (flow_surface_tests/incoming "foreign" (codex_ops/put "turnId" (json/str "another-turn") params) state)
      manual (flow_surface_tests/incoming "manual" (codex_ops/put "tool" (json/str "unrelated_console_tool") params) state)
      request (flow_tests/get (flow_surface_tests/home).snoc('manual) manual)
      namespaced (flow_surface_tests/incoming "namespaced" (codex_ops/put "namespace" (json/str "console") params) state)
      namespaced_request (flow_tests/get (flow_surface_tests/home).snoc('namespaced) namespaced)
      occupied (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('occupied))
      preserved (myth/sing ['keep] (pails/t "Existing trace"))
      conflict (flow_surface_tests/call "occupied" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))])
        (flow_tests/poke occupied preserved state))
    [(testing/nat "missing native worker is answered with failure" 1 (flow_tests/get (flow_surface_tests/home).snoc('no_worker) missing).has(codex_slots/reply_result))
     (testing/nat "foreign turn cannot invoke a native action" 0 (flow_surface_tests/success "foreign" foreign))
     (testing/nat "foreign turn receives a settled failure" 1 (flow_tests/get (flow_surface_tests/home).snoc('foreign) foreign).has(codex_slots/reply_result))
     (testing/nat "unrelated console tools with worker arguments remain manual" 1 (codex_surface_ops/pending request))
     (testing/nat "unrelated console tools release native handler" 1 (equal[pail] request.pail_at(limb_slot) (kook [])))
     (testing/nat "namespaced lookalike tools remain manual" 1 (codex_surface_ops/pending namespaced_request))
     (testing/nat "namespaced lookalike tools release native handler" 1 (equal[pail] namespaced_request.pail_at(limb_slot) (kook [])))
     (testing/nat "occupied trace rejects request without leaving it pending" 0 (codex_surface_ops/pending (flow_tests/get (flow_surface_tests/home).snoc('occupied) conflict)))
     (testing/nat "occupied trace content remains intact" 1 (equal[myth] preserved (flow_tests/get occupied conflict)))]
  + early
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/start initial)
      before (flow_surface_tests/call "early" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
      effect (flow_surface_tests/home).snoc('early)
      task (codex_surface_ops/trace flow_surface_tests/worker effect)
      pending (flow_tests/get task before)
      after (flow_surface_tests/acknowledge before)
      settled (flow_tests/get task after)
      event=maybe[native_work/event]
        ?> held=native_work/event settled.pail_at(['work 'event]) .none
        | ./some held
    [(testing/nat "early model request waits for native acknowledgement" 1 (codex_surface_ops/pending (flow_tests/get effect before)))
     (testing/nat "early request owns native trace work outside io" 1 (native_work_ops/active pending))
     (testing/nat "native command change wakes early request" 1 (flow_surface_tests/success "early" after))
     (testing/nat "completed tool clears exact dependencies" 1 (equal[pail] settled.pail_at(crew_slot) (cpail (mop/empty))))
     (testing/nat "completed tool settles retained activity" 0 (native_work_ops/active settled))
     (testing/nat "settlement preserves acyclic trace link" 1 event.run((\ e !(equal[maybe[path]] e.previous (./some task)))).fall(.false))]
  + pagination
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      target=path [state.self 'app 'many_records]
      writes ((row/range 0 66).map((\ n=nat [target.snoc(($ts (str/cat_all ["item_" (nat/show n)]))) (writ/make (myth/sing ['value] (pails/n n)))])))
      state (either/ok_val (grove_install/changes writes state))
      args (codex_ops/object [(jkv "path" (json/str (path_show target))) (jkv "axis" (json/str "z"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      first (flow_surface_tests/call "page1" "shrine_read" args state)
      answer (flow_surface_tests/answer "page1" first)
      args (codex_ops/put "after" (codex_ops/get "next" answer) (codex_ops/put "epoch" (codex_ops/get "epoch" answer) args))
      second (flow_surface_tests/call "page2" "shrine_read" args first)
    [(testing/nat "first read returns a bounded child page" 64 (flow_surface_tests/count (codex_ops/get "children" answer)))
     (testing/nat "second page survives native tool receipt writes" 1 (flow_surface_tests/success "page2" second))
     (testing/nat "second page continues retained namespace snapshot" 2 (flow_surface_tests/count (codex_ops/get "children" (flow_surface_tests/answer "page2" second))))]
  + computed
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      evidence=path [state.self 'app 'computed_evidence]
      lens=path [state.self 'app 'computed_lens]
      input=path [state.self 'app 'computed_input]
      value (myth/sing ['value] (pails/t "Retained evidence"))
      frozen (native_work_ops/value state.self (pin (axal/new[myth] (./some value))))
      identity (\ record=myth record)
      state (either/ok_val (grove_install/changes
        [[evidence (writ/make frozen)] [lens (writ/make (myth/sing bond/weft (dyed identity .none)))] [input (writ/make value)]] state))
      prefix=path ['o ($u 1) ($u lens.len)]
      overlay=path prefix.weld(lens).snoc(($u input.len)).weld(input)
      args (codex_ops/object [(jkv "path" (json/str (path_show evidence.cons('x)))) (jkv "axis" (json/str "x"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      cell_read (flow_surface_tests/call "cell_read" "shrine_read" args state)
      args (codex_ops/put "path" (json/str (path_show overlay)) args)
      overlay_read (flow_surface_tests/call "overlay_read" "shrine_read" args cell_read)
      answer (flow_surface_tests/answer "overlay_read" overlay_read)
      changed (flow_tests/poke input (myth/sing ['value] (pails/t "Changed evidence")) overlay_read)
      args (codex_ops/put "epoch" (codex_ops/get "epoch" answer) args)
      historical (flow_surface_tests/call "historic_overlay" "shrine_read" args changed)
    [(testing/nat "native cell path reads computed evidence" 1 (flow_surface_tests/success "cell_read" cell_read))
     (testing/nat "native cell output has a record" 1 (equal[json] (codex_ops/get "recordAvailable" (flow_surface_tests/answer "cell_read" cell_read)) (json/boo .true)))
     (testing/nat "native overlay path reads projected evidence" 1 (flow_surface_tests/success "overlay_read" overlay_read))
     (testing/nat "retained overlay epoch remains readable after source changes" 1 (flow_surface_tests/success "historic_overlay" historical))
     (testing/nat "retained overlay keeps original computed values" 1 (equal[json] (codex_ops/get "slots" answer) (codex_ops/get "slots" (flow_surface_tests/answer "historic_overlay" historical))))]
  + checks
    \ initial=namespace
    ^ row[testing/check]
    = state (flow_surface_tests/seed initial)
      discovered (flow_surface_tests/call "discover" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) state)
      fields (flow_surface_tests/selected "Publish flow" (flow_surface_tests/answer "discover" discovered))
      fields (codex_ops/put "input:/id" (json/str "handbook") fields)
      published (flow_surface_tests/act "publish" fields discovered)
      stale (flow_surface_tests/act "stale" fields published)
      trailing (flow_surface_tests/call "trailing" "shrine_act" (codex_ops/object [(jkv "fields" (json/str (str/cat_all [(show fields) " {}"])))]) discovered)
      repeated (flow_tests/poke (flow_surface_tests/home).snoc('publish) myth/new published)
      read_args (codex_ops/object [(jkv "path" (json/str (path_show flow_tests/author))) (jkv "axis" (json/str "x"))
        (jkv "after" (json/str "")) (jkv "epoch" (json/str ""))])
      read (flow_surface_tests/call "read" "shrine_read" read_args published)
      missing (flow_surface_tests/call "missing" "shrine_read" (codex_ops/put "path" (json/str "/0x11/app/absent_source") read_args) read)
      changed (flow_tests/poke [state.self 'gov 'cooperate 'empty] (myth/sing ['changed] (pails/b .true)) read)
      late (flow_surface_tests/call "late" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) changed)
      retained (row/all[care] (\ care (equal (namespace/page care state.case(care flow_tests/author) flow_tests/author state)
        (namespace/page care state.case(care flow_tests/author) flow_tests/author late))) [.x .y .z])
      request (flow_tests/get (flow_surface_tests/home).snoc('publish) published)
      worker (flow_tests/get flow_surface_tests/worker published)
      owner (flow_tests/get flow_surface_tests/owner published)
      closed (flow_tests/poke flow_surface_tests/owner (native_work_ops/status "complete" owner) published)
      after_close (flow_surface_tests/call "closed" "shrine_actions" (codex_ops/object [(jkv "target" (json/str (path_show flow_tests/author)))]) closed)
    [(testing/nat "agent discovers actual compiled authoring controls through native request hand" 1 (flow_surface_tests/success "discover" discovered))
     (testing/text "agent invokes compiled publication through same native admission" "accepted"
       (? (flow_surface_tests/success "publish" published) "accepted" (show (flow_surface_tests/response "publish" published))))
     (testing/nat "agent publication retains native definition" 1 (flow_tests/get flow_tests/definition published).has((flow_ops/key state.self 'definition)))
     (testing/nat "repeated effect notification cannot publish twice" 1 (eq repeated.case(.x flow_tests/definition).fall(0) published.case(.x flow_tests/definition).fall(0)))
     (testing/nat "old control versions return tool failure" 0 (flow_surface_tests/success "stale" stale))
     (testing/nat "action fields reject trailing JSON" 0 (flow_surface_tests/success "trailing" trailing))
     (testing/nat "malformed action cannot publish" 0 (flow_tests/get flow_tests/definition trailing).has((flow_ops/key state.self 'definition)))
     (testing/nat "agent can read the native document after its effect" 1 (flow_surface_tests/success "read" read))
     (testing/nat "unavailable source is not returned as current evidence" 0 (flow_surface_tests/success "missing" missing))
     (testing/nat "changed guard rejects a late model request" 0 (flow_surface_tests/success "late" late))
     (testing/nat "closed activity refuses late model requests" 0 (flow_surface_tests/success "closed" after_close))
     (testing/nat "tool request retains original model arguments" 1 request.has(codex_slots/payload))
     (testing/nat "tool request links a retained native trace event" 1 (flow_tests/get (codex_surface_ops/trace flow_surface_tests/worker (flow_surface_tests/home).snoc('publish)) published).has(['work 'event]))
     (testing/nat "worker retains ordered tool trace" 1 (native_work_ops/state worker).run((\ activity (gt activity.sequence 0))).fall(.false))
     (testing/nat "agent actions preserve prior x y z document history" 1 retained)]
