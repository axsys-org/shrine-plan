- flow_test_world

' Exercise the same source admission and Goo record edit operations as Nenex.
' Invocation is an authored relationship, including every repeated binding.
+ flow_composition_editing_tests
  + author
    ^ path
    [($x 17) 'app 'nenex 'w 'composition_parent]
  + child
    ^ path
    [($x 17) 'app 'nenex 'w 'composition_child]
  + child_source
    ^ str
    | str/from_atom (joined 10
      [";. /composition_child" "  ;@ /flow/definition copy" "  ;= Reusable copy"
       "    ;@ /flow/input left" "    ;= Left"
       "    ;@ /flow/input right" "    ;= Right"
       "    ;@ /flow/step copied ;/0x11/gov/flows/operations/identity"
       "    ;@ /flow/bind value left" "    ;= Copy left"
       "    ;@ /flow/result copied" "    ;= Result"])
  + source
    \ left=nat right=nat
    ^ str
    | str/from_atom (joined 10
      [";. /composition_parent" "  ;@ /flow/definition compose" "  ;= Composition"
       "    ;@ /flow/input alpha" "    ;= Alpha"
       "    ;@ /flow/input beta" "    ;= Beta"
       "    ;@ /flow/invoke called ;/0x11/app/nenex/w/composition_child/flows/copy"
       (cord/cat "    ;@ /flow/bind left " left)
       (cord/cat "    ;@ /flow/bind right " right)
       "    ;= Invoke reusable copy"
       "    ;@ /flow/result called" "    ;= Result"])
  + publish
    \ author=path id=str state=namespace
    ^ namespace
    | flow_tests/apply 'publish author
        ((myth/sing ['id] (pails/t id)).put(['expected] (pails/n state.case(.x author).fall(0)))) state
  + compile
    \ state=namespace
    ^ either[iota flow/definition]
    = author flow_composition_editing_tests/author
    | flow_ops/compile 'compose (safe state.case(.x author).fall(0) .x author)
        (flow_tests/get author state).txt_at(['src]) state
  + output
    \ definition=flow/definition
    ^ str
    = alpha (flow_ops/empty).put([] (myth/sing ['value] (pails/t "Alpha evidence")))
      beta (flow_ops/empty).put([] (myth/sing ['value] (pails/t "Beta evidence")))
      values (axal/new[axal[myth]] .none).put(['alpha] alpha).put(['beta] beta)
    ?> (./ok result) (flow_ops/evaluate definition values) "evaluation failed"
    | (unpin result.result).fil.fall(myth/new).txt_at(['value])
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = author flow_composition_editing_tests/author
      child flow_composition_editing_tests/child
      child_state (flow_tests/apply 'author child
        (myth/sing ['source] (pails/t flow_composition_editing_tests/child_source)) flow_tests/initial)
      child_state (flow_composition_editing_tests/publish child "copy" child_state)
      state (flow_tests/apply 'author author
        (myth/sing ['source] (pails/t (flow_composition_editing_tests/source "alpha" "beta"))) child_state)
      state (flow_composition_editing_tests/publish author "compose" state)
      note author.weld(['cells 'annotation])
      state (flow_tests/poke note (myth/sing ['note] (pails/t "Keep this annotation")) state)
      target author.weld([($u 0) ($u 2)])
      before (flow_tests/get target state)
      input (myth/sing ['src] (pails/t (flow_composition_editing_tests/source "beta" "alpha"))).put(['epoch] (pails/t (nat/show state.local.top)))
      [saved index reply] (helm/supervisor/admit (nenex_edit/source author input) state (sovereign_hive state))
      edited (flow_tests/edit "save" target "Read the other bound evidence" saved)
      published (flow_composition_editing_tests/publish author "compose" edited)
    ?> (./ok original) (flow_composition_editing_tests/compile state)
      [(testing/nat "authored invocation compiles before editing" 1 0)]
    ?> (./ok rebound) (flow_composition_editing_tests/compile saved)
      [(testing/nat "source-rebound invocation compiles" 1 0)]
    ?> (./ok after) (flow_composition_editing_tests/compile published)
      [(testing/nat "Goo-edited invocation compiles" 1 0)]
    = expected (sattr/occurrences [[(sval/word "left") (sval/word "beta")] [(sval/word "right") (sval/word "alpha")]])
      historical (row/all[care] (\ car (equal (namespace/page car state.case(car author) author state)
        (namespace/page car state.case(car author) author published))) [.x .y .z])
    [(testing/nat "invocation publishes through native operations" 1 (flow_tests/get author.weld(['flows 'compose]) state).has((flow_ops/key state.self 'definition)))
     (testing/nat "source and Goo preserve the captured child and rebound ports" 1 (equal rebound.steps after.steps))
     (testing/nat "both invocation bindings survive independently" 2 after.steps.at(0).bindings.len)
     (testing/nat "Goo keeps the original invocation reference" 1 (equal before.pail_at(['flow 'invoke]) (flow_tests/get target published).pail_at(['flow 'invoke])))
     (testing/nat "Goo keeps repeated bindings in one typed native slot" 1 (equal expected (flow_tests/get target published).pail_at(['flow 'bind])))
     (testing/text "Goo edits the invocation prose" "Read the other bound evidence" (str/from_atom (text_at ['title] (flow_tests/get target published))))
     (testing/text "original invocation keeps its original binding" "Alpha evidence" (flow_composition_editing_tests/output original))
     (testing/text "source rebind changes execution" "Beta evidence" (flow_composition_editing_tests/output rebound))
     (testing/text "Goo round trip preserves rebound execution" "Beta evidence" (flow_composition_editing_tests/output after))
     (testing/nat "edited invocation republishes through native operations" 1 (gt published.case(.x author.weld(['flows 'compose])).fall(0) state.case(.x author.weld(['flows 'compose])).fall(0)))
     (testing/text "named cells survive source and Goo edits" "Keep this annotation" (flow_tests/get note published).txt_at(['note]))
     (testing/nat "source and Goo editing preserve captured x/y/z history" 1 historical)]

+ tests
  ^ row[testing/case]
  [(testing/case "Authored invocation source and Goo fidelity" flow_composition_editing_tests/checks)]
