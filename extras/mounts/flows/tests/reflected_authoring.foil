- flow_test_world
- flow_action_ops
- flow_author_controls
- goo_actions [at=author_actions]
- goo_browser [at=author_browser]
- goo_bridge [at=author_bridge]
- explorer_dev
- eden

' Receives an actual compiled authoring.grove publication from the Reaver gate.
+ flow_reflected_authoring_tests
  + bootstrap
    \ state=namespace
    ^ namespace
    ' Mounts run in Eden's asserted application/publication roots. Keep the
    ' exact compiled system and local artifacts supplied by native publication.
    ? (eden/boot state.self state.system state.local 18131)
     > (./ok ready) (flow_tests/bootstrap ready)
     > (./err failed) (Seq[namespace] (error failed) state)
  + initial
    \ state=namespace
    ^ namespace
    | flow_tests/apply 'author flow_tests/author
        ((myth/sing ['source] (pails/t (flow_tests/book_source "A reflected procedure")))).put(['expected] (pails/n 0))
        state
  + previous
    \ state=namespace name=path
    ^ nat
    | state.case(.x name).fall 0
  + lookup
    \ state=namespace name=path
    ^ maybe[myth]
    | (sovereign_peek name state).fil
  + blocked
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | ./err 'publication_disabled
  + browser
    \ query=goo_runtime/request
    ^ maybe[goo_runtime/request]
    = fields=row[[str str]]
        [["target" (path_show query.target)] ["subject" (path_show query.subject)]
         ["view" (path_show query.view)] ["control" (str/join "." query.control.map(nat/show))]
         ["expected" (nat/show query.expected)] ["displayed" (nat/show query.displayed)]
         ["publication" (nat/show query.publication)]]
      fields fields.weld(query.inputs.map((\ [key value] [(str/cat_all ["input:" key]) value])))
      body (str/join "&" fields.map((\ [key value] (str/cat_all [(value_read/percent key) "=" (value_read/percent value)]))))
    ?> (./interact parsed) (explorer_dev/interact (http_foot/request "POST" "/goo/act" body) 0) .none
    | ./some parsed
  + checks
    \ state=namespace
    ^ row[testing/check]
    = page=path flow_tests/author
      face=path [state.self 'gov 'flows 'authoring 'publish_flow]
      action=path [state.self 'gov 'flows 'authoring 'publish]
      slot=path [state.self 'gov 'flows 'authoring 'publication]
      capture=path [state.self 'app 'authoring_probe 'catalog]
      inspect_input (myth/sing ['target] (pails/p page)).put(['view] (pails/p face))
      inspection (flow_action_ops/inspect capture inspect_input state)
      [inspected index reply] (helm/supervisor/admit (flow_action_ops/inspect capture inspect_input) state (sovereign_hive state))
      catalog=axal[myth]
        ?> (./known tree) (sovereign_view .z 0 capture.cons('x) inspected) flow_ops/empty
        tree
      controls catalog.tap.keep((\ [relative card] card.has(['goo 'request])))
      [relative selected] controls.at(0)
      query=goo_runtime/request
        ?> held=goo_runtime/request selected.pail_at(['goo 'request])
          | goo_runtime/request "act" page page face [] 0 0 0 [] 0
        | held.set_inputs([["/id" "handbook"]])
      prepared (flow_action_ops/prepare query inspected)
      prepared_reason=str
        ? prepared
         > (./err why) why
        "ok"
      browser (flow_reflected_authoring_tests/browser query)
      [headless headless_code headless_body] (goo_runtime/act query inspected)
      [clicked clicked_code clicked_body] (goo_runtime/act browser.fall(query.set_control([])) inspected)
      direct (flow_tests/apply 'publish page
        (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n query.expected)) inspected)
      [repeated repeated_code repeated_body] (goo_runtime/act query headless)
      changed (flow_tests/apply 'author page
        (myth/sing ['source] (pails/t (flow_tests/book_source "Revised procedure"))).put(['expected] (pails/n query.expected)) inspected)
      [stale stale_code stale_body] (goo_runtime/act query changed)
      republished (flow_tests/poke action (myth/sing ['test 'publication] (pails/n 1)) inspected)
      [old_view old_view_code old_view_body] (goo_runtime/act query republished)
      disabled (flow_tests/poke (flow_ops/key state.self 'publish)
        (myth/sing system_vocabulary/op (namespace_op flow_reflected_authoring_tests/blocked)) inspected)
      current_query query.set_publication((goo_runtime/publication disabled))
      [denied denied_code denied_body] (goo_runtime/act current_query disabled)
      display (author_browser/goo_browser/render_result author_bridge/goo_bridge/initial_context page face [] [] [] .none inspected)
      view_index (author_browser/goo_browser/index (author_browser/goo_browser/catalog (sovereign_peek [state.self 'gov] inspected)))
      matches=list[goo/published] (author_browser/goo_browser/matching (flow_tests/get page inspected) view_index).keep((\ item (equal[path] item.view.slot slot)))
      page_tools (weft/render (weft/el "div" [] (flow_ui/render page (sovereign_peek page inspected))))
      definition (flow_tests/get page.weld(['flows 'handbook]) headless)
      source (flow_tests/get page inspected).txt_at(['src])
      legacy_fields=row[[str str]] [["action" "publish"] ["name" "handbook"] ["source" source]]
      legacy (flow_ui/plan_publication page legacy_fields inspected)
      canonical (namespace_command/plan page (flow_ops/key state.self 'publish)
        (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n query.expected)) inspected)
      invalid_source (flow_ui/plan_publication page
        [["action" "publish"] ["name" "handbook"] ["source" "Obsolete source"]] inspected)
      retained (row/all[care] (\ care (equal (namespace/page care inspected.case(care page) page inspected)
        (namespace/page care inspected.case(care page) page headless))) [.x .y .z])
    [(testing/nat "fixture has Eden's asserted publication root and native ledger" 1
       (and (maybe/is_some (state.case(.x [state.self 'gov]))) (gt query.publication 0)))
     (testing/nat "editing a publication advances the native publication clock" 1
       !(eq query.publication (goo_runtime/publication republished)))
     (testing/nat "compiled action declares the native operation" 1 (flow_tests/get action inspected).has(system_vocabulary/op))
     (testing/nat "actual compiled view renders through Goo" 1 (either/is_ok display))
     (testing/nat "embedded slot selects one matching published view" 1 matches.len)
     (testing/nat "embedded slot selects the same reflected authoring view" 1 (row/all[goo/published] (\ item (equal[path] item.view.name face)) matches.row))
     (testing/nat "Nenex page tools embed the existing Goo presentation host" 1 (cord/has "/goo-presentation?path=" page_tools))
     (testing/nat "Nenex retains visible Publish flow label" 1 (cord/has "Publish flow" page_tools))
     (testing/nat "native reflection captures the authored control" 1 (either/is_ok inspection))
     (testing/nat "there is one declared publication action" 1 controls.len)
     (testing/text "reflected action has the browser label" "Publish flow" selected.txt_at(['title]))
     (testing/text "reflected publication prepares through Goo" "ok" prepared_reason)
     (testing/nat "browser request parses into the same native action" 1 (equal[maybe[goo_runtime/request]] browser (./some query)))
     (testing/text "headless publication succeeds" "200" (? (eq headless_code 200) "200" headless_body))
     (testing/text "browser publication succeeds" "200" (? (eq clicked_code 200) "200" clicked_body))
     (testing/nat "browser and headless publication produce the same world" 1 (equal[namespace] clicked headless))
     (testing/nat "declared and legacy publication use the canonical native publish behavior" 1
       (and (equal[namespace] direct headless) (equal legacy canonical)))
     (testing/nat "published definition is retained at the ordinary document path" 1 definition.has((flow_ops/key state.self 'definition)))
     (testing/text "publication preserves authored source" source (flow_tests/get page headless).txt_at(['src]))
     (testing/nat "publication preserves prior x y z page history" 1 retained)
     (testing/nat "old displayed request is rejected after publication" 409 repeated_code)
     (testing/nat "rejected old request leaves world unchanged" 1 (equal[namespace] repeated headless))
     (testing/nat "source edit rejects old browser or reflected request" 409 stale_code)
     (testing/nat "stale source failure preserves new source and world" 1 (equal[namespace] stale changed))
     (testing/text "legacy publication endpoint rejects stale source too" "flow_stale_source" (flow_tests/reason invalid_source))
     (testing/nat "publication change invalidates a captured view request" 409 old_view_code)
     (testing/nat "stale publication cannot change the world" 1 (equal[namespace] old_view republished))
     (testing/nat "current selected native publication behavior can refuse the action" 409 denied_code)
     (testing/nat "native publication refusal keeps the whole world" 1 (equal[namespace] denied disabled))]
  + catalogue
    \ page=path name=iota state=namespace
    ^ axal[myth]
    = face=path [state.self 'gov 'flows 'authoring name]
      current (flow_tests/get page state)
    ?> (./ok published) (goo_runtime/published (flow_tests/get face state)) flow_ops/empty
    ?> (./ok lowered) (goo_runtime/matching_view published current) flow_ops/empty
    = query (goo_runtime/request "act" page page face [] state.case(.x page).fall(0)
        state.case(.y page).fall(0) (goo_runtime/publication state) [] 0)
    | author_actions/goo_actions/controls lowered.children [] (goo_runtime/scope .none .none .nil .none .none)
        query published.view.binding
  + query
    \ page=path label=str fields=row[[str str]] state=namespace
    ^ goo_runtime/request
    = name=iota (? (eq label "Publish flow") 'publish_flow 'author_flow)
      controls (flow_reflected_authoring_tests/catalogue page name state).tap.keep((\ [path card] (eq card.txt_at(['title]) label)))
      fallback (goo_runtime/request "act" page page [state.self 'gov 'flows 'authoring name] [] 0 0 0 [] 0)
    ? !(eq controls.len 1) fallback
    = [_ card] controls.at(0)
    ?> query=goo_runtime/request card.pail_at(['goo 'request]) fallback
    = inputs fields.map((\ [key value] [(str/cat_all ["/" key])
        (? (eq card.txt_at([($ts key) 'goo 'input]) "rich_text") (show (goo_text/encode (goo/text/en value))) value)]))
    | query.set_inputs(inputs)
  + invoke
    \ page=path label=str fields=row[[str str]] state=namespace
    ^ [namespace nat str]
    | goo_runtime/act (flow_reflected_authoring_tests/query page label fields state) state
  + preserved
    \ name=path before=namespace after=namespace
    ^ bool
    | row/all[care] (\ care (equal (namespace/page care before.case(care name) name before)
        (namespace/page care before.case(care name) name after))) [.x .y .z]
  + codec_checks
    \ ignored=namespace
    ^ row[testing/check]
    = source=str (str/from_atom (joined 10 [";. /codec" "  ;= Source" "    Plain authored text."]))
      wire (show (goo_text/encode (goo/text/en source)))
      decoded (flow_author_controls/source_input (myth/sing ['source] (pails/t wire)))
      actual=str
        ? decoded
         > (./ok value) value.txt_at(['source])
         > (./err reason) (str/from_atom (quip_val reason))
      trailing (flow_author_controls/source_input (myth/sing ['source] (pails/t (str/cat_all [wire " {}"]))))
      pairs (flow_author_controls/pairs "{""value"":""evidence""}" "binding/")
      bindings=row[[str str]]
        ? pairs
         > (./ok fields) fields
         > (./err _) []
    [(testing/text "source codec retains plain multiline Semidoc" source actual)
     (testing/nat "source codec rejects trailing JSON" 1 (either/is_err trailing))
     (testing/nat "binding codec yields the existing native port field" 1 (equal[row[[str str]]] bindings [["binding/value" "evidence"]]))
     (testing/nat "binding codec rejects trailing JSON" 1 (either/is_err (flow_author_controls/pairs "{} {}" "binding/")))]
  + ownership_checks
    \ state=namespace
    ^ row[testing/check]
    = page=path flow_tests/author
      face=path [state.self 'gov 'flows 'authoring 'author_flow]
      rendered (author_browser/goo_browser/render_result author_bridge/goo_bridge/initial_context page face [] [] [] .none state)
    ?> (./ok value) rendered
      [(testing/nat "authoring input ownership is rendered" 1 0)]
    = controls=row[json]
        ?> (json/arr values) (goo_runtime/json_field "controls" value) []
        values
      source_controls=row[json] (controls.keep((\ item (and (eq (goo_runtime/json_text (goo_runtime/json_field "kind" item)) "input")
        (eq (goo_runtime/json_text (goo_runtime/json_field "slot" item)) "/source")))))
      source_keys=row[str] (source_controls.map((\ item (goo_runtime/json_text (goo_runtime/json_field "inputBinding" item)))))
      action_keys
        \ label=str
        ^ row[str]
        = query (flow_reflected_authoring_tests/query page label [] state)
          route (str/join "." query.control.map(nat/show))
          matching (controls.keep((\ item (eq route (goo_runtime/json_text (goo_runtime/json_field "control" item))))))
        ? !(eq matching.len 1) []
        ?> (json/arr fields) (goo_runtime/json_field "inputBindings" matching.at(0)) []
        | fields.map(goo_runtime/json_text)
      create_keys=row[str] (action_keys "Create Semidoc page")
      save_keys=row[str] (action_keys "Save Semidoc source")
      create_source (create_keys.keep((\ key=str (row/has[str] key source_keys))))
      save_source (save_keys.keep((\ key=str (row/has[str] key source_keys))))
    [(testing/nat "authoring input ownership is rendered" 1 (gt controls.len 0))
     (testing/nat "actual authoring view has four independent source widgets" 4 source_keys.len)
     (testing/nat "actual source widgets retain distinct lexical owners" 1
       (row/all[str] (\ key (and (gt key.len 0) (eq (source_keys.keep((\ other=str (eq key other)))).len 1))) source_keys))
     (testing/nat "create action requests only its own declared fields" 1 (and (eq create_keys.len 2) (eq create_source.len 1)))
     (testing/nat "save action requests a different source binding" 1
       (and (and (eq save_keys.len 1) (eq save_source.len 1)) !(equal[row[str]] save_source create_source)))]
  + authoring_checks
    \ base=namespace
    ^ row[testing/check]
    = home=path flow_tests/author
      page=path [base.self 'app 'nenex 'w 'second]
      face=path [base.self 'gov 'flows 'authoring 'author_flow]
      catalog (flow_reflected_authoring_tests/catalogue home 'author_flow base)
      rendered (author_browser/goo_browser/render_result author_bridge/goo_bridge/initial_context home face [] [] [] .none base)
      source=str (str/from_atom (joined 10 [";. /second" "  ;= Working document" "    An authored working surface."]))
      create_fields=row[[str str]] [["new_name" "second"] ["source" source]]
      create_query (flow_reflected_authoring_tests/query home "Create Semidoc page" create_fields base)
      browser (flow_reflected_authoring_tests/browser create_query)
      [created create_code create_body] (goo_runtime/act create_query base)
      [clicked click_code click_body] (goo_runtime/act browser.fall(create_query.set_control([])) base)
      [collision collision_code collision_body] (flow_reflected_authoring_tests/invoke home "Create Semidoc page" create_fields created)
      [inspected inspect_code inspect_body] (flow_reflected_authoring_tests/invoke page "Inspect callable definitions"
        [["selection_name" "catalog"] ["scope" (path_show (flow_ops/key base.self 'operations))] ["scope_care" "z"]] created)
      [selected select_code select_body] (flow_reflected_authoring_tests/invoke page "Select callable"
        [["selection_name" "copied"] ["mode" "step"] ["definition" (path_show [base.self 'gov 'flows 'operations 'identity])]] inspected)
      selection=path page.weld(['cells 'copied])
    ?> saved=native_work/captured (flow_tests/get selection selected).pail_at(['capture])
      [(testing/text "declared source creation succeeds" "200" (? (eq create_code 200) "200" create_body))
       (testing/text "declared callable inspection succeeds" "200" (? (eq inspect_code 200) "200" inspect_body))
       (testing/text "declared callable selection succeeds" "200" (? (eq select_code 200) "200" select_body))
       (testing/nat "callable selection retains the required native capture" 1 0)]
    = compose_fields=row[[str str]] [["name" "copied"] ["selected_version" (nat/show saved.source.ver)]
        ["selected_definition" (path_show saved.source.path)] ["source" (flow_tests/get page selected).txt_at(['src])]
        ["flow_name" "copy"] ["step_name" "copied"] ["result" "copied"] ["new_inputs" "evidence"]
        ["bindings" "{""value"":""evidence""}"]]
      compose_query (flow_reflected_authoring_tests/query page "Compose selected callable" compose_fields selected)
      [composed compose_code compose_body] (goo_runtime/act compose_query selected)
      [stale stale_code stale_body] (goo_runtime/act compose_query composed)
      [published publish_code publish_body] (flow_reflected_authoring_tests/invoke page "Publish flow" [["id" "copy"]] composed)
      source (flow_tests/get page published).txt_at(['src])
      edit_query (flow_reflected_authoring_tests/query page "Save Semidoc source" [["source" (str/from_atom (joined 10 [source "  ;= Notes" "    Retained authored bindings."]))]] published)
      [edited edit_code edit_body] (goo_runtime/act edit_query published)
      [old_edit old_edit_code old_edit_body] (goo_runtime/act edit_query edited)
      [republished republish_code republish_body] (flow_reflected_authoring_tests/invoke page "Publish flow" [["id" "copy"]] edited)
      imported (flow_tests/apply 'import_source flow_tests/input_path flow_tests/source_record republished)
      [published_home home_code home_body] (flow_reflected_authoring_tests/invoke home "Publish flow" [["id" "handbook"]] imported)
      [chosen chosen_code chosen_body] (flow_reflected_authoring_tests/invoke page "Select published flow"
        [["occurrence_name" "maintained"] ["definition" (path_show flow_tests/definition)]] published_home)
    ?> retained=native_work/captured (flow_tests/get page.weld(['cells 'maintained]) chosen).pail_at(['capture])
      [(testing/text "declared composition succeeds" "200" (? (eq compose_code 200) "200" compose_body))
       (testing/text "declared flow selection succeeds" "200" (? (eq chosen_code 200) "200" chosen_body))
       (testing/nat "flow selection retains the required native capture" 1 0)]
    = bindings (show (json/obj [(jkv "sources" (json/str (path_show (flow_tests/input_path).take(3))))]))
      embed_fields=row[[str str]] [["name" "maintained"] ["selected_version" (nat/show retained.source.ver)]
        ["selected_definition" (path_show retained.source.path)] ["source" (flow_tests/get page chosen).txt_at(['src])]
        ["destination" (path_show flow_tests/destination)] ["writer" (path_show (flow_ops/key base.self 'nenex))]
        ["provider" ""] ["bindings" bindings]]
      [embedded embed_code embed_body] (flow_reflected_authoring_tests/invoke page "Embed selected flow" embed_fields chosen)
      controller=path page.weld(['work 'maintained])
      [paused pause_code pause_body] (flow_reflected_authoring_tests/invoke page "Pause occurrence" [["controller" (path_show controller)]] embedded)
      [resumed resume_code resume_body] (flow_reflected_authoring_tests/invoke page "Resume occurrence" [["controller" (path_show controller)]] paused)
      [detached detach_code detach_body] (flow_reflected_authoring_tests/invoke page "Detach occurrence" [["controller" (path_show controller)]] resumed)
      [opened open_code open_body] (flow_reflected_authoring_tests/invoke page "Open investigation"
        [["id" "research"] ["content" "Inspect the source and retain missing evidence."] ["context" "{}"]] detached)
      [asked ask_code ask_body] (flow_reflected_authoring_tests/invoke page "Retain unresolved question"
        [["id" "missing"] ["content" "Does this source have the required evidence?"] ["shape" "Source record"]
         ["context" (path_show flow_tests/input_path)] ["resume" (path_show page.weld(['work 'research]))]] opened)
      duplicate (flow_author_controls/pairs "{""value"":""one"",""value"":""two""}" "binding/")
      styled_runs=goo/text [(goo/runt (myth/sing ['sys 'font] (pails/p ['sys 'font 'mono])) (goo/lang/en ";. /styled"))]
      styled (flow_author_controls/source_input (myth/sing ['source] (pails/t (show (goo_text/encode styled_runs)))))
      extra (flow_author_controls/ports [["binding/value" "evidence"] ["binding/unused" "evidence"]] ['value] "binding/")
    [(testing/nat "authoring view renders through the existing Goo host" 1 (either/is_ok rendered))
     (testing/nat "all declared authoring actions are reflected" 19 catalog.wyt)
     (testing/text "declared source creation succeeds" "200" (? (eq create_code 200) "200" create_body))
     (testing/nat "browser creation and headless creation are identical" 1 (and (eq click_code 200) (equal[namespace] clicked created)))
     (testing/nat "creation cannot overwrite an existing page" 409 collision_code)
     (testing/nat "refused creation preserves the entire world" 1 (equal[namespace] collision created))
     (testing/nat "declared inspection makes a native callable cell" 1 (flow_tests/get page.weld(['cells 'catalog]) inspected).has(['flow 'callable_catalog]))
     (testing/text "declared composition succeeds" "200" (? (eq compose_code 200) "200" compose_body))
     (testing/nat "stale composition is rejected" 409 stale_code)
     (testing/nat "stale composition cannot change the world" 1 (equal[namespace] stale composed))
     (testing/text "composed procedure publishes" "200" (? (eq publish_code 200) "200" publish_body))
     (testing/text "declared source edit succeeds" "200" (? (eq edit_code 200) "200" edit_body))
     (testing/nat "stale source edit is rejected" 409 old_edit_code)
     (testing/nat "stale source edit cannot change the world" 1 (equal[namespace] old_edit edited))
     (testing/nat "source edit preserves retained callable capture" 1 (equal[myth] (flow_tests/get selection selected) (flow_tests/get selection edited)))
     (testing/text "edited authored bindings still publish" "200" (? (eq republish_code 200) "200" republish_body))
     (testing/nat "publication preserves original authored definition history" 1 (flow_reflected_authoring_tests/preserved page.weld(['flows 'copy]) published republished))
     (testing/text "declared flow selection succeeds" "200" (? (eq chosen_code 200) "200" chosen_body))
     (testing/text "declared embedding starts the shared maintenance hand" "200" (? (eq embed_code 200) "200" embed_body))
     (testing/nat "embedded hand publishes the ordinary Nenex document" 1 (flow_tests/get flow_tests/destination embedded).has(['src]))
     (testing/nat "embedded occurrence retains native controller" 1 (flow_tests/get controller embedded).has(['flow 'config]))
     (testing/text "declared pause succeeds" "200" (? (eq pause_code 200) "200" pause_body))
     (testing/text "declared resume succeeds" "200" (? (eq resume_code 200) "200" resume_body))
     (testing/text "declared detach succeeds" "200" (? (eq detach_code 200) "200" detach_body))
     (testing/nat "detach retains prior x y z work history" 1 (flow_reflected_authoring_tests/preserved controller embedded detached))
     (testing/text "declared investigation opens native work" "200" (? (eq open_code 200) "200" open_body))
     (testing/text "declared question creates persistent native hole" "200" (? (eq ask_code 200) "200" ask_body))
     (testing/nat "question is retained under the working document" 1 (flow_tests/get page.weld(['holes 'missing]) asked).has(['work 'hole]))
     (testing/nat "source formatting is refused without silently dropping metadata" 1 (either/is_err styled))
     (testing/nat "duplicate JSON bindings are refused before dispatch" 1 (either/is_err duplicate))
     (testing/nat "unknown port bindings cannot disappear silently" 0 extra)
     (testing/nat "all four Semidoc controls retain a reflected source field" 4 (catalog.tap.keep((\ [relative card] card.has(['source 'goo 'input])))).len)
     (testing/nat "Semidoc fields use the existing multiline native editor" 1
       (catalog.tap.all((\ [relative card] (? (card.has(['source 'goo 'input])) (eq card.txt_at(['source 'goo 'input]) "rich_text") .true)))))
     (testing/nat "all prior page x y z history remains" 1 (flow_reflected_authoring_tests/preserved page created asked))]
  + source_controls
    \ base=namespace
    ^ row[testing/check]
    = page=path flow_tests/author
      mount=path [base.self 'io 'fs 'control_files]
      root=path mount.snoc('source)
      file=path root.snoc(($ta "data.json"))
      report (fs/cfg "fixture" root (fs/extensions (mop/empty)) [base.self 'kook 'fs]).del(limb_slot).put(bond/res (fs/report 0 root ["data.json"] []))
      state (flow_tests/poke mount report base)
      state (flow_tests/poke file (myth/sing bond/content (pails/n (add (str/to_atom "{}") (bex 16)))) state)
      [bound code body] (flow_reflected_authoring_tests/invoke page "Bind filesystem evidence"
        [["source_name" "data"] ["source_file" (path_show file)] ["source_mount" (path_show mount)] ["source_format" "json"]] state)
      feed=path page.weld(['inputs 'data_file])
      [inspected inspect_code inspect_body] (flow_reflected_authoring_tests/invoke page "Inspect callable definitions"
        [["selection_name" "own_record"] ["scope" (path_show file)] ["scope_care" "x"]] bound)
      capture=maybe[native_work/captured]
        ?> held=native_work/captured (flow_tests/get page.weld(['cells 'own_record]) inspected).pail_at(['capture]) .none
        | ./some held
      exact=bool
        ?> (./some held) capture .false
        | and (equal[care] held.source.care .x) (eq (unpin held.value).wyt 1)
    | [(testing/text "declared filesystem binding accepts explicit JSON format" "200" (? (eq code 200) "200" body))
       (testing/text "Goo forwards source format to the native source hand" "json" (flow_tests/get feed bound).txt_at(['flow 'source_format]))
       (testing/text "declared own-record inspection succeeds" "200" (? (eq inspect_code 200) "200" inspect_body))
       (testing/nat "Goo inspection retains exact own-record care" 1 exact)]
  + report
    \ state=namespace
    ^ row[[str bool str str]]
    | ((flow_reflected_authoring_tests/checks state).weld((flow_reflected_authoring_tests/codec_checks state)).weld((flow_reflected_authoring_tests/ownership_checks state)).weld((flow_reflected_authoring_tests/authoring_checks state)).weld((flow_reflected_authoring_tests/source_controls state))).map((\ check [check.name check.pass check.want check.got]))
