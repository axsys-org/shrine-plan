- flows_mount
- testing
- tests/flows [at=fixture]

+ raw_sources
  + mount
    ^ path
    [($x 17) 'io 'fs 'raw]
  + source
    ^ path
    | (raw_sources/mount).weld(['source ($ta "readme.md")])
  + feed
    ^ path
    [($x 17) 'user 'raw_sources]
  + bytes
    \ text=str
    ^ nat
    | add (str/to_atom text) (bex (mul 8 text.len))
  + get
    \ state=namespace
    ^ axal[myth]
    | sovereign_care .z (row/cons[iota] 'x raw_sources/feed) state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = root=path (raw_sources/mount).snoc('source)
      report (fs/cfg "fixture" root (fs/extensions (mop/empty)) [($x 17) 'kook 'fs]).del(limb_slot).put(bond/res (fs/report 0 root ["readme.md"] []))
      content (str/from_atom (joined 10 ["# Source" "" "Introduction." "" "## Details" "" "First." "" "## Details" "" "Second."]))
      seed (fixture/flow_tests/poke raw_sources/source (myth/sing bond/content (pails/n (raw_sources/bytes content))) fixture/flow_tests/prepared)
      seed (fixture/flow_tests/poke raw_sources/mount report seed)
      request (myth/sing ['mount] (pails/p raw_sources/mount)).put(['source] (safe 0 .x raw_sources/source)).put(['name] (pails/p ['readme])).put(['format] (pails/t "md"))
      attached (fixture/flow_tests/apply 'watch_sources raw_sources/feed request seed)
      follow (fixture/flow_tests/follow_request).put(['input 'sources] (safe 0 .z (row/cons[iota] 'x raw_sources/feed)))
      state (fixture/flow_tests/apply 'follow fixture/flow_tests/controller follow attached)
      reason=str
        ?> (./some failure) (fixture/flow_tests/progress state).reason "none"
        | str/from_atom (quip_val failure)
      source (raw_sources/get state).get(['readme]).fall(myth/new)
      missing (fixture/flow_tests/poke raw_sources/mount (myth/sing bond/res (fs/report 0 root ["readme.md"] ["readme.md"])) state)
      restored (fixture/flow_tests/poke raw_sources/mount report missing)
      changed (fixture/flow_tests/poke raw_sources/source (myth/sing bond/content (pails/n (raw_sources/bytes content.cat((str/from_atom (joined 10 ["" "" "Updated content."])))))) restored)
      detached (fixture/flow_tests/apply 'unwatch_sources raw_sources/feed (myth/sing ['expected] (pails/n restored.case(.x raw_sources/feed).fall(0))) restored)
      reattached (fixture/flow_tests/apply 'watch_sources raw_sources/feed request.put(['expected] (pails/n detached.case(.x raw_sources/feed).fall(0))) detached)
      captured=flow_maintenance/feed
        ?> value=flow_maintenance/feed (fixture/flow_tests/get raw_sources/feed missing).pail_at(['flow 'feed]) (flow_maintenance/feed (safe 0 .x []) (pin flow_ops/empty) .none)
        value
      origin=safe
        ?> value=safe source.pail_at(['flow 'origin]) (safe 0 .x [])
        value
      frozen (state.page(.x (./some origin.ver) origin.path))
      inventory (flow_operations/inventory ((flow_ops/empty).rep(['sources] (raw_sources/get state))))
      output=axal[myth]
        ?> (./ok definition) (flow_ops/compile 'handbook (safe 1 .x fixture/flow_tests/author) (fixture/flow_tests/book_source "Raw source outline") state) flow_ops/empty
        = inputs (axal/new[axal[myth]] .none).put(['sources] (raw_sources/get state))
        ?> (./ok evaluation) (flow_ops/evaluate definition inputs) flow_ops/empty
        | unpin evaluation.result
      rebound (fixture/flow_tests/apply 'watch_sources raw_sources/feed request.put(['name] (pails/p ['renamed])).put(['expected] (pails/n state.case(.x raw_sources/feed).fall(0))) state)
      history (row/all[care] (\ car (equal (state.page(car state.case(car raw_sources/feed) raw_sources/feed)) (reattached.page(car state.case(car raw_sources/feed) raw_sources/feed)))) [.x .y .z])
    [(testing/text "raw filesystem watch admitted" "ok" (fixture/flow_tests/reason (flow_sources_ops/watch raw_sources/feed request seed)))
     (testing/nat "raw file becomes ordinary native source" 1 source.has(['flow 'source]))
     (testing/nat "source origin is exact retained file case" 1 (and (gt origin.ver 0) (equal frozen (state.page(.x state.case(.x raw_sources/source) raw_sources/source)))))
     (testing/nat "raw source accepted by existing inventory" 0 (either/is_err inventory))
     (testing/nat "authored composition uses raw source through existing operations" 1 output.has(['reference 'readme]))
     (testing/nat "repeated headings remain separate documents" 1 output.has(['reference 'readme 'section_details_2]))
     (testing/text "initial source flow has no maintenance failure" "none" reason)
     (testing/nat "same native maintenance hand publishes source flow" 1 (fixture/flow_tests/progress state).generation)
     (testing/nat "file removal cannot publish retained bytes" (fixture/flow_tests/progress state).generation (fixture/flow_tests/progress missing).generation)
     (testing/nat "changed file resumes native maintenance" 1 (gt (fixture/flow_tests/progress changed).generation (fixture/flow_tests/progress state).generation))
     (testing/nat "missing file not current evidence" 0 (raw_sources/get missing).wyt)
     (testing/nat "missing file retains last capture" 1 (unpin captured.value).has(['readme]))
     (testing/nat "restoration reuses retained exact source" 1 (equal (raw_sources/get state) (raw_sources/get restored)))
     (testing/nat "detach hides retained source" 0 (raw_sources/get detached).wyt)
     (testing/nat "reattach restores source" 1 (equal (raw_sources/get state) (raw_sources/get reattached)))
     (testing/nat "rebinding source name replaces current view" 1 (raw_sources/get rebound).has(['renamed]))
     (testing/nat "rebinding removes old current name" 0 (raw_sources/get rebound).has(['readme]))
     (testing/nat "all x/y/z history survives" 1 history)]

  + ui
    \ ignored=unit
    ^ row[testing/check]
    = root=path (raw_sources/mount).snoc('source)
      report (fs/cfg "fixture" root (fs/extensions (mop/empty)) [($x 17) 'kook 'fs]).del(limb_slot).put(bond/res (fs/report 0 root ["readme.md"] []))
      seed (fixture/flow_tests/poke raw_sources/source (myth/sing bond/content (pails/n (raw_sources/bytes "# Source"))) fixture/flow_tests/prepared)
      seed (fixture/flow_tests/poke raw_sources/mount report seed)
      page=path fixture/flow_tests/author
      fields=row[[str str]] [["action" "bind_file"] ["page" (path_show page)] ["source_name" "readme"] ["source_file" (path_show raw_sources/source)] ["source_mount" (path_show raw_sources/mount)]]
      [state index reply] (helm/supervisor/admit (flow_ui/plan fields) seed (sovereign_hive seed))
      accepted=bool
        ?> (./ack refusal) reply .false
        | maybe/is_none refusal
      feed=path page.weld(['inputs 'readme_file])
      settings=myth (fixture/flow_tests/get page.weld(['flows 'defaults]) state)
      binding=safe (safe 0 .z (row/cons[iota] 'x feed))
    [(testing/nat "Nenex file form admits through the shared namespace boundary" 1 accepted)
     (testing/nat "Nenex form binds the authored sources input to the source cell" 1 (equal[pail] settings.pail_at(['input 'sources]) binding))
     (testing/nat "Nenex form uses the existing watch owner and raw evidence cell" 1
       (and (equal[maybe[path]] (flow_sources_ops/mount_of (fixture/flow_tests/get feed state)) (./some raw_sources/mount))
            (sovereign_care .z (row/cons[iota] 'x feed) state).has(['readme])))]

+ tests
  ^ row[testing/case]
  [(testing/case "Raw filesystem evidence uses existing source hand" raw_sources/checks)
   (testing/case "Nenex raw source binding" raw_sources/ui)]
