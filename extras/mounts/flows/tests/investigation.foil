- flow_occurrence_tests

+ flow_investigation_tests
  + run
    ^ path
    | (flow_tests/author).weld(['work 'research])
  + target
    ^ path
    [($x 17) 'app 'nenex 'w 'research_flow]
  + artifact
    ^ path
    [($x 17) 'user 'research_output]
  + page
    \ title=nat
    ^ myth
    | myth/sing ['flow 'page] (flow/page title [(snode/prose "Evidence from this binding." [])] [])
  + cooperate
    \ operation=iota target=path input=myth state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (namespace_command/plan target (cooperate_ops/key state.self operation) input) state (sovereign_hive state))
    next
  + initial
    ^ namespace
    = state flow_tests/prepared
      state (flow_tests/poke flow_investigation_tests/artifact (flow_investigation_tests/page "Recorded investigation result") state)
      input (myth/sing ['id] (pails/t "research")).put(['content] (pails/t "Investigate how to explain the selected evidence."))
      state (flow_investigation_tests/cooperate 'open flow_tests/author input state)
      observed (myth/sing ['id] (pails/t "observe")).put(['kind] (pails/t "observation")).put(['content] (pails/t "Read the source."))
      observed observed.put(['context 'source] (safe 0 .x flow_tests/input_path))
      state (flow_investigation_tests/cooperate 'append flow_investigation_tests/run observed state)
      result (myth/sing ['id] (pails/t "result")).put(['kind] (pails/t "tool-result")).put(['content] (pails/t "Computed an explanatory page."))
      result result.put(['artifact] (safe 0 .x flow_investigation_tests/artifact))
      state (flow_investigation_tests/cooperate 'append flow_investigation_tests/run result state)
      decision (myth/sing ['id] (pails/t "decision")).put(['kind] (pails/t "message")).put(['content] (pails/t "Reuse the structure, but select different evidence explicitly."))
    | flow_investigation_tests/cooperate 'append flow_investigation_tests/run decision state
  + fields
    ^ row[[str str]]
    | [["action" "extract_trace"] ["page" (path_show flow_tests/author)]
       ["run" (path_show flow_investigation_tests/run)] ["sequence" "3"]
       ["events" "decision result"] ["new_name" "research"]]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = before flow_investigation_tests/initial
      page flow_investigation_tests/target
      fields flow_investigation_tests/fields
      plan (flow_tests/plan fields before)
    ? (either/is_err plan) [(testing/text "investigation form drafts through native admission" "ok" (flow_tests/reason plan))]
    = after (flow_ui_tests/act fields before)
      source (flow_tests/get page after).txt_at(['src])
      provenance=path page.weld(['cells 'trace 'evidence_1])
      example=path page.weld(['cells 'inputs 'evidence_1])
      hole=path page.weld(['holes 'extraction])
      review=row[[str str]] [["action" "review_trace"] ["page" (path_show page)] ["source" source]]
      publish=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "research"]]
      changed (flow_tests/poke flow_investigation_tests/artifact (flow_investigation_tests/page "Changed original artifact") after)
      original (sovereign_care .z (row/cons[iota] 'x example) changed).fil.fall(myth/new)
      stale (flow_tests/plan (flow_occurrence_tests/replace "sequence" "2" fields) before)
      duplicate (flow_tests/plan (flow_occurrence_tests/replace "events" "result result" fields) before)
      missing (flow_tests/plan (flow_occurrence_tests/replace "events" "missing" fields) before)
      outside (flow_tests/plan (flow_occurrence_tests/replace "run" "/0x11/user/other" fields) before)
    ?> saved=native_work/captured (flow_tests/get provenance after).pail_at(['capture])
      [(testing/text "selected trace is retained" "capture" "missing")]
    [(testing/text "extracted draft has a discoverable page title" "research" (flow_tests/get page after).txt_at(system_vocabulary/lede))
     (testing/nat "draft contains an authored flow region" 1 (cord/has "/flow/definition research" (str/to_atom source)))
     (testing/nat "canonical trace order overrides selection order" 1 (equal[path] saved.source.path (flow_investigation_tests/run).weld(['trace 'result])))
     (testing/nat "trace capture has an exact retained subtree case" 1 (gt saved.source.ver 0))
     (testing/nat "recorded artifact survives changes at original path" 1 (equal[pail] original.pail_at(['flow 'page]) (flow_investigation_tests/page "Recorded investigation result").pail_at(['flow 'page])))
     (testing/nat "selected note stays inert prose" 1 (cord/has "Reuse the structure" (str/to_atom source)))
     (testing/nat "selection excludes unselected event" 0 (cord/has "Read the source." (str/to_atom source)))
     (testing/nat "draft has no guessed executable step" 0 (cord/has "/flow/step" (str/to_atom source)))
     (testing/nat "uncomposed draft refuses publication" 1 (either/is_err (flow_tests/plan publish after)))
     (testing/nat "uncomposed draft cannot resolve authoring hole" 1 (either/is_err (flow_tests/plan review after)))
     (testing/nat "authoring uses existing native hole" 1 (flow_tests/get hole after).has(['work 'hole]))
     (testing/text "obsolete trace selection refuses" "flow_stale_trace" (flow_tests/reason stale))
     (testing/nat "duplicate selection refuses" 1 (either/is_err duplicate))
     (testing/nat "unknown selection refuses" 1 (either/is_err missing))
     (testing/nat "foreign page work refuses" 1 (either/is_err outside))
     (testing/text "existing draft never overwritten" "flow_extraction_page_exists" (flow_tests/reason (flow_tests/plan fields after)))
     (testing/nat "investigation and all x/y/z history remain" 1 (row/all[care] (flow_occurrence_tests/history flow_investigation_tests/run before changed) [.x .y .z]))]
  + rerun
    \ ignored=unit
    ^ row[testing/check]
    = before flow_investigation_tests/initial
      page flow_investigation_tests/target
      drafted (flow_ui_tests/act flow_investigation_tests/fields before)
      choose=row[[str str]] [["action" "select_step"] ["page" (path_show page)] ["selection_name" "identity"] ["mode" "step"]
        ["definition" (path_show (flow_ops/key drafted.self 'operations).snoc('identity))]]
      selected (flow_ui_tests/act choose drafted)
    ?> saved=native_work/captured (flow_tests/get page.weld(['cells 'identity]) selected).pail_at(['capture])
      [(testing/text "draft selects existing operation" "capture" "missing")]
    = compose=row[[str str]] [["action" "compose"] ["page" (path_show page)] ["name" "identity"] ["flow_name" "research"]
        ["step_name" "explain"] ["result" "explain"] ["new_inputs" ""] ["binding/value" "evidence_1"]
        ["source" (flow_tests/get page selected).txt_at(['src])]
        ["selected_version" (nat/show saved.source.ver)] ["selected_definition" (path_show saved.source.path)]]
      composed (flow_ui_tests/act compose selected)
      source (flow_tests/get page composed).txt_at(['src])
      review=row[[str str]] [["action" "review_trace"] ["page" (path_show page)] ["source" source]]
      reviewed (flow_ui_tests/act review composed)
      publish=row[[str str]] [["action" "publish"] ["page" (path_show page)] ["name" "research"]]
      published (flow_ui_tests/act publish reviewed)
      definition=path page.weld(['flows 'research])
    ?> compiled=flow/definition (flow_tests/get definition published).pail_at((flow_ops/key published.self 'definition))
      [(testing/text "composed draft publishes" "ok" (flow_tests/reason (flow_tests/plan compose selected)))]
    = host=path flow_tests/author
      choose=row[[str str]] [["action" "select"] ["page" (path_show host)] ["occurrence_name" "from_trace"] ["definition" (path_show definition)]]
      chosen (flow_ui_tests/act choose published)
    ?> selected=native_work/captured (flow_tests/get host.weld(['cells 'from_trace]) chosen).pail_at(['capture])
      [(testing/text "published draft embeds in another document" "capture" "missing")]
    = new_input=path [chosen.self 'user 'fresh_evidence]
      ready (flow_tests/poke new_input (flow_investigation_tests/page "A different evidence binding") chosen)
      output=path [chosen.self 'app 'nenex 'w 'research_result]
      embed=row[[str str]] [["action" "embed"] ["page" (path_show host)] ["name" "from_trace"]
        ["source" (flow_tests/get host ready).txt_at(['src])] ["selected_version" (nat/show selected.source.ver)]
        ["selected_definition" (path_show definition)] ["destination" (path_show output)] ["writer" (path_show (flow_ops/key ready.self 'nenex))]
        ["provider" ""] ["input/evidence_1" (path_show new_input)]
        ["input/evidence_2" (path_show (row/cons[iota] 'x page.weld(['cells 'inputs 'evidence_2])))]]
      done (flow_ui_tests/act embed ready)
      controller=path host.weld(['work 'from_trace])
      old_run=path controller.weld(['work ($u 1)])
      changed (flow_tests/poke new_input (flow_investigation_tests/page "Changed evidence resumes this flow") done)
      updated_source (str/cat_all [source "\n  ;= Clarified explanation\n    An explicit authoring change.\n"])
      edit (myth/sing ['source] (pails/t updated_source)).put(['expected] (pails/n changed.case(.x page).fall(0)))
      edited (flow_tests/apply 'author page edit changed)
      hole=path page.weld(['holes 'extraction])
      obsolete (myth/sing ['id] (pails/t "research")).put(['expected] (pails/n changed.case(.x page).fall(0)))
      [refused index reply] (helm/supervisor/admit
        (namespace_command/plan page (flow_ops/key edited.self 'publish) obsolete) edited (sovereign_hive edited))
      rejected=bool
        ?> (./ack failure) reply .false
        | maybe/is_some failure
    [(testing/nat "explicit composition binds chosen captured operation" 1 (equal[safe] saved.source compiled.steps.at(0).origin))
     (testing/text "explicit review resolves native authoring hole" "resolved" (flow_tests/get hole reviewed).txt_at(['work 'status]))
     (testing/nat "review does not publish implicitly" 0 (flow_tests/get definition reviewed).has((flow_ops/key reviewed.self 'definition)))
     (testing/nat "shared hand publishes result from different evidence" 1 (cord/has "A different evidence binding" (str/to_atom (flow_tests/get output done).txt_at(['src]))))
     (testing/nat "changed evidence reruns shared hand" 1 (cord/has "Changed evidence resumes this flow" (str/to_atom (flow_tests/get output changed).txt_at(['src]))))
     (testing/nat "earlier shared hand attempt is retained" 1 (and (gt (flow_tests/get old_run done).tap.len 0) (equal[myth] (flow_tests/get old_run done) (flow_tests/get old_run changed))))
     (testing/nat "source edit reopens authoring demand" 1 !(eq "resolved" (flow_tests/get hole edited).txt_at(['work 'status])))
     (testing/nat "stale review refuses" 1 (either/is_err (flow_tests/plan review edited)))
     (testing/nat "native publication rejects obsolete source case" 1 rejected)
     (testing/nat "rejected stale publication leaves the entire world unchanged" 1 (equal[namespace] edited refused))
     (testing/nat "published definition retains old authored source" 1 (equal[myth] (flow_tests/get definition changed) (flow_tests/get definition edited)))
     (testing/nat "original selected trace and x/y/z survive reuse" 1 (row/all[care] (flow_occurrence_tests/history flow_investigation_tests/run before edited) [.x .y .z]))]
  + agent_trace
    \ ignored=unit
    ^ row[testing/check]
    = before flow_investigation_tests/initial
      owner flow_investigation_tests/run
      worker=path owner.weld(['workers 'agent])
      first=path worker.weld(['trace 'effect_1])
      second=path worker.weld(['trace 'effect_2])
      opened (native_work_ops/open owner "model" myth/new)
      read_task (native_work_ops/status "complete" (native_work_ops/open worker "tool-call"
        (myth/sing ['codex 'reply_result] (pails/t "Captured source result"))))
      read (native_work_ops/event_record worker "tool-call" opened read_task)
      advanced (native_work_ops/append first opened)
      act_task (native_work_ops/status "complete" (native_work_ops/open worker "tool-call"
        (myth/sing ['codex 'reply_result] (pails/t "Native action receipt"))))
      act (native_work_ops/event_record worker "tool-call" advanced act_task)
      completed (native_work_ops/status "complete" (native_work_ops/append second advanced))
      recorded (flow_tests/poke second act (flow_tests/poke first read (flow_tests/poke worker completed before)))
      page flow_tests/author
      fields=row[[str str]] [["action" "extract_trace"] ["page" (path_show page)]
        ["run" (path_show worker)] ["sequence" "2"] ["events" "effect_2 effect_1"] ["new_name" "agent_trace"]]
      drafted (flow_ui_tests/act fields recorded)
      target=path [recorded.self 'app 'nenex 'w 'agent_trace_flow]
      source (flow_tests/get target drafted).txt_at(['src])
      example (flow_tests/get target.weld(['cells 'inputs 'evidence_1]) drafted)
      provenance (flow_tests/get target.weld(['cells 'trace 'evidence_1]) drafted)
      old (flow_tests/get first recorded)
      pending (flow_tests/poke second (native_work_ops/event_record worker "tool-call" advanced
        (native_work_ops/open worker "tool-call" myth/new)) recorded)
      failed (flow_tests/poke second (native_work_ops/event_record worker "tool-call" advanced
        (native_work_ops/status "failed" (native_work_ops/open worker "tool-call" myth/new))) recorded)
    ?> saved=native_work/captured example.pail_at(['capture])
      [(testing/text "worker event captured" "capture" "missing")]
    ?> origin=native_work/captured provenance.pail_at(['capture])
      [(testing/text "worker provenance captured" "capture" "missing")]
    | [
       (testing/nat "worker extraction keeps canonical order" 1 (equal[path] origin.source.path first))
       (testing/nat "tool result remains captured evidence" 1 (unpin saved.value).fil.fall(myth/new).has(['codex 'reply_result]))
       (testing/nat "draft does not replay a tool call" 0 (cord/has "/flow/step" (str/to_atom source)))
       (testing/text "obsolete worker sequence refuses" "flow_stale_trace"
         (flow_tests/reason (flow_tests/plan (flow_occurrence_tests/replace "sequence" "1" fields) recorded)))
       (testing/text "pending model tool call refuses extraction" "flow_extraction_unsettled_event"
         (flow_tests/reason (flow_tests/plan fields pending)))
       (testing/text "failed model tool call remains extractable evidence" "ok"
         (flow_tests/reason (flow_tests/plan fields failed)))
       (testing/nat "original worker event remains unchanged" 1 (equal[myth] old (flow_tests/get first drafted)))
       (testing/nat "worker x/y/z history survives draft" 1 (row/all[care] (flow_occurrence_tests/history worker recorded drafted) [.x .y .z]))]

+ tests
  ^ row[testing/case]
  [(testing/case "Investigation selections become retained Semidoc drafts" flow_investigation_tests/checks)
   (testing/case "Authored investigation draft reuses native flow lifecycle" flow_investigation_tests/rerun)
   (testing/case "Agent tool traces become inert authored evidence" flow_investigation_tests/agent_trace)]
