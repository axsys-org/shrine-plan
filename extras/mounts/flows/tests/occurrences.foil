- flow_ui_tests
- flow_composition_editing_tests

' An occurrence is selected and attached through the same native plans used
' by the Nenex forms. Its work stays named beneath the containing document.
+ flow_occurrence_tests
  + page
    ^ path
    | flow_composition_editing_tests/author
  + select_fields
    \ name=str
    ^ row[[str str]]
    | [["action" "select"] ["page" (path_show flow_occurrence_tests/page)]
       ["occurrence_name" name] ["definition" (path_show flow_tests/definition)]]
  + embed_fields
    \ name=iota destination=path sources=path state=namespace
    ^ row[[str str]]
    = page=path flow_occurrence_tests/page
      cell=path page.weld(['cells name])
    ?> saved=native_work/captured (flow_tests/get cell state).pail_at(['capture]) []
    | [["action" "embed"] ["page" (path_show page)] ["name" (str/from_atom (quip_val name))]
       ["source" (flow_tests/get page state).txt_at(['src])]
       ["selected_version" (nat/show saved.source.ver)] ["selected_definition" (path_show saved.source.path)]
       ["destination" (path_show destination)] ["writer" (path_show (flow_ops/key state.self 'nenex))]
       ["provider" ""] ["input/sources" (path_show sources)]]
  + replacement
    \ key=str value=str pair=[str str]
    ^ [str str]
    = [name old] pair
    ? (eq name key) [key value]
    pair
  + replace
    \ key=str value=str fields=row[[str str]]
    ^ row[[str str]]
    | fields.map((flow_occurrence_tests/replacement key value))
  + html
    \ card=myth
    ^ nat
    = views=mop[path axal[myth] lt_pith] (mop/empty)
      views views.put(['view] (axal/new[myth] (./some card)))
      b (bowl [] ['request] 0 0 (axal/new[myth] .none) views)
    | (frag/talk b myth/new myth/new).out.nat_at(['res_body] 0)
  + admitted
    \ reply=feet/task[unit]
    ^ bool
    ?> (./ack why) reply .false
    | maybe/is_none why
  + projection
    \ target=path state=namespace
    ^ nat
    = op=path (flow_ops/key state.self 'occurrence_view)
      prefix=path ['o ($u 1) ($u op.len)]
      at=path prefix.weld(op).snoc(($u target.len)).weld(target)
    | flow_occurrence_tests/html (sovereign_care .z at state).fil.fall(myth/new)
  + history
    \ target=path before=namespace after=namespace car=care
    ^ bool
    | equal[res[axal[saga]]] (namespace/page car before.case(car target) target before) (namespace/page car before.case(car target) target after)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = page=path flow_occurrence_tests/page
      source=str (flow_composition_editing_tests/source "alpha" "beta")
      authored=namespace (flow_tests/apply 'author page (myth/sing ['source] (pails/t source)) flow_tests/prepared)
      selected=namespace (flow_ui_tests/act (flow_occurrence_tests/select_fields "first") authored)
      selected=namespace (flow_ui_tests/act (flow_occurrence_tests/select_fields "second") selected)
      first_cell=path page.weld(['cells 'first])
      second_cell=path page.weld(['cells 'second])
      first=path page.weld(['work 'first])
      second=path page.weld(['work 'second])
      input=path [($x 17) 'user 'flow_sources]
      other_input=path [($x 17) 'user 'other_sources]
      other_output=path [($x 17) 'app 'nenex 'w 'other_output]
      selected=namespace (flow_tests/apply 'import_source other_input.snoc('readme) flow_tests/source_record selected)
      selected=namespace (flow_tests/poke other_input.snoc('readme) (myth/sing ['flow 'source] (flow/source "other.md" (str/repeat 64 "b") "md" "Distinct second evidence")) selected)
      fields=row[[str str]] (flow_occurrence_tests/embed_fields 'first flow_tests/destination input selected)
      planned=either[iota row[[p=path q=writ]]] (flow_ui/plan fields selected)
    ? (either/is_err planned)
      [(testing/text "first occurrence admits through Nenex native form" "ok" (flow_tests/reason planned))]
    = embedded=namespace (flow_ui_tests/act fields selected)
      other_fields=row[[str str]] (flow_occurrence_tests/embed_fields 'second other_output other_input embedded)
      planned=either[iota row[[p=path q=writ]]] (flow_ui/plan other_fields embedded)
    ? (either/is_err planned)
      [(testing/text "second occurrence admits independently" "ok" (flow_tests/reason planned))]
    = both=namespace (flow_ui_tests/act other_fields embedded)
      block=path page.weld([($u 0) ($u 2)])
      before=myth (flow_tests/get block authored)
      after=myth (flow_tests/get block both)
      edited_source=str (str/cat_all [(flow_tests/get page both).txt_at(['src]) (str/from_atom (joined 10 ["" "  ;= Source-side note" "    An authored note beside running work."]))])
      source_edit=myth (myth/sing ['src] (pails/t edited_source)).put(['epoch] (pails/t (nat/show both.local.top)))
      [source_saved source_index source_reply] (helm/supervisor/admit (nenex_edit/source page source_edit) both (sovereign_hive both))
      goo=namespace (flow_tests/edit "save" block "An embedded procedure beside authored relationships" source_saved)
      detached=namespace (flow_tests/apply 'detach first myth/new goo)
      removal=myth (myth/sing ['src] (pails/t source)).put(['epoch] (pails/t (nat/show detached.local.top)))
      [removed removed_index removed_reply] (helm/supervisor/admit (nenex_edit/source page removal) detached (sovereign_hive detached))
      html=nat (flow_occurrence_tests/projection first both)
      detached_html=nat (flow_occurrence_tests/projection first detached)
      tools=nat (weft/render (weft/el "div" [] (flow_ui/render page (sovereign_peek page selected))))
      stale_source=row[[str str]] (flow_occurrence_tests/replace "source" "obsolete" fields)
      stale_version=row[[str str]] (flow_occurrence_tests/replace "selected_version" "0" fields)
      stale_definition=row[[str str]] (flow_occurrence_tests/replace "selected_definition" "/0x11/user/other" fields)
      collision=row[[str str]] (flow_occurrence_tests/embed_fields 'first flow_tests/destination input both)
      [refused refusal_index refusal_reply] (helm/supervisor/admit (flow_ui/plan collision) both (sovereign_hive both))
      rejected=bool
        ?> (./ack why) refusal_reply .false
        ?> (./some why) why .false
        ?> reason=helm/supervisor/rejection why .false
        | eq_iota reason.reason 'flow_controller_collision
      occupied=namespace (flow_tests/poke page.weld(['work 'occupied 'note]) (myth/sing ['note] (pails/t "Keep")) selected)
      history=bool (row/all[care] (flow_occurrence_tests/history first both removed) [.x .y .z])
      changed=namespace (flow_tests/poke other_input.snoc('readme) (myth/sing ['flow 'source] (flow/source "other.md" (str/repeat 64 "c") "md" "Evidence changed after reference removal")) removed)
    | [(testing/text "selection leaves the containing authored source intact" source (flow_tests/get page selected).txt_at(['src]))
       (testing/nat "selection is an ordinary captured cell" 1 (flow_tests/get first_cell selected).has(['capture]))
       (testing/nat "selecting creates no controller until embedding" 0 (flow_tests/get first selected).has(['flow 'config]))
       (testing/nat "selection form exposes binding controls for foreign publication" 1 (and (cord/has "Bind and embed flow" tools) (cord/has "input/sources" tools)))
       (testing/nat "first occurrence uses existing maintenance work" 1 (flow_tests/get first both).has(['flow 'config]))
       (testing/nat "second occurrence uses its own maintenance work" 1 (flow_tests/get second both).has(['flow 'config]))
       (testing/nat "both ordinary destinations are published" 1 (and (gt (flow_tests/get flow_tests/destination both).txt_at(['src]).len 0) (gt (flow_tests/get other_output both).txt_at(['src]).len 0)))
       (testing/nat "embedded reference names its native occurrence controller" 1 (cord/has (str/to_atom (path_show first)) (str/to_atom (flow_tests/get page both).txt_at(['src]))))
       (testing/nat "source edit is admitted" 1 (flow_occurrence_tests/admitted source_reply))
       (testing/nat "source edit changes authored prose" 1 (cord/has "Source-side note" (str/to_atom (flow_tests/get page source_saved).txt_at(['src]))))
       (testing/text "Goo edit changes the intended block" "An embedded procedure beside authored relationships" (str/from_atom (text_at ['title] (flow_tests/get block goo))))
       (testing/nat "binding and invocation slots exist before preservation checks" 1 (and before.has(['flow 'bind]) before.has(['flow 'invoke])))
       (testing/nat "second occurrence receives its distinct evidence" 1 (cord/has "Distinct second evidence" (str/to_atom (flow_tests/get other_output.weld(['reference 'readme]) both).txt_at(['src]))))
       (testing/nat "removing embeds is admitted" 1 (flow_occurrence_tests/admitted removed_reply))
       (testing/nat "removing embeds actually removes source references" 0 (cord/has (str/to_atom (path_show second)) (str/to_atom (flow_tests/get page removed).txt_at(['src]))))
       (testing/nat "running occurrence continues after its embed is removed" 1 (cord/has "Evidence changed after reference removal" (str/to_atom (flow_tests/get other_output.weld(['reference 'readme]) changed).txt_at(['src]))))
       (testing/nat "embedding keeps repeated typed bindings intact" 1 (equal[pail] before.pail_at(['flow 'bind]) after.pail_at(['flow 'bind])))
       (testing/nat "embedding keeps authored invocation reference intact" 1 (equal[pail] before.pail_at(['flow 'invoke]) after.pail_at(['flow 'invoke])))
       (testing/nat "source and Goo edits keep repeated bindings" 1 (equal[pail] before.pail_at(['flow 'bind]) (flow_tests/get block goo).pail_at(['flow 'bind])))
       (testing/nat "source and Goo edits preserve the selected publication" 1 (equal[myth] (flow_tests/get first_cell both) (flow_tests/get first_cell goo)))
       (testing/nat "source and Goo edits preserve native controller" 1 (equal[myth] (flow_tests/get first both) (flow_tests/get first goo)))
       (testing/nat "embedded projection links native Cells without mounting its viewer" 1 (and (cord/has "Open in Cells" html) (eq 0 (cord/has "data-native-cell" html))))
       (testing/nat "embedded projection exposes existing maintenance controls" 1 (cord/has "Pause" html))
       (testing/nat "detached projection cannot offer resume" 0 (cord/has "Resume" detached_html))
       (testing/nat "removing reference preserves work and retained history" 1 (and history (equal[myth] (flow_tests/get first detached) (flow_tests/get first removed))))
       (testing/nat "removing reference preserves both selected cells" 1 (and (equal[myth] (flow_tests/get first_cell both) (flow_tests/get first_cell removed)) (equal[myth] (flow_tests/get second_cell both) (flow_tests/get second_cell removed))))
       (testing/text "obsolete source form refuses atomically" "flow_stale_source" (flow_tests/reason (flow_ui/plan stale_source selected)))
       (testing/text "obsolete selected version refuses" "flow_stale_selection" (flow_tests/reason (flow_ui/plan stale_version selected)))
       (testing/text "different selected definition refuses" "flow_stale_selection" (flow_tests/reason (flow_ui/plan stale_definition selected)))
       (testing/text "second embed cannot replace occurrence" "flow_controller_collision" (flow_tests/reason (flow_ui/plan collision both)))
       (testing/nat "colliding embed returns its expected rejection acknowledgement" 1 rejected)
       (testing/nat "rejected embed changes no namespace state" 1 (equal[namespace] both refused))
       (testing/nat "rejected embed preserves the dependency index" 1 (equal[hive] (sovereign_hive both) refusal_index))
       (testing/text "selection cannot replace existing frozen cell" "flow_selection_collision" (flow_tests/reason (flow_ui/plan (flow_occurrence_tests/select_fields "first") selected)))
       (testing/text "selection cannot capture a nondefinition record" "flow_missing_definition" (flow_tests/reason (flow_ui/plan (flow_occurrence_tests/replace "definition" (path_show page) (flow_occurrence_tests/select_fields "missing")) selected)))
       (testing/text "selection cannot occupy an existing work subtree" "flow_controller_collision" (flow_tests/reason (flow_ui/plan (flow_occurrence_tests/select_fields "occupied") occupied)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Nenex embeds foreign published flows through native cells and maintenance" flow_occurrence_tests/checks)]
