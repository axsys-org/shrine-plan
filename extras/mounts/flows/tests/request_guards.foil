- flow_request_ops
- cooperate_mount
- testing

' Focused planning checks hydrate crews and admit writes through the native
' namespace. The fixture supplies controlled records and explicit guard faults.
+ request_guard_tests
  + controller
    ^ path
    [($x 17) 'work 'flow]
  + destination
    ^ path
    [($x 17) 'output]
  + subject
    ^ path
    ['item]
  + hole
    ^ path
    | (request_guard_tests/destination).weld(['item 'holes 'author 'fetch])
  + definition
    ^ pin[flow/definition]
    | pin (flow/definition (safe 1 .x [($x 17) 'author]) "guard fixture" [] [] (pin flow_ops/empty) 'fetch)
  + provider
    \ target=path request=native_work/request
    ^ myth
    | native_work_ops/open request.owner "controlled-provider" myth/new
  + task
    \ prompt=str
    ^ myth
    | (myth/sing ['work 'prompt] (pails/t prompt)).put(['work 'schema] (pails/t "{}")).put(['work 'provider] (native_work/provider request_guard_tests/provider))
  + pending
    \ task=myth
    ^ flow/pending
    | flow/pending 'fetch (pin (flow_ops/empty).put(request_guard_tests/subject task)) (pin flow_ops/empty)
  + candidate
    \ task=myth
    ^ axal[myth]
    = result (axal/new[myth] (./some (myth/sing ['flow 'pending] (request_guard_tests/pending task))))
      proposal (flow_maintenance/proposal request_guard_tests/definition [] (flow/evaluation (pin result) []))
    | axal/new[myth] (./some (myth/sing ['flow 'candidate] (flow_maintenance/candidate (./ok proposal))))
  + record
    ^ myth
    | (native_work_ops/open request_guard_tests/controller "maintenance" myth/new).put(['flow 'destination] (pails/p request_guard_tests/destination)).put(['flow 'progress] (flow_maintenance/progress .true 0 (./some (pin flow_ops/empty)) (pin flow_ops/empty) .none))
  + needs_retry
    \ record=myth
    ^ bool
    ?> progress=flow_maintenance/progress record.pail_at(['flow 'progress]) .false
    | maybe/is_none progress.observed
  + apply
    \ writes=row[[path writ]] world=axal[myth]
    ^ axal[myth]
    = state (request_guard_tests/namespace_of world)
    ?> (./ok pair) (namespace_command/admit (\ ignored=namespace (./ok writes)) state (sovereign_hive state))
      | Seq[axal[myth]] (error (pails/t "Guard fixture admission failed")) world
    = [next index] pair
    | sovereign_peek [] next
  + bowl
    \ world=axal[myth] guards=row[[path axal[myth]]]
    ^ bowl
    = state (request_guard_tests/namespace_of world)
      record world.get(request_guard_tests/controller).fall(request_guard_tests/record)
      activity (native_work_ops/state record).fall((native_work/activity request_guard_tests/controller "fixture" "open" 0 .none))
      views (sovereign_crew_of (./some record) state)
      views (flow_request_ops/allocation_views request_guard_tests/controller "request_" activity.sequence 1 state views)
      views views.put(['destination] (sovereign_peek request_guard_tests/destination state))
      views (guards.fold(views (\ out [name value] out.put(name value))))
    | bowl [] request_guard_tests/controller 0 0 flow_ops/empty views
  + stage
    \ task=myth world=axal[myth]
    ^ yell
    = record world.get(request_guard_tests/controller).fall(request_guard_tests/record)
    | flow_request_ops/stage (request_guard_tests/bowl world []) record (request_guard_tests/pending task)
        world.dip(request_guard_tests/destination) request_guard_tests/definition .none
  + staged
    \ task=myth world=axal[myth]
    ^ axal[myth]
    = next (request_guard_tests/stage task world)
    | (request_guard_tests/apply next.cards world).put(request_guard_tests/controller next.out)
  + attempt
    \ n=nat
    ^ path
    | (request_guard_tests/controller).weld(['work ($ts (str/cat_all ["request_" n.show]))])
  + capture
    \ record=myth
    ^ native_work/captured
    ?> held=native_work/captured record.pail_at(['capture])
      | native_work/captured (safe 0 .x []) .none (pin flow_ops/empty)
    held
  + guard
    \ record=myth
    ^ axal[myth]
    | axal/new[myth] (./some (myth/sing ['capture] (request_guard_tests/capture record)))
  + rejected
    \ result=either[iota row[[path writ]]]
    ^ iota
    ? result
     > (./err why) why
     > (./ok _) 'accepted
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = task_a (request_guard_tests/task "A")
      task_b (request_guard_tests/task "B")
      first (request_guard_tests/staged task_a flow_ops/empty)
      second (request_guard_tests/staged task_b first)
      returned (request_guard_tests/staged task_a second)
      a (request_guard_tests/attempt 1)
      b (request_guard_tests/attempt 2)
      c (request_guard_tests/attempt 3)
      old first.get(a).fall(myth/new)
      obsolete second.get(b).fall(myth/new)
      current returned.get(c).fall(myth/new)
      before returned.dip(request_guard_tests/destination)
      seen (request_guard_tests/candidate task_a)
      guard_a (request_guard_tests/guard old)
      guard_b (request_guard_tests/guard obsolete)
      outcome_a (native_work/outcome "complete" "Result A" (pin (request_guard_tests/capture old)))
      outcome_b (native_work/outcome "complete" "Result B" (pin (request_guard_tests/capture obsolete)))
      refused (flow_request_ops/accept a old outcome_a guard_a seen request_guard_tests/destination before flow_ops/empty)
      wrong_guard (flow_request_ops/accept c current outcome_b guard_b seen request_guard_tests/destination before flow_ops/empty)
      accepted (flow_request_ops/accept c current outcome_a guard_a seen request_guard_tests/destination before flow_ops/empty)
      controller returned.get(request_guard_tests/controller).fall(myth/new)
      stale_dispatch (flow_request_ops/dispatch (request_guard_tests/bowl returned [[['guard 'request_1] guard_a] [['guard 'request_3] guard_b]]) controller seen)
      fresh_dispatch (flow_request_ops/dispatch (request_guard_tests/bowl returned [[['guard 'request_1] guard_a] [['guard 'request_3] guard_a]]) controller seen)
      worker_ready=bool
        ?> (./some dispatch) fresh_dispatch .false
        | dispatch.cards.any((\ [target change] (equal[path] target c.snoc('worker))))
      obsolete_worker=bool
        ?> (./some dispatch) fresh_dispatch .false
        | dispatch.cards.any((\ [target change] (equal[path] target a.snoc('worker))))
      context (request_guard_tests/hole).snoc('context)
      foreign (flow_ops/empty).put(context (myth/sing ['text] (pails/t "User-authored context")))
      collision (request_guard_tests/stage task_a foreign)
      orphan (flow_ops/empty).put(context first.get(context).fall(myth/new))
      orphaned (request_guard_tests/stage task_a orphan)
      foreign_hole_world first.put(request_guard_tests/hole (myth/sing ['note] (pails/t "Unrelated hole")))
      hole_collision (request_guard_tests/stage task_b foreign_hole_world)
      edited first.put(context (myth/sing ['text] (pails/t "Edited owned context")))
      edited_collision (request_guard_tests/stage task_b edited)
      accepted_writes=row[[path writ]]
        ? accepted
         > (./ok writes) writes
         > (./err _) []
      completed (request_guard_tests/apply accepted_writes returned)
      completed_hole completed.get(request_guard_tests/hole).fall(myth/new)
      activity_status=str
        ?> (./some activity) (native_work_ops/state completed_hole) "missing"
        activity.status
      receipt (native_work/request a "A" "{}" (safe 0 .x (row/cons[iota] 'x a.snoc('guard))))
      late_world returned.put(a old.put(['work 'request] receipt)).put(a.snoc('worker) (myth/sing ['work 'outcome] outcome_a).put(['work 'request] receipt))
      unclaimed_world returned.put(c.snoc('worker) (myth/sing ['work 'outcome] outcome_a))
      unclaimed_reply (flow_request_ops/responses (request_guard_tests/bowl unclaimed_world [[['guard 'request_3] guard_a]]) controller seen)
      current_receipt (native_work/request c "A" "{}" (safe 0 .x (row/cons[iota] 'x c.snoc('guard))))
      mismatched_world unclaimed_world.put(c current.put(['work 'request] current_receipt)).put(c.snoc('worker) (myth/sing ['work 'outcome] outcome_a).put(['work 'request] receipt))
      mismatched_reply (flow_request_ops/responses (request_guard_tests/bowl mismatched_world [[['guard 'request_3] guard_a]]) controller seen)
      late_response (flow_request_ops/responses (request_guard_tests/bowl late_world [[['guard 'request_1] guard_a]]) controller seen)
      foreign_record (myth/sing ['text] (pails/t "Foreign work"))
      request_root_collision (request_guard_tests/stage task_a (flow_ops/empty).put(a foreign_record))
      request_child_collision (request_guard_tests/stage task_a (flow_ops/empty).put(a.snoc('note) foreign_record))
      worker_root_world returned.put(c.snoc('worker) foreign_record)
      worker_child_world returned.put(c.weld(['worker 'note]) foreign_record)
      worker_root_collision (flow_request_ops/dispatch (request_guard_tests/bowl worker_root_world [[['guard 'request_3] guard_a]]) controller seen)
      worker_child_collision (flow_request_ops/dispatch (request_guard_tests/bowl worker_child_world [[['guard 'request_3] guard_a]]) controller seen)
      worker_root_reply=yell (worker_root_collision.fall((yell [] myth/new)))
      worker_child_reply=yell (worker_child_collision.fall((yell [] myth/new)))
      late_writes=row[[path writ]]
        ?> (./some reply) late_response []
        reply.cards
    [(testing/nat "request collision leaves candidate eligible for retry" 1 (request_guard_tests/needs_retry request_root_collision.out))
     (testing/nat "context collision leaves candidate eligible for retry" 1 (request_guard_tests/needs_retry collision.out))
     (testing/nat "foreign hole receives no writes" 0 hole_collision.cards.len)
     (testing/text "foreign hole blocks explicitly" "Native work hole collision" hole_collision.out.txt_at(system_vocabulary/content))
     (testing/nat "hole collision leaves candidate eligible for retry" 1 (request_guard_tests/needs_retry hole_collision.out))
     (testing/nat "orphaned context leaves candidate eligible for retry" 1 (request_guard_tests/needs_retry orphaned.out))
     (testing/nat "unclaimed foreign worker outcome is not accepted" 1 (maybe/is_none unclaimed_reply))
     (testing/nat "mismatched worker receipt is not accepted" 1 (maybe/is_none mismatched_reply))
     (testing/nat "foreign request root receives no writes" 0 request_root_collision.cards.len)
     (testing/text "foreign request root blocks explicitly" "Native work request collision" request_root_collision.out.txt_at(system_vocabulary/content))
     (testing/nat "foreign request descendant receives no writes" 0 request_child_collision.cards.len)
     (testing/text "foreign request descendant blocks explicitly" "Native work request collision" request_child_collision.out.txt_at(system_vocabulary/content))
     (testing/nat "foreign worker root receives no writes" 0 worker_root_reply.cards.len)
     (testing/text "foreign worker root blocks explicitly" "Native work worker collision" worker_root_reply.out.txt_at(system_vocabulary/content))
     (testing/nat "foreign worker descendant receives no writes" 0 worker_child_reply.cards.len)
     (testing/text "foreign worker descendant blocks explicitly" "Native work worker collision" worker_child_reply.out.txt_at(system_vocabulary/content))
     (testing/nat "A to B to A creates a third attempt" 1 (flow_request_ops/native current))
     (testing/nat "equal old task is current by value" 1 (flow_request_ops/current old seen))
     (testing/nat "equal old task no longer owns the hole" 0 (flow_request_ops/head a old request_guard_tests/destination before))
     (testing/nat "new attempt owns the returned demand" 1 (flow_request_ops/head c current request_guard_tests/destination before))
     (testing/nat "late old A is refused despite equal evidence" (quip_val 'flow_stale_request) (quip_val (request_guard_tests/rejected refused)))
     (testing/nat "matching live guard for wrong captured task is refused" (quip_val 'flow_stale_request) (quip_val (request_guard_tests/rejected wrong_guard)))
     (testing/nat "stale guard waits without provider dispatch" 1 (maybe/is_none stale_dispatch))
     (testing/nat "current guard dispatches the head attempt" 1 worker_ready)
     (testing/nat "current guard never redispatches old A" 0 obsolete_worker)
     (testing/nat "old attempt capture remains unchanged" 1 (equal[pail] old.pail_at(['capture]) returned.get(a).fall(myth/new).pail_at(['capture])))
     (testing/text "replaced attempt is settled before subscriptions are removed" "waiting" returned.get(a).fall(myth/new).txt_at(['work 'status]))
     (testing/nat "foreign context collision emits no writes" 0 collision.cards.len)
     (testing/text "foreign context collision is explicit" "Native work context collision" collision.out.txt_at(system_vocabulary/content))
     (testing/nat "matching context without owner emits no writes" 0 orphaned.cards.len)
     (testing/text "matching context needs an owning hole" "Native work context has no owning hole" orphaned.out.txt_at(system_vocabulary/content))
     (testing/nat "edited owned context emits no writes" 0 edited_collision.cards.len)
     (testing/nat "current head outcome is accepted" (quip_val 'accepted) (quip_val (request_guard_tests/rejected accepted)))
     (testing/text "accepted head resolves the hole" "resolved" completed_hole.txt_at(['work 'status]))
     (testing/text "accepted head updates native activity status" "resolved" activity_status)
     (testing/nat "late equal A is outside the selected work dependencies" 0 late_writes.len)
     (testing/nat "late equal A never rewrites the current hole" 0
       (late_writes.any((\ [target change] (equal[path] target request_guard_tests/hole)))))]
  + retry_view
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | request_guard_tests/candidate (request_guard_tests/task "A")
  + hole_allocation
    \ ignored=unit
    ^ row[testing/check]
    = task (request_guard_tests/task "A")
      hole request_guard_tests/hole
      annotation hole.snoc('annotation)
      nested hole.weld(['context 'annotation])
      foreign (myth/sing ['sentinel] (pails/n 73))
      bare (request_guard_tests/stage task (flow_ops/empty).put(annotation foreign))
      deep (request_guard_tests/stage task (flow_ops/empty).put(nested foreign))
      first (request_guard_tests/staged task flow_ops/empty)
      orphan_context (request_guard_tests/stage (request_guard_tests/task "B")
        first.rep(hole.snoc('context) flow_ops/empty).put(nested foreign))
      owned first.put(annotation foreign)
      next (request_guard_tests/staged (request_guard_tests/task "B") owned)
      head next.get(hole).fall(myth/new).path_at(['work 'attempt])
    [(testing/nat "new hole refuses rootless foreign descendants" 0 bare.cards.len)
     (testing/text "rootless hole collision is explicit" "Native work hole collision" bare.out.txt_at(system_vocabulary/content))
     (testing/nat "new hole context refuses rootless descendants" 0 deep.cards.len)
     (testing/nat "owned hole does not adopt rootless context descendants" 0 orphan_context.cards.len)
     (testing/nat "owned hole annotation survives a new attempt" 1 (equal[maybe[myth]] next.get(annotation) (./some foreign)))
     (testing/nat "owned annotated hole advances its head" 1 (equal[maybe[path]] head (./some (request_guard_tests/attempt 2))))]
  + validate
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    ?> outcome=native_work/outcome args.get(['response]).fall(myth/new).pail_at(['work 'outcome]) (./err 'fixture_missing_response)
    ? !(eq outcome.text "valid") (./err 'fixture_invalid_response)
    | ./ok (flow_ops/empty).put([] (myth/sing ['answer] (pails/n 42)))
  + throwing_validator
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    ; (Throw 7)
    | ./ok flow_ops/empty
  + validation_checks
    \ ignored=unit
    ^ row[testing/check]
    = task (request_guard_tests/task "A").put(['work 'validator] (flow/operation ['response] request_guard_tests/validate))
      first (request_guard_tests/staged task flow_ops/empty)
      at (request_guard_tests/attempt 1)
      record first.get(at).fall(myth/new)
      guard (request_guard_tests/guard record)
      good (native_work/outcome "complete" "valid" (pin (request_guard_tests/capture record)))
      bad good.set_text("invalid")
      accepted (flow_request_ops/accept at record good guard (request_guard_tests/candidate task) request_guard_tests/destination first.dip(request_guard_tests/destination) flow_ops/empty)
      refused (flow_request_ops/accept at record bad guard (request_guard_tests/candidate task) request_guard_tests/destination first.dip(request_guard_tests/destination) flow_ops/empty)
      writes=row[[path writ]]
        ?> (./ok selected) accepted []
        selected
      after (request_guard_tests/apply writes first)
      answers after.dip((request_guard_tests/controller).weld(['resolutions]))
      resolution answers.get(['fetch 'item]).fall(myth/new)
      poisoned answers.put(['fetch 'item] resolution.put(['work 'outcome] bad))
      tasks (flow_ops/empty).put(request_guard_tests/subject task)
      cached (flow_ops/resolve 'fetch tasks answers (unpin request_guard_tests/definition))
      stale (flow_ops/resolve 'fetch tasks poisoned (unpin request_guard_tests/definition))
      throwing task.put(['work 'validator] (flow/operation ['response] request_guard_tests/throwing_validator))
      wrong task.put(['work 'validator] (flow/operation ['other] request_guard_tests/validate))
      captured=bool
        ?> view=cell_view resolution.pail_at(['work 'value]) .false
        | eq (unpin view.tree).fil.fall(myth/new).nat_at(['answer] 0) 42
    [(testing/nat "domain refusal occurs before completion writes" (quip_val 'fixture_invalid_response) (quip_val (request_guard_tests/rejected refused)))
     (testing/nat "domain acceptance uses the normal request writes" 1 (either/is_ok accepted))
     (testing/nat "validated structure is retained in the native result" 1 captured)
     (testing/nat "validated structure has an ordinary native cell" 1 after.get(at.snoc('value)).fall(myth/new).has(bond/weft))
     (testing/nat "retained valid response passes the same captured law" 1 (either/is_ok cached))
     (testing/nat "retained values cannot bypass response validation" 1 (either/is_err stale))
     (testing/nat "throwing domain law becomes a refusal" 1 (either/is_err (flow_ops/validate_response throwing good)))
     (testing/nat "validator ports are explicit" 1 (either/is_err (flow_ops/validate_response wrong good)))
     (testing/nat "ordinary requests retain their existing behavior" 1 (either/is_ok (flow_ops/validate_response (request_guard_tests/task "A") good)))]
  + no_plan
    \ target=path input=axal[myth] state=namespace
    ^ either[iota row[[path writ]]]
    | ./ok []
  + no_materialize
    \ target=path input=axal[myth] before=axal[myth]
    ^ either[iota row[[path writ]]]
    | ./ok []
  + namespace_of
    \ world=axal[myth]
    ^ namespace
    = world ((cooperate_mount/records ($x 17)).fold(world (\ out [name card] out.put(name card))))
      notes (world.tap.fold((axal/new[note] .none) (\ out [name record] out.put(name (note/make record)))))
      local=sov
        ?> (./accepted pair) (sov/step notes 0 0 sov/new) sov/new
        = [next signs] pair
        next
    | namespace ($x 17) local (pin (system_publication 1 sov/new (system_publication/assigned sov/new)))
  + retry_checks
    \ ignored=unit
    ^ row[testing/check]
    = owner request_guard_tests/controller
      first (request_guard_tests/staged (request_guard_tests/task "A") flow_ops/empty)
      a (request_guard_tests/attempt 1)
      b (request_guard_tests/attempt 2)
      refused (native_work_ops/settle "waiting" "failed" first.get(a).fall(myth/new)).put(['flow 'refused] (pails/q 'work_provider_failed))
      writer (flow_runtime/writer request_guard_tests/no_plan request_guard_tests/no_materialize)
      config (flow_maintenance/config (pin myth/new) [($x 17) 'definition] request_guard_tests/destination (pin writer) (safe 1 .x [($x 17) 'writer]) .none)
      controller first.get(owner).fall(myth/new).put(['flow 'config] config)
      view (myth/sing bond/weft (spun request_guard_tests/retry_view .none)).put(bond/tack (safe 0 .x [($x 17) 'evidence]))
      claims (flow_maintenance/claims (axal/new[path] .none).put(request_guard_tests/destination owner))
      world first.put(a refused).put(owner controller).put(owner.snoc('view) view)
      world world.put([($x 17) 'evidence] (myth/sing ['text] (pails/t "Evidence"))).put((flow_ops/key ($x 17) 'claims) (myth/sing ['flow 'claims] claims))
      state (request_guard_tests/namespace_of world)
      expected (myth/sing ['expected] (pails/n state.case(.x a).fall(0)))
      planned (flow_request_ops/retry a expected state)
      writes=row[[path writ]]
        ?> (./ok cards) planned []
        cards
      after (request_guard_tests/apply writes world)
      hole after.get(request_guard_tests/hole).fall(myth/new)
      head=maybe[path]
        ?> progress=native_work/hole_state hole.pail_at(['work 'hole_state]) .none
        progress.attempt
      collision_state (request_guard_tests/namespace_of world.put(b.snoc('note) (myth/sing ['text] (pails/t "Foreign work"))))
      collision (flow_request_ops/retry a expected collision_state)
      repeated (flow_request_ops/retry a expected (request_guard_tests/namespace_of after))
      seed (request_guard_tests/record).put(['work 'activity] (native_work/activity owner "maintenance" "open" 8 .none))
      high (request_guard_tests/staged (request_guard_tests/task "A") (flow_ops/empty).put(owner seed))
      high (request_guard_tests/staged (request_guard_tests/task "B") high)
      high (request_guard_tests/staged (request_guard_tests/task "A") high)
      nine (request_guard_tests/attempt 9)
      eleven (request_guard_tests/attempt 11)
      twelve (request_guard_tests/attempt 12)
      high_failed (native_work_ops/settle "waiting" "failed" high.get(eleven).fall(myth/new)).put(['flow 'refused] (pails/q 'work_provider_failed))
      high high.put(nine high.get(nine).fall(myth/new).put(['work 'retry_requested] (pails/b .true))).put(eleven high_failed)
      high high.put(owner high.get(owner).fall(myth/new).put(['flow 'config] config)).put(owner.snoc('view) view)
      high high.put([($x 17) 'evidence] world.get([($x 17) 'evidence]).fall(myth/new)).put((flow_ops/key ($x 17) 'claims) (myth/sing ['flow 'claims] claims))
      high_state (request_guard_tests/namespace_of high)
      high_plan (flow_request_ops/retry eleven (myth/sing ['expected] (pails/n high_state.case(.x eleven).fall(0))) high_state)
      high_writes=row[[path writ]]
        ?> (./ok cards) high_plan []
        cards
      high_after (request_guard_tests/apply high_writes high)
      repeated_writes=nat
        ?> (./ok cards) repeated 999
        cards.len
    [(testing/nat "retry beyond nine uses current native head" (quip_val 'accepted) (quip_val (request_guard_tests/rejected high_plan)))
     (testing/nat "retry lineage ignores lexicographically later obsolete request" 1 (equal[maybe[path]] high_after.get(twelve).fall(myth/new).path_at(['work 'retry_of]) (./some eleven)))
     (testing/nat "retry plans replacement without waiting for crew hydration" (quip_val 'accepted) (quip_val (request_guard_tests/rejected planned)))
     (testing/nat "retry replacement links its exact predecessor" 1 (equal[maybe[path]] after.get(b).fall(myth/new).path_at(['work 'retry_of]) (./some a)))
     (testing/nat "retry moves hole head in the same plan" 1 (equal[maybe[path]] head (./some b)))
     (testing/nat "retry keeps old capture and marks only its retry receipt" 1 (equal[maybe[myth]] after.get(a) (./some refused.put(['work 'retry_requested] (pails/b .true)))))
     (testing/nat "retry refuses occupied replacement subtree atomically" (quip_val 'flow_retry_unavailable) (quip_val (request_guard_tests/rejected collision)))
     (testing/nat "retry receipt makes repeated retry idempotent" 0 repeated_writes)]
  + context_prompt
    \ ignored=unit
    ^ row[testing/check]
    = content=axal[myth] (flow_ops/empty).put(['source] (myth/sing ['text] (pails/t "Captured evidence")))
      task=myth (request_guard_tests/task "opaque provider request").put(['work 'evidence] (cell_view (pin content)))
      world=axal[myth] (request_guard_tests/staged task flow_ops/empty)
      target (request_guard_tests/attempt 1)
      attempt=myth world.get(target).fall(myth/new)
      enabled=myth task.put(['work 'interactive] (pails/b .true))
    | [(testing/text "noninteractive provider protocol is not decorated" task.txt_at(['work 'prompt]) (flow_request_ops/prompt task attempt))
       (testing/nat "interactive request names its retained context cell" 1
         (cord/has (str/to_atom (path_show (row/cons[iota] 'x target.snoc('context)))) (str/to_atom (flow_request_ops/prompt enabled attempt))))
       (testing/nat "same interactive prompt also names its resumption cell" 1
         (cord/has (str/to_atom (path_show (row/cons[iota] 'x target.snoc('resumption)))) (str/to_atom (flow_request_ops/prompt enabled attempt))))
       (testing/nat "resumption remains available without task evidence" 1
         (cord/has "NATIVE WORK:" (str/to_atom (flow_request_ops/prompt enabled attempt.del(['work 'context])))))
       (testing/text "older requests without an exposed context keep their prompt" task.txt_at(['work 'prompt]) (flow_request_ops/prompt enabled myth/new))
       (testing/nat "request context uses the existing native frozen cell" 1 world.get(target.snoc('context)).fall(myth/new).has(bond/weft))]
+ tests
  ^ row[testing/case]
  [(testing/case "native request ownership and capture guards" request_guard_tests/checks)
   (testing/case "native hole subtree allocation" request_guard_tests/hole_allocation)
   (testing/case "atomic native request retry planning" request_guard_tests/retry_checks)
   (testing/case "captured domain response validation" request_guard_tests/validation_checks)
   (testing/case "Captured context preserves provider protocol boundaries" request_guard_tests/context_prompt)]
