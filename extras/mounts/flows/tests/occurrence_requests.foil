- flow_occurrence_tests

' The browser occurrence admits through the same native command plans, then
' existing hands own provider dispatch, retry, holes and publication.
+ occurrence_request_tests
  + attempt
    \ controller=path n=nat
    ^ path
    | controller.weld(['work ($ts (str/cat_all ["revision_" (nat/show n)]))])
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = page=path flow_occurrence_tests/page
      controller=path page.weld(['work 'revision])
      destination=path [($x 17) 'app 'nenex 'w 'occurrence_concepts]
      provider=path [($x 17) 'gov 'flows 'occurrence_provider]
      authored=namespace (flow_tests/apply 'author page (myth/sing ['source] (pails/t ";.\n  ;= Project workspace\n    Maintain the concepts here.")) flow_revision_tests/prepared)
      installed=namespace (flow_tests/poke flow_revision_tests/worker_form
        (myth/sing system_vocabulary/form (def_form.set_init(native_work_ops/wake).set_hear(flow_revision_tests/hole_hear).set_talk(flow_revision_tests/hole_talk))) authored)
      installed=namespace (flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider flow_revision_tests/hole_worker)) installed)
      selected=namespace (flow_ui_tests/act (flow_occurrence_tests/select_fields "revision") installed)
      fields=row[[str str]] (flow_occurrence_tests/replace "provider" (path_show provider)
        (flow_occurrence_tests/embed_fields 'revision destination [selected.self 'user 'flow_sources] selected))
      planned=either[iota row[[p=path q=writ]]] (flow_tests/plan fields selected)
    ? (either/is_err planned)
      [(testing/text "foreign revision occurrence admits through Nenex" "ok" (flow_tests/reason planned))]
    = started=namespace (flow_ui_tests/act fields selected)
      first=path (occurrence_request_tests/attempt controller 1)
      old=myth (flow_tests/get first started)
    ?> request=flow_work/request old.pail_at(['flow 'request])
      [(testing/nat "embedded occurrence creates the shared revision request" 1 0)]
    = retry_fields=row[[str str]] [["action" "retry"] ["page" (path_show page)] ["request" (path_show first)]]
      retry_plan=either[iota row[[p=path q=writ]]] (flow_tests/plan retry_fields started)
      retried=namespace (flow_ui_tests/act retry_fields started)
      retry=path (occurrence_request_tests/attempt controller 3)
      completed=namespace (flow_tests/change_source "Required evidence is now available." retried)
      old_submission=either[iota row[[p=path q=writ]]] (flow_maintenance_ops/submit_revision retry (flow_revision_tests/response retry completed) completed)
      history=bool (row/all[care] (flow_occurrence_tests/history first started completed) [.x .y .z])
      hole=myth (flow_tests/get request.hole completed)
      resumed=bool
        ?> progress=native_work/hole_state hole.pail_at(['work 'hole_state]) .false
        ?> (./some latest) progress.attempt .false
        | and !(equal[path] latest first) !(equal[path] latest retry)
      generation=nat
        ?> progress=flow_maintenance/progress (flow_tests/get controller completed).pail_at(['flow 'progress]) 0
        | progress.generation
    | [(testing/nat "selected foreign flow creates an ordinary maintenance controller" 1 (flow_tests/get controller started).has(['flow 'config]))
       (testing/nat "occurrence dispatches through existing native provider" 1 (flow_tests/get first.snoc('worker) started).has(['work 'outcome]))
       (testing/nat "insufficient evidence remains an unresolved revision" 1 (equal[pail] old.pail_at(['flow 'refused]) (pails/q 'flow_revision_unresolved)))
       (testing/nat "insufficient evidence publishes no fabricated concept" 0 (flow_tests/get destination started).has(['src]))
       (testing/nat "unresolved occurrence retains its subject hole" 1 (flow_tests/get request.hole started).has(['work 'hole]))
       (testing/nat "revision exposes the shared native overlay" 1 (flow_tests/get first.snoc('view) started).has(bond/weft))
       (testing/text "retry form plans the existing native operation" "ok" (flow_tests/reason retry_plan))
       (testing/nat "retry creates a fresh linked attempt" 1 (equal[maybe[path]] (./some first) (flow_tests/get retry retried).path_at(['work 'retry_of])))
       (testing/text "failed predecessor remains retained after retry" "waiting" (flow_tests/get first retried).txt_at(['work 'status]))
       (testing/nat "changed evidence completes the occurrence without a client loop" 1 generation)
       (testing/nat "resumed occurrence publishes supported concept prose" 1 (cord/has "Required evidence is now available" (str/to_atom (flow_tests/get destination completed).txt_at(['src]))))
       (testing/text "same persistent hole resolves after evidence changes" "resolved" hole.txt_at(['work 'status]))
       (testing/nat "evidence resumption advances the hole to a new attempt" 1 resumed)
       (testing/text "obsolete attempt cannot accept a late manual answer" "flow_stale_revision" (flow_tests/reason old_submission))
       (testing/nat "failed attempt retains its original captured evidence" 1 (equal[pail] old.pail_at(['capture]) (flow_tests/get first completed).pail_at(['capture])))
       (testing/nat "failed attempt and its x y z history remain exact" 1 (and history (equal[myth] old (flow_tests/get first completed))))]

+ tests
  ^ row[testing/case]
  [(testing/case "Embedded foreign flow shares native provider holes retry and evidence resumption" occurrence_request_tests/checks)]
