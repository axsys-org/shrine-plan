- flow_test_world [at=fixture]

' Occurrences select existing definitions; they are ordinary maintenance hands
' with independent input bindings and destination claims in a disposable world.
+ occurrence_lifecycle_tests
  + history_matches
    \ target=path before=namespace after=namespace car=care
    ^ bool
    | equal[res[axal[saga]]] (namespace/page car before.case(car target) target before) (namespace/page car before.case(car target) target after)
  + generation
    \ controller=path state=namespace
    ^ nat
    ?> progress=flow_maintenance/progress (fixture/flow_tests/get controller state).pail_at(['flow 'progress]) 0
    | progress.generation
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = base=namespace fixture/flow_tests/prepared
      first=path [($x 17) 'app 'nenex 'w 'project 'work 'first]
      second=path [($x 17) 'app 'nenex 'w 'project 'work 'second]
      live=path [($x 17) 'app 'nenex 'w 'project 'work 'live]
      second_output=path [($x 17) 'app 'nenex 'w 'second_output]
      live_output=path [($x 17) 'app 'nenex 'w 'live_output]
      second_sources=path [($x 17) 'user 'second_sources]
      selected=safe (safe base.case(.x fixture/flow_tests/definition).fall(0) .x fixture/flow_tests/definition)
      request=myth (fixture/flow_tests/follow_request).put(['definition] selected)
      seeded=namespace (fixture/flow_tests/apply 'import_source second_sources.snoc('readme) fixture/flow_tests/source_record base)
      one=namespace (fixture/flow_tests/apply 'follow first request seeded)
      two_request=myth request.put(['destination] (pails/p second_output)).put(['input 'sources] (safe 0 .z second_sources))
      two=namespace (fixture/flow_tests/apply 'follow second two_request one)
      attached=namespace (fixture/flow_tests/apply 'follow live (fixture/flow_tests/follow_request).put(['destination] (pails/p live_output)) two)
      repeated=namespace (fixture/flow_tests/apply 'follow first request attached)
      authored=namespace (fixture/flow_tests/poke fixture/flow_tests/author
        (myth/sing ['src] (pails/t (fixture/flow_tests/book_source "New publication"))) attached)
      publication=myth (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n authored.case(.x fixture/flow_tests/author).fall(0)))
      published=namespace (fixture/flow_tests/apply 'publish fixture/flow_tests/author publication authored)
      changed=namespace (fixture/flow_tests/change_source "First input changed" published)
      source=flow/source (flow/source "second.md" (str/repeat 64 "c") "md" "Second input changed")
      independent=namespace (fixture/flow_tests/poke second_sources.snoc('readme) (myth/sing ['flow 'source] source) changed)
      first_run=path first.weld(['work ($u 1)])
      old_run=myth (fixture/flow_tests/get first_run attached)
      detached=namespace (fixture/flow_tests/apply 'detach first myth/new independent)
      after=namespace (fixture/flow_tests/change_source "After detach" detached)
      historical=bool (row/all[care] (occurrence_lifecycle_tests/history_matches first_run attached after) [.x .y .z])
      collection=either[iota row[[p=path q=writ]]] (flow_maintenance_ops/follow first request.put(['definition] selected.set_care(.z)) base)
      unavailable=either[iota row[[p=path q=writ]]] (flow_maintenance_ops/follow first request.put(['definition] (safe 999999 .x [base.self 'missing_definition])) base)
      claims_record=myth (fixture/flow_tests/get (flow_ops/key base.self 'claims) after)
      released=bool
        ?> claims=flow_maintenance/claims claims_record.pail_at(['flow 'claims]) .false
        | !(claims.entries.has(fixture/flow_tests/destination))
    | [(testing/text "retained definition requires an exact record reference" "flow_definition_record_required" (fixture/flow_tests/reason collection))
       (testing/text "unavailable retained definition is refused" "flow_missing_definition" (fixture/flow_tests/reason unavailable))
       (testing/nat "retained publication has an exact native moment" 1 (gt selected.ver 0))
       (testing/nat "first retained occurrence runs" 1 (occurrence_lifecycle_tests/generation first attached))
       (testing/nat "second occurrence runs independently" 1 (occurrence_lifecycle_tests/generation second attached))
       (testing/nat "retained occurrence attach is idempotent" 1 (equal[namespace] attached repeated))
       (testing/nat "view keeps the selected native definition reference" 1 (equal[pail] selected (fixture/flow_tests/get first.snoc('view) attached).pail_at(bond/tack)))
       (testing/nat "republishing does not wake retained occurrence" 1 (occurrence_lifecycle_tests/generation first published))
       (testing/nat "republishing does not wake second retained occurrence" 1 (occurrence_lifecycle_tests/generation second published))
       (testing/nat "existing live follow still observes publication" 1 (cord/has "New publication" (str/to_atom (fixture/flow_tests/get live_output published).txt_at(['src]))))
       (testing/nat "retained occurrence still reacts to live input" 2 (occurrence_lifecycle_tests/generation first changed))
       (testing/nat "retained occurrence keeps old published behavior after input changes" 1 (cord/has "First title" (str/to_atom (fixture/flow_tests/get fixture/flow_tests/destination changed).txt_at(['src]))))
       (testing/nat "first input change does not run second occurrence" 1 (occurrence_lifecycle_tests/generation second changed))
       (testing/nat "second input independently advances second occurrence" 2 (occurrence_lifecycle_tests/generation second independent))
       (testing/nat "second input does not advance first occurrence" 2 (occurrence_lifecycle_tests/generation first independent))
       (testing/nat "first output binds first evidence" 1 (cord/has "First input changed" (str/to_atom (fixture/flow_tests/get ((fixture/flow_tests/destination).weld(['reference 'readme])) independent).txt_at(['src]))))
       (testing/nat "second output binds second evidence" 1 (cord/has "Second input changed" (str/to_atom (fixture/flow_tests/get second_output.weld(['reference 'readme]) independent).txt_at(['src]))))
       (testing/nat "detach stops the selected occurrence" 2 (occurrence_lifecycle_tests/generation first after))
       (testing/nat "detach releases only its destination claim" 1 released)
       (testing/nat "detach retains the completed attempt" 1 (equal[myth] old_run (fixture/flow_tests/get first_run after)))
       (testing/nat "retained occurrence preserves exact x y z attempt history" 1 historical)
       (testing/nat "occurrence exposes the ordinary native work cell" 1 (fixture/flow_tests/get first.weld(['cells 'work]) after).has(bond/weft))]

+ tests
  ^ row[testing/case]
  [(testing/case "Retained flow occurrences keep independent bindings and native history" occurrence_lifecycle_tests/checks)]
