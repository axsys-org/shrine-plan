- flow_cartography
- graph_policy
- testing
- json [at=claim_json]

+ cartography_tests
  + subject
    ^ safe
    | safe 0 .x [($x 17) 'user 'company]
  + origin
    ^ safe
    | safe 1 .x [($x 17) 'work 'fetch 'result]
  + source
    ^ flow/source
    | flow/source (path_show (cartography_tests/origin).path) (path_show (safe/spell cartography_tests/origin)) "md"
        (str/from_atom (joined 10 ["# Company" "Founded in 2010."]))
  + card
    ^ myth
    | (myth/sing ['flow 'source] cartography_tests/source).put(['flow 'origin] cartography_tests/origin)
  + guard
    ^ pin[native_work/captured]
    | pin (native_work/captured cartography_tests/origin .none (pin flow_ops/empty))
  + response
    \ text=str
    ^ axal[myth]
    | (flow_ops/empty).put(['response] (myth/sing ['work 'outcome] (native_work/outcome "complete" text cartography_tests/guard)))
  + answer
    \ quote=str
    ^ str
    | claim_json/show (json/obj [(jkv "note" (json/str "The source contains a dated statement."))
        (jkv "claims" (json/arr [(json/obj [(jkv "property" (json/str "/founded"))
          (jkv "value" (json/str "2010")) (jkv "quote" (json/str quote))
          (jkv "accepted" (json/boo .true)) (jkv "reason" (json/str "Exact source statement."))])]))])
  + reason
    \ answer=either[iota axal[myth]]
    ^ iota
    ?> (./err why) answer 'ok
    why
  + parsed
    ^ axal[myth]
    ?> (./ok claims) (flow_cartography/validate_claims cartography_tests/subject cartography_tests/origin cartography_tests/source
        (cartography_tests/response (cartography_tests/answer "Founded in 2010."))) flow_ops/empty
    claims
  + report
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | graph_policy/report input
  + mutate
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | input.run((\ card=myth card.put(['value] (pails/t "Invented"))))
  + throwing
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | Seq[axal[myth]] (error (pails/t "Selected projection failed")) input
  + pure
    \ ignored=unit
    ^ row[testing/check]
    = source cartography_tests/source
      args (flow_ops/empty).put(['sources 'filing] cartography_tests/card)
      structured (flow_cartography/structure args)
      content cartography_tests/parsed
      claim content.get([($u 0)]).fall(myth/new)
      rejected (flow_cartography/validate_claims cartography_tests/subject cartography_tests/origin source
        (cartography_tests/response (cartography_tests/answer "Founded in 1800.")))
      malformed (flow_cartography/validate_claims cartography_tests/subject cartography_tests/origin source
        (cartography_tests/response "{""claims"":[],""note"":""First"",""note"":""Second""}"))
      projection (myth/sing bond/weft (spun cartography_tests/report .none))
      projected (flow_cartography/project ((flow_ops/empty).rep(['claims] content).put(['projection] projection)))
      unsafe (flow_cartography/project ((flow_ops/empty).rep(['claims] content).put(['projection] (myth/sing bond/weft (spun cartography_tests/mutate .none)))))
      broken (flow_cartography/project ((flow_ops/empty).rep(['claims] content).put(['projection] (myth/sing bond/weft (spun cartography_tests/throwing .none)))))
      a (flow_cartography/claim_origin ['a] cartography_tests/origin flow_ops/empty [[($u 0)] claim])
      collected (flow_cartography/claim_origin ['b] cartography_tests/origin a [[($u 0)] claim])
      typed (flow_cartography/claim_origin [($ta (str/to_atom "a"))] cartography_tests/origin collected [[($u 0)] claim])
      flat (collected.tap.all((\ [name card] (and (eq name.len 1) (eq (aura_tag name.at(0)) "ts")))))
      conflicting (graph_policy/report content.put([($u 1)] claim.put(['value] (pails/t "2011"))))
      valid (cartography_tests/response "{""status"":""complete"",""note"":""The selected assertion is supported.""}")
      accepted (flow_cartography/validate_review (graph_policy/report content) valid)
      disagreement (flow_cartography/validate_review conflicting valid)
      absent (flow_cartography/validate_review flow_ops/empty valid)
      waiting (flow_cartography/validate_review (graph_policy/report content)
        (cartography_tests/response "{""status"":""unresolved"",""note"":""More evidence required.""}"))
      documentation=bool
        ?> (./ok sources) structured .false
        = card=myth sources.get(['filing]).fall(myth/new)
        ?> (./some held) card.get(['flow 'documentation]) .false
        ?> parsed=flow/documentation held .false
        .true
      authored_subject (flow_cartography/subject ((flow_ops/empty).put(['subject]
        (myth/sing ['subject] (pails/p [($x 17) 'user 'company])).put(['title] (pails/t "When was it founded?")))))
      rich_subject (flow_cartography/subject ((flow_ops/empty).put(['subject]
        (myth/sing ['subject] (pails/p [($x 17) 'user 'company])).put(['title] (goo/text/pail (goo/text/en "When was it founded?"))))))
    [(testing/nat "existing importer supplies inert source structure" 1 documentation)
     (testing/nat "ordinary Semidoc attributes and heading can author the subject" 1 (either/is_ok authored_subject))
     (testing/nat "Goo rich text supplies the same authored question" 1 (equal authored_subject rich_subject))
     (testing/nat "validated claims remain ordinary native records" 1 content.wyt)
     (testing/nat "source-qualified subject is exact" 1 (equal[pail] claim.pail_at(['subject]) cartography_tests/subject))
     (testing/nat "a live subject is displayed as a live path, not an invalid zero-case citation" 1
       (cord/has "Subject: /0x11/user/company Property:" (str/to_atom (flow_cartography/summary content))))
     (testing/nat "source reference is the exact retained capture" 1 (equal[pail] claim.pail_at(['source]) cartography_tests/origin))
     (testing/text "literal quotation retained" "Founded in 2010." claim.txt_at(['quote]))
     (testing/nat "acceptance is explicit" 1 claim.nat_at(['accepted] 0))
     (testing/nat "invented quotation is refused" 1 (eq_iota (cartography_tests/reason rejected) 'cartography_uncited_claim))
     (testing/nat "duplicate result fields are refused" 1 (either/is_err malformed))
     (testing/nat "selected graph constructor projects existing claims" 1 (either/is_ok projected))
     (testing/nat "a projection cannot rewrite a cited value" 1 (either/is_err unsafe))
     (testing/nat "collected claims fit one symbol-keyed Grove member each" 1 flat)
     (testing/nat "same local claim index in two sources stays distinct" 2 collected.wyt)
     (testing/nat "source keys with equal payloads and different native auras stay distinct" 3 typed.wyt)
     (testing/text "a throwing selected projection returns a domain refusal" "cartography_projection_failed" (str/from_atom (quip_val (cartography_tests/reason broken))))
     (testing/nat "provider completion cannot override a conflict" 1 (eq_iota (cartography_tests/reason disagreement) 'cartography_conflicting_evidence))
     (testing/nat "empty evidence stays unresolved" 1 (eq_iota (cartography_tests/reason absent) 'cartography_evidence_gap))
     (testing/nat "explicit unresolved judgment stays unresolved" 1 (eq_iota (cartography_tests/reason waiting) 'cartography_judgment_unresolved))
     (testing/nat "supported review returns structured records" 1 (either/is_ok accepted))
     (testing/nat "unsupported HTML requires a selected adapter" 1
       (either/is_err (flow_cartography/structure ((flow_ops/empty).put(['sources 'html] (cartography_tests/card).put(['flow 'source] source.set_format("html")))))))
     (testing/nat "binary HTTP media cannot masquerade as plain text" 1
       (either/is_err (flow_cartography/structure ((flow_ops/empty).put(['sources 'pdf] (cartography_tests/card).put(['media] (pails/t "application/pdf")))))))]

+ tests
  ^ row[testing/case]
  | [(testing/case "Cited assertions and explicitly selected projection" cartography_tests/pure)]
