- flow_test_world [at=fixture]
- flow_request_fixture [at=provider_fixture]
- json

' Native document policy over selected current requests, with old workers and
' captures retained in the same namespace. No provider process or scheduler.
+ work_lifecycle_tests
  + started
    ^ namespace
    = state fixture/flow_tests/prepared
      state (fixture/flow_tests/poke [state.self 'gov 'flows 'request_provider]
        (myth/sing system_vocabulary/form (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
      provider=path [state.self 'gov 'flows 'document_provider]
      state (fixture/flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider provider_fixture/request_tests/provider)) state)
      state (fixture/flow_tests/apply 'author fixture/flow_tests/author
        (myth/sing ['source] (pails/t fixture/flow_revision_tests/source)).put(['expected] (pails/n state.case(.x fixture/flow_tests/author).fall(0))) state)
      state (fixture/flow_tests/apply 'publish fixture/flow_tests/author
        (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n state.case(.x fixture/flow_tests/author).fall(0))) state)
    | fixture/flow_tests/apply 'follow fixture/flow_tests/controller
        (fixture/flow_tests/follow_request).put(['provider] (safe 0 .x provider)) state
  + answer
    ^ str
    | show (json/obj [(jkv "source" (json/str (str/from_atom (joined 10 [";= Maintained concept" "  Supported by changed evidence."]))))
        (jkv "note" (json/str "The captured source supports this explanation."))])
  + read
    \ state=namespace
    ^ axal[myth]
    = record (fixture/flow_tests/get fixture/flow_tests/controller state)
    | flow_request_ops/requests (bowl [] fixture/flow_tests/controller 0 0 flow_ops/empty (sovereign_crew_of (./some record) state))
  + current_workers
    \ ignored=unit
    ^ row[testing/check]
    = first work_lifecycle_tests/started
      one (fixture/flow_revision_tests/request 1)
      three (fixture/flow_revision_tests/request 3)
      four (fixture/flow_revision_tests/request 4)
      before (fixture/flow_tests/get one first)
      changed (fixture/flow_tests/change_source "Changed source while the old provider is pending" first)
      selected (work_lifecycle_tests/read changed)
      third (fixture/flow_tests/get three changed)
      late (provider_fixture/request_tests/deliver one "complete" work_lifecycle_tests/answer changed)
      half (provider_fixture/request_tests/deliver three "complete" work_lifecycle_tests/answer late)
      done (provider_fixture/request_tests/deliver four "complete" work_lifecycle_tests/answer half)
      subscriptions=crew
        ?> held=cpail (fixture/flow_tests/get fixture/flow_tests/controller done).pail_at(crew_slot) (mop/empty)
        held.crew
      view (sovereign_view .z 0 (row/cons[iota] 'x (fixture/flow_tests/controller).weld(['cells 'work])) done)
      cells=axal[myth]
        ?> (./known held) view flow_ops/empty
        held
      jobs=row[flow_work/job]
        ?> held=flow_work/jobs (fixture/flow_tests/get fixture/flow_tests/controller done).pail_at(['flow 'jobs]) []
        held.entries
      history=bool (row/all[care] (\ car=care (equal[res[axal[saga]]] (namespace/page car first.case(car one) one first) (namespace/page car first.case(car one) one done))) [.x .y .z])
    | [(testing/nat "first document worker is actually pending" 1 (and (fixture/flow_tests/get one.snoc('worker) first).has(['work 'request]) !((fixture/flow_tests/get one.snoc('worker) first).has(['work 'outcome]))))
       (testing/nat "changed demand dispatches while historical worker is pending" 1 (fixture/flow_tests/get three.snoc('worker) changed).has(['work 'request]))
       (testing/nat "old provider has not been fabricated as completed" 0 (fixture/flow_tests/get one.snoc('worker) changed).has(['work 'outcome]))
       (testing/text "old selected attempt is settled before being unsubscribed" "waiting" (fixture/flow_tests/get one changed).txt_at(['work 'status]))
       (testing/nat "old captured evidence is unchanged" 1 (equal[pail] before.pail_at(['capture]) (fixture/flow_tests/get one done).pail_at(['capture])))
       (testing/nat "current request projection retains its draft regardless key ordering" 1 (equal[maybe[myth]] selected.get(['revision_3 'draft]) (cooperate_ops/record three.snoc('draft) changed)))
       (testing/nat "old requests are absent from current projection" 0 selected.has(['revision_1]))
       (testing/nat "late historical provider result is retained" 1 (fixture/flow_tests/get one.snoc('worker) late).has(['work 'outcome]))
       (testing/nat "late historical provider result cannot publish" 0 (fixture/flow_tests/progress late).generation)
       (testing/nat "current completion permits next current worker" 1 (fixture/flow_tests/get four.snoc('worker) half).has(['work 'request]))
       (testing/nat "current document workers publish through the existing writer" 1 (fixture/flow_tests/progress done).generation)
       (testing/nat "completed publication retains only candidate and destination subscriptions" 2 subscriptions.tap.len)
       (testing/nat "completed document Cells surface remains available" 1 (?=((./known _) view)))
       (testing/nat "completed document rows remain on the existing Cells surface" 1 (and cells.has(['concepts 'revision_3]) cells.has(['concepts 'revision_4])))
       (testing/nat "current jobs remain narrow while completed history stays visible" 1 jobs.len)
       (testing/nat "completed earlier document is absent from current jobs" 0 (jobs.any((\ job=flow_work/job (equal[path] job.request three)))))
       (testing/nat "completed publication retains no allocation probes" 0 (subscriptions.tap.any((\ e (eq_iota e.key.at(0) 'probe)))))
       (testing/nat "all earlier request x y z cases remain exact" 1 history)]
  + detached
    \ ignored=unit
    ^ row[testing/check]
    = first work_lifecycle_tests/started
      one (fixture/flow_revision_tests/request 1)
      old (fixture/flow_tests/get one first)
      request=flow_work/request
        ?> held=flow_work/request old.pail_at(['flow 'request]) (flow_work/request [] 'missing [] (pin (flow/task (flow/page 0 [] []) (pin flow_ops/empty))) [])
        held
      owner fixture/flow_tests/controller
      old_crew (crew/sing ['candidate] (dep .x (row/cons[iota] 'x owner.snoc('view)))).put(['destination] (dep .z fixture/flow_tests/destination)).put(['requests] (dep .z owner.snoc('work)))
      retained=namespace
        = notes (axal/new[note] .none).put(owner (note/make (fixture/flow_tests/get owner first).put(crew_slot (cpail old_crew))))
        ?> (./accepted committed) (namespace/step notes 0 0 first) (Seq[namespace] (error (pails/t "Retained controller fixture refused")) first)
        committed.state
      detached (fixture/flow_tests/apply 'detach owner myth/new retained)
      controller (fixture/flow_tests/get fixture/flow_tests/controller detached)
      hole (fixture/flow_tests/get request.hole detached)
      changed (fixture/flow_tests/change_source "Evidence after document detach" detached)
      late (provider_fixture/request_tests/deliver one "complete" work_lifecycle_tests/answer changed)
      subscriptions=nat
        ?> held=cpail hole.pail_at(crew_slot) 999
        held.crew.tap.len
      history=bool (row/all[care] (\ car=care (equal[res[axal[saga]]] (namespace/page car first.case(car one) one first) (namespace/page car first.case(car one) one late))) [.x .y .z])
    | [(testing/nat "detach fixture reaches command before crew reconciliation" 1 (equal[pail] (cpail old_crew) (fixture/flow_tests/get owner retained).pail_at(crew_slot)))
       (testing/nat "raw retained fixture preserves the pending request" 1 (equal[myth] old (fixture/flow_tests/get one retained)))
       (testing/text "direct detach settles retained selected document work" "waiting" (fixture/flow_tests/get one detached).txt_at(['work 'status]))
       (testing/text "direct detach also settles the undispatched current job" "waiting" (fixture/flow_tests/get (fixture/flow_revision_tests/request 2) detached).txt_at(['work 'status]))
       (testing/nat "detached document hole releases its live context" 0 subscriptions)
       (testing/nat "detached document hole stays unchanged after source edits" 1 (equal[myth] hole (fixture/flow_tests/get request.hole late)))
       (testing/nat "detached document controller stays unchanged" 1 (equal[myth] controller (fixture/flow_tests/get fixture/flow_tests/controller late)))
       (testing/nat "detached document keeps late provider evidence" 1 (fixture/flow_tests/get one.snoc('worker) late).has(['work 'outcome]))
       (testing/nat "direct detach preserves the captured document request" 1 (equal[pail] old.pail_at(['capture]) (fixture/flow_tests/get one late).pail_at(['capture])))
       (testing/nat "direct detach preserves exact earlier request x y z history" 1 history)
       (testing/nat "detached document never publishes late prose" 0 (fixture/flow_tests/progress late).generation)]
  + retained_controller
    \ ignored=unit
    ^ row[testing/check]
    = first work_lifecycle_tests/started
      owner fixture/flow_tests/controller
      one (fixture/flow_revision_tests/request 1)
      two (fixture/flow_revision_tests/request 2)
      original (fixture/flow_tests/get one first)
      old_crew (crew/sing ['candidate] (dep .x (row/cons[iota] 'x owner.snoc('view)))).put(['destination] (dep .z fixture/flow_tests/destination)).put(['requests] (dep .z owner.snoc('work)))
      resumed (fixture/flow_tests/poke owner (myth/sing crew_slot (cpail old_crew)) first)
      current=crew
        ?> held=cpail (fixture/flow_tests/get owner resumed).pail_at(crew_slot) (mop/empty)
        held.crew
      half (provider_fixture/request_tests/deliver one "complete" work_lifecycle_tests/answer resumed)
      done (provider_fixture/request_tests/deliver two "complete" work_lifecycle_tests/answer half)
    | [(testing/nat "retained document jobs select their original request and draft" 1 (and current.has(['request 'revision_1]) current.has(['draft 'revision_1])))
       (testing/nat "retained document controller releases broad work subscription" 0 current.has(['requests]))
       (testing/nat "document reconciliation preserves original attempt and capture" 1 (equal[myth] original (fixture/flow_tests/get one resumed)))
       (testing/nat "document reconciliation keeps evidence unchanged" first.case(.x fixture/flow_tests/input_path).fall(0) resumed.case(.x fixture/flow_tests/input_path).fall(0))
       (testing/nat "retained document workers finish their original jobs" 1 (fixture/flow_tests/progress done).generation)
       (testing/nat "document reconciliation did not allocate new attempts" 0 (fixture/flow_tests/get (fixture/flow_revision_tests/request 3) done).has(['capture]))]
  + unavailable
    \ ignored=unit
    ^ row[testing/check]
    = first work_lifecycle_tests/started
      one (fixture/flow_revision_tests/request 1)
      two (fixture/flow_revision_tests/request 2)
      removal=writ .cull
      missing=namespace
        ? (grove_install/changes [[fixture/flow_tests/input_path removal]] first)
         > (./ok next) next
         > (./err why) (Seq[namespace] (error (pails/q why)) first)
      late (provider_fixture/request_tests/deliver one "complete" work_lifecycle_tests/answer missing)
      repeated (fixture/flow_tests/poke fixture/flow_tests/controller myth/new late)
    | [(testing/nat "fixture has an active first provider before evidence deletion" 1 (fixture/flow_tests/get one.snoc('worker) first).has(['work 'request]))
       (testing/nat "fixture has not dispatched the second document yet" 0 (fixture/flow_tests/get two.snoc('worker) first).has(['work 'request]))
       (testing/nat "unavailable evidence does not dispatch another retained job" 0 (fixture/flow_tests/get two.snoc('worker) missing).has(['work 'request]))
       (testing/nat "late stale completion does not authorize another dispatch" 0 (fixture/flow_tests/get two.snoc('worker) repeated).has(['work 'request]))
       (testing/nat "unavailable evidence never publishes stale documents" 0 (fixture/flow_tests/progress repeated).generation)
       (testing/nat "late outcome remains retained under unavailable evidence" 1 (fixture/flow_tests/get one.snoc('worker) repeated).has(['work 'outcome]))]

+ tests
  ^ row[testing/case]
  [(testing/case "document workers follow current jobs while retaining obsolete workers" work_lifecycle_tests/current_workers)
   (testing/case "detached document work stops its owned holes" work_lifecycle_tests/detached)
   (testing/case "retained pending document controller follows its native jobs" work_lifecycle_tests/retained_controller)
   (testing/case "unavailable evidence suspends undispatched document jobs" work_lifecycle_tests/unavailable)]
