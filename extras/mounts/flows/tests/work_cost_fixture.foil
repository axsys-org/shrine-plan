- flow_request_ops

' Disposable read-cost fixture: one selected request and its worker, with
' increasing completed attempts in the same native work subtree.
+ flow_work_cost_fixture
  + owner
    ^ path
    [($x 17) 'user 'flow_cost]
  + request
    ^ path
    | (flow_work_cost_fixture/owner).weld(['work 'current])
  + make
    \ count=nat nonce=nat
    ^ namespace
    = owner=path flow_work_cost_fixture/owner
      current=path flow_work_cost_fixture/request
      deps (flow_request_ops/dependency (mop/empty) current)
      controller (native_work_ops/open owner "maintenance" myth/new).put(crew_slot (cpail deps))
      active (native_work_ops/open owner "request" myth/new).put(['nonce] (pails/n nonce))
      notes (axal/new[note] .none).put(owner (note/make controller)).put(current (note/make active)).put(current.snoc('worker) (note/make active))
      notes
        | (row/range 0 count).fold notes
          \ out=axal[note] n=nat
          = target=path owner.weld(['work ($ts (str/cat_all ["retained_" n.show]))])
            held (native_work_ops/settle "complete" "Completed retained work" (native_work_ops/open owner "request" myth/new))
            text (myth/sing ['content] (pails/t (str/repeat 1024 "x"))).put(['nonce] (pails/n (add n nonce)))
          | out.put(target (note/make held)).put(target.snoc('evidence) (note/make text)).put(target.snoc('draft) (note/make text)).put(target.snoc('worker) (note/make held)).put(target.weld(['trace 'result]) (note/make text))
      local=sov
        ?> (./accepted pair) (sov/step notes 0 0 sov/new) (Seq[sov] (error (pails/q 'cost_fixture_commit_refused)) sov/new)
        = [next signs] pair
        next
    | namespace ($x 17) local (pin (system_publication 1 sov/new (system_publication/assigned sov/new)))
  + selected
    \ state=namespace
    ^ axal[myth]
    = owner=path flow_work_cost_fixture/owner
      record (cooperate_ops/record owner state).fall(myth/new)
    | flow_request_ops/requests (bowl [] owner 0 0 flow_ops/empty (sovereign_crew_of (./some record) state))
  + prior_read
    \ state=namespace
    ^ axal[myth]
    | sovereign_peek (flow_work_cost_fixture/owner).snoc('work) state
  + size
    \ tree=axal[myth]
    ^ nat
    | tree.wyt
