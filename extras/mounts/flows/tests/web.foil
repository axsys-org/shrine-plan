- flow_web_foot
- flow_web_mount
- testing
- tests/namespace [at=fixture]
- flow_test_world [at=flow_fixture]

+ flow_web_tests
  + home
    ^ path
    [($x 17) 'io 'web]
  + target
    ^ path
    [($x 17) 'user 'research 'attempts 'first 'worker]
  + capture
    ^ native_work/captured
    | native_work/captured (safe 0 .x [($x 17) 'user 'query]) (./some 7) (pin flow_ops/empty)
  + initial
    ^ myth
    | flow_web_ops/make flow_web_tests/home flow_web_tests/target
        (native_work/request flow_web_tests/target "{""url"":""https://example.test/page.md""}" "{}" (safe 0 .x [($x 17) 'user 'guard]))
  + bowl
    \ key=path tree=axal[myth]
    ^ bowl
    | bowl [] flow_web_tests/target 0 0 flow_ops/empty (mop/put[path axal[myth] lt_pith] key tree (mop/empty))
  + reply
    \ url=str
    ^ flow_web/reply
    | flow_web/reply url (./ok (flow_web/response 200 url "text/markdown" "# Source\n\nCaptured source text."))
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = guard (flow_ops/empty).put([] (myth/sing ['capture] flow_web_tests/capture))
      sent (flow_web_ops/advance (flow_web_tests/bowl ['guard] guard) flow_web_tests/initial)
      pending (flow_web_ops/advance (flow_web_tests/bowl [] flow_ops/empty) sent.out)
      url=str "https://example.test/page.md"
      command (myth/sing ['web 'url] (pails/t url)).put(['web 'reply] (flow_web_tests/reply url))
      done (flow_web_ops/advance (flow_web_tests/bowl ['command] (flow_ops/empty).put([] command)) sent.out)
      duplicate (flow_web_ops/advance (flow_web_tests/bowl [] flow_ops/empty) done.out)
      stale (flow_web_ops/advance (flow_web_tests/bowl ['command] (flow_ops/empty).put([] command.put(['web 'url] (pails/t "https://example.test/rebound")))) sent.out)
      absent (flow_web_ops/advance (flow_web_tests/bowl ['command] flow_ops/empty) sent.out)
      failure (flow_web_ops/finish flow_web_tests/target (pin flow_web_tests/capture)
        (flow_web/reply url (./ok (flow_web/response 404 url "text/plain" "Old page is gone"))) sent.out)
      completed=native_work/outcome
        ?> result=native_work/outcome done.out.pail_at(['work 'outcome]) (native_work/outcome "missing" "" (pin flow_web_tests/capture))
        result
    [(testing/nat "one native command for dispatch" 1 sent.cards.len)
     (testing/nat "pending work does not redispatch" 0 pending.cards.len)
     (testing/text "fetch settles native activity" "complete" done.out.txt_at(['work 'status]))
     (testing/nat "result retains captured guard" 1 (equal[pin[native_work/captured]] completed.guard (pin flow_web_tests/capture)))
     (testing/nat "one frozen result cell" 1 done.cards.len)
     (testing/nat "completed request is idempotent" 0 duplicate.cards.len)
     (testing/nat "rebound command rejects late response" 0 stale.cards.len)
     (testing/nat "absent command cannot complete" 0 absent.cards.len)
     (testing/text "404 is unavailable, not current evidence" "failed" failure.out.txt_at(['work 'status]))]
  + version
    \ record=myth
    ^ saga
    | saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0)) (pin record)
  + broken
    \ url=str
    ^ flow_web/reply
    ; (Throw 7)
    | flow_web/reply url (./err "unreachable")
  + foot
    \ ignored=unit
    ^ row[testing/check]
    = empty (axal/new[saga] .none)
      command (myth/sing ['web 'url] (pails/t "https://example.test/page.md"))
      pending empty.put(['fetch] (flow_web_tests/version command))
      writes (flow_web_foot/writes flow_web_tests/reply empty pending .false)
      repeated (flow_web_foot/writes flow_web_tests/reply pending pending .false)
      restored (flow_web_foot/writes flow_web_tests/broken empty pending .true)
      thrown (flow_web_foot/writes flow_web_tests/broken empty pending .false)
      finished pending.put(['fetch] (flow_web_tests/version command.put(['web 'reply] (flow_web_tests/reply "https://example.test/page.md"))))
      settled (flow_web_foot/writes flow_web_tests/reply empty finished .false)
      recover=bool
        = [where expected reply] restored.at(0)
        ?> (./err reason) reply.result .false
        | eq reason "HTTP attempt interrupted by restart; retry through native work"
      failed=bool
        = [where expected reply] thrown.at(0)
        ?> (./err reason) reply.result .false
        | eq reason "HTTP transport threw"
    [(testing/nat "new command invokes transport" 1 writes.len)
     (testing/nat "fact replay does not repeat transport" 0 repeated.len)
     (testing/nat "restored uncertain command fails without fetching" 1 recover)
     (testing/nat "transport exception becomes retained failure" 1 failed)
     (testing/nat "settled command never fetches again" 0 settled.len)
     (testing/nat "non HTTP schemes rejected" 0 (flow_web_ops/valid_url "file:///tmp/source"))
     (testing/nat "URL controls rejected" 0 (flow_web_ops/valid_url "https://example.test/a b"))]
  + envelopes
    \ ignored=unit
    ^ row[testing/check]
    = origin (safe 1 .x (flow_web_tests/target).snoc('result))
      response (flow_web/response 200 "https://example.test/page.md" "text/markdown" "# Source\n\nCaptured evidence.")
      outcome (native_work/outcome "complete" (flow_web_ops/encode response) (pin flow_web_tests/capture))
      card (myth/sing ['work 'outcome] outcome).put(['work 'result] origin)
      args (flow_ops/empty).put(['responses 'page] card)
      decoded (flow_web_ops/sources args)
      valid=bool
        ?> (./ok sources) decoded .false
        !(either/is_err (flow_operations/inventory (flow_ops/empty).rep(['sources] sources)))
      identity=bool
        ?> (./ok sources) decoded .false
        | equal[pail] sources.get(['page]).fall(myth/new).pail_at(['flow 'origin]) origin
      json_response (flow_web/response 200 "https://example.test/data" "application/json; charset=utf-8" "[]")
      json_outcome (native_work/outcome "complete" (flow_web_ops/encode json_response) (pin flow_web_tests/capture))
      json_sources (flow_web_ops/sources (flow_ops/empty).put(['responses 'data] card.put(['work 'outcome] json_outcome)))
      json_format=str
        ?> (./ok sources) json_sources "missing"
        ?> source=flow/source sources.get(['data]).fall(myth/new).pail_at(['flow 'source]) "missing"
        source.format
      bad (flow_web_ops/sources (flow_ops/empty).put(['responses 'page] card.put(['work 'outcome] outcome.set_status("failed"))))
      missing (flow_web_ops/sources (flow_ops/empty).put(['responses 'page] (myth/sing ['work 'outcome] outcome)))
    [(testing/text "HTTP JSON reaches the structured decoder" "json" json_format)
     (testing/nat "HTTP results reuse source envelope and inventory" 1 valid)
     (testing/nat "source identity is exact retained result reference" 1 identity)
     (testing/nat "failed response never becomes source evidence" 1 (either/is_err bad))
     (testing/nat "source requires retained result provenance" 1 (either/is_err missing))]
  + requests
    \ ignored=unit
    ^ row[testing/check]
    = card (myth/sing ['url] (pails/t "https://example.test/page.md")).put(['revision] (pails/n 1))
      args (flow_ops/empty).put(['urls 'page] card)
      requested (flow_web_ops/request flow_web_tests/home args)
      repeated (flow_web_ops/request flow_web_tests/home args)
      refreshed (flow_web_ops/request flow_web_tests/home (flow_ops/empty).put(['urls 'page] card.put(['revision] (pails/n 2))))
      task=myth
        ?> (./ok tree) requested myth/new
        ?> judgment=flow/judgment tree.fil.fall(myth/new).pail_at(['flow 'judgment]) myth/new
        | (unpin judgment.tasks).get(['page]).fall(myth/new)
      provider=bool
        ?> held=native_work/provider task.pail_at(['work 'provider]) .false
        .true
    [(testing/nat "fetch operation declares native provider task" 1 provider)
     (testing/text "task carries exact bounded HTTP request" "{""url"":""https://example.test/page.md""}" task.txt_at(['work 'prompt]))
     (testing/nat "unchanged request retains task identity" 1 (equal requested repeated))
     (testing/nat "explicit revision changes captured task identity" 0 (equal requested refreshed))]
  + admission
    \ ignored=unit
    ^ row[testing/check]
    = home=path [($x 1) 'io 'web]
      target home.snoc('fetch)
      url=str "https://example.test/page.md"
      before fixture/namespace_tests/initial
      commands (axal/new[note] .none).put(target (note/make (myth/sing ['web 'url] (pails/t url))))
      state=namespace
        ?> (./accepted changed) (namespace/step commands 0 0 before) before
        changed.state
      expected=saga
        ?> (./known tree) (state.page(.x .none target)) (flow_web_tests/version myth/new)
        | tree.fil.fall((flow_web_tests/version myth/new))
      admitted (flow_web_foot/admit home ['fetch] expected (flow_web_tests/reply url) state)
      removed (flow_web_foot/admit home ['fetch] expected (flow_web_tests/reply url) before)
      rebound (flow_web_foot/admit home ['fetch] expected (flow_web_tests/reply "https://example.test/old-url") state)
      deleted=namespace
        ?> (./accepted changed) (namespace/step ((axal/new[note] .none).put(target (note/cull))) 0 0 state) state
        changed.state
      recreated=namespace
        ?> (./accepted changed) (namespace/step commands 0 0 deleted) deleted
        changed.state
      aba (flow_web_foot/admit home ['fetch] expected (flow_web_tests/reply url) recreated)
      renewed=saga
        ?> (./known tree) (recreated.page(.x .none target)) expected
        | tree.fil.fall(expected)
      fresh (flow_web_foot/admit home ['fetch] renewed (flow_web_tests/reply url) recreated)
      count={\ either[iota row[[p=path q=writ]]]}nat
        \ answer=either[iota row[[p=path q=writ]]]
        ?> (./ok writes) answer 999
        writes.len
    [(testing/nat "current native command admits response" 1 (count admitted))
     (testing/nat "late response cannot recreate removed command" 0 (count removed))
     (testing/nat "late response cannot publish for rebound URL" 0 (count rebound))
     (testing/nat "same URL recreated command cannot borrow old response" 0 (count aba))
     (testing/nat "new assertion admits its own response" 1 (count fresh))]
  + authored
    ' Receive the actual example bytes from the disposable fixture, then use
    ' exactly the ordinary Nenex author and publish native operations.
    \ source=str capture_source=str ignored=unit
    ^ row[testing/check]
    ?> (./ok state) (flow_web_mount/install flow_fixture/flow_tests/initial)
      [(testing/nat "optional web operations install in the disposable world" 1 0)]
    = child=path [($x 17) 'app 'nenex 'w 'capture_sources_flow]
      state (flow_fixture/flow_tests/apply 'author child
        (myth/sing ['source] (pails/t capture_source)).put(['expected] (pails/n 0)) state)
      state (flow_fixture/flow_tests/apply 'publish child
        (myth/sing ['id] (pails/t "capture_sources")).put(['expected] (pails/n state.case(.x child).fall(0))) state)
      target=path [($x 17) 'app 'nenex 'w 'web_guide_flow]
      authored (flow_fixture/flow_tests/apply 'author target
        (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0)) state)
      published (flow_fixture/flow_tests/apply 'publish target
        (myth/sing ['id] (pails/t "web_source_guide")).put(['expected] (pails/n authored.case(.x target).fall(0))) authored)
      record (cooperate_ops/record target.weld(['flows 'web_source_guide]) published).fall(myth/new)
    ?> definition=flow/definition record.pail_at((flow_ops/key published.self 'definition))
      [(testing/nat "actual Semidoc example publishes" 1 0)]
    [(testing/nat "actual Semidoc example publishes through Nenex" 4 definition.steps.len)
     (testing/nat "URL input port retained" 1 (equal[row[iota]] definition.inputs ['urls]))
     (testing/nat "fetch operation port is explicit" 1 (equal[row[iota]] (unpin definition.steps.at(0).law).ports ['urls]))
     (testing/nat "source validation port is explicit" 1 (equal[row[iota]] (unpin definition.steps.at(1).law).ports ['sources]))
     (testing/nat "composed document step keeps both bindings" 2 definition.steps.at(3).bindings.len)
     (testing/nat "published operations keep exact implementation references" 1 (definition.steps.all((\ step=flow/step (gt step.origin.ver 0)))))]
  + url_fields
    \ url=str
    ^ row[[str str]]
    | [["action" "bind_url"] ["page" (path_show flow_fixture/flow_tests/author)]
       ["source_name" "manual"] ["source_url" url]]
  + ui_apply
    \ fields=row[[str str]] state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (flow_fixture/flow_tests/plan fields) state (sovereign_hive state))
    | flow_fixture/flow_tests/accepted reply next
  + source_updates
    \ ignored=unit
    ^ row[testing/check]
    = old=str "https://example.test/old.md"
      next=str "https://example.test/current.md"
      target=path (flow_fixture/flow_tests/author).weld(['inputs 'urls 'manual])
      bound (flow_web_tests/ui_apply (flow_web_tests/url_fields old) flow_fixture/flow_tests/prepared)
      annotated (flow_fixture/flow_tests/poke target (myth/sing ['revision] (pails/n 7)).put(['note] (pails/t "Keep this source annotation")) bound)
      fields (flow_web_tests/url_fields next).snoc(["previous_url" old])
      changed (flow_web_tests/ui_apply fields annotated)
      repeated (flow_web_tests/ui_apply (flow_web_tests/url_fields next) changed)
      unguarded (flow_fixture/flow_tests/plan (flow_web_tests/url_fields "https://example.test/other.md") changed)
      stale_fields (flow_web_tests/url_fields "https://example.test/other.md").snoc(["previous_url" old])
      stale (flow_fixture/flow_tests/plan stale_fields changed)
      refused (namespace_command/admit (flow_fixture/flow_tests/plan stale_fields) changed (sovereign_hive changed))
      retained (row/all[care] (\ car=care (equal (namespace/page car annotated.case(car target) target annotated)
        (namespace/page car annotated.case(car target) target changed))) [.x .y .z])
    [(testing/text "bind creates the ordinary URL record" old (flow_fixture/flow_tests/get target bound).txt_at(['url]))
     (testing/text "guarded update changes the same source" next (flow_fixture/flow_tests/get target changed).txt_at(['url]))
     (testing/nat "update preserves revision and other source metadata" 1
       (and (eq (flow_fixture/flow_tests/get target changed).nat_at(['revision] 0) 7)
         (eq (flow_fixture/flow_tests/get target changed).txt_at(['note]) "Keep this source annotation")))
     (testing/nat "same URL does not rewrite its source record" 1 (equal repeated.case(.x target) changed.case(.x target)))
     (testing/text "creation form cannot overwrite another URL" "flow_source_collision" (flow_fixture/flow_tests/reason unguarded))
     (testing/text "stale displayed URL is refused" "flow_stale_source" (flow_fixture/flow_tests/reason stale))
     (testing/nat "stale update fails native admission" 1 (either/is_err refused))
     (testing/nat "old x y z source history is unchanged" 1 retained)]
  + fetch_actor
    \ url=str self=nat
    ^ nat
    = ;[message caps] (Recv[nat] 0)
      ;reply (flow_web_foot/fetch url)
    ; (Send caps.at(0) reply)
    | CloseHandle caps.at(0)
  + transport
    ' The disposable host fixture binds an ephemeral loopback URL. No external
    ' service or live world participates in this test.
    \ root=str ignored=unit
    ^ row[testing/check]
    = ;actor (Spawn (flow_web_tests/fetch_actor (str/cat_all [root "/source.md"])))
    ; (SendCaps actor 0 [0])
    = ;[good caps] (Recv[flow_web/reply] 0)
    ; (helm/supervisor/close_caps caps)
    ; (CloseHandle actor)
    = ;gone (flow_web_foot/fetch (str/cat_all [root "/missing"]))
      ;back (flow_web_foot/fetch (str/cat_all [root "/source.md"]))
      good_status=nat
        ?> (./ok response) good.result 0
        response.status
      good_content=str
        ?> (./ok response) good.result ""
        response.content
      missing (flow_web_ops/finish flow_web_tests/target (pin flow_web_tests/capture) gone flow_web_tests/initial)
      restored (flow_web_ops/finish flow_web_tests/target (pin flow_web_tests/capture) back flow_web_tests/initial)
    [(testing/nat "native Fetch reaches loopback HTTP" 200 good_status)
     (testing/text "native Fetch preserves source bytes" "# Fixture source" good_content)
     (testing/text "native HTTP 404 remains failed work" "failed" missing.out.txt_at(['work 'status]))
     (testing/text "new restored source attempt succeeds" "complete" restored.out.txt_at(['work 'status]))]

+ tests
  ^ row[testing/case]
  [(testing/case "native HTTP work lifecycle" flow_web_tests/lifecycle)
   (testing/case "native HTTP foot delivery" flow_web_tests/foot)
   (testing/case "native HTTP source envelopes" flow_web_tests/envelopes)
   (testing/case "native HTTP guarded admission" flow_web_tests/admission)
   (testing/case "authored HTTP requests" flow_web_tests/requests)
   (testing/case "guarded Nenex web source updates" flow_web_tests/source_updates)]
