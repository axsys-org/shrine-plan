- flow_action_ops
- flow_ui_tests
- flow_test_world
- flow_request_fixture [at=request_fixture]
- tests/goo_runtime [at=goo_fixture]

+ flow_action_tests
  + worker
    ^ path
    [($x 17) 'app 'action_test 'work 'first 'worker]
  + guard
    ^ native_work/captured
    | native_work/captured (safe 0 .x [($x 17) 'app 'action_test 'input]) (./some 1)
        (pin (flow_ops/empty).put([] (myth/sing ['value] (pails/n 1))))
  + bowl
    \ captured=native_work/captured receipts=myth
    ^ bowl
    = views (mop/put[path axal[myth] lt_pith] ['guard] (flow_ops/empty).put([] (myth/sing ['capture] captured)) (mop/empty))
      views views.put(['receipts] (flow_ops/empty).put([] receipts))
    | bowl [] flow_action_tests/worker 0 0 flow_ops/empty views
  + prepared
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_fixture/goo_runtime_checks/setup [])
      prepared (flow_action_ops/prepare query.set_expected(0) state)
      selected (either/ok_val prepared).fil.fall(myth/new)
      captured=goo_runtime/request
        ?> held=goo_runtime/request selected.pail_at(['goo 'request]) query.set_expected(0)
        held
      target=path [state.self 'app 'action_test 'cells 'chosen]
      plan (flow_action_ops/capture target (myth/sing ['goo 'request] query) state)
      [installed index reply] (helm/supervisor/admit (flow_action_ops/capture target (myth/sing ['goo 'request] query)) state (sovereign_hive state))
      retained (native_work_ops/captured_at (sovereign_care .x target installed))
      tasks (flow_action_ops/request (flow_ops/empty).rep(['actions 'save] (either/ok_val prepared)))
      judgment=flow/judgment
        ?> held=flow/judgment (either/ok_val tasks).fil.fall(myth/new).pail_at(['flow 'judgment]) (flow/judgment (pin flow_ops/empty))
        held
      task (unpin judgment.tasks).get(['save]).fall(myth/new)
      invalid (flow_action_ops/prepare query.set_inputs(query.inputs.snoc(["$invocation" "caller-owned"])) state)
      duplicate (flow_action_ops/prepare query.set_inputs(query.inputs.weld(query.inputs)) state)
      occupied (flow_action_ops/capture target (myth/sing ['goo 'request] query) installed)
      outside (flow_action_ops/capture [($x 18) 'app 'capture] (myth/sing ['goo 'request] query) state)
      missing (flow_action_ops/prepare query.set_control([99]) state)
    [(testing/nat "declared action prepares headlessly" 1 (either/is_ok prepared))
     (testing/nat "preparation captures current receiver version" query.expected captured.expected)
     (testing/nat "preparation retains argument values" 1 selected.has(['goo 'arguments]))
     (testing/nat "preparation retains subject and publication" 1 (and selected.has(['goo 'subject]) selected.has(['goo 'publication])))
     (testing/nat "preparation names exact view publication" 1 (equal[pail] selected.pail_at(['goo 'origin]) (safe state.case(.x query.view).fall(0) .x query.view)))
     (testing/nat "preparation names exact receiver snapshot" 1 (equal[pail] selected.pail_at(['goo 'subject_origin]) (safe query.expected .x query.subject)))
     (testing/nat "selection plans ordinary frozen cell" 1 (either/is_ok plan))
     (testing/nat "selection uses native captured cell" 1 retained.is_some)
     (testing/nat "request operation emits shared judgment" 1 (either/is_ok tasks))
     (testing/nat "task carries existing provider contract" 1 task.has(['work 'provider]))
     (testing/nat "invocation identity belongs to work attempt" 1 (either/is_err invalid))
     (testing/nat "duplicate input fields are refused" 1 (either/is_err duplicate))
     (testing/nat "capture cannot overwrite prior selection" 1 (either/is_err occupied))
     (testing/nat "capture respects namespace authority" 1 (either/is_err outside))
     (testing/nat "unknown declared control is refused" 1 (either/is_err missing))]
  + receipts
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_fixture/goo_runtime_checks/setup [])
      request (native_work/request flow_action_tests/worker "Execute selected action" "{}" (flow_action_tests/guard).source)
      original (flow_action_ops/make query flow_action_tests/worker request)
      waiting (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard myth/new) original)
      retained=goo_runtime/request
        ?> held=goo_runtime/request original.pail_at(['goo 'request]) query
        held
      [acted code body] (goo_runtime/act retained.set_now(123) state)
      journal (goo_runtime/record .x [state.self 'weft 'goo_receipts] acted).fall(myth/new)
      done (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard journal) waiting.out)
      again (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard journal) done.out)
      [replayed replay_code replay_body] (goo_runtime/act retained acted)
      wrong (myth/sing goo_runtime/receipt_slot (goo_runtime/receipts
        (list/one (goo_runtime/receipt (flow_action_ops/identity flow_action_tests/worker) retained.set_inputs([]) body))))
      collision (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard wrong) waiting.out)
      newer (flow_action_tests/guard).set_observed((./some 2))
      stale (flow_action_ops/advance (flow_action_tests/bowl newer journal) waiting.out)
      superseded (flow_action_ops/advance (flow_action_tests/bowl newer myth/new) waiting.out)
      [late_effect late_code late_body] (goo_runtime/act retained state)
      late_journal (goo_runtime/record .x [state.self 'weft 'goo_receipts] late_effect).fall(myth/new)
      late_result (flow_action_ops/advance (flow_action_tests/bowl newer late_journal) superseded.out)
      worker_path=path flow_action_tests/worker
      next_worker=path (row/snoc[iota] 'retry_worker worker_path.take(worker_path.len.dec))
      retry (flow_action_ops/make query next_worker request)
      retry_query=goo_runtime/request
        ?> held=goo_runtime/request retry.pail_at(['goo 'request]) retained
        held
    [(testing/nat "hand emits one native command" 1 waiting.cards.len)
     (testing/nat "headless native invocation succeeds" 200 code)
     (testing/text "existing Goo action applies arguments" "After" (goo_runtime/record .x query.target acted).fall(myth/new).txt_at(system_vocabulary/req))
     (testing/text "exact invocation receipt completes native work" "complete" done.out.txt_at(['work 'status]))
     (testing/nat "completion creates ordinary result cell" 1 done.cards.len)
     (testing/nat "repeated receipt creates no new result" 0 again.cards.len)
     (testing/nat "native invocation replay remains idempotent" 1 (and (eq replay_code 200) (equal[namespace] replayed acted)))
     (testing/text "changed request cannot borrow a receipt" "failed" collision.out.txt_at(['work 'status]))
     (testing/text "changed guard refuses retained action outcome" "failed" stale.out.txt_at(['work 'status]))
     (testing/nat "task supersession does not revoke external Goo authority" 200 late_code)
     (testing/text "late accepted effect cannot revive superseded result" "failed" late_result.out.txt_at(['work 'status]))
     (testing/nat "late receipt cannot replace retained failure result" 0 late_result.cards.len)
     (testing/nat "retry owns distinct invocation identity" 0 (equal[goo_runtime/request] retry_query retained))
     (testing/nat "worker exposes native action form fields" 1 (str/find "invocation" original.txt_at(['goo 'fields])).is_some)]
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /author" "  ;@ /flow/definition handbook" "  ;= Declared action flow"
       "    ;@ /flow/input sources" "    ;= Selected actions"
       "    ;@ /flow/step acted ;/0x11/gov/flows/operations/test_action"
       "    ;@ /flow/bind actions sources" "    ;= Request action"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/test_pages"
       "    ;@ /flow/bind responses acted" "    ;= Present native receipt"
       "    ;@ /flow/result pages" "    ;= Output"])
  + hold
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | ./ok []
  + waiting
    ^ [namespace goo_runtime/request]
    | flow_action_tests/start .false
  + started
    ^ [namespace goo_runtime/request]
    | flow_action_tests/start .true
  + start
    \ automatic=bool
    ^ [namespace goo_runtime/request]
    = [sample query] (goo_fixture/goo_runtime_checks/setup [])
      state flow_tests/initial
      state (flow_tests/poke query.view (goo_runtime/record .x query.view sample).fall(myth/new) state)
      state (flow_tests/poke query.target (goo_runtime/record .x query.target sample).fall(myth/new) state)
      state (flow_tests/poke [state.self 'gov 'flows 'action_work] (myth/sing system_vocabulary/form flow_action_ops/form) state)
      state (? automatic state (flow_tests/poke (flow_ops/key state.self 'execute_action) (myth/sing system_vocabulary/op (namespace_op flow_action_tests/hold)) state))
      ops=path [state.self 'gov 'flows 'operations]
      state (flow_tests/poke ops.snoc('test_action) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['actions] flow_action_ops/request)) state)
      state (flow_tests/poke ops.snoc('test_pages) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['responses] request_fixture/request_tests/pages)) state)
      state (flow_tests/apply 'author flow_tests/author (myth/sing ['source] (pails/t flow_action_tests/source)).put(['expected] (pails/n 0)) state)
      state (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n state.case(.x flow_tests/author).fall(0))) state)
      state (flow_tests/apply 'follow flow_tests/controller flow_tests/follow_request state)
      prepared (either/ok_val (flow_action_ops/prepare query state))
      state (flow_tests/poke flow_tests/input_path prepared.fil.fall(myth/new) state)
      worker (request_fixture/request_tests/attempt 1).snoc('worker)
      query=goo_runtime/request
        ?> held=goo_runtime/request (flow_tests/get worker state).pail_at(['goo 'request]) query
        held
    | [state query]
  + execute
    \ worker=path state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (flow_action_ops/execute worker myth/new) state (sovereign_hive state))
    next
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = [first query] flow_action_tests/waiting
      attempt=path (request_fixture/request_tests/attempt 1)
      worker=path attempt.snoc('worker)
      hole=path (flow_tests/get attempt first).path_at(['work 'hole_path]).fall([])
      done=namespace (flow_action_tests/execute worker first)
      again=namespace (flow_action_tests/execute worker done)
      [automatic automatic_query] flow_action_tests/started
      changed=namespace (flow_tests/poke query.target (myth/sing system_vocabulary/req (pails/t "Changed before invocation")) first)
      refused=namespace (flow_action_tests/execute worker changed)
      [missing index reply] (helm/supervisor/step flow_tests/input_path .cull 0 0 refused (sovereign_hive refused))
      prepared (either/ok_val (flow_action_ops/prepare query.set_inputs(query.inputs.keep((\ [key value] !(eq key "$invocation")))) missing))
      rebound=namespace (flow_tests/poke flow_tests/input_path prepared.fil.fall(myth/new) missing)
      replacement=path (request_fixture/request_tests/attempt 2)
      resumed=namespace (flow_action_tests/execute replacement.snoc('worker) rebound)
      paused=namespace (flow_tests/apply 'set_enabled flow_tests/controller (myth/sing ['enabled] (pails/b .false)) first)
      paused_done=namespace (flow_action_tests/execute worker paused)
      detached=namespace (flow_tests/apply 'detach flow_tests/controller myth/new first)
      detached_done=namespace (flow_action_tests/execute worker detached)
      superseded=namespace (flow_tests/poke flow_tests/input_path (myth/sing ['unavailable] (pails/b .true)) first)
      late=namespace (flow_action_tests/execute worker superseded)
      tampered_query query.set_inputs(query.inputs.map((\ [key value] [key (? (eq key "/sys/req") "Unselected argument" value)])))
      tampered=namespace (flow_tests/poke worker (myth/sing ['goo 'request] tampered_query) first)
      tampered_done=namespace (flow_action_tests/execute worker tampered)
      retained (row/all[care] (\ car (equal (namespace/page car first.case(car attempt) attempt first) (namespace/page car first.case(car attempt) attempt resumed))) [.x .y .z])
    [(testing/text "hand automatically executes through shared admission" "After" (flow_tests/get automatic_query.target automatic).txt_at(system_vocabulary/req))
     (testing/text "automatic action result drives next composed step" "complete" (flow_tests/get attempt automatic).txt_at(['work 'status]))
     (testing/nat "composed result reaches selected writer" 1 (flow_tests/get flow_tests/destination automatic).has(['src]))
     (testing/nat "action uses shared persistent hole" 1 (flow_tests/get hole first).has(['work 'hole]))
     (testing/nat "action retains ordinary context overlay" 1 (flow_tests/get attempt.snoc('view) first).has(bond/weft))
     (testing/text "guarded action applies declared arguments" "After" (flow_tests/get query.target done).txt_at(system_vocabulary/req))
     (testing/text "receipt resolves shared hole" "resolved" (flow_tests/get hole done).txt_at(['work 'status]))
     (testing/nat "repeated command cannot replay an effect" done.local.top again.local.top)
     (testing/text "stale receiver is not changed" "Changed before invocation" (flow_tests/get query.target refused).txt_at(system_vocabulary/req))
     (testing/text "stale action retains a failed outcome" "failed" (flow_tests/get worker refused).txt_at(['work 'status]))
     (testing/text "failed action leaves a persistent hole" "waiting" (flow_tests/get hole refused).txt_at(['work 'status]))
     (testing/nat "missing evidence produces no effect receipt" 0 (goo_runtime/journal missing).len)
     (testing/text "restored evidence resumes through a new attempt" "complete" (flow_tests/get replacement resumed).txt_at(['work 'status]))
     (testing/text "restoration resolves existing hole" "resolved" (flow_tests/get hole resumed).txt_at(['work 'status]))
     (testing/text "paused flow cannot execute" "Before" (flow_tests/get query.target paused_done).txt_at(system_vocabulary/req))
     (testing/text "detached flow cannot execute" "Before" (flow_tests/get query.target detached_done).txt_at(system_vocabulary/req))
     (testing/text "superseded evidence cannot execute" "Before" (flow_tests/get query.target late).txt_at(system_vocabulary/req))
     (testing/nat "obsolete work cannot obtain a success receipt" 0 (goo_runtime/journal late).len)
     (testing/text "worker edits cannot replace captured action arguments" "Before" (flow_tests/get query.target tampered_done).txt_at(system_vocabulary/req))
     (testing/nat "unselected arguments cannot obtain a receipt" 0 (goo_runtime/journal tampered_done).len)
     (testing/text "old failure remains retained after resumption" "failed" (flow_tests/get worker resumed).txt_at(['work 'status]))
     (testing/nat "all original attempt x y z history survives" 1 retained)]
  + document_controls
    \ ignored=unit
    ^ row[testing/check]
    = [sample query] (goo_fixture/goo_runtime_checks/setup [])
      state=namespace flow_tests/prepared
      state (flow_tests/poke query.view (flow_tests/get query.view sample) state)
      state (flow_tests/poke query.target (flow_tests/get query.target sample) state)
      fields=row[[str str]] [["action" "inspect_actions"] ["page" (path_show flow_tests/author)]
        ["selection_name" "controls"] ["object" (path_show query.target)] ["view" (path_show query.view)]]
      [inspected index reply] (helm/supervisor/admit (flow_ui/plan fields) state (sovereign_hive state))
      catalogue=path (flow_tests/author).weld(['cells 'controls])
      rendered (weft/render (weft/el "div" [] (flow_ui/render flow_tests/author (sovereign_peek flow_tests/author inspected))))
      binding (rex/rune "=" [(rex/quip "'/sys/req") (goo_fixture/goo_runtime_checks/expression ".input(card.req)")]).print
      select=row[[str str]] [["action" "select_action"] ["page" (path_show flow_tests/author)]
        ["catalogue" "controls"] ["control" "/0/0"] ["selection_name" "save"] ["argument/sys/req" "From the document"]]
      [selected index reply] (helm/supervisor/admit (flow_ui/plan select) inspected index)
      cell=path (flow_tests/author).weld(['cells 'save])
      frozen (native_work_ops/captured_at (sovereign_care .x cell selected))
      captured (unpin frozen.fall((flow_action_tests/guard)).value).fil.fall(myth/new)
      changed (flow_tests/poke query.target (myth/sing system_vocabulary/req (pails/t "Changed")) inspected)
      stale (flow_ui/plan select changed)
    [(testing/nat "document inspection creates a native captured cell" 1 (flow_tests/get catalogue inspected).has(['capture]))
     (testing/nat "document exposes declared action label" 1 (cord/has "Save" rendered))
     (testing/nat "document exposes declared text argument" 1 (cord/has "argument/sys/req" rendered))
     (testing/nat "document exposes exact declared binding and admission constraints" 1 (and (cord/has (weft/esc (str/to_atom binding)) rendered) (cord/has "current work" rendered)))
     (testing/nat "document selection creates ordinary frozen action" 1 frozen.is_some)
     (testing/nat "selected action carries prepared native arguments" 1 captured.has(['goo 'arguments]))
     (testing/text "inspection and selection do not execute actions" "Before" (flow_tests/get query.target selected).txt_at(system_vocabulary/req))
     (testing/text "stale inspection cannot silently rebind an action" "flow_stale_selection" (flow_tests/reason stale))
     (testing/nat "inspection capture remains unchanged" 1 (equal[myth] (flow_tests/get catalogue inspected) (flow_tests/get catalogue selected)))]
  + rich_controls
    \ ignored=unit
    ^ row[testing/check]
    = [sample query] (goo_fixture/goo_runtime_checks/setup [])
      card (flow_tests/get query.view sample)
      published (either/ok_val (goo_runtime/published card))
      group published.view.children.head
      rich (goo/node rex/zero_span "input" (list/cons[rex] (rex/quip "'/sys/req") (list/one (rex/cord "rich-block"))) .nil)
      view published.view.set_children((list/one group.set_children((list/cons[goo/node] rich group.children))))
      published published.set_view(view).set_result((./ok view))
      state=namespace flow_tests/prepared
      state (flow_tests/poke query.view card.put(system_vocabulary/grove/view published) state)
      state (flow_tests/poke query.target (flow_tests/get query.target sample) state)
      fields=row[[str str]] [["action" "inspect_actions"] ["page" (path_show flow_tests/author)]
        ["selection_name" "rich_controls"] ["object" (path_show query.target)] ["view" (path_show query.view)]]
      inspected=namespace (flow_ui_tests/act fields state)
      select=row[[str str]] [["action" "select_action"] ["page" (path_show flow_tests/author)]
        ["catalogue" "rich_controls"] ["control" "/0/1"] ["selection_name" "rich_save"] ["argument/sys/req" "Plain authored text"]]
      selected=namespace (flow_ui_tests/act select inspected)
      cell=path (flow_tests/author).weld(['cells 'rich_save])
      captured (native_work_ops/captured_at (sovereign_care .x cell selected))
      record (unpin captured.fall((flow_action_tests/guard)).value).fil.fall(myth/new)
    ?> retained=goo_runtime/request record.pail_at(['goo 'request])
      [(testing/text "rich control selection succeeds" "ok" (flow_tests/reason (flow_ui/plan select inspected)))]
    = text (goo_runtime/input_text "/sys/req" retained)
      decoded (goo_edit/decode (pails/t text))
      rendered (weft/render (weft/el "div" [] (flow_ui/render flow_tests/author (sovereign_peek flow_tests/author inspected))))
    | [(testing/nat "declared rich input uses native Goo encoding" 1 decoded.is_some)
       (testing/text "plain authored text round trips through rich codec" "Plain authored text" decoded.fall((goo/text/pail [])).value.plain)
       (testing/nat "rich action form exposes textarea" 1 (cord/has "<textarea" rendered))
       (testing/text "rich input selection has no effect" "Before" (flow_tests/get query.target selected).txt_at(system_vocabulary/req))]
+ tests
  ^ row[testing/case]
  [(testing/case "rich controls through native encoder" flow_action_tests/rich_controls)
   (testing/case "native action selection" flow_action_tests/prepared)
   (testing/case "declared actions through Nenex" flow_action_tests/document_controls)
   (testing/case "native invocation receipts" flow_action_tests/receipts)
   (testing/case "authored flow action lifecycle" flow_action_tests/lifecycle)]
