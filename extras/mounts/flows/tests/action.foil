- flow_action_ops
- tests/flows
- flow_request_tests [at=request_fixture]
- tests/goo_runtime [at=goo_fixture]

+ flow_action_tests
  + worker
    ^ path
    [($x 17) 'app 'action_test 'work 'first 'worker]
  + guard
    ^ native_work/captured
    | native_work/captured (safe 0 .x [($x 17) 'app 'action_test 'input]) (./some 1)
        (pin (flow_ops/empty).put([] (myth/sing ['value] (pails/n 1))))
  + bowl
    \ captured=native_work/captured receipts=myth
    ^ bowl
    = views (mop/put[path axal[myth] lt_pith] ['guard] (flow_ops/empty).put([] (myth/sing ['capture] captured)) (mop/empty))
      views views.put(['receipts] (flow_ops/empty).put([] receipts))
    | bowl [] flow_action_tests/worker 0 0 flow_ops/empty views
  + prepared
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_fixture/goo_runtime_checks/setup [])
      prepared (flow_action_ops/prepare query.set_expected(0) state)
      selected (either/ok_val prepared).fil.fall(myth/new)
      captured=goo_runtime/request
        ?> held=goo_runtime/request selected.pail_at(['goo 'request]) query.set_expected(0)
        held
      target=path [state.self 'app 'action_test 'cells 'chosen]
      plan (flow_action_ops/capture target (myth/sing ['goo 'request] query) state)
      [installed index reply] (helm/supervisor/admit (flow_action_ops/capture target (myth/sing ['goo 'request] query)) state (sovereign_hive state))
      retained (native_work_ops/captured_at (sovereign_care .x target installed))
      tasks (flow_action_ops/request (flow_ops/empty).rep(['actions 'save] (either/ok_val prepared)))
      judgment=flow/judgment
        ?> held=flow/judgment (either/ok_val tasks).fil.fall(myth/new).pail_at(['flow 'judgment]) (flow/judgment (pin flow_ops/empty))
        held
      task (unpin judgment.tasks).get(['save]).fall(myth/new)
      invalid (flow_action_ops/prepare query.set_inputs(query.inputs.snoc(["$invocation" "caller-owned"])) state)
      duplicate (flow_action_ops/prepare query.set_inputs(query.inputs.weld(query.inputs)) state)
      occupied (flow_action_ops/capture target (myth/sing ['goo 'request] query) installed)
      outside (flow_action_ops/capture [($x 18) 'app 'capture] (myth/sing ['goo 'request] query) state)
      missing (flow_action_ops/prepare query.set_control([99]) state)
    [(testing/nat "declared action prepares headlessly" 1 (either/is_ok prepared))
     (testing/nat "preparation captures current receiver version" query.expected captured.expected)
     (testing/nat "preparation retains argument values" 1 selected.has(['goo 'arguments]))
     (testing/nat "preparation retains subject and publication" 1 (and selected.has(['goo 'subject]) selected.has(['goo 'publication])))
     (testing/nat "preparation names exact view publication" 1 (equal[pail] selected.pail_at(['goo 'origin]) (safe state.case(.x query.view).fall(0) .x query.view)))
     (testing/nat "preparation names exact receiver snapshot" 1 (equal[pail] selected.pail_at(['goo 'subject_origin]) (safe query.expected .x query.subject)))
     (testing/nat "selection plans ordinary frozen cell" 1 (either/is_ok plan))
     (testing/nat "selection uses native captured cell" 1 retained.is_some)
     (testing/nat "request operation emits shared judgment" 1 (either/is_ok tasks))
     (testing/nat "task carries existing provider contract" 1 task.has(['work 'provider]))
     (testing/nat "invocation identity belongs to work attempt" 1 (either/is_err invalid))
     (testing/nat "duplicate input fields are refused" 1 (either/is_err duplicate))
     (testing/nat "capture cannot overwrite prior selection" 1 (either/is_err occupied))
     (testing/nat "capture respects namespace authority" 1 (either/is_err outside))
     (testing/nat "unknown declared control is refused" 1 (either/is_err missing))]
  + receipts
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_fixture/goo_runtime_checks/setup [])
      request (native_work/request flow_action_tests/worker "Execute selected action" "{}" (flow_action_tests/guard).source)
      original (flow_action_ops/make query flow_action_tests/worker request)
      waiting (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard myth/new) original)
      retained=goo_runtime/request
        ?> held=goo_runtime/request original.pail_at(['goo 'request]) query
        held
      [acted code body] (goo_runtime/act retained.set_now(123) state)
      journal (goo_runtime/record .x [state.self 'weft 'goo_receipts] acted).fall(myth/new)
      done (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard journal) waiting.out)
      again (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard journal) done.out)
      [replayed replay_code replay_body] (goo_runtime/act retained acted)
      wrong (myth/sing goo_runtime/receipt_slot (goo_runtime/receipts
        (list/one (goo_runtime/receipt (flow_action_ops/identity flow_action_tests/worker) retained.set_inputs([]) body))))
      collision (flow_action_ops/advance (flow_action_tests/bowl flow_action_tests/guard wrong) waiting.out)
      newer (flow_action_tests/guard).set_observed((./some 2))
      stale (flow_action_ops/advance (flow_action_tests/bowl newer journal) waiting.out)
      superseded (flow_action_ops/advance (flow_action_tests/bowl newer myth/new) waiting.out)
      [late_effect late_code late_body] (goo_runtime/act retained state)
      late_journal (goo_runtime/record .x [state.self 'weft 'goo_receipts] late_effect).fall(myth/new)
      late_result (flow_action_ops/advance (flow_action_tests/bowl newer late_journal) superseded.out)
      worker_path=path flow_action_tests/worker
      next_worker=path (row/snoc[iota] 'retry_worker worker_path.take(worker_path.len.dec))
      retry (flow_action_ops/make query next_worker request)
      retry_query=goo_runtime/request
        ?> held=goo_runtime/request retry.pail_at(['goo 'request]) retained
        held
    [(testing/nat "request does not invoke during recomputation" 0 waiting.cards.len)
     (testing/nat "headless native invocation succeeds" 200 code)
     (testing/text "existing Goo action applies arguments" "After" (goo_runtime/record .x query.target acted).fall(myth/new).txt_at(system_vocabulary/req))
     (testing/text "exact invocation receipt completes native work" "complete" done.out.txt_at(['work 'status]))
     (testing/nat "completion creates ordinary result cell" 1 done.cards.len)
     (testing/nat "repeated receipt creates no new result" 0 again.cards.len)
     (testing/nat "native invocation replay remains idempotent" 1 (and (eq replay_code 200) (equal[namespace] replayed acted)))
     (testing/text "changed request cannot borrow a receipt" "failed" collision.out.txt_at(['work 'status]))
     (testing/text "changed guard refuses retained action outcome" "failed" stale.out.txt_at(['work 'status]))
     (testing/nat "task supersession does not revoke external Goo authority" 200 late_code)
     (testing/text "late accepted effect cannot revive superseded result" "failed" late_result.out.txt_at(['work 'status]))
     (testing/nat "late receipt cannot replace retained failure result" 0 late_result.cards.len)
     (testing/nat "retry owns distinct invocation identity" 0 (equal[goo_runtime/request] retry_query retained))
     (testing/nat "worker exposes native action form fields" 1 (str/find "invocation" original.txt_at(['goo 'fields])).is_some)]
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /author" "  ;@ /flow/definition handbook" "  ;= Declared action flow"
       "    ;@ /flow/input sources" "    ;= Selected actions"
       "    ;@ /flow/step acted ;/0x11/gov/flows/operations/test_action"
       "    ;@ /flow/bind actions sources" "    ;= Request action"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/test_pages"
       "    ;@ /flow/bind responses acted" "    ;= Present native receipt"
       "    ;@ /flow/result pages" "    ;= Output"])
  + started
    ^ [namespace goo_runtime/request]
    = [sample query] (goo_fixture/goo_runtime_checks/setup [])
      state flow_tests/initial
      state (flow_tests/poke query.view (goo_runtime/record .x query.view sample).fall(myth/new) state)
      state (flow_tests/poke query.target (goo_runtime/record .x query.target sample).fall(myth/new) state)
      state (flow_tests/poke [state.self 'gov 'flows 'action_work] (myth/sing system_vocabulary/form flow_action_ops/form) state)
      ops=path [state.self 'gov 'flows 'operations]
      state (flow_tests/poke ops.snoc('test_action) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['actions] flow_action_ops/request)) state)
      state (flow_tests/poke ops.snoc('test_pages) (myth/sing (flow_ops/key state.self 'operation) (flow/operation ['responses] request_fixture/request_tests/pages)) state)
      state (flow_tests/apply 'author flow_tests/author (myth/sing ['source] (pails/t flow_action_tests/source)).put(['expected] (pails/n 0)) state)
      state (flow_tests/apply 'publish flow_tests/author (myth/sing ['id] (pails/t "handbook")).put(['expected] (pails/n state.case(.x flow_tests/author).fall(0))) state)
      state (flow_tests/apply 'follow flow_tests/controller flow_tests/follow_request state)
      prepared (either/ok_val (flow_action_ops/prepare query state))
      state (flow_tests/poke flow_tests/input_path prepared.fil.fall(myth/new) state)
      worker (request_fixture/request_tests/attempt 1).snoc('worker)
      query=goo_runtime/request
        ?> held=goo_runtime/request (flow_tests/get worker state).pail_at(['goo 'request]) query
        held
    | [state query]
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = [first query] flow_action_tests/started
      attempt (request_fixture/request_tests/attempt 1)
      worker attempt.snoc('worker)
      hole (flow_tests/get attempt first).path_at(['work 'hole_path]).fall([])
      x first.case(.x attempt).fall(0)
      y first.case(.y attempt).fall(0)
      z first.case(.z attempt).fall(0)
      [done code body] (goo_runtime/act query first)
      [again repeated_code ignored] (goo_runtime/act query done)
      changed (flow_tests/poke query.target (myth/sing system_vocabulary/req (pails/t "Changed before invocation")) first)
      [refused refused_code message] (goo_runtime/act query changed)
      prepared (either/ok_val (flow_action_ops/prepare query.set_inputs(query.inputs.keep((\ [key value] !(eq key "$invocation")))) refused))
      rebound (flow_tests/poke flow_tests/input_path prepared.fil.fall(myth/new) refused)
      replacement (request_fixture/request_tests/attempt 2)
      next_query=goo_runtime/request
        ?> held=goo_runtime/request (flow_tests/get replacement.snoc('worker) rebound).pail_at(['goo 'request]) query
        held
      [resumed resumed_code resumed_body] (goo_runtime/act next_query rebound)
    [(testing/nat "authored flow dispatches shared action provider" 1 (flow_tests/get worker first).has(['goo 'request]))
     (testing/nat "authored action owns shared persistent hole" 1 (flow_tests/get hole first).has(['work 'hole]))
     (testing/nat "authored action retains ordinary context overlay" 1 (flow_tests/get attempt.snoc('view) first).has(bond/weft))
     (testing/nat "real declared action commits through native boundary" 200 code)
     (testing/text "receipt hand completes shared flow request" "complete" (flow_tests/get attempt done).txt_at(['work 'status]))
     (testing/text "flow completion resolves subject hole" "resolved" (flow_tests/get hole done).txt_at(['work 'status]))
     (testing/nat "flow selected writer publishes receipt document" 1 (flow_tests/get flow_tests/destination done).has(['src]))
     (testing/nat "repeated native invocation does not rerun flow" done.local.top again.local.top)
     (testing/nat "stale receiver is rejected by Goo" 409 refused_code)
     (testing/nat "rejected action produces no provider outcome" 0 (flow_tests/get worker refused).has(['work 'outcome]))
     (testing/text "rejected action leaves unresolved hole with ready evidence" "ready" (flow_tests/get hole refused).txt_at(['work 'status]))
     (testing/nat "refreshed action evidence creates replacement request" 1 (flow_tests/get replacement rebound).has(['flow 'request_task]))
     (testing/nat "replacement has a distinct invocation identity" 0 (equal[goo_runtime/request] query next_query))
     (testing/nat "reprepared declared action succeeds" 200 resumed_code)
     (testing/text "changed evidence resumes the existing flow" "complete" (flow_tests/get replacement resumed).txt_at(['work 'status]))
     (testing/nat "repreparation retains obsolete attempt" 1 (flow_tests/get attempt resumed).has(['flow 'request_task]))
     (testing/nat "action preserves retained x" 1 (equal[res[myth]] (sov/x_query x attempt first.local) (sov/x_query x attempt done.local)))
     (testing/nat "action preserves retained y" 1 (equal[res[axal[myth]]] (sov/y_query y attempt first.local) (sov/y_query y attempt done.local)))
     (testing/nat "action preserves retained z" 1 (equal[res[axal[myth]]] (sov/z_query z attempt first.local) (sov/z_query z attempt done.local)))]
+ tests
  ^ row[testing/case]
  [(testing/case "native action selection" flow_action_tests/prepared)
   (testing/case "native invocation receipts" flow_action_tests/receipts)
   (testing/case "authored flow action lifecycle" flow_action_tests/lifecycle)]
