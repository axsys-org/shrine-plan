- flow_install
- cooperate_mount
- testing
- tests/namespace [at=fixture]

' This suite deliberately imports no Nenex, example, or browser module.
+ flow_install_tests
  + apply
    \ command={\ namespace}either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ? (command state)
     > (./err why) (Seq[namespace] (error (pails/q why)) state)
     > (./ok writes)
      ? (grove_install/changes writes state)
       > (./err why) (Seq[namespace] (error (pails/q why)) state)
       > (./ok next) next
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /procedure" "  ;@ /flow/definition copy" "  ;= Copy"
       "    ;@ /flow/input input" "    ;= Input"
       "    ;@ /flow/step output ;/0x11/gov/flows/operations/identity"
       "    ;@ /flow/bind value input" "    ;= Copy input"
       "    ;@ /flow/result output" "    ;= Result"])
  + materialize
    \ target=path output=axal[myth] before=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some value) output.fil (./err 'missing_output)
    | ./ok [[target (? before.fil.is_some (writ/poke value) (writ/make value))]]
  + plan
    \ target=path output=axal[myth] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_install_tests/materialize target output (sovereign_peek target state)
  + headless
    \ ignored=unit
    ^ row[testing/check]
    = initial (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
    ?> (./ok initial) (cooperate_mount/install initial) [(testing/nat "native dependency installation succeeds" 1 0)]
    ?> (./ok state) (flow_install/install initial) [(testing/nat "headless installation succeeds" 1 0)]
    = author=path [state.self 'user 'procedure]
      input=path [state.self 'user 'input]
      writer=path [state.self 'user 'writer]
      output=path [state.self 'user 'output]
      controller=path [state.self 'user 'controller]
      cards=row[[path writ]]
        [[author (writ/make (myth/sing ['src] (pails/t flow_install_tests/source)))]
         [input (writ/make (myth/sing ['value] (pails/n 42)))]
         [writer (writ/make (myth/sing (flow_ops/key state.self 'writer) (flow_runtime/writer flow_install_tests/plan flow_install_tests/materialize)))]]
      state (flow_install_tests/apply (\ ignored=namespace (either/ok[iota row[[path writ]]] cards)) state)
      state (flow_install_tests/apply (flow_runtime_ops/publish author ((myth/sing ['id] (pails/t "copy")).put(['expected] (pails/n state.case(.x author).fall(0))))) state)
      definition=path author.weld(['flows 'copy])
      request (myth/sing ['definition] (safe 0 .x definition)).put(['destination] (pails/p output)).put(['writer] (safe 0 .x writer)).put(['input 'input] (safe 0 .x input))
      attached (flow_install_tests/apply (flow_maintenance_ops/follow controller request) state)
      changed (flow_install_tests/apply (\ ignored=namespace (either/ok[iota row[[path writ]]] [[input (writ/poke (myth/sing ['value] (pails/n 73)))]])) attached)
      retained (row/all[care] (\ car=care (equal (namespace/page car attached.case(car output) output attached) (namespace/page car attached.case(car output) output changed))) [.x .y .z])
      data_output=path [state.self 'user 'retained_result]
      data_controller=path [state.self 'user 'data_controller]
      data_request request.put(['destination] (pails/p data_output)).put(['writer] (safe 0 .x (flow_ops/key state.self 'retain_result)))
      data_state (flow_install_tests/apply (flow_maintenance_ops/follow data_controller data_request) changed)
      data_value=nat
        ?> receipt=flow_runtime/receipt (cooperate_ops/record data_output.weld(['flows 'latest]) data_state).fall(myth/new).pail_at(['flow 'receipt]) 0
        | (sovereign_care .x (row/cons[iota] 'x receipt.attempt.path.snoc('result)) data_state).fil.fall(myth/new).nat_at(['value] 0)
    | [(testing/nat "native follow admits a custom writer without a document application" 42 (cooperate_ops/record output attached).fall(myth/new).nat_at(['value] 0))
       (testing/nat "native evidence change runs the same maintenance hand" 73 (cooperate_ops/record output changed).fall(myth/new).nat_at(['value] 0))
       (testing/nat "custom writer retains prior output x/y/z readings" 1 retained)
       (testing/nat "headless work is exposed through native cells" 1 (cooperate_ops/record controller.weld(['cells 'work]) changed).is_some)
       (testing/nat "shared result writer retains computed values without examples or Nenex" 73 data_value)
       (testing/nat "result writer does not copy values into the destination" 0 (cooperate_ops/record data_output data_state).is_some)
       (testing/nat "result writer uses the existing ownership receipt" 1 (cooperate_ops/record data_output.weld(['flows 'latest]) data_state).is_some)
       (testing/nat "no Nenex application is installed" 0 (sovereign_peek [state.self 'app 'nenex] changed).wyt)
       (testing/nat "no HTTP provider is activated by native flow installation" 0 (sovereign_peek [state.self 'io 'web] changed).wyt)]
  + escaped_draft
    \ target=path output=axal[myth] before=axal[myth]
    ^ either[iota row[[p=path q=writ]]]
    | ./ok [[[target.at(0) 'user 'unrelated] (writ/make myth/new)]]
  + drafts
    \ ignored=unit
    ^ row[testing/check]
    = draft=path [($x 17) 'user 'work 'draft]
      body (myth/sing ['src] (pails/t ";= Draft\n  Authored text."))
      plain (flow_work_ops/draft_writes draft myth/new body flow_ops/empty)
      declared (myth/sing ['flow 'document] (kook [[($x 17) 'user 'document]]))
      missing (flow_work_ops/draft_writes draft declared body flow_ops/empty)
      incompatible (flow_work_ops/draft_writes draft (myth/sing ['flow 'draft_writer] (pails/n 7)) body flow_ops/empty)
      selected declared.put(['flow 'draft_writer] (flow_runtime/writer flow_install_tests/plan flow_install_tests/materialize))
      allowed (flow_work_ops/draft_writes draft selected body flow_ops/empty)
      foreign declared.put(['flow 'draft_writer] (flow_runtime/writer flow_install_tests/plan flow_install_tests/escaped_draft))
      refused (flow_work_ops/draft_writes draft foreign body flow_ops/empty)
    | [(testing/nat "plain source drafts need no application policy" 1 (either/is_ok plain))
       (testing/nat "declared document forms require their captured writer" 1 (either/is_err missing))
       (testing/nat "unrecognized captured writers cannot fall back to plain source" 1 (either/is_err incompatible))
       (testing/nat "custom captured draft writers require no Nenex code" 1 (either/is_ok allowed))
       (testing/nat "draft writer cannot publish outside the selected draft" 1 (either/is_err refused))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
    ?> (./ok state) (flow_install/install initial)
      [(testing/nat "native flow installation succeeds" 1 0)]
    = records (flow_install/records state.self)
      root=path [state.self 'gov 'flows]
      present (\ name=iota (cooperate_ops/record root.snoc(name) state).is_some)
      source (str/from_atom (joined 10
        [";. /procedure" "  ;@ /flow/definition copy" "  ;= Copy"
         "    ;@ /flow/input input" "    ;= Input"
         "    ;@ /flow/step output ;/0x11/gov/flows/operations/identity"
         "    ;@ /flow/bind value input" "    ;= Copy input"
         "    ;@ /flow/result output" "    ;= Result"]))
      compiled (flow_ops/compile 'copy (safe 1 .x [state.self 'user 'procedure]) source state)
      ran=bool
        ?> (./ok definition) compiled .false
        = value (axal/new[myth] (./some (myth/sing ['value] (pails/n 42))))
        ?> (./ok result) (flow_ops/evaluate definition ((axal/new[axal[myth]] .none).put(['input] value))) .false
        | equal[axal[myth]] value (unpin result.result)
    | [(testing/nat "ordinary Semidoc composition runs without Nenex" 1 ran)
       (testing/nat "native installation is idempotent" 0 (flow_install/registrations state).len)
       (testing/nat "commands stay in the existing native domain" 1 (records.all((\ [name card] (pith_prefix root name)))))
       (testing/nat "maintenance command installed" 1 (present 'follow))
       (testing/nat "source watch command installed" 1 (present 'watch_sources))
       (testing/nat "Nenex writer is supplied by the integration" 0 (present 'nenex))
       (testing/nat "Nenex authoring is supplied by the integration" 0 (present 'author))
       (testing/nat "no example catalogue required" 0 (sovereign_peek root.snoc('examples) state).wyt)
       (testing/nat "flow installation does not activate Cooperate behavior" 0
         (sovereign_peek [state.self 'gov 'cooperate] state).wyt)
       (testing/nat "no application or work instance installed" 0 (sovereign_peek [state.self 'app] state).wyt)]

+ tests
  ^ row[testing/case]
  [(testing/case "Native flow installation without a document application" flow_install_tests/checks)
   (testing/case "Native maintenance with an independently selected writer" flow_install_tests/headless)
   (testing/case "Captured draft writer boundary" flow_install_tests/drafts)]
