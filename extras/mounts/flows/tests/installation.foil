- flow_install
- testing
- tests/namespace [at=fixture]

' This suite deliberately imports no Nenex, example, or browser module.
+ flow_install_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
    ?> (./ok state) (flow_install/install initial)
      [(testing/nat "native flow installation succeeds" 1 0)]
    = records (flow_install/records state.self)
      root=path [state.self 'gov 'flows]
      present (\ name=iota (cooperate_ops/record root.snoc(name) state).is_some)
      source (str/from_atom (joined 10
        [";. /procedure" "  ;@ /flow/definition copy" "  ;= Copy"
         "    ;@ /flow/input input" "    ;= Input"
         "    ;@ /flow/step output ;/0x11/gov/flows/operations/identity"
         "    ;@ /flow/bind value input" "    ;= Copy input"
         "    ;@ /flow/result output" "    ;= Result"]))
      compiled (flow_ops/compile 'copy (safe 1 .x [state.self 'user 'procedure]) source state)
      ran=bool
        ?> (./ok definition) compiled .false
        = value (axal/new[myth] (./some (myth/sing ['value] (pails/n 42))))
        ?> (./ok result) (flow_ops/evaluate definition ((axal/new[axal[myth]] .none).put(['input] value))) .false
        | equal[axal[myth]] value (unpin result.result)
    | [(testing/nat "ordinary Semidoc composition runs without Nenex" 1 ran)
       (testing/nat "native installation is idempotent" 0 (flow_install/registrations state).len)
       (testing/nat "commands stay in the existing native domain" 1 (records.all((\ [name card] (pith_prefix root name)))))
       (testing/nat "maintenance command installed" 1 (present 'follow))
       (testing/nat "source watch command installed" 1 (present 'watch_sources))
       (testing/nat "Nenex writer is supplied by the integration" 0 (present 'nenex))
       (testing/nat "Nenex authoring is supplied by the integration" 0 (present 'author))
       (testing/nat "no example catalogue required" 0 (sovereign_peek root.snoc('examples) state).wyt)
       (testing/nat "no application or work instance installed" 0 (sovereign_peek [state.self 'app] state).wyt)]

+ tests
  ^ row[testing/case]
  [(testing/case "Native flow installation without a document application" flow_install_tests/checks)]
