- tests/flows
- fs_sync_foot
- eden

' Executed only by tests/check-watch-lifecycle.py in a disposable file root.
' The Python side mutates fixture files; all watches, commands and evidence
' run through the real native foot, supervisor and published flow operations.
+ watch_test
  + a
    ^ path
    [($x 17) 'io 'fs 'watch_a]
  + b
    ^ path
    [($x 17) 'io 'fs 'watch_b]
  + one
    ^ path
    [($x 17) 'app 'nenex 'w 'watch_one 'cells 'sources]
  + two
    ^ path
    [($x 17) 'app 'nenex 'w 'watch_two 'cells 'sources]
  + host
    \ action=nat
    ^ nat
    ; (WriteFile "watch/action" (add 256 action))
    % tries=nat 0
    = ;done (ReadFile "watch/done")
    ? (eq done (add 256 action)) 1
    ? (ge tries 30) (error (pails/t "Fixture host did not respond"))
    ; (Sleep 1)
    | _ tries.inc
  + reader
    \ root=str
    ^ either[str row[fs_read/file]]
    = ;value (fs_read/read root)
      ;blocked (ReadFile "watch/block")
    ? !(eq blocked 257) value
    ; (WriteFile "watch/entered" 257)
    % tries=nat 0
    ^ either[str row[fs_read/file]]
    = ;released (ReadFile "watch/block")
    ? !(eq released 257) value
    ? (ge tries 30) (./err "Fixture read was not released")
    ; (Sleep 1)
    | _ tries.inc
  + peek
    \ server=nat car=care version=maybe[nat] target=path
    ^ res[axal[saga]]
    ; (SendCaps server (helm/card/peek car version target) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ?> (./page name result) reply .unknown
    result
  + record
    \ server=nat target=path
    ^ myth
    ?> (./known tree) (watch_test/peek server .x .none target) myth/new
    | fs_foot/get_root tree
  + command
    \ server=nat operation=iota target=path input=myth
    ^ bool
    = plan
        \ state=namespace
        ^ either[iota row[[p=path q=writ]]]
        | namespace_command/plan target (flow_ops/key state.self operation)
            input.put(['expected] (pails/n state.case(.x target).fall(0))) state
    ; (SendCaps server (helm/card/admit 1 plan fs_foot/finish) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ?> (./admitted request status body line) reply .false
    | eq status 200
  + input
    \ mount=path
    ^ myth
    | (myth/sing ['mount] (pails/p mount)).put(['source] (safe 0 .x mount.weld(['source ($ta "bundle")])))
  + visible
    \ server=nat feed=path
    ^ bool
    = read
        \ state=namespace
        ^ [nat str]
        = value (sovereign_care .z (row/cons[iota] 'x feed) state)
        | [200 (nat/show (gt value.wyt 0))]
    ; (SendCaps server (helm/card/snapshot 2 read) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ?> (./develop request status body) reply .false
    | and (eq status 200) (equal[str] body "1")
  + await_visible
    \ server=nat feed=path wanted=bool
    ^ bool
    % tries=nat 0
    = ;found (watch_test/visible server feed)
    ? (eq found wanted) .true
    ? (ge tries 25) .false
    ; (Sleep 1)
    | _ tries.inc
  + history
    : car=care version=nat target=path value=res[axal[saga]]
  + retain
    \ server=nat target=path
    ^ row[watch_test/history]
    ?> (./known tree) (watch_test/peek server .x .none target) (Seq[row[watch_test/history]] (error (pails/t "History fixture target is unknown")) [])
    ?> (./some record) tree.fil (Seq[row[watch_test/history]] (error (pails/t "History fixture record is missing")) [])
    = versions=row[[care nat]] [[.x record.aeon.yuga.x.data] [.y record.aeon.yuga.y.data] [.z record.aeon.yuga.z.data]]
    | versions.map
      \ [car version]
      = ;value (watch_test/peek server car (./some version) target)
      | watch_test/history car version target value
  + intact
    \ server=nat history=row[watch_test/history]
    ^ bool
    | history.all
      \ saved=watch_test/history
      = ;current (watch_test/peek server saved.car (./some saved.version) saved.target)
      | equal current saved.value
  + has_slot
    \ record=myth slot=path
    ^ bool
    | maybe/is_some (record.get(slot))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = a=path watch_test/a
      b=path watch_test/b
      hand=path [($x 17) 'kook 'fs]
      state (flow_tests/poke hand (myth/sing bond/form fs/form) flow_tests/initial)
      state (flow_tests/poke [($x 17) 'io 'fs] myth/new state)
      config_a (fs/cfg "watch/a" a.snoc('source) (fs/extensions (mop/empty)) hand).put(['fs 'watch_seconds] (pails/n 5)).put(['fs 'watch_active] (pails/b .false))
      config_b (fs/cfg "watch/b" b.snoc('source) (fs/extensions (mop/empty)) hand).put(['fs 'watch_seconds] (pails/n 5)).put(['fs 'watch_active] (pails/b .false))
      state (flow_tests/poke a config_a state)
      state (flow_tests/poke b config_b state)
      ;server (eden/serve_feet helm/supervisor/local_access state [(helm/supervisor/register [state.self 'io 'fs] (fs_foot/run_with watch_test/reader))])
      ;attached (watch_test/command server 'watch_sources watch_test/one (watch_test/input a))
      ;first (watch_test/await_visible server watch_test/one .true)
      ;history_one (watch_test/retain server watch_test/one)
      ;history_file (watch_test/retain server a.weld(['source ($ta "bundle")]))
      ;history_mount (watch_test/retain server a)
      ;shared (watch_test/command server 'watch_sources watch_test/two (watch_test/input a))
      ;second (watch_test/await_visible server watch_test/two .true)
      ;rebound (watch_test/command server 'watch_sources watch_test/one (watch_test/input b))
      ;new_ready (watch_test/await_visible server watch_test/one .true)
      ;old_still_ready (watch_test/visible server watch_test/two)
      ;old_active (fs/watch_enabled (watch_test/record server a))
    ; (watch_test/host 1)
    = ;deleted (watch_test/await_visible server watch_test/one .false)
      ;retained_record (watch_test/record server b.weld(['source ($ta "bundle")]))
      retained (watch_test/has_slot retained_record bond/content)
    ; (watch_test/host 2)
    = ;restored (watch_test/await_visible server watch_test/one .true)
      ;detached (watch_test/command server 'unwatch_sources watch_test/two myth/new)
    = ;old_hidden (watch_test/visible server watch_test/two)
      ;active_b (fs/watch_enabled (watch_test/record server b))
    ' Block a real read after it captured new bytes, then revoke its consumer
    ' before releasing it. The late actor result must not reach the world.
    ; (watch_test/host 3)
    % tries=nat 0
    = ;entered (ReadFile "watch/entered")
    ? !(eq entered 257)
      ? (ge tries 20) [(testing/nat "late-result reader entered" 1 0)]
      ; (Sleep 1)
      | _ tries.inc
    = ;late_baseline (watch_test/peek server .x .none b.weld(['source ($ta "bundle")]))
      ;last_detached (watch_test/command server 'unwatch_sources watch_test/one myth/new)
    ; (watch_test/host 4)
    ; (Sleep 6)
    = ;late_after (watch_test/peek server .x .none b.weld(['source ($ta "bundle")]))
      ;history_ok (watch_test/intact server history_one.weld(history_file).weld(history_mount))
      ;last_hidden (watch_test/visible server watch_test/one)
      ;again (watch_test/command server 'watch_sources watch_test/one (watch_test/input b))
      ;again_ready (watch_test/await_visible server watch_test/one .true)
    ; (watch_test/command server 'unwatch_sources watch_test/one myth/new)
    ; (CloseHandle server)
    [(testing/nat "dynamic attach admitted through shared native operation" 1 attached)
     (testing/nat "new watch captures without restarting the foot" 1 first)
     (testing/nat "second consumer attaches the shared source" 1 (and shared second))
     (testing/nat "rebind captures the new source" 1 (and rebound new_ready))
     (testing/nat "shared old source remains watched and available" 1 (and old_active old_still_ready))
     (testing/nat "real file deletion hides current evidence" 1 deleted)
     (testing/nat "file deletion retains previous capture" 1 retained)
     (testing/nat "real file restoration recovers current evidence" 1 restored)
     (testing/nat "last old consumer detaches" 1 detached)
     (testing/nat "detached source does not expose retained evidence" 0 old_hidden)
     (testing/nat "independent source stays active" 1 active_b)
     (testing/nat "last consumer detaches during an in-flight read" 1 last_detached)
     (testing/nat "late read cannot update captured bytes or their version" 1 (equal late_baseline late_after))
     (testing/nat "all retained x/y/z snapshots remain exact" 1 (and (eq history_one.len 3) (and (eq history_file.len 3) (and (eq history_mount.len 3) history_ok))))
     (testing/nat "detached final source is unavailable" 0 last_hidden)
     (testing/nat "reattachment recovers using the same foot" 1 (and again again_ready))]

+ tests
  ^ row[testing/case]
  [(testing/case "dynamic filesystem watches in a disposable world" watch_test/checks)]
