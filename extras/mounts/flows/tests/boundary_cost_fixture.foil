- flow_test_world [at=fixture]
- flow_request_tests [at=pipeline]
- flow_request_fixture [at=provider]
- nenex_editor_http
- codex_work_ops

' Performance fixtures use real native admission and reactions. Counts describe
' the input/output trees, not an instrumented count of every internal read.
+ flow_boundary_cost_fixture
  + install
    \ writes=row[[path writ]] state=namespace
    ^ namespace
    ?> (./ok next) (grove_install/changes writes state)
      | Seq[namespace] (error (pails/t "Boundary cost fixture admission failed")) state
    next
  + make
    \ dimension=str count=nat nonce=nat
    ^ namespace
    = first pipeline/request_tests/started
      published (provider/request_tests/deliver (provider/request_tests/attempt 1) "complete" "Initial result" first)
      base (fixture/flow_tests/change_source (str/cat_all ["Prepare " dimension " / " nonce.show]) published)
    ? (eq dimension "history") (pipeline/request_tests/retained_history count base)
    = writes=row[[path writ]]
        | (row/range 0 count).map
          \ number=nat
          = name=iota ($ts (str/cat_all ["padding_" number.show]))
            source_root (fixture/flow_tests/input_path).take((fixture/flow_tests/input_path).len.dec)
            target=path (? (eq dimension "context") source_root.snoc(name) (fixture/flow_tests/destination).weld(['notes name]))
            record (myth/sing ['text] (pails/t (str/cat_all ["Retained annotation " number.show " / " nonce.show])))
            record=myth
              ? !(eq dimension "holes") record
              = hole (native_work/hole fixture/flow_tests/controller target (safe 0 .x fixture/flow_tests/input_path) "Unselected retained question" "{}")
              . record
                put(['work 'hole] hole)
                put(['work 'hole_state] (native_work/hole_state .none 1 .none))
                put(crew_slot (cpail (mop/empty)))
          | [target (writ/make record)]
    | flow_boundary_cost_fixture/install writes base
  + current
    \ state=namespace
    ^ path
    = selected
        | (pipeline/request_tests/selected state).tap.keep
          \ [at record]
          | and (eq at.len 1) (and (flow_request_ops/native record) (native_work_ops/active record))
    ? !(eq selected.len 1)
      | Seq[path] (error (pails/t "Expected one active benchmark request")) []
    = [name record] selected.at(0)
    | (fixture/flow_tests/controller).snoc('work).weld(name)
  + run
    \ state=namespace
    ^ namespace
    = changed (fixture/flow_tests/change_source "Boundary evidence changed" state)
      attempt (flow_boundary_cost_fixture/current changed)
    | provider/request_tests/deliver attempt "complete" "Boundary result" changed
  + valid
    \ before=namespace after=namespace
    ^ bool
    = old (flow_boundary_cost_fixture/current before)
      retained (row/all[care]
        (\ care (equal (namespace/page care before.case(care old) old before)
          (namespace/page care before.case(care old) old after))) [.x .y .z])
      notes (fixture/flow_tests/destination).snoc('notes)
      annotations (equal[axal[myth]] (sovereign_peek notes before) (sovereign_peek notes after))
    | and (and retained annotations) (and (eq (fixture/flow_tests/progress after).generation (fixture/flow_tests/progress before).generation.inc)
        (cord/has "Boundary result" (str/to_atom (fixture/flow_tests/get fixture/flow_tests/destination after).txt_at(['src]))))
  + events
    \ before=namespace after=namespace
    ^ nat
    | sub after.local.top before.local.top
  + destination_size
    \ state=namespace
    ^ nat
    | (sovereign_peek fixture/flow_tests/destination state).wyt
  + selected_size
    \ state=namespace
    ^ nat
    | (pipeline/request_tests/selected state).wyt
  + source_size
    \ state=namespace
    ^ nat
    = root (fixture/flow_tests/input_path).take((fixture/flow_tests/input_path).len.dec)
    | (sovereign_peek root state).wyt
  + work_size
    \ state=namespace
    ^ nat
    | (sovereign_peek (fixture/flow_tests/controller).snoc('work) state).wyt
  + hole_count
    \ state=namespace
    ^ nat
    = holes
        | (sovereign_peek fixture/flow_tests/destination state).tap.keep
          \ [at record]
          | record.has ['work 'hole]
    holes.len
  + history
    \ state=namespace
    ^ row[[path myth]]
    = target=path (row/cons[iota] 'x (fixture/flow_tests/controller).weld(['cells 'work]))
    ?> (./known tree) (sovereign_view .z 0 target state)
      | Seq[row[[path myth]]] (error (pails/t "Work history surface unavailable")) []
    | tree.tap
  + recover
    ' Exercise the existing provider recovery scan, without starting a process
    ' or replaying external work. There are no Codex jobs: this measures the
    ' negative authority scan, not recovery correctness or Save/restart latency.
    \ state=namespace
    ^ row[[path writ]]
    ?> (./ok writes) (codex_work_ops/recover [state.self 'io 'codex] state)
      | Seq[row[[path writ]]] (error (pails/t "Provider recovery planning failed")) []
    writes
  + render_target
    ^ path
    [($x 17) 'app 'nenex 'w 'cost_document]
  + make_document
    \ count=nat nonce=nat
    ^ namespace
    = paragraphs
        | (row/range 0 count).map
          \ n=nat
          | str/to_atom (str/cat_all ["  Paragraph " n.show " / " nonce.show "." (str/from_atom 10)])
      source (str/from_atom (joined 10 (row/cons[nat] ";= Cost document" paragraphs)))
    | fixture/flow_tests/apply 'author flow_boundary_cost_fixture/render_target
        (myth/sing ['source] (pails/t source)) fixture/flow_tests/initial
  + document
    ' Actual Nenex document response serialization. Browser layout and network
    ' transmission are deliberately outside this measurement.
    \ state=namespace
    ^ [nat str]
    | nenex_editor_http/document_response flow_boundary_cost_fixture/render_target state
