- flow_operations
- flow_nenex
- flow_maintenance
- grove_install
- cooperate_mount
- flow_interface
- flow_sources

+ flows_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    ? (flow_ui/registrations state)
     > (./err why) (./err (pails/q why))
     > (./ok writes)
      ? (grove_install/changes writes state)
       > (./err why) (./err (pails/q why))
       > (./ok next) (./ok next)
