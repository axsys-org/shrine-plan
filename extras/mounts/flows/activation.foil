- flow_operations
- flow_nenex
- flow_maintenance
- grove_install
- cooperate_mount
- flow_interface
- flow_sources

+ flows_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    < state (cooperate_mount/install state)
    = root (flow/key state.self 'operations)
      commands=row[[iota namespace_op]]
        [['author (namespace_op flow_nenex/author)]
         ['publish (namespace_op flow_runtime/publish)]
         ['preview (namespace_op flow_runtime/preview)]
         ['commit (namespace_op flow_runtime/commit)]
         ['submit_revision (namespace_op flow_maintenance/submit_revision)]
         ['follow (namespace_op flow_maintenance/follow)]
         ['set_enabled (namespace_op flow_maintenance/set_enabled)]
         ['detach (namespace_op flow_maintenance/detach)]
         ['observe (namespace_op flow_maintenance/observe)]
         ['source_failed (namespace_op flow_maintenance/source_failed)]
         ['import_source (namespace_op flow_runtime/import_source)]]
      operations=row[[iota flow/operation]]
        [['inventory (flow/operation ['sources] flow_operations/inventory)]
         ['revise (flow/operation ['pages 'sources] flow_operations/revise)]
         ['evidence (flow/operation ['pages 'sources] flow_operations/evidence)]
         ['decompose (flow/operation ['sources] flow_operations/decompose)]
         ['documents (flow/operation ['pages 'sources] flow_operations/documents)]
         ['identity (flow/operation ['value] flow_operations/identity)]]
      records=row[[path myth]]
        [[[state.self 'gov 'nenex_ui 'tools 'flows] (myth/sing ['nenex 'tool] (nenex_ui/page_tool flow_ui/render))]
         [(flow/key state.self 'source_hand) (myth/sing system_vocabulary/form flow_sources/form)]
         [(flow/key state.self 'empty) myth/new]
         [(flow/key state.self 'hand) (myth/sing system_vocabulary/form flow_maintenance/form)]
         [(flow/key state.self 'nenex) (myth/sing (flow/key state.self 'writer) (flow_runtime/writer flow_nenex/plan flow_nenex/materialize))]]
      records records.weld(commands.map((\ [name operation] [(flow/key state.self name) (myth/sing system_vocabulary/op operation)])))
      records records.weld(operations.map((\ [name operation] [root.snoc(name) (myth/sing (flow/key state.self 'operation) operation)])))
    % todo=row[[path myth]] records next=namespace state
    ^ either[pail namespace]
    ?> (./some pair) todo.pull
      ? (flow_sources/install next)
       > (./ok installed) (./ok installed)
       > (./err why) (./err (pails/q why))
    = [entry rest] pair
      [name card] entry
    ? (grove_install/change name (writ/make card) next)
     > (./err why) (./err (pails/q why))
     > (./ok updated) (_ rest updated)
