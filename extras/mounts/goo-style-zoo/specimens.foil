- goo_workspace
- goo_design

+ style_zoo
  + nav
    \ root=path current=path
    ^ goo/text/pail
    = pages=row[[str path]] [["Theme" (goo_theme/root root.at(0)).snoc('button)] ["Composition" root] ["Type" root.snoc('type)] ["Runs" root.snoc('runs)] ["Paint" root.snoc('paint)]]
    % i=nat 0 out=goo/text []
    ? (eq i pages.len) (goo/text/pail out)
    = [name at] pages.at(i)
      out (? (eq i 0) out out.weld((goo/text/en "    ")))
      item (? (equal[path] at current) (goo/runt myth/new (goo/lang/en name)) (goo_text/route_link name at "sheet" [["page" at]]))
    | _ i.inc out.snoc(item)
  + marks
    \ mods=row[modifiers]
    ^ myth
    | myth/sing ['sys 'modifiers] (pails/modifiers (row/stream[modifiers] mods))
  + specimen
    \ paint=path
    ^ goo/text/pail
    | goo/text/pail
      [(goo/runt myth/new (goo/lang/en "Plain, "))
       (goo/runt (style_zoo/marks [(modifiers/bold)]) (goo/lang/en "bold"))
       (goo/runt myth/new (goo/lang/en ", "))
       (goo/runt (style_zoo/marks [(modifiers/italic)]) (goo/lang/en "italic"))
       (goo/runt myth/new (goo/lang/en ", "))
       (goo/runt (style_zoo/marks [(modifiers/bold) (modifiers/italic)]) (goo/lang/en "bold italic"))
       (goo/runt myth/new (goo/lang/en ", "))
       (goo/runt (style_zoo/marks [(modifiers/underline)]) (goo/lang/en "underlined"))
       (goo/runt myth/new (goo/lang/en ", "))
       (goo/runt (myth/sing ['sys 'font] (pails/p ['sys 'font 'mono])) (goo/lang/en "mono"))
       (goo/runt myth/new (goo/lang/en ", and a "))
       (goo_text/route_link "link to Paint" paint "sheet" [["page" paint]])
       (goo/runt myth/new (goo/lang/en "."))]
  + selectors
    ^ row[[str str]]
    [["button" "Button"] ["text" "All text"] ["text_title" "Title"] ["text_body" "Body"] ["text_label" "Label"] ["text_quote" "Quote"] ["text_badge" "Badge"] ["code" "Code"] ["input" "Input"]]
  + theme_nav
    \ root=path current=str
    ^ goo/text/pail
    = choices style_zoo/selectors
    % i=nat 0 out=goo/text []
    ? (eq i choices.len) (goo/text/pail out)
    = [key label] choices.at(i)
      at root.snoc(($ts key))
      run (? (eq key current) (goo/runt myth/new (goo/lang/en label)) (goo_text/route_link label at "sheet" [["page" at]]))
      out (? (eq i 0) out out.weld((goo/text/en "    ")))
    | _ i.inc out.snoc(run)
  + install_theme
    \ state=namespace
    ^ either[pail namespace]
    = choices style_zoo/selectors root (goo_theme/root state.self) gov=path [state.self 'gov 'style_zoo]
      slot gov.snoc('theme_style)
      fields=row[path] [gov.snoc('theme_pad_x) gov.snoc('theme_pad_y) gov.snoc('theme_stroke) gov.snoc('theme_edge) gov.snoc('theme_fill) gov.snoc('theme_radius)]
    % i=nat 0 next=namespace state
    ^ either[pail namespace]
    ? (eq i choices.len) (./ok next)
    = [key label] choices.at(i)
      at root.snoc(($ts key))
    ? (maybe/is_some (goo_runtime/record .x at next)) (_ i.inc next)
    = card (myth/sing slot goo/design/empty).put(goo_theme/binding (pails/p slot))
      card card.put(gov.snoc('theme_editor) (goo_design/form slot fields)).put(gov.snoc('rule_name) (pails/t label))
      card card.put(gov.snoc('navigation) (style_zoo/nav [state.self 'app 'style_zoo] root.snoc('button))).put(gov.snoc('selectors) (style_zoo/theme_nav root key))
      card fields.fold(card (\ out=myth field=path out.put(field (pails/t ""))))
    ?> (./ok changed) (grove_install/change at (writ/make card) next) (./err (pails/t "Could not install shared theme rule."))
    | _ i.inc changed
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'style_zoo]
      gov=path [state.self 'gov 'style_zoo]
      faces root.snoc('type)
      runs root.snoc('runs)
      paint root.snoc('paint)
      records=row[[path myth]]
        [[root (myth/sing gov.snoc('caption) (pails/t "The night edition"))]
         [faces (myth/sing gov.snoc('sample) (pails/t "The quick brown fox"))]
         [runs (myth/sing gov.snoc('lettering) (style_zoo/specimen paint)).put(gov.snoc('hebrew) (goo/text/pail (goo/text/en "שלום עולם")))]
         [paint (myth/sing gov.snoc('initials) (pails/t "GS")).put(gov.snoc('button_specimen) (pails/t "Default"))]]
    % rest=row[[path myth]] records next=namespace state
    ^ either[pail namespace]
    ? !(rest.len) (style_zoo/install_theme next)
    = [at record] rest.at(0)
      sample=goo/text/pail
        ? (equal at runs) (style_zoo/specimen paint)
        | goo/text/pail (goo/text/en (? (equal at root) "Component styling zoo" (? (equal at faces) "The quick brown fox" "LIVE")))
      role=str (? (equal at paint) "badge" (? (equal at runs) "body" "title"))
      card record.put(gov.snoc('specimen) sample).put(gov.snoc('treatment) (pails/t role))
      card card.put(gov.snoc('plate) goo/design/empty).put(gov.snoc('tool) goo/design/empty)
      plate_fields=row[path] [gov.snoc('plate_pad_x) gov.snoc('plate_pad_y) gov.snoc('plate_stroke) gov.snoc('plate_edge) gov.snoc('plate_fill) gov.snoc('plate_radius)]
      tool_fields=row[path] [gov.snoc('tool_pad_x) gov.snoc('tool_pad_y) gov.snoc('tool_stroke) gov.snoc('tool_edge) gov.snoc('tool_fill) gov.snoc('tool_radius)]
      card=myth
        % remaining=row[path] plate_fields.weld(tool_fields) out=myth card
        ^ myth
        ? !(remaining.len) out
        | _ remaining.drop(1) out.put(remaining.at(0) (pails/t ""))
      card card.put(gov.snoc('specimen_editor) (goo_design/form gov.snoc('plate) plate_fields))
      card card.put(gov.snoc('tool_editor) (goo_design/form gov.snoc('tool) tool_fields))
      card card.put(gov.snoc('navigation) (style_zoo/nav root at))
    ?> (./ok changed) (grove_install/change at (writ/make card) next)
      | ./err (pails/t (str/cat_all ["Could not install style specimen at " (path_show at)]))
    | _ rest.drop(1) changed
