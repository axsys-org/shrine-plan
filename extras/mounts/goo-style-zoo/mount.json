    "shell": {
      "title": "Goo style zoo", "brand": "Goo specimens",
      "navigation": [
        ["Theme", ["app", "goo_theme", "button"]],
        ["Composition", ["app", "style_zoo"]],
        ["Type", ["app", "style_zoo", "type"]],
        ["Runs", ["app", "style_zoo", "runs"]],
