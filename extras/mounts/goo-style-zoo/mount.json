{
  "version": 1,
  "name": "goo-style-zoo",
  "dependencies": ["explorer", "codecs"],
  "modules": {"style_zoo": "specimens.foil"},
  "grove": [{"root": ["gov", "style_zoo"], "files": ["main.grove"], "prelude": "style_zoo"}],
  "assets": {},
  "files": {},
  "roots": [["lib", "style_zoo"], ["gov", "style_zoo"]],
  "tests": {},
