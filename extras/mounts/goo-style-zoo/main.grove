      col {
        row {
          text("Horizontal padding (px)", "label")
          input(%/tool_pad_x, "slider", {[max]: 96, [label]: "Horizontal padding (px)"})
        }
        row {
          text("Vertical padding (px)", "label")
          input(%/tool_pad_y, "slider", {[max]: 96, [label]: "Vertical padding (px)"})
        }
        row {
          text("Stroke width (px)", "label")
          input(%/tool_stroke, "slider", {[max]: 12, [label]: "Stroke width (px)"})
        }
        row {
          text("Stroke color", "label")
          input(%/tool_edge, "colorwell", {[label]: "Stroke color"})
        }
        row {
