#import text=lib/grove/types/text
#import path_type=lib/grove/types/path

runs_type =
  @type
  ! foil
  goo/text/pail
  + read
    \ value=pail
    ^ maybe[runs_type]
    ?> value=goo/text/pail value .none
    | ./some value
  + write
    \ value=runs_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo/text/pail)

design_type =
  @type
  ! foil
  goo/design
  + read
    \ value=pail
    ^ maybe[design_type]
    ?> value=goo/design value .none
    | ./some value
  + write
    \ value=design_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo/design)

plate =
  @slot

tool =
  @slot

specimen =
  @slot

button_specimen =
  @slot

treatment =
  @slot

plate_pad_x =
  @slot

plate_pad_y =
  @slot

plate_stroke =
  @slot

plate_edge =
  @slot

plate_fill =
  @slot

plate_radius =
  @slot

tool_pad_x =
  @slot

tool_pad_y =
  @slot

tool_stroke =
  @slot

tool_edge =
  @slot

tool_fill =
  @slot

tool_radius =
  @slot

studio =
  @role
  %/plate: %/design_type
  %/tool: %/design_type
  %/specimen: %/runs_type
  %/treatment: text
  %/plate_pad_x: text
  %/plate_pad_y: text
  %/plate_stroke: text
  %/plate_edge: text
  %/plate_fill: text
  %/plate_radius: text
  %/tool_pad_x: text
  %/tool_pad_y: text
  %/tool_stroke: text
  %/tool_edge: text
  %/tool_fill: text
  %/tool_radius: text
  #opt ;
    %/button_specimen: text

address =
  @slot

navigation =
  @slot

caption =
  @slot

sample =
  @slot

lettering =
  @slot

hebrew =
  @slot

initials =
  @slot

context =
  @role
  %/address: path_type

proof =
  @role
  #with ; %/studio
  %/caption: text
  %/navigation: %/runs_type

type_sheet =
  @role
  #with ; %/studio
  %/sample: text
  %/navigation: %/runs_type

run_sheet =
  @role
  #with ; %/studio
  %/lettering: %/runs_type
  %/hebrew: %/runs_type
  %/navigation: %/runs_type

paint_sheet =
  @role
  #with ; %/studio
  %/initials: text
  %/navigation: %/runs_type

workspace =
  @pane
  #route ;
    name: sheet
    page: %/address
  #on ; %/context
  #for ; /sys/slot/style_zoo_workspace
  context => selection('/page, source = context.address, topology = "tree", axis = "z", initial = .member(context.address)) {
    follow('/specimen, selection = '/page, slot = '/sys/slot/style_zoo_sheet)
  }

composition =
  @view
  #on ; %/proof
  #for ; /sys/slot/style_zoo_sheet
  proof => col {
    text(proof.navigation, '/sys/slot/label)
    group("context-menu") {
      text(proof.specimen, proof.treatment, style = proof.plate)
      action("Override this specimen", become = '/sys/slot/style_zoo_editor)
    }
    text("A print proof assembled from Goo components.", "subtitle")
    row {
      avatar("GS")
      col {
        text("Goo Studio", "author")
        text("Letterpress series", "metadata")
      }
      text("PROOF", "badge")
    }
    text(proof.caption, "quote")
    row {
      text("3", "value")
      text("of 4 plates inked", "unit")
    }
    bar({[value]: 3, [max]: 4, [label]: "Plates inked"}, "")
    text("Proof caption", '/sys/slot/label)
    group(on = proof, action = .poke, myth = { %/caption = .input(proof.caption) }) {
      input(%/caption)
      action("Save caption")
    }
    text("Save to see your words set in the quote face above.", "hint")
  }

typography =
  @view
  #on ; %/type_sheet
  #for ; /sys/slot/style_zoo_sheet
  page => col {
    text(page.navigation, '/sys/slot/label)
    text("Type specimens", '/sys/slot/title)
    text("One phrase, six presentation slots.", "subtitle")
    row {
      text("title", "badge")
      group("context-menu") {
        text(page.specimen, page.treatment, style = page.plate)
        action("Override this specimen", become = '/sys/slot/style_zoo_editor)
      }
    }
    row {
      text("body", "badge")
      text(page.sample, '/sys/slot/content)
    }
    row {
      text("quote", "badge")
      text(page.sample, "quote")
    }
    row {
      text("label", "badge")
      text(page.sample, '/sys/slot/label)
    }
    row {
      text("credit", "badge")
      text(page.sample, "credit")
    }
    row {
      text("badge", "badge")
      text(page.sample, "badge")
    }
  }

inline =
  @view
  #on ; %/run_sheet
  #for ; /sys/slot/style_zoo_sheet
  page => col {
    text(page.navigation, '/sys/slot/label)
    text("Inline runs", '/sys/slot/title)
    text("One string of runs, two base styles. Follow the boxed words to open the paint sheet.", "subtitle")
    code("body + run myths")
    group("context-menu") {
      text(page.specimen, page.treatment, style = page.plate)
      action("Override this specimen", become = '/sys/slot/style_zoo_editor)
    }
    code("label + the same run myths")
    text(page.lettering, '/sys/slot/label)
    text("Hebrew fallback", '/sys/slot/label)
    text(page.hebrew, '/sys/slot/title)
    text("This run has no authored font. Reaver selects the Hebrew face before measuring it.", "hint")
  }

paint =
  @view
  #on ; %/paint_sheet
  #for ; /sys/slot/style_zoo_sheet
  page => col {
    text(page.navigation, '/sys/slot/label)
    text("Paint specimens", '/sys/slot/title)
    text("Avatar, presence and status", '/sys/slot/label)
    row {
      avatar(page.initials)
      presence("")
      text("Press ready", "status")
      text("LIVE", "badge")
    }
    text("Media and progress", '/sys/slot/label)
    row {
      media({[maxIdeal]: 220, [label]: "Media gradient"}, "")
      col {
        text("One plate inked", "caption")
        bar({[value]: 1, [max]: 4, [label]: "One of four"}, "")
        text("Three plates inked", "caption")
        bar({[value]: 3, [max]: 4, [label]: "Three of four"}, "")
      }
    }
    text("Button treatments", '/sys/slot/label)
    row {
      group("context-menu") {
        button(page.button_specimen, style = page.plate)
        action("Override this specimen", become = '/sys/slot/style_zoo_editor)
      }
      button({[primary]: true}, "Primary")
      button("Destructive", "action/destructive")
    }
    text("These three button specimens show paint only. The caption form on Composition has a bound action.", "hint")
    text("Progress declaration", '/sys/slot/label)
    code("bar({[value]: 3, [max]: 4}, ...)")
  }

save_plate =
  @action
  #on ; %/studio
  %/plate_pad_x: text
  %/plate_pad_y: text
  %/plate_stroke: text
  %/plate_edge: text
  %/plate_fill: text
  %/plate_radius: text
  ! foil
  \ plate_pad_x=text plate_pad_y=text plate_stroke=text plate_edge=text plate_fill=text plate_radius=text page=%/studio
  ^ %/studio
  = result (goo_design/parse [plate_pad_x plate_pad_y plate_stroke plate_edge plate_fill plate_radius])
  ?> (./ok design) result (Seq[%/studio] (error (pails/t "Invalid style values")) page)
  | page.set_plate(design).set_plate_pad_x(plate_pad_x).set_plate_pad_y(plate_pad_y).set_plate_stroke(plate_stroke).set_plate_edge(plate_edge).set_plate_fill(plate_fill).set_plate_radius(plate_radius)

specimen_editor =
  @view
  #on ; %/studio
  #for ; /sys/slot/style_zoo_editor
  page => col("draft-preview") {
    group("context-menu") {
      text("Style workbench", "title", style = page.tool)
      action("Edit workbench heading", become = '/sys/slot/style_zoo_tools)
    }
    or {
      button(page.button_specimen, style = page.plate)
      text(page.specimen, page.treatment, style = page.plate)
    }
    text("Specimen settings", "label")
    text("Drag to adjust or click a swatch. Choose Default to inherit the profile setting.", "hint")
    group(on = page, action = %/save_plate, myth = { %/plate_pad_x = .input(page.plate_pad_x), %/plate_pad_y = .input(page.plate_pad_y), %/plate_stroke = .input(page.plate_stroke), %/plate_edge = .input(page.plate_edge), %/plate_fill = .input(page.plate_fill), %/plate_radius = .input(page.plate_radius) }) {
      col {
        row {
          text("Horizontal padding (px)", "label")
          input(%/plate_pad_x, "slider", {[max]: 96, [label]: "Horizontal padding (px)"})
        }
        row {
          text("Vertical padding (px)", "label")
          input(%/plate_pad_y, "slider", {[max]: 96, [label]: "Vertical padding (px)"})
        }
        row {
          text("Stroke width (px)", "label")
          input(%/plate_stroke, "slider", {[max]: 12, [label]: "Stroke width (px)"})
        }
        row {
          text("Stroke color", "label")
          input(%/plate_edge, "colorwell", {[label]: "Stroke color"})
        }
        row {
          text("Fill color", "label")
          input(%/plate_fill, "colorwell", {[label]: "Fill color"})
        }
        row {
          text("Corner radius (px)", "label")
          input(%/plate_radius, "slider", {[max]: 48, [label]: "Corner radius (px)"})
        }
        action("Save design")
      }
    }
    action("Return to sheet", become = '/sys/slot/style_zoo_sheet)
  }

