  @action
  #on ; %/studio
  %/tool_pad_x: text
  %/tool_pad_y: text
  %/tool_stroke: text
  %/tool_edge: text
  %/tool_fill: text
  %/tool_radius: text
  ! foil
  \ tool_pad_x=text tool_pad_y=text tool_stroke=text tool_edge=text tool_fill=text tool_radius=text page=%/studio
  ^ %/studio
  = result (goo_design/parse [tool_pad_x tool_pad_y tool_stroke tool_edge tool_fill tool_radius])
  ?> (./ok design) result (Seq[%/studio] (error (pails/t "Invalid style values")) page)
  | page.set_tool(design).set_tool_pad_x(tool_pad_x).set_tool_pad_y(tool_pad_y).set_tool_stroke(tool_stroke).set_tool_edge(tool_edge).set_tool_fill(tool_fill).set_tool_radius(tool_radius)

