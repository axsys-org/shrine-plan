theme_style =
  @slot

rule_name =
  @slot

selectors =
  @slot

theme_pad_x =
  @slot

theme_pad_y =
  @slot

theme_stroke =
  @slot

theme_edge =
  @slot

theme_fill =
  @slot

theme_radius =
  @slot

theme_rule =
  @role
  %/theme_style: %/design_type
  %/rule_name: text
  %/navigation: %/runs_type
  %/selectors: %/runs_type
  %/theme_pad_x: text
  %/theme_pad_y: text
  %/theme_stroke: text
  %/theme_edge: text
  %/theme_fill: text
  %/theme_radius: text

publish_rule =
  @action
  #on ; %/theme_rule
  %/theme_pad_x: text
  %/theme_pad_y: text
  %/theme_stroke: text
  %/theme_edge: text
  %/theme_fill: text
  %/theme_radius: text
  ! foil
  \ theme_pad_x=text theme_pad_y=text theme_stroke=text theme_edge=text theme_fill=text theme_radius=text page=%/theme_rule
  ^ %/theme_rule
  = result (goo_design/parse [theme_pad_x theme_pad_y theme_stroke theme_edge theme_fill theme_radius])
  ?> (./ok design) result (Seq[%/theme_rule] (error (pails/t "Invalid style values")) page)
  | page.set_theme_style(design).set_theme_pad_x(theme_pad_x).set_theme_pad_y(theme_pad_y).set_theme_stroke(theme_stroke).set_theme_edge(theme_edge).set_theme_fill(theme_fill).set_theme_radius(theme_radius)


theme_article =
  @view
  #on ; %/theme_rule
  #for ; /sys/slot/style_zoo_theme_article
  rule => col {
    text("Reading room", "title")
    text("A shared rule follows the text wherever it appears.", "body")
    text("From the margin", "quote")
    row {
      text("Edition", "label")
      text("Proof", "badge")
      button("Read passage")
    }
  }

theme_console =
  @view
  #on ; %/theme_rule
  #for ; /sys/slot/style_zoo_theme_console
  rule => col {
    text("Print desk", "title")
    text("Choose a proof to print.", "body")
    row {
      code("proof.goo")
      button("Print proof")
    }
  }

theme_editor =
  @view
  #on ; %/theme_rule
  #for ; /sys/slot/style_zoo_sheet
  page => col("draft-preview") {
    text(page.navigation, "label")
    text("Shared Goo theme", "title")
    text(page.selectors, "label")
    text(page.rule_name, "subtitle")
    text("Edit the shared rule. Default inherits the base style. Publish applies it to every matching view in this world.", "hint")
    present(page, '/sys/slot/style_zoo_theme_article)
    present(page, '/sys/slot/style_zoo_theme_console)
    group(on = page, action = %/publish_rule, myth = { %/theme_pad_x = .input(page.theme_pad_x), %/theme_pad_y = .input(page.theme_pad_y), %/theme_stroke = .input(page.theme_stroke), %/theme_edge = .input(page.theme_edge), %/theme_fill = .input(page.theme_fill), %/theme_radius = .input(page.theme_radius) }) {
      col {
        row {
          text("Horizontal padding (px)", "label")
          input(%/theme_pad_x, "slider", {[max]: 96, [label]: "Horizontal padding (px)"})
        }
        row {
          text("Vertical padding (px)", "label")
          input(%/theme_pad_y, "slider", {[max]: 96, [label]: "Vertical padding (px)"})
        }
        row {
          text("Stroke width (px)", "label")
          input(%/theme_stroke, "slider", {[max]: 12, [label]: "Stroke width (px)"})
        }
        row {
          text("Stroke color", "label")
          input(%/theme_edge, "colorwell", {[label]: "Stroke color"})
        }
        row {
          text("Fill color", "label")
          input(%/theme_fill, "colorwell", {[label]: "Fill color"})
        }
        row {
          text("Corner radius (px)", "label")
          input(%/theme_radius, "slider", {[max]: 48, [label]: "Corner radius (px)"})
        }
        action("Publish theme")
      }
    }
  }
