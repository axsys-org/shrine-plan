#import text=lib/grove/types/text
#import lede=sys/lede
#import content=sys/content
#import weft=sys/weft
#import tack=sys/tack

book_type =
  @type
  ! foil
  branchmap/book
  + read
    \ value=pail
    ^ maybe[book_type]
    ?> result=branchmap/book value .none
    | ./some result
  + write
    \ value=book_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ branchmap/book)

book =
  @slot

operation =
  @slot

participant =
  @slot

market =
  @slot

outcome =
  @slot

quantity =
  @slot

conditions =
  @slot

balances =
  @slot

markets =
  @slot

positions =
  @slot

activity =
  @slot


exchange =
  @role
  %/book: %/book_type
  %/balances: text
  %/markets: text
  %/positions: text
  %/activity: text

execute =
  @action
  #on ; %/exchange
  %/operation: text
  %/participant: text
  %/market: text
  %/outcome: text
  %/quantity: text
  %/conditions: text
  ! foil
  \ operation=text participant=text market=text outcome=text quantity=text conditions=text exchange=%/exchange
  ^ %/exchange
  = result (branchmap/execute exchange.book operation participant market outcome quantity conditions)
  ?> (./ok next) result
    | Seq[%/exchange] (error (pails/t (branchmap/error_text result))) exchange
  | exchange.set_book(next).set_balances((branchmap/accounts_text next)).set_markets((branchmap/markets_text next)).set_positions((branchmap/positions_text next)).set_activity((branchmap/history_text next))

terminal =
  @view
  #on ; %/exchange
  #for ; /sys/slot/content
  exchange => col {
    show("Branchmap - local prediction exchange", '/sys/slot/title)
    show("Snapshot quotes. Whole shares. 1 winning share pays 1 TOY. No external trades.", '/sys/slot/subtitle)
    show(exchange.balances, '/sys/slot/body)
    group(on = exchange, action = %/execute, myth = {
      %/operation = .input("buy")
      %/participant = .input("alice")
      %/market = .input("0")
      %/outcome = .input("0")
      %/quantity = .input("10")
      %/conditions = .input("")
    }) {
      col {
        show("Operation: buy, sell, split, merge, open-account, resolve", '/sys/slot/label)
        input(%/operation)
        show("Participant: alice, bob, or new name; operator for simulated resolution", '/sys/slot/label)
        input(%/participant)
        show("Market number (listed below)", '/sys/slot/label)
        input(%/market)
        show("Outcome number: 0 = first, 1 = second, etc.", '/sys/slot/label)
        input(%/outcome)
        show("Whole shares (open-account grants 100 TOY from house)", '/sys/slot/label)
        input(%/quantity)
        show("Parent conditions for split/merge only: e.g. 0:0,2:0; empty = TOP", '/sys/slot/label)
        input(%/conditions)
        action("Submit transaction")
      }
    }
    show("Participant positions", '/sys/slot/title)
    show(exchange.positions, '/sys/slot/body)
    show("Recent accepted transactions", '/sys/slot/title)
    show(exchange.activity, '/sys/slot/body)
    show("Markets and local quotes", '/sys/slot/title)
    show(exchange.markets, '/sys/slot/body)
    show("Nested claims have no executable quote. Split/merge use complete outcome families. Resolution is an explicit local operator action.", '/sys/slot/hint)
  }

"/exchange" =
  @tree
  %/book: branchmap_sample/initial
  %/balances: (pails/t (branchmap/accounts_text branchmap_sample/initial))
  %/markets: (pails/t (branchmap/markets_text branchmap_sample/initial))
  %/positions: (pails/t (branchmap/positions_text branchmap_sample/initial))
  %/activity: (pails/t "No transactions yet.")

entry =
  @role
  lede: text
  content: text

entry_view =
  @view
  #on ; %/entry
  #for ; /sys/slot/content
  entry => col {
    show(entry.lede, '/sys/slot/title)
    show(entry.content, '/sys/slot/body)
  }

book_source =
  @norm
  #here ; "/"
  #with ; %/exchange

entry_list =
  @norm
  #here ; '/[index=@u]
  #with ; %/entry

accounts_projection =
  @sewn
  #from ; %/book_source
  #to ; %/entry_list
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    ?> (./some card) tree.fil (axal/new[myth] .none)
    ?> (./some exchange) (%/exchange/from_myth card) (axal/new[myth] .none)
    | branchmap/project exchange.book "accounts"

"/accounts" =
  @tree
  weft: %/accounts_projection
  tack: '@/y/%/exchange

positions_projection =
  @sewn
  #from ; %/book_source
  #to ; %/entry_list
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    ?> (./some card) tree.fil (axal/new[myth] .none)
    ?> (./some exchange) (%/exchange/from_myth card) (axal/new[myth] .none)
    | branchmap/project exchange.book "positions"

"/positions" =
  @tree
  weft: %/positions_projection
  tack: '@/y/%/exchange

markets_projection =
  @sewn
  #from ; %/book_source
  #to ; %/entry_list
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    ?> (./some card) tree.fil (axal/new[myth] .none)
    ?> (./some exchange) (%/exchange/from_myth card) (axal/new[myth] .none)
    | branchmap/project exchange.book "markets"

"/markets" =
  @tree
  weft: %/markets_projection
  tack: '@/y/%/exchange

receipts_projection =
  @sewn
  #from ; %/book_source
  #to ; %/entry_list
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    ?> (./some card) tree.fil (axal/new[myth] .none)
    ?> (./some exchange) (%/exchange/from_myth card) (axal/new[myth] .none)
    | branchmap/project exchange.book "receipts"

"/receipts" =
  @tree
  weft: %/receipts_projection
  tack: '@/y/%/exchange

verses_projection =
  @sewn
  #from ; %/book_source
  #to ; %/entry_list
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    ?> (./some card) tree.fil (axal/new[myth] .none)
    ?> (./some exchange) (%/exchange/from_myth card) (axal/new[myth] .none)
    | branchmap/project exchange.book "verses"

"/verses" =
  @tree
  weft: %/verses_projection
  tack: '@/y/%/exchange
