- branchmap_domain

' Generated by import_snapshot.py; resolution=0 is a local simulation, not venue status.
+ branchmap_sample
  + markets
    ^ row[branchmap/market]
    [
      (branchmap/market "OqEUCA9tCN" "Will the Fed raise interest rates in October 2026?" ["YES" "NO"] [140000 860000] 0 "{""source"":""https://api.manifold.markets/v0/market/OqEUCA9tCN"",""fetched_at"":""2026-10-16T23:05:31.390799+00:00"",""raw_sha256"":""b04459c762655a63ba7c021ee48c435e79d1e29575329931b00ec777e9825b49"",""rules"":""Resolve YES if the Federal Open Market Committee increases the target range for the federal funds rate at its October 27\u201328, 2026 meeting relative to the target range in effect immediately before the meeting.\n\nResolve NO if the FOMC leaves the target range unchanged or lowers it.\n\nResolution will be based on the first official Federal Reserve monetary policy statement issued for the October 27\u201328, 2026 FOMC meeting.\n\nThe size of the increase does not matter. Any increase in the target range counts as YES.\n\nChanges to forward guidance, the balance sheet, quantitative tightening, Treasury operations, or any other policy measure do not count unless the target range for the federal funds rate is also increased.\n\nIf the September FOMC decision is delayed beyond the market\u2019s scheduled closing time, the market will remain closed to trading but unresolved until the Federal Reserve publishes the official decision, at which point it will resolve based on that decision"",""source_is_resolved"":false}")
      (branchmap/market "PUu5UdNR6E" "Another Fed Rate Hike in 2026?" ["YES" "NO"] [804893 195107] 0 "{""source"":""https://api.manifold.markets/v0/market/PUu5UdNR6E"",""fetched_at"":""2026-10-16T23:05:31.450873+00:00"",""raw_sha256"":""4647a6dcea89965ac021d74dd62288eada973119e4d747057be2f0c850fb788d"",""rules"":""Resolves yes if the US Federal Reserve Hikes rates again in 2026, after the rate hike in September. \n\nThere are two scheduled further meetings, in October and December,"",""source_is_resolved"":false}")
      (branchmap/market "AqZzEnIysE" "Bitcoin $120K in 2026?" ["YES" "NO"] [75010 924990] 0 "{""source"":""https://api.manifold.markets/v0/market/AqZzEnIysE"",""fetched_at"":""2026-10-16T23:05:31.514882+00:00"",""raw_sha256"":""88bd61567c52b530db0bc07c0e2771e690967dcbed8a3a9cd3d74ad9293d3554"",""rules"":""This market resolves to \u201cYes\u201d if the BTC/USD spot price reaches or exceeds $120,000 at any time between January 1, 2026, 00:00 PT and December 31, 2026, 23:59 PT, based on Coinbase spot pricing.\n\nPrimary source (API):\n\nhttps://api.coinbase.com/v2/prices/BTC-USD/spot\n\nhttps://api.coinbase.com/v2/prices/BTC-USD/historic?period=year\n\nOtherwise, the market resolves to \u201cNo.\u201d"",""source_is_resolved"":false}")
      (branchmap/market "U55gtI0lnE" "Bitcoin $150K in 2026?" ["YES" "NO"] [14498 985502] 0 "{""source"":""https://api.manifold.markets/v0/market/U55gtI0lnE"",""fetched_at"":""2026-10-16T23:05:31.587858+00:00"",""raw_sha256"":""41b363cce6ca1311c787a281aefd52647324e24e533b1703001b6fce9de61753"",""rules"":""Resolution Criteria:\n\nThe market resolves \u201cYes\u201d if Bitcoin (BTC) reaches or exceeds $150,000 USD at any point in 2026, based on data from Coinbase. The price must be reflected as the high/low price in any 1-minute candlestick during the year. If Bitcoin does not hit $150K during 2026, the market resolves \u201cNo.\u201d\n\nResolution Date & Time: December 31, 2026, at 23:59 PST, or earlier if Bitcoin crosses $150K at any time during the year 2026."",""source_is_resolved"":false}")
      (branchmap/market "9LPpAtIQEn" "Bitcoin below $55K in 2026?" ["YES" "NO"] [88726 911274] 0 "{""source"":""https://api.manifold.markets/v0/market/9LPpAtIQEn"",""fetched_at"":""2026-10-16T23:05:31.650040+00:00"",""raw_sha256"":""ebee2b570e93f950a283998f6c22e459b5b281affdac07192e2ab16340273396"",""rules"":""Yes if the Coinbase BTC-USD 1-minute candle low is \u2264 $55,000 any time between (Jan 1, 2026 00:00 PT) through Dec 31, 2026 23:59 PT; otherwise No.\n\nSource: Coinbase (BTC-USD). \n\nPrimary source (API) Example:\n\nhttps://api.exchange.coinbase.com/products/BTC-USD/candles?start=2026-02-05T22:00:00Z&end=2026-02-06T02:00:00Z&granularity=60\n\nRequired URL parameters:\n\nstart \u2014 ISO8601 UTC start time (e.g., 2026-02-05T22:00:00Z)\n\nend \u2014 ISO8601 UTC end time (e.g., 2026-02-06T02:00:00Z)\n\ngranularity \u2014 seconds per candle (e.g., 60 for 1-minute bars)\n\nResponse:\n\n[ time, low, high, open, close, volume ]\n\ncurl -X GET \""https://api.exchange.coinbase.com/products/BTC-USD/candles?start=2026-02-05T22:00:00Z&end=2026-02-06T02:00:00Z&granularity=60\""\n\nResolution: Dec 31, 2026, 23:59 PT, or earlier upon trigger."",""source_is_resolved"":false}")
      (branchmap/market "8hyIALhpqN" "2026 rate hike parlay (Fed + ECB + BOJ + BOE + PBC)" ["YES" "NO"] [117890 882110] 0 "{""source"":""https://api.manifold.markets/v0/market/8hyIALhpqN"",""fetched_at"":""2026-10-16T23:05:31.715434+00:00"",""raw_sha256"":""ab82814f22b676785c8e94a048ecea4d20f7aa7849850640b7c41cf79ab8acde"",""rules"":""Resolves YES if all the following raise rates at least once at any point in 2026:\n\nUS Federal Reserve\n\nEuropean Central Bank\n\nBank of Japan\n\nBank of England\n\nPeople\u2019s Bank of China\n\nA rate hike of any amount counts, at any meeting including emergency meetings. ALL must hike, otherwise resolves no. "",""source_is_resolved"":false}")
      (branchmap/market "RL8CuzNAhd" "Who will win the 2026 Rolex Shanghai Masters (Shanghai ATP 1000)?" ["Alexander Zverev (1)" "Alejandro Davidovich Fokina (25)" "Rafael Jodar (12)" "Daniil Medvedev (5)"] [500000 100000 130000 270000] 0 "{""source"":""https://api.manifold.markets/v0/market/RL8CuzNAhd"",""fetched_at"":""2026-10-16T23:05:31.781833+00:00"",""raw_sha256"":""6974802f38518de8c0946a8d73fa0ebe469cdca58f631b1bd38d58e2e52acb46"",""rules"":""Resolution criteria\n\nThis market will resolve to whichever player wins the men's singles title at the 2026 Rolex Shanghai Masters (Shanghai ATP 1000). Resolution will be based on the official results published on the ATP Tour website (atptour.com). In the event that the tournament is cancelled, not completed in 2026, or no winner is crowned, this market will resolve to N/A.\n\nBackground\n\nThe Rolex Shanghai Masters is an annual ATP Tour Masters 1000 event held on outdoor hard courts in Shanghai, China, and is the last Masters 1000 of the Asian swing. The semifinals are Alexander Zverev (1) vs Alejandro Davidovich Fokina (25) and Rafael Jodar (12) vs Daniil Medvedev (5), with the final on Sunday, October 18."",""source_is_resolved"":false}")
    ]
  + initial
    ^ branchmap/book
    | branchmap/initial branchmap_sample/markets
