- grove_install

+ branchmap_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'branchmap]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Branchmap template unavailable")
    ? (grove_install/instantiate source version [state.self 'app 'branchmap] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (branchmap_mount/failure why))
