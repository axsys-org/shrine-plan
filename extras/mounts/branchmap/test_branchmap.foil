- branchmap_sample
- testing

+ branchmap_checks
  + ok
    \ result=either[str branchmap/book]
    ^ branchmap/book
    ?> (./ok value) result
      | Seq[branchmap/book] (error (pails/t "Expected accepted transaction")) branchmap_sample/initial
    value
  + refused
    \ result=either[str branchmap/book]
    ^ bool
    ? result
     > (./err message) .true
     > (./ok book) .false
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = seed branchmap_sample/initial
      a (branchmap/assignment 0 0) b (branchmap/assignment 2 1)
      bought (branchmap_checks/ok (branchmap/execute seed "buy" "alice" "0" "0" "10" ""))
      sold (branchmap_checks/ok (branchmap/execute bought "sell" "alice" "0" "0" "10" ""))
      split (branchmap_checks/ok (branchmap/execute seed "split" "alice" "0" "0" "10" ""))
      nested (branchmap_checks/ok (branchmap/execute split "split" "alice" "2" "0" "10" "0:0"))
      merged (branchmap_checks/ok (branchmap/execute nested "merge" "alice" "2" "0" "10" "0:0"))
      top (branchmap_checks/ok (branchmap/execute merged "merge" "alice" "0" "0" "10" ""))
      won (branchmap_checks/ok (branchmap/execute bought "resolve" "operator" "0" "0" "0" ""))
      lost (branchmap_checks/ok (branchmap/execute bought "resolve" "operator" "0" "1" "0" ""))
      partial (branchmap_checks/ok (branchmap/execute nested "resolve" "operator" "0" "0" "0" ""))
      finished (branchmap_checks/ok (branchmap/execute partial "resolve" "operator" "2" "1" "0" ""))
      multi (branchmap_checks/ok (branchmap/execute seed "split" "bob" "6" "0" "10" ""))
      multi_top (branchmap_checks/ok (branchmap/execute multi "merge" "bob" "6" "0" "10" ""))
      created (branchmap_checks/ok (branchmap/execute seed "open-account" "carol" "0" "0" "0" ""))
      price seed.markets.at(0).prices.at(0)
    [(testing/nat "canonical order" 1 (equal (branchmap/canonical [a b]) (branchmap/canonical [b a])))
     (testing/nat "duplicate assignment" 1 (equal (branchmap/canonical [a a]) (branchmap/canonical [a])))
     (testing/nat "contradiction" 1 (maybe/is_none (branchmap/canonical [a (branchmap/assignment 0 1)])))
     (testing/nat "asset traversal aliases" 1 (equal (branchmap/asset_id seed [a b]) (branchmap/asset_id seed [b a])))
     (testing/nat "top canonical" 1 (maybe/is_some (branchmap/canonical [])))
     (testing/nat "buy debits exact integer cash" (sub (mul 100 branchmap/unit) (mul price 10)) (branchmap/cash bought "alice"))
     (testing/nat "buy creates holding" 10 (branchmap/balance bought "alice" [a]))
     (testing/nat "buy consumes house inventory" 90 (branchmap/balance bought "house" [a]))
     (testing/nat "sell restores cash" (branchmap/cash seed "alice") (branchmap/cash sold "alice"))
     (testing/nat "sell consumes position" 0 (branchmap/balance sold "alice" [a]))
     (testing/nat "nested split consumes parent" 0 (branchmap/balance nested "alice" [a]))
     (testing/nat "nested split creates conjunction" 10 (branchmap/balance nested "alice" [a b]))
     (testing/nat "full merge restores cash" (branchmap/cash seed "alice") (branchmap/cash top "alice"))
     (testing/nat "full merge restores collateral" seed.collateral top.collateral)
     (testing/nat "multi-outcome merge restores" (branchmap/cash seed "bob") (branchmap/cash multi_top "bob"))
     (testing/nat "winning payout" (add (branchmap/cash bought "alice") (mul 10 branchmap/unit)) (branchmap/cash won "alice"))
     (testing/nat "loser no payout" (branchmap/cash bought "alice") (branchmap/cash lost "alice"))
     (testing/nat "resolved shares removed" 0 (branchmap/balance won "alice" [a]))
     (testing/nat "partial resolution normalizes conjunction" 10 (branchmap/balance partial "alice" [b]))
     (testing/nat "nested full resolution pays once" (branchmap/cash seed "alice") (branchmap/cash finished "alice"))
     (testing/nat "supply conservation through lifecycle" 1 (row/all[branchmap/book] branchmap/funded [seed bought sold split nested merged top won lost partial finished multi multi_top created]))
     (testing/nat "new account grant" (mul 100 branchmap/unit) (branchmap/cash created "carol"))
     (testing/nat "duplicate account refused" 1 (branchmap_checks/refused (branchmap/open_account created "carol")))
     (testing/nat "insufficient shares refused" 1 (branchmap_checks/refused (branchmap/trade seed "alice" 0 0 101 .false)))
     (testing/nat "insufficient cash refused" 1 (branchmap_checks/refused (branchmap/trade (branchmap/set_cash seed "alice" 0) "alice" 0 0 1 .false)))
     (testing/nat "unowned sell refused" 1 (branchmap_checks/refused (branchmap/trade seed "alice" 0 0 1 .true)))
     (testing/nat "incomplete family refused" 1 (branchmap_checks/refused (branchmap/merge bought "alice" [] 0 1)))
     (testing/nat "repeat predicate refused" 1 (branchmap_checks/refused (branchmap/split split "alice" [a] 0 1)))
     (testing/nat "unknown outcome refused" 1 (branchmap_checks/refused (branchmap/trade seed "alice" 0 99 1 .false)))
     (testing/nat "unknown parent outcome refused" 1 (branchmap_checks/refused (branchmap/split seed "alice" [(branchmap/assignment 0 99)] 2 1)))
     (testing/nat "zero quantity refused" 1 (branchmap_checks/refused (branchmap/trade seed "alice" 0 0 0 .false)))
     (testing/nat "negative quantity refused" 1 (branchmap_checks/refused (branchmap/execute seed "buy" "alice" "0" "0" "-1" "")))
     (testing/nat "joint quote refused" 1 (branchmap_checks/refused (branchmap/execute seed "buy" "alice" "2" "0" "1" "0:0")))
     (testing/nat "repeat resolution refused" 1 (branchmap_checks/refused (branchmap/resolve won 0 0)))
     (testing/nat "closed market trading refused" 1 (branchmap_checks/refused (branchmap/trade won "bob" 0 0 1 .false)))
     (testing/nat "receipts append" 2 sold.receipts.len)
     (testing/nat "revision advances once" 1 bought.revision)
     (testing/text "integer money display" "98.600000" (branchmap/money 98600000))
     (testing/nat "account projection" 3 (branchmap/project bought "accounts").tap.len)
     (testing/nat "trade receipt projection" 1 (branchmap/project bought "receipts").tap.len)
     (testing/nat "market projection" 7 (branchmap/project bought "markets").tap.len)
     (testing/nat "canonical verse projection includes TOP" 17 (branchmap/project seed "verses").tap.len)]

+ tests
  [(testing/case "Native Branchmap ledger and conditional claims" branchmap_checks/checks)]
