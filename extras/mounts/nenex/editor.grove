#import plain=lib/grove/types/text

rich =
  @type
  ! foil
  goo/text
  + read
    \ value=pail
    ^ maybe[rich]
    ? value
     > text=pails/t (./some (goo/text/en text.t))
     > text=goo/text/pail (./some text.value)
    .none
  + write
    \ value=rich
    ^ pail
    | goo/text/pail value
  + contract
    ^ curb
    | (curb/of_type (^ pails/t)).weld((curb/of_type (^ goo/text/pail)))

node =
  @role
  kind: plain

text_toolbar =
  @view
  #on ; %/node
  #for ; /sys/slot/text_toolbar
  node => row('/sys/slot/overlay) {
    button("Bold", '/sys/edit/bold)
    button("Italic", '/sys/edit/italic)
    button("Underline", '/sys/edit/underline)
    button("Clear", '/sys/edit/clear)
  }

text_commands =
  @view
  #on ; %/node
  #for ; /sys/slot/text_commands
  node => col('/sys/slot/overlay) {
    button("Text", '/sys/edit/paragraph)
    button("Heading", '/sys/edit/heading)
    button("Bullet list", '/sys/edit/bullet)
    button("Quote", '/sys/edit/quote)
    button("Code", '/sys/edit/code)
  }

text_node =
  @role
  kind: plain
  text: %/rich

change_text =
  @action
  #meta ;
    "/sys/op": (namespace_op (nenex_edit/operate ['text]))
  #on ; %/text_node
  text: %/rich
  command: plain
  start: plain
  end: plain
  epoch: plain
  ! foil
  \ value=goo/text command=str start=str end=str epoch=str node=%/text_node
  ^ %/text_node
  | Seq[%/text_node] (error (pails/t "Requires the Nenex source transaction.")) node

edit_text =
  @view
  #on ; %/text_node
  #for ; /sys/slot/nenex_edit
  node => group(on = node, action = %/change_text, myth = { '/text = .input(node.text) }) {
    col('/sys/slot/content) {
      input('/text, "rich-block")
      row('/sys/slot/block_actions) {
        action("Save", '/command = "save", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("+", '/command = "add", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Move up", '/command = "up", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Move down", '/command = "down", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Delete", '/command = "delete", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Merge", '/command = "merge", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Split", '/command = "split", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Text", '/command = "paragraph", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Heading", '/command = "heading", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Bullet list", '/command = "bullet", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Quote", '/command = "quote", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
        action("Code", '/command = "code", '/start = .input("0"), '/end = .input("0"), '/epoch = .input("0"))
      }
    }
  }

