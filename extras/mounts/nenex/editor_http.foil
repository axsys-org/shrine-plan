- browser_routes
- apps/nenex/main [at=wiki]
- semidoc [at=sd]
- nenex_editor
- goo_browser
- answering
- native_work

+ nenex_editor_http
  + label
    \ text=str slot=str
    ^ weft/node
    = attrs (goo/semantic_attrs (goo/common (goo/slot slot) (goo/rank/required) goo/config/empty .none) (goo/node_id "navigation") .none)
      node (goo/semantic/text attrs (goo/text/en text))
    ?> (./ok prepared) (goo_prepared/prepare (./some node) (goo_fp/integer 720) (goo_fp/integer 1) .false)
      | weft/tx "Unsupported text"
    | weft/raw (str/to_atom (goo_html/fragment prepared))
  + link
    \ url=str text=str
    ^ weft/node
    | weft/el "a" [(weft/href (str/to_atom url))] [(nenex_editor_http/label text "body")]
  + url
    \ target=path
    ^ str
    | str/cat_all ["/nenex/edit?path=" (value_read/percent (path_show target))]
  + page_record
    \ record=myth self=iota
    ^ bool
    | equal[pail] record.pail_at(limb_slot) (kook [[self 'app 'nenex 'kook 'doc]])
  + wiki_branch
    \ path=path
    ^ bool
    | path.all((\ part=iota (and (wiki/valid_page_name (quip_val part))
        !(row/has[iota] part ['cells 'work 'holes 'inputs 'flows]))))
  + allowed
    \ selected=path state=namespace
    ^ bool
    = corpus=path [state.self 'app 'nenex 'w]
    | and (pith_prefix corpus selected)
        ((nenex_editor_http/page_record (nenex_edit/record selected state) state.self) ||
          ((equal[path] selected corpus) || (nenex_editor_http/wiki_branch selected.drop(corpus.len))))
  + frontier
    ' One ordinary y frontier, paged by the native axal child cursor. No whole
    ' corpus traversal or retained navigation index is constructed for a page.
    \ selected=path after=str expected=str state=namespace
    ^ either[iota json]
    ? !(nenex_editor_http/allowed selected state) (./err 'nenex_not_document_content)
    ' Transparent folders have no asserted target-local history. Use the same
    ' native namespace event epoch as ordinary Goo topology for that case.
    = epoch (nat/show (state.case(.y selected)).fall(state.local.rec.len))
    ? (and after.len !(expected.len)) (./err 'nenex_frontier_requires_epoch)
    ? (and expected.len !(eq expected epoch)) (./err 'nenex_page_tree_changed)
    = cursor=maybe[iota]
        ? !(after.len) .none
        ?> (./some path) (physical_key/decode after) .none
        ? !(and (eq path.len selected.len.inc) (pith_prefix selected path)) .none
        | ./some path.at(selected.len)
    ? (and after.len !(cursor.is_some)) (./err 'nenex_invalid_tree_cursor)
    = tree (sovereign_care .y selected state)
      children tree.kid.range_after(cursor 65)
      count (? (gt children.len 64) 64 children.len)
      visible=row[bee/kv[axal/k[myth]]] children.take(count)
      next=maybe[str]
        ? (le children.len 64) .none
        ?> (./ok cursor) (physical_key/encode selected.snoc(visible.at(visible.len.dec).key)) .none
        | ./some cursor
    ? (and (gt children.len 64) !(next.is_some)) (./err 'nenex_tree_cursor_unavailable)
    = members=row[json]
        | visible.sift
          \ entry=bee/kv[axal/k[myth]]
          ^ maybe[json]
          = child (unpin entry.val.held)
            target selected.snoc(entry.key)
            record child.fil.fall(myth/new)
            document (nenex_editor_http/page_record record state.self)
          ? (and !(document) !(nenex_editor_http/wiki_branch [entry.key])) .none
          ? (and !(document) child.fil.is_some) .none
          | ./some (json/obj [(jkv "root" (json/str (path_show target)))
              (jkv "document" (json/boo document))
              (jkv "life" (json/str (nat/show (goo_runtime/lifetime target state))))
              (jkv "hasChildren" (json/boo (gt child.kid.size 0)))
              (jkv "label" (json/str (? document record.txt_at(system_vocabulary/lede) (path_show target))))])
    | ./ok (json/obj [(jkv "root" (json/str (path_show selected))) (jkv "epoch" (json/str epoch))
        (jkv "life" (json/str (nat/show (goo_runtime/lifetime selected state))))
        (jkv "hasChildren" (json/boo (gt tree.kid.size 0)))
        (jkv "members" (json/arr members)) (jkv "next" (next.run((\ text=str (json/str text))).fall(jnull)))])
  + presentation
    \ target=path view=path label=str readonly=bool
    ^ json
    | json/obj [(jkv "key" (json/str (str/cat_all [(path_show target) "@" (path_show view)])))
        (jkv "target" (json/str (path_show target))) (jkv "view" (json/str (? view.len (path_show view) "")))
        (jkv "kind" (json/str "presentation")) (jkv "label" (json/str label))
        (jkv "readonly" (json/boo readonly))]
  + declared_view
    ' A reference retains its authored descriptor. A descriptor may explicitly
    ' name a Goo view; never guess a replacement presentation for an embed.
    \ descriptor=path state=namespace
    ^ maybe[path]
    = card (nenex_edit/record descriptor state)
    ? card.has(system_vocabulary/grove/view) (./some descriptor)
    < target card.path_at(['goo 'view])
    ? !((nenex_edit/record target state).has(system_vocabulary/grove/view)) .none
    | ./some target
  + block
    \ root=path state=namespace target=path
    ^ json
    = card (nenex_edit/record target state)
      field (sd/text_field card.txt_at(['kind]))
      descriptor card.path_at(['doc 'embed])
      embedded=maybe[path]
        < descriptor descriptor
        | nenex_editor_http/declared_view descriptor state
      view=path
        ? field.len [state.self 'gov 'nenex_editor ($ts (str/cat_all ["edit_" (? (equal[path] field ['lead]) card.txt_at(['kind]) (str/from_atom (quip_val field.at(0))))]))]
        | embedded.fall([])
      reference card.path_at(['ref]).fall([])
      subject (? embedded.is_some reference target)
    | json/obj [(jkv "key" (json/str (path_show target))) (jkv "target" (json/str (path_show subject))) (jkv "view" (json/str (? view.len (path_show view) "")))
        (jkv "kind" (json/str card.txt_at(['kind]))) (jkv "editor" (json/boo (gt field.len 0)))
        (jkv "reference" (json/str (? reference.len (path_show reference) "")))
        (jkv "descriptor" (json/str (? descriptor.is_some (path_show descriptor.fall([])) "")))
        (jkv "depth" (json/num .false target.drop(root.len).len))]
  + related
    \ root=path state=namespace
    ^ row[json]
    | (wiki/old_mounts (str/to_atom (nenex_edit/record root state).txt_at(['src]))).bind
      \ mount=sd/smount
      ^ row[json]
      ?> (./some receiver) mount.t.path_at(['ref]) []
      ?> (./some descriptor) mount.t.path_at(['doc 'embed]) []
      ?> paths=pails/ps (nenex_edit/record descriptor state).pail_at(['goo 'cells]) []
      | paths.ps.map
        \ relative=path
        ^ json
        | nenex_editor_http/presentation (row/cons[iota] 'x receiver.weld(relative)) []
            (str/cat_all ["Related cell " (path_show relative)]) .true
  + tools
    \ root=path state=namespace
    ^ row[json]
    = declared (sovereign_care .y [state.self 'gov 'nenex_ui 'tools] state)
    | declared.tap.sift
      \ [at card]
      ^ maybe[json]
      < view card.path_at(['goo 'view])
      | ./some (nenex_editor_http/presentation card.path_at(['goo 'target]).fall(root) view card.txt_at(system_vocabulary/lede) .false)
  + manifest
    \ root=path state=namespace
    ^ either[iota json]
    = source (nenex_edit/record root state).txt_at(['src])
      children (wiki/old_mounts (str/to_atom source))
    ? ((gt children.len 256) || (gt source.len 196608)) (./err 'nenex_document_limit)
    = paths=row[path] (row/cons[path] root (children.map((\ mount root.weld(mount.p)))))
      blocks (paths.map((nenex_editor_http/block root state)))
      header (nenex_editor_http/presentation root [state.self 'gov 'nenex_tools 'page_header] "" .false)
      work (sovereign_care .y root.weld(['work 'questions]) state)
      answers=row[json]
        | work.tap.bind
          \ [relative card]
          ^ row[json]
          ? !(card.has(['answer 'config])) []
          = target root.weld(['work 'questions]).weld(relative)
          | [(nenex_editor_http/presentation (row/cons[iota] 'x (row/snoc[iota] 'answer target))
                (? card.txt_at(['answer 'error]).len [] [state.self 'gov 'nenex_tools 'current_answer_view])
                (? card.txt_at(['answer 'error]).len "Retained output requiring review" "Current answer") .true)
             (nenex_editor_http/presentation target
                [state.self 'gov 'nenex_tools 'answer_view] "Question controls" .false)
             (nenex_editor_http/presentation (row/cons[iota] 'x root.weld(['cells 'questions]).weld(relative)) [] "Live question context" .true)]
      holes (sovereign_care .y (row/snoc[iota] 'holes root) state)
      hole_paths=row[path]
        | holes.tap.sift
          \ [relative card]
          ^ maybe[path]
          ? !(card.has(['work 'hole])) .none
          | ./some (row/snoc[iota] 'holes root).weld(relative)
      question_holes=row[path]
        | work.tap.sift
          \ [relative card]
          ^ maybe[path]
          ?> config=answering/config card.pail_at(['answer 'config]) .none
          ? !(equal[path] config.subject root) .none
          | ./some config.hole
      demands=row[json]
        | (row/uniq[path] hole_paths.weld(question_holes)).sift
          \ target=path
          ^ maybe[json]
          ?> hole=native_work/hole (nenex_edit/record target state).pail_at(['work 'hole]) .none
          | ./some (nenex_editor_http/presentation target
              [state.self 'gov 'nenex_tools 'hole_view] "Unresolved work" .false)
      cells (sovereign_care .y (row/snoc[iota] 'cells root) state)
      inspections=row[json]
        | cells.tap.sift
          \ [relative card]
          ^ maybe[json]
          ? !(card.has(bond/weft)) .none
          = part (nenex_editor_http/presentation (row/cons[iota] 'x (row/snoc[iota] 'cells root).weld(relative)) [] card.txt_at(system_vocabulary/lede) .true)
          | ./some part
      history=path ['h 'v ($u root.len)]
      details=row[json]
        [(nenex_editor_http/presentation root [] "Page record and connections" .true)
         (nenex_editor_http/presentation history.weld(root) [] "Native history and version metadata" .true)]
    | ./ok (json/obj [(jkv "root" (json/str (path_show root))) (jkv "epoch" (json/str (nat/show state.local.top)))
        (jkv "blocks" (json/arr (row/cons[json] header blocks)))
        (jkv "tools" (json/arr ((nenex_editor_http/tools root state).weld(answers).weld(demands).weld(inspections).weld((nenex_editor_http/related root state)).weld(details))))])
  + shell
    \ selected=path entries=row[json] frontier=json
    ^ [nat str]
    = manifest (json/obj [(jkv "root" (json/str (path_show selected))) (jkv "pages" (json/arr entries))
        (jkv "frontier" frontier) (jkv "documentUrl" (json/str "/nenex/document")) (jkv "childrenUrl" (json/str "/nenex/children"))])
      body=row[weft/node]
        [(nenex_editor_http/link "/nenex" "Nenex library")
         (weft/el "main" [(weft/att "data-goo-document-tree" "") (weft/att "data-manifest" (str/to_atom (show manifest)))] [])]
      assets (goo_browser/presentation_assets).snoc((weft/el "script" [(weft/att "src" "/static/goo-document.js") (weft/att "defer" "defer")] []))
    | [200 (str/from_atom (weft/page_with_body_attributes "Nenex" assets [(weft/cls "goo-surface")] body))]
  + library_manifest
    \ selected=path state=namespace
    ^ json
    = header (nenex_editor_http/presentation selected [state.self 'gov 'nenex_tools 'library_header] "" .false)
      inspect (nenex_editor_http/presentation selected [] "Library record, search results and history" .true)
    | json/obj [(jkv "root" (json/str (path_show selected))) (jkv "epoch" (json/str (nat/show state.local.top)))
        (jkv "blocks" (json/arr [header])) (jkv "tools" (json/arr [inspect]))]
  + page
    \ selected=path state=namespace
    ^ [nat str]
    = selected (nenex_edit/owner selected state).fall(selected)
    ? !(nenex_editor_http/allowed selected state) [404 "Choose a native Nenex page tree."]
    ?> (./ok frontier) (nenex_editor_http/frontier selected "" "" state) [409 "This page frontier is unavailable."]
    ? (equal[path] selected [state.self 'app 'nenex 'w])
      | nenex_editor_http/shell selected [(nenex_editor_http/library_manifest selected state)] frontier
    ? !(nenex_editor_http/page_record (nenex_edit/record selected state) state.self)
      | nenex_editor_http/shell selected [] frontier
    ?> (./ok page) (nenex_editor_http/manifest selected state) [413 "This page exceeds the existing document editing limits."]
    | nenex_editor_http/shell selected [page] frontier
  + document_response
    \ selected=path state=namespace
    ^ [nat str]
    ? (equal[path] selected [state.self 'app 'nenex 'w]) [200 (show (nenex_editor_http/library_manifest selected state))]
    ? !(and (nenex_editor_http/allowed selected state) (nenex_editor_http/page_record (nenex_edit/record selected state) state.self))
      [404 "Choose a native Nenex document."]
    ?> (./ok manifest) (nenex_editor_http/manifest selected state) [413 "This page exceeds the existing document editing limits."]
    | [200 (show manifest)]
  + children_response
    \ selected=path after=str epoch=str state=namespace
    ^ [nat str]
    ? (nenex_editor_http/frontier selected after epoch state)
     > (./ok frontier) [200 (show frontier)]
     > (./err why) [409 (str/from_atom (quip_val why))]
  + data_request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
    = parts (http_foot/split 63 request.target)
      route parts.at(0)
      query=str (? (eq parts.len 2) parts.at(1) "")
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) (./reply (http_driver/response 400 "Invalid query"))
    ? !(and (eq fields.len (row/uniq[str] (fields.map((\ [key value] key)))).len)
        (fields.all((\ [key value] (row/has[str] key ["path" "after" "epoch"])))))
      (./reply (http_driver/response 400 "Expected one path and optional native continuation"))
    ? (and (eq route "/nenex/document") !(eq fields.len 1)) (./reply (http_driver/response 400 "Choose one document path"))
    ?> (./some target) (browser_routes/value_path (http_foot/field "path" fields)) (./reply (http_driver/response 400 "Invalid path"))
    = plan
        \ state=namespace
        ^ [nat str]
        ? (eq route "/nenex/document") (nenex_editor_http/document_response target state)
        | nenex_editor_http/children_response target (http_foot/field "after" fields) (http_foot/field "epoch" fields) state
    | ./after plan
      \ status=nat body=str
      | http_foot/action/bytes status (http_foot/bar (str/to_atom body)) "application/json; charset=utf-8"
  + request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
    = pieces (http_foot/split 63 request.target)
      query=str (? (eq pieces.len 2) pieces.at(1) "")
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) (./reply (http_driver/response 400 "Invalid query"))
    ? !(eq fields.len 1) (./reply (http_driver/response 400 "Choose one document path"))
    = [key value] fields.at(0)
    ? !(eq key "path") (./reply (http_driver/response 400 "Choose one document path"))
    ?> (./some target) (browser_routes/value_path value) (./reply (http_driver/response 400 "Invalid path"))
    | ./after (nenex_editor_http/page target)
      \ status=nat body=str
      | http_foot/action/bytes status (http_foot/bar (str/to_atom body)) "text/html; charset=utf-8"

  + source_plan
    \ fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some target) (browser_routes/value_path (http_foot/field "page" fields)) (./err 'nenex_not_document_content)
    = input (myth/sing ['src] (pails/t (http_foot/field "src" fields))).put(['epoch] (pails/t (http_foot/field "epoch" fields)))
    | nenex_edit/source target input state
  + source_response
    \ fields=row[[str str]] refused=maybe[pail] state=namespace
    ^ [nat str]
    = message=str
        ?> (./some why) refused ""
        | http_foot/reason why
      redirect (str/cat_all ["/nenex?path=" (value_read/percent (http_foot/field "page" fields))])
    | [(? refused.is_some 409 200) (show (json/obj [(jkv "error" (json/str message)) (jkv "redirect" (json/str redirect))]))]
  + source_request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    ? (gt request.body.len 1048576) (./reply (http_driver/response 413 "Source form too large"))
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields request.body) (./reply (http_driver/response 400 "Invalid form"))
    ? !(and (eq fields.len 3) (and (eq (row/uniq[str] (fields.map((\ [key value] key)))).len 3) (fields.all((\ [key value] (row/has[str] key ["page" "epoch" "src"])))))) (./reply (http_driver/response 400 "Expected page, epoch and src"))
    | ./admit (nenex_editor_http/source_plan fields) (nenex_editor_http/source_response fields) (\ outcome before state "")
