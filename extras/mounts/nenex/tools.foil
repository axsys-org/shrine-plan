- nenex_editor
- nenex_questions
- apps/nenex/main [at=wiki]

' Presentation arguments adapt existing native document and work operations.
' These laws own no document, question, hole, retry or watcher state.
+ nenex_tools
  + source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['source])) (./err 'nenex_invalid_input)
    ?> (./some decoded) (goo_edit/decode input.pail_at(['source])) (./err 'nenex_invalid_rich_text)
    ? !(decoded.value.all((\ run=goo/runt (eq run.myth.size 0)))) (./err 'nenex_source_requires_plain_text)
    = edit (myth/sing ['src] (pails/t decoded.value.plain)).put(['epoch] (pails/t (nat/show state.local.top)))
    | nenex_edit/source target edit state
  + create
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['name])) (./err 'nenex_invalid_input)
    = name (str/to_atom input.txt_at(['name]))
      hub=path [state.self 'app 'nenex 'w]
    ? !(wiki/valid_page_name name) (./err 'nenex_invalid_page_name)
    ? (sovereign_peek hub.snoc(($ts name)) state).wyt (./err 'nenex_page_exists)
    | ./ok [[hub (writ/poke (myth/sing ['post 'new] (pails/t (str/from_atom name))))]]
  + ask
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(input.tap.all((\ field (row/has[path] field.key [['id] ['question] ['scope] ['evidence] ['provider]])))) (./err 'nenex_invalid_input)
    = scope input.txt_at(['scope])
      provider input.txt_at(['provider])
      fields=row[[str str]]
        [["action" "ask"] ["page" (path_show target)]
         ["source" (nenex_edit/record target state).txt_at(['src])]
         ["id" input.txt_at(['id])] ["question" input.txt_at(['question])]
         ["scope" (? scope.len scope "page")]
         ["evidence" input.txt_at(['evidence])]
         ["provider" (? provider.len provider (path_show [state.self 'io 'codex 'work_provider]))]]
    | nenex_questions/plan fields state
  + enabled
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['enabled])) (./err 'nenex_invalid_input)
    = enabled input.txt_at(['enabled])
    ? !(row/has[str] enabled ["true" "false"]) (./err 'nenex_invalid_input)
    | namespace_command/plan target [state.self 'gov 'cooperate 'answer_enabled]
        (myth/sing ['enabled] (pails/b (eq enabled "true"))) state
  + resolve
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['content])) (./err 'nenex_invalid_input)
    = current (nenex_edit/record target state)
    ?> (./some held) current.get(['work 'hole_state]) (./err 'missing_work_hole)
    ?> progress=native_work/hole_state held (./err 'missing_work_hole)
    ?> (./some attempt) progress.attempt (./err 'missing_work_attempt)
    = request (myth/sing ['content] input.pail_at(['content])).put(['attempt] (pails/p attempt)).put(['expected] (pails/n progress.generation))
    | namespace_command/plan target [state.self 'gov 'cooperate 'resolve_hole] request state
  + rebind
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['scope])) (./err 'nenex_invalid_input)
    ? !(and (ge target.len 3) (equal[path] target.drop((sub target.len 3)).take(2) ['work 'questions])) (./err 'missing_work)
    = page target.take((sub target.len 3))
      fields=row[[str str]]
        [["action" "rebind"] ["page" (path_show page)] ["id" (str/from_atom (quip_val target.at(target.len.dec)))]
         ["source" (nenex_edit/record page state).txt_at(['src])] ["scope" input.txt_at(['scope])]]
    | nenex_questions/plan fields state
  + search
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(and (eq input.tap.len 1) input.has(['query])) (./err 'nenex_invalid_input)
    = hub=path [state.self 'app 'nenex 'w]
    | ./ok [[hub (writ/poke (myth/sing ['post 'q] input.pail_at(['query])))]]
