- nenex_tools
- nenex_editor_http
- nenex_mount
- nenex_question_tests
- goo_actions [at=document_actions]
- goo_browser [at=document_browser]
- goo_bridge [at=document_bridge]
- eden
- testing

' Receives the actual production editor/tool publications from the Reaver gate.
+ nenex_document_tests
  + previous
    \ state=namespace target=path
    ^ nat
    | state.case(.x target).fall(0)
  + lookup
    \ state=namespace target=path
    ^ maybe[myth]
    | (sovereign_care .x target state).fil
  + bootstrap
    \ state=namespace
    ^ namespace
    ?> (./ok state) (eden/boot state.self state.system state.local 18135) (Seq[namespace] (error (pails/t "Disposable Eden boot failed")) state)
    ?> (./ok state) (cooperate_mount/install state) (Seq[namespace] (error (pails/t "Disposable Cooperate activation failed")) state)
    ?> (./ok state) (nenex_mount/install state) (Seq[namespace] (error (pails/t "Disposable Nenex activation failed")) state)
    | nenex_question_tests/poke [state.self 'user 'answer_provider]
        (myth/sing ['work 'provider] (native_work/provider nenex_question_tests/provider)) state
  + query_at
    \ target=path face=path label=str fields=row[[str str]] state=namespace
    ^ goo_runtime/request
    = current (nenex_edit/record target state)
      fallback (goo_runtime/request "act" target target face [] 0 0 0 [] 0)
    ?> (./ok published) (goo_runtime/published (nenex_edit/record face state)) fallback
    ?> (./ok lowered) (goo_runtime/matching_view published current) fallback
    = base (goo_runtime/request "act" target target face [] state.case(.x target).fall(0)
        state.case(.y target).fall(0) (goo_runtime/publication state) [] 0)
      controls (document_actions/goo_actions/controls lowered.children [] (goo_runtime/scope .none .none .nil .none .none)
        base published.view.binding).tap.keep((\ [path card] (eq card.txt_at(['title]) label)))
    ? !(eq controls.len 1) fallback
    = [_ card] controls.at(0)
    ?> query=goo_runtime/request card.pail_at(['goo 'request]) fallback
    | query.set_inputs(fields.map((\ [key value] [(str/cat_all ["/" key])
        (? (eq card.txt_at([($ts key) 'goo 'input]) "rich_text") (show (goo_text/encode (goo/text/en value))) value)])))
  + query
    \ target=path view=iota label=str fields=row[[str str]] state=namespace
    ^ goo_runtime/request
    | nenex_document_tests/query_at target [state.self 'gov 'nenex_tools view] label fields state
  + source_text
    \ rendered=either[str json]
    ^ str
    ?> (./ok value) rendered "Source render failed"
    ?> (json/arr controls) (goo_runtime/json_field "controls" value) "Missing controls"
    = inputs controls.keep((\ control (and
        (equal (goo_runtime/json_field "kind" control) (json/str "input"))
        (equal (goo_runtime/json_field "slot" control) (json/str "/source")))))
    ? !(eq inputs.len 1) "Missing or ambiguous source control"
    ?> (json/arr nodes) (goo_runtime/json_field "nodes" (goo_runtime/json_field "display" value)) "Missing display nodes"
    = matching nodes.keep((\ node (equal (goo_runtime/json_field "id" node) (goo_runtime/json_field "id" inputs.at(0)))))
    ? !(eq matching.len 1) "Missing or ambiguous source node"
    ?> (./some text) (goo_text/decode (goo_runtime/json_field "textRuns" matching.at(0))) "Invalid source text encoding"
    ? !(text.all((\ run=goo/runt (eq run.myth.size 0)))) "Source input contains formatting"
    | text.plain
  + checks
    \ state=namespace
    ^ row[testing/check]
    = root=path [state.self 'app 'nenex 'w 'home]
      source=str (str/from_atom (joined 10 [(str/to_atom (str/cat_all [";. " (path_show root)])) "  ;= Shared document" "    ;@ /flow/bind pages document"
        "    ;@ /flow/bind sources captured" (str/to_atom (str/cat_all ["    A source authored through Goo. " (str/repeat 180 "Source export must preserve complete authored prose. ")]))]))
      saved_query (nenex_document_tests/query root 'source_view "Save source" [["source" source]] state)
      [saved saved_status saved_body] (goo_runtime/act saved_query state)
      block=path root.weld([($u 0) ($u 0)])
      goo_query (nenex_document_tests/query_at block [state.self 'gov 'nenex_editor 'edit_text] "Save"
        [["text" "Edited through the same Goo surface."] ["start" "0"] ["end" "0"] ["epoch" (nat/show saved.local.top)]] saved)
      [goo goo_status goo_body] (goo_runtime/act goo_query saved)
      created_query (nenex_document_tests/query root 'create_view "Create page" [["name" "publication_probe"]] goo)
      [created created_status created_body] (goo_runtime/act created_query goo)
      created_path=path [state.self 'app 'nenex 'w 'publication_probe]
      asked_query (nenex_document_tests/query root 'ask_view "Ask"
        [["id" "surface_probe"] ["question" "What does this page describe?"] ["scope" "page"] ["evidence" ""]
         ["provider" (path_show [state.self 'user 'answer_provider])]] created)
      [asked asked_status asked_body] (goo_runtime/act asked_query created)
      question=path root.weld(['work 'questions 'surface_probe])
      hole=path root.weld(['holes 'questions 'surface_probe])
      pause_query (nenex_document_tests/query question 'answer_view "Pause answering" [] asked)
      [paused pause_status pause_body] (goo_runtime/act pause_query asked)
      rebind_query (nenex_document_tests/query question 'answer_view "Bind current page or block selection"
        [["scope" (path_show block)]] paused)
      [rebound rebind_status rebind_body] (goo_runtime/act rebind_query paused)
      resolve_query (nenex_document_tests/query hole 'hole_view "Resolve with this evidence"
        [["content" "Recorded a deliberate resolution for the captured question."]] rebound)
      [resolved resolve_status resolve_body] (goo_runtime/act resolve_query rebound)
      [stale stale_status stale_body] (goo_runtime/act saved_query goo)
      source_render (document_browser/goo_browser/render_result document_bridge/goo_bridge/initial_context
        root [state.self 'gov 'nenex_tools 'source_view] [] [] [] .none saved)
      block_render (document_browser/goo_browser/render_result document_bridge/goo_bridge/initial_context
        root.weld([($u 0) ($u 0)]) [state.self 'gov 'nenex_editor 'edit_text] [] [] [] .none saved)
      answer_render (document_browser/goo_browser/render_result document_bridge/goo_bridge/initial_context
        question [state.self 'gov 'nenex_tools 'answer_view] [] [] [] .none asked)
      current_render (document_browser/goo_browser/render_result document_bridge/goo_bridge/initial_context
        (row/cons[iota] 'x question.snoc('answer)) [state.self 'gov 'nenex_tools 'current_answer_view] [] [] [] .none asked)
      hole_render (document_browser/goo_browser/render_result document_bridge/goo_bridge/initial_context
        root.weld(['holes 'questions 'surface_probe]) [state.self 'gov 'nenex_tools 'hole_view] [] [] [] .none asked)
      before_history=bool (row/all[care] (\ care (equal (namespace/page care state.case(care root) root state)
          (namespace/page care state.case(care root) root asked))) [.x .y .z])
      controller (nenex_edit/record question asked)
      [manifest_status manifest] (nenex_editor_http/document_response root asked)
      [shell_status shell] (nenex_editor_http/page root asked)
    | [(testing/nat "production source view prepares rich source controls" 1 (either/is_ok source_render))
       (testing/nat "large source exceeds the former transport preview size" 1 (gt source.len 8192))
       (testing/text "Goo source input exports the entire authored value" source (nenex_document_tests/source_text source_render))
       (testing/nat "production source control commits through native admission" 200 saved_status)
       (testing/text "source control retains exact multiline Semidoc bindings" source (nenex_edit/record root saved).txt_at(['src]))
       (testing/nat "production block editor renders the same native source" 1 (either/is_ok block_render))
       (testing/nat "production block control commits the native source transaction" 200 goo_status)
       (testing/nat "source and Goo controls retain both authored bindings" 1
         (equal (nenex_edit/record block saved).get(['flow 'bind]) (nenex_edit/record block goo).get(['flow 'bind])))
       (testing/nat "production creation control commits native page creation" 200 created_status)
       (testing/nat "creation uses the existing Nenex document kook" 1 (nenex_editor_http/page_record (nenex_edit/record created_path created) state.self))
       (testing/nat "production question control invokes shared answering" 200 asked_status)
       (testing/nat "production question pause uses the native answering operation" 200 pause_status)
       (testing/nat "production rebind retains and changes the native context lens" 200 rebind_status)
       (testing/nat "production resolve control uses the native hole generation guard" 200 resolve_status)
       (testing/text "the native hole retains its explicit resolution" "resolved" (nenex_edit/record hole resolved).txt_at(['work 'status]))
       (testing/nat "a source request captured before a Goo edit is rejected" 409 stale_status)
       (testing/nat "stale source request preserves the current world" 1 (equal[namespace] stale goo))
       (testing/text "question controller retains native work status" "running" controller.txt_at(['work 'status]))
       (testing/nat "production answer view binds the real controller" 1 (either/is_ok answer_render))
       (testing/nat "current answer view reads the live answer cell" 1 (either/is_ok current_render))
       (testing/nat "production hole view binds the real persistent hole" 1 (either/is_ok hole_render))
       (testing/nat "source action preserves all prior x/y/z history" 1 before_history)
       (testing/nat "per-page refresh returns exactly one manifest" 200 manifest_status)
       (testing/nat "native question hole is reachable through the page surface" 1
         (cord/has "holes/questions/surface_probe" (str/to_atom manifest)))
       (testing/nat "page surface reads current answers from the reactive cell" 1
         (cord/has "/x/0x11/app/nenex/w/home/work/questions/surface_probe/answer" (str/to_atom manifest)))
       (testing/nat "per-page refresh never includes the child frontier" 0 (cord/has "childrenUrl" (str/to_atom manifest)))
       (testing/nat "primary Nenex uses the shared Goo page host" 1 (cord/has "data-goo-document-tree" (str/to_atom shell)))
       (testing/nat "primary Nenex has no reader application script" 0 (cord/has "interface.js" (str/to_atom shell)))]
  + frontier_checks
    \ state=namespace
    ^ row[testing/check]
    = root=path [state.self 'app 'nenex 'w 'home]
      lines (row/range 0 70).bind((\ n=nat ["" (str/to_atom (str/cat_all ["  Paragraph " (nat/show n)]))]))
      source (str/from_atom (joined 10 (row/cons[nat] ";." lines)))
      input (myth/sing ['source] (pails/t (show (goo_text/encode (goo/text/en source)))))
    ?> (./ok writes) (nenex_tools/source root input state) [(testing/nat "frontier source fixture admits" 1 0)]
    ?> (./ok expanded) (grove_install/changes writes state) [(testing/nat "frontier source fixture expands" 1 0)]
    = child=path root.snoc('chapter)
      card (myth/sing ['src] (pails/t ";= Child page")).put(limb_slot (kook [[state.self 'app 'nenex 'kook 'doc]]))
    ?> (./ok nested) (grove_install/change child (writ/make card) expanded) [(testing/nat "nested native page fixture admits" 1 0)]
    ?> (./ok first) (nenex_editor_http/frontier root "" "" nested) [(testing/nat "first native frontier admits" 1 0)]
    = cursor (goo_runtime/json_text (goo_runtime/json_field "next" first))
      epoch (goo_runtime/json_text (goo_runtime/json_field "epoch" first))
      second (nenex_editor_http/frontier root cursor epoch nested)
      all=str (str/cat_all [(show first) (? (either/is_ok second) (show (either/ok_val second)) "")])
      changed (nenex_question_tests/poke child (myth/sing ['src] (pails/t ";= Revised child page")) nested)
      stale (nenex_editor_http/frontier root cursor epoch changed)
      [own_code own] (nenex_editor_http/document_response root nested)
      [child_code child_manifest] (nenex_editor_http/document_response child nested)
      [block_code block_manifest] (nenex_editor_http/document_response root.snoc(($u 0)) nested)
      [foreign_code foreign_manifest] (nenex_editor_http/document_response [state.self 'user 'private] nested)
    | [(testing/nat "large native frontier uses a continuation instead of a whole-tree limit" 1 (gt cursor.len 0))
       (testing/nat "native continuation admits the remaining page frontier" 1 (either/is_ok second))
       (testing/nat "native page under a source with many prose children remains discoverable" 1 (cord/has "/chapter" (str/to_atom all)))
       (testing/nat "changed native frontier refuses an old continuation" 1 (either/is_err stale))
       (testing/nat "parent page refresh remains within the existing document bound" 200 own_code)
       (testing/nat "named child page has its own refresh endpoint" 200 child_code)
       (testing/nat "document endpoint refuses an ordinary block" 404 block_code)
       (testing/nat "document endpoint refuses non-wiki records" 404 foreign_code)
       (testing/nat "parent manifest does not incorporate its child's page source" 0 (cord/has "Child page" (str/to_atom own)))
       (testing/nat "native child manifest keeps its own document root" 1 (cord/has "/home/chapter" (str/to_atom child_manifest)))]
  + report
    \ state=namespace
    ^ row[[str bool str str]]
    | ((nenex_document_tests/checks state).weld((nenex_document_tests/frontier_checks state))).map((\ check [check.name check.pass check.want check.got]))
