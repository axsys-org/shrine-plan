(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))
(#bind runner (#module foil-test-runner))
(#bind testing (#module testing))
(#bind source (#module foil-source))
(#bind publication (#module foil-publication))
(#bind context (#module foil-context))

;; Compile the production source and block editors, then invoke their declared
;; controls against a disposable native world and its page frontiers.
(define (run ignored)
  (define compiler (Pin "nenex-document-test"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define suites ["apps/nenex/tests" "nenex_editor_tests" "nenex_editor_http_tests" "nenex_question_tests"])
  (define modules (Weld ["grove_backend" "nenex_tools" "nenex_document_tests"] suites))
  (define local (bootstrap:build-local ("x" 17) system resolve slot modules))
  (define code (_1 local))
  (DeepSeq code (print "Authoring fixture compiled"))
  (define native-results (cat (map (lambda (name)
    (runner:native (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_2 code))))))) suites)))
  (DeepSeq native-results 0)
  (define prepared (backend:prepare-with code "nenex_tools"))
  (define module (_1 prepared))
  (define fixture (Unpin (_1 (need (find (lambda (pair)
    (Equal "nenex_document_tests" (_0 pair))) (_2 code))))))
  (define (helper name) (driver:get-perc ["nenex_document_tests" name] fixture))
  (define (path names) (Weld [("x" 17)] (map (lambda (name) ("ts" name)) names)))
  (define (ok result)
    (If (Equal "ok" (Hd result)) (_0 result)
      (error ["nenex-document" (_0 result)])))
  (define (publish prepared root text state)
    (define document (ok ((driver:get-perc ["grove" "parse"] module) text)))
    (define (previous key)
      ((helper "previous") state (map (lambda (part) ((_0 part) (_1 part))) key)))
    (define (lookup key)
      (define absolute
        (If (And (Sz key) (Or (Eq "x" (Hd (_0 key))) (Equal ("ts" "sys") (_0 key))))
          key (Weld [("x" 17)] key)))
      ((helper "lookup") state absolute))
    (define records (ok (backend:compile prepared previous lookup root document)))
    (_0 (ok (backend:publish prepared records 0 0 state))))
  (define base ((helper "bootstrap") (_0 local)))
  (DeepSeq base (print "Native fixture bootstrap complete"))
  (define codecs (publish prepared (path ["lib" "grove" "types"])
    (read-text-file "grove/value_codecs.grove") base))
  (DeepSeq codecs (print "Production value codecs published"))
  (define tools (publish prepared (path ["gov" "nenex_tools"])
    (read-text-file "grove/nenex/tools.grove") codecs))
  (DeepSeq tools (print "Production Nenex tools published"))
  (define editor (publish (backend:prepare-with code "nenex_editor") (path ["gov" "nenex_editor"])
    (read-text-file "grove/nenex/editor.grove") tools))
  (DeepSeq editor (print "Production Nenex Grove published"))
  ;; Pages retain their document form across publication. Rebuild the editor
  ;; and its Nenex implementation while explicitly retaining their imports.
  ;; Identical source at a new moment deliberately has a different image type.
  (define rebuilt ["apps/nenex/main" "nenex_editor"])
  (define imports (filter (lambda (pair) (Nil (includes (Equal (_0 pair)) rebuilt)))
    (Weld (bootstrap:system-images system)
      (Weld (_2 (bootstrap:publisher-code system)) (_2 code)))))
  (define origin (publication:compilation-context (Unpin (_0 code))))
  (define revised (publication:compile
    (source:prepare-publication (context:publication-key origin)
      (context:compiler-key origin) resolve imports
      (lambda (key) ((helper "previous") editor
        (map (lambda (part) ((_0 part) (_1 part))) key))) rebuilt)
    (_1 code)))
  (define revised-code [(_0 revised) (_1 revised) (Weld (_2 revised) imports)])
  (define revised-state (_0 (ok (publication:publish-local (bootstrap:policy system)
    slot revised 0 0 editor))))
  (define updated (publish (backend:prepare-with revised-code "nenex_editor")
    (path ["gov" "nenex_editor"]) (read-text-file "grove/nenex/editor.grove") revised-state))
  (DeepSeq updated (print "New editor published over retained document forms"))
  (define results ((helper "report") updated))
  (DeepSeq (map (lambda (row)
    (print ("TEST" (If (_1 row) "pass" "fail") "nenex-document-tests"
      (_0 row) (_2 row) (_3 row)))) results) 0)
  (And (testing:passed native-results)
    (foldl (lambda (passed row) (And passed (_1 row))) 1 results)))
(define (check ignored)
  (define outcome (Try (lambda (ignored) (force (run 0))) 0))
  (If (Eq 1 (Hd outcome)) (Seq (print outcome) 0) (_0 outcome)))
(#export check)
