- nenex_editor_http
- apps/nenex/main [at=wiki]
- explorer_mount
- nenex_questions

+ nenex_ui
  + code_records
    ' Native app laws are refreshed without replacing its records or seeds.
    \ self=iota
    ^ row[[path myth]]
    = application wiki/app
      root=path [self 'app 'nenex 'kook]
    | application.kooks.map((\ declaration=kook/decl [root.snoc(declaration.id) (form/card declaration.form declaration.lore)]))
  + reader_path
    \ corpus=path selected=path
    ^ bool
    | and (pith_prefix corpus selected)
      (and (gt selected.len corpus.len)
        (row/all[iota] (\ part=iota (wiki/valid_page_name (quip_val part))) selected.drop(corpus.len)))
  + url
    \ target=path
    ^ nat
    | str/to_atom (str/cat_all ["/nenex?path=" (value_read/percent (path_show target))])
  + install
    \ state=namespace
    ^ either[pail namespace]
    | ./ok state
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        = parts (http_foot/split 63 request.target)
          url parts.at(0)
        ? (eq url "/nenex/source") (nenex_editor_http/source_request request now)
        ? (eq url "/nenex/ask") (nenex_questions/request request now)
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        ? ((eq url "/nenex/document") || (eq url "/nenex/children")) (nenex_editor_http/data_request request now)
        ? (eq url "/nenex/edit") (nenex_editor_http/request request now)
        ? !((eq url "/nenex") || (eq url "/nenex/")) (./reply (http_driver/response 404 "Not found"))
        = query=str (? (eq parts.len 2) parts.at(1) "")
        ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) (./reply (http_driver/response 400 "Invalid page address"))
        ? (gt fields.len 1) (./reply (http_driver/response 400 "Use one page address"))
        = [key value] fields.at(0)
        ? (and query.len !(eq key "path")) (./reply (http_driver/response 400 "Use one page address"))
        = text (http_foot/field "path" fields)
          chosen=maybe[path] (? text.len (browser_routes/value_path text) (./some [state.self 'app 'nenex 'w]))
        ?> (./some selected) chosen (./reply (http_driver/response 400 "Invalid page address"))
        | ./after (nenex_editor_http/page selected)
          \ status=nat body=str
          | http_foot/action/bytes status (http_foot/bar (str/to_atom body)) "text/html; charset=utf-8"
    | http_foot/add_routes [(http_foot/route "/nenex" plan)] http_foot/empty
