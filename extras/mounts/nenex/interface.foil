- apps/nenex/main [at=wiki]
- explorer_mount
- goo_workspace

+ nenex_ui
  + endpoint
    \ self=iota
    ^ goo_workspace/endpoint
    | goo_workspace/endpoint [self 'gov 'nenex_ui 'workspace]
        [self 'gov 'nenex_ui 'source_path] [self 'app 'nenex 'w]
        nenex_ui/validate [] nenex_ui/placeholder
  + validate
    \ selected=axal[myth]
    ^ maybe[str]
    ? selected.wyt .none
    | ./some "The wiki library is unavailable."
  + placeholder
    \ target=path content=row[weft/node]
    ^ nat
    | weft/page_with_assets "Nenex" goo_browser/presentation_assets content
  + url
    \ target=path
    ^ nat
    | str/to_atom (str/cat_all ["/nenex?path=" (value_read/percent (path_show target))])
  + field
    \ name=nat value=nat
    ^ weft/node
    | weft/el "input" [(weft/att "type" "hidden") (weft/att "name" name) (weft/att "value" value)] []
  + form
    \ corpus=path target=path field=nat label=nat placeholder=nat
    ^ weft/node
    | weft/el "form" [(weft/att "method" "post") (weft/att "action" (weft/cat2 "/post" (show/path corpus))) (weft/cls "library-form")]
      [(nenex_ui/field "back" (nenex_ui/url target))
       (weft/leaf "label" [(weft/att "for" field)] label)
       (weft/el "div" [(weft/cls "field-row")]
         [(weft/el "input" [(weft/id field) (weft/att "name" field) (weft/att "placeholder" placeholder) (weft/att "required" "required") (weft/att "autocomplete" "off")] [])
          (weft/leaf "button" [(weft/att "type" "submit")] (? (eq field "new") "Create" "Find"))])]
  + document
    \ self=iota selected=path doc=axal[myth] corpus=axal[myth] first=nat top=nat target=path content=row[weft/node]
    ^ nat
    = root=path [self 'app 'nenex]
      wpath root.snoc('w)
      card doc.fil.fall(myth/new)
      title (myth/txt_at system_vocabulary/lede card)
      title (? title title "Page not found")
      src (myth/txt_at ['src] card)
      assets goo_browser/presentation_assets
      assets assets.snoc((weft/el "script" [(weft/att "src" "/static/goo-workspace.js") (weft/att "defer" "defer")] []))
      assets assets.snoc((weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/nenex/style.css")] []))
      assets assets.snoc((weft/el "script" [(weft/att "src" "/nenex/interface.js") (weft/att "defer" "defer")] []))
      sidebar=row[weft/node]
        [(weft/leaf "a" [(weft/cls "wordmark") (weft/href "/nenex")] "nenex")
         (weft/leaf "p" [(weft/cls "library-caption")] "A place for connected thought.")
         (nenex_ui/form wpath selected "q" "Search your pages" "A word or a thought...")
         (weft/leaf "div" [(weft/cls "eyebrow")] "YOUR PAGES")
         (weft/el "nav" [(weft/att "aria-label" "Wiki pages")] content)
         (weft/el "details" [(weft/cls "new-page")]
           [(weft/leaf "summary" [] "+ New page")
            (nenex_ui/form wpath selected "new" "Page name" "e.g. reading-notes")
            (weft/leaf "p" [(weft/cls "hint")] "Start with a letter. Use letters, numbers, hyphens or underscores.")])
         (weft/leaf "p" [(weft/cls "library-foot")] "A personal wiki / built with Goo + Mash")]
      reader=row[weft/node]
        ? !(doc.wyt)
          [(weft/leaf "h1" [] "This page is not here") (weft/leaf "p" [] "Choose another page from the library, or create a new one.")]
        [(weft/el "header" [(weft/cls "reader-heading")]
           [(weft/leaf "div" [(weft/cls "eyebrow")] "YOUR PERSONAL WIKI")
            (weft/leaf "h1" [] title)
            (weft/leaf "p" [(weft/cls "page-address")] (show/path selected))])
         (weft/el "nav" [(weft/cls "reader-tools") (weft/att "aria-label" "Page tools")]
           [(weft/leaf "a" [(weft/href "#source")] "Edit source")
            (weft/leaf "a" [(weft/href "#connections")] "Connections")
            (weft/leaf "a" [(weft/href "#history")] "History")])
         (weft/el "article" [(weft/cls "document") (weft/att "aria-label" "Page content")]
           [(frag/mount "document" root.weld(['weft 'page]) selected 2)])
         (weft/el "section" [(weft/id "connections") (weft/cls "connections")]
           [(weft/leaf "div" [(weft/cls "eyebrow")] "CONNECTED TO THIS PAGE")
            (weft/el "div" [] (? ((wiki/in_rows card).len) (wiki/in_rows card) [(weft/leaf "p" [(weft/cls "hint")] "No incoming links yet. Link to this page from another thought.")]))])
         (weft/el "details" [(weft/id "source") (weft/cls "source-editor")]
           [(weft/leaf "summary" [] "Edit page source")
            (weft/leaf "p" [(weft/cls "hint")] "Semidoc source. Saving updates this page and its links in one revision.")
            (weft/el "form" [(weft/id "editor") (weft/att "method" "post") (weft/att "action" (weft/cat2 "/post" (show/path selected)))]
              [(nenex_ui/field "back" (nenex_ui/url selected))
               (weft/leaf "label" [(weft/att "for" "page-source") (weft/cls "eyebrow")] "SOURCE")
               (weft/el "textarea" [(weft/id "page-source") (weft/att "name" "src") (weft/att "rows" "18") (weft/att "required" "required") (weft/att "spellcheck" "false")] [(weft/tx src)])
               (weft/el "div" [(weft/cls "editor-footer")]
                 [(weft/leaf "span" [(weft/id "save-state") (weft/att "role" "status")] "No unsaved changes")
                  (weft/leaf "button" [(weft/att "type" "button") (weft/id "discard")] "Discard")
                  (weft/leaf "button" [(weft/att "type" "submit") (weft/cls "primary")] "Save page")])])])
         (weft/el "details" [(weft/id "history") (weft/cls "history")]
           [(weft/leaf "summary" [] "Revision history")
            (weft/leaf "p" [(weft/cls "hint")] "Scrub earlier versions of this document. Return to the latest revision to read live content.")
            (weft/el "div" [] (? top [(frag/scrubber first top)] [(weft/leaf "p" [] "No revisions available.")]))])]
      results (wiki/query_section corpus)
      error (myth/txt_at ['err] corpus.fil.fall(myth/new))
      reader (? error (reader.cons((weft/leaf "p" [(weft/cls "form-error") (weft/att "role" "alert")] error))) reader)
      search_nodes=row[weft/node] (? results.len [(weft/el "section" [(weft/cls "search-results") (weft/att "aria-label" "Search results")] results)] [])
    | weft/page_with_assets "Nenex - a place for connected thought" assets
      [(weft/leaf "a" [(weft/cls "skip-link") (weft/href "#reader")] "Skip to page")
       (weft/el "div" [(weft/cls "wiki-shell") (weft/att "data-corpus" (show/path wpath)) (weft/att "data-page" (show/path selected))]
         [(weft/el "aside" [(weft/cls "library")] sidebar)
          (weft/el "main" [(weft/id "reader") (weft/cls "reader")]
            search_nodes.weld(reader))])
       frag/script]
  + talk
    \ fallback={\ bowl myth myth}yell =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ?> (./some selected) out.path_at(['nenex_reader]) (fallback bowl cur add)
    = self selected.at(0)
      doc bowl.crew.gut(['nenex_doc] (axal/new[myth] .none))
      corpus bowl.crew.gut(['nenex_corpus] (axal/new[myth] .none))
      endpoint (nenex_ui/endpoint self).set_document((nenex_ui/document self selected doc corpus
        (frag/ver_nat bowl system_vocabulary/version/first) (frag/ver_nat bowl system_vocabulary/version/top)))
    | goo_workspace/talk endpoint fallback bowl cur add
  + install
    \ state=namespace
    ^ either[pail namespace]
    ?> (./ok next) (goo_workspace/install (nenex_ui/endpoint state.self) goo_browser/talk state)
      | ./err (pails/t "Nenex workspace installation failed")
    = home=path [state.self 'kook 'hex]
    ?> (./some record) (goo_runtime/record .x home next) (./err (pails/t "Browser responder missing"))
    ?> (./some held) record.get(bond/form) (./err (pails/t "Browser form missing"))
    ?> previous=form held (./err (pails/t "Browser form invalid"))
    = [next index reply]
        | helm/supervisor/handle (helm/card/step home
            (writ/make (form/card (previous.set_talk((nenex_ui/talk previous.talk))) (lore/line "Nenex reading workspace")))) next (sovereign_hive next)
    ?> (./ack failure) reply (./err (pails/t "Nenex responder installation failed"))
    ? failure
     > (./some why) (./err why)
    | ./ok next
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = parts (http_foot/split 63 request.target)
          url parts.at(0)
        ? ((eq url "/nenex") || (eq url "/nenex/"))
          = query=str (? (eq parts.len 2) parts.at(1) "")
          ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query)
            | ./reply (http_driver/response 400 "Invalid page address")
          = [key value] fields.at(0)
          ? (and query.len !(and (eq fields.len 1) (eq key "path")))
            | ./reply (http_driver/response 400 "Use one page address")
          = wpath=path [state.self 'app 'nenex 'w]
            text (http_foot/field "path" fields)
            chosen=maybe[path] (? text.len (browser_routes/value_path text) (./some wpath.snoc('home)))
          ?> (./some selected) chosen
            | ./reply (http_driver/response 400 "Invalid page address")
          ? !(and (pith_prefix wpath selected) (eq selected.len wpath.len.inc))
            | ./reply (http_driver/response 400 "Choose a page in this wiki")
          ?> (./wait card) (goo_workspace/request (nenex_ui/endpoint state.self) request.set_target("/nenex") now)
            | ./reply (http_driver/response 500 "Workspace request failed")
          = watch (crew/sing ['view] (dep .y wpath))
            watch watch.put(['catalog] (dep .x [state.self 'weft 'view_catalog_cache]))
            watch watch.put(['nenex_doc] (dep .z selected)).put(['nenex_corpus] (dep .z wpath))
            version_root=path ['h 'v (| dig_show selected.len)]
            watch watch.put(['ver] (dep .y version_root.weld(selected)))
          | ./wait card.put(['nenex_reader] (pails/p selected)).put(crew_slot (cpail watch))
        = name=str (? (eq url "/nenex/style.css") "style.css" (? (eq url "/nenex/interface.js") "interface.js" ""))
          found files.keep((\ [key bytes] (eq key name)))
        ? !(found.len) (./reply (http_driver/response 404 "Not found"))
        = [name bytes] found.at(0)
        | ./bytes 200 bytes (? (eq name "style.css") "text/css" "application/javascript")
    | http_foot/add_routes [(http_foot/route "/nenex" plan)] http_foot/empty
