- semidoc [at=sd]
- nenex_interface
- app_test_world
- cooperate_mount
- apps/nenex/main [at=wiki]

+ nenex_question_tests
  + author
    ^ path
    [($x 17) 'app 'nenex 'w 'question_spec]
  + input_path
    ^ path
    [($x 17) 'user 'question_evidence]
  + get
    \ target=path state=namespace
    ^ myth
    | (cooperate/record target state).fall(myth/new)
  + poke
    \ target=path input=myth state=namespace
    ^ namespace
    = write (? (cooperate/record target state).is_some (writ/poke input) (writ/make input))
    | either/ok_val (grove_install/change target write state)
  + reason
    \ result=either[iota row[[p=path q=writ]]]
    ^ str
    ? result
     > (./err why) (str/from_atom (quip_val why))
    "ok"
  + provider
    \ target=path request=native_work/request
    ^ myth
    | native_work/open request.owner "question-test" (myth/sing ['work 'request] request)
  + seeded
    ^ namespace
    = world (app_world/mount wiki/app "apps/nenex/main" ['app 'nenex] app_world/seed)
      world (app_world/post ['app 'nenex 'w] [['new "question_spec"]] world)
      world (app_world/post nenex_question_tests/author [['src (str/from_atom (joined 10 [";." "  ;= Evidence" "" "    A page with a question."]))]] world)
      world (app_world/make nenex_question_tests/input_path (myth/sing ['amount] (pails/n 10)) world)
      state (either/ok_val (cooperate_mount/install world.state))
      provider=path [state.self 'user 'answer_provider]
      [next index reply] (helm/supervisor/step provider (writ/make (myth/sing ['work 'provider] (native_work/provider nenex_question_tests/provider))) 0 0 state (sovereign_hive state))
    next
  + fields
    \ state=namespace scope=str evidence=str
    ^ row[[str str]]
    | [["action" "ask"] ["page" (path_show nenex_question_tests/author)] ["id" "q1"] ["question" "What does this page explain?"]
       ["scope" scope] ["evidence" evidence] ["provider" (path_show [state.self 'user 'answer_provider])]
       ["source" (nenex_question_tests/get nenex_question_tests/author state).txt_at(['src])]]
  + act
    \ fields=row[[str str]] state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit (nenex_questions/plan fields) state (sovereign_hive state))
    next
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state nenex_question_tests/seeded
      root=path nenex_question_tests/author
      fields=row[[str str]] (nenex_question_tests/fields state "page" (path_show nenex_question_tests/input_path))
      started (nenex_question_tests/act fields state)
      controller=path [state.self 'app 'nenex 'w 'question_spec 'work 'questions 'q1]
      hole=path [state.self 'app 'nenex 'w 'question_spec 'holes 'questions 'q1]
      context=path [state.self 'app 'nenex 'w 'question_spec 'cells 'questions 'q1]
      live (sovereign_care .z (row/cons[iota] 'x context) started)
      note (nenex_question_tests/poke (row/snoc[iota] 'notes nenex_question_tests/author) (myth/sing ['note] (pails/t "Independent note")) started)
      same (sovereign_care .z (row/cons[iota] 'x context) note)
      rendered (weft/render (weft/el "div" [] (nenex_questions/render nenex_question_tests/author (sovereign_peek nenex_question_tests/author started))))
      stale (nenex_questions/plan (row/snoc[[str str]] ["source" "obsolete"] fields.take(7)) state)
      outside (nenex_questions/plan (nenex_question_tests/fields state "/0x11/user/other" "") state)
    [(testing/text "reader question invokes native answering" "running" (nenex_question_tests/get controller started).txt_at(['work 'status]))
     (testing/text "question has a shared subject hole" "waiting" (nenex_question_tests/get hole started).txt_at(['work 'status]))
     (testing/nat "asking does not rewrite authored source" 1 (eq (nenex_question_tests/get nenex_question_tests/author state).txt_at(['src]) (nenex_question_tests/get nenex_question_tests/author started).txt_at(['src])))
     (testing/nat "work and notes do not feed back into the context lens" 1 (equal[axal[myth]] live same))
     (testing/nat "explicit evidence uses the existing secondary cell binding" 1 live.get(['evidence_1]).is_some)
     (testing/nat "question renders a reactive native answer component" 1 (cord/has "answer_view" rendered))
     (testing/nat "page and quoted block selection are offered" 1 (cord/has "Ask about" rendered))
     (testing/text "stale page forms are rejected" "nenex_stale_question_context" (nenex_question_tests/reason stale))
     (testing/text "block selection stays inside authored document content" "nenex_invalid_block" (nenex_question_tests/reason outside))]
  + blocks
    \ ignored=unit
    ^ row[testing/check]
    = state nenex_question_tests/seeded
      root=path nenex_question_tests/author
      source (nenex_question_tests/get nenex_question_tests/author state).txt_at(['src])
      mounts (wiki/old_mounts (str/to_atom source)).keep((\ m (gt (nenex_questions/block_label m.t).len 0)))
      selected mounts.at(0)
      selected_path=path (row/weld[iota] selected.p root)
      fields=row[[str str]] (nenex_question_tests/fields state (path_show selected_path) "")
      started (nenex_question_tests/act fields state)
      cell=path [state.self 'app 'nenex 'w 'question_spec 'cells 'questions 'q1]
      controller=path [state.self 'app 'nenex 'w 'question_spec 'work 'questions 'q1]
      quoted (nenex_question_tests/get cell started).txt_at(['question 'quote])
      replacement (str/from_atom (joined 10 [";." "  ;= Replacement" "    A different block now occupies this location."]))
      edited (nenex_question_tests/poke nenex_question_tests/author (myth/sing ['src] (pails/t replacement)) started)
      retained (nenex_question_tests/get cell edited).txt_at(['question 'quote])
      current_source (nenex_question_tests/get nenex_question_tests/author edited).txt_at(['src])
      rebind=row[[str str]] [["action" "rebind"] ["page" (path_show nenex_question_tests/author)] ["id" "q1"] ["source" current_source] ["scope" "page"]]
      rebound (nenex_question_tests/act rebind edited)
    [(testing/text "selected quote is bound by native admission" (nenex_questions/block_label selected.t) quoted)
     (testing/text "numbered block replacement cannot retarget the quotation" quoted retained)
     (testing/nat "page work survives block deletion" 1 (nenex_question_tests/get controller edited).has(['answer 'config]))
     (testing/text "rebind uses the current page context guard" "ok" (nenex_question_tests/reason (nenex_questions/plan rebind edited)))
     (testing/text "explicit rebind changes the live lens without changing the question" "" (nenex_question_tests/get cell rebound).txt_at(['question 'quote]))]
  + rich_blocks
    \ ignored=unit
    ^ row[testing/check]
    = value (goo/text/en "A question about this block")
      card (myth/sing ['kind] (pails/t "prose")).put(['text] (goo/text/pail value))
      source (str/from_atom (sd/unparse [(sd/node_back (axal/new[myth] (./some card))).fall((sd/snode/prose 0 []))]))
      context (nenex_questions/context nenex_question_tests/author (path_show (nenex_question_tests/author).snoc(($u 0))) source myth/new nenex_question_tests/seeded)
    [(testing/text "rich block label uses canonical text" value.plain (nenex_questions/block_label card))
     (testing/nat "rich block stays in question options" 1 (nenex_questions/options nenex_question_tests/author source).len)
     (testing/nat "rich block can be quoted" 1 (either/is_ok context))]

+ tests
  ^ row[testing/case]
  [(testing/case "Canonical rich block questions" nenex_question_tests/rich_blocks)
   (testing/case "Nenex native questions" nenex_question_tests/checks)
   (testing/case "Quoted block identity" nenex_question_tests/blocks)]
