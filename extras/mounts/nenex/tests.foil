-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  weft [order=80]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  helm [order=130]
-  testing [order=170]
-  apps/nenex/main [order=210]
-  app_test_world [order=220]
+  nenex_tests
  + creation
    \ _=unit
    ^ row[testing/check]
    = base (app_world/mount app "apps/nenex/main" ['nenex] app_world/seed)
      before (app_world/get ['nenex 'w 'home] base).txt_at(['src])
      duplicate (app_world/post ['nenex 'w] [['new "home"]] base)
      crlf (weft/join (cord/cat 13 10) (split_byte 10 (str/to_atom before)))
      saved (app_world/post ['nenex 'w 'home] [['src (str/from_atom crlf)]] base)
    [(testing/text "duplicate creation preserves existing source" before (app_world/get ['nenex 'w 'home] duplicate).txt_at(['src]))
     (testing/text "browser CRLF source round trip" (str/from_atom (weft/join 10 (split_byte 10 (str/to_atom before)))) (app_world/get ['nenex 'w 'home] saved).txt_at(['src]))
     (testing/nat "word page name" 1 (valid_page_name "reading-notes"))
     (testing/nat "reject path separators" 0 (valid_page_name "notes/other"))
     (testing/nat "reject numeric path ambiguity" 0 (valid_page_name "123"))
     (testing/nat "reject empty name" 0 (valid_page_name ""))]
  +  source
    \ lines=row[nat]
    ^ text
    | str/from_atom | weft/join 10 lines
  +  edit
    \ source=text world=app_world
    ^ app_world
    | app_world/post ['nenex 'w 'scratch] [['src source]] world
  +  relations
    \ _=unit
    ^ row[testing/check]
    = home=path
        [($x 17) 'nenex 'w 'home]
    = ideas=path
        [($x 17) 'nenex 'w 'ideas]
    = scratch=path
        [($x 17) 'nenex 'w 'scratch]
    = base
        | app_world/mount app "apps/nenex/main" ['nenex]
          app_world/seed
    = made
        | app_world/post ['nenex 'w] [['new "scratch"]] base
    = linked
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" "" "    cites the home page:" ""
            "    ;/0x11/nenex/w/home"]) made
    = related
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" ""
            "    ;@ /rel/contradicts ;/0x11/nenex/w/ideas" ""
            "    on reflection, ideas are overrated"]) linked
    = alone
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" "" "    stands alone"]) related
    = search
        | app_world/post ['nenex 'w] [['q "accumulate"]] alone
    = ranked
        | app_world/post ['nenex 'w] [['q "nenex"]] search
    = result
        | app_world/get ['nenex 'w] ranked
    = mentioned
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" "" "    the home page deserves a link"])
          ranked
    = checks=row[testing/check]
        [(app_world/okay mentioned)
         (testing/nat "single search result" 1
           (equal[pail] (pails/ps [ideas])
             (app_world/get ['nenex 'w] search).pail_at(['results])))
         (testing/nat "ranked results" 1
           (equal[pail] (pails/ps [home ideas scratch])
             result.pail_at(['results])))]
    | checks.weld
    | (app_world/contains ["/0x11/nenex/w/home" "/0x11/nenex/w/ideas"
        "new page" "search"]
        (app_world/page ['nenex] .false base)).weld
    | (app_world/lacks ["unlinked mentions"]
        (app_world/page ['nenex] .false base)).weld
    | (app_world/contains ["A programmable interior for thought"
        "textarea" "/frag/1/4/0x11/nenex/weft/page" "/rel/supports"
        "/0x11/nenex/w/ideas"] (app_world/page home .false base)).weld
    | (app_world/contains ["/chore/eval/sept" "run against sept"]
        (app_world/page ['o ($u 1) ($u 4) ($x 17) 'nenex 'weft 'page
          ($u 4) ($x 17) 'nenex 'w 'home] .true base)).weld
    | (app_world/contains ["linked from:" "/0x11/nenex/w/home"]
        (app_world/page ideas .false base)).weld
    | (app_world/contains ["A fresh page."]
        (app_world/page scratch .false made)).weld
    | (app_world/contains ["linked from:" "/0x11/nenex/w/scratch"]
        (app_world/page home .false linked)).weld
    | (app_world/contains ["/rel/contradicts" "/0x11/nenex/w/scratch"]
        (app_world/page ideas .false related)).weld
    | (app_world/lacks ["/0x11/nenex/w/scratch"]
        (app_world/page home .false alone)).weld
    | (app_world/lacks ["/rel/contradicts"]
        (app_world/page ideas .false alone)).weld
    | (app_world/contains ["/rel/supports"]
        (app_world/page home .false alone)).weld
    | (app_world/contains ["3 in body" "1 backlinks"]
        result.txt_at(['why])).weld
    | (app_world/contains ["last search: nenex" "in body,"]
        (app_world/page ['nenex] .false ranked)).weld
    | app_world/contains ["unlinked mentions" "without linking it"]
      (app_world/page ['nenex] .false mentioned)
  +  synchronization
    \ _=unit
    ^ row[testing/check]
    = target=path
        ['nenex 'w 'scratch]
    = base
        | app_world/mount app "apps/nenex/main" ['nenex]
          app_world/seed
    = base
        | app_world/post ['nenex 'w] [['new "scratch"]] base
    = initial
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" "" "    the home page deserves a link"])
          base
    = poked
        | app_world/poke target.weld([($u 0) ($u 0)])
          (myth/sing ['text] (pails/t "revised by direct poke")) initial
    = canonical
        | nenex_tests/source [";. /0x11/nenex/w/scratch" ""
          "  ;= Scratch" "" "    revised by direct poke"]
    = odd
        | nenex_tests/source [";. /0x11/nenex/w/scratch" "" ""
          "    ;= Odd Layout" "" "        authored layout survives" ""]
    = edited
        | nenex_tests/edit odd poked
    = with_attr
        | nenex_tests/edit
          (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
            "  ;= Scratch" "" "    ;@ /doc/status draft" ""
            "    prose under status" ""]) edited
    = plain
        | nenex_tests/source [";. /0x11/nenex/w/scratch" ""
          "  ;= Scratch" "" "    prose under status" ""]
    = removed
        | nenex_tests/edit plain with_attr
    = checks=row[testing/check]
        [(app_world/okay removed)
         (testing/text "record edits regenerate source" canonical
           (app_world/get target poked).txt_at(['src]))
         (testing/text "authored whitespace preserved" odd
           (app_world/get target edited).txt_at(['src]))
         (testing/text "library title follows source edits" "Odd Layout"
           (app_world/get target edited).txt_at(['sys 'lede]))
         (testing/text "library title survives direct record edits" "Scratch"
           (app_world/get target poked).txt_at(['sys 'lede]))
         (testing/text "withdrawn attribute stays removed" plain
           (app_world/get target removed).txt_at(['src]))]
    | checks.weld
    | (app_world/contains ["revised by direct poke"]
        (app_world/page target .false poked)).weld
    | (app_world/contains ["/doc/status"]
        (app_world/page target .false with_attr)).weld
    | app_world/lacks ["/doc/status" "/src"]
      (app_world/page target .false removed)
  +  owned_subtrees
    \ _=unit
    ^ row[testing/check]
    = target=path ['nenex 'w 'scratch]
      input=path target.weld(['inputs 'budget])
      cell=path target.weld(['cells 'remaining])
      work=path target.weld(['work])
      proposal=path work.weld(['proposals ($u 0)])
      source (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
        "  ;= Scratch" "" "    First paragraph." ""
        "    Second paragraph."])
      short (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
        "  ;= Revised" "" "    Remaining paragraph."])
      base (app_world/mount app "apps/nenex/main" ['nenex] app_world/seed)
      base (app_world/post ['nenex 'w] [['new "scratch"]] base)
      base (nenex_tests/edit source base)
      with_input (app_world/make input
        (myth/sing ['amount] (pails/n 450)) base)
      with_cell (app_world/make cell
        (myth/sing ['input] (pails/p (app_world/path input))) with_input)
      with_work (app_world/make work
        (myth/sing ['kind] (pails/t "doc")) with_cell)
      with_work (app_world/make proposal
        (myth/sing ['kind] (pails/t "prose")).put(['text] (pails/t "Private proposal payload")) with_work)
      updated (app_world/poke input
        (myth/sing ['amount] (pails/n 350)) with_work)
      shortened (nenex_tests/edit short updated)
      direct (app_world/poke target.weld([($u 0) ($u 0)])
        (myth/sing ['text] (pails/t "Edited canonical prose.")) shortened)
      canonical (nenex_tests/source [";. /0x11/nenex/w/scratch" ""
        "  ;= Revised" "" "    Edited canonical prose."])
    [(app_world/okay direct)
     (testing/text "named work records do not enter source" source
       (app_world/get target with_work).txt_at(['src]))
     (testing/text "input edits do not rewrite source" source
       (app_world/get target updated).txt_at(['src]))
     (testing/nat "named work and input changes reuse the normalized source image" 1
       (equal[pail] (app_world/get target base).pail_at(image_slot)
         (app_world/get target updated).pail_at(image_slot)))
     (testing/nat "source edits replace the normalized source image" 0
       (equal[pail] (app_world/get target base).pail_at(image_slot)
         (app_world/get target shortened).pail_at(image_slot)))
     (testing/text "source shortening preserves author layout" short
       (app_world/get target shortened).txt_at(['src]))
     (testing/nat "prose deletion removes its stale numbered node" 0
       (app_world/exists target.weld([($u 0) ($u 1)]) shortened))
     (testing/nat "prose edits preserve document input" 350
       (app_world/number input ['amount] 0 direct))
     (testing/nat "prose edits preserve cell binding" 1
       (equal[maybe[pail]] (./some (pails/p (app_world/path input)))
         (app_world/pail cell ['input] direct)))
     (testing/text "prose edits preserve numeric descendants inside work" "Private proposal payload"
       (app_world/get proposal direct).txt_at(['text]))
     (testing/text "record sync excludes named work after prose edits" canonical
       (app_world/get target direct).txt_at(['src]))]
  + pending_subjects
    \ _=unit
    ^ row[testing/check]
    = tree (axal/new[myth] .none).put(['pending 'holes 'question] (myth/sing ['state] (pails/t "waiting")))
      tree tree.put(['notes] (myth/sing ['text] (pails/t "A named annotation")))
      tree tree.put(['ready] (myth/sing ['src] (pails/t ";= Ready")))
      pages (scan tree)
    [(testing/nat "corpus indexes sourced documents rather than bare subjects" 1 pages.len)]
+  tests
  ^ row[testing/case]
  [(testing/case "pending subjects in the corpus" nenex_tests/pending_subjects)
   (testing/case "safe page creation" nenex_tests/creation)
   (testing/case "links, relations, search and mentions"
     nenex_tests/relations)
   (testing/case "record/source synchronization"
     nenex_tests/synchronization)
   (testing/case "named document subtrees survive source synchronization"
     nenex_tests/owned_subtrees)]
