- goo_text
- semidoc [at=sd]
- apps/nenex/main [at=wiki]
- goo_app/editing
- goo_app/text_edit
- namespace_command

+ nenex_edit
  + record
    \ target=path state=namespace
    ^ myth
    | (sovereign_care .x target state).fil.fall(myth/new)
  + numbered
    \ key=iota
    ^ bool
    ?> ($u n) key .false
    | .true
  + owner
    ' Nearest actual Nenex page; only numbered prose descendants belong to it.
    \ target=path state=namespace
    ^ maybe[path]
    = corpus=path [state.self 'app 'nenex 'w]
      form=path [state.self 'app 'nenex 'kook 'doc]
    ? !(pith_prefix corpus target) .none
    % length=nat target.len
    ^ maybe[path]
    ? (le length corpus.len) .none
    = root target.take(length)
      record (nenex_edit/record root state)
    ? (equal[pail] record.pail_at(limb_slot) (kook [form]))
      ? !(row/all[iota] nenex_edit/numbered target.drop(length)) .none
      | ./some root
    | _ length.dec
  + guard
    ' Native epoch identifies the captured record; compare authored source,
    ' not the page subtree clock (which includes cells, holes and work).
    \ root=path token=str state=namespace
    ^ either[iota unit]
    ?> (./some epoch) (nat/parse token) (./err 'nenex_invalid_epoch)
    ?> (./some history) state.history(root) (./err 'nenex_not_document_content)
    ? ((eq epoch 0) || (gt epoch history.top)) (./err 'nenex_invalid_epoch)
    ?> (./known previous) history.x_at(epoch root) (./err 'nenex_document_changed_retain_draft)
    = current (nenex_edit/record root state)
    ? !(and (equal previous.pail_at(limb_slot) current.pail_at(limb_slot))
            (eq previous.txt_at(['src]) current.txt_at(['src]))) (./err 'nenex_document_changed_retain_draft)
    | ./ok []
  + source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some root) (nenex_edit/owner target state) (./err 'nenex_not_document_content)
    ? !(equal root target) (./err 'nenex_not_document_content)
    ? !(and (eq input.tap.len 2) (and input.has(['src]) input.has(['epoch]))) (./err 'nenex_invalid_input)
    < checked (nenex_edit/guard root input.txt_at(['epoch]) state)
    = source (weft/join 0 (split_byte 13 (str/to_atom input.txt_at(['src]))))
    ? ((eq source 0) || (gt (cord/len source) 196608)) (./err 'nenex_source_limit)
    ? !(sd/rich_valid (sd/parse source)) (./err 'nenex_invalid_rich_source)
    | ./ok [[root (writ/poke (myth/sing ['src] (pails/t (str/from_atom source))))]]
  + save
    \ field=path target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some root) (nenex_edit/owner target state) (./err 'nenex_not_document_content)
    ? !(and (eq input.tap.len 1) (input.has(field))) (./err 'nenex_invalid_input)
    ?> (./some decoded) (goo_edit/decode input.pail_at(field)) (./err 'nenex_invalid_rich_text)
    = tree (sovereign_care .z root state)
      old (nenex_edit/record target state)
    ? !(equal field (sd/text_field (myth/txt_at ['kind] old))) (./err 'nenex_block_kind_changed)
    ? (gt (wiki/old_mounts (str/to_atom (nenex_edit/record root state).txt_at(['src]))).len 256) (./err 'nenex_document_limit)
    = next old.put(field decoded)
      nodes (wiki/page_nodes (tree.put(target.drop(root.len) next)))
      source (sd/unparse nodes)
    ? (gt (cord/len source) 196608) (./err 'nenex_source_limit)
    ? !(sd/rich_valid (sd/parse source)) (./err 'nenex_invalid_rich_source)
    ' Refuse any source representation that drops structure or formatting.
    ? !(equal nodes (wiki/src_image source)) (./err 'nenex_non_roundtrippable_edit)
    | ./ok [[root (writ/poke (myth/sing ['src] (pails/t (str/from_atom source))))]]

  + children
    \ node=sd/snode kids=row[sd/snode]
    ^ sd/snode
    ? node
     > (./doc id attrs _) (sd/snode/doc id attrs kids)
     > (./sect title attrs _) (sd/snode/sect title attrs kids)
     > (./item lead attrs _) (sd/snode/item lead attrs kids)
     > (./quote lead attrs _) (sd/snode/quote lead attrs kids)
    node
  + content
    \ old=sd/snode kind=str value=goo/text
    ^ sd/snode
    = card (sd/node_myth (sd/source_node old))
      field (sd/text_field card.txt_at(['kind]))
      card card.del(field).del(['kind]).del(['doc 'rich])
      card card.put(['kind] (pails/t kind)).put((sd/text_field kind) (goo/text/pail value))
      tree (sd/remount (wiki/container_kids old).fall([])).set_fil((./some card))
    | (sd/node_back tree).fall(old)
  + rewrite
    ' A transient transformation of Semidoc's own nodes; no stored editor model.
    \ nodes=row[sd/snode] route=path command=str value=goo/text start=nat end=nat
    ^ either[iota row[sd/snode]]
    ? !(route.len) (./err 'nenex_invalid_block)
    ?> ($u index) route.at(0) (./err 'nenex_invalid_block)
    ? (ge index nodes.len) (./err 'nenex_missing_block)
    = old nodes.at(index)
      kids (wiki/container_kids old).fall([])
      kind (sd/node_myth (sd/source_node old)).txt_at(['kind])
      edited (nenex_edit/content old kind value)
    ? (gt route.len 1)
      < next (nenex_edit/rewrite kids route.drop(1) command value start end)
      | ./ok (nodes.take(index).snoc((nenex_edit/children old next)).weld(nodes.drop(index.inc)))
    = kinds=row[[p=str q=str]] [["paragraph" "prose"] ["heading" "sect"] ["bullet" "item"] ["quote" "quote"] ["code" "lit"]]
      selected kinds.keep((\ [name kind] (eq name command)))
      splice
        \ replacement=row[sd/snode]
        ^ row[sd/snode]
        | nodes.take(index).weld(replacement).weld(nodes.drop(index.inc))
    ? (eq command "save") (./ok (splice [edited]))
    ? selected.len
      = [name next_kind] selected.at(0)
        leaf (row/has[str] next_kind ["prose" "lit"])
      ? (and leaf (gt kids.len 0)) (./err 'nenex_keep_children_choose_container)
      = point (goo_text_edit/line_start value.plain start)
        prefix value.plain.slice(point (sub start point))
        slash (goo_text_edit/slash_query prefix)
        clean (? slash (goo_text_edit/replace value point start []) value)
      | ./ok (splice [(nenex_edit/content old next_kind clean)])
    ? (eq command "add")
      | ./ok (splice [edited (nenex_edit/content (sd/snode/prose 0 []) "prose" (goo/text/en ""))])
    ? (eq command "split")
      = left (goo/text/slice 0 start value)
        right (goo/text/slice end (sub value.plain.len end) value)
        next_kind=str (? (eq kind "item") "item" "prose")
        after (nenex_edit/content (sd/snode/prose 0 []) next_kind right)
      ? (eq kind "sect")
        | ./ok (splice [(nenex_edit/children (nenex_edit/content old kind left) (row/weld[sd/snode] kids [after]))])
      | ./ok (splice [(nenex_edit/content old kind left) after])
    ? (eq command "merge")
      ? ((eq index 0) || (gt kids.len 0)) (./err 'nenex_cannot_merge_block)
      = previous nodes.at(index.dec)
        previous_card (sd/node_myth (sd/source_node previous))
        old_card (sd/node_myth (sd/source_node old))
        field (sd/text_field kind)
      ? !(equal (previous_card.del(field)) (old_card.del(field))) (./err 'nenex_merge_metadata_differs)
      ? (gt (wiki/container_kids previous).fall([]).len 0) (./err 'nenex_cannot_merge_parent)
      = before=goo/text
          ?> value=goo/text/pail previous_card.pail_at(field) (goo/text/en (str/from_atom (sd/text_at field previous_card)))
          value.value
        merged (nenex_edit/content previous kind before.weld(value))
      | ./ok (nodes.take(index.dec).snoc(merged).weld(nodes.drop(index.inc)))
    ? (eq command "delete")
      ? kids.len (./err 'nenex_delete_children_first)
      | ./ok (splice [])
    ? ((eq command "up") || (eq command "down"))
      ? (and (eq command "up") (eq index 0)) (./err 'nenex_first_block)
      ? (and (eq command "down") (eq index.inc nodes.len)) (./err 'nenex_last_block)
      = dest (? (eq command "up") index.dec index.inc)
        rest (splice [])
      | ./ok (rest.take(dest).snoc(edited).weld(rest.drop(dest)))
    | ./err 'nenex_unknown_command
  + operate
    \ field=path target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some root) (nenex_edit/owner target state) (./err 'nenex_not_document_content)
    ? !(eq input.tap.len 5) (./err 'nenex_invalid_input)
    ?> (./some decoded) (goo_edit/decode input.pail_at(field)) (./err 'nenex_invalid_rich_text)
    ?> (./some start) (nat/parse input.txt_at(['start])) (./err 'nenex_invalid_selection)
    ?> (./some end) (nat/parse input.txt_at(['end])) (./err 'nenex_invalid_selection)
    ? ((gt start end) || (gt end decoded.value.plain.len)) (./err 'nenex_invalid_selection)
    < checked (nenex_edit/guard root input.txt_at(['epoch]) state)
    = command input.txt_at(['command])
      card (nenex_edit/record target state)
      source (nenex_edit/record root state).txt_at(['src])
      tree (sovereign_care .z root state)
    ? !(equal field (sd/text_field card.txt_at(['kind]))) (./err 'nenex_block_kind_changed)
    ? (gt (wiki/old_mounts (str/to_atom source)).len 256) (./err 'nenex_document_limit)
    ? (eq command "save") (nenex_edit/save field target (myth/sing field decoded) state)
    ? (equal target root) (./err 'nenex_keep_document_root)
    ' Renumbering must never relocate or cull work attached below prose nodes.
    ? (tree.tap.any((\ [relative card] (and (gt relative.len 1) (and (nenex_edit/numbered relative.at(0)) !(relative.all(nenex_edit/numbered)))))))
      | ./err 'nenex_named_descendants_prevent_reordering
    < nodes (nenex_edit/rewrite (wiki/page_nodes tree) (row/weld[iota] target.drop(root.len) [($u 0)]) command decoded.value start end)
    = next (sd/unparse nodes)
    ? (gt (cord/len next) 196608) (./err 'nenex_source_limit)
    ? (gt (wiki/old_mounts next).len 256) (./err 'nenex_document_limit)
    ? !(and (sd/rich_valid (sd/parse next)) (equal nodes (wiki/src_image next))) (./err 'nenex_non_roundtrippable_edit)
    | ./ok [[root (writ/poke (myth/sing ['src] (pails/t (str/from_atom next))))]]
