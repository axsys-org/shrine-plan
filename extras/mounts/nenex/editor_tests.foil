- grove_install
- apps/nenex/main [at=wiki]
- nenex_editor
- nenex_editor_http
- nenex_interface
- semidoc [at=sd]
- app_test_world
- testing

+ nenex_editor_tests
  + result
    \ result=either[iota namespace] fallback=namespace
    ^ namespace
    ?> (./ok value) result (Seq[namespace] (error (pails/t "Nenex editor fixture admission failed")) fallback)
    | value
  + root
    ^ path
    [($x 17) 'app 'nenex 'w 'scratch]
  + runs
    ^ goo/text
    [(goo/runt (myth/sing ['sys 'modifiers] (pails/modifiers (list/one[modifiers] (modifiers/bold)))) (goo/lang/en "Changed "))
     (goo/runt (myth/sing ['sys 'link] (pails/p [($x 17) 'user 'cells])) (goo/lang/en "evidence"))]
  + source
    ^ str
    | str/from_atom (weft/join 10 [";. /0x11/app/nenex/w/scratch" "" "  ;= Research" ""
      "    ;@ /rel/supports ;/0x11/user/evidence" "    Original paragraph." ""
      "    ;> Quote" "      Nested quotation." ""
      "    ;@ /doc/embed ;/0x11/app/nenex/weft/page" "    ;/0x11/app/nenex/w/home" ""
      "    ;$ foil" "      + answer" "        42"])
  + checks
    \ _=unit
    ^ row[testing/check]
    = root nenex_editor_tests/root
      target root.weld([($u 0) ($u 0)])
      world (app_world/mount wiki/app "apps/nenex/main" ['app 'nenex] app_world/seed)
      world (app_world/post ['app 'nenex 'w] [['new "scratch"]] world)
      world (app_world/post root [['src nenex_editor_tests/source]] world)
      named=row[path] [['inputs 'budget] ['cells 'result] ['work 'trace ($u 0)] ['chapter]]
      world (row/fold[path app_world] world (\ w p (app_world/make root.weld(p) (myth/sing ['sentinel] (pails/t "keep")) w)) named)
      state world.state
      input (myth/sing ['text] (pails/t (show (goo_text/encode nenex_editor_tests/runs))))
      plan (nenex_edit/save ['text] target input state)
      writes
        ?> (./ok writes) plan (Seq[row[[p=path q=writ]]] (error (pails/t "Nenex editor fixture save failed")) [])
        writes
      changed (nenex_editor_tests/result (grove_install/changes writes state) state)
      card (nenex_edit/record target changed)
      source (nenex_edit/record root changed).txt_at(['src])
      reparsed (nenex_editor_tests/result (grove_install/change root (writ/poke (myth/sing ['src] (pails/t source))) changed) changed)
      wrong (nenex_edit/save ['title] target input state)
      foreign (nenex_edit/save ['text] root.weld(['work 'trace ($u 0)]) input state)
      corrupt (str/cat_all [";@ /doc/rich broken" (str/from_atom 10) "paragraph"])
      rejection (grove_install/change root (writ/poke (myth/sing ['src] (pails/t corrupt))) changed)
      refused (? (either/is_ok rejection) (either/ok_val rejection) changed)
      deleted (nenex_editor_tests/result (grove_install/change root (writ/poke (myth/sing ['src] (pails/t (str/from_atom (weft/join 10 [";. /0x11/app/nenex/w/scratch" "  ;= Short" "    Remaining."]))))) changed) changed)
      literal_payloads=row[str] ["" ";= stays prose" ";/not-a-reference" "  leading and trailing  " (str/from_atom (weft/join 10 ["first" "second" ""])) (str/from_atom (weft/join 10 ["" "  indented" ""]))]
      literal_roundtrips
        | literal_payloads.all
          \ text=str
          = value (goo/text/en text)
            input (myth/sing ['text] (goo/text/pail value))
          ?> (./ok writes) (nenex_edit/save ['text] target input state) .false
          ?> (./ok next) (grove_install/changes writes state) .false
          | equal (goo/text/pail value) (nenex_edit/record target next).pail_at(['text])

      fields=row[[path path]] [[['title] [($u 0)]] [['lead] [($u 0) ($u 1)]] [['body] [($u 0) ($u 3)]]]
      field_roundtrips
        | fields.all
          \ [field relative]
          = at root.weld(relative)
            input (myth/sing field (goo/text/pail nenex_editor_tests/runs))
          ?> (./ok writes) (nenex_edit/save field at input state) .false
          ?> (./ok next) (grove_install/changes writes state) .false
          | equal (goo/text/pail nenex_editor_tests/runs) (nenex_edit/record at next).pail_at(field)

    [(testing/nat "title, quote lead and literal body retain rich values" 1 field_roundtrips)
     (testing/nat "literal rich text stays in its Semidoc node" 1 literal_roundtrips)
     (testing/nat "fixture installed" 1 world.valid)
     (testing/nat "native edit planned" 1 (either/is_ok plan))
     (testing/nat "one source transaction" 1 writes.len)
     (testing/nat "rich field is canonical Goo value" 1 (equal card.pail_at(['text]) (goo/text/pail nenex_editor_tests/runs)))
     (testing/nat "custom relation preserved" 1 (equal card.pail_at(['rel 'supports]) (pails/p [($x 17) 'user 'evidence])))
     (testing/nat "nested quote preserved" 1 (equal (sovereign_care .z root.weld([($u 0) ($u 1)]) state) (sovereign_care .z root.weld([($u 0) ($u 1)]) changed)))
     (testing/nat "reference and embed preserved" 1 (equal (nenex_edit/record root.weld([($u 0) ($u 2)]) state) (nenex_edit/record root.weld([($u 0) ($u 2)]) changed)))
     (testing/nat "literal body preserved" 1 (equal (nenex_edit/record root.weld([($u 0) ($u 3)]) state) (nenex_edit/record root.weld([($u 0) ($u 3)]) changed)))
     (testing/nat "named subtrees survive rich edit" 1 (named.all((\ p (equal (sovereign_care .z root.weld(p) state) (sovereign_care .z root.weld(p) changed))))))
     (testing/nat "source export reparse preserves runs" 1 (equal (nenex_edit/record target reparsed).pail_at(['text]) (goo/text/pail nenex_editor_tests/runs)))
     (testing/nat "wrong field refuses" 1 (either/is_err wrong))
     (testing/nat "named work is not document content" 1 (either/is_err foreign))
     (testing/text "invalid rich metadata retains source" source (nenex_edit/record root refused).txt_at(['src]))
     (testing/nat "source deletion removes stale numbered blocks" 0 (sovereign_care .x root.weld([($u 0) ($u 2)]) deleted).fil.is_some)
     (testing/nat "named subtrees survive source deletion" 1 (named.all((\ p (equal (sovereign_care .z root.weld(p) state) (sovereign_care .z root.weld(p) deleted))))))]

  + command
    \ command=str target=path value=goo/text start=nat end=nat state=namespace
    ^ either[iota namespace]
    = field (sd/text_field (nenex_edit/record target state).txt_at(['kind]))
      root nenex_editor_tests/root
      input (myth/sing field (goo/text/pail value)).put(['command] (pails/t command)).put(['start] (pails/t (nat/show start))).put(['end] (pails/t (nat/show end))).put(['epoch] (pails/t (nat/show state.local.top)))
    < writes (nenex_edit/operate field target input state)
    | grove_install/changes writes state
  + block_checks
    \ ignored=unit
    ^ row[testing/check]
    = root=path nenex_editor_tests/root
      target=path root.weld([($u 0) ($u 0)])
      world (app_world/mount wiki/app "apps/nenex/main" ['app 'nenex] app_world/seed)
      world (app_world/post ['app 'nenex 'w] [['new "scratch"]] world)
      world (app_world/post root [['src nenex_editor_tests/source]] world)
      world (app_world/make (row/weld[iota] ['work 'trace] root) (myth/sing ['sentinel] (pails/t "keep")) world)
      state world.state
      split (nenex_editor_tests/command "split" target nenex_editor_tests/runs 8 8 state)
      divided (nenex_editor_tests/result split state)
      right=path target.take(target.len.dec).snoc(($u 1))
      heading (nenex_editor_tests/command "heading" target (goo/text/en "/heaQuestion") 4 4 state)
      headed (nenex_editor_tests/result heading state)
      moved (nenex_editor_tests/command "down" target nenex_editor_tests/runs 0 0 state)
      shifted (nenex_editor_tests/result moved state)
      deleted (nenex_editor_tests/command "delete" target nenex_editor_tests/runs 0 0 state)
      removed (nenex_editor_tests/result deleted state)
      quote=path root.weld([($u 0) ($u 1)])
      split_quote (nenex_editor_tests/command "split" quote (goo/text/en "Quoted lead") 6 6 state)
      quote_state (nenex_editor_tests/result split_quote state)
      heading_enter (nenex_editor_tests/command "split" root.weld([($u 0)]) (goo/text/en "Research") 8 8 state)
      heading_state (nenex_editor_tests/result heading_enter state)
      unsafe (nenex_editor_tests/command "paragraph" quote (goo/text/en "Quote") 0 0 state)
      delete_parent (nenex_editor_tests/command "delete" quote (goo/text/en "Quote") 0 0 state)
      named_world (app_world/make (row/weld[iota] ['work 'note] target) (myth/sing ['sentinel] (pails/t "keep")) world)
      with_named named_world.state
      refused (nenex_editor_tests/command "down" target nenex_editor_tests/runs 0 0 with_named)
      named=path (row/weld[iota] ['work 'trace] root)
      bad_input (myth/sing ['text] (goo/text/pail nenex_editor_tests/runs)).put(['command] (pails/t "save")).put(['start] (pails/t "0")).put(['end] (pails/t "0")).put(['epoch] (pails/t "0"))
    [(testing/nat "split is admitted" 1 (either/is_ok split))
     (testing/text "split preserves left text" "Changed " (str/from_atom (sd/text_at ['text] (nenex_edit/record target divided))))
     (testing/text "split preserves right text" "evidence" (str/from_atom (sd/text_at ['text] (nenex_edit/record right divided))))
     (testing/nat "split retains right link metadata" 1 (equal (nenex_edit/record right divided).pail_at(['text]) (goo/text/pail (goo/text/slice 8 8 nenex_editor_tests/runs))))
     (testing/nat "slash heading admitted" 1 (either/is_ok heading))
     (testing/text "slash changes actual kind" "sect" (nenex_edit/record target headed).txt_at(['kind]))
     (testing/text "slash query consumed" "Question" (str/from_atom (sd/text_at ['title] (nenex_edit/record target headed))))
     (testing/nat "move admitted" 1 (either/is_ok moved))
     (testing/nat "move carries rich value" 1 (equal (nenex_edit/record right shifted).pail_at(['text]) (goo/text/pail nenex_editor_tests/runs)))
     (testing/text "move carries nested quote" "quote" (nenex_edit/record target shifted).txt_at(['kind]))
     (testing/nat "delete leaf admitted" 1 (either/is_ok deleted))
     (testing/text "delete preserves next subtree" "quote" (nenex_edit/record target removed).txt_at(['kind]))
     (testing/nat "split on a nonzero sibling is admitted" 1 (either/is_ok split_quote))
     (testing/text "split changes the selected quote" "Quoted" (str/from_atom (sd/text_at ['lead] (nenex_edit/record quote quote_state))))
     (testing/text "quote split keeps its nested child" "Nested quotation." (str/from_atom (sd/text_at ['text] (nenex_edit/record quote.weld([($u 0)]) quote_state))))
     (testing/nat "heading Enter admitted" 1 (either/is_ok heading_enter))
     (testing/text "heading Enter inserts first child" "" (str/from_atom (sd/text_at ['text] (nenex_edit/record target heading_state))))
     (testing/text "heading Enter preserves previous first child" "Original paragraph." (str/from_atom (sd/text_at ['text] (nenex_edit/record root.weld([($u 0) ($u 1)]) heading_state))))
     (testing/nat "conversion cannot discard children" 1 (either/is_err unsafe))
     (testing/nat "delete cannot discard children" 1 (either/is_err delete_parent))
     (testing/nat "named descendant fixture valid" 1 named_world.valid)
     (testing/text "named descendant is present" "keep" (nenex_edit/record (row/weld[iota] ['work 'note] target) with_named).txt_at(['sentinel]))
     (testing/nat "reordering cannot lose named descendants" 1 (either/is_err refused))
     (testing/nat "stale document refuses" 1 (either/is_err (nenex_edit/operate ['text] target bad_input state)))
     (testing/nat "root named work survives structural edits" 1 (equal (sovereign_care .z named state) (sovereign_care .z named divided)))
     (testing/nat "structural result obeys source law" 1 (equal (wiki/page_nodes (sovereign_care .z root divided)) (wiki/src_image (str/to_atom (nenex_edit/record root divided).txt_at(['src])))))]

  + guards
    \ ignored=unit
    ^ row[testing/check]
    = root nenex_editor_tests/root
      target root.weld([($u 0) ($u 0)])
      world (app_world/mount wiki/app "apps/nenex/main" ['app 'nenex] app_world/seed)
      world (app_world/post ['app 'nenex 'w] [['new "scratch"]] world)
      world (app_world/post root [['src nenex_editor_tests/source]] world)
      state world.state
      token (nat/show state.local.top)
      input (myth/sing ['text] (goo/text/pail nenex_editor_tests/runs)).put(['command] (pails/t "save")).put(['start] (pails/t "0")).put(['end] (pails/t "0")).put(['epoch] (pails/t token))
      work (app_world/make root.weld(['work 'note]) (myth/sing ['sentinel] (pails/t "keep")) world)
      saved (nenex_edit/operate ['text] target input work.state)
      fields=row[[str str]] [["page" (path_show root)] ["epoch" token] ["src" nenex_editor_tests/source]]
      source_saved (nenex_editor_http/source_plan fields work.state)
      updated (app_world/post root [['src ";= Concurrent edit"]] work)
      stale (nenex_editor_http/source_plan fields updated.state)
      rich_stale (nenex_edit/operate ['text] target input updated.state)
      history (row/all[care] (\ car (equal (namespace/page car state.case(car root) root state) (namespace/page car state.case(car root) root updated.state))) [.x .y .z])
    [(testing/nat "valid concurrent-edit fixture" 1 updated.valid)
     (testing/nat "work-only changes allow rich edits" 1 (either/is_ok saved))
     (testing/nat "work-only changes allow source edits" 1 (either/is_ok source_saved))
     (testing/nat "source form refuses stale authored content" 1 (either/is_err stale))
     (testing/nat "rich editor refuses stale authored content" 1 (either/is_err rich_stale))
     (testing/text "new source remains current" ";= Concurrent edit" (nenex_edit/record root updated.state).txt_at(['src]))
     (testing/nat "all captured x/y/z history remains readable" 1 history)
     (testing/text "named work survives edits" "keep" (nenex_edit/record root.weld(['work 'note]) updated.state).txt_at(['sentinel]))]

  + conflicts
    \ ignored=unit
    ^ row[testing/check]
    = root=path nenex_editor_tests/root
      left=path root.weld([($u 0) ($u 0)])
      right=path root.weld([($u 0) ($u 1)])
      source (str/from_atom (sd/joined 10 [";. /0x11/app/nenex/w/scratch" "  ;= Research"
        "    ;@ /flow/bind pages document" "    ;@ /flow/bind sources captured"
        "    First" "" "    Second"]))
      world (app_world/mount wiki/app "apps/nenex/main" ['app 'nenex] app_world/seed)
      world (app_world/post ['app 'nenex 'w] [['new "scratch"]] world)
      world (app_world/post root [['src source]] world)
      initial world.state
      old (nenex_edit/record left initial).del(['flow 'bind])
      other (nenex_edit/record right initial)
      tree (sovereign_care .z root initial).put(left.drop(root.len) old)
      baseline (wiki/page_nodes tree)
      setup (grove_install/changes [[left (writ/make old)]
        [root (writ/poke (myth/sing wiki/image_slot (wiki/document_image (str/to_atom source) (pin baseline))))]] initial)
      state (nenex_editor_tests/result setup initial)
      token (nat/show state.local.top)
      swapped (grove_install/changes [[left (writ/make other)] [right (writ/make old)]] state)
      conflict (nenex_editor_tests/result swapped state)
      undone (nenex_editor_tests/result (grove_install/changes [[left (writ/make old)] [right (writ/make other)]] conflict) conflict)
      input (myth/sing ['src] (pails/t source)).put(['epoch] (pails/t token))
      stale (nenex_edit/source root input conflict)
      fresh (nenex_edit/source root input.put(['epoch] (pails/t (nat/show conflict.local.top))) conflict)
      restored (nenex_editor_tests/result (grove_install/changes (either/ok_val fresh) conflict) conflict)
      moved (nenex_editor_tests/command "down" left (goo/text/en "First") 0 0 restored)
      moved_state (nenex_editor_tests/result moved restored)
      reader (nenex_ui/document conflict.self root (sovereign_care .z root conflict)
        (sovereign_care .z root.take(root.len.dec) conflict) [] 0 conflict.local.top root [])
      prior (row/all[care] (\ car (equal (namespace/page car state.case(car root) root state) (namespace/page car state.case(car root) root restored))) [.x .y .z])
      attached (nenex_editor_tests/result (grove_install/change left.weld(['work 'note]) (writ/make (myth/sing ['sentinel] (pails/t "keep"))) initial) initial)
      changed_source (str/from_atom (sd/joined 10 [";. /0x11/app/nenex/w/scratch" "  ;= Research" "    Second"]))
      protected (nenex_edit/source root (myth/sing ['src] (pails/t changed_source)).put(['epoch] (pails/t (nat/show attached.local.top))) attached)
    [(testing/nat "lossy projection fixture admitted" 1 (either/is_ok setup))
     (testing/text "lossy projection retains original source" source (nenex_edit/record root state).txt_at(['src]))
     (testing/nat "native move retained for explicit resolution" 1 (either/is_ok swapped))
     (testing/text "conflict does not overwrite authored bindings" source (nenex_edit/record root conflict).txt_at(['src]))
     (testing/nat "ambiguous move reports conflict" 1 (gt (nenex_edit/record root conflict).txt_at(['err]).len 0))
     (testing/text "native undo clears the resolved conflict" "" (nenex_edit/record root undone).txt_at(['err]))
     (testing/nat "reader exposes the reconciliation error" 1 (cord/has "Semidoc reconciliation conflict" reader))
     (testing/nat "Goo cannot silently serialize conflicted blocks" 1 (either/is_err (wiki/authored_nodes (sovereign_care .z root conflict))))
     (testing/nat "same source text does not make stale native content safe" 1 (either/is_err stale))
     (testing/nat "fresh source edit explicitly resolves conflict" 1 (either/is_ok fresh))
     (testing/nat "source resolution restores all repeated bindings" 1 (equal (nenex_edit/record left initial).get(['flow 'bind]) (nenex_edit/record left restored).get(['flow 'bind])))
     (testing/nat "resolved faithful document can move through Goo" 1 (either/is_ok moved))
     (testing/nat "Goo move carries all bindings with the block" 1 (equal (nenex_edit/record left initial).get(['flow 'bind]) (nenex_edit/record right moved_state).get(['flow 'bind])))
     (testing/nat "resolution preserves retained x/y/z cases" 1 prior)
     (testing/nat "source deletion cannot cull named block work" 1 (either/is_err protected))
     (testing/text "attached work remains present" "keep" (nenex_edit/record left.weld(['work 'note]) attached).txt_at(['sentinel]))]

+ tests
  ^ row[testing/case]
  [(testing/case "Lossy projection conflicts and source ownership" nenex_editor_tests/conflicts) (testing/case "Authored-content guards and native history" nenex_editor_tests/guards) (testing/case "Nenex canonical rich editor" nenex_editor_tests/checks) (testing/case "Nenex structural editing" nenex_editor_tests/block_checks)]
