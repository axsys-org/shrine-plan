#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import lede=sys/lede

source_path =
  @slot

context =
  @role
  %/source_path: path_type

page =
  @role
  lede: text

summary =
  @view
  #on ; %/page
  #for ; /sys/slot/nenex_summary
  page => { show(page.lede, '/sys/slot/summary) }

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/nenex_library
  library => selection('/page, source = library.source_path) {
    list('/pages, source = library.source_path, selection = '/page, slot = '/sys/slot/nenex_summary, browse = "Read page")
  }

address_number =
  @slot

address_street =
  @slot

address_unit =
  @slot

address_locality =
  @slot

address_region =
  @slot

address_postal_code =
  @slot

address_country =
  @slot

address_label =
  @slot

address_source =
  @slot

contact_person =
  @slot

contact_organization =
  @slot

contact_workplace =
  @slot

association_contact =
  @slot

association_address =
  @slot

association_purpose =
  @slot

association_verification =
  @slot

association_evidence =
  @slot

association_valid_from =
  @slot

association_valid_until =
  @slot

address =
  @role
  %/address_number: text
  %/address_street: path_type
  %/address_source: path_type
  #opt ;
    %/address_locality: path_type
    %/address_region: path_type
    %/address_postal_code: text
    %/address_country: path_type
    %/address_unit: text

contact =
  @role
  %/contact_person: path_type
  #opt ;
    %/contact_organization: path_type
    %/contact_workplace: path_type

contact_address =
  @role
  %/association_contact: path_type
  %/association_address: path_type
  %/association_purpose: path_type
  %/association_verification: path_type
  %/association_evidence: path_type
  #opt ;
    %/association_valid_from: text
    %/association_valid_until: text

address_summary =
  @view
  #on ; %/address
  #for ; /sys/slot/nenex_address
  address => {
    show(address.address_number, '/sys/slot/label)
    show(address.address_street, '/sys/slot/reference)
    show(address.address_postal_code, '/sys/slot/label)
  }

address_street_label =
  @slot

address_locality_label =
  @slot

address_region_label =
  @slot

address_country_label =
  @slot

address_line =
  @slot

address_city_line =
  @slot

contact_name =
  @slot

contact_address_label =
  @slot

contact_address_purpose =
  @slot

contact_address_verification =
  @slot

contact_address_target =
  @slot

austin_payload =
  @slot

austin_page_base =
  @slot

austin_page_source =
  @slot

austin_streets =
  @slot

address_place_id =
  @slot

address_type =
  @slot

address_source_object_id =
  @slot

address_source_parent_id =
  @slot

address_source_segment_id =
  @slot

austin_page =
  @role
  %/austin_payload: text
  %/austin_page_base: path_type
  %/austin_page_source: path_type
  %/austin_streets: path_type

sourced_address =
  @role
  %/address_place_id: text
  %/address_source: path_type

austin_packed =
  @norm
  #here ; "/"
  #with ; austin_page

austin_addresses =
  @norm
  #here ; '/[id=@tas]
  #with ; sourced_address

austin_expand =
  @sewn
  #meta ;
    lede: "Austin address page: structured slots from compact source rows"
  #from ; austin_packed
  #to ; austin_addresses
  get :
    ! foil
    + key
      \ name=iota
      ^ path
      [($x 17) 'gov 'nenex_ui name]
    + put_text
      \ rec=myth name=iota value=str
      ^ myth
      ? (eq value.len 0) rec
      rec.put((%/get/key name) (pails/t value))
    + unpack
      \ base=path source=path streets=path out=axal[myth] line=str
      ^ axal[myth]
      = fields line.split_byte(124)
      ? !(eq fields.len 9) out
      = ident ($ts (str/cat_all ["place_" fields.at(0)]))
        street ($ts fields.at(2))
        rec (myth/sing ['sys 'about] (pails/p base.snoc(ident)))
        rec rec.put(['sys 'lede] (pails/t fields.at(4)))
        rec rec.put((%/get/key 'address_source) (pails/p source))
        rec rec.put((%/get/key 'address_place_id) (pails/t fields.at(0)))
        rec rec.put((%/get/key 'address_street) (pails/p streets.weld([($ts (str/cat_all ["p_" fields.at(2).slice(2 2)])) street])))
        rec (%/get/put_text rec 'address_number fields.at(1))
        rec (%/get/put_text rec 'address_street_label fields.at(3))
        rec (%/get/put_text rec 'address_label fields.at(4))
        rec (%/get/put_text rec 'address_type fields.at(5))
        rec (%/get/put_text rec 'address_source_parent_id fields.at(6))
        rec (%/get/put_text rec 'address_source_segment_id fields.at(7))
        rec (%/get/put_text rec 'address_source_object_id fields.at(8))
      out.put([ident] rec)
    \ tree=axal[myth]
    ^ axal[myth]
    = none (axal/new[myth] .none)
    > (./some rec) tree.fil none
    > (./some page) (%/austin_page/from_myth rec) none
    = lines page.austin_payload.split_byte(126)
    ? (gt lines.len 1000) none
    | lines.fold none
      (%/get/unpack page.austin_page_base page.austin_page_source page.austin_streets)


street_designation =
  @role
  lede: text
  %/address_source: path_type

street_designations =
  @norm
  #here ; '/[id=@tas]
  #with ; street_designation

austin_street_expand =
  @sewn
  #from ; austin_packed
  #to ; street_designations
  get :
    ! foil
    + unpack
      \ base=path source=path out=axal[myth] line=str
      ^ axal[myth]
      = fields line.split_byte(124)
      ? !(eq fields.len 2) out
      = ident ($ts fields.at(0))
        rec (myth/sing ['sys 'about] (pails/p base.snoc(ident)))
        rec rec.put(['sys 'lede] (pails/t fields.at(1)))
        rec rec.put([($x 17) 'gov 'nenex_ui 'address_source] (pails/p source))
      out.put([ident] rec)
    \ tree=axal[myth]
    ^ axal[myth]
    = none (axal/new[myth] .none)
    > (./some rec) tree.fil none
    > (./some page) (%/austin_page/from_myth rec) none
    = lines page.austin_payload.split_byte(126)
    ? (gt lines.len 1000) none
    | lines.fold none (%/get/unpack page.austin_page_base page.austin_page_source)

austin_lens =
  #meta ;
    "/sys/weft": (sewn %/austin_expand/run .none)
  ! foil
  ^ sewn
  (sewn %/austin_expand/run .none)

austin_street_lens =
  #meta ;
    "/sys/weft": (sewn %/austin_street_expand/run .none)
  ! foil
  ^ sewn
  (sewn %/austin_street_expand/run .none)
