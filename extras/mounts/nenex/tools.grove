#import plain=lib/grove/types/text

page_tools =
  @role
  src: plain
  #opt ;
    err: plain

save_source =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/source)
  #on ; %/page_tools
  source: plain
  ! foil
  \ source=str page=%/page_tools
  ^ %/page_tools
  | Seq[%/page_tools] (error (pails/t "Requires native source admission.")) page

create_page =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/create)
  #on ; %/page_tools
  name: plain
  ! foil
  \ name=str page=%/page_tools
  ^ %/page_tools
  | Seq[%/page_tools] (error (pails/t "Requires native page admission.")) page

ask_page =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/ask)
  #on ; %/page_tools
  id: plain
  question: plain
  scope: plain
  evidence: plain
  provider: plain
  ! foil
  \ id=str question=str scope=str evidence=str provider=str page=%/page_tools
  ^ %/page_tools
  | Seq[%/page_tools] (error (pails/t "Requires native answering admission.")) page

page_header =
  @view
  #on ; %/page_tools
  #for ; /sys/slot/nenex_page_header
  page => col('/sys/slot/content) {
    path(page, '/sys/slot/caption)
    show(page.err, '/sys/slot/content)
    row {
      action("Page actions", become = '/sys/slot/nenex_page_tools)
    }
  }

page_actions =
  @view
  #on ; %/page_tools
  #for ; /sys/slot/nenex_page_tools
  page => col('/sys/slot/content) {
    action("Return to page", become = '/sys/slot/nenex_page_header)
    action("Semidoc source", become = '/sys/slot/nenex_source)
    action("Ask about a page or block", become = '/sys/slot/nenex_ask)
    action("Create a wiki page", become = '/sys/slot/nenex_create)
  }

source_view =
  @view
  #on ; %/page_tools
  #for ; /sys/slot/nenex_source
  page => col('/sys/slot/content) {
    action("Page actions", become = '/sys/slot/nenex_page_tools)
    group(on = page, action = %/save_source, myth = { '/source = .input(page.src) }) {
      col {
        text("Semidoc source", '/sys/slot/title)
        input('/source, "rich-code")
        action("Save source")
      }
    }
  }

create_view =
  @view
  #on ; %/page_tools
  #for ; /sys/slot/nenex_create
  page => col('/sys/slot/content) {
    action("Page actions", become = '/sys/slot/nenex_page_tools)
    group(on = page, action = %/create_page, myth = { '/name = .input("") }) {
      col {
        text("Create a wiki page", '/sys/slot/title)
        input('/name, "text")
        action("Create page")
      }
    }
  }

ask_view =
  @view
  #on ; %/page_tools
  #for ; /sys/slot/nenex_ask
  page => col('/sys/slot/content) {
    action("Page actions", become = '/sys/slot/nenex_page_tools)
    group(on = page, action = %/ask_page, myth = { '/id = .input(""), '/question = .input(""), '/scope = .input("page"), '/evidence = .input(""), '/provider = .input("") }) {
      col {
        text("Ask about this page or a captured block", '/sys/slot/title)
        text("Question name, question, page or numbered block path, evidence paths, optional provider", '/sys/slot/caption)
        input('/id, "text")
        input('/question, "text")
        input('/scope, "text")
        input('/evidence, "text")
        input('/provider, "text")
        action("Ask")
      }
    }
  }

answer =
  @role
  "/work/question": plain
  #opt ;
    "/answer/error": plain

answer_enabled =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/enabled)
  #on ; %/answer
  enabled: plain
  ! foil
  \ enabled=str answer=%/answer
  ^ %/answer
  | Seq[%/answer] (error (pails/t "Requires native answer admission.")) answer

rebind_answer =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/rebind)
  #on ; %/answer
  scope: plain
  ! foil
  \ scope=str answer=%/answer
  ^ %/answer
  | Seq[%/answer] (error (pails/t "Requires native context admission.")) answer

answer_view =
  @view
  #on ; %/answer
  #for ; /sys/slot/nenex_answer
  answer => col {
    show(answer.question, '/sys/slot/title)
    text("Current answers follow the page and its evidence.", '/sys/slot/caption)
    show(answer.error, '/sys/slot/content)
    group(on = answer, action = %/answer_enabled) {
      row {
        action("Pause answering", '/enabled = "false")
        action("Resume answering", '/enabled = "true")
      }
    }
    group(on = answer, action = %/rebind_answer, myth = { '/scope = .input("page") }) {
      input('/scope, "text")
      action("Bind current page or block selection")
    }
  }

hole =
  @role
  "/work/question": plain
  "/work/status": plain

resolve_hole =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/resolve)
  #on ; %/hole
  content: plain
  ! foil
  \ content=str hole=%/hole
  ^ %/hole
  | Seq[%/hole] (error (pails/t "Requires native hole admission.")) hole

hole_view =
  @view
  #on ; %/hole
  #for ; /sys/slot/nenex_hole
  hole => col {
    show(hole.question, '/sys/slot/title)
    show(hole.status, '/sys/slot/caption)
    group(on = hole, action = %/resolve_hole, myth = { '/content = .input("") }) {
      input('/content, "text")
      action("Resolve with this evidence")
    }
  }

library =
  @role
  q: plain

new_library_page =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/create)
  #on ; %/library
  name: plain
  ! foil
  \ name=str library=%/library
  ^ %/library
  | Seq[%/library] (error (pails/t "Requires native page admission.")) library

search_library =
  @action
  #meta ;
    "/sys/op": (namespace_op nenex_tools/search)
  #on ; %/library
  query: plain
  ! foil
  \ query=str library=%/library
  ^ %/library
  | Seq[%/library] (error (pails/t "Requires native search admission.")) library

library_header =
  @view
  #on ; %/library
  #for ; /sys/slot/nenex_library_header
  library => col {
    text("Nenex", '/sys/slot/title)
    path(library, '/sys/slot/caption)
    action("Library actions", become = '/sys/slot/nenex_library_actions)
  }

library_actions =
  @view
  #on ; %/library
  #for ; /sys/slot/nenex_library_actions
  library => col {
    action("Return to library", become = '/sys/slot/nenex_library_header)
    group(on = library, action = %/new_library_page, myth = { '/name = .input("") }) {
      input('/name, "text")
      action("Create page")
    }
    group(on = library, action = %/search_library, myth = { '/query = .input(library.q) }) {
      input('/query, "text")
      action("Search pages")
    }
  }

current_answer =
  @role
  "/sys/content": plain
  "/work/status": plain
  "/work/reason": plain

current_answer_view =
  @view
  #on ; %/current_answer
  #for ; /sys/slot/nenex_current_answer
  output => col {
    show(output.status, '/sys/slot/caption)
    show(output.content, '/sys/slot/content)
    show(output.reason, '/sys/slot/caption)
  }
