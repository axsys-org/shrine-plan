- apps/nenex/main [at=application]
- source_mount

+ nenex_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'nenex]
      card
        | (pact/card application/app "apps/nenex/main" 0 0).put
          limb_slot (kook [[state.self 'kook 'pact]])
      [next index reply]
        | helm/supervisor/handle (helm/card/step root (writ/make card))
          state (sovereign_hive state)
    ?> (./ack failure) reply
      | ./err (pails/t "Application activation failed")
    ? (maybe/is_some failure)
      | ./err (pails/t "Application activation failed")
    | ./ok next
