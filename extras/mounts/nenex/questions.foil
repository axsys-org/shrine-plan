- answering_ops
- apps/nenex/main [at=wiki]
- semidoc [at=sd]
- browser_routes
- grove_install

' Nenex supplies the subject projection and form. Shared answering owns work.
+ nenex_questions
  + numbered
    \ key=iota
    ^ bool
    ?> ($u index) key .false
    | .true
  + page
    \ target=path state=namespace
    ^ bool
    = corpus=path [state.self 'app 'nenex 'w]
      record (cooperate_ops/record target state).fall(myth/new)
    | and (pith_prefix corpus target) (equal[pail] record.pail_at(limb_slot) (kook [[state.self 'app 'nenex 'kook 'doc]]))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = target=path [state.self 'gov 'nenex_ui 'answer_view]
      record (weft_card (felt nenex_questions/answer_html .none) [state.self 'app 'nenex 'w 'home] (lore/line "Live native answer and status"))
    ? (grove_install/change target (writ/make record) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (pails/q why))
  + answer_html
    \ tree=axal[myth]
    ^ myth
    = record tree.fil.fall(myth/new)
      status=str
        ?> (./some held) record.get(['answer 'config]) record.txt_at(['work 'status])
        ?> config=answering/config held record.txt_at(['work 'status])
        | ? config.enabled record.txt_at(['work 'status]) "paused"
      content=row[weft/node]
        [(weft/leaf "p" [(weft/cls "question-answer")] (str/to_atom record.txt_at(['answer 'text])))
         (weft/leaf "p" [(weft/cls "hint")] (cord/cat_all [(str/to_atom status) ": " (str/to_atom record.txt_at(system_vocabulary/content))]))]
    | frag/html "div" [(weft/att "aria-live" "polite")] content
  + url
    \ page=path
    ^ nat
    | str/to_atom (str/cat_all ["/nenex?path=" (value_read/percent (path_show page)) "#questions"])
  + hidden
    \ name=nat value=nat
    ^ weft/node
    | weft/el "input" [(weft/att "type" "hidden") (weft/att "name" name) (weft/att "value" value)] []
  + form
    \ action=nat page=path id=iota source=str content=row[weft/node] label=nat
    ^ weft/node
    = fields=row[weft/node]
        [(nenex_questions/hidden "action" action) (nenex_questions/hidden "page" (show/path page))
         (nenex_questions/hidden "id" (quip_val id)) (nenex_questions/hidden "source" (str/to_atom source))]
      footer=row[weft/node]
        [(weft/leaf "button" [(weft/att "type" "submit") (weft/att "disabled" "disabled")] label)
         (weft/leaf "span" [(weft/att "data-flow-status" "") (weft/att "role" "status")] "")]
    | weft/el "form" [(weft/att "method" "post") (weft/att "action" "/nenex/ask") (weft/att "data-native-flow" "") (weft/cls "flow-form")] fields.weld(content).weld(footer)
  + block_label
    \ card=myth
    ^ str
    = field (sd/text_field card.txt_at(['kind]))
    ? !(field.len) ""
    | str/from_atom (sd/text_at field card)
  + options
    \ page=path source=str
    ^ row[weft/node]
    = nodes (wiki/old_mounts (str/to_atom source)).take(256)
    | row/bind[sd/smount weft/node] (nenex_questions/option page) nodes
  + option
    \ page=path mount=sd/smount
    ^ row[weft/node]
    = text (nenex_questions/block_label mount.t)
    ? !(text.len) []
    | [(weft/leaf "option" [(weft/att "value" (show/path page.weld(mount.p)))]
        (str/to_atom (str/cat_all [(path_show mount.p) " — " text.slice(0 (? (gt text.len 100) 100 text.len))])))]
  + selection
    \ page=path source=str
    ^ weft/node
    | weft/el "label" [(weft/cls "flow-field")]
      [(weft/tx "Ask about") (weft/el "select" [(weft/att "name" "scope")]
        (row/cons[weft/node] (weft/leaf "option" [(weft/att "value" "page")] "This page") (nenex_questions/options page source)))]
  + lens
    ' Only authored source enters the primary binding. Work, backlinks and
    ' answer writes cannot change this context or trigger recursive answers.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    = record input.fil.fall(myth/new)
      source record.txt_at(['src])
      value (myth/sing system_vocabulary/content (pails/t source))
      value value.put(['subject] context.pail_at(bond/tack))
      quote context.txt_at(['question 'quote])
      value (? quote.len (value.put(['quoted_selection] (pails/t quote)).put(['original_location] context.pail_at(['question 'location]))) value)
      value (? quote.len (value.put(['selection_policy] (pails/t "The quoted block is captured, while the page is live. Its original numbered location may now refer to different content. Answer about the quote in light of the current page; do not silently substitute the block now at that location."))) value)
    | native_work_ops/lens_view context (axal/new[myth] (./some value))
  + bindings
    \ lines=row[str] index=nat record=myth
    ^ either[iota myth]
    ?> (./some pair) lines.pull (./ok record)
    = [raw rest] pair
      line raw.trim_ascii
    ? !(line.len) (nenex_questions/bindings rest index record)
    ? (gt index 8) (./err 'context_input_limit)
    ?> (./some path) (browser_routes/value_path line) (./err 'invalid_context_address)
    = alias=iota ($ts (str/cat_all ["evidence_" (nat/show index)]))
    | nenex_questions/bindings rest index.inc record.put([alias] (safe 0 .z path))
  + context
    \ page=path scope=str source=str record=myth state=namespace
    ^ either[iota myth]
    = record record.put(bond/tack (safe 0 .x page)).put(bond/weft (spun nenex_questions/lens .none)).put(['work 'focus] (pails/q 'page))
    ? (eq scope "page") (./ok record.put(['question 'quote] (pails/t "")))
    ?> (./some selected) (browser_routes/value_path scope) (./err 'nenex_invalid_block)
    ? !(and (pith_prefix page selected) (gt selected.len page.len)) (./err 'nenex_invalid_block)
    ? !(row/all[iota] nenex_questions/numbered selected.drop(page.len)) (./err 'nenex_invalid_block)
    = matches (wiki/old_mounts (str/to_atom source)).keep((\ mount (equal[path] mount.p selected.drop(page.len))))
    ? !(eq matches.len 1) (./err 'nenex_missing_block)
    = quote (nenex_questions/block_label matches.at(0).t)
    ? !(quote.len) (./err 'nenex_missing_block)
    | ./ok record.put(['question 'quote] (pails/t quote)).put(['question 'location] (pails/p selected))
  + plan
    \ fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    ?> (./some page) (browser_routes/value_path (field "page")) (./err 'nenex_not_document_content)
    ? !(nenex_questions/page page state) (./err 'nenex_not_document_content)
    < id (cooperate_ops/identifier (myth/sing ['id] (pails/t (field "id"))))
    = controller=path page.weld(['work 'questions id])
      cell=path page.weld(['cells 'questions id])
      current (cooperate_ops/record controller state).fall(myth/new)
    ? ((eq action "pause") || (eq action "resume"))
      | namespace_command/plan controller [state.self 'gov 'cooperate 'answer_enabled] (myth/sing ['enabled] (pails/b (eq action "resume"))) state
    = source (cooperate_ops/record page state).fall(myth/new).txt_at(['src])
    ? !(eq source (field "source")) (./err 'nenex_stale_question_context)
    ? (gt (wiki/old_mounts (str/to_atom source)).len 256) (./err 'nenex_document_limit)
    ? (eq action "rebind")
      ?> (./some held) current.get(['answer 'config]) (./err 'missing_work)
      ?> config=answering/config held (./err 'missing_work)
      ? !(equal[path] config.subject page) (./err 'missing_work)
      < context (nenex_questions/context page (field "scope") source (cooperate_ops/record cell state).fall(myth/new) state)
      | ./ok [[cell (writ/make context)]]
    ? !(eq action "ask") (./err 'invalid_question_action)
    ? (gt (sovereign_peek cell state).wyt 0) (./err 'question_id_exists)
    < context (nenex_questions/context page (field "scope") source myth/new state)
    < context (nenex_questions/bindings (http_foot/split 10 (field "evidence")) 1 context)
    ?> (./some provider) (browser_routes/value_path (field "provider")) (./err 'missing_provider)
    = input (myth/sing ['id] (pails/t (field "id"))).put(['content] (pails/t (field "question")))
      input input.put(['context] (safe 0 .z (row/cons[iota] 'x cell))).put(['provider] (safe 0 .x provider))
    < writes (namespace_command/plan page [state.self 'gov 'cooperate 'answer] input state)
    | ./ok (row/cons[[p=path q=writ]] [cell (writ/make context)] writes)
  + entry
    \ page=path source=str tree=axal[myth] entry=[path myth]
    ^ row[weft/node]
    = [relative record] entry
    ? !(eq relative.len 1) []
    ?> (./some held) record.get(['answer 'config]) []
    ?> config=answering/config held []
    = id relative.at(0)
      controller=path page.weld(['work 'questions id])
      context tree.get(['cells 'questions id]).fall(myth/new)
      quote context.txt_at(['question 'quote])
      status record.txt_at(['work 'status])
      text record.txt_at(['answer 'text])
      content=row[weft/node]
        [(weft/leaf "summary" [] (str/to_atom (str/cat_all [config.question (? config.enabled "" " — paused")])))]
      content (? quote.len (content.snoc((weft/leaf "blockquote" [] (str/to_atom quote)))) content)
      content content.snoc((frag/mount (weft/cat2 "answer-" (quip_val id)) [page.at(0) 'gov 'nenex_ui 'answer_view] controller 2))
      content content.snoc((weft/el "div" [(weft/cls "flow-links")]
        [(weft/leaf "a" [(weft/href (weft/cat2 "/ns/x" (show/path page.weld(['cells 'questions id]))))] "Live context")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns/x" (show/path controller.snoc('answer))))] "Answer cell")
         (weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path controller)))] "Attempts and evidence")]))
      content content.snoc((nenex_questions/form (? config.enabled "pause" "resume") page id source [] (? config.enabled "Pause answering" "Resume answering")))
      content content.snoc((weft/el "details" [] [(weft/leaf "summary" [] "Change the quoted selection")
        (nenex_questions/form "rebind" page id source [(nenex_questions/selection page source)] "Bind selection")]))
    | [(weft/el "details" [(weft/cls "question") (weft/att "open" "open")] content)]
  + render
    \ page=path tree=axal[myth]
    ^ row[weft/node]
    = source tree.fil.fall(myth/new).txt_at(['src])
    ? !(source.len) []
    = questions tree.dip(['work 'questions]).tap
      entries questions.bind((nenex_questions/entry page source tree))
      id=iota ($ts (str/cat_all ["q_" (nat/show questions.len.inc)]))
      content=row[weft/node]
        [(weft/leaf "h2" [] "Questions")
         (weft/leaf "p" [(weft/cls "hint")] "Ask about this page or capture a block quotation. Page context stays live; each attempt retains its evidence. Optional bindings can include /x/... cell results.")
         (nenex_questions/form "ask" page id source
          [(nenex_questions/selection page source)
           (weft/el "label" [(weft/cls "flow-field")] [(weft/tx "Your question") (weft/el "textarea" [(weft/att "name" "question") (weft/att "rows" "3") (weft/att "required" "required")] [])])
           (weft/el "details" [] [(weft/leaf "summary" [] "Evidence and answering provider")
             (weft/el "label" [(weft/cls "flow-field")] [(weft/tx "Additional context paths (one per line)") (weft/el "textarea" [(weft/att "name" "evidence") (weft/att "rows" "3")] [])])
             (weft/el "label" [(weft/cls "flow-field")] [(weft/tx "Provider path") (weft/el "input" [(weft/att "name" "provider") (weft/att "value" (show/path [page.at(0) 'io 'codex 'work_provider]))] [])])])]
          "Ask")]
    | [(weft/el "section" [(weft/id "questions") (weft/att "aria-label" "Questions")] content.weld(entries))]
  + response
    \ fields=row[[str str]] refused=maybe[pail] state=namespace
    ^ [nat str]
    = error=str
        ?> (./some why) refused ""
        | http_foot/reason why
      target (str/cat_all ["/nenex?path=" (value_read/percent (http_foot/field "page" fields)) "#questions"])
    | [(? refused.is_some 409 200) (show (json/obj [(jkv "error" (json/str error)) (jkv "redirect" (json/str target))]))]
  + request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    ? (gt request.body.len 262144) (./reply (http_driver/response 413 "Question form too large"))
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields request.body) (./reply (http_driver/response 400 "Invalid form"))
    ? !(eq fields.len (row/uniq[str] (fields.map((\ [key value] key)))).len) (./reply (http_driver/response 400 "Duplicate form fields"))
    | ./admit (nenex_questions/plan fields) (nenex_questions/response fields) (\ ignored state "")
