- answering_ops
- apps/nenex/main [at=wiki]
- semidoc [at=sd]
- browser_routes
- grove_install

' Nenex supplies the subject projection. Shared answering owns persistent work.
+ nenex_questions
  + numbered
    \ key=iota
    ^ bool
    ?> ($u index) key .false
    | .true
  + page
    \ target=path state=namespace
    ^ bool
    = corpus=path [state.self 'app 'nenex 'w]
      record (cooperate_ops/record target state).fall(myth/new)
    | and (pith_prefix corpus target) (equal[pail] record.pail_at(limb_slot) (kook [[state.self 'app 'nenex 'kook 'doc]]))
  + block_label
    \ card=myth
    ^ str
    = field (sd/text_field card.txt_at(['kind]))
    ? !(field.len) ""
    | str/from_atom (sd/text_at field card)
  + lens
    ' Only authored source enters the primary binding. Work, backlinks and
    ' answer writes cannot change this context or trigger recursive answers.
    \ context=myth input=axal[myth]
    ^ axal[myth]
    = record input.fil.fall(myth/new)
      source record.txt_at(['src])
      value (myth/sing system_vocabulary/content (pails/t source))
      value value.put(['subject] context.pail_at(bond/tack))
      quote context.txt_at(['question 'quote])
      value (? quote.len (value.put(['quoted_selection] (pails/t quote)).put(['original_location] context.pail_at(['question 'location]))) value)
      value (? quote.len (value.put(['selection_policy] (pails/t "The quoted block is captured, while the page is live. Its original numbered location may now refer to different content. Answer about the quote in light of the current page; do not silently substitute the block now at that location."))) value)
    | native_work_ops/lens_view context (axal/new[myth] (./some value))
  + bindings
    \ lines=row[str] index=nat record=myth
    ^ either[iota myth]
    ?> (./some pair) lines.pull (./ok record)
    = [raw rest] pair
      line raw.trim_ascii
    ? !(line.len) (nenex_questions/bindings rest index record)
    ? (gt index 8) (./err 'context_input_limit)
    ?> (./some path) (browser_routes/value_path line) (./err 'invalid_context_address)
    = alias=iota ($ts (str/cat_all ["evidence_" (nat/show index)]))
    | nenex_questions/bindings rest index.inc record.put([alias] (safe 0 .z path))
  + context
    \ page=path scope=str source=str record=myth state=namespace
    ^ either[iota myth]
    = record record.put(bond/tack (safe 0 .x page)).put(bond/weft (spun nenex_questions/lens .none)).put(['work 'focus] (pails/q 'page))
    ? (eq scope "page") (./ok record.put(['question 'quote] (pails/t "")))
    ?> (./some selected) (browser_routes/value_path scope) (./err 'nenex_invalid_block)
    ? !(and (pith_prefix page selected) (gt selected.len page.len)) (./err 'nenex_invalid_block)
    ? !(row/all[iota] nenex_questions/numbered selected.drop(page.len)) (./err 'nenex_invalid_block)
    = matches (wiki/old_mounts (str/to_atom source)).keep((\ mount (equal[path] mount.p selected.drop(page.len))))
    ? !(eq matches.len 1) (./err 'nenex_missing_block)
    = quote (nenex_questions/block_label matches.at(0).t)
    ? !(quote.len) (./err 'nenex_missing_block)
    | ./ok record.put(['question 'quote] (pails/t quote)).put(['question 'location] (pails/p selected))
  + plan
    \ fields=row[[str str]] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = field (\ name=str (http_foot/field name fields))
      action (field "action")
    ?> (./some page) (browser_routes/value_path (field "page")) (./err 'nenex_not_document_content)
    ? !(nenex_questions/page page state) (./err 'nenex_not_document_content)
    < id (cooperate_ops/identifier (myth/sing ['id] (pails/t (field "id"))))
    = controller=path page.weld(['work 'questions id])
      cell=path page.weld(['cells 'questions id])
      current (cooperate_ops/record controller state).fall(myth/new)
    ? ((eq action "pause") || (eq action "resume"))
      | namespace_command/plan controller [state.self 'gov 'cooperate 'answer_enabled] (myth/sing ['enabled] (pails/b (eq action "resume"))) state
    = source (cooperate_ops/record page state).fall(myth/new).txt_at(['src])
    ? !(eq source (field "source")) (./err 'nenex_stale_question_context)
    ? (gt (wiki/old_mounts (str/to_atom source)).len 256) (./err 'nenex_document_limit)
    ? (eq action "rebind")
      ?> (./some held) current.get(['answer 'config]) (./err 'missing_work)
      ?> config=answering/config held (./err 'missing_work)
      ? !(equal[path] config.subject page) (./err 'missing_work)
      < context (nenex_questions/context page (field "scope") source (cooperate_ops/record cell state).fall(myth/new) state)
      | ./ok [[cell (writ/make context)]]
    ? !(eq action "ask") (./err 'invalid_question_action)
    ? (gt (sovereign_peek cell state).wyt 0) (./err 'question_id_exists)
    < context (nenex_questions/context page (field "scope") source myth/new state)
    < context (nenex_questions/bindings (http_foot/split 10 (field "evidence")) 1 context)
    ?> (./some provider) (browser_routes/value_path (field "provider")) (./err 'missing_provider)
    = input (myth/sing ['id] (pails/t (field "id"))).put(['content] (pails/t (field "question")))
      input input.put(['context] (safe 0 .z (row/cons[iota] 'x cell))).put(['provider] (safe 0 .x provider))
    < writes (namespace_command/plan page [state.self 'gov 'cooperate 'answer] input state)
    | ./ok (row/cons[[p=path q=writ]] [cell (writ/make context)] writes)
  + response
    \ fields=row[[str str]] refused=maybe[pail] state=namespace
    ^ [nat str]
    = error=str
        ?> (./some why) refused ""
        | http_foot/reason why
      target (str/cat_all ["/nenex?path=" (value_read/percent (http_foot/field "page" fields)) "#questions"])
    | [(? refused.is_some 409 200) (show (json/obj [(jkv "error" (json/str error)) (jkv "redirect" (json/str target))]))]
  + request
    \ request=http_foot/request now=nat
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    ? (gt request.body.len 262144) (./reply (http_driver/response 413 "Question form too large"))
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields request.body) (./reply (http_driver/response 400 "Invalid form"))
    ? !(eq fields.len (row/uniq[str] (fields.map((\ [key value] key)))).len) (./reply (http_driver/response 400 "Duplicate form fields"))
    | ./admit (nenex_questions/plan fields) (nenex_questions/response fields) (\ outcome before state "")
