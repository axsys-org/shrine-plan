{
  "version": 1,
  "name": "nenex",
  "dependencies": [
    "explorer",
    "codecs"
  ],
  "modules": {
    "apps/nenex/main": "main.foil",
    "nenex_mount": "activation.foil",
    "nenex_interface": "interface.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "nenex_ui"
      ],
      "files": [
        "library.grove"
      ]
    }
  ],
  "assets": {
    "/nenex/style.css": "style.css",
    "/nenex/interface.js": "interface.js"
  },
  "files": {
    "src/foil/apps/nenex/tests.foil": "tests.foil",
    "src/foil/apps/nenex/main.foil": "main.foil"
  },
  "roots": [
    [
      "lib",
      "apps/nenex/main"
    ],
    [
      "lib",
      "nenex_mount"
    ],
    [
      "lib",
      "nenex_interface"
    ],
    [
      "gov",
      "nenex_ui"
    ]
  ],
  "tests": {
    "apps/nenex/tests": "tests.foil"
  },
  "activate": {
    "module": "nenex_mount",
    "entry": [
      "nenex_mount",
      "install"
    ]
  },
  "http": {
    "module": "nenex_interface",
    "entry": [
      "nenex_ui",
      "http"
    ]
  },
  "routes": [
    "/nenex"
  ]
}
