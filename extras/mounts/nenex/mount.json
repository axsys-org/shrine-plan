{
  "version": 1,
  "name": "nenex",
  "dependencies": [
    "explorer",
    "codecs",
    "cooperate"
  ],
  "modules": {
    "apps/nenex/main": "main.foil",
    "nenex_mount": "activation.foil",
    "nenex_interface": "interface.foil",
    "nenex_editor": "editor.foil",
    "nenex_editor_http": "editor_http.foil",
    "nenex_questions": "questions.foil",
    "nenex_tools": "tools.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "nenex_ui"
      ],
      "files": [
        "library.grove"
      ]
    },
    {
      "root": [
        "gov",
        "nenex_editor"
      ],
      "files": [
        "editor.grove"
      ],
      "prelude": "nenex_editor"
    },
    {
      "root": [
        "gov",
        "nenex_tools"
      ],
      "files": [
        "tools.grove"
      ],
      "prelude": "nenex_tools"
    }
  ],
  "assets": {},
  "files": {
    "src/foil/apps/nenex/tests.foil": "tests.foil",
    "src/foil/apps/nenex/main.foil": "main.foil"
  },
  "roots": [
    [
      "lib",
      "apps/nenex/main"
    ],
    [
      "lib",
      "nenex_mount"
    ],
    [
      "lib",
      "nenex_interface"
    ],
    [
      "lib",
      "nenex_editor"
    ],
    [
      "lib",
      "nenex_editor_http"
    ],
    [
      "lib",
      "nenex_questions"
    ],
    [
      "lib",
      "nenex_tools"
    ],
    [
      "gov",
      "nenex_ui"
    ],
    [
      "gov",
      "nenex_editor"
    ],
    [
      "gov",
      "nenex_tools"
    ]
  ],
  "tests": {
    "apps/nenex/tests": "tests.foil",
    "nenex_editor_tests": "editor_tests.foil",
    "nenex_editor_http_tests": "editor_http_tests.foil",
    "nenex_question_tests": "question_tests.foil"
  },
  "activate": {
    "module": "nenex_mount",
    "entry": [
      "nenex_mount",
      "install"
    ]
  },
  "http": {
    "module": "nenex_interface",
    "entry": [
      "nenex_ui",
      "http"
    ]
  },
  "routes": [
    "/nenex"
  ],
  "test_files": {
    "foil/nenex_document_tests.foil": "document_tests.foil",
    "grove/nenex/tools.grove": "tools.grove",
    "grove/nenex/editor.grove": "editor.grove"
  },
  "test_suites": {
    "nenex-document-tests": {
      "kind": "reaver",
      "entrypoint": "check"
    }
  }
}
