- nenex_editor_http
- testing

+ nenex_editor_http_tests
  + status
    \ method=str target=str
    ^ nat
    ?> (./reply response) (nenex_editor_http/request (http_foot/request method target "") 0) 200
    | response.status
  + source_status
    \ method=str body=str
    ^ nat
    ?> (./reply response) (nenex_editor_http/source_request (http_foot/request method "/nenex/source" body) 0) 200
    | response.status
  + checks
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "source save uses native admission" 200 (nenex_editor_http_tests/source_status "POST" "page=%2F0x11%2Fapp%2Fnenex%2Fw%2Fhome&epoch=1&src=hello"))
     (testing/nat "source save rejects missing guard" 400 (nenex_editor_http_tests/source_status "POST" "page=x&src=hello"))
     (testing/nat "source save rejects duplicate guard" 400 (nenex_editor_http_tests/source_status "POST" "page=x&epoch=1&epoch=2"))
     (testing/nat "source save requires POST" 405 (nenex_editor_http_tests/source_status "GET" ""))
     (testing/nat "editor accepts a canonical document address" 200 (nenex_editor_http_tests/status "GET" "/nenex/edit?path=/0x11/app/nenex/w/home"))
     (testing/nat "editor does not accept writes" 405 (nenex_editor_http_tests/status "POST" "/nenex/edit?path=/0x11/app/nenex/w/home"))
     (testing/nat "editor requires a path" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit"))
     (testing/nat "editor rejects duplicate paths" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?path=/a&path=/b"))
     (testing/nat "editor rejects unknown query fields" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?other=/a"))
     (testing/nat "editor rejects relative addresses" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?path=relative"))]
+ tests
  ^ row[testing/case]
  [(testing/case "Nenex editor route" nenex_editor_http_tests/checks)]
