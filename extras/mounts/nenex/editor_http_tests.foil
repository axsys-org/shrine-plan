- nenex_editor_http
- testing

+ nenex_editor_http_tests
  + status
    \ method=str target=str
    ^ nat
    ?> (./reply response) (nenex_editor_http/request (http_foot/request method target "") 0) 0
    | response.status
  + source_status
    \ method=str body=str
    ^ nat
    ?> (./reply response) (nenex_editor_http/source_request (http_foot/request method "/nenex/source" body) 0) 0
    | response.status
  + source_admission
    \ ignored=unit
    ^ bool
    ?> (./admit _ _ _) (nenex_editor_http/source_request (http_foot/request "POST" "/nenex/source" "page=%2F0x11%2Fapp%2Fnenex%2Fw%2Fhome&epoch=1&src=hello") 0) .false
    .true
  + editor_action
    \ ignored=unit
    ^ str
    = action (nenex_editor_http/request (http_foot/request "GET" "/nenex/edit?path=/0x11/app/nenex/w/home" "") 0)
    ? action
     > (./after _ _) "snapshot"
     > (./reply response) (str/from_atom response.body)
    "unexpected action"
  + data_status
    \ method=str target=str
    ^ nat
    ?> (./reply response) (nenex_editor_http/data_request (http_foot/request method target "") 0) 0
    | response.status
  + checks
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "page data endpoint rejects writes" 405 (nenex_editor_http_tests/data_status "POST" "/nenex/document?path=/a"))
     (testing/nat "page data endpoint rejects unknown fields" 400 (nenex_editor_http_tests/data_status "GET" "/nenex/document?path=/a&other=b"))
     (testing/nat "page data endpoint rejects duplicate paths" 400 (nenex_editor_http_tests/data_status "GET" "/nenex/document?path=/a&path=/b"))
     (testing/nat "single-page refresh rejects frontier arguments" 400 (nenex_editor_http_tests/data_status "GET" "/nenex/document?path=/a&after=b"))
     (testing/nat "source save requests native admission" 1 (nenex_editor_http_tests/source_admission []))
     (testing/nat "source save rejects missing guard" 400 (nenex_editor_http_tests/source_status "POST" "page=x&src=hello"))
     (testing/nat "source save rejects duplicate guard" 400 (nenex_editor_http_tests/source_status "POST" "page=x&epoch=1&epoch=2"))
     (testing/nat "source save requires POST" 405 (nenex_editor_http_tests/source_status "GET" ""))
     (testing/text "editor accepts a canonical document address" "snapshot" (nenex_editor_http_tests/editor_action []))
     (testing/nat "editor does not accept writes" 405 (nenex_editor_http_tests/status "POST" "/nenex/edit?path=/0x11/app/nenex/w/home"))
     (testing/nat "editor requires a path" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit"))
     (testing/nat "editor rejects duplicate paths" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?path=/a&path=/b"))
     (testing/nat "editor rejects unknown query fields" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?other=/a"))
     (testing/nat "editor rejects relative addresses" 400 (nenex_editor_http_tests/status "GET" "/nenex/edit?path=relative"))]
+ tests
  ^ row[testing/case]
  [(testing/case "Nenex editor route" nenex_editor_http_tests/checks)]
