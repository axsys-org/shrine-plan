- idx
- testing

+ posting_map_tests
  + key
    \ number=nat
    ^ path
    [($x 1) 'app 'posting_sources ($u number)]
  + valid
    \ tree=mop[path pail lt_pith]
    ^ bool
    > node=mop/node[path pail lt_pith] tree .true
    = left node.l.size right node.r.size
      balanced ((le (add left right) 1) || (and (le left (mul 4 right)) (le right (mul 4 left))))
    | and (eq node.sz (add 1 (add left right)))
        (and balanced (and (posting_map_tests/valid node.l) (posting_map_tests/valid node.r)))
  + initial
    ^ myth
    % i=nat 0 tree=myth myth/new
    ^ myth
    ? (eq i 128) tree
    = number (mod (mul i 37) 128)
    | _ i.inc (idx/put_source (posting_map_tests/key number) (pails/n number) tree)
  + run
    \ mode=nat
    ^ bool
    = initial posting_map_tests/initial
    % i=nat 0 actual=myth initial expected=myth initial
    ^ bool
    ? !(equal actual.tap expected.tap) .false
    ? !(posting_map_tests/valid actual) .false
    ? (eq i 128) (eq actual.size 0)
    = number (? (eq mode 0) i (? (eq mode 1) (sub 127 i) (mod (mul i 53) 128)))
      key (posting_map_tests/key number)
    | _ i.inc (idx/delete_source key actual) (expected.del(key))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial posting_map_tests/initial
      absent (idx/delete_source (posting_map_tests/key 1000) initial)
      replaced (idx/put_source (posting_map_tests/key 64) (pails/n 999) initial)
    [(testing/nat "ascending deletion preserves postings and balance" 1 (posting_map_tests/run 0))
     (testing/nat "descending deletion preserves postings and balance" 1 (posting_map_tests/run 1))
     (testing/nat "permuted deletion preserves postings and balance" 1 (posting_map_tests/run 2))
     (testing/nat "missing source deletion preserves entries" 1 (equal initial.tap absent.tap))
     (testing/nat "replacement preserves size and balance" 1 (and (eq replaced.size 128) (posting_map_tests/valid replaced)))
     (testing/nat "replacement changes exactly the selected value" 1 (equal (replaced.get((posting_map_tests/key 64))) (maybe/some[pail] (pails/n 999))))]

+ tests
  ^ row[testing/case]
  [(testing/case "ordered posting mutation" posting_map_tests/checks)]
