- idx
- reference_index
- testing

+ search_reference_profile
  + mixed
    ^ myth
    % i=nat 0 out=myth myth/new
    ^ myth
    ? (eq i 64) out
    = number (mod (mul i 37) 64)
      value=pail
        ? (eq (mod number 3) 0) (safe 0 .x [($x 1) 'target ($u number)])
        ? (eq (mod number 3) 1) (pails/t "See [/0x1/target] twice [/0x1/target]")
        | pails/n number
    | _ i.inc (idx/put_source [($u number)] value out)
  + agrees
    ^ bool
    = before search_reference_profile/mixed
    % i=nat 0
    ^ bool
    ? (eq i 128) .true
    = after=myth
        ? (lt i 64) (idx/delete_source [($u i)] before)
        | idx/put_source [($u i)] (safe i .y [($x 1) 'new]) before
      expected (equal (reference_index/slots (maybe/some[myth] before)) (reference_index/slots (maybe/some[myth] after)))
      actual (reference_index/same_references before after)
    ? !(eq expected actual) .false
    | _ i.inc
  + tree
    ^ myth
    % i=nat 0 out=myth myth/new
    ^ myth
    ? (eq i 2048) out
    | _ i.inc (idx/put_source [($x 1) 'app 'sources ($u i)] (pails/n i) out)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = ;before search_reference_profile/tree
    ; (DeepSeq[nat] before 0)
    = ;start (Now 0)
      ;same=bool
        % i=nat 0
        ^ bool
        ? (eq i 20) .true
        = after (idx/put_source [($x 1) 'app 'sources ($u i)] (pails/n (add i 2048)) before)
          empty reference_index/new
          refs (reference_index/replace [($x 1) 'idx 'fixture] (maybe/some[myth] before) (maybe/some[myth] after) empty.into)
          signs (reference_index/signals (maybe/some[myth] before) (maybe/some[myth] after) (axal/new[sign] .none))
        ? !(and (eq refs.wyt 0) (eq signs.wyt 0)) .false
        | _ i.inc
      ;end (Now 0)
    ; (Trace ["REFERENCE-POSTING-20-NS" (sub end start)] 0)
    = original (myth/sing ['link] (safe 0 .x [($x 1) 'target])).put(['note] (pails/t "Plain text"))
      prose original.put(['link] (pails/t (str/cat_all ["Read [" (path_show [($x 1) 'target]) "]"])))
      literal original.put(['note] (pails/t "Different plain text"))
      changed original.put(['link] (safe 1 .z [($x 1) 'target]))
    [(testing/nat "non-reference posting updates preserve reverse references" 1 same)
     (testing/nat "shared-tree comparison agrees with full reference slots" 1 search_reference_profile/agrees)
     (testing/nat "literal changes preserve references" 1 (reference_index/same_references original literal))
     (testing/nat "prose and direct references retain slot identity" 1 (reference_index/same_references original prose))
     (testing/nat "reference care and version changes remain visible" 0 (reference_index/same_references original changed))]

+ tests
  ^ row[testing/case]
  [(testing/case "posting reverse-reference cost" search_reference_profile/checks)]
