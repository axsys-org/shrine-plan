- shuin_agents
- shuin_path_search

+ shuin_paths_test
  + index_counts
    ' Count headers in place. Projecting/tapping the full index would copy
    ' every posting map merely to read its cached slot count.
    \ tree=axal[tome] top=nat
    ^ [nat nat]
    = record (idx/held tree.fil top)
      slots record.fall(myth/new).size
      initial=[nat nat] [(? record.is_some 1 0) slots]
    | tree.kid_tap.fold initial
      \ total=[nat nat] [key child]
      = [records slots] total
        [below entries] (shuin_paths_test/index_counts child top)
      | [(add records below) (add slots entries)]
  + bench_path
    \ self=iota number=nat
    ^ path
    [self 'app 'search_bench ($ts (str/cat_all ["group" (nat/show (div number 10))])) ($ts (str/cat_all ["item" (nat/show number)]))]
  + bench
    \ input=json state=namespace
    ^ [namespace nat str]
    = start (nat/parse (shuin_agents/field "start" input)).fall(0)
      count (nat/parse (shuin_agents/field "count" input)).fall(1)
      mode (shuin_agents/field "mode" input)
      diffs=axal[note]
        % i=nat start out=axal[note] (axal/new[note] .none)
        ^ axal[note]
        ? (ge i (add start count)) out
        = path (shuin_paths_test/bench_path state.self i)
          title (str/cat_all [(? (eq mode "rename") "Renamed " "Study ") (nat/show i) " festival astronomy " (? (eq (mod i 7) 0) "שלום 東京" "notes")])
          record (myth/sing system_vocabulary/lede (pails/t title)).put(system_vocabulary/help (pails/t "Deterministic namespace search benchmark")).put(system_vocabulary/content (pails/t "Body text is never searched."))
          note=note (? (eq mode "delete") .cull (note/make record))
        | _ i.inc out.put(path note)
    ? (namespace/step diffs 0 0 state)
     > (./rejected why) [state 409 (iota_show why)]
     > (./accepted result)
      = next result.state
      [next 200 "Seeded"]
  + call
    \ name=str path=path extra=row[jkv]
    ^ json
    = args (json/obj (extra.cons((jkv "path" (json/str (path_show path))))))
    | json/obj [(jkv "function" (json/obj [(jkv "name" (json/str name)) (jkv "arguments" (json/str (show args)))]))]
  + invoke
    \ target=path state=namespace
    ^ json
    = declaration=path [state.self 'gov 'shuin_actions_fixture 'append]
      role=path [state.self 'gov 'shuin_actions_fixture 'note]
    | shuin_paths_test/call "grove_invoke" target
        [(jkv "action" (json/str (path_show declaration)))
         (jkv "recordVersion" (json/str (nat/show (state.case(.x target)).fall(0))))
         (jkv "publication" (json/str (nat/show (state.case(.x declaration)).fall(0))))
         (jkv "roleVersion" (json/str (nat/show (state.case(.x role)).fall(0))))
         (jkv "arguments" (json/obj []))]
  + run
    \ input=json state=namespace
    ^ [namespace nat str]
    = op (shuin_agents/field "operation" input)
      root=path [state.self 'app 'path_fixture]
      frontier=path root.weld(['transparent 'first])
      deep=path frontier.snoc('deep)
      sibling=path root.snoc('sibling)
      home=path (shuin_agents/home state.self).snoc('scope_test)
    ? (eq op "path_index_state")
      = [records entries] (shuin_paths_test/index_counts (state.local.idx.dip((namespace_search/home state.self))) state.local.top)
      | [state 200 (show (json/obj [(jkv "records" (json/num .false records)) (jkv "posting_entries" (json/num .false entries))]))]
    ? (eq op "path_index_enable")
      ?> (./ok next) (namespace_search/install state) [state 409 "Index initialization failed"]
      | [next 200 "Index ready"]
    ? (eq op "path_index_disable")
      ? (namespace/step ((axal/new[note] .none).put((namespace_search/home state.self) .cull)) 0 0 state)
       > (./accepted made) [made.state 200 "Index disabled"]
       > (./rejected _) [state 409 "Index retirement failed"]
    ? (eq op "path_bench") (shuin_paths_test/bench input state)
    ? (eq op "path_form")
      = app (shuin_agents/home state.self) schema (shuin_agents/schema state.self)
      [(shuin_agents/command (shuin_agents/change app (myth/sing schema.snoc('command) (pails/t "new")) state)) 200 "Ready"]
    ? (eq op "path_pending")
      = schema (shuin_agents/schema state.self) app (shuin_agents/home state.self)
        ui (shuin_agents/record app state)
        id (shuin_agents/field "agent" input)
      ?> (./some path) (path_parse (shuin_agents/field "path" input)) [state 400 "Invalid selection"]
      ?> (./some care) (goo_paths/care (shuin_agents/field "care" input)) [state 400 "Invalid care"]
      = reads (goo_paths/hunts [(hunt care path)])
      ?> (./ok _) (shuin_agents/validate_grants reads .false state) [state 400 "Invalid grants"]
      = change (myth/sing ['id] (pails/t id)).put(['read_dependencies] reads).put(['write_dependencies] (goo_paths/hunts []))
        queue=row[myth] (shuin_agents/pending ui schema).keep((\ row=myth !(eq row.txt_at(['id]) id))).snoc(change)
        next (shuin_agents/change app (myth/sing schema.snoc('pending) (goo_composition/items queue)) state)
      ? (shuin_agents/commit app state next)
       > (./ok next) [next 200 "Saved"]
       > (./err why) [state 409 why]
    ? (eq op "path_rename")
      [(shuin_agents/change sibling (myth/sing system_vocabulary/lede (pails/t "Renamed scope sibling")) state) 200 "Renamed"]
    ? (eq op "path_delete") [(shuin_agents/remove sibling state) 200 "Deleted"]
    ? (eq op "path_grants")
      ?> (./some target) (path_parse (shuin_agents/field "path" input)) [state 400 "Bad path"]
      = card (shuin_agents/record target state)
      [state 200 (show (json/obj [(jkv "read" (goo_paths/wire (shuin_agents/read_grants card))) (jkv "write" (goo_paths/wire (shuin_agents/write_grants card))) (jkv "status" (json/str card.txt_at(['status]))) (jkv "legacy" (json/boo !(card.has(['read_dependencies]))))]))]
    ? (eq op "path_legacy")
      = target (shuin_agents/home state.self).snoc('legacy)
        card (shuin_agents/named "Legacy" "Legacy dependency migration fixture.").put(['dependencies] (pails/ps [frontier])).put(['model] (pails/t "google/gemini-4-neon")).put(['instructions] (pails/t "Test")).put(['status] (pails/t "idle"))
      [(shuin_agents/change target card state) 200 "Legacy installed"]
    = state (shuin_agents/change root (shuin_agents/named "Scope tree" "File / Folder / Subtree fixture") state)
      state (shuin_agents/change frontier ((shuin_agents/named "Frontier record" "Nearest record through a transparent folder").put(system_vocabulary/content (pails/t "Frontier text"))) state)
      state (shuin_agents/change deep ((shuin_agents/named "Deep record" "Beyond the Folder boundary").put(system_vocabulary/content (pails/t "Deep text"))) state)
      state (shuin_agents/change sibling (shuin_agents/named "Scope sibling" "Search tooltip fixture") state)
      state=namespace
        % i=nat 0 state=namespace state
        ? (eq i 25) state
        = target root.weld(['pages ($u i)])
        | _ i.inc (shuin_agents/change target (shuin_agents/named (str/cat_all ["Page item " (nat/show i)]) "Pagination fixture") state)
      x (hunt .x root) y (hunt .y root) z (hunt .z root)
      new=path root.weld(['transparent 'new]) blocked frontier.snoc('new)
    ; (shuin_wallet/require (and (goo_paths/covers x root state) !(goo_paths/covers x frontier state)) "File grant overreach")
    ; (shuin_wallet/require (and (goo_paths/covers y frontier state) !(goo_paths/covers y deep state)) "Folder frontier incorrect")
    ; (shuin_wallet/require (and (goo_paths/covers y new state) !(goo_paths/covers y blocked state)) "Folder creation crossed a record barrier")
    ; (shuin_wallet/require (goo_paths/covers z deep state) "Subtree did not reach deep record")
    = projection=row[path] (sovereign_care .y root state).tap.map((\ [relative _] root.weld(relative)))
    ; (shuin_wallet/require (and (projection.has(frontier)) !(projection.has(deep))) "Test fixture disagrees with Shrine frontier")
    = agent=myth (myth/sing ['read_dependencies] (goo_paths/hunts [x])).put(['write_dependencies] (goo_paths/hunts [y]))
    ; (shuin_wallet/require (shuin_agents/readable home agent frontier state) "Write must imply read")
    ; (shuin_wallet/require !(shuin_agents/writable home agent deep state) "Write grant overreach")
    ; (shuin_wallet/require !(shuin_agents/writable home agent (shuin_agents/home state.self) state) "Runner record is writable")
    ; (shuin_wallet/require !(shuin_agents/writable home agent ['sys 'lede] state) "Foreign namespace is writable")
    ; (shuin_wallet/require (shuin_agents/writable home agent home.weld(['workspace 'note]) state) "Implicit workspace write was rejected")
    ; (shuin_wallet/require !(shuin_agents/writable home agent home.weld(['turns 'note]) state) "Implicit workspace access escaped into runner records")
    = default (shuin_agents/tool home agent (shuin_paths_test/call "namespace_read" root []) state)
      [unchanged text] default
    ?> (./ok exact) (namespace_text/encode_care x state) [state 500 "File export failed"]
    ; (shuin_wallet/require (eq text exact) "Default read broadened beyond File")
    = excessive (Try (shuin_agents/tool home agent (shuin_paths_test/call "namespace_read" root [(jkv "care" (json/str "z"))])) state)
    ; (shuin_wallet/require !(either/is_ok excessive) "Read escaped grant frontier")
    = write_fields=row[jkv] [(jkv "slot" (json/str "/sys/content")) (jkv "type" (json/str "text")) (jkv "value" (json/str "created"))]
      allowed (Try (shuin_agents/tool home agent (shuin_paths_test/call "namespace_write" new write_fields)) state)
      denied (Try (shuin_agents/tool home agent (shuin_paths_test/call "namespace_write" blocked write_fields)) state)
    ; (shuin_wallet/require (and (either/is_ok allowed) !(either/is_ok denied)) "Tool write creation boundary incorrect")
    = invoked (Try (shuin_agents/tool home agent (shuin_paths_test/invoke frontier state)) state)
      denied (Try (shuin_agents/tool home agent (shuin_paths_test/invoke deep state)) state)
    ; (shuin_wallet/require (and (either/is_ok invoked) !(either/is_ok denied)) "Grove invocation escaped Folder grants or rejected a granted receiver")
    = read_only=myth agent.put(['write_dependencies] (goo_paths/hunts [])).put(['read_dependencies] (goo_paths/hunts [z]))
      denied (Try (shuin_agents/tool home read_only (shuin_paths_test/invoke frontier state)) state)
    ; (shuin_wallet/require !(either/is_ok denied) "Read grants authorized Grove invocation")
    = legacy=myth (myth/sing ['dependencies] (pails/ps [root]))
    ; (shuin_wallet/require (and (shuin_agents/readable home legacy deep state) !(shuin_agents/writable home legacy deep state)) "Legacy grants must be read-only Subtree")
    = state (shuin_agents/change root.snoc('unsupported) (myth/sing ['bad_slot] (pails/code shuin_agents/home)) state)
      unsupported (shuin_agents/validate_grants (goo_paths/hunts [(hunt .x root.snoc('unsupported))]) .false state)
    ? unsupported
     > (./ok _) [state 500 "Unsupported value accepted"]
     > (./err why)
      [state 200 (show (json/obj [(jkv "checks" (json/str "passed")) (jkv "diagnostic" (json/str why)) (jkv "root" (json/str (path_show root))) (jkv "frontier" (json/str (path_show frontier))) (jkv "structural" (json/str (path_show root.snoc('transparent))))]))]
