- tests/search_index_support [at=fixture]
- stdlib/base

+ shuin_paths_test
  + index_counts
    ' Count headers in place. Projecting/tapping the full index would copy
    ' every posting map merely to read its cached slot count.
    \ tree=axal[tome] top=nat
    ^ [nat nat]
    = record (idx/held tree.fil top)
      slots record.fall(myth/new).size
      initial=[nat nat] [(? record.is_some 1 0) slots]
    | tree.kid_tap.fold initial
      \ total=[nat nat] [key child]
      = [records slots] total
        [below entries] (shuin_paths_test/index_counts child top)
      | [(add records below) (add slots entries)]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state fixture/search_index_tests/seeded
      home (namespace_search/home state.self)
      [records entries] (shuin_paths_test/index_counts (state.local.idx.dip(home)) state.local.top)
      full (idx/live home state.local).tap
      slots
        | full.fold 0
          \ total=nat [key card]
          | add total card.size
    [(testing/nat "header count agrees with materialized index" full.len records)
     (testing/nat "cached slots agree with materialized index" slots entries)]

+ tests
  ^ row[testing/case]
  [(testing/case "index size" shuin_paths_test/checks)]
