#import lede=sys/lede
#import text=lib/grove/types/text

subject =
  @role
  lede: text

view_with_topos =
  @view
  #on ; %/subject
  #for ; /sys/slot/commentary_invalid_view
  book => commentary(book.address) { col { text("Fixture") } }

plain_view =
  @view
  #on ; %/subject
  #for ; /sys/slot/commentary_plain_view
  book => text("Ordinary presentation")

pane_without_topos =
  @pane
  #on ; %/subject
  #for ; /sys/slot/commentary_plain_pane
  book => text("Pane without a commenting topos")

pane_with_unbound_port =
  @pane
  #on ; %/subject
  #for ; /sys/slot/commentary_port_pane
  #port ; /selection
  book => commentary(book.address) { col { text("Fixture") } }

composed_reader =
  @pane
  #on ; %/subject
  #for ; /sys/slot/commentary_composed_fixture
  book => commentary(book.address) {
    columns(tracks=[210 fr(1)]) {
      row {
        col {
          reading_value("title", role="heading")
          text("Folio index", role="label")
          reading_index("pages")
          text("Layers", role="label")
          reading_index("layers")
          text("Passages", role="label")
          reading_index("passages")
        }
        col {
          reading_value("pageTitle", role="title")
          reading_value("description", role="caption")
          anchored_columns(tracks=[fr(2) fr(3) fr(1)]) {
            reading_stream("glosses", side="left", label="Glosses") {
              reading_value("title", role="caption")
              reading_value("primary", role="gloss_primary", max=180)
              reading_value("secondary", role="gloss_secondary", max=220)
            }
            reading_stream("passages", label="Text") {
              reading_value("title", role="caption")
              reading_value("primary", role="reading_primary")
              reading_value("secondary", role="reading_secondary")
            }
            reading_stream("glosses", side="right", label="Glosses") {
              reading_value("title", role="caption")
              reading_value("primary", role="gloss_primary", max=180)
              reading_value("secondary", role="gloss_secondary", max=220)
            }
          }
          text("Select a phrase in either language, or choose a gloss.", role="caption")
          reading_when("selection") {
            reading_value("quote", role="reading_caption")
            columns(tracks=[fr(1) 248]) {
              row {
                input(/0x11/gov/shuin_commentary/draft, kind = .text, label="Your gloss", multiline = 1, key="draft")
                col {
                  operation("save", operation="add", label="Publish marginal note", significance="significant")
                  operation("reply", operation="reply", label="Reply to gloss")
                }
              }
            }
            row {
              operation("left", operation="left", label="Left margin")
              operation("right", operation="right", label="Right margin")
              operation("discard", operation="discard", label="Discard draft")
            }
          }
          reading_value("status", role="caption")
          reading_when("unresolved") {
            operation("retry", operation="retry", label="Retry original request")
          }
        }
      }
    }
  }
