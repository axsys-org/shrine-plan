#import text=lib/grove/types/text
#import lede=sys/lede
#import help=sys/help
#import content=sys/content

note =
  @role
  content: text

append =
  @action
  #meta ;
    lede: "Append marker"
    help: "Append one marker to this note."
  #on ; %/note
  ! foil
  \ current=%/note
  ^ %/note
  | current.set_content(current.content.cat("!"))

rename =
  @action
  #meta ;
    lede: "Replace note text"
    help: "Replace the content using a typed text value."
  #on ; %/note
  content: text
  ! foil
  \ content=text current=%/note
  ^ %/note
  | current.set_content(content)

"/one" =
  @tree
  lede: "First action note"
  content: "first"

"/two" =
  @tree
  lede: "Second action note"
  content: "second"
