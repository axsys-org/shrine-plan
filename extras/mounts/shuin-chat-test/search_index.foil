- namespace_search
- tests/idx [at=kernel]
- tests/namespace [at=fixture]
- stdlib/base

' Full scans exist only in this test oracle, never in the HTTP adapter.
+ search_index_tests
  + allow
    \ target=path state=namespace
    ^ bool
    .true
  + all
    \ query=str state=namespace
    ^ row[path]
    = frozen (namespace_search/freeze state)
    % cursor=namespace_search/cursor (namespace_search/cursor 0 .none 0 .none) out=row[path] [] fuel=nat 1000
    ^ row[path]
    ? !(fuel) []
    = page (namespace_search/query query cursor frozen search_index_tests/allow state)
      out out.weld(page.items.map((\ doc=namespace_search/document doc.p)))
    ? !(page.more) out
    | _ page.cursor out fuel.dec
  + oracle
    \ query=str state=namespace
    ^ row[path]
    = root=path [state.self 'app]
      sources (idx/live root state.local).tap.map((\ [relative card] [root.weld(relative) card]))
      paths=axal[nat]
        % rest=row[[path myth]] sources out=axal[nat] (axal/new[nat] .none)
        ^ axal[nat]
        ? !(rest.len) out
        = [source card] rest.at(0)
        ? (idx/inside source state.local state.local) (_ rest.drop(1) out)
        = out=axal[nat]
            % depth=nat 2 out=axal[nat] out
            ^ axal[nat]
            ? (gt depth source.len) out
            | _ depth.inc out.put(source.take(depth) 1)
        | _ rest.drop(1) out
      matches=row[[nat path]]
        % rest=row[[path nat]] paths.tap out=row[[nat path]] []
        ^ row[[nat path]]
        ? !(rest.len) out
        = [target _] rest.at(0)
          doc (namespace_search/document_at target (sovereign_care_value .x target state).fil)
          title_prefix (eq query doc.title_lower.slice(0 query.len))
          path_prefix (eq query doc.path_lower.slice(0 query.len))
          exact ((eq query doc.title_lower) || (eq query doc.path_lower))
          rank (? !(query.len) 1 (? exact 0 (? (title_prefix || path_prefix) 1 2)))
        | _ rest.drop(1) (? (eq rank 2) out out.snoc([rank target]))
      before
        \ a=[nat path] b=[nat path]
        ^ bool
        = [ar ap] a [br bp] b
        ? (eq ar br) !(lt_pith bp ap)
        | lt ar br
    = sorted
        | matches.stream.sort_by before
    | sorted.row.map((\ [rank target] target))
  + seeded
    ^ namespace
    = initial fixture/namespace_tests/initial
      notes=axal[note]
        % i=nat 0 out=axal[note] (axal/new[note] .none)
        ^ axal[note]
        ? (eq i 65) out
        = target=path [initial.self 'app 'corpus ($u (div i 10)) ($u i)]
          title=str (? (eq i 5) "/" (str/cat_all ["alpha festival " (nat/show i) " שלום 東京"]))
        | _ i.inc out.put(target (note/make (myth/sing system_vocabulary/lede (pails/t title))))
      notes notes.put([initial.self 'gov 'outside] (note/make (myth/sing system_vocabulary/lede (pails/t "alpha outside app"))))
      notes notes.put([initial.self 'application 'outside] (note/make (myth/sing system_vocabulary/lede (pails/t "alpha lookalike"))))
      notes notes.put([initial.self 'app 'unicode] (note/make (myth/sing system_vocabulary/lede (pails/t "שלום 東京"))))
      notes notes.put([initial.self 'app 'corpus ($ts "opaque/module") 'leaf] (note/make (myth/sing system_vocabulary/lede (pails/t "Opaque source"))))
    ?> (./accepted made) (namespace/step notes 0 0 initial) initial
    ?> (./ok next) (namespace_search/install made.state) initial
    next
  + old_filing
    \ source=path card=myth
    ^ myth
    | myth/sing ['gram ($ts "obsolete") ($u 0)] (pails/n 1)
  + legacy_index
    \ state=namespace
    ^ namespace
    = declaration namespace_search/declaration
      old ((declaration.put(['sys 'edition] (pails/n 4))).put(['sys 'tack] (hunt .z []))).put(['sys 'limb] (wing search_index_tests/old_filing))
    | kernel/idx_tests/make (namespace_search/home state.self) old state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state search_index_tests/seeded
      declaration namespace_search/declaration
      queries=row[str] ["alpha festival 23 שלום 東京" "alpha" "alpha festival 23" "pha fest" "apfsv" "שלום" "東京" "nothing matches" "alpha festival 999" "festival 64 שלום" "" "/" "/0x1/app/corpus" "opaque" "v1/x:01"]
      compared
        | queries.snoc((namespace_search/document_at [state.self 'app 'corpus] .none).path_lower).map
          \ query=str
          | testing/same[row[path]] (str/cat_all ["scan oracle and complete pagination: " query])
              (\ paths=row[path] (str/cat_all (paths.map((\ path=path (namespace_search/document_at path .none).key)))))
              (search_index_tests/oracle query state) (search_index_tests/all query state)
      target=path [state.self 'app 'corpus ($u 6) ($u 64)]
      content_only
        = prior (idx/record_at target state.local).fall(myth/new)
        | kernel/idx_tests/make target (prior.put(system_vocabulary/content (pails/t "Body-only edit"))) state
      renamed (kernel/idx_tests/make target (myth/sing system_vocabulary/lede (pails/t "renamed")) state)
      deleted (kernel/idx_tests/write [state.self 'app 'corpus ($u 6)] .cull renamed)
      replayed=bool
        = card (myth/sing system_vocabulary/lede (pails/t "renamed"))
          diff ((axal/new[note] .none).put(target (note/make card)))
          event (namespace_event state.system (pin diff) state.local.top 0 0)
        ?> (./accepted made) (state.replay(event)) .false
        | equal[namespace] made.state renamed
      replacement
        = shared (fixture/namespace_tests/seed ['sys 'app 'extra] 99 (unpin state.system).state)
        | state.set_system((pin (system_publication 2 shared (system_publication/assigned shared))))
      frozen (namespace_search/freeze state)
      leaf_query (namespace_search/document_at [state.self 'app 'corpus ($u 2) ($u 23)] .none).path_lower
      leaf_page (namespace_search/query leaf_query (namespace_search/cursor 0 .none 0 .none) frozen search_index_tests/allow state)
      long_path=path [state.self 'app ($ts "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz")]
      long_file (namespace_search/file long_path (myth/sing system_vocabulary/lede (pails/t "A long file name")))
      outside (kernel/idx_tests/make [state.self 'gov 'outside] (myth/sing system_vocabulary/lede (pails/t "changed outside app")) state)
      root_named (kernel/idx_tests/make [state.self 'app] (myth/sing system_vocabulary/lede (pails/t "Applications")) state)
      app_deleted (kernel/idx_tests/write [state.self 'app] .cull state)
      legacy (search_index_tests/legacy_index state)
      upgraded
        ?> (./ok result) (namespace_search/install legacy) legacy
        result
    | compared.weld
      [(testing/nat "declaration walks app only" 1
        (equal[maybe[pail]] declaration.get(['sys 'tack]) (./some (hunt .z ['app]))))
       (testing/nat "empty listing never escapes app" 1
        ((search_index_tests/all "" state).all((\ target=path (pith_prefix [state.self 'app] target)))))
       (testing/nat "structural app root is searchable" 1
        ((search_index_tests/all "" state).any((\ target=path (equal[path] target [state.self 'app])))))
       (testing/nat "app root title is searchable" 1
        (equal[row[path]] (search_index_tests/all "applications" root_named) [[state.self 'app]]))
       (testing/nat "sibling title does not leak into search" 0 (search_index_tests/all "alpha outside" state).len)
       (testing/nat "app prefix lookalike is excluded" 0 (search_index_tests/all "alpha lookalike" state).len)
       (testing/nat "direct filing outside app is empty" 0
        (namespace_search/file [state.self 'gov 'outside] myth/new).size)
       (testing/nat "ancestor filing is empty" 0 (namespace_search/file [state.self] myth/new).size)
       (testing/nat "outside edits preserve index revision" 1
        (equal[maybe[nat]] (state.case(.z (namespace_search/home state.self))) (outside.case(.z (namespace_search/home state.self)))))
       (testing/nat "system projection is empty" 0 frozen.tree.wyt)
       (testing/nat "removing all app records removes structural app" 0 (search_index_tests/all "" app_deleted).len)
       (testing/nat "exact leaf paths do not scan sibling folders" 1 (le leaf_page.candidates 2))
       (testing/nat "long names do not materialize every address prefix" 1 (le long_file.size 64))
       (testing/nat "legacy fixture contains obsolete postings" 1
        (gt (namespace_search/record ['gram ($ts "obsolete") ($u 0)] legacy).size 0))
       (testing/nat "edition upgrade removes obsolete postings" 0
        (namespace_search/record ['gram ($ts "obsolete") ($u 0)] upgraded).size)
       (testing/nat "edition upgrade rebuilds complete results" 1
        (equal (search_index_tests/all "alpha" state) (search_index_tests/all "alpha" upgraded)))
       (testing/nat "substring-only titles do not match" 0 (search_index_tests/all "pha fest" state).len)
       (testing/nat "subsequence-only titles do not match" 0 (search_index_tests/all "apfsv" state).len)
       (testing/nat "short prefixes have direct postings" 1
        ((namespace_search/posting 'title_prefix "alpha fe" frozen state).any((\ card=myth (gt card.size 0)))))
       (testing/nat "long title prefix keys are not materialized" 1
        ((namespace_search/posting 'title_prefix "alpha festival 23" frozen state).all((\ card=myth (eq card.size 0)))))
       (testing/nat "path prefixes have parent-scoped postings" 1
        ((namespace_search/path_posting (namespace_search/document_at [state.self 'app 'corpus] .none).path_lower frozen state).any((\ card=myth (gt card.size 0)))))
       (testing/nat "character sequence postings are absent" 1
        ((namespace_search/posting 'gram "alp" frozen state).all((\ card=myth (eq card.size 0)))))
       (testing/nat "body-only edits preserve the search index revision" 1
        (equal[maybe[nat]] (state.case(.z (namespace_search/home state.self))) (content_only.case(.z (namespace_search/home state.self)))))
       (testing/nat "replay reproduces indexed state" 1 replayed)
       (testing/nat "replacement system publication is excluded" 0 (search_index_tests/all "/sys/app/extra" replacement).len)
       (testing/nat "original system publication is excluded" 0 (search_index_tests/all "/sys/app/extra" state).len)
       (testing/nat "rename updates title" 1 (equal[row[path]] (search_index_tests/all "renamed" renamed) [target]))
       (testing/nat "delete removes last folder contributions" 1 (equal[row[path]] (search_index_tests/all "" deleted) (search_index_tests/oracle "" deleted)))
       (testing/nat "system publication is immutable" 1 (equal frozen.publication state.system))]

+ tests
  ^ row[testing/case]
  [(testing/case "namespace search indexes" search_index_tests/checks)]
