- tests/search_index_support [at=fixture]
- tests/idx [at=kernel]
- stdlib/base

+ profile
  \ ignored=unit
  ^ row[testing/check]
  = before fixture/search_index_tests/seeded
    frozen (namespace_search/freeze before)
    prior (fixture/search_index_tests/all "alpha" before)
    held (pin before)
    projected (pin frozen)
  ; (DeepSeq[nat] prior 0)
  ; (Ice held)
  ; (Ice projected)
  = after (unpin held)
    renamed (kernel/idx_tests/make [after.self 'app 'corpus ($u 2) ($u 23)] (myth/sing system_vocabulary/lede (pails/t "Stored rename")) after)
  [(testing/nat "storing namespace pins preserves state" 1 (equal before after))
   (testing/nat "stored index preserves complete ordered results" 1 (equal prior (fixture/search_index_tests/all "alpha" after)))
   (testing/nat "stored projection preserves identity" 1 (equal frozen (unpin projected)))
   (testing/nat "commits update a stored index" 1 (fixture/search_index_tests/all "stored rename" renamed).len)]

+ tests
  ^ row[testing/case]
  [(testing/case "Store-resident search pins" profile)]
