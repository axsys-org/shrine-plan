- namespace_search
- tests/search_index_support [at=fixture]
- testing

+ profile
  \ ignored=unit
  ^ row[testing/check]
  = state fixture/search_index_tests/seeded
    frozen (namespace_search/freeze state)
  ; (DeepSeq[nat] state 0)
  ; (DeepSeq[nat] frozen 0)
  = queries=row[str] ["alpha festival 23 שלום 東京" "alpha" "pha fest" "apfsv" "nothing matches" "" "שלום"]
  | queries.map
    \ query=str
    = ;start (Now 0)
      page (namespace_search/query query (namespace_search/cursor 0 .none 0 .none) frozen fixture/search_index_tests/allow state)
    ; (DeepSeq[nat] page 0)
    ; (Trace ["QUERY-PROFILE" query (sub (Now 0) start) page.items.len page.candidates page.postings page.limited] 0)
    | testing/nat query 1 (le page.items.len 20)

+ tests
  ^ row[testing/case]
  [(testing/case "Search engine query profile" profile)]
