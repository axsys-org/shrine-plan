- shuin_agents_test
- shuin_commentary
- shuin_scenes
- shuin_navigation
- http_foot

' Only mounted by --test-fixtures in a disposable verification world.
' These two fixed subjects are restored after the lifetime acceptance test.
+ shuin_lifetime_test
  + saved
    : card=myth
  + seed_namespace
    \ state=namespace
    ^ either[str namespace]
    = target=path [state.self 'app 'namespace_fixture 'record]
      record ((list/range 0 45).fold(myth/new (\ card=myth n=nat (card.put([($u n)] (pails/n n))))))
      record record.put(['long] (pails/t (str/repeat 8193 "a"))).put(['reference] (pails/p ['sys]))
      record record.put(['opaque] (shuin_lifetime_test/saved myth/new))
    | shuin_navigation/change target (writ/make record) state
  + mutate
    \ operation=str state=namespace
    ^ either[str namespace]
    ? (row/has[str] operation ["commentary_change" "commentary_restore"])
      = target=path [state.self 'app 'talmud 'pages 'berakhot_2a 'p14]
        archive=path [state.self 'app 'shuin_lifetime_test 'passage]
        schema (shuin_commentary/schema state.self).snoc('passage)
      ? (eq operation "commentary_change")
        < card (shuin_commentary/record target state)
        < passage (shuin_commentary/passage_at target state)
        < next (shuin_navigation/change archive (writ/make (myth/sing ['saved] (shuin_lifetime_test/saved card))) state)
        = changed passage.set_secondary((str/cat_all [passage.secondary " Changed for the acceptance check."]))
        | shuin_navigation/change target (writ/poke (myth/sing schema changed)) next
      < card (shuin_commentary/record archive state)
      ?> (./some held) card.get(['saved]) (./err "No saved passage")
      ?> saved=shuin_lifetime_test/saved held (./err "Invalid saved passage")
      < next (shuin_navigation/change target (writ/poke saved.card) state)
      | shuin_navigation/change archive .cull next
    ? (row/has[str] operation ["scene_add" "scene_rename" "scene_remove" "scene_reset" "scene_invalid"])
      = home (shuin_scenes/home state.self) schema (shuin_scenes/schema state.self)
        extra home.snoc('laboratory) browser home.snoc('browse)
      ? (eq operation "scene_add")
        = card (shuin_scenes/scene state.self "Laboratory" "An arbitrary scene declared only in the namespace." "record" 5 [state.self 'app 'shuin_wallet] [state.self 'gov 'shuin_wallet 'wallet])
          browse (shuin_scenes/scene state.self "Records" "An alternate explorer host." "explorer" 40 [] [])
        < next (shuin_navigation/change extra (writ/make card) state)
        < next (shuin_navigation/change browser (writ/make browse) next)
        | shuin_navigation/change home (writ/poke ((myth/sing schema.snoc('default) (pails/p extra)).put(schema.snoc('follow) (pails/p browser)))) next
      ? (eq operation "scene_rename")
        | shuin_navigation/change extra (writ/poke ((myth/sing system_vocabulary/lede (pails/t "Renamed laboratory")).put(schema.snoc('order) (pails/n 50)))) state
      ? (eq operation "scene_invalid")
        | shuin_navigation/change home (writ/poke (myth/sing schema.snoc('follow) (pails/p extra))) state
      < next (shuin_navigation/change home (writ/poke ((myth/sing schema.snoc('default) (pails/p home.snoc('chat))).put(schema.snoc('follow) (pails/p home.snoc('namespace))))) state)
      < next (shuin_navigation/change extra .cull next)
      ? (eq operation "scene_remove") (./ok next)
      | shuin_navigation/change browser .cull next
    ? (eq operation "seed_actions")
      = home=path [state.self 'app 'shuin_actions_fixture]
        root (myth/sing system_vocabulary/lede (pails/t "Action examples"))
        one (myth/sing system_vocabulary/content (pails/t "first")).put(system_vocabulary/lede (pails/t "First action note"))
        two (myth/sing system_vocabulary/content (pails/t "second")).put(system_vocabulary/lede (pails/t "Second action note"))
      < first (shuin_navigation/change home (writ/make root) state)
      < next (shuin_navigation/change home.snoc('one) (writ/make one) first)
      | shuin_navigation/change home.snoc('two) (writ/make two) next
    ? (eq operation "seed_namespace") (shuin_lifetime_test/seed_namespace state)
    = channel (row/has[str] operation ["remove_channel" "restore_channel"])
      target=path (? channel [state.self 'app 'shuin_chat 'planning] [state.self 'app 'shuin_chat 'festival 'welcome])
      archive=path [state.self 'app 'shuin_lifetime_test (? channel 'channel 'thread)]
    ? (row/has[str] operation ["remove_channel" "remove_thread"])
      ?> (./some card) (sovereign_care .x target state).fil (./err "Fixture already removed")
      < next (shuin_navigation/change archive (writ/make (myth/sing ['saved] (shuin_lifetime_test/saved card))) state)
      | shuin_navigation/change target .cull next
    ?> (./some card) (sovereign_care .x archive state).fil (./err "No saved fixture")
    ?> (./some held) card.get(['saved]) (./err "No saved fixture")
    ?> saved=shuin_lifetime_test/saved held (./err "Invalid saved fixture")
    < next (shuin_navigation/change target (writ/make saved.card) state)
    | shuin_navigation/change archive .cull next
  + run
    \ operation=str state=namespace
    ^ [namespace nat str]
    ? (eq operation "menu_values")
      = values=row[nat] [(shuin_commentary/gematria "שלום") (shuin_commentary/gematria "תּוֹרָה") (shuin_commentary/gematria "ךםןףץ") (shuin_commentary/gematria "English 123")]
      ? (equal values [376 611 280 0]) [state 200 "ok"]
      [state 409 "Gematria reference values failed"]
    ? (shuin_lifetime_test/mutate operation state)
     > (./err why) [state 409 why]
     > (./ok next) [next 200 "ok"]
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
        ? (eq request.body.slice(0 1) "{") (./transact (shuin_agents_test/run request.body))
        ? !(row/has[str] request.body ["menu_values" "remove_thread" "restore_thread" "remove_channel" "restore_channel" "seed_namespace" "seed_actions" "scene_add" "scene_rename" "scene_remove" "scene_reset" "scene_invalid" "commentary_change" "commentary_restore"])
          | ./reply (http_driver/response 400 "Unknown fixture operation")
        | ./transact (shuin_lifetime_test/run request.body)
    | http_foot/add_routes [(http_foot/route "/shuin-test" plan)] http_foot/empty
