- namespace_search
- stdlib/base

' Isolate textual iota ordering: same input sizes, first-byte vs late mismatch.
' The numeric suffix changes per iteration so comparisons are not one shared thunk.
+ compare_profile
  + run
    \ common=str early=bool
    ^ nat
    % i=nat 0 total=nat 0
    ^ nat
    ? (eq i 1000) total
    = suffix (nat/show i)
      a (? early (str/cat_all ["a" common suffix]) (str/cat_all [common "a" suffix]))
      b (? early (str/cat_all ["b" common suffix]) (str/cat_all [common "b" suffix]))
    | _ i.inc (add total (lt_iota ($ts a) ($ts b)))
  + measure
    \ common=str early=bool
    ^ testing/check
    = ;started (Now 0)
      result (compare_profile/run common early)
    ; (DeepSeq[nat] result 0)
    = ;ended (Now 0)
    ; (Trace ["PROFILE-COMPARE" (nat/show common.len) (nat/show early) (nat/show (sub ended started))] 0)
    | testing/nat (str/cat_all ["comparison count " (nat/show common.len) " early=" (nat/show early)]) 1000 result
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = prefixes=row[str] ["xxxxxxxx" "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" "" ""]
    | prefixes.fold []
      \ out common
      | out.snoc((compare_profile/measure common .true)).snoc((compare_profile/measure common .false))

+ tests
  ^ row[testing/case]
  [(testing/case "Text path comparison profile" compare_profile/checks)]
