- namespace_search
- testing

+ profile
  \ ignored=unit
  ^ row[testing/check]
  = card (myth/sing system_vocabulary/lede (pails/t "Study 5000 festival astronomy notes"))
  ; (DeepSeq[nat] card 0)
  ; (Trace ["PROFILE-START" (Now 0)] 0)
  = one (namespace_search/file [($x 17) 'app 'search_bench 'group500 'item5000] card)
  ; (DeepSeq[nat] one 0)
  ; (Trace ["PROFILE-ONE" one.size (Now 0)] 0)
  = many=row[pin[myth]]
      % i=nat 0 out=row[pin[myth]] []
      ^ row[pin[myth]]
      ? (eq i 100) out
      = name=path [($x 17) 'app 'search_bench ($u (div i 10)) ($u i)]
      | _ i.inc out.snoc((pin (namespace_search/file name card)))
  ; (DeepSeq[nat] many 0)
  ; (Trace ["PROFILE-HUNDRED" (Now 0)] 0)
  | [(testing/nat "100 filings" 100 many.len)]

+ tests
  ^ row[testing/case]
  [(testing/case "Search filing profile" profile)]
