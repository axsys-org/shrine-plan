- shuin_workbench_test
- shuin_paths_test
- shuin_agents
- shuin_commentary
- stdlib/runtime

' Disposable fixture only: exercise the real actor through namespace commands.
+ shuin_agents_test
  + specimen
    : label=str optional=maybe[str] choice=either[str nat] items=row[[str nat]] table=mop[nat str lt] chain=list[str]
  + executable
    : label=str callback={\ nat}nat
  + paths
    ' Only the legacy test harness accepts newline-separated fixture arguments.
    \ text=str self=iota
    ^ row[path]
    | ((str/split_byte 10 text).keep((\ line line.len))).map((\ line (path_parse line).fall([])))
  + leaves
    \ tree=rex children=row[row[json]]
    ^ row[json]
    = own
        ? tree
         > (./leaf span shape text)
          [(json/obj [(jkv "kind" (json/str tree.leaf_kind.fall(""))) (jkv "text" (json/str text)) (jkv "error" (json/str tree.leaf_error.fall("")))])]
        []
    | children.fold own (\ out=row[json] kids=row[json] out.weld(kids))
  + commentary_samples
    \ self=iota text=str
    ^ row[pail]
    = root=path [self 'app 'talmud]
      passage root.weld(['pages 'berakhot_2a 'p01])
      anchor (shuin_commentary/anchor passage 3 12345678901234567890 "primary" 1 7 text)
    [(shuin_commentary/library [root.weld(['pages 'berakhot_2a])] [root.weld(['layers 'rashi])] root.snoc('glosses) "rtl")
     (shuin_commentary/page [passage] text)
     (shuin_commentary/passage text text text)
     anchor
     (shuin_commentary/gloss anchor root.weld(['layers 'rashi]) "left" text text [] text)]
  + run
    \ source=str state=namespace
    ^ [namespace nat str]
    = input (shuin_agents/json source) op (shuin_agents/field "operation" input)
      home (shuin_agents/home state.self) schema (shuin_agents/schema state.self)
      name (shuin_agents/field "agent" input)
      target (path_parse (str/cat_all [(path_show home) "/" name])).fall(home)
    ? (eq op.slice(0 10) "workbench_") (shuin_workbench_test/run input state)
    ? (eq op.slice(0 5) "path_") (shuin_paths_test/run input state)
    ? (eq op "stencil_retry")
      = turn=path (row/snoc[iota] ($u 2) (row/snoc[iota] 'turns target))
        request=path [state.self 'io 'http 'outbound target.at(target.len.dec) ($u 2)]
        job (json/obj [(jkv "agent" (json/str (path_show target))) (jkv "turn" (json/str (path_show turn))) (jkv "request" (json/str (path_show request)))])
        response (shuin_agents/record request state)
        [next status body] (shuin_agents/finish job response state)
      [next status body]
    ? (eq op "stencil_tool")
      = call (shuin_wallet/get "call" input)
        root (path_parse (shuin_agents/field "grant" input)).fall([])
        care (goo_paths/care (shuin_agents/field "care" input)).fall(.x)
        reads (goo_paths/hunts [(hunt .z root)])
        writes (goo_paths/hunts (? (eq (shuin_agents/field "care" input) "none") [] [(hunt care root)]))
        agent (myth/sing ['read_dependencies] reads).put(['write_dependencies] writes)
        result (Try (shuin_agents/tool_at 1795197600 home.snoc('stencil_fixture) agent call) state)
      ? result
       > (./ok result)
        = [next text] result
        [next 200 text]
       > (./err why) [state 409 (shuin_agents/failure why)]
    ? (eq op "stencil_inspect")
      = root (path_parse (shuin_agents/field "path" input)).fall([])
        role (shuin_agents/record [state.self 'gov 'shuin_chat 'message] state)
        contract=lash
          ?> (./some held) role.get(system_vocabulary/grove/role_contract) lash/new
          ?> contract=lash held lash/new
          contract
        entries
          | (sovereign_care .z root state).tap.map
          \ [relative card]
          | json/obj [(jkv "path" (json/str (path_show root.weld(relative))))
              (jkv "content" (json/str card.txt_at(system_vocabulary/content)))
              (jkv "author" (json/str card.txt_at(system_vocabulary/author)))
              (jkv "now" (json/num .false card.nat_at(system_vocabulary/now 0)))
              (jkv "message" (json/boo !(maybe/is_some (fit_check card.put(system_vocabulary/lash contract)))))]
      [state 200 (show (json/arr entries))]
    ? (eq op "http_guard")
      = request=path [state.self 'io 'http 'outbound 'credential_guard]
        card (namespace_http/request "http://127.0.0.1:8342/wrong-endpoint" "{}" "openrouter")
      [(shuin_agents/change request card state) 200 "Queued credential guard probe"]
    ? (eq op "http_state")
      = [status body] (namespace_http/read [state.self 'io 'http 'outbound 'credential_guard] state)
      [state status body]
    ? (eq op "queue")
      = card (myth/sing (row/snoc[iota] 'agent_id schema) (pails/t name)).put((row/snoc[iota] 'draft schema) (pails/t (shuin_agents/field "task" input))).put((row/snoc[iota] 'read_dependencies schema) (goo_paths/hunts ((shuin_agents_test/paths (shuin_agents/field "dependencies" input) state.self).map((\ path (hunt .z path)))))).put((row/snoc[iota] 'write_dependencies schema) (goo_paths/hunts ((shuin_agents_test/paths (shuin_agents/field "writes" input) state.self).map((\ path (hunt .z path)))))).put((row/snoc[iota] 'command schema) (pails/t "send"))
      [(shuin_agents/change home card state) 200 "Queued"]
    ? (eq op "arrive")
      = item (row/snoc[iota] 'arriving (row/snoc[iota] 'inbox target))
      = first (row/snoc[iota] ($u 1) (row/snoc[iota] 'inbox target))
        next (shuin_agents/change first (myth/sing system_vocabulary/content (pails/t "Edited while the provider was working.")) state)
      [(shuin_agents/change item (myth/sing system_vocabulary/content (pails/t "An item that arrived during HTTP.")) next) 200 "Arrived"]
    ? (eq op "export")
      ?> (./some root) (path_parse (shuin_agents/field "path" input)) [state 400 "Invalid path"]
      ? (namespace_text/encode root state)
       > (./ok text) [state 200 text]
       > (./err why) [state 409 why]
    ? (eq op "codec_generic")
      = text (str/from_atom (nat/parse (shuin_agents/field "atom" input)).fall(0))
        expected
          ? (eq (shuin_agents/field "variant" input) "empty")
            (shuin_agents_test/specimen text .none (./err text) [] (mop/empty) .nil)
          (shuin_agents_test/specimen text (./some text) (./ok 12345678901234567890) [[text 42] ["" 0]] (mop/sing[nat str lt] 7 text) (list/cons[str] text .nil))
      ? (namespace_text/value state [($x 999)] expected)
       > (./err why) [state 409 why]
       > (./ok literal)
        = source (shuin_agents/field "source" input)
        ? !(source.len) [state 200 literal]
        ? (goo_value/decode expected "foil" source [state.self 'lib 'shuin_agents_test 'shuin_agents_test 'run] state)
         > (./err why) [state 409 why]
         > (./ok actual) [state (? (equal[pail] expected actual) 200 409) (? (equal[pail] expected actual) "Equal" "Value changed")]
    ? (eq op "codec_reject")
      = expected (shuin_agents_test/executable "Must not omit this field" (\ n=nat n.inc))
      ? (namespace_text/record (namespace_text/value state) [state.self 'app 'codec] [state.self 'app 'codec] (myth/sing ['test] expected))
       > (./err why) [state 200 why]
       > (./ok _) [state 409 "Unexpectedly exported executable field"]
    ? (eq op "codec_commentary")
      = samples (shuin_agents_test/commentary_samples state.self (str/from_atom (nat/parse (shuin_agents/field "atom" input)).fall(0)))
        index (nat/parse (shuin_agents/field "index" input)).fall(0)
      ? (ge index samples.len) [state 400 "Invalid sample"]
      = expected samples.at(index)
      ? (namespace_text/value state [($x 999)] expected)
       > (./err why) [state 409 why]
       > (./ok literal)
        = source (shuin_agents/field "source" input)
        ? !(source.len) [state 200 literal]
        ? (goo_value/decode expected "foil" source [state.self 'lib 'shuin_agents_test 'shuin_agents_test 'run] state)
         > (./err why) [state 409 why]
         > (./ok actual) [state (? (equal[pail] expected actual) 200 409) (? (equal[pail] expected actual) "Equal" "Value changed")]
    ? (eq op "commentary_context")
      = root=path [state.self 'app 'talmud]
        agent (myth/sing ['read_dependencies] (goo_paths/hunts [(hunt .z root)])).put(['write_dependencies] (goo_paths/hunts []))
        args (json/obj [(jkv "path" (json/str (path_show root))) (jkv "care" (json/str "z"))])
        call (json/obj [(jkv "function" (json/obj [(jkv "name" (json/str "namespace_read")) (jkv "arguments" (json/str (show args)))]))])
        [unchanged text] (shuin_agents/tool home.snoc('commentary_codec) agent call state)
      [state 200 text]
    ? (eq op "codec_text")
      = root=path [state.self 'app 'codec_text]
        text=str
          ? (shuin_wallet/get "atom" input)
           > (./num negative n) (str/from_atom n)
          | shuin_agents/field "text" input
        value (pails/t text)
      ?> (./ok literal) (namespace_text/value state root value) [state 409 "Value encoding failed"]
      ?> (./ok encoded) (namespace_text/record (namespace_text/value state) root root (myth/sing ['text] value)) [state 409 "Record encoding failed"]
      ?> (./ok parsed) (rex/parse encoded) [state 409 "Encoded record does not parse"]
      [(shuin_agents/change root (myth/sing system_vocabulary/content (pails/t "")) state) 200 (show (json/obj [(jkv "path" (json/str (path_show root))) (jkv "literal" (json/str literal)) (jkv "record" (json/str encoded)) (jkv "leaves" (json/arr (rex/fold[row[json]] shuin_agents_test/leaves parsed)))]))]
    ? (eq op "codec_result")
      [state 200 (show (json/num .false (str/to_atom (shuin_agents/record [state.self 'app 'codec_text] state).txt_at(system_vocabulary/content))))]
    ? (eq op "codec")
      = root=path [state.self 'app 'codec_fixture]
        first (row/snoc[iota] 'a root) last (row/snoc[iota] 'z root)
        text (str/cat_all ["Quotes: " (str/from_atom 34) " and newlines" (str/from_atom 10) "שלום"])
        next (shuin_agents/change root myth/new state)
        next (shuin_agents/change last (myth/sing ['empty] (pails/t "")) next)
        next (shuin_agents/change first ((myth/sing ['text] (pails/t text)).put(['inside] (pails/p last)).put(['outside] (pails/p ['sys])).put(['number] (pails/n 12345678901234567890)).put(['symbol] (pails/q 'symbol)).put(['paths] (pails/ps [last ['sys]]))) next)
      ?> (./ok encoded) (namespace_text/encode root next) [state 409 "Codec failed"]
      [next 200 encoded]
    ? (eq op "unsupported")
      = root=path [state.self 'app 'codec_unsupported]
        next (shuin_agents/change root (myth/sing ['code] (pails/code namespace_text/encode)) state)
      ? (namespace_text/encode root next)
       > (./ok text) [state 500 "Unexpected executable export"]
       > (./err why) [next 200 why]
    = card (shuin_agents/record target state)
      entries
        | (sovereign_care .z target state).tap.map
        \ [path record]
        = slots (record.tap.map((\ entry (jkv (path_show entry.key) (json/str (goo_value/input entry.val))))))
        | json/obj [(jkv "path" (json/str (path_show target.weld(path)))) (jkv "slots" (json/obj slots))]
      ui (shuin_agents/record home state)
      out (json/obj [(jkv "status" (json/str card.txt_at(['status]))) (jkv "ui" (json/str ui.txt_at((row/snoc[iota] 'status schema)))) (jkv "inbox" (json/arr ((shuin_agents/children (row/snoc[iota] 'inbox target) state).map((\ p (json/str (path_show p))))))) (jkv "entries" (json/arr entries))])
    [state 200 (show out)]
