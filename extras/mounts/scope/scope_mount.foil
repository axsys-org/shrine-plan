- system_vocabulary
- http_foot
- desk
- scope
- scope_foot
- mesa_wire

' Registers the foot at /<self>/io/scope when a world starts. What the foot
' tends is said by records beneath its own (scope_foot.foil); with none it
' does nothing.
'
' And the two things a door does for a scope. It gives the link to an
' invitation, with its secret, to someone this world let in
' (/scope/link/<number>); and it is handed a link (/scope/join). In both
' the secret passes between the request and a file of the foot's and
' touches no record: the route is the only place outside the foot that
' ever holds one, for the length of one request.
'
' And one reading: a composition this world takes part in, as it stands
' for this world (/scope/view/<record>): what it holds, what is its to
' do, what it may ask and what it waits on. It writes nothing.
+ scope_mount
  + text
    \ status=nat body=str
    ^ http_foot/action
    | ./reply (http_driver/response status body)
  + number
    ' The number after a route's own name in a target, or none:
    ' /scope/link/7.
    \ prefix=str target=str
    ^ maybe[nat]
    = none=maybe[nat] .none
      url (http_foot/split 63 target).at(0)
    ? !(gt url.len prefix.len.inc) none
    | nat/parse url.slice(prefix.len.inc url.len)
  + asked
    \ outcome=maybe[pail]
    ^ http_response
    ? outcome
     > .none (http_driver/response 202 "The link is being made. Ask again.")
     > (./some why) (http_driver/response 409 (http_foot/reason why))
  + link
    ' The link to an invitation this world minted, with its secret after
    ' it, for someone this world let in. The secret is the foot's: the
    ' route asks the desk, the foot leaves the secret as a file, and the
    ' route takes it once and empties the file. So the first request is
    ' answered "being made" and a later one with the link.
    \ self=iota request=http_foot/request now=nat
    ^ http_foot/action
    ? !(equal request.method "POST") (scope_mount/text 405 "POST required")
    ? (eq 0 request.who) (scope_mount/text 401 "Only someone this world has let in is given a link.")
    ?> (./some id) (scope_mount/number "/scope/link" request.target) (scope_mount/text 400 "Name the invitation by its number: /scope/link/1")
    = ask=path (desk/root self).weld(['link ($u id)])
      reader
        \ state=namespace
        ^ [nat str]
        = waiting (sovereign_care .x ask state).fil.fall((myth/sing ['done] (pails/n 1)))
        ?> (./some l) (scope_foot/invitation id state) [404 "No scope this world keeps holds a place with that invitation, or this world does not say where it is reached."]
        ? (eq 0 waiting.nat_at(['done] 0)) [202 "The link is being made. Ask again."]
        [200 (scope/show l)]
      next
        \ status=nat said=str
        ^ http_foot/action
        ? !(eq status 200) (scope_mount/text status said)
        = file (str/cat_all ["io/mesa/out/" (nat/show id)])
          ;held (mesa_wire/took file)
          want=myth (myth/sing ['want] (pails/t "link")).put(['id] (pails/n id))
        ? !(eq 33 (wid held)) (http_foot/action/commit ask (writ/make want) scope_mount/asked)
        = ;emptied (WriteFile file 1)
        | scope_mount/text 200 (str/cat_all [said "," (nat/show held)])
    | http_foot/action/after reader next
  + view
    ' A composition this world takes part in, as it stands for this world
    ' (scope_foot/view), as lines of text, for someone this world let in.
    ' The record is named as it is beneath /<self>/io/scope.
    \ request=http_foot/request now=nat
    ^ http_foot/action
    = url (http_foot/split 63 request.target).at(0)
      lead=str "/scope/view/"
      nothing=str ""
      word=str (? (gt url.len lead.len) url.slice(lead.len url.len) nothing)
    ? !(equal request.method "GET") (scope_mount/text 405 "GET required")
    ? (eq 0 request.who) (scope_mount/text 401 "Only someone this world has let in is shown what it takes part in.")
    ?> (./some rel) (path_parse (str/cat_all ["/" word])) (scope_mount/text 400 "Name the record: /scope/view/course")
    ? !(eq 1 rel.len) (scope_mount/text 400 "Name the record: /scope/view/course")
    = name rel.at(0)
      reader
        \ state=namespace
        ^ [nat str]
        ?> (./some lines) (scope_foot/view name state) [404 "No record of that name says this world takes part in a composition."]
        [200 lines]
      next
        \ status=nat said=str
        ^ http_foot/action
        | scope_mount/text status said
    | http_foot/action/after reader next
  + refusal
    \ why=iota
    ^ [nat str]
    ? (eq_iota why 'scope_door) [401 "Only someone this world has let in may hand it that link."]
    ? (eq_iota why 'scope_joined) [409 "This world has already joined under that name."]
    ? (eq_iota why 'scope_unprepared) [409 "This world was not started under that name."]
    ? (eq_iota why 'scope_busy) [409 "A claim of that name is still being answered. Hand the link over again in a moment."]
    [409 "That is not a link this world can take."]
  + taken
    \ outcome=maybe[pail] state=namespace
    ^ [nat str]
    ? outcome
     > .none [202 ""]
     > (./some why) [409 (http_foot/reason why)]
  + quiet
    \ outcome=maybe[pail] state=namespace
    ^ str
    ""
  + join
    ' A link handed to this world's door, with its secret after it. The
    ' secret is left for the foot as a file, under the number of the name
    ' the link claims, and goes into no record; the door writes the ask
    ' and the record of the joining (scope/join), and the foot does the
    ' rest. Someone this world let in may hand over any link. Nobody may
    ' hand over only the link this world was prepared for, while it has
    ' let nobody in; and the session such a request showed is the one the
    ' claim lets in.
    \ request=http_foot/request now=nat
    ^ http_foot/action
    = body (http_foot/trim request.body)
      secret (scope/secret body)
      until (add now desk/year)
      session (? (eq 0 request.who) request.asked 0)
    ? !(equal request.method "POST") (scope_mount/text 405 "POST required")
    ?> (./some l) (scope/read body) (scope_mount/text 400 "That is not a link.")
    ? !(eq 33 (wid secret)) (scope_mount/text 400 "The link carries no secret.")
    = handed l.name
      plan
        \ state=namespace
        ^ either[iota row[[p=path q=writ]]]
        ? (and (eq 0 request.who) !(scope/unlocked l state)) (./err 'scope_door)
        | scope/join l handed session until state
      reader
        \ state=namespace
        ^ [nat str]
        ? (plan state)
         > (./err why) (scope_mount/refusal why)
         > (./ok writes) [200 ""]
      next
        \ status=nat said=str
        ^ http_foot/action
        ? !(eq status 200) (scope_mount/text status said)
        = ;folder (Folder "io/mesa/in")
          ;wrote (WriteFile (mesa_wire/handed handed) secret)
        | http_foot/action/admit plan scope_mount/taken scope_mount/quiet
    | http_foot/action/after reader next
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = self=iota state.self
      link
        \ request=http_foot/request now=nat
        ^ http_foot/action
        | scope_mount/link self request now
    | http_foot/add_routes [(http_foot/route "/scope/link" link) (http_foot/route "/scope/join" scope_mount/join) (http_foot/route "/scope/view" scope_mount/view)] http_foot/empty
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + submit
    ' One write, and whether the world took it.
    \ server=nat target=path change=writ
    ^ bool
    ; (SendCaps server (helm/card/step target change) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    | scope_mount/accepted reply
  + present
    ' The foot's record, made empty when the world has none. One that is
    ' there is left exactly as it is.
    \ server=nat target=path
    ^ bool
    ? (scope_mount/submit server target (writ/poke myth/new)) .true
    | scope_mount/submit server target (writ/make myth/new)
  + start
    \ server=nat self=iota arguments=row[str]
    ^ nat
    = home=path [self 'io 'scope]
    ? !(scope_mount/present server home)
      (error (pails/t "Scope foot record refused"))
    = registration | helm/supervisor/register home scope_foot/run .true
    ; (SendCaps server registration [0])
    = ;[reply caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? !(scope_mount/accepted reply)
      (error (pails/t "Scope foot registration failed"))
    0
