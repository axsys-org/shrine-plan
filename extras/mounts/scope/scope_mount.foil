- system_vocabulary
- scope_foot

' Registers the foot at /<self>/io/scope when a world starts. What the foot
' tends is said by records beneath its own (scope_foot.foil); with none it
' does nothing.
+ scope_mount
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + submit
    ' One write, and whether the world took it.
    \ server=nat target=path change=writ
    ^ bool
    ; (SendCaps server (helm/card/step target change) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    | scope_mount/accepted reply
  + present
    ' The foot's record, made empty when the world has none. One that is
    ' there is left exactly as it is.
    \ server=nat target=path
    ^ bool
    ? (scope_mount/submit server target (writ/poke myth/new)) .true
    | scope_mount/submit server target (writ/make myth/new)
  + start
    \ server=nat self=iota arguments=row[str]
    ^ nat
    = home=path [self 'io 'scope]
    ? !(scope_mount/present server home)
      (error (pails/t "Scope foot record refused"))
    = registration | helm/supervisor/register home scope_foot/run .true
    ; (SendCaps server registration [0])
    = ;[reply caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? !(scope_mount/accepted reply)
      (error (pails/t "Scope foot registration failed"))
    0
