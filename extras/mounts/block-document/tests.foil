- block_document
- testing

+ block_document_tests
  + request
    \ doc=block_document/document operation=str id=nat run=nat offset=nat value=str style=str kind=str
    ^ block_document/request
    | block_document/request doc.revision operation id run offset value style kind
  + next
    \ doc=block_document/document operation=str id=nat run=nat offset=nat value=str style=str kind=str
    ^ block_document/document
    ? (block_document/apply doc (block_document_tests/request doc operation id run offset value style kind))
     > (./ok next) next
     > (./err why) (Seq[block_document/document] (error (pails/t why)) doc)
  + refused
    \ result=either[str block_document/document]
    ^ bool
    ? result
     > (./err why) .true
     > (./ok value) .false
  + saved
    \ doc=block_document/document page=goo/text
    ^ block_document/document
    ? (block_document/save_page doc page)
     > (./ok next) next
     > (./err why) (Seq[block_document/document] (error (pails/t why)) doc)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial block_document/initial
      edited (block_document_tests/next initial "replace" 2 1 0 "native runs" "bold italic" "")
      split (block_document_tests/next edited "split" 2 1 6 "" "" "")
      merged (block_document_tests/next split "merge" 2 0 0 "" "" "")
      undone (block_document_tests/next merged "undo" 0 0 0 "" "" "")
      redone (block_document_tests/next undone "redo" 0 0 0 "" "" "")
      inserted (block_document_tests/next initial "insert" 2 0 0 "" "" "")
      removed (block_document_tests/next inserted "remove" 6 0 0 "" "" "")
      up (block_document_tests/next initial "up" 3 0 0 "" "" "")
      linked (block_document_tests/next initial "replace" 5 0 0 "Reference remains linked" "bold" "")
      stale (block_document/apply edited (block_document_tests/request initial "remove" 2 0 0 "" "" ""))
      multiline (block_document/apply initial (block_document_tests/request initial "replace" 2 0 0 (str/from_atom 2570) "plain" ""))
      page (block_document/page initial)
      saved (block_document_tests/saved initial page)
      blank (block_document_tests/saved initial (goo/text/en (str/cat_all [(str/from_atom 10) "hello" (str/from_atom 10)])))
      before (block_document_tests/saved initial (goo/text/en "first"))
      after (block_document_tests/saved before (goo/text/en (str/cat_all ["first" (str/from_atom 10) "second"])))
    [(testing/nat "rich save preserves block count" 5 saved.blocks.len)
     (testing/nat "rich save preserves heading" 1 (eq saved.blocks.at(0).kind "heading"))
     (testing/nat "rich save preserves bullet" 1 (eq saved.blocks.at(3).kind "bullet"))
     (testing/nat "rich save preserves identities" 1 (equal (initial.blocks.map((\ b b.id))) (saved.blocks.map((\ b b.id)))))
     (testing/nat "rich save preserves link" 1 (equal saved.blocks.at(4).runs initial.blocks.at(4).runs))
     (testing/text "empty leading and trailing blocks round trip" (str/cat_all [(str/from_atom 10) "hello" (str/from_atom 10)]) (block_document/page blank).plain)
     (testing/nat "enter retains preceding block identity" before.blocks.at(0).id after.blocks.at(0).id)
     (testing/nat "enter allocates following block" before.serial after.blocks.at(1).id)
     (testing/nat "seed is valid" 1 (block_document/valid initial.blocks))
     (testing/nat "edit increments revision" 1 edited.revision)
     (testing/text "edit changes only selected run" "This page uses " edited.blocks.at(1).runs.at(0).lang.txt)
     (testing/text "typed style round trip" "bold italic" (block_document/style edited.blocks.at(1).runs.at(1)))
     (testing/nat "split allocates stable block" 6 split.blocks.at(2).id)
     (testing/nat "split preserves descriptor" 1 (equal[myth] split.blocks.at(1).runs.at(1).myth split.blocks.at(2).runs.at(0).myth))
     (testing/text "split then merge preserves text" edited.blocks.at(1).runs.plain merged.blocks.at(1).runs.plain)
     (testing/nat "undo restores content" 1 (equal split.blocks undone.blocks))
     (testing/nat "redo restores content" 1 (equal merged.blocks redone.blocks))
     (testing/nat "undo preserves allocator" merged.serial undone.serial)
     (testing/nat "remove restores seed order" 1 (equal initial.blocks removed.blocks))
     (testing/nat "move preserves identity" 3 up.blocks.at(1).id)
     (testing/nat "editing preserves structured link" 1 (maybe/is_some (linked.blocks.at(4).runs.at(0).myth.get(['sys 'link]))))
     (testing/nat "stale request refused" 1 (block_document_tests/refused stale))
     (testing/nat "multiline input refused" 1 (block_document_tests/refused multiline))]

+ tests
  [(testing/case "Native block document operations" block_document_tests/checks)]
