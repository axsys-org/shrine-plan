split_block =
  @action
  #on ; %/board
  %/offset: text
  ! foil
  \ offset=text board=%/board
  ^ %/board
  = bid (nat/parse board.selected_id).fall(1)
    rid (nat/parse board.selected_run).fall(0)
  ?> (./some cut) (nat/parse offset)
    | Seq[%/board] (error (pails/t "Offset must be a number")) board
  = request (block_document/request board.document.revision "split" bid rid cut "" "" "")
  ?> (./ok next) (block_document/apply board.document request)
    | Seq[%/board] (error (pails/t "Document operation refused; check the block, run, style, or offset")) board
  = selected (block_document/at next bid).fall(next.blocks.at(0))
