#import text=lib/grove/types/text
#import path_type=lib/grove/types/path

state_type =
  @type
  ! foil
  block_document/document
  + read
    \ value=pail
    ^ maybe[state_type]
    ?> value=block_document/document value .none
    | ./some value
  + write
    \ value=state_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ block_document/document)

rich_type =
  @type
  ! foil
  goo/text
  + read
    \ value=pail
    ^ maybe[rich_type]
    ?> value=goo/text/pail value .none
    | ./some value.value
  + write
    \ value=rich_type
    ^ pail
    | goo/text/pail value
  + contract
    ^ curb
    | curb/of_type (^ goo/text/pail)

document =
  @slot

page =
  @slot

selected_id =
  @slot

selected_run =
  @slot

selected_text =
  @slot

selected_style =
  @slot

selected_kind =
  @slot

summary =
  @slot

offset =
  @slot

board =
  @role
  %/document: %/state_type
  %/page: %/rich_type
  %/selected_id: text
  %/selected_run: text
  %/selected_text: text
  %/selected_style: text
  %/selected_kind: text
  %/summary: text

select =
  @action
  #on ; %/board
  %/selected_id: text
  %/selected_run: text
  ! foil
  \ id=text run=text board=%/board
  ^ %/board
  ?> (./some bid) (nat/parse id)
    | Seq[%/board] (error (pails/t "Block must be a number")) board
  ?> (./some rid) (nat/parse run)
    | Seq[%/board] (error (pails/t "Run must be a number")) board
  ?> (./some block) (block_document/at board.document bid)
    | Seq[%/board] (error (pails/t "Block does not exist")) board
  ? (ge rid block.runs.len)
    | Seq[%/board] (error (pails/t "Run does not exist")) board
  = chosen block.runs.at(rid)
  | board.set_selected_id(id).set_selected_run(run).set_selected_text(chosen.lang.txt).set_selected_style((block_document/style chosen)).set_selected_kind(block.kind)

save =
  @action
  #on ; %/board
  %/selected_text: text
  %/selected_style: text
  ! foil
  \ value=text style=text board=%/board
  ^ %/board
  = bid (nat/parse board.selected_id).fall(1)
    rid (nat/parse board.selected_run).fall(0)
  = request (block_document/request board.document.revision "replace" bid rid 0 value style "")
  ?> (./ok next) (block_document/apply board.document request)
    | Seq[%/board] (error (pails/t "Document operation refused; check the block, run, style, or offset")) board
  = selected (block_document/at next bid).fall(next.blocks.at(0))
    chosen selected.runs.at((? (lt rid selected.runs.len) rid 0))
  | board.set_document(next).set_page((block_document/page next)).set_selected_id((nat/show selected.id)).set_selected_run((nat/show (? (lt rid selected.runs.len) rid 0))).set_selected_text(chosen.lang.txt).set_selected_style((block_document/style chosen)).set_selected_kind(selected.kind).set_summary((str/cat_all ["Revision " (nat/show next.revision) " / " (nat/show next.blocks.len) " blocks / undo keeps 50 changes"]))

