editor =
  @view
  #on ; %/board
  #for ; /sys/slot/content
  board => {
    show(board.summary, '/sys/slot/summary)
    text(board.page, '/sys/slot/content)
    group(on = board, action = %/select, myth = { %/selected_id = .input(board.selected_id), %/selected_run = .input(board.selected_run) }) {
      text("Choose a block and run", '/sys/slot/title)
      text("Block number shown in brackets; run numbers start at 0.", '/sys/slot/summary)
      text("Block", '/sys/slot/label)
      input(%/selected_id)
      text("Run", '/sys/slot/label)
      input(%/selected_run)
      action("Select")
    }
    group(on = board, action = %/save, myth = { %/selected_text = .input(board.selected_text), %/selected_style = .input(board.selected_style) }) {
      text("Edit selected run", '/sys/slot/title)
      input(%/selected_text)
      text("Style: plain, bold, italic, underline, or a combination", '/sys/slot/label)
      input(%/selected_style)
      action("Apply text and style")
    }
    group(on = board, action = %/split_block, myth = { %/offset = .input("0") }) {
      text("Split at a character offset in the selected run", '/sys/slot/label)
      input(%/offset)
      action("Split block")
    }
    group(on = board, action = %/change_kind, myth = { %/selected_kind = .input(board.selected_kind) }) {
      text("Block kind: heading, paragraph, bullet", '/sys/slot/label)
      input(%/selected_kind)
      action("Change kind")
    }
    group(on = board, action = %/insert, myth = {}) { action("Insert paragraph after") }
    group(on = board, action = %/append_run, myth = {}) { action("Append plain run") }
    group(on = board, action = %/merge, myth = {}) { action("Merge following block") }
    group(on = board, action = %/up, myth = {}) { action("Move up") }
    group(on = board, action = %/down, myth = {}) { action("Move down") }
    group(on = board, action = %/remove, myth = {}) { action("Remove block") }
    group(on = board, action = %/undo, myth = {}) { action("Undo") }
    group(on = board, action = %/redo, myth = {}) { action("Redo") }
  }

"/document" =
  @tree
  %/document: block_document/initial
  %/page: (goo/text/pail (block_document/page block_document/initial))
  %/selected_id: "2"
  %/selected_run: "0"
  %/selected_text: "This page uses "
  %/selected_style: "plain"
  %/selected_kind: "paragraph"
  %/summary: "Revision 0 / 5 blocks / undo keeps 50 changes"

source_path =
  @slot

context =
  @role
  %/source_path: path_type

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/block_document_workspace
  context => selection('/current, source = context.source_path) {
    list('/documents, source = context.source_path, selection = '/current, slot = '/sys/slot/content)
  }
