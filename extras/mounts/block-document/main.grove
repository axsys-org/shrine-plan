    | Seq[%/board] (error (pails/t "Document operation refused; check the block, run, style, or offset")) board
  = selected (block_document/at next bid).fall(next.blocks.at(0))
    chosen selected.runs.at((? (lt rid selected.runs.len) rid 0))
  | board.set_document(next).set_page((block_document/page next)).set_selected_id((nat/show selected.id)).set_selected_run((nat/show (? (lt rid selected.runs.len) rid 0))).set_selected_text(chosen.lang.txt).set_selected_style((block_document/style chosen)).set_selected_kind(selected.kind).set_summary((str/cat_all ["Revision " (nat/show next.revision) " / " (nat/show next.blocks.len) " blocks / undo keeps 50 changes"]))

