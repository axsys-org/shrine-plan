- explorer_mount
- goo_workspace

+ block_document_mount
  + endpoint
    \ self=iota
    ^ goo_workspace/endpoint
    | goo_workspace/endpoint [self 'gov 'block_document 'workspace]
        [self 'gov 'block_document 'source_path] [self 'app 'block_document]
        block_document_mount/validate [] (block_document_mount/page self)
  + validate
    \ selected=axal[myth]
    ^ maybe[str]
    ? selected.wyt .none
    | ./some "Choose an existing document."
  + query_valid
    \ target=str
    ^ bool
    = parts (http_foot/split 63 target)
    ? (gt parts.len 2) .false
    = query=str (? (eq parts.len 2) parts.at(1) "")
    ? (eq query.len 0) .true
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) .false
    ? !(eq fields.len 1) .false
    = [key value] fields.at(0)
    | and (eq key "path") (maybe/is_some (browser_routes/value_path value))
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? ((eq url "/block-document") || (eq url "/block-document/"))
          ? !(block_document_mount/query_valid request.target)
            | ./reply (http_driver/response 400 "Use one canonical absolute namespace path.")
          | goo_workspace/request (block_document_mount/endpoint state.self) request now
        ? !(eq url "/block-document/style.css") (./reply (http_driver/response 404 "Not found"))
        = found (files.keep((\ [key bytes] (eq key "style.css"))))
        ? !(found.len) (./reply (http_driver/response 404 "Not found"))
        = [name bytes] found.at(0)
        | ./bytes 200 bytes "text/css"
    | http_foot/add_routes [(http_foot/route "/block-document" plan)] http_foot/empty
  + page
    \ self=iota target=path content=row[weft/node]
    ^ nat
    = assets (goo_browser/presentation_assets).snoc((weft/el "script" [(weft/att "src" "/static/goo-workspace.js") (weft/att "defer" "defer")] []))
      assets assets.snoc((weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/block-document/style.css")] []))
    | weft/page_with_assets "Block document" assets
      [(weft/el "header" [] [(weft/leaf "h1" [] "Block document")
         (weft/leaf "p" [] "Native Grove and Foil. Apply edits to text runs; state lasts for this server session.")])
       (weft/el "main" [] content)]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'block_document]
      target=path [state.self 'app 'block_document]
    ?> (./some version) state.case(.x source) (./err (pails/t "Block document publication is missing."))
    ?> (./ok next) (grove_install/instantiate source version target state)
      | ./err (pails/t "Block document instance could not be installed." )
    | goo_workspace/install (block_document_mount/endpoint state.self) goo_browser/talk next
