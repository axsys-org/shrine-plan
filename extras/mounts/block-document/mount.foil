- explorer_mount

+ block_document_mount
  + query_valid
    \ target=str
    ^ bool
    = parts (http_foot/split 63 target)
    ? (gt parts.len 2) .false
    = query=str (? (eq parts.len 2) parts.at(1) "")
    ? (eq query.len 0) .true
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) .false
    ? !(eq fields.len 1) .false
    = [key value] fields.at(0)
    | and (eq key "path") (maybe/is_some (browser_routes/value_path value))
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? ((eq url "/block-document") || (eq url "/block-document/"))
          ? !(block_document_mount/query_valid request.target)
            | ./reply (http_driver/response 400 "Use one canonical absolute namespace path.")
          = fields (http_foot/fields (http_foot/split 63 request.target).at(1))
            selected (http_foot/field "path" fields)
            target=path (? selected.len (http_foot/target selected) [state.self 'app 'block_document 'document])
          | ./bytes 200 (http_foot/bar (block_document_mount/page state.self target)) "text/html; charset=utf-8"
        | ./reply (http_driver/response 404 "Not found")
    | http_foot/add_routes [(http_foot/route "/block-document" plan)] http_foot/empty
  + page
    \ self=iota target=path
    ^ nat
    | weft/page_with_body_attributes "Notebook" goo_browser/surface_assets [(weft/cls "goo-surface")]
      [(weft/el "main" [(weft/att "data-goo-surface" "")
         (weft/att "data-target" (str/to_atom (path_show target)))
         (weft/att "data-view" (str/to_atom (path_show [self 'gov 'block_document 'editor])))] [])]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'block_document]
      target=path [state.self 'app 'block_document]
    ?> (./some version) state.case(.x source) (./err (pails/t "Block document publication is missing."))
    ?> (./ok next) (grove_install/instantiate source version target state)
      | ./err (pails/t "Block document instance could not be installed." )
    | ./ok next
