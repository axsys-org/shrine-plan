- goo_moodboard/model

+ moodboard_scene
  + rect
    \ bx=nat by=nat width=nat height=nat
    ^ json
    | json/obj [(jkv "x" (moodboard/world bx)) (jkv "y" (moodboard/world by))
        (jkv "width" (moodboard/number width)) (jkv "height" (moodboard/number height))]
  + width
    \ card=moodboard/card
    ^ nat
    ? (eq card.kind "presentation") 384 336
  + height
    \ card=moodboard/card
    ^ nat
    ? (eq card.kind "presentation") 440 (? (eq card.kind "image") 340 300)
  + place
    \ board=moodboard/board id=nat
    ^ moodboard/placement
    | (board.places.keep((\ place (eq place.id id)))).at(0)
  + node
    \ board=moodboard/board card=moodboard/card
    ^ json
    = place (moodboard_scene/place board card.id)
    | json/obj [(jkv "key" (json/str (nat/show card.id)))
        (jkv "lifetime" (json/str (moodboard/life card.id)))
        (jkv "selectorRef" (json/str (str/cat_all ["board-card:" (nat/show card.id)])))
        (jkv "rect" (moodboard_scene/rect place.bx place.by (moodboard_scene/width card) (moodboard_scene/height card)))
        (jkv "z" (moodboard/number card.id)) (jkv "presentation" (json/str "node"))
        (jkv "draggable" (json/boo .true)) (jkv "ports" (json/arr []))]
  + scene
    \ board=moodboard/board
    ^ str
    = [left top right bottom] (row/fold[moodboard/placement [nat nat nat nat]] [100000 100000 101000 100600]
        (\ [l t r b] place [(? (lt place.bx l) place.bx l) (? (lt place.by t) place.by t)
          (? (gt r (add place.bx 424)) r (add place.bx 424)) (? (gt b (add place.by 480)) b (add place.by 480))]) board.places)
    | show (json/obj [(jkv "header" (json/obj
        [(jkv "protocol" (moodboard/number 1)) (jkv "surface" (json/str "goo-moodboard"))
         (jkv "encounter" (json/str "goo-moodboard:1")) (jkv "viewSeq" (moodboard/number board.revision))
         (jkv "sourceRev" (json/str (nat/show board.revision))) (jkv "layoutRev" (json/str (nat/show board.revision)))
         (jkv "rendererEpoch" (json/str "moodboard:1"))]))
       (jkv "extent" (moodboard_scene/rect left top (sub right left) (sub bottom top)))
       (jkv "initialCamera" (json/obj [(jkv "kind" (json/str "fit")) (jkv "paddingPx" (moodboard/number 32))]))
       (jkv "policy" (moodboard_scene/policy))
       (jkv "offers" (json/obj [(jkv "moveNodes" (json/str "move-nodes"))]))
       (jkv "nodes" (json/arr (board.cards.map((moodboard_scene/node board)))))
       (jkv "connections" (json/arr []))])
  + policy
    ^ json
    | json/obj [(jkv "minScale" (json/real "0.125")) (jkv "maxScale" (moodboard/number 4))
      (jkv "dragThresholdPx" (moodboard/number 4)) (jkv "touchDragThresholdPx" (moodboard/number 8))
      (jkv "snapTolerancePx" (moodboard/number 6)) (jkv "portTolerancePx" (moodboard/number 12))
      (jkv "touchPortTolerancePx" (moodboard/number 22)) (jkv "wireTolerancePx" (moodboard/number 6))
      (jkv "alignmentSnap" (json/boo .true)) (jkv "autoPanBandPx" (moodboard/number 32))
      (jkv "autoPanMaxPxPerSecond" (moodboard/number 480))]
  + native
    \ kind=str args=list[rex]
    ^ goo/node
    | goo/node rex/zero_span kind args .nil
  + named
    \ name=str value=str
    ^ rex
    | rex/nest rex/zero_span "clear" "=" [(rex/word name) (rex/cord value)]
  + content
    \ card=moodboard/card
    ^ goo_patch/occurrence
    = text (\ value=str (moodboard_scene/native "text" (list/one (rex/cord value))))
      named moodboard_scene/named
      control (\ kind=str key=str name=str (moodboard_scene/native kind (list/one (rex/cord key)).snoc((named "label" name))))
      body (list/one (text card.title))
      body
        ? (eq card.kind "presentation")
          = args (list/one (rex/cord "live")).snoc((named "target" card.value)).snoc((named "slot" card.slot)).snoc((named "label" card.title)).snoc((named "width" "352")).snoc((named "height" "310")).snoc((named "top" "68"))
          | body.snoc((moodboard_scene/native "patch_presentation" args))
        ? (eq card.kind "image")
          | body.snoc((moodboard_scene/native "image" (list/one (rex/cord card.value)))).snoc((text "Visual reference"))
        | body.snoc((text card.value))
      body body.snoc((control "patch_select" "select" (str/cat_all ["Select " card.title])))
      body body.snoc((control "patch_handle" "move" (str/cat_all ["Move " card.title])))
    | goo_patch/occurrence "patch_node" (nat/show card.id) body
  + population
    \ board=moodboard/board
    ^ goo_patch/population
    | goo_patch/population (board.cards.map(moodboard_scene/content))
  + status
    \ board=moodboard/board
    ^ str
    | show (json/obj [(jkv "revision" (json/str (nat/show board.revision)))
        (jkv "cards" (json/arr (board.cards.map((\ card (json/obj [(jkv "id" (json/str (nat/show card.id)))
          (jkv "kind" (json/str card.kind)) (jkv "title" (json/str card.title))
          (jkv "value" (json/str card.value)) (jkv "slot" (json/str card.slot))]))))))])
