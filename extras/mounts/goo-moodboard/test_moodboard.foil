- goo_moodboard/mount
- testing

+ moodboard_checks
  + command
    \ kind=str fields=row[[str str]]
    ^ json
    | json/obj ((fields.map((\ [key value] (jkv key (json/str value))))).cons((jkv "kind" (json/str kind))))
  + ok
    \ result=either[str moodboard/board]
    ^ bool
    ? result
     > (./ok _) .true
     > (./err _) .false
  + board
    \ result=either[str moodboard/board]
    ^ moodboard/board
    ? result
     > (./ok board) board
     > (./err _) moodboard/initial
  + move
    \ lifetime=str x=json y=json
    ^ json
    | json/obj [(jkv "kind" (json/str "move-nodes")) (jkv "nodes" (json/arr [(json/obj [
        (jkv "target" (json/obj [(jkv "kind" (json/str "node")) (jkv "node" (json/str "1")) (jkv "lifetime" (json/str lifetime))]))
        (jkv "baseOrigin" (json/obj [(jkv "x" (moodboard/number 40)) (jkv "y" (moodboard/number 40))]))
        (jkv "proposedOrigin" (json/obj [(jkv "x" x) (jkv "y" y)]))])]))]
  + lowering
    \ ignored=unit
    ^ row[testing/check]
    = body (moodboard_scene/content (moodboard/initial).cards.at(0)).body
      view (goo/view rex/zero_span ['demo 'board] ['demo 'record] ['sys 'slot 'content] "board" body .true .nil)
      published (goo/published view .nil lash/new (./ok view))
      render (\ card=moodboard/card (goo_patch/body goo_bridge/initial_context published myth/new (moodboard_scene/content card).body [] (\ node route [])))
      note (render (moodboard/initial).cards.at(0)) image (render (moodboard/initial).cards.at(1)) live (render (moodboard/initial).cards.at(2))
      named moodboard_scene/named
      bad (moodboard_scene/native "patch_presentation" (list/one (rex/cord "live")).snoc((named "target" "https://example.org")).snoc((named "slot" "/sys/slot/content")))
    [(testing/nat "note uses real native Goo lowering" 1 (either/is_ok note))
     (testing/nat "image uses real native Goo lowering" 1 (either/is_ok image))
     (testing/nat "live frame and controls lower together" 1 (either/is_ok live))
     (testing/nat "external frame subjects rejected" 1 (either/is_err (goo_patch/presentation_frame bad)))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial moodboard/initial command moodboard_checks/command apply moodboard/apply ok moodboard_checks/ok
      create (command "create" [["tag" "note"] ["title" "New thought"] ["value" "A note"]])
      added (moodboard_checks/board (apply initial create))
      rename (command "update" [["id" "1"] ["title" "Renamed"] ["value" "Changed"]])
      renamed (moodboard_checks/board (apply initial rename))
      deleted (moodboard_checks/board (apply initial (command "delete" [["id" "1"]])))
      recreated (moodboard_checks/board (apply deleted create))
      move (moodboard_checks/move "card:1" (json/num .true 150) (json/num .true 200))
      moved (moodboard_checks/board (apply initial move))
      scene (moodboard_scene/scene moved)
      population (moodboard_scene/population initial)
      frame (population.occurrences.at(2).body.at(1))
      rendered (goo_patch/presentation_frame frame)
      html=str
        ? rendered
         > (./ok fragment) fragment.html
         > (./err _) ""
    [(testing/nat "unrenderable text rejected before saving" 0 (moodboard/valid (moodboard/card 9 "note" "Note" (str/from_atom 255) "")))
     (testing/nat "control characters rejected in image URL" 0 (moodboard/image_url (str/cat_all ["/" (str/from_atom 10) "/example.org"])))
     (testing/nat "initial cards valid" 1 (initial.cards.all(moodboard/valid)))
     (testing/nat "create accepted" 1 (ok (apply initial create)))
     (testing/nat "create stable serial" 4 added.serial)
     (testing/nat "create adds placement" 4 added.places.len)
     (testing/nat "rename preserves identity" 1 renamed.cards.at(0).id)
     (testing/nat "rename preserves placement" 1 (equal initial.places renamed.places))
     (testing/nat "delete removes placement" 2 deleted.places.len)
     (testing/nat "recreation never reuses identity" 4 recreated.cards.at(2).id)
     (testing/nat "stale deleted update rejected" 0 (ok (apply deleted rename)))
     (testing/nat "signed movement accepted" 1 (ok (apply initial move)))
     (testing/nat "signed x persisted" 99850 moved.places.at(0).bx)
     (testing/nat "signed y persisted" 99800 moved.places.at(0).by)
     (testing/nat "move preserves content" 1 (equal moved.cards initial.cards))
     (testing/nat "stale movement rejected" 0 (ok (apply moved move)))
     (testing/nat "retired lifetime rejected" 0 (ok (apply initial (moodboard_checks/move "card:old" (moodboard/number 1) (moodboard/number 2)))))
     (testing/nat "overflow movement rejected" 0 (ok (apply initial (moodboard_checks/move "card:1" (moodboard/number 100001) (moodboard/number 2)))))
     (testing/nat "fractional coordinates rounded" 99998 (moodboard/coordinate (json/real "-1.6")).fall(0))
     (testing/nat "malformed move rejected" 0 (ok (apply initial (command "move-nodes" []))))
     (testing/nat "unknown kind rejected" 0 (ok (apply initial (command "create" [["tag" "code"] ["title" "x"]]))))
     (testing/nat "empty title rejected" 0 (ok (apply initial (command "create" [["tag" "note"]]))))
     (testing/nat "script image rejected" 0 (moodboard/image_url "javascript:alert(1)"))
     (testing/nat "scheme relative image rejected" 0 (moodboard/image_url "//example.org/a.png"))
     (testing/nat "secure image accepted" 1 (moodboard/image_url "https://example.org/a.png"))
     (testing/nat "invalid subject rejected" 0 (moodboard/valid (moodboard/card 9 "presentation" "View" "bad path" "/sys/slot/content")))
     (testing/nat "empty subject rejected" 0 (moodboard/valid (moodboard/card 9 "presentation" "View" "/" "/sys/slot/content")))
     (testing/nat "population is passive typed Goo" 1 (population.occurrences.all((\ item item.body.all(goo_patch/passive)))))
     (testing/nat "presentation frame prepared" 1 (gt html.len 0))
     (testing/nat "presentation frame bound to shared route" 1 (maybe/is_some (http_foot/find "/goo-presentation?path=" html)))
     (testing/nat "negative geometry emitted" 1 (maybe/is_some (http_foot/find "-150" scene)))
     (testing/nat "board contains no graph edges" 1 (maybe/is_some (http_foot/find "connections" scene)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Goo moodboard" moodboard_checks/checks) (testing/case "Real Goo card lowering" moodboard_checks/lowering)]
