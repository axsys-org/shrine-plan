#import text=lib/grove/types/text

document_type =
  @type
  ! foil
  moodboard/board
  + read
    \ value=pail
    ^ maybe[document_type]
    ?> result=moodboard/board value .none
    | ./some result
  + write
    \ value=document_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ moodboard/board)

population_type =
  @type
  ! foil
  goo_patch/population
  + read
    \ value=pail
    ^ maybe[population_type]
    ?> result=goo_patch/population value .none
    | ./some result
  + write
    \ value=population_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo_patch/population)

document =
  @slot

population =
  @slot

scene =
  @slot

operation =
  @slot

tag =
  @slot

title =
  @slot

value =
  @slot

slot =
  @slot

id =
  @slot

brief =
  @slot

board =
  @role
  %/document: %/document_type
  %/population: %/population_type
  %/scene: text

edit =
  @action
  #on ; %/board
  %/operation: text
  ! foil
  \ operation=text board=%/board
  ^ %/board
  ?> (jres/ok args rest) (parse operation)
    | Seq[%/board] (error (pails/t "Invalid movement")) board
  = result (moodboard/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (moodboard/error result))) board
  | board.set_document(next).set_scene((moodboard_scene/scene next)).set_population((moodboard_scene/population next))

create =
  @action
  #on ; %/board
  %/tag: text
  %/title: text
  %/value: text
  %/slot: text
  ! foil
  \ tag=text title=text value=text slot=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "create")) (jkv "tag" (json/str tag)) (jkv "title" (json/str title)) (jkv "value" (json/str value)) (jkv "slot" (json/str slot))])
  = result (moodboard/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (moodboard/error result))) board
  | board.set_document(next).set_scene((moodboard_scene/scene next)).set_population((moodboard_scene/population next))

update =
  @action
  #on ; %/board
  %/id: text
  %/title: text
  %/value: text
  %/slot: text
  ! foil
  \ id=text title=text value=text slot=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "update")) (jkv "id" (json/str id)) (jkv "title" (json/str title)) (jkv "value" (json/str value)) (jkv "slot" (json/str slot))])
  = result (moodboard/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (moodboard/error result))) board
  | board.set_document(next).set_scene((moodboard_scene/scene next)).set_population((moodboard_scene/population next))

remove =
  @action
  #on ; %/board
  %/id: text
  ! foil
  \ id=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "delete")) (jkv "id" (json/str id))])
  = result (moodboard/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (moodboard/error result))) board
  | board.set_document(next).set_scene((moodboard_scene/scene next)).set_population((moodboard_scene/population next))

editor =
  @pane
  #on ; %/board
  #for ; /sys/slot/content
  board => split {
    patch('/canvas, scene = board.scene, population = board.population, label = "Goo moodboard") {
      patch_operation("move-nodes", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply move-nodes")
        }
      }
    }
    split {
      group(on = board, action = %/create, myth = { %/tag = .input("note"), %/title = .input("Untitled"), %/value = .input(""), %/slot = .input("/sys/slot/content") }) {
        text("Add card", '/sys/slot/title)
        text("Kind: note / image / presentation", '/sys/slot/label)
        input(%/tag)
        text("Title", '/sys/slot/label)
        input(%/title)
        text("Text / image URL / subject path", '/sys/slot/label)
        input(%/value)
        text("Presentation slot", '/sys/slot/label)
        input(%/slot)
        action("Add card")
      }
      group(on = board, action = %/update, myth = { %/id = .input(""), %/title = .input(""), %/value = .input(""), %/slot = .input("") }) {
        text("Save card", '/sys/slot/title)
        text("Card ID", '/sys/slot/label)
        input(%/id)
        text("Title", '/sys/slot/label)
        input(%/title)
        text("Text / image URL / subject path", '/sys/slot/label)
        input(%/value)
        text("Presentation slot", '/sys/slot/label)
        input(%/slot)
        action("Save card")
      }
      group(on = board, action = %/remove, myth = { %/id = .input("") }) {
        text("Delete card", '/sys/slot/title)
        text("Card ID", '/sys/slot/label)
        input(%/id)
        action("Delete card")
      }
    }
  }

project =
  @role
  %/brief: text

save_brief =
  @action
  #on ; %/project
  %/value: text
  ! foil
  \ value=text project=%/project
  ^ %/project
  | project.set_brief(value)

project_view =
  @view
  #on ; %/project
  #for ; /sys/slot/content
  project => col {
    text("A living project brief", '/sys/slot/title)
    show(project.brief, '/sys/slot/label)
    group(on = project, action = %/save_brief, myth = { %/value = .input("") }) {
      text("Try editing the real subject", '/sys/slot/label)
      input(%/value)
      action("Save brief")
    }
  }

"/brief" =
  @tree
  %/brief: (pails/t "Warm materials, clear type, and room to think.")

"/board" =
  @tree
  %/document: moodboard/initial
  %/population: (moodboard_scene/population moodboard/initial)
  %/scene: (pails/t (moodboard_scene/scene moodboard/initial))
