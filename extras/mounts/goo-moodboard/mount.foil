- explorer_mount
- goo_moodboard/scene

+ moodboard_mount
  + root
    \ self=iota
    ^ path
    [self 'app 'goo_moodboard]
  + schema
    \ self=iota
    ^ path
    [self 'gov 'goo_moodboard]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source (moodboard_mount/schema state.self) root (moodboard_mount/root state.self)
    ?> (./some version) state.case(.x source) (./err (pails/t "Moodboard publication missing"))
    ?> (./ok next) (grove_install/instantiate source version root state) (./err (pails/t "Moodboard installation failed"))
    = [next index reply] (helm/supervisor/handle
        (helm/card/step [state.self 'kook 'hex]
          (writ/make (form/card (def_form.set_talk(moodboard_mount/talk)) (lore/line "Goo moodboard routes"))))
        next (sovereign_hive next))
    ?> (./ack failure) reply (./err (pails/t "Moodboard route installation failed"))
    ? (maybe/is_some failure) (./err (pails/t "Moodboard route installation failed"))
    | ./ok next
  + status
    \ state=namespace
    ^ [nat str]
    = card (sovereign_peek (moodboard_mount/root state.self).snoc('board) state).fil.fall(myth/new)
    ?> (./some held) card.get((moodboard_mount/schema state.self).snoc('document)) [404 "Board unavailable"]
    ?> board=moodboard/board held [409 "Invalid board"]
    [200 (moodboard_scene/status board)]
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = target (moodboard_mount/root state.self).snoc('board)
      plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? (eq url "/goo-moodboard/state") (./snapshot moodboard_mount/status)
        ? ((eq url "/goo-moodboard") || (eq url "/goo-moodboard/"))
          = crew (crew/sing ['view] (dep .y target))
            crew crew.put(['catalog] (dep .x [state.self 'weft 'view_catalog_cache]))
          | ./wait (myth/sing ['goo_moodboard] (pails/p target)).put(crew_slot (cpail crew))
        = leaf url.slice(15 url.len)
          found (files.keep((\ [name bytes] (eq name leaf))))
        ? !(found.len) (./reply (http_driver/response 404 "Not found"))
        = [name bytes] found.at(0)
        | ./bytes 200 bytes (? (eq leaf "style.css") "text/css" (? (eq leaf "study.svg") "image/svg+xml" "application/javascript"))
    | http_foot/add_routes [(http_foot/route "/goo-moodboard" plan)] http_foot/empty
  + page
    \ target=path selected=axal[myth] catalog=axal[myth]
    ^ nat
    = card selected.fil.fall(myth/new)
      index (goo_browser/cached_index catalog)
      panes (goo_browser/matching_panes card index)
      content (panes.map((goo_browser/preview_at target card))).row
      assets (goo_browser/presentation_assets).snoc((weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/goo-moodboard/style.css")] []))
      assets assets.snoc((weft/el "script" [(weft/att "src" "/goo-moodboard/app.js") (weft/att "defer" "defer")] []))
    | weft/page_with_assets "Goo moodboard" assets
      [(weft/el "header" [] [(weft/leaf "a" [(weft/href "/goo-moodboard") (weft/cls "brand")] "goo / moodboard")
        (weft/leaf "p" [] "A space for things worth keeping.")])
       (weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))
         (weft/att "data-view" (str/to_atom (path_show (moodboard_mount/schema target.at(0)).snoc('editor))))] content)]
  + talk
    \ =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ?> (./some target) out.path_at(['goo_moodboard]) (goo_browser/talk bowl cur add)
    = body (moodboard_mount/page target (bowl.crew.gut(['view] (axal/new[myth] .none))) (bowl.crew.gut(['catalog] (axal/new[myth] .none))))
    | yell [] out.put(['res_status] (pd 200)).put(['res_body] (pd body)).put(['res_ctype] (pd "text/html; charset=utf-8"))
