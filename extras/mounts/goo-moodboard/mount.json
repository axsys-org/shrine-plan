{
  "version": 1,
  "name": "goo-moodboard",
  "dependencies": [
    "explorer",
    "codecs"
  ],
  "modules": {
    "goo_moodboard/model": "model.foil",
    "goo_moodboard/scene": "scene.foil",
    "goo_moodboard/mount": "mount.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "goo_moodboard"
      ],
      "files": [
        "main.grove"
      ],
      "prelude": "goo_moodboard/scene"
    }
  ],
  "assets": {
    "/goo-moodboard/app.js": "app.js",
    "/goo-moodboard/style.css": "style.css",
    "/goo-moodboard/study.svg": "study.svg"
  },
  "files": {},
  "roots": [
    [
      "lib",
      "goo_moodboard/model"
    ],
    [
      "lib",
      "goo_moodboard/scene"
    ],
    [
      "lib",
      "goo_moodboard/mount"
    ],
    [
      "gov",
      "goo_moodboard"
    ]
  ],
  "tests": {
    "tests/goo_moodboard": "test_moodboard.foil"
  },
  "activate": {
    "module": "goo_moodboard/mount",
    "entry": [
      "moodboard_mount",
      "install"
    ]
  },
  "http": {
    "module": "goo_moodboard/mount",
    "entry": [
      "moodboard_mount",
      "http"
    ]
  },
  "routes": [
    "/goo-moodboard"
  ]
}
