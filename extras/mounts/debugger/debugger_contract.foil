- grove_ui_runtime
- grove_app
- inspect_read
- json [at=debug_json]

' Import prefixes are local to their module. Export the encoder under a
' distinct name so Grove can use JSON without shadowing namespace show/.
+ debugger_json_show
  \ value=debug_json/json
  ^ str
  | debug_json/show value

' Debugger transport data; deliberately absent from the default Grove prelude.
' The host uses this internal transport carrier. The Grove app declares its own
' independent slots and inspection role; this aggregate never crosses that boundary.
+ grove_debug_page
  ' Only presentation metadata crosses the UI boundary, not a supervisor page.
  : epoch=nat before=maybe[nat] limit=nat total=nat next=maybe[nat]

+ grove_debug_operations
  : values=row[[p=path o=op]]

+ grove_debug_data
  : target=path view=axal[myth] versions=axal[myth]
    operations=row[[p=path o=op]] paging=maybe[grove_debug_page]
    writable=bool scope=iota slice=maybe[inspect_read/page]
