debug_explorer =
  @slot
  #meta ;
    "/sys/lede": "Documentation and operations"
    "/sys/help": (pails/t "Renders a record's authored lore, examples and doctest verdicts, plus forms for its supplied namespace operations. Derived history and overlay paths do not expose writable operation forms.")
  ! foil
  +  actions
    \  tgt=path ops=row[[p=path o=op]]
    ^  row[weft/node]
    ? !(debug_explorer/writable tgt)
       []
    =  opspane
         '  the op vocabulary in scope, each as a form (empty for
         '  derived targets — their requests carry no ['ops] deps)
         ^  row[weft/node]
         ?  (eq 0 ops.len)
            []
         =  forms
              %  idx=nat 0  out=row[weft/node] []
              ?  (ge idx ops.len)
                 out
              | _ idx.inc out.snoc((debug_explorer/op_form tgt ops.at(idx)))
         [(web_ui/card "ops" forms)]
    opspane
  +  op_form
    '  One op as an invokable form: hidden op path, a text input per
    '  declared input slot (the ['when] slot is skipped — the /op
    '  route stamps it with the host clock), the type spelling as
    '  the placeholder, the op's name on the submit.  POSTs to
    '  /op/<tgt> — a warp of this op at this node.
    \  tgt=path e=[p=path o=op]
    ^  weft/node
    = [p o] e
      markup
        ~ weft/build
        ~| 'div.opform
          ? o.lede
            ~. 'div.muted o.lede
          ~# 'form
            'method "post"
            'action (weft/cat2 "/op" (show/path tgt))
            'class "wf"
            % field o.inputs
              = [slot ty] field
              ? !(eq_pith slot ['when])
                = nm (weft/join "/" slot.map(show/iota))
                ~# 'ui-field
                  'label nm
                  ~# 'ui-input[slot=control][touch-target]
                    'name nm
                    'placeholder ty
            ~# 'input
              'type "hidden"
              'name "op"
              'value (show/path p)
            ~# 'ui-button[type=submit][size=small]
              'variant "secondary"
              ~. (show/iota o.name)
    markup.at(0)
  +  writable
    '  Namespace overlays are read-only, including typed ops.
    \  tgt=path
    ^  bool
    ? (is_h tgt) .false
    ? (is_o tgt) .false
    ? (is_xv tgt) .false
    .true
  +  docs
    \  view=axal[myth] ver=axal[myth]
    ^  row[weft/node]
    =  curx
         ?  ver.fil
          > (./some tale)  tale.txt_at(publisher_vocabulary/version/x_data)
          > .none  0
    =  doccards
         ?  view.fil
          > .none  []
          > (./some tale)
            ?  tale.get(bond/help)
             > .none  []
             > (./some held)
               ?  held
                > doc=lore
                  =  bodyrows
                       ' Hand-authored lore need not duplicate the head in
                       ' body[0]. Preserve that first paragraph when distinct.
                       % idx=nat 0 out=row[weft/node] []
                       ? (ge idx doc.body.len) out
                       = line doc.body.at(idx)
                       ? (? (eq idx 0) (eq line doc.head) .false)
                         | _ idx.inc out
                       = nodes
                           ~ weft/build
                           ~. 'div.lore-line line
                       | _ idx.inc out.weld(nodes)
                     bodynode
                       ?  (gt bodyrows.len 6)
                          = markup
                              ~ weft/build
                              ~| 'div
                                bodyrows.take(6)
                                ~| 'details
                                  ~. 'summary "More documentation"
                                  ~| 'div
                                    bodyrows.drop(6)
                          markup.at(0)
                       = markup
                           ~ weft/build
                           ~| 'div
                             bodyrows
                       markup.at(0)
                     testrows
                       ?  view.dip(['dt]).fil
                        > (./some dtale)
                          ?  dtale.get(publisher_vocabulary/dt)
                           > (./some held2)
                             ?  held2
                              > verdict=doctest/verdict  (web_lore/dt_rows doc verdict curx)
                             | web_lore/dt_rows_never doc
                           > .none  (web_lore/dt_rows_never doc)
                        > .none  (web_lore/dt_rows_never doc)
                     kbase
                       ~ weft/build
                       ~| 'div.lore-body
                         [bodynode]
                  [(web_ui/card doc.head kbase.weld(testrows))]
                > (pails/t text)
                  ? (eq text 0) []
                  = lines
                      ~ weft/build
                      ~| 'div.lore-body
                        ~. 'div.lore-line text
                  [(web_ui/card (myth/txt_at bond/lede tale) lines)]
               []
    doccards

debug_document =
  @slot
  #meta ;
    "/sys/lede": "Inspection document"
    "/sys/help": (pails/t "Composes the selected record's heading, semantic content, child paths and slots. Separates ordinary slots, constraints and source metadata, and provides bounded child, slot and journal pagination without reconstructing the document in the browser.")
  ! foil
  + document_slots
    ' One server-owned slot partition; Mash owns disclosure and scrolling.
    \ tgt=path card=myth epoch=maybe[nat] group=nat semantic=bool
    ^ row[weft/node]
    ~ weft/build
    ~# 'sh-myth.wb-record-body[variant=embedded][data-mash-size=compact]
      'data-path (show/path tgt)
      % entry card.tap
        ? (eq group (debug_model/slot_group entry.key entry.val semantic))
          = fidelity (debug_model/value_fidelity entry.key entry.val)
          ~# 'sh-limb.wb-slot-row
            'data-key (show/path entry.key)
            'data-value-kind (debug_model/value_kind entry.key entry.val)
            'data-reference (debug_model/reference entry.val)
            'data-value-state fidelity.state
            'data-preview-reason fidelity.reason
            'data-value-bytes (debug_model/number_text fidelity.total)
            'data-value-preview-bytes (debug_model/number_text fidelity.preview)
            'data-value-representation fidelity.representation
            'data-value-epoch (debug_model/number_text epoch)
            'data-value-url (debug_model/immutable_url tgt entry.key epoch entry.val)
            ~# 'sh-slot[slot=label]
              'title (show/path entry.key)
              ~# 'ui-button.wb-slot-key[type=button][variant=text][size=small]
                'data-inspect (show/path entry.key)
                'aria-label (weft/cat2 "Inspect slot definition " (show/path entry.key))
                ~. (show/path entry.key)
            ~# 'sh-pail[slot=value][role=group]
              'aria-label (weft/cat2 "Value of " (show/path entry.key))
              ~# 'ui-scroll-area.wb-code-scroll[mode=scrolling][size=medium][orientation=vertical]
                'label (weft/cat2 "Value of " (show/path entry.key))
                ~| 'pre.wb-value
                  | debug_model/value entry.key entry.val
  + document_record
    \ tgt=path view=axal[myth] epoch=maybe[nat] semantic=bool
    ^ row[weft/node]
    ?> (./some card) view.fil []
    = counts
        \ group=nat
        ^ nat
        = entries card.tap
        % i=nat 0 total=nat 0
        ? (eq i entries.len) total
        = entry entries.at(i)
        | _ i.inc (add total (? (eq group (debug_model/slot_group entry.key entry.val semantic)) 1 0))
      groups=row[[nat nat]] [["constraints" "Record constraints"] ["source" "Source slots"]]
    ~ weft/build
    ~| 'section.wb-document-record[aria-label=Record]
      ? (gt (counts "slots") 0)
        ~| 'div.wb-record-heading
          ~. 'span "Slots"
          ~. 'span.wb-record-count (weft/show_nat (counts "slots"))
        | debug_document/document_slots tgt card epoch "slots" semantic
      ? (eq card.tap.len 0)
        ~| 'sh-myth.wb-record-body[variant=embedded]
          ~. 'p.wb-context-note "This record has no slots."
      ~| 'ui-accordion.wb-record-details[variant=quiet][size=compact][mode=multiple]
        % pair groups
          = [group title] pair
          ? (gt (counts group) 0)
            ~# 'ui-accordion-item[heading-level=2]
              'value group
              'title title
              ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
              ~. 'span[slot=suffix] (weft/cat2 (weft/show_nat (counts group)) " slots")
              | debug_document/document_slots tgt card epoch group semantic
  + document_body
    ' Primary inspection is an inline Mash fragment, not a JS view model.
    \ authority=path tgt=path view=axal[myth] ver=axal[myth] epoch=maybe[nat]
       ops=row[[p=path o=op]] paging=maybe[grove_debug_page] writable=bool
    ^ row[weft/node]
    = semantic (debug_model/semantics tgt view)
      name (? (eq tgt.len 0) "Namespace" (show/iota tgt.at((dec tgt.len))))
      label (debug_model/label tgt view)
      kind (debug_model/kind tgt view)
      record_nodes (debug_document/document_record tgt view epoch (gt semantic.len 0))
      mounted
        ? view.fil
         > (./some card) (debug_model/mounted card)
         > .none .false
    ~ weft/build
    ~| 'header.wb-document-header
      ~| 'div.wb-document-heading
        ~# 'ui-icon.wb-icon[size=small][aria-hidden=true]
          'name (debug_model/glyph kind)
        ~| 'div.wb-document-titles
          ~| 'div.wb-document-title-row
            ~# 'h1.wb-document-title[tabindex=-1]
              'data-path-target (show/path tgt)
              ~. name
            ? !((eq label name) || (eq label (show/path tgt)) || mounted)
              ~. 'span.wb-document-lede label
      ~| 'ui-toolbar.wb-mode-switch[label=View_mode]
        ~| 'ui-button#wb-mode-inspect.wb-mode-button[type=button][variant=ghost][size=small][selected][aria-pressed=true]
          ~. 'ui-icon[slot=prefix][name=object.code][size=small][aria-hidden=true]
          ~. "Inspect"
    ~| 'div#wb-canvas.wb-canvas[aria-label=Namespace_inspection]
      ~| 'section.wb-lore[aria-label=Documentation]
        ? !mounted
          | debug_explorer/docs view ver
      ~| 'section.wb-semantics[aria-label=Semantics]
        semantic
        ? paging
         > (./some page) (debug_document/journal_pager tgt page)
         > .none []
        ? writable
          | web_grove/preview authority tgt view ver
      ? !((eq kind "journal") || (eq view.kid_tap.len 0))
        ~| 'section.wb-children-section
          ~| 'div.wb-record-heading
            ~. 'span "Paths"
            ~. 'span.wb-record-count (weft/show_nat view.kid_tap.len)
          ~| 'div.wb-children[role=list][aria-label=Child_paths]
            % entry view.kid_tap
              = child tgt.snoc(entry.key)
                child_label (debug_model/label child entry.val)
              ~# 'sh-path-row.wb-child-row[role=listitem][previewable]
                'href (debug_model/url child)
                'label (show/iota entry.key)
                'data-path (show/path child)
                'preview-label (weft/cat2 "Preview " (show/path child))
                ~# 'ui-icon[slot=icon][size=small][aria-hidden=true]
                  'name (debug_model/glyph (debug_model/kind child entry.val))
                ? !((eq child_label (show/path child)) || (eq child_label (show/iota entry.key)))
                  ~. 'span[slot=meta] child_label
                ~# 'div.wb-child-preview[slot=preview]
                  'data-preview-path (show/path child)
      record_nodes
      ~| 'ui-accordion[variant=quiet][size=compact][mode=multiple]
        ~| 'ui-accordion-item[title=Operations][value=operations][heading-level=2]
          ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
          ~| 'section[aria-label=Operations]
            ? writable
              ? (eq ops.len 0)
                ~. 'p.wb-context-note "No registered operations at this path."
              | debug_explorer/actions tgt ops
            ? !writable
              ~. 'p.wb-context-note "Historical and derived views are read-only."
  + key_text
    \ key=maybe[path]
    ^ nat
    ?> (./some cursor) key 0
    ? (physical_key/encode cursor)
     > (./ok text) (str/to_atom text)
     > (./err _) 0
  + collection_url
    \ tgt=path page=inspect_read/page children=maybe[path] slots=maybe[path]
    ^ nat
    | weft/cat [(debug_model/url tgt) "?epoch=" (weft/show_nat page.epoch)
        (? (maybe/is_some children) (weft/cat2 "&children=" (debug_document/key_text children)) 0)
        (? (maybe/is_some slots) (weft/cat2 "&slots=" (debug_document/key_text slots)) 0)]
  + collection_pager
    \ tgt=path paging=maybe[inspect_read/page]
    ^ row[weft/node]
    ?> (./some page) paging []
    ~ weft/build
    ? ((maybe/is_some page.next_children) || (maybe/is_some page.next_slots) ||
       (maybe/is_some page.children) || (maybe/is_some page.slots))
      ~| 'nav.debug-collection-pagination[aria-label=Namespace pages]
        ~. 'p.wb-context-note "Showing a bounded snapshot. Semantic slots remain available on each page."
        ? ((maybe/is_some page.children) || (maybe/is_some page.slots))
          ~# 'a[data-debug-page]
            'href (debug_model/url tgt)
            ~. "First page"
        ? (maybe/is_some page.next_children)
          ~# 'a[data-debug-page]
            'href (debug_document/collection_url tgt page page.next_children page.slots)
            ~. "Next paths"
        ? (maybe/is_some page.next_slots)
          ~# 'a[data-debug-page]
            'href (debug_document/collection_url tgt page page.children page.next_slots)
            ~. "Next slots"
  +  cursor_text
    \ cursor=maybe[nat]
    ^ nat
    ? cursor
     > (./some n) (weft/show_nat n)
     > .none ""
  +  journal_url
    \ root=path before=maybe[nat] limit=nat
    ^ nat
    = base (weft/cat [(debug_model/url root) "?limit=" (weft/show_nat limit)])
    ? before
     > (./some n) (weft/cat [base "&before=" (weft/show_nat n)])
     > .none base
  +  journal_pager
    \ root=path page=grove_debug_page
    ^ row[weft/node]
    ~ weft/build
    ~# 'nav.debug-journal-pagination
      'aria-label "Journal pages"
      ? (maybe/is_some page.before)
        ~# 'a[data-journal-latest]
          'href (debug_document/journal_url root .none page.limit)
          ~. "Latest events"
      ? page.next
       > (./some n)
         ~# 'a[data-journal-older]
           'href (debug_document/journal_url root (./some n) page.limit)
           ~. "Older events"
       > .none
         ~. 'span.muted "End of journal"
