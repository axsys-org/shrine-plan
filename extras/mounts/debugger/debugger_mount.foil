- debugger_http
- source_mount

+ debugger_mount
  + invalid_view
    \ config=http_foot/config
    ^ http_foot/config
    ; (error (pails/t "Invalid debugger view"))
    config
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'debug]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing debugger template")
    ? (grove_install/instantiate source version
        [state.self 'app 'debug] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (pails/t "Debugger install failed"))
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    ?> (./some view)
        (grove_app/capture [state.self 'app 'debug 'page] state)
      | debugger_mount/invalid_view http_foot/empty
    = names=row[[str str str]]
        [["debug.js" "/debug.js" "application/javascript"]
         ["debug.css" "/debug.css" "text/css"]
         ["mash.js" "/debug-mash.js" "application/javascript"]
         ["components.css" "/debug-components.css" "text/css"]]
      assets
        | names.map
          \ [name url mime]
          = bytes
              | files.fold 0
                \ out [leaf data]
                ? (equal leaf name) data
                out
          | http_foot/asset url bytes mime
      plan | debugger_http/plan assets [state.self]
      prefixes=row[str]
        ["/debug" "/debug-read" "/debug.js" "/debug.css"
         "/debug-mash.js" "/debug-components.css"]
      routes
        | prefixes.map
          \ prefix=str
          | http_foot/route prefix plan
    | http_foot/config routes
      (debugger_http/debug_response (./some view))
      (debugger_http/journal_response_with (./some view))
