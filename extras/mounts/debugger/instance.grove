' The default instance is a valid empty inspection, not a live subtree read.
' An HTTP request supplies a finite projection to this declared input boundary.

"/" =
  @tree
  lede: "Namespace debugger"
  "/sys/help": (pails/t "The debugger application instance, installed from the published Grove template with an input record and a Weft-bound page.")

"/input" =
  @tree
  #like ; document_request
  lede: "Debugger input"
  "/sys/help": (pails/t "A valid empty inspection used by the installed page. Each HTTP request supplies a finite input projection without writing navigation state here.")
  %/authority: (pails/p [])
  %/target: (pails/p [])
  %/view: (grove_tree (axal/new[myth] .none))
  %/versions: (grove_tree (axal/new[myth] .none))
  %/operations: (grove_debug_operations [])
  %/writable: 0
  %/scope: (pails/p ['document])

"/page" =
  @tree
  lede: "Shrine debugger"
  "/sys/help": (pails/t "The installed debugger page, binding the published page renderer to the instance-local input and declaring its Mash scripts and stylesheets.")
  weft: %/page
  tack: '@/y/%/input
  "/head": (weft/node/el "head" []
    [(weft/node/el "link"
      [(weft/att "rel" "stylesheet") (weft/att "href" "/debug-components.css")] [])
     (weft/node/el "link"
      [(weft/att "rel" "stylesheet") (weft/att "href" "/debug.css")] [])
     (weft/node/el "script"
      [(weft/att "src" "/debug-mash.js") (weft/att "defer" "")] [])
     (weft/node/el "script"
      [(weft/att "src" "/debug.js") (weft/att "defer" "")] [])])
