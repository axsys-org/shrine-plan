;;;; Shared native startup for disposable transport regression workers.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind compiler (#module foil-new-env))
(#bind backend (#module foil-grove-backend))
(#bind bootstrap (#module foil-bootstrap))
(#bind abi (#module foil-abi))
(#bind eden (#module application-test-ports))
(#bind debugger-source (#module grove-debugger-source))
(define (module name code)
  (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_2 code))))))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result) (error ["transport-build" result])))
(define (start port mode count)
  (print "TRANSPORT-PREPARING")
  (define self ("x" 17))
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define slot [self ("ts" "compiler") ("ts" "artifact")])
  ;; Compile only the selected data fixture, not every transport family.
  (define fixture
    (cond ((Eq mode "journal") "journal_http")
          ((Eq mode "value") "value_http")
          ((Eq mode "journal-eden") "debug_http")
          (else "physical_http")))
  (define system (bootstrap:build-system (Pin "debug-transport-fixture/v2") resolve slot))
  (define local (bootstrap:build-local self system resolve slot
    ["tests/debug_http" "grove_backend" (strcat ["tests/" fixture])]))
  (define code (_1 local))
  (define prepared (backend:prepare-with code "debugger_contract"))
  (define compiled (module "tests/debug_http" code))
  (define host (module "eden_debug" code))
  (define entry (compiler:get-perc ["debug_http" "main"] compiled))
  (print ("TRANSPORT-FIXTURE-READY" (Seq (force entry) 1)))
  (define published (ok ((compiler:get-perc ["eden_debug" "boot"] host)
    self (bootstrap:trusted system) (_1 (_0 local)) port
    (read-text-file "grove/value_codecs.grove")
    (debugger-source:read 0) (abi:option host "none")
    (eden:application-ports prepared host))))
  (define state-module (module (strcat ["tests/" fixture]) code))
  (define state-name (If (Eq mode "physical-epoch") "epoch_state" "state"))
  (define synthetic (Or (Eq mode "journal") (Eq mode "physical-large")))
  (define state
    (If (Eq mode "journal-eden") published
      (let ((state-entry (compiler:get-perc [fixture state-name] state-module)))
        (If synthetic
          ((compiler:get-perc ["debug_http" "synthetic"] compiled)
            self (bootstrap:trusted system) (state-entry port count))
          (state-entry published)))))
  (entry published state))
(#export start)
