- debugger_http
- testing
- tests/physical_http

+ journal_tests_routes
  + status
    \ target=str
    ^ nat
    ? (debugger_http/plan [] [] (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./journal before limit) 200
    0

  + query
    \ ignored=unit
    ^ row[testing/check]
    = large=nat 123456789012345678901234567890
      request (debugger_http/plan [] [] (http_foot/request "GET"
        "/debug/log?before=123456789012345678901234567890&limit=7&view=rendered" "") 0)
      exact=bool
        ? request
         > (./journal before limit)
           ? !(equal before (maybe/some[nat] large)) .false
           | eq limit 7
        .false
      defaults=bool
        ? (debugger_http/plan [] [] (http_foot/request "GET" "/debug/log" "") 0)
         > (./journal before limit)
           ? (maybe/is_some before) .false
           | eq limit 40
        .false
      invalid=row[str]
        ["/debug/log?before=" "/debug/log?before=-1" "/debug/log?before=1.5"
         "/debug/log?before=1e3" "/debug/log?before=+1" "/debug/log?before=%201"
         "/debug/log?before=01" "/debug/log?before=00" "/debug/log?limit=01"
         "/debug/log?before=1&before=2" "/debug/log?before=1&%62efore=2"
         "/debug/log?limit=0" "/debug/log?limit=41" "/debug/log?limit=-1"
         "/debug/log?limit=1.0" "/debug/log?limit=" "/debug/log?limit=3&limit=3"
         "/debug/log?view=other" "/debug/log?view=rendered&view=rendered"
         "/debug/log?offset=40" "/debug/log?care=z" "/debug/log?before=%zz"
         "/debug/log?before=3?limit=2" "/debug/log?limit=3&" "/debug/log?=1"]
      rejected (row/all[str] (\ url=str (eq 400 (journal_tests_routes/status url))) invalid)
      zero (journal_tests_routes/status "/debug/log?before=0&limit=1")
      mode (journal_tests_routes/status "/debug/log?view=rendered")
      root=path [($x 1)]
      qualified_url (str/cat_all ["/debug" (path_show root) "/%6Cog?limit=2"])
      foreign_url (str/cat_all ["/debug" (path_show [($x 2)]) "/log?limit=2"])
      qualified (browser_routes/local_route root (http_foot/request "GET" qualified_url ""))
      foreign (browser_routes/local_route root (http_foot/request "GET" foreign_url ""))
    [(testing/nat "collection bypasses HTTP namespace records" 1 defaults)
     (testing/nat "arbitrary precision decimal cursor" 1 exact)
     (testing/nat "all invalid duplicate and unknown queries reject" 1 rejected)
     (testing/nat "zero cursor is a valid exclusive lower boundary" 200 zero)
     (testing/nat "client rendered mode is accepted" 200 mode)
     (testing/nat "encoded qualified journal uses the local bounded route" 1
       (equal[str] qualified.target "/debug/log?limit=2"))
     (testing/nat "foreign journal is never redirected into local authority" 1
       (equal[str] foreign.target foreign_url))
     (testing/nat "encoded collection path uses same bounded route" 200
       (journal_tests_routes/status "/debug/%6Cog?limit=2"))]


+ value_tests_routes
  + status
    \ target=str
    ^ nat
    ? (debugger_http/plan [] [] (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./value query) 200
    0
  + queries
    \ ignored=unit
    ^ row[testing/check]
    = base=str "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=40"
      invalid=row[str]
        ["/debug-read/value" "/debug-read/value?path=/demo"
         base.cat("&epoch=2") base.cat("&%65poch=2") base.cat("&unknown=1") base.cat("&")
         base.cat("?limit=4")
         "/debug-read/value?path=demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo/&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=//demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/./demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/../demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%00&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%09&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%0A&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%7F&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%zz&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=01&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=+1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=-1&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=1.0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=0"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=65537"]
    [(testing/nat "canonical query bypasses namespace HTTP record" 200 (value_tests_routes/status base))
     (testing/nat "invalid query matrix" 1 (invalid.all((\ url (eq 400 (value_tests_routes/status url))))))
     (testing/nat "encoded canonical keys and values accepted" 200
       (value_tests_routes/status "/debug-read/value?%70ath=%2Fdemo&slot=%2Fa%2Fb&epoch=123456789012345678901234567890&offset=0&limit=65536"))]

+ physical_http_routes
  + status
    \ target=str
    ^ nat
    ? (debugger_http/plan [] [] (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./physical _) 200
    0
  + queries
    \ ignored=unit
    ^ row[testing/check]
    = base (physical_http/url ['demo] "children")
      maximum (str/cat_all ["v1" (str/repeat 2730 "/f:")])
      invalid=row[str]
        ["/debug-read/physical" "/debug-read/physical?" "/debug-read/physical?pathKey=v1"
         base.cat("&pathKey=v1") base.cat("&%70athKey=v1") base.cat("&collection=slots")
         base.cat("&epoch=3&epoch=3") base.cat("&limit=1&limit=1")
         base.cat("&unknown=1") base.cat("&") base.cat("&&limit=1") base.cat("?limit=1")
         base.cat("&epoch=") base.cat("&epoch=01") base.cat("&epoch=-1") base.cat("&epoch=+1")
         base.cat("&epoch=1.0") base.cat("&epoch=%203")
         base.cat("&epoch=").cat((str/repeat 129 "1"))
         base.cat("&limit=0") base.cat("&limit=41") base.cat("&limit=01")
         base.cat("&after=v1/u:") base.cat("&epoch=3&after=v1")
         base.cat("&epoch=3&after=v1/u:/u:")
         "/debug-read/physical?pathKey=v1/u:%00&collection=children"
         "/debug-read/physical?pathKey=v1/u:%09&collection=children"
         "/debug-read/physical?pathKey=v1/u:%7f&collection=children"
         "/debug-read/physical?pathKey=v1/u:%zz&collection=children"
         "/debug-read/physical?pathKey=v1/u:00&collection=children"
         "/debug-read/physical?pathKey=v1/u:AA&collection=children"
         "/debug-read/physical?pathKey=v1&collection=other"]
      request (debugger_http/plan [] [] (http_foot/request "GET" base "") 0)
      defaults
        ? request
         > (./physical query)
           ? !(eq query.limit 40) .false
           ? (maybe/is_some query.epoch) .false
           | maybe/is_none query.after
        .false
    [(testing/nat "physical route bypasses ordinary namespace action" 1 defaults)
     (testing/nat "strict invalid query matrix" 1 (row/all[str] (\ url=str (eq 400 (physical_http_routes/status url))) invalid))
     (testing/nat "root structural identity accepted" 200 (physical_http_routes/status "/debug-read/physical?pathKey=v1&collection=children"))
     (testing/nat "empty opaque slot cursor retained" 200 (physical_http_routes/status "/debug-read/physical?pathKey=v1&collection=slots&epoch=3&after=v1"))
     (testing/nat "encoded names and exact values accepted" 200 (physical_http_routes/status "/debug-read/physical?%70athKey=v1%2Fu%3A01&collection=children&epoch=3&after=v1%2Fu%3A&limit=1"))
     (testing/nat "maximum path and opaque cursor fit canonical raw query" 200
       (physical_http_routes/status (str/cat_all ["/debug-read/physical?pathKey=" maximum "&collection=slots&epoch=3&after=" maximum])))
     (testing/nat "raw request line NUL is rejected before tokenization" 0
       (http_foot/request_line_valid (str/cat_all ["GET /" (str/from_atom (add 65 (mul 65536 66))) " HTTP/1.1" (str/from_atom 13)])))
     (testing/nat "normal CR terminated request line remains valid" 1
       (http_foot/request_line_valid "GET / HTTP/1.1".cat((str/from_atom 13))))
     (testing/nat "socket sentinel NUL boundary rejects before unpacking" 1
       (either/is_err (Try http_foot/request_chunk (add 65 (bex 16)))))
     (testing/text "normal socket sentinel payload is unchanged" "A"
       (http_foot/request_chunk (add 65 (bex 8))))
     (testing/text "unescaped physical identity remains exact" "v1/u:0001"
       (browser_routes/physical_decode "v1/u:0001"))
     (testing/text "percent and plus retain existing strict decoding" "v1/u: a"
       (browser_routes/physical_decode "%76%31%2Fu%3A+a"))]

+ tests
  ^ row[testing/case]
  [(testing/case "strict journal query contract" journal_tests_routes/query)
   (testing/case "strict value query grammar" value_tests_routes/queries)
   (testing/case "strict physical HTTP queries" physical_http_routes/queries)]
