- debugger_contract
- helm
+  debugger
  '  A debug workspace over the same hydrated views as /ns. The
  '  explicit /debug route bypasses app faces, never the namespace
  '  reader or write verdicts. Browser enhancements live in debug.js.
  +  declared_page
    ' The HTTP adapter supplies only typed namespace data and policy.
    ' All document markup is produced by the published Grove page component.
    \ app=grove_app/binding tgt=path view=axal[myth] ver=axal[myth]
       ops=row[[p=path o=op]] paging=maybe[helm/journal_page]
    ^ nat
    = page_data (paging.run((\ page=helm/journal_page (grove_debug_page page.epoch page.before page.limit page.total page.next))))
      data (grove_debug_data tgt view ver ops page_data .false 'document .none)
    | debugger/render_declared app data
  + inputs
    ' Named transport inputs are projected using the app's declared role schema.
    ' This record is local to this response, never retained in namespace history.
    \ authority=path data=grove_debug_data
    ^ myth
    = input
        . (myth/new)
          put(['authority] (pails/p authority))
          put(['target] (pails/p data.target))
          put(['view] (grove_tree data.view))
          put(['versions] (grove_tree data.versions))
          put(['operations] (grove_debug_operations data.operations))
          put(['writable] (pails/n (? data.writable 1 0)))
          put(['scope] (pails/p [data.scope]))
      input
        ? data.paging
         > (./some page) input.put(['paging] page)
         > .none input
    ? data.slice
     > (./some slice) input.put(['slice] slice)
     > .none input
  + render_declared
    \ app=grove_app/binding data=grove_debug_data
    ^ nat
    = tgt data.target
    > (./some shell) (grove_app/render app (debugger/inputs app.authority data))
      | error (pails/t "Debugger page did not satisfy its response norm")
    ? !(eq_iota data.scope 'document) (weft/render shell)
    | grove_app/document_with_attributes [(weft/att "data-mash-catalogue" "mash")] app shell
  +  talk
    \  =bowl cur=myth add=myth
    ^  yell
    ' Ordinary application HTTP dispatch must not resurrect the unbounded
    ' debugger read path. /debug is served by the bounded read-only adapter.
    = out cur.meld(add)
      done
        . out
          put(['res_status] (pd 503))
          put(['res_body] (pd "Grove debugger unavailable: install the debugger application and use /debug."))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
