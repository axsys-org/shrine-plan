- eden_srs
- debugger_mount

' The selected system publication owns /sys. Application definitions and
' codecs publish beneath this node's authority before installing its instance.
+ eden_debug
  + boot
    \ self=iota system=pin[system_publication] local=sov port=nat
      types=str debugger=str srs=maybe[str] ports=eden_srs/ports
    ^ either[eden_srs/failure namespace]
    ?> (./ok initial) (eden/boot self system local port)
      | ./err (eden_srs/failure "eden" (pails/t "Namespace boot failed"))
    = types_root=path [self 'lib 'grove 'types]
      source_root=path [self 'gov 'debug]
      instance_root=path [self 'app 'debug]
    < state (eden_srs/compile_batch types_root types_root types initial ports)
    < state (eden_srs/compile_batch types_root source_root debugger state ports)
    < state
        ^ either[eden_srs/failure namespace]
        ? srs
         > .none (./ok state)
         > (./some source)
          | eden_srs/compile_batch types_root [self 'gov 'srs] source state ports
    ?> (./some version) (namespace/case .x source_root state)
      | ./err (eden_srs/failure "debugger" (pails/t "Missing application template"))
    ? (grove_install/instantiate source_root version instance_root state)
     > (./err reason) (./err (eden_srs/failure "debugger" reason))
     > (./ok installed) (./ok installed)
  + main
    \ self=iota system=pin[system_publication] local=sov port=nat
      types=str debugger=str srs=maybe[str] ports=eden_srs/ports
    ^ nat
    ?> (./ok state) (eden_debug/boot self system local port types debugger srs ports)
      | error (pails/t "Debugger fixture boot failed")
    | eden/serve_with state (http_foot/run_with (debugger_mount/http [] state))
