' A bounded binding descriptor, authored alongside the Grove fragments.
' It carries no executable markup, complete pail copies, or read capabilities.

inspect_read_descriptor =
  @slot
  #meta ;
    "/sys/lede": "Bounded browser read metadata"
    "/sys/help": (pails/t "Declares the versioned, inert JSON descriptor used by tree, locator and hover bindings: identity, authored summaries, Mash glyphs, counts, continuation cursors and up to three short slot excerpts. It grants no read capability and does not replace exact-value inspection.")
  ! foil
  + text
    \ value=nat
    ^ json
    | json/str (str/from_atom value)
  + decimal
    \ value=nat
    ^ json
    | json/str (nat/show value)
  + optional
    \ value=nat
    ^ json
    ? (eq value 0) (json/nul 0)
    | inspect_read_descriptor/text value
  + label
    \ target=path view=axal[myth]
    ^ nat
    = title (debug_model/label target view)
    ? !(eq title (show/path target)) title
    ? (eq target.len 0) "Namespace"
    | show/iota target.at(target.len.dec)
  + state
    \ view=axal[myth] versions=axal[myth]
    ^ nat
    ? (maybe/is_some view.fil) "live"
    = version versions.fil.fall((myth/new))
    ? (eq (str/to_atom (version.txt_at(publisher_vocabulary/version/state))) "tombstone") "tombstone"
    ? (gt view.kid.size 0) "structural"
    "unknown"
  + summary
    \ target=path view=axal[myth]
    ^ row[jkv]
    = kind (debug_model/kind target view)
    [(jkv "path" (inspect_read_descriptor/text (show/path target)))
     (jkv "kind" (inspect_read_descriptor/text kind))
     (jkv "glyph" (inspect_read_descriptor/text (debug_model/glyph kind)))
     (jkv "label" (inspect_read_descriptor/text (inspect_read_descriptor/label target view)))
     (jkv "description" (inspect_read_descriptor/text (debug_model/description target view)))]
  + preview_text
    ' Excerpts are explicitly previews, never evidence of full value fidelity.
    \ key=path value=pail
    ^ nat
    ? value
     > text=pails/t (debug_model/text_preview 177 (str/to_atom text.t))
     > number=pails/n
       ? (debug_model/text_cord key) (debug_model/text_preview 177 number.n)
       ? (gt (wid number.n) 32) (weft/cat2 (weft/show_nat (wid number.n)) " byte numeric value")
       | weft/show_nat number.n
     > ref=pails/p (debug_model/text_preview 177 (show/path ref.p))
     > ref=safe (debug_model/text_preview 177 (show/path ref.path))
    | debug_model/value_kind key value
  + previews
    \ view=axal[myth] scope=iota
    ^ row[json]
    ? (eq_iota scope 'outline) []
    ?> (./some card) view.fil []
    = entries card.tap
    % index=nat 0 out=row[json] []
    ? ((eq index entries.len) || (eq out.len 3)) out
    = entry entries.at(index)
      key entry.key
    ? ((eq_pith key bond/lede) || (eq_pith key bond/help) || (eq_pith key ['sys 'lash]))
      | _ index.inc out
    = preview
        | json/obj
          [(jkv "key" (inspect_read_descriptor/text (show/path key)))
           (jkv "text" (inspect_read_descriptor/text (inspect_read_descriptor/preview_text key entry.val)))
           (jkv "reference" (inspect_read_descriptor/optional (debug_model/reference entry.val)))]
    | _ index.inc out.snoc(preview)
  + pagination
    \ paging=maybe[grove_debug_page]
    ^ json
    ?> (./some page) paging (json/nul 0)
    | json/obj
      [(jkv "kind" (inspect_read_descriptor/text "journal"))
       (jkv "before" (page.before.run(inspect_read_descriptor/decimal).fall((json/nul 0))))
       (jkv "nextBefore" (page.next.run(inspect_read_descriptor/decimal).fall((json/nul 0))))
       (jkv "limit" (json/num .false page.limit))
       (jkv "total" (inspect_read_descriptor/decimal page.total))
       (jkv "epoch" (inspect_read_descriptor/decimal page.epoch))]
  + value
    \ data=document_request/item
    ^ json
    = target data.target
      view data.view
      entries
        ? (debug_model/is_journal target) view.kid_tap.rev
        view.kid_tap
      children
        | entries.map
        \ entry
        | json/obj (inspect_read_descriptor/summary target.snoc(entry.key) entry.val)
      child_count data.slice.run((\ page page.child_count)).fall(data.paging.run((\ page page.total)).fall(view.kid.size))
      slot_count data.slice.run((\ page page.slot_count)).fall(view.fil.run((\ card card.size)).fall(0))
      collection
        | json/obj
          [(jkv "epoch" (data.slice.run((\ page (inspect_read_descriptor/decimal page.epoch))).fall((json/nul 0))))
           (jkv "nextChildren" (data.slice.run((\ page (inspect_read_descriptor/optional (debug_document/key_text page.next_children)))).fall((json/nul 0))))
           (jkv "nextSlots" (data.slice.run((\ page (inspect_read_descriptor/optional (debug_document/key_text page.next_slots)))).fall((json/nul 0))))
           (jkv "childCount" (inspect_read_descriptor/decimal child_count))
           (jkv "slotCount" (inspect_read_descriptor/decimal slot_count))]
    | json/obj
      ((inspect_read_descriptor/summary target view).weld(
        [(jkv "version" (json/num .false 1))
         (jkv "namespaceRoot" (inspect_read_descriptor/text (show/path data.authority)))
         (jkv "scope" (inspect_read_descriptor/text (show/iota data.scope)))
         (jkv "state" (inspect_read_descriptor/text (inspect_read_descriptor/state view data.versions)))
         (jkv "hasRecord" (json/boo (maybe/is_some view.fil)))
         (jkv "writable" (json/boo data.writable))
         (jkv "children" (json/arr children))
         (jkv "collection" collection)
         (jkv "pagination" (inspect_read_descriptor/pagination data.paging))
         (jkv "previewSlots" (json/arr (inspect_read_descriptor/previews view data.scope)))]))
  + markup
    \ data=document_request/item
    ^ weft/node
    | weft/node/el "template" [(weft/att "id" "debug-read-descriptor")]
      [(weft/tx (str/to_atom (debugger_json_show (inspect_read_descriptor/value data))))]
