- eden_debug

' A synthetic index retains its exact epochs. It is confined beneath the
' selected fixture authority and never receives compiler/publication writes.
+ debug_http
  + synthetic
    \ self=iota system=pin[system_publication] state=sov
    ^ namespace
    = fs_record (root/card "Filesystem sync instances.")
      fs_version
        | saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0))
            (pin fs_record)
      fs_history (tome (pin (uon/sing[ass] ($u 1) (ass/ker fs_version))))
      synthetic_index state.idx.put(['io 'fs] fs_history)
      index (axal/new[tome] .none)
      cases (axal/new[urn] .none)
      with_index state.set_idx(index.set_kid(index.kid_put(self synthetic_index)))
      local with_index.set_cases(cases.set_kid(cases.kid_put(self state.cases)))
    | namespace self local system
  + main
    \ published=namespace state=namespace
    ^ nat
    ?> (./some app) (grove_app/capture [published.self 'app 'debug 'page] published)
      | error (pails/t "Socket fixture has no installed debugger view")
    | eden/serve_with state (http_foot/run_with (debugger_mount/http [] published))
