- conversation_mount
- conversation_interface
- conversation_controls
- flow_test_world [at=fixture]
- flow_request_fixture [at=provider_fixture]
- nenex_editor_http
- apps/nenex/main [at=wiki]
- testing

+ conversation_tests
  + text
    \ lines=row[nat]
    ^ str
    | str/from_atom (joined 10 lines)
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /conversation_response_flow" "  ;@ /flow/definition respond" "  ;= Author a projected Nenex response"
       "    ;@ /flow/input context" "    ;= Selected conversation context"
       "    ;@ /flow/input provider" "    ;= Selected interactive provider"
       "    ;@ /flow/step task ;/0x11/gov/conversation/response_task" "    ;@ /flow/bind context context" "    ;= Prepare response work"
       "    ;@ /flow/step response ;/0x11/gov/flows/operations/interactive_requests"
       "    ;@ /flow/bind tasks task" "    ;@ /flow/bind provider provider" "    ;= Delegate through the shared hand"
       "    ;@ /flow/step pages ;/0x11/gov/conversation/response_pages" "    ;@ /flow/bind responses response" "    ;= Project the authored response"
       "    ;@ /flow/result pages" "    ;= Nenex document"])
  + page
    ^ path
    [($x 17) 'app 'nenex 'w 'conversation_test]
  + definition
    ^ path
    | (fixture/flow_tests/author).weld(['flows 'respond])
  + admit
    \ planner={\ namespace}either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/admit planner state (sovereign_hive state))
    | fixture/flow_tests/accepted reply next
  + prepared
    ^ namespace
    | conversation_tests/prepared_in fixture/flow_tests/initial
  + prepared_in
    \ initial=namespace
    ^ namespace
    = state
        ?> (./ok next) (conversation_mount/install initial) initial
        next
      authored (fixture/flow_tests/apply 'author fixture/flow_tests/author (myth/sing ['source] (pails/t conversation_tests/source)).put(['expected] (pails/n state.case(.x fixture/flow_tests/author).fall(0))) state)
      state (fixture/flow_tests/apply 'publish fixture/flow_tests/author
        (myth/sing ['id] (pails/t "respond")).put(['expected] (pails/n authored.case(.x fixture/flow_tests/author).fall(0))) authored)
      form=path [state.self 'gov 'flows 'request_provider]
      state (fixture/flow_tests/poke form (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
      provider=path [state.self 'gov 'conversation 'test_provider]
      state (fixture/flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider provider_fixture/request_tests/provider)) state)
      input (myth/sing ['definition] (safe 0 .x conversation_tests/definition)).put(['provider] (safe 0 .x provider))
    | conversation_tests/admit (conversation_ops/start conversation_tests/page input) state
  + message
    \ id=str text=str
    ^ myth
    | (myth/sing ['id] (pails/t id)).put(['text] (pails/t text))
  + response
    \ source=str
    ^ str
    | show (json/obj [(jkv "source" (json/str source)) (jkv "note" (json/str "Authored from the selected evidence."))])
  + attempt
    \ id=iota n=nat
    ^ path
    | (conversation_tests/page).weld(['work id 'work ($ts (str/cat_all ["request_" n.show]))])
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      ready conversation_tests/prepared
      user_text (conversation_tests/text ["Explain this wiki." "" ";@ /flow/step remains literal user text" ";= Show a native reference."])
      input (conversation_tests/message "first" user_text)
      sent (conversation_tests/admit (conversation_ops/send page input) ready)
      request=path (conversation_tests/attempt 'first 1)
      reply=path page.weld(['replies 'first])
      context=path page.weld(['cells 'first])
      source (conversation_tests/text [";= A document response" "  This is native Nenex content." "" "  ;/0x11/app/nenex/w/conversation_test/wiki"])
      done (provider_fixture/request_tests/deliver request "complete" (conversation_tests/response source) sent)
      invalid (provider_fixture/request_tests/deliver request "complete" (conversation_tests/response
        (conversation_tests/text [";= Heading" "" "Unindented prose is outside that section."])) sent)
      duplicate (conversation_ops/send page input done)
      second (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "second" "Continue from that response.")) done)
      changed (fixture/flow_tests/poke page.snoc('wiki) (myth/sing ['src] (pails/t (conversation_tests/text [";= Conversation wiki" "  New evidence is available."]))) second)
      old (fixture/flow_tests/get request done)
      current_context (sovereign_care .z (row/cons[iota] 'x page.weld(['cells 'second])) changed)
      response_card (fixture/flow_tests/get reply done)
    | [(testing/text "unindented model prose leaves a visible failed request" "conversation_invalid_semidoc"
         (fixture/flow_tests/get request invalid).txt_at(system_vocabulary/content))
       (testing/nat "invalid Semidoc cannot publish a partial response" 0 (fixture/flow_tests/get reply invalid).has(['src]))
       (testing/nat "user message is a native Nenex document" 1 (fixture/flow_tests/get page.weld(['messages 'first]) sent).has(['src]))
       (testing/nat "turn invokes an ordinary shared maintenance controller" 1 (fixture/flow_tests/get page.weld(['work 'first]) sent).has(['flow 'config]))
       (testing/nat "request uses native provider worker" 1 (fixture/flow_tests/get request.snoc('worker) sent).has(['work 'request]))
       (testing/nat "response publishes through the existing Nenex writer" 1 response_card.has(['src]))
       (testing/nat "response is available through the existing Nenex manifest" 1 (either/is_ok (nenex_editor_http/manifest reply done)))
       (testing/nat "response preserves authored native reference" 1 (row/has[snode]
         (snode/ref (seg_texts page.snoc('wiki)) [])
         (flow_ops/flatten (wiki/page_nodes (sovereign_peek reply done)))))
       (testing/text "message source preserves multiline and rune-shaped user text" user_text
         (conversation_response/message (fixture/flow_tests/get page.weld(['messages 'first]) sent).txt_at(['src])))
       (testing/nat "duplicate send is an idempotent receipt" 1 (equal[either[iota row[[p=path q=writ]]]] duplicate (./ok [])))
       (testing/text "same turn id cannot replace a different message" "conversation_turn_conflict"
         (fixture/flow_tests/reason (conversation_ops/send page (conversation_tests/message "first" "Replace it") done)))
       (testing/nat "next turn retains preceding response version" 1
         (eq current_context.get(['history 'first 'reply]).fall(myth/new).txt_at(['src]) response_card.txt_at(['src])))
       (testing/nat "captured history retains explicit turn order" 0
         current_context.get(['history 'first 'turn]).fall(myth/new).nat_at(['chat 'sequence] 999))
       (testing/nat "previous completed attempt remains exact after changed evidence" 1
         (equal[myth] old (fixture/flow_tests/get request changed)))
       (testing/nat "named wiki descendants are valid destinations" 1 (flow_nenex_ops/document_path reply ready.self))
       (testing/nat "existing corpus page names remain valid" 1 (flow_nenex_ops/document_path [ready.self 'app 'nenex 'w 'work] ready.self))
       (testing/nat "work branches are not wiki destinations" 0 (flow_nenex_ops/document_path page.weld(['work 'first]) ready.self))
       (testing/nat "positional source blocks are not destinations" 0 (flow_nenex_ops/document_path page.snoc(($u 0)) ready.self))]
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      wiki=path page.snoc('wiki)
      claim=path wiki.weld(['claims 'first])
      context=path page.weld(['cells 'first])
      controller=path page.weld(['work 'first])
      reply=path page.weld(['replies 'first])
      ready conversation_tests/prepared
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "first" "Use the linked evidence.")) ready)
      a=path (conversation_tests/attempt 'first 1)
      original (fixture/flow_tests/get a sent)
      relation (myth/sing ['subject] (safe 0 .x wiki)).put(['text] (pails/t "First evidence"))
      added (fixture/flow_tests/poke claim relation sent)
      b=path (conversation_tests/attempt 'first 2)
      alias=path ['evidence ($u claim.len)]
      selected (fixture/flow_tests/get context added)
      late (provider_fixture/request_tests/deliver a "complete" (conversation_tests/response (conversation_tests/text [";= Obsolete" "  Stale response."])) added)
      failed (provider_fixture/request_tests/deliver b "complete" (conversation_tests/response "") late)
      failed_request (fixture/flow_tests/get b failed)
      hole=path failed_request.path_at(['work 'hole_path]).fall([])
      retry (myth/sing ['expected] (pails/n failed.case(.x b).fall(0)))
      retried (fixture/flow_tests/apply 'retry_revision b retry failed)
      c=path (conversation_tests/attempt 'first 3)
      done (provider_fixture/request_tests/deliver c "complete" (conversation_tests/response (conversation_tests/text [";= Supported" "  Linked evidence supports this response."])) retried)
      [deleted index ack] (helm/supervisor/step claim .cull 0 0 done (sovereign_hive done))
      deleted (fixture/flow_tests/accepted ack deleted)
      restored (fixture/flow_tests/poke claim relation deleted)
      retained (fixture/flow_tests/get a restored)
    | [(testing/nat "incoming wiki reference becomes an explicit lens binding" 1 selected.has(alias.weld(claim)))
       (testing/nat "changed graph membership resumes through the existing hand" 1 (fixture/flow_tests/get b added).has(['work 'request]))
       (testing/nat "late result from superseded context cannot publish" 0 (fixture/flow_tests/get reply late).has(['src]))
       (testing/nat "unresolved response retains a native subject hole" 1 (fixture/flow_tests/get hole failed).has(['work 'hole]))
       (testing/nat "retry links a new attempt to its predecessor" 1 (equal[maybe[path]] (fixture/flow_tests/get c retried).path_at(['work 'retry_of]) (./some b)))
       (testing/text "retried response completes through shared lifecycle" "complete" (fixture/flow_tests/get c done).txt_at(['work 'status]))
       (testing/text "existing hole resolves" "resolved" (fixture/flow_tests/get hole done).txt_at(['work 'status]))
       (testing/nat "deletion releases current graph alias" 0 (fixture/flow_tests/get context deleted).has(alias.weld(claim)))
       (testing/nat "restoration selects evidence again" 1 (fixture/flow_tests/get context restored).has(alias.weld(claim)))
       (testing/nat "old attempt capture remains exact" 1 (equal[pail] original.pail_at(['capture]) retained.pail_at(['capture])))
       (testing/nat "x history survives resumption and retry" 1 (equal (sent.local.x_query(sent.local.x_case(a).fall(0) a)) (restored.local.x_query(sent.local.x_case(a).fall(0) a))))
       (testing/nat "y history survives resumption and retry" 1 (equal (sent.local.y_query(sent.local.y_case(a).fall(0) a)) (restored.local.y_query(sent.local.y_case(a).fall(0) a))))
       (testing/nat "z history survives resumption and retry" 1 (equal (sent.local.z_query(sent.local.z_case(a).fall(0) a)) (restored.local.z_query(sent.local.z_case(a).fall(0) a))))]
  + fidelity
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      reply=path page.weld(['replies 'first])
      ready conversation_tests/prepared
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "first" "Explain these authored bindings.")) ready)
      source (conversation_tests/text [";= Authored relationships" "  ;@ /flow/bind left context" "  ;@ /flow/bind right evidence" "  ;= An inert example" "    These bindings remain authored relationships."])
      done (provider_fixture/request_tests/deliver (conversation_tests/attempt 'first 1) "complete" (conversation_tests/response source) sent)
      edited (fixture/flow_tests/edit "save" reply.snoc(($u 0)) "Edited response heading" done)
      goo_source (fixture/flow_tests/get reply edited).txt_at(['src])
      after_source (str/cat_all [goo_source (conversation_tests/text [0 "  Additional authored prose." 0])])
      saved (fixture/flow_tests/apply 'author reply
        (myth/sing ['source] (pails/t after_source)).put(['expected] (pails/n edited.case(.x reply).fall(0))) edited)
      current (fixture/flow_tests/get reply saved).txt_at(['src])
      evidence (fixture/flow_tests/poke page.snoc('wiki)
        (myth/sing ['src] (pails/t (conversation_tests/text [";= New evidence" "  Changed since the reply was edited."]))) saved)
      selected=path
        ?> subscriptions=cpail (fixture/flow_tests/get page.weld(['work 'first]) evidence).pail_at(crew_slot) []
        = requests subscriptions.crew.tap.keep((\ entry (and (eq entry.key.len 2) (eq_iota entry.key.at(0) 'request))))
        ? requests.len requests.at(0).val.p
        []
      refreshed (provider_fixture/request_tests/deliver selected "complete" (conversation_tests/response source) evidence)
      held (fixture/flow_tests/get page.weld(['work 'first]) refreshed)
      conflict=bool
        ?> progress=flow_maintenance/progress held.pail_at(['flow 'progress]) .false
        | equal[maybe[iota]] (./some 'flow_generated_page_edited) progress.reason
      occupied=path page.weld(['messages 'second 'annotation])
      claimed (fixture/flow_tests/poke occupied (myth/sing ['text] (pails/t "Keep this record")) saved)
    | [(testing/nat "Goo heading edit preserves first binding" 1 (cord/has "/flow/bind left context" (str/to_atom goo_source)))
       (testing/nat "Goo heading edit preserves repeated binding" 1 (cord/has "/flow/bind right evidence" (str/to_atom goo_source)))
       (testing/nat "source edit preserves the same bindings" 1 (and (cord/has "/flow/bind left context" (str/to_atom current)) (cord/has "/flow/bind right evidence" (str/to_atom current))))
       (testing/nat "both bindings survive in native records" 2
         (flow_ops/flatten (wiki/page_nodes (sovereign_peek reply saved))).bind((flow_ops/attributes "bind")).len)
       (testing/nat "source and native records preserve the same authored nodes" 1
         (equal[either[iota row[snode]]] (wiki/authored_nodes (sovereign_peek reply saved)) (./ok (wiki/src_image (str/to_atom current)))))
       (testing/nat "conversation response remains the same native document" 1 (equal[pail] (fixture/flow_tests/get reply done).pail_at(limb_slot) (fixture/flow_tests/get reply saved).pail_at(limb_slot)))
       (testing/nat "edited generated prose invokes the existing publication guard" 1 conflict)
       (testing/text "published reply does not conceal a blocked writer" "blocked" (conversation_ui/status held refreshed).at(0))
       (testing/text "refresh cannot replace the edited response" current (fixture/flow_tests/get reply refreshed).txt_at(['src]))
       (testing/text "occupied descendants reject turn allocation" "conversation_turn_collision"
         (fixture/flow_tests/reason (conversation_ops/send page (conversation_tests/message "second" "Keep occupied work") claimed)))]
  + wiki_authoring
    \ ignored=unit
    ^ row[testing/check]
    = ready conversation_tests/prepared
      wiki=path (conversation_tests/page).snoc('wiki)
      child=path wiki.snoc('notes)
      source (conversation_tests/text [";= Working notes" "  A native child of this conversation wiki."])
      input (myth/sing ['new_name] (pails/t "notes")).put(['source] (pails/t (show (goo_text/encode (goo/text/en source)))))
      created (conversation_tests/admit (flow_author_controls/create_child_source wiki input) ready)
    | [(testing/text "child authoring uses the native Nenex document operation" source (fixture/flow_tests/get child created).txt_at(['src]))
       (testing/nat "child document uses the existing Nenex projection" 1 (either/is_ok (nenex_editor_http/manifest child created)))
       (testing/text "child creation cannot replace an existing document" "flow_stale_source"
         (fixture/flow_tests/reason (flow_author_controls/create_child_source wiki input created)))]
  + creation_route
    \ ignored=unit
    ^ row[testing/check]
    = config (conversation_ui/http [] fixture/flow_tests/initial)
      handler config.routes.at(0).plan
      result (handler (http_foot/request "GET" "/conversation" "") 0)
      status=nat
        ?> (./bytes status body mime) result 0
        status
      expanded (conversation_tests/text [";. /message" "  ;= You" "    First question." "" "    A second question added through the document editor."])
    | [(testing/nat "bare conversation URL opens the native creation form" 200 status)
       (testing/nat "context keeps extra blocks authored into a message" 1
         (cord/has "A second question" (str/to_atom (conversation_response/message expanded))))]
  + phase
    \ state=namespace
    ^ [str str]
    | conversation_ui/status (fixture/flow_tests/get (conversation_tests/page).weld(['work 'first]) state) state
  + work_status
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      ready conversation_tests/prepared
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "first" "Explain this wiki.")) ready)
      request=path (conversation_tests/attempt 'first 1)
      controller=path page.weld(['work 'first])
      answer (conversation_tests/response (conversation_tests/text [";= Answer" "  Supported response."]))
      done (provider_fixture/request_tests/deliver request "complete" answer sent)
      unresolved_text (show (json/obj [(jkv "source" (json/str "")) (jkv "note" (json/str "Which database should I inspect?"))]))
      unresolved (provider_fixture/request_tests/deliver request "complete" unresolved_text sent)
      failed (provider_fixture/request_tests/deliver request "failed" "Provider unavailable" sent)
      malformed (provider_fixture/request_tests/deliver request "complete" "invalid JSON" sent)
      retry (myth/sing ['expected] (pails/n failed.case(.x request).fall(0)))
      retried (fixture/flow_tests/apply 'retry_revision request retry failed)
      paused (fixture/flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) sent)
      worker=path request.snoc('worker)
      waiting (fixture/flow_tests/poke worker (native_work_ops/status "waiting" (fixture/flow_tests/get worker sent)) sent)
      occupied (fixture/flow_tests/poke (conversation_tests/attempt 'first 2) (myth/sing ['foreign] (pails/t "Keep this record")) sent)
      collision (fixture/flow_tests/poke page.snoc('wiki) (myth/sing ['src] (pails/t ";= Changed evidence")) occupied)
      history (fixture/flow_tests/poke controller.weld(['work 'old_failure]) (fixture/flow_tests/get request failed) done)
    | [(testing/text "active native provider projects working despite controller blocked" "working" (conversation_tests/phase sent).at(0))
       (testing/text "successful publication watches instead of pretending to keep working" "watching" (conversation_tests/phase done).at(0))
       (testing/text "unresolved answer asks for input" "waiting" (conversation_tests/phase unresolved).at(0))
       (testing/text "waiting status exposes the retained provider's clarification" "Which database should I inspect?" (conversation_tests/phase unresolved).at(1))
       (testing/text "provider failure is blocked rather than waiting for user input" "blocked" (conversation_tests/phase failed).at(0))
       (testing/text "invalid provider output is blocked" "blocked" (conversation_tests/phase malformed).at(0))
       (testing/text "retry ignores the retained failed attempt" "working" (conversation_tests/phase retried).at(0))
       (testing/text "pause takes precedence over a still-running provider" "paused" (conversation_tests/phase paused).at(0))
       (testing/text "native provider waiting projects waiting for input" "waiting" (conversation_tests/phase waiting).at(0))
       (testing/text "allocation failure is blocked even with an older active worker" "blocked" (conversation_tests/phase collision).at(0))
       (testing/text "unsubscribed history cannot change current chat status" "watching" (conversation_tests/phase history).at(0))]
  + context_delivery
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      ready conversation_tests/prepared
      wiki=path page.snoc('wiki)
      large (str/cat_all [";= Large evidence" (str/from_atom 10) "  " (str/repeat 30000 "a")])
      prepared (fixture/flow_tests/poke wiki (myth/sing ['src] (pails/t large)) ready)
      source=str (fixture/flow_tests/get wiki prepared).txt_at(['src])
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "large" "Use the captured wiki evidence.")) prepared)
      attempt=path (conversation_tests/attempt 'large 1)
      context=path attempt.snoc('context)
      frozen=path (row/cons[iota] 'x context)
      expected (sovereign_care .z (row/cons[iota] 'x page.weld(['cells 'large])) sent)
      captured (sovereign_care .z frozen sent)
      changed (fixture/flow_tests/poke wiki (myth/sing ['src] (pails/t ";= Changed evidence")) sent)
      request=myth (fixture/flow_tests/get attempt sent)
      prompt=str
        ?> job=native_work/request request.pail_at(['work 'request]) ""
        job.prompt
      provider (fixture/flow_tests/get [ready.self 'gov 'conversation 'test_provider] ready)
      oversized (flow_ops/empty).put(['tasks 'reply]
        (myth/sing ['work 'prompt] (pails/t (str/repeat 24577 "a"))).put(['work 'schema] (pails/t "{}"))).put(['provider] provider)
      overflow=str
        ?> (./err why) (flow_request_ops/interactive_requests oversized) "ok"
        | str/from_atom (quip_val why)
    | [(testing/nat "large captured context still dispatches through the native worker" 1 (fixture/flow_tests/get attempt.snoc('worker) sent).has(['work 'request]))
       (testing/nat "provider prompt stays below the existing request bound" 1 (and prompt.len (le prompt.len 24576)))
       (testing/nat "prompt points at the attempt's ordinary frozen context cell" 1 (cord/has (str/to_atom (path_show frozen)) (str/to_atom prompt)))
       (testing/nat "frozen context retains the full evidence rather than truncating it" 1 (equal[axal[myth]] captured expected))
       (testing/nat "large wiki source is intact in captured context" 1
         (and (ge source.len 30000) (equal[str] source captured.get(['wiki]).fall(myth/new).txt_at(['src]))))
       (testing/nat "later wiki edits cannot replace the prior attempt's context" 1 (equal[axal[myth]] captured (sovereign_care .z frozen changed)))
       (testing/nat "physical context cell retains its x history" 1 (equal[axal[myth]] (sovereign_care .x context sent) (sovereign_peek (safe 1 .x context).spell changed)))
       (testing/nat "physical context cell retains its y history" 1 (equal[axal[myth]] (sovereign_care .y context sent) (sovereign_peek (safe 1 .y context).spell changed)))
       (testing/nat "physical context cell retains its z history" 1 (equal[axal[myth]] (sovereign_care .z context sent) (sovereign_peek (safe 1 .z context).spell changed)))
       (testing/text "oversized instructions report the actual admission problem" "flow_prompt_limit" overflow)]
  + clarification
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      controller=path page.weld(['work 'first])
      context=path page.weld(['cells 'first])
      reply=path page.weld(['replies 'first])
      request=path (conversation_tests/attempt 'first 1)
      next=path (conversation_tests/attempt 'first 2)
      document=path page.weld(['messages 'first 'clarifications 'request_1])
      ready conversation_tests/prepared
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "first" "Which database should I use?")) ready)
      waiting (provider_fixture/request_tests/deliver request "complete" (conversation_tests/response "") sent)
      old (fixture/flow_tests/get request waiting)
      hole=path old.path_at(['work 'hole_path]).fall([])
      second (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "second" "A separate question.")) waiting)
      input=myth (myth/sing ['text] (pails/t (conversation_tests/text ["Use the inventory database." "Keep the archived tables excluded."]))).put(['expected] (pails/n second.case(.x request).fall(0)))
      answered (conversation_tests/admit (conversation_ops/answer request input) second)
      via_control (conversation_tests/admit (conversation_controls/answer request
        (myth/sing ['source] (pails/t (show (goo_text/encode (goo/text/en input.txt_at(['text]))))))) waiting)
      capture (sovereign_care .z (row/cons[iota] 'x next.snoc('context)) answered)
      note (fixture/flow_tests/get document answered).txt_at(['src])
      result (conversation_tests/response (conversation_tests/text [";= Inventory" "  Using the clarified database."]))
      done (provider_fixture/request_tests/deliver next "complete" result answered)
      duplicate (conversation_ops/answer request input done)
      third (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "third" "Remember that answer.")) done)
      later_context=path (row/cons[iota] 'x page.weld(['cells 'third]))
      captured (sovereign_care .z later_context third)
      edited (fixture/flow_tests/apply 'author document
        (myth/sing ['source] (pails/t (conversation_tests/text [";= Changed clarification" "  A later edit."]))).put(['expected] (pails/n third.case(.x document).fall(0))) third)
      paused (fixture/flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) waiting)
      retried (fixture/flow_tests/apply 'retry_revision request (myth/sing ['expected] input.pail_at(['expected])) waiting)
      occupied (fixture/flow_tests/poke document.snoc('foreign) (myth/sing ['text] (pails/t "Keep this")) waiting)
      malformed (provider_fixture/request_tests/deliver request "complete" "invalid JSON" sent)
      form (show (conversation_ui/input_view controller waiting))
    | [(testing/text "answer resumes the same controller through native work" "working" (conversation_tests/phase answered).at(0))
       (testing/text "declared Goo control uses the same native answer operation" "working" (conversation_tests/phase via_control).at(0))
       (testing/nat "same subject hole selects the next native attempt" 1 (equal[maybe[path]] (fixture/flow_tests/get hole answered).path_at(['work 'attempt]) (./some next)))
       (testing/nat "answer alone does not resolve the hole" 0 (eq (fixture/flow_tests/get hole answered).txt_at(['work 'status]) "resolved"))
       (testing/nat "new attempt captures the clarification document" 1 (eq capture.get(['clarifications 'request_1]).fall(myth/new).txt_at(['src]) note))
       (testing/nat "old request including its capture and refusal stays exact" 1 (equal[myth] old (fixture/flow_tests/get request done)))
       (testing/nat "original user message stays exact" 1 (equal[myth] (fixture/flow_tests/get page.weld(['messages 'first]) waiting) (fixture/flow_tests/get page.weld(['messages 'first]) done)))
       (testing/nat "clarification does not rebind another turn" 1 (equal[maybe[nat]] second.case(.z page.weld(['work 'second])) answered.case(.z page.weld(['work 'second]))))
       (testing/text "shared hand resolves the original hole after a valid response" "resolved" (fixture/flow_tests/get hole done).txt_at(['work 'status]))
       (testing/nat "response publishes at the original destination" 1 (fixture/flow_tests/get reply done).has(['src]))
       (testing/nat "duplicate clarification is an empty admission" 1 (equal[either[iota row[[path writ]]]] duplicate (./ok [])))
       (testing/text "different duplicate cannot replace the prior answer" "conversation_answer_conflict" (fixture/flow_tests/reason (conversation_ops/answer request input.put(['text] (pails/t "Overwrite")) done)))
       (testing/text "stale request version refuses input" "flow_stale_request" (fixture/flow_tests/reason (conversation_ops/answer request input.put(['expected] (pails/n 0)) waiting)))
       (testing/text "an active attempt cannot be answered as a clarification" "conversation_not_waiting" (fixture/flow_tests/reason (conversation_ops/answer request input.put(['expected] (pails/n sent.case(.x request).fall(0))) sent)))
       (testing/text "invalid model output is not a clarification request" "conversation_not_waiting" (fixture/flow_tests/reason (conversation_ops/answer request input.put(['expected] (pails/n malformed.case(.x request).fall(0))) malformed)))
       (testing/text "paused controller refuses clarification" "flow_controller_paused" (fixture/flow_tests/reason (conversation_ops/answer request input paused)))
       (testing/text "superseded hole head refuses clarification" "flow_stale_request" (fixture/flow_tests/reason (conversation_ops/answer request input.put(['expected] (pails/n retried.case(.x request).fall(0))) retried)))
       (testing/text "occupied answer descendants are protected" "conversation_answer_collision" (fixture/flow_tests/reason (conversation_ops/answer request input occupied)))
       (testing/nat "future conversation context includes the clarification" 1 (eq captured.get(['history 'first 'clarifications 'request_1]).fall(myth/new).txt_at(['src]) note))
       (testing/nat "later edits cannot change a subsequent turn's captured clarification" 1 (equal[axal[myth]] captured (sovereign_care .z later_context edited)))
       (testing/nat "waiting turn exposes a native answer control" 1 (cord/has "/gov/conversation/answer_input" (str/to_atom form)))
       (testing/nat "active work has no clarification control" 0 (cord/has "/gov/conversation/answer_input" (str/to_atom (show (conversation_ui/input_view controller sent)))))
       (testing/nat "paused work has no clarification control" 0 (cord/has "/gov/conversation/answer_input" (str/to_atom (show (conversation_ui/input_view controller paused)))))
       (testing/nat "x history remains after answering" 1 (equal (waiting.local.x_query(waiting.local.x_case(request).fall(0) request)) (done.local.x_query(waiting.local.x_case(request).fall(0) request))))
       (testing/nat "y history remains after answering" 1 (equal (waiting.local.y_query(waiting.local.y_case(request).fall(0) request)) (done.local.y_query(waiting.local.y_case(request).fall(0) request))))
       (testing/nat "z history remains after answering" 1 (equal (waiting.local.z_query(waiting.local.z_case(request).fall(0) request)) (done.local.z_query(waiting.local.z_case(request).fall(0) request))))]
  + selection
    \ ignored=unit
    ^ row[testing/check]
    = page=path conversation_tests/page
      ready conversation_tests/prepared
      sent (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "old" "Hello")) ready)
      config (fixture/flow_tests/get page.snoc('conversation) sent)
      old config.pail_at(['chat 'definition])
      published (fixture/flow_tests/poke conversation_tests/definition
        (fixture/flow_tests/get conversation_tests/definition sent).put(['test 'revision] (pails/n 2)) sent)
      next (safe published.case(.x conversation_tests/definition).fall(0) .x conversation_tests/definition)
      input (myth/sing ['previous] old).put(['definition] next)
      selected (conversation_tests/admit (conversation_ops/select_definition page input) published)
      continued (conversation_tests/admit (conversation_ops/send page (conversation_tests/message "new" "Continue")) selected)
    | [(testing/nat "future turn selection advances explicitly" 1 (equal[pail] next (fixture/flow_tests/get page.snoc('conversation) selected).pail_at(['chat 'definition])))
       (testing/nat "selection preserves the original start receipt" 1 (equal[pail] config.pail_at(['chat 'selection]) (fixture/flow_tests/get page.snoc('conversation) selected).pail_at(['chat 'selection])))
       (testing/nat "existing occurrence keeps its captured definition" 1 (equal[pail] old (fixture/flow_tests/get page.weld(['work 'old 'view]) selected).pail_at(bond/tack)))
       (testing/nat "new turn uses the deliberately selected publication" 1 (equal[pail] next (fixture/flow_tests/get page.weld(['work 'new 'view]) continued).pail_at(bond/tack)))
       (testing/text "stale selection cannot replace a newer choice" "flow_stale_definition"
         (fixture/flow_tests/reason (conversation_ops/select_definition page input selected)))]
  + publication
    \ ignored=unit
    ^ row[testing/check]
    = ready conversation_tests/prepared
      root=path [ready.self 'app 'conversation]
      operation=path [ready.self 'gov 'conversation 'response_task]
      selected (fixture/flow_tests/get conversation_tests/definition ready)
      replaced (fixture/flow_tests/poke operation
        (myth/sing (flow_ops/key ready.self 'operation) (flow/operation ['context] conversation_response/pages)) ready)
      refreshed (conversation_tests/admit (conversation_controls/refresh root myth/new) replaced)
    | [(testing/nat "explicit refresh selects current published response operation" 1
         (equal[pail] (fixture/flow_tests/get operation ready).pail_at((flow_ops/key ready.self 'operation))
           (fixture/flow_tests/get operation refreshed).pail_at((flow_ops/key ready.self 'operation))))
       (testing/nat "behavior refresh preserves captured flow definition" 1
         (equal[myth] selected (fixture/flow_tests/get conversation_tests/definition refreshed)))
       (testing/nat "already selected operations need no writes" 1
         (equal[either[iota row[[p=path q=writ]]]] (./ok []) (conversation_controls/refresh root myth/new refreshed)))]

  + startup_roots
    \ ignored=unit
    ^ row[testing/check]
    = ready conversation_tests/prepared
      library=path [ready.self 'app 'nenex 'w 'shared_library]
      started=path [ready.self 'app 'nenex 'w 'inventory_agent]
      initial (fixture/flow_tests/apply 'author library
        (myth/sing ['source] (pails/t (conversation_tests/text [";= Shared procedures" "  Browse the children for published flows."]))) ready)
      input (myth/sing ['definition] (safe 0 .x conversation_tests/definition)).put(['provider] (safe 0 .x [ready.self 'gov 'conversation 'test_provider])).put(['roots 'library] (safe 0 .x library))
      opened (conversation_tests/admit (conversation_ops/start started input) initial)
      sent (conversation_tests/admit (conversation_ops/send started (conversation_tests/message "first" "Find a reusable procedure.")) opened)
      second (conversation_tests/admit (conversation_ops/send started (conversation_tests/message "second" "Browse again.")) sent)
      context=path started.weld(['cells 'first])
      reading (sovereign_care .z (row/cons[iota] 'x context) sent)
      request=path started.weld(['work 'first 'work 'request_1])
      captured (fixture/flow_tests/get request sent).pail_at(['capture])
      waiting (provider_fixture/request_tests/deliver request "complete" (conversation_tests/response "") sent)
      answered (conversation_tests/admit (conversation_ops/answer request
        (myth/sing ['text] (pails/t "Use the shared procedures wiki.")).put(['expected] (pails/n waiting.case(.x request).fall(0)))) waiting)
      next=path started.weld(['work 'first 'work 'request_2])
      resumed (sovereign_care .z (row/cons[iota] 'x next.snoc('context)) answered)
      resume_cell (fixture/flow_tests/get next.snoc('resumption) answered)
      resumed_prompt=str
        ?> job=native_work/request (fixture/flow_tests/get next answered).pail_at(['work 'request]) ""
        job.prompt
      changed (fixture/flow_tests/poke library (myth/sing ['src] (pails/t (conversation_tests/text [";= Shared procedures" "  A new procedure is available."]))) sent)
      reading_after (sovereign_care .z (row/cons[iota] 'x context) changed)
      late (provider_fixture/request_tests/deliver request "complete" (conversation_tests/response (conversation_tests/text [";= Old reading" "  This answer used the previous library."])) changed)
      [deleted index ack] (helm/supervisor/step library .cull 0 0 changed (sovereign_hive changed))
      deleted (fixture/flow_tests/accepted ack deleted)
      missing (sovereign_care .z (row/cons[iota] 'x context) deleted)
      restored (fixture/flow_tests/poke library (fixture/flow_tests/get library changed) deleted)
      controls (myth/sing ['name] (pails/t "inventory_controls")).put(['definition] (pails/t (path_show conversation_tests/definition))).put(['provider] (pails/t (path_show [ready.self 'gov 'conversation 'test_provider]))).put(['roots] (pails/t (show (json/obj [(jkv "library" (json/str (path_show library)))]))))
      controlled (conversation_tests/admit (conversation_controls/start [ready.self 'app 'conversation] controls) initial)
    | [(testing/nat "startup retains exact named native root reference" 1
         (equal[pail] (fixture/flow_tests/get started.snoc('conversation) opened).pail_at(['chat 'roots 'library]) (safe 0 .x library)))
       (testing/nat "startup root is an ordinary Cooperate lens input" 1
         (equal[pail] (fixture/flow_tests/get context sent).pail_at(['roots 'library]) (safe 0 .x library)))
       (testing/text "agent sees root document through the computed context cell" (fixture/flow_tests/get library sent).txt_at(['src])
         reading.get(['roots 'library]).fall(myth/new).txt_at(['src]))
       (testing/nat "agent sees navigable root address in captured startup selection" 1
         (equal[pail] reading.get(['startup]).fall(myth/new).pail_at(['chat 'roots 'library]) (safe 0 .x library)))
       (testing/text "inline clarification preserves the named root in new captured evidence"
         reading.get(['roots 'library]).fall(myth/new).txt_at(['src]) resumed.get(['roots 'library]).fall(myth/new).txt_at(['src]))
       (testing/nat "resumed evidence contains the user's clarification" 1
         resumed.get(['clarifications 'request_1]).fall(myth/new).has(['src]))
       (testing/nat "clarification links the previous attempt through the native resumption cell" 1
         (equal[pail] resume_cell.pail_at(['previous]) (safe 0 .x request)))
       (testing/nat "resumed provider receives both captured evidence and action history addresses" 1
         (and (cord/has (str/to_atom (path_show (row/cons[iota] 'x next.snoc('context)))) (str/to_atom resumed_prompt))
           (cord/has (str/to_atom (path_show (row/cons[iota] 'x next.snoc('resumption)))) (str/to_atom resumed_prompt))))
       (testing/nat "clarification with startup roots preserves the unresolved attempt" 1
         (equal[myth] (fixture/flow_tests/get request waiting) (fixture/flow_tests/get request answered)))
       (testing/text "root edits refresh existing context through native dependencies" (fixture/flow_tests/get library changed).txt_at(['src])
         reading_after.get(['roots 'library]).fall(myth/new).txt_at(['src]))
       (testing/nat "deletion removes current root evidence" 0 missing.get(['roots 'library]).fall(myth/new).has(['src]))
       (testing/nat "restoration reconnects existing lens" 1
         (sovereign_care .z (row/cons[iota] 'x context) restored).get(['roots 'library]).fall(myth/new).has(['src]))
       (testing/nat "root edits preserve old attempt capture" 1
         (equal[pail] captured (fixture/flow_tests/get request restored).pail_at(['capture])))
       (testing/nat "startup dispatches a provider worker" 1 (fixture/flow_tests/get request.snoc('worker) sent).has(['work 'request]))
       (testing/nat "startup provider captures its guard" 1 (fixture/flow_tests/get request.snoc('worker) sent).has(['fixture 'guard]))
       (testing/nat "changed root evidence settles the obsolete attempt" 1
         (native_work_ops/settled (fixture/flow_tests/get request late)))
       (testing/nat "a late answer retains the native stale refusal" 1
         (equal[pail] (fixture/flow_tests/get request late).pail_at(['flow 'refused]) (pails/q 'flow_stale_request)))
       (testing/nat "a late answer cannot publish a response" 0
         (fixture/flow_tests/get started.weld(['replies 'first]) late).has(['src]))
       (testing/nat "root evidence was captured by a real native request" 1
         (fixture/flow_tests/get request sent).has(['capture]))
       (testing/nat "another turn does not invalidate the old startup selection" 1
         (equal[axal[myth]] reading (sovereign_care .z (row/cons[iota] 'x context) second)))
       (testing/nat "x history is retained across root deletion and restoration" 1
         (equal (sent.local.x_query(sent.local.x_case(library).fall(0) library)) (restored.local.x_query(sent.local.x_case(library).fall(0) library))))
       (testing/nat "y history is retained across root deletion and restoration" 1
         (equal (sent.local.y_query(sent.local.y_case(library).fall(0) library)) (restored.local.y_query(sent.local.y_case(library).fall(0) library))))
       (testing/nat "z history is retained across root deletion and restoration" 1
         (equal (sent.local.z_query(sent.local.z_case(library).fall(0) library)) (restored.local.z_query(sent.local.z_case(library).fall(0) library))))
       (testing/nat "same startup selection is idempotent" 1
         (equal[either[iota row[[p=path q=writ]]]] (conversation_ops/start started input opened) (./ok [])))
       (testing/text "changing roots does not silently reconfigure an existing conversation" "conversation_selection_conflict"
         (fixture/flow_tests/reason (conversation_ops/start started input.del(['roots 'library]) opened)))
       (testing/text "startup refuses a missing root" "missing_context"
         (fixture/flow_tests/reason (conversation_ops/start started input.put(['roots 'library] (safe 0 .x library.snoc('absent))) initial)))
       (testing/text "root input cannot eagerly capture a subtree" "conversation_root_requires_record"
         (fixture/flow_tests/reason (conversation_ops/start started input.put(['roots 'library] (safe 0 .z library)) initial)))
       (testing/text "root alias must be a single name" "conversation_invalid_root"
         (fixture/flow_tests/reason (conversation_ops/start started input.put(['roots 'bad 'nested] (safe 0 .x library)) initial)))
       (testing/nat "Goo startup adapter binds shallow roots" 1
         (equal[pail] (fixture/flow_tests/get [ready.self 'app 'nenex 'w 'inventory_controls 'conversation] controlled).pail_at(['chat 'roots 'library]) (safe 0 .x library)))
       (testing/text "Goo refuses duplicate root aliases" "flow_duplicate_binding"
         (fixture/flow_tests/reason (conversation_controls/start [ready.self 'app 'conversation]
           controls.put(['roots] (pails/t (show (json/obj [(jkv "library" (json/str "/a")) (jkv "library" (json/str "/b"))])))) initial)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Named startup wiki roots use native context cells" conversation_tests/startup_roots)
   (testing/case "Conversation turns are projected Nenex and shared native work" conversation_tests/checks)
   (testing/case "Graph context, native holes, retry and retained history" conversation_tests/lifecycle)
   (testing/case "Projected response source and Goo share authored relationships" conversation_tests/fidelity)
   (testing/case "Declared authoring grows the conversation wiki" conversation_tests/wiki_authoring)
   (testing/case "Conversation entry point" conversation_tests/creation_route)
   (testing/case "Chat status projects current native work" conversation_tests/work_status)
   (testing/case "Clarification resumes the same native work" conversation_tests/clarification)
   (testing/case "Explicit conversation behavior publication" conversation_tests/publication)
   (testing/case "Future turns deliberately select a new retained definition" conversation_tests/selection)
   (testing/case "Large context uses retained native cells instead of oversized prompts" conversation_tests/context_delivery)]
