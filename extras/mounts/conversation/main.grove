#import plain=lib/grove/types/text

conversation =
  @role
  "/chat/title": plain

refresh =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/refresh)
  #on ; %/conversation
  ! foil
  \ conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native conversation admission.")) conversation

start_conversation =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/start)
  #on ; %/conversation
  name: plain
  definition: plain
  provider: plain
  roots: plain
  ! foil
  \ name=str definition=str provider=str roots=str conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native conversation admission.")) conversation

send_message =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/send)
  #on ; %/conversation
  source: plain
  ! foil
  \ source=str conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native turn admission.")) conversation

composer =
  @view
  #on ; %/conversation
  #for ; /sys/slot/conversation_composer
  conversation => col('/sys/slot/content) {
    group(on = conversation, action = %/send_message, myth = { '/source = .input("") }) {
      col {
        input('/source, "rich-block")
        action("Send")
      }
    }
  }

request =
  @role
  "/work/status": plain

answer_request =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/answer)
  #on ; %/request
  source: plain
  ! foil
  \ source=str request=%/request
  ^ %/request
  | Seq[%/request] (error (pails/t "Requires native clarification admission.")) request

answer_input =
  @view
  #on ; %/request
  #for ; /sys/slot/conversation_answer
  request => col('/sys/slot/content) {
    text("Provide the missing input", '/sys/slot/caption)
    group(on = request, action = %/answer_request, myth = { '/source = .input("") }) {
      col {
        input('/source, "rich-block")
        action("Answer and resume")
      }
    }
  }

create =
  @view
  #on ; %/conversation
  #for ; /sys/slot/conversation_create
  conversation => col('/sys/slot/content) {
    text("Start a conversation", '/sys/slot/title)
    text("Choose a published response flow with context and provider inputs.", '/sys/slot/caption)
    group(on = conversation, action = %/refresh) { action("Select published conversation operations") }
    group(on = conversation, action = %/start_conversation, myth = { '/name = .input(""), '/definition = .input(""), '/provider = .input(""), '/roots = .input("{}") }) {
      col {
        text("Wiki page name", '/sys/slot/label)
        input('/name, "text")
        text("Published response flow", '/sys/slot/label)
        input('/definition, "text")
        text("Interactive provider", '/sys/slot/label)
        input('/provider, "text")
        text("Wiki roots: JSON object of names to namespace paths", '/sys/slot/label)
        input('/roots, "text")
        action("Start conversation")
      }
    }
  }
