#import plain=lib/grove/types/text

conversation =
  @role
  "/chat/title": plain

refresh =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/refresh)
  #on ; %/conversation
  ! foil
  \ conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native conversation admission.")) conversation

start_conversation =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/start)
  #on ; %/conversation
  name: plain
  definition: plain
  provider: plain
  ! foil
  \ name=str definition=str provider=str conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native conversation admission.")) conversation

send_message =
  @action
  #meta ;
    "/sys/op": (namespace_op conversation_controls/send)
  #on ; %/conversation
  source: plain
  ! foil
  \ source=str conversation=%/conversation
  ^ %/conversation
  | Seq[%/conversation] (error (pails/t "Requires native turn admission.")) conversation

composer =
  @view
  #on ; %/conversation
  #for ; /sys/slot/conversation_composer
  conversation => col('/sys/slot/content) {
    group(on = conversation, action = %/send_message, myth = { '/source = .input("") }) {
      text("Message", '/sys/slot/label)
      input('/source, "rich-code")
      action("Send")
    }
  }

create =
  @view
  #on ; %/conversation
  #for ; /sys/slot/conversation_create
  conversation => col('/sys/slot/content) {
    text("Start a conversation", '/sys/slot/title)
    text("Choose a published response flow with context and provider inputs.", '/sys/slot/caption)
    group(on = conversation, action = %/refresh) { action("Select published conversation operations") }
    group(on = conversation, action = %/start_conversation, myth = { '/name = .input(""), '/definition = .input(""), '/provider = .input("") }) {
      text("Wiki page name", '/sys/slot/label)
      input('/name, "text")
      text("Published response flow", '/sys/slot/label)
      input('/definition, "text")
      text("Interactive provider", '/sys/slot/label)
      input('/provider, "text")
      action("Start conversation")
    }
  }
