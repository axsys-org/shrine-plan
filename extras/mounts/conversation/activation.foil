- conversation_ops
- conversation_response
- grove_install
- flow_install

+ conversation_mount
  + records
    \ self=iota
    ^ row[[path myth]]
    = root=path [self 'gov 'conversation]
    | [[root.snoc('context_hand) (myth/sing system_vocabulary/form conversation_context/form)]
       [root.snoc('start) (myth/sing system_vocabulary/op (namespace_op conversation_ops/start))]
       [root.snoc('send) (myth/sing system_vocabulary/op (namespace_op conversation_ops/send))]
       [root.snoc('answer) (myth/sing system_vocabulary/op (namespace_op conversation_ops/answer))]
       [root.snoc('select_definition) (myth/sing system_vocabulary/op (namespace_op conversation_ops/select_definition))]
       [root.snoc('response_task) (myth/sing (flow_ops/key self 'operation) (flow/operation ['context] conversation_response/task))]
       [root.snoc('response_pages) (myth/sing (flow_ops/key self 'operation) (flow/operation ['responses] conversation_response/pages))]]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = writes (conversation_mount/registrations state)
      home=path [state.self 'app 'conversation]
      writes (? (conversation_ops/vacant home state) writes.snoc([home (writ/make (myth/sing ['chat 'title] (pails/t "Conversations")))]) writes)
    ? (grove_install/changes writes state)
     > (./ok next) (./ok next)
     > (./err why) (./err (pails/q why))
  + registrations
    \ state=namespace
    ^ row[[p=path q=writ]]
    | (conversation_mount/records state.self).map((\ [target record] [target (writ/make record)])).keep((flow_install/changed state))
