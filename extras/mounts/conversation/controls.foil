- conversation_ops
- conversation_mount
- flow_author_controls

+ conversation_controls
  + refresh
    ' Explicit selection of this published implementation. Definitions already
    ' captured by conversations and attempts keep their original operation laws.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    ? !(equal[path] target [state.self 'app 'conversation]) (./err 'conversation_missing)
    | ./ok (conversation_mount/registrations state)
  + start
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["name" "definition" "provider" "roots"] input)
    < name (flow_ops/name (sval/word (str/to_atom input.txt_at(['name]))))
    < address (flow_ui/address input.txt_at(['definition]))
    < definition (flow_ops/origin (seg_texts address))
    < address (flow_ui/address input.txt_at(['provider]))
    < provider (flow_ops/origin (seg_texts address))
    = page=path [state.self 'app 'nenex 'w name]
      request (myth/sing ['definition] definition).put(['provider] provider)
    < roots (flow_author_controls/pairs (? (input.txt_at(['roots]).len) input.txt_at(['roots]) "{}") .false)
    < request (conversation_controls/roots roots request)
    | namespace_command/plan page [state.self 'gov 'conversation 'start] request state
  + roots
    \ pairs=row[[str str]] input=myth
    ^ either[iota myth]
    ?> (./some pair) pairs.pull (./ok input)
    = [entry rest] pair
      [name text] entry
    < path (flow_ui/address text)
    | conversation_controls/roots rest input.put(['roots ($ts name)] (safe 0 .x path))
  + send
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["source"] input)
    = record (cooperate_ops/record target state).fall(myth/new)
    ?> (./some page) record.path_at(['chat 'page]) (./err 'conversation_missing)
    ? !(equal[path] target page.snoc('conversation)) (./err 'conversation_missing)
    = id (str/cat_all ["turn_" (nat/show record.nat_at(['chat 'next] 0))])
      request (myth/sing ['id] (pails/t id)).put(['text] input.pail_at(['source]))
    | namespace_command/plan page [state.self 'gov 'conversation 'send] request state
  + answer
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["source"] input)
    = request (myth/sing ['text] input.pail_at(['source])).put(['expected] (pails/n state.case(.x target).fall(0)))
    | namespace_command/plan target [state.self 'gov 'conversation 'answer] request state
