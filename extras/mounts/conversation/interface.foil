- conversation_mount
- nenex_editor_http

' Read-only conversation arrangement. All writes use declared Goo actions;
' all message bodies are the existing Nenex document projection.
+ conversation_ui
  + reference_path
    \ slot=path record=myth
    ^ path
    ?> reference=safe record.pail_at(slot) []
    reference.path
  + turn
    \ state=namespace entry=[path myth]
    ^ json
    = [id turn] entry
      message (conversation_ui/reference_path ['chat 'message] turn)
      reply (conversation_ui/reference_path ['chat 'reply] turn)
      controller turn.path_at(['chat 'controller]).fall([])
      record (cooperate_ops/record controller state).fall(myth/new)
      response (cooperate_ops/record reply state).fall(myth/new)
    | json/obj [(jkv "id" (json/str (path_show id)))
        (jkv "sequence" (json/num .false turn.nat_at(['chat 'sequence] 0)))
        (jkv "message" (json/str (path_show message))) (jkv "reply" (json/str (path_show reply)))
        (jkv "published" (json/boo response.has(['src])))
        (jkv "messageVersion" (json/str (nat/show state.case(.z message).fall(0))))
        (jkv "replyVersion" (json/str (nat/show state.case(.z reply).fall(0))))
        (jkv "workVersion" (json/str (nat/show state.case(.z controller).fall(0))))
        (jkv "status" (json/str record.txt_at(['work 'status])))
        (jkv "reason" (json/str record.txt_at(system_vocabulary/content)))
        (jkv "controller" (json/str (path_show controller)))]
  + manifest
    \ page=path state=namespace
    ^ [nat str]
    = root=path page.snoc('conversation)
      config (cooperate_ops/record root state).fall(myth/new)
    ? !(config.has(['chat 'selection])) [404 "This Nenex page has no conversation selection."]
    = turns (sovereign_care .y root.snoc('turns) state).tap.map((conversation_ui/turn state))
    | [200 (show (json/obj [(jkv "page" (json/str (path_show page)))
        (jkv "composer" (json/str (path_show root)))
        (jkv "composerVersion" (json/str (nat/show state.case(.x root).fall(0))))
        (jkv "wiki" (json/str (path_show page.snoc('wiki))))
        (jkv "turns" (json/arr turns))]))]
  + shell
    \ page=maybe[path] self=iota
    ^ http_foot/action
    = app=path [self 'app 'conversation]
      attributes [(weft/att "id" "conversation") (weft/att "data-page" (str/to_atom page.run(path_show).fall("")))
        (weft/att "data-create" (str/to_atom (path_show app)))
        (weft/att "data-vocabulary" (str/to_atom (path_show [self 'gov 'conversation])))]
      navigation (weft/el "nav" [(weft/cls "conversation-nav")] [
        (weft/el "a" [(weft/href "/nenex")] [(weft/tx "Nenex")])
        (weft/el "a" [(weft/href "/conversation")] [(weft/tx "New conversation")])
        (weft/el "a" [(weft/att "id" "conversation-wiki") (weft/href "/nenex")] [(weft/tx "Conversation wiki")])])
      body [navigation (weft/el "main" attributes [
        (weft/el "div" [(weft/att "id" "conversation-notice") (weft/att "role" "status")] [])
        (weft/el "section" [(weft/att "id" "conversation-turns") (weft/att "aria-label" "Conversation")] [])
        (weft/el "section" [(weft/att "id" "conversation-composer") (weft/att "aria-label" "Composer")] [])])]
      assets (goo_browser/presentation_assets).weld([
        (weft/el "link" [(weft/att "rel" "stylesheet") (weft/att "href" "/conversation/style.css")] [])
        (weft/el "script" [(weft/att "src" "/static/goo-document.js") (weft/att "defer" "defer")] [])
        (weft/el "script" [(weft/att "src" "/conversation/app.js") (weft/att "defer" "defer")] [])])
    | ./bytes 200 (http_foot/bar (weft/page_with_body_attributes "Nenex conversation" assets [(weft/cls "goo-surface conversation-shell")] body)) "text/html; charset=utf-8"
  + work
    \ controller=path state=namespace
    ^ [nat str]
    = record (cooperate_ops/record controller state).fall(myth/new)
    ?> config=flow_maintenance/config record.pail_at(['flow 'config]) [404 "Choose an existing flow occurrence."]
    = requests (sovereign_care .y controller.snoc('work) state).tap
      blocks=row[json] [(nenex_editor_http/presentation controller [state.self 'gov 'flows 'authoring 'occurrence] "" .false)]
      blocks=row[json]
        | requests.fold blocks
          \ out=row[json] [relative card]
          ? !(flow_request_ops/native card) out
          = target controller.snoc('work).weld(relative)
            out out.snoc((nenex_editor_http/presentation target [state.self 'gov 'flows 'authoring 'request_status] "" .false))
          ?> (./some hole) card.path_at(['work 'hole_path]) out
          | out.snoc((nenex_editor_http/presentation hole [state.self 'gov 'nenex_tools 'hole_view] "Subject hole" .false))
      tools=row[json] [(nenex_editor_http/presentation (row/cons[iota] 'x controller.weld(['cells 'work])) [] "Cells, captured inputs and attempts" .true)
        (nenex_editor_http/presentation controller.snoc('work) [] "Retained native work and tool traces" .true)]
    | [200 (show (json/obj [(jkv "root" (json/str (path_show controller))) (jkv "blocks" (json/arr blocks)) (jkv "tools" (json/arr tools))]))]
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = parts (http_foot/split 63 request.target)
          route parts.at(0)
          name=str (? (eq route "/conversation/app.js") "app.js" (? (eq route "/conversation/style.css") "style.css" ""))
        ? name.len
          = matches files.keep((\ [key bytes] (eq key name)))
          ? !(matches.len) (./reply (http_driver/response 404 "Asset unavailable"))
          = [key bytes] matches.at(0)
          | ./bytes 200 bytes (? (eq name "app.js") "application/javascript" "text/css")
        ? !(row/has[str] route ["/conversation" "/conversation/" "/conversation/manifest" "/conversation/work"]) (./reply (http_driver/response 404 "Not found"))
        = query=str (? (eq parts.len 2) parts.at(1) "")
        ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) (./reply (http_driver/response 400 "Invalid query"))
        = fields=row[[str str]] (? query.len fields [])
        ? ((gt fields.len 1) || (fields.any((\ [key value] !(eq key "path"))))) (./reply (http_driver/response 400 "Choose one Nenex page"))
        = text (http_foot/field "path" fields)
          selected=maybe[path] (? text.len (browser_routes/value_path text) .none)
        ? (and text.len selected.is_none) (./reply (http_driver/response 400 "Invalid page path"))
        ? ((eq route "/conversation/manifest") || (eq route "/conversation/work"))
          ?> (./some page) selected (./reply (http_driver/response 400 "Choose a conversation"))
          = read (? (eq route "/conversation/work") (conversation_ui/work page) (conversation_ui/manifest page))
          | ./after read
            \ status=nat text=str
            | ./bytes status (http_foot/bar (str/to_atom text)) "application/json; charset=utf-8"
        | conversation_ui/shell selected state.self
    | http_foot/add_routes [(http_foot/route "/conversation" plan)] http_foot/empty
