{
  "version": 1,
  "name": "conversation",
  "dependencies": ["flow-authoring", "graph"],
  "modules": {
    "conversation_ops": "ops.foil",
    "conversation_context": "context.foil",
    "conversation_response": "response.foil",
    "conversation_mount": "activation.foil",
    "conversation_controls": "controls.foil",
    "conversation_interface": "interface.foil"
  },
  "roots": [
    ["lib", "conversation_ops"],
    ["lib", "conversation_context"],
    ["lib", "conversation_response"],
    ["lib", "conversation_mount"],
    ["lib", "conversation_controls"],
    ["lib", "conversation_interface"],
    ["gov", "conversation"]
  ],
  "activate": {"module": "conversation_mount", "entry": ["conversation_mount", "install"]},
  "http": {"module": "conversation_interface", "entry": ["conversation_ui", "http"]},
  "routes": ["/conversation"],
  "tests": {"conversation_tests": "tests.foil"},
  "grove": [{"root": ["gov", "conversation"], "files": ["main.grove"], "prelude": "conversation_controls"}],
  "assets": {"/conversation/app.js": "app.js", "/conversation/style.css": "style.css"},
  "files": {}
}
