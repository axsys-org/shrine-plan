- flow_nenex_ops
- conversation_context

' Conversation bookkeeping only. Each reply is an ordinary Nenex document
' maintained by the selected published flow, with native work under the page.
' No conversation-specific attempt, worker, queue or retry state machine.
+ conversation_ops
  + vacant
    \ target=path state=namespace
    ^ bool
    | and (maybe/is_none (state.case(.x target))) (eq (sovereign_peek target state).wyt 0)
  + document
    \ target=path title=nat body=row[snode] state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = source (str/from_atom (unparse [(snode/doc (seg_texts target) [] [(snode/sect title [] body)])]))
    | flow_nenex_ops/author target (myth/sing ['source] (pails/t source)) state
  + roots
    ' Startup roots are named, shallow native references. Descendants are read
    ' deliberately by the agent, not captured as an unbounded prompt subtree.
    \ input=myth page=path state=namespace
    ^ either[iota row[[path safe]]]
    = selected input.tap.keep((\ entry (pith_prefix ['roots] entry.key)))
    ? (gt selected.len 16) (./err 'conversation_root_limit)
    % todo=row[mop/kv[path pail]] selected out=row[[path safe]] []
    ^ either[iota row[[path safe]]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
    ? !(eq entry.key.len 2) (./err 'conversation_invalid_root)
    ? !(is_text entry.key.at(1)) (./err 'conversation_invalid_root)
    < name (flow_ops/name (sval/word (quip_val entry.key.at(1))))
    ? !(equal[iota] name entry.key.at(1)) (./err 'conversation_invalid_root)
    ?> source=safe entry.val (./err 'conversation_invalid_root)
    ? !(equal[care] source.care .x) (./err 'conversation_root_requires_record)
    ? (pith_prefix page source.path) (./err 'conversation_context_overlap)
    < available (cooperate_ops/resolve source state)
    ? !(available.fil.is_some) (./err 'conversation_missing_root)
    | _ rest out.snoc([entry.key source])
  + start
    \ page=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(input.tap.all((\ entry=mop/kv[path pail] ((row/has[path] entry.key [['definition] ['provider] ['subject] ['scope]]) || (pith_prefix ['roots] entry.key))))) (./err 'conversation_invalid_input)
    ? !(flow_nenex_ops/document_path page state.self) (./err 'flow_nenex_destination)
    = root page.snoc('conversation)
    ? (cooperate_ops/record root state)
     > (./some prior)
      ?> saved=cell_view prior.pail_at(['chat 'selection]) (./err 'conversation_collision)
      ? (equal[axal[myth]] (unpin saved.tree) (axal/new[myth] (./some input))) (./ok [])
      | ./err 'conversation_selection_conflict
    ? !(conversation_ops/vacant page state) (./err 'conversation_collision)
    < reference (cooperate_ops/reference ['definition] input)
    ? !(equal[care] reference.care .x) (./err 'flow_definition_record_required)
    < definition (cooperate_ops/pin_link reference state)
    < selected (cooperate_ops/resolve definition state)
    ?> compiled=flow/definition selected.fil.fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_missing_definition)
    ? !(and (eq compiled.inputs.len 2) (and (flow_ops/has 'context compiled.inputs) (flow_ops/has 'provider compiled.inputs))) (./err 'conversation_flow_ports)
    < reference (cooperate_ops/reference ['provider] input)
    ? !(equal[care] reference.care .x) (./err 'flow_missing_provider)
    < provider (cooperate_ops/pin_link reference state)
    < selected (cooperate_ops/resolve provider state)
    ?> capability=native_work/provider selected.fil.fall(myth/new).pail_at(['work 'provider]) (./err 'flow_missing_provider)
    ? (and input.has(['subject]) input.path_at(['subject]).is_none) (./err 'conversation_invalid_subject)
    ? (and input.has(['scope]) input.path_at(['scope]).is_none) (./err 'conversation_invalid_scope)
    < roots (conversation_ops/roots input page state)
    = wiki page.snoc('wiki)
      subject input.path_at(['subject]).fall(wiki)
      scope input.path_at(['scope]).fall(wiki)
    ' Keep graph-selected live context outside this conversation's outputs.
    ' Its own wiki is the intentional exception; replies and work cannot feed
    ' back into the task that produces them.
    ? (and (flow_maintenance_ops/overlaps scope page) !(pith_prefix wiki scope)) (./err 'conversation_context_overlap)
    ? (and (pith_prefix page subject) !(pith_prefix wiki subject)) (./err 'conversation_context_overlap)
    < docs (conversation_ops/document page "Conversation" [(snode/ref (seg_texts wiki) [])] state)
    < wiki_docs (conversation_ops/document wiki "Conversation wiki" [(snode/prose "Working documents and explicit references for this conversation." [])] state)
    = config (myth/sing ['chat 'selection] (cell_view (pin (axal/new[myth] (./some input)))))
      config config.put(['chat 'definition] definition).put(['chat 'provider] provider).put(['chat 'page] (pails/p page))
      config config.put(['chat 'subject] (pails/p subject)).put(['chat 'scope] (pails/p scope)).put(['chat 'next] (pails/n 0)).put(['chat 'title] (pails/t "Conversation"))
    = config (row/fold[[path safe] myth] config (\ out=myth [name source] out.put((row/cons[iota] 'chat name) source)) roots)
    | ./ok docs.weld(wiki_docs).snoc([root (writ/make config)])
  + select_definition
    ' Explicitly advance future turns. The start receipt, prior controllers and
    ' their selected definitions remain captured; occurrence adoption is separate.
    \ page=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['definition] ['previous]] input) (./err 'conversation_invalid_input)
    = root page.snoc('conversation)
      config (cooperate_ops/record root state).fall(myth/new)
    < old (cooperate_ops/reference ['chat 'definition] config)
    < previous (cooperate_ops/reference ['previous] input)
    ? !(equal[safe] old previous) (./err 'flow_stale_definition)
    < reference (cooperate_ops/reference ['definition] input)
    ? !(and (equal[care] reference.care .x) (gt reference.ver 0)) (./err 'flow_retained_definition_required)
    ? !(equal[path] old.path reference.path) (./err 'flow_unrelated_definition)
    < selected (cooperate_ops/resolve reference state)
    ?> compiled=flow/definition selected.fil.fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_missing_definition)
    ? !(and (eq compiled.inputs.len 2) (and (flow_ops/has 'context compiled.inputs) (flow_ops/has 'provider compiled.inputs))) (./err 'conversation_flow_ports)
    ? (equal[safe] old reference) (./ok [])
    | ./ok [[root (writ/poke (myth/sing ['chat 'definition] reference))]]
  + clarification_history
    \ turn=path prefix=path state=namespace
    ^ either[iota row[[path safe]]]
    % todo=row[[path myth]] (sovereign_care .y turn.snoc('clarifications) state).tap out=row[[path safe]] []
    ^ either[iota row[[path safe]]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name card] entry
    < reference (cooperate_ops/reference ['chat 'message] card)
    < reference (cooperate_ops/pin_link reference state)
    | _ rest out.snoc([prefix.weld(name) reference])
  + history
    ' Bind the versions visible when this message is sent. Later reply edits
    ' never silently rewrite what a subsequent turn was answering.
    \ root=path state=namespace
    ^ either[iota row[[path safe]]]
    % todo=row[[path myth]] (sovereign_care .y root.snoc('turns) state).tap out=row[[path safe]] []
    ^ either[iota row[[path safe]]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name turn] entry
    < receipt (cooperate_ops/pin_link (safe 0 .x root.snoc('turns).weld(name)) state)
    < message (cooperate_ops/reference ['chat 'message] turn)
    < message (cooperate_ops/pin_link message state)
    < reply (cooperate_ops/reference ['chat 'reply] turn)
    < answers (conversation_ops/clarification_history root.snoc('turns).weld(name) ['history name.at(0) 'clarifications] state)
    = out=row[[path safe]] (row/weld[[path safe]] out.weld(answers)
        [[['history name.at(0) 'turn] receipt] [['history name.at(0) 'message] message]])
    = prior (cooperate_ops/record reply.path state).fall(myth/new)
    ? !(prior.has(['src])) (_ rest out)
    < reply (cooperate_ops/pin_link reply state)
    | _ rest (row/snoc[[path safe]] [['history name.at(0) 'reply] reply] out)
  + root_binding
    \ entry=mop/kv[path pail]
    ^ row[[path safe]]
    ? !(pith_prefix ['chat 'roots] entry.key) []
    ?> source=safe entry.val []
    | [[entry.key.drop(1) source]]
  + unresolved
    \ record=myth
    ^ bool
    | and (native_work_ops/settled record)
      (equal[pail] record.pail_at(['flow 'refused]) (pails/q 'conversation_unresolved))
  + answer
    ' A clarification is new evidence for the existing occurrence. Admission
    ' checks the current hole head; its hand owns resumption and new attempts.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['text] ['expected]] input) (./err 'conversation_invalid_input)
    = text input.txt_at(['text])
    ? ((eq text.len 0) || (gt text.len 12000)) (./err 'conversation_message_limit)
    = request (cooperate_ops/record target state).fall(myth/new)
    ?> (./some owner) request.path_at(['flow 'request_controller]) (./err 'flow_missing_controller)
    ? !(and (ge owner.len 2) (and (eq target.len (add owner.len 2)) (pith_prefix owner.snoc('work) target))) (./err 'conversation_missing)
    = page=path owner.take(owner.len.dec.dec)
      id=iota owner.at(owner.len.dec)
      name=iota target.at(target.len.dec)
      turn=path page.weld(['conversation 'turns id])
      receipt=path turn.weld(['clarifications name])
      document=path page.weld(['messages id 'clarifications name])
      context=path page.weld(['cells id])
      alias=path ['clarifications name]
      original (cooperate_ops/record turn state).fall(myth/new)
    ? !(equal[maybe[path]] original.path_at(['chat 'controller]) (./some owner)) (./err 'conversation_missing)
    ? (cooperate_ops/record receipt state)
     > (./some prior)
      ?> saved=cell_view prior.pail_at(['chat 'input]) (./err 'conversation_answer_collision)
      ? (equal[axal[myth]] (unpin saved.tree) (axal/new[myth] (./some input))) (./ok [])
      | ./err 'conversation_answer_conflict
    ? !(eq input.nat_at(['expected] 0) state.case(.x target).fall(0)) (./err 'flow_stale_request)
    ? !(conversation_ops/unresolved request) (./err 'conversation_not_waiting)
    < authorized (flow_request_ops/authorize_current target request state)
    = controller (cooperate_ops/record owner state).fall(myth/new)
    ?> config=flow_maintenance/config controller.pail_at(['flow 'config]) (./err 'flow_missing_controller)
    ? !(equal[pail] (unpin config.request).pail_at(['input 'context]) (safe 0 .z (row/cons[iota] 'x context))) (./err 'conversation_context_changed)
    = lens (cooperate_ops/record context state).fall(myth/new)
    ? !(lens.has(bond/weft)) (./err 'conversation_context_missing)
    ? (lens.tap.any((\ entry (flow_maintenance_ops/overlaps alias entry.key)))) (./err 'conversation_answer_collision)
    ? !(and (conversation_ops/vacant receipt state) (conversation_ops/vacant document state)) (./err 'conversation_answer_collision)
    < captured (cooperate_ops/pin_link (safe 0 .x target) state)
    ?> (./some hole) request.path_at(['work 'hole_path]) (./err 'missing_work_hole)
    < hole_ref (cooperate_ops/pin_link (safe 0 .x hole) state)
    = content (myth/sing ['kind] (pails/t "prose")).put(['text] (goo/text/pail (goo/text/en text)))
    < docs (conversation_ops/document document "Your clarification" [(snode/prose (str/to_atom text) (rich_attrs content []))] state)
    = record (myth/sing ['chat 'input] (cell_view (pin (axal/new[myth] (./some input)))))
      record record.put(['chat 'message] (safe 0 .x document)).put(['chat 'request] captured).put(['chat 'hole] hole_ref)
      record record.put(['chat 'sequence] (pails/n state.local.top))
    | ./ok docs.weld([[receipt (writ/make record)] [context (writ/poke (myth/sing alias (safe 0 .x document)))]])
  + send
    \ page=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['id] ['text]] input) (./err 'conversation_invalid_input)
    < id (cooperate_ops/identifier input)
    = text input.txt_at(['text])
    ? ((eq text.len 0) || (gt text.len 12000)) (./err 'conversation_message_limit)
    = root=path page.snoc('conversation)
      config=myth (cooperate_ops/record root state).fall(myth/new)
      turn=path root.weld(['turns id])
    ? (cooperate_ops/record turn state)
     > (./some prior)
      ?> saved=cell_view prior.pail_at(['chat 'input]) (./err 'conversation_turn_collision)
      ? (equal[axal[myth]] (unpin saved.tree) (axal/new[myth] (./some input))) (./ok [])
      | ./err 'conversation_turn_conflict
    < definition (cooperate_ops/reference ['chat 'definition] config)
    < provider (cooperate_ops/reference ['chat 'provider] config)
    ?> (./some subject) config.path_at(['chat 'subject]) (./err 'conversation_missing)
    ?> (./some scope) config.path_at(['chat 'scope]) (./err 'conversation_missing)
    = message=path page.weld(['messages id])
      reply=path page.weld(['replies id])
      context=path page.weld(['cells id])
      controller=path page.weld(['work id])
    ? !(row/all[path] (\ path=path (conversation_ops/vacant path state)) [turn message reply context controller]) (./err 'conversation_turn_collision)
    < history (conversation_ops/history root state)
    = roots=row[[path safe]] config.tap.bind(conversation_ops/root_binding)
    < startup (cooperate_ops/pin_link (safe 0 .x root) state)
    = bindings=row[[path safe]] (row/weld[[path safe]] history [[['message] (safe 0 .x message)] [['wiki] (safe 0 .x page.snoc('wiki))] [['startup] startup]]).weld(roots)
      lens (conversation_context/lens state.self subject scope bindings)
      request (myth/sing ['definition] definition).put(['destination] (pails/p reply)).put(['writer] (safe 0 .x (flow_ops/key state.self 'nenex)))
      request request.put(['input 'context] (safe 0 .z (row/cons[iota] 'x context))).put(['input 'provider] provider)
    < follow (flow_maintenance_ops/follow controller request state)
    = content (myth/sing ['kind] (pails/t "prose")).put(['text] (goo/text/pail (goo/text/en text)))
    < message_docs (conversation_ops/document message "You" [(snode/prose (str/to_atom text) (rich_attrs content []))] state)
    = receipt (myth/sing ['chat 'input] (cell_view (pin (axal/new[myth] (./some input)))))
      receipt receipt.put(['chat 'message] (safe 0 .x message)).put(['chat 'reply] (safe 0 .x reply))
      receipt receipt.put(['chat 'controller] (pails/p controller)).put(['chat 'sequence] (pails/n config.nat_at(['chat 'next] 0)))
    = writes=row[[path writ]] [[context (writ/make lens)] [turn (writ/make receipt)]
        [root (writ/poke (myth/sing ['chat 'next] (pails/n config.nat_at(['chat 'next] 0).inc)))]]
    | ./ok (row/weld[[path writ]] message_docs (row/weld[[path writ]] writes follow))
