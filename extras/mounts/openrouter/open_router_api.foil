+ pdfparser_engine
  & pdfparser_engine/mistral_ocr
    pdfparser_engine/native
    pdfparser_engine/cloudflare_ai
    pdfparser_engine/pdf_text
    pdfparser_engine/unknown
  + mistral_ocr
    : z=nat
  + native
    : z=nat
  + cloudflare_ai
    : z=nat
  + pdf_text
    : z=nat
  + unknown
    : s=str
+ pdfparser_engine_r
  & pdfparser_engine_r/ok
    pdfparser_engine_r/err
  + ok
    : v=pdfparser_engine
  + err
    : path=str
      why=str
+ pdfparser_engine_from
  '  Decode a pdfparser_engine; an undeclared value rides in
  '  unknown, which encodes back to the same string.  A
  '  non-string is still an error: the schema does say string.
  \ v=json
    p=str
  ^ pdfparser_engine_r
  ? v
    > t=json/str
      ? (eq t.s "mistral-ocr")
        (pdfparser_engine_r/ok (pdfparser_engine/mistral_ocr 0))
      ? (eq t.s "native")
        (pdfparser_engine_r/ok (pdfparser_engine/native 0))
      ? (eq t.s "cloudflare-ai")
        (pdfparser_engine_r/ok (pdfparser_engine/cloudflare_ai 0))
      ? (eq t.s "pdf-text")
        (pdfparser_engine_r/ok (pdfparser_engine/pdf_text 0))
      (pdfparser_engine_r/ok (pdfparser_engine/unknown t.s))
    (pdfparser_engine_r/err p "expected-string")
+ pdfparser_engine_to
  \ x=pdfparser_engine
  ^ json
  ? x
    > e_mistral_ocr=pdfparser_engine/mistral_ocr
