+ chat_assistant_message_from
  '  Decode a chat_assistant_message from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ chat_assistant_message_r
  ? v
    > o=json/obj
      ? (d_opt_chat_audio_output (jget "audio" o.kvs) (jpath p "audio"))
        > (./err path0=str why0=str)
          (chat_assistant_message_r/err path0 why0)
        > (./ok v0=maybe[chat_audio_output])
          ? (d_opt_chat_assistant_message_content (jget "content" o.kvs) (jpath p "content"))
            > (./err path1=str why1=str)
              (chat_assistant_message_r/err path1 why1)
            > (./ok v1=maybe[chat_assistant_message_content])
              ? (d_opt_row_chat_assistant_images_item (jget "images" o.kvs) (jpath p "images"))
                > (./err path2=str why2=str)
                  (chat_assistant_message_r/err path2 why2)
                > (./ok v2=maybe[row[chat_assistant_images_item]])
                  ? (d_opt_str (jget "model" o.kvs) (jpath p "model"))
                    > (./err path3=str why3=str)
                      (chat_assistant_message_r/err path3 why3)
                    > (./ok v3=maybe[str])
                      ? (d_opt_str (jget "name" o.kvs) (jpath p "name"))
                        > (./err path4=str why4=str)
                          (chat_assistant_message_r/err path4 why4)
                        > (./ok v4=maybe[str])
                          ? (d_opt_str (jget "reasoning" o.kvs) (jpath p "reasoning"))
                            > (./err path5=str why5=str)
                              (chat_assistant_message_r/err path5 why5)
                            > (./ok v5=maybe[str])
                              ? (d_opt_row_reasoning_detail_union (jget "reasoning_details" o.kvs) (jpath p "reasoning_details"))
                                > (./err path6=str why6=str)
                                  (chat_assistant_message_r/err path6 why6)
                                > (./ok v6=maybe[row[reasoning_detail_union]])
                                  ? (d_opt_str (jget "refusal" o.kvs) (jpath p "refusal"))
                                    > (./err path7=str why7=str)
                                      (chat_assistant_message_r/err path7 why7)
                                    > (./ok v7=maybe[str])
                                      ? (d_req_str (jget "role" o.kvs) (jpath p "role"))
                                        > (./err path8=str why8=str)
                                          (chat_assistant_message_r/err path8 why8)
                                        > (./ok v8=str)
                                          ? (d_opt_row_chat_tool_call (jget "tool_calls" o.kvs) (jpath p "tool_calls"))
                                            > (./err path9=str why9=str)
                                              (chat_assistant_message_r/err path9 why9)
                                            > (./ok v9=maybe[row[chat_tool_call]])
                                              (chat_assistant_message_r/ok (chat_assistant_message v0 v1 v2 v3 v4 v5 v6 v7 v8 v9))
    (chat_assistant_message_r/err p "expected-object")
+ chat_assistant_message_to
  \ x=chat_assistant_message
  ^ json
  k0=[]
  k1=(? x.audio
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "audio" (chat_audio_output_to w0))))
  k2=(? x.content
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "content" (chat_assistant_message_content_to w1))))
  k3=(? x.images
        > .none
          k2
        > (./some w2)
          a2=(% i2=nat
                0
                b2=row[json]
                []
              ? (eq i2 w2.len)
                b2
              (_ i2.inc b2.snoc((chat_assistant_images_item_to w2.at(i2)))))
          k2.snoc((jkv "images" (json/arr a2))))
  k4=(? x.model
        > .none
          k3
        > (./some w3)
          k3.snoc((jkv "model" (json/str w3))))
  k5=(? x.name
        > .none
          k4
        > (./some w4)
          k4.snoc((jkv "name" (json/str w4))))
  k6=(? x.reasoning
        > .none
          k5
        > (./some w5)
          k5.snoc((jkv "reasoning" (json/str w5))))
  k7=(? x.reasoning_details
        > .none
          k6
        > (./some w6)
          a6=(% i6=nat
                0
                b6=row[json]
                []
              ? (eq i6 w6.len)
                b6
              (_ i6.inc b6.snoc((reasoning_detail_union_to w6.at(i6)))))
          k6.snoc((jkv "reasoning_details" (json/arr a6))))
  k8=(? x.refusal
        > .none
          k7
        > (./some w7)
          k7.snoc((jkv "refusal" (json/str w7))))
  k9=k8.snoc((jkv "role" (json/str x.role)))
  k10=(? x.tool_calls
         > .none
           k9
         > (./some w9)
           a9=(% i9=nat
                 0
                 b9=row[json]
                 []
               ? (eq i9 w9.len)
                 b9
               (_ i9.inc b9.snoc((chat_tool_call_to w9.at(i9)))))
           k9.snoc((jkv "tool_calls" (json/arr a9))))
  (json/obj k10)
