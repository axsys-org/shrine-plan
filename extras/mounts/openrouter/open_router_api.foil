+ chat_json_schema_config
  : description=maybe[str]
    name=str
    schema=maybe[json]
    strict=maybe[bool]
+ chat_json_schema_config_r
  & chat_json_schema_config_r/ok
    chat_json_schema_config_r/err
  + ok
    : v=chat_json_schema_config
  + err
    : path=str
      why=str
+ chat_json_schema_config_from
  '  Decode a chat_json_schema_config from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ chat_json_schema_config_r
  ? v
    > o=json/obj
      ? (d_opt_str (jget "description" o.kvs) (jpath p "description"))
        > (./err path0=str why0=str)
          (chat_json_schema_config_r/err path0 why0)
        > (./ok v0=maybe[str])
          ? (d_req_str (jget "name" o.kvs) (jpath p "name"))
            > (./err path1=str why1=str)
              (chat_json_schema_config_r/err path1 why1)
            > (./ok v1=str)
              ? (d_opt_any (jget "schema" o.kvs) (jpath p "schema"))
                > (./err path2=str why2=str)
                  (chat_json_schema_config_r/err path2 why2)
                > (./ok v2=maybe[json])
                  ? (d_opt_boo (jget "strict" o.kvs) (jpath p "strict"))
                    > (./err path3=str why3=str)
                      (chat_json_schema_config_r/err path3 why3)
                    > (./ok v3=maybe[bool])
                      (chat_json_schema_config_r/ok (chat_json_schema_config v0 v1 v2 v3))
    (chat_json_schema_config_r/err p "expected-object")
+ chat_json_schema_config_to
  \ x=chat_json_schema_config
  ^ json
  k0=[]
  k1=(? x.description
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "description" (json/str w0))))
  k2=k1.snoc((jkv "name" (json/str x.name)))
  k3=(? x.schema
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "schema" w2)))
  k4=(? x.strict
        > .none
          k3
        > (./some w3)
          k3.snoc((jkv "strict" (json/boo w3))))
  (json/obj k4)
