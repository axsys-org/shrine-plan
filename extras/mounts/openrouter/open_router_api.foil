  k3=(? x.region
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "region" (json/str w2))))
  k4=(? x.timezone
        > .none
          k3
        > (./some w3)
          k3.snoc((jkv "timezone" (json/str w3))))
  k5=(? x.type
        > .none
          k4
        > (./some w4)
          k4.snoc((jkv "type" (json/str w4))))
  (json/obj k5)
+ context_compression_engine
  & context_compression_engine/middle_out
    context_compression_engine/unknown
  + middle_out
    : z=nat
  + unknown
    : s=str
+ context_compression_engine_r
  & context_compression_engine_r/ok
    context_compression_engine_r/err
  + ok
    : v=context_compression_engine
  + err
    : path=str
      why=str
+ context_compression_engine_from
  '  Decode a context_compression_engine; an undeclared value rides in
  '  unknown, which encodes back to the same string.  A
  '  non-string is still an error: the schema does say string.
  \ v=json
    p=str
  ^ context_compression_engine_r
  ? v
    > t=json/str
      ? (eq t.s "middle-out")
        (context_compression_engine_r/ok (context_compression_engine/middle_out 0))
      (context_compression_engine_r/ok (context_compression_engine/unknown t.s))
    (context_compression_engine_r/err p "expected-string")
+ context_compression_engine_to
  \ x=context_compression_engine
  ^ json
  ? x
    > e_middle_out=context_compression_engine/middle_out
      (json/str "middle-out")
    > e_unknown=context_compression_engine/unknown
      (json/str e_unknown.s)
    (json/str "middle-out")
+ prediction_content_text
  : text=str
    type=str
+ prediction_content_text_r
  & prediction_content_text_r/ok
    prediction_content_text_r/err
  + ok
    : v=prediction_content_text
  + err
    : path=str
      why=str
+ prediction_content_text_from
  '  Decode a prediction_content_text from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ prediction_content_text_r
  ? v
    > o=json/obj
      ? (d_req_str (jget "text" o.kvs) (jpath p "text"))
        > (./err path0=str why0=str)
          (prediction_content_text_r/err path0 why0)
        > (./ok v0=str)
          ? (d_req_str (jget "type" o.kvs) (jpath p "type"))
            > (./err path1=str why1=str)
              (prediction_content_text_r/err path1 why1)
            > (./ok v1=str)
              (prediction_content_text_r/ok (prediction_content_text v0 v1))
    (prediction_content_text_r/err p "expected-object")
+ prediction_content_text_to
  \ x=prediction_content_text
  ^ json
  k0=[]
  k1=k0.snoc((jkv "text" (json/str x.text)))
  k2=k1.snoc((jkv "type" (json/str x.type)))
  (json/obj k2)
