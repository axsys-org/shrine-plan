+ provider_preferences_to
  \ x=provider_preferences
  ^ json
  k0=[]
  k1=(? x.allow_fallbacks
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "allow_fallbacks" (json/boo w0))))
  k2=(? x.data_collection
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "data_collection" (provider_preferences_data_collection_to w1))))
  k3=(? x.enforce_distillable_text
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "enforce_distillable_text" (json/boo w2))))
  k4=(? x.ignore
        > .none
          k3
        > (./some w3)
          a3=(% i3=nat
                0
                b3=row[json]
                []
              ? (eq i3 w3.len)
                b3
              (_ i3.inc b3.snoc((provider_preferences_ignore_to w3.at(i3)))))
          k3.snoc((jkv "ignore" (json/arr a3))))
  k5=(? x.max_price
        > .none
          k4
        > (./some w4)
          k4.snoc((jkv "max_price" (provider_preferences_max_price_to w4))))
  k6=(? x.only
        > .none
          k5
        > (./some w5)
          a5=(% i5=nat
                0
                b5=row[json]
                []
              ? (eq i5 w5.len)
                b5
              (_ i5.inc b5.snoc((provider_preferences_only_to w5.at(i5)))))
          k5.snoc((jkv "only" (json/arr a5))))
  k7=(? x.order
        > .none
          k6
        > (./some w6)
          a6=(% i6=nat
                0
                b6=row[json]
                []
              ? (eq i6 w6.len)
                b6
              (_ i6.inc b6.snoc((provider_preferences_order_to w6.at(i6)))))
          k6.snoc((jkv "order" (json/arr a6))))
  k8=(? x.preferred_max_latency
        > .none
          k7
        > (./some w7)
          k7.snoc((jkv "preferred_max_latency" (preferred_max_latency_to w7))))
  k9=(? x.preferred_min_throughput
        > .none
          k8
        > (./some w8)
          k8.snoc((jkv "preferred_min_throughput" (preferred_min_throughput_to w8))))
  k10=(? x.quantizations
         > .none
           k9
         > (./some w9)
           a9=(% i9=nat
                 0
                 b9=row[json]
                 []
               ? (eq i9 w9.len)
                 b9
               (_ i9.inc b9.snoc((quantization_to w9.at(i9)))))
           k9.snoc((jkv "quantizations" (json/arr a9))))
  k11=(? x.require_parameters
         > .none
           k10
         > (./some w10)
           k10.snoc((jkv "require_parameters" (json/boo w10))))
  k12=(? x.sort
         > .none
           k11
         > (./some w11)
           k11.snoc((jkv "sort" (provider_preferences_sort_to w11))))
  k13=(? x.zdr
         > .none
           k12
         > (./some w12)
           k12.snoc((jkv "zdr" (json/boo w12))))
  (json/obj k13)
