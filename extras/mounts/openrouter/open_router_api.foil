                    (chat_content_items_r/err path why)
                  > (./ok av=chat_content_file)
                    (chat_content_items_r/ok (chat_content_items/file av))
              (chat_content_items_r/ok (chat_content_items/unknown v))
            (chat_content_items_r/err p "tag-not-a-string")
