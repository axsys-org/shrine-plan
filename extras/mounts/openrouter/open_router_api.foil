+ quantization
  & quantization/int4
    quantization/int8
    quantization/fp4
    quantization/mxfp4
    quantization/nvfp4
    quantization/fp6
    quantization/fp8
    quantization/mxfp8
    quantization/fp16
    quantization/bf16
    quantization/fp32
    quantization/unknown
    quantization/unknown_
  + int4
    : z=nat
  + int8
    : z=nat
  + fp4
    : z=nat
  + mxfp4
    : z=nat
  + nvfp4
    : z=nat
  + fp6
    : z=nat
  + fp8
    : z=nat
  + mxfp8
    : z=nat
  + fp16
    : z=nat
  + bf16
    : z=nat
  + fp32
    : z=nat
  + unknown
    : z=nat
  + unknown_
    : s=str
+ quantization_r
  & quantization_r/ok
    quantization_r/err
  + ok
    : v=quantization
  + err
    : path=str
      why=str
+ quantization_from
  '  Decode a quantization; an undeclared value rides in
  '  unknown_, which encodes back to the same string.  A
  '  non-string is still an error: the schema does say string.
  \ v=json
    p=str
  ^ quantization_r
  ? v
    > t=json/str
      ? (eq t.s "int4")
        (quantization_r/ok (quantization/int4 0))
      ? (eq t.s "int8")
        (quantization_r/ok (quantization/int8 0))
      ? (eq t.s "fp4")
        (quantization_r/ok (quantization/fp4 0))
      ? (eq t.s "mxfp4")
        (quantization_r/ok (quantization/mxfp4 0))
      ? (eq t.s "nvfp4")
        (quantization_r/ok (quantization/nvfp4 0))
      ? (eq t.s "fp6")
        (quantization_r/ok (quantization/fp6 0))
      ? (eq t.s "fp8")
        (quantization_r/ok (quantization/fp8 0))
      ? (eq t.s "mxfp8")
        (quantization_r/ok (quantization/mxfp8 0))
      ? (eq t.s "fp16")
        (quantization_r/ok (quantization/fp16 0))
      ? (eq t.s "bf16")
        (quantization_r/ok (quantization/bf16 0))
      ? (eq t.s "fp32")
        (quantization_r/ok (quantization/fp32 0))
      ? (eq t.s "unknown")
        (quantization_r/ok (quantization/unknown 0))
      (quantization_r/ok (quantization/unknown_ t.s))
    (quantization_r/err p "expected-string")
+ quantization_to
  \ x=quantization
  ^ json
  ? x
    > e_int4=quantization/int4
      (json/str "int4")
    > e_int8=quantization/int8
      (json/str "int8")
    > e_fp4=quantization/fp4
      (json/str "fp4")
    > e_mxfp4=quantization/mxfp4
      (json/str "mxfp4")
    > e_nvfp4=quantization/nvfp4
      (json/str "nvfp4")
    > e_fp6=quantization/fp6
      (json/str "fp6")
    > e_fp8=quantization/fp8
      (json/str "fp8")
    > e_mxfp8=quantization/mxfp8
      (json/str "mxfp8")
    > e_fp16=quantization/fp16
      (json/str "fp16")
    > e_bf16=quantization/bf16
      (json/str "bf16")
    > e_fp32=quantization/fp32
      (json/str "fp32")
    > e_unknown=quantization/unknown
      (json/str "unknown")
    > e_unknown_=quantization/unknown_
      (json/str e_unknown_.s)
    (json/str "int4")
