+ chat_request_response_format_from
  '  Decode a chat_request_response_format by its type tag; an
  '  unrecognised tag rides undecoded.
  \ v=json
    p=str
  ^ chat_request_response_format_r
  ? v
    > o=json/obj
      ? (jget "type" o.kvs)
        > .none
          (chat_request_response_format_r/err p "missing-tag")
        > (./some tj=json)
          ? tj
            > ts=json/str
              ? (eq ts.s "text")
                ? (chat_format_text_config_from v p)
                  > (./err path=str why=str)
                    (chat_request_response_format_r/err path why)
                  > (./ok av=chat_format_text_config)
                    (chat_request_response_format_r/ok (chat_request_response_format/text av))
              ? (eq ts.s "json_object")
                ? (chat_format_json_object_config_from v p)
                  > (./err path=str why=str)
                    (chat_request_response_format_r/err path why)
                  > (./ok av=chat_format_json_object_config)
                    (chat_request_response_format_r/ok (chat_request_response_format/json_object av))
              ? (eq ts.s "json_schema")
                ? (chat_format_json_schema_config_from v p)
                  > (./err path=str why=str)
                    (chat_request_response_format_r/err path why)
                  > (./ok av=chat_format_json_schema_config)
                    (chat_request_response_format_r/ok (chat_request_response_format/json_schema av))
              ? (eq ts.s "grammar")
                ? (chat_format_grammar_config_from v p)
                  > (./err path=str why=str)
                    (chat_request_response_format_r/err path why)
                  > (./ok av=chat_format_grammar_config)
                    (chat_request_response_format_r/ok (chat_request_response_format/grammar av))
              ? (eq ts.s "python")
                ? (chat_format_python_config_from v p)
                  > (./err path=str why=str)
                    (chat_request_response_format_r/err path why)
                  > (./ok av=chat_format_python_config)
                    (chat_request_response_format_r/ok (chat_request_response_format/python av))
              (chat_request_response_format_r/ok (chat_request_response_format/unknown v))
            (chat_request_response_format_r/err p "tag-not-a-string")
    (chat_request_response_format_r/err p "expected-object")
+ chat_request_response_format_to
  \ x=chat_request_response_format
  ^ json
  ? x
    > u_text=chat_request_response_format/text
