'  Generated by schemagen.  The schema is the source of truth;
'  there is no source file to edit.
+ jget
  '  The value at key k, if present.
  \ k=str
    kvs=row[jkv]
  ^ maybe[json]
  % i=nat
    0
  ^ maybe[json]
  ? (eq i kvs.len)
    .none
  e=kvs.at(i)
  ? (eq e.k k)
    (./some e.v)
  (_ i.inc)
+ jpath
  '  Breadcrumb: p.f, or f at the root.
  \ p=str
    f=str
  ^ str
  ? (eq p 0)
    f
  (str/cat f (str/cat "." p))
+ jidx
  '  Breadcrumb: p[i].
  \ p=str
    i=nat
  ^ str
  (str/cat "]" (str/cat (nat/show i) (str/cat "[" p)))
