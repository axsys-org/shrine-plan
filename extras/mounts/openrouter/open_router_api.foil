+ chat_messages
  & chat_messages/system
    chat_messages/user
    chat_messages/developer
    chat_messages/assistant
    chat_messages/tool
    chat_messages/unknown
  + system
    : v=chat_system_message
  + user
    : v=chat_user_message
  + developer
    : v=chat_developer_message
  + assistant
    : v=chat_assistant_message
  + tool
    : v=chat_tool_message
  + unknown
    : v=json
+ chat_messages_r
  & chat_messages_r/ok
    chat_messages_r/err
  + ok
    : v=chat_messages
  + err
    : path=str
      why=str
+ chat_messages_from
  '  Decode a chat_messages by its role tag; an
  '  unrecognised tag rides undecoded.
  \ v=json
    p=str
  ^ chat_messages_r
  ? v
    > o=json/obj
      ? (jget "role" o.kvs)
        > .none
          (chat_messages_r/err p "missing-tag")
        > (./some tj=json)
          ? tj
            > ts=json/str
              ? (eq ts.s "system")
                ? (chat_system_message_from v p)
                  > (./err path=str why=str)
                    (chat_messages_r/err path why)
                  > (./ok av=chat_system_message)
                    (chat_messages_r/ok (chat_messages/system av))
              ? (eq ts.s "user")
                ? (chat_user_message_from v p)
                  > (./err path=str why=str)
                    (chat_messages_r/err path why)
                  > (./ok av=chat_user_message)
                    (chat_messages_r/ok (chat_messages/user av))
              ? (eq ts.s "developer")
                ? (chat_developer_message_from v p)
                  > (./err path=str why=str)
                    (chat_messages_r/err path why)
                  > (./ok av=chat_developer_message)
                    (chat_messages_r/ok (chat_messages/developer av))
              ? (eq ts.s "assistant")
                ? (chat_assistant_message_from v p)
                  > (./err path=str why=str)
                    (chat_messages_r/err path why)
                  > (./ok av=chat_assistant_message)
                    (chat_messages_r/ok (chat_messages/assistant av))
              ? (eq ts.s "tool")
                ? (chat_tool_message_from v p)
                  > (./err path=str why=str)
                    (chat_messages_r/err path why)
                  > (./ok av=chat_tool_message)
                    (chat_messages_r/ok (chat_messages/tool av))
              (chat_messages_r/ok (chat_messages/unknown v))
            (chat_messages_r/err p "tag-not-a-string")
    (chat_messages_r/err p "expected-object")
+ chat_messages_to
  \ x=chat_messages
  ^ json
  ? x
    > u_system=chat_messages/system
      (chat_system_message_to u_system.v)
    > u_user=chat_messages/user
      (chat_user_message_to u_user.v)
    > u_developer=chat_messages/developer
      (chat_developer_message_to u_developer.v)
    > u_assistant=chat_messages/assistant
      (chat_assistant_message_to u_assistant.v)
    > u_tool=chat_messages/tool
      (chat_tool_message_to u_tool.v)
    > u_unknown=chat_messages/unknown
      u_unknown.v
