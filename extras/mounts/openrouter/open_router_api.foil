    > e_native=pdfparser_engine/native
      (json/str "native")
    > e_cloudflare_ai=pdfparser_engine/cloudflare_ai
      (json/str "cloudflare-ai")
    > e_pdf_text=pdfparser_engine/pdf_text
      (json/str "pdf-text")
    > e_unknown=pdfparser_engine/unknown
      (json/str e_unknown.s)
    (json/str "mistral-ocr")
