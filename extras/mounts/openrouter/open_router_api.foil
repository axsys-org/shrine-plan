                    (chat_function_tool_r/err path why)
                  > (./ok av=image_generation_server_tool_open_router)
                    (chat_function_tool_r/ok (chat_function_tool/openrouter_image_generation av))
              ? (eq ts.s "openrouter:experimental__search_models")
                ? (chat_search_models_server_tool_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=chat_search_models_server_tool)
                    (chat_function_tool_r/ok (chat_function_tool/openrouter_experimental_search_models av))
              ? (eq ts.s "openrouter:subagent")
                ? (subagent_server_tool_open_router_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=subagent_server_tool_open_router)
                    (chat_function_tool_r/ok (chat_function_tool/openrouter_subagent av))
              ? (eq ts.s "openrouter:web_fetch")
                ? (web_fetch_server_tool_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=web_fetch_server_tool)
                    (chat_function_tool_r/ok (chat_function_tool/openrouter_web_fetch av))
              ? (eq ts.s "openrouter:web_search")
                ? (open_router_web_search_server_tool_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=open_router_web_search_server_tool)
                    (chat_function_tool_r/ok (chat_function_tool/openrouter_web_search av))
              ? (eq ts.s "web_search")
                ? (chat_web_search_shorthand_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=chat_web_search_shorthand)
                    (chat_function_tool_r/ok (chat_function_tool/web_search av))
              ? (eq ts.s "web_search_preview")
                ? (chat_web_search_shorthand_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=chat_web_search_shorthand)
                    (chat_function_tool_r/ok (chat_function_tool/web_search av))
              ? (eq ts.s "web_search_preview_2025_03_11")
                ? (chat_web_search_shorthand_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=chat_web_search_shorthand)
                    (chat_function_tool_r/ok (chat_function_tool/web_search av))
              ? (eq ts.s "web_search_2025_08_26")
                ? (chat_web_search_shorthand_from v p)
                  > (./err path=str why=str)
                    (chat_function_tool_r/err path why)
                  > (./ok av=chat_web_search_shorthand)
                    (chat_function_tool_r/ok (chat_function_tool/web_search av))
              (chat_function_tool_r/ok (chat_function_tool/unknown v))
            (chat_function_tool_r/err p "tag-not-a-string")
    (chat_function_tool_r/err p "expected-object")
+ chat_function_tool_to
  \ x=chat_function_tool
  ^ json
  ? x
    > u_function=chat_function_tool/function
      (chat_function_tool_function_to u_function.v)
    > u_openrouter_advisor=chat_function_tool/openrouter_advisor
      (advisor_server_tool_open_router_to u_openrouter_advisor.v)
