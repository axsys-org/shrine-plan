+ chat_system_message
  : content=chat_system_message_content
    name=maybe[str]
    role=str
+ chat_system_message_r
  & chat_system_message_r/ok
    chat_system_message_r/err
  + ok
    : v=chat_system_message
  + err
    : path=str
      why=str
+ d_req_chat_system_message_content
  \ m=maybe[json]
    p=str
  ^ chat_system_message_content_r
  ? m
    > .none
      (chat_system_message_content_r/err p "missing")
    > (./some j)
      (chat_system_message_content_from j p)
+ chat_system_message_from
  '  Decode a chat_system_message from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ chat_system_message_r
  ? v
    > o=json/obj
      ? (d_req_chat_system_message_content (jget "content" o.kvs) (jpath p "content"))
        > (./err path0=str why0=str)
          (chat_system_message_r/err path0 why0)
        > (./ok v0=chat_system_message_content)
          ? (d_opt_str (jget "name" o.kvs) (jpath p "name"))
            > (./err path1=str why1=str)
              (chat_system_message_r/err path1 why1)
            > (./ok v1=maybe[str])
              ? (d_req_str (jget "role" o.kvs) (jpath p "role"))
                > (./err path2=str why2=str)
                  (chat_system_message_r/err path2 why2)
                > (./ok v2=str)
                  (chat_system_message_r/ok (chat_system_message v0 v1 v2))
    (chat_system_message_r/err p "expected-object")
+ chat_system_message_to
  \ x=chat_system_message
  ^ json
  k0=[]
  k1=k0.snoc((jkv "content" (chat_system_message_content_to x.content)))
  k2=(? x.name
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "name" (json/str w1))))
  k3=k2.snoc((jkv "role" (json/str x.role)))
  (json/obj k3)
+ r_row_chat_content_items
  & r_row_chat_content_items/ok
    r_row_chat_content_items/err
  + ok
    : v=row[chat_content_items]
  + err
    : path=str
      why=str
+ d_val_row_chat_content_items
  \ j=json
    p=str
  ^ r_row_chat_content_items
  ? j
    > t=json/arr
      % i=nat
        0
        out=row[chat_content_items]
        []
      ^ r_row_chat_content_items
      ? (eq i t.xs.len)
        (r_row_chat_content_items/ok out)
      ? (chat_content_items_from t.xs.at(i) (jidx p i))
        > (./err path=str why=str)
          (r_row_chat_content_items/err path why)
        > (./ok v=chat_content_items)
          (_ i.inc out.snoc(v))
    (r_row_chat_content_items/err p "expected-array")
+ chat_user_message_content
  & chat_user_message_content/str
    chat_user_message_content/arr
    chat_user_message_content/unknown
  + str
    : v=str
  + arr
    : v=row[chat_content_items]
  + unknown
    : v=json
+ chat_user_message_content_r
  & chat_user_message_content_r/ok
    chat_user_message_content_r/err
  + ok
    : v=chat_user_message_content
  + err
    : path=str
      why=str
+ chat_user_message_content_from
  '  Decode a chat_user_message_content by the json constructor it
  '  arrived as; any other shape rides undecoded.
  \ v=json
    p=str
  ^ chat_user_message_content_r
  ? v
    > j_str=json/str
      ? (d_val_str v p)
        > (./err path=str why=str)
          (chat_user_message_content_r/err path why)
        > (./ok av=str)
          (chat_user_message_content_r/ok (chat_user_message_content/str av))
    > j_arr=json/arr
      ? (d_val_row_chat_content_items v p)
        > (./err path=str why=str)
          (chat_user_message_content_r/err path why)
        > (./ok av=row[chat_content_items])
          (chat_user_message_content_r/ok (chat_user_message_content/arr av))
    (chat_user_message_content_r/ok (chat_user_message_content/unknown v))
+ chat_user_message_content_to
  \ x=chat_user_message_content
  ^ json
  ? x
    > u_str=chat_user_message_content/str
      (json/str u_str.v)
    > u_arr=chat_user_message_content/arr
      (json/arr (% i1=nat
                   0
                   b1=row[json]
                   []
                 ? (eq i1 u_arr.v.len)
                   b1
                 (_ i1.inc b1.snoc((chat_content_items_to u_arr.v.at(i1))))))
    > u_unknown=chat_user_message_content/unknown
      u_unknown.v
