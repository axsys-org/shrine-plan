+ aabenchmark_entry
  : agentic_index=maybe[str]
    coding_index=maybe[str]
    intelligence_index=maybe[str]
+ aabenchmark_entry_r
  & aabenchmark_entry_r/ok
    aabenchmark_entry_r/err
  + ok
    : v=aabenchmark_entry
  + err
    : path=str
      why=str
+ aabenchmark_entry_from
  '  Decode a aabenchmark_entry from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ aabenchmark_entry_r
  ? v
    > o=json/obj
      ? (d_opt_num (jget "agentic_index" o.kvs) (jpath p "agentic_index"))
        > (./err path0=str why0=str)
          (aabenchmark_entry_r/err path0 why0)
        > (./ok v0=maybe[str])
          ? (d_opt_num (jget "coding_index" o.kvs) (jpath p "coding_index"))
            > (./err path1=str why1=str)
              (aabenchmark_entry_r/err path1 why1)
            > (./ok v1=maybe[str])
              ? (d_opt_num (jget "intelligence_index" o.kvs) (jpath p "intelligence_index"))
                > (./err path2=str why2=str)
                  (aabenchmark_entry_r/err path2 why2)
                > (./ok v2=maybe[str])
                  (aabenchmark_entry_r/ok (aabenchmark_entry v0 v1 v2))
    (aabenchmark_entry_r/err p "expected-object")
+ aabenchmark_entry_to
  \ x=aabenchmark_entry
  ^ json
  k0=[]
  k1=(? x.agentic_index
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "agentic_index" (json/real w0))))
  k2=(? x.coding_index
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "coding_index" (json/real w1))))
  k3=(? x.intelligence_index
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "intelligence_index" (json/real w2))))
  (json/obj k3)
+ dabenchmark_entry
  : arena=str
    category=str
    elo=str
    rank=nat
    win_rate=str
+ dabenchmark_entry_r
  & dabenchmark_entry_r/ok
    dabenchmark_entry_r/err
  + ok
    : v=dabenchmark_entry
  + err
    : path=str
      why=str
+ dabenchmark_entry_from
  '  Decode a dabenchmark_entry from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ dabenchmark_entry_r
  ? v
    > o=json/obj
      ? (d_req_str (jget "arena" o.kvs) (jpath p "arena"))
        > (./err path0=str why0=str)
          (dabenchmark_entry_r/err path0 why0)
        > (./ok v0=str)
          ? (d_req_str (jget "category" o.kvs) (jpath p "category"))
            > (./err path1=str why1=str)
              (dabenchmark_entry_r/err path1 why1)
            > (./ok v1=str)
              ? (d_req_num (jget "elo" o.kvs) (jpath p "elo"))
                > (./err path2=str why2=str)
                  (dabenchmark_entry_r/err path2 why2)
                > (./ok v2=str)
                  ? (d_req_int (jget "rank" o.kvs) (jpath p "rank"))
                    > (./err path3=str why3=str)
                      (dabenchmark_entry_r/err path3 why3)
                    > (./ok v3=nat)
