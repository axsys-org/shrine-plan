+ d_val_row_parameter
  \ j=json
    p=str
  ^ r_row_parameter
  ? j
    > t=json/arr
      % i=nat
        0
        out=row[parameter]
        []
      ^ r_row_parameter
      ? (eq i t.xs.len)
        (r_row_parameter/ok out)
      ? (parameter_from t.xs.at(i) (jidx p i))
        > (./err path=str why=str)
          (r_row_parameter/err path why)
        > (./ok v=parameter)
          (_ i.inc out.snoc(v))
    (r_row_parameter/err p "expected-array")
