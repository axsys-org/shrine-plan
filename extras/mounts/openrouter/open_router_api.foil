    > (./some j)
      (d_val_boo j p)
+ top_provider_info_from
  '  Decode a top_provider_info from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ top_provider_info_r
  ? v
    > o=json/obj
      ? (d_opt_int (jget "context_length" o.kvs) (jpath p "context_length"))
        > (./err path0=str why0=str)
          (top_provider_info_r/err path0 why0)
        > (./ok v0=maybe[nat])
          ? (d_req_boo (jget "is_moderated" o.kvs) (jpath p "is_moderated"))
            > (./err path1=str why1=str)
              (top_provider_info_r/err path1 why1)
            > (./ok v1=bool)
              ? (d_opt_int (jget "max_completion_tokens" o.kvs) (jpath p "max_completion_tokens"))
                > (./err path2=str why2=str)
                  (top_provider_info_r/err path2 why2)
                > (./ok v2=maybe[nat])
                  (top_provider_info_r/ok (top_provider_info v0 v1 v2))
    (top_provider_info_r/err p "expected-object")
+ top_provider_info_to
  \ x=top_provider_info
  ^ json
  k0=[]
  k1=(? x.context_length
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "context_length" (json/num .false w0))))
  k2=k1.snoc((jkv "is_moderated" (json/boo x.is_moderated)))
  k3=(? x.max_completion_tokens
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "max_completion_tokens" (json/num .false w2))))
  (json/obj k3)
