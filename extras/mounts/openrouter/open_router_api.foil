+ open_router_metadata_to
  \ x=open_router_metadata
  ^ json
  k0=[]
  k1=k0.snoc((jkv "attempt" (json/num .false x.attempt)))
  k2=(? x.attempts
        > .none
          k1
        > (./some w1)
          a1=(% i1=nat
                0
                b1=row[json]
                []
              ? (eq i1 w1.len)
                b1
              (_ i1.inc b1.snoc((router_attempt_to w1.at(i1)))))
          k1.snoc((jkv "attempts" (json/arr a1))))
  k3=k2.snoc((jkv "endpoints" (endpoints_metadata_to x.endpoints)))
  k4=k3.snoc((jkv "is_byok" (json/boo x.is_byok)))
  k5=(? x.params
        > .none
          k4
        > (./some w4)
          k4.snoc((jkv "params" (router_params_to w4))))
  k6=(? x.pipeline
        > .none
          k5
        > (./some w5)
          a5=(% i5=nat
                0
                b5=row[json]
                []
              ? (eq i5 w5.len)
                b5
              (_ i5.inc b5.snoc((pipeline_stage_to w5.at(i5)))))
          k5.snoc((jkv "pipeline" (json/arr a5))))
  k7=(? x.region
        > .none
          k6
        > (./some w6)
          k6.snoc((jkv "region" (json/str w6))))
  k8=k7.snoc((jkv "requested" (json/str x.requested)))
  k9=k8.snoc((jkv "strategy" (routing_strategy_to x.strategy)))
  k10=k9.snoc((jkv "summary" (json/str x.summary)))
  (json/obj k10)
