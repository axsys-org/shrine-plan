        > (./ok v0=chat_tool_message_content)
          ? (d_req_str (jget "role" o.kvs) (jpath p "role"))
            > (./err path1=str why1=str)
              (chat_tool_message_r/err path1 why1)
            > (./ok v1=str)
              ? (d_req_str (jget "tool_call_id" o.kvs) (jpath p "tool_call_id"))
                > (./err path2=str why2=str)
                  (chat_tool_message_r/err path2 why2)
                > (./ok v2=str)
