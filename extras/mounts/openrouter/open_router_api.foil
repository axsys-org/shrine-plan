    (chat_tool_message_r/err p "expected-object")
+ chat_tool_message_to
  \ x=chat_tool_message
  ^ json
  k0=[]
  k1=k0.snoc((jkv "content" (chat_tool_message_content_to x.content)))
  k2=k1.snoc((jkv "role" (json/str x.role)))
