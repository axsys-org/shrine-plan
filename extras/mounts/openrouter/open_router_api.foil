+ chat_request_from
  '  Decode a chat_request from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ chat_request_r
  ? v
    > o=json/obj
      ? (d_opt_anthropic_cache_control_directive (jget "cache_control" o.kvs) (jpath p "cache_control"))
        > (./err path0=str why0=str)
          (chat_request_r/err path0 why0)
        > (./ok v0=maybe[anthropic_cache_control_directive])
          ? (d_opt_chat_debug_options (jget "debug" o.kvs) (jpath p "debug"))
            > (./err path1=str why1=str)
              (chat_request_r/err path1 why1)
            > (./ok v1=maybe[chat_debug_options])
              ? (d_opt_num (jget "frequency_penalty" o.kvs) (jpath p "frequency_penalty"))
                > (./err path2=str why2=str)
                  (chat_request_r/err path2 why2)
                > (./ok v2=maybe[str])
                  ? (d_opt_any (jget "image_config" o.kvs) (jpath p "image_config"))
                    > (./err path3=str why3=str)
                      (chat_request_r/err path3 why3)
                    > (./ok v3=maybe[json])
                      ? (d_opt_any (jget "logit_bias" o.kvs) (jpath p "logit_bias"))
                        > (./err path4=str why4=str)
                          (chat_request_r/err path4 why4)
                        > (./ok v4=maybe[json])
                          ? (d_opt_boo (jget "logprobs" o.kvs) (jpath p "logprobs"))
                            > (./err path5=str why5=str)
                              (chat_request_r/err path5 why5)
                            > (./ok v5=maybe[bool])
                              ? (d_opt_int (jget "max_completion_tokens" o.kvs) (jpath p "max_completion_tokens"))
                                > (./err path6=str why6=str)
                                  (chat_request_r/err path6 why6)
                                > (./ok v6=maybe[nat])
                                  ? (d_opt_int (jget "max_tokens" o.kvs) (jpath p "max_tokens"))
                                    > (./err path7=str why7=str)
                                      (chat_request_r/err path7 why7)
                                    > (./ok v7=maybe[nat])
                                      ? (d_req_row_chat_messages (jget "messages" o.kvs) (jpath p "messages"))
                                        > (./err path8=str why8=str)
                                          (chat_request_r/err path8 why8)
                                        > (./ok v8=row[chat_messages])
                                          ? (d_opt_any (jget "metadata" o.kvs) (jpath p "metadata"))
                                            > (./err path9=str why9=str)
                                              (chat_request_r/err path9 why9)
                                            > (./ok v9=maybe[json])
                                              ? (d_opt_num (jget "min_p" o.kvs) (jpath p "min_p"))
                                                > (./err path10=str why10=str)
                                                  (chat_request_r/err path10 why10)
                                                > (./ok v10=maybe[str])
                                                  ? (d_opt_row_chat_request_modalities (jget "modalities" o.kvs) (jpath p "modalities"))
                                                    > (./err path11=str why11=str)
                                                      (chat_request_r/err path11 why11)
                                                    > (./ok v11=maybe[row[chat_request_modalities]])
                                                      ? (d_opt_str (jget "model" o.kvs) (jpath p "model"))
                                                        > (./err path12=str why12=str)
                                                          (chat_request_r/err path12 why12)
                                                        > (./ok v12=maybe[str])
                                                          ? (d_opt_row_str (jget "models" o.kvs) (jpath p "models"))
                                                            > (./err path13=str why13=str)
                                                              (chat_request_r/err path13 why13)
                                                            > (./ok v13=maybe[row[str]])
                                                              ? (d_opt_boo (jget "parallel_tool_calls" o.kvs) (jpath p "parallel_tool_calls"))
                                                                > (./err path14=str why14=str)
                                                                  (chat_request_r/err path14 why14)
                                                                > (./ok v14=maybe[bool])
                                                                  ? (d_opt_row_chat_request_plugins (jget "plugins" o.kvs) (jpath p "plugins"))
                                                                    > (./err path15=str why15=str)
                                                                      (chat_request_r/err path15 why15)
                                                                    > (./ok v15=maybe[row[chat_request_plugins]])
                                                                      ? (d_opt_prediction (jget "prediction" o.kvs) (jpath p "prediction"))
                                                                        > (./err path16=str why16=str)
                                                                          (chat_request_r/err path16 why16)
                                                                        > (./ok v16=maybe[prediction])
                                                                          ? (d_opt_num (jget "presence_penalty" o.kvs) (jpath p "presence_penalty"))
                                                                            > (./err path17=str why17=str)
                                                                              (chat_request_r/err path17 why17)
                                                                            > (./ok v17=maybe[str])
                                                                              ? (d_opt_str (jget "prompt_cache_key" o.kvs) (jpath p "prompt_cache_key"))
                                                                                > (./err path18=str why18=str)
                                                                                  (chat_request_r/err path18 why18)
                                                                                > (./ok v18=maybe[str])
                                                                                  ? (d_opt_prompt_cache_options (jget "prompt_cache_options" o.kvs) (jpath p "prompt_cache_options"))
                                                                                    > (./err path19=str why19=str)
                                                                                      (chat_request_r/err path19 why19)
                                                                                    > (./ok v19=maybe[prompt_cache_options])
                                                                                      ? (d_opt_provider_preferences (jget "provider" o.kvs) (jpath p "provider"))
                                                                                        > (./err path20=str why20=str)
                                                                                          (chat_request_r/err path20 why20)
                                                                                        > (./ok v20=maybe[provider_preferences])
                                                                                          ? (d_opt_chat_request_reasoning (jget "reasoning" o.kvs) (jpath p "reasoning"))
                                                                                            > (./err path21=str why21=str)
                                                                                              (chat_request_r/err path21 why21)
                                                                                            > (./ok v21=maybe[chat_request_reasoning])
                                                                                              ? (d_opt_chat_request_reasoning_effort (jget "reasoning_effort" o.kvs) (jpath p "reasoning_effort"))
                                                                                                > (./err path22=str why22=str)
                                                                                                  (chat_request_r/err path22 why22)
                                                                                                > (./ok v22=maybe[chat_request_reasoning_effort])
                                                                                                  ? (d_opt_num (jget "repetition_penalty" o.kvs) (jpath p "repetition_penalty"))
                                                                                                    > (./err path23=str why23=str)
                                                                                                      (chat_request_r/err path23 why23)
                                                                                                    > (./ok v23=maybe[str])
                                                                                                      ? (d_opt_chat_request_response_format (jget "response_format" o.kvs) (jpath p "response_format"))
                                                                                                        > (./err path24=str why24=str)
                                                                                                          (chat_request_r/err path24 why24)
                                                                                                        > (./ok v24=maybe[chat_request_response_format])
                                                                                                          ? (d_opt_deprecated_route (jget "route" o.kvs) (jpath p "route"))
                                                                                                            > (./err path25=str why25=str)
                                                                                                              (chat_request_r/err path25 why25)
                                                                                                            > (./ok v25=maybe[deprecated_route])
                                                                                                              ? (d_opt_int (jget "seed" o.kvs) (jpath p "seed"))
                                                                                                                > (./err path26=str why26=str)
                                                                                                                  (chat_request_r/err path26 why26)
                                                                                                                > (./ok v26=maybe[nat])
                                                                                                                  ? (d_opt_chat_request_service_tier (jget "service_tier" o.kvs) (jpath p "service_tier"))
                                                                                                                    > (./err path27=str why27=str)
                                                                                                                      (chat_request_r/err path27 why27)
                                                                                                                    > (./ok v27=maybe[chat_request_service_tier])
                                                                                                                      ? (d_opt_str (jget "session_id" o.kvs) (jpath p "session_id"))
                                                                                                                        > (./err path28=str why28=str)
                                                                                                                          (chat_request_r/err path28 why28)
                                                                                                                        > (./ok v28=maybe[str])
                                                                                                                          ? (d_opt_chat_request_stop (jget "stop" o.kvs) (jpath p "stop"))
                                                                                                                            > (./err path29=str why29=str)
                                                                                                                              (chat_request_r/err path29 why29)
                                                                                                                            > (./ok v29=maybe[chat_request_stop])
                                                                                                                              ? (d_opt_row_stop_server_tools_when_condition (jget "stop_server_tools_when" o.kvs) (jpath p "stop_server_tools_when"))
                                                                                                                                > (./err path30=str why30=str)
                                                                                                                                  (chat_request_r/err path30 why30)
                                                                                                                                > (./ok v30=maybe[row[stop_server_tools_when_condition]])
                                                                                                                                  ? (d_opt_boo (jget "stream" o.kvs) (jpath p "stream"))
                                                                                                                                    > (./err path31=str why31=str)
                                                                                                                                      (chat_request_r/err path31 why31)
                                                                                                                                    > (./ok v31=maybe[bool])
                                                                                                                                      ? (d_opt_chat_stream_options (jget "stream_options" o.kvs) (jpath p "stream_options"))
                                                                                                                                        > (./err path32=str why32=str)
                                                                                                                                          (chat_request_r/err path32 why32)
                                                                                                                                        > (./ok v32=maybe[chat_stream_options])
                                                                                                                                          ? (d_opt_num (jget "temperature" o.kvs) (jpath p "temperature"))
                                                                                                                                            > (./err path33=str why33=str)
                                                                                                                                              (chat_request_r/err path33 why33)
                                                                                                                                            > (./ok v33=maybe[str])
                                                                                                                                              ? (d_opt_chat_tool_choice (jget "tool_choice" o.kvs) (jpath p "tool_choice"))
                                                                                                                                                > (./err path34=str why34=str)
                                                                                                                                                  (chat_request_r/err path34 why34)
                                                                                                                                                > (./ok v34=maybe[chat_tool_choice])
                                                                                                                                                  ? (d_opt_row_chat_function_tool (jget "tools" o.kvs) (jpath p "tools"))
                                                                                                                                                    > (./err path35=str why35=str)
                                                                                                                                                      (chat_request_r/err path35 why35)
                                                                                                                                                    > (./ok v35=maybe[row[chat_function_tool]])
                                                                                                                                                      ? (d_opt_num (jget "top_a" o.kvs) (jpath p "top_a"))
                                                                                                                                                        > (./err path36=str why36=str)
                                                                                                                                                          (chat_request_r/err path36 why36)
                                                                                                                                                        > (./ok v36=maybe[str])
                                                                                                                                                          ? (d_opt_int (jget "top_k" o.kvs) (jpath p "top_k"))
                                                                                                                                                            > (./err path37=str why37=str)
                                                                                                                                                              (chat_request_r/err path37 why37)
                                                                                                                                                            > (./ok v37=maybe[nat])
                                                                                                                                                              ? (d_opt_int (jget "top_logprobs" o.kvs) (jpath p "top_logprobs"))
                                                                                                                                                                > (./err path38=str why38=str)
                                                                                                                                                                  (chat_request_r/err path38 why38)
                                                                                                                                                                > (./ok v38=maybe[nat])
                                                                                                                                                                  ? (d_opt_num (jget "top_p" o.kvs) (jpath p "top_p"))
                                                                                                                                                                    > (./err path39=str why39=str)
                                                                                                                                                                      (chat_request_r/err path39 why39)
                                                                                                                                                                    > (./ok v39=maybe[str])
                                                                                                                                                                      ? (d_opt_trace_config (jget "trace" o.kvs) (jpath p "trace"))
                                                                                                                                                                        > (./err path40=str why40=str)
                                                                                                                                                                          (chat_request_r/err path40 why40)
                                                                                                                                                                        > (./ok v40=maybe[trace_config])
                                                                                                                                                                          ? (d_opt_str (jget "user" o.kvs) (jpath p "user"))
                                                                                                                                                                            > (./err path41=str why41=str)
                                                                                                                                                                              (chat_request_r/err path41 why41)
                                                                                                                                                                            > (./ok v41=maybe[str])
                                                                                                                                                                              (chat_request_r/ok (chat_request v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15 v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31 v32 v33 v34 v35 v36 v37 v38 v39 v40 v41))
    (chat_request_r/err p "expected-object")
+ chat_request_to
  \ x=chat_request
  ^ json
  k0=[]
  k1=(? x.cache_control
        > .none
          k0
        > (./some w0)
          k0.snoc((jkv "cache_control" (anthropic_cache_control_directive_to w0))))
  k2=(? x.debug
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "debug" (chat_debug_options_to w1))))
  k3=(? x.frequency_penalty
        > .none
          k2
        > (./some w2)
          k2.snoc((jkv "frequency_penalty" (json/real w2))))
  k4=(? x.image_config
        > .none
          k3
        > (./some w3)
          k3.snoc((jkv "image_config" w3)))
  k5=(? x.logit_bias
        > .none
          k4
        > (./some w4)
          k4.snoc((jkv "logit_bias" w4)))
  k6=(? x.logprobs
        > .none
          k5
        > (./some w5)
          k5.snoc((jkv "logprobs" (json/boo w5))))
  k7=(? x.max_completion_tokens
        > .none
          k6
        > (./some w6)
          k6.snoc((jkv "max_completion_tokens" (json/num .false w6))))
  k8=(? x.max_tokens
        > .none
          k7
        > (./some w7)
          k7.snoc((jkv "max_tokens" (json/num .false w7))))
  a8=(% i8=nat
        0
        b8=row[json]
        []
      ? (eq i8 x.messages.len)
        b8
      (_ i8.inc b8.snoc((chat_messages_to x.messages.at(i8)))))
  k9=k8.snoc((jkv "messages" (json/arr a8)))
  k10=(? x.metadata
         > .none
           k9
         > (./some w9)
           k9.snoc((jkv "metadata" w9)))
  k11=(? x.min_p
         > .none
           k10
         > (./some w10)
           k10.snoc((jkv "min_p" (json/real w10))))
  k12=(? x.modalities
         > .none
           k11
         > (./some w11)
           a11=(% i11=nat
                  0
                  b11=row[json]
                  []
                ? (eq i11 w11.len)
                  b11
                (_ i11.inc b11.snoc((chat_request_modalities_to w11.at(i11)))))
           k11.snoc((jkv "modalities" (json/arr a11))))
  k13=(? x.model
         > .none
           k12
         > (./some w12)
           k12.snoc((jkv "model" (json/str w12))))
  k14=(? x.models
         > .none
           k13
         > (./some w13)
           a13=(% i13=nat
                  0
                  b13=row[json]
                  []
                ? (eq i13 w13.len)
                  b13
                (_ i13.inc b13.snoc((json/str w13.at(i13)))))
           k13.snoc((jkv "models" (json/arr a13))))
  k15=(? x.parallel_tool_calls
         > .none
           k14
         > (./some w14)
           k14.snoc((jkv "parallel_tool_calls" (json/boo w14))))
  k16=(? x.plugins
         > .none
           k15
         > (./some w15)
           a15=(% i15=nat
                  0
                  b15=row[json]
                  []
                ? (eq i15 w15.len)
                  b15
                (_ i15.inc b15.snoc((chat_request_plugins_to w15.at(i15)))))
           k15.snoc((jkv "plugins" (json/arr a15))))
  k17=(? x.prediction
         > .none
           k16
         > (./some w16)
           k16.snoc((jkv "prediction" (prediction_to w16))))
  k18=(? x.presence_penalty
         > .none
           k17
         > (./some w17)
           k17.snoc((jkv "presence_penalty" (json/real w17))))
  k19=(? x.prompt_cache_key
         > .none
           k18
         > (./some w18)
           k18.snoc((jkv "prompt_cache_key" (json/str w18))))
  k20=(? x.prompt_cache_options
         > .none
           k19
         > (./some w19)
           k19.snoc((jkv "prompt_cache_options" (prompt_cache_options_to w19))))
  k21=(? x.provider
         > .none
           k20
         > (./some w20)
           k20.snoc((jkv "provider" (provider_preferences_to w20))))
  k22=(? x.reasoning
         > .none
           k21
         > (./some w21)
           k21.snoc((jkv "reasoning" (chat_request_reasoning_to w21))))
  k23=(? x.reasoning_effort
         > .none
           k22
         > (./some w22)
           k22.snoc((jkv "reasoning_effort" (chat_request_reasoning_effort_to w22))))
  k24=(? x.repetition_penalty
         > .none
           k23
         > (./some w23)
           k23.snoc((jkv "repetition_penalty" (json/real w23))))
  k25=(? x.response_format
         > .none
           k24
         > (./some w24)
           k24.snoc((jkv "response_format" (chat_request_response_format_to w24))))
  k26=(? x.route
         > .none
           k25
         > (./some w25)
           k25.snoc((jkv "route" (deprecated_route_to w25))))
  k27=(? x.seed
         > .none
           k26
         > (./some w26)
           k26.snoc((jkv "seed" (json/num .false w26))))
  k28=(? x.service_tier
         > .none
           k27
         > (./some w27)
           k27.snoc((jkv "service_tier" (chat_request_service_tier_to w27))))
  k29=(? x.session_id
         > .none
           k28
         > (./some w28)
           k28.snoc((jkv "session_id" (json/str w28))))
  k30=(? x.stop
         > .none
           k29
         > (./some w29)
           k29.snoc((jkv "stop" (chat_request_stop_to w29))))
  k31=(? x.stop_server_tools_when
         > .none
           k30
         > (./some w30)
           a30=(% i30=nat
                  0
                  b30=row[json]
                  []
                ? (eq i30 w30.len)
                  b30
                (_ i30.inc b30.snoc((stop_server_tools_when_condition_to w30.at(i30)))))
           k30.snoc((jkv "stop_server_tools_when" (json/arr a30))))
  k32=(? x.stream
         > .none
           k31
         > (./some w31)
           k31.snoc((jkv "stream" (json/boo w31))))
  k33=(? x.stream_options
         > .none
           k32
         > (./some w32)
           k32.snoc((jkv "stream_options" (chat_stream_options_to w32))))
  k34=(? x.temperature
         > .none
           k33
         > (./some w33)
           k33.snoc((jkv "temperature" (json/real w33))))
  k35=(? x.tool_choice
         > .none
           k34
         > (./some w34)
           k34.snoc((jkv "tool_choice" (chat_tool_choice_to w34))))
  k36=(? x.tools
         > .none
           k35
         > (./some w35)
           a35=(% i35=nat
                  0
                  b35=row[json]
                  []
                ? (eq i35 w35.len)
                  b35
                (_ i35.inc b35.snoc((chat_function_tool_to w35.at(i35)))))
           k35.snoc((jkv "tools" (json/arr a35))))
  k37=(? x.top_a
         > .none
           k36
         > (./some w36)
           k36.snoc((jkv "top_a" (json/real w36))))
  k38=(? x.top_k
         > .none
           k37
         > (./some w37)
           k37.snoc((jkv "top_k" (json/num .false w37))))
  k39=(? x.top_logprobs
         > .none
           k38
         > (./some w38)
           k38.snoc((jkv "top_logprobs" (json/num .false w38))))
  k40=(? x.top_p
         > .none
           k39
         > (./some w39)
           k39.snoc((jkv "top_p" (json/real w39))))
  k41=(? x.trace
         > .none
           k40
         > (./some w40)
           k40.snoc((jkv "trace" (trace_config_to w40))))
  k42=(? x.user
         > .none
           k41
         > (./some w41)
           k41.snoc((jkv "user" (json/str w41))))
  (json/obj k42)
+ chat_result
  : choices=row[chat_choice]
    created=nat
    id=str
    model=str
    object=str
    openrouter_metadata=maybe[open_router_metadata]
    service_tier=maybe[str]
    system_fingerprint=maybe[str]
    usage=maybe[chat_usage]
+ chat_result_r
  & chat_result_r/ok
    chat_result_r/err
  + ok
    : v=chat_result
  + err
    : path=str
      why=str
+ r_o_open_router_metadata
  & r_o_open_router_metadata/ok
    r_o_open_router_metadata/err
  + ok
    : v=maybe[open_router_metadata]
  + err
    : path=str
      why=str
+ d_opt_open_router_metadata
  \ m=maybe[json]
    p=str
  ^ r_o_open_router_metadata
  ? m
    > .none
      (r_o_open_router_metadata/ok .none)
    > (./some j)
      ? j
        > z=json/nul
          (r_o_open_router_metadata/ok .none)
        ? (open_router_metadata_from j p)
          > (./err path=str why=str)
            (r_o_open_router_metadata/err path why)
          > (./ok v=open_router_metadata)
            (r_o_open_router_metadata/ok (./some v))
+ r_o_chat_usage
  & r_o_chat_usage/ok
    r_o_chat_usage/err
  + ok
    : v=maybe[chat_usage]
  + err
    : path=str
      why=str
+ d_opt_chat_usage
  \ m=maybe[json]
    p=str
  ^ r_o_chat_usage
  ? m
    > .none
      (r_o_chat_usage/ok .none)
    > (./some j)
      ? j
        > z=json/nul
          (r_o_chat_usage/ok .none)
        ? (chat_usage_from j p)
          > (./err path=str why=str)
            (r_o_chat_usage/err path why)
          > (./ok v=chat_usage)
            (r_o_chat_usage/ok (./some v))
+ r_row_chat_choice
  & r_row_chat_choice/ok
    r_row_chat_choice/err
  + ok
    : v=row[chat_choice]
  + err
    : path=str
      why=str
+ d_val_row_chat_choice
  \ j=json
    p=str
  ^ r_row_chat_choice
  ? j
    > t=json/arr
      % i=nat
        0
        out=row[chat_choice]
        []
      ^ r_row_chat_choice
      ? (eq i t.xs.len)
        (r_row_chat_choice/ok out)
      ? (chat_choice_from t.xs.at(i) (jidx p i))
        > (./err path=str why=str)
          (r_row_chat_choice/err path why)
        > (./ok v=chat_choice)
          (_ i.inc out.snoc(v))
    (r_row_chat_choice/err p "expected-array")
+ d_req_row_chat_choice
  \ m=maybe[json]
    p=str
  ^ r_row_chat_choice
  ? m
    > .none
      (r_row_chat_choice/err p "missing")
    > (./some j)
      (d_val_row_chat_choice j p)
+ chat_result_from
  '  Decode a chat_result from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ chat_result_r
  ? v
    > o=json/obj
      ? (d_req_row_chat_choice (jget "choices" o.kvs) (jpath p "choices"))
        > (./err path0=str why0=str)
          (chat_result_r/err path0 why0)
        > (./ok v0=row[chat_choice])
          ? (d_req_int (jget "created" o.kvs) (jpath p "created"))
            > (./err path1=str why1=str)
              (chat_result_r/err path1 why1)
            > (./ok v1=nat)
              ? (d_req_str (jget "id" o.kvs) (jpath p "id"))
                > (./err path2=str why2=str)
                  (chat_result_r/err path2 why2)
                > (./ok v2=str)
                  ? (d_req_str (jget "model" o.kvs) (jpath p "model"))
                    > (./err path3=str why3=str)
                      (chat_result_r/err path3 why3)
                    > (./ok v3=str)
                      ? (d_req_str (jget "object" o.kvs) (jpath p "object"))
                        > (./err path4=str why4=str)
                          (chat_result_r/err path4 why4)
                        > (./ok v4=str)
                          ? (d_opt_open_router_metadata (jget "openrouter_metadata" o.kvs) (jpath p "openrouter_metadata"))
                            > (./err path5=str why5=str)
                              (chat_result_r/err path5 why5)
                            > (./ok v5=maybe[open_router_metadata])
                              ? (d_opt_str (jget "service_tier" o.kvs) (jpath p "service_tier"))
                                > (./err path6=str why6=str)
                                  (chat_result_r/err path6 why6)
                                > (./ok v6=maybe[str])
                                  ? (d_opt_str (jget "system_fingerprint" o.kvs) (jpath p "system_fingerprint"))
                                    > (./err path7=str why7=str)
                                      (chat_result_r/err path7 why7)
                                    > (./ok v7=maybe[str])
                                      ? (d_opt_chat_usage (jget "usage" o.kvs) (jpath p "usage"))
                                        > (./err path8=str why8=str)
                                          (chat_result_r/err path8 why8)
                                        > (./ok v8=maybe[chat_usage])
                                          (chat_result_r/ok (chat_result v0 v1 v2 v3 v4 v5 v6 v7 v8))
    (chat_result_r/err p "expected-object")
+ chat_result_to
  \ x=chat_result
  ^ json
  k0=[]
  a0=(% i0=nat
        0
        b0=row[json]
        []
      ? (eq i0 x.choices.len)
        b0
      (_ i0.inc b0.snoc((chat_choice_to x.choices.at(i0)))))
  k1=k0.snoc((jkv "choices" (json/arr a0)))
  k2=k1.snoc((jkv "created" (json/num .false x.created)))
  k3=k2.snoc((jkv "id" (json/str x.id)))
  k4=k3.snoc((jkv "model" (json/str x.model)))
  k5=k4.snoc((jkv "object" (json/str x.object)))
  k6=(? x.openrouter_metadata
        > .none
          k5
        > (./some w5)
          k5.snoc((jkv "openrouter_metadata" (open_router_metadata_to w5))))
  k7=(? x.service_tier
        > .none
          k6
        > (./some w6)
          k6.snoc((jkv "service_tier" (json/str w6))))
  k8=(? x.system_fingerprint
        > .none
          k7
        > (./some w7)
          k7.snoc((jkv "system_fingerprint" (json/str w7))))
  k9=(? x.usage
        > .none
          k8
        > (./some w8)
          k8.snoc((jkv "usage" (chat_usage_to w8))))
  (json/obj k9)
+ parse_models_list_response
  '  Decode a models_list_response from JSON text.
  \ s=str
  ^ models_list_response_r
  ? (parse s)
    > (./err why=str rest=nat)
      (models_list_response_r/err "" why)
    > (./ok v=json rest=nat)
      (models_list_response_from v "")
+ parse_chat_result
  '  Decode a chat_result from JSON text.
  \ s=str
  ^ chat_result_r
  ? (parse s)
    > (./err why=str rest=nat)
      (chat_result_r/err "" why)
    > (./ok v=json rest=nat)
      (chat_result_from v "")
