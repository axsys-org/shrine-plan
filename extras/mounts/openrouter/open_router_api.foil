    > (./some j)
      (d_val_row_parameter j p)
+ model_from
  '  Decode a model from a json value; p is the
  '  breadcrumb prefix.
  \ v=json
    p=str
  ^ model_r
  ? v
    > o=json/obj
      ? (d_req_model_architecture (jget "architecture" o.kvs) (jpath p "architecture"))
        > (./err path0=str why0=str)
          (model_r/err path0 why0)
        > (./ok v0=model_architecture)
          ? (d_opt_model_benchmarks (jget "benchmarks" o.kvs) (jpath p "benchmarks"))
            > (./err path1=str why1=str)
              (model_r/err path1 why1)
            > (./ok v1=maybe[model_benchmarks])
              ? (d_req_str (jget "canonical_slug" o.kvs) (jpath p "canonical_slug"))
                > (./err path2=str why2=str)
                  (model_r/err path2 why2)
                > (./ok v2=str)
                  ? (d_opt_int (jget "context_length" o.kvs) (jpath p "context_length"))
                    > (./err path3=str why3=str)
                      (model_r/err path3 why3)
                    > (./ok v3=maybe[nat])
                      ? (d_req_int (jget "created" o.kvs) (jpath p "created"))
                        > (./err path4=str why4=str)
                          (model_r/err path4 why4)
                        > (./ok v4=nat)
                          ? (d_opt_default_parameters (jget "default_parameters" o.kvs) (jpath p "default_parameters"))
                            > (./err path5=str why5=str)
                              (model_r/err path5 why5)
                            > (./ok v5=maybe[default_parameters])
                              ? (d_opt_str (jget "description" o.kvs) (jpath p "description"))
                                > (./err path6=str why6=str)
                                  (model_r/err path6 why6)
                                > (./ok v6=maybe[str])
                                  ? (d_opt_str (jget "expiration_date" o.kvs) (jpath p "expiration_date"))
                                    > (./err path7=str why7=str)
                                      (model_r/err path7 why7)
                                    > (./ok v7=maybe[str])
                                      ? (d_opt_str (jget "hugging_face_id" o.kvs) (jpath p "hugging_face_id"))
                                        > (./err path8=str why8=str)
                                          (model_r/err path8 why8)
                                        > (./ok v8=maybe[str])
                                          ? (d_req_str (jget "id" o.kvs) (jpath p "id"))
                                            > (./err path9=str why9=str)
                                              (model_r/err path9 why9)
                                            > (./ok v9=str)
                                              ? (d_opt_str (jget "knowledge_cutoff" o.kvs) (jpath p "knowledge_cutoff"))
                                                > (./err path10=str why10=str)
                                                  (model_r/err path10 why10)
                                                > (./ok v10=maybe[str])
                                                  ? (d_req_model_links (jget "links" o.kvs) (jpath p "links"))
                                                    > (./err path11=str why11=str)
                                                      (model_r/err path11 why11)
                                                    > (./ok v11=model_links)
                                                      ? (d_req_str (jget "name" o.kvs) (jpath p "name"))
                                                        > (./err path12=str why12=str)
                                                          (model_r/err path12 why12)
                                                        > (./ok v12=str)
                                                          ? (d_opt_per_request_limits (jget "per_request_limits" o.kvs) (jpath p "per_request_limits"))
                                                            > (./err path13=str why13=str)
                                                              (model_r/err path13 why13)
                                                            > (./ok v13=maybe[per_request_limits])
                                                              ? (d_req_public_pricing (jget "pricing" o.kvs) (jpath p "pricing"))
                                                                > (./err path14=str why14=str)
                                                                  (model_r/err path14 why14)
                                                                > (./ok v14=public_pricing)
                                                                  ? (d_opt_model_reasoning (jget "reasoning" o.kvs) (jpath p "reasoning"))
                                                                    > (./err path15=str why15=str)
                                                                      (model_r/err path15 why15)
                                                                    > (./ok v15=maybe[model_reasoning])
                                                                      ? (d_req_row_parameter (jget "supported_parameters" o.kvs) (jpath p "supported_parameters"))
                                                                        > (./err path16=str why16=str)
                                                                          (model_r/err path16 why16)
                                                                        > (./ok v16=row[parameter])
                                                                          ? (d_opt_row_str (jget "supported_voices" o.kvs) (jpath p "supported_voices"))
                                                                            > (./err path17=str why17=str)
                                                                              (model_r/err path17 why17)
                                                                            > (./ok v17=maybe[row[str]])
                                                                              ? (d_req_top_provider_info (jget "top_provider" o.kvs) (jpath p "top_provider"))
                                                                                > (./err path18=str why18=str)
                                                                                  (model_r/err path18 why18)
                                                                                > (./ok v18=top_provider_info)
                                                                                  (model_r/ok (model v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15 v16 v17 v18))
    (model_r/err p "expected-object")
+ model_to
  \ x=model
  ^ json
  k0=[]
  k1=k0.snoc((jkv "architecture" (model_architecture_to x.architecture)))
  k2=(? x.benchmarks
        > .none
          k1
        > (./some w1)
          k1.snoc((jkv "benchmarks" (model_benchmarks_to w1))))
  k3=k2.snoc((jkv "canonical_slug" (json/str x.canonical_slug)))
  k4=(? x.context_length
        > .none
          k3
        > (./some w3)
          k3.snoc((jkv "context_length" (json/num .false w3))))
  k5=k4.snoc((jkv "created" (json/num .false x.created)))
  k6=(? x.default_parameters
        > .none
          k5
        > (./some w5)
          k5.snoc((jkv "default_parameters" (default_parameters_to w5))))
  k7=(? x.description
        > .none
          k6
        > (./some w6)
          k6.snoc((jkv "description" (json/str w6))))
  k8=(? x.expiration_date
        > .none
          k7
        > (./some w7)
          k7.snoc((jkv "expiration_date" (json/str w7))))
  k9=(? x.hugging_face_id
        > .none
          k8
        > (./some w8)
          k8.snoc((jkv "hugging_face_id" (json/str w8))))
  k10=k9.snoc((jkv "id" (json/str x.id)))
  k11=(? x.knowledge_cutoff
         > .none
           k10
         > (./some w10)
           k10.snoc((jkv "knowledge_cutoff" (json/str w10))))
  k12=k11.snoc((jkv "links" (model_links_to x.links)))
  k13=k12.snoc((jkv "name" (json/str x.name)))
  k14=(? x.per_request_limits
         > .none
           k13
         > (./some w13)
           k13.snoc((jkv "per_request_limits" (per_request_limits_to w13))))
  k15=k14.snoc((jkv "pricing" (public_pricing_to x.pricing)))
  k16=(? x.reasoning
         > .none
           k15
         > (./some w15)
           k15.snoc((jkv "reasoning" (model_reasoning_to w15))))
  a16=(% i16=nat
         0
         b16=row[json]
         []
       ? (eq i16 x.supported_parameters.len)
         b16
       (_ i16.inc b16.snoc((parameter_to x.supported_parameters.at(i16)))))
  k17=k16.snoc((jkv "supported_parameters" (json/arr a16)))
  k18=(? x.supported_voices
         > .none
           k17
         > (./some w17)
           a17=(% i17=nat
                  0
                  b17=row[json]
                  []
                ? (eq i17 w17.len)
                  b17
                (_ i17.inc b17.snoc((json/str w17.at(i17)))))
           k17.snoc((jkv "supported_voices" (json/arr a17))))
  k19=k18.snoc((jkv "top_provider" (top_provider_info_to x.top_provider)))
  (json/obj k19)
