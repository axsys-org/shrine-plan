              ? (d_opt_boo (jget "enforce_distillable_text" o.kvs) (jpath p "enforce_distillable_text"))
                > (./err path2=str why2=str)
                  (provider_preferences_r/err path2 why2)
                > (./ok v2=maybe[bool])
                  ? (d_opt_row_provider_preferences_ignore (jget "ignore" o.kvs) (jpath p "ignore"))
                    > (./err path3=str why3=str)
                      (provider_preferences_r/err path3 why3)
                    > (./ok v3=maybe[row[provider_preferences_ignore]])
                      ? (d_opt_provider_preferences_max_price (jget "max_price" o.kvs) (jpath p "max_price"))
                        > (./err path4=str why4=str)
                          (provider_preferences_r/err path4 why4)
                        > (./ok v4=maybe[provider_preferences_max_price])
                          ? (d_opt_row_provider_preferences_only (jget "only" o.kvs) (jpath p "only"))
                            > (./err path5=str why5=str)
                              (provider_preferences_r/err path5 why5)
                            > (./ok v5=maybe[row[provider_preferences_only]])
                              ? (d_opt_row_provider_preferences_order (jget "order" o.kvs) (jpath p "order"))
                                > (./err path6=str why6=str)
                                  (provider_preferences_r/err path6 why6)
                                > (./ok v6=maybe[row[provider_preferences_order]])
                                  ? (d_opt_preferred_max_latency (jget "preferred_max_latency" o.kvs) (jpath p "preferred_max_latency"))
                                    > (./err path7=str why7=str)
