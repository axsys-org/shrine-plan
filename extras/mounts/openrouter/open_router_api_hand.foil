  [order=60]
- pact
  [order=70]
- open_router_api
  [order=80]
'  Generated by schemagen from the open_router_api swagger.
'  The schema is the source of truth; there is no source file
'  to edit.  Requests are kids /<root>/[req-id] carrying
'  bond/req; answers arrive in bond/res.
+ req
  '  One request: a variant per swagger operation.
  & req/get_models
    req/send_chat_completion_request
  + get_models
    : offset=maybe[nat]
      limit=maybe[nat]
      category=maybe[str]
      supported_parameters=maybe[str]
      output_modalities=maybe[str]
      sort=maybe[str]
      q=maybe[str]
      input_modalities=maybe[str]
      context=maybe[nat]
      min_price=maybe[str]
      max_price=maybe[str]
      arch=maybe[str]
      model_authors=maybe[str]
      providers=maybe[str]
      distillable=maybe[str]
      zdr=maybe[str]
      region=maybe[str]
      min_output_price=maybe[str]
      max_output_price=maybe[str]
      min_age_days=maybe[nat]
      max_age_days=maybe[nat]
      min_intelligence_index=maybe[str]
      max_intelligence_index=maybe[str]
      min_coding_index=maybe[str]
      max_coding_index=maybe[str]
      min_agentic_index=maybe[str]
      max_agentic_index=maybe[str]
      min_tool_success_rate=maybe[str]
      max_tool_success_rate=maybe[str]
  + send_chat_completion_request
    : =chat_request
+ url_get_models
  \ u0=str
    offset=maybe[nat]
    limit=maybe[nat]
    category=maybe[str]
    supported_parameters=maybe[str]
    output_modalities=maybe[str]
    sort=maybe[str]
    q=maybe[str]
    input_modalities=maybe[str]
    context=maybe[nat]
    min_price=maybe[str]
    max_price=maybe[str]
    arch=maybe[str]
    model_authors=maybe[str]
    providers=maybe[str]
    distillable=maybe[str]
    zdr=maybe[str]
    region=maybe[str]
    min_output_price=maybe[str]
    max_output_price=maybe[str]
    min_age_days=maybe[nat]
    max_age_days=maybe[nat]
    min_intelligence_index=maybe[str]
    max_intelligence_index=maybe[str]
    min_coding_index=maybe[str]
    max_coding_index=maybe[str]
    min_agentic_index=maybe[str]
    max_agentic_index=maybe[str]
    min_tool_success_rate=maybe[str]
    max_tool_success_rate=maybe[str]
  ^ str
  u1=(str/cat "/models" u0)
  = q_offset=str
    ? offset
      > .none
        ""
      > (./some qv)
        (str/cat (nat/show qv) "offset=")
  = q_limit=str
    ? limit
      > .none
        ""
      > (./some qv)
        (str/cat (nat/show qv) "limit=")
  = q_category=str
    ? category
      > .none
        ""
      > (./some qv)
        (str/cat qv "category=")
  = q_supported_parameters=str
    ? supported_parameters
      > .none
        ""
      > (./some qv)
        (str/cat qv "supported_parameters=")
  = q_output_modalities=str
    ? output_modalities
      > .none
        ""
      > (./some qv)
        (str/cat qv "output_modalities=")
  = q_sort=str
    ? sort
      > .none
        ""
      > (./some qv)
        (str/cat qv "sort=")
  = q_q=str
    ? q
      > .none
        ""
      > (./some qv)
        (str/cat qv "q=")
  = q_input_modalities=str
    ? input_modalities
      > .none
        ""
      > (./some qv)
        (str/cat qv "input_modalities=")
  = q_context=str
    ? context
      > .none
        ""
      > (./some qv)
        (str/cat (nat/show qv) "context=")
  = q_min_price=str
    ? min_price
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_price=")
  = q_max_price=str
    ? max_price
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_price=")
  = q_arch=str
    ? arch
      > .none
        ""
      > (./some qv)
        (str/cat qv "arch=")
  = q_model_authors=str
    ? model_authors
      > .none
        ""
      > (./some qv)
        (str/cat qv "model_authors=")
  = q_providers=str
    ? providers
      > .none
        ""
      > (./some qv)
        (str/cat qv "providers=")
  = q_distillable=str
    ? distillable
      > .none
        ""
      > (./some qv)
        (str/cat qv "distillable=")
  = q_zdr=str
    ? zdr
      > .none
        ""
      > (./some qv)
        (str/cat qv "zdr=")
  = q_region=str
    ? region
      > .none
        ""
      > (./some qv)
        (str/cat qv "region=")
  = q_min_output_price=str
    ? min_output_price
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_output_price=")
  = q_max_output_price=str
    ? max_output_price
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_output_price=")
  = q_min_age_days=str
    ? min_age_days
      > .none
        ""
      > (./some qv)
        (str/cat (nat/show qv) "min_age_days=")
  = q_max_age_days=str
    ? max_age_days
      > .none
        ""
      > (./some qv)
        (str/cat (nat/show qv) "max_age_days=")
  = q_min_intelligence_index=str
    ? min_intelligence_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_intelligence_index=")
  = q_max_intelligence_index=str
    ? max_intelligence_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_intelligence_index=")
  = q_min_coding_index=str
    ? min_coding_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_coding_index=")
  = q_max_coding_index=str
    ? max_coding_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_coding_index=")
  = q_min_agentic_index=str
    ? min_agentic_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_agentic_index=")
  = q_max_agentic_index=str
    ? max_agentic_index
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_agentic_index=")
  = q_min_tool_success_rate=str
    ? min_tool_success_rate
      > .none
        ""
      > (./some qv)
        (str/cat qv "min_tool_success_rate=")
  = q_max_tool_success_rate=str
    ? max_tool_success_rate
      > .none
        ""
      > (./some qv)
        (str/cat qv "max_tool_success_rate=")
  (str/cat (qjoin [q_offset q_limit q_category q_supported_parameters q_output_modalities q_sort q_q q_input_modalities q_context q_min_price q_max_price q_arch q_model_authors q_providers q_distillable q_zdr q_region q_min_output_price q_max_output_price q_min_age_days q_max_age_days q_min_intelligence_index q_max_intelligence_index q_min_coding_index q_max_coding_index q_min_agentic_index q_max_agentic_index q_min_tool_success_rate q_max_tool_success_rate]) u1)
+ url_send_chat_completion_request
  \ u0=str
  ^ str
  u1=(str/cat "/chat/completions" u0)
  u1
+ seg_txt
  '  One path segment as text: text auras verbatim, the
  '  rest as their decimal payload.
  \ i=iota
  ^ str
  ? (is_text i)
    (str/from_atom (quip_val i))
  (nat/show (str/from_atom (quip_val i)))
+ flat_seg
  '  A path flattened to one _-joined text segment - the
  '  fetch node's kid name, unique per hand instance, so
  '  two hands' request kids never collide at /io.
  \ p=path
  ^ iota
  % i=nat
    0
    acc=str
    ""
  ? (eq i p.len)
    (($ ts) acc)
  ? (eq i 0)
    (_ 1 (seg_txt p.at(0)))
  (_ i.inc (str/cat (seg_txt p.at(i)) (str/cat "_" acc)))
+ base_of
  '  The server base url from the root record's ['base].
  \ cur=myth
  ^ str
  ? cur.get(['base])
    > (./some held=pail)
      ? held
        > t=pails/t
          (str/from_atom t.t)
        ""
    ""
+ qjoin
  '  The query string from k=v fragments, skipping the absent
  '  ones (0): ? before the first that is set, & between the
  '  rest.  Empty when nothing is set.  Values are spliced
  '  verbatim — percent-encoding is not done yet.
  \ ps=row[str]
  ^ str
  % i=nat
    0
    out=str
    ""
    some=bool
    .false
  ? (eq i ps.len)
    out
  p=ps.at(i)
  ? (eq p 0)
    (_ i.inc out some)
  ? some
    (_ i.inc (str/cat p (str/cat "&" out)) .true)
  (_ i.inc (str/cat p "?") .true)
+ auth_of
  '  The credential from the root record's ['auth], or empty when
  '  none was injected — an unauthenticated call is a real
  '  case, so a missing credential is not an error here.
  \ cur=myth
  ^ str
  ? cur.get(['auth])
    > (./some held=pail)
      ? held
        > t=pails/t
          (str/from_atom t.t)
        ""
    ""
+ crew_of_rec
  '  The crew mop in a record's /sys/crew, or empty.
  \ cur=myth
  ^ crew
  ? cur.get(bond/crew)
    > (./some held=pail)
      ? held
        > c=cpail
          c.crew
        (mop/empty)
    (mop/empty)
+ http_of
  '  The injected http-client root from the crew slot ['http].
  \ cur=myth
  ^ maybe[path]
  ? (crew_of_rec cur).get(['http])
    > .none
      .none
    > (./some d=dep)
      (./some d.p)
+ crew_put
  \ cur=myth
    slot=path
    d=dep
  ^ myth
  cur.put(bond/crew (cpail (crew_of_rec cur).put(slot d)))
+ crew_del
  \ cur=myth
    slot=path
  ^ myth
  es=(crew_of_rec cur).tap
  c2=(% i=nat
        0
        acc=crew
        (mop/empty)
      ? (eq i es.len)
        acc
      h=es.at(i)
      ? (eq_pith h.key slot)
        (_ i.inc acc)
      (_ i.inc acc.put(h.key h.val)))
  cur.put(bond/crew (cpail c2))
+ crew_slot_for
  '  The crew slot whose dep watches path p.
  \ cur=myth
    p=path
  ^ maybe[path]
  es=(crew_of_rec cur).tap
  % i=nat
    0
  ^ maybe[path]
  ? (eq i es.len)
    .none
  h=es.at(i)
  ? (eq_pith h.val.p p)
    (./some h.key)
  (_ i.inc)
+ fetch_for
  '  The driver request myth for one req variant, or empty
  '  row when the pail is not a request.
  \ base=str
    auth=str
    held=pail
  ^ row[myth]
  ? held
    > g0=req/get_models
      [(fetch/req "GET" (url_get_models base g0.offset g0.limit g0.category g0.supported_parameters g0.output_modalities g0.sort g0.q g0.input_modalities g0.context g0.min_price g0.max_price g0.arch g0.model_authors g0.providers g0.distillable g0.zdr g0.region g0.min_output_price g0.max_output_price g0.min_age_days g0.max_age_days g0.min_intelligence_index g0.max_intelligence_index g0.min_coding_index g0.max_coding_index g0.min_agentic_index g0.max_agentic_index g0.min_tool_success_rate g0.max_tool_success_rate) 0 30000).put(['hdr 'authorization] (pd (str/cat auth "Bearer ")))]
    > g1=req/send_chat_completion_request
      [(fetch/req "POST" (url_send_chat_completion_request base) (show (chat_request_to g1.chat_request)) 30000).put(['hdr 'authorization] (pd (str/cat auth "Bearer ")))]
    []
+ take
  '  Handle request kids: for each non-deleted gift with a bond/req
  '  and no bond/res, emit the fetch make-card and subscribe the
  '  req-id crew slot to the fetch node.
  \ b=bowl
    cur=myth
    gift=axal[mode]
  ^ yell
  entries=gift.tap
  % i=nat
    0
    cards=row[[p=path q=writ]]
    []
    out=myth
    cur
  ^ yell
  ? (eq i entries.len)
    (yell cards out)
  = ent
    entries.at(i)
    next i.inc
  [gp=path gm=mode]=ent
  ? gm
    > d0=mode/del
      (_ next cards out)
    ? b.kids.get(gp)
      > .none
        (_ next cards out)
      > (./some t=myth)
        ? t.get(bond/res)
          > (./some done=pail)
            (_ next cards out)
          > .none
            ? t.get(bond/req)
              > .none
                (_ next cards out)
              > (./some held=pail)
                fr=(fetch_for (base_of cur) (auth_of cur) held)
                ? (eq 0 fr.len)
                  (_ next cards out)
                ? (http_of out)
                  > .none
                    (_ next cards out)
                  > (./some hp=path)
                    dst=hp.snoc((flat_seg b.here.weld(gp)))
                    (_ next cards.snoc([dst (writ/make fr.at(0))]) (crew_put out gp (dep (care/x) dst)))
+ pd_of
  '  Any nominal record as a pail, unchanged (records inhabit pails).
  \ v=pail
  ^ pail
  v
+ res_body_nat
  \ fm=myth
    slot=path
  ^ nat
  ? fm.get(slot)
    > (./some bp=pail)
      ? bp
        > n=pails/n
          n.n
        0
    0
+ resp_for
  '  The bond/res pail for one completed fetch: parse per the
  '  originating operation, or the op's error record.
  \ held=pail
    okf=nat
    body=str
    ecode=str
  ^ row[pail]
  ? held
    > g0=req/get_models
      ? okf
        ? (parse_models_list_response body)
          > o0=models_list_response_r/ok
            [(pd_of o0)]
          > e0=models_list_response_r/err
            [(pd_of e0)]
      [(pd_of (models_list_response_r/err "" ecode))]
    > g1=req/send_chat_completion_request
      ? okf
        ? (parse_chat_result body)
          > o1=chat_result_r/ok
            [(pd_of o1)]
          > e1=chat_result_r/err
            [(pd_of e1)]
      [(pd_of (chat_result_r/err "" ecode))]
    []
+ hear
  '  Handle fetch completions: parse res_body per the originating
  '  request's operation, answer bond/res, unsubscribe.
  \ b=bowl
    cur=myth
    changed=row[dep]
  ^ yell
  % i=nat
    0
    cards=row[[p=path q=writ]]
    []
    out=myth
    cur
  ^ yell
  ? (eq i changed.len)
    (yell cards out)
  = d
    changed.at(i)
    next i.inc
  ? (crew_slot_for out d.p)
    > .none
      (_ next cards out)
    > (./some k=path)
      ? b.crew.get(k)
        > .none
          (_ next cards out)
        > (./some ax)
          ? ax.fil
            > .none
              (_ next cards out)
            > (./some fm=myth)
              ? fm.get(['res_done])
                > .none
                  (_ next cards out)
                > (./some dn=pail)
                  = okf
                    (res_body_nat fm ['res_ok])
                    body(str/from_atom (res_body_nat fm ['res_body]))
                  ? b.kids.get(k)
                    > .none
                      (_ next cards out)
                    > (./some t=myth)
                      ? t.get(bond/req)
                        > .none
                          (_ next cards out)
                        > (./some held=pail)
                          ecode=(str/cat (nat/show (res_body_nat fm ['res_err])) "fetch-err-")
                          resp=(resp_for held okf body ecode)
                          ? (eq 0 resp.len)
                            (_ next cards out)
                          (_ next cards.snoc([b.here.weld(k) (writ/poke (myth/sing bond/res resp.at(0)))]) (crew_del out k))
+ serve
  '  The generated behavior: requests in take, responses in hear.
  ^ form
  def_form.set_take(take).set_hear(hear)
+ decl
  ^ kook/decl
  (kook/decl 'open_router_api serve (lore/line "Generated open_router_api API hand."))
