- apps/doom/spans

+ doom
  + bar
    \ size=nat bytes=nat
    ^ nat
    (add bytes (bex (mul size 8)))
  + read_command
    ' A two-byte input mask; TCP reads may split at any byte boundary.
    \ fd=nat
    ^ maybe[nat]
    % size=nat 0 bytes=nat 0
    ^ maybe[nat]
    ? (eq size 2) (./some bytes)
    = ;part (Read fd (sub 2 size))
    ? (le part 1) .none
    = count (dec (wid part))
      payload (loadvar 0 count part)
    (_ (add size count) (add bytes (lsh payload (mul size 8))))
  + keys
    \ mask=nat
    ^ str
    = letters=str "wsadqefur"
    | str/cat_all
      ((row/range 0 9).map((\ i (? (mod (div mask (bex i)) 2) letters.slice(i 1) ""))))
  + packet
    \ w=dg/world width=nat height=nat columns=row[nat]
    ^ nat
    = flags (add (? (eq w.health 0) 1 0) (? w.won 2 0))
      header (row/range 0 10).fold(0 (\ n i (add n (lsh ([w.tic w.health w.armor w.ammo w.kills w.items flags w.x w.y w.angle]).at(i) (mul i 32)))))
      pixels (dr/pack height columns)
    (doom/bar (add 40 (mul width height)) (add header (lsh pixels 320)))
  + serve
    \ fd=nat width=nat height=nat w=dg/world art=dr/art weapons=row[row[row[nat]]] profile=bool reference=bool
    ^ nat
    % world=dg/world w
    ?> (./some command) (doom/read_command fd) 0
    ? (ge command 1024) 0
    = ;t0 (? profile (Now 0) 0)
      ;z0 (? profile (ZoneStart "doom.step") 0)
      next
        ? (ge command 512) (dg/new world.level)
        (dg/step world (doom/keys command))
      ;next (DeepSeq[dg/world] [next.sectors next.actors next.movers next.x next.y next.angle next.health next.armor next.ammo next.tic next.rnd next.cooldown next.flash next.kills next.items next.won next.use_down] next)
    ; (? profile (ZoneEnd z0) 0)
    = ;t1 (? profile (Now 0) 0)
      ;z1 (? profile (ZoneStart "doom.visibility") 0)
      ;legacy (? reference (dr/reference_prepare next art width height) (dr/legacy_scene [] [] [] 0))
      ;scene (? reference (ds/scene [] [] [] 0) (ds/prepare next art width height))
    ; (? profile (ZoneEnd z1) 0)
    = ;t2 (? profile (Now 0) 0)
      ;z2 (? profile (ZoneStart "doom.raster") 0)
      columns (? reference (dr/reference_columns next art width height legacy) (ds/columns next art width height scene weapons))
      ;columns (DeepSeq[row[nat]] columns columns)
    ; (? profile (ZoneEnd z2) 0)
    = ;t3 (? profile (Now 0) 0)
      ;z3 (? profile (ZoneStart "doom.pack") 0)
      ;packet (doom/packet next width height columns)
    ; (? profile (ZoneEnd z3) 0)
    = ;t4 (? profile (Now 0) 0)
    ; (Write fd packet)
    = ;t5 (? profile (Now 0) 0)
    ; (? profile (Print (str/cat_all ["DOOM_PROFILE " (nat/show next.tic) " "
        (nat/show (sub t1 t0)) " " (nat/show (sub t2 t1)) " "
        (nat/show (sub t3 t2)) " " (nat/show (sub t4 t3)) " " (nat/show (sub t5 t4))])) 0)
    (_ next)
  + run
    \ port=nat width=nat height=nat file=str profile=bool reference=bool
    ^ nat
    ; (Print "DOOM loading WAD")
    = ;bytes (ReadFile file)
      loaded (dw/load bytes)
      ;level (DeepSeq[dw/level] loaded loaded)
      art (dr/load_art level)
      ;art (DeepSeq[dr/art] art art)
      weapons (ds/weapons art width height)
      ;weapons (DeepSeq[row[row[row[nat]]]] weapons weapons)
    ; (Print "DOOM ready")
    = ;fd (Connect 0 "127.0.0.1" port)
    ; (Write fd (doom/bar 768 (loadvar 0 768 level.palette)))
    = ;result (doom/serve fd width height (dg/new level) art weapons profile reference)
    ; (CloseFd fd)
    result
