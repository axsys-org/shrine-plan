- sept

+ dz
  ' Signed integers in zigzag naturals. Coordinates use map units;
  ' ray directions use 1024ths. No host numeric or rendering jets.
  + pos
    \ n=nat
    ^ nat
    (mul n 2)
  + neg
    \ n=nat
    ^ nat
    ? (eq n 0) 0
    ? (mod n 2) (inc n)
    (dec n)
  + abs
    \ n=nat
    ^ nat
    (div (inc n) 2)
  + sign
    \ n=nat
    ^ bool
    (mod n 2)
  + add
    \ a=nat b=nat
    ^ nat
    ? (eq (dz/sign a) (dz/sign b))
      = n (mul (add (dz/abs a) (dz/abs b)) 2)
      ? (dz/sign a) (dec n)
      n
    ? (ge (dz/abs a) (dz/abs b))
      = n (mul (sub (dz/abs a) (dz/abs b)) 2)
      ? (dz/sign a) (dec n)
      n
    = n (mul (sub (dz/abs b) (dz/abs a)) 2)
    ? (dz/sign b) (dec n)
    n
  + sub
    \ a=nat b=nat
    ^ nat
    (dz/add a (dz/neg b))
  + mul
    \ a=nat b=nat
    ^ nat
    = n (mul (mul (dz/abs a) (dz/abs b)) 2)
    ? (eq (dz/sign a) (dz/sign b)) n
    (dec n)
  + div
    \ a=nat b=nat
    ^ nat
    = n (mul (div (dz/abs a) (if (eq b 0) 1 (dz/abs b))) 2)
    ? (eq (dz/sign a) (dz/sign b)) n
    (dec n)
  + lt
    \ a=nat b=nat
    ^ bool
    ? (eq (dz/sign a) (dz/sign b))
      ? (dz/sign a) (gt a b)
      (lt a b)
    (dz/sign a)
  + min
    \ a=nat b=nat
    ^ nat
    ? (dz/lt a b) a
    b
  + max
    \ a=nat b=nat
    ^ nat
    ? (dz/lt a b) b
    a
  + mod
    \ a=nat b=nat
    ^ nat
    = n (mod (dz/abs a) b)
    ? (dz/sign a) (mod (sub b n) b)
    n
  + cross
    \ ax=nat ay=nat bx=nat by=nat
    ^ nat
    (dz/sub (dz/mul ax by) (dz/mul ay bx))
  + dot
    \ ax=nat ay=nat bx=nat by=nat
    ^ nat
    (dz/add (dz/mul ax bx) (dz/mul ay by))
  + sqrt
    \ n=nat
    ^ nat
    ? (lt n 2) n
    % x=nat (bex (mul 4 (wid n)))
    = y (div (add x (div n x)) 2)
    ? (ge y x) x
    (_ y)
  + distance
    \ ax=nat ay=nat bx=nat by=nat
    ^ nat
    = dx (dz/abs (dz/sub ax bx))
      dy (dz/abs (dz/sub ay by))
    (dz/sqrt (add (mul dx dx) (mul dy dy)))
  + sine
    ^ row[nat]
    [0 36 72 108 142 178 214 250 286 320 356 390 426 460 496 530 564 598 632 666 700 734 768 800 832 866 898 930 962 992 1024 1054 1086 1116 1146 1174 1204 1232 1260 1288 1316 1344 1370 1396 1422 1448 1474 1498 1522 1546 1568 1592 1614 1636 1656 1678 1698 1718 1736 1756 1774 1792 1808 1824 1840 1856 1870 1886 1898 1912 1924 1936 1948 1958 1968 1978 1988 1996 2004 2010 2016 2022 2028 2032 2036 2040 2044 2046 2046 2048 2048 2048 2046 2046 2044 2040 2036 2032 2028 2022 2016 2010 2004 1996 1988 1978 1968 1958 1948 1936 1924 1912 1898 1886 1870 1856 1840 1824 1808 1792 1774 1756 1736 1718 1698 1678 1656 1636 1614 1592 1568 1546 1522 1498 1474 1448 1422 1396 1370 1344 1316 1288 1260 1232 1204 1174 1146 1116 1086 1054 1024 992 962 930 898 866 832 800 768 734 700 666 632 598 564 530 496 460 426 390 356 320 286 250 214 178 142 108 72 36 0 35 71 107 141 177 213 249 285 319 355 389 425 459 495 529 563 597 631 665 699 733 767 799 831 865 897 929 961 991 1023 1053 1085 1115 1145 1173 1203 1231 1259 1287 1315 1343 1369 1395 1421 1447 1473 1497 1521 1545 1567 1591 1613 1635 1655 1677 1697 1717 1735 1755 1773 1791 1807 1823 1839 1855 1869 1885 1897 1911 1923 1935 1947 1957 1967 1977 1987 1995 2003 2009 2015 2021 2027 2031 2035 2039 2043 2045 2045 2047 2047 2047 2045 2045 2043 2039 2035 2031 2027 2021 2015 2009 2003 1995 1987 1977 1967 1957 1947 1935 1923 1911 1897 1885 1869 1855 1839 1823 1807 1791 1773 1755 1735 1717 1697 1677 1655 1635 1613 1591 1567 1545 1521 1497 1473 1447 1421 1395 1369 1343 1315 1287 1259 1231 1203 1173 1145 1115 1085 1053 1023 991 961 929 897 865 831 799 767 733 699 665 631 597 563 529 495 459 425 389 355 319 285 249 213 177 141 107 71 35]
  + sin
    \ angle=nat
    ^ nat
    (dz/sine).at((mod angle 360))
  + cos
    \ angle=nat
    ^ nat
    (dz/sin (add angle 90))
