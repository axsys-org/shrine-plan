;;;; Compile the CLI against the real Shrine system publication and compiler.
;;;; There is no HTTP server or live namespace instance in the terminal host.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind publication (#module foil-publication))
(#bind context (#module foil-context))
(#bind bootstrap (#module foil-bootstrap))
(define (run port width height profile reference)
  (Seq (print "DOOM compiling publication") 0)
  (define system-plan (publication:prepare-system
    (Pin driver:compile) source:read-module bootstrap:system-roots))
  (define system-code (publication:compile system-plan driver:empty-foil-cache))
  (define (resolve name)
    (define found (find (lambda (pair) (Equal name (_0 pair))) bootstrap:system-roots))
    (If found (_1 (_0 found)) [["x" 17] ["ts" "lib"] ["ts" name]]))
  (define plan (source:prepare-publication
    (context:publication-key (publication:compilation-context system-plan))
    (Pin driver:compile) resolve (_2 system-code) (lambda (path) 0) ["apps/doom/main"]))
  (define compiled (source:compile (publication:compilation-context plan)
    (_1 system-code) "apps/doom/main"))
  (define entry (driver:get-perc ["doom" "run"] (_1 compiled)))
  (Seq (DeepSeq entry 0) (print "DOOM engine compiled"))
  (entry port width height "doom.wad" profile reference))
(#export run)
