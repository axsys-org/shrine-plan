- apps/doom/game

+ dr
  + wall
    : seg=dw/seg distance=nat along=nat
  + pixel
    : color=nat distance=nat
  + sprite
    : kind=nat alive=dw/picture dead=dw/picture
  + art
    : sprites=row[dr/sprite] pistol=dw/picture firing=dw/picture sky=dw/picture
  + view
    : world=dg/world art=dr/art width=nat height=nat eye=nat dx=nat dy=nat x=nat
  + load_art
    \ lv=dw/level
    ^ dr/art
    = entries=row[[nat str str]]
        [[3004 "POSSA1" "POSSL0"] [9 "SPOSA1" "SPOSL0"]
         [3001 "TROOA1" "TROOM0"] [3002 "SARGA1" "SARGN0"] [58 "SARGA1" "SARGN0"]
         [2035 "BAR1A0" "BEXPC0"] [2014 "BON1A0" "BON1A0"]
         [2011 "STIMA0" "STIMA0"] [2012 "MEDIA0" "MEDIA0"] [2013 "SOULA0" "SOULA0"]
         [2015 "BON2A0" "BON2A0"] [2018 "ARM1A0" "ARM1A0"] [2019 "ARM2A0" "ARM2A0"]
         [2007 "CLIPA0" "CLIPA0"] [2048 "AMMOA0" "AMMOA0"] [8 "BPAKA0" "BPAKA0"]
         [2001 "SHOTA0" "SHOTA0"] [2002 "MGUNA0" "MGUNA0"] [5 "BKEYA0" "BKEYA0"]
         [2028 "COLUA0" "COLUA0"] [48 "ELECA0" "ELECA0"] [54 "TRE2A0" "TRE2A0"]
         [43 "TRE1A0" "TRE1A0"] [47 "SMITA0" "SMITA0"] [26 "POL6A0" "POL6A0"]]
      sprites entries.map((\ [kind alive dead] (dr/sprite kind (dw/picture_of (dw/find alive lv.lumps)) (dw/picture_of (dw/find dead lv.lumps)))))
      sky (dw/tex_id "SKY1" lv.textures)
    | dr/art sprites (dw/picture_of (dw/find "PISGA0" lv.lumps))
      (dw/picture_of (dw/find "PISGB0" lv.lumps)) lv.textures.at(sky.dec).image
  + shade
    \ lv=dw/level color=nat light=nat distance=nat
    ^ nat
    = darkness (dg/minimum 31 (add (div (sub 255 light) 8) (div distance 128)))
    (load8 (add (mul darkness 256) color) lv.cmap)
  + texel
    \ picture=dw/picture x=nat y=nat
    ^ nat
    ? ((eq picture.width 0) || (eq picture.height 0)) 0
    picture.cols.at((dz/mod x picture.width)).at((dz/mod y picture.height))
  + walls
    ' Clip the ray interval at BSP partitions. Only intersected subsectors are visited.
    \ v=dr/view child=nat low=nat high=nat fuel=nat
    ^ row[dr/wall]
    ? (eq fuel 0) []
    = lv v.world.level
    ? (ge child 32768)
      = sub lv.subs.at((sub child 32768))
      | (row/range sub.first (add sub.first sub.count)).fold []
        \ out i
        = seg lv.segs.at(i)
          facing (dz/cross (dz/sub seg.b.x seg.a.x) (dz/sub seg.b.y seg.a.y) (dz/sub v.world.x seg.a.x) (dz/sub v.world.y seg.a.y))
        ? !(dz/sign facing) out
        ?> (./some hit) (dg/intersection v.world.x v.world.y v.dx v.dy seg.a seg.b) out
        ? ((lt hit.distance low) || (gt hit.distance high)) out
        out.snoc((dr/wall seg hit.distance hit.along))
    = n lv.nodes.at(child)
      origin (dz/cross n.dx n.dy (dz/sub v.world.x n.x) (dz/sub v.world.y n.y))
      direction (dz/cross n.dx n.dy v.dx v.dy)
      at_low (dz/add origin (dz/div (dz/mul direction (dz/pos low)) 2048))
      at_high (dz/add origin (dz/div (dz/mul direction (dz/pos high)) 2048))
      near (? (dz/sign at_low) n.right n.left)
      far (? (dz/sign at_low) n.left n.right)
    ? (eq (dz/sign at_low) (dz/sign at_high)) (_ v near low high fuel.dec)
    = split (dz/abs (dz/div (dz/mul (dz/neg origin) 2048) direction))
      first (_ v near low split fuel.dec)
      second (_ v far split high fuel.dec)
    first.weld(second)
  + surface
    \ v=dr/view sector=dw/sector y=nat roof=bool
    ^ dr/pixel
    = half (div v.height 2)
      height (? roof (dz/sub sector.ceiling v.eye) (dz/sub v.eye sector.floor))
      screen (? roof (sub half y) (sub y half))
      distance (div (mul (dz/abs height) (div v.width 2)) (dg/maximum 1 screen))
      x (dz/add v.world.x (dz/div (dz/mul v.dx (dz/pos distance)) 2048))
      wy (dz/add v.world.y (dz/div (dz/mul v.dy (dz/pos distance)) 2048))
      texture (? roof sector.roof sector.flat)
      color (load8 (add (mul (dz/mod wy 64) 64) (dz/mod x 64)) texture)
    ? (and roof sector.sky)
      = sky v.art.sky
        sx (div (mul (mod (add (mul v.world.angle 4) (sub (mul v.width 4) v.x)) 1440) sky.width) 1440)
        sy (div (mul y sky.height) (dg/maximum 1 half))
      (dr/pixel (dec (dr/texel sky (dz/pos sx) (dz/pos sy))) 8192)
    (dr/pixel (dr/shade v.world.level color sector.light distance) distance)
  + wall_pixel
    \ v=dr/view wall=dr/wall y=nat
    ^ maybe[dr/pixel]
    = w v.world
      lv w.level
      seg wall.seg
      line lv.lines.at(seg.line)
      sid (? seg.side line.left line.right)
      other (? seg.side line.right line.left)
      side lv.sides.at(sid)
      front w.sectors.at(side.sector)
      distance (dg/maximum 1 wall.distance)
      z (dz/add v.eye (dz/div (dz/mul (dz/sub (dz/pos (div v.height 2)) (dz/pos y)) (dz/pos distance)) (dz/pos (div v.width 2))))
      back (? (eq other 65535) front w.sectors.at(lv.sides.at(other).sector))
    ? (dz/lt z front.floor) (./some (dr/surface v front y .false))
    ? !(dz/lt z front.ceiling) (./some (dr/surface v front y .true))
    = texture
        ? (eq other 65535) side.middle
        ? (dz/lt z back.floor) side.lower
        ? !(dz/lt z back.ceiling)
          ? (and front.sky back.sky) 0
          side.upper
        side.middle
      top
        ? (eq other 65535)
          ? (eq (mod (div line.flags 16) 2) 1)
            (dz/add front.floor (dz/pos (? texture lv.textures.at(texture.dec).image.height 128)))
          front.ceiling
        ? (dz/lt z back.floor) back.floor
        front.ceiling
    ? (eq texture 0) .none
    = image lv.textures.at(texture.dec).image
      tx (dz/add side.x (dz/pos (add seg.offset (div (mul seg.length wall.along) 1024))))
      ty (dz/add side.y (dz/sub top z))
      color (dr/texel image tx ty)
    ? (and (eq color 0) !(eq other 65535)) .none
    (./some (dr/pixel (dr/shade lv (dec color) front.light distance) distance))
  + background
    \ v=dr/view walls=row[dr/wall] y=nat
    ^ dr/pixel
    % i=nat 0
    ? (eq i walls.len)
      = sector v.world.sectors.at((dw/sector_at v.world.level v.world.x v.world.y))
      (dr/surface v sector y (lt y (div v.height 2)))
    ? (dr/wall_pixel v walls.at(i) y)
     > (./some pixel) pixel
     > .none (_ i.inc)
  + projected
    : picture=dw/picture distance=nat left=nat top=nat width=nat height=nat light=nat
  + sprites
    \ v=dr/view
    ^ row[dr/projected]
    = w v.world
    | w.actors.fold []
      \ out a
      ? a.removed out
      = dx (dz/sub a.x w.x)
        dy (dz/sub a.y w.y)
        depth (dz/div (dz/dot dx dy (dz/cos w.angle) (dz/sin w.angle)) 2048)
      ? ((dz/sign depth) || (lt (dz/abs depth) 8)) out
      = lateral (dz/div (dz/cross (dz/cos w.angle) (dz/sin w.angle) dx dy) 2048)
        distance (dz/abs depth)
        found v.art.sprites.filter((\ s (eq s.kind a.kind)))
      ? (eq found.len 0) out
      = art found.at(0)
        picture (? (and (gt (dg/hp a.kind) 0) (eq a.hp 0)) art.dead art.alive)
        half (div v.width 2)
        center (dz/sub (dz/pos half) (dz/div (dz/mul lateral (dz/pos half)) depth))
        left (dz/sub center (dz/div (dz/mul picture.left (dz/pos half)) depth))
        sector w.sectors.at((dw/sector_at w.level a.x a.y))
        top (dz/sub (dz/pos (div v.height 2)) (dz/div (dz/mul (dz/sub (dz/add sector.floor picture.top) v.eye) (dz/pos half)) depth))
      out.snoc((dr/projected picture distance left top
        (dg/maximum 1 (div (mul picture.width half) distance))
        (dg/maximum 1 (div (mul picture.height half) distance)) sector.light))
  + sprite_pixel
    \ v=dr/view sprites=row[dr/projected] y=nat background=dr/pixel
    ^ dr/pixel
    | sprites.fold background
      \ pixel s
      ? (ge s.distance pixel.distance) pixel
      = column (dz/sub (dz/pos v.x) s.left)
        row (dz/sub (dz/pos y) s.top)
      ? ((dz/sign row) || (ge (dz/abs row) s.height)) pixel
      = color s.picture.cols.at((dg/minimum s.picture.width.dec (div (mul (dz/abs column) s.picture.width) s.width))).at((dg/minimum s.picture.height.dec (div (mul (dz/abs row) s.picture.height) s.height)))
      ? (eq color 0) pixel
      (dr/pixel (dr/shade v.world.level color.dec s.light s.distance) s.distance)
  + weapon
    \ w=dg/world art=dr/art width=nat height=nat x=nat y=nat background=nat
    ^ nat
    ? (eq w.health 0) background
    = picture (? (gt w.cooldown 6) art.firing art.pistol)
      left (dz/sub 2 picture.left)
      top (dz/sub 0 picture.top)
      px (dz/sub (dz/pos (div (mul x 320) width)) left)
      py (dz/sub (dz/pos (div (mul y 200) height)) top)
    ? ((dz/sign px) || (dz/sign py)) background
    ? ((ge (dz/abs px) picture.width) || (ge (dz/abs py) picture.height)) background
    = color picture.cols.at((dz/abs px)).at((dz/abs py))
    ? color color.dec
    background
  + camera
    \ w=dg/world width=nat
    ^ row[[nat nat]]
    = half (div width 2)
      sine (dz/sin w.angle)
      cosine (dz/cos w.angle)
    | (row/range 0 width).map
      \ x
      = camera (dz/div (dz/mul (dz/sub (dz/pos half) (dz/pos x)) 2048) (dz/pos half))
      [(dz/sub cosine (dz/div (dz/mul sine camera) 2048))
       (dz/add sine (dz/div (dz/mul cosine camera) 2048))]
  + legacy_scene
    : rays=row[[nat nat]] walls=row[row[dr/wall]] sprites=row[dr/projected] eye=nat
  + force_sprites
    ' Force projection metadata, without walking shared texture rows every frame.
    \ sprites=row[dr/projected]
    ^ nat
    (DeepSeq[nat] (sprites.map((\ s [s.distance s.left s.top s.width s.height s.light]))) 0)
  + reference_prepare
    \ w=dg/world art=dr/art width=nat height=nat
    ^ dr/legacy_scene
    = eye (dz/add (dg/floor w w.x w.y) 82)
      rays (dr/camera w width)
      sprites (dr/sprites (dr/view w art width height eye 0 0 0))
      walls
        | (row/range 0 width).map
          \ x
          = [dx dy] rays.at(x)
          (dr/walls (dr/view w art width height eye dx dy x) w.level.nodes.len.dec 0 8192 w.level.nodes.len.inc)
    ; (DeepSeq[nat] [rays walls eye] 0)
    ; (dr/force_sprites sprites)
    (dr/legacy_scene rays walls sprites eye)
  + reference_columns
    \ w=dg/world art=dr/art width=nat height=nat scene=dr/legacy_scene
    ^ row[nat]
    | (row/range 0 width).map
      \ x
      = [dx dy] scene.rays.at(x)
        v (dr/view w art width height scene.eye dx dy x)
        sprites scene.sprites.filter((\ s (and !(dz/lt (dz/pos x) s.left) (dz/lt (dz/pos x) (dz/add s.left (dz/pos s.width))))))
      | (row/range 0 height).fold 0
        \ bytes y
        = pixel (dr/sprite_pixel v sprites y (dr/background v scene.walls.at(x) y))
          color (dr/weapon w art width height x y pixel.color)
        (add bytes (lsh color (mul y 8)))
  + pack
    \ height=nat columns=row[nat]
    ^ nat
    | (row/range 0 columns.len).fold 0
      \ bytes x
      (add bytes (lsh columns.at(x) (mul (mul x height) 8)))
  + render
    \ w=dg/world art=dr/art width=nat height=nat
    ^ nat
    (dr/pack height (dr/reference_columns w art width height (dr/reference_prepare w art width height)))
