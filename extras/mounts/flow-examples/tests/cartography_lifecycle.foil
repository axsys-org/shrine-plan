- flow_cartography
- flow_web_mount
- flow_test_world [at=fixture]
- flow_request_fixture [at=controlled]
- flow_examples_composition_tests [at=recipes]
- graph_policy
- json [at=fixture_json]

' A disposable native world using the shipped Semidoc bytes. HTTP and model
' results are controlled; admission, task guards, hands, holes and writer are real.
+ cartography_lifecycle_tests
  + page
    ^ path
    | [($x 17) 'app 'nenex 'w 'cartography_flow]
  + controller
    ^ path
    | (cartography_lifecycle_tests/page).weld(['work 'research])
  + destination
    ^ path
    | [($x 17) 'app 'nenex 'w 'company_research]
  + input
    ^ path
    | [($x 17) 'user 'research_urls]
  + author
    \ name=iota id=str file=str state=namespace
    ^ namespace
    = target=path [state.self 'app 'nenex 'w name]
      source (recipes/flow_examples_composition_tests/read file)
    ?> (./ok next) (recipes/flow_examples_composition_tests/author target id source state)
      | Seq[namespace] (error (pails/t "Shipped cartography recipe did not publish")) state
    next
  + project
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | graph_policy/report input
  + start
    ^ namespace
    ?> (./ok state) (flow_web_mount/install fixture/flow_tests/initial)
      | Seq[namespace] (error (pails/t "Optional web operations failed to install")) fixture/flow_tests/initial
    = state ((flow_cartography/records state.self).fold(state (\ current=namespace [name card] (fixture/flow_tests/poke name card current))))
      form=path [state.self 'gov 'flows 'request_provider]
      state (fixture/flow_tests/poke form (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(controlled/request_tests/hear).set_talk(controlled/request_tests/talk))) state)
      provider=path [state.self 'user 'research_provider]
      state (fixture/flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider controlled/request_tests/provider)) state)
      state (cartography_lifecycle_tests/author 'capture_sources_flow "capture_sources" "capture-sources.semidoc" state)
      state (cartography_lifecycle_tests/author 'web_evidence_flow "web_evidence" "web-evidence.semidoc" state)
      state (cartography_lifecycle_tests/author 'cited_assertions_flow "cited_assertions" "cited-assertions.semidoc" state)
      state (cartography_lifecycle_tests/author 'cartography_flow "cartography" "cartography.semidoc" state)
      input cartography_lifecycle_tests/input
      state (fixture/flow_tests/poke input.snoc('a) (myth/sing ['url] (pails/t "https://fixture.test/a.md")) state)
      state (fixture/flow_tests/poke input.snoc('b) (myth/sing ['url] (pails/t "https://fixture.test/b.md")) state)
      subject_page=path [state.self 'app 'nenex 'w 'research_subject]
      subject_source (str/from_atom (joined 10 [";. /research_subject" "  ;@ /subject ;/0x11/user/company" "  ;= When was this company founded?" "    Keep the selected identity explicit."]))
      state (fixture/flow_tests/apply 'author subject_page (myth/sing ['source] (pails/t subject_source)).put(['expected] (pails/n 0)) state)
      subjects=row[[path myth]] ((sovereign_peek subject_page state).tap.keep(cartography_lifecycle_tests/subject_node))
      relative=path
        ? !(eq subjects.len 1) (Seq[path] (error (pails/t "Expected one authored subject block")) [])
        = [name card] subjects.at(0)
        name
      subject=path subject_page.weld(relative)
      projection=path [state.self 'user 'research_projection]
      state (fixture/flow_tests/poke projection (myth/sing bond/weft (spun cartography_lifecycle_tests/project .none)) state)
      definition (cartography_lifecycle_tests/page).weld(['flows 'cartography])
      request (myth/sing ['definition] (safe 1 .x definition)).put(['destination] (pails/p cartography_lifecycle_tests/destination))
      request request.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex])).put(['provider] (safe 0 .x provider))
      request request.put(['input 'urls] (safe 0 .z input)).put(['input 'subject] (safe 0 .x subject)).put(['input 'projection] (safe 0 .x projection))
    | fixture/flow_tests/apply 'follow cartography_lifecycle_tests/controller request state
  + subject_node
    \ entry=[path myth]
    ^ bool
    = [name card] entry
    | card.has(['subject])
  + find
    \ step=iota target=path state=namespace
    ^ path
    = owner cartography_lifecycle_tests/controller
      record (fixture/flow_tests/get owner state)
      views (sovereign_crew_of (./some record) state)
      current (flow_request_ops/requests (bowl [] owner 0 0 flow_ops/empty views))
      matches=row[[path myth]]
        | current.tap.keep
          \ entry=[path myth]
          ^ bool
          = [name card] entry
          | and (eq name.len 1) (and (equal[pail] card.pail_at(['flow 'request_step]) (pails/q step))
              (equal[maybe[path]] card.path_at(['flow 'request_target]) (./some target)))
    ? !(eq matches.len 1) (Seq[path] (error (pails/t "Expected one selected cartography request")) [])
    = [name card] matches.at(0)
    | owner.snoc('work).weld(name)
  + fetch
    \ name=iota year=str state=namespace
    ^ namespace
    = target (cartography_lifecycle_tests/find (flow_ops/scoped ['sources 'sources] 'fetched) [name] state)
      worker (fixture/flow_tests/get target.snoc('worker) state)
    ?> waiting=flow_web/waiting worker.pail_at(['web 'waiting])
      | Seq[namespace] (error (pails/t "Native HTTP work has not dispatched")) state
    = command (fixture/flow_tests/get waiting.command state)
      url command.txt_at(['web 'url])
      content (str/from_atom (joined 10 ["# Company" (str/to_atom (str/cat_all ["Founded in " year "."]))]))
      reply (flow_web/reply url (./ok (flow_web/response 200 url "text/markdown" content)))
    | fixture/flow_tests/poke waiting.command (myth/sing ['web 'reply] reply) state
  + answer
    \ year=str quote=str
    ^ str
    | fixture_json/show (json/obj [(jkv "note" (json/str "A source-qualified founding claim."))
        (jkv "claims" (json/arr [(json/obj [(jkv "property" (json/str "/founded"))
          (jkv "value" (json/str year)) (jkv "quote" (json/str quote))
          (jkv "accepted" (json/boo .true)) (jkv "reason" (json/str "The source states this date."))])]))])
  + revision
    \ state=namespace
    ^ path
    ?> jobs=flow_work/jobs (fixture/flow_tests/get cartography_lifecycle_tests/controller state).pail_at(['flow 'jobs])
      | Seq[path] (error (pails/t "Expected a native document revision")) []
    ? !(eq jobs.entries.len 1) (Seq[path] (error (pails/t "Expected one concept revision")) [])
    | jobs.entries.at(0).request
  + generation
    \ state=namespace
    ^ nat
    ?> progress=flow_maintenance/progress (fixture/flow_tests/get cartography_lifecycle_tests/controller state).pail_at(['flow 'progress]) 999
    progress.generation
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = started cartography_lifecycle_tests/start
      fetched (cartography_lifecycle_tests/fetch 'b "2011" (cartography_lifecycle_tests/fetch 'a "2010" started))
      propose (flow_ops/scoped ['reviewed] 'proposed)
      a (cartography_lifecycle_tests/find propose ['a] fetched)
      b (cartography_lifecycle_tests/find propose ['b] fetched)
      a_done (controlled/request_tests/deliver a "complete" (cartography_lifecycle_tests/answer "2010" "Founded in 2010.") fetched)
      invalid (controlled/request_tests/deliver b "complete" (cartography_lifecycle_tests/answer "2011" "Invented quotation.") a_done)
      b_hole (fixture/flow_tests/get b invalid).path_at(['work 'hole_path]).fall([])
      retried (fixture/flow_tests/apply 'retry_revision b (myth/sing ['expected] (pails/n invalid.case(.x b).fall(0))) invalid)
      replacement (cartography_lifecycle_tests/find propose ['b] retried)
      proposed (controlled/request_tests/deliver replacement "complete" (cartography_lifecycle_tests/answer "2011" "Founded in 2011.") retried)
      judge (flow_ops/scoped ['reviewed] 'judged)
      first_review (cartography_lifecycle_tests/find judge ['review] proposed)
      conflict (controlled/request_tests/deliver first_review "complete" "{""status"":""complete"",""note"":""Pretend these claims agree.""}" proposed)
      review_hole (fixture/flow_tests/get first_review conflict).path_at(['work 'hole_path]).fall([])
      changed (fixture/flow_tests/poke (cartography_lifecycle_tests/input).snoc('b) (myth/sing ['revision] (pails/n 2)) conflict)
      refreshed (cartography_lifecycle_tests/fetch 'b "2010" changed)
      next_proposal (cartography_lifecycle_tests/find propose ['b] refreshed)
      agreed (controlled/request_tests/deliver next_proposal "complete" (cartography_lifecycle_tests/answer "2010" "Founded in 2010.") refreshed)
      next_review (cartography_lifecycle_tests/find judge ['review] agreed)
      reviewed (controlled/request_tests/deliver next_review "complete" "{""status"":""complete"",""note"":""Both selected sources state 2010.""}" agreed)
      revision (cartography_lifecycle_tests/revision reviewed)
      source (str/from_atom (joined 10 [";= Company evidence" "  Both selected sources state that this company was founded in 2010. This is a source-qualified interpretation, not complete discovery."]))
      answer (fixture_json/show (json/obj [(jkv "source" (json/str source)) (jkv "note" (json/str "Based on the two retained, reviewed source quotations."))]))
      done (controlled/request_tests/deliver revision "complete" answer reviewed)
      owner cartography_lifecycle_tests/controller
      output cartography_lifecycle_tests/destination
      cells (sovereign_view .z 0 (row/cons[iota] 'x owner.weld(['cells 'work])) done)
      overlay (sovereign_view .z 0 (row/cons[iota] 'x revision.snoc('view)) done)
      value (sovereign_view .z 0 (row/cons[iota] 'x a.snoc('value)) done)
      retained (row/all[care] (\ car=care (equal[res[axal[saga]]] (namespace/page car invalid.case(car b) b invalid) (namespace/page car invalid.case(car b) b done))) [.x .y .z])
    [(testing/nat "shipped parent invokes both captured child definitions" 1
        (fixture/flow_tests/get (cartography_lifecycle_tests/page).weld(['flows 'cartography]) started).has((flow_ops/key started.self 'definition)))
     (testing/text "invalid quote is a failed native attempt" "waiting" (fixture/flow_tests/get b invalid).txt_at(['work 'status]))
     (testing/text "invalid quote keeps its native hole unresolved" "waiting" (fixture/flow_tests/get b_hole invalid).txt_at(['work 'status]))
     (testing/nat "explicit retry allocates a different native head" 1 !(equal[path] b replacement))
     (testing/nat "retry retains its exact predecessor" 1 (equal[maybe[path]] (fixture/flow_tests/get replacement retried).path_at(['work 'retry_of]) (./some b)))
     (testing/text "a provider cannot override the selected conflict report" "waiting" (fixture/flow_tests/get review_hole conflict).txt_at(['work 'status]))
     (testing/nat "conflicting evidence does not publish a concept" 0 (cartography_lifecycle_tests/generation conflict))
     (testing/nat "changed evidence selects a new proposal" 1 !(equal[path] replacement next_proposal))
     (testing/nat "same persistent review hole gets a fresh attempt" 1 !(equal[path] first_review next_review))
     (testing/text "the same review hole resolves" "resolved" (fixture/flow_tests/get review_hole done).txt_at(['work 'status]))
     (testing/nat "native writer publishes the maintained concept" 1 (fixture/flow_tests/get output done).has(['src]))
     (testing/nat "publication happens once after current evidence agrees" 1 (cartography_lifecycle_tests/generation done))
     (testing/nat "source provenance is part of the same Nenex tree" 1 (fixture/flow_tests/get output.weld(['reference 'a]) done).has(['src]))
     (testing/nat "shared Cells work surface is readable" 1 (?=((./known _) cells)))
     (testing/nat "validated claims have an addressable native value cell" 1 (?=((./known _) value)))
     (testing/nat "revision uses the native working overlay" 1 (?=((./known _) overlay)))
     (testing/nat "old x y z attempt history remains exact" 1 retained)
     (testing/nat "the original invalid response remains retained" 1 (fixture/flow_tests/get b.snoc('worker) done).has(['work 'outcome]))]

+ tests
  ^ row[testing/case]
  | [(testing/case "Authored cartography through shared native work" cartography_lifecycle_tests/checks)]
