- flow_examples
- json [at=workspace_json]
- flow_web_mount
- flow_test_world [at=fixture]
- flow_examples_composition_tests [at=recipes]

+ workspace_tests
  + bytes
    \ text=str
    ^ nat
    | add (str/to_atom text) (bex (mul 8 text.len))
  + initial
    ^ namespace
    = state fixture/flow_tests/initial
      bag=path [state.self 'io 'fs (source_mount/mount_key "flow-examples") 'source]
      state (fixture/flow_tests/poke bag.snoc(($ta "examples.json"))
        (myth/sing bond/content (pails/n (workspace_tests/bytes (recipes/flow_examples_composition_tests/read "catalog.json")))) state)
      files=row[str] ["select-queries.semidoc" "capture-sources.semidoc" "decode-sources.semidoc" "project-sources.semidoc" "business-workspace.semidoc" "live-data.semidoc"]
      state (files.fold(state (workspace_tests/stage_source bag)))
    ?> (./ok state) (flow_web_mount/install state) state
    ?> (./ok state) (flow_examples/install state) state
    = parts=row[[str str]] [["select_queries" "select-queries.semidoc"] ["capture_sources" "capture-sources.semidoc"] ["decode_sources" "decode-sources.semidoc"] ["project_sources" "project-sources.semidoc"] ["live_data" "live-data.semidoc"]]
    | parts.fold(state workspace_tests/publish_part)
  + stage_source
    \ bag=path state=namespace file=str
    ^ namespace
    | fixture/flow_tests/poke bag.snoc(($ta (str/to_atom file)))
        (myth/sing bond/content (pails/n (workspace_tests/bytes (recipes/flow_examples_composition_tests/read file)))) state
  + publish_part
    \ state=namespace pair=[str str]
    ^ namespace
    = [name file] pair
      page=path [state.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"]))]
    ?> (./ok next) (recipes/flow_examples_composition_tests/author page name (recipes/flow_examples_composition_tests/read file) state)
      | Seq[namespace] (error (pails/t "Component did not publish")) state
    next
  + selection
    ^ path
    [($x 17) 'user 'query_selection]
  + seed
    \ catalogue=str state=namespace
    ^ namespace
    = state (fixture/flow_tests/poke workspace_tests/connection (myth/sing bond/content (pails/n (workspace_tests/bytes catalogue))) state)
      state (fixture/flow_tests/poke (workspace_tests/selection).snoc('model) (myth/sing ['query] (pails/t "catalog")) state)
    | fixture/flow_tests/poke (workspace_tests/selection).snoc('orders)
        (myth/sing ['query] (pails/t "orders")).put(['argument 'after] (pails/t "0")).put(['argument 'limit] (pails/t "10")) state
  + connection
    ^ path
    [($x 17) 'user 'sql_connection]
  + page
    ^ path
    [($x 17) 'app 'nenex 'w 'business_workspace_flow]
  + destination
    ^ path
    [($x 17) 'app 'nenex 'w 'wwi]
  + controller
    ^ path
    | (workspace_tests/page).weld(['work 'wwi])
  + input
    ^ myth
    | (myth/sing ['name] (pails/t "business_workspace")).put(['destination] (pails/t (path_show workspace_tests/destination))).put(['bindings] (pails/t "{""catalogue"":""/0x11/user/sql_connection"",""selection"":""/0x11/user/query_selection""}"))
  + invoke
    \ input=myth state=namespace
    ^ either[iota [namespace hive]]
    | namespace_command/admit (flow_examples/invoke [state.self 'app 'flow_examples 'catalogue] input) state (sovereign_hive state)
  + start
    \ catalogue=str
    ^ namespace
    = state (workspace_tests/seed catalogue workspace_tests/initial)
    ?> (./ok pair) (workspace_tests/invoke workspace_tests/input state)
      | Seq[namespace] (error (pails/t "Example invocation refused")) state
    = [next index] pair
    next
  + find_in
    \ owner=path name=iota state=namespace
    ^ path
    = record (fixture/flow_tests/get owner state)
      current (flow_request_ops/requests (bowl [] owner 0 0 flow_ops/empty (sovereign_crew_of (./some record) state)))
      entries current.tap.keep((\ [key card] (and (eq key.len 1)
        (equal[maybe[path]] card.path_at(['flow 'request_target]) (./some [name])))))
    = [key card] entries.at(0)
    | owner.snoc('work).weld(key)
  + deliver_in
    \ owner=path name=iota live=bool fail=bool state=namespace
    ^ namespace
    = worker (fixture/flow_tests/get (workspace_tests/find_in owner name state).snoc('worker) state)
    ?> waiting=flow_web/waiting worker.pail_at(['web 'waiting])
      | Seq[namespace] (error (pails/t "HTTP work was not dispatched")) state
    ?> (./known tree) (state.page(.x .none waiting.command)) state
    ?> (./some expected) tree.fil state
    = url (unpin expected.myth).txt_at(['web 'url])
      ;reply=flow_web/reply
        ? fail (flow_web/reply url (./err "Unavailable test source"))
        ? live (flow_web_foot/fetch url)
        | flow_web/reply url (./ok (flow_web/response 200 url "application/json" "{""data"":[{""id"":1}]}"))
      home=path [state.self 'io 'web]
    ?> (./ok writes) (flow_web_foot/admit home waiting.command.drop(home.len) expected reply state) state
    ?> (./ok next) (grove_install/changes writes state) state
    next
  + find
    \ name=iota state=namespace
    ^ path
    | workspace_tests/find_in workspace_tests/controller name state
  + deliver
    \ name=iota live=bool fail=bool state=namespace
    ^ namespace
    | workspace_tests/deliver_in workspace_tests/controller name live fail state
  + outcome
    \ result=either[iota [namespace hive]]
    ^ str
    ? result
     > (./err why) (str/from_atom (quip_val why))
     > (./ok pair) "accepted"
  + checks
    \ catalogue=str live=bool ignored=unit
    ^ row[testing/check]
    = started (workspace_tests/start catalogue)
      first (workspace_tests/find 'orders started)
      partial (workspace_tests/deliver 'model live .false started)
      failed (workspace_tests/deliver 'orders live .true partial)
      hole (fixture/flow_tests/get first failed).path_at(['work 'hole_path]).fall([])
      retry (fixture/flow_tests/apply 'retry_revision first (myth/sing ['expected] (pails/n failed.case(.x first).fall(0))) failed)
      second (workspace_tests/find 'orders retry)
      done (workspace_tests/deliver 'orders live .false retry)
      repeated=namespace
        ?> (./ok pair) (workspace_tests/invoke workspace_tests/input done) started
        = [next index] pair
        next
      source (fixture/flow_tests/get workspace_tests/page done).txt_at(['src])
      edited (fixture/flow_tests/apply 'author workspace_tests/page
        (myth/sing ['source] (pails/t (str/cat_all [source "\n  A deliberate source note.\n"]))).put(['expected] (pails/n done.case(.x workspace_tests/page).fall(0))) done)
      kept=namespace
        ?> (./ok pair) (workspace_tests/invoke workspace_tests/input edited) started
        = [next index] pair
        next
      rebound (workspace_tests/invoke (workspace_tests/input).put(['bindings] (pails/t "{""catalogue"":""/0x11/user/different"",""selection"":""/0x11/user/query_selection""}")) done)
      retained (row/all[care] (\ car=care (equal (failed.page(car failed.case(car first) first)) (done.page(car failed.case(car first) first)))) [.x .y .z])
      cells (sovereign_view .z 0 (row/cons[iota] 'x (workspace_tests/controller).weld(['cells 'work])) done)
      annotation (workspace_tests/destination).weld(['investigations 'local_note])
      annotated (fixture/flow_tests/apply 'author annotation (myth/sing ['source] (pails/t ";= Local investigation\n  Keep my work.\n")).put(['expected] (pails/n 0)) done)
      revised (fixture/flow_tests/poke workspace_tests/connection (myth/sing ['revision] (pails/n 2)) annotated)
      refreshed (workspace_tests/deliver 'orders live .false (workspace_tests/deliver 'model live .false revised))
      overlay (sovereign_view .z 0 (row/cons[iota] 'x (workspace_tests/controller).snoc('view)) done)
      composed=bool
        ?> definition=flow/definition (fixture/flow_tests/get (workspace_tests/page).weld(['flows 'business_workspace]) started).pail_at((flow_ops/key started.self 'definition)) .false
        = names=row[str] ["select_queries" "capture_sources" "decode_sources" "project_sources"]
          expected=row[path] names.map((\ name=str [started.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"])) 'flows ($ts name)]))
        | and (equal[row[path]] definition.steps.map((\ step=flow/step step.origin.path)) expected) (definition.steps.all((\ step=flow/step (gt step.origin.ver 0))))
      child_paths=str
        ?> definition=flow/definition (fixture/flow_tests/get (workspace_tests/page).weld(['flows 'business_workspace]) started).pail_at((flow_ops/key started.self 'definition)) "missing"
        | str/join " | " (definition.steps.map((\ step=flow/step (path_show step.origin.path))))
      cfg (fixture/flow_tests/get workspace_tests/controller done)
      pinned=bool
        ?> config=flow_maintenance/config cfg.pail_at(['flow 'config]) .false
        ?> reference=safe (unpin config.request).pail_at(['definition]) .false
        | gt reference.ver 0
    | [(testing/nat "one invocation authors and publishes the procedure" 1 (fixture/flow_tests/get (workspace_tests/page).weld(['flows 'business_workspace]) started).has((flow_ops/key started.self 'definition)))
       (testing/nat "definition is explicitly retained" 1 pinned)
       (testing/nat "composition captures four separately published child definitions" 1 composed)
       (testing/text "composition names each reusable definition" "/0x11/app/nenex/w/select_queries_flow/flows/select_queries | /0x11/app/nenex/w/capture_sources_flow/flows/capture_sources | /0x11/app/nenex/w/decode_sources_flow/flows/decode_sources | /0x11/app/nenex/w/project_sources_flow/flows/project_sources" child_paths)
       (testing/nat "failed capture cannot publish the workspace" 0 (fixture/flow_tests/get workspace_tests/destination failed).has(['src]))
       (testing/text "failure uses the shared persistent hole" "waiting" (fixture/flow_tests/get hole failed).txt_at(['work 'status]))
       (testing/nat "retry retains a distinct attempt" 1 !(equal[path] first second))
       (testing/text "retry resolves the same hole" "resolved" (fixture/flow_tests/get hole done).txt_at(['work 'status]))
       (testing/nat "all six authored wiki pages assemble" 1 (row/all[path] (\ path (fixture/flow_tests/get (workspace_tests/destination).weld(path) done).has(['src])) [[] ['overview] ['model] ['records] ['investigations] ['procedures]]))
       (testing/nat "both captured source documents assemble" 1 (row/all[iota] (\ name (fixture/flow_tests/get (workspace_tests/destination).weld(['reference name]) done).has(['src])) ['model 'orders]))
       (testing/nat "shared work cells are readable" 1 (?=((./known _) cells)))
       (testing/nat "native working overlay is readable" 1 (?=((./known _) overlay)))
       (testing/text "repeat admission accepted" "accepted" (workspace_tests/outcome (workspace_tests/invoke workspace_tests/input done)))
       (testing/nat "same invocation is an exact no-op" 1 (equal[namespace] repeated done))
       (testing/nat "repeat does not overwrite or republish edited source" 1 (equal[namespace] kept edited))
       (testing/nat "changed bindings require deliberate rebinding" 1 (either/is_err rebound))
       (testing/nat "explicit source revision creates a fresh request" 1 !(equal[path] second (workspace_tests/find 'orders revised)))
       (testing/nat "refresh preserves user-authored wiki children" 1 (equal[myth] (fixture/flow_tests/get annotation annotated) (fixture/flow_tests/get annotation refreshed)))
       (testing/nat "refreshed workspace retains its document" 1 (fixture/flow_tests/get workspace_tests/destination refreshed).has(['src]))
       (testing/nat "failed attempt x y z history retained" 1 retained)]
  + owner
    \ name=str leaf=iota
    ^ path
    [($x 17) 'app 'nenex 'w ($ts (str/cat_all [name "_flow"])) 'work leaf]
  + result_path
    \ owner=path state=namespace
    ^ path
    ?> progress=flow_maintenance/progress (fixture/flow_tests/get owner state).pail_at(['flow 'progress]) []
    | (row/cons[iota] 'x owner.weld(['work ($u progress.generation) 'result]))
  + result
    \ owner=path state=namespace
    ^ axal[myth]
    ?> (./known value) (sovereign_view .z 0 (workspace_tests/result_path owner state) state) flow_ops/empty
    value
  + component
    \ name=str leaf=iota bindings=row[[str path]] writer=path state=namespace
    ^ namespace
    = fields bindings.map((\ [port target] (jkv port (json/str (path_show target)))))
      input (myth/sing ['name] (pails/t name)).put(['destination] (pails/t (path_show [state.self 'user 'outputs leaf])))
      input input.put(['bindings] (pails/t (workspace_json/show (json/obj fields)))).put(['writer] (pails/t (path_show writer)))
    = admitted (workspace_tests/invoke input state)
    ?> (./ok pair) admitted
      | Seq[namespace] (error (pails/t (workspace_tests/outcome admitted))) state
    = [next index] pair
    next
  + components
    \ ignored=unit
    ^ row[testing/check]
    = names=row[str] ["select_queries" "capture_sources" "decode_sources" "project_sources"]
      initial workspace_tests/initial
      catalogue=str "{""accounts_page"":{""url"":""http://crm.example.test/accounts""},""pipeline_page"":{""url"":""http://crm.example.test/pipeline""}}"
      initial (fixture/flow_tests/poke workspace_tests/connection (myth/sing bond/content (pails/n (workspace_tests/bytes catalogue))) initial)
      initial (fixture/flow_tests/poke (workspace_tests/selection).snoc('accounts) (myth/sing ['query] (pails/t "accounts_page")).put(['argument 'region] (pails/t "west & east")) initial)
      initial (fixture/flow_tests/poke (workspace_tests/selection).snoc('opportunities) (myth/sing ['query] (pails/t "pipeline_page")).put(['argument 'take] (pails/t "3")) initial)
      writer=path [initial.self 'gov 'flow_examples 'retain_result]
      selected (workspace_tests/component "select_queries" 'selected [["catalogue" workspace_tests/connection] ["selection" workspace_tests/selection]] writer initial)
      selection_owner (workspace_tests/owner "select_queries" 'selected)
      selection (workspace_tests/result selection_owner selected)
      capture_owner (workspace_tests/owner "capture_sources" 'captured)
      capturing (workspace_tests/component "capture_sources" 'captured [["urls" (workspace_tests/result_path selection_owner selected)]] writer selected)
      captured (workspace_tests/deliver_in capture_owner 'opportunities .false .false (workspace_tests/deliver_in capture_owner 'accounts .false .false capturing))
      decoding (workspace_tests/component "decode_sources" 'decoded [["sources" (workspace_tests/result_path capture_owner captured)]] writer captured)
      decode_owner (workspace_tests/owner "decode_sources" 'decoded)
      decoded (workspace_tests/result decode_owner decoding)
      ' An authored page brief, not a business-specific projection in code.
      brief=path [initial.self 'user 'page_brief]
      brief_card (flow_operations/expose (flow/page "CRM evidence" [(snode/prose "Selected accounts and opportunities." [])] ['accounts 'opportunities]))
      ready (fixture/flow_tests/poke brief brief_card decoding)
      projected (workspace_tests/component "project_sources" 'projected [["pages" brief] ["sources" (workspace_tests/result_path decode_owner decoding)]] writer ready)
      output (workspace_tests/result (workspace_tests/owner "project_sources" 'projected) projected)
      invalid (flow_query_sources/select ((flow_ops/empty).put(['catalogue] (fixture/flow_tests/get workspace_tests/connection initial)).put(['selection 'missing] (myth/sing ['query] (pails/t "unconfigured")))))
      historical (row/all[care] (\ car=care (equal (selected.page(car selected.case(car selection_owner) selection_owner)) (projected.page(car selected.case(car selection_owner) selection_owner)))) [.x .y .z])
    | [(testing/nat "each component has an independently published definition" 1
          (row/all[str] (\ name=str (fixture/flow_tests/get [initial.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"])) 'flows ($ts name)] initial).has((flow_ops/key initial.self 'definition))) names))
       (testing/nat "discovery links to native recipe source and publication" 1
         (and (fixture/flow_tests/get [initial.self 'gov 'flows 'examples 'select_queries] initial).has(['example 'source])
              (fixture/flow_tests/get [initial.self 'gov 'flows 'examples 'select_queries] initial).has(['example 'publications])))
       (testing/text "selection uses configured query and encodes supplied arguments" "http://crm.example.test/accounts?region=west%20%26%20east" selection.get(['accounts]).fall(myth/new).txt_at(['url]))
       (testing/text "no order name or page-size default is injected" "http://crm.example.test/pipeline?take=3" selection.get(['opportunities]).fall(myth/new).txt_at(['url]))
       (testing/nat "standalone capture settles shared HTTP work" 1 (workspace_tests/result capture_owner captured).get(['accounts]).fall(myth/new).has(['flow 'source]))
       (testing/nat "standalone decoder consumes the capture result cell" 1 decoded.get(['accounts]).fall(myth/new).has(['data]))
       (testing/nat "standalone projector consumes decoded data and authored briefs" 1 output.get(['reference 'opportunities]).fall(myth/new).has(['data]))
       (testing/nat "data-only invocation creates no document at the destination" 0 (fixture/flow_tests/get [initial.self 'user 'outputs 'selected] projected).has(['src]))
       (testing/nat "unknown configured query refuses instead of falling back" 1 (either/is_err invalid))
       (testing/nat "chaining preserves prior component x y z history" 1 historical)]
  + fixture
    ^ str
    "{""catalog"":{""url"":""http://example.test/catalog""},""orders"":{""url"":""http://example.test/orders""}}"
  + refusal
    \ ignored=unit
    ^ row[testing/check]
    = state workspace_tests/initial
      occupied (fixture/flow_tests/poke workspace_tests/destination (myth/sing ['note] (pails/t "Existing work")) state)
      collision (workspace_tests/invoke workspace_tests/input occupied)
      invalid (workspace_tests/invoke (workspace_tests/input).put(['bindings] (pails/t "{}")) state)
      malformed (workspace_tests/invoke (workspace_tests/input).put(['bindings] (pails/t "{""connection"":""/a"",""connection"":""/b""}")) state)
    | [(testing/nat "occupied destination is refused" 1 (either/is_err collision))
       (testing/nat "missing required binding rejects the complete admission" 1 (either/is_err invalid))
       (testing/nat "duplicate bindings are refused" 1 (either/is_err malformed))
       (testing/nat "refused admission leaves source unpublished" 0 (fixture/flow_tests/get workspace_tests/page state).has(['src]))]

+ tests
  ^ row[testing/case]
  [(testing/case "one invocation assembles a maintained workspace" (workspace_tests/checks workspace_tests/fixture .false))
   (testing/case "workspace collision and atomic refusal" workspace_tests/refusal)
   (testing/case "independently invocable data components" workspace_tests/components)]
