- flow_library_tests [at=library]
- flow_examples_composition_tests [at=recipes]
- flow_test_world [at=fixture]
- flow_request_fixture [at=provider_fixture]
- semidoc [at=doc]

+ authoring_recipe_checks
  + wiki_names
    ^ row[iota]
    ['mounts 'grove 'hello 'hands 'overlays 'cooperate 'authoring 'harness 'semidoc 'goo 'drafts]
  + literal
    \ lang=nat node=snode
    ^ bool
    ? node
     > (./lit language attrs text) (eq language lang)
    | (tmpl/kids_of node).any((authoring_recipe_checks/literal lang))
  + wiki
    \ ignored=unit
    ^ row[testing/check]
    = source (recipes/flow_examples_composition_tests/read "authoring-wiki.semidoc")
      state (library/library_tests/author 'authoring_wiki "authoring-wiki.semidoc" library/library_tests/base)
      definition (library/library_tests/recipe state 'authoring_wiki)
      sources (recipes/flow_examples_composition_tests/sources authoring_recipe_checks/wiki_names)
      result (flow_ops/evaluate definition (axal/new[axal[myth]] .none).put(['sources] sources))
    ?> (./ok evaluation) result
      [(testing/text "authored wiki evaluates" "ok" (recipes/flow_examples_composition_tests/evaluation_reason result))]
    = pages (unpin evaluation.result)
      expected=row[path] [[] ['start] ['grove] ['grove 'records] ['grove 'codecs] ['grove 'views] ['grove 'actions] ['grove 'panes]
        ['computed_values] ['overlays] ['hands] ['hands 'arms] ['hands 'dependencies] ['procedures] ['procedures 'authoring]
        ['procedures 'composition] ['procedures 'extraction] ['collaboration] ['mounting] ['mounting 'workspaces] ['publication]
        ['mounting 'snapshots] ['verification] ['troubleshooting]]
      capture=path [state.self 'user 'wiki_sources]
      state (sources.tap.fold(state (\ current=namespace [name card] (fixture/flow_tests/poke capture.weld(name) card current))))
      controller=path [state.self 'user 'wiki_maintenance]
      destination=path [state.self 'app 'nenex 'w 'authoring_wiki]
      input (myth/sing ['definition] (safe 0 .x definition.source.path.weld(['flows 'authoring_wiki])))
      input input.put(['destination] (pails/p destination)).put(['writer] (safe 0 .x (flow_ops/key state.self 'nenex)))
      input input.put(['input 'sources] (safe 0 .z capture))
      published (fixture/flow_tests/apply 'follow controller input state)
      tree (sovereign_peek destination published)
      typed_pages=bool (expected.all((\ name=path pages.get(name).fall(myth/new).has(['flow 'page]))))
      reference=flow/page
        ?> page=flow/page pages.get(['reference 'grove]).fall(myth/new).pail_at(['flow 'page]) (flow/page "" [] [])
        page
      [removed index reply] (helm/supervisor/step capture.snoc('grove) .cull 0 0 published (sovereign_hive published))
      unavailable (fixture/flow_tests/accepted reply removed)
      missing (flow_ops/evaluate definition (axal/new[axal[myth]] .none).put(['sources] sources.del(['grove])))
    | [(testing/nat "wiki has authored concept documents, not README copies" 1 typed_pages)
       (testing/nat "wiki produces all 24 authored pages plus compact provenance" (add 25 (authoring_recipe_checks/wiki_names).len) pages.wyt)
       (testing/nat "literal Semidoc example remains inert" 1 ((doc/parse (str/to_atom source)).any((authoring_recipe_checks/literal "semidoc"))))
       (testing/nat "Grove examples remain literal" 1 ((doc/parse (str/to_atom source)).any((authoring_recipe_checks/literal "grove"))))
       (testing/nat "a reference page holds identity rather than copied source prose" 2 reference.body.len)
       (testing/nat "wiki needs no provider or revision jobs" 0 (fixture/flow_tests/get controller published).has(['flow 'jobs]))
       (testing/nat "wiki installs through the ordinary Nenex writer" 1 (library/library_tests/generation controller published))
       (testing/nat "installed child documents include native arms and mounting" 1 (and tree.has(['hands 'arms]) tree.has(['mounting 'workspaces])))
       (testing/nat "compact provenance refuses an absent cited source" 1 (either/is_err missing))
       (testing/nat "missing source cannot replace current evidence with an old capture" 1 (library/library_tests/generation controller unavailable))]

+ tests
  ^ row[testing/case]
  [(testing/case "Authored wiki projects real concept documents" authoring_recipe_checks/wiki)]
