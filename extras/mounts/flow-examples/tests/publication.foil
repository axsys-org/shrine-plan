- flow_examples
- flow_test_world [at=fixture]

+ library_publication_tests
  + page
    \ name=str
    ^ path
    [($x 17) 'app 'nenex 'w ($ts (str/cat_all [name "_flow"]))]
  + file
    \ name=str
    ^ path
    [($x 17) 'io 'fs (source_mount/mount_key "flow-examples") 'source ($ta (str/to_atom name))]
  + bytes
    \ text=str
    ^ myth
    | myth/sing bond/content (pails/n (add (str/to_atom text) (bex (mul 8 text.len))))
  + source
    \ name=str reference=str invoke=bool
    ^ str
    | str/from_atom (joined 10
      [(str/cat_all [";. /" name "_flow"]) (str/cat_all ["  ;@ /flow/definition " name]) "  ;= Copy"
       "    ;@ /flow/input input" "    ;= Input"
       (str/cat_all ["    ;@ /flow/" (? invoke "invoke" "step") " first ;" reference])
       (str/cat_all ["    ;@ /flow/bind " (? invoke "input" "value") " input"]) "    ;= First"
       (str/cat_all ["    ;@ /flow/" (? invoke "invoke" "step") " second ;" reference])
       (str/cat_all ["    ;@ /flow/bind " (? invoke "input" "value") " first"]) "    ;= Second"
       "    ;@ /flow/result second" "    ;= Result"])
  + child
    ^ str
    | library_publication_tests/source "child" "/0x11/gov/flows/operations/identity" .false
  + parent
    ^ str
    | library_publication_tests/source "parent" "/0x11/app/nenex/w/child_flow/flows/child" .true
  + base
    ^ namespace
    = catalog=str "{""parent"":{""source"":""parent.semidoc""},""child"":{""source"":""child.semidoc""}}"
      state (fixture/flow_tests/poke (library_publication_tests/file "examples.json") (library_publication_tests/bytes catalog) fixture/flow_tests/initial)
      state (fixture/flow_tests/poke (library_publication_tests/file "parent.semidoc") (library_publication_tests/bytes library_publication_tests/parent) state)
      state (fixture/flow_tests/poke (library_publication_tests/file "child.semidoc") (library_publication_tests/bytes library_publication_tests/child) state)
      bag (library_publication_tests/file "examples.json").take(5)
      state (fixture/flow_tests/poke bag.take(4) (myth/sing bond/res (fs/report 1 bag ["examples.json" "parent.semidoc" "child.semidoc"] [])) state)
    ?> (./ok installed) (flow_examples/install state)
      | Seq[namespace] (error (pails/t "Library fixture registration failed")) state
    installed
  + apply
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) result (Seq[namespace] (error (pails/t "Library operation refused")) state)
    ?> (./ok next) (grove_install/changes writes state) (Seq[namespace] (error (pails/t "Library operation admission failed")) state)
    next
  + inspect
    \ label=str state=namespace
    ^ namespace
    | library_publication_tests/apply (flow_library_publication/inspect (flow_library_publication/catalogue state.self)
        ((myth/sing ['name] (pails/t "parent")).put(['inspection] (pails/t label))) state) state
  + publish
    \ label=str state=namespace
    ^ namespace
    | library_publication_tests/apply (flow_library_publication/publish (flow_library_publication/catalogue state.self)
        (myth/sing ['inspection] (pails/t label)) state) state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = base library_publication_tests/base
      parent (library_publication_tests/page "parent")
      child (library_publication_tests/page "child")
      inspected (library_publication_tests/inspect "first" base)
      cell (flow_library_publication/catalogue base.self).weld(['cells 'first])
    ?> held=cell_view (fixture/flow_tests/get cell inspected).pail_at(['library 'plan]) [(testing/nat "inspection is a native value cell" 1 0)]
    = entries (unpin held.tree)
      published (library_publication_tests/publish "first" inspected)
      root=path parent.weld(['flows 'parent])
      leaf=path child.weld(['flows 'child])
    ?> original=flow/definition (fixture/flow_tests/get root published).pail_at((flow_ops/key base.self 'definition)) [(testing/nat "parent publishes after its child" 1 0)]
    = local (str/cat_all [library_publication_tests/parent (str/from_atom 10) "    Authored local explanation."])
      edited (library_publication_tests/apply (flow_nenex_ops/author parent ((myth/sing ['source] (pails/t local)).put(['expected] (pails/n published.case(.x parent).fall(0)))) published) published)
      reviewed (library_publication_tests/inspect "local" edited)
      kept (library_publication_tests/publish "local" reviewed)
      stale (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "first")) published)
      again (library_publication_tests/inspect "again" kept)
      unchanged (library_publication_tests/publish "again" again)
      file (library_publication_tests/file "child.semidoc")
      advanced (fixture/flow_tests/poke file (library_publication_tests/bytes (str/cat_all [library_publication_tests/child (str/from_atom 10) "    New template instructions."])) again)
      outdated (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "again")) advanced)
      revised (library_publication_tests/inspect "updated" advanced)
      retained (library_publication_tests/publish "updated" revised)
      history (row/all[care] (\ care=care (equal (published.page(care published.case(care root) root)) (retained.page(care published.case(care root) root)))) [.x .y .z])
    | [(testing/nat "shared child is planned only once" 2 entries.wyt)
       (testing/nat "dependency precedes its consumer" 1 (equal[maybe[path]] entries.get([($u 0)]).fall(myth/new).path_at(['page]) (./some child)))
       (testing/nat "inspection creates no authored document" 0 (cooperate_ops/record parent inspected).is_some)
       (testing/nat "inspection publishes no child" 0 (cooperate_ops/record leaf inspected).is_some)
       (testing/nat "publication captures both calls to the same exact child" 1 (and (eq original.steps.len 2) (original.steps.all((\ step=flow/step (and (equal[path] step.origin.path leaf) (eq step.origin.ver published.case(.x leaf).fall(0))))))))
       (testing/nat "published source advances only with a fresh inspection" 1 (either/is_err stale))
       (testing/text "locally authored source survives publication" local (fixture/flow_tests/get parent kept).txt_at(['src]))
       (testing/text "comparison keeps the shipped source separately" library_publication_tests/parent (fixture/flow_tests/get (flow_library_publication/catalogue base.self) reviewed).txt_at(['library 'shipped]))
       (testing/nat "publishing unchanged definitions is idempotent" 1 (equal[maybe[nat]] kept.case(.x root) unchanged.case(.x root)))
       (testing/nat "changed template invalidates an outstanding inspection" 1 (either/is_err outdated))
       (testing/text "new template never overwrites an authored child" library_publication_tests/child (fixture/flow_tests/get child retained).txt_at(['src]))
       (testing/nat "publication preserves all earlier x/y/z readings" 1 history)
       (testing/nat "inspection remains frozen after publication and later edits" 1 (equal[pail] held (fixture/flow_tests/get cell retained).pail_at(['library 'plan])))
       (testing/nat "publication does not allocate flow work or dispatch a provider" 0 (sovereign_peek parent.snoc('work) retained).wyt)]
  + guards
    \ ignored=unit
    ^ row[testing/check]
    = base library_publication_tests/base
      parent (library_publication_tests/page "parent")
      child (library_publication_tests/page "child")
      inspected (library_publication_tests/inspect "guarded" base)
      identity (flow_ops/key base.self 'operations).snoc('identity)
      changed (fixture/flow_tests/poke identity (myth/sing ['changed] (pails/b .true)) inspected)
      stale (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "guarded")) changed)
      cyclic_source (library_publication_tests/source "child" "/0x11/app/nenex/w/parent_flow/flows/parent" .true)
      cyclic (fixture/flow_tests/poke (library_publication_tests/file "child.semidoc") (library_publication_tests/bytes cyclic_source) base)
      cycle (flow_library_publication/visit parent.weld(['flows 'parent]) [] [] cyclic)
      unavailable_source (library_publication_tests/source "child" "/0x11/app/nenex/w/absent_flow/flows/absent" .true)
      missing (fixture/flow_tests/poke (library_publication_tests/file "child.semidoc") (library_publication_tests/bytes unavailable_source) base)
      missing (library_publication_tests/inspect "missing" missing)
      refuses (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "missing")) missing)
      published (library_publication_tests/publish "guarded" inspected)
      pinned_ref (path_show (safe/spell (safe published.case(.x child.weld(['flows 'child])).fall(0) .x child.weld(['flows 'child]))))
      pinned_source (library_publication_tests/source "parent" pinned_ref .true)
      pinned (library_publication_tests/apply (flow_nenex_ops/author parent ((myth/sing ['source] (pails/t pinned_source)).put(['expected] (pails/n published.case(.x parent).fall(0)))) published) published)
      pinned_plan (flow_library_publication/visit parent.weld(['flows 'parent]) [] [] pinned)
      malformed (str/cat_all [library_publication_tests/parent (str/from_atom 10) "    ;@ /flow/result first" (str/from_atom 10) "    ;= Conflicting result"])
      broken (fixture/flow_tests/poke (library_publication_tests/file "parent.semidoc") (library_publication_tests/bytes malformed) base)
      broken (library_publication_tests/inspect "broken" broken)
      [refused refused_index reply] (helm/supervisor/admit
        (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "broken"))) broken (sovereign_hive broken))
      rollback (row/all[care] (\ care=care (equal (broken.page(care broken.case(care [base.self]) [base.self])) (refused.page(care broken.case(care [base.self]) [base.self])))) [.x .y .z])
      file (library_publication_tests/file "child.semidoc")
      names=row[str] ["examples.json" "parent.semidoc" "child.semidoc"]
      removed (fixture/flow_tests/poke file.take(4) (myth/sing bond/res (fs/report 2 file.take(5) names ["child.semidoc"])) inspected)
      unavailable (flow_library_publication/publish (flow_library_publication/catalogue base.self) (myth/sing ['inspection] (pails/t "guarded")) removed)
      absent_recipe (namespace_command/plan child [base.self 'gov 'flows 'examples 'child] myth/new removed)
      restored (fixture/flow_tests/poke file.take(4) (myth/sing bond/res (fs/report 3 file.take(5) names [])) removed)
      fresh (library_publication_tests/inspect "restored" restored)
      resumed (library_publication_tests/publish "restored" fresh)
      renamed (fixture/flow_tests/poke (library_publication_tests/file "parent.semidoc") (library_publication_tests/bytes library_publication_tests/child) base)
      renamed (library_publication_tests/apply (flow_library_publication/inspect (flow_library_publication/catalogue base.self)
        ((myth/sing ['name] (pails/t "parent")).put(['id] (pails/t "child")).put(['inspection] (pails/t "renamed"))) renamed) renamed)
      renamed (library_publication_tests/publish "renamed" renamed)
    | [(testing/nat "changed operation guard rejects old publication review" 1 (either/is_err stale))
       (testing/nat "live dependency cycle refuses before publication" 1 (either/is_err cycle))
       (testing/nat "missing external source refuses without a partial publication" 1 (either/is_err refuses))
       (testing/nat "pinned child is not republished or recursively upgraded" 1 (either/ok_val pinned_plan).len)
       (testing/nat "late compiler refusal rolls back child creation and publication" 0 (sovereign_peek child refused).wyt)
       (testing/nat "failed native admission preserves x/y/z history" 1 rollback)
       (testing/nat "missing source bytes remain retained" 1 (gt (fixture/flow_tests/get file removed).nat_at(bond/content 0) 1))
       (testing/text "missing source is not offered as a current template" "" (flow_library_publication/source (safe 0 .x file) removed))
       (testing/nat "watch report deletion invalidates a publication inspection" 1 (either/is_err unavailable))
       (testing/nat "creation cannot bypass the missing source report" 1 (either/is_err absent_recipe))
       (testing/nat "restored source permits fresh native publication" 1 (cooperate_ops/record child.weld(['flows 'child]) resumed).is_some)
       (testing/nat "the selected definition can differ from its recipe name" 1 (cooperate_ops/record parent.weld(['flows 'child]) renamed).is_some)
       (testing/nat "failed preparation leaves missing children absent" 0 (cooperate_ops/record child missing).is_some)]

+ tests
  ^ row[testing/case]
  [(testing/case "Review and publish library dependencies through native admission" library_publication_tests/checks)
   (testing/case "Publication review guards and pinned dependencies" library_publication_tests/guards)]
