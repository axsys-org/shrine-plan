- flow_stage_fixture [at=staged]
- flow_action_tests [at=actions]
- tests/goo_runtime [at=goo_fixture]
- flow_test_world
- flow_test_world [at=fixture]
- flow_request_fixture [at=request_fixture]
- flow_request_fixture [at=provider_fixture]
- flow_examples_composition_tests [at=recipes]
- json [at=reply_json]

+ stage_checks
  + origin
    ^ path
    [($x 17) 'user 'selected]
  + capture
    \ target=path version=nat record=myth
    ^ myth
    | native_work_ops/frozen target (native_work/captured (safe version .x target) .none (pin (flow_ops/empty).put([] record)))
  + reason
    \ result=either[iota axal[myth]]
    ^ str
    ?> (./err why) result "ok"
    | str/from_atom (quip_val why)
  + guide
    \ ignored=unit
    ^ row[testing/check]
    = state (staged/stage_fixture/publish staged/stage_fixture/base "working_with_shrine" "author_publish")
      published (recipes/flow_examples_composition_tests/definition [state.self 'app 'nenex 'w 'working_with_shrine_flow 'flows 'author_publish] state)
    | [(testing/nat "Guide publication procedure composes native action receipts" 1 published.is_some)]
  + controls
    \ ignored=unit
    ^ row[testing/check]
    = ;bytes (ReadFile "grove/flow-examples/catalogue.grove")
      source (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ?> (./ok document) (grove/parse source)
      [(testing/nat "the actual catalogue controls parse" 1 0)]
    | [(testing/nat "the actual catalogue including observation authoring lowers to Goo" 1
        (either/is_ok (grove_views/compile [($x 17) 'gov 'flow_examples] document
          (\ path=path .none) .nil (goo/html_types ['lib 'grove 'types]) "browse")))]
  + validate
    \ text=str
    ^ either[iota axal[myth]]
    = held (native_work/captured (safe 1 .x stage_checks/origin) .none (pin flow_ops/empty))
      outcome (native_work/outcome "complete" text (pin held))
    | flow_stages/validate ["summary" "note"] (flow_ops/empty).put([] (myth/sing ['subject] held.source))
        (flow_ops/empty).put(['response] (myth/sing ['work 'outcome] outcome))
  + proposals
    \ ignored=unit
    ^ row[testing/check]
    = checked (stage_checks/validate "{""summary"":""Observed result"",""note"":""Selected evidence""}")
      result (either/ok_val checked).fil.fall(myth/new)
      projection (flow_stages/project (flow_ops/empty).rep(['value] (either/ok_val checked)))
    | [(testing/text "structured result has a directly addressable summary" "Observed result" result.txt_at(['summary]))
       (testing/nat "result retains native evidence rather than parsing a report" 1 result.has(['stage 'evidence]))
       (testing/nat "proposal is not silently a document" 0 result.has(['flow 'page]))
       (testing/nat "document projection is independently callable" 1 (either/ok_val projection).fil.fall(myth/new).has(['flow 'page]))
       (testing/text "missing input stays unresolved" "flow_revision_unresolved" (stage_checks/reason (stage_checks/validate "{""summary"":"""",""note"":""Which subject?""}")))
       (testing/nat "duplicate schema fields refuse" 1 (either/is_err (stage_checks/validate "{""summary"":""One"",""summary"":""Two""}")))
       (testing/nat "a report string cannot masquerade as a native result" 1 (either/is_err (stage_checks/validate "{""report"":""Everything worked""}")))]
  + action_result
    \ state=namespace
    ^ axal[myth]
    = attempt (request_fixture/request_tests/attempt 1)
      response=cell_view
        ?> held=cell_view (flow_tests/get attempt state).pail_at(['flow 'response]) (cell_view (pin flow_ops/empty))
        held
    | (flow_ops/empty).put(['action] (unpin response.tree).fil.fall(myth/new))
  + verification
    \ ignored=unit
    ^ row[testing/check]
    = [state query] actions/flow_action_tests/started
      receipts (stage_checks/action_result state)
      target query.subject
      actual (flow_tests/get target state)
      observed (stage_checks/capture target state.case(.x target).fall(0) actual)
      check (myth/sing ['target] (pails/p target)).put(['after] (pails/n query.expected))
      check check.put(['expect 'sys 'req] (pails/t "After"))
      args (flow_ops/empty).rep(['receipts] receipts).put(['checks 'result] check).put(['observations 'result] observed)
      verified (flow_stages/verify_records args)
      stale args.put(['observations 'result] (stage_checks/capture target query.expected actual))
      wrong args.put(['observations 'result] (stage_checks/capture stage_checks/origin state.case(.x target).fall(0) actual))
      mismatch args.put(['checks 'result] check.put(['expect 'sys 'req] (pails/t "Unobserved")))
      fake (myth/sing ['work 'outcome] (native_work/outcome "complete" "{""outcome"":""accepted"",""target"":""somewhere"",""operationId"":""invented""}" (pin actions/flow_action_tests/guard)))
    | [(testing/text "real action receipt and matching observation verify" "ok" (stage_checks/reason verified))
       (testing/nat "verified result retains exact native capture" 1 (equal[pail] observed.pail_at(['capture]) (either/ok_val verified).get(['result]).fall(myth/new).pail_at(['capture])))
       (testing/nat "missing observations cannot reuse a historical record implicitly" 1 (either/is_err (flow_stages/verify_records args.del(['observations 'result]))))
       (testing/nat "old version is refused even if its value matches" 1 (either/is_err (flow_stages/verify_records stale)))
       (testing/nat "another record cannot satisfy the selected postcondition" 1 (either/is_err (flow_stages/verify_records wrong)))
       (testing/nat "accepted effect does not establish an unobserved postcondition" 1 (either/is_err (flow_stages/verify_records mismatch)))
       (testing/nat "provider prose cannot forge an action receipt" 1 (either/is_err (flow_stages/receipts (flow_ops/empty).put(['responses 'action] fake))))]
  + grove
    \ ignored=unit
    ^ row[testing/check]
    = path=path [($x 17) 'app 'grove_authoring 'drafts 'notes]
      receipts (stage_checks/controlled_receipt path)
      job (grove_draft/job "native source" 2 2 2 0 0 "Compiled" 0)
      record (myth/sing (grove_authoring/job_slot path.at(0)) job)
      proposal (myth/sing ['name] (pails/t "notes")).put(['source] (pails/t job.source))
      args (flow_ops/empty).put(['capture] (stage_checks/capture path 10 record)).put(['proposal] proposal).rep(['receipts] receipts)
      compiled (flow_stages/grove_ready .false args)
      old args.put(['capture] (stage_checks/capture path 11 (record.put((grove_authoring/job_slot path.at(0)) job.set_revision(3)))))
      changed args.put(['proposal] proposal.put(['source] (pails/t "edited source")))
      publishing (flow_stages/grove_ready .true args)
      published args.put(['capture] (stage_checks/capture path 12 (record.put((grove_authoring/job_slot path.at(0)) job.set_published(2)))))
      query (goo_runtime/request "act" path path [] [0] 10 1 1 [] 0)
      selection (myth/sing ['goo 'request] query)
      save (flow_ops/empty).put(['before] (stage_checks/capture path 10 record)).put(['proposal] proposal).put(['selection] selection)
      publish (flow_ops/empty).rep(['verified] (either/ok_val compiled)).put(['selection] selection)
    | [(testing/text "Grove inspection retains the actual compiled job" "ok" (stage_checks/reason compiled))
       (testing/nat "old compiled preview cannot satisfy a newer source revision" 1 (either/is_err (flow_stages/grove_ready .false old)))
       (testing/nat "different proposed source cannot borrow a successful compilation" 1 (either/is_err (flow_stages/grove_ready .false changed)))
       (testing/nat "compilation is not publication" 1 (either/is_err publishing))
       (testing/nat "publication check requires matching native published revision" 1 (either/is_ok (flow_stages/grove_ready .true published)))
       (testing/nat "an unrelated receipt cannot verify this draft" 1 (either/is_err (flow_stages/grove_ready .false args.rep(['receipts] (stage_checks/controlled_receipt stage_checks/origin)))))
       (testing/nat "saving a revision uses the original capture and selected control" 1 (either/is_ok (flow_stages/prepare_save save)))
       (testing/nat "save rejects a selection from another version" 1 (either/is_err (flow_stages/prepare_save save.put(['selection] (myth/sing ['goo 'request] query.set_expected(11))))))
       (testing/nat "publication uses the exact verified draft" 1 (either/is_ok (flow_stages/prepare_publication publish)))
       (testing/nat "publication cannot silently adopt a different draft version" 1 (either/is_err (flow_stages/prepare_publication publish.put(['selection] (myth/sing ['goo 'request] query.set_expected(11))))))]
  + controlled_receipt
    ' Unit inputs for revision checking, not a claim of real compilation.
    ' The invocation case below separately exercises actual native effects.
    \ target=path
    ^ axal[myth]
    | stage_checks/controlled_receipt_for (goo_runtime/request "act" target target [] [0] 1 1 1 [] 0)
  + controlled_receipt_for
    \ query=goo_runtime/request
    ^ axal[myth]
    = worker=path [query.subject.at(0) 'user 'controlled 'worker]
      task (myth/sing ['goo 'request] query)
      guard (native_work/captured (safe 1 .x worker) .none (pin (flow_ops/empty).put([] task)))
      body (reply_json/show (reply_json/json/obj
        [(reply_json/jkv "outcome" (reply_json/json/str "accepted"))
         (reply_json/jkv "operationId" (reply_json/json/str (flow_action_ops/identity worker)))
         (reply_json/jkv "target" (reply_json/json/str (path_show query.subject)))]))
      record (myth/sing ['work 'outcome] (native_work/outcome "complete" body (pin guard)))
      record record.put(['work 'result] (safe 1 .x worker.snoc('result)))
    | (flow_ops/empty).put(['action] record)
  + extraction
    \ ignored=unit
    ^ row[testing/check]
    = page=path [($x 17) 'app 'nenex 'w 'selected]
      draft=path [($x 17) 'app 'nenex 'w 'extracted_flow]
      query (goo_runtime/request "act" page page [] [0] 1 1 1 [["/new_name" "extracted"]] 0)
      receipts (stage_checks/controlled_receipt_for query)
      record=myth (myth/sing ['src] (pails/t "Authored source")).put(['relationship] (safe 7 .x page))
      args (flow_ops/empty).put(['capture] (stage_checks/capture draft 2 record)).rep(['receipts] receipts)
      result (flow_stages/inspect_document args)
      extracted=myth (either/ok_val result).fil.fall(myth/new)
    | [(testing/text "extraction observation returns actual authored source" "Authored source" extracted.txt_at(['src]))
       (testing/nat "extraction observation preserves native document relationships" 1 (equal[pail] record.pail_at(['relationship]) extracted.pail_at(['relationship])))
       (testing/nat "receipt cannot substitute an unrelated document" 1 (either/is_err (flow_stages/inspect_document args.put(['capture] (stage_checks/capture page 2 record)))))
       (testing/nat "missing extracted document refuses inspection" 1 (either/is_err (flow_stages/inspect_document args.del(['capture]))))]
  + observation
    \ ignored=unit
    ^ row[testing/check]
    = state (staged/stage_fixture/initial ["orient_here"])
      page=path [state.self 'app 'nenex 'w 'orient_here_flow]
      cell=path page.weld(['cells 'observed])
      source=path [state.self 'user 'observed_source]
      input (myth/sing ['page] (pails/t (path_show page))).put(['name] (pails/t "observed")).put(['source] (pails/t (path_show source)))
      [next index reply] (helm/supervisor/admit (flow_examples/observe page input) state (sovereign_hive state))
      state (flow_tests/accepted reply next)
      missing (stage_checks/observed cell state)
      first (flow_tests/poke source (myth/sing ['value] (pails/t "One")) state)
      held (either/ok_val (flow_stages/selected (stage_checks/observed cell first)))
      second (flow_tests/poke source (myth/sing ['value] (pails/t "Two")) first)
      changed (either/ok_val (flow_stages/selected (stage_checks/observed cell second)))
      [deleted index reply] (helm/supervisor/step source .cull 0 0 second (sovereign_hive second))
      deleted (flow_tests/accepted reply deleted)
      restored (flow_tests/poke source (myth/sing ['value] (pails/t "Three")) deleted)
      final (either/ok_val (flow_stages/selected (stage_checks/observed cell restored)))
      loop_input input.put(['name] (pails/t "loop")).put(['source] (pails/t (path_show page.weld(['cells 'loop]))))
      history (row/all[care] (\ car=care (equal (first.page(car first.case(car source) source)) (restored.page(car first.case(car source) source)))) [.x .y .z])
    | [(testing/nat "observation can precede source availability" 1 (either/is_err (flow_stages/selected missing)))
       (testing/text "arrival updates the existing watching cell" "One" (unpin held.value).fil.fall(myth/new).txt_at(['value]))
       (testing/text "a changed source updates the observation" "Two" (unpin changed.value).fil.fall(myth/new).txt_at(['value]))
       (testing/nat "deleted source is unavailable rather than historical evidence" 1 (either/is_err (flow_stages/selected (stage_checks/observed cell deleted))))
       (testing/text "restoration reuses the same native cell" "Three" (unpin final.value).fil.fall(myth/new).txt_at(['value]))
       (testing/text "a retained earlier capture keeps its value" "One" (unpin held.value).fil.fall(myth/new).txt_at(['value]))
       (testing/nat "observation lifecycle preserves source x/y/z history" 1 history)
       (testing/nat "observation authoring refuses occupied cells" 1 (either/is_err (flow_examples/observe page input restored)))
       (testing/nat "observation authoring refuses a self cycle" 1 (either/is_err (flow_examples/observe page loop_input restored)))]
  + observed
    \ cell=path state=namespace
    ^ myth
    | (sovereign_care .x (row/cons[iota] 'x cell) state).fil.fall(myth/new)
  + work
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_fixture/goo_runtime_checks/setup [])
      work (native_work_ops/status "waiting" (native_work_ops/open query.subject "investigation" myth/new))
      captured (stage_checks/capture query.subject query.expected work)
      assessment (either/ok_val (flow_stages/assess_work (flow_ops/empty).put(['capture] captured)))
      args (flow_ops/empty).rep(['assessment] assessment).put(['selection] (myth/sing ['goo 'request] query))
      running (stage_checks/capture query.subject query.expected (native_work_ops/status "running" work))
      bad args.put(['selection] (myth/sing ['goo 'request] query.set_subject(stage_checks/origin)))
      running_args args.rep(['assessment] (either/ok_val (flow_stages/assess_work (flow_ops/empty).put(['capture] running))))
    | [(testing/text "assessment exposes native state without inference" "waiting" assessment.fil.fall(myth/new).txt_at(['status]))
       (testing/nat "assessment retains exact work identity and capture" 1 (equal[pail] captured.pail_at(['capture]) assessment.fil.fall(myth/new).pail_at(['capture])))
       (testing/nat "continuation can select the original declared action" 1 (either/is_ok (flow_stages/work_action args)))
       (testing/nat "continuation cannot target unrelated work" 1 (either/is_err (flow_stages/work_action bad)))
       (testing/nat "actively running work is not dispatched a second time" 1 (either/is_err (flow_stages/work_action running_args)))]
  + invocation
    \ ignored=unit
    ^ row[testing/check]
    = [sample query] (goo_fixture/goo_runtime_checks/setup [])
      state (staged/stage_fixture/initial ["invoke_and_verify"])
      state (flow_tests/poke query.view (flow_tests/get query.view sample) state)
      state (flow_tests/poke query.target (flow_tests/get query.target sample) state)
      prepared (either/ok_val (flow_action_ops/prepare query state)).fil.fall(myth/new)
      inputs staged/stage_fixture/inputs
      state (flow_tests/poke inputs.snoc('selection) prepared state)
      state (flow_tests/poke inputs.snoc('arguments) (myth/sing system_vocabulary/req (pails/t "After")) state)
      check (myth/sing ['target] (pails/p query.subject)).put(['after] (pails/n state.case(.x query.subject).fall(0)))
      state (flow_tests/poke inputs.weld(['checks 'result]) check.put(['expect 'sys 'req] (pails/t "After")) state)
      state (flow_tests/poke inputs.weld(['observations 'result]) (myth/sing ['unavailable] (pails/b .true)) state)
      bindings=row[[iota safe]] [['selection (safe 0 .x inputs.snoc('selection))] ['arguments (safe 0 .x inputs.snoc('arguments))]
        ['checks (safe 0 .z inputs.snoc('checks))] ['observations (safe 0 .z inputs.snoc('observations))]]
      started (staged/stage_fixture/start "invoke_and_verify" bindings state)
      controller staged/stage_fixture/controller
      attempt controller.weld(['work 'request_1])
      after started.case(.x query.subject)
      observed (staged/stage_fixture/capture query.subject started)
      done (flow_tests/poke inputs.weld(['observations 'result]) observed started)
      [deleted index reply] (helm/supervisor/step inputs.weld(['observations 'result]) .cull 0 0 done (sovereign_hive done))
      missing (flow_tests/accepted reply deleted)
      restored (flow_tests/poke inputs.weld(['observations 'result]) observed missing)
      result (staged/stage_fixture/result restored).get(['result]).fall(myth/new)
      history (row/all[care] (\ car=care (equal (started.page(car started.case(car attempt) attempt)) (restored.page(car started.case(car attempt) attempt)))) [.x .y .z])
    | [(testing/text "composed native action really changes its receiver" "After" (flow_tests/get query.subject started).txt_at(system_vocabulary/req))
       (testing/text "action completes while verification still lacks evidence" "complete" (flow_tests/get attempt started).txt_at(['work 'status]))
       (testing/nat "missing observations do not establish a verified result" 0 (staged/stage_fixture/result started).get(['result]).fall(myth/new).has(['verification 'receipts]))
       (testing/nat "new observation completes the same composition" 1 result.has(['verification 'receipts]))
       (testing/nat "observation changes do not repeat the receiver effect" 1 (equal[maybe[nat]] after restored.case(.x query.subject)))
       (testing/nat "observation changes do not allocate another action attempt" 0 (flow_tests/get controller.weld(['work 'request_2]) restored).has(['work 'request]))
       (testing/nat "loss of current evidence revokes verification" 0 (staged/stage_fixture/result missing).get(['result]).fall(myth/new).has(['verification 'receipts]))
       (testing/nat "retained action attempt preserves x/y/z history" 1 history)]
  + learning
    \ ignored=unit
    ^ row[testing/check]
    = [completed query] actions/flow_action_tests/started
      prior (request_fixture/request_tests/attempt 1)
      state (staged/stage_fixture/initial ["task_learning"])
      inputs staged/stage_fixture/inputs
      state (flow_tests/poke inputs.snoc('capture) (staged/stage_fixture/capture prior completed) state)
      state ((recipes/flow_examples_composition_tests/sources ['task 'instructions]).tap.fold(state
        (\ next=namespace [name card] (flow_tests/poke inputs.weld(['sources]).weld(name) card next))))
      bindings=row[[iota safe]] [['capture (safe 0 .x inputs.snoc('capture))] ['sources (safe 0 .z inputs.snoc('sources))] ['provider (safe 0 .x [state.self 'user 'stage_provider])]]
      started (staged/stage_fixture/start "task_learning" bindings state)
      controller staged/stage_fixture/controller
      first=path controller.weld(['work 'request_1])
      second=path controller.weld(['work 'request_2])
      third=path controller.weld(['work 'request_3])
      lessons=str "{""observation"":""Native action accepted"",""interpretation"":""Receipt is distinct from postcondition"",""rule"":""Verify observations separately"",""counterexample"":""A receipt alone cannot prove the target value"",""note"":""Grounded in the captured completed request""}"
      next (provider_fixture/request_tests/deliver first "complete" lessons started)
      instruction=str "{""trigger"":""After an accepted action"",""change"":""Check the selected postcondition"",""exception"":""Do not repeat the action while observing"",""note"":""Proposal only""}"
      next (provider_fixture/request_tests/deliver second "complete" instruction next)
      procedure=str "{""inputs"":""Selection and checks"",""steps"":""Invoke then observe"",""checks"":""Exact value and version"",""effects"":""Native declared action"",""note"":""Proposal only""}"
      done (provider_fixture/request_tests/deliver third "complete" procedure next)
      result (staged/stage_fixture/result done)
      task (flow_request_ops/saved_task (flow_tests/get second done))
      evidence=axal[myth]
        ?> held=cell_view task.pail_at(['work 'evidence]) flow_ops/empty
        | unpin held.tree
    | [(testing/nat "learning consumes a genuinely completed native action" 1 (native_work_ops/settled (flow_tests/get prior completed)))
       (testing/text "lesson remains an independently usable native value" "Native action accepted" result.get(['lessons]).fall(myth/new).txt_at(['observation]))
       (testing/text "instruction proposal is a separate result" "After an accepted action" result.get(['instruction]).fall(myth/new).txt_at(['trigger]))
       (testing/text "procedure proposal is a separate result" "Selection and checks" result.get(['procedure]).fall(myth/new).txt_at(['inputs]))
       (testing/text "downstream work captures the actual structured lesson" "Native action accepted" evidence.get(['context]).fall(myth/new).txt_at(['observation]))
       (testing/nat "learning does not adopt or rewrite instructions" 1 (equal[myth] (flow_tests/get inputs.weld(['sources 'instructions]) started) (flow_tests/get inputs.weld(['sources 'instructions]) done)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Guide procedures publish through native operations" stage_checks/guide)
   (testing/case "Observation authoring uses the existing Goo surface" stage_checks/controls)
   (testing/case "Proposals carry native values and optional projections" stage_checks/proposals)
   (testing/case "Receipt acceptance and observed postconditions are distinct" stage_checks/verification)
   (testing/case "Grove compilation and publication preserve exact revisions" stage_checks/grove)
   (testing/case "Extracted source remains native document data" stage_checks/extraction)
   (testing/case "Observation cells follow availability without losing captures" stage_checks/observation)
   (testing/case "Handoff and continuation share the original native work" stage_checks/work)
   (testing/case "Observation changes never replay an accepted action" stage_checks/invocation)
   (testing/case "Learning composes separately invokable proposals" stage_checks/learning)]
