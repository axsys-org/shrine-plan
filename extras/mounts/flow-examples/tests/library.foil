- flow_examples
- flow_author_controls
- flow_test_world [at=fixture]
- flow_request_fixture [at=provider_fixture]
- flow_examples_composition_tests [at=recipes]
- json [at=library_json]
- semidoc [at=library_doc]

' Real authored recipe bytes and native admission in disposable namespaces.
' The provider is controlled; the work, guards, captures and reactions are real.
+ library_tests
  + source
    \ name=iota format=str content=str
    ^ myth
    | (myth/sing ['flow 'source] (flow/source (path_show [name]) (str/repeat 64 "a") format content)).put(system_vocabulary/lede (pails/t (str/from_atom (quip_val name))))
  + capture
    \ card=myth
    ^ myth
    | native_work_ops/frozen [($x 17) 'user 'selection]
        (native_work/captured (safe 7 .x [($x 17) 'user 'selected]) .none (pin (flow_ops/empty).put([] card)))
  + args
    \ format=str content=str
    ^ axal[myth]
    | (flow_ops/empty).put(['sources 'data] (library_tests/source 'data format content))
  + adapters
    \ ignored=unit
    ^ row[testing/check]
    = text=str "{""null"":null,""false"":false,""zero"":0,""zero"":-0,""real"":12.50,""array"":[1,2]}"
      input (library_tests/args "json" text)
      decoded (flow_library/decode_sources input)
      reason=str
        ?> (./err why) decoded "ok"
        | str/from_atom (quip_val why)
    ?> (./ok values) decoded
      [(testing/text "native JSON adapter accepts a declared JSON source" "ok" reason)]
    = card values.get(['data]).fall(myth/new)
    ?> (./some value) (flow_library/json_value card.pail_at(['data]))
      [(testing/nat "decoded value uses the existing JSON type" 1 0)]
    ?> (./obj members) value
      [(testing/nat "decoded object remains a cohesive value" 1 0)]
    = record (native_work_ops/status "complete" (native_work_ops/open [($x 17) 'user 'task] "task" myth/new)).put(['result] (pails/t "Validated imported values."))
      args input.put(['capture] (library_tests/capture record))
      captured (flow_library/task_sources args)
      running input.put(['capture] (library_tests/capture (native_work_ops/status "running" record)))
      empty (flow_ops/empty).put(['capture] (library_tests/capture record))
      collection (native_work/captured (safe 7 .z [($x 17) 'user 'selected]) .none (pin (flow_ops/empty).put([] record)))
      collection_args input.put(['capture] (myth/sing ['capture] collection))
      grounded=axal[myth]
        ?> (./ok value) captured flow_ops/empty
        value
      native grounded.get(['native]).fall(myth/new)
      native_source=flow/source
        ?> held=flow/source native.pail_at(['flow 'source]) (flow/source "" "" "" "")
        held
      text_again (flow_library/decode_sources ((flow_ops/empty).put(['sources 'data] card.put(['flow 'source] (flow/source "/data" (str/repeat 64 "a") "text" text)))))
      stale=bool
        ?> (./ok output) text_again .true
        | output.get(['data]).fall(myth/new).has(['data])
    | [(testing/nat "one source yields one structured record, not a field tree" 1 values.wyt)
       (testing/nat "all object members, including duplicates, survive" 6 members.len)
       (testing/text "null, false, zero, negative zero and real lexemes round-trip" text (library_json/show value))
       (testing/nat "original exact source envelope survives decoding" 1 (equal[pail] card.pail_at(['flow 'source]) input.get(['sources 'data]).fall(myth/new).pail_at(['flow 'source])))
       (testing/nat "absent object members are not synthesized" 0 (members.any((\ member=library_json/jkv (eq member.k "owner")))))
       (testing/nat "malformed JSON refuses" 1 (either/is_err (flow_library/decode_sources (library_tests/args "json" "{"))))
       (testing/nat "trailing JSON refuses" 1 (either/is_err (flow_library/decode_sources (library_tests/args "json" "{} {}"))))
       (testing/nat "trailing whitespace is allowed" 1 (either/is_ok (flow_library/decode_sources (library_tests/args "json" "{}  "))))
       (testing/nat "unsupported formats require an explicit adapter" 1 (either/is_err (flow_library/decode_sources (library_tests/args "csv" "a,b"))))
       (testing/nat "format is explicit rather than guessed from content" 1 (either/is_ok (flow_library/decode_sources (library_tests/args "text" "{"))))
       (testing/nat "changing JSON to literal text removes obsolete derived data" 0 stale)
       (testing/nat "declared JSON cannot hide unsupported HTTP media" 1
         (either/is_err (flow_library/decode_sources input.put(['sources 'data] input.get(['sources 'data]).fall(myth/new).put(['media] (pails/t "text/html"))))))
       (testing/nat "settled work becomes native source evidence" 1 (either/is_ok captured))
       (testing/nat "source identity is the exact selected x record" 1 (flow_operations/source_identity native_source native))
       (testing/nat "source text includes the selected record's actual fields" 1 (native_source.content.find("Validated imported values.").is_some))
       (testing/nat "typed capture remains intact beside its bounded display" 1 native.has(['library 'capture]))
       (testing/nat "running work is not a settled learning outcome" 1 (either/is_err (flow_library/task_sources running)))
       (testing/nat "absent current sources refuse even with a retained work capture" 1 (either/is_err (flow_library/task_sources empty)))
       (testing/nat "collection epoch cannot masquerade as own-record identity" 1 (either/is_err (flow_library/captured_sources collection_args)))
       (testing/nat "reserved native evidence name cannot be overwritten" 1 (either/is_err (flow_library/captured_sources args.put(['sources 'native] (library_tests/source 'native "text" "Existing evidence")))))]
  + base
    ^ namespace
    | (flow_library/records ($x 17)).fold(fixture/flow_tests/initial
        (\ current=namespace [name card] (fixture/flow_tests/poke name card current)))
  + author
    \ name=iota file=str state=namespace
    ^ namespace
    = page=path [state.self 'app 'nenex 'w ($ts (str/cat_all [(str/from_atom (quip_val name)) "_flow"]))]
    ?> (./ok next) (recipes/flow_examples_composition_tests/author page (str/from_atom (quip_val name))
        (recipes/flow_examples_composition_tests/read file) state)
      | Seq[namespace] (error (pails/t "Shipped library recipe failed native author/publication")) state
    next
  + recipe
    \ state=namespace name=iota
    ^ flow/definition
    = target=path [state.self 'app 'nenex 'w ($ts (str/cat_all [(str/from_atom (quip_val name)) "_flow"])) 'flows name]
    ?> (./some definition) (recipes/flow_examples_composition_tests/definition target state)
      | Seq[flow/definition] (error (pails/t "Missing library recipe"))
          (flow/definition (safe 1 .x target) "" [] [] (pin flow_ops/empty) 'missing)
    definition
  + recipes
    \ ignored=unit
    ^ row[testing/check]
    = base library_tests/base
      learned (library_tests/author 'task_learning "task-learning.semidoc" base)
      atlas (library_tests/author 'technical_atlas "technical-atlas.semidoc" learned)
      state (library_tests/author 'format_ingestion "format-ingestion.semidoc" atlas)
      task (library_tests/recipe state 'task_learning)
      guide (library_tests/recipe state 'technical_atlas)
      importer (library_tests/recipe state 'format_ingestion)
      settled (native_work_ops/status "complete" (native_work_ops/open [state.self 'user 'task] "task" myth/new)).put(['result] (pails/t "Task outcome"))
      task_sources (recipes/flow_examples_composition_tests/sources ['task 'instructions])
      atlas_sources (recipes/flow_examples_composition_tests/sources ['shrine 'grove 'goo 'nenex 'harness 'reflection 'cell_examples 'hands 'overlays])
      task_inputs (axal/new[axal[myth]] .none).put(['sources] task_sources).put(['capture] (flow_ops/empty).put([] (library_tests/capture settled)))
      atlas_inputs (axal/new[axal[myth]] .none).put(['sources] atlas_sources).put(['capture] (flow_ops/empty).put([] (library_tests/capture (myth/sing ['source] (pails/t "Native definition source")))))
      import_inputs (axal/new[axal[myth]] .none).put(['sources] (library_tests/args "json" (recipes/flow_examples_composition_tests/read "data/services.json")).dip(['sources]))
      learning (flow_ops/evaluate task task_inputs)
      teaching (flow_ops/evaluate guide atlas_inputs)
      ingesting (flow_ops/evaluate importer import_inputs)
      task_pending=bool
        ?> (./ok result) learning .false
        | (unpin result.result).fil.fall(myth/new).has(['flow 'pending])
      atlas_pending=bool
        ?> (./ok result) teaching .false
        | (unpin result.result).fil.fall(myth/new).has(['flow 'pending])
      data_kept=bool
        ?> (./ok result) ingesting .false
        | result.trace.any((\ event=flow/event (and (eq_iota event.name 'decoded) (unpin event.value).get(['data]).fall(myth/new).has(['data]))))
      pages=axal[myth]
        ?> (./ok result) ingesting flow_ops/empty
        | unpin result.result
    | [(testing/nat "all shipped recipes publish through native admission" 1 (and (gt task.source.ver 0) (and (gt guide.source.ver 0) (gt importer.source.ver 0))))
       (testing/nat "learning uses the shared suspended revision mechanism" 1 task_pending)
       (testing/nat "atlas uses the same suspended revision mechanism" 1 atlas_pending)
       (testing/nat "ingestion runs deterministically without a provider" 1 (either/is_ok ingesting))
       (testing/nat "ingestion trace retains actual typed decoded data" 1 data_kept)
       (testing/nat "ingestion produces a root and source document projection" 1 (and pages.fil.is_some pages.has(['reference 'data])))
       (testing/nat "final flow result retains typed data for downstream composition" 1 pages.get(['reference 'data]).fall(myth/new).has(['data]))
       (testing/nat "final flow result retains the exact original source envelope" 1 pages.get(['reference 'data]).fall(myth/new).has(['flow 'source]))
       (testing/nat "publication captures existing native operation laws" 1 (task.steps.all((\ step=flow/step (gt step.origin.ver 0)))))
       (testing/nat "earlier publication x/y/z history survives new recipes" 1
         (row/all[care] (\ car=care (equal (learned.page(car learned.case(car task.source.path) task.source.path))
           (state.page(car learned.case(car task.source.path) task.source.path)))) [.x .y .z]))]
  + ingestion_lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = state (library_tests/author 'format_ingestion "format-ingestion.semidoc" library_tests/base)
      page=path [state.self 'app 'nenex 'w 'format_ingestion_flow]
      controller page.weld(['work 'import])
      destination=path [state.self 'app 'nenex 'w 'imported_data]
      mount=path [state.self 'io 'fs 'library_data]
      root mount.snoc('source)
      file root.snoc(($ta "data.json"))
      text (recipes/flow_examples_composition_tests/read "data/services.json")
      bytes (\ value=str (add (str/to_atom value) (bex (mul 8 value.len))))
      report (fs/cfg "fixture" root (fs/extensions (mop/empty)) [state.self 'kook 'fs]).del(limb_slot).put(bond/res (fs/report 0 root ["data.json"] []))
      state (fixture/flow_tests/poke mount report state)
      state (fixture/flow_tests/poke file (myth/sing bond/content (pails/n (bytes text))) state)
      fields=row[[str str]] [["source_name" "data"] ["source_file" (path_show file)] ["source_mount" (path_show mount)] ["source_format" "json"]]
      plan (flow_author_controls/bind_file page (fixture/flow_tests/fields fields) state)
    ?> (./ok writes) plan
      [(testing/text "Nenex binds JSON using the existing source operation" "ok" (fixture/flow_tests/reason plan))]
    ?> (./ok bound) (grove_install/changes writes state)
      [(testing/nat "JSON source binding admits through existing writes" 1 0)]
    = feed=path page.weld(['inputs 'data_file])
      input (myth/sing ['definition] (safe 0 .x page.weld(['flows 'format_ingestion]))).put(['destination] (pails/p destination))
      input input.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex])).put(['input 'sources] (safe 0 .z (row/cons[iota] 'x feed)))
      started (fixture/flow_tests/apply 'follow controller input bound)
      missing (fixture/flow_tests/poke mount (myth/sing bond/res (fs/report 0 root ["data.json"] ["data.json"])) started)
      restored (fixture/flow_tests/poke mount report missing)
      invalid (fixture/flow_tests/poke file (myth/sing bond/content (pails/n (bytes "{} trailing"))) restored)
      corrected (fixture/flow_tests/poke file (myth/sing bond/content (pails/n (bytes "{""restored"":true}"))) invalid)
      historical (row/all[care] (\ car=care (equal (started.page(car started.case(car destination) destination)) (corrected.page(car started.case(car destination) destination)))) [.x .y .z])
      inspection=row[[str str]] [["selection_name" "native_x"] ["scope" (path_show page.weld(['flows 'format_ingestion]))] ["scope_care" "x"]]
      x_plan (flow_author_controls/inspect_callables page (fixture/flow_tests/fields inspection) corrected)
      x_selected=namespace
        ?> (./ok writes) x_plan corrected
        ?> (./ok next) (grove_install/changes writes corrected) corrected
        next
      own_capture=native_work/captured
        ?> value=native_work/captured (fixture/flow_tests/get page.weld(['cells 'native_x]) x_selected).pail_at(['capture])
          | native_work/captured (safe 0 .z []) .none (pin flow_ops/empty)
        value
    | [(testing/nat "JSON format form uses existing filesystem watch ownership" 1 (equal[maybe[path]] (flow_sources_ops/mount_of (fixture/flow_tests/get feed bound)) (./some mount)))
       (testing/text "format selection survives source binding" "json" (fixture/flow_tests/get feed bound).txt_at(['flow 'source_format]))
       (testing/nat "deterministic import publishes without model work" 1 (library_tests/generation controller started))
       (testing/nat "missing file cannot present retained capture as current" 0 (sovereign_care .z (row/cons[iota] 'x feed) missing).wyt)
       (testing/nat "missing evidence cannot advance publication" (library_tests/generation controller started) (library_tests/generation controller missing))
       (testing/nat "restoration makes the source current" 1 (gt (sovereign_care .z (row/cons[iota] 'x feed) restored).wyt 0))
       (testing/nat "invalid replacement cannot publish" (library_tests/generation controller restored) (library_tests/generation controller invalid))
       (testing/nat "corrected bytes resume through the same hand" 1 (gt (library_tests/generation controller corrected) (library_tests/generation controller restored)))
       (testing/nat "existing native history survives replacement and restoration" 1 historical)
       (testing/nat "inspection form captures exact own-record care" 1 (equal[care] own_capture.source.care .x))
       (testing/nat "own-record inspection has exactly one retained record" 1 (unpin own_capture.value).wyt)]
  + current
    \ controller=path state=namespace
    ^ row[flow_work/job]
    ?> jobs=flow_work/jobs (fixture/flow_tests/get controller state).pail_at(['flow 'jobs]) []
    | jobs.entries
  + finish
    ' Settle only real currently dispatched workers, through their guard.
    \ controller=path state=namespace
    ^ namespace
    % state=namespace state remaining=nat 12
    ^ namespace
    = jobs ((library_tests/current controller state).keep((library_tests/dispatched state)))
    ? !(jobs.len)
      = refused (library_tests/current controller state).keep((\ job=flow_work/job (fixture/flow_tests/get job.request state).has(['flow 'refused])))
      ? !(refused.len) state
      = card (fixture/flow_tests/get refused.at(0).request state)
      | Seq[namespace] (error card.pail_at(['flow 'refused])) state
    ? !(remaining) (Seq[namespace] (error (pails/t "Library fixture did not settle")) state)
    = source (str/from_atom (joined 10 [";= Supported proposal" "  This proposal follows the captured evidence and requires deliberate adoption."]))
      response (library_json/show (library_json/json/obj
        [(library_json/jkv "source" (library_json/json/str source))
         (library_json/jkv "note" (library_json/json/str "Controlled provider; not a live model judgment."))]))
    | _ (provider_fixture/request_tests/deliver jobs.at(0).request "complete" response state) remaining.dec
  + dispatched
    \ state=namespace job=flow_work/job
    ^ bool
    = worker (fixture/flow_tests/get job.request.snoc('worker) state)
    | and worker.has(['work 'request]) !(worker.has(['work 'outcome]))
  + generation
    \ controller=path state=namespace
    ^ nat
    ?> progress=flow_maintenance/progress (fixture/flow_tests/get controller state).pail_at(['flow 'progress]) 0
    progress.generation
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = base (library_tests/author 'task_learning "task-learning.semidoc"
        (library_tests/author 'format_ingestion "format-ingestion.semidoc" library_tests/base))
      page=path [base.self 'app 'nenex 'w 'task_learning_flow]
      controller page.weld(['work 'lesson])
      destination=path [base.self 'app 'nenex 'w 'task_lesson]
      import_sources=path [base.self 'user 'prior_import]
      state (fixture/flow_tests/poke import_sources.snoc('data) (library_tests/source 'data "json" "{""result"":""Imported exact values""}") base)
      import_controller=path [base.self 'user 'import_work]
      import_request (myth/sing ['definition] (safe 0 .x [base.self 'app 'nenex 'w 'format_ingestion_flow 'flows 'format_ingestion]))
      import_request import_request.put(['destination] (pails/p [base.self 'app 'nenex 'w 'prior_import]))
      import_request import_request.put(['writer] (safe 0 .x [base.self 'gov 'flows 'nenex])).put(['input 'sources] (safe 0 .z import_sources))
      state (fixture/flow_tests/apply 'follow import_controller import_request state)
      selected=path import_controller.weld(['work ($u 1)])
      state (fixture/flow_tests/apply 'inspect_callables page (myth/sing ['name] (pails/p ['selected])).put(['source] (safe 0 .x selected)) state)
      sources=path [base.self 'user 'learning_sources]
      state ((recipes/flow_examples_composition_tests/sources ['task 'instructions]).tap.fold(state
        (\ current=namespace [name card] (fixture/flow_tests/poke sources.weld(name) card current))))
      form=path [state.self 'gov 'flows 'request_provider]
      state (fixture/flow_tests/poke form (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
      provider=path [state.self 'user 'learning_provider]
      state (fixture/flow_tests/poke provider (myth/sing ['work 'provider] (native_work/provider provider_fixture/request_tests/provider)) state)
      input (myth/sing ['definition] (safe 0 .x page.weld(['flows 'task_learning]))).put(['destination] (pails/p destination))
      input input.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex])).put(['provider] (safe 0 .x provider))
      input input.put(['input 'sources] (safe 0 .z sources)).put(['input 'capture] (safe 0 .x page.weld(['cells 'selected])))
      started (fixture/flow_tests/apply 'follow controller input state)
      jobs (library_tests/current controller started)
    ? !(jobs.len) [(testing/nat "learning attaches to real native revision jobs" 1 0)]
    = first jobs.at(0).request
      before (fixture/flow_tests/get first started)
      snapshot (fixture/flow_tests/get page.weld(['cells 'selected]) started)
      rendered (flow_library/task_sources (flow_ops/empty).put(['capture] snapshot).rep(['sources] (sovereign_peek sources started)))
      trace_text=str
        ?> (./ok held) rendered ""
        ?> source=flow/source held.get(['native]).fall(myth/new).pail_at(['flow 'source]) ""
        source.content
    ?> request=flow_work/request before.pail_at(['flow 'request])
      [(testing/nat "learning uses existing revision request type" 1 0)]
    = refused (provider_fixture/request_tests/deliver first "complete" "{""source"":"""",""note"":""Need clearer task evidence.""}" started)
      retry (fixture/flow_tests/apply 'retry_revision first (myth/sing ['expected] (pails/n refused.case(.x first).fall(0))) refused)
      done (library_tests/finish controller retry)
      changed (fixture/flow_tests/poke sources.snoc('task) (library_tests/source 'task "md" "A changed task goal.") done)
      updated (library_tests/finish controller changed)
      historical (row/all[care] (\ car=care (equal (refused.page(car refused.case(car first) first)) (updated.page(car refused.case(car first) first)))) [.x .y .z])
    | [(testing/nat "learning uses shared captured evidence cells" 1 (fixture/flow_tests/get first.snoc('evidence) started).has(bond/weft))
       (testing/nat "learning reads the actual completed ingestion flow trace" 1 (trace_text.find("Executed step: decoded").is_some))
       (testing/nat "learning uses shared overlay" 1 (fixture/flow_tests/get first.snoc('view) started).has(bond/weft))
       (testing/nat "insufficient evidence does not publish" 0 (library_tests/generation controller refused))
       (testing/nat "insufficient evidence leaves native refusal" 1 (equal[pail] (pails/q 'flow_revision_unresolved) (fixture/flow_tests/get first refused).pail_at(['flow 'refused])))
       (testing/nat "retry creates retained attempts without replacing the old one" 1 (equal[pail] before.pail_at(['capture]) (fixture/flow_tests/get first done).pail_at(['capture])))
       (testing/nat "shared revision hand publishes proposal documents" 1 (library_tests/generation controller done))
       (testing/text "existing hole resolves after accepted work" "resolved" (fixture/flow_tests/get request.hole done).txt_at(['work 'status]))
       (testing/nat "changed bound evidence wakes the same hand" 1 (gt (library_tests/generation controller updated) (library_tests/generation controller done)))
       (testing/nat "retained failed attempt preserves all x/y/z history" 1 historical)
       (testing/nat "learning never rewrites the supplied instruction record" 1 (equal[myth] (fixture/flow_tests/get sources.snoc('instructions) started) (fixture/flow_tests/get sources.snoc('instructions) updated)))]

  + references
    \ pred=row[nat] attrs=row[sattr]
    ^ row[row[nat]]
    | attrs.bind
      \ attr=sattr
      ? !(equal[row[nat]] attr.pred pred) []
      | attr.vals.bind
        \ value=sval
        ?> (./ref names) value []
        | [names]
  + local_references
    \ ignored=unit
    ^ row[testing/check]
    = self=iota ($x 171)
      original (joined 10 [";. /0x11/app/nenex/w/example"
        "  ;@ /rel/source ;/0x11/user/evidence"
        "  ;@ /rel/source ;/0x11/user/another"
        "  ;@ /rel/foreign ;/0xff/user/evidence"
        "  ;= Literal 0x11 remains prose"
        "    Do not rewrite the prose /0x11/user/evidence."])
      localized ((library_doc/parse original).map((flow_examples/local_node self)))
      source (library_doc/unparse localized)
      parsed (library_doc/parse source)
      root=path
        ?> (./doc id _ _) parsed.at(0) []
        ?> (./some path) (path_parse (str/from_atom (joined 47 (row/cons[nat] "" id)))) []
        path
      attributes ((flow_ops/flatten parsed).bind((\ node=snode (attrs_of node))))
      original_attributes ((flow_ops/flatten (library_doc/parse original)).bind((\ node=snode (attrs_of node))))
      original_refs (library_tests/references ["rel" "source"] original_attributes)
      refs (library_tests/references ["rel" "source"] attributes)
      foreign (library_tests/references ["rel" "foreign"] attributes)
    [(testing/nat "authored fixture has two native reference occurrences" 2 original_refs.len)
     (testing/nat "document identifier relocates with aura-aware native path" 1 (equal[path] root [self 'app 'nenex 'w 'example]))
     (testing/nat "repeated references remain separate after relocation" 2 refs.len)
     (testing/nat "local references use the actual nondefault publisher text" 1 (refs.all((\ ref=row[nat] (eq ref.at(0) "0xab")))))
     (testing/nat "foreign references keep their publisher" 1 (and (eq foreign.len 1) (eq foreign.at(0).at(0) "0xff")))
     (testing/nat "literal source text is not an address rewrite" 1 (cord/has "Do not rewrite the prose /0x11/user/evidence." source))]
  + surface_lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = state (library_tests/author 'surface_investigation "surface-investigation.semidoc" library_tests/base)
      page=path [state.self 'app 'nenex 'w 'surface_investigation_flow]
      controller=path page.weld(['work 'inspection])
      destination=path [state.self 'app 'nenex 'w 'surface_report]
      sources=path [state.self 'user 'surface_evidence]
      state (fixture/flow_tests/poke sources.snoc('task) (library_tests/source 'task "md" "# Task evidence\nObserve the declared native controls.") state)
      form=path [state.self 'gov 'flows 'request_provider]
      state (fixture/flow_tests/poke form (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
      provider=path [state.self 'user 'selected_surface_provider]
      capability (native_work/provider provider_fixture/request_tests/provider)
      state (fixture/flow_tests/poke provider (myth/sing ['work 'provider] capability) state)
      input (myth/sing ['definition] (safe 0 .x page.weld(['flows 'surface_investigation]))).put(['destination] (pails/p destination))
      input input.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex]))
      input input.put(['input 'sources] (safe 0 .z sources)).put(['input 'provider] (safe 0 .x provider))
      started=namespace (fixture/flow_tests/apply 'follow controller input state)
      attempt=path controller.weld(['work 'request_1])
      worker=path attempt.snoc('worker)
      original=myth (fixture/flow_tests/get attempt started)
      law=maybe[namespace_op]
        ?> delegated=namespace_op original.pail_at(['work 'authorize]) .none
        | ./some delegated
      granted=bool
        ?> (./some delegated) law .false
        | either/is_ok (delegated.plan worker myth/new started)
      paused (fixture/flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) started)
      detached (fixture/flow_tests/apply 'detach controller myth/new started)
      changed (fixture/flow_tests/poke sources.snoc('task) (library_tests/source 'task "md" "Changed current task evidence") started)
      stale (provider_fixture/request_tests/deliver attempt "complete" (library_json/show (library_json/json/obj [(library_json/jkv "report" (library_json/json/str "Obsolete report"))])) changed)
      invalid (provider_fixture/request_tests/deliver attempt "complete" (library_json/show (library_json/json/obj [(library_json/jkv "report" (library_json/json/str ""))])) started)
      retry (myth/sing ['expected] (pails/n invalid.case(.x attempt).fall(0)))
      retried (fixture/flow_tests/apply 'retry_revision attempt retry invalid)
      replacement=path controller.weld(['work 'request_2])
      completed (provider_fixture/request_tests/deliver replacement "complete" (library_json/show (library_json/json/obj [(library_json/jkv "report" (library_json/json/str "Observed the declared native actions and their required inputs."))])) retried)
      history (row/all[care] (\ car=care (equal (started.page(car started.case(car attempt) attempt)) (completed.page(car started.case(car attempt) attempt)))) [.x .y .z])
    [(testing/nat "shipped surface recipe captures all four operation laws" 4 (library_tests/recipe started 'surface_investigation).steps.len)
     (testing/nat "selected existing provider constructor is actually invoked" 1 (fixture/flow_tests/get worker started).has(['fixture 'guard]))
     (testing/nat "the selected provider is captured in the native task" 1 (equal[pail] capability (flow_request_ops/saved_task original).pail_at(['work 'provider])))
     (testing/nat "current interactive work exposes captured native authorization" 1 granted)
     (testing/nat "paused controller cannot authorize a tool call" 1 (either/is_err (flow_request_ops/authorize_worker worker myth/new paused)))
     (testing/nat "detached controller cannot authorize a tool call" 1 (either/is_err (flow_request_ops/authorize_worker worker myth/new detached)))
     (testing/nat "changed evidence revokes old task authority" 1 (either/is_err (flow_request_ops/authorize_worker worker myth/new changed)))
     (testing/nat "late old report cannot publish current evidence" 0 (library_tests/generation controller stale))
     (testing/nat "invalid report remains an unresolved attempt" 1 (fixture/flow_tests/get attempt invalid).has(['flow 'refused]))
     (testing/nat "report validator refuses before publication" 0 (library_tests/generation controller invalid))
     (testing/nat "retry retains predecessor and dispatches the same provider" 1
       (and (equal[maybe[path]] (fixture/flow_tests/get replacement retried).path_at(['work 'retry_of]) (./some attempt))
         (fixture/flow_tests/get replacement.snoc('worker) retried).has(['fixture 'guard])))
     (testing/nat "accepted report publishes through the shared writer" 1 (library_tests/generation controller completed))
     (testing/nat "published report comes from the validated result" 1 (cord/has "Observed the declared native actions" (str/to_atom (fixture/flow_tests/get destination completed).txt_at(['src]))))
     (testing/nat "failed attempt capture stays retained" 1 (equal[pail] original.pail_at(['capture]) (fixture/flow_tests/get attempt completed).pail_at(['capture])))
     (testing/nat "retained attempts preserve all x/y/z cases" 1 history)]
  + atlas_answer
    \ source=str state=namespace job=flow_work/job
    ^ namespace
    = response (myth/sing ['source] (pails/t source)).put(['note] (pails/t "Controlled native author; not a live model response."))
      response response.put(['expected] (pails/n state.case(.x job.request.snoc('draft)).fall(0)))
    | fixture/flow_tests/apply 'submit_revision job.request response state
  + atlas_publication
    ' Complete the actual recipe through the native manual authoring boundary,
    ' including its evidence pages. A pending revision alone is not publication.
    \ ignored=unit
    ^ row[testing/check]
    = state (library_tests/author 'technical_atlas "technical-atlas.semidoc" library_tests/base)
      page=path [state.self 'app 'nenex 'w 'technical_atlas_flow]
      controller page.weld(['work 'atlas])
      destination=path [state.self 'app 'nenex 'w 'atlas_concepts]
      sources=path [state.self 'user 'atlas_sources]
      state ((recipes/flow_examples_composition_tests/sources ['shrine 'grove 'goo 'nenex 'harness 'reflection 'cell_examples 'hands 'overlays]).tap.fold(state
        (\ current=namespace [name card] (fixture/flow_tests/poke sources.weld(name) card current))))
      inspection (myth/sing ['name] (pails/p ['decoder])).put(['source] (safe 0 .x [state.self 'gov 'flows 'operations 'library 'decode_sources]))
      state (fixture/flow_tests/apply 'inspect_callables page inspection state)
      input (myth/sing ['definition] (safe 0 .x page.weld(['flows 'technical_atlas]))).put(['destination] (pails/p destination))
      input input.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex]))
      input input.put(['input 'sources] (safe 0 .z sources)).put(['input 'capture] (safe 0 .x page.weld(['cells 'decoder])))
      started (fixture/flow_tests/apply 'follow controller input state)
      jobs (library_tests/current controller started)
      source (str/from_atom (joined 10 [";= Supported atlas concept" "  A controlled author response grounded in the selected evidence."]))
      finished (jobs.fold(started (library_tests/atlas_answer source)))
    | [(testing/nat "atlas creates four native revision requests" 4 jobs.len)
       (testing/nat "atlas publishes all concepts and evidence through the Nenex writer" 1 (library_tests/generation controller finished))
       (testing/nat "atlas cell source uses a document-safe evidence name" 1 (fixture/flow_tests/get destination.weld(['reference 'cell_examples]) finished).has(['src]))
       (testing/nat "atlas completion retains all original requests" 1
         (jobs.all((\ job=flow_work/job (eq (fixture/flow_tests/get job.request finished).txt_at(['work 'status]) "complete")))))
       (testing/nat "atlas completion preserves the exact selected definition cell" 1
         (equal[myth] (fixture/flow_tests/get page.weld(['cells 'decoder]) started) (fixture/flow_tests/get page.weld(['cells 'decoder]) finished)))
       (testing/nat "atlas publication preserves earlier authored x/y/z history" 1
         (row/all[care] (\ car=care (equal (started.page(car started.case(car page) page)) (finished.page(car started.case(car page) page)))) [.x .y .z]))]

+ tests
  ^ row[testing/case]
  | [(testing/case "Example relocation preserves parsed addresses and prose" library_tests/local_references)
     (testing/case "Authored interactive investigation uses the shared native lifecycle" library_tests/surface_lifecycle)
     (testing/case "Library adapters preserve native captures and cohesive values" library_tests/adapters)
     (testing/case "Shipped learning, atlas and ingestion Semidoc recipes" library_tests/recipes)
     (testing/case "Ingestion follows source availability and native publication" library_tests/ingestion_lifecycle)
     (testing/case "Learning uses shared work, holes, retry and evidence reactions" library_tests/lifecycle)
     (testing/case "Atlas completes through the shared guarded Nenex writer" library_tests/atlas_publication)]
