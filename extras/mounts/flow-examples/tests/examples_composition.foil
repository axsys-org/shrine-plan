- flow_test_world [at=fixture]

' The runner copies shipped recipe bytes into its disposable src/examples/.
' This checks the actual authored examples, not a reduced copy of their logic.
+ flow_examples_composition_tests
  + read
    \ name=str
    ^ str
    = ;bytes (ReadFile (str/cat_all ["examples/" name]))
    ? (le bytes 1) ""
    | str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes)))))
  + author
    \ target=path id=str source=str state=namespace
    ^ either[iota namespace]
    = input (myth/sing ['source] (pails/t source)).put(['expected] (pails/n state.case(.x target).fall(0)))
    < created (namespace_command/admit (namespace_command/plan target (flow_ops/key state.self 'author) input) state (sovereign_hive state))
    = [authored index] created
      input (myth/sing ['id] (pails/t id)).put(['expected] (pails/n authored.case(.x target).fall(0)))
    < published (namespace_command/admit (namespace_command/plan target (flow_ops/key state.self 'publish) input) authored index)
    = [next ignored] published
    | ./ok next
  + reason
    \ result=either[iota namespace]
    ^ str
    ?> (./err why) result "ok"
    | str/from_atom (quip_val why)
  + evaluation_reason
    \ result=either[iota flow/evaluation]
    ^ str
    ?> (./err why) result "ok"
    | str/from_atom (quip_val why)
  + admission_reason
    \ result=either[iota [namespace hive]]
    ^ str
    ?> (./err why) result "ok"
    | str/from_atom (quip_val why)
  + definition
    \ target=path state=namespace
    ^ maybe[flow/definition]
    ?> value=flow/definition (fixture/flow_tests/get target state).pail_at((flow_ops/key state.self 'definition)) .none
    | ./some value
  + sources
    \ names=row[iota]
    ^ axal[myth]
    | names.fold flow_ops/empty
      \ tree=axal[myth] name=iota
      = source (flow/source (str/cat_all [(str/from_atom (quip_val name)) ".md"]) (str/repeat 64 "a") "md"
          (str/from_atom (joined 10 ["# Fixture source" "Captured evidence." "" "## Usage" "Use the native records."])))
      | tree.put([name] (myth/sing ['flow 'source] source).put(system_vocabulary/lede (pails/t (str/from_atom (quip_val name)))))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = child_source (flow_examples_composition_tests/read "evidence-sources.semidoc")
      handbook_source (flow_examples_composition_tests/read "handbook.semidoc")
      outline_source (flow_examples_composition_tests/read "source-outline.semidoc")
    ? !(and (gt child_source.len 0) (and (gt handbook_source.len 0) (gt outline_source.len 0)))
      [(testing/nat "child recipe bytes are available" 1 (gt child_source.len 0))
       (testing/nat "handbook recipe bytes are available" 1 (gt handbook_source.len 0))
       (testing/nat "outline recipe bytes are available" 1 (gt outline_source.len 0))]
    = child=path [($x 17) 'app 'nenex 'w 'evidence_sources_flow]
      handbook=path [($x 17) 'app 'nenex 'w 'handbook_flow]
      outline=path [($x 17) 'app 'nenex 'w 'source_outline_flow]
      child_definition child.weld(['flows 'evidence_sources])
      handbook_definition handbook.weld(['flows 'handbook])
      outline_definition outline.weld(['flows 'source_outline])
      created (flow_examples_composition_tests/author child "evidence_sources" child_source fixture/flow_tests/initial)
    ?> (./ok state) created
      [(testing/text "native author/publication accepts shipped child" "ok" (flow_examples_composition_tests/reason created))]
    = created (flow_examples_composition_tests/author handbook "handbook" handbook_source state)
    ?> (./ok state) created
      [(testing/text "native author/publication accepts shipped handbook" "ok" (flow_examples_composition_tests/reason created))]
    = created (flow_examples_composition_tests/author outline "source_outline" outline_source state)
    ?> (./ok state) created
      [(testing/text "native author/publication accepts shipped outline" "ok" (flow_examples_composition_tests/reason created))]
    ?> (./some shared) (flow_examples_composition_tests/definition child_definition state)
      [(testing/nat "shipped evidence source recipe publishes" 1 0)]
    ?> (./some book) (flow_examples_composition_tests/definition handbook_definition state)
      [(testing/nat "shipped handbook recipe publishes" 1 0)]
    ?> (./some guide) (flow_examples_composition_tests/definition outline_definition state)
      [(testing/nat "shipped source outline recipe publishes" 1 0)]
    = names=row[iota] ['foil_readme 'slots 'grove 'goo 'goo_readme 'nenex 'cell_examples 'hands 'spun_views
        'maintenance_runtime 'reflection 'semidoc 'cooperate 'flow_harness 'revision_runtime 'native_work 'codex_work]
      evidence (flow_examples_composition_tests/sources names)
      inputs (axal/new[axal[myth]] .none).put(['sources] evidence)
      outline_inputs (axal/new[axal[myth]] .none).put(['sources] (flow_examples_composition_tests/sources ['manual]))
      evaluated (flow_ops/evaluate book inputs)
    ?> (./ok book_result) evaluated
      [(testing/text "actual handbook accepts its declared source names" "ok" (flow_examples_composition_tests/evaluation_reason evaluated))]
    ?> pending=flow/pending (unpin book_result.result).fil.fall(myth/new).pail_at(['flow 'pending])
      [(testing/nat "actual handbook suspends for concept revision" 1 0)]
    = evaluated (flow_ops/evaluate guide outline_inputs)
    ?> (./ok guide_result) evaluated
      [(testing/text "actual source outline completes after shared invocation" "ok" (flow_examples_composition_tests/evaluation_reason evaluated))]
    = sources=path [state.self 'user 'example_evidence]
      seeded (evidence.tap.fold(state (\ current=namespace [name card] (fixture/flow_tests/poke sources.weld(name) card current))))
      controller=path [state.self 'user 'example_maintenance 'handbook]
      destination=path [state.self 'app 'nenex 'w 'example_handbook]
      request (myth/sing ['definition] (safe 0 .x handbook_definition)).put(['destination] (pails/p destination))
      request request.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex])).put(['input 'sources] (safe 0 .z sources))
      admitted (namespace_command/admit (namespace_command/plan controller (flow_ops/key state.self 'follow) request) seeded (sovereign_hive seeded))
    ?> (./ok next) admitted
      [(testing/text "actual handbook attachment is admitted" "ok" (flow_examples_composition_tests/admission_reason admitted))]
    = [followed index] next
      first=path controller.weld(['work 'revision_1])
    ?> jobs=flow_work/jobs (fixture/flow_tests/get controller followed).pail_at(['flow 'jobs])
      [(testing/nat "actual handbook attaches to the shared revision lifecycle" 1 0)]
    ?> first_request=flow_work/request (fixture/flow_tests/get first followed).pail_at(['flow 'request])
      [(testing/nat "actual handbook creates a retained revision request" 1 0)]
    = view (sovereign_care .z (row/cons[iota] 'x first.snoc('view)) followed)
      historical (row/all[care] (\ car=care (equal[res[axal[saga]]] (namespace/page car seeded.case(car handbook) handbook seeded)
        (namespace/page car seeded.case(car handbook) handbook followed))) [.x .y .z])
    [(testing/nat "all three shipped example sources are loaded" 1 (and (gt child_source.len 0) (and (gt handbook_source.len 0) (gt outline_source.len 0))))
     (testing/nat "both callers capture the same child publication origin" 1 (equal[safe] book.steps.at(0).origin guide.steps.at(0).origin))
     (testing/nat "both callers capture the same executable child law" 1 (equal[pin[flow/operation]] book.steps.at(0).law guide.steps.at(0).law))
     (testing/nat "shared child selection points to its published definition" 1 (equal[path] book.steps.at(0).origin.path child_definition))
     (testing/nat "handbook has a pending task for every authored concept" (unpin book.pages).wyt (unpin pending.tasks).wyt)
     (testing/nat "handbook reached its ordinary revision step after child execution" 1 (equal[iota] pending.step 'concepts))
     (testing/nat "handbook and outline retain child invocation captures" 1
       (and (book_result.trace.any((\ event=flow/event (equal[iota] event.name (flow_ops/call_event [] 'checked)))))
         (guide_result.trace.any((\ event=flow/event (equal[iota] event.name (flow_ops/call_event [] 'checked)))))))
     (testing/nat "source outline produces ordinary document results" 1 (unpin guide_result.result).fil.fall(myth/new).has(['flow 'page]))
     (testing/nat "source outline decomposes the supplied source" 1 (unpin guide_result.result).has(['reference 'manual]))
     (testing/nat "attached handbook stages every concept through existing revision jobs" (unpin book.pages).wyt jobs.entries.len)
     (testing/nat "actual handbook draft uses the declared Nenex document form" 1 (fixture/flow_tests/get first.snoc('draft) followed).has(limb_slot))
     (testing/nat "actual handbook work exposes frozen evidence cells" 1 (fixture/flow_tests/get first.snoc('evidence) followed).has(['capture]))
     (testing/nat "actual handbook work exposes the shared working overlay" 1 (and (view.has(['document])) (gt view.dip(['evidence]).wyt 0)))
     (testing/nat "actual handbook retains its subject hole" 1 (fixture/flow_tests/get first_request.hole followed).has(['work 'hole]))
     (testing/nat "attaching shipped handbook leaves retained x/y/z authored history intact" 1 historical)]

+ tests
  ^ row[testing/case]
  [(testing/case "Shipped handbook and outline share a published child flow" flow_examples_composition_tests/checks)]
