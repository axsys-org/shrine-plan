- flow_library_tests [at=library]
- flow_examples_composition_tests [at=recipes]
- flow_test_world [at=fixture]
- json [at=response_json]

+ agent_qol_checks
  + answer
    \ source=str note=str
    ^ str
    | response_json/show (response_json/json/obj
        [(response_json/jkv "source" (response_json/json/str source))
         (response_json/jkv "note" (response_json/json/str note))])
  + brief
    ^ flow/page
    | flow/page "Inspect selected work" [] ['native 'task 'actions]
  + result
    \ status=str text=str
    ^ axal[myth]
    = capture (native_work/captured (safe 7 .x [($x 17) 'user 'selected]) .none (pin flow_ops/empty))
    | (flow_ops/empty).put(['response] (myth/sing ['work 'outcome] (native_work/outcome status text (pin capture))))
  + validate
    \ source=str note=str
    ^ either[iota axal[myth]]
    | flow_library/validate_agent_report agent_qol_checks/brief
        (agent_qol_checks/result "complete" (agent_qol_checks/answer source note))
  + reason
    \ result=either[iota axal[myth]]
    ^ str
    ?> (./err why) result "ok"
    | str/from_atom (quip_val why)
  + report
    ^ str
    | str/from_atom (joined 10 [";= Observed work" "  Observed the declared native actions and their required inputs."
        "" "  ;/0x11/user/selected"])
  + reference
    \ node=snode
    ^ bool
    ? node
     > (./ref _ _) .true
    .false
  + validator
    \ ignored=unit
    ^ row[testing/check]
    = checked (agent_qol_checks/validate agent_qol_checks/report "Observed the current subject and its declared actions.")
      page=flow/page
        ?> (./ok result) checked (flow/page "" [] [])
        ?> value=flow/page result.get([]).fall(myth/new).pail_at(['flow 'page]) (flow/page "" [] [])
        value
      incomplete (flow_library/validate_agent_report agent_qol_checks/brief
        (agent_qol_checks/result "failed" (agent_qol_checks/answer agent_qol_checks/report "A report cannot hide a failed provider.")))
      duplicate (flow_library/validate_agent_report agent_qol_checks/brief
        (agent_qol_checks/result "complete" "{""source"":"""",""source"":""invented"",""note"":""Which action?""}"))
      sources (recipes/flow_examples_composition_tests/sources ['task 'authoring 'actions])
      arbitrary (flow_ops/empty).rep(['sources] sources).put(['capture] (library/library_tests/capture myth/new))
      waiting (native_work_ops/status "waiting" (native_work_ops/open [($x 17) 'user 'original] "investigation" myth/new))
      selected arbitrary.put(['capture] (library/library_tests/capture waiting))
    | [(testing/text "agent report accepts ordinary Semidoc" "ok" (agent_qol_checks/reason checked))
       (testing/nat "report retains observed native references" 1 (page.body.any(agent_qol_checks/reference)))
       (testing/nat "report retains the authored evidence bindings" 1 (equal[row[iota]] page.uses (agent_qol_checks/brief).uses))
       (testing/text "missing input uses the existing unresolved response signal" "flow_revision_unresolved" (agent_qol_checks/reason (agent_qol_checks/validate "" "Which declared action and expected result?")))
       (testing/nat "a note explaining the evidence or uncertainty is required" 1 (either/is_err (agent_qol_checks/validate agent_qol_checks/report "")))
       (testing/nat "provider failure cannot publish a valid-looking report" 1 (either/is_err incomplete))
       (testing/nat "ambiguous repeated response fields refuse" 1 (either/is_err duplicate))
       (testing/nat "document headers cannot enter a report" 1 (either/is_err (agent_qol_checks/validate
         (str/from_atom (joined 10 [";. /other" "  ;= Other" "    Text"])) "Do not redirect the writer.")))
       (testing/nat "executable attributes cannot enter a report" 1 (either/is_err (agent_qol_checks/validate
         (str/from_atom (joined 10 [";@ /flow/definition injected" ";= Action" "  Text"])) "Do not install a flow.")))
       (testing/nat "an empty section is not a completed report" 1 (either/is_err (agent_qol_checks/validate ";= Empty" "No observed content.")))
       (testing/nat "oversized report refuses before parsing" 1 (either/is_err (agent_qol_checks/validate (str/repeat 16385 "a") "Too large.")))
       (testing/nat "oversized explanation refuses" 1 (either/is_err (agent_qol_checks/validate agent_qol_checks/report (str/repeat 4097 "a"))))
       (testing/nat "orientation and invocation accept an exact arbitrary subject" 1 (either/is_ok (flow_library/captured_sources arbitrary)))
       (testing/nat "resumption requires original native work" 1 (either/is_err (flow_library/work_sources arbitrary)))
       (testing/nat "unresolved native work can be resumed" 1 (either/is_ok (flow_library/work_sources selected)))
       (testing/nat "a missing subject is not replaced with invented evidence" 1 (either/is_err (flow_library/captured_sources arbitrary.del(['capture]))))]
  + lifecycle
    \ name=iota file=str
    ^ row[testing/check]
    = original (native_work_ops/status "waiting" (native_work_ops/open [($x 17) 'user 'original] "investigation" myth/new))
    | library/library_tests/interactive_responses name file name
        (./some (library/library_tests/capture original))
        (agent_qol_checks/answer "" "Which action is authorized and what result should I verify?")
        (agent_qol_checks/answer agent_qol_checks/report "Controlled provider response; actual actions have separate surface tests.")
  + assignments
    \ ignored=unit
    ^ row[testing/check]
    = state (library/library_tests/author 'orient_here "orient-here.semidoc" library/library_tests/base)
      author=path [state.self 'app 'nenex 'w 'orient_here_flow]
      assignment=path [state.self 'app 'nenex 'w 'orientation_assignment]
      source (str/from_atom (joined 10 [";. /orientation_assignment" "  ;= Assignment" "    Inspect the current evidence."]))
      state (fixture/flow_tests/apply 'author assignment (myth/sing ['source] (pails/t source)) state)
      fields (fixture/flow_tests/fields [["source_name" "task"] ["source_page" (path_show assignment)]])
      plan (flow_author_controls/bind_source author fields state)
    ?> (./ok writes) plan
      [(testing/text "Nenex task binds through the existing control" "ok" (fixture/flow_tests/reason plan))]
    ?> (./ok bound) (grove_install/changes writes state)
      [(testing/nat "Nenex task binding admits through native writes" 1 0)]
    = cell=path author.weld(['cells 'task_source])
      task (sovereign_care .z (row/cons[iota] 'x cell) bound)
      brief (flow/page "Inline assignment" [(snode/prose "Inspect the selected subject; do not invoke effects." [])] ['native])
      args (flow_ops/empty).put(['pages] (flow_operations/expose brief)).rep(['sources] (recipes/flow_examples_composition_tests/sources ['native]))
      inline (flow_library/agent_task args)
      selected (flow_library/agent_task args.put(['sources 'task] task.get(['task]).fall(myth/new)))
      request=myth
        ?> (./ok requests) selected myth/new
        | requests.get(['report]).fall(myth/new)
      evidence=axal[myth]
        ?> held=cell_view request.pail_at(['work 'evidence]) flow_ops/empty
        | unpin held.tree
      citation=bool
        ?> validator=flow/operation request.pail_at(['work 'validator]) .false
        ?> (./ok result) (validator.run (agent_qol_checks/result "complete" (agent_qol_checks/answer agent_qol_checks/report "Inspected bound evidence."))) .false
        ?> page=flow/page result.get([]).fall(myth/new).pail_at(['flow 'page]) .false
        | and (eq page.uses.len 2) (page.uses.any((\ name=iota (eq_iota name 'task))))
      update (str/from_atom (joined 10 [";. /orientation_assignment" "  ;= Assignment" "    Inspect the changed evidence."]))
      changed (fixture/flow_tests/apply 'author assignment
        (myth/sing ['source] (pails/t update)).put(['expected] (pails/n bound.case(.x assignment).fall(0))) bound)
      next (sovereign_care .z (row/cons[iota] 'x cell) changed)
    | [(testing/nat "authored Semidoc brief needs no separate task file" 1 (either/is_ok inline))
       (testing/nat "Nenex assignment uses the existing source cell" 1 (fixture/flow_tests/get cell bound).has(bond/weft))
       (testing/nat "bound Nenex assignment produces an ordinary agent request" 1 (either/is_ok selected))
       (testing/nat "the exact task source is captured in the request evidence" 1 (equal[maybe[myth]] task.get(['task]) evidence.get(['task])))
       (testing/nat "the validated report cites the optional task without duplicate native citations" 1 citation)
       (testing/nat "editing the Nenex task changes its existing evidence cell" 0 (equal[axal[myth]] task next))
       (testing/nat "task edits retain all earlier document x/y/z history" 1
         (row/all[care] (\ car=care (equal (bound.page(car bound.case(car assignment) assignment))
           (changed.page(car bound.case(car assignment) assignment)))) [.x .y .z]))]
  + orient
    \ ignored=unit
    ^ row[testing/check]
    | agent_qol_checks/lifecycle 'orient_here "orient-here.semidoc"
  + resume
    \ ignored=unit
    ^ row[testing/check]
    | agent_qol_checks/lifecycle 'resume_work "resume-work.semidoc"
  + invoke
    \ ignored=unit
    ^ row[testing/check]
    | agent_qol_checks/lifecycle 'invoke_and_verify "invoke-and-verify.semidoc"

+ tests
  ^ row[testing/case]
  [(testing/case "Agent report policy preserves references and unresolved input" agent_qol_checks/validator)
   (testing/case "Assignments live in Semidoc and existing Nenex source cells" agent_qol_checks/assignments)
   (testing/case "Orientation uses shared requests, holes, evidence resumption and retries" agent_qol_checks/orient)
   (testing/case "Continuation uses shared requests, holes, evidence resumption and retries" agent_qol_checks/resume)
   (testing/case "Invocation uses shared requests, holes, evidence resumption and retries" agent_qol_checks/invoke)]
