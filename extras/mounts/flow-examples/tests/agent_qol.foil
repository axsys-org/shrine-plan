- flow_stage_fixture [at=staged]
- flow_test_world [at=fixture]
- flow_request_fixture [at=provider_fixture]
- flow_examples_composition_tests [at=recipes]

+ agent_qol_checks
  + answer
    ^ str
    "{""summary"":""Observed the selected native work"",""questions"":""None observed"",""next"":""Inspect declared controls before selecting an effect"",""note"":""Controlled provider; native evidence remains captured""}"
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = state staged/stage_fixture/initial
      inputs=path staged/stage_fixture/inputs
      selected=path [state.self 'user 'selected]
      original (native_work_ops/status "waiting" (native_work_ops/open selected "investigation" myth/new))
      state (fixture/flow_tests/poke selected original state)
      state (fixture/flow_tests/poke inputs.snoc('capture) (staged/stage_fixture/capture selected state) state)
      sources=path inputs.snoc('sources)
      state ((recipes/flow_examples_composition_tests/sources ['task 'actions]).tap.fold(state
        (\ next=namespace [name card] (fixture/flow_tests/poke sources.weld(name) card next))))
      controller=path staged/stage_fixture/controller
      bindings=row[[iota safe]] [['capture (safe 0 .x inputs.snoc('capture))] ['sources (safe 0 .z sources)] ['provider (safe 0 .x [state.self 'user 'stage_provider])]]
      started (staged/stage_fixture/start "orient_here" bindings state)
      first=path controller.weld(['work 'request_1])
      second=path controller.weld(['work 'request_2])
      request (fixture/flow_tests/get first started)
      hole request.path_at(['work 'hole_path]).fall([])
      rejected (provider_fixture/request_tests/deliver first "complete" "{""summary"":"""",""questions"":""Which object?"",""next"":""Wait"",""note"":""Missing task detail""}" started)
      retry (fixture/flow_tests/apply 'retry_revision first (myth/sing ['expected] (pails/n rejected.case(.x first).fall(0))) rejected)
      done (provider_fixture/request_tests/deliver second "complete" agent_qol_checks/answer retry)
      result (staged/stage_fixture/result done).fil.fall(myth/new)
      changed (fixture/flow_tests/poke sources.snoc('task)
        ((recipes/flow_examples_composition_tests/sources ['task]).get(['task]).fall(myth/new).put(['changed] (pails/b .true))) started)
      stale (provider_fixture/request_tests/deliver first "complete" agent_qol_checks/answer changed)
      resumed (provider_fixture/request_tests/deliver second "complete" agent_qol_checks/answer changed)
      paused (fixture/flow_tests/apply 'set_enabled controller (myth/sing ['enabled] (pails/b .false)) started)
      detached (fixture/flow_tests/apply 'detach controller myth/new started)
      preserved (row/all[care] (\ car=care (equal (rejected.page(car rejected.case(car first) first)) (done.page(car rejected.case(car first) first)))) [.x .y .z])
    | [(testing/nat "composed orientation dispatches through the existing provider" 1 (fixture/flow_tests/get first.snoc('worker) started).has(['fixture 'guard]))
       (testing/nat "request exposes its existing cells and overlay" 1 (and (fixture/flow_tests/get first.snoc('evidence) started).has(bond/weft) (fixture/flow_tests/get first.snoc('view) started).has(bond/weft)))
       (testing/nat "missing structured input leaves the same native hole" 1 (fixture/flow_tests/get hole rejected).has(['work 'hole]))
       (testing/nat "invalid response is retained as a refused attempt" 1 (fixture/flow_tests/get first rejected).has(['flow 'refused]))
       (testing/text "retry yields a chainable native result" "Observed the selected native work" result.txt_at(['summary]))
       (testing/nat "result retains exact context and evidence" 1 result.has(['stage 'evidence]))
       (testing/nat "native result is not replaced with report pages" 0 result.has(['flow 'page]))
       (testing/text "same hole resolves on a valid retry" "resolved" (fixture/flow_tests/get hole done).txt_at(['work 'status]))
       (testing/nat "failed attempt x/y/z history survives" 1 preserved)
       (testing/nat "old evidence cannot publish a late answer" 0 (staged/stage_fixture/result stale).fil.fall(myth/new).has(['summary]))
       (testing/text "changed evidence resumes the same composed occurrence" "Observed the selected native work" (staged/stage_fixture/result resumed).fil.fall(myth/new).txt_at(['summary]))
       (testing/nat "paused work revokes interactive authority" 1 (either/is_err (flow_request_ops/authorize_worker first.snoc('worker) myth/new paused)))
       (testing/nat "detached work revokes interactive authority" 1 (either/is_err (flow_request_ops/authorize_worker first.snoc('worker) myth/new detached)))
       (testing/nat "orientation leaves the original work record intact" 1 (equal[myth] original (fixture/flow_tests/get selected done)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Composed orientation uses native cells, holes, retry and retained work" agent_qol_checks/lifecycle)]
