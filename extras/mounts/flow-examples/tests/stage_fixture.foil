- flow_examples
- flow_test_world [at=fixture]
- flow_examples_composition_tests [at=recipes]
- flow_request_fixture [at=provider_fixture]

+ stage_fixture
  + parts
    ^ row[[str str]]
    [["project_result" "project-result.semidoc"]
     ["inspect_subject" "inspect-subject.semidoc"]
     ["orient_here" "orient-here.semidoc"]
     ["surface_investigation" "surface-investigation.semidoc"]
     ["assess_work" "assess-work.semidoc"]
     ["plan_continuation" "plan-continuation.semidoc"]
     ["investigation_handoff" "investigation-handoff.semidoc"]
     ["prepare_action" "prepare-action.semidoc"]
     ["invoke_action" "invoke-action.semidoc"]
     ["verify_action" "verify-action.semidoc"]
     ["invoke_and_verify" "invoke-and-verify.semidoc"]
     ["resume_work" "resume-work.semidoc"]
     ["grove_source" "grove-source.semidoc"]
     ["inspect_grove_draft" "inspect-grove-draft.semidoc"]
     ["save_grove_draft" "save-grove-draft.semidoc"]
     ["grove_app_authoring" "grove-app-authoring.semidoc"]
     ["publish_grove_draft" "publish-grove-draft.semidoc"]
     ["extract_procedure" "extract-procedure.semidoc"]
     ["inspect_procedure" "inspect-procedure.semidoc"]
     ["procedure_extraction" "procedure-extraction.semidoc"]
     ["extract_lessons" "extract-lessons.semidoc"]
     ["propose_instruction" "propose-instruction.semidoc"]
     ["propose_procedure" "propose-procedure.semidoc"]
     ["task_learning" "task-learning.semidoc"]
     ["author_document" "author-document.semidoc"]
     ["create_document" "create-document.semidoc"]
     ["publish_flow" "publish-flow.semidoc"]]
  + base
    ^ namespace
    = state ((flow_library/records ($x 17)).fold(fixture/flow_tests/initial
        (\ current=namespace [name card] (fixture/flow_tests/poke name card current))))
      state (fixture/flow_tests/poke [state.self 'gov 'flows 'request_provider] (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
    | fixture/flow_tests/poke [state.self 'user 'stage_provider] (myth/sing ['work 'provider] (native_work/provider provider_fixture/request_tests/provider)) state
  + publish
    \ state=namespace pair=[str str]
    ^ namespace
    = [name file] pair
      page=path [state.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"]))]
    ?> (./ok next) (recipes/flow_examples_composition_tests/author page name (recipes/flow_examples_composition_tests/read file) state)
      | Seq[namespace] (error (pails/t (str/cat_all ["Stage publication failed: " name]))) state
    next
  + initial
    ^ namespace
    | (stage_fixture/parts).fold(stage_fixture/base stage_fixture/publish)
  + controller
    ^ path
    [($x 17) 'user 'stage_controller]
  + inputs
    ^ path
    [($x 17) 'user 'stage_inputs]
  + start
    \ name=str bindings=row[[iota safe]] state=namespace
    ^ namespace
    = input (myth/sing ['definition] (safe 0 .x [state.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"])) 'flows ($ts (str/to_atom name))]))
      input input.put(['destination] (pails/p [state.self 'app 'nenex 'w 'stage_output])).put(['writer] (safe 0 .x [state.self 'gov 'flows 'retain_result]))
      input (bindings.fold(input (\ out=myth [name value] out.put(['input name] value))))
    | fixture/flow_tests/apply 'follow stage_fixture/controller input state
  + capture
    \ target=path state=namespace
    ^ myth
    | native_work_ops/frozen target (native_work/captured (safe state.case(.x target).fall(0) .x target) .none (pin (sovereign_care .x target state)))
  + result
    \ state=namespace
    ^ axal[myth]
    = path (stage_fixture/controller).snoc('view)
      record (sovereign_care .x (row/cons[iota] 'x path) state).fil.fall(myth/new)
    ?> candidate=flow_maintenance/candidate record.pail_at(['flow 'candidate]) flow_ops/empty
    ?> (./ok proposal) candidate.result flow_ops/empty
    | unpin proposal.output.result
