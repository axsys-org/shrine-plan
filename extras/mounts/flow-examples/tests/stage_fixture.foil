- flow_examples
- flow_test_world [at=fixture]
- flow_examples_composition_tests [at=recipes]
- flow_request_fixture [at=provider_fixture]
- json [at=source_json]

+ stage_fixture
  + parts
    ^ row[[str str]]
    ?> (./ok parsed _) (source_json/parse (recipes/flow_examples_composition_tests/read "catalog.json"))
      | Seq[row[[str str]]] (error (pails/t "Invalid example catalogue JSON")) []
    ?> (./obj entries) parsed
      | Seq[row[[str str]]] (error (pails/t "Example catalogue must be an object")) []
    | entries.map((\ entry=source_json/jkv [entry.k (flow_examples/text "source" entry.v)]))
  + bytes
    \ text=str
    ^ myth
    | myth/sing bond/content (pails/n (add (str/to_atom text) (bex (mul 8 text.len))))
  + base
    ^ namespace
    = bag=path [($x 17) 'io 'fs (source_mount/mount_key "flow-examples")]
      files=row[[str str]] (row/cons[[str str]] ["catalog" "catalog.json"] stage_fixture/parts)
      writes=row[[path writ]]
        | files.map
          \ [name file]
          = leaf=str (? (eq file "catalog.json") "examples.json" file)
          | [bag.weld(['source ($ta (str/to_atom leaf))])
              (writ/make (stage_fixture/bytes (recipes/flow_examples_composition_tests/read file)))]
      names=row[str] files.map((\ [name file] (? (eq file "catalog.json") "examples.json" file)))
      writes=row[[path writ]] writes.weld(
        [[bag (writ/make (myth/sing bond/res (fs/report 1 bag.snoc('source) names [])))]
         [[($x 17) 'kook 'fs] (writ/make (myth/sing bond/form fs/form))]])
    ?> (./ok seeded) (grove_install/changes writes fixture/flow_tests/initial)
      | Seq[namespace] (error (pails/t "Example source admission failed")) fixture/flow_tests/initial
    ?> (./ok state) (flow_examples/install seeded)
      | Seq[namespace] (error (pails/t "Example catalogue registration failed")) seeded
    = state (fixture/flow_tests/poke [state.self 'gov 'flows 'request_provider] (myth/sing system_vocabulary/form
        (def_form.set_init(native_work_ops/wake).set_hear(provider_fixture/request_tests/hear).set_talk(provider_fixture/request_tests/talk))) state)
    | fixture/flow_tests/poke [state.self 'user 'stage_provider] (myth/sing ['work 'provider] (native_work/provider provider_fixture/request_tests/provider)) state
  + publish
    ' The production library planner selects and orders the dependency closure.
    \ state=namespace name=str id=str
    ^ namespace
    = target (flow_library_publication/catalogue state.self)
      input (myth/sing ['name] (pails/t name)).put(['id] (pails/t id)).put(['inspection] (pails/t name))
    ?> (./ok writes) (flow_library_publication/inspect target input state)
      | Seq[namespace] (error (pails/t (str/cat_all ["Recipe inspection failed: " name]))) state
    ?> (./ok inspected) (grove_install/changes writes state)
      | Seq[namespace] (error (pails/t "Recipe inspection admission failed")) state
    ?> (./ok writes) (flow_library_publication/publish target (myth/sing ['inspection] (pails/t name)) inspected)
      | Seq[namespace] (error (pails/t (str/cat_all ["Recipe publication failed: " name]))) inspected
    ? (grove_install/changes writes inspected)
     > (./ok published) published
     > (./err why) (Seq[namespace] (error (pails/q why)) inspected)
  + initial
    \ names=row[str]
    ^ namespace
    | names.fold(stage_fixture/base (\ state name (stage_fixture/publish state name name)))
  + controller
    ^ path
    [($x 17) 'user 'stage_controller]
  + inputs
    ^ path
    [($x 17) 'user 'stage_inputs]
  + start
    \ name=str bindings=row[[iota safe]] state=namespace
    ^ namespace
    = input (myth/sing ['definition] (safe 0 .x [state.self 'app 'nenex 'w ($ts (str/cat_all [name "_flow"])) 'flows ($ts (str/to_atom name))]))
      input input.put(['destination] (pails/p [state.self 'app 'nenex 'w 'stage_output])).put(['writer] (safe 0 .x [state.self 'gov 'flows 'retain_result]))
      input (bindings.fold(input (\ out=myth [name value] out.put(['input name] value))))
    | fixture/flow_tests/apply 'follow stage_fixture/controller input state
  + capture
    \ target=path state=namespace
    ^ myth
    | native_work_ops/frozen target (native_work/captured (safe state.case(.x target).fall(0) .x target) .none (pin (sovereign_care .x target state)))
  + result
    \ state=namespace
    ^ axal[myth]
    = path (stage_fixture/controller).snoc('view)
      record (sovereign_care .x (row/cons[iota] 'x path) state).fil.fall(myth/new)
    ?> candidate=flow_maintenance/candidate record.pail_at(['flow 'candidate]) flow_ops/empty
    ?> (./ok proposal) candidate.result flow_ops/empty
    | unpin proposal.output.result
