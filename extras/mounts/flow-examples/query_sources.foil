- flow_web_ops
- json [at=query_json]
- value_read

' Pure selection from an operator's endpoint catalogue. Dataset names, queries
' and bounds belong to bound records, not executable business-specific policy.
+ flow_query_sources
  + field
    \ key=str value=json
    ^ maybe[json]
    ?> (./obj fields) value .none
    = matches fields.keep((\ field=jkv (eq field.k key)))
    ? !(eq matches.len 1) .none
    | ./some matches.at(0).v
  + url
    \ name=str catalogue=json
    ^ either[iota str]
    ?> (./some entry) (flow_query_sources/field name catalogue) (./err 'query_missing_endpoint)
    ?> (./some value) (flow_query_sources/field "url" entry) (./err 'query_missing_endpoint)
    ?> (./str url) value (./err 'query_missing_endpoint)
    ? !(flow_web_ops/valid_url url) (./err 'query_invalid_endpoint)
    ? ((str/find "?" url).is_some || (str/find "#" url).is_some) (./err 'query_invalid_endpoint)
    | ./ok url
  + arguments
    \ card=myth
    ^ either[iota row[str]]
    % todo=row[mop/kv[path pail]] card.tap out=row[str] []
    ^ either[iota row[str]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
    ? (row/has[path] entry.key [['query] ['revision]]) (_ rest out)
    ? !(and (eq entry.key.len 2) (pith_prefix ['argument] entry.key)) (./err 'query_invalid_selection)
    ?> text=pails/t entry.val (./err 'query_argument_text_required)
    < key (flow_ops/name (sval/word (quip_val entry.key.at(1))))
    ? !(equal[iota] key entry.key.at(1)) (./err 'query_invalid_selection)
    | _ rest out.snoc((str/cat_all [(value_read/percent (str/from_atom (quip_val key))) "=" (value_read/percent text.t)]))
  + select
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = record args.dip(['catalogue]).fil.fall(myth/new)
      bytes record.nat_at(bond/content 0)
      selections args.dip(['selection])
    ? (le bytes 1) (./err 'query_missing_catalogue)
    ? ((eq selections.wyt 0) || (gt selections.wyt 16)) (./err 'query_selection_limit)
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ? (gt text.len 32768) (./err 'query_catalogue_limit)
    ?> (./ok catalogue _) (query_json/parse text) (./err 'query_invalid_catalogue)
    % todo=row[[path myth]] selections.tap out=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name card] entry
    ? !(eq name.len 1) (./err 'query_invalid_selection)
    < port (flow_ops/name (sval/word (quip_val name.at(0))))
    ? !(equal[iota] port name.at(0)) (./err 'query_invalid_selection)
    < url (flow_query_sources/url card.txt_at(['query]) catalogue)
    < params (flow_query_sources/arguments card)
    = url (str/cat_all [url (? params.len (str/cat_all ["?" (str/join "&" params)]) "")])
    ? !(flow_web_ops/valid_url url) (./err 'query_invalid_endpoint)
    = selected (myth/sing ['url] (pails/t url)).put(['revision] (pails/n record.nat_at(['revision] 0)))
      selected selected.put(['selection_revision] (pails/n card.nat_at(['revision] 0)))
    | _ rest out.put([port] selected)
  + records
    \ self=iota
    ^ row[[path myth]]
    | [[[self 'gov 'flows 'operations 'library 'select_queries]
        (myth/sing (flow_ops/key self 'operation) (flow/operation ['catalogue 'selection] flow_query_sources/select))]]
