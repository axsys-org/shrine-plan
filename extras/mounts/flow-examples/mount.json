{
  "version": 1,
  "name": "flow-examples",
  "dependencies": [
    "flow-authoring",
    "flow-web",
    "conversation"
  ],
  "modules": {
    "flow_examples": "examples.foil",
    "flow_cartography": "cartography.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "flow_examples"
      ],
      "files": [
        "catalogue.grove"
      ],
      "prelude": "flow_examples"
    }
  ],
  "roots": [
    [
      "lib",
      "flow_examples"
    ],
    [
      "lib",
      "flow_cartography"
    ],
    [
      "gov",
      "flow_examples"
    ]
  ],
  "test_files": {
    "examples/evidence-sources.semidoc": "examples/evidence-sources.semidoc",
    "examples/handbook.semidoc": "examples/handbook.semidoc",
    "examples/source-outline.semidoc": "examples/source-outline.semidoc",
    "examples/web-evidence.semidoc": "examples/web-evidence.semidoc",
    "examples/web-source-guide.semidoc": "examples/web-source-guide.semidoc",
    "examples/cited-assertions.semidoc": "examples/cited-assertions.semidoc",
    "examples/cartography.semidoc": "examples/cartography.semidoc",
    "examples/task-learning.semidoc": "examples/task-learning.semidoc",
    "examples/technical-atlas.semidoc": "examples/technical-atlas.semidoc",
    "examples/format-ingestion.semidoc": "examples/format-ingestion.semidoc",
    "examples/data/services.json": "examples/data/services.json",
    "examples/surface-investigation.semidoc": "examples/surface-investigation.semidoc",
    "grove/flow-examples/catalogue.grove": "catalogue.grove",
    "foil/cartography_publication_fixture.foil": "tests/cartography_publication.foil",
    "examples/conversation-response.semidoc": "examples/conversation-response.semidoc"
  },
  "activate": {
    "module": "flow_examples",
    "entry": [
      "flow_examples",
      "activate"
    ]
  },
  "host": "host.py",
  "tests": {
    "flow_examples_composition_tests": "tests/examples_composition.foil",
    "flow_cartography_tests": "tests/cartography.foil",
    "flow_cartography_lifecycle_tests": "tests/cartography_lifecycle.foil",
    "flow_library_tests": "tests/library.foil"
  }
