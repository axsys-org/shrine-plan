- flow_author_controls
- semidoc [at=library_doc]

' Library review is an ordinary frozen cell. Publication uses native deferred
' commands in one admission; no queue, dependency registry or new work state.
+ flow_library_publication
  + catalogue
    \ self=iota
    ^ path
    [self 'app 'flow_examples 'catalogue]
  + source
    \ origin=safe state=namespace
    ^ str
    = bytes=nat
        ? !(origin.ver)
          = home origin.path.take((sub origin.path.len 2))
            name (str/from_atom (quip_val origin.path.at(origin.path.len.dec)))
            present (source_mount/snapshot home state).keep((\ [file content] (eq file name)))
          ? !(eq present.len 1) 0
          = [file content] present.at(0)
          | content
        ?> (./known tree) (sovereign_view origin.care origin.ver origin.path state) 0
        | tree.fil.fall(myth/new).nat_at(bond/content 0)
    ? (le bytes 1) ""
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ? (equal[iota] state.self ($x 17)) text
    | str/from_atom (library_doc/unparse ((library_doc/parse (str/to_atom text)).map((flow_library_publication/local_node state.self))))
  + capture
    \ origin=safe state=namespace
    ^ native_work/captured
    = value
        ?> (./known tree) (sovereign_view origin.care origin.ver origin.path state) flow_ops/empty
        tree
    | native_work/captured origin (state.case(origin.care origin.path)) (pin value)
  + recipe
    \ page=path state=namespace
    ^ maybe[[path myth]]
    = root=path [state.self 'gov 'flows 'examples]
      found (sovereign_peek root state).tap.keep((\ [relative card] (equal[maybe[path]] card.path_at(['example 'publications]) (./some page.snoc('flows)))))
    ? !(eq found.len 1) .none
    = [relative card] found.at(0)
    | ./some [root.weld(relative) card]
  + references
    \ id=iota text=str state=namespace
    ^ either[iota axal[myth]]
    = regions (flow_ops/flatten (library_doc/parse (str/to_atom text))).keep((flow_ops/is_region id))
    ? !(eq regions.len 1) (./err 'flow_definition_not_unique)
    = nodes (flow_ops/flatten (flow_ops/children regions.at(0)))
    % todo=row[snode] nodes out=axal[myth] flow_ops/empty
    ^ either[iota axal[myth]]
    ?> (./some pair) todo.pull (./ok out)
    = [node rest] pair
      modes=row[nat] ["step" "invoke"]
      modes modes.keep((\ mode (gt (flow_ops/attributes mode node).len 0)))
    ? !(modes.len) (_ rest out)
    ? !(eq modes.len 1) (./err 'flow_conflicting_attributes)
    = mode modes.at(0)
    < values (flow_ops/one mode node)
    ? !(eq values.len 2) (./err 'flow_invalid_step)
    < name (flow_ops/name values.at(0))
    ?> (./ref spelling) values.at(1) (./err 'flow_operation_reference_required)
    < origin (flow_ops/origin spelling)
    ? (out.has([name])) (./err 'flow_duplicate_name)
    = card (myth/sing ['reference] origin).put(['mode] (pails/t (str/from_atom mode)))
      card card.put(['capture] (flow_library_publication/capture origin state))
    | _ rest out.put([name] card)
  + visit
    \ target=path trail=row[path] plan=row[myth] state=namespace
    ^ either[iota row[myth]]
    ? (trail.has(target)) (./err 'flow_publication_cycle)
    ? (plan.any((\ card=myth (equal[maybe[path]] card.path_at(['publication]) (./some target))))) (./ok plan)
    ? !(and (gt target.len 2) (eq_iota target.at((sub target.len 2)) 'flows)) (./err 'flow_publication_address)
    = page target.take((sub target.len 2))
      id target.at(target.len.dec)
      current (cooperate_ops/record page state)
      available (flow_library_publication/recipe page state)
      seed=myth
        ?> (./some found) available myth/new
        = [operation card] found
        ?> origin=safe card.pail_at(['example 'source]) myth/new
        = seed (myth/sing ['recipe] (pails/p operation)).put(['recipe_capture] (flow_library_publication/capture (safe 0 .x operation) state))
          seed seed.put(['shipped_watch] (flow_library_publication/capture (safe 0 .x origin.path.take((sub origin.path.len 2))) state))
        | seed.put(['shipped_capture] (flow_library_publication/capture origin state)).put(['shipped] (pails/t (flow_library_publication/source origin state)))
      text (? current.is_some current.fall(myth/new).txt_at(['src]) seed.txt_at(['shipped]))
    = reading=either[iota axal[myth]] (? text.len (flow_library_publication/references id text state) (./ok flow_ops/empty))
    < dependencies reading
    % todo=row[[path myth]] dependencies.tap plan=row[myth] plan
    ^ either[iota row[myth]]
    ?> (./some pair) todo.pull (./ok plan.snoc((flow_library_publication/item page id target text current seed dependencies state)))
    = [entry rest] pair
      [name card] entry
    ?> origin=safe card.pail_at(['reference]) (./err 'flow_operation_reference_required)
    ? ((eq card.txt_at(['mode]) "step") || origin.ver) (_ rest plan)
    < next (flow_library_publication/visit origin.path trail.snoc(target) plan state)
    | _ rest next
  + item
    \ page=path id=iota target=path text=str current=maybe[myth] seed=myth dependencies=axal[myth] state=namespace
    ^ myth
    = compiled (flow_ops/compile id (safe state.case(.x page).fall(0) .x page) text state)
      existing (cooperate_ops/record target state).fall(myth/new)
      status=str
        ? !(text.len)
          ?> existing_definition=flow/definition existing.pail_at((flow_ops/key state.self 'definition)) "Missing source; supply this document before publication"
          "Existing publication; keep it without republishing unavailable source"
        ? !(either/is_ok compiled) (str/cat_all ["Compiler: " (str/from_atom (quip_val (either/err_val compiled)))])
        ?> old=flow/definition existing.pail_at((flow_ops/key state.self 'definition)) "Not published"
        ? (equal[flow/definition] old (either/ok_val compiled)) "Current publication"
        "Authored source or selected dependencies differ from publication"
      comparison=str
        ? !(current.is_some) "Create from the shipped recipe"
        ? !(seed.txt_at(['shipped]).len) "Authored document; no available shipped recipe"
        ? (eq text seed.txt_at(['shipped])) "Authored source matches shipped recipe"
        "Authored and shipped sources differ; preserve authored source and review changes"
      card seed.put(['page] (pails/p page)).put(['publication] (pails/p target)).put(['id] (pails/t (str/from_atom (quip_val id))))
      card card.put(['src] (pails/t text)).put(['status] (pails/t status)).put(['comparison] (pails/t comparison))
      card card.put(['source_capture] (flow_library_publication/capture (safe 0 .x page) state))
      card card.put(['publication_capture] (flow_library_publication/capture (safe 0 .x target) state))
      card card.put(['dependencies] (cell_view (pin dependencies)))
    | card
  + description
    \ card=myth
    ^ str
    = newline (str/from_atom 10)
      heading (str/cat_all [(path_show card.path_at(['publication]).fall([])) newline card.txt_at(['status]) newline card.txt_at(['comparison])])
      retained=str
        ?> saved=native_work/captured card.pail_at(['publication_capture]) ""
        ?> definition=flow/definition (unpin saved.value).fil.fall(myth/new).pail_at((flow_ops/key saved.source.path.at(0) 'definition)) ""
        | str/cat_all (definition.steps.map((\ step=flow/step (str/cat_all [newline "  Captured " (str/from_atom (quip_val step.name)) ": " (path_show (safe/spell step.origin))]))))
      available=str
        ?> dependencies=cell_view card.pail_at(['dependencies]) ""
        | str/cat_all ((unpin dependencies.tree).tap.map(flow_library_publication/reference_description))
    | str/cat_all [heading retained available newline]
  + reference_description
    \ entry=[path myth]
    ^ str
    = [name card] entry
    ?> held=native_work/captured card.pail_at(['capture]) ""
    = origin held.source.set_ver((? held.source.ver held.source.ver held.observed.fall(0)))
      text=str (? (unpin held.value).wyt (path_show (safe/spell origin)) "Unavailable; create or publish this dependency")
    | str/cat_all [(str/from_atom 10) "  Selected now " (path_show name) ": " text]
  + inspect
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(equal[path] target (flow_library_publication/catalogue state.self)) (./err 'flow_example_catalog)
    ? !(flow_runtime_ops/valid_arguments [['name] ['id] ['inspection]] input) (./err 'flow_invalid_arguments)
    < name (flow_ops/name (sval/word (str/to_atom input.txt_at(['name]))))
    < id (flow_ops/name (sval/word (str/to_atom (? input.txt_at(['id]).len input.txt_at(['id]) input.txt_at(['name])))))
    < inspection (flow_ops/name (sval/word (str/to_atom input.txt_at(['inspection]))))
    = cell=path target.weld(['cells inspection])
      page=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
    ? ((state.case(.x cell).is_some) || (sovereign_peek cell state).wyt) (./err 'flow_selection_collision)
    < plan (flow_library_publication/visit page.weld(['flows id]) [] [] state)
    = tree plan.fold(flow_ops/empty (\ out=axal[myth] card=myth out.put([($u out.wyt)] card)))
      summary (str/join (str/from_atom 10) plan.map(flow_library_publication/description))
      record (native_work_ops/value state.self (pin tree)).put(['library 'plan] (cell_view (pin tree)))
      record record.put(['library 'publisher] (flow_library_publication/capture (safe 0 .x (flow_ops/key state.self 'publish)) state))
      record record.put(['library 'admission] (flow_library_publication/capture (safe 0 .x [state.self 'gov 'flow_examples 'publish_reviewed]) state))
      root plan.at(plan.len.dec)
      presentation (myth/sing ['library 'review] (pails/t (str/cat_all ["Inspection " input.txt_at(['inspection]) ": dependencies first. Publishing preserves existing authored source; it does not adopt newer templates or replace captured occurrences." (str/from_atom 10) summary])))
      presentation presentation.put(['library 'authored] (pails/t root.txt_at(['src]))).put(['library 'shipped] (pails/t root.txt_at(['shipped])))
    | ./ok [[cell (writ/make record)] [target (writ/poke presentation)]]
  + current
    \ card=myth state=namespace
    ^ bool
    = fields=row[path] [['source_capture] ['publication_capture] ['recipe_capture] ['shipped_capture] ['shipped_watch]]
      exact (fields.all((flow_library_publication/current_slot card state)))
    ?> dependencies=cell_view card.pail_at(['dependencies]) .false
    | and exact ((unpin dependencies.tree).tap.all((flow_library_publication/current_reference state)))
  + current_slot
    \ card=myth state=namespace slot=path
    ^ bool
    ? !(card.has(slot)) .true
    ?> held=native_work/captured card.pail_at(slot) .false
    | flow_library_publication/capture_current held state
  + capture_current
    \ held=native_work/captured state=namespace
    ^ bool
    ' An unallocated address is a guarded absence, not current source evidence.
    ? (and !(held.source.ver) (and held.observed.is_none !((unpin held.value).wyt)))
      | and (state.case(held.source.care held.source.path).is_none) !((sovereign_care held.source.care held.source.path state).wyt)
    | native_work_ops/current held state
  + current_reference
    \ state=namespace entry=[path myth]
    ^ bool
    = [name card] entry
    ?> held=native_work/captured card.pail_at(['capture]) .false
    | flow_library_publication/capture_current held state
  + publish
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(equal[path] target (flow_library_publication/catalogue state.self)) (./err 'flow_example_catalog)
    ? !(flow_runtime_ops/valid_arguments [['inspection]] input) (./err 'flow_invalid_arguments)
    < name (flow_ops/name (sval/word (str/to_atom input.txt_at(['inspection]))))
    = cell=path target.weld(['cells name])
      record (cooperate_ops/record cell state).fall(myth/new)
    ?> selected=cell_view record.pail_at(['library 'plan]) (./err 'flow_missing_selection)
    ?> publisher=native_work/captured record.pail_at(['library 'publisher]) (./err 'flow_missing_selection)
    ?> admission=native_work/captured record.pail_at(['library 'admission]) (./err 'flow_missing_selection)
    ? !(native_work_ops/current publisher state) (./err 'flow_stale_selection)
    ? !(native_work_ops/current admission state) (./err 'flow_stale_selection)
    = entries (unpin selected.tree).tap
    ? !(entries.len) (./err 'flow_missing_selection)
    ? !(entries.all((\ [name card] (flow_library_publication/current card state)))) (./err 'flow_stale_selection)
    % todo=row[[path myth]] entries writes=row[[p=path q=writ]] []
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (./ok writes)
    = [entry rest] pair
      [name card] entry
    ?> (./some page) card.path_at(['page]) (./err 'flow_missing_document)
    ? !(card.txt_at(['src]).len)
      ?> (./some publication) card.path_at(['publication]) (./err 'flow_missing_document)
      ?> existing=flow/definition (cooperate_ops/record publication state).fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_missing_document)
      | _ rest writes
    = commands=either[iota row[[p=path q=writ]]]
        ? (cooperate_ops/record page state).is_some (./ok writes)
        ?> (./some creator) card.path_at(['recipe]) (./err 'flow_example_unavailable)
        | ./ok writes.snoc([page (writ/warp creator myth/new)])
    < commands commands
    = args (myth/sing ['id] card.pail_at(['id])).put(['source] card.pail_at(['src]))
    | _ rest commands.snoc([page (writ/warp [state.self 'gov 'flow_examples 'publish_reviewed] args)])
  + publish_entry
    \ page=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(flow_runtime_ops/valid_arguments [['id] ['source]] input) (./err 'flow_invalid_arguments)
    ? !(eq input.txt_at(['source]) (cooperate_ops/record page state).fall(myth/new).txt_at(['src])) (./err 'flow_stale_source)
    | flow_author_ops/publish page input.del(['source]) state
  + local_path
    \ self=iota value=row[nat]
    ^ row[nat]
    ? !(and value.len (eq value.at(0) "0x11")) value
    | (seg_texts [self]).weld(value.drop(1))
  + local_value
    \ self=iota value=sval
    ^ sval
    ?> (./ref target) value value
    | sval/ref (flow_library_publication/local_path self target)
  + local_node
    \ self=iota node=snode
    ^ snode
    = attrs (attrs_of node).map((\ attr=sattr attr.set_vals(attr.vals.map((flow_library_publication/local_value self)))))
    ? node
     > (./doc id _ kids) (snode/doc (flow_library_publication/local_path self id) attrs kids.map((flow_library_publication/local_node self)))
     > (./sect title _ kids) (snode/sect title attrs kids.map((flow_library_publication/local_node self)))
     > (./item lead _ kids) (snode/item lead attrs kids.map((flow_library_publication/local_node self)))
     > (./quote lead _ kids) (snode/quote lead attrs kids.map((flow_library_publication/local_node self)))
     > (./lit lang _ body) (snode/lit lang attrs body)
     > (./ref target _) (snode/ref (flow_library_publication/local_path self target) attrs)
     > (./prose text _) (snode/prose text attrs)
