    ;@ /flow/bind selection selection
    ;@ /flow/bind arguments arguments
    ;= actions

    ;@ /flow/invoke receipts ;/0x11/app/nenex/w/invoke_action_flow/flows/invoke_action
    ;@ /flow/bind actions actions
    ;= receipts

    ;@ /flow/invoke verified ;/0x11/app/nenex/w/verify_action_flow/flows/verify_action
    ;@ /flow/bind receipts receipts
    ;@ /flow/bind checks checks
    ;@ /flow/bind observations observations
    ;= verified

    ;@ /flow/result verified
    ;= Invoke once and verify independently result
