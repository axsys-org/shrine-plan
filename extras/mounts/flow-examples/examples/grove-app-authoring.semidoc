;. /grove_app_authoring_flow
  ;@ /flow/definition grove_app_authoring
  ;= Author and compile a Grove draft
    Bind selection to Create and compile draft discovered on the native Grove workspace. Bind capture to the computed /x output of a native observation cell for the named draft. This composition stops at a verified compiled revision. Exercise preview controls with invoke_and_verify. Publish separately with publish_grove_draft, after explicitly selecting its publication control.

    ;@ /flow/input sources
    ;= sources

    ;@ /flow/input provider
    ;= provider

    ;@ /flow/input selection
    ;= selection

    ;@ /flow/input capture
    ;= capture

    ;@ /flow/invoke proposal ;/0x11/app/nenex/w/grove_source_flow/flows/grove_source
    ;@ /flow/bind sources sources
    ;@ /flow/bind provider provider
    ;= proposal

    ;@ /flow/step actions ;/0x11/gov/flows/operations/stages/prepare_grove
    ;@ /flow/bind selection selection
    ;@ /flow/bind proposal proposal
    ;= Prepare creation on the native Grove workspace

    ;@ /flow/invoke receipts ;/0x11/app/nenex/w/invoke_action_flow/flows/invoke_action
    ;@ /flow/bind actions actions
    ;= receipts

    ;@ /flow/invoke verified ;/0x11/app/nenex/w/inspect_grove_draft_flow/flows/inspect_grove_draft
    ;@ /flow/bind capture capture
    ;@ /flow/bind proposal proposal
    ;@ /flow/bind receipts receipts
    ;= verified

    ;@ /flow/result verified
    ;= Author and compile a Grove draft result
