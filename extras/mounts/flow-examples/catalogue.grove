#import plain=lib/grove/types/text
#import content=sys/content

catalogue =
  @role
  content: plain

create =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_examples/create)
  #on ; %/catalogue
  name: plain
  ! foil
  \ name=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native example admission.")) catalogue

browse =
  @view
  #on ; %/catalogue
  #for ; /sys/slot/flow_examples
  catalogue => col('/sys/slot/content) {
    show(catalogue.content, '/sys/slot/content)
    group(on = catalogue, action = %/create, myth = { '/name = .input("") }) {
      text("Example name", '/sys/slot/label)
      input('/name, "text")
      action("Create example document")
    }
  }
