#import plain=lib/grove/types/text
#import content=sys/content

catalogue =
  @role
  content: plain
  #opt ;
    "/library/review": plain
    "/library/authored": plain
    "/library/shipped": plain

inspect_publication =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_library_publication/inspect)
  #on ; %/catalogue
  name: plain
  id: plain
  inspection: plain
  ! foil
  \ name=str id=str inspection=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native publication inspection.")) catalogue

publish_inspection =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_library_publication/publish)
  #on ; %/catalogue
  inspection: plain
  ! foil
  \ inspection=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native reviewed publication.")) catalogue

create =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_examples/create)
  #on ; %/catalogue
  name: plain
  ! foil
  \ name=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native example admission.")) catalogue

invoke =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_examples/invoke)
  #on ; %/catalogue
  name: plain
  destination: plain
  bindings: plain
  writer: plain
  ! foil
  \ name=str destination=str bindings=str writer=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native example invocation.")) catalogue

observe =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_examples/observe)
  #on ; %/catalogue
  page: plain
  name: plain
  source: plain
  ! foil
  \ page=str name=str source=str catalogue=%/catalogue
  ^ %/catalogue
  | Seq[%/catalogue] (error (pails/t "Requires native observation admission.")) catalogue

browse =
  @view
  #on ; %/catalogue
  #for ; /sys/slot/flow_examples
  catalogue => col('/sys/slot/content) {
    show(catalogue.content, '/sys/slot/content)
    group(on = catalogue, action = %/inspect_publication, myth = { '/name = .input(""), '/id = .input(""), '/inspection = .input("") }) {
      text("Review a flow and its publication dependencies", '/sys/slot/label)
      input('/name, "text")
      text("Definition name (blank uses the recipe name)", '/sys/slot/label)
      input('/id, "text")
      text("New inspection name", '/sys/slot/label)
      input('/inspection, "text")
      action("Inspect publication dependencies")
    }
    show(catalogue.review, '/sys/slot/content)
    text("Authored source (or proposed source for a missing document)", '/sys/slot/label)
    show(catalogue.authored, '/sys/slot/content)
    text("Current shipped recipe: compare before editing the authored page", '/sys/slot/label)
    show(catalogue.shipped, '/sys/slot/content)
    group(on = catalogue, action = %/publish_inspection, myth = { '/inspection = .input("") }) {
      text("Inspection to publish", '/sys/slot/label)
      input('/inspection, "text")
      action("Publish inspected authored sources")
    }
    group(on = catalogue, action = %/create, myth = { '/name = .input("") }) {
      text("Example name", '/sys/slot/label)
      input('/name, "text")
      action("Create example document")
    }
    group(on = catalogue, action = %/invoke, myth = { '/name = .input(""), '/destination = .input(""), '/bindings = .input("{}"), '/writer = .input("") }) {
      text("Invoke an authored example", '/sys/slot/label)
      input('/name, "text")
      text("Destination path", '/sys/slot/label)
      input('/destination, "text")
      text("Input bindings: JSON object of input names to namespace paths", '/sys/slot/label)
      input('/bindings, "text")
      text("Writer namespace path (blank uses Nenex)", '/sys/slot/label)
      input('/writer, "text")
      action("Publish and invoke example")
    }
    group(on = catalogue, action = %/observe, myth = { '/page = .input(""), '/name = .input(""), '/source = .input("") }) {
      text("Observe a record through a live cell", '/sys/slot/label)
      text("Owning Nenex page", '/sys/slot/label)
      input('/page, "text")
      text("Unused cell name", '/sys/slot/label)
      input('/name, "text")
      text("Source record path", '/sys/slot/label)
      input('/source, "text")
      action("Create observation cell")
    }
  }
