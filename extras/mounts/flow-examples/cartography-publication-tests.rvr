(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))

;; The installed graph declaration validates the collected claim shape and
;; codecs before executing its policy. A plain spun wrapper misses this boundary.
(define (check ignored)
  (define compiler (Pin "cartography-publication-test"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define local (bootstrap:build-local ("x" 17) system resolve slot
    ["grove_backend" "graph_policy" "cartography_publication_fixture"]))
  (define code (_1 local))
  (define prepared (backend:prepare-with code "graph_policy"))
  (define policy (_1 prepared))
  (define (image name) (Unpin (_1 (need (find (lambda (pair)
    (Equal name (_0 pair))) (_2 code))))))
  (define (helper name) (driver:get-perc ["graph_publication_fixture" name]
    (image "graph_publication_fixture")))
  (define (path names) (Weld [("x" 17)] (map (lambda (name) ("ts" name)) names)))
  (define (ok result)
    (If (Equal "ok" (Hd result)) (_0 result)
      (error ["cartography-publication-test" (_0 result)])))
  (define (publish root text state)
    (define document (ok ((driver:get-perc ["grove" "parse"] policy) text)))
    (define (previous key)
      ((helper "previous") state (map (lambda (part) ((_0 part) (_1 part))) key)))
    (define (lookup key)
      (define absolute
        (If (And (Sz key) (Or (Eq "x" (Hd (_0 key))) (Equal ("ts" "sys") (_0 key))))
          key (Weld [("x" 17)] key)))
      ((helper "lookup") state absolute))
    (define records (ok (backend:compile prepared previous lookup root document)))
    (_0 (ok (backend:publish prepared records 0 0 state))))
  (define codecs (publish (path ["lib" "grove" "types"])
    (read-text-file "grove/value_codecs.grove") (_0 local)))
  (define published (publish (path ["gov" "graph"])
    (read-text-file "grove/graph/main.grove") codecs))
  (define component (_0 ((helper "lookup") published (path ["gov" "graph" "report"]))))
  (define project (driver:get-perc ["cartography_publication_fixture" "check"]
    (image "cartography_publication_fixture")))
  assert(Equal [2 2 1] (project component 1))
  assert(Equal [2 0 1] (project component 0))
  1)
(#export check)
