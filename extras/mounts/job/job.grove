#import lede=sys/lede
#import text=lib/grove/types/text

' A job, as a template. A buyer keeps it. Before it hears a quote it wants
' one thing shown: a record of another composition, which it names in
' wants (of: that composition, where its maker keeps it; at: the
' position's path as that composition's table spells it). A stencil that
' names what it shows (#shows) is a place that stands only when the record
' there carries a proof of such a record, written for the world that
' shows it. The quote sits beneath it and the decision beneath the quote,
' so each opens when the one above stands. Nothing here says how a thing
' is shown or checked, and nothing but this file is the job.

card =
  @role
  #meta ;
    lede: "Anything in a job that has a title"
  title: text

wanted =
  @role
  #meta ;
    lede: "What a supplier must show: a record at this position of another composition"
  at: text

wants =
  @stencil
  #meta ;
    lede: "What the buyer wants shown before it hears a quote"
  #here ; '/wants
  #with ; wanted
  #by ; maker
  #for ; '/suppliers/[any]

suppliers =
  @stencil
  #meta ;
    lede: "A seat for whoever would supply"
  #here ; '/suppliers/[s=@tas]
  #with ; card
  #by ; maker
  #for ; '/suppliers/[any]

standing =
  @stencil
  #meta ;
    lede: "What a supplier shows of what it was given elsewhere"
  #here ; '/suppliers/[s=@tas]/standing
  #with ; card
  #by ; '/suppliers/[s]
  #for ; maker
  #shows ; '/wants

quote =
  @stencil
  #meta ;
    lede: "What a supplier offers, once its standing is shown"
  #here ; '/suppliers/[s=@tas]/standing/quote
  #with ; card
  #by ; '/suppliers/[s]
  #for ; maker

decision =
  @stencil
  #meta ;
    lede: "What the buyer says of a quote"
  #here ; '/suppliers/[s=@tas]/standing/quote/decision
  #with ; card
  #by ; maker
  #for ; '/suppliers/[s]

"/" =
  @tree
  title: "A job"

"/suppliers" =
  @tree

"/suppliers/first" =
  @tree
  title: "A supplier"
  invite: 1

"/suppliers/second" =
  @tree
  title: "Another supplier"
  invite: 2
