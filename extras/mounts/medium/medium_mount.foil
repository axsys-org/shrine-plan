- medium
- http_foot

+ medium_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = root=path [state.self 'app 'medium]
      invoke
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
        = fields (http_foot/fields request.body)
          get (\ name=str (http_foot/field name fields))
          ;authority (ReadFile "medium-authority")
        ? (le authority 1) (./reply (http_driver/response 503 "Host authority unavailable"))
        ? !(equal (get "credential") (http_foot/unbar authority))
          | ./reply (http_driver/response 403 "Host authentication required")
        ?> (./some expected) (nat/parse (get "expected")) (./reply (http_driver/response 400 "Expected case required"))
        | ./invoke (interaction_runtime/request root (get "principal") (get "operation") expected (get "event") (get "body"))
    | http_foot/add_routes [(http_foot/route "/medium-native" invoke)] http_foot/empty
