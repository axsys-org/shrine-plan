#import records=gov/material/records
#import codec=gov/user/contact_codec/codec

contact =
  ! foil
  + target
    ^ path
    [($x 17) 'app 'user 'studio 'people 'alice]
  + input
    ^ path
    [($x 17) 'app 'user 'inbox 'contact]
  + card
    \ context=grove_surface_context target=path
    ^ either[str myth]
    = matches context.inputs.keep((\ input (equal[path] input.dependency.p target)))
    ? !(eq matches.len 1) (./err "Selected input is outside this binding.")
    ?> (./some card) (records/card matches.at(0)) (./err "Selected input is unavailable.")
    | ./ok card
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? (equal[path] key ['apply])
      | ./ok (grove_occurrence key (grove_focus (safe 0 .x contact/target) ['name] .none)
          (./some context.implementation.path.snoc('prepare)) rex/zero_span "Apply decoded fields to the explicitly selected original person")
    | records/resolve context key parameters
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    ? !(equal[path] occurrence.key ['apply]) (records/prepare context occurrence arguments)
    < current (contact/card context contact/target)
    < input (contact/card context contact/input)
    < decoded (codec/decode input)
    ? !(eq (decoded.txt_at(['email])) (current.txt_at(['email])))
      | ./err "This document has a different email. Identity correspondence needs an explicit choice."
    | ./ok (grove_change_plan [(grove_record_edit contact/target (./some current) (./some current.meld(decoded)))] [(./ok [])])
