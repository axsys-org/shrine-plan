areas =
  ! foil
  + value_of
    \ as=row[weft/att]
    ^ nat
    = found as.keep((\ a (eq a.k "value")))
    ? (eq found.len 0) ""
    | found.at(0).v
  + keep_atts
    \ as=row[weft/att]
    ^ row[weft/att]
    | as.keep((\ a (and (!(eq a.k "value")) (!(eq a.k "type")))))
  + textarea
    \ node=weft/node
    ^ weft/node
    ?> e=weft/node/el node node
    = kids (e.kids.map((\ k (areas/textarea k))))
    ? (eq e.tag "input") (weft/el "textarea" ((areas/keep_atts e.as).snoc((weft/att "rows" "5"))) [(weft/tx (areas/value_of e.as))])
    | weft/el e.tag e.as kids
