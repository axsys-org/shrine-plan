#import records=gov/material/records
#import fields=gov/user/fields/fields
#import dates=gov/user/task_dates/projection
#import context=gov/user/temporal_context/temporal

item =
  ! foil
  + unresolved
    \ target=path title=weft/node person=weft/node result=either[str dates/interval]
    ^ weft/node
    = message=str
        ? result
         > (./err why) why
        "Unresolved temporal projection."
    | weft/el "article" [(weft/att "data-grove-row" (show/path target))]
        [title person (weft/el "p" [(weft/att "class" "need")] [(weft/tx (str/to_atom message))])]
  + item
    \ compact=bool context=grove_surface_context input=grove_observed
    ^ weft/node
    = card (records/card input).fall(myth/new)
      target input.dependency.p
      projected (dates/apply card (context/mode context))
      title (fields/field context target card ['title] "Task")
      person (weft/el "small" [] [(weft/tx (str/to_atom (context/owner context card)))])
    ?> (./ok interval) projected (item/unresolved target title person projected)
    = x (add 16 (mul interval.start 22))
      end (add 16 (mul interval.end 22))
      shape (weft/el "svg" [(weft/att "viewBox" "0 0 440 40") (weft/att "width" "440") (weft/att "height" "40")
          (weft/att "role" "img") (weft/att "aria-label" "Native task interval")]
        [(weft/el "path" [(weft/att "d" "M16 20 H424") (weft/att "stroke" "#e0e5da")] [])
         (weft/el "rect" [(weft/att "x" (str/to_atom (nat/show x))) (weft/att "y" "14")
           (weft/att "width" (str/to_atom (nat/show (? (gt (sub end x) 3) (sub end x) 3)))) (weft/att "height" "12")
           (weft/att "rx" "3") (weft/att "fill" "#719b81")
           (weft/att "data-grove-key" (context/key target ['estimate]))] [])
         (weft/el "circle" [(weft/att "cx" (str/to_atom (nat/show end))) (weft/att "cy" "20")
           (weft/att "r" "5") (weft/att "fill" "#275844")
           (weft/att "data-grove-key" (context/key target ['deadline]))] [])])
      summary (weft/el "p" [(weft/att "class" "interval-summary") (weft/att "data-grove-key" (context/key target ['deadline]))]
        [(weft/tx (str/to_atom (str/cat_all ["Day " (nat/show interval.start) " → " (nat/show interval.end)])))])
      controls [(fields/field context target card ['deadline] "Due day")
                (fields/field context target card ['estimate] "Estimate")]
    = head=row[weft/node] [title person (? compact summary shape)]
    | weft/el "article" [(weft/att "data-grove-row" (show/path target))]
        head.weld((? compact [] controls))
