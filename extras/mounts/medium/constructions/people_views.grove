bindings =
  ! foil
  + root
    ^ path
    [($x 17) 'app 'user 'studio]
  + members
    ^ row[path]
    [(bindings/root).weld(['people 'alice]) (bindings/root).weld(['people 'bob]) (bindings/root).weld(['people 'carol])]
  + surface
    \ code=path
    ^ grove_surface_binding
    | grove_surface_binding (safe 1 .x code)
        (bindings/members).map((\ at (dep .x at)))
        (bindings/members).map((\ at (grove_slot_scope at [['name] ['email] ['role]])))

"/table" =
  @tree
  "/sys/lede": "People · editable records"
  "/sys/goo/surface": (bindings/surface [($x 17) 'gov 'material 'records])

"/cards" =
  @tree
  "/sys/lede": "People · identity presentation"
  "/sys/goo/surface": (bindings/surface [($x 17) 'gov 'user 'people 'people])
