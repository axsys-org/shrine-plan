codec =
  ! foil
  + decode
    \ input=myth
    ^ either[str myth]
    ?> (jres/ok document rest) (parse (input.txt_at(['text]))) (./err "The JSON document could not be decoded.")
    ? !(eq rest 0) (./err "Trailing data in the JSON document.")
    = person (grove_dev/field "person" document)
    ?> (json/str name) (grove_dev/field "name" person) (./err "Person name is missing or not text.")
    ?> (json/str email) (grove_dev/field "email" person) (./err "Person email is missing or not text.")
    | ./ok (myth/sing ['name] (pails/t name)).put(['email] (pails/t email))
