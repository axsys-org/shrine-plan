#import contact=gov/user/contact_ops/contact
#import codec=gov/user/contact_codec/codec

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render contact/resolve contact/prepare)
  ! foil
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < current (contact/card context contact/target)
    < input (contact/card context contact/input)
    < decoded (codec/decode input)
    < occurrence (contact/resolve context ['apply] myth/new)
    = html (weft/node/el "section" [(weft/att "style" "width:420px;background:#fffdf7;border:1px solid #ded5bd;border-radius:10px;padding:28px;color:#4c4637")]
        [(weft/el "small" [] [(weft/tx "INCOMING MATERIAL · JSON")])
         (weft/el "h2" [(weft/att "style" "font:25px Georgia,serif")] [(weft/tx "A detail, not another person")])
         (weft/el "p" [] [(weft/tx (weft/cat2 "Existing · " (str/to_atom (current.txt_at(['name])))))])
         (weft/el "p" [] [(weft/tx (weft/cat2 "Incoming · " (str/to_atom (decoded.txt_at(['name])))))])
         (weft/el "p" [] [(weft/tx "The selected identity and all its other fields stay in place.")])
         (weft/el "button" [(weft/att "data-grove-key" "/apply") (weft/att "data-grove-act" "click")]
           [(weft/tx "Use these details")])
         (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Original material")])
           (weft/el "pre" [(weft/att "style" "white-space:pre-wrap;font-size:11px")] [(weft/tx (str/to_atom (input.txt_at(['text]))))])])])
    | ./ok (grove_surface_output html [occurrence] [[]])
