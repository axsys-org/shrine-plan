#import records=gov/material/records
#import fields=gov/user/fields/fields

people =
  @slot
  #meta ;
    "/sys/lede": "People: reusable identity and field presentations"
    "/sys/goo/program": (grove_surface_program people/render records/resolve records/prepare)
  ! foil
  + person
    \ context=grove_surface_context input=grove_observed
    ^ weft/node
    = card (records/card input).fall(myth/new)
      ref input.dependency.p
    | weft/el "article" [(weft/att "class" "person") (weft/att "data-grove-row" (show/path ref))]
        [(weft/el "div" [(weft/att "class" "identity-mark")] [(weft/tx "↗")])
         (fields/field context ref card ['name] "Name")
         (fields/field context ref card ['email] "Email")
         (fields/field context ref card ['role] "Working on")
         (weft/el "small" [] [(weft/tx (show/path ref))])]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < shared (records/render context)
    = body (weft/node/el "section" [(weft/att "class" "people-board")]
        [(weft/el "style" [] [(weft/raw ".people-board{width:600px;padding:30px;background:#fffdfa;border:1px solid #dedbd2;border-radius:12px;color:#283c36}.people-board h1{font:500 27px Georgia,serif;margin:0 0 4px}.people-board header p{color:#7b8177;margin:0 0 26px;font-size:12px}.person{position:relative;border-top:1px solid #e8e5dc;padding:18px 0 16px 40px}.identity-mark{position:absolute;left:0;top:22px;color:#678476;font-size:24px}.person-field{display:flex;align-items:center;margin:4px 0}.person-field span{width:90px;font-size:11px;color:#818579}.person-field input{flex:1;min-width:0;padding:5px 6px;border:1px solid transparent;border-radius:4px;background:transparent;color:#253c34;font:inherit}.person-field input:hover{background:#f2f4ed}.person-field input:focus{background:#f2f4ed;outline:1px solid #628770}.person small{display:block;font:9px ui-monospace,monospace;color:#98a094;margin:7px 6px 0}")])
         (weft/el "header" [] [(weft/el "h1" [] [(weft/tx "People in the work")])
           (weft/el "p" [] [(weft/tx "One identity. Every occurrence stays connected.")])])
         (weft/el "div" [] ((records/visible context).map((people/person context))))])
    | ./ok (grove_surface_output body shared.occurrences shared.families)

