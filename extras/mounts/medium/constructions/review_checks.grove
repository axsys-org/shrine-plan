#import records=gov/material/records

checks =
  ! foil
  + validate
    \ context=grove_surface_context plan=grove_change_plan owner=myth
    ^ either[str unit]
    ? !(plan.checks.all((\ check (either/is_ok check)))) (./err "An original action check failed.")
    ? (gt plan.edits.len 256) (./err "The original plan exceeds its transaction bound.")
    = allowed
        | plan.edits.all
        \ edit=grove_record_edit
        = observed context.inputs.keep((\ input (equal[path] input.dependency.p edit.target)))
          scopes context.writes.keep((\ scope (equal[path] scope.target edit.target)))
        ? !(and (eq observed.len 1) (eq scopes.len 1)) .false
        ? !(equal edit.before (records/card observed.at(0))) .false
        ?> (./some before) edit.before .false
        ?> (./some after) edit.after .false
        | before.meld(after).tap.all((\ entry ((equal before.get(entry.key) after.get(entry.key)) || scopes.at(0).slots.has(entry.key))))
    ? !allowed (./err "The plan is outside the original inputs/write scope or needs construction authority.")
    ?> (./some held) owner.get(goo_runtime/commitments_slot) (./ok [])
    ?> policy=goo_runtime/action_commitments held (./err "Invalid retained commitments.")
    ? !(commitment/unique policy.retained) (./err "Retained commitment identities conflict.")
    ? !(commitment/admissible .true (goo_runtime/assess_action policy context plan))
      | ./err "An original retained commitment failed or remains unknown."
    | ./ok []
