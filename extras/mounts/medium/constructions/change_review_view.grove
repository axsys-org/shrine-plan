#import review=gov/user/change_review/review
#import basis=gov/user/review_basis/basis
#import markup=gov/user/review_markup/markup

presentation =
  ! foil
  + render
    \ origin=path draft=path context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (basis/card context draft)
    = state card.txt_at(['state])
      content=row[weft/node]
        ?> (./some held) card.get(['pending]) [(weft/el "p" [] [(weft/tx "No changes proposed. Ask the agent to change a selected value; the original will stay untouched while you review.")])]
        ?> proposed=basis/pending held [(weft/tx "This proposal needs its original native definition.")]
        = stale !(equal proposed.bases (basis/bases context draft))
          actions=row[weft/node]
            ? !(eq state "pending") []
            ? stale [(weft/el "p" [(weft/att "role" "alert")] [(weft/tx "The original changed since this preview. Ask the agent to refresh its proposal.")]) (markup/button "/discard" "Discard")]
            [(markup/button "/commit" "Apply these changes") (markup/button "/discard" "Discard")]
        | proposed.plan.edits.map(markup/edit).weld(
          [(weft/el "div" [(weft/att "class" "change-actions")] actions)
           (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Basis & checks")])
             (weft/el "p" [] [(weft/tx "Prepared by the original native action. Its checks and retained commitments must hold again when applied.")])
             (weft/el "ul" [] proposed.bases.map(markup/read))
             (weft/el "p" [] [(weft/tx "Coverage: exact captured inputs and write targets. A global downstream impact search has not been performed.")])])])
      title=nat (? (eq state "applied") "Changes applied" (? (eq state "discarded") "Proposal discarded" "Review changes"))
      hint=nat (? (eq state "applied") "These exact native edits were applied together." "Your original work stays unchanged until you apply this proposal.")
      html (weft/node/el "section" [(weft/att "class" "native-change-review")]
        [(weft/el "style" [] [(weft/raw ".native-change-review{width:680px;max-width:calc(100vw - 64px);padding:26px 30px;background:#fffefb;color:#253730;border:1px solid #d8dfd6;border-radius:12px;box-shadow:0 12px 38px #25372d0c}.native-change-review h2{font:600 24px/1.3 -apple-system,sans-serif;margin:0 0 8px;letter-spacing:-.6px}.native-change-review p{font:13px/1.65 -apple-system,sans-serif;color:#66756c;margin:0 0 20px}.change-record{border-top:1px solid #e4e9e1;padding:18px 0}.change-record h3{font:600 14px -apple-system,sans-serif;margin:0 0 5px}.change-record>a{display:block;color:#748477;font:10px/1.5 ui-monospace,monospace;overflow-wrap:anywhere;text-decoration:none}.change-field{margin-top:14px}.change-field>code{display:block;font:11px ui-monospace,monospace;color:#647468;margin-bottom:8px}.change-values{display:grid;grid-template-columns:1fr 20px 1fr;gap:8px;align-items:center;font:14px/1.6 -apple-system,sans-serif;white-space:pre-wrap;overflow-wrap:anywhere}.change-values del,.change-values ins{padding:12px;border-radius:6px;text-decoration:none}.change-values del{background:#faf0ed;color:#8a5249}.change-values ins{background:#edf5e9;color:#31623f}.change-values>span{text-align:center;color:#94a090}.change-actions{display:flex;gap:12px;margin:14px 0 20px}.change-actions button{font:500 13px -apple-system,sans-serif;padding:10px 16px;border-radius:6px;border:1px solid #cbd7c8;background:#f9faf6}.change-actions button:first-child{background:#315d48;color:white;border-color:#315d48}.native-change-review details{font:11px/1.6 -apple-system,sans-serif;color:#778375}.native-change-review summary{cursor:pointer;padding:8px 0}.native-change-review li{font:10px/1.8 ui-monospace,monospace;overflow-wrap:anywhere}.native-change-review details p{font-size:11px;margin:8px 0}")])
         (weft/el "h2" [] [(weft/tx title)])
         (weft/el "p" [] [(weft/tx hint)])
         (weft/el "div" [] content)])
    < propose (review/resolve origin draft context ['propose] myth/new)
    < commit (review/resolve origin draft context ['commit] myth/new)
    < discard (review/resolve origin draft context ['discard] myth/new)
    | ./ok (grove_surface_output html [propose commit discard] [[]])
