#import records=gov/material/records
#import context=gov/user/temporal_context/temporal
#import item=gov/user/temporal_item/item

view =
  ! foil
  + render
    \ compact=bool context=grove_surface_context
    ^ either[str grove_surface_output]
    < common (records/render context)
    = keys=row[path] [['deadline] ['estimate]]
      selections=row[grove_occurrence]
        | keys.map
        \ key
        | either/ok_val (context/resolve context key myth/new)
      html (weft/node/el "section" [(weft/att "class" "temporal")]
        [(weft/el "style" [] [(weft/raw ".temporal{width:510px;border:1px solid #d6dfd3;border-radius:10px;padding:26px 32px;background:#fbfdf7;color:#2b4135}.temporal h1{font:500 26px Georgia,serif;margin:0 0 8px}.temporal header p{font-size:12px;color:#788775;margin:0 0 16px}.temporal article{border-top:1px solid #e1e7da;padding:16px 0}.temporal small{color:#6b8070;font-size:11px}.temporal .person-field{display:flex;align-items:center;gap:10px;margin:4px 0}.temporal .person-field span{width:65px;font-size:11px;color:#7a8a78}.temporal input{min-width:0;width:100%;flex:1;padding:5px;border:1px solid transparent;background:transparent;color:inherit;border-radius:3px}.temporal input:focus{outline:1px solid #628770;background:#f1f6e9}.temporal button{font-size:11px;margin:0 5px 12px 0;background:#edf4e6;border:1px solid #d2dec9}.temporal .need{color:#95622f;font-size:12px}.interval-summary{font:21px Georgia,serif;color:#41664f;margin:12px 0}")])
         (weft/el "header" [] [(weft/el "h1" [] [(weft/tx (? compact "Upcoming work" "Time around the work"))])
            (weft/el "p" [] [(weft/tx (weft/cat2 "Shared projection · " (str/to_atom (context/mode context))))])])
         (weft/el "div" [] [(context/control "Use deadlines" "/deadline") (context/control "Include estimates" "/estimate")])
         (weft/el "div" [] ((context/tasks context).map((item/item compact context))))])
    | ./ok (grove_surface_output html common.occurrences.weld(selections) common.families)

line =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program (view/render .false) context/resolve context/prepare)

upcoming =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program (view/render .true) context/resolve context/prepare)
