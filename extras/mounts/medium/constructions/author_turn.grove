#import history=gov/user/author_history/history

turn =
  ! foil
  + render
    \ item=history/turn
    ^ weft/node
    = result item.result
      material item.material
      label item.label
      output=row[weft/node]
        ? (eq result.len 0) []
        [(weft/el "div" [(weft/att "data-native-mount" (str/to_atom result))] [])]
      link=row[weft/node]
        ? (eq material.len 0) []
        [(weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (str/to_atom material)))
             (weft/att "data-native-material" (str/to_atom material))]
           [(weft/tx (? (eq label.len 0) "View structure" (str/to_atom label))) (weft/tx " ↗")])]
    | weft/el "article" [(weft/att "class" "work-turn")
          (weft/att "data-turn" (str/to_atom (nat/show (item.generation))))
          (weft/att "data-flow" (str/to_atom (item.flow)))]
        [(weft/el "div" [(weft/att "class" "request-line")]
           [(weft/el "span" [] [(weft/tx "You")]) (weft/el "p" [] [(weft/tx (str/to_atom (item.prompt)))])])
         (weft/el "div" [(weft/att "class" "response-line")]
           [(weft/el "span" [(weft/att "class" "work-state")] [(weft/tx (str/to_atom (item.state)))])
            (weft/el "p" [(weft/att "data-native-reply" "true")] [(weft/tx (str/to_atom (item.reply)))])])
         (weft/el "div" [(weft/att "class" "turn-material")] link)
         (weft/el "div" [(weft/att "class" "turn-result")] output)]
