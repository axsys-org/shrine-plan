#import records=gov/material/records
#import fields=gov/user/fields/fields

profile =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program profile/render records/resolve records/prepare)
  ! foil
  + target
    ^ path
    [($x 17) 'app 'user 'personal 'me]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < shared (records/render context)
    = card (records/card context.inputs.at(0)).fall(myth/new)
      html (weft/node/el "section" [(weft/att "class" "personal-profile")]
        [(weft/el "style" [] [(weft/raw ".personal-profile{width:420px;padding:30px;background:#fffffa;border:1px solid #d9e2ce;border-radius:12px;color:#2e4c37}.personal-profile h1{font:28px Georgia,serif;margin:8px 0 25px}.personal-profile small{font-size:10px;color:#889b78;letter-spacing:1.5px;text-transform:uppercase}.personal-profile label{display:block}.personal-profile label>span{display:block;font-size:11px;color:#87977a;margin:0 0 8px}.personal-profile input{width:100%;padding:10px 12px;border:1px solid #d3dfc8;border-radius:5px;background:#f6f8f0;color:#3d5a3e;font-size:15px}.personal-profile p{font-size:12px;line-height:1.8;color:#87977a;margin:20px 0 0}")])
         (weft/el "small" [] [(weft/tx "In your world")])
         (weft/el "h1" [] [(weft/tx "You")])
         (fields/field context profile/target card ['name] "Name")
         (weft/el "p" [] [(weft/tx "This is your original person. Other surfaces can use these same fields. Add what matters as you go.")])])
    | ./ok (grove_surface_output html shared.occurrences shared.families)

"/me" =
  @tree
  "/sys/lede": "Ian"
  "/name": "Ian Channer"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'personal_start 'profile]) [(dep .x profile/target)] [(grove_slot_scope profile/target [['name]])])

"/home" =
  @tree
  "/sys/lede": "My world"
  "/me": (pails/p [($x 17) 'app 'user 'personal 'me])
  "/files": (pails/p [($x 17) 'app 'user 'files 'originals])

"/view" =
  @tree
  "/sys/lede": "My profile"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'personal_start 'profile])
    [(dep .x profile/target)] [(grove_slot_scope profile/target [['name]])])
