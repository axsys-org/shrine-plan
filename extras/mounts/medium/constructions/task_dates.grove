projection =
  @slot
  #meta ;
    "/sys/lede": "Task to interval"
    "/provenance": "OpenRouter authored; native compiler diagnostic repaired; see retained source receipt."
  ! foil
  + interval
    : start=nat end=nat
  + apply
    \ card=myth mode=str
    ^ either[str projection/interval]
    ?> (./some held_d) card.get(['deadline]) (./err "Deadline unknown.")
    ?> deadline=pails/n held_d (./err "Wrong type.")
    ? (eq mode "deadline") (./ok (projection/interval deadline.n deadline.n))
    ? !(eq mode "estimate") (./err "Unknown mode.")
    ?> (./some held_e) card.get(['estimate]) (./err "Estimate unknown.")
    ?> estimate=pails/n held_e (./err "Wrong type.")
    ? (gt estimate.n deadline.n) (./err "Before origin.")
    | ./ok (projection/interval (sub deadline.n estimate.n) deadline.n)
