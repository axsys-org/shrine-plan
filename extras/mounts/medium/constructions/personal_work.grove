#import records=gov/material/records

binding =
  ! foil
  + targets
    ^ row[path]
    [[($x 17) 'app 'user 'personal 'next 'world]
     [($x 17) 'app 'user 'personal 'next 'author]
     [($x 17) 'app 'user 'personal 'next 'editor]]
  + use
    ^ grove_surface_binding
    | grove_surface_binding (safe 1 .x [($x 17) 'gov 'material 'records])
        (binding/targets).map((\ at (dep .x at)))
        (binding/targets).map((\ at (grove_slot_scope at [['status] ['next_step]])))

"/me" =
  @tree
  "/sys/lede": "Ian"
  "/name": "Ian Channer"
  "/role": "Building Shrine"

"/project" =
  @tree
  "/sys/lede": "Shrine"
  "/name": "A native personal operating environment"
  "/owner": (pails/p [($x 17) 'app 'user 'personal 'me])
  "/purpose": "Work with native things. Let the world accumulate useful machinery."

"/next/world" =
  @tree
  "/sys/lede": "Shared world"
  "/status": "Working slice"
  "/next_step": "Keep real identities shared across useful constructions."
  "/owner": (pails/p [($x 17) 'app 'user 'personal 'me])
  "/project": (pails/p [($x 17) 'app 'user 'personal 'project])
  "/evidence": (pails/p [($x 17) 'app 'user 'workspace 'home])

"/next/author" =
  @tree
  "/sys/lede": "Native AI author"
  "/status": "In progress"
  "/next_step": "Use OpenRouter to search, reuse and construct through native tools."
  "/owner": (pails/p [($x 17) 'app 'user 'personal 'me])
  "/project": (pails/p [($x 17) 'app 'user 'personal 'project])
  "/evidence": (pails/p [($x 17) 'app 'user 'author 'work])

"/next/editor" =
  @tree
  "/sys/lede": "The environment edits itself"
  "/status": "Not yet connected"
  "/next_step": "Compose the native editor, compiler and diagnostics into a working source environment."
  "/owner": (pails/p [($x 17) 'app 'user 'personal 'me])
  "/project": (pails/p [($x 17) 'app 'user 'personal 'project])

"/work" =
  @tree
  "/sys/lede": "Work on Shrine"
  "/sys/goo/surface": binding/use
