#import records=gov/material/records

basis =
  ! foil
  + pending
    : plan=grove_change_plan bases=row[[dep maybe[nat]]] key=path
  + capture
    \ context=grove_surface_context origin=path
    ^ either[str [grove_surface_context grove_surface_program myth]]
    = owners context.inputs.keep((\ input (equal[path] input.dependency.p origin)))
    ? !(eq owners.len 1) (./err "The original surface is outside this basis.")
    ?> (./some owner) (records/card owners.at(0)) (./err "The original surface is unavailable.")
    ?> (./some held) owner.get(goo_runtime/surface_slot) (./err "The original has no binding.")
    ?> binding=grove_surface_binding held (./err "The original binding has changed type.")
    = sources context.inputs.keep((\ input (equal[path] input.dependency.p binding.implementation.path)))
    ? !(eq sources.len 1) (./err "The original implementation must be an explicit input.")
    ? !(equal sources.at(0).basis (maybe/some[nat] binding.implementation.ver))
      | ./err "The installed implementation is historical; this basis needs its exact pinned code."
    ?> (./some code) (records/card sources.at(0)) (./err "The original implementation is unavailable.")
    ?> (./some held) code.get(goo_runtime/program_slot) (./err "The original program is absent.")
    ?> program=grove_surface_program held (./err "The original program changed type.")
    = inputs context.inputs.keep((\ input (binding.reads.has(input.dependency))))
    ? !(eq inputs.len binding.reads.len) (./err "The original read scope is incomplete.")
    | ./ok [(grove_surface_context origin inputs context.viewport binding.implementation binding.writes) program owner]
  + card
    \ context=grove_surface_context draft=path
    ^ either[str myth]
    = matches context.inputs.keep((\ input (equal[path] input.dependency.p draft)))
    ? !(eq matches.len 1) (./err "The proposal record is not in this binding.")
    ?> (./some card) (records/card matches.at(0)) (./err "Proposal record unavailable.")
    | ./ok card
  + bases
    \ context=grove_surface_context draft=path
    ^ row[[dep maybe[nat]]]
    | context.inputs.keep((\ input !(equal[path] input.dependency.p draft))).map((\ input [input.dependency input.basis]))
