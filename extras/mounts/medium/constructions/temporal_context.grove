#import records=gov/material/records

temporal =
  @slot
  ! foil
  + root
    ^ path
    [($x 17) 'app 'user 'schedule]
  + mode
    \ context=grove_surface_context
    ^ str
    = configs context.inputs.keep((\ input (equal[path] input.dependency.p (temporal/root).snoc('mapping))))
    ? !(eq configs.len 1) ""
    | (records/card configs.at(0)).fall(myth/new).txt_at(['use])
  + tasks
    \ context=grove_surface_context
    ^ row[grove_observed]
    | (records/visible context).keep((\ input (records/card input).fall(myth/new).has(['deadline])))
  + owner
    \ context=grove_surface_context card=myth
    ^ str
    ?> (./some held) card.get(['owner]) "Unassigned"
    ?> owner=pails/p held "Unknown owner reference"
    = people context.inputs.keep((\ input (equal[path] input.dependency.p owner.p)))
    ? !(eq people.len 1) "Owner outside this read scope"
    | (records/card people.at(0)).fall(myth/new).txt_at(['name])
  + key
    \ target=path slot=path
    ^ nat
    | show/path (records/key target slot)
  + control
    \ title=nat key=nat
    ^ weft/node
    | weft/el "button" [(weft/att "data-grove-key" key) (weft/att "data-grove-act" "click")]
        [(weft/tx title)]
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? ((equal[path] key ['deadline]) || (equal[path] key ['estimate]))
      | ./ok (grove_occurrence key (grove_focus (safe 0 .x (temporal/root).snoc('mapping)) ['use] .none)
          (./some context.implementation.path.snoc('prepare)) rex/zero_span "Shared Task → Interval binding")
    | records/resolve context key parameters
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    ? ((equal[path] occurrence.key ['deadline]) || (equal[path] occurrence.key ['estimate]))
      = mode=str (? (equal[path] occurrence.key ['deadline]) "deadline" "estimate")
      | records/prepare context occurrence (myth/sing ['value] (pails/t mode))
    | records/prepare context occurrence arguments
