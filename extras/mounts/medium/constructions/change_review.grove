#import records=gov/material/records
#import basis=gov/user/review_basis/basis
#import checks=gov/user/review_checks/checks

review =
  ! foil
  + resolve
    \ origin=path draft=path context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? ((equal[path] key ['propose]) || (equal[path] key ['commit]) || (equal[path] key ['discard]))
      | ./ok (grove_occurrence key (grove_focus (safe 0 .x draft) ['pending] .none)
          (./some context.implementation.path.snoc('prepare)) rex/zero_span "Native proposal: original values remain unchanged until applied")
    < captured (basis/capture context origin)
    = [original program owner] captured
    < item (program.resolve original key parameters)
    | ./ok item.set_action(.none)
  + prepare
    \ origin=path draft=path context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    < before (basis/card context draft)
    ? (equal[path] occurrence.key ['discard])
      = after before.del(['pending]).put(['state] (pails/t "discarded"))
      | ./ok (grove_change_plan [(grove_record_edit draft (./some before) (./some after))] [])
    < captured (basis/capture context origin)
    = [original program owner] captured
    ? (equal[path] occurrence.key ['propose])
      ?> (./some key) (path_parse (arguments.txt_at(['key]))) (./err "Provide an exact original occurrence key.")
      < item (program.resolve original key myth/new)
      ?> (./some action) item.action (./err "The selected occurrence has no native action.")
      < plan (program.prepare original item arguments.del(['key]))
      < checked (checks/validate original plan owner)
      = proposed (basis/pending plan (basis/bases context draft) key)
        after before.put(['pending] proposed).put(['state] (pails/t "pending"))
      | ./ok (grove_change_plan [(grove_record_edit draft (./some before) (./some after))] [])
    ? !(equal[path] occurrence.key ['commit]) (./err "Use an available proposal action.")
    ? !(eq (before.txt_at(['state])) "pending") (./err "This proposal is not pending.")
    ?> (./some held) before.get(['pending]) (./err "No retained native plan.")
    ?> proposed=basis/pending held (./err "The retained plan has a different type.")
    ? !(equal proposed.bases (basis/bases context draft))
      | ./err "An input or implementation changed after preview. Keep the proposal and ask for a refreshed fit; nothing was applied."
    < checked (checks/validate original proposed.plan owner)
    = after before.put(['state] (pails/t "applied"))
    | ./ok (grove_change_plan proposed.plan.edits.snoc((grove_record_edit draft (./some before) (./some after))) proposed.plan.checks)
