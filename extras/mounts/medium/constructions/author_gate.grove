#import records=gov/material/records

gate =
  ! foil
  + target
    ^ path
    [($x 17) 'app 'user 'author_gate 'proposal]
  + card
    \ context=grove_surface_context
    ^ either[str myth]
    = inputs context.inputs.keep((\ input (equal[path] input.dependency.p gate/target)))
    ? !(eq inputs.len 1) (./err "Proposal record not in this binding.")
    ?> (./some card) (records/card inputs.at(0)) (./err "Proposal record unavailable.")
    | ./ok card
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    = keys=row[path] [['stage] ['approve] ['decline] ['finish]]
    ? !(keys.has(key)) (./err "Unknown proposal action.")
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x gate/target) ['state] .none)
        (./some context.implementation.path.snoc('prepare)) rex/zero_span "Review the exact native construction request")
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    < before (gate/card context)
    < after (gate/change before occurrence.key arguments)
    | ./ok (grove_change_plan [(grove_record_edit gate/target (./some before) (./some after))] [])
  + change
    \ before=myth key=path args=myth
    ^ either[str myth]
    ? (equal[path] key ['stage])
      = operation args.txt_at(['operation])
      ? !((eq operation "native/commit") || ((eq operation "native/author") || (eq operation "native/instantiate"))) (./err "This review accepts native construction requests only.")
      ? ((eq (args.txt_at(['id])) "") || (gt (args.txt_at(['body])).len 64000)) (./err "Invalid or oversized proposal.")
      | ./ok before.meld(args).put(['state] (pails/t "pending")).put(['outcome] (pails/t ""))
    ? (equal[path] key ['finish])
      ? !(eq (before.txt_at(['id])) (args.txt_at(['id]))) (./err "This receipt belongs to another proposal.")
      | ./ok before.put(['state] (pails/t (args.txt_at(['state])))).put(['outcome] (pails/t (args.txt_at(['outcome]))))
    ? !(eq (before.txt_at(['state])) "pending") (./err "This proposal is no longer pending.")
    ? (equal[path] key ['approve]) (./ok before.put(['state] (pails/t "approved")))
    ? (equal[path] key ['decline]) (./ok before.put(['state] (pails/t "declined")))
    | ./err "Choose an available proposal action."
