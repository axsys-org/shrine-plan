#import context=gov/user/temporal_context/temporal

binding =
  ! foil
  + tasks
    ^ row[path]
    [[($x 17) 'app 'user 'studio 'tasks 'fieldwork] [($x 17) 'app 'user 'studio 'tasks 'prototype] [($x 17) 'app 'user 'studio 'tasks 'review]]
  + people
    ^ row[path]
    [[($x 17) 'app 'user 'studio 'people 'alice] [($x 17) 'app 'user 'studio 'people 'bob] [($x 17) 'app 'user 'studio 'people 'carol]]
  + use
    \ code=path
    ^ grove_surface_binding
    | grove_surface_binding (safe 1 .x code)
        ((binding/tasks).weld(binding/people).snoc((context/root).snoc('mapping))).map((\ at (dep .x at)))
        ((binding/tasks).map((\ at (grove_slot_scope at [['title] ['deadline] ['estimate]])))).snoc((grove_slot_scope (context/root).snoc('mapping) [['use]]))

"/mapping" =
  @tree
  "/sys/lede": "Task temporal projection"
  "/use": "estimate"

"/timeline" =
  @tree
  "/sys/lede": "Task intervals"
  "/sys/goo/surface": (binding/use [($x 17) 'gov 'user 'temporal_view 'line])

"/upcoming" =
  @tree
  "/sys/lede": "Upcoming work"
  "/sys/goo/surface": (binding/use [($x 17) 'gov 'user 'temporal_view 'upcoming])
