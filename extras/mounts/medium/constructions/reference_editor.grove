#import records=gov/material/records

references =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program references/render records/resolve references/prepare)
  ! foil
  + field
    \ context=grove_surface_context target=path entry=mop/kv[path pail]
    ^ weft/node
    ?> reference=pails/p entry.val (weft/tx "")
    | weft/el "label" [] [(weft/tx (show/path entry.key))
        (weft/el "input" [(weft/att "data-grove-key" (show/path (records/key target entry.key)))
          (weft/att "data-grove-edit" "change") (weft/att "data-argument-slot" "/value")
          (weft/att "data-argument-kind" "reference") (weft/att "value" (show/path reference.p))] [])]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    = nodes (records/visible context).bind((\ input (records/card input).fall(myth/new).tap.map((references/field context input.dependency.p))))
      html (weft/node/el "section" [] [(weft/el "h1" [] [(weft/tx "Connections")]) (weft/el "div" [] nodes)])
    | ./ok (grove_surface_output html [] [[]])
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence args=myth
    ^ either[str grove_change_plan]
    = input context.inputs.keep((\ input (equal[path] input.dependency.p occurrence.focus.source.path)))
    ? !(eq input.len 1) (./err "Select an original reference.")
    ?> (./some before) (records/card input.at(0)) (./err "Original record is unavailable.")
    ?> (./some held) before.get(occurrence.focus.slot) (./err "Reference no longer exists.")
    ?> original=pails/p held (./err "This slot is not a reference.")
    ?> (./some held) args.get(['value]) (./err "Select a reference.")
    ?> value=pails/p held (./err "An exact native reference is required.")
    | ./ok (grove_change_plan [(grove_record_edit occurrence.focus.source.path (./some before)
        (./some before.put(occurrence.focus.slot value)))] [])
