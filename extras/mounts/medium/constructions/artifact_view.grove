#import files=gov/user/artifact_store/files

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render files/resolve files/prepare)
  ! foil
  + item
    \ file=files/artifact
    ^ weft/node
    | weft/el "article" [(weft/att "class" "native-file") (weft/att "data-grove-key" (show/path [($tu (str/to_atom file.id))]))]
        [(weft/el "h2" [] [(weft/tx (str/to_atom file.name))])
         (weft/el "small" [] [(weft/tx (str/to_atom (str/cat_all [(nat/show file.size) " bytes · " file.media])))])
         (weft/el "p" [] [(weft/tx (? file.decoded "Original retained · text decoded without interpretation" "Original retained · preview supports UTF-8 text up to 32 KiB"))])
         (weft/el "pre" [] [(weft/tx (str/to_atom file.text))])
         (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Original & provenance")])
            (weft/el "code" [] [(weft/tx (str/to_atom file.digest))])
            (weft/el "p" [] [(weft/tx "SHA-256 calculated at the browser's file-input boundary. Original bytes are retained in the native collection; names and contents have not been mapped onto personal identities.")])])]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (files/card context)
    < attach (files/resolve context ['attach] myth/new)
    = all (files/items card)
      start context.viewport.nat_at(['start] 0)
      remaining all.drop(start)
      page remaining.take((? (gt remaining.len 8) 8 remaining.len))
      selected context.viewport.txt_at(['artifact])
      visible (? (eq selected.len 0) page all.keep((\ item (eq item.id selected))))
      occurrences visible.map((\ item (grove_occurrence [($tu (str/to_atom item.id))]
        (grove_focus (safe 0 .x files/target) ['originals] (./some (files/selection item.id ['text]))) .none rex/zero_span item.name)))
      html (weft/node/el "section" [(weft/att "class" "native-files")]
        [(weft/el "style" [] [(weft/raw ".native-files{width:600px;background:#fffffa;border:1px solid #dce3d4;border-radius:10px;padding:28px;color:#304d38}.native-files h1{font:28px Georgia,serif;margin:0 0 22px}.native-files h2{font:600 15px -apple-system,sans-serif;margin:0 0 5px}.native-file{padding:20px 0;border-top:1px solid #e2e8d9}.native-file small{font-size:10px;color:#8b9981}.native-file p{font-size:11px;color:#7c8d73;line-height:1.7}.native-file pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.7 -apple-system,sans-serif;max-height:340px;overflow:auto;padding:14px;background:#f5f8ee;border-radius:5px}.native-file details{font-size:10px;color:#8b9b7c}.native-file summary{cursor:pointer}.native-file code{display:block;overflow-wrap:anywhere;font-size:9px;margin-top:10px}")])
         (weft/el "h1" [] [(weft/tx "Files in your world")])
         (weft/el "div" [] visible.map(view/item))])
    | ./ok (grove_surface_output html occurrences.snoc(attach) [[]])

"/originals" =
  @tree
  "/sys/lede": "Original files"
  "/originals": (files/collection [])
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'artifact_view 'view]) [(dep .x files/target)] [(grove_slot_scope files/target [['originals]])])

"/surface" =
  @tree
  "/sys/lede": "Files"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'artifact_view 'view])
    [(dep .x files/target)] [(grove_slot_scope files/target [['originals]])])
