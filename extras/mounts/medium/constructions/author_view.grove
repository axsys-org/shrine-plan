#import turn=gov/user/author_turn/turn
#import history=gov/user/author_history/history
#import work=gov/user/author_work/work

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render work/resolve work/prepare)
  ! foil
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (work/card context)
    < request (work/resolve context ['request] myth/new)
    < cancel (work/resolve context ['cancel] myth/new)
    = flow context.viewport.txt_at(['flow])
      turns (history/turns card).keep((\ item (eq (item.flow) flow)))
      offset context.viewport.nat_at(['offset] 0)
      end (sub turns.len offset)
      start (sub end 20)
      page turns.take(end).drop(start)
      paging=row[weft/node]
        = older=row[weft/node]
            ? (eq start 0) []
            [(weft/el "button" [(weft/att "data-native-viewport-slot" "/offset") (weft/att "data-native-viewport-kind" "natural")
              (weft/att "data-native-viewport-value" (str/to_atom (nat/show (add offset 20))))] [(weft/tx "Earlier requests")])]
          newer=row[weft/node]
            ? (eq offset 0) []
            [(weft/el "button" [(weft/att "data-native-viewport-slot" "/offset") (weft/att "data-native-viewport-kind" "natural")
              (weft/att "data-native-viewport-value" (str/to_atom (nat/show (sub offset 20))))] [(weft/tx "Recent requests")])]
        | older.weld(newer)
      html (weft/node/el "section" [(weft/att "class" "native-thread")]
        [(weft/el "div" [(weft/att "class" "request-thread-pagination")] paging)
         (weft/el "div" [(weft/att "data-native-page-count" (str/to_atom (nat/show turns.len)))
             (weft/att "data-native-page-size" "20")] page.map(turn/render))
         (weft/el "button" [(weft/att "data-grove-key" "/cancel") (weft/att "data-grove-act" "click")
           (weft/att "class" "cancel-work")] [(weft/tx "Stop current work")])])
    | ./ok (grove_surface_output html [request cancel] [[]])

"/work" =
  @tree
  "/sys/lede": "Requests and results"
  "/request": ""
  "/generation": (pails/n 0)
  "/state": "idle"
  "/reply": ""
  "/result": ""

"/surface" =
  @tree
  "/sys/lede": "Your work"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'author_view 'view])
    [(dep .x work/target)]
    [(grove_slot_scope work/target [['request] ['generation] ['state] ['reply] ['result] ['turns] ['flow] ['prompt] ['material] ['label]])])
