"/" =
  @tree
  "/sys/lede": "Working studio · synthetic material"

"/people/alice" =
  @tree
  "/sys/lede": "Alice"
  "/name": "Alice Moreno"
  "/email": "alice@example.invalid"
  "/role": "Research"
  "/manager": (pails/p [($x 17) 'app 'user 'studio 'people 'carol])

"/people/bob" =
  @tree
  "/sys/lede": "Bob"
  "/name": "Bob Okafor"
  "/email": "bob@example.invalid"
  "/role": "Prototyping"
  "/manager": (pails/p [($x 17) 'app 'user 'studio 'people 'carol])

"/people/carol" =
  @tree
  "/sys/lede": "Carol"
  "/name": "Carol Park"
  "/email": "carol@example.invalid"
  "/role": "Coordination"

"/tasks/fieldwork" =
  @tree
  "/sys/lede": "Fieldwork"
  "/title": "Visit the test site"
  "/deadline": (pails/n 8)
  "/estimate": (pails/n 3)
  "/owner": (pails/p [($x 17) 'app 'user 'studio 'people 'alice])

"/tasks/prototype" =
  @tree
  "/sys/lede": "Prototype"
  "/title": "Make the first instrument"
  "/deadline": (pails/n 12)
  "/estimate": (pails/n 5)
  "/owner": (pails/p [($x 17) 'app 'user 'studio 'people 'bob])

"/tasks/review" =
  @tree
  "/sys/lede": "Review"
  "/title": "Review what actually worked"
  "/deadline": (pails/n 16)
  "/estimate": (pails/n 2)
  "/owner": (pails/p [($x 17) 'app 'user 'studio 'people 'carol])

