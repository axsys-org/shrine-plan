#import records=gov/material/records

text =
  ! foil
  + utf8_span
    : offset=nat length=nat
  + observed
    \ context=grove_surface_context target=path
    ^ either[str grove_observed]
    = found context.inputs.keep((\ input (equal[path] input.dependency.p target)))
    ? !(eq found.len 1) (./err "The selected native material is outside this binding.")
    | ./ok found.at(0)
  + card
    \ context=grove_surface_context target=path
    ^ either[str myth]
    < input (text/observed context target)
    ?> (./some card) (records/card input) (./err "The native record is unresolved.")
    | ./ok card
  + source
    \ context=grove_surface_context anchor_target=path
    ^ either[str [grove_observed myth str text/utf8_span]]
    < anchor (text/card context anchor_target)
    ?> (./some held) anchor.get(['source]) (./err "Choose a source reference.")
    ?> target=pails/p held (./err "The source must be a native reference.")
    < input (text/observed context target.p)
    ? !(eq input.basis.fall(0) anchor.nat_at(['source_case] 0))
      | ./err "This passage belongs to a different source revision. Keep the old anchor or explicitly select a new passage."
    ?> (./some raw) (records/card input) (./err "The source is unavailable.")
    = content raw.txt_at(['text])
      span (text/utf8_span anchor.nat_at(['offset] 0) anchor.nat_at(['length] 0))
    ? (gt (add span.offset span.length) content.len) (./err "The selected byte range is outside the source.")
    | ./ok [input raw content span]
  + resolve
    \ anchor_target=path context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? !(equal[path] key ['excerpt]) (records/resolve context key parameters)
    < selected (text/source context anchor_target)
    = [input raw content span] selected
    | ./ok (grove_occurrence key
        (grove_focus (safe input.basis.fall(0) .x input.dependency.p) ['text] (./some span))
        .none rex/zero_span (str/cat_all ["Original UTF-8 bytes " (nat/show span.offset) " + " (nat/show span.length) "; exact retained source revision"]))
