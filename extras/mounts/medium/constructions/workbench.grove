#import records=gov/material/records
#import fields=gov/user/fields/fields
#import areas=gov/user/textarea/areas
#import tasks=gov/user/personal_work/binding

workbench =
  @slot
  #meta ;
    "/sys/lede": "Building Shrine: ordinary native material in use"
    "/sys/goo/program": (grove_surface_program workbench/render records/resolve records/prepare)
  ! foil
  + relation
    \ context=grove_surface_context target=path card=myth slot=path
    ^ weft/node
    ?> (./some held) card.get(slot) (weft/tx "")
    ?> ref=pails/p held (weft/tx "")
    = matches context.inputs.keep((\ input (equal[path] input.dependency.p ref.p)))
      name=str
        ? (eq matches.len 1) (records/card matches.at(0)).fall(myth/new).txt_at(['name])
        | path_show ref.p
    | weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path ref.p)))
        (weft/att "data-grove-key" (show/path (records/key target slot)))] [(weft/tx (str/to_atom name))]
  + task
    \ context=grove_surface_context input=grove_observed
    ^ weft/node
    = card (records/card input).fall(myth/new)
      target input.dependency.p
    | weft/el "article" [(weft/att "class" "work-item") (weft/att "data-grove-row" (show/path target))]
        [(weft/el "h2" [(weft/att "data-grove-key" (show/path (records/key target ['sys 'lede])))]
            [(weft/tx (str/to_atom (card.txt_at(['sys 'lede]))))])
         (fields/field context target card ['status] "Status")
         (areas/textarea (fields/field context target card ['next_step] "Next step"))
         (weft/el "div" [(weft/att "class" "work-relations")]
            [(workbench/relation context target card ['owner]) (weft/tx " / ") (workbench/relation context target card ['project])])
         (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Original material")])
           (weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path target)))] [(weft/tx (show/path target))])])]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < shared (records/render context)
    = inputs context.inputs.keep((\ input (tasks/targets).has(input.dependency.p)))
      html (weft/node/el "section" [(weft/att "class" "shrine-work")]
        [(weft/el "style" [] [(weft/raw ".shrine-work{width:560px;max-width:calc(100vw - 110px);color:#233f33;background:#fffdf7;border:1px solid #d9dece;border-radius:10px;box-shadow:0 10px 40px #32462c0b}.shrine-work>header{padding:24px 26px 20px;border-bottom:1px solid #e3e6d9}.shrine-work h1{font:30px Georgia,serif;margin:0 0 8px;letter-spacing:-.5px}.shrine-work header p{font-size:12px;color:#71806b;margin:0}.work-items{max-height:calc(100vh - 285px);overflow:auto;padding:0 26px 10px}.work-item{padding:22px 0;border-bottom:1px solid #e5e7dc}.work-item:last-child{border:0}.work-item h2{font-size:15px;font-weight:600;margin:0 0 12px}.work-item .person-field{display:block;margin:12px 0}.work-item .person-field>span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#7c8571;margin-bottom:5px}.work-item input,.work-item textarea{display:block;box-sizing:border-box;width:100%;font:13px/1.5 -apple-system,BlinkMacSystemFont,sans-serif;color:#294334;border:1px solid #d8dfcf;border-radius:5px;background:#f6f8ee;padding:9px 11px;resize:vertical}.work-item textarea{height:76px;min-height:66px}.work-item input:focus,.work-item textarea:focus{outline:2px solid #6b9173;outline-offset:1px;background:#fffef8}.work-relations{font-size:10px;color:#8a9681}.work-item a{color:#647f59;text-decoration:none}.work-item a:hover{text-decoration:underline}.work-item details{font:9px ui-monospace,monospace;color:#8a9582;margin-top:10px}.work-item summary{cursor:pointer;margin-bottom:5px}")])
         (weft/el "header" [] [(weft/el "h1" [] [(weft/tx "Building Shrine")])
           (weft/el "p" [] [(weft/tx "The work, its people, and the machinery we keep.")])])
         (weft/el "div" [(weft/att "class" "work-items")] inputs.map((workbench/task context)))])
    | ./ok (grove_surface_output html shared.occurrences shared.families)
