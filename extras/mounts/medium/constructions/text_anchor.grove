#import records=gov/material/records
#import fields=gov/user/fields/fields
#import areas=gov/user/textarea/areas
#import text=gov/user/text_basis/text

view =
  @slot
  #meta ;
    "/sys/lede": "A versioned text passage linked to shared native material"
    "/sys/goo/program": (grove_surface_program (view/render binding/anchor) (text/resolve binding/anchor) records/prepare)
  ! foil
  + render
    \ anchor_target=path context=grove_surface_context
    ^ either[str grove_surface_output]
    < selected (text/source context anchor_target)
    < anchor (text/card context anchor_target)
    < excerpt (text/resolve anchor_target context ['excerpt] myth/new)
    < shared (records/render context)
    ?> (./some held) anchor.get(['target]) (./err "Choose the native subject this passage concerns.")
    ?> target=pails/p held (./err "The passage target must be a native reference.")
    = [input raw content span] selected
      quote content.slice(span.offset span.length)
      html (weft/node/el "article" [(weft/att "class" "native-reading")]
        [(weft/el "style" [] [(weft/raw ".native-reading{width:600px;max-width:calc(100vw - 110px);box-sizing:border-box;background:#fffdf7;color:#294334;border:1px solid #d6ddce;border-radius:10px;padding:28px}.native-reading h1{font:29px Georgia,serif;margin:7px 0 22px}.native-reading small{font-size:10px;letter-spacing:1px;color:#7a8673;text-transform:uppercase}.native-reading blockquote{margin:0 0 22px;padding:0 0 0 18px;border-left:3px solid #89a279;font:21px/1.55 Georgia,serif}.native-reading .person-field>span{display:block;font-size:11px;color:#6e7f64;margin-bottom:7px}.native-reading textarea{box-sizing:border-box;width:100%;min-height:110px;padding:12px;border:1px solid #c9d5bd;border-radius:5px;background:#f5f8ed;color:#294334;font:14px/1.55 -apple-system,sans-serif}.native-reading a{color:#527746}.native-reading p{font-size:12px;line-height:1.6}.native-reading summary{cursor:pointer;font:11px -apple-system,sans-serif;color:#728365;margin-top:22px}.native-reading pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:220px;overflow:auto;font:11px/1.5 ui-monospace,monospace;background:#f1f4e8;padding:14px}.native-reading .provenance{font-size:10px;color:#7a8673;overflow-wrap:anywhere}")])
         (weft/el "small" [] [(weft/tx "From your file · native text")])
         (weft/el "h1" [] [(weft/tx "A passage in the shared world")])
         (weft/el "blockquote" [(weft/att "data-grove-key" "/excerpt")] [(weft/tx (str/to_atom quote))])
         (areas/textarea (fields/field context anchor_target anchor ['annotation] "Your working note"))
         (weft/el "p" [] [(weft/tx "Connected to ")
           (weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path target.p)))
             (weft/att "data-grove-key" (show/path (records/key anchor_target ['target])))] [(weft/tx "its existing native subject")])])
         (weft/el "p" [(weft/att "class" "provenance")]
           [(weft/tx (str/to_atom (str/cat_all ["UTF-8 · " (nat/show content.len) " bytes · SHA-256 " raw.txt_at(['sha256])])) )])
         (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Original source and provenance")])
           (weft/el "pre" [(weft/att "data-grove-key" (show/path (records/key input.dependency.p ['text])))] [(weft/tx (str/to_atom content))])
           (weft/el "p" [(weft/att "class" "provenance")] [(weft/tx (str/to_atom anchor.txt_at(['provenance])))])])])
    | ./ok (grove_surface_output html shared.occurrences.snoc(excerpt) shared.families)

binding =
  ! foil
  + anchor
    ^ path
    [($x 17) 'app 'user 'ingestion 'anchor]

"/view" =
  @tree
  "/sys/lede": "An anchored passage"
  "/sys/goo/surface": (grove_surface_binding (safe 2 .x [($x 17) 'gov 'user 'text_anchor 'view])
    [(dep .x [($x 17) 'app 'user 'ingestion 'raw]) (dep .x binding/anchor)]
    [(grove_slot_scope binding/anchor [['annotation]])])
