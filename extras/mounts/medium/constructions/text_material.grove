"/anchor" =
  @tree
  "/sys/lede": "Ingestion principle"
  "/source": (pails/p [($x 17) 'app 'user 'ingestion 'raw])
  "/source_case": (pails/n 1)
  "/target": (pails/p [($x 17) 'app 'user 'personal 'project])
  "/annotation": "Keep raw evidence separate from optional interpretation. Shared native identity is the connection."
  "/provenance": "Explicit passage selected from the user-supplied ingestion specification; linked to the existing Shrine project."
  "/offset": (pails/n 11914)
  "/length": (pails/n 238)
