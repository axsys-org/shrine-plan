#import records=gov/material/records

files =
  ! foil
  + artifact
    : id=str name=str media=str digest=str size=nat bytes=str text=str decoded=bool
  + collection
    : items=row[files/artifact]
  + selection
    : artifact=str field=path
  + target
    ^ path
    [($x 17) 'app 'user 'files 'originals]
  + card
    \ context=grove_surface_context
    ^ either[str myth]
    = inputs context.inputs.keep((\ input (equal[path] input.dependency.p files/target)))
    ? !(eq inputs.len 1) (./err "The file collection is outside this binding.")
    ?> (./some card) (records/card inputs.at(0)) (./err "The file collection is unavailable.")
    | ./ok card
  + items
    \ card=myth
    ^ row[files/artifact]
    ?> (./some held) card.get(['originals]) []
    ?> data=files/collection held []
    | data.items
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    < card (files/card context)
    ? (equal[path] key ['attach])
      | ./ok (grove_occurrence key (grove_focus (safe 0 .x files/target) ['originals] .none)
          (./some context.implementation.path.snoc('prepare)) rex/zero_span "Retain the supplied original bytes without interpretation")
    = matches (files/items card).keep((\ item (equal[path] key [($tu (str/to_atom item.id))])))
    ? !(eq matches.len 1) (./err "This artifact is not in the displayed file collection.")
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x files/target) ['originals] (./some (files/selection matches.at(0).id ['text])))
        .none rex/zero_span "Original artifact identity and its faithful UTF-8 decoding; no semantic interpretation")
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence args=myth
    ^ either[str grove_change_plan]
    ? !(equal[path] occurrence.key ['attach]) (./err "Original artifacts are immutable.")
    < before (files/card context)
    = id args.txt_at(['id])
      name args.txt_at(['name])
      bytes args.txt_at(['bytes])
      items (files/items before)
    ? ((eq id "") || (eq name "") || (gt name.len 300) || (gt bytes.len 350000) || (gt (args.txt_at(['text])).len 32768)) (./err "Attach one file of at most 256 KiB with its original name.")
    ? (row/any[files/artifact] (\ item=files/artifact (eq item.id id)) items) (./err "This artifact was already retained.")
    = file (files/artifact id name (args.txt_at(['media])) (args.txt_at(['digest])) (args.nat_at(['size] 0)) bytes (args.txt_at(['text])) (eq (args.txt_at(['decoded])) "yes"))
      after before.put(['originals] (files/collection items.snoc(file)))
    | ./ok (grove_change_plan [(grove_record_edit files/target (./some before) (./some after))] [])
