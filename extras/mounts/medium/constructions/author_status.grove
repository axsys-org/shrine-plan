#import work=gov/user/author_work/work

status =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program status/render work/resolve work/prepare)
  ! foil
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (work/card context)
    < cancel (work/resolve context ['cancel] myth/new)
    = state card.txt_at(['state])
      result card.txt_at(['result])
      label=nat (? (eq state "working") "Working in your world" (? (eq state "done") "Result" (? (eq state "unresolved") "Needs attention" "Ready")))
      link=row[weft/node]
        ? (eq result "") []
        [(weft/el "a" [(weft/att "href" (weft/cat2 "/?subject=" (str/to_atom result)))] [(weft/tx "Open result on canvas ↗")])]
      html (weft/node/el "section" [(weft/att "class" "local-native-work")]
        [(weft/el "style" [] [(weft/raw ".local-native-work{padding:12px 0 0;border-top:1px solid #e5ebde;color:#40533e}.local-native-work h3{font:600 11px -apple-system,sans-serif;color:#78916a;margin:0 0 10px}.local-native-work p{font:12px/1.7 -apple-system,sans-serif;white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 16px}.local-native-work a{display:block;background:#edf4e6;color:#3c633d;text-decoration:none;font:500 12px -apple-system,sans-serif;padding:10px 12px;border-radius:6px}.local-native-work button{border:0;background:transparent;color:#8b9683;font-size:10px;padding:8px 0}")])
         (weft/el "h3" [] [(weft/tx label)])
         (weft/el "p" [(weft/att "role" "status")] [(weft/tx (str/to_atom (card.txt_at(['reply]))))])
         (weft/el "div" [] link)
         (weft/el "button" [(weft/att "data-grove-key" "/cancel") (weft/att "data-grove-act" "click")] [(weft/tx "Stop request")])])
    | ./ok (grove_surface_output html [cancel] [[]])

"/surface" =
  @tree
  "/sys/lede": "Work here"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'author_status 'status])
    [(dep .x work/target)]
    [(grove_slot_scope work/target [['request] ['generation] ['state] ['reply] ['result]])])
