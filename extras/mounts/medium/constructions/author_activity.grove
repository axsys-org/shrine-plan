#import records=gov/material/records

activity =
  ! foil
  + event
    : id=str operation=str subject=path state=str detail=str
  + log
    : generation=nat events=row[activity/event]
  + target
    ^ path
    [($x 17) 'app 'user 'author 'work]
  + card
    \ context=grove_surface_context
    ^ either[str myth]
    = inputs context.inputs.keep((\ input (equal[path] input.dependency.p activity/target)))
    ? !(eq inputs.len 1) (./err "Author activity is outside this binding.")
    ?> (./some card) (records/card inputs.at(0)) (./err "Author activity is unavailable.")
    | ./ok card
  + events
    \ card=myth
    ^ row[activity/event]
    ?> (./some held) card.get(['activity]) []
    ?> log=activity/log held []
    ? !(eq log.generation (card.nat_at(['generation] 0))) []
    | log.events
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? !(equal[path] key ['step]) (./err "Unknown factual activity action.")
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x activity/target) ['activity] .none)
        (./some context.implementation.path.snoc('prepare)) rex/zero_span "Record an actual native tool attempt and its result")
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence args=myth
    ^ either[str grove_change_plan]
    < before (activity/card context)
    ?> (./some generation) (nat/parse (args.txt_at(['generation]))) (./err "Activity needs its request generation.")
    ? !(eq generation (before.nat_at(['generation] 0))) (./err "A newer request replaced this activity.")
    ?> (./some subject) (path_parse (args.txt_at(['subject]))) (./err "Activity needs an exact target.")
    = id args.txt_at(['id])
      state args.txt_at(['state])
    ? !((eq state "working") || (eq state "ok") || (eq state "failed")) (./err "Unknown tool outcome.")
    = events (activity/events before).keep((\ item !(eq item.id id)))
      recent events.drop((? (gt events.len 79) (sub events.len 79) 0))
      event (activity/event id (args.txt_at(['operation])) subject state (args.txt_at(['detail])))
      after before.put(['activity] (activity/log generation recent.snoc(event)))
    | ./ok (grove_change_plan [(grove_record_edit activity/target (./some before) (./some after))] [])
