#import records=gov/material/records
#import notes=gov/user/workbench/workbench
#import writer=gov/user/author_view/view
#import work=gov/user/author_work/work
#import tasks=gov/user/personal_work/binding

desk =
  @slot
  #meta ;
    "/sys/lede": "Work and construction in the same native place"
    "/sys/goo/program": (grove_surface_program desk/render desk/resolve desk/prepare)
  ! foil
  + is_work
    \ key=path
    ^ bool
    | ((equal[path] key ['request]) || (equal[path] key ['cancel]) || (equal[path] key ['progress]))
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? (desk/is_work key) (work/resolve context key parameters)
    | records/resolve context key parameters
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    ? (desk/is_work occurrence.key) (work/prepare context occurrence arguments)
    | records/prepare context occurrence arguments
  + link
    \ label=nat target=path
    ^ weft/node
    | weft/el "a" [(weft/att "href" (weft/cat2 "/?subject=" (show/path target)))] [(weft/tx label)]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < material (notes/render context)
    < author (writer/render context)
    = html (weft/node/el "main" [(weft/att "class" "personal-desk")]
      [(weft/el "style" [] [(weft/raw ".personal-desk{width:1080px;max-width:calc(100vw - 110px);color:#294334}.personal-desk>header{margin:0 0 20px}.personal-desk>header h1{font:37px Georgia,serif;letter-spacing:-1px;margin:0 0 8px}.personal-desk>header p{font:13px/1.6 -apple-system,sans-serif;color:#71806b;margin:0}.personal-desk nav{display:flex;gap:18px;flex-wrap:wrap;margin:15px 0}.personal-desk nav a{color:#4c7355;font:12px -apple-system,sans-serif;text-decoration:none;border-bottom:1px solid #aebfa3;padding-bottom:3px}.personal-columns{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:24px;align-items:start}.personal-desk .shrine-work,.personal-desk .native-author{box-sizing:border-box;width:100%;max-width:100%}.personal-desk .work-items{max-height:520px}.personal-desk .native-author input{font:14px/1.5 -apple-system,sans-serif}.personal-desk .native-author h1{font-size:25px}.personal-desk .native-author small{display:block;margin-top:10px;font-size:10px}.personal-desk .native-author button{border:0;background:transparent;color:#7c8571;padding:0;cursor:pointer}.personal-desk .native-author p{overflow-wrap:anywhere}.personal-desk .shrine-work h1{font-size:26px}@media(max-width:850px){.personal-columns{display:flex;flex-direction:column}.personal-desk .native-author{order:-1}.personal-desk .work-items{max-height:430px}.personal-desk>header h1{font-size:31px}}")])
       (weft/el "header" [] [(weft/el "h1" [] [(weft/tx "Your working world")])
         (weft/el "p" [] [(weft/tx "Use what is here. Make the next piece from it.")])
         (weft/el "nav" []
           [(desk/link "People & time" [($x 17) 'app 'user 'workspace 'home])
            (desk/link "Import a contact" [($x 17) 'app 'user 'inbox 'review])
            (desk/link "Original work" [($x 17) 'app 'user 'personal 'work])])])
       (weft/el "div" [(weft/att "class" "personal-columns")] [material.html author.html])])
    | ./ok (grove_surface_output html material.occurrences.weld(author.occurrences) material.families)

binding =
  ! foil
  + use
    ^ grove_surface_binding
    = refs (tasks/targets).weld([[($x 17) 'app 'user 'personal 'me]
                               [($x 17) 'app 'user 'personal 'project] work/target])
      writes (tasks/targets).map((\ at (grove_slot_scope at [['status] ['next_step]])))
    | grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'desk 'desk])
        refs.map((\ at (dep .x at)))
        writes.snoc((grove_slot_scope work/target [['request] ['generation] ['state] ['reply] ['result]]))

"/home" =
  @tree
  "/sys/lede": "Your working world"
  "/sys/goo/surface": binding/use
