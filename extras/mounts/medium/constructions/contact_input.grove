#import contact=gov/user/contact_ops/contact

"/contact" =
  @tree
  "/sys/lede": "alice.json · synthetic source"
  "/filename": "alice.json"
  "/text": "{
              ""person"": {
                ""name"": ""Alice M. Moreno"",
                ""email"": ""alice@example.invalid"",
                ""team"": ""Field research""
              },
              ""note"": ""Synthetic contact details for the shared native studio""
            }
            "

"/review" =
  @tree
  "/sys/lede": "Incoming contact detail"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'contact_view 'view])
    [(dep .x contact/target) (dep .x contact/input)]
    [(grove_slot_scope contact/target [['name] ['email]])])
