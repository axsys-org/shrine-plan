#import history=gov/user/author_history/history
#import records=gov/material/records

work =
  ! foil
  + target
    ^ path
    [($x 17) 'app 'user 'author 'work]
  + card
    \ context=grove_surface_context
    ^ either[str myth]
    = matches context.inputs.keep((\ input (equal[path] input.dependency.p work/target)))
    ? !(eq matches.len 1) (./err "The work request is outside this binding.")
    ?> (./some card) (records/card matches.at(0)) (./err "The request is unavailable.")
    | ./ok card
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    = slot=path (? (equal[path] key ['request]) ['request] ['state])
    ? !((equal[path] key ['request]) || (equal[path] key ['progress]) || (equal[path] key ['cancel]))
      | ./err "Unknown work action."
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x work/target) slot .none)
        (./some context.implementation.path.snoc('prepare)) rex/zero_span "Native authoring request and factual progress")
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    < before (work/card context)
    < after (work/change before occurrence arguments)
    = retained
        ? (equal[path] occurrence.key ['cancel])
          = cancelled (history/remember before after.put(['generation] (pails/n (before.nat_at(['generation] 0)))))
          | cancelled.put(['generation] (pails/n (after.nat_at(['generation] 0))))
        | history/remember before after
    | ./ok (grove_change_plan [(grove_record_edit work/target (./some before) (./some retained))] [(./ok [])])
  + change
    \ before=myth occurrence=grove_occurrence arguments=myth
    ^ either[str myth]
    = generation before.nat_at(['generation] 0)
    ? (equal[path] occurrence.key ['request])
      = request arguments.txt_at(['value])
      ? ((eq request.len 0) || (gt request.len 6000)) (./err "Write a bounded request.")
      | ./ok before.put(['request] (pails/t request)).put(['prompt] (pails/t (arguments.txt_at(['prompt])))).put(['flow] (pails/t (arguments.txt_at(['flow])))).put(['material] (pails/t "")).put(['label] (pails/t "")).put(['generation] (pails/n generation.inc)).put(['state] (pails/t "requested")).put(['reply] (pails/t "Looking through the native world…")).put(['result] (pails/t ""))
    ? (equal[path] occurrence.key ['cancel])
      | ./ok before.put(['generation] (pails/n generation.inc)).put(['state] (pails/t "cancelled")).put(['reply] (pails/t "Cancelled. Completed native material remains inspectable."))
    ? !(eq (arguments.nat_at(['generation] 0)) generation) (./err "A newer request replaced this work.")
    = next_state arguments.txt_at(['state])
    ? !((eq next_state "working") || (eq next_state "done") || (eq next_state "unresolved"))
      | ./err "Unknown progress state."
    = material arguments.txt_at(['material])
      label arguments.txt_at(['label])
      before (? (eq material.len 0) before before.put(['material] (pails/t material)).put(['label] (pails/t label)))
      before (? (maybe/is_some (arguments.get(['result]))) before.put(['result] (pails/t (arguments.txt_at(['result])))) before)
    | ./ok before.put(['state] (pails/t next_state)).put(['reply] (pails/t (arguments.txt_at(['reply]))))
