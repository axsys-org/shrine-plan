#import tasks=gov/user/personal_work/binding

binding =
  ! foil
  + use
    ^ grove_surface_binding
    = refs (tasks/targets).weld([[($x 17) 'app 'user 'personal 'me] [($x 17) 'app 'user 'personal 'project]])
    | grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'workbench 'workbench])
        refs.map((\ at (dep .x at)))
        (tasks/targets).map((\ at (grove_slot_scope at [['status] ['next_step]])))

"/view" =
  @tree
  "/sys/lede": "Building Shrine"
  "/sys/goo/surface": binding/use
