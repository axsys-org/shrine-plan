#import places=gov/user/canvas_places/places

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render places/resolve places/prepare)
  ! foil
  + anchor
    \ item=places/anchor
    ^ weft/node
    | weft/el "button" [(weft/att "data-canvas-flow" (str/to_atom item.id)) (weft/att "data-canvas-anchor" (show/path item.subject))]
        [(weft/tx (str/to_atom item.label))]
  + occurrence
    \ item=places/occurrence
    ^ weft/node
    | weft/el "a" [(weft/att "data-canvas-occurrence" (str/to_atom item.id)) (weft/att "data-canvas-flow-id" (str/to_atom item.flow))
        (weft/att "data-canvas-subject" (show/path item.subject)) (weft/att "data-canvas-x" (str/to_atom (nat/show item.x))) (weft/att "data-canvas-y" (str/to_atom (nat/show item.y)))
        (weft/att "href" (weft/cat2 "/?subject=" (show/path item.subject)))] [(weft/tx (show/path item.subject))]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (places/card context)
    < add (places/resolve context ['new] myth/new)
    < place (places/resolve context ['place] myth/new)
    < remove (places/resolve context ['remove] myth/new)
    = html (weft/node/el "section" [(weft/att "data-canvas-arrangement" "native")]
        [(weft/el "div" [(weft/att "class" "flow-anchors")] (places/anchors card).map(view/anchor))
         (weft/el "details" [(weft/att "hidden" "hidden")]
            [(weft/el "summary" [] [(weft/tx "Native presentation placements")])
             (weft/el "div" [] (places/occurrences card).map(view/occurrence))])])
    | ./ok (grove_surface_output html [add place remove] [[]])

"/state" =
  @tree
  "/sys/lede": "My flow anchors and presentation placements"
  "/anchors": (places/anchor_list [(places/anchor "home" "My space" [($x 17) 'app 'user 'personal 'me])])
  "/occurrences": (places/occurrence_list [])

"/surface" =
  @tree
  "/sys/lede": "Flow anchors"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'canvas_places_view 'view])
    [(dep .x places/target)] [(grove_slot_scope places/target [['anchors] ['occurrences]])])
