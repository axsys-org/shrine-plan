#import gate=gov/user/author_gate/gate

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render gate/resolve gate/prepare)
  ! foil
  + text
    \ card=myth key=path
    ^ weft/node
    | weft/tx (str/to_atom (card.txt_at(key)))
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (gate/card context)
    < approve (gate/resolve context ['approve] myth/new)
    < decline (gate/resolve context ['decline] myth/new)
    = state card.txt_at(['state])
      creating (eq (card.txt_at(['operation])) "native/instantiate")
      buttons=row[weft/node]
        ? !(eq state "pending") []
        [(weft/el "button" [(weft/att "data-grove-key" "/approve") (weft/att "data-grove-act" "click")] [(weft/tx "Apply this change")])
         (weft/el "button" [(weft/att "data-grove-key" "/decline") (weft/att "data-grove-act" "click")] [(weft/tx "Decline")])]
      checked (eq (card.txt_at(['operation])) "native/commit")
      content=row[weft/node]
        ? checked
          [(weft/el "h2" [] [(weft/tx "Review this step")])
           (weft/raw (str/to_atom (card.txt_at(['review]))))]
        [(weft/el "h2" [] [(weft/tx "Native definition change")])
         (weft/el "p" [] [(weft/tx "This older proposal has not been evaluated. Source details are below.")])]
      html (weft/node/el "section" [(weft/att "class" "construction-review")]
        content.weld(
          [(weft/el "details" [(weft/att "class" "proposal-inspection")]
             [(weft/el "summary" [] [(weft/tx "Inspect exact definition and checks")])
              (weft/el "code" [] [(view/text card ['target])])
              (weft/el "p" [] [(view/text card ['basis])])
              (weft/el "p" [] [(view/text card ['coverage])])
              (weft/el "pre" [] [(view/text card ['after])])])
           (weft/el "div" [(weft/att "class" "proposal-decisions")] buttons)
           (weft/el "p" [(weft/att "role" "status")] [(view/text card ['outcome])])]))
    | ./ok (grove_surface_output html [approve decline] [[]])

"/proposal" =
  @tree
  "/sys/lede": "Agent construction proposal"
  "/state": "idle"

"/surface" =
  @tree
  "/sys/lede": "Review proposed construction"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'author_gate_view 'view])
    [(dep .x gate/target)]
    [(grove_slot_scope gate/target [['state] ['id] ['operation] ['target] ['body] ['before] ['after] ['basis] ['template] ['version] ['outcome] ['review] ['coverage]])])
