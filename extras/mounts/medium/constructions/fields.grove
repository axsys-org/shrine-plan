#import records=gov/material/records

fields =
  ! foil
  + field
    \ context=grove_surface_context target=path card=myth slot=path label=nat
    ^ weft/node
    ?> (./some held) card.get(slot) (weft/el "p" [] [(weft/tx "Missing field")])
    | weft/el "label" [(weft/att "class" "person-field")]
        [(weft/el "span" [] [(weft/tx label)]) (records/cell context target (mop/kv[path pail] slot held))]
