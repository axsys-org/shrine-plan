history =
  ! foil
  + turn
    : generation=nat prompt=str flow=str state=str reply=str result=str material=str label=str
  + history
    : items=row[history/turn]
  + turns
    \ card=myth
    ^ row[history/turn]
    ?> (./some held) card.get(['turns]) []
    ?> history=history/history held []
    | history.items
  + remember
    \ before=myth after=myth
    ^ myth
    = generation after.nat_at(['generation] 0)
      item (history/turn generation (after.txt_at(['prompt])) (after.txt_at(['flow])) (after.txt_at(['state]))
        (after.txt_at(['reply])) (after.txt_at(['result])) (after.txt_at(['material])) (after.txt_at(['label])))
      turns (history/turns before)
      found turns.any((\ turn (eq turn.generation generation)))
      turns=row[history/turn] (? found turns.map((\ turn=history/turn (? (eq turn.generation generation) item turn))) turns.snoc(item))
    | after.put(['turns] (history/history turns))
