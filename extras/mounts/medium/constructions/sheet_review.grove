#import original=gov/user/learned_5_6e746297/sheet/binding
#import review=gov/user/change_review/review
#import presentation=gov/user/change_review_view/presentation

surface =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program
      (presentation/render selection/origin selection/draft)
      (review/resolve selection/origin selection/draft)
      (review/prepare selection/origin selection/draft))

selection =
  ! foil
  + origin
    ^ path
    [($x 17) 'app 'user 'learned_5_6e746297 'view]
  + draft
    ^ path
    [($x 17) 'app 'user 'sheet_review 'draft]
  + use
    ^ grove_surface_binding
    = base original/use
    | grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'sheet_review 'surface])
        base.reads.weld([(dep .x selection/origin) (dep .x base.implementation.path) (dep .x selection/draft)])
        base.writes.snoc((grove_slot_scope selection/draft [['pending] ['state]]))

"/draft" =
  @tree
  "/sys/lede": "Proposed spreadsheet changes"
  "/state": "idle"

"/surface" =
  @tree
  "/sys/lede": "Review spreadsheet changes"
  "/sys/goo/surface": selection/use
