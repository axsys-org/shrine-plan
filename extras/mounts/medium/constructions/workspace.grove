#import people=gov/user/people/people
#import temporal=gov/user/temporal_view/view
#import behavior=gov/user/temporal_context/temporal
#import identities=gov/user/people_views/bindings
#import schedule=gov/user/temporal_views/binding

desk =
  @slot
  #meta ;
    "/sys/lede": "A workspace composed from existing native presentations"
    "/sys/goo/program": (grove_surface_program desk/render behavior/resolve behavior/prepare)
  ! foil
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    = personal context.inputs.keep((\ input (identities/members).has(input.dependency.p)))
      person_context (grove_surface_context context.subject personal context.viewport context.implementation context.writes)
    < persons (people/render person_context)
    < line (temporal/render .false context)
    < next (temporal/render .true context)
    = html (weft/node/el "section" [(weft/att "class" "native-desk")]
        [(weft/el "style" [] [(weft/raw ".native-desk{width:1120px;max-width:calc(100vw - 110px);color:#294236}.native-desk>header{margin:0 0 20px}.native-desk>header h1{font:36px Georgia,serif;margin:0}.native-desk>header p{margin:6px 0;color:#758171;font-size:12px}.desk-columns{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}.native-desk .people-board,.native-desk .temporal{width:100%;padding:24px}.native-desk .people-board h1,.native-desk .temporal h1{font-size:23px}.native-desk .person{padding:12px 0 12px 28px}.native-desk .person-field span{width:65px}.native-desk .person small{font-size:8px}.native-desk svg{max-width:100%;height:auto}.desk-left{display:grid;gap:20px}@media(max-width:850px){.desk-columns{grid-template-columns:1fr}.native-desk{width:460px}}")])
         (weft/el "header" [] [(weft/el "h1" [] [(weft/tx "A working world")])
           (weft/el "p" [] [(weft/tx "People, work and time. Shared native material · synthetic study.")])])
         (weft/el "div" [(weft/att "class" "desk-columns")]
           [(weft/el "div" [(weft/att "class" "desk-left")] [persons.html next.html]) line.html])])
    | ./ok (grove_surface_output html line.occurrences line.families)

binding =
  ! foil
  + make
    ^ grove_surface_binding
    = original (schedule/use [($x 17) 'gov 'user 'workspace 'desk])
      writing (identities/members).map((\ at (grove_slot_scope at [['name] ['email] ['role]])))
    | grove_surface_binding original.implementation original.reads original.writes.weld(writing)

"/home" =
  @tree
  "/sys/lede": "A working world"
  "/sys/goo/surface": binding/make
