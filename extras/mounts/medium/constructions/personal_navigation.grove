#import records=gov/material/records

navigation =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program navigation/render records/resolve records/prepare)
  ! foil
  + target
    ^ path
    [($x 17) 'app 'user 'personal 'home]
  + entry
    \ label=nat slot=path card=myth
    ^ weft/node
    ?> (./some held) card.get(slot) (weft/tx "")
    ?> ref=pails/p held (weft/tx "")
    | weft/el "a" [(weft/att "href" (weft/cat2 "/?subject=" (show/path ref.p)))
        (weft/att "data-grove-key" (show/path (records/key navigation/target slot)))] [(weft/tx label)]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < shared (records/render context)
    = card (records/card context.inputs.at(0)).fall(myth/new)
      html (weft/node/el "div" [(weft/att "class" "personal-navigation")]
        [(weft/el "style" [] [(weft/raw ".personal-navigation a{display:block;padding:9px 12px;color:#687e5b;text-decoration:none;border-radius:5px;font:12px -apple-system,sans-serif}.personal-navigation a:hover{background:#edf2e5}.personal-navigation a:before{content:'◇';margin-right:12px;color:#a0ae91}")])
         (navigation/entry "Me" ['me] card)
         (navigation/entry "Files" ['files] card)])
    | ./ok (grove_surface_output html shared.occurrences shared.families)

"/surface" =
  @tree
  "/sys/lede": "My things"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'personal_navigation 'navigation])
    [(dep .x navigation/target)] [])
