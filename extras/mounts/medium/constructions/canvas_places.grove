#import records=gov/material/records

places =
  ! foil
  + anchor
    : id=str label=str subject=path
  + occurrence
    : id=str flow=str subject=path x=nat y=nat
  + anchor_list
    : items=row[places/anchor]
  + occurrence_list
    : items=row[places/occurrence]
  + target
    ^ path
    [($x 17) 'app 'user 'canvas_places 'state]
  + card
    \ context=grove_surface_context
    ^ either[str myth]
    = inputs context.inputs.keep((\ input (equal[path] input.dependency.p places/target)))
    ? !(eq inputs.len 1) (./err "The workspace arrangement is outside this binding.")
    ?> (./some card) (records/card inputs.at(0)) (./err "The workspace arrangement is unavailable.")
    | ./ok card
  + anchors
    \ card=myth
    ^ row[places/anchor]
    ?> (./some value) card.get(['anchors]) []
    ?> found=places/anchor_list value []
    | found.items
  + occurrences
    \ card=myth
    ^ row[places/occurrence]
    ?> (./some value) card.get(['occurrences]) []
    ?> found=places/occurrence_list value []
    | found.items
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    = keys=row[path] [['new] ['place] ['remove]]
    ? !(keys.has(key)) (./err "Unknown arrangement action.")
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x places/target) (? (equal[path] key ['new]) ['anchors] ['occurrences]) .none)
        (./some context.implementation.path.snoc('prepare)) rex/zero_span "Place a view without moving or copying its native subject")
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence args=myth
    ^ either[str grove_change_plan]
    < before (places/card context)
    < after (places/change before occurrence.key args)
    | ./ok (grove_change_plan [(grove_record_edit places/target (./some before) (./some after))] [])
  + change
    \ before=myth key=path args=myth
    ^ either[str myth]
    = anchors (places/anchors before)
      occurrences (places/occurrences before)
      id args.txt_at(['id])
      flow args.txt_at(['flow])
    ? ((eq id "") || (gt id.len 120)) (./err "This placement needs a stable occurrence identity.")
    ? (equal[path] key ['new])
      = label args.txt_at(['label])
      ? ((eq label "") || (gt label.len 100)) (./err "Give this flow a short name.")
      ? (row/any[places/anchor] (\ item=places/anchor (eq item.id id)) anchors) (./err "This anchor already exists.")
      ?> (./some subject) (path_parse (args.txt_at(['subject]))) (./err "Choose an exact native anchor.")
      | ./ok before.put(['anchors] (places/anchor_list anchors.snoc((places/anchor id label subject))))
    ? !(row/any[places/anchor] (\ item=places/anchor (eq item.id flow)) anchors) (./err "The flow anchor no longer exists.")
    = prior occurrences.keep((\ item (eq item.id id)))
    ? (row/any[places/occurrence] (\ item=places/occurrence !(eq item.flow flow)) prior) (./err "An occurrence cannot silently move to another flow.")
    ? (equal[path] key ['remove])
      | ./ok before.put(['occurrences] (places/occurrence_list occurrences.keep((\ item !(eq item.id id)))))
    ?> (./some subject) (path_parse (args.txt_at(['subject]))) (./err "A view requires an exact native subject.")
    ? (row/any[places/occurrence] (\ item=places/occurrence !(equal[path] item.subject subject)) prior) (./err "An existing occurrence cannot silently change subject.")
    = item (places/occurrence id flow subject (args.nat_at(['x] 0)) (args.nat_at(['y] 0)))
    | ./ok before.put(['occurrences] (places/occurrence_list occurrences.keep((\ item !(eq item.id id))).snoc(item)))
