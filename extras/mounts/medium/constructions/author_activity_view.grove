#import activity=gov/user/author_activity/activity

view =
  @slot
  #meta ;
    "/sys/goo/program": (grove_surface_program view/render activity/resolve activity/prepare)
  ! foil
  + label
    \ operation=str
    ^ nat
    ? (eq operation "native/discover") "Read material"
    ? (eq operation "native/source") "Read definition"
    ? (eq operation "native/frame") "Evaluate presentation"
    ? (eq operation "native/inspect") "Inspect correspondence"
    ? (eq operation "native/act") "Prepare a native change"
    ? (eq operation "native/author") "Compile definition"
    ? (eq operation "native/instantiate") "Construct from template"
    | "Native operation"
  + entry
    \ item=activity/event
    ^ weft/node
    | weft/el "article" [(weft/att "class" "activity-step") (weft/att "data-state" (str/to_atom item.state))]
        [(weft/el "span" [(weft/att "class" "activity-dot")] [(weft/tx (? (eq item.state "ok") "✓" (? (eq item.state "failed") "!" "◌")))])
         (weft/el "div" [] [(weft/el "strong" [] [(weft/tx (view/label item.operation))])
            (weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path item.subject))) (weft/att "title" (show/path item.subject))]
              [(weft/tx (show/iota (item.subject.at((sub item.subject.len 1)))))])
            (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Details")]) (weft/el "code" [] [(weft/tx (show/path item.subject))]) (weft/el "p" [] [(weft/tx (str/to_atom item.detail))])])])]
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < card (activity/card context)
    < step (activity/resolve context ['step] myth/new)
    = result card.txt_at(['result])
      reply card.txt_at(['reply])
      entries (activity/events card)
      link=row[weft/node]
        ? (eq result "") []
        [(weft/el "a" [(weft/att "class" "activity-result") (weft/att "href" (weft/cat2 "/?subject=" (str/to_atom result))) (weft/att "data-canvas-result" (str/to_atom result))] [(weft/tx "Show the result here ↗")])]
      html (weft/node/el "section" [(weft/att "class" "native-activity")]
        [(weft/el "style" [] [(weft/raw ".native-activity{font:12px/1.6 -apple-system,sans-serif;color:#3a543c}.native-activity .activity-state{font:600 10px -apple-system,sans-serif;text-transform:uppercase;letter-spacing:1px;color:#789366}.native-activity .activity-reply{line-height:1.8;margin:12px 0 18px;white-space:pre-wrap}.native-activity .activity-result{display:block;padding:10px 12px;background:#eaf1e3;border-radius:5px;color:#42653d;text-decoration:none;font-weight:500}.activity-step{display:flex;gap:12px;padding:14px 0;border-top:1px solid #e6ecdf}.activity-step .activity-dot{color:#81996a;width:14px;flex:none}.activity-step[data-state=failed] .activity-dot{color:#b36b40}.activity-step strong{display:block;font-size:11px;font-weight:500}.activity-step a{display:block;font-size:11px;color:#789069;text-decoration:none}.activity-step details{font-size:10px;color:#94a187;margin-top:4px}.activity-step summary{cursor:pointer}.activity-step code{display:block;font-size:9px;overflow-wrap:anywhere;margin-top:8px}.activity-step p{font-size:10px;overflow-wrap:anywhere;color:#9a7052}.native-activity>details{margin-top:20px;color:#809273}.native-activity>details>summary{font-size:11px;cursor:pointer}")])
         (weft/el "span" [(weft/att "class" "activity-state")] [(weft/tx (str/to_atom (card.txt_at(['state]))))])
         (weft/el "p" [(weft/att "class" "activity-reply") (weft/att "data-native-reply" "true")] [(weft/tx (str/to_atom reply))])
         (weft/el "div" [] link)
         (weft/el "details" [(weft/att "open" "open")] [(weft/el "summary" [] [(weft/tx "Native activity")]) (weft/el "div" [] entries.map(view/entry))])])
    | ./ok (grove_surface_output html [step] [[]])

"/surface" =
  @tree
  "/sys/lede": "Agent activity"
  "/sys/goo/surface": (grove_surface_binding (safe 1 .x [($x 17) 'gov 'user 'author_activity_view 'view])
    [(dep .x activity/target)] [(grove_slot_scope activity/target [['activity]])])
