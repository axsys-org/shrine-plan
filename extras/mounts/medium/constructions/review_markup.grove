#import records=gov/material/records

markup =
  ! foil
  + value
    \ held=maybe[pail]
    ^ nat
    ?> (./some value) held "Absent"
    | str/to_atom (records/display value)
  + field
    \ edit=grove_record_edit entry=mop/kv[path pail]
    ^ weft/node
    = before edit.before.fall(myth/new)
      after edit.after.fall(myth/new)
    | weft/el "div" [(weft/att "class" "change-field")
        (weft/att "data-grove-key" (show/path (records/key edit.target entry.key)))]
      [(weft/el "code" [] [(weft/tx (show/path entry.key))])
       (weft/el "div" [(weft/att "class" "change-values")]
         [(weft/el "del" [] [(weft/tx (markup/value before.get(entry.key)))])
          (weft/el "span" [(weft/att "aria-hidden" "true")] [(weft/tx "→")])
          (weft/el "ins" [] [(weft/tx (markup/value after.get(entry.key)))])])]
  + edit
    \ change=grove_record_edit
    ^ weft/node
    = before change.before.fall(myth/new)
      after change.after.fall(myth/new)
      changed before.meld(after).tap.keep((\ entry !(equal before.get(entry.key) after.get(entry.key))))
    | weft/el "article" [(weft/att "class" "change-record")]
      [(weft/el "h3" [] [(weft/tx (str/to_atom (before.txt_at(['sys 'lede]))))])
       (weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path change.target)))] [(weft/tx (show/path change.target))])
       (weft/el "div" [] changed.map((markup/field change)))]
  + read
    \ entry=[dep maybe[nat]]
    ^ weft/node
    = [dependency basis] entry
    | weft/el "li" [] [(weft/tx (show/path dependency.p))
        (weft/tx (weft/cat2 " · case " (str/to_atom (basis.run(nat/show).fall("unknown")))))]
  + button
    \ key=nat label=nat
    ^ weft/node
    | weft/el "button" [(weft/att "data-grove-key" key) (weft/att "data-grove-act" "click")] [(weft/tx label)]
