- fit_store
- testing
- tests/grove_install [at=fixture]

+ fit_store_checks
  + call
    \ state=namespace operation=str event=str body=str
    ^ [namespace nat]
    = request (interaction_runtime/request [state.self 'app 'user 'arrangement] "administrator" operation 0 event body)
      [next index status response] (fit_store/handle request state (sovereign_hive state))
    [next status]
  + edits
    \ ignored=unit
    ^ row[testing/check]
    = original (fixture/grove_install_checks/bootstrap [])
      first=str "{""expected"":null,""block"":{""id"":""a"",""kind"":""card"",""revision"":1,""parent"":"""",""rect"":{""x"":16,""y"":16,""w"":240,""h"":120},""content"":[{""id"":""a-text"",""text"":""Sam · Fri""}]}}"
      move=str "{""expected"":1,""block"":{""id"":""a"",""kind"":""card"",""revision"":2,""parent"":"""",""rect"":{""x"":320,""y"":16,""w"":240,""h"":120},""content"":[{""id"":""a-text"",""text"":""Sam · Fri""}]}}"
      [created code] (fit_store_checks/call original "fit/block" "create-a" first)
      [replayed replay_code] (fit_store_checks/call created "fit/block" "create-a" first)
      [reused reused_code] (fit_store_checks/call created "fit/block" "create-a" move)
      [moved move_code] (fit_store_checks/call created "fit/block" "move-a" move)
      [conflict conflict_code] (fit_store_checks/call moved "fit/block" "stale-a" move)
      [undone undo_code] (fit_store_checks/call moved "fit/undo" "undo-a" "{""event"":""move-a""}")
    [(testing/nat "block persists in native material" 200 code)
     (testing/nat "duplicate delivery succeeds" 200 replay_code)
     (testing/nat "duplicate delivery preserves exact world" 1 (equal created replayed))
     (testing/nat "event identity cannot change meaning" 409 reused_code)
     (testing/nat "reused event preserves exact world" 1 (equal created reused))
     (testing/nat "move succeeds" 200 move_code)
     (testing/nat "stale edit conflicts" 409 conflict_code)
     (testing/nat "conflict retains current world" 1 (equal moved conflict))
     (testing/nat "undo succeeds" 200 undo_code)
     (testing/nat "undo restores exact blocks" 1 (equal (fit_store/get created).blocks (fit_store/get undone).blocks))
     (testing/nat "undo advances history" 3 (fit_store/get undone).revision)]

+ tests
  ^ row[testing/case]
  [(testing/case "Native arrangement persistence and event identity" fit_store_checks/edits)]
