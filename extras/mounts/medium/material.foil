- grove_surface_wire
- overlay_cache
- native_matrix

' A native construction. It installs ordinary records and binds two occurrences
' to the same inputs and the same compiled Grove presentation. No host registry.
+ material
  + install
    \ state=namespace
    ^ either[pail namespace]
    = code=path [state.self 'gov 'material 'records]
      sum=path [state.self 'gov 'material 'sum]
      root=path [state.self 'app 'material]
      values=path root.snoc('values)
      a=path values.snoc('a)
      b=path values.snoc('b)
      cache=path root.snoc('total)
    ?> (./some version) (state.case(.x code)) (./err (pails/t "Native record presentation is not published."))
    ?> (./some sum_version) (state.case(.x sum)) (./err (pails/t "Native sum is not published."))
    = overlay=path (overlay_cache/path sum_version sum values)
      binding=grove_surface_binding (grove_surface_binding (safe version .x code)
        [(dep .x a) (dep .x b) (dep .x overlay)]
        [(grove_slot_scope a [['value]]) (grove_slot_scope b [['value]])])
      label
        \ name=str
        ^ myth
        | myth/sing ['sys 'lede] (pails/t name)
      commands=row[[path writ]]
        [[root (writ/make (label "Native material"))]
         [values (writ/make (label "Values"))]
         [a (writ/make (label "Value A").put(['value] (pails/n 12)))]
         [b (writ/make (label "Value B").put(['value] (pails/n 28)))]
         [root.snoc('working) (writ/make (label "Working surface").put(goo_runtime/surface_slot binding))]
         [root.snoc('another) (writ/make (label "Same values, another place").put(goo_runtime/surface_slot
           binding.set_reads([(dep .x b) (dep .x a) (dep .x overlay)])))]]
    ?> (./ok state) (grove_install/change_many commands state) (./err (pails/t "Native material could not be established."))
    ?> (./ok state) (overlay_cache/install cache overlay state) (./err (pails/t "Native dependency could not be established."))
    | material/matrices state
  + matrices
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'material]
      image=path root.snoc('image)
      cells=path root.snoc('cells)
      raster=path [state.self 'gov 'material 'raster]
      cellular=path [state.self 'gov 'material 'cellular]
      pixels (native_matrix/generate 24 18
        (\ x=nat y=nat (add (mul (add 90 (mul x 6)) 65536) (add (mul (add 90 (mul y 8)) 256) 130))))
      grid
        | native_matrix/generate 24 18
        \ x=nat y=nat
        ? (and (eq y 8) (and (ge x 10) (le x 12))) 0
        ? (and (eq x 12) (eq y 7)) 0
        ? (and (eq x 11) (eq y 6)) 0
        16777215
      bind
        \ target=path code=path
        ^ grove_surface_binding
        | grove_surface_binding (safe (state.case(.x code)).fall(0) .x code)
          [(dep .x target)] [(grove_slot_scope target [['matrix] ['mode]])]
      record
        \ title=str matrix=native_matrix/value[nat] ink=nat
        ^ myth
        | (myth/sing ['sys 'lede] (pails/t title)).put(['matrix] matrix).put(['mode] (pails/t "paint")).put(['ink] (pails/n ink))
      commands=row[[path writ]]
        [[image (writ/make (record "Color study" pixels 2835772))]
         [cells (writ/make (record "Cellular field" grid 0))]
         [root.snoc('image_surface) (writ/make (myth/sing goo_runtime/surface_slot (bind image raster)))]
         [root.snoc('cellular_surface) (writ/make (myth/sing goo_runtime/surface_slot (bind cells cellular)))]]
    ?> (./ok state) (grove_install/change_many commands state) (./err (pails/t "Native matrix constructions could not be established."))
    | ./ok state
