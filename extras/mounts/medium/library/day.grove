#import lede=sys/lede
#import text=lib/grove/types/text

summary =
  @slot

report =
  @slot

picture =
  @slot

day =
  @role
  %/summary: text
  %/report: text
  %/picture: text

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? (lt inputs.len 2) (./err "Connect capacity and at least one work item.")
  = amount_key=path (path_parse "NUMBER/amount").fall([])
    title_key=path (path_parse "WORK/title").fall([])
    minutes_key=path (path_parse "WORK/estimate").fall([])
    done_key=path (path_parse "WORK/caption").fall([])
  ?> (./some held) inputs.at(0).get(amount_key) (./err "Capacity needs its exact native amount slot.")
  ?> amount=pails/n held (./err "Capacity must be a native number of minutes.")
  = valid
      \ item=myth
      ^ bool
      ?> (./some title) item.get(title_key) .false
      ?> title=pails/t title .false
      ?> (./some minutes) item.get(minutes_key) .false
      ?> minutes=pails/t minutes .false
      ?> (./some value) (nat/parse minutes.t) .false
      ?> (./some done) item.get(done_key) .false
      ?> done=pails/t done .false
      | ? (eq done.t "Mark done") .true (eq done.t "Done / Reopen")
  ? !((row/all[myth] valid inputs.drop(1))) (./err "Every item must supply its original title, estimate and completion slots.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = amount_key=path (path_parse "NUMBER/amount").fall([])
    title_key=path (path_parse "WORK/title").fall([])
    minutes_key=path (path_parse "WORK/estimate").fall([])
    done_key=path (path_parse "WORK/caption").fall([])
    tasks=row[myth] inputs.drop(1)
    open=row[myth] tasks.keep((\ item=myth (eq (item.txt_at(done_key)) "Mark done")))
    remaining=nat (row/fold[myth nat] 0 (\ sum=nat item=myth (add sum ((nat/parse (item.txt_at(minutes_key))).fall(0)))) open)
    capacity=nat (inputs.at(0).nat_at(amount_key 0))
    unknown=nat (open.keep((\ item=myth (eq ((nat/parse (item.txt_at(minutes_key))).fall(0)) 0)))).len
    completed=nat (sub tasks.len open.len)
    excess=nat (sub remaining capacity)
    free=nat (sub capacity remaining)
    summary=str (str/cat_all [(nat/show remaining) " min left / " (nat/show capacity) " available. "
        (? (gt excess 0) (str/cat_all [(nat/show excess) " min over capacity."]) (str/cat_all [(nat/show free) " min spare."]))
        (? (gt unknown 0) (str/cat_all [" " (nat/show unknown) " unestimated; total is incomplete."]) "")])
  = line
      \ item=myth
      ^ str
      = amount=nat ((nat/parse (item.txt_at(minutes_key))).fall(0))
        mark=str (? (eq (item.txt_at(done_key)) "Mark done") "[ ] " "[x] ")
      | str/cat_all [mark (item.txt_at(title_key)) "  / " (? (eq amount 0) "unestimated" (str/cat_all [(nat/show amount) " min"]))]
  = report=str (str/join "\n" (tasks.map(line)))
    safe_capacity=nat (? (eq capacity 0) 1 capacity)
    ratio=nat (div (mul remaining 600) safe_capacity)
    width=nat (? (gt ratio 600) 600 ratio)
    color=str (? (gt remaining capacity) "%23bc694e" "%23527c62")
    picture=str (str/cat_all ["data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='640' height='140' viewBox='0 0 640 140'><rect width='640' height='140' rx='12' fill='%23f0f4ec'/><rect x='20' y='53' width='600' height='34' rx='6' fill='%23dce6d6'/><rect x='20' y='53' width='" (nat/show width) "' height='34' rx='6' fill='" color "'/><text x='20' y='30' font-family='sans-serif' font-size='16' fill='%23445c3d'>Remaining work</text><text x='20' y='117' font-family='sans-serif' font-size='16' fill='%23445c3d'>" (nat/show completed) " completed / " (nat/show open.len) " open</text></svg>"])
  | current.put(['sys 'lede] (pails/t "Today")).put((path_parse "DAY/remaining").fall([]) (pails/n remaining)).put((path_parse "DAY/completed").fall([]) (pails/n completed)).put((path_parse "DAY/unestimated").fall([]) (pails/n unknown)).put((path_parse "DAY/available").fall([]) (pails/n capacity)).put((path_parse "DAY/summary").fall([]) (pails/t summary)).put((path_parse "DAY/report").fall([]) (pails/t report)).put((path_parse "DAY/picture").fall([]) (pails/t picture))

surface =
  @view
  #on ; %/day
  #for ; /sys/slot/detail
  card => {
    text("Today", "title")
    text(card.summary, "body")
    image(card.picture)
    code(card.report)
    text("These are the original work items. Edit them to change this view.", "caption")
  }
