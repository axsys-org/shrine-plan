#import text=lib/grove/types/text

term =
  @slot

meaning =
  @slot

entry =
  @role
  %/term: text
  %/meaning: text

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "An entry owns its text.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = tkey=path (path_parse "ENTRY/term").fall([])
    mkey=path (path_parse "ENTRY/meaning").fall([])
    term=str (current.txt_at(tkey))
    meaning=str (current.txt_at(mkey))
  | current.put(tkey (pails/t term)).put(mkey (pails/t meaning))

save =
  @action
  #on ; %/entry
  %/term: text
  %/meaning: text
  ! foil
  \ term=str meaning=str card=%/entry
  ^ %/entry
  | card.set_term(term).set_meaning(meaning)

surface =
  @view
  #on ; %/entry
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save, myth = {
      'ENTRY/term = .input(card.term)
      'ENTRY/meaning = .input(card.meaning)
    }) {
      input('ENTRY/term)
      input('ENTRY/meaning, "code")
      action("Save entry")
    }
  }
