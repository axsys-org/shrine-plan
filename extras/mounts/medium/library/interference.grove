#import lede=sys/lede
#import text=lib/grove/types/text

number =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[number]
    ?> wrapped=pails/n value .none
    | ./some wrapped.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

picture =
  @slot

alpha =
  @slot

beta =
  @slot

scheme =
  @slot

instrument =
  @role
  lede: text
  %/picture: text
  %/alpha: %/number
  %/beta: %/number
  %/scheme: %/number

read_number =
  ! foil
  \ record=myth
  ^ maybe[nat]
  = pairs=row[mop/kv[path pail]] record.tap
  ? !(eq pairs.len 1) .none
  ?> value=pails/n pairs.at(0).val .none
  | ./some value.n

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 2) (./err "Bind two exact numeric slots.")
  ?> (./some a) (read_number inputs.at(0)) (./err "A1 needs exactly one native numeric slot.")
  ?> (./some b) (read_number inputs.at(1)) (./err "A2 needs exactly one native numeric slot.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = pkey (path_parse "IMAGE/scheme").fall([])
    ikey (path_parse "IMAGE/picture").fall([])
    fkey (path_parse "IMAGE/alpha").fall([])
    gkey (path_parse "IMAGE/beta").fall([])
  = a (read_number inputs.at(0)).fall(0)
    b (read_number inputs.at(1)).fall(0)
    turn (mod (current.nat_at(pkey 0)) 2)
  = colors=row[str] ["%23f5efe0" "%23173f35" "%23e8742a" "%237b4bb3"]
  = cell
      \ i=nat
      ^ str
      = x (mod i 16)
        y (div i 16)
        v (mod (add (add (mul (mul x x) (add a 1)) (mul (mul y y) (add b 1))) (mul x y)) 4)
        s (mod (add (mul x b) (mul y a)) 3)
        w (sub 30 (mul s 6))
        r (div w 2)
        cx (add (mul x 40) 20)
        cy (add (mul y 40) 20)
        j (mod (add v (mul turn 2)) 4)
        paint colors.at(j)
      | str/cat_all ["<circle cx='" (nat/show cx) "' cy='" (nat/show cy) "' r='" (nat/show r) "' fill='" paint "'/>"]
  = body=str
      % i=nat 0 out=str ""
      ? (eq i 144) out
      = part (cell i)
      | _ i.inc out.cat(part)
  = svg (str/cat_all ["data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='640' height='360' viewBox='0 0 640 360'><rect width='640' height='360' fill='%231c1a17'/>" body "</svg>"])
  | current.put(['sys 'lede] (pails/t "Native image")).put(pkey (pails/n turn)).put(fkey (pails/n a)).put(gkey (pails/n b)).put(ikey (pails/t svg))

flip =
  @action
  #on ; %/instrument
  ! foil
  \ card=%/instrument
  ^ %/instrument
  | card.set_scheme((mod (add card.scheme 1) 2))

surface =
  @view
  #on ; %/instrument
  #for ; /sys/slot/detail
  card => {
    col("identity") {
      show(card.lede, '/sys/slot/title)
      image(card.picture)
      row("readout") {
        text("Live inputs", "caption")
        number(card.alpha, "value")
        number(card.beta, "value")
      }
    }
    group(on = card, action = %/flip) {
      action("Flip palette")
    }
  }
