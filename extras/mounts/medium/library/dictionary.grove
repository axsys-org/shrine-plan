#import text=lib/grove/types/text

query =
  @slot

result =
  @slot

lexicon =
  @role
  %/query: text
  %/result: text

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? (eq inputs.len 0) (./err "Connect at least one native entry.")
  = key=path (path_parse "ENTRY/term").fall([])
    meaning_key=path (path_parse "ENTRY/meaning").fall([])
  % i=nat 0
  ^ either[str unit]
  ? (eq i inputs.len) (./ok [])
  ?> (./some term) inputs.at(i).get(key) (./err "An entry has no term slot.")
  ?> term=pails/t term (./err "Terms must be text.")
  ?> (./some meaning) inputs.at(i).get(meaning_key) (./err "An entry has no meaning slot.")
  ?> meaning=pails/t meaning (./err "Meanings must be text.")
  | _ i.inc

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = tkey=path (path_parse "ENTRY/term").fall([])
    mkey=path (path_parse "ENTRY/meaning").fall([])
    qkey=path (path_parse "DICTIONARY/query").fall([])
    rkey=path (path_parse "DICTIONARY/result").fall([])
  = query=str (current.txt_at(qkey))
  = found=str
      % i=nat 0 out=str ""
      ^ str
      ? (eq i inputs.len) out
      = term=str (inputs.at(i).txt_at(tkey))
        meaning=str (inputs.at(i).txt_at(mkey))
        matches=bool (? (eq query "") .true (eq term query))
        part=str (? matches (str/cat_all [term "\n" meaning "\n\n"]) "")
      | _ i.inc out.cat(part)
  = display=str (? (eq found "") "No exact entry. Clear the search to browse." found)
  | current.put(qkey (pails/t query)).put(rkey (pails/t display))

search =
  @action
  #on ; %/lexicon
  %/query: text
  ! foil
  \ query=str card=%/lexicon
  ^ %/lexicon
  | card.set_query(query)

surface =
  @view
  #on ; %/lexicon
  #for ; /sys/slot/detail
  card => {
    text("Dictionary", "title")
    group(on = card, action = %/search, myth = {
      'DICTIONARY/query = .input(card.query)
    }) {
      input('DICTIONARY/query)
      action("Find exact term")
    }
    code(card.result)
  }
