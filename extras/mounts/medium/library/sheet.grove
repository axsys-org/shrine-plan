#import text=lib/grove/types/text

number =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[number]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

first =
  @slot

second =
  @slot

amount =
  @slot

sheet =
  @role
  %/first: %/number
  %/second: %/number
  %/amount: %/number

read_number =
  ! foil
  \ record=myth
  ^ maybe[nat]
  = pairs=row[mop/kv[path pail]] record.tap
  ? !(eq pairs.len 1) .none
  ?> value=pails/n pairs.at(0).val .none
  | ./some value.n

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 2) (./err "Bind two exact numeric slots.")
  ?> (./some a) (read_number inputs.at(0)) (./err "A1 needs exactly one native numeric slot.")
  ?> (./some b) (read_number inputs.at(1)) (./err "A2 needs exactly one native numeric slot.")
  | ./ok []

formula =
  ! foil
  \ a=nat b=nat
  ^ nat
  | add a b

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = a=nat (read_number inputs.at(0)).fall(0)
    b=nat (read_number inputs.at(1)).fall(0)
    result=nat (formula a b)
  | current.put((path_parse "SHEET/first").fall([]) (pails/n a)).put((path_parse "SHEET/second").fall([]) (pails/n b)).put((path_parse "SHEET/amount").fall([]) (pails/n result))

surface =
  @view
  #on ; %/sheet
  #for ; /sys/slot/detail
  card => {
    text("A live sheet", "title")
    row("row") {
      text("A1", "caption")
      number(card.first, "value")
    }
    row("row") {
      text("A2", "caption")
      number(card.second, "value")
    }
    row("result") {
      text("Formula result", "caption")
      number(card.amount, "value")
    }
    text("The inputs are references. The formula is native code.", "caption")
  }
