#import lede=sys/lede
#import text=lib/grove/types/text

title =
  @slot

estimate =
  @slot

caption =
  @slot

error =
  @slot

item =
  @role
  %/title: text
  %/estimate: text
  %/caption: text
  %/error: text

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "Work items take no input positions.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = tkey=path (path_parse "WORK/title").fall([])
    ekey=path (path_parse "WORK/estimate").fall([])
    ckey=path (path_parse "WORK/caption").fall([])
    xkey=path (path_parse "WORK/error").fall([])
  = title=str (current.txt_at(tkey))
    estimate=str (current.txt_at(ekey))
    error=str (current.txt_at(xkey))
    old_caption=str (current.txt_at(ckey))
  = name=str (? (eq title "") "Untitled" title)
    minutes=str (? (eq estimate "") "0" estimate)
    caption=str (? (eq old_caption "") "Mark done" old_caption)
  | current.put(tkey (pails/t name)).put(ekey (pails/t minutes)).put(ckey (pails/t caption)).put(xkey (pails/t error))

save =
  @action
  #on ; %/item
  %/title: text
  %/estimate: text
  ! foil
  \ title=str estimate=str card=%/item
  ^ %/item
  ? (eq title "") (card.set_error("Give this item a name."))
  ?> (./some minutes) (nat/parse estimate) (card.set_error("Use whole minutes; zero means unestimated."))
  ? (gt minutes 10080) (card.set_error("Use at most 10080 minutes."))
  | card.set_title(title).set_estimate((nat/show minutes)).set_error("")

toggle =
  @action
  #on ; %/item
  ! foil
  \ card=%/item
  ^ %/item
  | card.set_caption((? (eq card.caption "Mark done") "Done / Reopen" "Mark done"))

surface =
  @view
  #on ; %/item
  #for ; /sys/slot/detail
  card => {
    text(card.title, "title")
    group(on = card, action = %/toggle) {
      action(card.caption)
    }
    group(on = card, action = %/save, myth = {
      'WORK/title = .input(card.title)
      'WORK/estimate = .input(card.estimate)
    }) {
      input('WORK/title)
      row("estimate") {
        text("Minutes", "caption")
        input('WORK/estimate)
      }
      action("Save")
    }
    text(card.error, "caption")
  }
