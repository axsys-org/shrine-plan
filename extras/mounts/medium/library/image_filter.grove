#import text=lib/grove/types/text

number =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[number]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

mode =
  @slot

label =
  @slot

picture =
  @slot

filter =
  @role
  %/mode: %/number
  %/label: text
  %/picture: text

read_image =
  ! foil
  \ record=myth
  ^ maybe[str]
  = pairs=row[mop/kv[path pail]] record.tap
  ? !(eq pairs.len 1) .none
  ?> value=pails/t pairs.at(0).val .none
  ? !(eq (value.t.slice(0 24)) "data:image/svg+xml;utf8,") .none
  | ./some value.t

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 1) (./err "Bind one exact native SVG image slot.")
  ?> (./some image) (read_image inputs.at(0)) (./err "The selected value is not a native SVG data image.")
  ? (gt image.len 64000) (./err "This image exceeds the bounded filter input.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = mkey=path (path_parse "FILTER/mode").fall([])
    lkey=path (path_parse "FILTER/label").fall([])
    pkey=path (path_parse "FILTER/picture").fall([])
    mode=nat (mod (current.nat_at(mkey 0)) 4)
    image=str (read_image inputs.at(0)).fall("")
    body=str (image.slice(24 image.len))
    label=str (? (eq mode 0) "Original" (? (eq mode 1) "Grayscale" (? (eq mode 2) "Blur" "Half turn")))
    effect=str (? (eq mode 1) "filter='url(%23gray)'" (? (eq mode 2) "filter='url(%23blur)'" (? (eq mode 3) "transform='rotate(180 320 180)'" "")))
    output=str (str/cat_all ["data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='640' height='360' viewBox='0 0 640 360'><defs><filter id='gray'><feColorMatrix type='saturate' values='0'/></filter><filter id='blur'><feGaussianBlur stdDeviation='3'/></filter></defs><g " effect ">" body "</g></svg>"])
  | current.put(mkey (pails/n mode)).put(lkey (pails/t label)).put(pkey (pails/t output))

next =
  @action
  #on ; %/filter
  ! foil
  \ card=%/filter
  ^ %/filter
  | card.set_mode((mod (add card.mode 1) 4))

surface =
  @view
  #on ; %/filter
  #for ; /sys/slot/detail
  card => {
    text(card.label, "title")
    image(card.picture)
    group(on = card, action = %/next) {
      action("Next treatment")
    }
    text("A native image transformation over the original image reference.", "caption")
  }
