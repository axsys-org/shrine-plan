#import lede=sys/lede
#import text=lib/grove/types/text

definition =
  @type
  ! foil
  grove_definition
  + read
    \ value=pail
    ^ maybe[definition]
    ?> held=grove_definition value .none
    | ./some held
  + write
    \ value=definition
    ^ pail
    | value
  + contract
    ^ curb
    | curb/of_type (^ grove_definition)

replacement =
  @type
  ! foil
  grove_definition_edit
  + read
    \ value=pail
    ^ maybe[replacement]
    ?> held=grove_definition_edit value .none
    | ./some held
  + write
    \ value=replacement
    ^ pail
    | value
  + contract
    ^ curb
    | curb/of_type (^ grove_definition_edit)

basis =
  @slot

draft =
  @slot

edit =
  @slot

editor =
  @role
  lede: text
  %/basis: %/definition
  %/draft: text
  #opt ;
    %/edit: %/replacement

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 1) (./err "Connect one native definition.")
  ?> (./some held) inputs.at(0).get(grove_definition/slot) (./err "The source is not established yet.")
  ?> definition=grove_definition held (./err "A revisioned native definition is required.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  ?> (./some held) inputs.at(0).get(grove_definition/slot) current
  ?> definition=grove_definition held current
  | current.put(['sys 'lede] (pails/t "Source")).put([($x 17) 'gov 'medium 'EDITOR 'basis] definition).put([($x 17) 'gov 'medium 'EDITOR 'draft] (pails/t definition.source))

compile =
  @action
  #on ; %/editor
  %/draft: text
  ! foil
  \ draft=str card=%/editor
  ^ %/editor
  | card.set_edit((./some (grove_definition_edit card.basis draft)))

surface =
  @view
  #on ; %/editor
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/compile, myth = {
      '/0x11/gov/medium/EDITOR/draft = .input(card.draft)
    }) {
      col {
        input('/0x11/gov/medium/EDITOR/draft, "code")
        action("Run this definition")
      }
    }
  }
