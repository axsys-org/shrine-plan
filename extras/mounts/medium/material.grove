' A reusable native projection over explicitly captured records. The browser
' receives ordinary rendering and opaque occurrence keys. All selection,
' decoding, editing and batch construction below are compiled Foil.

records =
  @slot
  #meta ;
    "/sys/lede": "Editable native records"
    "/sys/goo/program": (grove_surface_program records/render records/resolve records/prepare)
  ! foil
  + key
    \ target=path slot=path
    ^ path
    = prefix=path [($u target.len)]
    | prefix.weld(target).weld(slot)
  + card
    \ input=grove_observed
    ^ maybe[myth]
    ?> (./known tree) input.value .none
    tree.fil
  + visible
    \ context=grove_surface_context
    ^ row[grove_observed]
    | context.inputs.keep((\ input (maybe/is_some (records/card input))))
  + writable
    \ context=grove_surface_context target=path slot=path
    ^ bool
    | context.writes.any((\ scope (and (equal[path] scope.target target) (scope.slots.has(slot)))))
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? (eq key.len 0) (./err "Select a native field.")
    ? (equal[path] key ['increment])
      = values (records/visible context)
      ? (eq values.len 0) (./err "No values to change.")
      | ./ok (grove_occurrence key (grove_focus (safe 0 .x values.at(0).dependency.p) ['value] .none)
          (./some context.implementation.path.snoc('prepare)) rex/zero_span "Increment every numeric input in one native transaction")
    ?> (./some size) (dig_of key.at(0)) (./err "Invalid native field key.")
    ? ((eq size 0) || (le key.len size.inc)) (./err "Incomplete native field key.")
    = target key.drop(1).take(size)
      slot key.drop(size.inc)
      inputs context.inputs.keep((\ input (equal[path] input.dependency.p target)))
    ? !(eq inputs.len 1) (./err "This field is not in the captured input page.")
    ?> (./some card) (records/card inputs.at(0)) (./err "The original subject is unresolved.")
    ? !(card.has(slot)) (./err "The original slot is absent.")
    = editable (records/writable context target slot)
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x target) slot .none)
        (? editable (./some context.implementation.path.snoc('prepare)) .none) rex/zero_span "Original native subject and opaque slot")
  + display
    \ held=pail
    ^ str
    ? held
     > value=pails/t value.t
     > value=pails/n (nat/show value.n)
     > value=pails/p (path_show value.p)
     > value=pails/b (? value.b "true" "false")
    "Native value"
  + kind
    \ held=pail
    ^ str
    ? held
     > value=pails/t "text"
     > value=pails/n "natural"
    "native"
  + fields
    \ card=myth
    ^ row[mop/kv[path pail]]
    | card.tap.keep
      \ entry
      ? (equal[path] entry.key ['sys 'lede]) .false
      | !(eq (records/kind entry.val) "native")
  + cell
    \ context=grove_surface_context target=path entry=mop/kv[path pail]
    ^ weft/node
    = key (str/to_atom (path_show (records/key target entry.key)))
      value (str/to_atom (records/display entry.val))
      kind (str/to_atom (records/kind entry.val))
      attributes=row[weft/att]
        [(weft/att "data-grove-key" key) (weft/att "aria-label" (show/path entry.key))]
    ? !(records/writable context target entry.key)
      | weft/el "output" attributes [(weft/tx value)]
    = attributes attributes.weld(
      [(weft/att "data-grove-edit" "change")
       (weft/att "data-argument-slot" "/value") (weft/att "data-argument-kind" kind)
       (weft/att "type" "text") (weft/att "value" value)
       (weft/att "inputmode" (? (eq kind "natural") "numeric" "text"))])
    | weft/el "input" attributes []
  + row
    \ context=grove_surface_context input=grove_observed
    ^ weft/node
    = target input.dependency.p
      card (records/card input).fall(myth/new)
      title card.txt_at(['sys 'lede])
      title (? (eq title "") (path_show target) title)
      cells=row[weft/node]
        | (records/fields card).map
          \ entry
          | weft/el "td" [] [(records/cell context target entry)]
    | weft/el "tr" [(weft/att "data-grove-row" (show/path target))]
      cells.cons((weft/el "th" [(weft/att "scope" "row")] [(weft/tx (str/to_atom title))]))
  + css
    ^ nat
    ".record-surface{width:640px;background:#fffefb;border:1px solid #d5dcd0;box-shadow:0 4px 18px #30402e09;border-radius:4px;padding:26px 30px 18px}.record-surface header{font:10px ui-monospace,monospace;letter-spacing:1.4px;color:#6f7d6c;margin-bottom:16px}.record-surface table{width:100%;border-collapse:collapse;table-layout:fixed}.record-surface th{font-weight:500;text-align:left;width:45%;font-size:15px;padding:12px 0;border-bottom:1px solid #e1e6db}.record-surface td{border-bottom:1px solid #e1e6db;padding:0}.record-surface input{width:100%;padding:12px 10px;background:transparent;border:1px solid transparent;border-radius:3px;color:#28382d;font-variant-numeric:tabular-nums}.record-surface input:hover{background:#f0f3eb}.record-surface input:focus{outline:2px solid #53765b;outline-offset:-2px;background:#f2f5ec}.record-surface output{display:block;padding:12px 10px;font-weight:600;font-variant-numeric:tabular-nums}.record-surface footer{margin-top:16px}.record-surface footer button{font-size:12px;border:0;background:#edf1e7;padding:6px 12px}"
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    = inputs (records/visible context)
      occurrences=row[grove_occurrence]
        | inputs.bind
        \ input
        | (records/fields (records/card input).fall(myth/new)).map
          \ entry
          | either/ok_val (records/resolve context (records/key input.dependency.p entry.key) myth/new)
      increment (records/resolve context ['increment] myth/new)
      toolbar=row[weft/node]
        ? (eq inputs.len 0) []
        [(weft/el "button" [(weft/att "type" "button") (weft/att "data-grove-key" "/increment")
            (weft/att "data-grove-act" "click")] [(weft/tx "+1 to numeric inputs")])]
      missing=row[weft/node]
        | context.inputs.keep((\ input (maybe/is_none (records/card input)))).map
          \ input
          | weft/el "p" [] [(weft/tx (weft/cat2 "Unresolved input: " (show/path input.dependency.p)))]
      body (weft/node/el "section" [(weft/att "class" "record-surface")]
        [(weft/el "style" [] [(weft/raw records/css)])
         (weft/el "header" [] [(weft/el "span" [] [(weft/tx "LIVE MATERIAL")])])
         (weft/el "table" [] [(weft/el "tbody" [] inputs.map((records/row context)))])
         (weft/el "div" [(weft/att "role" "status")] missing)
         (weft/el "footer" [] toolbar)])
      occurrences
        ? increment
         > (./ok item) occurrences.snoc(item)
        occurrences
    | ./ok (grove_surface_output body occurrences [[]])
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence arguments=myth
    ^ either[str grove_change_plan]
    ? (equal[path] occurrence.key ['increment])
      ? !(eq (records/visible context).len context.inputs.len) (./err "A required input is unresolved.")
      = edits=row[grove_record_edit]
          | (records/visible context).fold []
          \ out input
          ? !(records/writable context input.dependency.p ['value]) out
          = before (records/card input).fall(myth/new)
          ?> (./some held) before.get(['value]) out
          ?> number=pails/n held out
          | out.snoc((grove_record_edit input.dependency.p (./some before)
              (./some before.put(['value] (pails/n number.n.inc)))))
      | ./ok (grove_change_plan edits [(./ok [])])
    = matching context.inputs.keep((\ input (equal[path] input.dependency.p occurrence.focus.source.path)))
    ? !(eq matching.len 1) (./err "The selected subject is no longer in this page.")
    ?> (./some before) (records/card matching.at(0)) (./err "The selected subject is unavailable.")
    ?> (./some original) before.get(occurrence.focus.slot) (./err "The selected slot is unavailable.")
    ?> (./some value) arguments.get(['value]) (./err "Provide the replacement value.")
    ? !(eq (records/kind original) (records/kind value)) (./err "This edit requires an explicit native type adaptation.")
    ? (eq (records/kind value) "native") (./err "This value requires its native editor.")
    | ./ok (grove_change_plan
        [(grove_record_edit occurrence.focus.source.path (./some before) (./some before.put(occurrence.focus.slot value)))] [(./ok [])])

sum =
  @slot
  #meta ;
    "/sys/lede": "Sum of native numeric records"
    "/sys/weft": (felt sum/evaluate .none)
  ! foil
  + evaluate
    \ tree=axal[myth]
    ^ myth
    = result tree.tap.fold(0 (\ total [at card] (add total card.nat_at(['value] 0))))
    | (myth/sing ['value] (pails/n result)).put(['sys 'lede] (pails/t "Sum"))
