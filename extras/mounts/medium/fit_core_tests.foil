- fit_core
- testing

+ fit_checks
  + decode
    \ text=str
    ^ json
    ?> (jres/ok value rest) (parse text) jnull
    value
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = text (fit_checks/decode "{""t"":""Text""}")
      number (fit_checks/decode "{""t"":""Number""}")
      arrangement (fit_checks/decode "{""blocks"":[{""id"":""a"",""kind"":""card"",""rect"":{""x"":0,""y"":0,""w"":100,""h"":100},""parent"":"""",""content"":[{""id"":""c"",""text"":""Sam · Fri""}]}]}")
      good (fit_checks/decode "{""content"":[""c""],""unplaced"":[]}")
      unplaced (fit_checks/decode "{""content"":[],""unplaced"":[""c""]}")
      missing (fit_checks/decode "{""content"":[],""unplaced"":[]}")
      duplicate (fit_checks/decode "{""content"":[""c""],""unplaced"":[""c""]}")
      unknown (fit_checks/decode "{""content"":[""invented""],""unplaced"":[]}")
      cycle (fit_checks/decode "{""blocks"":[{""id"":""a"",""kind"":""frame"",""rect"":{""x"":0,""y"":0,""w"":100,""h"":100},""parent"":""b"",""content"":[]},{""id"":""b"",""kind"":""frame"",""rect"":{""x"":0,""y"":0,""w"":100,""h"":100},""parent"":""a"",""content"":[]}]}")
      wide (fit_checks/decode "{""t"":""Record"",""fields"":[{""name"":""title"",""type"":{""t"":""Text""},""required"":true},{""name"":""extra"",""type"":{""t"":""Number""}}]}")
      narrow (fit_checks/decode "{""t"":""Record"",""open"":true,""fields"":[{""name"":""title"",""type"":{""t"":""Text""},""required"":true}]}")
    [(testing/nat "equal scalar shapes bind" 1 (fit_core/compatible 32 text text))
     (testing/nat "scalar mismatch remains a hole" 0 (fit_core/compatible 32 text number))
     (testing/nat "unknown shapes do not bind" 0 (fit_core/compatible 32 jnull jnull))
     (testing/nat "open structural input accepts extra fields" 1 (fit_core/compatible 32 wide narrow))
     (testing/nat "content references preserve every supplied item" 0 (either/is_err (fit_core/validate_reading arrangement good)))
     (testing/nat "unplaced content remains accounted for" 0 (either/is_err (fit_core/validate_reading arrangement unplaced)))
     (testing/nat "lost content rejects fit" 1 (either/is_err (fit_core/validate_reading arrangement missing)))
     (testing/nat "duplicate content rejects fit" 1 (either/is_err (fit_core/validate_reading arrangement duplicate)))
     (testing/nat "invented content rejects fit" 1 (either/is_err (fit_core/validate_reading arrangement unknown)))
     (testing/nat "containment cycles reject arrangement" 1 (either/is_err (fit_core/validate_arrangement cycle)))
     (testing/nat "missing blocks is not an empty arrangement" 1 (either/is_err (fit_core/validate_arrangement jnull)))
     (testing/text "a name does not create a person reference" "word" (fit_core/text "k" (fit_core/label "Sam" .false)))
     (testing/text "weekday needs context" "word" (fit_core/text "k" (fit_core/label "Fri" .false)))
     (testing/text "notes are not interpreted as actions" "sentence" (fit_core/text "k" (fit_core/label "[text customer]" .true)))
     (testing/text "derivation is preserved as intent, not executed" "area × floor.price" (fit_core/text "expression" (fit_core/label "= area × floor.price" .false)))
     (testing/text "explicit grouping retains the field" "status" (fit_core/text "field" (fit_core/label "by status" .false)))
     (testing/text "annotation cannot become a derived behavior" "sentence" (fit_core/text "k" (fit_core/label "= area × floor.price" .true)))
     (testing/text "button label declares intent" "text customer" (fit_core/text "verb" (fit_core/label "[text customer]" .false)))
     (testing/text "unit label retains its unit" "km" (fit_core/text "unit" (fit_core/label "distance (km)" .false)))
     (testing/nat "column labels retain all values" 3 (fit_core/array (fit_core/field "items" (fit_core/label "Todo · Doing · Done" .false))).len)]

+ tests
  ^ row[testing/case]
  [(testing/case "Closed native contracts and content conservation" fit_checks/checks)]
