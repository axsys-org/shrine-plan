- grove_surface_wire
- construction_markup

' Bootstrap access to the existing Grove compiler and template installer.
' Source is native material; instances are ordinary namespace records. This
' boundary knows no application types, schemas, renderers or evaluation rules.
+ construction
  + candidate
    : request=json code=path target=path code_records=row[[path myth]]
      material_records=row[[path myth]] before_records=row[[path myth]] reads=row[[dep maybe[nat]]] preview=str
  + candidate_slot
    ^ path
    ['sys 'grove 'prepared_construction]
  + bounded_records
    \ root=path state=namespace
    ^ either[str row[[path myth]]]
    % pending=row[[path axal[myth]]] [[root (sovereign_care .z root state)]] out=row[[path myth]] [] visited=nat 0
    ^ either[str row[[path myth]]]
    ? (eq pending.len 0) (./ok out)
    ? (ge visited 128) (./err "This construction exceeds 128 native locations. Split it into reusable pieces.")
    = [at tree] pending.at(0)
      children tree.kid_tap.map((\ [key child] [at.snoc(key) child]))
      out
        ? tree.fil
         > (./some card) out.snoc([at card])
        out
    ? (gt children.len 128) (./err "This construction needs a bounded child collection.")
    | _ pending.drop(1).weld(children) out visited.inc
  + build
    ' The existing compiler and owner transaction operate on an immutable
    ' candidate. No candidate namespace is retained or installed here.
    \ body=json state=namespace
    ^ either[str [namespace path path]]
    ?> (./some subject) (path_parse (grove_surface_wire/text "subject" body)) (./err "A definition reference is required.")
    ?> (./some target) (path_parse (grove_surface_wire/text "target" body)) (./err "A material reference is required.")
    ? !(construction/owned target 'app state) (./err "Construction target is outside your material.")
    ? !(eq (sovereign_peek target state).wyt 0) (./err "Existing material cannot be replaced by construction. Use its scoped native action.")
    = source (grove_surface_wire/text "source" body)
      compiled=either[str namespace]
        ? (eq source.len 0) (./ok state)
        ? !(eq (sovereign_peek subject state).wyt 0) (./err "Reuse installed definitions; author missing behavior in a fresh bounded location.")
        ? (gt source.len 12000) (./err "One construction may author at most 12 KiB. Import existing machinery and keep the missing behavior local.")
        | construction/author subject body state
    < compiled compiled
    = version (compiled.case(.x subject)).fall(0)
    ? (eq source.len 0)
      ? !(eq version (nat/parse (grove_surface_wire/text "version" body)).fall(0)) (./err "The selected template case changed.")
      < next (construction/instantiate target (json/obj [(jkv "source" (json/str (path_show subject))) (jkv "version" (json/str (nat/show version)))]) compiled)
      | ./ok [next subject target]
    < next (construction/instantiate target (json/obj [(jkv "source" (json/str (path_show subject))) (jkv "version" (json/str (nat/show version)))]) compiled)
    | ./ok [next subject target]
  + prepare_action
    \ body=json state=namespace
    ^ either[str [construction/candidate namespace]]
    ?> (./some subject) (path_parse (grove_surface_wire/text "subject" body)) (./err "An exact native action surface is required.")
    ? !(construction/owned subject 'app state) (./err "Select a surface in your native material.")
    < viewport (grove_surface_wire/arguments (grove_dev/field "viewport" body))
    < captured (goo_runtime/capture_surface subject viewport state)
    ? !(equal[json] (grove_dev/field "basis" body) (grove_surface_wire/basis captured)) (./err "The selected surface changed. Refresh it before preparing a correction.")
    ?> (./some key) (path_parse (grove_surface_wire/text "key" body)) (./err "An exact action key is required.")
    < parameters (grove_surface_wire/arguments (grove_dev/field "parameters" body))
    < args (grove_surface_wire/arguments (grove_dev/field "arguments" body))
    < action (goo_runtime/prepare_surface_action captured key parameters args state)
    < commands (goo_runtime/surface_commands action state)
    ?> (./ok next) (grove_install/change_many commands state) (./err "The proposed action or its reactions failed. Current work is unchanged.")
    < preview_capture (goo_runtime/capture_surface subject viewport next)
    < frame (grove_surface_wire/frame preview_capture next)
    = records action.plan.edits.map((\ edit [edit.target edit.after.fall(myth/new)]))
      before action.plan.edits.map((\ edit [edit.target edit.before.fall(myth/new)]))
      reads captured.context.inputs.map((\ input [input.dependency input.basis]))
      reads reads.weld(action.plan.edits.map((\ edit [(dep .x edit.target) (state.case(.x edit.target))])))
      reads reads.snoc([(dep .x subject) (state.case(.x subject))]).snoc([(dep .x captured.binding.implementation.path) (state.case(.x captured.binding.implementation.path))])
    | ./ok [(construction/candidate body captured.binding.implementation.path subject [] records before reads (grove_surface_wire/text "html" frame)) next]
  + prepare
    \ body=json state=namespace
    ^ either[str [construction/candidate namespace]]
    ? (eq (grove_surface_wire/text "kind" body) "action") (construction/prepare_action body state)
    < built (construction/build body state)
    = [next code target] built
    < definitions (construction/bounded_records code next)
    < records (construction/bounded_records target next)
    = surface (path_parse (grove_surface_wire/text "surface" body))
      preview=either[str [str row[[dep maybe[nat]]]]]
        ?> (./some surface) surface (./ok ["" []])
        ? !(pith_prefix target surface) (./err "The preview must be a surface in this construction.")
        < captured (goo_runtime/capture_surface surface myth/new next)
        < frame (grove_surface_wire/frame captured next)
        = reads captured.context.inputs.keep((\ input !((pith_prefix target input.dependency.p) || (pith_prefix code input.dependency.p))))
        | ./ok [(grove_surface_wire/text "html" frame) reads.map((\ input [input.dependency input.basis]))]
    < preview preview
    = [html reads] preview
    | ./ok [(construction/candidate body code target definitions records [] reads html) next]
  + candidate_response
    \ at=path prepared=construction/candidate state=namespace
    ^ json
    = record
        \ entry=[path myth]
        ^ json
        = [target card] entry
        | json/obj [(jkv "subject" (json/str (path_show target)))
            (jkv "label" (json/str (card.txt_at(['sys 'lede]))))
            (jkv "fields" (json/arr card.tap.map(grove_surface_wire/field)))]
    | json/obj [(jkv "proposal" (json/str (path_show at)))
        (jkv "target" (json/str (path_show prepared.target)))
        (jkv "definition" (json/str (path_show prepared.code)))
        (jkv "source" (json/str (grove_surface_wire/text "source" prepared.request)))
        (jkv "surface" (json/str (? (eq (grove_surface_wire/text "kind" prepared.request) "action") (path_show prepared.target) (grove_surface_wire/text "surface" prepared.request))))
        (jkv "records" (json/arr prepared.material_records.map(record)))
        (jkv "before_records" (json/arr prepared.before_records.map(record)))
        (jkv "preview" (json/str prepared.preview))
        (jkv "review_html" (json/str (construction_markup/render prepared.material_records prepared.before_records prepared.preview)))
        (jkv "coverage" (json/str "Compiled native construction and declared presentation inputs. Global downstream coverage is not claimed."))]
  + prepared_error
    \ value=either[str [construction/candidate namespace]]
    ^ str
    ? value
     > (./err why) why
    "Construction is unresolved."
  + prepared_handle
    \ request=interaction_runtime/request body=json state=namespace index=hive
    ^ [namespace hive nat str]
    ? (eq request.operation "native/prepare")
      ? ((eq request.event.len 0) || (gt request.event.len 80)) (construction/failure state index "Candidate identity required.")
      = at=path [state.self 'journal 'grove 'candidates ($ta request.event)]
        prior (goo_runtime/record .x at state)
      ? (maybe/is_some prior)
        ?> (./some held) prior.fall(myth/new).get(construction/candidate_slot) (construction/failure state index "Candidate receipt is unavailable.")
        ?> prepared=construction/candidate held (construction/failure state index "Candidate belongs to a different engine.")
        ? !(equal[json] prepared.request body) (construction/failure state index "Candidate identity already names different work.")
        | grove_surface_wire/reply_indexed state index 200 (construction/candidate_response at prepared state)
      = attempt (construction/prepare body state)
      ?> (./ok built) attempt (construction/failure state index (construction/prepared_error attempt))
      = [prepared candidate_state] built
        record (myth/sing construction/candidate_slot prepared).put(['state] (pails/t "prepared"))
      ?> (./ok retained) (grove_install/change at (writ/make record) state) (construction/failure state index "Could not retain checked candidate.")
      | grove_surface_wire/reply_indexed retained (sovereign_hive retained) 200 (construction/candidate_response at prepared retained)
    ?> (./some at) (path_parse (grove_surface_wire/text "proposal" body)) (construction/failure state index "Select the checked candidate.")
    ? !(pith_prefix [state.self 'journal 'grove 'candidates] at) (construction/failure state index "This is not a construction candidate.")
    ?> (./some record) (goo_runtime/record .x at state) (construction/failure state index "Candidate no longer exists.")
    ?> (./some held) record.get(construction/candidate_slot) (construction/failure state index "Candidate receipt is unavailable.")
    ?> prepared=construction/candidate held (construction/failure state index "Candidate belongs to a different engine.")
    ? (eq (record.txt_at(['state])) "applied")
      | grove_surface_wire/reply_indexed state index 200 (construction/candidate_response at prepared state)
    ? !(prepared.reads.all((\ [dependency version] (equal version (state.case(dependency.c dependency.p))))))
      | construction/failure state index "A preview input changed. Refresh the candidate; your current work is unchanged."
    = attempt (construction/prepare prepared.request state)
    ?> (./ok built) attempt (construction/failure state index "Candidate no longer fits. Prepare it again against the current world.")
    = [current next] built
    ? !(and (equal current.code_records prepared.code_records) (and (equal current.material_records prepared.material_records) (eq current.preview prepared.preview)))
      | construction/failure state index "Native definitions or preview changed. Review a refreshed candidate before applying."
    ?> (./ok committed) (grove_install/change at (writ/poke (myth/sing ['state] (pails/t "applied"))) next)
      | construction/failure state index "Could not retain activation receipt; current work is unchanged."
    | grove_surface_wire/reply_indexed committed (sovereign_hive committed) 200 (construction/candidate_response at current committed)
  + source_slot
    ^ path
    ['sys 'grove 'authored_source]
  + receipt_slot
    ^ path
    ['sys 'grove 'construction_request]
  + owned
    \ target=path branch=iota state=namespace
    ^ bool
    | and (pith_prefix [state.self branch 'user] target) (gt target.len 3)
  + failure
    \ state=namespace index=hive text=str
    ^ [namespace hive nat str]
    | grove_surface_wire/fail_indexed state index 422 text
  + response
    \ subject=path state=namespace
    ^ json
    | json/obj [(jkv "subject" (json/str (path_show subject)))
        (jkv "case" (grove_surface_wire/optional (state.case(.x subject))))
        (jkv "epoch" (grove_surface_wire/optional (state.case(.z subject))))]
  + handle
    \ request=interaction_runtime/request state=namespace index=hive
    ^ [namespace hive nat str]
    ? !(eq request.principal "administrator")
      | grove_surface_wire/fail_indexed state index 403 "Native construction requires the local owner's authority."
    ?> (jres/ok body rest) (parse request.body) (construction/failure state index "Invalid construction request.")
    ? !(eq rest 0) (construction/failure state index "Trailing construction input.")
    ? ((eq request.operation "native/prepare") || (eq request.operation "native/commit"))
      | construction/prepared_handle request body state index
    ?> (./some subject) (path_parse (grove_surface_wire/text "subject" body))
      | construction/failure state index "An exact native reference is required."
    ? (eq request.operation "native/source")
      = card (goo_runtime/record .x subject state).fall(myth/new)
        source card.txt_at(construction/source_slot)
      | grove_surface_wire/reply_indexed state index 200 (json/obj
          [(jkv "source" (json/str source)) (jkv "basis" (construction/response subject state))])
    ? !((eq request.operation "native/author") || (eq request.operation "native/instantiate"))
      | construction/failure state index "Unknown native construction operation."
    ? ((eq request.event.len 0) || (gt request.event.len 80))
      | construction/failure state index "Construction event identity required."
    = receipt=path [state.self 'journal 'grove 'construction ($ta request.event)]
      identity (myth/sing construction/receipt_slot (pails/t request.body)).put(['operation] (pails/t request.operation))
      previous (goo_runtime/record .x receipt state)
    ? (maybe/is_some previous)
      ? !(equal previous (maybe/some[myth] identity))
        | construction/failure state index "Construction event already identifies different work."
      | grove_surface_wire/reply_indexed state index 200 (construction/response subject state)
    = expected (nat/parse (grove_surface_wire/text "expected" body))
    ? !(equal expected (state.case(.z subject)))
      | construction/failure state index "The target changed; retain this source and reassess against its current basis."
    = attempted=either[str namespace]
        ? (eq request.operation "native/author") (construction/author subject body state)
        | construction/instantiate subject body state
    ?> (./ok next) attempted (construction/failure state index (construction/error attempted))
    ?> (./ok committed) (grove_install/change receipt (writ/make identity) next)
      | construction/failure state index "Could not retain construction receipt; the candidate was not installed."
    | grove_surface_wire/reply_indexed committed (sovereign_hive committed) 200 (construction/response subject committed)
  + error
    \ result=either[str namespace]
    ^ str
    ? result
     > (./err why) why
    "Construction failed."
  + author
    \ subject=path body=json state=namespace
    ^ either[str namespace]
    ? !(construction/owned subject 'gov state) (./err "Author definitions below your /gov/user namespace.")
    = source (grove_surface_wire/text "source" body)
    ? ((eq source.len 0) || (gt source.len 48000)) (./err "Supply one bounded Grove source unit.")
    ?> (./some ports) (grove_authoring/get state) (./err "Native compiler unavailable.")
    < compiled (ports.compile subject source state)
    = card (goo_runtime/record .x subject compiled).fall(myth/new)
      card card.put(construction/source_slot (pails/t source))
    ?> (./ok next) (grove_install/change subject (writ/poke card) compiled)
      | ./err "Could not retain source with its compiled definitions."
    | ./ok next
  + instantiate
    \ subject=path body=json state=namespace
    ^ either[str namespace]
    ? !(construction/owned subject 'app state) (./err "Construct material below your /app/user namespace.")
    ? !(eq (sovereign_peek subject state).wyt 0) (./err "This location is occupied. Existing shared material must be edited, not replaced by seeds.")
    ?> (./some source) (path_parse (grove_surface_wire/text "source" body)) (./err "Select a native template reference.")
    ?> (./some version) (nat/parse (grove_surface_wire/text "version" body)) (./err "Select an exact template case.")
    ? !(equal (maybe/some[nat] version) (state.case(.x source))) (./err "The template changed; inspect its current definition.")
    ?> (./ok next) (grove_install/instantiate source version subject state) (./err "Native template instantiation failed; existing work is unchanged.")
    | ./ok next
