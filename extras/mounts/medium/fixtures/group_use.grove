#import lede=sys/lede
#import text=lib/grove/types/text

group =
  @slot

summary =
  @slot

group_use_role =
  @role
  lede: text
  %/summary: text

positions =
  ! foil
  | grove_binding_schema
      [(grove_binding_position [($x 17) 'gov 'medium 'USE 'group]
         [($x 17) 'gov 'medium 'PEOPLE 'people_role] "one")]

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 1) (./err "One established group is required.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = key=path [($x 17) 'gov 'medium 'USE 'summary]
    summary (inputs.at(0).txt_at([($x 17) 'gov 'medium 'PEOPLE 'summary]))
  | current.put(['sys 'lede] (pails/t "Group use")).put(key (pails/t summary))

surface =
  @view
  #on ; %/group_use_role
  #for ; /sys/slot/detail
  card => {
    show(card.summary, '/sys/slot/content)
  }
