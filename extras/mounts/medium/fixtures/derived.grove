#import lede=sys/lede
#import text=lib/grove/types/text

number =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[number]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

amount =
  @slot

derived =
  @role
  lede: text
  %/amount: %/number

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 1) (./err "One input is required.")
  ?> (./some held) inputs.at(0).get([($x 17) 'gov 'medium 'INPUT 'amount])
    | ./err "The selected input has no amount at the declared native slot."
  ?> amount=pails/n held (./err "The selected amount is not a native number.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = key=path [($x 17) 'gov 'medium 'DERIVED 'amount]
    amount (inputs.at(0).nat_at([($x 17) 'gov 'medium 'INPUT 'amount] 0)).inc
  | current.put(['sys 'lede] (pails/t "Derived")).put(key (pails/n amount))

surface =
  @view
  #on ; %/derived
  #for ; /sys/slot/detail
  card => {
    show(card.lede, '/sys/slot/title)
    number(card.amount, '/sys/slot/content)
  }
