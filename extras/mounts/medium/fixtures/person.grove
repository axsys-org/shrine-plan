#import lede=sys/lede
#import text=lib/grove/types/text

full_name =
  @slot

person_role =
  @role
  lede: text
  #opt ;
    %/full_name: text

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "Person has no context inputs.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Person"))

surface =
  @view
  #on ; %/person_role
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = .poke, myth = {
      '/0x11/gov/medium/PERSON/full_name = .input(card.full_name)
    }) {
      text("Name", '/sys/slot/caption)
      input('/0x11/gov/medium/PERSON/full_name)
      action("Keep name")
    }
  }
