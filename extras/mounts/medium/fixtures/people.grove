#import lede=sys/lede
#import text=lib/grove/types/text

first =
  @slot

second =
  @slot

summary =
  @slot

people_role =
  @role
  lede: text
  %/summary: text

positions =
  ! foil
  | grove_binding_schema
      [(grove_binding_position [($x 17) 'gov 'medium 'PEOPLE 'first]
         [($x 17) 'gov 'medium 'PERSON 'person_role] "one")
       (grove_binding_position [($x 17) 'gov 'medium 'PEOPLE 'second]
         [($x 17) 'gov 'medium 'PERSON 'person_role] "one")]

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 2) (./err "Two distinct Person positions are required.")
  = named
      \ card=myth
      ^ bool
      ?> (./some held) card.get([($x 17) 'gov 'medium 'PERSON 'full_name]) .false
      | ?=(name=pails/t held)
  ? !(inputs.all(named)) (./err "Each participant must supply the native name slot.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = describe
      \ card=myth
      ^ str
      = name (card.txt_at([($x 17) 'gov 'medium 'PERSON 'full_name]))
        birthday (card.txt_at([($x 17) 'gov 'medium 'PERSON 'birthday]))
      | str/join "" [name " - " (? (eq birthday "") "?" birthday)]
  = key=path [($x 17) 'gov 'medium 'PEOPLE 'summary]
    summary (str/join " / " (inputs.map(describe)))
  | current.put(['sys 'lede] (pails/t "People")).put(key (pails/t summary))

surface =
  @view
  #on ; %/people_role
  #for ; /sys/slot/detail
  card => {
    show(card.lede, '/sys/slot/title)
    show(card.summary, '/sys/slot/content)
  }
