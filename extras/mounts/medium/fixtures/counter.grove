#import lede=sys/lede
#import text=lib/grove/types/text

number =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[number]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

amount =
  @slot

counter =
  @role
  lede: text
  %/amount: %/number

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This counter has no input positions.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  = key=path [($x 17) 'gov 'medium 'COUNTER 'amount]
    amount (current.nat_at(key 0))
  | current.put(['sys 'lede] (pails/t "Counter")).put(key (pails/n amount))

increment =
  @action
  #on ; %/counter
  ! foil
  \ card=%/counter
  ^ %/counter
  | card.set_amount(card.amount.inc)

surface =
  @view
  #on ; %/counter
  #for ; /sys/slot/detail
  card => {
    col("identity") {
      show(card.lede, '/sys/slot/title)
      number(card.amount, '/sys/slot/content)
    }
    group(on = card, action = %/increment) {
      action("Add one")
    }
  }
