- fit_store
- construction
- grove_authoring
- grove_dev
- interaction_runtime
- goo_bridge
- goo_runtime
- grove_surface_wire
- material

' Definitions, shared occurrences and authored compositions live in Shrine.
' No interpretation of Person/Money/etc. exists in this module.
+ medium
  + selection
    : subject=path slots=row[path] occurrence=str
  + node
    : label=str inputs=row[medium/selection] source=str intent=str pattern=path
  + computed
    : value=myth
  + boundary_result
    : value=either[str unit]
  + open_positions
    : positions=row[nat]
  + availability
    : ready=bool causes=row[path]
  + placement
    : parent=path
  + relation
    : introduced=nat
  + property
    : label=str slot=path
  + descriptions
    : items=row[[path str]]
  + properties
    : fields=row[medium/property]
  + action_result
    : value=either[str goo_runtime/prepared_action]
  + initial_result
    : value=either[str myth]
  + saved
    ' Undo references native history. Embedding unpinned compiled records here
    ' duplicates their closures in every subsequent world record and journal.
    : records=row[[path nat]] nodes=row[path]
  + world
    : nodes=row[path] events=row[interaction_runtime/request] undo=list[medium/saved]
  + node_slot
    ^ path
    ['medium 'node]
  + world_slot
    ^ path
    ['medium 'world]
  + open_slot
    ^ path
    ['medium 'open]
  + availability_slot
    ^ path
    ['medium 'availability]
  + placement_slot
    ^ path
    ['medium 'placement]
  + relation_slot
    ^ path
    ['medium 'relation]
  + properties_slot
    ^ path
    ['medium 'properties]
  + descriptions_slot
    ^ path
    ['medium 'descriptions]
  + descriptions_of
    \ card=myth
    ^ row[[path str]]
    ?> (./some held) card.get(medium/descriptions_slot) []
    ?> descriptions=medium/descriptions held []
    | descriptions.items
  + description_of
    \ slot=path card=myth
    ^ str
    = matches (medium/descriptions_of card).keep((\ [at text] (equal[path] at slot)))
    ? (eq matches.len 0) ""
    = [at text] matches.at(0)
    | text
  + properties_of
    \ card=myth
    ^ row[medium/property]
    ?> (./some held) card.get(medium/properties_slot) []
    ?> properties=medium/properties held []
    | properties.fields
  + parent
    \ target=path state=namespace
    ^ path
    ?> (./some held) (medium/record target state).get(medium/placement_slot) []
    ?> placement=medium/placement held []
    | placement.parent
  + placement_allowed
    \ target=path parent=path nodes=row[path] state=namespace
    ^ bool
    ? !(nodes.has(target)) .false
    % at=path parent steps=nat 0
    ^ bool
    ? (eq at.len 0) .true
    ? (ge steps 64) .false
    ? !(nodes.has(at)) .false
    ? (equal[path] target at) .false
    | _ (medium/parent at state) steps.inc
  + preserve_topology
    \ before=myth after=myth
    ^ myth
    = keys=row[path] [medium/placement_slot medium/relation_slot medium/properties_slot medium/descriptions_slot]
    | keys.fold after
      \ out key
      ? before.get(key)
       > (./some value) out.put(key value)
      | out.del(key)
  + material
    \ card=myth
    ^ myth
    | card.del(medium/node_slot).del(medium/open_slot).del(medium/availability_slot).del(medium/placement_slot).del(medium/relation_slot).del(medium/properties_slot).del(medium/descriptions_slot)
  + owned_output
    \ root=path before=myth after=myth
    ^ bool
    = allowed
        \ key=path
        ^ bool
        ? (pith_prefix root key) .true
        ? (equal[path] key ['sys 'lede]) .true
        | equal[path] key ['sys 'content]
      kept
        \ item=mop/kv[path pail]
        ^ bool
        ? (allowed item.key) .true
        | equal[maybe[pail]] before.get(item.key) after.get(item.key)
    | and (before.tap.all(kept)) (after.tap.all(kept))
  + open
    \ target=path state=namespace
    ^ row[nat]
    ?> (./some held) (medium/record target state).get(medium/open_slot) []
    ?> open=medium/open_positions held []
    | open.positions
  + ready
    \ target=path state=namespace
    ^ bool
    ?> (./some held) (medium/record target state).get(medium/availability_slot) .true
    ?> available=medium/availability held .false
    | available.ready
  + record
    \ target=path state=namespace
    ^ myth
    | (sovereign_care .x target state).fil.fall(myth/new)
  + text
    \ key=str input=json
    ^ str
    | grove_dev/text (grove_dev/field key input)
  + number
    \ n=nat
    ^ json
    | json/str (nat/show n)
  + location
    \ target=path
    ^ json
    | json/str (path_show target)
  + code_root
    \ target=path state=namespace
    ^ path
    = own=path [state.self 'gov 'medium target.at(target.len.dec)]
    ?> (./some node) (medium/get_node target state) own
    ? (eq node.pattern.len 0) own
    node.pattern
  + fail
    \ state=namespace status=nat message=str
    ^ [namespace nat str]
    [state status (show (json/obj [(jkv "error" (json/str message))]))]
  + get_node
    \ target=path state=namespace
    ^ maybe[medium/node]
    < held (medium/record target state).get(medium/node_slot)
    ?> node=medium/node held .none
    | ./some node
  + selection_json
    \ selected=medium/selection
    ^ json
    | json/obj [(jkv "subject" (medium/location selected.subject))
        (jkv "slots" (json/arr selected.slots.map(medium/location)))
        (jkv "occurrence" (json/str selected.occurrence))]
  + field_json
    \ pair=mop/kv[path pail]
    ^ json
    = value=json
        ? (goo_bridge/text pair.val)
         > (./ok text) (json/str text)
        jnull
    | json/obj [(jkv "slot" (medium/location pair.key)) (jkv "value" value)]
  + published
    \ target=path state=namespace
    ^ maybe[goo/published]
    ?> (./ok published) (goo_runtime/published (medium/record (medium/code_root target state).snoc('surface) state)) .none
    | ./some published
  + reference_json
    \ target=path care=care state=namespace
    ^ json
    | json/obj [(jkv "address" (medium/location target))
        (jkv "case" (state.case(care target).run(medium/number).fall(jnull)))]
  + role_field_json
    \ field=goo/field state=namespace
    ^ json
    | json/obj [(jkv "name" (json/str field.name))
        (jkv "slot" (medium/location field.slot))
        (jkv "type" (medium/reference_json field.type .z state))
        (jkv "optional" (json/boo field.optional))]
  + field_state_json
    \ field=goo/field card=myth state=namespace
    ^ json
    | json/obj [(jkv "declaration" (medium/role_field_json field state))
        (jkv "status" (json/str (? (card.has(field.slot)) "present" "absent")))]
  + preserve_open
    ' Source editing is not binding. A former filler remains provenance until
    ' an explicit rebind. Retiring or reordering open requirements needs a
    ' separate assessed transition; omission from generated source is not one.
    \ before=row[medium/selection] after=row[medium/selection] open=row[nat]
    ^ either[str row[nat]]
    = retained
        \ index=nat
        ^ bool
        ? (ge index after.len) .false
        ? (ge index before.len) .false
        | equal[medium/selection] before.at(index) after.at(index)
    ? !(open.all(retained)) (./err "An open input must retain its position and prior selection. Use rebind to fill it; source editing cannot silently retire or replace it.")
    | ./ok open
  + binding_schema
    \ root=path state=namespace
    ^ either[str row[grove_binding_position]]
    ?> (./some held) (medium/record root.snoc('positions) state).get(grove_backend/module_slot) (./ok [])
    ?> bundle=grove_backend/bundle held (./err "Invalid input position declaration.")
    ?> (./some entry) bundle.exports.get([]) (./err "Input position schema is missing.")
    ?> schema=grove_binding_schema entry.value (./err "positions must export grove_binding_schema.")
    | ./ok schema.positions
  + check_positions
    \ root=path count=nat before=namespace after=namespace
    ^ either[str unit]
    < declared (medium/binding_schema root after)
    < previous (medium/binding_schema root before)
    ? (eq declared.len 0)
      ? (gt previous.len 0) (./err "An established requirement schema cannot disappear during a source edit.")
      | ./ok []
    ? !(eq declared.len count) (./err "Each declared requirement has exactly one realization position. A collection is one realization, not an incidental number of inputs.")
    = shapes=row[str] ["one" "optional" "list" "set" "map" "tree" "sequence"]
      valid
        \ i=nat
        ^ bool
        = item declared.at(i)
        ? !(pith_prefix root item.key) .false
        ? !(eq item.key.len root.len.inc) .false
        ? (eq item.role.len 0) .false
        ? !(shapes.has(item.shape)) .false
        ? (row/any[grove_binding_position] (\ other=grove_binding_position (equal[path] item.key other.key)) declared.take(i)) .false
        ? (ge i previous.len) .true
        | equal[path] item.key previous.at(i).key
    ? !(ge declared.len previous.len) (./err "Requirement retirement needs an explicit transition; a source omission is not retirement.")
    ? !((row/range 0 declared.len).all(valid)) (./err "Requirement identities must be unique native positions and survive in order. Shape and role may evolve only with current binding checks.")
    | ./ok []
  + check_input_roles
    \ root=path inputs=row[myth] state=namespace
    ^ either[str unit]
    < positions (medium/binding_schema root state)
    ? (eq positions.len 0) (./ok [])
    ? !(eq positions.len inputs.len) (./err "Input realization count differs from its declared requirements.")
    % i=nat 0
    ^ either[str unit]
    ? (eq i positions.len) (./ok [])
    = position positions.at(i)
    ?> (./some held) (medium/record position.role state).get(publisher_vocabulary/grove/role_contract)
      | ./err "A requirement's expected role has no native contract."
    ?> contract=lash held (./err "A requirement's role contract is invalid.")
    ? (maybe/is_some (fit_check inputs.at(i).put(['sys 'lash] contract)))
      | ./err (str/join "" ["The realization does not satisfy requirement " (path_show position.key) "."])
    | _ i.inc
  + input_index
    \ target=path node=medium/node input=json state=namespace
    ^ maybe[nat]
    = requested (medium/text "requirement" input)
    ? (eq requested "") (nat/parse (medium/text "index" input))
    < key (path_parse requested)
    ?> (./ok positions) (medium/binding_schema (medium/code_root target state) state) .none
    = matches (row/range 0 positions.len).keep((\ i (equal[path] positions.at(i).key key)))
    ? !(eq matches.len 1) .none
    | ./some matches.at(0)
  + typing_json
    ' Export the actual compiled presentation role and executable boundary refs.
    ' No field names, appearances or probability scores establish correspondence.
    \ target=path node=medium/node state=namespace
    ^ json
    = root (medium/code_root target state)
      open (medium/open target state)
      schema (either/ok_val (medium/binding_schema root state))
      position
        \ index=nat
        ^ json
        | json/obj [(jkv "index" (medium/number index))
            (jkv "identity" (json/obj [(jkv "owner" (medium/location target))
                (jkv "key" (? (lt index schema.len) (medium/location schema.at(index).key) jnull))]))
            (jkv "role" (? (lt index schema.len) (medium/reference_json schema.at(index).role .z state) jnull))
            (jkv "shape" (? (lt index schema.len) (json/str schema.at(index).shape) jnull))
            (jkv "status" (json/str (? (open.has(index)) "open" "bound")))
            (jkv "selection" (medium/selection_json node.inputs.at(index)))
            (jkv "contract" (medium/reference_json root.snoc('accepts) .z state))]
      role=json
        ?> (./some published) (medium/published target state) jnull
        | json/obj [(jkv "reference" (medium/reference_json published.view.role .z state))
            (jkv "fields" (json/arr published.fields.row.map((\ field (medium/role_field_json field state)))))
            (jkv "values" (json/arr published.fields.row.map((\ field (medium/field_state_json field (medium/record target state) state)))))]
    | json/obj [(jkv "basis" (medium/reference_json target .x state))
        (jkv "definition" (medium/reference_json root .z state))
        (jkv "role" role)
        (jkv "accepts" (medium/reference_json root.snoc('accepts) .z state))
        (jkv "realize" (medium/reference_json root.snoc('realize) .z state))
        (jkv "positions" (json/arr ((row/range 0 node.inputs.len).map(position))))
        (jkv "coverage" (json/str "Compiled surface role and explicit input positions; arbitrary Foil constraints remain executable source, not an inferred schema."))]
  + node_json
    \ target=path state=namespace
    ^ json
    = node (medium/get_node target state).fall((medium/node "Missing" [] "" "" []))
      card (medium/record target state)
      fields (medium/material card).tap.map(medium/field_json)
      property_json
        \ field=medium/property
        ^ json
        | json/obj [(jkv "label" (json/str field.label))
            (jkv "slot" (medium/location field.slot))
            (jkv "description" (json/str (medium/description_of field.slot card)))
            (jkv "value" (json/str card.txt_at(field.slot)))]
      view=json
        ? !(medium/ready target state) jnull
        ?> (./some published) (medium/published target state) jnull
        ?> (./ok lowered) published.result jnull
        = html=json
            ? (goo_bridge/render_at 360 published card lowered)
             > (./ok html) (json/str html)
             > (./err message) (json/str message)
        | json/obj [(jkv "id" (medium/location published.view.name))
            (jkv "html" html)
            (jkv "occurrences" (json/arr (goo_bridge/occurrences published card lowered.children [] 1)))]
    | json/obj [(jkv "id" (medium/location target))
        (jkv "parent" (medium/location (medium/parent target state)))
        (jkv "relation" (json/boo card.has(medium/relation_slot)))
        (jkv "description" (json/str (medium/description_of [] card)))
        (jkv "properties" (json/arr (medium/properties_of card).map(property_json)))
        (jkv "authored" (json/boo !(and (eq node.source "") (eq node.pattern.len 0))))
        (jkv "label" (json/str node.label)) (jkv "source" (json/str node.source))
        (jkv "pattern" (medium/location (medium/code_root target state)))
        (jkv "code_root" (medium/location (medium/code_root target state)))
        (jkv "typing" (medium/typing_json target node state))
        (jkv "intent" (json/str node.intent)) (jkv "inputs" (json/arr node.inputs.map(medium/selection_json)))
        (jkv "open" (json/arr ((medium/open target state).map(medium/number))))
        (jkv "ready" (json/boo (medium/ready target state)))
        (jkv "fields" (json/arr fields)) (jkv "view" view)
        (jkv "expected" (medium/number (state.case(.x target)).fall(0)))
        (jkv "displayed" (medium/number (state.case(.y target)).fall(0)))]
  + frame
    \ root=path world=medium/world state=namespace
    ^ str
    = event_json
        \ event=interaction_runtime/request
        ^ json
        | json/obj [(jkv "id" (json/str event.event))
            (jkv "basis" (medium/number event.expected))
            (jkv "kind" (json/str event.operation)) (jkv "body" (json/str event.body))]
    | show (json/obj [(jkv "protocol" (json/str "grove-medium/1"))
       (jkv "features" (json/arr [(json/str "source-reflection") (json/str "native-definition-actions") (json/str "bound-instantiation") (json/str "definition-scope") (json/str "duplicate-values") (json/str "preserve-open-inputs") (json/str "stable-requirements") (json/str "unanchored-inputs") (json/str "structural-placement") (json/str "explicit-relations") (json/str "retire-unreferenced") (json/str "literal-properties") (json/str "optional-description")]))
       (jkv "expected" (medium/number (state.case(.x root)).fall(0)))
       (jkv "publication" (medium/number (goo_runtime/publication state)))
       (jkv "nodes" (json/arr world.nodes.map((\ target (medium/node_json target state)))))
       (jkv "can_undo" (json/boo !(world.undo.is_nil)))
       (jkv "events" (json/arr world.events.take(24).map(event_json)))])
  + read_selection
    \ selected=medium/selection state=namespace
    ^ myth
    = card (medium/material (medium/record selected.subject state))
      card
        ? (medium/definition selected.subject state)
         > (./some definition) card.put(grove_definition/slot definition)
         > ./none card
    ? (eq selected.slots.len 0) card
    | selected.slots.fold myth/new
      \ out slot
      ? card.get(slot)
       > (./some value) out.put(slot value)
      out
  + definition
    \ subject=path state=namespace
    ^ maybe[grove_definition]
    < node (medium/get_node subject state)
    ? (and (eq node.source "") (eq node.pattern.len 0)) .none
    = root (medium/code_root subject state)
      owner=path [state.self 'app 'medium root.at(root.len.dec)]
    < original (medium/get_node owner state)
    ? (eq original.source "") .none
    | ./some (grove_definition owner root (state.case(.z root)).fall(0) original.source)
  + source_selection
    \ selected=medium/selection
    ^ bool
    | equal[row[path]] selected.slots [grove_definition/slot]
  + selection_ready
    \ selected=medium/selection state=namespace
    ^ bool
    ? (medium/source_selection selected) (maybe/is_some (medium/definition selected.subject state))
    | medium/ready selected.subject state
  + selections
    \ input=json world=medium/world
    ^ maybe[row[medium/selection]]
    ?> (json/arr entries) input .none
    ? (gt entries.len 16) .none
    % rest=row[json] entries out=row[medium/selection] []
    ^ maybe[row[medium/selection]]
    ? (eq rest.len 0) (./some out)
    = entry rest.at(0)
    < subject (path_parse (medium/text "subject" entry))
    ? !((eq subject.len 0) || (world.nodes.has(subject))) .none
    ?> (json/arr values) (grove_dev/field "slots" entry) .none
    ? (gt values.len 32) .none
    = parsed=row[maybe[path]] values.map((\ value (path_parse (grove_dev/text value))))
    ? (row/any[maybe[path]] (\ value (maybe/is_none value)) parsed) .none
    = slots=row[path] parsed.map((\ value value.fall([])))
    ? (slots.has(medium/node_slot)) .none
    ' An unfilled position may retain exact requested slots. It remains open
    ' and cannot execute until an existing subject is explicitly bound.
    | _ rest.drop(1) out.snoc((medium/selection subject slots (medium/text "occurrence" entry)))
  + compute
    \ target=path state=namespace
    ^ either[str namespace]
    ?> (./some node) (medium/get_node target state) (./err "Definition is missing.")
    = card (medium/record target state)
      causes node.inputs.keep((\ selected !(medium/selection_ready selected state))).map((\ selected selected.subject))
    ? ((gt (medium/open target state).len 0) || (gt causes.len 0))
      | goo_runtime/change target card card.put(medium/availability_slot (medium/availability .false causes)) state
    ? (and (eq node.source "") (eq node.pattern.len 0))
      ? card.has(medium/relation_slot)
        | goo_runtime/change target card card.put(medium/availability_slot (medium/availability .false [])) state
      | ./ok state
    = root (medium/code_root target state)
      card (medium/record target state)
    < declared (medium/check_positions root node.inputs.len state state)
    ?> (./some held) (medium/record root.snoc('realize) state).get(grove_backend/module_slot)
      | ./err "The composition must export realize."
    ?> bundle=grove_backend/bundle held (./err "Invalid compiled module.")
    ?> (./some entry) bundle.exports.get([]) (./err "The realize function is missing.")
    ?> realization=grove_realization entry.value (./err "realize must export a native grove_realization.")
    = run realization.run
    ?> (./some ports) (grove_authoring/get state) (./err "Native compiler is unavailable.")
    = inputs node.inputs.map((\ selected (medium/read_selection selected state)))
    ?> (./some held) (medium/record root.snoc('accepts) state).get(grove_backend/module_slot)
      | ./err "The composition must declare an accepts binding contract."
    ?> boundary=grove_backend/bundle held (./err "Invalid boundary module.")
    ?> (./some entry) boundary.exports.get([]) (./err "The boundary check is missing.")
    ?> contract=grove_binding_contract entry.value (./err "accepts must export a native grove_binding_contract.")
    = check
        \ ignored=unit
        ^ any
        = result=either[str unit]
            < roles (medium/check_input_roles root inputs state)
            | (contract.check inputs)
        | medium/boundary_result result
    < checked (ports.pure check)
    ?> result=medium/boundary_result checked (./err "Invalid boundary result.")
    < accepted result.value
    =
      thunk
        \ ignored=unit
        ^ any
        | medium/computed (run inputs (medium/material card))
    < value (ports.pure thunk)
    ?> computed=medium/computed value (./err "Invalid native result.")
    = value=myth computed.value
      outside
        \ pair=mop/kv[path pail]
        ^ bool
        ? (equal[maybe[pail]] card.get(pair.key) (./some pair.val)) .false
        ? (pith_prefix root pair.key) .false
        ? (equal[path] pair.key ['sys 'lede]) .false
        | !(equal[path] pair.key ['sys 'content])
    ? (value.tap.any(outside))
      | ./err "Generated behavior may only write its own slots and text, not native control slots."
    = value
        | value.tap.fold (medium/material card)
        \ out=myth pair=mop/kv[path pail]
        | out.put(pair.key pair.val)
    ?> (./some published) (medium/published target state) (./err "The composition needs a surface view.")
    < checked (goo_runtime/matching_view published value)
    < rendered (goo_bridge/render_at 360 published value checked)
    = output value.put(medium/node_slot node).put(medium/open_slot (medium/open_positions [])).put(medium/availability_slot (medium/availability .true []))
      output (medium/preserve_topology card output)
    | goo_runtime/change target card output state
  + affected
    ' Compare declared input projections, not global revision counters. Source
    ' changes assess every instance of that source; unchanged values stop a cascade.
    \ target=path before=namespace after=namespace
    ^ bool
    ? !(equal[myth] (medium/record target before) (medium/record target after)) .true
    = code (medium/code_root target after)
    ? !(equal[maybe[nat]] (before.case(.z code)) (after.case(.z code))) .true
    = positions (either/ok_val (medium/binding_schema code after))
    ? (positions.any((\ p=grove_binding_position !(equal[maybe[nat]] (before.case(.z p.role)) (after.case(.z p.role)))))) .true
    ?> (./some node) (medium/get_node target after) .true
    | node.inputs.any
      \ selected=medium/selection
      | !(and (equal[myth] (medium/read_selection selected before) (medium/read_selection selected after))
          (eq (medium/selection_ready selected before) (medium/selection_ready selected after)))
  + settle
    ' Input references form a DAG: no circular self-establishment. Multiple
    ' compositions can read the same definition or a selected opaque slot.
    \ nodes=row[path] before=namespace state=namespace
    ^ either[str namespace]
    % pending=row[path] nodes done=row[path] [] state=namespace state rounds=nat 0
    ^ either[str namespace]
    ? (eq pending.len 0) (./ok state)
    ? (ge rounds 64) (./err "Dependency traversal exceeded its bound.")
    = is_ready
        \ target=path
        ^ bool
        = node (medium/get_node target state).fall((medium/node "" [] "" "" []))
        = open=row[nat] (medium/open target state)
          satisfied
            \ i=nat
            ^ bool
            ? (row/has[nat] i open) .true
            ? (medium/source_selection node.inputs.at(i)) .true
            | row/has[path] node.inputs.at(i).subject done
        | (row/range 0 node.inputs.len).all(satisfied)
      ready=row[path] pending.keep(is_ready)
    ? (eq ready.len 0) (./err "This composition would form a dependency cycle.")
    = run
        \ result=either[str namespace] target=path
        ^ either[str namespace]
        < next result
        ? !(medium/affected target before next) (./ok next)
        | medium/compute target next
      result (row/fold[path either[str namespace]] (./ok state) run ready)
    < next result
    | _ pending.keep((\ target=path !(row/has[path] target ready))) done.weld(ready) next rounds.inc
  + save
    \ world=medium/world state=namespace
    ^ medium/saved
    = paths
        | world.nodes.bind
          \ target
          = code (sovereign_care .z (medium/code_root target state) state).tap.map((\ [relative card] (medium/code_root target state).weld(relative)))
          | code.cons(target)
      empty=row[path] []
      distinct
        | paths.fold empty
          \ out target
          ? out.has(target) out
          | out.snoc(target)
      records distinct.map((\ target [target (state.case(.x target)).fall(0)]))
    | medium/saved records world.nodes
  + restore
    \ saved=medium/saved state=namespace
    ^ either[str namespace]
    | saved.records.fold (either/ok[str namespace] state)
      \ result pair
      < next result
      = [target version] pair
      ?> (./known page) state.page(.x (./some version) target)
        | ./err "The retained native history is unavailable."
      ?> (./some record) page.fil
        | ./err "The retained native record is unavailable."
      | goo_runtime/change target (medium/record target next) (unpin record.myth) next
  + commit
    \ request=interaction_runtime/request old=medium/world nodes=row[path] next=namespace state=namespace
    ^ [namespace nat str]
    = assessed (medium/settle nodes state next)
    ? assessed
     > (./err why) (medium/fail state 422 why)
    = settled (either/ok_val assessed)
    = world (medium/world nodes old.events.cons(request).take(128)
        old.undo.cons((medium/save old state)).take(16))
    ? (grove_install/change request.target (writ/poke (myth/sing medium/world_slot world)) settled)
     > (./err why) (medium/fail state 409 "The namespace rejected this operation.")
     > (./ok committed) [committed 200 (medium/frame request.target world committed)]
  + author
    \ edits=row[json] world=medium/world state=namespace
    ^ either[str [row[path] namespace]]
    ? (eq edits.len 0) (./ok [world.nodes state])
    = input edits.at(0)
    ?> (./some selections) (medium/selections (grove_dev/field "inputs" input) world)
      | ./err "Invalid native selections."
    ?> (./some target) (path_parse (medium/text "target" input)) (./err "A native target is required.")
    = root=path [state.self 'app 'medium]
      existing world.nodes.has(target)
    ? !(and (pith_prefix root target) (eq target.len root.len.inc)) (./err "Composition target is outside this workspace.")
    ? (and !existing (ge world.nodes.len 64)) (./err "Workspace subject limit reached.")
    = source (medium/text "source" input)
      label (medium/text "label" input)
      reuse (medium/text "reuse" input)
      scope (medium/text "scope" input)
      shared (eq scope "definition")
      previous (medium/get_node target state).fall((medium/node "" [] "" "" []))
    ? !((eq scope "") || ((eq scope "occurrence") || shared)) (./err "Unknown authoring scope.")
    ? (and shared !(and existing (and (eq reuse "") !(eq previous.pattern.len 0))))
      | ./err "Definition scope requires an established native definition and authored source."
    ? (and shared !(equal[row[medium/selection]] previous.inputs selections))
      | ./err "A shared definition change must preserve this occurrence's bindings. Change a binding explicitly."
    < open (medium/preserve_open previous.inputs selections (medium/open target state))
    ? ((gt source.len 16000) || (eq label "") || (gt label.len 160)) (./err "Source or label exceeds the authored-unit bound.")
    ?> (./some ports) (grove_authoring/get state) (./err "Compiler unavailable.")
    = local=path [state.self 'gov 'medium target.at(target.len.dec)]
      own (? shared (medium/code_root target state) local)
      peers
        | world.nodes.keep
          \ at=path
          | and !(equal[path] at target) (equal[path] (medium/code_root at state) local)
    ? (and !shared (and (eq reuse "") (gt peers.len 0)))
      | ./err "This source is shared by other occurrences. Use definition scope to evolve them together; use native actions for occurrence values. An isolated behavioral fork needs its own definition identity."
    = chosen=either[str [path namespace]]
        ? (eq reuse "")
          ? (eq source "") (./err "Supply native source or reuse an established definition.")
          < compiled (ports.compile own source state)
          | ./ok [own compiled]
        ?> (./some reused) (path_parse reuse) (./err "Invalid reuse reference.")
        ? !(world.nodes.has(reused)) (./err "Reuse an existing composition.")
        ?> (./some origin) (medium/get_node reused state) (./err "No composition at this reference.")
        ? (and (eq origin.source "") (eq origin.pattern.len 0)) (./err "This definition has no established realization yet.")
        | ./ok [(medium/code_root reused state) state]
    < chosen chosen
    = [pattern compiled] chosen
    < declared (medium/check_positions pattern selections.len state compiled)
    = node (medium/node label selections source (medium/text "intent" input) pattern)
      owner=row[path]
        | world.nodes.keep
          \ at
          ?> (./some held) (medium/get_node at state) .false
          | and (equal[path] (medium/code_root at state) pattern) !(eq held.source "")
      source_owner (? (and shared (gt owner.len 0)) owner.at(0) target)
      node node.set_source((? (equal[path] source_owner target) source ""))
      missing (row/range 0 selections.len).keep((\ i (eq selections.at(i).subject.len 0)))
      open open.weld(missing.keep((\ i=nat !(open.has(i)))))
      card (medium/record target state).put(medium/node_slot node).put(medium/open_slot (medium/open_positions open))
    ?> (./ok next) (grove_install/change target (writ/make card) compiled) (./err "Candidate installation failed.")
    = source_update=either[str namespace]
        ? (equal[path] source_owner target) (./ok next)
        ?> (./some held) (medium/get_node source_owner next) (./err "Definition source owner is missing.")
        | goo_runtime/change source_owner (medium/record source_owner next)
            (medium/record source_owner next).put(medium/node_slot held.set_source(source)) next
    < next source_update
    = nodes (? existing world.nodes world.nodes.snoc(target))
    | medium/author edits.drop(1) world.set_nodes(nodes) next
  + handle_indexed
    \ request=interaction_runtime/request state=namespace index=hive
    ^ [namespace hive nat str]
    ? (fit_core/contains ["fit/read" "fit/block" "fit/check-wire" "fit/label" "fit/prepare" "fit/undo"] request.operation)
      | fit_store/handle request state index
    ? ((eq request.operation "native/source") || (eq request.operation "native/author") || (eq request.operation "native/instantiate") || (eq request.operation "native/prepare") || (eq request.operation "native/commit"))
      | construction/handle request state index
    ? ((eq request.operation "native/discover") || (eq request.operation "native/frame") ||
        (eq request.operation "native/inspect") || (eq request.operation "native/act") || (eq request.operation "native/undo"))
      | grove_surface_wire/handle_indexed request state index
    = [next status body] (medium/handle request state)
      next_index (? (eq next.local.top state.local.top) index (sovereign_hive next))
    [next next_index status body]
  + handle
    \ request=interaction_runtime/request state=namespace
    ^ [namespace nat str]
    ? ((eq request.operation "native/discover") || (eq request.operation "native/frame") ||
        (eq request.operation "native/inspect") || (eq request.operation "native/act") || (eq request.operation "native/undo"))
      | grove_surface_wire/handle request state
    = root request.target
    ?> (./some held) (medium/record root state).get(medium/world_slot) (medium/fail state 404 "Workspace missing.")
    ?> world=medium/world held (medium/fail state 409 "Workspace type mismatch.")
    ? !(eq request.principal "administrator") (medium/fail state 403 "Local user gesture authority required.")
    ? (eq request.operation "read") [state 200 (medium/frame root world state)]
    ? (world.events.any((\ event (eq event.event request.event))))
      ? (world.events.has(request)) [state 200 (medium/frame root world state)]
      | medium/fail state 409 "Event identity already used."
    ? !(eq request.expected (state.case(.x root)).fall(0)) (medium/fail state 409 "The canvas changed while this interpretation was being built.")
    ? ((eq request.event.len 0) || (gt request.event.len 80)) (medium/fail state 400 "Invalid event identity.")
    ?> (jres/ok input rest) (parse request.body) (medium/fail state 400 "Invalid interaction.")
    ? !(eq rest 0) (medium/fail state 400 "Trailing input.")
    ? (eq request.operation "define")
      = label (medium/text "label" input)
        target root.snoc(($ta request.event))
      ? ((eq label "") || (gt label.len 160) || (ge world.nodes.len 64)) (medium/fail state 400 "Use a short definition; this workspace holds 64 subjects.")
      = card (myth/sing medium/node_slot (medium/node label [] "" "" []))
        card card.put(['sys 'lede] (pails/t label))
      ?> (./ok next) (grove_install/change target (writ/make card) state) (medium/fail state 409 "Could not create definition.")
      | medium/commit request world world.nodes.snoc(target) next state
    ? (eq request.operation "author")
      ?> (json/arr edits) (grove_dev/field "edits" input) (medium/fail state 400 "An authored change set is required.")
      ? ((eq edits.len 0) || (gt edits.len 8)) (medium/fail state 400 "An atomic change set contains 1–8 authored units.")
      = assessed (medium/author edits world state)
      ? assessed
       > (./err why) (medium/fail state 422 why)
      = result (either/ok_val assessed)
      = [nodes next] result
      | medium/commit request world nodes next state
    ? (eq request.operation "description")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "Choose a native subject.")
      ? !(world.nodes.has(target)) (medium/fail state 404 "Subject missing.")
      = card (medium/record target state)
        slot (path_parse (medium/text "slot" input)).fall([])
        text (medium/text "text" input)
      ? (gt text.len 2000) (medium/fail state 400 "Keep the description within 2000 characters.")
      ? (and (gt slot.len 0) !((medium/properties_of card).any((\ field (equal[path] field.slot slot))))) (medium/fail state 403 "Choose an existing property or the subject.")
      = kept (medium/descriptions_of card).keep((\ [at text] !(equal[path] at slot)))
        descriptions (? (eq text "") kept kept.snoc([slot text]))
        after card.put(medium/descriptions_slot (medium/descriptions descriptions))
      ?> (./ok next) (goo_runtime/change target card after state) (medium/fail state 409 "This description changed before it could be applied.")
      | medium/commit request world world.nodes next state
    ? (eq request.operation "property")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "Choose a native subject.")
      ? !(world.nodes.has(target)) (medium/fail state 404 "Subject missing.")
      = card (medium/record target state)
        fields (medium/properties_of card)
        label (medium/text "label" input)
        value (medium/text "value" input)
        previous (medium/text "slot" input)
      ? (gt value.len 4096) (medium/fail state 400 "Property text is too long.")
      = slot (path_parse previous).fall([])
        fresh (eq previous "")
      ? (and !fresh !(fields.any((\ field (equal[path] field.slot slot))))) (medium/fail state 403 "Use the property's exact native slot.")
      ? (and fresh ((eq label "") || (gt label.len 80))) (medium/fail state 400 "Give this property a short name.")
      ? (and fresh (ge fields.len 32)) (medium/fail state 422 "This proof supports 32 properties per subject.")
      ? (and fresh (fields.any((\ field (eq field.label label))))) (medium/fail state 409 "That property already exists. Edit its value instead.")
      = slot (? fresh (medium/code_root target state).snoc(($ta request.event)) slot)
        fields (? fresh fields.snoc((medium/property label slot)) fields)
        after card.put(slot (pails/t value)).put(medium/properties_slot (medium/properties fields))
      ?> (./ok next) (goo_runtime/change target card after state) (medium/fail state 409 "This property changed before it could be applied.")
      | medium/commit request world world.nodes next state
    ? (eq request.operation "place")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "Choose the native subject to move.")
      ?> (./some parent) (path_parse (medium/text "parent" input)) (medium/fail state 400 "Choose a parent, or / for the canvas.")
      ? !(medium/placement_allowed target parent world.nodes state) (medium/fail state 422 "Containment must use existing subjects and cannot form a cycle.")
      = card (medium/record target state)
        after card.put(medium/placement_slot (medium/placement parent))
      ?> (./ok next) (goo_runtime/change target card after state) (medium/fail state 409 "This placement changed before it could be applied.")
      | medium/commit request world world.nodes next state
    ? (eq request.operation "relate")
      ?> (./some source) (path_parse (medium/text "source" input)) (medium/fail state 400 "Choose a source subject.")
      ?> (./some destination) (path_parse (medium/text "destination" input)) (medium/fail state 400 "Choose a destination subject.")
      ? !(and (world.nodes.has(source)) (world.nodes.has(destination))) (medium/fail state 404 "Both relation endpoints must exist.")
      ? (ge world.nodes.len 64) (medium/fail state 422 "Workspace subject limit reached.")
      = target root.snoc(($ta request.event))
        inputs=row[medium/selection] [(medium/selection source [] "") (medium/selection destination [] "")]
        node (medium/node "Connection" inputs "" "The endpoints are known; their meaning is not established." [])
        card (myth/sing medium/node_slot node).put(medium/relation_slot (medium/relation request.expected))
        card card.put(['sys 'lede] (pails/t "Connection"))
      ?> (./ok next) (grove_install/change target (writ/make card) state) (medium/fail state 409 "The relation could not be created.")
      | medium/commit request world world.nodes.snoc(target) next state
    ? (eq request.operation "retire")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "Choose a native subject.")
      ? !(world.nodes.has(target)) (medium/fail state 404 "Subject missing.")
      = consumers
          | world.nodes.keep
            \ other=path
            ? (equal[path] other target) .false
            ? (equal[path] (medium/parent other state) target) .true
            ?> (./some node) (medium/get_node other state) .true
            ? (node.inputs.any((\ selected (equal[path] selected.subject target)))) .true
            = owned=path [state.self 'gov 'medium target.at(target.len.dec)]
            | and (equal[path] (medium/code_root target state) owned) (equal[path] node.pattern owned)
      ? (gt consumers.len 0) (medium/fail state 422 "This subject still has children, bindings or shared definition uses. Hide its presentation or detach those references first.")
      ' Retirement removes an active root, not history or shared data. Undo
      ' restores the same record; native reachability remains the storage authority.
      | medium/commit request world world.nodes.keep((\ other !(equal[path] other target))) state state
    ? (eq request.operation "detach")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "A native target is required.")
      ? !(world.nodes.has(target)) (medium/fail state 404 "Composition missing.")
      ?> (./some node) (medium/get_node target state) (medium/fail state 404 "Composition missing.")
      ?> (./some index) (medium/input_index target node input state) (medium/fail state 400 "Select an exact requirement identity or input position.")
      ? (ge index node.inputs.len) (medium/fail state 400 "Input position is outside this definition.")
      = open (medium/open target state)
        open (? (open.has(index)) open open.snoc(index))
        card (medium/record target state).put(medium/open_slot (medium/open_positions open))
      ?> (./ok next) (grove_install/change target (writ/poke card) state)
        | medium/fail state 409 "The connection could not be detached."
      | medium/commit request world world.nodes next state
    ? (eq request.operation "rebind")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "A native target is required.")
      ? !(world.nodes.has(target)) (medium/fail state 404 "Composition missing.")
      ?> (./some node) (medium/get_node target state) (medium/fail state 404 "Composition missing.")
      ?> (./some selections) (medium/selections (json/arr [(grove_dev/field "selection" input)]) world)
        | medium/fail state 400 "Invalid input placements."
      ? (eq selections.at(0).subject.len 0) (medium/fail state 400 "Use detach to reopen a requirement.")
      ?> (./some index) (medium/input_index target node input state) (medium/fail state 400 "Select an exact requirement identity or input position.")
      ? (ge index node.inputs.len) (medium/fail state 400 "Input position is outside this definition.")
      = inputs (row/range 0 node.inputs.len).map((\ i (? (eq i index) selections.at(0) node.inputs.at(i))))
        open (medium/open target state).keep((\ i !(eq i index)))
        card (medium/record target state).put(medium/node_slot node.set_inputs(inputs)).put(medium/open_slot (medium/open_positions open))
      ?> (./ok next) (grove_install/change target (writ/make card) state)
        | medium/fail state 409 "Binding change was rejected."
      | medium/commit request world world.nodes next state
    ? ((eq request.operation "instantiate") || (eq request.operation "duplicate"))
      ?> (./some pattern) (path_parse (medium/text "pattern" input)) (medium/fail state 400 "Choose an established composition.")
      ? !(world.nodes.has(pattern)) (medium/fail state 404 "Definition is not in this workspace.")
      ?> (./some origin) (medium/get_node pattern state) (medium/fail state 404 "Definition missing.")
      ? (and (eq origin.source "") (eq origin.pattern.len 0)) (medium/fail state 422 "This word has no reusable behavior yet.")
      ? (ge world.nodes.len 64) (medium/fail state 422 "Workspace subject limit reached.")
      = supplied=maybe[row[medium/selection]] (medium/selections (grove_dev/field "inputs" input) world)
        inputs supplied.fall(origin.inputs)
      ? !(eq inputs.len origin.inputs.len) (medium/fail state 422 "Supply exactly the definition's declared positions.")
      = target root.snoc(($ta request.event))
        node (medium/node origin.label inputs "" "Instance of an established native definition" (medium/code_root pattern state))
        copied (eq request.operation "duplicate")
        values (? copied (medium/material (medium/record pattern state)) (myth/sing ['sys 'lede] (pails/t origin.label)))
        positions (? (maybe/is_some supplied) (row/range 0 inputs.len).keep((\ i (eq inputs.at(i).subject.len 0))) (? copied (medium/open pattern state) (row/range 0 origin.inputs.len)))
        node node.set_intent((? copied "Explicit duplicate: fresh occurrence, copied values, shared references" "Fresh occurrence: definition defaults and open contextual inputs"))
        card values.put(medium/node_slot node).put(medium/open_slot (medium/open_positions positions))
      ?> (./ok next) (grove_install/change target (writ/make card) state) (medium/fail state 409 "Could not instantiate this definition.")
      | medium/commit request world world.nodes.snoc(target) next state
    ? (eq request.operation "instantiate-filled")
      ' One user Add: create, validate through the prepared native action and
      ' attach to its collection in one durable commit (including undo).
      ?> (./some pattern) (path_parse (medium/text "pattern" input)) (medium/fail state 400 "Choose a native definition.")
      ? !(world.nodes.has(pattern)) (medium/fail state 404 "Definition missing.")
      ?> (./some origin) (medium/get_node pattern state) (medium/fail state 404 "Definition missing.")
      ? !(eq origin.inputs.len 0) (medium/fail state 422 "Fill contextual inputs before creating records.")
      ? (ge world.nodes.len 64) (medium/fail state 422 "Workspace subject limit reached.")
      = target root.snoc(($ta request.event))
        code (medium/code_root pattern state)
        view code.snoc('surface)
        controls (medium/text "control" input).split_byte(46)
      ? !(and (gt controls.len 0) (controls.all((\ part (maybe/is_some (nat/parse part)))))) (medium/fail state 400 "Choose an exact native action.")
      = pairs=row[[str str]]
          ?> (json/obj fields) (grove_dev/field "inputs" input) []
          | fields.map((\ field [field.k (grove_dev/text field.v)]))
        node (medium/node origin.label [] "" "Created through a native form" code)
        card (myth/sing medium/node_slot node).put(medium/open_slot (medium/open_positions []))
        card card.put(medium/placement_slot (medium/placement pattern))
        query (goo_runtime/request "act" target target view controls.map((\ part (nat/parse part).fall(0))) 0 0 0 pairs 0)
      ?> (./some ports) (grove_authoring/get state) (medium/fail state 503 "Execution boundary unavailable.")
      = thunk
          \ ignored=unit
          ^ any
          | medium/initial_result (goo_runtime/updated query (medium/record view state) card state)
      ?> (./ok held) (ports.pure thunk) (medium/fail state 422 "Native form validation failed.")
      ?> result=medium/initial_result held (medium/fail state 422 "Invalid native form result.")
      ?> (./ok after) result.value (medium/fail state 422 "Check the record's field values.")
      ? !(medium/owned_output code card after) (medium/fail state 403 "The form attempted to write outside its fields.")
      ?> (./ok next) (grove_install/change target (writ/make after) state) (medium/fail state 409 "Could not create the record.")
      | medium/commit request world world.nodes.snoc(target) next state
    ? (eq request.operation "act")
      ?> (./some target) (path_parse (medium/text "target" input)) (medium/fail state 400 "Invalid subject.")
      ? !(world.nodes.has(target)) (medium/fail state 403 "Unknown subject.")
      = view (medium/code_root target state).snoc('surface)
        controls (medium/text "control" input).split_byte(46)
      ? !(and (gt controls.len 0) (controls.all((\ part (maybe/is_some (nat/parse part)))))) (medium/fail state 400 "Invalid action occurrence.")
      = pairs=row[[str str]]
          ?> (json/obj fields) (grove_dev/field "inputs" input) []
          | fields.map((\ field [field.k (grove_dev/text field.v)]))
        query (goo_runtime/request "act" target target view controls.map((\ part (nat/parse part).fall(0)))
          (nat/parse (medium/text "expected" input)).fall(0)
          (nat/parse (medium/text "displayed" input)).fall(0)
          (nat/parse (medium/text "publication" input)).fall(0) pairs 0)
      ?> (./some ports) (grove_authoring/get state) (medium/fail state 503 "Execution boundary unavailable.")
      = thunk
          \ ignored=unit
          ^ any
          | medium/action_result (goo_runtime/prepare query state)
      = assessed (ports.pure thunk)
      ? assessed
       > (./err why) (medium/fail state 422 why)
      = held (either/ok_val assessed)
      ?> result=medium/action_result held (medium/fail state 422 "Invalid action result.")
      ?> (./ok prepared) result.value (medium/fail state 409 "Action rejected its current input or frame.")
      ? !(medium/owned_output (medium/code_root target state) prepared.before prepared.after)
        | medium/fail state 403 "The action attempted to change another definition's slots."
      = updates=row[[path grove_definition_edit]]
          | prepared.after.tap.bind
            \ pair
            ?> update=grove_definition_edit pair.val []
            ? (equal[maybe[pail]] prepared.before.get(pair.key) (./some pair.val)) []
            | [[pair.key update]]
      ? (gt updates.len 1) (medium/fail state 422 "One action may propose one definition replacement.")
      = after updates.fold(prepared.after (\ card [slot update] card.del(slot)))
      ?> (./ok next) (goo_runtime/change prepared.target prepared.before after state)
        | medium/fail state 409 "The native namespace rejected the action."
      = candidate=either[str namespace]
          ? (eq updates.len 0) (./ok next)
          = [slot update] updates.at(0)
          | medium/replace_definition target update world next
      ?> (./ok next) candidate
        | medium/fail state 422 (either/err_val candidate)
      | medium/commit request world world.nodes next state
    ? (eq request.operation "undo")
      ? world.undo.is_nil (medium/fail state 409 "Nothing to undo.")
      = saved world.undo.head
        restore (medium/restore saved state)
      ?> (./ok next) restore (medium/fail state 409 "Undo was rejected by a native consumer.")
      = changed (medium/world saved.nodes world.events.cons(request).take(128) world.undo.tail)
      ?> (./ok next) (grove_install/change root (writ/poke (myth/sing medium/world_slot changed)) next)
        | medium/fail state 409 "Undo failed."
      [next 200 (medium/frame root changed next)]
    | medium/fail state 400 "Unknown operation."
  + replace_definition
    ' An ordinary native action can construct source. Only a declared, live
    ' source edge grants this operation; source references alone grant nothing.
    \ actor=path update=grove_definition_edit world=medium/world state=namespace
    ^ either[str namespace]
    ?> (./some node) (medium/get_node actor state) (./err "Editor missing.")
    = allowed
        | node.inputs.any
          \ selected
          ? !(medium/source_selection selected) .false
          ?> (./some held) (medium/definition selected.subject state) .false
          | equal[grove_definition] held update.basis
    ? !(and allowed (eq (medium/open actor state).len 0)) (./err "Definition edit has no current source binding, or its basis is stale.")
    ?> (./some origin) (medium/get_node update.basis.subject state) (./err "Source owner missing.")
    = selection_json
        \ selected=medium/selection
        | json/obj [(jkv "subject" (json/str (path_show selected.subject)))
            (jkv "slots" (json/arr selected.slots.map((\ slot (json/str (path_show slot))))))
            (jkv "occurrence" (json/str selected.occurrence))]
      edit (json/obj [(jkv "target" (json/str (path_show update.basis.subject)))
          (jkv "source" (json/str update.source)) (jkv "label" (json/str origin.label))
          (jkv "intent" (json/str origin.intent)) (jkv "reuse" (json/str ""))
          (jkv "scope" (json/str "definition"))
          (jkv "inputs" (json/arr origin.inputs.map(selection_json)))])
    < result (medium/author [edit] world state)
    = [nodes next] result
    | ./ok next
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root=path [state.self 'app 'medium]
      card (myth/sing medium/world_slot (medium/world [] [] .nil))
      card card.put(interaction_runtime/slot (interaction_runtime/endpoint medium/handle))
      card card.put(interaction_runtime/indexed_slot (interaction_runtime/indexed_endpoint medium/handle_indexed))
    ? (grove_install/mount root [[root card]] state)
     > (./ok next)
      ? (maybe/is_none (next.case(.x [next.self 'gov 'material 'records]))) (./ok next)
      | material/install next
     > (./err why) (./err (pails/t "Could not install the native medium."))
