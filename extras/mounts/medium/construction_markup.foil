- grove_surface_wire

' A presentation of actual candidate records, never a model-written claim
' about a source string. Preview controls are inert until native activation.
+ construction_markup
  + name
    \ at=path
    ^ nat
    ? (eq at.len 0) "Root"
    | show/iota (at.at(at.len.dec))
  + value
    \ value=pail
    ^ weft/node
    ? value
     > held=pails/t (weft/tx (str/to_atom held.t))
     > held=pails/n (weft/tx (str/to_atom (nat/show held.n)))
     > held=pails/b (weft/tx (? held.b "Yes" "No"))
     > held=pails/p
      | weft/el "a" [(weft/att "href" (weft/cat2 "/?inspect=" (show/path held.p))) (weft/att "title" (show/path held.p))]
          [(weft/tx (construction_markup/name held.p)) (weft/tx " ↗")]
     > binding=grove_surface_binding
      = reads binding.reads.map((\ input (weft/el "li" [] [(weft/tx "Reads ") (weft/tx (show/path input.p))])))
        writes binding.writes.map((\ scope (weft/el "li" [] [(weft/tx "May edit ") (weft/tx (show/path scope.target))])))
      | weft/el "details" []
          [(weft/el "summary" [] [(weft/tx "Native presentation · inputs and edit scope")])
           (weft/el "ul" [] reads)
           (weft/el "ul" [] writes)]
    | weft/tx "Typed native value · inspect after applying"
  + field
    \ entry=mop/kv[path pail]
    ^ weft/node
    | weft/el "div" [(weft/att "class" "proposal-field")]
        [(weft/el "dt" [(weft/att "title" (show/path entry.key))] [(weft/tx (construction_markup/name entry.key))])
         (weft/el "dd" [] [(construction_markup/value entry.val)])]
  + record
    \ entry=[path myth]
    ^ weft/node
    = [target card] entry
      label (card.txt_at(['sys 'lede]))
      fields card.tap.keep((\ entry !(pith_prefix ['sys] entry.key)))
      hidden card.tap.keep((\ entry (pith_prefix ['sys] entry.key)))
    | weft/el "article" [(weft/att "class" "proposal-record")]
        [(weft/el "h3" [] [(weft/tx "+ ") (weft/tx (? (eq label.len 0) (construction_markup/name target) (str/to_atom label)))])
         (weft/el "dl" [] fields.map(construction_markup/field))
         (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Exact structure and bindings")])
           (weft/el "code" [] [(weft/tx (show/path target))])
           (weft/el "dl" [] hidden.map(construction_markup/field))])]
  + render
    \ records=row[[path myth]] before=row[[path myth]] preview=str
    ^ str
    = html (weft/el "div" [(weft/att "class" "construction-fit")]
        [(weft/el "section" [(weft/att "class" "proposed-structure")]
            [(weft/el "h2" [] [(weft/tx (? (eq before.len 0) "What will be added" "What will change"))])
             (weft/el "p" [] [(weft/tx (? (eq before.len 0) "Checked new structure; existing material is preserved." "The installed native action and its checks produced this correction. Unrelated fields are preserved."))])
             (weft/el "details" [] [(weft/el "summary" [] [(weft/tx "Current values")]) (weft/el "div" [] before.map(construction_markup/record))])
             (weft/el "div" [] records.map(construction_markup/record))])
         (weft/el "section" [(weft/att "class" "proposed-surface")]
            [(weft/el "h2" [] [(weft/tx "How it will look")])
             (weft/el "p" [] [(weft/tx (? (eq preview.len 0) "Structure is checked. No working presentation was supplied yet." "Evaluated with native inputs. Apply to start using it."))])
             (weft/el "div" [(weft/att "data-native-preview" "true") (weft/att "inert" "inert")]
                [(weft/raw (str/to_atom preview))])])])
    | str/from_atom (weft/render html)
