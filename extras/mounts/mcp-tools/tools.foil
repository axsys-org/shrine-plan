- json

'  Tools added through mcp/add-tool. The tool appends one function here;
'  it takes the call's arguments as [name value] text pairs and answers
'  JSON text. The mount is ordinary: compiled, published and versioned
'  like any other, and a restart keeps what was added.
+ mcp_tools_user
  + arg
    '  One argument's text, or the empty string.
    \ name=str args=row[[name=str value=str]]
    ^ str
    = found args.filter((\ [key value] (equal key name)))
    ? (eq found.len 0) ""
    = [key value] found.at(0)
    value
  + example
    '  Echoes its text argument. Here so the mount is never empty.
    \ args=row[[name=str value=str]]
    ^ str
    | show (json/obj [(jkv "ok" (json/boo .true)) (jkv "echo" (json/str (mcp_tools_user/arg "text" args)))])
