- codex_ops
- native_work_ops

' One provider for native work requests. The hand owns dispatch and completion;
' the bridge only performs app-server I/O. Domain admission remains with callers.
- codex_work

+ codex_work_ops
  + make
    \ home=path target=path request=native_work/request
    ^ myth
    = record (native_work_ops/open request.owner "model" (myth/sing ['work 'request] request))
      deps (crew/sing ['guard] (dep request.guard.care request.guard.path))
    | record.put(['codex 'home] (pails/p home)).put(limb_slot (kook [home.weld(['kook 'work])])).put(crew_slot (cpail deps))
  + options
    \ schema=str
    ^ json
    = output=json
        ? (codex_json/decode schema)
         > (./ok value _) value
        jnull
    | codex_ops/object
      [(jkv "retainDeltas" (json/boo .false))
       (jkv "thread" (codex_ops/object
        [(jkv "approvalPolicy" (json/str "never")) (jkv "sandbox" (json/str "read-only"))
         (jkv "ephemeral" (json/boo .true))]))
       (jkv "turn" (codex_ops/object [(jkv "outputSchema" output)]))]
  + advance
    \ b=bowl record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    ?> (./some held) record.get(['work 'request]) (yell [] record)
    ?> request=native_work/request held (yell [] record)
    ?> (./some home) record.path_at(['codex 'home]) (yell [] record)
    ? record.get(['codex 'waiting])
     > (./some held)
      ?> waiting=codex_work/waiting held (yell [] record)
      | codex_work_ops/receive b record waiting
    ?> (./some captured) (native_work_ops/captured_at b.crew.gut(['guard] native_work_ops/empty)) (yell [] record)
    = command=path home.snoc(($ts (str/cat_all ["work_" (nat/show (str/to_atom (path_show b.here)))])))
      input (json/arr [(codex_ops/object [(jkv "type" (json/str "text")) (jkv "text" (json/str request.prompt))])])
      waiting (codex_work/waiting command (pin captured) .none)
      deps (crew/sing ['command] (dep .x command))
      next record.put(['codex 'waiting] waiting).put(crew_slot (cpail deps))
      next (native_work_ops/status "running" next)
    | yell [[command (writ/make (codex_ops/start input (codex_work_ops/options request.schema) .none))]
        [b.here.weld(['context 'guard]) (writ/make (native_work_ops/frozen b.here captured))]] next
  + receive
    \ b=bowl record=myth waiting=codex_work/waiting
    ^ yell
    ? waiting.turn
     > (./some path)
      ?> (./some held) b.crew.gut(['turn] native_work_ops/empty).fil.fall(myth/new).get(codex_slots/result) (yell [] record)
      ?> result=codex/completion held (yell [] record)
      = status=str (? (and (equal result.status "completed") (gt result.text.len 0)) "complete" "failed")
      | native_work_ops/result b.here (native_work/outcome status result.text waiting.guard) record
    = command b.crew.gut(['command] native_work_ops/empty).fil.fall(myth/new)
    ? !(command.nat_at(codex_slots/done 0)) (yell [] record)
    ? !(command.nat_at(codex_slots/ok 0))
      | native_work_ops/result b.here (native_work/outcome "failed" command.txt_at(codex_slots/result) waiting.guard) record
    = result=either[str json]
        ? (codex_json/decode command.txt_at(codex_slots/result))
         > (./ok value _) (./ok value)
        | ./err "Invalid Codex start result"
    ?> (./ok result) result
      | native_work_ops/result b.here (native_work/outcome "failed" "Invalid Codex start result" waiting.guard) record
    = thread (codex_ops/text (codex_ops/get "threadId" result))
      turn (codex_ops/text (codex_ops/get "id" (codex_ops/get "turn" result)))
    ? !(and (gt thread.len 0) (gt turn.len 0))
      | native_work_ops/result b.here (native_work/outcome "failed" "Missing Codex turn identity" waiting.guard) record
    = path=path waiting.command.take(waiting.command.len.dec).snoc((codex_ops/completion_key thread turn))
      deps (crew/sing ['turn] (dep .x path))
    | native_work_ops/wake b record.put(['codex 'waiting] waiting.set_turn((./some path))).put(crew_slot (cpail deps))
  + hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | codex_work_ops/advance b record
  + form
    ^ form
    | def_form.set_init(native_work_ops/wake).set_hear(codex_work_ops/hear).set_talk(codex_work_ops/talk)
  + talk
    \ b=bowl record=myth input=myth
    ^ yell
    | codex_work_ops/advance b record.meld(input)
  + interrupted
    ' A restored namespace retains attempts, not the old app-server process.
    ' Publish a terminal outcome without replaying an uncertain external turn.
    \ target=path record=myth
    ^ maybe[yell]
    ? record.has(['work 'outcome]) .none
    ?> held=codex_work/waiting record.pail_at(['codex 'waiting]) .none
    | native_work_ops/interrupted target held.guard record
  + recover
    \ home=path state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = tree (sovereign_care .z [state.self] state)
    % todo=row[[path myth]] tree.tap out=row[[p=path q=writ]] []
    ^ either[iota row[[p=path q=writ]]]
    ?> (./some pair) todo.pull (./ok out)
    = [entry rest] pair
      [name record] entry
    ?> (./some owner) record.path_at(['codex 'home]) (_ rest out)
    ? !(equal[path] owner home) (_ rest out)
    = target (row/cons[iota] state.self name)
    ?> (./some result) (codex_work_ops/interrupted target record) (_ rest out)
    | _ rest out.weld(result.cards).snoc([target (writ/poke result.out)])
