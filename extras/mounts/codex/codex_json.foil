- json

'  The shared parser preserves permissive number lexemes. Validate those
'  tokens before using it on an external RPC boundary.
+ codex_json
  + digits
    \ text=str offset=nat
    ^ nat
    % i=nat offset
    ? !(digit_byte text.at(i)) i
    | _ i.inc
  + number_end
    '  Zero means invalid; any valid number ends after byte zero.
    \ text=str offset=nat
    ^ nat
    = i (? (eq text.at(offset) 45) offset.inc offset)
      first text.at(i)
    ? !(digit_byte first) 0
    = whole (? (eq first 48) i.inc (codex_json/digits text i))
      fraction
        ? !(eq text.at(whole) 46) whole
        = end (codex_json/digits text whole.inc)
        ? (eq end whole.inc) 0
        end
    ? (eq fraction 0) 0
    ? !((eq text.at(fraction) 101) || (eq text.at(fraction) 69)) fraction
    = sign fraction.inc
      start (? ((eq text.at(sign) 43) || (eq text.at(sign) 45)) sign.inc sign)
      end (codex_json/digits text start)
    ? (eq end start) 0
    end
  + lexical
    \ text=str
    ^ bool
    % i=nat 0
    ? (ge i text.len) .true
    = byte text.at(i)
    ? (eq byte 34)
      ? (p_str text i)
       > (./err why rest) .false
       > (./ok value rest) (_ rest)
    ? ((eq byte 45) || (digit_byte byte))
      = end (codex_json/number_end text i)
      ? (eq end 0) .false
      ? (p_num text i)
       > (./err why rest) .false
       > (./ok value rest)
        ? !(eq end rest) .false
        | _ rest
    | _ i.inc
  + decode
    \ text=str
    ^ jres
    ? !(codex_json/lexical text) (jres/err "invalid-json-token" 0)
    | parse text
