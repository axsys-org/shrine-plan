- codex_ops
- show [at=display]

- codex_foot

+ codex_foot_ops
  + bar
    \ text=str
    ^ nat
    | add (str/to_atom text) (bex (mul 8 text.len))
  + unbar
    \ bytes=nat
    ^ str
    | str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes)))))
  + reader
    '  One outstanding frame per reader; the mailbox remains responsive.
    \ fd=nat self=nat
    ^ nat
    = ;[initial caps] (Recv[nat] 0)
      parent caps.at(0)
    % chunks=row[str] [] size=nat 0 rest=str ""
    ? (eq rest.len 0)
      = ;result (Try (\ ignored=nat (Read fd 16384)) 0)
      ? result
       > (./err cause)
        ; (Send parent (codex_foot/lost "socket read failed"))
        | CloseHandle parent
       > (./ok bytes)
        ? (le bytes 1)
          ; (Send parent (codex_foot/lost "app-server disconnected"))
          | CloseHandle parent
        | _ chunks size (codex_foot_ops/unbar bytes)
    ? (str/find (str/from_atom 10) rest)
     > (./some end)
      ? (gt (add size end) 4194304)
        ; (Send parent (codex_foot/lost "frame exceeds 4 MiB"))
        | CloseHandle parent
      = line (str/cat_all chunks.snoc(rest.slice(0 end)))
      ; (SendCaps parent (codex_foot/line line) [0])
      = ;[ack extras] (Recv[nat] 0)
      ; (helm/supervisor/close_caps extras)
      ? (eq ack 0) (CloseHandle parent)
      | _ [] 0 rest.slice(end.inc (sub rest.len end.inc))
     > .none
      = next (add size rest.len)
      ? (gt next 4194304)
        ; (Send parent (codex_foot/lost "frame exceeds 4 MiB"))
        | CloseHandle parent
      | _ chunks.snoc(rest) next ""
  + send_one
    \ fd=nat ignored=nat message=json
    ^ nat
    ; ignored
    = text (str/cat (str/from_atom 10) (show message))
    | Write fd (codex_foot_ops/bar text)
  + send
    \ fd=nat messages=row[json]
    ^ nat
    | messages.fold 0 (codex_foot_ops/send_one fd)
  + send_if_live
    \ dead=bool fd=nat messages=row[json] ignored=nat
    ^ nat
    ? dead 0
    | codex_foot_ops/send fd messages
  + tool_request
    \ record=myth
    ^ bool
    | and (eq record.txt_at(codex_slots/kind) "request-effect")
        (and (eq record.txt_at(codex_slots/method) "item/tool/call")
          !(record.has(codex_slots/reply_result) || record.has(codex_slots/reply_error)
            || record.nat_at(codex_slots/resolved 0) || record.nat_at(codex_slots/unresolved 0)))
  + tool_record
    ' The mounted driver may give incoming tool requests an ordinary native
    ' hand. Failed or already answered requests never acquire that hand.
    \ record=myth binding=axal[saga]
    ^ myth
    ? !(codex_foot_ops/tool_request record) record
    ?> (./some root) binding.fil record
    ?> (./some handler) (unpin root.myth).path_at(['codex 'tool_handler]) record
    | record.put(limb_slot (kook [handler]))
  + refused_tool
    ' Admission rolled back the incoming request and all reactions. Preserve
    ' that request with a terminal tool reply; the normal transport sends it
    ' only after this replacement record is admitted. Do not replay the hand.
    \ cause=pail write=codex/write binding=axal[saga]
    ^ maybe[codex/write]
    ? !(codex_foot_ops/tool_request write.record) .none
    ?> (./some root) binding.fil .none
    ?> (./some handler) (unpin root.myth).path_at(['codex 'tool_handler]) .none
    = reason (str/cat_all ["Native admission rejected the tool request: " (str/from_atom (display/show/pail cause))])
      response (codex_ops/object [(jkv "success" (json/boo .false))
        (jkv "contentItems" (json/arr [(codex_ops/object
          [(jkv "type" (json/str "inputText")) (jkv "text" (json/str reason))])]))])
      record write.record.put(limb_slot (kook [])).put(crew_slot (cpail (mop/empty)))
      record record.put(codex_slots/reply_result (pails/t (show response)))
    | ./some (codex/write write.key record)
  + refused_turn
    ' A tool can arrive before turn/start's reply. Its hand then wakes when
    ' that command result is admitted. If those reactions fail, retain failure
    ' replies for this turn's already pending tools before retrying the result.
    ' Once answered, these same effect records cannot authorize another retry.
    \ cause=pail write=codex/write p=codex_foot/pending
    ^ row[codex/write]
    ? !(and (write.record.nat_at(codex_slots/done 0)) (write.record.nat_at(codex_slots/ok 0))) []
    ?> (./some command) p.binding.get([write.key]) []
    ? !(eq (unpin command.myth).txt_at(codex_slots/kind) "start") []
    ?> (./ok result rest) (codex_json/decode write.record.txt_at(codex_slots/result)) []
    = thread (codex_ops/text (codex_ops/get "threadId" result))
      turn (codex_ops/text (codex_ops/get "id" (codex_ops/get "turn" result)))
    ? !(and thread.len turn.len) []
    ?> (./some root) p.binding.fil []
    ?> (./some handler) (unpin root.myth).path_at(['codex 'tool_handler]) []
    | p.batch.state.effects.bind
      \ effect=codex/effect
      ? !(codex_ops/turn_effect thread turn effect) []
      ?> (./some retained) p.binding.get([effect.key]) []
      ? !(equal[pail] (unpin retained.myth).pail_at(limb_slot) (kook [handler])) []
      ?> (./some reply) (codex_foot_ops/refused_tool cause (codex/write effect.key (unpin retained.myth)) p.binding) []
      | [reply]
  + flush
    '  Only one unacknowledged namespace write, so ack correlation is exact.
    \ parent=nat p=codex_foot/pending
    ^ codex_foot/pending
    ? p.waiting p
    ? (eq p.batch.writes.len 0) p
    = write p.batch.writes.at(0)
      record (codex_foot_ops/tool_record write.record p.binding)
      operation=writ
        ? p.binding.get([write.key])
         > .none (writ/make record)
         > (./some _) (writ/poke record)
    ; (Send parent (feet/gift/pass [write.key] operation))
    | p.set_waiting(.true)
  + acknowledge
    \ err=maybe[pail] p=codex_foot/pending
    ^ codex_foot/pending
    ? !(p.waiting) p
    ? err
     > .none
      | p.set_waiting(.false).set_batch(p.batch.set_writes(p.batch.writes.drop(1)))
     > (./some cause)
      ? p.batch.writes.len
        ? (codex_foot_ops/refused_tool cause p.batch.writes.at(0) p.binding)
         > (./some replacement)
          | p.set_waiting(.false).set_batch(p.batch.set_writes(p.batch.writes.drop(1).cons(replacement)))
        = replies (codex_foot_ops/refused_turn cause p.batch.writes.at(0) p)
        ? replies.len
          | p.set_waiting(.false).set_batch(p.batch.set_writes(replies.weld(p.batch.writes)))
        | p.set_waiting(.false).set_batch((codex_ops/fail "namespace write rejected" p.batch.set_writes([])))
      | p.set_waiting(.false).set_batch((codex_ops/fail "namespace write rejected" p.batch.set_writes([])))
  + start_wire
    \ fd=nat token=str ignored=nat
    ^ nat
    ; (Write fd (codex_foot_ops/bar (str/cat (str/from_atom 10) token)))
    | codex_foot_ops/send fd (codex_ops/boot).wire
  + credit
    \ dead=bool ignored=nat handle=nat
    ^ nat
    ; ignored
    ; (Send handle (? dead 0 1))
    | CloseHandle handle
  + run
    \ initial=feet/task/init self=nat
    ^ nat
    = config=myth
        ? initial.ax.fil
         > (./some version) (unpin version.myth)
        myth/new
      ;connected (Try (\ ignored=nat (Connect 0 "127.0.0.1" config.nat_at(codex_slots/port 0))) 0)
    ? connected
     > (./err cause)
      | codex_foot_ops/loop 0 initial.parent
        (codex_foot/pending (codex_ops/fail "bridge connection failed" (codex_ops/stale initial.ax (codex_ops/begin codex_ops/initial))) initial.ax .false)
     > (./ok fd)
      = ;started (Try (codex_foot_ops/start_wire fd config.txt_at(codex_slots/token)) 0)
      ? started
       > (./err cause)
        ; (CloseFd fd)
        | codex_foot_ops/loop 0 initial.parent
          (codex_foot/pending (codex_ops/fail "bridge initialization failed" (codex_ops/stale initial.ax (codex_ops/begin codex_ops/initial))) initial.ax .false)
       > (./ok _)
        = ;reader (Spawn (codex_foot_ops/reader fd))
        ; (SendCaps reader 0 [0])
        ; (CloseHandle reader)
        | codex_foot_ops/loop fd initial.parent
          (codex_foot/pending (codex_ops/stale initial.ax (codex_ops/begin (codex_ops/boot).state)) initial.ax .false)
  + incoming
    \ binding=axal[saga] value=json batch=codex/batch
    ^ codex/batch
    = next (codex_ops/incoming value batch)
    ' Queued commands need one scan when initialization opens the bridge.
    ' Later frames carry no namespace changes; facts deliver those separately.
    ? (and !(batch.state.ready) next.state.ready) (codex_ops/scan binding next)
    | next
  + loop
    \ fd=nat parent=nat initial=codex_foot/pending
    ^ nat
    = ;p (codex_foot_ops/flush parent initial)
      ;[message caps] (Recv[codex_foot/task] 0)
      next=codex_foot/pending
        ? message
         > (./fact binding)
          ? binding.fil
           > .none
            | p.set_batch((codex_ops/fail "driver removed" p.batch)).set_binding(binding)
           > (./some _)
            | p.set_batch((codex_ops/scan_changed p.binding binding p.batch)).set_binding(binding)
         > (./ack err)
          | codex_foot_ops/acknowledge err p
         > (codex_foot/lost reason)
          | p.set_batch((codex_ops/fail reason p.batch))
         > (codex_foot/line text)
          ? (gt text.len 4194304)
            | p.set_batch((codex_ops/fail "frame exceeds 4 MiB" p.batch))
          ? (codex_json/decode text)
           > (./err why rest)
            | p.set_batch((codex_ops/fail why p.batch))
           > (./ok value rest)
            | p.set_batch((codex_foot_ops/incoming p.binding value p.batch))
         > (./page path page) p
      next
        ? (gt next.batch.writes.len 4096)
          | next.set_batch((codex_ops/fail "namespace output backlog exceeded" next.batch))
        next
      ;sent (Try (codex_foot_ops/send_if_live next.batch.state.dead fd next.batch.wire) 0)
      next
        ? sent
         > (./ok _) next
         > (./err cause) next.set_batch((codex_ops/fail "socket write failed" next.batch))
    ; (row/fold[nat nat] 0 (codex_foot_ops/credit next.batch.state.dead) caps)
    = ;next_fd
        ? (? next.batch.state.dead (gt fd 0) .false)
          ; (CloseFd fd)
          0
        fd
    | _ next_fd parent next.set_batch(next.batch.set_wire([]))
