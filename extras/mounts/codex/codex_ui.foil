- browser_request
- browser_page
- codex
- http
- weft

+ codex_ui
  + field
    \ name=str record=myth
    ^ str
    | record.txt_at ['post ($ts name)]
  + notice
    \ message=str bad=bool cur=myth
    ^ yell
    | yell [] cur.put(codex_slots/ui_notice (pails/t message)).put(codex_slots/ui_error (pd bad))
  + queue
    \ b=bowl cur=myth command=myth
    ^ yell
    % n=nat cur.nat_at(codex_slots/ui_serial 0).inc
    ^ yell
    = key ($ts (str/cat_all ["ui_" (nat/show n)]))
    ? b.kids.get([key]).is_some
      (_ n.inc)
    | yell [[b.here.snoc(key) (writ/make command)]] cur.put(codex_slots/ui_serial (pd n)).put(codex_slots/ui_notice (pails/t "Queued command")).put(codex_slots/ui_error (pd .false))
  + reply
    \ b=bowl cur=myth add=myth
    ^ yell
    = wanted (codex_ui/field "effect" add)
      items b.kids.kid_tap
    % i=nat 0
    ^ yell
    ? (eq i items.len)
      (codex_ui/notice "Request is no longer pending" .true cur)
    = item items.at(i)
    ? !(equal wanted (path_show [item.key])) (_ i.inc)
    = record item.val.fil.fall(myth/new)
    ? (record.nat_at(codex_slots/resolved 0) || record.nat_at(codex_slots/unresolved 0) || record.get(codex_slots/reply_result).is_some || record.get(codex_slots/reply_error).is_some || !(equal "request-effect" record.txt_at(codex_slots/kind)))
      (codex_ui/notice "Request is no longer pending" .true cur)
    = body (codex_ui/field "reply" add)
    ? (codex_json/decode body)
     > (./err why offset)
      (codex_ui/notice "Reply must be valid JSON" .true cur)
     > (./ok value rest)
      = slot (? (equal "error" (codex_ui/field "reply_kind" add)) codex_slots/reply_error codex_slots/reply_result)
      | yell [[b.here.snoc(item.key) (writ/poke (myth/sing slot (pails/t body)))]] cur.put(codex_slots/ui_notice (pails/t "Reply submitted")).put(codex_slots/ui_error (pd .false))
  + talk
    \ b=bowl cur=myth add=myth
    ^ yell
    = action (codex_ui/field "action" add)
      prompt (codex_ui/field "prompt" add)
      thread (codex_ui/field "thread" add)
      turn (codex_ui/field "turn" add)
      input (json/arr [(codex/object [(jkv "type" (json/str "text")) (jkv "text" (json/str prompt))])])
    ? (equal action "") (yell [] cur.meld(add))
    ? (equal action "reply") (codex_ui/reply b cur add)
    ? ((equal action "start") || (equal action "steer"))
      ? (equal prompt "")
        (codex_ui/notice "Enter a prompt" .true cur)
      ? (equal action "start")
        (codex_ui/queue b cur (codex/start input codex/obj (? (equal thread "") .none (./some thread))))
      ? ((equal thread "") || (equal turn ""))
        (codex_ui/notice "Steer needs a thread and turn ID" .true cur)
      (codex_ui/queue b cur (codex/steer thread turn input))
    ? (equal action "interrupt")
      ? ((equal thread "") || (equal turn ""))
        (codex_ui/notice "Interrupt needs a thread and turn ID" .true cur)
      (codex_ui/queue b cur (codex/interrupt thread turn))
    | codex_ui/notice "Unknown action" .true cur
  + control
    ^ form
    | def_form.set_talk codex_ui/talk
  + hidden
    \ name=str value=str
    ^ weft/node
    | weft/el "input" [(weft/att "type" "hidden") (weft/att "name" name) (weft/att "value" value)] []
  + input
    \ name=str label=str
    ^ weft/node
    | weft/el "label" [] [(weft/leaf "span" [] label) (weft/el "input" [(weft/att "name" name) (weft/att "autocomplete" "off")] [])]
  + event
    \ record=myth
    ^ weft/node
    = payload record.txt_at(codex_slots/payload)
      body
        ? (codex_json/decode payload)
         > (./ok value rest)
          = delta (codex/text (codex/get "delta" value))
          ? (equal delta "") payload
          delta
         > (./err why offset) payload
    | weft/el "article" []
     [(weft/leaf "h3" [] record.txt_at(codex_slots/method))
      (weft/leaf "pre" [] body)]
  + effect
    \ url=str key=iota record=myth
    ^ weft/node
    | weft/el "form" [(weft/att "method" "post") (weft/att "action" url) (weft/att "data-effect" (path_show [key]))] [(codex_ui/hidden "action" "reply") (codex_ui/hidden "effect" (path_show [key])) (weft/leaf "h3" [] record.txt_at(codex_slots/method)) (weft/leaf "pre" [] record.txt_at(codex_slots/payload)) (weft/leaf "p" [] "Submit the JSON result required by this request, or a JSON-RPC error.") (weft/el "select" [(weft/att "name" "reply_kind")] [(weft/leaf "option" [(weft/att "value" "result")] "Result") (weft/leaf "option" [(weft/att "value" "error")] "Error")]) (weft/leaf "textarea" [(weft/att "name" "reply") (weft/att "required" "required") (weft/att "aria-label" "JSON reply")] "") (weft/leaf "button" [] "Submit reply")]
  + page
    \ home=path view=axal[myth]
    ^ nat
    = url (str/cat_all ["/post" (path_show home)])
      cur view.fil.fall(myth/new)
      kids view.kid_tap
      empty=row[weft/node] []
      events0=mop[nat myth lt] (mop/empty)
      events
        | kids.fold events0
         \ out=mop[nat myth lt] item=bee/kv[axal[myth]]
         = record item.val.fil.fall(myth/new)
         ? !(equal "event" record.txt_at(codex_slots/kind)) out
         | out.put record.nat_at(codex_slots/sequence 0) record
      effects
        | kids.fold empty
         \ out=row[weft/node] item=bee/kv[axal[myth]]
         = record item.val.fil.fall(myth/new)
         ? (!(equal "request-effect" record.txt_at(codex_slots/kind)) || record.nat_at(codex_slots/resolved 0) || record.nat_at(codex_slots/unresolved 0) || record.get(codex_slots/reply_result).is_some || record.get(codex_slots/reply_error).is_some) out
         | out.snoc (codex_ui/effect url item.key record)
      commands
        | kids.fold empty
         \ out=row[weft/node] item=bee/kv[axal[myth]]
         = record item.val.fil.fall(myth/new)
           kind record.txt_at(codex_slots/kind)
         ? !((equal kind "start") || (equal kind "steer") || (equal kind "interrupt")) out
         | out.snoc
          (weft/el "article" []
           [(weft/leaf "h3" [] kind)
            (weft/leaf "pre" [] record.txt_at(codex_slots/payload))
            (weft/leaf "pre" [] record.txt_at(codex_slots/result))])
      timeline
        | events.tap.map
         \ item=mop/kv[nat myth]
         | codex_ui/event item.val
    = composer
        | weft/el "form"
         [(weft/att "method" "post") (weft/att "action" url)]
         [(codex_ui/input "thread"
            "Thread ID · leave empty for a new thread")
          (codex_ui/input "turn"
            "Turn ID · required for steer or interrupt")
          (weft/leaf "textarea"
            [(weft/att "name" "prompt")
             (weft/att "aria-label" "Prompt")
             (weft/att "placeholder" "What should Codex do?")] "")
          (weft/el "select" [(weft/att "name" "action")]
            [(weft/leaf "option" [(weft/att "value" "start")]
               "Start turn")
             (weft/leaf "option" [(weft/att "value" "steer")]
               "Steer active turn")
             (weft/leaf "option" [(weft/att "value" "interrupt")]
               "Interrupt turn")])
          (weft/leaf "button" [] "Send")]
    | browser_page/page "Codex · Shrine" codex_ui/css
     [(weft/leaf "h1" [] "Codex")
      (weft/leaf "p" []
        "Prompts, streamed events and replies live in Shrine.")
      (weft/leaf "p"
        [(weft/att "id" "notice")
         (weft/att "data-error"
           (nat/show cur.nat_at(codex_slots/ui_error 0)))]
        cur.txt_at(codex_slots/ui_notice))
      (weft/leaf "p"
        [(weft/att "id" "connection") (weft/att "role" "status")] "")
      composer
      (weft/leaf "h2" [] "Pending requests")
      (weft/el "section" [(weft/att "id" "effects")] effects)
      (weft/leaf "h2" [] "Commands")
      (weft/el "section" [(weft/att "id" "commands")] commands)
      (weft/leaf "h2" [] "Events")
      (weft/el "section" [(weft/att "id" "events")] timeline)
      (weft/el "script" [] [(weft/raw codex_ui/script)])]
  + face_talk
    \ b=bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
      view b.crew.gut(['view] (axal/new[myth] .none))
      page (codex_ui/page (browser_request/tgt_of out) view)
    | yell [] out.put(['res_status] (pd 200)).put(['res_body] (pd page)).put(['res_ctype] (pd "text/html; charset=utf-8"))
  + face
    ^ form
    | def_form.set_talk codex_ui/face_talk
  + css
    ^ nat
    "body{max-width:900px;margin:3rem auto;padding:0 1rem;background:#10191b;color:#e1ebe6;font:16px system-ui}h1{font-size:40px}label{display:block;margin:12px 0}label span{display:block;color:#a5bbb1}input,textarea,select,button{box-sizing:border-box;font:inherit;padding:10px;border:1px solid #405851;border-radius:6px;background:#192925;color:inherit}input,textarea{width:100%}textarea{min-height:120px;margin:12px 0}button{background:#c9ed9a;color:#122018;cursor:pointer;margin:8px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}article,section form{padding:16px;margin:12px 0;background:#192925;border-radius:8px}#notice[data-error='1'],#connection{color:#ffbc9c}"
  + script
    ^ nat
    "(()=>{let busy=false;const by=id=>document.getElementById(id);async function refresh(){const r=await fetch(location.href,{cache:'no-store'});if(!r.ok)throw Error('Refresh failed');const d=new DOMParser().parseFromString(await r.text(),'text/html');for(const id of ['events','commands','notice']){const n=d.getElementById(id);if(!n)throw Error('Console unavailable');if(by(id).outerHTML!==n.outerHTML)by(id).replaceWith(n)}const fresh=d.getElementById('effects');for(const old of [...by('effects').children])if(![...fresh.children].some(n=>n.dataset.effect===old.dataset.effect))old.remove();for(const n of [...fresh.children])if(![...by('effects').children].some(old=>old.dataset.effect===n.dataset.effect))by('effects').append(n);by('connection').textContent=''}document.addEventListener('submit',async e=>{const f=e.target;if(!f.matches('form'))return;e.preventDefault();const button=f.querySelector('button');button.disabled=true;while(busy)await new Promise(r=>setTimeout(r,50));busy=true;try{const r=await fetch(f.getAttribute('action'),{method:'POST',body:new URLSearchParams(new FormData(f))});if(!r.ok)throw Error('Submission failed; your input is retained');await refresh()}catch(err){by('connection').textContent=err.message}finally{busy=false;button.disabled=false}});setInterval(async()=>{if(busy)return;busy=true;try{await refresh()}catch(e){by('connection').textContent='Updates disconnected; retrying'}finally{busy=false}},1500)})()"
