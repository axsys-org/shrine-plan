- codex_foot
- codex_ui

+ codex_driver
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + install
    ' Explicit opt-in on an existing sovereign supervisor.
    \ server=nat home=path port=nat token=str
    ^ nat
    = registry=path home.weld(['kook])
      control=path registry.snoc('control)
      control_record (myth/sing ['sys 'form] codex_ui/control)
      face_record
        . (myth/sing ['sys 'form] codex_ui/face)
         put(['hunt] (hunt .x []))
    ; (codex_driver/submit server home 'kook myth/new)
    ; (codex_driver/submit server registry 'control control_record)
    ; (codex_driver/submit server registry 'face face_record)
    = record (codex/config port token).meld((kooked [control]))
    = request | helm/card/step home (writ/make record)
    ; (SendCaps server request [0])
    = ;[made caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? !(codex_driver/accepted made)
      (error (pails/t "Codex instance creation failed"))
    = registration | helm/supervisor/register home codex_foot/run
    ; (SendCaps server registration [0])
    = ;[reply caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? !(codex_driver/accepted reply)
      (error (pails/t "Codex registration failed"))
    server
  + submit
    \ server=nat home=path key=iota record=myth
    ^ nat
    ; (SendCaps server (helm/card/step home.snoc(key) (writ/make record)) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./ack err)
      ? err
       > .none 1
       > (./some reason) (error reason)
    | error (pails/t "Codex command rejected")
  + reply
    '  result is a JSON payload. error_reply selects a JSON-RPC error.
    \ server=nat home=path key=iota result=json error_reply=bool
    ^ nat
    = record (myth/new).put((? error_reply codex_slots/reply_error codex_slots/reply_result) (pails/t (show result)))
    ; (SendCaps server (helm/card/step home.snoc(key) (writ/poke record)) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./ack err)
      ? err
       > .none 1
       > (./some reason) (error reason)
    | error (pails/t "Codex effect reply rejected")
  + snapshot
    \ server=nat home=path
    ^ axal[saga]
    ; (SendCaps server (helm/card/peek .y .none home) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./page path result)
      ? result
       > (./known binding) binding
      | axal/new[saga] .none
    ; (error (pails/t "Codex snapshot failed"))
    | axal/new[saga] .none
