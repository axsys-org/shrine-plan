- codex_foot_ops
- testing
- tests/namespace [at=fixture]

+ codex_foot_tests
  + acknowledgements
    \ ignored=unit
    ^ row[testing/check]
    = binding (axal/new[saga] .none)
      batch (codex_ops/save 'first myth/new codex_ops/boot)
      batch (codex_ops/save 'second myth/new batch)
      pending (codex_foot/pending batch binding .true)
      ok (codex_foot_ops/acknowledge .none pending)
      rejected (codex_foot_ops/acknowledge (./some (pails/t "rejected")) pending)
      repeated (codex_foot_ops/acknowledge .none ok)
    [(testing/nat "ack consumes one write" 1 ok.batch.writes.len)
     (testing/nat "ack releases serialization barrier" 0 ok.waiting)
     (testing/nat "unmatched ack cannot consume next write" 1 repeated.batch.writes.len)
     (testing/nat "rejected write stops transport" 1 rejected.batch.state.dead)
     (testing/nat "rejected write releases barrier" 0 rejected.waiting)
     (testing/text "rejection publishes terminal error" "driver/error" rejected.batch.writes.at(0).record.txt_at(codex_slots/method))]

  + plant
    \ pax=path record=myth state=namespace
    ^ namespace
    = [next index reply]
        | helm/supervisor/handle (helm/card/step pax (writ/make record)) state (sovereign_hive state)
    next
  + stale
    \ ignored=unit
    ^ row[testing/check]
    = state (codex_foot_tests/plant [($x 1) 'io 'codex] myth/new fixture/namespace_tests/initial)
      state (codex_foot_tests/plant [($x 1) 'io 'codex 'old] (codex_ops/start (json/arr []) codex_ops/obj .none) state)
      state (codex_foot_tests/plant [($x 1) 'io 'codex 'history] (codex_ops/event 41 'driver "old" codex_ops/obj) state)
      binding=axal[saga]
        ? (namespace/page .y .none [($x 1) 'io 'codex] state)
         > (./known tree) tree
        | axal/new[saga] .none
      batch (codex_ops/stale binding (codex_ops/begin (codex_ops/boot).state))
      ready batch.set_state(batch.state.set_ready(.true))
      scanned (codex_ops/scan binding ready)
    [(testing/nat "old command is marked consumed" 1 batch.state.seen.len)
     (testing/nat "old command is not replayed" 0 scanned.wire.len)
     (testing/nat "history sequence continues" 43 batch.state.sequence)
     (testing/nat "old command gets an unresolved result" 0 batch.writes.at(0).record.nat_at(codex_slots/ok 9))]

  + changed_commands
    \ ignored=unit
    ^ row[testing/check]
    = home=path [($x 1) 'io 'codex]
      state (codex_foot_tests/plant home myth/new fixture/namespace_tests/initial)
      command (codex_ops/start (json/arr []) codex_ops/obj .none)
      state (codex_foot_tests/plant home.snoc('one) command state)
      old (codex_foot_tests/binding state)
      next (codex_foot_tests/plant home.snoc('two) command state)
      binding (codex_foot_tests/binding next)
      batch (codex_ops/begin (codex_ops/initial).set_ready(.true))
      changed (codex_ops/scan_changed old binding batch)
      unchanged (codex_ops/scan_changed binding binding batch)
      ' A live token frame cannot revive an unconsumed retained command.
      notice (codex_ops/object [(jkv "method" (json/str "item/agentMessage/delta"))
        (jkv "params" (codex_ops/object [(jkv "threadId" (json/str "missing")) (jkv "turnId" (json/str "missing")) (jkv "delta" (json/str "text"))]))])
      incoming (codex_foot_ops/incoming binding notice batch)
    [(testing/nat "fact delta consumes only the new command" 1 changed.state.seen.len)
     (testing/nat "new command identity retained" 1 (changed.state.seen.any((\ key=iota (eq_iota key 'two)))))
     (testing/nat "identical fact consumes no commands" 0 unchanged.state.seen.len)
     (testing/nat "stream frame consumes no retained commands" 0 incoming.state.seen.len)]

  + rejected_init
    \ b=bowl record=myth
    ^ yell
    | Seq[yell] (error (pails/t "tool reaction failed")) (yell [] record)
  + tool_admission
    \ ignored=unit
    ^ row[testing/check]
    = home=path [($x 1) 'io 'codex]
      handler home.weld(['kook 'surface_effect])
      config (myth/sing ['codex 'tool_handler] (pails/p handler))
      state (codex_foot_tests/plant home config fixture/namespace_tests/initial)
      state (codex_foot_tests/plant handler (myth/sing system_vocabulary/form
        def_form.set_init(codex_foot_tests/rejected_init)) state)
      binding=axal[saga]
        ?> (./known tree) (namespace/page .y .none home state) (axal/new[saga] .none)
        tree
      params (codex_ops/object [(jkv "threadId" (json/str "t1")) (jkv "turnId" (json/str "u1"))
        (jkv "callId" (json/str "call1")) (jkv "tool" (json/str "shrine_act"))
        (jkv "arguments" codex_ops/obj)])
      incoming (codex_ops/object [(jkv "id" (codex_ops/number 7))
        (jkv "method" (json/str "item/tool/call")) (jkv "params" params)])
      transport codex_ops/initial
      transport transport.set_ready(.true).set_sessions([(codex/session "unrelated" "live" .true .true)])
      batch (codex_ops/incoming incoming (codex_ops/begin transport))
      other_request (codex_ops/object [(jkv "id" (codex_ops/number 8))
        (jkv "method" (json/str "item/tool/requestUserInput")) (jkv "params" params)])
      batch (codex_ops/incoming other_request batch)
      request batch.writes.at(0)
      attached (codex_foot_ops/tool_record request.record binding)
      [refused index answer] (helm/supervisor/handle
        (helm/card/step home.snoc(request.key) (writ/make attached)) state (sovereign_hive state))
      failure=maybe[pail]
        ?> (./ack why) answer (./some (pails/t "invalid fixture acknowledgement"))
        why
      pending (codex_foot/pending batch binding .true)
      recovered (codex_foot_ops/acknowledge failure pending)
      replacement recovered.batch.writes.at(0)
      quiet (codex_foot_ops/tool_record replacement.record binding)
      [retained retained_index retained_ack] (helm/supervisor/handle
        (helm/card/step home.snoc(replacement.key) (writ/make quiet)) refused index)
      retained_ok=bool
        ?> (./ack why) retained_ack .false
        | maybe/is_none why
      saved (sovereign_care .x home.snoc(replacement.key) retained).fil.fall(myth/new)
      reply (codex_ops/consume replacement.key saved (codex_ops/begin recovered.batch.state))
      repeated (codex_ops/consume replacement.key saved (codex_ops/begin reply.state))
      refused_again (codex_foot_ops/acknowledge (./some (pails/t "unrecoverable storage admission")) recovered.set_waiting(.true))
      other (codex_ops/request_effect (codex_ops/number 8) "item/tool/requestUserInput" params)
      other_record (codex_foot_ops/tool_record other binding)
    [(testing/nat "incoming tool gets configured native hand" 1 (equal[pail] attached.pail_at(limb_slot) (kook [handler])))
     (testing/nat "unconfigured transport leaves tool untouched" 1 (equal[myth] request.record
       (codex_foot_ops/tool_record request.record (axal/new[saga] .none))))
     (testing/nat "unrelated server request has no tool hand" 0 other_record.has(limb_slot))
     (testing/nat "throwing native hand rejects admission" 1 failure.is_some)
     (testing/nat "rejected request leaves namespace unchanged" 1 (equal[namespace] refused state))
     (testing/nat "tool refusal leaves connection alive" 0 recovered.batch.state.dead)
     (testing/nat "unrelated active turn retained" 1 (equal recovered.batch.state.sessions transport.sessions))
     (testing/nat "unrelated queued request retained" 1 (equal recovered.batch.writes.at(1) batch.writes.at(1)))
     (testing/nat "tool refusal releases acknowledgement barrier" 0 recovered.waiting)
     (testing/nat "no reply emitted before refusal is retained" 0 recovered.batch.wire.len)
     (testing/nat "request RPC correlation retained" 1 (equal[pail] replacement.record.pail_at(codex_slots/request_id) request.record.pail_at(codex_slots/request_id)))
     (testing/nat "original request arguments retained" 1 (equal[pail] replacement.record.pail_at(codex_slots/payload) request.record.pail_at(codex_slots/payload)))
     (testing/nat "failure replacement has no hand to replay" 1 (equal[pail] quiet.pail_at(limb_slot) (kook [])))
     (testing/nat "failure replacement admitted" 1 retained_ok)
     (testing/nat "admitted refusal responds through ordinary transport" 1 reply.wire.len)
     (testing/nat "tool refusal reports failure" 1 (equal[json] (codex_ops/get "success" (codex_ops/get "result" reply.wire.at(0))) (json/boo .false)))
     (testing/nat "tool refusal preserves the other pending effect" 1 reply.state.effects.len)
     (testing/nat "repeated namespace fact cannot send reply twice" 0 repeated.wire.len)
     (testing/nat "refused fallback stops instead of looping" 1 refused_again.batch.state.dead)]

  + early_hear
    \ b=bowl record=myth changed=row[dep]
    ^ yell
    = effect b.crew.gut(['effect] (axal/new[myth] .none)).fil.fall(myth/new)
    ? !(codex_foot_ops/tool_request effect) (yell [] record.put(crew_slot (cpail (mop/empty))))
    = command b.crew.gut(['command] (axal/new[myth] .none)).fil.fall(myth/new)
    ? !(command.nat_at(codex_slots/done 0)) (yell [] record)
    | Seq[yell] (error (pails/t "early tool action failed")) (yell [] record)
  + binding
    \ state=namespace
    ^ axal[saga]
    ?> (./known tree) (namespace/page .y .none [($x 1) 'io 'codex] state) (axal/new[saga] .none)
    tree
  + early_request
    \ id=nat turn=str batch=codex/batch
    ^ codex/batch
    = params (codex_ops/object [(jkv "threadId" (json/str "t1")) (jkv "turnId" (json/str turn))
        (jkv "callId" (json/str (nat/show id))) (jkv "tool" (json/str "shrine_act"))
        (jkv "arguments" codex_ops/obj)])
    | codex_ops/incoming (codex_ops/object [(jkv "id" (codex_ops/number id))
        (jkv "method" (json/str "item/tool/call")) (jkv "params" params)]) batch
  + plant_early
    \ home=path unrelated=iota manual=iota state=namespace write=codex/write
    ^ namespace
    = record (codex_foot_ops/tool_record write.record (codex_foot_tests/binding state))
      record (? (eq_iota write.key manual) record.put(limb_slot (kook [])) record)
      state (codex_foot_tests/plant home.snoc(write.key) record state)
    ? (eq_iota write.key manual) state
    ' I/O records are deliberately excluded from the native observer index.
    ' An ordinary work task owns the reactive dependencies outside /io.
    = task_path=path [home.at(0) 'app 'tools write.key]
      command home.snoc((? (eq_iota write.key unrelated) 'unrelated_start 'start))
      deps (crew/sing ['command] (dep .x command)).put(['effect] (dep .x home.snoc(write.key)))
      task (myth/sing limb_slot record.pail_at(limb_slot)).put(crew_slot (cpail deps))
    | codex_foot_tests/plant task_path task state
  + early_admission
    \ ignored=unit
    ^ row[testing/check]
    = home=path [($x 1) 'io 'codex]
      handler home.weld(['kook 'surface_effect])
      config (myth/sing ['codex 'tool_handler] (pails/p handler))
      state (codex_foot_tests/plant home config fixture/namespace_tests/initial)
      state (codex_foot_tests/plant handler (myth/sing system_vocabulary/form
        def_form.set_hear(codex_foot_tests/early_hear)) state)
      state (codex_foot_tests/plant home.snoc('start) (codex_ops/start (json/arr []) codex_ops/obj .none) state)
      transport codex_ops/initial
      batch (codex_foot_tests/early_request 10 "u1" (codex_ops/begin transport.set_ready(.true)))
      batch (codex_foot_tests/early_request 11 "u1" batch)
      batch (codex_foot_tests/early_request 12 "other" batch)
      batch (codex_foot_tests/early_request 13 "u1" batch)
      other=codex/effect batch.state.effects.at(2)
      manual=codex/effect batch.state.effects.at(3)
      state batch.writes.fold(state (codex_foot_tests/plant_early home other.key manual.key))
      result (codex_ops/object [(jkv "threadId" (json/str "t1"))
        (jkv "turn" (codex_ops/object [(jkv "id" (json/str "u1"))]))])
      finished (codex_ops/finish 'start .true result (codex_ops/begin batch.state))
      completion finished.writes.at(0)
      [refused index answer] (helm/supervisor/handle
        (helm/card/step home.snoc('start) (writ/poke completion.record)) state (sovereign_hive state))
      failure=maybe[pail]
        ?> (./ack why) answer (./some (pails/t "invalid fixture acknowledgement"))
        why
      pending (codex_foot/pending finished (codex_foot_tests/binding refused) .true)
      recovered (codex_foot_ops/acknowledge failure pending)
      first recovered.batch.writes.at(0)
      second recovered.batch.writes.at(1)
      [state1 index1 first_ack] (helm/supervisor/handle
        (helm/card/step home.snoc(first.key) (writ/poke first.record)) refused index)
      [state2 index2 second_ack] (helm/supervisor/handle
        (helm/card/step home.snoc(second.key) (writ/poke second.record)) state1 index1)
      saved_first (sovereign_care .x home.snoc(first.key) state2).fil.fall(myth/new)
      saved_second (sovereign_care .x home.snoc(second.key) state2).fil.fall(myth/new)
      saved_task (sovereign_care .x [home.at(0) 'app 'tools first.key] state2).fil.fall(myth/new)
      [retried retry_index retry_ack] (helm/supervisor/handle
        (helm/card/step home.snoc('start) (writ/poke completion.record)) state2 index2)
      retry_ok=bool
        ?> (./ack why) retry_ack .false
        | maybe/is_none why
      replies (codex_ops/consume first.key saved_first (codex_ops/begin batch.state))
      replies (codex_ops/consume second.key saved_second replies)
      no_retry (codex_foot_ops/refused_turn (pails/t "still refused") completion
        pending.set_binding((codex_foot_tests/binding state2)))
      other_record (sovereign_care .x home.snoc(other.key) state2).fil.fall(myth/new)
      manual_record (sovereign_care .x home.snoc(manual.key) state2).fil.fall(myth/new)
      retried_command (sovereign_care .x home.snoc('start) retried).fil.fall(myth/new)
    [(testing/nat "early request's later action rejects command admission" 1 failure.is_some)
     (testing/nat "failed command and reactions leave namespace unchanged" 1 (equal[namespace] refused state))
     (testing/nat "early tool failure leaves provider alive" 0 recovered.batch.state.dead)
     (testing/nat "both affected tools precede original result and event" 4 recovered.batch.writes.len)
     (testing/nat "original command is queued unchanged" 1 (equal recovered.batch.writes.at(2) completion))
     (testing/nat "first failure retained before retry" 1 saved_first.has(codex_slots/reply_result))
     (testing/nat "second failure retained before retry" 1 saved_second.has(codex_slots/reply_result))
     (testing/nat "another turn's pending tool untouched" 0 other_record.has(codex_slots/reply_result))
     (testing/nat "same-turn manual request without native hand untouched" 0 manual_record.has(codex_slots/reply_result))
     (testing/nat "retry cannot rerun failed effect hand" 1 (equal[pail] saved_first.pail_at(limb_slot) (kook [])))
     (testing/nat "retained failure releases native task subscriptions" 1 (equal[pail] saved_task.pail_at(crew_slot) (cpail (mop/empty))))
     (testing/nat "original command admitted after retained failures" 1 retry_ok)
     (testing/nat "successful command result preserved" 1 retried_command.nat_at(codex_slots/ok 0))
     (testing/nat "normal transport returns two tool failures" 2 replies.wire.len)
     (testing/nat "other turn and manual request remain pending" 2 replies.state.effects.len)
     (testing/nat "already answered effects cannot authorize retry loop" 0 no_retry.len)]

+ tests
  ^ row[testing/case]
  [(testing/case "native fact deltas and stream frames" codex_foot_tests/changed_commands)
   (testing/case "namespace acknowledgements" codex_foot_tests/acknowledgements)
   (testing/case "registration never replays work" codex_foot_tests/stale)
   (testing/case "rejected native tool remains a retained failure" codex_foot_tests/tool_admission)
   (testing/case "early tool refusal retains requests before command retry" codex_foot_tests/early_admission)]
