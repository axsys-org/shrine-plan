- publisher_vocabulary

+ codex_slots
  + command
    | publisher_vocabulary/locate ['codex 'command]
  + done
    | publisher_vocabulary/locate ['codex 'done]
  + kind
    | publisher_vocabulary/locate ['codex 'kind]
  + method
    | publisher_vocabulary/locate ['codex 'method]
  + ok
    | publisher_vocabulary/locate ['codex 'ok]
  + payload
    | publisher_vocabulary/locate ['codex 'payload]
  + port
    | publisher_vocabulary/locate ['codex 'port]
  + reply_error
    | publisher_vocabulary/locate ['codex 'reply_error]
  + reply_result
    | publisher_vocabulary/locate ['codex 'reply_result]
  + request_id
    | publisher_vocabulary/locate ['codex 'request_id]
  + resolved
    | publisher_vocabulary/locate ['codex 'resolved]
  + result
    | publisher_vocabulary/locate ['codex 'result]
  + sequence
    | publisher_vocabulary/locate ['codex 'sequence]
  + token
    | publisher_vocabulary/locate ['codex 'token]
  + unresolved
    | publisher_vocabulary/locate ['codex 'unresolved]
  + ui_serial
    | publisher_vocabulary/locate ['codex 'ui_serial]
  + ui_notice
    | publisher_vocabulary/locate ['codex 'ui_notice]
  + ui_error
    | publisher_vocabulary/locate ['codex 'ui_error]
