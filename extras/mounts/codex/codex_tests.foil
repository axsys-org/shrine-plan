- codex_ops
- testing

+ codex_tests
  + response
    \ id=nat result=json
    ^ json
    | codex_ops/object [(jkv "id" (codex_ops/number id)) (jkv "result" result)]
  + ready
    ^ codex/batch
    | codex_ops/incoming (codex_tests/response 1 codex_ops/obj) (codex_ops/begin (codex_ops/boot).state)
  + thread
    \ id=str
    ^ json
    | codex_ops/object [(jkv "thread" (codex_ops/object [(jkv "id" (json/str id))]))]
  + turn
    \ id=str
    ^ json
    | codex_ops/object [(jkv "turn" (codex_ops/object [(jkv "id" (json/str id))]))]
  + started
    ^ codex/batch
    = b (codex_ops/consume 'c1 (codex_ops/start (json/arr []) codex_ops/obj .none) (codex_ops/begin (codex_tests/ready).state))
      b (codex_ops/incoming (codex_tests/response 2 (codex_tests/thread "t1")) b)
    | codex_ops/incoming (codex_tests/response 3 (codex_tests/turn "u1")) b
  + method
    \ message=json
    ^ str
    | codex_ops/text (codex_ops/get "method" message)
  + handshake
    \ ignored=unit
    ^ row[testing/check]
    = waiting (codex_ops/consume 'early (codex_ops/start (json/arr []) codex_ops/obj .none) codex_ops/boot)
    [(testing/text "initialize first" "initialize" (codex_tests/method (codex_ops/boot).wire.at(0)))
     (testing/nat "not ready before response" 0 (codex_ops/boot).state.ready)
     (testing/nat "early commands stay unconsumed" 0 waiting.state.seen.len)
     (testing/nat "ready after response" 1 (codex_tests/ready).state.ready)
     (testing/text "initialized notification" "initialized" (codex_tests/method (codex_tests/ready).wire.at(0)))]
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = b codex_tests/started
      session (codex_ops/session_at "t1" b.state)
      duplicate (codex_ops/consume 'c1 (codex_ops/start (json/arr []) codex_ops/obj .none) (codex_ops/begin b.state))
      good (codex_ops/consume 'c2 (codex_ops/steer "t1" "u1" (json/arr [])) (codex_ops/begin b.state))
      stale (codex_ops/consume 'c3 (codex_ops/steer "t1" "old" (json/arr [])) (codex_ops/begin b.state))
      stop (codex_ops/consume 'c4 (codex_ops/interrupt "t1" "u1") (codex_ops/begin b.state))
    [(testing/text "thread then turn" "turn/start" (codex_tests/method b.wire.at(1)))
     (testing/text "active turn" "u1" session.turn)
     (testing/nat "duplicate command never resent" 0 duplicate.wire.len)
     (testing/text "steer maps to RPC" "turn/steer" (codex_tests/method good.wire.at(0)))
     (testing/nat "stale steer never sent" 0 stale.wire.len)
     (testing/nat "stale steer completes with error" 0 stale.writes.at(0).record.nat_at(codex_slots/ok 9))
     (testing/text "interrupt RPC" "turn/interrupt" (codex_tests/method stop.wire.at(0)))
     (testing/nat "interrupt acknowledgement does not finish turn" 1 (codex_ops/session_at "t1" stop.state).busy)]
  + resume
    \ ignored=unit
    ^ row[testing/check]
    = b (codex_ops/consume 'resume (codex_ops/start (json/arr []) codex_ops/obj (./some "existing")) (codex_ops/begin (codex_tests/ready).state))
      duplicate (codex_ops/consume 'other (codex_ops/start (json/arr []) codex_ops/obj (./some "existing")) (codex_ops/begin b.state))
      resumed (codex_ops/incoming (codex_tests/response 2 (codex_tests/thread "existing")) b)
      done (codex_ops/notification "turn/completed" (codex_ops/put "threadId" (json/str "t1") (codex_tests/turn "u1")) (codex_ops/begin (codex_tests/started).state))
      next (codex_ops/consume 'next (codex_ops/start (json/arr []) codex_ops/obj (./some "t1")) done)
    [(testing/text "resume unloaded thread" "thread/resume" (codex_tests/method b.wire.at(0)))
     (testing/nat "pending resume excludes a second start" 0 duplicate.wire.len)
     (testing/text "resume then start" "turn/start" (codex_tests/method resumed.wire.at(1)))
     (testing/text "loaded thread starts directly" "turn/start" (codex_tests/method next.wire.at(0)))]
  + request
    \ id=json
    ^ json
    | codex_ops/object [(jkv "id" id) (jkv "method" (json/str "item/tool/requestUserInput"))
        (jkv "params" (codex_ops/object [(jkv "threadId" (json/str "t1"))]))]
  + effects
    \ ignored=unit
    ^ row[testing/check]
    = b (codex_ops/incoming (codex_tests/request (json/str "7")) (codex_ops/begin (codex_tests/started).state))
      c (codex_ops/incoming (codex_tests/request (codex_ops/number 7)) b)
      effect c.state.effects.at(0)
      record (codex_ops/request_effect effect.id "question" codex_ops/obj).put(codex_slots/reply_result (pails/t "{}"))
      answered (codex_ops/consume effect.key record (codex_ops/begin c.state))
      repeated (codex_ops/consume effect.key record (codex_ops/begin answered.state))
      resolved (codex_ops/notification "serverRequest/resolved" (codex_ops/object [(jkv "requestId" (codex_ops/number 7))]) (codex_ops/begin answered.state))
    [(testing/nat "numeric and string IDs distinct" 2 c.state.effects.len)
     (testing/nat "one effect response" 1 answered.wire.len)
     (testing/text "string ID retained" "7" (codex_ops/text (codex_ops/get "id" answered.wire.at(0))))
     (testing/nat "reply not replayed" 0 repeated.wire.len)
     (testing/nat "server resolution removes pending request" 0 resolved.state.effects.len)]
  + failure
    \ ignored=unit
    ^ row[testing/check]
    = started (codex_ops/consume 'c (codex_ops/start (json/arr []) codex_ops/obj .none) (codex_ops/begin (codex_tests/ready).state))
      b (codex_ops/incoming (codex_tests/request (codex_ops/number 9)) started)
      failed (codex_ops/fail "EOF" b)
      again (codex_ops/fail "EOF again" failed)
      invalid (codex_ops/incoming (json/arr []) (codex_ops/begin (codex_tests/ready).state))
    [(testing/nat "failure terminal" 1 failed.state.dead)
     (testing/nat "outstanding RPCs cleared" 0 failed.state.rpcs.len)
     (testing/nat "effects invalidated" 0 failed.state.effects.len)
     (testing/nat "failure idempotent" failed.writes.len again.writes.len)
     (testing/nat "invalid envelope terminal" 1 invalid.state.dead)]

  + races
    \ ignored=unit
    ^ row[testing/check]
    = command (codex_ops/start (json/arr []) codex_ops/obj .none)
      b (codex_ops/consume 'race command (codex_ops/begin (codex_tests/ready).state))
      b (codex_ops/incoming (codex_tests/response 2 (codex_tests/thread "t1")) b)
      b (codex_ops/notification "turn/completed" (codex_ops/put "threadId" (json/str "t1") (codex_tests/turn "u1")) b)
      b (codex_ops/incoming (codex_tests/response 3 (codex_tests/turn "u1")) b)
      effect (codex_ops/put "params" (codex_ops/object [(jkv "threadId" (json/str "t1")) (jkv "turnId" (json/str "u1"))]) (codex_tests/request (codex_ops/number 7)))
      requested (codex_ops/incoming effect (codex_ops/begin (codex_tests/started).state))
      cleared (codex_ops/notification "turn/completed" (codex_ops/put "threadId" (json/str "t1") (codex_tests/turn "u1")) requested)
      late_record (codex_ops/request_effect (codex_ops/number 7) "question" codex_ops/obj).put(codex_slots/reply_result (pails/t "{}"))
      late (codex_ops/consume requested.state.effects.at(0).key late_record (codex_ops/begin cleared.state))
    [(testing/nat "late start response cannot resurrect completed turn" 0 (codex_ops/session_at "t1" b.state).busy)
     (testing/nat "completion clears effect" 0 cleared.state.effects.len)
     (testing/nat "late effect reply ignored" 0 late.wire.len)]
  + rpc_errors
    \ ignored=unit
    ^ row[testing/check]
    = b (codex_ops/consume 'bad (codex_ops/start (json/arr []) codex_ops/obj .none) (codex_ops/begin (codex_tests/ready).state))
      payload (codex_ops/object [(jkv "code" (codex_ops/number 123)) (jkv "message" (json/str "bad input"))])
      b (codex_ops/incoming (codex_ops/object [(jkv "id" (codex_ops/number 2)) (jkv "error" payload)]) b)
      unknown (codex_ops/incoming (codex_tests/response 999 codex_ops/obj) (codex_ops/begin (codex_tests/ready).state))
    [(testing/nat "RPC failure does not kill connection" 0 b.state.dead)
     (testing/nat "RPC removed after error" 0 b.state.rpcs.len)
     (testing/text "error payload preserved" (show payload) b.writes.at(0).record.txt_at(codex_slots/result))
     (testing/nat "unknown response fails closed" 1 unknown.state.dead)]

  + malformed
    \ ignored=unit
    ^ row[testing/check]
    = b (codex_ops/consume 'bad (codex_ops/start (json/arr []) codex_ops/obj .none) (codex_ops/begin (codex_tests/ready).state))
      b (codex_ops/incoming (codex_tests/response 2 codex_ops/obj) b)
    [(testing/nat "malformed response closes connection" 1 b.state.dead)
     (testing/nat "malformed response resolves original command as error" 0 b.writes.at(1).record.nat_at(codex_slots/ok 9))
     (testing/nat "invalid exponent rejected" 1 ?=((./err _ _) (codex_json/decode "1e")))
     (testing/nat "leading zero rejected" 1 ?=((./err _ _) (codex_json/decode "01")))
     (testing/nat "repeated decimal rejected" 1 ?=((./err _ _) (codex_json/decode "1.2.3")))
     (testing/nat "valid exponent accepted" 1 ?=((./ok _ _) (codex_json/decode "[-1.2e+3,0,0.01]")))]
  + completion
    \ ignored=unit
    ^ row[testing/check]
    = message (codex_ops/object [(jkv "threadId" (json/str "t1")) (jkv "turnId" (json/str "u1"))
        (jkv "item" (codex_ops/object [(jkv "type" (json/str "agentMessage")) (jkv "text" (json/str "Final result"))]))])
      b (codex_ops/notification "item/completed" message (codex_ops/begin (codex_tests/started).state))
      params (codex_ops/object [(jkv "threadId" (json/str "t1"))
        (jkv "turn" (codex_ops/object [(jkv "id" (json/str "u1")) (jkv "status" (json/str "completed"))]))])
      done (codex_ops/notification "turn/completed" params (codex_ops/begin b.state))
      key (codex_ops/completion_key "t1" "u1")
      records done.writes.keep((\ write=codex/write (eq_iota write.key key)))
      text=str
        ?> (./some held) records.at(0).record.get(codex_slots/result) ""
        ?> result=codex/completion held ""
        result.text
      repeated (codex_ops/notification "turn/completed" params (codex_ops/begin done.state))
      repeat_records repeated.writes.keep((\ write=codex/write (eq_iota write.key key)))
      disconnected (codex_ops/fail "EOF" (codex_ops/begin (codex_tests/started).state))
      lost disconnected.writes.keep((\ write=codex/write (eq_iota write.key key)))
    [(testing/text "final message is retained in stable completion" "Final result" text)
     (testing/nat "completion publishes once" 1 records.len)
     (testing/nat "duplicate completion cannot erase final text" 0 repeat_records.len)
     (testing/nat "completion identity includes thread" 0 (eq_iota key (codex_ops/completion_key "other" "u1")))
     (testing/nat "disconnect publishes unresolved active turn" 1 lost.len)]

  + background_events
    \ ignored=unit
    ^ row[testing/check]
    = options (codex_ops/object [(jkv "retainDeltas" (json/boo .false))])
      b (codex_ops/consume 'background (codex_ops/start (json/arr []) options .none) (codex_ops/begin (codex_tests/ready).state))
      b (codex_ops/incoming (codex_tests/response 2 (codex_tests/thread "t1")) b)
      b (codex_ops/incoming (codex_tests/response 3 (codex_tests/turn "u1")) b)
      params (codex_ops/object [(jkv "threadId" (json/str "t1")) (jkv "turnId" (json/str "u1")) (jkv "delta" (json/str "text"))])
      quiet (codex_ops/notification "item/agentMessage/delta" params (codex_ops/begin b.state))
      normal (codex_ops/notification "item/agentMessage/delta" params (codex_ops/begin (codex_tests/started).state))
      other (codex_ops/notification "item/agentMessage/delta" (codex_ops/put "threadId" (json/str "other") params) (codex_ops/begin b.state))
      final (codex_ops/notification "item/completed"
        (codex_ops/put "item" (codex_ops/object [(jkv "type" (json/str "agentMessage")) (jkv "text" (json/str "Complete message"))]) params) (codex_ops/begin quiet.state))
      error (codex_ops/notification "error" params (codex_ops/begin b.state))
      request (codex_ops/incoming (codex_tests/request (codex_ops/number 7)) (codex_ops/begin b.state))
    [(testing/nat "background tokens do not create namespace writes" 0 quiet.writes.len)
     (testing/nat "console streaming is retained" 1 normal.writes.len)
     (testing/nat "background policy is scoped to its thread" 1 other.writes.len)
     (testing/text "complete background message is captured" "Complete message" final.state.answers.at(0).text)
     (testing/nat "background errors remain visible" 1 error.writes.len)
     (testing/nat "background server requests remain explicit" 1 request.state.effects.len)
     (testing/nat "retention option is not sent to app-server" 0 (codex_ops/has "retainDeltas" (codex_ops/get "params" b.wire.at(1))))]

+ tests
  ^ row[testing/case]
  [(testing/case "handshake" codex_tests/handshake)
   (testing/case "lifecycle" codex_tests/lifecycle)
   (testing/case "resume and continuation" codex_tests/resume)
   (testing/case "server effects" codex_tests/effects)
   (testing/case "failure" codex_tests/failure)
   (testing/case "completion races" codex_tests/races)
   (testing/case "RPC errors" codex_tests/rpc_errors)
   (testing/case "malformed protocol" codex_tests/malformed)
   (testing/case "stable turn results" codex_tests/completion)
   (testing/case "background event retention" codex_tests/background_events)]
