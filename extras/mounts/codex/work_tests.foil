- codex_work
- testing

+ codex_work_tests
  + home
    ^ path
    [($x 17) 'io 'codex]
  + target
    ^ path
    [($x 17) 'user 'investigation 'workers 'first]
  + initial
    ^ myth
    | codex_work/make codex_work_tests/home codex_work_tests/target
      (native_work/request codex_work_tests/target "Explain the captured value." (native_work/text_schema ["answer"]) (safe 0 .x [($x 17) 'user 'guard]))
  + bowl
    \ views=mop[path axal[myth] lt_pith]
    ^ bowl
    | bowl [] codex_work_tests/target 0 0 native_work/empty views
  + view
    \ slot=path value=axal[myth]
    ^ mop[path axal[myth] lt_pith]
    | mop/put[path axal[myth] lt_pith] slot value (mop/empty)
  + lifecycle
    \ ignored=unit
    ^ row[testing/check]
    = captured (native_work/captured (safe 0 .x [($x 17) 'user 'input]) (./some 7) (pin native_work/empty))
      guard (native_work/empty).put([] (myth/sing ['capture] captured))
      views (codex_work_tests/view ['guard] guard)
      sent (codex_work/advance (codex_work_tests/bowl views) codex_work_tests/initial)
      repeated (codex_work/advance (codex_work_tests/bowl (mop/empty)) sent.out)
      ack (myth/sing codex_slots/done (pd 1)).put(codex_slots/ok (pd 1))
      payload (codex/object [(jkv "threadId" (json/str "thread")) (jkv "turn" (codex/object [(jkv "id" (json/str "turn"))]))])
      ack ack.put(codex_slots/result (pails/t (show payload)))
      watched (codex_work/advance (codex_work_tests/bowl (codex_work_tests/view ['command] (native_work/empty).put([] ack))) sent.out)
      completion (myth/sing codex_slots/result (codex/completion "thread" "turn" "completed" "answer"))
      done (codex_work/advance (codex_work_tests/bowl (codex_work_tests/view ['turn] (native_work/empty).put([] completion))) watched.out)
      duplicate (codex_work/advance (codex_work_tests/bowl (mop/empty)) done.out)
      failed (codex_work/advance (codex_work_tests/bowl (codex_work_tests/view ['turn] (native_work/empty).put([] (myth/sing codex_slots/result (codex/completion "thread" "turn" "interrupted" "partial"))))) watched.out)
      recovered (codex_work/interrupted codex_work_tests/target watched.out)
      recovered_status=str
        ?> (./some result) recovered "missing"
        result.out.txt_at(['work 'status])
    [(testing/nat "dispatch writes command and captured guard" 2 sent.cards.len)
     (testing/nat "pending request is not dispatched twice" 0 repeated.cards.len)
     (testing/text "native work tracks running state" "running" sent.out.txt_at(['work 'status]))
     (testing/text "turn result completes native work" "complete" done.out.txt_at(['work 'status]))
     (testing/nat "one frozen result" 1 done.cards.len)
     (testing/nat "completion is idempotent" 0 duplicate.cards.len)
     (testing/text "interrupted turn fails rather than accepting partial output" "failed" failed.out.txt_at(['work 'status]))
     (testing/text "interruption retains and terminates an outstanding attempt" "failed" recovered_status)
     (testing/nat "interruption does not overwrite completed work" 1 (maybe/is_none (codex_work/interrupted codex_work_tests/target done.out)))]

+ tests
  ^ row[testing/case]
  [(testing/case "native provider hand" codex_work_tests/lifecycle)]
