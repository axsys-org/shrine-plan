- codex_driver

+ codex_mount
  + start
    \ server=nat arguments=row[str]
    ^ nat
    = port | nat/parse arguments.at(0)
    ?> (./some port) port
      | error (pails/t "Invalid companion port")
    ?> (./some home) (path_parse arguments.at(2))
      | error (pails/t "Invalid driver home")
    | codex_driver/install server home port arguments.at(1)
