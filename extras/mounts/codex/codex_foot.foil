- codex

' Persistent contracts: selected as exact pinned module artifacts.
+ codex_foot
  + task
    & feet/task/fact
      feet/task/page
      feet/task/ack
      codex_foot/line
      codex_foot/lost
  + line
    : text=str
  + lost
    : reason=str
  + pending
    : batch=codex/batch binding=axal[saga] waiting=bool
