- codex_slots
- codex_json
- helm

' Persistent contracts: selected as exact pinned module artifacts.
+ codex
  + rpc
    : id=nat command=iota stage=str thread=str body=json
  + session
    : id=str turn=str busy=bool loaded=bool
  + completion
    : thread=str turn=str status=str text=str
  + effect
    : key=iota id=json thread=str turn=str
  + state
    : ready=bool dead=bool next=nat sequence=nat
      rpcs=row[codex/rpc] sessions=row[codex/session]
      effects=row[codex/effect] seen=path ended=row[str] answers=row[codex/completion] quiet=row[str]
  + write
    : key=iota record=myth
  + batch
    : state=codex/state wire=row[json] writes=row[codex/write]
