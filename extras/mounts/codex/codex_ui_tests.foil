- codex_ui
- testing

+ codex_ui_tests
  + context
    \ kids=axal[myth]
    ^ bowl
    | bowl [] [($x 21) 'io 'codex] 0 0 kids (mop/empty)
  + fields
    \ action=str
    ^ myth
    | myth/sing ['post 'action] (pails/t action)
  + commands
    \ ignored=unit
    ^ row[testing/check]
    = b (codex_ui_tests/context (axal/new[myth] .none))
      blank (codex_ui/talk b myth/new (codex_ui_tests/fields "start"))
      input (codex_ui_tests/fields "start").put(['post 'prompt] (pails/t "Hello"))
      queued (codex_ui/talk b myth/new input)
      steer (codex_ui/talk b myth/new (codex_ui_tests/fields "steer").put(['post 'prompt] (pails/t "Change")))
    [(testing/nat "blank prompt emits nothing" 0 blank.cards.len)
     (testing/nat "start queues a child" 1 queued.cards.len)
     (testing/nat "serial persists" 1 queued.out.nat_at(codex_slots/ui_serial 0))
     (testing/nat "transient prompt not stored at root" 0 queued.out.get(['post 'prompt]).is_some)
     (testing/nat "steer requires IDs" 0 steer.cards.len)]
  + replies
    \ ignored=unit
    ^ row[testing/check]
    = record (codex/request_effect (json/str "effect-7") "question" codex/obj)
      kids (axal/new[myth] .none).put(['effect] record)
      b (codex_ui_tests/context kids)
      input (codex_ui_tests/fields "reply").put(['post 'effect] (pails/t (path_show ['effect]))).put(['post 'reply] (pails/t "{}"))
      good (codex_ui/talk b myth/new input)
      invalid (codex_ui/talk b myth/new input.put(['post 'reply] (pails/t "{")))
      closed (codex_ui_tests/context kids.put(['effect] record.put(codex_slots/resolved (pd 1))))
      stale (codex_ui/talk closed myth/new input)
    [(testing/nat "pending request accepts explicit reply" 1 good.cards.len)
     (testing/nat "invalid JSON emits nothing" 0 invalid.cards.len)
     (testing/nat "resolved request emits nothing" 0 stale.cards.len)]

+ tests
  ^ row[testing/case]
  [(testing/case "UI commands" codex_ui_tests/commands)
   (testing/case "UI replies" codex_ui_tests/replies)]
