- development

+ booking_rules
  + reservation
    : identity=path equipment=path person=path start=nat finish=nat
  + query
    : person=path equipment=path start=nat finish=nat
      reservations=row[booking_rules/reservation]
  + outcome
    & booking_rules/outcome/available
      booking_rules/outcome/unavailable
      booking_rules/outcome/unknown
    + available :
    + unavailable : reservation=path until=nat reason=str
    + unknown : reason=str
  + program
    : turnaround=nat same_person=bool
      run={\ booking_rules/query}booking_rules/outcome
  + evaluate
    \ turnaround=nat same_person=bool query=booking_rules/query
    ^ booking_rules/outcome
    ? ((eq query.person.len 0) || (eq query.equipment.len 0))
      | ./unknown "A person and a piece of equipment are required."
    ? !(lt query.start query.finish) (./unknown "End time must follow start time.")
    % i=nat 0
    ^ booking_rules/outcome
    ? (eq i query.reservations.len) .available
    = reservation query.reservations.at(i)
    ? !(equal reservation.equipment query.equipment) (_ i.inc)
    ? ((eq reservation.person.len 0) || !(lt reservation.start reservation.finish))
      | ./unknown "An existing reservation has incomplete information."
    = overlap (and (lt query.start reservation.finish) (lt reservation.start query.finish))
      buffer (? (and same_person (equal query.person reservation.person)) 0 turnaround)
      before (and (le query.finish reservation.start) (gt (add query.finish buffer) reservation.start))
      after (and (ge query.start reservation.finish) (lt query.start (add reservation.finish buffer)))
    ? overlap (./unavailable reservation.identity reservation.finish "Already reserved")
    ? (before || after)
      | ./unavailable reservation.identity (add reservation.finish buffer) "Turnaround time"
    | _ i.inc
  + create
    \ turnaround=nat same_person=bool
    ^ booking_rules/program
    | booking_rules/program turnaround same_person (booking_rules/evaluate turnaround same_person)
  + available
    \ result=booking_rules/outcome
    ^ bool
    ? result
     > ./available .true
    .false
  + describe
    \ result=booking_rules/outcome
    ^ str
    ? result
     > ./available "Available"
     > (./unavailable record until reason) reason
     > (./unknown reason) reason
  + demonstrate
    \ key=path scope=path label=str origin=str basis=nat query=booking_rules/query expected=bool
    ^ commitment/retained[booking_rules/program]
    = check
        \ program=booking_rules/program
        ^ commitment/verdict
        = run program.run
          result (run query)
        ? result
         > (booking_rules/outcome/unknown reason) (commitment/verdict/unknown reason)
        ? (eq expected (booking_rules/available result)) (commitment/verdict/holding)
        | commitment/verdict/failed (booking_rules/describe result)
    | commitment/retained[booking_rules/program] key scope label origin basis check
