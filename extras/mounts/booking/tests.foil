- booking_rules
- testing

+ booking_checks
  + fixture
    ^ row[booking_rules/reservation]
    [(booking_rules/reservation ['reservations 'one] ['equipment 'camera] ['people 'alex] 600 660)]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = query (booking_rules/query ['people 'alex] ['equipment 'camera] 660 720 booking_checks/fixture)
      other query.set_person(['people 'sam])
      baseline (booking_rules/create 0 .false)
      proposed (booking_rules/create 15 .true)
      run proposed.run
      example (booking_rules/demonstrate ['same_person] ['availability] "Same person can continue immediately" "user demonstration" 1 query .true)
      live (development/installed[booking_rules/program] ['availability] 1 baseline [])
      candidate (development/candidate[booking_rules/program] ['availability] 1 1 proposed "Give other people 15 minutes" [example])
      approved (either/ok_val (development/publish[booking_rules/program] 1 .true live candidate))
      later (development/candidate[booking_rules/program] ['availability] 2 2 (booking_rules/create 15 .false) "Remove exception" [])
    [(testing/nat "same-person continuation is available" 1 (booking_rules/available (run query)))
     (testing/nat "different person waits" 0 (booking_rules/available (run other)))
     (testing/nat "buffer exact boundary is available" 1 (booking_rules/available (run other.set_start(675))))
     (testing/nat "actual overlaps rejected even for same person" 0 (booking_rules/available (run query.set_start(650))))
     (testing/nat "buffer applies before as well as after a booking" 0 (booking_rules/available (run other.set_start(550).set_finish(590))))
     (testing/nat "other equipment stays independent" 1 (booking_rules/available (run other.set_equipment(['other]))))
     (testing/nat "missing person remains unknown" 0 (booking_rules/available (run other.set_person([]))))
     (testing/nat "zero-length reservation is invalid" 0 (booking_rules/available (run other.set_finish(660))))
     (testing/nat "later regression fails the retained demonstration" 1
       (either/is_err (development/publish[booking_rules/program] 2 .true approved later)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Equipment availability and retained intention" booking_checks/checks)]
