- http_foot
- lain_peek
- json

' Profiling probe: the two native cards and nothing else.
' GET  /probe/read?path=/0x11/...        one snapshot read, no event
' POST /probe/write  path=... k=v ...    one poke event (merge slots)
' POST /probe/make   path=... k=v ...    one make event (create or replace)
+ probe_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        = parts (http_foot/split 63 request.target)
          url parts.at(0)
          query=str (? (eq parts.len 2) parts.at(1) "")
          fields (http_foot/fields (? (equal request.method "POST") request.body query))
          target (http_foot/target (http_foot/field "path" fields))
        ? (eq target.len 0) (./reply (http_driver/response 400 "path required"))
        ? (equal url "/probe/read")
          | ./snapshot (\ state=namespace (probe_mount/read target state))
        = record (probe_mount/record fields)
        ? (equal url "/probe/write") (./write target (writ/poke record) "/probe/ok")
        ? (equal url "/probe/make") (./write target (writ/make record) "/probe/ok")
        ? (equal url "/probe/ok") (./reply (http_driver/response 200 "ok"))
        ? (equal url "/probe/fail") (./snapshot (\ state=namespace (probe_mount/boom state)))
        | ./reply (http_driver/response 404 "Not found")
    | http_foot/add_routes [(http_foot/route "/probe" plan)] http_foot/empty
  + record
    \ fields=row[[key=str value=str]]
    ^ myth
    | fields.fold myth/new
      \ record [key value]
      ? (equal key "path") record
      | record.put [($ts key)] (pails/t value)
  + read
    \ target=path state=namespace
    ^ [nat str]
    = found (sovereign_peek target state)
      epoch (json/num .false state.local.top)
      kids (json/num .false found.kid.size)
    ?> (./some record) found.fil
      | [404 (show (json/obj [(jkv "epoch" epoch) (jkv "children" kids)]))]
    = n
        ? record.get(['n])
         > (./some held)
          ? held
           > t=pails/t (json/str t.t)
           > n=pails/n (json/num .false n.n)
           | json/nul 0
         > .none (json/nul 0)
    | [200 (show (json/obj [(jkv "epoch" epoch) (jkv "children" kids)
        (jkv "slots" (json/num .false record.size)) (jkv "n" n)]))]
  + boom
    ' A read that fails on purpose: the world must answer 500 and go on.
    \ state=namespace
    ^ [nat str]
    | [200 (path_show [($ts "/not a symbol")])]
