#import lede=sys/lede
#import text=lib/grove/types/text
#import number=lib/grove/types/number

' A fleet, as a template. The world that fronts a domain keeps it. Each
' machine is a seat, filled by that machine's own world. A machine says,
' beneath its seat, which worlds it runs and where each one's door is
' reached on it, and how many more tenants it has room for. The keeper
' reads all of it and nobody else does. Nothing here routes anything or
' starts anything: whoever keeps the front reads these records and sends
' each name to the machine that runs it (x/host), and whoever may create
' machines reads which seats are still empty (x/provision).

machine =
  @role
  #meta ;
    lede: "A machine: what it is called, and what kind of machine is asked for where"
  title: text
  kind: text
  place: text

running =
  @role
  #meta ;
    lede: "A world a machine runs: its name, and the address and port its door answers at"
  name: text
  host: text
  http: number

spare =
  @role
  #meta ;
    lede: "How many more tenants a machine takes, and the name its own door answers under"
  seats: number
  door: text

machines =
  @stencil
  #meta ;
    lede: "A seat for a machine"
  #here ; '/machines/[m=@tas]
  #with ; machine
  #by ; maker
  #for ; '/machines/[m]

worlds =
  @stencil
  #meta ;
    lede: "A world that machine runs, and where its door is reached"
  #here ; '/machines/[m=@tas]/worlds/[w=@tas]
  #with ; running
  #by ; '/machines/[m]
  #for ; maker

room =
  @stencil
  #meta ;
    lede: "How much room that machine has"
  #here ; '/machines/[m=@tas]/room
  #with ; spare
  #by ; '/machines/[m]
  #for ; maker

' The worlds of a fleet's seats are machines' own worlds, each started on
' its own machine: the keeper's host is not asked for them.

"/" =
  @tree
  title: "A fleet"
  elsewhere: 1

"/machines" =
  @tree
