- helm
- net
- scope
- scope_foot
- scope_mount
- weave
- host_mount

' The fleet pack's own foot. A machine's world that fills a machine's seat
' in a fleet says, beneath that seat and for the fleet's keeper alone,
' what the keeper needs to send each name to the right machine: one record
' for each world its own host has placed, with the address and port that
' world's door answers at; and how many more tenants it has room for,
' with the name its own door answers under.
'
' Everything it says is read off what the machine's world already holds:
' the answers its host wrote (extras/mounts/host: worlds/[w]/at) and what
' its host's tenants say is open. Where the world fills no machine's seat
' it says nothing. Nothing here routes or starts anything: whoever keeps
' the front reads these records (x/host --fleet).
+ fleet_mount
  + home
    \ self=iota
    ^ path
    [self 'io 'fleet]
  + stencil
    ' The row of this pack's table where a machine says what it runs, as
    ' a world that holds the pack names it.
    ^ str
    "/gov/fleet/worlds"
  + run
    ' One world a machine runs: the name its ask sits under, the world's
    ' name as it is spelled, and where its door answers.
    : key=iota name=str host=str http=nat
  + seats
    ' Where this world speaks as a machine: each machine's seat it fills,
    ' on its own side of the fleet that seat is in.
    \ state=namespace
    ^ row[path]
    = none=row[path] []
      free=row[weave/bind] []
    | (scope_foot/parts state).fold none
      \ acc=row[path] found=[c=weave/comp s=weave/side]
      ^ row[path]
      = [c s] found
      | c.table.fold acc
        \ out=row[path] p=weave/position
        ^ row[path]
        ? !(equal[str] p.stencil fleet_mount/stencil) out
        ?> (./some seat) (weave/seat_of c s p.writer.seats free s.me state) out
        = under=path s.root.weld(seat)
        | out.snoc(under)
  + named
    ' The name of the world an ask is for, as it is spelled: an ask sits
    ' under n and the world's number.
    \ key=iota
    ^ maybe[str]
    = none=maybe[str] .none
      one=path [key]
      text (path_show one)
    ? (lt text.len 3) none
    ?> (./some number) (nat/parse text.slice(2 text.len)) none
    | ./some (host_mount/spelled number)
  + hosts
    ' The hosts this world keeps: the root of each composition it made
    ' from the host pack.
    \ state=namespace
    ^ row[path]
    = none=row[path] []
      mine=path [state.self 'gov 'host]
    | (sovereign_peek (scope_foot/home state.self) state).tap.fold none
      \ acc [rel record]
      ? !(eq rel.len 1) acc
      ?> (./some held) record.get(['make]) acc
      ?> link=safe held acc
      ? !(equal[path] link.path mine) acc
      ?> (./some root) (scope_foot/rooted record) acc
      | acc.snoc(root)
  + runs
    ' Every world this machine's hosts have placed: each answer that
    ' names a port, by the ask it sits beneath.
    \ state=namespace
    ^ row[fleet_mount/run]
    = none=row[fleet_mount/run] []
    | (fleet_mount/hosts state).fold none
      \ acc=row[fleet_mount/run] root=path
      ^ row[fleet_mount/run]
      | (sovereign_peek root state).tap.fold acc
        \ out [rel record]
        ? !(eq rel.len 5) out
        ? !(eq_iota rel.at(0) 'tenants) out
        ? !(eq_iota rel.at(2) 'worlds) out
        ? !(eq_iota rel.at(4) 'at) out
        = http record.nat_at(['http] 0)
        ? (eq 0 http) out
        ?> (./some name) (fleet_mount/named rel.at(3)) out
        | out.snoc((fleet_mount/run rel.at(3) name record.txt_at(['host]) http))
  + left
    ' How many more tenants this machine takes: what its hosts' tenants
    ' say is open, less what was taken there.
    \ state=namespace
    ^ nat
    | (fleet_mount/hosts state).fold 0
      \ sum=nat root=path
      ^ nat
      = base=path root.weld(['tenants])
        limit (sovereign_care .x base state).fil.fall(myth/new).nat_at(['open] 0)
        [all mine] (scope_foot/took base 0 state)
      ? (ge all limit) sum
      | add sum (sub limit all)
  + says
    ' Everything this world owes the fleet it is a machine in, as it
    ' stands: a record for each world it runs that the fleet does not
    ' hold as it is, and how much room it has, where that has changed.
    \ state=namespace
    ^ row[[p=path q=writ]]
    = none=row[[p=path q=writ]] []
      seats (fleet_mount/seats state)
    ? (eq 0 seats.len) none
    = seat seats.at(0)
      spot=path seat.snoc('room)
      seats_left (fleet_mount/left state)
      door (host_mount/spelled (quip_val state.self))
      has (sovereign_care .x spot state).fil.fall(myth/new)
      roomy=myth (myth/sing ['seats] (pails/n seats_left)).put(['door] (pails/t door))
      room=row[[p=path q=writ]] [[spot (writ/make roomy)]]
      first=row[[p=path q=writ]] (? (and (eq has.nat_at(['seats] 0) seats_left) (equal[str] has.txt_at(['door]) door)) none room)
    | (fleet_mount/runs state).fold first
      \ out=row[[p=path q=writ]] r=fleet_mount/run
      ^ row[[p=path q=writ]]
      = target=path seat.weld(['worlds r.key])
        had (sovereign_care .x target state).fil.fall(myth/new)
        said=myth (myth/sing ['name] (pails/t r.name)).put(['host] (pails/t r.host)).put(['http] (pails/n r.http))
      ? (and (eq had.nat_at(['http] 0) r.http) (equal[str] had.txt_at(['host]) r.host)) out
      | out.snoc([target (writ/make said)])
  + start
    \ server=nat self=iota arguments=row[str]
    ^ nat
    | scope_mount/hand server (fleet_mount/home self) fleet_mount/says
