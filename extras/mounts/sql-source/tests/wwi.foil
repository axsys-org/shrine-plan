- flow_workspace_tests
- flow_web_tests
- flow_library_tests
- flow_web_mount
- flow_test_world [at=live_fixture]

+ live_sql
  \ ignored=unit
  ^ row[testing/check]
  = ;reply (flow_web_foot/fetch "SQL_SOURCE_URL")
  ?> (./ok response) reply.result
    [(testing/nat "live SQL native HTTP capture" 1 0)]
  = done (flow_web_ops/finish flow_web_tests/target (pin flow_web_tests/capture) reply flow_web_tests/initial)
    origin (safe 1 .x (flow_web_tests/target).snoc('result))
    card done.out.put(['work 'result] origin)
    sources (flow_web_ops/sources (flow_ops/empty).put(['responses 'orders] card))
  ?> (./ok sources) sources
    [(testing/nat "native capture becomes source evidence" 1 0)]
  ?> (./ok decoded) (flow_library/decode_sources (flow_ops/empty).rep(['sources] sources))
    [(testing/nat "live SQL JSON becomes cohesive native data" 1 0)]
  = value decoded.get(['orders]).fall(myth/new)
    installed=namespace
      ?> (./ok next) (flow_web_mount/install workspace_tests/initial) workspace_tests/initial
      next
    state (library_tests/author 'live_data "live-data.semidoc" installed)
    definition (library_tests/recipe state 'live_data)
    missing (flow_web/reply reply.requested (./err "SQL source unavailable"))
    failed (flow_web_ops/finish flow_web_tests/target (pin flow_web_tests/capture) missing flow_web_tests/initial)
    refused (flow_web_ops/sources (flow_ops/empty).put(['responses 'orders] failed.out.put(['work 'result] origin)))
  | [(testing/nat "live SQL native HTTP status" 200 response.status)
     (testing/text "live SQL settles existing work" "complete" done.out.txt_at(['work 'status]))
     (testing/nat "decoded native data slot exists" 1 value.has(['data]))
     (testing/nat "decoded SQL retains exact capture origin" 1 (equal[pail] value.pail_at(['flow 'origin]) origin))
     (testing/nat "actual Semidoc composes three published flows" 3 definition.steps.len)
     (testing/nat "failed capture refuses current evidence" 1 (either/is_err refused))]

+ live_flow
  + owner
    ^ path
    [($x 17) 'app 'nenex 'w 'live_data_flow 'work 'import]
  + request
    \ state=namespace
    ^ path
    = owner live_flow/owner
      record (live_fixture/flow_tests/get owner state)
      current (flow_request_ops/requests (bowl [] owner 0 0 flow_ops/empty (sovereign_crew_of (./some record) state)))
      entries current.tap.keep((\ [name card] (and (eq name.len 1) (equal[pail] card.pail_at(['flow 'request_step]) (pails/q 'fetched)))))
    = [name card] entries.at(0)
    | owner.snoc('work).weld(name)
  + deliver
    \ reply=flow_web/reply state=namespace
    ^ namespace
    = target (live_flow/request state)
      worker (live_fixture/flow_tests/get target.snoc('worker) state)
    ?> waiting=flow_web/waiting worker.pail_at(['web 'waiting])
      | Seq[namespace] (error (pails/t "Missing dispatched HTTP work")) state
    ?> (./known tree) (state.page(.x .none waiting.command)) state
    ?> (./some expected) tree.fil state
    = home=path [state.self 'io 'web]
      name waiting.command.drop(home.len)
    ?> (./ok writes) (flow_web_foot/admit home name expected reply state) state
    ?> (./ok next) (grove_install/changes writes state) state
    next
  + check
    \ ignored=unit
    ^ row[testing/check]
    ?> (./ok installed) (flow_web_mount/install workspace_tests/initial)
      [(testing/nat "HTTP owner installs" 1 0)]
    = state (library_tests/author 'live_data "live-data.semidoc" installed)
      page=path [state.self 'app 'nenex 'w 'live_data_flow]
      destination=path [state.self 'app 'nenex 'w 'wwi_import]
      urls=path [state.self 'user 'sql_sources]
      state (live_fixture/flow_tests/poke urls.snoc('orders) (myth/sing ['url] (pails/t "SQL_SOURCE_URL")) state)
      input (myth/sing ['definition] (safe 0 .x page.weld(['flows 'live_data]))).put(['destination] (pails/p destination))
      input input.put(['writer] (safe 0 .x [state.self 'gov 'flows 'nenex])).put(['input 'urls] (safe 0 .z urls))
      started (live_fixture/flow_tests/apply 'follow live_flow/owner input state)
      first (live_flow/request started)
      failed (live_flow/deliver (flow_web/reply "SQL_SOURCE_URL" (./err "Unavailable fixture")) started)
      hole (live_fixture/flow_tests/get first failed).path_at(['work 'hole_path]).fall([])
      retried (live_fixture/flow_tests/apply 'retry_revision first (myth/sing ['expected] (pails/n failed.case(.x first).fall(0))) failed)
      replacement (live_flow/request retried)
      ;reply (flow_web_foot/fetch "SQL_SOURCE_URL")
      done (live_flow/deliver reply retried)
      cells (sovereign_view .z 0 (row/cons[iota] 'x (live_flow/owner).weld(['cells 'work])) done)
      retained (row/all[care] (\ car=care (equal (failed.page(car failed.case(car first) first)) (done.page(car failed.case(car first) first)))) [.x .y .z])
    | [(testing/text "failed HTTP request retains a hole" "waiting" (live_fixture/flow_tests/get hole failed).txt_at(['work 'status]))
       (testing/nat "retry uses a different attempt" 1 !(equal[path] first replacement))
       (testing/text "successful live capture resolves same hole" "resolved" (live_fixture/flow_tests/get hole done).txt_at(['work 'status]))
       (testing/nat "live SQL flow publishes Nenex document" 1 (live_fixture/flow_tests/get destination done).has(['src]))
       (testing/nat "live SQL reference page is published" 1 (live_fixture/flow_tests/get destination.weld(['reference 'orders]) done).has(['src]))
       (testing/nat "shared work cells readable" 1 (?=((./known _) cells)))
       (testing/nat "failed attempt x y z history retained" 1 retained)]

+ tests
  ^ row[testing/case]
  [(testing/case "live WWI through native capture and decoding" live_sql)
   (testing/case "live SQL flow through shared hands, holes and writer" live_flow/check)]
