- http_foot
- lain_peek
- json
- mcp_rpc
- bond
- weft_std
- namespace

' MCP over the native cards and nothing else: a read is one snapshot
' (no event), a write is one poke (one event), history is a snapshot
' over the record's cases, apply is one warp (one event).  Local only.
+ mcp_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = self=iota state.self
      plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(equal request.method "POST") (./reply (http_driver/response 405 "POST required"))
        ? (mcp_rpc/parse_call request.body)
         > (./err why) (./reply (mcp_mount/json (mcp_rpc/failure jnull 32700 why)))
         > (./ok call) (mcp_mount/dispatch self call)
    | http_foot/add_routes [(http_foot/route "/mcp" plan)] http_foot/empty
  + json
    \ body=str
    ^ http_response
    | http_response 200 (str/to_atom body) "application/json"
  + reply
    \ id=json value=json
    ^ http_foot/action
    | ./reply (mcp_mount/json (mcp_rpc/result id value))
  + fail
    \ id=json code=nat message=str
    ^ http_foot/action
    | ./reply (mcp_mount/json (mcp_rpc/failure id code message))
  + refuse
    ' A tool-level error: the call is well formed, the arguments are not.
    \ id=json message=str
    ^ http_foot/action
    | mcp_mount/reply id (mcp_rpc/text_content message .true)
  + dispatch
    \ self=iota call=mcp_rpc/call
    ^ http_foot/action
    ? (equal call.method "initialize") (mcp_mount/reply call.id (mcp_rpc/initialize "shrine"))
    ? (equal call.method "notifications/initialized") (./reply (http_driver/response 202 ""))
    ? (equal call.method "ping") (mcp_mount/reply call.id (json/obj []))
    ? (equal call.method "tools/list") (mcp_mount/reply call.id (mcp_mount/listing mcp_mount/builtins))
    ? !(equal call.method "tools/call") (mcp_mount/fail call.id 32601 "Method not found")
    = name (mcp_rpc/text_at "name" call.params)
      args (mcp_rpc/object_at "arguments" call.params)
    = first=str
        ?> (./some many) (mcp_rpc/field "records" args) (mcp_rpc/text_at "path" args)
        ? many
         > (./arr xs) (? (eq xs.len 0) "" (mcp_rpc/text_at "path" xs.at(0)))
        (mcp_rpc/text_at "path" args)
    ? (and (equal name "mcp/history") (eq first.len 0))
      | ./snapshot (\ state=namespace (mcp_mount/events call.id self (mcp_rpc/num_at "before" 0 args) (mcp_rpc/num_at "limit" 10 args) state))
    ?> (./some pax) (mcp_mount/target self first)
      | mcp_mount/refuse call.id "path: a segmented namespace address is required"
    ? (equal name "mcp/read")
      = c (mcp_mount/care (mcp_rpc/text_at "care" args))
        formula (mcp_rpc/text_at "formula" args)
        at (mcp_rpc/num_at "case" 0 args)
        pax (? (and (gt at 0) !(mcp_mount/derived pax)) (safe at c pax).spell pax)
        limit (mcp_rpc/num_at "limit" 100 args)
        budget (? ((eq limit 0) || (gt limit 500)) 500 limit)
        next_text (mcp_rpc/text_at "next" args)
      ?> (./some cursor) (mcp_mount/cursor self pax next_text)
        | mcp_mount/refuse call.id "next: the cursor a previous page of this same read answered"
      ? (gt formula.len 0)
        ?> (./some settings) (mcp_mount/record (mcp_rpc/object_at "settings" args))
          | mcp_mount/refuse call.id "settings: the formula's parameters, as slot names to values"
        | ./snapshot (\ state=namespace (mcp_mount/searched call.id c pax ($ts formula) settings cursor budget state))
      | ./snapshot (\ state=namespace (mcp_mount/read call.id c pax cursor budget state))
    ? (equal name "mcp/history")
      = limit (mcp_rpc/num_at "limit" 10 args)
      | ./snapshot (\ state=namespace (mcp_mount/history call.id pax limit state))
    ? (equal name "mcp/write")
      = then (mcp_mount/paths self (mcp_rpc/field "then" args))
        specs=row[json]
          ?> (./some many) (mcp_rpc/field "records" args) [args]
          ? many
           > (./arr xs) xs
          [args]
      ? (specs.any((\ spec=json (gt (mcp_rpc/text_at "from" spec).len 0))))
        | mcp_mount/write_from self call.id specs then
      ? (mcp_mount/writes self specs)
       > (./ok writes) (mcp_mount/batch call.id writes then)
       > (./err why) (mcp_mount/refuse call.id why)
    ? (equal name "mcp/apply")
      ?> (./some op) (mcp_mount/target self (mcp_rpc/text_at "operation" args))
        | mcp_mount/refuse call.id "operation: the address of an op card is required"
      ?> (./some input) (mcp_mount/record (mcp_rpc/object_at "inputs" args))
        | mcp_mount/refuse call.id "inputs: argument slots to values"
      | mcp_mount/batch call.id [[pax (writ/warp op input)]] (mcp_mount/paths self (mcp_rpc/field "then" args))
    | mcp_mount/refuse call.id "Unknown tool"
  ' ---- addresses and values
  + target
    \ self=iota text=str
    ^ maybe[path]
    ? (eq text.len 0) .none
    ?> (./some parsed) (path_parse text) .none
    ? (eq parsed.len 0) (./some [self])
    ? (eq_iota parsed.at(0) self) (./some parsed)
    ? ((is_h parsed) || ((is_o parsed) || ((is_xv parsed) || ((is_cx parsed) || (eq_iota parsed.at(0) 'sys))))) (./some parsed)
    | ./some parsed.cons(self)
  + care
    \ text=str
    ^ care
    ? (equal text "x") .x
    ? (equal text "z") .z
    .y
  + care_of
    \ seg=iota
    ^ maybe[care]
    ? (eq_iota seg 'x) (./some .x)
    ? (eq_iota seg 'y) (./some .y)
    ? (eq_iota seg 'z) (./some .z)
    .none
  + reference
    ' /h/<care>/<case>/<len>/<path>; case 0 is live.
    \ text=str
    ^ maybe[safe]
    ?> (./some p) (path_parse text) .none
    ? (lt p.len 4) .none
    ? !(eq_iota p.at(0) 'h) .none
    ?> (./some c) (mcp_mount/care_of p.at(1)) .none
    ?> (./some ver) (dig_of p.at(2)) .none
    ?> (./some ln) (dig_of p.at(3)) .none
    = tgt p.drop(4)
    ? !(eq tgt.len ln) .none
    | ./some (safe ver c tgt)
  + pail_of
    \ value=json
    ^ maybe[pail]
    ? value
     > (./str s) (./some (pails/t s))
     > (./num neg n) (? neg .none (./some (pails/n n)))
     > (./boo b) (./some (pails/b b))
     > (./obj kvs)
      = kind (mcp_rpc/text_at "type" value)
        text (mcp_rpc/text_at "value" value)
      ? (equal kind "str") (./some (pails/t text))
      ? (equal kind "bool") (./some (pails/b (equal text "true")))
      ? (equal kind "nat")
        ?> (./some n) (nat/parse text) .none
        | ./some (pails/n n)
      ? (equal kind "path")
        ?> (./some p) (path_parse text) .none
        | ./some (pails/p p)
      ? (equal kind "reference")
        ?> (./some pin) (mcp_mount/reference text) .none
        | ./some pin
      .none
    .none
  + record
    ' Slot names are paths: "sys/weft" and "/sys/weft" both name /sys/weft.
    \ properties=json
    ^ maybe[myth]
    ? properties
     > (./obj kvs)
      % i=nat 0 out=myth myth/new
      ^ maybe[myth]
      ? (eq i kvs.len) (./some out)
      = entry kvs.at(i)
        name (? (and (gt entry.k.len 0) (eq entry.k.at(0) 47)) entry.k (str/cat_all ["/" entry.k]))
      ?> (./some slot) (path_parse name) .none
      ?> (./some held) (mcp_mount/pail_of entry.v) .none
      | _ i.inc out.put(slot held)
    .none
  + shown
    ' A path as text, never raising: a key that is not a printable
    ' symbol renders as a marker instead of failing the read.
    \ pax=path
    ^ str
    ? (Try path_show pax)
     > (./ok text) text
     > (./err _) "<unprintable path>"
  + iota_text
    \ q=iota
    ^ str
    ? (Try iota_show q)
     > (./ok text) text
     > (./err _) "<unprintable key>"
  + value_text
    \ held=pail
    ^ str
    ? held
     > x=pails/t x.t
     > n=pails/n (nat/show n.n)
     > b=pails/b (? b.b "true" "false")
     > p=pails/p (mcp_mount/shown p.p)
     > q=pails/q (mcp_mount/iota_text q.q)
     > pin=safe (mcp_mount/shown pin.spell)
    "<opaque>"
  + record_json
    \ t=myth
    ^ json
    | json/obj t.tap.map((\ [key val] (jkv (mcp_mount/shown key) (json/str (mcp_mount/value_text val)))))
  + reference_of
    ' The pinned x view of a path, when it has a case.
    \ pax=path state=namespace
    ^ json
    ?> (./some n) (mcp_mount/case_of pax state) jnull
    | json/str (mcp_mount/shown (safe n .x pax).spell)
  + reference_y
    ' The pinned y view: what a cell's tack pins to freeze an input.
    \ pax=path state=namespace
    ^ json
    ? (mcp_mount/derived pax) jnull
    ?> (./some n) state.local.y_case(pax) jnull
    | json/str (mcp_mount/shown (safe n .y pax).spell)
  + reference_z
    ' The pinned z view: the whole subtree frozen at its case.
    \ pax=path state=namespace
    ^ json
    ? (mcp_mount/derived pax) jnull
    ?> (./some n) state.local.z_case(pax) jnull
    | json/str (mcp_mount/shown (safe n .z pax).spell)
  + searched
    ' A read with a formula: the named standard cell run over the
    ' snapshot with the settings as its context.  A cell that was never
    ' written: no event, no record, the same evaluation.
    \ id=json c=care pax=path name=iota settings=myth after=maybe[path] budget=nat state=namespace
    ^ [nat str]
    ?> (./some ck) (weft_std/by_name name)
      | [200 (mcp_rpc/result id (mcp_rpc/text_content "formula: not a standard cell" .true))]
    = tree (sorge[myth] c (sovereign_peek pax state))
      [ctx out] (ck.get settings tree)
      [view nodes last more] (mcp_mount/paged pax out state after budget)
      body (json/obj [(jkv "formula" (json/str (mcp_mount/iota_text name))) (jkv "result" view)
                      (jkv "context" (mcp_mount/record_json ctx))
                      (jkv "nodes" (json/num .false nodes)) (jkv "next" (mcp_mount/cursor_json last more))])
    | [200 (mcp_rpc/result id (mcp_rpc/structured body))]
  + node_json
    ' One node's own fields, without its children.
    \ pax=path tree=axal[myth] state=namespace
    ^ row[jkv]
    = props
        ?> (./some record) tree.fil (json/obj [])
        | mcp_mount/record_json record
    | [(jkv "path" (json/str (mcp_mount/shown pax)))
       (jkv "exists" (json/boo (maybe/is_some tree.fil)))
       (jkv "reference" (mcp_mount/reference_of pax state))
       (jkv "reference_y" (mcp_mount/reference_y pax state))
       (jkv "reference_z" (mcp_mount/reference_z pax state))
       (jkv "properties" props)]
  + paged
    ' A tree rendered in tap order (a node, then its children by name)
    ' within a budget of nodes, continuing after a cursor (the last
    ' path a previous page rendered, relative to this node): the json,
    ' the nodes rendered, the last path rendered, and whether nodes
    ' remain.  A node an earlier page rendered that still has children
    ' to render comes back as a shell (path and children, "paged"
    ' true); shells do not count against the budget.  Every page is
    ' the same tree cut at the same places for the same case, so a
    ' page can be re-read.
    \ pax=path tree=axal[myth] state=namespace after=maybe[path] budget=nat
    ^ [json nat maybe[path] bool]
    = fresh !(maybe/is_some after)
    ? (and fresh (eq budget 0)) [jnull 0 .none .true]
    = none=maybe[path] .none
      seek=maybe[iota]
        ?> (./some c) after .none
        ? (eq c.len 0) .none
        | ./some c.at(0)
      rest=maybe[path]
        ?> (./some c) after .none
        ? (eq c.len 0) .none
        | ./some c.drop(1)
      empty=row[json] []
      ' phase: 0 seeking the cursor's child, 1 rendering, 2 stopped with nodes remaining
      start=[nat row[json] maybe[path] nat] [(? fresh budget.dec budget) empty (? fresh (./some pax) none) (? (maybe/is_some seek) 0 1)]
      [left out last phase]
        | tree.kid_tap.fold start
          \ acc [key child]
          = [l o la ph] acc
          ? (eq ph 2) acc
          = on_cursor (and (eq ph 0) (eq_iota key (seek.fall(key))))
          ? (and (eq ph 0) !on_cursor) acc
          = below=maybe[path] (? on_cursor rest none)
          ? (and !on_cursor (eq l 0)) [l o la 2]
          = [j n la2 m2] (mcp_mount/paged pax.snoc(key) child state below l)
          ' a shell with nothing rendered beneath it (the cursor node itself, say) is not sent again
          | [(sub l n) (? (eq n 0) o o.snoc(j)) (? (maybe/is_some la2) la2 la) (? m2 2 1)]
      children (jkv "children" (json/arr out))
      shown=json
        ? fresh (json/obj (mcp_mount/node_json pax tree state).snoc(children))
        | json/obj [(jkv "path" (json/str (mcp_mount/shown pax))) (jkv "paged" (json/boo .true)) children]
    | [shown (sub budget left) last (eq phase 2)]
  + cursor
    ' The cursor of a read: the last path a previous page rendered,
    ' which must lie under the path being read; none when absent.
    \ self=iota pax=path text=str
    ^ maybe[maybe[path]]
    = none=maybe[path] .none
    ? (eq text.len 0) (./some none)
    ?> (./some p) (mcp_mount/target self text) .none
    ? !(and (ge p.len pax.len) (pith_prefix pax p)) .none
    | ./some (./some p.drop(pax.len))
  + cursor_json
    \ last=maybe[path] more=bool
    ^ json
    ? !more jnull
    ?> (./some p) last jnull
    | json/str (mcp_mount/shown p)
  + case_of
    \ pax=path state=namespace
    ^ maybe[nat]
    ? ((is_xv pax) || (is_cx pax)) (xv_case pax state.local)
    ? ((is_h pax) || (is_o pax)) .none
    | state.local.x_case(pax)
  ' ---- the four answers
  + read
    ' A read answers at most `budget` nodes (the limit, never above
    ' 500) in tap order and names the last path rendered as `next`
    ' when nodes remain; the same read with that `next` continues.
    \ id=json c=care pax=path after=maybe[path] budget=nat state=namespace
    ^ [nat str]
    = tree (sorge[myth] c (sovereign_peek pax state))
      [view nodes last more] (mcp_mount/paged pax tree state after budget)
      body=json
        ? view
         > (./obj kvs) (json/obj kvs.snoc((jkv "nodes" (json/num .false nodes))).snoc((jkv "next" (mcp_mount/cursor_json last more))))
        view
    | [200 (mcp_rpc/result id (mcp_rpc/structured body))]
  + history
    \ id=json pax=path limit=nat state=namespace
    ^ [nat str]
    = cases (mcp_mount/case_of pax state).fall(0)
      bound (? ((eq limit 0) || (gt limit 40)) 40 limit)
      count (? (lt cases bound) cases bound)
    % i=nat 0 out=row[json] []
    ^ [nat str]
    ? (eq i count)
      | [200 (mcp_rpc/result id (mcp_rpc/structured (json/obj
          [(jkv "path" (json/str (mcp_mount/shown pax))) (jkv "cases" (json/num .false cases)) (jkv "versions" (json/arr out))])))]
    = pin (safe (sub cases i) .x pax)
      tree (sovereign_peek pin.spell state)
      props
        ?> (./some record) tree.fil (json/obj [])
        | mcp_mount/record_json record
      item (json/obj [(jkv "case" (json/num .false (sub cases i))) (jkv "reference" (json/str (mcp_mount/shown pin.spell))) (jkv "properties" props)])
    | _ i.inc out.snoc(item)
  + paths
    ' The paths named in a then list.
    \ self=iota value=maybe[json]
    ^ row[path]
    ?> (./some list) value []
    ? list
     > (./arr xs)
      = none=row[path] []
      | xs.fold none
        \ acc=row[path] x=json
        ?> (./some t) (mcp_rpc/text_of x) acc
        ?> (./some pax) (mcp_mount/target self t) acc
        acc.snoc(pax)
    []
  + slots_of
    ' The slots of a write spec: slots, or properties for older clients.
    \ spec=json
    ^ json
    ?> (./some v) (mcp_rpc/field "slots" spec) (mcp_rpc/object_at "properties" spec)
    v
  + derived
    \ pax=path
    ^ bool
    | ((is_h pax) || ((is_o pax) || ((is_xv pax) || (is_cx pax))))
  + writes
    ' One writ per record spec, or the reason the whole batch is refused
    ' before any event: a derived path, a bad path, or bad properties.
    \ self=iota specs=row[json]
    ^ either[str row[[path writ]]]
    = none=row[[path writ]] []
    | specs.fold (either/ok[str row[[path writ]]] none)
      \ acc spec
      ?> (./ok out) acc acc
      ?> (./some pax) (mcp_mount/target self (mcp_rpc/text_at "path" spec)) (./err "path: a segmented namespace address is required on every record")
      ? (mcp_mount/derived pax) (./err (str/cat_all ["path: " (mcp_mount/shown pax) " is derived and cannot be written"]))
      = action (mcp_rpc/text_at "action" spec)
      ? (equal action "cull") (./ok out.snoc([pax .cull]))
      ?> (./some record) (mcp_mount/record (mcp_mount/slots_of spec)) (./err "slots: slot names to text, numbers, booleans or {type, value}")
      ? (equal action "poke") (./ok out.snoc([pax (writ/poke record)]))
      | ./ok out.snoc([pax (writ/make record)])
  + batch
    ' The records as one event (admitted whole or refused whole), then
    ' the then reads on the admitted state, in one answer.
    \ id=json writes=row[[path writ]] then=row[path]
    ^ http_foot/action
    | ./batch writes (\ outcome=maybe[pail] state=namespace (mcp_mount/finished id writes then outcome state))
  + finished
    \ id=json writes=row[[path writ]] then=row[path] outcome=maybe[pail] state=namespace
    ^ [nat str]
    = refused (maybe/is_some outcome)
      admitted !refused
      records=row[json]
        | writes.map
          \ [pax wit]
          | json/obj [(jkv "path" (json/str (mcp_mount/shown pax))) (jkv "written" (json/boo admitted))
                      (jkv "reference" (? admitted (mcp_mount/reference_of pax state) jnull))]
      reads=row[jkv]
        | then.map
          \ pax=path
          = none=maybe[path] .none
            [view nodes last more] (mcp_mount/paged pax (sorge[myth] .y (sovereign_peek pax state)) state none 100)
          | jkv (mcp_mount/shown pax) view
      body (json/obj [(jkv "epoch" (json/num .false state.local.top)) (jkv "records" (json/arr records)) (jkv "refused" (json/boo refused)) (jkv "then" (json/obj reads))])
    ? refused
      | [200 (mcp_rpc/result id (mcp_rpc/structured_error body))]
    | [200 (mcp_rpc/result id (mcp_rpc/structured body))]
  + typed_json
    ' A record as {slot: {type, value}}: what write accepts back.
    \ t=myth
    ^ json
    = none=row[jkv] []
      members
        | t.tap.fold none
          \ acc=row[jkv] [key val]
          = pair=maybe[[str str]]
              ? val
               > x=pails/t (./some ["str" x.t])
               > n=pails/n (./some ["nat" (nat/show n.n)])
               > b=pails/b (./some ["bool" (? b.b "true" "false")])
               > p=pails/p (./some ["path" (mcp_mount/shown p.p)])
               > pin=safe (./some ["reference" (mcp_mount/shown pin.spell)])
              .none
          ?> (./some kv) pair acc
          = [kind text] kv
          | acc.snoc((jkv (mcp_mount/shown key) (json/obj [(jkv "type" (json/str kind)) (jkv "value" (json/str text))])))
    | json/obj members
  + write_from
    ' Records whose content comes from another path (an earlier case,
    ' usually): one snapshot renders every source with its types, then
    ' the batch runs; a missing source refuses the whole write.
    \ self=iota id=json specs=row[json] then=row[path]
    ^ http_foot/action
    = read
        \ state=namespace
        ^ [nat str]
        = empty=row[jkv] []
          sources=row[jkv]
            | specs.fold empty
              \ acc=row[jkv] spec=json
              = from (mcp_rpc/text_at "from" spec)
              ? (eq from.len 0) acc.snoc((jkv (mcp_rpc/text_at "path" spec) (mcp_mount/slots_of spec)))
              ?> (./some src) (mcp_mount/target self from) acc.snoc((jkv (mcp_rpc/text_at "path" spec) jnull))
              ?> (./some record) (sovereign_peek src state).fil acc.snoc((jkv (mcp_rpc/text_at "path" spec) jnull))
              | acc.snoc((jkv (mcp_rpc/text_at "path" spec) (mcp_mount/typed_json record)))
        | [200 (show (json/obj sources))]
      next
        \ status=nat body=str
        ^ http_foot/action
        ? (mcp_rpc/parse_object body)
         > (./err why) (mcp_mount/refuse id (str/cat_all ["from: " why]))
         > (./ok sources)
          = missing (sources.any((\ e=jkv ?=((./nul _) e.v))))
          ? missing (mcp_mount/refuse id "from: no record at that case; nothing was written")
          = filled=row[json]
              | sources.map (\ e=jkv (json/obj [(jkv "path" (json/str e.k)) (jkv "properties" e.v)]))
          ? (mcp_mount/writes self filled)
           > (./ok writes) (mcp_mount/batch id writes then)
           > (./err why) (mcp_mount/refuse id why)
    | ./after read next
  + no_json
    ^ row[json]
    []
  + events
    ' The event log newest first: each epoch with the paths it touched,
    ' and a next cursor for the page before.
    \ id=json self=iota before=nat limit=nat state=namespace
    ^ [nat str]
    = log (sovereign_peek [self 'log] state)
      bound (? ((eq limit 0) || (gt limit 40)) 40 limit)
      nothing=row[nat] []
      epochs=row[nat]
        | log.kid_tap.fold nothing
          \ acc=row[nat] [key child]
          ?> (./some n) (dig_of key) acc
          ? (and (gt before 0) !(lt n before)) acc
          acc.snoc(n)
      newest (weft_std/ranked epochs.map((\ n=nat [n [($u n)] myth/new])) .true)
      page newest.take((? (lt newest.len bound) newest.len bound))
      items=row[json]
        | page.map
          \ [n p rec]
          = touched=row[json]
              ?> (./some entry) log.kid_get(p.at(0)) []
              ?> (./some record) entry.fil []
              ?> (./some held) record.get(['sys 'content]) []
              ?> event=namespace_event held []
              | (unpin event.changes).tap.fold (mcp_mount/no_json)
                \ acc=row[json] [p q]
                ? (eq p.len 0) acc
                acc.snoc((json/str (mcp_mount/shown p)))
          | json/obj [(jkv "epoch" (json/num .false n)) (jkv "touched" (json/arr touched))]
      next
        ? (gt newest.len bound)
          = [n p rec] newest.at(bound.dec)
          | json/num .false n
        jnull
    | [200 (mcp_rpc/result id (mcp_rpc/structured (json/obj [(jkv "events" (json/arr items)) (jkv "next" next)])))]
  + commit
    \ id=json pax=path wit=writ
    ^ http_foot/action
    | ./commit pax wit (\ err=maybe[pail] (mcp_mount/written id pax err))
  + written
    \ id=json pax=path err=maybe[pail]
    ^ http_response
    ? err
     > .none
      | mcp_mount/json (mcp_rpc/result id (mcp_rpc/structured (json/obj [(jkv "path" (json/str (mcp_mount/shown pax))) (jkv "written" (json/boo .true))])))
     > (./some _)
      | mcp_mount/json (mcp_rpc/result id (mcp_rpc/text_content "Namespace write rejected" .true))
  ' ---- the tool list
  + param
    : name=str kind=str desc=str
  + tool
    : name=str desc=str params=row[mcp_mount/param] required=row[str]
  + p
    \ name=str kind=str desc=str
    ^ mcp_mount/param
    | mcp_mount/param name kind desc
  + path_param
    ^ mcp_mount/param
    | mcp_mount/p "path" "string" "Segmented namespace address, absolute (/<node>/...) or relative to the node. Derived addresses read too: /x/<cell> is a cell's result, /c/x/<cell> its context (parameters, /sys/view/missing, /sys/view/fault), /h/<care>/<case>/<len>/<path> a pinned view."
  + builtins
    ^ row[mcp_mount/tool]
    [(mcp_mount/tool "mcp/read" "Read a record, its slots, its children and its pinned reference. Inert: no event."
       [mcp_mount/path_param (mcp_mount/p "care" "string" "x the record, y the record and its children, z the subtree. Default y.")
        (mcp_mount/p "limit" "number" "Nodes per answer, in tap order (a node, then its children by name). Default 100, never more than 500.")
        (mcp_mount/p "next" "string" "The next cursor a previous page of this same read answered: the page after it.")]
       ["path"])
     (mcp_mount/tool "mcp/write" "Write slots through ordinary admission: one event. Values are text, numbers, booleans, or {type, value} with type nat, str, bool, path or reference (a /h/<care>/<case>/<len>/<path> spelling; case 0 is live)."
       [mcp_mount/path_param (mcp_mount/p "properties" "object" "Slot names to values. A cell is /sys/weft (reference to a standard cell under /weft/stdlib, x care) plus /sys/tack (reference to its input, y care) plus its parameters.")
        (mcp_mount/p "action" "string" "Omitted or make writes the whole record (creating or replacing it); poke merges slots into an existing record; cull deletes the subtree.")]
       ["path"])
     (mcp_mount/tool "mcp/history" "The record's x cases, newest first, each with its pinned reference and slots. Inert."
       [mcp_mount/path_param (mcp_mount/p "limit" "number" "Newest cases to return. Default 10, maximum 40.")]
       ["path"])
     (mcp_mount/tool "mcp/apply" "Apply a declared /op to the record with transient inputs: one event."
       [mcp_mount/path_param (mcp_mount/p "operation" "string" "Address of the op card.")
        (mcp_mount/p "inputs" "object" "Argument slots to values, encoded as for write.")]
       ["path" "operation"])]
  + param_json
    \ param=mcp_mount/param
    ^ jkv
    | jkv param.name (json/obj [(jkv "type" (json/str param.kind)) (jkv "description" (json/str param.desc))])
  + schema
    \ tool=mcp_mount/tool
    ^ json
    | json/obj
      [(jkv "type" (json/str "object"))
       (jkv "properties" (json/obj tool.params.map(mcp_mount/param_json)))
       (jkv "required" (json/arr tool.required.map((\ name=str (json/str name)))))]
  + to_json
    \ tool=mcp_mount/tool
    ^ json
    | json/obj
      [(jkv "name" (json/str tool.name))
       (jkv "description" (json/str tool.desc))
       (jkv "inputSchema" (mcp_mount/schema tool))]
  + listing
    \ tools=row[mcp_mount/tool]
    ^ json
    | json/obj [(jkv "tools" (json/arr tools.map(mcp_mount/to_json)))]
