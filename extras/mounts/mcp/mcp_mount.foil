- http_foot
- mcp_foot

'  The /mcp route. What can be answered from the request alone is answered
'  here; a tool call is handed to the worker.
+ mcp_mount
  + json_reply
    \ status=nat body=str
    ^ http_foot/action
    | ./reply (http_response status (str/to_atom body) "application/json; charset=utf-8")
  + handle
    '  Every POST is handed to the worker, which checks the token and answers.
    \ home=path request=http_foot/request now=nat
    ^ http_foot/action
    ? (equal[str] request.method "GET")
      | ./reply (http_driver/response 405 "The event stream is not served yet.")
    ? !(equal[str] request.method "POST")
      | ./reply (http_driver/response 405 "POST required")
    = record
        . (myth/new)
          put(['body] (pails/t request.body))
          put(['auth] (pails/t (http_foot/header "authorization" request)))
          put(['now] (pd now))
    | ./ask home record
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = home=path [state.self 'io 'mcp]
    | http_foot/add_routes [(http_foot/route "/mcp" (mcp_mount/handle home))] http_foot/empty
  + start
    \ server=nat arguments=row[str]
    ^ nat
    ?> (./some home) (path_parse arguments.at(0))
      | error (pails/t "Invalid MCP home")
    | mcp_foot/install server home arguments.at(1) arguments.at(2) arguments.at(3)
