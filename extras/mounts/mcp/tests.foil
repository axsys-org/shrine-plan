- mcp_mount
- tests/namespace_command [at=commands]
- testing

+ mcp_admission_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial commands/command_tests/initial
      hand=path [initial.self 'gov 'relay]
      node commands/command_cascade/node
      records=row[[p=path q=writ]]
        [[hand (writ/make (myth/sing system_vocabulary/form (def_form.set_hear(commands/command_cascade/hear))))]
         [(node 0) (writ/make (myth/sing ['value] (pails/n 0)))]]
      records records.weld((row/range 1 3).map(commands/command_cascade/relay))
    ?> (./ok state) (grove_install/changes records initial)
      [(testing/nat "fixture admitted" 1 0)]
    ' Node 1 is written here and again by its hand. Node 2 first sees 17,
    ' then 42. The notification must include each path once, at final state.
    ?> (./ok next) (grove_install/changes
        [[(node 0) (writ/poke (myth/sing ['value] (pails/n 42)))]
         [(node 1) (writ/poke (myth/sing ['value] (pails/n 17)))]] state)
      [(testing/nat "cascade admitted" 1 0)]
    = paths=row[[path writ]]
        | (row/range 0 3).map (\ n [(node n) (writ/poke myth/new)])
      expected (mcp_mount/told_line paths "mcp" .none next)
      line (mcp_mount/command_told_line .none state.local.top next)
      missing (mcp_mount/command_told_line (./some (pails/q 'refused)) state.local.top next)
    ?> (./ok removed) (grove_install/change (node 2) .cull next)
      [(testing/nat "removal admitted" 1 0)]
    = removal (mcp_mount/command_told_line .none next.local.top removed)
      expected_removal (mcp_mount/told_line [[(node 2) .cull]] "mcp" .none removed)
    = batch (mcp_mount/batch (json/num .false 1) paths [] "person" [])
      actual=str
        ?> (./admit plan respond tell) batch "wrong admission boundary"
        | tell .none state.local.top next
      person (mcp_mount/told_line paths "person" .none next)
    [(testing/text "raw MCP batch uses shared admission and complete cascade notification" person actual)
     (testing/nat "cascade reaches final record" 42 (commands/command_tests/value (node 2) next))
     (testing/nat "cascade spans native events" 1 (gt next.local.top state.local.top.inc))
     (testing/text "notification includes original and reacting records once" expected line)
     (testing/text "refusal emits nothing" "" missing)
     (testing/text "no-op emits nothing" "" (mcp_mount/command_told_line .none next.local.top next))
     (testing/text "later admission excludes prior changes and reports deletion" expected_removal removal)]

- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- testing

+ mcp_tests
  + history_axis
    \ target=path three=namespace later=namespace axis=care
    ^ row[testing/check]
    = version three.case(axis target).fall(0)
      options (json/obj [(jkv "care" (json/str (str/from_atom (quip_val (care/seg axis))))) (jkv "case" (json/num .false version))])
      address (safe version axis target).spell
    ?> (./ok shorthand) (mcp_mount/read_spec later.self (json/str (mcp_mount/shown target)) options)
      [(testing/nat "historical shorthand parses" 1 0)]
    ?> (./ok explicit) (mcp_mount/read_spec later.self (json/str (mcp_mount/shown address)) options)
      [(testing/nat "historical address parses" 1 0)]
    = expected (sovereign_care axis address later)
      actual (mcp_mount/peek_at shorthand later)
    [(testing/nat "case shorthand reads the retained native tree" 1 (equal expected actual))
     (testing/nat "explicit history address consumes no second case" 1 (equal expected (mcp_mount/peek_at explicit later)))
     (testing/nat "case 3 remains distinct from the current record" 3 actual.fil.fall(myth/new).nat_at(['value] 0))]
  + history
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      target=path [initial.self 'retained]
      seed (\ n=nat state=namespace (grove_install/changes
        [[target (writ/make (myth/sing ['value] (pails/n n)))]
         [target.snoc('child) (writ/make (myth/sing ['value] (pails/n n)))]] state))
    ?> (./ok one) (seed 1 initial) [(testing/nat "history fixture 1" 1 0)]
    ?> (./ok two) (seed 2 one) [(testing/nat "history fixture 2" 1 0)]
    ?> (./ok three) (seed 3 two) [(testing/nat "history fixture 3" 1 0)]
    ?> (./ok later) (seed 4 three) [(testing/nat "history fixture 4" 1 0)]
    | row/bind[care testing/check] (mcp_tests/history_axis target three later) [.x .y .z]
  + reverse
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      target=path [initial.self 'subject]
      holder=path [initial.self 'report]
      lens (r_spell target)
      text (mcp_mount/shown lens)
    ?> (./ok state) (grove_install/change holder (writ/make (myth/sing ['subject] (safe 0 .x target))) initial)
      [(testing/nat "incoming fixture admitted" 1 0)]
    ?> (./ok spec) (mcp_mount/read_spec initial.self (json/str text) (json/obj []))
      [(testing/nat "MCP accepts the native incoming lens" 1 0)]
    = tree (mcp_mount/peek_at spec state)
      [fields bytes] (mcp_mount/node_json lens tree state .true)
      reference (mcp_rpc/text_at "reference_z" (json/obj fields))
    ?> (./ok later) (grove_install/change holder .cull state)
      [(testing/nat "incoming holder removed" 1 0)]
    = pinned=nat
        ?> (./some ref) (mcp_mount/reference reference) 999
        ?> (./known old) (sovereign_view .x 0 ref.path later) 999
        | old.fil.fall(myth/new).nat_at(['count] 999)
      write (json/obj [(jkv "path" (json/str text)) (jkv "slots" (json/obj []))])
      incoming (mcp_mount/spec [state.self] .z 0 "" myth/new 100 .none .false "" target)
      related (mcp_mount/referenced incoming state)
      found=bool
        ?> (./ok result) related .false
        | maybe/is_some (str/find (mcp_mount/shown holder) (show result))
    [(testing/nat "MCP preserves the derived /r address" 1 (equal[path] lens spec.pax))
     (testing/nat "MCP reads indexed incoming references" 1 tree.fil.fall(myth/new).nat_at(['count] 999))
     (testing/nat "MCP publishes an epoch pin for incoming snapshots" 1 pinned)
     (testing/nat "MCP rejects writing an incoming projection" 1 (?=((./err _) (mcp_mount/writes initial.self [write]))))
     (testing/nat "MCP referencing uses the same native incoming reader" 1 found)
     (testing/nat "reverse projections expose no borrowed local case" 0 (maybe/is_some (mcp_mount/case_of lens state)))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      child=iota 'child
      input=path [($x 1) 'input]
      definition=path [($x 1) 'view]
      output=path definition.cons(xs)
      initial fixture/namespace_tests/initial
      writes=row[[p=path q=writ]]
        [[input (writ/make (myth/sing ['value] (pails/n 7)))]
         [input.snoc(child) (writ/make (myth/sing ['value] (pails/n 8)))]
         [input.weld(['child 'grandchild]) (writ/make (myth/sing ['value] (pails/n 9)))]
         [definition (writ/make (myth/sing bond/weft (spun (\ context=myth input=axal[myth] input) .none)).put(bond/tack (safe 0 .z input)))]]
    ?> (./ok state) (grove_install/changes writes initial)
      [(testing/nat "MCP snapshot fixture admitted through native publication journal" 1 0)]
    = spec (mcp_mount/spec output .y 0 "" myth/new 100 .none .false "" [])
      shallow (mcp_mount/peek_at spec state)
      full (mcp_mount/peek_at (mcp_mount/spec output .z 0 "" myth/new 100 .none .false "" []) state)
      [fields bytes] (mcp_mount/node_json output shallow state .true)
      reference (mcp_rpc/text_at "reference_y" (json/obj fields))
    ?> (./ok later) (grove_install/change input.snoc(child) (writ/poke (myth/sing ['value] (pails/n 80))) state)
      [(testing/nat "MCP evidence change admitted" 1 0)]
    = pinned=nat
        ?> (./some ref) (mcp_mount/reference reference) 0
        ?> (./known tree) (sovereign_view ref.care ref.ver ref.path later) 0
        ?> (./some record) tree.get(['child]) 0
        | record.nat_at ['value] 0
      args (json/obj [(jkv "path" (json/str (mcp_mount/shown output)))])
      call (mcp_rpc/call (json/num .false 1) "tools/call"
        (json/obj [(jkv "name" (json/str "mcp/read")) (jkv "arguments" args)]))
    [(testing/nat "MCP y excludes structural grandchildren" 2 shallow.tap.len)
     (testing/nat "live computed cells do not borrow physical local cases" 0
       (mcp_mount/peek_at (mcp_mount/spec output .z 1 "" myth/new 100 .none .false "" []) later).wyt)
     (testing/nat "MCP z retains structural grandchildren" 3 full.tap.len)
     (testing/nat "MCP computation pin can be reused as a reference" 8 pinned)
     (testing/nat "MCP rejects a nonexistent epoch zero pin" 0
       (maybe/is_some (mcp_mount/reference "/h/y/e0/3/x/0x1/view")))]

+ mcp_precondition_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial commands/command_tests/initial
      target=path [initial.self 'app 'guarded]
      peer=path [initial.self 'app 'peer]
      case_key=path ['sys 'if_case]
      good (myth/sing ['value] (pails/n 7)).put(case_key (pails/n 0))
      stale (myth/sing ['value] (pails/n 9)).put(case_key (pails/n 1))
      original_index (sovereign_hive initial)
      [after index reply] (helm/supervisor/steps [[peer (writ/make good)] [target (writ/make stale)]] 0 0 initial original_index)
      refused=bool
        ?> (./ack reason) reply .false
        | maybe/is_some reason
      spec
        \ value=json
        ^ json
        | json/obj [(jkv "path" (json/str (mcp_mount/shown target))) (jkv "if_case" value)]
      invalid
        \ value=json
        ^ nat
        | ?=((./err _) (mcp_mount/writes initial.self [(spec value)]))
    [(testing/nat "stale second write rolls back the entire namespace" 1 (and refused (equal initial after)))
     (testing/nat "stale mixed batch retains the exact subscription index" 1 (equal original_index index))
     (testing/nat "JSON guard refuses text instead of coercing it to zero" 1 (invalid (json/str "0")))
     (testing/nat "JSON guard refuses negative cases" 1 (invalid (json/num .true 1)))
     (testing/nat "JSON guard refuses fractional cases" 1 (invalid (json/real "0.5")))]

+ tests
  ^ row[testing/case]
  [(testing/case "MCP native preconditions" mcp_precondition_tests/checks)
   (testing/case "native admission notifications" mcp_admission_tests/checks)
   (testing/case "native MCP computed reads" mcp_tests/checks)
   (testing/case "native MCP retained cases" mcp_tests/history)
   (testing/case "native MCP incoming-reference reads" mcp_tests/reverse)]
