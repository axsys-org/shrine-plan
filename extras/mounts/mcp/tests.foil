- mcp_mount
- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- view_ops
- testing

+ mcp_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      child=iota 'child
      input=path [($x 1) 'input]
      definition=path [($x 1) 'view]
      output=path definition.cons(xs)
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put input (myth/sing ['value] (pails/n 7)) initial.local)
      local (fixture/cell_tests/put input.snoc(child) (myth/sing ['value] (pails/n 8)) local)
      local (fixture/cell_tests/put input.weld(['child 'grandchild]) (myth/sing ['value] (pails/n 9)) local)
      local (fixture/cell_tests/put definition
        (myth/sing bond/weft (woven view_ops/children)).put(bond/tack (safe 0 .z input)) local)
      state initial.set_local(local)
      spec (mcp_mount/spec output .y 0 "" myth/new 100 .none .false "" [])
      shallow (mcp_mount/peek_at spec state)
      full (mcp_mount/peek_at (mcp_mount/spec output .z 0 "" myth/new 100 .none .false "" []) state)
      [fields bytes] (mcp_mount/node_json output shallow state .true)
      reference (mcp_rpc/text_at "reference_y" (json/obj fields))
      later state.set_local((fixture/cell_tests/put input.snoc(child) (myth/sing ['value] (pails/n 80)) local))
      pinned=nat
        ?> (./some ref) (mcp_mount/reference reference) 0
        ?> (./known tree) (sovereign_view ref.care ref.ver ref.path later) 0
        ?> (./some record) tree.get(['child]) 0
        | record.nat_at ['value] 0
      args (json/obj [(jkv "path" (json/str (mcp_mount/shown output)))])
      call (mcp_rpc/call (json/num .false 1) "tools/call"
        (json/obj [(jkv "name" (json/str "mcp/read")) (jkv "arguments" args)]))
      cached=bool
        ? (mcp_mount/dispatch ($x 1) call)
         > (http_foot/action/look reads render) .true
        .false
      batch_args (json/obj [(jkv "paths" (json/arr [(json/str (mcp_mount/shown output)) (json/str (mcp_mount/shown ['c 'x ($x 1) 'view]))]))])
      batch_call (mcp_rpc/call (json/num .false 2) "tools/call"
        (json/obj [(jkv "name" (json/str "mcp/read")) (jkv "arguments" batch_args)]))
      batch_cached=bool
        ? (mcp_mount/dispatch ($x 1) batch_call)
         > (http_foot/action/look reads render) (eq reads.len 2)
        .false
      status
        \ value=res[axal[myth]]
        ^ str
        ?> (./ok body) (mcp_mount/query_body spec value state.local.top) "error"
        | mcp_rpc/text_at "resolution" body
    [(testing/nat "MCP y excludes structural grandchildren" 2 shallow.tap.len)
     (testing/nat "MCP z retains structural grandchildren" 3 full.tap.len)
     (testing/nat "MCP derived reads use cached native query transport" 1 cached)
     (testing/nat "MCP cell and context batch uses native query cache" 1 batch_cached)
     (testing/nat "MCP distinguishes unavailable computation from absence" 1
       (and (equal[str] (status .unknown) "unresolved") (equal[str] (status .null) "absent")))
     (testing/nat "MCP computation pin can be reused as a reference" 8 pinned)
     (testing/nat "MCP rejects a nonexistent epoch zero pin" 0
       (maybe/is_some (mcp_mount/reference "/h/y/e0/3/x/0x1/view")))]

+ tests
  ^ row[testing/case]
  [(testing/case "native MCP computed reads" mcp_tests/checks)]
