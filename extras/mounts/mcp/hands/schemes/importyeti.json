{
  "about": "ImportYeti: customs filings, importers and their suppliers, read through Firecrawl",
  "land": {
    "importers": "/importyeti/{id}",
    "suppliers": "/importyeti/{id}/suppliers/{n}"
  },
  "identity": {
    "importers": "slug"
  },
  "shared": [
    "name",
    "address",
    "country",
    "shipments"
  ],
  "fetch": {
    "base": "https://www.importyeti.com",
    "via": "https://api.firecrawl.dev/v1/scrape",
    "key": "FIRECRAWL_API_KEY",
    "paging": null
  }
}
