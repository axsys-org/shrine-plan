- json

'  JSON-RPC 2.0 framing and the MCP envelopes. Pure: text in, text out.
+ mcp_rpc
  + version
    ^ str
    "2025-11-25"
  + call
    : id=json method=str params=json
  + field
    '  A key's value in a JSON object, or none.
    \ name=str value=json
    ^ maybe[json]
    ? value
     > (./obj kvs)
      % i=nat 0
      ^ maybe[json]
      ? (eq i kvs.len) .none
      = entry kvs.at(i)
      ? (equal entry.k name) (./some entry.v)
      | _ i.inc
    .none
  + text_of
    \ value=json
    ^ maybe[str]
    ? value
     > (./str s) (./some s)
    .none
  + text_at
    '  A string member of an object, or the empty string.
    \ name=str value=json
    ^ str
    ?> (./some member) (mcp_rpc/field name value) ""
    | (mcp_rpc/text_of member).fall("")
  + object_at
    '  An object member, or the empty object.
    \ name=str value=json
    ^ json
    ?> (./some member) (mcp_rpc/field name value) (json/obj [])
    ? member
     > (./obj kvs) member
    | json/obj []
  + parse_call
    '  One request. A batch or a notification without a method is refused.
    \ body=str
    ^ either[str mcp_rpc/call]
    ? (parse body)
     > (./err why rest) (./err (str/cat_all ["Parse error: " why]))
     > (./ok value rest)
      ?> (./some method) (mcp_rpc/field "method" value) (./err "Invalid Request: no method")
      ?> (./some name) (mcp_rpc/text_of method) (./err "Invalid Request: method is not a string")
      = id (mcp_rpc/field "id" value).fall(jnull)
        params (mcp_rpc/object_at "params" value)
      | ./ok (mcp_rpc/call id name params)
  + result
    \ id=json value=json
    ^ str
    | show (json/obj [(jkv "jsonrpc" (json/str "2.0")) (jkv "id" id) (jkv "result" value)])
  + failure
    '  code is the magnitude of a negative JSON-RPC code: 32601 for -32601.
    \ id=json code=nat message=str
    ^ str
    = detail (json/obj [(jkv "code" (json/num .true code)) (jkv "message" (json/str message))])
    | show (json/obj [(jkv "jsonrpc" (json/str "2.0")) (jkv "id" id) (jkv "error" detail)])
  + text_content
    '  A tool result carrying one text block.
    \ text=str is_error=bool
    ^ json
    = block (json/obj [(jkv "type" (json/str "text")) (jkv "text" (json/str text))])
    | json/obj [(jkv "content" (json/arr [block])) (jkv "isError" (json/boo is_error))]
  + structured
    '  A tool result carrying an object, repeated as text for clients that show only text.
    \ value=json
    ^ json
    = block (json/obj [(jkv "type" (json/str "text")) (jkv "text" (json/str (show value)))])
    | json/obj [(jkv "content" (json/arr [block])) (jkv "structuredContent" value) (jkv "isError" (json/boo .false))]
  + initialize
    \ name=str
    ^ json
    = listed (json/obj [(jkv "listChanged" (json/boo .true))])
      resources (json/obj [(jkv "subscribe" (json/boo .false)) (jkv "listChanged" (json/boo .true))])
      capabilities (json/obj [(jkv "tools" listed) (jkv "prompts" listed) (jkv "resources" resources)])
      info (json/obj [(jkv "name" (json/str name)) (jkv "version" (json/str "0.1.0"))])
    | json/obj
      [(jkv "protocolVersion" (json/str mcp_rpc/version))
       (jkv "capabilities" capabilities)
       (jkv "serverInfo" info)]
