- json
- mcp_rpc

'  Resources and prompts: what they are called and how they are listed.
'  Reading a resource is the worker's business; see mcp_foot.
+ mcp_resources
  + resource
    : uri=str name=str desc=str mime=str
  + template
    : pattern=str name=str desc=str mime=str
  + argument
    : name=str desc=str required=bool
  + prompt
    : name=str title=str desc=str arguments=row[mcp_resources/argument] text=str
  + defaults
    '  shrine:// reads a thing; file:// reads a mount's source file; https:// fetches a page.
    ^ row[mcp_resources/resource]
    [(mcp_resources/resource "shrine://app" "shrine/app" "The applications in this world: the tree under /app at care y." "application/json")
     (mcp_resources/resource "file://grove-dev/demo.grove" "shrine/grove-example" "A complete Grove file: record types, actions, views and seeded nodes." "text/plain")]
  + templates
    ^ row[mcp_resources/template]
    [(mcp_resources/template "shrine://{+path}" "shrine/thing" "A thing in the world by path, with its properties and children. The node may be left off." "application/json")
     (mcp_resources/template "shrine://{+path}?care={care}" "shrine/thing-at-care" "A thing at care x (alone), y (with children) or z (the subtree)." "application/json")
     (mcp_resources/template "file://{mount}/{name}" "shrine/source" "One source file of a mount." "text/plain")
     (mcp_resources/template "https://{+url}" "shrine/web" "A public web page, fetched by the world." "text/plain")]
  + prompts
    ^ row[mcp_resources/prompt]
    [(mcp_resources/prompt "mcp/read" "Read a thing" "Read a thing in the world and say what it holds."
       [(mcp_resources/argument "path" "The path to read." .true)]
       "Read {path} with mcp/read at care y and describe its properties, its children and the buttons its views offer.")
     (mcp_resources/prompt "mcp/develop" "Change a mount" "Change a mount's Grove or Foil and compile it."
       [(mcp_resources/argument "mount" "The mount to change." .true) (mcp_resources/argument "change" "What to change." .true)]
       "In the mount {mount}, make this change: {change}. Read the files with mcp/list-files and mcp/get-file first, write with mcp/insert-file, and read the compile result; if ready is false, fix the place it names and write again. Reinstall only if a record type or a seeded node changed, and say so first.")
     (mcp_resources/prompt "mcp/commit" "Recompile a mount" "Recompile a mount from its files on disk."
       [(mcp_resources/argument "mount" "The mount." .true)]
       "Run mcp/commit on {mount} and report ready, message and any failure in full.")
     (mcp_resources/prompt "mcp/install-app" "Install or recreate an instance" "Install a mount's definitions as an instance."
       [(mcp_resources/argument "mount" "The mount." .true)]
       "Run mcp/install-app on {mount}. If an instance is already there, explain that replace resets its records before using replace.")]
  + resource_json
    \ r=mcp_resources/resource
    ^ json
    | json/obj [(jkv "uri" (json/str r.uri)) (jkv "name" (json/str r.name)) (jkv "description" (json/str r.desc)) (jkv "mimeType" (json/str r.mime))]
  + template_json
    \ t=mcp_resources/template
    ^ json
    | json/obj [(jkv "uriTemplate" (json/str t.pattern)) (jkv "name" (json/str t.name)) (jkv "description" (json/str t.desc)) (jkv "mimeType" (json/str t.mime))]
  + argument_json
    \ a=mcp_resources/argument
    ^ json
    | json/obj [(jkv "name" (json/str a.name)) (jkv "description" (json/str a.desc)) (jkv "required" (json/boo a.required))]
  + prompt_json
    \ p=mcp_resources/prompt
    ^ json
    | json/obj
      [(jkv "name" (json/str p.name)) (jkv "title" (json/str p.title)) (jkv "description" (json/str p.desc))
       (jkv "arguments" (json/arr p.arguments.map(mcp_resources/argument_json)))]
  + listing
    \ ignored=nat
    ^ json
    = all mcp_resources/defaults
    | json/obj [(jkv "resources" (json/arr all.map(mcp_resources/resource_json)))]
  + template_listing
    \ ignored=nat
    ^ json
    = all mcp_resources/templates
    | json/obj [(jkv "resourceTemplates" (json/arr all.map(mcp_resources/template_json)))]
  + prompt_listing
    \ ignored=nat
    ^ json
    = all mcp_resources/prompts
    | json/obj [(jkv "prompts" (json/arr all.map(mcp_resources/prompt_json)))]
  + find_prompt
    \ name=str
    ^ maybe[mcp_resources/prompt]
    = all mcp_resources/prompts
      found all.filter((\ p=mcp_resources/prompt (equal p.name name)))
    ? (eq found.len 0) .none
    | ./some found.at(0)
  + marker
    '  {name}
    \ name=str
    ^ str
    | str/cat_all [(str/from_atom 123) name (str/from_atom 125)]
  + mentions
    \ text=str name=str
    ^ bool
    | maybe/is_some (str/find (mcp_resources/marker name) text)
  + fill
    '  A text with {name} replaced by the argument given, or left as it is.
    \ text=str pairs=row[[name=str value=str]]
    ^ str
    | pairs.fold text
    \ out=str [name value]
    = marker (mcp_resources/marker name)
    % left=str out guard=nat 0
    ^ str
    ? (gt guard 64) left
    ? (str/find marker left)
     > (./some at)
      | _ (str/cat_all [left.slice(0 at) value left.slice((add at marker.len) (sub left.len (add at marker.len)))]) guard.inc
     > .none left
  + prompt_messages
    \ p=mcp_resources/prompt arguments=json
    ^ json
    = text (mcp_resources/fill p.text (mcp_rpc/pairs_of arguments))
      content (json/obj [(jkv "type" (json/str "text")) (jkv "text" (json/str text))])
      message (json/obj [(jkv "role" (json/str "user")) (jkv "content" content)])
    | json/obj [(jkv "description" (json/str p.desc)) (jkv "messages" (json/arr [message]))]
  + text_contents
    '  A resources/read result holding one text.
    \ uri=str mime=str text=str
    ^ json
    = item (json/obj [(jkv "uri" (json/str uri)) (jkv "mimeType" (json/str mime)) (jkv "text" (json/str text))])
    | json/obj [(jkv "contents" (json/arr [item]))]
  + scheme
    '  The part before "://", lower-cased by convention of the writer.
    \ uri=str
    ^ str
    ?> (./some at) (str/find "://" uri) ""
    | uri.slice(0 at)
  + rest
    \ uri=str
    ^ str
    ?> (./some at) (str/find "://" uri) uri
    | uri.slice((add at 3) (sub uri.len (add at 3)))
