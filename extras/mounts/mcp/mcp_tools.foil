- json

'  The node tools: what they are called, what they take, how they are listed.
'  How they run is the worker's business.
+ mcp_tools
  + param
    : name=str kind=str desc=str
  + tool
    : name=str desc=str params=row[mcp_tools/param] required=row[str]
  + published
    '  A tool an app publishes as a record at /app/<app>/mcp/<name>: its lede is
    '  the description, tool_kind is read, press or write, tool_target the path
    '  (with {argument} holes), tool_label the button, tool_params the arguments.
    : name=str app=str kind=str target=str label=str desc=str params=row[mcp_tools/param]
  + p
    \ name=str kind=str desc=str
    ^ mcp_tools/param
    | mcp_tools/param name kind desc
  + path_param
    ^ mcp_tools/param
    | mcp_tools/p "path" "string" "A namespace path, such as /0x11/app/workbench/notes/welcome. The node may be left off."
  + builtins
    ^ row[mcp_tools/tool]
    [(mcp_tools/tool "mcp/get-our-id" "The identity of this node." [] [])
     (mcp_tools/tool "mcp/read"
       "Read a thing in the namespace: its properties, and at care y its children, at care z the subtree."
       [mcp_tools/path_param (mcp_tools/p "care" "string" "x for the record alone, y with its children, z with the subtree. Default y.")]
       ["path"])
     (mcp_tools/tool "mcp/write"
       "Write properties onto a thing. The thing's contract refuses a value of the wrong type. A missing thing is created."
       [mcp_tools/path_param (mcp_tools/p "properties" "object" "Property names to text values.")]
       ["path" "properties"])
     (mcp_tools/tool "mcp/delete" "Delete a thing and everything under it. Its history stays addressable."
       [mcp_tools/path_param] ["path"])
     (mcp_tools/tool "mcp/press"
       "Press a button on one of a thing's views, with values for the view's inputs."
       [mcp_tools/path_param (mcp_tools/p "label" "string" "The button's label, as mcp/read lists it.")
        (mcp_tools/p "inputs" "object" "Input slot to value, for a form.")]
       ["path" "label"])
     (mcp_tools/tool "mcp/list-mounts" "The mounts in this world, their source files and their published state." [] [])
     (mcp_tools/tool "mcp/list-files" "The source files of a mount."
       [(mcp_tools/p "mount" "string" "The mount's name.")] ["mount"])
     (mcp_tools/tool "mcp/get-file" "One source file of a mount."
       [(mcp_tools/p "mount" "string" "The mount's name.") (mcp_tools/p "name" "string" "The file's name.")]
       ["mount" "name"])
     (mcp_tools/tool "mcp/insert-file"
       "Replace one source file of a mount and recompile it in the running world. Returns the compile result, with the place of each failure."
       [(mcp_tools/p "mount" "string" "The mount's name.") (mcp_tools/p "name" "string" "The file's name.")
        (mcp_tools/p "text" "string" "The complete new contents.")]
       ["mount" "name" "text"])
     (mcp_tools/tool "mcp/commit" "Recompile a mount from its files on disk and report the result."
       [(mcp_tools/p "mount" "string" "The mount's name.")] ["mount"])
     (mcp_tools/tool "mcp/install-app"
       "Install a mount's Grove definitions as an instance at a path, or recreate the instance from the current definitions."
       [(mcp_tools/p "mount" "string" "The mount's name.")
        (mcp_tools/p "target" "string" "Where the instance lives. Default /app/<unit>, the unit being the name of the Grove file's publication, such as /app/demo for grove-dev.")
        (mcp_tools/p "replace" "boolean" "Recreate an existing instance. Its records are reset to the definitions.")]
       ["mount"])
     (mcp_tools/tool "mcp/history" "The versions of a thing, newest first: the properties it held at each case of its history, with the count of cases and whether it is live or deleted."
       [mcp_tools/path_param (mcp_tools/p "limit" "number" "How many versions, newest first. Default 10, at most 40.")] ["path"])
     (mcp_tools/tool "mcp/import-tools"
       "Find the tools apps publish as records under /app/<app>/mcp and add them to this server's list. Run it after installing or changing an app, then list the tools again."
       [] [])
     (mcp_tools/tool "chorus/publish-slip"
       "Publish a slip to this world's cabinet: a note of at most 2,048 characters of GitHub-flavoured Markdown, with no HTML and no frontmatter. Publishing to a path that already holds our slip replaces it with a new revision; the world keeps every revision. Open the slip with a one-line summary. Link to other slips with [[<fqsp>]]. Returns the slip's path, fqsp and revision."
       [(mcp_tools/p "path" "string" "The cabinet path, beginning with a /, such as /projects/chorus/kademlia. Segments hold lowercase letters, digits and hyphens; the last is the slip's slug, the rest are nested drawers.")
        (mcp_tools/p "text" "string" "The Markdown body of the slip.")
        (mcp_tools/p "public" "boolean" "Mark the slip for sharing. Default false. Nothing leaves this world yet either way; the mark is kept for when worlds share cabinets.")]
       ["path" "text"])
     (mcp_tools/tool "chorus/fetch-slip"
       "Fetch a slip by its cabinet path or its fqsp, the target of a [[<fqsp>]] link. A drawer with a record of its own, or / for the whole cabinet, lists what it holds."
       [(mcp_tools/p "fqsp" "string" "A cabinet path such as /notes/foo, / for the cabinet, or a shrine:// address.")]
       ["fqsp"])
     (mcp_tools/tool "chorus/discard-slip"
       "Remove one of our slips from the cabinet. Its earlier revisions stay in the world's history."
       [(mcp_tools/p "path" "string" "The cabinet path of the slip, beginning with a /.")]
       ["path"])]
  ' ---- tools published by apps
  + strip
    '  Without leading and trailing spaces.
    \ text=str
    ^ str
    = start
        % i=nat 0
        ^ nat
        ? (ge i text.len) i
        ? (eq text.at(i) 32) (_ i.inc)
        i
      stop
        % j=nat text.len
        ^ nat
        ? (le j start) j
        ? (eq text.at((dec j)) 32) (_ (dec j))
        j
    | text.slice(start (sub stop start))
  + parse_params
    '  "name: description; name: description" as parameters, all text, all required.
    \ text=str
    ^ row[mcp_tools/param]
    | text.split_byte(59).fold []
    \ out=row[mcp_tools/param] part=str
    ?> (./some colon) (str/find ":" part) out
    = name (mcp_tools/strip part.slice(0 colon))
      desc (mcp_tools/strip part.slice(colon.inc (sub part.len colon.inc)))
    ? (eq name.len 0) out
    | out.snoc((mcp_tools/param name "string" desc))
  + as_tool
    \ pub=mcp_tools/published
    ^ mcp_tools/tool
    | mcp_tools/tool pub.name pub.desc pub.params pub.params.map((\ param=mcp_tools/param param.name))
  + param_json
    \ param=mcp_tools/param
    ^ jkv
    | jkv param.name (json/obj [(jkv "type" (json/str param.kind)) (jkv "description" (json/str param.desc))])
  + schema
    \ tool=mcp_tools/tool
    ^ json
    | json/obj
      [(jkv "type" (json/str "object"))
       (jkv "properties" (json/obj tool.params.map(mcp_tools/param_json)))
       (jkv "required" (json/arr tool.required.map((\ name=str (json/str name)))))]
  + to_json
    \ tool=mcp_tools/tool
    ^ json
    | json/obj
      [(jkv "name" (json/str tool.name))
       (jkv "description" (json/str tool.desc))
       (jkv "inputSchema" (mcp_tools/schema tool))]
  + listing
    \ tools=row[mcp_tools/tool]
    ^ json
    | json/obj [(jkv "tools" (json/arr tools.map(mcp_tools/to_json)))]
  + find
    \ name=str tools=row[mcp_tools/tool]
    ^ maybe[mcp_tools/tool]
    % i=nat 0
    ^ maybe[mcp_tools/tool]
    ? (eq i tools.len) .none
    ? (equal tools.at(i).name name) (./some tools.at(i))
    | _ i.inc
