- json

'  The node tools: what they are called, what they take, how they are listed.
'  How they run is the worker's business.
+ mcp_tools
  + param
    : name=str kind=str desc=str
  + tool
    : name=str desc=str params=row[mcp_tools/param] required=row[str]
  + p
    \ name=str kind=str desc=str
    ^ mcp_tools/param
    | mcp_tools/param name kind desc
  + path_param
    ^ mcp_tools/param
    | mcp_tools/p "path" "string" "A namespace path, such as /0x11/app/workbench/notes/welcome. The node may be left off."
  + builtins
    ^ row[mcp_tools/tool]
    [(mcp_tools/tool "mcp/get-our-id" "The identity of this node." [] [])
     (mcp_tools/tool "mcp/read"
       "Read a thing in the namespace: its properties, and at care y its children, at care z the subtree."
       [mcp_tools/path_param (mcp_tools/p "care" "string" "x for the record alone, y with its children, z with the subtree. Default y.")]
       ["path"])
     (mcp_tools/tool "mcp/write"
       "Write properties onto a thing. The thing's contract refuses a value of the wrong type. A missing thing is created."
       [mcp_tools/path_param (mcp_tools/p "properties" "object" "Property names to text values.")]
       ["path" "properties"])
     (mcp_tools/tool "mcp/delete" "Delete a thing and everything under it. Its history stays addressable."
       [mcp_tools/path_param] ["path"])
     (mcp_tools/tool "mcp/press"
       "Press a button on one of a thing's views, with values for the view's inputs."
       [mcp_tools/path_param (mcp_tools/p "label" "string" "The button's label, as mcp/read lists it.")
        (mcp_tools/p "inputs" "object" "Input slot to value, for a form.")]
       ["path" "label"])
     (mcp_tools/tool "mcp/list-mounts" "The mounts in this world, their source files and their published state." [] [])
     (mcp_tools/tool "mcp/list-files" "The source files of a mount."
       [(mcp_tools/p "mount" "string" "The mount's name.")] ["mount"])
     (mcp_tools/tool "mcp/get-file" "One source file of a mount."
       [(mcp_tools/p "mount" "string" "The mount's name.") (mcp_tools/p "name" "string" "The file's name.")]
       ["mount" "name"])
     (mcp_tools/tool "mcp/insert-file"
       "Replace one source file of a mount and recompile it in the running world. Returns the compile result, with the place of each failure."
       [(mcp_tools/p "mount" "string" "The mount's name.") (mcp_tools/p "name" "string" "The file's name.")
        (mcp_tools/p "text" "string" "The complete new contents.")]
       ["mount" "name" "text"])
     (mcp_tools/tool "mcp/commit" "Recompile a mount from its files on disk and report the result."
       [(mcp_tools/p "mount" "string" "The mount's name.")] ["mount"])
     (mcp_tools/tool "mcp/install-app"
       "Install a mount's Grove definitions as an instance at a path, or recreate the instance from the current definitions."
       [(mcp_tools/p "mount" "string" "The mount's name.")
        (mcp_tools/p "target" "string" "Where the instance lives. Default /app/<mount>.")
        (mcp_tools/p "replace" "boolean" "Recreate an existing instance. Its records are reset to the definitions.")]
       ["mount"])
     (mcp_tools/tool "mcp/history" "The recent versions of a thing: when it changed and what its properties were."
       [mcp_tools/path_param (mcp_tools/p "limit" "number" "How many versions, at most 40.")] ["path"])]
  + param_json
    \ param=mcp_tools/param
    ^ jkv
    | jkv param.name (json/obj [(jkv "type" (json/str param.kind)) (jkv "description" (json/str param.desc))])
  + schema
    \ tool=mcp_tools/tool
    ^ json
    | json/obj
      [(jkv "type" (json/str "object"))
       (jkv "properties" (json/obj tool.params.map(mcp_tools/param_json)))
       (jkv "required" (json/arr tool.required.map((\ name=str (json/str name)))))]
  + to_json
    \ tool=mcp_tools/tool
    ^ json
    | json/obj
      [(jkv "name" (json/str tool.name))
       (jkv "description" (json/str tool.desc))
       (jkv "inputSchema" (mcp_tools/schema tool))]
  + listing
    \ tools=row[mcp_tools/tool]
    ^ json
    | json/obj [(jkv "tools" (json/arr tools.map(mcp_tools/to_json)))]
  + find
    \ name=str tools=row[mcp_tools/tool]
    ^ maybe[mcp_tools/tool]
    % i=nat 0
    ^ maybe[mcp_tools/tool]
    ? (eq i tools.len) .none
    ? (equal tools.at(i).name name) (./some tools.at(i))
    | _ i.inc
