- system_vocabulary
- mesa_wire

' Registers the foot at /<self>/io/mesa when a world starts. Its arguments
' come from the mount's host hook: the port to listen on, the ring and mark
' files, the foot's home, and then four for each peer the world starts
' with: its number, its key, and the host and port it is reached at.
+ mesa_mount
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + submit
    ' One write, and whether the world took it.
    \ server=nat target=path change=writ
    ^ bool
    ; (SendCaps server (helm/card/step target change) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    | mesa_mount/accepted reply
  + keep
    ' Slots a record should hold: added to it when it is there, and made
    ' when it is not, so what else the record holds is left alone.
    \ server=nat target=path slots=myth
    ^ bool
    ? (mesa_mount/submit server target (writ/poke slots)) .true
    | mesa_mount/submit server target (writ/make slots)
  + number
    \ text=str
    ^ nat
    ?> (./some n) (nat/parse text) 0
    n
  + start
    \ server=nat arguments=row[str]
    ^ nat
    ?> (./some home) (path_parse arguments.at(3))
      | error (pails/t "Invalid Mesa home")
    = own
        . (myth/sing ['port] (pails/n (mesa_mount/number arguments.at(0))))
          put(['ring] (pails/t arguments.at(1)))
          put(['mark] (pails/t arguments.at(2)))
    ? !(mesa_mount/keep server home own)
      (error (pails/t "Mesa foot record refused"))
    = ;cards
        % at=nat 4
          made=nat 0
        ^ nat
        ? (gt (add at 4) arguments.len) made
        = card
            . (myth/sing ['key] (pails/n (mesa_mount/number arguments.at(at.inc))))
              put(['host] (pails/t arguments.at((add at 2))))
              put(['port] (pails/n (mesa_mount/number arguments.at((add at 3)))))
          ;kept (mesa_mount/keep server home.snoc(($x (mesa_mount/number arguments.at(at)))) card)
        | _ (add at 4) made.inc
    = registration | helm/supervisor/register home mesa_wire/run .true
    ; (SendCaps server registration [0])
    = ;[reply caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? !(mesa_mount/accepted reply)
      (error (pails/t "Mesa foot registration failed"))
    cards
