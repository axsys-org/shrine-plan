- grove_install

+ srs_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'srs]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing SRS template")
    ? (grove_install/instantiate source version
        [state.self 'app 'srs] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (srs_mount/failure why))
