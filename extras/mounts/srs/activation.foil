- grove_install

+ srs_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'srs]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing SRS template")
    = installed=either[pail namespace]
        ? (grove_install/instantiate source version [state.self 'app 'srs] state)
         > (./ok next) (./ok next)
         > (./err why) (./err (srs_mount/failure why))
    < next installed
    = entry (myth/sing system_vocabulary/face (pails/p [state.self 'gov 'srs 'workspace]))
      entry entry.put(system_vocabulary/from (pails/p [state.self 'app 'srs 'cards]))
      entry entry.put(system_vocabulary/lede (pails/t "Cards"))
    ? (grove_install/change [state.self 'app 'cards] (writ/make entry) next)
     > (./ok next) (./ok next)
     > (./err why) (./err (srs_mount/failure why))
