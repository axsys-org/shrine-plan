- goo_app/html
- goo_app/layout_tests
- testing

+ goo_html_tests
  + rejects
    \ prepared=goo_html_internal/prepared
    ^ bool
    ? (Try goo_html/fragment prepared)
     > (./err _) .true
    .false
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = tree (goo_layout_tests/leaf ignored)
    > (./ok p) (goo_html/prepare (./some tree) (goo_fp/integer 100) (goo_fp/integer 1) .false) [(testing/nat "prepare leaf" 1 0)]
    > (./some n) p.tree [(testing/nat "prepared leaf exists" 1 0)]
    = bad_lines (goo_html_internal/node n.semantic n.plan (./some ["forged"]) n.rows)
      bad_id (goo_measure/plan (goo/node_id "missing") n.plan.width n.plan.height n.plan.cost n.plan.rows)
    [
     (testing/nat "prepared leaf valid" 1 (goo_html/valid p))
     (testing/nat "forged width rejected by painter" 1 (goo_html_tests/rejects (goo_html_internal/prepared (goo_fp/integer 90) p.scale p.rtl p.measurement p.tree)))
     (testing/nat "forged scale rejected by painter" 1 (goo_html_tests/rejects (goo_html_internal/prepared p.width (goo_fp/integer 2) p.rtl p.measurement p.tree)))
     (testing/nat "forged lines rejected by painter" 1 (goo_html_tests/rejects (goo_html_internal/prepared p.width p.scale p.rtl p.measurement (./some bad_lines))))
     (testing/nat "missing render root rejected by painter" 1 (goo_html_tests/rejects (goo_html_internal/prepared p.width p.scale p.rtl p.measurement .none)))
     (testing/nat "unknown plan id fails preparation lookup" 0 (maybe/is_some (goo_html_internal/build [tree] p.scale bad_id)))
     (testing/text "markup is escaped text" "&lt;b&gt;&amp;&lt;/b&gt;" (goo_html/escape "<b>&</b>"))
    ]
