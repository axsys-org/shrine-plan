- goo_app/compile
- goo_app/measurement
- testing

+ goo_semantic_tests
  + failure
    : code=nat
  + fail_action
    \ ignored=unit
    ^ either[goo_result/diagnostic goo/source]
    | Seq[either[goo_result/diagnostic goo/source]] (error (goo_semantic_tests/failure 91)) (./err (goo_result/diagnostic (goo_result/severity/error) .none "unreachable"))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = context (goo/compile_context (goo/path/trusted "/full"))
      start (goo_result/control/start context)
      crashed (goo_compile/step[goo/source] "read" "test" goo_compile/wrap_read goo_semantic_tests/fail_action start)
      ended (goo_result/control/finish .none start)
      skipped (goo_compile/step[goo/source] "read" "test" goo_compile/wrap_read goo_semantic_tests/fail_action ended)
      scalar (goo/scalar 4607182418800017408)
      empty (goo_measure/raw .none scalar .nil .none .nil)
    [(testing/nat "default full rank is constructed" 2 (goo_pass/options context).optional_budget.to_nat)
     (testing/nat "summary default" 1 (goo_pass/options (goo/compile_context (goo/path/trusted "/sys/slots/summary"))).optional_budget.to_nat)
     (testing/nat "scar default" 0 (goo_pass/options (goo/compile_context (goo/path/trusted "/sys/slots/scar"))).optional_budget.to_nat)
     (testing/nat "synchronous stage exception retains failed stage" 1 crashed.state.checkpoint.passes.len)
     (testing/nat "synchronous exception has no value" 1 (equal[maybe[goo/source]] crashed.value .none))
     (testing/nat "terminal stage skips throwing callback" 1 (equal[goo_result/control] skipped.state ended))
     (testing/nat "native validated empty result" 1 (maybe/is_some (goo_measure/make empty)))
     (testing/nat "nonfinite internal result rejected" 0 (maybe/is_some (goo_measure/make (goo_measure/raw .none (goo/scalar 9218868437227405312) .nil .none .nil))))
     (testing/nat "negative internal result rejected" 0 (maybe/is_some (goo_measure/make (goo_measure/raw .none (goo/scalar 13830554455654793216) .nil .none .nil))))
     (testing/nat "source hexadecimal" 1 (equal[maybe[goo/scalar]] (goo_number/decode (json/num .false 16)) (goo_read/number "0x10")))
     (testing/nat "source leading zero" 1 (equal[maybe[goo/scalar]] (./some scalar) (goo_read/number "01")))
     (testing/nat "wire remains strict" 0 (maybe/is_some (goo_number/decode (json/real "01"))))]
