- goo_app/types
- goo_app/numbers
- json

' Transport values are deliberately distinct from phase constructors.
+ goo_wire
  + node
    : fields=row[jkv]
+ goo_codec
  + field
    \ fields=row[jkv] key=str
    ^ maybe[json]
    % i=nat 0
    ^ maybe[json]
    ? (eq i fields.len) .none
    = entry fields.at(i)
    ? (eq entry.k key) (./some entry.v)
    | _ i.inc
  + optional
    (@@ v)
    \ decode={\ json}maybe[v] value=maybe[json]
    ^ maybe[maybe[v]]
    ? value
     > ./none (./some .none)
     > (./some item)
      ? item
       > (json/nul _) (./some .none)
      < decoded (decode item)
      | ./some (./some decoded)
  + text
    \ value=json
    ^ maybe[str]
    ? value
     > (json/str text) (./some text)
    .none
  + boolean
    \ value=json
    ^ maybe[bool]
    ? value
     > (json/boo b) (./some b)
    .none
  + identifier
    \ value=json
    ^ maybe[goo/node_id]
    < text (goo_codec/text value)
    ? (eq text.len 0) .none
    | ./some (goo/node_id text)
  + grow
    \ value=json
    ^ maybe[bool]
    < n (goo_number/integer value)
    ? (gt n 1) .none
    | ./some (eq n 1)
  + rank
    \ value=json
    ^ maybe[goo/rank]
    < n (goo_number/integer value)
    | goo/rank/from_nat n
  + location
    \ value=json
    ^ maybe[goo/loc]
    > (json/obj fields) value .none
    < lv (goo_codec/field fields "line")
    < cv (goo_codec/field fields "column")
    < line (goo_number/integer lv)
    < column (goo_number/integer cv)
    | goo/loc/make line column
  + config
    \ fields=row[jkv]
    ^ maybe[goo/config]
    < grow (goo_codec/optional[bool] goo_codec/grow (goo_codec/field fields "grow"))
    < maxIdeal (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "maxIdeal"))
    < primary (goo_codec/optional[bool] goo_codec/boolean (goo_codec/field fields "primary"))
    < toggle (goo_codec/optional[bool] goo_codec/boolean (goo_codec/field fields "toggle"))
    < label (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "label"))
    < optionLabel (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "optionLabel"))
    < value (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "value"))
    < max (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "max"))
    | ./some (goo/config grow maxIdeal primary toggle label optionLabel value max)
  + common
    \ fields=row[jkv]
    ^ maybe[goo/common]
    < slot_json (goo_codec/field fields "slot")
    < slot (goo_codec/text slot_json)
    < rank (goo_codec/optional[goo/rank] goo_codec/rank (goo_codec/field fields "optional"))
    < config (goo_codec/config fields)
    < origin (goo_codec/optional[goo/loc] goo_codec/location (goo_codec/field fields "origin"))
    = actual=goo/rank
        ? rank
         > ./none (goo/rank/required)
         > (./some r) r
    | ./some (goo/common (goo/slot slot) actual config origin)
  + affinity
    \ value=json
    ^ maybe[goo/affinity]
    < text (goo_codec/text value)
    ? (eq text "attached") (./some (goo/affinity/attached))
    ? (eq text "tight") (./some (goo/affinity/tight))
    ? (eq text "related") (./some (goo/affinity/related))
    ? (eq text "normal") (./some (goo/affinity/normal))
    ? (eq text "loose") (./some (goo/affinity/loose))
    ? (eq text "separate") (./some (goo/affinity/separate))
    .none
  + provenance
    \ value=json
    ^ maybe[goo/edge_source]
    < text (goo_codec/text value)
    ? (eq text "exact") (./some (goo/edge_source/exact))
    ? (eq text "fallback") (./some (goo/edge_source/fallback))
    ? (eq text "uniform") (./some (goo/edge_source/uniform))
    .none
  + edge
    \ value=json
    ^ maybe[goo/edge]
    > (json/obj fields) value .none
    < left_json (goo_codec/field fields "left")
    < left (goo_codec/text left_json)
    < right_json (goo_codec/field fields "right")
    < right (goo_codec/text right_json)
    < leftId_json (goo_codec/field fields "leftId")
    < leftId (goo_codec/identifier leftId_json)
    < rightId_json (goo_codec/field fields "rightId")
    < rightId (goo_codec/identifier rightId_json)
    < bind_json (goo_codec/field fields "bind")
    < bind (goo_codec/affinity bind_json)
    < source_json (goo_codec/field fields "source")
    < source (goo_codec/provenance source_json)
    < parent_json (goo_codec/field fields "parent")
    < parent (goo_codec/identifier parent_json)
    < parentSlot_json (goo_codec/field fields "parentSlot")
    < parentSlot (goo_codec/text parentSlot_json)
    < rule_json (goo_codec/field fields "rule")
    < rule (goo_codec/optional[nat] goo_number/integer (./some rule_json))
    = valid_rule=bool
        ? rule
         > ./none !(equal[goo/edge_source] source (goo/edge_source/exact))
         > (./some n) !((eq n 0) || (equal[goo/edge_source] source (goo/edge_source/fallback)))
    ? !valid_rule .none
    ? (equal[goo/edge_source] source (goo/edge_source/uniform))
      ? !(equal[goo/affinity] bind (goo/affinity/normal)) .none
      | ./some (goo/edge (goo/slot left) (goo/slot right) leftId rightId bind rule source parent (goo/slot parentSlot))
    | ./some (goo/edge (goo/slot left) (goo/slot right) leftId rightId bind rule source parent (goo/slot parentSlot))
  + wire
    \ value=json
    ^ maybe[goo_wire/node]
    ? value
     > (json/obj fields) (./some (goo_wire/node fields))
    .none
  + direction
    \ value=json
    ^ maybe[goo/direction]
    < text (goo_codec/text value)
    ? (eq text "flow") (./some (goo/direction/row))
    ? (eq text "stack") (./some (goo/direction/col))
    .none
  + progress
    \ config=goo/config
    ^ bool
    ? config.value
     > ./none .true
     > (./some value)
      ? config.max
       > ./none .false
       > (./some max)
        = v (mod value.bits 9223372036854775808)
          m (mod max.bits 9223372036854775808)
        ? (eq m 0) .false
        | le v m
  + normalized
    \ wire=goo_wire/node
    ^ maybe[goo/normalized]
    = fields wire.fields
    < common (goo_codec/common fields)
    < id_json (goo_codec/field fields "id")
    < id (goo_codec/identifier id_json)
    = attrs (goo/normalized_attrs common id)
    < kind_json (goo_codec/field fields "kind")
    < kind (goo_codec/text kind_json)
    ? (eq kind "group")
      < layout_json (goo_codec/field fields "layout")
      < direction (goo_codec/direction layout_json)
      < children_json (goo_codec/field fields "children")
      > (json/arr children) children_json .none
      < kids (goo_codec/normalized_children children)
      | ./some (goo/normalized/flow attrs direction kids)
    ? (goo_codec/field fields "children")
     > (./some _) .none
     > ./none
      < text (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "text"))
      < src (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "src"))
      = payload=str
          ? text
           > ./none ""
           > (./some t) t
      ? src
       > (./some url)
        ? !((eq kind "avatar") || (eq kind "media")) .none
        | ./some (goo/normalized/image attrs url)
       > ./none
        ? (eq kind "text") (./some (goo/normalized/text attrs payload))
        < primitive (goo/primitive_kind/parse kind)
        ? (eq kind "bar")
          ? !(goo_codec/progress common.config) .none
          | ./some (goo/normalized/jet attrs (goo/primitive/make primitive payload))
        | ./some (goo/normalized/jet attrs (goo/primitive/make primitive payload))
  + normalized_children
    \ values=row[json]
    ^ maybe[row[goo/normalized]]
    % i=nat 0 out=row[goo/normalized] []
    ^ maybe[row[goo/normalized]]
    ? (eq i values.len) (./some out)
    < wire (goo_codec/wire values.at(i))
    < tree (goo_codec/normalized wire)
    | _ i.inc out.snoc(tree)
  + semantic
    \ wire=goo_wire/node
    ^ maybe[goo/semantic]
    = fields wire.fields
    < common (goo_codec/common fields)
    < id_json (goo_codec/field fields "id")
    < id (goo_codec/identifier id_json)
    < after_json (goo_codec/field fields "after")
    < after (goo_codec/optional[goo/edge] goo_codec/edge (./some after_json))
    = attrs (goo/semantic_attrs common id after)
    < kind_json (goo_codec/field fields "kind")
    < kind (goo_codec/text kind_json)
    ? (eq kind "group")
      < layout_json (goo_codec/field fields "layout")
      < direction (goo_codec/direction layout_json)
      < children_json (goo_codec/field fields "children")
      > (json/arr children) children_json .none
      < kids (goo_codec/semantic_children children)
      | ./some (goo/semantic/flow attrs direction kids)
    ? (goo_codec/field fields "children")
     > (./some _) .none
     > ./none
      < text (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "text"))
      < src (goo_codec/optional[str] goo_codec/text (goo_codec/field fields "src"))
      = payload=str
          ? text
           > ./none ""
           > (./some t) t
      ? src
       > (./some url)
        ? !((eq kind "avatar") || (eq kind "media")) .none
        | ./some (goo/semantic/image attrs url)
       > ./none
        ? (eq kind "text") (./some (goo/semantic/text attrs payload))
        < primitive (goo/primitive_kind/parse kind)
        ? (eq kind "bar")
          ? !(goo_codec/progress common.config) .none
          | ./some (goo/semantic/jet attrs (goo/primitive/make primitive payload))
        | ./some (goo/semantic/jet attrs (goo/primitive/make primitive payload))
  + semantic_children
    \ values=row[json]
    ^ maybe[row[goo/semantic]]
    % i=nat 0 out=row[goo/semantic] []
    ^ maybe[row[goo/semantic]]
    ? (eq i values.len) (./some out)
    < wire (goo_codec/wire values.at(i))
    < tree (goo_codec/semantic wire)
    | _ i.inc out.snoc(tree)
  + optional_json
    (@@ v)
    \ encode={\ v}json value=maybe[v]
    ^ json
    ? value
     > ./none jnull
     > (./some item) (encode item)
  + number
    \ n=nat
    ^ json
    | json/num .false n
  + config_json
    \ config=goo/config
    ^ row[jkv]
    = fields=row[jkv] []
    = fields
        ? config.grow
         > ./none fields
         > (./some v) fields.snoc((jkv "grow" (goo_codec/number (? v 1 0))))
    = fields
        ? config.max_ideal
         > ./none fields
         > (./some v) fields.snoc((jkv "maxIdeal" (goo_number/encode v)))
    = fields
        ? config.primary
         > ./none fields
         > (./some v) fields.snoc((jkv "primary" (json/boo v)))
    = fields
        ? config.toggle
         > ./none fields
         > (./some v) fields.snoc((jkv "toggle" (json/boo v)))
    = fields
        ? config.label
         > ./none fields
         > (./some v) fields.snoc((jkv "label" (json/str v)))
    = fields
        ? config.option_label
         > ./none fields
         > (./some v) fields.snoc((jkv "optionLabel" (json/str v)))
    = fields
        ? config.value
         > ./none fields
         > (./some v) fields.snoc((jkv "value" (goo_number/encode v)))
    = fields
        ? config.max
         > ./none fields
         > (./some v) fields.snoc((jkv "max" (goo_number/encode v)))
    fields
  + location_json
    \ loc=goo/loc
    ^ json
    | json/obj [(jkv "line" (goo_codec/number loc.line)) (jkv "column" (goo_codec/number loc.column))]
  + common_json
    \ common=goo/common
    ^ row[jkv]
    | (goo_codec/config_json common.config).weld([(jkv "slot" (json/str common.slot.text)) (jkv "optional" (goo_codec/number common.optional.to_nat)) (jkv "origin" (goo_codec/optional_json[goo/loc] goo_codec/location_json common.origin))])
  + edge_json
    \ edge=goo/edge
    ^ json
    = affinity=str
        ? edge.bind
         > ./attached "attached"
         > ./tight "tight"
         > ./related "related"
         > ./normal "normal"
         > ./loose "loose"
         > ./separate "separate"
      source=str
        ? edge.source
         > ./exact "exact"
         > ./fallback "fallback"
         > ./uniform "uniform"
    | json/obj [(jkv "left" (json/str edge.left.text)) (jkv "right" (json/str edge.right.text)) (jkv "leftId" (json/str edge.left_id.text)) (jkv "rightId" (json/str edge.right_id.text)) (jkv "bind" (json/str affinity)) (jkv "source" (json/str source)) (jkv "parent" (json/str edge.parent.text)) (jkv "parentSlot" (json/str edge.parent_slot.text)) (jkv "rule" (goo_codec/optional_json[nat] goo_codec/number edge.rule))]
  + normalized_json
    \ tree=goo/normalized
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common).snoc((jkv "id" (json/str attrs.node_id.text)))
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "kind" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src)
          [(jkv "kind" (json/str (? ((eq attrs.common.slot.text "icon") || (eq attrs.common.slot.text "avatar")) "avatar" "media"))) (jkv "text" (json/str "")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = layout=str
              ? direction
               > ./row "flow"
               > ./col "stack"
          [(jkv "kind" (json/str "group")) (jkv "layout" (json/str layout)) (jkv "children" (json/arr kids.map(goo_codec/normalized_json)))]
    | json/obj fields.weld(payload)
  + normalized_ids
    \ tree=goo/normalized
    ^ row[str]
    | row/fold[goo/normalized row[str]] [tree.node_id.text] (\ ids child ids.weld((goo_codec/normalized_ids child))) tree.children
  + semantic_json
    \ tree=goo/semantic
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common).snoc((jkv "id" (json/str attrs.node_id.text)))
      fields fields.snoc((jkv "after" (goo_codec/optional_json[goo/edge] goo_codec/edge_json attrs.after)))
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "kind" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src)
          [(jkv "kind" (json/str (? ((eq attrs.common.slot.text "icon") || (eq attrs.common.slot.text "avatar")) "avatar" "media"))) (jkv "text" (json/str "")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = layout=str
              ? direction
               > ./row "flow"
               > ./col "stack"
          [(jkv "kind" (json/str "group")) (jkv "layout" (json/str layout)) (jkv "children" (json/arr kids.map(goo_codec/semantic_json)))]
    | json/obj fields.weld(payload)
  + semantic_ids
    \ tree=goo/semantic
    ^ row[str]
    | row/fold[goo/semantic row[str]] [tree.node_id.text] (\ ids child ids.weld((goo_codec/semantic_ids child))) tree.children
  + unique
    \ ids=row[str]
    ^ bool
    % i=nat 0
    ? (eq i ids.len) .true
    = matches (row/fold[str nat] 0 (\ count id (add count (? (eq id ids.at(i)) 1 0))) ids)
    ? !(eq matches 1) .false
    | _ i.inc
  + boundaries
    \ tree=goo/semantic
    ^ bool
    = kids tree.children
    ? tree
     > (./flow _ _ children)
      ? (eq children.len 0) .false
      | goo_codec/siblings tree kids
    .true
  + siblings
    \ parent=goo/semantic kids=row[goo/semantic]
    ^ bool
    % i=nat 0
    ? (eq i kids.len) .true
    = left kids.at(i)
      valid=bool
        ? (eq i.inc kids.len)
          | equal[maybe[goo/edge]] left.after .none
        ? left.after
         > ./none .false
         > (./some edge)
          = right kids.at(i.inc)
          | !(!(equal[goo/node_id] edge.parent parent.node_id) || !(equal[goo/slot] edge.parent_slot parent.attrs.common.slot) || !(equal[goo/node_id] edge.left_id left.node_id) || !(equal[goo/slot] edge.left left.attrs.common.slot) || !(equal[goo/node_id] edge.right_id right.node_id) || !(equal[goo/slot] edge.right right.attrs.common.slot))
    ? !valid .false
    ? !(goo_codec/boundaries left) .false
    | _ i.inc
  + validate_semantic
    \ tree=goo/semantic
    ^ bool
    ? !(goo_codec/unique (goo_codec/semantic_ids tree)) .false
    ? !(equal[maybe[goo/edge]] tree.after .none) .false
    | goo_codec/boundaries tree
  + decode_semantic
    \ value=json
    ^ maybe[goo/semantic]
    < wire (goo_codec/wire value)
    < tree (goo_codec/semantic wire)
    ? !(goo_codec/validate_semantic tree) .none
    | ./some tree
  + decode_normalized
    \ value=json
    ^ maybe[goo/normalized]
    < wire (goo_codec/wire value)
    < tree (goo_codec/normalized wire)
    ? !(goo_codec/unique (goo_codec/normalized_ids tree)) .none
    | ./some tree
  + message
    ' Versioned tree boundary only. Layout dimensions and metrics are item 07.
    \ value=json
    ^ maybe[json]
    > (json/obj fields) value .none
    < version_json (goo_codec/field fields "version")
    < version (goo_number/integer version_json)
    ? !(eq version 1) .none
    < phase_json (goo_codec/field fields "phase")
    < phase (goo_codec/text phase_json)
    < tree_json (goo_codec/field fields "tree")
    ? (eq phase "semantic")
      < tree (goo_codec/optional[goo/semantic] goo_codec/decode_semantic (./some tree_json))
      | ./some (goo_codec/optional_json[goo/semantic] goo_codec/semantic_json tree)
    ? (eq phase "normalized")
      < tree (goo_codec/optional[goo/normalized] goo_codec/decode_normalized (./some tree_json))
      | ./some (goo_codec/optional_json[goo/normalized] goo_codec/normalized_json tree)
    .none
  + run
    \ source=str
    ^ str
    = result=maybe[json]
        ? (parse source)
         > (./err _ _) .none
         > (./ok value _) (goo_codec/message value)
    ? result
     > ./none (show (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .false)) (jkv "stage" (json/str "codec")) (jkv "error" (json/str "invalid tree or protocol"))]))
     > (./some tree) (show (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "tree" tree)]))
  + compiler_message
    ' Outgoing version is fixed here, never supplied by internal callers.
    \ context=goo/compile_context tree=maybe[goo/semantic]
    ^ json
    | json/obj [(jkv "version" (goo_codec/number 1)) (jkv "viewPath" (json/str context.view_path.display)) (jkv "tree" (goo_codec/optional_json[goo/semantic] goo_codec/semantic_json tree))]
