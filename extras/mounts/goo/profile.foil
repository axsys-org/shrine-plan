    = paint_41 (json/obj [(jkv "kind" (json/str "radius")) (jkv "radius" (json/num .false 10))])
    = selected=row[json]
        ? (and (and (eq kind "button") primary) destructive) [(json/str "#9a4938") paint_0 paint_1 paint_2 (json/boo .false) paint_3]
        ? (and (eq kind "button") primary) [(json/str "#fffef6") paint_0 paint_4 paint_2 (json/boo .false) paint_3]
        ? (and (eq kind "button") destructive) [(json/str "#9a4938") paint_5 paint_1 paint_2 (json/boo .false) paint_3]
