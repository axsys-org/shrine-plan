    ? (eq kind "avatar") (goo_profile/style (goo_fonts/face/sans520) (goo_fp/times (goo/scalar 4625759767262920704) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4625759767262920704)) scale) (goo/scalar 13826050856027422720) (goo/scalar 0) (goo/scalar 0))
