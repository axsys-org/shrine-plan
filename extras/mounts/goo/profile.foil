    ? (eq role "qualifier") (goo_profile/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "metadata") (goo_profile/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "author") (goo_profile/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
