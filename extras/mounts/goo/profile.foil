- goo_app/fonts

' Generated by scripts/sync-mash-profile.py from the verified Mash bundle.
+ goo_profile
  + id
    ^ str
    "mash-goo"
  + version
    ^ nat
    1
  + revision
    ^ str
    "sha256:501b4af82a920e82624e655ffae9fbba76f874c0ef5adac746d3ab7724773979"
  + metadata
    \ ignored=unit
    ^ json
    | json/obj [(jkv "id" (json/str goo_profile/id)) (jkv "version" (json/num .false goo_profile/version)) (jkv "revision" (json/str goo_profile/revision))]
  + font_id
    \ face=goo_fonts/face
    ^ str
    ? face
     > ./sans400 "sans400"
     > ./sans520 "sans520"
     > ./sans550 "sans550"
     > ./sans620 "sans620"
     > ./sans650 "sans650"
     > ./sans750 "sans750"
     > ./mono400 "mono400"
     > ./italic400 "italic400"
  + font_family
    \ face=goo_fonts/face
    ^ str
    ? face
     > ./sans400 "Goo Sans"
     > ./sans520 "Goo Sans"
     > ./sans550 "Goo Sans"
     > ./sans620 "Goo Sans"
     > ./sans650 "Goo Sans"
     > ./sans750 "Goo Sans"
     > ./mono400 "Goo Mono"
     > ./italic400 "Goo Sans"
  + font_weight
    \ face=goo_fonts/face
    ^ nat
    ? face
     > ./sans400 400
     > ./sans520 520
     > ./sans550 550
     > ./sans620 620
     > ./sans650 650
     > ./sans750 750
     > ./mono400 400
     > ./italic400 400
  + font_style
    \ face=goo_fonts/face
    ^ str
    ? face
     > ./sans400 "normal"
     > ./sans520 "normal"
     > ./sans550 "normal"
     > ./sans620 "normal"
     > ./sans650 "normal"
     > ./sans750 "normal"
     > ./mono400 "normal"
     > ./italic400 "italic"
  + font_ascent
    \ face=goo_fonts/face
    ^ nat
    ? face
     > ./sans400 1984
     > ./sans520 1984
     > ./sans550 1984
     > ./sans620 1984
     > ./sans650 1984
     > ./sans750 1984
     > ./mono400 2146
     > ./italic400 1984
  + font_descent
    \ face=goo_fonts/face
    ^ nat
    ? face
     > ./sans400 494
     > ./sans520 494
     > ./sans550 494
     > ./sans620 494
     > ./sans650 494
     > ./sans750 494
     > ./mono400 555
     > ./italic400 494
  + font_units
    \ face=goo_fonts/face
    ^ nat
