    ? (eq role "quote") (goo_profile/style (goo_fonts/face/italic400) (goo_fp/times (goo/scalar 4625478292286210048) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608758678669597082) (goo/scalar 4625478292286210048)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
