    ? (eq role "badge") (goo_profile/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 4624070917402656768) (goo/scalar 4620693217682128896))
    (goo_profile/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4624070917402656768) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609344146621155246) (goo/scalar 4624070917402656768)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
  + natural_width
    \ kind=str
    ^ maybe[goo/scalar]
    ? (eq kind "input") (./some (goo/scalar 4643809350144491520))
    ? (eq kind "avatar") (./some (goo/scalar 4632796641680687104))
    ? (eq kind "presence") (./some (goo/scalar 4621256167635550208))
    ? (eq kind "bar") (./some (goo/scalar 4638144666238189568))
    ? (eq kind "media") (./some (goo/scalar 4646448178051153920))
    .none
  + fixed_height
    \ kind=str
    ^ maybe[goo/scalar]
    ? (eq kind "avatar") (./some (goo/scalar 4632796641680687104))
    ? (eq kind "presence") (./some (goo/scalar 4621256167635550208))
    ? (eq kind "bar") (./some (goo/scalar 4618441417868443648))
    .none
  + preferred_cap
    \ slot=str
    ^ goo/scalar
    ? (eq slot "body") (goo/scalar 4646448178051153920)
    ? (eq slot "summary") (goo/scalar 4644776920376934400)
    ? (eq slot "hint") (goo/scalar 4644161193865379840)
    ? (eq slot "caption") (goo/scalar 4644688959446712320)
    ? (eq slot "credit") (goo/scalar 4644425076656046080)
    ? (eq slot "provenance") (goo/scalar 4644337115725824000)
    ? (eq slot "title") (goo/scalar 4644600998516490240)
    ? (eq slot "code") (goo/scalar 4644776920376934400)
    (goo/scalar 4644513037586268160)
  + minimum_width
    \ slot=str
    ^ goo/scalar
    ? (eq slot "input") (goo/scalar 4639481672377565184)
    ? (eq slot "code") (goo/scalar 4639305750517121024)
    ? (eq slot "media") (goo/scalar 4639129828656676864)
    ? (eq slot "title") (goo/scalar 4637792822517301248)
    ? (eq slot "body") (goo/scalar 4639129828656676864)
    ? (eq slot "summary") (goo/scalar 4638777984935788544)
    ? (eq slot "hint") (goo/scalar 4637792822517301248)
    ? (eq slot "value") (goo/scalar 4635329916471083008)
    ? (eq slot "provenance") (goo/scalar 4637440978796412928)
    (goo/scalar 4634274385308418048)
  + fixed
    \ kind=str slot=str
    ^ bool
    ((eq kind "button") || (eq kind "avatar") || (eq kind "presence") || (eq kind "bar") || (eq slot "icon"))
  + media_minimum
    ^ goo/scalar
    (goo/scalar 4634204016564240384)
  + media_aspect_ratio
    ^ goo/scalar
    (goo/scalar 4613262278296967578)
  + status_marker
    ^ goo/scalar
    (goo/scalar 4620693217682128896)
  + status_gap
    ^ goo/scalar
    (goo/scalar 4617315517961601024)
  + fit_tolerance
    ^ goo/scalar
    (goo/scalar 4532020583610935537)
  + tab_text
    ^ str
    "    "
  + error_prefix
    ^ str
    "! "
  + paint_style
    \ kind=str role=str primary=bool destructive=bool
    ^ json
    = paint_0 (json/obj [(jkv "kind" (json/str "solid")) (jkv "color" (json/str "#34573e"))])
    = paint_1 (json/obj [(jkv "width" (json/num .false 1)) (jkv "color" (json/str "#ddbdac"))])
    = paint_2 (json/obj [(jkv "kind" (json/str "radius")) (jkv "radius" (json/num .false 5))])
    = paint_3 (json/obj [(jkv "highlight" (json/obj [(jkv "width" (json/num .false 2)) (jkv "color" (json/str "#688b43")) (jkv "offset" (json/num .false 3))])) (jkv "focus" (json/obj [(jkv "width" (json/num .false 3)) (jkv "color" (json/str "#6b8dba")) (jkv "offset" (json/num .false 3))]))])
