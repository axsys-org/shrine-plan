  + find
    ' Preserve Map.fromList semantics: the final matching rule wins.
    \ left=goo/slot right=goo/slot
    ^ maybe[goo_rules/rule]
    % i=nat 0 found=maybe[goo_rules/rule] .none
    ^ maybe[goo_rules/rule]
    ? (eq i (goo_rules/all).len) found
    = rule (goo_rules/all).at(i)
      match !(!(equal[goo/slot] left rule.left) || !(equal[goo/slot] right rule.right))
    | _ i.inc (? match (./some rule) found)
