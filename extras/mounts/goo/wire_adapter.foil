- goo_app/wire

' Adapters for APIs whose existing domain return type is json. These select a
' named contract; they cannot recursively transport arbitrary object keys.
+ goo_wire
  + encode
    \ value=json
    ^ any
    = field (\ key=str (goo_wire/field key value))
      payload=maybe[any]
        ? !(equal (field "textRuns") jnull)
          < edit (goo_wire/text_edit_from_json value)
          | ./some (wire_proto/envelope 8 (goo_wire/text_edit_bytes edit))
        ? !(equal (field "error") jnull)
          < error (goo_wire/failure_from_json value)
          | ./some (wire_proto/envelope 7 (goo_wire/failure_bytes error))
        ? !(equal (field "operationId") jnull)
          < receipt (goo_wire/operation_receipt_from_json value)
          | ./some (wire_proto/envelope 6 (goo_wire/operation_receipt_bytes receipt))
        ? !(equal (field "layouts") jnull)
          < bundle (goo_wire/layout_bundle_from_json value)
          | ./some (wire_proto/envelope 3 (goo_wire/layout_bundle_bytes bundle))
        ? !(equal (field "members") jnull)
          < source (goo_wire/source_from_json value)
          | ./some (wire_proto/envelope 4 (goo_wire/source_bytes source))
        ? !(equal (field "profile") jnull)
          < presentation (goo_wire/presentation_from_json value)
          | ./some (wire_proto/envelope 2 (goo_wire/presentation_bytes presentation))
        < snapshot (goo_wire/snapshot_from_json value)
        | ./some (wire_proto/envelope 5 (goo_wire/snapshot_bytes snapshot))
    | payload.fall((wire_proto/failure "Unsupported Goo domain message"))
  + result
    \ result=either[str json]
    ^ [nat any nat]
    ? result
     > (./ok value) [200 (goo_wire/encode value) "application/x-protobuf"]
     > (./err why) [409 (wire_proto/failure why) "application/x-protobuf"]
