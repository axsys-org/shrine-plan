- goo_app/types
- goo_app/paths
- testing

+ goo_type_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = config goo/config/empty
      common (goo/common (goo/slot "/custom/slot") (goo/rank/compact) config (./some (goo/loc 2 3)))
      sa (goo/source_attrs common)
      ca (goo/core_attrs common)
      na (goo/normalized_attrs common (goo/node_id "n"))
      va (goo/visible_attrs common (goo/node_id "v"))
      edge (goo/edge (goo/slot "left") (goo/slot "right") (goo/node_id "l") (goo/node_id "r") (goo/affinity/tight) (./some 7) (goo/edge_source/exact) (goo/node_id "p") (goo/slot "parent"))
      ma (goo/semantic_attrs common (goo/node_id "m") (./some edge))
      source=goo/source (goo/source/group sa [(goo/source/opt sa (goo/rank/full) [(goo/source/text sa "first") (goo/source/image sa "second")])])
      core=goo/core (goo/core/flow ca (goo/direction/row) [(goo/core/text ca "first") (goo/core/image ca "second")])
      normal=goo/normalized (goo/normalized/flow na (goo/direction/col) [(goo/normalized/text na "first")])
      visible=goo/visible (goo/visible/image va "image")
      semantic=goo/semantic (goo/semantic/jet ma (goo/primitive/button "Click"))
      explicit (goo/config (./some .false) (./some (goo/scalar 4609434218613702656)) (./some .true) (./some .false) (./some "") (./some "Option") (./some (goo/scalar 13832806255468478464)) (./some (goo/scalar 0)))
      checks=row[testing/check]
        [(testing/nat "source group has one optional child" 1 source.children.len)
         (testing/nat "optional rank survives" 1 (equal[goo/source] source.children.at(0) (goo/source/opt sa (goo/rank/full) [(goo/source/text sa "first") (goo/source/image sa "second")])))
         (testing/nat "core child order" 1 (equal[goo/core] core.children.at(1) (goo/core/image ca "second")))
         (testing/nat "normal child order" 1 normal.children.len)
         (testing/text "normalized ID" "n" normal.node_id.text)
         (testing/text "visible ID" "v" visible.node_id.text)
         (testing/text "semantic ID" "m" semantic.node_id.text)
         (testing/nat "semantic edge survives" 1 (equal[maybe[goo/edge]] semantic.after (./some edge)))
         (testing/nat "source common origin survives" 1 (equal[maybe[goo/loc]] source.attrs.common.origin (./some (goo/loc 2 3))))
         (testing/nat "empty config differs from explicit false, zero and empty" 0 (equal[goo/config] config explicit))
         (testing/nat "all absent config fields" 1 (equal[goo/config] config (goo/config .none .none .none .none .none .none .none .none)))
         (testing/nat "present false grow is preserved" 1 (equal[maybe[bool]] explicit.grow (./some .false)))
         (testing/nat "present true primary is preserved" 1 (equal[maybe[bool]] explicit.primary (./some .true)))
         (testing/nat "present false toggle is preserved" 1 (equal[maybe[bool]] explicit.toggle (./some .false)))
         (testing/nat "present empty label is preserved" 1 (equal[maybe[str]] explicit.label (./some "")))
         (testing/nat "option label is preserved" 1 (equal[maybe[str]] explicit.option_label (./some "Option")))
         (testing/nat "fractional max ideal is exact" 1 (equal[maybe[goo/scalar]] explicit.max_ideal (./some (goo/scalar 4609434218613702656))))
         (testing/nat "present zero max is preserved" 1 (equal[maybe[goo/scalar]] explicit.max (./some (goo/scalar 0))))
         (testing/nat "negative config scalar stays exact" 1 (equal[maybe[goo/scalar]] explicit.value (./some (goo/scalar 13832806255468478464))))
         (testing/nat "root path accepted" 1 (equal[maybe[goo/path]] (goo/path/parse_absolute "/") (./some (goo/path []))))
         (testing/text "unknown path remains open-ended" "/custom/a-b_2.name" (goo/path ["custom" "a-b_2.name"]).display)
         (testing/nat "unknown path parsed" 1 (equal[maybe[goo/path]] (goo/path/parse_absolute "/custom/a-b_2.name") (./some (goo/path ["custom" "a-b_2.name"]))))
         (testing/text "trusted paths alone normalize separators" "/a/b" (goo/path/trusted "//a//b/").display)
         (testing/text "open-ended slot conversion" "/new/role" (goo/path ["new" "role"]).slot.text)
         (testing/text "default context" "/sys/slots/summary" (goo_paths/default_context).view_path.display)
         (testing/nat "zero line invalid" 1 (equal[maybe[goo/loc]] (goo/loc/make 0 1) .none))
         (testing/nat "zero column invalid" 1 (equal[maybe[goo/loc]] (goo/loc/make 1 0) .none))
         (testing/nat "one-based origin" 1 (equal[maybe[goo/loc]] (goo/loc/make 1 1) (./some (goo/loc 1 1))))
         (testing/nat "rank required is zero" 0 (goo/rank/to_nat (goo/rank/required)))
         (testing/nat "rank compact is one" 1 (goo/rank/to_nat (goo/rank/compact)))
         (testing/nat "rank full is two" 2 (goo/rank/to_nat (goo/rank/full)))
         (testing/nat "required rank decode" 1 (equal[maybe[goo/rank]] (goo/rank/from_nat 0) (./some (goo/rank/required))))
         (testing/nat "compact rank decode" 1 (equal[maybe[goo/rank]] (goo/rank/from_nat 1) (./some (goo/rank/compact))))
         (testing/nat "full rank decode" 1 (equal[maybe[goo/rank]] (goo/rank/from_nat 2) (./some (goo/rank/full))))
         (testing/nat "unknown rank rejected" 1 (equal[maybe[goo/rank]] (goo/rank/from_nat 3) .none))
         (testing/nat "unknown primitive rejected" 1 (equal[maybe[goo/primitive_kind]] (goo/primitive_kind/parse "future") .none))]
      invalid_paths=row[str] ["" "relative" "//" "/a/" "/a//b" "/a/./b" "/a/../b" "/a b" "/a?b"]
      path_checks
        | invalid_paths.map
        \ text=str
        | testing/nat (str/cat_all ["reject path " text]) 1 (equal[maybe[goo/path]] (goo/path/parse_absolute text) .none)
      finite=row[nat] [0 9223372036854775808 1 4609434218613702656 13832806255468478464 9218868437227405311]
      scalar_checks
        | finite.map
        \ bits=nat
        | testing/nat (str/cat_all ["finite scalar " (nat/show bits)]) 1 (equal[maybe[goo/scalar]] (goo/scalar/from_bits bits) (./some (goo/scalar bits)))
      invalid=row[nat] [9218868437227405312 18442240474082181120 9221120237041090560 18446744073709551616]
      invalid_scalars
        | invalid.map
        \ bits=nat
        | testing/nat (str/cat_all ["invalid scalar " (nat/show bits)]) 1 (equal[maybe[goo/scalar]] (goo/scalar/from_bits bits) .none)
      kinds=row[goo/primitive_kind] [(goo/primitive_kind/button) (goo/primitive_kind/input) (goo/primitive_kind/code) (goo/primitive_kind/avatar) (goo/primitive_kind/presence) (goo/primitive_kind/media) (goo/primitive_kind/bar)]
      primitive_checks
        | kinds.map
        \ kind=goo/primitive_kind
        = value (goo/primitive/make kind "Payload")
        | testing/nat (str/cat_all ["primitive " kind.name]) 1 (? !(equal[goo/primitive_kind] kind value.kind) .false (? !(eq value.payload "Payload") .false (equal[maybe[goo/primitive_kind]] (goo/primitive_kind/parse kind.name) (./some kind))))
    | checks.weld(path_checks).weld(scalar_checks).weld(invalid_scalars).weld(primitive_checks)
