- goo_app/types

' Trusted vocabulary; unknown valid paths remain legal.
+ goo_paths
  + code_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/code"
  + scar_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/scar"
  + label_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/label"
  + summary_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/summary"
  + inspect_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/inspect"
  + detail_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/detail"
  + full_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/full"
  + icon_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/icon"
  + lede_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/lede"
  + caption_slot
    ^ goo/path
    | goo/path/trusted "/sys/slots/caption"
  + row_container
    ^ goo/path
    | goo/path/trusted "/sys/containers/row"
  + col_container
    ^ goo/path
    | goo/path/trusted "/sys/containers/col"
  + card_container
    ^ goo/path
    | goo/path/trusted "/sys/containers/card"
  + default_context
    ^ goo/compile_context
    | goo/compile_context goo_paths/summary_slot
