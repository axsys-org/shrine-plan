- goo_app/ascii
- goo_app/editing
- testing

+ goo_run_tests
  + node
    \ metadata=myth
    ^ goo/semantic
    | goo/semantic/text (goo/semantic_attrs (goo/common (goo/slot "body") (goo/rank/required) goo/config/empty .none) (goo/node_id "style") .none) [(goo/runt metadata (goo/lang/en "WWWW"))]
  + accepted
    \ metadata=myth
    ^ bool
    | (goo_ascii/check (goo_run_tests/node metadata)).is_none
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = bold (myth/sing ['sys 'modifiers] (pails/modifiers (list/one (modifiers/bold))))
      both (myth/sing ['sys 'modifiers] (pails/modifiers (row/stream[modifiers] [(modifiers/bold) (modifiers/italic) (modifiers/underline)])))
      linked (myth/sing ['sys 'font] (pails/p ['sys 'font 'sans])).put(['sys 'link] (weblink "https://example.com/doc")).uni(both)
      base (goo_profile/text_style (goo_fp/integer 1) "text" "body")
      plain=goo/text (goo/text/en "WWWW")
      heavy=goo/text [(goo/runt bold (goo/lang/en "WWWW"))]
      width (goo_run/width base plain)
      encoded (goo_text/encode [(goo/runt linked (goo/lang/en "hello"))])
      wrong (myth/sing ['sys 'modifiers] (pails/t "bold"))
      duplicate (myth/sing ['sys 'modifiers] (pails/modifiers (row/stream[modifiers] [(modifiers/bold) (modifiers/bold)])))
      missing (myth/sing ['sys 'font] (pails/p ['missing 'font]))
      mono_italic (myth/sing ['sys 'font] (pails/p ['sys 'font 'mono])).put(['sys 'modifiers] (pails/modifiers (list/one (modifiers/italic))))
      input (goo/semantic/jet (goo_run_tests/node bold).attrs (goo/primitive/input heavy))
    [(testing/nat "typed style metadata accepted" 1 (goo_run_tests/accepted linked))
     (testing/nat "style metadata wire round trip" 1 (equal[maybe[goo/text]] (./some [(goo/runt linked (goo/lang/en "hello"))]) (goo_text/decode encoded)))
     (testing/text "bold italic resolves actual pinned face" "italic750" (goo_run/font base linked).id)
     (testing/text "italic preserves the selected font weight" "italic550" (goo_run/font base ((myth/sing ['sys 'font] (pails/p ['sys 'font 'sans550])).put(['sys 'modifiers] (pails/modifiers (list/one (modifiers/italic)))))).id)
     (testing/nat "bold changes measured advances" 1 !(equal[goo/scalar] width (goo_run/width base heavy)))
     (testing/nat "plain fits one line" 1 (goo_ascii/wrap_runs base width width plain).len)
     (testing/nat "bold wraps using bold metrics" 2 (goo_ascii/wrap_runs base width width heavy).len)
     (testing/nat "link highlight does not add text advance" 1 (equal[goo/scalar] width (goo_run/width base [(goo/runt (myth/sing ['sys 'link] (pails/p ['note])) (goo/lang/en "WWWW"))])))
     (testing/nat "wrong modifier pail rejected" 0 (goo_run_tests/accepted wrong))
     (testing/nat "duplicate modifier rejected" 0 (goo_run_tests/accepted duplicate))
     (testing/nat "unknown font path rejected" 0 (goo_run_tests/accepted missing))
     (testing/nat "unbundled mono italic rejected" 0 (goo_run_tests/accepted mono_italic))
     (testing/nat "javascript weblink rejected" 0 (goo_run_tests/accepted (myth/sing ['sys 'link] (weblink "javascript:alert(1)"))))
     (testing/nat "styled editable value explicitly rejected" 1 (goo_ascii/check input).is_some)
     (testing/nat "typed input decoder preserves rich runs" 1 (equal[maybe[goo/text/pail]] (./some (goo/text/pail heavy)) (goo_edit/decode (pails/t (show (goo_text/encode heavy))))))
     (testing/nat "typed input decoder rejects malformed JSON" 0 (goo_edit/decode (pails/t "bad")).is_some)
     (testing/nat "typed input decoder rejects trailing JSON" 0 (goo_edit/decode (pails/t (str/cat_all [(show (goo_text/encode heavy)) "x"]))).is_some)
     (testing/nat "typed input decoder rejects unknown font" 0 (goo_edit/decode (goo/text/pail [(goo/runt missing (goo/lang/en "bad"))])).is_some)
     (testing/nat "typed input decoder rejects invalid link" 0 (goo_edit/decode (goo/text/pail [(goo/runt (myth/sing ['sys 'link] (weblink "javascript:bad")) (goo/lang/en "bad"))])).is_some)]
