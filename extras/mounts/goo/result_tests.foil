- goo_app/results
- goo_app/paths
- testing
- rex

+ goo_result_tests
  + failure
    : code=nat
  + poison
    \ ignored=unit
    ^ goo_result/attempt[goo_result/output]
    | Seq[goo_result/attempt[goo_result/output]] (error (goo_result_tests/failure 91)) (goo_result/attempt/cancelled)
  + label
    \ state=goo_result/control
    ^ str
    ? state
     > (./active _) "incomplete"
     > (./cancelled _) "cancelled"
     > (./ended result)
      ? result.completion
       > ./rejected "rejected"
       > (./crashed _ _) "crashed"
       > (./succeeded tree)
        ? tree
         > ./none "empty"
         > (./some _) "nonempty"
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = warning (goo_result/diagnostic (goo_result/severity/warning) .none "warning")
      error_diag (goo_result/diagnostic (goo_result/severity/error) (./some (goo/loc 2 3)) "bad input")
      output=goo_result/output (goo_result/output/parsed ((list/one[rex] (rex/word "second")).cons((rex/word "first"))))
      ok=goo_result/pass[goo_result/output] (goo_result/pass/classify[goo_result/output] output (list/one warning))
      failed=goo_result/pass[goo_result/output] (goo_result/pass/classify[goo_result/output] output (((list/one warning).cons(error_diag)).cons(warning)))
      start (goo_result/control/start goo_paths/default_context)
      first (goo_result/control/step "parse" "Parse source" (\ _=unit (goo_result/attempt/delivered[goo_result/output] ok)) start)
      second (goo_result/control/step "read" "Read source" (\ _=unit (goo_result/attempt/delivered[goo_result/output] failed)) first)
      crash (goo_result/control/step "read" "Read source" (\ _=unit (goo_result/attempt/delivered[goo_result/output] (goo_result/pass/crashed "boom"))) first)
      cancelled (goo_result/control/step "read" "Read source" (\ _=unit (goo_result/attempt/cancelled)) first)
      absent=goo_result/pass[goo_result/output] (goo_result/pass/rejected[goo_result/output] .none .nil)
      rejected_empty (goo_result/control/step "read" "Read source" (\ _=unit (goo_result/attempt/delivered[goo_result/output] absent)) first)
      empty (goo_result/control/finish .none first)
      attrs (goo/semantic_attrs (goo/common (goo/slot "custom") (goo/rank/required) goo/config/empty .none) (goo/node_id "id") .none)
      tree=goo/semantic (goo/semantic/text attrs "value")
      full (goo_result/control/finish (./some tree) first)
      expected_history first.checkpoint.passes.snoc((goo_result/entry "read" "Read source" failed))
      forced (Try goo_result_tests/poison ignored)
      uncaught (Try (\ _=unit (goo_result/control/step "read" "Read source" goo_result_tests/poison first)) ignored)
    [(testing/nat "warning is not error" 0 warning.is_error)
     (testing/nat "error is error" 1 error_diag.is_error)
     (testing/text "missing location" "-" warning.render_location)
     (testing/text "located diagnostic" "2:3" error_diag.render_location)
     (testing/nat "warnings do not reject pass" 0 ok.failed)
     (testing/nat "error after warning rejects pass" 1 failed.failed)
     (testing/nat "partial output and ordered diagnostics survive" 1 (equal[goo_result/pass[goo_result/output]] failed (goo_result/pass/rejected[goo_result/output] (./some output) (((list/one warning).cons(error_diag)).cons(warning)))))
     (testing/text "pending is not successful empty" "incomplete" (goo_result_tests/label first))
     (testing/text "rejected is not successful empty" "rejected" (goo_result_tests/label second))
     (testing/text "empty diagnostics still allow explicit failure" "rejected" (goo_result_tests/label rejected_empty))
     (testing/text "successful empty is explicit" "empty" (goo_result_tests/label empty))
     (testing/text "successful nonempty is explicit" "nonempty" (goo_result_tests/label full))
     (testing/nat "earlier outputs and failed partial retained" 1 (equal[list[goo_result/entry]] expected_history second.checkpoint.passes))
     (testing/nat "context survives rejection" 1 (equal[goo/compile_context] goo_paths/default_context second.checkpoint.context))
     (testing/text "crash is separate from rejection" "crashed" (goo_result_tests/label crash))
     (testing/nat "crash retains earlier output and attributes failing stage" 1 (equal[goo_result/control] crash (goo_result/control/ended (goo_result/compiled (goo_result/progress goo_paths/default_context first.checkpoint.passes.snoc((goo_result/entry "read" "Read source" (goo_result/pass/crashed "boom")))) (goo_result/completion/crashed "read" "boom")))))
     (testing/text "cancellation is not failure" "cancelled" (goo_result_tests/label cancelled))
     (testing/nat "cancellation retains checkpoint without failed entry" 1 (equal[goo_result/progress] first.checkpoint cancelled.checkpoint))
     (testing/nat "poison callback control really throws" 1 (either/is_err forced))
     (testing/nat "unhandled exceptions propagate out of recorder" 1 (either/is_err uncaught))
     (testing/nat "rejection skips later callback" 1 (equal[goo_result/control] second (goo_result/control/step "semantic" "Later" goo_result_tests/poison second)))
     (testing/nat "crash skips later callback" 1 (equal[goo_result/control] crash (goo_result/control/step "semantic" "Later" goo_result_tests/poison crash)))
     (testing/nat "cancellation skips later callback" 1 (equal[goo_result/control] cancelled (goo_result/control/step "semantic" "Later" goo_result_tests/poison cancelled)))
     (testing/nat "success skips later callback" 1 (equal[goo_result/control] full (goo_result/control/step "semantic" "Later" goo_result_tests/poison full)))
     (testing/nat "finish cannot mask failure" 1 (equal[goo_result/control] second (goo_result/control/finish .none second)))
     (testing/nat "finish cannot mask cancellation" 1 (equal[goo_result/control] cancelled (goo_result/control/finish .none cancelled)))
     (testing/nat "successful result retains semantic tree" 1 (equal[goo_result/control] full (goo_result/control/ended (goo_result/compiled first.checkpoint (goo_result/completion/succeeded (./some tree))))))]
