        ? (equal (goo_wire/field "gap" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "gap" document))
        | ./some (./some held)
    < gap gap
    | ./some (goo_wire/marker kind color diameter inset_x inset_y size gap)
  + image_paint
    : fit=str rendering=maybe[str] clip_to_corners=maybe[bool]
  + image_paint_bytes
    \ value=goo_wire/image_paint
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.fit)
        (goo_wire/optional[str] (\ item (wire_proto/text 2 item)) value.rendering)
        (goo_wire/optional[bool] (\ item (wire_proto/number 3 (? item 1 0))) value.clip_to_corners)
      ]
  + image_paint_from_json
    \ document=json
    ^ maybe[goo_wire/image_paint]
    < fit (goo_wire/string (goo_wire/field "fit" document))
    = rendering=maybe[maybe[str]]
        ? (equal (goo_wire/field "rendering" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "rendering" document))
        | ./some (./some held)
    < rendering rendering
    = clip_to_corners=maybe[maybe[bool]]
        ? (equal (goo_wire/field "clipToCorners" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "clipToCorners" document))
        | ./some (./some held)
    < clip_to_corners clip_to_corners
    | ./some (goo_wire/image_paint fit rendering clip_to_corners)
  + paint
    : version=nat units=str color_space=str foreground=str background=goo_wire/background border=goo_wire/border corners=goo_wire/corners clip=bool states=goo_wire/states marker=maybe[goo_wire/marker] image=maybe[goo_wire/image_paint]
  + paint_bytes
    \ value=goo_wire/paint
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/text 2 value.units)
        (wire_proto/text 3 value.color_space)
        (wire_proto/text 4 value.foreground)
        (wire_proto/message 5 (goo_wire/background_bytes value.background))
        (wire_proto/message 6 (goo_wire/border_bytes value.border))
        (wire_proto/message 7 (goo_wire/corners_bytes value.corners))
        (wire_proto/number 8 (? value.clip 1 0))
        (wire_proto/message 9 (goo_wire/states_bytes value.states))
        (goo_wire/optional[goo_wire/marker] (\ item (wire_proto/message 10 (goo_wire/marker_bytes item))) value.marker)
        (goo_wire/optional[goo_wire/image_paint] (\ item (wire_proto/message 11 (goo_wire/image_paint_bytes item))) value.image)
      ]
  + paint_from_json
    \ document=json
    ^ maybe[goo_wire/paint]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < units (goo_wire/string (goo_wire/field "units" document))
    < color_space (goo_wire/string (goo_wire/field "colorSpace" document))
    < foreground (goo_wire/string (goo_wire/field "foreground" document))
    < background (goo_wire/background_from_json (goo_wire/field "background" document))
    < border (goo_wire/border_from_json (goo_wire/field "border" document))
    < corners (goo_wire/corners_from_json (goo_wire/field "corners" document))
    < clip (goo_wire/boolean (goo_wire/field "clip" document))
    < states (goo_wire/states_from_json (goo_wire/field "states" document))
    = marker=maybe[maybe[goo_wire/marker]]
        ? (equal (goo_wire/field "marker" document) jnull) (./some .none)
        < held (goo_wire/marker_from_json (goo_wire/field "marker" document))
        | ./some (./some held)
    < marker marker
    = image=maybe[maybe[goo_wire/image_paint]]
        ? (equal (goo_wire/field "image" document) jnull) (./some .none)
        < held (goo_wire/image_paint_from_json (goo_wire/field "image" document))
        | ./some (./some held)
    < image image
    | ./some (goo_wire/paint version units color_space foreground background border corners clip states marker image)
  + range
    : minimum=nat maximum=nat value=nat
  + range_bytes
    \ value=goo_wire/range
    ^ any
    | bat_concat [
        (wire_proto/fixed64 1 value.minimum)
        (wire_proto/fixed64 2 value.maximum)
        (wire_proto/fixed64 3 value.value)
      ]
  + range_from_json
    \ document=json
    ^ maybe[goo_wire/range]
    < minimum (goo_wire/double (goo_wire/field "minimum" document))
    < maximum (goo_wire/double (goo_wire/field "maximum" document))
    < value (goo_wire/double (goo_wire/field "value" document))
    | ./some (goo_wire/range minimum maximum value)
  + semantics
    : version=nat role=str label=str value=maybe[str] editable=maybe[bool] multiline=maybe[bool] range=maybe[goo_wire/range]
  + semantics_bytes
    \ value=goo_wire/semantics
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/text 2 value.role)
        (wire_proto/text 3 value.label)
        (goo_wire/optional[str] (\ item (wire_proto/text 4 item)) value.value)
        (goo_wire/optional[bool] (\ item (wire_proto/number 5 (? item 1 0))) value.editable)
        (goo_wire/optional[bool] (\ item (wire_proto/number 6 (? item 1 0))) value.multiline)
        (goo_wire/optional[goo_wire/range] (\ item (wire_proto/message 7 (goo_wire/range_bytes item))) value.range)
      ]
  + semantics_from_json
    \ document=json
    ^ maybe[goo_wire/semantics]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < role (goo_wire/string (goo_wire/field "role" document))
    < label (goo_wire/string (goo_wire/field "label" document))
    = value=maybe[maybe[str]]
        ? (equal (goo_wire/field "value" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "value" document))
        | ./some (./some held)
    < value value
    = editable=maybe[maybe[bool]]
        ? (equal (goo_wire/field "editable" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "editable" document))
        | ./some (./some held)
    < editable editable
    = multiline=maybe[maybe[bool]]
        ? (equal (goo_wire/field "multiline" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "multiline" document))
        | ./some (./some held)
    < multiline multiline
    = range=maybe[maybe[goo_wire/range]]
        ? (equal (goo_wire/field "range" document) jnull) (./some .none)
        < held (goo_wire/range_from_json (goo_wire/field "range" document))
        | ./some (./some held)
    < range range
    | ./some (goo_wire/semantics version role label value editable multiline range)
  + config
    : grow=maybe[bool] max_ideal=maybe[nat] primary=maybe[bool] toggle=maybe[bool] label=maybe[str] option_label=maybe[str] value=maybe[nat] max=maybe[nat]
  + config_bytes
    \ value=goo_wire/config
    ^ any
    | bat_concat [
        (goo_wire/optional[bool] (\ item (wire_proto/number 1 (? item 1 0))) value.grow)
        (goo_wire/optional[nat] (\ item (wire_proto/fixed64 2 item)) value.max_ideal)
        (goo_wire/optional[bool] (\ item (wire_proto/number 3 (? item 1 0))) value.primary)
        (goo_wire/optional[bool] (\ item (wire_proto/number 4 (? item 1 0))) value.toggle)
        (goo_wire/optional[str] (\ item (wire_proto/text 5 item)) value.label)
        (goo_wire/optional[str] (\ item (wire_proto/text 6 item)) value.option_label)
        (goo_wire/optional[nat] (\ item (wire_proto/fixed64 7 item)) value.value)
        (goo_wire/optional[nat] (\ item (wire_proto/fixed64 8 item)) value.max)
      ]
  + config_from_json
    \ document=json
    ^ maybe[goo_wire/config]
    = grow=maybe[maybe[bool]]
        ? (equal (goo_wire/field "grow" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "grow" document))
        | ./some (./some held)
    < grow grow
    = max_ideal=maybe[maybe[nat]]
        ? (equal (goo_wire/field "maxIdeal" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "maxIdeal" document))
        | ./some (./some held)
    < max_ideal max_ideal
    = primary=maybe[maybe[bool]]
        ? (equal (goo_wire/field "primary" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "primary" document))
        | ./some (./some held)
    < primary primary
    = toggle=maybe[maybe[bool]]
        ? (equal (goo_wire/field "toggle" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "toggle" document))
        | ./some (./some held)
    < toggle toggle
    = label=maybe[maybe[str]]
        ? (equal (goo_wire/field "label" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "label" document))
        | ./some (./some held)
    < label label
    = option_label=maybe[maybe[str]]
        ? (equal (goo_wire/field "optionLabel" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "optionLabel" document))
        | ./some (./some held)
    < option_label option_label
    = value=maybe[maybe[nat]]
        ? (equal (goo_wire/field "value" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "value" document))
        | ./some (./some held)
    < value value
    = max=maybe[maybe[nat]]
        ? (equal (goo_wire/field "max" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "max" document))
        | ./some (./some held)
    < max max
    | ./some (goo_wire/config grow max_ideal primary toggle label option_label value max)
  + node
    : id=str parent_id=maybe[str] kind=str role=str slot=str payload=str box=goo_wire/box text_style=goo_wire/text_style lines=row[goo_wire/line] paint=goo_wire/paint semantics=goo_wire/semantics config=goo_wire/config text_runs=maybe[goo_wire/text_runs] editing=maybe[goo_wire/editing] src=maybe[str]
  + node_bytes
    \ value=goo_wire/node
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.id)
        (goo_wire/optional[str] (\ item (wire_proto/text 2 item)) value.parent_id)
        (wire_proto/text 3 value.kind)
        (wire_proto/text 4 value.role)
        (wire_proto/text 5 value.slot)
        (wire_proto/text 6 value.payload)
        (wire_proto/message 7 (goo_wire/box_bytes value.box))
        (wire_proto/message 8 (goo_wire/text_style_bytes value.text_style))
        (bat_concat (value.lines.map((\ item (wire_proto/message 9 (goo_wire/line_bytes item))))))
        (wire_proto/message 10 (goo_wire/paint_bytes value.paint))
        (wire_proto/message 11 (goo_wire/semantics_bytes value.semantics))
        (wire_proto/message 12 (goo_wire/config_bytes value.config))
        (goo_wire/optional[goo_wire/text_runs] (\ item (wire_proto/message 13 (goo_wire/text_runs_bytes item))) value.text_runs)
        (goo_wire/optional[goo_wire/editing] (\ item (wire_proto/message 14 (goo_wire/editing_bytes item))) value.editing)
        (goo_wire/optional[str] (\ item (wire_proto/text 15 item)) value.src)
      ]
  + node_from_json
    \ document=json
    ^ maybe[goo_wire/node]
    < id (goo_wire/string (goo_wire/field "id" document))
    = parent_id=maybe[maybe[str]]
        ? (equal (goo_wire/field "parentId" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "parentId" document))
        | ./some (./some held)
    < parent_id parent_id
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < role (goo_wire/string (goo_wire/field "role" document))
    < slot (goo_wire/string (goo_wire/field "slot" document))
    < payload (goo_wire/string (goo_wire/field "payload" document))
    < box (goo_wire/box_from_json (goo_wire/field "box" document))
    < text_style (goo_wire/text_style_from_json (goo_wire/field "textStyle" document))
    = lines=maybe[row[goo_wire/line]]
        < values (goo_wire/array (goo_wire/field "lines" document))
        < items (values.stream.traverse_maybe(goo_wire/line_from_json))
        | ./some items.row
    < lines lines
    < paint (goo_wire/paint_from_json (goo_wire/field "paint" document))
    < semantics (goo_wire/semantics_from_json (goo_wire/field "semantics" document))
    < config (goo_wire/config_from_json (goo_wire/field "config" document))
    = text_runs=maybe[maybe[goo_wire/text_runs]]
        ? (equal (goo_wire/field "textRuns" document) jnull) (./some .none)
        < held (goo_wire/text_runs_from_json (goo_wire/field "textRuns" document))
        | ./some (./some held)
    < text_runs text_runs
    = editing=maybe[maybe[goo_wire/editing]]
        ? (equal (goo_wire/field "editing" document) jnull) (./some .none)
        < held (goo_wire/editing_from_json (goo_wire/field "editing" document))
        | ./some (./some held)
    < editing editing
    = src=maybe[maybe[str]]
        ? (equal (goo_wire/field "src" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "src" document))
        | ./some (./some held)
    < src src
    | ./some (goo_wire/node id parent_id kind role slot payload box text_style lines paint semantics config text_runs editing src)
  + display
    : version=nat profile=goo_wire/profile context=goo_wire/context coordinates=str width=nat height=nat nodes=row[goo_wire/node]
  + display_bytes
    \ value=goo_wire/display
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/message 2 (goo_wire/profile_bytes value.profile))
        (wire_proto/message 3 (goo_wire/context_bytes value.context))
        (wire_proto/text 4 value.coordinates)
        (wire_proto/fixed64 5 value.width)
        (wire_proto/fixed64 6 value.height)
        (bat_concat (value.nodes.map((\ item (wire_proto/message 7 (goo_wire/node_bytes item))))))
      ]
  + display_from_json
    \ document=json
    ^ maybe[goo_wire/display]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < profile (goo_wire/profile_from_json (goo_wire/field "profile" document))
    < context (goo_wire/context_from_json (goo_wire/field "context" document))
    < coordinates (goo_wire/string (goo_wire/field "coordinates" document))
    < width (goo_wire/double (goo_wire/field "width" document))
    < height (goo_wire/double (goo_wire/field "height" document))
    = nodes=maybe[row[goo_wire/node]]
        < values (goo_wire/array (goo_wire/field "nodes" document))
        < items (values.stream.traverse_maybe(goo_wire/node_from_json))
        | ./some items.row
    < nodes nodes
    | ./some (goo_wire/display version profile context coordinates width height nodes)
  + snapshot
    : life=str subject=str target=str expected=str displayed=str publication=str projection_seq=maybe[nat] covered_operation_ids=row[str] recipe_publication=maybe[str]
  + snapshot_bytes
    \ value=goo_wire/snapshot
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.life)
        (wire_proto/text 2 value.subject)
        (wire_proto/text 3 value.target)
        (wire_proto/text 4 value.expected)
        (wire_proto/text 5 value.displayed)
        (wire_proto/text 6 value.publication)
        (goo_wire/optional[nat] (\ item (wire_proto/number 7 item)) value.projection_seq)
        (bat_concat (value.covered_operation_ids.map((\ item (wire_proto/text 8 item)))))
        (goo_wire/optional[str] (\ item (wire_proto/text 9 item)) value.recipe_publication)
      ]
  + snapshot_from_json
    \ document=json
    ^ maybe[goo_wire/snapshot]
    < life (goo_wire/string (goo_wire/field "life" document))
    < subject (goo_wire/string (goo_wire/field "subject" document))
    < target (goo_wire/string (goo_wire/field "target" document))
    < expected (goo_wire/string (goo_wire/field "expected" document))
    < displayed (goo_wire/string (goo_wire/field "displayed" document))
    < publication (goo_wire/string (goo_wire/field "publication" document))
    = projection_seq=maybe[maybe[nat]]
        ? (equal (goo_wire/field "projectionSeq" document) jnull) (./some .none)
        < held (goo_wire/natural (goo_wire/field "projectionSeq" document))
        | ./some (./some held)
