    \ document=json
    ^ maybe[goo_wire/member]
    < key (goo_wire/string (goo_wire/field "key" document))
    < subject (goo_wire/string (goo_wire/field "subject" document))
    < source (goo_wire/string (goo_wire/field "source" document))
    < source_life (goo_wire/string (goo_wire/field "sourceLife" document))
    < life (goo_wire/string (goo_wire/field "life" document))
    < type (goo_wire/string (goo_wire/field "type" document))
    < expected (goo_wire/string (goo_wire/field "expected" document))
    < status (goo_wire/string (goo_wire/field "status" document))
    < axis (goo_wire/string (goo_wire/field "axis" document))
    = face=maybe[maybe[str]]
        ? (equal (goo_wire/field "face" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "face" document))
        | ./some (./some held)
    < face face
    = topology=maybe[maybe[str]]
        ? (equal (goo_wire/field "topology" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "topology" document))
        | ./some (./some held)
    < topology topology
    = parent=maybe[maybe[str]]
        ? (equal (goo_wire/field "parent" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "parent" document))
        | ./some (./some held)
    < parent parent
    = has_children=maybe[maybe[bool]]
        ? (equal (goo_wire/field "hasChildren" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "hasChildren" document))
        | ./some (./some held)
    < has_children has_children
    | ./some (goo_wire/member key subject source source_life life type expected status axis face topology parent has_children)
  + prepared_member
    : key=str slot=str bundle=goo_wire/layout_bundle
  + prepared_member_bytes
    \ value=goo_wire/prepared_member
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.key)
        (wire_proto/text 2 value.slot)
        (wire_proto/message 3 (goo_wire/layout_bundle_bytes value.bundle))
      ]
  + prepared_member_from_json
    \ document=json
    ^ maybe[goo_wire/prepared_member]
    < key (goo_wire/string (goo_wire/field "key" document))
    < slot (goo_wire/string (goo_wire/field "slot" document))
    < bundle (goo_wire/layout_bundle_from_json (goo_wire/field "bundle" document))
    | ./some (goo_wire/prepared_member key slot bundle)
  + source
    : id=str life=str type=str axis=str topology=str bounded=bool members=row[goo_wire/member] incremental=maybe[bool] epoch=maybe[str] parent=maybe[str] next=maybe[str] omitted=maybe[nat] presentations=row[goo_wire/prepared_member]
  + source_bytes
    \ value=goo_wire/source
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.id)
        (wire_proto/text 2 value.life)
        (wire_proto/text 3 value.type)
        (wire_proto/text 4 value.axis)
        (wire_proto/text 5 value.topology)
        (wire_proto/number 6 (? value.bounded 1 0))
        (bat_concat (value.members.map((\ item (wire_proto/message 7 (goo_wire/member_bytes item))))))
        (goo_wire/optional[bool] (\ item (wire_proto/number 8 (? item 1 0))) value.incremental)
        (goo_wire/optional[str] (\ item (wire_proto/text 9 item)) value.epoch)
        (goo_wire/optional[str] (\ item (wire_proto/text 10 item)) value.parent)
        (goo_wire/optional[str] (\ item (wire_proto/text 11 item)) value.next)
        (goo_wire/optional[nat] (\ item (wire_proto/number 12 item)) value.omitted)
        (bat_concat (value.presentations.map((\ item (wire_proto/message 13 (goo_wire/prepared_member_bytes item))))))
      ]
  + source_from_json
    \ document=json
    ^ maybe[goo_wire/source]
    < id (goo_wire/string (goo_wire/field "id" document))
    < life (goo_wire/string (goo_wire/field "life" document))
    < type (goo_wire/string (goo_wire/field "type" document))
    < axis (goo_wire/string (goo_wire/field "axis" document))
    < topology (goo_wire/string (goo_wire/field "topology" document))
    < bounded (goo_wire/boolean (goo_wire/field "bounded" document))
    = members=maybe[row[goo_wire/member]]
        < values (goo_wire/array (goo_wire/field "members" document))
        < items (values.stream.traverse_maybe(goo_wire/member_from_json))
        | ./some items.row
    < members members
    = incremental=maybe[maybe[bool]]
        ? (equal (goo_wire/field "incremental" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "incremental" document))
        | ./some (./some held)
    < incremental incremental
    = epoch=maybe[maybe[str]]
        ? (equal (goo_wire/field "epoch" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "epoch" document))
        | ./some (./some held)
    < epoch epoch
    = parent=maybe[maybe[str]]
        ? (equal (goo_wire/field "parent" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "parent" document))
        | ./some (./some held)
    < parent parent
    = next=maybe[maybe[str]]
        ? (equal (goo_wire/field "next" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "next" document))
        | ./some (./some held)
    < next next
    = omitted=maybe[maybe[nat]]
        ? (equal (goo_wire/field "omitted" document) jnull) (./some .none)
        < held (goo_wire/natural (goo_wire/field "omitted" document))
        | ./some (./some held)
    < omitted omitted
    = presentations=maybe[row[goo_wire/prepared_member]]
        < values (goo_wire/array (goo_wire/field "presentations" document))
        < items (values.stream.traverse_maybe(goo_wire/prepared_member_from_json))
        | ./some items.row
    < presentations presentations
    | ./some (goo_wire/source id life type axis topology bounded members incremental epoch parent next omitted presentations)
  + operation_receipt
    : operation_id=str outcome=str
  + operation_receipt_bytes
    \ value=goo_wire/operation_receipt
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.operation_id)
        (wire_proto/text 2 value.outcome)
      ]
  + operation_receipt_from_json
    \ document=json
    ^ maybe[goo_wire/operation_receipt]
    < operation_id (goo_wire/string (goo_wire/field "operationId" document))
    < outcome (goo_wire/string (goo_wire/field "outcome" document))
    | ./some (goo_wire/operation_receipt operation_id outcome)
  + failure
    : error=str ok=maybe[bool] version=maybe[nat] code=maybe[str]
  + failure_bytes
    \ value=goo_wire/failure
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.error)
        (goo_wire/optional[bool] (\ item (wire_proto/number 2 (? item 1 0))) value.ok)
        (goo_wire/optional[nat] (\ item (wire_proto/number 3 item)) value.version)
        (goo_wire/optional[str] (\ item (wire_proto/text 4 item)) value.code)
      ]
  + failure_from_json
    \ document=json
    ^ maybe[goo_wire/failure]
    < error (goo_wire/string (goo_wire/field "error" document))
    = ok=maybe[maybe[bool]]
        ? (equal (goo_wire/field "ok" document) jnull) (./some .none)
        < held (goo_wire/boolean (goo_wire/field "ok" document))
        | ./some (./some held)
    < ok ok
    = version=maybe[maybe[nat]]
        ? (equal (goo_wire/field "version" document) jnull) (./some .none)
        < held (goo_wire/natural (goo_wire/field "version" document))
        | ./some (./some held)
    < version version
    = code=maybe[maybe[str]]
        ? (equal (goo_wire/field "code" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "code" document))
        | ./some (./some held)
    < code code
    | ./some (goo_wire/failure error ok version code)
  + myth_from_json
    \ value=json
    ^ maybe[goo_wire/myth]
    ?> (json/obj fields) value .none
    < entries
      | fields.stream.traverse_maybe
        \ field=jkv
        < pail (goo_wire/pail_from_json field.v)
        | ./some (goo_wire/myth_entry field.k pail)
    | ./some (goo_wire/myth entries.row)
  + pail_from_json
    \ value=json
    ^ maybe[goo_wire/pail]
    < kind (goo_wire/string (goo_wire/field "kind" value))
    = held (goo_wire/field "value" value)
      empty (goo_wire/pail .none .none .none .none .none .none .none)
    ? (eq kind "nat")
      < text (goo_wire/string held)
      | ./some empty.set_nat((./some text))
    ? (eq kind "bool")
      < b (goo_wire/boolean held)
      | ./some empty.set_boolean((./some b))
    ? (eq kind "text")
      < text (goo_wire/string held)
      | ./some empty.set_text((./some text))
    ? (eq kind "path")
      < text (goo_wire/string held)
      | ./some empty.set_path((./some text))
    ? (eq kind "weblink")
      < text (goo_wire/string held)
      | ./some empty.set_weblink((./some text))
    ? (eq kind "unsupported")
      < text (goo_wire/string (goo_wire/field "brand" held))
      | ./some empty.set_unsupported_brand((./some text))
    ? (eq kind "modifiers")
      < values (goo_wire/array held)
      < values (values.stream.traverse_maybe(goo_wire/string))
      | ./some empty.set_modifiers((./some (goo_wire/modifiers values.row)))
    .none
