        | ./some (./some held)
    < highlight highlight
    = focus=maybe[maybe[goo_wire/outline]]
        ? (equal (goo_wire/field "focus" document) jnull) (./some .none)
        < held (goo_wire/outline_from_json (goo_wire/field "focus" document))
        | ./some (./some held)
    < focus focus
    | ./some (goo_wire/states highlight focus)
