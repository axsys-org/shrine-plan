    ^ maybe[goo_wire/border]
    < width (goo_wire/double (goo_wire/field "width" document))
    < color (goo_wire/string (goo_wire/field "color" document))
    | ./some (goo_wire/border width color)
  + corners
    : kind=str radius=maybe[nat]
  + corners_bytes
