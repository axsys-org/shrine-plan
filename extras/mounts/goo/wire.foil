    < kind (goo_wire/string (goo_wire/field "kind" document))
    < color (goo_wire/string (goo_wire/field "color" document))
    = diameter=maybe[maybe[nat]]
        ? (equal (goo_wire/field "diameter" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "diameter" document))
        | ./some (./some held)
    < diameter diameter
    = inset_x=maybe[maybe[nat]]
        ? (equal (goo_wire/field "insetX" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "insetX" document))
        | ./some (./some held)
    < inset_x inset_x
    = inset_y=maybe[maybe[nat]]
        ? (equal (goo_wire/field "insetY" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "insetY" document))
        | ./some (./some held)
    < inset_y inset_y
    = size=maybe[maybe[nat]]
        ? (equal (goo_wire/field "size" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "size" document))
