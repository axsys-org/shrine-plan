        < items (values.stream.traverse_maybe(goo_wire/string))
        | ./some items.row
    < covered_operation_ids covered_operation_ids
    = recipe_publication=maybe[maybe[str]]
        ? (equal (goo_wire/field "recipePublication" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "recipePublication" document))
        | ./some (./some held)
    < recipe_publication recipe_publication
    | ./some (goo_wire/snapshot life subject target expected displayed publication projection_seq covered_operation_ids recipe_publication)
  + capture
    : slot=str selection=str
  + capture_bytes
    \ value=goo_wire/capture
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.slot)
        (wire_proto/text 2 value.selection)
      ]
  + capture_from_json
    \ document=json
    ^ maybe[goo_wire/capture]
    < slot (goo_wire/string (goo_wire/field "slot" document))
    < selection (goo_wire/string (goo_wire/field "selection" document))
    | ./some (goo_wire/capture slot selection)
  + binding
    : version=nat kind=str node_id=str route=str slot=str captures=row[goo_wire/capture] presented=bool
  + binding_bytes
    \ value=goo_wire/binding
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/text 2 value.kind)
        (wire_proto/text 3 value.node_id)
        (wire_proto/text 4 value.route)
        (wire_proto/text 5 value.slot)
        (bat_concat (value.captures.map((\ item (wire_proto/message 6 (goo_wire/capture_bytes item))))))
        (wire_proto/number 7 (? value.presented 1 0))
      ]
  + binding_from_json
    \ document=json
    ^ maybe[goo_wire/binding]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < node_id (goo_wire/string (goo_wire/field "nodeId" document))
    < route (goo_wire/string (goo_wire/field "route" document))
    < slot (goo_wire/string (goo_wire/field "slot" document))
    = captures=maybe[row[goo_wire/capture]]
        < values (goo_wire/array (goo_wire/field "captures" document))
        < items (values.stream.traverse_maybe(goo_wire/capture_from_json))
        | ./some items.row
    < captures captures
    < presented (goo_wire/boolean (goo_wire/field "presented" document))
    | ./some (goo_wire/binding version kind node_id route slot captures presented)
  + control
    : id=str kind=str control=str slot=str invoke=bool become=bool captures=row[goo_wire/capture] binding=goo_wire/binding
  + control_bytes
    \ value=goo_wire/control
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.id)
        (wire_proto/text 2 value.kind)
        (wire_proto/text 3 value.control)
        (wire_proto/text 4 value.slot)
        (wire_proto/number 5 (? value.invoke 1 0))
        (wire_proto/number 6 (? value.become 1 0))
        (bat_concat (value.captures.map((\ item (wire_proto/message 7 (goo_wire/capture_bytes item))))))
        (wire_proto/message 8 (goo_wire/binding_bytes value.binding))
      ]
  + control_from_json
    \ document=json
    ^ maybe[goo_wire/control]
    < id (goo_wire/string (goo_wire/field "id" document))
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < control (goo_wire/string (goo_wire/field "control" document))
    < slot (goo_wire/string (goo_wire/field "slot" document))
    < invoke (goo_wire/boolean (goo_wire/field "invoke" document))
    < become (goo_wire/boolean (goo_wire/field "become" document))
    = captures=maybe[row[goo_wire/capture]]
        < values (goo_wire/array (goo_wire/field "captures" document))
        < items (values.stream.traverse_maybe(goo_wire/capture_from_json))
        | ./some items.row
    < captures captures
    < binding (goo_wire/binding_from_json (goo_wire/field "binding" document))
    | ./some (goo_wire/control id kind control slot invoke become captures binding)
  + navigation
    : kind=str source_slot=str
  + navigation_bytes
    \ value=goo_wire/navigation
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.kind)
        (wire_proto/text 2 value.source_slot)
      ]
  + navigation_from_json
    \ document=json
    ^ maybe[goo_wire/navigation]
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < source_slot (goo_wire/string (goo_wire/field "sourceSlot" document))
    | ./some (goo_wire/navigation kind source_slot)
  + operation
    : key=str kind=str source=str
  + operation_bytes
    \ value=goo_wire/operation
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.key)
        (wire_proto/text 2 value.kind)
        (wire_proto/text 3 value.source)
      ]
  + operation_from_json
    \ document=json
    ^ maybe[goo_wire/operation]
    < key (goo_wire/string (goo_wire/field "key" document))
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < source (goo_wire/string (goo_wire/field "source" document))
    | ./some (goo_wire/operation key kind source)
  + host
    : version=nat kind=str declaration=str navigation=goo_wire/navigation operations=row[goo_wire/operation]
  + host_bytes
    \ value=goo_wire/host
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/text 2 value.kind)
        (wire_proto/text 3 value.declaration)
        (wire_proto/message 4 (goo_wire/navigation_bytes value.navigation))
        (bat_concat (value.operations.map((\ item (wire_proto/message 5 (goo_wire/operation_bytes item))))))
      ]
  + host_from_json
    \ document=json
    ^ maybe[goo_wire/host]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < kind (goo_wire/string (goo_wire/field "kind" document))
    < declaration (goo_wire/string (goo_wire/field "declaration" document))
    < navigation (goo_wire/navigation_from_json (goo_wire/field "navigation" document))
    = operations=maybe[row[goo_wire/operation]]
        < values (goo_wire/array (goo_wire/field "operations" document))
        < items (values.stream.traverse_maybe(goo_wire/operation_from_json))
        | ./some items.row
    < operations operations
    | ./some (goo_wire/host version kind declaration navigation operations)
  + pane
    : kind=str renderer=maybe[str] topology=maybe[str] axis=maybe[str] key=maybe[str] source=maybe[str] selection=maybe[str] label=maybe[str] mode=maybe[str] browse=maybe[str] operation=maybe[str] slot=maybe[str] initial=maybe[str] children=row[goo_wire/pane] node=maybe[str] profile=maybe[goo_wire/profile] context=maybe[goo_wire/context] display=maybe[goo_wire/display] controls=row[goo_wire/control] html=maybe[str]
  + pane_bytes
    \ value=goo_wire/pane
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.kind)
        (goo_wire/optional[str] (\ item (wire_proto/text 2 item)) value.renderer)
        (goo_wire/optional[str] (\ item (wire_proto/text 3 item)) value.topology)
        (goo_wire/optional[str] (\ item (wire_proto/text 4 item)) value.axis)
        (goo_wire/optional[str] (\ item (wire_proto/text 5 item)) value.key)
        (goo_wire/optional[str] (\ item (wire_proto/text 6 item)) value.source)
        (goo_wire/optional[str] (\ item (wire_proto/text 7 item)) value.selection)
        (goo_wire/optional[str] (\ item (wire_proto/text 8 item)) value.label)
        (goo_wire/optional[str] (\ item (wire_proto/text 9 item)) value.mode)
        (goo_wire/optional[str] (\ item (wire_proto/text 10 item)) value.browse)
        (goo_wire/optional[str] (\ item (wire_proto/text 11 item)) value.operation)
        (goo_wire/optional[str] (\ item (wire_proto/text 12 item)) value.slot)
        (goo_wire/optional[str] (\ item (wire_proto/text 13 item)) value.initial)
        (bat_concat (value.children.map((\ item (wire_proto/message 14 (goo_wire/pane_bytes item))))))
        (goo_wire/optional[str] (\ item (wire_proto/text 15 item)) value.node)
        (goo_wire/optional[goo_wire/profile] (\ item (wire_proto/message 16 (goo_wire/profile_bytes item))) value.profile)
        (goo_wire/optional[goo_wire/context] (\ item (wire_proto/message 17 (goo_wire/context_bytes item))) value.context)
        (goo_wire/optional[goo_wire/display] (\ item (wire_proto/message 18 (goo_wire/display_bytes item))) value.display)
        (bat_concat (value.controls.map((\ item (wire_proto/message 19 (goo_wire/control_bytes item))))))
        (goo_wire/optional[str] (\ item (wire_proto/text 20 item)) value.html)
      ]
  + pane_from_json
    \ document=json
    ^ maybe[goo_wire/pane]
    ? (equal (goo_wire/field "kind" document) (json/str "patch")) .none
    < kind (goo_wire/string (goo_wire/field "kind" document))
    = renderer=maybe[maybe[str]]
        ? (equal (goo_wire/field "renderer" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "renderer" document))
        | ./some (./some held)
    < renderer renderer
    = topology=maybe[maybe[str]]
        ? (equal (goo_wire/field "topology" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "topology" document))
        | ./some (./some held)
    < topology topology
    = axis=maybe[maybe[str]]
        ? (equal (goo_wire/field "axis" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "axis" document))
        | ./some (./some held)
    < axis axis
    = key=maybe[maybe[str]]
        ? (equal (goo_wire/field "key" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "key" document))
        | ./some (./some held)
    < key key
    = source=maybe[maybe[str]]
        ? (equal (goo_wire/field "source" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "source" document))
        | ./some (./some held)
    < source source
    = selection=maybe[maybe[str]]
        ? (equal (goo_wire/field "selection" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "selection" document))
        | ./some (./some held)
    < selection selection
    = label=maybe[maybe[str]]
        ? (equal (goo_wire/field "label" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "label" document))
        | ./some (./some held)
    < label label
    = mode=maybe[maybe[str]]
        ? (equal (goo_wire/field "mode" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "mode" document))
        | ./some (./some held)
    < mode mode
    = browse=maybe[maybe[str]]
        ? (equal (goo_wire/field "browse" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "browse" document))
        | ./some (./some held)
    < browse browse
    = operation=maybe[maybe[str]]
        ? (equal (goo_wire/field "operation" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "operation" document))
        | ./some (./some held)
    < operation operation
    = slot=maybe[maybe[str]]
        ? (equal (goo_wire/field "slot" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "slot" document))
        | ./some (./some held)
    < slot slot
    = initial=maybe[maybe[str]]
        ? (equal (goo_wire/field "initial" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "initial" document))
        | ./some (./some held)
    < initial initial
    = children=maybe[row[goo_wire/pane]]
        < values (goo_wire/array (goo_wire/field "children" document))
        < items (values.stream.traverse_maybe(goo_wire/pane_from_json))
        | ./some items.row
    < children children
    = node=maybe[maybe[str]]
        ? (equal (goo_wire/field "node" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "node" document))
        | ./some (./some held)
    < node node
    = profile=maybe[maybe[goo_wire/profile]]
        ? (equal (goo_wire/field "profile" document) jnull) (./some .none)
        < held (goo_wire/profile_from_json (goo_wire/field "profile" document))
        | ./some (./some held)
    < profile profile
    = context=maybe[maybe[goo_wire/context]]
        ? (equal (goo_wire/field "context" document) jnull) (./some .none)
        < held (goo_wire/context_from_json (goo_wire/field "context" document))
        | ./some (./some held)
    < context context
    = display=maybe[maybe[goo_wire/display]]
        ? (equal (goo_wire/field "display" document) jnull) (./some .none)
        < held (goo_wire/display_from_json (goo_wire/field "display" document))
        | ./some (./some held)
    < display display
    = controls=maybe[row[goo_wire/control]]
        < values (goo_wire/array (goo_wire/field "controls" document))
        < items (values.stream.traverse_maybe(goo_wire/control_from_json))
        | ./some items.row
    < controls controls
    = html=maybe[maybe[str]]
        ? (equal (goo_wire/field "html" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "html" document))
        | ./some (./some held)
    < html html
    | ./some (goo_wire/pane kind renderer topology axis key source selection label mode browse operation slot initial children node profile context display controls html)
  + description
    : values=row[goo_wire/pane]
  + description_bytes
    \ value=goo_wire/description
    ^ any
    | bat_concat [
        (bat_concat (value.values.map((\ item (wire_proto/message 1 (goo_wire/pane_bytes item))))))
      ]
  + description_from_json
    \ document=json
    ^ maybe[goo_wire/description]
    = document (json/obj [(jkv "values" document)])
    = values=maybe[row[goo_wire/pane]]
        < values (goo_wire/array (goo_wire/field "values" document))
        < items (values.stream.traverse_maybe(goo_wire/pane_from_json))
        | ./some items.row
    < values values
    | ./some (goo_wire/description values)
  + presentation
    : version=nat ok=bool profile=goo_wire/profile context=goo_wire/context snapshot=maybe[goo_wire/snapshot] view=maybe[str] kind=str display=maybe[goo_wire/display] controls=row[goo_wire/control] description=maybe[goo_wire/description] host=maybe[goo_wire/host] slot=maybe[str] role=maybe[str] origin=maybe[goo_wire/origin] html=maybe[str] node=maybe[str] read_only_display=maybe[goo_wire/display]
  + presentation_bytes
    \ value=goo_wire/presentation
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/number 2 (? value.ok 1 0))
        (wire_proto/message 3 (goo_wire/profile_bytes value.profile))
        (wire_proto/message 4 (goo_wire/context_bytes value.context))
        (goo_wire/optional[goo_wire/snapshot] (\ item (wire_proto/message 5 (goo_wire/snapshot_bytes item))) value.snapshot)
        (goo_wire/optional[str] (\ item (wire_proto/text 6 item)) value.view)
        (wire_proto/text 7 value.kind)
        (goo_wire/optional[goo_wire/display] (\ item (wire_proto/message 8 (goo_wire/display_bytes item))) value.display)
        (bat_concat (value.controls.map((\ item (wire_proto/message 9 (goo_wire/control_bytes item))))))
        (goo_wire/optional[goo_wire/description] (\ item (wire_proto/message 10 (goo_wire/description_bytes item))) value.description)
        (goo_wire/optional[goo_wire/host] (\ item (wire_proto/message 11 (goo_wire/host_bytes item))) value.host)
        (goo_wire/optional[str] (\ item (wire_proto/text 12 item)) value.slot)
        (goo_wire/optional[str] (\ item (wire_proto/text 13 item)) value.role)
        (goo_wire/optional[goo_wire/origin] (\ item (wire_proto/message 14 (goo_wire/origin_bytes item))) value.origin)
        (goo_wire/optional[str] (\ item (wire_proto/text 15 item)) value.html)
        (goo_wire/optional[str] (\ item (wire_proto/text 16 item)) value.node)
        (goo_wire/optional[goo_wire/display] (\ item (wire_proto/message 17 (goo_wire/display_bytes item))) value.read_only_display)
      ]
  + presentation_from_json
    \ document=json
    ^ maybe[goo_wire/presentation]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < ok (goo_wire/boolean (goo_wire/field "ok" document))
    < profile (goo_wire/profile_from_json (goo_wire/field "profile" document))
    < context (goo_wire/context_from_json (goo_wire/field "context" document))
    = snapshot=maybe[maybe[goo_wire/snapshot]]
        ? (equal (goo_wire/field "snapshot" document) jnull) (./some .none)
        < held (goo_wire/snapshot_from_json (goo_wire/field "snapshot" document))
        | ./some (./some held)
    < snapshot snapshot
    = view=maybe[maybe[str]]
        ? (equal (goo_wire/field "view" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "view" document))
        | ./some (./some held)
    < view view
    < kind (goo_wire/string (goo_wire/field "kind" document))
    = display=maybe[maybe[goo_wire/display]]
        ? (equal (goo_wire/field "display" document) jnull) (./some .none)
        < held (goo_wire/display_from_json (goo_wire/field "display" document))
        | ./some (./some held)
    < display display
    = controls=maybe[row[goo_wire/control]]
        < values (goo_wire/array (goo_wire/field "controls" document))
        < items (values.stream.traverse_maybe(goo_wire/control_from_json))
        | ./some items.row
    < controls controls
    = description=maybe[maybe[goo_wire/description]]
        ? (equal (goo_wire/field "description" document) jnull) (./some .none)
        < held (goo_wire/description_from_json (goo_wire/field "description" document))
        | ./some (./some held)
    < description description
    = host=maybe[maybe[goo_wire/host]]
        ? (equal (goo_wire/field "host" document) jnull) (./some .none)
        < held (goo_wire/host_from_json (goo_wire/field "host" document))
        | ./some (./some held)
    < host host
    = slot=maybe[maybe[str]]
        ? (equal (goo_wire/field "slot" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "slot" document))
        | ./some (./some held)
    < slot slot
    = role=maybe[maybe[str]]
        ? (equal (goo_wire/field "role" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "role" document))
        | ./some (./some held)
    < role role
    = origin=maybe[maybe[goo_wire/origin]]
        ? (equal (goo_wire/field "origin" document) jnull) (./some .none)
        < held (goo_wire/origin_from_json (goo_wire/field "origin" document))
        | ./some (./some held)
    < origin origin
    = html=maybe[maybe[str]]
        ? (equal (goo_wire/field "html" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "html" document))
        | ./some (./some held)
    < html html
    = node=maybe[maybe[str]]
        ? (equal (goo_wire/field "node" document) jnull) (./some .none)
        < held (goo_wire/string (goo_wire/field "node" document))
        | ./some (./some held)
    < node node
    = read_only_display=maybe[maybe[goo_wire/display]]
        ? (equal (goo_wire/field "readOnlyDisplay" document) jnull) (./some .none)
        < held (goo_wire/display_from_json (goo_wire/field "readOnlyDisplay" document))
        | ./some (./some held)
    < read_only_display read_only_display
    | ./some (goo_wire/presentation version ok profile context snapshot view kind display controls description host slot role origin html node read_only_display)
  + layout
    : size=str render=goo_wire/presentation
  + layout_bytes
    \ value=goo_wire/layout
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.size)
        (wire_proto/message 2 (goo_wire/presentation_bytes value.render))
      ]
  + layout_from_json
    \ document=json
    ^ maybe[goo_wire/layout]
    < size (goo_wire/string (goo_wire/field "size" document))
    < render (goo_wire/presentation_from_json (goo_wire/field "render" document))
    | ./some (goo_wire/layout size render)
  + layout_bundle
    : version=nat ok=bool layout_policy=str context=goo_wire/context layouts=row[goo_wire/layout]
  + layout_bundle_bytes
    \ value=goo_wire/layout_bundle
    ^ any
    | bat_concat [
        (wire_proto/number 1 value.version)
        (wire_proto/number 2 (? value.ok 1 0))
        (wire_proto/text 3 value.layout_policy)
        (wire_proto/message 4 (goo_wire/context_bytes value.context))
        (bat_concat (value.layouts.map((\ item (wire_proto/message 5 (goo_wire/layout_bytes item))))))
      ]
  + layout_bundle_from_json
    \ document=json
    ^ maybe[goo_wire/layout_bundle]
    < version (goo_wire/natural (goo_wire/field "version" document))
    < ok (goo_wire/boolean (goo_wire/field "ok" document))
    < layout_policy (goo_wire/string (goo_wire/field "layoutPolicy" document))
    < context (goo_wire/context_from_json (goo_wire/field "context" document))
    = layouts=maybe[row[goo_wire/layout]]
        < values (goo_wire/array (goo_wire/field "layouts" document))
        < items (values.stream.traverse_maybe(goo_wire/layout_from_json))
        | ./some items.row
    < layouts layouts
    | ./some (goo_wire/layout_bundle version ok layout_policy context layouts)
  + member
    : key=str subject=str source=str source_life=str life=str type=str expected=str status=str axis=str face=maybe[str] topology=maybe[str] parent=maybe[str] has_children=maybe[bool]
  + member_bytes
    \ value=goo_wire/member
    ^ any
    | bat_concat [
        (wire_proto/text 1 value.key)
        (wire_proto/text 2 value.subject)
        (wire_proto/text 3 value.source)
        (wire_proto/text 4 value.source_life)
        (wire_proto/text 5 value.life)
        (wire_proto/text 6 value.type)
        (wire_proto/text 7 value.expected)
        (wire_proto/text 8 value.status)
        (wire_proto/text 9 value.axis)
        (goo_wire/optional[str] (\ item (wire_proto/text 10 item)) value.face)
        (goo_wire/optional[str] (\ item (wire_proto/text 11 item)) value.topology)
        (goo_wire/optional[str] (\ item (wire_proto/text 12 item)) value.parent)
        (goo_wire/optional[bool] (\ item (wire_proto/number 13 (? item 1 0))) value.has_children)
