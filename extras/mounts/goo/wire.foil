    < kind (goo_wire/string (goo_wire/field "kind" document))
    = radius=maybe[maybe[nat]]
        ? (equal (goo_wire/field "radius" document) jnull) (./some .none)
        < held (goo_wire/double (goo_wire/field "radius" document))
        | ./some (./some held)
    < radius radius
    | ./some (goo_wire/corners kind radius)
  + outline
    : width=nat color=str offset=nat
  + outline_bytes
    \ value=goo_wire/outline
    ^ any
    | bat_concat [
        (wire_proto/fixed64 1 value.width)
        (wire_proto/text 2 value.color)
        (wire_proto/fixed64 3 value.offset)
