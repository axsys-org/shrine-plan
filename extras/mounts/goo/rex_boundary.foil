- rex
- json
'  Goo's syntax boundary. The host supplies existing Rex values without normalization.
'  Parsing and display printing are retained; diagnostics and later Goo passes are Foil.
+ goo_rex_boundary
  + field
    \ key=str value=json
    ^ jkv
    [key value]
  + text
    \ value=str
    ^ json
    | json/str value
  + number
    \ value=nat
    ^ json
    | json/num .false value
  + span_json
    \ span=rex/source_span
    ^ json
    | json/arr [(goo_rex_boundary/number span.line) (goo_rex_boundary/number span.column) (goo_rex_boundary/number span.offset) (goo_rex_boundary/number span.length)]
  + node
    \ tree=rex
    ^ json
    = f goo_rex_boundary/field
      s goo_rex_boundary/text
      many (\ kids=row[rex] (json/arr (row/map[rex json] goo_rex_boundary/node kids)))
      fields
        ? tree
         > (./leaf span shape text)
          = sh
              ? tree.leaf_error
               > (./some reason) (json/obj [(f "bad" (s reason))])
              ? tree.leaf_kind
               > (./some kind) (s kind)
              (s "unknown-shape")
          [(f "tag" (s "leaf")) (f "shape" sh) (f "text" (s text))]
         > (./nest span color rune kids)
          [(f "tag" (s "nest")) (f "color" (s color)) (f "rune" (s rune)) (f "kids" (many kids))]
         > (./expr span color kids)
          [(f "tag" (s "expr")) (f "color" (s color)) (f "kids" (many kids))]
         > (./pref span rune kid)
          [(f "tag" (s "pref")) (f "rune" (s rune)) (f "kid" (goo_rex_boundary/node kid))]
         > (./tyte span rune kids)
          [(f "tag" (s "tyte")) (f "rune" (s rune)) (f "kids" (many kids))]
         > (./bloc span color rune head kids)
          [(f "tag" (s "bloc")) (f "color" (s color)) (f "rune" (s rune)) (f "head" (goo_rex_boundary/node head)) (f "kids" (many kids))]
         > (./open span rune kids)
          [(f "tag" (s "open")) (f "rune" (s rune)) (f "kids" (many kids))]
         > (./juxt span kids)
          [(f "tag" (s "juxt")) (f "kids" (many kids))]
         > (./heir span kids)
          [(f "tag" (s "heir")) (f "kids" (many kids))]
    | json/obj (row/snoc[jkv] (f "span" (goo_rex_boundary/span_json tree.span)) fields)
  + echo
    \ trees=row[rex]
    ^ str
    | show (json/obj [(goo_rex_boundary/field "version" (goo_rex_boundary/number 1)) (goo_rex_boundary/field "ok" (json/boo .true)) (goo_rex_boundary/field "trees" (json/arr trees.map(goo_rex_boundary/node)))])
  + reason_text
    \ reason=str
    ^ str
    ? (eq reason "invalid-char") "invalid character"
    ? (eq reason "unclosed-trad") "unclosed string literal"
    ? (eq reason "unclosed-ugly") "unclosed multi-line string"
    ? (eq reason "mismatched-bracket") "mismatched bracket"
    ? (eq reason "invalid-page") "invalid page string indentation"
    "invalid span string indentation"
  + diagnostics
    \ tree=rex
    ^ row[json]
    = nested (row/fold[rex row[json]] [] (\ acc=row[json] child=rex acc.weld((goo_rex_boundary/diagnostics child))) tree.children)
    ? tree.leaf_error
     > ./none nested
     > (./some reason)
      = f goo_rex_boundary/field
        s goo_rex_boundary/text
        n goo_rex_boundary/number
        sp tree.span
        location
          ? (eq sp.line 0) jnull
          (json/arr [(n sp.line) (n (? (eq sp.column 0) 1 sp.column))])
      [(json/obj [(f "stage" (s "parse")) (f "severity" (s "error")) (f "location" location) (f "message" (s (goo_rex_boundary/reason_text reason)))])]
  + accept
    \ trees=row[rex]
    ^ str
    = ds (row/fold[rex row[json]] [] (\ acc=row[json] tree=rex acc.weld((goo_rex_boundary/diagnostics tree))) trees)
      f goo_rex_boundary/field
    | show (json/obj [(f "version" (goo_rex_boundary/number 1)) (f "ok" (json/boo .true)) (f "trees" (json/arr trees.map(goo_rex_boundary/node))) (f "diagnostics" (json/arr ds))])
