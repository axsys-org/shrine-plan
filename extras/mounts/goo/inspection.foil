- goo_app/codecs
- goo_app/results

+ goo_inspect
  + source
    \ tree=goo/source
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common)
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "constructor" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src) [(jkv "constructor" (json/str "image")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "constructor" (json/str "primitive")) (jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = dir=str
              ? direction
               > ./row "Row"
               > ./col "Col"
          [(jkv "constructor" (json/str "flow")) (jkv "direction" (json/str dir)) (jkv "children" (json/arr kids.map(goo_inspect/source)))]
         > (./group _ kids) [(jkv "constructor" (json/str "group")) (jkv "children" (json/arr kids.map(goo_inspect/source)))]
         > (./opt _ rank kids) [(jkv "constructor" (json/str "opt")) (jkv "rank" (goo_codec/number rank.to_nat)) (jkv "children" (json/arr kids.map(goo_inspect/source)))]
    | json/obj payload.cons((jkv "attrs" (json/obj fields)))
  + core
    \ tree=goo/core
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common)
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "constructor" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src) [(jkv "constructor" (json/str "image")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "constructor" (json/str "primitive")) (jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = dir=str
              ? direction
               > ./row "Row"
               > ./col "Col"
          [(jkv "constructor" (json/str "flow")) (jkv "direction" (json/str dir)) (jkv "children" (json/arr kids.map(goo_inspect/core)))]
    | json/obj payload.cons((jkv "attrs" (json/obj fields)))
  + normalized
    \ tree=goo/normalized
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common)
      fields fields.snoc((jkv "id" (json/str attrs.node_id.text)))
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "constructor" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src) [(jkv "constructor" (json/str "image")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "constructor" (json/str "primitive")) (jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = dir=str
              ? direction
               > ./row "Row"
               > ./col "Col"
          [(jkv "constructor" (json/str "flow")) (jkv "direction" (json/str dir)) (jkv "children" (json/arr kids.map(goo_inspect/normalized)))]
    | json/obj payload.cons((jkv "attrs" (json/obj fields)))
  + visible
    \ tree=goo/visible
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common)
      fields fields.snoc((jkv "id" (json/str attrs.node_id.text)))
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "constructor" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src) [(jkv "constructor" (json/str "image")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "constructor" (json/str "primitive")) (jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = dir=str
              ? direction
               > ./row "Row"
               > ./col "Col"
          [(jkv "constructor" (json/str "flow")) (jkv "direction" (json/str dir)) (jkv "children" (json/arr kids.map(goo_inspect/visible)))]
    | json/obj payload.cons((jkv "attrs" (json/obj fields)))
  + semantic
    \ tree=goo/semantic
    ^ json
    = attrs tree.attrs
      fields (goo_codec/common_json attrs.common)
      fields fields.snoc((jkv "id" (json/str attrs.node_id.text)))
      fields fields.snoc((jkv "after" (goo_codec/optional_json[goo/edge] goo_codec/edge_json attrs.after)))
      payload=row[jkv]
        ? tree
         > (./text _ text) [(jkv "constructor" (json/str "text")) (jkv "text" (json/str text))]
         > (./image _ src) [(jkv "constructor" (json/str "image")) (jkv "src" (json/str src))]
         > (./jet _ primitive) [(jkv "constructor" (json/str "primitive")) (jkv "kind" (json/str primitive.kind.name)) (jkv "text" (json/str primitive.payload))]
         > (./flow _ direction kids)
          = dir=str
              ? direction
               > ./row "Row"
               > ./col "Col"
          [(jkv "constructor" (json/str "flow")) (jkv "direction" (json/str dir)) (jkv "children" (json/arr kids.map(goo_inspect/semantic)))]
    | json/obj payload.cons((jkv "attrs" (json/obj fields)))
  + output
    \ output=goo_result/output
    ^ json
    ? output
     > (./parsed trees) (json/arr trees.map(goo_rex_boundary/node))
     > (./read tree) (goo_inspect/source tree)
     > (./core tree) (goo_inspect/core tree)
     > (./normalized tree) (goo_inspect/normalized tree)
     > (./visible tree) (goo_codec/optional_json[goo/visible] goo_inspect/visible tree)
     > (./semantic tree) (goo_codec/optional_json[goo/semantic] goo_inspect/semantic tree)
  + diagnostic
    \ stage=str diagnostic=goo_result/diagnostic
    ^ json
    = severity=str
        ? diagnostic.severity
         > ./error "error"
         > ./warning "warning"
    | json/obj [(jkv "stage" (json/str stage)) (jkv "severity" (json/str severity)) (jkv "location" (goo_codec/optional_json[goo/loc] goo_codec/location_json diagnostic.location)) (jkv "message" (json/str diagnostic.message))]
  + stage
    \ name=str status=str output=json diagnostics=row[json]
    ^ json
    | json/obj [(jkv "name" (json/str name)) (jkv "status" (json/str status)) (jkv "output" output) (jkv "diagnostics" (json/arr diagnostics))]
  + entry
    \ entry=goo_result/entry
    ^ json
    ? entry.result
     > (./succeeded value diagnostics) (goo_inspect/stage entry.name "ok" (goo_inspect/output value) diagnostics.map((goo_inspect/diagnostic entry.name)))
     > (./rejected partial diagnostics) (goo_inspect/stage entry.name "failed" (goo_codec/optional_json[goo_result/output] goo_inspect/output partial) diagnostics.map((goo_inspect/diagnostic entry.name)))
     > (./crashed message)
      | goo_inspect/stage entry.name "crashed" jnull [(json/obj [(jkv "stage" (json/str entry.name)) (jkv "severity" (json/str "exception")) (jkv "location" jnull) (jkv "message" (json/str message))])]
  + at
    \ entries=row[goo_result/entry] name=str
    ^ json
    % i=nat 0
    ^ json
    ? (eq i entries.len) (goo_inspect/stage name "skipped" jnull [])
    = entry entries.at(i)
    ? (eq entry.name name) (goo_inspect/entry entry)
    | _ i.inc
  + response
    \ state=goo_result/control
    ^ json
    = progress state.checkpoint
      names=row[str] ["parse" "read" "core" "normalized" "visible" "semantic" "metrics" "layout" "trace" "prepared" "html"]
      outcome=str
        ? state
         > (./ended compiled)
          ? compiled.completion
           > ./rejected "rejected"
           > (./crashed _ _) "crashed"
           > (./succeeded _) "incomplete"
         > (./cancelled _) "cancelled"
         > (./active _) "incomplete"
    | json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "outcome" (json/str outcome)) (jkv "stages" (json/arr names.map((goo_inspect/at progress.passes))))]
