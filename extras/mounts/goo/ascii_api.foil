- goo_app/ascii

' Inspection boundary for the native measurer; no planner or browser tolerance.
+ goo_ascii_api
  + request
    : tree=goo/semantic scale=goo/scalar widths=list[goo/scalar]
  + decode
    \ value=json
    ^ maybe[goo_ascii_api/request]
    > (json/obj fields) value .none
    < version_value (goo_codec/field fields "version")
    < version (goo_number/integer version_value)
    ? !(eq version 1) .none
    < tree_value (goo_codec/field fields "tree")
    < tree (goo_codec/decode_semantic tree_value)
    < scale_value (goo_codec/field fields "textScale")
    < scale (goo_number/nonnegative scale_value)
    ? ((goo_fp/lte scale (goo/scalar 0)) || !(goo_fp/lte scale (goo_fp/integer 10))) .none
    < widths_value (goo_codec/field fields "widths")
    < widths (goo_measure/array[goo/scalar] goo_number/nonnegative widths_value)
    ? (list/any[goo/scalar] (\ width !(goo_fp/lte width (goo_fp/integer 100000))) widths) .none
    | ./some (goo_ascii_api/request tree scale widths)
  + style_json
    \ style=goo_ascii/style
    ^ json
    | json/obj [(jkv "face" (json/str (goo_fonts/metadata style.face).name)) (jkv "pixels" (goo_number/encode style.pixels)) (jkv "leading" (goo_number/encode style.leading)) (jkv "tracking" (goo_number/encode style.tracking)) (jkv "insetX" (goo_number/encode style.inset_x)) (jkv "insetY" (goo_number/encode style.inset_y))]
  + layout_json
    \ scale=goo/scalar tree=goo/semantic width=goo/scalar
    ^ json
    = lines (goo_ascii/text_lines scale tree width)
      encoded=json
        ? lines
         > ./none jnull
         > (./some rows) (json/arr rows.map((\ text=str (json/str text))).row)
    | json/obj [(jkv "width" (goo_number/encode width)) (jkv "height" (goo_number/encode (goo_ascii/leaf_height scale tree width))) (jkv "lines" encoded)]
  + node_json
    \ scale=goo/scalar widths=list[goo/scalar] tree=goo/semantic
    ^ json
    | json/obj [(jkv "id" (json/str tree.node_id.text)) (jkv "style" (goo_ascii_api/style_json (goo_ascii/text_style scale tree))) (jkv "natural" (goo_number/encode (goo_ascii/natural_width scale tree))) (jkv "size" (goo_measure/encode_size (goo_ascii/leaf_size scale tree))) (jkv "layouts" (json/arr widths.map((goo_ascii_api/layout_json scale tree)).row))]
  + failure
    \ stage=str message=str
    ^ json
    | json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .false)) (jkv "stage" (json/str stage)) (jkv "error" (json/str message))]
  + evaluate
    \ request=goo_ascii_api/request
    ^ json
    ? (goo_ascii/check request.tree)
     > (./some error) (goo_ascii_api/failure "ascii" error)
    = leaves (list/filter[goo/semantic] (\ node !(eq (goo_ascii/kind node) "group")) (goo_measure/nodes request.tree))
    | json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "nodes" (json/arr leaves.map((goo_ascii_api/node_json request.scale request.widths)).row))]
  + run
    \ source=str
    ^ str
    = request=maybe[goo_ascii_api/request]
        > (./ok value _) (parse source) .none
        | goo_ascii_api/decode value
    ? request
     > ./none (show (goo_ascii_api/failure "protocol" "invalid ASCII measurement request"))
     > (./some request) (show (goo_ascii_api/evaluate request))
  + fonts
    \ ignored=unit
    ^ str
    | show (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "faces" (json/arr (goo_fonts/all).map(goo_fonts/json)))])
