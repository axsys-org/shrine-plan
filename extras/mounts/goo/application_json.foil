- json

' The inspector returns large HTML strings with many quotes. Keep escaped runs
' separate until a balanced join; a growing quoted-string accumulator is quadratic.
+ goo_app_json
  + quote
    \ source=str
    ^ str
    = body=row[str]
        % i=nat 0 start=nat 0 pieces=list[str] .nil
        ^ row[str]
        ? (eq i source.len) (list/cons source.slice(start (sub i start)) pieces).row.rev
        = byte source.at(i)
        ? !((eq byte 34) || (eq byte 92) || (lt byte 32)) (_ i.inc start pieces)
        = escaped=str
            ? ((eq byte 34) || (eq byte 92)) "".snoc_byte(92).snoc_byte(byte)
            ? (eq byte 10) "".snoc_byte(92).snoc_byte(110)
            ? (eq byte 9) "".snoc_byte(92).snoc_byte(116)
            ? (eq byte 13) "".snoc_byte(92).snoc_byte(114)
            | str/cat_all ["".snoc_byte(92) "u00" (hex/byte byte)]
          pieces (list/cons escaped (list/cons source.slice(start (sub i start)) pieces))
        | _ i.inc i.inc pieces
      quote "".snoc_byte(34)
    | str/cat_all [quote (str/cat_all body) quote]
  + encode
    \ value=json
    ^ str
    ? value
     > (json/str text) (goo_app_json/quote text)
     > (json/arr values) (str/cat_all ["[" (str/join "," values.map(goo_app_json/encode)) "]"])
     > (json/obj fields)
      = parts fields.map((\ field=jkv (str/cat_all [(goo_app_json/quote field.k) ":" (goo_app_json/encode field.v)])))
      | str/cat_all ["{" (str/join "," parts) "}"]
    | show value
  + script
    \ value=json
    ^ str
    = text (goo_app_json/encode value)
      pieces=row[str]
        % i=nat 0 start=nat 0 out=list[str] .nil
        ^ row[str]
        ? (eq i text.len) (list/cons text.slice(start (sub i start)) out).row.rev
        ? !(eq text.at(i) 60) (_ i.inc start out)
        = out (list/cons (str/cat_all ["".snoc_byte(92) "u003c"]) (list/cons text.slice(start (sub i start)) out))
        | _ i.inc i.inc out
    | str/cat_all pieces
