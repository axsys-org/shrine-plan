- goo_app/run_fonts
- goo_app/text

' Resolve typed run metadata to pinned fonts and renderer-neutral recipes.
+ goo_run
  + font_at
    \ target=path
    ^ maybe[goo_run_fonts/font]
    ? (equal[path] target ['sys 'font 'sans]) (./some (goo_run_fonts/base (goo_fonts/face/sans400)))
    ? (equal[path] target ['sys 'font 'mono]) (./some (goo_run_fonts/base (goo_fonts/face/mono400)))
    ? (equal[path] target ['sys 'font 'italic520]) (./some goo_run_fonts/italic520)
    ? (equal[path] target ['sys 'font 'italic550]) (./some goo_run_fonts/italic550)
    ? (equal[path] target ['sys 'font 'italic620]) (./some goo_run_fonts/italic620)
    ? (equal[path] target ['sys 'font 'italic650]) (./some goo_run_fonts/italic650)
    ? (equal[path] target ['sys 'font 'italic750]) (./some goo_run_fonts/italic750)
    ? (equal[path] target ['sys 'font 'mono700]) (./some goo_run_fonts/mono700)
    = faces goo_fonts/all
    % i=nat 0
    ^ maybe[goo_run_fonts/font]
    ? (eq i faces.len) .none
    = face faces.at(i)
    ? (eq (path_show target) (str/cat_all ["/sys/font/" (goo_profile/font_id face)])) (./some (goo_run_fonts/base face))
    | _ i.inc
  + italic_font
    \ weight=nat
    ^ maybe[goo_run_fonts/font]
    ? (eq weight 400) (./some (goo_run_fonts/base (goo_fonts/face/italic400)))
    ? (eq weight 520) (./some goo_run_fonts/italic520)
    ? (eq weight 550) (./some goo_run_fonts/italic550)
    ? (eq weight 620) (./some goo_run_fonts/italic620)
    ? (eq weight 650) (./some goo_run_fonts/italic650)
    ? (eq weight 750) (./some goo_run_fonts/italic750)
    .none
  + resolve
    \ base=goo_profile/style metadata=myth
    ^ maybe[goo_run_fonts/font]
    = candidate=maybe[goo_run_fonts/font]
        ? metadata.get(['sys 'font])
         > ./none (./some (goo_run_fonts/base base.face))
         > (./some held)
          ?> font=pails/p held .none
          | goo_run/font_at font.p
    < selected candidate
    = bold (goo_text/modifier (modifiers/bold) metadata)
      italic ((goo_text/modifier (modifiers/italic) metadata) || selected.info.italic)
      mono (eq selected.family "Goo Mono")
    ? (and mono italic) .none
    ? bold
      ? mono (./some goo_run_fonts/mono700)
      ? italic (./some goo_run_fonts/italic750)
      | ./some (goo_run_fonts/base (goo_fonts/face/sans750))
    ? (and italic !(selected.info.italic))
      | goo_run/italic_font selected.info.weight
    | ./some selected
  + font
    ' Measurement callers are guarded by goo_ascii/check; the fallback supports diagnostics.
    \ base=goo_profile/style metadata=myth
    ^ goo_run_fonts/font
    | (goo_run/resolve base metadata).fall((goo_run_fonts/base base.face))
  + advance
    \ base=goo_profile/style font=goo_run_fonts/font byte=nat
    ^ goo/scalar
    | goo_fp/plus (goo_fp/times base.pixels (goo_fp/quotient (goo_fp/integer font.info.advances.at((sub byte 32))) (goo_fp/integer font.info.units))) base.tracking
  + width
    \ base=goo_profile/style runs=goo/text
    ^ goo/scalar
    % i=nat 0 total=goo/scalar (goo/scalar 0)
    ? (eq i runs.len) total
    = run runs.at(i) font (goo_run/font base run.myth)
      next=goo/scalar
        % j=nat 0 out=goo/scalar total
        ? (eq j run.lang.txt.len) out
        | _ j.inc (goo_fp/plus out (goo_run/advance base font run.lang.txt.at(j)))
    | _ i.inc next
  + advances
    \ base=goo_profile/style runs=goo/text
    ^ row[goo/scalar]
    | runs.bind
      \ run=goo/runt
      = font (goo_run/font base run.myth)
      | (list/range 0 run.lang.txt.len).map((\ i (goo_run/advance base font run.lang.txt.at(i)))).row
  + style_json
    \ base=goo_profile/style metadata=myth
    ^ json
    = font (goo_run/font base metadata) info font.info
    | json/obj [(jkv "fontId" (json/str font.id)) (jkv "fontSHA256" (json/str info.font_sha256)) (jkv "family" (json/str font.family)) (jkv "weight" (json/num .false info.weight)) (jkv "style" (json/str (? info.italic "italic" "normal"))) (jkv "fontSize" (goo_number/encode base.pixels)) (jkv "lineHeight" (goo_number/encode base.leading)) (jkv "letterSpacing" (goo_number/encode base.tracking)) (jkv "insetX" (json/num .false 0)) (jkv "insetY" (json/num .false 0)) (jkv "kerning" (json/boo .false)) (jkv "ligatures" (json/boo .false))]
  + link_json
    \ metadata=myth
    ^ json
    ?> (./some held) metadata.get(['sys 'link]) jnull
    ? held
     > value=pails/p (json/obj [(jkv "kind" (json/str "path")) (jkv "path" (json/str (path_show value.p)))])
     > value=weblink (json/obj [(jkv "kind" (json/str "weblink")) (jkv "href" (json/str value.href))])
    jnull
  + recipe
    \ base=goo_profile/style metadata=myth foreground=str baseline=goo/scalar
    ^ json
    = link (goo_text/linked metadata)
      ink=str (? link "#34573e" foreground)
      underline (goo_text/modifier (modifiers/underline) metadata)
    | json/obj
      [(jkv "version" (json/num .false 1))
       (jkv "textStyle" (goo_run/style_json base metadata))
       (jkv "foreground" (json/str ink))
       (jkv "highlight" (? link (json/obj [(jkv "fill" (json/str "#e7eedf")) (jkv "stroke" (json/str "#688b43")) (jkv "width" (json/num .false 1)) (jkv "radius" (json/num .false 2))]) jnull))
       (jkv "underline" (? underline (json/obj [(jkv "color" (json/str ink)) (jkv "width" (json/num .false 1)) (jkv "y" (goo_number/encode (goo_fp/plus baseline (goo_fp/quotient base.pixels (goo_fp/integer 10)))))]) jnull))
       (jkv "semantics" (json/obj [(jkv "role" (json/str (? link "link" "text"))) (jkv "target" (goo_run/link_json metadata))]))]
