- goo_app/ascii
- goo_app/compile
- testing

+ goo_text_tests
  + annotation
    : weight=nat label=str
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = a (myth/sing ['future 'weight] (pails/n 550))
      b (myth/sing ['mark] (pails/b .true))
      typed (myth/sing ['label] (pails/t "label")).put(['reference] (pails/p ['demo ($u 3)]))
      custom (myth/sing ['annotation] (goo_text_tests/annotation 550 "run"))
      custom_value (custom.get(['annotation]).fall((pails/n 0)))
      custom_runs=goo/text [(goo/runt custom (goo/lang/en "custom"))]
      rich=goo/text [(goo/runt a (goo/lang/en "ab")) (goo/runt b (goo/lang/en "cd"))]
      common (goo/common (goo/slot "body") (goo/rank/required) goo/config/empty .none)
      semantic (goo/semantic/text (goo/semantic_attrs common (goo/node_id "text") .none) rich)
      plain (goo/semantic/text (goo/semantic_attrs common (goo/node_id "text") .none) (goo/text/en "abcd"))
      scale (goo/scalar 4607182418800017408)
      sliced (goo/text/slice 1 2 rich)
      lines (goo_ascii/text_lines scale semantic (goo_fp/integer 1)).fall(.nil)
      cross=goo/text [(goo/runt a (goo/lang/en "a".snoc_byte(13))) (goo/runt b (goo/lang/en (str/cat_all ["".snoc_byte(10) "b" "".snoc_byte(9) "c"])))]
      normalized (goo_text/normalized goo_profile/tab_text cross)
      words (goo_text/words [(goo/runt a (goo/lang/en " a ")) (goo/runt b (goo/lang/en " b "))])
      source (goo/source/text (goo/source_attrs common) rich)
      core (goo_pass/normalize source)
      preserved=bool
        > (./ok core) core .false
        = assigned (goo_pass/assign core (list/one (goo/node_id "text")) 0).tree
          visible (goo_pass/visibility (goo/render_options (goo/rank/full) .nil .nil .false) assigned)
        > (./some semantic) (goo_compile/semantic .false visible) .false
        | equal[goo/text] rich (goo_ascii/runs semantic)
      partition_text (str/cat_all ["ab cd" "".snoc_byte(13).snoc_byte(10) "e" "".snoc_byte(9) "f"])
      partition_plain (goo/semantic/text (goo/semantic_attrs common (goo/node_id "partition") .none) (goo/text/en partition_text))
      partition_lines (goo_ascii/text_lines scale partition_plain (goo_fp/integer 20)).fall(.nil).map((\ line=goo/text line.plain))
      partitions
        | (list/range 0 partition_text.len.inc).map
        \ cut=nat
        = parts=goo/text [(goo/runt myth/new (goo/lang/en partition_text.slice(0 cut))) (goo/runt myth/new (goo/lang/en partition_text.slice(cut (sub partition_text.len cut))))]
          node (goo/semantic/text (goo/semantic_attrs common (goo/node_id "partition") .none) parts)
          lines (goo_ascii/text_lines scale node (goo_fp/integer 20)).fall(.nil).map((\ line=goo/text line.plain))
        | testing/nat (str/cat_all ["run partition preserves wrapping " (nat/show cut)]) 1 (equal[list[str]] partition_lines lines)
      foreign_language (json/arr [(json/obj [(jkv "myth" (json/obj [])) (jkv "lang" (json/obj [(jkv "jp" (json/obj [(jkv "txt" (json/str "test"))]))]))])])
      duplicate_myth (json/obj [(jkv "/a" (goo_text/encode_pail (pails/b .true))) (jkv "/a" (goo_text/encode_pail (pails/b .false)))])
      image_wire (goo_wire/node [(jkv "id" (json/str "image")) (jkv "slot" (json/str "media")) (jkv "kind" (json/str "media")) (jkv "src" (json/str "image.png")) (jkv "textRuns" (goo_text/encode rich))])
      checks=row[testing/check]
        [(testing/text "plain text is concatenation without separators" "abcd" rich.plain)
         (testing/nat "English literal creates one run" 1 (goo/text/en "hello").len)
         (testing/nat "run codec preserves typed myth slots" 1 (equal[maybe[goo/text]] (./some rich) (goo_text/decode (goo_text/encode rich))))
         (testing/nat "text and path pails round trip" 1 (equal[maybe[myth]] (./some typed) (goo_text/decode_myth (goo_text/encode_myth typed))))
         (testing/nat "arbitrary branded pail survives slicing" 1 (equal[myth] custom (goo/text/slice 1 3 custom_runs).at(0).myth))
         (testing/nat "custom pail keeps its brand" 1 (maybe/is_some (goo_text_tests/annotation/try_from_pail custom_value)))
         (testing/nat "unsupported wire pail is not coerced" 0 (maybe/is_some (goo_text/decode_myth (goo_text/encode_myth custom))))
         (testing/nat "noncanonical slot path rejected" 0 (maybe/is_some (goo_text/decode_myth (json/obj [(jkv "label" (goo_text/encode_pail (pails/t "x")))]))))
         (testing/nat "empty run array round trips" 1 (equal[maybe[goo/text]] (./some []) (goo_text/decode (json/arr []))))
         (testing/text "slice across runs" "bc" sliced.plain)
         (testing/nat "slice retains first descriptor" 1 (equal[myth] a sliced.at(0).myth))
         (testing/nat "slice retains second descriptor" 1 (equal[myth] b sliced.at(1).myth))
         (testing/nat "out of bounds slice is empty" 0 (goo/text/slice 10 2 rich).len)
         (testing/nat "zero width slice is empty" 0 (goo/text/slice 1 0 rich).len)
         (testing/nat "compiler passes preserve all runs" 1 preserved)
         (testing/nat "run partition does not change measurement" 1 (equal[goo_measure/size] (goo_ascii/leaf_size scale semantic) (goo_ascii/leaf_size scale plain)))
         (testing/nat "wrapping can split every run" 4 lines.len)
         (testing/text "wrapped runs retain content" "abcd" (str/cat_all lines.map((\ line=goo/text line.plain)).row))
         (testing/nat "wrapped first descriptor" 1 (equal[myth] a lines.at(0).at(0).myth))
         (testing/nat "wrapped last descriptor" 1 (equal[myth] b lines.at(3).at(0).myth))
         (testing/text "CRLF across runs and tab expansion" (str/cat_all ["a" "".snoc_byte(10) "b    c"]) normalized.plain)
         (testing/nat "normalization retains descriptor" 1 (equal[myth] b normalized.at(1).myth))
         (testing/text "word whitespace collapse across runs" "a b" words.plain)
         (testing/nat "unsupported descriptor is diagnosed before rendering" 1 (maybe/is_some (goo_ascii/check semantic)))
         (testing/nat "empty descriptor supports existing English rendering" 0 (maybe/is_some (goo_ascii/check plain)))
         (testing/nat "unsupported language rejected" 0 (maybe/is_some (goo_text/decode foreign_language)))
         (testing/nat "duplicate descriptor keys rejected" 0 (maybe/is_some (goo_text/decode_myth duplicate_myth)))
         (testing/nat "image codecs never discard run metadata" 0 (maybe/is_some (goo_codec/normalized image_wire)))
         (testing/nat "projection disagreement rejected" 0 (maybe/is_some (goo_codec/text_value [(jkv "text" (json/str "other")) (jkv "textRuns" (goo_text/encode rich))])))
        ]
    | checks.weld(partitions.row)
