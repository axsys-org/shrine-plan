- goo_app/fonts
- goo_app/measurement

+ goo_ascii
  + style
    : face=goo_fonts/face pixels=goo/scalar leading=goo/scalar tracking=goo/scalar inset_x=goo/scalar inset_y=goo/scalar
  + kind
    \ tree=goo/semantic
    ^ str
    ? tree
     > (./text _ _) "text"
     > (./image _ _)
      = slot tree.attrs.common.slot.text
      ? ((eq slot "icon") || (eq slot "avatar")) "avatar" "media"
     > (./jet _ primitive) primitive.kind.name
    "group"
  + role
    \ tree=goo/semantic
    ^ str
    | (str/split_byte 47 tree.attrs.common.slot.text).at(0)
  + payload
    \ tree=goo/semantic
    ^ str
    ? tree
     > (./text _ text) text
     > (./jet _ primitive) primitive.payload
    ""
  + check
    \ tree=goo/semantic
    ^ maybe[str]
    = text (goo_ascii/payload tree)
      valid=bool
        % i=nat 0
        ? (eq i text.len) .true
        = c text.at(i)
        ? !((eq c 9) || (eq c 10) || (eq c 13) || !((lt c 32) || (gt c 126))) .false
        | _ i.inc
    ? !valid (./some (str/cat_all ["ASCII measurement does not support non-ASCII text at node " tree.node_id.text]))
    % i=nat 0
    ^ maybe[str]
    ? (eq i tree.children.len) .none
    ? (goo_ascii/check tree.children.at(i))
     > (./some error) (./some error)
    | _ i.inc
  + text_style
    \ scale=goo/scalar tree=goo/semantic
    ^ goo_ascii/style
    = kind (goo_ascii/kind tree)
      role (goo_ascii/role tree)
    ? (eq kind "button") (goo_ascii/style (goo_fonts/face/sans550) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 4628011567076605952) (goo/scalar 4625759767262920704))
    ? (eq kind "input") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622945017495814144) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4622945017495814144)) scale) (goo/scalar 0) (goo/scalar 4626885667169763328) (goo/scalar 4626322717216342016))
    ? (eq kind "code") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4610109758557808230) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 4628011567076605952) (goo/scalar 4628011567076605952))
    ? (eq kind "avatar") (goo_ascii/style (goo_fonts/face/sans520) (goo_fp/times (goo/scalar 4625759767262920704) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4625759767262920704)) scale) (goo/scalar 13826050856027422720) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "title") (goo_ascii/style (goo_fonts/face/sans620) (goo_fp/times (goo/scalar 4626885667169763328) scale) (goo_fp/times (goo_fp/times (goo/scalar 4607993066732944097) (goo/scalar 4626885667169763328)) scale) (goo/scalar 13827401935915633869) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "subtitle") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4623507967449235456) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4623507967449235456)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "label") (goo_ascii/style (goo_fonts/face/sans650) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609209038632334131) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "body") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4623507967449235456) scale) (goo_fp/times (goo_fp/times (goo/scalar 4610109758557808230) (goo/scalar 4623507967449235456)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "summary") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4623507967449235456) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4623507967449235456)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "hint") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609659398595071181) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "caption") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "credit") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609659398595071181) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "provenance") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609659398595071181) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "value") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4625196817309499392) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4625196817309499392)) scale) (goo/scalar 13824249416176474522) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "unit") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "qualifier") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608983858650965606) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "metadata") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "author") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "timestamp") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "status") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "error") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "diagnostic") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "output") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4622382067542392832) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4622382067542392832)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "quote") (goo_ascii/style (goo_fonts/face/italic400) (goo_fp/times (goo/scalar 4625478292286210048) scale) (goo_fp/times (goo_fp/times (goo/scalar 4608758678669597082) (goo/scalar 4625478292286210048)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "attribution") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609344146621155246) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "icon") (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4626885667169763328) scale) (goo_fp/times (goo_fp/times (goo/scalar 4607182418800017408) (goo/scalar 4626885667169763328)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
    ? (eq role "badge") (goo_ascii/style (goo_fonts/face/mono400) (goo_fp/times (goo/scalar 4621819117588971520) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609434218613702656) (goo/scalar 4621819117588971520)) scale) (goo/scalar 0) (goo/scalar 4624070917402656768) (goo/scalar 4620693217682128896))
    (goo_ascii/style (goo_fonts/face/sans400) (goo_fp/times (goo/scalar 4624070917402656768) scale) (goo_fp/times (goo_fp/times (goo/scalar 4609344146621155246) (goo/scalar 4624070917402656768)) scale) (goo/scalar 0) (goo/scalar 0) (goo/scalar 0))
  + normalized
    \ text=str
    ^ str
    % i=nat 0 out=str ""
    ? (ge i text.len) out
    = c text.at(i)
    ? (eq c 13) (_ (add i (? (eq text.at(i.inc) 10) 2 1)) out.snoc_byte(10))
    ? (eq c 9) (_ i.inc out.cat("    "))
    | _ i.inc out.snoc_byte(c)
  + content
    \ tree=goo/semantic
    ^ str
    = text (goo_ascii/normalized (goo_ascii/payload tree))
    ? !(!(eq (goo_ascii/kind tree) "text") || !(eq (goo_ascii/role tree) "error")) (str/cat_all ["! " text])
    text
  + prefix
    \ scale=goo/scalar tree=goo/semantic
    ^ goo/scalar
    ? !(!(eq (goo_ascii/kind tree) "text") || !(eq (goo_ascii/role tree) "status")) (goo_fp/plus (goo_fp/times (goo/scalar 4620693217682128896) scale) (goo/scalar 4617315517961601024))
    (goo/scalar 0)
  + glyph
    \ style=goo_ascii/style c=nat
    ^ goo/scalar
    | goo_fp/plus (goo_fp/times (goo_fonts/advance style.face c) style.pixels) style.tracking
  + width_of
    \ style=goo_ascii/style text=str
    ^ goo/scalar
    % i=nat 0 total=goo/scalar (goo/scalar 0)
    ? (eq i text.len) total
    | _ i.inc (goo_fp/plus total (goo_ascii/glyph style text.at(i)))
  + words
    ' Called only after ASCII validation and CR/tab normalization.
    \ text=str
    ^ str
    % i=nat 0 out=str "" pending=bool .false
    ? (eq i text.len) out
    = c text.at(i)
    ? ((eq c 32) || (eq c 10)) (_ i.inc out !(eq out.len 0))
    | _ i.inc (? pending out.snoc_byte(32).snoc_byte(c) out.snoc_byte(c)) .false
  + natural_width
    \ scale=goo/scalar tree=goo/semantic
    ^ goo/scalar
    = kind (goo_ascii/kind tree)
      style (goo_ascii/text_style scale tree)
      text (goo_ascii/content tree)
    ? (eq kind "input") (goo/scalar 4643809350144491520)
    ? (eq kind "avatar") (goo/scalar 4632796641680687104)
    ? (eq kind "presence") (goo/scalar 4621256167635550208)
    ? (eq kind "bar") (goo/scalar 4638144666238189568)
    ? (eq kind "media") (goo/scalar 4646448178051153920)
    ? (eq kind "button") (goo_fp/plus (goo_ascii/width_of style (goo_ascii/words text)) style.inset_x)
    = paragraphs (str/split_byte 10 text)
      widest=goo/scalar
        % i=nat 0 best=goo/scalar (goo/scalar 0)
        ? (eq i paragraphs.len) best
        = width (goo_fp/plus (goo_ascii/width_of style paragraphs.at(i)) (? (eq i 0) (goo_ascii/prefix scale tree) (goo/scalar 0)))
        | _ i.inc (goo_fp/maximum best width)
    | goo_fp/plus widest style.inset_x
  + leaf_size
    \ scale=goo/scalar tree=goo/semantic
    ^ goo_measure/size
    = kind (goo_ascii/kind tree)
      slot tree.attrs.common.slot.text
      cap=goo/scalar
        ? tree.attrs.common.config.max_ideal
         > (./some value) value
        ? (eq slot "body") (goo/scalar 4646448178051153920)
        ? (eq slot "summary") (goo/scalar 4644776920376934400)
        ? (eq slot "hint") (goo/scalar 4644161193865379840)
        ? (eq slot "caption") (goo/scalar 4644688959446712320)
        ? (eq slot "credit") (goo/scalar 4644425076656046080)
        ? (eq slot "provenance") (goo/scalar 4644337115725824000)
        ? (eq slot "title") (goo/scalar 4644600998516490240)
        ? (eq slot "code") (goo/scalar 4644776920376934400)
        (goo/scalar 4644513037586268160)
      pref (goo_fp/ceil (goo_fp/minimum cap (goo_ascii/natural_width scale tree)))
      fixed ((eq kind "button") || (eq kind "avatar") || (eq kind "presence") || (eq kind "bar") || (eq slot "icon"))
      floor=goo/scalar
        ? (eq slot "input") (goo/scalar 4639481672377565184)
        ? (eq slot "code") (goo/scalar 4639305750517121024)
        ? (eq slot "media") (goo/scalar 4639129828656676864)
        ? (eq slot "title") (goo/scalar 4637792822517301248)
        ? (eq slot "body") (goo/scalar 4639129828656676864)
        ? (eq slot "summary") (goo/scalar 4638777984935788544)
        ? (eq slot "hint") (goo/scalar 4637792822517301248)
        ? (eq slot "value") (goo/scalar 4635329916471083008)
        ? (eq slot "provenance") (goo/scalar 4637440978796412928)
        (goo/scalar 4634274385308418048)
    | goo_measure/size (? fixed pref (goo_fp/minimum pref floor)) pref !fixed
  + fit
    \ style=goo_ascii/style text=str room=goo/scalar
    ^ nat
    = limit (goo_fp/plus room (goo/scalar 4532020583610935537))
    % i=nat 0 total=goo/scalar (goo/scalar 0)
    ? (eq i text.len) i
    = next (goo_fp/plus total (goo_ascii/glyph style text.at(i)))
    ? !(goo_fp/lte next limit) i
    | _ i.inc next
  + wrap
    \ style=goo_ascii/style available=goo/scalar first_room=goo/scalar text=str
    ^ row[str]
    ? (eq text.len 0) [""]
    % remaining=str text room=goo/scalar first_room out=row[str] []
    = fits (goo_ascii/fit style remaining room)
    ? (ge fits remaining.len) out.snoc(remaining)
    = breakpoint=nat
        % i=nat 0 last=nat 0
        ? (eq i fits) last
        = c remaining.at(i)
        | _ i.inc (? ((eq c 32) || (eq c 45) || (eq c 47)) i.inc last)
      count (? (eq breakpoint 0) (? (eq fits 0) 1 fits) breakpoint)
      out out.snoc(remaining.slice(0 count))
    ? (ge count remaining.len) out
    | _ remaining.slice(count (sub remaining.len count)) available out
  + text_lines
    \ scale=goo/scalar tree=goo/semantic width=goo/scalar
    ^ maybe[row[str]]
    = kind (goo_ascii/kind tree)
    ? !((eq kind "text") || (eq kind "code")) .none
    = text (goo_ascii/content tree)
      prefix (goo_ascii/prefix scale tree)
      all (str/split_byte 10 text)
      paragraphs=row[str]
        ? (eq text.len 0) (? (goo_fp/lte prefix (goo/scalar 0)) [] [""])
        ? (eq text.at(text.len.dec) 10) all.take(all.len.dec)
        all
      style (goo_ascii/text_style scale tree)
      available (goo_fp/maximum (goo/scalar 0) (goo_fp/minus width style.inset_x))
      lines=row[str]
        % i=nat 0 out=row[str] []
        ? (eq i paragraphs.len) out
        = room (? (eq i 0) (goo_fp/minus available prefix) available)
        | _ i.inc out.weld((goo_ascii/wrap style available room paragraphs.at(i)))
    | ./some lines
  + leaf_height
    \ scale=goo/scalar tree=goo/semantic width=goo/scalar
    ^ goo/scalar
    = kind (goo_ascii/kind tree)
    ? (eq kind "avatar") (goo/scalar 4632796641680687104)
    ? (eq kind "presence") (goo/scalar 4621256167635550208)
    ? (eq kind "bar") (goo/scalar 4618441417868443648)
    ? (eq kind "media") (goo_fp/maximum (goo/scalar 4634204016564240384) (goo_fp/quotient width (goo/scalar 4613262278296967578)))
    = style (goo_ascii/text_style scale tree)
      count=nat
        ? (goo_ascii/text_lines scale tree width)
         > (./some lines) lines.len
        1
    | goo_fp/plus style.inset_y (goo_fp/times (goo_fp/integer count) style.leading)
