- goo_app/profile
- goo_app/run_style
- goo_app/measurement

+ goo_ascii
  + block_role
    \ role=str
    ^ bool
    | row/has[str] role ["rich-block" "rich-heading" "rich-code"]
  + rich_role
    \ role=str
    ^ bool
    | ((eq role "rich-input") || (goo_ascii/block_role role))
  + style
    goo_profile/style
  + kind
    \ tree=goo/semantic
    ^ str
    ? tree
     > (./text _ _) "text"
     > (./image _ _)
      = slot tree.attrs.common.slot.text
      ? ((eq slot "icon") || (eq slot "avatar")) "avatar" "media"
     > (./jet _ primitive) primitive.kind.name
    "group"
  + role
    \ tree=goo/semantic
    ^ str
    | (str/split_byte 47 tree.attrs.common.slot.text).at(0)
  + runs
    \ tree=goo/semantic
    ^ goo/text
    ? tree
     > (./text _ text) text
     > (./jet _ primitive) primitive.payload
    []
  + content_runs
    \ tree=goo/semantic
    ^ goo/text
    = runs (goo_text/normalized goo_profile/tab_text (goo_ascii/runs tree))
    ? !(!(eq (goo_ascii/kind tree) "text") || !(eq (goo_ascii/role tree) "error")) (goo/text/en goo_profile/error_prefix).weld(runs)
    runs
  + payload
    \ tree=goo/semantic
    ^ str
    ? tree
     > (./text _ text) text.plain
     > (./jet _ primitive) primitive.payload.plain
    ""
  + check
    \ tree=goo/semantic
    ^ maybe[str]
    ? !(goo/text/supported (goo_ascii/runs tree)) (./some (str/cat_all ["Unsupported RunDescriptor properties at node " tree.node_id.text]))
    ? (and (and (eq (goo_ascii/kind tree) "input") !(goo_ascii/rich_role (goo_ascii/role tree))) (row/any[goo/runt] (\ run !(eq run.myth.size 0)) (goo_ascii/runs tree))) (./some "Styled native editing is not supported")
    = base (goo_profile/text_style (goo_fp/integer 1) (goo_ascii/kind tree) (goo_ascii/role tree))
    ? !(row/all[goo/runt] (\ run (goo_run/resolve base run.myth).is_some) (goo_ascii/runs tree)) (./some "Unsupported run font path or font/modifier combination")
    = text (goo_ascii/payload tree)
      valid=bool
        % i=nat 0
        ? (eq i text.len) .true
        = c text.at(i)
        ? !((eq c 9) || (eq c 10) || (eq c 13) || !((lt c 32) || (gt c 126))) .false
        | _ i.inc
    ? !valid (./some (str/cat_all ["ASCII measurement does not support non-ASCII text at node " tree.node_id.text]))
    % i=nat 0
    ^ maybe[str]
    ? (eq i tree.children.len) .none
    ? (goo_ascii/check tree.children.at(i))
     > (./some error) (./some error)
    | _ i.inc
  + text_style
    \ scale=goo/scalar tree=goo/semantic
    ^ goo_ascii/style
    = role (goo_ascii/role tree)
      style (goo_profile/text_style scale (? (eq role "rich-heading") "text" (? (eq role "rich-code") "code" (goo_ascii/kind tree))) (? (eq role "rich-heading") "title" role))
      extents (goo_ascii/extents style tree)
      base_height (goo_fp/quotient (goo_fp/integer (add (goo_profile/font_ascent style.face) (goo_profile/font_descent style.face))) (goo_fp/integer (goo_profile/font_units style.face)))
      extra (goo_fp/maximum (goo/scalar 0) (goo_fp/minus (goo_fp/plus extents.ascent extents.descent) base_height))
    | style.set_leading((goo_fp/plus style.leading (goo_fp/times style.pixels extra)))
  + extent
    : ascent=goo/scalar descent=goo/scalar
  + extents
    \ base=goo_profile/style tree=goo/semantic
    ^ goo_ascii/extent
    = start (goo_ascii/extent (goo_fp/quotient (goo_fp/integer (goo_profile/font_ascent base.face)) (goo_fp/integer (goo_profile/font_units base.face))) (goo_fp/quotient (goo_fp/integer (goo_profile/font_descent base.face)) (goo_fp/integer (goo_profile/font_units base.face))))
    | (goo_ascii/runs tree).fold start
      \ acc run
      = font (goo_run/font base run.myth)
      | goo_ascii/extent (goo_fp/maximum acc.ascent (goo_fp/quotient (goo_fp/integer font.ascent) (goo_fp/integer font.info.units))) (goo_fp/maximum acc.descent (goo_fp/quotient (goo_fp/integer font.descent) (goo_fp/integer font.info.units)))
  + baseline_offset
    \ style=goo_profile/style tree=goo/semantic
    ^ goo/scalar
    = e (goo_ascii/extents style tree)
    | goo_fp/plus (goo_fp/quotient style.leading (goo_fp/integer 2)) (goo_fp/quotient (goo_fp/times style.pixels (goo_fp/minus e.ascent e.descent)) (goo_fp/integer 2))
  + normalized
    \ text=str
    ^ str
    % i=nat 0 out=str ""
    ? (ge i text.len) out
    = c text.at(i)
    ? (eq c 13) (_ (add i (? (eq text.at(i.inc) 10) 2 1)) out.snoc_byte(10))
    ? (eq c 9) (_ i.inc out.cat(goo_profile/tab_text))
    | _ i.inc out.snoc_byte(c)
  + content
    \ tree=goo/semantic
    ^ str
    = text (goo_ascii/normalized (goo_ascii/payload tree))
    ? !(!(eq (goo_ascii/kind tree) "text") || !(eq (goo_ascii/role tree) "error")) (str/cat_all [goo_profile/error_prefix text])
    text
  + prefix
    \ scale=goo/scalar tree=goo/semantic
    ^ goo/scalar
    ? !(!(eq (goo_ascii/kind tree) "text") || !(eq (goo_ascii/role tree) "status")) (goo_fp/plus (goo_fp/times goo_profile/status_marker scale) goo_profile/status_gap)
    (goo/scalar 0)
  + glyph
    \ style=goo_ascii/style c=nat
    ^ goo/scalar
    | goo_fp/plus (goo_fp/times (goo_fonts/advance style.face c) style.pixels) style.tracking
  + width_of
    \ style=goo_ascii/style text=str
    ^ goo/scalar
    % i=nat 0 total=goo/scalar (goo/scalar 0)
    ? (eq i text.len) total
    | _ i.inc (goo_fp/plus total (goo_ascii/glyph style text.at(i)))
  + words
    ' Called only after ASCII validation and CR/tab normalization.
    \ text=str
    ^ str
    % i=nat 0 out=str "" pending=bool .false
    ? (eq i text.len) out
    = c text.at(i)
    ? ((eq c 32) || (eq c 10)) (_ i.inc out !(eq out.len 0))
    | _ i.inc (? pending out.snoc_byte(32).snoc_byte(c) out.snoc_byte(c)) .false
  + natural_width
    \ scale=goo/scalar tree=goo/semantic
    ^ goo/scalar
    = kind (goo_ascii/kind tree)
      style (goo_ascii/text_style scale tree)
      runs (goo_ascii/content_runs tree)
      text runs.plain
    ? (and (eq kind "input") (goo_ascii/rich_role (goo_ascii/role tree))) (goo_fp/times scale (goo_fp/integer (? (goo_ascii/block_role (goo_ascii/role tree)) 720 576)))
    ? (goo_profile/natural_width kind)
     > (./some width) width
    ? (eq kind "button") (goo_fp/plus (goo_run/width style (goo_text/words runs)) style.inset_x)
    = paragraphs (str/split_byte 10 text).stream
      widest=goo/scalar
        % i=nat 0 offset=nat 0 best=goo/scalar (goo/scalar 0)
        ? (eq i paragraphs.len) best
        = width (goo_fp/plus (goo_run/width style (goo/text/slice offset paragraphs.at(i).len runs)) (? (eq i 0) (goo_ascii/prefix scale tree) (goo/scalar 0)))
        | _ i.inc (add offset paragraphs.at(i).len.inc) (goo_fp/maximum best width)
    | goo_fp/plus widest style.inset_x
  + leaf_size
    \ scale=goo/scalar tree=goo/semantic
    ^ goo_measure/size
    = kind (goo_ascii/kind tree)
      slot tree.attrs.common.slot.text
      cap=goo/scalar
        ? tree.attrs.common.config.max_ideal
         > (./some value) value
        ? (and (eq kind "input") (goo_ascii/rich_role (goo_ascii/role tree))) (goo_fp/times scale (goo_fp/integer (? (goo_ascii/block_role (goo_ascii/role tree)) 720 576)))
        (goo_profile/preferred_cap slot)
      pref (goo_fp/ceil (goo_fp/minimum cap (goo_ascii/natural_width scale tree)))
      fixed (goo_profile/fixed kind slot)
      floor (goo_profile/minimum_width slot)
    | goo_measure/size (? fixed pref (goo_fp/minimum pref floor)) pref !fixed
  + fit
    \ style=goo_ascii/style text=str room=goo/scalar
    ^ nat
    = limit (goo_fp/plus room goo_profile/fit_tolerance)
    % i=nat 0 total=goo/scalar (goo/scalar 0)
    ? (eq i text.len) i
    = next (goo_fp/plus total (goo_ascii/glyph style text.at(i)))
    ? !(goo_fp/lte next limit) i
    | _ i.inc next
  + wrap
    \ style=goo_ascii/style available=goo/scalar first_room=goo/scalar text=str
    ^ list[str]
    ? (eq text.len 0) (list/one[str] "")
    % remaining=str text room=goo/scalar first_room out=list[str] .nil
    = fits (goo_ascii/fit style remaining room)
    ? (ge fits remaining.len) out.cons(remaining).reverse
    = breakpoint=nat
        % i=nat 0 last=nat 0
        ? (eq i fits) last
        = c remaining.at(i)
        | _ i.inc (? ((eq c 32) || (eq c 45) || (eq c 47)) i.inc last)
      count (? (eq breakpoint 0) (? (eq fits 0) 1 fits) breakpoint)
      out out.cons(remaining.slice(0 count))
    ? (ge count remaining.len) out.reverse
    | _ remaining.slice(count (sub remaining.len count)) available out
  + wrap_runs
    \ style=goo_ascii/style available=goo/scalar first_room=goo/scalar runs=goo/text
    ^ list[goo/text]
    = text runs.plain advances (goo_run/advances style runs)
    ? (eq text.len 0) (list/one[goo/text] [])
    % offset=nat 0 room=goo/scalar first_room out=list[goo/text] .nil
    = fits=nat
        % i=nat offset total=goo/scalar (goo/scalar 0)
        ? (eq i text.len) i
        = next (goo_fp/plus total advances.at(i))
        ? !(goo_fp/lte next (goo_fp/plus room goo_profile/fit_tolerance)) i
        | _ i.inc next
    ? (eq fits text.len) out.cons((goo/text/slice offset (sub fits offset) runs)).reverse
    = breakpoint=nat
        % i=nat offset last=nat offset
        ? (eq i fits) last
        = c text.at(i)
        | _ i.inc (? ((eq c 32) || (eq c 45) || (eq c 47)) i.inc last)
      end (? (eq breakpoint offset) (? (eq fits offset) offset.inc fits) breakpoint)
      out out.cons((goo/text/slice offset (sub end offset) runs))
    ? (eq end text.len) out.reverse
    | _ end available out
  + text_lines
    \ scale=goo/scalar tree=goo/semantic width=goo/scalar
    ^ maybe[list[goo/text]]
    = kind (goo_ascii/kind tree)
    ? !((eq kind "text") || (eq kind "code")) .none
    = runs (goo_ascii/content_runs tree)
      text runs.plain
      prefix (goo_ascii/prefix scale tree)
      all (str/split_byte 10 text).stream
      paragraphs=list[str]
        ? (eq text.len 0) (? (goo_fp/lte prefix (goo/scalar 0)) .nil (list/one[str] ""))
        ? (eq text.at(text.len.dec) 10) all.take(all.len.dec)
        all
      style (goo_ascii/text_style scale tree)
      available (goo_fp/maximum (goo/scalar 0) (goo_fp/minus width style.inset_x))
      lines=list[goo/text]
        % rest=list[str] paragraphs room=goo/scalar (goo_fp/minus available prefix) offset=nat 0
        ^ list[goo/text]
        ? rest.is_nil .nil
        = fragments (goo_ascii/wrap_runs style available room (goo/text/slice offset rest.head.len runs))
        | fragments.weld((_ rest.tail available (add offset rest.head.len.inc)))
    | ./some lines
  + leaf_height
    \ scale=goo/scalar tree=goo/semantic width=goo/scalar
    ^ goo/scalar
    = kind (goo_ascii/kind tree)
    ? (and (eq kind "input") (eq (goo_ascii/role tree) "rich-input")) (goo_fp/times scale (goo_fp/integer 520))
    ? (and (eq kind "input") (goo_ascii/block_role (goo_ascii/role tree)))
      = style (goo_ascii/text_style scale tree)
      | goo_fp/plus style.inset_y (goo_fp/times (goo_fp/integer 2) style.leading)
    ? (goo_profile/fixed_height kind)
     > (./some height) height
    ? (eq kind "media")
      = ratio=maybe[goo/scalar]
          ? tree
           > (goo/semantic/image attrs _) attrs.common.config.aspect_ratio
          .none
      ? ratio
       > (./some ratio) (goo_fp/quotient width ratio)
      | goo_fp/maximum goo_profile/media_minimum (goo_fp/quotient width goo_profile/media_aspect_ratio)
    = style (goo_ascii/text_style scale tree)
      count=nat
        ? (goo_ascii/text_lines scale tree width)
         > (./some lines) lines.len
        1
    | goo_fp/plus style.inset_y (goo_fp/times (goo_fp/integer count) style.leading)
