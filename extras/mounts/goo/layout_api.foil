- goo_app/layout
- goo_app/ascii_api

+ goo_layout_api
  + recorded_size
    \ measurements=json node=goo/semantic
    ^ maybe[goo_measure/size]
    > (json/obj fields) measurements .none
    < sizes (goo_codec/field fields "sizes")
    > (json/obj entries) sizes .none
    < size (goo_codec/field entries node.node_id.text)
    | goo_measure/decode_size size
  + recorded_height
    \ measurements=json node=goo/semantic width=goo/scalar
    ^ maybe[goo/scalar]
    > (json/obj fields) measurements .none
    < constant (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "constantHeight"))
    ? constant
     > (./some height) (./some height)
    < heights (goo_codec/field fields "heights")
    > (json/obj entries) heights .none
    < heights (goo_codec/field entries node.node_id.text)
    ? (goo_number/nonnegative heights)
     > (./some height) (./some height)
    > (json/obj entries) heights .none
    % i=nat 0
    ^ maybe[goo/scalar]
    ? (eq i entries.len) .none
    = item entries.at(i)
    < key (goo_number/nonnegative (json/real item.k))
    ? (eq key.bits width.bits) (goo_number/nonnegative item.v)
    | _ i.inc
  + evaluate
    \ request=json
    ^ maybe[json]
    > (json/obj fields) request .none
    < v (goo_codec/field fields "version")
    < version (goo_number/integer v)
    ? !(eq version 1) .none
    < action_json (goo_codec/field fields "action")
    < action (goo_codec/text action_json)
    < tree_json (goo_codec/field fields "tree")
    < tree (goo_codec/optional[goo/semantic] goo_codec/decode_semantic (./some tree_json))
    < width_json (goo_codec/field fields "width")
    < width (goo_number/nonnegative width_json)
    ? !(goo_fp/lte width (goo_fp/integer 100000)) .none
    < scale (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "textScale"))
    = scale=goo/scalar
        ? scale
         > ./none (goo_fp/integer 1)
         > (./some value) value
    ? ((goo_fp/lte scale (goo/scalar 0)) || !(goo_fp/lte scale (goo_fp/integer 10))) .none
    ? (eq action "layout")
      = invalid=maybe[str]
          ? tree
           > ./none .none
           > (./some node) (goo_ascii/check node)
      ? invalid
       > (./some message) (./some (goo_ascii_api/failure "ascii" message))
      < result (goo_layout/plan_with (\ n (./some (goo_ascii/leaf_size scale n))) (\ n w (./some (goo_ascii/leaf_height scale n w))) tree width)
      < encoded (goo_measure/encode result)
      = lines=row[jkv]
          ? tree
           > ./none []
           > (./some root)
            ? result.value.plan
             > ./none []
             > (./some plan)
              = nodes (goo_measure/nodes root)
                plans (goo_measure/plans plan)
              % i=nat 0 out=row[jkv] []
              ^ row[jkv]
              ? (eq i nodes.len) out
              ? (goo_ascii/text_lines scale nodes.at(i) plans.at(i).width)
               > ./none (_ i.inc out)
               > (./some lines) (_ i.inc out.snoc((jkv nodes.at(i).node_id.text (json/arr lines.map((\ s=str (json/str s)))))))
      | ./some (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "measurement" encoded) (jkv "textLines" (json/obj lines))])
    ? !(eq action "plan") .none
    < measurements (goo_codec/field fields "measurements")
    < result (goo_layout/plan_with (goo_layout_api/recorded_size measurements) (goo_layout_api/recorded_height measurements) tree width)
    < encoded (goo_measure/encode result)
    | ./some (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "measurement" encoded)])
  + run
    \ source=str
    ^ str
    = response=maybe[json]
        > (./ok value _) (parse source) .none
        | goo_layout_api/evaluate value
    ? response
     > ./none (show (goo_ascii_api/failure "layout" "invalid layout request or measurements"))
     > (./some value) (show value)
