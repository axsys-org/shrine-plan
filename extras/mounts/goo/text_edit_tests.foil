- goo_app/text_edit
- goo_app/wire_adapter
- testing

+ goo_text_edit_tests
  + run
    \ value=goo/text start=nat end=nat command=str
    ^ goo_text_edit/result
    ?> (./ok next) (goo_text_edit/apply value start end command myth/new)
      | Seq[goo_text_edit/result] (error (pails/t "Text command failed")) (goo_text_edit/result [] 0 0 myth/new)
    next
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = linked (myth/sing ['sys 'link] (pails/p ['source]))
      input=goo/text [(goo/runt linked (goo/lang/en "hello")) (goo/runt myth/new (goo/lang/en " world"))]
      bold (goo_text_edit_tests/run input 2 8 "bold")
      clear (goo_text_edit_tests/run bold.value 0 11 "clear")
      caret (goo_text_edit_tests/run input 3 3 "italic")
      heading (goo_text_edit_tests/run (goo/text/en "/hea") 4 4 "heading")
      bullet (goo_text_edit_tests/run (goo/text/en "/") 1 1 "bullet")
      repeated_bullet (goo_text_edit_tests/run (goo/text/en "- one") 5 5 "bullet")
      unlisted (goo_text_edit_tests/run (goo/text/en "- one") 5 5 "paragraph")
      continued (goo_text_edit_tests/run (goo/text/en "- one") 5 5 "paragraph-break")
      ended (goo_text_edit_tests/run (goo/text/en "- ") 2 2 "paragraph-break")
      split (goo_text_edit_tests/run (goo/text/en "- one") 2 2 "paragraph-break")
      invalid (goo_text_edit/apply input 9 3 "bold" myth/new)
      unknown (goo_text_edit/apply input 0 1 "execute" myth/new)
      encoded (goo_text_edit/encode bold)
    [(testing/text "format preserves logical text" "hello world" bold.value.plain)
     (testing/nat "cross-run formatting preserves the linked prefix" 1 (equal bold.value.at(0).myth linked))
     (testing/nat "selected linked text acquires bold" 1 (goo_text/modifier (modifiers/bold) bold.value.at(1).myth))
     (testing/nat "clear retains structured links" 1 (equal clear.value.at(0).myth linked))
     (testing/nat "format preserves selection" 8 bold.end)
     (testing/nat "collapsed toggle changes typing style" 1 (goo_text/modifier (modifiers/italic) caret.typing))
     (testing/text "slash query is consumed in Foil" "" heading.value.plain)
     (testing/nat "heading supplies native typing metadata" 1 (equal heading.typing (myth/sing ['sys 'font] (pails/p ['sys 'font 'sans750]))))
     (testing/text "bullet command supplies prefix" "- " bullet.value.plain)
     (testing/text "bullet command does not duplicate prefix" "- one" repeated_bullet.value.plain)
     (testing/text "paragraph command removes bullet prefix" "one" unlisted.value.plain)
     (testing/nat "bullet caret follows prefix" 2 bullet.start)
     (testing/text "Enter continues a bullet" (str/cat_all ["- one" (str/from_atom 10) "- "]) continued.value.plain)
     (testing/text "Enter ends an empty bullet" "" ended.value.plain)
     (testing/text "Enter before bullet text retains the following item" (str/cat_all ["- " (str/from_atom 10) "- one"]) split.value.plain)
     (testing/nat "reversed selection is refused" 1 (either/is_err invalid))
     (testing/nat "unknown command is refused" 1 (either/is_err unknown))
     (testing/nat "text edit has a named protobuf representation" 1 (maybe/is_some (goo_wire/text_edit_from_json encoded)))
    ]

+ tests
  ^ row[testing/case]
  [(testing/case "Native Goo text commands" goo_text_edit_tests/checks)]
