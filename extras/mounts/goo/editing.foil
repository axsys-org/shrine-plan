- goo_app/ascii

+ goo_edit
  + rich
    \ tree=goo/semantic
    ^ bool
    | and (eq (goo_ascii/kind tree) "input") (goo_ascii/rich_role (goo_ascii/role tree))
  + fonts
    ^ row[str]
    ["" "sans" "mono" "sans400" "sans520" "sans550" "sans620" "sans650" "sans750" "mono400" "italic400" "italic520" "italic550" "italic620" "italic650" "italic750" "mono700"]
  + metadata
    \ name=str mask=nat
    ^ myth
    = flags=list[modifiers]
        | (row/stream[modifiers] [])
      flags (? (eq (mod mask 2) 1) flags.snoc((modifiers/bold)) flags)
      flags (? (eq (mod (div mask 2) 2) 1) flags.snoc((modifiers/italic)) flags)
      flags (? (eq (mod (div mask 4) 2) 1) flags.snoc((modifiers/underline)) flags)
      base (? (eq name "") myth/new (myth/sing ['sys 'font] (pails/p (path_parse (str/cat_all ["/sys/font/" name])).fall([]))))
    ? flags.is_nil base
    | base.put ['sys 'modifiers] (pails/modifiers flags)
  + contract
    \ base=goo_profile/style foreground=str
    ^ json
    = fonts goo_edit/fonts
      options=row[json]
        | fonts.bind
          \ name=str
          | (list/range 0 8).fold []
            \ out=row[json] mask=nat
            = metadata (goo_edit/metadata name mask)
            ? (maybe/is_none (goo_run/resolve base metadata)) out
            | out.snoc (json/obj [(jkv "myth" (goo_text/encode_myth metadata)) (jkv "resolved" (goo_run/recipe base metadata foreground (goo/scalar 0)))])
      link (goo_run/recipe base (myth/sing ['sys 'link] (pails/p [])) foreground (goo/scalar 0))
    | json/obj [(jkv "version" (json/num .false 1)) (jkv "encoding" (json/str "goo-text-v1")) (jkv "maxBytes" (json/num .false 65536)) (jkv "styles" (json/arr options)) (jkv "linkStyle" link)]
  + decode
    ' Used by a declared action argument codec. Never infer a decoder from submitted metadata.
    \ value=pail
    ^ maybe[goo/text/pail]
    = runs=maybe[goo/text]
        ? value
         > stored=goo/text/pail (./some stored.value)
         > wire=pails/t
          ? (gt wire.t.len 65536) .none
          ?> (jres/ok json rest) (parse wire.t) .none
          ? !(eq rest "") .none
          | goo_text/decode json
        .none
    < runs runs
    ? (gt runs.len 10000) .none
    ? !(goo/text/supported runs) .none
    = base (goo_profile/text_style (goo_fp/integer 1) "input" "rich-input")
    ? !(runs.all((\ run (goo_run/resolve base run.myth).is_some))) .none
    = text runs.plain
    % i=nat 0
    ^ maybe[goo/text/pail]
    ? (eq i text.len) (./some (goo/text/pail runs))
    = byte text.at(i)
    ? !((eq byte 9) || (eq byte 10) || (eq byte 13) || !((lt byte 32) || (gt byte 126))) .none
    | _ i.inc
