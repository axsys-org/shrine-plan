- goo_app/layout
- testing

+ goo_layout_tests
  + leaf
    \ ignored=unit
    ^ goo/semantic
    | goo/semantic/text (goo/semantic_attrs (goo/common (goo/slot "title") (goo/rank/required) goo/config/empty .none) (goo/node_id "a") .none) "x"
  + fail_height
    \ node=goo/semantic width=goo/scalar
    ^ maybe[goo/scalar]
    | Seq[maybe[goo/scalar]] (error (goo_fp/fault "cache miss")) .none
  + cached
    \ raw=goo/scalar
    ^ maybe[goo_layout/planned]
    = node (goo_layout_tests/leaf unit/unit)
      context (goo_layout/context .nil (\ n=goo/semantic w=goo/scalar (maybe/some[goo/scalar] (goo_fp/integer 20))))
    < first (goo_layout/node context node (goo/scalar 4626357901588430848) .nil)
    | goo_layout/node (goo_layout/context .nil goo_layout_tests/fail_height) node raw first.cache
  + rejected
    \ min=goo/scalar pref=goo/scalar height=goo/scalar
    ^ bool
    | maybe/is_some (goo_layout/plan_with (\ n=goo/semantic (maybe/some[goo_measure/size] (goo_measure/size min pref .false))) (\ n=goo/semantic w=goo/scalar (maybe/some[goo/scalar] height)) (./some (goo_layout_tests/leaf unit/unit)) (goo_fp/integer 20))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = hit (Try goo_layout_tests/cached (goo/scalar 4626359027488337691))
      miss (Try goo_layout_tests/cached (goo/scalar 4626362123713081508))
      succeeded=bool
        ? hit
         > (./ok result) (maybe/is_some result)
        .false
      failed=bool
        ? miss
         > (./err _) .true
        .false
    [
     (testing/nat "quantize rounds half up" 4626359308963314401 (goo_layout/quantize (goo/scalar 4626357901588430848)).bits)
     (testing/nat "quantize clamps zero" 4607182418800017408 (goo_layout/quantize (goo/scalar 0)).bits)
     (testing/nat "quantized cache hit skips throwing callback" 1 succeeded)
     (testing/nat "different quantized width calls callback" 1 failed)
     (testing/nat "invalid minimum rejected before planning" 0 (goo_layout_tests/rejected (goo_fp/integer 30) (goo_fp/integer 20) (goo_fp/integer 10)))
     (testing/nat "nonfinite size rejected" 0 (goo_layout_tests/rejected (goo/scalar 0) (goo/scalar 9218868437227405312) (goo_fp/integer 10)))
     (testing/nat "negative height rejected" 0 (goo_layout_tests/rejected (goo/scalar 0) (goo_fp/integer 20) (goo_fp/negate (goo_fp/integer 10))))
     (testing/nat "nonfinite height rejected" 0 (goo_layout_tests/rejected (goo/scalar 0) (goo_fp/integer 20) (goo/scalar 9218868437227405312)))
    ]
