- goo_app/ascii
- testing

+ goo_ascii_tests
  + image_height
    \ width=nat ratio=maybe[goo/scalar] slot=str scale=nat
    ^ goo/scalar
    = config (goo/config/empty).set_aspect_ratio(ratio)
      attrs (goo/semantic_attrs (goo/common (goo/slot slot) (goo/rank/required) config .none) (goo/node_id "photo") .none)
    | goo_ascii/leaf_height (goo_fp/integer scale) (goo/semantic/image attrs "/photo.jpg") (goo_fp/integer width)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    [
     (testing/nat "square image uses source proportions" (goo_fp/integer 240).bits (goo_ascii_tests/image_height 240 (./some (goo_fp/integer 1)) "media" 1).bits)
     (testing/nat "landscape image uses source proportions" (goo_fp/integer 120).bits (goo_ascii_tests/image_height 240 (./some (goo_fp/integer 2)) "media" 1).bits)
     (testing/nat "portrait image uses source proportions" (goo_fp/integer 480).bits (goo_ascii_tests/image_height 240 (./some (goo/scalar 4602678819172646912)) "media" 1).bits)
     (testing/nat "small images keep ratio below profile minimum height" (goo_fp/integer 30).bits (goo_ascii_tests/image_height 120 (./some (goo_fp/integer 4)) "media" 1).bits)
     (testing/nat "text scale does not distort images" (goo_fp/integer 240).bits (goo_ascii_tests/image_height 240 (./some (goo_fp/integer 1)) "media" 2).bits)
     (testing/nat "unspecified image ratio preserves profile sizing" (goo_fp/maximum goo_profile/media_minimum (goo_fp/quotient (goo_fp/integer 240) goo_profile/media_aspect_ratio)).bits (goo_ascii_tests/image_height 240 .none "media" 1).bits)
     (testing/nat "avatar sizing remains fixed" (goo_ascii_tests/image_height 240 .none "avatar" 1).bits (goo_ascii_tests/image_height 240 (./some (goo_fp/integer 2)) "avatar" 1).bits)
     (testing/text "renderer profile identity" "mash-goo" goo_profile/id)
     (testing/text "control style precedes semantic role" "sans550" (goo_profile/font_id (goo_profile/text_style (goo/scalar 4607182418800017408) "button" "title").face))
     (testing/nat "profile leading preserves ratio then scale arithmetic" 4629763748806629785 (goo_profile/text_style (goo/scalar 4608308318706860032) "text" "title").leading.bits)
     (testing/nat "control inset is independent of text scale" 4628011567076605952 (goo_profile/text_style (goo/scalar 4608308318706860032) "button" "").inset_x.bits)
     (testing/text "italic face has portable font identity" "italic" (goo_profile/font_style (goo_profile/text_style (goo/scalar 4607182418800017408) "text" "quote").face))
     (testing/nat "binary64 nearest-even down" 4607182418800017408 (goo_fp/plus (goo/scalar 4607182418800017408) (goo/scalar 4368491638549381120)).bits)
     (testing/nat "binary64 nearest-even up" 4607182418800017410 (goo_fp/plus (goo/scalar 4607182418800017409) (goo/scalar 4368491638549381120)).bits)
     (testing/nat "binary64 decimal sum" 4599075939470750516 (goo_fp/plus (goo/scalar 4591870180066957722) (goo/scalar 4596373779694328218)).bits)
     (testing/nat "binary64 negative subtraction" 13596367275031527424 (goo_fp/minus (goo/scalar 4607182418800017408) (goo/scalar 4607182418800017409)).bits)
     (testing/nat "binary64 negative zeros" 9223372036854775808 (goo_fp/plus (goo/scalar 9223372036854775808) (goo/scalar 9223372036854775808)).bits)
     (testing/nat "binary64 opposite zeros" 0 (goo_fp/plus (goo/scalar 0) (goo/scalar 9223372036854775808)).bits)
     (testing/nat "binary64 subnormal result" 2251799813685248 (goo_fp/times (goo/scalar 4503599627370496) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 underflow tie" 0 (goo_fp/times (goo/scalar 1) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 signed underflow" 9223372036854775808 (goo_fp/times (goo/scalar 9223372036854775809) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 media division" 4630406710628430886 (goo_fp/quotient (goo/scalar 4636733772917427405) (goo/scalar 4613262278296967578)).bits)
     (testing/nat "binary64 leading multiplication" 4628000308077537525 (goo_fp/times (goo/scalar 4607993066732944097) (goo/scalar 4626885667169763328)).bits)
     (testing/nat "binary64 unscaled tracking" 13827347892720105423 (goo_fp/plus (goo/scalar 4573567551181324026) (goo/scalar 13827401935915633869)).bits)
     (testing/nat "binary64 negative first-line room" 13846880004304011264 (goo_fp/minus (goo/scalar 0) (goo/scalar 4623507967449235456)).bits)
     (testing/text "CRLF and tab normalization" (str/cat_all ["a" "".snoc_byte(10) "b    c" "".snoc_byte(10)]) (goo_ascii/normalized (str/cat_all ["a" "".snoc_byte(13).snoc_byte(10) "b" "".snoc_byte(9) "c" "".snoc_byte(13)])))
     (testing/text "button words collapse" "a b" (goo_ascii/words (str/cat_all ["  a " "".snoc_byte(10) " b  "])))
    ]
