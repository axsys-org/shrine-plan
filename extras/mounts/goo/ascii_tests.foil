- goo_app/ascii
- testing

+ goo_ascii_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    [
     (testing/nat "binary64 nearest-even down" 4607182418800017408 (goo_fp/plus (goo/scalar 4607182418800017408) (goo/scalar 4368491638549381120)).bits)
     (testing/nat "binary64 nearest-even up" 4607182418800017410 (goo_fp/plus (goo/scalar 4607182418800017409) (goo/scalar 4368491638549381120)).bits)
     (testing/nat "binary64 decimal sum" 4599075939470750516 (goo_fp/plus (goo/scalar 4591870180066957722) (goo/scalar 4596373779694328218)).bits)
     (testing/nat "binary64 negative subtraction" 13596367275031527424 (goo_fp/minus (goo/scalar 4607182418800017408) (goo/scalar 4607182418800017409)).bits)
     (testing/nat "binary64 negative zeros" 9223372036854775808 (goo_fp/plus (goo/scalar 9223372036854775808) (goo/scalar 9223372036854775808)).bits)
     (testing/nat "binary64 opposite zeros" 0 (goo_fp/plus (goo/scalar 0) (goo/scalar 9223372036854775808)).bits)
     (testing/nat "binary64 subnormal result" 2251799813685248 (goo_fp/times (goo/scalar 4503599627370496) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 underflow tie" 0 (goo_fp/times (goo/scalar 1) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 signed underflow" 9223372036854775808 (goo_fp/times (goo/scalar 9223372036854775809) (goo/scalar 4602678819172646912)).bits)
     (testing/nat "binary64 media division" 4630406710628430886 (goo_fp/quotient (goo/scalar 4636733772917427405) (goo/scalar 4613262278296967578)).bits)
     (testing/nat "binary64 leading multiplication" 4628000308077537525 (goo_fp/times (goo/scalar 4607993066732944097) (goo/scalar 4626885667169763328)).bits)
     (testing/nat "binary64 unscaled tracking" 13827347892720105423 (goo_fp/plus (goo/scalar 4573567551181324026) (goo/scalar 13827401935915633869)).bits)
     (testing/nat "binary64 negative first-line room" 13846880004304011264 (goo_fp/minus (goo/scalar 0) (goo/scalar 4623507967449235456)).bits)
     (testing/text "CRLF and tab normalization" (str/cat_all ["a" "".snoc_byte(10) "b    c" "".snoc_byte(10)]) (goo_ascii/normalized (str/cat_all ["a" "".snoc_byte(13).snoc_byte(10) "b" "".snoc_byte(9) "c" "".snoc_byte(13)])))
     (testing/text "button words collapse" "a b" (goo_ascii/words (str/cat_all ["  a " "".snoc_byte(10) " b  "])))
    ]
