- goo_app/html
- goo_app/backend

+ goo_html_api
  + evaluate
    \ value=json
    ^ maybe[json]
    > (json/obj fields) value .none
    < v (goo_codec/field fields "version")
    < version (goo_number/integer v)
    ? !(eq version 1) .none
    < options (goo_backend/options value)
    < tree_json (goo_codec/field fields "tree")
    < tree (goo_codec/optional[goo/semantic] goo_codec/decode_semantic (./some tree_json))
    < request (goo_compile/request value)
    ? (goo_html/prepare tree options.width options.scale options.rtl)
     > (./err message) (./some (goo_ascii_api/failure "prepared" message))
     > (./ok prepared)
      | ./some (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "prepared" (goo_html/inspect prepared)) (jkv "html" (json/str (goo_html/fragment prepared))) (jkv "document" (json/str (goo_html/document request.context.view_path prepared)))])
  + run
    \ source=str
    ^ str
    = result=maybe[json]
        > (./ok value _) (parse source) .none
        | goo_html_api/evaluate value
    ? result
     > ./none (show (goo_ascii_api/failure "protocol" "invalid render request"))
     > (./some value) (show value)
  + cli
    \ source=str
    ^ str
    = finite_error (show (goo_ascii_api/failure "render" "Error in $: expected finite nonnegative number"))
      bounds_error (show (goo_ascii_api/failure "render" "Error in $: textScale must be >0 and <=10; width must be <=100000"))
    > (./ok value _) (parse source) finite_error
    > (json/obj fields) value finite_error
    > (./some width) (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "width")) finite_error
    > (./some scale) (goo_codec/optional[goo/scalar] goo_number/nonnegative (goo_codec/field fields "textScale")) finite_error
    = width=goo/scalar
        ? width
         > (./some value) value
        (goo_fp/integer 752)
      scale=goo/scalar
        ? scale
         > (./some value) value
        (goo_fp/integer 1)
    ? (!(goo_fp/lte width (goo_fp/integer 100000)) || (goo_fp/lte scale (goo_fp/integer 0)) || !(goo_fp/lte scale (goo_fp/integer 10))) bounds_error
    | goo_html_api/run source
