- goo_app/codecs
- goo_app/inspection

+ goo_measure
  + axis
    & goo_measure/axis/x goo_measure/axis/y
    + x
      :
    + y
      :
  + size
    : min=goo/scalar pref=goo/scalar grow=bool
  + plan
    : id=goo/node_id width=goo/scalar height=goo/scalar cost=goo/scalar rows=maybe[list[goo_measure/plan_row]]
  + plan_row
    : start=nat end=nat children=list[goo_measure/plan] gap=goo/scalar height=goo/scalar gaps=maybe[list[goo/scalar]]
  + trace
    : edge=goo/edge x=goo/scalar y=goo/scalar stretch=goo/scalar penalty=goo/scalar preferred=goo/scalar gap=goo/scalar axis=goo_measure/axis cut=bool
  + named_size
    : id=goo/node_id size=goo_measure/size
  + raw
    : tree=maybe[goo/semantic] width=goo/scalar sizes=list[goo_measure/named_size] plan=maybe[goo_measure/plan] traces=list[goo_measure/trace]
  + result
    ' Trusted internal wrapper; external producers must pass make or decode_result.
    : value=goo_measure/raw
  + array
    (@@ v)
    \ decode={\ json}maybe[v] value=json
    ^ maybe[list[v]]
    > (json/arr values) value .none
    | values.stream.traverse_maybe(decode)
  + magnitude
    \ number=goo/scalar
    ^ nat
    | mod number.bits 9223372036854775808
  + same
    \ left=goo/scalar right=goo/scalar
    ^ bool
    | eq (goo_measure/magnitude left) (goo_measure/magnitude right)
  + axis_decode
    \ value=json
    ^ maybe[goo_measure/axis]
    < text (goo_codec/text value)
    ? (eq text "x") (./some (goo_measure/axis/x))
    ? (eq text "y") (./some (goo_measure/axis/y))
    .none
  + decode_size
    \ value=json
    ^ maybe[goo_measure/size]
    > (json/obj fields) value .none
    < min_json (goo_codec/field fields "min")
    < min (goo_number/nonnegative min_json)
    < pref_json (goo_codec/field fields "pref")
    < pref (goo_number/nonnegative pref_json)
    < grow_json (goo_codec/field fields "grow")
    < grow (goo_codec/grow grow_json)
    ? (gt (goo_measure/magnitude min) (goo_measure/magnitude pref)) .none
    | ./some (goo_measure/size min pref grow)
  + decode_plan
    \ value=json
    ^ maybe[goo_measure/plan]
    > (json/obj fields) value .none
    < id_json (goo_codec/field fields "id")
    < id (goo_codec/identifier id_json)
    < width_json (goo_codec/field fields "w")
    < width (goo_number/nonnegative width_json)
    < height_json (goo_codec/field fields "h")
    < height (goo_number/nonnegative height_json)
    < cost_json (goo_codec/field fields "cost")
    < cost (goo_number/nonnegative cost_json)
    < rows_json (goo_codec/field fields "rows")
    < rows (goo_codec/optional[list[goo_measure/plan_row]] (goo_measure/array[goo_measure/plan_row] goo_measure/decode_plan_row) (./some rows_json))
    | ./some (goo_measure/plan id width height cost rows)
  + decode_plan_row
    \ value=json
    ^ maybe[goo_measure/plan_row]
    > (json/obj fields) value .none
    < start_json (goo_codec/field fields "start")
    < start (goo_number/integer start_json)
    < end_json (goo_codec/field fields "end")
    < end (goo_number/integer end_json)
    < children_json (goo_codec/field fields "children")
    < children (goo_measure/array[goo_measure/plan] goo_measure/decode_plan children_json)
    < gap_json (goo_codec/field fields "gap")
    < gap (goo_number/nonnegative gap_json)
    < height_json (goo_codec/field fields "h")
    < height (goo_number/nonnegative height_json)
    < gaps (goo_codec/optional[list[goo/scalar]] (goo_measure/array[goo/scalar] goo_number/nonnegative) (goo_codec/field fields "rowGaps"))
    ? ((le end start) || !(eq children.len (sub end start))) .none
    | ./some (goo_measure/plan_row start end children gap height gaps)
  + decode_trace
    \ value=json
    ^ maybe[goo_measure/trace]
    > (json/obj fields) value .none
    < edge (goo_codec/edge value)
    < x_json (goo_codec/field fields "x")
    < x (goo_number/nonnegative x_json)
    < y_json (goo_codec/field fields "y")
    < y (goo_number/nonnegative y_json)
    < stretch_json (goo_codec/field fields "stretch")
    < stretch (goo_number/nonnegative stretch_json)
    < penalty_json (goo_codec/field fields "breakPenalty")
    < penalty (goo_number/nonnegative penalty_json)
    < preferred_json (goo_codec/field fields "preferredGap")
    < preferred (goo_number/nonnegative preferred_json)
    < gap_json (goo_codec/field fields "gap")
    < gap (goo_number/nonnegative gap_json)
    < axis_json (goo_codec/field fields "axis")
    < axis (goo_measure/axis_decode axis_json)
    < cut_json (goo_codec/field fields "cut")
    < cut (goo_codec/boolean cut_json)
    | ./some (goo_measure/trace edge x y stretch penalty preferred gap axis cut)
  + decode_sizes
    \ value=json
    ^ maybe[list[goo_measure/named_size]]
    > (json/obj fields) value .none
    % rest=list[jkv] fields.stream out=list[goo_measure/named_size] .nil
    ^ maybe[list[goo_measure/named_size]]
    ? rest.is_nil (./some out.reverse)
    = entry rest.head
    < id (goo_codec/identifier (json/str entry.k))
    < size (goo_measure/decode_size entry.v)
    | _ rest.tail out.cons((goo_measure/named_size id size))
  + decode_result
    \ value=json
    ^ maybe[goo_measure/result]
    > (json/obj fields) value .none
    < version_json (goo_codec/field fields "version")
    < version (goo_number/integer version_json)
    ? !(eq version 1) .none
    < tree_json (goo_codec/field fields "tree")
    < tree (goo_codec/optional[goo/semantic] goo_codec/decode_semantic (./some tree_json))
    < width_json (goo_codec/field fields "width")
    < width (goo_number/nonnegative width_json)
    < sizes_json (goo_codec/field fields "sizes")
    < sizes (goo_measure/decode_sizes sizes_json)
    < plan_json (goo_codec/field fields "plan")
    < plan (goo_codec/optional[goo_measure/plan] goo_measure/decode_plan (./some plan_json))
    < traces_json (goo_codec/field fields "trace")
    < traces (goo_measure/array[goo_measure/trace] goo_measure/decode_trace traces_json)
    = raw (goo_measure/raw tree width sizes plan traces)
    | DeepSeq[maybe[goo_measure/result]] raw (goo_measure/make raw)
  + nodes
    \ tree=goo/semantic
    ^ list[goo/semantic]
    | list/fold[goo/semantic list[goo/semantic]] (list/one tree) (\ acc child acc.weld((goo_measure/nodes child))) tree.children
  + plans
    \ plan=goo_measure/plan
    ^ list[goo_measure/plan]
    ? plan.rows
     > ./none (list/one plan)
     > (./some rows)
      = children (list/fold[goo_measure/plan_row list[goo_measure/plan]] (list/nil[goo_measure/plan]) (\ acc row acc.weld(row.children)) rows)
      | list/fold[goo_measure/plan list[goo_measure/plan]] (list/one plan) (\ acc child acc.weld((goo_measure/plans child))) children
  + validate_plan
    \ tree=goo/semantic plan=goo_measure/plan
    ^ bool
    ? !(goo_measure/valid_number plan.width) .false
    ? !(goo_measure/valid_number plan.height) .false
    ? !(goo_measure/valid_number plan.cost) .false
    ? !(equal[goo/node_id] tree.node_id plan.id) .false
    ? (lt (goo_measure/magnitude plan.width) 4607182418800017408) .false
    ? tree
     > (./flow _ direction kids)
      ? plan.rows
       > ./none .false
       > (./some rows)
        ? (eq rows.len 0) .false
        % rest=list[goo_measure/plan_row] rows nodes=list[goo/semantic] kids next=nat 0
        ^ bool
        ? rest.is_nil nodes.is_nil
        = row rest.head
        ? !(goo_measure/valid_number row.gap) .false
        ? !(goo_measure/valid_number row.height) .false
        ? !(eq row.children.len (sub row.end row.start)) .false
        ? (le row.end row.start) .false
        = valid_gaps=bool
            ? row.gaps
             > ./none .true
             > (./some gaps) !(list/any[goo/scalar] (\ n !(goo_measure/valid_number n)) gaps)
        ? !valid_gaps .false
        ? !(eq row.start next) .false
        ? (gt row.end kids.len) .false
        = valid=bool
            ? direction
             > ./row
              ? row.gaps
               > ./none .false
               > (./some gaps) (eq gaps.len (sub row.children.len 1))
             > ./col
              ? !(eq row.children.len 1) .false
              | equal[maybe[list[goo/scalar]]] row.gaps .none
        ? !valid .false
        = children_valid=bool
            % trees=list[goo/semantic] nodes plans=list[goo_measure/plan] row.children
            ^ bool
            ? plans.is_nil .true
            ? trees.is_nil .false
            ? !(goo_measure/validate_plan trees.head plans.head) .false
            | _ trees.tail plans.tail
        ? !children_valid .false
        | _ rest.tail nodes.drop(row.children.len) row.end
    | equal[maybe[list[goo_measure/plan_row]]] plan.rows .none
  + fraction
    \ value=goo/scalar
    ^ goo_number/rational
    = magnitude (goo_measure/magnitude value)
      exponent (div magnitude 4503599627370496)
      mantissa (add (mod magnitude 4503599627370496) (? (eq exponent 0) 0 4503599627370496))
      shift (? (eq exponent 0) 1074 (sub 1075 exponent))
    ? (ge exponent 1075) (goo_number/rational .false (mul mantissa (lsh 1 (sub exponent 1075))) 1)
    | goo_number/rational .false mantissa (lsh 1 shift)
  + close_gap
    \ left=goo/scalar right=goo/scalar
    ^ bool
    = a (goo_measure/fraction left)
      b (goo_measure/fraction right)
      x (mul a.numerator b.denominator)
      y (mul b.numerator a.denominator)
      delta (? (gt x y) (sub x y) (sub y x))
    ? (goo_number/finite .false delta (mul a.denominator b.denominator))
     > ./none .false
     > (./some value) (lt value.bits 4577494690056391098)
  + position
    : row=goo_measure/plan_row row_index=nat child_index=nat
  + locate
    \ id=goo/node_id rows=list[goo_measure/plan_row]
    ^ maybe[goo_measure/position]
    % i=nat 0
    ^ maybe[goo_measure/position]
    ? (eq i rows.len) .none
    = row rows.at(i)
      found=maybe[nat]
        % j=nat 0
        ^ maybe[nat]
        ? (eq j row.children.len) .none
        ? (equal[goo/node_id] id row.children.at(j).id) (./some j)
        | _ j.inc
    ? found
     > (./some j) (./some (goo_measure/position row i j))
    | _ i.inc
  + check_trace
    \ nodes=list[goo/semantic] plans=list[goo_measure/plan] trace=goo_measure/trace
    ^ bool
    = parents (list/filter[goo_measure/plan] (\ p (equal[goo/node_id] p.id trace.edge.parent)) plans)
      owners (list/filter[goo/semantic] (\ n (equal[goo/node_id] n.node_id trace.edge.parent)) nodes)
    ? !((eq parents.len 1)) .false
    ? !((eq owners.len 1)) .false
    > (./some rows) parents.at(0).rows .false
    > (./some left) (goo_measure/locate trace.edge.left_id rows) .false
    > (./some right) (goo_measure/locate trace.edge.right_id rows) .false
    = broken !(eq left.row_index right.row_index)
      flow=bool
        ? owners.at(0)
         > (./flow _ direction _) (equal[goo/direction] direction (goo/direction/row))
        .false
      gap=goo/scalar
        ? broken right.row.gap
        ? left.row.gaps
         > ./none (goo/scalar 0)
         > (./some gaps) gaps.at(left.child_index)
      axis (? broken (goo_measure/axis/y) (goo_measure/axis/x))
      cut (? flow broken .false)
    ? !(equal[goo_measure/axis] trace.axis axis) .false
    ? !(eq trace.cut cut) .false
    ? !(goo_measure/close_gap trace.gap gap) .false
    | goo_measure/same trace.preferred (? broken trace.y trace.x)
  + make
    \ raw=goo_measure/raw
    ^ maybe[goo_measure/result]
    ? !(goo_measure/valid_number raw.width) .none
    ? (list/any[goo_measure/named_size] (\ item !(goo_measure/valid_size item.size)) raw.sizes) .none
    ? (list/any[goo_measure/trace] (\ trace !(goo_measure/valid_trace trace)) raw.traces) .none
    ? (lt (goo_measure/magnitude raw.width) 4607182418800017408) .none
    = nodes=list[goo/semantic]
        ? raw.tree
         > ./none .nil
         > (./some tree) (goo_measure/nodes tree)
      ids nodes.map((\ n=goo/semantic n.node_id.text))
      size_ids raw.sizes.map((\ n=goo_measure/named_size n.id.text))
      edges (list/sift[goo/semantic goo/edge] goo/semantic/after nodes)
    ? !(goo_codec/unique size_ids) .none
    ? !(eq ids.len size_ids.len) .none
    ? (list/any[str] (\ id !(list/any[str] (\ other (eq id other)) size_ids)) ids) .none
    ? !(eq edges.len raw.traces.len) .none
    ? !(goo_codec/unique raw.traces.map((\ t=goo_measure/trace t.edge.left_id.text))) .none
    ? (list/any[goo_measure/trace] (\ trace !(list/any[goo/edge] (\ e (equal[goo/edge] e trace.edge)) edges)) raw.traces) .none
    ? raw.tree
     > ./none
      ? !(equal[maybe[goo_measure/plan]] raw.plan .none) .none
      | ./some (goo_measure/result raw)
     > (./some tree)
      ? !(goo_codec/validate_semantic tree) .none
      < checked_tree (goo_codec/decode_semantic (goo_codec/semantic_json tree))
      > (./some plan) raw.plan .none
      ? !(goo_measure/same plan.width raw.width) .none
      ? !(goo_measure/validate_plan tree plan) .none
      = plans (goo_measure/plans plan)
      ? (list/any[goo_measure/trace] (\ trace !(goo_measure/check_trace nodes plans trace)) raw.traces) .none
      | ./some (goo_measure/result raw)
  + encode_size
    \ value=goo_measure/size
    ^ json
    = fields=row[jkv] []
      fields fields.snoc((jkv "min" (goo_number/encode value.min)))
      fields fields.snoc((jkv "pref" (goo_number/encode value.pref)))
      fields fields.snoc((jkv "grow" (goo_codec/number (? value.grow 1 0))))
    | json/obj fields
  + encode_plan
    \ value=goo_measure/plan
    ^ json
    = fields=row[jkv] []
      fields fields.snoc((jkv "id" (json/str value.id.text)))
      fields fields.snoc((jkv "w" (goo_number/encode value.width)))
      fields fields.snoc((jkv "h" (goo_number/encode value.height)))
      fields fields.snoc((jkv "cost" (goo_number/encode value.cost)))
      fields fields.snoc((jkv "rows" (goo_codec/optional_json[list[goo_measure/plan_row]] goo_measure/encode_rows value.rows)))
    | json/obj fields
  + encode_plan_row
    \ value=goo_measure/plan_row
    ^ json
    = fields=row[jkv] []
      fields fields.snoc((jkv "start" (goo_codec/number value.start)))
      fields fields.snoc((jkv "end" (goo_codec/number value.end)))
      fields fields.snoc((jkv "children" (json/arr value.children.map(goo_measure/encode_plan).row)))
      fields fields.snoc((jkv "gap" (goo_number/encode value.gap)))
      fields fields.snoc((jkv "h" (goo_number/encode value.height)))
      fields
        ? value.gaps
         > ./none fields
         > (./some gaps) fields.snoc((jkv "rowGaps" (json/arr gaps.map(goo_number/encode).row)))
    | json/obj fields
  + encode_trace
    \ value=goo_measure/trace
    ^ json
    = fields=row[jkv] []
      fields=row[jkv]
        ? (goo_codec/edge_json value.edge)
         > (json/obj members) members
        []
      fields fields.snoc((jkv "x" (goo_number/encode value.x)))
      fields fields.snoc((jkv "y" (goo_number/encode value.y)))
      fields fields.snoc((jkv "stretch" (goo_number/encode value.stretch)))
      fields fields.snoc((jkv "breakPenalty" (goo_number/encode value.penalty)))
      fields fields.snoc((jkv "preferredGap" (goo_number/encode value.preferred)))
      fields fields.snoc((jkv "gap" (goo_number/encode value.gap)))
      fields fields.snoc((jkv "axis" (json/str (? (equal[goo_measure/axis] value.axis (goo_measure/axis/x)) "x" "y"))))
      fields fields.snoc((jkv "cut" (json/boo value.cut)))
    | json/obj fields
  + encode_rows
    \ rows=list[goo_measure/plan_row]
    ^ json
    | json/arr rows.map(goo_measure/encode_plan_row).row
  + encode_sizes
    \ sizes=list[goo_measure/named_size]
    ^ json
    | json/obj sizes.map((\ s=goo_measure/named_size (jkv s.id.text (goo_measure/encode_size s.size)))).row
  + encode
    ' Revalidate at the public consumer boundary, even for internal construction.
    \ result=goo_measure/result
    ^ maybe[json]
    < checked (goo_measure/make result.value)
    = r checked.value
    | ./some (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "tree" (goo_codec/optional_json[goo/semantic] goo_codec/semantic_json r.tree)) (jkv "width" (goo_number/encode r.width)) (jkv "sizes" (goo_measure/encode_sizes r.sizes)) (jkv "plan" (goo_codec/optional_json[goo_measure/plan] goo_measure/encode_plan r.plan)) (jkv "trace" (json/arr r.traces.map(goo_measure/encode_trace).row))])
  + stage
    \ result=goo_measure/raw name=str
    ^ json
    ? (eq name "semantic") (goo_inspect/stage name "ok" (goo_codec/optional_json[goo/semantic] goo_inspect/semantic result.tree) [])
    ? (eq name "metrics") (goo_inspect/stage name "ok" (json/obj [(jkv "sizes" (goo_measure/encode_sizes result.sizes)) (jkv "width" (goo_number/encode result.width))]) [])
    ? (eq name "layout") (goo_inspect/stage name "ok" (goo_codec/optional_json[goo_measure/plan] goo_measure/encode_plan result.plan) [])
    ? (eq name "trace") (goo_inspect/stage name "ok" (json/arr result.traces.map(goo_measure/encode_trace).row) [])
    | goo_inspect/stage name "skipped" jnull []
  + run
    \ source=str
    ^ str
    = result=maybe[goo_measure/result]
        > (./ok value _) (parse source) .none
        > (json/obj fields) value .none
        < payload (goo_codec/field fields "result")
        | goo_measure/decode_result payload
    ? result
     > ./none (show (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .false)) (jkv "stage" (json/str "protocol")) (jkv "error" (json/str "invalid measurement result"))]))
     > (./some result)
      = names=row[str] ["parse" "read" "core" "normalized" "visible" "semantic" "metrics" "layout" "trace" "prepared" "html"]
      | show (json/obj [(jkv "version" (goo_codec/number 1)) (jkv "ok" (json/boo .true)) (jkv "outcome" (json/str "complete")) (jkv "stages" (json/arr names.map((goo_measure/stage result.value))))])
  + valid_number
    \ n=goo/scalar
    ^ bool
    ? (gt n.bits 9223372036854775808) .false
    ? (goo/scalar/from_bits n.bits)
     > ./none .false
     > (./some _) .true
  + valid_size
    \ size=goo_measure/size
    ^ bool
    ? !(goo_measure/valid_number size.min) .false
    ? !(goo_measure/valid_number size.pref) .false
    | le (goo_measure/magnitude size.min) (goo_measure/magnitude size.pref)
  + valid_trace
    \ trace=goo_measure/trace
    ^ bool
    | !(list/any[goo/scalar] (\ number !(goo_measure/valid_number number)) (list/one trace.gap).cons(trace.preferred).cons(trace.penalty).cons(trace.stretch).cons(trace.y).cons(trace.x))
