- goo_app/adapter
- goo_app/ascii_tests
- goo_app/layout_tests
- goo_app/html_tests
- goo_app/codec_tests
- goo_app/semantic_tests
- goo_app/type_tests
- goo_app/result_tests
- goo_app/rex_boundary
- rex
- testing
- json

+ goo_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = word (rex/word "payload").with_span((rex/make_span 3 0 4 7))
      bad (either/ok_val[any rex] (rex/parse (str/from_atom 34))).with_span((rex/make_span 3 0 4 1))
    [(testing/nat "normal leaf has no diagnostics" 0 (goo_rex_boundary/diagnostics word).len)
     (testing/nat "bad leaf diagnostic retained" 1 (goo_rex_boundary/diagnostics bad).len)
     (testing/text "diagnostic wording" "invalid character" (goo_rex_boundary/reason_text "invalid-char"))
     (testing/nat "span offset stays unchanged" 4 word.span.offset)
     (testing/nat "tree shape stays unchanged" 1 (equal[maybe[str]] word.leaf_kind (maybe/some[str] "word")))]
  + run
    \ ignored=unit
    ^ str
    = checks (goo_tests/checks ignored).weld((goo_type_tests/checks ignored)).weld((goo_result_tests/checks ignored)).weld((goo_codec_tests/checks ignored)).weld((goo_semantic_tests/checks ignored)).weld((goo_ascii_tests/checks ignored)).weld((goo_layout_tests/checks ignored)).weld((goo_html_tests/checks ignored))
      f goo_rex_boundary/field
      s goo_rex_boundary/text
      failures (row/fold[testing/check nat] 0 (\ count=nat check=testing/check (? check.pass count count.inc)) checks)
      values
        | checks.map
        \ check=testing/check
        ^ json
        | json/obj [(f "name" (s check.name)) (f "pass" (json/boo check.pass)) (f "expected" (s check.want)) (f "actual" (s check.got))]
    | show (json/obj [(f "ok" (json/boo (eq failures 0))) (f "checks" (json/arr values))])
