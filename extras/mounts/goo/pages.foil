- goo_app/html
- goo_app/display

' Static markup transcribed from the original application views; dynamic content
' is assembled and escaped in Foil. No source or fixture substitution at runtime.
+ goo_pages
  + inspector
    \ names=row[str] current=str source=str
    ^ str
    | str/cat_all [(str/cat_all ["<!DOCTYPE HTML><html><head><meta charset=""utf-8""><meta name=""viewport"" content=""width=device-width, initial-scale=1""><title>goo · typed UI lowering</title><link rel=""stylesheet"" href=""static/goo.generated.css""><link rel=""stylesheet"" href=""/static/app.css""><link rel=""stylesheet"" href=""/static/ascii-fonts.css""><script src=""/static/inspector/protocol.js"" defer=""""></script><script src=""/static/inspect" "or/preview.js"" defer=""""></script><script src=""/static/inspector/app.js"" defer=""""></script></head><body class=""inspector m-0 p-0 font-ui text-sm leading-normal bg-canvas text-ink""><header class=""bar flex flex-wrap items-center gap-4 px-4 py-2 bg-panel border-b border-line""><div class=""brand flex items-baseline gap-2""><strong class=""text-base tracking-tight  "">goo</strong><span class=""muted text-mut" "ed"">Typed UI nanopasses → HTML</span></div><a href=""/gallery"" class=""text-accent font-semibold"">Gallery</a><div class=""controls flex flex-wrap items-center gap-2""><label for=""example"" class=""muted text-muted"">Example</label><select id=""example"" class=""control border border-line rounded-control bg-panel text-ink px-2 py-1 text-sm outline-accent outline-offset-2"">"]) (str/cat_all names.map((goo_pages/option current))) (str/cat_all ["</select><button id=""save"" type=""button"" title=""Write the source to examples/ (⌘S / Ctrl+S)"">Save</button><button id=""save-as"" type=""button"" title=""Save as a new example"">Save as…</button></div><div class=""controls view-controls flex flex-wrap items-center gap-2 ""><label for=""view-path"" class=""muted text-muted"">View depth</label><select id=""view-path"" class=""control border border-line rounded-cont" "rol bg-panel text-ink px-2 py-1 text-sm outline-accent outline-offset-2"" data-retired-view-paths=""/sys/views/default /sys/views/compact /sys/views/mono"" title=""Choose how much of the object to show""><option value=""/sys/slots/scar"">scar — Identity</option><option value=""/sys/slots/label"">label — Brief identity</option><option value=""/sys/slots/summary"" selected="""">summary — Identity in context</opt" "ion><option value=""/sys/slots/inspect"">inspect — About the object</option><option value=""/sys/slots/detail"">detail — The object is the focus of the screen</option><option value=""/sys/slots/full"">full — Full object</option><option value=""custom"">Custom path…</option></select><input id=""custom-view-path"" type=""text"" class=""control w-64 max-w-full border border-line rounded-control bg-panel text-ink " "px-2 py-1 text-sm outline-accent outline-offset-2  "" hidden="""" aria-label=""Custom view path"" value=""/sys/slots/summary"" spellcheck=""false"" autocomplete=""off""></div><div class=""controls flex flex-wrap items-center gap-2""><label for=""budget"" class=""muted text-muted"">Optional budget</label><select id=""budget"" class=""control border border-line rounded-control bg-panel text-ink px-2 py-1 text-sm outlin" "e-accent outline-offset-2""><option value=""auto"">From view</option><option value=""0"">Minimal · 0</option><option value=""1"">Compact · 1</option><option value=""2"">Full · 2</option></select><label class=""toggle inline-flex items-center gap-1 text-muted text-xs cursor-pointer select-none whitespace-nowrap""><input type=""checkbox"" id=""uniform-edges"">Uniform edges</label></div><span id=""compile-status"" cl" "ass=""status ml-auto text-xs px-2 py-1 rounded-full bg-canvas text-muted"">connecting</span></header><main class=""goo-panes grid min-h-0""><section class=""pane source-pane flex flex-col min-w-0 min-h-0 bg-panel border-r border-line ""><div class=""pane-head flex flex-wrap items-center justify-between gap-2 px-3 py-2 border-b border-line""><h2 class=""text-xs font-semibold tracking-wider uppercase text-mu" "ted     "">Source</h2><span id=""dirty"" class=""muted text-muted""></span></div><textarea id=""source"" class=""editor flex-1 min-h-0 w-full resize-none border-0 outline-none p-3 bg-canvas text-ink font-mono text-sm leading-relaxed whitespace-pre overflow-auto"" spellcheck=""false"" autocomplete=""off"" autocapitalize=""off"" data-example="""]) (goo_html/escape current) (str/cat_all [""">"]) (goo_html/escape source) (str/cat_all ["</textarea><div class=""source-foot overflow-auto border-t border-line""><ul id=""diags"" class=""diags list-none m-0 py-1""></ul><details class=""reference border-t border-line px-3 py-2""><summary class=""text-muted text-xs cursor-pointer   "">Language reference</summary><table class=""text-xs mt-2 w-full   ""><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>row(%person) { … }</code></td>" "<td class=""align-top py-1 pr-2 border-t border-line     "">Wrapping flow with its own public slot; col/stack lays children vertically</td></tr><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>col(%identity) { … }</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Named groups retain identity even with one child</td></tr><tr><td class=""align-top py-1 pr-2 border-" "t border-line     ""><code>text(&quot;Name&quot;, %title)</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Opaque, exact, case-sensitive slot; quoted strings also work</td></tr><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>image(&quot;https://…&quot;, /sys/slots/icon)</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Compatibility image f" "rontend; reference avatar geometry</td></tr><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>opt(1) { … }</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Optional children: rank 1 compact, rank 2 full; pruned before adjacency</td></tr><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>text({[optional]: 1}, &quot;Ada&quot;, %title)</code></td" "><td class=""align-top py-1 pr-2 border-t border-line     "">Config first: slot, optional, maxIdeal, grow, label, primary, value, max</td></tr><tr><td class=""align-top py-1 pr-2 border-t border-line     ""><code>button / input / code / avatar / presence / media / bar</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Reference primitives, same call syntax as text</td></tr><tr><td cl" "ass=""align-top py-1 pr-2 border-t border-line     ""><code>&#39;) comment</code></td><td class=""align-top py-1 pr-2 border-t border-line     "">Rex line comment; double a quote inside a quoted string</td></tr></table></details></div></section><section class=""pane lowering-pane flex flex-col min-w-0 min-h-0 bg-panel border-r border-line ""><div class=""pane-head flex flex-wrap items-center justify-betw" "een gap-2 px-3 py-2 border-b border-line""><h2 class=""text-xs font-semibold tracking-wider uppercase text-muted     "">Lowering</h2><div class=""controls flex flex-wrap items-center gap-2""><label class=""toggle inline-flex items-center gap-1 text-muted text-xs cursor-pointer select-none whitespace-nowrap""><input type=""checkbox"" id=""changes-only"">Changes only</label><label class=""toggle inline-flex ite" "ms-center gap-1 text-muted text-xs cursor-pointer select-none whitespace-nowrap""><input type=""checkbox"" id=""show-removed"" checked="""">Show removed</label><button id=""toggle-all"" type=""button"">Collapse all</button></div></div><div id=""passes"" class=""passes flex-1 overflow-auto p-3""></div></section><section class=""pane output-pane flex flex-col min-w-0 min-h-0 bg-panel border-r border-line ""><div cla" "ss=""pane-head flex flex-wrap items-center justify-between gap-2 px-3 py-2 border-b border-line""><h2 class=""text-xs font-semibold tracking-wider uppercase text-muted     "">Output</h2><div class=""controls widths flex flex-wrap items-center gap-2 ""><button type=""button"" data-width=""100%"" class=""on "">Full</button><button type=""button"" data-width=""768px"">Tablet</button><button type=""button"" data-width=" """375px"">Phone</button></div></div><div class=""flex flex-wrap shrink-0 items-center gap-3 px-3 py-2 text-xs text-muted"" aria-label=""View border colors""><span>View outline:</span><span class=""inline-flex items-center gap-1"" title=""/sys/slots/scar · height &lt; 24px""><span class=""inline-block w-3 h-3 rounded-full bg-red-500"" aria-hidden=""true""></span>Mark</span><span class=""inline-flex items-center g" "ap-1"" title=""/sys/slots/label · 24px ≤ height &lt; 48px""><span class=""inline-block w-3 h-3 rounded-full bg-orange-500"" aria-hidden=""true""></span>Label</span><span class=""inline-flex items-center gap-1"" title=""/sys/slots/summary · 48px ≤ height &lt; 96px""><span class=""inline-block w-3 h-3 rounded-full bg-amber-500"" aria-hidden=""true""></span>Summary</span><span class=""inline-flex items-center gap-1""" " title=""/sys/slots/inspect · 96px ≤ height &lt; 192px""><span class=""inline-block w-3 h-3 rounded-full bg-green-500"" aria-hidden=""true""></span>Inspect</span><span class=""inline-flex items-center gap-1"" title=""/sys/slots/detail · 192px ≤ height &lt; 384px""><span class=""inline-block w-3 h-3 rounded-full bg-blue-500"" aria-hidden=""true""></span>Detail</span><span class=""inline-flex items-center gap-1"" t" "itle=""/sys/slots/full · height ≥ 384px""><span class=""inline-block w-3 h-3 rounded-full bg-violet-500"" aria-hidden=""true""></span>Full</span></div><div class=""frame-wrap flex-1 min-h-0 flex justify-center overflow-auto bg-canvas""><iframe id=""preview"" class=""w-full h-full border-0 bg-canvas flex-none     "" sandbox=""allow-same-origin"" title=""Rendered output""></iframe></div></section></main></body></ht" "ml>"])]
  + option
    \ current=str name=str
    ^ str
    = attrs=list[goo_html/attribute] (list/one (goo_html/attribute "value" name))
      attrs (? (eq current name) attrs.snoc((goo_html/attribute "selected" "")) attrs)
    | goo_html/tag "option" attrs (goo_html/escape name)
  + gallery
    \ examples=row[json]
    ^ str
    | str/cat_all [(str/cat_all ["<!DOCTYPE HTML><html><head><meta charset=""utf-8""><meta name=""viewport"" content=""width=device-width, initial-scale=1""><title>goo · example gallery</title><link rel=""stylesheet"" href=""static/goo.generated.css""><link rel=""stylesheet"" href=""/static/app.css""><link rel=""stylesheet"" href=""/static/ascii-fonts.css""><script src=""/static/inspector/protocol.js"" defer=""""></script><script src=""/static/inspector" "/preview.js"" defer=""""></script><script src=""/static/inspector/gallery.js"" defer=""""></script></head><body class=""gallery m-0 font-ui text-sm bg-canvas text-ink""><header class=""gallery-header flex flex-wrap items-center gap-4 px-4 py-3 bg-panel border-b border-line""><strong class=""text-base"">goo</strong><nav class=""flex gap-3"" aria-label=""Workspace view""><a href=""/"" class=""text-muted"">Inspector</a><" "a href=""/gallery"" class=""text-accent font-semibold"" aria-current=""page"">Gallery</a></nav><h1 id=""gallery-count"" class=""text-base font-semibold"" aria-live=""polite"">"]) (str/cat_all ["All examples · " examples.len.show]) (str/cat_all ["</h1><label>Category <select id=""gallery-category"" class=""border border-line rounded px-2 py-1 bg-panel text-ink""><option value=""all"">All examples</option><option value=""a"">AXX · Adversarial</option><option value=""g"">GXX · Domain</option><option value=""other"">Other examples (including R01)</option></select></label><label>View <select id=""gallery-view"" class=""border border-line rounded px-2 py-1 bg" "-panel text-ink""><option value=""case"">Case settings</option><option value=""/sys/slots/scar"">scar</option><option value=""/sys/slots/label"">label</option><option value=""/sys/slots/summary"">summary</option><option value=""/sys/slots/inspect"">inspect</option><option value=""/sys/slots/detail"">detail</option><option value=""/sys/slots/full"">full</option></select></label><label>Budget <select id=""gallery-b" "udget"" class=""border border-line rounded px-2 py-1 bg-panel text-ink""><option value=""case"">Case settings</option><option value=""0"">Minimal</option><option value=""1"">Compact</option><option value=""2"">Full</option></select></label><label>Content width <input id=""gallery-width"" type=""number"" min=""1"" max=""5000"" step=""any"" placeholder=""Per case"" class=""border border-line rounded px-2 py-1 bg-panel text" "-ink"" style=""width:110px""></label><label class=""inline-flex gap-1 items-center""><input id=""gallery-uniform"" type=""checkbox"">Uniform edges</label><input id=""gallery-filter"" type=""search"" placeholder=""Filter examples…"" aria-label=""Filter examples"" class=""border border-line rounded px-2 py-1 bg-panel text-ink""><button id=""gallery-refresh"" type=""button"" class=""border border-line rounded px-2 py-1 bg-p" "anel text-ink"">Reload files</button></header><main class=""gallery-scroll""><table class=""gallery-table w-full""><caption class=""text-muted text-left px-4 py-2"">Source and measured rendering. Case widths are content widths; scroll inside tall or wide previews.</caption><thead><tr><th scope=""col"" class=""text-left align-top p-4 border-b border-line bg-panel"">Source</th><th scope=""col"" class=""text-left " "align-top p-4 border-b border-line bg-panel"">Rendered</th></tr></thead><tbody>"]) (str/cat_all examples.map(goo_pages/gallery_row)) (str/cat_all ["</tbody></table></main></body></html>"])]
  + row_markup
    \ name=str source=str meta=json
    ^ str
    | str/cat_all [(str/cat_all ["<tr data-example="""]) (goo_html/escape name) (str/cat_all [""" data-case="""]) (goo_html/escape (show (goo_pages/sorted_json meta))) (str/cat_all ["""><td class=""text-left align-top p-4 border-b border-line bg-panel""><div class=""flex justify-between items-center gap-2 mb-2""><h2 class=""text-sm font-semibold"">"]) (goo_html/escape (goo_pages/meta_text meta "title" name)) (str/cat_all ["</h2><a href=""/?example="]) (goo_html/escape name) (str/cat_all [""" class=""text-accent text-xs"">Open in inspector</a></div>"]) (goo_pages/note meta "oracle") (str/cat_all []) (goo_pages/note meta "notes") (str/cat_all ["<pre class=""gallery-source m-0 p-3 bg-canvas font-mono text-xs rounded border border-line"">"]) (goo_html/escape source) (str/cat_all ["</pre></td><td class=""text-left align-top p-4 border-b border-line bg-panel""><div class=""flex flex-wrap items-center gap-2 mb-2""><label>Width <select class=""case-width border border-line rounded px-2 py-1 bg-panel"" aria-label=""Content width for "]) (goo_html/escape name) (str/cat_all ["""></select></label><span class=""case-settings text-xs text-muted""></span></div><p class=""case-status text-xs text-muted"" role=""status"">Waiting to render…</p><div class=""gallery-preview mt-2""></div></td></tr>"])]
  + gallery_row
    \ value=json
    ^ str
    = fields (goo_display/array value)
    ? !(eq fields.len 3) ""
    | goo_pages/row_markup (goo_display/text fields.at(0)) (goo_display/text fields.at(1)) fields.at(2)
  + meta_text
    \ meta=json key=str fallback=str
    ^ str
    ? (goo_display/get meta key)
     > (json/str value) value
    fallback
  + note
    \ meta=json key=str
    ^ str
    = text (goo_pages/meta_text meta key "")
    ? (eq text "") ""
    | goo_html/tag "p" (list/one (goo_html/attribute "class" "text-xs text-muted mb-2")) (goo_html/escape text)
  + sorted_json
    \ value=json
    ^ json
    ? value
     > (json/obj fields) (json/obj (goo_display/sorted fields).map((\ field=jkv (jkv field.k (goo_pages/sorted_json field.v)))))
     > (json/arr values) (json/arr values.map(goo_pages/sorted_json))
    value
