- goo_app/prepared
- goo_app/wire_adapter

' Typed projection of checked preparation. No decimal geometry or JSON display
' tree is constructed. The profile's existing paint table is a small JSON API.
+ goo_wire
  + run_myth
    \ metadata=myth
    ^ goo_wire/myth
    | goo_wire/myth
    | metadata.tap.map
      \ [slot held]
      = empty (goo_wire/pail .none .none .none .none .none .none .none)
        pail=goo_wire/pail
          ? held
           > value=pails/n empty.set_nat((./some value.n.show))
           > value=pails/b empty.set_boolean((./some value.b))
           > value=pails/t empty.set_text((./some value.t))
           > value=pails/p empty.set_path((./some (path_show value.p)))
           > value=pails/modifiers empty.set_modifiers((./some (goo_wire/modifiers value.values.map(goo_text/modifier_name).row)))
           > value=weblink empty.set_weblink((./some value.href))
          | empty.set_unsupported_brand((./some (nat/show (rep_hd held))))
      | goo_wire/myth_entry (path_show slot) pail
  + from_runs
    \ runs=goo/text
    ^ goo_wire/text_runs
    | goo_wire/text_runs runs.map((\ run (goo_wire/text_run (goo_wire/run_myth run.myth) (goo_wire/language (goo_wire/english run.lang.txt)))))
  + base_style
    \ style=goo_profile/style
    ^ goo_wire/text_style
    = font (goo_fonts/metadata style.face)
    | goo_wire/text_style (goo_profile/font_id style.face) font.font_sha256 (goo_profile/font_family style.face)
        (goo_profile/font_weight style.face) (goo_profile/font_style style.face)
        style.pixels.bits style.leading.bits style.tracking.bits style.inset_x.bits style.inset_y.bits .false .false
  + run_style
    \ base=goo_profile/style metadata=myth
    ^ goo_wire/text_style
    = font (goo_run/font base metadata)
    | goo_wire/text_style font.id font.info.font_sha256 font.family font.info.weight
        (? font.info.italic "italic" "normal") base.pixels.bits base.leading.bits base.tracking.bits 0 0 .false .false
  + run_recipe
    \ base=goo_profile/style metadata=myth foreground=str baseline=goo/scalar
    ^ goo_wire/resolved_run
    = link (goo_text/linked metadata)
      ink=str (? link "#34573e" foreground)
      target=maybe[goo_wire/link]
        ?> (./some held) metadata.get(['sys 'link]) .none
        ? held
         > value=pails/p (./some (goo_wire/link "path" (./some (path_show value.p)) .none))
         > value=weblink (./some (goo_wire/link "weblink" .none (./some value.href)))
        .none
      highlight=maybe[goo_wire/highlight] (? link (./some (goo_wire/highlight "#e7eedf" "#688b43" (goo_fp/integer 1).bits (goo_fp/integer 2).bits)) .none)
      underline=maybe[goo_wire/underline] (? (goo_text/modifier (modifiers/underline) metadata) (./some (goo_wire/underline ink (goo_fp/integer 1).bits (goo_fp/plus baseline (goo_fp/quotient base.pixels (goo_fp/integer 10))).bits)) .none)
    | goo_wire/resolved_run 1 (goo_wire/run_style base metadata) ink highlight underline (goo_wire/run_semantics (? link "link" "text") target)
  + edit_contract
    \ base=goo_profile/style foreground=str
    ^ goo_wire/editing
    = fonts goo_edit/fonts
      styles=row[goo_wire/edit_style]
        | fonts.bind
          \ name=str
          | (list/range 0 8).fold []
            \ out=row[goo_wire/edit_style] mask=nat
            = metadata (goo_edit/metadata name mask)
            ? (maybe/is_none (goo_run/resolve base metadata)) out
            | out.snoc (goo_wire/edit_style (goo_wire/run_myth metadata) (goo_wire/run_recipe base metadata foreground (goo/scalar 0)))
    | goo_wire/editing 1 "goo-text-v1" 65536 styles
        (goo_wire/run_recipe base (myth/sing ['sys 'link] (pails/p [])) foreground (goo/scalar 0))
  + fragments
    \ style=goo_profile/style runs=goo/text foreground=str x=goo/scalar y=goo/scalar baseline=goo/scalar
    ^ goo_wire/run_fragments
    = fragments=row[goo_wire/run_fragment]
        % i=nat 0 offset=goo/scalar (goo/scalar 0) out=row[goo_wire/run_fragment] []
        ^ row[goo_wire/run_fragment]
        ? (eq i runs.len) out
        = run runs.at(i) width (goo_run/width style [run]) left (goo_fp/plus x offset)
          resolved=maybe[goo_wire/resolved_run] (? (eq run.myth.size 0) .none (./some (goo_wire/run_recipe style run.myth foreground baseline)))
          fragment (goo_wire/run_fragment (goo_wire/run_myth run.myth) "en" run.lang.txt
            (goo_wire/box left.bits y.bits width.bits style.leading.bits) left.bits baseline.bits resolved)
        | _ i.inc (goo_fp/plus offset width) out.snoc(fragment)
    | goo_wire/run_fragments fragments
  + prepared_lines
    \ scale=goo/scalar rtl=bool positioned=goo_prepared/positioned foreground=str
    ^ row[goo_wire/line]
    = node positioned.node style (goo_ascii/text_style scale node.semantic) kind (goo_ascii/kind node.semantic)
      centered ((eq kind "button") || (eq kind "avatar"))
      lines (goo_prepared/lines node) prefix (goo_ascii/prefix scale node.semantic)
      baseline_offset (goo_ascii/baseline_offset style node.semantic)
      inset_x (goo_fp/quotient style.inset_x (goo_fp/integer 2))
      inset_y (? (eq kind "avatar") (goo_fp/quotient (goo_fp/minus node.plan.height style.leading) (goo_fp/integer 2)) (goo_fp/quotient style.inset_y (goo_fp/integer 2)))
    % remaining=list[goo/text] lines index=nat 0 out=row[goo_wire/line] []
    ^ row[goo_wire/line]
    ? remaining.is_nil out
    = text_width (goo_run/width style remaining.head) marker (? (eq index 0) prefix (goo/scalar 0))
      width (goo_fp/plus text_width marker)
      offset (? centered (goo_fp/quotient (goo_fp/minus node.plan.width width) (goo_fp/integer 2)) (? rtl (goo_fp/minus (goo_fp/minus node.plan.width inset_x) width) inset_x))
      x (goo_fp/plus positioned.x offset)
      y (goo_fp/plus positioned.y (goo_fp/plus inset_y (goo_fp/times (goo_fp/integer index) style.leading)))
      text_x (goo_fp/plus x (? rtl (goo/scalar 0) marker)) baseline (goo_fp/plus y baseline_offset)
      line (goo_wire/line remaining.head.plain (goo_wire/box x.bits y.bits width.bits style.leading.bits)
        text_x.bits baseline.bits marker.bits (./some (goo_wire/fragments style remaining.head foreground text_x y baseline)))
    | _ remaining.tail index.inc out.snoc(line)
  + prepared_node
    \ scale=goo/scalar rtl=bool positioned=goo_prepared/positioned
    ^ maybe[goo_wire/node]
    = node positioned.node semantic node.semantic style (goo_ascii/text_style scale semantic)
      cfg semantic.attrs.common.config
    < paint (goo_wire/paint_from_json (goo_prepared/paint_json scale semantic))
    < semantics (goo_wire/semantics_from_json (goo_prepared/semantics semantic))
    = config (goo_wire/config cfg.grow (goo_wire/map_optional[goo/scalar nat] goo/scalar/bits cfg.max_ideal) cfg.primary cfg.toggle cfg.label cfg.option_label (goo_wire/map_optional[goo/scalar nat] goo/scalar/bits cfg.value) (goo_wire/map_optional[goo/scalar nat] goo/scalar/bits cfg.max) (goo_wire/map_optional[goo/scalar nat] goo/scalar/bits cfg.aspect_ratio))
      editing=maybe[goo_wire/editing] (? (goo_edit/rich semantic) (./some (goo_wire/edit_contract style paint.foreground)) .none)
      src=maybe[str]
        ? semantic
         > (goo/semantic/image _ src) (./some src)
        .none
    | ./some (goo_wire/node semantic.node_id.text (goo_wire/map_optional[goo/node_id str] goo/node_id/text positioned.parent)
        (goo_ascii/kind semantic) (goo_ascii/role semantic) semantic.attrs.common.slot.text (goo_ascii/payload semantic)
        (goo_wire/box positioned.x.bits positioned.y.bits node.plan.width.bits node.plan.height.bits)
        (goo_wire/base_style style) (goo_wire/prepared_lines scale rtl positioned paint.foreground) paint semantics config
        (./some (goo_wire/from_runs (goo_ascii/runs semantic))) editing src)
  + prepared
    \ prepared=goo_html_internal/prepared
    ^ maybe[goo_wire/display]
    ? !(goo_prepared/valid prepared) .none
    = nodes=list[goo_prepared/positioned]
        ? prepared.tree
         > ./none .nil
         > (./some root) (goo_prepared/positions root .none (goo/scalar 0) (goo/scalar 0) prepared.rtl)
      height=nat
        ? prepared.tree
         > ./none 0
         > (./some root) root.plan.height.bits
      editable (nodes.any((\ item (goo_edit/rich item.node.semantic))))
      styled (nodes.any((\ item (row/any[goo/runt] (\ run !(eq run.myth.size 0)) (goo_ascii/runs item.node.semantic)))))
    < profile (goo_wire/profile_from_json (goo_profile/metadata unit/unit))
    < nodes (nodes.traverse_maybe((goo_wire/prepared_node prepared.scale prepared.rtl)))
    | ./some (goo_wire/display (? editable 3 (? styled 2 1)) profile
        (goo_wire/context prepared.width.bits prepared.scale.bits (? prepared.rtl "rtl" "ltr"))
        "absolute-css-px" prepared.measurement.value.width.bits height nodes.row)
