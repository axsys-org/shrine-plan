- goo_app/rex_boundary
- goo_app/results
- goo_app/codecs
- goo_app/read
- goo_app/passes
- goo_app/compile
- goo_app/measurement
- goo_app/ascii_api
- goo_app/layout_api
- goo_app/backend
- goo_app/production
- goo_app/views
- goo_app/display
- goo_app/html_api
- json
- rex

'  Public executable boundaries for native Goo passes and inspection.
+ goo_adapter
  + stage
    \ name=str status=str output=json diagnostics=row[json]
    ^ json
    = f goo_rex_boundary/field
      s goo_rex_boundary/text
    | json/obj [(f "name" (s name)) (f "status" (s status)) (f "output" output) (f "diagnostics" (json/arr diagnostics))]
  + diagnostic
    \ value=goo_result/diagnostic
    ^ json
    = f goo_rex_boundary/field
      s goo_rex_boundary/text
      severity=str
        ? value.severity
         > ./error "error"
         > ./warning "warning"
      location=json
        ? value.location
         > ./none jnull
         > (./some loc) (json/obj [(f "line" (goo_rex_boundary/number loc.line)) (f "column" (goo_rex_boundary/number loc.column))])
    | json/obj [(f "stage" (s "parse")) (f "severity" (s severity)) (f "location" location) (f "message" (s value.message))]
  + source
    \ trees=row[rex]
    ^ str
    = f goo_rex_boundary/field
      s goo_rex_boundary/text
      diagnostics (row/fold[rex row[goo_result/diagnostic]] [] (\ acc tree acc.weld((goo_result/rex_diagnostics tree))) trees)
      result (goo_result/pass/classify[row[rex]] trees diagnostics)
      ds diagnostics.map(goo_adapter/diagnostic)
      failed (goo_result/pass/failed[row[rex]] result)
      parsed (goo_adapter/stage "parse" (? failed "failed" "ok") (json/arr trees.map(goo_rex_boundary/node)) ds)
      remaining=row[str] ["read" "core" "normalized" "visible" "semantic" "metrics" "layout" "trace" "prepared" "html"]
      skipped remaining.map((\ name=str (goo_adapter/stage name "skipped" jnull [])))
    | show (json/obj [(f "version" (goo_rex_boundary/number 1)) (f "ok" (json/boo .true)) (f "outcome" (s (? failed "rejected" "incomplete"))) (f "stages" (json/arr skipped.cons(parsed)))])
  + accept
    \ trees=row[rex]
    ^ str
    | goo_rex_boundary/accept trees
  + capabilities
    \ ignored=unit
    ^ str
    = f goo_rex_boundary/field
      s goo_rex_boundary/text
    | show (json/obj [(f "version" (goo_rex_boundary/number 1)) (f "ok" (json/boo .true)) (f "package" (s "goo-foil")) (f "stages" (json/arr [(s "parse") (s "read") (s "core") (s "normalized") (s "visible") (s "semantic") (s "metrics") (s "layout") (s "trace") (s "prepared") (s "html")])) (f "complete" (json/boo .true))])
  + syntax
    '  The formatter uses the native Foil source parser, never the Goo parser.
    \ source=str
    ^ str
    ? (rex/parse source)
     > (./ok tree) (goo_rex_boundary/echo [tree])
     > (./err error)
      = f goo_rex_boundary/field
      | show (json/obj [(f "ok" (json/boo .false)) (f "error" (json/str "invalid Foil source"))])
  + codec
    \ source=str
    ^ str
    | goo_codec/run source
  + prepare
    \ trees=row[rex]
    ^ str
    | goo_compile/prepare trees
  + compile
    \ trees=row[rex] options=str ids=str
    ^ str
    | goo_backend/source trees options ids
  + measurement
    \ request=str
    ^ str
    | goo_measure/run request
  + ascii
    \ request=str
    ^ str
    | goo_ascii_api/run request
  + fonts
    \ ignored=unit
    ^ str
    | goo_ascii_api/fonts ignored

  + layout
    \ source=str
    ^ str
    | goo_layout_api/run source

  + fixture
    \ source=str
    ^ str
    | goo_backend/fixture source

  + render
    \ source=str
    ^ str
    | goo_html_api/run source

  + application
    \ trees=row[rex] options=str ids=str
    ^ str
    | goo_display/compile trees options ids

  + measured_display
    \ request=str
    ^ str
    | goo_display/measured request

  + view
    \ request=str
    ^ str
    | goo_views/run request

  + html_cli
    \ request=str
    ^ str
    | goo_html_api/cli request

  + production_start
    \ trees=row[rex] options=str ids=str
    ^ json
    | goo_production/start trees options ids
  + production_measured
    \ input=str
    ^ json
    | goo_production/start_measured input
  + production_request
    \ pending=json
    ^ str
    | goo_production/printer_request pending
  + production_finish
    \ pending=json replies=str
    ^ str
    | goo_production/finish pending replies
  + production_ssr
    \ trees=row[rex] options=str ids=str
    ^ row[str]
    | goo_production/ssr_wire trees options ids
  + production_layout
    \ input=str
    ^ str
    | goo_production/layout input
  + production_preview
    \ trees=row[rex] options=str ids=str
    ^ str
    | goo_production/preview trees options ids
