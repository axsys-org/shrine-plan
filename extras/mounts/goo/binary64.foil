- goo_app/numbers

' Finite binary64 arithmetic: exact rationals, rounded after each operation.
+ goo_fp
  + fault
    : message=str
  + ratio
    \ x=goo/scalar
    ^ goo_number/rational
    = negative (ge x.bits 9223372036854775808)
      magnitude (mod x.bits 9223372036854775808)
      exponent (div magnitude 4503599627370496)
      mantissa (add (mod magnitude 4503599627370496) (? (eq exponent 0) 0 4503599627370496))
    ? (ge exponent 1075) (goo_number/rational negative (lsh mantissa (sub exponent 1075)) 1)
    | goo_number/rational negative mantissa (lsh 1 (? (eq exponent 0) 1074 (sub 1075 exponent)))
  + rounded
    \ negative=bool numerator=nat denominator=nat
    ^ goo/scalar
    ? (goo_number/finite negative numerator denominator)
     > (./some value) value
    | Seq[goo/scalar] (error (goo_fp/fault "finite binary64 overflow")) (goo/scalar 0)
  + integer
    \ n=nat
    ^ goo/scalar
    | goo_fp/rounded .false n 1
  + negate
    \ x=goo/scalar
    ^ goo/scalar
    | goo/scalar (? (ge x.bits 9223372036854775808) (sub x.bits 9223372036854775808) (add x.bits 9223372036854775808))
  + plus
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    = a (goo_fp/ratio x)
      b (goo_fp/ratio y)
      left (mul a.numerator b.denominator)
      right (mul b.numerator a.denominator)
      denominator (mul a.denominator b.denominator)
    ? (eq a.negative b.negative) (goo_fp/rounded a.negative (add left right) denominator)
    ? (ge left right) (goo_fp/rounded (? (eq left right) .false a.negative) (sub left right) denominator)
    | goo_fp/rounded b.negative (sub right left) denominator
  + minus
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    | goo_fp/plus x (goo_fp/negate y)
  + times
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    = a (goo_fp/ratio x)
      b (goo_fp/ratio y)
    | goo_fp/rounded !(eq a.negative b.negative) (mul a.numerator b.numerator) (mul a.denominator b.denominator)
  + quotient
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    = a (goo_fp/ratio x)
      b (goo_fp/ratio y)
    ? (eq b.numerator 0) (Seq[goo/scalar] (error (goo_fp/fault "binary64 division by zero")) (goo/scalar 0))
    | goo_fp/rounded !(eq a.negative b.negative) (mul a.numerator b.denominator) (mul a.denominator b.numerator)
  + lte
    \ x=goo/scalar y=goo/scalar
    ^ bool
    = a (mod x.bits 9223372036854775808)
      b (mod y.bits 9223372036854775808)
      an (ge x.bits 9223372036854775808)
      bn (ge y.bits 9223372036854775808)
    ? !(!(eq a 0) || !(eq b 0)) .true
    ? !(eq an bn) an
    ? an (ge a b)
    | le a b
  + minimum
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    ? (goo_fp/lte x y) x y
  + maximum
    \ x=goo/scalar y=goo/scalar
    ^ goo/scalar
    ? (goo_fp/lte x y) y x
  + ceil
    ' Used only for nonnegative leaf preferred widths.
    \ x=goo/scalar
    ^ goo/scalar
    = r (goo_fp/ratio x)
    | goo_fp/integer (add (div r.numerator r.denominator) (? (eq (mod r.numerator r.denominator) 0) 0 1))
