- goo_app/codecs
- testing

+ goo_codec_tests
  + scalar_bits
    \ text=str
    ^ nat
    ? (goo_number/decode (json/real text))
     > ./none 18446744073709551616
     > (./some number) number.bits
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = bits goo_codec_tests/scalar_bits
    [(testing/nat "decimal tenth rounds to binary64" 4591870180066957722 (bits "0.1"))
     (testing/nat "minimum subnormal" 1 (bits "5e-324"))
     (testing/nat "underflow" 0 (bits "1e-400"))
     (testing/nat "overflow rejected" 18446744073709551616 (bits "1e309"))
     (testing/nat "malformed decimal rejected" 18446744073709551616 (bits "1.5.5"))
     (testing/nat "leading zero rejected" 18446744073709551616 (bits "01.5"))
     (testing/nat "missing exponent rejected" 18446744073709551616 (bits "1e"))
     (testing/nat "tie rounds down to even" 4607182418800017408 (bits "1.00000000000000011102230246251565404236316680908203125"))
     (testing/nat "above tie rounds up" 4607182418800017409 (bits "1.00000000000000011102230246251565404236316680908203126"))
     (testing/nat "large integer tie rounds to even" 4845873199050653696 (bits "9007199254740993"))
     (testing/nat "integer underflow remains fractional" 1 (equal[maybe[nat]] .none (goo_number/integer (json/real "1e-4000"))))
     (testing/nat "wire canonicalizes negative zero" 1 (equal[json] (json/num .false 0) (goo_number/encode (goo/scalar 9223372036854775808))))
     (testing/nat "scalar exact encode decode" 1 (equal[maybe[goo/scalar]] (./some (goo/scalar 4591870180066957722)) (goo_number/decode (goo_number/encode (goo/scalar 4591870180066957722)))))
     (testing/nat "finite negative config rejected" 1 (equal[maybe[goo/scalar]] .none (goo_number/nonnegative (json/real "-0.1"))))]
