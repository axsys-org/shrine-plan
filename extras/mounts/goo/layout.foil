- goo_app/ascii

' Native planner with injectable leaf callbacks and a request-local memo table.
+ goo_layout
  + metric
    : x=goo/scalar y=goo/scalar penalty=goo/scalar stretch=goo/scalar
  + metrics
    \ edge=goo/edge
    ^ goo_layout/metric
    = values=[nat nat nat nat]
        ? edge.bind
         > ./attached [4 2 500 0]
         > ./tight [8 4 100 0]
         > ./related [12 10 22 0]
         > ./normal [16 16 10 0]
         > ./loose [24 24 1 1]
         > ./separate [36 36 0 1]
    = [x y penalty stretch] values
    | goo_layout/metric (goo_fp/integer x) (goo_fp/integer y) (goo_fp/integer penalty) (goo_fp/integer stretch)
  + edge
    \ node=goo/semantic
    ^ goo/edge
    ? node.after
     > (./some edge) edge
    | Seq[goo/edge] (error (goo_fp/fault "missing emitted adjacency")) (goo/edge node.attrs.common.slot node.attrs.common.slot node.node_id node.node_id (goo/affinity/normal) .none (goo/edge_source/fallback) node.node_id node.attrs.common.slot)
  + round2
    \ width=goo/scalar
    ^ goo/scalar
    = rounded (goo_fp/ratio (goo_fp/plus (goo_fp/times width (goo_fp/integer 100)) (goo/scalar 4602678819172646912)))
      floor (div rounded.numerator rounded.denominator)
      magnitude (? rounded.negative (add floor (? (eq (mod rounded.numerator rounded.denominator) 0) 0 1)) floor)
    | goo_fp/quotient (goo_fp/rounded rounded.negative magnitude 1) (goo_fp/integer 100)
  + quantize
    \ width=goo/scalar
    ^ goo/scalar
    | goo_fp/maximum (goo_fp/integer 1) (goo_layout/round2 width)
  + valid
    \ value=goo/scalar
    ^ bool
    ? (goo/scalar/from_bits value.bits)
     > ./none .false
     > (./some _) (goo_fp/lte (goo/scalar 0) value)
  + total
    \ values=list[goo/scalar]
    ^ goo/scalar
    | list/fold[goo/scalar goo/scalar] (goo/scalar 0) goo_fp/plus values
  + largest
    \ values=list[goo/scalar]
    ^ goo/scalar
    | list/fold[goo/scalar goo/scalar] (goo/scalar 0) goo_fp/maximum values
  + summary
    \ sizes=list[goo_measure/named_size] node=goo/semantic
    ^ goo_measure/size
    ? sizes.is_nil (Seq[goo_measure/size] (error (goo_fp/fault "missing size summary")) (goo_measure/size (goo/scalar 0) (goo/scalar 0) .false))
    ? (eq sizes.head.id.text node.node_id.text) sizes.head.size
    | goo_layout/summary sizes.tail node
  + summaries
    \ leaf={\ goo/semantic}maybe[goo_measure/size] node=goo/semantic
    ^ maybe[list[goo_measure/named_size]]
    < groups (node.children.traverse_maybe((goo_layout/summaries leaf)))
    = descendants (groups.bind((\ children=list[goo_measure/named_size] children)))
    = pending_size=maybe[goo_measure/size]
        ? node
         > (goo/semantic/flow attrs direction children)
          = sizes children.map((goo_layout/summary descendants))
            lo (goo_layout/largest sizes.map((\ s=goo_measure/size s.min)))
            pref=goo/scalar
              ? direction
               > ./col (goo_layout/largest sizes.map((\ s=goo_measure/size s.pref)))
               > ./row (goo_fp/plus (goo_layout/total sizes.map((\ s=goo_measure/size s.pref))) (goo_layout/total children.take(children.len.dec).map((\ c=goo/semantic (goo_layout/metrics (goo_layout/edge c)).x))))
            grow=bool
              ? attrs.common.config.grow
               > (./some override) override
               > ./none (list/any[goo_measure/size] (\ s s.grow) sizes)
          | ./some (goo_measure/size lo pref grow)
        | leaf node
    < size pending_size
    ? !(goo_layout/valid size.min) .none
    ? !(goo_layout/valid size.pref) .none
    ? !(goo_fp/lte size.min size.pref) .none
    | ./some descendants.snoc((goo_measure/named_size node.node_id size))
  + context
    : sizes=list[goo_measure/named_size] height={\ goo/semantic goo/scalar}maybe[goo/scalar]
  + planned
    : plan=goo_measure/plan cache=list[goo_measure/plan]
  + suffix
    : cost=goo/scalar rows=list[goo_measure/plan_row]
  + candidate
    : suffix=goo_layout/suffix cache=list[goo_measure/plan]
  + planned_children
    : plans=list[goo_measure/plan] cache=list[goo_measure/plan]
  + children
    \ context=goo_layout/context nodes=list[goo/semantic] widths=list[goo/scalar] cache=list[goo_measure/plan]
    ^ maybe[goo_layout/planned_children]
    % rest=list[goo/semantic] nodes allocations=list[goo/scalar] widths out=list[goo_measure/plan] .nil memo=list[goo_measure/plan] cache
    ^ maybe[goo_layout/planned_children]
    ? rest.is_nil (./some (goo_layout/planned_children out.reverse memo))
    < child (goo_layout/node context rest.head allocations.head memo)
    | _ rest.tail allocations.tail out.cons(child.plan) child.cache
  + flow_candidate
    \ context=goo_layout/context selected=list[goo/semantic] width=goo/scalar start=nat end=nat count=nat tail=goo_layout/suffix cache=list[goo_measure/plan]
    ^ maybe[goo_layout/candidate]
    = edges selected.take(selected.len.dec).map((\ n=goo/semantic (goo_layout/metrics (goo_layout/edge n))))
      sizes selected.map((goo_layout/summary context.sizes))
      available (goo_fp/minus width (goo_layout/total edges.map((\ e=goo_layout/metric e.x))))
      pref (goo_layout/total sizes.map((\ s=goo_measure/size s.pref)))
      lo (goo_layout/total sizes.map((\ s=goo_measure/size s.min)))
      feasible (goo_fp/lte lo (goo_fp/plus available (goo/scalar 4587366580439587226)))
    ? !feasible
      ? !(eq end start.inc) .none
      | goo_layout/finish_candidate context selected edges (list/one width) (goo_fp/integer 128) (goo/scalar 0) start end count tail cache
    = widths=list[goo/scalar]
        ? (goo_fp/lte pref available) sizes.map((\ s=goo_measure/size s.pref))
        | sizes.map((\ s=goo_measure/size (goo_fp/minus s.pref (goo_fp/quotient (goo_fp/times (goo_fp/minus pref available) (goo_fp/minus s.pref s.min)) (goo_fp/maximum (goo_fp/integer 1) (goo_fp/minus pref lo))))))
      compression=goo/scalar
        ? (goo_fp/lte pref available) (goo/scalar 0)
        % rest=list[goo_measure/size] sizes remaining=list[goo/scalar] widths cost=goo/scalar (goo/scalar 0)
        ^ goo/scalar
        ? rest.is_nil cost
        = s rest.head
          ratio (goo_fp/quotient (goo_fp/minus s.pref remaining.head) (goo_fp/maximum (goo_fp/integer 1) (goo_fp/minus s.pref s.min)))
        | _ rest.tail remaining.tail (goo_fp/plus cost (goo_fp/times (goo_fp/integer 32) (goo_fp/times ratio ratio)))
      spare (goo_fp/maximum (goo/scalar 0) (goo_fp/minus available pref))
    | goo_layout/finish_candidate context selected edges widths compression spare start end count tail cache
  + finish_candidate
    \ context=goo_layout/context selected=list[goo/semantic] edges=list[goo_layout/metric] widths=list[goo/scalar] compression=goo/scalar spare=goo/scalar start=nat end=nat count=nat tail=goo_layout/suffix cache=list[goo_measure/plan]
    ^ maybe[goo_layout/candidate]
    < children (goo_layout/children context selected widths cache)
    = elasticity (goo_layout/total edges.map((\ e=goo_layout/metric e.stretch)))
      gaps edges.map((\ e=goo_layout/metric (goo_fp/plus e.x (? (goo_fp/lte elasticity (goo/scalar 0)) (goo/scalar 0) (goo_fp/quotient (goo_fp/times spare e.stretch) elasticity)))))
      height (goo_layout/largest children.plans.map((\ p=goo_measure/plan p.height)))
      row (goo_measure/plan_row start end children.plans (goo/scalar 0) height (./some gaps))
      nested (goo_layout/total children.plans.map((\ p=goo_measure/plan p.cost)))
      cut (? (eq end count) (goo/scalar 0) (goo_layout/metrics (goo_layout/edge selected.at(selected.len.dec))).penalty)
      cost (goo_fp/plus (goo_fp/plus (goo_fp/plus (goo_fp/plus (goo_fp/integer 24) compression) nested) cut) tail.cost)
    | ./some (goo_layout/candidate (goo_layout/suffix cost tail.rows.cons(row)) children.cache)
  + flow
    \ context=goo_layout/context node=goo/semantic width=goo/scalar cache=list[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    = nodes node.children
      count nodes.len
    = pending_answer=maybe[goo_layout/candidate]
        % before=list[goo/semantic] nodes.reverse suffix=list[goo/semantic] .nil left=nat count dp=list[goo_layout/suffix] (list/one (goo_layout/suffix (goo/scalar 0) .nil)) memo=list[goo_measure/plan] cache
        ^ maybe[goo_layout/candidate]
        ? before.is_nil (./some (goo_layout/candidate dp.head memo))
        = start left.dec
          suffix suffix.cons(before.head)
        = pending_best=maybe[goo_layout/candidate]
            % end=nat left tails=list[goo_layout/suffix] dp chosen=maybe[goo_layout/suffix] .none state=list[goo_measure/plan] memo
            ^ maybe[goo_layout/candidate]
            ? tails.is_nil
              < value chosen
              | ./some (goo_layout/candidate value state)
            = selected suffix.take((sub end start))
              edges selected.take(selected.len.dec).map((\ n=goo/semantic (goo_layout/metrics (goo_layout/edge n)).x))
              lo (goo_layout/total selected.map((\ n=goo/semantic (goo_layout/summary context.sizes n).min)))
              available (goo_fp/minus width (goo_layout/total edges))
            ? !((eq end start.inc) || (goo_fp/lte lo (goo_fp/plus available (goo/scalar 4587366580439587226)))) (_ end.inc tails.tail chosen state)
            < candidate (goo_layout/flow_candidate context selected width start end count tails.head state)
            = better=bool
                ? chosen
                 > ./none .true
                 > (./some prior) !(goo_fp/lte (goo_fp/minus prior.cost (goo/scalar 4517329193108106637)) candidate.suffix.cost)
            | _ end.inc tails.tail (? better (./some candidate.suffix) chosen) candidate.cache
        < best pending_best
        | _ before.tail suffix start dp.cons(best.suffix) best.cache
    < answer pending_answer
    = rows (goo_layout/row_gaps answer.suffix.rows nodes (goo/scalar 0))
      height (goo_layout/total rows.map((\ r=goo_measure/plan_row (goo_fp/plus r.height r.gap))))
    | ./some (goo_layout/planned (goo_measure/plan node.node_id width height answer.suffix.cost (./some rows)) answer.cache)
  + row_gaps
    \ rows=list[goo_measure/plan_row] nodes=list[goo/semantic] gap=goo/scalar
    ^ list[goo_measure/plan_row]
    ? rows.is_nil .nil
    = row rows.head
      count (sub row.end row.start)
      next_gap (? rows.tail.is_nil (goo/scalar 0) (goo_layout/metrics (goo_layout/edge nodes.drop(count.dec).head)).y)
    | (goo_layout/row_gaps rows.tail nodes.drop(count) next_gap).cons(row.set_gap(gap))
  + stack
    \ context=goo_layout/context node=goo/semantic width=goo/scalar cache=list[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    % rest=list[goo/semantic] node.children i=nat 0 rows=list[goo_measure/plan_row] .nil memo=list[goo_measure/plan] cache gap=goo/scalar (goo/scalar 0)
    ^ maybe[goo_layout/planned]
    ? rest.is_nil
      = rows rows.reverse
        height (goo_layout/total rows.map((\ r=goo_measure/plan_row (goo_fp/plus r.height r.gap))))
        cost (goo_layout/total rows.map((\ r=goo_measure/plan_row r.children.head.cost)))
      | ./some (goo_layout/planned (goo_measure/plan node.node_id width height cost (./some rows)) memo)
    = child rest.head
      size (goo_layout/summary context.sizes child)
      allocation (? size.grow width (goo_fp/minimum width size.pref))
    < result (goo_layout/node context child allocation memo)
    = next_gap (? rest.tail.is_nil (goo/scalar 0) (goo_layout/metrics (goo_layout/edge child)).y)
    | _ rest.tail i.inc rows.cons((goo_measure/plan_row i i.inc (list/one result.plan) gap result.plan.height .none)) result.cache next_gap
  + node
    \ context=goo_layout/context node=goo/semantic raw_width=goo/scalar cache=list[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    = width (goo_layout/quantize raw_width)
      cached (list/filter[goo_measure/plan] (\ p !(!(eq p.id.text node.node_id.text) || !(eq p.width.bits width.bits))) cache)
    ? !(eq cached.len 0) (./some (goo_layout/planned cached.at(0) cache))
    = pending_result=maybe[goo_layout/planned]
        ? node
         > (goo/semantic/flow _ direction _)
          ? direction
           > ./row (goo_layout/flow context node width cache)
           > ./col (goo_layout/stack context node width cache)
        < height (context.height node width)
        ? !(goo_layout/valid height) .none
        | ./some (goo_layout/planned (goo_measure/plan node.node_id width height (goo/scalar 0) .none) cache)
    < result pending_result
    | ./some (goo_layout/planned result.plan result.cache.cons(result.plan))
  + traces
    \ node=goo/semantic plan=goo_measure/plan
    ^ list[goo_measure/trace]
    ? plan.rows
     > ./none .nil
     > (./some rows)
      = own=list[goo_measure/trace]
          % rest=list[goo/semantic] node.children remaining=list[goo_measure/plan_row] rows gaps=list[goo/scalar] rows.head.gaps.fall((list/nil[goo/scalar])) i=nat 0 out=list[goo_measure/trace] .nil
          ^ list[goo_measure/trace]
          ? rest.tail.is_nil out.reverse
          = edge (goo_layout/edge rest.head)
            metric (goo_layout/metrics edge)
            broken (ge i.inc remaining.head.end)
            gap (? broken metric.y (? gaps.is_nil (goo/scalar 0) gaps.head))
            cut=bool
              ? node
               > (goo/semantic/flow _ direction _)
                ? direction
                 > ./row broken
                 > ./col .false
              .false
            next (? broken remaining.tail remaining)
            next_gaps (? broken next.head.gaps.fall((list/nil[goo/scalar])) gaps.tail)
          | _ rest.tail next next_gaps i.inc out.cons((goo_measure/trace edge metric.x metric.y metric.stretch metric.penalty (? broken metric.y metric.x) (goo_layout/round2 gap) (? broken (goo_measure/axis/y) (goo_measure/axis/x)) cut))
        children rows.bind((\ row=goo_measure/plan_row row.children))
        nested
          % nodes=list[goo/semantic] node.children plans=list[goo_measure/plan] children
          ^ list[goo_measure/trace]
          ? plans.is_nil .nil
          | (goo_layout/traces nodes.head plans.head).weld((_ nodes.tail plans.tail))
      | own.weld(nested)
  + plan_with
    \ size={\ goo/semantic}maybe[goo_measure/size] height={\ goo/semantic goo/scalar}maybe[goo/scalar] tree=maybe[goo/semantic] width=goo/scalar
    ^ maybe[goo_measure/result]
    ? !(goo_layout/valid width) .none
    ? tree
     > ./none (goo_measure/make (goo_measure/raw .none (goo_layout/quantize width) .nil .none .nil))
     > (./some node)
      ? !(goo_codec/validate_semantic node) .none
      < sizes (goo_layout/summaries size node)
      < result (goo_layout/node (goo_layout/context sizes height) node width .nil)
      | goo_measure/make (goo_measure/raw tree (goo_layout/quantize width) sizes (./some result.plan) (goo_layout/traces node result.plan))
