- goo_app/ascii

' Native planner with injectable leaf callbacks and a request-local memo table.
+ goo_layout
  + metric
    : x=goo/scalar y=goo/scalar penalty=goo/scalar stretch=goo/scalar
  + metrics
    \ edge=goo/edge
    ^ goo_layout/metric
    = values=row[nat]
        ? edge.bind
         > ./attached [4 2 500 0]
         > ./tight [8 4 100 0]
         > ./related [12 10 22 0]
         > ./normal [16 16 10 0]
         > ./loose [24 24 1 1]
         > ./separate [36 36 0 1]
    | goo_layout/metric (goo_fp/integer values.at(0)) (goo_fp/integer values.at(1)) (goo_fp/integer values.at(2)) (goo_fp/integer values.at(3))
  + edge
    \ node=goo/semantic
    ^ goo/edge
    ? node.after
     > (./some edge) edge
    | Seq[goo/edge] (error (goo_fp/fault "missing emitted adjacency")) (goo/edge node.attrs.common.slot node.attrs.common.slot node.node_id node.node_id (goo/affinity/normal) .none (goo/edge_source/fallback) node.node_id node.attrs.common.slot)
  + round2
    \ width=goo/scalar
    ^ goo/scalar
    = rounded (goo_fp/ratio (goo_fp/plus (goo_fp/times width (goo_fp/integer 100)) (goo/scalar 4602678819172646912)))
      floor (div rounded.numerator rounded.denominator)
      magnitude (? rounded.negative (add floor (? (eq (mod rounded.numerator rounded.denominator) 0) 0 1)) floor)
    | goo_fp/quotient (goo_fp/rounded rounded.negative magnitude 1) (goo_fp/integer 100)
  + quantize
    \ width=goo/scalar
    ^ goo/scalar
    | goo_fp/maximum (goo_fp/integer 1) (goo_layout/round2 width)
  + valid
    \ value=goo/scalar
    ^ bool
    ? (goo/scalar/from_bits value.bits)
     > ./none .false
     > (./some _) (goo_fp/lte (goo/scalar 0) value)
  + total
    \ values=row[goo/scalar]
    ^ goo/scalar
    | row/fold[goo/scalar goo/scalar] (goo/scalar 0) goo_fp/plus values
  + largest
    \ values=row[goo/scalar]
    ^ goo/scalar
    | row/fold[goo/scalar goo/scalar] (goo/scalar 0) goo_fp/maximum values
  + summary
    \ sizes=row[goo_measure/named_size] node=goo/semantic
    ^ goo_measure/size
    % i=nat 0
    ^ goo_measure/size
    ? (eq i sizes.len) (Seq[goo_measure/size] (error (goo_fp/fault "missing size summary")) (goo_measure/size (goo/scalar 0) (goo/scalar 0) .false))
    ? (eq sizes.at(i).id.text node.node_id.text) sizes.at(i).size
    | _ i.inc
  + summaries
    \ leaf={\ goo/semantic}maybe[goo_measure/size] node=goo/semantic
    ^ maybe[row[goo_measure/named_size]]
    = pending_descendants=maybe[row[goo_measure/named_size]]
        % i=nat 0 out=row[goo_measure/named_size] []
        ^ maybe[row[goo_measure/named_size]]
        ? (eq i node.children.len) (./some out)
        < child (goo_layout/summaries leaf node.children.at(i))
        | _ i.inc out.weld(child)
    < descendants pending_descendants
    = pending_size=maybe[goo_measure/size]
        ? node
         > (goo/semantic/flow attrs direction children)
          = sizes children.map((goo_layout/summary descendants))
            lo (goo_layout/largest sizes.map((\ s=goo_measure/size s.min)))
            pref=goo/scalar
              ? direction
               > ./col (goo_layout/largest sizes.map((\ s=goo_measure/size s.pref)))
               > ./row (goo_fp/plus (goo_layout/total sizes.map((\ s=goo_measure/size s.pref))) (goo_layout/total children.take(children.len.dec).map((\ c=goo/semantic (goo_layout/metrics (goo_layout/edge c)).x))))
            grow=bool
              ? attrs.common.config.grow
               > (./some override) override
               > ./none (row/any[goo_measure/size] (\ s s.grow) sizes)
          | ./some (goo_measure/size lo pref grow)
        | leaf node
    < size pending_size
    ? !(goo_layout/valid size.min) .none
    ? !(goo_layout/valid size.pref) .none
    ? !(goo_fp/lte size.min size.pref) .none
    | ./some descendants.snoc((goo_measure/named_size node.node_id size))
  + context
    : sizes=row[goo_measure/named_size] height={\ goo/semantic goo/scalar}maybe[goo/scalar]
  + planned
    : plan=goo_measure/plan cache=row[goo_measure/plan]
  + suffix
    : cost=goo/scalar rows=row[goo_measure/plan_row]
  + candidate
    : suffix=goo_layout/suffix cache=row[goo_measure/plan]
  + planned_children
    : plans=row[goo_measure/plan] cache=row[goo_measure/plan]
  + children
    \ context=goo_layout/context nodes=row[goo/semantic] widths=row[goo/scalar] cache=row[goo_measure/plan]
    ^ maybe[goo_layout/planned_children]
    % i=nat 0 out=row[goo_measure/plan] [] memo=row[goo_measure/plan] cache
    ^ maybe[goo_layout/planned_children]
    ? (eq i nodes.len) (./some (goo_layout/planned_children out memo))
    < child (goo_layout/node context nodes.at(i) widths.at(i) memo)
    | _ i.inc out.snoc(child.plan) child.cache
  + flow_candidate
    \ context=goo_layout/context nodes=row[goo/semantic] width=goo/scalar start=nat end=nat tail=goo_layout/suffix cache=row[goo_measure/plan]
    ^ maybe[goo_layout/candidate]
    = selected nodes.drop(start).take((sub end start))
      edges selected.take(selected.len.dec).map((\ n=goo/semantic (goo_layout/metrics (goo_layout/edge n))))
      sizes selected.map((goo_layout/summary context.sizes))
      available (goo_fp/minus width (goo_layout/total edges.map((\ e=goo_layout/metric e.x))))
      pref (goo_layout/total sizes.map((\ s=goo_measure/size s.pref)))
      lo (goo_layout/total sizes.map((\ s=goo_measure/size s.min)))
      feasible (goo_fp/lte lo (goo_fp/plus available (goo/scalar 4587366580439587226)))
    ? !feasible
      ? !(eq end start.inc) .none
      | goo_layout/finish_candidate context selected edges [width] (goo_fp/integer 128) (goo/scalar 0) start end nodes.len tail cache
    = widths=row[goo/scalar]
        ? (goo_fp/lte pref available) sizes.map((\ s=goo_measure/size s.pref))
        | sizes.map((\ s=goo_measure/size (goo_fp/minus s.pref (goo_fp/quotient (goo_fp/times (goo_fp/minus pref available) (goo_fp/minus s.pref s.min)) (goo_fp/maximum (goo_fp/integer 1) (goo_fp/minus pref lo))))))
      compression=goo/scalar
        ? (goo_fp/lte pref available) (goo/scalar 0)
        % i=nat 0 cost=goo/scalar (goo/scalar 0)
        ^ goo/scalar
        ? (eq i sizes.len) cost
        = s sizes.at(i)
          ratio (goo_fp/quotient (goo_fp/minus s.pref widths.at(i)) (goo_fp/maximum (goo_fp/integer 1) (goo_fp/minus s.pref s.min)))
        | _ i.inc (goo_fp/plus cost (goo_fp/times (goo_fp/integer 32) (goo_fp/times ratio ratio)))
      spare (goo_fp/maximum (goo/scalar 0) (goo_fp/minus available pref))
    | goo_layout/finish_candidate context selected edges widths compression spare start end nodes.len tail cache
  + finish_candidate
    \ context=goo_layout/context selected=row[goo/semantic] edges=row[goo_layout/metric] widths=row[goo/scalar] compression=goo/scalar spare=goo/scalar start=nat end=nat count=nat tail=goo_layout/suffix cache=row[goo_measure/plan]
    ^ maybe[goo_layout/candidate]
    < children (goo_layout/children context selected widths cache)
    = elasticity (goo_layout/total edges.map((\ e=goo_layout/metric e.stretch)))
      gaps edges.map((\ e=goo_layout/metric (goo_fp/plus e.x (? (goo_fp/lte elasticity (goo/scalar 0)) (goo/scalar 0) (goo_fp/quotient (goo_fp/times spare e.stretch) elasticity)))))
      height (goo_layout/largest children.plans.map((\ p=goo_measure/plan p.height)))
      row (goo_measure/plan_row start end children.plans (goo/scalar 0) height (./some gaps))
      nested (goo_layout/total children.plans.map((\ p=goo_measure/plan p.cost)))
      cut (? (eq end count) (goo/scalar 0) (goo_layout/metrics (goo_layout/edge selected.at(selected.len.dec))).penalty)
      cost (goo_fp/plus (goo_fp/plus (goo_fp/plus (goo_fp/plus (goo_fp/integer 24) compression) nested) cut) tail.cost)
    | ./some (goo_layout/candidate (goo_layout/suffix cost tail.rows.cons(row)) children.cache)
  + flow
    \ context=goo_layout/context node=goo/semantic width=goo/scalar cache=row[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    = nodes node.children
    = pending_answer=maybe[goo_layout/candidate]
        % left=nat nodes.len dp=row[goo_layout/suffix] [(goo_layout/suffix (goo/scalar 0) [])] memo=row[goo_measure/plan] cache
        ^ maybe[goo_layout/candidate]
        ? (eq left 0) (./some (goo_layout/candidate dp.at(0) memo))
        = start left.dec
        = pending_best=maybe[goo_layout/candidate]
            % end=nat left chosen=maybe[goo_layout/suffix] .none state=row[goo_measure/plan] memo
            ^ maybe[goo_layout/candidate]
            ? (gt end nodes.len)
              < value chosen
              | ./some (goo_layout/candidate value state)
            = selected nodes.drop(start).take((sub end start))
              edges selected.take(selected.len.dec).map((\ n=goo/semantic (goo_layout/metrics (goo_layout/edge n)).x))
              lo (goo_layout/total selected.map((\ n=goo/semantic (goo_layout/summary context.sizes n).min)))
              available (goo_fp/minus width (goo_layout/total edges))
            ? !((eq end start.inc) || (goo_fp/lte lo (goo_fp/plus available (goo/scalar 4587366580439587226)))) (_ end.inc chosen state)
            < candidate (goo_layout/flow_candidate context nodes width start end dp.at((sub end left)) state)
            = better=bool
                ? chosen
                 > ./none .true
                 > (./some prior) !(goo_fp/lte (goo_fp/minus prior.cost (goo/scalar 4517329193108106637)) candidate.suffix.cost)
            | _ end.inc (? better (./some candidate.suffix) chosen) candidate.cache
        < best pending_best
        | _ start dp.cons(best.suffix) best.cache
    < answer pending_answer
    = rows answer.suffix.rows.map((\ r=goo_measure/plan_row (goo_measure/plan_row r.start r.end r.children (? (eq r.start 0) (goo/scalar 0) (goo_layout/metrics (goo_layout/edge nodes.at(r.start.dec))).y) r.height r.gaps)))
      height (goo_layout/total rows.map((\ r=goo_measure/plan_row (goo_fp/plus r.height r.gap))))
    | ./some (goo_layout/planned (goo_measure/plan node.node_id width height answer.suffix.cost (./some rows)) answer.cache)
  + stack
    \ context=goo_layout/context node=goo/semantic width=goo/scalar cache=row[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    % i=nat 0 rows=row[goo_measure/plan_row] [] memo=row[goo_measure/plan] cache
    ^ maybe[goo_layout/planned]
    ? (eq i node.children.len)
      = height (goo_layout/total rows.map((\ r=goo_measure/plan_row (goo_fp/plus r.height r.gap))))
        cost (goo_layout/total rows.map((\ r=goo_measure/plan_row r.children.at(0).cost)))
      | ./some (goo_layout/planned (goo_measure/plan node.node_id width height cost (./some rows)) memo)
    = child node.children.at(i)
      size (goo_layout/summary context.sizes child)
      allocation (? size.grow width (goo_fp/minimum width size.pref))
    < result (goo_layout/node context child allocation memo)
    = gap (? (eq i 0) (goo/scalar 0) (goo_layout/metrics (goo_layout/edge node.children.at(i.dec))).y)
    | _ i.inc rows.snoc((goo_measure/plan_row i i.inc [result.plan] gap result.plan.height .none)) result.cache
  + node
    \ context=goo_layout/context node=goo/semantic raw_width=goo/scalar cache=row[goo_measure/plan]
    ^ maybe[goo_layout/planned]
    = width (goo_layout/quantize raw_width)
      cached (row/filter[goo_measure/plan] (\ p !(!(eq p.id.text node.node_id.text) || !(eq p.width.bits width.bits))) cache)
    ? !(eq cached.len 0) (./some (goo_layout/planned cached.at(0) cache))
    = pending_result=maybe[goo_layout/planned]
        ? node
         > (goo/semantic/flow _ direction _)
          ? direction
           > ./row (goo_layout/flow context node width cache)
           > ./col (goo_layout/stack context node width cache)
        < height (context.height node width)
        ? !(goo_layout/valid height) .none
        | ./some (goo_layout/planned (goo_measure/plan node.node_id width height (goo/scalar 0) .none) cache)
    < result pending_result
    | ./some (goo_layout/planned result.plan result.cache.snoc(result.plan))
  + row_index
    \ rows=row[goo_measure/plan_row] index=nat
    ^ nat
    % i=nat 0
    ^ nat
    ? (ge index rows.at(i).end) (_ i.inc)
    i
  + traces
    \ node=goo/semantic plan=goo_measure/plan
    ^ row[goo_measure/trace]
    ? plan.rows
     > ./none []
     > (./some rows)
      = own=row[goo_measure/trace]
          % i=nat 0 out=row[goo_measure/trace] []
          ^ row[goo_measure/trace]
          ? (ge i node.children.len.dec) out
          = edge (goo_layout/edge node.children.at(i))
            metric (goo_layout/metrics edge)
            left (goo_layout/row_index rows i)
            right (goo_layout/row_index rows i.inc)
            broken !(eq left right)
            row rows.at(left)
            gap=goo/scalar
              ? broken metric.y
              ? row.gaps
               > (./some gaps) gaps.at((sub i row.start))
               > ./none (goo/scalar 0)
            cut=bool
              ? node
               > (goo/semantic/flow _ direction _)
                ? direction
                 > ./row broken
                 > ./col .false
              .false
          | _ i.inc out.snoc((goo_measure/trace edge metric.x metric.y metric.stretch metric.penalty (? broken metric.y metric.x) (goo_layout/round2 gap) (? broken (goo_measure/axis/y) (goo_measure/axis/x)) cut))
        children (row/fold[goo_measure/plan_row row[goo_measure/plan]] [] (\ acc r acc.weld(r.children)) rows)
      % i=nat 0 out=row[goo_measure/trace] own
      ^ row[goo_measure/trace]
      ? (eq i children.len) out
      | _ i.inc out.weld((goo_layout/traces node.children.at(i) children.at(i)))
  + plan_with
    \ size={\ goo/semantic}maybe[goo_measure/size] height={\ goo/semantic goo/scalar}maybe[goo/scalar] tree=maybe[goo/semantic] width=goo/scalar
    ^ maybe[goo_measure/result]
    ? !(goo_layout/valid width) .none
    ? tree
     > ./none (goo_measure/make (goo_measure/raw .none (goo_layout/quantize width) [] .none []))
     > (./some node)
      ? !(goo_codec/validate_semantic node) .none
      < sizes (goo_layout/summaries size node)
      < result (goo_layout/node (goo_layout/context sizes height) node width [])
      | goo_measure/make (goo_measure/raw tree (goo_layout/quantize width) sizes (./some result.plan) (goo_layout/traces node result.plan))
