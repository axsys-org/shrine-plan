#!/usr/bin/env python3
import pathlib,sys
sys.path.insert(0,str(pathlib.Path(__file__).resolve().parents[1]/'host'))
from runtime import Cancelled, cancel_signal
import signal
signal.signal(signal.SIGTERM,cancel_signal)
try:
    command=sys.argv.pop(1) if len(sys.argv)>1 else 'serve'
    if command in {'serve','passes','html'}:
        from application import main
        main([command,*sys.argv[1:]])
    elif command=='adapter':
        from adapter import main
        main()
    elif command=='build':
        from runtime import build
        print(build())
    elif command=='test':
        from checks import main
        main()
    elif command=='test-gate':
        from gate_checks import check_gate
        from measurement_checks import check_measurements
        check_gate()
        check_measurements()
    elif command=='test-metrics':
        from ascii_checks import check_ascii
        check_ascii()
    elif command=='test-layout':
        from layout_checks import check_layout
        check_layout()
    elif command=='test-html':
        from html_checks import check_html
        check_html()
    elif command=='test-types':
        import json
        from type_checks import check_types
        print(json.dumps(check_types(),indent=2))
    elif command=='fmt':
        from formatter import main
        main()
    else:
        from application import main
        main([command,*sys.argv[1:]])
except KeyboardInterrupt:
    raise SystemExit(130)
except Cancelled as cancelled:
    raise SystemExit(128+cancelled.signum)
