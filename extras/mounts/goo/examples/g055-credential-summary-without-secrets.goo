') G055. Credential summary without secrets — from examples/domain.json
(col(%content) {
   text("Build agent" , %title)
   text("active" , %status)
   row(%field) {
     text("Fingerprint" , %label)
     text("SHA256:3fea…80b2" , %value)
     button("Copy" , %action/copy)
   }
   col(%badge) {
     text("read:repo" , %badge)
     text("write:artifacts" , %badge)
   }
   row({[optional] : 1} , %field) {
     text("Created" , %label)
     text("2026-08-01" , %value)
   }
   row({[optional] : 2} , %field) {
     text("Expires" , %label)
     text("2026-12-01" , %value)
   }
   row({[optional] : 2} , %field) {
     text("Last used" , %label)
     text("2026-09-18T13:00:00Z" , %value)
   }
 })
