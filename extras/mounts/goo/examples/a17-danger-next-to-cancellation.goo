') A17. Danger next to cancellation — from goo-adversarial-cases.md
(col(%content) {
   row(%actions) {
     button("Save" , %action)
     button("Export" , %action)
   }
   col(%danger-zone) {
     row(%actions) {
       button("Cancel" , %action/cancel)
       button("Remove" , %action/destructive)
     }
   }
   row(%actions) {
     button("Back" , %action)
   }
 })
