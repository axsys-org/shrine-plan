') Namespace inspector — from goo-reimplementation/examples.json
(col(%inspector) {
   row(%header) {
     text("◇" , %icon)
     text("/projects/aurora" , %title)
   }
   col(%content) {
     col(%field) {
       text("Reachable closure" , %label)
       row({[grow] : 0} , %value) {
         text("128" , %value)
         text("KiB" , %unit)
         text( { [optionLabel] : "value qualifier"
               , [optional] : 1
               }
             , "reachable"
             , %qualifier
             )
         text("pinned" , %status)
       }
       text( { [optionLabel] : "provenance"
             , [optional] : 2
             }
           , "computed at /sys/index/closure"
           , %provenance
           )
     }
     col(%field) {
       text("Root hash" , %label)
       row(%value) {
         text( {[maxIdeal] : 205}
             , "a04b7f92…d8e1"
             , %value
             )
         button("Copy" , %action/copy)
       }
     }
     col(%field) {
       text("Inspection result" , %label)
       code("pin-count: 12
             root: committed" , %code)
       text( { [optionLabel] : "evaluation output"
             , [optional] : 1
             }
           , "ok · 12 reachable pins"
           , %output
           )
       text("0 dangling references" , %diagnostic)
     }
   }
   row({[grow] : 0} , %actions) {
     button( {[primary] : true}
           , "Open root"
           , %action
           )
     button( { [optionLabel] : "history action"
             , [optional] : 2
             }
           , "History"
           , %action
           )
   }
   col( { [optionLabel] : "danger zone"
        , [optional] : 2
        }
      , %danger-zone
      ) {
     text("Destructive operations" , %label)
     button("Remove root" , %action/destructive)
   }
 })
