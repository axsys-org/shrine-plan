') Person — from goo-reimplementation/examples.json
(row(%person) {
   row({[grow] : 0} , %avatar) {
     avatar("MC" , %avatar)
     presence( { [optionLabel] : "presence dot"
               , [optional] : 1
               }
             , ""
             , %presence
             )
   }
   col({[grow] : 1} , %identity) {
     text("Mara Chen" , %title)
     text( { [optionLabel] : "subtitle"
           , [optional] : 1
           }
         , "Staff engineer · Systems"
         , %subtitle
         )
     text( { [optionLabel] : "availability"
           , [optional] : 1
           }
         , "Available"
         , %status
         )
     text( { [optionLabel] : "metadata"
           , [optional] : 2
           }
         , "Platform team · Austin"
         , %metadata
         )
   }
   row({[grow] : 0} , %actions) {
     button( {[primary] : true}
           , "Message"
           , %action
           )
     button( { [optionLabel] : "secondary action"
             , [optional] : 2
             }
           , "Call"
           , %action
           )
   }
 })
