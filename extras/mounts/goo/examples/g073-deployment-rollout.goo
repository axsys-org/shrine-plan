') G073. Deployment rollout — from examples/domain.json
(col(%content) {
   col(%identity) {
     row(%title) {
       text("indexer" , %title)
       text("degraded" , %status)
     }
     text("staging" , %badge)
     text({[optional] : 1} , "0.8.4" , %metadata)
     text( {[optional] : 2}
         , "Maintains namespace search indexes."
         , %summary
         )
   }
   row(%field) {
     text("Build" , %label)
     text("0.8.4" , %value)
   }
   row(%field) {
     text("Target" , %label)
     text("staging" , %value)
   }
   text("rolling-out" , %status)
   bar( {[max] : 3 , [value] : 2}
      , "2 / 3"
      , %progress
      )
   col(%collection) {
     row(%field) {
       text("worker-a" , %label)
       text("ready" , %status)
     }
     row(%field) {
       text("worker-b" , %label)
       text("ready" , %status)
     }
     row(%field) {
       text("worker-c" , %label)
       text("updating" , %status)
     }
   }
 })
