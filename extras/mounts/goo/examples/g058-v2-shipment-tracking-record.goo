') G058. Shipment tracking record — delivered — from examples/domain.json
(col(%content) {
   text("Fixture Parcel" , %title)
   text("delivered" , %status)
   row(%field) {
     text("Tracking" , %label)
     text("GH-7294-4810" , %value)
     button("Copy" , %action/copy)
   }
   row(%field) {
     text("Origin" , %label)
     text("Assembly studio" , %value)
   }
   col(%field) {
     text("Receiving studio" , %label)
