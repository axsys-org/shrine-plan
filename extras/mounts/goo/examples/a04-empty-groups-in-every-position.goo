') A04. Empty groups in every position — from goo-adversarial-cases.md
(col(%content) {
   col(%header) {
     text({[optional] : 1} , "Gone" , %title)
   }
   text("Survivor" , %title)
   col(%metadata) {
     text({[optional] : 1} , "Gone" , %metadata)
   }
   text("Still here" , %body)
   col(%footer) {
     text({[optional] : 1} , "Gone" , %metadata)
   }
 })
