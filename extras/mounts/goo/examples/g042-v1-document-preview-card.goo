') G042. Document preview card — no thumbnail — from examples/domain.json
(row(%content) {
   col(%identity) {
     text("Shrine field notes" , %title)
     text("draft" , %status)
     row({[optional] : 1} , %metadata) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
     text({[optional] : 2} , "12" , %badge)
     text( {[optional] : 2}
