') Access form — from goo-reimplementation/examples.json
(col(%form) {
   col(%header) {
     text("Project access" , %title)
     text( { [optionLabel] : "introductory summary"
           , [optional] : 2
           }
         , "Invite a teammate and choose what they can change."
         , %summary
         )
   }
   col(%content) {
     col(%field) {
       text("Email address" , %label)
       text( { [optionLabel] : "email hint"
             , [optional] : 1
             }
           , "Use the address tied to their workspace."
           , %hint
           )
       input( {[label] : "Email address"}
            , "mara@example.invalid"
            , %input
            )
       text( { [optionLabel] : "validation error"
             , [toggle] : true
             }
           , "This address already has access."
           , %error
           )
     }
     col(%field) {
       text("Role" , %label)
       input( {[label] : "Role"}
            , "Contributor"
            , %input
            )
       text( { [optionLabel] : "role hint"
             , [optional] : 2
             }
           , "Can edit content, but cannot manage billing."
           , %hint
           )
     }
   }
   row({[grow] : 0} , %actions) {
     button( {[primary] : true}
           , "Save access"
           , %action/primary
           )
     button("Cancel" , %action/secondary)
   }
 })
