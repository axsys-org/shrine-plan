') G071. Upload progress item — paused transfer — from examples/domain.json
(col(%content) {
   col(%identity) {
     row(%identity) {
       text("document" , %icon)
       text("greenpaper.typ" , %label)
     }
     text({[optional] : 1} , "86016" , %value)
     text( {[optional] : 2}
         , "2026-09-18T14:20:00Z"
         , %timestamp
         )
     text("synced" , %status)
   }
   row(%field) {
     text("Destination" , %label)
     text("/projects/aurora/files" , %value)
   }
   bar( {[max] : 86016 , [value] : 57344}
      , "57344 / 86016"
      , %progress
      )
   col(%metadata) {
     text("57344" , %value)
     text("86016" , %qualifier)
     text("0" , %value)
   }
   text("paused" , %status)
 })
