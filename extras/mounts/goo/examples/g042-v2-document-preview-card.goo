   col(%identity) {
     text("Shrine field notes" , %title)
     text("draft" , %status)
     row({[optional] : 1} , %metadata) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
     text({[optional] : 2} , "12" , %badge)
     text( {[optional] : 2}
         , "2026-09-18T14:20:00Z"
         , %timestamp
         )
   }
   media( {[optional] : 1}
        , "fixture:media/canopy"
        , %media
        )
 })
