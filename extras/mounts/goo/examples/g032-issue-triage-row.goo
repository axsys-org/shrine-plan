') G032. Issue triage row — from examples/domain.json
(col(%content) {
   col(%identity) {
     text("GOO-148" , %label)
     text( "Keep copy actions beside their values"
         , %title
         )
     text("open" , %status)
   }
   text("high" , %badge)
   row(%identity) {
     avatar("MC" , %avatar)
     text("Mara Chen" , %title)
   }
   col({[optional] : 1} , %metadata) {
     text("layout" , %metadata)
     text("regression" , %metadata)
   }
 })
