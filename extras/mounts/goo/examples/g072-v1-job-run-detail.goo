') G072. Job-run detail — queued run — from examples/domain.json
(col(%content) {
   text("Rebuild search index" , %title)
   text("queued" , %status)
   row(%field) {
     text("Id" , %label)
     text("job-48" , %value)
   }
   col(%metadata) {
     row(%field) {
       text("Submitted" , %label)
       text("2026-09-18T14:00:00Z" , %value)
     }
     row(%field) {
       text("Started" , %label)
       text("Not set" , %value)
     }
     row(%field) {
       text("Finished" , %label)
       text("Not set" , %value)
     }
     row(%field) {
       text("Duration seconds" , %label)
       text("0" , %value)
     }
   }
   bar( {[max] : 1000 , [value] : 0}
      , "0 / 1000"
      , %progress
      )
 })
