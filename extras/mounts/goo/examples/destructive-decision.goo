') Destructive decision — from goo-reimplementation/examples.json
(col(%notice) {
   text("Remove this snapshot?" , %title)
   text( "The saved snapshot will be removed. Other snapshots remain."
       , %body
       )
   row({[grow] : 0} , %actions) {
     button("Cancel" , %action/cancel)
     button("Remove" , %action/destructive)
   }
 })
