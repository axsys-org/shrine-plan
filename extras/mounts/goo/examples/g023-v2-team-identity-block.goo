') G023. Team identity block — lead unassigned — from examples/domain.json
(col(%identity) {
   col(%title) {
     text("hexagon" , %icon)
     text("Infrastructure" , %title)
     text("3 members" , %qualifier)
   }
   text( {[optional] : 1}
       , "Shared runtime and namespace tools."
       , %summary
       )
   text( {[optional] : 2}
       , "Lead: unassigned"
       , %metadata
       )
 })
