') G021. Person directory identity — no photo and offline — from examples/domain.json
(row(%content) {
   avatar("MC" , %avatar)
   col(%identity) {
     text("Mara Chen" , %title)
     text("offline" , %status)
     text( {[optional] : 1}
         , "Runtime engineer"
         , %subtitle
         )
     text( {[optional] : 2}
         , "Infrastructure"
         , %metadata
         )
   }
 })
