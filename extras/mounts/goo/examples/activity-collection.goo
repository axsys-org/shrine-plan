') Activity collection — from goo-reimplementation/examples.json
(col(%section) {
   row(%controls) {
     input( {[label] : "Filter events"}
          , "filter: all events"
          , %input
          )
     button("Refresh" , %action)
   }
   col(%collection) {
     col(%field) {
       text("Root committed" , %title)
       row( { [grow] : 0
            , [optionLabel] : "first metadata"
            , [optional] : 1
            }
          , %metadata
          ) {
         text("Mara Chen" , %author)
         text("2 minutes ago" , %timestamp)
       }
     }
     col(%field) {
       text("Index rebuilt" , %title)
       row( { [grow] : 0
            , [optionLabel] : "second metadata"
            , [optional] : 1
            }
          , %metadata
          ) {
         text("System" , %author)
         text("8 minutes ago" , %timestamp)
       }
     }
   }
   row({[grow] : 0} , %pagination) {
     button("Previous" , %action)
     button("Next" , %action)
   }
 })
