') Document reference — from goo-reimplementation/examples.json
(row(%document) {
   text("↗" , %icon)
   col(%title) {
     text("greenpaper.typ" , %title)
     text( { [optionLabel] : "subtitle"
           , [optional] : 1
           }
         , "Text document"
         , %subtitle
         )
     row( { [grow] : 0
          , [optionLabel] : "metadata"
          , [optional] : 2
          }
        , %metadata
        ) {
       text("84 KiB" , %metadata)
       text("Committed" , %metadata)
     }
   }
   row({[grow] : 0} , %actions) {
     button({[primary] : true} , "Open" , %action)
   }
 })
