') G032. Issue triage row — closed without labels — from examples/domain.json
(col(%content) {
   col(%identity) {
     text("GOO-148" , %label)
     text( "Keep copy actions beside their values"
         , %title
         )
     text("closed" , %status)
   }
   text("high" , %badge)
   row(%identity) {
     avatar("MC" , %avatar)
     text("Mara Chen" , %title)
   }
 })
