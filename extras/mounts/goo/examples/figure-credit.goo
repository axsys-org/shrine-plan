   col(%media) {
     media("" , %media)
     text( { [optionLabel] : "caption"
           , [optional] : 1
           }
         , "Canopy survey / north section"
         , %caption
         )
     text( { [optionLabel] : "credit"
           , [optional] : 2
           }
         , "Illustrative study · 04"
         , %credit
         )
   }
   text( "Patterns of growth, not a finished plan."
       , %body
       )
 })
