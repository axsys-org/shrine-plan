') G075. Support ticket summary — resolved ticket — from examples/domain.json
(col(%content) {
   text("SUP-84" , %label)
   text( "Unable to open a shared snapshot"
       , %title
       )
   text("normal" , %badge)
   text("resolved" , %status)
   row(%identity) {
     avatar("IP" , %avatar)
     text("Ivo Park" , %title)
   }
   col(%field) {
     text("Owner" , %label)
     row(%identity) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
     text( {[optional] : 1}
         , "Runtime engineer"
         , %metadata
         )
   }
   row({[optional] : 1} , %content) {
     col(%header) {
       row(%identity) {
         avatar("IP" , %avatar)
         text("Ivo Park" , %title)
       }
       text("2026-09-18T14:18:00Z" , %timestamp)
       text("Edited: false" , %status)
     }
     col(%content) {
       text( "The ownership boundaries look right. Could you check the narrow view?"
           , %body
           )
       col({[optional] : 1} , %collection) {
         col(%field) {
           row(%field) {
             text("Name" , %label)
             text("notes.txt" , %value)
           }
           row(%field) {
             text("Kind" , %label)
             text("text" , %value)
           }
           row(%field) {
             text("Size bytes" , %label)
             text("2104" , %value)
           }
           row(%field) {
             text("State" , %label)
             text("ready" , %value)
           }
         }
       }
       col({[optional] : 2} , %metadata) {
         col(%field) {
           row(%field) {
             text("Emoji" , %label)
             text("✓" , %value)
           }
           row(%field) {
             text("Count" , %label)
             text("2" , %value)
           }
         }
       }
     }
   }
   row(%field) {
     text("Response deadline" , %label)
     text("Not set" , %value)
   }
 })
