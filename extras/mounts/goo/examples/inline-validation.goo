') Inline validation — from goo-reimplementation/examples.json
(col(%field) {
   text("Workspace slug" , %label)
   text( {[optionLabel] : "hint" , [optional] : 1}
       , "Lowercase letters, numbers and dashes."
       , %hint
       )
   input( {[label] : "Workspace slug"}
        , "greenhouse"
        , %input
        )
   text("That slug is already taken." , %error)
 })
