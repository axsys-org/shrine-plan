') G041. Person contact card — from examples/domain.json
(col(%content) {
   row(%identity) {
     avatar("MC" , %avatar)
     col(%identity) {
       text("Mara Chen" , %title)
       text("available" , %status)
       text( {[optional] : 1}
           , "Runtime engineer"
           , %subtitle
           )
       text( {[optional] : 2}
           , "Infrastructure"
           , %metadata
           )
     }
   }
   text( {[optional] : 1}
       , "Builds small systems that compose."
       , %summary
       )
   col({[optional] : 2} , %field) {
     col(%field) {
       row(%field) {
         text("Kind" , %label)
         text("email" , %value)
       }
       row(%field) {
         text("Value" , %label)
         text("mara@example.invalid" , %value)
       }
     }
     col(%field) {
       row(%field) {
         text("Kind" , %label)
         text("chat" , %value)
       }
       row(%field) {
         text("Value" , %label)
         text("mara" , %value)
       }
     }
   }
 })
