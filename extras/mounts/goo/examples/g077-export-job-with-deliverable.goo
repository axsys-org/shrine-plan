') G077. Export job with deliverable — from examples/domain.json
(col(%content) {
   text("Aurora archive" , %title)
   row(%field) {
     text("Source" , %label)
     text("/projects/aurora" , %value)
   }
   row(%field) {
     text("Format" , %label)
     text("zip" , %value)
   }
   text("running" , %status)
   bar( {[max] : 100 , [value] : 72}
      , "72 / 100"
      , %progress
      )
 })
