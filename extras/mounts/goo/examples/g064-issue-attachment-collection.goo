') G064. Issue attachment collection — from examples/domain.json
(row(%content) {
   col(%header) {
     text("GOO-148" , %label)
     text( "Keep copy actions beside their values"
         , %title
         )
     text("open" , %status)
   }
   col(%collection) {
     col(%field) {
       row(%identity) {
         text("image" , %icon)
         text("before.png" , %label)
       }
       text("ready" , %status)
       media( {[optional] : 1}
            , "fixture:media/before"
            , %media
            )
       text( {[optional] : 2}
           , "84200"
           , %metadata
           )
     }
     col(%field) {
       row(%identity) {
         text("json" , %icon)
         text("repro.json" , %label)
       }
       text("ready" , %status)
       text({[optional] : 1} , "4021" , %metadata)
     }
   }
 })
