') A31. Text at twice the nominal size — from goo-adversarial-cases.md
(col(%content) {
   col(%header) {
     text( "A deliberately enlarged heading"
         , %title
         )
     text( "A short explanation that now takes more space."
         , %summary
         )
   }
   col(%field) {
     text("Display name" , %label)
     input("Long collaborative name" , %input)
     text("This value needs attention" , %error)
   }
   row(%actions) {
     button("Save" , %action)
     button("Cancel" , %action)
   }
 })
