') Recovery notice — from goo-reimplementation/examples.json
(col(%notice) {
   text("Sync paused" , %title)
   col(%summary) {
     text( "The local copy is safe. Reconnect to publish changes."
         , %notice
         )
     button( {[primary] : true}
           , "Try again"
           , %action/retry
           )
   }
 })
