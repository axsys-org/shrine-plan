') G060. Retention policy editor — bad duration — from examples/domain.json
(col(%content) {
   text("Workspace snapshots" , %title)
   row(%field) {
     text("Mode" , %label)
     input("rolling" , %input)
   }
   col(%field) {
     text("Duration" , %label)
     row(%content) {
       input("0" , %input)
       text("days" , %unit)
     }
     text("Use at least one day." , %error)
   }
   col(%field) {
     text("tag:release" , %field)
   }
   text( {[optional] : 1}
       , "18000000000"
       , %metadata
       )
 })
