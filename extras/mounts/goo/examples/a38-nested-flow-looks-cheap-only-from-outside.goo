') A38. Nested flow looks cheap only from outside — from goo-adversarial-cases.md
(row(%content) {
   row(%identity) {
     text("An involved identifier" , %title)
     text("Long qualification" , %subtitle)
     text("Available" , %status)
   }
   row(%metadata) {
     text("Owner" , %metadata)
     text("Recent" , %metadata)
     text("Verified" , %metadata)
   }
   row(%actions) {
     button("Open" , %action)
     button("Share" , %action)
   }
 })
