') G059. Access invitation editor — invalid email — from examples/domain.json
(col(%content) {
   row(%field) {
     text("Email" , %label)
     input("ivo@" , %input)
     text( "Enter a complete email address."
         , %error
         )
   }
   row(%field) {
     text("Role" , %label)
     input("viewer" , %input)
     text("Choices: viewer, editor" , %hint)
   }
   row(%field) {
     text("Scope" , %label)
     input("/projects/aurora" , %input)
   }
   row({[optional] : 1} , %field) {
     text("Note" , %label)
     input("Review the new inspector." , %input)
   }
 })
