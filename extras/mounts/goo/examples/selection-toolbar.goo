') Selection toolbar — from goo-reimplementation/examples.json
(row(%controls) {
   text("3 selected" , %selection)
   row({[grow] : 0} , %actions) {
     button({[primary] : true} , "Move" , %action)
     button( { [optionLabel] : "archive action"
             , [optional] : 1
             }
           , "Archive"
           , %action
           )
   }
 })
