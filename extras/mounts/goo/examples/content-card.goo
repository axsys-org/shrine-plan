') Content card — from goo-reimplementation/examples.json
(col(%card) {
   col(%header) {
     text("Notes from the edge" , %title)
     text( { [optionLabel] : "subtitle"
           , [optional] : 1
           }
         , "Field notes / 04"
         , %subtitle
         )
   }
   col(%content) {
     text( "A useful interface should keep its relationships intact even when some of the information disappears."
         , %body
         )
     col( { [optionLabel] : "figure"
          , [optional] : 2
          }
        , %media
        ) {
       media("" , %media)
       text( { [optionLabel] : "figure caption"
             , [optional] : 1
             }
           , "A smaller view should still tell the same story."
           , %caption
           )
       text( { [optionLabel] : "figure credit"
             , [optional] : 2
             }
           , "Illustrative placeholder · no external asset"
           , %credit
           )
     }
     row( { [grow] : 0
          , [optionLabel] : "byline"
          , [optional] : 1
          }
        , %metadata
        ) {
       text("Mara Chen" , %author)
       text( { [optionLabel] : "timestamp"
             , [optional] : 1
             }
           , "23 Sep 2026"
           , %timestamp
           )
     }
   }
   row({[grow] : 0} , %actions) {
     button( {[primary] : true}
           , "Read note"
           , %action
           )
     button( { [optionLabel] : "save action"
             , [optional] : 2
             }
           , "Save"
           , %action
           )
   }
 })
