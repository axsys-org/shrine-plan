') G024. Organization identity — from examples/domain.json
(row(%content) {
   avatar("fixture:org/glasshouse" , %avatar)
   col(%identity) {
     text("Glasshouse" , %title)
     text( "glasshouse.example.invalid"
         , %subtitle
         )
     text( {[optional] : 1}
         , "A small tools studio."
         , %summary
         )
   }
 })
