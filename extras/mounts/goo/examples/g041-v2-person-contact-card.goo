') G041. Person contact card — no contact methods — from examples/domain.json
(row(%content) {
   row(%identity) {
     avatar("MC" , %avatar)
     col(%identity) {
       text("Mara Chen" , %title)
       text("available" , %status)
       text( {[optional] : 1}
           , "Runtime engineer"
           , %subtitle
           )
       text( {[optional] : 2}
           , "Infrastructure"
           , %metadata
           )
     }
   }
   text( {[optional] : 1}
       , "Builds small systems that compose."
       , %summary
       )
 })
