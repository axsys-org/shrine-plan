') Latency metric — from goo-reimplementation/examples.json
(col(%field) {
   text("Round-trip latency" , %label)
   row(%value) {
     text("18.4" , %value)
     text("ms" , %unit)
     text( { [optionLabel] : "qualifier"
           , [optional] : 1
           }
         , "median"
         , %qualifier
         )
   }
   text( { [optionLabel] : "comparison"
         , [optional] : 1
         }
       , "↓ 12% vs previous build"
       , %delta
       )
 })
