') G030. Workspace identity — read-only membership — from examples/domain.json
(col(%identity) {
   text("leaf" , %icon)
   text("Aurora" , %title)
   text("viewer" , %status)
   text( {[optional] : 1}
       , "Prototype and review shared tools."
       , %summary
       )
   text({[optional] : 2} , "3" , %metadata)
 })
