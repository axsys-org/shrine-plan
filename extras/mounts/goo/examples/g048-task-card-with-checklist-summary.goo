') G048. Task card with checklist summary — from examples/domain.json
(col(%content) {
   text("Write the inspector example" , %title)
   text("in-progress" , %status)
   text( {[optional] : 1}
       , "Show a pinned value and its provenance."
       , %summary
       )
   col(%metadata) {
     row(%identity) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
     text("2026-09-21" , %timestamp)
     text("1 of 3 complete" , %value)
     col(%badge) {
       text("docs" , %badge)
       text("inspector" , %badge)
     }
   }
 })
