') G028. Document identity and authorship — published — from examples/domain.json
(col(%identity) {
   text("Shrine field notes" , %title)
   text("published" , %status)
   row({[optional] : 1} , %metadata) {
     avatar("MC" , %avatar)
     text("Mara Chen" , %title)
   }
   text({[optional] : 2} , "12" , %badge)
   text( {[optional] : 2}
       , "2026-09-18T14:20:00Z"
       , %timestamp
       )
 })
