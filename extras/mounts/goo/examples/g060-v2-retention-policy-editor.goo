') G060. Retention policy editor — no exceptions — from examples/domain.json
(col(%content) {
   text("Workspace snapshots" , %title)
   row(%field) {
     text("Mode" , %label)
     input("rolling" , %input)
   }
   row(%field) {
     text("Duration" , %label)
     row(%content) {
       input("30" , %input)
       text("days" , %unit)
     }
   }
   text( {[optional] : 1}
       , "18000000000"
       , %metadata
       )
 })
