row(%person) {
    row({[grow]: 0}, %avatar) {
        avatar("MC", %avatar)
        opt(1) { presence("", %presence) }
    }
    col({[grow]: 1}, %identity) {
        text("Mara Chen", %title)
        opt(1) {
            text("Staff engineer · Systems", %subtitle)
            text("Available", %status)
        }
        opt(2) { text("Platform team · Austin", %metadata) }
    }
    row({[grow]: 0}, %actions) {
        button({[primary]: true}, "Message", %action)
        opt(2) { button("Call", %action) }
    }
}
