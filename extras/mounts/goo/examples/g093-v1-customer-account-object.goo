') G093. Customer account object — new account — from examples/domain.json
(col(%content) {
   text("Glasshouse" , %title)
   text("Studio" , %badge)
   text("active" , %status)
   col(%identity) {
     row(%identity) {
       avatar("MC" , %avatar)
       col(%identity) {
         text("Mara Chen" , %title)
         text("available" , %status)
         text( {[optional] : 1}
             , "Runtime engineer"
             , %subtitle
             )
         text( {[optional] : 2}
             , "Infrastructure"
             , %metadata
             )
       }
     }
     text( {[optional] : 1}
         , "Builds small systems that compose."
         , %summary
         )
     col({[optional] : 2} , %field) {
       col(%field) {
         row(%field) {
           text("Kind" , %label)
           text("email" , %value)
         }
         row(%field) {
           text("Value" , %label)
           text("mara@example.invalid" , %value)
         }
       }
       col(%field) {
         row(%field) {
           text("Kind" , %label)
           text("chat" , %value)
         }
         row(%field) {
           text("Value" , %label)
           text("mara" , %value)
         }
       }
     }
   }
   col(%section) {
     text("Contacts" , %heading)
     col(%collection) {
       col(%content) {
         row(%identity) {
           avatar("MC" , %avatar)
           text("Mara Chen" , %title)
         }
         row(%metadata) {
           text("mara@example.invalid" , %value)
           text( {[optional] : 1}
               , "Glasshouse"
               , %metadata
               )
         }
         text("Selected: false" , %status)
       }
       col(%content) {
         row(%identity) {
           avatar("IP" , %avatar)
           text("Ivo Park" , %title)
         }
         row(%metadata) {
           text("ivo@example.invalid" , %value)
           text( {[optional] : 1}
               , "Glasshouse"
               , %metadata
               )
         }
         text("Selected: false" , %status)
       }
     }
   }
 })
