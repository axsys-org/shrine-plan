') G033. Message inbox row — read message without attachments — from examples/domain.json
(col(%content) {
   row(%identity) {
     avatar("IP" , %avatar)
     text("Ivo Park" , %title)
   }
   row(%content) {
     text("Inspector review" , %title)
     text( {[optional] : 1}
         , "The ownership boundaries look right…"
         , %summary
         )
   }
   text("2026-09-18T14:18:00Z" , %timestamp)
   text("Unread: false" , %status)
   text( {[optional] : 1}
       , "0 attachments"
       , %metadata
       )
 })
