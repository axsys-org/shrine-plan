') G027. Service environment identity — from examples/domain.json
(col(%identity) {
   row(%title) {
     text("indexer" , %title)
     text("degraded" , %status)
   }
   text("staging" , %badge)
   text({[optional] : 1} , "0.8.4" , %metadata)
   text( {[optional] : 2}
       , "Maintains namespace search indexes."
       , %summary
       )
 })
