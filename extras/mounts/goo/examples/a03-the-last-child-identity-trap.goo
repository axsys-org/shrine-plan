') A03. The last-child identity trap — from goo-adversarial-cases.md
(row(%person) {
   avatar("XY" , %avatar)
   col(%identity) {
     text("Alex" , %title)
     text( {[optional] : 1}
         , "Operator"
         , %subtitle
         )
     text( {[optional] : 1}
         , "Available"
         , %status
         )
     text( {[optional] : 2}
         , "Night shift"
         , %metadata
         )
   }
   row(%actions) {
     button("Message" , %action)
   }
 })
