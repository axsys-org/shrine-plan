') G059. Access invitation editor — restricted role choices — from examples/domain.json
(col(%content) {
   row(%field) {
     text("Email" , %label)
     input("ivo@example.invalid" , %input)
   }
   row(%field) {
     text("Role" , %label)
     input("viewer" , %input)
     text("Choices: viewer" , %hint)
   }
   row(%field) {
     text("Scope" , %label)
     input("/projects/aurora" , %input)
   }
   row({[optional] : 1} , %field) {
     text("Note" , %label)
     input("Review the new inspector." , %input)
   }
 })
