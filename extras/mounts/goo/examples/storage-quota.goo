') Storage quota — from goo-reimplementation/examples.json
(col(%field) {
   text("Storage used" , %label)
   row(%value) {
     text("73.0" , %value)
     text("GB" , %unit)
     text( { [optionLabel] : "qualifier"
           , [optional] : 1
           }
         , "of 100 GB"
         , %qualifier
         )
   }
   bar( {[max] : 100 , [value] : 73}
      , ""
      , %progress
      )
 })
