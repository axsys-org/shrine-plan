') G040. Notification with a next action — read notification — from examples/domain.json
(col(%content) {
   row(%identity) {
     avatar("IP" , %avatar)
     text("Ivo Park" , %title)
   }
   row(%content) {
     text("mentioned you in a review" , %summary)
     col(%title) {
       text("GOO-148" , %label)
       text( "Keep copy actions beside their values"
           , %title
           )
       text("open" , %status)
     }
   }
   text("2026-09-18T14:19:00Z" , %timestamp)
   text("Read: true" , %status)
   row(%actions) {
     button("View review" , %action)
   }
 })
