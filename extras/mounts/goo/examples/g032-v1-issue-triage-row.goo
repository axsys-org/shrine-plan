') G032. Issue triage row — unassigned issue — from examples/domain.json
(col(%content) {
   col(%identity) {
     text("GOO-148" , %label)
     text( "Keep copy actions beside their values"
         , %title
         )
     text("open" , %status)
   }
   text("high" , %badge)
   text("Assignee: unassigned" , %identity)
   col({[optional] : 1} , %metadata) {
     text("layout" , %metadata)
     text("regression" , %metadata)
   }
 })
