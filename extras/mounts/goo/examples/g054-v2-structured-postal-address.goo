') G054. Structured postal address — validation needs review — from examples/domain.json
(col(%field) {
   text("Receiving studio" , %label)
   row(%value) {
     text("Ivo Park" , %title)
     text( escaped("Glasshouse\nBuilding C\n17 Example Court\nSampleton CA 90000\nUS")
         , %body
         )
   }
   text( {[optional] : 1}
       , "Use the side entrance."
       , %hint
       )
   text("needs-review" , %status)
 })
