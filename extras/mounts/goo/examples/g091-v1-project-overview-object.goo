') G091. Project overview object — new project — from examples/domain.json
(col(%content) {
   text("Aurora" , %title)
   text("active" , %status)
   text( "Make namespace values inspectable."
       , %summary
       )
   col(%identity) {
     text("Lead" , %label)
     row(%identity) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
     text( {[optional] : 1}
         , "Runtime engineer"
         , %metadata
         )
   }
   col(%section) {
     col(%title) {
       text("hexagon" , %icon)
       text("Infrastructure" , %title)
       text("3 members" , %qualifier)
     }
     text( {[optional] : 1}
         , "Shared runtime and namespace tools."
         , %summary
         )
     row({[optional] : 2} , %metadata) {
       avatar("MC" , %avatar)
       text("Mara Chen" , %title)
     }
   }
 })
