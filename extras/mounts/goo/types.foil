- sept

' Internal Goo IR. Wire JSON and semantic passes belong to later items.
+ goo
  + node_id
    ' Opaque identity text. Allocation and UUID validation belong to later passes.
    : text=str
  + slot
    ' Open-ended semantic role; never an enumeration of known slots.
    : text=str
  + path
    : segments=row[str]
    + display
      \ value=goo/path
      ^ str
      | str/cat_all ["/" (str/join "/" value.segments)]
    + trusted
      ' Matches Haskell parsePath; only trusted policy literals may normalize.
      \ text=str
      ^ goo/path
      | goo/path (str/split_nonempty 47 text)
    + valid_segment
      \ text=str
      ^ bool
      ? ((eq text.len 0) || (eq text ".") || (eq text "..")) .false
      % i=nat 0
      ^ bool
      ? (eq i text.len) .true
      = c text.at(i)
        valid (!((lt c 48) || (gt c 57)) || !((lt c 65) || (gt c 90)) || !((lt c 97) || (gt c 122)) || (eq c 95) || (eq c 45) || (eq c 46))
      ? !valid .false
      | _ i.inc
    + parse_absolute
      ' ASCII contract, with root allowed. Never silently repair input.
      \ text=str
      ^ maybe[goo/path]
      ? (eq text "/") (./some (goo/path []))
      ? !(eq text.at(0) 47) .none
      = parts (str/split_byte 47 text.slice(1 (sub text.len 1)))
      ? (row/any[str] (\ part !(goo/path/valid_segment part)) parts) .none
      | ./some (goo/path parts)
    + slot
      \ value=goo/path
      ^ goo/slot
      | goo/slot value.display
  + loc
    ' One-based source position; absent origin is maybe/none, never (0,0).
    : line=nat column=nat
    + make
      \ line=nat column=nat
      ^ maybe[goo/loc]
      ? ((eq line 0) || (eq column 0)) .none
      | ./some (goo/loc line column)
  + scalar
    ' Exact IEEE-754 binary64 payload, including signed zero and subnormals.
    ' No decimal parsing or arithmetic here. Untrusted codecs must use from_bits.
    : bits=nat
    + from_bits
      \ bits=nat
      ^ maybe[goo/scalar]
      ? (ge bits 18446744073709551616) .none
      ? (eq (mod (div bits 4503599627370496) 2048) 2047) .none
      | ./some (goo/scalar bits)
  + rank
    & goo/rank/required goo/rank/compact goo/rank/full
    + required
      :
    + compact
      :
    + full
      :
    + to_nat
      \ value=goo/rank
      ^ nat
      ? value
       > ./required 0
       > ./compact 1
       > ./full 2
    + from_nat
      \ value=nat
      ^ maybe[goo/rank]
      ? (eq value 0) (./some (goo/rank/required))
      ? (eq value 1) (./some (goo/rank/compact))
      ? (eq value 2) (./some (goo/rank/full))
      .none
  + direction
    & goo/direction/row goo/direction/col
    + row
      :
    + col
      :
  + affinity
    & goo/affinity/attached goo/affinity/tight goo/affinity/related goo/affinity/normal goo/affinity/loose goo/affinity/separate
    + attached
      :
    + tight
      :
    + related
      :
    + normal
      :
    + loose
      :
    + separate
      :
  + edge_source
    & goo/edge_source/exact goo/edge_source/fallback goo/edge_source/uniform
    + exact
      :
    + fallback
      :
    + uniform
      :
  + primitive_kind
    & goo/primitive_kind/button goo/primitive_kind/input goo/primitive_kind/code goo/primitive_kind/avatar goo/primitive_kind/presence goo/primitive_kind/media goo/primitive_kind/bar
    + button
      :
    + input
      :
    + code
      :
    + avatar
      :
    + presence
      :
    + media
      :
    + bar
      :
    + name
      \ value=goo/primitive_kind
      ^ str
      ? value
       > ./button "button"
       > ./input "input"
       > ./code "code"
       > ./avatar "avatar"
       > ./presence "presence"
       > ./media "media"
       > ./bar "bar"
    + parse
      \ text=str
      ^ maybe[goo/primitive_kind]
      ? (eq text "button") (./some (goo/primitive_kind/button))
      ? (eq text "input") (./some (goo/primitive_kind/input))
      ? (eq text "code") (./some (goo/primitive_kind/code))
      ? (eq text "avatar") (./some (goo/primitive_kind/avatar))
      ? (eq text "presence") (./some (goo/primitive_kind/presence))
      ? (eq text "media") (./some (goo/primitive_kind/media))
      ? (eq text "bar") (./some (goo/primitive_kind/bar))
      .none
  + primitive
    & goo/primitive/button goo/primitive/input goo/primitive/code goo/primitive/avatar goo/primitive/presence goo/primitive/media goo/primitive/bar
    + button
      : text=str
    + input
      : text=str
    + code
      : text=str
    + avatar
      : text=str
    + presence
      : text=str
    + media
      : text=str
    + bar
      : text=str
    + kind
      \ value=goo/primitive
      ^ goo/primitive_kind
      ? value
       > (./button _) (goo/primitive_kind/button)
       > (./input _) (goo/primitive_kind/input)
       > (./code _) (goo/primitive_kind/code)
       > (./avatar _) (goo/primitive_kind/avatar)
       > (./presence _) (goo/primitive_kind/presence)
       > (./media _) (goo/primitive_kind/media)
       > (./bar _) (goo/primitive_kind/bar)
    + payload
      \ value=goo/primitive
      ^ str
      ? value
       > (./button text) text
       > (./input text) text
       > (./code text) text
       > (./avatar text) text
       > (./presence text) text
       > (./media text) text
       > (./bar text) text
    + make
      \ kind=goo/primitive_kind text=str
      ^ goo/primitive
      ? kind
       > ./button (goo/primitive/button text)
       > ./input (goo/primitive/input text)
       > ./code (goo/primitive/code text)
       > ./avatar (goo/primitive/avatar text)
       > ./presence (goo/primitive/presence text)
       > ./media (goo/primitive/media text)
       > ./bar (goo/primitive/bar text)
  + config
    : grow=maybe[bool] max_ideal=maybe[goo/scalar]
      primary=maybe[bool] toggle=maybe[bool]
      label=maybe[str] option_label=maybe[str]
      value=maybe[goo/scalar] max=maybe[goo/scalar]
    + empty
      ^ goo/config
      | goo/config .none .none .none .none .none .none .none .none
  + common
    : slot=goo/slot optional=goo/rank config=goo/config origin=maybe[goo/loc]
  + edge
    : left=goo/slot right=goo/slot left_id=goo/node_id right_id=goo/node_id
      bind=goo/affinity rule=maybe[nat] source=goo/edge_source
      parent=goo/node_id parent_slot=goo/slot
  + compile_context
    : view_path=goo/path
  + render_options
    : optional_budget=goo/rank hidden_ids=row[goo/node_id]
      hidden_paths=row[row[nat]] uniform_edges=bool
  + compile_request
    : context=goo/compile_context options=goo/render_options
  + source_attrs
    : common=goo/common
  + source
    & goo/source/text goo/source/image goo/source/jet goo/source/flow goo/source/group goo/source/opt
    + text
      : attrs=goo/source_attrs value=str
    + image
      : attrs=goo/source_attrs value=str
    + jet
      : attrs=goo/source_attrs primitive=goo/primitive
    + flow
      : attrs=goo/source_attrs direction=goo/direction kids=row[goo/source]
    + group
      : attrs=goo/source_attrs kids=row[goo/source]
    + opt
      : attrs=goo/source_attrs rank=goo/rank kids=row[goo/source]
    + attrs
      \ tree=goo/source
      ^ goo/source_attrs
      ? tree
       > (./text a _) a
       > (./image a _) a
       > (./jet a _) a
       > (./flow a _ _) a
       > (./group a _) a
       > (./opt a _ _) a
    + children
      \ tree=goo/source
      ^ row[goo/source]
      ? tree
       > (./flow _ _ kids) kids
       > (./group _ kids) kids
       > (./opt _ _ kids) kids
      []
  + core_attrs
    : common=goo/common
  + core
    & goo/core/text goo/core/image goo/core/jet goo/core/flow
    + text
      : attrs=goo/core_attrs value=str
    + image
      : attrs=goo/core_attrs value=str
    + jet
      : attrs=goo/core_attrs primitive=goo/primitive
    + flow
      : attrs=goo/core_attrs direction=goo/direction kids=row[goo/core]
    + attrs
      \ tree=goo/core
      ^ goo/core_attrs
      ? tree
       > (./text a _) a
       > (./image a _) a
       > (./jet a _) a
       > (./flow a _ _) a
    + children
      \ tree=goo/core
      ^ row[goo/core]
      ? tree
       > (./flow _ _ kids) kids
      []
  + normalized_attrs
    : common=goo/common node_id=goo/node_id
  + normalized
    & goo/normalized/text goo/normalized/image goo/normalized/jet goo/normalized/flow
    + text
      : attrs=goo/normalized_attrs value=str
    + image
      : attrs=goo/normalized_attrs value=str
    + jet
      : attrs=goo/normalized_attrs primitive=goo/primitive
    + flow
      : attrs=goo/normalized_attrs direction=goo/direction kids=row[goo/normalized]
    + attrs
      \ tree=goo/normalized
      ^ goo/normalized_attrs
      ? tree
       > (./text a _) a
       > (./image a _) a
       > (./jet a _) a
       > (./flow a _ _) a
    + children
      \ tree=goo/normalized
      ^ row[goo/normalized]
      ? tree
       > (./flow _ _ kids) kids
      []
    + node_id
      \ tree=goo/normalized
      ^ goo/node_id
      tree.attrs.node_id
  + visible_attrs
    : common=goo/common node_id=goo/node_id
  + visible
    & goo/visible/text goo/visible/image goo/visible/jet goo/visible/flow
    + text
      : attrs=goo/visible_attrs value=str
    + image
      : attrs=goo/visible_attrs value=str
    + jet
      : attrs=goo/visible_attrs primitive=goo/primitive
    + flow
      : attrs=goo/visible_attrs direction=goo/direction kids=row[goo/visible]
    + attrs
      \ tree=goo/visible
      ^ goo/visible_attrs
      ? tree
       > (./text a _) a
       > (./image a _) a
       > (./jet a _) a
       > (./flow a _ _) a
    + children
      \ tree=goo/visible
      ^ row[goo/visible]
      ? tree
       > (./flow _ _ kids) kids
      []
    + node_id
      \ tree=goo/visible
      ^ goo/node_id
      tree.attrs.node_id
  + semantic_attrs
    : common=goo/common node_id=goo/node_id after=maybe[goo/edge]
  + semantic
    & goo/semantic/text goo/semantic/image goo/semantic/jet goo/semantic/flow
    + text
      : attrs=goo/semantic_attrs value=str
    + image
      : attrs=goo/semantic_attrs value=str
    + jet
      : attrs=goo/semantic_attrs primitive=goo/primitive
    + flow
      : attrs=goo/semantic_attrs direction=goo/direction kids=row[goo/semantic]
    + attrs
      \ tree=goo/semantic
      ^ goo/semantic_attrs
      ? tree
       > (./text a _) a
       > (./image a _) a
       > (./jet a _) a
       > (./flow a _ _) a
    + children
      \ tree=goo/semantic
      ^ row[goo/semantic]
      ? tree
       > (./flow _ _ kids) kids
      []
    + node_id
      \ tree=goo/semantic
      ^ goo/node_id
      tree.attrs.node_id
    + after
      \ tree=goo/semantic
      ^ maybe[goo/edge]
      tree.attrs.after
