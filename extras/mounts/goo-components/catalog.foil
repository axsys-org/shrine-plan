- grove_role_runtime
- goo_app/editing

+ goo_components
  + specimen
    : key=str name=str family=str subject=str view=str description=str
  + catalog
    ^ row[goo_components/specimen]
    [(goo_components/specimen "heading" "Heading" "Text" "copy" "heading" "A title using the shared typography recipe.")
     (goo_components/specimen "paragraph" "Paragraph" "Text" "prose" "paragraph" "Body text wraps to the server-prepared width.")
     (goo_components/specimen "caption" "Caption" "Text" "copy" "caption_text" "Supporting text with a quieter visual role.")
     (goo_components/specimen "code" "Code" "Text" "code" "code" "Monospaced text; source is displayed, never evaluated.")
     (goo_components/specimen "rich-text" "Rich text" "Text" "rich" "rich_text" "Inline emphasis and a preserved reference. Link appearance grants no navigation action.")
     (goo_components/specimen "image" "Image" "Media" "photo" "image" "The full namespace image, scaled to fit while preserving its original proportions.")
     (goo_components/specimen "figure" "Figure" "Media" "photo" "figure" "The full image with a caption and contextual alt text. Its proportions follow the source dimensions.")
     (goo_components/specimen "badge" "Badge" "Information" "badge" "badge" "A compact label using the profile's badge recipe.")
     (goo_components/specimen "status" "Status" "Information" "status" "status" "A descriptive status marker; this is not a live announcement channel.")
     (goo_components/specimen "metadata" "Metadata" "Information" "metadata" "metadata" "A label and value composed in a wrapping row.")
     (goo_components/specimen "identity" "Identity" "Information" "person" "identity" "Initials, a name, and supporting context.")
     (goo_components/specimen "card" "Card" "Composition" "article" "card" "A named header presentation composed with body content.")
     (goo_components/specimen "compact-card" "Compact card" "Composition" "article" "compact_card" "The same article source in a smaller presentation.")
     (goo_components/specimen "empty-state" "Empty state" "Composition" "empty" "empty_state" "An explanation of an empty collection, without an invented action.")
     (goo_components/specimen "text-field" "Text field" "Editing" "field" "text_field" "A local draft and an ordinary admitted Save action.")
     (goo_components/specimen "rich-editor" "Rich editor" "Editing" "rich" "rich_editor" "Structured runs, selection formatting, local undo, and a typed Save action.")]
  + find
    \ key=str
    ^ maybe[goo_components/specimen]
    = matches ((goo_components/catalog).keep((\ item (eq item.key key))))
    ? matches.len (./some matches.at(0)) .none
  + sample
    ^ goo/text
    = bold (myth/sing ['sys 'modifiers] (pails/modifiers (list/one (modifiers/bold))))
      italic (myth/sing ['sys 'modifiers] (pails/modifiers (list/one (modifiers/italic))))
      linked (myth/sing ['sys 'link] (pails/p ['sys 'content]))
    [(goo/runt myth/new (goo/lang/en "Keep "))
     (goo/runt bold (goo/lang/en "meaning"))
     (goo/runt myth/new (goo/lang/en " close to the "))
     (goo/runt italic (goo/lang/en "words"))
     (goo/runt myth/new (goo/lang/en ". Follow the "))
     (goo/runt linked (goo/lang/en "source reference"))
     (goo/runt myth/new (goo/lang/en "."))]
  + plain_supported
    \ value=str
    ^ bool
    ? (gt value.len 65536) .false
    % i=nat 0
    ? (eq i value.len) .true
    = byte value.at(i)
    ? ((lt byte 32) || (gt byte 126)) .false
    | _ i.inc
