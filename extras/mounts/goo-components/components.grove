#import text=lib/grove/types/text

value =
  @slot

label =
  @slot

title =
  @slot

body =
  @slot

caption =
  @slot

initials =
  @slot

rich_value =
  @slot

image_source =
  @slot

alt_text =
  @slot

image_width =
  @slot

image_height =
  @slot

image_dimension =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[image_dimension]
    ?> value=pails/n value .none
    ? (eq value.n 0) .none
    | ./some value.n
  + write
    \ value=image_dimension
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

figure_content =
  @role
  %/image_source: text
  %/image_width: image_dimension
  %/image_height: image_dimension
  %/alt_text: text
  %/caption: text

copy =
  @role
  %/value: text

labelled =
  @role
  %/label: text
  %/value: text

article =
  @role
  %/title: text
  %/body: text
  %/caption: text

person =
  @role
  %/initials: text
  %/title: text
  %/caption: text

rich_type =
  @type
  ! foil
  goo/text
  + read
    \ value=pail
    ^ maybe[rich_type]
    < decoded (goo_edit/decode value)
    | ./some decoded.value
  + write
    \ value=rich_type
    ^ pail
    | goo/text/pail value
  + contract
    ^ curb
    | curb/of_type (^ goo/text/pail)

rich_copy =
  @role
  %/label: text
  %/rich_value: %/rich_type

heading =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/heading
  item => text(item.value, '/sys/slot/title)

paragraph =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/paragraph
  item => text(item.value, '/sys/slot/content)

caption_text =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/caption
  item => text(item.value, '/sys/slot/caption)

code =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/code
  item => code(item.value)

badge =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/badge
  item => text(item.value, "badge")

status =
  @view
  #on ; %/copy
  #for ; /sys/slot/components/status
  item => text(item.value, "status")

metadata =
  @view
  #on ; %/labelled
  #for ; /sys/slot/components/metadata
  item => row('/sys/slot/metadata) {
    text(item.label, '/sys/slot/label)
    text(item.value, '/sys/slot/summary)
  }

identity =
  @view
  #on ; %/person
  #for ; /sys/slot/components/identity
  item => row('/sys/slot/identity) {
    avatar(item.initials)
    col('/sys/slot/content) {
      text(item.title, '/sys/slot/label)
      text(item.caption, '/sys/slot/caption)
    }
  }

card_header =
  @view
  #on ; %/article
  #for ; /sys/slot/components/card_header
  item => col('/sys/slot/header) {
    text(item.title, '/sys/slot/title)
    text(item.caption, '/sys/slot/caption)
  }

card =
  @view
  #on ; %/article
  #for ; /sys/slot/components/card
  item => col('/sys/containers/card) {
    present(item, '/sys/slot/components/card_header)
    text(item.body, '/sys/slot/content)
  }

compact_card =
  @view
  #on ; %/article
  #for ; /sys/slot/components/compact_card
  item => row('/sys/containers/card) {
    text(item.title, '/sys/slot/label)
    text(item.caption, '/sys/slot/caption)
  }

empty_state =
  @view
  #on ; %/article
  #for ; /sys/slot/components/empty_state
  item => col('/sys/slot/content) {
    text(item.title, '/sys/slot/title)
    text(item.body, '/sys/slot/summary)
  }

rich_text =
  @view
  #on ; %/rich_copy
  #for ; /sys/slot/components/rich_text
  item => col('/sys/slot/content) {
    text(item.label, '/sys/slot/label)
    text(item.rich_value, '/sys/slot/content)
  }

image =
  @view
  #on ; %/figure_content
  #for ; /sys/slot/components/image
  item => image(item.image_source, "media", label = item.alt_text, width = item.image_width, height = item.image_height)

figure =
  @view
  #on ; %/figure_content
  #for ; /sys/slot/components/figure
  item => col('/sys/slot/content) {
    present(item, '/sys/slot/components/image)
    text(item.caption, '/sys/slot/caption)
  }

save_text =
  @action
  #on ; %/labelled
  %/value: text
  ! foil
  \ value=str item=%/labelled
  ^ %/labelled
  ? !(goo_components/plain_supported value)
    | Seq[%/labelled] (error (pails/t "Use one line of ASCII text, at most 65536 bytes.")) item
  | item.set_value(value)

text_field =
  @view
  #on ; %/labelled
  #for ; /sys/slot/components/text_field
  item => col('/sys/slot/field) {
    text(item.label, '/sys/slot/label)
    group(on = item, action = %/save_text, myth = { %/value = .input(item.value) }) {
      input(%/value)
      action("Save text")
    }
  }

save_rich =
  @action
  #on ; %/rich_copy
  %/rich_value: %/rich_type
  ! foil
  \ rich_value=goo/text item=%/rich_copy
  ^ %/rich_copy
  | item.set_rich_value(rich_value)

rich_editor =
  @view
  #on ; %/rich_copy
  #for ; /sys/slot/components/rich_editor
  item => col('/sys/slot/field) {
    text(item.label, '/sys/slot/label)
    group(on = item, action = %/save_rich, myth = { %/rich_value = .input(item.rich_value) }) {
      col('/sys/slot/content) {
        input(%/rich_value)
        action("Save rich text")
      }
    }
  }

text_toolbar =
  @view
  #on ; %/rich_copy
  #for ; /sys/slot/text_toolbar
  item => row('/sys/slot/overlay) {
    button("Bold", '/sys/edit/bold)
    button("Italic", '/sys/edit/italic)
    button("Underline", '/sys/edit/underline)
    button("Clear", '/sys/edit/clear)
  }

text_commands =
  @view
  #on ; %/rich_copy
  #for ; /sys/slot/text_commands
  item => col('/sys/slot/overlay) {
    button("Text", '/sys/edit/paragraph)
    button("Code", '/sys/edit/code)
  }
