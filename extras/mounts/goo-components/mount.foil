- explorer_mount
- goo_components/catalog

+ goo_components_mount
  + selection
    \ target=str
    ^ maybe[goo_components/specimen]
    = parts (http_foot/split 63 target)
    ? (gt parts.len 2) .none
    = query=str (? (eq parts.len 2) parts.at(1) "")
    ? (eq query "") (goo_components/find "card")
    ?> (./ok fields) (Try[str row[[str str]]] http_foot/fields query) .none
    ? !(eq fields.len 1) .none
    = [key value] fields.at(0)
    ? !(eq key "component") .none
    | goo_components/find value
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? ((eq url "/goo-components") || (eq url "/goo-components/"))
          ?> (./some selected) (goo_components_mount/selection request.target)
            | ./reply (http_driver/response 400 "Choose a component from the catalog.")
          | ./bytes 200 (http_foot/bar (goo_components_mount/page state.self selected)) "text/html; charset=utf-8"
        ? (eq url "/goo-components/sculpture.jpg")
          | ./asset [state.self 'io 'fs ($ta "goo-components")] "sculpture.jpg" "image/jpeg"
        ? (eq url "/goo-components/gallery.css")
          = matches (files.keep((\ [key bytes] (eq key "gallery.css"))))
          ? !(matches.len) (./reply (http_driver/response 404 "Not found"))
          = [key bytes] matches.at(0)
          | ./bytes 200 bytes "text/css"
        | ./reply (http_driver/response 404 "Not found")
    | http_foot/add_routes [(http_foot/route "/goo-components" plan)] http_foot/empty
  + navigation
    \ selected=goo_components/specimen
    ^ weft/node
    | weft/el "nav" [(weft/att "aria-label" "Components")]
      ((goo_components/catalog).map((goo_components_mount/link selected)))
  + link
    \ selected=goo_components/specimen item=goo_components/specimen
    ^ weft/node
    = attrs=row[weft/att] [(weft/href (str/to_atom (str/cat_all ["/goo-components?component=" item.key])))]
      attrs (? (eq item.key selected.key) attrs.snoc((weft/att "aria-current" "page")) attrs)
    | weft/el "a" attrs
      [(weft/leaf "span" [] (str/to_atom item.name))
       (weft/leaf "small" [] (str/to_atom item.family))]
  + page
    \ self=iota selected=goo_components/specimen
    ^ nat
    = assets (goo_browser/surface_assets).snoc((weft/el "link"
        [(weft/att "rel" "stylesheet") (weft/href "/goo-components/gallery.css")] []))
      target=path [self 'app 'goo_components ($ts selected.subject)]
      view=path [self 'gov 'goo_components ($ts selected.view)]
      original=row[weft/node]
        ? ((eq selected.key "image") || (eq selected.key "figure"))
          [(weft/leaf "a" [(weft/href "/goo-components/sculpture.jpg")
            (weft/att "target" "_blank") (weft/att "rel" "noopener")] "Open full image")]
        []
      footer=row[weft/node]
        [(weft/leaf "p" [] "Resize the window to inspect the prepared layout. Editing examples save to this gallery's own sample records.")
         (weft/leaf "code" [] (str/to_atom (path_show view)))]
    | weft/page_with_body_attributes "Goo components" assets [(weft/cls "component-gallery")]
      [(weft/el "header" [(weft/cls "catalog-header")]
        [(weft/leaf "p" [(weft/cls "eyebrow")] "GOO / COMPONENTS")
         (weft/leaf "h1" [] "A small vocabulary for useful surfaces.")
         (weft/leaf "p" [] "Text, information, composition, and editing. Built from the current Goo recipes.")])
       (weft/el "div" [(weft/cls "catalog-layout")]
         [(goo_components_mount/navigation selected)
          (weft/el "section" [(weft/cls "catalog-detail")]
            [(weft/el "header" [(weft/cls "specimen-header")]
              [(weft/leaf "p" [(weft/cls "eyebrow")] (str/to_atom selected.family))
               (weft/leaf "h2" [] (str/to_atom selected.name))
               (weft/leaf "p" [] (str/to_atom selected.description))])
             (weft/el "main" [(weft/att "data-goo-surface" "")
               (weft/att "data-target" (str/to_atom (path_show target)))
               (weft/att "data-view" (str/to_atom (path_show view)))
               (weft/att "aria-label" "Live component")] [])
             (weft/el "footer" [(weft/cls "specimen-footer")]
               footer.weld(original))])])]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'goo_components]
      target=path [state.self 'app 'goo_components]
    ?> (./some version) state.case(.x source) (./err (pails/t "Component publication is missing."))
    ?> (./ok next) (grove_install/instantiate source version target state)
      | ./err (pails/t "Component samples could not be installed.")
    | ./ok next
