{
  "version": 1,
  "name": "goo-components",
  "dependencies": ["explorer", "codecs"],
  "modules": {
    "goo_components/catalog": "catalog.foil",
    "goo_components/mount": "mount.foil"
  },
  "grove": [{
    "root": ["gov", "goo_components"],
    "files": ["components.grove", "gallery.grove"],
    "prelude": "goo_components/catalog"
  }],
  "assets": {
    "/goo-components/gallery.css": "gallery.css",
    "/goo-components/sculpture.jpg": "sculpture.jpg"
  },
  "roots": [["lib", "goo_components/catalog"], ["lib", "goo_components/mount"], ["gov", "goo_components"]],
  "files": {},
  "tests": {},
  "activate": {"module": "goo_components/mount", "entry": ["goo_components_mount", "install"]},
  "http": {"module": "goo_components/mount", "entry": ["goo_components_mount", "http"]},
  "routes": ["/goo-components"],
  "host": "host.py"
}
