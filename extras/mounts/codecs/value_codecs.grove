' Publisher-owned value codecs over the selected system type foundations.
' The loader mounts source imports onto this publication without changing brands.

time =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[time]
    > wrapped=pails/n value
      .none
    | ./some wrapped.n
  + write
    \ value=time
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

duration =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[duration]
    > wrapped=pails/n value
      .none
    | ./some wrapped.n
  + write
    \ value=duration
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

text =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[text]
    > wrapped=pails/t value
      .none
    | ./some wrapped.t
  + write
    \ value=text
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

path =
  @type
  ! foil
  row[iota]
  + read
    \ value=pail
    ^ maybe[path]
    > wrapped=pails/p value
      .none
    | ./some wrapped.p
  + write
    \ value=path
    ^ pail
    | pails/p value
  + contract
    ^ curb
    | curb/of_type (^ pails/p)
