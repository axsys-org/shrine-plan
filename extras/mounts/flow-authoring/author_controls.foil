- flow_interface
- json [at=author_json]

' Presentation adapters only. Goo guards the selected receiver/publication;
' Decode presentation inputs once, then invoke the existing native operations.
+ flow_author_controls
  + refresh
    ' Follow explicit behavior publication through this published action.
    ' Reuse the existing registration planner; retained work is not rewritten.
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_ui/refresh [state.self 'gov 'flows] input state
  + fields
    \ allowed=row[str] input=myth
    ^ either[iota myth]
    ? !(flow_runtime_ops/valid_arguments (allowed.map((\ name=str [($ts name)]))) input) (./err 'flow_invalid_arguments)
    | ./ok input
  + pairs
    ' JSON supplies dynamic ports without another command schema. Preserve
    ' duplicates until they are rejected; never silently choose one binding.
    \ text=str slots=bool
    ^ either[iota row[[str str]]]
    ?> (./ok value end) (author_json/parse text) (./err 'flow_invalid_bindings)
    ?> (./obj members) value (./err 'flow_invalid_bindings)
    % rest=row[jkv] members out=row[[str str]] []
    ^ either[iota row[[str str]]]
    ?> (./some next) rest.pull (./ok out)
    = [member rest] next
    ?> (./str value) member.v (./err 'flow_invalid_bindings)
    < key (flow_author_controls/field_key slots member.k)
    ? (out.any((\ [prior text] (eq prior key)))) (./err 'flow_duplicate_binding)
    | _ rest out.snoc([key value])
  + field_key
    \ slots=bool name=str
    ^ either[iota str]
    ' Declared Goo inputs use canonical native slot paths, including /sys/req.
    ' Flow ports and named evidence retain their existing single-name grammar.
    ? slots
      < slot (flow_ui/address name)
      ? !(slot.len) (./err 'flow_invalid_binding)
      | ./ok (path_show slot)
    < port (flow_ops/name (sval/word (str/to_atom name)))
    ? !(eq name (str/from_atom (quip_val port))) (./err 'flow_invalid_binding)
    | ./ok name
  + ports
    ' Reflected JSON must supply exactly the selected operation's ports.
    \ fields=row[[str str]] ports=row[iota]
    ^ bool
    = expected ports.map((\ port=iota (str/from_atom (quip_val port))))
    | (and (eq fields.len expected.len) (fields.all((\ [key value] (row/has[str] key expected)))))
  + source_input
    ' Semidoc is multiline plain text. Reuse Goo's native code editor and text
    ' wire codec; reject formatting rather than silently erase metadata.
    \ input=myth
    ^ either[iota myth]
    ?> wire=pails/t input.pail_at(['source]) (./err 'flow_invalid_source_input)
    ?> (./ok value end) (author_json/parse wire.t) (./err 'flow_invalid_source_input)
    ?> (./some source) (goo_text/decode value) (./err 'flow_invalid_source_input)
    ? !(source.all((\ run=goo/runt (eq run.myth.size 0)))) (./err 'flow_source_requires_plain_text)
    | ./ok input.put(['source] (pails/t source.plain))
  + create_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["new_name" "source"] input)
    < name (flow_ops/name (sval/word (str/to_atom input.txt_at(['new_name]))))
    = destination=path [state.self 'app 'nenex 'w name]
      request (myth/sing ['source] input.pail_at(['source])).put(['expected] (pails/n 0))
    | namespace_command/plan destination (flow_ops/key state.self 'author) request state
  + save_source
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < fields (flow_author_controls/fields ["source"] input)
    = request input.put(['expected] (pails/n state.case(.x target).fall(0)))
    | namespace_command/plan target (flow_ops/key state.self 'author) request state
  + inspect_callables
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["selection_name" "scope" "scope_care"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < scope (flow_ui/address (field "scope"))
    = selected (field "scope_care")
    ? !(row/has[str] selected ["" "x" "z"]) (./err 'flow_invalid_inspection_care)
    = input (myth/sing ['name] (pails/p [name])).put(['source] (safe 0 (? (eq selected "x") .x .z) scope))
    | namespace_command/plan page (flow_ops/key state.self 'inspect_callables) input state
  + select_step
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["selection_name" "mode" "definition"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < definition (flow_ui/address (field "definition"))
    < origin (flow_ops/origin (seg_texts definition))
    = input (myth/sing ['name] (pails/p [name])).put(['selected] origin).put(['mode] (pails/t (field "mode")))
    | namespace_command/plan page (flow_ops/key state.self 'select_step) input state
  + compose
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/source_input fields)
    < fields (flow_author_controls/fields ["name" "selected_version" "selected_definition" "source" "flow_name" "step_name" "result" "new_inputs" "bindings"] fields)
    < bindings (flow_author_controls/pairs fields.txt_at(['bindings]) .false)
    = field (\ name=str fields.txt_at([($ts name)]))
    < selection_name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = record (cooperate_ops/record page.weld(['cells selection_name]) state).fall(myth/new)
    ?> saved=native_work/captured record.pail_at(['capture]) (./err 'flow_missing_selection)
    ? !(record.has(['flow 'author_mode])) (./err 'flow_invalid_selection)
    ? !(eq (field "selected_version") (nat/show saved.source.ver)) (./err 'flow_stale_selection)
    ? !(eq (field "selected_definition") (path_show saved.source.path)) (./err 'flow_stale_selection)
    < id (flow_ops/name (sval/word (str/to_atom (field "flow_name"))))
    < step (flow_ops/name (sval/word (str/to_atom (field "step_name"))))
    < result (flow_ops/name (sval/word (str/to_atom (field "result"))))
    < inputs (flow_ui/word_list (field "new_inputs"))
    = mode record.txt_at(['flow 'author_mode])
      ports (flow_ui/callable_ports mode (unpin saved.value).fil.fall(myth/new) state.self)
    ? !(flow_author_controls/ports bindings ports) (./err 'flow_port_mismatch)
    = input (myth/sing ['flow] (pails/p [id])).put(['step] (pails/p [step])).put(['result] (pails/p [result]))
      input input.put(['mode] (pails/t mode)).put(['selected] saved.source).put(['inputs] (pails/p inputs))
      input input.put(['source] (pails/t (field "source"))).put(['expected] (pails/n state.case(.x page).fall(0)))
    < input (flow_author_controls/composition_bindings bindings input)
    | namespace_command/plan page (flow_ops/key state.self 'compose) input state
  + select
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["occurrence_name" "definition"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "occurrence_name"))))
    < definition (flow_ui/address (field "definition"))
    = input (myth/sing ['name] (pails/p [name])).put(['definition] (safe 0 .x definition))
    | namespace_command/plan page (flow_ops/key state.self 'select) input state
  + embed
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/source_input fields)
    < fields (flow_author_controls/fields ["name" "selected_version" "selected_definition" "source" "destination" "writer" "provider" "bindings"] fields)
    < bindings (flow_author_controls/pairs fields.txt_at(['bindings]) .false)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = selection=path page.weld(['cells name])
      record (cooperate_ops/record selection state).fall(myth/new)
    ?> saved=native_work/captured record.pail_at(['capture]) (./err 'flow_missing_selection)
    ? !(eq (field "selected_version") (nat/show saved.source.ver)) (./err 'flow_stale_selection)
    ? !(eq (field "selected_definition") (path_show saved.source.path)) (./err 'flow_stale_selection)
    ?> compiled=flow/definition (unpin saved.value).fil.fall(myth/new).pail_at((flow_ops/key state.self 'definition)) (./err 'flow_invalid_definition)
    ? !(flow_author_controls/ports bindings compiled.inputs) (./err 'flow_port_mismatch)
    < destination (flow_ui/address (field "destination"))
    < writer (flow_ui/address (field "writer"))
    = request (myth/sing ['definition] saved.source).put(['destination] (pails/p destination)).put(['writer] (safe 0 .x writer))
    < request (flow_author_controls/references bindings 'input request)
    < request (flow_ui/provider (field "provider") request)
    = input request.put(['selection] (safe 0 .x selection)).put(['expected] (pails/n state.case(.x page).fall(0)))
      input input.put(['source] (pails/t (field "source")))
    | namespace_command/plan page (flow_ops/key state.self 'embed) input state
  + bind_source
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_page"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < source (flow_ui/address (field "source_page"))
    < name (flow_ops/name (sval/word (str/to_atom (field "source_name"))))
    = input (myth/sing ['source] (safe 0 .x source)).put(['name] (pails/p [name]))
    | namespace_command/plan page (flow_ops/key state.self 'bind_page_source) input state
  + bind_file
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_file" "source_mount" "source_format"] input)
    | flow_author_controls/source_binding target "bind_file" fields state
  + bind_url
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["source_name" "source_url" "previous_url"] input)
    | flow_author_controls/source_binding target "bind_url" fields state
  + retry
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["request"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < request (flow_ui/address (field "request"))
    ? !(and (pith_prefix page.weld(['work]) request) (eq request.len (add page.len 4))) (./err 'flow_invalid_revision_target)
    = input (myth/sing ['expected] (pails/n state.case(.x request).fall(0)))
    | namespace_command/plan request (flow_ops/key state.self 'retry_revision) input state
  + pause
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_author_controls/controller 'pause target input state
  + resume
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_author_controls/controller 'resume target input state
  + detach
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    | flow_author_controls/controller 'detach target input state
  + adopt
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller" "selection" "previous"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < controller (flow_ui/address (field "controller"))
    ? !(and (pith_prefix page.snoc('work) controller) (eq controller.len (add page.len 2))) (./err 'flow_invalid_controller)
    < selection (flow_ui/address (field "selection"))
    ? !(and (pith_prefix page.snoc('cells) selection) (eq selection.len (add page.len 2))) (./err 'flow_invalid_selection)
    ?> saved=native_work/captured (cooperate_ops/record selection state).fall(myth/new).pail_at(['capture]) (./err 'flow_invalid_selection)
    < previous_path (flow_ui/address (field "previous"))
    < previous (flow_ops/origin (seg_texts previous_path))
    = input (myth/sing ['definition] saved.source).put(['previous] previous)
    | namespace_command/plan controller (flow_ops/key state.self 'adopt) input state
  + references
    \ pairs=row[[str str]] prefix=iota input=myth
    ^ either[iota myth]
    ?> (./some next) pairs.pull (./ok input)
    = [entry rest] next
      [name text] entry
    < path (flow_ui/address text)
    | flow_author_controls/references rest prefix input.put([prefix ($ts name)] (safe 0 .z path))
  + open_work
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["id" "content" "context"] input)
    < context (flow_author_controls/pairs input.txt_at(['context]) .false)
    < request (flow_author_controls/references context 'context input.del(['context]))
    | namespace_command/plan target (cooperate_ops/key state.self 'open) request state
  + delegate
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["activity" "id" "prompt" "response_schema" "provider" "guard"] input)
    < activity (flow_ui/address input.txt_at(['activity]))
    < provider (flow_ui/address input.txt_at(['provider]))
    < guard (flow_ui/address input.txt_at(['guard]))
    = request input.del(['activity]).del(['response_schema]).put(['schema] input.pail_at(['response_schema]))
      request request.put(['provider] (safe 0 .x provider)).put(['guard] (safe 0 .z guard))
    | namespace_command/plan activity (cooperate_ops/key state.self 'delegate) request state
  + ask
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["id" "content" "shape" "context" "resume"] input)
    < context (flow_ui/address input.txt_at(['context]))
    < resume (flow_ui/address input.txt_at(['resume]))
    = request input.put(['context] (safe 0 .z context)).put(['resume] (pails/p resume))
    | namespace_command/plan target (cooperate_ops/key state.self 'ask) request state
  + inspect_actions
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["selection_name" "object" "view"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    ?> (./some owner) (nenex_edit/owner page state) (./err 'flow_missing_document)
    ? !(equal[path] owner page) (./err 'flow_nenex_destination)
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < target (flow_ui/address (field "object"))
    < view (flow_ui/address (field "view"))
    | namespace_command/plan page.weld(['cells name]) (flow_ops/key state.self 'inspect_actions)
        ((myth/sing ['target] (pails/p target)).put(['view] (pails/p view))) state
  + extract
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["new_name" "attempt" "steps"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < attempt (flow_ui/address (field "attempt"))
    < origin (flow_ops/origin (seg_texts attempt))
    < steps (flow_ui/word_list (field "steps"))
    = target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['name] (pails/p [name])).put(['attempt] origin).put(['steps] (pails/p steps)).put(['expected] (pails/n 0))
    | namespace_command/plan target (flow_ops/key state.self 'extract) input state
  + extract_trace
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["new_name" "run" "events" "sequence"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < run (flow_ui/address (field "run"))
    = relative run.drop(page.len)
      direct (eq relative.len 2)
      worker (and (eq relative.len 4) (equal[iota] relative.at(2) 'workers))
    ? !(and (pith_prefix page.weld(['work]) run) (direct || worker)) (./err 'flow_missing_investigation)
    < events (flow_ui/word_list (field "events"))
    ?> (./some sequence) (nat/parse (field "sequence")) (./err 'flow_stale_trace)
    = target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['name] (pails/p [name])).put(['run] (pails/p run)).put(['events] (pails/p events)).put(['sequence] (pails/n sequence))
    | namespace_command/plan target (flow_ops/key state.self 'extract_trace) input state
  + create
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["new_name" "kind" "uses" "brief"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "new_name"))))
    < uses (flow_ops/names ((split_byte 32 (str/to_atom (field "uses"))).map((\ word (sval/word word)))))
    = document (eq (field "kind") "document")
    ? (and document !(uses.len)) (./err 'flow_missing_page_sources)
    = brief (field "brief")
    ? (gt brief.len 8192) (./err 'flow_invalid_brief)
    = source (? document (flow_ui/template state.self name uses brief) (flow_ui/composition state.self name brief))
      target=path [state.self 'app 'nenex 'w ($ts (weft/cat2 (quip_val name) "_flow"))]
      input (myth/sing ['source] (pails/t source)).put(['expected] (pails/n 0))
    | namespace_command/plan target (flow_ops/key state.self 'author) input state
  + capture
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["capture"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < mount (flow_ui/address (field "capture"))
    | namespace_command/plan mount mount.weld(['op 'rescan]) myth/new state
  + submit
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/source_input fields)
    < fields (flow_author_controls/fields ["request" "source" "note"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < request (flow_ui/address (field "request"))
    ? !(equal[path] page request.snoc('draft)) (./err 'flow_invalid_revision_target)
    ? !(eq (field "source") (cooperate_ops/record page state).fall(myth/new).txt_at(['src])) (./err 'flow_draft_edited)
    = input (myth/sing ['source] (pails/t (field "source"))).put(['note] (pails/t (field "note")))
      input input.put(['expected] (pails/n state.case(.x page).fall(0)))
    | namespace_command/plan request (flow_ops/key state.self 'submit_revision) input state
  + select_action
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["catalogue" "selection_name" "control" "arguments"] fields)
    < arguments (flow_author_controls/pairs fields.txt_at(['arguments]) .true)
    = field (\ name=str fields.txt_at([($ts name)]))
    ?> (./some owner) (nenex_edit/owner page state) (./err 'flow_missing_document)
    ? !(equal[path] owner page) (./err 'flow_nenex_destination)
    < catalogue (flow_ops/name (sval/word (str/to_atom (field "catalogue"))))
    < name (flow_ops/name (sval/word (str/to_atom (field "selection_name"))))
    < route (flow_ui/address (field "control"))
    = card (cooperate_ops/record page.weld(['cells catalogue]) state).fall(myth/new)
    ? !(card.has(['flow 'action_catalog])) (./err 'flow_missing_selection)
    ?> saved=native_work/captured card.pail_at(['capture]) (./err 'flow_missing_selection)
    = selected (unpin saved.value).get(route).fall(myth/new)
    ?> query=goo_runtime/request selected.pail_at(['goo 'request]) (./err 'flow_invalid_action)
    ?> (./ok prepared) (goo_runtime/current query state) (./err 'flow_stale_selection)
    = inputs arguments.map((flow_author_controls/action_argument selected))
    | namespace_command/plan page.weld(['cells name]) (flow_ops/key state.self 'capture_action)
        (myth/sing ['goo 'request] query.set_inputs(inputs)) state
  + review_trace
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < input (flow_author_controls/source_input input)
    < input (flow_author_controls/fields ["source"] input)
    | namespace_command/plan target (flow_ops/key state.self 'review_trace)
        input.put(['expected] (pails/n state.case(.x target).fall(0))) state
  + attach
    \ page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["name" "published" "destination" "writer" "provider" "bindings"] fields)
    = field (\ name=str fields.txt_at([($ts name)]))
    < name (flow_ops/name (sval/word (str/to_atom (field "name"))))
    = definition page.weld(['flows name])
    ?> (./some held) (cooperate_ops/record definition state).fall(myth/new).get((flow_ops/key state.self 'definition)) (./err 'flow_missing_definition)
    ?> published=flow/definition held (./err 'flow_invalid_definition)
    ? !(eq (field "published") published.text) (./err 'flow_stale_definition)
    < bindings (flow_author_controls/pairs fields.txt_at(['bindings]) .false)
    ? !(flow_author_controls/ports bindings published.inputs) (./err 'flow_port_mismatch)
    < destination (flow_ui/address (field "destination"))
    < writer (flow_ui/address (? (field "writer").len (field "writer") (path_show (flow_ops/key state.self 'nenex))))
    = controller page.weld(['work ($ts (weft/cat2 "maintenance_" (quip_val name)))])
      input (myth/sing ['definition] (safe 0 .x definition)).put(['destination] (pails/p destination)).put(['writer] (safe 0 .x writer))
    < input (flow_author_controls/references bindings 'input input)
    < input (flow_ui/provider (field "provider") input)
    | namespace_command/plan controller (flow_ops/key state.self 'follow) input state
  + occurrence
    ' The embedded control's receiver is the existing controller itself.
    \ verb=iota target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? input.tap.len (./err 'flow_invalid_arguments)
    ?> config=flow_maintenance/config (cooperate_ops/record target state).fall(myth/new).pail_at(['flow 'config])
      | ./err 'flow_missing_controller
    = request=myth (? (equal[iota] verb 'detach) myth/new (myth/sing ['enabled] (pails/b (equal[iota] verb 'resume))))
      operation=iota (? (equal[iota] verb 'detach) 'detach 'set_enabled)
    | namespace_command/plan target (flow_ops/key state.self operation) request state
  + action_argument
    \ selected=myth field=[str str]
    ^ [str str]
    = [key value] field
      slot=path (path_parse key).fall([])
      rich (eq selected.txt_at(slot.weld(['goo 'input])) "rich_text")
      encoded (? rich (show (goo_text/encode (goo/text/en value))) value)
    | [key encoded]
  + composition_bindings
    \ pairs=row[[str str]] input=myth
    ^ either[iota myth]
    ?> (./some next) pairs.pull (./ok input)
    = [field rest] next
      [name text] field
    < value (flow_ops/name (sval/word (str/to_atom text)))
    | flow_author_controls/composition_bindings rest input.put(['binding ($ts name)] (pails/p [value]))
  + controller
    \ verb=iota page=path fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < fields (flow_author_controls/fields ["controller"] fields)
    < controller (flow_ui/address fields.txt_at(['controller]))
    ? !(and (pith_prefix page.weld(['work]) controller) (eq controller.len (add page.len 2))) (./err 'flow_invalid_controller)
    | flow_author_controls/occurrence verb controller myth/new state
  + source_binding
    ' Source controls use the existing watch owner and named input defaults.
    \ page=path action=str fields=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    < name (flow_ops/name (sval/word (str/to_atom fields.txt_at(['source_name]))))
    ? !((cooperate_ops/record page state).fall(myth/new).has(['src])) (./err 'flow_missing_document)
    = settings=path page.weld(['flows 'defaults])
      existing_defaults (cooperate_ops/record settings state)
      defaults existing_defaults.fall(myth/new)
    ? (eq action "bind_file")
      < source (flow_ui/address fields.txt_at(['source_file]))
      < mount (flow_ui/address fields.txt_at(['source_mount]))
      = feed=path page.weld(['inputs ($ts (str/cat_all [(str/from_atom (quip_val name)) "_file"]))])
        format fields.txt_at(['source_format])
        input (myth/sing ['source] (safe 0 .x source)).put(['mount] (pails/p mount)).put(['name] (pails/p [name])).put(['format] (pails/t (? format.len format "md")))
        input input.put(['expected] (pails/n state.case(.x feed).fall(0)))
      < writes (flow_sources_ops/watch feed input state)
      = value defaults.put(['input 'sources] (safe 0 .z (row/cons[iota] 'x feed)))
      | ./ok writes.snoc([settings (? existing_defaults.is_some (writ/poke value) (writ/make value))])
    = url fields.txt_at(['source_url])
    ? !(flow_web_ops/valid_url url) (./err 'flow_invalid_url)
    = collection=path page.weld(['inputs 'urls])
      target=path collection.snoc(name)
      value (myth/sing ['url] (pails/t url))
      existing (cooperate_ops/record target state)
      writes=either[iota row[[path writ]]]
        ?> (./some prior) existing (./ok [[target (writ/make value)]])
        ?> previous=pails/t prior.pail_at(['url]) (./err 'flow_source_collision)
        ? (eq previous.t url) (./ok [])
        = expected fields.txt_at(['previous_url])
        ? !(expected.len) (./err 'flow_source_collision)
        ? !(eq previous.t expected) (./err 'flow_stale_source)
        | ./ok [[target (writ/poke value)]]
    < writes writes
    = value defaults.put(['input 'urls] (safe 0 .z collection))
    | ./ok writes.snoc([settings (? existing_defaults.is_some (writ/poke value) (writ/make value))])
