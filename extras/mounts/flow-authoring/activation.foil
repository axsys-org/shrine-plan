- grove_install
- flow_interface

' Install the native commands plus the Nenex contributions for this mount.
+ flows_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    ? (flow_ui/registrations state)
     > (./err why) (./err (pails/q why))
     > (./ok writes)
      ? (grove_install/changes writes state)
       > (./err why) (./err (pails/q why))
       > (./ok next) (./ok next)
