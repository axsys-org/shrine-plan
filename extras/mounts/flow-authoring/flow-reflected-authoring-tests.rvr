(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))

;; Compile the production Grove source. Browser HTTP decoding and native
;; reflected invocation are compared against the same disposable world.
(define (run include-surface)
  (define compiler (Pin "flow-reflected-authoring-test"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define modules (Weld ["grove_backend" "flow_author_controls" "flow_reflected_authoring_tests"]
    (If include-surface ["flow_surface_tests"] [])))
  (define local (bootstrap:build-local ("x" 17) system resolve slot modules))
  (define code (_1 local))
  (DeepSeq code (print "Authoring fixture compiled"))
  (define prepared (backend:prepare-with code "flow_author_controls"))
  (define module (_1 prepared))
  (define fixture (Unpin (_1 (need (find (lambda (pair)
    (Equal "flow_reflected_authoring_tests" (_0 pair))) (_2 code))))))
  (define (helper name) (driver:get-perc ["flow_reflected_authoring_tests" name] fixture))
  (define (path names) (Weld [("x" 17)] (map (lambda (name) ("ts" name)) names)))
  (define (ok result)
    (If (Equal "ok" (Hd result)) (_0 result)
      (error ["flow-reflected-authoring" (_0 result)])))
  (define (publish prepared root text state)
    (define document (ok ((driver:get-perc ["grove" "parse"] module) text)))
    (define (previous key)
      ((helper "previous") state (map (lambda (part) ((_0 part) (_1 part))) key)))
    (define (lookup key)
      (define absolute
        (If (And (Sz key) (Or (Eq "x" (Hd (_0 key))) (Equal ("ts" "sys") (_0 key))))
          key (Weld [("x" 17)] key)))
      ((helper "lookup") state absolute))
    (define records (ok (backend:compile prepared previous lookup root document)))
    (_0 (ok (backend:publish prepared records 0 0 state))))
  (define base ((helper "bootstrap") (_0 local)))
  (DeepSeq base (print "Native fixture bootstrap complete"))
  (define initial ((helper "initial") base))
  (DeepSeq initial (print "Semidoc source authored"))
  (define codecs (publish prepared (path ["lib" "grove" "types"])
    (read-text-file "grove/value_codecs.grove") initial))
  (DeepSeq codecs (print "Codecs published into authored fixture"))
  (define authored (publish prepared (path ["gov" "flows" "authoring"])
    (read-text-file "grove/flows/authoring.grove") codecs))
  (DeepSeq authored (print "Production authoring Grove published"))
  (define authored (publish (backend:prepare-with code "flow_examples")
    (path ["gov" "flow_examples"])
    (read-text-file "grove/flow-examples/catalogue.grove") authored))
  (DeepSeq authored (print "Production example catalogue published"))
  (define results (Weld ((helper "report") authored)
    (If include-surface
      ((driver:get-perc ["flow_surface_tests" "report"]
        (Unpin (_1 (need (find (lambda (pair) (Equal "flow_surface_tests" (_0 pair))) (_2 code)))))) authored)
      [])))
  (DeepSeq (map (lambda (row)
    (print ("TEST" (If (_1 row) "pass" "fail") "flow-reflected-authoring-tests"
      (_0 row) (_2 row) (_3 row)))) results) 0)
  (foldl (lambda (passed row) (And passed (_1 row))) 1 results))
(define (checked include-surface)
  (define outcome (Try (lambda (include)
    (let ((passed (run include))) (DeepSeq passed passed))) include-surface))
  (If (Eq 1 (Hd outcome)) (Seq (print outcome) 0) (_0 outcome)))
(define (check ignored) (checked 1))
(define (check-authoring ignored) (checked 0))
(#export check check-authoring)
