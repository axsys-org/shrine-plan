  #on ; %/document
  new_name: plain
  attempt: plain
  steps: plain
  ! foil
  \ new_name=str attempt=str steps=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

