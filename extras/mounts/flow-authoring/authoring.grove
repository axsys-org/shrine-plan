#import plain=lib/grove/types/text

request =
  @role
  "/work/status": plain
  #opt ;
    "/sys/content": plain

retry_request =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/retry_request)
  #on ; %/request
  ! foil
  \ request=%/request
  ^ %/request
  | Seq[%/request] (error (pails/t "Requires native request admission.")) request

request_status =
  @view
  #on ; %/request
  #for ; /sys/slot/flow_request
  request => col('/sys/slot/content) {
    path(request, '/sys/slot/caption)
    show(request.status, '/sys/slot/title)
    show(request.content, '/sys/slot/content)
    group(on = request, action = %/retry_request) { action("Retry failed request") }
  }

document =
  @role
  src: plain

create_child_source =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/create_child_source)
  #on ; %/document
  new_name: plain
  source: plain
  ! foil
  \ new_name=str source=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native document admission.")) page

publication =
  @slot

refresh_harness =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/refresh)
  #on ; %/document
  ! foil
  \ page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native harness refresh.")) page

publish =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_ops/publish)
  #on ; %/document
  id: plain
  ! foil
  \ id=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native flow publication.")) page

publish_flow =
  @view
  #on ; %/document
  #for ; %/publication
  page => group(on = page, action = %/publish, myth = { '/id = .input("") }) {
    col('/sys/slot/content) {
      text("Flow name from this page", '/sys/slot/label)
      input('/id, "text")
      action("Publish flow")
    }
  }

authoring =
  @slot

create_source =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/create_source)
  #on ; %/document
  new_name: plain
  source: plain
  ! foil
  \ new_name=str source=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

