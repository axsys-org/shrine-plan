  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/capture)
  #on ; %/document
  capture: plain
  ! foil
  \ capture=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

submit =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/submit)
  #on ; %/document
  request: plain
  source: plain
  note: plain
  ! foil
  \ request=str source=str note=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

select_action =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/select_action)
  #on ; %/document
  catalogue: plain
  selection_name: plain
  control: plain
  arguments: plain
  ! foil
  \ catalogue=str selection_name=str control=str arguments=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

review_trace =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/review_trace)
  #on ; %/document
  source: plain
  ! foil
  \ source=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

attach =
  @action
  #meta ;
    "/sys/op": (namespace_op flow_author_controls/attach)
  #on ; %/document
  name: plain
  published: plain
  destination: plain
  writer: plain
  provider: plain
  bindings: plain
  ! foil
  \ name=str published=str destination=str writer=str provider=str bindings=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

author_flow =
  @view
  #on ; %/document
  #for ; %/authoring
  page => col('/sys/slot/content) {
    group(on = page, action = %/refresh_harness) {
      action("Refresh installed flow operations")
    }
    group(on = page, action = %/create_source, myth = { '/new_name = .input(""), '/source = .input("") }) {
      col('/sys/slot/content) {
        text("Create Semidoc page", '/sys/slot/label)
        text("New page name")
        input('/new_name, "text")
        text("Semidoc source")
        input('/source, "rich-code")
        action("Create Semidoc page")
      }
    }
    group(on = page, action = %/create_child_source, myth = { '/new_name = .input(""), '/source = .input("") }) {
      col('/sys/slot/content) {
        text("Child page name", '/sys/slot/label)
        input('/new_name, "text")
        text("Semidoc source", '/sys/slot/label)
        input('/source, "rich-code")
        action("Create child document")
      }
    }
    group(on = page, action = %/save_source, myth = { '/source = .input(page.src) }) {
      col('/sys/slot/content) {
        text("Save Semidoc source", '/sys/slot/label)
        text("Semidoc source")
        input('/source, "rich-code")
        action("Save Semidoc source")
      }
    }
    group(on = page, action = %/inspect_callables, myth = { '/selection_name = .input(""), '/scope = .input(""), '/scope_care = .input("z") }) {
      col('/sys/slot/content) {
        text("Inspect callable definitions", '/sys/slot/label)
        text("Catalogue cell name")
        input('/selection_name, "text")
        text("Namespace subtree")
        input('/scope, "text")
        text("Inspection care (x: own record, z: subtree)")
        input('/scope_care, "text")
        action("Inspect callable definitions")
      }
    }
    group(on = page, action = %/select_step, myth = { '/selection_name = .input(""), '/mode = .input("step"), '/definition = .input("") }) {
      col('/sys/slot/content) {
        text("Select callable", '/sys/slot/label)
        text("Selection cell name")
        input('/selection_name, "text")
        text("step or invoke")
        input('/mode, "text")
        text("Callable path")
        input('/definition, "text")
        action("Select callable")
      }
    }
    group(on = page, action = %/compose, myth = { '/name = .input(""), '/selected_version = .input(""), '/selected_definition = .input(""), '/source = .input(page.src), '/flow_name = .input(""), '/step_name = .input(""), '/result = .input(""), '/new_inputs = .input(""), '/bindings = .input("{}") }) {
      col('/sys/slot/content) {
        text("Compose selected callable", '/sys/slot/label)
        text("Selection cell name")
        input('/name, "text")
        text("Captured version")
        input('/selected_version, "text")
        text("Captured definition path")
        input('/selected_definition, "text")
        text("Current Semidoc source")
        input('/source, "rich-code")
        text("Flow name")
        input('/flow_name, "text")
        text("Step name")
        input('/step_name, "text")
        text("Result step")
        input('/result, "text")
        text("New input names, separated by spaces")
        input('/new_inputs, "text")
        text("Port to input or step name, as a JSON object")
        input('/bindings, "text")
        action("Compose selected callable")
      }
    }
    group(on = page, action = %/select, myth = { '/occurrence_name = .input(""), '/definition = .input("") }) {
      col('/sys/slot/content) {
        text("Select published flow", '/sys/slot/label)
        text("Occurrence name")
        input('/occurrence_name, "text")
        text("Published flow path")
        input('/definition, "text")
        action("Select published flow")
      }
    }
    group(on = page, action = %/embed, myth = { '/name = .input(""), '/selected_version = .input(""), '/selected_definition = .input(""), '/source = .input(page.src), '/destination = .input(""), '/writer = .input(""), '/provider = .input(""), '/bindings = .input("{}") }) {
      col('/sys/slot/content) {
        text("Embed selected flow", '/sys/slot/label)
        text("Selection cell name")
        input('/name, "text")
        text("Captured version")
        input('/selected_version, "text")
        text("Captured definition path")
        input('/selected_definition, "text")
        text("Current Semidoc source")
        input('/source, "rich-code")
        text("Result destination")
        input('/destination, "text")
        text("Writer path")
        input('/writer, "text")
        text("Provider path, or empty for manual work")
        input('/provider, "text")
        text("Input to evidence path, as a JSON object")
        input('/bindings, "text")
        action("Embed selected flow")
      }
    }
    group(on = page, action = %/bind_source, myth = { '/source_name = .input(""), '/source_page = .input("") }) {
      col('/sys/slot/content) {
        text("Bind Nenex evidence", '/sys/slot/label)
        text("Evidence key")
        input('/source_name, "text")
        text("Nenex source page")
        input('/source_page, "text")
        action("Bind Nenex evidence")
      }
    }
    group(on = page, action = %/bind_file, myth = { '/source_name = .input(""), '/source_file = .input(""), '/source_mount = .input(""), '/source_format = .input("md") }) {
      col('/sys/slot/content) {
        text("Bind filesystem evidence", '/sys/slot/label)
        text("Evidence key")
        input('/source_name, "text")
        text("Filesystem source record")
        input('/source_file, "text")
        text("Filesystem mount")
        input('/source_mount, "text")
        text("Source format (md, text, json, foil, rvr)")
        input('/source_format, "text")
        action("Bind filesystem evidence")
      }
    }
    group(on = page, action = %/bind_url, myth = { '/source_name = .input(""), '/source_url = .input(""), '/previous_url = .input("") }) {
      col('/sys/slot/content) {
        text("Bind web evidence", '/sys/slot/label)
        text("Evidence key")
        input('/source_name, "text")
        text("HTTP source URL")
        input('/source_url, "text")
        text("Previous URL when rebinding", '/sys/slot/label)
        input('/previous_url, "text")
        action("Bind web evidence")
      }
    }
    group(on = page, action = %/retry, myth = { '/request = .input("") }) {
      col('/sys/slot/content) {
        text("Retry revision", '/sys/slot/label)
        text("Revision request path")
        input('/request, "text")
        action("Retry revision")
      }
    }
    group(on = page, action = %/pause, myth = { '/controller = .input("") }) {
      col('/sys/slot/content) {
        text("Pause occurrence", '/sys/slot/label)
        text("Occurrence work path")
        input('/controller, "text")
        action("Pause occurrence")
      }
    }
    group(on = page, action = %/resume, myth = { '/controller = .input("") }) {
      col('/sys/slot/content) {
        text("Resume occurrence", '/sys/slot/label)
        text("Occurrence work path")
        input('/controller, "text")
        action("Resume occurrence")
      }
    }
    group(on = page, action = %/detach, myth = { '/controller = .input("") }) {
      col('/sys/slot/content) {
        text("Detach occurrence", '/sys/slot/label)
        text("Occurrence work path")
        input('/controller, "text")
        action("Detach occurrence")
      }
    }
    group(on = page, action = %/adopt, myth = { '/controller = .input(""), '/selection = .input(""), '/previous = .input("") }) {
      col('/sys/slot/content) {
        text("Adopt selected publication", '/sys/slot/label)
        text("Occurrence work path")
        input('/controller, "text")
        text("New definition selection cell")
        input('/selection, "text")
        text("Previously captured definition address")
        input('/previous, "text")
        action("Adopt selected publication")
      }
    }
    group(on = page, action = %/open_work, myth = { '/id = .input(""), '/content = .input(""), '/context = .input("{}") }) {
      col('/sys/slot/content) {
        text("Open investigation", '/sys/slot/label)
        text("Investigation name")
        input('/id, "text")
        text("Objective")
        input('/content, "text")
        text("Evidence key to source path, as a JSON object")
        input('/context, "text")
        action("Open investigation")
      }
    }
    group(on = page, action = %/delegate, myth = { '/activity = .input(""), '/id = .input(""), '/prompt = .input(""), '/response_schema = .input(""), '/provider = .input(""), '/guard = .input("") }) {
      col('/sys/slot/content) {
        text("Delegate native work", '/sys/slot/label)
        text("Open activity path")
        input('/activity, "text")
        text("Worker name")
        input('/id, "text")
        text("Objective and instructions")
        input('/prompt, "text")
        text("Output schema, or empty")
        input('/response_schema, "text")
        text("Native provider path")
        input('/provider, "text")
        text("Guard evidence path")
        input('/guard, "text")
        action("Delegate native work")
      }
    }
    group(on = page, action = %/ask, myth = { '/id = .input(""), '/content = .input(""), '/shape = .input(""), '/context = .input(""), '/resume = .input("") }) {
      col('/sys/slot/content) {
        text("Retain unresolved question", '/sys/slot/label)
        text("Hole name")
        input('/id, "text")
        text("Question")
        input('/content, "text")
        text("Expected evidence")
        input('/shape, "text")
        text("Live evidence path")
        input('/context, "text")
        text("Open activity to resume")
        input('/resume, "text")
        action("Retain unresolved question")
      }
    }
    group(on = page, action = %/inspect_actions, myth = { '/selection_name = .input(""), '/object = .input(""), '/view = .input("") }) {
      col('/sys/slot/content) {
        text("Selection name", '/sys/slot/label)
        input('/selection_name, "text")
        text("Object", '/sys/slot/label)
        input('/object, "text")
        text("View", '/sys/slot/label)
        input('/view, "text")
        action("Inspect declared Goo actions")
      }
    }
    group(on = page, action = %/extract, myth = { '/new_name = .input(""), '/attempt = .input(""), '/steps = .input("") }) {
      col('/sys/slot/content) {
        text("New name", '/sys/slot/label)
        input('/new_name, "text")
        text("Attempt", '/sys/slot/label)
        input('/attempt, "text")
        text("Steps", '/sys/slot/label)
        input('/steps, "text")
        action("Extract retained flow steps")
      }
    }
    group(on = page, action = %/extract_trace, myth = { '/new_name = .input(""), '/run = .input(""), '/events = .input(""), '/sequence = .input("") }) {
      col('/sys/slot/content) {
        text("New name", '/sys/slot/label)
        input('/new_name, "text")
        text("Run", '/sys/slot/label)
        input('/run, "text")
        text("Events", '/sys/slot/label)
        input('/events, "text")
        text("Sequence", '/sys/slot/label)
        input('/sequence, "text")
        action("Extract selected investigation events")
      }
    }
    group(on = page, action = %/create, myth = { '/new_name = .input(""), '/kind = .input(""), '/uses = .input(""), '/brief = .input("") }) {
      col('/sys/slot/content) {
        text("New name", '/sys/slot/label)
        input('/new_name, "text")
        text("Kind", '/sys/slot/label)
        input('/kind, "text")
        text("Uses", '/sys/slot/label)
        input('/uses, "text")
        text("Brief", '/sys/slot/label)
        input('/brief, "text")
        action("Create flow starter")
      }
    }
    group(on = page, action = %/capture, myth = { '/capture = .input("") }) {
      col('/sys/slot/content) {
        text("Capture", '/sys/slot/label)
        input('/capture, "text")
        action("Refresh filesystem capture")
      }
    }
    group(on = page, action = %/submit, myth = { '/request = .input(""), '/source = .input(""), '/note = .input("") }) {
      col('/sys/slot/content) {
        text("Request", '/sys/slot/label)
        input('/request, "text")
        text("Source", '/sys/slot/label)
        input('/source, "rich-code")
        text("Note", '/sys/slot/label)
        input('/note, "text")
        action("Accept saved revision")
      }
    }
    group(on = page, action = %/select_action, myth = { '/catalogue = .input(""), '/selection_name = .input(""), '/control = .input(""), '/arguments = .input("{}") }) {
      col('/sys/slot/content) {
        text("Catalogue", '/sys/slot/label)
        input('/catalogue, "text")
        text("Selection name", '/sys/slot/label)
        input('/selection_name, "text")
        text("Control", '/sys/slot/label)
        input('/control, "text")
        text("Arguments: JSON from canonical input paths, e.g. /sys/req, to text", '/sys/slot/label)
        input('/arguments, "text")
        action("Capture declared action")
      }
    }
    group(on = page, action = %/review_trace, myth = { '/source = .input("") }) {
      col('/sys/slot/content) {
        text("Source", '/sys/slot/label)
        input('/source, "rich-code")
        action("Review extracted trace")
      }
    }
    group(on = page, action = %/attach, myth = { '/name = .input(""), '/published = .input(""), '/destination = .input(""), '/writer = .input(""), '/provider = .input(""), '/bindings = .input("{}") }) {
      col('/sys/slot/content) {
        text("Name", '/sys/slot/label)
        input('/name, "text")
        text("Published", '/sys/slot/label)
        input('/published, "text")
        text("Destination", '/sys/slot/label)
        input('/destination, "text")
        text("Writer", '/sys/slot/label)
        input('/writer, "text")
        text("Provider", '/sys/slot/label)
        input('/provider, "text")
        text("Bindings", '/sys/slot/label)
        input('/bindings, "text")
        action("Attach published flow")
      }
    }

  }

#import content=sys/content

controller =
  @role
  content: plain

occurrence_slot =
  @slot

occurrence_pause =
  @action
  #meta ;
    "/sys/op": (namespace_op (flow_author_controls/occurrence 'pause))
  #on ; %/controller
  ! foil
  \ controller=%/controller
  ^ %/controller
  | Seq[%/controller] (error (pails/t "Requires native flow admission.")) controller

occurrence_resume =
  @action
  #meta ;
    "/sys/op": (namespace_op (flow_author_controls/occurrence 'resume))
  #on ; %/controller
  ! foil
  \ controller=%/controller
  ^ %/controller
  | Seq[%/controller] (error (pails/t "Requires native flow admission.")) controller

occurrence_detach =
  @action
  #meta ;
    "/sys/op": (namespace_op (flow_author_controls/occurrence 'detach))
  #on ; %/controller
  ! foil
  \ controller=%/controller
  ^ %/controller
  | Seq[%/controller] (error (pails/t "Requires native flow admission.")) controller

occurrence =
  @view
  #on ; %/controller
  #for ; %/occurrence_slot
  controller => col('/sys/slot/content) {
    show(controller.content, '/sys/slot/summary)
    group(on = controller, action = %/occurrence_pause) { action("Pause") }
    group(on = controller, action = %/occurrence_resume) { action("Resume") }
    group(on = controller, action = %/occurrence_detach) { action("Detach") }
  }
