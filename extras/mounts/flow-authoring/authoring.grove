  #on ; %/document
  new_name: plain
  kind: plain
  uses: plain
  brief: plain
  ! foil
  \ new_name=str kind=str uses=str brief=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

