  #meta ;
    "/sys/op": (namespace_op flow_author_controls/extract_trace)
  #on ; %/document
  new_name: plain
  run: plain
  events: plain
  sequence: plain
  ! foil
  \ new_name=str run=str events=str sequence=str page=%/document
  ^ %/document
  | Seq[%/document] (error (pails/t "Requires native authoring admission.")) page

