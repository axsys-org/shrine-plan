- json

'  A library package for functions an agent adds with mcp/add-tool. Each
'  takes the call's arguments as [name value] text pairs and answers JSON
'  text. The package declares the tools it publishes in code, in the
'  table add-tool maintains at the end; a function that outgrows this
'  package moves to a package of its own.
+ scratch
  + arg
    '  One argument's text, or the empty string.
    \ name=str args=row[[name=str value=str]]
    ^ str
    = found args.filter((\ [key value] (equal key name)))
    ? (eq found.len 0) ""
    = [key value] found.at(0)
    value
  + example
    '  Echoes its text argument. Here so the package is never empty.
    \ args=row[[name=str value=str]]
    ^ str
    | show (json/obj [(jkv "ok" (json/boo .true)) (jkv "echo" (json/str (scratch/arg "text" args)))])
  ' ---- tools, maintained by mcp/add-tool: name, description, params
  + table
    ^ row[[str str str]]
    [["example" "Echo a text." "text: The text to echo"]]
  + tools
    \ ignored=row[[name=str value=str]]
    ^ str
    = rows scratch/table
    | show (json/arr rows.map((\ [name desc params] (json/obj [(jkv "name" (json/str name)) (jkv "description" (json/str desc)) (jkv "params" (json/str params))]))))
