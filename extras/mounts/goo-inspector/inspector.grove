#import text=lib/grove/types/text
#import lede=sys/lede

record =
  @role
  #opt ;
    lede: text

summary =
  @view
  #on ; %/record
  #for ; /sys/slot/inspector_summary
  record => {
    or {
      show(record.lede, '/sys/slot/label)
      show("Namespace record", '/sys/slot/label)
    }
  }

#import path_type=lib/grove/types/path

source_path =
  @slot

context =
  @role
  %/source_path: path_type

workspace =
  @pane
  #on ; %/context
  #for ; /sys/slot/inspector_workspace
  inspector => {
    show("Goo inspector", '/sys/slot/title)
    navigate('/address, source = inspector.source_path, mode = "input", label = "Inspect path")
    navigate('/parent, source = inspector.source_path, mode = "parent", label = "Parent")
    operation('/reload, operation = '/mount_reload, label = "Reload mount assets")
    operation_status('/reload_status, operation = '/mount_reload, label = "Mount publication")
    selection('/object, source = inspector.source_path, topology = "tree", axis = "z") {
      split {
        pane(%/Namespace, ports = { '/object = '/object })
        pane(%/Values, ports = { '/object = '/object })
      }
    }
  }


Values =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Values
  #port ; /object
  inspector => {
    or {
      follow('/value, selection = '/object, slot = '/sys/slot/synthetic)
      show("Select a record to inspect its values.", '/sys/slot/hint)
    }
  }

Namespace =
  @pane
  #on ; %/context
  #for ; /sys/slot/pane/Namespace
  #port ; /object
  inspector => {
    list_tree('/children, source = inspector.source_path, selection = '/object, slot = '/sys/slot/inspector_summary)
  }
