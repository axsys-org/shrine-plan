#import text=lib/grove/types/text
#import lede=sys/lede

record =
  @role
  #opt ;
    lede: text

summary =
  @view
  #on ; %/record
  #for ; /sys/slot/inspector_summary
  record => {
    or {
      show(record.lede, '/sys/slot/title)
      show("Namespace record", '/sys/slot/title)
    }
  }

#import path_type=lib/grove/types/path

source_path =
  @slot

context =
  @role
  %/source_path: path_type

workspace =
  @view
  #on ; %/context
  #for ; /sys/slot/inspector_workspace
  inspector => pane('/Inspector) {
    show("Goo inspector", '/sys/slot/title)
    navigate('/address, source = inspector.source_path, mode = "input", label = "Inspect path")
    navigate('/parent, source = inspector.source_path, mode = "parent", label = "Parent")
    operation('/reload, operation = '/mount_reload, label = "Reload mount assets")
    operation_status('/reload_status, operation = '/mount_reload, label = "Mount publication")
    selection('/object, source = inspector.source_path) {
      split {
        pane('/Namespace) {
          list('/children, source = inspector.source_path, selection = '/object, slot = '/sys/slot/inspector_summary, browse = "Browse children")
        }
        pane('/Values) {
          show("Select a child to inspect its values.", '/sys/slot/hint)
          follow('/value, selection = '/object, slot = '/sys/slot/synthetic)
        }
      }
    }
  }
