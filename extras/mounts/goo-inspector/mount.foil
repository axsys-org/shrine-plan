- explorer_mount
- goo_workspace

+ goo_inspector_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(equal[str] request.method "GET")
          | ./reply (http_driver/response 405 "GET required")
        = url (http_foot/split 63 request.target).at(0)
        ? ((equal url "/goo-inspector") || (equal url "/goo-inspector/"))
          | goo_workspace/request (goo_inspector_mount/endpoint state.self) request now
        = name=str
            ? (equal url "/goo-inspector/style.css") "style.css"
            ""
          found (files.keep((\ [key bytes] (equal key name))))
        ? ((eq name.len 0) || (eq found.len 0))
          | ./reply (http_driver/response 404 "Not found")
        = [name bytes] found.at(0)
          mime=str
            ? (equal name "style.css") "text/css"
            "application/javascript"
        | ./bytes 200 bytes mime
    | http_foot/add_routes [(http_foot/route "/goo-inspector" plan)] http_foot/empty

  + page
    \ target=path content=row[weft/node]
    ^ nat
    = urls=row[str] ["/static/goo-session.js" "/static/goo-panes.js" "/static/goo-actions.js" "/static/goo-workspace.js"]
    = assets=row[weft/node]
        [(weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-fonts.css")] [])
         (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-reference.css")] [])
         (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-panes.css")] [])
         (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/goo-inspector/style.css")] [])]
      scripts=row[weft/node]
        | urls.map
          \ url=str
          | weft/el "script" [(weft/att "src" (str/to_atom url)) (weft/att "defer" "defer")] []
    | weft/page_with_assets "Goo inspector" (row/weld[weft/node] assets scripts)
      [(weft/el "main" [] content)]
  + validate
    \ selected=axal[myth]
    ^ maybe[str]
    ? (and (maybe/is_some selected.fil) (le selected.kid.size 64)) .none
    | ./some "Choose an existing record with at most 64 direct children. Structural paths and larger collections are outside this inspector's current scope."
  + endpoint
    \ self=iota
    ^ goo_workspace/endpoint
    | goo_workspace/endpoint [self 'gov 'goo_inspector 'workspace]
        [self 'gov 'goo_inspector 'source_path] [self 'app 'debug]
        goo_inspector_mount/validate [[['mount_reload] [self 'gov 'goo_inspector]]] goo_inspector_mount/page
  + install
    \ state=namespace
    ^ either[pail namespace]
    | goo_workspace/install (goo_inspector_mount/endpoint state.self) goo_browser/talk state
