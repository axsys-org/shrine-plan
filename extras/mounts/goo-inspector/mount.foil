- web_mount
- json

+ goo_inspector_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(equal[str] request.method "GET")
          | ./reply (http_driver/response 405 "GET required")
        = url (http_foot/split 63 request.target).at(0)
        ? (equal url "/goo-inspector/config.js")
          | ./reply (http_response 200
              (str/to_atom (str/cat_all ["globalThis.GOO_INSPECTOR_ROOT=" (show (json/str (path_show [state.self]))) ";"]))
              "application/javascript")
        = name=str
            ? ((equal url "/goo-inspector") || (equal url "/goo-inspector/")) "index.html"
            ? (equal url "/goo-inspector/app.js") "app.js"
            ? (equal url "/goo-inspector/model.js") "model.js"
            ? (equal url "/goo-inspector/style.css") "style.css"
            ""
          found (files.keep((\ [key bytes] (equal key name))))
        ? ((eq name.len 0) || (eq found.len 0))
          | ./reply (http_driver/response 404 "Not found")
        = [name bytes] found.at(0)
          mime=str
            ? (equal name "index.html") "text/html; charset=utf-8"
            ? (equal name "style.css") "text/css"
            "application/javascript"
        | ./bytes 200 bytes mime
    | http_foot/add_routes [(http_foot/route "/goo-inspector" plan)] http_foot/empty
