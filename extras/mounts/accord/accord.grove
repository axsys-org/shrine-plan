#import lede=sys/lede
#import text=lib/grove/types/text
#import number=lib/grove/types/number

' An agreement of two. Whoever keeps it writes the terms. Each party
' writes a record of its own that says yes and names the version of the
' terms it says yes to. Nobody writes for anyone else, so the agreement is
' two records, each under its own party's signature. It holds when both are
' there and both name the version the terms now stand at; terms that change
' are a new version, and a yes to the old one is not a yes to the new.
' Nothing here decides that: it is read off the three records.

card =
  @role
  #meta ;
    lede: "Anything here that has a title"
  title: text

terms =
  @role
  #meta ;
    lede: "What is agreed to"
  words: text

assent =
  @role
  #meta ;
    lede: "A party's yes, and the version of the terms it is a yes to"
  word: text
  at: number

parties =
  @stencil
  #meta ;
    lede: "A seat for each party"
  #here ; '/parties/[p=@tas]
  #with ; card
  #by ; maker
  #for ; '/parties/[any]

said =
  @stencil
  #meta ;
    lede: "The terms"
  #here ; '/terms
  #with ; terms
  #by ; maker
  #for ; '/parties/[any]

yes =
  @stencil
  #meta ;
    lede: "A party's own yes to the terms at a version"
  #here ; '/terms/yes/[p=@tas]
  #with ; assent
  #by ; '/parties/[p]
  #for ; maker
  #for ; '/parties/[any]

"/" =
  @tree
  title: "An accord"

"/parties" =
  @tree

"/parties/first" =
  @tree
  title: "A party"
  invite: 1

"/parties/second" =
  @tree
  title: "The other party"
  invite: 2
