#import lede=sys/lede
#import text=lib/grove/types/text
#import number=lib/grove/types/number

' A host, as a template. A machine's own world keeps it. Whoever it seats
' as a tenant may ask it to run worlds: a record beneath the tenant's seat
' that names a world and says whether it is to run. The machine's world
' answers beneath each ask with where that world is reached, or why it is
' not run. Nothing here starts anything: which worlds should be running is
' what these records say, and whoever supervises the machine makes it so
' and writes the answer.
'
' A tenant's limit is how many worlds it may have running at once. It is
' ordinary state on the seat, read by whoever answers.

tenant =
  @role
  #meta ;
    lede: "Who may have worlds run here, and how many at once"
  title: text
  limit: number

asked =
  @role
  #meta ;
    lede: "A world a tenant asks to have run: its name, the founding it starts under (empty for a world that is its own), the mounts it asks to start with (left empty, the host says), and whether it is to run (1) or stop (0)"
  name: text
  founding: text
  mounts: text
  run: number

placed =
  @role
  #meta ;
    lede: "Where a world is reached, or why it is not run"
  host: text
  http: number
  mesa: number
  why: text

tenants =
  @stencil
  #meta ;
    lede: "A seat for whoever may have worlds run here"
  #here ; '/tenants/[t=@tas]
  #with ; tenant
  #by ; maker
  #for ; '/tenants/[t]

worlds =
  @stencil
  #meta ;
    lede: "A world a tenant asks to have run"
  #here ; '/tenants/[t=@tas]/worlds/[w=@tas]
  #with ; asked
  #by ; '/tenants/[t]
  #for ; maker

at =
  @stencil
  #meta ;
    lede: "Where that world is reached, or why it is not run"
  #here ; '/tenants/[t=@tas]/worlds/[w=@tas]/at
  #with ; placed
  #by ; maker
  #for ; '/tenants/[t]

"/" =
  @tree
  title: "A host"

"/tenants" =
  @tree
