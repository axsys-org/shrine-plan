#import lede=sys/lede
#import text=lib/grove/types/text
#import path_type=lib/grove/types/path

book_type =
  @type
  #meta ;
    lede: "Interpretations on one folio"
    "/sys/help": (pails/t "Reads and writes the study book: saved distinctions, published readings and the folio's single optional draft.")
  ! foil
  beit/book
  + read
    \ value=pail
    ^ maybe[book_type]
    ?> result=beit/book value .none
    | ./some result
  + write
    \ value=book_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ beit/book)

source_path =
  @slot
  #meta ;
    lede: "Folio to open"
    "/sys/help": (pails/t "The workspace uses this namespace path as both the source and initial member of its folio selection.")

book =
  @slot
  #meta ;
    lede: "Book of interpretations"
    "/sys/help": (pails/t "Record, branch and seal update this book as a student develops a distinction into an alternative reading.")

inventory =
  @slot
  #meta ;
    lede: "Study table counts"
    "/sys/help": (pails/t "Counts saved distinctions and published alternatives in the book. The study table shows these counts when a reader returns.")

draft_id =
  @slot
  #meta ;
    lede: "Current fork number"
    "/sys/help": (pails/t "An unpublished fork carries an R number. Publication checks the submitted number against the current draft; an empty value means there is no draft.")

name =
  @slot
  #meta ;
    lede: "Distinction between cases"
    "/sys/help": (pails/t "Names the two cases a proposed chiluk separates. Record it together with a practical consequence and a boundary.")

consequence =
  @slot
  #meta ;
    lede: "Practical difference"
    "/sys/help": (pails/t "The nafka mina: a case in which applying the proposed distinction changes the result.")

limit =
  @slot
  #meta ;
    lede: "Boundary of a distinction"
    "/sys/help": (pails/t "A case in which the distinction makes no difference. The reader supplies it before the chiluk can be saved.")

parent =
  @slot
  #meta ;
    lede: "Reading to fork"
    "/sys/help": (pails/t "The comparison view supplies A for Abaye or B for Rava. The fork inherits that reading's premise and source reference.")

distinction =
  @slot
  #meta ;
    lede: "Distinction to apply"
    "/sys/help": (pails/t "The fork form starts with the most recently recorded chiluk, or an empty field on a new folio. The reader can enter any saved D number to cite it in the fork.")

thesis =
  @slot
  #meta ;
    lede: "Alternative interpretation"
    "/sys/help": (pails/t "The reader's account of how to understand the phrase differently. Seal requires this text before publishing the fork.")

context =
  @role
  #meta ;
    lede: "Study workspace context"
    "/sys/help": (pails/t "Supplies the folio path that the browser study table and the three-pane daf use to establish their selection.")
  %/source_path: path_type

lemma =
  @slot
  #meta ;
    lede: "Traditional evidence phrase"
    "/sys/help": (pails/t "The Hebrew words for despair without awareness. Opening this phrase leads to the evidence behind the edition's existing kushya.")

witness =
  @slot
  #meta ;
    lede: "Traditional evidence identifier"
    "/sys/help": (pails/t "The stable identifier of the edition's chosen lemma. The evidence slip displays it and the book cites it in distinctions and readings.")

gloss =
  @slot
  #meta ;
    lede: "English gloss of the lemma"
    "/sys/help": (pails/t "The edition's English rendering of the chosen Hebrew phrase, shown alongside its evidence identifier on the slip.")

source_a =
  @slot
  #meta ;
    lede: "Abaye's words"
    "/sys/help": (pails/t "The Hebrew clause at Bava Metzia 21b:1 in which Abaye says that despair without awareness does not count as despair.")

source_b =
  @slot
  #meta ;
    lede: "Rava's words"
    "/sys/help": (pails/t "The Hebrew clause at Bava Metzia 21b:1 in which Rava says that despair without awareness counts as despair.")

english =
  @slot
  #meta ;
    lede: "Translation of the dispute"
    "/sys/help": (pails/t "English renderings of Abaye's and Rava's statements, in the same order as the two Hebrew clauses.")

premise_a =
  @slot
  #meta ;
    lede: "Abaye's premise"
    "/sys/help": (pails/t "The edition reads Abaye as requiring the owner's knowledge at the time of finding. The comparison places that assumption beside Rava's.")

premise_b =
  @slot
  #meta ;
    lede: "Rava's premise"
    "/sys/help": (pails/t "The edition reads Rava as relying on the owner's predictable response to an unmarked loss. A fork of Rava preserves that assumption.")

kushya =
  @slot
  #meta ;
    lede: "The edition's opening question"
    "/sys/help": (pails/t "Asks how a finder could rely on the owner's future response before the owner knows of the loss. The question view pairs it with the cited phrase.")

gilyon =
  @slot
  #meta ;
    lede: "Book entries for the margin"
    "/sys/help": (pails/t "A text rendering of published alternatives, the current fork and saved distinctions. The margin displays exact-range questions separately.")

marked =
  @slot
  #meta ;
    lede: "Linked evidence phrase"
    "/sys/help": (pails/t "Rich text for the traditional lemma. Its link points to the evidence view so the phrase remains recognizable when revisiting the question.")

run_text_type =
  @type
  #meta ;
    lede: "Annotated passage text"
    "/sys/help": (pails/t "Reads and writes Goo text runs with their descriptors intact. The folio uses them for selectable words, links and citations on saved questions.")
  ! foil
  goo/text/pail
  + read
    \ value=pail
    ^ maybe[run_text_type]
    ?> value=goo/text/pail value .none
    | ./some value
  + write
    \ value=run_text_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo/text/pail)

manuscript =
  @slot
  #meta ;
    lede: "Selectable bilingual passage"
    "/sys/help": (pails/t "Hebrew and English in reading order, with newlines between clauses. Its plain UTF-8 text is the reference for every selected range.")

anchor =
  @slot
  #meta ;
    lede: "Exact quotation and range"
    "/sys/help": (pails/t "Carries the versioned document path, start byte, exclusive end byte and exact quote as a JSON array. The ask action checks all four against the manuscript.")

inquiry =
  @slot
  #meta ;
    lede: "Question about selected words"
    "/sys/help": (pails/t "The reader's question in the composer. Recording it pairs the text with the validated passage range.")

questions_text =
  @slot
  #meta ;
    lede: "Annotated list of kushyot"
    "/sys/help": (pails/t "Renders saved questions in entry order. Each question body carries its citation in /sys/evidence so the reader can locate the same words again.")

questions_type =
  @type
  #meta ;
    lede: "Range-bound question ledger"
    "/sys/help": (pails/t "Reads and writes the ordered inquiries. Each entry keeps the reader's question together with its document, byte range and quotation.")
  ! foil
  beit/inquiries
  + read
    \ value=pail
    ^ maybe[questions_type]
    ?> result=beit/inquiries value .none
    | ./some result
  + write
    \ value=questions_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ beit/inquiries)

questions =
  @slot
  #meta ;
    lede: "Recorded kushyot"
    "/sys/help": (pails/t "The ask action appends to this ledger. The selection preview looks up questions by their full evidence range, even when the same words occur twice.")

chapter =
  @slot
  #meta ;
    lede: "Order and chapter"
    "/sys/help": (pails/t "The chapter heading for the source folio.")

folio_title =
  @slot
  #meta ;
    lede: "Tractate and daf"
    "/sys/help": (pails/t "The tractate name and page printed on the folio.")

tractate_he =
  @slot
  #meta ;
    lede: "Hebrew tractate name"
    "/sys/help": (pails/t "The tractate title in the language of the source.")

source_ref =
  @slot
  #meta ;
    lede: "Passage reference"
    "/sys/help": (pails/t "The location of the quoted lemma, shared by the translation, evidence slip and kushya composer.")

heading_a =
  @slot
  #meta ;
    lede: "First reading attribution"
    "/sys/help": (pails/t "The identifier and author from the first source reading.")

heading_b =
  @slot
  #meta ;
    lede: "Second reading attribution"
    "/sys/help": (pails/t "The identifier and author from the second source reading.")

reference_a =
  @slot
  #meta ;
    lede: "First reading citation"
    "/sys/help": (pails/t "The source sections supporting the first reading.")

reference_b =
  @slot
  #meta ;
    lede: "Second reading citation"
    "/sys/help": (pails/t "The source sections supporting the second reading.")

fork_a =
  @slot
  #meta ;
    lede: "First fork label"
    "/sys/help": (pails/t "Names the source reading that the first fork control inherits.")

fork_b =
  @slot
  #meta ;
    lede: "Second fork label"
    "/sys/help": (pails/t "Names the source reading that the second fork control inherits.")

control_case =
  @slot
  #meta ;
    lede: "Boundary case for the dispute"
    "/sys/help": (pails/t "The editorial explanation of the control case with its source reference.")

case_prompt =
  @slot
  #meta ;
    lede: "Cases behind the kushya"
    "/sys/help": (pails/t "The two cited cases the reader is asked to compare.")

notebook =
  @role
  #meta ;
    lede: "Study notebook for one folio"
    "/sys/help": (pails/t "Brings the source text, evidence, questions and book of interpretations together on one record. Study actions receive the selected folio through this role.")
  %/chapter: text
  %/folio_title: text
  %/tractate_he: text
  %/source_ref: text
  %/heading_a: text
  %/heading_b: text
  %/reference_a: text
  %/reference_b: text
  %/fork_a: text
  %/fork_b: text
  %/control_case: text
  %/case_prompt: text
  %/distinction: text
  %/manuscript: %/run_text_type
  %/questions: %/questions_type
  %/questions_text: %/run_text_type
  %/book: %/book_type
  %/lemma: text
  %/marked: %/run_text_type
  %/witness: text
  %/gloss: text
  %/source_a: text
  %/source_b: text
  %/english: text
  %/premise_a: text
  %/premise_b: text
  %/kushya: text
  %/gilyon: text
  %/inventory: text
  %/draft_id: text

ask =
  @action
  #meta ;
    lede: "Record a kushya on a quotation"
    "/sys/help": (pails/t "Checks the document, word boundaries and quoted bytes against the folio, then appends the question and rebuilds the annotated list. A stale selection or blank question leaves the ledger intact.")
  #on ; %/notebook
  %/anchor: text
  %/inquiry: text
  ! foil
  \ anchor=text inquiry=text notebook=%/notebook
  ^ %/notebook
  = source notebook.manuscript.value.plain
  ?> (./some range) (beit/anchor anchor source) (Seq[%/notebook] (error (pails/t "The selected words do not match the passage. Select again.")) notebook)
  ? !(beit/filled inquiry) (Seq[%/notebook] (error (pails/t "Write a question first.")) notebook)
  = next (beit/inquiries notebook.questions.items.snoc((beit/inquiry range inquiry)))
  | notebook.set_questions(next).set_questions_text((beit/questions notebook.source_ref next))

record =
  @action
  #meta ;
    lede: "Save a chiluk"
    "/sys/help": (pails/t "Requires the distinction, a case where it changes the result and a case where it does not. Assigns a D number and updates the book, margin and study counts.")
  #on ; %/notebook
  %/name: text
  %/consequence: text
  %/limit: text
  ! foil
  \ name=text consequence=text limit=text notebook=%/notebook
  ^ %/notebook
  = result (beit/distinguish notebook.book name consequence limit)
  ? result
   > (./err message) (Seq[%/notebook] (error (pails/t message)) notebook)
   > (./ok next) notebook.set_book(next).set_gilyon((beit/margin next)).set_inventory((beit/inventory next)).set_distinction((beit/latest_distinction next))

branch =
  @action
  #meta ;
    lede: "Fork a source reading"
    "/sys/help": (pails/t "Opens one draft from Abaye or Rava using a saved distinction. It preserves the parent's premise, citation and lemma and refuses a second fork while one is open.")
  #on ; %/notebook
  %/parent: text
  %/distinction: text
  ! foil
  \ parent=text distinction=text notebook=%/notebook
  ^ %/notebook
  = result (beit/fork notebook.book parent distinction)
  ? result
   > (./err message) (Seq[%/notebook] (error (pails/t message)) notebook)
   > (./ok next) notebook.set_book(next).set_gilyon((beit/margin next)).set_draft_id((beit/draft_id next))

seal =
  @action
  #meta ;
    lede: "Publish an alternative reading"
    "/sys/help": (pails/t "Checks the submitted R number against the open draft and requires a thesis. Appends the reading to the folio's book, clears the draft and updates the margin and counts.")
  #on ; %/notebook
  %/draft_id: text
  %/thesis: text
  ! foil
  \ draft_id=text thesis=text notebook=%/notebook
  ^ %/notebook
  = result (beit/publish notebook.book draft_id thesis)
  ? result
   > (./err message) (Seq[%/notebook] (error (pails/t message)) notebook)
   > (./ok next) notebook.set_book(next).set_gilyon((beit/margin next)).set_draft_id("").set_inventory((beit/inventory next))

workspace =
  @pane
  #meta ;
    lede: "Browser study table workspace"
    "/sys/help": (pails/t "Selects the supplied folio and opens its study table as a follower in the browser's Torah study page.")
  #on ; %/context
  #for ; /sys/slot/beit_workspace
  context => selection('/folio, source = context.source_path, topology = "tree", axis = "z", initial = .member(context.source_path)) {
    follow('/notebook, selection = '/folio, slot = '/sys/slot/beit_study)
  }

sheet =
  @view
  #meta ;
    lede: "Study table"
    "/sys/help": (pails/t "Shows how many distinctions and alternatives the folio holds. From here a reader can introduce a chiluk, compare readings or resume the current fork.")
  #on ; %/notebook
  #for ; /sys/slot/beit_study
  notebook => {
    text("The study table", '/sys/slot/title)
    show(notebook.gloss, '/sys/slot/content)
    show(notebook.source_ref, '/sys/slot/label)
    show(notebook.inventory, '/sys/slot/label)
    action("Introduce a distinction", become = '/sys/slot/beit_distinguish)
    action("Compare readings", become = '/sys/slot/beit_compare)
    action("Resume a fork", become = '/sys/slot/beit_publish)
  }

distinguish =
  @view
  #meta ;
    lede: "Chiluk worksheet"
    "/sys/help": (pails/t "Prompts for the two cases, the practical difference and its boundary. Recording the distinction takes the reader to the comparison.")
  #on ; %/notebook
  #for ; /sys/slot/beit_distinguish
  notebook => group(on = notebook, action = %/record, myth = { %/name = .input(""), %/consequence = .input(""), %/limit = .input("") }) {
    text("Chiluk  /  Draw a distinction", '/sys/slot/title)
    text("What two cases must we separate?", '/sys/slot/label)
    input(%/name)
    text("Nafka mina: where does that change the result?", '/sys/slot/label)
    input(%/consequence)
    text("Boundary: where does it make no difference?", '/sys/slot/label)
    input(%/limit)
    action("Record distinction", become = '/sys/slot/beit_compare)
  }

compare =
  @view
  #meta ;
    lede: "Compare and fork readings"
    "/sys/help": (pails/t "Sets Abaye and Rava beside the marked-object control case. Each fork button supplies its own parent and uses the D number entered by the reader.")
  #on ; %/notebook
  #for ; /sys/slot/beit_compare
  notebook => {
    text("Machloket  /  Two readings", '/sys/slot/title)
    present(notebook, '/sys/slot/beit_readings)
    show(notebook.control_case, '/sys/slot/content)
    group(on = notebook, action = %/branch, myth = { %/distinction = .input(notebook.distinction) }) {
      text("Which recorded distinction will this fork use?", '/sys/slot/label)
      input(%/distinction)
      action(notebook.fork_a, %/parent = "A", become = '/sys/slot/beit_publish)
      action(notebook.fork_b, %/parent = "B", become = '/sys/slot/beit_publish)
    }
    action("Return to study table", become = '/sys/slot/beit_study)
  }

publish =
  @view
  #meta ;
    lede: "Resume an unpublished reading"
    "/sys/help": (pails/t "Shows the active R number and asks the reader to confirm it and state a thesis. Publishing returns the reader to the study table.")
  #on ; %/notebook
  #for ; /sys/slot/beit_publish
  notebook => {
    text("Chiddush  /  An alternative reading", '/sys/slot/title)
    text("Draft number", '/sys/slot/label)
    show(notebook.draft_id, '/sys/slot/content)
    group(on = notebook, action = %/seal, myth = { %/draft_id = .input(notebook.draft_id), %/thesis = .input("") }) {
      text("Confirm the draft number", '/sys/slot/label)
      input(%/draft_id)
      text("How would you read the phrase differently?", '/sys/slot/label)
      input(%/thesis)
      action("Publish alternative", become = '/sys/slot/beit_study)
    }
    action("Return to study table", become = '/sys/slot/beit_study)
  }

"/" =
  @tree
  lede: "Beit Midrash"
  "/sys/help": (pails/t "The study mount starts here. Its folio holds the passage, questions and book used by the Gemara, study table and margin.")

"/folio" =
  @tree
  lede: "Bava Metzia 21b study folio"
  "/sys/help": (pails/t "Opens with the bilingual passage, the dispute between Abaye and Rava and the traditional kushya. The question ledger and book begin empty.")
  %/manuscript: (goo/text/pail [(goo/runt (myth/sing ['sys 'selection] (pails/p beit/document)) (goo/lang/en beit/passage))])
  %/questions: (beit/inquiries [])
  %/questions_text: (beit/questions (beit/evidence).ref (beit/inquiries []))
  %/book: beit/empty
  %/chapter: (pails/t (beit/folio).chapter)
  %/folio_title: (pails/t (beit/folio_title beit/folio))
  %/tractate_he: (pails/t (beit/folio).hebrew)
  %/source_ref: (pails/t (beit/evidence).ref)
  %/heading_a: (pails/t (beit/reading_heading beit/abaye))
  %/heading_b: (pails/t (beit/reading_heading beit/rava))
  %/reference_a: (pails/t (beit/abaye).ref)
  %/reference_b: (pails/t (beit/rava).ref)
  %/fork_a: (pails/t (str/cat_all ["Fork " (beit/abaye).name]))
  %/fork_b: (pails/t (str/cat_all ["Fork " (beit/rava).name]))
  %/control_case: (pails/t beit/control_case)
  %/case_prompt: (pails/t beit/comparison_prompt)
  %/distinction: (pails/t (beit/latest_distinction beit/empty))
  %/inventory: (pails/t (beit/inventory beit/empty))
  %/draft_id: (pails/t "")
  %/lemma: (pails/t (beit/evidence).hebrew)
  %/marked: (goo/text/pail [(goo/runt (myth/sing ['sys 'link] (pails/p ['sys 'slot 'beit_evidence])) (goo/lang/en (beit/evidence).hebrew))])
  %/witness: (pails/t (beit/evidence).id)
  %/gloss: (pails/t (beit/evidence).gloss)
  %/source_a: (pails/t (beit/abaye).words)
  %/source_b: (pails/t (beit/rava).words)
  %/english: (pails/t (str/cat_all [(beit/abaye).translation " " (beit/rava).translation]))
  %/premise_a: (pails/t (beit/abaye).premise)
  %/premise_b: (pails/t (beit/rava).premise)
  %/kushya: (pails/t beit/question)
  %/gilyon: (pails/t (beit/margin beit/empty))

daf =
  @pane
  #meta ;
    lede: "Three-pane study page"
    "/sys/help": (pails/t "Owns the folio selection for the native Beit Midrash workspace. Study, Gemara and Gilyon each follow that same selection.")
  #on ; %/context
  #for ; /sys/slot/beit_daf
  context => selection('/folio, source = context.source_path, topology = "tree", axis = "z", initial = .member(context.source_path)) {
    split {
      pane(%/Study, ports = { '/folio = '/folio })
      pane(%/Gemara, ports = { '/folio = '/folio })
      pane(%/Gilyon, ports = { '/folio = '/folio })
    }
  }

Study =
  @pane
  #meta ;
    lede: "Study table pane"
    "/sys/help": (pails/t "Follows the selected folio into its study table, where a reader can develop and publish an alternative reading.")
  #on ; %/context
  #for ; /sys/slot/pane/BeitStudy
  #port ; /folio
  context => {
    follow('/notebook, selection = '/folio, slot = '/sys/slot/beit_study)
  }

Gemara =
  @pane
  #meta ;
    lede: "Gemara pane"
    "/sys/help": (pails/t "Opens the selected folio at its source view for reading the passage, selecting words and tracing the questions they motivate.")
  #on ; %/context
  #for ; /sys/slot/pane/BeitGemara
  #port ; /folio
  context => {
    follow('/gemara, selection = '/folio, slot = '/sys/slot/beit_source)
  }

Gilyon =
  @pane
  #meta ;
    lede: "Gilyon pane"
    "/sys/help": (pails/t "Follows the same folio into its margin, keeping saved interpretations and questions beside the passage.")
  #on ; %/context
  #for ; /sys/slot/pane/BeitGilyon
  #port ; /folio
  context => {
    follow('/gilyon, selection = '/folio, slot = '/sys/slot/beit_margin)
  }

masthead =
  @view
  #meta ;
    lede: "Folio heading"
    "/sys/help": (pails/t "Identifies the tractate, chapter and passage above the Hebrew text: Bava Metzia 21b, chapter II of the tractate in Seder Nezikin.")
  #on ; %/notebook
  #for ; /sys/slot/beit_mast
  notebook => col {
    text("בית מדרש", '/sys/slot/title)
    show(notebook.chapter, '/sys/slot/label)
    show(notebook.folio_title, '/sys/slot/title)
    show(notebook.tractate_he, '/sys/slot/title)
    show(notebook.source_ref, '/sys/slot/label)
  }

translation =
  @view
  #meta ;
    lede: "Parallel Hebrew and English"
    "/sys/help": (pails/t "Sets the two Hebrew positions above the English gloss and translations, with their shared reference to Bava Metzia 21b:1.")
  #on ; %/notebook
  #for ; /sys/slot/beit_translation
  notebook => col {
    show(notebook.source_a, '/sys/slot/title)
    show(notebook.source_b, '/sys/slot/title)
    show(notebook.gloss, '/sys/slot/content)
    show(notebook.english, '/sys/slot/content)
    show(notebook.source_ref, '/sys/slot/label)
  }

passage =
  @view
  #meta ;
    lede: "Passage with traditional lemma"
    "/sys/help": (pails/t "Places the chosen Hebrew phrase between the folio heading and translation. Activating the phrase opens its evidence.")
  #on ; %/notebook
  #for ; /sys/slot/beit_passage
  notebook => col {
    present(notebook, '/sys/slot/beit_mast)
    action(notebook.lemma, become = '/sys/slot/beit_evidence)
    present(notebook, '/sys/slot/beit_translation)
  }

marked_passage =
  @view
  #meta ;
    lede: "Passage with highlighted evidence"
    "/sys/help": (pails/t "Shows the linked traditional lemma above the translation. Both the evidence view and the existing kushya reuse this passage.")
  #on ; %/notebook
  #for ; /sys/slot/beit_marked
  notebook => col {
    present(notebook, '/sys/slot/beit_mast)
    text(notebook.marked, '/sys/slot/title)
    present(notebook, '/sys/slot/beit_translation)
  }


readings =
  @view
  #meta ;
    lede: "Assumptions behind the dispute"
    "/sys/help": (pails/t "Places Abaye's knowledge requirement beside Rava's expectation of despair and gives the source references for each reading.")
  #on ; %/notebook
  #for ; /sys/slot/beit_readings
  notebook => row {
    col {
      show(notebook.heading_a, '/sys/slot/title)
      show(notebook.premise_a, '/sys/slot/content)
      show(notebook.reference_a, '/sys/slot/label)
    }
    col {
      show(notebook.heading_b, '/sys/slot/title)
      show(notebook.premise_b, '/sys/slot/content)
      show(notebook.reference_b, '/sys/slot/label)
    }
  }

source =
  @view
  #meta ;
    lede: "Gemara reading surface"
    "/sys/help": (pails/t "Displays the selectable bilingual manuscript, the traditional lemma, the competing readings and recorded questions. A reader can start a kushya from any contiguous selection of words.")
  #on ; %/notebook
  #for ; /sys/slot/beit_source
  notebook => col {
    present(notebook, '/sys/slot/beit_mast)
    text("Drag across the words that raise your question.", '/sys/slot/label)
    text(notebook.manuscript, %/anchor)
    action("Open a kushya", become = '/sys/slot/bm_21b_1_v1)
    text("Traditional kushya", '/sys/slot/label)
    action(notebook.lemma, become = '/sys/slot/beit_evidence)
    present(notebook, '/sys/slot/beit_readings)
    text(notebook.questions_text, '/sys/slot/content)
  }

ask_sheet =
  @view
  #meta ;
    lede: "Compose a kushya"
    "/sys/help": (pails/t "Pairs the selected quotation with a question input. Recording submits both to the folio's ask action and returns to the Gemara on success.")
  #on ; %/notebook
  #for ; /sys/slot/bm_21b_1_v1
  notebook => col {
    text("Kushya", '/sys/slot/title)
    show(notebook.source_ref, '/sys/slot/label)
    text(notebook.manuscript, %/anchor)
    group(on = notebook, action = %/ask, myth = { %/anchor = .input(""), %/inquiry = .input("") }) {
      text("Selected evidence", '/sys/slot/label)
      input(%/anchor)
      text("What is difficult about these words?", '/sys/slot/label)
      input(%/inquiry)
      action("Record kushya", become = '/sys/slot/beit_source)
    }
    action("Return to the Gemara", become = '/sys/slot/beit_source)
    text(notebook.questions_text, '/sys/slot/content)
  }

slip =
  @view
  #meta ;
    lede: "Traditional evidence slip"
    "/sys/help": (pails/t "Collects the Hebrew lemma, its English gloss, its stable identifier and its location at Bava Metzia 21b:1.")
  #on ; %/notebook
  #for ; /sys/slot/beit_slip
  notebook => col {
    text("Evidence", '/sys/slot/label)
    show(notebook.source_ref, '/sys/slot/label)
    show(notebook.lemma, '/sys/slot/title)
    show(notebook.gloss, '/sys/slot/content)
    show(notebook.witness, '/sys/slot/label)
  }

evidence =
  @view
  #meta ;
    lede: "Evidence for the traditional kushya"
    "/sys/help": (pails/t "Shows the highlighted phrase beside its evidence slip and the two readings. From here the reader can open the existing question or return to the source.")
  #on ; %/notebook
  #for ; /sys/slot/beit_evidence
  notebook => col {
    present(notebook, '/sys/slot/beit_marked)
    present(notebook, '/sys/slot/beit_slip)
    action("Open the kushya", become = '/sys/slot/beit_question)
    action("Clear phrase selection", become = '/sys/slot/beit_source)
    present(notebook, '/sys/slot/beit_readings)
  }

question =
  @view
  #meta ;
    lede: "Read the traditional kushya"
    "/sys/help": (pails/t "Reunites the question with its quoted evidence and asks the reader to compare the marked object at 21b:2 with the unmarked object at 21b:4.")
  #on ; %/notebook
  #for ; /sys/slot/beit_question
  notebook => col {
    present(notebook, '/sys/slot/beit_marked)
    present(notebook, '/sys/slot/beit_slip)
    show(notebook.kushya, '/sys/slot/content)
    show(notebook.case_prompt, '/sys/slot/content)
    action("Clear phrase selection", become = '/sys/slot/beit_source)
    present(notebook, '/sys/slot/beit_readings)
  }

margin =
  @view
  #meta ;
    lede: "Folio margin"
    "/sys/help": (pails/t "Shows the book's distinctions, draft and published readings together with the annotated list of reader questions on this folio.")
  #on ; %/notebook
  #for ; /sys/slot/beit_margin
  notebook => col {
    text("GILYON  /  Leaves of this sugya", '/sys/slot/title)
    show(notebook.gilyon, '/sys/slot/content)
    text(notebook.questions_text, '/sys/slot/content)
  }

selection_heading =
  @slot
  #meta ;
    lede: "Selection and gematria heading"
    "/sys/help": (pails/t "Shows the standard gematria total when the quotation contains Hebrew letters, or a plain selection heading otherwise.")

selection_breakdown =
  @slot
  #meta ;
    lede: "Gematria by word"
    "/sys/help": (pails/t "For each selected word containing Hebrew letters, lists its letter values in order and their sum.")

selection_details =
  @slot
  #meta ;
    lede: "Questions on this range"
    "/sys/help": (pails/t "Lists the bodies of kushyot attached to this exact document and range, or reports that the range has no questions yet.")

selection_quote =
  @slot
  #meta ;
    lede: "Selected words"
    "/sys/help": (pails/t "The exact slice of manuscript text validated for the preview, including any newline crossed by the selection.")

selected =
  @role
  #meta ;
    lede: "Passage selection preview data"
    "/sys/help": (pails/t "A request-local projection of the quotation, gematria and matching questions. The selection provider derives these fields from the folio.")
  %/selection_heading: text
  %/selection_breakdown: text
  %/selection_details: text
  %/selection_quote: text

selection_menu =
  @view
  #meta ;
    lede: "Preview selected words"
    "/sys/help": (pails/t "Shows the quotation, gematria and existing questions for the range. Opening a kushya here navigates to the composer; the reader saves it there.")
  #on ; %/selected
  #for ; /sys/slot/selection_preview
  selected => col {
    show(selected.selection_heading, '/sys/slot/title)
    show(selected.selection_quote, '/sys/slot/content)
    show(selected.selection_breakdown, '/sys/slot/content)
    show(selected.selection_details, '/sys/slot/content)
    action("Open a kushya", become = '/sys/slot/bm_21b_1_v1)
  }
