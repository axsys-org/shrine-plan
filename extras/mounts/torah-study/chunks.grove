#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import lede=sys/lede
#import runs=gov/torah_study/run_text_type

address =
  @slot
  #meta ;
    lede: "Chunk address"
    "/sys/help": (pails/t "The namespace address opened by the reading workspace.")

document_id =
  @slot
  #meta ;
    lede: "Text revision"
    "/sys/help": (pails/t "Identifies this chunk and revision in a frozen selection.")

tracts =
  @slot
  #meta ;
    lede: "Independent tracts"
    "/sys/help": (pails/t "Texts with no designated anchor. Ordinary citations leave a text in the library.")

passage =
  @slot
  #meta ;
    lede: "Selectable text"
    "/sys/help": (pails/t "The chunk body annotated with its versioned selection identity.")

outgoing =
  @slot
  #meta ;
    lede: "Links in this text"
    "/sys/help": (pails/t "The designated anchor and ordinary references, with unresolved destinations called out.")

matches =
  @slot
  #meta ;
    lede: "Anchored texts"
    "/sys/help": (pails/t "Incoming home links, restricted to exact evidence when a phrase is selected.")

citations =
  @slot
  #meta ;
    lede: "Citing texts"
    "/sys/help": (pails/t "Incoming references that do not place their source under this text.")

library_link =
  @slot
  #meta ;
    lede: "Library address"
    "/sys/help": (pails/t "Return to the list of independent tracts.")

range =
  @slot
  #meta ;
    lede: "Selected evidence"
    "/sys/help": (pails/t "Document revision, UTF-8 start and exclusive end, and the exact words.")

note =
  @slot
  #meta ;
    lede: "New text"
    "/sys/help": (pails/t "The body of a new chunk anchored to the selected words.")

context =
  @role
  #meta ;
    lede: "Reading address"
    "/sys/help": (pails/t "Supplies the current namespace address to the workspace.")
  %/address: path_type

library =
  @role
  #meta ;
    lede: "Tract library"
    "/sys/help": (pails/t "Holds the derived list of unanchored texts.")
  %/tracts: runs

chunk =
  @role
  #meta ;
    lede: "Linked text"
    "/sys/help": (pails/t "A readable chunk with its outgoing links, incoming anchors, and citations.")
  lede: text
  %/document_id: path_type
  %/passage: runs
  %/matches: runs
  %/citations: runs
  %/library_link: runs
  %/outgoing: runs
  %/note: text
  %/range: text

workspace =
  @pane
  #route ;
    name: read
    chunk: %/address
    reveal: /sys/slot/chunk_read
  #meta ;
    lede: "Text library"
    "/sys/help": (pails/t "Open a tract or follow a link to a directly addressed chunk.")
  #on ; %/context
  #for ; /sys/slot/chunk_workspace
  context => {
    navigate('/address, source = context.address, mode = "input", label = "Open address")
    selection('/page, source = context.address, topology = "tree", axis = "z", initial = .member(context.address)) {
      follow('/reader, selection = '/page, slot = '/sys/slot/chunk_read)
    }
  }

left =
  @slot
  #meta ;
    lede: "Left text"

right =
  @slot
  #meta ;
    lede: "Right text"

pair =
  @role
  %/left: path_type
  %/right: path_type

comparison =
  @pane
  #on ; %/pair
  #for ; /sys/slot/chunk_compare
  #route ;
    name: compare
    left: %/left
    right: %/right
  pair => split {
    pane(%/Left)
    pane(%/Right)
  }

Left =
  @pane
  #on ; %/pair
  #for ; /sys/slot/chunk_compare_left
  pair => selection('/left, source = pair.left, topology = "tree", axis = "z", initial = .member(pair.left)) {
    follow('/reader, selection = '/left, slot = '/sys/slot/chunk_read)
  }

Right =
  @pane
  #on ; %/pair
  #for ; /sys/slot/chunk_compare_right
  pair => selection('/right, source = pair.right, topology = "tree", axis = "z", initial = .member(pair.right)) {
    follow('/reader, selection = '/right, slot = '/sys/slot/chunk_read)
  }

catalog =
  @view
  #meta ;
    lede: "Standalone tracts"
    "/sys/help": (pails/t "Lists texts without an anchor, including tracts that cite another passage.")
  #on ; %/library
  #for ; /sys/slot/chunk_read
  library => col {
    text("Tracts", '/sys/slot/title)
    text(library.tracts, '/sys/slot/content)
  }

read =
  @view
  #meta ;
    lede: "Read a chunk"
    "/sys/help": (pails/t "Open linked texts or select words to inspect and annotate their evidence.")
  #on ; %/chunk
  #for ; /sys/slot/chunk_read
  chunk => col {
    text(chunk.library_link, '/sys/slot/label)
    show(chunk.lede, '/sys/slot/title)
    text(chunk.passage, %/range)
    action("Write on these words", become = '/sys/slot/chunk_write)
    text("Links from this text", '/sys/slot/label)
    text(chunk.outgoing, '/sys/slot/content)
    text("Anchored here", '/sys/slot/label)
    text(chunk.matches, '/sys/slot/content)
    text("Citations", '/sys/slot/label)
    text(chunk.citations, '/sys/slot/content)
  }

selection_menu =
  @view
  #meta ;
    lede: "Links on selected words"
    "/sys/help": (pails/t "Shows only incoming anchors and citations for the selected range.")
  #on ; %/chunk
  #for ; /sys/slot/selection_preview
  chunk => col {
    text("Anchored on these words", '/sys/slot/label)
    text(chunk.matches, '/sys/slot/content)
    text("Citing these words", '/sys/slot/label)
    text(chunk.citations, '/sys/slot/content)
    action("Write on these words", become = '/sys/slot/chunk_write)
  }

annotate =
  @action
  #meta ;
    lede: "Anchor a new text"
    "/sys/help": (pails/t "Checks the quotation against this revision and creates one addressable comment.")
  #on ; %/chunk
  %/range: text
  %/note: text
  ! foil
  \ range=text note=text chunk=%/chunk
  ^ %/chunk
  ?> (./some _) (beit/anchor_for chunk.document_id range chunk.passage.value.plain) (Seq[%/chunk] (error (pails/t "Select words from this revision.")) chunk)
  ? !(beit/filled note) (Seq[%/chunk] (error (pails/t "Write a note of up to 1000 bytes.")) chunk)
  | chunk.set_note(note).set_range(range)

write_note =
  @view
  #meta ;
    lede: "Write on these words"
    "/sys/help": (pails/t "Freezes a selection and saves the new text with a comment anchor.")
  #on ; %/chunk
  #for ; /sys/slot/chunk_write
  chunk => col {
    text(chunk.passage, %/range)
    group(on = chunk, action = %/annotate, myth = { %/range = .input(""), %/note = .input("") }) {
      input(%/range)
      text("Your note", '/sys/slot/label)
      input(%/note)
      action("Save note", become = '/sys/slot/chunk_read)
    }
    action("Return to text", become = '/sys/slot/chunk_read)
  }
