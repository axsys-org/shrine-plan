- torah_study/chunks
- goo_workspace

+ torah_study_mount
  + endpoint
    \ self=iota
    ^ goo_workspace/endpoint
    | goo_workspace/endpoint [self 'gov 'torah_study 'workspace]
      [self 'gov 'torah_study 'source_path] [self 'app 'torah_study 'folio]
      torah_study_mount/validate [] (torah_study_mount/page self)
  + validate
    \ selected=axal[myth]
    ^ maybe[str]
    ? (maybe/is_some selected.fil) .none
    | ./some "Study notebook unavailable."
  + ledger
    \ state=namespace
    ^ [nat str]
    = target=path [state.self 'app 'torah_study 'folio]
    ?> (./some card) (goo_runtime/record .y target state) [404 "Missing notebook"]
    ?> (./some held) card.get([state.self 'gov 'torah_study 'book]) [404 "Missing book"]
    ?> book=beit/book held [409 "Invalid book"]
    = distinctions book.distinctions.map((\ d (json/obj [
        (jkv "id" (json/str d.id)) (jkv "lemma" (json/str d.lemma)) (jkv "name" (json/str d.name))
        (jkv "consequence" (json/str d.consequence)) (jkv "limit" (json/str d.limit))])))
      edition
        \ e=beit/edition
        ^ json
        = url=str
            ?> (./some base) (beit/parent_reading e.parent) ""
            ? (eq base.ref e.reference) base.url ""
        | json/obj [(jkv "parentName" (json/str (beit/parent_name e.parent))) (jkv "sourceUrl" (json/str url))
          (jkv "id" (json/str e.id)) (jkv "parent" (json/str e.parent))
          (jkv "reference" (json/str e.reference)) (jkv "premise" (json/str e.premise))
          (jkv "lemma" (json/str e.lemma)) (jkv "distinction" (json/str e.distinction)) (jkv "thesis" (json/str e.thesis))]
      draft=json
        ? book.draft
         > (./some leaf) (edition leaf)
         > .none jnull
    [200 (show (json/obj [(jkv "evidence" (json/obj [(jkv "id" (json/str (beit/evidence).id)) (jkv "reference" (json/str (beit/evidence).ref))]))
      (jkv "distinctions" (json/arr distinctions)) (jkv "leaves" (json/arr book.leaves.map(edition)))
      (jkv "draft" draft)]))]
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = url (http_foot/split 63 request.target).at(0)
        ? ((eq url "/torah-study") || (eq url "/torah-study/"))
          ? !((eq request.target url) || (eq request.target (str/cat_all [url "?format=json"])))
            | ./reply (http_driver/response 400 "This edition has a fixed source.")
          | goo_workspace/request (torah_study_mount/endpoint state.self) request now
        ? (eq url "/torah-study/leaves") (./snapshot torah_study_mount/ledger)
        ? !((eq url "/torah-study/style.css") || (eq url "/torah-study/folio.js"))
          | ./reply (http_driver/response 404 "Not found")
        = leaf (? (eq url "/torah-study/style.css") "style.css" "folio.js")
          found files.keep((\ [name bytes] (eq name leaf)))
        ? !(found.len) (./reply (http_driver/response 404 "Not found"))
        = [name bytes] found.at(0)
        | ./bytes 200 bytes (? (eq leaf "style.css") "text/css" "application/javascript")
    | http_foot/add_routes [(http_foot/route "/torah-study" plan)] http_foot/empty
  + he
    \ words=str
    ^ weft/node
    | weft/leaf "bdi" [(weft/att "lang" "he") (weft/att "dir" "rtl")] (str/to_atom words)
  + ref
    \ url=nat label=nat
    ^ weft/node
    | weft/leaf "a" [(weft/href url) (weft/att "target" "_blank") (weft/att "rel" "noopener")] label
  + margin
    \ reading=beit/reading
    ^ weft/node
    | weft/el "aside" [(weft/cls "margin")] [
      (weft/leaf "small" [] (str/to_atom (str/cat_all ["READING  /  " reading.id])))
      (weft/leaf "h2" [] (str/to_atom reading.name))
      (weft/leaf "p" [] (str/to_atom reading.premise))
      (torah_study_mount/ref (str/to_atom reading.url) (str/to_atom reading.ref))]
  + page
    \ self=iota target=path content=row[weft/node]
    ^ nat
    = assets (goo_browser/presentation_assets).snoc((weft/el "script" [(weft/att "src" "/static/goo-workspace.js") (weft/att "defer" "defer")] []))
      assets assets.snoc((weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/torah-study/style.css")] []))
      assets assets.snoc((weft/el "script" [(weft/att "src" "/torah-study/folio.js") (weft/att "defer" "defer")] []))
      loc beit/folio
      e beit/evidence
      phrase (weft/el "button" [(weft/id (str/to_atom e.id)) (weft/att "type" "button") (weft/att "aria-controls" "question") (weft/att "aria-pressed" "false")] [(torah_study_mount/he e.hebrew)])
    | weft/page_with_assets (str/to_atom (str/cat_all ["Beit Midrash | " (beit/folio_title loc)])) assets [
      (weft/el "header" [] [(weft/leaf "span" [] "BEIT MIDRASH") (torah_study_mount/he "בית מדרש")])
      (weft/el "main" [] [
        (weft/el "section" [(weft/cls "mast")] [(weft/leaf "small" [] (str/to_atom loc.chapter))
          (weft/leaf "h1" [] (str/to_atom loc.tractate)) (torah_study_mount/he loc.hebrew) (weft/leaf "strong" [] (str/to_atom loc.page))])
        (weft/el "div" [(weft/cls "daf")] [
          (torah_study_mount/margin beit/abaye)
          (weft/el "article" [(weft/cls "source")] [(weft/leaf "small" [] "GEMARA    /    THE SOURCE")
            (weft/el "p" [(weft/cls "gemara") (weft/att "dir" "rtl") (weft/att "lang" "he")] [phrase (weft/tx ", ") (torah_study_mount/he (beit/abaye).words) (weft/tx ". ") (torah_study_mount/he (beit/rava).words) (weft/tx ".")])
            (weft/leaf "p" [(weft/cls "translation")] (str/to_atom (str/cat_all [e.gloss ". " (beit/abaye).translation " " (beit/rava).translation])))
            (torah_study_mount/ref (str/to_atom (beit/source_url loc beit/opening)) (str/to_atom e.ref))
            (weft/leaf "p" [(weft/cls "hint")] "Select the underlined words to open their evidence slip.")])
          (torah_study_mount/margin beit/rava)])
        (weft/el "section" [(weft/id "question") (weft/att "hidden" "hidden")] [
          (weft/leaf "small" [] (str/to_atom (str/cat_all ["EVIDENCE  /  " e.ref])))
          (weft/el "p" [] [(torah_study_mount/he e.hebrew) (weft/tx "   /   ") (weft/tx (str/to_atom e.gloss))])
          (weft/el "details" [] [(weft/leaf "summary" [] "Open the kushya")
            (weft/leaf "p" [] (str/to_atom beit/question))
            (weft/el "p" [] [(weft/tx "Test the question against the ")
              (torah_study_mount/ref (str/to_atom (beit/source_url loc beit/marked_case)) (str/to_atom (beit/case_label loc beit/marked_case)))
              (weft/tx " and the ") (torah_study_mount/ref (str/to_atom (beit/source_url loc beit/unmarked_case)) (str/to_atom (beit/case_label loc beit/unmarked_case))) (weft/tx ".")])])])
        (weft/el "section" [(weft/cls "study")] [
          (weft/el "div" [(weft/cls "table")] content)
          (weft/el "aside" [(weft/cls "ledger")] [(weft/leaf "small" [] "GILYON    /    THE MARGIN")
            (weft/leaf "h2" [] "Leaves of this sugya") (weft/el "div" [(weft/id "leaves") (weft/att "aria-live" "polite")] [])])])])
      (weft/leaf "footer" [] "Source: Babylonian Talmud. English glosses and the study question are editorial. Student readings are kept separately from the text.")]
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'torah_study]
      target=path [state.self 'app 'torah_study]
    ?> (./some version) state.case(.x source) (./err (pails/t "Study declarations missing."))
    ?> (./ok next) (grove_install/instantiate source version target state) (./err (pails/t "Study instance unavailable."))
    = folio target.snoc('folio)
      card (source_mount/record folio next)
    ?> (./some held) card.get(source.snoc('manuscript)) (./err (pails/t "Missing manuscript"))
    ?> manuscript=goo/text/pail held (./err (pails/t "Invalid manuscript"))
    = preview source.snoc('selection_menu)
      runs (manuscript.value.map((\ run run.set_myth(run.myth.put(['sys 'selection_preview] (pails/p preview))))))
      patch (myth/sing source.snoc('manuscript) (goo/text/pail runs)).put(preview (goo_selection/provider (beit/selection_project source)))
      next (source_mount/write folio patch next)
    < next (chunks/install next)
    | goo_workspace/install (torah_study_mount/endpoint state.self) goo_browser/talk next
