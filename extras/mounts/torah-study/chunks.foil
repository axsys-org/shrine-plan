- torah_study/model

+ chunks
  + root
    \ self=iota
    ^ path
    [self 'app 'torah_chunks]
  + gov
    \ self=iota
    ^ path
    [self 'gov 'torah_chunks]
  + asks
    ^ path
    ['study 'asks_about]
  + comments
    ^ path
    ['study 'comments_on]
  + cites
    ^ path
    ['study 'cites]
  + span
    : start=nat end=nat quote=str
  + destination
    : target=path revision=nat words=maybe[chunks/span]
  + links
    : values=row[chunks/destination]
  + incoming
    : source=path title=str relation=path home=bool dest=chunks/destination
  + index
    : edges=row[chunks/incoming]
  + revision
    \ card=myth
    ^ nat
    | card.nat_at(['chunk 'revision] 0)
  + document
    \ here=path revision=nat
    ^ path
    | here.snoc('revision).snoc(($u revision))
  + link
    \ label=str target=path
    ^ goo/runt
    | goo_text/route_link label target "read" [["chunk" target]]
  + relation_label
    \ slot=path
    ^ str
    ? (equal slot chunks/asks) "Asks about"
    ? (equal slot chunks/comments) "Comments on"
    ? (equal slot chunks/cites) "Cites"
    | path_show slot
  + edges
    \ src=path card=myth
    ^ row[chunks/incoming]
    = title (card.txt_at(system_vocabulary/lede))
      home (card.path_at(['chunk 'anchor]))
    | card.tap.bind
      \ entry
      ?> links=chunks/links entry.val []
      | (row/range 0 links.values.len).map
        \ i
        | chunks/incoming src title entry.key (and (eq i 0) (equal home (maybe/some[path] entry.key))) links.values.at(i)
  + body
    \ card=myth
    ^ goo/text
    ?> (./some held) card.get(['chunk 'body]) []
    ?> value=goo/text/pail held []
    value.value
  + valid
    \ d=chunks/destination target=maybe[myth]
    ^ bool
    ?> (./some card) target .false
    ? !(eq d.revision (chunks/revision card)) .false
    ?> (./some s) d.words .true
    = doc (chunks/document d.target d.revision)
      wire (beit/citation (beit/range (path_show doc) s.start s.end s.quote))
    | maybe/is_some (beit/anchor_for doc wire (chunks/body card).plain)
  + line
    \ label=str target=path
    ^ goo/text
    [(chunks/link label target) (goo/runt myth/new (goo/lang/en (str/from_atom 10)))]
  + listing
    \ edges=row[chunks/incoming] home=bool
    ^ goo/text
    = selected (edges.keep((\ e=chunks/incoming (eq e.home home))))
      render
        \ e=chunks/incoming
        ^ row[goo/runt]
        | chunks/line (str/cat_all [(chunks/relation_label e.relation) "  /  " e.title]) e.source
    | row/bind[chunks/incoming goo/runt] render selected
  + note_range
    \ here=path revision=nat body=goo/text wire=str
    ^ maybe[chunks/destination]
    < r (beit/anchor_for (chunks/document here revision) wire body.plain)
    | ./some (chunks/destination here revision (./some (chunks/span r.start r.end r.quote)))
  + preview
    \ here=path wire=str card=myth
    ^ either[str myth]
    = gov (chunks/gov here.at(0))
    ?> (./some dest) (chunks/note_range here (chunks/revision card) (chunks/body card) wire) (./err "The selected text has changed.")
    ?> (./some held) card.get(['chunk 'incoming]) (./err "Missing chunk index.")
    ?> idx=chunks/index held (./err "Invalid chunk index.")
    = edges (idx.edges.keep((\ e (equal[chunks/destination] e.dest dest))))
      notes (chunks/listing edges .true)
      cites (chunks/listing edges .false)
    | ./ok card.put(gov.snoc('matches) (goo/text/pail notes)).put(gov.snoc('citations) (goo/text/pail cites))
  + new_note
    : evidence=chunks/destination text=str
  + card
    \ here=path title=str body=goo/text
    ^ myth
    = gov (chunks/gov here.at(0))
    = card (myth/sing ['chunk 'body] (goo/text/pail body))
    | card.put(system_vocabulary/lede (pails/t title)).put(['chunk 'revision] (pails/n 1)).put(limb_slot (kook [gov.snoc('chunk_behavior)]))
  + place
    \ card=myth slot=path d=chunks/destination
    ^ myth
    | card.put(slot (chunks/links [d])).put(['chunk 'anchor] (pails/p slot))
  + init
    \ b=bowl card=myth
    ^ yell
    = gov (chunks/gov b.here.at(0))
      revision (chunks/revision card)
      doc (chunks/document b.here revision)
      menu gov.snoc('selection_menu)
      text ((chunks/body card).map((\ r r.set_myth(r.myth.put(['sys 'selection] (pails/p doc)).put(['sys 'selection_composer] (pails/p ['sys 'slot 'chunk_write])).put(['sys 'selection_preview] (pails/p menu))))))
      out card.put(gov.snoc('address) (pails/p b.here)).put(gov.snoc('document_id) (pails/p doc)).put(gov.snoc('passage) (goo/text/pail text)).put(menu (goo_selection/provider (chunks/preview b.here)))
      note (card.txt_at(gov.snoc('note)))
      wire (card.txt_at(gov.snoc('range)))
      out out.put(gov.snoc('note) (pails/t "")).put(gov.snoc('range) (pails/t ""))
    ? !(beit/filled note) (yell [] out)
    ?> (./some dest) (chunks/note_range b.here revision text wire) (yell [] out)
    = request (myth/sing ['chunk 'append] (chunks/new_note dest note))
    | yell [[(chunks/root b.here.at(0)) (writ/poke request)]] out
  + append
    \ b=bowl cur=myth add=myth
    ^ yell
    ?> (./some held) add.get(['chunk 'append]) (yell [] cur.meld(add))
    ?> request=chunks/new_note held (yell [] cur)
    ? !(and (equal[path] b.src request.evidence.target) (pith_prefix b.here b.src)) (yell [] cur)
    = number=nat
        % n=nat (cur.nat_at(['chunk 'sequence] 0)).inc
        ? (b.kids.dip([($u n)])).wyt (_ n.inc)
        n
      addr b.here.snoc(($u number))
      child (chunks/place (chunks/card addr request.text (goo/text/en request.text)) chunks/comments request.evidence)
    | yell [[addr (writ/make child)]] cur.put(['chunk 'sequence] (pails/n number))
  + edit
    \ b=bowl cur=myth add=myth
    ^ yell
    = merged cur.meld(add)
    ? (equal[goo/text] (chunks/body merged) (chunks/body cur)) (yell [] merged)
    | chunks/init b merged.put(['chunk 'revision] (pails/n (chunks/revision cur).inc))
  + watch
    \ b=bowl card=myth
    ^ yell
    | yell [] card.put(crew_slot (crew/pail (crew/sing ['library] (dep .z b.here))))
  + describe
    \ root=path tree=axal[myth] e=chunks/incoming
    ^ goo/text
    = target=maybe[myth]
        ? !(pith_prefix root e.dest.target) .none
        | tree.dip(e.dest.target.drop(root.len)).fil
      title=str
        ?> (./some other) target (path_show e.dest.target)
        | other.txt_at(system_vocabulary/lede)
      quote=str
        ?> (./some words) e.dest.words ""
        | str/cat_all ["  /  " words.quote]
      label (str/cat_all [(? e.home "Anchor: " "") (chunks/relation_label e.relation) "  /  " title quote])
    ? (chunks/valid e.dest target)
      = line (chunks/line label e.dest.target)
      = compare (goo_text/route_link "Compare these texts" e.dest.target "compare" [["left" e.source] ["right" e.dest.target]])
        links line.snoc(compare).snoc(line.at(1))
      ?> (./some words) e.dest.words links
      = doc (chunks/document e.dest.target e.dest.revision)
        at (beit/citation (beit/range (path_show doc) words.start words.end words.quote))
        run line.at(0)
      | links.drop(1).cons(run.set_myth(run.myth.put(['sys 'navigate_at] (pails/t at))))
    | goo/text/en (str/cat_all ["Unresolved: " label "  " (path_show e.dest.target) (str/from_atom 10)])
  + project
    \ root=path tree=axal[myth] all=row[chunks/incoming] page=[path myth]
    ^ row[[path writ]]
    = [rel card] page
      here root.weld(rel)
      gov (chunks/gov root.at(0))
      live (all.keep((\ e=chunks/incoming (and (equal e.dest.target here) (chunks/valid e.dest (./some card))))))
      edges (chunks/edges here card)
      outgoing (row/bind[chunks/incoming goo/runt] (chunks/describe root tree) edges)
      outgoing=goo/text
        ? (and (maybe/is_some card.get(['chunk 'anchor])) !(edges.any((\ e e.home))))
          | outgoing.weld((goo/text/en "Unresolved anchor: its link slot is missing."))
        outgoing
      linked (chunks/line "Library" root)
      patch (myth/sing gov.snoc('outgoing) (goo/text/pail outgoing)).put(gov.snoc('matches) (goo/text/pail (chunks/listing live .true))).put(gov.snoc('citations) (goo/text/pail (chunks/listing live .false))).put(gov.snoc('library_link) (goo/text/pail linked)).put(['chunk 'incoming] (chunks/index live))
    ? (equal[myth] card card.meld(patch)) []
    [[here (writ/poke patch)]]
  + refresh
    \ b=bowl card=myth changes=row[dep]
    ^ yell
    = tree (b.crew_value(['library]))
      gov (chunks/gov b.here.at(0))
      pages (tree.tap.keep((\ [rel c] (maybe/is_some c.get(['chunk 'body])))))
      all (row/bind[[path myth] chunks/incoming] (\ [rel c] (chunks/edges b.here.weld(rel) c)) pages)
      tract
        \ page=[path myth]
        ^ goo/text
        = [rel c] page
        ? (maybe/is_some c.get(['chunk 'anchor])) []
        | chunks/line (c.txt_at(system_vocabulary/lede)) b.here.weld(rel)
      tracts (row/bind[[path myth] goo/runt] tract pages)
      puts (row/bind[[path myth] [path writ]] (chunks/project b.here tree all) pages)
    | yell puts card.put(gov.snoc('tracts) (goo/text/pail tracts))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = root (chunks/root state.self)
      gov (chunks/gov state.self)
      sugya root.snoc('sugya)
      question root.snoc('question)
      phrase (beit/evidence).hebrew
      anchored (chunks/destination sugya 1 (./some (chunks/span 0 phrase.len phrase)))
      essay (chunks/card root.snoc('essay) "On later knowledge" (goo/text/en "What can a later response tell us about an earlier state of mind?"))
      records=row[[path myth]]
        [[gov.snoc('chunk_behavior) (form/card (def_form.set_init(chunks/init).set_talk(chunks/edit)) (lore/line "Materialize a chunk and its accepted note."))]
         [gov.snoc('library_behavior) (form/card (def_form.set_init(chunks/watch).set_talk(chunks/append).set_hear(chunks/refresh)) (lore/line "Index incoming chunk links."))]
         [root (myth/sing limb_slot (kook [gov.snoc('library_behavior)])).put(system_vocabulary/lede (pails/t "Tracts"))]
         [sugya (chunks/card sugya (beit/evidence).ref (goo/text/en beit/passage))]
         [question (chunks/place (chunks/card question "When does awareness matter?" (goo/text/en beit/question)) chunks/asks anchored)]
         [root.snoc('note) (chunks/place (chunks/card root.snoc('note) "Knowledge and certainty" (goo/text/en "Knowing of a loss and being certain how one will react are different.")) chunks/comments (chunks/destination question 1 .none))]
         [root.snoc('essay) essay.put(chunks/cites (chunks/links [anchored]))]]
    % rest=row[[path myth]] records next=namespace state
    ^ either[pail namespace]
    ? !(rest.len) (./ok next)
    = [at record] rest.at(0)
    ?> (./ok changed) (grove_install/change at (writ/make record) next) (./err (pails/t (str/cat_all ["Chunk installation failed at " (path_show at)])))
    | _ rest.drop(1) changed
