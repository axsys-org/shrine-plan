- torah_study/chunks
- testing

+ beit_checks
  + get
    \ r=either[str beit/book]
    ^ beit/book
    ?> (./ok book) r beit/empty
    book
  + refused
    \ r=either[str beit/book]
    ^ bool
    ? r
     > (./err _) .true
     > (./ok _) .false
  + study
    \ ignored=unit
    ^ row[testing/check]
    = get beit_checks/get no beit_checks/refused
      d (get (beit/distinguish beit/empty "Awareness" "Loose coins" "Marked vessel"))
      fork (get (beit/fork d "B" "D1"))
      done (get (beit/publish fork "R1" "Certainty is not knowledge."))
      other (get (beit/fork done "A" "D1"))
      second (get (beit/distinguish other "Possession" "Found today" "Found earlier"))
      leaf done.leaves.at(0)
    [(testing/text "no suggested distinction on an empty folio" "" (beit/latest_distinction beit/empty))
     (testing/text "suggest the most recent saved distinction" "D2" (beit/latest_distinction second))
     (testing/text "unresolved parent retains its identifier" "C" (beit/parent_name "C"))
     (testing/nat "consequence is required" 1 (no (beit/distinguish d "name" " " "case")))
     (testing/nat "boundary is required" 1 (no (beit/distinguish d "name" "case" "")))
     (testing/nat "unknown distinction refused" 1 (no (beit/fork d "B" "D2")))
     (testing/nat "unknown parent refused" 1 (no (beit/fork d "C" "D1")))
     (testing/nat "pending fork cannot be displaced" 1 (no (beit/fork fork "A" "D1")))
     (testing/nat "wrong fork cannot publish" 1 (no (beit/publish fork "R2" "Other")))
     (testing/nat "blank thesis cannot publish" 1 (no (beit/publish fork "R1" " ")))
     (testing/nat "published only once" 1 (no (beit/publish done "R1" "Different")))
     (testing/text "stable evidence" (beit/evidence).id leaf.lemma)
     (testing/text "premise frozen" (beit/rava).premise leaf.premise)
     (testing/text "citation frozen" (beit/rava).ref leaf.reference)
     (testing/text "distinction reusable on opposing reading" "R2" (beit/draft_id other))
     (testing/text "original publication preserved" "Certainty is not knowledge." other.leaves.at(0).thesis)]

  + citations
    \ ignored=unit
    ^ row[testing/check]
    = loc (beit/location "Fixture" "ט" "9a" "III" "https://example.test/Fixture")
      section (beit/section "7" "fixture case")
      quote (beit/range (path_show beit/document) 0 4 "word")
      ledger (beit/inquiries [(beit/inquiry quote "Why here?")])
      rendered (beit/questions (beit/reference loc section) ledger)
    [(testing/text "citation uses the folio and section" "Fixture 9a:7" (beit/reference loc section))
     (testing/text "link uses the same page and section" "https://example.test/Fixture.9a.7" (beit/source_url loc section))
     (testing/text "case names its evidence" "fixture case (9a:7)" (beit/case_label loc section))
     (testing/text "saved question cites its folio" (str/join (str/from_atom 10) ["K1  /  Fixture 9a:7" "word" "Why here?"]) rendered.value.plain)
     (testing/text "reading heading follows attribution" "B  /  Fixture" (beit/reading_heading (beit/rava).set_name("Fixture")))]

  + linked
    \ ignored=unit
    ^ row[testing/check]
    = here=path [($x 17) 'app 'torah_chunks 'source]
      card (chunks/card here "Repeated words" (goo/text/en "אמר אמר"))
      first (chunks/destination here 1 (./some (chunks/span 0 6 "אמר")))
      last (chunks/destination here 1 (./some (chunks/span 7 13 "אמר")))
      comment (chunks/place card chunks/comments first)
      tract card.put(chunks/cites (chunks/links [last]))
      note (chunks/edges here comment).at(0)
      cite (chunks/edges here tract).at(0)
    [(testing/nat "anchor and citation are separate relationships" 1 (and note.home !(cite.home)))
     (testing/nat "ordinary citation leaves its tract unanchored" 1 (maybe/is_none tract.get(['chunk 'anchor])))
     (testing/nat "repeated words keep separate ranges" 1 !(equal[chunks/destination] first last))
     (testing/nat "complete range accepted" 1 (chunks/valid last (./some card)))
     (testing/nat "quotation spelling checked" 0 (chunks/valid last (./some card.put(['chunk 'body] (goo/text/pail (goo/text/en "אמר אחר"))))))
     (testing/nat "revision change invalidates even identical words" 0 (chunks/valid first (./some card.put(['chunk 'revision] (pails/n 2)))))
     (testing/nat "missing target leaves an unresolved anchor" 0 (chunks/valid note.dest .none))]

  + hebrew
    \ ignored=unit
    ^ row[testing/check]
    = word (beit/evidence).hebrew base (goo_profile/text_style (goo_fp/integer 1) "text" "title")
      runs (goo/text/en word).map(goo_run/fallback)
      lines (goo_ascii/wrap_runs base (goo_fp/integer 1) (goo_fp/integer 1) runs)
      pieces=row[str] lines.map((\ t=goo/text t.plain)).row
    [(testing/nat "reject truncated UTF-8" 0 (goo_run/supported_text (str/from_atom 215)))
     (testing/nat "diagnose unmeasured vowel marks" 0 (goo_run/supported_text "שָ"))
     (testing/nat "mixed unpointed source accepted" 1 (goo_run/supported_text "ידיעה / D1"))
     (testing/nat "narrow lines never cut a UTF-8 letter" 1 pieces.all(goo_run/supported_text))
     (testing/text "wrapping preserves logical evidence" word (str/cat_all pieces))
     (testing/text "resolved fallback is pinned" "hebrew" (goo_run/font base runs.at(0).myth).id)]

  + ranges
    \ ignored=unit
    ^ row[testing/check]
    = passage=str "אמר אמר"
      make
        \ lo=nat hi=nat quote=str
        ^ str
        | show (json/arr [(json/str (path_show beit/document)) (json/num .false lo) (json/num .false hi) (json/str quote)])
      valid (\ wire=str (maybe/is_some (beit/anchor wire passage)))
    [(testing/nat "first occurrence" 1 (valid (make 0 6 "אמר")))
     (testing/nat "second occurrence" 1 (valid (make 7 13 "אמר")))
     (testing/nat "wrong quote" 0 (valid (make 7 13 "אחר")))
     (testing/nat "split Hebrew scalar" 0 (valid (make 1 6 "אמר")))
     (testing/nat "partial word" 0 (valid (make 2 6 "מר")))
     (testing/nat "empty range" 0 (valid (make 7 7 "")))
     (testing/nat "out of bounds" 0 (valid (make 7 14 "אמר")))
     (testing/nat "changed document" 0 (valid (show (json/arr [(json/str "/other") (json/num .false 7) (json/num .false 13) (json/str "אמר")]))))]

  + gematria
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "selected phrase" 1162 (beit/gematria "יאוש שלא מדעת"))
     (testing/nat "first word" 317 (beit/gematria "יאוש"))
     (testing/nat "second word" 331 (beit/gematria "שלא"))
     (testing/nat "third word" 514 (beit/gematria "מדעת"))
     (testing/nat "marks and punctuation ignored" 376 (beit/gematria "שָׁלוֹם! (peace)"))
     (testing/nat "final forms" (beit/gematria "כמנפצ") (beit/gematria "ךםןףץ"))
     (testing/nat "English has no Hebrew value" 0 (beit/gematria "Bava Metzia 21b:1"))]

+ tests
  ^ row[testing/case]
  [(testing/case "Linked chunks" beit_checks/linked) (testing/case "Folio citations" beit_checks/citations) (testing/case "Gematria" beit_checks/gematria) (testing/case "Beit midrash study transitions" beit_checks/study) (testing/case "Hebrew folio preparation" beit_checks/hebrew) (testing/case "Range evidence" beit_checks/ranges)]
