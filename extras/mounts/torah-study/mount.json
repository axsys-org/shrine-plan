{
  "version": 1,
  "name": "torah-study",
  "dependencies": [
    "explorer",
    "codecs"
  ],
  "modules": {
    "torah_study/model": "model.foil",
    "torah_study/chunks": "chunks.foil",
    "torah_study_mount": "mount.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "torah_study"
      ],
      "files": [
        "main.grove"
      ],
      "prelude": "torah_study/model"
    },
    {
      "root": [
        "gov",
        "torah_chunks"
      ],
      "files": [
        "chunks.grove"
      ],
      "prelude": "torah_study/chunks"
    }
  ],
  "assets": {
    "/torah-study/style.css": "style.css",
    "/torah-study/folio.js": "folio.js"
  },
  "files": {},
  "roots": [
    [
      "lib",
      "torah_study/model"
    ],
    [
      "lib",
      "torah_study/chunks"
    ],
    [
      "lib",
      "torah_study_mount"
    ],
    [
      "gov",
      "torah_study"
    ],
    [
      "gov",
      "torah_chunks"
    ]
  ],
  "tests": {
    "tests/torah_study": "test_study.foil"
  },
  "activate": {
    "module": "torah_study_mount",
    "entry": [
      "torah_study_mount",
      "install"
    ]
  },
  "http": {
    "module": "torah_study_mount",
    "entry": [
      "torah_study_mount",
      "http"
    ]
  },
  "routes": [
    "/torah-study"
  ],
  "workspaces": [
    {
      "name": "folio",
      "route": "/beit-midrash",
      "entry": [
        "gov",
        "torah_study",
        "daf"
      ],
      "receiver": {
        "slot": [
          "gov",
          "torah_study",
          "source_path"
        ],
        "initial": [
          "app",
          "torah_study",
          "folio"
        ],
        "admission": "record"
      },
      "shell": {
        "title": "Beit Midrash"
      }
    },
    {
      "name": "chunks",
      "route": "/torah-chunks",
      "panes": [["gov", "torah_chunks", "comparison"]],
      "entry": [
        "gov",
        "torah_chunks",
        "workspace"
      ],
      "receiver": {
        "slot": [
          "gov",
          "torah_chunks",
          "address"
        ],
        "initial": [
          "app",
          "torah_chunks"
        ],
        "admission": "record"
      },
      "shell": {
        "title": "Text library"
      }
    }
  ]
}
