- net
- grove_install
- weave

' Makes the course at /app/course when a world first starts with this
' mount, from the template the unit publishes; writes the course's table
' beneath it, read off the unit's norms; and tells the scope foot the
' course is this world's to keep: its places are tended, and what its
' table says this world writes for others is written.
+ course_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'course]
      target=path [state.self 'app 'course]
      tended=path [state.self 'io 'scope 'course]
    ? (net/live tended state) (./ok state)
    ?> (./some version) state.case(.x source) (./err (pails/t "The course template is not published."))
    ?> (./ok made) (grove_install/instantiate source version target state)
      | ./err (pails/t "The course could not be made.")
    = tends=myth
        . (myth/sing ['root] (safe 0 .x target))
          put(['maker] (pails/n (quip_val state.self)))
          put(['rel] (pails/t "/app/course"))
          put(['side] (safe 0 .x target))
      rows (weave/tabled (weave/unit source made) target made)
      writes=row[[p=path q=writ]] rows.snoc([tended (writ/make tends)])
    ?> (./ok next) (grove_install/changes writes made)
      | ./err (pails/t "The course's table could not be written.")
    | ./ok next
