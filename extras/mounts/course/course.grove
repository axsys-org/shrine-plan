#import lede=sys/lede
#import text=lib/grove/types/text
#import duration=lib/grove/types/duration

' A course, as a template. Each stencil below is one row of its table:
' where a thing sits (#here), what it is (#with), who writes it (#by) and
' who reads it (#for). A capture that the position's own path binds names
' one seat; under another name it means every seat. A stencil that names
' an action (#apply) is a place where its writer may ask for that action,
' of the thing the place sits beneath; whoever writes that thing applies
' it. Nothing else says who may do what.
'
' Slots are spelled by plain names (title, due, days), so a record reads
' the same in every world that holds this template.

card =
  @role
  #meta ;
    lede: "Anything in a course that has a title"
  title: text

assignment =
  @role
  #meta ;
    lede: "What the chair sets, and in how many days it is due"
  title: text
  due: duration

more =
  @role
  #meta ;
    lede: "What a seat writes to ask for more days"
  days: duration

extend =
  @action
  #meta ;
    lede: "Give an assignment more days"
  #on ; assignment
  days: duration
  ! foil
  \ days=duration rec=%/assignment
  ^ %/assignment
  rec.set_due((add rec.due days))

chair =
  @stencil
  #meta ;
    lede: "The seat of whoever teaches"
  #here ; '/chair
  #with ; card
  #by ; maker
  #for ; '/chair
  #for ; '/seats/[any]

seats =
  @stencil
  #meta ;
    lede: "A seat for whoever studies"
  #here ; '/seats/[s=@tas]
  #with ; card
  #by ; maker
  #for ; '/chair
  #for ; '/seats/[any]

assignments =
  @stencil
  #meta ;
    lede: "What the chair sets"
  #here ; '/assignments/[a=@tas]
  #with ; assignment
  #by ; '/chair
  #for ; '/seats/[any]

work =
  @stencil
  #meta ;
    lede: "What a seat hands in for an assignment"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]
  #with ; card
  #by ; '/seats/[s]
  #for ; '/chair

mark =
  @stencil
  #meta ;
    lede: "What the chair says of a seat's work"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]/mark
  #with ; card
  #by ; '/chair
  #for ; '/seats/[s]

extensions =
  @stencil
  #meta ;
    lede: "A seat asks for more days on an assignment"
  #here ; '/assignments/[a=@tas]/extensions/[s=@tas]
  #with ; more
  #by ; '/seats/[s]
  #for ; '/chair
  #apply ; extend

"/" =
  @tree
  title: "A course"

"/chair" =
  @tree
  title: "The chair"
  invite: 1

"/seats" =
  @tree

"/seats/first" =
  @tree
  title: "A seat"
  invite: 2

"/seats/second" =
  @tree
  title: "A seat nobody is invited to yet"
