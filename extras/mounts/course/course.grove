#import lede=sys/lede
#import text=lib/grove/types/text

' A course, as a template. Each norm below is one row of its table: where
' a thing sits (#here), what it is (#with), and, in its metadata, who
' writes it (by) and who reads it (for). A capture that the position's own
' path binds names one seat; under another name it means every seat.
' Nothing else says who may do what.

title =
  @slot
  #meta ;
    lede: "What a thing is called"

body =
  @slot
  #meta ;
    lede: "What a thing says"

card =
  @role
  #meta ;
    lede: "Anything in a course that has a title"
  %/title: text

chair =
  @norm
  #meta ;
    lede: "The seat of whoever teaches"
    by: "maker"
    for: "chair seats/[any]"
  #here ; '/chair
  #with ; card

seats =
  @norm
  #meta ;
    lede: "A seat for whoever studies"
    by: "maker"
    for: "chair seats/[any]"
  #here ; '/seats/[s=@tas]
  #with ; card

assignments =
  @norm
  #meta ;
    lede: "What the chair sets"
    by: "chair"
    for: "seats/[any]"
  #here ; '/assignments/[a=@tas]
  #with ; card

work =
  @norm
  #meta ;
    lede: "What a seat hands in for an assignment"
    by: "seats/[s]"
    for: "chair"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]
  #with ; card

mark =
  @norm
  #meta ;
    lede: "What the chair says of a seat's work"
    by: "chair"
    for: "seats/[s]"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]/mark
  #with ; card

"/" =
  @tree
  %/title: "A course"

"/chair" =
  @tree
  %/title: "The chair"
  invite: 1

"/seats" =
  @tree

"/seats/first" =
  @tree
  %/title: "A seat"
  invite: 2

"/seats/second" =
  @tree
  %/title: "A seat nobody is invited to yet"
