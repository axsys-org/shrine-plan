#import lede=sys/lede
#import text=lib/grove/types/text
#import duration=lib/grove/types/duration

' A course, as a template. Each norm below is one row of its table: where
' a thing sits (#here), what it is (#with), and, in its metadata, who
' writes it (by) and who reads it (for). A capture that the position's own
' path binds names one seat; under another name it means every seat.
' A norm that names an action (apply) is a place where its writer may ask
' for that action, of the thing the place sits beneath; whoever writes
' that thing applies it. Nothing else says who may do what.
'
' Slots are spelled by plain names (title, due, days), so a record reads
' the same in every world that holds this template.

card =
  @role
  #meta ;
    lede: "Anything in a course that has a title"
  title: text

assignment =
  @role
  #meta ;
    lede: "What the chair sets, and in how many days it is due"
  title: text
  due: duration

more =
  @role
  #meta ;
    lede: "What a seat writes to ask for more days"
  days: duration

extend =
  @action
  #meta ;
    lede: "Give an assignment more days"
  #on ; assignment
  days: duration
  ! foil
  \ days=duration rec=%/assignment
  ^ %/assignment
  rec.set_due((add rec.due days))

chair =
  @norm
  #meta ;
    lede: "The seat of whoever teaches"
    by: "maker"
    for: "chair seats/[any]"
  #here ; '/chair
  #with ; card

seats =
  @norm
  #meta ;
    lede: "A seat for whoever studies"
    by: "maker"
    for: "chair seats/[any]"
  #here ; '/seats/[s=@tas]
  #with ; card

assignments =
  @norm
  #meta ;
    lede: "What the chair sets"
    by: "chair"
    for: "seats/[any]"
  #here ; '/assignments/[a=@tas]
  #with ; assignment

work =
  @norm
  #meta ;
    lede: "What a seat hands in for an assignment"
    by: "seats/[s]"
    for: "chair"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]
  #with ; card

mark =
  @norm
  #meta ;
    lede: "What the chair says of a seat's work"
    by: "chair"
    for: "seats/[s]"
  #here ; '/assignments/[a=@tas]/work/[s=@tas]/mark
  #with ; card

extensions =
  @norm
  #meta ;
    lede: "A seat asks for more days on an assignment"
    by: "seats/[s]"
    for: "chair"
    apply: "extend"
  #here ; '/assignments/[a=@tas]/extensions/[s=@tas]
  #with ; more

"/" =
  @tree
  title: "A course"

"/chair" =
  @tree
  title: "The chair"
  invite: 1

"/seats" =
  @tree

"/seats/first" =
  @tree
  title: "A seat"
  invite: 2

"/seats/second" =
  @tree
  title: "A seat nobody is invited to yet"
