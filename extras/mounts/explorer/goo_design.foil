- goo_wire_browser
- browser_routes

+ goo_design
  ' A record explicitly supplies a style projection for a published editor view.
  ' Fields are ordered padX, padY, stroke width, stroke color, fill, radius.
  + form
    : slot=path fields=row[path]
  + pixels
    \ value=str limit=nat
    ^ either[str maybe[nat]]
    ? (eq value "") (./ok .none)
    ?> (./some n) (nat/parse value) (./err "Use whole CSS pixels.")
    ? (gt n limit) (./err (str/cat_all ["Maximum is " limit.show " CSS pixels."]))
    | ./ok (./some n)
  + color
    \ value=str
    ^ either[str maybe[str]]
    ? (eq value "") (./ok .none)
    ? !(goo/design/color value) (./err "Use a color such as #315b91.")
    | ./ok (./some value)
  + parse
    \ values=row[str]
    ^ either[str goo/design]
    ? !(eq values.len 6) (./err "Expected six style inputs.")
    < x (goo_design/pixels values.at(0) 96)
    < y (goo_design/pixels values.at(1) 96)
    < stroke (goo_design/pixels values.at(2) 12)
    < edge (goo_design/color values.at(3))
    < fill (goo_design/color values.at(4))
    < radius (goo_design/pixels values.at(5) 48)
    | ./ok (goo/design x y stroke edge fill radius)
  + preview
    \ context=goo_bridge/render_context fields=row[[str str]] state=namespace
    ^ either[str goo_wire/presentation]
    = get (\ key=str (http_foot/field key fields))
    ?> (./some target) (path_parse (get "target")) (./err "Invalid design receiver.")
    ?> (./some view) (path_parse (get "view")) (./err "Invalid design declaration.")
    < card (goo_browser/render_card target [] state)
    ?> (./some held) card.get(view) (./err "No design form on this receiver.")
    ?> form=goo_design/form held (./err "No design form on this receiver.")
    = inputs (fields.keep((\ [k v] (eq k.slice(0 6) "input:"))))
    ? !(eq inputs.len form.fields.len) (./err "Design inputs changed.")
    = values=either[str row[str]]
        % i=nat 0 out=row[str] []
        ^ either[str row[str]]
        ? (eq i form.fields.len) (./ok out)
        = key (str/cat_all ["input:" (path_show form.fields.at(i))])
          matches (inputs.keep((\ [k v] (eq k key))))
        ? !(eq matches.len 1) (./err "Missing or duplicate design input.")
        = [name value] matches.at(0)
        | _ i.inc out.snoc(value)
    < values values
    < style (goo_design/parse values)
    = projected card.put(form.slot style)
      rules (goo_theme/projected (goo_theme/published state) state.self target projected)
    < result (goo_wire_browser/render_themed_card context.set_theme(rules) target view [] [] [] .none state projected)
    ?> (./some s) result.snapshot (./err "Missing source snapshot.")
    ? !(and (eq s.life (get "life")) (and (eq s.expected (get "expected")) (and (eq s.displayed (get "displayed")) (eq s.publication (get "publication")))))
      | ./err "The design source changed. Refresh to preview."
    | ./ok result
  + response
    \ context=goo_bridge/render_context fields=row[[str str]] state=namespace
    ^ [nat any nat]
    ? (goo_design/preview context fields state)
     > (./ok result) [200 (wire_proto/envelope 2 (goo_wire/presentation_bytes result)) "application/x-protobuf"]
     > (./err why) [409 (wire_proto/failure why) "application/x-protobuf"]
