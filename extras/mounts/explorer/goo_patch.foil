- system_vocabulary
- goo_bridge
- weft
- http_foot
- value_read

' Server-resolved patch scenes with parallel portable and HTML occurrence content.
+ goo_patch
  + query_provider
    : target=path read={\ json namespace}either[str json]
  + query_path
    \ self=iota view=path
    ^ path
    = root=path [self 'weft 'goo_patch_queries]
    | root.weld(view)
  + query_response
    \ fields=row[[str str]] state=namespace
    ^ [nat str]
    = get (\ key=str (http_foot/field key fields))
      view (http_foot/target (get "view")) target (http_foot/target (get "target"))
    ?> (./some card) (goo_runtime/record .x (goo_patch/query_path state.self view) state) [404 "No patch query provider"]
    ?> (./some held) card.get(system_vocabulary/content) [404 "No patch query provider"]
    ?> provider=goo_patch/query_provider held [409 "Invalid patch query provider"]
    ? !(equal target provider.target) [409 "Query target does not match its presentation"]
    ?> (jres/ok query rest) (parse (get "query")) [400 "Invalid query"]
    = read provider.read
    ? (read query state)
     > (./ok response) [200 (show response)]
     > (./err message) [409 message]
  + occurrence
    : kind=str key=str body=list[goo/node]
  + population
    ' Server-authored native content for a runtime population. Mutations remain
    ' in statically published patch_operation bindings, never in scene JSON.
    : occurrences=row[goo_patch/occurrence]
  + passive
    \ node=goo/node
    ^ bool
    = allowed=row[str] ["image" "patch_presentation" "text" "path" "row" "col" "group" "or" "opt" "patch_port" "patch_handle" "patch_select" "patch_label"]
    | (and allowed.has(node.constructor) node.children.all(goo_patch/passive))
  + presentation_frame
    ' Server-authored embedded Goo document, never an arbitrary iframe URL.
    \ node=goo/node
    ^ either[str goo_patch/fragment]
    = target (goo_patch/property "target" node) slot (goo_patch/property "slot" node)
      label (goo_patch/property "label" node) key (goo_patch/key node)
    ?> (./some subject) (path_parse target) (./err "Presentation requires an absolute subject path")
    ?> (./some lexical) (path_parse slot) (./err "Presentation requires an absolute slot path")
    ? ((eq subject.len 0) || (eq lexical.len 0) || (eq label.len 0) || (eq key.len 0) || !(node.children.is_nil)) (./err "Invalid presentation frame")
    ?> (./some width) (nat/parse (goo_patch/property "width" node)) (./err "Presentation width required")
    ?> (./some height) (nat/parse (goo_patch/property "height" node)) (./err "Presentation height required")
    ?> (./some top) (nat/parse (goo_patch/property "top" node)) (./err "Presentation top required")
    ? ((lt width 32) || (gt width 2000) || (lt height 32) || (gt height 2000) || (gt top 2000)) (./err "Invalid presentation rectangle")
    = url (str/cat_all ["/goo-presentation?path=" (value_read/percent target) "&slot=" (value_read/percent slot)])
      style (str/cat_all ["position:absolute;left:16px;top:" (nat/show top) "px;width:" (nat/show width) "px;height:" (nat/show height) "px;border:0;background:transparent"])
      portable (json/obj [(jkv "kind" (json/str "presentation")) (jkv "key" (json/str key))
        (jkv "label" (json/str label)) (jkv "target" (json/str (path_show subject)))
        (jkv "slot" (json/str (path_show lexical))) (jkv "units" (json/str "css-px"))
        (jkv "rect" (json/obj [(jkv "x" (json/num .false 16)) (jkv "y" (json/num .false top))
          (jkv "width" (json/num .false width)) (jkv "height" (json/num .false height))]))])
    | ./ok (goo_patch/fragment (str/from_atom (weft/render (weft/el "iframe"
        [(weft/att "data-goo-presentation-frame" (str/to_atom key)) (weft/att "title" (str/to_atom label))
         (weft/att "src" (str/to_atom url)) (weft/att "style" (str/to_atom style))] []))) [] [portable])
  + population_contents
    \ context=goo_bridge/render_context published=goo/published card=myth node=goo/node scene=json route=row[nat]
    ^ either[str row[json]]
    ?> (./some expression) (goo_runtime/named "population" node.arguments) (./ok [])
    ?> (./some held) (goo_bridge/value published card expression) (./err "Patch population unavailable")
    ?> population=goo_patch/population held (./err "Patch population must be typed server content")
    ? (gt population.occurrences.len 4096) (./err "Patch population exceeds its bound")
    % rest=row[goo_patch/occurrence] population.occurrences ordinal=nat 0 out=row[json] [] keys=row[[str str]] []
    ^ either[str row[json]]
    ? (eq rest.len 0) (./ok out)
    = item rest.at(0) identity=[str str] [item.kind item.key]
    ? (keys.has(identity)) (./err "Duplicate dynamic occurrence")
    ? !((eq item.kind "patch_node") || (eq item.kind "patch_connection")) (./err "Invalid dynamic occurrence kind")
    ? !(item.body.all(goo_patch/passive)) (./err "Dynamic content requires passive Goo; use published operations for actions")
    = matches ((goo_patch/items (goo_patch/field "nodes" scene)).keep((\ record (eq (goo_patch/text (goo_patch/field "key" record)) item.key))))
      width=goo/scalar
        ? !(eq item.kind "patch_node") context.width
        ? !(eq matches.len 1) context.width
        | (goo_number/nonnegative (goo_patch/field "width" (goo_patch/field "rect" matches.at(0)))).fall(context.width)
      local context.set_width(width)
    < body (goo_patch/body local published card item.body route.snoc(ordinal) (\ node route []))
    | _ rest.drop(1) ordinal.inc out.snoc((json/obj
        [(jkv "kind" (json/str item.kind)) (jkv "key" (json/str item.key))
         (jkv "html" (json/str body.html)) (jkv "controls" (json/arr [])) (jkv "content" (json/arr body.content))
         (jkv "context" (goo_bridge/context_json local))])) keys.snoc(identity)
  + field
    \ name=str value=json
    ^ json
    | goo_runtime/json_field name value
  + text
    \ value=json
    ^ str
    | goo_runtime/json_text value
  + items
    \ value=json
    ^ row[json]
    ?> (json/arr values) value []
    values
  + key
    \ node=goo/node
    ^ str
    ? node.arguments.is_nil ""
    ?> (./leaf _ _ value) node.arguments.head ""
    value
  + property
    \ name=str node=goo/node
    ^ str
    ?> (./some expression) (goo_runtime/named name node.arguments) ""
    ? (goo_runtime/read_path expression)
     > (./some path) (path_show path)
    ?> (./leaf _ _ value) expression ""
    value
  + special
    \ node=goo/node
    ^ bool
    | ((eq node.constructor "patch_port") || (eq node.constructor "patch_handle") || (eq node.constructor "patch_select") || (eq node.constructor "patch_label") || node.children.any(goo_patch/special))
  + fragment
    : html=str controls=row[json] content=row[json]
  + native
    \ context=goo_bridge/render_context published=goo/published card=myth node=goo/node route=row[nat] metadata={\ goo/node row[nat]}row[json]
    ^ either[str goo_patch/fragment]
    = local (published.set_view(published.view.set_name(published.view.name.snoc(($ts (str/cat_all ["patch_" (str/join "_" route.map(nat/show))]))))))
    < compiled (goo_bridge/compile context local card local.view.set_children((list/one node)))
    = prepared compiled.prepared
    = prefix (str/cat_all [(path_show published.view.name) ":"])
      local_prefix (str/cat_all [(path_show local.view.name) ":"])
      rewrite
        \ entry=jkv
        ^ jkv
        ? !(eq entry.k "id") entry
        = original (goo_patch/text entry.v)
          suffix (original.slice(prefix.len (sub original.len prefix.len)))
        | jkv "id" (json/str (str/cat_all [local_prefix suffix]))
      controls=row[json]
        | (metadata node route).map
        \ control=json
        ^ json
        ?> (json/obj fields) control control
        | json/obj (fields.map(rewrite))
    ?> (./some display) (goo_prepared/encode prepared) (./err "Patch body display failed validation.")
    = controls (goo_bridge/control_descriptors controls display)
      html (goo_html/fragment prepared)
      fields=row[jkv] [(jkv "kind" (json/str "body")) (jkv "key" (json/str (str/join "." route.map(nat/show))))
        (jkv "profile" (goo_profile/metadata unit/unit)) (jkv "context" (goo_bridge/context_json context))
        (jkv "display" display) (jkv "controls" (json/arr controls))]
      body (json/obj fields.weld((goo_bridge/pipeline_fields context compiled display html controls)))
    | ./ok (goo_patch/fragment html controls [body])
  + body
    \ context=goo_bridge/render_context published=goo/published card=myth nodes=list[goo/node] route=row[nat] metadata={\ goo/node row[nat]}row[json]
    ^ either[str goo_patch/fragment]
    % rest=list[goo/node] nodes ordinal=nat 0 html=str "" controls=row[json] [] content=row[json] []
    ^ either[str goo_patch/fragment]
    ? rest.is_nil (./ok (goo_patch/fragment html controls content))
    = node rest.head here route.snoc(ordinal) kind node.constructor
      key (goo_patch/key node) label (goo_patch/property "label" node)
      fragment=either[str goo_patch/fragment]
        ? (eq kind "patch_presentation") (goo_patch/presentation_frame node)
        ? ((eq kind "patch_port") || (eq kind "patch_handle") || (eq kind "patch_select"))
          ? !(node.children.is_nil) (./err "Patch controls are named native controls without children.")
          ? !(gt label.len 0) (./err "patch controls require label = accessible text.")
          = button (weft/leaf "button" [(weft/att "type" "button")
              (weft/att (? (eq kind "patch_port") "data-patch-anchor" (? (eq kind "patch_select") "data-patch-select" "data-patch-handle")) "")
              (weft/att "aria-label" (str/to_atom label)) (weft/att "title" (str/to_atom label))]
              (? (eq kind "patch_port") "+" (? (eq kind "patch_select") "Select" "Move")))
            moves=row[weft/node]
              ? !(eq kind "patch_handle") []
              | goo_patch/move_controls label
            wrapper (weft/el (? (eq kind "patch_port") "goo-patch-port" "span")
              [(weft/att "data-key" (str/to_atom key))
               (weft/att "style" (? (eq kind "patch_port") "" (? (eq kind "patch_select") "position:absolute;inset:0" "position:absolute;bottom:4px;left:4px;z-index:1")))] moves.cons(button))
            portable (json/obj [(jkv "kind" (json/str (? (eq kind "patch_port") "port" (? (eq kind "patch_select") "select" "handle"))))
              (jkv "key" (json/str key)) (jkv "label" (json/str label))
              (jkv "moves" (? (eq kind "patch_handle") (goo_patch/move_descriptors label) (json/arr [])))])
          | ./ok (goo_patch/fragment (str/from_atom (weft/render wrapper)) [] [portable])
        ? (eq kind "patch_label")
          < inside (goo_patch/body context published card node.children here metadata)
          | ./ok (goo_patch/fragment (str/from_atom (weft/render (weft/el "span"
              [(weft/att "data-patch-label" (str/to_atom key))] [(weft/raw (str/to_atom inside.html))]))) inside.controls [(json/obj [(jkv "kind" (json/str "label")) (jkv "key" (json/str key)) (jkv "children" (json/arr inside.content))])])
        ? (goo_patch/special node) (./err "Place patch ports/handles/labels directly in their occurrence; ordinary Goo bodies retain their own layout.")
        | goo_patch/native context published card node here metadata
    < fragment fragment
    | _ rest.tail ordinal.inc (str/cat_all [html fragment.html]) controls.weld(fragment.controls) content.weld(fragment.content)
  + prepare
    \ context=goo_bridge/render_context published=goo/published card=myth node=goo/node route=row[nat] metadata={\ goo/node row[nat]}row[json]
    ^ either[str json]
    ?> (./some expression) (goo_runtime/named "scene" node.arguments) (./err "Missing patch scene.")
    ?> (./some value) (goo_bridge/value published card expression) (./err "Patch scene is unavailable.")
    ?> value=pails/t value (./err "Patch scene must be JSON text.")
    ? (gt value.t.len 16777216) (./err "Patch scene exceeds the payload bound.")
    ?> (jres/ok scene rest) (parse value.t) (./err "Invalid patch scene JSON.")
    < dynamic (goo_patch/population_contents context published card node scene route)
    % children=list[goo/node] node.children ordinal=nat 0 contents=row[json] dynamic offers=row[json] []
    ^ either[str json]
    ? children.is_nil
      | ./ok (json/obj [(jkv "kind" (json/str "patch")) (jkv "key" (json/str (goo_patch/key node)))
          (jkv "node" (json/str (str/join "." route.map(nat/show))))
          (jkv "label" (json/str (goo_patch/property "label" node)))
          (jkv "scene" scene) (jkv "contentVersion" (json/num .false 1)) (jkv "contents" (json/arr contents))
          (jkv "connectionControls" (goo_patch/connection_descriptors scene))
          (jkv "controlsHTML" (json/str (str/from_atom (weft/render (goo_patch/connection_controls scene)))))
          (jkv "offerBindings" (json/arr offers)) (jkv "children" (json/arr []))])
    = child children.head kind child.constructor key (goo_patch/key child)
    ? !((eq kind "patch_node") || (eq kind "patch_connection") || (eq kind "patch_operation"))
      | ./err "patch contains patch_node, patch_connection and patch_operation declarations."
    = matches ((goo_patch/items (goo_patch/field "nodes" scene)).keep((\ record (eq (goo_patch/text (goo_patch/field "key" record)) key))))
      width=goo/scalar
        ? !(eq kind "patch_node") context.width
        ? !(eq matches.len 1) context.width
        | (goo_number/nonnegative (goo_patch/field "width" (goo_patch/field "rect" matches.at(0)))).fall(context.width)
      local (context.set_width(width))
    < body (goo_patch/body local published card child.children route.snoc(ordinal) metadata)
    = item (json/obj [(jkv "kind" (json/str kind)) (jkv "key" (json/str key))
        (jkv "html" (json/str body.html)) (jkv "controls" (json/arr body.controls)) (jkv "content" (json/arr body.content))
        (jkv "context" (goo_bridge/context_json local))])
    ? !(eq kind "patch_operation") (_ children.tail ordinal.inc contents.snoc(item) offers)
    = actions (body.controls.keep((\ control (eq (goo_patch/text (goo_patch/field "kind" control)) "action"))))
      slot (goo_patch/property "slot" child)
    ? !(and (eq actions.len 1) (gt slot.len 0)) (./err "patch_operation requires one ordinary bound action and an input slot.")
    ? !(equal (goo_patch/field "invoke" actions.at(0)) (json/boo .true))
      | ./err "patch_operation requires a bound domain action."
    ? !(body.controls.any((\ control (and (eq (goo_patch/text (goo_patch/field "kind" control)) "input") (eq (goo_patch/text (goo_patch/field "slot" control)) slot)))))
      | ./err "patch_operation input slot must be declared by its ordinary Goo control."
    | _ children.tail ordinal.inc contents.snoc(item) offers.snoc((json/obj
        [(jkv "kind" (json/str key)) (jkv "argumentSlot" (json/str slot)) (jkv "control" actions.at(0))]))
  + inert_scene
    \ scene=json
    ^ str
    | str/join (str/cat_all [(str/from_atom 92) "u003c"]) (str/split_byte 60 (show scene))
  + markup
    \ node=json
    ^ weft/node
    = scene (goo_patch/field "scene" node)
      encoded (goo_patch/inert_scene scene)
      script (weft/el "script" [(weft/att "type" "application/json") (weft/att "data-patch-scene" "")]
        [(weft/raw (str/to_atom encoded))])
      contents (goo_patch/items (goo_patch/field "contents" node))
      children=row[weft/node]
        | contents.map
        \ content=json
        = kind (goo_patch/text (goo_patch/field "kind" content))
          key (goo_patch/text (goo_patch/field "key" content))
          tag=str (? (eq kind "patch_node") "goo-patch-node" (? (eq kind "patch_connection") "goo-patch-connection" "div"))
          attrs=row[weft/att] [(weft/att "data-key" (str/to_atom key))]
          attrs (? (eq kind "patch_operation") attrs.snoc((weft/att "slot" "controls")) attrs)
        | weft/el (str/to_atom tag) attrs [(weft/raw (str/to_atom (goo_patch/text (goo_patch/field "html" content))))]
    | weft/el "goo-patch" [(weft/att "role" "region")
        (weft/att "aria-label" (str/to_atom (goo_patch/text (goo_patch/field "label" node))))] children.cons(script)
  + move_descriptors
    \ label=str
    ^ json
    = directions=row[[str str str]] [["left" "-10" "0"] ["right" "10" "0"] ["up" "0" "-10"] ["down" "0" "10"]]
      moves=row[json]
        | directions.map
          \ [name x y]
          | json/obj [(jkv "direction" (json/str name)) (jkv "dx" (json/real x)) (jkv "dy" (json/real y))
              (jkv "label" (json/str (str/cat_all [label " " name])))]
    | json/arr moves
  + move_controls
    \ label=str
    ^ row[weft/node]
    | (goo_patch/items (goo_patch/move_descriptors label)).map
      \ move=json
      | weft/leaf "button" [(weft/att "type" "button") (weft/att "data-patch-move" "")
          (weft/att "data-dx" (str/to_atom (show (goo_patch/field "dx" move))))
          (weft/att "data-dy" (str/to_atom (show (goo_patch/field "dy" move))))
          (weft/att "aria-label" (str/to_atom (goo_patch/text (goo_patch/field "label" move))))]
          (str/to_atom (goo_patch/text (goo_patch/field "direction" move)))
  + connection_descriptors
    \ scene=json
    ^ json
    = connections=row[json]
        | (goo_patch/items (goo_patch/field "connections" scene)).map
          \ connection=json
          = key (goo_patch/text (goo_patch/field "key" connection))
            disconnect (json/obj [(jkv "kind" (json/str "disconnect")) (jkv "connection" (json/str key))
              (jkv "label" (json/str (str/cat_all ["Disconnect " key])))])
            reconnects=row[json]
              | (goo_patch/items (goo_patch/field "endpoints" connection)).map
                \ endpoint=json
                = name (goo_patch/text (goo_patch/field "key" endpoint))
                | json/obj [(jkv "kind" (json/str "reconnect")) (jkv "connection" (json/str key))
                    (jkv "endpoint" (json/str name)) (jkv "label" (json/str (str/cat_all ["Reconnect " key " " name])))]
          | json/obj [(jkv "key" (json/str key)) (jkv "controls" (json/arr reconnects.cons(disconnect)))]
    | json/arr connections
  + connection_controls
    \ scene=json
    ^ weft/node
    = rows=row[weft/node]
        | (goo_patch/items (goo_patch/connection_descriptors scene)).map
        \ connection=json
        = buttons=row[weft/node]
            | (goo_patch/items (goo_patch/field "controls" connection)).map
            \ control=json
            = kind (goo_patch/text (goo_patch/field "kind" control))
            | weft/leaf "button" [(weft/att "type" "button")
                (weft/att "data-patch-connection" (str/to_atom (goo_patch/text (goo_patch/field "connection" control))))
                (weft/att (? (eq kind "disconnect") "data-patch-disconnect" "data-patch-reconnect")
                  (str/to_atom (goo_patch/text (goo_patch/field "endpoint" control))))]
                (str/to_atom (goo_patch/text (goo_patch/field "label" control)))
        | weft/el "div" [] buttons
    | weft/el "div" [(weft/att "aria-label" "Connections")] rows
