- goo_runtime
- goo_app/ascii

' Reflect declared Goo actions for native clients. The interpreter, control
' addresses and argument constraints remain Goo's existing declarations.
+ goo_actions
  + input_slot
    \ field=rex
    ^ maybe[path]
    ?> (./nest _ _ rune kids) field .none
    ? !(and (eq rune "=") (eq kids.len 2)) .none
    ? ((goo_runtime/mentions "capture" kids.at(1)) || (goo_runtime/mentions "provider" kids.at(1))) .none
    ? !(goo_runtime/mentions "input" kids.at(1)) .none
    | goo_runtime/read_path kids.at(0)
  + enter_inputs
    ' A lexical myth declaration owns its inputs; layout containers do not.
    ' Inherited inputs remain available until that slot is rebound by a group.
    \ owners=mop[path row[nat] lt_pith] route=row[nat] node=goo/node
    ^ mop[path row[nat] lt_pith]
    ? !(eq node.constructor "group") owners
    = fields (goo_runtime/named "myth" node.arguments).run(goo_runtime/fields).fall((list/nil[rex]))
    | row/fold[rex mop[path row[nat] lt_pith]] owners
        (\ held field (goo_actions/input_slot field).run((\ slot held.put(slot route))).fall(held)) fields.row
  + input_owners
    \ nodes=list[goo/node] indices=row[nat] prefix=row[nat] owners=mop[path row[nat] lt_pith]
    ^ mop[path row[nat] lt_pith]
    ? ((eq indices.len 0) || (ge indices.at(0) nodes.len)) owners
    = node nodes.at(indices.at(0))
      route prefix.snoc(indices.at(0))
      next (goo_actions/enter_inputs owners route node)
    ? (eq indices.len 1) next
    | goo_actions/input_owners node.children indices.drop(1) route next
  + input_key
    \ owners=mop[path row[nat] lt_pith] slot=path
    ^ str
    | str/cat_all [(str/join "." owners.get(slot).fall([]).map(nat/show)) ":" (path_show slot)]
  + action_fields
    \ scope=goo_runtime/scope node=goo/node
    ^ list[rex]
    | scope.values.weld(node.arguments.drop(1).keep((\ arg=rex (maybe/is_none (goo_runtime/named "become" (list/one arg))))))
  + binding_fields
    ' Browser hints are derived from the same declared fields as native dispatch.
    ' They do not replace its missing/duplicate-input or publication guards.
    \ published=goo/published route=row[nat]
    ^ row[jkv]
    ?> (./ok view) published.result []
    ?> (./some found) (goo_runtime/locate view.children route (goo_runtime/scope .none .none .nil .none .none)) []
    = [node scope] found
      owners (goo_actions/input_owners view.children route [] (mop/empty))
    ? (eq node.constructor "input")
      ? !(node.arguments.len) []
      ?> (./some slot) (goo_runtime/read_path node.arguments.head) []
      [(jkv "inputBinding" (json/str (goo_actions/input_key owners slot)))]
    ? !(eq node.constructor "action") []
    = keys (row/bind[rex json] (goo_actions/input_field_key owners) (goo_actions/action_fields scope node).row)
    [(jkv "inputBindings" (json/arr keys))]
  + input_field_key
    \ owners=mop[path row[nat] lt_pith] field=rex
    ^ row[json]
    ?> (./some slot) (goo_actions/input_slot field) []
    [(json/str (goo_actions/input_key owners slot))]
  + rich_bindings
    \ nodes=list[goo/node] prefix=row[nat] owners=mop[path row[nat] lt_pith]
    ^ row[str]
    % offset=nat 0 out=row[str] []
    ^ row[str]
    ? (eq offset nodes.len) out
    = node nodes.at(offset)
      route prefix.snoc(offset)
      entered (goo_actions/enter_inputs owners route node)
      out out.weld((goo_actions/rich_bindings node.children route entered))
      out=row[str]
        ? !(and (eq node.constructor "input") (gt node.arguments.len 1)) out
        ?> (./some slot) (goo_runtime/read_path node.arguments.at(0)) out
        ?> (./leaf _ _ role) node.arguments.at(1) out
        ? !(goo_ascii/rich_role role) out
        | out.snoc((goo_actions/input_key entered slot))
    | _ offset.inc out
  + input_field
    \ rich=row[str] owners=mop[path row[nat] lt_pith] card=myth field=rex
    ^ myth
    ?> (./nest _ _ rune kids) field card
    ? !(and (eq rune "=") (eq kids.len 2)) card
    ?> (./some slot) (goo_runtime/read_path kids.at(0)) card
    ? (goo_runtime/mentions "capture" kids.at(1)) (card.put(slot.weld(['goo 'input]) (pails/t "selection")))
    ? (goo_runtime/mentions "provider" kids.at(1)) card
    ? (goo_runtime/mentions "input" kids.at(1)) (card.put(slot.weld(['goo 'input]) (pails/t (? (row/has[str] (goo_actions/input_key owners slot) rich) "rich_text" "text"))))
    card
  + controls
    \ nodes=list[goo/node] prefix=row[nat] scope=goo_runtime/scope query=goo_runtime/request binding=str
    ^ axal[myth]
    | goo_actions/controls_scoped nodes prefix scope query binding (mop/empty) (goo_actions/rich_bindings nodes prefix (mop/empty))
  + controls_scoped
    ' Reflection walks Goo's compiled declarations and scopes, retaining the
    ' original control address. No second action schema or interpreter.
    \ nodes=list[goo/node] prefix=row[nat] scope=goo_runtime/scope query=goo_runtime/request binding=str owners=mop[path row[nat] lt_pith] rich=row[str]
    ^ axal[myth]
    % offset=nat 0 out=axal[myth] (axal/new[myth] .none)
    ^ axal[myth]
    ? (eq offset nodes.len) out
    = node nodes.at(offset)
      route=row[nat] prefix.snoc(offset)
      entered (goo_runtime/enter scope node)
      inputs (goo_actions/enter_inputs owners route node)
      nested (goo_actions/controls_scoped node.children route entered query binding inputs rich)
      out (axal/gas[myth] nested.tap out)
      out=axal[myth]
        ? !(eq node.constructor "action") out
        ?> (./ok _) (goo_runtime/bound_control binding [node entered]) out
        = fields (goo_actions/action_fields entered node)
          label=str
            ? !(node.arguments.len) "Action"
            ?> (./leaf _ _ text) node.arguments.head node.arguments.head.print
            text
          card (myth/sing ['goo 'request] query.set_control(route)).put(['title] (pails/t label))
          card card.put(['goo 'bindings] (pails/t (str/join "; " fields.row.map((\ field=rex field.print)))))
          card=myth
            ?> (./some expression) entered.action card
            ?> (./some declaration) (goo_runtime/read_path expression) card
            | card.put(['goo 'action] (safe 0 .x declaration))
          card (row/fold[rex myth] card (goo_actions/input_field rich inputs) fields.row)
        | out.put(route.map((\ n=nat ($u n))) card)
    | _ offset.inc out
  + describe
    ' Retain the native declaration and receiver contract. This only reads;
    ' neither action handlers nor namespace operation planners execute here.
    \ state=namespace view=goo/published card=myth
    ^ myth
    = card card.put(['goo 'contract] view.contract)
      card card.put(['goo 'view_origin] (safe state.case(.x view.view.name).fall(0) .x view.view.name))
    ?> (./some held) card.get(['goo 'action]) card
    ?> reference=safe held card
    ?> (./some declaration) (goo_runtime/record .x reference.path state) card
    = reference (safe state.case(.x reference.path).fall(0) reference.care reference.path)
      card card.put(['goo 'action] reference)
      card card.put(['goo 'declaration] (cell_view (pin (axal/new[myth] (./some declaration)))))
    ?> (./some held) declaration.get(system_vocabulary/grove/action) card
    ?> schema=grove_action_schema held card
    | card.put(['goo 'schema] schema).put(['goo 'receiver_role] (safe state.case(.x schema.receiver).fall(0) .x schema.receiver))
