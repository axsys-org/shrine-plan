- browser_routes
- goo_browser
- goo_inspection
- goo_wire_browser

+ explorer_dev
  + interact
    \ request=http_foot/request now=nat
    ^ http_foot/action
    = parts (http_foot/split 63 request.target)
      source (equal parts.at(0) "/goo/source")
      wire_fields (http_foot/fields (? (eq request.method "GET") (? (eq parts.len 2) parts.at(1) "") request.body))
      wires (wire_fields.keep((\ [key value] (eq key "wire"))))
      wire (http_foot/field "wire" wire_fields)
    ? ((gt wires.len 1) || !((eq wire "") || (eq wire "protobuf-v2")))
      | ./reply (http_driver/response 415 "Unsupported Goo wire format")
    ? (equal parts.at(0) "/goo/inspect")
      ? (eq wire "protobuf-v2") (./reply (http_driver/response 415 "Inspection captures require their JSON contract"))
      | explorer_dev/inspect request
    ? (equal parts.at(0) "/goo/patch-query")
      ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
      ? (gt request.body.len 65536) (./reply (http_driver/response 413 "Patch query is too large"))
      ? (eq wire "protobuf-v2") (./reply (http_driver/response 415 "Patch packets require their JSON contract"))
      | ./snapshot (goo_patch/query_response (http_foot/fields request.body))
    ? (equal parts.at(0) "/goo/edit-value")
      ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
      ? (gt request.body.len 262144) (./reply (http_driver/response 413 "Value input is too large"))
      = fields (http_foot/fields request.body)
        get (\ key=str (http_foot/field key fields))
      ?> (./some target) (path_parse (get "target")) (./reply (http_driver/response 400 "Invalid target"))
      ?> (./some expected) (nat/parse (get "expected")) (./reply (http_driver/response 400 "Invalid version"))
      = query (goo_runtime/request "edit-value" target target [] [] expected 0 0
          [["slot" (get "slot")] ["kind" (get "kind")] ["value" (get "value")] ["context" (get "context")]] now)
      ? (eq wire "protobuf-v2") (./interact_bat query goo_wire/encode)
      | ./interact query
    ? (equal parts.at(0) "/goo/render") (explorer_dev/render request)
    = receipt (equal parts.at(0) "/goo/operation-status")
      reading ((equal parts.at(0) "/goo/status") || source || receipt)
    ? !(equal request.method (? reading "GET" "POST"))
      | ./reply (http_driver/response 405 "Incorrect method")
    ? !(reading || (equal parts.at(0) "/goo/act"))
      | ./reply (http_driver/response 404 "Unknown interaction operation")
    = fields (http_foot/fields (? reading (? (eq parts.len 2) parts.at(1) "") request.body))
      get (\ key=str (http_foot/field key fields))
      indices ((get "control").split_byte(46))
    ?> (./some expected) (nat/parse (? reading "0" (get "expected"))) (./reply (http_driver/response 400 "Invalid object version"))
    ?> (./some displayed) (nat/parse (? reading "0" (get "displayed"))) (./reply (http_driver/response 400 "Invalid display version"))
    ?> (./some publication) (nat/parse (? reading "0" (get "publication"))) (./reply (http_driver/response 400 "Invalid publication version"))
    ? !(reading || (indices.all((\ index (maybe/is_some (nat/parse index))))))
      | ./reply (http_driver/response 400 "Invalid control")
    ? (and source (and (gt (get "axis").len 0) !((eq (get "axis") "x") || ((eq (get "axis") "y") || (eq (get "axis") "z")))))
      | ./reply (http_driver/response 400 "Invalid source axis")
    = inputs (fields.keep((\ [key value] (equal key.slice(0 6) "input:"))))
      inputs (inputs.map((\ [key value] [key.slice(6 (sub key.len 6)) value])))
      inputs (? source inputs.snoc(["$axis" (? (get "axis").len (get "axis") "z")]) inputs)
      inputs (? source inputs.weld([["$parent" (get "parent")] ["$after" (get "after")] ["$epoch" (get "epoch")]]) inputs)
    = query (goo_runtime/request (? source (? (eq (get "topology") "tree") (? (eq (get "paged") "1") "tree-page" "tree-source") "source") (? receipt "operation-status" (? reading "status" "act")))
        (browser_routes/target (get "target")) (browser_routes/target (get "subject")) (browser_routes/target (get "view"))
        (indices.map((\ index (nat/parse index).fall(0))))
        expected displayed publication
        (? (eq (get "invocation").len 0) inputs inputs.snoc(["$invocation" (get "invocation")])) now)
    ? (and source (eq (get "presentations") "pane-v1"))
      ? !(and (eq (get "topology") "tree") (eq (get "paged") "1"))
        | ./reply (http_driver/response 400 "Prepared children require tree paging")
      = slots=row[str] (fields.keep((\ [key value] (eq key "slot")))).map((\ [key value] value))
      ? ((eq slots.len 0) || (gt slots.len 8) || !(slots.all((\ slot=str (maybe/is_some (path_parse slot))))))
        | ./reply (http_driver/response 400 "Invalid child presentation slots")
      ?> (./some scale) (explorer_dev/render_number (get "textScale")) (./reply (http_driver/response 400 "Invalid text scale"))
      ? ((goo_fp/lte scale (goo_fp/integer 0)) || !(goo_fp/lte scale (goo_fp/integer 10)))
        | ./reply (http_driver/response 400 "Invalid text scale")
      ? !((eq (get "direction") "ltr") || (eq (get "direction") "rtl"))
        | ./reply (http_driver/response 400 "Invalid direction")
      = context (goo_bridge/render_context (goo_fp/integer 240) scale (eq (get "direction") "rtl") (eq (get "pipeline") "1"))
      ? (eq (get "wire") "protobuf-v2")
        | ./snapshot_bat (\ state=namespace (goo_wire/result (goo_browser/tree_layouts context query (slots.map((\ slot=str (path_parse slot).fall([])))) state)))
      | ./snapshot (goo_browser/tree_layout_response context query (slots.map((\ slot=str (path_parse slot).fall([])))))
    ? (eq (get "wire") "protobuf-v2") (./interact_bat query goo_wire/encode)
    | ./interact query
  + inspect
    \ request=http_foot/request
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    ? (gt request.body.len 65536) (./reply (http_driver/response 413 "Inspection is too large"))
    = fields (http_foot/fields request.body)
      get (\ key=str (http_foot/field key fields))
    ?> (./some width) (explorer_dev/render_number (get "width")) (./reply (http_driver/response 400 "Invalid width"))
    ?> (./some scale) (explorer_dev/render_number (get "textScale")) (./reply (http_driver/response 400 "Invalid text scale"))
    ? (!(goo_fp/lte width (goo_fp/integer 100000)) || (goo_fp/lte scale (goo_fp/integer 0)) || !(goo_fp/lte scale (goo_fp/integer 10)))
      | ./reply (http_driver/response 400 "Invalid render bounds")
    ? !((eq (get "direction") "ltr") || (eq (get "direction") "rtl"))
      | ./reply (http_driver/response 400 "Invalid direction")
    = context (goo_bridge/render_context width scale (eq (get "direction") "rtl") .false)
    ? (goo_inspection/prepare context (fields.keep((\ [key value] !(eq key "wire")))))
     > (./err message) (./reply (http_driver/response 400 message))
     > (./ok value)
      ? (eq (get "wire") "protobuf-v2") (./bat 200 (goo_wire/encode value) "application/x-protobuf")
      | ./bytes 200 (http_foot/bar (str/to_atom (show value))) "application/json; charset=utf-8"
  + render_number
    \ text=str
    ^ maybe[goo/scalar]
    ?> (jres/ok value rest) (parse text) .none
    | goo_number/nonnegative value
  + render
    \ request=http_foot/request
    ^ http_foot/action
    ? !(eq request.method "POST") (./reply (http_driver/response 405 "POST required"))
    = fields (http_foot/fields request.body)
      get (\ key=str (http_foot/field key fields))
      direction (get "direction")
      indices ((get "node").split_byte(46))
    ?> (./some width) (explorer_dev/render_number (get "width")) (./reply (http_driver/response 400 "Invalid width"))
    ?> (./some scale) (explorer_dev/render_number (get "textScale")) (./reply (http_driver/response 400 "Invalid text scale"))
    ? (!(goo_fp/lte width (goo_fp/integer 100000)) || (goo_fp/lte scale (goo_fp/integer 0)) || !(goo_fp/lte scale (goo_fp/integer 10)))
      | ./reply (http_driver/response 400 "Invalid render bounds")
    ? !((eq direction "ltr") || (eq direction "rtl") || (eq direction "LTR") || (eq direction "RTL"))
      | ./reply (http_driver/response 400 "Invalid direction")
    ? (and (gt (get "node").len 0) !(indices.all((\ index (maybe/is_some (nat/parse index))))))
      | ./reply (http_driver/response 400 "Invalid node route")
    ? (and (gt (get "layouts").len 0) !(eq (get "layouts") "pane-v1"))
      | ./reply (http_driver/response 400 "Invalid layout policy")
    ? !((eq (get "pipeline") "") || (eq (get "pipeline") "1"))
      | ./reply (http_driver/response 400 "Invalid pipeline capture version")
    = context (goo_bridge/render_context width scale ((eq direction "rtl") || (eq direction "RTL")) (eq (get "pipeline") "1"))
      node=maybe[row[nat]] (? (get "node").len (./some (indices.map((\ index (nat/parse index).fall(0))))) .none)
      render (? (eq (get "layouts") "pane-v1") goo_browser/pane_layout_response goo_browser/render_response)
    ? (eq (get "wire") "protobuf-v2")
      ? context.pipeline (./reply (http_driver/response 415 "Compiler captures require their JSON contract"))
      | ./snapshot_bat
        \ state=namespace
        | goo_wire_browser/result (eq (get "layouts") "pane-v1") context
          (browser_routes/target (get "target")) (browser_routes/target (get "view"))
          (browser_routes/target (get "slot")) (browser_routes/target (get "role"))
          (browser_routes/target (get "workspace")) node state
    | ./snapshot (render context
        (browser_routes/target (get "target")) (browser_routes/target (get "view"))
        (browser_routes/target (get "slot")) (browser_routes/target (get "role"))
        (browser_routes/target (get "workspace")) node)
  + plan
    \ files=row[[str nat]] request=http_foot/request now=nat
    ^ http_foot/action
    = parts (http_foot/split 63 request.target)
      url parts.at(0)
      operation url.slice(11 url.len)
    ? (equal url "/grove/dev")
      ? !(equal request.method "GET") (./reply (http_driver/response 405 "GET required"))
      = bytes (files.fold(0 (\ out [name bytes] (? (equal name "goo-dev.html") bytes out))))
      | ./bytes 200 bytes "text/html; charset=utf-8"
    = reading (equal operation "status")
    ? !(equal request.method (? reading "GET" "POST"))
      | ./reply (http_driver/response 405 "Incorrect method")
    ? !(reading || (equal operation "rescan") || (equal operation "replace") || (equal operation "install") || (equal operation "delete"))
      | ./reply (http_driver/response 404 "Unknown development operation")
    = fields (http_foot/fields (? reading (? (eq parts.len 2) parts.at(1) "") request.body))
      get (\ key=str (http_foot/field key fields))
      parse (\ key=str (nat/parse (? (eq (get key).len 0) "0" (get key))))
    ?> (./some version) (parse "version") (./reply (http_driver/response 400 "Invalid version"))
    ?> (./some scan) (parse "scan") (./reply (http_driver/response 400 "Invalid scan"))
    = expected=maybe[nat] (nat/parse (get "expected"))
    ? (and (gt (get "expected").len 0) (maybe/is_none expected))
      | ./reply (http_driver/response 400 "Invalid instance version")
    | ./develop (grove_dev/request operation
        (browser_routes/target (get "source")) (browser_routes/target (get "root"))
        version expected (browser_routes/target (get "selected")) scan)
