- goo_values
- system_vocabulary
- web
- goo_bridge
- goo_panes
- goo_reflection
- goo_documentation
- overlay_cache

+ goo_browser
  + url
    \ path=path
    ^ nat
    | str/to_atom (str/join "" ["/views" (path_show path)])
  + matches
    \ card=myth published=goo/published
    ^ bool
    | maybe/is_none (fit_check card.put(system_vocabulary/lash published.contract))
  + catalog
    \ tree=axal[myth]
    ^ list[goo/published]
    | tree.tap.stream.bind
    \ [path card]
    ^ list[goo/published]
    ?> (./some held) card.get(system_vocabulary/grove/view) .nil
    ?> view=goo/published held .nil
    | list/one view
  + catalog_value
    : views=list[goo/published]
      by_slot=mop[path list[nat] lt_pith]
      unconditional=list[nat] types=goo_reflection/registry
  + index
    ' Any matching card must satisfy every need group. Index the smallest
    ' group and retain full fit_check semantics on the resulting candidates.
    \ views=list[goo/published]
    ^ goo_browser/catalog_value
    % rest=list[goo/published] views i=nat 0 slots=mop[path list[nat] lt_pith] (mop/empty) always=list[nat] .nil
    ? rest.is_nil (goo_browser/catalog_value views slots always (mop/empty))
    = groups rest.head.contract.need
    ? (eq groups.len 0) (_ rest.tail i.inc slots always.cons(i))
    = anchor (groups.fold(groups.at(0) (\ best group (? (lt group.len best.len) group best))))
      slots
        | anchor.fold slots
        \ out slot
        | out.put slot (out.gut(slot .nil).cons(i))
    | _ rest.tail i.inc slots always
  + candidates
    \ card=myth catalog=goo_browser/catalog_value
    ^ list[goo/published]
    = add
        \ found=mop[nat bool lt] ranks=list[nat]
        | ranks.fold found (\ out rank out.put(rank .true))
      initial (add (mop/empty) catalog.unconditional)
      ' matches installs this slot before fit_check, even if the card lacks it.
      keys (card.put(system_vocabulary/lash (pails/n 0))).tap
      found
        | keys.fold initial
        \ found entry
        | add found (catalog.by_slot.gut(entry.key .nil))
    ' Numeric ranks preserve catalog order and deduplicate OR-group hits.
    % ranks=list[nat] found.tap.stream.map((\ entry entry.key)) views=list[goo/published] catalog.views offset=nat 0
    ^ list[goo/published]
    ? ranks.is_nil .nil
    = rank ranks.head
      remaining views.drop((sub rank offset))
    | (_ ranks.tail remaining.tail rank.inc).cons(remaining.head)
  + matching
    \ card=myth catalog=goo_browser/catalog_value
    ^ list[goo/published]
    | (goo_browser/candidates card catalog).keep (\ published (and !(published.view.is_pane) (goo_browser/matches card published)))
  + matching_panes
    \ card=myth catalog=goo_browser/catalog_value
    ^ list[goo/published]
    | (goo_browser/candidates card catalog).keep (\ published (and published.view.is_pane (and published.view.ports.is_nil (goo_browser/matches card published))))
  + catalog_slot
    ^ path
    system_vocabulary/goo/catalog
  + catalog_overlay
    \ tree=axal[myth]
    ^ myth
    | myth/sing goo_browser/catalog_slot (goo_browser/index (goo_browser/catalog tree)).set_types((goo_reflection/types tree))
  + cached_index
    \ tree=axal[myth]
    ^ goo_browser/catalog_value
    = empty (goo_browser/index .nil)
    ?> (./some record) tree.fil empty
    = projected (overlay_cache/value record)
    ?> (./some record) projected.fil empty
    ?> (./some held) record.get(goo_browser/catalog_slot) empty
    ?> catalog=goo_browser/catalog_value held empty
    catalog
  + cached_catalog
    \ tree=axal[myth]
    ^ list[goo/published]
    | (goo_browser/cached_index tree).views
  + hosted_receiver
    ' An installed host reads and validates a stored workspace context.
    : declaration=path receiver={\ path namespace}either[str myth]
  + hosted_path
    \ self=iota declaration=path
    ^ path
    = prefix=path [self 'weft 'goo_workspace_receivers]
    | prefix.weld(declaration)
  + render_card
    \ target=path workspace=path state=namespace
    ^ either[str myth]
    ? (eq workspace.len 0)
      ?> (./some card) (goo_runtime/record .y target state) (./err "Object is unavailable.")
      | ./ok card
    ?> (./some record) (goo_runtime/record .x (goo_browser/hosted_path state.self workspace) state)
      | ./err "Workspace is not installed."
    ?> (./some held) record.get(system_vocabulary/content) (./err "Workspace receiver is unavailable.")
    ?> host=goo_browser/hosted_receiver held (./err "Workspace receiver is invalid.")
    ? !(equal host.declaration workspace) (./err "Workspace declaration does not match its receiver.")
    = receiver host.receiver
    | receiver target state
  + host_descriptor
    ' Capabilities originate with the installed endpoint, never request fields.
    \ workspace=path state=namespace
    ^ json
    ? (eq workspace.len 0) jnull
    ?> (./some record) (goo_runtime/record .x (goo_browser/hosted_path state.self workspace) state) jnull
    ?> (./some held) record.get(system_vocabulary/content) jnull
    ?> host=goo_browser/hosted_receiver held jnull
    ? !(equal host.declaration workspace) jnull
    ?> (./some held) record.get(['sys 'goo 'host]) jnull
    ?> held=pails/t held jnull
    ?> (jres/ok descriptor rest) (parse held.t) jnull
    ? !(eq (grove_dev/text (grove_dev/field "declaration" descriptor)) (path_show workspace)) jnull
    descriptor
  + render_fields
    \ context=goo_bridge/render_context target=path published=goo/published card=myth route=maybe[row[nat]]
    ^ either[str row[jkv]]
    = published (goo_bridge/receiver target published)
    < view (goo_runtime/matching_view published card)
    ? route
     > (./some route)
      < bound (goo_runtime/bind_sources published card view.children)
      ?> (./some found) (goo_runtime/locate bound route (goo_runtime/scope .none .none .nil .none .none))
        | ./err "Native node is unavailable."
      = [node scope] found
      ? (goo_panes/contains node) (./err "Requested node is a host container, not a native surface.")
      < fields (goo_bridge/prepared_fields context published card view.set_children((list/one node))
          (goo_panes/controls published card node route))
      | ./ok fields.snoc((jkv "kind" (json/str "native"))).snoc((jkv "node" (json/str (str/join "." route.map(nat/show)))))
    ? (published.view.is_pane || view.children.any(goo_panes/contains))
      < description (goo_panes/description_with context published card view)
      = html (str/from_atom (weft/render (weft/el "div" [(weft/cls "goo-session")]
          [(weft/el "div" [(weft/att "data-goo-body" "")]
            (goo_panes/markup (grove_dev/items description) [] (\ node [])))])))
      | ./ok [(jkv "kind" (json/str "pane")) (jkv "profile" (goo_profile/metadata unit/unit))
          (jkv "context" (goo_bridge/context_json context)) (jkv "display" jnull)
          (jkv "html" (json/str html)) (jkv "controls" (json/arr [])) (jkv "description" description)]
    < fields (goo_bridge/prepared_fields context published card view
        (goo_bridge/controls published card view.children [] 1))
    | ./ok fields.snoc((jkv "kind" (json/str "view")))
  + render_identity
    \ published=goo/published
    ^ row[jkv]
    [(jkv "view" (json/str (path_show published.view.name)))
     (jkv "slot" (json/str (path_show published.view.slot)))
     (jkv "role" (json/str (path_show published.view.role)))
     (jkv "origin" (json/obj [(jkv "line" (json/num .false published.view.span.line))
       (jkv "column" (json/num .false published.view.span.column))]))]
  + domain_controls
    \ value=json
    ^ bool
    ? value
     > (json/arr values) (values.any(goo_browser/domain_controls))
     > (json/obj fields)
      = controls=bool
          ?> (json/arr controls) (grove_dev/field "controls" value) .false
          | controls.any (\ control (equal (grove_dev/field "invoke" control) (json/boo .true)))
      | (controls || (goo_browser/domain_controls (grove_dev/field "children" value)) || (goo_browser/domain_controls (grove_dev/field "description" value)) || (goo_browser/domain_controls (grove_dev/field "contents" value)) || (goo_browser/domain_controls (grove_dev/field "content" value)))
    .false
  + synthetic_fields
    \ context=goo_bridge/render_context target=path card=myth state=namespace
    ^ either[str row[jkv]]
    = types (goo_reflection/types (sovereign_care .z [state.self 'gov] state))
      titles (goo_reflection/slot_titles card state)
    < compiled (goo_reflection/compile_with_titles context target types card titles)
    = prepared compiled.prepared
    ?> (./some display) (goo_prepared/encode prepared) (./err "Synthetic display failed validation.")
    = fields=row[jkv]
        [(jkv "view" (json/str (path_show goo_reflection/slot)))
         (jkv "slot" (json/str (path_show goo_reflection/slot))) (jkv "role" (json/str ""))
         (jkv "kind" (json/str "view")) (jkv "profile" (goo_profile/metadata unit/unit))
         (jkv "context" (goo_bridge/context_json context)) (jkv "display" display)
         (jkv "html" (json/str (goo_html/fragment prepared))) (jkv "controls" (json/arr []))]
      fields fields.weld((goo_bridge/pipeline_fields context compiled display (goo_html/fragment prepared) []))
    ? !(state.permitted(target)) (./ok fields)
    < html (goo_values/html context target card types titles)
    = edited
        | fields.map
          \ field
          ? (eq field.k "html") (jkv "html" (json/str html))
          ? (eq field.k "display") (jkv "display" jnull)
          field
    | ./ok edited.snoc((jkv "readOnlyDisplay" display))
  + panes_slot
    ^ path
    ['sys 'slot 'panes]
  + face
    \ target=path state=namespace
    ^ either[str path]
    < card (goo_browser/render_card target [] state)
    ?> (./some face) card.path_at(system_vocabulary/face) (./err "This record has no pane path in /sys/face.")
    ?> (./some declaration) (goo_runtime/record .z face state) (./err "The /sys/face pane is unavailable.")
    < published (goo_runtime/published declaration)
    ? !(published.view.is_pane) (./err "/sys/face must name a Goo pane declaration.")
    ? !(published.view.ports.is_nil) (./err "The /sys/face pane requires external selection ports.")
    ? !(goo_browser/matches card published) (./err "This record does not satisfy its /sys/face pane's role.")
    | ./ok face
  + panes_fields
    \ context=goo_bridge/render_context target=path state=namespace
    ^ either[str row[jkv]]
    < face (goo_browser/face target state)
    = url (str/cat_all ["/goo-face?path=" (value_read/percent (path_show target))])
      frame (weft/el "iframe" [(weft/att "src" (str/to_atom url)) (weft/att "title" "Goo pane")
          (weft/att "data-goo-presentation-frame" (str/to_atom (str/cat_all [(path_show target) ":" (path_show face)])))
          (weft/cls "goo-views-frame")] [])
    | ./ok [(jkv "view" (json/str (path_show goo_browser/panes_slot))) (jkv "slot" (json/str (path_show goo_browser/panes_slot)))
        (jkv "role" (json/str "")) (jkv "kind" (json/str "view"))
        (jkv "profile" (goo_profile/metadata unit/unit)) (jkv "context" (goo_bridge/context_json context))
        (jkv "display" jnull) (jkv "html" (json/str (str/from_atom (weft/render frame)))) (jkv "controls" (json/arr []))]
  + face_slot
    ^ path
    ['sys 'slot 'face]
  + face_page
    \ target=path
    ^ nat
    | weft/page_with_assets "Goo pane" goo_browser/presentation_assets
        [(weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))
          (weft/att "data-face" "")] [])]
  + views_slot
    ^ path
    ['sys 'slot 'views]
  + views_fields
    \ context=goo_bridge/render_context target=path
    ^ row[jkv]
    = url (str/cat_all ["/goo-views?path=" (value_read/percent (path_show target))])
      frame (weft/el "iframe" [(weft/att "src" (str/to_atom url)) (weft/att "title" "Goo views")
          (weft/att "data-goo-presentation-frame" (str/to_atom (path_show target)))
          (weft/cls "goo-views-frame")] [])
    [(jkv "view" (json/str (path_show goo_browser/views_slot))) (jkv "slot" (json/str (path_show goo_browser/views_slot)))
     (jkv "role" (json/str "")) (jkv "kind" (json/str "view"))
     (jkv "profile" (goo_profile/metadata unit/unit)) (jkv "context" (goo_bridge/context_json context))
     (jkv "display" jnull) (jkv "html" (json/str (str/from_atom (weft/render frame)))) (jkv "controls" (json/arr []))]
  + views_page
    \ target=path
    ^ nat
    | weft/page_with_assets "Goo views" goo_browser/presentation_assets
        [(weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))
          (weft/att "data-views-only" "")] [])]
  + recipe_base
    \ base=row[jkv] snapshot=json view=path state=namespace
    ^ row[jkv]
    ?> (json/obj fields) snapshot base
    = fields (fields.map((\ entry (? (eq entry.k "recipePublication") (jkv "recipePublication" (json/str (nat/show (state.case(.x view)).fall(0)))) entry))))
    | base.map((\ entry (? (eq entry.k "snapshot") (jkv "snapshot" (json/obj fields)) entry)))
  + render_result
    \ context=goo_bridge/render_context target=path view=path slot=path role=path workspace=path route=maybe[row[nat]] state=namespace
    ^ either[str json]
    < card (goo_browser/render_card target workspace state)
    ? (and (gt workspace.len 0) !(equal view workspace)) (./err "Workspace render requires its installed declaration.")
    = builtin ((goo_documentation/handles slot) || (equal slot goo_reflection/slot) || (equal slot goo_browser/views_slot) || (equal slot goo_browser/panes_slot) || (equal slot goo_browser/face_slot))
      view (? (and (eq view.len 0) builtin) slot view)
      query (goo_runtime/request "status" target target view [] 0 0 0 [] 0)
      snapshot (goo_runtime/status_value query state)
      base=row[jkv]
        [(jkv "version" (json/num .false 1)) (jkv "ok" (json/boo .true)) (jkv "snapshot" snapshot) (jkv "host" (goo_browser/host_descriptor workspace state))]
    ? (equal view goo_browser/face_slot)
      < face (goo_browser/face target state)
      | goo_browser/render_result context target face [] [] [] route state
    ? (equal view goo_browser/panes_slot)
      ? (maybe/is_some route) (./err "Panes has no native control route.")
      < fields (goo_browser/panes_fields context target state)
      | ./ok (json/obj base.weld(fields))
    ? (equal view goo_browser/views_slot)
      ? (maybe/is_some route) (./err "Views has no native control route.")
      | ./ok (json/obj base.weld((goo_browser/views_fields context target)))
    = documentation_slot (? (goo_documentation/handles view) view slot)
    ? (and (goo_documentation/handles documentation_slot) ((eq view.len 0) || (goo_documentation/handles view)))
      ? (maybe/is_some route) (./err "Documentation has no native control route.")
      = card (? (equal documentation_slot goo_documentation/slot) (goo_documentation/enrich target card state) card)
      | ./ok (json/obj base.weld((goo_documentation/fields context target documentation_slot card)))
    ? ((equal view goo_reflection/slot) || (and (eq view.len 0) (equal slot goo_reflection/slot)))
      ? (maybe/is_some route) (./err "Synthetic inspection has no native control route.")
      < fields (goo_browser/synthetic_fields context target card state)
      | ./ok (json/obj base.weld(fields))
    ? (gt view.len 0)
      ?> (./some record) (goo_runtime/record .x view state) (./err "View no longer exists.")
      < published (goo_runtime/published record)
      < fields (goo_browser/render_fields context target published card route)
      ? (and (gt workspace.len 0) (goo_browser/domain_controls (json/obj fields)))
        | ./err "Workspace domain actions require a member or follower presentation."
      | ./ok (json/obj base.weld((goo_browser/render_identity published)).weld(fields))
    ? (maybe/is_some route) (./err "Native node render requires an explicit view.")
    = catalog (goo_browser/catalog (sovereign_care .z [state.self 'gov] state))
      matches (catalog.keep((\ published (and published.view.ports.is_nil (goo_browser/matches card published)))))
      matches (? (gt slot.len 0) (matches.keep((\ published (equal published.view.slot slot)))) matches)
      matches (? (gt role.len 0) (matches.keep((\ published (equal published.view.role role)))) matches)
    ? ((gt slot.len 0) || (gt role.len 0))
      = matches (matches.keep((\ published !(published.view.is_pane))))
      ? !(eq matches.len 1) (./err "View selection is unavailable or ambiguous.")
      = published matches.head
        base (goo_browser/recipe_base base snapshot published.view.name state)
      < fields (goo_browser/render_fields context target published card .none)
      | ./ok (json/obj base.weld((goo_browser/render_identity published)).weld(fields))
    = entries
        | matches.map
        \ published=goo/published
        ^ json
        = identity (goo_browser/render_identity published)
        ? (goo_browser/render_fields context target published card .none)
         > (./ok fields) (json/obj identity.weld(fields))
         > (./err message) (json/obj identity.snoc((jkv "kind" (json/str (? published.view.is_pane "pane" "view")))).snoc((jkv "error" (json/str message))))
    = synthetic=json
        ? (goo_browser/synthetic_fields context target card state)
         > (./ok fields) (json/obj fields)
         > (./err message) (json/obj [(jkv "view" (json/str (path_show goo_reflection/slot)))
             (jkv "slot" (json/str (path_show goo_reflection/slot))) (jkv "role" (json/str ""))
             (jkv "kind" (json/str "view")) (jkv "error" (json/str message))])
    | ./ok (json/obj base.weld([(jkv "profile" (goo_profile/metadata unit/unit))
        (jkv "context" (goo_bridge/context_json context)) (jkv "views" (json/arr entries.row.snoc(synthetic)))]))
  + render_response
    ' Executed by the namespace supervisor: publication, bindings, prepared
    ' output and action-version snapshot all refer to this immutable state.
    \ context=goo_bridge/render_context target=path view=path slot=path role=path workspace=path route=maybe[row[nat]] state=namespace
    ^ [nat str]
    ? (goo_browser/render_result context target view slot role workspace route state)
     > (./ok value) [200 (show value)]
     > (./err message) [409 (show (json/obj [(jkv "version" (json/num .false 1))
         (jkv "ok" (json/boo .false)) (jkv "error" (json/str message))]))]
  + pane_layouts
    ' Each variant uses the ordinary renderer against ONE immutable namespace.
    ' These are pane allocations, not viewport/device breakpoints. A narrower
    ' than sm allocation gets a bounded sm variant instead of scaling the HTML.
    \ context=goo_bridge/render_context target=path view=path slot=path role=path workspace=path route=maybe[row[nat]] state=namespace
    ^ either[str json]
    = sizes=row[[str nat]] [["sm" 240] ["md" 480] ["lg" 720]]
      variants=either[str row[json]]
        % rest=row[[str nat]] sizes out=row[json] [] resolved=path view
        ^ either[str row[json]]
        ? (eq rest.len 0) (./ok out)
        = [name pixels] rest.at(0)
          width (goo_fp/integer pixels)
          width (? (and (eq name "sm") (goo_fp/lte context.width width)) context.width width)
        < result (goo_browser/render_result context.set_width(width) target resolved slot role workspace route state)
        ' Slot/role selection is independent of allocation. Reuse its admitted
        ' declaration within this snapshot instead of scanning the catalog for
        ' each size of every child row. Each layout still uses the real backend.
        = resolved ((path_parse (grove_dev/text (grove_dev/field "view" result))).fall(resolved))
        | _ rest.drop(1) out.snoc((json/obj [(jkv "size" (json/str name)) (jkv "render" result)])) resolved
    < variants variants
    | ./ok (json/obj [(jkv "version" (json/num .false 1)) (jkv "ok" (json/boo .true))
        (jkv "layoutPolicy" (json/str "pane-v1")) (jkv "context" (goo_bridge/context_json context))
        (jkv "layouts" (json/arr variants))])
  + pane_layout_response
    \ context=goo_bridge/render_context target=path view=path slot=path role=path workspace=path route=maybe[row[nat]] state=namespace
    ^ [nat str]
    ? (goo_browser/pane_layouts context target view slot role workspace route state)
     > (./ok value) [200 (show value)]
     > (./err message) [409 (show (json/obj [(jkv "version" (json/num .false 1))
         (jkv "ok" (json/boo .false)) (jkv "error" (json/str message))]))]
  + tree_layouts
    ' Child identities and their ordinary Goo views are prepared in one snapshot.
    ' Reuse one catalog for the page; never ask the browser to resolve content.
    \ context=goo_bridge/render_context query=goo_runtime/request slots=row[path] state=namespace
    ^ either[str json]
    < page (goo_runtime/tree_page_value query state)
    ?> (json/obj fields) page (./err "Invalid tree page.")
    = catalog (goo_browser/index (goo_browser/catalog (sovereign_care .z [state.self 'gov] state)))
      members (grove_dev/items (grove_dev/field "members" page))
      prepared=either[str row[json]]
        % members=row[json] members out=row[json] []
        ^ either[str row[json]]
        ? (eq members.len 0) (./ok out)
        = member members.at(0)
        ? !(eq (grove_dev/text (grove_dev/field "status" member)) "available") (_ members.drop(1) out)
        ?> (./some subject) (path_parse (grove_dev/text (grove_dev/field "subject" member))) (./err "Invalid tree subject.")
        < card (goo_browser/render_card subject [] state)
        = views (goo_browser/matching card catalog)
          presentations=either[str row[json]]
            % slots=row[path] slots entries=row[json] []
            ^ either[str row[json]]
            ? (eq slots.len 0) (./ok entries)
            = slot slots.at(0)
              matches (views.keep((\ published (and published.view.ports.is_nil (equal published.view.slot slot)))))
            = builtin ((equal slot goo_reflection/slot) || (goo_documentation/handles slot))
            ? (and !builtin !(eq matches.len 1)) (./err "Child view selection is unavailable or ambiguous.")
            = view (? builtin slot matches.head.view.name)
            < bundle (goo_browser/pane_layouts context subject view slot [] [] .none state)
            | _ slots.drop(1) entries.snoc((json/obj [(jkv "key" (grove_dev/field "key" member))
                (jkv "slot" (json/str (path_show slot))) (jkv "bundle" bundle)]))
        < presentations presentations
        | _ members.drop(1) out.weld(presentations)
    < prepared prepared
    | ./ok (json/obj fields.snoc((jkv "presentations" (json/arr prepared))))
  + tree_layout_response
    \ context=goo_bridge/render_context query=goo_runtime/request slots=row[path] state=namespace
    ^ [nat str]
    ? (goo_browser/tree_layouts context query slots state)
     > (./ok value) [200 (show value)]
     > (./err message) [409 message]
  + preview_at
    \ target=path card=myth published=goo/published
    ^ weft/node
    | goo_browser/preview card (goo_bridge/receiver target published)
  + preview
    \ card=myth published=goo/published
    ^ weft/node
    = content=row[weft/node]
        ? published.result
         > (./ok view)
          ? (published.view.is_pane || view.children.any(goo_panes/contains))
            ? (goo_panes/description published card view)
             > (./ok description)
              [(weft/el "div" [(weft/cls "goo-session")
                (weft/att "data-description" (str/to_atom description))]
                [(weft/el "div" [(weft/att "data-goo-body" "")]
                  (goo_panes/server_body description (\ node [])))])]
             > (./err message) [(weft/leaf "p" [(weft/cls "error")] (str/to_atom message))]
          ? (goo_bridge/render published card view)
           > (./ok html)
            [(weft/el "fieldset" [(weft/cls "goo-preview") (weft/att "disabled" "disabled")
              (weft/att "aria-label" "Goo view")
              (weft/att "data-controls" (str/to_atom (show (json/arr
                (goo_bridge/controls published card view.children [] 1)))))]
              [(weft/raw (str/to_atom html))])]
           > (./err message)
            [(weft/leaf "p" [(weft/cls "error")] (str/to_atom message))]
         > (./err error)
          = message=str
              ? error
               > (grove/error/syntax span message) message
               > (grove/error/parser cause) "Unable to compile view."
          [(weft/leaf "p" [(weft/cls "error")] (str/to_atom message))]
      heading
        [(weft/leaf "h2" [] (str/to_atom (path_show published.view.name)))
         (weft/leaf "p" [(weft/cls "meta")] (str/to_atom (str/cat_all [(? published.view.is_pane "Pane · " "View · ") (path_show published.view.slot)])))]
    | weft/el "section" [(weft/cls "preview")
        (weft/att "data-declaration-kind" (? published.view.is_pane "pane" "view"))
        (weft/att "data-view" (str/to_atom (path_show published.view.name)))
        (weft/att "data-slot" (str/to_atom (path_show published.view.slot)))
        (weft/att "data-role" (str/to_atom (path_show published.view.role)))] heading.weld(content)
  + synthetic
    \ target=path card=myth types=goo_reflection/registry
    ^ weft/node
    = body=weft/node
        ? (goo_reflection/render target types card)
         > (./ok html)
          | weft/el "div" [(weft/cls "goo-synthetic")] [(weft/raw (str/to_atom html))]
         > (./err message)
          | weft/leaf "p" [(weft/cls "error")] (str/to_atom message)
    | weft/el "section" [(weft/cls "preview")
        (weft/att "data-slot" "/sys/slot/synthetic")
        (weft/att "data-view" "/sys/slot/synthetic")]
        [(weft/leaf "h2" [] "Synthetic view")
         (weft/leaf "p" [(weft/cls "meta")] "/sys/slot/synthetic · read-only") body]
  + link
    \ path=path label=nat
    ^ weft/node
    | weft/leaf "a" [(weft/href (goo_browser/url path))] label
  + css
    ^ nat
    "*{box-sizing:border-box}body{margin:0;font:15px system-ui,sans-serif;color:#252525;background:#fafafa}aside{position:fixed;inset:0 auto 0 0;width:280px;padding:24px 18px;background:#f0f0ed;border-right:1px solid #ddd;overflow:auto}main{margin-left:280px;padding:32px;max-width:1100px}h1{font-size:22px;margin:0 0 10px;overflow-wrap:anywhere}h2{font:14px ui-monospace,monospace;overflow-wrap:anywhere}a{color:#245a63}aside a{display:block;padding:8px;border-radius:4px;overflow-wrap:anywhere}aside a:hover{background:#e2e5e2}.meta,.empty{color:#777;font-size:13px;overflow-wrap:anywhere}.preview{background:white;border:1px solid #ddd;border-radius:6px;padding:20px;margin:20px 0}.preview h2{margin:0}.preview .meta{margin:6px 0 22px}.goo-preview{border:0;padding:0;margin:0;min-width:0;overflow:auto}.goo-preview:disabled{opacity:1}.error{color:#963e30;background:#fff4ef;padding:12px;line-height:1.5}@media(max-width:650px){aside{position:static;width:auto;max-height:35vh;border-bottom:1px solid #ddd}main{margin:0;padding:20px}}"
  + page
    \ target=path selected=axal[myth] catalog=axal[myth]
    ^ nat
    = links
        | selected.kid_tap.map
          \ [key child]
          = path target.snoc(key)
          | goo_browser/link path (show/path [key])
      navigation
        [(weft/leaf "h2" [] "Namespace")
         (goo_browser/link [] "All roots")
         (goo_browser/link target.take(target.len.dec) "↑ Parent")
         (weft/leaf "p" [(weft/cls "meta")] (show/path target))]
      content=row[weft/node]
        ?> (./some card) selected.fil
          [(weft/leaf "p" [(weft/cls "empty")] "Choose an object from the sidebar.")]
        = index (goo_browser/cached_index catalog)
          views (goo_browser/matching card index)
          panes (goo_browser/matching_panes card index)
        | (views.weld(panes).map((goo_browser/preview_at target card))).snoc(
            (goo_browser/synthetic target card index.types)).row
      header
        [(weft/leaf "a" [(weft/href (str/to_atom (str/cat_all ["/grove/dev?selected=" (path_show target)]))) (weft/att "target" "_top")] "Develop this Grove")
         (weft/leaf "h1" [] (show/path target))
         (weft/leaf "p" [(weft/cls "meta")] "Matching views and synthetic inspection · changes apply to this object")]
    | weft/page_with_assets "Namespace views"
      [(weft/el "script" [(weft/att "src" "/static/goo-session.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-topoi-components.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-topoi.js") (weft/att "defer" "defer")] [])
       (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-topoi-components.css")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-patch-components.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-patch.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-panes.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-inspection.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-rich-input.js") (weft/att "defer" "defer")] [])
       (weft/el "script" [(weft/att "src" "/static/goo-actions.js") (weft/att "defer" "defer")] [])
       (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-profile.css")] [])
       (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-run-fonts.css")] [])
       (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href "/static/goo-panes.css")] [])
       (weft/el "style" [] [(weft/raw goo_browser/css)])]
      [(weft/el "aside" [] navigation.weld(links))
       (weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))] header.weld(content))]
  + surface_assets
    ' Ordinary Goo surfaces have no Explorer shell or application stylesheet.
    ^ row[weft/node]
    = scripts=row[str] ["goo-rich-input" "goo-actions"]
      styles=row[str] ["goo-run-fonts" "goo-profile"]
      assets (scripts.map((\ name (weft/el "script" [(weft/att "src" (str/to_atom (str/cat_all ["/static/" name ".js"]))) (weft/att "defer" "defer")] []))))
    | assets.weld((styles.map((\ name (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href (str/to_atom (str/cat_all ["/static/" name ".css"])))] [])))))
  + presentation_assets
    ^ row[weft/node]
    = scripts=row[str] ["goo-session" "goo-topoi-components" "goo-topoi" "goo-patch-components" "goo-patch" "goo-panes" "goo-inspection" "goo-rich-input" "goo-actions"]
      assets (scripts.map((\ name (weft/el "script" [(weft/att "src" (str/to_atom (str/cat_all ["/static/" name ".js"]))) (weft/att "defer" "defer")] []))))
      styles=row[str] ["/static/goo-run-fonts.css" "/static/goo-profile.css" "/static/goo-panes.css" "/static/goo-topoi-components.css"]
    | assets.weld((styles.map((\ url (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href (str/to_atom url))] [])))))
  + presentation_page
    \ target=path slot=path selected=axal[myth] catalog=axal[myth]
    ^ nat
    = card selected.fil.fall(myth/new) index (goo_browser/cached_index catalog)
      matches ((goo_browser/matching card index).weld((goo_browser/matching_panes card index))).keep((\ item (equal item.view.slot slot)))
      content=row[weft/node]
        ? !(eq matches.len 1) [(weft/leaf "p" [(weft/att "role" "status")] "No unique matching presentation for this subject and slot. Open the subject to choose a different slot.")]
        | [(weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))
            (weft/att "data-view" (str/to_atom (path_show matches.head.view.name)))]
            [(goo_browser/preview_at target card matches.head)])]
      css=nat "*{box-sizing:border-box}body{margin:0;background:#fff;color:#292a25;font:13px system-ui}main{padding:8px;min-width:0}.preview{margin:0;border:0;padding:0}.preview>h2,.preview>.meta{display:none}.goo-preview{border:0;padding:0;margin:0;min-width:0}button,a{font:inherit}body>a{display:block;padding:8px;color:#596348;font-size:11px}main>p:empty{display:none}main>button{font-size:10px;margin:0 0 8px}"
    | weft/page_with_assets "Goo presentation"
        (goo_browser/presentation_assets).snoc((weft/el "style" [] [(weft/raw css)]))
        content.snoc((weft/leaf "a" [(weft/href (goo_browser/url target)) (weft/att "target" "_blank") (weft/att "rel" "noopener")] "Open subject ↗"))
  + talk
    \ =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ? !(out.has(['goo_browser])) (explorer/route_talk bowl cur add)
    = target (out.path_at(['vpath])).fall([])
      selected bowl.crew.gut(['view] (axal/new[myth] .none))
      catalog bowl.crew.gut(['catalog] (axal/new[myth] .none))
      done
        . out
          put(['res_status] (pd 200))
          put(['res_body] (pd (? (out.has(['goo_presentation])) (goo_browser/presentation_page target (out.path_at(['presentation_slot])).fall([]) selected catalog) (goo_browser/page target selected catalog))))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
