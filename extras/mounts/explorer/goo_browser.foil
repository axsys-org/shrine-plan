- web
- grove_view_publication

+ goo_browser
  + url
    \ path=path
    ^ nat
    | str/to_atom (str/join "" ["/views" (path_show path)])
  + value
    \ published=goo/published card=myth expression=rex
    ^ maybe[pail]
    ? expression
     > (./leaf span shape text)
      ? (equal expression.leaf_kind (maybe/some[str] "cord"))
        | ./some (pails/t text)
      ? (equal expression.leaf_kind (maybe/some[str] "quip"))
        < path (path_parse text.slice(1 (dec text.len)))
        | ./some (pails/p path)
      .none
     > (./nest span color rune kids)
      ? !(and (eq rune ".") (eq kids.len 2)) .none
      ? !(equal kids.at(0).leaf_kind (maybe/some[str] "word")) .none
      ?> (./leaf at shape binding) kids.at(0) .none
      ? !(eq binding published.view.binding) .none
      ?> (./leaf at shape name) kids.at(1) .none
      = fields (published.fields.keep((\ field (eq field.name name))))
      ? !(eq fields.len 1) .none
      | card.get fields.at(0).slot
    .none
  + text
    \ value=pail
    ^ nat
    ? value
     > value=pails/t (str/to_atom value.t)
     > value=pails/n (str/to_atom (nat/show value.n))
     > value=pails/p (str/to_atom (path_show value.p))
    "Unsupported value"
  + nodes
    \ published=goo/published card=myth nodes=row[goo/node]
    ^ row[weft/node]
    | nodes.bind (goo_browser/node published card)
  + node
    \ published=goo/published card=myth node=goo/node
    ^ row[weft/node]
    = kind node.constructor
      children (goo_browser/nodes published card node.children)
    ? ((eq kind "group") || (eq kind "present"))
      [(weft/el "div" [(weft/cls "goo-group")] children)]
    ? (eq kind "or") children.take(1)
    ? (eq kind "divider") [(weft/el "hr" [] [])]
    ? (eq kind "input")
      = content=nat
          ? (eq node.arguments.len 0) ""
          ?> (./some held) (goo_browser/value published card node.arguments.at(0)) ""
          ?> slot=pails/p held ""
          ?> (./some value) card.get(slot.p) ""
          | goo_browser/text value
      [(weft/el "input" [(weft/att "disabled" "disabled")
        (weft/att "aria-label" "Input preview") (weft/att "value" content)] [])]
    ? (eq node.arguments.len 0) []
    ?> (./some value) (goo_browser/value published card node.arguments.at(0)) []
    = text (goo_browser/text value)
    ? (eq kind "action")
      [(weft/leaf "button" [(weft/att "disabled" "disabled")] text)]
    ? (eq kind "link")
      ?> target=pails/p value [(weft/tx text)]
      [(weft/leaf "a" [(weft/href (goo_browser/url target.p))] text)]
    [(weft/leaf "p" [(weft/cls "goo-value")] text)]
  + matches
    \ card=myth published=goo/published
    ^ bool
    | maybe/is_none (fit_check card.put(['sys 'lash] published.contract))
  + catalog
    \ tree=axal[myth]
    ^ row[goo/published]
    | tree.tap.bind
    \ [path card]
    ^ row[goo/published]
    ?> (./some held) card.get(publisher_vocabulary/grove/view) []
    ?> view=goo/published held []
    [view]
  + preview
    \ card=myth published=goo/published
    ^ weft/node
    = content=row[weft/node]
        ? published.result
         > (./ok view) (goo_browser/nodes published card view.children)
         > (./err error)
          = message=str
              ? error
               > (grove/error/syntax span message) message
               > (grove/error/parser cause) "Unable to compile view."
          [(weft/leaf "p" [(weft/cls "error")] (str/to_atom message))]
      heading
        [(weft/leaf "h2" [] (str/to_atom (path_show published.view.name)))
         (weft/leaf "p" [(weft/cls "meta")] (str/to_atom (path_show published.view.slot)))]
    | weft/el "section" [(weft/cls "preview")] heading.weld(content)
  + link
    \ path=path label=nat
    ^ weft/node
    | weft/leaf "a" [(weft/href (goo_browser/url path))] label
  + css
    ^ nat
    "*{box-sizing:border-box}body{margin:0;font:15px system-ui,sans-serif;color:#252525;background:#fafafa}aside{position:fixed;inset:0 auto 0 0;width:280px;padding:24px 18px;background:#f0f0ed;border-right:1px solid #ddd;overflow:auto}main{margin-left:280px;padding:32px;max-width:1100px}h1{font-size:22px;margin:0 0 10px;overflow-wrap:anywhere}h2{font:14px ui-monospace,monospace;overflow-wrap:anywhere}a{color:#245a63}aside a{display:block;padding:8px;border-radius:4px;overflow-wrap:anywhere}aside a:hover{background:#e2e5e2}.meta,.empty{color:#777;font-size:13px;overflow-wrap:anywhere}.preview{background:white;border:1px solid #ddd;border-radius:6px;padding:20px;margin:20px 0}.preview h2{margin:0}.preview .meta{margin:6px 0 22px}.goo-group{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.goo-group .goo-group{display:block}.goo-value{margin:8px 0;white-space:pre-wrap;overflow-wrap:anywhere}button,input{font:inherit;padding:8px 12px;border:1px solid #ccc;border-radius:4px}button:disabled{color:#666;background:#eee}input:disabled{background:#fafafa;color:#555}.error{color:#963e30;background:#fff4ef;padding:12px;line-height:1.5}@media(max-width:650px){aside{position:static;width:auto;max-height:35vh;border-bottom:1px solid #ddd}main{margin:0;padding:20px}}"
  + page
    \ target=path selected=axal[myth] catalog=axal[myth]
    ^ nat
    = links
        | selected.kid_tap.map
          \ [key child]
          = path target.snoc(key)
          | goo_browser/link path (show/path [key])
      navigation
        [(weft/leaf "h2" [] "Namespace")
         (goo_browser/link [] "All roots")
         (goo_browser/link target.take(target.len.dec) "↑ Parent")
         (weft/leaf "p" [(weft/cls "meta")] (show/path target))]
      content=row[weft/node]
        ?> (./some card) selected.fil
          [(weft/leaf "p" [(weft/cls "empty")] "Choose an object from the sidebar.")]
        = views ((goo_browser/catalog catalog).keep((goo_browser/matches card)))
        ? (eq views.len 0)
          [(weft/leaf "p" [(weft/cls "empty")] "No published views match this object.")]
        | views.map (goo_browser/preview card)
      header
        [(weft/leaf "h1" [] (show/path target))
         (weft/leaf "p" [(weft/cls "meta")] "All matching views · actions and inputs are previews")]
    | weft/page "Namespace views" goo_browser/css
      [(weft/el "aside" [] navigation.weld(links))
       (weft/el "main" [] header.weld(content))]
  + talk
    \ =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ? !(out.has(['goo_browser])) (explorer/route_talk bowl cur add)
    = target (out.path_at(['vpath])).fall([])
      selected bowl.crew.gut(['view] (axal/new[myth] .none))
      catalog bowl.crew.gut(['catalog] (axal/new[myth] .none))
      done
        . out
          put(['res_status] (pd 200))
          put(['res_body] (pd (goo_browser/page target selected catalog)))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
