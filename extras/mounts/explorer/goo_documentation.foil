- system_vocabulary
- web
- goo_bridge
- physical_projection
- value_read

' Read-only namespace documentation, through the ordinary Goo render boundary.
' Text stays text: lore, source and examples are escaped by Weft, never evaluated.
+ goo_documentation
  + compiler_reader
    : read={\ path myth}myth
  + reader_path
    \ self=iota
    ^ path
    [self 'weft 'goo_documentation_reader]
  + artifact
    \ slot=path card=myth
    ^ maybe[any]
    ?> (./some held) card.get(slot) .none
    ?> code=pails/code held .none
    ? !(rep_pin code.v) .none
    | ./some code.v
  + metadata
    ' Source inspection only. Prose is stored by the publisher, never synthesized here.
    \ card=myth source=str kind=str
    ^ myth
    = card (? card.has(['kind]) card card.put(['kind] (pails/t kind)))
      card (? source.len card.put(system_vocabulary/goo/normalized_source (pails/t source)) card)
    | card.put(system_vocabulary/goo/documentation_origin (pails/t "Normalized definition read from this record's pinned compiler artifact. Documentation is read from stored slots."))
  + enrich
    \ target=path card=myth state=namespace
    ^ myth
    ?> (./some record) (sovereign_peek (goo_documentation/reader_path state.self) state).fil card
    ?> (./some held) record.get(bond/content) card
    ?> reader=goo_documentation/compiler_reader held card
    = read reader.read
    | read target card
  + install_reader
    \ read={\ path myth}myth state=namespace
    ^ either[pail namespace]
    = target (goo_documentation/reader_path state.self)
      card (myth/sing bond/content (goo_documentation/compiler_reader read))
      command (? (maybe/is_some (sovereign_peek target state).fil) (writ/poke card) (writ/make card))
      [next index reply] (helm/supervisor/handle (helm/card/step target command) state (sovereign_hive state))
    ?> (./ack failure) reply (./err (pails/t "Documentation reader installation failed"))
    ? failure
     > (./some why) (./err why)
    | ./ok next
  + slot
    ^ path
    ['sys 'slot 'documentation]
  + summary_slot
    ^ path
    ['sys 'slot 'documentation_summary]
  + handles
    \ slot=path
    ^ bool
    | ((equal slot goo_documentation/slot) || (equal slot goo_documentation/summary_slot))
  + url
    \ target=path
    ^ nat
    | str/to_atom (str/cat_all ["/goo-documentation?path=" (value_read/percent (path_show target))])
  + label
    \ target=path
    ^ nat
    ? target.len (show/iota target.at(target.len.dec)) "/"
  + text
    \ card=myth slot=path
    ^ str
    ?> (./some held) card.get(slot) ""
    ?> value=pails/t held ""
    value.t
  + lede
    \ card=myth
    ^ str
    = text (goo_documentation/text card bond/lede)
    ? text.len text
    ?> (./some held) card.get(bond/help) ""
    ?> doc=lore held ""
    doc.head
  + kind
    \ card=myth
    ^ str
    = kind (goo_documentation/text card ['kind])
    ? kind.len kind
    ? (card.has(system_vocabulary/grove/view)) "view"
    | physical_projection/kind card
  + summary
    \ target=path card=myth
    ^ weft/node
    | weft/el "span" [(weft/cls "doc-summary")]
        [(weft/leaf "span" [(weft/cls "doc-name")] (goo_documentation/label target))
         (weft/leaf "small" [(weft/cls "doc-kind")] (str/to_atom (goo_documentation/kind card)))]
  + section
    \ name=nat children=row[weft/node]
    ^ weft/node
    | weft/el "section" [(weft/cls "doc-section")]
        children.cons((weft/leaf "h2" [] name))
  + prose
    \ card=myth
    ^ row[weft/node]
    = lede (goo_documentation/lede card)
      lead=row[weft/node] (? lede.len [(weft/leaf "p" [(weft/cls "doc-lede")] (str/to_atom lede))] [])
      help=row[weft/node]
        ?> (./some held) card.get(bond/help) []
        ? held
         > doc=lore
          = lines=row[weft/node]
              % i=nat 0 out=row[weft/node] []
              ? (eq i doc.body.len) out
              = line doc.body.at(i)
              ? (and (eq i 0) (eq line lede)) (_ i.inc out)
              | _ i.inc out.snoc((weft/leaf "p" [(weft/cls "lore-line")] (str/to_atom line)))
            examples=row[weft/node]
              | doc.tests.map
                \ [source expected]
                | weft/el "div" [(weft/cls "doc-example")]
                    [(weft/leaf "pre" [] (str/to_atom source))
                     (weft/leaf "p" [(weft/cls "doc-caption")] "Expected result")
                     (weft/leaf "pre" [] (str/to_atom expected))]
          ? examples.len
            | lines.snoc((goo_documentation/section "Examples" examples.cons((weft/leaf "p" [(weft/cls "doc-caption")] "Authored examples. This browser does not execute them or assert a test result."))))
          lines
         > (pails/t value)
          ? (eq value lede) []
          [(weft/leaf "p" [(weft/cls "lore-line")] (str/to_atom value))]
        []
      body lead.weld(help)
    ? body.len body
    [(weft/leaf "p" [(weft/cls "doc-empty")] "No documentation has been published for this record. Its source and stored values may still be available.")]
  + article
    \ target=path card=myth
    ^ weft/node
    = normalized (goo_documentation/text card system_vocabulary/goo/normalized_source)
      origin (goo_documentation/text card system_vocabulary/goo/documentation_origin)
      source (goo_documentation/text card bond/src)
      source (? source.len source (goo_documentation/text card system_vocabulary/grove/source))
      authored=bool (gt source.len 0)
      source (? authored source normalized)
      signature=row[weft/node]
        ?> (./some held) card.get(bond/mold) []
        ?> descriptor=pails/ty held []
        [(goo_documentation/section "Type" [(weft/leaf "pre" [(weft/cls "doc-signature")] (tyshow/pretty descriptor.t))])]
      code=row[weft/node]
        ? source.len
          [(weft/el "details" [(weft/cls "doc-source")]
            [(weft/leaf "summary" [] (? authored "Source" "Definition (normalized source)")) (weft/leaf "pre" [] (str/to_atom source))])]
        []
      links (weft/el "nav" [(weft/cls "doc-links") (weft/att "aria-label" "Record links")]
        [(weft/leaf "a" [(weft/href (goo_documentation/url target))] "Browse here")
         (weft/leaf "a" [(weft/href (explorer/url target))] "Namespace record")
         (weft/leaf "a" [(weft/href (str/to_atom (str/cat_all ["/views" (path_show target)])))] "Goo presentations")])
      heading=row[weft/node]
        [(weft/leaf "p" [(weft/cls "doc-eyebrow")] (str/to_atom (goo_documentation/kind card)))
         (weft/leaf "h1" [] (goo_documentation/label target))
         (weft/leaf "p" [(weft/cls "doc-path")] (str/to_atom (path_show target))) links]
      foot=row[weft/node] (? origin.len [(weft/leaf "p" [(weft/cls "doc-caption")] (str/to_atom origin))] [])
    | weft/el "article" [(weft/cls "goo-documentation") (weft/att "data-subject" (str/to_atom (path_show target)))]
        (heading.weld((goo_documentation/prose card)).weld(signature).weld(code).weld(foot))
  + fields
    \ context=goo_bridge/render_context target=path slot=path card=myth
    ^ row[jkv]
    = body (? (equal slot goo_documentation/summary_slot) (goo_documentation/summary target card) (goo_documentation/article target card))
    [(jkv "view" (json/str (path_show slot))) (jkv "slot" (json/str (path_show slot))) (jkv "role" (json/str ""))
     (jkv "kind" (json/str "view")) (jkv "profile" (goo_profile/metadata unit/unit))
     (jkv "context" (goo_bridge/context_json context)) (jkv "display" jnull)
     (jkv "html" (json/str (str/from_atom (weft/render body)))) (jkv "controls" (json/arr []))]
