- stdlib/base
- web
- goo_reflection
- stdlib/runtime

' Read-only namespace documentation, through the ordinary Goo render boundary.
' Text stays text: lore, source and examples are escaped by Weft, never evaluated.
+ goo_documentation
  + compiler_reader
    : read={\ path myth}myth
  + reader_path
    \ self=iota
    ^ path
    [self 'weft 'goo_documentation_reader]
  + artifact
    \ slot=path card=myth
    ^ maybe[any]
    > (./some held) card.get(slot) .none
    > code=pails/code held .none
    ? !(rep_pin code.v) .none
    | ./some code.v
  + metadata
    ' Source inspection only. Prose is stored by the publisher, never synthesized here.
    \ card=myth source=str kind=str
    ^ myth
    = card (? card.has(['kind]) card card.put(['kind] (pails/t kind)))
      card (? source.len card.put(system_vocabulary/goo/normalized_source (pails/t source)) card)
    | card.put(system_vocabulary/goo/documentation_origin (pails/t "Normalized definition read from this record's pinned compiler artifact. Documentation is read from stored slots."))
  + enrich
    \ target=path card=myth state=namespace
    ^ myth
    > (./some record) (sovereign_peek (goo_documentation/reader_path state.self) state).fil card
    > (./some held) record.get(bond/content) card
    > reader=goo_documentation/compiler_reader held card
    = read reader.read
    | read target card
  + install_reader
    \ read={\ path myth}myth state=namespace
    ^ either[pail namespace]
    = target (goo_documentation/reader_path state.self)
      card (myth/sing bond/content (goo_documentation/compiler_reader read))
      command (? (maybe/is_some (sovereign_peek target state).fil) (writ/poke card) (writ/make card))
      [next reply] (helm/supervisor/handle (helm/card/step target command) state)
    > (./ack failure) reply (./err (pails/t "Documentation reader installation failed"))
    ? failure
     > (./some why) (./err why)
    | ./ok next
  + slot
    ^ path
    ['sys 'slot 'documentation]
  + summary_slot
    ^ path
    ['sys 'slot 'documentation_summary]
  + handles
    \ slot=path
    ^ bool
    | ((equal slot goo_documentation/slot) || (equal slot goo_documentation/summary_slot))
  + url
    \ target=path
    ^ nat
    | str/to_atom (str/cat_all ["/goo-documentation?path=" (value_read/percent (path_show target))])
  + label
    \ target=path
    ^ nat
    ? target.len (show/iota target.at(target.len.dec)) "/"
  + text
    \ card=myth slot=path
    ^ str
    > (./some held) card.get(slot) ""
    > value=pails/t held ""
    value.t
  + lede
    \ card=myth
    ^ str
    = text (goo_documentation/text card bond/lede)
    ? text.len text
    > (./some held) card.get(bond/help) ""
    > doc=lore held ""
    doc.head
  + kind
    \ card=myth
    ^ str
    = kind (goo_documentation/text card ['kind])
    ? kind.len kind
    ? (card.has(system_vocabulary/grove/view)) "view"
    | physical_projection/kind card
  + summary
    \ target=path card=myth
    ^ weft/node
    | weft/el "span" [(weft/cls "doc-summary")]
        [(weft/leaf "span" [(weft/cls "doc-name")] (goo_documentation/label target))
         (weft/leaf "small" [(weft/cls "doc-kind")] (str/to_atom (goo_documentation/kind card)))]
  + section
    \ name=nat children=row[weft/node]
    ^ weft/node
    | weft/el "section" [(weft/cls "doc-section")]
        children.cons((weft/leaf "h2" [] name))
  + paragraphs
    \ card=myth lede=str
    ^ row[str]
    > (./some held) card.get(bond/help) []
    ? held
     > doc=lore
      ? (and (gt doc.body.len 0) (eq (doc.body.at(0)) lede)) doc.body.drop(1)
      doc.body
     > (pails/t value) (? (eq value lede) [] [value])
    []
  + examples
    \ card=myth
    ^ row[[str str]]
    > (./some held) card.get(bond/help) []
    > doc=lore held []
    doc.tests
  + empty_notice
    ^ str
    "No documentation has been published for this record. Its source and stored values may still be available."
  + example_notice
    ^ str
    "Authored examples. This browser does not execute them or assert a test result."
  + prose
    \ card=myth
    ^ row[weft/node]
    = lede (goo_documentation/lede card)
      lead=row[weft/node] (? lede.len [(weft/leaf "p" [(weft/cls "doc-lede")] (str/to_atom lede))] [])
      lines (goo_documentation/paragraphs card lede).map((\ line (weft/leaf "p" [(weft/cls "lore-line")] (str/to_atom line))))
      examples=row[weft/node]
        | (goo_documentation/examples card).map
          \ [source expected]
          | weft/el "div" [(weft/cls "doc-example")]
              [(weft/leaf "pre" [] (str/to_atom source))
               (weft/leaf "p" [(weft/cls "doc-caption")] "Expected result")
               (weft/leaf "pre" [] (str/to_atom expected))]
      body lead.weld(lines)
      body (? examples.len body.snoc((goo_documentation/section "Examples" examples.cons((weft/leaf "p" [(weft/cls "doc-caption")] (str/to_atom goo_documentation/example_notice))))) body)
    ? body.len body
    [(weft/leaf "p" [(weft/cls "doc-empty")] (str/to_atom goo_documentation/empty_notice))]
  + source_info
    \ card=myth
    ^ [str str]
    = source (goo_documentation/text card bond/src)
      source (? source.len source (goo_documentation/text card system_vocabulary/grove/source))
    ? source.len ["Source" source]
    ["Definition (normalized source)" (goo_documentation/text card system_vocabulary/goo/normalized_source)]
  + signature
    \ card=myth
    ^ str
    > (./some held) card.get(bond/mold) ""
    > descriptor=pails/ty held ""
    | str/from_atom (tyshow/pretty descriptor.t)
  + article
    \ target=path card=myth
    ^ weft/node
    = [source_label source] (goo_documentation/source_info card)
      origin (goo_documentation/text card system_vocabulary/goo/documentation_origin)
      type_text (goo_documentation/signature card)
      signature=row[weft/node]
        ? !(type_text.len) []
        [(goo_documentation/section "Type" [(weft/leaf "pre" [(weft/cls "doc-signature")] (str/to_atom type_text))])]
      code=row[weft/node]
        ? source.len
          [(weft/el "details" [(weft/cls "doc-source")]
            [(weft/leaf "summary" [] (str/to_atom source_label)) (weft/leaf "pre" [] (str/to_atom source))])]
        []
      links (weft/el "nav" [(weft/cls "doc-links") (weft/att "aria-label" "Record links")]
        [(weft/leaf "a" [(weft/href (goo_documentation/url target))] "Browse here")
         (weft/leaf "a" [(weft/href (explorer/url target))] "Namespace record")
         (weft/leaf "a" [(weft/href (str/to_atom (str/cat_all ["/views" (path_show target)])))] "Goo presentations")])
      heading=row[weft/node]
        [(weft/leaf "p" [(weft/cls "doc-eyebrow")] (str/to_atom (goo_documentation/kind card)))
         (weft/leaf "h1" [] (goo_documentation/label target))
         (weft/leaf "p" [(weft/cls "doc-path")] (str/to_atom (path_show target))) links]
      foot=row[weft/node] (? origin.len [(weft/leaf "p" [(weft/cls "doc-caption")] (str/to_atom origin))] [])
    | weft/el "article" [(weft/cls "goo-documentation") (weft/att "data-subject" (str/to_atom (path_show target)))]
        (heading.weld((goo_documentation/prose card)).weld(signature).weld(code).weld(foot))
  + block
    \ role=str value=str
    ^ goo/source
    = text (goo/text/en (goo_reflection/portable_text value 4096 " [excerpt ends]"))
      attrs (goo_bridge/attrs rex/zero_span role goo/config/empty)
    ? (eq role "code") (goo/source/jet attrs (goo/primitive/code text))
    | goo/source/text attrs text
  + compile
    \ context=goo_bridge/render_context target=path slot=path card=myth
    ^ either[str goo_bridge/compilation]
    = block goo_documentation/block
      name (str/from_atom (goo_documentation/label target))
      lede (goo_documentation/lede card)
      lines (goo_documentation/paragraphs card lede)
      samples (goo_documentation/examples card)
      parts=row[goo/source]
        ? (equal slot goo_documentation/summary_slot) [(block "label" name) (block "hint" (goo_documentation/kind card))]
        = parts=row[goo/source] [(block "title" name) (block "hint" (path_show target)) (block "label" (goo_documentation/kind card))]
          parts (? lede.len parts.snoc((block "body" lede)) parts)
          parts parts.weld(lines.stream.take(48).map((block "body")).row)
          parts (? (gt lines.len 48) parts.snoc((block "hint" "Additional paragraphs omitted from this preview.")) parts)
          parts (? (add lede.len (add lines.len samples.len)) parts parts.snoc((block "body" goo_documentation/empty_notice)))
          sig (goo_documentation/signature card)
          parts (? sig.len parts.snoc((block "label" "Type")).snoc((block "code" sig)) parts)
          parts (? samples.len parts.snoc((block "label" "Examples")).snoc((block "hint" goo_documentation/example_notice)) parts)
          parts=row[goo/source]
            | samples.stream.take(12).fold parts
              \ out=row[goo/source] [source expected]
              | out.snoc((block "code" source)).snoc((block "label" "Expected result")).snoc((block "code" expected))
          parts (? (gt samples.len 12) parts.snoc((block "hint" "Additional examples omitted from this preview.")) parts)
          [label source] (goo_documentation/source_info card)
          parts (? source.len parts.snoc((block "label" label)).snoc((block "code" source)) parts)
          origin (goo_documentation/text card system_vocabulary/goo/documentation_origin)
        ? origin.len parts.snoc((block "hint" origin))
        parts
      source (goo/source/flow (goo_bridge/attrs rex/zero_span "col" goo/config/empty) (goo/direction/col) parts.stream)
    | goo_bridge/compile_source context source (str/cat_all [(path_show target) ":" (path_show slot)]) slot
  + fields
    \ context=goo_bridge/render_context target=path slot=path card=myth
    ^ either[str row[jkv]]
    < compiled (goo_documentation/compile context target slot card)
    > (./some display) (goo_prepared/encode compiled.prepared) (./err "Invalid documentation display")
    = body (? (equal slot goo_documentation/summary_slot) (goo_documentation/summary target card) (goo_documentation/article target card))
      fields=row[jkv]
        [(jkv "view" (json/str (path_show slot))) (jkv "slot" (json/str (path_show slot))) (jkv "role" (json/str ""))
     (jkv "kind" (json/str "view")) (jkv "profile" (goo_profile/metadata unit/unit))
     (jkv "context" (goo_bridge/context_json context)) (jkv "display" display)
     (jkv "html" (json/str (str/from_atom (weft/render body)))) (jkv "controls" (json/arr []))]
    | ./ok fields.weld((goo_bridge/pipeline_fields context compiled display (goo_html/fragment compiled.prepared) []))
