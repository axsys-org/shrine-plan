- system_vocabulary
- tests/goo [at=frontend]
- tests/goo_runtime [at=runtime]
- goo_panes
- goo_workspace
- testing

+ pane_checks
  + source_checks
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["workspace =" "  @pane" "  #on ; %/card" "  #for ; /sys/slot/workspace"
         "  item => selection('/current, source = item.about) { list('/rows, source = item.about, selection = '/current) }"])
      compiled (frontend/goo_checks/compile source "workspace" frontend/goo_checks/renderers)
      wrong (frontend/goo_checks/reject
        ["bad =" "  @pane" "  #on ; %/card" "  #for ; /sys/slot/workspace"
         "  item => selection('/current, source = item.req) {}"])
      view (either/ok_val compiled)
      fields (list/one (goo/field "about" system_vocabulary/about ['lib 'grove 'types 'path] .true))
      published (goo/published view fields lash/new (./ok view))
      card (myth/sing system_vocabulary/about (pails/p ['objects]))
      bound (goo_runtime/bind_sources published card view.children)
      missing (goo_runtime/bind_sources published myth/new view.children)
    [(testing/nat "typed path source compiles" 1 (either/is_ok compiled))
     (testing/text "text source rejected" "Pane source must have path type." wrong)
     (testing/nat "path source binds from receiver" 1 (either/is_ok bound))
     (testing/nat "missing source produces a diagnostic" 1 (either/is_err missing))
     (testing/nat "capture sees receiver-bound source" 1
       (equal (goo_runtime/selection_source ['demo 'workspace 'selection 'current] (either/ok_val bound) [0 0 0] .none)
         (maybe/some[path] ['objects])))]
  + topoi_checks
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["workspace =" "  @pane" "  #on ; %/card" "  #for ; /workspace"
         "  c => selection('/chosen, source = '/objects, topology = ""tree"", axis = ""y"") {"
         "    list('/flat, source = '/objects, selection = '/chosen)"
         "    diagram_tree('/diagram, source = '/objects, selection = '/chosen)"
         "    list_tree('/outline, source = '/objects, selection = '/chosen)" "  }"])
      compiled (frontend/goo_checks/compile source "workspace" frontend/goo_checks/renderers)
      view (either/ok_val compiled)
      published (goo/published view .nil lash/new (./ok view))
      description (either/ok_val (goo_panes/description published myth/new view))
    [(testing/nat "three topoi compile" 1 (either/is_ok compiled))
     (testing/nat "topoi use generic IR kind" 1 (maybe/is_some (str/find """kind"":""topos""" description)))
     (testing/nat "axis is retained in browser description" 1 (maybe/is_some (str/find """axis"":""y""" description)))
     (testing/text "axis is retained for admission" "y"
       (goo_runtime/selection_axis ['demo 'workspace 'selection 'chosen] view.children [0 0 0] "z"))
     (testing/nat "diagram renderer is retained" 1 (maybe/is_some (str/find """renderer"":""diagram_tree""" description)))
     (testing/nat "tree source topology retained" 1 (maybe/is_some (str/find """topology"":""tree""" description)))
     (testing/nat "tree source topology is available to admission" 1
       (goo_runtime/selection_tree ['demo 'workspace 'selection 'chosen] view.children [0 0 0] .false))
     (testing/text "unknown source axis rejected" "Selection axis must be x, y, or z."
       (frontend/goo_checks/reject ["bad =" "  @pane" "  #on ; %/card" "  #for ; /bad"
         "  c => selection('/chosen, source = '/objects, axis = ""q"") {} "]))
     (testing/text "tree controls require pane" "Pane controls require @pane; @view is an object projection."
       (frontend/goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => diagram_tree('/diagram, source = '/objects, selection = '/chosen)"]))]
  + patch_receipts
    \ ignored=unit
    ^ row[testing/check]
    = [initial query] (runtime/goo_runtime_checks/setup [])
      query query.set_inputs(query.inputs.snoc(["$invocation" "patch-committed"]))
      [committed code body] (goo_runtime/act query initial)
      receipt (goo_runtime/operation_status query committed)
      missing (goo_runtime/operation_status query.set_inputs([["$invocation" "missing"]]) committed)
      snapshot (goo_runtime/status query committed)
    [(testing/nat "real action commits" 200 code)
     (testing/nat "journal supplies operation status" 1 (maybe/is_some (str/find "accepted" receipt)))
     (testing/nat "missing receipt remains unknown" 1 (maybe/is_some (str/find "unknown" missing)))
     (testing/nat "committed snapshot covers invocation" 1 (maybe/is_some (str/find "patch-committed" snapshot)))
     (testing/nat "snapshot carries ordered namespace epoch" 1 (maybe/is_some (str/find "projectionSeq" snapshot)))]
  + find_kind
    \ kind=str value=json
    ^ json
    ? value
     > (json/obj fields)
      ? (eq (grove_dev/text (grove_dev/field "kind" value)) kind) value
      | pane_checks/find_kind kind (grove_dev/field "children" value)
     > (json/arr values)
      % rest=row[json] values
      ^ json
      ? (eq rest.len 0) jnull
      = found (pane_checks/find_kind kind rest.at(0))
      ? !(equal found jnull) found
      | _ rest.drop(1)
    jnull
  + patch_checks
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["workspace =" "  @pane" "  #on ; %/card" "  #for ; /workspace"
         "  item => patch('/canvas, scene = item.req, label = ""Patch"") {"
         "    patch_node(""one"") {" "      show(""Node"", '/sys/slot/title)"
         "      patch_port(""out"", label = ""Output"")"
         "      patch_handle(""move"", label = ""Move node"")"
         "      patch_label(""caption"") { show(""Caption"", '/sys/slot/caption) }" "    }"
         "    patch_operation(""move-nodes"", slot = '/sys/req) {"
         "      group(on = item, action = .poke, myth = { '/sys/req = .input(item.req) }) {"
         "        input('/sys/req)" "        action(""Move"")" "      }" "    }"
         "  }"])
      compiled (frontend/goo_checks/compile source "workspace" frontend/goo_checks/renderers)
    ? (either/is_err compiled) [(testing/text "patch compiles" "success" (frontend/goo_checks/error compiled))]
    = view (either/ok_val compiled)
      fields (list/one (goo/field "req" system_vocabulary/req ['lib 'grove 'types 'text] .true))
      published (goo/published view fields lash/new (./ok view))
      card (myth/sing system_vocabulary/req (pails/t "{""nodes"":[{""key"":""one"",""rect"":{""width"":240}}],""connections"":[{""key"":""edge"",""endpoints"":[{""key"":""from""}]}]}"))
      description (goo_panes/description published card view)
      dangerous (json/str "</script><script>alert(1)</script>")
      encoded (goo_patch/inert_scene dangerous)
      decoded=maybe[json]
        ?> (jres/ok value rest) (parse encoded) .none
        | ./some value
    ? (either/is_err description) [(testing/text "patch lowers" "success" (either/err_val description))]
    ?> (jres/ok parsed rest) (parse (either/ok_val description)) [(testing/nat "patch JSON" 1 0)]
    = patch (pane_checks/find_kind "patch" parsed)
      contents (grove_dev/items (grove_dev/field "contents" patch))
      content (grove_dev/items (grove_dev/field "content" contents.at(0)))
      body content.at(0)
      display (grove_dev/field "display" body)
      moves (grove_dev/items (grove_dev/field "moves" content.at(2)))
      operation (grove_dev/items (grove_dev/field "content" contents.at(1))).at(0)
      controls (grove_dev/items (grove_dev/field "controls" operation))
      action controls.at(1)
      binding (grove_dev/field "binding" action)
      offer (grove_dev/items (grove_dev/field "offerBindings" patch)).at(0)
      connection (grove_dev/items (grove_dev/field "connectionControls" patch)).at(0)
      select_node (goo/node rex/zero_span "patch_select"
        (list/one (rex/cord "select")).snoc((rex/rune "=" [(rex/word "label") (rex/cord "Select node")])) .nil)
      selected=json
        ?> (./ok fragment) (goo_patch/body goo_bridge/initial_context published card (list/one select_node) [] (\ node route [])) jnull
        | fragment.content.at(0)
    [(testing/nat "patch occurrence width drives display" 1 (equal (grove_dev/field "width" display) (goo_number/encode (goo_fp/integer 240))))
     (testing/text "patch body preserves prepared text" "Node" (grove_dev/text (grove_dev/field "payload" (grove_dev/items (grove_dev/field "nodes" display)).at(1))))
     (testing/text "portable port retains scene key" "out" (grove_dev/text (grove_dev/field "key" content.at(1))))
     (testing/nat "portable handle has four movements" 4 moves.len)
     (testing/text "portable selection is not a movement handle" "select" (grove_dev/text (grove_dev/field "kind" selected)))
     (testing/nat "portable selection carries no movements" 0 (grove_dev/items (grove_dev/field "moves" selected)).len)
     (testing/text "portable movement carries accessible name" "Move node left" (grove_dev/text (grove_dev/field "label" moves.at(0))))
     (testing/text "portable patch label retains child content" "body" (grove_dev/text (grove_dev/field "kind" (grove_dev/items (grove_dev/field "children" content.at(3))).at(0))))
     (testing/nat "portable connection has disconnect and endpoint reconnect" 2 (grove_dev/items (grove_dev/field "controls" connection)).len)
     (testing/nat "offer binds the same final action as portable body" 1 (equal action (grove_dev/field "control" offer)))
     (testing/nat "patch binding uses final rewritten node id" 1 (equal (grove_dev/field "id" action) (grove_dev/field "nodeId" binding)))
     (testing/nat "patch control joins its portable display" 1 (equal (grove_dev/field "presented" binding) (json/boo .true)))
     (testing/text "patch binding retains absolute declaration route" (str/cat_all [(grove_dev/text (grove_dev/field "node" patch)) ".1.0.1"]) (grove_dev/text (grove_dev/field "route" binding)))
     (testing/nat "hosted domain admission traverses patch content" 1 (goo_browser/domain_controls parsed))
     (testing/nat "patch authoring compiles" 1 (either/is_ok compiled))
     (testing/nat "server lowers patch content" 1 (either/is_ok description))
     (testing/nat "patch port becomes a server native control" 1
       (maybe/is_some (str/find "goo-patch-port" (either/ok_val description))))
     (testing/nat "inert scene cannot close its script" 1 (maybe/is_none (str/find "<" encoded)))
     (testing/nat "inert scene escaping preserves JSON values" 1 (equal decoded (maybe/some[json] dangerous)))
     (testing/text "patch requires a resolved scene" "patch requires a server-resolved scene field."
       (frontend/goo_checks/reject ["bad =" "  @pane" "  #on ; %/card" "  #for ; /bad"
         "  item => patch('/canvas) {}"]))
     (testing/text "patch requires a pane" "Pane controls require @pane; @view is an object projection."
       (frontend/goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  item => patch('/canvas, scene = item.req) {}"]))]
  + markup_checks
    \ ignored=unit
    ^ row[testing/check]
    = native (json/obj [(jkv "kind" (json/str "native")) (jkv "html" (json/str "<strong>Server content</strong>"))])
      pane (json/obj [(jkv "kind" (json/str "pane")) (jkv "key" (json/str "/Values")) (jkv "children" (json/arr [native]))])
      nodes (goo_panes/server_body (show (json/arr [pane])) (\ node []))
      html (str/from_atom (weft/render (weft/el "div" [] nodes)))
    [(testing/nat "pane HTML contains native content before scripts" 1 (maybe/is_some (str/find "<strong>Server content</strong>" html)))
     (testing/nat "pane HTML has hydration addresses" 1 (maybe/is_some (str/find "data-goo-node" html)))
     (testing/nat "pane HTML has accessible name" 1 (maybe/is_some (str/find "/Values" html)))]
  + workspace_checks
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["workspace =" "  @pane" "  #on ; %/card" "  #for ; /sys/slot/workspace"
         "  item => selection('/current, source = item.about) { list('/rows, source = item.about, selection = '/current) }"])
      view (either/ok_val (frontend/goo_checks/compile source "workspace" frontend/goo_checks/renderers))
      fields (list/one (goo/field "about" system_vocabulary/about ['lib 'grove 'types 'path] .true))
      published (goo/published view fields lash/new (./ok view))
      index (goo_browser/index (list/one published))
      endpoint (goo_workspace/endpoint view.name system_vocabulary/about ['objects]
        (\ selected .none) [] (\ target content 0))
      requested=myth
        ?> (./wait record) (goo_workspace/request endpoint (http_foot/request "GET" "/workspace?path=/other&declaration=/injected" "") 0) myth/new
        record
      defaulted=myth
        ?> (./wait record) (goo_workspace/request endpoint (http_foot/request "GET" "/workspace" "") 0) myth/new
        record
      selected (axal/new[myth] .none)
      session (goo_workspace/session [($x 1) 'goo 'ses ($u 1)] (myth/sing system_vocabulary/about (pails/p ['other])))
      described (goo_workspace/describe endpoint session selected index)
      absent (goo_workspace/describe endpoint.set_declaration(['missing]) session selected index)
      ambiguous (goo_workspace/describe endpoint session selected (goo_browser/index (list/cons published (list/one published))))
      rejected (goo_workspace/describe endpoint.set_validate((\ selected (./some "Rejected source"))) session selected index)
      unbound (goo_workspace/describe endpoint session.set_card(myth/new) selected index)
      html (str/from_atom (weft/render (weft/el "div" [] (goo_workspace/content endpoint session ['other] selected index))))
    [(testing/nat "pane excluded from view matches" 0 (goo_browser/matching myth/new index).len)
     (testing/nat "pane available through pane matches" 1 (goo_browser/matching_panes myth/new index).len)
     (testing/nat "workspace rejects ordinary view declaration" 1
       (either/is_err (goo_workspace/describe endpoint session selected
         (goo_browser/index (list/one published.set_view(view.set_is_pane(.false)))))))
     (testing/nat "workspace query selects subject" 1 (equal[maybe[path]] requested.path_at(['workspace_target]) (./some ['other])))
     (testing/nat "workspace query cannot select declaration" 1 (equal[maybe[path]] requested.path_at(['goo_workspace]) (./some view.name)))
     (testing/nat "workspace absent query uses configured default" 1 (equal[maybe[path]] defaulted.path_at(['workspace_target]) (./some ['objects])))
     (testing/nat "workspace constructs a path receiver" 1 (either/is_ok described))
     (testing/nat "workspace uses selected path rather than default" 1 (maybe/is_some (str/find "/other" (either/ok_val described))))
     (testing/nat "workspace rejects missing declaration" 1 (either/is_err absent))
     (testing/nat "workspace rejects ambiguous declaration" 1 (either/is_err ambiguous))
     (testing/nat "workspace applies host source policy" 1 (equal[either[str str]] rejected (./err "Rejected source")))
     (testing/nat "workspace rejects unbound source" 1 (either/is_err unbound))
     (testing/nat "workspace emits hydrated server body" 1 (maybe/is_some (str/find "data-goo-body" html)))]
  + host_controls
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["workspace =" "  @pane" "  #on ; %/card" "  #for ; /sys/slot/workspace"
         "  item => {"
         "    navigate('/address, source = item.about, mode = ""input"", label = ""Inspect"")"
         "    operation('/reload, operation = '/reload, label = ""Reload"")"
         "    operation_status('/status, operation = '/reload, label = ""Publication"")" "  }"])
      compiled (frontend/goo_checks/compile source "workspace" frontend/goo_checks/renderers)
      view (either/ok_val compiled)
      fields (list/one (goo/field "about" system_vocabulary/about ['lib 'grove 'types 'path] .true))
      published (goo/published view fields lash/new (./ok view))
      description (goo_panes/description published (myth/sing system_vocabulary/about (pails/p ['objects])) view)
      html (str/from_atom (weft/render (weft/el "div" [] (goo_panes/server_body (either/ok_val description) (\ node [])))))
      wrong (frontend/goo_checks/reject
        ["bad =" "  @pane" "  #on ; %/card" "  #for ; /sys/slot/workspace"
         "  item => { navigate('/go, source = item.req) }"])
    [(testing/nat "host controls compile" 1 (either/is_ok compiled))
     (testing/nat "navigation is server rendered" 1 (maybe/is_some (str/find "method=""get""" html)))
     (testing/nat "operation status is server rendered" 1 (maybe/is_some (str/find "Publication" html)))
     (testing/text "navigation source must have path type" "Pane source must have path type." wrong)]
  + make_frontend
    \ ignored=unit
    ^ row[testing/check]
    = source (frontend/goo_checks/extra
        ["create =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/create"
         "  item => group(make = item.about, role = %/card, myth = { '/sys/req = .input("""") }) {"
         "    input('/sys/req)" "    action(""Create"")" "  }"])
      compiled (frontend/goo_checks/compile source "create" frontend/goo_checks/renderers)
      view (either/ok_val compiled)
      published (goo/published view .nil lash/new (./ok view))
      html (goo_bridge/render published (myth/sing system_vocabulary/req (pails/t "ANCHOR-ONLY")) view)
      conflict (frontend/goo_checks/reject
        ["bad =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/create"
         "  item => group(make = item.about, on = item, role = %/card) { action(""Create"") }"])
      missing (frontend/goo_checks/reject
        ["bad =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/create"
         "  item => group(make = item.about) { action(""Create"") }"])
    [(testing/nat "make syntax compiles" 1 (either/is_ok compiled))
     (testing/nat "make form renders" 1 (either/is_ok html))
     (testing/nat "creation input does not inherit anchor slot" 1 (maybe/is_none (str/find "ANCHOR-ONLY" (either/ok_val html))))
     (testing/text "make and on are exclusive" "make cannot be combined with on or action." conflict)
     (testing/text "make requires a role" "make requires a role." missing)]
  + seed_diagnostic
    \ ignored=unit
    ^ row[testing/check]
    = view (frontend/goo_checks/built "front")
      published (goo/published view .nil lash/new (./ok view))
      arguments (list/one[rex] (rex/quip "'/current"))
      arguments arguments.snoc((rex/rune "=" [(rex/word "initial") (rex/quip "'/a")]))
      node (goo/node rex/zero_span "selection" arguments .nil)
      result (goo_panes/node published myth/new [0] node)
    [(testing/nat "S04 ambiguous bare subject seed is an explicit diagnostic" 1 (either/is_err result))]

  + portable_controls
    \ ignored=unit
    ^ row[testing/check]
    = captures (json/arr [(json/obj [(jkv "slot" (json/str "/about")) (jkv "selection" (json/str "/selected"))])])
      control (json/obj [(jkv "id" (json/str "view:2")) (jkv "control" (json/str "0.1.2"))
        (jkv "kind" (json/str "action")) (jkv "slot" (json/str "/next")) (jkv "invoke" (json/boo .true))
        (jkv "become" (json/boo .true)) (jkv "captures" captures)])
      input (json/obj [(jkv "id" (json/str "view:1")) (jkv "control" (json/str "0.1.1"))
        (jkv "kind" (json/str "input")) (jkv "slot" (json/str "/text"))])
      display (json/obj [(jkv "nodes" (json/arr [(json/obj [(jkv "id" (json/str "view:2"))])]))])
      output (goo_bridge/control_descriptors [control input] display)
      binding (grove_dev/field "binding" output.at(0))
      hidden (grove_dev/field "binding" output.at(1))
    [(testing/text "binding retains invoke plus become" "invoke-and-become" (grove_dev/text (grove_dev/field "kind" binding)))
     (testing/nat "binding preserves capture references" 1 (equal captures (grove_dev/field "captures" binding)))
     (testing/nat "absent captures normalize to an empty array" 1 (equal (grove_dev/field "captures" output.at(1)) (json/arr [])))
     (testing/nat "invisible input remains identified but unpresented" 1 (equal (grove_dev/field "presented" hidden) (json/boo .false)))
     (testing/text "input binding retains its slot" "/text" (grove_dev/text (grove_dev/field "slot" hidden)))]
  + workspace_install
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (runtime/goo_runtime_checks/setup [])
      endpoint (goo_workspace/endpoint query.view system_vocabulary/about query.target
        (\ selected .none) [[['reload] ['source]]] (\ target content 111))
      installed (goo_workspace/install endpoint goo_browser/talk state)
      first=namespace
        ? installed
         > (./ok value) value
         > (./err why) state
      context_path (goo_workspace/sessions state.self).snoc(($u 1))
      context_card (myth/sing system_vocabulary/about (pails/p query.target))
      [first context_index context_reply] (helm/supervisor/handle (helm/card/step context_path (writ/make context_card)) first (sovereign_hive first))
      card (goo_browser/render_card context_path endpoint.declaration first)
      second_endpoint endpoint.set_declaration(query.view.snoc('second)).set_document((\ target content 222))
      second (goo_workspace/install second_endpoint goo_browser/talk first)
      next=namespace
        ? second
         > (./ok value) value
         > (./err why) first
      repeated (goo_workspace/install endpoint goo_browser/talk next)
      record (goo_runtime/record .x [state.self 'kook 'hex] next).fall(myth/new)
      behavior=form
        ?> (./some held) record.get(bond/form) def_form
        ?> behavior=form held def_form
        behavior
      talk behavior.talk
      bowl (bowl [] [state.self 'kook 'hex] 0 0 (axal/new[myth] .none) (mop/empty))
      request (\ declaration=path (myth/sing ['goo_workspace] (pails/p declaration)).put(['workspace_target] (pails/p query.target)).put(system_vocabulary/content (goo_workspace/session context_path context_card)))
      one (talk bowl myth/new (request endpoint.declaration))
      two (talk bowl myth/new (request second_endpoint.declaration))
      descriptor (goo_browser/host_descriptor endpoint.declaration first)
      bound=bool
        ?> (./ok card) card .false
        | equal card.path_at(system_vocabulary/about) (maybe/some[path] query.target)
    [(testing/nat "installed host exposes configured capabilities" 1 (equal descriptor (goo_workspace/host_descriptor endpoint)))
     (testing/text "host describes stored-session navigation" "workspace-session" (grove_dev/text (grove_dev/field "kind" (grove_dev/field "navigation" descriptor))))
     (testing/text "host identifies its source slot" (path_show endpoint.source_slot) (grove_dev/text (grove_dev/field "sourceSlot" (grove_dev/field "navigation" descriptor))))
     (testing/nat "host rejects raw source as session receiver" 1 (either/is_err (goo_browser/render_card query.target endpoint.declaration first)))
     (testing/nat "uninstalled host cannot advertise capabilities" 1 (equal (goo_browser/host_descriptor ['missing] first) jnull))
     (testing/nat "HTML and portable host operations share one definition" 1 (eq (show (grove_dev/field "operations" descriptor)) (goo_workspace/operations endpoint)))
     (testing/nat "workspace installation creates absent receiver registry" 1 (either/is_ok installed))
     (testing/nat "installed receiver binds the validated target" 1 bound)
     (testing/nat "second workspace installs alongside first" 1 (either/is_ok second))
     (testing/nat "receiver registration can be replaced" 1 (either/is_ok repeated))
     (testing/nat "first workspace handler survives second installation" 111 one.out.nat_at(['res_body] 0))
     (testing/nat "second workspace handler receives its own requests" 222 two.out.nat_at(['res_body] 0))]

+ tests
  ^ row[testing/case]
  [(testing/case "Portable control bindings" pane_checks/portable_controls)
   (testing/case "Workspace activation" pane_checks/workspace_install)
   (testing/case "Generic topoi" pane_checks/topoi_checks)
   (testing/case "Pane composition" frontend/goo_checks/pane_composition)
   (testing/case "Declaration boundary" frontend/goo_checks/declaration_boundary)
   (testing/case "Creation frontend" pane_checks/make_frontend)
   (testing/case "Workspace host controls" pane_checks/host_controls)
   (testing/case "Generic workspace endpoint" pane_checks/workspace_checks)
   (testing/case "Typed path sources" pane_checks/source_checks)
   (testing/case "Patch invocation coverage" pane_checks/patch_receipts)
   (testing/case "Grove patch lowering" pane_checks/patch_checks)
   (testing/case "Server pane markup" pane_checks/markup_checks)
   (testing/case "Typed creation seed diagnostic" pane_checks/seed_diagnostic)
