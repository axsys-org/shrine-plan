- tests/goo [at=frontend]
- tests/goo_runtime [at=runtime]
- goo_panes
- testing

+ pane_checks
  + seed_diagnostic
    \ ignored=unit
    ^ row[testing/check]
    = view (frontend/goo_checks/built "front")
      published (goo/published view .nil lash/new (./ok view))
      arguments (list/one[rex] (rex/quip "'/current"))
      arguments arguments.snoc((rex/rune "=" [(rex/word "initial") (rex/quip "'/a")]))
      node (goo/node rex/zero_span "selection" arguments .nil)
      result (goo_panes/node published myth/new [0] node)
    [(testing/nat "S04 ambiguous bare subject seed is an explicit diagnostic" 1 (either/is_err result))]

+ tests
  ^ row[testing/case]
  [(testing/case "Typed creation seed diagnostic" pane_checks/seed_diagnostic)
   (testing/case "Retained local descriptions" frontend/goo_checks/local_descriptions)
   (testing/case "Goo lowering regression" frontend/goo_checks/lowering)
   (testing/case "Goo diagnostics regression" frontend/goo_checks/diagnostics)
   (testing/case "Goo registry regression" frontend/goo_checks/registry)
   (testing/case "Goo recursion regression" frontend/goo_checks/recursion)
   (testing/case "Selection capture and invocation retry" runtime/goo_runtime_checks/captures)
   (testing/case "Goo interaction dispatch" runtime/goo_runtime_checks/checks)
   (testing/case "Typed action invocation" runtime/goo_runtime_checks/handlers)]
