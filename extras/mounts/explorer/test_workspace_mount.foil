- goo_workspace_mount
- testing
- tests/namespace [at=ns_fixture]
- tests/overlay_cache [at=cache_fixture]

+ workspace_checks
  + manifest
    ^ str
    | "{""workspaces"":[{""name"":""reader"",""route"":""/reader"",""entry"":[""gov"",""reader"",""workspace""],""receiver"":{""slot"":[""gov"",""reader"",""source""],""initial"":[""lib""],""admission"":""namespace""},""shell"":{""title"":""<Reader>"",""breadcrumbs"":true,""navigation"":[[""System"",[""sys""]]]}}]}"
  + fixture
    ^ goo/published
    = field (goo/field "source" [($x 1) 'gov 'reader 'source] ['path] .false)
      view (goo/view rex/zero_span [($x 1) 'gov 'reader 'workspace] ['reader] ['workspace] "reader" .nil .true .nil)
      contract (grove_role_runtime/spec [] [[[($x 1) 'gov 'reader 'source]]])
    | goo/published view (list/one field) contract (./ok view)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = registration (goo_workspace_mount/decode ($x 1) workspace_checks/manifest).at(0)
      [nav_label nav_path] registration.navigation.at(0)
      published workspace_checks/fixture
      valid (goo_workspace_mount/validate_view registration published)
      wrong (goo_workspace_mount/validate_view registration.set_source_slot(['wrong]) published)
      object published.set_view(published.view.set_is_pane(.false))
      external published.set_view(published.view.set_ports((list/one[path] ['external])))
      html (str/from_atom (goo_workspace_mount/page registration registration.initial []))
      parent (axal/new[myth] .none).put(['child] myth/new)
      home=path [($x 1) 'io 'fs 'reader]
      state (cache_fixture/overlay_cache_tests/write registration.declaration
        (writ/make (myth/sing system_vocabulary/grove/view published)) ns_fixture/namespace_tests/initial)
      state (cache_fixture/overlay_cache_tests/write home (writ/make myth/new) state)
      saved (goo_workspace_mount/publish home workspace_checks/manifest state)
    [(testing/nat "local paths qualified" 1 (equal[path] registration.initial [($x 1) 'lib]))
     (testing/nat "sys paths absolute" 1 (equal[path] nav_path ['sys]))
     (testing/nat "entry contract accepted" 1 (either/is_ok valid))
     (testing/nat "wrong receiver rejected" 1 (either/is_err wrong))
     (testing/nat "ordinary view rejected" 1 (either/is_err (goo_workspace_mount/validate_view registration object)))
     (testing/nat "external selection port rejected" 1 (either/is_err (goo_workspace_mount/validate_view registration external)))
     (testing/nat "failed view rejected" 1 (either/is_err (goo_workspace_mount/validate_view registration published.set_result((goo/fail[goo/view] rex/zero_span "broken")))))
     (testing/nat "namespace admission permits intermediate node" 1 (maybe/is_none (goo_workspace_mount/admit registration parent)))
     (testing/nat "record admission rejects intermediate node" 1 (maybe/is_some (goo_workspace_mount/admit registration.set_record_only(.true) parent)))
     (testing/nat "missing subject rejected" 1 (maybe/is_some (goo_workspace_mount/admit registration (axal/new[myth] .none))))
     (testing/nat "shared shell escapes title" 1 (maybe/is_some (http_foot/find "&lt;Reader&gt;" html)))
     (testing/nat "shared shell supplies session assets" 1 (maybe/is_some (http_foot/find "/static/goo-workspace.js" html)))
     (testing/nat "shared shell uses configured route" 1 (maybe/is_some (http_foot/find "/reader?path=" html)))
     (testing/nat "registration committed with candidate" 1 (either/is_ok saved))
     (testing/nat "typed registration restored" 1 (goo_workspace_mount/registrations home (either/ok_val saved)).len)
     (testing/nat "missing entry blocks publication" 1 (either/is_err (goo_workspace_mount/publish home workspace_checks/manifest ns_fixture/namespace_tests/initial)))
     (testing/nat "queries cannot choose entry" 0 (goo_workspace_mount/query_valid "/reader?view=/arbitrary"))]

  + session_checks
    \ ignored=unit
    ^ row[testing/check]
    = registration (goo_workspace_mount/decode ($x 1) workspace_checks/manifest).at(0)
      endpoint (goo_workspace_mount/endpoint registration)
      root (goo_workspace/sessions ($x 1))
      first root.snoc(($u 1))
      second root.snoc(($u 2))
      third root.snoc(($u 3))
      reply=path [($x 1) 'request]
      card (myth/sing registration.source_slot (pails/p registration.initial))
      state (cache_fixture/overlay_cache_tests/write registration.initial (writ/make myth/new) ns_fixture/namespace_tests/initial)
      state (either/ok_val (goo_workspace/install endpoint goo_browser/talk state))
      state (cache_fixture/overlay_cache_tests/write reply (writ/make myth/new) state)
      allocate (myth/sing system_vocabulary/content (goo_workspace/allocation reply card))
      state (cache_fixture/overlay_cache_tests/write root (writ/poke allocate) state)
      record ((sovereign_care .x first state).fil.fall(myth/new))
      response ((sovereign_care .x reply state).fil.fall(myth/new))
      returned=path
        ?> (./some held) response.get(system_vocabulary/content) []
        ?> session=goo_workspace/session held []
        session.address
      state (cache_fixture/overlay_cache_tests/write root (writ/poke allocate) state)
      state (either/ok_val (goo_workspace/install endpoint goo_browser/talk state))
      state (cache_fixture/overlay_cache_tests/write root (writ/poke allocate) state)
      updated (myth/sing registration.source_slot (pails/p root))
      changed (cache_fixture/overlay_cache_tests/write first (writ/make updated) state)
      loaded (goo_browser/render_card first registration.declaration changed)
      removed (cache_fixture/overlay_cache_tests/write first (writ/cull) changed)
      catalog_record (myth/sing goo_browser/catalog_slot (goo_browser/index (list/one workspace_checks/fixture)))
      catalog (myth/sing overlay_cache/result_slot (overlay_cache/result (pin (axal/new[myth] (./some catalog_record)))))
      state (cache_fixture/overlay_cache_tests/write [($x 1) 'weft 'view_catalog_cache] (writ/make catalog) state)
      request=myth
        ?> (./wait record) (goo_workspace/request endpoint (http_foot/request "GET" "/reader" "") 0) myth/new
        record.put(limb_slot (kook [[($x 1) 'kook 'hex]]))
      state (cache_fixture/overlay_cache_tests/write reply (writ/make request) state)
      state (cache_fixture/overlay_cache_tests/write reply (writ/poke myth/new) state)
      completed ((sovereign_care .x reply state).fil.fall(myth/new))
      body (str/from_atom (completed.nat_at(['res_body] 0)))
    [(testing/nat "context allocated under numeric session ID" 1 (equal record card))
     (testing/nat "allocation returns stored address" 1 (equal returned first))
     (testing/nat "second context is distinct" 1 (maybe/is_some (sovereign_care .x second state).fil))
     (testing/nat "reinstall preserves session sequence" 1 (maybe/is_some (sovereign_care .x third state).fil))
     (testing/nat "render reads edited context" 1 (equal loaded (either/ok[str myth] updated)))
     (testing/nat "deleted context is not reconstructed" 1 (either/is_err (goo_workspace/receiver endpoint first removed)))
     (testing/nat "ordinary target cannot impersonate context" 1 (either/is_err (goo_workspace/receiver endpoint registration.initial state)))
     (testing/nat "foreign session rejected" 1 (either/is_err (goo_workspace/receiver endpoint [($x 2) 'goo 'ses ($u 1)] state)))
     (testing/nat "text session ID rejected" 1 (either/is_err (goo_workspace/receiver endpoint root.snoc('one) state)))
     (testing/nat "workspace request completes after allocation" 200 (completed.nat_at(['res_status] 0)))
     (testing/nat "workspace hydration addresses context" 1 (maybe/is_some (str/find (str/cat_all ["data-target=""" (path_show root.snoc(($u 4))) """ "]) body)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Declarative workspace host" workspace_checks/checks)
   (testing/case "Stored workspace contexts" workspace_checks/session_checks)]
