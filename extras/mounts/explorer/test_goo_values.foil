- goo_values
- goo_browser
- tests/namespace [at=fixture]
- tests/overlay_cache [at=cache]
- testing

+ value_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 1) 'editable]
      title=path system_vocabulary/lede
      count=path ['count]
      original (myth/sing title (pails/t "Before")).put(count (pails/n 5))
      state (cache/overlay_cache_tests/write target (writ/make original) fixture/namespace_tests/initial)
      version (state.case(.x target)).fall(0)
      edited (goo_value/edit target title version "text" "After <&>" [] state)
      next (either/ok_val edited)
      current ((sovereign_peek target next).fil.fall(myth/new))
      stale (goo_value/edit target count version "number" "6" [] next)
      invalid (goo_value/edit target count version "number" "bad" [] state)
      types=goo_reflection/registry (mop/empty)
      html (either/ok_val (goo_values/html goo_bridge/initial_context target original types (mop/empty)))
      fallback (either/ok_val (goo_values/html goo_bridge/initial_context target
        (myth/sing title (lore "" ["Body"] [])) types (mop/empty)))
      query (goo_runtime/request "edit-value" target target [] [] version 0 0
        [["slot" (path_show title)] ["kind" "text"] ["value" "HTTP edit"]] 0)
      [changed status response] (goo_runtime/run query state)
      portable (either/ok_val (goo_browser/render_result goo_bridge/initial_context target goo_reflection/slot [] [] [] .none state))
      gallery (either/ok_val (goo_browser/render_result goo_bridge/initial_context target [] goo_browser/views_slot [] [] .none state))
    [(testing/nat "writable Values retain browser display boundary" 1 (equal (grove_dev/field "display" portable) (json/nul 0)))
     (testing/nat "writable Values expose prepared read-only display" 1 (equal (grove_dev/field "version" (grove_dev/field "readOnlyDisplay" portable)) (json/num .false 1)))
     (testing/nat "portable Values grant no domain controls" 0 (grove_dev/items (grove_dev/field "controls" portable)).len)
     (testing/nat "typed text edit commits" 1 (either/is_ok edited))
     (testing/text "full text survives editing" "After <&>" (current.txt_at(title)))
     (testing/nat "unrelated slots preserved" 5 (current.nat_at(count 0)))
     (testing/nat "stale record version rejected" 1 (either/is_err stale))
     (testing/nat "invalid number rejected" 1 (either/is_err invalid))
     (testing/nat "wrong input type rejected" 1 (either/is_err (goo_value/edit target count version "text" "wrong" [] state)))
     (testing/nat "system publication remains read only" 1 (either/is_err (goo_value/edit ['sys 'about] title 1 "text" "wrong" [] state)))
     (testing/nat "unknown slot cannot be accidentally created" 1 (either/is_err (goo_value/edit target ['missing] version "text" "wrong" [] state)))
     (testing/nat "editor exposes slot binding" 1 (maybe/is_some (str/find "data-goo-value=" html)))
     (testing/nat "editor offers Foil fallback" 1 (maybe/is_some (str/find "Foil expression" fallback)))
     (testing/nat "supervisor edit dispatch succeeds" 200 status)
     (testing/text "dispatch updates stored title" "HTTP edit" ((sovereign_peek target changed).fil.fall(myth/new)).txt_at(title))
     (testing/nat "views slot renders a presentation host" 1 (maybe/is_some (str/find "/goo-views?path=" (grove_dev/text (grove_dev/field "html" gallery)))))]

+ tests
  ^ row[testing/case]
  [(testing/case "Editable namespace values" value_checks/checks)]
