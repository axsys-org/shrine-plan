- system_vocabulary
- goo_bridge
- show

' Read-only synthetic presentations. Descriptors are keyed by exact brand,
' including the definition moment. Unknown brands use the bounded value printer
' without being cast as a newer definition.
+ goo_reflection
  + slot
    ^ path
    ['sys 'slot 'synthetic]
  + registry
    mop[nat type lt]
  + register
    \ table=goo_reflection/registry shape=type
    ^ goo_reflection/registry
    ? shape
     > (./rec brand fields)
      ? brand table.put(brand shape) table
     > (./gen parameters body) (goo_reflection/register table body)
     > (./sum variants) (row/fold[type goo_reflection/registry] table goo_reflection/register variants)
    table
  + types
    \ tree=axal[myth]
    ^ goo_reflection/registry
    | tree.tap.fold (mop/empty)
      \ out [name card]
      ?> (./some held) card.get(system_vocabulary/mold) out
      ?> descriptor=pails/ty held out
      | goo_reflection/register out descriptor.t
  + display_text
    ' Goo's current measurer accepts ASCII. Preserve other UTF-8 bytes as
    ' visible escapes instead of rejecting an entire object preview.
    \ text=str
    ^ str
    % i=nat 0 out=list[str] .nil
    ^ str
    ? (eq i text.len) (str/cat_all out.row)
    ? (eq i 512) (str/cat_all out.snoc(" [more text in Objects]").row)
    = byte text.at(i)
      safe ((eq byte 9) || ((eq byte 10) || ((eq byte 13) || (and (ge byte 32) (le byte 126)))))
      part=str
        ? safe text.slice(i 1)
        | str/cat_all [(str/from_atom 92) "x"
            "0123456789abcdef".slice((div byte 16) 1)
            "0123456789abcdef".slice((mod byte 16) 1)]
    | _ i.inc out.snoc(part)
  + text
    \ role=str text=str
    ^ goo/source
    | goo/source/text (goo_bridge/attrs rex/zero_span role goo/config/empty) (goo/text/en (goo_reflection/display_text text))
  + group
    \ label=str children=list[goo/source]
    ^ goo/source
    | goo/source/flow (goo_bridge/attrs rex/zero_span "col" goo/config/empty)
        (goo/direction/col) children.cons((goo_reflection/text "label" label))
  + limit
    \ count=nat
    ^ nat
    ? (lt count 24) count 24
  + width
    \ count=nat budget=nat
    ^ nat
    = count (goo_reflection/limit count)
    ? (lt budget count) budget count
  + share
    \ budget=nat count=nat
    ^ nat
    | div budget (? count count 1)
  + scalar
    \ value=any
    ^ maybe[str]
    ? value
     > x=pails/t (./some x.t)
     > x=pails/n (./some (nat/show x.n))
     > x=pails/z (./some (str/cat_all ["-" (nat/show x.n)]))
     > x=pails/b (./some (? x.b "true" "false"))
     > x=pails/p (./some (path_show x.p))
     > x=pails/dm (./some (temporal/timestamp ($dm x.n)))
     > x=pails/ds (./some (temporal/timestamp ($ds x.n)))
     > x=pails/dr (./some (temporal/duration x.n))
     > x=pails/ty (./some (str/from_atom (tyshow/show x.t)))
    .none
  + leaf
    \ text=str
    ^ goo/source
    | goo_reflection/text "body" text
  + lore_source
    ' Lore's text aliases and example pairs have known structure; do not
    ' fall back to raw representation when nested alias molds are absent.
    \ doc=lore budget=nat
    ^ goo/source
    = line_count (goo_reflection/width doc.body.len (goo_reflection/share budget 2))
      example_count (goo_reflection/width doc.tests.len (goo_reflection/share budget 4))
      body=list[goo/source]
        | (list/range 0 line_count).map (\ i (goo_reflection/leaf doc.body.at(i)))
      body (? (gt doc.body.len line_count) body.snoc((goo_reflection/leaf "[more lines in Documentation]")) body)
      examples=list[goo/source]
        | (list/range 0 example_count).map
          \ i
          = [source expected] doc.tests.at(i)
          | goo_reflection/group (str/cat_all ["Example " (nat/show i.inc)])
              (list/one (goo_reflection/group "Source" (list/one (goo_reflection/leaf source)))).snoc(
                (goo_reflection/group "Expected result" (list/one (goo_reflection/leaf expected))))
      examples (? (gt doc.tests.len example_count) examples.snoc((goo_reflection/leaf "[more examples in Documentation]")) examples)
      children=list[goo/source] .nil
      children (? doc.head.len children.snoc((goo_reflection/group "Heading" (list/one (goo_reflection/leaf doc.head)))) children)
      children (? doc.body.len children.snoc((goo_reflection/group "Body" body)) children)
      children (? doc.tests.len children.snoc((goo_reflection/group "Examples (authored, not executed)" examples)) children)
    | goo_reflection/group "Lore" (? children.is_nil (list/one (goo_reflection/leaf "Empty documentation")) children)
  + value
    \ types=goo_reflection/registry hint=type value=any depth=nat budget=nat
    ^ goo/source
    ? ((eq depth 0) || (eq budget 0)) (goo_reflection/leaf "[expand in Objects]")
    ? (rep_law value) (goo_reflection/leaf "[function]")
    ? value
     > doc=lore (goo_reflection/lore_source doc budget)
    ? (goo_reflection/scalar value)
     > (./some text) (goo_reflection/leaf text)
    ? (rep_pin value)
      = inner=type
          ? hint
           > (./pin inner) inner
          .any
      | goo_reflection/value types inner (rep_unpin value) depth.dec budget.dec
    = identity (nominal_brand value)
      shape=type
        ? identity
          ? types.get(identity)
           > (./some shape) shape
          hint
        ? hint
         > (./ref brand arguments) types.gut(brand hint)
        hint
    ? shape
     > (./rec brand fields)
      ? (and (eq brand (rep_hd value)) (eq fields.len (rep_sz value)))
        = children=list[goo/source]
            | (list/range 0 (goo_reflection/width fields.len budget)).map
              \ i
              = [face kind] fields.at(i)
                label (? (eq face i) (nat/show i) (str/from_atom face))
              | goo_reflection/group label (list/one
                  (goo_reflection/value types kind (rep_ix i value) depth.dec (goo_reflection/share budget.dec (goo_reflection/width (rep_sz value) budget))))
          children (? (gt fields.len (goo_reflection/width fields.len budget)) children.snoc((goo_reflection/leaf "[more fields]")) children)
        | goo_reflection/group (? brand (goo_reflection/type_name brand) "Record") children
      | goo_reflection/unknown value
     > (./arr item)
      ? ((eq value 0) || (and (rep_app value) (eq (rep_hd value) 0)))
        | goo_reflection/array types item value depth budget
      | goo_reflection/unknown value
     > (./nat aura)
      ? !(rep_app value)
        | goo_reflection/leaf (nat/show value)
      | goo_reflection/unknown value
     > (./ref brand arguments)
      ? (and (eq brand (show/brand (^ str))) !(rep_app value))
        | goo_reflection/leaf (str/from_atom value)
      ? (and (eq brand (show/brand (^ nat))) !(rep_app value))
        | goo_reflection/leaf (nat/show value)
      ? (and (eq brand (show/brand (^ bool))) ((eq value 0) || (eq value 1)))
        | goo_reflection/leaf (? (eq value 1) "true" "false")
      | goo_reflection/unknown value
    ? (and (rep_app value) (eq (rep_hd value) 0))
      | goo_reflection/array types (^ any) value depth budget
    | goo_reflection/unknown value
  + type_name
    \ identity=nat
    ^ str
    ?> (./some reference) (brand_decode identity) "Unknown type"
    = [path version] reference
      parts=list[str]
        | path.stream.map
          \ part
          ? (eq (aura_tag part) "ts") (str/from_atom (quip_val part))
          | str/from_atom (iota_show part)
    | str/cat_all ["/" (str/join "/" parts.row) "@x" (nat/show version)]
  + unknown
    ' Preserve the exact brand and show positional contents when field
    ' descriptors are unavailable. The value printer bounds depth and width.
    \ value=any
    ^ goo/source
    | goo_reflection/leaf (str/from_atom (show/value value 0))
  + array
    \ types=goo_reflection/registry item=type value=any depth=nat budget=nat
    ^ goo/source
    = size (rep_sz value)
      children=list[goo/source]
        | (list/range 0 (goo_reflection/width size budget)).map
          \ i
          | goo_reflection/group (nat/show i) (list/one
              (goo_reflection/value types item (rep_ix i value) depth.dec (goo_reflection/share budget.dec (goo_reflection/width (rep_sz value) budget))))
      children (? (gt size (goo_reflection/width size budget)) children.snoc((goo_reflection/leaf "[more items]")) children)
    | goo_reflection/group (str/cat_all ["Collection (" (nat/show size) ")"]) children
  + source
    \ types=goo_reflection/registry card=myth titles=mop[path str lt_pith]
    ^ goo/source
    = slots=list[mop/kv[path pail]] card.tap.stream.take(64)
      entries=list[goo/source]
        | slots.map
          \ entry
          = children (list/one (goo_reflection/value types (^ any) entry.val 5 (goo_reflection/share 256 slots.len)))
            label=goo/source
              ?> (./some title) titles.get(entry.key)
                | goo_bridge/path_source rex/zero_span "label" goo/config/empty entry.key
              | goo_reflection/text "label" title
          | goo/source/flow (goo_bridge/attrs rex/zero_span "col" goo/config/empty) (goo/direction/col)
              children.cons(label)
      entries (? (gt card.size 64) entries.snoc((goo_reflection/leaf "[more slots in Objects]")) entries)
    | goo/source/flow (goo_bridge/attrs rex/zero_span "col" goo/config/empty)
        (goo/direction/col) (? entries.is_nil (list/one (goo_reflection/leaf "Empty object")) entries)
  + slot_titles
    ' Resolve each displayed key's title from the same namespace snapshot.
    \ card=myth state=namespace
    ^ mop[path str lt_pith]
    | card.tap.stream.take(64).fold (mop/empty)
      \ titles entry
      ?> (./some definition) (sovereign_peek entry.key state).fil titles
      ?> (./some held) definition.get(system_vocabulary/lede) titles
      ?> title=pails/t held titles
      ? title.t.len titles.put(entry.key title.t)
      titles
  + compile_with_titles
    \ context=goo_bridge/render_context target=path types=goo_reflection/registry card=myth titles=mop[path str lt_pith]
    ^ either[str goo_bridge/compilation]
    | goo_bridge/compile_source context (goo_reflection/source types card titles)
        (str/cat_all [(path_show target) ":synthetic"]) goo_reflection/slot
  + prepare_with_titles
    \ context=goo_bridge/render_context target=path types=goo_reflection/registry card=myth titles=mop[path str lt_pith]
    ^ either[str goo_html_internal/prepared]
    < compiled (goo_reflection/compile_with_titles context target types card titles)
    | ./ok compiled.prepared
  + prepare
    \ context=goo_bridge/render_context target=path types=goo_reflection/registry card=myth
    ^ either[str goo_html_internal/prepared]
    | goo_reflection/prepare_with_titles context target types card (mop/empty)
  + render
    ' Initial document fallback; live inspection supplies the actual context.
    \ target=path types=goo_reflection/registry card=myth
    ^ either[str str]
    < prepared (goo_reflection/prepare goo_bridge/initial_context target types card)
    | ./ok (goo_html/fragment prepared)
