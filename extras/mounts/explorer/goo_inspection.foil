- goo_reflection
- http_foot

' A browser observation is data, never namespace evidence or an action handle.
' This read-only formatter has no namespace argument and cannot dispatch effects.
+ goo_inspection
  + subject
    : path=pails/p writable_receiver=pails/p lifetime=str displayed_case=str
      action_case=str projection_epoch=str
  + recipe
    : path=pails/p role=str slot=str publication_case=str kind=str
      node_route=str source_line=nat source_column=nat
  + preparation
    : layout=str width=str height=str text_scale=str direction=str
      profile=str profile_revision=str nodes=nat
  + encounter
    : session=str revision=nat owner=str incarnation=nat encounter=str
      generation=nat selection=str pending=bool dirty_inputs=nat composing_inputs=nat live=bool
  + capture
    : id=str parent=str provenance=str
  + card
    \ fields=row[[str str]]
    ^ either[str myth]
    = get (\ key=str (http_foot/field key fields))
      allowed=row[str]
        ["capture" "parent" "subject" "target" "life" "displayed" "expected" "projectionSeq"
         "view" "role" "slot" "publication" "kind" "node" "line" "column"
         "layout" "renderWidth" "renderHeight" "renderScale" "renderDirection" "profile" "profileRevision" "nodes"
         "session" "revision" "owner" "incarnation" "encounter" "generation" "selection"
         "pending" "dirty" "composing" "live" "width" "textScale" "direction"]
    ? ((gt fields.len allowed.len) || !(fields.all((\ [key value] (and (allowed.has(key)) (le value.len 4096))))))
      | ./err "Invalid inspection fields."
    ? !(fields.all((\ [key value] (eq (fields.keep((\ [other ignored] (eq key other)))).len 1))))
      | ./err "Duplicate inspection field."
    ? (eq (get "capture").len 0) (./err "Missing capture identity.")
    ?> (./some subject) (path_parse (get "subject")) (./err "Invalid observed subject.")
    ?> (./some target) (path_parse (get "target")) (./err "Invalid observed receiver.")
    ?> (./some view) (path_parse (get "view")) (./err "Invalid observed recipe.")
    = numbers=row[str] ["line" "column" "nodes" "revision" "incarnation" "generation" "dirty" "composing"]
      number (\ key=str (nat/parse (get key)).fall(0))
    ? !(numbers.all((\ key (maybe/is_some (nat/parse (get key))))))
      | ./err "Invalid inspection counter."
    = flags=row[str] ["pending" "live"]
    ? !(flags.all((\ key ((eq (get key) "true") || (eq (get key) "false")))))
      | ./err "Invalid inspection flag."
    = slot (\ name=str ((system_vocabulary/locate ['goo 'inspection]).snoc(($ts name))))
      card (myth/sing (slot "capture") (goo_inspection/capture (get "capture") (get "parent")
        "Browser capture of installed render metadata and local state; not a fresh namespace read or replayable authority."))
      card card.put((slot "subject") (goo_inspection/subject (pails/p subject) (pails/p target) (get "life") (get "displayed") (get "expected") (get "projectionSeq")))
      card card.put((slot "recipe") (goo_inspection/recipe (pails/p view) (get "role") (get "slot") (get "publication") (get "kind") (get "node") (number "line") (number "column")))
      card card.put((slot "preparation") (goo_inspection/preparation (get "layout") (get "renderWidth") (get "renderHeight") (get "renderScale") (get "renderDirection") (get "profile") (get "profileRevision") (number "nodes")))
      card card.put((slot "encounter") (goo_inspection/encounter (get "session") (number "revision") (get "owner") (number "incarnation") (get "encounter") (number "generation") (get "selection") (eq (get "pending") "true") (number "dirty") (number "composing") (eq (get "live") "true")))
    | ./ok card
  + prepare
    \ context=goo_bridge/render_context fields=row[[str str]]
    ^ either[str json]
    < card (goo_inspection/card fields)
    = types (goo_reflection/register (mop/empty) (^ goo_inspection/capture))
      types (goo_reflection/register types (^ goo_inspection/subject))
      types (goo_reflection/register types (^ goo_inspection/recipe))
      types (goo_reflection/register types (^ goo_inspection/preparation))
      types (goo_reflection/register types (^ goo_inspection/encounter))
    < prepared (goo_reflection/prepare context [] types card)
    ?> (./some display) (goo_prepared/encode prepared) (./err "Inspection display failed validation.")
    | ./ok (json/obj [(jkv "version" (json/num .false 1)) (jkv "ok" (json/boo .true))
        (jkv "capture" (json/str (http_foot/field "capture" fields)))
        (jkv "kind" (json/str "inspection")) (jkv "view" (json/str (path_show goo_reflection/slot)))
        (jkv "slot" (json/str (path_show goo_reflection/slot))) (jkv "role" (json/str ""))
        (jkv "profile" (goo_profile/metadata unit/unit)) (jkv "context" (goo_bridge/context_json context))
        (jkv "display" display) (jkv "html" (json/str (goo_html/fragment prepared))) (jkv "controls" (json/arr []))])
