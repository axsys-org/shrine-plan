- goo_runtime
- temporal
- grove_view_publication
- goo_app/compile
- goo_app/html

' Bind the Grove expression template to an object before entering Goo v2.
+ goo_bridge
  + surface
    ' Grove normalizes empty-rune brackets; the v2 literal reader uses Expr.
    \ tree=rex
    ^ rex
    | tree.walk
      \ node=rex
      ? node
       > (./nest span color rune kids)
        ? (eq rune "") (rex/expr span color kids)
        node
      node
  + receiver_node
    ' Bind display identity only at the host boundary, without adding a fake
    ' slot to the receiver or changing its role/action evidence. present/pane
    ' expansion has already substituted the enclosing binding into these nodes.
    \ binding=str target=path node=goo/node
    ^ goo/node
    = node node.set_children(node.children.map((goo_bridge/receiver_node binding target)))
    ? !(and (eq node.constructor "path") (gt node.arguments.len 0)) node
    = value node.arguments.head
    ?> (./leaf _ _ name) value node
    ? !(and (equal value.leaf_kind (maybe/some[str] "word")) (eq name binding)) node
    | node.set_arguments(node.arguments.tail.cons((rex/quip (str/cat_all ["'" (path_show target)]))))
  + receiver
    \ target=path published=goo/published
    ^ goo/published
    = bind
        \ view=goo/view
        | view.set_children(view.children.map((goo_bridge/receiver_node view.binding target)))
      result=either[grove/error goo/view]
        ? published.result
         > (./ok view) (./ok (bind view))
         > (./err error) (./err error)
    | published.set_view((bind published.view)).set_result(result)
  + path_text
    ' Preserve every path byte within the current ASCII measurement contract.
    ' This spelling is display-only; receiver identity remains the typed path.
    \ value=path
    ^ str
    = text (path_show value)
    % i=nat 0 out=list[str] .nil
    ^ str
    ? (eq i text.len) (str/cat_all out.row)
    = byte text.at(i)
      part=str
        ? (and (ge byte 32) (le byte 126)) text.slice(i 1)
        | str/cat_all [(str/from_atom 92) "x"
            "0123456789abcdef".slice((div byte 16) 1)
            "0123456789abcdef".slice((mod byte 16) 1)]
    | _ i.inc out.snoc(part)
  + path_source
    ' Path is a Goo leaf formatter. Layout/escaping remain in the ordinary
    ' server text pipeline, shared by authored views and synthetic slot labels.
    \ span=rex/source_span slot=str config=goo/config value=path
    ^ goo/source
    | goo/source/text (goo_bridge/attrs span slot config) (goo/text/en (goo_bridge/path_text value))
  + value
    \ published=goo/published card=myth expression=rex
    ^ maybe[pail]
    ? expression
     > (./leaf span shape text)
      ? (equal expression.leaf_kind (maybe/some[str] "cord"))
        | ./some (pails/t text)
      ? (equal expression.leaf_kind (maybe/some[str] "quip"))
        < path (path_parse text.slice(1 (dec text.len)))
        | ./some (pails/p path)
      .none
     > (./nest span color rune kids)
      ? !(and (eq rune ".") (eq kids.len 2)) .none
      ? !(equal kids.at(0).leaf_kind (maybe/some[str] "word")) .none
      ?> (./leaf at shape binding) kids.at(0) .none
      ? !(eq binding published.view.binding) .none
      ?> (./leaf at shape name) kids.at(1) .none
      = fields (published.fields.keep((\ field (eq field.name name))))
      ? !(eq fields.len 1) .none
      | card.get fields.at(0).slot
    ? (goo_read/text (goo_bridge/surface expression))
     > (./ok text) (./some (pails/t text))
     > (./err _) .none
  + evaluate
    \ published=goo/published card=myth expression=rex
    ^ either[str maybe[pail]]
    = result (goo_bridge/value published card expression)
    ? (maybe/is_some result) (./ok result)
    ?> (./nest span color rune kids) expression
      | ./err "Unsupported Goo value expression."
    ? !(and (eq rune ".") (eq kids.len 2))
      | ./err "Unsupported Goo value expression."
    ?> (./leaf at shape binding) kids.at(0)
      | ./err "Nested receiver expressions are not implemented by the Grove binding stage."
    ?> (./leaf at shape name) kids.at(1)
      | ./err "Expected a receiver field name."
    ? !(eq binding published.view.binding) (./err "Unbound Goo receiver.")
    ? !((published.fields).any((\ field (eq field.name name))))
      | ./err "Unknown Goo receiver field."
    | ./ok .none
  + text
    \ value=pail
    ^ either[str str]
    ? value
     > value=pails/dm (./ok (temporal/timestamp ($dm value.n)))
     > value=pails/ds (./ok (temporal/timestamp ($ds value.n)))
     > value=pails/dr (./ok (temporal/duration value.n))
     > value=pails/t (./ok value.t)
     > value=pails/n (./ok (nat/show value.n))
     > value=pails/p (./ok (path_show value.p))
     > value=pails/b (./ok (? value.b "true" "false"))
    | ./err "No Goo v2 value formatter for this field."
  + formatted
    \ kind=str value=pail
    ^ either[str str]
    ? value
     > number=pails/n
      ? (equal kind "time") (./ok (temporal/timestamp ($dm number.n)))
      ? (equal kind "duration") (./ok (temporal/duration number.n))
      | goo_bridge/text value
    | goo_bridge/text value
  + formatted_runs
    \ kind=str value=pail
    ^ either[str goo/text]
    ? value
     > rich=goo/text/pail
      ? (eq kind "image") (./err "Image sources cannot contain text runs.")
      | ./ok rich.value
    < text (goo_bridge/formatted kind value)
    | ./ok (goo/text/en text)
  + role
    ' Exact compatibility aliases only; unknown namespace slots stay opaque.
    \ path=path
    ^ str
    = aliases=row[[str str]]
        [["/sys/slot/title" "title"] ["/sys/slot/content" "body"]
         ["/sys/slot/label" "label"] ["/sys/slot/summary" "summary"]
         ["/sys/slot/caption" "caption"] ["/sys/slot/icon" "icon"]]
      text (path_show path)
      found (aliases.keep((\ [key value] (eq key text))))
    ? found.len
      = [key value] found.at(0)
      value
    | goo_read/alias text
  + context
    \ path=path
    ^ goo/compile_context
    = text (path_show path)
      text=str
        ? (eq text "/sys/slot/label") "/sys/slots/label"
        ? (eq text "/sys/slot/summary") "/sys/slots/summary"
        ? (eq text "/sys/slot/scar") "/sys/slots/scar"
        text
    | goo/compile_context (goo/path/trusted text)
  + attrs
    \ span=rex/source_span slot=str config=goo/config
    ^ goo/source_attrs
    | goo/source_attrs (goo/common (goo/slot slot) (goo/rank/required)
        config (goo/loc/make span.line (? (eq span.column 0) 1 span.column)))
  + slot
    \ published=goo/published card=myth expression=rex
    ^ either[str str]
    ? (goo_bridge/value published card expression)
     > (./some held)
      ? held
       > value=pails/p (./ok (goo_bridge/role value.p))
       > value=pails/t (./ok value.t)
      | ./err "Goo slot argument must be a path or a v2 slot literal."
    = absolute=bool
        ? expression
         > (./nest _ _ rune _) (eq rune "/")
        .false
    ? absolute
      ? (grove_roles/parts (rex/normalize expression))
       > (./ok path) (./ok (goo_bridge/role path))
       > (./err _) (./err "Invalid absolute Goo slot path.")
    ? (goo_read/slot expression)
     > (./ok slot) (./ok slot)
     > (./err diagnostic) (./err diagnostic.message)
  + nodes
    \ published=goo/published card=myth nodes=list[goo/node]
    ^ either[str list[goo/source]]
    ? (eq nodes.len 0) (./ok .nil)
    < head (goo_bridge/node published card nodes.at(0))
    < tail (goo_bridge/nodes published card nodes.drop(1))
    | ./ok head.weld(tail)
  + named
    \ expression=rex
    ^ bool
    ? expression
     > (./nest _ _ rune _) (eq rune "=")
    .false
  + input_default
    \ value=rex
    ^ maybe[str]
    ? (equal[maybe[str]] value.leaf_kind (./some "cord"))
      ?> (./leaf _ _ text) value .none
      | ./some text
    % rest=row[rex] value.children
    ^ maybe[str]
    ? (eq rest.len 0) .none
    ? (goo_bridge/input_default rest.at(0))
     > (./some text) (./some text)
    | _ rest.drop(1)
  + creation_inputs
    ' Render creation inputs from their declared defaults, not anchor slots.
    ' Other expressions continue to use the ordinary enclosing receiver.
    \ fields=list[rex] nodes=list[goo/node]
    ^ list[goo/node]
    | nodes.map
      \ node=goo/node
      = children (goo_bridge/creation_inputs fields node.children)
      ? !(eq node.constructor "input") node.set_children(children)
      ? (eq node.arguments.len 0) node
      = slot (goo_runtime/read_path node.arguments.head)
        default=str
          % rest=list[rex] fields
          ^ str
          ? rest.is_nil ""
          ?> (./nest _ _ rune kids) rest.head (_ rest.tail)
          ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
          ? !(equal[maybe[path]] slot (goo_runtime/read_path kids.at(0))) (_ rest.tail)
          | (goo_bridge/input_default kids.at(1)).fall("")
      | node.set_arguments(node.arguments.tail.cons((rex/cord default)))
  + node
    \ published=goo/published card=myth node=goo/node
    ^ either[str list[goo/source]]
    = kind node.constructor
      args node.arguments.map(goo_bridge/surface)
      has_config=bool (? args.len (goo_read/record args.at(0)) .false)
      config=either[str goo/config]
        ? !has_config (./ok goo/config/empty)
        ?> (./ok fields) (goo_read/config args.at(0))
          | ./err "Invalid Goo v2 configuration record."
        ?> (./some config) (goo_codec/config fields)
          | ./err "Invalid Goo v2 configuration values."
        | ./ok config
      args=list[rex] (? has_config args.drop(1) args)
    < config config
    ? (eq kind "or")
      % rest=list[goo/node] node.children
      ^ either[str list[goo/source]]
      ? (eq rest.len 0) (./ok .nil)
      < child (goo_bridge/node published card rest.at(0))
      ? child.len (./ok child)
      | _ rest.drop(1)
    ? (eq kind "present")
      < children (goo_bridge/nodes published card node.children)
      < slot (goo_bridge/slot published card args.at(1))
      | ./ok (list/one (goo/source/group (goo_bridge/attrs node.span slot config) children))
    = containers=row[str] ["group" "row" "col" "flow" "stack" "opt"]
    ? containers.has(kind)
      = children=list[goo/node]
          ? (maybe/is_none (goo_runtime/named "make" node.arguments)) node.children
          = fields (goo_runtime/named "myth" node.arguments).run(goo_runtime/fields).fall(.nil)
          | goo_bridge/creation_inputs fields node.children
      < children (goo_bridge/nodes published card children)
      = slot=either[str str]
          ? ((eq kind "opt") || (eq args.len 0)) (./ok kind)
          ? (and (eq kind "group") (goo_bridge/named args.at(0))) (./ok kind)
          | goo_bridge/slot published card args.at(0)
      < slot slot
      = attrs (goo_bridge/attrs node.span slot config)
      ? (eq kind "opt")
        = rank=maybe[goo/rank]
            ? (eq args.len 0) (./some (goo/rank/compact))
            ?> (./ok number) (goo_read/scalar args.at(0)) .none
            | goo_codec/rank number
        ?> (./some rank) rank (./err "opt requires rank 1 or 2.")
        ? (eq rank.to_nat 0) (./err "opt requires rank 1 or 2.")
        | ./ok (list/one (goo/source/opt attrs rank children))
      ? (eq kind "group") (./ok (list/one (goo/source/group attrs children)))
      = direction=goo/direction
          ? ((eq kind "col") || (eq kind "stack")) (goo/direction/col)
          (goo/direction/row)
      | ./ok (list/one (goo/source/flow attrs direction children))
    ? (eq kind "input")
      ? ((eq args.len 0) || (gt args.len 2)) (./err "input requires a value or slot path, with an optional role.")
      ?> (./some held) (goo_bridge/value published card args.at(0))
        | ./err "input requires a literal value or absolute slot path."
      = content=either[str goo/text]
          ? held
           > slot=pails/p
            ? card.get(slot.p)
             > (./some value) (goo_bridge/formatted_runs "text" value)
             > ./none (./ok (goo/text/en ""))
           > value=pails/t (./ok (goo/text/en value.t))
          | ./err "input requires a literal value or absolute slot path."
        role=either[str str]
          ? (eq args.len 1) (./ok "input")
          | goo_bridge/slot published card args.at(1)
      < content content
      < role role
      = rich=bool
          ?> slot=pails/p held .false
          ?> (./some value) card.get(slot.p) .false
          ?> value=goo/text/pail value .false
          .true
      | ./ok (list/one (goo/source/jet (goo_bridge/attrs node.span (? rich "rich-input" role) config) (goo/primitive/input content)))
    ? (eq kind "path")
      ? (has_config || (eq args.len 0) || (gt args.len 2) || (gt node.children.len 0))
        | ./err "path requires a receiver or path value, an optional slot, and no children."
      < value (goo_bridge/evaluate published card args.head)
      ?> (./some value) value (./ok .nil)
      ?> value=pails/p value (./err "path requires a path-typed value.")
      = slot=either[str str]
          ? (eq args.len 1) (./ok "body")
          | goo_bridge/slot published card args.at(1)
      < slot slot
      | ./ok (list/one (goo_bridge/path_source node.span slot config value.p))
    = scalars=row[str] ["text" "link" "number" "time" "duration" "boolean"]
      primitive (goo/primitive_kind/parse (? (eq kind "action") "button" kind))
    ? !((scalars.has(kind)) || ((eq kind "image") || (maybe/is_some primitive)))
      | ./err (str/cat_all ["No Goo v2 constructor mapping for " kind "."])
    ? (eq args.len 0) (./err "Goo leaf requires a value.")
    < evaluated (goo_bridge/evaluate published card args.at(0))
    ?> (./some value) evaluated (./ok .nil)
    < text (goo_bridge/formatted_runs kind value)
    = slot=either[str str]
        ? ((eq kind "action") || (eq args.len 1))
          | ./ok (? (maybe/is_some primitive) (? (eq kind "action") "action" kind) "body")
        | goo_bridge/slot published card args.at(1)
    < slot slot
    = attrs (goo_bridge/attrs node.span slot config)
    ? (eq kind "image") (./ok (list/one (goo/source/image attrs text.plain)))
    ? primitive
     > (./some primitive) (./ok (list/one (goo/source/jet attrs (goo/primitive/make primitive text))))
     > ./none (./ok (list/one (goo/source/text attrs text)))
  + source
    \ published=goo/published card=myth view=goo/view
    ^ either[str goo/source]
    < children (goo_bridge/nodes published card view.children)
    ' A Grove body is a sequence; give v2 the single root it requires.
    | ./ok (goo/source/flow (goo_bridge/attrs view.span "col" goo/config/empty)
        (goo/direction/col) children)
  + semantic
    \ published=goo/published card=myth view=goo/view
    ^ either[str maybe[goo/semantic]]
    < source (goo_bridge/source published card view)
    ?> (./ok core) (goo_pass/normalize source)
      | ./err "Unable to normalize Goo v2 source."
    = ids=list[goo/node_id]
        | (list/range 0 (goo_pass/count core)).map
        \ index
        | goo/node_id (str/cat_all [(path_show view.name) ":" (nat/show index)])
      normalized (goo_pass/assign core ids 0).tree
      options (goo_pass/options (goo_bridge/context view.slot))
      visible (goo_pass/visibility options normalized)
    | ./ok (goo_compile/semantic .false visible)
  + render_context
    : width=goo/scalar scale=goo/scalar rtl=bool pipeline=bool
  + initial_context
    ' Initial document fallback only. Live requests supply their measured context.
    ^ goo_bridge/render_context
    | goo_bridge/render_context (goo_fp/integer 720) (goo_fp/integer 1) .false .false
  + compilation
    : prepared=goo_html_internal/prepared stages=row[json]
  + compile_source
    ' Capture the same pass values used by this preparation, only when requested.
    \ context=goo_bridge/render_context source=goo/source prefix=str slot=path
    ^ either[str goo_bridge/compilation]
    ?> (./ok core) (goo_pass/normalize source)
      | ./err "Unable to normalize Goo v2 source."
    = ids (list/range 0 (goo_pass/count core)).map((\ i (goo/node_id
        (str/cat_all [prefix ":" (nat/show i)]))))
      normalized (goo_pass/assign core ids 0).tree
      options (goo_pass/options (goo_bridge/context slot))
      visible (goo_pass/visibility options normalized)
      semantic (goo_compile/semantic .false visible)
    < prepared (goo_html/prepare semantic context.width context.scale context.rtl)
    = stages=row[json]
        ? !(context.pipeline) []
        [(goo_inspect/stage "parse" "skipped" jnull [])
         (goo_inspect/stage "read" "skipped" jnull [])
         (goo_inspect/stage "source" "ok" (goo_inspect/source source) [])
         (goo_inspect/stage "core" "ok" (goo_inspect/core core) [])
         (goo_inspect/stage "normalized" "ok" (goo_inspect/normalized normalized) [])
         (goo_inspect/stage "visible" "ok" (goo_codec/optional_json[goo/visible] goo_inspect/visible visible) [])
         (goo_measure/stage prepared.measurement.value "semantic")
         (goo_measure/stage prepared.measurement.value "metrics")
         (goo_measure/stage prepared.measurement.value "layout")
         (goo_measure/stage prepared.measurement.value "trace")
         (goo_inspect/stage "prepared" "ok" (goo_html/inspect prepared) [])]
    | ./ok (goo_bridge/compilation prepared stages)
  + compile
    \ context=goo_bridge/render_context published=goo/published card=myth view=goo/view
    ^ either[str goo_bridge/compilation]
    < source (goo_bridge/source published card view)
    | goo_bridge/compile_source context source (path_show view.name) view.slot
  + prepare
    \ context=goo_bridge/render_context published=goo/published card=myth view=goo/view
    ^ either[str goo_html_internal/prepared]
    < compiled (goo_bridge/compile context published card view)
    | ./ok compiled.prepared
  + pipeline_fields
    \ context=goo_bridge/render_context compiled=goo_bridge/compilation display=json html=str controls=row[json]
    ^ row[jkv]
    ? !(context.pipeline) []
    = stages compiled.stages.weld([
        (goo_inspect/stage "display" "ok" display [])
        (goo_inspect/stage "bindings" "ok" (json/arr controls) [])
        (goo_inspect/stage "html" "ok" (json/str html) [])])
    [(jkv "pipeline" (json/obj [(jkv "version" (json/num .false 1))
      (jkv "origin" (json/str "live-preparation"))
      (jkv "note" (json/str "Captured during this preparation. Source is evaluated typed Goo. Parse/read occurred during publication, or are bypassed for synthetic views; their artifacts are not retained here. Nodes acquire identity at normalized. Structural host components have their own contracts; these stages describe ordinary prepared Goo."))
      (jkv "stages" (json/arr stages))]))]
  + render_with
    \ context=goo_bridge/render_context published=goo/published card=myth view=goo/view
    ^ either[str str]
    < prepared (goo_bridge/prepare context published card view)
    | ./ok (goo_html/fragment prepared)
  + render
    \ published=goo/published card=myth view=goo/view
    ^ either[str str]
    | goo_bridge/render_with goo_bridge/initial_context published card view
  + context_json
    \ context=goo_bridge/render_context
    ^ json
    | json/obj [(jkv "width" (goo_number/encode context.width))
        (jkv "textScale" (goo_number/encode context.scale))
        (jkv "direction" (json/str (? context.rtl "rtl" "ltr")))]
  + control_descriptors
    ' Enrich only after pane routes and patch ids have reached their final form.
    \ controls=row[json] display=json
    ^ row[json]
    = nodes=row[json]
        ?> (json/arr nodes) (goo_runtime/json_field "nodes" display) []
        nodes
    | controls.map
      \ control=json
      ?> (json/obj fields) control control
      = field (\ key=str (goo_runtime/json_field key control))
        kind (goo_runtime/json_text (field "kind"))
        invoke (equal (field "invoke") (json/boo .true))
        become (equal (field "become") (json/boo .true))
        behavior=str
          ? (eq kind "input") "input"
          ? (and invoke become) "invoke-and-become"
          ? invoke "invoke"
          ? become "become"
          "none"
        captures=json
          ?> (json/arr captures) (field "captures") (json/arr [])
          | json/arr captures
        presented nodes.any((\ node (equal (goo_runtime/json_field "id" node) (field "id"))))
        binding (json/obj [(jkv "version" (json/num .false 1)) (jkv "kind" (json/str behavior))
          (jkv "nodeId" (field "id")) (jkv "route" (field "control")) (jkv "slot" (field "slot"))
          (jkv "captures" captures) (jkv "presented" (json/boo presented))])
      | json/obj (fields.keep((\ entry !(eq entry.k "captures")))).snoc((jkv "captures" captures)).snoc((jkv "binding" binding))
  + prepared_fields
    \ context=goo_bridge/render_context published=goo/published card=myth view=goo/view controls=row[json]
    ^ either[str row[jkv]]
    < compiled (goo_bridge/compile context published card view)
    = prepared compiled.prepared
    ?> (./some display) (goo_prepared/encode prepared) (./err "Prepared display failed validation.")
    = html (goo_html/fragment prepared)
      controls (goo_bridge/control_descriptors controls display)
      fields=row[jkv] [(jkv "profile" (goo_profile/metadata unit/unit))
        (jkv "context" (goo_bridge/context_json context)) (jkv "display" display)
        (jkv "html" (json/str html)) (jkv "controls" (json/arr controls))]
    | ./ok fields.weld((goo_bridge/pipeline_fields context compiled display html controls))
  + source_count
    \ source=goo/source
    ^ nat
    = cores (goo_pass/normalize_nodes (goo/rank/required) source)
    | cores.fold 0
      \ total=nat core=goo/core
      | add total (goo_pass/count core)
  + node_count
    \ published=goo/published card=myth node=goo/node
    ^ nat
    ?> (./ok sources) (goo_bridge/node published card node) 0
    | sources.fold 0
      \ total=nat source=goo/source
      | add total (goo_bridge/source_count source)
  + controls
    ' Walk the emitted core order, including flattened opt/or nodes. This is
    ' the same order used by assign; invisible controls simply have no DOM id.
    \ published=goo/published card=myth nodes=list[goo/node] parent=row[nat] start=nat
    ^ row[json]
    % rest=list[goo/node] nodes ordinal=nat 0 position=nat start out=row[json] []
    ^ row[json]
    ? (eq rest.len 0) out
    = node rest.at(0)
      count (goo_bridge/node_count published card node)
      route parent.snoc(ordinal)
      id (str/cat_all [(path_show published.view.name) ":" (nat/show position)])
      is_action (eq node.constructor "action")
      is_input (eq node.constructor "input")
      own=row[json]
        ? !(and (gt count 0) (is_action || is_input)) []
        = become (goo_runtime/named "become" node.arguments)
          slot=maybe[path]
            ? is_input
              ? node.arguments.len (goo_runtime/read_path node.arguments.at(0)) .none
            ? become
             > (./some value) (goo_runtime/read_path value)
            .none
        = invoke=bool
            ?> (./ok view) published.result .false
            ?> (./some found) (goo_runtime/locate view.children route (goo_runtime/scope .none .none .nil .none .none)) .false
            = [button scope] found
            | ((maybe/is_some scope.action) || (maybe/is_some scope.make))
        [(json/obj [(jkv "invoke" (json/boo invoke)) (jkv "id" (json/str id))
          (jkv "kind" (json/str (? is_action "action" "input")))
          (jkv "control" (json/str (str/join "." route.map(nat/show))))
          (jkv "slot" (json/str (path_show slot.fall([]))))
          (jkv "become" (json/boo (maybe/is_some become)))])]
      nested=row[json]
        ? (eq node.constructor "or")
          % children=list[goo/node] node.children index=nat 0
          ^ row[json]
          ? (eq children.len 0) []
          ? (eq (goo_bridge/node_count published card children.at(0)) 0) (_ children.drop(1) index.inc)
          | goo_bridge/controls published card node.children.take(index.inc) route position
        | goo_bridge/controls published card node.children route
            (? (eq node.constructor "opt") position position.inc)
    | _ rest.drop(1) ordinal.inc (add position count) out.weld(own).weld(nested)
