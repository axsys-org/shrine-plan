- goo_browser
- explorer_mount
- testing
- http_foot

+ goo_browser_checks
  + fixture
    ^ goo/published
    = field (goo/field "req" ['sys 'req] ['text] .false)
      expression (rex/rune "." [(rex/word "card") (rex/word "req")])
      node (goo/node rex/zero_span "text" [expression] [])
      view (goo/view rex/zero_span ['demo 'label] ['demo 'card]
        ['sys 'slot 'label] "card" [node])
      contract (grove_role_runtime/spec [] [[['sys 'req]]])
    | goo/published view [field] contract (./ok view)
  + render
    \ ignored=unit
    ^ row[testing/check]
    = published goo_browser_checks/fixture
      card (myth/sing ['sys 'req] (pails/t "<script>alert(1)</script>"))
      html (str/from_atom (weft/render (goo_browser/preview card published)))
      broken published.set_result((goo/fail[goo/view] rex/zero_span "Missing summary"))
      error (str/from_atom (weft/render (goo_browser/preview card broken)))
      catalog (axal/new[myth] .none).put(['demo 'label]
        (myth/sing publisher_vocabulary/grove/view published))
    [(testing/nat "matches receiver shape" 1 (goo_browser/matches card published))
     (testing/nat "rejects missing required field" 0 (goo_browser/matches myth/new published))
     (testing/nat "finds published views" 1 (goo_browser/catalog catalog).len)
     (testing/nat "escapes object text" 1 (maybe/is_some (http_foot/find "&lt;script&gt;" html)))
     (testing/nat "shows per-view errors" 1 (maybe/is_some (http_foot/find "Missing summary" error)))
     (testing/nat "missing optional values render nothing" 0
       (either/ok_val (goo_bridge/nodes published myth/new published.view.children)).len)]

  + success
    (@ a)
    \ result=either[str a]
    ^ bool
    ? result
     > (./ok _) .true
     > (./err _) .false
  + bridge
    \ ignored=unit
    ^ row[testing/check]
    = published goo_browser_checks/fixture
      card (myth/sing ['sys 'req] (pails/t "Hello"))
      leaf (goo/node rex/zero_span "text" [(rex/cord "Hello") (rex/quip "'/sys/slot/title")] [])
      view published.view.set_children([leaf])
      source (either/ok_val (goo_bridge/source published card view))
      optional (goo/node rex/zero_span "opt" [] [leaf])
      hidden (goo_bridge/semantic published card view.set_children([optional]))
      unicode (goo_bridge/render published (myth/sing ['sys 'req] (pails/t "café")) published.view)
      unsupported (goo_bridge/node published card (goo/node rex/zero_span "divider" [] []))
      link (goo/node rex/zero_span "link" [(rex/quip "'/demo")] [])
      path_source (either/ok_val (goo_bridge/node published card link))
      present (goo/node rex/zero_span "present"
        [(rex/word "card") (rex/rune "/" [(rex/word "sys") (rex/word "slot") (rex/word "label")])] [leaf])
      front (goo_bridge/render published card view.set_children([present]))
      markup (goo_bridge/render published card view)
      path_text=str
        ? path_source.at(0)
         > (goo/source/text _ text) text
        "wrong type"
    [(testing/nat "only asset files become HTTP routes" 2
       (explorer_mount/asset_files [["goo-Sans400.ttf" 1] ["goo-fonts.css" 1] ["goo_bridge.foil" 1] ["mount.json" 1]]).len)
     (testing/text "legacy title maps to v2 role" "title" source.children.at(0).attrs.common.slot.text)
     (testing/text "unknown slot preserved" "/custom/title" (goo_bridge/role ['custom 'title]))
     (testing/nat "label context hides optional content" 1 (maybe/is_none (either/ok_val hidden)))
     (testing/nat "present accepts Grove absolute slot paths" 1 (goo_browser_checks/success front))
     (testing/nat "v2 produces prepared HTML" 1 (goo_browser_checks/success markup))
     (testing/nat "v2 rejects non-ASCII measurement" 0 (goo_browser_checks/success unicode))
     (testing/nat "unsupported constructor diagnosed" 0 (goo_browser_checks/success unsupported))
     (testing/text "path values materialize as v2 text" "/demo" path_text)]

+ tests
  ^ row[testing/case]
  [(testing/case "view previews" goo_browser_checks/render)
   (testing/case "v2 bridge" goo_browser_checks/bridge)]
