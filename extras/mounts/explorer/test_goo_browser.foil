- system_vocabulary
- goo_browser
- explorer_mount
- testing
- http_foot
- tests/overlay_cache [at=cache_fixture]
- tests/namespace [at=ns_fixture]

+ goo_browser_checks
  + slot_titles
    \ ignored=unit
    ^ row[testing/check]
    = initial ns_fixture/namespace_tests/initial
      shared (unpin initial.system).state
      shared=sov
        ? (sov/step (axal/new[note] .none).put(system_vocabulary/req
            (note/make (myth/sing system_vocabulary/lede (pails/t "Request title")))) 0 0 shared)
         > (./accepted result=[next=sov signs=axal[sign]])
          = [next signs] result
          next
        shared
      state initial.set_system((pin (system_publication 2 shared (system_publication/assigned shared))))
      named=path [state.self 'named_slot]
      empty=path [state.self 'empty_slot]
      invalid=path [state.self 'invalid_slot]
      missing=path [state.self 'missing_slot]
      target=path [state.self 'title_test]
      state (cache_fixture/overlay_cache_tests/write named
        (writ/make (myth/sing system_vocabulary/lede (pails/t "<Friendly label>"))) state)
      state (cache_fixture/overlay_cache_tests/write empty
        (writ/make (myth/sing system_vocabulary/lede (pails/t ""))) state)
      state (cache_fixture/overlay_cache_tests/write invalid
        (writ/make (myth/sing system_vocabulary/lede (pails/n 7))) state)
      card (myth/sing system_vocabulary/req (pails/n 11)).put(named (pails/n 22))
      card card.put(empty (pails/n 33)).put(invalid (pails/n 44)).put(missing (pails/n 55))
      state (cache_fixture/overlay_cache_tests/write target (writ/make card) state)
      render
        \ state=namespace
        ^ json
        | either/ok_val (goo_browser/render_result goo_bridge/initial_context target
            goo_reflection/slot [] [] [] .none state)
      result (render state)
      html (grove_dev/text (grove_dev/field "html" result))
      titles (goo_reflection/slot_titles card state)
      revised (cache_fixture/overlay_cache_tests/write named
        (writ/make (myth/sing system_vocabulary/lede (pails/t "Renamed slot"))) state)
      fresh (grove_dev/text (grove_dev/field "html" (render revised)))
      has (\ needle=str text=str (maybe/is_some (str/find needle text)))
    [(testing/text "system slot title comes from its definition" "Request title" (titles.gut(system_vocabulary/req "")))
     (testing/nat "Values renders the system slot title" 1 (has "Request title" html))
     (testing/nat "editor retains canonical slot identity" 1 (has "data-goo-value=""/sys/req""" html))
     (testing/nat "slot titles use normal HTML escaping" 1 (has "&lt;Friendly label&gt;" html))
     (testing/nat "editable values expose a slot editor" 1 (has "data-goo-value" html))
     (testing/nat "missing slot title falls back to path" 1 (has (path_show missing) html))
     (testing/nat "empty slot title falls back to path" 1 (has (path_show empty) html))
     (testing/nat "non-text slot title falls back to path" 1 (has (path_show invalid) html))
     (testing/nat "fresh render reads updated slot title" 1 (has "Renamed slot" fresh))
     (testing/nat "fresh render discards previous slot title" 0 (has "Friendly label" fresh))]
  + synthetic_child
    : enabled=bool
  + synthetic_sample
    : title=str count=nat tags=row[str] child=goo_browser_checks/synthetic_child
  + synthetic_checks
    \ ignored=unit
    ^ row[testing/check]
    = shape (^ goo_browser_checks/synthetic_sample)
      descriptors (axal/new[myth] .none).put(['sample]
        (myth/sing system_vocabulary/mold (pails/ty shape))).put(['child]
        (myth/sing system_vocabulary/mold (pails/ty (^ goo_browser_checks/synthetic_child))))
      types (goo_reflection/types descriptors)
      matrix=row[row[nat]] (row/range 0 24).map((\ i (row/range 0 24)))
      bounded (goo_reflection/value types (^ matrix) matrix 5 16)
      sample (goo_browser_checks/synthetic_sample "<reflected>" 42 ["first" "second"]
        (goo_browser_checks/synthetic_child .true))
      card (myth/sing ['example] sample).put(system_vocabulary/req (pails/t "Authored still works"))
      rendered (either/ok_val (goo_reflection/render ['test] types card))
      opaque (either/ok_val (goo_reflection/render ['test] (mop/empty) card))
      published goo_browser_checks/fixture
      catalog (goo_browser/index (list/one published)).set_types(types)
      projected (axal/new[myth] (./some (myth/sing goo_browser/catalog_slot catalog)))
      cached (axal/new[myth] (./some (myth/sing overlay_cache/result_slot
        (overlay_cache/result (pin projected)))))
      page (str/from_atom (goo_browser/page ['test] (axal/new[myth] (./some card)) cached))
      empty (str/from_atom (goo_browser/page ['empty] (axal/new[myth] (./some myth/new)) cached))
      has
        \ needle=str text=str
        | maybe/is_some (http_foot/find needle text)
    [(testing/nat "nested collections respect the expansion budget" 1
       (le (goo_bridge/source_count bounded) 70))
     (testing/text "non-ASCII text remains inspectable" "caf\xc3\xa9" (goo_reflection/display_text "café"))
     (testing/nat "reflected record field names" 1 (has "title" rendered))
     (testing/nat "reflected strings are escaped" 1 (has "&lt;reflected&gt;" rendered))
     (testing/nat "reflected natural number" 1 (has "42" rendered))
     (testing/nat "reflected collection strings" 1 (has "second" rendered))
     (testing/nat "nested nominal record" 1 (has "enabled" rendered))
     (testing/nat "nested boolean" 1 (has "true" rendered))
     (testing/nat "unknown brands show their value" 1 (has "&lt;reflected&gt;" opaque))
     (testing/nat "unknown brands retain their exact identity" 1
       (has (goo_reflection/type_name (show/brand shape)) opaque))
     (testing/nat "unknown brands no longer render an opaque placeholder" 0 (has "[opaque]" opaque))
     (testing/nat "synthetic slot always available" 1 (has "/sys/slot/synthetic" page))
     (testing/nat "synthetic view has stable refresh identity" 1 (has "data-view=""/sys/slot/synthetic""" page))
     (testing/nat "authored view retained alongside synthetic" 1 (has "/demo/label" page))
     (testing/nat "empty objects have synthetic view" 1 (has "Empty object" empty))
     (testing/nat "descriptor registry is cached with views" 1
       (equal types (goo_browser/cached_index cached).types))]
  + fixture
    ^ goo/published
    = field (goo/field "req" system_vocabulary/req ['text] .false)
      expression (rex/rune "." [(rex/word "card") (rex/word "req")])
      node (goo/node rex/zero_span "text" (list/one expression) .nil)
      view (goo/view rex/zero_span ['demo 'label] ['demo 'card] ['sys 'slot 'label] "card" (list/one node) .false .nil)
      contract (grove_role_runtime/spec [] [[system_vocabulary/req]])
    | goo/published view (list/one field) contract (./ok view)
  + render
    \ ignored=unit
    ^ row[testing/check]
    = published goo_browser_checks/fixture
      card (myth/sing system_vocabulary/req (pails/t "<script>alert(1)</script>"))
      html (str/from_atom (weft/render (goo_browser/preview card published)))
      broken published.set_result((goo/fail[goo/view] rex/zero_span "Missing summary"))
      error (str/from_atom (weft/render (goo_browser/preview card broken)))
      catalog (axal/new[myth] .none).put(['demo 'label]
        (myth/sing system_vocabulary/grove/view published))
    [(testing/nat "matches receiver shape" 1 (goo_browser/matches card published))
     (testing/nat "rejects missing required field" 0 (goo_browser/matches myth/new published))
     (testing/nat "finds published views" 1 (goo_browser/catalog catalog).len)
     (testing/nat "escapes object text" 1 (maybe/is_some (http_foot/find "&lt;script&gt;" html)))
     (testing/nat "shows per-view errors" 1 (maybe/is_some (http_foot/find "Missing summary" error)))
     (testing/nat "missing optional values render nothing" 0
       (either/ok_val (goo_bridge/nodes published myth/new published.view.children)).len)]

  + temporal
    \ ignored=unit
    ^ row[testing/check]
    = dm (quip_val '@2026.9.30..12.0.0)
      ds (quip_val '@@2026.9.30..12.0.0)
      published goo_browser_checks/fixture
      expression (rex/rune "." [(rex/word "card") (rex/word "req")])
      view published.view.set_children((list/one (goo/node rex/zero_span "time" (list/one expression) .nil)))
      html (either/ok_val (goo_bridge/render published (myth/sing system_vocabulary/req (pails/ds ds)) view))
    [(testing/text "legacy timestamp" "2026-09-30 12:00:00 UTC"
       (either/ok_val (goo_bridge/formatted "time" (pails/n dm))))
     (testing/text "legacy duration" "1h 30m"
       (either/ok_val (goo_bridge/formatted "duration" (pails/n 5400000))))
     (testing/text "ordinary numbers remain decimal" "5400000"
       (either/ok_val (goo_bridge/formatted "number" (pails/n 5400000))))
     (testing/text "tagged duration in text" "250ms"
       (either/ok_val (goo_bridge/text (pails/dr 250))))
     (testing/nat "precise timestamp renders in HTML" 1
       (maybe/is_some (http_foot/find "2026-09-30 12:00:00 UTC" html)))]
  + interactions
    \ ignored=unit
    ^ row[testing/check]
    = base goo_browser_checks/fixture
      missing base.view.children.at(0)
      button (goo/node rex/zero_span "action" ((list/one[rex] (rex/rune "=" [(rex/word "become") (rex/quip "'/sys/slot/res")])).cons((rex/cord "Show"))) .nil)
      choose (goo/node rex/zero_span "or" .nil ((list/one button).cons(missing)))
      input (goo/node rex/zero_span "input" (list/one[rex] (rex/quip "'/sys/req")) .nil)
      group (goo/node rex/zero_span "group" .nil (list/one input))
      view base.view.set_children(((list/one group).cons(choose)))
      published base.set_view(view).set_result((./ok view))
      controls (goo_bridge/controls published myth/new view.children [] 1)
      first controls.at(0)
      second controls.at(1)
    [(testing/nat "two rendered controls" 2 controls.len)
     (testing/text "or keeps original IR child identity" "0.1" (grove_dev/text (grove_dev/field "control" first)))
     (testing/text "or flattened layout id" "/demo/label:1" (grove_dev/text (grove_dev/field "id" first)))
     (testing/text "become retains exact slot" "/sys/slot/res" (grove_dev/text (grove_dev/field "slot" first)))
     (testing/text "input layout id follows container" "/demo/label:3" (grove_dev/text (grove_dev/field "id" second)))
     (testing/text "input keeps data slot" "/sys/req" (grove_dev/text (grove_dev/field "slot" second)))]
  + success
    (@ a)
    \ result=either[str a]
    ^ bool
    ? result
     > (./ok _) .true
     > (./err _) .false
  + bridge
    \ ignored=unit
    ^ row[testing/check]
    = published goo_browser_checks/fixture
      card (myth/sing system_vocabulary/req (pails/t "Hello"))
      leaf (goo/node rex/zero_span "text" ((list/one[rex] (rex/quip "'/sys/slot/title")).cons((rex/cord "Hello"))) .nil)
      view published.view.set_children((list/one leaf))
      source (either/ok_val (goo_bridge/source published card view))
      optional (goo/node rex/zero_span "opt" .nil (list/one leaf))
      hidden (goo_bridge/semantic published card view.set_children((list/one optional)))
      unicode (goo_bridge/render published (myth/sing system_vocabulary/req (pails/t "café")) published.view)
      unsupported (goo_bridge/node published card (goo/node rex/zero_span "divider" .nil .nil))
      link (goo/node rex/zero_span "link" (list/one[rex] (rex/quip "'/demo")) .nil)
      path_source (either/ok_val (goo_bridge/node published card link))
      present (goo/node rex/zero_span "present" ((list/one[rex] (rex/rune "/" [(rex/word "sys") (rex/word "slot") (rex/word "label")])).cons((rex/word "card"))) (list/one leaf))
      front (goo_bridge/render published card view.set_children((list/one present)))
      native_slot (goo_bridge/slot published card (rex/cord "action/copy"))
      escaped (rex/juxt rex/zero_span [(rex/word "escaped") (rex/expr rex/zero_span "paren" [(rex/cord "One\nTwo")])])
      decoded (goo_bridge/value published card (rex/normalize escaped))
      record (rex/normalize (rex/nest rex/zero_span "curly" ":"
        [(rex/brack [(rex/word "primary")]) (rex/word "true")]))
      button (goo/node rex/zero_span "button" (((list/one[rex] (rex/cord "action")).cons((rex/cord "Save"))).cons(record)) .nil)
      configured (goo_bridge/render published card view.set_children((list/one button)))
      markup (goo_bridge/render published card view)
      path_text=str
        ? path_source.at(0)
         > (goo/source/text _ text) text
        "wrong type"
    [(testing/nat "only asset files become HTTP routes" 2
       (explorer_mount/asset_files [["goo-Sans400.ttf" 1] ["goo-fonts.css" 1] ["goo_bridge.foil" 1] ["mount.json" 1]]).len)
     (testing/text "legacy title maps to v2 role" "title" source.children.at(0).attrs.common.slot.text)
     (testing/text "unknown slot preserved" "/custom/title" (goo_bridge/role ['custom 'title]))
     (testing/nat "label context hides optional content" 1 (maybe/is_none (either/ok_val hidden)))
     (testing/nat "present accepts Grove absolute slot paths" 1 (goo_browser_checks/success front))
     (testing/text "native role literals survive binding" "action/copy" (either/ok_val native_slot))
     (testing/nat "escaped text survives binding" 1 (equal decoded (maybe/some[pail] (pails/t (str/cat_all ["One" (str/from_atom 10) "Two"])))))
     (testing/nat "normalized config brackets reach v2" 1 (goo_browser_checks/success configured))
     (testing/nat "v2 produces prepared HTML" 1 (goo_browser_checks/success markup))
     (testing/nat "v2 rejects non-ASCII measurement" 0 (goo_browser_checks/success unicode))
     (testing/nat "unsupported constructor diagnosed" 0 (goo_browser_checks/success unsupported))
     (testing/text "path values materialize as v2 text" "/demo" path_text)]

  + indexed_matches
    \ ignored=unit
    ^ row[testing/check]
    = base goo_browser_checks/fixture
      alternate base.set_contract((grove_role_runtime/spec [] [[['a] ['b]]]))
      conjunction base.set_contract((grove_role_runtime/spec [] [[['a] ['b]] [['c]]]))
      unconditional base.set_contract((grove_role_runtime/spec [] []))
      impossible base.set_contract((grove_role_runtime/spec [] [[]]))
      typed base.set_contract((grove_role_runtime/spec
        [[['a] (curb/of_type (^ pails/t))]] [[['a]]]))
      synthetic base.set_contract((grove_role_runtime/spec [] [[system_vocabulary/lash]]))
      views=list[goo/published] (list/one synthetic).cons(typed).cons(impossible).cons(unconditional).cons(conjunction).cons(alternate).cons(base)
      index (goo_browser/index views)
      cards=row[myth]
        [myth/new
         (myth/sing system_vocabulary/req (pails/t "Name"))
         (myth/sing ['a] (pails/t "A"))
         (myth/sing ['b] (pails/t "B"))
         (myth/sing ['a] (pails/n 3))
         (myth/sing ['a] (pails/t "A")).put(['b] (pails/t "B")).put(['c] (pails/t "C"))
         (myth/sing ['c] (pails/t "C"))]
      same
        | cards.all
        \ card
        | equal (views.keep((goo_browser/matches card))) (goo_browser/matching card index)
      specific (goo_browser/index ((list/one typed).cons(conjunction).cons(alternate).cons(base).cons(base).cons(base)))
      name (myth/sing system_vocabulary/req (pails/t "Name"))
    [(testing/nat "index agrees with full scan for OR, AND, empty needs, type rejection and synthetic lash" 1 same)
     (testing/nat "index excludes unrelated view contracts" 3 (goo_browser/candidates name specific).len)
     (testing/nat "current object slots select new candidates immediately" 0
       (goo_browser/matching myth/new specific).len)
     (testing/nat "OR-group hits do not duplicate views" 5
       (goo_browser/candidates cards.at(5) index).len)]

  + development_routes
    \ ignored=unit
    ^ row[testing/check]
    = route
        \ method=str target=str body=str
        | explorer_dev/plan [] (http_foot/request method target body) 0
      read (route "GET" "/grove/dev/status?selected=%2F0x11%2Fapp%2Fdemo" "")
      valid (route "POST" "/grove/dev/replace"
        "source=%2F0x11%2Fgov%2Fdemo&root=%2F0x11%2Fapp%2Fdemo&version=3&expected=7&scan=2")
      status_code
        \ action=http_foot/action
        ^ nat
        ?> (./reply response) action 0
        response.status
      read_ok
        ?> (./develop query) read .false
        | equal query.operation "status"
      write_ok
        ?> (./develop query) valid .false
        | and (eq query.version 3) (equal query.expected (maybe/some[nat] 7))
    [(testing/nat "development status uses read-only request" 1 read_ok)
     (testing/nat "development writes retain version guards" 1 write_ok)
     (testing/nat "GET cannot delete" 405 (status_code (route "GET" "/grove/dev/delete" "")))
     (testing/nat "POST cannot masquerade as status read" 405 (status_code (route "POST" "/grove/dev/status" "")))
     (testing/nat "invalid expected version is rejected" 400 (status_code (route "POST" "/grove/dev/replace" "expected=no")))
     (testing/nat "unknown development operation rejected" 404 (status_code (route "POST" "/grove/dev/unknown" "")))]

  + cached_catalog_checks
    \ ignored=unit
    ^ row[testing/check]
    = root=path [($x 1) 'gov]
      transform=path [($x 1) 'weft 'catalog]
      target=path [($x 1) 'weft 'catalog_cache]
      initial ns_fixture/namespace_tests/initial
      initial (cache_fixture/overlay_cache_tests/write root (writ/make myth/new) initial)
      initial (cache_fixture/overlay_cache_tests/write transform
        (writ/make (myth/sing bond/weft (felt goo_browser/catalog_overlay .none))) initial)
      ready
        ? (overlay_cache/install target (overlay_cache/path 1 transform root) initial)
         > (./ok state) state
         > (./err _) initial
      published goo_browser_checks/fixture
      view (myth/sing system_vocabulary/grove/view published)
      added (cache_fixture/overlay_cache_tests/write root.snoc('view) (writ/make view) ready)
      changed_view (myth/sing system_vocabulary/grove/view
        published.set_result((goo/fail[goo/view] rex/zero_span "Updated")))
      changed (cache_fixture/overlay_cache_tests/write root.snoc('view) (writ/make changed_view) added)
      unrelated (cache_fixture/overlay_cache_tests/write [($x 1) 'request] (writ/make myth/new) changed)
      rebound (cache_fixture/overlay_cache_tests/write root.snoc('view)
        (writ/make (myth/sing system_vocabulary/grove/view
          published.set_contract((grove_role_runtime/spec [] [[['other]]])))) unrelated)
      removed (cache_fixture/overlay_cache_tests/write root.snoc('view) .cull unrelated)
      cached (goo_browser/cached_catalog (sovereign_care .x target changed))
      descriptor (^ goo_browser_checks/synthetic_sample)
      described (cache_fixture/overlay_cache_tests/write root.snoc('shape)
        (writ/make (myth/sing system_vocabulary/mold (pails/ty descriptor))) added)
      cleared (cache_fixture/overlay_cache_tests/write root.snoc('shape) .cull described)
      registry (goo_browser/cached_index (sovereign_care .x target described)).types
      without (goo_browser/cached_index (sovereign_care .x target cleared)).types
    [(testing/nat "new descriptor refreshes cached reflection" 1
       (maybe/is_some registry.get((show/brand descriptor))))
     (testing/nat "removed descriptor leaves cached reflection" 1
       (maybe/is_none without.get((show/brand descriptor))))
     (testing/nat "changed contract removes old index entry" 0
       (goo_browser/candidates (myth/sing system_vocabulary/req (pails/t "Name"))
         (goo_browser/cached_index (sovereign_care .x target rebound))).len)
     (testing/nat "changed contract adds new index entry" 1
       (goo_browser/matching (myth/sing ['other] (pails/t "New"))
         (goo_browser/cached_index (sovereign_care .x target rebound))).len)
     (testing/nat "cached index matches newly published view" 1
       (goo_browser/matching (myth/sing system_vocabulary/req (pails/t "Name"))
         (goo_browser/cached_index (sovereign_care .x target added))).len)
     (testing/nat "deleted publication leaves no matching candidates" 0
       (goo_browser/candidates (myth/sing system_vocabulary/req (pails/t "Name"))
         (goo_browser/cached_index (sovereign_care .x target removed))).len)
     (testing/nat "empty catalog cache" 0
       (goo_browser/cached_catalog (sovereign_care .x target ready)).len)
     (testing/nat "publication adds view to cached catalog" 1
       (goo_browser/cached_catalog (sovereign_care .x target added)).len)
     (testing/nat "publication updates cached view" 1
       (equal cached.at(0).result (goo/fail[goo/view] rex/zero_span "Updated")))
     (testing/nat "HTTP-like unrelated write keeps catalog version" 1
       (equal (changed.case(.x target)) (unrelated.case(.x target))))
     (testing/nat "publication removal updates cached catalog" 0
       (goo_browser/cached_catalog (sovereign_care .x target removed)).len)]

  + inspection_fields
    ^ row[[str str]]
    [["capture" "capture-1"] ["parent" ""] ["subject" "/projected/a"] ["target" "/object/a"]
     ["view" "/gov/summary"] ["role" "/gov/record"] ["slot" "/sys/slot/label"]
     ["life" "7"] ["displayed" "11"] ["expected" "9"] ["publication" "3"] ["projectionSeq" "200"]
     ["kind" "view"] ["node" ""] ["line" "20"] ["column" "3"] ["layout" "sm"]
     ["renderWidth" "240"] ["renderHeight" "80"] ["renderScale" "1"] ["renderDirection" "ltr"]
     ["profile" "mash-goo"] ["profileRevision" "test-profile"] ["nodes" "2"]
     ["session" "page-1"] ["revision" "4"] ["owner" "pane"] ["incarnation" "1"]
     ["encounter" "e1"] ["generation" "2"] ["selection" "/projected/a"]
     ["pending" "false"] ["dirty" "2"] ["composing" "1"] ["live" "true"]]
  + inspection
    \ ignored=unit
    ^ row[testing/check]
    = fields goo_browser_checks/inspection_fields
      card (goo_inspection/card fields)
      result (goo_inspection/prepare goo_bridge/initial_context fields)
      html (grove_dev/text (grove_dev/field "html" (either/ok_val result)))
      has (\ text=str (maybe/is_some (str/find text html)))
      rewrite (\ key=str value=str (fields.map((\ [name old] [name (? (eq name key) value old)]))))
      form (str/join "&" (fields.weld([["width" "480"] ["textScale" "1"] ["direction" "ltr"]])).map((\ [key value] (str/cat_all [key "=" value]))))
      response (explorer_dev/interact (http_foot/request "POST" "/goo/inspect" form) 0)
      valid_wire=bool
        ?> (./bytes status bytes mime) response .false
        ?> (jres/ok value rest) (parse (http_foot/unbar bytes)) .false
        | and (eq status 200) (eq (grove_dev/text (grove_dev/field "capture" value)) "capture-1")
      status
        \ method=str body=str
        ?> (./reply response) (explorer_dev/interact (http_foot/request method "/goo/inspect" body) 0) 200
        response.status
    [(testing/nat "inspection HTTP response preserves complete JSON bytes" 1 valid_wire)
     (testing/nat "inspection captures typed records" 1 (either/is_ok card))
     (testing/nat "inspection uses real Goo preparation" 1 (either/is_ok result))
     (testing/nat "inspection preserves displayed subject" 1 (has "/projected/a"))
     (testing/nat "inspection preserves separate writable receiver" 1 (has "/object/a"))
     (testing/nat "inspection shows browser provenance" 1 (has "Browser capture"))
     (testing/nat "inspection returns no domain controls" 0 (grove_dev/items (grove_dev/field "controls" (either/ok_val result))).len)
     (testing/nat "inspection rejects duplicate fields" 1 (either/is_err (goo_inspection/card fields.snoc(["capture" "other"]))))
     (testing/nat "inspection rejects arbitrary executable fields" 1 (either/is_err (goo_inspection/card fields.snoc(["action" "poke"]))))
     (testing/nat "inspection rejects missing identity" 1 (either/is_err (goo_inspection/card (rewrite "capture" ""))))
     (testing/nat "inspection rejects malformed paths" 1 (either/is_err (goo_inspection/card (rewrite "subject" "not-a-path"))))
     (testing/nat "inspection rejects malformed counters" 1 (either/is_err (goo_inspection/card (rewrite "revision" "-1"))))
     (testing/nat "inspection rejects malformed flags" 1 (either/is_err (goo_inspection/card (rewrite "live" "maybe"))))
     (testing/nat "inspection requires POST" 405 (status "GET" ""))
     (testing/nat "inspection rejects bad allocation" 400 (status "POST" "width=-1&textScale=1&direction=ltr"))]

  + path_views
    \ ignored=unit
    ^ row[testing/check]
    = root=path [($x 1) 'gov]
      target=path [($x 1) 'object]
      source
        \ body=str
        | str/join (str/from_atom 10)
          ["#import text=lib/grove/types/text" "#import path_type=lib/grove/types/path"
           "#import lede=sys/lede" "#import about=sys/about" ""
           "record =" "  @role" "  #opt ;" "    lede: text" "    about: path_type" ""
           "summary =" "  @view" "  #on ; %/record" "  #for ; /sys/slot/label" body ""
           "outer =" "  @view" "  #on ; %/record" "  #for ; /sys/slot/content"
           "  another => { present(another, '/sys/slot/label) }"]
      compile
        \ body=str name=str
        ^ either[grove/error goo/view]
        < doc (grove/parse (source body))
        | grove_views/compile root doc (\ path .none) .nil (goo/html_types ['lib 'grove 'types]) name
      body (str/join (str/from_atom 10)
        ["  record => {" "    or {" "      show(record.lede, '/sys/slot/label)"
         "      path(record, '/sys/slot/label)" "    }" "  }"])
      built (compile body "summary")
      error
        \ result=either[grove/error goo/view]
        ^ str
        ? result
         > (./err cause)
          ? cause
           > (grove/error/syntax span message) message
           > (grove/error/parser cause) "parser error"
         > (./ok value) "success"
    ?> (./ok view) built [(testing/text "path summary compiles" "success" (error built))]
    = fields (list/one (goo/field "lede" system_vocabulary/lede ['lib 'grove 'types 'text] .true))
      fields fields.snoc((goo/field "about" system_vocabulary/about ['lib 'grove 'types 'path] .true))
      published (goo/published view fields lash/new (./ok view))
      render
        \ body=str card=myth
        ^ either[str str]
        = compiled (compile body "summary")
        ?> (./ok view) compiled (./err (error compiled))
        = publication (goo_bridge/receiver target published.set_view(view).set_result((./ok view)))
        | goo_bridge/render publication card (either/ok_val publication.result)
      fallback (either/ok_val (render body myth/new))
      preferred (either/ok_val (render body (myth/sing system_vocabulary/lede (pails/t "Preferred title"))))
      field (either/ok_val (render "  record => { path(record.about, '/sys/slot/label) }" (myth/sing system_vocabulary/about (pails/p ['other 'record]))))
      literal (either/ok_val (render "  record => { path('/literal/record, '/sys/slot/label) }" myth/new))
      root_path (either/ok_val (render "  record => { path(record.about, '/sys/slot/label) }" (myth/sing system_vocabulary/about (pails/p []))))
      absent (either/ok_val (render "  record => { path(record.about) }" myth/new))
      outer (either/ok_val (compile body "outer"))
      outer_pub (goo_bridge/receiver target published.set_view(outer).set_result((./ok outer)))
      outer_html (either/ok_val (goo_bridge/render outer_pub myth/new (either/ok_val outer_pub.result)))
      state ns_fixture/namespace_tests/initial
      state (cache_fixture/overlay_cache_tests/write view.name (writ/make (myth/sing system_vocabulary/grove/view published)) state)
      state (cache_fixture/overlay_cache_tests/write target (writ/make myth/new) state)
      packet (either/ok_val (goo_browser/render_result goo_bridge/initial_context target view.name [] [] [] .none state))
      ssr (str/from_atom (weft/render (goo_browser/preview_at target myth/new published)))
      synthetic (either/ok_val (goo_reflection/render target (mop/empty) (myth/sing system_vocabulary/lede (pails/t "Value"))))
      has (\ needle=str text=str (maybe/is_some (str/find needle text)))
    [(testing/nat "path constructor compiles the receiver fallback" 1 (has (path_show target) fallback))
     (testing/nat "lede wins over path in or" 1 (and (has "Preferred title" preferred) !(has (path_show target) preferred)))
     (testing/nat "path accepts a path-typed field" 1 (has "/other/record" field))
     (testing/nat "path accepts a literal namespace path" 1 (has "/literal/record" literal))
     (testing/nat "typed root path remains printable" 1 (has ">/</span>" root_path))
     (testing/nat "absent optional path produces no path text" 0 (has "goo-ascii-line" absent))
     (testing/nat "present substitution retains receiver identity" 1 (has (path_show target) outer_html))
     (testing/nat "live rendering receives display identity" 1 (has (path_show target) (grove_dev/text (grove_dev/field "html" packet))))
     (testing/nat "SSR receives the same display identity" 1 (has (path_show target) ssr))
     (testing/nat "synthetic slot labels use canonical paths" 1 (has "/sys/lede" synthetic))
     (testing/nat "path rejects text-typed fields" 1 (either/is_err (compile "  record => { path(record.lede) }" "summary")))
     (testing/nat "path rejects text literals" 1 (either/is_err (compile "  record => { path(""/not-typed"") }" "summary")))
     (testing/nat "path rejects missing argument" 1 (either/is_err (compile "  record => { path() }" "summary")))
     (testing/nat "path rejects explicit children" 1 (either/is_err (compile "  record => { path(record) { text(""child"") } }" "summary")))
     (testing/nat "path rejects foreign receiver" 1 (either/is_err (compile "  record => { path(other) }" "summary")))]
  + live_render
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 1) 'object]
      view_path=path [($x 1) 'gov 'live]
      base goo_browser_checks/fixture
      view base.view.set_name(view_path)
      published base.set_view(view).set_result((./ok view))
      state ns_fixture/namespace_tests/initial
      state (cache_fixture/overlay_cache_tests/write view_path
        (writ/make (myth/sing system_vocabulary/grove/view published)) state)
      state (cache_fixture/overlay_cache_tests/write target
        (writ/make (myth/sing system_vocabulary/req (pails/t "Before"))) state)
      context (goo_bridge/render_context (goo_fp/integer 211) (goo_fp/integer 2) .true)
      bundle (either/ok_val (goo_browser/pane_layouts context target [] view.slot view.role [] .none state))
      tree_query (goo_runtime/request "tree-page" target [] [] [] 0 0 0 [] 0)
      tree (either/ok_val (goo_browser/tree_layouts context tree_query [view.slot goo_reflection/slot] state))
      children (grove_dev/items (grove_dev/field "presentations" tree))
      child_layouts (grove_dev/items (grove_dev/field "layouts" (grove_dev/field "bundle" children.at(0))))
      bad_tree (goo_browser/tree_layouts context tree_query [['missing]] state)
      stale_tree (goo_browser/tree_layouts context tree_query.set_inputs([["$epoch" "0"]]) [view.slot] state)
      layouts (grove_dev/items (grove_dev/field "layouts" bundle))
      layout (\ index=nat (grove_dev/field "render" layouts.at(index)))
      result (either/ok_val (goo_browser/render_result context target view_path [] [] [] .none state))
      display (grove_dev/field "display" result)
      captured (grove_dev/field "snapshot" result)
      newer (cache_fixture/overlay_cache_tests/write target
        (writ/make (myth/sing system_vocabulary/req (pails/t "After"))) state)
      fresh (either/ok_val (goo_browser/render_result context target view_path [] [] [] .none newer))
      catalog (either/ok_val (goo_browser/render_result context target [] [] [] [] .none state))
      native (either/ok_val (goo_browser/render_result context target view_path [] [] [] (./some [0]) state))
      missing (goo_browser/render_result context target ['missing] [] [] [] .none state)
      unregistered (goo_browser/render_result context target view_path [] [] view_path .none state)
      host (goo_browser/hosted_receiver view_path (\ path state (./ok (myth/sing system_vocabulary/req (pails/t "Hosted")))))
      hosted (cache_fixture/overlay_cache_tests/write (goo_browser/hosted_path state.self view_path)
        (writ/make (myth/sing system_vocabulary/content host)) state)
      hosted_result (either/ok_val (goo_browser/render_result context target view_path [] [] view_path .none hosted))
      wrong_host (goo_browser/render_result context target ['other] [] [] view_path .none hosted)
      action (goo/node rex/zero_span "action" (list/one[rex] (rex/cord "Save")) .nil)
      args (list/one[rex] (rex/rune "=" [(rex/word "on") (rex/word "card")]))
      args args.snoc((rex/rune "=" [(rex/word "action") (rex/word "poke")]))
      group (goo/node rex/zero_span "group" args (list/one action))
      action_view view.set_is_pane(.true).set_children((list/one group))
      action_publication published.set_view(action_view).set_result((./ok action_view))
      dangerous (cache_fixture/overlay_cache_tests/write view_path
        (writ/make (myth/sing system_vocabulary/grove/view action_publication)) hosted)
      hosted_action (goo_browser/render_result context target view_path [] [] view_path .none dangerous)
      hosted_node_action (goo_browser/render_result context target view_path [] [] view_path (./some [0]) dangerous)
      pane_path=path [($x 1) 'gov 'pane]
      pane_view view.set_name(pane_path).set_is_pane(.true)
      pane_state (cache_fixture/overlay_cache_tests/write pane_path
        (writ/make (myth/sing system_vocabulary/grove/view published.set_view(pane_view).set_result((./ok pane_view)))) state)
      slot_with_pane (goo_browser/render_result context target [] view.slot view.role [] .none pane_state)
      other_path=path [($x 1) 'gov 'other]
      other_view view.set_name(other_path)
      ambiguous_state (cache_fixture/overlay_cache_tests/write other_path
        (writ/make (myth/sing system_vocabulary/grove/view published.set_view(other_view).set_result((./ok other_view)))) pane_state)
      ambiguous_views (goo_browser/render_result context target [] view.slot view.role [] .none ambiguous_state)
      synthetic (either/ok_val (goo_browser/render_result context target goo_reflection/slot [] [] [] .none state))
      fresh_synthetic (either/ok_val (goo_browser/render_result context target goo_reflection/slot [] [] [] .none newer))
      [same index response] (helm/supervisor/handle
        (helm/card/snapshot 9 (goo_browser/render_response context target view_path [] [] [] .none)) state (sovereign_hive state))
      response_ok
        ?> (feet/task/develop request status body) response .false
        | (and (eq request 9) (and (eq status 200) (eq body (show result))))
      malformed
        \ fields=str
        ^ nat
        ?> (./reply response) (explorer_dev/interact (http_foot/request "POST" "/goo/render" fields) 0) 0
        response.status
      has (\ text=str value=json (maybe/is_some (str/find text (show value))))
    [(testing/nat "ordinary render has no workspace capabilities" 1 (equal (grove_dev/field "host" result) jnull))
     (testing/nat "legacy host registration has explicit absent capabilities" 1 (equal (grove_dev/field "host" hosted_result) jnull))
     (testing/nat "tree page prepares every requested slot" 2 children.len)
     (testing/nat "tree child carries all size variants" 3 child_layouts.len)
     (testing/nat "tree child renders real content" 1 (has "Before" (grove_dev/field "bundle" children.at(0))))
     (testing/nat "tree presentations share the membership snapshot" 1 (child_layouts.all((\ entry (equal captured (grove_dev/field "snapshot" (grove_dev/field "render" entry)))))))
     (testing/nat "missing child view rejects the page" 1 (either/is_err bad_tree))
     (testing/nat "stale prepared page is rejected" 1 (either/is_err stale_tree))
     (testing/nat "pane bundle contains three server prepared sizes" 3 layouts.len)
     (testing/text "pane policy is versioned" "pane-v1" (grove_dev/text (grove_dev/field "layoutPolicy" bundle)))
     (testing/text "small variant has a stable name" "sm" (grove_dev/text (grove_dev/field "size" layouts.at(0))))
     (testing/nat "sub-sm variant fits its allocation" 1 (equal (grove_dev/field "context" (layout 0)) (goo_bridge/context_json context)))
     (testing/nat "medium variant prepared at 480" 1 (equal (grove_dev/field "context" (layout 1)) (goo_bridge/context_json context.set_width((goo_fp/integer 480)))))
     (testing/nat "large variant prepared at 720" 1 (equal (grove_dev/field "context" (layout 2)) (goo_bridge/context_json context.set_width((goo_fp/integer 720)))))
     (testing/nat "all pane variants share one semantic snapshot" 1 (layouts.all((\ entry (equal captured (grove_dev/field "snapshot" (grove_dev/field "render" entry)))))))
     (testing/nat "all pane variants have matching HTML and display contexts" 1 (layouts.all((\ entry (equal (grove_dev/field "context" (grove_dev/field "render" entry)) (grove_dev/field "context" (grove_dev/field "display" (grove_dev/field "render" entry))))))))
     (testing/nat "all pane variants retain identical control evidence" 1 (layouts.all((\ entry (equal (grove_dev/field "controls" result) (grove_dev/field "controls" (grove_dev/field "render" entry)))))))
     (testing/nat "explicit width is prepared on server" 1 (equal (grove_dev/field "width" (grove_dev/field "context" display)) (goo_number/encode context.width)))
     (testing/nat "explicit scale is prepared on server" 1 (equal (grove_dev/field "textScale" (grove_dev/field "context" display)) (goo_number/encode context.scale)))
     (testing/text "direction shared by HTML and display" "rtl" (grove_dev/text (grove_dev/field "direction" (grove_dev/field "context" display))))
     (testing/nat "rendered snapshot is the captured object version" 1 (eq (grove_dev/text (grove_dev/field "expected" captured)) (nat/show (state.case(.x target)).fall(0))))
     (testing/nat "captured response retains old content" 1 (has "Before" result))
     (testing/nat "next snapshot renders changed content" 1 (has "After" fresh))
     (testing/nat "next snapshot advances object version" 0 (equal captured (grove_dev/field "snapshot" fresh)))
     (testing/nat "catalogue returns declaration plus synthetic inspection" 2 (grove_dev/items (grove_dev/field "views" catalog)).len)
     (testing/text "native subtree retains original route" "0" (grove_dev/text (grove_dev/field "node" native)))
     (testing/nat "missing publication rejected" 1 (either/is_err missing))
     (testing/nat "unregistered synthetic receiver rejected" 1 (either/is_err unregistered))
     (testing/nat "installed workspace chooses trusted receiver" 1 (has "Hosted" hosted_result))
     (testing/nat "workspace declaration cannot be substituted" 1 (either/is_err wrong_host))
     (testing/nat "hosted pane cannot dispatch from its synthetic receiver" 1 (either/is_err hosted_action))
     (testing/nat "hosted native node cannot dispatch from its synthetic receiver" 1 (either/is_err hosted_node_action))
     (testing/nat "synthetic inspection shares explicit render context" 1 (equal (grove_dev/field "context" synthetic) (goo_bridge/context_json context)))
     (testing/nat "synthetic inspection refreshes receiver values" 1 (has "After" fresh_synthetic))
     (testing/nat "synthetic inspection has no domain controls" 0 (grove_dev/items (grove_dev/field "controls" synthetic)).len)
     (testing/nat "slot and role selection excludes matching panes" 1 (either/is_ok slot_with_pane))
     (testing/nat "multiple matching views remain ambiguous" 1 (either/is_err ambiguous_views))
     (testing/nat "supervisor response shares immutable namespace state" 1 response_ok)
     (testing/nat "render is read only" 1 (eq same.local.top state.local.top))
     (testing/nat "valid integer HTTP context reaches snapshot handler" 0 (malformed "width=360&textScale=1&direction=ltr"))
     (testing/nat "valid decimal HTTP context reaches snapshot handler" 0 (malformed "width=360.5&textScale=1.25&direction=RTL"))
     (testing/nat "pane variant HTTP request reaches snapshot handler" 0 (malformed "width=240&textScale=1&direction=ltr&layouts=pane-v1"))
     (testing/nat "unknown layout policies are rejected" 400 (malformed "width=240&textScale=1&direction=ltr&layouts=unknown"))
     (testing/nat "trailing number garbage rejected" 400 (malformed "width=360x&textScale=1&direction=ltr"))
     (testing/nat "missing live context rejected" 400 (malformed "target=/object"))
     (testing/nat "invalid number rejected" 400 (malformed "width=NaN&textScale=1&direction=ltr"))
     (testing/nat "out of bounds scale rejected" 400 (malformed "width=100&textScale=11&direction=ltr"))
     (testing/nat "unsupported direction rejected" 400 (malformed "width=100&textScale=1&direction=auto"))
     (testing/nat "ambiguous node route rejected" 400 (malformed "width=100&textScale=1&direction=ltr&node=0.x"))]

  + live_actor
    \ ignored=unit
    ^ row[testing/check]
    = initial ns_fixture/namespace_tests/initial
      read={\ namespace}[nat str] (\ state=namespace [200 (nat/show state.local.top)])
      ;server (Spawn (helm/supervisor/run initial))
    ; (SendCaps server (helm/card/snapshot 71 read) [0])
    = ;[first caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/snapshot 72 read) [0])
    = ;[second more] (Recv[feet/task[unit]] 0)
      valid
        \ id=nat reply=feet/task[unit]
        ^ bool
        ?> (feet/task/develop request status body) reply .false
        | (and (eq request id) (and (eq status 200) (eq body (nat/show initial.local.top))))
    ; (CloseHandle server)
    [(testing/nat "actual supervisor accepts and dispatches snapshot ingress" 1 (valid 71 first))
     (testing/nat "repeated snapshot transport leaves namespace version unchanged" 1 (valid 72 second))]

+ tests
  ^ row[testing/case]
  [(testing/case "presentation inspection" goo_browser_checks/inspection)
   (testing/case "published slot titles" goo_browser_checks/slot_titles)
   (testing/case "path constructor" goo_browser_checks/path_views)
   (testing/case "live snapshot transport" goo_browser_checks/live_actor)
   (testing/case "live prepared rendering" goo_browser_checks/live_render)
   (testing/case "synthetic reflection" goo_browser_checks/synthetic_checks)
   (testing/case "interaction identities" goo_browser_checks/interactions)
   (testing/case "view previews" goo_browser_checks/render)
   (testing/case "temporal values" goo_browser_checks/temporal)
   (testing/case "v2 bridge" goo_browser_checks/bridge)
   (testing/case "indexed matches" goo_browser_checks/indexed_matches)
   (testing/case "development routes" goo_browser_checks/development_routes)
   (testing/case "cached catalog" goo_browser_checks/cached_catalog_checks)]
