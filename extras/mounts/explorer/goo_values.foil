- goo_reflection
- goo_value

+ goo_values
  + editor
    \ key=path value=pail
    ^ weft/node
    = mode (goo_value/mode value)
      prefix (path_show key)
      field
        \ suffix=str text=str
        ^ weft/node
        | weft/el "textarea" [(weft/att "data-value-input" (str/to_atom suffix))
            (weft/att "data-value-key" (str/to_atom (str/cat_all [prefix ":" suffix])))
            (weft/att "rows" "3") (weft/att "value" (str/to_atom text))] [(weft/tx (str/to_atom text))]
      input (field "value" (goo_value/input value))
      context (weft/leaf "input" [(weft/att "data-value-input" "context")
          (weft/att "data-value-key" (str/to_atom (str/cat prefix ":context")))
          (weft/att "value" "") (weft/att "placeholder" "Optional compiled Foil definition path")] "")
      choices=row[weft/node]
        ? (eq mode "foil") []
        [(weft/leaf "option" [(weft/att "value" (str/to_atom mode))] (str/to_atom mode))]
      choices choices.snoc((weft/leaf "option" [(weft/att "value" "foil")] "Foil expression"))
      selector (weft/el "select" [(weft/att "data-value-input" "kind")
          (weft/att "data-value-key" (str/to_atom (str/cat prefix ":kind"))) (weft/att "value" (str/to_atom mode))] choices)
    | weft/el "details" [(weft/cls "goo-value-editor") (weft/att "data-value-slot" (str/to_atom prefix))]
        [(weft/leaf "summary" [] "Edit value")
         (weft/el "form" [(weft/att "data-goo-value" (str/to_atom prefix))]
           [(weft/el "label" [] [(weft/tx "Input format") selector])
            (weft/el "label" [] [(weft/tx "Value") input])
            (weft/el "label" [(weft/att "data-foil-context" "")]
              [(weft/tx "Foil context") context])
            (weft/leaf "p" [(weft/cls "goo-value-hint") (weft/att "data-foil-context" "")]
              "Enter an expression returning the complete slot value, for example (pails/t ""New name""). Leave context empty for standard types.")
            (weft/leaf "button" [(weft/att "type" "submit")] "Save")
            (weft/leaf "button" [(weft/att "type" "button") (weft/att "data-value-cancel" "")] "Cancel")
            (weft/leaf "p" [(weft/att "role" "status")] "")])]
  + html
    \ context=goo_bridge/render_context target=path card=myth types=goo_reflection/registry titles=mop[path str lt_pith]
    ^ either[str str]
    = rows=either[str row[weft/node]]
        | card.tap.stream.take(64).fold (either/ok[str row[weft/node]] [])
          \ prior entry
          < rows prior
          < rendered (goo_reflection/prepare_with_titles context target types (myth/sing entry.key entry.val) titles)
          | ./ok rows.snoc((weft/el "section" [(weft/cls "goo-value-row")]
              [(weft/raw (str/to_atom (goo_html/fragment rendered))) (goo_values/editor entry.key entry.val)]))
    < rows rows
    | ./ok (str/from_atom (weft/render (weft/el "div" [(weft/cls "goo-values")]
        (? rows.len rows [(weft/leaf "p" [] "Empty object")]))))
