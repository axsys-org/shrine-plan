- browser_request
- web_mount
- goo_browser

+ explorer_mount
  + asset_files
    \ files=row[[str nat]]
    ^ row[[str nat]]
    | files.keep (\ [name bytes] (eq name.slice(0 4) "goo-"))
  + install
    \ state=namespace
    ^ either[pail namespace]
    = hand=path [state.self 'kook 'hex]
      [next index reply]
        | helm/supervisor/handle
          (helm/card/step hand
            (writ/make (form/card (def_form.set_talk(goo_browser/talk))
              (lore/line "Namespace explorer"))))
          state (sovereign_hive state)
    ?> (./ack failure) reply
      | ./err (pails/t "Explorer installation failed")
    ? (maybe/is_some failure)
      | ./err (pails/t "Explorer installation failed")
    = [next index reply]
        | helm/supervisor/handle
          (helm/card/step [state.self 'weft 'kook 'face]
            (writ/make (form/card zoo/form (lore/line "Component zoo"))))
          next (sovereign_hive next)
    ?> (./ack failure) reply
      | ./err (pails/t "Explorer component registry failed")
    ? (maybe/is_some failure)
      | ./err (pails/t "Explorer component registry failed")
    = next
        | source_mount/write [state.self 'io 'http]
          (myth/sing ['serve] (pails/p hand)) next
    | ./ok next
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        | ./wait
          | browser_request/req request.method request.target request.body
            (browser_routes/target request.target)
    = views
        \ request=http_foot/request now=nat
        ^ http_foot/action
        ? !(equal[str] request.method "GET")
          | ./reply (http_driver/response 405 "GET required")
        = target (http_foot/target request.target.slice(6 request.target.len))
          watch (crew/sing ['view] (dep .y target))
          watch watch.put(['catalog] (dep .z [state.self]))
          record (myth/sing ['vpath] (pails/p target))
          record record.put(['goo_browser] (pails/b .true))
        | ./wait record.put(crew_slot (cpail watch))
    = assets
        \ request=http_foot/request now=nat
        ^ http_foot/action
        = name request.target.slice(8 request.target.len)
          matches (files.keep((\ [key bytes] (eq key name))))
        ? (eq matches.len 0) (./reply (http_driver/response 404 "Asset not found"))
        = [name bytes] matches.at(0)
          mime=str (? (eq name.slice((sub name.len 4) 4) ".ttf") "font/ttf" "text/css")
        | ./reply (http_response 200 (http_foot/unbar bytes) mime)
    = asset_routes
        | (explorer_mount/asset_files files).map
        \ [name bytes]
        | http_foot/route (str/cat_all ["/static/" name]) assets
    = routes=row[http_foot/route] [(http_foot/route "/ns" plan) (http_foot/route "/views" views)]
    | http_foot/add_routes routes.weld(asset_routes) http_foot/empty
