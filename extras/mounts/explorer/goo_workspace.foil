- system_vocabulary
- goo_browser
- http_foot

' A mount-owned endpoint configuration. Requests choose only a subject path;
' declaration and receiver slot are fixed by the host, never by query input.
+ goo_workspace
  + endpoint
    : declaration=path source_slot=path initial=path
      validate={\ axal[myth]}maybe[str]
      operations=row[[path path]]
      document={\ path row[weft/node]}nat
  + request
    \ endpoint=goo_workspace/endpoint request=http_foot/request now=nat
    ^ http_foot/action
    ? !(equal[str] request.method "GET")
      | ./reply (http_driver/response 405 "GET required")
    = query (http_foot/fields (http_foot/split 63 request.target).at(1))
      text (http_foot/field "path" query)
      target=path (? text.len (http_foot/target text) endpoint.initial)
      watch (crew/sing ['view] (dep .y target))
      watch watch.put(['catalog] (dep .x [endpoint.declaration.at(0) 'weft 'view_catalog_cache]))
      record (myth/sing ['goo_workspace] (pails/p endpoint.declaration))
      record record.put(['workspace_target] (pails/p target))
    | ./wait record.put(crew_slot (cpail watch))
  + describe
    \ endpoint=goo_workspace/endpoint target=path selected=axal[myth] index=goo_browser/catalog_value
    ^ either[str str]
    ? (endpoint.validate selected)
     > (./some message) (./err message)
    = candidates index.views.keep((\ view (equal[path] view.view.name endpoint.declaration)))
    ? !(eq candidates.len 1) (./err "Workspace declaration is unavailable or ambiguous.")
    = published (goo_bridge/receiver target candidates.head)
      card (myth/sing endpoint.source_slot (pails/p target))
    ? !(published.view.is_pane) (./err "Workspace endpoint requires an @pane declaration.")
    ? !(published.view.ports.is_nil) (./err "Workspace entry pane must not require selection ports.")
    ?> (./ok view) published.result (./err "Workspace failed compilation.")
    ? !(goo_browser/matches card published) (./err "Workspace receiver does not satisfy its role.")
    | goo_panes/description published card view
  + members
    \ target=path selected=axal[myth] index=goo_browser/catalog_value node=json
    ^ row[weft/node]
    ? !(eq (grove_dev/text (grove_dev/field "source" node)) (path_show target)) []
    = slot (http_foot/target (grove_dev/text (grove_dev/field "slot" node)))
      browse (grove_dev/text (grove_dev/field "browse" node))
      rows
        | selected.kid_tap.stream.take(64).bind
          \ [key child]
          ^ list[weft/node]
          ?> (./some card) child.fil .nil
          = path target.snoc(key)
          ? !(goo_runtime/printable_path path) .nil
          =
            matches (goo_browser/matching card index).keep((\ view (equal[path] view.view.slot slot)))
            content=row[weft/node]
              ? (equal slot goo_documentation/summary_slot) [(goo_documentation/summary path card)]
              ? (eq matches.len 1) [(goo_browser/preview_at path card matches.head)] []
            content (? browse.len content.snoc((weft/leaf "a"
              [(weft/href (goo_panes/navigation_url (path_show path))) (weft/att "data-goo-navigation" "")] (str/to_atom browse))) content)
          | list/one (weft/el "div" [(weft/cls "goo-member") (weft/att "data-key" (str/to_atom (path_show path)))] content)
    [(weft/el "div" [(weft/att "data-goo-members" "")] rows.row)]
  + operations
    \ endpoint=goo_workspace/endpoint
    ^ str
    = entries
        | endpoint.operations.map
          \ [key source]
          | json/obj [(jkv "key" (json/str (path_show key)))
              (jkv "kind" (json/str "mount-rescan")) (jkv "source" (json/str (path_show source)))]
    | show (json/arr entries)
  + content
    \ endpoint=goo_workspace/endpoint target=path selected=axal[myth] index=goo_browser/catalog_value
    ^ row[weft/node]
    ? (goo_workspace/describe endpoint target selected index)
     > (./err message) [(weft/leaf "p" [(weft/cls "error")] (str/to_atom message))]
     > (./ok description)
      [(weft/el "div" [(weft/cls "goo-session") (weft/id "workspace")
         (weft/att "data-target" (str/to_atom (path_show target)))
         (weft/att "data-workspace" (str/to_atom (path_show endpoint.declaration)))
         (weft/att "data-view" (str/to_atom (path_show endpoint.declaration)))
         (weft/att "data-description" (str/to_atom description))
         (weft/att "data-operations" (str/to_atom (goo_workspace/operations endpoint)))]
         [(weft/el "div" [(weft/att "data-goo-body" "")]
           (goo_panes/server_body description (goo_workspace/members target selected index)))])]
  + talk
    \ endpoint=goo_workspace/endpoint fallback={\ bowl myth myth}yell =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ?> (./some declaration) out.path_at(['goo_workspace]) (fallback bowl cur add)
    ? !(equal[path] declaration endpoint.declaration) (fallback bowl cur add)
    = target (out.path_at(['workspace_target])).fall(endpoint.initial)
      selected bowl.crew.gut(['view] (axal/new[myth] .none))
      catalog bowl.crew.gut(['catalog] (axal/new[myth] .none))
      index (goo_browser/cached_index catalog)
      body (endpoint.document target (goo_workspace/content endpoint target selected index))
      done
        . out
          put(['res_status] (pd 200))
          put(['res_body] (pd body))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
  + receiver
    \ endpoint=goo_workspace/endpoint target=path state=namespace
    ^ either[str myth]
    ? (endpoint.validate (sovereign_care .y target state))
     > (./some message) (./err message)
    | ./ok (myth/sing endpoint.source_slot (pails/p target))
  + install
    \ endpoint=goo_workspace/endpoint fallback={\ bowl myth myth}yell state=namespace
    ^ either[pail namespace]
    = home=path [state.self 'kook 'hex]
      previous={\ bowl myth myth}yell
        ?> (./some record) (goo_runtime/record .x home state) fallback
        ?> (./some held) record.get(bond/form) fallback
        ?> behavior=form held fallback
        behavior.talk
      [next index reply]
        | helm/supervisor/handle
          (helm/card/step home
            (writ/make (form/card (def_form.set_talk((goo_workspace/talk endpoint previous)))
              (lore/line "Goo workspace")))) state (sovereign_hive state)
    ?> (./ack failure) reply (./err (pails/t "Workspace installation failed"))
    ? (maybe/is_some failure) (./err (pails/t "Workspace installation failed"))
    = host (goo_browser/hosted_receiver endpoint.declaration (goo_workspace/receiver endpoint))
      [next index reply]
        | helm/supervisor/handle
          (helm/card/step (goo_browser/hosted_path state.self endpoint.declaration)
            (writ/make (myth/sing system_vocabulary/content host))) next index
    ?> (./ack failure) reply (./err (pails/t "Workspace receiver registration returned no acknowledgement."))
    ? failure
     > (./some why) (./err why)
    | ./ok next
