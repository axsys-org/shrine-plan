{
  "version": 1,
  "name": "explorer",
  "dependencies": [
    "web",
    "goo"
  ],
  "modules": {
    "explorer_mount": "explorer_mount.foil",
    "goo_browser": "goo_browser.foil",
    "goo_bridge": "goo_bridge.foil",
    "explorer_dev": "explorer_dev.foil",
    "goo_reflection": "goo_reflection.foil",
    "goo_panes": "goo_panes.foil",
    "goo_workspace": "goo_workspace.foil"
  },
  "grove": [],
  "assets": {
    "/static/goo-reference.css": "goo-reference.css",
    "/static/goo-fonts.css": "goo-fonts.css",
    "/static/goo-Sans650.ttf": "goo-Sans650.ttf",
    "/static/goo-Mono400.ttf": "goo-Mono400.ttf",
    "/static/goo-Sans520.ttf": "goo-Sans520.ttf",
    "/static/goo-Sans750.ttf": "goo-Sans750.ttf",
    "/static/goo-Sans550.ttf": "goo-Sans550.ttf",
    "/static/goo-Sans620.ttf": "goo-Sans620.ttf",
    "/static/goo-Sans400.ttf": "goo-Sans400.ttf",
    "/static/goo-Italic400.ttf": "goo-Italic400.ttf",
    "/static/goo-dev.js": "goo-dev.js",
    "/static/goo-dev.html": "goo-dev.html",
    "/static/goo-actions.js": "goo-actions.js",
    "/static/goo-session.js": "goo-session.js",
    "/static/goo-panes.js": "goo-panes.js",
    "/static/goo-panes.css": "goo-panes.css",
    "/static/goo-workspace.js": "goo-workspace.js"
  },
  "files": {},
  "roots": [
    [
      "lib",
      "explorer_mount"
    ],
    [
      "lib",
      "goo_browser"
    ],
    [
      "lib",
      "goo_bridge"
    ],
    [
      "lib",
      "explorer_dev"
    ],
    [
      "lib",
      "goo_reflection"
    ],
    [
      "lib",
      "goo_panes"
    ],
    [
      "lib",
      "goo_workspace"
    ]
  ],
  "tests": {
    "tests/goo_browser": "test_goo_browser.foil",
    "tests/goo_v2": "test_goo_v2.foil",
    "tests/goo_panes": "test_goo_panes.foil"
  },
  "activate": {
    "module": "explorer_mount",
    "entry": [
      "explorer_mount",
      "install"
    ]
  },
  "http": {
    "module": "explorer_mount",
    "entry": [
      "explorer_mount",
      "http"
    ]
  },
  "routes": [
    "/ns",
    "/views",
    "/static/goo-reference.css",
    "/static/goo-fonts.css",
    "/static/goo-Sans650.ttf",
    "/static/goo-Mono400.ttf",
    "/static/goo-Sans520.ttf",
    "/static/goo-Sans750.ttf",
    "/static/goo-Sans550.ttf",
    "/static/goo-Sans620.ttf",
    "/static/goo-Sans400.ttf",
    "/static/goo-Italic400.ttf",
    "/grove/dev",
    "/static/goo-dev.js",
    "/static/goo-dev.html",
    "/goo",
    "/static/goo-actions.js",
    "/static/goo-session.js",
    "/static/goo-panes.js",
    "/static/goo-panes.css",
    "/static/goo-workspace.js"
  ],
  "host": "host.py"
}
