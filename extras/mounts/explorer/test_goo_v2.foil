- goo_app/tests
- goo_app/text_edit_tests

+ tests
  ^ row[testing/case]
  [(testing/case "Shared rich text contract" goo_text_tests/checks)
   (testing/case "Native Goo text commands" goo_text_edit_tests/checks)
   (testing/case "Shared run style contract" goo_run_tests/checks)
   (testing/case "v2 types" goo_type_tests/checks)
   (testing/case "v2 results" goo_result_tests/checks)
   (testing/case "v2 codecs" goo_codec_tests/checks)
   (testing/case "v2 semantics" goo_semantic_tests/checks)
   (testing/case "v2 measurement" goo_ascii_tests/checks)
   (testing/case "v2 layout" goo_layout_tests/checks)
   (testing/case "v2 HTML" goo_html_tests/checks)]
