- goo_app/wire_prepared
- http_foot
- testing

+ goo_wire_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = body (goo_wire/failure_bytes (goo_wire/failure "" (./some .false) .none .none))
      base (goo_profile/text_style (goo_fp/integer 1) "input" "rich-input")
      metadata (myth/sing ['sys 'modifiers] (pails/modifiers (row/stream[modifiers] [(modifiers/bold) (modifiers/italic) (modifiers/underline)]))).put(['sys 'link] (weblink "https://example.com"))
      bar (bat_flatten (bat_cat body (bat_bytes 1 1)))
    [(testing/nat "BAT HTTP final zero and Content-Length" 1 (eq (http_foot/encode_bat 200 body "application/x-protobuf") (http_foot/encode_bytes 200 bar "application/x-protobuf")))
     (testing/nat "false field protoc bytes" 4296015882 (bat_flatten (bat_cat (goo_wire/failure_bytes (goo_wire/failure "" (./some .false) .none .none)) (bat_bytes 1 1))))
     (testing/nat "geometry protoc bytes" 497323236409786642158884084318993943190937217745158868062049789676270227208547992600585 (bat_flatten (bat_cat (goo_wire/box_bytes (goo_wire/box 0 13831680355561635840 4647151865492930560 0)) (bat_bytes 1 1))))
     (testing/nat "receipt protoc bytes" 124702103009089834601840850244628294862346 (bat_flatten (bat_cat (goo_wire/operation_receipt_bytes (goo_wire/operation_receipt "save-1" "unknown")) (bat_bytes 1 1))))
     (testing/nat "typed resolved run agrees with legacy contract" 1
       (equal[maybe[goo_wire/resolved_run]] (./some (goo_wire/run_recipe base metadata "#354e41" (goo_fp/integer 123))) (goo_wire/resolved_run_from_json (goo_run/recipe base metadata "#354e41" (goo_fp/integer 123)))))
     (testing/nat "typed editing palette agrees with every legacy style" 1
       (equal[maybe[goo_wire/editing]] (./some (goo_wire/edit_contract base "#354e41")) (goo_wire/editing_from_json (goo_edit/contract base "#354e41"))))
    ]

+ tests
  ^ row[testing/case]
  [(testing/case "Goo typed protobuf BAT transport" goo_wire_checks/checks)]
