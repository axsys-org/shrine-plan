- goo_actions [at=current_actions]
- goo_bridge [at=current_bridge]
- goo_panes
- testing

+ goo_input_checks
  + group
    \ slots=row[path] children=list[goo/node]
    ^ goo/node
    = fields slots.map((\ slot (rex/rune "=" [(rex/quip (str/cat_all ["'" (path_show slot)])) (rex/word "input")])))
      myth (rex/expr rex/zero_span "curly" fields)
      args [(rex/rune "=" [(rex/word "on") (rex/word "card")])
        (rex/rune "=" [(rex/word "action") (rex/quip "'/action")])
        (rex/rune "=" [(rex/word "myth") myth])]
    | goo/node rex/zero_span "group" args.stream children
  + input
    \ slot=str role=str
    ^ goo/node
    | goo/node rex/zero_span "input" (row/stream[rex] [(rex/quip (str/cat_all ["'" slot])) (rex/cord role)]) .nil
  + button
    \ title=str
    ^ goo/node
    | goo/node rex/zero_span "action" (list/one (rex/cord title)) .nil
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = first (goo_input_checks/group [['source]] (row/stream[goo/node] [(goo_input_checks/input "/source" "rich-input") (goo_input_checks/button "A")]))
      second (goo_input_checks/group [['source]] (row/stream[goo/node] [(goo_input_checks/input "/source" "text") (goo_input_checks/button "B")]))
      inherited (goo/node rex/zero_span "col" .nil (list/one (goo_input_checks/button "Inherited")))
      root (goo_input_checks/group [['shared] ['source]] (row/stream[goo/node] [(goo_input_checks/input "/shared" "text") (goo_input_checks/input "/source" "text") first second inherited]))
      view (goo/view rex/zero_span ['demo 'inputs] ['demo 'card] ['sys 'slot 'content] "card" (list/one root) .false .nil)
      published (goo/published view .nil (grove_role_runtime/spec [] []) (./ok view))
      controls (current_bridge/goo_bridge/controls published myth/new view.children [] 1)
      at
        \ route=str
        ^ json
        | controls.keep((\ control (eq route (goo_runtime/json_text (goo_runtime/json_field "control" control))))).at(0)
      field (\ key=str route=str (goo_runtime/json_field key (at route)))
      string (\ key=str route=str (goo_runtime/json_text (field key route)))
      keys
        \ route=str
        ^ row[str]
        ?> (json/arr values) (field "inputBindings" route) []
        | values.map(goo_runtime/json_text)
      pane (goo_panes/controls published myth/new first [0 2])
      pane_input pane.at(0)
      pane_action pane.at(1)
      query (goo_runtime/request "act" ['page] ['page] view.name [] 0 0 0 [] 0)
      reflected (current_actions/goo_actions/controls view.children [] (goo_runtime/scope .none .none .nil .none .none) query "card")
      rich reflected.get([($u 0) ($u 2) ($u 1)]).fall(myth/new)
      plain reflected.get([($u 0) ($u 3) ($u 1)]).fall(myth/new)
      outer reflected.get([($u 0) ($u 4) ($u 0)]).fall(myth/new)
    [(testing/nat "all declared controls rendered" 7 controls.len)
     (testing/text "ancestor widget retains declared input owner" "0:/shared" (string "inputBinding" "0.0"))
     (testing/text "nearer source binding owns its rich widget" "0.2:/source" (string "inputBinding" "0.2.0"))
     (testing/text "sibling source binding remains distinct" "0.3:/source" (string "inputBinding" "0.3.0"))
     (testing/nat "action retains shared ancestor input" 1 (row/has[str] "0:/shared" (keys "0.2.1")))
     (testing/nat "action selects nearer source binding" 1 (row/has[str] "0.2:/source" (keys "0.2.1")))
     (testing/nat "action excludes shadowed ancestor source widget" 0 (row/has[str] "0:/source" (keys "0.2.1")))
     (testing/nat "layout-only group inherits source binding" 1 (row/has[str] "0:/source" (keys "0.4.0")))
     (testing/nat "sibling action excludes first group's binding" 0 (row/has[str] "0.2:/source" (keys "0.3.1")))
     (testing/text "pane input keeps absolute declared owner" "0.2:/source" (goo_runtime/json_text (goo_runtime/json_field "inputBinding" pane_input)))
     (testing/nat "pane action retains full inherited binding descriptors" 1 (equal (goo_runtime/json_field "inputBindings" pane_action) (field "inputBindings" "0.2.1")))
     (testing/text "headless rich source retains its encoding" "rich_text" rich.txt_at(['source 'goo 'input]))
     (testing/text "headless sibling plain source is not contaminated" "text" plain.txt_at(['source 'goo 'input]))
     (testing/text "headless inherited source keeps outer plain encoding" "text" outer.txt_at(['source 'goo 'input]))]
  + report
    ^ row[[str bool str str]]
    | (goo_input_checks/checks unit/unit).map((\ c [c.name c.pass c.want c.got]))

+ tests
  ^ row[testing/case]
  [(testing/case "declared input ownership" goo_input_checks/checks)]
