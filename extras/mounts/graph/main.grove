#import text=lib/grove/types/text
#import path_value=lib/grove/types/path

' Codecs retain native values; they introduce no persistent graph record type.

reference =
  @type
  ! foil
  safe
  + read
    \ raw=pail
    ^ maybe[reference]
    ?> value=safe raw .none
    | ./some value
  + write
    \ value=reference
    ^ pail
    | value
  + contract
    | curb/of_type (^ safe)

number =
  @type
  ! foil
  nat
  + read
    \ raw=pail
    ^ maybe[number]
    ?> value=pails/n raw .none
    | ./some value.n
  + write
    \ value=number
    ^ pail
    | pails/n value
  + contract
    | curb/of_type (^ pails/n)

claims =
  @norm
  #here ; "/[id=@tas]"
  "/subject": reference
  "/property": path_value
  "/value": text
  "/source": reference
  "/accepted": number
  #opt ;
    "/conflicting": number

accepted =
  @sewn
  #from ; claims
  #to ; claims
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    | graph_policy/accepted tree

conflicts =
  @sewn
  #from ; claims
  #to ; claims
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    | graph_policy/annotate tree

report =
  @sewn
  #meta ;
    "/sys/lede": "Accepted claims and their disagreements"
  #from ; claims
  #to ; claims
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    | conflicts/run (accepted/run tree)
