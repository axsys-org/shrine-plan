(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))

;; Measurements use the existing native clock and forcing boundary, as in
;; plangrm-profile. Compilation and input construction are outside the window.
;; This is a supplied-tree baseline, not a reader trace or lazy query benchmark.
(define (timed label input run size)
  (define forced (DeepSeq input 0))
  (define start (Seq forced (Now 0)))
  (define result (Seq start (run input)))
  (define end (Seq (DeepSeq result 0) (Now 0)))
  (Seq end
    (Seq (print ["GRAPH-COST" label "input_records" (size input)
      "output_records" (size result) "elapsed_ns" (Sub end start)])
      result)))

(define (check ignored)
  (define compiler (Pin "graph-cost-test"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define local (bootstrap:build-local ("x" 17) system resolve slot
    ["graph_cost_fixture"]))
  (define code (_1 local))
  (define fixture (Unpin (_1 (need (find (lambda (pair)
    (Equal "graph_cost_fixture" (_0 pair))) (_2 code))))))
  (define (helper name) (driver:get-perc ["graph_cost_fixture" name] fixture))
  (define make (helper "make"))
  (define narrow (helper "narrow"))
  (define size (helper "size"))
  (define edges (helper "edges"))
  (define narrow-edges (helper "narrow_edges"))
  (define report (helper "report"))
  (define baseline (helper "pairwise_report"))
  ;; Warm the same laws with different data; measured output is not a reused
  ;; warmup thunk. Every measured input is fully forced before its timestamp.
  (define warm (make 16 0))
  (define warmed (Seq (assert (Equal (baseline warm) (report warm)))
    (DeepSeq [(edges warm) (narrow-edges (narrow warm))
      (report warm) (report (narrow warm))] 0)))
  (define (sample count)
    (define broad (Seq warmed (make count count)))
    (define selected (narrow broad))
    (define a (timed "typed-edges/broad" broad edges size))
    (define b (Seq (DeepSeq a 0)
      (timed "typed-edges/selected" selected narrow-edges size)))
    (define c (Seq (DeepSeq b 0)
      (timed "accepted-conflicts/broad" broad report size)))
    (define d (Seq (DeepSeq c 0)
      (timed "accepted-conflicts/selected" selected report size)))
    (Seq (DeepSeq d 0)
      (begin
        (assert (Eq count (size broad)))
        (assert (Eq 1 (size selected)))
        (assert (Eq (Mul count 2) (size a)))
        (assert (Eq 2 (size b)))
        (assert (Eq count (size c)))
        (assert (Eq 1 (size d)))
        (print ["GRAPH-COST-CASE" "records" count
          "group_lookups_derived" (Mul count 2)
          "equal-value_comparisons_derived" (Sub count 1)
          "selected_group_lookups_derived" 2
          "quadratic_baseline_pairs_derived" (Mul count count)])
        1)))
  (Seq (sample 32) (Seq (sample 128) (sample 512))))
(#export check)
