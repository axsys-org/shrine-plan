- bond
- sys/demand

' Published demand policy. The existing native reader supplies reads and tracks
' observations; these constructors choose explicit placements without a registry.
+ graph_demand
  + at
    ' A child's local case is not its parent's. Select inside the pinned
    ' snapshot before appending the relative address.
    \ source=safe relative=path cr=care
    ^ safe
    ? (eq source.ver 0) (safe 0 cr source.path.weld(relative))
    = prefix=path ['h (care/seg source.care) ($u source.ver) ($u source.path.len)]
    | safe 0 cr prefix.weld(source.path).weld(relative)
  + children
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some held) context.get(bond/tack) (./fail "missing input")
    ?> source=safe held (./fail "missing input")
    | ./graft (graph_demand/at source relative cr)
  + gather
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    = members
        | context.tap.fold (axal/new[safe] .none)
          \ out [slot held]
          ? ((equal[path] slot bond/weft) || (equal[path] slot bond/tack)) out
          ?> source=safe held out
          | out.put slot source
    | graph_demand/collection members cr relative select
  + collection
    \ members=axal[safe] cr=care relative=path select=view_select
    ^ view_plan
    = placement=maybe[[safe path]]
        % width=nat relative.len
        ^ maybe[[safe path]]
        ? (members.get(relative.take(width)))
         > (./some source) (./some [source relative.drop(width)])
        ? (eq width 0) .none
        | _ width.dec
    ? placement
     > (./some found)
      = [source tail] found
      | ./graft (graph_demand/at source tail cr)
    = branch members.dip(relative)
      base (axal/new[myth] (./some myth/new))
    ? (and (eq branch.kid.size 0) branch.fil.is_none) (./fail "missing branch")
    ? (equal[care] cr .x) (./done base)
    = entries branch.tap
    ? (equal[view_select] select .names)
      | ./done (entries.fold(base (\ out [name source] out.put(name myth/new))))
    % i=nat 0 result=axal[myth] base
    ^ view_plan
    ? (eq i entries.len) (./done result)
    = [name source] entries.at(i)
      read_care=care (? (equal[care] cr .y) .x .z)
      ref (graph_demand/at source [] read_care)
      resume (_ i.inc)
    | ./need (view_read ref select)
      \ value=res[axal[myth]]
      ^ view_plan
      = status=iota (? (?=(.null value)) 'absent 'unresolved)
        placeholder (myth/sing ['sys 'view 'origin] ref).put(['sys 'view 'state] (pails/q status))
      ?> (./known tree) value (resume result.put(name placeholder))
      | resume (tree.tap.fold(result (\ out [suffix record] out.put(name.weld(suffix) record))))
  + children_card
    ^ myth
    | myth/sing bond/weft (woven graph_demand/children)
  + gather_card
    ^ myth
    | myth/sing bond/weft (woven graph_demand/gather)
