- graph_references
- grove_role_runtime

' Small, explicit assertion policy. The caller supplies the evidence and any
' identity group. No names, prose or same slots silently create equivalence.
+ graph_policy
  + subject_key
    ' A structural key, not a display spelling. Lengths delimit arbitrary
    ' paths; care, local version and complete /h addresses remain distinct.
    \ subject=safe
    ^ path
    = prefix=path [(care/seg subject.care) ($u subject.ver) ($u subject.path.len)]
    | prefix.weld subject.path
  + property_key
    \ record=myth
    ^ maybe[path]
    ?> (./some property) record.path_at(['property]) .none
    = prefix=path [($u property.len)]
    | ./some (prefix.weld(property))
  + claim_key
    \ record=myth
    ^ maybe[path]
    ?> subject=safe record.pail_at(['subject]) .none
    ?> (./some property) (graph_policy/property_key record) .none
    | ./some ((graph_policy/subject_key subject).weld(property))
  + select
    \ subjects=row[safe] input=axal[myth]
    ^ axal[myth]
    = members
        | subjects.fold (axal/new[bool] .none)
          \ out subject
          | out.put (graph_policy/subject_key subject) .true
    | input.tap.fold (axal/new[myth] .none)
      \ out [at record]
      ?> subject=safe record.pail_at(['subject]) out
      ? !(members.get((graph_policy/subject_key subject)).fall(.false)) out
      | out.put at record
  + accepted
    \ input=axal[myth]
    ^ axal[myth]
    | input.tap.fold (axal/new[myth] .none)
      \ out [at record]
      ? !(eq record.nat_at(['accepted] 0) 1) out
      | out.put at record
  + disagrees
    ' Identity is exact safe equality, including care and historical address.
    \ left=myth right=myth
    ^ bool
    ?> a=safe left.pail_at(['subject]) .false
    ?> b=safe right.pail_at(['subject]) .false
    ? !(equal[safe] a b) .false
    | graph_policy/property_disagrees left right
  + property_disagrees
    \ left=myth right=myth
    ^ bool
    ?> (./some ka) left.path_at(['property]) .false
    ?> (./some kb) right.path_at(['property]) .false
    ? !(equal[path] ka kb) .false
    ?> (./some va) left.get(['value]) .false
    ?> (./some vb) right.get(['value]) .false
    | !(equal[pail] va vb)
  + annotate
    ' Every assertion survives with all its qualifiers and source. Only the
    ' derived conflicting slot is owned by this transform; nothing is merged.
    \ input=axal[myth]
    ^ axal[myth]
    | graph_policy/annotate_by graph_policy/claim_key input
  + groups
    ' Invocation-local native tree. Retain one value and a disagreement bit
    ' per key; this is neither a stored index nor a namespace registration.
    \ key={\ myth}maybe[path] input=axal[myth]
    ^ axal[[pail bool]]
    | input.tap.fold (axal/new[[pail bool]] .none)
      \ out=axal[[pail bool]] entry=[path myth]
      ^ axal[[pail bool]]
      = [at record] entry
      ?> (./some group) (key record) out
      ?> (./some value) record.get(['value]) out
      ? out.get(group)
       > (./some pair)
         = [first conflict] pair
         ? conflict out
         ? (equal[pail] first value) out
         = next=[pail bool] [first .true]
         | out.put group next
       > .none
         = next=[pail bool] [value .false]
         | out.put group next
  + annotate_by
    \ key={\ myth}maybe[path] input=axal[myth]
    ^ axal[myth]
    = groups=axal[[pail bool]] (graph_policy/groups key input)
    | input.tap.fold (axal/new[myth] .none)
      \ out=axal[myth] entry=[path myth]
      ^ axal[myth]
      = [at record] entry
      = conflict=bool
          ?> (./some value) record.get(['value]) .false
          ?> (./some group) (key record) .false
          ?> (./some pair) groups.get(group) .false
          = [first different] pair
          | different
      | out.put at record.put(['conflicting] (pails/n (? conflict 1 0)))
  + report
    \ input=axal[myth]
    ^ axal[myth]
    | graph_policy/annotate (graph_policy/accepted input)
  + group_report
    ' The caller explicitly asserts that these subjects form one identity
    ' group for this projection. Original subjects and evidence stay intact.
    \ subjects=row[safe] input=axal[myth]
    ^ axal[myth]
    | graph_policy/annotate_by graph_policy/property_key
      (graph_policy/accepted (graph_policy/select subjects input))
