(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))

;; Real compiled Grove laws published into a disposable native namespace.
;; Keep this outside module loading: compiler products are not template roots.
(define (check ignored)
  (define compiler (Pin "graph-publication-test"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define local (bootstrap:build-local ("x" 17) system resolve slot
    ["grove_backend" "graph_policy" "graph_publication_fixture"]))
  (define code (_1 local))
  (define prepared (backend:prepare-with code "graph_policy"))
  (define policy (_1 prepared))
  (define fixture (Unpin (_1 (need (find (lambda (pair)
    (Equal "graph_publication_fixture" (_0 pair))) (_2 code))))))
  (define (helper name) (driver:get-perc ["graph_publication_fixture" name] fixture))
  (define (path names) (Weld [("x" 17)] (map (lambda (name) ("ts" name)) names)))
  (define (ok result)
    (If (Equal "ok" (Hd result)) (_0 result)
      (error ["graph-publication-test" (_0 result)])))
  (define (publish root text state)
    (define document (ok ((driver:get-perc ["grove" "parse"] policy) text)))
    ;; Compiler predecessor names are canonical [aura payload] pairs;
    ;; native namespace ports consume the corresponding iota spines.
    (define (previous key)
      ((helper "previous") state (map (lambda (part) ((_0 part) (_1 part))) key)))
    (define (lookup key)
      (define absolute
        (If (And (Sz key) (Or (Eq "x" (Hd (_0 key))) (Equal ("ts" "sys") (_0 key))))
          key (Weld [("x" 17)] key)))
      ((helper "lookup") state absolute))
    (define records (ok (backend:compile prepared previous lookup root document)))
    (_0 (ok (backend:publish prepared records 0 0 state))))
  (define codecs (publish (path ["lib" "grove" "types"])
    (read-text-file "grove/value_codecs.grove") (_0 local)))
  (define source (read-text-file "grove/graph/main.grove"))
  (define first (publish (path ["gov" "graph"]) source codecs))
  (define captured ((helper "seed") first))
  assert(Equal [2 2] ((helper "current") ("ts" "captured") captured))
  ;; B deliberately accepts all supplied claims. It imports A's exact norm
  ;; artifact, rather than regenerating record contracts to match by shape.
  (define next-source "#import claims=gov/graph/claims

report =
  @sewn
  #from ; claims
  #to ; claims
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    | graph_policy/annotate tree
")
  (define second (publish (path ["gov" "graph"]) next-source captured))
  assert(Equal [2 2] ((helper "current") ("ts" "captured") second))
  (define selected ((helper "bind") 2 ("ts" "selected") second))
  assert(Equal [3 3] ((helper "current") ("ts" "selected") selected))
  (define changed ((helper "change") selected))
  assert(Equal [2 0] ((helper "current") ("ts" "captured") changed))
  assert(Equal [3 3] ((helper "current") ("ts" "selected") changed))
  assert(Equal [2 2] ((helper "snapshot") captured changed))
  assert(Eq 1 ((helper "history") captured changed))
  ;; The input and publication changes do not mutate the earlier namespace.
  assert(Equal [2 2] ((helper "current") ("ts" "captured") captured))
  1)
(#export check)
