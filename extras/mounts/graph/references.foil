- shrine_types
- sept
- bond

' Pure projections of supplied evidence. No namespace reader or stored index.
+ graph_references
  + incoming_bindings
    ' Deliberately select live holder contents from a supplied /r result.
    ' Scope bounds ownership; one holder gets one stable, nonoverlapping alias
    ' even when several of its slots reference the subject. No reads occur here.
    \ scope=path incoming=axal[myth]
    ^ row[[path safe]]
    = selected=axal[safe]
        | incoming.tap.fold (axal/new[safe] .none)
          \ out [at card]
          ?> (./some held) card.get(['holder]) out
          ?> name=pails/p held out
          = holder name.p
          ? !(pith_prefix scope holder) out
          | out.put holder (safe 0 .x holder)
    | selected.tap.map
      \ [holder reference]
      = alias=path ['evidence ($u holder.len)]
      | [alias.weld(holder) reference]
  + holder
    \ scope=safe relative=path
    ^ safe
    ? (eq scope.ver 0) (safe 0 .x scope.path.weld(relative))
    = head=path ['h (care/seg scope.care) ($u scope.ver) ($u scope.path.len)]
    | safe 0 .x head.weld(scope.path).weld(relative)
  + slots
    \ record=myth
    ^ row[[path safe]]
    | record.tap.fold []
      \ out [slot held]
      ?> target=safe held out
      | out.snoc [slot target]
  + prose
    ' Optional adapter: bracketed paths have no native reference authority.
    \ text=str
    ^ row[safe]
    = pieces (str/split_byte 91 text)
    % i=nat 1 out=row[safe] []
    ^ row[safe]
    ? (ge i pieces.len) out
    = inner (str/split_byte 93 pieces.at(i))
    ? (lt inner.len 2) (_ i.inc out)
    = span inner.at(0)
    ? !(eq (str/slice 0 1 span) "/") (_ i.inc out)
    ?> (./some target) (path_parse span) (_ i.inc out)
    | _ i.inc out.snoc((safe 0 .x target))
  + prose_slots
    \ record=myth
    ^ row[[path safe]]
    | record.tap.fold []
      \ out [slot held]
      ?> text=pails/t held out
      | (graph_references/prose text.t).fold out
        \ found target
        | found.snoc [slot target]
  + project
    \ extract={\ myth}row[[path safe]] scope=safe input=axal[myth]
    ^ axal[myth]
    = initial=[nat axal[myth]] [0 (axal/new[myth] .none)]
      [count result]
        | input.tap.fold initial
          \ out [relative record]
          | (extract record).fold out
            \ [index rows] [slot target]
            = edge
                . (myth/sing ['source] scope)
                  put(['holder] (graph_references/holder scope relative))
                  put(['slot] (pails/p slot))
                  put(['target] target)
            | [index.inc (rows.put([($u index)] edge))]
    | result
  + edges
    \ scope=safe input=axal[myth]
    ^ axal[myth]
    | graph_references/project graph_references/slots scope input
  + prose_edges
    \ scope=safe input=axal[myth]
    ^ axal[myth]
    | graph_references/project graph_references/prose_slots scope input
  + read
    ' Keep absence and unavailable distinct from a known empty collection.
    \ scope=safe input=res[axal[myth]]
    ^ res[axal[myth]]
    ? input
     > (./known tree) (./known (graph_references/edges scope tree))
     > .null .null
     > .unknown .unknown
