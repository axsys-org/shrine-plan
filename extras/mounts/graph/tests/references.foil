- graph_references
- lain_types
- testing

+ graph_reference_tests
  + incoming
    \ ignored=unit
    ^ row[testing/check]
    = scope=path [($x 1) 'evidence]
      holder=path scope.snoc('report)
      card (myth/sing ['holder] (pails/p holder))
      cards (axal/new[myth] .none).put(['first] card).put(['second] card)
      cards cards.put(['outside] (myth/sing ['holder] (pails/p [($x 1) 'notes])))
      cards cards.put(['scope] (myth/sing ['holder] (pails/p scope)))
      bindings (graph_references/incoming_bindings scope cards)
      empty (graph_references/incoming_bindings scope (axal/new[myth] .none))
      [first ignored] bindings.at(0)
      [second ignored] bindings.at(1)
    [(testing/nat "incoming selection deduplicates holders and excludes other scopes" 2 bindings.len)
     (testing/nat "a selected holder is an explicit live x reference" 1
       (bindings.all((\ [alias source] (and (eq source.ver 0) (equal[care] source.care .x))))))
     (testing/nat "parent and child holders have nonoverlapping aliases" 1
       !((pith_prefix first second) || (pith_prefix second first)))
     (testing/nat "empty incoming selection releases every binding" 0 empty.len)]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = root=path [($x 1) 'evidence]
      a=path [($x 1) 'a]
      b=path [($x 1) 'b]
      live (safe 0 .z root)
      old (safe 1 .z root)
      exact (safe 3 .z b)
      record (myth/sing ['related] exact).put(['description] (pails/t "See [/0x01/a]"))
      source (axal/new[myth] .none).put(['claim] record)
      typed (graph_references/edges live source)
      held typed.get([($u 0)]).fall(myth/new)
      historical (graph_references/edges old source)
      historical_record historical.get([($u 0)]).fall(myth/new)
      expected_holder (safe 0 .x ['h 'z ($u 1) ($u 2) ($x 1) 'evidence 'claim])
      epoch_scope (safe 0 .z ['h 'z 'e7 ($u 2) ($x 1) 'evidence])
      epoch_result (graph_references/edges epoch_scope source)
      epoch_holder epoch_result.get([($u 0)]).fall(myth/new).get(['holder])
      epoch_expected (safe 0 .x epoch_scope.path.snoc('claim))
      prose (graph_references/prose_edges live source)
      empty (graph_references/read live (./known (axal/new[myth] .none)))
      known_empty
        ?> (./known tree) empty .false
        | eq tree.tap.len 0
      unavailable (graph_references/read live .unknown)
      culled (graph_references/read live .null)
      changed source.put(['claim] (myth/sing ['related] (safe 0 .x a)))
      newer (graph_references/edges live changed)
      original_after (graph_references/edges live source)
    [(testing/nat "typed reference projection ignores prose unless explicitly selected" 1 typed.tap.len)
     (testing/nat "complete target care and version remain attached" 1
       (equal[maybe[pail]] (held.get(['target])) (./some exact)))
     (testing/nat "holder keeps its authoritative source path" 1
       (equal[maybe[pail]] (held.get(['holder])) (./some (safe 0 .x root.snoc('claim)))))
     (testing/nat "original selected scope remains attached" 1
       (equal[maybe[pail]] (held.get(['source])) (./some live)))
     (testing/nat "reference slot is retained" 1
       (equal[maybe[path]] (held.path_at(['slot])) (./some ['related])))
     (testing/nat "historical holder keeps care and case in its snapshot address" 1
       (equal[maybe[pail]] (historical_record.get(['holder])) (./some expected_holder)))
     (testing/nat "epoch-qualified scope remains qualified when followed outside the projection" 1
       (equal[maybe[pail]] epoch_holder (./some epoch_expected)))
     (testing/nat "opt-in prose adapter finds its supplied bracketed path" 1 prose.tap.len)
     (testing/nat "prose extraction never changes the typed projection" 1
       (equal typed (graph_references/edges live source)))
     (testing/nat "a known empty collection stays known empty" 1 known_empty)
     (testing/nat "unavailable input stays unknown" 1 (?=(.unknown unavailable)))
     (testing/nat "culled input stays null" 1 (?=(.null culled)))
     (testing/nat "changed supplied tree changes the derived projection" 0 (equal typed newer))
     (testing/nat "retained input still produces its retained answer" 1 (equal typed original_after))]

+ tests
  ^ row[testing/case]
  [(testing/case "pure reference projections preserve evidence identity" graph_reference_tests/checks)
   (testing/case "explicit live holder selection" graph_reference_tests/incoming)]
