- graph_policy
- flow_test_world [at=fixture]
- json [at=controlled_json]

' A fixture-specific presentation of structured assertions to an authored
' revision flow. The calculation, request, provider, hole and writer all use
' existing contracts. The controlled provider reuses the native worker protocol
' and decides from this attempt's frozen structured report.
+ graph_flow_tests
  + context_binding
    \ record=myth entry=mop/kv[path pail]
    ^ myth
    ? (pith_prefix ['evidence] entry.key) record
    | record.put(entry.key entry.val)
  + select_context
    ' Authored native hand: select explicit live evidence aliases, then let
    ' existing cell dependency expansion subscribe to their contents.
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    = incoming b.crew.gut(['incoming] flow_ops/empty)
      scope record.path_at(['scope]).fall([])
      bindings (graph_references/incoming_bindings scope incoming)
    ?> subject=safe record.pail_at(bond/tack) (yell [] record)
    = retained (row/fold[mop/kv[path pail] myth] myth/new graph_flow_tests/context_binding record.tap)
      selected (row/fold[[path safe] myth] retained (\ out [slot source] out.put(slot source)) bindings)
    ? (equal selected record) (yell [] record)
    ' Hand out-values are patches. Removing owned aliases requires the
    ' existing explicit replacement card; do not change that native axiom.
    | yell [[b.here (writ/make selected)]] record
  + select_talk
    \ b=bowl record=myth input=myth
    ^ yell
    | graph_flow_tests/select_context b record.meld(input) []
  + report
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | graph_policy/report input.dip(['evidence])
  + worker
    \ target=path request=native_work/request
    ^ myth
    = record (fixture/flow_revision_tests/hole_worker target request)
      deps record.crew_at(crew_slot).put(['task] (dep .x request.owner))
    | record.put(crew_slot (cpail deps))
  + produce
    ' Inspect the frozen structured task, never a phrase in an old draft.
    \ b=bowl record=myth
    ^ yell
    ? record.has(['work 'outcome]) (yell [] record)
    ?> (./some guard) (native_work_ops/captured_at b.crew.gut(['guard] flow_ops/empty)) (yell [] record)
    = card b.crew.gut(['task] flow_ops/empty).fil.fall(myth/new)
    ?> job=flow_work/request card.pail_at(['flow 'request]) (yell [] record)
    = evidence (unpin (unpin job.task).evidence)
    ?> report=cell_view evidence.get(['claims]).fall(myth/new).pail_at(['graph 'report]) (yell [] record)
    = claims (unpin report.tree)
      ready (and claims.wyt (claims.tap.all((\ [at claim] (eq claim.nat_at(['conflicting] 99) 0)))))
      source=str (? ready (str/from_atom (joined 10 [";= Supported concept" "  Required evidence is now available."])) "")
      note=str (? ready "The captured structured claims agree." "The captured structured claims conflict.")
      text (controlled_json/show (controlled_json/json/obj
        [(controlled_json/jkv "source" (controlled_json/json/str source))
         (controlled_json/jkv "note" (controlled_json/json/str note))]))
    | native_work_ops/result b.here (native_work/outcome "complete" text (pin guard)) record
  + worker_hear
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    | graph_flow_tests/produce b record
  + worker_talk
    \ b=bowl record=myth input=myth
    ^ yell
    | graph_flow_tests/produce b record.meld(input)
  + evidence
    \ args=axal[myth]
    ^ either[iota axal[myth]]
    = claims args.dip(['claims])
    ? !(claims.wyt) (./err 'graph_missing_claims)
    = conflict (claims.tap.any((\ [at record] (eq record.nat_at(['conflicting] 0) 1))))
      text=str (? conflict "The accepted claims disagree; further evidence is required." "The accepted claims agree; required evidence is now available.")
      source (flow/source "structured-claims" (str/repeat 64 "a") "text" text)
      record (myth/sing ['flow 'source] source).put(system_vocabulary/lede (pails/t "Structured claims"))
      record record.put(['graph 'report] (cell_view (pin claims)))
    | ./ok (flow_ops/empty).put(['claims] record)
  + source
    ^ str
    | str/from_atom (joined 10
      [";. /graph_review" "  ;@ /flow/definition graph_review" "  ;= Review structured assertions"
       "    ;@ /flow/input claims" "    ;= Computed assertion report"
       "    ;@ /flow/step sources ;/0x11/gov/graph_test/evidence"
       "    ;@ /flow/bind claims claims" "    ;= Present the explicit report as evidence"
       "    ;@ /flow/step authored ;/0x11/gov/flows/operations/revise"
       "    ;@ /flow/bind pages document" "    ;@ /flow/bind sources sources" "    ;= Interpret the assertions"
       "    ;@ /flow/step pages ;/0x11/gov/flows/operations/evidence"
       "    ;@ /flow/bind pages authored" "    ;@ /flow/bind sources sources" "    ;= Publish the explained result"
       "    ;@ /flow/result pages" "    ;= Result"
       "    ;@ /flow/page /" "    ;@ /flow/uses claims" "    ;= Assertion review"
       "      Explain the supplied accepted claims. Keep uncertainty explicit."])
  + claim
    \ value=str
    ^ myth
    | (myth/sing ['subject] (safe 0 .x [($x 17) 'user 'company])).put(['property] (pails/p ['founded])).put(['value] (pails/t value)).put(['accepted] (pails/n 1)).put(['source] (safe 1 .x [($x 17) 'user 'filing]))
  + generation
    \ controller=path state=namespace
    ^ nat
    ?> progress=flow_maintenance/progress (fixture/flow_tests/get controller state).pail_at(['flow 'progress]) 0
    progress.generation
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      page=path [($x 17) 'app 'nenex 'w 'graph_review]
      definition=path page.weld(['flows 'graph_review])
      controller=path page.weld(['work 'review])
      destination=path [($x 17) 'app 'nenex 'w 'graph_result]
      input=path [($x 17) 'user 'graph_claims]
      subject=path [($x 17) 'user 'company]
      context=path [($x 17) 'user 'graph_context]
      select_form=path [($x 17) 'gov 'graph_test 'select_context]
      report=path [($x 17) 'user 'graph_report]
      adapter=path [($x 17) 'gov 'graph_test 'evidence]
      provider=path [($x 17) 'gov 'graph_test 'provider]
      initial fixture/flow_tests/initial
      initial (fixture/flow_tests/poke [($x 17) 'user 'filing]
        (myth/sing ['title] (pails/t "Retained filing evidence for the fixture")) initial)
      initial (fixture/flow_tests/poke input.snoc('first) (graph_flow_tests/claim "2010") initial)
      initial (fixture/flow_tests/poke input.snoc('second) (graph_flow_tests/claim "2011") initial)
      initial (fixture/flow_tests/poke subject (myth/sing ['name] (pails/t "Company")) initial)
      initial (fixture/flow_tests/poke select_form
        (myth/sing system_vocabulary/form (def_form.set_init(native_work_ops/wake).set_hear(graph_flow_tests/select_context).set_talk(graph_flow_tests/select_talk))) initial)
      selection=myth (native_work_ops/lens (safe 0 .x subject) 'subject [])
      selection selection.put(['scope] (pails/p input)).put(limb_slot (kook [select_form])).put(crew_slot (cpail (crew/sing ['incoming] (dep .z (r_spell subject)))))
      selection selection.put(['note] (pails/t "Keep context annotations"))
      initial (fixture/flow_tests/poke context selection initial)
      initial (fixture/flow_tests/poke report
        (myth/sing bond/weft (spun graph_flow_tests/report .none)).put(bond/tack (safe 0 .z context.cons(xs))) initial)
      initial (fixture/flow_tests/poke adapter
        (myth/sing (flow_ops/key initial.self 'operation) (flow/operation ['claims] graph_flow_tests/evidence)) initial)
      authored (fixture/flow_tests/apply 'author page (myth/sing ['source] (pails/t graph_flow_tests/source)) initial)
      published (fixture/flow_tests/apply 'publish page
        (myth/sing ['id] (pails/t "graph_review")).put(['expected] (pails/n authored.case(.x page).fall(0))) authored)
      installed (fixture/flow_tests/poke fixture/flow_revision_tests/worker_form
        (myth/sing system_vocabulary/form (def_form.set_init(native_work_ops/wake).set_hear(graph_flow_tests/worker_hear).set_talk(graph_flow_tests/worker_talk))) published)
      installed (fixture/flow_tests/poke provider
        (myth/sing ['work 'provider] (native_work/provider graph_flow_tests/worker)) installed)
      request (myth/sing ['definition] (safe installed.case(.x definition).fall(0) .x definition))
      request request.put(['destination] (pails/p destination)).put(['writer] (safe 0 .x [($x 17) 'gov 'flows 'nenex]))
      request request.put(['input 'claims] (safe 0 .z report.cons(xs))).put(['provider] (safe 0 .x provider))
      followed (fixture/flow_tests/apply 'follow controller request installed)
      first=path controller.weld(['work 'revision_1])
    ?> task=flow_work/request (fixture/flow_tests/get first followed).pail_at(['flow 'request])
      [(testing/nat "authored graph flow creates a native revision request" 1 0)]
    = old_task task.task
      capture (unpin task.task).evidence
      repeated (fixture/flow_tests/apply 'follow controller request followed)
      changed (fixture/flow_tests/poke input.snoc('second) (graph_flow_tests/claim "2010") repeated)
      hole (fixture/flow_tests/get task.hole changed)
      latest=maybe[path]
        ?> status=native_work/hole_state hole.pail_at(['work 'hole_state]) .none
        status.attempt
      advanced=bool
        ?> (./some at) latest .false
        | !(equal[path] at first)
      retry (fixture/flow_tests/apply 'follow controller request changed)
      overlay (sovereign_care .z first.snoc('view).cons(xs) changed)
      changed_report (sovereign_care .z report.cons(xs) changed)
      extra input.snoc('third)
      expanded (fixture/flow_tests/poke extra (graph_flow_tests/claim "2012") changed)
      expanded_report (sovereign_care .z report.cons(xs) expanded)
      failed_head=maybe[path]
        ?> state=native_work/hole_state (fixture/flow_tests/get task.hole expanded).pail_at(['work 'hole_state]) .none
        state.attempt
      released (fixture/flow_tests/poke extra (graph_flow_tests/claim "2012").put(['subject] (safe 0 .x [($x 17) 'user 'other_company])) expanded)
      released_context=myth (fixture/flow_tests/get context released)
      obsolete (fixture/flow_tests/poke extra (graph_flow_tests/claim "2013").put(['subject] (safe 0 .x [($x 17) 'user 'other_company])) released)
      again (fixture/flow_tests/poke extra (graph_flow_tests/claim "2012") obsolete)
      new_head=maybe[path]
        ?> state=native_work/hole_state (fixture/flow_tests/get task.hole again).pail_at(['work 'hole_state]) .none
        state.attempt
      historical (row/all[care]
        (\ car=care (equal[res[axal[saga]]]
          (namespace/page car followed.case(car first) first followed)
          (namespace/page car followed.case(car first) first again))) [.x .y .z])
      preserved=bool
        ?> saved=flow_work/request (fixture/flow_tests/get first changed).pail_at(['flow 'request]) .false
        | equal[pin[flow/task]] old_task saved.task
      retained_conflict=bool
        ?> value=cell_view (unpin capture).gut(['claims] myth/new).pail_at(['graph 'report]) .false
        | (unpin value.tree).tap.any((\ [at record] (eq record.nat_at(['conflicting] 0) 1)))
    [(testing/nat "Semidoc publishes the graph review through native authoring" 1
       (fixture/flow_tests/get definition published).has((flow_ops/key published.self 'definition)))
     (testing/nat "structured claims enter through an existing spun cell" 1
       (fixture/flow_tests/get report followed).has(bond/weft))
     (testing/nat "conflicting report leaves the shared revision unresolved" 1
       (equal[pail] (pails/q 'flow_revision_unresolved) (fixture/flow_tests/get first followed).pail_at(['flow 'refused])))
     (testing/nat "unresolved interpretation publishes no invented result" 0 (graph_flow_tests/generation controller followed))
     (testing/nat "unresolved work keeps the structured report capture" 1 retained_conflict)
     (testing/nat "repeating attachment does not create another attempt" 1 (equal[namespace] followed repeated))
     (testing/nat "a claim edit updates the ordinary report cell" 1
       (and (eq changed_report.tap.len 2)
         (changed_report.tap.all((\ [at record] (eq record.nat_at(['conflicting] 99) 0))))))
     (testing/nat "the same native maintenance hand resumes when evidence changes" 1 (graph_flow_tests/generation controller changed))
     (testing/text "the same persistent subject hole resolves" "resolved" hole.txt_at(['work 'status]))
     (testing/nat "resumption links a new retained attempt" 1
       advanced)
     (testing/nat "old unresolved task retains its original report" 1 preserved)
     (testing/nat "working overlay still exposes document and evidence" 1
       (and (overlay.has(['document])) (gt overlay.dip(['evidence]).wyt 0)))
     (testing/nat "published review uses the existing Nenex writer" 1
       (fixture/flow_tests/get destination changed).has(['src]))
     (testing/nat "retry after completion is idempotent" 1 (equal[namespace] changed retry))
     (testing/nat "all retained x/y/z work history survives resumption" 1 historical)
     (testing/nat "incoming holder contents are selected through the shared context lens" 2
       (sovereign_care .z context.cons(xs) followed).dip(['evidence]).wyt)
     (testing/nat "adding a referenced claim updates membership and the authored flow's context" 3 expanded_report.wyt)
     (testing/nat "new conflicting membership reopens work without publishing a new revision" 1 (graph_flow_tests/generation controller expanded))
     (testing/nat "retargeting releases the old evidence alias" 2
       (sovereign_care .z context.cons(xs) released).dip(['evidence]).wyt)
     (testing/text "membership resolution settles the same persistent subject hole" "resolved"
       (fixture/flow_tests/get task.hole released).txt_at(['work 'status]))
     (testing/nat "edits to a released holder do not rewrite its former context" 1
       (equal released_context (fixture/flow_tests/get context obsolete)))
     (testing/nat "edits to a released holder do not retry completed flow work" 1
       (equal (fixture/flow_tests/get controller released) (fixture/flow_tests/get controller obsolete)))
     (testing/nat "returning to rejected evidence selects a fresh attempt head" 1
       (and failed_head.is_some (and new_head.is_some !(equal[maybe[path]] failed_head new_head))))
     (testing/text "a new conflict reopens the previously resolved hole" "waiting"
       (fixture/flow_tests/get task.hole again).txt_at(['work 'status]))
     (testing/nat "reusing a retained result never changes the earlier failed attempt" 1
       (equal (fixture/flow_tests/get failed_head.fall([]) expanded) (fixture/flow_tests/get failed_head.fall([]) again)))
     (testing/text "membership edits preserve unrelated context annotations" "Keep context annotations" released_context.txt_at(['note]))
     (testing/nat "membership edits retain the selected context constructor" 1
       (equal[pail] (myth/pail_at bond/weft released_context) (myth/pail_at bond/weft selection)))]

+ tests
  ^ row[testing/case]
  [(testing/case "authored graph review reuses native cells hands holes and retry" graph_flow_tests/checks)]
