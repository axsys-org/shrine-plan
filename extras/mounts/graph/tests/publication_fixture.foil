- graph_policy
- grove_role_runtime
- namespace_command
- show

' Test ports for actual Grove publication; no production installation adapter.
+ graph_publication_fixture
  + put
    \ target=path record=myth state=namespace
    ^ namespace
    = outcome (namespace_command/run (task/vine target (writ/make record)) 0 0 state (sovereign_hive state))
    ? outcome
     > (./err why)
       | Seq[namespace] (error (pails/t (str/cat_all ["graph fixture rejected " (str/from_atom (show/path target)) ": " (str/from_atom (show/iota why))]))) state
    ?> (./ok result) outcome state
    = [next index] result
    next
  + claim
    \ value=str accepted=nat
    ^ myth
    = record (myth/sing ['subject] (safe 1 .x [($x 17) 'supplier]))
      record record.put(['property] (pails/p ['lead_time]))
      record record.put(['value] (pails/t value))
      record record.put(['source] (safe 1 .x [($x 17) 'evidence]))
    | record.put ['accepted] (pails/n accepted)
  + bind
    \ version=nat name=iota state=namespace
    ^ namespace
    = implementation=path [state.self 'gov 'graph 'report]
      input=path [state.self 'app 'graph_probe 'claims]
      prefix=path ['o ($u version) ($u implementation.len)]
      projected=path prefix.weld(implementation)
      projected=path projected.snoc(($u input.len)).weld(input)
      identity
        \ context=myth tree=axal[myth]
        ^ axal[myth]
        tree
      card (myth/sing bond/weft (spun identity .none))
      card card.put(bond/tack (safe 0 .z projected))
      target=path [state.self 'app 'graph_probe name]
    | graph_publication_fixture/put target card state
  + seed
    \ state=namespace
    ^ namespace
    = root=path [state.self 'app 'graph_probe 'claims]
      state (graph_publication_fixture/put root.snoc('a) (graph_publication_fixture/claim "10" 1) state)
      state (graph_publication_fixture/put root.snoc('b) (graph_publication_fixture/claim "20" 1) state)
      state (graph_publication_fixture/put root.snoc('c) (graph_publication_fixture/claim "30" 0) state)
    | graph_publication_fixture/bind 1 'captured state
  + change
    \ state=namespace
    ^ namespace
    | graph_publication_fixture/put [state.self 'app 'graph_probe 'claims 'b]
        (graph_publication_fixture/claim "10" 1) state
  + summary
    \ address=path state=namespace
    ^ row[nat]
    ?> (./known tree) (sovereign_view .z 0 address state) [999]
    = count=nat
        | tree.tap.fold 0
          \ total=nat [at record]
          | add total (record.nat_at(['conflicting] 0))
    | [tree.wyt count]
  + current
    \ name=iota state=namespace
    ^ row[nat]
    | graph_publication_fixture/summary ['x state.self 'app 'graph_probe name] state
  + snapshot
    \ before=namespace after=namespace
    ^ row[nat]
    = target=path ['x before.self 'app 'graph_probe 'captured]
      epoch=iota ($ts (str/cat_all ["e" before.local.top.show]))
      prefix=path ['h 'z epoch ($u target.len)]
    | graph_publication_fixture/summary prefix.weld(target) after
  + history
    ' Every pre-existing native case, not just the edited evidence paths.
    \ before=namespace after=namespace
    ^ bool
    = cares=row[care] [.x .y .z]
    | before.local.cases.tap.all
      \ [name held]
      = counters=ever (unpin held.held)
      | cares.all
        \ cr
        = limit
            ? cr
             > .x counters.x.lock.data
             > .y counters.y.lock.data
            counters.z.lock.data
        % version=nat 1
        ^ bool
        ? (gt version limit) .true
        ? !(equal (store_page cr version name before.local) (store_page cr version name after.local)) .false
        | _ version.inc
  + previous
    \ state=namespace name=path
    ^ nat
    | state.case(.x name).fall(0)
  + lookup
    \ state=namespace name=path
    ^ maybe[myth]
    | (sovereign_peek name state).fil
