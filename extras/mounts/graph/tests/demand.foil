- lain_peek
- sys/demand
- graph_demand
- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- tests/reference_reactivity [at=fixture]
- testing

+ graph_demand_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      root=path [initial.self 'demand_evidence]
      a=path root.snoc('a)
      b=path root.snoc('b)
      definition=path [initial.self 'definitions 'demand_gather]
      children_definition=path [initial.self 'definitions 'demand_children]
      cell=path [initial.self 'demand_view]
      pinned=path [initial.self 'demand_snapshot]
      local (fixture/cell_tests/put definition graph_demand/gather_card initial.local)
      local (fixture/cell_tests/put children_definition graph_demand/children_card local)
      local (fixture/cell_tests/put root myth/new local)
      local (fixture/cell_tests/put a (myth/sing ['value] (pails/n 11)) local)
      local (fixture/cell_tests/put b (myth/sing ['value] (pails/n 22)) local)
      state initial.set_local(local)
      version state.case(.z root).fall(0)
      config (myth/sing bond/weft (safe 1 .x definition)).put(['left] (safe 0 .z a)).put(['right] (safe 0 .z b))
      local (fixture/cell_tests/put cell config local)
      local (fixture/cell_tests/put pinned
        (myth/sing bond/weft (safe 1 .x children_definition)).put(bond/tack (safe version .z root)) local)
      state state.set_local(local)
      reader (sovereign_reader state)
      selected (woven_evaluate_select 0 cell .x ['left] .all reader)
      names (woven_evaluate_select 0 cell .z [] .names reader)
      changed (fixture/reference_reactivity/write b (writ/poke (myth/sing ['value] (pails/n 33))) state)
      changed_a (fixture/reference_reactivity/write a (writ/poke (myth/sing ['value] (pails/n 44))) changed)
      historical (sovereign_view .x 0 (row/cons[iota] 'x (row/snoc[iota] 'a pinned)) changed_a)
      missing (fixture/reference_reactivity/write cell (writ/poke (myth/sing ['missing] (safe 0 .x (row/snoc[iota] 'missing root)))) changed_a)
      unresolved (sovereign_view .z 0 (row/cons[iota] 'x cell) missing)
      created (fixture/reference_reactivity/write (row/snoc[iota] 'missing root) (writ/make (myth/sing ['value] (pails/n 55))) missing)
      available (sovereign_view .x 0 (row/cons[iota] 'x (row/snoc[iota] 'missing cell)) created)
      removed (fixture/reference_reactivity/write b .cull changed_a)
      absent (sovereign_view .y 0 (row/cons[iota] 'x cell) removed)
      unavailable_tree (sovereign_view .z 0 (row/cons[iota] 'x cell) removed)
      republished (fixture/reference_reactivity/write definition (writ/make graph_demand/children_card) changed_a)
      captured_policy (sovereign_view .x 0 (row/cons[iota] 'x (row/snoc[iota] 'left cell)) republished)
      number
        \ value=res[axal[myth]] at=path
        ^ nat
        ?> (./known tree) value 999
        | tree.get(at).fall(myth/new).nat_at(['value] 999)
      status
        \ value=res[axal[myth]] at=path
        ^ pail
        ?> (./known tree) value (pails/q 'unknown)
        | tree.get(at).fall(myth/new).pail_at(['sys 'view 'state])
    [(testing/nat "published gather constructor resolves its selected placement" 11 (number selected.value []))
     (testing/nat "reading one placement does not observe its sibling" 0
       (selected.observations.any((\ observed (equal[path] observed.read.source.path b)))))
     (testing/nat "names selection does not read placement contents" 0
       (names.observations.any((\ observed (pith_prefix root observed.read.source.path)))))
     (testing/nat "unrelated sibling edit preserves selected observations" 1 (woven_valid selected (sovereign_reader changed)))
     (testing/nat "selected evidence edit invalidates observations" 0 (woven_valid selected (sovereign_reader changed_a)))
     (testing/nat "pinned subtree selects child within the original snapshot" 11 (number historical []))
     (testing/nat "missing placement is explicitly unresolved" 1 (equal[pail] (status unresolved ['missing]) (pails/q 'unresolved)))
     (testing/nat "missing placement becomes readable when evidence arrives" 55 (number available []))
     (testing/nat "culled exact record is distinct from unresolved evidence" 1 (equal[pail] (status absent ['right]) (pails/q 'absent)))
     (testing/nat "unavailable subtree preserves the native unknown result" 1 (equal[pail] (status unavailable_tree ['right]) (pails/q 'unresolved)))
     (testing/nat "pinned constructor keeps its behavior after definition replacement" 44 (number captured_policy []))
     (testing/nat "demand reads preserve original x/y/z history" 1
       (row/all[care] (\ care (equal (namespace/page care state.case(care root) root state)
         (namespace/page care state.case(care root) root created))) [.x .y .z]))]

+ tests
  ^ row[testing/case]
  [(testing/case "published demand policies retain native evaluation capabilities" graph_demand_tests/checks)]
