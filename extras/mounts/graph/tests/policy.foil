- graph_policy
- testing

+ graph_policy_tests
  + claim
    \ subject=safe value=str accepted=nat origin=safe why=str
    ^ myth
    | (myth/sing ['subject] subject).put(['property] (pails/p ['founded])).put(['value] (pails/t value)).put(['accepted] (pails/n accepted)).put(['source] origin).put(['why] (pails/t why))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = subject (safe 0 .x [($x 1) 'company])
      alternative (safe 0 .x [($x 1) 'other])
      origin (safe 0 .x [($x 1) 'filings 'one])
      second_origin (safe 2 .z [($x 1) 'filings 'two])
      first (graph_policy_tests/claim subject "2010" 1 origin "Registry filing")
      second (graph_policy_tests/claim subject "2011" 1 second_origin "Amended filing")
      rejected (graph_policy_tests/claim subject "1900" 0 origin "Rejected assertion")
      explicit_other (graph_policy_tests/claim alternative "2012" 1 origin "Different filing")
      input (axal/new[myth] .none).put(['one] first).put(['two] second).put(['rejected] rejected).put(['other] explicit_other)
      report (graph_policy/report input)
      found report.get(['one]).fall(myth/new)
      other report.get(['other]).fall(myth/new)
      selected (graph_policy/select [subject] input)
      grouped (graph_policy/group_report [subject alternative] input)
      old (safe 0 .x ['h 'x ($u 1) ($u 2) ($x 1) 'company])
      newer (safe 0 .x ['h 'x ($u 2) ($u 2) ($x 1) 'company])
      old_claim (graph_policy_tests/claim old "2010" 1 origin "Historical A")
      new_claim (graph_policy_tests/claim newer "2011" 1 origin "Historical B")
      different_care (graph_policy_tests/claim (safe 0 .z subject.path) "2013" 1 origin "Subtree assertion")
      versions (axal/new[myth] .none).put(['old] old_claim).put(['new] new_claim)
      same_text (graph_policy_tests/claim alternative "2010" 1 origin "Same spelling is not identity")
    [(testing/nat "accepted assertions retain separate rows" 3 report.tap.len)
     (testing/nat "explicitly rejected assertion is excluded" 0 (maybe/is_some report.get(['rejected])))
     (testing/nat "different values for one exact subject and property are marked conflicting" 1 found.nat_at(['conflicting] 0))
     (testing/nat "first supporting reason stays with its assertion" 1
       (equal (found.get(['why])) (first.get(['why]))))
     (testing/nat "second supporting reason stays with its assertion" 1
       (equal (report.get(['two]).fall(myth/new).get(['why])) (second.get(['why]))))
     (testing/nat "source reference keeps its exact version and care" 1
       (equal[maybe[pail]] (report.get(['two]).fall(myth/new).get(['source])) (./some second_origin)))
     (testing/nat "an ungrouped different subject is not a conflict" 0 other.nat_at(['conflicting] 99))
     (testing/nat "explicit membership selects only the requested subject" 3 selected.tap.len)
     (testing/nat "explicit grouped report compares the selected subjects" 1
       grouped.get(['other]).fall(myth/new).nat_at(['conflicting] 0))
     (testing/nat "grouping retains the original subject rather than rewriting identity" 1
       (equal[maybe[pail]] (grouped.get(['other]).fall(myth/new).get(['subject])) (./some alternative)))
     (testing/nat "historical versions never silently compare as one exact subject" 0
       (graph_policy/disagrees old_claim new_claim))
     (testing/nat "explicit historical membership does not select another version" 1
       (graph_policy/select [old] versions).tap.len)
     (testing/nat "different cares are distinct observations" 0
       (graph_policy/disagrees first different_care))
     (testing/nat "equal text does not establish identity" 0
       (graph_policy/disagrees first same_text))
     (testing/nat "report is ordinary deterministic composition" 1
       (equal report (graph_policy/annotate (graph_policy/accepted input))))
     (testing/nat "input assertions are retained unchanged" 1
       (equal[maybe[myth]] (input.get(['one])) (./some first)))]

  + grouping_keys
    \ ignored=unit
    ^ row[testing/check]
    = origin (safe 0 .x [($x 1) 'evidence])
      subject (safe 0 .x ['a])
      first (graph_policy_tests/claim subject "first" 1 origin "First assertion")
      second first.put(['value] (pails/t "second"))
      third first.put(['value] (pails/t "third"))
      repeated (axal/new[myth] .none).put(['a] first).put(['b] first).put(['c] second).put(['d] third)
      conflicts (graph_policy/report repeated)
      one first.put(['property] (pails/p ['b 'c]))
      two second.put(['subject] (safe 0 .x ['a 'b])).put(['property] (pails/p ['c]))
      distinct_input (axal/new[myth] .none).put(['one] one).put(['two] two)
      distinct (graph_policy/report distinct_input)
      version_input (axal/new[myth] .none).put(['one] first.put(['subject] (safe 1 .x ['a]))).put(['two] second.put(['subject] (safe 2 .x ['a])))
      versions (graph_policy/report version_input)
      incomplete (axal/new[myth] .none).put(['value_missing] first.del(['value])).put(['property_missing] second.del(['property])).put(['subject_missing] third.del(['subject]))
      retained (graph_policy/report incomplete)
    [(testing/nat "three values mark every assertion including duplicate first values" 1
       (and (eq conflicts.tap.len 4) (conflicts.tap.all((\ [at record] (eq record.nat_at(['conflicting] 0) 1))))))
     (testing/nat "subject and property path boundaries cannot collide" 1
       (and (eq distinct.tap.len 2) (distinct.tap.all((\ [at record] (eq record.nat_at(['conflicting] 99) 0))))))
     (testing/nat "numeric safe versions remain distinct grouping keys" 1
       (and (eq versions.tap.len 2) (versions.tap.all((\ [at record] (eq record.nat_at(['conflicting] 99) 0))))))
     (testing/nat "incomplete assertion records remain visible without invented conflict" 1
       (and (eq retained.tap.len 3) (retained.tap.all((\ [at record] (eq record.nat_at(['conflicting] 99) 0))))))
     (testing/nat "grouping retains the original unmerged qualifiers" 1
       (equal[maybe[pail]] (conflicts.get(['d]).fall(myth/new).get(['why])) (third.get(['why]))))]

+ tests
  ^ row[testing/case]
  [(testing/case "explicit assertion grouping and conflicting evidence" graph_policy_tests/checks)
   (testing/case "transient grouping preserves exact observation boundaries" graph_policy_tests/grouping_keys)]
