- graph_policy

' Test-only inputs. Equal values force the retained baseline to compare every
' assertion pair, and force the grouped implementation to compare n-1 values.
+ graph_cost_fixture
  + make
    \ count=nat nonce=nat
    ^ axal[myth]
    = subject (safe 0 .x [($x 17) 'supplier])
    % i=nat 0 tree=axal[myth] (axal/new[myth] .none)
    ^ axal[myth]
    ? (eq i count) tree
    = record
        . (myth/sing ['subject] subject)
          put(['property] (pails/p ['delivery_days]))
          put(['value] (pails/n nonce))
          put(['source] (safe 1 .x [($x 17) 'evidence ($u i)]))
          put(['accepted] (pails/n 1))
    | _ i.inc tree.put([($u i)] record)
  + narrow
    \ input=axal[myth]
    ^ axal[myth]
    | input.dip [($u 0)]
  + size
    \ input=axal[myth]
    ^ nat
    | input.tap.len
  + edges
    \ input=axal[myth]
    ^ axal[myth]
    | graph_references/edges (safe 1 .z [($x 17) 'evidence]) input
  + narrow_edges
    \ input=axal[myth]
    ^ axal[myth]
    | graph_references/edges
      (safe 0 .z ['h 'z ($u 1) ($u 2) ($x 17) 'evidence ($u 0)]) input
  + report
    \ input=axal[myth]
    ^ axal[myth]
    | graph_policy/report input
  + pairwise_report
    ' Preserve the measured quadratic baseline as a small conformance oracle.
    ' Production policy uses invocation-local grouping instead.
    \ input=axal[myth]
    ^ axal[myth]
    = rows (graph_policy/accepted input).tap
    | rows.fold (axal/new[myth] .none)
      \ out [at record]
      = conflict
          | rows.any
            \ [other_at other]
            | graph_policy/disagrees record other
      | out.put at record.put(['conflicting] (pails/n (? conflict 1 0)))
