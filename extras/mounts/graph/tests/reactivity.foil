- graph_references
- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- tests/composition [at=fixture]
- tests/reference_reactivity [at=fixture]
- testing

+ graph_reactivity_tests
  + projection
    \ context=myth input=axal[myth]
    ^ axal[myth]
    ?> scope=safe context.pail_at(bond/tack) (axal/new[myth] .none)
    = edges (graph_references/edges scope input)
    | edges.put [] (myth/sing ['count] (pails/n edges.tap.len))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      subject=path [($x 1) 'subject]
      scope=path [($x 1) 'claims]
      holder=path scope.snoc('claim)
      alternate=path [($x 1) 'other_claims]
      other_holder=path alternate.snoc('claim)
      computation=path [($x 1) 'references]
      watcher=path [($x 1) 'watcher]
      overlay_watcher=path [($x 1) 'overlay_watcher]
      behavior=path [($x 1) 'kook 'incoming]
      definition=path [($x 1) 'definitions 'references]
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put behavior
        (form/card def_form.set_hear(fixture/reference_reactivity/refresh) (lore/line "Reference projection watcher")) initial.local)
      local (fixture/cell_tests/put scope myth/new local)
      local (fixture/cell_tests/put alternate myth/new local)
      local (fixture/cell_tests/put definition (myth/sing bond/weft (spun graph_reactivity_tests/projection .none)) local)
      config (myth/sing bond/weft (safe 1 .x definition)).put(bond/tack (safe 0 .z scope))
      local (fixture/cell_tests/put computation config local)
      overlay (fixture/composition_tests/overlay definition scope)
      local (fixture/cell_tests/put watcher
        (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x computation.cons(xs))))) local)
      local (fixture/cell_tests/put overlay_watcher
        (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x overlay)))) local)
      initial initial.set_local(local)
      relation (myth/sing ['property] (safe 0 .x subject))
      added (fixture/reference_reactivity/write holder (writ/make relation) initial)
      edited (fixture/reference_reactivity/write holder (writ/poke (myth/sing ['description] (pails/t "Literal edit"))) added)
      removed (fixture/reference_reactivity/write holder .cull edited)
      revived (fixture/reference_reactivity/write holder (writ/make relation) removed)
      unavailable (fixture/reference_reactivity/write scope .cull revived)
      restored (fixture/reference_reactivity/write scope (writ/make myth/new) unavailable)
      restored (fixture/reference_reactivity/write holder (writ/make relation) restored)
      rebound (fixture/reference_reactivity/write computation
        (writ/poke (myth/sing bond/tack (safe 0 .z alternate))) restored)
      obsolete_changed (fixture/reference_reactivity/write holder (writ/poke (myth/sing ['extra] (safe 0 .x subject))) rebound)
      active_changed (fixture/reference_reactivity/write other_holder (writ/make relation) obsolete_changed)
      published=namespace
        ?> (./accepted committed) (namespace/step (axal/new[note] .none).put(holder (note/make relation)) 0 0 initial) initial
        committed.state
      reconciled=namespace
        ?> (./ok next) (sovereign_reconcile initial published 0 0) published
        next
      number
        \ at=path slot=path state=namespace
        ^ nat
        | (sovereign_peek at state).fil.fall(myth/new).nat_at(slot 999)
    [(testing/nat "ordinary reference cell wakes its watcher on new source evidence" 1 (number watcher ['count] added))
     (testing/nat "the same transformation through /o wakes its watcher" 1 (number overlay_watcher ['count] added))
     (testing/nat "declared subtree edits rerun the view through ordinary dependencies" 2 (number watcher ['notifications] edited))
     (testing/nat "removing the last reference yields a known empty projection" 0 (number watcher ['count] removed))
     (testing/nat "restoring reference evidence refreshes the view" 1 (number watcher ['count] revived))
     (testing/nat "culling the entire source does not present stale evidence as current" 1
       (fixture/cell_tests/probe (sovereign_view .x 0 computation.cons(xs) unavailable)))
     (testing/nat "restoring the source restores its live projection" 1 (number watcher ['count] restored))
     (testing/nat "explicit rebind immediately selects the new empty source" 0 (number watcher ['count] rebound))
     (testing/nat "old source edits do not notify the rebound cell consumer" 1
       (equal (number watcher ['notifications] rebound) (number watcher ['notifications] obsolete_changed)))
     (testing/nat "the new source remains subscribed" 1 (number watcher ['count] active_changed))
     (testing/nat "publication reconciliation refreshes the native projection" 1 (number watcher ['count] reconciled))
     (testing/nat "publication reconciliation refreshes its /o consumer" 1 (number overlay_watcher ['count] reconciled))
     (testing/nat "x source history is retained through cull and revival" 1
       (equal (added.local.x_query(1 holder)) (restored.local.x_query(1 holder))))
     (testing/nat "y source history is retained through cull and revival" 1
       (equal (added.local.y_query(1 holder)) (restored.local.y_query(1 holder))))
     (testing/nat "z source history is retained through cull and revival" 1
       (equal (added.local.z_query(1 holder)) (restored.local.z_query(1 holder))))]

+ tests
  ^ row[testing/case]
  [(testing/case "published reference projections use native subscriptions" graph_reactivity_tests/checks)]
