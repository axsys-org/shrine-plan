' Networked names: the generic substrate for one world observing another's
' published names.  It knows publishers, names, revisions and whether a
' judgment has fallen behind a revision.  It knows nothing about any
' business.
'
' /names/<publisher>/<name>/current   the acquired revision of a remote name,
'                                     written only by the shrine-mesa sidecar:
'                                     the viewed slots plus remote_case,
'                                     publisher and source (name@case)
' /names/<publisher>/<name>/seen      written by whoever judged against a
'                                     revision: remote_case is the revision
'                                     the judgment relied on
' /stale                              the overlay: every name whose current
'                                     revision is not the one that was seen
' /self                               this world's own statement
' /outreach/<id>/<kind>               request, approval and sent: an inquiry
'                                     on its way to a mailbox
' /answers/<id>                       an answer given under this world's name

#import text=lib/grove/types/text

count =
  @type
  #meta ;
    lede: "A natural number"
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[count]
    ? value
     > wrapped=pails/n (./some wrapped.n)
    .none
  + write
    \ value=count
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

note =
  @slot
  #meta ;
    lede: "A note"

observed =
  @role
  #meta ;
    lede: "A record beneath an acquired name"
  #opt ;
    note: text

stale_item =
  @role
  #meta ;
    lede: "A name whose judgment is behind its revision"
  #opt ;
    note: text

publication =
  @role
  #meta ;
    lede: "A name this world exposes to its peers"
  path: text
  to: text
  #opt ;
    slots: text
    note: text

publications_norm =
  @norm
  #here ; '/[name=@tas]
  #with ; publication

outreach_item =
  @role
  #meta ;
    lede: "One statement about an outreach: its request, its approval, its sending"
  #opt ;
    to: text
    about: text
    note: text
    at: text

outreach_norm =
  @norm
  #here ; '/[id=@tas]/[kind=@tas]
  #with ; outreach_item

answer =
  @role
  #meta ;
    lede: "An answer this world gives an inquirer, under its own name"
  "/text": text
  to: text
  #opt ;
    about: text
    note: text

answers_norm =
  @norm
  #here ; '/[id=@tas]
  #with ; answer

names_norm =
  @norm
  #here ; '/[publisher=@x]/[name=@tas]/[kind=@tas]
  #with ; observed

stale_norm =
  @norm
  #here ; '/[publisher=@x]/[name=@tas]
  #with ; stale_item

stale =
  @sewn
  #meta ;
    lede: "Names whose acquired revision moved past the judged one"
  #from ; names_norm
  #to ; stale_norm
  get :
    ! foil
    + case_of
      \ entry=[path myth]
      ^ nat
      = [src val] entry
      | val.nat_at(['remote_case] 0)
    + kind_of
      \ entry=[path myth]
      ^ iota
      = [src val] entry
      ? (eq src.len 3) src.at(2)
      | $ts ""
    + key_of
      \ entry=[path myth]
      ^ path
      = [src val] entry
      ? (eq src.len 3) [src.at(0) src.at(1)]
      | []
    + judge
      \ acc=axal[myth] entry=[path myth] x=axal[myth]
      ^ axal[myth]
      ? !(eq_iota (%/get/kind_of entry) 'seen) acc
      = key (%/get/key_of entry)
        seen (%/get/case_of entry)
      ?> (./some current) (x.get(key.snoc('current)))
        acc
      = now current.nat_at(['remote_case] 0)
      ? (eq now seen) acc
      = out=myth myth/new
        out out.put(['current] (pails/n now))
        out out.put(['seen] (pails/n seen))
        out out.put(['publisher] (pails/q key.at(0)))
        out out.put(['name] (pails/q key.at(1)))
      | acc.put(key out)
    \ x=axal[myth]
    ^ axal[myth]
    = entries x.tap
      acc=axal[myth] (axal/new[myth] .none)
    | row/fold[[path myth] axal[myth]] acc
        (\ acc=axal[myth] entry=[path myth] (%/get/judge acc entry x))
        entries

' Installed namespace

"/" =
  @tree

"/names" =
  @tree
  #like ; names_norm

"/publications" =
  @tree
  #like ; publications_norm

"/self" =
  @tree

"/outreach" =
  @tree
  #like ; outreach_norm

"/answers" =
  @tree
  #like ; answers_norm
