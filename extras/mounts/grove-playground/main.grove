  @action
  #on ; %/board
  %/id: text
  %/value: text
  ! foil
  \ id=text value=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "edge-value")) (jkv "id" (json/str id)) (jkv "value" (json/str value))])
  = result (playground/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (playground/edit_error result))) board
  = job=grove_draft/job
      ? (eq next.revision board.document.revision) board.job
      ? (playground/source next)
       > (./ok source) board.job.set_source(source).set_revision(next.revision).set_request(0)
       > (./err message) board.job.set_source("").set_revision(next.revision).set_attempted(next.revision).set_request(0).set_message(message).set_line(0)
  | board.set_document(next).set_scene((playground_scene/scene next)).set_population((playground_scene/population next)).set_job(job).set_source(job.source)

visibility =
  @action
  #on ; %/board
  %/tag: text
  %/value: text
  ! foil
  \ tag=text value=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "visibility")) (jkv "tag" (json/str tag)) (jkv "value" (json/str value))])
  ?> (./ok next) (playground/apply board.document args)
    | Seq[%/board] (error (pails/t "Invalid card visibility")) board
  | board.set_document(next).set_scene((playground_scene/scene next)).set_population((playground_scene/population next))

publish =
  @action
  #on ; %/board
  %/revision: text
  ! foil
  \ revision=text board=%/board
  ^ %/board
  ? !(and (eq (nat/parse revision).fall(0) board.job.ready) (eq board.job.ready board.document.revision))
    | Seq[%/board] (error (pails/t "Publish requires the current successfully compiled revision")) board
  | board.set_job(board.job.set_request(board.job.ready))

editor =
  @pane
  #on ; %/board
  #for ; /sys/slot/content
  board => split {
    patch('/canvas, scene = board.scene, population = board.population, label = "Grove program graph") {
      patch_operation("move-nodes", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply move-nodes")
        }
      }
      patch_operation("connect", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply connect")
        }
      }
      patch_operation("reconnect", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply reconnect")
        }
      }
      patch_operation("disconnect", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply disconnect")
        }
      }
      patch_operation("create-from-port", slot = %/operation) {
        group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
          input(%/operation)
          action("Apply create-from-port")
        }
      }
    }
    split {
      group(on = board, action = %/create, myth = { %/tag = .input(""), %/name = .input("") }) {
        text("Create node", '/sys/slot/title)
        text("tag", '/sys/slot/label)
        input(%/tag)
        text("name", '/sys/slot/label)
        input(%/name)
        action("Create node")
      }
      group(on = board, action = %/update, myth = { %/id = .input(""), %/name = .input(""), %/value = .input(""), %/slot = .input("") }) {
        text("Save properties", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        text("name", '/sys/slot/label)
        input(%/name)
        text("value", '/sys/slot/label)
        input(%/value)
        text("slot", '/sys/slot/label)
        input(%/slot)
        action("Save properties")
      }
      group(on = board, action = %/remove, myth = { %/id = .input("") }) {
        text("Delete node", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        action("Delete node")
      }
      group(on = board, action = %/collapse, myth = { %/id = .input("") }) {
        text("Collapse / expand view", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        action("Collapse / expand view")
      }
      group(on = board, action = %/connect, myth = { %/left = .input(""), %/port = .input(""), %/right = .input("") }) {
        text("Connect relationship", '/sys/slot/title)
        text("left", '/sys/slot/label)
        input(%/left)
        text("port", '/sys/slot/label)
        input(%/port)
        text("right", '/sys/slot/label)
        input(%/right)
        action("Connect relationship")
      }
      group(on = board, action = %/disconnect, myth = { %/id = .input("") }) {
        text("Disconnect relationship", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        action("Disconnect relationship")
      }
      group(on = board, action = %/reorder, myth = { %/id = .input(""), %/index = .input("") }) {
        text("Reorder child", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        text("index", '/sys/slot/label)
        input(%/index)
        action("Reorder child")
      }
      group(on = board, action = %/edge_value, myth = { %/id = .input(""), %/value = .input("") }) {
        text("Save sample field", '/sys/slot/title)
        text("id", '/sys/slot/label)
        input(%/id)
        text("value", '/sys/slot/label)
        input(%/value)
        action("Save sample field")
      }
      group(on = board, action = %/visibility, myth = { %/tag = .input(""), %/value = .input("") }) {
        text("Card visibility", '/sys/slot/title)
        text("kind", '/sys/slot/label)
        input(%/tag)
        text("show / hide", '/sys/slot/label)
        input(%/value)
        action("Set card visibility")
      }
      group(on = board, action = %/save_routing, myth = { %/operation = .input("") }) {
        input(%/operation)
        action("Save routing")
      }
      group(on = board, action = %/publish, myth = { %/revision = .input("") }) {
        text("Publish revision", '/sys/slot/title)
        text("revision", '/sys/slot/label)
        input(%/revision)
        action("Publish revision")
      }
    }
  }

"/draft" =
  @tree
  %/document: playground/initial
  %/population: (playground_scene/population playground/initial)
  %/scene: (pails/t (playground_scene/scene playground/initial))
  %/source: (pails/t (playground/source playground/initial).ok_val)
  %/job: (grove_draft/job (playground/source playground/initial).ok_val 1 0 0 0 0 "Not compiled" 0)
