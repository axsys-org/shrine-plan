#import text=lib/grove/types/text

document_type =
  @type
  ! foil
  playground/draft
  + read
    \ value=pail
    ^ maybe[document_type]
    ?> result=playground/draft value .none
    | ./some result
  + write
    \ value=document_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ playground/draft)

population_type =
  @type
  ! foil
  goo_patch/population
  + read
    \ value=pail
    ^ maybe[population_type]
    ?> result=goo_patch/population value .none
    | ./some result
  + write
    \ value=population_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ goo_patch/population)

job_type =
  @type
  ! foil
  grove_draft/job
  + read
    \ value=pail
    ^ maybe[job_type]
    ?> result=grove_draft/job value .none
    | ./some result
  + write
    \ value=job_type
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ grove_draft/job)

document =
  @slot

population =
  @slot

scene =
  @slot

job =
  @slot

source =
  @slot

operation =
  @slot

tag =
  @slot

name =
  @slot

id =
  @slot

value =
  @slot

slot =
  @slot

left =
  @slot

port =
  @slot

right =
  @slot

index =
  @slot

revision =
  @slot

board =
  @role
  %/document: %/document_type
  %/population: %/population_type
  %/scene: text
  %/job: %/job_type
  %/source: text

edit =
  @action
  #on ; %/board
  %/operation: text
  ! foil
  \ operation=text board=%/board
  ^ %/board
  ?> (jres/ok args rest) (parse operation)
    | Seq[%/board] (error (pails/t "Invalid operation JSON")) board
  = result (playground/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (playground/edit_error result))) board
  = job=grove_draft/job
      ? (eq next.revision board.document.revision) board.job
      ? (playground/source next)
       > (./ok source) board.job.set_source(source).set_revision(next.revision).set_request(0)
       > (./err message) board.job.set_source("").set_revision(next.revision).set_attempted(next.revision).set_request(0).set_message(message).set_line(0)
  | board.set_document(next).set_scene((playground_scene/scene next)).set_population((playground_scene/population next)).set_job(job).set_source(job.source)

save_routing =
  @action
  #on ; %/board
  %/operation: text
  ! foil
  \ operation=text board=%/board
  ^ %/board
  ?> (jres/ok args rest) (parse operation)
    | Seq[%/board] (error (pails/t "Invalid routing JSON")) board
  ?> (./ok scene) (playground_routing/admit board.document args)
    | Seq[%/board] (error (pails/t "Invalid or stale routing proposal")) board
  | board.set_scene(scene)

create =
  @action
  #on ; %/board
  %/tag: text
  %/name: text
  ! foil
  \ tag=text name=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "create")) (jkv "tag" (json/str tag)) (jkv "name" (json/str name))])
  = result (playground/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (playground/edit_error result))) board
  = job=grove_draft/job
      ? (eq next.revision board.document.revision) board.job
      ? (playground/source next)
       > (./ok source) board.job.set_source(source).set_revision(next.revision).set_request(0)
       > (./err message) board.job.set_source("").set_revision(next.revision).set_attempted(next.revision).set_request(0).set_message(message).set_line(0)
  | board.set_document(next).set_scene((playground_scene/scene next)).set_population((playground_scene/population next)).set_job(job).set_source(job.source)

