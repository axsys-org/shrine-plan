  #on ; %/board
  %/id: text
  %/index: text
  ! foil
  \ id=text index=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "reorder")) (jkv "id" (json/str id)) (jkv "index" (json/str index))])
