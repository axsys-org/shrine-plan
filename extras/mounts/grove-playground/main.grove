connect =
  @action
  #on ; %/board
  %/left: text
  %/port: text
  %/right: text
  ! foil
  \ left=text port=text right=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "link")) (jkv "source" (json/str left)) (jkv "port" (json/str port)) (jkv "target" (json/str right))])
  = result (playground/apply board.document args)
  ?> (./ok next) result
    | Seq[%/board] (error (pails/t (playground/edit_error result))) board
  = job=grove_draft/job
      ? (eq next.revision board.document.revision) board.job
      ? (playground/source next)
       > (./ok source) board.job.set_source(source).set_revision(next.revision).set_request(0)
