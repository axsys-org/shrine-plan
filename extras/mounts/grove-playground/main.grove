  #on ; %/board
  %/id: text
  ! foil
  \ id=text board=%/board
  ^ %/board
  = args (json/obj [(jkv "kind" (json/str "disconnect")) (jkv "id" (json/str id))])
  = result (playground/apply board.document args)
