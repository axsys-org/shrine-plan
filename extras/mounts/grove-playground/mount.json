{
  "version": 1,
  "name": "grove-playground",
  "dependencies": [
    "explorer",
    "codecs"
  ],
  "modules": {
    "grove_playground/model": "model.foil",
    "grove_playground/scene": "scene.foil",
    "grove_playground/mount": "mount.foil",
    "grove_playground/routing": "routing.foil"
  },
  "grove": [
    {
      "root": [
        "gov",
        "grove_playground"
      ],
      "files": [
        "main.grove"
      ],
      "prelude": "grove_playground/routing"
    }
  ],
  "assets": {
    "/grove-playground/app.js": "app.js",
    "/grove-playground/style.css": "style.css",
    "/grove-playground/layout.js": "layout.js",
    "/grove-playground/routing.js": "routing.js",
    "/grove-playground/routing-worker.js": "routing-worker.js"
  },
  "files": {},
  "roots": [
    [
      "lib",
      "grove_playground/model"
    ],
    [
      "lib",
      "grove_playground/scene"
    ],
    [
      "lib",
      "grove_playground/mount"
    ],
    [
      "lib",
      "grove_playground/routing"
    ],
    [
      "gov",
      "grove_playground"
    ]
  ],
  "tests": {
    "tests/grove_playground": "test_playground.foil"
  },
  "activate": {
    "module": "grove_playground/mount",
    "entry": [
      "playground_mount",
      "install"
    ]
  },
  "http": {
    "module": "grove_playground/mount",
    "entry": [
      "playground_mount",
      "http"
    ]
  },
  "routes": [
    "/grove-playground"
  ]
}
