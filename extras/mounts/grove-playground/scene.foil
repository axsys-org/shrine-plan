- grove_playground/model

+ playground_scene
  + number
    \ n=nat
    ^ json
    | json/num .false n
  + rect
    \ x=nat y=nat width=nat height=nat
    ^ json
    | json/obj [(jkv "x" (playground_scene/number x)) (jkv "y" (playground_scene/number y))
        (jkv "width" (playground_scene/number width)) (jkv "height" (playground_scene/number height))]
  + point
    \ x=nat y=nat
    ^ json
    | json/obj [(jkv "x" (playground_scene/number x)) (jkv "y" (playground_scene/number y))]
  + world_rect
    \ bx=nat by=nat width=nat height=nat
    ^ json
    | json/obj [(jkv "x" (playground/world_number bx)) (jkv "y" (playground/world_number by))
        (jkv "width" (playground_scene/number width)) (jkv "height" (playground_scene/number height))]
  + world_point
    \ bx=nat by=nat
    ^ json
    | json/obj [(jkv "x" (playground/world_number bx)) (jkv "y" (playground/world_number by))]
  + left_handle
    ' Coordinates may be negative near the canvas boundary; nat subtraction clamps.
    \ x=nat y=nat
    ^ json
    | json/obj [(jkv "x" (json/num (lt x 80) (? (lt x 80) (sub 80 x) (sub x 80))))
        (jkv "y" (playground_scene/number y))]
  + life
    \ id=nat
    ^ str
    | str/cat_all ["node:" (nat/show id)]
  + target
    \ id=nat port=str
    ^ json
    | json/obj [(jkv "kind" (json/str "port")) (jkv "node" (json/str (nat/show id)))
        (jkv "nodeLifetime" (json/str (playground_scene/life id))) (jkv "port" (json/str port))
        (jkv "lifetime" (json/str (str/cat_all [(playground_scene/life id) ":" port])))]
  + anchor
    \ node=playground/node port=str
    ^ [nat nat]
    ? (eq port "ref") [0 40]
    = ports (playground/ports node)
    % i=nat 0
    ^ [nat nat]
    ? (ge i ports.len) [240 80]
    ? (eq ports.at(i) port) [240 (add 80 (mul i 32))]
    | _ i.inc
  + port
    \ node=playground/node port=str
    ^ json
    = [x y] (playground_scene/anchor node port)
      life (str/cat_all [(playground_scene/life node.id) ":" port])
    | json/obj [(jkv "key" (json/str port)) (jkv "lifetime" (json/str life))
        (jkv "selectorRef" (json/str life)) (jkv "anchor" (playground_scene/point x y))
        (jkv "outward" (json/obj [(jkv "x" (json/num (eq port "ref") 1)) (jkv "y" (playground_scene/number 0))]))
        (jkv "hitRect" (playground_scene/rect (sub x 8) (sub y 8) 16 16))
        (jkv "direction" (json/str (? (eq port "ref") "input" "output"))) (jkv "connectable" (json/boo .true))]
  + place
    \ draft=playground/draft id=nat
    ^ playground/placement
    = found (draft.places.keep((\ place (eq place.id id))))
    ? found.len found.at(0) (playground/positive_placement id 40 40)
  + ports
    ' Slot relationships remain in the document and forms, not on the canvas.
    \ node=playground/node
    ^ row[str]
    | (playground/ports node).keep((\ port !((eq port "field") || (eq port "for"))))
  + visible
    \ draft=playground/draft node=playground/node
    ^ bool
    ? (eq node.kind "slot") .false
    ? (draft.hidden_kinds.has((playground/card_kind node))) .false
    | !(draft.collapsed.any((\ id (and (!(eq node.id id)) (playground/reaches draft id node.id draft.nodes.len)))))
  + node
    \ draft=playground/draft node=playground/node
    ^ json
    = place (playground_scene/place draft node.id)
    | json/obj [(jkv "key" (json/str (nat/show node.id)))
        (jkv "lifetime" (json/str (playground_scene/life node.id)))
        (jkv "selectorRef" (json/str (str/cat_all ["draft-node:" (nat/show node.id)])))
        (jkv "rect" (playground_scene/world_rect place.bx place.by 240 208))
        (jkv "z" (playground_scene/number 10)) (jkv "presentation" (json/str "node"))
        (jkv "draggable" (json/boo .true))
        (jkv "ports" (json/arr ((playground_scene/ports node).cons("ref").map((playground_scene/port node)))))]
  + edge
    \ draft=playground/draft edge=playground/edge
    ^ json
    = a (playground/node_at draft edge.source).fall((playground/initial).nodes.at(0))
      b (playground/node_at draft edge.target).fall((playground/initial).nodes.at(0))
      ap (playground_scene/place draft a.id) bp (playground_scene/place draft b.id)
      [ax ay] (playground_scene/anchor a edge.port)
      [bx by] (playground_scene/anchor b "ref")
      sx (add ap.bx ax) sy (add ap.by ay)
      tx (add bp.bx bx) ty (add bp.by by)
      from (playground_scene/world_point sx sy)
      to (playground_scene/world_point tx ty)
      c1 (playground_scene/world_point (add sx 80) sy)
      c2 (playground_scene/world_point (sub tx 80) ty)
      ' Equal opposing handles cancel at B(0.5): the midpoint is (from + to)/2.
      label_x (sub (div (add sx tx) 2) 48)
      label_y (sub (div (add sy ty) 2) 12)
      endpoint (\ key=str port=json (json/obj [(jkv "key" (json/str key)) (jkv "port" port)]))
      route_end (\ key=str (json/obj [(jkv "kind" (json/str "endpoint")) (jkv "key" (json/str key))]))
    | json/obj [(jkv "key" (json/str (nat/show edge.id)))
        (jkv "lifetime" (json/str (str/cat_all ["edge:" (nat/show edge.id)])))
        (jkv "selectorRef" (json/str (str/cat_all ["draft-edge:" (nat/show edge.id)])))
        (jkv "topologyRef" (json/str (str/cat_all ["edge:" (nat/show edge.id) ":" (nat/show edge.source) ":" (nat/show edge.target)])))
        (jkv "z" (playground_scene/number 0))
        (jkv "endpoints" (json/arr [(endpoint "from" (playground_scene/target a.id edge.port)) (endpoint "to" (playground_scene/target b.id "ref"))]))
        (jkv "junctions" (json/arr [])) (jkv "parts" (json/arr [])) (jkv "labels" (json/arr [(json/obj [(jkv "key" (json/str "relation"))
          (jkv "rect" (playground_scene/world_rect label_x label_y 96 24))])]))
        (jkv "segments" (json/arr [(json/obj [(jkv "key" (json/str "route"))
          (jkv "from" (route_end "from")) (jkv "to" (route_end "to"))
          (jkv "endMarker" (json/str "arrow"))
          (jkv "commands" (json/arr [(json/obj [(jkv "op" (json/str "M")) (jkv "to" from)])
            (json/obj [(jkv "op" (json/str "C")) (jkv "c1" c1) (jkv "c2" c2) (jkv "to" to)])]))])]))
        (jkv "reconnectable" (json/boo .true)) (jkv "disconnectable" (json/boo .true))]
  + routing_basis
    \ draft=playground/draft
    ^ str
    | str/join ":" ["graph-v3" (nat/show draft.revision)
        (str/join ":" (draft.places.map((\ place (str/join "," [(nat/show place.id) (show (playground/world_number place.bx)) (show (playground/world_number place.by))])))))
        (str/join "," (draft.collapsed.map(nat/show))) (str/join "," draft.hidden_kinds)]
  + scene
    \ draft=playground/draft
    ^ str
    = nodes (draft.nodes.keep((playground_scene/visible draft)))
      ids=row[nat] (nodes.map((\ node node.id)))
      edges (draft.edges.keep((\ edge (and (ids.has(edge.source)) (ids.has(edge.target))))))
      [left top right bottom] (row/fold[playground/placement [nat nat nat nat]] [100000 100000 101000 100600]
        (\ [l t r b] place [(? (lt place.bx l) place.bx l) (? (lt place.by t) place.by t)
          (? (gt r (add place.bx 280)) r (add place.bx 280)) (? (gt b (add place.by 248)) b (add place.by 248))])
        (draft.places.keep((\ place (ids.has(place.id))))))
    | show (json/obj [(jkv "header" (json/obj
        [(jkv "protocol" (playground_scene/number 1)) (jkv "surface" (json/str "grove-playground"))
         (jkv "encounter" (json/str "grove-playground:1")) (jkv "viewSeq" (playground_scene/number draft.revision))
         (jkv "sourceRev" (json/str (nat/show draft.revision))) (jkv "layoutRev" (json/str (playground_scene/routing_basis draft)))
         (jkv "rendererEpoch" (json/str "playground:1"))]))
       (jkv "extent" (playground_scene/world_rect left top (sub right left) (sub bottom top)))
       (jkv "initialCamera" (json/obj [(jkv "kind" (json/str "fit")) (jkv "paddingPx" (playground_scene/number 24))]))
       (jkv "policy" (playground_scene/policy))
       (jkv "offers" (json/obj [(jkv "moveNodes" (json/str "move-nodes")) (jkv "connect" (json/str "connect"))
         (jkv "reconnect" (json/str "reconnect")) (jkv "disconnect" (json/str "disconnect"))
         (jkv "compatibility" (json/str "compatibility")) (jkv "createPicker" (json/str "create-picker")) (jkv "createFromPort" (json/str "create-from-port"))]))
       (jkv "nodes" (json/arr (nodes.map((playground_scene/node draft)))))
       (jkv "connections" (json/arr (edges.map((playground_scene/edge draft)))))])
  + policy
    ^ json
    | json/obj [(jkv "minScale" (json/real "0.125")) (jkv "maxScale" (playground_scene/number 4))
      (jkv "dragThresholdPx" (playground_scene/number 4)) (jkv "touchDragThresholdPx" (playground_scene/number 8))
      (jkv "snapTolerancePx" (playground_scene/number 6)) (jkv "portTolerancePx" (playground_scene/number 12))
      (jkv "touchPortTolerancePx" (playground_scene/number 22)) (jkv "wireTolerancePx" (playground_scene/number 6))
      (jkv "alignmentSnap" (json/boo .true)) (jkv "autoPanBandPx" (playground_scene/number 32))
      (jkv "autoPanMaxPxPerSecond" (playground_scene/number 480))]
  + caption
    \ text=str
    ^ str
    | str/cat_all ((row/range 0 text.len).map((\ i (? (and (ge text.at(i) 32) (le text.at(i) 126)) text.slice(i 1) "?"))))
  + native
    \ kind=str args=list[rex] children=list[goo/node]
    ^ goo/node
    | goo/node rex/zero_span kind args children
  + content
    \ draft=playground/draft node=playground/node
    ^ goo_patch/occurrence
    = text (\ value=str (playground_scene/native "text" (list/one (rex/cord (playground_scene/caption value))) .nil))
      label (\ value=str (rex/nest rex/zero_span "clear" "=" [(rex/word "label") (rex/cord value)]))
      control (\ kind=str key=str name=str (playground_scene/native kind (list/one (rex/cord key)).snoc((label name)) .nil))
      owners (draft.nodes.keep((\ view (and (eq view.kind "view") (playground/reaches draft view.id node.id draft.nodes.len)))))
      owner=str (? (playground/component node) (? owners.len (str/cat_all ["View: " owners.at(0).name]) "Unattached component") "Declaration")
      owner (? (playground/component node) (str/cat_all [node.kind " - " owner]) owner)
      body (list/one (text node.name)).snoc((text (str/cat_all [(playground/card_label (playground/card_kind node)) " / " (nat/show node.id)]))).snoc((text (? node.value.len (node.value.slice(0 40)) owner)))
      body body.snoc((control "patch_select" "select" (str/cat_all ["Select " node.name])))
      body body.snoc((control "patch_handle" "move" (str/cat_all ["Move " node.name])))
      body body.weld(((playground_scene/ports node).cons("ref").map((\ port (control "patch_port" port (str/cat_all [(nat/show node.id) " " port])))).stream))
    | goo_patch/occurrence "patch_node" (nat/show node.id) body
  + edge_caption
    \ draft=playground/draft edge=playground/edge
    ^ str
    ? !(eq edge.port "child") edge.port
    = siblings (playground/edges_at draft edge.source "child")
    % i=nat 0
    ^ str
    ? (ge i siblings.len) "child"
    ? (eq siblings.at(i).id edge.id) (str/cat_all ["child " (nat/show i.inc)])
    | _ i.inc
  + edge_content
    \ draft=playground/draft edge=playground/edge
    ^ goo_patch/occurrence
    = text (playground_scene/native "text" (list/one (rex/cord (playground_scene/edge_caption draft edge))) .nil)
      label (playground_scene/native "patch_label" (list/one (rex/cord "relation")) (list/one text))
    | goo_patch/occurrence "patch_connection" (nat/show edge.id) (list/one label)
  + population
    \ draft=playground/draft
    ^ goo_patch/population
    = nodes (draft.nodes.keep((playground_scene/visible draft)))
      ids=row[nat] (nodes.map((\ node node.id)))
      edges (draft.edges.keep((\ edge (and (ids.has(edge.source)) (ids.has(edge.target))))))
    | goo_patch/population ((nodes.map((playground_scene/content draft))).weld(
        (edges.map((playground_scene/edge_content draft)))))
