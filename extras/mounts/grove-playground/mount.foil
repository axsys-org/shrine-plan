- explorer_mount
- grove_playground/routing

+ playground_mount
  + root
    \ self=iota
    ^ path
    [self 'app 'grove_playground]
  + schema
    \ self=iota
    ^ path
    [self 'gov 'grove_playground]
  + job_slot
    \ self=iota
    ^ path
    | (playground_mount/schema self).snoc('job)
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source (playground_mount/schema state.self) root (playground_mount/root state.self)
    ?> (./some version) state.case(.x source) (./err (pails/t "Playground publication missing"))
    ?> (./ok next) (grove_install/instantiate source version root state) (./err (pails/t "Playground installation failed"))
    = registration (grove_draft/registration root.snoc('draft) (playground_mount/job_slot state.self)
        source.snoc('preview) root.snoc('preview) source.snoc('published) root.snoc('published) "grove_role_runtime")
      next (grove_draft/write (grove_draft/registry state.self).snoc('playground)
        (myth/sing grove_draft/slot registration) next)
      [next index reply] (helm/supervisor/handle
        (helm/card/step [state.self 'kook 'hex]
          (writ/make (form/card (def_form.set_talk(playground_mount/talk)) (lore/line "Grove playground routes"))))
        next (sovereign_hive next))
    = provider (goo_patch/query_provider root.snoc('draft) playground_mount/query)
      next (grove_draft/write (goo_patch/query_path state.self source.snoc('editor))
        (myth/sing ['sys 'goo 'patch_query] provider) next)
    | ./ok next
  + draft
    \ state=namespace
    ^ maybe[playground/draft]
    = card (sovereign_peek (playground_mount/root state.self).snoc('draft) state).fil.fall(myth/new)
    ?> (./some held) card.get((playground_mount/schema state.self).snoc('document)) .none
    ?> draft=playground/draft held .none
    | ./some draft
  + component_order
    \ draft=playground/draft id=nat depth=nat
    ^ row[nat]
    ? (gt depth 64) []
    = out=row[nat] []
    | (playground/edges_at draft id "child").fold out
      (\ out edge (out.snoc(edge.target).weld((playground_mount/component_order draft edge.target depth.inc))))
  + diagnostic_node
    \ draft=playground/draft source=str line=nat
    ^ str
    % lines=row[str] (str/split_byte 10 source).take(line) owner=nat 0 ordinal=nat 0 found=str ""
    ^ str
    ? (eq lines.len 0) found
    = raw lines.at(0) text (str/trim_ascii raw)
    ? (eq text.slice(0 7) "' node ")
      = id (nat/parse text.slice(7 (sub text.len 7))).fall(0)
      | _ lines.drop(1) id 0 (nat/show id)
    ? (eq raw.slice(0 4) "    ")
      = components (playground_mount/component_order draft owner 0)
        next=str (? (lt ordinal components.len) (nat/show components.at(ordinal)) found)
      | _ lines.drop(1) owner ordinal.inc next
    | _ lines.drop(1) owner ordinal found
  + status
    \ state=namespace
    ^ [nat str]
    ?> (./some draft) (playground_mount/draft state) [404 "Draft unavailable"]
    = card (sovereign_peek (playground_mount/root state.self).snoc('draft) state).fil.fall(myth/new)
    ?> (./some held) card.get((playground_mount/job_slot state.self)) [404 "Compilation status unavailable"]
    ?> job=grove_draft/job held [409 "Invalid compilation status"]
    = nodes (draft.nodes.map((\ node (json/obj [(jkv "id" (json/str (nat/show node.id)))
        (jkv "kind" (json/str node.kind)) (jkv "cardKind" (json/str (playground/card_kind node))) (jkv "name" (json/str node.name))
        (jkv "value" (json/str node.value)) (jkv "slot" (json/str node.slot))]))))
      edges (draft.edges.map((\ edge (json/obj [(jkv "id" (json/str (nat/show edge.id)))
        (jkv "source" (json/str (nat/show edge.source))) (jkv "port" (json/str edge.port))
        (jkv "target" (json/str (nat/show edge.target))) (jkv "value" (json/str edge.value))]))))
      samples (sovereign_care .y (playground_mount/root state.self).snoc('preview) state).kid_tap
      preview=str
        ? samples.len
          = [key child] samples.at(0)
          | path_show (playground_mount/root state.self).weld(['preview key])
        ""
    [200 (show (json/obj [(jkv "revision" (json/str (nat/show draft.revision)))
      (jkv "ready" (json/str (nat/show job.ready))) (jkv "published" (json/str (nat/show job.published)))
      (jkv "diagnosticNode" (json/str (? job.line (playground_mount/diagnostic_node draft job.source job.line) (? (eq job.message.slice(0 5) "Node ") (str/split_byte 58 job.message.slice(5 (sub job.message.len 5))).at(0) ""))))
      (jkv "message" (json/str job.message)) (jkv "line" (json/str (nat/show job.line)))
      (jkv "source" (json/str job.source)) (jkv "preview" (json/str preview))
      (jkv "previewTargets" (json/arr (samples.map((\ [key child] (json/str (path_show (playground_mount/root state.self).weld(['preview key]))))))))
      (jkv "nodes" (json/arr nodes)) (jkv "edges" (json/arr edges))
      (jkv "cardKinds" (json/arr ((playground/card_kinds).map((\ kind (json/obj [(jkv "key" (json/str kind)) (jkv "label" (json/str (playground/card_label kind)))]))))))
      (jkv "hiddenKinds" (json/arr (draft.hidden_kinds.map((\ kind (json/str kind))))))
      (jkv "palette" (json/arr ((playground/kinds).map((\ kind (json/str kind))))))]))]
  + query_allows
    \ draft=playground/draft query=json target=json
    ^ bool
    = from (goo_patch/field "from" query) reconnect (goo_patch/field "reconnect" query)
    ? (equal reconnect jnull)
      ?> (./some source) (playground/target draft from) .false
      | (and (eq (playground/field "port" target) "ref") (playground/admissible draft source (playground/field "port" from) (playground/id "node" target)))
    = args (json/obj [(jkv "kind" (json/str "reconnect"))
        (jkv "connection" (goo_patch/field "connection" reconnect))
        (jkv "topologyRef" (goo_patch/field "topologyRef" reconnect))
        (jkv "endpoint" (goo_patch/field "endpoint" reconnect)) (jkv "to" target)])
    ? (playground/apply draft args)
     > (./ok next) .true
     > (./err why) .false
  + node_candidates
    \ draft=playground/draft query=json node=playground/node
    ^ row[json]
    | (playground_scene/ports node).cons("ref").map
      \ port
      = target (playground_scene/target node.id port)
      | json/obj [(jkv "target" target)
          (jkv "status" (json/str (? (playground_mount/query_allows draft query target) "allowed" "forbidden")))]
  + query_candidates
    \ draft=playground/draft query=json
    ^ row[json]
    = out=row[json] []
      nodes=row[playground/node] (draft.nodes.keep((playground_scene/visible draft)))
    | nodes.fold out
      (\ out node (out.weld((playground_mount/node_candidates draft query node))))
  + query
    \ query=json state=namespace
    ^ either[str json]
    ?> (./some draft) (playground_mount/draft state) (./err "Draft unavailable")
    = from (goo_patch/field "from" query)
    ?> (./some source) (playground/target draft from) (./err "Source retired")
    ?> (./some node) (playground/node_at draft source) (./err "Source unavailable")
    ? !(playground_scene/visible draft node) (./err "Source is hidden")
    ? !(eq (playground/field "sourceRev" (goo_patch/field "basis" query)) (nat/show draft.revision)) (./err "Query basis changed")
    = port (playground/field "port" from)
      canvas_ports=row[str] (playground_scene/ports node).cons("ref")
    ? !(canvas_ports.has(port)) (./err "Port is not on the canvas")
    = candidates (playground_mount/query_candidates draft query)
    = choices ((playground/choices port).keep((playground/creatable draft source port)).map((\ kind (weft/leaf "button"
        [(weft/att "type" "button") (weft/att "data-patch-choice" (str/to_atom (playground/choice_ref draft source port kind)))] (str/to_atom (str/cat_all ["Create " kind]))))))
      picker (str/from_atom (weft/render (weft/el "div" [(weft/att "aria-label" "Create and connect") ] choices)))
    | ./ok (json/obj [(jkv "pickerHTML" (json/str picker)) (jkv "queryId" (goo_patch/field "queryId" query))
      (jkv "gestureId" (goo_patch/field "gestureId" query)) (jkv "basis" (goo_patch/field "basis" query))
      (jkv "from" from) (jkv "candidates" (json/arr candidates))])
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = target (playground_mount/root state.self).snoc('draft)
      plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        = url (http_foot/split 63 request.target).at(0)
        ? (eq url "/grove-playground/state") (./snapshot playground_mount/status)
        ? ((eq url "/grove-playground") || (eq url "/grove-playground/"))
          = crew (crew/sing ['view] (dep .y target))
            crew crew.put(['catalog] (dep .x [state.self 'weft 'view_catalog_cache]))
          | ./wait (myth/sing ['grove_playground] (pails/p target)).put(crew_slot (cpail crew))
        = leaf (? (eq url "/grove-playground/routing.js") "routing.js" (? (eq url "/grove-playground/routing-worker.js") "routing-worker.js" (? (eq url "/grove-playground/app.js") "app.js" (? (eq url "/grove-playground/layout.js") "layout.js" (? (eq url "/grove-playground/style.css") "style.css" "")))))
          found (files.keep((\ [name bytes] (eq name leaf))))
        ? !(found.len) (./reply (http_driver/response 404 "Not found"))
        = [name bytes] found.at(0)
        | ./bytes 200 bytes (? (eq leaf "style.css") "text/css" "application/javascript")
    | http_foot/add_routes [(http_foot/route "/grove-playground" plan)] http_foot/empty
  + page
    \ target=path selected=axal[myth] catalog=axal[myth]
    ^ nat
    = card selected.fil.fall(myth/new)
      index (goo_browser/cached_index catalog)
      panes (goo_browser/matching_panes card index)
      content (panes.map((goo_browser/preview_at target card))).row
      scripts=row[str] ["goo-session" "goo-topoi-components" "goo-topoi" "goo-patch-components" "goo-patch" "goo-panes" "goo-inspection" "goo-actions"]
      assets (scripts.map((\ name (weft/el "script" [(weft/att "src" (str/to_atom (str/cat_all ["/static/" name ".js"]))) (weft/att "defer" "defer")] []))))
      styles=row[str] ["/static/goo-profile.css" "/static/goo-panes.css" "/static/goo-topoi-components.css" "/grove-playground/style.css"]
      assets assets.weld((styles.map((\ url (weft/el "link" [(weft/att "rel" "stylesheet") (weft/href (str/to_atom url))] [])))))
      assets assets.snoc((weft/el "script" [(weft/att "src" "/grove-playground/app.js") (weft/att "defer" "defer")] []))
    | weft/page_with_assets "Grove playground" assets
      [(weft/el "header" [] [(weft/leaf "h1" [] "Grove playground")
        (weft/leaf "p" [] "A Grove program, its component graph, and its live presentation.")])
       (weft/el "main" [(weft/att "data-target" (str/to_atom (path_show target)))
         (weft/att "data-view" (str/to_atom (path_show (playground_mount/schema target.at(0)).snoc('editor))))] content)
       (weft/el "section" [(weft/id "playground-preview") (weft/att "aria-label" "Live preview")] [])
       (weft/el "section" [(weft/id "playground-source") (weft/att "aria-label" "Generated Grove")] [])]
  + talk
    \ =bowl cur=myth add=myth
    ^ yell
    = out cur.meld(add)
    ?> (./some target) out.path_at(['grove_playground]) (goo_browser/talk bowl cur add)
    = body (playground_mount/page target (bowl.crew.gut(['view] (axal/new[myth] .none))) (bowl.crew.gut(['catalog] (axal/new[myth] .none))))
    | yell [] out.put(['res_status] (pd 200)).put(['res_body] (pd body)).put(['res_ctype] (pd "text/html; charset=utf-8"))
