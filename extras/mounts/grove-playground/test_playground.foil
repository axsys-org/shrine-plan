- grove_playground/mount
- testing

+ playground_checks
  + command
    \ kind=str fields=row[[str str]]
    ^ json
    | json/obj ((fields.map((\ [key value] (jkv key (json/str value))))).cons((jkv "kind" (json/str kind))))
  + accepted
    \ result=either[str playground/draft]
    ^ bool
    ? result
     > (./ok draft) .true
     > (./err message) .false
  + value
    \ result=either[str playground/draft]
    ^ playground/draft
    ? result
     > (./ok draft) draft
     > (./err _) playground/initial
  + compile
    \ draft=playground/draft
    ^ bool
    ?> (./ok text) (playground/source draft) .false
    ?> (./ok document) (grove/parse text) .false
    ? (grove_views/compile ['0x11 'gov 'playground_test] document (\ path .none) .nil (goo/html_types ['lib 'grove 'types]) "summary")
     > (./ok view) .true
     > (./err why) .false
  + palette_draft
    \ kind=str
    ^ playground/draft
    = draft playground/initial
      node (playground/node 5 kind "body" "" "/sys/slot/label")
      edges (draft.edges.keep((\ edge !(eq edge.id 10))))
      node (? (eq kind "text") node.set_value("Literal") node)
      edges (? (eq kind "show") draft.edges edges)
    | draft.set_nodes(draft.nodes.take(4).snoc(node)).set_edges(edges)
  + build
    \ commands=row[json] draft=playground/draft
    ^ either[str playground/draft]
    ? (eq commands.len 0) (./ok draft)
    < next (playground/apply draft commands.at(0))
    | playground_checks/build commands.drop(1) next
  + replace_point
    \ points=row[json] index=nat point=json
    ^ row[json]
    | (row/range 0 points.len).map((\ i (? (eq i index) point points.at(i))))
  + routing_ok
    \ result=either[str str]
    ^ bool
    ? result
     > (./ok _) .true
     > (./err _) .false
  + routing_fixture
    \ points=row[json] draft=playground/draft
    ^ json
    | json/obj [(jkv "basis" (json/str (playground_scene/routing_basis draft)))
        (jkv "routes" (json/arr [(json/obj [(jkv "key" (json/str "8")) (jkv "lifetime" (json/str "edge:8"))
          (jkv "topologyRef" (json/str "edge:8:4:2")) (jkv "points" (json/arr points))])]))]
  + routed_scene
    \ result=either[str str]
    ^ json
    ?> (./ok text) result (json/obj [])
    ?> (jres/ok scene _) (parse text) (json/obj [])
    | scene
  + continuous
    \ commands=row[json]
    ^ bool
    | (row/range 1 commands.len.dec).all
      \ i
      = point playground_routing/known_point knot (point commands.at(i) "to")
        before (point commands.at(i) "c2") after (point commands.at(i.inc) "c1")
      | and (eq (add knot.x knot.x) (add before.x after.x)) (eq (add knot.y knot.y) (add before.y after.y))
  + command_count
    \ result=maybe[row[json]]
    ^ nat
    ? result
     > (./some commands) commands.len
     > .none 0
  + curves_clear
    \ nodes=row[json] commands=row[json]
    ^ bool
    = boxes (nodes.map(playground_routing/spline_box)) point playground_routing/known_point
    | (row/range 1 commands.len).all
      \ i
      | playground_routing/controls_clear boxes (point commands.at(i.dec) "to")
          (point commands.at(i) "c1") (point commands.at(i) "c2") (point commands.at(i) "to")
  + move
    \ id=nat base=json proposed=json
    ^ json
    | json/obj [(jkv "kind" (json/str "move-nodes")) (jkv "nodes" (json/arr [(json/obj [
        (jkv "target" (json/obj [(jkv "kind" (json/str "node")) (jkv "node" (json/str (nat/show id)))
          (jkv "lifetime" (json/str (playground_scene/life id)))]))
        (jkv "baseOrigin" base) (jkv "proposedOrigin" proposed)])]))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial playground/initial
      source (playground/source initial)
      valid=bool
        ? source
         > (./ok source) (gt source.len 0)
         > (./err _) .false
      parsed=bool
        ?> (./ok text) source .false
        ? (grove/parse text)
         > (./ok document) .true
         > (./err why) .false
      compiled=bool
        ?> (./ok text) source .false
        ?> (./ok document) (grove/parse text) .false
        ? (grove_views/compile ['0x11 'gov 'playground_test] document (\ path .none) .nil (goo/html_types ['lib 'grove 'types]) "summary")
         > (./ok view) .true
         > (./err why) .false
      scene (playground_scene/scene initial)
      population (playground_scene/population initial)
      canvas_ports=row[row[str]] (initial.nodes.map(playground_scene/ports))
      curve_edge (playground_scene/edge initial initial.edges.at(0))
      curve_segment (goo_patch/items (goo_patch/field "segments" curve_edge)).at(0)
      curve_commands (goo_patch/items (goo_patch/field "commands" curve_segment))
      curve curve_commands.at(1)
      curve_label (goo_patch/field "rect" (goo_patch/items (goo_patch/field "labels" curve_edge)).at(0))
      apply (playground/apply initial)
      command playground_checks/command
      authored (playground_checks/build
        [(command "create" [["tag" "slot"] ["name" "lede"]])
         (command "create" [["tag" "role"] ["name" "record"]])
         (command "create" [["tag" "sample"] ["name" "example"]])
         (command "create" [["tag" "view"] ["name" "summary"]])
         (command "create" [["tag" "show"] ["name" "title"]])
         (command "link" [["source" "2"] ["port" "field"] ["target" "1"]])
         (command "link" [["source" "3"] ["port" "on"] ["target" "2"]])
         (command "link" [["source" "4"] ["port" "on"] ["target" "2"]])
         (command "link" [["source" "4"] ["port" "child"] ["target" "5"]])
         (command "link" [["source" "5"] ["port" "field"] ["target" "1"]])]
        (playground/draft 0 1 [] [] [] [] []))
      authored_compiles=bool
        ?> (./ok draft) authored .false
        | playground_checks/compile draft
      renamed (playground_checks/value (apply (command "update" [["id" "1"] ["name" "title"] ["value" ""] ["slot" ""]])))
      created (playground_checks/value (apply (command "create" [["tag" "col"] ["name" "column"]])))
      collapsed (playground_checks/value (apply (command "collapse" [["id" "4"]])))
      child (playground_checks/value (playground/apply created (command "link" [["source" "4"] ["port" "child"] ["target" "11"]])))
      grow (playground_checks/value (playground/apply child (command "create" [["tag" "group"] ["name" "group"]])))
      nested (playground_checks/value (playground/apply grow (command "link" [["source" "11"] ["port" "child"] ["target" "13"]])))
      reconnect_query (json/obj [(jkv "kind" (json/str "compatibility")) (jkv "from" (playground_scene/target 3 "on"))
        (jkv "reconnect" (json/obj [(jkv "connection" (json/obj [(jkv "kind" (json/str "connection")) (jkv "connection" (json/str "7")) (jkv "lifetime" (json/str "edge:7"))]))
          (jkv "topologyRef" (json/str "edge:7:3:2")) (jkv "endpoint" (json/str "to"))]))])
      choice (playground/choice_ref initial 4 "child" "text")
      creation (json/obj [(jkv "kind" (json/str "create-from-port"))
        (jkv "from" (playground_scene/target 4 "child")) (jkv "choiceRef" (json/str choice))
        (jkv "worldPoint" (playground_scene/point 200 400))])
      moved (json/obj [(jkv "kind" (json/str "move-nodes")) (jkv "nodes" (json/arr [(json/obj
        [(jkv "target" (json/obj [(jkv "kind" (json/str "node")) (jkv "node" (json/str "1")) (jkv "lifetime" (json/str "node:1"))]))
         (jkv "baseOrigin" (playground_scene/point 40 40)) (jkv "proposedOrigin" (playground_scene/point 70 80))])]))])
      moved (playground_checks/value (apply moved))
      presentation (playground_checks/palette_draft "present")
      presentation presentation.set_nodes(presentation.nodes.snoc((playground/node 11 "slot" "detail" "" "")).snoc((playground/node 12 "view" "details" "" "")).snoc((playground/node 13 "text" "literal" "Nested" "/sys/slot/label"))).set_edges(presentation.edges.snoc((playground/edge 14 12 "on" 2 "")).snoc((playground/edge 15 12 "for" 11 "")).snoc((playground/edge 16 12 "child" 13 "")).snoc((playground/edge 17 5 "view" 12 "")))
      component_kinds=row[str] (playground/kinds).drop(3)
      palettes=row[str] ["group" "row" "col" "or" "opt" "show" "text" "path"]
      deleted (playground_checks/value (playground/apply created (command "delete" [["id" "11"]])))
      recreated (playground_checks/value (playground/apply deleted (command "create" [["tag" "text"]])))
      reconnect (\ endpoint=str id=nat port=str (json/obj [(jkv "kind" (json/str "reconnect")) (jkv "id" (json/str "10")) (jkv "endpoint" (json/str endpoint)) (jkv "to" (playground_scene/target id port))]))
      reconnected (playground_checks/value (apply (reconnect "from" 3 "field")))
      newslot (playground_checks/value (apply (command "create" [["tag" "slot"] ["name" "other"]])))
      hidden (playground_checks/value (apply (command "visibility" [["tag" "role"] ["value" "hide"]])))
      hidden_twice (playground_checks/value (playground/apply hidden (command "visibility" [["tag" "role"] ["value" "hide"]])))
      hidden_view (playground_checks/value (apply (command "visibility" [["tag" "view"] ["value" "hide"]])))
      all_hidden (playground_checks/value (apply (command "visibility" [["tag" "*"] ["value" "hide"]])))
      restored (playground_checks/value (playground/apply all_hidden (command "visibility" [["tag" "*"] ["value" "show"]])))
      hidden_created (playground_checks/value (playground/apply all_hidden (command "create" [["tag" "text"]])))
      visibility_query (json/obj [(jkv "from" (playground_scene/target 4 "on"))])
      ' Route view -> role, with the same obstacle geometry as the old slot fixture.
      route_draft initial.set_edges([initial.edges.at(2)]).set_places([
        (playground/positive_placement 1 5000 5000) (playground/positive_placement 2 40 40)
        (playground/positive_placement 3 40 300) (playground/positive_placement 4 340 40)
        (playground/positive_placement 5 640 300)])
      rp playground_scene/point
      route_points [(rp 580 120) (rp 620 120) (rp 620 0) (rp 12 0) (rp 12 80) (rp 40 80)]
      negative_route_draft route_draft.set_places(route_draft.places.map((\ place place.set_bx((sub place.bx 700)).set_by((sub place.by 400)))))
      negative_points (route_points.map((\ p (playground_scene/world_point
        (sub (add 100000 (playground/id "x" p)) 700) (sub (add 100000 (playground/id "y" p)) 400)))))
      negative_routed (playground_checks/routed_scene (playground_routing/admit negative_route_draft
        (playground_checks/routing_fixture negative_points negative_route_draft)))
      negative_nodes (goo_patch/items (goo_patch/field "nodes" negative_routed))
      negative_edges (goo_patch/items (goo_patch/field "connections" negative_routed))
      negative_commands (goo_patch/items (goo_patch/field "commands" (goo_patch/items (goo_patch/field "segments" negative_edges.at(0))).at(0)))
      np (playground_scene/world_point 99760 99840)
      negative_move (playground_checks/move 3 (rp 40 300) np)
      negative_result (apply negative_move)
      negative (playground_checks/value negative_result)
      negative_again (playground/apply negative (playground_checks/move 3 np (playground_scene/world_point 99600 99700)))
      positive_again (playground/apply negative (playground_checks/move 3 np (rp 50 60)))
      proposal (playground_checks/routing_fixture route_points route_draft)
      admit (playground_routing/admit route_draft)
      routed (playground_checks/routed_scene (admit proposal))
      routed_edge (goo_patch/items (goo_patch/field "connections" routed)).at(0)
      routed_commands (goo_patch/items (goo_patch/field "commands" (goo_patch/items (goo_patch/field "segments" routed_edge)).at(0)))
      route_ok playground_checks/routing_ok
      fixture (\ points=row[json] (playground_checks/routing_fixture points route_draft))
      free_spline (playground_routing/commands [] [(playground_routing/point 100100 100100) (playground_routing/point 100400 100100) (playground_routing/point 100400 100300) (playground_routing/point 100700 100300)])
      short_wire (playground_routing/commands [] [(playground_routing/point 100000 100000) (playground_routing/point 100020 100000)])
      short_c1 (playground_routing/known_point short_wire.at(1) "c1")
      short_c2 (playground_routing/known_point short_wire.at(1) "c2")
      guide [(playground_routing/point 100580 100120) (playground_routing/point 100620 100120)
        (playground_routing/point 100620 100000) (playground_routing/point 100012 100000)
        (playground_routing/point 100012 100080) (playground_routing/point 100040 100080)]
      shortcut (playground_routing/shortcut [] guide 6)
      blocked_sweep (playground_routing/sweep [(playground_routing/box 3100000 3100000 200000 200000)] guide 48 .true 2)
      spline_bounds (playground_routing/include_command (playground_routing/box 100000 100000 1000 600)
        (playground_routing/cubic (playground_routing/point 99500 99000) (playground_routing/point 102000 101000) (playground_routing/point 100500 100500)))
    [(testing/nat "move across both zero axes accepted" 1 (playground_checks/accepted negative_result))
     (testing/nat "negative move keeps program revision" initial.revision negative.revision)
     (testing/nat "negative move keeps generated Grove" 1 (eq source (playground/source negative)))
     (testing/nat "negative placement retained exactly" 99760 (playground_scene/place negative 3).bx)
     (testing/nat "negative base accepted for subsequent movement" 1 (playground_checks/accepted negative_again))
     (testing/nat "movement back across zero accepted" 1 (playground_checks/accepted positive_again))
     (testing/nat "stale positive base rejected after negative move" 0 (playground_checks/accepted (playground/apply negative negative_move)))
     (testing/text "action preserves the specific rejection reason" "Placement changed during movement"
        (playground/edit_error (playground/apply negative negative_move)))
     (testing/nat "missing base origin rejected" 0 (playground_checks/accepted (apply (playground_checks/move 3 (json/obj []) np))))
     (testing/nat "signed node rect reaches scene" 1 (equal (playground_scene/world_rect 99760 99840 240 208)
        (goo_patch/field "rect" (playground_scene/node negative initial.nodes.at(2)))))
     (testing/nat "negative fraction rounds symmetrically" 99987 (playground/coordinate (json/real "-12.6")).fall(0))
     (testing/nat "negative zero normalizes" 100000 (playground/coordinate (json/num .true 0)).fall(0))
     (testing/nat "coordinate rejects nonnumeric input" 1 (maybe/is_none (playground/coordinate (json/str "-12"))))
     (testing/nat "coordinate rejects negative overflow" 1 (maybe/is_none (playground/coordinate (json/real "-100000.1"))))
     (testing/nat "coordinate rejects positive overflow" 1 (maybe/is_none (playground/coordinate (json/real "100000.1"))))
     (testing/nat "picker can create at a negative position" 1 (playground_checks/accepted (apply (playground_routing/set "worldPoint" np creation))))
     (testing/nat "routing admits guides among negative cards" 1 (gt negative_edges.len 0))
     (testing/nat "negative obstacle box retains signed position" 99340 (playground_routing/node_box negative_nodes.at(0) 0).x)
     (testing/nat "negative fitted curves clear real cards" 1 (playground_checks/curves_clear negative_nodes negative_commands))
     (testing/nat "routed bounds preserve negative node origin" 1 (le (playground_routing/known_coordinate (goo_patch/field "x" (goo_patch/field "extent" negative_routed))) 99340))
     (testing/nat "short collinear cable never doubles back" 1 (and (le short_c1.x short_c2.x) (and (ge short_c1.x 100000) (le short_c2.x 100020))))
     (testing/nat "sweep leaves the rectangular guide envelope" 1 (lt (playground_routing/known_point routed_commands.at(1) "to").y 100000))
     (testing/nat "whole-cable fit clears every real card" 1 (playground_checks/curves_clear (goo_patch/items (goo_patch/field "nodes" routed)) routed_commands))
     (testing/nat "shortcut removes all unnecessary interior knots" 2 (playground_checks/command_count shortcut))
     (testing/nat "blocked sweep is rejected" 0 (playground_checks/command_count blocked_sweep))
     (testing/nat "nearby card limits exit independently" 20 (playground_routing/port_reach [(playground_routing/box 3219200 3201280 8320 5600)] (playground_routing/point 100580 100120) 196 .true))
     (testing/nat "fit bounds include spline control hull" 1 (and (le spline_bounds.x 99500) (le spline_bounds.y 99000)))
     (testing/nat "open space uses one broad cubic" 2 free_spline.len)
     (testing/nat "obstacle spline has continuous knot tangents" 1 (playground_checks/continuous routed_commands))
     (testing/nat "spline contains no line commands" 0 (routed_commands.keep((\ command (eq (playground/field "op" command) "L")))).len)
     (testing/nat "cubic validator rejects a card crossing" 0 (playground_routing/controls_clear [(playground_routing/box 3200000 3200000 320 320)]
        (playground_routing/point 99990 100005) (playground_routing/point 100000 100005) (playground_routing/point 100010 100005) (playground_routing/point 100020 100005)))
     (testing/nat "routing accepts an obstacle detour" 1 (route_ok (admit proposal)))
     (testing/text "routing marks installed basis" (str/cat_all [(playground_scene/routing_basis route_draft) ":spline-v3"]) (playground/field "layoutRev" (goo_patch/field "header" routed)))
     (testing/nat "routing replaces five guide legs with two broad spans" 2 (routed_commands.keep((\ command (eq (playground/field "op" command) "C")))).len)
     (testing/text "routing preserves topology" "edge:8:4:2" (playground/field "topologyRef" routed_edge))
     (testing/nat "routing rejects stale basis" 0 (route_ok (admit (playground_routing/set "basis" (json/str "old") proposal))))
     (testing/nat "routing rejects incomplete population" 0 (route_ok (admit (playground_routing/set "routes" (json/arr []) proposal))))
     (testing/nat "routing rejects changed endpoints" 0 (route_ok (admit (fixture (playground_checks/replace_point route_points 0 (rp 579 120))))))
     (testing/nat "routing rejects diagonal segment" 0 (route_ok (admit (fixture (playground_checks/replace_point route_points 2 (rp 619 0))))))
     (testing/nat "routing rejects card crossing" 0 (route_ok (admit (fixture [(rp 580 120) (rp 620 120) (rp 620 80) (rp 12 80) (rp 40 80)]))))
     (testing/nat "routing rejects wrong port direction" 0 (route_ok (admit (fixture [(rp 580 120) (rp 12 120) (rp 12 80) (rp 40 80)]))))
     (testing/nat "routing rejects coordinate overflow" 0 (route_ok (admit (fixture (playground_checks/replace_point route_points 2 (rp 620 100001))))))
     (testing/nat "routing rejects nonnumeric coordinates" 0 (route_ok (admit (fixture (playground_checks/replace_point route_points 2 (json/str "NaN"))))))
     (testing/nat "routing rejects duplicate vertices" 0 (route_ok (admit (fixture (playground_checks/replace_point route_points 2 (rp 620 120))))))
     (testing/nat "placement changes routing basis" 1 !(eq (playground_scene/routing_basis initial) (playground_scene/routing_basis moved)))
     (testing/nat "visibility changes routing basis" 1 !(eq (playground_scene/routing_basis initial) (playground_scene/routing_basis hidden)))
     (testing/nat "one cubic segment per edge" 2 curve_commands.len)
     (testing/text "route begins at source" "M" (playground/field "op" curve_commands.at(0)))
     (testing/text "route uses a cubic" "C" (playground/field "op" curve))
     (testing/nat "source handle follows outward normal" 1 (equal (playground_scene/point 660 120) (goo_patch/field "c1" curve)))
     (testing/nat "target handle preserves negative coordinates" 1 (equal (json/obj [(jkv "x" (json/num .true 40)) (jkv "y" (playground_scene/number 80))]) (goo_patch/field "c2" curve)))
     (testing/nat "curve reaches target anchor" 1 (equal (playground_scene/point 40 80) (goo_patch/field "to" curve)))
     (testing/nat "label centered on cubic midpoint x" 262 (playground/id "x" curve_label))
     (testing/nat "label centered on cubic midpoint y" 88 (playground/id "y" curve_label))
     (testing/nat "unknown visibility kind rejected" 0 (playground_checks/accepted (apply (command "visibility" [["tag" "unknown"] ["value" "hide"]]))))
     (testing/nat "constructors are not separate visibility categories" 0 (playground_checks/accepted (apply (command "visibility" [["tag" "show"] ["value" "hide"]]))))
     (testing/nat "all Goo constructors share the view card category" 1 (component_kinds.all((\ kind (eq (playground/card_kind (playground/node 99 kind "" "" "")) "view")))))
     (testing/nat "hide all stores three canvas categories" 3 all_hidden.hidden_kinds.len)
     (testing/nat "unknown visibility value rejected" 0 (playground_checks/accepted (apply (command "visibility" [["tag" "role"] ["value" "toggle"]]))))
     (testing/nat "visibility preserves semantic revision" initial.revision hidden.revision)
     (testing/nat "visibility preserves identity allocation" initial.serial hidden.serial)
     (testing/nat "visibility preserves nodes" initial.nodes.len hidden.nodes.len)
     (testing/nat "visibility preserves relationships" initial.edges.len hidden.edges.len)
     (testing/nat "visibility preserves placement" 1 (eq initial.places hidden.places))
     (testing/nat "visibility preserves generated source" 1 (eq source (playground/source hidden)))
     (testing/nat "hidden declarations still compile" 1 (playground_checks/compile hidden))
     (testing/nat "hiding twice is idempotent" 1 hidden_twice.hidden_kinds.len)
     (testing/nat "hiding role removes its card and two canvas wires" 4 (playground_scene/population hidden).occurrences.len)
     (testing/nat "hiding view category hides declaration and body cards" 2 (hidden_view.nodes.keep((playground_scene/visible hidden_view))).len)
     (testing/nat "collapse and kind visibility compose" 2 (collapsed.nodes.keep((playground_scene/visible collapsed.set_hidden_kinds(["role"])))).len)
     (testing/nat "hide all projects no occurrences" 0 (playground_scene/population all_hidden).occurrences.len)
     (testing/nat "show all restores occurrences" population.occurrences.len (playground_scene/population restored).occurrences.len)
     (testing/nat "new cards respect hidden kind preference" 0 (playground_scene/population hidden_created).occurrences.len)
     (testing/nat "hidden targets excluded from compatibility advice" 1 ((playground_mount/query_candidates hidden visibility_query).all((\ candidate !(eq (playground/field "node" (goo_patch/field "target" candidate)) "2")))))
     (testing/nat "slots are never visible, including after show all" 0 (playground_scene/visible restored restored.nodes.at(0)))
     (testing/nat "new slots never become graph nodes" 0 (playground_scene/visible newslot newslot.nodes.at(5)))
     (testing/nat "slots are not a canvas visibility category" 0 (playground_checks/accepted (apply (command "visibility" [["tag" "slot"] ["value" "show"]]))))
     (testing/nat "slot-only ports omitted from canvas" 0 (canvas_ports.any((\ ports=row[str] ((ports.has("field")) || (ports.has("for")))))))
     (testing/nat "slot references remain semantic ports" 1 ((playground/ports initial.nodes.at(1)).has("field")))
     (testing/nat "slots excluded from compatibility candidates" 1 ((playground_mount/query_candidates initial visibility_query).all((\ candidate !(eq (playground/field "node" (goo_patch/field "target" candidate)) "1")))))
     (testing/nat "slot ports excluded from compatibility candidates" 1 ((playground_mount/query_candidates initial visibility_query).all((\ candidate !((eq (playground/field "port" (goo_patch/field "target" candidate)) "field") || (eq (playground/field "port" (goo_patch/field "target" candidate)) "for"))))))
     (testing/nat "slot placement does not enlarge canvas" 1000 (playground/id "width" (goo_patch/field "extent" (playground_checks/routed_scene (./ok (playground_scene/scene route_draft))))))
     (testing/nat "initial draft generates Grove" 1 valid)
     (testing/nat "complete program can be created through commands" 1 (playground_checks/accepted authored))
     (testing/nat "program authored from empty draft compiles" 1 authored_compiles)
     (testing/nat "generated source parses as Grove" 1 parsed)
     (testing/nat "generated view compiles with real Grove view compiler" 1 compiled)
     (testing/nat "scene has only non-slot occurrences and wires" 7 population.occurrences.len)
     (testing/nat "scene is nonempty" 1 (gt scene.len 0))
     (testing/nat "rename retains identity" 1 renamed.nodes.at(0).id)
     (testing/nat "rename retains relationship targets" 1 renamed.edges.at(0).target)
     (testing/nat "semantic edit advances revision" 2 renamed.revision)
     (testing/nat "new identity is monotonic" 11 created.serial)
     (testing/nat "new node is retained" 6 created.nodes.len)
     (testing/nat "collapse leaves semantics unchanged" 1 collapsed.revision)
     (testing/nat "collapse hides component from slot-free canvas" 3 ((collapsed.nodes.keep((playground_scene/visible collapsed))).len))
     (testing/nat "collapse preserves all relationships" 5 collapsed.edges.len)
     (testing/nat "multiple parents forbidden" 0 (playground/compatible initial 4 "child" 5))
     (testing/nat "component cycles forbidden" 0 (playground/compatible nested 13 "child" 11))
     (testing/nat "view receiver accepts role" 1 (playground/compatible initial 4 "on" 2))
