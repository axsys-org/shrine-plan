- inspector_mount
- tests/namespace [at=fixture]
- testing

+ inspector_checks
  + get
    \ config=http_foot/config method=str target=str
    ^ http_foot/action
    | http_foot/dispatch config.routes (http_foot/request method target "") 0
  + status
    \ action=http_foot/action
    ^ nat
    ? action
     > (./bytes status body mime) status
     > (./reply response) response.status
    0
  + bytes
    \ action=http_foot/action
    ^ nat
    ?> (./bytes status body mime) action 0
    body
  + routes
    \ ignored=unit
    ^ row[testing/check]
    = files=row[[str nat]] [["goo-live.html" 11] ["goo-live.css" 22] ["goo-live.js" 33]]
      config (inspector_mount/http files fixture/namespace_tests/initial)
      read (inspector_checks/get config "GET" "/live")
      script (inspector_checks/get config "GET" "/static/goo-live.js?v=retained")
      style (inspector_checks/get config "GET" "/static/goo-live.css")
      missing (inspector_mount/http [] fixture/namespace_tests/initial)
    [(testing/nat "optional inspector owns four routes" 4 config.routes.len)
     (testing/nat "inspector page is served" 11 (inspector_checks/bytes read))
     (testing/nat "cache-versioned assets use existing HTTP route dispatch" 33 (inspector_checks/bytes script))
     (testing/nat "inspector stylesheet is served" 22 (inspector_checks/bytes style))
     (testing/nat "inspector has no mutation endpoint" 405 (inspector_checks/status (inspector_checks/get config "POST" "/live")))
     (testing/nat "missing packaged assets return not found" 404 (inspector_checks/status (inspector_checks/get missing "GET" "/live")))
     (testing/nat "inspector does not claim MCP transport" 404 (inspector_checks/status (inspector_checks/get config "GET" "/mcp")))]

+ tests
  ^ row[testing/case]
  [(testing/case "Optional read-only inspector routes" inspector_checks/routes)]
