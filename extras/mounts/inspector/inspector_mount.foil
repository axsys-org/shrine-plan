- http_foot

' Optional read-only inspector. Native MCP owns its transport and operations;
' this mount owns only its page and static assets.
+ inspector_mount
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = serve
        \ name=str mime=str request=http_foot/request now=nat
        ^ http_foot/action
        ? !(eq request.method "GET") (./reply (http_driver/response 405 "GET required"))
        = found (files.keep((\ [key bytes] (eq key name))))
        ? !(eq found.len 1) (./reply (http_driver/response 404 "Inspector asset not found"))
        = [key bytes] found.at(0)
        | ./bytes 200 bytes mime
      routes=row[http_foot/route]
        [(http_foot/route "/live" (serve "goo-live.html" "text/html; charset=utf-8"))
         (http_foot/route "/static/goo-live.html" (serve "goo-live.html" "text/html; charset=utf-8"))
         (http_foot/route "/static/goo-live.css" (serve "goo-live.css" "text/css"))
         (http_foot/route "/static/goo-live.js" (serve "goo-live.js" "application/javascript"))]
    | http_foot/add_routes routes http_foot/empty
