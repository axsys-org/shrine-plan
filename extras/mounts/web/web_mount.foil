- browser_routes
- source_mount

+ web_mount
  + install
    \ state=namespace
    ^ either[pail namespace]
    | ./ok state
  + http
    \ files=row[[str nat]] state=namespace
    ^ http_foot/config
    = assets
        | files.map
          \ [name bytes]
          | http_foot/asset (str/cat_all ["/" name]) bytes "text/css"
      plan
        \ request=http_foot/request now=nat
        ^ http_foot/action
        | browser_routes/plan assets
          (browser_routes/local_route [state.self] request) now
      prefixes=row[str]
        ["/edit" "/post" "/op" "/vine" "/grove/install"
         "/frag" "/w.js" "/style.css"]
      routes
        | prefixes.map
          \ prefix=str
          | http_foot/route prefix plan
    | http_foot/add_routes routes http_foot/empty
