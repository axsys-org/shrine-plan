- browser_request
-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  lain_peek [order=60]
-  lain_poke [order=70]
-  weft [order=80]
-  tyshow [order=90]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  eden [order=160]
-  testing [order=170]
- tests/namespace [at=fixture]
'  Direct application tests use real kernel transitions, without actors,
'  sockets, compiler mirrors, or a filesystem-wide boot.
+  app_world
  : state=namespace index=hive valid=bool
  + path
    \ relative=path
    ^ path
    ? (relative.starts(($x 17))) relative
    ? (relative.starts('sys)) relative
    ? ((is_h relative) || ((is_o relative) || (is_xv relative))) relative
    | row/weld relative [($x 17)]
  +  step
    \ command=task world=app_world
    ^ app_world
    = command
        ? command
         > (./vine target write) (task/vine (app_world/path target) write)
        command
    = [result index] | sovereign_cycle_with world.index command 0 8 0 0 world.state
    ? result
     > (./fail _) world.set_valid(.false)
     > (./spun next moves rounds ack spill)
      ? (moves.len || (maybe/is_some spill)) world.set_valid(.false)
      | app_world next index world.valid
  +  refuses
    \ command=task world=app_world
    ^ bool
    = command
        ? command
         > (./vine target write) (task/vine (app_world/path target) write)
        command
    = [result index] | sovereign_cycle_with world.index command 0 8 0 0 world.state
    ?=((./fail _) result)
  +  make
    \ target=path record=myth world=app_world
    ^ app_world
    | app_world/step (task/vine target (writ/make record)) world
  +  poke
    \ target=path record=myth world=app_world
    ^ app_world
    | app_world/step (task/vine target (writ/poke record)) world
  +  get
    \ target=path world=app_world
    ^ myth
    | (sovereign_peek (app_world/path target) world.state).fil.fall myth/new
  +  tree
    \ target=path world=app_world
    ^ axal[myth]
    | sovereign_peek (app_world/path target) world.state
  +  number
    \ target=path slot=path fallback=nat world=app_world
    ^ nat
    (app_world/get target world).nat_at(slot fallback)
  +  text
    \ target=path slot=path world=app_world
    ^ str
    (app_world/get target world).txt_at(slot)
  +  pail
    \ target=path slot=path world=app_world
    ^ maybe[pail]
    (app_world/get target world).get(slot)
  +  exists
    \ target=path world=app_world
    ^ bool
    | maybe/is_some (sovereign_peek (app_world/path target) world.state).fil
  +  seed
    ^ app_world
    = initial fixture/namespace_tests/initial
      ready | eden/boot ($x 17) initial.system sov/new 18131
    ? ready
     > (./ok state)
      = world (app_world state (sovereign_hive state) .true)
      = world (app_world/make ['kook 'hex]
          (form/card explorer/form (lore/line "Explorer fixture")) world)
      | app_world/make ['weft 'kook 'face]
        (form/card zoo/form (lore/line "Component fixture")) world
    | app_world initial (sovereign_hive initial) .false
  +  mount
    \ manifest=mani name=text root=path world=app_world
    ^ app_world
    = root | app_world/path root
      card
        | (pact/card manifest name 0 0).put
          limb_slot (kook [[($x 17) 'kook 'pact]])
      next | app_world/make root card world
    | (zoo/tasks root name manifest).fold next
    \ current command
    | app_world/step command current
  +  post
    \ target=path fields=row[[key=iota value=text]] world=app_world
    ^ app_world
    = record
        | fields.fold myth/new
        \ record [key value]
        record.put(['post key] (pails/t value))
    | app_world/poke target record world
  +  page
    \ target=path fragment=bool world=app_world
    ^ text
    = record | browser_request/req "GET" "" "" (app_world/path target)
      record ? fragment record.put(['frag] (pd 1)) record
      next | app_world/make ['request] record world
      next | app_world/poke ['request] (kooked [[($x 17) 'kook 'hex]]) next
      response | app_world/get ['request] next
    ? !(next.valid) ""
    ? !(eq 200 response.nat_at(['res_status] 0)) ""
    | str/from_atom | response.nat_at ['res_body] 0
  +  contains
    \ expected=row[text] body=text
    ^ row[testing/check]
    | expected.map
    \ text
    | testing/nat text 1 (cord/has text body)
  +  lacks
    \ absent=row[text] body=text
    ^ row[testing/check]
    = checks
        | absent.map
        \ text
        | testing/nat text 0 (cord/has text body)
    | checks.snoc
      (testing/nat "successful nonempty response" 1 !(eq body ""))
  +  okay
    \ world=app_world
    ^ testing/check
    | testing/nat "all transitions committed" 1 world.valid
