- weft
'  Shared Mash markup helpers; no namespace or request policy.
+  web_ui
  +  rows
    '  Weld a row of node rows into one page body.
    \  parts=row[row[weft/node]]
    ^  row[weft/node]
    %  idx=nat 0  out=row[weft/node] []
    ?  (eq idx parts.len)
       out
    | _ idx.inc out.weld(parts.at(idx))

  +  badge
    '  A mash badge — the design system's chip.
    \  tone=nat s=nat
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'ui-badge[size=small]
          'tone tone
          ~. s
    markup.at(0)

  +  card
    '  A mash card: a titled pane with content kids.
    \  title=nat kids=row[weft/node]
    ^  weft/node
    = markup
        ~ weft/build
        ~| 'ui-card
          ~. 'span[slot=title] title
          ~| 'div[slot=content]
            kids
    markup.at(0)

  +  table
    '  A mash table wrapping prebuilt ui-table-row nodes.
    \  label=nat rws=row[weft/node]
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'ui-table
          'label label
          ~| 'ui-table-body
            rws
    markup.at(0)
