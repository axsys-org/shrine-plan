- browser_page
- testing
+ page_checks
  \ _=unit
  ^ row[testing/check]
  = want
      | cord/cat_all
        ["<!doctype html><html lang=" 34 "en" 34 "><head>"
         "<meta charset=" 34 "utf-8" 34 "></meta>"
         "<meta name=" 34 "viewport" 34 " content=" 34
         "width=device-width, initial-scale=1" 34 "></meta>"
         "<title>t</title><style>body{color:red}</style>"
         "<link rel=" 34 "stylesheet" 34 " href=" 34
         "/style.css" 34 "></link><script defer=" 34 "defer" 34
         " src=" 34 browser_page/mash_url 34 "></script>"
         "</head><body data-mash-catalogue=" 34 "mash" 34
         "><h1>hi</h1></body></html>"]
  [(testing/same[nat] "browser assets and catalogue belong to extras" str/from_atom want
    (browser_page/page "t" "body{color:red}" [(weft/leaf "h1" [] "hi")]))]
+ tests
  ^ row[testing/case]
  [(testing/case "browser document" page_checks)]
