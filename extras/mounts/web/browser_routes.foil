- browser_request
- http_foot
- web

+ browser_routes
  + form_record
    \ kind=str fields=row[[key=str value=str]] now=nat
    ^ myth
    | fields.fold (? (equal[str] kind "op") (myth/sing ['when] (pd now)) myth/new)
    \ record [key value]
    ? (equal[str] key "back") record
    ? (equal[str] key "") record
    ? (equal[str] kind "op")
      ? (equal[str] key "op") record
      = pax (browser_routes/target key)
      ? (nat/parse value)
       > (./some n) record.put(pax (pd n))
       > .none record.put(pax (pails/t value))
    = pax=path
        ? (equal[str] kind "post") ['post ($ts key)]
        [($ts key)]
    | record.put pax (pails/t value)
  + journal_query
    ' Strict paging grammar. Decode before checking duplicates, retain
    ' arbitrary-size decimal epochs as naturals, and never accept an
    ' unknown parameter as an accidentally ignored cursor.
    \ target=str
    ^ http_foot/action
    = parts (http_foot/split 63 target)
    ? (gt parts.len 2)
      | ./reply (http_driver/response 400 "Invalid journal query")
    = query=str (? (eq parts.len 2) parts.at(1) "")
    ? (eq query.len 0) (./journal .none 40)
    ?> (./ok fields) (Try[str row[[key=str value=str]]] http_foot/fields query)
      | ./reply (http_driver/response 400 "Invalid journal query encoding")
    % i=nat 0 before=maybe[nat] .none limit=maybe[nat] .none viewed=bool .false
    ^ http_foot/action
    ? (eq i fields.len) (./journal before limit.fall(40))
    = [key value] fields.at(i)
    ? (equal[str] key "before")
      ? (maybe/is_some before)
        | ./reply (http_driver/response 400 "Duplicate before cursor")
      ?> (./some n) (nat/parse value)
        | ./reply (http_driver/response 400 "before must be a decimal epoch")
      ? !(equal[str] value (nat/show n))
        | ./reply (http_driver/response 400 "before must be a canonical decimal epoch")
      | _ i.inc (./some n) limit viewed
    ? (equal[str] key "limit")
      ? (maybe/is_some limit)
        | ./reply (http_driver/response 400 "Duplicate page limit")
      ?> (./some n) (nat/parse value)
        | ./reply (http_driver/response 400 "limit must be an integer from 1 to 40")
      ? ((eq n 0) || (gt n 40) || !(equal[str] value (nat/show n)))
        | ./reply (http_driver/response 400 "limit must be an integer from 1 to 40")
      | _ i.inc before (./some n) viewed
    ? (equal[str] key "view")
      ? (viewed || !(equal[str] value "rendered"))
        | ./reply (http_driver/response 400 "Invalid or duplicate view mode")
      | _ i.inc before limit .true
    | ./reply (http_driver/response 400 "Unknown journal query parameter")

  + value_path
    ' Query values are already percent-decoded. Require the canonical
    ' namespace spelling, without aliases, dot paths, or a second decode.
    \ text=str
    ^ maybe[path]
    ? ((eq text.len 0) || (gt text.len 4096) || !(eq text.at(0) 47)) .none
    ? !(value_read/identifier text) .none
    ? (text.split_byte(47).any((\ part=str ((equal[str] part ".") || (equal[str] part ".."))))) .none
    ?> (./some pax) (path_parse text) .none
    ? !(equal[str] text (path_show pax)) .none
    | ./some pax
  + value_number
    \ text=str
    ^ maybe[nat]
    ?> (./some n) (nat/parse text) .none
    ? !(equal[str] text (nat/show n)) .none
    | ./some n
  + value_query
    \ target=str
    ^ http_foot/action
    = bad (http_foot/action/reply (http_foot/value_error 'invalid_query 400))
      parts (http_foot/split 63 target)
    ? ((gt target.len 32768) || !(eq parts.len 2)) bad
    ?> (./ok fields) (Try[str row[[key=str value=str]]] http_foot/fields parts.at(1)) bad
    % i=nat 0 pax=maybe[path] .none slot=maybe[path] .none
      epoch=maybe[nat] .none offset=maybe[nat] .none limit=maybe[nat] .none
    ^ http_foot/action
    ? (eq i fields.len)
      ?> (./some p) pax bad
      ?> (./some k) slot bad
      ?> (./some e) epoch bad
      ?> (./some o) offset bad
      ?> (./some n) limit bad
      | ./value (value_read/request p k e o n)
    = [key value] fields.at(i)
    ? (equal[str] key "path")
      ? (maybe/is_some pax) bad
      ?> (./some p) (browser_routes/value_path value) bad
      | _ i.inc (./some p) slot epoch offset limit
    ? (equal[str] key "slot")
      ? (maybe/is_some slot) bad
      ?> (./some k) (browser_routes/value_path value) bad
      | _ i.inc pax (./some k) epoch offset limit
    ? (equal[str] key "epoch")
      ? (maybe/is_some epoch) bad
      ?> (./some e) (browser_routes/value_number value) bad
      | _ i.inc pax slot (./some e) offset limit
    ? (equal[str] key "offset")
      ? (maybe/is_some offset) bad
      ?> (./some o) (browser_routes/value_number value) bad
      | _ i.inc pax slot epoch (./some o) limit
    ? (equal[str] key "limit")
      ? (maybe/is_some limit) bad
      ?> (./some n) (browser_routes/value_number value) bad
      ? ((eq n 0) || (gt n 65536)) bad
      | _ i.inc pax slot epoch offset (./some n)
    bad

  + physical_ascii
    ' The structural wire codec and parameter names are printable ASCII.
    ' Check raw fields before split can drop a trailing packed NUL.
    \ text=str
    ^ bool
    % i=nat 0
    ? (eq i text.len) .true
    = byte text.at(i)
    ? ((lt byte 33) || (gt byte 126)) .false
    | _ i.inc
  + physical_query
    \ target=str
    ^ http_foot/action
    = bad (http_foot/action/reply (http_foot/value_error 'invalid_query 400))
    ? (gt target.len 32800) bad
    ? !(browser_routes/physical_ascii target) bad
    = parts (http_foot/split 63 target)
    ? !(eq parts.len 2) bad
    = raw parts.at(1)
    ? ((eq raw.len 0) || (gt raw.len 32768)) bad
    ?> (./ok fields) (Try[str row[[key=str value=str]]] browser_routes/physical_fields raw) bad
    % i=nat 0 pax=maybe[path] .none collection=maybe[iota] .none
      epoch=maybe[nat] .none after=maybe[path] .none limit=maybe[nat] .none
    ^ http_foot/action
    ? (eq i fields.len)
      ?> (./some p) pax bad
      ?> (./some c) collection bad
      ? (? (maybe/is_some after) (maybe/is_none epoch) .false) bad
      ? (? (eq_iota c 'children) (after.run((\ key=path !(eq key.len 1))).fall(.false)) .false) bad
      | ./physical (physical_read/request p epoch c after limit.fall(40))
    = [key value] fields.at(i)
    ? ((eq value.len 0) || !(browser_routes/physical_ascii key) || !(browser_routes/physical_ascii value)) bad
    ? (equal[str] key "pathKey")
      ? (maybe/is_some pax) bad
      ?> (./some p) (physical_key/decode value) bad
      | _ i.inc (./some p) collection epoch after limit
    ? (equal[str] key "collection")
      ? (maybe/is_some collection) bad
      ? (equal[str] value "children") (_ i.inc pax (./some 'children) epoch after limit)
      ? (equal[str] value "slots") (_ i.inc pax (./some 'slots) epoch after limit)
      bad
    ? (equal[str] key "epoch")
      ? ((maybe/is_some epoch) || (gt value.len 128)) bad
      ?> (./some e) (browser_routes/value_number value) bad
      | _ i.inc pax collection (./some e) after limit
    ? (equal[str] key "after")
      ? (maybe/is_some after) bad
      ?> (./some a) (physical_key/decode value) bad
      | _ i.inc pax collection epoch (./some a) limit
    ? (equal[str] key "limit")
      ? ((maybe/is_some limit) || (gt value.len 2)) bad
      ?> (./some n) (browser_routes/value_number value) bad
      ? ((eq n 0) || (gt n 40)) bad
      | _ i.inc pax collection epoch after (./some n)
    bad

  + physical_decode
    ' Called only after the raw physical query passed printable ASCII.
    ' Canonical codec strings need no allocation or byte-by-byte rebuild.
    ' Encoded input keeps the existing strict percent/NUL/plus behavior.
    \ text=str
    ^ str
    % i=nat 0
    ? (eq i text.len) text
    = byte text.at(i)
    ? ((eq byte 37) || (eq byte 43)) (http_foot/decode .true text)
    | _ i.inc
  + physical_fields
    \ raw=str
    ^ row[[key=str value=str]]
    | (http_foot/split 38 raw).map
    \ field=str
    ? (http_foot/find "=" field)
     > (./some at)
       [(browser_routes/physical_decode field.slice(0 at))
        (browser_routes/physical_decode field.slice(at.inc field.len))]
     > .none [(browser_routes/physical_decode field) ""]

  + plan
    \ assets=row[http_foot/asset] request=http_foot/request now=nat
    ^ http_foot/action
    = url (http_foot/split 63 request.target).at(0)
      fields (http_foot/fields request.body)
    ? (equal[str] url "/w.js")
      | ./reply (http_response 200 weft/runtime "application/javascript")
    ? (equal[str] url "/style.css")
      | ./reply (http_response 200
          (http_foot/asset_body "/style.css" assets) "text/css")
    ? (http_foot/route_is "/grove/install" url)
      ? !(equal[str] request.method "POST")
        | ./reply (http_driver/response 405 "POST required")
      ?> (./some version)
          (nat/parse (http_foot/field "version" fields))
        | ./reply (http_driver/response 400 "Template version required")
      = source (http_foot/field "source" fields)
      ? (eq source.len 0)
        | ./reply (http_driver/response 400 "Published Grove path required")
      = target (http_foot/field "root" fields)
      ? ((eq target.len 0) || !(eq target.at(0) 47))
        | ./reply (http_driver/response 400 "Instance root required")
      | ./install (browser_routes/target source) version
          (browser_routes/target target) (str/cat_all ["/ns" target])
    ? (http_foot/route_is "/chore" url)
      | ./reply (http_driver/response 501 "Compiler service is not installed.")
    = post (http_foot/route_is "/post" url)
      edit (http_foot/route_is "/edit" url)
      op (http_foot/route_is "/op" url)
      vine (http_foot/route_is "/vine" url)
    ? (post || edit || op || vine)
      ? !(equal[str] request.method "POST")
        | ./reply (http_driver/response 405 "POST required")
      = pax (browser_routes/target url.slice((? op 3 5) url.len))
        back (http_foot/field "back" fields)
        back
          ? (back.len || edit) (? edit (str/cat_all ["/ns" (path_show pax)]) back)
          (str/cat_all ["/ns" (path_show pax)])
      ? vine
        ? (equal[str] (http_foot/field "verb" fields) "cull")
          | ./write pax .cull back
        | ./reply (http_driver/response 501 "Expression writes require the compiler service.")
      ? op
        = operation (browser_routes/target (http_foot/field "op" fields))
        ? (eq operation.len 0)
          | ./reply (http_driver/response 400 "op= must name an operation")
        | ./write pax (writ/warp operation (browser_routes/form_record "op" fields now)) back
      | ./write pax (writ/poke (browser_routes/form_record (? post "post" "edit") fields now)) back
    ? !(equal[str] request.method "GET")
      | ./reply (http_driver/response 405 "GET required")
    ? (http_foot/route_is "/frag" url)
      = prefix=path ['o]
        pax prefix.weld((browser_routes/target url.slice(5 url.len)))
      | ./wait (browser_request/req request.method url request.body pax).put(['frag] (pails/t "1"))
    | ./wait (browser_request/req request.method url request.body (browser_routes/target url))

  + local_route
    \ root=path request=http_foot/request
    ^ http_foot/request
    = parts (http_foot/split 63 request.target)
      url parts.at(0)
      local_journal=bool
        ? !(http_foot/route_is "/debug" url) .false
        | eq_pith (browser_routes/target url.slice(6 url.len)) root.snoc('log)
    ? local_journal
      | request.set_target
        (str/cat_all ["/debug/log" request.target.slice(url.len request.target.len)])
    ? (http_foot/route_is "/weft" request.target)
      | request.set_target
        (str/join "" ["/ns" (path_show root) request.target])
    request

  + target
    \ raw=str
    ^ path
    = text=str
        ? (equal[str] raw "/ns") "/"
        ? (equal[str] raw.slice(0 4) "/ns/") raw.slice(3 raw.len)
        raw
    | http_foot/target text
