- patch_demo_contract
- testing

+ patch_demo_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = move (patch_demo/apply "{""kind"":""move-nodes"",""nodes"":[{""target"":{""kind"":""node"",""node"":""source"",""lifetime"":""node-life:source""},""baseOrigin"":{""x"":40,""y"":80},""proposedOrigin"":{""x"":60,""y"":100}}]}" patch_demo/initial)
      stale (patch_demo/apply "{""kind"":""move-nodes"",""nodes"":[{""target"":{""kind"":""node"",""node"":""source"",""lifetime"":""retired""},""baseOrigin"":{""x"":40,""y"":80},""proposedOrigin"":{""x"":60,""y"":100}}]}" patch_demo/initial)
      connect (patch_demo/apply "{""kind"":""connect"",""from"":{""kind"":""port"",""node"":""source"",""nodeLifetime"":""node-life:source"",""port"":""out"",""lifetime"":""port-life:source:out""},""to"":{""kind"":""port"",""node"":""sink"",""nodeLifetime"":""node-life:sink"",""port"":""in"",""lifetime"":""port-life:sink:in""}}" patch_demo/initial)
      invalid (patch_demo/apply "{""kind"":""connect"",""from"":{""kind"":""port"",""node"":""sink"",""nodeLifetime"":""node-life:sink"",""port"":""in"",""lifetime"":""port-life:sink:in""},""to"":{""kind"":""port"",""node"":""source"",""nodeLifetime"":""node-life:source"",""port"":""out"",""lifetime"":""port-life:source:out""}}" patch_demo/initial)
    [(testing/nat "server accepts saved placement" 1 (maybe/is_some move))
     (testing/nat "server rejects replaced occurrence" 1 (maybe/is_none stale))
     (testing/nat "server accepts directed connection" 1 (maybe/is_some connect))
     (testing/nat "server rejects reversed port roles" 1 (maybe/is_none invalid))]

+ tests
  [(testing/case "Patch demo domain admission" patch_demo_checks/checks)]
