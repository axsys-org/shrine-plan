- grove_install

+ patch_demo_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov ($ts "patch_demo")]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing development template")
    ? (grove_install/instantiate source version
        [state.self 'app ($ts "patch_demo")] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (patch_demo_mount/failure why))
