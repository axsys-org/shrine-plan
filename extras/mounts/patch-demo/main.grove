#import text=lib/grove/types/text

scene =
  @slot

operation =
  @slot

board =
  @role
  %/scene: text

edit =
  @action
  #on ; %/board
  %/operation: text
  ! foil
  \ operation=text board=%/board
  ^ %/board
  ?> (./some next) (patch_demo/apply operation board.scene)
    | Seq[%/board] (error (pails/t "Invalid or stale patch operation")) board
  board.set_scene(next)

editor =
  @pane
  #on ; %/board
  #for ; /sys/slot/content
  board => patch('/canvas, scene = board.scene, label = "Goo patch board") {
    patch_node("source") {
      patch_handle("move", label = "Move source")
      show("Source", '/sys/slot/title)
      patch_port("out", label = "source out")
    }
    patch_node("transform") {
      patch_handle("move", label = "Move transform")
      show("Transform", '/sys/slot/title)
      patch_port("in", label = "transform in")
      patch_port("state", label = "transform state")
      patch_port("out", label = "transform out")
    }
    patch_node("sink") {
      patch_handle("move", label = "Move sink")
      show("Sink", '/sys/slot/title)
      patch_port("in", label = "sink in")
      patch_port("preview", label = "sink preview")
    }
    patch_connection("wire") {}
    patch_operation("move-nodes", slot = '/0x11/gov/patch_demo/operation) {
      group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
        input('/0x11/gov/patch_demo/operation)
        action("Apply move-nodes")
      }
    }
    patch_operation("connect", slot = '/0x11/gov/patch_demo/operation) {
      group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
        input('/0x11/gov/patch_demo/operation)
        action("Apply connect")
      }
    }
    patch_operation("reconnect", slot = '/0x11/gov/patch_demo/operation) {
      group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
        input('/0x11/gov/patch_demo/operation)
        action("Apply reconnect")
      }
    }
    patch_operation("disconnect", slot = '/0x11/gov/patch_demo/operation) {
      group(on = board, action = %/edit, myth = { %/operation = .input("") }) {
        input('/0x11/gov/patch_demo/operation)
        action("Apply disconnect")
      }
    }
  }

"/board" =
  @tree
  %/scene: (pails/t patch_demo/initial)
