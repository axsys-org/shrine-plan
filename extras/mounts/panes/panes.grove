#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import req=sys/req
#import res=sys/res
#import lede=sys/lede

archived =
  @slot

study_name =
  @slot

study =
  @role
  lede: text
  %/study_name: text
  #opt ;
    %/archived: path_type

card =
  @role
  req: text
  res: text

archive =
  @action
  #on ; %/study
  %/archived: path_type
  ! foil
  \ archived=path_type study=%/study
  ^ %/study
  study.set_archived((./some archived))

summary =
  @view
  #on ; %/card
  #for ; /sys/slot/summary
  card => { show(card.req, '/sys/slot/title) }

content =
  @view
  #on ; %/card
  #for ; /sys/slot/content
  card => {
    present(card, '/sys/slot/summary)
    show(card.res, '/sys/slot/content)
    action("Edit", become = '/sys/slot/edit)
  }

edit =
  @view
  #on ; %/card
  #for ; /sys/slot/edit
  card => group(on = card, action = .poke, myth = {
    '/sys/req = .input(card.req)
    '/sys/res = .input(card.res)
  }) {
    input('/sys/req)
    input('/sys/res)
    action("Save")
    action("Save and read", become = '/sys/slot/content)
  }

workspace =
  @pane
  #on ; %/study
  #for ; /sys/slot/workspace
  study => {
    or {
      show(study.archived, '/sys/slot/content)
      show("No card remembered yet.", '/sys/slot/hint)
    }
    pane(%/workspace_1)
    pane(%/second_workspace)
  }

review_workspace =
  @pane
  #on ; %/study
  #for ; /sys/slot/review
  study => {
    selection('/current, source = '/0x11/app/srs/cards) {
      split {
        pane(%/queue_2, ports = { '/current = '/current })
        pane(%/detail_2, ports = { '/current = '/current })
      }
    }
  }

"/study" =
  @tree
  %/study_name: "Pane specimen"
  lede: "Two independent Goo workspaces"

"/cards" =
  @tree

"/cards/a" =
  @tree
  req: "Card A"
  res: "Selection owns the context."

"/cards/b" =
  @tree
  req: "Card B"
  res: "Actions capture that context."

"/cards/c" =
  @tree
  req: "Card C"
  res: "Recipes belong to the encounter."


detail =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/detail
  #port ; /current
  study => {
    follow('/subject, selection = '/current, slot = '/sys/slot/content)
  }

queue =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/queue
  #port ; /current
  study => {
    list('/rows, source = '/0x11/app/panes/cards, selection = '/current, slot = '/sys/slot/summary)
  }

second_workspace =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/second_workspace
  study => {
    selection('/current, source = '/0x11/app/panes/cards, initial = .member('/0x11/app/panes/cards/a)) {
      split {
        pane(%/queue, ports = { '/current = '/current })
        pane(%/detail, ports = { '/current = '/current })
      }
    }
  }

inspection =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/inspection
  #port ; /current
  study => {
    follow('/subject, selection = '/current, slot = '/sys/slot/synthetic)
  }

detail_1 =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/detail_1
  #port ; /current
  study => {
    follow('/subject, selection = '/current, slot = '/sys/slot/content)
  }

queue_1 =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/queue_1
  #port ; /current
  study => {
    list('/rows, source = '/0x11/app/panes/cards, selection = '/current, slot = '/sys/slot/summary)
  }

workspace_1 =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/workspace_1
  study => {
    selection('/current, source = '/0x11/app/panes/cards) {
      split {
        pane(%/queue_1, ports = { '/current = '/current })
        deck('/details) {
          pane(%/detail_1, ports = { '/current = '/current })
          pane(%/inspection, ports = { '/current = '/current })
        }
      }
      group(on = study, action = %/archive, myth = {
        %/archived = .capture('/current)
      }) {
        action("Remember selected card")
      }
    }
  }

detail_2 =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/detail_2
  #port ; /current
  study => {
    follow('/subject, selection = '/current, slot = '/sys/slot/req)
  }

queue_2 =
  @pane
  #on ; %/study
  #for ; /sys/slot/pane/queue_2
  #port ; /current
  study => {
    list('/rows, source = '/0x11/app/srs/cards, selection = '/current, slot = '/sys/slot/res)
  }

topoi_demo =
  @pane
  #on ; %/study
  #for ; /sys/slot/topoi
  study => selection('/chosen, source = '/0x11/app/panes/tree, topology = "tree") {
    list('/flat, source = '/0x11/app/panes/tree, selection = '/chosen, slot = '/sys/slot/summary)
    list_tree('/outline, source = '/0x11/app/panes/tree, selection = '/chosen, slot = '/sys/slot/summary)
    diagram_tree('/diagram, source = '/0x11/app/panes/tree, selection = '/chosen, slot = '/sys/slot/summary)
    follow('/detail, selection = '/chosen, slot = '/sys/slot/content)
    group(on = study, action = %/archive, myth = {
      %/archived = .capture('/chosen)
    }) {
      action("Remember tree node")
    }
  }

"/tree" =
  @tree
  req: "Topics"
  res: "One membership, three topoi."

"/tree/languages" =
  @tree
  req: "Languages"
  res: "Expand to choose a language."

"/tree/languages/grove" =
  @tree
  req: "Grove"
  res: "Declarations and seeded objects."

"/tree/languages/goo" =
  @tree
  req: "Goo"
  res: "Views, panes, and topoi."

"/tree/runtime" =
  @tree
  req: "Runtime"
  res: "Selection belongs to the shared port."
