#import text=lib/grove/types/text
#import path_type=lib/grove/types/path
#import req=sys/req
#import res=sys/res
#import lede=sys/lede

archived =
  @slot

study_name =
  @slot

study =
  @role
  lede: text
  %/study_name: text
  #opt ;
    %/archived: path_type

card =
  @role
  req: text
  res: text

archive =
  @action
  #on ; %/study
  %/archived: path_type
  ! foil
  \ archived=path_type study=%/study
  ^ %/study
  study.set_archived((./some archived))

summary =
  @view
  #on ; %/card
  #for ; /sys/slot/summary
  card => { show(card.req, '/sys/slot/title) }

content =
  @view
  #on ; %/card
  #for ; /sys/slot/content
  card => {
    present(card, '/sys/slot/summary)
    show(card.res, '/sys/slot/content)
    action("Edit", become = '/sys/slot/edit)
  }

edit =
  @view
  #on ; %/card
  #for ; /sys/slot/edit
  card => group(on = card, action = .poke, myth = {
    '/sys/req = .input(card.req)
    '/sys/res = .input(card.res)
  }) {
    input('/sys/req)
    input('/sys/res)
    action("Save")
    action("Save and read", become = '/sys/slot/content)
  }

workspace =
  @view
  #on ; %/study
  #for ; /sys/slot/workspace
  study => {
    or {
      show(study.archived, '/sys/slot/content)
      show("No card remembered yet.", '/sys/slot/hint)
    }
    pane('/workspace) {
      selection('/current, source = '/0x11/app/panes/cards) {
        split {
          pane('/queue) {
            list('/rows, source = '/0x11/app/panes/cards, selection = '/current, slot = '/sys/slot/summary)
          }
          deck('/details) {
            pane('/detail) {
              follow('/subject, selection = '/current, slot = '/sys/slot/content)
            }
            pane('/inspection) {
              follow('/subject, selection = '/current, slot = '/sys/slot/synthetic)
            }
          }
        }
        group(on = study, action = %/archive, myth = {
          %/archived = .capture('/current)
        }) {
          action("Remember selected card")
        }
      }
    }
    pane('/second_workspace) {
      selection('/current, source = '/0x11/app/panes/cards, initial = .member('/0x11/app/panes/cards/a)) {
        split {
          pane('/queue) {
            list('/rows, source = '/0x11/app/panes/cards, selection = '/current, slot = '/sys/slot/summary)
          }
          pane('/detail) {
            follow('/subject, selection = '/current, slot = '/sys/slot/content)
          }
        }
      }
    }
  }

review_workspace =
  @view
  #on ; %/study
  #for ; /sys/slot/review
  study => pane('/review) {
    selection('/current, source = '/0x11/app/srs/cards) {
      split {
        pane('/queue) {
          list('/rows, source = '/0x11/app/srs/cards, selection = '/current, slot = '/sys/slot/res)
        }
        pane('/detail) {
          follow('/subject, selection = '/current, slot = '/sys/slot/req)
        }
      }
    }
  }

"/study" =
  @tree
  %/study_name: "Pane specimen"
  lede: "Two independent Goo workspaces"

"/cards" =
  @tree

"/cards/a" =
  @tree
  req: "Card A"
  res: "Selection owns the context."

"/cards/b" =
  @tree
  req: "Card B"
  res: "Actions capture that context."

"/cards/c" =
  @tree
  req: "Card C"
  res: "Recipes belong to the encounter."
