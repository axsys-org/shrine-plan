-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  weft [order=80]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  helm [order=130]
-  testing [order=170]
-  apps/loom/main [order=190]
-  app_test_world [order=200]

+  fst
  (@ a b)
  \ pair=[a b]
  ^ a
  = [x _] pair
  x
+  snd
  (@ a b)
  \ pair=[a b]
  ^ b
  = [_ y] pair
  y
+  check
  \ n=nat yes=bool
  ^ testing/check
  | testing/nat (nat/show n) 1 yes

+  parse_text
  \ p=pres
  ^ nat
  ? p
   > (./ok text _) text
   > (./bad why) why
+  parse_kids
  \ p=pres
  ^ row[lnode]
  ? p
   > (./ok _ kids) kids
  []
+  path_value
  \ p=maybe[path]
  ^ path
  ?> (./some value) p []
  value
+  text_record
  \ pairs=row[[path nat]]
  ^ myth
  | pairs.fold myth/new
  \ record [key value]
  record.put(key (pt (str/from_atom value)))
+  text_at
  \ slot=path record=myth
  ^ nat
  | str/to_atom (myth/txt_at slot record)
+  rendered
  \ world=app_world target=path
  ^ nat
  = record (page_html (app_world/tree target world))
  ?> (./some node) (frag/as_node record.pail_at(['html])) 0
  (weft/render node)

+  behavior
  \ _=unit
  ^ row[testing/check]
  = base app_world/seed
  = nl 10
  = ttag=path ['tag]
  = ttext=path ['text]
  = tcls=path ['cls]
  = tpart=path ['part]
  = tdata=path ['data]
  = tsrc=path ['src]
  = terr=path ['err]
  = p1 (parse_src "<p>hi</p>")
  = p1m (lmounts [] (parse_kids p1))
  = p2 (parse_src (cord/cat_all [ "  <p   class=" 34 "x" 34
      "  >a &amp; b</p>" nl "  <br/>" nl]))
  = p2m (lmounts [] (parse_kids p2))
  = p3 (parse_src "<div><h2>t</h2><p>b</p></div>")
  = p3m (lmounts [] (parse_kids p3))
  = psrc (cord/cat_all [ "<part part=" 34 "/app/life/weft/board" 34
      " data=" 34 "/app/life/board" 34 ">" ])
  = p4 (parse_src psrc)
  = p4rec (snd ((lmounts [] (parse_kids p4))).at(0))
  = p5 (parse_src "<script>hi</script>")
  = tapp=iota 'app
  = tloom=iota 'loom
  = hub=path [tapp tloom 'p]
  = home=path [tapp tloom 'p 'home]
  = about=path [tapp tloom 'p 'about]
  = m1 (app_world/mount app "apps/loom/main" ['app 'loom] base)
  = s1 m1
  = hm1 (app_world/get home s1)
  = part1 (app_world/get home.snoc(($u 5)) s1)
  = part2 (app_world/get home.snoc(($u 7)) s1)
  = src0 (text_at tsrc hm1)
  = zfat (app_world/tree home s1)
  = im (rec_image zfat)
  = rp (parse_src src0)
  = tpsrc=path ['post 'src]
  = src1 (cord/cat_all [ "<h2 class=" 34 "big" 34 ">edited</h2>" nl
      "<p>hello &amp; goodbye</p>" ])
  = g1 (app_world/poke home (myth/sing tpsrc (pt (str/from_atom src1)))
      s1)
  = s2 g1
  = hm2 (app_world/get home s2)
  = src2 (cord/cat_all [ "<h2>edited</h2>" nl
      "<p>hello &amp; goodbye</p>" ])
  = g2 (app_world/poke home (myth/sing tpsrc (pt (str/from_atom src2)))
      s2)
  = s3 g2
  = k0 (app_world/get home.snoc(($u 0)) s3)
  = zf3 (app_world/tree home s3)
  = im3 (rec_image zf3)
  = rp3 (parse_src (text_at tsrc (app_world/get home s3)))
  = g3 (app_world/poke home (myth/sing tpsrc (pt "<p>oops" )) s3)
  = s4 g3
  = hm4 (app_world/get home s4)
  = g4 (app_world/poke home (myth/sing tpsrc (pt "<p>fresh</p>" )) s4)
  = s5 g4
  = g5 (app_world/step (task/vine home.snoc(($u 0)) (writ/poke
      (myth/sing ttext (pt "retitled" )))) s5)
  = s6 g5
  = tpop=path ['post 'op]
  = tpat=path ['post 'at]
  = tptag=path ['post 'tag]
  = tptext=path ['post 'text]
  = tpwith=path ['post 'with]
  = g6 (app_world/poke home (text_record [[tpop "add" ] [tpat "." ]
      [tptag "p" ] [tptext "added" ]]) s6)
  = s7 g6
  = g6b (app_world/poke home (text_record [[tpop "add" ] [tpat "." ]
      [tptag "script" ] [tptext "boom" ]]) s7)
  = s7b g6b
  = g7 (app_world/poke home (text_record [[tpop "tag" ] [tpat "0" ]
      [tptag "h3" ]]) s7b)
  = s8 g7
  = g8 (app_world/poke home (text_record [[tpop "del" ] [tpat "0" ]])
      s8)
  = s9 g8
  = zf9 (app_world/tree home s9)
  = im9 (rec_image zf9)
  = rp9 (parse_src (text_at tsrc (app_world/get home s9)))
  = asrc (cord/cat_all [ "<section><p>inner</p></section>" nl
      "<p>flat</p>" ])
  = ga (app_world/poke about (myth/sing tpsrc (pt (str/from_atom asrc)))
      s9)
  = sa ga
  = gb (app_world/poke about (text_record [[tpop "swap" ] [tpat "0" ]
      [tpwith "1" ]]) sa)
  = sb gb
  = tpnew=path ['post 'new]
  = gc (app_world/poke hub (myth/sing tpnew (pt "scratch" )) sb)
  = sc gc
  = scratch=path [tapp tloom 'p 'scratch]
  = thtml=path ['html]
  = h0 (rendered s1 home)
  = script_rec (text_record [[ttag "script" ] [ttext
      "<script>boom</script>" ]])
  = gd (app_world/step (task/vine scratch.snoc(($u 1)) (writ/make
      script_rec)) sc)
  = sd gd
  = h1r (rendered sd scratch)
  [
    (check 1 (equal[row[nat]] (split_slash "a/bb") ["a" "bb"]))
    (check 2 (equal[row[nat]] (split_slash "/a/b/") ["a" "b"]))
    (check 3 ?=((./some _) (parse_rel ".")))
    (check 4 (equal[path] (path_value (parse_rel ".")) []))
    (check 5 (equal[path] (path_value (parse_rel "0/2" )) [($u 0) ($u
      2)]))
    (check 6 ?=(.none (parse_rel "x")))
    (check 7 ?=(.none (parse_rel "")))
    (check 8 (equal[path] (parse_abs "/0x0001/app/loom/p/home" ) [($x 256) 'app 'loom 'p
      'home]))
    (check 9 (equal[path] (parse_abs "app/3") ['app ($u 3)]))
    (check 10 (equal[path] (parse_abs "$3") [($ta "3")]))
    (check 11 (equal[nat] (rel_text []) "."))
    (check 12 (equal[nat] (rel_text [($u 0) ($u 2)]) "0/2"))
    (check 13 (equal[nat] (tag_ok "p") 1))
    (check 14 (equal[nat] (tag_ok "script") 0))
    (check 15 (equal[nat] (safe_href "/app/loom") "/app/loom"))
    (check 16 (equal[nat] (safe_href "javascript:alert(1)") "#"))
    (check 17 (equal[nat] (safe_href "JavaScript:x") "#"))
    (check 18 (equal[nat] (decode_ent "a&amp;b") "a&b"))
    (check 19 (equal[nat] (decode_ent "x&y") "x&y"))
    (check 20 (equal[nat] (decode_ent "a&lt;b&gt;") "a<b>"))
    (check 21 (equal[nat] (clean_run (cord/cat_all [ "  a" nl "  b  "
      ])) "a b" ))
    (check 22 (equal[nat] (clean_run (cord/cat_all ["  " nl " "])) 0))
    (check 23 ?=((./ok _ _) p1))
    (check 24 (equal[nat] (parse_text p1) 0))
    (check 25 (equal[nat] (row/len p1m) 1))
    (check 26 (equal[path] (fst (p1m).at(0)) [($u 0)]))
    (check 27 (equal[nat] (text_at ttag (snd (p1m).at(0))) "p"))
    (check 28 (equal[nat] (text_at ttext (snd (p1m).at(0))) "hi"))
    (check 29 (equal[nat] (parse_text (parse_src "hello")) "hello"))
    (check 30 ?=((./ok _ _) p2))
    (check 31 (equal[nat] (row/len p2m) 2))
    (check 32 (equal[nat] (text_at tcls (snd (p2m).at(0))) "x"))
    (check 33 (equal[nat] (text_at ttext (snd (p2m).at(0))) "a & b"))
    (check 34 (equal[nat] (text_at ttag (snd (p2m).at(1))) "br"))
    (check 35 (equal[nat] (row/len p3m) 3))
    (check 36 (equal[path] (fst (p3m).at(0)) [($u 0)]))
    (check 37 (equal[path] (fst (p3m).at(1)) [($u 0) ($u 0)]))
    (check 38 (equal[path] (fst (p3m).at(2)) [($u 0) ($u 1)]))
    (check 39 ?=((./ok _ _) p4))
    (check 40 (equal[nat] (myth/has_at tpart p4rec) 1))
    (check 41 (equal[nat] (myth/has_at tdata p4rec) 1))
    (check 42 ?=((./ok _ _) p5))
    (check 43 (equal[nat] (text_at ttag (snd ((lmounts [] (parse_kids
      p5))).at(0))) "script" ))
    (check 44 ?=((./bad _) (parse_src "<p>oops")))
    (check 45 (equal[nat] (parse_text (parse_src "<p>oops" ))
      "unclosed element p" ))
    (check 46 (equal[nat] (parse_text (parse_src "<p>a</q>" ))
      "mismatched close q" ))
    (check 47 (equal[nat] (parse_text (parse_src "<p>a<em>b</em>c</p>"
      )) "text after a child element" ))
    (check 48 (equal[nat] (parse_text (parse_src (cord/cat_all [
      "<p foo=" 34 "x" 34 ">a</p>" ]))) "unknown attribute foo" ))
    (check 49 (equal[nat] (parse_text (parse_src "<p class=x>a</p>" ))
      "malformed attribute" ))
    (check 50 (equal[nat] (parse_text (parse_src "<P>x</P>" ))
      "a tag opens with a lowercase name" ))
    (check 51 m1.valid)
    (check 52 (app_world/exists home s1))
    (check 53 (equal[nat] (text_at ttag (app_world/get home.snoc(($u 0))
      s1)) "h1" ))
    (check 54 (equal[nat] (myth/has_at tpart part1) 1))
    (check 55 (equal[nat] (myth/has_at tdata part2) 1))
    (check 56 (app_world/exists [tapp tloom 'weft 'page] s1))
    (check 57 (app_world/exists [tapp tloom 'kook 'page] s1))
    (check 58 (app_world/exists [tapp tloom 'kook 'hub] s1))
    (check 59 (app_world/exists [tapp tloom 'kook 'face] s1))
    (check 60 (equal[nat] (? src0 1 0) 1))
    (check 61 (equal[nat] (cord/has "<h1>loom</h1>" src0) 1))
    (check 62 (equal[nat] (cord/has "<part part=" src0) 1))
    (check 63 ?=((./ok _ _) rp))
    (check 64 (equal[nat] (parse_text rp) (fst im)))
    (check 65 (equal[row[[p=path q=row[mop/kv[path pail]]]]] (tapped
      (lmounts [] (parse_kids rp))) (snd im)))
    (check 66 (equal[nat] (unparse_page zfat) src0))
    (check 67 g1.valid)
    (check 68 (equal[nat] (text_at tsrc hm2) src1))
    (check 69 (equal[nat] (text_at terr hm2) 0))
    (check 70 (equal[nat] (text_at ttag (app_world/get home.snoc(($u 0))
      s2)) "h2" ))
    (check 71 (equal[nat] (text_at tcls (app_world/get home.snoc(($u 0))
      s2)) "big" ))
    (check 72 (equal[nat] (text_at ttext (app_world/get home.snoc(($u
      0)) s2)) "edited" ))
    (check 73 (equal[nat] (text_at ttext (app_world/get home.snoc(($u
      1)) s2)) "hello & goodbye" ))
    (check 74 (!(app_world/exists home.snoc(($u 5)) s2)))
    (check 75 (!(app_world/exists home.snoc(($u 8)) s2)))
    (check 76 g2.valid)
    (check 77 (equal[nat] (myth/has_at tcls k0) 1))
    (check 78 (equal[nat] (text_at tcls k0) 0))
    (check 79 (equal[nat] (parse_text rp3) (fst im3)))
    (check 80 (equal[row[[p=path q=row[mop/kv[path pail]]]]] (tapped
      (lmounts [] (parse_kids rp3))) (snd im3)))
    (check 81 (equal[nat] (text_at tsrc (app_world/get home s3)) src2))
    (check 82 g3.valid)
    (check 83 (equal[nat] (text_at terr hm4) "unclosed element p"))
    (check 84 (equal[nat] (text_at tsrc hm4) src2))
    (check 85 (equal[nat] (text_at ttag (app_world/get home.snoc(($u 0))
      s4)) "h2" ))
    (check 86 (equal[nat] (text_at terr (app_world/get home s5)) 0))
    (check 87 (equal[nat] (text_at ttext (app_world/get home.snoc(($u
      0)) s5)) "fresh" ))
    (check 88 (!(app_world/exists home.snoc(($u 1)) s5)))
    (check 89 g5.valid)
    (check 90 (equal[nat] (text_at ttext (app_world/get home.snoc(($u
      0)) s6)) "retitled" ))
    (check 91 (equal[nat] (text_at tsrc (app_world/get home s6))
      "<p>retitled</p>" ))
    (check 92 (equal[nat] (text_at ttext (app_world/get home.snoc(($u
      1)) s7)) "added" ))
    (check 93 (equal[nat] (text_at tsrc (app_world/get home s7))
      (cord/cat_all [ "<p>retitled</p>" nl "<p>added</p>" ])))
    (check 94 (!(app_world/exists home.snoc(($u 2)) s7b)))
    (check 95 (equal[nat] (text_at ttag (app_world/get home.snoc(($u 0))
      s8)) "h3" ))
    (check 96 (!(app_world/exists home.snoc(($u 0)) s9)))
    (check 97 (equal[nat] (text_at tsrc (app_world/get home s9))
      "<p>added</p>" ))
    (check 98 (equal[nat] (parse_text rp9) (fst im9)))
    (check 99 (equal[row[[p=path q=row[mop/kv[path pail]]]]] (tapped
      (lmounts [] (parse_kids rp9))) (snd im9)))
    (check 100 (equal[nat] (text_at ttag (app_world/get about.snoc(($u
      0)) sa)) "section" ))
    (check 101 (equal[nat] (text_at ttext (app_world/get (row/snoc ($u
      0) about.snoc(($u 0))) sa)) "inner" ))
    (check 102 (equal[nat] (text_at ttext (app_world/get about.snoc(($u
      1)) sa)) "flat" ))
    (check 103 (equal[nat] (text_at ttag (app_world/get about.snoc(($u
      0)) sb)) "p" ))
    (check 104 (equal[nat] (text_at ttext (app_world/get about.snoc(($u
      0)) sb)) "flat" ))
    (check 105 (equal[nat] (text_at ttag (app_world/get about.snoc(($u
      1)) sb)) "section" ))
    (check 106 (equal[nat] (text_at ttext (app_world/get (row/snoc ($u
      0) about.snoc(($u 1))) sb)) "inner" ))
    (check 107 (!(app_world/exists (row/snoc ($u 0) about.snoc(($u 0)))
      sb)))
    (check 108 (equal[nat] (text_at tsrc (app_world/get about sb))
      (cord/cat_all [ "<p>flat</p>" nl "<section>" nl "  <p>inner</p>"
      nl "</section>" ])))
    (check 109 (app_world/exists scratch sc))
    (check 110 (equal[nat] (text_at ttag (app_world/get scratch.snoc(($u
      0)) sc)) "p" ))
    (check 111 (equal[nat] (cord/has "click this text" (text_at tsrc
      (app_world/get scratch sc))) 1))
    (check 112 (equal[nat] (cord/has "w-edit=" h0) 1))
    (check 113 (equal[nat] (cord/has "article src=" h0) 0))
    (check 114 (equal[nat] (cord/has
      "/frag/1/5/0x11/app/life/weft/board/4/0x11/app/life/board" h0) 1))
    (check 115 (equal[nat] (cord/has
      "/frag/1/5/0x11/app/loom/weft/page/5/0x11/app/loom/p/about" h0) 1))
    (check 116 (equal[nat] (cord/has (cord/cat_all [ "id=" 34 "pt-5"
      34]) h0) 1))
    (check 117 (equal[nat] (cord/has "badtag" h1r) 1))
    (check 118 (equal[nat] (cord/has "&lt;script&gt;boom&lt;/script&gt;"
      h1r) 1))
    (check 119 (equal[nat] (cord/has "<script>boom" h1r) 0))
  ]

+  loom_tests
  +  page
    \ _=unit
    ^ row[testing/check]
    = target=path
        ['app 'loom 'p 'home]
    = frag=path
        ['o ($u 1) ($u 5) ($x 17) 'app 'loom 'weft 'page
          ($u 5) ($x 17) 'app 'loom 'p 'home]
    = base
        | app_world/mount app "apps/loom/main" ['app 'loom]
          app_world/seed
    = checks=row[testing/check] [(app_world/okay base)]
    | checks.weld
    | (app_world/contains [ "/0x11/app/loom/p/home" "new page" ]
      (app_world/page ['app 'loom] .false base)).weld
    | (app_world/contains [ "commit source" "w-refresh"
      "/frag/1/5/0x11/app/loom/weft/page/5/0x11/app/loom/p/home" ] (app_world/page
      target .false base)).weld
    | (app_world/contains [ "w-edit=" "namespace records"
      "/frag/1/5/0x11/app/life/weft/board/4/0x11/app/life/board" ] (app_world/page
      frag .true base))
+  tests
  ^ row[testing/case]
  [(testing/case "loom behavior" behavior)
   (testing/case "HTTP page and fragment wiring" loom_tests/page)]
