' Hyp control schema, using the pinned Hyp publication prelude.
' Install at /<host>/hyp. /hyp/<alias> is a virtual recursion point.
' Type aliases retain the defining Foil moments; see publication.foil.

#import lede=sys/lede
#import req=sys/req
#import res=sys/res

config_type =
  @type
  ! foil
  hyp/config
  + read hyp/config/read
  + write hyp/config/write
  + contract hyp/config/contract

wanted_type =
  @type
  ! foil
  hyp/wanted
  + read hyp/wanted/read
  + write hyp/wanted/write
  + contract hyp/wanted/contract

instance_type =
  @type
  ! foil
  hyp/instance_ref
  + read hyp/instance_ref/read
  + write hyp/instance_ref/write
  + contract hyp/instance_ref/contract

observation_type =
  @type
  ! foil
  hyp/observation
  + read hyp/observation/read
  + write hyp/observation/write
  + contract hyp/observation/contract

query_type =
  @type
  ! foil
  hyp/query
  + read hyp/query/read
  + write hyp/query/write
  + contract hyp/query/contract

request_type =
  @type
  ! foil
  hyp/request
  + read hyp/request/read
  + write hyp/request/write
  + contract hyp/request/contract

response_type =
  @type
  ! foil
  hyp/response
  + read hyp/response/read
  + write hyp/response/write
  + contract hyp/response/contract

counter =
  @type
  ! foil
  nat
  + read
    \ raw=pail
    ^ maybe[counter]
    ?> (./some val) (pails/n/try_from_pail raw) .none
    | ./some val.n
  + write
    \ val=counter
    ^ pail
    | pails/n val
  + contract
    | curb/of_type (^ pails/n)

config =
  @slot

want =
  @slot

epoch =
  @slot

observed =
  @slot

instance =
  @slot

query =
  @slot

revision =
  @slot

generation =
  @slot

' An instance record asks for a node to exist in a desired state.
' Boot is immutable after creation. Observations are driver-owned.
' Epoch is an intent sequence, not a substitute for Shrine history.

node =
  @role
  %/config: config_type
  %/want: wanted_type
  %/epoch: counter
  #opt ;
    %/observed: observation_type

' A mount binds an alias to an existing instance, independently of
' lifecycle. Several aliases may refer to the same instance.

mount =
  @role
  %/instance: instance_type
  %/generation: counter

' Required request, optional receipt: pending means no res yet.
' The request value already captures the exact instance incarnation.

exchange =
  @role
  req: request_type
  #opt ;
    res: response_type

' A watch commits explicit bridge answers into the host namespace.
' Those answers do not turn guest commits into host ancestor changes.

watch =
  @role
  %/instance: instance_type
  %/query: query_type
  %/epoch: counter
  #opt ;
    res: response_type
    %/revision: counter

' This action only changes intent. The foot performs lifecycle work
' after commit. A repeated desired value is a no-op.

set_wanted =
  @action
  #on ; node
  %/want: wanted_type
  ! foil
  \ want=wanted_type cur=%/node
  ^ %/node
  ? (equal want cur.want)
   cur
  cur.set_want(want).set_epoch(cur.epoch.inc)

' Accept only a report answering the current lifecycle intent.
' Caller authentication belongs to the hand/driver endpoint.

report =
  @action
  #on ; node
  %/observed: observation_type
  ! foil
  \ observed=observation_type cur=%/node
  ^ %/node
  ? !(eq observed.epoch cur.epoch)
   cur
  cur.set_observed((./some observed))

' Binding a new instance invalidates cached mount resolutions.

rebind =
  @action
  #on ; mount
  %/instance: instance_type
  ! foil
  \ instance=instance_type cur=%/mount
  ^ %/mount
  ? (equal instance cur.instance)
   cur
  cur.set_instance(instance).set_generation(cur.generation.inc)

nodes =
  @norm
  #here ; '/[id=@tas]
  #with ; node

mounts =
  @norm
  #here ; '/[alias=@tas]
  #with ; mount

requests =
  @norm
  #here ; '/[id=@u]
  #with ; exchange

watches =
  @norm
  #here ; '/[name=@tas]
  #with ; watch

' Separate collections let each norm describe its complete tree.
' No sample guest is started merely by installing the control app.

"/" =
  @tree

"/instances" =
  @tree
  #like ; nodes

"/mounts" =
  @tree
  #like ; mounts

"/requests" =
  @tree
  #like ; requests

"/watches" =
  @tree
  #like ; watches
