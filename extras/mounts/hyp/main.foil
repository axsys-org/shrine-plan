- helm

' Hyp protocol. Runtime scheduling lives in runtime.foil.
' The publication prelude exposes these codecs to main.grove.
' Live capabilities belong to the foot, keyed by an instance ref.
+ hyp
  + instance_ref
    ' Stable instance identity and incarnation, not an actor handle.
    : key=nat incarnation=nat

  + config
    ' Device policy is explicit; an empty myth grants no devices.
    : self=iota system=pin[system_publication]
      initial=sov devices=myth

  + wanted
    & hyp/wanted/running
      hyp/wanted/stopped
    + running
      :
    + stopped
      :

  + phase
    & hyp/phase/starting
      hyp/phase/running
      hyp/phase/stopped
      hyp/phase/failed
    + starting
      :
    + running
      :
    + stopped
      :
    + failed
      : reason=iota

  + observation
    ' The epoch identifies the desired-state edit being answered.
    : epoch=nat instance=hyp/instance_ref phase=hyp/phase

  + query
    ' Paths and cases are interpreted in the guest context.
    : target=path care=care version=maybe[nat]

  + request
    ' Capture the instance now; alias rebinding must not retarget it.
    : instance=hyp/instance_ref command=helm/card

  + response
    & hyp/response/accepted
      hyp/response/rejected
      hyp/response/page
    + accepted
      : revision=nat
    + rejected
      : reason=iota
    + page
      : query=hyp/query value=res[axal[saga]]

  + ticket
    ' Delivery key: request path and its original x case.
    ' The driver must retain receipts before retrying guest writes.
    : path=path version=nat

  + intent
    : boot=hyp/config want=hyp/wanted epoch=nat
      observed=maybe[hyp/observation]

  + desire
    ' No-op edits do not restart or create new work.
    \ want=hyp/wanted cur=hyp/intent
    ^ hyp/intent
    ? (equal want cur.want)
     cur
    cur.set_want(want).set_epoch(cur.epoch.inc)

  + observe
    ' Ignore completion from an earlier lifecycle request.
    ' The endpoint must separately authenticate driver reports.
    \ seen=hyp/observation cur=hyp/intent
    ^ hyp/intent
    ? !(eq seen.epoch cur.epoch)
     cur
    cur.set_observed((./some seen))

  + exchange
    : request=hyp/request response=maybe[hyp/response]

  + finish
    ' A completion must match the captured request, not an alias.
    ' Duplicate completion never replaces the first receipt.
    \ sent=hyp/request done=hyp/response cur=hyp/exchange
    ^ hyp/exchange
    ? !(equal sent cur.request)
     cur
    ? cur.response
     > (./some _) cur
     > .none cur.set_response((./some done))

' Grove type modules require read, write and contract exports.
' These are codecs for exact nominal carriers, not wire decoders.
+ hyp
  + config
    + read
      \ raw=pail
      ^ maybe[hyp/config]
      | hyp/config/try_from_pail raw
    + write
      \ val=hyp/config
      ^ pail
      val
    + contract
      | curb/of_type (^ hyp/config)

+ hyp
  + instance_ref
    + read
      \ raw=pail
      ^ maybe[hyp/instance_ref]
      | hyp/instance_ref/try_from_pail raw
    + write
      \ val=hyp/instance_ref
      ^ pail
      val
    + contract
      | curb/of_type (^ hyp/instance_ref)

+ hyp
  + wanted
    + read
      \ raw=pail
      ^ maybe[hyp/wanted]
      ? raw
       > val=hyp/wanted/running (./some val)
       > val=hyp/wanted/stopped (./some val)
      .none
    + write
      \ val=hyp/wanted
      ^ pail
      ? val
       > row=hyp/wanted/running row
       > row=hyp/wanted/stopped row
    + contract
      | curb/of_type (^ hyp/wanted)

+ hyp
  + observation
    + read
      \ raw=pail
      ^ maybe[hyp/observation]
      | hyp/observation/try_from_pail raw
    + write
      \ val=hyp/observation
      ^ pail
      val
    + contract
      | curb/of_type (^ hyp/observation)

+ hyp
  + query
    + read
      \ raw=pail
      ^ maybe[hyp/query]
      | hyp/query/try_from_pail raw
    + write
      \ val=hyp/query
      ^ pail
      val
    + contract
      | curb/of_type (^ hyp/query)

+ hyp
  + request
    + read
      \ raw=pail
      ^ maybe[hyp/request]
      | hyp/request/try_from_pail raw
    + write
      \ val=hyp/request
      ^ pail
      val
    + contract
      | curb/of_type (^ hyp/request)

+ hyp
  + response
    + read
      \ raw=pail
      ^ maybe[hyp/response]
      ? raw
       > val=hyp/response/accepted (./some val)
       > val=hyp/response/rejected (./some val)
       > val=hyp/response/page (./some val)
      .none
    + write
      \ val=hyp/response
      ^ pail
      ? val
       > row=hyp/response/accepted row
       > row=hyp/response/rejected row
       > row=hyp/response/page row
    + contract
      | curb/of_type (^ hyp/response)

+ hyp
  + panic
    (@ v)
    \ why=pail fallback=v
    ^ v
    ; (error why)
    fallback
