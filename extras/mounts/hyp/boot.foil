- pact
- apps/hyp/runtime
- apps/hyp/publication

+ hyp_app
  + ports
    : compile={\ namespace grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
      publish={\ namespace row[[path myth]]}either[
        iota namespace/committed]

  + boot
    \ host=namespace source=str ports=hyp_app/ports
    ^ either[pail hyp_runtime]
    =   schema=path
     [host.self 'gov 'hyp]
    =   root=path
     [host.self 'hyp]
    =   parsed
     | grove/parse source
    ?> (./ok document) parsed
      | hyp_app/failure parsed "Invalid Hyp Grove source"
    =   adapter
     | grove_backend/ports (hyp_publication/lookup host)
       (ports.compile host)
    =   compiled
     | grove_backend/compile schema document adapter
    ?> (./ok records) compiled
      | hyp_app/failure compiled "Hyp Grove compilation failed"
    ?> (./ok committed) (ports.publish host records)
      | ./err (pails/t "Hyp publication failed")
    =   host
     committed.state
    ?> (./some version) host.case(.x schema)
      | ./err (pails/t "Hyp template absent")
    ?> (./ok installed)
        (grove_install/instantiate schema version root host)
      | ./err (pails/t "Hyp installation failed")
    | ./ok (hyp_runtime/new installed root schema)

  + foundations
    ' Standalone boot needs Pact and its two contract behaviors.
    ' Existing applications can supply their own prepared namespace.
    \ host=namespace
    ^ namespace
    =   entries=row[[iota form]]
     [['pact pact/form] ['ward ward/form] ['fresh fresh/form]]
    | entries.fold host
      \ host [name impl]
      =   dest=path
       [host.self 'kook name]
      =   card
       | form/card impl (lore/line "Hyp installation service.")
      =   [next index reply]
       | helm/supervisor/handle (helm/card/step dest (writ/make card))
         host (sovereign_hive host)
      ?> (./ack ack) reply
        | hyp/panic (pails/t "Expected foundation ack") host
      ? ack
       > .none next
       > (./some why) (hyp/panic why host)

  + write
    \ name=path record=myth run=hyp_runtime
    ^ hyp_runtime
    =   [next index reply]
     | hyp_runtime/handle (helm/card/step name (writ/make record))
       run (sovereign_hive run.host)
    ?> (./ack ack) reply
      (hyp/panic[hyp_runtime] (pails/t "Expected write ack") run)
    ? ack
     > .none next
     > (./some why) (hyp/panic[hyp_runtime] why run)

  + instance
    \ name=iota identity=iota run=hyp_runtime
    ^ hyp_runtime
    =   boot
     | hyp/config identity run.host.system sov/new myth/new
    =   record
     . (myth/new)
       put(run.slot('config) boot)
       put(run.slot('want) (hyp/wanted/running))
       put(run.slot('epoch) (pails/n 1))
    | hyp_app/write (run.root.weld(['instances name])) record run

  + reference
    \ name=iota run=hyp_runtime
    ^ hyp/instance_ref
    =   rec
     | hyp_runtime/record (run.root.weld(['instances name]))
       run.host
    ?> (./some obs)
        (rec.get(run.slot('observed)).then(hyp/observation/read))
      | hyp/panic (pails/t "Hyp guest missing")
        (hyp/instance_ref 0 0)
    obs.instance

  + demo
    ' Two guests with the same authority still have separate stores.
    \ run=hyp_runtime
    ^ hyp_runtime
    =   run
     | hyp_app/instance 'dev ($x 34) run
    =   run
     | hyp_app/instance 'other ($x 34) run
    =   ref
     | hyp_app/reference 'dev run
    =   mount
     | (myth/sing (run.slot('instance)) ref).put
       (run.slot('generation)) (pails/n 1)
    =   run
     | hyp_app/write (run.root.weld(['mounts 'dev])) mount run
    =   request
     | hyp/request ref
       (helm/card/step [($x 34) 'hello]
         (writ/make (myth/sing ['sys 'lede]
           (pails/t "Hello from the child namespace."))))
    | hyp_app/write (run.root.weld(['requests ($u 1)]))
      (myth/sing ['sys 'req] request) run

  + run
    \ initial=hyp_runtime self=nat
    ^ nat
    | helm/supervisor/run_with[hyp_runtime]
      hyp_runtime/access initial self

  + serve
    \ initial=hyp_runtime
    ^ nat
    | Spawn (hyp_app/run initial)

  + check
    ' A real actor request crosses the alias into the selected guest.
    \ run=hyp_runtime
    ^ bool
    =   ;server
     | hyp_app/serve run
    =   card
     | helm/card/peek .x .none ['hyp 'dev ($x 34) 'hello]
    ; (SendCaps server card [0])
    =   ;[reply caps]
     | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ; | CloseHandle server
    ?> (./page path value) reply .false
    ?> (./known records) value .false
    ?> (./some saga) records.fil .false
    =   lede
     | (unpin saga.myth).txt_at ['sys 'lede]
    =   other
     | run.guests.at(1).state.page .x .none [($x 34) 'hello]
    | and (equal lede "Hello from the child namespace.")
      !(?=((./known _) other))

+ hyp_app
  + failure
    \ info=any message=str
    ^ either[pail hyp_runtime]
    ; (Trace info 0)
    | ./err (pails/t message)
