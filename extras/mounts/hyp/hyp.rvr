;;;; Compile, publish and install Hyp before starting its supervisor.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))
(#bind abi (#module foil-abi))
(define (module code name)
  (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair)))
    (_2 code))))))
(define (need-ok value)
  (If (Equal "ok" (Hd value)) (_0 value)
    (error ["hyp-boot" value])))
(define (phase message value) (Seq (print message) value))
(define (boot self system resolve slot)
  (define local (phase "Hyp: compile local publication"
    (bootstrap:build-local self system resolve slot ["apps/hyp/boot"])))
  (define code (_1 local))
  (define compiled (module code "apps/hyp/boot"))
  (define prepared (backend:prepare-with code "apps/hyp/publication"))
  (define x (abi:constructor compiled ["care" "x"]))
  (define version (driver:get-perc ["namespace" "case"] compiled))
  (define (previous state path)
    (define found (version x
      (map (lambda (part) ((_0 part) (_1 part))) path) state))
    (If (And (IsApp found) (Eq 1 (Sz found))) (_0 found) 0))
  (define (compile state request)
    (define result
      (backend:compile-port prepared (previous state) request))
    (If (Equal "err" (Hd result))
      (Seq (print ["hyp-compile" result]) result) result))
  (define (publish state records)
    (backend:publish prepared records 0 0 state))
  (define ports ((abi:constructor compiled ["hyp_app" "ports"])
    compile publish))
  (define host (phase "Hyp: install foundations"
    ((driver:get-perc ["hyp_app" "foundations"] compiled) (_0 local))))
  (define run (phase "Hyp: publish and install Grove"
    (need-ok ((driver:get-perc ["hyp_app" "boot"] compiled)
      host (read-text-file "foil/apps/hyp/main.grove") ports))))
  (define demo (phase "Hyp: create guests and submit request"
    ((driver:get-perc ["hyp_app" "demo"] compiled) run)))
  [compiled demo])
(define (check self system resolve slot)
  (define ready (boot self system resolve slot))
  (define passed (phase "Hyp: actor boundary check"
    ((driver:get-perc ["hyp_app" "check"] (_0 ready)) (_1 ready))))
  (If passed (print "Hyp integration passed")
    (error "Hyp integration failed")))
(define (start self system resolve slot)
  (define ready (boot self system resolve slot))
  ((driver:get-perc ["hyp_app" "serve"] (_0 ready)) (_1 ready)))
(#export check start)
