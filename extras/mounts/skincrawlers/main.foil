- stdlib/runtime

+ skincrawlers
  + greeting
    ^ str
    "Hello from skincrawlers."

  + root
    \ self=iota
    ^ path
    [self 'app 'skincrawlers]

  + install
    ' Instantiate the Grove seed once; game writes belong to this instance.
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'skincrawlers]
    > (./some version) state.case(.x source)
      | ./err (pails/t "Skincrawlers publication missing.")
    > (./ok next)
        (grove_install/instantiate source version (skincrawlers/root state.self) state)
      | ./err (pails/t "Skincrawlers world could not be installed.")
    | ./ok next
