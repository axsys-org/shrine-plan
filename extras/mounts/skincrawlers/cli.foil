- apps/skincrawlers/main

+ terminal
  + say
    \ text=str
    ^ nat
    | Output (add (str/to_atom text) (bex (mul 8 text.len)))

  + line
    ' Read through newline, including when stdin is a pipe with many commands.
    \ ignored=nat
    ^ maybe[str]
    % text=str ""
    ^ maybe[str]
    = ;bytes | Input 1
    ? (le bytes 1) (? text.len (./some (str/trim_ascii text)) .none)
    = byte (http_foot/unbar bytes)
    ? (eq byte.at(0) 10) (./some (str/trim_ascii text))
    | _ (str/cat_all [text byte])

  + request
    ' Transfer our reply endpoint; requests run in the owning supervisor.
    \ server=nat card=helm/card
    ^ feet/task[unit]
    ; (SendCaps server card [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    reply

  + home
    ' Resolve the current sovereign instead of assuming the default node ID.
    \ server=nat
    ^ path
    = ;reply (terminal/request server
        (helm/card/snapshot 1 (\ state=namespace [200 (path_show (skincrawlers/root state.self))])))
    > (./develop request status body) reply
      | Seq[path] (error (pails/t "Missing world location reply.")) []
    > (./some home) (path_parse body)
      | Seq[path] (error (pails/t "Invalid world location.")) []
    home

  + look
    \ server=nat home=path
    ^ str
    = ;reply (terminal/request server (helm/card/peek .x .none home))
    > (./page target result) reply "World read failed."
    > (./known tree) result "World unavailable."
    > (./some version) tree.fil "World has no record."
    = record (unpin version.myth)
    > (./some held) record.get(system_vocabulary/lede) "World has no name."
    > title=pails/t held "World name is not text."
    title.t

  + rename
    \ server=nat home=path title=str
    ^ str
    = record (myth/sing system_vocabulary/lede (pails/t title))
    = ;reply (terminal/request server (helm/card/step home (writ/poke record)))
    > (./ack failure) reply "World write failed."
    ? failure
     > .none "World renamed."
     > (./some reason) "World write rejected."

  + main
    \ server=nat arguments=row[str]
    ^ nat
    = ;home (terminal/home server)
    ; (terminal/say (str/cat_all [skincrawlers/greeting (str/from_atom 10)
        "Commands: look, name TEXT, help, quit" (str/from_atom 10)]))
    % ignored=nat 0
    ^ nat
    ; (terminal/say "skin> ")
    = ;line (terminal/line 0)
    > (./some command) line 0
    ? (eq command "quit") 0
    ? (eq command "") (_ 0)
    = ;answer=str
        ? (eq command "look") (terminal/look server home)
        ? (eq command "help") "Commands: look, name TEXT, help, quit"
        ? (eq command.slice(0 5) "name ")
          | terminal/rename server home command.slice(5 (sub command.len 5))
        "Unknown command. Try help."
    ; (terminal/say (str/cat_all [answer (str/from_atom 10)]))
    | _ 0
