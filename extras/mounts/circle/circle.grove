#import lede=sys/lede
#import text=lib/grove/types/text

' A conversation each member keeps their own part of. A member writes
' their own messages and every member reads them. Whoever keeps the circle
' seats its members and reads none of it. There is no single order: each
' member has a history of their own, and nothing here orders one member's
' messages against another's. A member who is away stops nobody.

card =
  @role
  #meta ;
    lede: "Anything here that has a title"
  title: text

line =
  @role
  #meta ;
    lede: "Something said"
  said: text

members =
  @stencil
  #meta ;
    lede: "A seat for whoever takes part"
  #here ; '/members/[m=@tas]
  #with ; card
  #by ; maker
  #for ; '/members/[any]

messages =
  @stencil
  #meta ;
    lede: "What a member says: their own to write, every member's to read"
  #here ; '/members/[m=@tas]/messages/[i=@tas]
  #with ; line
  #by ; '/members/[m]
  #for ; '/members/[r]

"/" =
  @tree
  title: "A circle"

"/members" =
  @tree

"/members/first" =
  @tree
  title: "A member"
  invite: 1

"/members/second" =
  @tree
  title: "Another member"
  invite: 2
