#import date_time=lib/grove/types/time
#import date_duration=lib/grove/types/duration

date_stamp =
  @slot

date_precise =
  @slot

date_elapsed =
  @slot


dated =
  @role
  %/date_stamp: date_time
  %/date_precise: date_time
  %/date_elapsed: date_duration

dated_view =
  @view
  #on ; %/dated
  #for ; "/sys/slot/detail"
  ! goo
  card => {
    col("identity") {
      text("Dates and durations", "title")
      show(card.date_stamp, '/sys/slot/body)
      show(card.date_precise, '/sys/slot/body)
      show(card.date_elapsed, '/sys/slot/body)
    }
  }

"/dates/example" =
  @tree
  %/date_stamp: '@2026.9.30..12.0.0
  %/date_precise: '@@1969.7.21..2.56.15
  %/date_elapsed: '@h1.m30
