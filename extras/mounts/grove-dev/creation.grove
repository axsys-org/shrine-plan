#import make_text=lib/grove/types/text
#import make_path=lib/grove/types/path

creation_target =
  @slot

creator =
  @role
  %/creation_target: make_path

created_card =
  @role
  "/sys/req": make_text
  "/sys/res": make_text

"/creator" =
  @tree
  %/creation_target: (pails/p [($x 17) 'app 'demo 'created])
  "/sys/req": "This anchor value must not prefill the creation form."
