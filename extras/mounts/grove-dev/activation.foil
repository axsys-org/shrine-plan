- grove_install

+ grove_dev_mount
  + failure
    : reason=iota
  + install
    \ state=namespace
    ^ either[pail namespace]
    = source=path [state.self 'gov 'demo]
    ?> (./some version) state.case(.x source)
      | ./err (pails/t "Missing development template")
    ? (grove_install/instantiate source version
        [state.self 'app 'demo] state)
     > (./ok next) (./ok next)
     > (./err why) (./err (grove_dev_mount/failure why))
