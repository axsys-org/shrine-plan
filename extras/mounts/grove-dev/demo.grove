#import text=lib/grove/types/text
#import lede=sys/lede
#import content=sys/content

title =
  @slot

note =
  @role
  %/title: text

note_view =
  @view
  #on ; %/note
  #for ; "/sys/slot/detail"
  ! goo
  card => {
    col("identity") {
      text(card.title, "title")
      text("Edit demo.grove, then rebuild.", "body")
    }
  }

"/notes" =
  @tree
  lede: "Demo notes"

"/notes/welcome" =
  @tree
  lede: "Welcome note"
  content: "Hello from Grove"

"/notes/second" =
  @tree
  lede: "Second note"
  content: "Inspect my slots and compiled role"
