#import text=lib/grove/types/text
#import path_type=lib/grove/types/path

job_type =
  @type
  ! foil
  grove_draft/job
  + read
    \ value=pail
    ^ maybe[job_type]
    ?> job=grove_draft/job value .none
    | ./some job
  + write
    \ job=job_type
    ^ pail
    job
  + contract
    ^ curb
    | curb/of_type (^ grove_draft/job)

job =
  @slot

status_path =
  @slot

purpose =
  @slot

workspace =
  @role
  %/purpose: text

draft =
  @role
  %/job: %/job_type
  %/status_path: path_type

status =
  @role
  source: text
  revision: text
  attempted: text
  ready: text
  published: text
  message: text
  line: text

create =
  @action
  #meta ;
    "/sys/op": (namespace_op grove_authoring/create)
  #on ; %/workspace
  name: text
  source: text
  ! foil
  \ name=str source=str workspace=%/workspace
  ^ %/workspace
  | Seq[%/workspace] (error (pails/t "Requires native draft admission")) workspace

save =
  @action
  #meta ;
    "/sys/op": (namespace_op grove_authoring/save)
  #on ; %/draft
  source: text
  revision: text
  ! foil
  \ source=str revision=str draft=%/draft
  ^ %/draft
  | Seq[%/draft] (error (pails/t "Requires native draft admission")) draft

publish =
  @action
  #meta ;
    "/sys/op": (namespace_op grove_authoring/publish)
  #on ; %/draft
  revision: text
  ! foil
  \ revision=str draft=%/draft
  ^ %/draft
  | Seq[%/draft] (error (pails/t "Requires native draft admission")) draft

new_draft =
  @view
  #on ; %/workspace
  #for ; /sys/slot/content
  workspace => group(on = workspace, action = %/create, myth = { '/name = .input(""), '/source = .input("") }) {
    show(workspace.purpose, '/sys/slot/content)
    text("Unused draft name", '/sys/slot/label)
    input('/name)
    text("Grove source", '/sys/slot/label)
    input('/source, "rich-block")
    action("Create and compile draft")
  }

editor =
  @view
  #on ; %/draft
  #for ; /sys/slot/content
  draft => col {
    text("Current source and compiler status", '/sys/slot/label)
    show(draft.status_path, '/sys/slot/content)
    group(on = draft, action = %/save, myth = { '/source = .input(""), '/revision = .input("") }) {
      text("Complete Grove source", '/sys/slot/label)
      input('/source, "rich-block")
      text("Current revision", '/sys/slot/label)
      input('/revision)
      action("Save and compile draft")
    }
    group(on = draft, action = %/publish, myth = { '/revision = .input("") }) {
      text("Successfully compiled revision", '/sys/slot/label)
      input('/revision)
      action("Publish compiled revision")
    }
  }

compilation =
  @view
  #on ; %/status
  #for ; /sys/slot/content
  status => col {
    show(status.message, '/sys/slot/content)
    text("Diagnostic line", '/sys/slot/label)
    show(status.line, '/sys/slot/content)
    text("Current revision", '/sys/slot/label)
    show(status.revision, '/sys/slot/content)
    text("Attempted revision", '/sys/slot/label)
    show(status.attempted, '/sys/slot/content)
    text("Compiled revision", '/sys/slot/label)
    show(status.ready, '/sys/slot/content)
    text("Published revision", '/sys/slot/label)
    show(status.published, '/sys/slot/content)
    text("Source", '/sys/slot/label)
    show(status.source, '/sys/slot/content)
  }

"/" =
  @tree
  %/purpose: "Author a Grove app in a separate native draft. Compilation updates its preview; publication is explicit."
