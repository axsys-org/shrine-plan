- grove_authoring
- tests/namespace [at=fixture]
- testing

+ authoring_checks
  + views
    \ ignored=unit
    ^ row[testing/check]
    = ;bytes (ReadFile "grove/grove-authoring/main.grove")
      source (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
    ?> (./ok document) (grove/parse source)
      [(testing/nat "the actual source controls parse" 1 0)]
    | row/map[str testing/check] (authoring_checks/view_check document) ["new_draft" "editor" "compilation"]
  + view_check
    \ document=grove/document name=str
    ^ testing/check
    | testing/nat (str/cat_all ["Goo source control lowers: " name]) 1
        (either/is_ok (grove_views/compile [($x 17) 'gov 'grove_authoring] document
          (\ path=path .none) .nil (goo/html_types ['lib 'grove 'types]) name))
  + initial
    ^ namespace
    | namespace ($x 17) sov/new (fixture/namespace_tests/initial).system
  + apply
    \ plan=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) plan (Seq[namespace] (error (pails/t "Draft command rejected")) state)
    ?> (./ok next) (grove_install/changes writes state) (Seq[namespace] (error (pails/t "Draft writes rejected")) state)
    next
  + job
    \ target=path state=namespace
    ^ grove_draft/job
    ?> (./ok job) (grove_authoring/job target state)
      | Seq[grove_draft/job] (error (pails/t "Missing native draft job")) (grove_draft/job "" 0 0 0 0 0 "" 0)
    job
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state authoring_checks/initial
      root=path (grove_authoring/root state.self)
      target=path root.weld(['drafts 'notes])
      source=str "notes = @slot"
      input (myth/sing ['name] (pails/t "notes")).put(['source] (pails/t source))
      created (authoring_checks/apply (grove_authoring/create root input state) state)
      first (authoring_checks/job target created)
      other (authoring_checks/apply (grove_authoring/create root input.put(['name] (pails/t "tasks")) created) created)
      edit (myth/sing ['revision] (pails/t "1")).put(['source] (pails/t "tasks = @slot"))
      changed (authoring_checks/apply (grove_authoring/save target edit other) other)
      second (authoring_checks/job target changed)
      display (sovereign_care .x (row/cons[iota] 'x target.snoc('status)) changed).fil.fall(myth/new)
      history (row/all[care] (\ car=care (equal (created.page(car created.case(car target) target))
        (changed.page(car created.case(car target) target)))) [.x .y .z])
      request (myth/sing ['revision] (pails/t "2"))
      ' Controlled compiler completion: publication guards are checked here;
      ' the real compiler/preview boundary is exercised by the Eden check.
      ready_job second.set_attempted(2).set_ready(2)
      ready (authoring_checks/apply (./ok [[target (writ/poke (myth/sing (grove_authoring/job_slot state.self) ready_job))]]) changed)
      published (authoring_checks/apply (grove_authoring/publish target request ready) ready)
      queued (authoring_checks/job target published)
      newer (authoring_checks/apply (grove_authoring/save target edit.put(['revision] (pails/t "2")).put(['source] (pails/t "third = @slot")) published) published)
      third (authoring_checks/job target newer)
      registration_path (grove_authoring/registration_path state.self "notes")
      record (sovereign_peek registration_path created).fil.fall(myth/new)
    ?> registration=grove_draft/registration record.pail_at(grove_draft/slot)
      [(testing/nat "draft uses the existing native registration" 1 0)]
    | [(testing/nat "new draft starts at revision one" 1 first.revision)
       (testing/text "source is the native compiler job source" source first.source)
       (testing/nat "create never requests publication" 0 first.request)
       (testing/nat "occupied draft refuses overwrite" 1 (either/is_err (grove_authoring/create root input created)))
       (testing/nat "no nested or escaped draft names" 1 (either/is_err (grove_authoring/create root input.put(['name] (pails/t "other/nested")) state)))
       (testing/nat "caller cannot choose compiler destinations" 1 (either/is_err (grove_authoring/create root input.put(['target] (pails/p [state.self 'user])) state)))
       (testing/nat "create has a fixed receiver" 1 (either/is_err (grove_authoring/create [state.self 'user] input state)))
       (testing/nat "empty source refuses" 1 (either/is_err (grove_authoring/create root input.put(['source] (pails/t "")) state)))
       (testing/nat "native registry owns draft" 1 (equal[path] target registration.draft))
       (testing/nat "registration is directly visible to native draft reconciliation" 1
         (sovereign_care .y (grove_draft/registry state.self) created).kid_tap.len)
       (testing/nat "preview and publication are different instances" 0 (equal[path] registration.preview_target registration.public_target))
       (testing/nat "separate drafts retain independent revisions" 1 (authoring_checks/job root.weld(['drafts 'tasks]) changed).revision)
       (testing/nat "accepted source edit advances revision" 2 second.revision)
       (testing/text "status cell reads the current authoritative source" second.source display.txt_at(['source]))
       (testing/text "status cell exposes the current revision" "2" display.txt_at(['revision]))
       (testing/nat "computed status is not copied into its persistent cell" 0 (sovereign_peek target.snoc('status) changed).fil.fall(myth/new).has(['source]))
       (testing/nat "stale source edit refuses" 1 (either/is_err (grove_authoring/save target edit changed)))
       (testing/nat "outside receiver refuses" 1 (either/is_err (grove_authoring/save root edit changed)))
       (testing/nat "an unchanged source does not schedule another compile" 1 (equal[namespace] changed (authoring_checks/apply (grove_authoring/save target edit.put(['revision] (pails/t "2")) changed) changed)))
       (testing/nat "uncompiled revision cannot publish" 1 (either/is_err (grove_authoring/publish target request changed)))
       (testing/nat "old compiled revision cannot publish" 1 (either/is_err (grove_authoring/publish target request.put(['revision] (pails/t "1")) ready)))
       (testing/nat "publication requests precisely the compiled revision" 2 queued.request)
       (testing/nat "request is not falsely recorded as successful publication" 0 queued.published)
       (testing/nat "later source edit invalidates pending publication" 0 third.request)
       (testing/nat "later edit cannot publish previous preview" 1 (either/is_err (grove_authoring/publish target request.put(['revision] (pails/t "3")) newer)))
       (testing/nat "draft editing preserves retained x y z history" 1 history)]

+ tests
  ^ row[testing/case]
  [(testing/case "Native Grove source drafts and publication guards" authoring_checks/checks)
   (testing/case "Declared source controls use supported Goo bindings" authoring_checks/views)]
