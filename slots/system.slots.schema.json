{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaver system slot documentation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "slots"
  ],
  "properties": {
    "format": {
      "const": "reaver.slots/v2"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "title",
          "summary"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/sys(?:/[a-z][a-z0-9_]*)+$"
          },
          "title": {
            "type": "string",
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
          },
          "summary": {
            "type": "string",
            "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
          }
        }
      }
    }
  }
}
