#!/usr/bin/env python3
"""Two worlds on one machine, talking through their Mesa feet over UDP.

Boots world A (0x51) and world B (0x52) as two processes, each with the mcp and mesa mounts. Nothing outside
tells a world anything: Mesa makes the key of each world in a file that only the runtime reads, and this script
then writes, through each world's own door, the port its foot is to listen on and a card for the other world,
with the key that world's foot published. It checks through their doors that what A writes for B arrives in B,
under A's own names, in the store B keeps for A: a first commit, a change, an addition, a removal, what is
public, a restart of the reader and of the publisher, a change of the publisher's key, and a reader and a
publisher that are restored to an older copy of their world.

No file of a world is read. The script lists the names of the files that Mesa keeps for a world, and it copies
a stopped world's folder to restore it later.

    x/check-net [--keep] [--base-port 8451]

Exit 0 when every row passes. Run it on the build machine, never beside another heavy job.
"""
import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


class World:
    def __init__(self, node, http, mesa, home):
        self.node, self.http, self.mesa, self.home = node, http, mesa, home
        self.process = None
        self.count = 0

    def start(self, timeout):
        self.log = (self.home / 'eden.log').open('a')
        self.process = subprocess.Popen(
            [sys.executable, str(ROOT / 'x/eden'), '--node', self.node, '--port', str(self.http),
             '--world', str(self.home / 'world'), '--mount', 'mcp', '--mount', 'mesa',
             '--extras-root', str(ROOT / 'extras'), '--startup-timeout', str(timeout)],
            stdout=self.log, stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.process.poll() is not None:
                raise RuntimeError(f'{self.node} exited while starting; see {self.home}/eden.log')
            try:
                self.tool('read', path='/' + self.node + '/io/mesa', care='x')
                return
            except Exception:
                time.sleep(2)
        raise RuntimeError(f'{self.node} did not start in {timeout}s; see {self.home}/eden.log')

    def stop(self):
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(timeout=60)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
        self.process = None

    def tool(self, name, **arguments):
        self.count += 1
        body = json.dumps(dict(jsonrpc='2.0', id=self.count, method='tools/call',
                               params={'name': 'mcp/' + name, 'arguments': arguments})).encode()
        request = urllib.request.Request(f'http://127.0.0.1:{self.http}/mcp', body,
                                         {'Content-Type': 'application/json'})
        reply = json.load(urllib.request.urlopen(request, timeout=60))
        result = reply['result']
        if result.get('isError'):
            raise RuntimeError(json.dumps(result)[:400])
        return result.get('structuredContent', result)

    def write(self, *records):
        return self.tool('write', records=list(records))

    def read(self, path, care='x'):
        try:
            return self.tool('read', path=path, care=care)
        except Exception as error:
            return {'error': str(error)}


def slot_of(answer, slot):
    """A slot's value in a read's answer, as the door gives it, or None."""
    properties = answer.get('properties') or {}
    return properties.get('/' + slot, properties.get(slot))


def key_of(world, seconds=180):
    """The key a world's foot published on its own record, once it has made its seed."""
    found = []

    def there():
        value = slot_of(world.read('/' + world.node + '/io/mesa'), 'key')
        if value is None:
            return False
        found.append(int(str(value)))
        return True

    return found[-1] if until(there, seconds) else 0


def listens(port):
    """Whether something on this machine holds a UDP socket on a port, and whether something listens on TCP."""
    def held(flag):
        out = subprocess.run(['ss', '-H', flag, f'sport = :{port}'], capture_output=True, text=True).stdout
        return bool(out.strip())
    return held('-lun'), held('-ltn')


def mesa_files(world):
    """The names of the files that Mesa keeps for a world, outside the world's records."""
    folder = world.home / 'world' / 'src' / 'io' / 'mesa'
    return sorted(os.listdir(folder)) if folder.is_dir() else []


def keep_copy(world, name):
    """Copy a stopped world's folder, to restore the world to this moment later."""
    target = world.home / name
    shutil.copytree(world.home / 'world', target, symlinks=True)
    return target


def restore(world, copy):
    """Put a stopped world back to a copy. What Mesa keeps for the world is outside the world and stays."""
    live = world.home / 'world'
    kept = world.home / 'mesa-kept'
    shutil.move(str(live / 'src' / 'io' / 'mesa'), str(kept))
    shutil.rmtree(live)
    shutil.copytree(copy, live, symlinks=True)
    shutil.rmtree(live / 'src' / 'io' / 'mesa')
    shutil.move(str(kept), str(live / 'src' / 'io' / 'mesa'))


def holds(answer, slot, value):
    """Whether a read's answer holds a slot with a value. The door gives every value as text."""
    properties = answer.get('properties') or {}
    found = properties.get('/' + slot, properties.get(slot))
    return found is not None and str(found) == str(value)


def until(condition, seconds=90):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if condition():
            return True
        time.sleep(1)
    return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--keep', action='store_true', help='keep the two world directories')
    parser.add_argument('--base-port', type=int, default=8451)
    parser.add_argument('--timeout', type=int, default=1800)
    args = parser.parse_args()
    base = Path(tempfile.mkdtemp(prefix='shrine-net-'))
    ports = dict(a=(args.base_port, args.base_port + 1000), b=(args.base_port + 1, args.base_port + 1001))
    (base / 'a').mkdir()
    (base / 'b').mkdir()
    a = World('0x51', *ports['a'], base / 'a')
    b = World('0x52', *ports['b'], base / 'b')
    rows = []

    def row(name, passed, detail=''):
        rows.append(passed)
        print(('PASS  ' if passed else 'FAIL  ') + name + ('' if passed else '   ' + str(detail)[:500]), flush=True)

    try:
        a.start(args.timeout)
        b.start(args.timeout)
        keys = [key_of(a), key_of(b)]
        row('each foot makes its own seed and publishes its key on its record',
            keys[0] > 0 and keys[1] > 0 and keys[0] != keys[1], keys)
        a.write(dict(path='/0x51/io/mesa', action='poke', slots={'port': ports['a'][1]}),
                dict(path='/0x51/io/mesa/0x52', slots={'key': keys[1], 'host': '127.0.0.1', 'port': ports['b'][1]}))
        b.write(dict(path='/0x52/io/mesa', action='poke', slots={'port': ports['b'][1]}),
                dict(path='/0x52/io/mesa/0x51', slots={'key': keys[0], 'host': '127.0.0.1', 'port': ports['a'][1]}))
        row('a port and a card written through the door are taken up: the world holds them',
            holds(a.read('/0x51/io/mesa'), 'port', ports['a'][1]) and
            holds(b.read('/0x52/io/mesa/0x51'), 'port', ports['a'][1]))

        a.write(dict(path='/0x51/our/0x52', slots={'title': 'for b'}),
                dict(path='/0x51/our/0x52/doc', slots={'value': 10}),
                dict(path='/0x51/our/0x52/a/b', slots={'value': 20}),
                dict(path='/0x51/our/public', slots={'title': 'public'}),
                dict(path='/0x51/our/public/note', slots={'value': 40}))
        row('a first commit arrives', until(lambda: holds(b.read('/0x51/our/0x52/doc'), 'value', 10)),
            b.read('/0x51/our/0x52/doc'))
        row('with its deep name', holds(b.read('/0x51/our/0x52/a/b'), 'value', 20), b.read('/0x51/our/0x52/a/b'))
        row('and what is public', until(lambda: holds(b.read('/0x51/our/public/note'), 'value', 40)),
            b.read('/0x51/our/public/note'))
        stand = b.read('/0x52/io/mesa/0x51/stand')
        row('the reader keeps where the root stands, beside the card and not on it', 'head' in json.dumps(stand), stand)

        a.write(dict(path='/0x51/our/0x52/doc', action='poke', slots={'value': 11}),
                dict(path='/0x51/our/0x52/c', slots={'value': 30}),
                dict(path='/0x51/our/0x52/a/b', action='cull'))
        row('a change arrives', until(lambda: holds(b.read('/0x51/our/0x52/doc'), 'value', 11)),
            b.read('/0x51/our/0x52/doc'))
        row('an addition arrives', holds(b.read('/0x51/our/0x52/c'), 'value', 30), b.read('/0x51/our/0x52/c'))
        row('a removal arrives', not holds(b.read('/0x51/our/0x52/a/b'), 'value', 20), b.read('/0x51/our/0x52/a/b'))

        b.write(dict(path='/0x52/our/0x51', slots={'title': 'for a'}),
                dict(path='/0x52/our/0x51/reply', slots={'value': 77}))
        row('the other direction works too', until(lambda: holds(a.read('/0x52/our/0x51/reply'), 'value', 77)),
            a.read('/0x52/our/0x51/reply'))

        b.stop()
        a.write(dict(path='/0x51/our/0x52/doc', action='poke', slots={'value': 12}))
        time.sleep(5)
        row('the publisher survives a peer that is down', holds(a.read('/0x51/our/0x52/doc'), 'value', 12),
            a.read('/0x51/our/0x52/doc'))
        b.start(args.timeout)
        row('a reader that was away catches up when it returns',
            until(lambda: holds(b.read('/0x51/our/0x52/doc'), 'value', 12), 180), b.read('/0x51/our/0x52/doc'))

        udp_a, tcp_a = listens(ports['a'][1])
        udp_b, tcp_b = listens(ports['b'][1])
        row('each foot holds one UDP socket and no TCP listener', udp_a and udp_b and not tcp_a and not tcp_b,
            dict(a=(udp_a, tcp_a), b=(udp_b, tcp_b)))
        row('Mesa keeps the key, its manifest and the authority beside the world, with the mark',
            mesa_files(a) == ['mark', 'ring', 'ring.authority', 'ring.manifest'], mesa_files(a))

        def said(doc):
            return a.write(dict(path='/0x51/our/0x52/doc', action='poke', slots={'value': doc}))

        def got(doc, seconds=120):
            return until(lambda: holds(b.read('/0x51/our/0x52/doc'), 'value', doc), seconds)

        a.stop()
        old_a = keep_copy(a, 'before-key-change')
        a.start(args.timeout)
        said(13)
        row('a publisher that restarts goes on under its name', got(13, 180), b.read('/0x51/our/0x52/doc'))

        b.stop()
        old_b = keep_copy(b, 'before-key-change')
        b.start(args.timeout)

        # A changes its key. Mesa makes the new key; the foot retires the old one.
        a.write(dict(path='/0x51/io/mesa', action='poke', slots={'life': 2}))
        changed = []

        def turned():
            value = slot_of(a.read('/0x51/io/mesa'), 'key')
            if value is None or int(str(value)) == keys[0]:
                return False
            changed.append(int(str(value)))
            return True

        row('a world changes its key when its record names a later life', until(turned, 120), a.read('/0x51/io/mesa'))
        new_key = changed[-1] if changed else 0
        row('the file of the old key is gone, and the new key has a file of its own',
            until(lambda: mesa_files(a) == ['mark', 'ring.2', 'ring.authority', 'ring.manifest'], 60), mesa_files(a))
        said(14)
        time.sleep(20)
        row('a reader that still holds the old key lands nothing that the new key signed',
            holds(b.read('/0x51/our/0x52/doc'), 'value', 13), b.read('/0x51/our/0x52/doc'))
        new_card = {'key': new_key, 'life': 2, 'host': '127.0.0.1', 'port': ports['a'][1]}
        old_card = {'key': keys[0], 'life': 1, 'host': '127.0.0.1', 'port': ports['a'][1]}
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots=new_card))
        row('told the new key, the reader goes on under the same name', got(14), b.read('/0x51/our/0x52/doc'))

        # An old card does not bring the old key back.
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots=old_card))
        row('Mesa does not accept the old key again, and the reason is a record beside the card',
            until(lambda: holds(b.read('/0x52/io/mesa/0x51/stand'), 'barred', keys[0]), 60),
            b.read('/0x52/io/mesa/0x51/stand'))
        said(15)
        time.sleep(20)
        row('while the card names a key that Mesa does not accept, the reader lands nothing from that world',
            holds(b.read('/0x51/our/0x52/doc'), 'value', 14), b.read('/0x51/our/0x52/doc'))
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots=new_card))
        row('with the accepted key on the card again, the reader catches up', got(15), b.read('/0x51/our/0x52/doc'))

        # The reader is restored to a copy from before the change: its card names the old key again.
        b.stop()
        restore(b, old_b)
        b.start(args.timeout)
        row('a restored reader does not get the old key back: Mesa keeps what it accepted outside the world',
            until(lambda: holds(b.read('/0x52/io/mesa/0x51/stand'), 'barred', keys[0]), 120),
            b.read('/0x52/io/mesa/0x51/stand'))
        said(16)
        time.sleep(20)
        row('and it lands nothing from that world', not holds(b.read('/0x51/our/0x52/doc'), 'value', 16),
            b.read('/0x51/our/0x52/doc'))
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots=new_card))
        row('it opens again when the new card is written', got(16, 180), b.read('/0x51/our/0x52/doc'))

        def stands():
            value = slot_of(b.read('/0x52/io/mesa/0x51/stand'), 'head')
            return int(str(value)) if value is not None else 0

        before_restore = stands()

        # The publisher is restored to a copy from before its own change: its record names life 1 again.
        a.stop()
        restore(a, old_a)
        a.start(args.timeout)
        row('a restored publisher does not go back to its old key: its record shows the key that Mesa holds',
            until(lambda: holds(a.read('/0x51/io/mesa'), 'key', new_key) and holds(a.read('/0x51/io/mesa'), 'life', 2),
                  120), a.read('/0x51/io/mesa'))
        said(17)
        row('and what it writes still lands in the reader, under the same name', got(17, 180),
            b.read('/0x51/our/0x52/doc'))
        after_restore = stands()
        row('the restored publisher uses no version a second time: its versions are of a later continuity',
            after_restore > before_restore and (after_restore >> 32) == (before_restore >> 32) + 1,
            dict(before=before_restore, after=after_restore))

        # The reader takes the key off the card: Mesa blocks the publisher.
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots={'key': 0}))
        time.sleep(5)
        said(18)
        time.sleep(20)
        row('a peer whose card has no key is blocked: the reader lands nothing from it',
            holds(b.read('/0x51/our/0x52/doc'), 'value', 17), b.read('/0x51/our/0x52/doc'))
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke', slots=new_card))
        row('the same card again does not lift the block, and the reason is a record',
            until(lambda: holds(b.read('/0x52/io/mesa/0x51/stand'), 'cause', 'Blocked'), 60),
            b.read('/0x52/io/mesa/0x51/stand'))
        time.sleep(15)
        row('and the reader still lands nothing', holds(b.read('/0x51/our/0x52/doc'), 'value', 17),
            b.read('/0x51/our/0x52/doc'))

        # The publisher changes its key a second time; a card with that later life lifts the block.
        a.write(dict(path='/0x51/io/mesa', action='poke', slots={'life': 3}))
        third = []

        def turned_again():
            value = slot_of(a.read('/0x51/io/mesa'), 'key')
            if value is None or int(str(value)) in (keys[0], new_key):
                return False
            third.append(int(str(value)))
            return True

        row('the publisher changes its key a second time', until(turned_again, 120), a.read('/0x51/io/mesa'))
        row('and keeps one key file', until(lambda: mesa_files(a) == ['mark', 'ring.3', 'ring.authority', 'ring.manifest'], 60),
            mesa_files(a))
        b.write(dict(path='/0x52/io/mesa/0x51', action='poke',
                     slots={'key': third[-1] if third else 0, 'life': 3, 'host': '127.0.0.1', 'port': ports['a'][1]}))
        row('a card with the later life lifts the block, and the reader catches up', got(18, 180),
            b.read('/0x51/our/0x52/doc'))
        udp_a, tcp_a = listens(ports['a'][1])
        udp_b, tcp_b = listens(ports['b'][1])
        row('after all of it each foot still holds one UDP socket and no TCP listener',
            udp_a and udp_b and not tcp_a and not tcp_b, dict(a=(udp_a, tcp_a), b=(udp_b, tcp_b)))
    except Exception as error:
        row('the run completed', False, repr(error))
    finally:
        a.stop()
        b.stop()
        if args.keep or not all(rows):
            print(f'worlds kept at {base}', flush=True)
        else:
            subprocess.run(['rm', '-rf', str(base)])
    print(f'{sum(rows)} of {len(rows)} rows passed', flush=True)
    return 0 if rows and all(rows) else 1


if __name__ == '__main__':
    sys.exit(main())
