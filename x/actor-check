#!/usr/bin/env python3
"""Fresh-boot actor probe: x/actor-check [path/to/wisp]."""
import pathlib
import re
import subprocess
import sys
import tempfile

root = pathlib.Path(__file__).resolve().parent.parent
binary = pathlib.Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else root / 'wisp'
directory = pathlib.Path(tempfile.mkdtemp(prefix='actor-check-'))
print(f'Runtime: {binary}\nLogs: {directory}', flush=True)
for phase, args, source in [
    ('boot', [str(root / 'src/plan'), 'reaver', 'main'], ''),
    ('probe', ['snap', 'root', '_'], (root / 'src/reaver/actor-smoke-tests.rvr').read_text()),
]:
    path = directory / (phase + '.log')
    with path.open('w') as out:
        try:
            result = subprocess.run([str(binary), '--file-root', str(root / 'src'), *args],
                                    input=source, text=True, cwd=directory,
                                    stdout=out, stderr=out, timeout=60)
        except subprocess.TimeoutExpired:
            raise SystemExit(f'{phase}: timed out; see {path}')
    log = path.read_text(errors='replace')
    if result.returncode or re.search(r'^\("ERROR"', log, re.M):
        print(log[-1800:])
        raise SystemExit(f'{phase}: failed (process status {result.returncode})')
    if phase == 'probe' and '"actor smoke tests passed"' not in log:
        raise SystemExit(f'probe: missing completion marker; see {path}')
print('Fresh-boot actor transport passed.')
