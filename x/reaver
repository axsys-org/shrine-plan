#!/usr/bin/env bash
# If you have already started a Reaver session, this will resume from
# snapshot.
#
# Otherwise, it will build reaver, load the standard library, exit,
# and then *then* resume from the new snapshot created through this.

set -ex
WISP="${WISP:-wisp}"

case "${1-}" in
  ''|--reset) ;;
  *) echo "Unknown argument: $1" >&2; exit 1 ;;
esac

hsbuild () {
	cabal build
}


reset () {
	"$WISP" --file-root ./src ./src/plan reaver main
}

repl () {
	"$WISP" --file-root src/ snap root _ # run from snapshot
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}


# hsbuild

if [[ ! -e snap/arena.dat && ( -e snap/data.mdb || -e snap/pins.pack ) ]]; then
  echo 'x/reaver: this Wisp requires native snapshots. Move the old snap/ directory aside, then rerun x/reaver to boot a fresh arena.' >&2
  exit 1
fi

if [[ "${1-}" == "--reset" || ! -e snap/arena.dat ]]
then reset; load_stdlib
fi

repl
