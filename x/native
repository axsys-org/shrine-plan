#!/usr/bin/env python3
"""Call the local native construction/action boundary without a browser model.

This client only transports a request. Types, compilation, correspondence,
installation and mutation are handled by the native owner.
"""
import argparse
import json
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--world', type=Path, required=True)
p.add_argument('--port', type=int, required=True)
p.add_argument('--source-file', type=Path)
p.add_argument('--event')
p.add_argument('operation')
p.add_argument('body', help='JSON object, or @path to a JSON request file')
a = p.parse_args()
body = json.loads(Path(a.body[1:]).read_text() if a.body.startswith('@') else a.body)
if a.source_file:
    body['source'] = a.source_file.read_text()
authority = (a.world / 'src/medium-authority').read_text()
encoded = urllib.parse.urlencode(dict(credential=authority, principal='administrator',
    operation=a.operation, expected='0', event=a.event or uuid.uuid4().hex,
    body=json.dumps(body))).encode()
try:
    with urllib.request.urlopen(f'http://127.0.0.1:{a.port}/medium-native', encoded, timeout=240) as response:
        print(json.dumps(json.loads(response.read()), indent=2))
except urllib.error.HTTPError as error:
    print(error.read().decode(), file=sys.stderr)
    raise SystemExit(1)
