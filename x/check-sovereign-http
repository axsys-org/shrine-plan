#!/usr/bin/env python3
"""Exercise sovereign Eden over HTTP with deterministic fixture identity 0x11."""
import argparse
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--port', type=int, default=18135)
parser.add_argument('--startup-timeout', type=int, default=1200,
                    help='Seconds allowed for compilation and listener startup (default: 1200)')
parser.add_argument('--request-timeout', type=int, default=120,
                    help='Seconds allowed per socket check request (default: 120)')
args = parser.parse_args()
if args.startup_timeout <= 0:
    parser.error('--startup-timeout must be positive')
if args.request_timeout <= 0:
    parser.error('--request-timeout must be positive')
if not 1 <= args.port <= 65535:
    parser.error('--port must be between 1 and 65535')
# The namespace browser belongs to the Explorer mount; Eden itself only
# boots the namespace and services. Use the launcher so its source publication
# and mount preparation follow the same path as a normal local boot.
raise SystemExit(subprocess.call([
    sys.executable, str(root / 'x/eden'), '--node', '0x11',
    '--mount', 'explorer', '--check', '--compiler', 'none',
    '--port', str(args.port), '--startup-timeout', str(args.startup_timeout),
    '--request-timeout', str(args.request_timeout),
]))
