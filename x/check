# The parallel test gate over ONE shared build cache.
#
#   x/check          # full gate (includes helm-tests, the long pole)
#   x/check --fast   # skip helm-tests
#   x/check --fresh  # discard the cached template first
#
# The template snapshot stages boot + stdlib + the WHOLE compiled test
# corpus (foil-stage compiles everything on disk and lands it in a
# shrine namespace whose /boot mirror carries each module's cache row
# as a pin), keyed by a hash of src/ — so the world compiles once per
# source state and every suite group (and every later x/check on
# unchanged sources) starts with it already built.  Suites hydrate
# their subjects from the staged namespace (stage:cache/sut-of), so a
# warm template makes their compiles hits.
#
# Groups then run as parallel PROCESSES on snapshot copies: each gets
# its own canon arena and Save (one group aborting cannot corrupt
# another), and a fresh template per source state sidesteps the module
# cache's dep-blindness.  Verdicts grep each log for ERROR — exit
# codes lie (memory: pristine-snapshot-capture).

set -e

FAST=""; FRESH=""
for a in "$@"; do
  case "$a" in
    --fast) FAST=1 ;;
    --fresh) FRESH=1 ;;
  esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WISP="$(command -v wisp || echo "$ROOT/wisp")"
if [ ! -x "$WISP" ]; then
  echo "x/check: no wisp on PATH and no $ROOT/wisp" >&2
  exit 2
fi
DIR="$ROOT/.check"
mkdir -p "$DIR"

HASH="$(find "$ROOT/src" -type f \( -name '*.rvr' -o -name '*.foil' -o -name '*.plan' \) -print0 \
  | xargs -0 shasum | sort | shasum | cut -c1-16)"
TPL="$DIR/template-$HASH"

if [ -n "$FRESH" ]; then rm -rf "$DIR"/template-*; fi

if [ ! -e "$TPL/data.mdb" ]; then
  # Incremental restage: seed from the newest existing template — the
  # module cache is dep-stamped (transitive .rvr stamps + foil-stage's
  # declared .foil stamps), so the stage session recompiles
  # only what actually changed.  The seed is only valid if src/plan is
  # unchanged: the boot bakes the plan-layer (loader included) into
  # the snapshot's repl continuation, and no amount of module-cache
  # hygiene refreshes THAT.  No valid seed (or --fresh): full boot.
  PLANHASH="$(find "$ROOT/src/plan" -type f -print0 | xargs -0 shasum | sort | shasum | cut -c1-16)"
  SEED="$(ls -td "$DIR"/template-* 2>/dev/null | head -1)"
  if [ -n "$SEED" ] && [ "$(cat "$SEED/planhash" 2>/dev/null)" != "$PLANHASH" ]; then
    SEED=""
  fi
  rm -rf "$DIR/stage"
  mkdir -p "$DIR/stage"
  cd "$DIR/stage"
  if [ -n "$SEED" ] && [ -e "$SEED/data.mdb" ]; then
    echo "x/check: staging template $HASH (incremental, from $(basename "$SEED"))" >&2
    mkdir -p snap
    cp "$SEED/data.mdb" "$SEED/pins.pack" snap/
  else
    echo "x/check: staging template $HASH (boot + stdlib + corpus)" >&2
    "$WISP" --file-root "$ROOT/src" "$ROOT/src/plan" reaver main > boot.log 2>&1
    "$WISP" --file-root "$ROOT/src" snap root _ > stage1.log 2>&1 <<'EOF'
(#bind std (#module std))
(#import std)
::*rex
EOF
    "$WISP" --file-root "$ROOT/src" snap root _ > stage2.log 2>&1 <<'EOF'
(#bind quip (#module quip))
EOF
  fi
  "$WISP" --file-root "$ROOT/src" snap root _ > stage3.log 2>&1 <<'EOF'
(#bind stage (#module foil-stage))
EOF
  if grep -aq 'ERROR' stage3.log \
     || grep -aq 'Assertion .* failed\|arena exhausted\|deadlock' stage3.log; then
    echo "x/check: stage FAILED (see $DIR/stage/stage3.log)" >&2
    exit 1
  fi
  mkdir -p "$TPL"
  cp snap/data.mdb snap/pins.pack "$TPL/"
  echo "$PLANHASH" > "$TPL/planhash"
  ls -td "$DIR"/template-* | tail -n +3 | xargs rm -rf 2>/dev/null || true
fi

# group <name> <suite> [<suite>...]
group () {
  name="$1"; shift
  gdir="$DIR/g-$name"
  rm -rf "$gdir"
  mkdir -p "$gdir/snap"
  cp "$TPL/data.mdb" "$TPL/pins.pack" "$gdir/snap/"
  {
    for s in "$@"; do echo "(#bind $s (#module $s))"; done
  } > "$gdir/input"
  ( cd "$gdir" && "$WISP" --file-root "$ROOT/src" snap root _ < input > out.log 2>&1
    # ERROR lines are failures, but so is a crashed session: an abort
    # (canon arena, assert) leaves a log with no ERROR in it — grep
    # alone reads that as green (memory: pristine-snapshot-capture)
    if grep -aq 'ERROR' out.log \
       || grep -aq 'Assertion .* failed\|arena exhausted' out.log; then
      echo "FAIL" > verdict
    else echo "ok" > verdict; fi ) &
}

group core foil-sast-tests foil-new-types-tests foil-new-elab-tests \
  foil-types-tests foil-subject-tests typed-reaver-tests \
  foil-env-tests foil-relocate-tests foil-provenance-tests \
  foil-env-integration-tests foil-integration-tests
group exec foil-exec-tests foil-bst-tests
group corpus foil-sept-tests foil-shrine-tests foil-weft-tests foil-tyshow-tests foil-json-tests foil-schemagen-tests foil-semidoc-tests
group lain foil-lain-tests foil-life-tests
group helmapp foil-helm-tests helm-http-tests
if [ -z "$FAST" ]; then
  group helmrt helm-tests
fi

wait

fail=0
for g in "$DIR"/g-*; do
  v="$(cat "$g/verdict" 2>/dev/null || echo FAIL)"
  printf '%-10s %s\n' "$(basename "$g" | sed 's/^g-//')" "$v"
  [ "$v" = "ok" ] || fail=1
done
exit $fail
