# The namespace REPL: boots the full lain stack (mirror, apps, chore +
# doctest drivers, the explorer on a real HTTP port), then takes the
# terminal.  Wire your editor's save hook to the poke port for
# resync-on-save.
#
#   x/repl [http-port] [poke-port]

set -e

HTTP_PORT="${1:-8090}"
POKE_PORT="${2:-8678}"

reset () {
	wisp --file-root ./src ./src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _
}

load_stdlib () {
    repl <<EOS
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOS
}

load_quip () {
    repl <<EOS
(#bind quip (#module quip))
EOS
}

if [ ! -e snap/data.mdb ]
then reset; load_stdlib; load_quip
fi

# fetch?=0: the local runtime lacks the Fetch primop, so the outbound
# fetch driver stays unregistered
{
  cat <<EOS
(#bind helm-repl (#module helm-repl))
(helm-repl:run-repl $HTTP_PORT $POKE_PORT 0)
EOS
  cat
} | repl
