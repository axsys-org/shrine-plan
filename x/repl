# The namespace REPL: boots the full lain stack (mirror, apps, chore +
# doctest drivers, the explorer on a real HTTP port), then takes the
# terminal.  Wire your editor's save hook to the poke port for
# resync-on-save, or point foil-nvim (editor/foil-nvim) at the wire
# port for the full editor protocol (doc/buddy-wire.md).
#
#   x/repl [http-port] [poke-port] [wire-port]

set -e

HTTP_PORT="${1:-8090}"
POKE_PORT="${2:-8678}"
WIRE_PORT="${3:-8679}"

ROOT="$(pwd)"
WISP="$(command -v wisp || echo "$ROOT/wisp")"

# The staging recipe lives in x/stage-lib (no --p2 here: the serve
# form below installs the compiler itself, per-form-Save law).
. "$ROOT/x/stage-lib"

repl () {
	"$WISP" --file-root src/ snap root _
}

if [ ! -e snap/data.mdb ]
then stage_repl "$WISP" "$ROOT" --app-todo
fi

# fetch?=0: the local runtime lacks the Fetch primop, so the outbound
# fetch driver stays unregistered.
# The optimizing compiler installs as its OWN top-level form: the repl
# saves per form, and Install needs the plangrm pin in the store
# ("compiler PIN must be saved first" aborts the process otherwise —
# the x/lain load_stdlib discipline).
{
  cat <<EOS
(#bind opt (#module plangrm))
(Install opt:compileP2)
(#bind helm-run (#module helm-run))
(helm-run:run-repl $HTTP_PORT $POKE_PORT $WIRE_PORT 0)
EOS
  cat
} | repl
