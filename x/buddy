# The compile buddy — a resident compiler/repl/test-harness for a
# terminal next to your editor. See doc/buddy.md.
#
#   x/buddy          # poke port 8678
#   x/buddy 9001     # custom poke port
#
# Wire :w in vim to the poke port and saves resync automatically:
#   autocmd BufWritePost *.foil silent! call system('nc -w1 localhost 8678 < /dev/null &')

set -e

PORT="${1:-8678}"

reset () {
	wisp --file-root ./src ./src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}

load_quip () {
    repl <<EOF
(#bind quip (#module quip))
EOF
}

if [ ! -e snap/root.plan ]
then reset; load_stdlib; load_quip
fi

# Boot forms first, then hand the terminal's stdin through: the buddy's
# stdin pump owns the byte stream once run-buddy is entered.
{ printf '(#bind buddy (#module buddy))\n(buddy:run-buddy %s)\n' "${PORT}"; cat; } | repl
