# The forge on the command line.
#
#   x/forge-cli mods
#   x/forge-cli ls bst
#   x/forge-cli show bst bst.size
#   x/forge-cli refs bst bst.insert
#   x/forge-cli doctest bst
#   x/forge-cli eval bst '(bst/got[nat] 2 0 (bst/duo[nat] 1 10 2 20))'
#
# Exit code 1 when a doctest fails, an eval errors, or a module does
# not compile — greppable/CI-friendly.

set -e

FRESH=""
if [ "${1:-}" = "--fresh" ]; then
  FRESH="--fresh"
  shift
fi


reset () {
	wisp --file-root ./src ./src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _
}

load_stdlib () {
    repl <<EOF >/dev/null 2>&1
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}

load_quip () {
    repl <<EOF >/dev/null 2>&1
(#bind quip (#module quip))
EOF
}

if [ ! -e snap/root.plan ]
then reset >/dev/null 2>&1; load_stdlib; load_quip
fi

x/foil-cache ${FRESH} bst demo mapx mapuser >/dev/null

out=$(repl 2>/dev/null <<EOF
(#bind forge-cli (#module forge-cli))
(forge-cli:main-artifact-cached ["${1-}" "${2-}" "${3-}"] _foil_artifact_cache_v1)
EOF
)

printf '%s\n' "$out" | awk '/^--FORGE--$/{f=!f;next} f'

if printf '%s' "$out" | grep -q 'forge-cli-failed'; then exit 1; fi
