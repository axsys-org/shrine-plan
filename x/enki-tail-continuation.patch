--- a/pkg/plan/src/eval.c
+++ b/pkg/plan/src/eval.c
@@ -1207,7 +1207,11 @@
 
 tail_fallback:
   /* Build the thunk after all (fuel boundary or mis-hint) and take
-   * x_ret's exit: the eval: safepoint owns any yield from here. */
+   * x_ret's exit: the eval: safepoint owns any yield from here.
+   * This continuation is fresh and never escapes to another consumer.
+   * Updating it would retain every paused tail call until the outer loop
+   * returns, including old request/state graphs in long-lived actors. */
+  rawbane |= PL_BAN_NOUPD;
   pl_gc_reserve(t, bane == PL_BAN_PRIM_KNOWN ? PL_THKE_CELLS(argc + 1)
                                              : PL_THKE_CELLS(argc));
   PL_GC_FORBID(t);
--- a/tests/unit/test_plan_eval.c
+++ b/tests/unit/test_plan_eval.c
@@ -346,10 +346,14 @@
   pl_thread_start(t, thke);
   for (int i = 0; i < 200; i++)
     ASSERT_EQ(pl_thread_run(t, 10000), PL_RUN_YIELDED);
-  /* ~2M tail calls: frames grow only at fuel checkpoints (one F_UPD
-   * per quantum survives until the loop would return), never per call */
+  /* Fuel checkpoints must not retain unaliased tail continuations until
+   * this (possibly infinite) loop returns. Coalesced update roots count,
+   * even when the ordinary frame stack stays shallow. */
   ASSERT_EQ(t->fcap, fcap0);
-  ASSERT(t->fsp <= t->base_fsp + 220);
+  ASSERT(t->fsp <= t->base_fsp + 3);
+  ASSERT_EQ(t->usp, 0);
+  pl_gc_collect_now(t);
+  ASSERT_LT(pl_gc_live_cells(t->heap), 128);
   pl_pin_set_code(pp, NULL); /* the code is a stack-lifetime fake */
   test_rt_free(&rt);
 }
