#!/usr/bin/env python3
"""Cut an OpenAPI document down to the closure of named operations.

    x/trim-spec <spec.json> <operationId> [<operationId>...] > slice.json

schemagen's own sg-slice does this in rvr, but only AFTER the document
is parsed -- and json.foil's parser consumes a cord by dividing the
whole string once per byte, so parsing is quadratic and a full 1.7MB
vendor spec is out of reach (32KB ~ 2.5s, 64KB ~ 8.4s, 128KB ~ 54s).
The fixtures under src/spec are therefore slices, cut with this.

Operation ids are the SOURCE spelling (getModels), not the normalized
one.  Only the 200 response is kept: error bodies pull in a much
larger closure and nothing generates them yet.

Delete this tool once the parser scans an indexed byte row.
"""
import json
import sys

METHODS = ("get", "put", "post", "delete", "patch", "head", "options")


def refs(node, acc):
    """Every $ref target named anywhere under node."""
    if isinstance(node, list):
        for x in node:
            refs(x, acc)
        return
    if not isinstance(node, dict):
        return
    if "$ref" in node:
        acc.add(node["$ref"].rsplit("/", 1)[1])
    for key, val in node.items():
        if key in ("properties", "patternProperties") and isinstance(val, dict):
            for sub in val.values():
                refs(sub, acc)
        elif key in ("oneOf", "anyOf", "allOf", "prefixItems"):
            refs(val, acc)
        elif key in ("items", "additionalProperties", "not") and isinstance(val, dict):
            refs(val, acc)


def closure(schemas, seed):
    graph = {}
    for name, schema in schemas.items():
        acc = set()
        refs(schema, acc)
        graph[name] = acc
    seen, stack = set(), list(seed)
    while stack:
        name = stack.pop()
        if name in seen or name not in schemas:
            continue
        seen.add(name)
        stack.extend(graph[name])
    return seen


def trim(doc, opids):
    schemas = doc["components"]["schemas"]
    kept_paths, seed = {}, set()
    for path, item in doc["paths"].items():
        entry = {}
        for method, op in item.items():
            if method not in METHODS or op.get("operationId") not in opids:
                continue
            responses = op.get("responses") or {}
            op = dict(op)
            op["responses"] = {"200": responses["200"]} if "200" in responses else {}
            entry[method] = op
            for media in ((op.get("requestBody") or {}).get("content") or {}).values():
                refs(media.get("schema", {}), seed)
            for media in ((op["responses"].get("200") or {}).get("content") or {}).values():
                refs(media.get("schema", {}), seed)
        if entry:
            kept_paths[path] = entry
    if not kept_paths:
        sys.exit("x/trim-spec: no operation matched %s" % sorted(opids))
    names = closure(schemas, seed)
    return {
        "openapi": doc["openapi"],
        "info": doc["info"],
        "servers": doc.get("servers", []),
        "paths": kept_paths,
        "components": {"schemas": {n: schemas[n] for n in sorted(names)}},
    }


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    with open(sys.argv[1]) as fh:
        doc = json.load(fh)
    print(json.dumps(trim(doc, set(sys.argv[2:])), separators=(",", ":"),
                     sort_keys=True))


if __name__ == "__main__":
    main()
