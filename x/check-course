#!/usr/bin/env python3
"""A course made from a template, joined by invitation, and lived by its table: three world processes.

0x61 starts with the course mount. Its activation makes a course from the Grove template, writes the course's
table from the template's norms, and tells the scope foot the course is its to keep. The template's chair and
first seat each hold an invitation's number, so their invitations are minted with nothing asked of anyone.
Two worlds are then prepared and claimed, one for each: they are the chair and the seat because the places
refer to them, and for no other reason. From there the table does everything: the chair's assignment reaches
the seat, the seat's work reaches the chair, the mark reaches the seat, and the maker is sent none of it.

Each invitation's link is given by the maker's door to its owner and handed over at the new world's door,
and the joining world's part in the course is written by its own foot once its claim is made. Played by
this script, and so not counted toward the finish line: the host (it starts each prepared world under its
name's founding and tells it where it is reached).

    x/check-course [--keep] [--base-port 8481]

Exit 0 when every row passes. Run it on the build machine, never beside another heavy job.
"""
import argparse
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from net_worlds import World, number_of, prepared, until  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--keep', action='store_true', help='keep the world directories')
    parser.add_argument('--base-port', type=int, default=8481)
    parser.add_argument('--timeout', type=int, default=1800)
    args = parser.parse_args()
    base = Path(tempfile.mkdtemp(prefix='shrine-course-'))
    maker = World('0x61', args.base_port, args.base_port + 1000, base / 'maker',
                  mounts=('mcp', 'mesa', 'scope', 'codecs', 'course'))
    worlds = [maker]
    rows = []
    course = '/0x61/app/course'

    def row(name, passed, detail=''):
        rows.append(passed)
        print(('PASS  ' if passed else 'FAIL  ') + name + ('' if passed else '   ' + str(detail)[:600]), flush=True)

    def side(world):
        """Where a joined world keeps what it writes of the course: beneath mine, under the maker and where
        the course sits there. Its foot chose it when it took its part."""
        return '/' + world.node + '/mine/0x61/app/course'

    def held(world, writer, rel):
        return '/' + world.node + '/her/' + writer.node + '/0x61/app/course' + rel

    try:
        maker.start(args.timeout)
        until(lambda: maker.number('/0x61/io/mesa', 'key') > 0, 180)
        maker.write(dict(path='/0x61/io/mesa', action='poke', slots={'host': '127.0.0.1', 'port': maker.mesa}))
        row('the course is made from its template when the world first starts',
            until(lambda: 'gov/course' in str(maker.slots(course).get('sys/grove/source'))
                  and maker.there(course + '/seats/first'), 120),
            maker.read(course))
        row("its table is written beneath it, read off the template's norms: five, the top and the table's own",
            until(lambda: maker.there(course + '/table/7'), 120) and not maker.there(course + '/table/8'),
            maker.read(course + '/table', care='y'))
        row("the work's row says what the template's author wrote: the seat writes it, the chair reads it",
            any(maker.text(f'{course}/table/{n}', 'path') == 'assignments/[a]/work/[s]'
                and maker.text(f'{course}/table/{n}', 'by') == 'seats/[s]'
                and maker.text(f'{course}/table/{n}', 'for') == 'chair' for n in range(1, 8)),
            [maker.slots(f'{course}/table/{n}') for n in range(1, 8)])

        chair = prepared(maker, course + '/chair', 1, args.base_port + 1, args.base_port + 1001,
                         base / 'chair', args.timeout)
        worlds.append(chair)
        row('the chair is filled by the world that claimed its invitation', True)
        seat = prepared(maker, course + '/seats/first', 2, args.base_port + 2, args.base_port + 1002,
                        base / 'seat', args.timeout)
        worlds.append(seat)
        row('and the first seat by the world that claimed its own', True)
        row('a seat with no invitation is not a place: nothing was minted for it',
            maker.number(course + '/seats/second', 'name') == 0, maker.read(course + '/seats/second'))
        row("each world's part in the course is written by its own foot, once its claim is made",
            until(lambda: all(w.number('/' + w.node + '/io/scope/' + w.node, 'maker') == number_of('0x61')
                              and w.text('/' + w.node + '/io/scope/' + w.node, 'rel') == '/app/course'
                              for w in (chair, seat)), 120),
            [chair.read('/' + chair.node + '/io/scope/' + chair.node),
             seat.read('/' + seat.node + '/io/scope/' + seat.node)])

        row('each learns of the other from the catalog, with no card written by anyone',
            until(lambda: chair.number('/' + chair.node + '/io/mesa/' + seat.node, 'port') == seat.mesa
                  and seat.number('/' + seat.node + '/io/mesa/' + chair.node, 'port') == chair.mesa, 300),
            [chair.read('/' + chair.node + '/io/mesa/' + seat.node),
             seat.read('/' + seat.node + '/io/mesa/' + chair.node)])
        row('the table reaches both, as records the maker writes',
            until(lambda: chair.there(held(chair, maker, '/table/7')) and seat.there(held(seat, maker, '/table/7')), 300),
            [chair.read(held(chair, maker, '/table/7')), seat.read(held(seat, maker, '/table/7'))])

        row('and so does the top of the course, which the table did not have to mention',
            until(lambda: chair.there(held(chair, maker, '')) and seat.there(held(seat, maker, '')), 120),
            [chair.read(held(chair, maker, '')), seat.read(held(seat, maker, ''))])

        chair.write(dict(path=side(chair) + '/assignments/essay', slots={'title': 'An essay'}))
        row("the chair's assignment reaches the seat",
            until(lambda: seat.text(held(seat, chair, '/assignments/essay'), 'title') == 'An essay', 300),
            seat.read(held(seat, chair, '/assignments/essay')))
        seat.write(dict(path=side(seat) + '/assignments/essay/work/first', slots={'title': 'My essay'}))
        row("the seat's work reaches the chair",
            until(lambda: chair.text(held(chair, seat, '/assignments/essay/work/first'), 'title') == 'My essay', 300),
            chair.read(held(chair, seat, '/assignments/essay/work/first')))
        chair.write(dict(path=side(chair) + '/assignments/essay/work/first/mark', slots={'title': 'A-'}))
        row('the mark reaches that seat',
            until(lambda: seat.text(held(seat, chair, '/assignments/essay/work/first/mark'), 'title') == 'A-', 300),
            seat.read(held(seat, chair, '/assignments/essay/work/first/mark')))
        time.sleep(20)
        row('the maker, who keeps the course, was sent none of the three',
            not maker.there(held(maker, chair, '/assignments/essay'))
            and not maker.there(held(maker, seat, '/assignments/essay/work/first'))
            and not maker.there(held(maker, chair, '/assignments/essay/work/first/mark')),
            maker.read(held(maker, chair, '/assignments/essay')))
    except Exception as error:
        row('the run completed', False, repr(error))
    finally:
        for world in worlds:
            world.stop()
        if args.keep or not all(rows):
            print(f'worlds kept at {base}', flush=True)
        else:
            subprocess.run(['rm', '-rf', str(base)])
    print(f'{sum(rows)} of {len(rows)} rows passed; the host is played by this script', flush=True)
    return 0 if rows and all(rows) else 1


if __name__ == '__main__':
    sys.exit(main())
