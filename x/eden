#!/usr/bin/env python3
"""Boot Shrine with explicitly selected filesystem source mounts."""
import argparse
from contextlib import ExitStack
import fcntl
import json
import os
import re
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from eden_mounts import catalog, select, prepare, runtime_specs, ScanBridge, runtime_literal
from eden_runtime import runtime_exit_status, startup_failed, startup_ready
from namespace_identity import parse_node_identity
from test_runner import stage, copy_snapshot

ROOT = Path(__file__).resolve().parent.parent


def enter_environment(argv):
    if os.environ.pop('_EDEN_NIX_ROOT', None) == str(ROOT):
        return
    nix = shutil.which('nix')
    if not nix:
        raise RuntimeError('x/eden requires Nix on PATH to prepare its tools.')
    print('Preparing Eden’s Nix environment…', flush=True)
    os.execvpe(nix, [nix, '--extra-experimental-features', 'nix-command flakes',
                    'develop', '--no-update-lock-file', f'{ROOT}#eden',
                    '--command', 'env', f'_EDEN_NIX_ROOT={ROOT}',
                    f'TMPDIR={tempfile.gettempdir()}',
                    'python3', str(ROOT / 'x/eden'), *argv], os.environ)


def literal(value):
    return runtime_literal(value)


def upgrade_world(runtime, world, timeout):
    """Upgrade the private continuation, keeping the native namespace verbatim."""
    utility = Path(runtime).resolve().parent / 'eden-native-upgrade'
    if not utility.is_file():
        raise ValueError('--upgrade requires the native runtime from this checkout’s Eden shell')
    log_path = world / 'upgrade.log'
    with tempfile.TemporaryDirectory(prefix='eden-upgrade-') as temporary, log_path.open('w') as log:
        work = Path(temporary)
        copy_snapshot(stage(runtime, False, timeout), work / 'snap')
        process = subprocess.Popen([runtime, '--file-root', str(ROOT / 'src'), 'snap', 'root', '_'],
            cwd=work, stdin=subprocess.PIPE, stdout=log, stderr=log, text=True,
            start_new_session=True)
        try:
            process.stdin.write('(#bind upgrade (#module eden-upgrade))\n(upgrade:export 0)\n')
            process.stdin.close()
            deadline = time.monotonic() + timeout
            while not any(re.fullmatch(r'"EDEN-UPGRADE-PREPARED:[0-9]+"', line.strip())
                          for line in log_path.read_text(errors='replace').splitlines()):
                if process.poll() is not None or time.monotonic() > deadline:
                    raise ValueError(f'Could not prepare bootstrap upgrade; see {log_path}')
                time.sleep(.1)
        finally:
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait()
        code = work / 'code'
        code.mkdir()
        for command in [[str(utility), 'export-code', str(work / 'snap'), str(code)],
                        [str(utility), 'upgrade', str(code), str(world / 'snap')]]:
            result = subprocess.run(command, stdout=log, stderr=log, timeout=timeout)
            if result.returncode:
                raise ValueError(f'Native bootstrap upgrade failed; see {log_path}')
        for name in ['foil/eden_store.foil', 'reaver/eden-world.rvr',
                     'reaver/eden.rvr', 'reaver/foil-source.rvr',
                     'reaver/foil-publication.rvr']:
            shutil.copyfile(ROOT / 'src' / name, world / 'src' / name)
    print(f'Native bootstrap upgraded; namespace content hash unchanged. Log: {log_path}', flush=True)


def main():
    def terminate(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mount', action='append', default=[], metavar='NAME')
    parser.add_argument('--extras-root', type=Path,
                        help='Mount source directory (default: this checkout’s extras/)')
    parser.add_argument('--workspace', type=Path, help='Source workspace for host captures (remembered by the world)')
    parser.add_argument('--list-mounts', action='store_true')
    parser.add_argument('--node', default='0x11')
    parser.add_argument('--port', type=int, default=8130)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--world', type=Path, help='Native world directory (default: $XDG_DATA_HOME/shrine/worlds/NODE)')
    parser.add_argument('--ephemeral', action='store_true', help='Disposable world; implied by --check')
    parser.add_argument('--upgrade', action='store_true', help='Upgrade an existing world’s private bootstrap, preserving its namespace and history')
    parser.add_argument('--compact', action='store_true', help='Collect obsolete native checkpoints before starting; preserve the current world and all its history')
    parser.add_argument('--startup-timeout', type=int, default=2400)
    parser.add_argument('--request-timeout', type=int, default=120)
    parser.add_argument('--compiler', metavar='TIER',
                        help='plangrm compiler tier to Install for the session '
                             '(P1..P6, or none; default the world’s creation tier, initially P6)')
    args = parser.parse_args()
    try:
        number, node = parse_node_identity(args.node)
        if not 1 <= args.port <= 65535:
            raise ValueError('--port must be between 1 and 65535')
        if args.startup_timeout <= 0 or args.request_timeout <= 0:
            raise ValueError('Timeouts must be positive')
        if args.world and (args.ephemeral or args.check):
            raise ValueError('--world cannot be combined with --ephemeral or --check')
        world = (args.world or Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'shrine/worlds' / node).resolve()
        metadata = world / 'world.json'
        recorded = json.loads(metadata.read_text()) if metadata.is_file() and not (args.ephemeral or args.check) else None
        if args.upgrade and not recorded:
            raise ValueError('--upgrade requires an existing persistent world')
        if args.compact and not recorded:
            raise ValueError('--compact requires an existing persistent world')
        if recorded and (recorded.get('format') != 1 or recorded.get('node') != node):
            raise ValueError(f'Incompatible world identity: {metadata}')
        args.compiler = args.compiler or (recorded.get('compiler', 'P6') if recorded else 'P6')
        if args.compiler != 'none' and not re.fullmatch(r'P[1-6]', args.compiler):
            raise ValueError('--compiler must be P1..P6 or none')
        extras = (args.extras_root or (Path(recorded['extras']) if recorded else ROOT / 'extras')).resolve()
        workspace = (args.workspace or Path(recorded.get('workspace', ROOT) if recorded else ROOT)).resolve()
        if args.list_mounts:
            for name in catalog(extras):
                print(name)
            return 0
        names = args.mount or (recorded['mounts'] if recorded else [])
        selected = select(extras, names) if names else []
        if recorded and [m.name for m in selected] != recorded['mounts']:
            raise ValueError('The selected mounts differ from this world; use its existing selection')
        enter_environment(sys.argv[1:])
        runtime = os.environ.get('WISP') or shutil.which('wisp')
        if not runtime or not os.access(runtime, os.X_OK):
            raise ValueError('Set WISP to a working runtime executable')
        with ExitStack() as cleanup:
            if args.ephemeral or args.check:
                work = Path(cleanup.enter_context(tempfile.TemporaryDirectory(prefix='shrine-eden-')))
            else:
                work = world
                work.mkdir(parents=True, exist_ok=True, mode=0o700)
            lock = cleanup.enter_context((work / 'world.lock').open('a'))
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError(f'This world is already running: {work}')
            restored = (work / 'snap/arena.dat').is_file() and (work / 'world.json').is_file()
            if args.upgrade:
                if not restored:
                    raise ValueError('--upgrade requires a complete native world')
                upgrade_world(runtime, work, args.startup_timeout)
            if args.compact:
                if not restored:
                    raise ValueError('--compact requires a complete native world')
                inspector = Path(runtime).resolve().parent / 'scry'
                if not inspector.is_file():
                    raise ValueError('--compact requires the native runtime from this checkout’s Eden shell')
                print('Compacting the native arena; retaining the complete current world and x/y/z history…', flush=True)
                result = subprocess.run([str(inspector), str(work / 'snap'), 'compact'],
                                        timeout=args.startup_timeout, capture_output=True, text=True)
                print(result.stdout, end='', flush=True)
                print(result.stderr, end='', file=sys.stderr, flush=True)
                if result.returncode or not re.fullmatch(
                        r'Native arena compacted: [0-9]+ -> [0-9]+ bytes; root content hash unchanged\.\n',
                        result.stdout):
                    raise ValueError('Native compaction failed; world was not started')
            if not restored:
                if (work / 'snap').exists() or (work / 'src').exists():
                    raise ValueError(f'Incomplete world retained at {work}; refusing to replace it')
                template = stage(runtime, False, args.startup_timeout)
                shutil.copytree(ROOT / 'src', work / 'src')
                copy_snapshot(template, work / 'snap')
                (work / 'world.json').write_text(json.dumps(dict(format=1, node=node,
                    extras=str(extras), workspace=str(workspace), compiler=args.compiler,
                    mounts=[m.name for m in selected]), indent=2) + '\n')
            session = Path(cleanup.enter_context(tempfile.TemporaryDirectory(prefix='session-', dir=work)))
            prepared = prepare(selected, session, args.check, cleanup,
                               {"node": node, "timeout": args.startup_timeout, "workspace": str(workspace)})
            specs = runtime_specs(prepared, work / 'src')
            scanner = cleanup.enter_context(ScanBridge(prepared, work / 'src')) if specs else None
            scan_port = scanner.port if scanner else 0
            scan_token = scanner.token if scanner else ''
            log_path = work / 'out.log'
            print(f'{"Restoring" if restored else "Booting"} Eden world: {work}. Log: {log_path}', flush=True)
            log = cleanup.enter_context(log_path.open('a' if restored else 'w'))
            log_start = log_path.stat().st_size
            runtime_args = [args.compiler, str(args.port), str(scan_port), scan_token]
            for spec in specs:
                runtime_args.extend([str(len(spec[8])), *map(str, spec[8])])
            # The repl re-installs the boot compiler at every session start, so
            # the requested tier is installed here, per session.  Compiled
            # code is attached lazily and cached across processes by the
            # runtime, so only laws the boot actually runs pay for the tier.
            install = ''
            if args.compiler != 'none':
                install = f'(#bind opt (#module plangrm))\n(Install opt:compile{args.compiler})\n'
            # A saved world continuation ignores stdin. If the first boot was
            # interrupted before its first native Save, the retained compiler
            # REPL consumes this same bootstrap; no arena is ever replaced.
            # A file avoids blocking on a full pipe when the saved world ignores it.
            bootstrap_input = cleanup.enter_context((session / 'boot.rvr').open('w+'))
            bootstrap_input.write(install + f'''(#bind eden (#module eden))
(#bind bootstrap (#module foil-bootstrap))
(#bind std (#module std))
(#import std)
(define (launch ignored)
  (define (resolve name) [["x" {number}] ["ts" "lib"] ["ts" name]])
  (define slot [("x" {number}) ("ts" "compiler") ("ts" "artifact")])
  (define system (bootstrap:build-system (Pin eden:start) resolve slot))
  (eden:start-with-tier ("x" {number}) system resolve slot {args.port} {literal(specs)} {scan_port} {literal(scan_token)} {literal(args.compiler)}))
(print ("EDEN-LAUNCH-RETURNED" (Try launch 0)))
''')
            bootstrap_input.flush()
            bootstrap_input.seek(0)
            process = subprocess.Popen([runtime, '--file-root', str(work / 'src'),
                                        'snap', 'root', '_', *runtime_args], cwd=work,
                                       stdin=bootstrap_input, stdout=log, stderr=log,
                                       text=True, restore_signals=False,
                                       pass_fds=(lock.fileno(),))
            def stop():
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
            cleanup.callback(stop)
            deadline = time.monotonic() + args.startup_timeout
            while True:
                with log_path.open('rb') as current_log:
                    current_log.seek(log_start)
                    output = current_log.read().decode(errors='replace')
                if process.poll() is not None:
                    return runtime_exit_status(process.returncode, log_path) or 1
                if startup_failed(output, 'EDEN-LAUNCH-RETURNED'):
                    raise RuntimeError(output[-6000:])
                if startup_ready(output, 'EDEN-LAUNCH-RETURNED'):
                    try:
                        with socket.create_connection(('127.0.0.1', args.port), timeout=.2):
                            break
                    except OSError:
                        pass
                if time.monotonic() > deadline:
                    raise RuntimeError(f'Startup timed out; inspect {log_path}')
                time.sleep(.25)
            url = f'http://127.0.0.1:{args.port}'
            print(f'Eden: {url}; mounts: {", ".join(m.name for m in selected) or "none"}', flush=True)
            if args.check:
                for path in ('/__eden_unregistered__',):
                    try:
                        urllib.request.urlopen(url + path, timeout=args.request_timeout)
                    except urllib.error.HTTPError as error:
                        if error.code != 404:
                            raise
                    else:
                        raise RuntimeError('Unregistered route did not return 404')
                for mount, folder, arguments, module in prepared:
                    if module and hasattr(module, 'check'):
                        print(f'Checking mount: {mount.name}', flush=True)
                        try:
                            module.check(url, node, args.request_timeout)
                        except urllib.error.HTTPError as error:
                            raise RuntimeError(f'{mount.name}: {error.code} at {error.url}: {error.read().decode(errors="replace")[:1200]}') from error
                print('Eden checks passed.', flush=True)
                return 0
            return runtime_exit_status(process.wait(), log_path)
    except KeyboardInterrupt:
        return 130
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        parser.error(str(error))


if __name__ == '__main__':
    raise SystemExit(main())
