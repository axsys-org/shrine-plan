#!/usr/bin/env python3
"""Boot Shrine with explicitly selected filesystem source mounts."""
import argparse
from contextlib import ExitStack
import os
import re
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from eden_mounts import catalog, select, prepare, runtime_specs, ScanBridge, runtime_literal
from eden_runtime import runtime_exit_status, startup_failed, startup_ready
from namespace_identity import parse_node_identity
from test_runner import stage, copy_snapshot

ROOT = Path(__file__).resolve().parent.parent


def enter_environment(argv):
    if os.environ.pop('_EDEN_NIX_ROOT', None) == str(ROOT):
        return
    nix = shutil.which('nix')
    if not nix:
        raise RuntimeError('x/eden requires Nix on PATH to prepare its tools.')
    print('Preparing Eden’s Nix environment…', flush=True)
    os.execvpe(nix, [nix, '--extra-experimental-features', 'nix-command flakes',
                    'develop', '--no-update-lock-file', f'{ROOT}#eden',
                    '--command', 'env', f'_EDEN_NIX_ROOT={ROOT}',
                    f'TMPDIR={tempfile.gettempdir()}',
                    'python3', str(ROOT / 'x/eden'), *argv], os.environ)


def literal(value):
    return runtime_literal(value)


def main():
    def terminate(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mount', action='append', default=[], metavar='NAME')
    parser.add_argument('--extras-root', type=Path,
                        help='Mount source directory (default: this checkout’s extras/)')
    parser.add_argument('--workspace', type=Path, help='Source workspace for host captures (default: this checkout)')
    parser.add_argument('--list-mounts', action='store_true')
    parser.add_argument('--node', default='0x11')
    parser.add_argument('--port', type=int, default=8130)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--snapshot', type=Path, help='Native snapshot directory containing arena.dat; created if absent')
    parser.add_argument('--ephemeral', action='store_true', help='Disposable snapshot (the default); cannot use --snapshot')
    parser.add_argument('--startup-timeout', type=int, default=2400)
    parser.add_argument('--request-timeout', type=int, default=120)
    parser.add_argument('--compiler', default='P6', metavar='TIER',
                        help='plangrm compiler tier to Install for the session '
                             '(P1..P6, or none; default P6)')
    args = parser.parse_args()
    try:
        number, node = parse_node_identity(args.node)
        if not 1 <= args.port <= 65535:
            raise ValueError('--port must be between 1 and 65535')
        if args.startup_timeout <= 0 or args.request_timeout <= 0:
            raise ValueError('Timeouts must be positive')
        if args.snapshot and (args.ephemeral or args.check):
            raise ValueError('--snapshot cannot be combined with --ephemeral or --check')
        snapshot = args.snapshot.resolve() if args.snapshot else None
        if args.compiler != 'none' and not re.fullmatch(r'P[1-6]', args.compiler):
            raise ValueError('--compiler must be P1..P6 or none')
        extras = (args.extras_root or ROOT / 'extras').resolve()
        workspace = (args.workspace or ROOT).resolve()
        if args.list_mounts:
            for name in catalog(extras):
                print(name)
            return 0
        names = args.mount or []
        selected = select(extras, names) if names else []
        enter_environment(sys.argv[1:])
        runtime = os.environ.get('WISP') or shutil.which('wisp')
        if not runtime or not os.access(runtime, os.X_OK):
            raise ValueError('Set WISP to a working runtime executable')
        with ExitStack() as cleanup:
            # The arena is the only persistent store. Source staging, bridge
            # credentials, build products and logs belong to this process.
            work = Path(cleanup.enter_context(tempfile.TemporaryDirectory(prefix='shrine-eden-')))
            snapshot = snapshot or work / 'snap'
            restored = (snapshot / 'arena.dat').is_file()
            if not restored:
                if snapshot.exists():
                    raise ValueError(f'No native arena in {snapshot}; refusing to replace this directory')
                template = stage(runtime, False, args.startup_timeout)
                copy_snapshot(template, snapshot)
                snapshot.chmod(0o700)
            if snapshot != work / 'snap':
                (work / 'snap').symlink_to(snapshot, target_is_directory=True)
            shutil.copytree(ROOT / 'src', work / 'src')
            prepared = prepare(selected, work, args.check, cleanup,
                               {"node": node, "timeout": args.startup_timeout, "workspace": str(workspace)})
            specs = runtime_specs(prepared, work / 'src')
            scanner = cleanup.enter_context(ScanBridge(prepared, work / 'src')) if specs else None
            scan_port = scanner.port if scanner else 0
            scan_token = scanner.token if scanner else ''
            log_path = work / 'out.log'
            print(f'{"Resuming" if restored else "Booting"} Eden snapshot: {snapshot}. Log: {log_path}', flush=True)
            log = cleanup.enter_context(log_path.open('w'))
            runtime_args = [args.compiler, str(number), str(args.port), str(scan_port), scan_token]
            for spec in specs:
                runtime_args.extend([spec[2], str(len(spec[8])), *map(str, spec[8])])
            # The repl re-installs the boot compiler at every session start, so
            # the requested tier is installed here, per session.  Compiled
            # code is attached lazily and cached across processes by the
            # runtime, so only laws the boot actually runs pay for the tier.
            install = ''
            if args.compiler != 'none':
                install = f'(#bind opt (#module plangrm))\n(Install opt:compile{args.compiler})\n'
            # A native Eden continuation ignores stdin. If the first boot was
            # interrupted before its first native Save, the retained compiler
            # REPL consumes this same bootstrap; no arena is ever replaced.
            # A file avoids blocking on a full pipe when the saved world ignores it.
            bootstrap_input = cleanup.enter_context((work / 'boot.rvr').open('w+'))
            bootstrap_input.write(install + f'''(#bind eden (#module eden))
(#bind bootstrap (#module foil-bootstrap))
(#bind std (#module std))
(#import std)
(define (launch ignored)
  (define (resolve name) [["x" {number}] ["ts" "lib"] ["ts" name]])
  (define slot [("x" {number}) ("ts" "compiler") ("ts" "artifact")])
  (define system (bootstrap:build-system (Pin eden:start) resolve slot))
  (eden:start-with-tier ("x" {number}) system resolve slot {args.port} {literal(specs)} {scan_port} {literal(scan_token)} {literal(args.compiler)}))
(print ("EDEN-LAUNCH-RETURNED" (Try launch 0)))
''')
            bootstrap_input.flush()
            bootstrap_input.seek(0)
            process = subprocess.Popen([runtime, '--file-root', str(work / 'src'),
                                        'snap', 'root', '_', *runtime_args], cwd=work,
                                       stdin=bootstrap_input, stdout=log, stderr=log,
                                       text=True, restore_signals=False)
            def stop():
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
            cleanup.callback(stop)
            deadline = time.monotonic() + args.startup_timeout
            while True:
                output = log_path.read_text(errors='replace')
                if process.poll() is not None:
                    print(output[-6000:], file=sys.stderr)
                    return runtime_exit_status(process.returncode, log_path) or 1
                if startup_failed(output, 'EDEN-LAUNCH-RETURNED'):
                    raise RuntimeError(output[-6000:])
                if startup_ready(output, 'EDEN-LAUNCH-RETURNED'):
                    try:
                        with socket.create_connection(('127.0.0.1', args.port), timeout=.2):
                            break
                    except OSError:
                        pass
                if time.monotonic() > deadline:
                    raise RuntimeError(f'Startup timed out. Last native output:\n{output[-6000:]}')
                time.sleep(.25)
            url = f'http://127.0.0.1:{args.port}'
            print(f'Eden: {url}; mounts: {", ".join(m.name for m in selected) or "none"}', flush=True)
            if args.check:
                for path in ('/__eden_unregistered__',):
                    try:
                        urllib.request.urlopen(url + path, timeout=args.request_timeout)
                    except urllib.error.HTTPError as error:
                        if error.code != 404:
                            raise
                    else:
                        raise RuntimeError('Unregistered route did not return 404')
                for mount, folder, arguments, module in prepared:
                    if module and hasattr(module, 'check'):
                        print(f'Checking mount: {mount.name}', flush=True)
                        try:
                            module.check(url, node, args.request_timeout)
                        except urllib.error.HTTPError as error:
                            raise RuntimeError(f'{mount.name}: {error.code} at {error.url}: {error.read().decode(errors="replace")[:1200]}') from error
                print('Eden checks passed.', flush=True)
                return 0
            status = process.wait()
            if status:
                print(log_path.read_text(errors='replace')[-6000:], file=sys.stderr)
            return runtime_exit_status(status, log_path)
    except KeyboardInterrupt:
        return 130
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        parser.error(str(error))


if __name__ == '__main__':
    raise SystemExit(main())
