# Launch the lain namespace over HTTP — the helm coordinator, the
# HTTP driver at /io/http, and the weft namespace explorer.
#
#   x/lain            # resume run/lain (or fresh-boot if none), port 8090
#   x/lain 9000       # custom port (fresh boots only — a resumed
#                     # serve keeps the port baked into its snapshot)
#   x/lain --fresh    # discard run/lain and boot from source
#
# Then browse http://localhost:<port>/ns
#
# Lifecycle: a fresh boot stages the repl snapshot if missing, clones
# it into run/lain/snap, and compiles the world from source in the
# serve session (helm-run.rvr run-lain-serve).  The serve Saves a
# resume-continuation pin into run/lain/snap after every committed
# event, so starting that snapshot resumes the namespace — the
# snapshot is the only build cache there is.

set -ex

FRESH=""
if [ "${1:-}" = "--fresh" ]; then
  FRESH="--fresh"
  shift
fi

PORT="${1:-8090}"

ROOT="$(pwd)"
WISP="$(command -v wisp || echo "$ROOT/wisp")"
SERVE_DIR="run/lain"

reset () {
	wisp --file-root ./src ./src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
(#bind opt (#module plangrm))
(Install opt:compileP5)
EOF
}

load_quip () {
    repl <<EOF
(#bind quip (#module quip))
EOF
}

# Resume: the serve snapshot's last pin is the namespace continuation.
if [ -z "$FRESH" ] && [ -e "$SERVE_DIR/snap/data.mdb" ]; then
  echo "resuming lain from $SERVE_DIR/snap (x/lain --fresh discards it)" >&2
  cd "$SERVE_DIR"
  exec "$WISP" --file-root "$ROOT/src" snap root _ </dev/null
fi

# The root snap must be a PRISTINE repl staging: a serve session that
# ever ran here Saved a resume continuation into it, after which every
# "fresh" boot silently resumed the old world (heredoc eaten as argv,
# baked port, stale code).  The marker distinguishes the two; a
# markerless snap is discarded and restaged.
if [ ! -e snap/data.mdb ] || [ ! -e snap/.repl-staged ]
then rm -rf snap; reset; load_stdlib; load_quip; touch snap/.repl-staged
fi

# Fresh serve: COW-clone the staged repl snapshot into the serve dir
# so the serve session's Saves land in run/lain/snap — never in the
# root staging.
rm -rf "$SERVE_DIR"
mkdir -p "$SERVE_DIR/snap"
cp -c snap/data.mdb "$SERVE_DIR/snap/" 2>/dev/null || cp snap/data.mdb "$SERVE_DIR/snap/"
cp -c snap/pins.pack "$SERVE_DIR/snap/" 2>/dev/null || cp snap/pins.pack "$SERVE_DIR/snap/"

echo "lain exploring on http://localhost:${PORT}/ns" >&2

cd "$SERVE_DIR"
"$WISP" --file-root "$ROOT/src" snap root _ <<EOF
(#bind std (#module std))
(#import std)
(#bind helm-run (#module helm-run))
(helm-run:run-lain-serve ${PORT})
EOF
