 void pl_store_release(pl_store* s, size_t mark) {
   pl_store_lock(s);
   s->region->off_o = mark;
+  if (s->decoded_values != NULL)
+    memset(s->decoded_values, 0, (1u << 18) * sizeof(pl_val));
