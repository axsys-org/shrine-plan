# Launch the Forge — the live Foil dev environment — on port 8677.
# Builds the snapshot first if needed (same staging as x/test).

set -ex

FRESH=""
if [ "${1:-}" = "--fresh" ]; then
  FRESH="--fresh"
  shift
fi

PORT="${1:-8677}"

reset () {
	wisp --file-root ./src ./src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}

load_quip () {
    repl <<EOF
(#bind quip (#module quip))
EOF
}

if [ ! -e snap/root.plan ]
then reset; load_stdlib; load_quip
fi

# axal is intentionally malformed so Forge can render its diagnostics; leave
# that one for the resident state-bundle Try instead of aborting cache warmup.
x/foil-cache ${FRESH} bst demo mapx mapuser

echo "forge listening on http://localhost:${PORT}/" >&2

# `x/forge <port> par` boots with every bundle compiled in parallel
# actors (needs enki with the actor-request fix, merged July 2026 —
# doc/enki-actor-report.md).
ENTRY="run-forge-artifact-cached"
if [ "${2:-}" = "par" ]; then ENTRY="run-forge-par-artifact-cached"; fi

repl <<EOF
(#bind forge (#module forge))
(forge:${ENTRY} ${PORT} _foil_artifact_cache_v1)
EOF
