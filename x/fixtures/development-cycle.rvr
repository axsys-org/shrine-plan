;;;; Compile and evaluate an unpublished Foil candidate in a disposable owner.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind publication (#module foil-publication))
(#bind driver (#module foil-new-env))
(#bind core (#module foil-type-core))

(define selection
  (Pin (map (lambda (name)
    [(Weld [("ts" "sys") ("ts" "types")]
       (map (lambda (part) ("ts" part)) name)) 1]) core:system-names)))

(define (run text expected)
  (define prepared
    (publication:prepare selection (Pin "development-cycle-fixture/v1")
      (lambda (name) (rex:ParseRexNormFile text))
      [["candidate" [["x" 17] ["ts" "candidate"]]]] [] (lambda (path) 0)))
  (define candidate (publication:compile prepared driver:empty-foil-cache))
  (define image (Unpin (_1 (_0 (_2 candidate)))))
  (define behavior (driver:get-perc ["evaluate"] image))
  ;; No publication: the compiled value and its cache become unreachable when
  ;; this call returns, and the host then discards this worker's private store.
  (If (Eq expected (behavior 7)) 1 (error "candidate returned a wrong value")))

(#export run)
