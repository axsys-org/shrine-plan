# The shared repl staging recipe (sourced by x/repl, x/lain,
# x/lain-dev, x/check — the copies drifted; this is the one text).
#
#   . "$(dirname "$0")/stage-lib"
#   stage_repl "$WISP" "$ROOT" [--app-todo] [--p2]
#
# Boots the plan (reaver main), loads the stdlib into a fresh ./snap
# (optionally ::*app-todo, optionally the P2 compiler install — P2,
# not P5: the serve-time install stays the caller's business), then
# binds quip in its own session.  Writes ./snap relative to the
# CURRENT directory: cd to the staging dir first.  Callers redirect
# output; every form Saves, so the snapshot is complete when this
# returns.
stage_repl () {
  _wisp="$1"; _root="$2"; shift 2
  _todo=""; _p2=""
  for _a in "$@"; do
    case "$_a" in
      --app-todo) _todo=1 ;;
      --p2) _p2=1 ;;
    esac
  done
  "$_wisp" --file-root "$_root/src" "$_root/src/plan" reaver main
  {
    printf '(#bind std (#module std))\n(#import std)\n'
    if [ -n "$_todo" ]; then printf '%s\n' '::*app-todo'; fi
    printf '%s\n' '::*rex'
    if [ -n "$_p2" ]; then
      printf '(#bind opt (#module plangrm))\n(Install opt:compileP2)\n'
    fi
  } | "$_wisp" --file-root "$_root/src" snap root _
  printf '(#bind quip (#module quip))\n' | "$_wisp" --file-root "$_root/src" snap root _
}
