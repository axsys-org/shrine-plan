#!/bin/sh
# Warm Foil module artifacts into the ordinary Reaver snapshot.

set -eu

fresh=0
if [ "${1-}" = "--fresh" ]; then
  fresh=1
  shift
fi

if [ "$#" -eq 0 ]; then
  echo "usage: x/foil-cache [--fresh] module..." >&2
  exit 2
fi

mods=""
for mod in "$@"; do
  case "$mod" in
    *[!A-Za-z0-9_-]*|'') echo "invalid Foil module: $mod" >&2; exit 2 ;;
  esac
  mods="$mods \"$mod\""
done
mods="[$mods]"

reset() {
  wisp --file-root ./src ./src/plan reaver main
}

repl() {
  wisp --file-root src/ snap root _
}

bootstrap() {
  reset
  repl <<'EOF'
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
  repl <<'EOF'
(#bind quip (#module quip))
EOF
}

if [ ! -e snap/root.plan ]; then
  bootstrap >/dev/null 2>&1
fi

lock=snap/.foil-artifact-cache.lock
while ! mkdir "$lock" 2>/dev/null; do sleep 1; done
log="${TMPDIR:-/tmp}/foil-cache-$$.log"
cleanup() {
  rmdir "$lock" 2>/dev/null || true
  rm -f "$log"
}
trap cleanup EXIT INT TERM

warm_existing() {
  repl >"$log" 2>&1 <<EOF
(#bind foil-cache (#module foil-cache))
(#bind _foil_artifact_cache_v1
  (foil-cache:warm _foil_artifact_cache_v1 $mods $fresh))
EOF
}

warm_new() {
  repl >"$log" 2>&1 <<EOF
(#bind foil-cache (#module foil-cache))
(#bind _foil_artifact_cache_v1
  (foil-cache:warm (foil-cache:empty-cache 0) $mods $fresh))
EOF
}

warm_status=0
warm_existing || warm_status=$?
if grep -q '"ERROR"' "$log"; then
  if grep -q '_foil_artifact_cache_v1' "$log" && grep -q '"unbound"' "$log"; then
    warm_status=0
    warm_new || warm_status=$?
  fi
fi

if [ "$warm_status" -ne 0 ] || grep -q '"ERROR"' "$log"; then
  tail -80 "$log" >&2
  exit 1
fi

echo "Foil artifact cache warm: $*" >&2
