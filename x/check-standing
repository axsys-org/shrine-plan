#!/usr/bin/env python3
"""What a world was given, shown somewhere else and checked against a name: five world processes.

0x61 is a house that keeps a place for a school. The school's world is prepared for that place and claimed, so
its name is the one its founding makes: a name that proves its own keys to a stranger. The school keeps a
course, made from the course template. A chair and a seat join it by their links, as x/check-course covers.
The chair sets an essay, the seat hands in its work, and the chair marks it: the mark is a record the seat's
world holds under the chair's signature. Because the school's name has a founding, it tells its members of
itself, and each holds the school's founding and log beside the key its link gave.

0x63 keeps a job, made from the job template (extras/mounts/job, Grove alone). It has never met the school or
its chair. It writes what it wants shown: a record at the mark's position of the course the school keeps. The
seat's world takes the job's first supplier seat by its link, under its own session, and is shown that it has
a standing to show. It chooses to: it writes a record there. Its own foot adds the proof from what the world
holds. The buyer's world checks the proof against the school's name and asks nobody: the standing stands, and
the quote beneath it opens. The chair takes the second seat and writes a standing too. It wrote the mark; it
was not given it; nothing stands.

Played by this script, and so not counted toward the finish line: the host (it starts the school's, the
chair's and the seat's worlds under their minted names and tells each where it is reached).

    x/check-standing [--keep] [--base-port 8441]

Exit 0 when every row passes. Run it on the build machine, never beside another heavy job.
"""
import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from net_worlds import World, number_of, prepared, spell, until  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--keep', action='store_true', help='keep the world directories')
    parser.add_argument('--base-port', type=int, default=8441)
    parser.add_argument('--timeout', type=int, default=1800)
    args = parser.parse_args()
    base = Path(tempfile.mkdtemp(prefix='shrine-standing-'))
    house = World('0x61', args.base_port, args.base_port + 1000, base / 'house')
    buyer = World('0x63', args.base_port + 4, args.base_port + 1004, base / 'buyer',
                  mounts=('mcp', 'mesa', 'scope', 'codecs', 'job'))
    worlds = [house, buyer]
    rows = []
    place = '/0x61/app/home/schools/first'
    job = '/0x63/app/job'
    mark = '/assignments/essay/work/first/mark'

    def row(name, passed, detail=''):
        rows.append(passed)
        print(('PASS  ' if passed else 'FAIL  ') + name + ('' if passed else '   ' + str(detail)[:700]), flush=True)

    def side(world, of=None):
        return '/' + world.node + '/mine/' + (of or kept)

    def held(world, writer, rel, of=None):
        return '/' + world.node + '/her/' + writer.node + '/' + (of or kept) + rel

    def view(world, record):
        said = world.get('/scope/view/' + record)
        return [line.split(' ') for line in said[1].splitlines()] if said[0] == 200 else [said]

    def stands(world, record, kind, rel):
        return any(len(line) == 4 and line[0] == kind and line[1] == rel for line in view(world, record))

    def shown(world, record, rel):
        return any(len(line) == 4 and line[1] == rel for line in view(world, record))

    def take(world, number):
        """A world that is its own takes a supplier seat of the job by its link, under its own session.
        What comes back is the name of the record its foot keeps for the job."""
        seat = job + '/suppliers/' + ('first' if number == 1 else 'second')
        until(lambda: buyer.number(seat, 'name') > 0, 300)
        named = spell(buyer.number(seat, 'name'))
        said = world.join(buyer.link(number))
        if said[0] != 202:
            raise RuntimeError(f'the link was not taken: {said}')
        if not until(lambda: buyer.number(seat, 'world') == number_of(world.node), 400):
            raise RuntimeError(f'the seat was not filled: {buyer.read(seat)}')
        return named

    try:
        house.start(args.timeout)
        buyer.start(args.timeout)
        for world in (house, buyer):
            here = '/' + world.node + '/io/mesa'
            until(lambda: world.number(here, 'key') > 0, 180)
        house.write(dict(path='/0x61/io/scope/home',
                         slots={'root': dict(type='reference', path='/0x61/app/home', care='x', case=0)}),
                    dict(path=place, slots={'title': 'A place for a school', 'invite': 1}))
        buyer.write(dict(path='/0x63/io/scope/job',
                         slots={'make': dict(type='reference', path='/0x63/gov/job', care='x', case=0),
                                'rel': '/app/job'}))
        mounts = ('mcp', 'mesa', 'scope', 'codecs', 'course')
        maker = prepared(house, place, 1, args.base_port + 1, args.base_port + 1001, base / 'school',
                         args.timeout, mounts)
        worlds.append(maker)
        kept = maker.node + '/app/course'
        course = '/' + kept
        row("the school's world is claimed and is its own, under the name its founding makes",
            maker.number('/' + maker.node + '/io/mesa', 'seq') == 2
            and maker.there('/' + maker.node + '/io/mesa/pass'), maker.read('/' + maker.node + '/io/mesa'))
        maker.write(dict(path='/' + maker.node + '/io/scope/course',
                         slots={'make': dict(type='reference', path='/' + maker.node + '/gov/course', care='x', case=0),
                                'rel': '/app/course'}))
        until(lambda: maker.there(course + '/table/9'), 300)
        chair = prepared(maker, course + '/chair', 1, args.base_port + 2, args.base_port + 1002,
                         base / 'chair', args.timeout, mounts)
        worlds.append(chair)
        seat = prepared(maker, course + '/seats/first', 2, args.base_port + 3, args.base_port + 1003,
                        base / 'seat', args.timeout, mounts)
        worlds.append(seat)
        row("the school tells its members of itself: the seat holds the school's founding and log, checked "
            'against its name, beside the key its link gave',
            until(lambda: seat.number('/' + seat.node + '/io/mesa/' + maker.node, 'seq') == 2
                  and seat.there('/' + seat.node + '/io/mesa/' + maker.node + '/pass/2'), 300),
            seat.read('/' + seat.node + '/io/mesa/' + maker.node))
        until(lambda: chair.there(held(chair, maker, '/table/9')) and seat.there(held(seat, maker, '/table/9')), 400)
        chair.write(dict(path=side(chair) + '/assignments/essay', slots={'title': 'An essay', 'due': 10}))
        until(lambda: seat.text(held(seat, chair, '/assignments/essay'), 'title') == 'An essay', 300)
        seat.write(dict(path=side(seat) + '/assignments/essay/work/first', slots={'title': 'My essay'}))
        until(lambda: chair.text(held(chair, seat, '/assignments/essay/work/first'), 'title') == 'My essay', 300)
        chair.write(dict(path=side(chair) + mark, slots={'title': 'A-'}))
        row("a course is kept by one world, and its chair has marked a seat's work: the seat holds the mark",
            until(lambda: seat.text(held(seat, chair, mark), 'title') == 'A-', 300), seat.read(held(seat, chair, mark)))

        row('a job is made from a template that is one Grove file',
            until(lambda: buyer.there(job + '/suppliers/first') and buyer.there(job + '/table/7'), 300)
            and not buyer.there(job + '/table/8'), buyer.read(job + '/table', care='y'))
        row('its table says of one row what a record there must show: whatever the place wants names',
            any(buyer.text(f'{job}/table/{n}', 'path') == 'suppliers/[s]/standing'
                and buyer.text(f'{job}/table/{n}', 'shows') == 'wants' for n in range(1, 8)),
            [buyer.slots(f'{job}/table/{n}') for n in range(1, 8)])
        buyer.write(dict(path=job + '/wants',
                         slots={'at': 'assignments/[a]/work/[s]/mark',
                                'of': dict(type='reference', path=course, care='x', case=0)}))
        row('the buyer has never met the school: it holds no card for it or for its chair',
            not buyer.there('/0x63/io/mesa/' + maker.node) and not buyer.there('/0x63/io/mesa/' + chair.node),
            buyer.read('/0x63/io/mesa', care='y'))

        named = take(seat, 1)
        theirs = '0x63/app/job'
        row("the seat's world takes the job's first supplier seat by its link, as itself",
            until(lambda: seat.number('/' + seat.node + '/io/scope/' + named, 'maker') == number_of('0x63'), 300),
            seat.read('/' + seat.node + '/io/scope/' + named))
        row('what the buyer wants reaches it',
            until(lambda: seat.text(held(seat, buyer, '/wants', theirs), 'at') == 'assignments/[a]/work/[s]/mark', 300),
            seat.read(held(seat, buyer, '/wants', theirs)))
        standing = '/suppliers/first/standing'
        row('its door shows the job: a standing is its to show, and no quote is open yet',
            until(lambda: stands(seat, named, 'todo', standing), 180) and not shown(seat, named, standing + '/quote'),
            view(seat, named))
        row('the buyer waits on it', until(lambda: stands(buyer, 'job', 'waits', standing), 180), view(buyer, 'job'))

        seat.write(dict(path=side(seat, theirs) + standing, slots={'title': 'My mark in the course'}))
        row("it chooses to show: it writes a record there, and its own foot adds the proof from what it holds",
            until(lambda: stands(seat, named, 'held', standing), 300), view(seat, named))
        row('the record still reads, with the proof in it',
            seat.text(side(seat, theirs) + standing, 'title') == 'My mark in the course'
            and 'proof' in str(seat.slots(side(seat, theirs) + standing)), seat.read(side(seat, theirs) + standing))
        row("the buyer's world checks it against the school's name: the standing stands there too",
            until(lambda: stands(buyer, 'job', 'held', standing), 400), view(buyer, 'job'))
        row('and it asked nobody: it still holds no card for the school or the chair',
            not buyer.there('/0x63/io/mesa/' + maker.node) and not buyer.there('/0x63/io/mesa/' + chair.node),
            buyer.read('/0x63/io/mesa', care='y'))
        row('the quote beneath it is open: the seat may write it, and the buyer waits on it',
            until(lambda: stands(seat, named, 'todo', standing + '/quote')
                  and stands(buyer, 'job', 'waits', standing + '/quote'), 180), [view(seat, named), view(buyer, 'job')])
        seat.write(dict(path=side(seat, theirs) + standing + '/quote', slots={'title': 'Forty an hour'}))
        row('the quote reaches the buyer, and the decision is the buyer\'s to write',
            until(lambda: buyer.text(held(buyer, seat, standing + '/quote', theirs), 'title') == 'Forty an hour'
                  and stands(buyer, 'job', 'todo', standing + '/quote/decision'), 300), view(buyer, 'job'))
        buyer.write(dict(path=job + standing + '/quote/decision', slots={'title': 'Yes'}))
        row('the decision reaches the seat',
            until(lambda: seat.text(held(seat, buyer, standing + '/quote/decision', theirs), 'title') == 'Yes', 300),
            seat.read(held(seat, buyer, standing + '/quote/decision', theirs)))

        other = take(chair, 2)
        second = '/suppliers/second/standing'
        until(lambda: stands(chair, other, 'todo', second), 300)
        chair.write(dict(path=side(chair, theirs) + second, slots={'title': 'The mark I wrote'}))
        row('the chair takes the second seat and writes a standing: it reaches the buyer',
            until(lambda: buyer.text(held(buyer, chair, second, theirs), 'title') == 'The mark I wrote', 300),
            buyer.read(held(buyer, chair, second, theirs)))
        row('it wrote the mark and was not given it: nothing stands, at the buyer or at the chair',
            until(lambda: stands(buyer, 'job', 'unproven', second) and stands(chair, other, 'unproven', second), 180)
            and not shown(buyer, 'job', second + '/quote') and not shown(chair, other, second + '/quote'),
            [view(buyer, 'job'), view(chair, other)])
    except Exception as error:
        row('the run completed', False, repr(error))
    finally:
        for world in worlds:
            world.stop()
        if args.keep or not all(rows):
            print(f'worlds kept at {base}', flush=True)
        else:
            subprocess.run(['rm', '-rf', str(base)])
    print(f'{sum(rows)} of {len(rows)} rows passed; the host is played by this script', flush=True)
    return 0 if rows and all(rows) else 1


if __name__ == '__main__':
    sys.exit(main())
