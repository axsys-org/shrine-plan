#!/usr/bin/env python3
"""The easy setup: one command from a checkout to a running world.

    python3 x/setup --world DIR [--hand "NAME ARGS"] [--port N]
    python3 x/setup

Boots the world kept at DIR with mcp, probe, explorer, mesa and scope and a clock hand (the defaults for a new world; a kept world
boots as it was), waits for the foot, prints the world's URL, the MCP URL, the live page link and the skill path, and
stays attached: Ctrl-C tears the world and its hands down. It writes .shrine.json in the checkout with the world's
directory and port, and with no --world it resumes that world. Forty lines over x/eden, no new behaviour.
"""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
SKILL = ROOT / 'extras/mounts/mcp/skills/shrine-mcp'
NOTE = ROOT / '.shrine.json'       # the checkout's world: {directory, port}
MOUNTS = ['mcp', 'probe', 'explorer', 'mesa', 'scope']


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--world', type=Path, default=None, metavar='DIR', help='the directory the world is kept in (default: the one .shrine.json names)')
    parser.add_argument('--hand', action='append', default=None, metavar='"NAME ARGS"', help='a hand for a new world (default: clock --timezone UTC)')
    parser.add_argument('--port', type=int, default=None, help='the port of a new world (default 8300)')
    args = parser.parse_args()
    if args.world is None and not NOTE.is_file():
        parser.error('no world yet: pass --world DIR the first time')
    note = json.loads(NOTE.read_text()) if NOTE.is_file() else {}
    world = (args.world or Path(note['directory'])).resolve()
    kept = json.loads((world / 'world.json').read_text()) if (world / 'world.json').is_file() else None
    # A world's descriptor keeps its node, mounts and hands, not its port: the checkout's note keeps that.
    noted = note.get('port') if note.get('directory') == str(world) else None
    port, node = args.port or noted or 8300, (kept['node'] if kept else '0x11')
    url = f'http://127.0.0.1:{port}'
    NOTE.write_text(json.dumps({'directory': str(world), 'port': port}) + '\n')
    command = [sys.executable, str(ROOT / 'x/eden'), '--extras-root', str(ROOT / 'extras'), '--world', str(world), '--port', str(port)]
    if not kept:   # a kept world boots as it was; x/eden refuses a mount or a hand that differs
        command += sum((['--mount', m] for m in MOUNTS), []) + sum((['--hand', h] for h in args.hand or ['clock --timezone UTC']), [])
    eden = subprocess.Popen(command, stdout=subprocess.PIPE, text=True, start_new_session=True)
    try:
        for line in eden.stdout:
            print(line, end='', flush=True)
            if line.startswith('Eden: '):
                # The door lets in only a session. The world left its first one in a file for whoever is at
                # the machine: the link below hands it to a browser, and an agent sends it as a bearer token.
                left = world / 'src' / 'io' / 'mesa' / 'out' / 'session'
                way = (f'Enter: {url}/door#{left.read_text().strip()}\nSession for an agent (Authorization: Bearer): in {left}'
                       if left.is_file() and left.stat().st_size else 'This world left no session: it has no door of its own (no mesa mount) or nobody has claimed it.')
                print(f'\nWorld: {url}\n{way}\nMCP: {url}/mcp\nLive page: {url}/live?views=/{node}/user\nSkill: {SKILL}\nCtrl-C stops the world and its hands.\n', flush=True)
        return eden.wait()
    except KeyboardInterrupt:
        os.killpg(eden.pid, signal.SIGTERM)
        eden.wait()
        print('Stopped.', flush=True)
        return 130


if __name__ == '__main__':
    raise SystemExit(main())
