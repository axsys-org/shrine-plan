#!/usr/bin/env python3
"""The easy setup: one command from a checkout to a running world.

    python3 x/setup --world DIR [--port N]
    python3 x/setup

Creates a world with mcp, probe and explorer, or resumes the selection kept at
DIR. Waits for readiness and prints the world, MCP and live-page URLs plus the
harness guide. Ctrl-C stops the process; the native world remains saved.
Records only its directory and port in .shrine.json for the next invocation.
"""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
GUIDE = ROOT / 'extras/HARNESS.md'
NOTE = ROOT / '.shrine.json'       # the checkout's world: {directory, port}
MOUNTS = ['mcp', 'probe', 'explorer']


def main():
    def terminate(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--world', type=Path, default=None, metavar='DIR', help='the directory the world is kept in (default: the one .shrine.json names)')
    parser.add_argument('--port', type=int, default=None, help='the port of a new world (default 8300)')
    args = parser.parse_args()
    if args.world is None and not NOTE.is_file():
        parser.error('no world yet: pass --world DIR the first time')
    world = (args.world or Path(json.loads(NOTE.read_text())['directory'])).resolve()
    kept = json.loads((world / 'world.json').read_text()) if (world / 'world.json').is_file() else None
    remembered = json.loads(NOTE.read_text()) if NOTE.is_file() else {}
    same = remembered.get('directory') == str(world)
    port = args.port if args.port is not None else (remembered.get('port', 8300) if same else 8300)
    node = kept['node'] if kept else '0x11'
    url = f'http://127.0.0.1:{port}'
    command = [sys.executable, str(ROOT / 'x/eden'), '--world', str(world)]
    command += ['--port', str(port), '--node', node]
    if not kept:
        command += ['--extras-root', str(ROOT / 'extras')]
        command += sum((['--mount', m] for m in MOUNTS), [])
    eden = subprocess.Popen(command, stdout=subprocess.PIPE, text=True, start_new_session=True)
    try:
        for line in eden.stdout:
            print(line, end='', flush=True)
            if line.startswith('Eden: '):
                NOTE.write_text(json.dumps({'directory': str(world), 'port': port}) + '\n')
                print(f'\nWorld: {url}\nMCP: {url}/mcp\nLive page: {url}/live?views=/{node}/user\nHarness guide: {GUIDE}\nCtrl-C stops the world.\n', flush=True)
        return eden.wait()
    except KeyboardInterrupt:
        print('Stopped.', flush=True)
        return 130
    finally:
        if eden.poll() is None:
            os.killpg(eden.pid, signal.SIGTERM)
            try:
                eden.wait(timeout=20)
            except subprocess.TimeoutExpired:
                os.killpg(eden.pid, signal.SIGKILL)
                eden.wait()


if __name__ == '__main__':
    raise SystemExit(main())
