#!/usr/bin/env python3
"""Start the MCP/probe/explorer selection using Eden's native snapshot launcher.

    python3 x/setup --snapshot DIR [--port N]
    python3 x/setup

Without --snapshot, the invocation is disposable. No checkout settings or
second lifecycle are maintained; x/eden owns startup and shutdown.
"""
import argparse
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
MOUNTS = ['mcp', 'probe', 'explorer']


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--snapshot', type=Path, metavar='DIR', help='native arena directory to create or resume')
    parser.add_argument('--port', type=int, default=8300)
    args = parser.parse_args()
    command = [sys.executable, str(ROOT / 'x/eden'), '--port', str(args.port)]
    command += sum((['--mount', m] for m in MOUNTS), [])
    if args.snapshot:
        command += ['--snapshot', str(args.snapshot)]
    os.execv(sys.executable, command)


if __name__ == '__main__':
    raise SystemExit(main())
