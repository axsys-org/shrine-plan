# A live lain serve as an agent-friendly incremental build loop.
#
# Same lifecycle as x/lain, but fully isolated under run/lain-dev/
# (its own repl staging and serve snapshot — it never touches the
# root snap/ that x/foil resumes from, nor run/lain), and driven
# through a fifo instead of a terminal, so an editing session can do:
#
#   x/lain-dev start [--fresh] [PORT]   # launch (resumes serve snap if present)
#   x/lain-dev wait [SECS]              # block until HTTP is up (fresh boot: minutes)
#   x/lain-dev sync                     # rebuild whatever changed under src/foil
#   x/lain-dev sync <mod>               # force apps/nenex/main etc.
#   x/lain-dev install <name> [/root]    # install an app (warp /kook/install)
#   x/lain-dev plan                     # what a sync would rebuild, dry
#   x/lain-dev req '<json>'             # raw wire request (doc/buddy-wire.md)
#   x/lain-dev wire                     # print the wire port (for foil-nvim)
#   x/lain-dev log [N]                  # last N serve log lines
#   x/lain-dev status | stop
#
# sync/plan ride the serve's WIRE PORT (HTTP port + 1, the buddy-wire
# protocol): one JSON request per connection, a structured JSON reply
# — no log scraping, no polling.  Exit nonzero when a module FAILED
# or a write was refused, with the report and located diagnostics on
# stdout.  The serve keeps serving HTTP while it rebuilds; curl the
# port to check behavior (x/lain: browse /ns).  The same wire port
# serves describe/complete/eval/doctest — point foil-nvim at it
# (editor/foil-nvim: setup{ port = <wire> }) and `req` at anything
# else.
#
# stop closes the fifo's write end first: the serve sees stdin EOF;
# the terminal stops but the wire and HTTP keep serving until the
# process is killed (stop does that too), and the next start resumes.

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEV="$ROOT/run/lain-dev"
CTL="$DEV/ctl"
LOG="$DEV/serve.log"
PIDF="$DEV/pid"
HPIDF="$DEV/holder-pid"
PORTF="$DEV/port"

die () { echo "x/lain-dev: $*" >&2; exit 1; }

wisp_bin () {
  if command -v wisp >/dev/null 2>&1; then command -v wisp; return; fi
  if [ -s "$DEV/wispbin" ] && [ -x "$(cat "$DEV/wispbin")" ]; then cat "$DEV/wispbin"; return; fi
  w="$(nix develop "$ROOT" -c which wisp 2>/dev/null | tail -1 || true)"
  [ -n "$w" ] && [ -x "$w" ] || die "no wisp on PATH, and nix develop lookup failed"
  mkdir -p "$DEV"; printf '%s\n' "$w" > "$DEV/wispbin"
  printf '%s\n' "$w"
}

running () { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

# Anyone listening on the port (or its wire twin)?  An orphaned serve
# — one whose pid file was lost, e.g. an rm -rf run/lain-dev while it
# ran — keeps both ports, the new serve's bind fails NON-fatally
# ("bind/listen failed" in the log, boot completes deaf), and every
# request silently reaches the old world: stale evals/doctests/faces
# with no error anywhere.  Refuse to start into that.
port_holders () {
  lsof -nP -iTCP:"$1" -iTCP:"$(( $1 + 1 ))" -sTCP:LISTEN 2>/dev/null | tail -n +2
}

log_len () { if [ -f "$LOG" ]; then wc -l < "$LOG"; else echo 0; fi }

delta () { tail -n +"$(( $1 + 1 ))" "$LOG"; }

# Stage the pristine repl snapshot in run/lain-dev/root (the shared
# x/stage-lib recipe), once per missing/markerless snap.
. "$ROOT/x/stage-lib"
stage () {
  mkdir -p "$DEV/root"
  if [ -e "$DEV/root/snap/data.mdb" ] && [ -e "$DEV/root/snap/.repl-staged" ]; then return 0; fi
  echo "x/lain-dev: staging repl snapshot (one-time boot, minutes)" >&2
  cd "$DEV/root"
  rm -rf snap
  stage_repl "$WISP" "$ROOT" --app-todo --p2
  touch snap/.repl-staged
  cd "$ROOT"
}

start () {
  fresh=""; port=""
  for a in "$@"; do
    case "$a" in
      --fresh) fresh=1 ;;
      *) port="$a" ;;
    esac
  done
  running && die "already running (pid $(cat "$PIDF"), port $(cat "$PORTF" 2>/dev/null || echo '?')) — x/lain-dev stop first"
  WISP="$(wisp_bin)"
  mkdir -p "$DEV"
  stage
  if [ -n "$fresh" ] || [ ! -e "$DEV/serve/snap/data.mdb" ]; then
    fresh=1
    port="${port:-8100}"
    rm -rf "$DEV/serve"
    mkdir -p "$DEV/serve/snap"
    cp -c "$DEV/root/snap/data.mdb" "$DEV/serve/snap/" 2>/dev/null || cp "$DEV/root/snap/data.mdb" "$DEV/serve/snap/"
    cp -c "$DEV/root/snap/pins.pack" "$DEV/serve/snap/" 2>/dev/null || cp "$DEV/root/snap/pins.pack" "$DEV/serve/snap/"
    echo "$port" > "$PORTF"
  else
    # a resumed serve keeps the port baked into its snapshot
    baked="$(cat "$PORTF" 2>/dev/null || echo '')"
    [ -z "$port" ] || [ "$port" = "$baked" ] || die "resume keeps baked port $baked; use --fresh to change it"
    port="$baked"
    [ -n "$port" ] || die "no recorded port for the serve snapshot; use --fresh"
  fi
  holders="$(port_holders "$port")"
  if [ -n "$holders" ]; then
    echo "x/lain-dev: port $port (or wire $((port + 1))) is already taken:" >&2
    echo "$holders" >&2
    die "kill the listener first (an orphaned serve?) — a boot into a taken port completes silently deaf"
  fi
  rm -f "$CTL"; mkfifo "$CTL"
  : > "$LOG"
  # LAIN_DEV_WISP_FLAGS: extra wisp flags for this serve, e.g.
  #   LAIN_DEV_WISP_FLAGS="--profile-json $PWD/run/lain-dev/profile.json"
  # (the profile is written when the serve EXITS CLEANLY — quit it
  # with `printf 'q\n' > run/lain-dev/ctl`, not stop's kill)
  ( cd "$DEV/serve" && exec "$WISP" ${LAIN_DEV_WISP_FLAGS:-} --file-root "$ROOT/src" snap root _ ) < "$CTL" >> "$LOG" 2>&1 &
  echo $! > "$PIDF"
  # hold the fifo's write end open: EOF on stdin makes the serve park
  tail -f /dev/null > "$CTL" 2>/dev/null &
  echo $! > "$HPIDF"
  if [ -n "$fresh" ]; then
    # boot forms first (the x/lain fresh recipe); the fifo stays open
    # for CLI lines afterwards
    # the OpenRouter credential rides the boot form (run-lain-serve's
    # key argument) — export OPENROUTER_API_KEY before `start` to let
    # the chat app authenticate; absent, calls go out unauthenticated
    printf '(#bind std (#module std))\n(#import std)\n(#bind helm-run (#module helm-run))\n(helm-run:run-lain-serve %s "%s")\n' "$port" "${OPENROUTER_API_KEY:-}" > "$CTL"
    echo "x/lain-dev: fresh serve booting on port $port (compiles the world — minutes); x/lain-dev wait" >&2
  else
    echo "x/lain-dev: resuming serve on port $port; x/lain-dev wait" >&2
  fi
}

wait_up () {
  secs="${1:-900}"
  port="$(cat "$PORTF" 2>/dev/null || echo '')"
  [ -n "$port" ] || die "no serve recorded; x/lain-dev start"
  i=0
  while [ "$i" -lt "$secs" ]; do
    if grep -aq 'bind/listen failed' "$LOG" 2>/dev/null; then
      echo "x/lain-dev: the serve could NOT bind port $port or $((port + 1)) — another" >&2
      echo "process holds it, and anything answering HTTP there is the OLD world:" >&2
      port_holders "$port" >&2
      exit 1
    fi
    if curl -fsS -o /dev/null --max-time 2 "http://localhost:$port/ns" 2>/dev/null; then
      echo "up: http://localhost:$port/ns (log: run/lain-dev/serve.log)"
      return 0
    fi
    if ! running; then
      echo "x/lain-dev: serve died during boot; last log lines:" >&2
      tail -30 "$LOG" >&2
      exit 1
    fi
    sleep 1; i=$((i+1))
  done
  die "not up after ${secs}s; see run/lain-dev/serve.log"
}

wire_port () {
  port="$(cat "$PORTF" 2>/dev/null || echo '')"
  [ -n "$port" ] || die "no serve recorded; x/lain-dev start"
  echo $((port + 1))
}

# One wire request, one JSON reply (the serve closes the connection).
# Long timeout: a sync after a sept edit rebuilds the world below it.
wire_req () {
  running || die "not running; x/lain-dev start"
  wp="$(wire_port)"
  resp="$(printf '%s\n' "$1" | nc -w 1800 localhost "$wp" || true)"
  [ -n "$resp" ] || die "no reply on wire port $wp — mid-boot? (x/lain-dev wait, then retry)"
  printf '%s\n' "$resp"
}

# sync/plan over the wire: structured reply, report on stdout, exit 1
# on a failed module or refused write.
sync () {
  if [ "$#" -gt 0 ]; then
    mods=""
    for m in "$@"; do mods="$mods${mods:+,}\"$m\""; done
    req="{\"op\":\"sync\",\"modules\":[$mods]}"
  else
    req='{"op":"sync"}'
  fi
  wire_req "$req" | python3 -c '
import json,sys
r=json.load(sys.stdin)
if "report" in r: print(r["report"])
for d in r.get("diags") or []:
    print("  %s:%s:%s  %s" % (d.get("module","?"), d.get("line",0), d.get("col",0), d.get("msg","")))
if not r.get("ok"):
    if r.get("error"): print(r["error"], file=sys.stderr)
    sys.exit(1)
'
}

# install <name> [root]: warp /kook/install at the root (default:
# the app-roots table, else /app/<name>), then zoo registration and
# (for chat) hand provisioning, all over the wire.
install () {
  [ "$#" -ge 1 ] || die "usage: x/lain-dev install <name> [/root/path]"
  if [ "$#" -ge 2 ]; then
    req="{\"op\":\"install\",\"name\":\"$1\",\"root\":\"$2\"}"
  else
    req="{\"op\":\"install\",\"name\":\"$1\"}"
  fi
  wire_req "$req" | python3 -c '
import json,sys
r=json.load(sys.stdin)
for row in r.get("report") or []: print(row)
if not r.get("ok"):
    if r.get("error"): print(r["error"], file=sys.stderr)
    sys.exit(1)
'
}

plan () {
  wire_req '{"op":"plan"}' | python3 -c '
import json,sys
r=json.load(sys.stdin)
if not r.get("ok"):
    print(r.get("error","plan failed"), file=sys.stderr); sys.exit(1)
ch=r.get("changed") or []; rb=r.get("rebuild") or []
if not ch: print("nothing to sync — the namespace matches foil/")
else:
    print("changed:  " + " ".join(ch))
    print("rebuild:  " + " ".join(rb))
'
}

status () {
  if running; then
    p="$(cat "$PORTF" 2>/dev/null || echo '?')"
    w="?"; [ "$p" != "?" ] && w=$((p + 1))
    echo "running: pid $(cat "$PIDF"), port $p (wire $w), log run/lain-dev/serve.log"
  else
    echo "not running"
    if [ -e "$DEV/serve/snap/data.mdb" ]; then echo "serve snapshot present — plain start resumes it"; fi
  fi
}

stop () {
  # close the write end first: stdin EOF parks the serve (Save + exit)
  if [ -f "$HPIDF" ]; then kill "$(cat "$HPIDF")" 2>/dev/null || true; rm -f "$HPIDF"; fi
  if [ -f "$PIDF" ]; then
    p="$(cat "$PIDF")"
    i=0
    while [ "$i" -lt 15 ] && kill -0 "$p" 2>/dev/null; do sleep 1; i=$((i+1)); done
    if kill -0 "$p" 2>/dev/null; then
      echo "x/lain-dev: serve did not park in 15s; killing" >&2
      kill -TERM "$p" 2>/dev/null || true
      sleep 2
      kill -KILL "$p" 2>/dev/null || true
    fi
    rm -f "$PIDF"
  fi
  rm -f "$CTL"
  p="$(cat "$PORTF" 2>/dev/null || echo '')"
  if [ -n "$p" ] && [ -n "$(port_holders "$p")" ]; then
    echo "x/lain-dev: WARNING — port $p (or wire) is still held after stop:" >&2
    port_holders "$p" >&2
    echo "x/lain-dev: an orphaned serve; kill it before the next start" >&2
  fi
  echo "stopped"
}

cmd="${1:-status}"; shift 2>/dev/null || true
case "$cmd" in
  start)  start "$@" ;;
  wait)   wait_up "$@" ;;
  sync)   sync "$@" ;;
  install) install "$@" ;;
  plan)   plan "$@" ;;
  req)    [ "$#" -ge 1 ] || die "usage: x/lain-dev req '<json>'"; wire_req "$1" ;;
  wire)   wire_port ;;
  log)    tail -n "${1:-40}" "$LOG" ;;
  status) status ;;
  stop)   stop ;;
  *) die "unknown command: $cmd (start|wait|sync|install|plan|req|wire|log|status|stop)" ;;
esac
