#!/usr/bin/env python3
"""An invitation, claimed, on one machine: a community and the world prepared for one of its places.

Boots a community world (0x61) and, once its foot has minted the invitation for a place, a second world
under the minted name. Each has the mcp, mesa and scope mounts, and nothing outside tells either anything
but what is written through its own door. It checks that the place asks for its invitation and takes the
name; that the prepared world claims itself with the invitation's secret and is silent until it has; that
the community takes the claim from a world it does not yet hear, gives that world an address from the
introduction its custody signed, fills the place and lists it; and that the two then publish to each other.

Three parts of the finished system are played by this script, and each row that leans on one says so:

    the door   The secret of an invitation is left by the foot as a file for the door to hand over once,
               and reaches the claiming world's foot as a file its door wrote. No door route exists yet,
               so the script moves the file between the two worlds' file roots.
    the host   A prepared world is started by a host's run foot with its founding and first statement.
               The script starts the process and writes them through the new world's door.
    a second   Joining with a world one already has needs a world founded under its own name, which the
    invitee    launcher cannot start yet. The foot's suite covers it (tests/mesa_foot, case joining).

    x/check-community [--keep] [--base-port 8461]

Exit 0 when every row passes. Run it on the build machine, never beside another heavy job.
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def spell(number):
    """A world's number as its name is spelled: 0x and its bytes, lowest first."""
    return '0x' + number.to_bytes((number.bit_length() + 7) // 8, 'little').hex()


def number_of(spelling):
    return int.from_bytes(bytes.fromhex(spelling[2:]), 'little')


class World:
    def __init__(self, node, http, mesa, home):
        self.node, self.http, self.mesa, self.home = node, http, mesa, home
        self.process = None
        self.count = 0

    def start(self, timeout):
        self.home.mkdir(parents=True, exist_ok=True)
        self.log = (self.home / 'eden.log').open('a')
        self.process = subprocess.Popen(
            [sys.executable, str(ROOT / 'x/eden'), '--node', self.node, '--port', str(self.http),
             '--world', str(self.home / 'world'), '--mount', 'mcp', '--mount', 'mesa', '--mount', 'scope',
             '--extras-root', str(ROOT / 'extras'), '--startup-timeout', str(timeout)],
            stdout=self.log, stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.process.poll() is not None:
                raise RuntimeError(f'{self.node} exited while starting; see {self.home}/eden.log')
            try:
                self.tool('read', path='/' + self.node + '/io/mesa', care='x')
                return
            except Exception:
                time.sleep(2)
        raise RuntimeError(f'{self.node} did not start in {timeout}s; see {self.home}/eden.log')

    def stop(self):
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(timeout=60)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
        self.process = None

    def tool(self, name, **arguments):
        self.count += 1
        body = json.dumps(dict(jsonrpc='2.0', id=self.count, method='tools/call',
                               params={'name': 'mcp/' + name, 'arguments': arguments})).encode()
        request = urllib.request.Request(f'http://127.0.0.1:{self.http}/mcp', body,
                                         {'Content-Type': 'application/json'})
        reply = json.load(urllib.request.urlopen(request, timeout=60))
        result = reply['result']
        if result.get('isError'):
            raise RuntimeError(json.dumps(result)[:400])
        return result.get('structuredContent', result)

    def write(self, *records):
        return self.tool('write', records=list(records))

    def read(self, path, care='x'):
        try:
            return self.tool('read', path=path, care=care)
        except Exception as error:
            return {'error': str(error)}

    def slots(self, path):
        """A record's slots as the door gives them, by bare name."""
        properties = self.read(path).get('properties') or {}
        return {name.lstrip('/'): value for name, value in properties.items()}

    def number(self, path, slot):
        value = self.slots(path).get(slot)
        try:
            return int(str(value))
        except (TypeError, ValueError):
            return 0

    def files(self):
        """The world's file root. Only the stand-in for the door looks here."""
        return self.home / 'world' / 'src'


def numbers(slots):
    return {name: int(str(value)) for name, value in slots.items()}


def until(condition, seconds=120):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if condition():
            return True
        time.sleep(1)
    return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--keep', action='store_true', help='keep the world directories')
    parser.add_argument('--base-port', type=int, default=8461)
    parser.add_argument('--timeout', type=int, default=1800)
    args = parser.parse_args()
    base = Path(tempfile.mkdtemp(prefix='shrine-community-'))
    c = World('0x61', args.base_port, args.base_port + 1000, base / 'c')
    n = None
    rows = []
    place = '/0x61/app/community/places/1'

    def row(name, passed, detail=''):
        rows.append(passed)
        print(('PASS  ' if passed else 'FAIL  ') + name + ('' if passed else '   ' + str(detail)[:600]), flush=True)

    try:
        c.start(args.timeout)
        until(lambda: c.number('/0x61/io/mesa', 'key') > 0, 180)
        c_key = c.number('/0x61/io/mesa', 'key')
        c.write(dict(path='/0x61/io/mesa', action='poke', slots={'port': c.mesa}),
                dict(path='/0x61/io/scope/community',
                     slots={'root': dict(type='reference', path='/0x61/app/community', care='x', case=0)}),
                dict(path=place, slots={'lede': 'a seat for Alice', 'id': 1}))
        row('a place with a number asks for its invitation, the foot mints it, and the place takes the name',
            until(lambda: c.number(place, 'name') > 0, 180), c.read(place))
        name = c.number(place, 'name')
        node = spell(name)
        card = '/0x61/io/mesa/' + node
        row("the community keeps the minted name's card, with its first statement and no address",
            c.number(card, 'seq') == 1 and c.number(card, 'port') == 0, c.read(card))

        c.write(dict(path='/0x61/io/mesa/ask/link', slots={'want': 'link', 'id': 1}))
        left = c.files() / 'io' / 'mesa' / 'out' / '1'
        row("[the door: played by this script] the invitation's secret is left as a file for the door, 32 bytes",
            until(lambda: c.number('/0x61/io/mesa/ask/link', 'done') == 1 and left.exists()
                  and left.stat().st_size == 32, 60), c.read('/0x61/io/mesa/ask/link'))
        secret = left.read_bytes() if left.exists() else b''
        told = json.dumps([c.read('/0x61/io/mesa/ask/link'), c.read('/0x61/io/mesa/ask/invite/1'), c.read(place)])
        row('and is in no record: not on the ask, the place or the invitation',
            len(secret) == 32 and str(int.from_bytes(secret, 'little')) not in told
            and str(int.from_bytes(secret + b'\x01', 'little')) not in told, told)

        n = World(node, args.base_port + 1, args.base_port + 1001, base / 'n')
        n.start(args.timeout)
        home = '/' + node + '/io/mesa'
        until(lambda: n.number(home, 'key') > 0, 180)
        own_key = n.number(home, 'key')
        standing = numbers({k: v for k, v in c.slots(card).items()
                            if k in ('seq', 'last', 'life', 'rift', 'key', 'custody')})
        n.write(dict(path=home + '/pass', slots=numbers(c.slots(card + '/pass'))),
                dict(path=home + '/pass/1', slots=numbers(c.slots(card + '/pass/1'))))
        n.write(dict(path=home, action='poke', slots=dict(standing, port=n.mesa)),
                dict(path=home + '/0x61', slots={'key': c_key, 'host': '127.0.0.1', 'port': c.mesa}))
        row('[the host: played by this script] the prepared world holds its founding and first statement, '
            'which name a key that is not its own',
            n.number(home, 'seq') == 1 and n.number(home, 'key') == c_key and own_key not in (0, c_key),
            n.read(home))

        handed = n.files() / 'io' / 'mesa' / 'in'
        handed.mkdir(parents=True, exist_ok=True)
        (handed / '1').write_bytes(secret)
        n.write(dict(path=home + '/ask/claim', slots={'want': 'claim', 'name': name, 'handed': 1}))
        row('[the door: played by this script] handed the secret as a file, the prepared world claims itself',
            until(lambda: n.number(home, 'seq') == 2, 120), [n.read(home), n.read(home + '/ask/claim')])
        row('custody and the live key are then its own',
            n.number(home, 'key') == own_key and n.number(home, 'custody') not in (0, standing.get('custody')),
            n.read(home))
        row("the secret's file is emptied once the claim is made, and the ask says so",
            until(lambda: n.number(home + '/ask/claim', 'spent') == 1 and (handed / '1').stat().st_size == 0, 60),
            n.read(home + '/ask/claim'))

        n.write(dict(path=home + '/ask/bring',
                     slots={'want': 'bring', 'to': number_of('0x61'), 'host': '127.0.0.1', 'port': n.mesa}))
        row('the claim reaches the community from a world it does not hear',
            until(lambda: c.number(card, 'seq') == 2, 180), c.read(card))
        row('and the introduction its custody signed gives its card an address',
            until(lambda: c.number(card, 'port') == n.mesa, 180), c.read(card))
        row('the place is filled by the name that was claimed',
            until(lambda: c.number(place, 'world') == name, 120), c.read(place))
        entry = '/0x61/app/community/catalog/' + node
        row('and is listed at once', until(lambda: c.number(entry, 'world') == name, 120), c.read(entry))

        c.write(dict(path='/0x61/our/' + node + '/welcome', slots={'value': 1}))
        row('what the community publishes to its new member arrives, sealed for it',
            until(lambda: n.number('/' + node + '/her/0x61/welcome', 'value') == 1, 180),
            n.read('/' + node + '/her/0x61/welcome'))
        n.write(dict(path='/' + node + '/our/0x61', slots={'title': 'for the community'}),
                dict(path='/' + node + '/our/0x61/hello', slots={'value': 2}))
        row('and what the member publishes to the community arrives',
            until(lambda: c.number('/0x61/her/' + node + '/hello', 'value') == 2, 180),
            c.read('/0x61/her/' + node + '/hello'))
    except Exception as error:
        row('the run completed', False, repr(error))
    finally:
        c.stop()
        if n:
            n.stop()
        if args.keep or not all(rows):
            print(f'worlds kept at {base}', flush=True)
        else:
            subprocess.run(['rm', '-rf', str(base)])
    print(f'{sum(rows)} of {len(rows)} rows passed; three parts are played by this script (the door twice, '
          'the host once), so those rows do not count toward the finish line', flush=True)
    return 0 if rows and all(rows) else 1


if __name__ == '__main__':
    sys.exit(main())
