#!/usr/bin/env python3
"""Compare full Foil expression checking with derivatives generated by generic ILC."""
import argparse
from collections import Counter, defaultdict
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import statistics
import tempfile

import test_runner as runner


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wisp', default=os.environ.get('WISP') or shutil.which('wisp'))
    parser.add_argument('--samples', type=int, default=5)
    parser.add_argument('--updates', type=int, default=8)
    parser.add_argument('--depths', default='0,1,3')
    parser.add_argument('--timeout', type=float, default=300)
    parser.add_argument('--no-audit', action='store_true')
    args = parser.parse_args()
    depths = sorted(set(map(int, args.depths.split(','))))
    if min(args.samples, args.updates, args.timeout) <= 0 or not depths or min(depths) < 0 or max(depths) > 8:
        parser.error('positive samples/updates/timeout and depths in 0..8 required')
    if not args.wisp or not os.access(args.wisp, os.X_OK):
        parser.error('set WISP=/path/to/wisp or use --wisp')
    wisp = str(Path(args.wisp).resolve())
    template = runner.stage(wisp, False, args.timeout)
    root = Path(tempfile.mkdtemp(prefix='ilc-typecheck-', dir=runner.ROOT / '.check'))
    runner.copy_template(template, root / 'snap')
    shutil.copytree(runner.ROOT / 'src', root / 'src')
    source = ('(#bind bench (#module ilc-typecheck-bench))\n'
              f'(bench:run {args.samples} {args.updates} [{" ".join(map(str, depths))}])\n')
    if not args.no_audit:
        source += '(bench:audit-run 0)\n'
    (root / 'input.rvr').write_text(source)
    print('Benchmark artifacts: ' + str(root), flush=True)
    code, completed, seconds = runner.run_process(
        [wisp, '--file-root', str(root / 'src'), 'snap', 'root', '_'], root, source, args.timeout)
    log = (root / 'out.log').read_text(errors='replace')
    if (code or not completed or runner.ERROR.search(log) or '"TYPECHECK-BENCH-DONE"' not in log
            or (not args.no_audit and any(marker not in log for marker in ['"TYPECHECK-AUDIT-DONE"', '"TYPECHECK-STAGED-AUDIT-DONE"']))):
        raise RuntimeError(f'benchmark failed (exit={code}, complete={completed}): {root}/out.log')
    records, keys = [], set()
    for match in re.finditer(r'^\("TYPECHECK-BENCH"\s+' + r'\s+'.join([runner.ATOM] * 6) + r'\)', log, re.M):
        depth, mode, sample, units, ns, checksum = [runner.decode_atom(x) for x in match.groups()]
        row = dict(depth=int(depth), mode=mode, sample=int(sample), units=int(units), ns=int(ns), checksum=int(checksum))
        key = row['depth'], mode, row['sample']
        if key in keys or row['ns'] <= 0 or row['units'] != args.updates or row['checksum'] != args.updates:
            raise RuntimeError(f'invalid timing: {row}')
        records.append(row)
        keys.add(key)
    modes = ['full', 'raw-ilc', 'structural-ilc', 'staged-ilc']
    expected = {(d, m, i) for d in depths for m in modes for i in range(args.samples)}
    if keys != expected:
        raise RuntimeError(f'incomplete timings: {len(keys)}/{len(expected)} records')
    by_key = {(r['depth'], r['mode'], r['sample']): r for r in records}
    summary = {}
    for d in depths:
        timings = {}
        for m in modes:
            values = [by_key[d, m, i]['ns'] / args.updates for i in range(args.samples)]
            timings[m] = dict(median_ns=statistics.median(values), min_ns=min(values), max_ns=max(values))
        summary[d] = dict(leaves=2**d, applications=2**d-1, timings=timings,
            raw_slowdown=timings['raw-ilc']['median_ns']/timings['full']['median_ns'],
            structural_slowdown=timings['structural-ilc']['median_ns']/timings['full']['median_ns'],
            staged_slowdown=timings['staged-ilc']['median_ns']/timings['full']['median_ns'],
            staging_speedup=timings['structural-ilc']['median_ns']/timings['staged-ilc']['median_ns'])
    audit = defaultdict(Counter)
    for match in re.finditer(r'^\("ILC-AUDIT"\s+' + r'\s+'.join([runner.ATOM] * 2) + r'\)', log, re.M):
        kind, name = [runner.decode_atom(x) for x in match.groups()]
        audit[kind][name] += 1
    if not args.no_audit and not all(audit['law'][name] for name in ['elab-value-go', 'subtype-go']):
        raise RuntimeError('audit did not observe differentiation through the expression checker and subtype checker')
    staged_audit = defaultdict(Counter)
    for match in re.finditer(r'^\("STAGED-ILC-AUDIT"\s+' + r'\s+'.join([runner.ATOM] * 2) + r'\)', log, re.M):
        kind, name = [runner.decode_atom(x) for x in match.groups()]
        staged_audit[kind][name] += 1
    if not args.no_audit and not staged_audit:
        raise RuntimeError('staged dispatch audit is missing')
    report = dict(timestamp_utc=datetime.now(timezone.utc).isoformat(),
        host=platform.platform(), machine=platform.machine(), runtime=wisp,
        runtime_sha256=hashlib.sha256(Path(wisp).read_bytes()).hexdigest(),
        samples=args.samples, updates=args.updates, wall_seconds=seconds, artifact_directory=str(root),
        sources={p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in (root/'src/reaver').glob('*.rvr')},
        workload='Production elab-value, including cref expansion and elab-value-go. Balanced add '
                 'applications with 2^depth literal leaves. Each update changes the leftmost literal '
                 'to a fresh value using a sparse product delta. Input compiler/environment stays fixed. '
                 'No module cache, unchanged-input memo or checker-specific derivative rules.',
        scope='In-VM timings include source-delta application and full checking or generated derivative '
              'plus application to retained output. Complete [compiler-state, typed-IR] outputs forced. '
              'Fixture creation, initial checks, derivative generation/warming and exact validation '
              'excluded. Each trial starts from the same input/output. Modes reverse on alternate samples. '
              'Raw uses no rules; structural adds only generic field/primitive/collection rules. Staged uses '
              'the same rules with staged callback derivatives and compile-time dispatch for fixed callees. '
              'Neither derivative mode retains primal intermediate computations. Audit runs '
              'separately after all timed work on one add application, with printing enabled.',
        summary=summary, records=records,
        audit={k: dict(sorted(v.items())) for k,v in audit.items()},
        audit_totals={k:sum(v.values()) for k,v in audit.items()},
        staged_audit={k: dict(sorted(v.items())) for k,v in staged_audit.items()},
        staged_audit_totals={k:sum(v.values()) for k,v in staged_audit.items()})
    (root/'results.json').write_text(json.dumps(report, indent=2)+'\n')
    print('leaves    full ms     raw ILC ms     structural ILC ms    staged ILC ms    staging speedup    staged/full')
    for s in summary.values():
        t=s['timings']
        print(f'{s["leaves"]:6} '+ ' '.join(f'{t[m]["median_ns"]/1e6:15.4f}' for m in modes)
              +f' {s["staging_speedup"]:15.2f}x {s["staged_slowdown"]:14.2f}x')
    print('Baseline dispatch audit: '+json.dumps(report['audit_totals']))
    print('Staged dispatch audit: '+json.dumps(report['staged_audit_totals']))
    print('Report: '+str(root/'results.json'))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, RuntimeError, OSError) as error:
        raise SystemExit(str(error))
