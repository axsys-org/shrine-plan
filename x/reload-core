#!/usr/bin/env python3
"""Reload non-sys Foil code and selected mounts in a live Eden world."""
import argparse
import json
from mount_tools import wire_request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--port', type=int, default=8679)
parser.add_argument('--timeout', type=float, default=2400)
args = parser.parse_args()
if not 1 <= args.port <= 65535 or args.timeout <= 0:
    parser.error('port must be 1..65535 and timeout must be positive')
try:
    result = wire_request({'op': 'core/reload'}, args.port, args.timeout)
except (OSError, ValueError) as error:
    result = {'ok': False, 'error': str(error)}
print(json.dumps(result, indent=2))
raise SystemExit(0 if result.get('ok') else 1)
