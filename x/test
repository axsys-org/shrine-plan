# If you have already started a Reaver session, this will resume from
# snapshot.
#
# Otherwise, it will build reaver, load the standard library, exit,
# and then *then* resume from the new snapshot created through this.

set -ex




reset () {
	wisp --file-root ./src ./src/plan reaver main
	# ./wisp --file-root src/ src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _ # run from snapshot
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}

# Loading certain module combinations in a single wisp session corrupts
# later evaluation (deterministic, order-dependent assert failures in
# unrelated modules — see doc/wisp-session-leak.md).  Splitting the
# load across sessions — the snapshot boundary resets whatever leaks —
# avoids it, so the quip chain (print, bits, parse, apollo, ...) gets
# its own session before the foil modules load.
load_quip () {
    repl <<EOF
(#bind quip (#module quip))
EOF
}


# The staged snapshot persists across runs: the store is LMDB
# (snap/data.mdb), and module caches are content-keyed, so a rerun
# resumes the staged repl — including any module thunks earlier
# sessions already forced (the top-of-loop save persists them).
# Changed sources reload; only `x/test --reset <mod>` rebuilds the
# staging from scratch.
if [ "${1:-}" = "--reset" ]; then
  shift
  rm -rf snap
fi

if [ ! -e snap/data.mdb ]
then reset; load_stdlib; load_quip
fi

repl <<EOF
::*$1
EOF
