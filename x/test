# If you have already started a Reaver session, this will resume from
# snapshot.
#
# Otherwise, it will build reaver, load the standard library, exit,
# and then *then* resume from the new snapshot created through this.

set -ex



reset () {
	wisp --file-root ./src ./src/plan reaver main
	# ./wisp --file-root src/ src/plan reaver main
}

repl () {
	wisp --file-root src/ snap root _ # run from snapshot
}

load_stdlib () {
    repl <<EOF
(#bind std (#module std))
(#import std)
::*app-todo
::*rex
EOF
}

# Loading too many modules in a single wisp session eventually corrupts
# evaluation (order-dependent assert failures, "tried to run a pinned
# app or pinned pin").  Splitting the load across sessions — the
# snapshot boundary resets whatever leaks — avoids it, so the quip
# chain (print, bits, parse, apollo, ...) gets its own session before
# the foil modules load.
load_quip () {
    repl <<EOF
(#bind quip (#module quip))
EOF
}


# hsbuild

if [ ! -e snap/root.plan ]
then reset; load_stdlib; load_quip
fi

repl <<EOF
::*$1
EOF
