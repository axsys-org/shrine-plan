-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
-  shadow_forms [order=40]
+  campus
  +  input
    \  name=path b=bowl
    ^  myth
    ? b.crew.gut(name (axal/new[myth] .none)).fil
     > (./some value)  value
    myth/new
  +  classify
    '  Planner completion and actual Canvas submission are different facts.
    \  now=nat due=nat state=nat excused=nat local_done=nat soon=nat
    ^  nat
    ? !(eq excused 0)  "excused"
    ? ((eq state "submitted") || (eq state "pending_review") || (eq state "graded"))  "submitted"
    ? !(eq local_done 0)  "planned_done"
    ? (eq due 0)  "undated"
    ? (ge now due)  "due_passed"
    ? (le due (add now soon))  "due_soon"
    "upcoming"
  +  freshness
    \  now=nat observed=nat max_age=nat
    ^  nat
    ? (eq observed 0)  "unobserved"
    ? (gt now (add observed max_age))  "stale"
    "recent"
  +  reconcile
    \  b=bowl cur=myth add=myth
    ^  yell
    = > next cur.meld(add)
    = > clock (campus/input ['clock] b)
    = > settings (campus/input ['settings] b)
    = > now clock.nat_at(['epoch] 0)
    = > due next.nat_at(['due_epoch] 0)
    = > phase
         ? (eq now 0)  "unknown"
         ? (eq next.txt_at(['calendar_status]) "CANCELLED")  "cancelled"
         (campus/classify now due next.txt_at(['submission_state]) next.nat_at(['excused] 0) next.nat_at(['local_done] 0) settings.nat_at(['soon_seconds] 259200))
    = > freshness (campus/freshness now next.nat_at(['observed_epoch] 0) settings.nat_at(['max_age_seconds] 21600))
    = > dated_changed
         ? (eq cur.nat_at(['observed_epoch] 0) 0)  .false
         ? !(add.has(['due_epoch]))  .false
         !(eq due cur.nat_at(['due_epoch] 0))
    = > relevant
         ? (eq cur.nat_at(['armed] 0) 0)  .false
         ? dated_changed  .true
         ? (eq phase cur.txt_at(['phase]))  .false
         ((eq phase "due_soon") || (eq phase "due_passed"))
    = > reason
         ? dated_changed  "Canvas deadline changed; review the current source and your plan."
         ? (eq phase "due_passed")  "The observed deadline passed; verify submission in Canvas."
         "An observed deadline is approaching; inspect the assignment and its submission state."
    = > armed
         ? (eq now 0)  0
         1
    = > out next.put(['phase] (pails/t phase)).put(['freshness] (pails/t freshness)).put(['armed] (pails/n armed))
    ? !relevant  (yell [] out)
    = > noted out.put(['statement] (pails/t reason)).put(['notice_reason] (pails/t reason)).put(['notice_epoch] (pails/n now))
    (shadow_forms/notice ['campus 'notices] b noted [])
  +  hear
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    (campus/reconcile b cur myth/new)
  +  init
    \ b=bowl cur=myth
    ^ yell
    (campus/reconcile b cur myth/new)
  +  assignment
    ^ form
    def_form.set_talk(campus/reconcile).set_hear(campus/hear).set_init(campus/init)
  +  source_hear
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    = > clock (campus/input ['clock] b)
    = > settings (campus/input ['settings] b)
    = > freshness (campus/freshness clock.nat_at(['epoch] 0) cur.nat_at(['observed_epoch] 0) settings.nat_at(['max_age_seconds] 21600))
    = > out cur.put(['freshness] (pails/t freshness))
    ? !(eq freshness "stale")  (yell [] out)
    ? (eq cur.txt_at(['freshness]) "stale")  (yell [] out)
    (shadow_forms/notice ['campus 'notices] b out.put(['statement] (pails/t "Canvas observations are stale; refresh before relying on deadlines.")) [])
  +  source_talk
    \ b=bowl cur=myth add=myth
    ^ yell
    (campus/source_hear b cur.meld(add) [])
  +  source
    ^ form
    def_form.set_talk(campus/source_talk).set_hear(campus/source_hear)
