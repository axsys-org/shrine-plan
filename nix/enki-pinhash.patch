+/* Finalize one content pin without publishing it as the store root.  This is
+ * the mechanical half of semantic admission: policy remains in Foil. */
+static pl_val op_pin_save(pl_thread* t, size_t ab) {
+  t->effect_epoch++;
+  pl_cell* pp = pl_as(PL_TAG_PIN, ARG(0));
+  if (pp == NULL)
+    pl_raise_msg(t, "PinSave: expected a pin");
+  pl_store* store = pl_heap_store(t->heap);
+  char err[192] = {0};
+  if (!pl_store_save_pin(store, ARG(0), NULL, err, sizeof(err)))
+    pl_raise_msgf(t, "PinSave: %s", err[0] != '\0' ? err : "store failure");
+  return ARG(0);
+}
+
+/* Return the canonical 32-byte digest of a finalized content pin.  A row is
+ * used instead of a natural so leading zero bytes remain explicit. */
+static pl_val op_pin_hash(pl_thread* t, size_t ab) {
+  pl_cell* pp = pl_as(PL_TAG_PIN, ARG(0));
+  if (pp == NULL)
+    pl_raise_msg(t, "PinHash: expected a pin");
+  const uint8_t* hash = pl_pin_hash(ARG(0));
+  if (hash == NULL)
+    pl_raise_msg(t, "PinHash: provisional pin");
+
+  pl_gc_reserve(t, PL_APP_CELLS(32));
+  PL_GC_FORBID(t);
+  pl_cell* row = pl_bump(t, PL_APP_CELLS(32));
+  row[0] = pl_hdr_make(PL_K_APP, 0, 0, PL_APP_CELLS(32));
+  row[1] = 0;
+  for (size_t i = 0; i < 32; i++)
+    row[2 + i] = hash[i];
+  pl_val out = pl_make(PL_TAG_APP, row);
+  PL_GC_ALLOW(t);
+  return out;
+}
