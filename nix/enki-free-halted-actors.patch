 /* ── Run queue / handle table ──────────────────────────────────────────── */
@@ -736,6 +741,42 @@ static void er_service(er_scheduler* sys, er_actor* a, bool locked) {
 
 /* ── The executor loop ─────────────────────────────────────────────────── */
 
+static bool er_pin_payload(er_actor* a, pl_val v, pl_val* out);
+
+/*
+ * A halted spawned actor is never resumed and nothing reads its thread or
+ * heap again: free them, its unread mailbox and its handle table, keeping
+ * only the result (snapshotted into the store and rooted by er_gc2_roots)
+ * and the actor record that handles and ids still name.  Without this every
+ * actor ever spawned kept its thread stacks and trimmed semispaces until
+ * er_scheduler_free, so a program spawning one per request grew without
+ * bound.  Runs inside the store mutator scope of the slice that finished;
+ * the store lock pl_heap_free takes nests inside sys->mu as it does
+ * elsewhere (the collector, which takes them the other way round, cannot
+ * mark while this scope is open).
+ */
+static void er_reap(er_actor* a) {
+  if (a->adopted || a->reaped)
+    return;
+  (void)er_pin_payload(a, pl_thread_result(a->t), &a->result);
+  for (er_msg* m = a->mbox_head; m != NULL;) {
+    er_msg* mn = m->next;
+    free(m);
+    m = mn;
+  }
+  a->mbox_head = a->mbox_tail = NULL;
+  free(a->handle_v);
+  a->handle_v = NULL;
+  a->handle_cap = 0;
+  a->t->host = NULL;
+  a->t->rplan_effect_f = NULL;
+  pl_thread_free(a->t);
+  pl_heap_free(a->heap);
+  a->t = NULL;
+  a->heap = NULL;
+  a->reaped = true;
+}
+
 /* One scheduling step of a spawned (scheduler-owned) actor. */
 static void er_step(er_scheduler* sys, er_actor* a, pl_run_status s,
                     bool locked) {
@@ -744,8 +785,8 @@ static void er_step(er_scheduler* sys, er_actor* a, pl_run_status s,
     er_enqueue(a); /* round-robin fairness */
     break;
   case PL_RUN_DONE:
-    a->status = ER_ACTOR_HALTED; /* result discarded (kept for tests) */
-    pl_gc_trim(a->t);
+    a->status = ER_ACTOR_HALTED;
+    er_reap(a); /* the result stays readable (er_actor_result) */
     break;
   case PL_RUN_EXN:
     er_crash(a);
