{
  "openapi": "3.1.0",
  "info": {
    "title": "edge_api",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://example.invalid/api"
    }
  ],
  "paths": {
    "/created": {
      "post": {
        "operationId": "createWorkspace",
        "responses": {
          "201": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ws"
                }
              }
            }
          }
        }
      }
    },
    "/accepted": {
      "post": {
        "operationId": "acceptJob",
        "responses": {
          "202": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ws"
                }
              }
            }
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "operationId": "getAnalyticsMeta",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "operationId": "list",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ws": {
        "type": "object",
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          }
        }
      },
      "json": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string"
          }
        }
      }
    }
  }
}
