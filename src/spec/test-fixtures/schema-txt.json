{
  "title": "task",
  "type": "object",
  "required": ["name", "done"],
  "properties": {
    "name": {"type": "string"},
    "done": {"type": "boolean"},
    "count": {"type": "integer"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "peer": {"$ref": "#/$defs/peer"},
    "hue": {"$ref": "#/$defs/hue"}
  },
  "$defs": {
    "peer": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {"host": {"type": "string"}, "port": {"type": "integer"}}
    },
    "hue": {"enum": ["red", "green"]}
  },
  "examples": [{"name": "a", "done": true}]
}
