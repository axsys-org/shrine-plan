{
  "title": "pick",
  "type": "object",
  "required": ["choice"],
  "properties": {
    "choice": {
      "anyOf": [
        {"type": "string", "enum": ["none"]},
        {"type": "string", "enum": ["auto"]},
        {"$ref": "#/$defs/named"},
        {"$ref": "#/$defs/served"}
      ]
    }
  },
  "$defs": {
    "named": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {"type": {"enum": ["function"]}, "name": {"type": "string"}}
    },
    "served": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["server"]}}}
  }
}
