@reaver

;; Bridge: load the plangrm-diff reaver module and hand it the shipped
;; compiler (`compile`, in scope here from reaver.plan) so it can run
;; the S3 corpus differential.  Run with:
;;   wisp --file-root ./reaver/src ./reaver/src/plan plangrm-diff main

(define (main args)
  (define @[cache uniq glo mod expr]
    (reval EMPTY-CACHE 0 INITIAL-UNIQUE EMPTY-ENVIRONMENT
      (0 "#bind" "pgd" (0 "#module" "plangrm-diff"))))
  (define @[cache2 uniq2 glo2 runDiff expr2]
    (reval cache 0 uniq glo (0 "#in" "pgd" "runDiff")))
  (runDiff compile))
