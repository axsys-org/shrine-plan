@inline

;;; Benchmark for the inliner: builds a chain of global bindings where
;;; each level is a lambda whose body references the previous global
;;; twice, then runs =inline= on a reference to the top of the chain.
;;;
;;; The result is forced via =Eq= against the exact expected result
;;; (pins compare by hash), mirroring how real consumers force it —
;;; a raw DeepSeq would re-walk the shared pin DAG exponentially and
;;; measure the forcing, not the inliner.

(def bench-idlam (F 0 0 0 "bid" 1 (V 0)))

(patfun (bench-entry expr)
  (Pin (ENTRY "g" 0 ValueFlag expr)))

(patfun (bench-chain p n)
  (Ifz n p
    (bench-chain
      (bench-entry (F 0 0 0 "g" 1 (A (A (K 0) (G p)) (G p))))
      (Dec n))))

(patfun (bench n)
  p(bench-chain (bench-entry bench-idlam) n)
  lam(.bind-expr (Unpin p))
  (Eq (inline 0 NIL NIL (G p))
      (RES (G p) (SOME (POT lam 0 0 1 NIL)))))

;; Depth 1000 is a regression tripwire: with any deep forcing in
;; =reapply= this is unreachable (the pass goes exponential around
;; depth ~20), while the lazy pass handles it instantly.
(assert (bench 1000))

(patfun (bench-main _)
  "bench-ok")
