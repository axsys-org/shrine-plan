@reaver

;; Bridge: run the S4 benchmark harness.
;;   wisp --file-root ./reaver/src ./reaver/src/plan plangrm-bench main \
;;     <ship|p1..p5> <nfib|listwork|rowwork|none> <iters>

(define (main args)
  (define @[cache uniq glo mod expr]
    (reval EMPTY-CACHE 0 INITIAL-UNIQUE EMPTY-ENVIRONMENT
      (0 "#bind" "pgb" (0 "#module" "plangrm-bench"))))
  (define @[c2 u2 g2 benchMain e2]
    (reval cache 0 uniq glo (0 "#in" "pgb" "bench-main")))
  (benchMain args))
