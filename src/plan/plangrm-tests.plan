@reaver

;; Bridge: load the plangrm test module (asserts run at load) so the
;; suite can run headless:
;;   wisp --file-root ./src ./src/plan plangrm-tests main

(define (main args)
  (define @[cache uniq glo mod expr]
    (reval EMPTY-CACHE 0 INITIAL-UNIQUE EMPTY-ENVIRONMENT
      (0 "#bind" "pgt" (0 "#module" "plangrm-tests"))))
  (Seq mod (print "plangrm-tests: load complete")))
