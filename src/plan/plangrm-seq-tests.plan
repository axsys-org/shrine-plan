@reaver

;; wisp --file-root ./src ./src/plan plangrm-seq-tests main <p5|p6>
(define (main args)
  (define @[cache uniq glo mod expr]
    (reval EMPTY-CACHE 0 INITIAL-UNIQUE EMPTY-ENVIRONMENT
      (0 "#bind" "pgr" (0 "#module" "plangrm-seq-tests"))))
  (define @[c2 u2 g2 runTests e2]
    (reval cache 0 uniq glo (0 "#in" "pgr" "seq-test-main")))
  (runTests args))
