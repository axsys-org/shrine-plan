@reaver

;; Bridge: run the plangrm compile-time profiler.
;;   wisp --file-root ./src ./src/plan plangrm-profile main \
;;     <levels|top|passes> [<level>] [<limit>]

(define (main args)
  (define @[cache uniq glo mod expr]
    (reval EMPTY-CACHE 0 INITIAL-UNIQUE EMPTY-ENVIRONMENT
      (0 "#bind" "pgp" (0 "#module" "plangrm-profile"))))
  (define @[c2 u2 g2 profMain e2]
    (reval cache 0 uniq glo (0 "#in" "pgp" "profile-main")))
  (profMain args))
