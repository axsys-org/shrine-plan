#import debug_model="/weft/debug/v1/debug_model"
#import debug_document="/weft/debug/v1/debug_document"
#import debug_explorer="/weft/debug/v1/debug_explorer"

' Tests consume the real published modules, never a second Foil renderer.

debugger_checks =
  @slot
  ! foil
  + semantics
    \ ignored=unit
    ^ row[testing/check]
    = schema
        | grove_role_schema
          [(grove_role_field "Title" ['sys 'title] .false)
           (grove_role_field "Note" ['sys 'note] .true)]
          [[['sys 'title] ['sys 'note]]]
      card
        . (myth/new)
          put(['sys 'grove 'role] schema)
          put(bond/lede (pails/t "Card <role>"))
      view (axal/new[myth] (./some card))
      body (weft/render_many (debug_model/value ['res_body] (pd "<html>& response")))
      huge (weft/render_many (debug_model/value ['size] (pd (bex 2048))))
      source (weft/render_many (debug_model/value ['sys 'grove 'source]
        (safe 3 .x ['gov 'srs])))
      event (log_card (task/vine ['io 'http 'r2] .cull) .none [])
      raw_entry (weft/render_many (debug_model/event event))
      rendered_role (weft/render_many (debug_model/role schema))
    [
     (testing/nat "role classified" 1 (eq "role" (debug_model/kind ['gov 'card] view)))
     (testing/nat "required slot" 1 (cord/has "required" rendered_role))
     (testing/nat "optional slot" 1 (cord/has "optional" rendered_role))
     (testing/nat "schema summary names slots" 1
       (cord/has "2 declared slots" (weft/render_many (debug_model/value [] schema))))
     (testing/nat "empty schema names slots" 1
       (cord/has "No declared slots." (weft/render_many (debug_model/role (grove_role_schema [] [])))))
     (testing/nat "one of group" 1 (cord/has "At least one of" rendered_role))
     (testing/nat "schema references inspectable" 1 (cord/has "/debug/sys/title" rendered_role))
     (testing/nat "HTTP response decoded and escaped" 1 (eq body "&lt;html&gt;&amp; response"))
     (testing/nat "large unknown numeric value bounded" 1 (cord/has "byte numeric value" huge))
     (testing/nat "Grove source resolves as reference" 1 (cord/has "/debug/gov/srs" source))
     (testing/nat "event task named" 1 (cord/has "Delete" raw_entry))
    ]
  + metadata
    \ ignored=unit
    ^ row[testing/check]
    = original=myth debugger_fixture/values
      text (debug_model/value_fidelity ['text] (pt "hello"))
      long (debug_model/value_fidelity ['long] original.get(['long]).fall((pd 0)))
      threshold (debug_model/value_fidelity ['threshold] original.get(['threshold]).fall((pd 0)))
      nul (debug_model/value_fidelity ['nul] original.get(['nul]).fall((pd 0)))
      opaque (debug_model/value_fidelity ['opaque] (pails/p ['other]))
      boundary (debug_model/value_fidelity ['text]
        (pt (str/from_atom (add (str/to_atom (str/repeat 2047 "a")) (mul 66 (bex 16384))))))
      html (weft/render_many (debug_document/document_record ['demo] (axal/new[myth] (./some original)) (./some 2) .false))
    [(testing/text "short text is complete" "complete" text.state)
     (testing/text "threshold text remains complete" "complete" threshold.state)
     (testing/text "long text is explicit preview" "preview" long.state)
     (testing/text "long reason" "byte-limit" long.reason)
     (testing/nat "UTF-8 preview stops before split scalar" 2047 long.preview.fall(0))
     (testing/nat "full text byte count retained" 2054 long.total.fall(0))
     (testing/text "NUL rendering not complete" "non-text-bytes" nul.reason)
     (testing/text "NUL at preview boundary cannot disappear silently" "non-text-bytes" boundary.reason)
     (testing/text "semantic formatter is not exact" "opaque" opaque.state)
     (testing/nat "HTML publishes preview state" 1 (cord/has "data-value-state" html))
     (testing/nat "HTML publishes full-value URL" 1 (cord/has "/debug-read/value?path=" html))
     (testing/text "derived record gets no physical URL" "" (debug_model/immutable_url ['x 'demo] ['text] (./some 2) (pt "hello")))
     (testing/text "missing verified epoch gets no URL" "" (debug_model/immutable_url ['demo] ['text] .none (pt "hello")))]
  + tests
    ^ row[testing/case]
    [(testing/case "Namespace authored metadata"
       (\ ignored=unit
        ^ row[testing/check]
        = version (axal/new[myth] .none)
          textcard
            . (myth/new)
              put(bond/lede (pails/t "Prompt"))
              put(bond/help (pails/t "The <question> shown & answered."))
          textview (axal/new[myth] (./some textcard))
          plain (weft/render_many (debug_explorer/docs textview version))
          structured (lore "Card" ["Card" "" "A prompt with a schedule." "A second paragraph."] [["2 + 2" "4"]])
          lorecard
            . (myth/new)
              put(bond/lede (pails/t "Preferred title"))
              put(bond/help structured)
          loreview (axal/new[myth] (./some lorecard))
          lorehtml (weft/render_many (debug_explorer/docs loreview version))
          barelore (axal/new[myth] (./some (myth/sing bond/help (lore "Fallback title" ["First paragraph."] []))))
          barehtml (weft/render_many (debug_explorer/docs barelore version))
          empty (axal/new[myth] (./some myth/new))
          duplicate (axal/new[myth] (./some
            (. (myth/new)
              put(bond/lede (pails/t "One line."))
              put(bond/help (pails/t "One line.")))))
          long (lore "Long" ["Long" "One" "Two" "Three" "Four" "Five" "Six" "Seven"] [])
          longhtml (weft/render_many (debug_explorer/docs
            (axal/new[myth] (./some (myth/sing bond/help long))) version))
        [(testing/nat "lede is the authored label" 1
            (eq "Preferred title" (debug_model/label ['card] loreview)))
         (testing/nat "lore head supplies missing lede" 1
            (eq "Fallback title" (debug_model/label ['card] barelore)))
         (testing/nat "missing metadata preserves namespace identity" 1
            (eq "/card" (debug_model/label ['card] empty)))
         (testing/nat "text help is the authored description" 1
            (eq "The <question> shown & answered." (debug_model/description ['card] textview)))
         (testing/nat "lore excerpt skips duplicate head and blank" 1
            (eq "A prompt with a schedule." (debug_model/description ['card] loreview)))
         (testing/nat "hand authored first body paragraph retained" 1
            (eq "First paragraph." (debug_model/description ['card] barelore)))
         (testing/nat "no invented record description" 1
            (eq "" (debug_model/description ['card] empty)))
         (testing/nat "no invented namespace description" 1
            (eq "" (debug_model/description ['structural] version)))
         (testing/nat "duplicate text title is not repeated as description" 1
            (eq "" (debug_model/description ['card] duplicate)))
         (testing/nat "one line lore has no repeated description" 1
            (eq "" (debug_model/lore_description (lore/line "Single line."))))
         (testing/nat "plain help documentation rendered and escaped" 1
            (cord/has "The &lt;question&gt; shown &amp; answered." plain))
         (testing/nat "plain help uses authored heading" 1 (cord/has "Prompt" plain))
         (testing/nat "all lore paragraphs preserved" 1
            (cord/has "A second paragraph." lorehtml))
         (testing/nat "hand authored first body paragraph rendered" 1
            (cord/has "First paragraph." barehtml))
         (testing/nat "doctests remain in documentation" 1
            (cord/has "never run" lorehtml))
         (testing/nat "long lore has a bounded overflow disclosure" 1
            (cord/has "<details><summary>More documentation" longhtml))
         (testing/nat "long lore first paragraph stays visible" 1
            (cord/has "One</div>" longhtml))
         (testing/nat "long lore final paragraph retained" 1
            (cord/has "Seven" longhtml))]))
     (testing/case "Direct event verbs"
       (\ ignored=unit
        ^ row[testing/check]
        [(testing/nat "cull" 1 (eq "Delete" (debug_model/write_verb .cull)))
         (testing/nat "make" 1 (eq "Replace" (debug_model/write_verb (writ/make myth/new))))]))
     (testing/case "Event extraction"
       (\ ignored=unit
        ^ row[testing/check]
        = event (log_card (task/vine ['io 'http 'r2] .cull) .none [])
        [(testing/nat "verb" 1 (eq "Delete" (debug_model/event_verb event)))
         (testing/nat "target" 1 (equal[path] ['io 'http 'r2] (debug_model/event_target event)))]))
     (testing/case "Event rendering"
       (\ ignored=unit
        ^ row[testing/check]
        = event (log_card (task/vine ['io 'http 'r2] .cull) .none [])
        [(testing/nat "render" 1 (cord/has "Delete" (weft/render_many (debug_model/event event))))]))
     (testing/case "Journal commands and effects"
       (\ ignored=unit
        ^ row[testing/check]
        = target=path ['app 'cards 'one]
          make (log_card (task/vine target (writ/make myth/new)) (./some target) [])
          warp (log_card (task/vine target (writ/warp ['app 'op 'grade] myth/new)) .none
            [(move ['app] ['io 'http 'response] (writ/poke myth/new))
             (move ['app] ['io 'http 'old] .cull)])
          made (weft/render_many (debug_model/event make))
          warped (weft/render_many (debug_model/event warp))
        [(testing/nat "empty effects make" 1 (cord/has "Replace" made))
         (testing/nat "ack path" 1 (cord/has "/debug/app/cards/one" made))
         (testing/nat "warp task named" 1 (cord/has "Run operation" warped))
         (testing/nat "warp operation link" 1 (cord/has "/debug/app/op/grade" warped))
         (testing/nat "effect command labels" 1 (cord/has "Update" warped))
         (testing/nat "outbound effect source" 1 (cord/has "/debug/app" warped))
         (testing/nat "delete effect destination" 1 (cord/has "/debug/io/http/old" warped))
         (testing/nat "outbound source and destination" 1 (cord/has "/debug/io/http/response" warped))]))
     (testing/case "Bounded runtime data never pads"
       (\ ignored=unit
        ^ row[testing/check]
        = empty (log_card (task/vine ['app] .cull) .none [])
          single (log_card (task/vine ['app] .cull) .none
            [(move ['app] ['one] .cull)])
          pair (log_card (task/vine ['app] .cull) .none
            [(move ['app] ['one] .cull) (move ['app] ['two] (writ/poke myth/new))])
          template (grove_template 1
            [[[] myth/new] [['cards] myth/new] [['cards 'one] myth/new] [['next] myth/new]])
          exports=mop[path grove_backend/entry lt_pith]
            (mop/empty)
          exports
            . exports
              put(['one] (grove_backend/entry ['one] 0 (^ nat) "type"))
              put(['two] (grove_backend/entry ['two] 0 (^ nat) "type"))
          module (grove_backend/bundle 1 "test" ['demo] exports 0)
          noexports (grove_backend/bundle 1 "test" ['empty] (mop/empty) 0)
        [(testing/nat "zero effects render zero rows" 0
            (cord/count "debug-effect" (weft/render_many (debug_model/event empty))))
         (testing/nat "one effect renders one row" 1
            (cord/count "debug-effect" (weft/render_many (debug_model/event single))))
         (testing/nat "two effects render two rows" 2
            (cord/count "debug-effect" (weft/render_many (debug_model/event pair))))
         (testing/nat "four seeds render four paths" 4
            (cord/count "debug-seed" (weft/render_many (debug_model/semantic_value template))))
         (testing/nat "two exports render two rows" 2
            (cord/count "debug-fact debug-export" (weft/render_many (debug_model/module module))))
         (testing/nat "zero exports render zero rows" 0
            (cord/count "debug-fact debug-export" (weft/render_many (debug_model/module noexports))))]))
     (testing/case "Namespace debugger semantics" debugger_checks/semantics)
     (testing/case "Slot fidelity" debugger_checks/metadata)]
