'  Supported Grove backend fixture: one record per declaration.

token =
  @type
  ! foil
  : value=nat

counter =
  @slot
  #meta ;
    "/sys/title": "Counter"
    "/sys/count": (pails/n (counter/read (counter/make 7)))
  ! foil
  + make
    \ value=nat
    ^ token
    | token value
  + read
    \ value=token
    ^ nat
    value.value

label =
  @slot
  #meta ;
    "/sys/title": "Documentation only"
