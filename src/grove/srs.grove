#import sys=sys/slots
#import ty=sys/types

' Example grove: a minimal spaced-repetition application.
'
' Declarations:
'   @type    Explicit Foil type implementation.
'   @slot    Property identifier.
'   @role    Property constraints; synthesizes a Foil type.
'   @action  Transformation on a role, with additional arguments.
'   @norm    Constraints on the occupied shape of a namespace.
'   @dyed    Namespace transformation between two norms.
'   @tree    Concrete namespace content.
'
' Forms:
'   #meta ;            Metadata values on the declaration itself.
'   slot: rhs          A value or type requirement, by context.
'   #directive ; arg   A relationship or structural directive.
'   ! foil             Remaining body is Foil; no blank lines inside.


' Types and slots

grade =
  @type
  @slot
  #meta ;
    sys/title: "Review grade"
  ! foil
  +  again :
  +  hard  :
  +  good  :
  +  easy  :
  & %/again
    %/hard
    %/good
    %/easy

due =
  @slot
  #meta ;
    sys/title: "Time next due"

interval =
  @slot
  #meta ;
    sys/title: "Next prompt interval"


' Object roles

recall =
  @role
  #meta ;
    sys/title: "Recall metadata"
  %/due: ty/time
  %/interval: ty/duration

card =
  @role
  #meta ;
    sys/title: "Review card"
  #with ; recall
  #or ;
    sys/req: ty/iota/ts
    sys/about: ty/path
    ' At least one must be present; both are allowed.
    ' Every present limb must satisfy its declared type.
  #opt ;
    sys/res: ty/iota/ts


' Review action

finish =
  @action
  #meta ;
    sys/title: "Finish review"
  #on ; recall
  %/grade: %/grade
  sys/now: ty/time
  ! foil
  \ grade=%/grade now=ty/time rec=%/recall
  ^ %/recall
  = next_interval
    ? grade
      > .again '@d1
      > .hard  | div (mul rec.interval 4) 3
      > .good  | mul rec.interval 2
      > .easy  | mul rec.interval 3
  = next_due | add now next_interval
  rec.set_interval(next_interval).set_due(next_due)


' Collection norms
'
' These describe the permitted occupied paths, not just a subset
' of paths to check. Structural parent nodes may remain empty.
' Inline limbs constrain the objects at the matched paths.

cards_by_id =
  @norm
  #here ; '/[name=@tas]
  #with ; card

card_list =
  @norm
  #here; '/[name=@u]
  #with; card
  sys/from: ty/path


' Presentation: the ten soonest cards, whether overdue or upcoming.

queue =
  @dyed
  #meta ;
    sys/title: "Next ten cards"
  #from ; cards_by_id
  #to ; card_list
  get :
    ! foil
    + cmp
      \ [xsrc=path x=myth] [ysrc=path y=myth]
      = cx=%/card | ./from_myth x
      = cy=%/card | ./from_myth y
      ' Equal due times are ordered by source identifier.
      ' The input norm guarantees one-segment paths.
      ? (eq cx.due cy.due)
        | lte_iota xsrc.at(0) ysrc.at(0)
      | le cx.due cy.due
    \ x=axal[myth]
    ^ axal[myth]
    = entries
      | list/row[[path myth]]
      x.tap.stream.sort_by(%%/cmp).take(10)
    = acc=[nat axal[myth]]
      [0 (axal/new[myth] .none)]
    = [count out]
      | entries.fold acc
      \ [idx=nat tree=axal[myth]] [src=path val=myth]
      ' Preserve the source path relative to the input root.
      ' myth.put receives the slot, value type, and value.
      = val
        | val.put '/sys/slots/from path src
      = tree
        | tree.put '/($u idx) val
      [(inc idx) tree]
    out


' Installed namespace

"/" =
  @tree

"/cards" =
  @tree
  #like ; cards_by_id

"/cards/demo" =
  @tree
  sys/req: "What does a Shrine name identify?"
  sys/res: "A versioned locus of state."
  %/due: 0
  %/interval: '@d1

"/next" =
  @tree
  sys/weft: %/queue
  sys/tack: '@/y/%/cards
