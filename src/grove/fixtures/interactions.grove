#import adjustment=gov/progression/adjustment
#import now=sys/now
#import req=sys/req
#import time=lib/grove/types/time
#import text=lib/grove/types/text

point =
  @role
  req: text

finish =
  @action
  #on ; point
  %/grade: adjustment
  now: time
  ! foil
  \ grade=adjustment now=time rec=%/point
  ^ %/point
  rec

review =
  @view
  #on ; %/point
  #for ; /sys/slot/detail
  card => group(on = card, action = %/finish, myth = {
    '/sys/now = .provider
  }) {
    action("Medium", %/grade = adjustment/medium)
  }
