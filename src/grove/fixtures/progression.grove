#import lede=sys/lede
#import req=sys/req
#import res=sys/res
#import about=sys/about
#import from=sys/from
#import now=sys/now
#import weft=sys/weft
#import tack=sys/tack
#import time=codecs/time
#import duration=codecs/duration
#import text=codecs/text
#import path_type=codecs/path

' Compiler fixture: records advance positions and are ordered by position.
'
' Declarations:
'   @type    Explicit Foil type implementation.
'   @slot    Property identifier.
'   @role    Property constraints; synthesizes a Foil type.
'   @action  Transformation on a role, with additional arguments.
'   @norm    Constraints on the occupied shape of a namespace.
'   @sewn    Namespace transformation between two norms.
'   @tree    Concrete namespace content.
'
' Forms:
'   #meta ;            Metadata values on the declaration itself.
'   slot: rhs          A value or type requirement, by context.
'   #directive ; arg   A relationship or structural directive.
'   ! foil             Remaining body is Foil; no blank lines inside.


' Types and slots

adjustment =
  @type
  @slot
  #meta ;
    lede: "Step adjustment"
  ! foil
  +  reset :
  +  small  :
  +  medium  :
  +  large  :
  & %/reset
    %/small
    %/medium
    %/large
  + read
    \ raw=pail
    ^ maybe[adjustment]
    ? raw
     > value=adjustment/reset (./some value)
     > value=adjustment/small (./some value)
     > value=adjustment/medium (./some value)
     > value=adjustment/large (./some value)
    .none
  + write
    \ value=adjustment
    ^ pail
    ? value
     > value=adjustment/reset value
     > value=adjustment/small value
     > value=adjustment/medium value
     > value=adjustment/large value
  + contract
    | curb/of_type (^ adjustment)

position =
  @slot
  #meta ;
    lede: "Time next position"

stride =
  @slot
  #meta ;
    lede: "Next prompt stride"


' Object roles

positioned =
  @role
  #meta ;
    lede: "Position metadata"
  %/position: time
  %/stride: duration

entry =
  @role
  #meta ;
    lede: "Review entry"
  #with ; positioned
  #or ;
    req: text
    about: path_type
    ' At least one must be present; both are allowed.
    ' Every present limb must satisfy its declared type.
  #opt ;
    res: text


' Review action

advance =
  @action
  #meta ;
    lede: "Advance position"
  #on ; positioned
  %/adjustment: %/adjustment
  now: time
  ! foil
  \ adjustment=%/adjustment now=time rec=%/positioned
  ^ %/positioned
  = next_stride
    ? adjustment
      > .reset 1
      > .small  | div (mul rec.stride 4) 3
      > .medium  | mul rec.stride 2
      > .large  | mul rec.stride 3
  = next_position | add now next_stride
  rec.set_stride(next_stride).set_position(next_position)


' Collection norms
'
' These describe the permitted occupied paths, not just a subset
' of paths to check. Structural parent nodes may remain empty.
' Inline limbs constrain the objects at the matched paths.

by_name =
  @norm
  #here ; '/[name=@tas]
  #with ; entry

by_index =
  @norm
  #here; '/[name=@u]
  #with; entry
  from: path_type


' Projection: the first ten entries in position order.

ordered =
  @sewn
  #meta ;
    lede: "Next ten entries"
  #from ; by_name
  #to ; by_index
  get :
    ! foil
    + cmp
      \ left=[path myth] right=[path myth]
      ^ nat
      = [xsrc x] left
      = [ysrc y] right
      > (./some cx) (%/entry/from_myth x)
        0
      > (./some cy) (%/entry/from_myth y)
        0
      ' Equal position times are ordered by source identifier.
      ' The input norm guarantees one-segment paths.
      ? (eq cx.position cy.position)
        | lte_iota xsrc.at(0) ysrc.at(0)
      | le cx.position cy.position
    + push
      \ acc=[nat axal[myth]] entry=[path myth]
      ^ [nat axal[myth]]
      = [idx tree] acc
      = [src val] entry
      ' Preserve the source path relative to the input root.
      = val val.put(['sys 'from] (pails/p src))
      = tree tree.put([($u idx)] val)
      [(inc idx) tree]
    + occupied
      \ entry=[path myth]
      ^ bool
      = [key val] entry
      | eq key.len 1
    \ x=axal[myth]
    ^ axal[myth]
    = occupied
      | x.tap.keep(%/get/occupied)
    = entries
      | list/row[[path myth]]
        (occupied.stream.sort_by(%/get/cmp).take(10))
    = acc=[nat axal[myth]]
      [0 (axal/new[myth] .none)]
    = [count out]
      | row/fold[[path myth] [nat axal[myth]]]
        acc %/get/push entries
    out


' Installed namespace

"/" =
  @tree

"/entries" =
  @tree
  #like ; by_name

"/entries/demo" =
  @tree
  req: "Fixture input"
  res: "Fixture output"
  %/position: 0
  %/stride: 1

"/next" =
  @tree
  weft: %/ordered
  tack: '@/y/%/entries
