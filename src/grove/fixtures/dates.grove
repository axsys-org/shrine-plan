#import time=lib/grove/types/time
#import duration=lib/grove/types/duration

stamp =
  @slot

precise =
  @slot

elapsed =
  @slot


entry =
  @role
  %/stamp: time
  %/precise: time
  %/elapsed: duration

entries =
  @norm
  #here ; "/"
  #with ; %/entry

"/example" =
  @tree
  #like ; %/entries
  %/stamp: '@2026.9.30..12.0.0
  %/precise: '@@1969.7.21..2.56.15
  %/elapsed: '@h1.m30
