' Publisher-owned value codecs over the selected system type foundations.
' The loader mounts source imports onto this publication without changing brands.

time =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[time]
    ? value
     > wrapped=pails/n (./some wrapped.n)
     > wrapped=pails/dm (./some wrapped.n)
     > wrapped=pails/ds (./some wrapped.n)
    .none
  + write
    \ value=time
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | (curb/of_type (^ pails/n)).weld((curb/of_type (^ pails/dm))).weld((curb/of_type (^ pails/ds)))

duration =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[duration]
    ? value
     > wrapped=pails/n (./some wrapped.n)
     > wrapped=pails/dr (./some wrapped.n)
    .none
  + write
    \ value=duration
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | (curb/of_type (^ pails/n)).weld((curb/of_type (^ pails/dr)))

text =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[text]
    > wrapped=pails/t value
      .none
    | ./some wrapped.t
  + write
    \ value=text
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

path =
  @type
  ! foil
  row[iota]
  + read
    \ value=pail
    ^ maybe[path]
    > wrapped=pails/p value
      .none
    | ./some wrapped.p
  + write
    \ value=path
    ^ pail
    | pails/p value
  + contract
    ^ curb
    | curb/of_type (^ pails/p)
