' System slot documentation, compiled with source root /sys.
' Paths follow bond.foil; @slot confers no special authority.

content =
  @slot
  #meta ;
    "/sys/lede": "Content"
    "/sys/help": (pails/t (str/join " "
      ["The primary item at this name. This is the default"
       "target of most overlays that act on a pail."
       "/sys/content"]))

src =
  @slot
  #meta ;
    "/sys/lede": "Src"
    "/sys/help": "Textual source. /sys/src"

lede =
  @slot
  #meta ;
    "/sys/lede": "Lede"
    "/sys/help": "A short title for this name. /sys/lede"

help =
  @slot
  #meta ;
    "/sys/lede": "Help"
    "/sys/help": (pails/t (str/join " "
      ["A longer description of what the name is/does."
       "/sys/help"]))

type =
  @slot
  #meta ;
    "/sys/lede": "Type"
    "/sys/help": (pails/t (str/join " "
      ["The type-in-the-last-instance. This should be a"
       "callable of arity 1 whose kernel are the members of"
       "the set.  You should almost always never use this"
       "slot directly; it exists for namespace compatibility"
       "reasons (migrations of type of type, typesystem"
       "pluralism). /sys/type"]))

mold =
  @slot
  #meta ;
    "/sys/lede": "Mold"
    "/sys/help": (pails/t (str/join " "
      ["Foil's perspective on a type. This should be +type"
       "from the compiler internals; it is what is actually"
       "used when dealing with types currently. /sys/mold"]))

limb =
  @slot
  #meta ;
    "/sys/lede": "Limb"
    "/sys/help": (pails/t (str/join " "
      ["List of transition functions that govern the"
       "evolution of a path. Should always be a list of"
       "paths to hands (at the %/content slot).  The"
       "behavior chain: if present, must be a list of paths"
       "to behaviors; if absent, treated as if ~, meaning"
       "the path is unconstrained. /sys/limb"]))

crew =
  @slot
  #meta ;
    "/sys/lede": "Crew"
    "/sys/help": (pails/t (str/join " "
      ["The dependency map: from local slot name to (care,"
       "path). /sys/crew"]))

author =
  @slot
  #meta ;
    "/sys/lede": "Author"
    "/sys/help": "/sys/author"

unreads =
  @slot
  #meta ;
    "/sys/lede": "Unreads"
    "/sys/help": (pails/t (str/join " "
      ["Used to indicate that a path has unreads."
       "/sys/unreads"]))

req =
  @slot
  #meta ;
    "/sys/lede": "Req"
    "/sys/help": "The request record on a driver-minted node. /sys/req"

res =
  @slot
  #meta ;
    "/sys/lede": "Res"
    "/sys/help": (pails/t (str/join " "
      ["The response record a serving behavior writes back."
       "Presence is the completion signal — there is no"
       "separate done flag. /sys/res"]))

weft =
  @slot
  #meta ;
    "/sys/lede": "Weft"
    "/sys/help": "/sys/weft"

tack =
  @slot
  #meta ;
    "/sys/lede": "Tack"
    "/sys/help": (pails/t (str/join " "
      ["The /x view lens's data dependency: a y-care safe"
       "pinning the subtree the node's weft runs against."
       "/sys/tack"]))

typp =
  @slot
  #meta ;
    "/sys/lede": "Typp"
    "/sys/help": "/sys/typp"

face =
  @slot
  #meta ;
    "/sys/lede": "Face"
    "/sys/help": (pails/t (str/join " "
      ["The datum face binding: a hunt whose care is BOTH"
       "the ctor's input care and the claim reach over this"
       "record's subtree (.x the node alone, .y plus its"
       "direct kids, .z the whole subtree), and whose path"
       "names the component ctor node the page renders"
       "through ('.'-headed rebases at mount, so it is"
       "absolute post-mount — unlike a face kook's ['hunt]"
       "claim, whose path stays mount-root-relative)."
       "/sys/face"]))

about =
  @slot
  #meta ;
    "/sys/lede": "About"
    "/sys/help": "The subject this record describes."

from =
  @slot
  #meta ;
    "/sys/lede": "From"
    "/sys/help": "The source namespace path."

now =
  @slot
  #meta ;
    "/sys/lede": "Now"
    "/sys/help": "The current time supplied to an operation."
