chrome =
  @slot
  #meta ;
    "/sys/lede": "Debugger chrome"
    "/sys/help": (pails/t "Mash compositions for the namespace debugger. No browser-side shell factory.")
  ! foil
  + icon
    \ name=nat
    ^ weft/node
    | weft/node/el "ui-icon"
      [(weft/att "name" name) (weft/att "size" "small")
       (weft/att "aria-hidden" "true")] []
  + button
    \ id=nat label=nat name=nat
    ^ weft/node
    = control
        | weft/node/el "ui-button"
          [(weft/att "id" id) (weft/att "class" "wb-icon-button")
           (weft/att "slot" "trigger") (weft/att "aria-label" label)
           (weft/att "title" "") (weft/att "type" "button")
           (weft/att "size" "compact") (weft/att "variant" "ghost")
           (weft/att "tone" "neutral") (weft/att "icon-only" "")]
          [(chrome/icon name)]
    | weft/node/el "ui-tooltip"
      [(weft/att "label" label) (weft/att "placement" "bottom")
       (weft/att "open-delay" "500") (weft/att "close-delay" "120")
       (weft/att "data-mash-size" "compact")] [control]
  + place
    \ target=nat label=nat name=nat
    ^ weft/node
    = kids
        ~ weft/build
        ~# 'ui-icon[slot=prefix][size=small][aria-hidden=true]
          'name name
        ~. label
        ~. 'code[slot=shortcut] target
    | weft/node/el "ui-menu-item"
      [(weft/att "class" "debug-root-link")
       (weft/att "value" target)
       (weft/att "href" (weft/cat2 "/debug" target))] kids
  + section
    \ name=nat title=nat glyph=nat id=nat opened=bool kids=row[weft/node]
    ^ weft/node
    = attributes
        [(weft/att "id" (weft/cat2 "debug-section-" name))
         (weft/att "class" "debug-sidebar-section")
         (weft/att "value" name) (weft/att "title" title)
         (weft/att "heading-level" "2")]
      attributes
        ? opened attributes.snoc((weft/att "open" ""))
        attributes
      body
        ~ weft/build
        ~# 'ui-icon[slot=prefix][size=small][aria-hidden=true]
          'name glyph
        ~. 'span[slot=title] title
        ~# 'span.debug-section-count[slot=suffix]
          'data-count name
        ~| 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
        ~# 'div.debug-section-body
          'id id
          kids
    | weft/node/el "ui-accordion-item" attributes body
  + sidebar
    \ authority=path
    ^ row[weft/node]
    = tree
        ~ weft/build
        ~| 'div#debug-tree-toolbar
          [(chrome/button "debug-tree-namespace" "Browse entire namespace" "navigation.chevron-left")]
          ~| 'ui-path#debug-tree-root[size=small][path=/]
            ~. 'ui-label.debug-search-label[slot=title] "Namespace"
          ~| 'ui-toolbar#debug-tree-actions[label=Namespace tree actions][data-mash-size=compact]
            [(chrome/button "debug-tree-collapse" "Collapse all branches" "object.tree")]
            [(chrome/button "debug-tree-refresh" "Refresh tree root" "action.refresh")]
            [(chrome/button "debug-save" "Save current page" "object.bookmark")]
        ~| 'sh-tree#debug-path-tree[variant=namespace]
          ~| 'ui-tree[slot=tree][label=Namespace hierarchy]
        ~. 'p#debug-filter-empty.debug-sidebar-empty[hidden] "No matching loaded paths."
    ~ weft/build
    ~| 'sh-sidebar#debug-sidebar[slot=sidebar][label=Contextual navigation]
      ~| 'ui-input-group#debug-filter-composer[slot=search][size=small][touch-target]
        ~| 'ui-menu#debug-root-menu[slot=prefix][label=Namespace places][density=compact][placement=bottom][align=start]
          ~| 'ui-button#debug-root-toggle.wb-icon-button[slot=trigger][size=small][variant=ghost][tone=neutral][icon-only][aria-label=Choose namespace place][title=]
            [(chrome/icon "action.search")]
          [(chrome/place "/" "Namespace" "object.tree")]
          [(chrome/place (show/path authority.snoc('app)) "Applications" "object.document")]
          [(chrome/place (show/path authority.snoc('gov)) "Groves" "object.layers")]
          [(chrome/place (show/path (publisher_vocabulary/service ['weft])) "Components" "object.folder")]
          [(chrome/place (show/path authority.snoc('log)) "Activity" "object.terminal")]
          [(chrome/place "/sys" "System" "action.settings")]
        ~| 'ui-input#debug-filter[slot=control][size=inherit][label=Filter loaded paths][placeholder=Filter paths…][autocomplete=off]
        ~| 'ui-button#debug-filter-clear.wb-icon-button[slot=suffix][size=small][variant=ghost][tone=neutral][icon-only][aria-label=Clear path filter][title=][hidden]
          [(chrome/icon "action.dismiss")]
      ~| 'ui-accordion#debug-sidebar-sections[mode=multiple][size=compact][variant=quiet]
        [(chrome/section "saved" "Saved" "object.document" "debug-saved" .true [])]
        [(chrome/section "recent" "Recent" "object.clock" "debug-history" .false [])]
        [(chrome/section "tree" "Tree" "object.tree" "debug-children" .true tree)]
  + locator
    \ target=nat
    ^ row[weft/node]
    ~ weft/build
    ~| 'div#wb-path-locator.wb-path-locator
      ~| 'nav.wb-path-trail[aria-label=Namespace location]
        ~| 'ui-scroll-area.wb-path-scroll.mash-scroll-quiet[label=Namespace ancestors][orientation=horizontal][mode=scrolling][size=medium]
          ~| 'ol.wb-path-segments
        ~| 'ui-button#wb-path-edit.wb-icon-button[type=button][size=compact][variant=ghost][tone=neutral][icon-only][aria-label=Edit namespace path][aria-controls=debug-go][aria-expanded=false][title=]
          [(chrome/icon "action.edit")]
      ~| 'form#debug-go.debug-toolbar[aria-label=Open namespace path][hidden]
        ~| 'ui-input-group#wb-path-input-group[size=small][typography=code][touch-target]
          ~# 'ui-input[name=path][slot=control][size=inherit][label=Namespace path][required]
            'value target
          ~| 'ui-button.wb-icon-button[type=submit][slot=suffix][size=compact][variant=ghost][tone=neutral][icon-only][aria-label=Open namespace path][title=]
            [(chrome/icon "navigation.forward")]
          ~| 'ui-button.wb-icon-button.wb-path-cancel[type=button][slot=suffix][size=compact][variant=ghost][tone=neutral][icon-only][aria-label=Cancel path edit][title=]
            [(chrome/icon "action.dismiss")]
  + shell
    \ authority=path target=nat workspace=grove_html
    ^ weft/node/el
    = panels
        ~ weft/build
        | chrome/sidebar authority
        workspace.kids
        ~| 'div.wb-bottom[slot=main-footer]
          ~| 'footer.debug-footer.wb-activity[hidden]
            ~. 'p#debug-status[role=status][aria-live=polite] "Snapshot loaded."
            ~| 'details
              ~. 'summary "Session activity"
              ~| 'ol#debug-activity
            ~. 'ui-button#debug-clear-activity[type=button][size=small][variant=ghost] "Clear activity"
      body
        ~ weft/build
        ~| 'header.debug-header.wb-commandbar
          [(chrome/button "debug-sidebar-toggle" "Toggle sidebar" "navigation.panel-left")]
          ~| 'ui-toolbar#debug-history-nav[label=Navigation history][data-mash-size=compact]
            [(chrome/button "debug-back" "Back" "navigation.chevron-left")]
            [(chrome/button "debug-forward" "Forward" "navigation.disclosure")]
          | chrome/locator target
          ~| 'ui-toolbar#wb-header-actions.debug-toolbar.wb-header-tools[label=Workspace actions][data-mash-size=compact]
            [(chrome/button "wb-refresh" "Refresh current record" "action.refresh")]
            [(chrome/button "debug-inspector-toggle" "Toggle inspector" "navigation.panel-right")]
        [(weft/node/el "sh-triptych"
          (workspace.as.weld([(weft/att "id" "debug-workspace")
            (weft/att "resizable" "")])) panels)]
        ~| 'div#wb-feedback.wb-feedback[role=status][aria-live=polite][hidden]
          ~| 'ui-icon[size=small][aria-hidden=true]
          ~| 'span[data-feedback-message]
          [(chrome/button "wb-feedback-dismiss" "Dismiss notification" "action.dismiss")]
        ~| 'ui-context-menu#wb-path-menu[density=compact][sizing=content][label=Path actions]
          ~| 'ui-menu-item[value=path]
            ~| 'ui-icon[slot=prefix][name=action.duplicate][size=small][aria-hidden=true]
            ~. "Copy path"
          ~| 'ui-menu-item[value=link]
            ~| 'ui-icon[slot=prefix][name=action.connect][size=small][aria-hidden=true]
            ~. "Copy link"
        ~| 'ui-clipboard#wb-path-clipboard[hidden][aria-hidden=true]
        ~| 'ui-preview-card#wb-path-preview[trigger=manual][placement=right][align=start][collision-padding=12][offset=8][data-mash-size=compact]
          ~| 'ui-scroll-area.wb-hover-scroll.mash-scroll-quiet[label=Record preview][mode=scrolling][orientation=vertical][size=medium]
        chrome/templates
    | weft/node/el "div"
      [(weft/att "class" "debug-shell")
       (weft/att "data-mash-size" "compact")
       (weft/att "data-grove-component" (show/path authority.weld(['gov 'debug 'shell])))
       (weft/att "data-grove-contract" "debugger/v1")] body
  + templates
    ' Local preferences bind values into these declared rows. Cloning a
    ' template is not permission to invent a second component hierarchy.
    ^ row[weft/node]
    ~ weft/build
    ~| 'template#debug-template-activity-entry
      ~| 'li
    ~| 'template#debug-template-page-error
      ~| 'span.debug-page-error[slot=children][role=status]
    ~| 'template#debug-template-node-status
      ~| 'div.debug-node-preview.debug-node-status[slot=preview][role=status]
        ~. 'span[data-status-message] "Loading…"
        ~| 'ui-button.wb-button[type=button][size=small][variant=ghost][tone=neutral][touch-target][hidden]
          ~| 'ui-icon.wb-icon[slot=prefix][name=action.refresh][size=small][aria-hidden=true]
          ~. 'span "Retry"
    ~| 'template#debug-template-context-note
      ~| 'p.wb-context-note[role=status]
    ~| 'template#debug-template-hover-error
      ~| 'div.wb-hover-error
        ~| 'p.wb-context-note
        ~| 'ui-button.wb-button[type=button][size=small][variant=ghost][tone=neutral][touch-target][aria-label=Retry preview]
          ~| 'ui-icon.wb-icon[slot=prefix][name=action.refresh][size=small][aria-hidden=true]
          ~. 'span "Retry"
    ~| 'template#debug-template-value-status
      ~| 'span.wb-value-status[slot=status]
    ~| 'template#debug-template-value-window
      ~| 'ui-scroll-area.wb-full-value.wb-code-scroll.mash-scroll-quiet[orientation=vertical][mode=scrolling][size=medium][style=--wb-code-limit:18rem]
        ~| 'pre
    ~| 'template#debug-template-hover-myth
      ~| 'sh-myth.wb-hover-myth[variant=preview][data-mash-size=compact]
        ~| 'a.wb-hover-path[slot=path]
        ~| 'p.wb-hover-description[slot=description][hidden]
        ~| 'span.wb-hover-meta[slot=meta]
        ~| 'span.wb-hover-note[slot=annotation][hidden]
        ~. 'a.wb-hover-open[slot=actions] "Open record"
    ~| 'template#debug-template-hover-slot
      ~| 'sh-limb
        ~| 'sh-slot[slot=label]
          ~| 'ui-button[variant=text][size=small][type=button]
        ~| 'sh-pail[slot=value]
          ~| 'a.wb-hover-value[hidden]
          ~| 'span.wb-hover-value[hidden]
    ~| 'template#debug-template-button
      ~| 'ui-button.wb-icon-button[type=button][size=compact][variant=ghost][tone=neutral][icon-only][title=]
        ~| 'ui-icon.wb-icon[size=small][aria-hidden=true][data-icon-source=Mash]
        ~| 'span[hidden]
    ~| 'template#debug-template-path-segment
      ~| 'li.wb-path-segment
        ~| 'ui-link.wb-path-ancestor[variant=quiet][size=small]
          ~| 'ui-icon.wb-icon[slot=prefix][size=small][aria-hidden=true]
          ~| 'span.wb-path-name
        ~| 'ui-menu.wb-path-menu[placement=bottom][align=start][offset=4][density=compact]
          ~| 'ui-button.wb-icon-button.wb-path-disclosure[slot=trigger][type=button][size=small][variant=ghost][tone=neutral][icon-only][title=]
            ~| 'ui-icon.wb-icon[name=navigation.disclosure][size=small][aria-hidden=true]
    ~| 'template#debug-template-path-option
      ~| 'ui-menu-item.mash-menu-rich
        ~| 'ui-icon.wb-icon[slot=prefix][size=small][aria-hidden=true]
        ~| 'span.mash-stack.wb-path-option-copy
          ~| 'strong.wb-path-option-name
          ~| 'small.wb-path-option-lede[hidden]
        ~. 'span.wb-path-option-current[slot=shortcut][hidden] "Current"
    ~| 'template#debug-template-menu-status
      ~| 'span.wb-path-menu-status[role=status]
    ~| 'template#debug-template-menu-heading
      ~| 'ui-menu-label.wb-path-menu-heading
    ~| 'template#debug-template-menu-retry
      ~| 'ui-menu-item.wb-path-menu-retry[value=:retry]
        ~| 'ui-icon.wb-icon[slot=prefix][name=action.refresh][size=small][aria-hidden=true]
        ~. "Try again"
    ~| 'template#debug-template-namespace-row
      ~| 'ui-tree-item.debug-namespace-node[kind=folder][size=small][activation=split][actions-display=overlay]
        ~| 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
        ~| 'ui-icon[slot=icon][name=object.tree][size=small][aria-hidden=true]
        ~| 'ui-path[slot=label][size=small]
          ~| 'ui-label.debug-search-label[slot=title][highlight-match=full]
        ~| 'ui-button.wb-icon-button.debug-bookmark-toggle[slot=actions][type=button][size=small][variant=ghost][tone=neutral][icon-only][title=]
          ~| 'ui-icon[name=object.bookmark][size=small][aria-hidden=true]
    ~| 'template#debug-template-path-label
      ~| 'ui-path[size=small]
        ~| 'ui-label.debug-search-label[slot=title][highlight-match=full]
    ~| 'template#debug-template-page-row
      ~| 'div.debug-page-row
        ~| 'ui-link.debug-page-link[variant=quiet][size=small]
          ~| 'ui-icon.wb-icon[slot=prefix][name=object.document][size=small][aria-hidden=true]
          ~| 'ui-label.debug-search-label[highlight-match=full]
        ~| 'ui-button.wb-icon-button[type=button][size=small][variant=ghost][tone=neutral][icon-only][title=]
          ~| 'ui-icon.wb-icon[name=action.dismiss][size=small][aria-hidden=true]

shell =
  @sewn
  #meta ;
    "/sys/lede": "Namespace debugger"
    "/sys/help": (pails/t "Versioned debugger shell. Request and response norms are checked at the component boundary.")
  #from ; request
  #to ; response
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    > (./some card) tree.fil
      (axal/new[myth] .none)
    > (./some input) (request/item/from_myth card)
      (axal/new[myth] .none)
    | grove_fragment/result (chrome/shell input.authority (str/to_atom input.target) input.workspace)
