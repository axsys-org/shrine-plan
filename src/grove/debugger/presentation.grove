web_ui =
  @slot
  ! foil
  +  badge
    '  A mash badge — the design system's chip.
    \  tone=nat s=nat
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'ui-badge[size=small]
          'tone tone
          ~. s
    markup.at(0)
  +  card
    '  A mash card: a titled pane with content kids.
    \  title=nat kids=row[weft/node]
    ^  weft/node
    = markup
        ~ weft/build
        ~| 'ui-card
          ~. 'span[slot=title] title
          ~| 'div[slot=content]
            kids
    markup.at(0)

web_lore =
  @slot
  ! foil
  +  dt_chip
    '  One doctest's verdict chip: pass/got from the verdict's
    '  results, greyed when the verdict's case is behind the node's
    '  current x case (curx as decimal text; 0 = unknown, no
    '  staleness call).
    \  verdict=doctest/verdict curx=nat j=nat
    ^  weft/node
    =  stale
         ?  (eq 0 curx)
            0
         !(eq curx (weft/show_nat verdict.case))
    ?  (ge j verdict.results.len)
       | web_ui/badge "neutral" "no result"
    ?  stale
       | web_ui/badge "neutral" (weft/cat2 "stale v" (weft/show_nat verdict.case))
    =  [_ pass got]  verdict.results.at(j)
    ?  pass
       | web_ui/badge "positive" "pass"
    | web_ui/badge "critical" (weft/cat2 "got " got)
  +  dt_row1
    '  One rendered doctest row.
    \  src=nat want=nat chip=weft/node
    ^  weft/node
    = markup
        ~ weft/build
        ~| 'div.row
          ~. "?=  "
          ~. 'span.dtsrc src
          ~. "  ->  "
          ~. 'span.dtsrc want
          [chip]
    markup.at(0)
  +  dt_rows
    '  A lore's doctests with verdict chips.
    \  doc=lore verdict=doctest/verdict curx=nat
    ^  row[weft/node]
    %  j=nat 0  out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    | _ j.inc out.snoc((web_lore/dt_row1 src want (web_lore/dt_chip verdict curx j)))
  +  dt_rows_never
    '  A lore's doctests, never yet run.
    \  doc=lore
    ^  row[weft/node]
    %  j=nat 0  out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    | _ j.inc out.snoc((web_lore/dt_row1 src want (web_ui/badge "neutral" "never run")))

web_grove =
  @slot
  ! foil
  + seed
    \ entry=[path myth]
    ^ row[weft/node]
    = [relative card] entry
    ~ weft/build
    ~. 'li (path_show relative)
  + preview
    \ authority=path source=path view=axal[myth] versions=axal[myth]
    ^ row[weft/node]
    ?> (./some card) view.fil []
    ?> (./some held) card.get(grove_templates/slot) []
    ?> template=grove_template held []
    = version=str
        ? versions.fil
         > (./some record) record.txt_at(publisher_vocabulary/version/x_data)
         > .none "0"
      seeds (template.seeds.bind(web_grove/seed))
      content
        ~ weft/build
        ~. 'p "Create an independent instance using these definitions."
        ~| 'details
          ~. 'summary "Instance records (relative to your root)"
          ~| 'ul
            seeds
        ~# 'form.wf[method=post][action=/grove/install]
          ~# 'input[type=hidden][name=source]
            'value (path_show source)
          ~# 'input[type=hidden][name=version]
            'value version
          ~# 'ui-field[required]
            'label "Instance root"
            ~# 'ui-input[slot=control][name=root][required][touch-target]
              'placeholder (path_show authority.weld(['app 'srs]))
          ~. 'ui-button[type=submit][size=small][touch-target] "Install instance"
    [(web_ui/card "Grove installation" content)]
