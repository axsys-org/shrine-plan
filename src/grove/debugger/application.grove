' Application definitions are published separately from their installed trees.
' Inspection data is a request-local projection, never a navigation write.

#import lede=sys/lede
#import weft=sys/weft
#import tack=sys/tack
#import path_type=codecs/path

authority =
  @slot
  #meta ;
    lede: "Local namespace authority"
    "/sys/help": (pails/t "The local authority path supplied with this inspection, used to keep debugger links within the selected namespace.")

target =
  @slot
  #meta ;
    lede: "Inspected path"
    "/sys/help": (pails/t "The namespace path selected for this request. Navigation supplies a new value without changing the installed input.")

view =
  @slot
  #meta ;
    lede: "Selected records"
    "/sys/help": (pails/t "The finite record tree supplied by the namespace read. It contains the selected records, not a live binding to the whole namespace.")

versions =
  @slot
  #meta ;
    lede: "Version and case metadata"
    "/sys/help": (pails/t "Version and case information supplied for the selected records, used by the inspector and version-aware links.")

operations =
  @slot
  #meta ;
    lede: "Available operations"
    "/sys/help": (pails/t "The path and operation pairs available to this inspection, used to declare the debugger's action controls.")

paging =
  @slot
  #meta ;
    lede: "Journal continuation"
    "/sys/help": (pails/t "Optional journal paging metadata: epoch, cursor, page size, total entries, and the next cursor.")

writable =
  @slot
  #meta ;
    lede: "Write permission"
    "/sys/help": (pails/t "The transport's write-permission verdict for this inspection. Presentation uses it to show or withhold mutation controls.")

scope =
  @slot
  #meta ;
    lede: "Requested presentation"
    "/sys/help": (pails/t "Selects a complete document, workspace fragment, namespace outline, or path preview from the same declared page.")

slice =
  @slot
  #meta ;
    lede: "Physical page continuation"
    "/sys/help": (pails/t "Optional read epoch, child and slot counts, and continuation cursors for the physical namespace page.")

tree_value =
  @type
  #meta ;
    lede: "Record tree codec"
    "/sys/help": (pails/t "Encodes and decodes a finite tree of namespace records through the Grove tree carrier. Used by the view and versions input slots.")
  ! foil
  axal[myth]
  + read
    \ raw=pail
    ^ maybe[tree_value]
    > value=grove_tree raw
      .none
    | ./some value.data
  + write
    \ value=tree_value
    ^ pail
    | grove_tree value
  + contract
    | curb/of_type (^ grove_tree)

operation_list =
  @type
  #meta ;
    lede: "Operation list codec"
    "/sys/help": (pails/t "Encodes and decodes the path and operation pairs supplied to the debugger's operations input slot.")
  ! foil
  row[[p=path o=op]]
  + read
    \ raw=pail
    ^ maybe[operation_list]
    > value=grove_debug_operations raw
      .none
    | ./some value.values
  + write
    \ value=operation_list
    ^ pail
    | grove_debug_operations value
  + contract
    | curb/of_type (^ grove_debug_operations)

journal_page =
  @type
  #meta ;
    lede: "Journal page codec"
    "/sys/help": (pails/t "Carries journal epoch, cursors, page size, and entry count across the application input boundary. It does not carry the journal records.")
  ! foil
  grove_debug_page
  + read
    \ raw=pail
    ^ maybe[journal_page]
    > value=grove_debug_page raw
      .none
    | ./some value
  + write
    \ value=journal_page
    ^ pail
    value
  + contract
    | curb/of_type (^ grove_debug_page)

physical_page =
  @type
  #meta ;
    lede: "Physical page codec"
    "/sys/help": (pails/t "Carries the read epoch, child and slot cursors, continuation cursors, and counts across the application input boundary.")
  ! foil
  debug_read/page
  + read
    \ raw=pail
    ^ maybe[physical_page]
    > value=debug_read/page raw
      .none
    | ./some value
  + write
    \ value=physical_page
    ^ pail
    value
  + contract
    | curb/of_type (^ debug_read/page)

permission =
  @type
  #meta ;
    lede: "Permission codec"
    "/sys/help": (pails/t "Encodes the write-permission verdict as 0 or 1 and rejects other values when decoding. This codec does not grant authority.")
  ! foil
  bool
  + read
    \ raw=pail
    ^ maybe[permission]
    > value=pails/n raw
      .none
    ? (gt value.n 1) .none
    | ./some (eq value.n 1)
  + write
    \ value=permission
    ^ pail
    | pails/n (? value 1 0)
  + contract
    | curb/of_type (^ pails/n)

presentation_scope =
  @type
  #meta ;
    lede: "Presentation scope codec"
    "/sys/help": (pails/t "Accepts only document, workspace, outline, or preview, encoded as a single path segment.")
  ! foil
  iota
  + read
    \ raw=pail
    ^ maybe[presentation_scope]
    > value=pails/p raw
      .none
    ? !(eq value.p.len 1) .none
    = scope value.p.at(0)
    ? !((eq_iota scope 'document) || (eq_iota scope 'workspace) ||
        (eq_iota scope 'outline) || (eq_iota scope 'preview)) .none
    | ./some scope
  + write
    \ value=presentation_scope
    ^ pail
    | pails/p [value]
  + contract
    | curb/of_type (^ pails/p)

inspection =
  @role
  #meta ;
    lede: "Debugger inspection input"
    "/sys/help": (pails/t "Defines the typed slots required for one inspection: authority, target, records, versions, operations, permission, and scope, with optional journal and physical paging metadata.")
  %/authority: path_type
  %/target: path_type
  %/view: tree_value
  %/versions: tree_value
  %/operations: operation_list
  %/writable: permission
  %/scope: presentation_scope
  #opt ;
    %/paging: journal_page
    %/slice: physical_page
