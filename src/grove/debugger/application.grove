' Application definitions are published separately from their installed trees.
' Inspection data is a request-local projection, never a navigation write.

#import lede=sys/lede
#import weft=sys/weft
#import tack=sys/tack
#import path_type=sys/types/path

target =
  @slot
  #meta ;
    lede: "Inspected path"

view =
  @slot
  #meta ;
    lede: "Selected records"

versions =
  @slot
  #meta ;
    lede: "Version and case metadata"

operations =
  @slot
  #meta ;
    lede: "Available operations"

paging =
  @slot
  #meta ;
    lede: "Journal continuation"

writable =
  @slot
  #meta ;
    lede: "Write permission"

scope =
  @slot
  #meta ;
    lede: "Requested presentation"

slice =
  @slot
  #meta ;
    lede: "Physical page continuation"

tree_value =
  @type
  ! foil
  axal[myth]
  + read
    \ raw=pail
    ^ maybe[tree_value]
    > value=grove_tree raw
      .none
    | ./some value.data
  + write
    \ value=tree_value
    ^ pail
    | grove_tree value
  + contract
    | curb/of_type (^ grove_tree)

operation_list =
  @type
  ! foil
  row[[p=path o=op]]
  + read
    \ raw=pail
    ^ maybe[operation_list]
    > value=grove_debug_operations raw
      .none
    | ./some value.values
  + write
    \ value=operation_list
    ^ pail
    | grove_debug_operations value
  + contract
    | curb/of_type (^ grove_debug_operations)

journal_page =
  @type
  ! foil
  grove_debug_page
  + read
    \ raw=pail
    ^ maybe[journal_page]
    > value=grove_debug_page raw
      .none
    | ./some value
  + write
    \ value=journal_page
    ^ pail
    value
  + contract
    | curb/of_type (^ grove_debug_page)

physical_page =
  @type
  ! foil
  debug_read/page
  + read
    \ raw=pail
    ^ maybe[physical_page]
    > value=debug_read/page raw
      .none
    | ./some value
  + write
    \ value=physical_page
    ^ pail
    value
  + contract
    | curb/of_type (^ debug_read/page)

permission =
  @type
  ! foil
  bool
  + read
    \ raw=pail
    ^ maybe[permission]
    > value=pails/n raw
      .none
    ? (gt value.n 1) .none
    | ./some (eq value.n 1)
  + write
    \ value=permission
    ^ pail
    | pails/n (? value 1 0)
  + contract
    | curb/of_type (^ pails/n)

presentation_scope =
  @type
  ! foil
  iota
  + read
    \ raw=pail
    ^ maybe[presentation_scope]
    > value=pails/p raw
      .none
    ? !(eq value.p.len 1) .none
    = scope value.p.at(0)
    ? !((eq_iota scope 'document) || (eq_iota scope 'workspace) ||
        (eq_iota scope 'outline) || (eq_iota scope 'preview)) .none
    | ./some scope
  + write
    \ value=presentation_scope
    ^ pail
    | pails/p [value]
  + contract
    | curb/of_type (^ pails/p)

inspection =
  @role
  #meta ;
    lede: "Debugger inspection input"
  %/target: path_type
  %/view: tree_value
  %/versions: tree_value
  %/operations: operation_list
  %/writable: permission
  %/scope: presentation_scope
  #opt ;
    %/paging: journal_page
    %/slice: physical_page
