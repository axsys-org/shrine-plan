' Debugger presentation. Application slots and roles live in application.grove;
' instance.grove declares the installed trees. Interaction attributes belong to Mash.

#import text=codecs/text

document_request =
  @norm
  #meta ;
    "/sys/lede": "Inspection request"
    "/sys/help": (pails/t "Requires the inspection role at the input tree's root: a target, finite selected records, version metadata, operations and presentation scope. This is the page's Grove input contract, not an HTTP request.")
  #here ; "/"
  #with ; inspection

page =
  @sewn
  #meta ;
    "/sys/lede": "Namespace debugger page"
    "/sys/help": (pails/t "The installed debugger's sewn renderer: accepts a checked inspection request and returns Weft markup. The host supplies finite namespace reads and write verdicts; Grove owns the document composition and Mash owns component behavior.")
  #from ; document_request
  #to ; response
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    > (./some card) tree.fil
      (axal/new[myth] .none)
    > (./some input) (document_request/item/from_myth card)
      (axal/new[myth] .none)
    | grove_fragment/result (composition/page input)

composition =
  @slot
  #meta ;
    "/sys/lede": "Debugger composition"
    "/sys/help": (pails/t "Assembles the inspection document, details panel and bounded read descriptor. The requested scope selects a full page, workspace fragment, child outline or hover preview; the full page also includes the Mash shell.")
  ! foil
  + page
    \ data=document_request/item
    ^ weft/node/el
    = tgt data.target
      view data.view
      ver data.versions
      paging data.paging
      epoch=maybe[nat]
        ? paging
         > (./some page) (./some page.epoch)
         > .none (debug_model/source_epoch ver)
      attributes
        [(weft/att "data-path" (show/path tgt))
         (weft/att "data-namespace-root" (show/path data.authority))
         (weft/att "data-scope" (show/iota data.scope))
         (weft/att "data-read-epoch" (data.slice.run((\ page (weft/show_nat page.epoch))).fall(0)))
         (weft/att "data-next-children" (data.slice.run((\ page (debug_document/key_text page.next_children))).fall(0)))
         (weft/att "data-next-slots" (data.slice.run((\ page (debug_document/key_text page.next_slots))).fall(0)))
         (weft/att "data-slot-count" (data.slice.run((\ page (weft/show_nat page.slot_count))).fall(0)))
         (weft/att "data-paging" (? (maybe/is_some paging) "journal" ""))
         (weft/att "data-page-before" (paging.run((\ page (debug_document/cursor_text page.before))).fall(0)))
         (weft/att "data-page-next-before" (paging.run((\ page (debug_document/cursor_text page.next))).fall(0)))
         (weft/att "data-page-limit" (paging.run((\ page (weft/show_nat page.limit))).fall(0)))
         (weft/att "data-page-epoch" (paging.run((\ page (weft/show_nat page.epoch))).fall(0)))
         (weft/att "data-child-count" (data.slice.run((\ page (weft/show_nat page.child_count))).fall((paging.run((\ page (weft/show_nat page.total))).fall((weft/show_nat view.kid.size))))))
         (weft/att "data-writable" (? data.writable "true" "false"))
         (weft/att "data-kind" (debug_model/kind tgt view))
         (weft/att "data-label" (debug_model/label tgt view))
         (weft/att "data-description" (debug_model/description tgt view))
         (weft/att "data-description-source" "/sys/help")]
      reference
        ~ weft/build
        | debug_explorer/docs view ver
        | debug_document/document_record tgt view epoch .false
      inspector (details/panel (path_show tgt) ver.fil.fall((myth/new)) (weft/node/el "div" [] []))
      main
        ? (eq_iota data.scope 'outline) []
        ? (eq_iota data.scope 'preview)
          ~ weft/build
          ~| 'div#wb-canvas
            ~| 'section[aria-label=Documentation]
              | debug_explorer/docs view ver
            | debug_document/document_record tgt view epoch .false
        = body (debug_document/document_body data.authority tgt view ver epoch data.operations paging data.writable)
        | body.weld((debug_document/collection_pager tgt data.slice))
      content
        ~ weft/build
        [(debug_read_descriptor/markup data)]
        ~| 'div#debug-main.tmain[slot=content][data-debug-fragment=inspect]
          main
        [inspector]
        ? (eq_iota data.scope 'preview)
          ~| 'template#debug-path-preview
            reference
    ? (eq_iota data.scope 'document)
      | chrome/shell data.authority (show/path tgt) (weft/node/el "sh-triptych" attributes content)
    | weft/node/el "div" (attributes.weld([(weft/att "id" "debug-workspace")
        (weft/att "data-grove-contract" "debugger/v1")])) content

html =
  @type
  #meta ;
    "/sys/lede": "Weft markup value"
    "/sys/help": (pails/t "Reads and writes structured Weft markup at Grove component boundaries. The value is a markup tree, not an arbitrary HTML string.")
  ! foil
  grove_html
  + read
    \ value=pail
    ^ maybe[html]
    | grove_html/read value
  + write
    \ value=html
    ^ pail
    value
  + contract
    ^ curb
    grove_html/contract

request =
  @norm
  #meta ;
    "/sys/lede": "Shell request"
    "/sys/help": (pails/t "Input contract for the shell component: local authority, displayed target and an already-composed workspace. This is distinct from the inspection request consumed by page.")
  #here ; "/"
  "/authority": path_type
  "/target": text
  "/workspace": html

response =
  @norm
  #meta ;
    "/sys/lede": "Rendered component output"
    "/sys/help": (pails/t "Output contract shared by page, shell and inspector. Its /html slot contains structured Weft markup; the HTTP adapter handles serialization and response framing.")
  #here ; "/"
  "/html": html

record =
  @type
  #meta ;
    "/sys/lede": "Namespace record value"
    "/sys/help": (pails/t "Reads and writes one namespace record, a myth, through the Grove record carrier. Used by the inspector's version input; unlike tree_value, it carries no child hierarchy.")
  ! foil
  grove_record
  + read
    \ value=pail
    ^ maybe[record]
    | grove_record/read value
  + write
    \ value=record
    ^ pail
    value
  + contract
    ^ curb
    grove_record/contract

details_request =
  @norm
  #meta ;
    "/sys/lede": "Inspector request"
    "/sys/help": (pails/t "Input contract for the inspector: the target's text path, its version record and pre-rendered reference markup. Missing case counters remain unreported rather than becoming zero.")
  #here ; "/"
  "/target": text
  "/version": record
  "/reference": html

details =
  @slot
  #meta ;
    "/sys/lede": "Cases and record details"
    "/sys/help": (pails/t "Builds the details panel's x, y and z case histories, five-case navigation windows and version rows. Case links use each lane's local data-case numbers, not namespace epochs or shape counts.")
  ! foil
  + counter
    \ name=str version=myth
    ^ maybe[nat]
    | nat/parse (version.txt_at((publisher_vocabulary/locate ['version ($ts name)])))
  + number
    \ value=maybe[nat]
    ^ nat
    | str/to_atom (value.run(nat/show).fall("—"))
  + link
    \ target=str care=str index=nat
    ^ weft/node
    = path (path_parse target).fall([])
      url (str/cat_all ["/debug/h/" care "/" (nat/show index)
        "/" (nat/show path.len) (? (eq target "/") "" target)])
    | weft/node/el "a"
      [(weft/att "class" "wb-case-link") (weft/att "href" (str/to_atom url))
       (weft/att "aria-label" (str/to_atom (str/cat_all [care " case " (nat/show index) " of " target])))]
      [(weft/tx (weft/show_nat index))]
  + cases
    \ target=str care=str version=myth
    ^ row[weft/node]
    = count (details/counter (str/cat_all [care "_data"]) version)
      shape (details/counter (str/cat_all [care "_shape"]) version)
    ~ weft/build
    ~# 'ui-accordion-item[heading-level=3][open]
      'data-care (str/to_atom care)
      'data-case-total (count.run(weft/show_nat).fall(""))
      'value (str/to_atom care)
      'title (str/to_atom (str/cat_all [care " cases"]))
      ~| 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
      ~. 'span.wb-case-counters[slot=suffix] (weft/cat [(details/number count) " data · " (details/number shape) " shape"])
      ? count
       > .none
         ~. 'p.wb-context-note "Not reported."
       > (./some total)
         ? (eq total 0)
           ~. 'p.wb-context-note "No cases."
         ? (gt total 0)
           ~# 'nav.wb-case-links
             'aria-label (str/to_atom (str/cat_all [care " case history"]))
             % index (row/range (? (gt total 5) (sub total 4) 1) total.inc)
               [(details/link target care index)]
         ? (gt total 5)
           ~| 'template[data-case-link]
             [(details/link target care 1)]
           ~| 'div.wb-case-pager
             ~# 'ui-button.wb-icon-button[data-case-older][size=compact][variant=ghost][tone=neutral][icon-only]
               'aria-label (str/to_atom (str/cat_all ["Older " care " cases"]))
               [(chrome/icon "navigation.chevron-left")]
             ~. 'span.wb-case-range[role=status] (weft/cat [(weft/show_nat (sub total 4)) "–" (weft/show_nat total) " of " (weft/show_nat total)])
             ~# 'ui-button.wb-icon-button[data-case-newer][size=compact][variant=ghost][tone=neutral][icon-only][disabled]
               'aria-label (str/to_atom (str/cat_all ["Newer " care " cases"]))
               [(chrome/icon "navigation.disclosure")]
           ~| 'form.wb-case-jump[data-debug-navigation=case]
             ~| 'ui-input-group[size=small][typography=code][touch-target]
               ~# 'input[slot=control][type=text][inputmode=numeric][placeholder=Case number]
                 'pattern "[1-9][0-9]*"
                 'aria-label (str/to_atom (str/cat_all ["Open " care " case"]))
             ~# 'ui-button.wb-icon-button[type=submit][size=compact][variant=ghost][tone=neutral][icon-only]
               'aria-label (str/to_atom (str/cat_all ["Open " care " case"]))
               [(chrome/icon "navigation.forward")]
  + panel
    \ target=str version=myth reference=grove_html
    ^ weft/node/el
    = keys=row[str] ["state" "first" "now" "block" "top"]
      body
        ~ weft/build
        ~| 'header.wb-inspector-header
          ~. 'span.wb-inspector-path "Details"
        ~| 'div.wb-declared-reference[hidden]
          ~. 'strong.wb-inspector-lede target
          ~# 'a.wb-reference-link
            'href (str/to_atom (str/cat_all ["/debug" target]))
            ~. (str/to_atom target)
          [reference]
        ~| 'section.wb-cases[aria-label=Cases and version]
          ~. 'h2.wb-section-title "Cases"
          ~| 'ui-accordion[mode=multiple][variant=quiet][size=compact]
            | details/cases target "x" version
            | details/cases target "y" version
            | details/cases target "z" version
          ~| 'section.wb-version[aria-label=Version metadata]
            ~. 'h2.wb-section-title "Version"
            % key keys
              ? (version.has((publisher_vocabulary/locate ['version ($ts key)])))
                ~| 'div.wb-meta-row
                  ~. 'code (str/to_atom (str/cat_all ["/" key]))
                  ~. 'code (str/to_atom (version.txt_at((publisher_vocabulary/locate ['version ($ts key)]))))
        ~. 'p.wb-context-note[data-inspector-hint] "Select a slot name to read its definition here."
    | weft/node/el "div"
      [(weft/att "class" "wb-inspector") (weft/att "slot" "inspector")
       (weft/att "tabindex" "-1") (weft/att "role" "region")
       (weft/att "aria-label" "Details")
       (weft/att "data-debug-fragment" "inspector")
       (weft/att "data-path" (str/to_atom target))] body

inspector =
  @sewn
  #meta ;
    "/sys/lede": "Record inspector"
    "/sys/help": (pails/t "A reusable sewn component for the target's reference, x/y/z case histories and version details. Five-case windows preserve exact counters. Missing counters are not zero, and local data cases are not namespace epochs.")
  #from ; details_request
  #to ; response
  get :
    ! foil
    \ tree=axal[myth]
    ^ axal[myth]
    > (./some card) tree.fil
      (axal/new[myth] .none)
    > (./some input) (details_request/item/from_myth card)
      (axal/new[myth] .none)
    | grove_fragment/result (details/panel input.target input.version.data input.reference)
