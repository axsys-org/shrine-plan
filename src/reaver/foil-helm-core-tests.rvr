(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

;;; Pure driver regressions compile without the web/demo bundle.
;;; helm is (sov watches crew hive); boot/reconcile return [helm duties],
;;; exec returns [helm duties rsvp spill issues].  A tell carries name,
;;; watched path, and the latest res[myth].
(define helm-sut (foil:compile-mod foil:default-subject "helm"))
(define (hlm path) (foil:source-entry-val path helm-sut))
(define app hlm)

(define helm-boot (hlm ["helm" "boot"]))
(define helm-exec (hlm ["helm" "exec"]))
(define ukeys (hlm ["uon" "keys"]))

(define t00 (app ["myth" "new"]))
(define msing (app ["myth" "sing"]))
(define pd (app ["pd"]))
(define (t-data slot n) (msing slot (pd n)))
(define (vine-make p t) ("/boot/task/vine" p ("/boot/writ/make" t)))
(define (vine-poke p t) ("/boot/task/vine" p ("/boot/writ/poke" t)))
(define (vine-cull p) ("/boot/task/vine" p "/boot/writ/cull"))
(define run-event (app ["run_event"]))
(define initial (run-event (vine-make [("ts" "io")] t00) 0 (app ["sov" "new"])))
assert(Eq "/boot/ovum/ripe" (Hd initial))
(define sov0 (_0 initial))

(define na ("ts" "a"))
(define nb ("ts" "b"))
(define nc ("ts" "c"))
(define tio ("ts" "io"))
(define slot [("ts" "s")])

;; a sovereign with /io/a and /io/b already made
(define r0a (run-event (vine-make [tio na] (t-data slot 1)) 0 sov0))
(define r0b (run-event (vine-make [tio nb] (t-data slot 2)) 0 (_0 r0a)))
(define sAB (_0 r0b))

;;; 1. boot births every existing name and sets the crew ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define b0 (helm-boot sAB))
(define hm0 (_0 b0))
(define out0 (_1 b0))
assert(Eq 2 (Sz out0))
(define d0a (Ix 0 out0))
assert(Eq "/boot/duty/birth" (Hd d0a))
assert(Equal na (_0 d0a))
assert(Eq "/boot/res/known" (Hd (_1 d0a)))
assert(Eq "/boot/duty/birth" (Hd (Ix 1 out0)))
assert(Equal nb (_0 (Ix 1 out0)))
assert(Equal [na nb] (ukeys (_2 hm0)))

;; boot on a fresh sovereign births nothing
(define bfresh (helm-boot sov0))
assert(Eq 0 (Sz (_1 bfresh)))
assert(Equal [] (ukeys (_2 (_0 bfresh))))

;;; 2. a poke to a driven name tells its actor and acks the sender ;;;;;;;;;;;;;;;;;

(define e1 (helm-exec ("/boot/maybe/some" na) (vine-poke [tio na] (t-data slot 7)) hm0))
(define hm1 (_0 e1))
(define out1 (_1 e1))
assert(Eq 2 (Sz out1))
(define d1t (Ix 0 out1))
assert(Eq "/boot/duty/tell" (Hd d1t))
assert(Equal na (_0 d1t))
;; the tell names the watched path that fired
assert(Equal [tio na] (_1 d1t))
assert(Eq "/boot/res/known" (Hd (_2 d1t)))
(define d1k (Ix 1 out1))
assert(Equal ("/boot/duty/ack" na ("/boot/rsvp/ok" ("/boot/maybe/some" [tio na]))) d1k)

;;; 3. membership: makes birth, culls fell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define e2 (helm-exec ("/boot/maybe/some" na) (vine-make [tio nc] (t-data slot 3)) hm1))
(define hm2 (_0 e2))
(define out2 (_1 e2))
;; a birth for c (no tell: it was never watched), then the ack
assert(Eq 2 (Sz out2))
assert(Eq "/boot/duty/birth" (Hd (Ix 0 out2)))
assert(Equal nc (_0 (Ix 0 out2)))
assert(Eq "/boot/duty/ack" (Hd (Ix 1 out2)))
assert(Equal [na nb nc] (ukeys (_2 hm2)))

(define e3 (helm-exec ("/boot/maybe/some" na) (vine-cull [tio nb]) hm2))
(define hm3 (_0 e3))
(define out3 (_1 e3))
assert(Eq 2 (Sz out3))
assert(Equal ("/boot/duty/fell" nb) (Ix 0 out3))
assert(Eq "/boot/duty/ack" (Hd (Ix 1 out3)))
assert(Equal [na nc] (ukeys (_2 hm3)))

;;; 4. non-/io writes stay silent; failures nack and leave the helm ;;;;;;;;;;;;;;;;

(define e4 (helm-exec ("/boot/maybe/some" nc) (vine-make [("ts" "data") ("ts" "x")] t00) hm3))
(define out4 (_1 e4))
assert(Eq 1 (Sz out4))
assert(Equal ("/boot/duty/ack" nc ("/boot/rsvp/ok" ("/boot/maybe/some" [("ts" "data") ("ts" "x")]))) (Ix 0 out4))

(define e5 (helm-exec ("/boot/maybe/some" nc) (vine-poke [("ts" "zz")] t00) (_0 e4)))
assert(Equal [("/boot/duty/ack" nc ("/boot/rsvp/no" ("ts" "poke_missing")))] (_1 e5))
;; the sovereign did not advance
assert(Eq (_2 (_0 (_0 e4))) (_2 (_0 (_0 e5))))

;; an unnamed source gets no ack duty
(define e6 (helm-exec "/boot/maybe/none" (vine-poke [tio na] (t-data slot 8)) (_0 e5)))
assert(Eq 1 (Sz (_1 e6)))
assert(Eq "/boot/duty/tell" (Hd (Ix 0 (_1 e6))))

;;; 5. persistent watches: consecutive changes both tell ;;;;;;;;;;;;;;;;;;;;;;;;;

(define e7 (helm-exec "/boot/maybe/none" (vine-poke [tio na] (t-data slot 9)) (_0 e6)))
assert(Eq 1 (Sz (_1 e7)))
assert(Eq "/boot/duty/tell" (Hd (Ix 0 (_1 e7))))
(define e8 (helm-exec "/boot/maybe/none" (vine-poke [tio nc] (t-data slot 4)) (_0 e7)))
assert(Eq 1 (Sz (_1 e8)))
assert(Equal nc (_0 (Ix 0 (_1 e8))))

;;; Persistent actor dependencies are ordinary /sys/crew state.
(define request-crew (hlm ["helm" "request_crew"]))
(define dx [("ts" "data") ("ts" "x")])
(define watch-a (helm-exec "/boot/maybe/none" (request-crew na [dx dx]) (_0 e8)))
;; Own record plus one initial dependency answer; duplicate declarations collapse.
assert(Eq 2 (Sz (_1 watch-a)))
(define watch-c (helm-exec "/boot/maybe/none" (request-crew nc [dx]) (_0 watch-a)))
assert(Eq 2 (Sz (_1 watch-c)))
(define e9 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 11)) (_0 watch-c)))
assert(Equal [na nc] (map (lambda (d) (_0 d)) (_1 e9)))
(define e10 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 12)) (_0 e9)))
assert(Equal [na nc] (map (lambda (d) (_0 d)) (_1 e10)))
(define unwatched (helm-exec "/boot/maybe/none" (request-crew na []) (_0 e10)))
(define e11 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 13)) (_0 unwatched)))
assert(Equal [nc] (map (lambda (d) (_0 d)) (_1 e11)))
;; Resume hydrates persistent declarations, without requiring registration messages.
(define resumed (helm-boot (_0 (_0 e11))))
assert(Eq 3 (Sz (_1 resumed)))
(define e12 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 14)) (_0 resumed)))
assert(Equal [nc] (map (lambda (d) (_0 d)) (_1 e12)))

;;; Name equality includes payload and aura; no prefix or shallow match.
(define has-name (hlm ["has_name"]))
assert(Eq 0 (has-name na []))
assert(Eq 1 (has-name na [nb na]))
assert(Eq 0 (has-name na [nb]))
assert(Eq 0 (has-name na [("tu" "a")]))
(define from-keys (hlm ["uon" "from_keys"]))
(define index (from-keys 42 [nb na nb]))
assert(Equal [na nb] (ukeys index))
assert(Eq 42 ((hlm ["uon" "gut"]) na 0 index))
assert(Equal [] (ukeys (from-keys 42 [])))

;;; Outbound moves require both an /io destination and an inherited grant.
(define io-bound (hlm ["io_bound"]))
assert(Eq 0 (io-bound []))
assert(Eq 1 (io-bound [tio]))
assert(Eq 1 (io-bound [tio na]))
assert(Eq 0 (io-bound [("tu" "io") na]))
(define grants [("ts" "grants") ("ts" "fetch")])
(define owner [("ts" "app") ("ts" "owner")])
(define child (snoc ("ts" "child") owner))
(define allow (run-event (vine-make owner (t-data grants 1)) 0 sov0))
assert(Eq "/boot/ovum/ripe" (Hd allow))
(define allowed (_0 allow))
(define granted-fetch (hlm ["granted_fetch"]))
assert(Eq 0 (granted-fetch owner sov0))
assert(Eq 1 (granted-fetch owner allowed))
assert(Eq 1 (granted-fetch child allowed))
assert(Eq 0 (granted-fetch [("ts" "unrelated")] allowed))
;; Preserve additive inheritance: a zero slot is not a revocation.
(define zero-child (run-event (vine-make child (t-data grants 0)) 0 allowed))
assert(Eq 1 (granted-fetch child (_0 zero-child)))
(define moves (hlm ["helm" "moves"]))
(define target [tio ("ts" "request")])
(define outgoing ("/boot/move" child target ("/boot/writ/make" t00)))
(define dropped (moves (_0 (helm-boot sov0)) [outgoing]))
assert(Equal sov0 (_0 (_0 dropped)))
assert(Equal [] (_1 dropped))
(define delivered (moves (_0 (helm-boot allowed)) [outgoing]))
assert(Eq 1 (Sz (_1 delivered)))
assert(Eq "/boot/res/known" (Hd ((hlm ["sov" "x_latest"]) target (_0 (_0 delivered)))))
(define pulsed ((hlm ["helm" "reconcile"]) (_0 (helm-boot allowed))
  ((hlm ["helm" "signs"]) (_1 delivered)) (_0 delivered)))
assert(Eq "/boot/duty/birth" (Hd (Ix 0 (_1 pulsed))))
assert(Equal ("ts" "request") (_0 (Ix 0 (_1 pulsed))))
(define outside ("/boot/move" child [("ts" "elsewhere")] ("/boot/writ/make" t00)))
assert(Equal [] (_1 (moves (_0 (helm-boot allowed)) [outside])))

;;; The direct reply and spill survive the shared acknowledgement path.
assert(Equal ("/boot/rsvp/ok" ("/boot/maybe/some" [tio na])) (_2 e1))
assert(Equal "/boot/maybe/none" (_3 e1))
assert(Equal ("/boot/rsvp/no" ("ts" "poke_missing")) (_2 e5))
assert(Equal "/boot/maybe/none" (_3 e5))
(define anonymous-failure (helm-exec "/boot/maybe/none"
  (vine-poke [("ts" "absent")] t00) hm0))
assert(Equal hm0 (_0 anonymous-failure))
assert(Equal [] (_1 anonymous-failure))
assert(Equal ("/boot/rsvp/no" ("ts" "poke_missing")) (_2 anonymous-failure))
;;; A batch reconciles once: final values, transient births, and incarnation restarts.
(define (batch h tasks)
  (define advanced
    (foldl (lambda (acc task)
             (let* ((r ((hlm ["helm" "run"]) task (_0 acc)))
                    (g (_1 r)))
               (Seq (If (Eq "/boot/gyre/spun" (Hd g)) 0 (error ["batch failed" g]))
                 [(_0 r) (Weld (_1 acc) (_2 g))])))
      [h []] tasks))
  ((hlm ["helm" "reconcile"]) h ((hlm ["helm" "signs"]) (_1 advanced)) (_0 advanced)))
(define final-tells (batch hm0 [(vine-poke [tio na] (t-data slot 20))
                              (vine-poke [tio na] (t-data slot 21))]))
assert(Eq 1 (Sz (_1 final-tells)))
assert(Eq 21 ((hlm ["myth" "nat_at"]) slot 0 (_0 (_2 (Ix 0 (_1 final-tells))))))
(define reverted (batch hm0 [(vine-poke [tio na] (t-data slot 20))
                            (vine-poke [tio na] (t-data slot 1))]))
assert(Eq 1 (Sz (_1 reverted)))
(define transient (batch hm0 [(vine-make [tio nc] t00) (vine-cull [tio nc])]))
assert(Equal [] (_1 transient))
(define restart (batch hm0 [(vine-cull [tio na]) (vine-make [tio na] t00)]))
assert(Equal ["/boot/duty/fell" "/boot/duty/birth"] (map Hd (_1 restart)))
(define only-dead (batch hm0 [(vine-cull [tio na])]))
assert(Equal [("/boot/duty/fell" na)] (_1 only-dead))
;; A structural /io spine with a live grandchild does not itself become an actor.
(define structural (helm-exec "/boot/maybe/none" (vine-make [tio nc ("ts" "leaf")] t00) hm0))
assert(Equal [] (_1 structural))
;; Watching another actor never displaces its implicit own-record dependency.
(define cross (helm-exec "/boot/maybe/none" (request-crew nb [[tio na]]) hm0))
(define crossed (helm-exec "/boot/maybe/none" (vine-poke [tio na] (t-data slot 22)) (_0 cross)))
assert(Equal [na nb] (map (lambda (d) (_0 d)) (_1 crossed)))
;; Removal of a watching actor leaves no pending delivery for that actor.
(define killed (batch (_0 cross) [(vine-cull [tio nb]) (vine-poke [tio na] (t-data slot 23))]))
assert(Equal ["/boot/duty/fell" "/boot/duty/tell"] (map Hd (_1 killed)))

;;; A granted move's cascade can change a non-IO dependency index.
(#bind rex (#module rex))
(define fixture
  (foil:compile-rex foil:default-subject "helm-fixture"
    (rex:ParseRexNorm "
- sept [order=10]
- shrine_types [order=20]
- shrine [order=30]
- lain_types [order=38]
- lain_peek [order=39]
- lain_poke [order=40]
+ redirect
  \ b=bowl cur=myth news=row[dep]
  ^ yell
  | yell [] cur.put(crew_slot (cpail (crew/sing ['next] (dep .x ['other]))))
+ redirect_form
  ^ form
  def_form.set_hear(redirect)
+ subscriber
  ^ myth
  (kooked [['redirect]]).put(crew_slot (cpail (crew/sing ['source] (dep .x ['io 'request]))))
+ emit
  \ b=bowl cur=myth
  ^ yell
  | yell [[['io 'absent] (writ/poke myth/new)]
          [['io 'request] (writ/make (kooked [['secondary]]).put(['grants 'fetch] (pd 1)))]] cur
+ emit_form
  ^ form
  def_form.set_init(emit)
+ secondary
  \ b=bowl cur=myth
  ^ yell
  | yell [[['io 'second] (writ/make myth/new)]] cur
+ secondary_form
  ^ form
  def_form.set_init(secondary)
+ sender
  ^ myth
  (kooked [['emitter]]).put(['grants 'fetch] (pd 1))
+ identity
  \ t=myth
  ^ myth
  t
+ overlay_record
  ^ myth
  | myth/sing ['sys 'weft] (dyed identity .none)
+ derived_watch
  ^ myth
  | myth/sing crew_slot
  | cpail
  | crew/sing ['derived] (dep .x ['o ($u 1) ($u 1) 'overlay ($u 1) 'data])
+ subtree_watch
  ^ myth
  | myth/sing crew_slot (cpail (crew/sing ['tree] (dep .z ['data])))
")))
(define (fixture-val p) (foil:source-entry-val p fixture))
(define install-form (run-event (vine-make [("ts" "redirect")]
  (msing [("ts" "form")] (fixture-val ["redirect_form"]))) 0 allowed))
(define install-sub (run-event (vine-make [("ts" "subscriber")] (fixture-val ["subscriber"])) 0 (_0 install-form)))
(define indexed (moves (_0 (helm-boot (_0 install-sub))) [outgoing]))
assert(Equal ((hlm ["hive_of"]) (_0 (_0 indexed))) (_3 (_0 indexed)))
assert(Equal [] (_2 indexed))
(define bad-move ("/boot/move" child [tio ("ts" "absent")] ("/boot/writ/poke" t00)))
(define mixed (moves (_0 (helm-boot allowed)) [bad-move outgoing]))
assert(Equal [("/boot/delivery_issue" [tio ("ts" "absent")] ("ts" "poke_missing"))] (_2 mixed))
assert(Eq "/boot/res/known" (Hd ((hlm ["sov" "x_latest"]) target (_0 (_0 mixed)))))
;; Cared subtree dependencies carry the whole final view, including on hydration.
(define data-root (helm-exec "/boot/maybe/none" (vine-make [("ts" "data")] t00) hm0))
(define tree-watch (helm-exec "/boot/maybe/none" (vine-poke [tio na] (fixture-val ["subtree_watch"])) (_0 data-root)))
assert(Equal ["/boot/duty/tell" "/boot/duty/view"] (map Hd (_1 tree-watch)))
(define tree-change (helm-exec "/boot/maybe/none" (vine-make [("ts" "data") ("ts" "child")] t00) (_0 tree-watch)))
assert(Equal ["/boot/duty/view"] (map Hd (_1 tree-change)))

(define overlay-installed (helm-exec "/boot/maybe/none"
  (vine-make [("ts" "overlay")] (fixture-val ["overlay_record"])) (_0 data-root)))
(define derived-subscribed (helm-exec "/boot/maybe/none"
  (vine-poke [tio na] (fixture-val ["derived_watch"])) (_0 overlay-installed)))
assert(Eq 2 (Sz (_1 derived-subscribed)))
assert(Eq "/boot/res/known" (Hd (_2 (Ix 1 (_1 derived-subscribed)))))
(define derived-updated (helm-exec "/boot/maybe/none"
  (vine-poke [("ts" "data")] (t-data slot 99)) (_0 derived-subscribed)))
assert(Eq 1 (Sz (_1 derived-updated)))
assert(Eq 99 ((hlm ["myth" "nat_at"]) slot 0 (_0 (_2 (Ix 0 (_1 derived-updated))))))

(print "helm core tests passed")
