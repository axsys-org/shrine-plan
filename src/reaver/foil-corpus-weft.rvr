(#bind std (#module std))
(#import std)

(#bind foil (#module foil))
(#bind prev (#module foil-corpus-shrine))

;;; Corpus tier 3: weft and tyshow (see foil-corpus-sept).

(define wresult
  (foil:compile-mod-cached prev:cache foil:default-subject "weft"))
(define weft-sut (_1 wresult))
(define result
  (foil:compile-mod-cached (_0 wresult) foil:default-subject "tyshow"))
(define cache (_0 result))
(define tyshow-sut (_1 result))


;; The loader records these stamps into this module's cache entry: the
;; tier re-executes (recompiling only what the warm chain below it
;; does not already carry) when any compiled source changes.
(define module-file-stamps (foil:foil-closure-files ["weft" "tyshow"]))

(#export module-file-stamps cache weft-sut tyshow-sut)
