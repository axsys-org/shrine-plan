(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind context (#module foil-context))
(#bind brand (#module shrine-brand))
(#bind subject (#module foil-subject))
(#bind elab (#module foil-new-elab))
(define root [["x" 1] ["ts" "library"]])
(define path (snoc ["ts" "thing"] root))
(define publication (Pin ["system-fixture" 1]))
(define sources (Pin ["compiler-fixture" "source-fixture"]))
(define one (context:create publication (Pin "compiler") sources [["source" root]] [["source" [[path 1]]]] []))
(define two (context:create publication (Pin "compiler") sources [["source" root]] [["source" [[path 2]]]] []))
(define relocated
  (context:create publication (Pin "compiler") sources [["relocated" root]] [["relocated" [[path 1]]]] []))
(define a (context:module one "source"))
(define b (context:module two "source"))
(define c (context:module relocated "relocated"))
assert(Equal [[path 1]] (brand:decode (context:runtime-brand a ["thing"])))
assert(Nil (Eq (context:runtime-brand a ["thing"])
              (context:runtime-brand b ["thing"])))
assert(Eq (context:runtime-brand a ["thing"])
          (context:runtime-brand c ["thing"]))
assert(Nil (Equal (context:storage-root a) (context:storage-root b)))
assert(Nil (Equal (context:cache-key one "source")
                 (context:cache-key two "source")))
(define (fails f) (Eq 1 (Hd (Try (lambda (z) (force (f z))) 0))))
assert(fails (lambda (z) (context:runtime-brand a ["missing"])))
assert(fails (lambda (z) (context:module one "missing")))
assert(fails (lambda (z) (context:require-context 0)))
assert(fails (lambda (z) (subject:definition-brand subject:empty-subject ["old"])))
assert(fails (lambda (z) (elab:elab-mod
  (elab:compiler-for subject:empty-subject) [])))
assert(fails (lambda (z) (context:create 0 (Pin "compiler") sources [["source" root]] [["source" [[path 1]]]] [])))
assert(fails (lambda (z) (context:create publication (Pin "compiler") sources
  [["source" root] ["source" root]] [["source" [[path 1]]]] [])))
assert(fails (lambda (z) (context:create publication (Pin "compiler") sources
  [["source" root]] [["source" [[path 1] [path 2]]]] [])))
assert(fails (lambda (z) (context:create publication (Pin "compiler") sources
  [["source" root]] [["source" [[path 0]]]] [])))

(define coexist (context:create publication (Pin "compiler") sources
  [["old" root] ["new" root]]
  [["old" [[path 1]]] ["new" [[path 2]]]] []))
assert(Eq (context:runtime-brand a ["thing"])
  (context:runtime-brand (context:module coexist "old") ["thing"]))
assert(Eq (context:runtime-brand b ["thing"])
  (context:runtime-brand (context:module coexist "new") ["thing"]))
assert(Equal [["thing"]] (context:local-definition a [path 1]))
assert(Equal 0 (context:local-definition a [path 2]))
assert(Equal [["thing"]] (context:local-definition c [path 1]))

;; Assignment enumeration order is publisher metadata, not storage identity.
(define another (snoc ["ts" "another"] root))
(define ordered (context:create publication (Pin "compiler") sources
  [["source" root]] [["source" [[path 1] [another 2]]]] []))
(define reversed (context:create publication (Pin "compiler") sources
  [["source" root]] [["source" [[another 2] [path 1]]]] []))
assert(Equal (context:storage-root (context:module ordered "source"))
  (context:storage-root (context:module reversed "source")))
