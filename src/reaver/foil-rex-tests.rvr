;;;; Rex bindings preserve native wire layouts and compiler interoperability.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind source (#module foil-source))
(#bind foil (#module foil-new-env))

(define (check z)
  (define loaded (source:compile 0 "test_fixtures/rex_example"))
  (define sut (foil:perc-subject (_1 loaded)))
  (define (fn name)
    (foil:source-entry-val
      [(If (includes (Eq name) ["parse" "parse_blocks" "parse_block" "normalize" "print"]) "rex_ffi" "rex") name] sut))
  (define span [2 3 5 7])
  (define leaf (rex:MakeLeaf span "word" "x"))
  (define native
    [leaf
     (rex:MakeNest span "paren" "" [leaf])
     (rex:MakeExpr span "paren" [leaf])
     (rex:MakePref span "!" leaf)
     (rex:MakeTyte span "/" [leaf leaf])
     (rex:MakeBloc span "clear" ";" leaf [leaf])
     (rex:MakeOpen span "+" [leaf])
     (rex:MakeJuxt span [leaf])
     (rex:MakeHeir span [leaf])])
  (define bound
    [((fn "leaf") span "word" "x")
     ((fn "nest") span "paren" "" [leaf])
     ((fn "expr") span "paren" [leaf])
     ((fn "pref") span "!" leaf)
     ((fn "tyte") span "/" [leaf leaf])
     ((fn "bloc") span "clear" ";" leaf [leaf])
     ((fn "open") span "+" [leaf])
     ((fn "juxt") span [leaf])
     ((fn "heir") span [leaf])])
  assert(Equal native bound)
  assert(Equal span ((fn "make_span") 2 3 5 7))
  (DeepSeq (map (lambda (tree)
    assert(Equal (rex:NormalizeRex tree) ((fn "normalize") tree))
    assert(Equal (rex:PrintRex tree) ((fn "print") tree))
    assert(Equal tree ((fn "with_span") span tree))
    assert(Equal [9 8 7 6] ((fn "span") ((fn "with_span") [9 8 7 6] tree)))
    assert(Equal tree ((fn "map_children") (lambda (kid) kid) tree))
    1) native) 0)
  (define texts
    ["(f x)" "[a b]" "{}" "a.b(c)" "!x" "+ a 1"
     "+ a 1

+ b 2" "'quoted" "' hello
+ x 1"
     (strcat [34 "hello λ" 34])])
  (DeepSeq (map (lambda (text)
    (define parsed ((fn "parse") text))
    assert(Equal "ok" (Hd parsed))
    assert(Equal (rex:ParseRexFile text) (_0 parsed))
    assert(Equal (rex:ParseRexNormFile text) (_0 ((fn "parse_normalized") text)))
    assert(Equal (rex:PrintRex (rex:ParseRexFile text)) ((fn "print") (_0 parsed)))
    1) texts) 0)
  ;; Preserve native empty-input and block-boundary behavior, including errors.
  (DeepSeq (map (lambda (text)
    (define expected (Try (lambda (s) (DeepSeq (rex:ParseRex s) (rex:ParseRex s))) text))
    (define actual ((fn "parse_block") text))
    assert(Equal (If (Eq 0 (Hd expected)) "ok" "err") (Hd actual))
    assert(Equal (_0 expected) (_0 actual))
    1) ["" "(f x)" "+ a 1

+ b 2" ")"]) 0)
  (DeepSeq (map (lambda (text)
    (define parsed ((fn "parse_blocks") text))
    assert(Equal "ok" (Hd parsed))
    assert(Equal (rex:ParseRexBlocks text) (_0 parsed))
    1) ["" "   " "grade =
  @type

due =
  @slot" "' comment

meta :
  sys/title: 1"]) 0)
  (define bad-blocks ((fn "parse_blocks") ")"))
  assert(Equal "ok" (Hd bad-blocks))
  assert(Equal (rex:ParseRexBlocks ")") (_0 bad-blocks))
  (define empty-native (Try (lambda (s) (DeepSeq (rex:ParseRexFile s) (rex:ParseRexFile s))) ""))
  (define empty-bound ((fn "parse") ""))
  assert(Equal (If (Eq 0 (Hd empty-native)) "ok" "err") (Hd empty-bound))
  assert(Equal (_0 empty-native) (_0 empty-bound))
  (define bad ((fn "parse") (strcat [34])))
  assert(Equal "ok" (Hd bad))
  assert(Equal (rex:ParseRexFile (strcat [34])) (_0 bad))
  (define generated (foil:source-entry-val ["rex_example" "generated"] sut))
  (define compiled (source:compile-rex (_0 loaded) "rex_generated" generated))
  assert(Equal 42 (foil:get-perc ["answer"] (_1 compiled)))
  (define rewritten ((foil:source-entry-val ["rex_example" "rewrite_add"] sut) "+ old 1"))
  assert(Equal "ok" (Hd rewritten))
  (define compiled2 (source:compile-rex (_0 compiled) "rex_rewritten" (rex:ParseRexNormFile (_0 rewritten))))
  assert(Equal 1 (foil:get-perc ["new"] (_1 compiled2)))
  assert(Equal 42 (foil:get-perc ["answer"] (_1 compiled2)))
  1)
assert(Equal 1 (check 0))
