;;;; foil-render tests — diagnostics and type rendering, moved from
;;;; forge-tests when the renderers hoisted out of forge.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-render (#module foil-render))
(#bind ty (#module foil-types))
(#bind nt (#module foil-new-types))
(#bind foil-subject (#module foil-subject))

;;; Diagnostic rendering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define diag-nat (ty:TNAT 0))
(define diag-bst-nat
  (ty:TNOM (foil-subject:ty-ap-encode [["bst"] ["nat"]]) 0))

;; elab errors: message, location, label/value details with types decoded.
assert(Equal
  ["cast (^) target does not accept the value's type"
   "  at line 12, col 4"
   "  want: /bst[/nat]"
   "  got: nat"]
  (foil-render:diag-lines
    ["foil-elab-error" "cast (^) target does not accept the value's type"
     ["at" ["line" 12 "col" 4]]
     ["want" diag-bst-nat "got" diag-nat]]))

;; sast errors: message and location; the raw node stays out of view.
assert(Equal
  ["wack rune" "  at line 3, col 1"]
  (foil-render:diag-lines
    ["foil-sast-error" "wack rune" ["at" ["line" 3 "col" 1]] 0]))

;; module wf diags: one line per decl, tagged paths decoded.
assert(Equal
  ["types are not well-formed"
   "  in /bad_lam (line 2, col 3): bad type reference /bogus"]
  ;; tagged ["path" p] payload entries decode through path-text
  (foil-render:diag-lines
    ["foil-type-wf"
     [["in-decl" ["bad_lam"]
       ["bad type reference" ["path" ["bogus"]]]
       ["line" 2 "col" 3]]]]))

;; import diagnostics
assert(Equal
  ["import cycle: module vec is already being imported"
   "  at line 1, col 1"]
  (foil-render:diag-lines
    ["foil-import-cycle" ["module" "vec"] ["at" ["line" 1 "col" 1]]]))
assert(Equal
  ["import collision: /vec is declared more than once"
   "  at line 3, col 1"]
  (foil-render:diag-lines
    ["foil-import-collision" ["path" ["vec"]] ["at" ["line" 3 "col" 1]]]))
assert(Equal
  ["duplicate declaration: /vec/frob is declared more than once"
   "  at line 4, col 1"]
  (foil-render:diag-lines
    ["foil-duplicate-decl" ["path" ["vec" "frob"]] ["at" ["line" 4 "col" 1]]]))

;; per-decl elaboration failures list every failed decl
assert(Equal
  ["the module does not elaborate"
   "  in /bad_one:"
   "    boom"]
  (foil-render:diag-lines ["foil-elab-errors" [[["bad_one"] "boom"]]]))

;; module attribution nests
assert(Equal
  ["in module vecapp:"
   "  types are not well-formed"
   "    in /bad (line 2, col 3): bad type reference /bogus"]
  (foil-render:diag-lines
    ["foil-in-module" "vecapp"
     ["foil-type-wf"
      [["in-decl" ["bad"]
        ["bad type reference" ["path" ["bogus"]]]
        ["line" 2 "col" 3]]]]]))

;; constant nats and symbols display as themselves
assert(Equal "7" (foil-render:ty-text (ty:TNAT 7)))
assert(Equal "'$foo" (foil-render:ty-text (ty:TNAT "foo")))
assert(Equal "nat" (foil-render:ty-text (ty:TNAT 0)))

;; unknown location and unknown shapes degrade gracefully.
assert(Equal
  ["boom" "  at unknown location"]
  (foil-render:diag-lines
    ["foil-sast-error" "boom" ["at" "unknown-location"] 0]))
assert(Equal [(foil-render:render-plain ("some" 5))]
  (foil-render:diag-lines ("some" 5)))

;;; Doctest result lines ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Equal "  pass  3" (foil-render:dt-res-line ["pass" "3" 20 20]))
assert(Equal "  fail  3    got 20  want 21"
  (foil-render:dt-res-line ["fail" "3" 20 21]))

;; Aura'd nats render as nat/<aura>; plain nat stays "nat".
assert(Equal "nat" (foil-render:new-ty-text (nt:tnat 0)))
assert(Equal "nat/ts" (foil-render:new-ty-text (nt:tnat "ts")))
assert(Equal "nat/dr" (foil-render:new-ty-text (nt:tnat "dr")))

(print "foil-render tests passed")
