
(#bind reef (#module reef))
(#import reef)
(#bind bits (#module bits))
(#import bits)
(#bind bplan (#module bplan))
(#import bplan)




(define (assert-prop-impl expr count each gen f)
  (define (go count rand)
    (print ("go" expr count gen f))
    (define eny (gen (ltake 4 rand)))
    (Ifz count 0
      (If (f eny) (go (Dec count) (ldrop each rand))
        (error
          ("assert-prop"
           "seed" (ltake count rand)
           "fail" expr)))))

  (print ("assert-prop-impl" expr count gen f))
   (go count (rand-words (Now 0))))

(define-syntax (assert-prop form)
  (#let
    ((n (Ix1 form))
     (each (Ix2 form))
     (gen (Ix3 form))
     (f (Ix4 form)))
   [(1 (assert-prop-impl f)) n each gen f]))
