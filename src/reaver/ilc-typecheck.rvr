;; The function below calls the production expression checker. Its derivative
;; is generated from PLAN laws by ilc; there is no checker-specific rule.
(#bind std (#module std))
(#import std)
(#bind ilc (#module ilc))
(#bind elab (#module foil-new-elab))

(define (check input) (elab:elab-value (_0 input) (_1 input)))
(define (derivative rules) (ilc:derive-with rules check))
(define (update derived input output dx)
  (ilc:apply-change output (derived input dx)))
(#export check derivative update)
