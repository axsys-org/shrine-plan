;;; Namespace path macros ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The runtime spells namespace paths three ways: entry-key rows
;; (["myth" "new"]), ts-quip segments (("ts" "io")), and node paths
;; ([("ts" "kook") ("ts" "llm")]).  Adjacent word+string parses as an
;; application (p"myth/new" is (p "myth/new")), so these macros read
;; like reader macros:
;;
;;   p"myth/new"    -> ["myth" "new"]              entry-key row
;;   t"io"          -> ("ts" "io")                 one ts segment
;;   n"kook/llm"    -> [("ts" "kook") ("ts" "llm")] node path
;;   a"myth/new"    -> (app ["myth" "new"])        entry lookup
;;
;; They ride (#import helm) into the other helm-* modules.
;;
;; CAUTION: `a` is deliberately unhygienic — it expands to a call of
;; whatever `app` is bound at the use site (the (app path) helpers in
;; helm-run's build-lain-sov and serve-lain).  Where no `app` is in
;; scope it is silently junk (#export gating rules); use (app p"...")
;; anywhere hygiene is in doubt.

;; Expansion-time cord split on "/".  Offset walk with Load8 — never
;; advance a cord by division (that is the quadratic §4 trap even at
;; expansion time).
(define (path-seg-slice off len s)
  (Trunc (Mul 8 len) (Rsh s (Mul 8 off))))
;; A string literal reaches a transformer as the quote node (1 cord);
;; a bare word arrives as the cord itself.  Accept both, refuse the rest.
(define (path-macro-str ctx x)
  (cond
    ((IsNat x) x)
    ((And (IsApp x) (Eq 1 (Hd x))) (_0 x))
    (else
      (error ["helm-path-macro" "path must be a string literal"
              ["at" ctx]]))))
(define (path-macro-segs ctx s0)
  (define s (path-macro-str ctx s0))
  (define nb (Bytes s))
  (define (emit start i acc)
    (define seg (path-seg-slice start (Sub i start) s))
    (unless (Gt (Bytes seg) 0)
      (error ["helm-path-macro" "empty path segment" ["in" s] ["at" ctx]])
      (lcons seg acc)))
  (define (go start i acc)
    (cond
      ((Ge i nb) (rowify (lrev (emit start i acc))))
      ((Eq "/" (Load8 i s)) (go (Inc i) (Inc i) (emit start i acc)))
      (else (go start (Inc i) acc))))
  (unless (Gt nb 0)
    (error ["helm-path-macro" "empty path" ["at" ctx]])
    (go 0 0 0)))

;; Each expansion is built from quoted constants, so the emitted form
;; is pure syntax: a "#brak" row of quoted cords (p), an application
;; of the quoted "ts" tag (t), or both (n).
;;
;; A juxt in call position folds its arguments into the same form —
;; (a"build/eval_req" "demo") arrives as (a "build/eval_req" "demo") —
;; so every macro re-applies the expansion to the trailing elements.
(define (path-macro-call base form)
  (If (Gt (Sz form) 2)
    (Weld [base] (drop 2 form))
    base))

(define-syntax (p form)
  (path-macro-call
    (cons "#brak"
      (map (lambda (seg) (1 seg)) (path-macro-segs form (_1 form))))
    form))

(define-syntax (t form)
  (path-macro-call
    [(1 "ts") (1 (path-macro-str form (_1 form)))]
    form))

(define-syntax (n form)
  (path-macro-call
    (cons "#brak"
      (map (lambda (seg) [(1 "ts") (1 seg)])
        (path-macro-segs form (_1 form))))
    form))

(define-syntax (a form)
  (path-macro-call
    ["app" (cons "#brak"
             (map (lambda (seg) (1 seg)) (path-macro-segs form (_1 form))))]
    form))

;; ent"myth/new" is (core-ent core ["myth" "new"]) — the core-entry
;; lookup.  Unhygienic over `core`, the way `a` is over `app`.
(define-syntax (ent form)
  (path-macro-call
    ["core-ent" "core"
     (cons "#brak"
       (map (lambda (seg) (1 seg)) (path-macro-segs form (_1 form))))]
    form))

;;; Boot value helpers (plain functions — nothing syntactic here) ;;;;;;;;;;;;;;;
;;
;; Maybe probes for the "/boot/maybe/some"-branded rows the mirror and
;; doctest plumbing pass around, and by-rep pail constructors for the
;; mirror's seed writes.  The rep- prefix is deliberate: mirror seeding
;; constructs pails by representation (the mani precedent) — pokes from
;; rvr hosts still go through lain's pd/pt, never these.
(define (boot-some? x) (Eq "/boot/maybe/some" (Hd x)))
(define (boot-some v) ("/boot/maybe/some" v))
(define (rep-pail-n v) ("/boot/pails/n" v))
(define (rep-pail-ps v) ("/boot/pails/ps" v))
(define (rep-pail-code v) ("/boot/pails/code" v))
(define (rep-pail-code? x) (Eq "/boot/pails/code" (Hd x)))

assert(Equal ["myth" "new"] p"myth/new")
assert(Equal ["peek"] p"peek")
assert(Equal ("ts" "io") t"io")
assert(Equal [("ts" "kook") ("ts" "llm")] n"kook/llm")
(define (path-macro-a-check app)
  a"myth/new")
assert(Equal ["got" ["myth" "new"]]
  (path-macro-a-check (lambda (x) ["got" x])))
(define (path-macro-ent-check core-ent core)
  ent"myth/new")
assert(Equal ["ce" "c" ["myth" "new"]]
  (path-macro-ent-check (lambda (c x) ["ce" c x]) "c"))
assert(Eq 1 (boot-some? (boot-some 5)))
assert(Equal ("/boot/pails/n" 7) (rep-pail-n 7))
;; call position folds trailing args into the juxt's form
(define (path-macro-a-check-args app)
  (a"myth/new" 7))
assert(Equal ["got" ["myth" "new"] 7]
  (path-macro-a-check-args (lambda (x y) ["got" x y])))


;;; The IO driver shell: real enki actors around the pure helm core
;;; (src/foil/helm.foil).  The coordinator actor owns the helm state
;;; and a roster of one worker actor per /io name; it executes the
;;; core's duties and shuttles messages.  All decisions are the
;;; core's.
;;;
;;; Coordinator mailbox protocol (msg, caps):
;;;   ["cmd" name task]   from a worker: run the task, ack the worker
;;;   ["task" task]       external injection; replies ["done"] to the
;;;                       cap — the synchronous barrier drivers use
;;;   ["query" path]      replies the committed record (res shape)
;;;   ["case" path]       replies ["cres" path maybe[nat]] — the
;;;                       node's current version
;;;   ["crew" ]           replies the roster's names
;;;   ["handle" name]     replies ["handle"] with the worker handle as
;;;                       a capability (or ["nohandle"])
;;;   ["stop"]            kills the roster, replies ["bye"], exits
;;;
;;; Worker protocol (coordinator -> worker):
;;;   ["go" res]     first message; caps = [coordinator-handle]
;;;   ["change" res] the name's new committed record
;;;   ["ack" rsvp]   the outcome of a command this worker sent
;;;   ["die"]        the name was removed
;;; Workers send ["cmd" name task] to the coordinator handle.

;;; Core loading ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Compile a helm-importing module once; returns the core functions
;; the shell needs plus the compiled subject (so callers can pull
;; their own app entries from the SAME compilation — one chain walk)
;; and the per-module compile cache (so the /boot mirror knows which
;; file declared which entry): ["HELM" boot exec x-query spy sut cache].
;; Pack a compile result [cache sut] as the core row.  The query slot
;; is /h-aware: the coordinator's query/read verbs serve the temporal
;; overlay as well as live paths.
(define (helm-pack r)
  (define sut (_1 r))
  ;; sv, not ent: `ent` is the core-entry macro above, and this local
  ;; reads source entries off a fresh compile instead.
  (define (sv path) (foil:source-entry-val path sut))
  ["HELM" (sv ["helm" "boot"]) (sv ["helm" "exec"]) (sv ["x_query_h"])
   (sv ["helm" "spy"]) sut (_0 r)])

(define (load-helm-mod mod)
  (helm-pack (foil:compile-mod-cached 0 foil:default-subject mod)))

;; The bare driver chain.  The argument is ignored (a zero-argument
;; define does not reduce when applied).
(define (load-helm z)
  (load-helm-mod "helm"))

(define (core-boot c) (Ix 1 c))
(define (core-exec c) (Ix 2 c))
(define (core-xq c) (Ix 3 c))
(define (core-spy c) (Ix 4 c))
(define (core-sut c) (Ix 5 c))
(define (core-cache c) (Ix 6 c))

;; An app entry from the core's own compilation.
(define (core-ent core path)
  (foil:source-entry-val path (core-sut core)))

;;; The /boot mirror ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The boot image, materialized into the namespace so the system can
;; introspect its own code:
;;   /boot                   documentation of the subnamespace
;;   /boot/f                 module f's source text, in [src]
;;   /boot/f/n/[...name]     the entry declared at /[...name] (n
;;                           segments): [kind] and [src] always,
;;                           [code] when lowering produced a value
;; Needs a core compiled from a module that imports lainapp — the
;; record constructors (mirror/doc &c) live there.

(define (ts s) ("ts" s))

;; Module names split into namespace segments: apps mirror at
;; /boot/apps/<name>/main, kernel modules keep their single segment.
(define (mod-segs mod)
  (define n (Bytes mod))
  (define (slice a b) (Trunc (Mul 8 (Sub b a)) (Rsh mod (Mul 8 a))))
  (define (go start i acc)
    (If (Ge i n)
      (snoc (slice start i) acc)
      (If (Eq "/" (Load8 i mod))
        (go (Inc i) (Inc i) (snoc (slice start i) acc))
        (go start (Inc i) acc))))
  (go 0 0 []))

(define boot-doc-text
  (strcat
    ["the boot image: the system's own compiled code. "
     "each kid is a module; /boot/f holds its source text in [src]; "
     "/boot/f/n/[...name] holds the entry declared at /[...name] "
     "(n path segments) - its kind in [kind], its own source in "
     "[src], and its compiled value in [code] when lowering "
     "produced one. entries also carry their rendered type in [ty] "
     "and, when reference mirroring is on, [calls]/[called_by] rows "
     "of mirror paths. /boot/ns/[root] groups every entry by source "
     "namespace root. a module that failed to compile carries "
     "[status] failed and its diagnostic in [err]. "
     "the namespace's fixed geography (each writable root also "
     "carries this as its own [lore]): /boot this mirror; /kook the "
     "kernel's behavior registry, by convention - kook refs are full "
     "paths and resolve anywhere; /app mounted applications, one "
     "self-describing kid per app; /io the driver boundary, skipped "
     "by crew subscriptions; /out the outbound command root; /xeno "
     "remote paths; /h the read-only time-travel overlay."]))

;; Lore mirroring is a pure function of the already-mirrored [src]
;; (doc/shrine-apps.md section 4.3) — flip to 0 to shed the seeding
;; cost without losing information.
(define mirror-lore? 1)

;; Reference mirroring writes ['calls]/['called_by] rows of mirror
;; paths on each entry node (forge's who-calls, as namespace state).
(define mirror-refs? 0)  ;; TEMP: off for the boot check

;; Law mirroring writes each lowered entry's decompiled law text at
;; ['law].  Off by default: it walks every law at seed time.
(define mirror-law? 0)

;; Full-roster mirroring: compile every module on disk into the boot
;; cache (not just the helmapp closure + apps) so the whole tree
;; mirrors; modules that fail to compile get a fail card.
(define mirror-all? 1)

;; The 5th cache field when present; legacy 4-field entries degrade
;; to no lore.
(define (entry-lore me)
  (If (Lt 4 (Sz me)) (Ix 4 me) []))

;; A mirror-shaped entry's own keys: declared, minus imports, minus
;; materialized const-generic instantiations (/ty-ap-encoded keys are
;; not namespace paths) — the mirror's and the doctest driver's
;; shared notion of "documented entries".
;; The imported keys as a cairn AX index: a helm-scale module imports
;; the whole world (~1,500 keys), so the includes-scan variant was
;; O(decls x imports) with deep path equality — one own-keys pass over
;; the boot cache cost ~17s, and the mirror, /ns index, ref table, and
;; doctest sweep each paid it.
(define (entry-own-keys me)
  (define imp-ax
    (foldl (lambda (ax k) (cairn:putax k 1 ax)) cairn:empty-ax (_3 me)))
  (filter
    (lambda (k)
      (And (Nil (ty-ap-path? k))
        (Nil (cairn:getax k imp-ax))))
    (_2 me)))

;; A lore-for hit (0 or singleton) -> the four constructor arguments
;; [lo lh lb lt] the boot_*_t records take.
(define (lore-args hit)
  (Ifz hit
    [0 0 [] []]
    (let ((l (_0 hit)))
      [1 (foil-lore:lore-head l) (foil-lore:lore-body l)
       (foil-lore:lore-test-pairs l)])))

;; One vine_make task per mirrored node: /boot first, then each
;; module's file node followed by its entries.  A module's own keys
;; are its cache entry's decl keys minus its imported keys — both
;; stored on the entry ([name subject decl-keys imported-keys lore]
;; rows).  The mirror builds from this, and the doctest driver
;; resolves target paths against it.

;; A module entry's mirror node: /boot/<..modsegs>/<n>/<..name>.
(define (boot-ent-node mod name)
  (Weld (Weld n"boot" (map ts (mod-segs mod)))
    (Weld [("u" (Sz name))] (map ts name))))

;; [[src-node dst-node] ..]: every reference between mirrored entries,
;; deduped — forge's ref-table restated in mirror paths.  Refs to
;; anything unmirrored (builtins) drop out.
(define (boot-ref-table cache)
  ;; key -> mirror node as a cairn AX — the linear find here was
  ;; O(refs x entries) across the whole cache.  Unit-id PINS as bst
  ;; key segments are poison: cmp-total opens UNEQUAL pins and
  ;; compares their whole contents, so one descent past a unit-id
  ;; walks two entire unit subjects.  Intern pins to small indexes
  ;; first (Eq on pins is store identity); keys become pin-free.
  (define units
    (foldl
      (lambda (a me)
        (let ((unit (sut-unit (_1 me))))
          (let ((uid (If (foil-env:unit? unit)
                       (foil-env:unit-identity unit) 0)))
            (If (Or (Ifz uid 1 0) (includes (Eq uid) a))
              a (snoc uid a)))))
      [] cache))
  (define (pin-idx p)
    (define n (Sz units))
    (define (go i)
      (If (Ge i n) 0 (If (Eq p (Ix i units)) [i] (go (Inc i)))))
    (go 0))
  (define (intern-seg s)
    (If (IsPin s)
      (let ((hit (pin-idx s)))
        (Ifz hit ["#pin-miss"] ["#pin" (_0 hit)]))
      s))
  (define (intern-key k) (map intern-seg k))
  (define keymap
    (foldl
      (lambda (acc me)
        (define own (entry-own-keys me))
        (define unit (sut-unit (_1 me)))
        (define unit-id
          (If (foil-env:unit? unit) (foil-env:unit-identity unit) 0))
        (define own-ax (foil-relocate:own-index own))
        (foldl
          (lambda (a k)
            (define node (boot-ent-node (_0 me) (drop 1 k)))
            (define raw (cairn:putax (intern-key k) node a))
            (Ifz unit-id
              raw
              (cairn:putax
                (intern-key
                  (foil-relocate:qualify-canonical-path own-ax unit-id k))
                node raw)))
          acc own))
      cairn:empty-ax cache))
  (define (node-for k)
    (cairn:getax (intern-key k) keymap))
  ;; dedup via a seen-AX keyed by the [src dst] row itself
  (_1
    (foldl
      (lambda (st me)
        (foldl
          (lambda (st1 k)
            (let ((srcn (boot-ent-node (_0 me) (drop 1 k)))
                  (refs (foil:collect-refs (got-entry-tc k (_1 me)))))
              (foldl
                (lambda (st2 r)
                  (let ((hit (node-for (resolve-path (_1 r)))))
                    (Ifz hit
                      st2
                      (let ((row [srcn (_0 hit)]))
                        (Ifz (cairn:getax row (_0 st2))
                          [(cairn:putax row 1 (_0 st2)) (snoc row (_1 st2))]
                          st2)))))
                st1 refs)))
          st (entry-own-keys me)))
      [cairn:empty-ax []] cache)))

;; The ref table grouped by endpoint: [out-ax in-ax], node -> row of
;; peers.  Built once — the per-entry filter pair over the whole
;; table was O(entries x refs).
(define (ref-axes reftab)
  (foldl
    (lambda (axs r)
      (let ((s (Ix 0 r)) (d (Ix 1 r)))
        [(cairn:putax s (snoc d (cairn:gutax s [] (_0 axs))) (_0 axs))
         (cairn:putax d (snoc s (cairn:gutax d [] (_1 axs))) (_1 axs))]))
    [cairn:empty-ax cairn:empty-ax] reftab))

;; A node's outgoing and incoming reference rows from the grouped axes.
(define (refs-of raxes node)
  [(cairn:gutax node [] (_0 raxes))
   (cairn:gutax node [] (_1 raxes))])

;; The cache passed explicitly: the app pipeline compiles apps into
;; the core's cache first, then mirrors from the extended cache so
;; app modules mirror (lore included) like kernel code.  The pairs
;; variant emits [node myth] rows (no /boot doc node) so a resync can
;; remount one module's records through the chore cmd stream; the
;; tasks variant wraps them as vine_makes for boot seeding.
;; Profiling sub-zones: label + deep-force the payload so the span
;; covers the work, not the thunk (see foil.rvr zspan).
(define (zspan lbl v)
  (define h (ZoneStart lbl))
  (Seq h (Seq (DeepSeq v 0) (Seq (ZoneEnd h) v))))

;; Whether a cached module has source on disk to mirror.
;;
;; A GENERATED module (schemagen's tree-fed client — helm-llm.rvr) has
;; no file, so get-foil answers empty.  Mirroring one anyway puts its
;; entire entry table into the namespace with no source to show for it,
;; and that table is not small: the two OpenRouter modules carry 8,172
;; entries against 1,560 for every hand-written module in the system
;; combined.  Measured, seeding the mirror went 4.8s -> 61.2s with them
;; in — and every one of those nodes then rides in the sovereign that
;; each Save has to serialize.
;;
;; The cost of leaving them out: their ['sub] cache rows are not in the
;; namespace either, so hydrate-cache cannot rebuild them in a fresh
;; session — it regenerates from the spec instead.  That is the right
;; trade while a generated module costs 5 minutes to compile and its
;; source of truth is the schema, not the namespace.
(define (mirror-has-source? mod)
  (define r (Try (lambda (z) (Bytes (foil:get-foil mod))) 0))
  (If (Eq 1 (Hd r)) 0 (If (_0 r) 1 0)))

(define (boot-mirror-mods-refs-lore-with refs? lore? raw-cache core)
  (define cache (filter (lambda (me) (mirror-has-source? (_0 me))) raw-cache))
  (define src-t ent"mirror/src")
  (define ent-t ent"mirror/entry")
  (define ent-x ent"mirror/extras")
  (define ns-t ent"mirror/index")
  (define msing ent"myth/sing")
  (define mmeld ent"myth/meld")
  (define raxes (ref-axes (If refs? (boot-ref-table cache) [])))
  (define (mod-parts me)
    (define mod (_0 me))
    (define sut (_1 me))
    (define imported (_3 me))
    (define src (zspan "m-src" (foil:get-foil mod)))
    (define lore (If lore? (entry-lore me) []))
    (define own (entry-own-keys me))
    (define mnode (Weld n"boot" (map ts (mod-segs mod))))
    (define (ent-task k)
      (define e (zspan "m-parts" (foil:entry-parts sut k)))
      (define kind (zspan "m-kind" (foil:entry-kind sut k (foil:ent-tc e))))
      (define slice (zspan "m-slice" (foil:source-slice src (foil:ent-span e))))
      (define name (drop 1 k))
      (define node
        (Weld mnode (Weld [("u" (Sz name))] (map ts name))))
      ;; entry keys are rooted, capture-lore paths source-relative —
      ;; name (the rootless key) is the lookup key for both
      (define la (zspan "m-lore" (lore-args (foil-lore:lore-for lore name))))
      ;; the extra panes forge used to render live: the reflected
      ;; type descriptor always (the explorer renders it via tyshow),
      ;; the decompiled law and reference rows behind their flags
      (define tydesc
        (zspan "m-ty"
          ("/boot/maybe/some"
           (foil-new-elab:reflect-encode 0 (tc-ty (foil:ent-tc e))))))
      (define lawtext
        (zspan "m-law"
          (If (And mirror-law? (foil:ent-lowered e))
            (If (foil-render:law-like? (foil:ent-val e))
              (foil-render:render-law (foil:ent-val e))
              0)
            0)))
      (define rr (refs-of raxes node))
      ;; entry paths are module-relative; consumers re-root them.
      ;; ['defline] is the declaring span's 1-based source line — the
      ;; wire port's jump-to-definition (pail by rep, the ['sub] idiom).
      [(drop (Sz mnode) node)
       (mmeld
         (msing n"defline"
           (rep-pail-n (Ix 0 (foil:ent-span e))))
         (ent-x tydesc lawtext (Ix 0 rr) (Ix 1 rr)
           (ent-t (foil:ent-val e) kind slice (foil:ent-lowered e)
             (Ix 0 la) (Ix 1 la) (Ix 2 la) (Ix 3 la))))])
    ;; the module header's own slugs capture at path []
    (define mla (lore-args (foil-lore:lore-for lore [])))
    (define ents (map ent-task own))
    ;; ['sub] carries the cache row's pin: the namespace IS the
    ;; compile cache — hydrate-cache reads these back into rows a
    ;; fresh session can compile against.  Melded here so every
    ;; mirror path (boot pact tasks, pairs resyncs) writes it.
    ;; rvr-side nominal construction is by rep (the pails/code ctor
    ;; entry is not in the helmapp subject — the mani precedent).
    ;; ['entries] (mirror/index, the /ns record) lists the module's
    ;; own entry nodes — the wire port's completion source.
    ;; ['visible] is the module's whole declared key set — own AND
    ;; union-mounted imports — as rootless name paths: what an editor
    ;; completing inside this module's source should offer (imports
    ;; land bare; see doc/buddy-wire.md).  Imported keys ride as
    ;; canonical "/boot/<name>" CORDS — those must flatten to bare
    ;; segments here: a slash cord inside a ts quip is not a symbol,
    ;; and the explorer's path printer dies on it (quip-print-error
    ;; ts-not-symbol, every /ns page of the node a 500).
    ;; Built from OWN KEYS across the import closure's cache rows —
    ;; never from this module's decl-keys, whose imported forms are
    ;; qualified encodings (unit-id pins, canonical cords, ty-ap
    ;; wrappers) that differ between the fresh-compile and hydrated
    ;; cache pipelines and are not symbols.  entry-own-keys rows are
    ;; already bare, ty-ap-free segments.  (Prefix-mounted imports
    ;; are offered bare too — the union-mount common case is what
    ;; completion serves.)
    (define imp-own
      (foldl
        (lambda (a iname)
          (let ((hit (find (lambda (r) (Eq iname (_0 r))) cache)))
            (Ifz hit
              a
              (Weld a
                (map (lambda (k) (drop 1 k))
                  (entry-own-keys (_0 hit)))))))
        [] (foil:module-imports mod)))
    (define visible
      (map (lambda (segs) (map ts segs))
        (filter Sz
          (Weld (map (lambda (k) (drop 1 k)) own) imp-own))))
    [mnode mla
     (mmeld (msing n"sub" (rep-pail-code (foil:entry-pin me)))
       (mmeld (msing n"visible" (rep-pail-ps visible))
         (mmeld (ns-t (map (lambda (en) (Weld mnode (Ix 0 en))) ents))
           (src-t src (Ix 0 mla) (Ix 1 mla) (Ix 2 mla) (Ix 3 mla)))))
     ents])
  ;; module rows only: the compile cache also carries foil's 3-field
  ;; "#world" memo rows (real module rows are 6+ fields)
  (map mod-parts (filter (lambda (e) (Lt 5 (Sz e))) cache)))

;; The boot-path builder: reference rows deferred (the who-calls table
;; costs ~33s; ref-upgrade-task below re-mirrors WITH refs as one
;; post-listen pact poke).  A chore resync re-minted card is likewise
;; ref-less until the next upgrade.
(define (boot-mirror-mods-lore-with lore? raw-cache core)
  (boot-mirror-mods-refs-lore-with 0 lore? raw-cache core))

(define (boot-mirror-pairs-lore-with lore? raw-cache core)
  (foldl
    (lambda (acc mp)
      (let ((mnode (Ix 0 mp)))
        (Weld acc
          (Weld [[mnode (Ix 2 mp)]]
            (map (lambda (e) [(Weld mnode (Ix 0 e)) (Ix 1 e)])
              (Ix 3 mp))))))
    [] (boot-mirror-mods-lore-with lore? raw-cache core)))

(define (boot-mirror-pairs-with core raw-cache)
  (boot-mirror-pairs-lore-with mirror-lore? raw-cache core))

(define (boot-mirror-tasks-lore-with lore? raw-cache core)
  (define vine-make ent"vine_make")
  (define doc-t ent"mirror/doc")
  (Weld [(vine-make n"boot" (doc-t boot-doc-text))]
    (map (lambda (p) (vine-make (Ix 0 p) (Ix 1 p)))
      (boot-mirror-pairs-lore-with lore? raw-cache core))))

(define (boot-mirror-tasks-with raw-cache core)
  (boot-mirror-tasks-lore-with mirror-lore? raw-cache core))

;; The batched mirror: one pact event per module — the root card
;; carries the module's entry records as a manifest, and the in-kernel
;; pact expansion commits the whole subtree in one epoch.  ~40 events
;; instead of ~1,500; the commit machinery (gate/prepare, zipper walk,
;; ledger pin) is paid per subtree, and shared spine nodes mint once.
(define (boot-mirror-pact-tasks-lore-with lore? raw-cache core)
  (define vine-pact ent"pact/vine")
  (define vine-make ent"vine_make")
  (define doc-t ent"mirror/doc")
  (define kooked ent"kooked")
  (define mmeld ent"myth/meld")
  ;; /boot itself carries the pact kook: the deferred who-calls
  ;; upgrade (ref-upgrade-task) pokes a ['pact] manifest at the root,
  ;; and without a kook the poke would meld the slot and expand
  ;; nothing.
  (Weld [(vine-make n"boot"
           (mmeld (kooked [[t"kook" t"pact"]])
             (doc-t boot-doc-text)))]
    (map
      (lambda (mp)
        (let ((mla (Ix 1 mp)))
          (vine-pact (Ix 0 mp)
            (Ix 0 mla) (Ix 1 mla) (Ix 2 mla) (Ix 3 mla)
            (Ix 2 mp) (Ix 3 mp))))
      (boot-mirror-mods-lore-with lore? raw-cache core))))

(define (boot-mirror-pact-tasks-with raw-cache core)
  (boot-mirror-pact-tasks-lore-with mirror-lore? raw-cache core))

;; The deferred who-calls upgrade: ONE pact poke at /boot whose
;; manifest seeds every entry card rebuilt WITH its reference rows.
;; pact/talk expands it poke-if-present, so the whole tree melds in a
;; single committed epoch — per-node injection was measured at ~400s
;; of per-event commit+persist churn; this is one event.  Computing
;; the ref table (the ~33s the boot no longer pays) happens lazily
;; when this injects after the listener is up.
(define (ref-upgrade-task raw-cache core)
  (define vine-poke ent"vine_poke")
  (define msing ent"myth/sing")
  (define pact-slot ent"pact/slot")
  (define seeds
    (foldl
      (lambda (acc mp)
        (let ((mnode (Ix 0 mp)))
          (Weld acc
            (map
              (lambda (e) [(drop 1 (Weld mnode (Ix 0 e))) (Ix 1 e)])
              (Ix 3 mp)))))
      [] (boot-mirror-mods-refs-lore-with 1 mirror-lore? raw-cache core)))
  ;; rvr-side nominal construction is by rep: the ["mani"]/["lore"]
  ;; entries are TYPES, not value constructors — applying them yields
  ;; an unbranded row that pact/talk's mani match silently rejects.
  (vine-poke n"boot"
    (msing pact-slot
      ("/boot/mani" t"refs" ("/boot/lore" 0 [] []) [] seeds []))))

;; Every mirrored entry grouped by its source namespace root:
;; [[root entry-nodes] ..] — forge's /ns aggregation.
(define (ns-groups cache)
  (define pairs
    (foldl
      (lambda (acc me)
        (foldl
          (lambda (a k)
            (let ((name (drop 1 k)))
              (If (Sz name)
                (snoc [(Ix 0 name) (boot-ent-node (_0 me) name)] a)
                a)))
          acc (entry-own-keys me)))
      [] cache))
  (define roots
    (foldl
      (lambda (a p) (If (includes (Equal (Ix 0 p)) a) a (snoc (Ix 0 p) a)))
      [] pairs))
  (map
    (lambda (root)
      [root (map (Ix 1) (filter (lambda (p) (Equal root (Ix 0 p))) pairs))])
    roots))

;; The whole /boot/ns index as one pact event at /boot/ns.
(define (boot-ns-pact-task core raw-cache)
  (define vine-pact ent"pact/vine")
  (define doc-t ent"mirror/doc")
  (define ns-t ent"mirror/index")
  (vine-pact [t"boot" t"ns"] 0 0 [] []
    (doc-t "every mirrored entry grouped by its source namespace root.")
    (map (lambda (g) [[(ts (Ix 0 g))] (ns-t (Ix 1 g))])
      (ns-groups raw-cache))))

;; /boot/ns/<root> index nodes, one event per root — the unbatched
;; variant, kept for resyncs and tests.
(define (boot-ns-index-tasks core raw-cache)
  (define vine-make ent"vine_make")
  (define ns-t ent"mirror/index")
  (map
    (lambda (g)
      (vine-make [t"boot" t"ns" (ts (Ix 0 g))] (ns-t (Ix 1 g))))
    (ns-groups raw-cache)))

;; Compile one module into the shared cache under Try; a failure
;; leaves the cache unchanged.  -> [cache' ok?]
(define (cache-compile cache mod)
  (define r
    (Try
      (lambda (z)
        (let ((cr (foil:compile-mod-cached cache foil:default-subject mod)))
          (DeepSeq (_0 cr) cr)))
      0))
  (If (Eq 1 (Hd r)) [cache 0] [(_0 (_0 r)) 1]))

;; Test fixtures excluded from the boot mirror: compiling ~23 fixture
;; modules cost more than half the mirror-all roster compile, and the
;; suites that exercise them compile them themselves.  env_* is the
;; fixture prefix; the named ones are suite props.  A module absent
;; here still mirrors on demand through the build chores.
(define fixture-modules
  ["helm_ref_caller" "helm_ref_target" "mapuser" "mapuser_rev" "mapx"
   "vecapp" "perfbench"])

(define (fixture-module? mod)
  (Or (Eq "env_" (Trunc32 mod))
    (includes (Eq mod) fixture-modules)))

;; The boot-mirror roster policy over a disk scan.
(define (mirror-roster mods)
  (filter (lambda (m) (Nil (fixture-module? m))) mods))

;; The whole disk roster compiled into the cache: [cache' failed-mods].
;; Parallel: the roster's leaves share the already-compiled cone
;; through the base cache and rarely import each other, so they
;; compile in independent actors (compile-mods-par-cached merges
;; deterministically, one Try per module).
(define (compile-roster cache mods)
  (foil:compile-mods-par-cached cache mods))

;; Fail cards for modules that did not compile: Try each again for
;; the pretty diagnostic — a broken module is a visible mirror
;; citizen, exactly like a broken app mount.
(define (boot-fail-tasks core mods)
  (define vine-make ent"vine_make")
  (define fail-t ent"mirror/fail")
  (map
    (lambda (mod)
      (let* ((r (Try (lambda (z)
                       (let ((c (foil:compile-mod foil:default-subject mod)))
                         (Seq (DeepSeq c 0) 0)))
                  0))
             (text (If (Eq 1 (Hd r))
                     (foil-render:diag-text (_0 r))
                     "compiles alone; failed against the boot cache")))
        (vine-make (Weld n"boot" (map ts (mod-segs mod)))
          (fail-t text))))
    mods))

;; Fold tasks into a sovereign through the compiled kernel: every node
;; arrives as an ordinary committed event.  A failed event dies loudly
;; — threading its ovum/fail on as the sovereign would corrupt the fold.
(define (seed-tasks core sov tasks)
  (define run-event ent"run_event")
  (foldl
    (lambda (s t)
      (let ((o (run-event t 0 s)))
        (If (Eq "/boot/ovum/ripe" (Hd o))
          (Ix 0 o)
          (error ["seed-task-failed" (Ix 0 t) o]))))
    sov tasks))

(define (seed-boot core sov)
  (seed-tasks core sov (boot-mirror-tasks-with (core-cache core) core)))

;;; The namespace as compile cache ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Read one module's cache row back out of a sovereign's /boot
;; mirror: the ['sub] slot on the module's file node carries the
;; row's six durable fields as a pin (foil.rvr cache-entry).  The
;; pin rides back onto the row, so re-mirroring a hydrated cache
;; re-lands the SAME pin.  0 when the node or slot is absent.
(define (hydrate-mod core sov mod)
  (define xq (core-xq core))
  (define pail-at ent"myth/pail_at")
  (define node (Weld n"boot" (map ts (mod-segs mod))))
  (define r (xq (Ix 2 sov) node sov))
  (If (Eq "/boot/res/known" (Hd r))
    (let ((pl (pail-at n"sub" (_0 r))))
      (If (rep-pail-code? pl)
        (let ((p (Ix 0 pl)))
          (Weld (Unpin p) [p]))
        0))
    0))

;; The whole mirror hydrated: every named module that answers with a
;; ['sub] pin becomes a cache row — the result compiles like any
;; compile-mod-cached cache.  Modules without pins (fail cards,
;; pre-pin mirrors) drop out silently.
(define (hydrate-cache core sov mods)
  (foldl
    (lambda (acc mod)
      (let ((row (hydrate-mod core sov mod)))
        (Ifz row acc (snoc row acc))))
    [] mods))

;; A hydrated module's subject, for suites that pin one module's
;; world: (sut-of cache "sept") replaces the corpus tiers' sept-sut.
(define (cache-sut-of cache mod)
  (define hit (find (lambda (e) (Eq mod (_0 e))) cache))
  (Ifz hit
    (error ["cache-sut-of: module not in cache" mod])
    (_1 (_0 hit))))

;;; Application mounting (doc/shrine-apps.md section 6) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; App names discovered on disk: one folder per app under foil/apps
;; (module apps/<name>/main).  ReadFolder rides the event log, so a
;; recorded boot replays the same scan; 0 means no apps.
(define (discover-apps z)
  (define r (ReadFolder "foil/apps"))
  (Ifz r [] (map (Ix 1) (filter (lambda (e) (Eq 1 (Ix 0 e))) r))))

;; A file's text, or 0 when absent/empty (ReadFile throws on missing;
;; the probe is how an app declares which layers it has).
(define (probe-file path)
  (define r (Try (lambda (z) (let ((s (read-text-file path))) (DeepSeq s s))) 0))
  (If (Eq 1 (Hd r)) 0 (_0 r)))

;; Compile one app against the shared core cache and pull its
;; manifest.  An app is main.foil (code: forms, views, its own mani),
;; main.grove (spec: typing, structural seeds, kook refs — compiled
;; through grove's tree seam), or both — welded through the core's
;; own pact functions (mani/weld_spec, mani/adopt_spec), so every
;; seed adopts the contract the yoke assigns it.  The whole step runs
;; under Try — one bad app never costs the boot.  mani-ok is the
;; core's brand gate (brands are shared through the cache, so the
;; core's pact/form applies to the app's mani directly).
;; -> [cache' ["OK" mani] | ["ERR" err]]
(define (compile-app core cache name)
  (define mod (strcat ["apps/" name "/main"]))
  (define mani-ok ent"mani/ok")
  (define r
    (Try
      (lambda (z)
        (let* ((gsrc (probe-file (strcat ["foil/apps/" name "/main.grove"])))
               (fsrc (probe-file (strcat ["foil/apps/" name "/main.foil"])))
               ;; a companion may be code-only (grove owns the mani):
               ;; a missing app entry is absence, not failure
               (base (Ifz fsrc
                       [cache 0]
                       (let* ((cr (foil:compile-mod-cached cache foil:default-subject mod))
                              (mr (Try (lambda (zz)
                                         (let ((v (foil:source-entry-val ["app"] (_1 cr))))
                                           (DeepSeq (Hd v) v)))
                                    0)))
                         [(_0 cr) (If (Eq 1 (Hd mr)) 0 (_0 mr))])))
               (spec (Ifz gsrc
                       [(_0 base) 0 0]
                       (let* ((gt (grove:grove-tree name gsrc))
                              (gc (foil:compile-rex-cached (_0 base)
                                    foil:default-subject
                                    (strcat [mod "_spec"]) gt))
                              (gsut (_1 gc))
                              (y (foil:source-entry-val ["spec"] gsut))
                              (gm (Try (lambda (zz)
                                         (let ((v (foil:source-entry-val ["app"] gsut)))
                                           (DeepSeq (Hd v) v)))
                                    0)))
                         [(_0 gc) y (If (Eq 1 (Hd gm)) 0 (_0 gm))])))
               (m (_1 base))
               (y (Ix 1 spec))
               (gm (Ix 2 spec))
               (mm (cond
                     ((And (Nil m) (Nil gm)) (error ["no-app-mani" name]))
                     ((Nil m) gm)
                     ((Nil gm)
                       (Ifz y m (ent"mani/adopt_spec" y m)))
                     (else (ent"mani/weld_spec" y gm m)))))
          (Seq (If (Eq 1 (mani-ok mm)) 0 (error ["app-entry-not-mani" mod]))
            [(Ix 0 spec) mm])))
      0))
  (If (Eq 1 (Hd r))
    [cache ["ERR" (_0 r)]]
    [(_0 (_0 r)) ["OK" (_1 (_0 r))]]))

;; Discover and compile every app: [cache' [[name res] ..]].  Runs
;; before the mirror is built so app modules mirror like kernel code.
(define (compile-apps core cache names)
  (foldl
    (lambda (st name)
      (let ((r (compile-app core (_0 st) name)))
        [(_0 r) (snoc [name (_1 r)] (_1 st))]))
    [cache []] names))

;; Error text for the fail card: the diagnostic renderer's flat walk
;; (atoms, located blurbs, nested rows — no more "opaque"); the Trace
;; carries the full value.
(define (err-cord e)
  (define r (Try (lambda (z) (foil-render:diag-flat e)) 0))
  (If (Eq 1 (Hd r)) "unrenderable error" (_0 r)))

;; The host's grant decision for one app, capped by what the app
;; asked for: a grant never exceeds the ask, so ['grants] is always a
;; subset of ['wants] and the gap between them reads as denial.  The
;; policy is "all" (allow whatever is asked — x/lain's dev default) or
;; a row of [name allow-fetch allow-serve] flags; anything not named
;; is DENIED, so the default ([]) is deny-all.
;; -> [gfetch gport]
(define (grants-for policy name want-fetch want-port)
  (define all? (Equal "all" policy))
  (define hit
    (Ifz all? (find (lambda (e) (Equal name (_0 e))) policy) 0))
  (define af (If all? 1 (Ifz hit 0 (Ix 1 (_0 hit)))))
  (define ap (If all? 1 (Ifz hit 0 (Ix 2 (_0 hit)))))
  [(And want-fetch af) (If ap want-port 0)])

;; The kernel install op's fn: (input, cur) -> the pact/card for the
;; app named by the input's ['app] text slot, or a pact/fail record.
;; Closes over the boot-compiled [[name res]..] roster and the grant
;; policy, so the warp is where authority is decided — the card
;; carries the grant ledger the helm's move gate reads back.  Every
;; record is minted by compiled subject ctors (op/pact rows are
;; nominal and cannot be hand-built across the FFI).
(define (install-fn core ar policy)
  (define txt-at ent"myth/txt_at")
  (define app-card ent"pact/card")
  (define fail-t ent"pact/fail")
  (define has-fetch ent"grant/has_fetch")
  (define serve-port ent"grant/serve_port")
  (lambda (input cur)
    (let* ((name (txt-at n"app" input))
           (hit (find (lambda (e) (Equal name (_0 e))) ar)))
      (cond
        ((Nil (Bytes name)) (fail-t "install: missing ['app] name"))
        ((Ifz hit 1 0)
          (fail-t (strcat ["install: unknown app " name
                           " (apps are discovered at boot)"])))
        ((Eq "ERR" (_0 (_1 (_0 hit))))
          (fail-t (err-cord (_1 (_1 (_0 hit))))))
        (else
          (let* ((mani (_1 (_1 (_0 hit))))
                 ;; mani's fields read positionally off the nominal
                 ;; rep (brand at Hd, fields from Ix 0): wants fifth
                 (wants (Ix 4 mani))
                 (want-fetch (has-fetch wants))
                 (g (grants-for policy name want-fetch (serve-port wants))))
            (Seq
              (If (And want-fetch (Nil (_0 g)))
                (Trace ["app-grant-denied" name "fetch"] 0) 0)
              (app-card mani (strcat ["apps/" name "/main"])
                (_0 g) (Ix 1 g)))))))))

;; The default install root: ['app <name>] — roots is a [[name root]..]
;; override table for apps that own a top-level root of their own
;; (the chat app lives at /chat).  Shared, because a remount has to
;; reach the same root the install landed at (helm-sync.rvr).  Apps
;; are NOT mounted at boot: /boot mirrors every compiled module (the
;; catalog), and a warp of /kook/install at the chosen root is the
;; explicit install.
(define (mount-root roots name)
  (define hit (find (lambda (e) (Equal name (_0 e))) roots))
  (Ifz hit [t"app" (ts name)] (_1 (_0 hit))))

(define app-roots
  [["chat" n"chat"] ["nenex" n"nenex"]])

;;; Boot-time doctest sweep (doc/doctest-runner-explorer.md part I) ;;;;;;;;;;;;;;;;;

;; On: the image boots born-verified — every documented entry carries
;; its verdict from the start (the explorer renders the chips).  Flip
;; to 0 to shed the cost; /io/doctest re-runs anything on demand.
;; This sweep stays synchronous in MAIN deliberately: running every
;; doctest here is what compiles the eval pipeline's call graph, so
;; the chore driver's leaf actors (helm-chore.rvr) only replay
;; compiled paths — it IS the warming the off-MAIN runs rely on.
(define doctest-sweep? 0)  ;; TEMP: off for the boot check

;; Verdict tasks for every documented entry with tests, evaluated
;; against the owning module's cache-entry subject (apps compile after
;; the core chain, so the core's subject cannot resolve app-local
;; names).  The staleness anchor and the make/poke choice read against
;; the supplied sovereign; verdicts ride /dt CHILD nodes, so one
;; verdict never moves another node's anchor and the whole batch is
;; sound against one snapshot.  Lazy: forcing task i runs entry i's
;; doctests, nothing else — the serve injects these AFTER listening.
(define (doctest-tasks raw-cache core sov)
  (define cache raw-cache)
  (define vine-poke ent"vine_poke")
  (define vine-make ent"vine_make")
  (define dt-card ent"doctest/card")
  (define xcase ent"x_case_h")
  (define (tested l) (Gt (Sz (foil-lore:lore-tests l)) 0))
  ;; the verdict rides a child node — the documented node's version
  ;; stays clean as the staleness anchor (doctest-runner-explorer I.3)
  (define (task1 msut node l)
    (define c (xcase 0 node sov))
    (If (Nil (boot-some? c))
      []
      (let* ((rs (doctest:run-lore msut l))
             (dtnode (snoc t"dt" node))
             (card (dt-card (Now 0) (_0 c) rs)))
        [(If (Eq "/boot/maybe/some" (Hd (xcase 0 dtnode sov)))
           (vine-poke dtnode card)
           (vine-make dtnode card))])))
  (define (mod-tasks acc me)
    (define bsegs (Weld n"boot" (map ts (mod-segs (_0 me)))))
    (define lore (entry-lore me))
    ;; one bundled TypeWorld per module for the whole sweep — the
    ;; per-entry evals used to rebuild it per documented entry
    (define msubj (doctest:bundle-with (foil:entry-world me) (_1 me)))
    (define acc1
      (let ((mh (foil-lore:lore-for lore [])))
        (If (And mh (tested (_0 mh)))
          (Weld acc (task1 msubj bsegs (_0 mh)))
          acc)))
    (foldl
      (lambda (acc2 k)
        (let* ((name (drop 1 k))
               (hit (foil-lore:lore-for lore name)))
          (If (And hit (tested (_0 hit)))
            (Weld acc2
              (task1 msubj
                (Weld bsegs (Weld [("u" (Sz name))] (map ts name)))
                (_0 hit)))
            acc2)))
      acc1 (entry-own-keys me)))
  ;; module rows only (skip foil's 3-field "#world" memo rows)
  (foldl mod-tasks [] (filter (lambda (e) (Lt 5 (Sz e))) cache)))

;; Apply the sweep directly to a sovereign (pre-spawn seeding; tests
;; and tools).  Tolerant: a failed poke traces and moves on —
;; verdicts are data, not gates.
(define (seed-doctests raw-cache core sov)
  (define run-event ent"run_event")
  (foldl
    (lambda (s task)
      (let ((o (Try (lambda (z) (run-event task 0 s)) 0)))
        (If (And (Eq 0 (Hd o)) (Eq "/boot/ovum/ripe" (Hd (_0 o))))
          (Ix 0 (_0 o))
          (Seq (Trace ["doctest-sweep: poke failed"] 0) s))))
    sov (doctest-tasks raw-cache core sov)))

;;; Duty application ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (roster-get roster n)
  (find (lambda (e) (Equal n (_0 e))) roster))

(define (roster-drop roster n)
  (filter (lambda (e) (Nil (Equal n (_0 e)))) roster))

;; Force-then-send: the receiver must not inherit our thunks.  The
;; one send discipline every actor in this driver shares.
(define (send! h m)
  (Seq (DeepSeq m m) (Send h m)))

;; Send to the named worker, if it is still on the roster.
(define (send-named roster n m)
  (let ((hit (roster-get roster n)))
    (Ifz hit 0 (send! (_1 (_0 hit)) m))))

;; One duty against the roster, from inside the coordinator actor
;; (handle 0 below is the coordinator's own inbox).
(define (apply-duty mk-worker roster d)
  (define kind (Hd d))
  (cond
    ((Eq kind "/boot/duty/birth")
      (let ((w (Spawn (mk-worker (_0 d)))))
        (Seq (SendCaps w (DeepSeq d ["go" (_1 d)]) [0])
          (snoc [(_0 d) w] roster))))
    ((Eq kind "/boot/duty/fell")
      (Seq (send-named roster (_0 d) ["die"])
        (roster-drop roster (_0 d))))
    ((Eq kind "/boot/duty/tell")
      (Seq (send-named roster (_0 d) ["change" (_1 d) (_2 d)])
        roster))
    ((Eq kind "/boot/duty/ack")
      (Seq (send-named roster (_0 d) ["ack" (_1 d)])
        roster))
    (else roster)))

(define (apply-duties mk-worker roster ds)
  (foldl (apply-duty mk-worker) roster ds))

;;; The coordinator ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (helm-loop core mk-worker persist st)
  (define hm (_0 st))
  (define roster (_1 st))
  (define mc (Recv 0))
  (define msg (Ix 0 mc))
  (define caps (Ix 1 mc))
  (define kind (_0 msg))
  ;; The duty Sends live inside the apply-duties fold: every turn's
  ;; new state is deep-forced BEFORE anything else happens, so all
  ;; effects land within the turn (a lazy fold would defer the Sends
  ;; to the next Recv — a deadlock).
  ;;
  ;; Write-ahead: the new helm state is forced and handed to persist
  ;; (the snapshot hook) BEFORE the duty sends — acks included — fire
  ;; in the apply-duties fold.  A crash between the two resumes with
  ;; the event durable and the worker simply never acked; workers are
  ;; ephemeral, so nothing is owed to them across a restart.
  (define (turn src task)
    ;; the exec rides a Try: a poisoned task (ill-typed writ payload,
    ;; malformed task row) must not kill the coordinator — the state
    ;; stands, and a named sender gets the failure as its ack instead
    ;; of a system-wide deadlock
    (define rr
      (Try (lambda (z)
             (let ((r ((core-exec core) src task hm)))
               (Seq (DeepSeq r r) r)))
        0))
    (If (Eq 1 (Hd rr))
      (let ((rsvp ("/boot/rsvp/no" (_0 rr))))
        (let ((duties
                (If (boot-some? src)
                  [("/boot/duty/ack" (_0 src) rsvp)]
                  [])))
          (Seq (Trace ["helm: task crashed" (_0 rr)] 0)
            (let ((roster2 (apply-duties mk-worker roster duties)))
              (let ((st2 [hm roster2]))
                (Seq (DeepSeq st2 st2) [st2 rsvp]))))))
      (let* ((r (_0 rr))
             (hm2 (_0 r))
             (spill (Ix 3 r)))
        ;; a cascaded hear round's failure rides the gyre's spill —
        ;; the committed rounds stand, but the error is reported
        (Seq (If (boot-some? spill)
               (Trace ["helm: cascade round failed" (_0 spill)] 0)
               0)
          (Seq (persist hm2)
            (let ((roster2 (apply-duties mk-worker roster (_1 r))))
              (let ((st2 [hm2 roster2]))
                (Seq (DeepSeq st2 st2) [st2 (Ix 2 r)]))))))))
  (cond
    ((Eq kind "cmd")
      (let ((tr (turn (boot-some (_1 msg)) (_2 msg))))
        (Seq tr
          (helm-loop core mk-worker persist (_0 tr)))))
    ((Eq kind "task")
      ;; the reply carries the event's verdict: ["done"] on commit,
      ;; ["fail" err] on rejection — an anonymous task's failure used
      ;; to vanish (the ack duty only exists for named senders)
      (let* ((tr (turn "/boot/maybe/none" (_1 msg)))
             (rsvp (_1 tr))
             (reply (If (Eq "/boot/rsvp/no" (Hd rsvp))
                      ["fail" (_0 rsvp)]
                      ["done"])))
        (Seq tr
          (Seq (Send (Ix 0 caps) (DeepSeq reply reply))
            (helm-loop core mk-worker persist (_0 tr))))))
    ((Eq kind "query")
      (let ((s (_0 hm)))
        (Seq (Send (Ix 0 caps)
               (DeepSeq msg ((core-xq core) (Ix 2 s) (_1 msg) s)))
          (helm-loop core mk-worker persist st))))
    ((Eq kind "branch")
      ;; ["branch" name dst at from patch] — the executable
      ;; counterfactual: fork the sovereign at `from`, poke `patch`
      ;; at `at`, replay the journal from+1..top against the branch,
      ;; and commit the VERDICT at `dst` as an ordinary named task —
      ;; the sender's ack rides the normal duty, and the trunk only
      ;; ever gains the verdict card (the branch lives and dies as a
      ;; value inside fork/backtest).  Runs in the coordinator's
      ;; turn, so a long replay serializes behind live traffic —
      ;; acceptable at v1 scale, and honest: a counterfactual is an
      ;; event like any other.
      (let* ((sv (_0 hm))
             (bt ent"fork/backtest")
             (vr (Try (lambda (z)
                        (let ((v (bt (Ix 4 msg) (Ix 3 msg) (Ix 5 msg) sv)))
                          (Seq (DeepSeq v v) v)))
                   0))
             (verdict
               (If (Eq 1 (Hd vr))
                 (ent"myth/sing" n"err"
                   (ent"pt" "backtest crashed — see the serve log"))
                 (_0 vr)))
             (dst (Ix 2 msg))
             (known? (Eq "/boot/res/known"
                       (Hd ((core-xq core) (Ix 2 sv) dst sv))))
             (task (If known?
                     (ent"vine_poke" dst verdict)
                     (ent"vine_make" dst verdict)))
             (tr (turn (boot-some (_1 msg)) task)))
        (Seq (If (Eq 1 (Hd vr))
               (Trace ["branch: backtest crashed" (_0 vr)] 0) 0)
          (helm-loop core mk-worker persist (_0 tr)))))
    ((Eq kind "spy")
      ;; ["spy" name path] — arm a one-shot watch for a worker.  No
      ;; reply: worker->coordinator sends are FIFO, so a spy followed
      ;; by a cmd from the same worker is armed before the cmd runs.
      (let ((hm2 ((core-spy core) (_1 msg) (_2 msg) hm)))
        (Seq (DeepSeq hm2 hm2)
          (helm-loop core mk-worker persist [hm2 roster]))))
    ((Eq kind "read")
      ;; ["read" path] — the committed record, tagged for multiplexed
      ;; worker mailboxes.
      (let ((s (_0 hm)))
        (let ((res ((core-xq core) (Ix 2 s) (_1 msg) s)))
          (Seq (Send (Ix 0 caps) (DeepSeq res ["qres" (_1 msg) res]))
            (helm-loop core mk-worker persist st)))))
    ((Eq kind "case")
      ;; ["case" path] — the node's current version (maybe[nat]),
      ;; tagged for multiplexed worker mailboxes.  The doctest
      ;; driver's staleness anchor.
      (let ((s (_0 hm)))
        (let ((c (ent"x_case_h" 0 (_1 msg) s)))
          (Seq (Send (Ix 0 caps) (DeepSeq c ["cres" (_1 msg) c]))
            (helm-loop core mk-worker persist st)))))
    ((Eq kind "crew")
      (Seq (Send (Ix 0 caps) (map (Ix 0) roster))
        (helm-loop core mk-worker persist st)))
    ((Eq kind "handle")
      (let ((hit (roster-get roster (_1 msg))))
        (Seq (Ifz hit
               (Send (Ix 0 caps) ["nohandle"])
               (SendCaps (Ix 0 caps) ["handle"] [(_1 (_0 hit))]))
          (helm-loop core mk-worker persist st))))
    ((Eq kind "stop")
      (let ((dies (map (lambda (e) (Send (_1 e) ["die"])) roster)))
        (Seq (DeepSeq dies dies)
          (Send (Ix 0 caps) ["bye"]))))
    (else (helm-loop core mk-worker persist st))))

;; The coordinator actor body: boot the helm, persist once (so a
;; zero-event serve still leaves a resumable snapshot), apply the
;; initial births, loop.  Spawn as
;; (Spawn (helm-actor core mk-worker persist s0)).  The behavior
;; registry is namespace state (/kook/<id>) — seed the sovereign
;; before taking the helm.  persist receives the forced helm state;
;; pass (lambda (hm) 0) for a non-persistent (test) coordinator.
(define (helm-actor core mk-worker persist s0 self)
  (define b ((core-boot core) s0))
  (define hm0 (DeepSeq (_0 b) (_0 b)))
  (Seq (persist hm0)
    (let ((roster (apply-duties mk-worker [] (_1 b))))
      (Seq (DeepSeq roster roster)
        (helm-loop core mk-worker persist [hm0 roster])))))
