(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

(#bind foil-lore (#module foil-lore))


;;; The IO driver shell: real enki actors around the pure helm core
;;; (src/foil/helm.foil).  The coordinator actor owns the helm state
;;; and a roster of one worker actor per /io name; it executes the
;;; core's duties and shuttles messages.  All decisions are the
;;; core's.
;;;
;;; Coordinator mailbox protocol (msg, caps):
;;;   ["cmd" name task]   from a worker: run the task, ack the worker
;;;   ["task" task]       external injection; replies ["done"] to the
;;;                       cap — the synchronous barrier drivers use
;;;   ["query" path]      replies the committed record (res shape)
;;;   ["crew" ]           replies the roster's names
;;;   ["handle" name]     replies ["handle"] with the worker handle as
;;;                       a capability (or ["nohandle"])
;;;   ["stop"]            kills the roster, replies ["bye"], exits
;;;
;;; Worker protocol (coordinator -> worker):
;;;   ["go" res]     first message; caps = [coordinator-handle]
;;;   ["change" res] the name's new committed record
;;;   ["ack" rsvp]   the outcome of a command this worker sent
;;;   ["die"]        the name was removed
;;; Workers send ["cmd" name task] to the coordinator handle.

;;; Core loading ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Compile a helm-importing module once; returns the core functions
;; the shell needs plus the compiled subject (so callers can pull
;; their own app entries from the SAME compilation — one chain walk)
;; and the per-module compile cache (so the /boot mirror knows which
;; file declared which entry): ["HELM" boot exec x-query spy sut cache].
(define (load-helm-mod mod)
  (define r (foil:compile-mod-cached 0 foil:default-subject mod))
  (define sut (_1 r))
  (define (ent path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) sut)))
  ;; the query slot is /h-aware: the coordinator's query/read verbs
  ;; serve the temporal overlay as well as live paths
  ["HELM" (ent ["helm" "boot"]) (ent ["helm" "exec"]) (ent ["x_query_h"])
   (ent ["helm" "spy"]) sut (_0 r)])

;; Cross-process artifact-cache variant.  The core keeps the artifact cache so
;; /boot attribution can use each artifact's declared/imported key metadata.
(define (load-helm-mod-artifact-cached cache mod)
  (define r
    (foil:compile-mod-artifact-cached cache foil:default-subject 0 mod))
  (define sut (_1 r))
  (define (ent path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) sut)))
  ["HELM" (ent ["helm" "boot"]) (ent ["helm" "exec"]) (ent ["x_query_h"])
   (ent ["helm" "spy"]) sut (_0 r)])

;; The bare driver chain.  The argument is ignored (a zero-argument
;; define does not reduce when applied).
(define (load-helm z)
  (load-helm-mod "helm"))

(define (core-boot c) (Ix 1 c))
(define (core-exec c) (Ix 2 c))
(define (core-xq c) (Ix 3 c))
(define (core-spy c) (Ix 4 c))
(define (core-sut c) (Ix 5 c))
(define (core-cache c) (Ix 6 c))

;; An app entry from the core's own compilation.
(define (core-ent core path)
  (foil:ir-entry-val (got-entry (Weld ["boot"] path) (core-sut core))))

;;; Persistent precompiled image ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A helm core wrapped with enough provenance to know when it is stale:
;; the foil compiler token plus this loader chain, and the source bytes
;; of the module's whole import closure.  The launcher binds the image
;; to a snapshot top level (x/lain: _lain_image_v1); Reaver's snapshot
;; continuation persists it, so a later process boots from the compiled
;; core without compiling anything (the same free persistence ride
;; foil-cache.rvr uses for per-module artifacts).

(define image-schema 1)

(define (image-token z)
  ;; A compiler or loader change must invalidate the image; source
  ;; changes are caught by image-sources below.
  (Pin [image-schema (foil:artifact-compiler-token 0) load-helm-mod]))

(define (image-sources mod)
  (map (lambda (m) [m (foil:get-foil m)])
    (foil:artifact-module-closure [mod])))

(define (make-helm-image mod)
  (define core (load-helm-mod mod))
  (define img ["HELM_IMAGE" mod (image-token 0) (image-sources mod) core])
  (DeepSeq core (Pin img)))

(define (helm-image-body img)
  (If (IsPin img) (Unpin img) 0))

(define (helm-image-core img)
  (Ix 4 (helm-image-body img)))

(define (helm-image-valid? img mod)
  (define b (helm-image-body img))
  (And (IsApp b)
    (And (Eq "HELM_IMAGE" (_0 b))
      (And (Eq mod (Ix 1 b))
        (And (Equal (image-token 0) (Ix 2 b))
          (all (lambda (e) (Equal (_1 e) (foil:get-foil (_0 e))))
            (Ix 3 b)))))))

;; Reuse a valid image; rebuild otherwise.  Validation runs under Try
;; so a malformed image (or a deleted source file) is a rebuild, not a
;; wedge.  An import-graph change always shows up as changed bytes in
;; some already-listed source, so the stored closure stays sound.
(define (helm-image-refresh img mod)
  (define v (Try (lambda (z) (helm-image-valid? img mod)) 0))
  (If (And (Nil (Eq 1 (Hd v))) (_0 v))
    img
    (make-helm-image mod)))

;;; The /boot mirror ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The boot image, materialized into the namespace so the system can
;; introspect its own code:
;;   /boot                   documentation of the subnamespace
;;   /boot/f                 module f's source text, in [src]
;;   /boot/f/n/[...name]     the entry declared at /[...name] (n
;;                           segments): [kind] and [src] always,
;;                           [code] when lowering produced a value
;; Needs a core compiled from a module that imports lainapp — the
;; record constructors (boot_doc_t &c) live there.

(define (ts s) ("ts" s))

(define boot-doc-text
  (strcat
    ["the boot image: the system's own compiled code. "
     "each kid is a module; /boot/f holds its source text in [src]; "
     "/boot/f/n/[...name] holds the entry declared at /[...name] "
     "(n path segments) - its kind in [kind], its own source in "
     "[src], and its compiled value in [code] when lowering "
     "produced one."]))

;; Lore mirroring is a pure function of the already-mirrored [src]
;; (doc/shrine-apps.md section 4.3) — flip to 0 to shed the seeding
;; cost without losing information.
(define mirror-lore? 1)

;; The 5th cache field when present; legacy 4-field and
;; artifact-derived entries degrade to no lore.
(define (entry-lore me)
  (If (Lt 4 (Sz me)) (Ix 4 me) []))

;; A lore-for hit (0 or singleton) -> the four constructor arguments
;; [lo lh lb lt] the boot_*_t records take.
(define (lore-args hit)
  (Ifz hit
    [0 0 [] []]
    (let ((l (_0 hit)))
      [1 (foil-lore:lore-head l) (foil-lore:lore-body l)
       (foil-lore:lore-test-pairs l)])))

;; One vine_make task per mirrored node: /boot first, then each
;; module's file node followed by its entries.  A module's own keys
;; are its cache entry's decl keys minus its imported keys — both
;; stored on the entry ([name subject decl-keys imported-keys lore]).
(define (boot-mirror-tasks-lore lore? core)
  (define raw-cache (core-cache core))
  (define cache
    (If (And (IsApp raw-cache) (Eq "FOIL_ARTIFACT_CACHE" (_0 raw-cache)))
      (map
        (lambda (ce)
          (let ((body (foil:artifact-body (_1 ce))))
            ;; artifacts carry no lore yet — empty 5th field
            [(_0 ce) (core-sut core)
             (foil:artifact-decl-keys body)
             (foil:artifact-imported body)
             []]))
        (foil:artifact-cache-entries raw-cache))
      raw-cache))
  (define vine-make (core-ent core ["vine_make"]))
  (define doc-t (core-ent core ["boot_doc_t"]))
  (define src-t (core-ent core ["boot_src_t"]))
  (define ent-t (core-ent core ["boot_ent_t"]))
  (define (mod-tasks me)
    (define mod (_0 me))
    (define sut (_1 me))
    (define imported (_3 me))
    (define src (foil:get-foil mod))
    (define lore (If lore? (entry-lore me) []))
    ;; materialized const-generic instantiations carry /ty-ap-encoded
    ;; keys (not namespace paths, and their value is the generic's) —
    ;; the mirror skips them, like forge's ns index
    (define own
      (filter
        (lambda (k)
          (And (Nil (ty-ap-path? k))
            (Nil (includes (Equal k) imported))))
        (_2 me)))
    (define (ent-task k)
      (define e (foil:entry-parts sut k))
      (define kind (foil:entry-kind sut k (foil:ent-tc e)))
      (define slice (foil:source-slice src (foil:ent-span e)))
      (define name (drop 1 k))
      (define node
        (Weld [(ts "boot") (ts mod) (ts (showNat (Sz name)))] (map ts name)))
      ;; entry keys are rooted, capture-lore paths source-relative —
      ;; name (the rootless key) is the lookup key for both
      (define la (lore-args (foil-lore:lore-for lore name)))
      (vine-make node
        (ent-t (foil:ent-val e) kind slice (foil:ent-lowered e)
          (Ix 0 la) (Ix 1 la) (Ix 2 la) (Ix 3 la))))
    ;; the module header's own slugs capture at path []
    (define mla (lore-args (foil-lore:lore-for lore [])))
    (Weld [(vine-make [(ts "boot") (ts mod)]
             (src-t src (Ix 0 mla) (Ix 1 mla) (Ix 2 mla) (Ix 3 mla)))]
      (map ent-task own)))
  (Weld [(vine-make [(ts "boot")] (doc-t boot-doc-text))]
    (foldl (lambda (acc me) (Weld acc (mod-tasks me))) [] cache)))

(define (boot-mirror-tasks core)
  (boot-mirror-tasks-lore mirror-lore? core))

;; Fold tasks into a sovereign through the compiled kernel: every node
;; arrives as an ordinary committed event.  A failed event dies loudly
;; — threading its $fail on as the sovereign would corrupt the fold.
(define (seed-tasks core sov tasks)
  (define run-event (core-ent core ["run_event"]))
  (foldl
    (lambda (s t)
      (let ((o (run-event t 0 s)))
        (If (Eq "ripe" (Hd o))
          (Ix 0 o)
          (error ["seed-task-failed" (Ix 0 t) o]))))
    sov tasks))

(define (seed-boot core sov)
  (seed-tasks core sov (boot-mirror-tasks core)))

;;; Duty application ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (roster-get roster n)
  (find (lambda (e) (Equal n (_0 e))) roster))

(define (roster-drop roster n)
  (filter (lambda (e) (Nil (Equal n (_0 e)))) roster))

;; One duty against the roster, from inside the coordinator actor
;; (handle 0 below is the coordinator's own inbox).  Payloads are
;; deep-forced before every send — the receiver must not inherit our
;; thunks.
(define (apply-duty mk-worker roster d)
  (define kind (Hd d))
  (cond
    ((Eq kind "birth")
      (let ((w (Spawn (mk-worker (_0 d)))))
        (Seq (SendCaps w (DeepSeq d ["go" (_1 d)]) [0])
          (snoc [(_0 d) w] roster))))
    ((Eq kind "fell")
      (let ((hit (roster-get roster (_0 d))))
        (Ifz hit
          roster
          (Seq (Send (_1 (_0 hit)) ["die"])
            (roster-drop roster (_0 d))))))
    ((Eq kind "tell")
      (let ((hit (roster-get roster (_0 d))))
        (Ifz hit
          roster
          (Seq (Send (_1 (_0 hit)) (DeepSeq d ["change" (_1 d) (_2 d)]))
            roster))))
    ((Eq kind "ack")
      (let ((hit (roster-get roster (_0 d))))
        (Ifz hit
          roster
          (Seq (Send (_1 (_0 hit)) (DeepSeq d ["ack" (_1 d)]))
            roster))))
    (else roster)))

(define (apply-duties mk-worker roster ds)
  (foldl (apply-duty mk-worker) roster ds))

;;; The coordinator ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (helm-loop core mk-worker st)
  (define hm (_0 st))
  (define roster (_1 st))
  (define mc (Recv 0))
  (define msg (Ix 0 mc))
  (define caps (Ix 1 mc))
  (define kind (_0 msg))
  ;; The duty Sends live inside the apply-duties fold: every turn's
  ;; new state is deep-forced BEFORE anything else happens, so all
  ;; effects land within the turn (a lazy fold would defer the Sends
  ;; to the next Recv — a deadlock).
  (define (turn src task)
    (define r ((core-exec core) src task hm))
    (define roster2 (apply-duties mk-worker roster (_1 r)))
    (define st2 [(_0 r) roster2])
    (DeepSeq st2 st2))
  (cond
    ((Eq kind "cmd")
      (let ((st2 (turn ("some" (_1 msg)) (_2 msg))))
        (Seq st2
          (helm-loop core mk-worker st2))))
    ((Eq kind "task")
      (let ((st2 (turn "none" (_1 msg))))
        (Seq st2
          (Seq (Send (Ix 0 caps) ["done"])
            (helm-loop core mk-worker st2)))))
    ((Eq kind "query")
      (let ((s (_0 hm)))
        (Seq (Send (Ix 0 caps)
               (DeepSeq msg ((core-xq core) (Ix 2 s) (_1 msg) s)))
          (helm-loop core mk-worker st))))
    ((Eq kind "spy")
      ;; ["spy" name path] — arm a one-shot watch for a worker.  No
      ;; reply: worker->coordinator sends are FIFO, so a spy followed
      ;; by a cmd from the same worker is armed before the cmd runs.
      (let ((hm2 ((core-spy core) (_1 msg) (_2 msg) hm)))
        (Seq (DeepSeq hm2 hm2)
          (helm-loop core mk-worker [hm2 roster]))))
    ((Eq kind "read")
      ;; ["read" path] — the committed record, tagged for multiplexed
      ;; worker mailboxes.
      (let ((s (_0 hm)))
        (let ((res ((core-xq core) (Ix 2 s) (_1 msg) s)))
          (Seq (Send (Ix 0 caps) (DeepSeq res ["qres" (_1 msg) res]))
            (helm-loop core mk-worker st)))))
    ((Eq kind "crew")
      (Seq (Send (Ix 0 caps) (map (Ix 0) roster))
        (helm-loop core mk-worker st)))
    ((Eq kind "handle")
      (let ((hit (roster-get roster (_1 msg))))
        (Seq (Ifz hit
               (Send (Ix 0 caps) ["nohandle"])
               (SendCaps (Ix 0 caps) ["handle"] [(_1 (_0 hit))]))
          (helm-loop core mk-worker st))))
    ((Eq kind "stop")
      (let ((dies (map (lambda (e) (Send (_1 e) ["die"])) roster)))
        (Seq (DeepSeq dies dies)
          (Send (Ix 0 caps) ["bye"]))))
    (else (helm-loop core mk-worker st))))

;; The coordinator actor body: boot the helm, apply the initial
;; births, loop.  Spawn as (Spawn (helm-actor core mk-worker s0)).
;; The behavior registry is namespace state (/kook/<id>) — seed the
;; sovereign before taking the helm.
(define (helm-actor core mk-worker s0 self)
  (define b ((core-boot core) s0))
  (define roster (apply-duties mk-worker [] (_1 b)))
  (Seq (DeepSeq roster roster)
    (helm-loop core mk-worker [(_0 b) roster])))
