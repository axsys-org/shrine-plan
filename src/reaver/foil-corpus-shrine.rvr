(#bind std (#module std))
(#import std)

(#bind foil (#module foil))
(#bind prev (#module foil-corpus-sept))

;;; Corpus tier 2: shrine (see foil-corpus-sept for the tier scheme).

(define result
  (foil:compile-mod-cached prev:cache foil:default-subject "shrine"))
(define cache (_0 result))
(define shrine-sut (_1 result))


;; The loader records these stamps into this module's cache entry: the
;; tier re-executes (recompiling only what the warm chain below it
;; does not already carry) when any compiled source changes.
(define module-file-stamps (foil:foil-closure-files ["shrine"]))

(#export module-file-stamps cache shrine-sut)
