(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module biparser-tr))
(#import biparser-tr)
(#bind biparser-k7 (#module biparser-k7))
(#import biparser-k7)
(#bind biparser-prim (#module biparser-prim))
(#import biparser-prim)
(#bind empty-k7 (k7-mk tr-empty tr-empty))

(define (choice cassettes)
  (Ifz cassettes
    empty-k7
    (Ifz (Ix1 cassettes)
      (Ix0 cassettes)
      (k7-alt (Ix0 cassettes)
              (choice (Ix1 cassettes))))))

(define (many-B-cons-cont k head final-s tail-list)
  (k final-s [head tail-list]))

(define (many-B-failure k orig-s _s _x)
  (k orig-s 0))

(define (many-B-success rec-fn inner-B k kprime new-s head)
  (rec-fn inner-B
          (many-B-cons-cont k head) ;;; head becomes b 
          kprime
          new-s
          0))

(define many-B-impl
  (lambdarec (many-B-impl inner-B k kprime s _x)
    (inner-B
      (many-B-success many-B-impl inner-B k kprime)
      (many-B-failure k s)
      s
      0)))

(define (many-A-step rec-fn inner-A k kprime tail new-s _new-x)
  (rec-fn inner-A k kprime new-s tail))

(define many-A-impl
  (lambdarec (many-A-impl inner-A k kprime s xs)
    (Ifz xs ;;; list is empty print xs
      (k s xs) 
      (inner-A ;; satisfy-A-impl
        (many-A-step many-A-impl inner-A k kprime (Ix1 xs))
        kprime
        s
        (Ix0 xs)))))

(define (many p)
  (k7-mk (many-A-impl (k7-sideA p))
         (many-B-impl (k7-sideB p))))

(define (some p)
  (k7-cons p (many p)))

