(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module biparser-tr))
(#import biparser-tr)

(define (k7-mk sideA sideB)
    ["K7" sideA sideB])

(define (k7-sideA k7) (_1 k7))
(define (k7-sideB k7) (_2 k7))

(define (k7-compose f g) 
   (k7-mk 
    (tr-compose (k7-sideA f) (k7-sideA g))
    (tr-compose (k7-sideB f) (k7-sideB g))))

(define (k7-alt f g)
    (k7-mk
     (tr-alt (k7-sideA f) (k7-sideA g))
     (tr-alt (k7-sideB f) (k7-sideB g))))

(define (k7-id)
    (k7-mk tr-id tr-id))

(define (k7-b-done outer-k head final-s tail)
    (outer-k final-s [head tail]))

(define (k7-b-con-success gB outer-k kp new-s head)
    (gB (k7-b-done outer-k head) kp new-s 0))

(define (k7-con-B fB gB k kp s x)
    (fB (k7-b-con-success gB k kp) kp s x))

(define (k7-a-con-success gA outer-k kp tail new-s _new-x)
    (gA outer-k kp new-s tail))

(define (k7-con-A fA gA k kp s x)
    (fA (k7-a-con-success gA k kp (Ix1 x)) kp s (Ix0 x)))

(define (k7-cons f g)
    (k7-mk 
       (k7-con-A (k7-sideA f) (k7-sideA g))
       (k7-con-B (k7-sideB f) (k7-sideB g))))