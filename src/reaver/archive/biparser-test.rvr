;;;; biparser-test: full test suite covering primitives, combinators, and a toy language.

(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module biparser-tr))
(#import biparser-tr)
(#bind biparser-k7 (#module biparser-k7))
(#import biparser-k7)
(#bind biparser-prim (#module biparser-prim))
(#import biparser-prim)
(#bind biparser-combinator (#module biparser-combinator))
(#import biparser-combinator)


;;; ====================================================================
;;; PRIMITIVES: satisfy / eof / string-pp / set / nothing
;;; ====================================================================

(define (is-y? b) (Eq b "y"))
(define (is-n? b) (Eq b "n"))

;;; satisfy
assert(Eq 53 (parse  digit-k7 "5"))
assert(Eq 53 (pretty digit-k7 "5"))
assert(Eq 48 (parse  digit-k7 "0"))
assert(Eq  0 (parse  digit-k7 "x"))
assert(Eq  0 (pretty digit-k7 "x"))

;;; eof
(#bind eof-tagged (set 1 eof))
assert(Eq 1 (parse eof-tagged ""))
assert(Eq 0 (parse eof-tagged "x"))

;;; string-pp
assert(Eq 26984 (pretty (string-pp "hi") 0))
(#bind hi-tag (set 1 (string-pp "hi")))
assert(Eq 1 (parse hi-tag "hi"))
assert(Eq 0 (parse hi-tag "ho"))

;;; set
(#bind yes-tag (set 1 (string-pp "yes")))
(#bind no-tag  (set 2 (string-pp "no")))
assert(Eq 1 (parse yes-tag "yes"))
assert(Eq 2 (parse no-tag  "no"))
assert(Eq 0 (parse yes-tag "no"))
assert(Eq 7562617 (pretty yes-tag 999))


;;; ====================================================================
;;; K7 COMBINATORS: alt / compose / cons
;;; ====================================================================

(#bind y-or-n (k7-alt (satisfy is-y?) (satisfy is-n?)))
assert(Eq 121 (parse  y-or-n "y"))
assert(Eq 110 (parse  y-or-n "n"))
assert(Eq   0 (parse  y-or-n "z"))
assert(Eq 121 (pretty y-or-n "y"))
assert(Eq 110 (pretty y-or-n "n"))

(#bind tagged-digit (k7-compose (string-pp "tag:") digit-k7))
assert(Eq 53 (parse tagged-digit "tag:5"))
assert(Eq  0 (parse tagged-digit "no:5"))
assert(Eq "tag:5" (pretty tagged-digit "5"))

(#bind exact-yes (set 1 (k7-compose (string-pp "yes") eof)))
assert(Eq 1 (parse exact-yes "yes"))
assert(Eq 0 (parse exact-yes "yes "))

(#bind two-digits (k7-cons digit-k7 digit-k7))
assert(Eq [49 50] (parse two-digits "12"))
assert(Eq 12849 (pretty two-digits [49 50]))


;;; ====================================================================
;;; HIGHER COMBINATORS: many / some / sepBy / between / option
;;; ====================================================================

;;; many
(#bind digits (many digit-k7))
assert(Eq 0 (parse digits ""))
assert(Eq [53 0] (parse digits "5"))
assert(Eq [49 [50 0]] (parse digits "12"))
assert(Eq [49 0] (parse digits "1ab"))
assert(Eq 0 (pretty digits 0))

;;; some
(#bind digits1 (some digit-k7))
assert(Eq 0 (parse digits1 ""))
assert(Eq 0 (parse digits1 "ab"))
assert(Eq [49 0] (parse digits1 "1"))

;;; sepBy / sepBy1
(#bind digit-list (sepBy1 digit-k7 (string-pp ",")))
assert(Eq [49 0] (parse digit-list "1"))
assert(Eq [49 [50 0]] (parse digit-list "1,2"))
assert(Eq [49 [50 [51 0]]] (parse digit-list "1,2,3"))
assert(Eq 0 (parse digit-list ""))

(#bind digit-list0 (sepBy digit-k7 (string-pp ",")))
assert(Eq 0 (parse digit-list0 ""))

;;; between
(#bind paren-digit
  (between (string-pp "(") (string-pp ")") digit-k7))
assert(Eq 53 (parse paren-digit "(5)"))
assert(Eq  0 (parse paren-digit "(5"))
assert(Eq  0 (parse paren-digit "5)"))

;;; option
(#bind maybe-digit (option digit-k7 0))
assert(Eq 53 (parse maybe-digit "5"))
assert(Eq  0 (parse maybe-digit "x"))


;;; ====================================================================
;;; TOY LANGUAGE: arithmetic expressions with chainl
;;;
;;;   expr := digit ('+' digit)*
;;;
;;; opL builds a tree [a b], so "1+2+3" parses to [[49 50] 51].
;;; ====================================================================

(define (mk-add a b) [a b])

(#bind arith
  (chainl (string-pp "+") mk-add digit-k7))

;;; --- Parse: builds left-associative tree ---

assert(Eq 49 (parse arith "1"))
assert(Eq [49 50] (parse arith "1+2"))
assert(Eq [[49 50] 51] (parse arith "1+2+3"))
assert(Eq [[[[[49 50] 51] 52] 53] 54] (parse arith "1+2+3+4+5+6"))

;;; --- Pretty: walks tree back to string ---

;; Single leaf
assert(Eq "1" (pretty arith 49))

;; Two operands → "1+2"
assert(Eq "1+2" (pretty arith [49 50]))

;; Three operands → "1+2+3"
assert(Eq "1+2+3" (pretty arith [[49 50] 51]))

;; Six operands → full expression
assert(Eq "1+2+3+4+5+6" (pretty arith [[[[[49 50] 51] 52] 53] 54]))

;;; --- Roundtrip: pretty(parse(s)) == s ---

assert(Eq "1"           (pretty arith (parse arith "1")))
assert(Eq "1+2"         (pretty arith (parse arith "1+2")))
assert(Eq "1+2+3"       (pretty arith (parse arith "1+2+3")))
assert(Eq "1+2+3+4+5+6" (pretty arith (parse arith "1+2+3+4+5+6")))


"all-tests-passed"
