(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module biparser-tr))
(#import biparser-tr)
(#bind biparser-k7 (#module biparser-k7))
(#import biparser-k7)

(define (str-head s) (Trunc8 s))
(define (str-tail s) (Rsh s 8))
(define (str-empty? s) (Ifz s 1 0))

(define (parse-ok-k _new-s value) value)
(define (parse-fail-k _s _x) 0)

(define (parse k7 s)
  ((k7-sideB k7) parse-ok-k parse-fail-k s 0))

(define (pretty-ok-k built-s _new-x) built-s)
(define (pretty-fail-k _s _x) 0)

(define (pretty k7 x)
  ((k7-sideA k7) pretty-ok-k pretty-fail-k 0 x))

(define (satisfy-B-impl p k kprime s x)
  (Ifz (str-empty? s)
    (#let ((b (str-head s)))
      (Ifz (p b)
        (kprime s x)
        (k (str-tail s) b)))
    (kprime s x)))

(define (satisfy-A-impl p k kprime s x)
  (Ifz (p x)
    (kprime s x)
    (k (strWeld s x) x)))

(define (satisfy p)
  (k7-mk (satisfy-A-impl p)
         (satisfy-B-impl p)))

(#bind nothing (k7-id))

(define (eof-impl k kprime s x)
  (Ifz (str-empty? s)
    (kprime s x)
    (k s x)))

(#bind eof (k7-mk eof-impl eof-impl))

(define (string-A-impl x k _kprime s x-in)
  (k (strWeld s x) x-in))

(define (str-starts-with? prefix s)
  (Ifz (str-empty? prefix)
    (Ifz (str-empty? s)
      (Ifz (Eq (str-head prefix) (str-head s))
        0
        (str-starts-with? (str-tail prefix) (str-tail s)))
      0)
    1))

(define (str-strip-prefix prefix s)
  (Ifz (str-empty? prefix)
    (str-strip-prefix (str-tail prefix) (str-tail s))
    s))


(define (string-B-impl x k kprime s x-in)
  (Ifz (str-starts-with? x s)
    (kprime s x-in)
    ;; ((set-B-cont 1 parse-ok-k) 0 0)
    (k (str-strip-prefix x s) x-in)))

(define (string-pp x)
  (k7-mk (string-A-impl x)
         (string-B-impl x)))

;;; ignore the input value run the PP0s printer
(define (set-A-impl p-sideA k kprime s _ignored-x)
  (p-sideA k kprime s 0))

;;; run PP0s parser on its success inject the constant x
(define (set-B-cont x outer-k new-s _new-x)
  (outer-k new-s x))

(define (set-B-impl p-sideB x k kprime s x-in)
  (p-sideB (set-B-cont x k) kprime s x-in))

(define (set x p)
  (k7-mk (set-A-impl (k7-sideA p))
         (set-B-impl (k7-sideB p) x)))

(define (unset-A-impl p-sideA default k kprime s _x-ignored)
  (p-sideA k kprime s default))

(define (unset-B-cont outer-k new-s _new-x)
  (outer-k new-s 0))

(define (unset-B-impl p-sideB k kprime s x-in)
  (p-sideB (unset-B-cont k) kprime s x-in))

(define (unset default p)
  (k7-mk (unset-A-impl (k7-sideA p) default)
         (unset-B-impl (k7-sideB p))))
