(#bind std (#module std))
(#import std)

(define (tr-id k _kprime s x)
  (k s x))

(define (tr-empty _k kprime s x)
  (kprime s x))

(define (tr-compose-success g ok okp ns nx)
  (g ok okp ns nx))

(define (tr-compose f g k kp s x)
  (f (tr-compose-success g k kp) kp s x))

(define (tr-alt-fail g outer-k outer-kprime orig-s orig-x _s _x)
  (g outer-k outer-kprime orig-s orig-x))

(define (tr-alt f g k kprime s x)
  (f k (tr-alt-fail g k kprime s x) s x))
