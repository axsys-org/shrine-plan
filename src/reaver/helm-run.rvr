;;;; The lain runtime orchestration: boot the compiled world into a
;;;; sovereign, run the serve loop, persist a resume continuation per
;;;; event.  The HTTP driver proper (workers, conn actors, parsing)
;;;; lives in helm-http.rvr; this module wires it to the coordinator.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind milton (#module milton))
(#bind wisp (#module wisp))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind opt (#module plangrm))



(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind http-client (#module http-client))
(#bind helm-fetch (#module helm-fetch))
(#bind helm-chore (#module helm-chore))
(#bind helm-doctest (#module helm-doctest))
(#bind helm-build (#module helm-build))
(#bind doctest (#module doctest))
(#bind helm-http (#module helm-http))
(#bind helm-sync (#module helm-sync))
(#bind helm-repl (#module helm-repl))
(#bind helm-llm (#module helm-llm))
;; The namespace path macros (p"myth/new", t"io", n"kook/llm",
;; a"myth/new") come from helm.rvr through this import.
(#import helm)

;; The reaver bytecode compiler, by store name.  The installed
;; compiler is process state, not snapshot state: every Saved
;; continuation must (Install BYTECODE-COMPILER) on entry, or the
;; resumed process runs interpreted and any module (re)load falls
;; back to stale caches ("no compiler set! failing compile").


;; The live stack, split at the snapshot boundary:
;;   build-lain-sov   the seeding half — compile the world, mirror
;;                    /boot, mount apps, sweep doctests.  Fresh boot
;;                    only; a resume already carries its sovereign.
;;   serve-lain       the runtime half — MAIN warm, worker glue, the
;;                    coordinator.  Shared verbatim by fresh boot and
;;                    resume, so both processes force the same call
;;                    graphs.
;; A live serve persists: after every committed event the coordinator
;; hands the forced helm state to persist (write-ahead, before any
;; ack), which Saves a pin of "sweep, serve this sovereign, park" —
;; the snapshot IS the resume continuation, the same mechanic the
;; reaver repl uses.  Killing the process and starting the snapshot
;; resumes the namespace.  Workers, conn actors, and in-flight
;; requests are ephemeral: boot re-births workers from the /io scan,
;; and the orphaned request nodes are culled on resume.

(define (lain-park z)
  (Seq (Recv 0) (lain-park z)))

;; Boot phase stamps: force the phase INSIDE the stamp (laziness
;; would otherwise attribute its work to whoever demands it first)
;; and mark the wall clock.  DeepSeq stops at pins, so re-forcing is
;; cheap.  Now is 1s resolution — phases are tens of seconds.
(define (phase-stamp name v)
  (Seq (DeepSeq v 0) (Seq (Trace ["PHASE" name (Now 0)] 0) v)))

;; The compiled world a serve closes over, pinned once: every saved
;; snapshot references it by hash, so the core costs one pin file
;; ever, not one per event.
(define (serve-pin core mcache)
  (Pin ["LAIN_SERVE" core mcache]))

;; Cull the request nodes a killed process left under /io: their conn
;; actors died with it, so nobody will ever answer or cull them, and
;; a fresh serial would eventually collide (request makes fail on
;; occupied nodes).  Journal-free run_event: hygiene, not history.
(define (sweep-orphans core sov)
  (define peek-f ent"peek")
  (define kid-keys ent"axal/kid_keys")
  (define run-event ent"run_event")
  (define vine-cull ent"vine_cull")
  (define tio t"io")
  (define (cull-kid ion s kid)
    (let ((r (run-event (vine-cull [tio ion kid]) 0 s)))
      (If (Eq "/boot/ovum/ripe" (Hd r)) (_0 r) s)))
  (define (cull-io s ion)
    (foldl (cull-kid ion) s (kid-keys (peek-f [tio ion] s))))
  (foldl cull-io sov (kid-keys (peek-f [tio] sov))))

;; The runtime half.  pk = (serve-pin core mcache); live? arms
;; per-event persistence (0 for test and repl boots).
;; -> [core coord mcache]  (mcache is the serve terminal's starting
;; compile cache — helm-sync.rvr threads rebuilds through it)
(define (serve-lain live? port fetch? pk sov0)
  (define pb (Unpin pk))
  (define core (Ix 1 pb))
  (define mcache (Ix 2 pb))
  ;; Warm the socket path in MAIN: spawned actors have no compiler,
  ;; so any lazily-expanded define first demanded inside one dies
  ;; with "no compiler set".  DeepSeq stops at pins, so the warmup
  ;; CALLS each path once — executing in main compiles the whole
  ;; call graph the pump and connection actors will touch.  A resume
  ;; re-runs this same block, so both processes force identically.
  (define warm
    (phase-stamp "main-warm"
    (DeepSeq
      [(DeepSeq [helm-http:conn-actor helm-http:listener-pump helm-http:mk-http-worker

                 helm-fetch:mk-fetch-worker helm-fetch:fetch-actor
                 helm-chore:mk-chore-worker helm-chore:chore-actor
                 helm-doctest:dt-family helm-doctest:dt-plan
                 helm-doctest:dt-run] 0)
       ;; one real evaluation compiles the doctest eval pipeline in
       ;; MAIN — the worker only replays compiled paths
       (doctest:eval-text (helm:core-sut core) "(add 1 1)")
       (Try (lambda (z) (milton:parse-http-request "get /x http/1.1")) 0)
       (Try (lambda (z) (milton:parse-http-request "GET /x HTTP/1.1")) 0)
       (helm-http:url-target "/ns/a/b")
       (helm-http:op-url? "/op/x")
       (helm-http:all-digits? "12")
       (helm-http:http-res 200 "text/plain" "hi")
       (helm-http:http-res 500 "text/plain" "no")
       (helm-http:request-body (strcat ["GET / HTTP/1.0" helm-http:crlf helm-http:crlf "body"]))
       (helm-fetch:warm 0)
       ;; the local runtime may lack the Fetch primop (op-83): the
       ;; fetch-less boot skips its warm and its driver below
       (If fetch? (http-client:fetch-warm 0) 0)]
      0)))
  (define (app path) (helm:core-ent core path))
  ;; t_data / put_nat left the app: rebuild them from the myth kit
  ;; (myth/new is a constant now — the entry value IS the empty myth)
  (define myth-new a"myth/new")
  (define myth-add a"myth/add")
  (define limb-nat a"twig/nat")
  (define (put-nat t slot n) (myth-add (limb-nat slot n) t))
  (define helpers
    ["H" a"http/req" a"myth/nat_at" a"vine_make"
     a"vine_cull" a"myth/txt_at"
     a"build/eval_req" a"build/compile_req"
     a"build/save_req" a"vine_poke"
     ;; the write-box eval subject rides as a doctest bundle so its
     ;; TypeWorld is built once per serve, not once per request
     (doctest:bundle (helm:core-sut core))
     myth-new a"myth/add" a"twig/txt"
     a"weft/runtime"
     a"vine_warp" a"twig/nat"])
  (define fetch-run (app ["fetch_driver" "run"]))
  (define dhelpers
    ["D" (helm:core-sut core) mcache
     a"myth/pail_at" a"doctest/card"
     a"chore/mkp_t"])
  (define chelpers
    ["C" a"fetch/fresh" a"chore/fam_of"
     a"chore/done_t" a"chore/fail_t"
     a"chore/clear_t" a"chore/cmd_parts"
     a"vine_poke" a"vine_make"])
  (define bs [core mcache])
  (define fams
    (Weld [(helm-doctest:dt-family dhelpers)]
      (helm-build:build-families bs)))
  (define (mk-worker n)
    (cond
      ((Equal n t"http_client")
        (helm-fetch:mk-fetch-worker fetch-run n))
      ((Equal n t"doctest")
        (helm-chore:mk-chore-worker chelpers fams n))
      ((Equal n t"chore")
        (helm-chore:mk-chore-worker chelpers fams n))
      (else (helm-http:mk-http-worker (helm-http:prepare helpers) (app ["http_driver" "step"]) n))))
  ;; Write-ahead persistence: the resume pin closes over the event's
  ;; committed sovereign; starting the snapshot sweeps the orphans,
  ;; re-serves, and parks.
  (define (persist hm)
    (Seq
      ;; live serves only: Install requires the plangrm pin to be IN
      ;; THE SNAP STORE already ("compiler PIN must be saved first" is
      ;; a hard runtime abort, and it kills the coordinator this runs
      ;; in — the whole stack then deadlocks on Recv).  The x/lain
      ;; staging saves the pin (load_stdlib's Install rides its own
      ;; top-level form, and the repl saves per form); ephemeral
      ;; stacks (tests, the buddy) must not gamble on it.
      ;; P2 pervasively: the higher optimizer tiers make the initial
      ;; boot's compiler install far slower for little serve-time
      ;; gain — P2 is the deliberate boot-speed choice.
      (If live?
        (seqN
          (print "persisting")
          (Install opt:compileP2)
          (print "installed bytecode compiler")
          0)
        0)
      (If live?
      (let ((sv (_0 hm)))
        (Save (Pin (lambda (args)
          ;; Install first: the compiler is process state, and a
          ;; resumed process must be able to (re)compile — without
          ;; it, module loads fall back to stale caches and lazy
          ;; rvr thunks die ("no compiler set").
          ;; Ix 1 then forces the coord cell — serve-lain's defines
          ;; are lazy, and nothing else on the resume path demands
          ;; the coordinator (the fresh path forces it by
          ;; injecting).  An unforced coord is a namespace that
          ;; never spawns: MAIN parks alone and the runtime exits
          ;; on deadlock.  The resume then takes the terminal on the
          ;; same terms a fresh boot does, so a resumed namespace can
          ;; be synced too (and parks by itself when stdin is not one).
          ;; core is rebound from pk HERE, not captured from the
          ;; enclosing scope: a Silo stream references only PINs by
          ;; hash, so a captured raw core (the unpinned interior of
          ;; pk) would re-serialize the whole compiled world into
          ;; every per-event snapshot (~13 MiB/event) instead of
          ;; riding pk's one-time pin file.
          (Seq (Install opt:compileP2)
            (let ((core (Ix 1 (Unpin pk))))
            (let ((rs (serve-lain 1 port fetch? pk (sweep-orphans core sv))))
              (Seq (Ix 1 rs)
                (Seq (Trace ["lain resumed" port] 0)
                  (helm-sync:run-cli (Ix 0 rs) (Ix 1 rs) (Ix 2 rs) port))))))))))
        0)))
  ;; seed in MAIN (DeepSeq before Spawn): the reef seeding code cannot
  ;; compile-on-demand inside the coordinator ("no compiler set")
  (define coord
    (Seq warm
      ;; put-nat is local glue the workers call: one MAIN call compiles it
      (Seq (DeepSeq (put-nat myth-new n"warm" 1) 0)
        ;; chore glue: one MAIN call per compiled entry and rvr path the
        ;; chore worker and its leaves replay off-MAIN.  The orphan
        ;; sweep warms here too, so a resumed MAIN can replay it.
        (Seq (DeepSeq
               [(a"chore/done_t" 1 0)
                (a"chore/clear_t" t"k")
                (a"chore/fail_t" t"x")
                (a"chore/fam_of" t"d" myth-new)
                (a"chore/cmd_parts"
                  (a"chore/mkp_t" n"a" myth-new))
                (helm-doctest:dt-plan dhelpers
                  (a"dt/req" n"boot") n"io")
                ;; the build families: plan and run each once in MAIN —
                ;; the resync warm compiles a real module against the
                ;; cache, covering the leaf's whole compile/report graph
                ;; warm on tiny fixtures: demo (no imports, declares
                ;; add) for eval, mapx (imports map) for the compile/
                ;; save/resync graph — the warm covers code paths, not
                ;; modules, and sept/weft here cost ~4 full elabs
                (helm-build:eval-plan bs
                  (a"build/eval_req" "demo" "(add 1 1)")
                  n"io")
                (helm-build:eval-run bs ["demo" "(add 1 1)" n"io"] 0)
                (helm-build:compile-plan bs
                  (a"build/compile_req" "mapx") n"io")
                (helm-build:save-plan bs
                  (a"build/save_req" "mapx" "x") n"io")
                (helm-build:resync-run bs ["mapx" n"io"] 0)
                (helm-http:form-field "expr" "expr=%28add+1+1%29")
                (sweep-orphans core sov0)]
               0)
          (Seq (DeepSeq sov0 sov0)
            (Spawn (helm:helm-actor core mk-worker persist sov0)))))))
  [core coord mcache])

;; The seeding half: compile the whole world and grow the first
;; sovereign — /boot mirror, /boot/ns indices, fail cards, mounted
;; apps, the doctest sweep.  -> [mcache sov]


;; The dev grant policy: x/lain grants every app whatever its manifest
;; asks for.  A production boot passes a [name allow-fetch allow-serve]
;; row instead, and anything not named is denied (helm:grants-for).
(define dev-grants-policy "all")

(define (build-lain-sov core)
  (define (app path) (helm:core-ent core path))
  (define sov0 (phase-stamp "seed-kern" a"seeded_kern"))
  ;; the generated OpenRouter client goes in FIRST: it has no file on
  ;; disk, so the chat app's by-name import of it resolves only off
  ;; this shared cache (helm-llm.rvr)
  (define lc (phase-stamp "compile-llm-client"
               (helm-llm:llm-client-cache (helm:core-cache core))))
  ;; apps compile before the mirror is built, against the core's own
  ;; cache, so app modules mirror (lore included) like kernel code
  (define ar (phase-stamp "compile-apps" (helm:compile-apps core (_0 lc) (helm:discover-apps 0))))
  ;; full-roster mirroring: every module on disk compiles into the
  ;; boot cache so the whole tree mirrors; failures get fail cards
  (define rr
    (phase-stamp "compile-roster"
    (If helm:mirror-all?
      (helm:compile-roster (_0 ar)
        (helm:mirror-roster (foil:read-fs-tree "foil")))
      [(_0 ar) []])))
  (define full-cache (_0 rr))
  ;; the boot image, introspectable at /boot: entries, /boot/ns
  ;; indices, and fail cards for the broken modules
  ;; batched: one pact event per module subtree + one for /boot/ns,
  ;; instead of one event per mirrored node (~40 commits vs ~1,500)
  (define mirror
    (phase-stamp "mirror-tasks"
      (Weld (helm:boot-mirror-pact-tasks-with full-cache core)
        (Weld [(helm:boot-ns-pact-task core full-cache)]
          (helm:boot-fail-tasks core (_1 rr))))))
  (define sov1
    (phase-stamp "seed-mirror"
      (Seq (Trace ["mirroring /boot" (Sz mirror) "failed" (Sz (_1 rr))] 0)
        (helm:seed-tasks core sov0 mirror))))
  ;; NO app mounts at boot: /boot mirrors every compiled app module
  ;; (the catalog), /app stays an empty reserved root, and a warp of
  ;; /kook/install at the chosen root is the explicit install —
  ;; boot-lain-with registers that op with the compiled roster (ar)
  ;; closed over, after the listener is up.
  ;; the doctest sweep no longer blocks the boot: boot-lain-with
  ;; injects its verdict tasks through the coordinator AFTER the
  ;; listener is up (helm:doctest-sweep? still gates it there)
  ;; lc rides along: boot-lain-with registers the generated hand's
  ;; form from it, which the app deliberately does not carry
  [full-cache sov1 lc (_1 ar)])

;; Fresh boot end to end: seed, serve, inject the driver configs.  A
;; resume skips all of this — the sovereign already carries the /io
;; nodes, and (core-boot)'s /io scan re-births their workers.
;; core0 is passed unevaluated (laziness defers any compile inside it
;; until this runs in MAIN).
(define (boot-lain-with live? port fetch? key core0)
  (define core (phase-stamp "compile-core" core0))
  (define (app path) (helm:core-ent core path))
  (define bl (build-lain-sov core))
  (define pk (serve-pin core (_0 bl)))
  (define r (serve-lain live? port fetch? pk (_1 bl)))
  (define coord (_1 r))
  (define myth-sing a"myth/sing")
  (define pd-f a"pd")
  (define (t-data slot n) (myth-sing slot (pd-f n)))
  (define vine-make a"vine_make")
  (define vine-poke a"vine_poke")
  ;; lain's `pt`, NOT ["pails" "t"]: pails/t is a nominal record, so
  ;; the subject entry at that path is its type and applying it yields
  ;; a slot no reader can unwrap — the credential arrived as an empty
  ;; "Bearer " header and OpenRouter answered 401.
  (define pails-t a"pt")
  (define cfg-port a"http/cfg_port")
  ;; The generated hand, registered ONCE in the kernel's own behavior
  ;; registry and referred to by path — never carried in the app's
  ;; manifest, whose every copy would drag the whole compiled client
  ;; (see helm-llm:llm-serve-form).  The chat app's credential rides
  ;; the SAME card at ['auth]: chat is not mounted at boot, so the
  ;; install (helm-sync) reads it back from here and pokes it onto
  ;; the app's hand node.  It arrives as a boot ARGUMENT rather than
  ;; a file: this runtime has no environment primop, and writing it
  ;; under src/ would put a secret in the source tree.  An empty key
  ;; is a real case (unauthenticated calls), not an error.
  (define llm-kook-path n"kook/llm")
  (define llm-card0
    (a"form/card" (helm-llm:llm-serve-form (Ix 2 bl))
      (a"lore/line"
        "The generated OpenRouter hand: take fetches each request kid, hear parses the answer into bond/res.")))
  (define llm-card
    (If (Bytes key)
      (a"myth/add" (a"twig/txt" n"auth" key) llm-card0)
      llm-card0))
  (define llm-kook-task (vine-make llm-kook-path llm-card))
  ;; The install op: warp /kook/install at any root to mount the app
  ;; named by the input's ['app] slot there.  The fn closes over the
  ;; boot-compiled roster and the grant policy — authority stays
  ;; host-side (helm:install-fn).
  (define install-task
    (vine-make n"kook/install"
      (a"install_card"
        (helm:install-fn core (Ix 3 bl) dev-grants-policy))))
  (define (inject t)
    (Seq (SendCaps coord (DeepSeq t ["task" t]) [0])
      (Recv 0)))
  ;; something to look at
  (Seq (inject (vine-make n"data/hello" (t-data n"num" 41)))
    (Seq (inject (vine-make n"data/hello/world" (t-data n"num" 42)))
      ;; the drivers: explorer responder on a real listener, plus the
      ;; outbound fetch driver at /io/http-client
      (Seq (inject (vine-make n"io/http" (cfg-port t"hex" port)))
        (Seq (If fetch?
               (inject (vine-make n"io/http_client" a"fetch/cfg"))
               0)
        (Seq (inject (vine-make n"io/doctest" a"dt/cfg"))
        (Seq (inject (vine-make n"io/chore"
               (a"chore/cfg" t"eval")))
        ;; register the kernel capabilities apps resolve by path: the
        ;; generated LLM hand (credential riding its card) and the
        ;; install op — installs happen AFTER boot, through warps
        (Seq (inject llm-kook-task)
        (Seq (inject install-task)
        (Seq (If (Bytes key)
               (Trace ["chat: api key staged on /kook/llm" (Bytes key)] 0)
               (Trace ["chat: no OPENROUTER_API_KEY — calls will be unauthenticated"] 0))
        (Seq (Trace ["PHASE" "listening" (Now 0) port] 0)
          ;; The expensive mirror garnishes run AFTER the listener is
          ;; up, streaming through the coordinator while the explorer
          ;; serves: first the who-calls rows (mirror-refs?), then the
          ;; doctest sweep (doctest-sweep? — which also keeps its
          ;; warming role: running every doctest compiles the eval
          ;; pipeline's call graph before the chore driver's leaf
          ;; actors replay it).
          (Seq (If helm:mirror-refs?
                 (Seq (Trace ["who-calls upgrade (post-listen)"] 0)
                   (inject (helm:ref-upgrade-task (_0 bl) core)))
                 0)
          (Seq (If helm:doctest-sweep?
                 (Seq (Trace ["doctest sweep (post-listen)"] 0)
                   (Seq
                     (foldl (lambda (z t) (Seq (inject t) 0)) 0
                       (helm:doctest-tasks (_0 bl) core (_1 bl)))
                     (Trace ["PHASE" "sweep-done" (Now 0)] 0)))
                 0)
            [core coord (_0 bl)])))))))))))))

(define (boot-lain-stack port fetch? core0)
  (boot-lain-with 0 port fetch? "" core0))

(define (run-lain-boot port core0)
  (Seq (boot-lain-stack port 1 core0)
    ;; park: the coordinator and its actors do the work now
    (lain-park 0)))

(define (run-lain port)
  (run-lain-boot port (helm:load-helm-mod "helmapp")))

;; The persistent serve (x/lain): compile the world from source,
;; persist every committed event, then take the terminal (helm-sync.rvr
;; — "s" syncs foil/ into the namespace and rebuilds; EOF parks, so a
;; backgrounded serve behaves exactly as it did before).  After a kill,
;; starting the snapshot (wisp snap root _) resumes the namespace from
;; the last saved pin — the snapshot is the only build cache there is.
;; key is the OpenRouter credential, passed through from the caller's
;; environment (see the auth-task note in boot-lain-with).  "" is a
;; boot with no credential, which still serves — the calls just go out
;; unauthenticated and come back 401.
(define (run-lain-serve port key)
  (Seq (Trace ["lain" "serving" port] 0)
    (let ((r (boot-lain-with 1 port 1 key (helm:load-helm-mod "helmapp"))))
      ;; Ix 1 forces the boot before the terminal is taken.  The Seq
      ;; the park used to provide did this implicitly; without it the
      ;; whole boot stays a thunk and the CLI prints a prompt in front
      ;; of a namespace nothing has built yet (no listener, no
      ;; coordinator) until the first command happens to demand it.
      (Seq (Ix 1 r)
        (helm-sync:run-cli (Ix 0 r) (Ix 1 r) (Ix 2 r) port)))))

;; A live serve that does NOT persist: same stack, same drivers, same
;; apps — but no Save per committed event.  Persisting pins the whole
;; compiled world, and the generated OpenRouter client makes that
;; graph expensive enough that the first Save after boot has run for
;; tens of minutes without finishing.  This path exists to run and
;; verify the namespace while that cost is a separate problem: kill it
;; and the namespace is gone, which is the trade being made.
(define (run-lain-live port key)
  (Seq (Trace ["lain" "serving (no persistence)" port] 0)
    (Seq (boot-lain-with 0 port 1 key (helm:load-helm-mod "helmapp"))
      (lain-park 0))))


;; The buddy (x/repl): boot the full lain stack (explorer live on
;; http-port), then take helm-repl's terminal.  Lives HERE, not in
;; helm-repl.rvr: helm-sync binds helm-repl for the wire handlers, so
;; helm-repl must not bind helm-run back — the loader does not detect
;; import cycles, it re-loads the ring forever.  fetch?=0 skips the
;; outbound-fetch driver (the local runtime lacks the Fetch primop);
;; wire-port 0 skips the editor wire.
(define (run-repl http-port poke-port wire-port fetch?)
  (define r (boot-lain-stack http-port fetch? (helm:load-helm-mod "helmapp")))
  (helm-repl:take-terminal (Ix 0 r) (Ix 1 r) http-port poke-port wire-port))
