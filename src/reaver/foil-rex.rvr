(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind newtype (#module newtype))
(#import newtype)

(#bind rex (#module rex))
(#import rex)

;;; Normalized Rex helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Thin faces over rex's exported newtype declarations (Leaf, Nest,
;; Juxt, RexSpan).  Normalized rex only ever contains those three node
;; kinds, so the helpers keep their historical names and the typed
;; accessors underneath.

(define rx-tag Hd)
;; Every Rex constructor carries its span at slot 0, so this accessor
;; stays shape-generic across the union.
(define rx-span Ix0)
(define (rx-is? typ x)
  (And (IsApp x) (Eq (_0 typ) (rx-tag x))))
(define rx-leaf? (rx-is? Leaf))
(define rx-nest? (rx-is? Nest))
(define rx-juxt? (rx-is? Juxt))

(define rx-leaf-shape Leaf.shape)
(define rx-leaf-str Leaf.text)
(define rx-nest-color Nest.color)
(define rx-nest-rune Nest.rune)
(define rx-nest-kids Nest.kids)
(define rx-juxt-kids Juxt.kids)

(define rx-leaf MakeLeaf)
(define rx-nest MakeNest)
(define rx-juxt MakeJuxt)

;;; Spans ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define span-line RexSpan.line)
(define span-col RexSpan.column)
(define span-off RexSpan.offset)
(define span-len RexSpan.length)

(define (span-end x)
  (Add (span-off x) (span-len x)))
(define set-span-len RexSpan.=length)
(define (set-span-end end x)
  (set-span-len (Sub end (span-off x)) x))

(define (span-first x y)
  (If (Lt (span-off x) (span-off y))
    x y))
(define (span-last x y)
  (If (Lt (span-end x) (span-end y))
    y x))

(define (span-join x y)
  (define first (span-first x y))
  (define last (span-last x y))
  (set-span-end (span-end last) first))

assert(Equal [1 2 10 5] (span-first [1 2 10 5] [3 4 20 5]))
assert(Equal [1 2 10 5] (span-first [3 4 20 5] [1 2 10 5]))
assert(Equal [3 4 20 5] (span-last [1 2 10 5] [3 4 20 5]))
assert(Equal [3 4 20 5] (span-last [3 4 20 5] [1 2 10 5]))
assert(Equal [1 2 10 15] (span-join [3 4 20 5] [1 2 10 5]))

(define (span-join-row rexs)
  (foldr1 span-join (map rx-span rexs)))

;;; Shape helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (rx-shape? shape x)
  (And (rx-leaf? x) (Eq shape (rx-leaf-shape x))))
(define rx-word? (rx-shape? "word"))
(define rx-slug? (rx-shape? "slug"))
(define (rx-literal? x)
  (And (rx-leaf? x)
    (Or (Eq "quip" (rx-leaf-shape x))
      (Or (Eq "cord" (rx-leaf-shape x))
        (Or (Eq "tape" (rx-leaf-shape x))
          (Or (Eq "span" (rx-leaf-shape x))
            (Eq "page" (rx-leaf-shape x))))))))

(define (rx-word-str! x)
  assert(rx-word? x)
  (rx-leaf-str x))
(define (rx-nest-is? color rune x)
  (And (rx-nest? x)
    (And (Eq color (rx-nest-color x))
      (Eq rune (rx-nest-rune x)))))
(define (rx-rune? rune x)
  (rx-nest-is? "clear" rune x))
(define rx-rune-kids rx-nest-kids)
(define (rx-plain? color x)
  (rx-nest-is? color "" x))
;; Splice statement containers one level: horizontal juxts (historic
;; behavior) and vertical groups (empty-rune clear nests, the block
;; form heirs normalize to).
(define (rx-juxt-flat xs)
  (define (f acc arg)
    (Weld acc
      (cond
        ((rx-juxt? arg) (rx-juxt-kids arg))
        ((rx-plain? "clear" arg) (rx-nest-kids arg))
        (else [arg]))))
  (foldl f 0 xs))

;; Splice ONLY vertical groups — for operand lists where a horizontal
;; juxt is itself one operand (method segments, spec juxts).
(define (rx-group-flat xs)
  (define (f acc arg)
    (Weld acc
      (If (rx-plain? "clear" arg)
        (rx-nest-kids arg)
        [arg])))
  (foldl f 0 xs))

(define (rx-comment? x)
  (rx-slug? x))
(define (not-comment x)
  (Nil (rx-comment? x)))
(define (hr-stem xs)
  (filter not-comment xs))
