(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

;;; Normalized Rex helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define rx-tag Hd)
(define rx-span Ix0)
(define (rx? tag x) (Eq tag (rx-tag x)))
(define (rx-bad ctx want have)
  (error ("FAILED REX" ctx "expected" want "got" have)))

(define rx-leaf? (rx? "leaf"))
(define rx-nest? (rx? "nest"))
(define rx-juxt? (rx? "juxt"))

(define rx-leaf-shape (Ix 1))
(define rx-leaf-str (Ix 2))
(define rx-nest-color (Ix 1))
(define rx-nest-rune (Ix 2))
(define rx-nest-kids (Ix 3))
(define rx-juxt-kids (Ix 1))

(define rx-leaf rex:MakeLeaf)
(define rx-nest rex:MakeNest)
(define rx-juxt rex:MakeJuxt)

;;; Spans ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define span-line (Ix 0))
(define span-col (Ix 1))
(define span-off (Ix 2))
(define span-len (Ix 3))

(define (span-end x)
  (Add (span-off x) (span-len x)))
(define set-span-line (Up 0))
(define set-span-col (Up 1))
(define set-span-off (Up 2))
(define set-span-len (Up 3))
(define (set-span-end end x)
  (set-span-len (Sub end (span-off x)) x))

(define (span-first x y)
  (If (Lt (span-off x) (span-off y))
    x y))
(define (span-last x y)
  (If (Lt (span-end x) (span-end y))
    y x))

(define (span-join x y)
  (define first (span-first x y))
  (define last (span-last x y))
  (set-span-end (span-end last) first))

assert(Equal [1 2 10 5] (span-first [1 2 10 5] [3 4 20 5]))
assert(Equal [1 2 10 5] (span-first [3 4 20 5] [1 2 10 5]))
assert(Equal [3 4 20 5] (span-last [1 2 10 5] [3 4 20 5]))
assert(Equal [3 4 20 5] (span-last [3 4 20 5] [1 2 10 5]))
assert(Equal [1 2 10 15] (span-join [3 4 20 5] [1 2 10 5]))

(define (span-join-row rexs)
  (foldr1 span-join (map rx-span rexs)))

;;; Shape helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (rx-shape? shape x)
  (And (rx-leaf? x) (Eq shape (rx-leaf-shape x))))
(define rx-word? (rx-shape? "word"))
(define rx-slug? (rx-shape? "slug"))
(define (rx-literal? x)
  (And (rx-leaf? x)
    (Or (Eq "quip" (rx-leaf-shape x))
      (Or (Eq "cord" (rx-leaf-shape x))
        (Or (Eq "tape" (rx-leaf-shape x))
          (Or (Eq "span" (rx-leaf-shape x))
            (Eq "page" (rx-leaf-shape x))))))))

(define (rx-word-str! x)
  assert(rx-word? x)
  (rx-leaf-str x))
(define (rx-get-word x)
  (rx-leaf-str x))

(define (rx-nest-is? color rune x)
  (And (rx-nest? x)
    (And (Eq color (rx-nest-color x))
      (Eq rune (rx-nest-rune x)))))
(define (rx-rune? rune x)
  (rx-nest-is? "clear" rune x))
(define rx-rune-kids rx-nest-kids)
(define (rx-plain? color x)
  (rx-nest-is? color "" x))
(define (rx-brack? color x)
  (And (rx-nest? x) (Eq color (rx-nest-color x))))

(define (rx-juxt-flat xs)
  (define (f acc arg)
    (Weld acc
      (If (rx-juxt? arg)
        (rx-juxt-kids arg)
        [arg])))
  (foldl f 0 xs))

(define (rx-comment? x)
  (rx-slug? x))
(define (not-comment x)
  (Nil (rx-comment? x)))
(define (hr-stem xs)
  (filter not-comment xs))
