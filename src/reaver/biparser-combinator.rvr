(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module biparser-tr))
(#import biparser-tr)
(#bind biparser-k7 (#module biparser-k7))
(#import biparser-k7)
(#bind biparser-prim (#module biparser-prim))
(#import biparser-prim)
(#bind empty-k7 (k7-mk tr-empty tr-empty))

(define (choice cassettes)
  (Ifz cassettes
    empty-k7
    (Ifz (Ix1 cassettes)
      (Ix0 cassettes)
      (k7-alt (Ix0 cassettes)
              (choice (Ix1 cassettes))))))

(define (many-B-cons-cont k head final-s tail-list)
  (k final-s [head tail-list]))

(define (many-B-failure k orig-s _s _x)
  (k orig-s 0))

(define (many-B-success rec-fn inner-B k kprime new-s head)
  (rec-fn inner-B
          (many-B-cons-cont k head) ;;; head becomes b 
          kprime
          new-s
          0))

(define many-B-impl
  (lambdarec (many-B-impl inner-B k kprime s _x)
    (inner-B
      (many-B-success many-B-impl inner-B k kprime)
      (many-B-failure k s)
      s
      0)))

(define (many-A-step rec-fn inner-A k kprime tail new-s _new-x)
  (rec-fn inner-A k kprime new-s tail))

;;; k = (many-A-step many-A-impl inner-A pretty-ok-k pretty-fail-k [50..])
;;; k applied to => (strWeld '..' head) head

(define many-A-impl
  (lambdarec (many-A-impl inner-A k kprime s xs)
    (Ifz xs ;;; list is empty print xs
      (k s xs) 
      (inner-A ;; satisfy-A-impl
        (many-A-step many-A-impl inner-A k kprime (Ix1 xs))
        kprime
        s
        (Ix0 xs)))))

(define (many p)
  (k7-mk (many-A-impl (k7-sideA p))
         (many-B-impl (k7-sideB p))))

(define (some p)
  (k7-cons p (many p)))

(define (sepBy1 p sep)
  (k7-cons p (many (k7-compose sep p))))

(define (sepBy p sep)
  (k7-alt (sepBy1 p sep) (set 0 nothing)))

(define (between open close middle)
  (k7-compose open (k7-compose middle close)))

(define (option p x)
  (k7-alt p (set x nothing)))

(define (chainl-B-helper2 rec opP opL xP k kprime left_x s right_x)
  (rec opP opL xP k kprime s (opL left_x right_x)))

(define (chainl-B-helper1 rec opP opL xP k kprime left_x s _x)
  (xP
    (chainl-B-helper2 rec opP opL xP k kprime left_x)
    kprime
    s
    0))

(define (chainl-B-exit k acc s _x)
  (k s acc))

(define (chainl-B-cont opP opL xP k kprime s x)
  (opP
    (chainl-B-helper1 chainl-B-cont opP opL xP k kprime x)
    (chainl-B-exit k x)
    s
    0))

(define (chainl-B-impl opP opL xP k kprime s _x)
    (xP 
      (chainl-B-cont opP opL xP k kprime)
      kprime
      s 
      0))

(define (helper-after-op opP opL xP k kprime right s _x)
  (xP k kprime s right))

(define (helper-after-left opP opL xP k kprime right s _x)
  (opP (helper-after-op opP opL xP k kprime right) kprime s 0))

(define chainl-A-impl
    (lambdarec (chainl-A-impl opP opL xP k kprime s x)
      (Ifz (IsNat x)
      (chainl-A-impl opP opL xP (helper-after-left opP opL xP k kprime (Ix1 x)) kprime s (Ix0 x))
      (xP k kprime s x))))

(define (chainl opP opL xP)
  (k7-mk (chainl-A-impl (k7-sideA opP) opL (k7-sideA xP))
         (chainl-B-impl (k7-sideB opP) opL (k7-sideB xP))))


