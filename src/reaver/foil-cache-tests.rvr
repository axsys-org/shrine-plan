(#bind fixture (#module foil-test-context))
;;;; The foil compile cache: top-level hits, no duplicates, lore on
;;;; the entry.  (Moved from forge-tests when the forge retired; the
;;;; forge-state cache wrappers died with it.)

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-render (#module foil-render))
(#bind foil-lore (#module foil-lore))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))

(define (check z)
  (define cold (source:compile (fixture:files 0 ["mapuser"]) 0 "mapuser"))
  (define hit (source:compile (fixture:cached-context (_0 cold) "mapuser") (_0 cold) "mapuser"))
  assert(Equal cold hit)
  (define names (map driver:perc-name (driver:cache-results (_0 hit))))
  assert(all (lambda (name) (Eq 1 (Sz (filter (Equal name) names)))) names)
  (define built (source:compile (fixture:files (_0 hit) ["bst"]) (_0 hit) "bst"))
  (define lore (driver:perc-lore (_1 built)))
  assert(Gt (Sz lore) 0)
  assert(includes (lambda (l) (foil-render:str-contains? "Number of nodes"
    (foil-lore:lore-head l))) lore)
  1)
assert(Equal 1 (check 0))
