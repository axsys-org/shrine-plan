;;;; The foil compile cache: top-level hits, no duplicates, lore on
;;;; the entry.  (Moved from forge-tests when the forge retired; the
;;;; forge-state cache wrappers died with it.)

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-render (#module foil-render))
(#bind foil-lore (#module foil-lore))
(#bind foil (#module foil))

(define cr1 (foil:compile-mod-cached 0 foil:default-subject "mapuser"))
(define cache1 (_0 cr1))
;; re-requesting a cached module is a hit: same subject back, no growth
(define cr2 (foil:compile-mod-cached cache1 foil:default-subject "mapuser"))
assert(Eq (Sz cache1) (Sz (_0 cr2)))
assert(Eq (_1 cr1) (_1 cr2))
;; one entry per module
(define cnames (map (Ix 0) cache1))
assert(Nil
  (includes (lambda (n) (Ne 1 (Sz (filter (Equal n) cnames)))) cnames))
;; the info variant hits too, answering from the stored keys
(define ir (foil:compile-mod-info-cached cache1 foil:default-subject "mapuser"))
assert(Eq (Sz cache1) (Sz (_0 ir)))
assert(Eq (_1 cr1) (_0 (_1 ir)))
;; the entry carries lore as its 5th field, captured at compile time
(define cr3 (foil:compile-mod-cached cache1 foil:default-subject "bst"))
(define bst-ent (_0 (find (lambda (e) (Eq "bst" (Ix 0 e))) (_0 cr3))))
assert(Eq 5 (Sz bst-ent))
assert(Gt (Sz (Ix 4 bst-ent)) 0)
assert(Ifz
  (includes
    (lambda (l) (foil-render:str-contains? "Number of nodes" (foil-lore:lore-head l)))
    (Ix 4 bst-ent))
  0 1)

(print "foil-cache tests passed")
