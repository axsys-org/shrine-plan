(#bind reef (#module reef))
(#import reef)
(#bind u128 (#module u128))
(#import u128)

(define fs-s  1000000000000000)
(define fs-ms 1000000000000)
;; https://www.nasa.gov/wp-content/uploads/static/history/ap11ann/ap11events.html
(define unix-epoch 14182937000000000000000)
; (define unix-epoch 14552880000000000000000)


(define mit 60) ;; minutes
(define hor (Mul 60 mit))  ;; hor
(define day (Mul 24 hor)) ;;
(define cet (Add 24 (Mul 100 365))) ;; centuries
(define era (Add 1 (Mul 4 cet))) ;;  (add 1 (mul 4 cet))
(define jes (Mul 730692561))
(define moh [31 28 31 30 31 30 31 31 30 31 30 31])
(define moy [31 29 31 30 31 30 31 31 30 31 30 31])
(define yer (Mul 365 day)) ;;  (mul 365 day)
(define qad (Add 1 (Mul 4 yer))) ;;  (add 1 (mul 4 yer))

(define (s-to-fs s) (Mul fs-s s))
(define (s-to-ms ms) (Mul fs-ms ms))
(define (fs-to-s fs) (Div fs fs-s))
(define (fs-to-ms fs) (Div fs fs-ms))

(define (ltime y m d))

(define (tarp d h m s)
  ("tarp" d h m s))
(define tarp-d (Ix 0)) (define set-tarp-d (Up 0))
(define tarp-h (Ix 1)) (define set-tarp-h (Up 1))
(define tarp-m (Ix 2)) (define set-tarp-m (Up 2))
(define tarp-s (Ix 3)) (define set-tarp-s (Up 3))
(define (print-tarp tarp)
  (foldr strWeld ""
    [
      (If (i128-is-negative? (tarp-d tarp)) "-" "")
      (showNat (tarp-d tarp))
      "::"
      (showNat (tarp-h tarp))
      ":"
      (showNat (tarp-m tarp))
      ":"
      (showNat (tarp-s tarp))
    ]))


(define (make-calendar y m d h min s f)
  ("CAL" y m d h min s f))
(define cal-y (Ix 0)) (define set-cal-y (Up 0))
(define cal-m (Ix 1)) (define set-cal-m (Up 1))
(define cal-d (Ix 2)) (define set-cal-d (Up 2))
(define cal-h (Ix 3)) (define set-cal-h (Up 3))
(define cal-mi (Ix 4)) (define set-cal-mi (Up 4))
(define cal-s (Ix 5)) (define set-cal-s (Up 5))
(define cal-f (Ix 6)) (define set-cal-f (Up 6))
(define (epoch-to-tarp off)
  (define con (If (i128-is-negative? off) i128-negative i128-positive))
  ;(define offset (i128-mag off))
  (define dd[d off1] (i128-divmod-floor off day))
  (define hh[h off2] (i128-divmod-floor off1 hor))
  (define mm[m s] (i128-divmod-floor off2 mit))
  (tarp d h m s))
; 1969-07-20T20:17
(define (days-from-civil y m d)
  (define y1 (i128-sub y (lte m 2)))
  (define era (i128-div (If (i128-is-positive? y1) y1 (i128-sub y1 399)) 400))
  (define yoe (i128-sub y1 (i128-mul era 400)))
  (define offset (If (Gt m 2) (Sub m 3) (Add m 9)))
  (define doy
    (i128-add (Dec d)
      (i128-div (i128-add (i128-mul 153 offset) 2)
      5)))
  (define doe
    (foldr i128-add 0
      [(i128-mul yoe 365)
        (i128-div yoe 4)
        (i128-negate (i128-div yoe 100))
        doy ]))
  (i128-sub (i128-add doe (i128-mul era 146097))
    719468))

(define (is-leap-year y)
  (or
    (Eq 0 (Mod y 400))
    (and
      (Eq 0 (Mod y 4))
      (Ne 0 (Mod y 100)))))


(define (cal-to-unix cc[y m d h mi s f])
  (define days (days-from-civil y m d))
  (define days-s (i128-mul day days))
  (define h-s (Mul hor h))
  (define mi-s (Mul mit mi))
  (foldr i128-add 0 [days-s h-s mi-s s]))


    ;    y -= m <= 2;
    ; const Int era = (y >= 0 ? y : y-399) / 400;
    ; const unsigned yoe = static_cast<unsigned>(y - era * 400);      // [0, 399]
    ; const unsigned doy = (153*(m > 2 ? m-3 : m+9) + 2)/5 + d-1;  // [0, 365]
    ; const unsigned doe = yoe * 365 + yoe/4 - yoe/100 + doy;         // [0, 146096]
    ; return era * 146097 + static_cast<Int>(doe) - 719468;
(define (cal-from-days days)
  (define z (i128-add days 719468))
  (define era
    (i128-div
      (If (i128-is-positive? z) z (i128-sub z 146096))
      146097))
  (define doe (i128-sub z (i128-mul era 146097)))
  (define yoe
    (i128-div
      (foldr i128-add 0
        [doe
        (i128-negate (i128-div doe 1460))
        (i128-div doe 36524)
        (i128-negate (i128-div doe 146096))])
      365))
  (define y (i128-add yoe (i128-mul era 400)))
  (define doy
    (i128-sub doe
      (foldr i128-add 0
        [(i128-mul yoe 365)
         (i128-div yoe 4)
         (i128-negate (i128-div yoe 100))])))
  (define mp
    (i128-div (i128-add (i128-mul 5 doy) 2) 153))
    (define d
      (Inc (i128-sub
             doy
             (i128-div (i128-add 2 (i128-mul 153 mp)) 5))))
  (define m (If (Lt mp 10) (Add mp 3) (Sub mp 9)))

  (make-calendar (Add y (lte m 2)) m d 0 0 0 0))

(define (cal-from-tarp tarp)
  (define cal (cal-from-days (tarp-d tarp)))
  (pipe cal
    (set-cal-h (tarp-h tarp))
    (set-cal-mi (tarp-m tarp))
    (set-cal-s (tarp-s tarp))))

(define (cal-from-unix stamp)
  (cal-from-tarp (epoch-to-tarp stamp)))


(define (unix-to-apollo s)
  (define fs (i128-mul fs-s s))
  (i128-add fs unix-epoch))

(define (apollo-to-unix a)
  (i128-div (i128-sub a unix-epoch) fs-s))

;; TODO: stop indirecting thru unix
(define (apollo-to-cal a)
  (cal-from-unix (apollo-to-unix a)))

(define (print-cal c[y m d h mi s f])
  (define base
    (foldr strWeld ""
    ["~"
     (i128-print y)
     "."
     (showNat m)
     "."
     (showNat d)
     ".."
     (showNat h)
     "."
     (showNat mi)
     "."
     (showNat s)
   ]))
   (Ifz f base (strWeld base (strWeld ".." (showNat f)))))

(define (print-time a)
  (print-cal (apollo-to-cal a)))

(define (print-unix u)
  (print-cal (cal-from-unix u)))



