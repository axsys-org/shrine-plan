(#bind ca (#module cairn))

(define TY_ROOT "/foil/ty")

(declare-cstr Layer TY_ROOT
  [binds tany] ;; ax[bind]
  [prev tany] ;; Unit[Layer]
)

(define (mod-decl? row) (Eq "s_decl" (_0 row)))
(define (mod-import? row) (Eq "s_import" (_0 row)))

(define (canonical-path-set paths)
  (map (Ix 0)
    (rowify (cairn:tapax
      (foldl (lambda (ax path) (cairn:putax path 1 ax))
        cairn:empty-ax paths)))))
(define (source-entry-val path sut)
  (foil-lower:ir-entry-val
    (foil-subject:got-entry (foil-subject:canon-path path sut) sut)))

(define empty-env ($Layer ca:empty-ax 0))


(declare-cstr Perc TY_ROOT
  [rex tany] ;; parsed rex tree
  [sast tany] ;; parsed sast tree
  [layer tany] ;; compiled layer
)

(define (get-perc name perc)
  (source-entry-val name (Perc.layer perc)))
(define empty-foil-cache bst:E) ;;

;; Nat -> Perc -> FoilCache
(define (put-foil-cache nam perc cache)
  (bst:bst-insert nam perc cache))
(define (get-foil-cache nam cache)
  (bst:bst-search nam cache))

;; Path -> Layer -> Unit[Bind]
(define (lookup-bind path lay)
  (define bind (ca:getax path (Layer.binds lay)))
  (define prev (Layer.prev lay))
  (cond
    ((And (Nil bind) prev) (lookup-bind path (_0 prev)))
    ((Nil bind) 0)
    (else bind)))

(define (elab-mod compile sut decls)
  (print "a")
  (define mod
    (foil-new-elab:compiler-subject
      (foil-new-elab:elab-mod
        (foil-new-elab:compiler-for sut) decls)))
  (print "b")
  (define final (foil-lower:materialize-consts mod))
  (print "c")
  (define declared
    (map (lambda (d) (foil-subject:root-path final (Ix 1 d)))
      (filter mod-decl? decls)))
  (print "d")
  (define delta
    (foil-subject:subject-entry-delta sut final))
  (define own-keys
      (canonical-path-set (Weld declared (map (Ix 0) delta))))
  (print ("own-keys" own-keys))
  (define lowered (foil-lower:lower-tc-unit sut final own-keys))
  (print "e")
  (force lowered))

;; -> [cache prev-pins direct-layers]: the row of import-subject PINS
;; (later-import-first, substrate last), plus the DIRECT imports as
;; [layer at] pairs (at = the import's mount prefix, [] when bare), kept
;; so the caller can spell their names into the head — visibility is
;; head state (a name resolves because THIS compile marked it, never
;; because a tail layer marked its own).
(define (construct-subject compile cache base imps[imp rest])
  (define (go cache1 pins layers imps1[imp rest])
    (Ifz imps1
      ;; substrate pinned last (oldest) so a zero-import compile still
      ;; reaches it; imports collected newest-first
      [cache1 (snoc (Pin base) pins) layers]
      (letrec
        ((name (foil-surface:surf-import-modname imp))
         (at0 (foil-surface:surf-import-at imp))
         (at (Ifz at0 [] at0))
         (compiled (compile cache1 name))
         (cache2 (put-foil-cache name (_1 compiled) (_0 compiled)))
         (lay (Perc.layer (_1 compiled))))
        ;; each import compiles in program order (see the DeepSeq in
        ;; `compile`: the head must be forced before elaboration)
        (Seq lay
          (go cache2 (Weld [(Pin lay)] pins) (snoc [lay at] layers) rest)))))
  (go cache [] [] imps))

(define (mark-own-visible decls sut)
  (foldl
    (lambda (s d)
      (let ((path (foil-subject:root-path s (Ix 1 d))))
        (foil-subject:mark-visible path path s)))
    sut (filter mod-decl? decls)))

;; PER-MODULE ROOTS (Liam, 2026-09-03): every module compiles beneath
;; /boot/<mod>, so a declaration's canonical key — its storage key, its
;; nominal identity, the brand on its values — is module-qualified and
;; two modules can never collide.  The import line only decides the
;; SPELLING: a layer's key is marked under the importer's root (plus the
;; import's at= prefix for a direct mount) with the layer's own root
;; stripped.  The substrate's keys are bare (["either" "err"]) and its
;; root is /boot, so builtins spell as bare names in every module.
;; Materialized /ty-ap keys have no spelling (canon-path treats them
;; as canonical already) and are skipped.
(define (mark-layer-under spell lay s)
  (define lroot (foil-subject:sut-root lay))
  (define n (Sz lroot))
  (foldl
    (lambda (s2 k)
      (cond
        ((foil-subject:ty-ap-path? k) s2)
        ((And (Ge (Sz k) n) (Equal lroot (take n k)))
          (foil-subject:mark-visible (Weld spell (drop n k)) k s2))
        (else (foil-subject:mark-visible (Weld spell k) k s2))))
    s (foil-subject:subject-order lay)))

;; TRANSITIVE visibility (Liam, 2026-09-03): every declaration anywhere
;; in the import closure is importable here — no export filtering and
;; no direct-only rule.  Far layers are marked before near ones and
;; siblings in source order, so on a name collision the nearest (and
;; then the later) layer wins; own decls are marked after this and win
;; over everything.  Transitive layers (and the substrate, which ends
;; every chain) spell under the bare root; a direct import spells under
;; root ++ at.  A layer already marked under a spelling is not marked
;; again (diamonds), so precedence follows the first, nearest reach.
(define (mark-imports-visible root layers sut)
  (define (mark-chain st lay spell)
    (define key (Weld spell (foil-subject:sut-root lay)))
    (If (ca:getax key (_1 st))
      st
      (let* ((prevs (foil-subject:sut-prevs lay))
             (st1 (foldl (lambda (acc p) (mark-chain acc (Unpin p) root)) st (rev prevs)))
             (s2 (mark-layer-under spell lay (_0 st1))))
        [s2 (ca:putax key 1 (_1 st1))])))
  (_0 (foldl
        (lambda (st pair) (mark-chain st (_0 pair) (Weld root (_1 pair))))
        [sut ca:empty-ax] layers)))

;; make-head : Cord -> Subject -> [Pin] -> [[Subject Path]] -> [Decl] -> Subject
;; The fresh head of a compile: rooted at /boot/<mod> over the shared
;; import pins, with the whole closure's names (substrate included) and
;; the module's own decls marked into it.
(define (make-head mod base prev-pins layers decls)
  (define root (Weld (foil-subject:sut-root base) [mod]))
  (define head
    (foil-subject:set-sut-root root
      (foil-subject:head-onto-pins prev-pins base)))
  ;; the substrate goes FIRST (lowest precedence: imports and own decls
  ;; shadow builtins) and explicitly — a module with no imports has no
  ;; chain through which the substrate would otherwise be reached
  (mark-own-visible decls
    (mark-imports-visible root (Weld [[base []]] layers) head)))

;; cache -> module name -> [cache' perc]
(define (compile-inner compile cache mod)
  (define rex (rex:ParseRexNormFile (foil:get-foil mod)))
  (define base foil-builtins:default-subject)
  (define sast (foil-sast:parse-module-sast 0 rex))
  (define imps (stream (filter mod-import? sast)))
  (print ("imps" imps))
  (define decls (filter (lambda (r) (Nil (mod-import? r))) sast))
  (define res[cach prev-pins layers] (construct-subject compile cache base imps))
  ;; fresh head rooted at /boot/<mod> over the shared import pins; all
  ;; naming authority (substrate, the whole import closure, own decls)
  ;; is marked into it — the pinned tail layers carry entries only
  (define sut (make-head mod base prev-pins layers decls))
  ;; Force the head — and through its visibility marks every import's
  ;; compile — HERE, at driver level.  Left lazy, a failing import first
  ;; fails inside the importer's per-declaration Try in foil-new-elab
  ;; (run-decl-pass records it as that declaration's diagnostic), and the
  ;; next declaration re-forces the same blackholed thunk: wisp reports
  ;; that as a fatal <<loop>> instead of the import's error.  (The prev
  ;; pins stop DeepSeq; the unpinned direct layers in the marks do not.)
  (DeepSeq sut 0)
  (define mod (elab-mod compile sut decls))
  [cach ($Perc rex sast mod)])

(define (compile cache mod)
  (define hit (get-foil-cache mod cache))
  (Ifz hit (compile-inner compile cache mod)
    [cache (_0 hit)]))

(define (time f x)
  (define start (Now 0))
  (define res (f x))
  (define done (Now 0))
  (define timing (print ("took" (Sub done start))))
  (Seq
    start
    (Seq res
        (Seq timing res))))

    ; res
    ; done
    ; timing
    ; res))

(define evo-perc (_1 (time (compile empty-foil-cache) "evo")))

; (print ("test" (Perc.layer evo-perc)))
(define perc-add (get-perc ["add_two"] evo-perc))
(define mk-point (get-perc ["make_point"] evo-perc))
(mk-point 3)
(perc-add 3)

(define (timed-compile mod)
  (time (compile empty-foil-cache) mod))
