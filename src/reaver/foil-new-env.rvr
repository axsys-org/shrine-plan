
(#bind std (#module std))
(#import std)

(#bind bst (#module bst))

(#bind reef (#module reef))
(#import reef)

(#bind newtype (#module newtype))
(#import newtype)

(#bind rex (#module rex))

(#bind foil (#module foil))
(#bind foil-sast (#module foil-sast))
(#bind foil-sast (#module foil-sast))
(#bind foil-builtins (#module foil-builtins))
(#bind foil-new-elab (#module foil-new-elab))
(#bind foil-lower (#module foil-lower))
(#bind foil-lore (#module foil-lore))
(#bind foil-subject (#module foil-subject))
(#bind foil-surface (#module foil-surface))

(#bind ca (#module cairn))

(define TY_ROOT "/foil/ty")

(declare-cstr Layer TY_ROOT
  [binds tany] ;; ax[bind]
  [prev tany] ;; Unit[Layer]
)

(define (mod-decl? row) (Eq "s_decl" (_0 row)))
(define (mod-import? row) (Eq "s_import" (_0 row)))

(define (canonical-path-set paths)
  (map (Ix 0)
    (rowify (cairn:tapax
      (foldl (lambda (ax path) (cairn:putax path 1 ax))
        cairn:empty-ax paths)))))
(define (source-entry-val path sut)
  (foil-lower:ir-entry-val
    (foil-subject:got-entry (foil-subject:canon-path path sut) sut)))

(define empty-env ($Layer ca:empty-ax 0))


(declare-cstr Perc TY_ROOT
  [rex tany] ;; parsed rex tree
  [sast tany] ;; parsed sast tree
  [layer tany] ;; compiled layer
)

(define (get-perc name perc)
  (source-entry-val name (Perc.layer perc)))
(define empty-foil-cache bst:E) ;;

;; Nat -> Perc -> FoilCache
(define (put-foil-cache nam perc cache)
  (bst:bst-insert nam perc cache))

;; Path -> Layer -> Unit[Bind]
(define (lookup-bind path lay)
  (define bind (ca:getax path (Layer.binds lay)))
  (define prev (Layer.prev lay))
  (cond
    ((And (Nil bind) prev) (lookup-bind path (_0 prev)))
    ((Nil bind) 0)
    (else bind)))

(define (elab-mod compile sut decls)
  (print "a")
  (define mod
    (foil-new-elab:compiler-subject
      (foil-new-elab:elab-mod
        (foil-new-elab:compiler-for sut) decls)))
  (print "b")
  (define final (foil-lower:materialize-consts mod))
  (print "c")
  (define declared
    (map (lambda (d) (foil-subject:root-path final (Ix 1 d)))
      (filter mod-decl? decls)))
  (print "d")
  (define delta
    (foil-subject:subject-entry-delta sut final))
  (define own-keys
      (canonical-path-set (Weld declared (map (Ix 0) delta))))
  (print ("own-keys" own-keys))
  (define lowered (foil-lower:lower-tc-unit sut final own-keys))
  (print "e")
  (force lowered))

(define (construct-subject compile cache base imps[imp rest])
  (define recur (construct-subject compile))
  (Ifz imps
       base
       (letrec
         ((name (foil-surface:surf-import-modname imp))
          (next (compile cache name)))
          (recur (_0 next) (Perc.layer (_1 next)) rest))))


(define (compile cache mod)
  (define rex (rex:ParseRexNormFile (foil:get-foil mod)))
  (define base foil-builtins:default-subject)
  (define sast (foil-sast:parse-module-sast 0 rex))
  (define imps (stream (filter mod-import? sast)))
  (print ("imps" imps))
  (define decls (filter (lambda (r) (Nil (mod-import? r))) sast))
  (define sut (construct-subject compile cache base imps))
  (define mod (elab-mod compile sut decls))
  [cache ($Perc rex sast mod)])

(define (time f x)
  (define start (Now 0))
  (define res (f x))
  (define done (Now 0))
  (define timing (print ("took" (Sub done start))))
  (seqN
    start
    res
    done
    timing
    res))

(define evo-perc (_1 (time (compile empty-foil-cache) "evo")))

; (print ("test" (Perc.layer evo-perc)))
(define perc-add (get-perc ["boot" "add_two"] evo-perc))
(define mk-point (get-perc ["boot" "make_point"] evo-perc))
(mk-point 3)
(perc-add 3)
