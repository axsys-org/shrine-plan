;; Reflected native declarations must be traversable without type allowlists.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind pub (#module foil-publication))
(#bind driver (#module foil-new-env))
(define plan (pub:prepare-system (Pin "compiler")
  (lambda (name) (rex:ParseRexNormFile "+ node
  : next=maybe[node]
"))
  [["system-types" [["ts" "sys"] ["ts" "types"]]]]))
(define code (pub:compile plan driver:empty-foil-cache))
(define records (pub:definition-records code))
(define (mold name)
  (_2 (need (find (lambda (record)
    (Equal (_0 record) [("ts" "sys") ("ts" "types") ("ts" name)])) records))))
assert(Equal ("gen" [] ("nat" 0)) (mold "nat"))
assert(Equal ("gen" [] ("nat" "tu")) (mold "str"))
assert(Equal ("gen" [[0 "a" "bot"]] ("arr" ("var" "a"))) (mold "row"))
assert(Equal "gen" (Hd (mold "maybe")))
assert(Equal "sum" (Hd (_1 (mold "maybe"))))
