(#bind std (#module std))
(#import std)


;;; Message tags ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ASYNC-FUTURE "future")
(define ASYNC-AWAIT  "await")
(define ASYNC-STOP   "stop")
(define ASYNC-CONT   "cont")


;;; Actor basics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define self-handle 0)
(define self self-handle)

(define (recv)      (Recv self-handle))
(define (recv-msg)  (Ix0 (recv)))
(define (recv-caps) (Ix1 (recv)))

(define (spawn fn) (Spawn fn))

(define (cast actor msg)
  (Send actor msg))

(define (cast-caps actor msg caps)
  (SendCaps actor msg caps))

(define (reply caps msg)
  (Send (Ix0 caps) msg))

(define (reply-caps caps msg out-caps)
  (SendCaps (Ix0 caps) msg out-caps))

(define (ask actor msg)
  (SendCaps actor msg [self-handle]))

(define (call actor msg)
  (SendCaps actor msg [self-handle])
  (Ix0 (Recv self-handle)))

(define (receive-one handler)
  ((lambda (msg-caps)
     (handler (Ix0 msg-caps) (Ix1 msg-caps)))
   (recv)))

(define (cont state) [ASYNC-CONT state])
(define (stop reason) [ASYNC-STOP reason])

(define (actor-loop state step self)
  ((lambda (msg-caps)
     (define next (step state (Ix0 msg-caps) (Ix1 msg-caps)))
     (If (Equal ASYNC-STOP (Ix0 next))
       (Ix1 next)
       (actor-loop (Ix1 next) step self)))
   (recv)))

(define (spawn-loop state step)
  (Spawn (actor-loop state step)))

(define (close actor)
  (CloseHandle actor))


;;; Futures ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (future handle) [ASYNC-FUTURE handle])
(define future-handle Ix1)

(define (future? x)
  (And (Nil (IsNat x))
       (Equal ASYNC-FUTURE (Ix0 x))))

(define (try-ok? result)
  (Nil (Hd result)))

(define try-value Ix0)
(define try-error Ix0)

(define (future-ready result self)
  (define msg-caps (Recv self-handle))
  (define msg (Ix0 msg-caps))
  (cond
    ((Equal ASYNC-AWAIT msg)
      (Send (Ix0 (Ix1 msg-caps)) result)
      (future-ready result self))
    ((Equal ASYNC-STOP msg)
      result)
    (else
      (future-ready result self))))

;; Force the result BEFORE parking in future-ready's Recv: `define` is
;; a lazy slot, and an unforced Try rides along until the awaiter's
;; message arrives — at which point the reply's deep-normalization does
;; all the work, serially, at await time. The Seq is what makes the
;; child actually compute concurrently.
(define (future-run f arg self)
  (define result (Try f arg))
  (Seq result
    (future-ready result self)))

;; The Spawn must fire *now*, not when the handle is first demanded:
;; the future row is lazy in its elements, so without the Seq the spawn
;; of each future would ride along unforced until its await — and a
;; row of "parallel" futures would run strictly one after another.
(define (async f arg)
  (let1 h (Spawn (future-run f arg))
    (Seq h (future h))))

(define (async0 thunk)
  (async thunk 0))

(define (await-try fut)
  (SendCaps (future-handle fut) ASYNC-AWAIT [self-handle])
  (Ix0 (Recv self-handle)))

(define (await fut)
  (define result (await-try fut))
  (If (try-ok? result)
    (try-value result)
    (Throw (try-error result))))

(define (cancel fut)
  (cast (future-handle fut) ASYNC-STOP))

(define (await-try-all futures)
  (map await-try futures))

(define (await-all futures)
  (map await futures))

;;; Deep-forcing variants ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; A future's work must happen in the child: without a deep force the
;;; child parks a structure in WHNF and the *awaiting* actor pays for
;;; the rest of the evaluation. These variants normalize the result
;;; inside the future before it is sent back.

(define (call-deep f x)
  (let1 r (f x)
    (DeepSeq r r)))

(define (async-deep f arg)
  (async (call-deep f) arg))

(define (async-map-list f xs i rem)
  (Ifz rem NIL
    (let1 fut (async f (Ix i xs))
      (Seq fut
        [fut (async-map-list f xs (Inc i) (Dec rem))]))))

;; DeepSeq the row: Row answers Sz from its length argument without
;; traversing the spine, so nothing else forces the elements — and an
;; unforced element is an unfired Spawn. Forcing here is what makes the
;; map actually parallel instead of one-spawn-per-await.
(define (async-map f xs)
  (define futs (Row 0 (Sz xs) (async-map-list f xs 0 (Sz xs))))
  (DeepSeq futs futs))

(define (async-all f xs)
  (await-all (async-map f xs)))

(define (async-map-deep f xs)
  (async-map (call-deep f) xs))

(define (async-all-deep f xs)
  (await-all (async-map-deep f xs)))


;;; Fan-out helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (broadcast-loop actors msg i rem)
  (Ifz rem 0
    (Seq (Send (Ix i actors) msg)
      (broadcast-loop actors msg (Inc i) (Dec rem)))))

(define (broadcast actors msg)
  (broadcast-loop actors msg 0 (Sz actors)))

(define (ask-all-loop actors msg i rem)
  (Ifz rem 0
    (Seq (SendCaps (Ix i actors) msg [self-handle])
      (ask-all-loop actors msg (Inc i) (Dec rem)))))

(define (ask-all actors msg)
  (ask-all-loop actors msg 0 (Sz actors)))

(define (recv-n n)
  (Ifz n []
    (cons (Ix0 (Recv self-handle))
      (recv-n (Dec n)))))

(define (call-all actors msg)
  (ask-all actors msg)
  (recv-n (Sz actors)))
