;;;; Typed mirror construction and app policy through the host boundary.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind host (#module compiler-host))
(#bind foil (#module foil))
(Seq (define cache (_0 (foil:compile-mod-cached 0 foil:default-subject "test_fixtures/mirror")))
  (DeepSeq cache 0))
(Seq (define modules (host:describe-cache 0 1 cache)) (DeepSeq modules 0))
(Seq (define pairs ((host:tool ["boot_mirror" "pairs"]) modules)) (DeepSeq pairs 0))
assert(Gt (Sz pairs) 0)
assert(Equal [1 9000] (host:grants-for "all" "demo" 1 9000))
assert(Equal [0 0] (host:grants-for [] "demo" 1 9000))
assert(Equal [1 0] (host:grants-for [["demo" 1 0]] "demo" 1 9000))
assert(Equal [("ts" "app") ("ts" "demo")] (host:mount-root [] "demo"))
assert(Equal [("ts" "custom")] (host:mount-root [["demo" [("ts" "custom")]]] "demo"))
(Seq (define seed (foil:source-entry-val ["sov" "new"] (_1 host:tools-compiled))) (DeepSeq seed 0))
(Seq (define tasks (host:boot-mirror-tasks-with cache 0)) (DeepSeq tasks 0))
(Seq (define state (host:seed-tasks 0 seed tasks)) (DeepSeq state 0))
(Seq (define hydrated (host:hydrate-cache 0 state (map (lambda (m) (_0 m)) cache))) (DeepSeq hydrated 0))
assert(Gt (Sz hydrated) 0)
(Seq (define demo (need (find (lambda (m) (Eq "test_fixtures/mirror" (_0 m))) cache))) (DeepSeq demo 0))
(Seq (define restored (host:hydrate-mod 0 state "test_fixtures/mirror")) (DeepSeq restored 0))
assert(Eq (foil:entry-pin demo) (foil:entry-pin restored))
assert(Equal [0 0] (host:grants-for [["demo" 0 0] ["demo" 1 1]] "demo" 1 9000))
assert(Equal [("ts" "first")]
  (host:mount-root [["demo" [("ts" "first")]] ["demo" [("ts" "second")]]] "demo"))
(Seq (define failed-app (host:compile-app 0 cache "missing_app_for_test")) (DeepSeq failed-app 0))
assert(Equal cache (_0 failed-app))
assert(Equal "ERR" (_0 (_1 failed-app)))
;; Mirror metadata and doctest publication use only sept + one tiny unit.
(#bind lore (#module foil-lore))
(#bind doctest (#module doctest))
(#bind rex (#module rex))
(Seq (define sut (_1 host:tools-compiled)) (DeepSeq sut 0))
(define (entry p) (foil:source-entry-val p sut))
(Seq (define query (entry ["x_query_h"])) (DeepSeq query 0))
(Seq (define txt (entry ["myth" "txt_at"])) (DeepSeq txt 0))
(Seq (define has (entry ["myth" "has_at"])) (DeepSeq has 0))
(Seq (define pail (entry ["myth" "pail_at"])) (DeepSeq pail 0))
(Seq (define root [("ts" "boot") ("ts" "test_fixtures") ("ts" "mirror")]) (DeepSeq root 0))
(Seq (define fun (host:boot-ent-node "test_fixtures/mirror" ["twice"])) (DeepSeq fun 0))
(Seq (define typ (host:boot-ent-node "test_fixtures/mirror" ["mirror_record"])) (DeepSeq typ 0))
(Seq (define bare (host:boot-ent-node "test_fixtures/mirror" ["undocumented"])) (DeepSeq bare 0))
(define (get s p) (_0 (query (Ix 2 s) p s)))
assert(Equal (foil:get-foil "test_fixtures/mirror")
  (txt [("ts" "sys") ("ts" "src")] (get state root)))
assert(Equal "function" (txt [("ts" "kind")] (get state fun)))
assert(Equal "row type" (txt [("ts" "kind")] (get state typ)))
assert(Eq (foil:source-entry-val ["twice"] (_1 demo))
  ((entry ["myth" "code_at"]) [("ts" "code")] (get state fun)))
assert(Eq 1 (has [("ts" "sys") ("ts" "help")] (get state typ)))
assert(Eq 0 (has [("ts" "sys") ("ts" "help")] (get state bare)))
assert(Eq 0 (Eq "/boot/res/known"
  (Hd (query (Ix 2 state)
    (host:boot-ent-node "sept" ["mirror_record"]) state))))
(Seq (define unlowered (host:boot-ent-node "sept" ["mop" "put"])) (DeepSeq unlowered 0))
assert(Equal "function" (txt [("ts" "kind")] (get state unlowered)))
assert(Eq 0 (has [("ts" "code")] (get state unlowered)))
(define (lore-on enabled)
  (define pairs ((host:tool ["boot_mirror" "pairs"])
    (host:describe-cache 0 enabled [demo])))
  (define card (_1 (need (find (lambda (x) (Equal typ (_0 x))) pairs))))
  (has [("ts" "sys") ("ts" "help")] card))
assert(Equal [0 1] [(lore-on 0) (lore-on 1)])
(Seq (define ver (entry ["x_case_h"])) (DeepSeq ver 0))
(Seq (define anchor (ver 0 fun state)) (DeepSeq anchor 0))
(Seq (define tested (host:seed-doctests [demo] 0 state)) (DeepSeq tested 0))
assert(Equal anchor (ver 0 fun tested))
assert(Equal [[0 1 0]] (_2 (pail [("ts" "dt")]
  (get tested (snoc ("ts" "dt") fun)))))
assert(Eq 0 (Eq "/boot/res/known" (Hd (query (Ix 2 tested)
  (snoc ("ts" "dt") bare) tested))))
(Seq (define bad ["LORE" [] "" []
  [["DT" 0 (rex:ParseRexNorm "(twice 1)") (rex:ParseRexNorm "3")]] 0]) (DeepSeq bad 0))
assert(Equal [[0 0 "2"]] (doctest:run-lore (_1 demo) bad))
assert(Equal ["apps/chat/main"]
  (host:mirror-roster ["apps/chat/main" "apps/chat/tests"
    "tests/json" "test_fixtures/mirror" "app_test_world"]))
(print "boot tools tests passed")
