(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))
(#bind render (#module foil-render))
(#bind nt (#module foil-new-types))
(#bind elab (#module foil-new-elab))


;;; tyshow.foil: the type pretty-printer, in Foil.  For every stage-1
;;; type shape, the Foil renderer applied to the reflected descriptor
;;; must agree byte-for-byte with the compiler's own renderer.

(define tyshow-sut (stage:sut-of "tyshow"))
(define ty-show (foil:source-entry-val ["tyshow" "show"] tyshow-sut))

(define (enc t) (elab:reflect-encode 0 t))
(define (agree? t)
  (Equal (render:ty-text t) (ty-show (enc t))))

;; leaves and builtins
assert(agree? (nt:tnat 0))
assert(agree? (nt:tnat "t"))
assert(agree? (nt:tnat "x"))
assert(agree? nt:tany)
assert(agree? nt:tpail)
assert(agree? nt:tbot)
;; constants: printable symbol, digits, opaque non-nat
assert(agree? (nt:tconst "hello"))
assert(agree? (nt:tconst 3000000000))
assert(Equal "'..." (ty-show (enc (nt:tconst [1 2]))))
;; structure
assert(agree? (nt:tarr nt:tany))
assert(agree? (nt:tpin (nt:type-ref ["nat"])))
assert(agree? (nt:tfun [(nt:tnat 0) (nt:type-ref ["nat"])] (nt:tnat 0)))
assert(agree? (nt:tsum
  [(nt:trow "a" []) (nt:trow "b" [(nt:trow-item 0 (nt:tnat 0))])]))
assert(agree? (nt:trow "/boot/pointy"
  [(nt:trow-item "x" (nt:tnat 0)) (nt:trow-item 1 (nt:tnat 0))]))
assert(agree? (nt:trow 0 [(nt:trow-item 0 (nt:tnat 0))]))
;; references, applications, variables
assert(agree? (nt:type-ref ["boot" "shape"]))
assert(agree? (nt:type-ref (ty-ap-encode [["bst"] ["nat"]])))
assert(agree? (nt:type-app ["bst"]
  [(nt:type-arg (nt:type-ref ["nat"])) (nt:const-arg "lt")]))
assert(agree? (nt:type-var "v"))
assert(agree? (nt:const-var "k"))
;; schemes: type and const parameters
assert(agree? (nt:scheme
  [(nt:type-param "a") (nt:const-param "k" (nt:tnat 0))]
  (nt:tarr (nt:type-var "a"))))

;; end-to-end: the printer renders its OWN elaborated type — the
;; reflected scheme of tyshow/show — in agreement with the compiler
(define show-typ
  (tc-ty (got-entry-tc (canon-path ["tyshow" "show"] tyshow-sut) tyshow-sut)))
assert(agree? show-typ)

(print "foil-tyshow tests passed")
