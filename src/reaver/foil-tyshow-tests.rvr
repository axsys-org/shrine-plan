(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind foil (#module foil-new-env))
(#bind render (#module foil-render))
(#bind nt (#module foil-new-types))
(#bind elab (#module foil-new-elab))

(define (check z)
  ;;;; Copyright (c) 2026 Axiomatic Systems
  ;;;; SPDX-License-Identifier: MIT
  ;;;; See LICENSE for full terms.






  ;;; tyshow.foil: the type pretty-printer, in Foil.  For every stage-1
  ;;; type shape, the Foil renderer applied to the reflected descriptor
  ;;; must agree byte-for-byte with the compiler's own renderer.

  (define tyshow-sut (foil:perc-subject (_1 (source:compile 0 "tyshow"))))
  (define ty-show (foil:source-entry-val ["tyshow" "show"] tyshow-sut))

  (define (enc t) (elab:reflect-encode 0 t))
  (define (agree? t)
    (Equal (render:ty-text t) (ty-show (enc t))))

  ;; leaves and builtins
  assert(agree? (nt:tnat 0))
  assert(agree? (nt:tnat "t"))
  assert(agree? (nt:tnat "x"))
  assert(agree? nt:tany)
  assert(agree? nt:tpail)
  assert(agree? nt:tbot)
  ;; constants: printable symbol, digits, opaque non-nat
  assert(agree? (nt:tconst "hello"))
  assert(agree? (nt:tconst 3000000000))
  assert(Equal "'..." (ty-show (enc (nt:tconst [1 2]))))
  ;; structure
  assert(agree? (nt:tarr nt:tany))
  assert(agree? (nt:tpin (nt:type-ref ["nat"])))
  assert(agree? (nt:tfun [(nt:tnat 0) (nt:type-ref ["nat"])] (nt:tnat 0)))
  assert(agree? (nt:tsum
    [(nt:trow "a" []) (nt:trow "b" [(nt:trow-item 0 (nt:tnat 0))])]))
  assert(agree? (nt:trow "/boot/pointy"
    [(nt:trow-item "x" (nt:tnat 0)) (nt:trow-item 1 (nt:tnat 0))]))
  assert(agree? (nt:trow 0 [(nt:trow-item 0 (nt:tnat 0))]))
  ;; references, applications, variables
  assert(agree? (nt:type-ref ["boot" "shape"]))
  assert(agree? (nt:type-ref (ty-ap-encode [["bst"] ["nat"]])))
  assert(agree? (nt:type-app ["bst"]
    [(nt:type-arg (nt:type-ref ["nat"])) (nt:const-arg "lt")]))
  assert(agree? (nt:type-var "v"))
  assert(agree? (nt:const-var "k"))
  ;; schemes: type and const parameters
  assert(agree? (nt:scheme
    [(nt:type-param "a") (nt:const-param "k" (nt:tnat 0))]
    (nt:tarr (nt:type-var "a"))))

  ;; end-to-end: the printer renders its OWN elaborated type — the
  ;; reflected scheme of tyshow/show — in agreement with the compiler
  (define show-typ
    (tc-ty (got-entry-tc (canon-path ["tyshow" "show"] tyshow-sut) tyshow-sut)))
  assert(agree? show-typ)

  (print "foil-tyshow tests passed")

  ;; Multiline layout and the exact 64-byte threshold.
  (define ty-pretty (foil:source-entry-val ["tyshow" "pretty"] tyshow-sut))
  (define long-name "a_long_type_name_used_to_force_multiline_layout_in_the_printer")
  (define long-ref (nt:type-ref [long-name]))
  (define long-text (strcat ["/" long-name]))
  (define lf 10)
  assert(agree? (nt:tfun [] long-ref))
  assert(agree? (nt:trow 0 []))
  assert(agree? (nt:tsum []))
  assert(agree? (nt:type-ref ["foil-unit" (Pin ["tyshow-test"]) "boot" "shape"]))
  ;; The compiler normalizes a nullary function to its return type.
  assert(Equal "/nat" (ty-pretty (enc (nt:tfun [] (nt:type-ref ["nat"])))))
  (define fun-long (nt:tfun [long-ref (nt:tnat 0)] (nt:tnat 0)))
  assert(Equal (strcat ["{\ " long-text lf "   nat}nat"]) (ty-pretty (enc fun-long)))
  (define sum-long (nt:tsum [long-ref nt:tany]))
  assert(Equal (strcat ["(  any" lf "|  " long-text ")"]) (ty-pretty (enc sum-long)))
  (define rec-long (nt:trow "record" [(nt:trow-item "named" long-ref) (nt:trow-item 1 nt:tany)]))
  assert(Equal (strcat ["record[  named=" long-text lf "   any]"]) (ty-pretty (enc rec-long)))
  (define gen-long (nt:scheme [(nt:type-param "a") (nt:const-param "k" (nt:tnat 0))] fun-long))
  assert(Equal (strcat ["@a @[k nat] " lf "{\ " long-text lf "   nat}nat"]) (ty-pretty (enc gen-long)))
  (define (threshold n)
    (nt:tsum [(nt:type-ref [(strcat (gen n (lambda (i) "a")))]) nt:tany]))
  ;; (any | /aaaa...) has nine punctuation/separator bytes plus the name.
  (define below (threshold 54))
  (define edge (threshold 55))
  assert(Equal (ty-show (enc below)) (ty-pretty (enc below)))
  assert(Eq 64 (Bytes (ty-show (enc edge))))
  assert(Equal (strcat ["(  any" lf "|  /" (strcat (gen 55 (lambda (i) "a"))) ")"]) (ty-pretty (enc edge)))
  (print "tyshow multiline tests passed")

  1)
assert(Equal 1 (check 0))
