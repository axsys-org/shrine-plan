;;;; Forced compilation zones around the sole driver, with its native cache.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind zone (#module profile-zone))
(define (compile cache name)
  (zone:force-zone (strcat ["foil.compile." name])
    (source:compile cache name)))
