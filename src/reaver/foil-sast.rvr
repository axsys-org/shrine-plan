(#bind bst (#module bst))
(#import bst)
(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))

(#bind foil-rex (#module foil-rex))
(#import foil-rex)

(#bind foil-surface (#module foil-surface))
(#import foil-surface)

;;; Parser helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (split-once f x)
  (define (go acc r[x xs])
    (Ifz r [(rowify (lflop acc)) 0]
    (If (f x)
      [(rowify (lflop acc)) (rowify r)]
      (go (lcons x acc) xs))))
  (go 0 (stream x)))

;; %/name — a current-namespace reference.  Rex delivers %/add as a
;; "%/"-runed nest holding one word, and %/a/b as a "/"-path nest whose
;; HEAD is that "%/" nest (the remaining segments are ordinary words).
(define (cref-nest? k)
  (And (rx-nest? k) (Eq "%/" (rx-nest-rune k))))

;; A specialization bracket.  Rex normalization absorbs the rune of a
;; bracket wrapping a single rune expression ([uon/kv[v]] arrives as a
;; "/"-runed brack), so a spec bracket is any brack-colored nest.
(define (spec-brack? b)
  (And (rx-nest? b) (Eq "brack" (rx-nest-color b))))

;; Bracket arguments of a specialization: a plain brack holds one kid
;; per argument; a runed brack is a single argument — the rune
;; expression, reconstituted as a clear nest.
(define (brack-args cont b)
  (If (Eq "" (rx-nest-rune b))
    (map cont (rx-nest-kids b))
    [(cont (rx-nest (rx-span b) "clear" (rx-nest-rune b) (rx-nest-kids b)))]))

;;; Located parse errors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Every rex node carries its source span as its first constructor field:
;; [line col off len].
;; Cite it, so parse errors land next to the offending source instead of
;; as bare tuples.
(define (rex-blurb v)
  (define sp (And (IsApp v) (rx-span v)))
  (If (And (IsApp sp)
        (And (Eq 4 (Sz sp))
          (And (IsNat (Ix 0 sp)) (IsNat (Ix 1 sp)))))
    ["line" (Ix 0 sp) "col" (Ix 1 sp)]
    "unknown-location"))

(define (sast-error-at loc what val)
  (error ["foil-sast-error" what ["at" (rex-blurb loc)] val]))

(define (sast-error what val)
  (sast-error-at val what val))

;;; Reference roads ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (cref-head-word k)
  (define kids (rx-nest-kids k))
  (unless (And (Eq 1 (Sz kids)) (rx-word? (_0 kids)))
    (sast-error "bad current-namespace reference (%/)" k)
    (rx-word-str! (_0 kids))))

;; Path elements admissible to parse-road: ordinary words, optionally
;; led by a %/ anchor nest.
(define (road-kids? els)
  (And (Gt (Sz els) 0)
    (And (Or (rx-word? (_0 els)) (cref-nest? (_0 els)))
      (all rx-word? (drop 1 els)))))

(define (parse-road els)
  (If (And (Sz els) (cref-nest? (_0 els)))
    (surf-cref
      (Weld [(cref-head-word (_0 els))]
        (map rx-word-str! (drop 1 els))))
    (surf-ref (map rx-word-str! els))))

;;; Type parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; '$foo — a constant symbol type literal.  The leaf text includes the
;; quote; the symbol is the text after the '$ prefix.
(define (sym-lit? lef)
  (And (rx-leaf? lef)
    (And (Eq "quip" (rx-leaf-shape lef))
      (Eq "'$" (lstrcat (ltake 2 (ltrip (rx-leaf-str lef))))))))
(define (sym-lit-nat lef)
  (lstrcat (ldrop 2 (ltrip (rx-leaf-str lef)))))

;; The autonamer: a 1-kid = nest (written =foo) names a face after its
;; word.  In a path (=foo/bar arrives as a /-nest whose head is that =
;; nest) the face takes the FIRST segment: foo=foo/bar.
(define (autoname-head? k)
  (And (rx-rune? "=" k)
    (let ((fk (hr-stem (rx-rune-kids k))))
      (And (Eq 1 (Sz fk)) (rx-word? (_0 fk))))))
(define (autoname-word k)
  (rx-word-str! (_0 (hr-stem (rx-rune-kids k)))))
(define (autoname-inner k)
  (_0 (hr-stem (rx-rune-kids k))))


;; Type paths, with specialization on the last segment: bst/node[v]
;; arrives as (/ bst (juxt node [v])) — juxtaposition binds tighter
;; than any rune — and becomes a type application of the whole road.
;; cont parses the bracket's argument types (parse-type-sast; passed in
;; because it is defined later).
(define (parse-type-path cont kids)
  (define last (Last kids))
  (define (spec-tail jkids)
    (And (Eq 2 (Sz jkids))
      (And (rx-word? (_0 jkids))
        (And (spec-brack? (_1 jkids))
          (road-kids? (Init kids))))))
  (cond
    ;; =foo/bar — the autonamer wraps the whole path in a face named
    ;; after the first segment.
    ((And (Gt (Sz kids) 0) (autoname-head? (_0 kids)))
      (surf-face (autoname-word (_0 kids))
        (parse-type-path cont
          (Weld [(autoname-inner (_0 kids))] (drop 1 kids)))))
    ((road-kids? kids) (parse-road kids))
    ((And (Gt (Sz kids) 1) (And (rx-juxt? last) (spec-tail (rx-juxt-kids last))))
      (let ((jkids (rx-juxt-kids last)))
        (surf-tapp
          (Weld [(parse-road (Weld (Init kids) [(_0 jkids)]))]
            (brack-args cont (_1 jkids))))))
    (else (sast-error-at (And (Sz kids) (_0 kids)) "bad type path" kids))))

(define (parse-anon-variant x)
  assert(rx-word? x)
  (surf-variant (rx-leaf-str x)))

;; .tag / ./tag — a relative variant, resolved against the expected
;; type at elaboration.  .true and .false are the nat literals in
;; value position (primitives produce nats, so a distinct boolean
;; member type would not compose with them).
(define (parse-rel-variant x)
  (unless (rx-word? x)
    (sast-error "bad relative variant" x)
    (surf-relvar (rx-leaf-str x))))

(define (parse-rel-variant-val x)
  (unless (rx-word? x)
    (sast-error "bad relative variant" x)
    (let ((tag (rx-leaf-str x)))
      (cond
        ((Eq "true" tag) (surf-lit 1))
        ((Eq "false" tag) (surf-lit 0))
        (else (surf-relvar tag))))))


(define (parse-type-sast ty)
  (define (on-face kids)
    (cond
      ;; =name — the autonamer: the face takes the type's own name.
      ((And (Eq 1 (Sz kids)) (rx-word? (_0 kids)))
        (surf-face (rx-word-str! (_0 kids)) (parse-type-sast (_0 kids))))
      ((Eq 2 (Sz kids))
        (surf-face (rx-word-str! (_0 kids)) (parse-type-sast (_1 kids))))
      (else (sast-error "bad face" (_0 kids)))))
  ;; foo=%/bar / =%/bar — a faced current-namespace reference, arriving
  ;; as the glued "=%/" rune.  The tail keeps the shapes a bare %/
  ;; produces minus the absorbed anchor: a word, a /-path of words
  ;; (spec-tailed or not), or a word-headed spec juxt.  Re-head the
  ;; first segment as a synthetic %/ nest and reuse the road machinery.
  (define (on-cref-face exp kids)
    (define named? (Eq 2 (Sz kids)))
    (define tail
      (unless (Or named? (Eq 1 (Sz kids)))
        (sast-error "bad face" exp)
        (If named? (_1 kids) (_0 kids))))
    (define (cref-head w)
      (rx-nest (rx-span exp) "clear" "%/" [w]))
    (define (tail-first t)
      (cond
        ((rx-word? t) t)
        ((rx-rune? "/" t) (_0 (hr-stem (rx-rune-kids t))))
        ((rx-juxt? t) (_0 (rx-juxt-kids t)))
        (else (sast-error "bad current-namespace reference (%/)" exp))))
    (define parsed
      (cond
        ((rx-word? tail) (parse-road [(cref-head tail)]))
        ((rx-rune? "/" tail)
          (let ((ks (hr-stem (rx-rune-kids tail))))
            (parse-type-path parse-type-sast
              (Weld [(cref-head (tail-first tail))] (drop 1 ks)))))
        ((rx-juxt? tail)
          (let ((jk (rx-juxt-kids tail)))
            (unless (And (Eq 2 (Sz jk))
                      (And (rx-word? (_0 jk)) (spec-brack? (_1 jk))))
              (sast-error "bad current-namespace reference (%/)" exp)
              (surf-tapp
                (Weld [(parse-road [(cref-head (_0 jk))])]
                  (brack-args parse-type-sast (_1 jk)))))))
        (else (sast-error "bad current-namespace reference (%/)" exp))))
    (define fname
      (If named?
        (unless (rx-word? (_0 kids))
          (sast-error "bad face" exp)
          (rx-word-str! (_0 kids)))
        ;; the autonamer: the face takes the FIRST segment's name.
        (rx-word-str! (tail-first tail))))
    (surf-face fname parsed))
  (define (on-clear exp)
    (define rune (rx-nest-rune exp))
    (define kids (rx-nest-kids exp))
    (cond
      ((Eq "" rune)
        (unless (Eq 1 (Sz kids))
          (sast-error "bad type sequence" exp)
          (parse-type-sast (_0 kids))))
      ((Eq "/" rune) (parse-type-path parse-type-sast kids))
      ;; %/name — a current-namespace type reference; the whole nest is
      ;; the head segment of a one-element road.
      ((Eq "%/" rune) (parse-road [exp]))
      ;; foo=%/bar — adjacent rune chars glue, so a faced cref type
      ;; arrives as one "=%/" rune: the face name (absent for the
      ;; autonamer =%/bar), then the reference tail in the same shapes
      ;; a bare %/ produces (word, /-path, or spec juxt).
      ((Eq "=%/" rune) (on-cref-face exp kids))
      ((Eq "=" rune) (on-face kids))
      ((Eq "$" rune)
        (unless (Eq 1 (Sz kids))
          (sast-error "bad variant type" exp)
          (parse-anon-variant (_0 kids))))
      ((Or (Eq "." rune) (Eq "./" rune))
        (unless (Eq 1 (Sz kids))
          (sast-error "bad relative variant" exp)
          (parse-rel-variant (_0 kids))))
      (else (sast-error "bad type rune" exp))))
  (define (on-nest nes)
    (define kids (map parse-type-sast (rx-nest-kids nes)))
    (cond
      ((Eq "clear" (rx-nest-color nes)) (on-clear nes))
      ((And (Eq "brack" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-trow kids))
      ;; A bracket wrapping a single rune expression absorbs the rune
      ;; during rex normalization ([val=a] arrives as an "="-runed
      ;; brack): one-element row of that expression.
      ((Eq "brack" (rx-nest-color nes))
        (surf-trow
          [(parse-type-sast
             (rx-nest (rx-span nes) "clear" (rx-nest-rune nes)
               (rx-nest-kids nes)))]))
      ((And (Eq "paren" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-tapp kids))
      ;; (%/pt) — a parenthesized current-namespace reference: the
      ;; paren absorbs the %/ rune during rex normalization.  Needed
      ;; because = and %/ glue into one rune token when adjacent, so a
      ;; faced cref type is spelled p=(%/pt).
      ((And (Eq "paren" (rx-nest-color nes))
         (Eq "%/" (rx-nest-rune nes)))
        (parse-road [nes]))
      ;; Plain-curly rows are retired: curly is function types only;
      ;; anonymous structural rows are spelled with brackets.
      ((And (Eq "curly" (rx-nest-color nes))
         (Eq ";" (rx-nest-rune nes)))
        (unless (Gt (Sz kids) 1)
          (sast-error "bad function type" nes)
          (surf-tfun (Init kids) (Last kids))))
      ((And (Eq "curly" (rx-nest-color nes))
         (Eq "%" (rx-nest-rune nes)))
        (unless (Gt (Sz kids) 1)
          (sast-error "bad function type" nes)
          (surf-tfun (Init kids) (Last kids))))
      (else (sast-error "bad type nest" nes))))
  (define (on-leaf lef)
    (cond
      ;; _ — the wildcard binder: matches and binds nothing.
      ((And (rx-word? lef) (Eq "_" (rx-leaf-str lef))) surf-hole)
      ((rx-word? lef) (surf-ref [(rx-leaf-str lef)])) ;; local
      ((sym-lit? lef) (surf-tsym (sym-lit-nat lef)))
      (else (sast-error "bad leaf type" lef))))
  (define (on-juxt jux)
    (define kids (rx-juxt-kids jux))
    (cond
      ((And (Eq 2 (Sz kids))
         (And (rx-word? (_0 kids))
           (spec-brack? (_1 kids))))
        (surf-tapp
          (Weld [(surf-ref [(rx-word-str! (_0 kids))])]
            (brack-args parse-type-sast (_1 kids)))))
      ;; %/vec[nat] — a specialized current-namespace reference.
      ((And (Eq 2 (Sz kids))
         (And (cref-nest? (_0 kids))
           (spec-brack? (_1 kids))))
        (surf-tapp
          (Weld [(parse-road [(_0 kids)])]
            (brack-args parse-type-sast (_1 kids)))))
      (else (sast-error "bad type juxt" jux))))
  (cond
    ((rx-nest? ty) (on-nest ty))
    ((rx-leaf? ty) (on-leaf ty))
    ((rx-juxt? ty) (on-juxt ty))
    (else (sast-error "bad type rex" ty))))

;; Kids of an @ / @@ variable list: bare words declare type vars;
;; faced kids (name={k k; nat}) declare compile-time-constant
;; parameters with their types.  -> [vars consts].
(define (parse-tvar-kids ctx kids)
  (define (faced? k) (rx-rune? "=" k))
  (define (bad? k) (Nil (Or (rx-word? k) (faced? k))))
  (define checked
    (unless (Nil (any bad? kids))
      (sast-error "bad type-var declaration" ctx)
      kids))
  (define vars (map rx-word-str! (filter rx-word? checked)))
  (define (parse-const k)
    (define fk (hr-stem (rx-rune-kids k)))
    (unless (And (Eq 2 (Sz fk)) (rx-word? (_0 fk)))
      (sast-error "bad const parameter declaration" ctx)
      [(rx-word-str! (_0 fk)) (parse-type-sast (_1 fk))]))
  [vars (map parse-const (filter faced? checked))])

;;; Value parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (uncurry-call call rest)
  (define ret (If
    (Eq "s_app" (_0 call))
    (snap 2 (lambda (x) (Weld x [rest])) call)
    ;; s_app takes a *row* of arguments; rest is a single SAST node.
    (surf-app call [rest])))
    ret)

assert(Equal (surf-app (surf-ref ["f"]) [(surf-lit 3)])
  (uncurry-call (surf-ref ["f"]) (surf-lit 3)))
assert(Equal (surf-app (surf-ref ["f"]) [(surf-lit 1) (surf-lit 2)])
  (uncurry-call (surf-app (surf-ref ["f"]) [(surf-lit 1)]) (surf-lit 2)))

;;; Arms, methods, and body chains ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (parse-arm-go cont rex)
  (define kids (rx-rune-kids rex))
  (cond
    ((Eq 2 (Sz kids))
      (surf-arm (parse-type-sast (_0 kids)) (cont (_1 kids))))
    ;; A wide free rune (?>, |>) in the arm's body is swallowed into
    ;; the > poem as trailing kids; the tail after the pattern is the
    ;; arm's body chain.
    ((Gt (Sz kids) 2)
      (surf-arm (parse-type-sast (_0 kids))
        (cont (rx-nest (rx-span (_1 kids)) "clear" "" (drop 1 kids)))))
    (else (sast-error "bad case arm" rex))))

(define (parse-arm cont rex)
  (unless (rx-rune? ">" rex)
    (sast-error "case arm must be a > poem" rex)
    (parse-arm-go cont rex)))

(define (parse-meth cont els)
  ;; A paren wrapping a single rune expression absorbs the rune during
  ;; rex normalization — foo(x.y) arrives as a "."-runed paren. Such a
  ;; paren is one argument, not an argument list.
  (define (call-args exp)
    (unless (And (rx-nest? exp) (Eq "paren" (rx-nest-color exp)))
      (sast-error "bad method call" exp)
      (cond
        ((Eq "" (rx-nest-rune exp)) (map cont (rx-nest-kids exp)))
        ;; f(a ; ...) — block-mode arguments: a trailing ; opens rex
        ;; block mode, so a multi-line poem argument (an inline
        ;; lambda) parses with layout instead of as spaced infix.
        ((Eq ";" (rx-nest-rune exp)) (map cont (rx-nest-kids exp)))
        (else [(cont exp)]))))
  (define (parse-seg seg)
    (cond
      ((rx-word? seg)
        (surf-mseg (rx-word-str! seg) []))
      ((rx-juxt? seg)
        (let ((kids (rx-juxt-kids seg)))
          (unless (And (Gt (Sz kids) 1) (rx-word? (_0 kids)))
            (sast-error "bad method segment" seg)
            (surf-mseg (rx-word-str! (_0 kids))
              (foldl Weld [] (map call-args (drop 1 kids)))))))
      (else (sast-error "bad method segment" seg))))
  ;; A receiver is a bare name (stored as its string, resolved by
  ;; elab-var) or an explicitly parenthesized expression (stored as its
  ;; parsed SAST — elab-meth tells them apart by IsApp).
  (define (parse-recv r)
    (cond
      ((rx-word? r) (rx-word-str! r))
      ((And (rx-nest? r) (Eq "paren" (rx-nest-color r))) (cont r))
      (else (sast-error-at r "bad method receiver" els))))
  ;; Tall chains deliver the continuation segments as one vertical
  ;; group kid — splice it (a segment that is a horizontal juxt stays
  ;; whole).
  (define flat-els (hr-stem (rx-group-flat els)))
  (unless (Gt (Sz flat-els) 1)
    (sast-error-at (And (Sz flat-els) (_0 flat-els)) "bad method receiver" flat-els)
    (surf-meth (Weld [(parse-recv (_0 flat-els))]
      (map parse-seg (drop 1 flat-els))))))

(define (parse-val-sast val)
  (define (parse-doc-tvar kids heir)
    (define vc[vars consts] (parse-tvar-kids val kids))
    (surf-tvars vars
      (Ifz (Sz consts) heir (surf-cvars consts heir))))
  (define (parse-spec kids)
    (surf-spec
      (parse-val-sast (_0 kids))
      (brack-args parse-type-sast (_1 kids))))
  (define (spec-juxt? kids)
    (And (Eq 2 (Sz kids))
      (And (spec-brack? (_1 kids))
        (Or (cref-nest? (_0 kids))
          (Nil (And (rx-nest? (_0 kids))
            (Eq "clear" (rx-nest-color (_0 kids)))))))))
  (define (parse-path-val kids)
    (define last (Last kids))
    (If (rx-juxt? last)
      (let ((jkids (rx-juxt-kids last)))
        (If (And (spec-juxt? jkids)
              (road-kids? (Weld (Init kids) [(_0 jkids)])))
          (surf-spec
            (parse-road (Weld (Init kids) [(_0 jkids)]))
            (brack-args parse-type-sast (_1 jkids)))
          (parse-road kids)))
      (parse-road kids)))
  (define (synth-body items)
    (If (Eq 1 (Sz items))
      (_0 items)
      (rx-nest (rx-span (_0 items)) "clear" "" items)))
  ;; Bindings come as > arms (typed, or match-bodied local functions)
  ;; or as bare name/value pairs, consumed PAIRWISE.  Positional
  ;; disambiguation of the group kid: in VALUE position it is the
  ;; binding's block value; in HEAD position (operands fully paired so
  ;; far) it carries continuation pairs — splice it and keep pairing.
  (define (parse-letrec kids heir)
    (define (go rest acc)
      (Ifz (Sz rest)
        acc
        (let ((head (_0 rest)))
          (cond
            ((rx-rune? ">" head)
              (go (drop 1 rest)
                (snoc ((parse-arm parse-val-sast) head) acc)))
            ((rx-plain? "clear" head)
              (go (Weld (hr-stem (rx-nest-kids head)) (drop 1 rest)) acc))
            ;; a binding line (`rt  (_ n.r)`) arrives as one juxt —
            ;; splice it into the pair stream
            ((rx-juxt? head)
              (go (Weld (rx-juxt-kids head) (drop 1 rest)) acc))
            ((Gt (Sz rest) 1)
              (go (drop 2 rest)
                (snoc
                  (surf-arm (parse-type-sast head)
                    (parse-val-sast (_1 rest)))
                  acc)))
            (else (sast-error "unpaired local binding (=)" head))))))
    (surf-letrec (go (hr-stem kids) []) heir))
  ;; Loop (|) parameter arms.  One arm is `> face=type init`; arms on
  ;; one line chain (rex packs the next > nest as a kid of the
  ;; previous), stacked > lines arrive as flat sibling kids.
  (define (loop-arm-of ks)
    (unless (Eq 2 (Sz ks))
      (sast-error "bad loop parameter arm" val)
      (surf-arm (parse-type-sast (_0 ks)) (parse-val-sast (_1 ks)))))
  (define (loop-arm-chain nest acc)
    (define (go own rest)
      (Ifz rest
        (snoc (loop-arm-of own) acc)
        (If (rx-rune? ">" (_0 rest))
          (loop-arm-chain (_0 rest) (snoc (loop-arm-of own) acc))
          (go (snoc (_0 rest) own) (drop 1 rest)))))
    (go [] (rx-rune-kids nest)))
  (define (parse-loop-arms kids)
    (foldl
      (lambda (acc k)
        (If (rx-rune? ">" k)
          (loop-arm-chain k acc)
          (sast-error "loop (|) parameters must be > arms" val)))
      [] (rx-juxt-flat kids)))
  (define (body-flat items)
    (define (flat-one acc item)
      (Weld acc
        (cond
          ((rx-juxt? item) (rx-juxt-kids item))
          ((rx-plain? "clear" item) (rx-nest-kids item))
          (else [item]))))
    (hr-stem (foldl flat-one 0 items)))
  ;; A ? with match arms has a >-rune (single arm) or a juxt starting
  ;; with one (several arms) as its second kid; anything else with a
  ;; heir is a truthy-if.
  (define (arm-ish? k)
    (Or (rx-rune? ">" k)
      (Or (And (rx-juxt? k)
            (rx-rune? ">" (_0 (rx-juxt-kids k))))
        ;; arms arrive as one vertical group kid
        (And (rx-plain? "clear" k)
          (And (Sz (rx-nest-kids k))
            (rx-rune? ">" (_0 (rx-nest-kids k))))))))
  ;; A pipeline stage receives the accumulated value as its FIRST
  ;; argument: |> x / f / g(a b)  =>  (g (f x) a b).  A call-shaped
  ;; stage f(a b) is a juxt (word + arg parens), which no other body
  ;; position accepts standalone — parse it here.
  (define (pipe-args exp)
    (unless (And (rx-nest? exp) (Eq "paren" (rx-nest-color exp)))
      (sast-error "bad pipeline stage arguments" exp)
      (If (Eq "" (rx-nest-rune exp))
        (map parse-val-sast (rx-nest-kids exp))
        [(parse-val-sast exp)])))
  (define (pipe-stage acc stage)
    (If (And (rx-juxt? stage)
          (And (Gt (Sz (rx-juxt-kids stage)) 1)
            (rx-word? (_0 (rx-juxt-kids stage)))))
      (let ((jk (rx-juxt-kids stage)))
        (surf-app (surf-var (rx-word-str! (_0 jk)))
          (Weld [acc] (foldl Weld [] (map pipe-args (drop 1 jk))))))
      (let ((s (parse-val-sast stage)))
        (If (Eq "s_app" (_0 s))
          ["s_app" (Ix 1 s) (Weld [acc] (Ix 2 s))]
          (surf-app s [acc])))))
  ;; a || b [|| c ...] — truthy or, normalized to 1/0.
  (define (or-chain ks)
    (Ifz (Sz ks)
      (surf-lit 0)
      (surf-if (parse-val-sast (_0 ks)) (surf-lit 1) (or-chain (drop 1 ks)))))
  (define (handle-rune rune kids heir)
    (cond
      ((Eq "@" rune)
        (parse-doc-tvar kids heir))
      ((Eq "@@" rune)
        (sast-error "(@@) is only allowed directly in a declaration" val))
      ((Eq "$" rune)
        (unless (Eq 1 (Sz kids))
          (sast-error "bad dollar form" val)
          (If (And (rx-word? (_0 kids)) (Eq foil-no-heir heir))
            (parse-anon-variant (_0 kids))
            ;; Row declarations migrated to the tall : form; a bracket
            ;; here is stale syntax, not an anonymous row.
            (If (And (rx-nest? (_0 kids))
                  (Eq "brack" (rx-nest-color (_0 kids))))
              (sast-error-at (_0 kids)
                "row declarations moved to ':' - write `:  foo=bar ...` instead of `$  [foo=bar ...]`"
                (_0 kids))
              (parse-type-sast (_0 kids))))))
      ((Eq "./" rune)
        (unless (And (Eq 1 (Sz kids)) (Eq foil-no-heir heir))
          (sast-error "bad relative variant" val)
          (parse-rel-variant-val (_0 kids))))
      ;; ?=(PAT VAL) — pattern test: 1 when VAL matches PAT, else 0.
      ;; !?= is its negation (adjacent rune chars lex as one token, so
      ;; the negated test is its own rune).
      ((Or (Eq "?=" rune) (Eq "!?=" rune))
        (let ((pv (If (And (Eq 1 (Sz kids))
                        (And (rx-nest? (_0 kids))
                          (And (Eq "paren" (rx-nest-color (_0 kids)))
                            (Eq "" (rx-nest-rune (_0 kids))))))
                    (rx-nest-kids (_0 kids))
                    kids))
              (yes (surf-lit (If (Eq "?=" rune) 1 0)))
              (no (surf-lit (If (Eq "?=" rune) 0 1))))
          (unless (And (Eq 2 (Sz pv)) (Eq foil-no-heir heir))
            (sast-error "bad pattern test (?=) - needs a pattern and a value" val)
            (surf-case (parse-val-sast (_1 pv))
              [(surf-arm (parse-type-sast (_0 pv)) yes)]
              no))))
      ;; !x — truthy negation, normalized to 1/0.
      ((Eq "!" rune)
        (unless (And (Eq 1 (Sz kids)) (Eq foil-no-heir heir))
          (sast-error "bad negation (!)" val)
          (surf-if (parse-val-sast (_0 kids)) (surf-lit 0) (surf-lit 1))))
      ((Eq "||" rune)
        (unless (And (Gt (Sz kids) 1) (Eq foil-no-heir heir))
          (sast-error "bad or (||)" val)
          (or-chain kids)))
      ;; ?>  PAT SCRUT   bind-or-else: match SCRUT against PAT; on a
      ;;     ELSE        match the rest of the body (the heir) runs
      ;; REST...         with PAT's binders in scope, otherwise ELSE.
      ((Eq "?>" rune)
        (unless (And (Eq 3 (Sz kids)) (Ne foil-no-heir heir))
          (sast-error "bad bind-or-else (?>) - needs a pattern, a value, an indented else, and a following body" val)
          (surf-case (parse-val-sast (_1 kids))
            [(surf-arm (parse-type-sast (_0 kids)) heir)]
            (parse-val-sast (_2 kids)))))
      ;; >  PAT SOURCE   standalone introduction through a pattern.
      ;; REST...         Two kids: the pattern must be statically
      ;;                 irrefutable — a one-binding letrec.  Three kids
      ;; >  PAT SOURCE   (an indented failure value): a guarded
      ;;    FAILURE      introduction — on a match the heir runs with
      ;; REST...         the pattern's binders, otherwise FAILURE (the
      ;;                 same desugar as ?>).
      ((Eq ">" rune)
        (unless (And (Or (Eq 2 (Sz kids)) (Eq 3 (Sz kids)))
                  (Ne foil-no-heir heir))
          (sast-error "bad standalone binding (>) - needs a pattern, a source value, an optional indented failure value, and a following body" val)
          (If (Eq 2 (Sz kids))
            (surf-letrec
              [(surf-arm (parse-type-sast (_0 kids))
                 (parse-val-sast (_1 kids)))]
              heir)
            (surf-case (parse-val-sast (_1 kids))
              [(surf-arm (parse-type-sast (_0 kids)) heir)]
              (parse-val-sast (_2 kids))))))
      ((Eq "|>" rune)
        (unless (And (Gt (Sz kids) 1) (Eq foil-no-heir heir))
          (sast-error "pipeline (|>) requires a seed and at least one stage" val)
          (foldl pipe-stage (parse-val-sast (_0 kids)) (drop 1 kids))))
      ;; A \ with a body chain (heir) is a declaration's parameter
      ;; slot.  Without one it is an INLINE lambda: parameters are the
      ;; kids on the rune's own line, the body is everything after
      ;; (one-liners split before the last kid).  The body kids parse
      ;; as a body chain through a synthetic clear nest.
      ((Eq "\" rune)
        (If (Ne foil-no-heir heir)
          ;; Declaration parameter slot: multi-line parameter lists
          ;; arrive as a trailing group — splice it.
          (surf-fun (map parse-type-sast (hr-stem (rx-juxt-flat kids))) heir)
          ;; Inline lambda: the body is the last kid (a group when it
          ;; spanned lines), parameters are the rest.  Positional — no
          ;; line arithmetic.
          (let ((fk (hr-stem (rx-juxt-flat kids))))
            (unless (Gt (Sz fk) 1)
              (sast-error "inline lambda needs parameters and a body" val)
              (surf-fun (map parse-type-sast (Init fk))
                (parse-val-sast (Last fk)))))))
      ((Eq "%" rune)
        (uncurry-call (parse-val-sast (_0 kids)) heir))
      ((Eq "^" rune)
        (unless (And (Eq 1 (Sz kids)) (Ne foil-no-heir heir))
          (sast-error "cast (^) needs a value to cast - for type reflection write (^ expr)" val)
          (surf-cast (parse-type-sast (_0 kids)) heir)))
      ((Eq "&" rune)
        ;; Variants stack vertically; splice the group (a spec juxt
        ;; variant stays one operand).
        (surf-union (map parse-type-sast (hr-stem (rx-juxt-flat kids)))))
      ((Eq "?" rune)
        (If (And (Gt (Sz kids) 1)
              (And (Ne foil-no-heir heir) (Nil (arm-ish? (_1 kids)))))
          (surf-if
            (parse-val-sast (_0 kids))
            (parse-val-sast (synth-body (hr-stem (drop 1 kids))))
            heir)
          ;; Trailing non-> items among the arms are the fallthrough
          ;; chain (a fallthrough written at the arms' column rides
          ;; inside the poem instead of chaining as the heir).
          (let* ((items (hr-stem (rx-juxt-flat (drop 1 kids))))
                 (na (find-idx (lambda (k) (Nil (rx-rune? ">" k))) items))
                 (arms (Ifz na items (take (_0 na) items)))
                 (trail (Ifz na [] (drop (_0 na) items))))
            (unless (Or (Ifz (Sz trail) 1 0) (Eq foil-no-heir heir))
              (sast-error
                "match has both an indented fallthrough and a following body"
                val)
              (surf-case
                (parse-val-sast (_0 kids))
                (map (parse-arm parse-val-sast) arms)
                (Ifz (Sz trail) heir (parse-val-sast (synth-body trail))))))))
      ((Eq "=" rune)
        (parse-letrec kids heir))
      ;; Loop: `|  > foo=nat 3` declares loop params with initial
      ;; values; the heir is the body, re-entered via (_ ...).  Arms
      ;; written on one line chain (the next > nest rides as a kid of
      ;; the previous), so unchain; stacked > lines arrive flat.
      ((Eq "|" rune)
        (unless (Nil (Eq foil-no-heir heir))
          (sast-error "loop (|) requires a body" val)
          (let ((arms (parse-loop-arms kids)))
            (unless (Gt (Sz arms) 0)
              (sast-error "loop (|) requires at least one > parameter arm" val)
              (surf-loop arms heir)))))
      ;; Tall row type declaration: `:  foo=bar baz=qux`.  Kids are the
      ;; faced field types; a lone `:` is the empty row (and `:  []` is
      ;; accepted as its bracketed spelling).
      ((Eq ":" rune)
        (unless (Eq foil-no-heir heir)
          (sast-error "row type declaration (:) does not take a body" val)
          (let ((fk (hr-stem (rx-juxt-flat kids))))
            (surf-trow
              (map parse-type-sast
                (If (And (Eq 1 (Sz fk))
                      (And (rx-plain? "brack" (_0 fk))
                        (Eq 0 (Sz (rx-nest-kids (_0 fk))))))
                  []
                  fk))))))
      (else (sast-error "wack rune" val))))
  (define (parse-body-go kids tail)
    (cond
      ((Eq 0 (Sz kids)) tail)
      ((And (Eq foil-no-heir tail) (spec-juxt? kids)) (parse-spec kids))
      ((And (Eq foil-no-heir tail) (Eq 1 (Sz kids)))
        (parse-val-sast (_0 kids)))
      (else
        (let ((body (_0 kids))
              (hair (parse-body-go (drop 1 kids) tail)))
          (cond
            ((rx-rune? "$" body) (handle-rune "$" (rx-rune-kids body) hair))
            ;; A wide free rune (?>, |>) in a lambda's body is
            ;; swallowed into the \ poem as trailing kids (rex heirs
            ;; align on free-pos); split at the first wide-rune kid —
            ;; everything from there chains before the heir.
            ;; Multi-line PARAMETER lists stay whole.
            ((rx-rune? "\" body)
              (let* ((bk (rx-rune-kids body))
                     (wide? (lambda (k)
                              (Or (rx-rune? "?>" k) (rx-rune? "|>" k))))
                     (cut (find-idx wide? bk)))
                (If cut
                  (handle-rune "\" (take (_0 cut) bk)
                    (parse-body-go (body-flat (drop (_0 cut) bk)) hair))
                  (handle-rune "\" bk hair))))
            ((rx-rune? "%" body) (handle-rune "%" (rx-rune-kids body) hair))
            ;; A wide free rune (?>, |>) starting the body line after a
            ;; cast or a truthy-? leg cannot heir-chain (rex heirs align
            ;; on free-pos, and the rune widths differ), so rex delivers
            ;; it — and the rest of the poem's body — as trailing kids.
            ;; Split them back out; the poem's own slots keep their
            ;; arity and the trailing kids chain before the outer hair.
            ((rx-rune? "^" body)
              (let ((bk (rx-rune-kids body)))
                (If (Gt (Sz bk) 1)
                  (handle-rune "^" [(_0 bk)]
                    (parse-body-go (body-flat (drop 1 bk)) hair))
                  (handle-rune "^" bk hair))))
            ((rx-rune? "&" body) (handle-rune "&" (rx-rune-kids body) hair))
            ((rx-rune? ":" body) (handle-rune ":" (rx-rune-kids body) hair))
            ((rx-rune? "?" body)
              (handle-rune "?" (rx-rune-kids body) hair))
            ((rx-rune? "?>" body) (handle-rune "?>" (rx-rune-kids body) hair))
            ;; A wide free rune (?>, |>) opening a standalone >'s heir
            ;; cannot heir-chain (rune widths differ) and is swallowed
            ;; into the > poem as trailing kids — split it back out.
            ((rx-rune? ">" body)
              (let* ((bk (rx-rune-kids body))
                     (wide? (lambda (k)
                              (Or (rx-rune? "?>" k) (rx-rune? "|>" k))))
                     (cut (find-idx wide? bk)))
                (If cut
                  (handle-rune ">" (take (_0 cut) bk)
                    (parse-body-go (body-flat (drop (_0 cut) bk)) hair))
                  (handle-rune ">" bk hair))))
            ((rx-rune? "=" body) (handle-rune "=" (rx-rune-kids body) hair))
            ((rx-rune? "|" body) (handle-rune "|" (rx-rune-kids body) hair))
            ((And (rx-nest-is? "paren" "@" body) (Ne foil-no-heir hair))
              (parse-doc-tvar (rx-nest-kids body) hair))
            ((And (rx-nest-is? "paren" "=" body) (Ne foil-no-heir hair))
              (parse-letrec (rx-nest-kids body) hair))
            (else (sast-error "unrecognized body form" body)))))))
  (define (parse-body items)
    (parse-body-go (body-flat items) foil-no-heir))
  (define (on-word wor)
    (cond
      ((str-numeric? wor) (surf-lit (parse-nat wor)))
      ;; variable lookup
      (else (surf-var wor))))
  (define (on-literal lef)
    (define shape (rx-leaf-shape lef))
    (define text (rx-leaf-str lef))
    ;; Quip leaves keep their leading tick in the rex text; strip it so
    ;; the SAST carries only the aura payload.
    (surf-literal shape (If (Eq shape "quip") (Rsh text 8) text)))
  (define (on-leaf lef)
    (cond
      ((rx-word? lef) (on-word (rx-word-str! lef)))
      ((rx-literal? lef) (on-literal lef))
      (else (sast-error "bad leaf val" lef))))
  (define (on-paren nes)
    (define kids (map parse-val-sast (rx-nest-kids nes)))
    (cond
      ((Eq "" (rx-nest-rune nes))
        (unless (Gt (Sz kids) 0)
          (sast-error "bad empty call" nes)
          ;; (_ args...) recurses: _ is a word, not a rune, so the
          ;; self-call marker is an application whose head is the
          ;; word _.
          (If (Equal (surf-var "_") (_0 kids))
            (surf-self (drop 1 kids))
            (surf-app (_0 kids) (drop 1 kids)))))
      ((Eq "/" (rx-nest-rune nes))
        ;; a zero-arg call of a path — possibly spec-tailed:
        ;; (labeled/tagof['$foo])
        (surf-app (parse-path-val (rx-nest-kids nes)) []))
      ;; (%/add) — a zero-arg call of a current-namespace reference
      ;; (the paren absorbs the %/ rune during rex normalization).
      ((Eq "%/" (rx-nest-rune nes))
        (surf-app (parse-road [nes]) []))
      ;; (^ expr) — unary type reflection.  Only the PAREN form
      ;; reflects: a clear-form ^ with no heir is a dangling cast and
      ;; stays a parse error (handle-rune below).
      ((Eq "^" (rx-nest-rune nes))
        (unless (Eq 1 (Sz kids))
          (sast-error "type reflection (^ expr) takes exactly one expression" nes)
          (surf-reflect (_0 kids))))
      ((Eq "." (rx-nest-rune nes))
        (If (Eq 1 (Sz (rx-nest-kids nes)))
          (parse-rel-variant-val (_0 (rx-nest-kids nes)))
          (parse-meth parse-val-sast (rx-nest-kids nes))))
      (else (handle-rune (rx-nest-rune nes) (rx-nest-kids nes) foil-no-heir))))
  (define (on-clear nes)
    (define rune (rx-nest-rune nes))
    (define kids (rx-nest-kids nes))
    (cond
      ((Eq "" rune) (parse-body kids))
      ((Eq "/" rune) (parse-path-val kids))
      ;; %/name — a current-namespace reference in value position.
      ((Eq "%/" rune) (parse-road [nes]))
      ((Eq "." rune)
        (If (Eq 1 (Sz kids))
          (parse-rel-variant-val (_0 kids))
          (parse-meth parse-val-sast kids)))
      ;; Same trailing-kid repairs as parse-body's dispatch, for ^ and
      ;; truthy-? poems in nested position (e.g. an arm value).
      ((Eq "^" rune)
        (If (Gt (Sz kids) 1)
          (handle-rune "^" [(_0 kids)] (parse-body (drop 1 kids)))
          (handle-rune "^" kids foil-no-heir)))
      ((Eq "?" rune)
        (handle-rune "?" kids foil-no-heir))
      ((Eq ".#" rune)
        (surf-ufcs-put (_0 kids) (_1 kids)))
      ((Eq ".%" rune)
        (surf-ufcs-over (_0 kids) (_1 kids)))
      (else (handle-rune rune kids foil-no-heir))))
  (define (on-nest nes)
    (cond
      ((Eq "clear" (rx-nest-color nes)) (on-clear nes))
      ((Eq "paren" (rx-nest-color nes)) (on-paren nes))
      ((And (Eq "brack" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-row (map parse-val-sast (rx-nest-kids nes))))
      ;; A bracket wrapping a single rune expression absorbs the rune
      ;; during rex normalization ([h.key] arrives as a "."-runed
      ;; brack): a one-element row of that expression.
      ((Eq "brack" (rx-nest-color nes))
        (surf-row
          [(parse-val-sast
             (rx-nest (rx-span nes) "clear" (rx-nest-rune nes)
               (rx-nest-kids nes)))]))
      (else (sast-error "bad rex val nest" val))))
  (cond
    ((rx-nest? val) (on-nest val))
    ((rx-leaf? val) (on-leaf val))
    ((rx-juxt? val)
      (let ((kids (rx-juxt-kids val)))
        (If (spec-juxt? kids)
          (parse-spec kids)
          (parse-body kids))))
    (else (sast-error "weird node" val))))

;;; Module declaration parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (split-decl-name items)
  (define idx (need (find-idx rx-word? items)))
  [(rx-word-str! (Ix idx items)) (drop (Inc idx) items)])

(define (parse-module-sast here val)
  (define span (rx-span val))
  ;; Import options use the same faced-row spelling as Foil values/types:
  ;;
  ;;   - sept [order=10]       root union with explicit precedence
  ;;   - vec  [at=deps/vec]    prefix mount
  ;;
  ;; A singleton faced bracket absorbs its `=` rune during Rex
  ;; normalization, while a multi-option bracket contains one clear `=` nest
  ;; per option.  Normalize both shapes before validating the fields.
  (define (import-options? x)
    (And (rx-nest? x) (Eq "brack" (rx-nest-color x))))

  (define (parse-import-at ctx x)
    (cond
      ((rx-word? x) [(rx-word-str! x)])
      ((And (rx-nest? x)
         (And (Eq "brack" (rx-nest-color x))
           (And (Eq "" (rx-nest-rune x)) (Ifz (Sz (rx-nest-kids x)) 1 0))))
        [])
      ((rx-rune? "/" x)
        (let ((kids (hr-stem (rx-rune-kids x))))
          (unless (And (Sz kids) (all rx-word? kids))
            (sast-error-at x "bad import at path" ctx)
            (map rx-word-str! kids))))
      (else (sast-error-at x "bad import at path" ctx))))

  (define (import-option-items opts)
    (cond
      ((Eq "" (rx-nest-rune opts)) (hr-stem (rx-nest-kids opts)))
      ((Eq "=" (rx-nest-rune opts))
        [(rx-nest (rx-span opts) "clear" "=" (rx-nest-kids opts))])
      (else (sast-error-at opts "bad import options" opts))))

  ;; -> [at maybe-order], where maybe-order is 0 when absent and [n]
  ;; when explicit.  The wrapper distinguishes explicit order zero from no
  ;; order at all.
  (define (parse-import-options inherited imp opts)
    ;; state: [has-at at has-order order]
    (define (step st item)
      (unless (rx-rune? "=" item)
        (sast-error-at item "bad import option" item)
        (let ((kids (hr-stem (rx-rune-kids item))))
          (unless (And (Eq 2 (Sz kids)) (rx-word? (_0 kids)))
            (sast-error-at item "bad import option" item)
            (let ((key (rx-word-str! (_0 kids)))
                  (arg (_1 kids)))
              (cond
                ((Eq "at" key)
                  (unless (Nil (_0 st))
                    (sast-error-at item "duplicate import option" key)
                    [1 (parse-import-at imp arg) (_2 st) (_3 st)]))
                ((Eq "order" key)
                  (unless (Nil (_2 st))
                    (sast-error-at item "duplicate import option" key)
                    (unless (And (rx-word? arg)
                              (str-numeric? (rx-word-str! arg)))
                      (sast-error-at arg "bad import order (expected nat)" arg)
                      [(_0 st) (_1 st) 1 (parse-nat (rx-word-str! arg))])))
                (else (sast-error-at item "unknown import option" key))))))))
    (define parsed
      (foldl step [0 inherited 0 0] (import-option-items opts)))
    (define at (_1 parsed))
    (define order (Ifz (_2 parsed) 0 [(_3 parsed)]))
    (unless (Nil (And order (Sz at)))
      (sast-error-at opts "import order is only valid for a root union" opts)
      [at order]))

  ;; `-` imports each bare module word.  An option row makes the declaration
  ;; singular; old `- alpha beta` and nested `+ app / - vec` remain valid.
  (define (on-import here imp)
    (define (one w)
      (unless (rx-word? w)
        (sast-error "bad import (expected module names)" imp)
        (surf-import here (rx-span imp) (rx-word-str! w))))
    (define items (hr-stem (rx-rune-kids imp)))
    (define opts (filter import-options? items))
    (Ifz (Sz opts)
      (map one items)
      (unless (And (Eq 1 (Sz opts))
                (And (Eq 2 (Sz items))
                  (And (rx-word? (_0 items))
                    (import-options? (_1 items)))))
        (sast-error-at imp "bad import (options require exactly one module)" imp)
        (let ((parsed (parse-import-options here imp (_1 items))))
          [(surf-import-at-order (_0 parsed) (rx-span imp)
             (rx-word-str! (_0 items)) (_1 parsed))]))))

  ; A namespace module is either a flat stack of decls, a single decl, or a value.
  ;; Each decl parses under its own Try (deep-forced — the rows are
  ;; lazy), so one malformed decl becomes an s_bad row and its
  ;; neighbors still parse: the module reports every parse error at
  ;; once (elab-mod's scan pass collects s_bad rows into diagnostics).
  (define (on-dec-list here decs)
    (define ds (hr-stem (rx-juxt-flat decs)))
    (define n (Sz ds))
    ;; Rex rune spans run through their heir chains, so a decl's raw
    ;; span swallows every following sibling (a top-level decl's ran
    ;; to end of file).  Cap each sibling's rows — its own decl and
    ;; everything nested under it — at the next sibling's offset; the
    ;; recursion applies the same cap at every nesting level.
    (define (cap limit row)
      (If (And limit (Eq "s_decl" (Ix 0 row)))
        (let* ((sp (Ix 2 row))
               (off (Ix 2 sp)))
          (If (Gt (Add off (Ix 3 sp)) limit)
            (Up 2 [(Ix 0 sp) (Ix 1 sp) off (Sub limit off)] row)
            row))
        row))
    (define (pop-one i)
      (define dec (Ix i ds))
      (define limit
        (If (Lt (Inc i) n) (Ix 2 (rx-span (Ix (Inc i) ds))) 0))
      (define r
        (Try (lambda (z)
               (let ((rows (parse-module-sast here dec)))
                 (DeepSeq rows rows)))
          0))
      (If (Eq 1 (Hd r))
        [["s_bad" here (rx-span dec) (_0 r)]]
        (map (cap limit) (_0 r))))
    (foldl (lambda (acc i) (Weld acc (pop-one i))) 0 (gen n (lambda (i) i))))

  (define (on-decl dec)
    ;; Note: the reserved /ty-ap and /ty-var namespaces need no parse
    ;; fence — `-` is a rune character, so no source word can spell
    ;; them.  elab-mod backstops synthetic module rows.
    (define e[name contents0] (split-decl-name (hr-stem (rx-rune-kids dec))))
    (define contents (hr-stem (rx-juxt-flat contents0)))
    (define (sort-content acc[self kids imps tvs] item)
      (cond
        ((rx-rune? "+" item) [self (snoc item kids) imps tvs])
        ((rx-rune? "-" item) [self kids (snoc item imps) tvs])
        ((Or (rx-nest-is? "paren" "@@" item) (rx-rune? "@@" item))
          [self kids imps (snoc item tvs)])
        (else [(snoc item self) kids imps tvs])))
    (define sorted[self kids imps tvs] (foldl sort-content [0 0 0 0] contents))
    ;; (@@ vars): namespace-scoped type variables — declared once,
    ;; visible to this decl and every descendant, dropped per-decl if
    ;; unused (elab-tvars).
    (define (tvar-kids item)
      (If (rx-rune? "@@" item) (rx-rune-kids item) (rx-nest-kids item)))
    (define scoped-vc
      (foldl
        (lambda (acc it)
          (let ((r (parse-tvar-kids dec (hr-stem (tvar-kids it)))))
            [(Weld (_0 acc) (_0 r)) (Weld (_1 acc) (_1 r))]))
        [[] []] tvs))
    (define scoped-vars (_0 scoped-vc))
    (define scoped-consts (_1 scoped-vc))
    (define (dup-in? xs)
      (Ifz (Sz xs) 0
        (Or (includes (Eq (_0 xs)) (drop 1 xs)) (dup-in? (drop 1 xs)))))
    (define checked-vars
      (unless (Nil (dup-in? (Weld scoped-vars (map (Ix 0) scoped-consts))))
        (sast-error "duplicate (@@) variable" dec)
        scoped-vars))
    (define (wrap-span-tvars spannode)
      (surf-span (Ix 1 spannode)
        (surf-tvars checked-vars
          (Ifz (Sz scoped-consts)
            (Ix 2 spannode)
            (surf-cvars scoped-consts (Ix 2 spannode))))))
    (define (wrap-decl-rows rows)
      (If (And (Ifz (Sz checked-vars) 1 0) (Ifz (Sz scoped-consts) 1 0))
        rows
        (map (lambda (row)
               (If (Eq "s_decl" (_0 row))
                 (Up 3 (wrap-span-tvars (Ix 3 row)) row)
                 row))
          rows)))
    (define here1 (snoc name here))
    (define conspan (Ifz self (rx-span dec) (span-join-row self)))
    (define clause (parse-val-sast (rx-nest conspan "clear" "" self)))
    ;; A bodiless named decl is a pure namespace: no entry of its own.
    ;; Numeric "names" should still surface as malformed declarations.
    (define decrow
      (If (And (Ifz self 1 0) (Nil (str-numeric? name)))
        []
        [(surf-decl here1 span (surf-span conspan clause))]))
    (Weld (wrap-decl-rows decrow)
      (Weld (foldl Weld [] (map (on-import here1) imps))
        (wrap-decl-rows (on-dec-list here1 kids)))))

  (cond
    ((rx-juxt? val)     (on-dec-list here (rx-juxt-kids val)))
    ((rx-rune? "+" val) (on-decl val))
    ((rx-rune? "-" val) (on-import here val))
    ((And (rx-rune? "" val) (Eq "clear" (rx-nest-color val)))
      (on-dec-list here (rx-nest-kids val)))
    (else (sast-error "wack module" val))))
