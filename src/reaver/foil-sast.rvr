(define (split-decl-name items)
  (define idx (need (find-idx rx-word? items)))
  [(rx-word-str! (Ix idx items)) (drop (Inc idx) items)])


(define (parse-module-sast here val)
  (define span (rx-span val))
  ;(define (parse-
  ; A namespace module is either a flat stack of decls
  ; a single decl, or a value.
  (define (on-dec-list here decs)
    (define (pop-next acc dec)
      (Weld acc (parse-module-sast here dec)))
    (foldl pop-next 0 decs))

  (define (on-decl dec)
    (define e[name contents] (split-decl-name (rx-heir-flat dec)))
    ;; collect until we hit a
    (define split-idx
      (define (f x) (rx-rune? "+" ))
      (fall (Sz contents) (find-idx (rx-rune? "+") contents)))
    (define self (take split-idx contents))
    (define kids (drop split-idx contents))
    (define here1 (snoc name here))
    (define conspan (span-join-row self))
    (define clause (parse-val-sast ["heir" conspan self]))
    (Weld [(surf-decl here1 span (surf-span conspan clause))]
      (on-dec-list here1 kids)))




  ; ;; decl list
  ; (define (on-heir items)
  ;   ;; collect until we hit a
  ;   (define split-idx
  ;     (define (f x) (rx-rune? "+" ))
  ;     (fall (Sz items) (find-idx (rx-rune? "+") items)))
  ;   (define self (take split-idx items))
  ;   (define kids (drop split-idx items))
  ;   (print ("idx" self))
  ;   (Ifz split-idx
  ;     (on-dec-list here kids)
  ;     (on-self-kids self kids)))



  (cond
    ((rx-heir? val)     (on-dec-list here (rx-heir-kids val)))
    ((rx-rune? "+" val) (on-decl (rx-rune-kids val)))
    (else (error ("wack module" val)))))

