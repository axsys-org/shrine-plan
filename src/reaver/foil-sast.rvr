(#bind bst (#module bst))
(#import bst)
(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))

;;; Normalized Rex helpers
(define rx-tag Ix0)
(define rx-span Ix1)
(define (rx? tag x) (Eq tag (rx-tag x)))
(define (rx-bad ctx want have)
  (error ("FAILED REX" ctx "expected" want "got" have)))

(define rx-leaf? (rx? "leaf"))
(define rx-nest? (rx? "nest"))
(define rx-juxt? (rx? "juxt"))

(define rx-leaf-shape (Ix 2))
(define rx-leaf-str (Ix 3))
(define rx-nest-color (Ix 2))
(define rx-nest-rune (Ix 3))
(define rx-nest-kids (Ix 4))
(define rx-juxt-kids (Ix 2))

(define span-line (Ix 0))
(define span-col (Ix 1))
(define span-off (Ix 2))
(define span-len (Ix 3))

(define (span-end x)
  (Add (span-off x) (span-len x)))
(define set-span-line (Up 0))
(define set-span-col (Up 1))
(define set-span-off (Up 2))
(define set-span-len (Up 3))
(define (set-span-end end x)
  (set-span-len (Sub end (span-off x)) x))

(define (span-first x y)
  (If (Lt (span-off x) (span-off y))
    y x))
(define (span-last x y)
  (If (Lt (span-end x) (span-end y))
    x y))

(define (span-join x y)
  (define first (span-first x y))
  (define last (span-last x y))
  (set-span-end (span-end last) first))

(define (span-join-row rexs)
  (foldr1 span-join (map rx-span rexs)))

(define (rx-shape? shape x)
  (And (rx-leaf? x) (Eq shape (rx-leaf-shape x))))
(define rx-word? (rx-shape? "word"))
(define rx-slug? (rx-shape? "slug"))
(define (rx-literal? x)
  (And (rx-leaf? x)
    (Or (Eq "cord" (rx-leaf-shape x))
      (Or (Eq "tape" (rx-leaf-shape x))
        (Or (Eq "span" (rx-leaf-shape x))
          (Eq "page" (rx-leaf-shape x)))))))

(define (rx-word-str! x)
  assert(rx-word? x)
  (rx-leaf-str x))
(define (rx-get-word x)
  (_3 x))

(define (rx-nest-is? color rune x)
  (And (rx-nest? x)
    (And (Eq color (rx-nest-color x))
      (Eq rune (rx-nest-rune x)))))
(define (rx-rune? rune x)
  (rx-nest-is? "clear" rune x))
(define rx-rune-kids rx-nest-kids)
(define (rx-plain? color x)
  (rx-nest-is? color "" x))
(define (rx-brack? color x)
  (And (rx-nest? x) (Eq color (rx-nest-color x))))

(define (rx-juxt-flat xs)
  (define (f acc arg)
    (Weld acc
      (If (rx-juxt? arg)
        (rx-juxt-kids arg)
        [arg])))
  (foldl f 0 xs))

(define (rx-comment? x)
  (rx-slug? x))
(define (not-comment x)
  (Nil (rx-comment? x)))
(define (hr-stem xs)
  (filter not-comment xs))

(define (surf-ref ref)
  assert(Gt (Sz ref) 0)
  ["s_ref" ref])
(define surf-ref-val (Ix 1))
(define (surf-lit lit)
  ["s_lit" lit])
(define surf-lit-val (Ix 1))
(define surf-ref-path (Ix 1))
(define (surf-var v)
  assert(IsNat v)
  ["s_var" v])
(define (surf-typ-mode x)
  ["s_typ"])

(define (surf-arm pat val)
  ["s_arm" pat val])
(define surf-arm-pat (Ix 1))
(define surf-arm-val (Ix 2))

(define (surf-self args) ["s_self" args])

(define (surf-tvar var body)
  assert(IsNat var)
  ["s_tvar" var body])
(define (surf-tvars vars body)
  ["s_tvars" vars body])
(define (surf-letrec arms body)
  ["s_letrec" arms body])
(define (surf-ufcs-put var app)
  ["s_ufcs_put" var app])
(define (surf-ufcs-over var app)
  ["s_ufcs_over" var app])
(define (surf-literal shape text)
  ["s_literal" shape text])

(define (surf-cast ty body)
  ["s_cast" ty body])
(define surf-cast-ty (Ix 1))
(define (surf-union opts)
  ["s_union" opts])
(define surf-union-opts (Ix 1))
(define (surf-case scrut arms fall)
  ["s_case" scrut arms fall])


;;  (f x y z)
(define (surf-app f x) ["s_app" f x])
;;; (f x y z) in type mode
(define (surf-tapp args) ["s_tapp" args])
(define surf-tapp-kids (Ix 1))
;; x=nat
(define (surf-face face ty) ["s_face" face ty])
(define surf-face-name (Ix 1))
(define surf-face-kid (Ix 2))

;; [3 4]
(define (surf-row row) ["s_row" row])
(define surf-row-kids (Ix 1))
;; [x=nat y=nat]
(define (surf-trow row) ["s_trow" row])
(define (surf-sum vars) ["s_sum" vars])

;; $foo in [$foo bar]
(define (surf-variant tag)
  ["s_variant" tag])

(define (surf-fun args ret)
  ["s_fun" args ret])
(define surf-fun-args (Ix 1))
(define surf-fun-ret (Ix 2))
(define (surf-tfun args ret)
  ["s_tfun" args ret])
(define (surf-meth args)
  ["s_meth" args])
(define (surf-mseg name args)
  ["s_mseg" name args])
(define (surf-mseg-name seg)
  (If (IsNat seg) seg (Ix 1 seg)))
(define (surf-mseg-args seg)
  (If (IsNat seg) [] (Ix 2 seg)))

(define surf-hole ["s_hole"])


;;; end shared
(define (surf-mod decls)
  ["s_mod" decls])

  ;; span is total span for entire submodule range (i.e. z care)
;; annotate with surf-span on clause for specific name
(define (surf-decl name span clause)
  ["s_decl" name span clause])

(define (surf-span span val)
  ["s_span" span val])

(define (surf-doc text kids)
  ["s_doc" text kids])

(define (split-once f x)
  (define (go acc r[x xs])
    (Ifz r [(rowify (lflop acc)) 0]
    (If (f x)
      [(rowify (lflop acc)) (rowify r)]
      (go (lcons x acc) xs))))
  (go 0 (stream x)))

(define (parse-road els)
  (surf-ref (map rx-word-str! els)))

(define (parse-anon-variant x)
  assert(rx-word? x)
  (surf-variant (rx-leaf-str x)))

(define (parse-type-sast ty)
  (define (on-face kids)
    assert(Eq 2 (Sz kids))
    (surf-face (rx-word-str! (_0 kids)) (parse-type-sast (_1 kids))))
  (define (on-clear exp)
    (define rune (rx-nest-rune exp))
    (define kids (rx-nest-kids exp))
    (cond
      ((Eq "" rune)
        (unless (Eq 1 (Sz kids))
          (error ("bad type sequence" exp))
          (parse-type-sast (_0 kids))))
      ((Eq ":" rune) (parse-road kids))
      ((Eq "=" rune) (on-face kids))
      ((Eq "$" rune)
        (unless (Eq 1 (Sz kids))
          (error ("bad variant type" exp))
          (parse-anon-variant (_0 kids))))
      (else (error ("bad type rune" exp)))))
  (define (on-nest nes)
    (define kids (map parse-type-sast (rx-nest-kids nes)))
    (cond
      ((Eq "clear" (rx-nest-color nes)) (on-clear nes))
      ((And (Eq "brack" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-trow kids))
      ((And (Eq "paren" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-tapp kids))
      ((And (Eq "curly" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-trow kids))
      ((And (Eq "curly" (rx-nest-color nes))
         (Eq ";" (rx-nest-rune nes)))
        (unless (Gt (Sz kids) 1)
          (error ("bad function type" nes))
          (surf-tfun (Init kids) (Last kids))))
      ((And (Eq "curly" (rx-nest-color nes))
         (Eq "%" (rx-nest-rune nes)))
        (unless (Gt (Sz kids) 1)
          (error ("bad function type" nes))
          (surf-tfun (Init kids) (Last kids))))
      (else (error ("bad type nest" nes)))))
  (define (on-leaf lef)
    (cond
      ((rx-word? lef) (surf-ref [(rx-leaf-str lef)])) ;; local
      (else (error ("bad leaf type" lef)))))
  (define (on-juxt jux)
    (define kids (rx-juxt-kids jux))
    (cond
      ((And (Eq 2 (Sz kids))
         (And (rx-word? (_0 kids))
           (rx-plain? "brack" (_1 kids))))
        (surf-tapp
          (Weld [(surf-ref [(rx-word-str! (_0 kids))])]
            (map parse-type-sast (rx-nest-kids (_1 kids))))))
      (else (error ("bad type juxt" jux)))))
  (cond
    ((rx-nest? ty) (on-nest ty))
    ((rx-leaf? ty) (on-leaf ty))
    ((rx-juxt? ty) (on-juxt ty))
    (else (error ("bad type rex" ty)))))

(define (uncurry-call call rest)
  (define ret (If
    (Eq "s_app" (_0 call))
    (snap 2 (lambda (x) (Weld x [rest])) call)
    (surf-app call rest)))
    ret)

(define (parse-arm cont rex)
  assert(rx-rune? ">" rex)
  (define kids (rx-rune-kids rex))
  (unless (Eq 2 (Sz kids))
    (error ("bad case arm" rex))
    (surf-arm (parse-type-sast (_0 kids)) (cont (_1 kids)))))

(define (parse-meth cont els)
  (define (call-args exp)
    (unless (rx-plain? "paren" exp)
      (error ("bad method call" exp))
      (map cont (rx-nest-kids exp))))
  (define (parse-seg seg)
    (cond
      ((rx-word? seg)
        (surf-mseg (rx-word-str! seg) []))
      ((rx-juxt? seg)
        (let ((kids (rx-juxt-kids seg)))
          (unless (And (Gt (Sz kids) 1) (rx-word? (_0 kids)))
            (error ("bad method segment" seg))
            (surf-mseg (rx-word-str! (_0 kids))
              (foldl Weld [] (map call-args (drop 1 kids)))))))
      (else (error ("bad method segment" seg)))))
  (unless (And (Gt (Sz els) 1) (rx-word? (_0 els)))
    (error ("bad method receiver" els))
    (surf-meth (Weld [(rx-word-str! (_0 els))]
      (map parse-seg (drop 1 els))))))

(define (parse-val-sast val)
  (define (parse-doc-tvar kids heir)
    (define vars (map rx-word-str! kids))
    (surf-tvars vars heir))
  (define (parse-letrec kids heir)
    (surf-letrec (map (parse-arm parse-val-sast) kids) heir))
  (define (handle-rune rune kids heir)
    (cond
      ((Eq "$" rune)
        (unless (Eq 1 (Sz kids))
          (error ("bad dollar form" val))
          (If (And (rx-word? (_0 kids)) (Eq "no-heir" heir))
            (parse-anon-variant (_0 kids))
            (parse-type-sast (_0 kids)))))
      ((Eq "\" rune)
        (surf-fun (map parse-type-sast kids) heir))
      ((Eq "%" rune)
        (uncurry-call (parse-val-sast (_0 kids)) heir))
      ((Eq "^" rune)
        (unless (Eq 1 (Sz kids))
          (error ("bad cast" val))
          (surf-cast (parse-type-sast (_0 kids)) heir)))
      ((Eq "&" rune)
        (surf-union (map parse-type-sast kids)))
      ((Eq "?" rune)
        (surf-case
          (parse-val-sast (_0 kids))
          (map (parse-arm parse-val-sast) (rx-juxt-flat (drop 1 kids)))
          heir))
      ((Eq "~" rune)
        (surf-self (map parse-val-sast kids)))
      ((Eq "=" rune)
        (parse-letrec kids heir))
      (else (error ("wack rune" val)))))
  (define (parse-body items)
    (define kids (hr-stem (rx-juxt-flat items)))
    (cond
      ((Eq 0 (Sz kids)) "no-heir")
      ((Eq 1 (Sz kids)) (parse-val-sast (_0 kids)))
      (else
        (let ((body (_0 kids))
              (hair (parse-body (drop 1 kids))))
          (cond
            ((rx-rune? "$" body) (handle-rune "$" (rx-rune-kids body) hair))
            ((rx-rune? "\" body) (handle-rune "\" (rx-rune-kids body) hair))
            ((rx-rune? "%" body) (handle-rune "%" (rx-rune-kids body) hair))
            ((rx-rune? "^" body) (handle-rune "^" (rx-rune-kids body) hair))
            ((rx-rune? "&" body) (handle-rune "&" (rx-rune-kids body) hair))
            ((rx-rune? "?" body) (handle-rune "?" (rx-rune-kids body) hair))
            ((rx-rune? "~" body) (handle-rune "~" (rx-rune-kids body) hair))
            ((rx-rune? "=" body) (handle-rune "=" (rx-rune-kids body) hair))
            ((And (rx-nest-is? "paren" "$" body) (Ne "no-heir" hair))
              (parse-doc-tvar (rx-nest-kids body) hair))
            ((And (rx-nest-is? "paren" "=" body) (Ne "no-heir" hair))
              (parse-letrec (rx-nest-kids body) hair))
            (else "no-heir"))))))
  (define (on-word wor)
    (cond
      ((str-numeric? wor) (surf-lit (parse-nat wor)))
      ;; variable lookup
      (else (surf-var wor))))
  (define (on-leaf lef)
    (cond
      ((rx-word? lef) (on-word (rx-word-str! lef)))
      ((rx-literal? lef) (surf-literal (rx-leaf-shape lef) (rx-leaf-str lef)))
      (else (error ("bad leaf val" lef)))))
  (define (on-paren nes)
    (define kids (map parse-val-sast (rx-nest-kids nes)))
    (cond
      ((Eq "" (rx-nest-rune nes))
        (unless (Gt (Sz kids) 0)
          (error ("bad empty call" nes))
          (surf-app (_0 kids) (drop 1 kids))))
      (else (handle-rune (rx-nest-rune nes) (rx-nest-kids nes) "no-heir"))))
  (define (on-clear nes)
    (define rune (rx-nest-rune nes))
    (define kids (rx-nest-kids nes))
    (cond
      ((Eq "" rune) (parse-body kids))
      ((Eq ":" rune) (parse-road kids))
      ((Eq "." rune) (parse-meth parse-val-sast kids))
      ((Eq ".#" rune)
        (surf-ufcs-put (_0 kids) (_1 kids)))
      ((Eq ".%" rune)
        (surf-ufcs-over (_0 kids) (_1 kids)))
      (else (handle-rune rune kids "no-heir"))))
  (define (on-nest nes)
    (cond
      ((Eq "clear" (rx-nest-color nes)) (on-clear nes))
      ((Eq "paren" (rx-nest-color nes)) (on-paren nes))
      ((And (Eq "brack" (rx-nest-color nes))
         (Eq "" (rx-nest-rune nes)))
        (surf-row (map parse-val-sast (rx-nest-kids nes))))
      (else (error "bad rex val nest" val))))
  (cond
    ((rx-nest? val) (on-nest val))
    ((rx-leaf? val) (on-leaf val))
    ((rx-juxt? val) (parse-body (rx-juxt-kids val)))
    (else (error ("weird node" val)))))

(define (split-decl-name items)
  (define idx (need (find-idx rx-word? items)))
  [(rx-word-str! (Ix idx items)) (drop (Inc idx) items)])

(define (parse-module-sast here val)
  (define span (rx-span val))
  ; A namespace module is either a flat stack of decls, a single decl, or a value.
  (define (on-dec-list here decs)
    (define (pop-next acc dec)
      (Weld acc (parse-module-sast here dec)))
    (foldl pop-next 0 (hr-stem (rx-juxt-flat decs))))

  (define (on-decl dec)
    (define e[name contents0] (split-decl-name (hr-stem (rx-rune-kids dec))))
    (define contents (hr-stem (rx-juxt-flat contents0)))
    (define split-idx
      (fall (Sz contents) (find-idx (rx-rune? "+") contents)))
    (define self (take split-idx contents))
    (define kids (drop split-idx contents))
    (define here1 (snoc name here))
    (define conspan (Ifz self (rx-span dec) (span-join-row self)))
    (define clause (parse-val-sast ["nest" conspan "clear" "" self]))
    (Weld [(surf-decl here1 span (surf-span conspan clause))]
      (on-dec-list here1 kids)))

  (cond
    ((rx-juxt? val)     (on-dec-list here (rx-juxt-kids val)))
    ((rx-rune? "+" val) (on-decl val))
    ((And (rx-rune? "" val) (Eq "clear" (rx-nest-color val)))
      (on-dec-list here (rx-nest-kids val)))
    (else (error ("wack module" val)))))
