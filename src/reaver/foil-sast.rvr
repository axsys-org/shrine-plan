
(#bind bst (#module bst))
(#import bst)
(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

;;; Rex helpers
(define rx-tag Ix0)
(define rx-span Ix1)
(define (rx? tag x) (Eq tag (rx-tag x)))
(define (rx-bad ctx want have)
  (error ("FAILED REX" ctx "expected" want "got" have)))

(define rx-leaf? (rx? "leaf"))
(define rx-leaf? (rx? "leaf"))
(define rx-open? (rx? "open"))
(define rx-expr? (rx? "expr"))
(define rx-pref? (rx? "pref"))
(define rx-tyte? (rx? "tyte"))
(define rx-heir? (rx? "heir"))

(define span-line (Ix 0))
(define span-col (Ix 1))
(define span-off (Ix 2))
(define span-len (Ix 3))

(define (span-end x)
  (Add (span-off x) (span-len x)))
(define set-span-line (Up 0))
(define set-span-col (Up 1))
(define set-span-off (Up 2))
(define set-span-len (Up 3))
(define (set-span-end end x)
  (set-span-len (Sub end (span-off x)) x))

(define (span-first x y)
  (If (Lt (span-off x) (span-off y))
    y x))
(define (span-last x y)
  (If (Lt (span-end x) (span-end y))
    x y))

(define (span-join x y)
  (define first (span-first x y))
  (define last (span-last x y))
  (set-span-end (span-end last) first))

(define (span-join-row rexs)
  (foldr1 span-join (map rx-span rexs)))
; data LeafShape = WORD | QUIP | CORD | TAPE | PAGE | SPAN | SLUG | BAD BadReason
; = LEAF Span LeafShape String
; | NEST Span Color String [Rex]           -- (x + y), {a | b}
; | EXPR Span Color [Rex]                  -- [f x], (x), ()
; | PREF Span String Rex                   -- :x, -y
; | TYTE Span String [Rex]                 -- x.y, a:b
; | BLOC Span Color String Rex [Rex]       -- head rune:\n  a\n  b
; | OPEN Span String [Rex]                 -- + x y (layout prefix)
; | JUXT Span [Rex]                        -- f(x), f(x)[1]
; | HEIR Span [Rex]                        -- + x\n+ y\nz
(define (rx-rune? rune x)
  (And (rx-open? x) (Eq rune (_2 x))))
(define rx-rune-kids (Ix 3))

(define rx-pref-sym (Ix 2))
(define rx-pref-kid (Ix 3))

(define (rx-tyte-rune? rune x)
  (And (rx-tyte? x) (Eq rune (_2 x))))
(define rx-leaf-str (Ix 3))

(define (rx-slug? x)
  (And (rx-leaf? x) (Eq "slug" (_2 x))))
(define (rx-word? x)
  (And (rx-leaf? x) (Eq "word" (_2 x))))

(define rx-heir-kids Ix2)

(define (rx-word-str! x)
  assert(rx-word? x)
  (Ix 3 x))
(define (rx-get-word x)
  (_3 x))
(define (rx-brack? color x)
  (Eq (_2 x) color))


(define rx-expr-kids (Ix 3))
(define rx-tyte-kids (Ix 3))

(define (rx-heir-flat xs)
  (define (f acc arg)
    (Weld acc
    (If (rx-heir? arg)
      (rx-heir-kids arg)
      [arg])))
  (foldl f 0 xs))

(define (surf-ref ref)
  assert(Gt (Sz ref) 0)
  ["s_ref" ref])
(define surf-ref-val (Ix 1))
(define (surf-lit lit)
  ["s_lit" lit])
(define surf-lit-val (Ix 1))
(define surf-ref-path (Ix 1))
(define (surf-var v)
  assert(IsNat v)
  ["s_var" v])
(define (surf-typ-mode x
  ["s_typ"]))

(define (surf-arm pat val)
  ["s_arm" pat val])
(define surf-arm-pat (Ix 1))
(define surf-arm-val (Ix 2))

(define (surf-self args) ["s_self" args])

(define (surf-tvar var body)
  assert(IsNat var)
  ["s_tvar" var body])

(define (surf-cast ty body)
  ["s_cast" ty body])
(define surf-cast-ty (Ix 1))
(define (surf-union opts)
  ["s_union" opts])
(define surf-union-opts (Ix 1))
(define (surf-case scrut arms fall)
  ["s_case" scrut arms fall])


;;  (f x y z)
(define (surf-app f x) ["s_app" f x])
;;; (f x y z) in type mode
(define (surf-tapp args) ["s_tapp" args])
(define surf-tapp-kids (Ix 1))
;; x=nat
(define (surf-face face ty) ["s_face" face ty])
(define surf-face-name (Ix 1))
(define surf-face-kid (Ix 2))

;; [3 4]
(define (surf-row row) ["s_row" row])
(define surf-row-kids (Ix 1))
;; [x=nat y=nat]
(define (surf-trow row) ["s_trow" row])
(define (surf-sum vars) ["s_sum" vars])

;; $foo in [$foo bar]
(define (surf-variant tag)
  ["s_variant" tag])

(define (surf-fun args ret)
  ["s_fun" args ret])
(define surf-fun-args (Ix 1))
(define surf-fun-ret (Ix 2))
(define (surf-meth args)
  ["s_meth" args])

(define surf-hole ["s_hole"])


;;; end shared
(define (surf-mod decls)
  ["s_mod" decls])

  ;; span is total span for entire submodule range (i.e. z care)
;; annotate with surf-span on clause for specific name
(define (surf-decl name span clause)
  ["s_decl" name span clause])

(define (surf-span span val)
  ["s_span" span val])

(define (surf-doc text kids)
  ["s_doc" text kids])

; (define (surf-tyvar ))

(define (split-once f x)
  (define (go acc r[x xs])
    (Ifz r [(rowify (lflop acc)) 0]
    (If (f x)
      [(rowify (lflop acc)) (rowify r)]
      (go (lcons x acc) xs))))
  (go 0 (stream x)))

;; a heir node implies a rune poem + possible children
;; accumulate until we see a new decl, return [self kids]
(define (split-heir xs)
  (split-once (lambda (x) (or (Eq (_0 x) "open") (Eq (_0 x) "heir"))) xs))

(define is-comment rx-slug?)
(define (not-comment x) (Nil (rx-slug? x)))
;;
;; (row rex-node) -> (row rex-node)
;; filtering all
(define (hr-stem xs)
  (filter not-comment xs))
;; get first real node of stem
(define (hr-herb xs) (_0 (hr-stem xs)))
(define (parse-road els)
  (surf-ref (map rx-word-str! els)))
(define (parse-meth els)
  (surf-meth (map rx-word-str! els)))
(define (parse-anon-variant x)
  assert(rx-word? x)
  (surf-variant (rx-leaf-str x)))

(define (parse-type-sast ty)
  (define (on-expr exp)
    (define (is-color col) (rx-brack? col exp))
    (define kids (map parse-type-sast (rx-expr-kids exp)))
    (cond
      ((is-color "brack") (surf-trow kids)) ;; [x y]
      ((is-color "paren") (surf-tapp kids)) ;; (f x y)
      (else (error ("bad type expr" exp)))))
  (define (on-leaf lef)
    (cond
      ((rx-word? lef) (surf-ref [(rx-leaf-str lef)])) ;; local
      (else (error ("bad leaf" lef)))))
  ;; foo=bar
  (define (on-face kids)
    assert(Eq 2 (Sz kids))
    (surf-face (rx-word-str! (_0 kids)) (parse-type-sast (_1 kids))))
  (define (on-tyte tyt)
    (define kids (rx-tyte-kids tyt))
    (cond
      ;; global ref
      ((rx-tyte-rune? ":" tyt) (parse-road kids))
      ((rx-tyte-rune? "=" tyt) (on-face kids))
      (else (error ("bad tyte" tyt)))))
  (define (on-pref pre)
    assert(Eq "$" (rx-pref-sym pre))
    (parse-anon-variant (rx-pref-kid pre)))
  (cond
    ((rx-tyte? ty) (on-tyte ty))
    ((rx-leaf? ty) (on-leaf ty))
    ((rx-expr? ty) (on-expr ty))
    ((rx-pref? ty) (on-pref ty))
    (else ("bad type rex" ty))))

(define (test-type-parse x)
  (parse-type-sast (ParseRex x)))

  (print "a")
assert(Equal (test-type-parse "foo:bar:baz") (surf-ref ["foo" "bar" "baz"]))
  (print "b")
assert(Equal (test-type-parse "baz") (surf-ref ["baz"]))
  (print "c")
assert(Equal (test-type-parse "foo=bar") (surf-face "foo" (surf-ref ["bar"])))
(print (test-type-parse "(foo bar)"))
assert(Equal (test-type-parse "(foo bar)") (surf-tapp [(surf-ref ["foo"]) (surf-ref
  ["bar"])]))
assert(Equal (test-type-parse "[foo bar]") (surf-trow [(surf-ref ["foo"]) (surf-ref
  ["bar"])]))

(define (uncurry-call call rest)
  (print ("uncurry-call" call))
  (print ("uncurry-rest" rest))
  (define ret (If
    (Eq "s_app" (_0 call))
    (snap 2 (lambda (x) (Weld x [rest])) call)
    (surf-app call rest)))
    (print ("uncurry-ret" ret))
    ret)

(define (parse-arm cont rex)
  assert(And (rx-open? rex) (rx-rune? ">" rex))
  (define kids (rx-rune-kids rex))
  (surf-arm (parse-type-sast (_0 kids)) (cont (_1 kids))))




(define (handle-rune cont)
  (define (buc kids heir)
    assert(Eq 1 (Sz kids))
    (parse-type-sast (_0 kids)))
  (define (bar kids heir)
    (surf-fun (map parse-type-sast kids) heir))
  (define (cen kids heir)
    (uncurry-call (cont (_0 kids)) heir))
  (define (ket kids heir)
    assert(Eq 1 (Sz kids))
    (surf-cast (parse-type-sast (_0 kids)) heir))
  (define (pam kids heir)
    (surf-union (map parse-type-sast kids)))
  (define (wut kids heir)
    (surf-case
      (cont (_0 kids))
      (map (parse-arm cont) (rx-heir-flat (drop 1 kids)))
      heir))
  (define (sig kids heir)
    (surf-self (map cont kids)))
  [buc bar cen ket pam wut sig])

(define (parse-val-sast val)
  (define (on-expr e)
    (define (is-color col) (rx-brack? col e))
    (define fst-is-rune? (rx-rune? (_0 (rx-expr-kids e))))
    (define kids (map parse-val-sast (rx-expr-kids e)))
    (define ret (cond
      ;;;
      ((And (Eq 1 (Sz kids)) fst-is-rune?) (_0 kids))
      ;; (f x y)
      ((is-color "paren") (surf-app (_0 kids) (drop 1 kids)))
      ;; [x y]
      ((is-color "brack") (surf-row kids))
      (else (error "bad rex val expr" val))))
    ret)
  (define (on-word wor)
    (cond
      ((str-numeric? wor) (surf-lit (parse-nat wor)))
      ;; variable lookup
      (else (surf-var wor))))
  (define (on-leaf lef)
    (cond
      ((rx-word? lef) (on-word (rx-word-str! lef)))
      (else (error ("bad leaf val" lef)))))
  (define (on-pref pre)
    (define (sym-is x) (Eq x (rx-pref-sym pre)))
    (cond
      ((sym-is "$") (parse-anon-variant (rx-pref-kid pre)))
      (else (error ("wack pref" pre)))))
  (define (on-heir items[body])
    (define table[buc bar cen ket pam wut sig] (handle-rune parse-val-sast))
    (define (is-rune x) (rx-rune? x body))
    (define hair (on-heir (drop 1 items)))
    (define kids (rx-rune-kids body))
    (cond
      ((is-rune "$") (buc kids hair))
      ((is-rune "\") (bar kids hair))
      ((is-rune "%") (cen kids hair))
      ((is-rune "^") (ket kids hair))
      ((is-rune "&") (pam kids hair))
      ((is-rune "?") (wut kids hair))
      ((is-rune "~") (sig kids hair))
      ((Eq 1 (Sz items))
        (parse-val-sast (_0 items)))
      (else "no-heir")))
  (define (on-tyte val)
    (define kids (rx-tyte-kids val))
    (cond
      ((rx-tyte-rune? ":" val) (parse-road kids))
      ((rx-tyte-rune? "." val) (parse-meth kids))
      (else (error "wack tyte" val))))
  (define (on-open open)
    ;(define (is-rune ))
    (define table[buc bar cen ket pam wut sig] (handle-rune parse-val-sast))
    (define (is-rune x) (rx-rune? x open))
    (define kids (rx-rune-kids open))
    (cond
      ((is-rune "$") (buc kids 0))
      ((is-rune "\") (bar kids 0))
      ((is-rune "%") (cen kids 0))
      ((is-rune "^") (ket kids 0))
      ((is-rune "&") (pam kids 0))
      ((is-rune "?") (wut kids 0))
      ((is-rune "~") (sig kids 0))
      (else ("wack rune" open))))
  ;(print ("val" val))
  (cond
    ;;((rx-rune? "+" val) (on-decl (rx-rune-kids val)))
    ((rx-open? val)     (on-open val))
    ((rx-expr? val)     (on-expr val))
    ((rx-tyte? val)     (on-tyte val))
    ((rx-leaf? val)     (on-leaf val))
    ((rx-pref? val)     (on-pref val))
    ((rx-heir? val)     (on-heir (rx-heir-kids val)))
    (else (error ("weird node" val)))))

