;;;; Compile local Foil DSL source through the production publication pipeline.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind foil (#module foil-new-env))
(#bind publication (#module foil-publication))
(#bind context (#module foil-context))
(#bind subject (#module foil-subject))
(#bind bootstrap (#module foil-bootstrap))
(#bind lower (#module contract-lower))
(define compiler (Pin "contract-compiler/0"))
(define system-plan (publication:prepare-system compiler source:read-module bootstrap:system-roots))
(define system-code (publication:compile system-plan foil:empty-foil-cache))
(define system (context:publication-key (publication:compilation-context system-plan)))
(define (load name)
  (define images (_2 system-code))
  (define (resolve mod)
    (define hit (find (lambda (p) (Equal mod (_0 p))) images))
    (If hit (_0 (subject:sut-context (foil:perc-subject (Unpin (_1 (_0 hit))))))
      [["x" 17] ["ts" "contracts"] ["ts" mod]]))
  (define plan (source:prepare-publication system compiler resolve images
    (lambda (path) 0) (Weld [name] (map _0 images))))
  (define built (source:compile (publication:compilation-context plan) foil:empty-foil-cache name))
  (foil:perc-subject (_1 built)))
(define (compile name)
  (lower:lower (foil:source-entry-val ["program"] (load name))))
