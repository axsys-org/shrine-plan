;;;; Prepare file and generated test dependencies before assigning moments.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))
(#bind schemagen (#module schemagen))
(#bind fixture (#module foil-test-context))
(#bind publication (#module foil-publication))

(define generated-names ["open_router_api" "open_router_api_hand"])
(define (generated? name) (any (Equal name) generated-names))
(define app-test-imports
  [["test_chat_app" "apps/chat/main"]
   ["test_life_app" "apps/life/main"]
   ["test_loom_app" "apps/loom/main"]
   ["test_nenex_app" "apps/nenex/main"]])

(define (client-trees cache)
  (define json-module (source:compile (fixture:files cache ["json"]) cache "json"))
  (define schema (schemagen:sg-schema-value (_1 json-module)
    (read-text-file "spec/openrouter.json")))
  (define parts (schemagen:sg-spec-parts schema
    ["get_models" "send_chat_completion_request"]))
  (define types (schemagen:sg-swagger-types-tree parts))
  (define hand (schemagen:sg-swagger-hand-tree parts))
  [[(_0 parts) (_1 types)] hand])

;; Return the prepared publication, including its frozen generated Rex.
(define (prepare cache mods)
  (define closure (source:module-closure mods))
  (define apps (filter (lambda (pair) (includes (Equal (_0 pair)) closure))
    app-test-imports))
  (define expanded (source:module-closure (Weld mods (map _1 apps))))
  (define trees (Weld
    (If (any generated? expanded) (client-trees cache) [])
    (map (lambda (pair) [(_0 pair) (source:import-tree (_1 pair))]) apps)))
  (define (read name)
    (define found (find (lambda (pair) (Equal name (_0 pair))) trees))
    (If found (_1 (_0 found)) (source:read-module name)))
  (fixture:prepare read cache mods))
(define module-file-stamps ["spec/openrouter.json"])
(#export prepare generated? module-file-stamps)
