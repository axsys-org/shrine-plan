;;;; Generated dependencies shared by corpus staging and focused Foil tests.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))
(#bind json (#module lain-json))
(#bind wire-json (#module wire-json))
(#bind schemagen (#module schemagen))
(define (generated-client cache)
  (define parsed (json:parse (read-text-file "spec/openrouter.json")))
  (If (wire-json:jok? parsed) 0 (error "invalid OpenRouter test schema"))
  (define parts (schemagen:sg-spec-parts (wire-json:jval parsed)
    ["get_models" "send_chat_completion_request"]))
  (define types (schemagen:sg-swagger-types-tree parts))
  (define c1 (source:compile-rex cache (_0 parts) (_1 types)))
  (define hand (schemagen:sg-swagger-hand-tree parts))
  (_0 (source:compile-rex (_0 c1) (_0 hand) (_1 hand))))

;; Chat imports tree-fed modules that have no source file. Use the same
;; schema generator directly, including for tests importing chat.
(define generated-names ["open_router_api" "open_router_api_hand"])

(define (generated? name)
  (any (Equal name) generated-names))

(define (prepare-generated cache mods)
  (define needed (any generated? (source:module-closure mods)))
  (define present
    (all (lambda (name) (foil:get-foil-cache name cache))
      generated-names))
  (If (And needed (If present 0 1))
    (generated-client cache)
    cache))

;; Test aliases are real generated import modules. Their Perc records the
;; defining app as a dependency without cloning or relabeling its subject.
(define app-test-imports
  [["test_chat_app" "apps/chat/main"]
   ["test_life_app" "apps/life/main"]
   ["test_loom_app" "apps/loom/main"]
   ["test_nenex_app" "apps/nenex/main"]])

(define (prepare cache mods)
  (define closure (source:module-closure mods))
  (define apps (filter (lambda (pair) (includes (Equal (_0 pair)) closure))
                 app-test-imports))
  (define ready (prepare-generated cache (Weld mods (map _1 apps))))
  (define (install cache pair)
    (If (foil:get-foil-cache (_0 pair) cache)
      cache
      (_0 (source:compile-rex cache (_0 pair) (source:import-tree (_1 pair))))))
  (foldl install ready apps))

(define module-file-stamps ["spec/openrouter.json"])
(#export prepare generated? module-file-stamps)
