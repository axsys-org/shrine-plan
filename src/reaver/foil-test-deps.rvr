;;;; Generated dependencies shared by corpus staging and focused Foil tests.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind llm (#module helm-llm))

;; Chat imports tree-fed modules that have no source file. Use the same
;; generator as production boot, including for tests importing chat.
(define generated-names ["open_router_api" "open_router_api_hand"])

(define (generated? name)
  (any (Equal name) generated-names))

(define (prepare-generated cache mods)
  (define needed (any generated? (foil:module-closure mods)))
  (define present
    (all (lambda (name) (any (lambda (entry) (Equal name (_0 entry)))
                         cache))
      generated-names))
  (If (And needed (If present 0 1))
    (_0 (llm:llm-client-cache cache))
    cache))

;; App tests import a test-only alias of the real app's compiled subject.
;; Foil import words cannot contain slashes; no app code is copied or changed.
(define app-test-imports
  [["test_chat_app" "apps/chat/main"]
   ["test_life_app" "apps/life/main"]
   ["test_loom_app" "apps/loom/main"]
   ["test_nenex_app" "apps/nenex/main"]])

(define (prepare cache mods)
  (define closure (foil:module-closure mods))
  (define apps (filter (lambda (pair) (includes (Equal (_0 pair)) closure))
                 app-test-imports))
  (define ready (prepare-generated cache (Weld mods (map _1 apps))))
  (define (install cache pair)
    (define result (foil:compile-mod-cached cache foil:default-subject (_1 pair)))
    (define entry (_0 (find (lambda (e) (Equal (_1 pair) (_0 e))) (_0 result))))
    (If (any (lambda (e) (Equal (_0 pair) (_0 e))) cache)
      cache
      (snoc (foil:cache-entry (_0 pair) (_1 entry) (Ix 3 entry) (Ix 4 entry))
        (_0 result))))
  (foldl install ready apps))

(define module-file-stamps ["spec/openrouter.json"])
(#export prepare generated? module-file-stamps)
