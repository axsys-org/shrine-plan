;;; Built-in Foil environment ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define if-ty
  (core:quantify ["a"] (nt:tfun [(nt:tnat 0) (nt:type-var "a") (nt:type-var "a")] (nt:type-var "a"))))
(define unary-nat-ty (nt:tfun [(nt:tnat 0)] (nt:tnat 0)))
(define save-ty
  (core:quantify ["a"]
    (nt:tfun [(nt:tpin (nt:type-var "a"))] (nt:tnat 0))))
(define spawn-ty
  (core:quantify ["a"]
    (nt:tfun [(nt:tfun [(nt:tnat 0)] (nt:type-var "a"))] (nt:tnat 0))))
(define send-ty (nt:tfun [(nt:tnat 0) nt:tany] (nt:tnat 0)))
(define send-caps-ty
  (nt:tfun [(nt:tnat 0) nt:tany (row-of (nt:tnat 0))] (nt:tnat 0)))
(define recv-ty
  (core:quantify ["message"]
    (nt:tfun [(nt:tnat 0)]
      (nt:trow 0 [(nt:trow-item "message" (nt:type-var "message"))
                  (nt:trow-item "caps" (row-of (nt:tnat 0)))]))))

;; Native I/O keeps byte bars as nats (including their sentinel byte).
;; Only the numeric result tags of Try and Fetch are adapted to either.
(define try-ty
  (core:quantify ["input" "value"]
    (nt:tfun [(nt:tfun [(nt:type-var "input")] (nt:type-var "value"))
              (nt:type-var "input")]
      (either-of nt:tany (nt:type-var "value")))))
(define sequence-ty
  (core:quantify ["value"]
    (nt:tfun [nt:tany (nt:type-var "value")] (nt:type-var "value"))))
(define path-io-ty (nt:tfun [(nt:type-ref ["str"])] (nt:tnat 0)))
(define write-file-ty
  (nt:tfun [(nt:type-ref ["str"]) (nt:tnat 0)] (nt:tnat 0)))
(define connect-ty
  (nt:tfun [(nt:tnat 0) (nt:type-ref ["str"]) (nt:tnat 0)] (nt:tnat 0)))
(define folder-ty
  (nt:tfun [(nt:type-ref ["str"])]
    (row-of (nt:trow 0 [(nt:trow-item "directory" (nt:tnat 0))
                        (nt:trow-item "name" (nt:type-ref ["str"]))]))))
(define fetch-headers-ty
  (row-of (nt:trow 0 [(nt:trow-item "name" (nt:tnat 0))
                      (nt:trow-item "value" (nt:tnat 0))])))
(define fetch-response-ty
  (nt:trow 0 [(nt:trow-item "status" (nt:tnat 0))
              (nt:trow-item "url" (nt:tnat 0))
              (nt:trow-item "headers" fetch-headers-ty)
              (nt:trow-item "body" (nt:tnat 0))]))
(define fetch-ty
  (nt:tfun
    [(nt:trow 0 [(nt:trow-item "method" (nt:tnat 0))
                 (nt:trow-item "url" (nt:tnat 0))
                 (nt:trow-item "headers" fetch-headers-ty)
                 (nt:trow-item "body" (row-of (nt:tnat 0)))])
     (nt:trow 0 [(nt:trow-item "connect" (row-of (nt:tnat 0)))
                 (nt:trow-item "deadline" (nt:tnat 0))
                 (nt:trow-item "redirects" (nt:tnat 0))
                 (nt:trow-item "buffer" (row-of (nt:tnat 0)))])]
    (either-of (nt:tnat 0) fetch-response-ty)))
(define binary-nat-ty (nt:tfun [(nt:tnat 0) (nt:tnat 0)] (nt:tnat 0)))
(define ternary-nat-ty
  (nt:tfun [(nt:tnat 0) (nt:tnat 0) (nt:tnat 0)] (nt:tnat 0)))
(define eq-ty (nt:tfun [nt:tany nt:tany] (nt:tnat 0)))
(define equal-ty
  (core:quantify ["a"]
    (nt:tfun [(nt:type-var "a") (nt:type-var "a")] (nt:tnat 0))))
(define unary-uint-ty (nt:tfun [uint-ty] uint-ty))
(define binary-uint-ty (nt:tfun [uint-ty uint-ty] uint-ty))
(define cmp-uint-ty (nt:tfun [uint-ty uint-ty] uint-ty))
(define iota-cmp-ty (nt:tfun [iota-ty iota-ty] bool-ty))
(define iota-show-ty (nt:tfun [iota-ty] (nt:tnat 0)))
;; Raw-rep primitives for generic value walkers (the explorer's
;; reflection-driven renderer): read a value's branded head, arity,
;; and fields without a statically known type.
(define rep-nat-ty (nt:tfun [nt:tany] (nt:tnat 0)))
;; CordTree primitives (see str-text &c below): trees are opaque anys.
(define quaternary-nat-ty
  (nt:tfun [(nt:tnat 0) (nt:tnat 0) (nt:tnat 0) (nt:tnat 0)]
    (nt:tnat 0)))
(define scan8-ty
  (nt:tfun [(nt:tnat 0) (nt:tnat 0) (nt:tnat 0) (nt:tnat 0)]
    (row-of (nt:tnat 0))))
(define str-text-ty (nt:tfun [(nt:tnat 0)] nt:tany))
(define cord-tree-slice-ty
