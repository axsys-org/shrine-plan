(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))

(#bind core (#module foil-core-types))
(#import core)

(#bind typed-reaver (#module typed-reaver))
(#import typed-reaver)

;;; Built-in Foil environment ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define if-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TNAT 0) (ty:TVAR "a") (ty:TVAR "a")] (ty:TVAR "a"))))
(define pin-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TVAR "a")] (ty:TPIN (ty:TVAR "a")))))
(define unpin-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TPIN (ty:TVAR "a"))] (ty:TVAR "a"))))

(define unary-nat-ty (ty:TFUN [(ty:TNAT NONE)] (ty:TNAT NONE)))
(define binary-nat-ty (ty:TFUN [(ty:TNAT NONE) (ty:TNAT NONE)] (ty:TNAT NONE)))
(define eq-ty (ty:TFUN [ty:TANY ty:TANY] (ty:TNAT NONE)))
(define equal-ty
  (ty:TQUA "a"
    (ty:TFUN [(ty:TVAR "a") (ty:TVAR "a")] (ty:TNAT NONE))))
(define unary-uint-ty (ty:TFUN [uint-ty] uint-ty))
(define binary-uint-ty (ty:TFUN [uint-ty uint-ty] uint-ty))
(define cmp-uint-ty (ty:TFUN [uint-ty uint-ty] uint-ty))

(define row-size-ty
  (ty:TQUA "a" (ty:TFUN [(row-of (ty:TVAR "a"))] uint-ty)))
(define row-get-ty
  (ty:TQUA "a" (ty:TFUN [uint-ty (row-of (ty:TVAR "a"))] (ty:TVAR "a"))))
(define row-take-ty
  (ty:TQUA "a" (ty:TFUN [uint-ty (row-of (ty:TVAR "a"))] (row-of (ty:TVAR "a")))))
(define row-weld-ty
  (ty:TQUA "a" (ty:TFUN [(row-of (ty:TVAR "a")) (row-of (ty:TVAR "a"))] (row-of (ty:TVAR "a")))))
(define row-cons-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TVAR "a") (row-of (ty:TVAR "a"))] (row-of (ty:TVAR "a")))))
(define row-map-ty
  (ty:TQUA "a"
    (ty:TQUA "b"
      (ty:TFUN [(ty:TFUN [(ty:TVAR "a")] (ty:TVAR "b")) (row-of (ty:TVAR "a"))]
        (row-of (ty:TVAR "b"))))))
(define row-filter-ty
  (ty:TQUA "a"
    (ty:TFUN [(ty:TFUN [(ty:TVAR "a")] (ty:TNAT NONE)) (row-of (ty:TVAR "a"))]
      (row-of (ty:TVAR "a")))))
(define row-fold-ty
  (ty:TQUA "a"
    (ty:TQUA "b"
      (ty:TFUN [(ty:TFUN [(ty:TVAR "b") (ty:TVAR "a")] (ty:TVAR "b"))
                (ty:TVAR "b")
                (row-of (ty:TVAR "a"))]
        (ty:TVAR "b")))))
(define row-find-ty
  (ty:TQUA "a"
    (ty:TFUN [(ty:TFUN [(ty:TVAR "a")] (ty:TNAT NONE))
              (ty:TVAR "a")
              (row-of (ty:TVAR "a"))]
      (ty:TVAR "a"))))
(define row-rev-ty
  (ty:TQUA "a" (ty:TFUN [(row-of (ty:TVAR "a"))] (row-of (ty:TVAR "a")))))
(define row-pred-ty
  (ty:TQUA "a"
    (ty:TFUN [(ty:TFUN [(ty:TVAR "a")] (ty:TNAT NONE)) (row-of (ty:TVAR "a"))]
      (ty:TNAT NONE))))

(define list-nil-ty
  (ty:TQUA "a" (list-of (ty:TVAR "a"))))
(define list-cons-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TVAR "a") (list-of (ty:TVAR "a"))] (list-of (ty:TVAR "a")))))
(define list-head-ty
  (ty:TQUA "a" (ty:TFUN [(list-of (ty:TVAR "a"))] (ty:TVAR "a"))))
(define list-tail-ty
  (ty:TQUA "a" (ty:TFUN [(list-of (ty:TVAR "a"))] (list-of (ty:TVAR "a")))))
(define list-test-ty
  (ty:TQUA "a" (ty:TFUN [(list-of (ty:TVAR "a"))] uint-ty)))
(define list-map-ty
  (ty:TQUA "a"
    (ty:TQUA "b"
      (ty:TFUN [(ty:TFUN [(ty:TVAR "a")] (ty:TVAR "b")) (list-of (ty:TVAR "a"))]
        (list-of (ty:TVAR "b"))))))

(define either-left-ty
  (ty:TQUA "a" (ty:TQUA "b"
    (ty:TFUN [(ty:TVAR "a")] (either-of (ty:TVAR "a") (ty:TVAR "b"))))))
(define either-right-ty
  (ty:TQUA "a" (ty:TQUA "b"
    (ty:TFUN [(ty:TVAR "b")] (either-of (ty:TVAR "a") (ty:TVAR "b"))))))
(define either-test-ty
  (ty:TQUA "a" (ty:TQUA "b"
    (ty:TFUN [(either-of (ty:TVAR "a") (ty:TVAR "b"))] uint-ty))))
(define either-left-val-ty
  (ty:TQUA "a" (ty:TQUA "b"
    (ty:TFUN [(either-of (ty:TVAR "a") (ty:TVAR "b"))] (ty:TVAR "a")))))
(define either-right-val-ty
  (ty:TQUA "a" (ty:TQUA "b"
    (ty:TFUN [(either-of (ty:TVAR "a") (ty:TVAR "b"))] (ty:TVAR "b")))))

(define/typed typed-add (-> (Nat Nat) Nat) Add)
(define/typed typed-pin (All (a) (-> (a) (Pin a))) Pin)
(define/typed typed-unpin (All (a) (-> ((Pin a)) a)) Unpin)

(define/typed (uint-add-m y x) (-> (UInt UInt) UInt) (Add x y))
(define (uint-sub-m y x) (Sub x y))
(define (uint-mul-m y x) (Mul x y))
(define (uint-div-m y x) (Div x y))
(define (uint-mod-m y x) (Mod x y))
(define (uint-eq-m y x) (Eq x y))
(define (uint-lt-m y x) (Lt x y))
(define (uint-le-m y x) (Le x y))
(define (uint-ge-m y x) (Ge x y))
(define (uint-gt-m y x) (Gt x y))

(define (row-size xs) (Sz xs))
(define (row-get idx xs) (Ix idx xs))
(define (row-weld ys xs) (weld xs ys))
(define (row-cons x xs) (cons x xs))
(define (row-snoc x xs) (snoc x xs))
(define (row-take n xs) (take n xs))
(define (row-drop n xs) (drop n xs))
(define/typed (row-map f xs)
  (All (a b) (-> ((-> (a) b) (Row a)) (Row b)))
  (map f xs))
(define (row-filter f xs) (filter f xs))
(define (row-fold f z xs) (foldl f z xs))
(define (row-find f def xs)
  (define hit (find f xs))
  (Ifz hit def (_0 hit)))
(define (row-rev xs) (rev xs))
(define (row-any f xs) (any f xs))
(define (row-all f xs) (all f xs))

(define list-nil "nil")
(define (list-cons x xs) ("cons" x xs))
(define (list-is-nil xs) (Eq list-nil xs))
(define (list-is-cons xs) (And (IsApp xs) (Eq "cons" (Hd xs))))
(define (list-head xs) (_0 xs))
(define (list-tail xs) (_1 xs))
(define (list-map f xs)
  (If (list-is-nil xs)
    list-nil
    (list-cons (f (_0 xs)) (list-map f (_1 xs)))))

(define (either-left x) ("left" x))
(define (either-right x) ("right" x))
(define (either-is-left x) (And (IsApp x) (Eq "left" (Hd x))))
(define (either-is-right x) (And (IsApp x) (Eq "right" (Hd x))))
(define (either-left-val x) (_0 x))
(define (either-right-val x) (_0 x))

(define typed-foil-api
  (provide/foil
    (typed-add (foil add))
    (typed-pin (foil pin))
    (typed-unpin (foil unpin))
    (uint-add-m (foil uint add))
    (row-map (foil row map))))


(define (insert-uint-methods prefix sut)
  (pipe sut
    (insert-ffi (Weld prefix ["sub"]) uint-sub-m binary-uint-ty)
    (insert-ffi (Weld prefix ["mul"]) uint-mul-m binary-uint-ty)
    (insert-ffi (Weld prefix ["div"]) uint-div-m binary-uint-ty)
    (insert-ffi (Weld prefix ["mod"]) uint-mod-m binary-uint-ty)
    (insert-ffi (Weld prefix ["inc"]) Inc unary-uint-ty)
    (insert-ffi (Weld prefix ["bex"]) Bex unary-uint-ty)
    (insert-ffi (Weld prefix ["dec"]) Dec unary-uint-ty)
    (insert-ffi (Weld prefix ["eq"]) uint-eq-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["lt"]) uint-lt-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["le"]) uint-le-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["ge"]) uint-ge-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["gt"]) uint-gt-m cmp-uint-ty)))

(define legacy-subject
  (pipe (set-sut-root boot-root empty-subject)
    ;; pipe applies bottom-up: these aliases run LAST, over the full
    ;; subject below.
    (install-core-types)
    (insert-ffi ["if"] If if-ty)
    (insert-ffi ["eq"] Eq eq-ty)
    ;; PLAN Eq is intentionally shallow on structured values.  Namespace
    ;; version deduplication needs extensional equality of whole myths, so
    ;; expose the runtime's forcing structural comparison separately.
    (insert-ffi ["equal"] Equal equal-ty)
    (insert-ffi ["sub"] Sub binary-nat-ty)
    (insert-ffi ["lt"] Lt binary-nat-ty)
    (insert-ffi ["le"] Le binary-nat-ty)
    (insert-ffi ["ge"] Ge binary-nat-ty)
    (insert-ffi ["gt"] Gt binary-nat-ty)
    (insert-ffi ["inc"] Inc unary-nat-ty)
    (insert-ffi ["bex"] Bex unary-nat-ty)
    (insert-ffi ["get_bit"] Test binary-nat-ty)
    (insert-ffi ["set_bit"] Set binary-nat-ty)
    (insert-ffi ["clear_bit"] Clear binary-nat-ty)
    (insert-ffi ["mul"] Mul binary-nat-ty)
    (insert-ffi ["div"] Div binary-nat-ty)
    (insert-ffi ["mod"] Mod binary-nat-ty)
    (insert-ffi ["dec"] Dec unary-nat-ty)
    ;; native byte-width and shifts: cord code (weft &c) would
    ;; otherwise recount lengths and rebuild 256^n by repeated
    ;; division/multiplication — quadratic per append
    (insert-ffi ["wid"] Bytes unary-nat-ty)
    (insert-ffi ["lsh"] Lsh binary-nat-ty)
    (insert-ffi ["rsh"] Rsh binary-nat-ty)
    (insert-ffi ["nat" "add"] uint-add-m binary-uint-ty)
    (insert-uint-methods ["nat"])
    (insert-uint-methods ["uint"])
    (insert-ffi ["unit" "unit"] unit-cstr unit-ty)
    (insert-ffi ["row" "size"] row-size row-size-ty)
    (insert-ffi ["row" "len"] row-size row-size-ty)
    (insert-ffi ["row" "get"] row-get row-get-ty)
    (insert-ffi ["row" "at"] row-get row-get-ty)
    (insert-ffi ["row" "take"] row-take row-take-ty)
    (insert-ffi ["row" "drop"] row-drop row-take-ty)
    (insert-ffi ["row" "weld"] row-weld row-weld-ty)
    (insert-ffi ["row" "append"] row-weld row-weld-ty)
    (insert-ffi ["row" "cons"] row-cons row-cons-ty)
    (insert-ffi ["row" "snoc"] row-snoc row-cons-ty)
    (insert-ffi ["row" "filter"] row-filter row-filter-ty)
    (insert-ffi ["row" "fold"] row-fold row-fold-ty)
    (insert-ffi ["row" "find"] row-find row-find-ty)
    (insert-ffi ["row" "rev"] row-rev row-rev-ty)
    (insert-ffi ["row" "any"] row-any row-pred-ty)
    (insert-ffi ["row" "all"] row-all row-pred-ty)
    (insert-ffi ["nil"] list-nil list-nil-ty)
    (insert-ffi ["cons"] list-cons list-cons-ty)
    (insert-ffi ["list" "nil"] list-nil list-nil-ty)
    (insert-ffi ["list" "cons"] list-cons list-cons-ty)
    (insert-ffi ["list" "head"] list-head list-head-ty)
    (insert-ffi ["list" "tail"] list-tail list-tail-ty)
    (insert-ffi ["list" "is_nil"] list-is-nil list-test-ty)
    (insert-ffi ["list" "is_cons"] list-is-cons list-test-ty)
    (insert-ffi ["list" "map"] list-map list-map-ty)
    (insert-ffi ["left"] either-left either-left-ty)
    (insert-ffi ["right"] either-right either-right-ty)
    (insert-ffi ["either" "left"] either-left either-left-ty)
    (insert-ffi ["either" "right"] either-right either-right-ty)
    (insert-ffi ["either" "is_left"] either-is-left either-test-ty)
    (insert-ffi ["either" "is_right"] either-is-right either-test-ty)
    (insert-ffi ["either" "left_val"] either-left-val either-left-val-ty)
    (insert-ffi ["either" "right_val"] either-right-val either-right-val-ty)))

;; Raw install: the provide/foil boundary wrappers shape-check every
;; argument and the result on EVERY CALL (~100µs each through
;; ty:type-shape-fits) — ruinous for pin/unpin/add, which the shrine
;; kernel hits on every namespace-tree edge.  define/typed already
;; checked the definitions statically; the boundary contract is a
;; debugging aid, re-enable by swapping back to install-foil-provides.
(define default-subject
  (install-foil-provides-raw typed-foil-api legacy-subject))
