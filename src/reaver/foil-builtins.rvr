(define cord-tree-cat-ty (nt:tfun [nt:tany nt:tany] nt:tany))
(define str-repeat-ty (nt:tfun [(nt:tnat 0) (nt:tnat 0)] nt:tany))
(define str-run-ty (nt:tfun [nt:tany] (nt:tnat 0)))
(define rep-ix-ty (nt:tfun [(nt:tnat 0) nt:tany] nt:tany))
(define rep-unpin-ty (nt:tfun [nt:tany] nt:tany))

(define row-size-ty
  (core:quantify ["a"] (nt:tfun [(row-of (nt:type-var "a"))] uint-ty)))
(define row-get-ty
