(define list-nil-ty
  (core:quantify ["a"] (list-of (nt:type-var "a"))))

(define list-size-ty
  (core:quantify ["a"] (nt:tfun [(list-of (nt:type-var "a"))] (nt:tnat 0))))

(define (list-size ls)
  (If (IsApp ls) (Add 1 (list-size (_1 ls)))
    0))
(define list-row-ty
  (core:quantify ["a"] (nt:tfun [(list-of (nt:type-var "a"))] (row-of (nt:type-var "a")))))
(define list-cons-ty
  (core:quantify ["a"] (nt:tfun [(nt:type-var "a") (list-of (nt:type-var "a"))] (list-of (nt:type-var "a")))))
