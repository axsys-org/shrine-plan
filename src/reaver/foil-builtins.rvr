  (core:quantify ["a"] (nt:tfun [(list-of (nt:type-var "a"))] (nt:type-var "a"))))
(define list-tail-ty
  (core:quantify ["a"] (nt:tfun [(list-of (nt:type-var "a"))] (list-of (nt:type-var "a")))))
(define list-test-ty
  (core:quantify ["a"] (nt:tfun [(list-of (nt:type-var "a"))] uint-ty)))
(define list-map-ty
  (core:quantify ["a"]
    (core:quantify ["b"]
      (nt:tfun [(nt:tfun [(nt:type-var "a")] (nt:type-var "b")) (list-of (nt:type-var "a"))]
        (list-of (nt:type-var "b"))))))

(define list-weld-ty
  (core:quantify ["a"]
    (nt:tfun [(list-of (nt:type-var "a")) (list-of (nt:type-var "a"))]
      (list-of (nt:type-var "a")))))

;; either[e a]: error type first, cases err/ok.
(define either-err-ty
  (core:quantify ["e"] (core:quantify ["a"]
    (nt:tfun [(nt:type-var "e")] (either-of (nt:type-var "e") (nt:type-var "a"))))))
(define either-ok-ty
  (core:quantify ["e"] (core:quantify ["a"]
    (nt:tfun [(nt:type-var "a")] (either-of (nt:type-var "e") (nt:type-var "a"))))))
(define either-test-ty
  (core:quantify ["e"] (core:quantify ["a"]
    (nt:tfun [(either-of (nt:type-var "e") (nt:type-var "a"))] uint-ty))))
(define either-err-val-ty
  (core:quantify ["e"] (core:quantify ["a"]
    (nt:tfun [(either-of (nt:type-var "e") (nt:type-var "a"))] (nt:type-var "e")))))
(define either-ok-val-ty
  (core:quantify ["e"] (core:quantify ["a"]
    (nt:tfun [(either-of (nt:type-var "e") (nt:type-var "a"))] (nt:type-var "a")))))

;; maybe[v]: the substrate option type, cases some/none (rooted brand,
;; see foil-type-core declarations).  Direct spellings (maybe/some[nat] 3)
;; and maybe/none[nat]; the relative .some/.none need a goal.
(define maybe-some-ty
  (core:quantify ["v"] (nt:tfun [(nt:type-var "v")] (maybe-of (nt:type-var "v")))))
(define maybe-none-ty
  (core:quantify ["v"] (maybe-of (nt:type-var "v"))))
(define maybe-test-ty
  (core:quantify ["v"] (nt:tfun [(maybe-of (nt:type-var "v"))] uint-ty)))

;; pail/as[t] : {\ pail}maybe[t] for a declared record t.  This entry
;; carries only the scheme: the elaborator synthesizes the value per
;; specialization from t's branded-row key (foil-new-elab elab-pail-as),
;; so the unspecialized value can never be reached from typed code.
(define pail-as-ty
  (core:quantify ["t"] (nt:tfun [nt:tpail] (maybe-of (nt:type-var "t")))))
(define (pail-as-unspecialized p)
  (error "pail/as must be specialized: pail/as[t]"))

(define/typed typed-add (-> (Nat Nat) Nat) Add)
(define/typed typed-pin (All (a) (-> (a) (Pin a))) Pin)
(define/typed typed-unpin (All (a) (-> ((Pin a)) a)) Unpin)

(define/typed (uint-add-m y x) (-> (UInt UInt) UInt) (Add x y))
(define (uint-sub-m y x) (Sub x y))
(define (uint-mul-m y x) (Mul x y))
(define (uint-div-m y x) (Div x y))
(define (uint-mod-m y x) (Mod x y))
(define (uint-eq-m y x) (Eq x y))
(define (uint-lt-m y x) (Lt x y))
(define (uint-le-m y x) (Le x y))
(define (uint-ge-m y x) (Ge x y))
(define (uint-gt-m y x) (Gt x y))

;; Quip comparator jets.  These mirror sept.foil's aura_rank/lte_dime/
;; eq_iota exactly (rank by aura name; text auras byte-lexicographic,
;; the rest numeric) — sept's foil definitions delegate to these, since
;; the interpreted 8-arm match chains cost ~20µs per comparison and the
;; ordered maps (uon/mop) compare on every tree level of every insert.
;; Quip rep: an aura-tagged spine — (Hd q) is the aura, (Ix 0 q) the
;; payload (see foil-type-core iota-body).
(define (aura-rank-r q)
  (define t (Hd q))
  (cond
    ((Eq t "dm") 0) ((Eq t "dr") 1) ((Eq t "ds") 2) ((Eq t "f") 3)
    ((Eq t "r") 4) ((Eq t "rd") 5) ((Eq t "rs") 6) ((Eq t "s") 7)
    ((Eq t "ta") 8) ((Eq t "ts") 9) ((Eq t "tu") 10) ((Eq t "u") 11)
    ((Eq t "w") 12) ((Eq t "x") 13)
    (else (error ["iota-cmp-bad-quip" q]))))
(define (text-aura-r? t)
  (Or (Eq t "ta") (Or (Eq t "ts") (Eq t "tu"))))
;; Signed (zigzag) order: ..., 0s-2, 0s-1, 0s0, 0s1, ... — magnitude
;; compare with negatives reversed.
(define (zigzag-lte a b)
  (define na (Mod a 2))
  (define nb (Mod b 2))
  (If (Eq na nb)
    (If (Eq na 1) (Le b a) (Le a b))
    (Eq na 1)))
;; Float order: the classic IEEE total-order key (negatives invert all
;; bits, positives set the sign bit), giving -inf < neg < -0 < +0 < pos
;; < +inf < nan.  Bit-pattern based, so it works with the codec TODO.
(define (float-key w x)
  (If (Test (Dec w) x)
    (Sub (Dec (Bex w)) x)
    (Add x (Bex (Dec w)))))
(define (float-lte w a b)
  (Le (float-key w a) (float-key w b)))
(define (lte-str-r a b)
  (cond
    ((Eq a b) 1)
    ((Eq a 0) 1)
    ((Eq b 0) 0)
    (else
      (let ((ab (Mod a 256)) (bb (Mod b 256)))
        (cond
          ((Lt ab bb) 1)
          ((Lt bb ab) 0)
          (else (lte-str-r (Div a 256) (Div b 256))))))))
(define (iota-lte a b)
  (define ra (aura-rank-r a))
  (define rb (aura-rank-r b))
  (define t (Hd a))
  (If (Eq ra rb)
    (cond
      ((text-aura-r? t) (lte-str-r (Ix 0 a) (Ix 0 b)))
      ((Eq t "s") (zigzag-lte (Ix 0 a) (Ix 0 b)))
      ((Eq t "rd") (float-lte 64 (Ix 0 a) (Ix 0 b)))
      ((Eq t "rs") (float-lte 32 (Ix 0 a) (Ix 0 b)))
      (else (Le (Ix 0 a) (Ix 0 b))))
    (Le ra rb)))
(define (iota-eq a b)
  (And (Eq (aura-rank-r a) (aura-rank-r b))
    (Eq (Ix 0 a) (Ix 0 b))))
(define (iota-lt a b)
  (If (iota-eq a b) 0 (iota-lte a b)))

;; CordTree building blocks for weft: HTML used to render by welding
;; cords with shift+add, paying bignum work per append (quadratic in
;; the page).  Instead the renderer assembles a tree of these nodes —
;; O(1) each — and str-run flattens it in one native pass.  The tree
;; is opaque (any) on the foil side.
(define (str-text s) ["text" s])
(define (cord-tree-slice src off len) ["slice" src off len])
(define (cord-tree-cat a b) ["cat" a b])
(define (str-repeat b n) ["repeat" b n])
;; StrTree requires a deeply-normalized tree; foil values arrive lazy.
(define (str-run t) (DeepSeq t (StrTree t)))
(define (scan8-end src start class pol) (_0 (scan8 src start class pol)))

(define (row-size xs) (Sz xs))
(define (row-get idx xs) (Ix idx xs))
(define (row-weld ys xs) (weld xs ys))
(define (row-cons x xs) (cons x xs))
(define (row-snoc x xs) (snoc x xs))
(define (row-take n xs) (take n xs))
(define (row-drop n xs) (drop n xs))
(define/typed (row-map f xs)
  (All (a b) (-> ((-> (a) b) (Row a)) (Row b)))
  (map f xs))
(define (row-filter f xs) (filter f xs))
(define (row-fold f z xs) (foldl f z xs))
(define (row-find f def xs)
  (define hit (find f xs))
  (Ifz hit def (_0 hit)))
(define (row-rev xs) (rev xs))
(define (row-any f xs) (any f xs))
(define (row-all f xs) (all f xs))

(define list-nil "nil")
(define (list-cons x xs) ("cons" x xs))

;; Foil lists are TAGGED cells — ("cons" h t) / "nil" — not the rvr
;; stream rep ((0 h t) / 0).  Every list-crossing builtin must speak
;; the tagged rep: std's stream/lweld silently produce stream cells,
;; which list/head and friends misread.
(define (foil-stream row)
  (define n (Sz row))
  (define (go i)
    (If (Lt i n)
      ("cons" (Ix i row) (go (Inc i)))
      "nil"))
  (go 0))

(define (foil-lweld xs ys)
  (If (And (IsApp xs) (Eq "cons" (Hd xs)))
    ("cons" (_0 xs) (foil-lweld (_1 xs) ys))
    ys))
;; list/weld is receiver-LAST like row/weld: xs.weld(ys) is xs ++ ys.
(define (list-weld ys xs) (foil-lweld xs ys))

;; A foil list materialized into a row in ONE pass.  Growing a
;; container with row/snoc reallocates the whole row per element, so
;; building one costs the square of its own length: a 131k-element
;; array measured 63s that way, all of it pointer copying.  list/cons
;; is O(1) and this pays the copy once.  Order is preserved, so a
;; container accumulated by prepending comes out reversed — callers rev.
(define (foil-list-lazy xs)
  (If (And (IsApp xs) (Eq "cons" (Hd xs)))
    [(_0 xs) (foil-list-lazy (_1 xs))]
    0))
(define (list-to-row xs) (rowify (foil-list-lazy xs)))
(define (list-is-nil xs) (Eq list-nil xs))
(define (list-is-cons xs) (And (IsApp xs) (Eq "cons" (Hd xs))))
(define (list-head xs) (_0 xs))
(define (list-tail xs) (_1 xs))
(define (list-map f xs)
  (If (list-is-nil xs)
    list-nil
    (list-cons (f (_0 xs)) (list-map f (_1 xs)))))

(define (either-err x) ("err" x))
(define (either-ok x) ("ok" x))
(define (either-is-err x) (And (IsApp x) (Eq "err" (Hd x))))
(define (either-is-ok x) (And (IsApp x) (Eq "ok" (Hd x))))
(define (either-err-val x) (_0 x))
(define (either-ok-val x) (_0 x))

(define (native-result r)
  (If (Eq 0 (Hd r)) (either-ok (_0 r)) (either-err (_0 r))))
(define (foil-try f x) (native-result (Try f x)))
(define (foil-fetch request config) (native-result (native-http:Fetch request config)))

(define (maybe-some x) (maybe-some-brand x))
(define maybe-none maybe-none-brand)

;;; Aura-preserving text primitives ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; str = nat/tu, sym = nat/ts.  An aura'd nat widens to nat but nothing
;; widens back (a bare nat cannot claim an aura), so every operation that
;; PRODUCES text must retain its aura in the shared type algebra.
;; Everything above these (join, split, lines, ...) composes in Foil.
;; Results are
;; typed by the alias reference so their namespace is str/sym; the
;; elaborator also routes nat/tu and nat/ts receivers there (nominal-of).
(define str-ref (nt:type-ref ["str"]))
(define sym-ref (nt:type-ref ["sym"]))
(define iota-ref (nt:type-ref ["iota"]))
(define nat-ref (nt:type-ref ["nat"]))
(define (maybe-nt t) (nt:type-app ["maybe"] [(nt:type-arg t)]))
(define str-cat-ty (nt:tfun [str-ref str-ref] str-ref))
(define str-slice-ty (nt:tfun [str-ref nat-ref nat-ref] str-ref))
(define str-len-ty (nt:tfun [str-ref] nat-ref))
(define str-at-ty (nt:tfun [str-ref nat-ref] nat-ref))
(define nat-show-ty (nt:tfun [nat-ref] str-ref))
(define nat-parse-ty (nt:tfun [str-ref] (maybe-nt nat-ref)))
(define iota-text-ty (nt:tfun [iota-ref] (maybe-nt str-ref)))
(define iota-show-nt-ty (nt:tfun [iota-ref] str-ref))
(define sym-text-ty (nt:tfun [sym-ref] str-ref))
(define str-sym-ty (nt:tfun [str-ref] (maybe-nt sym-ref)))
(define path-show-ty (nt:tfun [(nt:tarr iota-ref)] str-ref))
(define path-parse-ty (nt:tfun [str-ref] (maybe-nt (nt:tarr iota-ref))))
;; cords are little-endian byte strings, so slicing is shifting.
;; str/cat is receiver-LAST like row/weld: base.cat(tail) is base ++
;; tail, so the direct spelling is (str/cat tail base).
(define (str-cat tail base) (strWeld base tail))
(define (str-slice s off len) (Mod (Rsh s (Mul 8 off)) (Bex (Mul 8 len))))
(define (str-len s) (Bytes s))
(define (str-at s i) (Load8 i s))
(define (nat-show n) (showNat n))
;; decimal text to nat: none on empty text or any non-digit byte
(define (nat-parse s)
  (define (go x acc)
    (If (Eq 0 x)
      (maybe-some acc)
      (let ((b (Mod x 256)))
        (If (Or (Lt b 48) (Gt b 57))
          maybe-none
          (go (Div x 256) (Add (Mul acc 10) (Sub b 48)))))))
  (If (Eq 0 s) maybe-none (go s 0)))
(define (iota-text q)
  (If (text-aura-r? (Hd q)) (maybe-some (_0 q)) maybe-none))
(define (sym-text s) s)
(define (str-sym s) (If (quip:aura-sym? s) (maybe-some s) maybe-none))
(define (path-show pax) (quip:print-path pax))
(define (path-parse s)
  (let ((r (quip:parse-path-soft s)))
    (If r (maybe-some (_0 r)) maybe-none)))
(define (maybe-is-some x) (And (IsApp x) (Eq maybe-some-brand (Hd x))))
(define (maybe-is-none x) (Eq maybe-none-brand x))

(define typed-foil-api
  (provide/foil
    (typed-add (foil add))
    (typed-pin (foil pin))
    (typed-unpin (foil unpin))
    (uint-add-m (foil uint add))
    (row-map (foil row map))))


(define (insert-uint-methods prefix sut)
  (pipe sut
    (insert-ffi (Weld prefix ["sub"]) uint-sub-m binary-uint-ty)
    (insert-ffi (Weld prefix ["mul"]) uint-mul-m binary-uint-ty)
    (insert-ffi (Weld prefix ["div"]) uint-div-m binary-uint-ty)
    (insert-ffi (Weld prefix ["mod"]) uint-mod-m binary-uint-ty)
    (insert-ffi (Weld prefix ["inc"]) Inc unary-uint-ty)
    (insert-ffi (Weld prefix ["bex"]) Bex unary-uint-ty)
    (insert-ffi (Weld prefix ["dec"]) Dec unary-uint-ty)
    (insert-ffi (Weld prefix ["eq"]) uint-eq-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["lt"]) uint-lt-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["le"]) uint-le-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["ge"]) uint-ge-m cmp-uint-ty)
    (insert-ffi (Weld prefix ["gt"]) uint-gt-m cmp-uint-ty)))

;;; Rex keeps its native representation; force parsing inside Try so errors
;;; in lazy children cannot escape the result boundary.
(define rex-ref (nt:type-ref ["rex"]))
(define rex-parse-ty (nt:tfun [str-ref] (either-of nt:tany rex-ref)))
(define (foil-rex-parse src)
  (foil-try (lambda (text)
    (define tree (rex:ParseRexFile text))
    (DeepSeq tree tree)) src))
(define (foil-rex-parse-blocks src)
  (foil-try (lambda (text)
    (define trees (rex:ParseRexBlocks text))
    (DeepSeq trees trees)) src))
(define (foil-rex-parse-block src)
  (foil-try (lambda (text)
    (define tree (rex:ParseRex text))
    (DeepSeq tree tree)) src))
(define (foil-rex-leaf-kind shape)
  (If (Nat shape) (maybe-some shape) maybe-none))
(define (foil-rex-leaf-error shape)
  (If (And (IsApp shape) (And (Eq "bad" (Hd shape))
        (And (Eq 1 (Sz shape)) (Nat (_0 shape)))))
    (maybe-some (_0 shape)) maybe-none))

(define ffi-subject
  (pipe (set-sut-root boot-root empty-subject)
    ;; pipe applies bottom-up: these aliases run LAST, over the full
    ;; subject below.
    (install-core-subject)
    (insert-ffi ["rex" "parse"] foil-rex-parse rex-parse-ty)
    (insert-ffi ["rex" "parse_blocks"] foil-rex-parse-blocks
      (nt:tfun [str-ref] (either-of nt:tany (row-of rex-ref))))
    (insert-ffi ["rex" "parse_block"] foil-rex-parse-block rex-parse-ty)
    (insert-ffi ["rex" "normalize"] rex:NormalizeRex (nt:tfun [rex-ref] rex-ref))
    (insert-ffi ["rex" "print"] rex:PrintRex (nt:tfun [rex-ref] str-ref))
    (insert-ffi ["rex" "shape_kind"] foil-rex-leaf-kind
      (nt:tfun [nt:tany] (maybe-nt str-ref)))
    (insert-ffi ["rex" "shape_error"] foil-rex-leaf-error
      (nt:tfun [nt:tany] (maybe-nt str-ref)))
    (insert-ffi ["if"] If if-ty)
    ;; Raises its pail argument; nat is the declared result until the
    ;; language represents non-returning functions explicitly.
    (insert-ffi ["error"] error (nt:tfun [nt:tpail] (nt:tnat 0)))
    ;; Raw native operations: callers sequence them explicitly. Mailbox
    ;; payloads are untyped; capabilities travel in their separate row.
    (insert-ffi ["Save"] Save save-ty)
    (insert-ffi ["Spawn"] Spawn spawn-ty)
    (insert-ffi ["Send"] Send send-ty)
    (insert-ffi ["SendCaps"] SendCaps send-caps-ty)
    (insert-ffi ["Recv"] Recv recv-ty)
    (insert-ffi ["CloseHandle"] CloseHandle unary-nat-ty)
    (insert-ffi ["Input"] Input unary-nat-ty)
    (insert-ffi ["Output"] Output unary-nat-ty)
    (insert-ffi ["Warn"] Warn unary-nat-ty)
    (insert-ffi ["Print"] Print path-io-ty)
    (insert-ffi ["ReadFile"] ReadFile path-io-ty)
    (insert-ffi ["WriteFile"] WriteFile write-file-ty)
    (insert-ffi ["ReadFolder"] ReadFolder folder-ty)
    (insert-ffi ["Stamp"] Stamp path-io-ty)
    (insert-ffi ["Now"] Now unary-nat-ty)
    (insert-ffi ["Sleep"] Sleep unary-nat-ty)
    (insert-ffi ["Listen"] Listen unary-nat-ty)
    (insert-ffi ["Accept"] Accept unary-nat-ty)
    (insert-ffi ["Connect"] Connect connect-ty)
    (insert-ffi ["Read"] Read binary-nat-ty)
    (insert-ffi ["Write"] Write binary-nat-ty)
    (insert-ffi ["CloseFd"] CloseFd unary-nat-ty)
    (insert-ffi ["Fetch"] foil-fetch fetch-ty)
    (insert-ffi ["Try"] foil-try try-ty)
    (insert-ffi ["Throw"] Throw (nt:tfun [nt:tany] (nt:tnat 0)))
    (insert-ffi ["Seq"] Seq sequence-ty)
    (insert-ffi ["DeepSeq"] DeepSeq sequence-ty)
    (insert-ffi ["Trace"] Trace sequence-ty)
    (insert-ffi ["ZoneStart"] ZoneStart path-io-ty)
    (insert-ffi ["ZoneEnd"] ZoneEnd unary-nat-ty)
    (insert-ffi ["eq"] Eq eq-ty)
    ;; PLAN Eq is intentionally shallow on structured values.  Namespace
    ;; version deduplication needs extensional equality of whole myths, so
    ;; expose the runtime's forcing structural comparison separately.
    (insert-ffi ["equal"] Equal equal-ty)
    (insert-ffi ["sub"] Sub binary-nat-ty)
    (insert-ffi ["lt"] Lt binary-nat-ty)
    (insert-ffi ["le"] Le binary-nat-ty)
    (insert-ffi ["ge"] Ge binary-nat-ty)
    (insert-ffi ["gt"] Gt binary-nat-ty)
    (insert-ffi ["inc"] Inc unary-nat-ty)
    (insert-ffi ["bex"] Bex unary-nat-ty)
    (insert-ffi ["get_bit"] Test binary-nat-ty)
    (insert-ffi ["set_bit"] Set binary-nat-ty)
    (insert-ffi ["clear_bit"] Clear binary-nat-ty)
    (insert-ffi ["mul"] Mul binary-nat-ty)
    (insert-ffi ["div"] Div binary-nat-ty)
    (insert-ffi ["mod"] Mod binary-nat-ty)
    (insert-ffi ["dec"] Dec unary-nat-ty)
    ;; native byte-width and shifts: cord code (weft &c) would
    ;; otherwise recount lengths and rebuild 256^n by repeated
    ;; division/multiplication — quadratic per append
    (insert-ffi ["wid"] Bytes unary-nat-ty)
    (insert-ffi ["lsh"] Lsh binary-nat-ty)
    (insert-ffi ["rsh"] Rsh binary-nat-ty)
    ;; native indexed reads: a cord is one big nat, so walking it by
    ;; (div s 256) reallocates the whole remainder per byte —
    ;; quadratic per scan.  Measured on a 1MB cord, 20k bytes:
    ;; load8 6ms flat at any offset, div-by-256 165s.  See sept/cord.
    (insert-ffi ["load8"] Load8 binary-nat-ty)
    (insert-ffi ["loadvar"] LoadVar ternary-nat-ty)
    ;; native run scanning and one-pass cord assembly: weft renders
    ;; HTML as a CordTree of slices flattened by a single str_run
    ;; instead of per-append shift+add welds
    (insert-ffi ["scan8"] scan8 scan8-ty)
    (insert-ffi ["scan8_end"] scan8-end quaternary-nat-ty)
    (insert-ffi ["str_text"] str-text str-text-ty)
    (insert-ffi ["str_slice"] cord-tree-slice cord-tree-slice-ty)
    (insert-ffi ["str_cat"] cord-tree-cat cord-tree-cat-ty)
    (insert-ffi ["str_repeat"] str-repeat str-repeat-ty)
    (insert-ffi ["str_run"] str-run str-run-ty)
    (insert-ffi ["iota_lte"] iota-lte iota-cmp-ty)
    (insert-ffi ["iota_lt"] iota-lt iota-cmp-ty)
    (insert-ffi ["iota_eq"] iota-eq iota-cmp-ty)
    (insert-ffi ["iota_show"] quip:print-quip iota-show-nt-ty)
    (insert-ffi ["nat_show"] quip:print-nat-canonical unary-nat-ty)
    (insert-ffi ["rep_hd"] Hd rep-nat-ty)
    (insert-ffi ["rep_sz"] Sz rep-nat-ty)
    (insert-ffi ["rep_ix"] Ix rep-ix-ty)
    (insert-ffi ["rep_app"] IsApp rep-nat-ty)
    (insert-ffi ["rep_pin"] IsPin rep-nat-ty)
    (insert-ffi ["rep_law"] IsLaw rep-nat-ty)
    (insert-ffi ["rep_unpin"] Unpin rep-unpin-ty)
    (insert-ffi ["nat" "add"] uint-add-m binary-uint-ty)
    (insert-uint-methods ["nat"])
    (insert-uint-methods ["uint"])
    (insert-ffi ["unit" "unit"] "/unit" unit-ty)
    (insert-ffi ["row" "size"] row-size row-size-ty)
    (insert-ffi ["row" "len"] row-size row-size-ty)
    (insert-ffi ["row" "get"] row-get row-get-ty)
    (insert-ffi ["row" "at"] row-get row-get-ty)
    (insert-ffi ["row" "take"] row-take row-take-ty)
    (insert-ffi ["row" "drop"] row-drop row-take-ty)
    (insert-ffi ["row" "weld"] row-weld row-weld-ty)
    (insert-ffi ["row" "append"] row-weld row-weld-ty)
    (insert-ffi ["row" "cons"] row-cons row-cons-ty)
    (insert-ffi ["row" "snoc"] row-snoc row-cons-ty)
    (insert-ffi ["row" "filter"] row-filter row-filter-ty)
    (insert-ffi ["row" "fold"] row-fold row-fold-ty)
    (insert-ffi ["row" "find"] row-find row-find-ty)
    (insert-ffi ["row" "rev"] row-rev row-rev-ty)
    (insert-ffi ["row" "any"] row-any row-pred-ty)
    (insert-ffi ["row" "all"] row-all row-pred-ty)
    (insert-ffi ["row" "stream"] foil-stream row-stream-ty)
    (insert-ffi ["nil"] list-nil list-nil-ty)
    (insert-ffi ["cons"] list-cons list-cons-ty)
    (insert-ffi ["list" "nil"] list-nil list-nil-ty)
    (insert-ffi ["list" "size"] list-size list-size-ty)
    (insert-ffi ["list" "cons"] list-cons list-cons-ty)
    (insert-ffi ["list" "row"] list-to-row list-row-ty)
    (insert-ffi ["list_row"] list-to-row list-row-ty)
    (insert-ffi ["list" "head"] list-head list-head-ty)
    (insert-ffi ["list" "tail"] list-tail list-tail-ty)
    (insert-ffi ["list" "is_nil"] list-is-nil list-test-ty)
    (insert-ffi ["list" "is_cons"] list-is-cons list-test-ty)
    (insert-ffi ["list" "map"] list-map list-map-ty)
    (insert-ffi ["list" "weld"] list-weld list-weld-ty)
    (insert-ffi ["err"] either-err either-err-ty)
    (insert-ffi ["ok"] either-ok either-ok-ty)
    (insert-ffi ["either" "err"] either-err either-err-ty)
    (insert-ffi ["either" "ok"] either-ok either-ok-ty)
    (insert-ffi ["either" "is_err"] either-is-err either-test-ty)
    (insert-ffi ["either" "is_ok"] either-is-ok either-test-ty)
    (insert-ffi ["either" "err_val"] either-err-val either-err-val-ty)
    (insert-ffi ["either" "ok_val"] either-ok-val either-ok-val-ty)
    (insert-ffi ["maybe" "some"] maybe-some maybe-some-ty)
    (insert-ffi ["maybe" "none"] maybe-none maybe-none-ty)
    (insert-ffi ["maybe" "is_some"] maybe-is-some maybe-test-ty)
    (insert-ffi ["maybe" "is_none"] maybe-is-none maybe-test-ty)
    (insert-ffi ["pail" "as"] pail-as-unspecialized pail-as-ty)
    ;; text: the aura-preserving primitives (stage-1 types)
    (insert-ffi ["str" "cat"] str-cat str-cat-ty)
    (insert-ffi ["str" "slice"] str-slice str-slice-ty)
    (insert-ffi ["str" "len"] str-len str-len-ty)
    (insert-ffi ["str" "at"] str-at str-at-ty)
    (insert-ffi ["str" "sym"] str-sym str-sym-ty)
    (insert-ffi ["sym" "text"] sym-text sym-text-ty)
    (insert-ffi ["nat" "show"] nat-show nat-show-ty)
    (insert-ffi ["nat" "parse"] nat-parse nat-parse-ty)
    (insert-ffi ["iota" "text"] iota-text iota-text-ty)
    (insert-ffi ["path_show"] path-show path-show-ty)
    (insert-ffi ["path_parse"] path-parse path-parse-ty)))

;; Raw install: the provide/foil boundary wrappers shape-check every
;; argument and result on every call, adding overhead to primitives.
;; Keep raw bindings for pin/unpin/add, which the shrine
;; kernel hits on every namespace-tree edge.  define/typed already
;; checked the definitions statically; the boundary contract is a
;; debugging aid, re-enable by swapping back to install-foil-provides.
(define default-subject
  (install-foil-provides-raw typed-foil-api ffi-subject))
