      (nt:tfun [(nt:tfun [(nt:type-var "b") (nt:type-var "a")] (nt:type-var "b"))
                (nt:type-var "b")
                (row-of (nt:type-var "a"))]
        (nt:type-var "b")))))
(define row-find-ty
  (core:quantify ["a"]
    (nt:tfun [(nt:tfun [(nt:type-var "a")] (nt:tnat 0))
