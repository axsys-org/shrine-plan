(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)
(#bind cairn (#module cairn))
(#import cairn)

(#bind newtype (#module newtype))
(#import newtype)

(#bind contexts (#module foil-context))

(#bind print (#module print))
(#import print)

;;; TC nodes ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Typed constructors (newtype) over the HISTORICAL brands: consumers
;; across the compiler (foil-lower, foil-new-elab, foil-relocate, ...)
;; dispatch on (Hd node) cords like "TC_APP", and pinned subjects
;; persist these nodes, so the tags stay "TC_*" cords rather than
;; declare-cstr-minted type paths.  trow + $/. keep the representation
;; bit-identical while adding checked construction and named faces.

(define (tc tag) (strWeld "TC_" tag))

;; typed-value? :: RowType -> Data -> Bool
;; (Row.cstr is (_0): `Row` itself is unreachable here — the wisp
;; builtin of the same name wins over newtype's imported type.)
(define (typed-value? typ value)
  (And (IsApp value) (Eq (_0 typ) (Hd value))))

(define TcLocal (trow (tc "LOCAL") [["ty" tany] ["slot" tany] ["face" tany]]))
(define TcGlobal (trow (tc "GLOBAL") [["ty" tany] ["path" tany]]))
(define TcLit (trow (tc "LIT") [["ty" tany] ["val" tany]]))
(define TcConst (trow (tc "CONST") [["ty" tany] ["val" tany]]))
;; A const generic parameter reference inside a generic body — a typed
;; placeholder.  Deliberately has NO lowering case: one leaking past
;; materialization fails loudly.
(define TcCparam (trow (tc "CPARAM") [["ty" tany] ["name" tany]]))
(define TcFfi (trow (tc "FFI") [["ty" tany] ["val" tany]]))
(define TcApp (trow (tc "APP") [["ty" tany] ["f" tany] ["x" tany]]))
(define TcTyp (trow (tc "TYP") [["ty" tany]]))
(define TcMean (trow (tc "MEAN") [["cause" tany]]))
(define TcLam
  (trow (tc "LAM") [["ty" tany] ["meta" tany] ["args" tany] ["body" tany]]))
(define TcDemand (trow (tc "DEMAND") [["ty" tany] ["val" tany]]))
(define TcBefore (trow (tc "BEFORE") [["ty" tany] ["val" tany] ["body" tany]]))
(define TcLetrec (trow (tc "LET") [["ty" tany] ["binds" tany] ["body" tany]]))
(define TcRow (trow (tc "ROW") [["ty" tany] ["hd" tany] ["items" tany]]))
(define TcMatch
  (trow (tc "MATCH") [["ty" tany] ["scrut" tany] ["arms" tany] ["fall" tany]]))
;; An arm's key is its runtime dispatch tree ["key" cstr arity kids]:
;; kids has one entry per field — 0 for an unconstrained binder, or a
;; nested key for a nested variant pattern (tested by lower-arm-test).
(define TcArm
  (trow (tc "ARM") [["ty" tany] ["pat" tany] ["val" tany] ["key" tany]]))

(decl-union Tc
  TcLocal TcGlobal TcLit TcConst TcCparam TcFfi TcApp TcTyp TcMean
  TcLam TcDemand TcBefore TcLetrec TcRow TcMatch TcArm)

;; Every TC node carries its type at slot 0 (TcMean: its cause), so
;; these two stay shape-generic across the union.
(define tc-ty (Ix 0))
(define set-tc-ty (Up 0))

(define tc-local $TcLocal)
(define tc-local-slot TcLocal.slot)
(define tc-global $TcGlobal)
(define tc-global-path TcGlobal.path)
(define tc-lit $TcLit)
(define tc-lit-val TcLit.val)
(define tc-const $TcConst)
(define tc-const-val TcConst.val)
(define tc-cparam $TcCparam)
(define tc-cparam-name TcCparam.name)
(define (tc-has-cparam? x)
  (If (IsApp x)
    (If (typed-value? TcCparam x)
      1
      (any tc-has-cparam? (gen (Sz x) (lambda (i) (Ix i x)))))
    0))
(define (tc-uses-cparam? name x)
  (If (IsApp x)
    (If (typed-value? TcCparam x)
      (Eq name (TcCparam.name x))
      (any (tc-uses-cparam? name) (gen (Sz x) (lambda (i) (Ix i x)))))
    0))
(define tc-ffi $TcFfi)
(define tc-ffi-val TcFfi.val)
(define tc-app $TcApp)
(define tc-app-f TcApp.f)
(define tc-app-x TcApp.x)
(define tc-typ $TcTyp)
(define tc-typ-inner TcTyp.ty)
(define tc-mean $TcMean)

(define tc-lam $TcLam)
(define tc-lam-args TcLam.args)
(define (tc-lam-arity l) (Sz (TcLam.args l)))
(define tc-lam-body TcLam.body)

(define tc-demand $TcDemand)
(define tc-demand-val TcDemand.val)
(define tc-before $TcBefore)
(define tc-before-val TcBefore.val)
(define tc-before-body TcBefore.body)
(define tc-letrec $TcLetrec)
(define tc-letrec-binds TcLetrec.binds)
(define tc-letrec-body TcLetrec.body)

(define tc-row $TcRow)
(define tc-row-hd TcRow.hd)
(define tc-row-items TcRow.items)

(define tc-match $TcMatch)
(define tc-match-scrut TcMatch.scrut)
(define tc-match-arms TcMatch.arms)
(define tc-match-fall TcMatch.fall)

(define tc-arm $TcArm)
(define tc-arm-pat TcArm.pat)
(define tc-arm-val TcArm.val)
(define tc-arm-key TcArm.key)



;; Compiler storage is private. Public definition locations and moments
;; belong to the explicit compilation context. The visibility index maps
;; source spellings to storage keys; import pins carry defining layers.
;; Version two requires the context slot even during entrypoint migration.
;; Retired slots remain zero, but old or wider payloads are never upgraded.
(define Subject
  (trow "foil/subject/v2"
    [["ax" tany] ["order" tany] ["tvar" tany] ["root" tany]
     ["unit" tany] ["visible" tany] ["vis-inverse" tany]
     ["write-log" tany] ["lazy" tany] ["prev" tany]
     ["context" tany]]))

(define (subject? x)
  (And (IsApp x)
    (And (Eq (Hd x) "foil/subject/v2") (Eq (Sz x) 11))))
(define (require-subject sut)
  (If (subject? sut) sut
    (error "stale-compiler-subject: rebuild compiler artifacts and snapshots")))

(define (sut-ax sut) (Subject.ax (require-subject sut)))
(define (sut-root sut) (Subject.root (require-subject sut)))
(define (set-sut-root root sut) (Subject.=root root (require-subject sut)))
(define (root-path sut p) (Weld (sut-root sut) p))
(define (sut-context sut) (Subject.context (require-subject sut)))
(define (sut-prev sut) (Subject.prev (require-subject sut)))
(define (sut-unit sut) (Subject.unit (require-subject sut)))
(define (sut-visible sut) (Subject.visible (require-subject sut)))
(define (sut-vis-inverse sut) (Subject.vis-inverse (require-subject sut)))

;; set-sut-unit :: Unit | 0 -> Subject -> Subject
(define (set-sut-context context sut)
  (Subject.=context context (require-subject sut)))
(define (set-sut-unit unit sut) (Subject.=unit unit (require-subject sut)))

;; set-sut-visible :: Ax CanonPath | 0 -> Subject -> Subject
(define (set-sut-visible visible sut)
  (Subject.=visible visible (require-subject sut)))


;; Retired slot 8 is always zero; import layers live in prev.
(define (sut-lazy sut) (Subject.lazy (require-subject sut)))

;; sut-find :: Path -> Subject -> Maybe (Pin Entry)
;;
;; The prev slot holds a ROW of import-subject PINS (newest-first), or
;; 0.  Storing the imports' own cache pins — rather than re-parenting a
;; single chain — is what shares structure: a diamond-imported module
;; is ONE pin referenced from many prev rows, no spine is rebuilt, and
;; two compiles of the same graph produce Equal prev rows (the artifact
;; warm-hit contract).  Each pinned import is itself a full subject with
;; its own prevs, so the chain is a shared DAG walked depth-first,
;; newest import first (later-import-wins).  Own layer first, then the
;; prevs — nearest layer wins.
(define (sut-prevs sut)
  (define p (sut-prev sut))
  (Ifz p [] p))

(define (search-layers visit sut)
  (define hit (visit sut))
  ;; Revisited pins cannot produce a new result. Shared system imports make
  ;; diamonds common; walking their tails again made misses exponential.
  (define (fp seen prevs)
    (Ifz (Sz prevs) 0
      (let ((pin (_0 prevs)) (rest (drop 1 prevs)))
        (If (includes (Equal pin) seen) (fp seen rest)
          (let* ((layer (Unpin pin)) (h (visit layer)))
            (If h h
              (fp (snoc pin seen) (Weld (sut-prevs layer) rest))))))))
  (If hit
    hit
    (fp [] (sut-prevs sut))))

(define (sut-find key sut)
  (search-layers (lambda (layer) (getax key (sut-ax layer))) sut))

;; Every layer subject reachable through the chain (head, then each
;; import DAG), for the order-flattening consumers.
(define (sut-layers sut)
  ;; Preserve the existing right-to-left layer fold, retaining only each
  ;; pin's first occurrence. This does not change source-name precedence.
  (define (walk seen pending)
    (Ifz (Sz pending) 0
      (let ((pin (_0 pending)) (rest (drop 1 pending)))
        (If (includes (Equal pin) seen) (walk seen rest)
          (let ((layer (Unpin pin)))
            (lcons layer (walk (snoc pin seen)
              (Weld (rev (sut-prevs layer)) rest))))))))
  (lcons sut (walk [] (rev (sut-prevs sut)))))

;; RETIRED slot 7 (write-log, 2026-09-01): the log existed so the two
;; per-compile deltas could avoid deep-Equal-walking a projection-fat
;; order.  Under layered subjects a compile's own layer IS the write
;; set — its order is small and authoritative — so the delta walks the
;; order again and the log has nothing left to accelerate.
;; Constructors leave the retired slot zero.

;; derive-vis-inverse :: Subject -> Ax (Row WrittenPath)
;;
;; The visibility index inverted (canonical -> every written alias),
;; derived on demand from the chain's per-layer indexes — head first,
;; so a nearer layer's claim on a written path shadows a tail's, the
;; same nearest-wins rule vis-find applies forward.  This retired the
;; subject's slot-6 inverse cache (2026-09-01): the inverse is now
;; derived once per NewCompiler and cached there, so it is no longer
;; subject state, mark-visible no longer maintains it, and the durable
;; boundary has nothing to strip.
;; sorted, deduped alias insertion — one canonical row order no
;; matter which layer order contributed the aliases
(define (insert-written written row)
  (Ifz (Sz row)
    [written]
    (Case3 (cmp-total written (_0 row))
      (Weld [written] row)
      row
      (Weld [(_0 row)] (insert-written written (drop 1 row))))))

(define (derive-vis-inverse sut)
  ;; HEAD vis only — the inverse mirrors the compile's own naming
  ;; authority, same rule as visible-canon.
  (define vis (sut-visible sut))
  (Ifz vis
    empty-ax
    (foldl
      (lambda (inv pair)
        (putax (_1 pair)
          (insert-written (_0 pair) (fall [] (getax (_1 pair) inv)))
          inv))
      empty-ax (rowify (tapax vis)))))

;; vis-aliases :: Subject -> (CanonPath -> Row WrittenPath)
;;
;; The inverse as the point query its one consumer makes.  Any head answers
;; this way; the whole index is inverted on the first query.
(define (vis-aliases sut)
  (define inv (derive-vis-inverse sut))
  (lambda (canonical) (fall [] (getax canonical inv))))

;; mount-aliases :: Row [LayerRoot Spell] -> Ax CanonPath -> (CanonPath -> Row WrittenPath)
;;
;; The same answer without inverting anything, for a head whose marks are all
;; regular.  An import layer is marked under a spelling — spell ++ the key
;; below its layer's root, or spell ++ the whole key for a key outside that
;; root — and an own declaration marks itself, so a canonical key's possible
;; aliases follow from the mount table alone.  The head index then says which
;; of them survived shadowing, exactly as the inverted index would: an alias
;; of `canonical` is a written path the index still maps to it.
;;
;; Inverting costs a put per name in the whole import closure, per compile,
;; to serve a few lookups; this costs the mounts once and a few gets per
;; lookup.  A head carrying any other kind of mark must use vis-aliases.
(define (mount-aliases mounts vis)
  (define spells
    (foldl (lambda (out pair)
      (If (includes (Equal (_1 pair)) out) out (snoc (_1 pair) out))) [] mounts))
  (define by-root
    (foldl (lambda (out pair)
      (define known (fall [] (getax (_0 pair) out)))
      (If (includes (Equal (_1 pair)) known) out
        (putax (_0 pair) (snoc (_1 pair) known) out))) empty-ax mounts))
  (define lengths
    (foldl (lambda (out pair)
      (define n (Sz (_0 pair)))
      (If (includes (Eq n) out) out (snoc n out))) [] mounts))
  (define (below canonical)
    (foldl (lambda (out n)
      (If (Gt n (Sz canonical)) out
        (foldl (lambda (found spell) (snoc (Weld spell (drop n canonical)) found))
          out (fall [] (getax (take n canonical) by-root))))) [] lengths))
  (define (candidates canonical)
    (foldl (lambda (out spell) (snoc (Weld spell canonical) out))
      (snoc canonical (below canonical)) spells))
  (Ifz vis
    (lambda (canonical) [])
    (lambda (canonical)
      (foldl (lambda (row written)
        (define hit (getax written vis))
        (If (And hit (Equal canonical (_0 hit))) (insert-written written row) row))
        [] (candidates canonical)))))

;; Construct only the current format.
(define (make-subject ax) ($Subject ax 0 0 [] 0 0 0 0 0 0 0))
(define subject-order Subject.order)
(define set-subject-order Subject.=order)
(define (push-subject-order name sut)
  (set-subject-order (snoc name (subject-order sut)) sut))
(define empty-subject (make-subject empty-ax))

;; head-onto-pins :: [Pin Subject] -> Subject -> Subject
;; A fresh head over the given import pins (stored verbatim — they are
;; the shared cache pins).  Inherits the base subject's root.
;;
;; Every prev pin is ICED here.  The chain walks (search-layers, sut-layers)
;; dedup visited layers with Equal on these pins, once per name lookup.  An
;; unsaved pin has no hash, so that Equal walked both SUBJECTS — and each
;; compile pins its own copy of the builtin substrate, equal in content but
;; never in pointer, so meeting another module's base meant walking the whole
;; substrate.  That was ~two thirds of an Eden boot.  Prev pins are completed
;; layers; finalizing one forces whatever its entry pins had left lazy.
(define (head-onto-pins prevs base)
  ($Subject empty-ax 0 0 (sut-root base) 0 0 0 0 0 (force (map iced prevs))
    (sut-context base)))

;; push-layer :: Subject -> Subject — a fresh head over one subject,
;; pinned here (the test/single-import convenience).
(define (push-layer sut)
  (head-onto-pins [(Pin sut)] sut))

(define (subject-order-all sut)
  (foldl (lambda (acc p) (Weld acc (subject-order-all (Unpin p))))
    (subject-order sut) (sut-prevs sut)))

;; Replacing an existing entry must not duplicate its key in the order:
;; the order is a set, and passes that walk it (e.g. lowering) rely on
;; visiting each entry once.  A key absent from the ax cannot be in the
;; order (the order is a subset of the ax keys), so the fresh-key path
;; — every new declaration and generated accessor — skips the linear
;; order scan; only genuine replacements (reopens, materializations
;; over aliases) pay it.
(define (insert-entry-sut key val sut)
  (define fresh (Ifz (getax key (sut-ax sut)) 1 0))
  (define sut1 (snap 0 (putax key (Pin val)) sut))
  (cond
    (fresh (push-subject-order key sut1))
    ((includes (Equal key) (subject-order sut1)) sut1)
    (else (push-subject-order key sut1))))

;; put-entry-pin :: Path -> Pin Entry -> Subject -> Subject
;;
;; Overlay one already-pinned entry without re-pinning it.  Replacement keeps
;; the existing deterministic order slot; a fresh canonical entry joins the
;; order exactly once.
(define (put-entry-pin key pin sut)
  (define fresh (Ifz (getax key (sut-ax sut)) 1 0))
  (define sut1 (snap 0 (putax key pin) sut))
  (If fresh (push-subject-order key sut1) sut1))

;; put-entry-pins :: [[Path (Pin Entry)]] -> Subject -> Subject
;;
;; The batch form of put-entry-pin: one trie fold and ONE order append
;; for all fresh keys, instead of a row-copying snoc per key — the
;; snoc is O(order) per fresh key, which made a big import's
;; projection quadratic (measured 0.25ms/key on an empty subject,
;; 23ms/key by the time the second generated module landed).  The
;; result is bit-identical to the sequential fold: last write wins in
;; the trie, and a fresh key joins the order at its first occurrence,
;; in batch order.
(define (put-entry-pins pairs sut)
  (define ax0 (sut-ax sut))
  (define sut1
    (snap 0
      (lambda (ax)
        (foldl (lambda (a pair) (putax (_0 pair) (_1 pair) a)) ax pairs))
      sut))
  ;; fresh keys collect on a cons list (O(1) each — a row snoc here
  ;; would rebuild the very quadratic this function removes), reversed
  ;; back to encounter order so the appended order is bit-identical to
  ;; the sequential fold's
  (define fresh
    (rev (rowify
      (_1
        (foldl
          (lambda (st pair)
            (let ((k (_0 pair)))
              (If (getax k ax0)
                st
                (If (getax k (_0 st))
                  st
                  [(putax k 1 (_0 st)) (lcons k (_1 st))]))))
          [empty-ax 0] pairs)))))
  (define sut2 sut1)
  (If (Sz fresh)
    (set-subject-order (Weld (subject-order sut2) fresh) sut2)
    sut2))

;; mark-visible :: Path -> Path -> Subject -> Subject
(define (mark-visible written canonical sut)
  ;; `sut-visible` is the AX itself, not a Maybe-wrapped AX.  Using `fall`
  ;; here unwrapped the first AX field after the first insertion and silently
  ;; discarded the accumulated visibility map.
  ;; (The slot-6 inverse is no longer maintained here — it derives on
  ;; demand per compiler; see derive-vis-inverse.)
  (define vis (Ifz (sut-visible sut) empty-ax (sut-visible sut)))
  (set-sut-visible (putax written canonical vis) sut))
;; The "TC" brand rides the historical entry shape ("TC" key tc span).
(define TcEntry
  (trow "TC" [["key" tany] ["contents" tany] ["span" tany]]))
(define (make-tc-entry key span tc) ($TcEntry key tc span))
(define tc-entry-contents TcEntry.contents)
(define tc-entry-span TcEntry.span)
(define (insert-tc key span tc sut)
  (define ent (make-tc-entry key span tc))
  (insert-entry-sut key ent sut))

;; insert-tcs :: [[Path Span TC]] -> Subject -> Subject
;;
;; The batched insert-tc: identical semantics — last write wins, a
;; fresh key joins the order at first occurrence, a replacement joins
;; only if absent from the order — but ONE order append for the whole
;; batch.  gen-accessors writes three entries per record field
;; (thousands per generated module), and the one-at-a-time path paid
;; an order snoc each.
(define (insert-tcs rows sut)
  (define pairs
    (map (lambda (r) [(_0 r) (Pin (make-tc-entry (_0 r) (_1 r) (_2 r)))])
      rows))
  (define ax0 (sut-ax sut))
  (define sut1
    (snap 0
      (lambda (ax)
        (foldl (lambda (a p) (putax (_0 p) (_1 p) a)) ax pairs))
      sut))
  (define sut2 sut1)
  (define joins
    (rev (rowify
      (_1
        (foldl
          (lambda (st p)
            (let ((k (_0 p)))
              (If (getax k ax0)
                ;; replacement: order-membership discipline, per key
                ;; (rare — materializations over aliases)
                (If (includes (Equal k) (subject-order sut))
                  st
                  [(_0 st) (lcons k (_1 st))])
                (If (getax k (_0 st))
                  st
                  [(putax k 1 (_0 st)) (lcons k (_1 st))]))))
          [empty-ax 0] pairs)))))
  (If (Sz joins)
    (set-subject-order (Weld (subject-order sut2) joins) sut2)
    sut2))
(define wack-span [0 0 0 0])

(define (insert-ffi key val ty sut)
  (define tc (tc-ffi ty val))
  (insert-tc key wack-span tc sut))

(define (unpin-soft x)
  (If (IsPin x) (Unpin x) x))

;;; Unit-qualified canonical paths

;; The hyphenated segment cannot be written as a Foil source word and the next
;; segment is a content pin, so these hidden storage paths cannot collide with
;; source paths.  Keep the shape beside the other canonical-path helpers;
;; relocation and type expansion must agree on it.
(define unit-storage-tag "foil-unit")

;; unit-qualified-path? :: Path -> Bool
(define (unit-qualified-path? path)
  (And (IsApp path)
    (And (Ge (Sz path) 2)
      (And (Eq unit-storage-tag (Ix 0 path)) (IsPin (Ix 1 path))))))

;; unit-qualified-path-unit :: QualifiedPath -> Pin
(define (unit-qualified-path-unit path)
  (unless (unit-qualified-path? path)
    (error ["foil-relocate-malformed-qualified-path" path])
    (Ix 1 path)))

;; unit-qualified-path-local :: QualifiedPath -> Path
(define (unit-qualified-path-local path)
  (unless (unit-qualified-path? path)
    (error ["foil-relocate-malformed-qualified-path" path])
    (drop 2 path)))

;;; The /ty-ap namespace ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; A specialized generic IS a path: bst[nat] is /ty-ap/1/bst/1/nat — a
;; length-prefixed list of paths (the generic first, then each type
;; argument), self-delimiting so applications nest
;; (bst[list[nat]] = /ty-ap/1/bst/5/ty-ap/1/list/1/nat). Type variables
;; get their own sub-namespace, /ty-var/<name>, so bst[v] inside a
;; generic body is also just a path. The subject resolves /ty-ap paths
;; to the generic's entry; the type layers specialize by the decoded
;; arguments where types are in play (expansion, reference lookup).

(define ty-ap-tag "ty-ap")
(define ty-var-tag "ty-var")
;; /ty-val/<nat>: a compile-time-constant nat literal riding a /ty-ap
;; path as an argument (const generic parameters).
(define ty-val-tag "ty-val")

(define (ty-ap-path? path)
  (And (IsApp path) (And (Gt (Sz path) 0) (Eq ty-ap-tag (Ix 0 path)))))

(define (ty-var-path? path)
  (And (IsApp path) (And (Eq 2 (Sz path)) (Eq ty-var-tag (Ix 0 path)))))

(define (ty-val-path? path)
  (And (IsApp path) (And (Eq 2 (Sz path)) (Eq ty-val-tag (Ix 0 path)))))

(define (ty-ap-encode paths)
  (foldl (lambda (acc p) (Weld acc (Weld [(Sz p)] p))) [ty-ap-tag] paths))

;; -> row of paths (generic first, then args), or 0 if malformed.
;; (the empty row is not an app, so malformed-ness needs a sentinel)
(define ty-ap-bad "ty-ap-bad")
(define (ty-ap-decode path)
  (define n (Sz path))
  (define (walk i)
    (If (Ge i n) []
      (let ((len (Ix i path)))
        (If (Gt (Add (Inc i) len) n)
          ty-ap-bad
          (let ((rest (walk (Add (Inc i) len))))
            (If (Eq ty-ap-bad rest)
              ty-ap-bad
              (Weld [(take len (drop (Inc i) path))] rest)))))))
  (Ifz (ty-ap-path? path) 0
    (let ((parts (walk 1)))
      (If (Eq ty-ap-bad parts) 0 parts))))

assert(Equal ["ty-ap" 1 "bst" 1 "nat"]
  (ty-ap-encode [["bst"] ["nat"]]))
assert(Equal [["bst"] ["nat"]]
  (ty-ap-decode ["ty-ap" 1 "bst" 1 "nat"]))
assert(Equal [["bst"] ["ty-ap" 1 "list" 1 "nat"]]
  (ty-ap-decode (ty-ap-encode [["bst"] (ty-ap-encode [["list"] ["nat"]])])))
assert(Equal 0 (ty-ap-decode ["ty-ap" 9 "bst"]))
assert(ty-var-path? ["ty-var" "v"])

;; Entry lookup is /ty-ap-transparent: an instantiation resolves to its
;; generic's entry (same compiled value; the type layers specialize).
(define (ty-ap-base path)
  (define parts (ty-ap-decode path))
  (Ifz parts 0 (Ix 0 parts)))

(define (resolve-path path)
  (If (ty-ap-path? path)
    (ty-ap-base path)
    path))

;; Full-key-first: a materialized instantiation entry (const generic
;; params) at the exact /ty-ap key wins; otherwise the virtual view
;; resolves to the generic's base entry.  No full keys exist before
;; materialization, so elaboration semantics are unchanged.
(define (get-const name sut)
  (If (ty-ap-path? name)
    (let ((direct (sut-find name sut)))
      (Ifz direct (sut-find (ty-ap-base name) sut) direct))
    (sut-find name sut)))
(define (got-entry path sut)
  (unpin-soft (need (get-const path sut))))
(define (got-const name sut) (need (get-const name sut)))

;; Resolve a public definition moment through the defining layers, never
;; through the importing source's visibility table. Return the private key
;; separately so namespace addresses cannot be mistaken for storage keys.
(define (definition-key identity sut)
  (search-layers (lambda (layer)
    (define context (sut-context layer))
    (define local (If context (contexts:local-definition context identity) 0))
    (define own (If local (root-path layer (_0 local)) 0))
    (If (And own (getax own (sut-ax layer))) [own] 0)) sut))

(define (definition-moment key sut)
  (search-layers (lambda (layer)
    (define unit (sut-context layer))
    (define root (sut-root layer))
    (define own (And unit
      (And (Equal root (take (Sz root) key)) (getax key (sut-ax layer)))))
    (If own (contexts:find-moment unit (drop (Sz root) key)) 0)) sut))

(define (get-definition identity sut)
  (define key (definition-key identity sut))
  (If key (get-const (_0 key) sut) 0))

;; Decode an already-found entry without walking the import graph again.
(define (entry-tc path ent)
  (cond
    ((typed-value? TcEntry ent) (tc-entry-contents ent))
    ;; IR_ENTRY belongs to foil-lower (which imports this module);
    ;; its tc slot stays positional here to avoid a cycle.
    ((Eq (Hd ent) "IR_ENTRY") (_3 ent))
    (else
      (error ("bad entry" path)))))

(define (got-entry-tc path sut)
  (entry-tc path (got-entry path sut)))

(define (print-path x)
  (foldl strWeld "" (map (cork print-nat (strWeld "/")) x)))

(define (get-span name sut)
  (define hit (get-const name sut))
  (Ifz hit 0
    (let ((entry (unpin-soft (_0 hit))))
      (cond
        ((Eq "TC" (Hd entry)) (tc-entry-span entry))
        ((Eq "IR_ENTRY" (Hd entry)) (_1 entry))
        (else (error ["bad span entry" name]))))))

(define (got-span name sut)
  (define res (get-span name sut))
  (Ifz res (error ["bad span lookup" name])
    res))

;;; Imports: merge, mount, canonical names ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Normalize a written path to the entry's own (canonical) name — a
;; mounted import resolves to the same pinned entry, and nominal type
;; identity must not depend on which name the source used.  Entries
;; carry their canonical key at Ix 0 ("TC" and "IR_ENTRY" alike).
;; Visibility on a chained subject is per-layer, like the entries: each
;; Visibility is HEAD-only naming authority (per-compile): the chain
;; carries entries, never names, so canon-path reads the head index
;; directly.

(define (definition-brand sut local)
  (If (sut-context sut)
    (contexts:runtime-brand (sut-context sut) local)
    (error "definition-brand-requires-compilation-context")))

;; Source spelling has its own lookup operation. In particular, a source
;; name beginning with a compiler-storage discriminator gains no privilege.
(define (resolve-source-path path sut)
  (define visible (sut-visible sut))
  (Ifz visible (error "source-resolution-requires-visibility")
    (let ((hit (getax (Weld (sut-root sut) path) visible)))
      (If hit (_0 hit) ["/foil-env/unbound"]))))

(define (canon-path path sut)
  ;; Compiled subjects resolve source spellings only through their explicit
  ;; visibility index. Canonical identity lookup uses definition-key instead.
  ;; Unindexed scratch subjects are used for internal type construction.
  (define (visible-canon p)
    (define vis (sut-visible sut))
    (define root (sut-root sut))
    (If (Nil vis)
      0
      (let ((hit (getax (Weld root p) vis)))
        (Ifz hit
          ;; The compiler snapshots its trusted substrate into this same
          ;; visibility index before overlaying hidden import storage.  A miss
          ;; must therefore stay a miss; consulting raw storage here would
          ;; leak a transitive import when its canonical root is empty.
          ["/foil-env/unbound"]
          (_0 hit)))))
  (cond
    ((ty-var-path? path) path)
    ((ty-ap-path? path)
      (let ((parts (ty-ap-decode path)))
        (Ifz parts
          path
          (ty-ap-encode (map (lambda (p) (canon-path p sut)) parts)))))
    (else
      (let ((visible (visible-canon path)))
        (If visible
          visible
          ;; Rooted-first: a compilation-local declaration shadows a
          ;; substrate builtin of the same name (matching the pre-root
          ;; replace-at-insert semantics).  A miss both ways is a forward
          ;; reference to a declaration of this compilation, which will be
          ;; inserted rooted — so the rooted guess IS its canonical name
          ;; (the wf post-pass still catches genuinely unbound paths).
          (let ((rooted (root-path sut path)))
            (let ((rgot (If (Equal rooted path) 0 (get-const rooted sut))))
              (Ifz rgot
                (let ((got (get-const path sut)))
                  (Ifz got
                    (If (Equal rooted path) path rooted)
                    (_0 (unpin-soft (_0 got)))))
                (_0 (unpin-soft (_0 rgot)))))))))))

;; subject-delta-keys :: Subject -> Subject -> Row Path
;;
;; Imported entries are already present in `base`; generated accessors, own
;; shadows, and const materializations are included whenever their pinned
;; entry differs from the base subject.
(define (subject-delta-keys base final)
  (define (changed? key)
    (define old (getax key (sut-ax base)))
    (define new (gotax key (sut-ax final)))
    (Or (Nil old) (Nil (Equal (need old) new))))
  ;; Walk final's order: under layered subjects the compile's own
  ;; layer holds exactly the writes, so the order IS the write set
  ;; (the slot-7 log this once filtered is retired).
  (filter changed? (subject-order final)))

;; subject-entry-delta :: Subject -> Subject -> Row [Path Pin]
;;
;; Preserve the historical public projection used by callers that only need
;; the changed keys or replacement pins.
(define (subject-entry-delta base final)
  (map (lambda (key) [key (gotax key (sut-ax final))])
    (subject-delta-keys base final)))








