(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)
(#bind cairn (#module cairn))
(#import cairn)

(#bind print (#module print))
(#import print)

(define (tc tag) (strWeld "TC_" tag))
(define tc-ty (Ix 0))
(define set-tc-ty (Up 0))
(define (tc-local ty slot face)
  (tc "LOCAL" ty slot face))
(define tc-local-slot (Ix 1))
(define (tc-global ty path)
  (tc "GLOBAL" ty path))
(define (tc-lit ty lit)
  (tc "LIT" ty lit))
(define tc-lit-val (Ix 1))
(define tc-global-path (Ix 1))
(define (tc-const ty val)
  (tc "CONST" ty val))
(define tc-const-val (Ix 1))
;; A const generic parameter reference inside a generic body — a typed
;; placeholder.  Deliberately has NO lowering case: one leaking past
;; materialization fails loudly.
(define (tc-cparam ty name)
  (tc "CPARAM" ty name))
(define tc-cparam-name (Ix 1))
(define (tc-has-cparam? x)
  (If (IsApp x)
    (If (Eq "TC_CPARAM" (Hd x))
      1
      (any tc-has-cparam? (gen (Sz x) (lambda (i) (Ix i x)))))
    0))
(define (tc-uses-cparam? name x)
  (If (IsApp x)
    (If (Eq "TC_CPARAM" (Hd x))
      (Eq name (Ix 1 x))
      (any (tc-uses-cparam? name) (gen (Sz x) (lambda (i) (Ix i x)))))
    0))
(define (tc-ffi ty val)
  (tc "FFI" ty val))
(define tc-ffi-val (Ix 1))
(define (tc-app ty f x)
  (tc "APP" ty f x))
(define tc-app-f (Ix 1))
(define tc-app-x (Ix 2))
(define (tc-typ ty)
  (tc "TYP" ty))
(define tc-typ-inner (Ix 0))
(define (tc-mean cause)
  (tc "MEAN" cause))

(define (tc-lam ty meta args body)
  (tc "LAM" ty meta args body))
(define tc-lam-args (Ix 2))
(define (tc-lam-arity l) (Sz (Ix 2 l)))
(define tc-lam-body (Ix 3))

(define (tc-letrec ty binds body)
  (tc "LET" ty binds body))
(define tc-letrec-binds (Ix 1))
(define tc-letrec-body (Ix 2))

(define (tc-row ty hd row)
  (tc "ROW" ty hd row))
(define tc-row-hd (Ix 1))
(define tc-row-items (Ix 2))

(define (tc-match ty scrut arms fall)
  (tc "MATCH" ty scrut arms fall))
(define tc-match-scrut (Ix 1))
(define tc-match-arms (Ix 2))
(define tc-match-fall (Ix 3))
;; An arm's key is its runtime dispatch tree ["key" cstr arity kids]:
;; kids has one entry per field — 0 for an unconstrained binder, or a
;; nested key for a nested variant pattern (tested by lower-arm-test).
(define (tc-arm ty pat val key)
  (tc "ARM" ty pat val key))
(define tc-arm-pat (Ix 1))
(define tc-arm-val (Ix 2))
(define tc-arm-key (Ix 3))



;; A subject is ("SUT" ax order tvars root unit visible).  The axal accepts
;; total-ordered PLAN path segments, including unit-identity pins.  The first four
;; fields are the historical ABI.  `unit` is the optional union-mount unit
;; record retained for tooling, and `visible` is either 0 (legacy lookup) or
;; an AX mapping rooted source paths to canonical storage paths.  Keeping
;; visibility separate from storage lets prefix-mounted code retain the
;; canonical entries needed for linking and type expansion without leaking
;; those entries as unqualified source names.
;;
;; Older four-field subjects are still readable through the tolerant
;; accessors below; every subject constructed here uses the extended shape.
;;
;; The root is the
;; compilation's namespace prefix: entry keys are stored rooted, source
;; references resolve relative to it (canon-path), and row brands are
;; therefore real namespace paths.  The boot process (builtins and the
;; modules compiled against them) lives at /boot; an empty root is the
;; unrooted (test/legacy) subject.
(define sut-tvar (Ix 2))
(define set-sut-tvar (Up 2))
(define (sut-get-tvar? tvar sut) (find-idx (Eq tvar) (sut-tvar sut)))
(define (sut-put-tvar tvar sut) (snap 2 (snoc tvar) sut))
(define sut-root (Ix 3))
(define set-sut-root (Up 3))
(define (root-path sut p) (Weld (sut-root sut) p))

;; sut-unit :: Subject -> Unit | 0
(define (sut-unit sut)
  (If (Gt (Sz sut) 4) (Ix 4 sut) 0))

;; sut-visible :: Subject -> Ax CanonPath | 0
(define (sut-visible sut)
  (If (Gt (Sz sut) 5) (Ix 5 sut) 0))

;; upgrade-subject :: Subject -> Subject
;;
;; `Up` leaves an application unchanged when its index is out of range.  A
;; direct write to slot 4 or 5 therefore cannot extend a retained historical
;; four-field subject.  Rebuild old/intermediate values in the current shape
;; before either extended-field setter runs; current and future wider subjects
;; pass through unchanged.
(define (upgrade-subject sut)
  (If (And (IsApp sut)
        (And (Eq "SUT" (Hd sut)) (Ge (Sz sut) 4)))
    (If (Gt (Sz sut) 5)
      sut
      ("SUT" (_0 sut) (Ix 1 sut) (Ix 2 sut) (Ix 3 sut)
        (If (Gt (Sz sut) 4) (Ix 4 sut) 0)
        0))
    (error ["foil-malformed-subject" sut])))

;; set-sut-unit :: Unit | 0 -> Subject -> Subject
(define (set-sut-unit unit sut) (Up 4 unit (upgrade-subject sut)))

;; set-sut-visible :: Ax CanonPath | 0 -> Subject -> Subject
(define (set-sut-visible visible sut) (Up 5 visible (upgrade-subject sut)))

(define (make-subject ax) ("SUT" ax 0 0 [] 0 0))
(define subject-order Ix1)
(define set-subject-order (Up 1))
(define (push-subject-order name sut)
  (set-subject-order (snoc name (subject-order sut)) sut))
(define (pop-subject-order sut)
  (define ord (subject-order sut))
  [(_0 ord) (set-subject-order (drop 1 ord) sut)])
(define empty-subject (make-subject empty-ax))
;; Replacing an existing entry must not duplicate its key in the order:
;; the order is a set, and passes that walk it (e.g. lowering) rely on
;; visiting each entry once.  A key absent from the ax cannot be in the
;; order (the order is a subset of the ax keys), so the fresh-key path
;; — every new declaration and generated accessor — skips the linear
;; order scan; only genuine replacements (reopens, materializations
;; over aliases) pay it.
(define (insert-entry-sut key val sut)
  (define fresh (Ifz (getax key (Ix 0 sut)) 1 0))
  (define sut1 (snap 0 (putax key (Pin val)) sut))
  (cond
    (fresh (push-subject-order key sut1))
    ((includes (Equal key) (subject-order sut1)) sut1)
    (else (push-subject-order key sut1))))

;; put-entry-pin :: Path -> Pin Entry -> Subject -> Subject
;;
;; Overlay one already-pinned entry without re-pinning it.  Replacement keeps
;; the existing deterministic order slot; a fresh canonical entry joins the
;; order exactly once.
(define (put-entry-pin key pin sut)
  (define fresh (Ifz (getax key (_0 sut)) 1 0))
  (define sut1 (snap 0 (putax key pin) sut))
  (If fresh (push-subject-order key sut1) sut1))

;; overlay-subject :: [Path] -> Subject -> Subject -> Subject
;;
;; Top-biased storage projection used by the union-mount compiler.  Name
;; visibility and warning policy live in foil-env; this helper only makes the
;; winning compiled entries available for linking and type expansion.
(define (overlay-subject keys upper lower)
  (foldl
    (lambda (acc key) (put-entry-pin key (gotax key (_0 upper)) acc))
    lower keys))

;; graft-subject :: Path -> [Path] -> Subject -> Subject -> Subject
;;
;; Prefix-mount only: graft the layer's own entries below `prefix` without
;; also unioning their canonical names at the root.  The stored entry keeps
;; its canonical key, so canon-path can normalize the mounted spelling.
(define (graft-subject prefix keys upper lower)
  (define root (sut-root lower))
  (define nroot (Sz root))
  (foldl
    (lambda (acc key)
      (let ((mounted (Weld root (Weld prefix (drop nroot key)))))
        (snap 0 (putax mounted (gotax key (_0 upper))) acc)))
    lower keys))

;; mark-visible :: Path -> Path -> Subject -> Subject
(define (mark-visible written canonical sut)
  ;; `sut-visible` is the AX itself, not a Maybe-wrapped AX.  Using `fall`
  ;; here unwrapped the first AX field after the first insertion and silently
  ;; discarded the accumulated visibility map.
  (define vis (Ifz (sut-visible sut) empty-ax (sut-visible sut)))
  (set-sut-visible (putax written canonical vis) sut))
(define (make-tc-entry key span tc)
  ("TC" key tc span))
(define tc-entry-contents (Ix 1))
(define tc-entry-span (Ix 2))
(define (insert-tc key span tc sut)
  (define ent (make-tc-entry key span tc))
  (insert-entry-sut key ent sut))
(define wack-span [0 0 0 0])

(define (insert-ffi key val ty sut)
  (define tc (tc-ffi ty val))
  (insert-tc key wack-span tc sut))

;; A navigation-only alias: the entry pinned at target also resolves
;; at key.  Mount-style — the alias never joins the order, and
;; canon-path normalizes through it to the target's canonical name.
(define (alias-entry key target sut)
  (snap 0 (putax key (gotax target (Ix 0 sut))) sut))

(define (unpin-soft x)
  (If (IsPin x) (Unpin x) x))

;;; Unit-qualified canonical paths

;; The hyphenated segment cannot be written as a Foil source word and the next
;; segment is a content pin, so these hidden storage paths cannot collide with
;; source paths.  Keep the shape beside the other canonical-path helpers;
;; relocation and type expansion must agree on it.
(define unit-storage-tag "foil-unit")

;; unit-qualified-path? :: Path -> Bool
(define (unit-qualified-path? path)
  (And (IsApp path)
    (And (Ge (Sz path) 2)
      (And (Eq unit-storage-tag (Ix 0 path)) (IsPin (Ix 1 path))))))

;; unit-qualified-path-unit :: QualifiedPath -> Pin
(define (unit-qualified-path-unit path)
  (unless (unit-qualified-path? path)
    (error ["foil-relocate-malformed-qualified-path" path])
    (Ix 1 path)))

;; unit-qualified-path-local :: QualifiedPath -> Path
(define (unit-qualified-path-local path)
  (unless (unit-qualified-path? path)
    (error ["foil-relocate-malformed-qualified-path" path])
    (drop 2 path)))

;;; The /ty-ap namespace ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; A specialized generic IS a path: bst[nat] is /ty-ap/1/bst/1/nat — a
;; length-prefixed list of paths (the generic first, then each type
;; argument), self-delimiting so applications nest
;; (bst[list[nat]] = /ty-ap/1/bst/5/ty-ap/1/list/1/nat). Type variables
;; get their own sub-namespace, /ty-var/<name>, so bst[v] inside a
;; generic body is also just a path. The subject resolves /ty-ap paths
;; to the generic's entry; the type layers specialize by the decoded
;; arguments where types are in play (expansion, reference lookup).

(define ty-ap-tag "ty-ap")
(define ty-var-tag "ty-var")
;; /ty-val/<nat>: a compile-time-constant nat literal riding a /ty-ap
;; path as an argument (const generic parameters).
(define ty-val-tag "ty-val")

(define (ty-ap-path? path)
  (And (IsApp path) (And (Gt (Sz path) 0) (Eq ty-ap-tag (Ix 0 path)))))

(define (ty-var-path? path)
  (And (IsApp path) (And (Eq 2 (Sz path)) (Eq ty-var-tag (Ix 0 path)))))

(define (ty-val-path? path)
  (And (IsApp path) (And (Eq 2 (Sz path)) (Eq ty-val-tag (Ix 0 path)))))

(define (ty-ap-encode paths)
  (foldl (lambda (acc p) (Weld acc (Weld [(Sz p)] p))) [ty-ap-tag] paths))

;; -> row of paths (generic first, then args), or 0 if malformed.
;; (the empty row is not an app, so malformed-ness needs a sentinel)
(define ty-ap-bad "ty-ap-bad")
(define (ty-ap-decode path)
  (define n (Sz path))
  (define (walk i)
    (If (Ge i n) []
      (let ((len (Ix i path)))
        (If (Gt (Add (Inc i) len) n)
          ty-ap-bad
          (let ((rest (walk (Add (Inc i) len))))
            (If (Eq ty-ap-bad rest)
              ty-ap-bad
              (Weld [(take len (drop (Inc i) path))] rest)))))))
  (Ifz (ty-ap-path? path) 0
    (let ((parts (walk 1)))
      (If (Eq ty-ap-bad parts) 0 parts))))

assert(Equal ["ty-ap" 1 "bst" 1 "nat"]
  (ty-ap-encode [["bst"] ["nat"]]))
assert(Equal [["bst"] ["nat"]]
  (ty-ap-decode ["ty-ap" 1 "bst" 1 "nat"]))
assert(Equal [["bst"] ["ty-ap" 1 "list" 1 "nat"]]
  (ty-ap-decode (ty-ap-encode [["bst"] (ty-ap-encode [["list"] ["nat"]])])))
assert(Equal 0 (ty-ap-decode ["ty-ap" 9 "bst"]))
assert(ty-var-path? ["ty-var" "v"])

;; Entry lookup is /ty-ap-transparent: an instantiation resolves to its
;; generic's entry (same compiled value; the type layers specialize).
(define (ty-ap-base path)
  (define parts (ty-ap-decode path))
  (Ifz parts 0 (Ix 0 parts)))

(define (resolve-path path)
  (If (ty-ap-path? path)
    (ty-ap-base path)
    path))

;; Full-key-first: a materialized instantiation entry (const generic
;; params) at the exact /ty-ap key wins; otherwise the virtual view
;; resolves to the generic's base entry.  No full keys exist before
;; materialization, so elaboration semantics are unchanged.
(define (get-const name sut)
  (If (ty-ap-path? name)
    (let ((direct (getax name (_0 sut))))
      (Ifz direct (getax (ty-ap-base name) (_0 sut)) direct))
    (getax name (_0 sut))))
(define (got-entry path sut)
  (unpin-soft (need (get-const path sut))))
(define (got-const name sut) (need (get-const name sut)))

(define (got-entry-tc path sut)
  (define ent (got-entry path sut))
  (cond
    ((Eq (Hd ent) "TC") (_1 ent))
    ((Eq (Hd ent) "IR_ENTRY") (_3 ent))
    (else
      (error ("bad entry" path)))))

(define (got-type path sut)
  (define tc (got-entry-tc path sut))
  (define ent (got-entry path sut))
  (unless (Eq (Hd tc) "TC_TYP") (error ("bad type" path (Hd tc)))
    (_0 (tc-typ-inner tc))))

(define (print-path x)
  (foldl strWeld "" (map (cork print-nat (strWeld "/")) x)))

(define (bind-span x)
  (define ty (_4 x))
  ; (print ("bind-span" x ty))
  (If (Eq (Hd ty) "/foil/types/ttyp") (_0 ty) 0))


(define (get-span name sut)
  (define entry (get-const name sut))
  (Ifz entry 0
    (bind-span (_0 entry))))

(define (got-span name sut)
  (define res (get-span name sut))
  (Ifz res (error ["bad span lookup" name])
    res))

;;; Imports: merge, mount, canonical names ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Normalize a written path to the entry's own (canonical) name — a
;; mounted import resolves to the same pinned entry, and nominal type
;; identity must not depend on which name the source used.  Entries
;; carry their canonical key at Ix 0 ("TC" and "IR_ENTRY" alike).
(define (canon-path path sut)
  ;; path-prefix? :: Path -> Path -> Bool
  (define (path-prefix? prefix whole)
    (And (Le (Sz prefix) (Sz whole))
      (Equal prefix (take (Sz prefix) whole))))
  ;; Legacy subjects infer visibility from storage.  A union-mount subject
  ;; has an explicit visible-path index: relative source names must pass
  ;; through it, while already-canonical rooted paths remain available to
  ;; compiler internals (type expansion and symbolic global edges).
  (define (visible-canon p)
    (define vis (sut-visible sut))
    (define root (sut-root sut))
    (define absolute? (And (Sz root) (path-prefix? root p)))
    (If (Or (Nil vis) absolute?)
      0
      (let ((hit (getax (Weld root p) vis)))
        (Ifz hit
          ;; The compiler snapshots its trusted substrate into this same
          ;; visibility index before overlaying hidden import storage.  A miss
          ;; must therefore stay a miss; consulting raw storage here would
          ;; leak a transitive import when its canonical root is empty.
          ["/foil-env/unbound"]
          (_0 hit)))))
  (cond
    ((ty-var-path? path) path)
    ((ty-ap-path? path)
      (let ((parts (ty-ap-decode path)))
        (Ifz parts
          path
          (ty-ap-encode (map (lambda (p) (canon-path p sut)) parts)))))
    (else
      (let ((visible (visible-canon path)))
        (If visible
          visible
          ;; Rooted-first: a compilation-local declaration shadows a
          ;; substrate builtin of the same name (matching the pre-root
          ;; replace-at-insert semantics).  A miss both ways is a forward
          ;; reference to a declaration of this compilation, which will be
          ;; inserted rooted — so the rooted guess IS its canonical name
          ;; (the wf post-pass still catches genuinely unbound paths).
          (let ((rooted (root-path sut path)))
            (let ((rgot (If (Equal rooted path) 0 (get-const rooted sut))))
              (Ifz rgot
                (let ((got (get-const path sut)))
                  (Ifz got
                    (If (Equal rooted path) path rooted)
                    (_0 (unpin-soft (_0 got)))))
                (_0 (unpin-soft (_0 rgot)))))))))))

;; Merge a compiled module's declared entries into sut at their
;; canonical paths.  An identical entry at an occupied path is the
;; diamond-import case and dedupes; a differing one is a collision.
(define (merge-subject blurb keys imp sut)
  (define (merge-one acc key)
    (define pin (gotax key (_0 imp)))
    (define mine (getax key (_0 acc)))
    (cond
      ((Ifz mine 1 0)
        ;; The order is a subset of the ax keys, so a key absent from
        ;; the ax cannot be in the order — push without scanning it
        ;; (the scan made merging K keys O(K^2)).
        (push-subject-order key (snap 0 (putax key pin) acc)))
      ((Equal (need mine) pin) acc)
      (else
        (error ["foil-import-collision" ["path" key] ["at" blurb]]))))
  (foldl merge-one sut keys))

;; Mount: the same pinned entries additionally reachable under a path
;; prefix.  Navigation only — mounted names never join the order (the
;; entries are already lowered under their canonical names) and types
;; written through them normalize via canon-path.
(define (mount-subject blurb prefix keys imp sut)
  ;; Mounted names live under the root like everything else: the
  ;; canonical key is root ++ decl-path, so the mount is
  ;; root ++ prefix ++ decl-path (source `vec/x` resolves through the
  ;; canon-path root retry).
  (define root (sut-root sut))
  (define (mount-one acc key)
    (define pin (gotax key (_0 imp)))
    (define mkey (Weld root (Weld prefix (drop (Sz root) key))))
    (define mine (getax mkey (_0 acc)))
    (cond
      ((Ifz mine 1 0) (snap 0 (putax mkey pin) acc))
      ((Equal (need mine) pin) acc)
      (else
        (error ["foil-import-collision" ["path" mkey] ["at" blurb]]))))
  (foldl mount-one sut keys))

;; subject-delta-keys :: Subject -> Subject -> Row Path
;;
;; Imported entries are already present in `base`; generated accessors, own
;; shadows, and const materializations are included whenever their pinned
;; entry differs from the base subject.
(define (subject-delta-keys base final)
  (define (changed? key)
    (define old (getax key (_0 base)))
    (define new (gotax key (_0 final)))
    (Or (Nil old) (Nil (Equal (need old) new))))
  (filter changed? (subject-order final)))

;; subject-entry-delta :: Subject -> Subject -> Row [Path Pin]
;;
;; Preserve the historical public projection used by callers that only need
;; the changed keys or replacement pins.
(define (subject-entry-delta base final)
  (map (lambda (key) [key (gotax key (_0 final))])
    (subject-delta-keys base final)))

;; subject-entry-replay-delta :: Subject -> Subject
;;                            -> Row [Path (Maybe Pin) Pin]
;;
;; Artifact replay additionally records the exact old pin (Maybe-wrapped in
;; Cairn's native get shape).  This distinguishes an authorized own-layer
;; replacement from a cache assembled over the wrong import graph.
(define (subject-entry-replay-delta base final)
  (map
    (lambda (key)
      [key (getax key (_0 base)) (gotax key (_0 final))])
    (subject-delta-keys base final)))

;; Replay a module delta without rebuilding or re-pinning its entries.
;;
;; Three-field checked entries authorize a replacement only when the current
;; pin matches the recorded old Maybe Pin.  A current pin already equal to the
;; new value is the idempotent/diamond case.  Historical two-field additions
;; retain their strict insert-or-identical behavior for API compatibility.
(define (apply-entry-delta blurb delta sut)
  (define (collision key expected actual)
    (error ["foil-artifact-collision" ["path" key]
            ["expected" expected] ["actual" actual] ["at" blurb]]))
  (define (apply-legacy acc pair)
    (define key (_0 pair))
    (define pin (_1 pair))
    (define mine (getax key (_0 acc)))
    (cond
      ((Nil mine) (put-entry-pin key pin acc))
      ((Equal (need mine) pin) acc)
      (else (collision key 0 mine))))
  (define (apply-checked acc pair)
    (define key (_0 pair))
    (define expected (_1 pair))
    (define pin (_2 pair))
    (define mine (getax key (_0 acc)))
    (cond
      ((Equal expected mine) (put-entry-pin key pin acc))
      ((And mine (Equal (need mine) pin)) acc)
      (else (collision key expected mine))))
  (define (apply-one acc pair)
    (cond
      ((Eq 2 (Sz pair)) (apply-legacy acc pair))
      ((Eq 3 (Sz pair)) (apply-checked acc pair))
      (else (error ["foil-malformed-entry-delta" pair]))))
  (foldl apply-one sut delta))






