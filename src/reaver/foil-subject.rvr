(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)
(#bind cairn (#module cairn))
(#import cairn)

(#bind print (#module print))
(#import print)

(define (tc tag) (strWeld "TC_" tag))
(define tc-ty (Ix 0))
(define set-tc-ty (Up 0))
(define (tc-local ty slot face)
  (tc "LOCAL" ty slot face))
(define tc-local-slot (Ix 1))
(define (tc-global ty path)
  (tc "GLOBAL" ty path))
(define (tc-lit ty lit)
  (tc "LIT" ty lit))
(define tc-lit-val (Ix 1))
(define tc-global-path (Ix 1))
(define (tc-const ty val)
  (tc "CONST" ty val))
(define tc-const-val (Ix 1))
(define (tc-ffi ty val)
  (tc "FFI" ty val))
(define tc-ffi-val (Ix 1))
(define (tc-app ty f x)
  (tc "APP" ty f x))
(define tc-app-f (Ix 1))
(define tc-app-x (Ix 2))
(define (tc-typ ty)
  (tc "TYP" ty))
(define tc-typ-inner (Ix 0))
(define (tc-mean cause)
  (tc "MEAN" cause))

(define (tc-lam ty meta args body)
  (tc "LAM" ty meta args body))
(define tc-lam-args (Ix 2))
(define (tc-lam-arity l) (Sz (Ix 2 l)))
(define tc-lam-body (Ix 3))

(define (tc-letrec ty binds body)
  (tc "LET" ty binds body))

(define (tc-row ty hd row)
  (tc "ROW" ty hd row))
(define tc-row-hd (Ix 1))
(define tc-row-items (Ix 2))

(define (tc-match ty scrut arms fall)
  (tc "MATCH" ty scrut arms fall))
(define tc-match-scrut (Ix 1))
(define tc-match-arms (Ix 2))
(define tc-match-fall (Ix 3))
(define (tc-arm ty pat val)
  (tc "ARM" ty pat val))
(define tc-arm-pat (Ix 1))
(define tc-arm-val (Ix 2))



;; A subject is ("SUT" ax order tvars).
(define sut-tvar (Ix 2))
(define set-sut-tvar (Up 2))
(define (sut-get-tvar? tvar sut) (find-idx (Eq tvar) (sut-tvar sut)))
(define (sut-put-tvar tvar sut) (snap 2 (snoc tvar) sut))

(define (make-subject ax) ("SUT" ax 0 0))
(define subject-order Ix1)
(define set-subject-order (Up 1))
(define (push-subject-order name sut)
  (set-subject-order (snoc name (subject-order sut)) sut))
(define (pop-subject-order sut)
  (define ord (subject-order sut))
  [(_0 ord) (set-subject-order (drop 1 ord) sut)])
(define empty-subject (make-subject empty-ax))
;; Replacing an existing entry must not duplicate its key in the order:
;; the order is a set, and passes that walk it (e.g. lowering) rely on
;; visiting each entry once.
(define (insert-entry-sut key val sut)
  (define sut1 (snap 0 (putax key (Pin val)) sut))
  (If (includes (Equal key) (subject-order sut1))
    sut1
    (push-subject-order key sut1)))
(define (make-tc-entry key span tc)
  ("TC" key tc span))
(define tc-entry-contents (Ix 1))
(define tc-entry-span (Ix 2))
(define (insert-tc key span tc sut)
  (define ent (make-tc-entry key span tc))
  (insert-entry-sut key ent sut))
(define wack-span [0 0 0 0])

(define (insert-ffi key val ty sut)
  (define tc (tc-ffi ty val))
  (insert-tc key wack-span tc sut))

(define (unpin-soft x)
  (If (IsPin x) (Unpin x) x))
(define (got-entry path sut)
  (unpin-soft (gotax path (_0 sut))))
(define (get-const name sut) (getax name (_0 sut)))
(define (got-const name sut) (need (get-const name sut)))

(define (got-entry-tc path sut)
  (define ent (got-entry path sut))
  (cond
    ((Eq (Hd ent) "TC") (_1 ent))
    ((Eq (Hd ent) "IR_ENTRY") (_3 ent))
    (else
      (error ("bad entry" path ent)))))

(define (got-type path sut)
  (define tc (got-entry-tc path sut))
  (define ent (got-entry path sut))
  (unless (Eq (Hd tc) "TC_TYP") (error ("bad type" tc ent path sut))
    (_2 (tc-typ-inner tc))))

(define (print-path x)
  (foldl strWeld "" (map (cork print-nat (strWeld "/")) x)))

(define (bind-span x)
  (define ty[_ tag val] (_4 x))
  ; (print ("bind-span" x ty))
  (If (Eq tag "TTYP") val 0))


(define (get-span name sut)
  (define entry (get-const name sut))
  (Ifz entry 0
    (bind-span (_0 entry))))

(define (got-span name sut)
  (define res (get-span name sut))
  (Ifz res (error ["bad span lookup" name sut])
    res))






