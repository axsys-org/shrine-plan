(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind publication (#module foil-publication))
(#bind bootstrap (#module foil-bootstrap))
(#bind source (#module foil-source))
(#bind driver (#module foil-new-env))
(#bind contexts (#module foil-context))
(#bind brand (#module shrine-brand))
(define compiler (Pin "vocabulary-test"))
(define system-plan (publication:prepare-system compiler source:read-module bootstrap:system-roots))
(define system (publication:compile system-plan driver:empty-foil-cache))
(define (run owner)
  (define (resolve name)
    (define found (find (lambda (pair) (Equal name (_0 pair))) bootstrap:system-roots))
    (If found (_1 (_0 found)) [["x" owner] ["ts" "moved"] ["ts" name]]))
  (define plan (source:prepare-publication
    (contexts:publication-key (publication:compilation-context system-plan))
    compiler resolve (_2 system) (lambda (path) 0) ["system_vocabulary" "runtime_context" "slot_presentation"]))
  (define compiled (publication:compile plan (_1 system)))
  (define (module name)
    (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_2 compiled))))))
  (define (get name) (driver:get-perc (Weld ["system_vocabulary"] name) (module "system_vocabulary")))
  (define machinery (driver:get-perc ["slot_presentation" "machinery"] (module "slot_presentation")))
  (define expected [("ts" "sys") ("ts" "face")])
  assert(Equal expected (get ["face"]))
  assert(Equal [("x" owner) ("ts" "kook") ("ts" "pact")]
    ((driver:get-perc ["runtime_context" "service"] (module "runtime_context"))
      [("ts" "kook") ("ts" "pact")]))
  assert(Equal [("ts" "sys") ("ts" "version") ("ts" "x_data")]
    (get ["version" "x_data"]))
  assert(Equal (get ["fs" "source" "status"])
    ((get ["source_slot"]) ("ts" "status")))
  assert(Eq 1 (machinery [("ts" "sys") ("ts" "form")]))
  assert(Eq 0 (machinery [("ts" "sys") ("ts" "unrelated")]))
  assert(Eq 0 (machinery [("ts" "sys") ("ts" "help")]))
  assert(Eq 0 (machinery (get ["content"])))
  0)
assert(Equal 0 (run 17))
assert(Equal 0 (run 29))
