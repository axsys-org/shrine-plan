(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind fixture (#module foil-test-context))
(#bind source (#module foil-source))
(#bind pub (#module foil-publication))
(#bind driver (#module foil-new-env))
(#bind context (#module foil-context))
(#bind bootstrap (#module foil-bootstrap))

;; Retain the real Semidoc artifact, not a schema-compatible stand-in. The
;; adapter can follow publication; Semidoc's parser and contracts stay captured.
(define (read generation name)
  (If (Equal name "semidoc_editor")
    (rex:ParseRexNormFile (strcat ["- semidoc
- goo_text
+ generation " (showNat generation) "
+ bindings
  \ record=myth
  ^ nat
  ?> saved=sattr/occurrences record.pail_at(['flow 'bind]) 0
  | saved.values.len
+ parse_record
  \ text=nat
  ^ myth
  | node_myth (parse text).at(0)
+ source_from
  \ record=myth
  ^ nat
  ?> (./some node) (node_back (axal/new[myth] (./some record))) 0
  | unparse [node]
+ source_edit
  \ text=nat record=myth
  ^ myth
  | node_myth (snode/prose text (attrs_back record))
+ goo_edit
  \ text=nat record=myth
  ^ myth
  | record.put(['text] (goo/text/pail (goo/text/en (str/from_atom text))))
"]))
    (source:read-module name)))
(define (check ignored)
  (define first-plan (fixture:prepare (read 1) driver:empty-foil-cache
    ["semidoc" "semidoc_editor"]))
  (define first (pub:compile first-plan driver:empty-foil-cache))
  (define images (_2 first))
  (define (image name artifacts)
    (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) artifacts)))))
  (define original (image "semidoc_editor" images))
  (define authored ";@ /flow/bind pages document
  ;@ /flow/bind sources captured
  Anchor")
  (define record ((driver:get-perc ["parse_record"] original) authored))
  (define original-source ((driver:get-perc ["source_from"] original) record))
  (define initial-context (pub:compilation-context first-plan))
  (define core-images (foldl (lambda (out binding)
    (define artifact (context:artifact initial-context (_0 binding)))
    (If artifact (snoc [(_0 binding) (_0 artifact)] out) out))
    [] bootstrap:system-roots))
  (define dependencies (filter (lambda (pair)
    (Nil (includes (Equal (_0 pair)) ["semidoc" "semidoc_editor"]))) images))
  (define retained (source:pinned-imports ["semidoc"] images))
  (define (prepare generation keep)
    (source:prepare-publication-with
      (lambda (name)
        (If (And keep (Equal name "semidoc"))
          (error "retained-semidoc-source-must-not-be-read") (read generation name)))
      fixture:system fixture:compiler fixture:root
      (Weld (If keep retained []) (Weld core-images dependencies))
      (lambda (path) 1) ["semidoc" "semidoc_editor"]))
  (define second (pub:compile (prepare 2 1) driver:empty-foil-cache))
  (define current (image "semidoc_editor" (_2 second)))
  (assert-impl "new adapter follows publication" (Eq 2 (driver:get-perc ["generation"] current)))
  (assert-impl "old adapter remains captured" (Eq 1 (driver:get-perc ["generation"] original)))
  (assert-impl "old repeated bindings retain their exact native contract"
    (Eq 2 ((driver:get-perc ["bindings"] current) record)))
  (assert-impl "new adapter preserves old authored relationships"
    (Equal original-source ((driver:get-perc ["source_from"] current) record)))
  (define edited ((driver:get-perc ["source_edit"] current) "Edited" record))
  (assert-impl "source editing retains repeated bindings"
    (Eq 2 ((driver:get-perc ["bindings"] current) edited)))
  (define rich ((driver:get-perc ["goo_edit"] current) "Rich edit" edited))
  (assert-impl "native Goo text editing retains repeated bindings"
    (Eq 2 ((driver:get-perc ["bindings"] current) rich)))
  (define reparsed ((driver:get-perc ["parse_record"] current)
    ((driver:get-perc ["source_from"] current) rich)))
  (assert-impl "native rich text returns through Semidoc with both bindings"
    (Eq 2 ((driver:get-perc ["bindings"] current) reparsed)))
  (assert-impl "pinning excludes original Semidoc definitions from replacement"
    (all (lambda (entry)
      (Nil (Equal (fixture:root "semidoc")
        (take (Sz (fixture:root "semidoc")) (_0 entry)))))
      (pub:definition-records second)))
  (define distinct (pub:compile (prepare 3 0) driver:empty-foil-cache))
  (define unpinned (image "semidoc_editor" (_2 distinct)))
  (assert-impl "identical Semidoc source without its artifact has distinct occurrences"
    (Eq 0 ((driver:get-perc ["bindings"] unpinned) record)))
  (assert-impl "unpinned control still accepts its own new occurrences"
    (Eq 2 ((driver:get-perc ["bindings"] unpinned)
      ((driver:get-perc ["parse_record"] unpinned) authored))))
  1)
