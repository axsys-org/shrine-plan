
(#bind reef (#module reef))
(#import reef)
(#bind bits (#module bits))
(#import bits)
(#bind prop (#module prop))
(#import prop)

(define (is-i128? x) (lte (Bytes x) 16))

(define (u128-not x) (bit-not 128 x))

(define (i128-nat x)
  (Mod x (Bex 127)))

(define (i128-is-negative? x)
  (Test 127 x))

(define (i128-positive x)
  (Mod x (Bex 127)))
(define mk-pos i128-positive)

(define (i128-mag x)
  (If (i128-is-negative? x) (u128-not (Dec x)) x))
(define mag i128-mag)


(define (i128-is-positive? x)
  (Nil (i128-is-negative? x)))
(define is-pos i128-is-positive?)
(define (i128-negative x)
  (Inc (u128-not (mk-pos x))))
(define mk-neg i128-negative)
(define is-neg i128-is-negative?)

(define (i128-negate x)
  (If (is-neg x) (mk-pos (mag x))
    (mk-neg (mag x))))
(define negate i128-negate)

(define (gen-i128 words)
  (define w[one two tri qua] (Row 0 4 (ltake 4 words)))
  [(ldrop 4 words) (foldr 0 Add [one (Lsh 32 two) (Lsh 64 tri) (Lsh 96 qua)])])


(define (i128-print x)
  (strWeld (If (i128-is-negative? x) "-" "") (showNat (i128-mag x))))

; (define (invariants x)
  ; assert()
(define (i128-add-tie sub x y)
  (cond
    ((And (is-neg x) (is-neg y))
      (mk-neg (Add (i128-mag x) (i128-mag y))))
    ((is-neg x) (sub y (mag x)))
    ((is-neg y) (sub x (mag y)))
    (else
      (mk-pos (Add (i128-mag x) (i128-mag y))))))

(define (i128-lt x y)
  (cond
    ((And (is-neg x) (is-neg y)) (Gt (mag x) (mag y)))
    ((is-neg y) 0)
    ((is-neg x) 1)
    (else (Lt (mag x) (mag y)))))

(define (i128-lte x y)
  (Or (Eq x y) (i128-lt x y)))

(define (i128-sub x y)
  ;; if x - y
  (cond
    ((is-neg y) (i128-add-tie i128-sub x (mag y)))
    ;((And (is-neg y) (is-neg x)) (mk-neg (Add (mag x) (mag y))))
    ; -3 - 4
    ((is-neg x) (i128-add-tie i128-sub x (mk-pos (mag y))))
    ;; neither -ve, check for underflow
    ((Gt (mag y) (mag x)) (mk-neg (Sub (mag y) (mag x))))
    (else (mk-pos (Sub (mag x) (mag y))))))

(define i128-add (i128-add-tie i128-sub))

(define test (i128-sub (mk-neg 3) (mk-neg 7)))

(define (i128-mul x y)
  (define construct
    (If (Eq (is-neg x) (is-neg y)) mk-pos mk-neg))
  (construct (Mul (mag x) (mag y))))

(define (i128-div x y)
  (define construct
    (If (Eq (is-neg x) (is-neg y)) mk-pos mk-neg))
  (construct (Div (mag x) (mag y))))
assert(Eq 4 test)

; (define (i128-divmod-floor n d)
;   (define r (Mod (mag n) (mag d)))
;   (define q (i128-div (i128-sub n r) d))
;   [q r])
(define (i128-divmod-floor n d)
  (define q0 (i128-div n d))
  (define r0 (i128-sub n (i128-mul q0 d)))
  (If (i128-is-negative? r0)
    [(Dec q0) (i128-add r0 d)]
    [q0 r0]))


(#export
 i128-add
 i128-sub
 i128-mag
 i128-positive
 i128-is-negative?
 i128-is-positive?
 i128-negative
 i128-mul
 i128-div
 i128-negate
 i128-print
 i128-lt
 i128-lte
 i128-divmod-floor
 )
