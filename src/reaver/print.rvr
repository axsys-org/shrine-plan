
(#bind reef (#module reef))
(#import reef)

;;natprinting

(define (str-all f str)
  (lall f (lexplode str)))

(define (pack-class strs)
  (lfoldl (flip Set) 0 (lcatmap lexplode (stream strs))))

(define (in-class char-class i)
  (Test i char-class))

(define (unpack-class ccls)
  (lstrcat
    (lfilter (in-class ccls)
      (ltake (Bits ccls)
        (lrange 0)))))

(define lowers "abcdefghijklmnopqrstuvwxyz")
(define uppers "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
(define digits "0123456789")
(define specials "!#$%&'*+,-./:=?@\^_`|~<>")
(define matchers "()[]{}")
(define alphaNums (lstrcat ~[lowers uppers digits]))
(define tab 9)
(define newline 10)
(define space 32)
(define spaces (lstrcat ~[tab newline space]))
(define semi ";")
(define dquote 34) ; double-quote character

(define lowChrs   (pack-class [lowers]))
(define uprChrs   (pack-class [uppers]))
(define symChrs   (pack-class [lowers uppers digits specials]))
(define spcChrs   (pack-class [spaces]))
(define natChrs   (pack-class [digits]))
(define prnChrs   (pack-class [alphaNums specials matchers spaces semi]))
(define opnChr    (pack-class ["([{"]))
(define alnumChrs (pack-class [alphaNums]))

; (tests
;   ("([{"        (unpack-class opnChr)  )
;   ("0123456789" (unpack-class natChrs) ))

(define (isAlnum c)       (Test c alnumChrs))
(define (isNatChr c)      (Test c natChrs))
(define (isLower c)       (Test c lowChrs))
(define (isUpper c)       (Test c uprChrs))
(define (isSymChr c)      (Test c symChrs))
(define (isSpcChr c)      (Test c spcChrs))
(define (is-print c)       (Test c prnChrs))
(define (strNoneStep f c) (Nil (f c)))
(define (strNone f s)     (str-all (strNoneStep f) s))

(define (is-numeric n) (str-all isNatChr n))
(define (is-print c)       (Test c prnChrs))
(define (is-string n)
  (And (IsNat n)
    (And (Gt (Bytes n) 1)
      (str-all is-print n))))

(define (is-sym-char ch) (Or (isLower ch) (Eq "_" ch)))
(define (is-sym n)
  (And (IsNat n)
    (str-all is-sym-char n)))

(define (print-nat x)
  (If (is-string x) x
    (showNat x)))

; data Doc
;   = Empty
;   | Text String
;   | Line              -- forced newline
;   | Cat Doc Doc       -- concatenate
;   | Nest Int Doc      -- increase indentation after line breaks
;   | Group Doc         -- try flat; if it doesn't fit, break

(define dempty ("empty" 0))
(define (dtext str) ("text" str))
(define dline ("line" 0))
(define (dcat l r) ("cat" l r))
(define (dnest int doc) ("nest" int doc))
(define (dgroup doc) ("group" doc))

(define softline (dgroup dline))

(define spaces (reap " "))

(define (fits width stack[x xs])
  (define ind (_0 x))
  (define flat (_1 x))
  (define doc (_2 x))
  (define (is-hd x) (Eq (Hd doc) x))
  (cond
    ((Eq 0 stack) yes)
    ((Eq 0 width) no)
    ((is-hd "empty") (fits width xs))
    ((is-hd "text") (fits (Sub width (Bytes (_0 doc))) xs))
    ((is-hd "line") (If flat (fits (Dec width) xs) yes))
    ((is-hd "cat")
      (fits width (lcons [ind flat (_0 doc)] (lcons [ind flat (_1 doc)] xs))))
    ((is-hd "nest")
      (fits width (lcons [(Add ind (_0 doc)) flat (_1 doc)] xs)))
    ((is-hd "group")
      (fits width (lcons [ind yes (_0 doc)] xs)))))

(define (drender width doc)
  (define (go col stack[x xs])
    (define s[ind flat doc] x)
    (define (is-hd x) (Eq x (Hd doc)))
    (Ifz stack ""
    (cond
      ((is-hd "empty") (go col xs))
      ((is-hd "text") (strWeld (_0 doc) (go (Add col (Bytes (_0 doc))) xs)))
      ((is-hd "line")
        (If flat (strWeld " " (go (Inc col) xs))
          (strWeld newline (strWeld (spaces ind) (go ind xs)))))
      ((is-hd "cat")
        (go col (lcons [ind flat (_0 doc)] (lcons [ind flat (_1 doc)] xs))))
      ((is-hd "nest")
        (go col (lcons [(Add ind (_0 doc)) flat (_1 doc)] xs)))
      ((is-hd "group")
        ;; NB: with reef's old truthy n this always chose flat mode and
        ;; the renderer never wrapped.
        (If (fits (Sub width col) (lcons [ind yes (_0 doc)] xs))
          (go col (lcons [ind yes (_0 doc)] xs))
          (go col (lcons [ind no (_0 doc)] xs))))
          (else (error [doc "bad tag"])))))
  (go 0 (lcons [0 no doc] 0)))


(define comma (dtext ","))
(define colon (dtext ":"))
(define space (dtext " "))

(define (join-with sep arr[x xs])
  (define (go arr[y ys])
    (Ifz arr dempty
      (dcat (dcat sep y) (go ys))))
  (Ifz arr dempty
    (Ifz xs  x
      (dcat x (go xs)))))
  ;        )
  ; (cond
  ;   ; ((Eq 0 arr) dempty)
  ;   ((Eq 0 (_1 arr)) (_0 x))
  ;   (else ))))


(define (pretty-nat n)
  (dtext (print-nat n)))

(define (pretty-pair pk pv)
  (dgroup (foldl dcat dempty
    [pk colon space pv])))
