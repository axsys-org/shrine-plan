;;;; Minimal live browser interface over the typed Foil HTTP driver.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind http (#module helm-http))
(define sut (foil:compile-mod foil:default-subject "http_demo"))
(define (app p) (foil:source-entry-val p sut))
(define core (helm:helm-pack [0 sut]))
(define (prepare name serial msg)
  (define target [("ts" "data") ("ts" "counter")])
  (cond
    ((And (Eq (_1 msg) "POST") (Eq (_2 msg) "/increment"))
      ("/boot/http_action/write"
        ("/boot/task/vine" target ("/boot/writ/poke" (app ["myth" "new"]))) target "/"))
    ((And (Eq (_1 msg) "GET") (Eq (_2 msg) "/"))
      ("/boot/http_action/wait" [("ts" "io") name ("ts" (strcat ["r" (showNat serial)]))]
        ((app ["http_demo" "req"]) (_1 msg) (_2 msg) (_3 msg) [])))
    (else ("/boot/http_action/reply" ("/boot/http_response" 404 "Not found" "text/plain")))))
(define step (app ["http_driver" "step"]))
(define (worker name) (http:mk-http-worker prepare step name))
(define (start port)
  (define (install state entry)
    (define result ((app ["run_event"])
      ("/boot/task/vine" (_0 entry) ("/boot/writ/make" (_1 entry))) 0 state))
    (If (Eq (Hd result) "/boot/ovum/ripe") (_0 result) (error result)))
  (define seed (foldl install (app ["sov" "new"]) ((app ["http_demo" "seed"]) port)))
  (Seq (DeepSeq [seed (worker ("ts" "http")) http:listener-pump http:conn-actor] 0)
    (Spawn (helm:helm-actor core worker (lambda (hm) 0) seed))))
(print "HTTP demo compiled")
