(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; Zoo selection feeds typed Foundry plan compilation.

(define sut (stage:sut-of "foundry_zoo"))
(define (app path) (foil:source-entry-val path sut))
(define (ts s) ("ts" s))

(define myth-new (app ["myth" "new"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-meld (app ["myth" "meld"]))
(define lore-line (app ["lore" "line"]))
(define weft-spec (app ["weft_spec_make"]))
(define weft-recipe (app ["weft_recipe_stub"]))
(define zoo-entry (app ["zoo" "entry"]))
(define zoo-request (app ["zoo" "make_request"]))
(define f-request (app ["foundry" "make_request"]))
(define f-choice (app ["foundry_zoo" "make_choice"]))
(define f-select (app ["foundry_zoo" "select"]))
(define f-compile (app ["foundry_zoo" "compile"]))
(define f-selected-recipe (app ["foundry_zoo" "selected_recipe"]))
(define f-pronunciation-key (app ["foundry_zoo" "make_pronunciation_key"]))
(define f-select-pronunciation
  (app ["foundry_zoo" "select_pronunciation"]))
(define f-pronunciation-registry
  (app ["foundry_zoo" "make_pronunciation_registry"]))
(define f-pronounce (app ["foundry_zoo" "pronounce"]))
(define f-outcome-primitive (app ["foundry_zoo" "outcome_primitive"]))
(define f-outcome-entry (app ["foundry_zoo" "outcome_entry"]))
(define f-outcome-fallback (app ["foundry_zoo" "outcome_fallback"]))
(define f-outcome-code (app ["foundry_zoo" "outcome_code"]))
(define f-plan-report (app ["foundry" "plan_report"]))
(define f-plan-recipes (app ["foundry" "plan_recipes"]))
(define f-plan-diagnostics (app ["foundry" "plan_diagnostics"]))

(define root [(ts "chat") (ts "weft") (ts "foundry")])
(define role-plate [(ts "projection") (ts "chat") (ts "plate")])
(define role-scene [(ts "projection") (ts "chat") (ts "scene")])
(define role-missing [(ts "projection") (ts "missing")])

(define (entry part role ceiling n)
  (zoo-entry root [part] "foundry-zoo-tests"
    (weft-recipe n [] (lore-line "fixture")
      (weft-spec role "surface-tree" "surface-tree" "full" ceiling
        "neutral" "shrine" "z" [] []))))

(define (entry-shape part role input output backend pronunciation primitive n)
  (define base
    (zoo-entry root [part] "foundry-zoo-tests"
      (weft-recipe n [] (lore-line "algebra fixture")
        (weft-spec role input output "full" "plate" backend pronunciation
          "z" [] []))))
  (If (Eq primitive "")
    base
    (myth-meld
      (myth-sing [(ts "recipe") (ts "primitive")]
        ("/boot/pails/t" primitive))
      base)))

(define plate-entry (entry (ts "plate") role-plate "plate" 1))
(define scene-entry (entry (ts "scene") role-scene "scene" 2))
(define entries [plate-entry scene-entry])
(define plate-q (zoo-request role-plate "full" "plate" "web" "shrine" []))
(define scene-q (zoo-request role-scene "full" "scene" "web" "shrine" []))

(define selected (f-select plate-q (ts "plate") entries))
assert(Equal "/boot/foundry_zoo/outcome/admitted" (Hd selected))
assert(Equal [(ts "chat") (ts "weft") (ts "foundry") (ts "plate")]
  (f-selected-recipe selected))
assert(Equal ("/boot/maybe/some" (ts "sewn"))
  (f-outcome-primitive selected))

(define req
  (f-request [(ts "chat")] [(ts "desktop") (ts "stage")]
    (ts "full") (ts "stage") (ts "web")
    [(ts "pronunciation") (ts "shrine")] []))
(define plan
  (f-compile req
    [(f-choice plate-q (ts "plate")) (f-choice scene-q (ts "scene"))]
    entries))
assert(Eq 2 (Sz (f-plan-recipes plan)))
assert(Eq 0 (Sz (f-plan-diagnostics plan)))
assert(Equal (ts "o") (Ix 0 (f-plan-report plan)))

(define missing-q
  (zoo-request role-missing "full" "block" "web" "shrine" []))
(define refused
  (f-compile req [(f-choice missing-q (ts "block"))] entries))
assert(Equal [(ts "chat")] (f-plan-report refused))
assert(Eq 0 (Sz (f-plan-recipes refused)))
assert(Eq 1 (Sz (f-plan-diagnostics refused)))

;;; Exact Zoo algebra: shape determines dyed, knit, sewn, or felt ;;;;;;;;;;;;;

(define role-refine [(ts "projection") (ts "semantic") (ts "refine")])
(define role-lift [(ts "projection") (ts "semantic") (ts "lift")])
(define role-compose [(ts "projection") (ts "semantic") (ts "compose")])
(define role-terminal [(ts "projection") (ts "semantic") (ts "terminal")])
(define dyed-entry
  (entry-shape (ts "dyed") role-refine "record" "record"
    "neutral" "semantic" "dyed" 10))
(define knit-entry
  (entry-shape (ts "knit") role-lift "record" "surface-tree"
    "neutral" "semantic" "knit" 11))
(define sewn-entry
  (entry-shape (ts "sewn") role-compose "surface-tree" "surface-tree"
    "neutral" "semantic" "sewn" 12))
(define felt-entry
  (entry-shape (ts "felt") role-terminal "surface-tree" "record"
    "text" "plain" "felt" 13))

(define (select-shape role entry)
  (f-select (zoo-request role "full" "plate" "neutral" "semantic" [])
    (ts "plate") [entry]))
assert(Equal ("/boot/maybe/some" (ts "dyed"))
  (f-outcome-primitive (select-shape role-refine dyed-entry)))
assert(Equal ("/boot/maybe/some" (ts "knit"))
  (f-outcome-primitive (select-shape role-lift knit-entry)))
assert(Equal ("/boot/maybe/some" (ts "sewn"))
  (f-outcome-primitive (select-shape role-compose sewn-entry)))

;; A mislabeled record -> subtree operation refuses instead of acquiring sewn
;; behavior merely because its card says so.
(define mismatch-entry
  (entry-shape (ts "mismatch") role-lift "record" "surface-tree"
    "neutral" "semantic" "sewn" 14))
(define mismatch (select-shape role-lift mismatch-entry))
assert(Equal "/boot/foundry_zoo/outcome/refused" (Hd mismatch))
assert(Equal ("/boot/maybe/some" (ts "recipe_algebra_mismatch"))
  (f-outcome-code mismatch))

;;; Generic pronunciation registry: no application role switch ;;;;;;;;;;;;;;;

(define pronunciation
  (f-select-pronunciation
    (f-pronunciation-key role-terminal (ts "text") [(ts "plain")] [] (ts "full")
      (ts "plate"))
    [felt-entry]))
assert(Equal "/boot/foundry_zoo/outcome/admitted" (Hd pronunciation))
assert(Equal ("/boot/maybe/some" (ts "felt"))
  (f-outcome-primitive pronunciation))
assert(Equal [(ts "chat") (ts "weft") (ts "foundry") (ts "felt")]
  (f-selected-recipe pronunciation))

;; One semantic role can be pronounced by two provider packs without changing
;; its role or constructing a second semantic tree.  Backend remains a lookup
;; axis; the selected entries are terminal mechanics.
(define web-terminal
  (entry-shape (ts "felt-web") role-terminal "surface-tree" "record"
    "web" "shrine" "felt" 15))
(define text-terminal
  (entry-shape (ts "felt-text") role-terminal "surface-tree" "record"
    "text" "plain" "felt" 16))
(define terminal-registry
  (f-pronunciation-registry [web-terminal text-terminal]))
(define selected-web
  (f-pronounce
    (f-pronunciation-key role-terminal (ts "web") [(ts "shrine")] []
      (ts "full") (ts "plate"))
    terminal-registry))
(define selected-text
  (f-pronounce
    (f-pronunciation-key role-terminal (ts "text") [(ts "plain")] []
      (ts "full") (ts "plate"))
    terminal-registry))
assert(Equal [(ts "chat") (ts "weft") (ts "foundry") (ts "felt-web")]
  (f-selected-recipe selected-web))
assert(Equal [(ts "chat") (ts "weft") (ts "foundry") (ts "felt-text")]
  (f-selected-recipe selected-text))
assert(Equal "/boot/maybe/some" (Hd (f-outcome-entry selected-web)))
assert(Equal ("/boot/maybe/some" 0) (f-outcome-fallback selected-web))
assert(Equal ("/boot/maybe/some" 0) (f-outcome-fallback selected-text))

;; A compatible non-terminal recipe cannot masquerade as a pronunciation.
(define nonterminal-pronunciation
  (f-select-pronunciation
    (f-pronunciation-key role-compose (ts "neutral") [(ts "semantic")] []
      (ts "full")
      (ts "plate"))
    [sewn-entry]))
assert(Equal "/boot/foundry_zoo/outcome/refused"
  (Hd nonterminal-pronunciation))
assert(Equal ("/boot/maybe/some" (ts "pronunciation_not_terminal"))
  (f-outcome-code nonterminal-pronunciation))

;; Unknown semantic roles refuse; there is no Chat or Web default.
(define unknown-pronunciation
  (f-select-pronunciation
    (f-pronunciation-key [(ts "projection") (ts "unknown")]
      (ts "text") [(ts "plain")] [] (ts "full") (ts "plate"))
    [felt-entry]))
assert(Equal "/boot/foundry_zoo/outcome/refused" (Hd unknown-pronunciation))
assert(Equal ("/boot/maybe/some" (ts "recipe_missing"))
  (f-outcome-code unknown-pronunciation))

(print "foundry Zoo bridge tests passed")
