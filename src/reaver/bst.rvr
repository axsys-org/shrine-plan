

(#bind reef (#module reef))
(#import reef)


(define E 0)
(define bst-sz (Ix 0)) (define set-bst-sz (Up 0))
(define bst-key (Ix 1)) (define set-bst-key (Up 1))
(define bst-val (Ix 2)) (define set-bst-val (Up 2))
(define bst-sin (Ix 3)) (define set-bst-sin (Up 3))
(define bst-dex (Ix 4)) (define set-bst-dex (Up 4))

(define (bst-sing k v)
  (Seq k
    [1 k v 0 0]))


(define (N k v l r)
  (define sz (Inc (Add (bst-sz l) (bst-sz r))))
  (Seq3
    k l r
    [sz k v l r]))

(define (L k v)
  [1 k v 0 0])

(define (single-l k v a r[_ key val b c])
  (N key val (N k v a b) c))

(define (single-r k v lef[_ key val a b] c)
  (N key val a (N k v b c)))


(define (double-l key val a right[_ rkey rval son d])
  ; (define [skey sval b c] son)
  (N (bst-key son) (bst-val son) (N key val a (bst-sin son)) (N rkey rval
  (bst-dex son) d)))

(define (double-r key val left[_ lkey lval a son] d)
  ; (son=[skey sval b c]) ; (define [skey sval b c] son)
  (N (bst-key son) (bst-val son) (N lkey lval a (bst-sin son)) (N key val
  (bst-dex son) d)))



; (tests
  assert(Eq (single-l 7 7 E (L 8 8)) (N 8 8 (L 7 7) E))

  assert(Eq (single-r 7 7 (L 6 6) E) (N 6 6 E (L 7 7)))

  assert(Eq (single-l 7 7 E (N 8 8 E (L 9 9)))
   (N 8 8 (L 7 7) (L 9 9)))

  assert(Eq (single-l 5 5 E (N 8 8 (L 7 7) (L 9 9)))
   (N 8 8 (N 5 5 E (L 7 7)) (L 9 9)))

  assert(Eq (double-l 5 5 E (N 8 8 (L 7 7) (L 9 9)))
   (N 7 7 (L 5 5) (N 8 8 E (L 9 9))))

  assert(Eq (double-r 5 5 (N 2 2 (L 1 1) (L 3 3)) E)
   (N 3 3 (N 2 2 (L 1 1) E) (L 5 5)))


(define (rotate-l k v l r[_ _ _ rl rr])
  (If (Lt (bst-sz rl) (Mul 2 (bst-sz rr)))
    (single-l k v l r)
    (double-l k v l r)))

(define (rotate-r k v l[_ _ _ ll lr] r)
  (If (Lt (bst-sz lr) (Mul 2 (bst-sz ll)))
    (single-r k v l r)
    (double-r k v l r)))

(define (balance k v l r)
  (define lsz (bst-sz l))
  (define rsz (bst-sz r))
  (define xsz (Inc (Add lsz rsz)))
  (define top [xsz k v l r])
  (cond
    ((Le (Add lsz rsz) 1) top)
    ((Ge rsz (Mul 4 lsz)) (rotate-l k v l r))
    ((Ge lsz (Mul 4 rsz)) (rotate-r k v l r))
    (else                 top)))



(define (bst-insert key val x[xsz xkey xval left right])
  (Ifz x (bst-sing key val)
    (Case3 (Cmp key xkey)
      (balance xkey xval (bst-insert key val left) right)
      [(bst-sz x) key val left right]
      (balance xkey xval left (bst-insert key val right)))))


(define (bst-duo k1 v1 k2 v2)
  (bst-insert k2 v2 (bst-sing k1 v1)))

(define (bst-search key tree[_ k v l r])
  (And tree
    (Case3 (Cmp key k)
      (bst-search key l)
      [v]
      (bst-search key r))))

(define (bst-idx k t)
  (_0 (bst-search k t)))

(define (bst-has k t)
  (Truth (bst-search k t)))

(define (bst-map f bst[_ k v l r])
  (And bst
    ((Ix 1 bst) k (f v) (bst-map f l) (bst-map f r))))

(define (bst-from-pairs-list-loop acc list[kv ls])
  (Seq acc
    (Ifz list acc
      (bst-from-pairs-list-loop (bst-insert (_0 kv) (_1 kv) acc) ls))))

(define (bst-gas acc ls)
  (bst-from-pairs-list-loop acc (stream ls)))

(define (bst-from-pairs-list ls)
  (bst-from-pairs-list-loop 0 ls))

(define (bst-from-pairs-row row)
  (bst-from-pairs-list (stream row)))

(define test (bst-sing 1 2))

assert(Eq [2] (bst-search 1 test))
(print (bst-search 1 test))

(define foo (bst-from-pairs-list ~[[1 2] [3 4]]))
assert(Eq [2] (bst-search 1 foo))
assert(Eq [4] (bst-search 3 foo))

(define test-bst
  (pipe E
    (bst-insert "nat" "one")
    (bst-insert "if" "two")
    (bst-insert "add" "three")))

assert(Eq 3 (bst-sz test-bst))



(bst-insert "nat" "one" (bst-insert "add" "bar" E))
(print "succ")
(print "test")

(print "rebuild")

