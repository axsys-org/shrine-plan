;;;; Foil coordinator ordering and native transport integration.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind host (#module helm-actor))
(#bind loader (#module helm-host))
(Seq (define compiled (foil:compile-mod-cached 0 foil:default-subject "helm_actor")) (DeepSeq compiled 0))
(Seq (define sut (_1 compiled)) (DeepSeq sut 0))
(define (entry path) (foil:source-entry-val path sut))
(define run (entry ["helm_actor" "run"]))
(define duties (entry ["helm_actor" "duties"]))
(define turn (entry ["helm_actor" "turn"]))
(define seed (entry ["sov" "new"]))
(define boot (entry ["helm" "boot"]))
(define name ("ts" "worker"))
(define known ("/boot/res/known" (entry ["myth" "new"])))
(define ok ("/boot/rsvp/ok" "/boot/maybe/none"))
(define (logged-send handle msg) (Send 0 ["send" handle msg]))
(define (logged-birth name rec) (Seq (Send 0 ["birth" name]) 22))
(define (logged-persist state) (DeepSeq state (Send 0 ["persist"])))
(define ports
  ("/boot/actor_ports" (lambda (z) "/boot/actor_request/idle")
    logged-birth logged-send host:reply logged-persist host:attempt host:report))
(define before [("/boot/actor_member" name 11)])
(define after
  (duties ports before
    [("/boot/duty/fell" name) ("/boot/duty/birth" name known)
     ("/boot/duty/ack" name ok)]))
(DeepSeq after 0)
assert(Equal [("/boot/actor_member" name 22)] after)
assert(Equal ["send" 11 "/boot/driver_in/die"] (_0 (Recv 0)))
assert(Equal ["birth" name] (_0 (Recv 0)))
assert(Equal ["send" 11 ("/boot/driver_in/ack" ok)] (_0 (Recv 0)))

(define command ("/boot/task/vine" [("ts" "hello")]
  ("/boot/writ/make" (entry ["myth" "new"]))))
(define state (_0 (boot seed)))
(define changed (turn ports ("/boot/maybe/some" name) command state before))
(DeepSeq changed 0)
assert(Equal ["persist"] (_0 (Recv 0)))
assert(Equal ["send" 11 ("/boot/driver_in/ack" (_2 changed))] (_0 (Recv 0)))

;; A runtime exception returns the old state and a failure acknowledgment.
(define reject-ports
  ("/boot/actor_ports" 0 0 logged-send 0 logged-persist
    (lambda (thunk) (host:attempt (lambda (z) (error "poison")))) host:report))
(define failed (turn reject-ports ("/boot/maybe/some" name) command state before))
(DeepSeq failed 0)
assert(Equal state (_0 failed))
assert(Equal ["send" 11 ("/boot/driver_in/ack"
  ("/boot/rsvp/no" ("ts" "task_crashed")))] (_0 (Recv 0)))

;; Initial persistence precedes births; shutdown sends every death before
;; the caller's reply. A fixed receive port makes the loop run one turn.
(define stopping
  ("/boot/actor_ports"
    (lambda (z) ("/boot/actor_envelope" "/boot/actor_request/stop" 0 0))
    logged-birth logged-send host:reply logged-persist host:attempt host:report))
(define seed-event (entry ["run_event"]))
(define io-seed (_0 (seed-event
  ("/boot/task/vine" [("ts" "io") name]
    ("/boot/writ/make" (entry ["myth" "new"]))) 0 seed)))
(Seq (define saved-core (Pin (loader:helm-pack compiled))) (DeepSeq saved-core 0))
((loader:core-run (Unpin saved-core)) stopping io-seed)
assert(Equal ["persist"] (_0 (Recv 0)))
assert(Equal ["birth" name] (_0 (Recv 0)))
(define initial-death (_0 (Recv 0)))
assert(Equal ["send" 22 "/boot/driver_in/die"] initial-death)
assert(Equal ["bye"] (_0 (Recv 0)))
(define loop (entry ["helm_actor" "loop"]))
(loop stopping state [("/boot/actor_member" name 11)
                     ("/boot/actor_member" ("ts" "other") 12)])
assert(Equal ["send" 11 "/boot/driver_in/die"] (_0 (Recv 0)))
assert(Equal ["send" 12 "/boot/driver_in/die"] (_0 (Recv 0)))
assert(Equal ["bye"] (_0 (Recv 0)))

;; The actual actor adapter handles anonymous tasks, history queries,
;; typed reads, crew enumeration, absent handles, and orderly shutdown.
(DeepSeq [run host:receive host:reply host:attempt host:report seed] 0)
(define coord (Spawn (host:actor run (lambda (name self) 0) (lambda (s) 0) seed)))
(SendCaps coord ["task" command] [0])
assert(Equal ["done"] (_0 (Recv 0)))
(SendCaps coord ["query" [("ts" "hello")]] [0])
assert(Equal known (_0 (Recv 0)))
(SendCaps coord ("/boot/driver_out/read" [("ts" "hello")]) [0])
assert(Equal ("/boot/driver_in/qres" [("ts" "hello")] known) (_0 (Recv 0)))
(SendCaps coord ["crew"] [0])
assert(Equal [] (_0 (Recv 0)))
(SendCaps coord ["handle" name] [0])
assert(Equal ["nohandle"] (_0 (Recv 0)))
(SendCaps coord ["stop"] [0])
assert(Equal ["bye"] (_0 (Recv 0)))
(print "helm actor tests passed")
