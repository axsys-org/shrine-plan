;;;; Minimal Eden launcher. System startup policy belongs to Foil.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind compiler (#module foil-new-env))
(#bind source (#module foil-source))
(#bind backend (#module foil-grove-backend))

(define (load-main port config)
  (define compiled (source:compile compiler:empty-foil-cache "eden"))
  ((compiler:get-perc ["eden" "main"] (_1 compiled)) port config))

;; config is reserved. Foil owns installation and actor startup.
(define (start port config)
  (load-main port config))

;; The host supplies source strings and the existing compiler adapter.
;; Eden's Foil entry owns compilation order, imports, publication, and serving.
(define (start-srs port)
  (define prepared (backend:prepare compiler:empty-foil-cache))
  (define compiled (source:compile (_0 prepared) "eden_srs"))
  (define entry (compiler:get-perc ["eden_srs" "main"] (_1 compiled)))
  (entry port
    (read-text-file "grove/sys_slots.grove")
    (read-text-file "grove/sys_types.grove")
    (read-text-file "grove/srs.grove")
    (backend:compile-port (_1 prepared) (_2 prepared))))

(#export load-main start start-srs)
