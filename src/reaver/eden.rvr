;;;; Minimal Eden launcher. System startup policy belongs to Foil.
(#bind std (#module std))
(#import std)
(#bind compiler (#module foil-new-env))
(#bind source (#module foil-source))
(#bind subject (#module foil-subject))

;; Current Foil contract:
;;   eden/main : HTTP port -> reserved configuration -> supervisor handle
;; Eden owns namespace installation and starts the supervisor and HTTP foot.
;; Boot failures raise eden/failed with the failing stage and reason.
;; The broader ports/configuration ABI is still to be designed.
;; x/eden calls start; importing this module only resolves the entry.

;; Compile Eden's import closure and extract its executable entry point.
;; As a value binding, this resolves the entry while loading this module.
(define load-main
  (define compiled (source:compile compiler:empty-foil-cache "eden"))
  (define module (_1 compiled))
  (define path ["eden" "main"])
  (define sut (compiler:perc-subject module))
  (If (subject:get-const (subject:canon-path path sut) sut)
    (compiler:get-perc path module)
    (error ["eden-entry-missing" path
      "Define eden/main in foil/eden.foil before starting this launcher."])))

;; ports is an HTTP port number; config is currently reserved (pass 0).
;; Force the returned handle to start the actor. Do not DeepSeq the cache.
(define (start ports config)
  (load-main ports config))

(#export load-main start)
