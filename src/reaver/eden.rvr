;;;; Generic source-mount bootstrap. Applications are supplied by mounted bags.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind publication (#module foil-publication))
(#bind context (#module foil-context))
(#bind subject (#module foil-subject))
(#bind backend (#module foil-grove-backend))
(#bind bootstrap (#module foil-bootstrap))
(#bind abi (#module foil-abi))
(#bind documentation (#module goo-documentation-bridge))
(#bind value-editor (#module goo-value-bridge))
(#bind world (#module eden-world))

(define (module images name)
  (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) images)))))
(define (merge-images left right)
  (foldl (lambda (out pair)
    (If (find (lambda (other) (Equal (_0 pair) (_0 other))) out) out
      (snoc pair out))) left right))
(define (need-ok result)
  (If (Equal "ok" (Hd result)) (_0 result)
    (error ["mount-publication" (_0 result)])))
(define (qualify self names)
  (Weld [self] (map (lambda (name) ("ts" name)) names)))

;; Spec: name, folder, manifest, modules, Grove units, activation, HTTP,
;; post-start hook, hook arguments, inspection-provider flag, dependencies,
;; required assets, route claims, declarative-workspace flag.
;; Every source read below comes from the mount's captured namespace records.
(define (mounted self system resolve slot port specs scan-port scan-token tier)
  (define local (bootstrap:build-local self system resolve slot
    ["eden" "eden_store" "source_mount" "grove_backend" "grove_role_runtime" "grove_draft"]))
  (define core-code (_1 local))
  (define core-images
    (merge-images (bootstrap:system-images system)
      (merge-images (_2 (bootstrap:publisher-code system)) (_2 core-code))))
  (define core (module core-images "source_mount"))
  (define eden (module core-images "eden"))
  (define (tool path) (driver:get-perc path core))
  (define mount-key (tool ["source_mount" "mount_key"]))
  (define (home self spec)
    [self ("ts" "io") ("ts" "fs") (mount-key (_0 spec))])
  (define (images-at path state)
    (define result ((tool ["source_mount" "images"]) path state))
    (If (Eq 1 (Sz result)) (_0 result) []))
  (define (images state)
    (foldl (lambda (out spec)
      (merge-images out (images-at (home self spec) state))) core-images specs))
  ;; Resolved once: `previous` runs per definition path, and the constructor
  ;; lookup derives the core module's whole TypeWorld (driver:perc-world).
  (define case (tool ["namespace" "case"]))
  (define x (abi:constructor core ["care" "x"]))
  (define (previous state path)
    (define found (case x
      (map (lambda (part) ((_0 part) (_1 part))) path) state))
    (If (Eq 1 (Sz found)) (_0 found) 0))
  (define (publish-mount path state)
    (define spec (need (find (lambda (spec) (Equal path (home self spec))) specs)))
    (define files ((tool ["source_mount" "snapshot"]) path state))
    (define (read-file leaf)
      (define found (find (lambda (pair) (Equal leaf (_0 pair))) files))
      (If found (bignat-to-text (_1 (_0 found)))
        (error ["missing-mount-input" (_0 spec) leaf])))
    (DeepSeq (read-file "mount.json") 0)
    (DeepSeq (map read-file (Ix 11 spec)) 0)
    (Seq (print ["Publishing mount" (_0 spec)]) 0)
    (define own (_3 spec))
    (define imported (filter (lambda (pair)
      (Nil (find (lambda (binding) (Equal (_0 pair) (_0 binding))) own)))
      (foldl (lambda (out dependency)
        (merge-images out (images-at (home self [dependency]) state)))
        core-images (Ix 10 spec))))
    (define (read name)
      (define found (find (lambda (binding) (Equal name (_0 binding))) own))
      (If found (rex:ParseRexNormFile (read-file (_1 (_0 found))))
        (source:read-module name)))
    (define (root name)
      (define found (find (lambda (pair) (Equal name (_0 pair))) imported))
      (If found
        (_0 (subject:sut-context (driver:perc-subject (Unpin (_1 (_0 found))))))
        (resolve name)))
    (define origin (publication:compilation-context (Unpin (_0 core-code))))
    (define prepared (source:prepare-publication-reusing-with read
      (context:publication-key origin) (context:compiler-key origin)
      ;; This mount supplies its source predecessors. Shared dependencies
      ;; retain the exact pinned imports selected above.
      root imported (previous state) (map _0 own) (images-at path state)))
    (define code (publication:compile prepared (_1 core-code)))
    (define candidate
      (If (Sz own)
        (_0 (need-ok (publication:publish-local (bootstrap:policy system)
          slot code 0 0 state))) state))
    (define all-images (merge-images (_2 code) imported))
    (define complete ((Hd code) (_0 code) (_1 code) all-images))
    (define (lookup state requested)
      (define target
        (If (Or (Equal ("ts" "sys") (_0 requested))
                (Eq "x" (Hd (_0 requested)))) requested
          (Weld [self] requested)))
      (_0 ((tool ["sovereign_peek"]) target state)))
    (define published
      (foldl (lambda (state unit)
        (define compiled (backend:prepare-with complete (_2 unit)))
        (define policy (_1 compiled))
        (define document (need-ok ((driver:get-perc ["grove" "parse"] policy)
          (strcat (map (lambda (leaf) (strcat [(read-file leaf) 10])) (_1 unit))))))
        (define records (need-ok (backend:compile compiled (previous state)
          (lookup state) (qualify self (_0 unit)) document)))
        (_0 (need-ok (backend:publish compiled records 0 0 state))))
        candidate (_4 spec)))
    ;; Validate and persist registrations in this candidate, before reconcile
    ;; makes any of its Grove definitions or assets visible.
    (define registered
      (If (Ix 13 spec)
        (need-ok ((driver:get-perc ["goo_workspace_mount" "publish"]
                    (module all-images "goo_workspace_mount"))
                  path (_2 spec) published)) published))
    ((tool ["source_mount" "save_images"]) path (_2 code) registered))
  (define (attempt path state)
    (define result (Try (lambda (ignored) (force (publish-mount path state))) 0))
    (If (Eq 1 (Hd result))
      (Seq (print ["Mount publication failed" path (_0 result)])
        ((abi:result core "err")
          ((abi:constructor core ["source_mount" "failure"]) "Compilation failed" (_0 result))))
      ((abi:result core "ok") (_0 result))))
  (define ports ((abi:constructor core ["source_mount" "ports"]) attempt))
  ;; Namespace drafts use exactly the mounted compiler substrate and publisher.
  ;; The registration supplies the prelude, never the HTTP request or scene.
  (define draft-policy (module core-images "grove_draft"))
  (define (draft-tool name) (driver:get-perc ["grove_draft" name] draft-policy))
  (define (compile-draft root text prelude state)
    (define complete ((Hd core-code) (_0 core-code) (_1 core-code) (images state)))
    (define prepared (backend:prepare-with complete prelude))
    (define policy (_1 prepared))
    (define (lookup requested)
      (define target
        (If (Or (Equal ("ts" "sys") (_0 requested))
                (Eq "x" (Hd (_0 requested)))) requested (Weld [self] requested)))
      (_0 ((tool ["sovereign_peek"]) target state)))
    (define (build ignored)
      (define parsed ((draft-tool "parse") text))
      (define compiled (If (Equal "err" (Hd parsed)) parsed
        (backend:compile prepared (previous state) lookup root (_0 parsed))))
      (define result (If (Equal "err" (Hd compiled)) compiled
        ((draft-tool "validate_views") (_0 compiled))))
      (If (Equal "err" (Hd result)) result
        (let ((committed (backend:publish prepared (_0 result) 0 0 state)))
          (If (Equal "err" (Hd committed))
            ((abi:result policy "err") ((abi:constructor policy ["grove_backend" "diagnostic"])
              (driver:get-perc ["rex" "zero_span"] policy) "Draft publication conflict" 0))
            ((abi:result policy "ok") (_0 (_0 committed)))))))
    (define result (Try (lambda (ignored) (force (build 0))) 0))
    (If (Eq 1 (Hd result))
      ((abi:result policy "err") ((abi:constructor policy ["grove_backend" "diagnostic"])
        (driver:get-perc ["rex" "zero_span"] policy) "Draft compilation failed" 0))
      (_0 result)))
  (define draft-ports ((abi:constructor draft-policy ["grove_draft" "ports"]) compile-draft))
  (define homes (map (home self) specs))
  (Seq (print "Core publication compiled") 0)
  (define initial (need-ok ((driver:get-perc ["eden" "boot"] eden)
    self (bootstrap:trusted system) (_1 (_0 local)) port)))
  (define reader ((tool ["fs_read" "remote"]) scan-port scan-token))
  (define loaded
    (foldl (lambda (state spec)
      (define scanned ((tool ["source_mount" "load"])
        reader (_0 spec) (_1 spec) (_2 spec) state))
      (define published ((tool ["source_mount" "reconcile_one"])
        ports (home self spec) scanned))
      ((tool ["source_mount" "require_ready"]) [(home self spec)] published))
      initial specs))
  (define (hook state spec index)
    (define binding (Ix index spec))
    (driver:get-perc (_1 binding) (module (images state) (_0 binding))))
  (define activated
    (foldl (lambda (state spec)
      (If (Sz (_5 spec))
        (Seq (print ["Activating mount" (_0 spec)])
          (need-ok ((hook state spec 5) state))) state)) loaded specs))
  (define (workspace-tool state name)
    (driver:get-perc ["goo_workspace_mount" name]
      (module (images state) "goo_workspace_mount")))
  (define installed
    (foldl (lambda (state spec)
      (If (Ix 13 spec)
        (need-ok ((workspace-tool state "install") (home self spec) state)) state))
      activated specs))
  (define documented
    (let ((binding (find (lambda (pair) (Equal (_0 pair) "goo_documentation")) (images installed))))
      (If binding
        (let ((policy (Unpin (_1 (_0 binding)))))
          (need-ok ((driver:get-perc ["goo_documentation" "install_reader"] policy)
            (documentation:reader policy slot) installed))) installed)))
  (define editable
    (let ((policy (module (images documented) "goo_value")))
      (need-ok ((driver:get-perc ["goo_value" "install"] policy)
        (value-editor:compiler policy) documented))))
  (define http (module core-images "http_foot"))
  (define empty (driver:get-perc ["http_foot" "empty"] http))
  (define (serve commit saved runtime-args)
  (define session (world:session runtime-args specs))
  ;; Prepare against the retained world without checkpointing a partial start.
  ;; Route construction and draft reconciliation may fail. Resolve all hook
  ;; entrypoints before committing or giving an actor the candidate namespace.
  (define reconnected ((driver:get-perc ["eden_store" "reconnect"] (module core-images "eden_store")) (_0 session) saved))
  (define state ((draft-tool "reconcile") draft-ports reconnected))
  (define reader ((tool ["fs_read" "remote"]) (_1 session) (_2 session)))
  (define config
    (foldl (lambda (config spec)
      (Ifz (Or (Sz (_6 spec)) (Ix 13 spec)) config
        (let* ((manual (If (Sz (_6 spec))
                        ((hook state spec 6)
                          ((tool ["source_mount" "snapshot"]) (home self spec) state)
                          state) empty))
               (frozen (If (Ix 13 spec)
                         ((workspace-tool state "http")
                           (home self spec) (_2 spec) state manual) manual))
               (extra ((driver:get-perc ["http_foot" "live_assets"] http)
                         (home self spec) (_2 spec) frozen))
               (joined ((driver:get-perc ["http_foot" "add_routes"] http) (_0 extra) config)))
          (Seq (If (And (Eq (Sz (_0 extra)) (Sz (Ix 12 spec)))
                        (all (lambda (route) (includes (Equal (_0 route)) (Ix 12 spec))) (_0 extra)))
                   0 (error ["undeclared-mount-routes" (_0 spec)]))
            (If (Ix 9 spec) ((Hd joined) (_0 joined) (_1 extra) (_2 extra)) joined)))))
      empty specs))
  (define hooks (map (lambda (spec)
    (Ifz (Sz (_7 spec)) 0 (hook state spec 7))) specs))
  (define register (driver:get-perc ["eden" "register_foot"] eden))
  (define registration (abi:constructor core ["helm" "supervisor" "register"]))
  (define fs-entry ((driver:get-perc ["fs_foot" "run_with"] (module core-images "fs_sync_foot")) reader))
  (define http-entry ((driver:get-perc ["http_foot" "run_with"] http) config))
  (define serve-feet (driver:get-perc ["eden" "serve_feet"] eden))
  (define access
    ((driver:get-perc ["eden_store" "namespace_access"] (module core-images "eden_store"))
      ((draft-tool "access") draft-ports ((tool ["source_mount" "access"]) ports homes)) commit))
  (DeepSeq [state config hooks register registration fs-entry http-entry serve-feet access] 0)
  (define stored (commit state))
  ;; After this point failures are I/O startup failures, not an uncommitted
  ;; preparation. Restart reconnects again; acknowledged provider writes remain.
  (define server (Seq stored (serve-feet access stored [])))
  (Seq (print ["Registered HTTP routes" (map _0 (_0 config))]) 0)
  (Seq server (foldl (lambda (index spec)
    (Seq (Ifz (Sz (_7 spec)) 0
      ((Ix index hooks) server (Ix index (_3 session)))) (Inc index))) 0 specs))
  (Seq (register server (registration [self ("ts" "io") ("ts" "fs")]
    fs-entry)) 0)
  (Seq (register server (registration [self ("ts" "io") ("ts" "http")]
    http-entry)) 0)
  (Seq (print ["EDEN-WORLD-READY" "native continuation committed"]) server))
  (world:run serve editable (world:arguments tier port scan-port scan-token specs)))

(define (start-with-tier self system resolve slot port specs scan-port scan-token tier)
  (mounted self system resolve slot port specs scan-port scan-token tier))
(define (start self system resolve slot port specs scan-port scan-token)
  (start-with-tier self system resolve slot port specs scan-port scan-token "none"))
(#export start start-with-tier)
