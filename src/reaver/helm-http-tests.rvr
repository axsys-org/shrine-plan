(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind stage (#module foil-stage))
(#bind helm-http (#module helm-http))
(#bind helm-chore (#module helm-chore))
(#bind helm-doctest (#module helm-doctest))
(#bind helm-build (#module helm-build))


;;; The HTTP driver end-to-end, minus sockets (no outbound-connect
;;; primitive exists): main impersonates connection actors, sending
;;; ["req" method url body] straight to the worker and receiving
;;; ["res" status body] — the same seam the socket layer uses.  The
;;; request cycle inside one event: the bare request record is made
;;; under /io/http, the SERVING kook installed there receives the
;;; kid-add gift and pokes the configured responder kook onto the
;;; request node, whose talk writes the response slots; the driver's
;;; spy then delivers the finished record.  Every wait is causal.

(define core (helm:helm-pack [stage:cache (stage:sut-of "helmapp")]))

(define (app path) (helm:core-ent core path))
;; t_data / put_nat left the app: rebuild them from the myth kit
;; (myth/new is a constant now — the entry value IS the empty myth)
(define myth-new (app ["myth" "new"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-add (app ["myth" "add"]))
(define limb-nat (app ["twig" "nat"]))
(define pd-f (app ["pd"]))
(define (t-data slot n) (myth-sing slot (pd-f n)))
(define (put-nat t slot n) (myth-add (limb-nat slot n) t))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define http-cfg (app ["http" "cfg"]))
(define txt-slot (app ["myth" "txt_at"]))
(define nat-slot (app ["myth" "nat_at"]))

;; the cache extended with the life app, like the real boot's — the
;; doctest fixtures cover an app-module target (compiled outside the
;; core chain) alongside the kernel ones
(define (life-cache z)
  ;; demo rides the cache as the chore-bridge fixture: tiny (70
  ;; lines, no imports, declares add), so the /chore recompiles in
  ;; 7c cost ~1s instead of sept/weft's full elab (~270s of the
  ;; suite before the swap)
  (define c1 (_0 (helm:cache-compile (helm:core-cache core) "demo")))
  (_0 (helm:compile-apps core c1 ["life"])))

;; the registry plus the /boot mirror: the explorer fixtures browse
;; the system's own code.  Seeded and deep-forced HERE in main — a
;; lazy seed would first be demanded inside the spawned coordinator,
;; where reef code cannot compile ("no compiler set").  The helper
;; bundles and worker maker live INSIDE this let: giant raw data at a
;; top-level define is echoed whole by the module loader, and the
;; caches/suts render to hundreds of MB — enough to exhaust the canon
;; arena (only `core` rides top-level, echoed once).
(define z-seed (ZoneStart "seed+spawn"))
(define coord
  (let* ((helpers
           ["H" (app ["http" "req"]) (app ["myth" "nat_at"]) (app ["vine_make"])
            (app ["vine_cull"]) (app ["myth" "txt_at"])
            (app ["build" "eval_req"]) (app ["build" "compile_req"])
            (app ["build" "save_req"]) (app ["vine_poke"]) (helm:core-sut core)
            myth-new (app ["myth" "add"]) (app ["twig" "txt"])])
         (dhelpers
           ["D" (helm:core-sut core) (life-cache 0)
            (app ["myth" "pail_at"]) (app ["doctest" "card"])
            (app ["chore" "mkp_t"])])
         (chelpers
           ["C" (app ["fetch" "fresh"]) (app ["chore" "fam_of"])
            (app ["chore" "done_t"]) (app ["chore" "fail_t"])
            (app ["chore" "clear_t"]) (app ["chore" "cmd_parts"])
            (app ["vine_poke"]) (app ["vine_make"])])
         (bs [core (life-cache 0)])
         (fams
           (Weld [(helm-doctest:dt-family dhelpers)]
             (helm-build:build-families bs)))
         (mk-worker
           (lambda (n)
             (cond
               ((Equal n ("ts" "doctest")) (helm-chore:mk-chore-worker chelpers fams n))
               ((Equal n ("ts" "chore")) (helm-chore:mk-chore-worker chelpers fams n))
               (else (helm-http:mk-http-worker helpers n)))))
         ;; the PACT mirror variant, like the real boot's (helm-run):
         ;; its root task carries the pact kook, without which the
         ;; deferred who-calls upgrade poke melds and expands nothing
         (s (helm:seed-tasks core (app ["seeded"])
              (Weld (helm:boot-mirror-pact-tasks-with (life-cache 0) core)
                (helm:boot-ns-index-tasks core (life-cache 0))))))
    ;; put-nat is local glue the workers call: one MAIN call compiles it
    (Seq (DeepSeq (put-nat myth-new [("ts" "warm")] 1) 0)
      ;; chore glue: one MAIN call per compiled entry and rvr path the
      ;; chore worker and its leaves replay off-MAIN — plus the moved
      ;; helper bundles, which the top-level echo used to force in MAIN
      (Seq (DeepSeq
             [((app ["chore" "done_t"]) 1 0)
              ((app ["chore" "clear_t"]) ("ts" "k"))
              ((app ["chore" "fail_t"]) ("ts" "x"))
              ((app ["chore" "fam_of"]) ("ts" "d") myth-new)
              ((app ["chore" "cmd_parts"])
                ((app ["chore" "mkp_t"]) [("ts" "a")] myth-new))
              (helm-doctest:dt-plan dhelpers
                ((app ["dt" "req"]) [("ts" "boot")]) [("ts" "io")])
              (helm-build:eval-plan bs
                ((app ["build" "eval_req"]) "demo" "(add 1 1)")
                [("ts" "io")])
              (helm-build:eval-run bs ["demo" "(add 1 1)" [("ts" "io")]] 0)
              (helm-build:compile-plan bs
                ((app ["build" "compile_req"]) "mapx") [("ts" "io")])
              (helm-build:save-plan bs
                ((app ["build" "save_req"]) "mapx" "x") [("ts" "io")])
              (helm-build:resync-run bs ["mapx" [("ts" "io")]] 0)
              (helm-http:form-field "expr" "expr=%28add+1+1%29")
              helpers chelpers fams]
             0)
        (Seq (DeepSeq s s)
          (Spawn (helm:helm-actor core mk-worker (lambda (hm) 0) s)))))))

(define z-seed-e (Seq coord (ZoneEnd z-seed)))
(define (ask m)
  (Seq (SendCaps coord (DeepSeq m m) [0])
    (Recv 0)))
(define (inject t)
  (Ix 0 (ask ["task" t])))

(define tio ("ts" "io"))
(define thttp ("ts" "http_client"))

(define z-drv (ZoneStart "drv"))
;;; 1. make /io/http with the serving kook installed: the driver is born ;;;;;;;;;;;;

assert(Equal ["done"] (inject (vine-make [tio thttp] (http-cfg ("ts" "hrespond")))))
assert(Equal [thttp] (Ix 0 (ask ["crew"])))
(define hr (ask ["handle" thttp]))
assert(Equal ["handle"] (Ix 0 hr))
(define wh (Ix 0 (Ix 1 hr)))

;; Boot has already committed hundreds of unrelated epochs, but this
;; path was created once: all six public counters begin at one.
(define hv0 (Ix 0 (ask ["query" [("ts" "h") ("ts" "v") ("u" 2) tio thttp]])))
assert(Eq "/boot/res/known" (Hd hv0))
(define hvm0 (_0 hv0))
assert(Equal "1" (txt-slot [("ts" "x_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "x_shape")] hvm0))
assert(Equal "1" (txt-slot [("ts" "y_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "y_shape")] hvm0))
assert(Equal "1" (txt-slot [("ts" "z_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "z_shape")] hvm0))

(define z-drv-e (ZoneEnd z-drv))
(define z-req-basic (ZoneStart "req-basic"))
;;; 2. a request rides the namespace and comes back 200, echoed ;;;;;;;;;;;;;;;;;;;;

(SendCaps wh ["req" "GET" "/ping" "hello"] [0])
(define r1 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r1))
assert(Eq 200 (_1 r1))
assert(Equal "hello" (_2 r1))

;;; 3. a second request gets a fresh serial; both nodes were culled ;;;;;;;;;;;;;;;;;

(SendCaps wh ["req" "POST" "/again" "world"] [0])
(define r2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r2))
assert(Equal "world" (_2 r2))

;; barrier, then look for tombstones where the request nodes lived
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 1))))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r0")]])))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r1")]])))

;;; 4. an unknown responder fails the installing poke: the event dies, 500 ;;;;;;;;;;

(define tbad ("ts" "bad"))
assert(Equal ["done"] (inject (vine-make [tio tbad] (http-cfg ("ts" "zzz")))))
(define hr2 (ask ["handle" tbad]))
(define wh2 (Ix 0 (Ix 1 hr2)))
(SendCaps wh2 ["req" "GET" "/nope" ""] [0])
(define r3 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r3))
assert(Eq 500 (_1 r3))
assert(Equal "kook_unknown" (_2 r3))

(define z-req-basic-e (ZoneEnd z-req-basic))
(define z-explorer (ZoneStart "explorer"))
;;; 5. the explorer: the namespace served as HTML ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (starts-with pre s)
  (Eq pre (Mod s (Lsh 1 (Mul 8 (Bytes pre))))))
(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))

;; seed some namespace to explore
(define tdata ("ts" "data"))
(define tx ("ts" "x"))
(define tkid ("ts" "kid"))
assert(Equal ["done"] (inject (vine-make [tdata tx] (t-data [("ts" "num")] 41))))
assert(Equal ["done"] (inject (vine-make [tdata tx tkid] (t-data [("ts" "num")] 42))))

;; an explorer driver at /io/nsx
(define tnsx ("ts" "nsx"))
assert(Equal ["done"] (inject (vine-make [tio tnsx] (http-cfg ("ts" "hex")))))
(define hr3 (ask ["handle" tnsx]))
(define wh3 (Ix 0 (Ix 1 hr3)))
(SendCaps wh3 ["req" "GET" "/ns/data/x" ""] [0])
(define r5 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r5))
assert(Eq 200 (_1 r5))
;; html content type, page shell, breadcrumb links, the slot, the kid
assert(Eq 1 (starts-with "text/html" (_3 r5)))
(define body5 (_2 r5))
assert(Eq 1 (starts-with "<!doctype html>" body5))
assert(Eq 1 (contains? "/ns/data/x" body5))
assert(Eq 1 (contains? "/num" body5))
assert(Eq 1 (contains? "41" body5))
assert(Eq 1 (contains? "/ns/data/x/kid" body5))
;; the root view lists top-level kids, including the boot image
(SendCaps wh3 ["req" "GET" "/ns" ""] [0])
(define r6 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r6))
assert(Eq 1 (contains? "/ns/data" (_2 r6)))
assert(Eq 1 (contains? "/ns/io" (_2 r6)))
assert(Eq 1 (contains? "/ns/boot" (_2 r6)))

(define z-explorer-e (ZoneEnd z-explorer))
(define z-boot-mirror (ZoneStart "boot-mirror"))
;;; 5b. the /boot mirror through the explorer: code browsed from inside ;;;;;;;;;;;;;

;; the boot node lists the compiled modules
(SendCaps wh3 ["req" "GET" "/ns/boot" ""] [0])
(define r7 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r7))
assert(Eq 1 (contains? "/ns/boot/helm" (_2 r7)))
assert(Eq 1 (contains? "/ns/boot/lain" (_2 r7)))
assert(Eq 1 (contains? "the boot image" (_2 r7)))

;; a file node renders its source in a pre block
(SendCaps wh3 ["req" "GET" "/ns/boot/helm" ""] [0])
(define r8 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r8))
assert(Eq 1 (contains? "<pre>" (_2 r8)))
assert(Eq 1 (contains? "Take the helm" (_2 r8)))

;; an entry node shows its kind and its own source
(SendCaps wh3 ["req" "GET" "/ns/boot/lain/1/dep" ""] [0])
(define r9 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r9))
assert(Eq 1 (contains? "row type" (_2 r9)))
assert(Eq 1 (contains? "/kind" (_2 r9)))
assert(Eq 1 (contains? "/sys/src" (_2 r9)))
;; the mirror's extra panes: rendered type text rides ['ty]
assert(Eq 1 (contains? "/sys/mold" (_2 r9)))

(define z-boot-mirror-e (ZoneEnd z-boot-mirror))
(define z-refs-index (ZoneStart "refs-index"))
;;; 5c. reference slots and the ns index ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Imported TC_GLOBAL edges use unit-qualified storage paths.  The mirror maps
;; those back to the source entries on both sides of the call.
(define cross-ref
  [(helm:boot-ent-node "web" ["explorer" "page"])
   (helm:boot-ent-node "sept" ["eq_pith"])])
assert(includes (Equal cross-ref)
  (helm:boot-ref-table (helm:core-cache core)))

;; the who-calls rows are DEFERRED in the boot path (the reference
;; table is expensive; the real boot injects the upgrade post-listen,
;; helm-run) — inject it here so the reference slots exist
assert(Equal ["done"] (inject (helm:ref-upgrade-task (life-cache 0) core)))

;; a function entry carries who-calls rows as mirror-path links
(SendCaps wh3 ["req" "GET" "/ns/boot/sept/1/eq_pith" ""] [0])
(define r9b (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r9b))
assert(Eq 1 (contains? "/called_by" (_2 r9b)))

;; /boot/ns/<root> groups entries by source namespace root
(SendCaps wh3 ["req" "GET" "/ns/boot/ns/chore" ""] [0])
(define rns (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rns))
assert(Eq 1 (contains? "/ns/boot/chore" (_2 rns)))

(define z-refs-index-e (ZoneEnd z-refs-index))
(define z-time-travel (ZoneStart "time-travel"))
;;; 5d. time travel through the explorer: /h browses history ;;;;;;;;;;;;;;;;;;;;;;;;

;; the overlay root lists the three cares
(SendCaps wh3 ["req" "GET" "/ns/h" ""] [0])
(define rh1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh1))
assert(Eq 1 (contains? "/ns/h/x" (_2 rh1)))
assert(Eq 1 (contains? "/ns/h/y" (_2 rh1)))
assert(Eq 1 (contains? "/ns/h/z" (_2 rh1)))

;; Every exact registry path has its own case 1, independent of the
;; order in which the registry was seeded.
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/count" ""] [0])
(define rh2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh2))
assert(Eq 1 (contains? "form" (_2 rh2)))
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/echo" ""] [0])
(define rh3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh3))
assert(Eq 1 (contains? "form" (_2 rh3)))

;; /kook carries the registry convention's lore (shrine-apps.md 7):
;; the root documents itself, and its children stay browsable.
(SendCaps wh3 ["req" "GET" "/ns/h/z/1/1/kook" ""] [0])
(define rh4 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh4))
assert(Eq 1 (contains? "behavior registry" (_2 rh4)))

(SendCaps wh3 ["req" "GET" "/ns/kook" ""] [0])
(define rh4b (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh4b))
assert(Eq 1 (contains? "/ns/kook/count" (_2 rh4b)))
assert(Eq 1 (contains? "behavior registry" (_2 rh4b)))

;; the coordinator query verb rides the same overlay
(define qh (Ix 0 (ask ["query" [("ts" "h") ("ts" "x") ("u" 1) ("u" 2) ("ts" "kook") ("ts" "count")]])))
assert(Eq "/boot/res/known" (Hd qh))

;; live pages carry the version pane: lock cases, state, and links
;; into the node's history
(SendCaps wh3 ["req" "GET" "/ns/kook/count" ""] [0])
(define rh5 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh5))
assert(Eq 1 (contains? "version" (_2 rh5)))
assert(Eq 1 (contains? "/x_data" (_2 rh5)))
assert(Eq 1 (contains? "live" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/x/1/2/kook/count" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/y/1/2/kook/count" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/z/1/2/kook/count" (_2 rh5)))

;; /h pages link back to the live node
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/count" ""] [0])
(define rh6 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "view live" (_2 rh6)))
assert(Eq 1 (contains? "/ns/kook/count" (_2 rh6)))

(define z-time-travel-e (ZoneEnd z-time-travel))
(define z-app-faces (ZoneStart "app-faces"))
;;; 5e. app faces: /app targets served by the app's own responder ;;;;;;;;;;;;;;;;;;
;;; A mounted app that declares a 'face kook answers its own URL
;;; subtree through the shared driver; everything without one falls
;;; through to the explorer.

;; mount an app through the real pipeline: compile under the shared
;; cache, then one card make expanded in-kernel by pact/init.  Built
;; inside a function — the compile result holds the whole cache, and
;; a top-level define would echo it into the canon arena.
(define (mount-app-via-card name root)
  (define r (helm:compile-apps core (helm:core-cache core) [name]))
  (define res (_1 (_0 (_1 r))))
  (define mani (_1 res))
  (inject (vine-make root
            ((app ["pact" "card"]) mani (strcat ["apps/" name "/main"])))))

assert(Equal ["done"] (mount-app-via-card "life" [("ts" "app") ("ts" "life")]))
assert(Equal ["done"] (mount-app-via-card "demo" [("ts" "app") ("ts" "demo")]))

;; the life app's face serves its root: stats, the board, the reload
;; timer — not the explorer chrome
(SendCaps wh3 ["req" "GET" "/ns/app/life" ""] [0])
(define rf1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rf1))
assert(Eq 1 (starts-with "text/html" (_3 rf1)))
assert(Eq 1 (contains? "gen " (_2 rf1)))
assert(Eq 1 (contains? "###" (_2 rf1)))
assert(Eq 1 (contains? "location.reload" (_2 rf1)))

;; deep app paths ride the same face: the board node renders too
(SendCaps wh3 ["req" "GET" "/ns/app/life/board" ""] [0])
(define rf2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rf2))
assert(Eq 1 (contains? "###" (_2 rf2)))
assert(Eq 1 (contains? "location.reload" (_2 rf2)))

;; a committed tick shows up on the next render — the reactive loop
;; end to end, minus only the browser's timer
assert(Equal ["done"]
  (inject (vine-poke [("ts" "app") ("ts" "life") ("ts" "board")]
            (t-data [("ts" "tick")] 1))))
(SendCaps wh3 ["req" "GET" "/ns/app/life" ""] [0])
(define rf3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rf3))
assert(Eq 1 (contains? "gen 1" (_2 rf3)))

;; a faceless app still gets the explorer
(SendCaps wh3 ["req" "GET" "/ns/app/demo" ""] [0])
(define rf4 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rf4))
assert(Eq 1 (contains? "record" (_2 rf4)))
assert(Eq 0 (contains? "location.reload" (_2 rf4)))

;; an unmounted app root is an ordinary null page, not a 500
(SendCaps wh3 ["req" "GET" "/ns/app/zzz" ""] [0])
(define rf5 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rf5))
assert(Eq 0 (contains? "location.reload" (_2 rf5)))

(define z-app-faces-e (ZoneEnd z-app-faces))
(define z-chat (ZoneStart "chat"))
;;; 5f. the chat app: a fresh interface at its own /chat root, with ;;;;;;;;;;;;;;;;
;;; form posts through the /post endpoint.  The face renders the
;;; conversation; the log's talk arm appends each message in-kernel.

assert(Equal ["done"] (mount-app-via-card "chat" [("ts" "chat")]))

;; the empty conversation: the fresh page carries the form wired at
;; the log, the side picker, and the in-place refresh — and none of
;; the explorer chrome
(SendCaps wh3 ["req" "GET" "/chat" ""] [0])
(define rc5 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc5))
assert(Eq 1 (starts-with "text/html" (_3 rc5)))
assert(Eq 1 (contains? "/post/chat/log" (_2 rc5)))
assert(Eq 1 (contains? "getElementById" (_2 rc5)))
assert(Eq 0 (contains? "breadcrumb" (_2 rc5)))

;; post from side a: the worker pokes the log, the talk appends kid 0,
;; and the reply bounces back to the form's page
(SendCaps wh3 ["req" "POST" "/post/chat/log"
               "who=a&text=hello+there&back=%2Fchat"] [0])
(define rp1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rp1))
assert(Eq 1 (contains? "url=/chat" (_2 rp1)))

(SendCaps wh3 ["req" "GET" "/chat" ""] [0])
(define rc6 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "hello there" (_2 rc6)))
assert(Eq 1 (contains? "msg a" (_2 rc6)))

;; the other side answers; both bubbles ride the next render
(SendCaps wh3 ["req" "POST" "/post/chat/log"
               "who=b&text=hi+yourself&back=%2Fchat"] [0])
(define rp2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rp2))
(SendCaps wh3 ["req" "GET" "/chat" ""] [0])
(define rc7 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "hello there" (_2 rc7)))
assert(Eq 1 (contains? "hi yourself" (_2 rc7)))
assert(Eq 1 (contains? "msg b" (_2 rc7)))

;; message text is escaped at render: markup in, entities out
(SendCaps wh3 ["req" "POST" "/post/chat/log"
               "who=a&text=%3Cscript%3Eboo&back=%2Fchat"] [0])
(define rp3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rp3))
(SendCaps wh3 ["req" "GET" "/chat" ""] [0])
(define rc8 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "&lt;script&gt;boo" (_2 rc8)))

;; a post at a node that never existed reports the kernel's verdict
(SendCaps wh3 ["req" "POST" "/post/nowhere" "text=x&back=%2Fchat"] [0])
(define rp4 (Ix 0 (Recv 0)))
assert(Eq 500 (_1 rp4))
assert(Eq 1 (contains? "poke_missing" (_2 rp4)))

;; the deep chat paths still serve the chat face (single-segment
;; root dispatch), and the log node's own page renders the log too
(SendCaps wh3 ["req" "GET" "/chat/log" ""] [0])
(define rc9 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc9))
assert(Eq 1 (contains? "hello there" (_2 rc9)))

(define z-chat-e (ZoneEnd z-chat))
(define z-nenex (ZoneStart "nenex"))
;;; 5g. nenex: the wiki corpus at /nenex ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Pages are semidoc trees expanded from their own source by the doc
;;; kook's init; the hub watches its subtree (backlinks) and answers
;;; the index forms (create, search).

assert(Equal ["done"] (mount-app-via-card "nenex" [("ts" "nenex")]))

;; the index: seeded pages listed, create + search forms present
(SendCaps wh3 ["req" "GET" "/nenex" ""] [0])
(define rn1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn1))
assert(Eq 1 (starts-with "text/html" (_3 rn1)))
assert(Eq 1 (contains? "/nenex/w/home" (_2 rn1)))
assert(Eq 1 (contains? "/nenex/w/ideas" (_2 rn1)))
assert(Eq 1 (contains? "new page" (_2 rn1)))
assert(Eq 1 (contains? "search" (_2 rn1)))
;; home and ideas mention each other only where they LINK each other,
;; so the clean corpus has no unlinked-mentions section
assert(Eq 0 (contains? "unlinked mentions" (_2 rn1)))

;; a page: rendered document, editor, and the runnable example
(SendCaps wh3 ["req" "GET" "/nenex/w/home" ""] [0])
(define rn2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn2))
assert(Eq 1 (contains? "A programmable interior for thought" (_2 rn2)))
assert(Eq 1 (contains? "textarea" (_2 rn2)))
assert(Eq 1 (contains? "/chore/eval/sept" (_2 rn2)))

;; typed relationships computed at mount: ideas declares
;; ;@ /rel/supports ;/nenex/w/home, so home shows the typed row
assert(Eq 1 (contains? "/rel/supports" (_2 rn2)))
assert(Eq 1 (contains? "/nenex/w/ideas" (_2 rn2)))

;; backlinks computed at mount: home links ideas, so ideas shows it
(SendCaps wh3 ["req" "GET" "/nenex/w/ideas" ""] [0])
(define rn3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn3))
assert(Eq 1 (contains? "linked from:" (_2 rn3)))
assert(Eq 1 (contains? "/nenex/w/home" (_2 rn3)))

;; create a page from the index form: one POST, one make, the doc
;; kook's init expands the starter source
(SendCaps wh3 ["req" "POST" "/post/nenex/w" "new=scratch&back=%2Fnenex"] [0])
(define rn4 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn4))
(SendCaps wh3 ["req" "GET" "/nenex" ""] [0])
(define rn5 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "/nenex/w/scratch" (_2 rn5)))
(SendCaps wh3 ["req" "GET" "/nenex/w/scratch" ""] [0])
(define rn6 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn6))
assert(Eq 1 (contains? "A fresh page." (_2 rn6)))

;; edit scratch to cite home: the hub hear adds home's backlink
(define (url-enc2 s)
  (define hex "0123456789ABCDEF")
  (define n (Bytes s))
  (define (go i acc)
    (If (Ge i n)
      acc
      (let ((b (Load8 i s)))
        (go (Inc i)
          (strcat [acc "%" (Load8 (Div b 16) hex) (Load8 (Mod b 16) hex)])))))
  (go 0 ""))
(define nl10 10)
(define scratch-link-src
  (strcat [";. /nenex/w/scratch" nl10 nl10
           "  ;= Scratch" nl10 nl10
           "    cites the home page:" nl10 nl10
           "    ;/nenex/w/home" nl10]))
(SendCaps wh3 ["req" "POST" "/post/nenex/w/scratch"
               (strcat ["src=" (url-enc2 scratch-link-src) "&back=%2Fnenex%2Fw%2Fscratch"])] [0])
(define rn7 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn7))
(SendCaps wh3 ["req" "GET" "/nenex/w/home" ""] [0])
(define rn8 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "linked from:" (_2 rn8)))
assert(Eq 1 (contains? "/nenex/w/scratch" (_2 rn8)))

;; browsers normalize textarea values to CRLF on submit — the decode
;; boundary must strip the CRs or the semidoc reparse sees \r-laden
;; lines (the live "can't update the source" bug)
(define scratch-crlf-src
  (strcat [";. /nenex/w/scratch" 13 nl10 13 nl10
           "  ;= Crlfproof" 13 nl10 13 nl10
           "    browsers send carriage returns" 13 nl10]))
(SendCaps wh3 ["req" "POST" "/post/nenex/w/scratch"
               (strcat ["src=" (url-enc2 scratch-crlf-src) "&back=%2Fnenex%2Fw%2Fscratch"])] [0])
(define rcr1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rcr1))
(SendCaps wh3 ["req" "GET" "/nenex/w/scratch" ""] [0])
(define rcr2 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "Crlfproof" (_2 rcr2)))
assert(Eq 1 (contains? "carriage returns" (_2 rcr2)))

;; search: the query and its results commit as slots on the hub
(SendCaps wh3 ["req" "POST" "/post/nenex/w" "q=accumulate&back=%2Fnenex"] [0])
(define rn9 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn9))
(SendCaps wh3 ["req" "GET" "/nenex" ""] [0])
(define rn10 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "last search: accumulate" (_2 rn10)))
(define hubq (Ix 0 (ask ["query" [("ts" "nenex") ("ts" "w")]])))
assert(Eq "/boot/res/known" (Hd hubq))
(define res-pail ((app ["myth" "pail_at"]) [("ts" "results")] (_0 hubq)))
assert(Eq "/boot/pails/ps" (Hd res-pail))
assert(Equal [[("ts" "nenex") ("ts" "w") ("ts" "ideas")]] (_0 res-pail))

;; a typed edge appears when declared: scratch contradicts ideas
(define scratch-rel-src
  (strcat [";. /nenex/w/scratch" nl10 nl10
           "  ;= Scratch" nl10 nl10
           "    ;@ /rel/contradicts ;/nenex/w/ideas" nl10 nl10
           "    on reflection, ideas are overrated" nl10]))
(SendCaps wh3 ["req" "POST" "/post/nenex/w/scratch"
               (strcat ["src=" (url-enc2 scratch-rel-src) "&back=%2Fnenex%2Fw%2Fscratch"])] [0])
(define rt1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rt1))
(SendCaps wh3 ["req" "GET" "/nenex/w/ideas" ""] [0])
(define rt2 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "/rel/contradicts" (_2 rt2)))
assert(Eq 1 (contains? "/nenex/w/scratch" (_2 rt2)))

;; removing the citation shrinks the backlink slot back to empty —
;; the hear's re-poke of an empty ps, not a stale leftover
(define scratch-alone-src
  (strcat [";. /nenex/w/scratch" nl10 nl10
           "  ;= Scratch" nl10 nl10
           "    stands alone" nl10]))
(SendCaps wh3 ["req" "POST" "/post/nenex/w/scratch"
               (strcat ["src=" (url-enc2 scratch-alone-src) "&back=%2Fnenex%2Fw%2Fscratch"])] [0])
(define rn11 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rn11))
(SendCaps wh3 ["req" "GET" "/nenex/w/home" ""] [0])
(define rn12 (Ix 0 (Recv 0)))
;; scratch's citation is gone; ideas' typed edge still counts as an
;; incoming link, so the row survives without scratch in it
assert(Eq 0 (contains? "/nenex/w/scratch" (_2 rn12)))
assert(Eq 1 (contains? "/rel/supports" (_2 rn12)))
;; and the withdrawn typed edge re-poked empty: no stale contradicts
(SendCaps wh3 ["req" "GET" "/nenex/w/ideas" ""] [0])
(define rn12b (Ix 0 (Recv 0)))
assert(Eq 0 (contains? "/rel/contradicts" (_2 rn12b)))
assert(Eq 1 (contains? "linked from:" (_2 rn12b)))

;; ranked search: "nenex" hits every page, ordered by the formula
;; body + 3*title + backlinks — home (3 body + 1 backlink) over
;; ideas (2 + 1) over scratch (1 + 0) — with explanations committed
;; alongside and rendered on the index
(SendCaps wh3 ["req" "POST" "/post/nenex/w" "q=nenex&back=%2Fnenex"] [0])
(define rk1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rk1))
(define hubq2 (Ix 0 (ask ["query" [("ts" "nenex") ("ts" "w")]])))
(define res2 ((app ["myth" "pail_at"]) [("ts" "results")] (_0 hubq2)))
assert(Equal
  [[("ts" "nenex") ("ts" "w") ("ts" "home")]
   [("ts" "nenex") ("ts" "w") ("ts" "ideas")]
   [("ts" "nenex") ("ts" "w") ("ts" "scratch")]]
  (_0 res2))
(define why2 (txt-slot [("ts" "why")] (_0 hubq2)))
assert(Eq 1 (contains? "3 in body" why2))
assert(Eq 1 (contains? "1 backlinks" why2))
(SendCaps wh3 ["req" "GET" "/nenex" ""] [0])
(define rk2 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "in body," (_2 rk2)))
assert(Eq 1 (contains? "last search: nenex" (_2 rk2)))

;; an unlinked mention surfaces: scratch says "home" as a word but
;; declares no edge, so the index reports the missing connection
(define scratch-mention-src
  (strcat [";. /nenex/w/scratch" nl10 nl10
           "  ;= Scratch" nl10 nl10
           "    the home page deserves a link" nl10]))
(SendCaps wh3 ["req" "POST" "/post/nenex/w/scratch"
               (strcat ["src=" (url-enc2 scratch-mention-src) "&back=%2Fnenex%2Fw%2Fscratch"])] [0])
(define rm1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rm1))
(SendCaps wh3 ["req" "GET" "/nenex" ""] [0])
(define rm2 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "unlinked mentions" (_2 rm2)))
assert(Eq 1 (contains? "without linking it" (_2 rm2)))

;; the corpus is still healthy after the self-watch rounds: an
;; ordinary write commits and reads back (fuel was not exhausted)
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 9))))
(define nq (Ix 0 (ask ["query" [("ts" "nenex") ("ts" "w") ("ts" "scratch")]])))
assert(Eq "/boot/res/known" (Hd nq))
assert(Equal scratch-mention-src (txt-slot [("ts" "src")] (_0 nq)))

(define z-nenex-e (ZoneEnd z-nenex))
(define z-http-res (ZoneStart "http-res"))
;;; 6. the response builder speaks HTTP ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define resp (helm-http:http-res 200 "text/plain" "hi"))
assert(Eq 1 (starts-with "HTTP/1.0 200 OK" resp))
assert(Eq 1 (starts-with "HTTP/1.0 500" (helm-http:http-res 500 "text/plain" "boom")))

(define z-http-res-e (ZoneEnd z-http-res))
(define z-doctest (ZoneStart "doctest"))
;;; 7. the doctest driver end to end: request in, verdict kid out ;;;;;;;;;;;;;;;;;;;
;;; One check function, one flag-row assert — top-level asserts over
;;; the deep records corrupt (session-leak notes).

(define tdt ("ts" "doctest"))
(define eqp-node
  [("ts" "boot") ("ts" "sept") ("u" 1) ("ts" "eq_pith")])
assert(Equal ["done"] (inject (vine-make [tio tdt] (app ["dt" "cfg"]))))
assert(Equal ["done"]
  (inject (vine-make [tio tdt ("ts" "r1")] ((app ["dt" "req"]) eqp-node))))

(define (doctest-driver-checks z)
  (define tslot-f (app ["myth" "nat_at"]))
  (define has-slot-f (app ["myth" "has_at"]))
  ;; the worker answers asynchronously; each ask is a synchronous
  ;; barrier, so a bounded poll converges.  Evaluation rides a leaf
  ;; actor now (helm-chore.rvr), so completion is wall-clock async —
  ;; the budget covers a cold app-subject eval, not a few turns
  (define (poll-done kid tries)
    (If (Eq 0 tries)
      0
      (let ((r (Ix 0 (ask ["query" [tio tdt kid]]))))
        (If (And (Eq "/boot/res/known" (Hd r))
              (Eq 1 (tslot-f [("ts" "res_done")] 0 (_0 r))))
          (_0 r)
          (poll-done kid (Sub tries 1))))))
  (define done-rec (poll-done ("ts" "r1") 4096))
  (define vq (Ix 0 (ask ["query" (snoc ("ts" "dt") eqp-node)])))
  (define done2
    (Seq (inject (vine-make [tio tdt ("ts" "r2")] ((app ["dt" "req"]) eqp-node)))
      (poll-done ("ts" "r2") 4096)))
  [;; the request completed, both eq_pith doctests passed.  (IsApp,
   ;; not an Eq-0 check: shallow Eq against the deep record misreads
   ;; here — same corruption family as the top-level-assert notes.)
   (If (IsApp done-rec) 1 0)
   (Eq 2 (tslot-f [("ts" "passed")] 99 done-rec))
   (Eq 0 (tslot-f [("ts" "failed")] 99 done-rec))
   ;; the verdict rides the entry's dt kid, the entry stays untouched
   (Eq "/boot/res/known" (Hd vq))
   (has-slot-f [("ts" "dt")] (_0 vq))
   ;; a second request re-runs (the dt kid pokes, not re-makes)
   (If (IsApp done2) 1 0)
   (Eq 2 (tslot-f [("ts" "passed")] 99 done2))])

assert(Equal [1 1 1 1 1 1 1] (doctest-driver-checks 0))

(define z-doctest-e (ZoneEnd z-doctest))
(define z-doctest-app (ZoneStart "doctest-app"))
;;; 7b. an app-module target: the life module compiles outside the ;;;;;;;;;;;;;;;;;
;;; core chain, so its cases must evaluate against its OWN cache-entry
;;; subject — against the core's subject every app case reads
;;; "doctest error" (the regression this section pins).

(define life-step-node
  [("ts" "boot") ("ts" "apps") ("ts" "life") ("ts" "main")
   ("u" 1) ("ts" "step")])

(define (app-doctest-driver-checks z)
  (define tslot-f (app ["myth" "nat_at"]))
  (define (poll-done kid tries)
    (If (Eq 0 tries)
      0
      (let ((r (Ix 0 (ask ["query" [tio tdt kid]]))))
        (If (And (Eq "/boot/res/known" (Hd r))
              (Eq 1 (tslot-f [("ts" "res_done")] 0 (_0 r))))
          (_0 r)
          (poll-done kid (Sub tries 1))))))
  (define done3
    (Seq (inject (vine-make [tio tdt ("ts" "r3")]
                   ((app ["dt" "req"]) life-step-node)))
      (poll-done ("ts" "r3") 4096)))
  [(If (IsApp done3) 1 0)
   ;; all three step cases pass; none read "doctest error"
   (Eq 3 (tslot-f [("ts" "passed")] 99 done3))
   (Eq 0 (tslot-f [("ts" "failed")] 99 done3))])

assert(Equal [1 1 1] (app-doctest-driver-checks 0))

(define z-doctest-app-e (ZoneEnd z-doctest-app))
(define z-chore-bridge (ZoneStart "chore-bridge"))
;;; 7c. the build families over the /chore bridge: eval and resync ;;;;;;;;;;;;;;;;

(define tch ("ts" "chore"))
assert(Equal ["done"]
  (inject (vine-make [tio tch] ((app ["chore" "cfg"]) ("ts" "eval")))))

;; evaluate against a module's own subject, through a plain form POST
(SendCaps wh3 ["req" "POST" "/chore/eval/demo" "expr=%28add+2+3%29"] [0])
(define rc1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc1))
assert(Eq 1 (contains? "value: 5" (_2 rc1)))
assert(Eq 1 (contains? "type:" (_2 rc1)))

;; a real browser submit carries a trailing CRLF on the hidden expr
;; field (the live "run inline foil" bug) — decode strips it
(SendCaps wh3 ["req" "POST" "/chore/eval/demo" "expr=%28add+2+3%29%0D%0A"] [0])
(define rc1b (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc1b))
assert(Eq 1 (contains? "value: 5" (_2 rc1b)))

;; a broken expression answers the diagnostic, not a crash
(SendCaps wh3 ["req" "POST" "/chore/eval/demo" "expr=%28frobnicate+1%29"] [0])
(define rc2 (Ix 0 (Recv 0)))
assert(Eq 500 (_1 rc2))

;; recompiling an unchanged module reports an empty changeset and
;; green doctests, and the mirror remount rides the same request
(SendCaps wh3 ["req" "POST" "/chore/compile/demo" ""] [0])
(define rc3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc3))
assert(Eq 1 (contains? "0 changed" (_2 rc3)))
assert(Eq 1 (contains? "0 added" (_2 rc3)))
assert(Eq 1 (contains? "passed" (_2 rc3)))

;; an unknown chore verb is a 404, answered without touching the driver
(SendCaps wh3 ["req" "POST" "/chore/zap/demo" ""] [0])
(define rc4 (Ix 0 (Recv 0)))
assert(Eq 404 (_1 rc4))

(define z-chore-bridge-e (ZoneEnd z-chore-bridge))
(define z-vine (ZoneStart "vine"))
;;; 8. the write box: POST /vine emits make/poke/cull as driver cmds ;;;;;;;;;;;;;;;

;; make: the expression evaluates against the boot subject to the myth
(SendCaps wh3 ["req" "POST" "/vine/data/vbox"
               "verb=make&expr=%28myth%2Fsing+%5B%27n%5D+%28pd+41%29%29"] [0])
(define rv1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rv1))
assert(Eq 1 (contains? "/ns/data/vbox" (_2 rv1)))
;; barrier so the async cmd commits, then read the node back
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 2))))
(define vb1 (Ix 0 (ask ["query" [("ts" "data") ("ts" "vbox")]])))
assert(Eq "/boot/res/known" (Hd vb1))
assert(Eq 41 (nat-slot [("ts" "n")] 0 (_0 vb1)))

;; poke melds
(SendCaps wh3 ["req" "POST" "/vine/data/vbox"
               "verb=poke&expr=%28myth%2Fsing+%5B%27n%5D+%28pd+42%29%29"] [0])
(define rv2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rv2))
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 3))))
(define vb2 (Ix 0 (ask ["query" [("ts" "data") ("ts" "vbox")]])))
assert(Eq 42 (nat-slot [("ts" "n")] 0 (_0 vb2)))

;; a broken expression answers 400 and emits nothing
(SendCaps wh3 ["req" "POST" "/vine/data/vbox"
               "verb=poke&expr=%28frobnicate%29"] [0])
(define rv3 (Ix 0 (Recv 0)))
assert(Eq 400 (_1 rv3))

;; a WELL-TYPED expression that isn't a myth is refused up front —
;; poked raw into the kernel it would kill the coordinator's exec
(SendCaps wh3 ["req" "POST" "/vine/data/vbox"
               "verb=poke&expr=%28pd+5%29"] [0])
(define rv3m (Ix 0 (Recv 0)))
assert(Eq 400 (_1 rv3m))
assert(Eq 1 (contains? "must evaluate to a myth" (_2 rv3m)))

;; a write the KERNEL rejects answers 500 with the rendered err —
;; the reply waits on the cmd's ack, so it reports the real verdict
;; (a poke at a node that never existed fails the event)
(SendCaps wh3 ["req" "POST" "/vine/data/nothing_here"
               "verb=poke&expr=%28myth%2Fsing+%5B%27n%5D+%28pd+7%29%29"] [0])
(define rv3b (Ix 0 (Recv 0)))
assert(Eq 500 (_1 rv3b))
assert(Eq 1 (contains? "poke_missing" (_2 rv3b)))
;; and the ack queue stayed paired: an ordinary request still answers
(SendCaps wh3 ["req" "GET" "/ns/data/x" ""] [0])
(define rv3c (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rv3c))
assert(Eq 1 (contains? "41" (_2 rv3c)))

;; an anonymous task's rejection RETURNS now: the ask replies
;; ["fail" err] instead of a hollow ["done"]
assert(Equal ["fail" ("ts" "poke_missing")]
  (inject (vine-poke [("ts" "no") ("ts" "where")] myth-new)))

;; cull tombstones
(SendCaps wh3 ["req" "POST" "/vine/data/vbox" "verb=cull"] [0])
(define rv4 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rv4))
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 4))))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [("ts" "data") ("ts" "vbox")]])))

(define z-vine-e (ZoneEnd z-vine))
(define z-shutdown (ZoneStart "shutdown"))
;;; 9. clean shutdown ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Equal ["bye"] (Ix 0 (ask ["stop"])))

(define z-shutdown-e (ZoneEnd z-shutdown))
(print "helm-http tests passed")
