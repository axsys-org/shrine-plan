assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 4))))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [("ts" "data") ("ts" "vbox")]])))

;; Keep browser decoding at the transport boundary, not in app cases.
(SendCaps wh3 ["req" "POST" "/edit/app/demo/tgt"
  "text=line%0D%0Avalue"] [0])
assert(Eq 200 (_1 (_0 (Recv 0))))
(Seq (define edited (_0 (_0 (ask ["query" [("ts" "app") ("ts" "demo") ("ts" "tgt")]])))) (DeepSeq edited 0))
assert(Equal (strcat ["line" 10 "value"]) (txt-slot [("ts" "text")] edited))
(SendCaps wh3 ["req" "POST" "/post/app/demo/tgt" "text=post+value"] [0])
assert(Eq 200 (_1 (_0 (Recv 0))))
(Seq (define posted (_0 (_0 (ask ["query" [("ts" "app") ("ts" "demo") ("ts" "tgt")]])))) (DeepSeq posted 0))
assert(Equal "post value" (txt-slot [("ts" "post") ("ts" "text")] posted))
;; Historical response still renders the original value after a live poke.
assert(Equal ["done"] (inject (vine-poke [tdata tx] (t-data [("ts" "num")] 99))))
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/data/x" ""] [0])
(Seq (define historical (_0 (Recv 0))) (DeepSeq historical 0))
assert(Eq 200 (_1 historical))
assert(Eq 1 (contains? "41" (_2 historical)))
assert(Eq 1 (contains? "view live" (_2 historical)))

(SendCaps wh3 ["req" "POST" "/post/nowhere" "text=x"] [0])
(Seq (define missing-post (Ix 0 (Recv 0))) (DeepSeq missing-post 0))
assert(Eq 500 (_1 missing-post))
assert(Eq 1 (contains? "poke_missing" (_2 missing-post)))

assert(Equal ["bye"] (Ix 0 (ask ["stop"])))

(print "helm-http tests passed")
