;;;; HTTP transport contracts on a small namespace and three mirror modules.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind helm (#module compiler-host))
(#bind helm-http (#module helm-http))
(#bind helm-chore (#module helm-chore))
(#bind helm-doctest (#module helm-doctest))
(#bind helm-build (#module helm-build))

(Seq (define core
       (helm:helm-pack
         (foil:compile-mod-cached (_0 helm:tools-compiled)
           foil:default-subject "test_fixtures/http")))
  (DeepSeq core 0))

(define (app path) (helm:core-ent core path))
(Seq (define myth-new (app ["myth" "new"])) (DeepSeq myth-new 0))
(Seq (define myth-sing (app ["myth" "sing"])) (DeepSeq myth-sing 0))
(Seq (define myth-add (app ["myth" "add"])) (DeepSeq myth-add 0))
(Seq (define limb-nat (app ["twig" "nat"])) (DeepSeq limb-nat 0))
(Seq (define pd-f (app ["pd"])) (DeepSeq pd-f 0))
(define (t-data slot n) (myth-sing slot (pd-f n)))
(define (put-nat t slot n) (myth-add (limb-nat slot n) t))
(define (vine-make p t) ("/boot/task/vine" p ("/boot/writ/make" t)))
(define (vine-poke p t) ("/boot/task/vine" p ("/boot/writ/poke" t)))
(define (vine-cull p) ("/boot/task/vine" p "/boot/writ/cull"))
(Seq (define http-cfg (app ["http" "cfg"])) (DeepSeq http-cfg 0))
(Seq (define txt-slot (app ["myth" "txt_at"])) (DeepSeq txt-slot 0))
(Seq (define nat-slot (app ["myth" "nat_at"])) (DeepSeq nat-slot 0))

(define (fixture-cache z)
  (define c1 (_0 (helm:cache-compile (helm:core-cache core) "demo")))
  (_0 (helm:cache-compile c1 "test_fixtures/mirror")))
(define (mirror-cache z)
  (filter (lambda (entry)
    (includes (Eq (_0 entry)) ["sept" "demo" "test_fixtures/mirror"]))
    (fixture-cache 0)))

(Seq (define coord
  (let* ((helpers
           ["H" (app ["http" "req"]) (app ["myth" "nat_at"]) vine-make
            vine-cull (app ["myth" "txt_at"])
            (app ["build" "eval_req"]) (app ["build" "compile_req"])
            (app ["build" "save_req"]) vine-poke (helm:core-sut core)
            myth-new (app ["myth" "add"]) (app ["twig" "txt"])
            (app ["weft" "runtime"])])
         (dhelpers
           ["D" (helm:core-sut core) (fixture-cache 0)
            (app ["myth" "pail_at"]) (app ["doctest" "card"])
            (app ["chore" "mkp_t"])])
         (chelpers
           ["C" (app ["fetch" "fresh"]) (app ["chore" "fam_of"])
            (app ["chore" "done_t"]) (app ["chore" "fail_t"])
            (app ["chore" "clear_t"]) (app ["chore" "cmd_parts"])
            vine-poke vine-make])
         (bs [core (fixture-cache 0)])
         (fams
           (Weld [(helm-doctest:dt-family dhelpers)]
             (helm-build:build-families bs)))
         (mk-worker
           (lambda (n)
             (cond
               ((Equal n ("ts" "doctest")) (helm-chore:mk-chore-worker chelpers fams n))
               ((Equal n ("ts" "chore")) (helm-chore:mk-chore-worker chelpers fams n))
               (else (helm-http:mk-http-worker (helm-http:prepare helpers) (app ["http_driver" "step"]) n)))))
         (s (helm:seed-tasks core (app ["http_fixture" "seeded"])
              (Weld (helm:boot-mirror-pact-tasks-with (mirror-cache 0) core)
                (helm:boot-ns-index-tasks core (mirror-cache 0))))))
    (Seq (DeepSeq (put-nat myth-new [("ts" "warm")] 1) 0)
      (Seq (DeepSeq
             [((app ["chore" "done_t"]) 1 0)
              ((app ["chore" "clear_t"]) ("ts" "k"))
              ((app ["chore" "fail_t"]) ("ts" "x"))
              ((app ["chore" "fam_of"]) ("ts" "d") myth-new)
              ((app ["chore" "cmd_parts"])
                ((app ["chore" "mkp_t"]) [("ts" "a")] myth-new))
              (helm-doctest:dt-plan dhelpers
                ((app ["dt" "req"]) [("ts" "boot")]) [("ts" "io")])
              (helm-build:eval-plan bs
                ((app ["build" "eval_req"]) "demo" "(add 1 1)")
                [("ts" "io")])
              (helm-build:eval-run bs ["demo" "(add 1 1)" [("ts" "io")]] 0)
              (helm-build:compile-plan bs
                ((app ["build" "compile_req"]) "mapx") [("ts" "io")])
              (helm-build:save-plan bs
                ((app ["build" "save_req"]) "mapx" "x") [("ts" "io")])
              (helm-build:resync-run bs ["mapx" [("ts" "io")]] 0)
              (helm-http:form-field "expr" "expr=%28add+1+1%29")
              helpers chelpers fams]
             0)
        (Seq (DeepSeq s s)
          (Spawn (helm:helm-actor core mk-worker (lambda (hm) 0) s))))))) (DeepSeq coord 0))

(define (ask m)
  (Seq (SendCaps coord (DeepSeq m m) [0])
    (Recv 0)))
(define (inject t)
  (Ix 0 (ask ["task" t])))

;; Actor request/response boundary: startup, echo, cleanup and failure.
(Seq (define tio ("ts" "io")) (DeepSeq tio 0))
(Seq (define thttp ("ts" "http_client")) (DeepSeq thttp 0))

assert(Equal ["done"] (inject (vine-make [tio thttp] (http-cfg ("ts" "hrespond")))))
assert(Equal [thttp] (Ix 0 (ask ["crew"])))
(Seq (define hr (ask ["handle" thttp])) (DeepSeq hr 0))
assert(Equal ["handle"] (Ix 0 hr))
(Seq (define wh (Ix 0 (Ix 1 hr))) (DeepSeq wh 0))

(SendCaps wh ["req" "GET" "/w.js" ""] [0])
(Seq (define ready (Ix 0 (Recv 0))) (DeepSeq ready 0))
assert(Eq 200 (_1 ready))
assert(Equal "application/javascript" (_3 ready))
(Seq (define hv0 (Ix 0 (ask ["query" [("ts" "h") ("ts" "v") ("u" 2) tio thttp]]))) (DeepSeq hv0 0))
assert(Eq "/boot/res/known" (Hd hv0))
(Seq (define hvm0 (_0 hv0)) (DeepSeq hvm0 0))
assert(Equal "2" (txt-slot [("ts" "x_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "x_shape")] hvm0))
assert(Equal "2" (txt-slot [("ts" "y_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "y_shape")] hvm0))
assert(Equal "2" (txt-slot [("ts" "z_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "z_shape")] hvm0))

(SendCaps wh ["req" "GET" "/ping" "hello"] [0])
(Seq (define r1 (Ix 0 (Recv 0))) (DeepSeq r1 0))
assert(Eq "res" (_0 r1))
assert(Eq 200 (_1 r1))
assert(Equal "hello" (_2 r1))

(SendCaps wh ["req" "POST" "/again" "world"] [0])
(Seq (define r2 (Ix 0 (Recv 0))) (DeepSeq r2 0))
assert(Eq 200 (_1 r2))
assert(Equal "world" (_2 r2))

assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 1))))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r1")]])))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r2")]])))

(Seq (define tbad ("ts" "bad")) (DeepSeq tbad 0))
assert(Equal ["done"] (inject (vine-make [tio tbad] (http-cfg ("ts" "zzz")))))
(Seq (define hr2 (ask ["handle" tbad])) (DeepSeq hr2 0))
(Seq (define wh2 (Ix 0 (Ix 1 hr2))) (DeepSeq wh2 0))
(SendCaps wh2 ["req" "GET" "/nope" ""] [0])
(Seq (define r3 (Ix 0 (Recv 0))) (DeepSeq r3 0))
assert(Eq "res" (_0 r3))
assert(Eq 500 (_1 r3))
assert(Equal "kook_unknown" (_2 r3))

(define (starts-with pre s)
  (Eq pre (Mod s (Lsh 1 (Mul 8 (Bytes pre))))))
(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))

(define (tree-path path) (strcat ["path=" 34 path 34]))

;; One explorer record and one mounted app cover generic routes.
(Seq (define tdata ("ts" "data")) (DeepSeq tdata 0))
(Seq (define tx ("ts" "x")) (DeepSeq tx 0))
(Seq (define tkid ("ts" "kid")) (DeepSeq tkid 0))
assert(Equal ["done"] (inject (vine-make [tdata tx] (t-data [("ts" "num")] 41))))
assert(Equal ["done"] (inject (vine-make [tdata tx tkid] (t-data [("ts" "num")] 42))))

(Seq (define tnsx ("ts" "nsx")) (DeepSeq tnsx 0))
assert(Equal ["done"] (inject (vine-make [tio tnsx] (http-cfg ("ts" "hex")))))
(Seq (define hr3 (ask ["handle" tnsx])) (DeepSeq hr3 0))
(Seq (define wh3 (Ix 0 (Ix 1 hr3))) (DeepSeq wh3 0))
(SendCaps wh3 ["req" "GET" "/ns/data/x" ""] [0])
(Seq (define r5 (Ix 0 (Recv 0))) (DeepSeq r5 0))
assert(Eq "res" (_0 r5))
assert(Eq 200 (_1 r5))
assert(Eq 1 (starts-with "text/html" (_3 r5)))
(Seq (define body5 (_2 r5)) (DeepSeq body5 0))
assert(Eq 1 (starts-with "<!doctype html>" body5))
assert(Eq 1 (contains? "/ns/data/x" body5))
assert(Eq 1 (contains? "/num" body5))
assert(Eq 1 (contains? "41" body5))
assert(Eq 1 (contains? (tree-path "/data/x/kid") body5))
(SendCaps wh3 ["req" "GET" "/ns" ""] [0])
(Seq (define r6 (Ix 0 (Recv 0))) (DeepSeq r6 0))
assert(Eq 200 (_1 r6))
assert(Eq 1 (contains? (tree-path "/data") (_2 r6)))
assert(Eq 1 (contains? (tree-path "/io") (_2 r6)))
assert(Eq 1 (contains? (tree-path "/boot") (_2 r6)))

(define (mount-app-via-card name root)
  (define r (helm:compile-apps core (helm:core-cache core) [name]))
  (define mani (_1 (_1 (_0 (_1 r)))))
  (inject (vine-make root
    ((app ["pact" "card"]) mani (strcat ["apps/" name "/main"]) 0 0))))

assert(Equal ["done"] (mount-app-via-card "life" [("ts" "app") ("ts" "life")]))
assert(Equal ["done"] (inject (vine-make [("ts" "app") ("ts" "demo") ("ts" "tgt")] myth-new)))

