(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind helm-http (#module helm-http))
(#bind helm-chore (#module helm-chore))
(#bind helm-doctest (#module helm-doctest))
(#bind helm-build (#module helm-build))


;;; The HTTP driver end-to-end, minus sockets (no outbound-connect
;;; primitive exists): main impersonates connection actors, sending
;;; ["req" method url body] straight to the worker and receiving
;;; ["res" status body] — the same seam the socket layer uses.  The
;;; request cycle inside one event: the bare request record is made
;;; under /io/http, the SERVING kook installed there receives the
;;; kid-add gift and pokes the configured responder kook onto the
;;; request node, whose talk writes the response slots; the driver's
;;; spy then delivers the finished record.  Every wait is causal.

(define core (helm:load-helm-mod "helmapp"))

(define (app path) (helm:core-ent core path))
;; t_data / put_nat left the app: rebuild them from the myth kit
;; (myth/new is a constant now — the entry value IS the empty myth)
(define myth-new (app ["myth" "new"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-add (app ["myth" "add"]))
(define limb-nat (app ["limb" "nat"]))
(define pd-f (app ["pd"]))
(define (t-data slot n) (myth-sing slot (pd-f n)))
(define (put-nat t slot n) (myth-add (limb-nat slot n) t))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define http-cfg (app ["http" "cfg"]))
(define txt-slot (app ["myth" "txt_at"]))

(define helpers
  ["H" (app ["http" "req"]) (app ["myth" "nat_at"]) (app ["vine_make"])
   (app ["vine_cull"]) (app ["myth" "txt_at"])
   (app ["build" "eval_req"]) (app ["build" "compile_req"])
   (app ["build" "save_req"])])

;; the cache extended with the life app, like the real boot's — the
;; doctest fixtures cover an app-module target (compiled outside the
;; core chain) alongside the kernel ones
(define (life-cache z)
  (_0 (helm:compile-apps core (helm:core-cache core) ["life"])))

(define dhelpers
  ["D" (helm:core-sut core) (life-cache 0)
   (app ["myth" "pail_at"]) (app ["doctest" "card"])
   (app ["chore" "mkp_t"])])

(define chelpers
  ["C" (app ["fetch" "fresh"]) (app ["chore" "fam_of"])
   (app ["chore" "done_t"]) (app ["chore" "fail_t"])
   (app ["chore" "clear_t"]) (app ["chore" "cmd_parts"])
   (app ["vine_poke"]) (app ["vine_make"])])

(define bs [core (life-cache 0)])

(define fams
  (Weld [(helm-doctest:dt-family dhelpers)]
    (helm-build:build-families bs)))

(define (mk-worker n)
  (cond
    ((Equal n ("ts" "doctest")) (helm-chore:mk-chore-worker chelpers fams n))
    ((Equal n ("ts" "chore")) (helm-chore:mk-chore-worker chelpers fams n))
    (else (helm-http:mk-http-worker helpers n))))

;; the registry plus the /boot mirror: the explorer fixtures browse
;; the system's own code.  Seeded and deep-forced HERE in main — a
;; lazy seed would first be demanded inside the spawned coordinator,
;; where reef code cannot compile ("no compiler set").  No top-level
;; define holds the giant sovereign (the repl journal would echo it).
(define coord
  (let ((s (helm:seed-tasks core (app ["seeded"])
             (Weld (helm:boot-mirror-tasks-with (life-cache 0) core)
               (helm:boot-ns-index-tasks core (life-cache 0))))))
    ;; put-nat is local glue the workers call: one MAIN call compiles it
    (Seq (DeepSeq (put-nat myth-new [("ts" "warm")] 1) 0)
      ;; chore glue: one MAIN call per compiled entry and rvr path the
      ;; chore worker and its leaves replay off-MAIN
      (Seq (DeepSeq
             [((app ["chore" "done_t"]) 1 0)
              ((app ["chore" "clear_t"]) ("ts" "k"))
              ((app ["chore" "fail_t"]) ("ts" "x"))
              ((app ["chore" "fam_of"]) ("ts" "d") myth-new)
              ((app ["chore" "cmd_parts"])
                ((app ["chore" "mkp_t"]) [("ts" "a")] myth-new))
              (helm-doctest:dt-plan dhelpers
                ((app ["dt" "req"]) [("ts" "boot")]) [("ts" "io")])
              (helm-build:eval-plan bs
                ((app ["build" "eval_req"]) "sept" "(add 1 1)")
                [("ts" "io")])
              (helm-build:eval-run bs ["sept" "(add 1 1)" [("ts" "io")]] 0)
              (helm-build:compile-plan bs
                ((app ["build" "compile_req"]) "weft") [("ts" "io")])
              (helm-build:save-plan bs
                ((app ["build" "save_req"]) "weft" "x") [("ts" "io")])
              (helm-build:resync-run bs ["weft" [("ts" "io")]] 0)
              (helm-http:form-field "expr" "expr=%28add+1+1%29")]
             0)
        (Seq (DeepSeq s s)
          (Spawn (helm:helm-actor core mk-worker (lambda (hm) 0) s)))))))

(define (ask m)
  (Seq (SendCaps coord (DeepSeq m m) [0])
    (Recv 0)))
(define (inject t)
  (Ix 0 (ask ["task" t])))

(define tio ("ts" "io"))
(define thttp ("ts" "http-client"))

;;; 1. make /io/http with the serving kook installed: the driver is born ;;;;;;;;;;;;

assert(Equal ["done"] (inject (vine-make [tio thttp] (http-cfg ("ts" "hrespond")))))
assert(Equal [thttp] (Ix 0 (ask ["crew"])))
(define hr (ask ["handle" thttp]))
assert(Equal ["handle"] (Ix 0 hr))
(define wh (Ix 0 (Ix 1 hr)))

;; Boot has already committed hundreds of unrelated epochs, but this
;; path was created once: all six public counters begin at one.
(define hv0 (Ix 0 (ask ["query" [("ts" "h") ("ts" "v") ("u" 2) tio thttp]])))
assert(Eq "/boot/res/known" (Hd hv0))
(define hvm0 (_0 hv0))
assert(Equal "1" (txt-slot [("ts" "x_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "x_shape")] hvm0))
assert(Equal "1" (txt-slot [("ts" "y_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "y_shape")] hvm0))
assert(Equal "1" (txt-slot [("ts" "z_data")] hvm0))
assert(Equal "1" (txt-slot [("ts" "z_shape")] hvm0))

;;; 2. a request rides the namespace and comes back 200, echoed ;;;;;;;;;;;;;;;;;;;;

(SendCaps wh ["req" "GET" "/ping" "hello"] [0])
(define r1 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r1))
assert(Eq 200 (_1 r1))
assert(Equal "hello" (_2 r1))

;;; 3. a second request gets a fresh serial; both nodes were culled ;;;;;;;;;;;;;;;;;

(SendCaps wh ["req" "POST" "/again" "world"] [0])
(define r2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r2))
assert(Equal "world" (_2 r2))

;; barrier, then look for tombstones where the request nodes lived
assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 1))))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r0")]])))
assert(Equal "/boot/res/null" (Ix 0 (ask ["query" [tio thttp ("ts" "r1")]])))

;;; 4. an unknown responder fails the installing poke: the event dies, 500 ;;;;;;;;;;

(define tbad ("ts" "bad"))
assert(Equal ["done"] (inject (vine-make [tio tbad] (http-cfg ("ts" "zzz")))))
(define hr2 (ask ["handle" tbad]))
(define wh2 (Ix 0 (Ix 1 hr2)))
(SendCaps wh2 ["req" "GET" "/nope" ""] [0])
(define r3 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r3))
assert(Eq 500 (_1 r3))
assert(Equal "kook_unknown" (_2 r3))

;;; 5. the explorer: the namespace served as HTML ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (starts-with pre s)
  (Eq pre (Mod s (Lsh 1 (Mul 8 (Bytes pre))))))
(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))

;; seed some namespace to explore
(define tdata ("ts" "data"))
(define tx ("ts" "x"))
(define tkid ("ts" "kid"))
assert(Equal ["done"] (inject (vine-make [tdata tx] (t-data [("ts" "num")] 41))))
assert(Equal ["done"] (inject (vine-make [tdata tx tkid] (t-data [("ts" "num")] 42))))

;; an explorer driver at /io/nsx
(define tnsx ("ts" "nsx"))
assert(Equal ["done"] (inject (vine-make [tio tnsx] (http-cfg ("ts" "hex")))))
(define hr3 (ask ["handle" tnsx]))
(define wh3 (Ix 0 (Ix 1 hr3)))
(SendCaps wh3 ["req" "GET" "/ns/data/x" ""] [0])
(define r5 (Ix 0 (Recv 0)))
assert(Eq "res" (_0 r5))
assert(Eq 200 (_1 r5))
;; html content type, page shell, breadcrumb links, the slot, the kid
assert(Eq 1 (starts-with "text/html" (_3 r5)))
(define body5 (_2 r5))
assert(Eq 1 (starts-with "<!doctype html>" body5))
assert(Eq 1 (contains? "/ns/data/x" body5))
assert(Eq 1 (contains? "/num" body5))
assert(Eq 1 (contains? "41" body5))
assert(Eq 1 (contains? "/ns/data/x/kid" body5))
;; the root view lists top-level kids, including the boot image
(SendCaps wh3 ["req" "GET" "/ns" ""] [0])
(define r6 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r6))
assert(Eq 1 (contains? "/ns/data" (_2 r6)))
assert(Eq 1 (contains? "/ns/io" (_2 r6)))
assert(Eq 1 (contains? "/ns/boot" (_2 r6)))

;;; 5b. the /boot mirror through the explorer: code browsed from inside ;;;;;;;;;;;;;

;; the boot node lists the compiled modules
(SendCaps wh3 ["req" "GET" "/ns/boot" ""] [0])
(define r7 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r7))
assert(Eq 1 (contains? "/ns/boot/helm" (_2 r7)))
assert(Eq 1 (contains? "/ns/boot/lain" (_2 r7)))
assert(Eq 1 (contains? "the boot image" (_2 r7)))

;; a file node renders its source in a pre block
(SendCaps wh3 ["req" "GET" "/ns/boot/helm" ""] [0])
(define r8 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r8))
assert(Eq 1 (contains? "<pre>" (_2 r8)))
assert(Eq 1 (contains? "Take the helm" (_2 r8)))

;; an entry node shows its kind and its own source
(SendCaps wh3 ["req" "GET" "/ns/boot/lain/1/dep" ""] [0])
(define r9 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r9))
assert(Eq 1 (contains? "row type" (_2 r9)))
assert(Eq 1 (contains? "/kind" (_2 r9)))
assert(Eq 1 (contains? "/src" (_2 r9)))
;; the mirror's extra panes: rendered type text rides ['ty]
assert(Eq 1 (contains? "/ty" (_2 r9)))

;;; 5c. reference slots and the ns index ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Imported TC_GLOBAL edges use unit-qualified storage paths.  The mirror maps
;; those back to the source entries on both sides of the call.
(define cross-ref
  [(helm:boot-ent-node "web" ["explorer" "page"])
   (helm:boot-ent-node "sept" ["eq_pith"])])
assert(includes (Equal cross-ref)
  (helm:boot-ref-table (helm:core-cache core)))

;; a function entry carries who-calls rows as mirror-path links
(SendCaps wh3 ["req" "GET" "/ns/boot/sept/1/eq_pith" ""] [0])
(define r9b (Ix 0 (Recv 0)))
assert(Eq 200 (_1 r9b))
assert(Eq 1 (contains? "/called_by" (_2 r9b)))

;; /boot/ns/<root> groups entries by source namespace root
(SendCaps wh3 ["req" "GET" "/ns/boot/ns/chore" ""] [0])
(define rns (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rns))
assert(Eq 1 (contains? "/ns/boot/chore" (_2 rns)))

;;; 5d. time travel through the explorer: /h browses history ;;;;;;;;;;;;;;;;;;;;;;;;

;; the overlay root lists the three cares
(SendCaps wh3 ["req" "GET" "/ns/h" ""] [0])
(define rh1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh1))
assert(Eq 1 (contains? "/ns/h/x" (_2 rh1)))
assert(Eq 1 (contains? "/ns/h/y" (_2 rh1)))
assert(Eq 1 (contains? "/ns/h/z" (_2 rh1)))

;; Every exact registry path has its own case 1, independent of the
;; order in which the registry was seeded.
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/count" ""] [0])
(define rh2 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh2))
assert(Eq 1 (contains? "form" (_2 rh2)))
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/echo" ""] [0])
(define rh3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh3))
assert(Eq 1 (contains? "form" (_2 rh3)))

;; /kook carries the registry convention's lore (shrine-apps.md 7):
;; the root documents itself, and its children stay browsable.
(SendCaps wh3 ["req" "GET" "/ns/h/z/1/1/kook" ""] [0])
(define rh4 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh4))
assert(Eq 1 (contains? "behavior registry" (_2 rh4)))

(SendCaps wh3 ["req" "GET" "/ns/kook" ""] [0])
(define rh4b (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh4b))
assert(Eq 1 (contains? "/ns/kook/count" (_2 rh4b)))
assert(Eq 1 (contains? "behavior registry" (_2 rh4b)))

;; the coordinator query verb rides the same overlay
(define qh (Ix 0 (ask ["query" [("ts" "h") ("ts" "x") ("u" 1) ("u" 2) ("ts" "kook") ("ts" "count")]])))
assert(Eq "/boot/res/known" (Hd qh))

;; live pages carry the version pane: lock cases, state, and links
;; into the node's history
(SendCaps wh3 ["req" "GET" "/ns/kook/count" ""] [0])
(define rh5 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rh5))
assert(Eq 1 (contains? "version" (_2 rh5)))
assert(Eq 1 (contains? "/x_data" (_2 rh5)))
assert(Eq 1 (contains? "live" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/x/1/2/kook/count" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/y/1/2/kook/count" (_2 rh5)))
assert(Eq 1 (contains? "/ns/h/z/1/2/kook/count" (_2 rh5)))

;; /h pages link back to the live node
(SendCaps wh3 ["req" "GET" "/ns/h/x/1/2/kook/count" ""] [0])
(define rh6 (Ix 0 (Recv 0)))
assert(Eq 1 (contains? "view live" (_2 rh6)))
assert(Eq 1 (contains? "/ns/kook/count" (_2 rh6)))

;;; 6. the response builder speaks HTTP ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define resp (helm-http:http-res 200 "text/plain" "hi"))
assert(Eq 1 (starts-with "HTTP/1.0 200 OK" resp))
assert(Eq 1 (starts-with "HTTP/1.0 500" (helm-http:http-res 500 "text/plain" "boom")))

;;; 7. the doctest driver end to end: request in, verdict kid out ;;;;;;;;;;;;;;;;;;;
;;; One check function, one flag-row assert — top-level asserts over
;;; the deep records corrupt (session-leak notes).

(define tdt ("ts" "doctest"))
(define eqp-node
  [("ts" "boot") ("ts" "sept") ("ts" "1") ("ts" "eq_pith")])
assert(Equal ["done"] (inject (vine-make [tio tdt] (app ["dt" "cfg"]))))
assert(Equal ["done"]
  (inject (vine-make [tio tdt ("ts" "r1")] ((app ["dt" "req"]) eqp-node))))

(define (doctest-driver-checks z)
  (define tslot-f (app ["myth" "nat_at"]))
  (define has-slot-f (app ["myth" "has_at"]))
  ;; the worker answers asynchronously; each ask is a synchronous
  ;; barrier, so a bounded poll converges.  Evaluation rides a leaf
  ;; actor now (helm-chore.rvr), so completion is wall-clock async —
  ;; the budget covers a cold app-subject eval, not a few turns
  (define (poll-done kid tries)
    (If (Eq 0 tries)
      0
      (let ((r (Ix 0 (ask ["query" [tio tdt kid]]))))
        (If (And (Eq "/boot/res/known" (Hd r))
              (Eq 1 (tslot-f [("ts" "res_done")] 0 (_0 r))))
          (_0 r)
          (poll-done kid (Sub tries 1))))))
  (define done-rec (poll-done ("ts" "r1") 4096))
  (define vq (Ix 0 (ask ["query" (snoc ("ts" "dt") eqp-node)])))
  (define done2
    (Seq (inject (vine-make [tio tdt ("ts" "r2")] ((app ["dt" "req"]) eqp-node)))
      (poll-done ("ts" "r2") 4096)))
  [;; the request completed, both eq_pith doctests passed.  (IsApp,
   ;; not an Eq-0 check: shallow Eq against the deep record misreads
   ;; here — same corruption family as the top-level-assert notes.)
   (If (IsApp done-rec) 1 0)
   (Eq 2 (tslot-f [("ts" "passed")] 99 done-rec))
   (Eq 0 (tslot-f [("ts" "failed")] 99 done-rec))
   ;; the verdict rides the entry's dt kid, the entry stays untouched
   (Eq "/boot/res/known" (Hd vq))
   (has-slot-f [("ts" "dt")] (_0 vq))
   ;; a second request re-runs (the dt kid pokes, not re-makes)
   (If (IsApp done2) 1 0)
   (Eq 2 (tslot-f [("ts" "passed")] 99 done2))])

assert(Equal [1 1 1 1 1 1 1] (doctest-driver-checks 0))

;;; 7b. an app-module target: the life module compiles outside the ;;;;;;;;;;;;;;;;;
;;; core chain, so its cases must evaluate against its OWN cache-entry
;;; subject — against the core's subject every app case reads
;;; "doctest error" (the regression this section pins).

(define life-step-node
  [("ts" "boot") ("ts" "apps") ("ts" "life") ("ts" "main")
   ("ts" "1") ("ts" "step")])

(define (app-doctest-driver-checks z)
  (define tslot-f (app ["myth" "nat_at"]))
  (define (poll-done kid tries)
    (If (Eq 0 tries)
      0
      (let ((r (Ix 0 (ask ["query" [tio tdt kid]]))))
        (If (And (Eq "/boot/res/known" (Hd r))
              (Eq 1 (tslot-f [("ts" "res_done")] 0 (_0 r))))
          (_0 r)
          (poll-done kid (Sub tries 1))))))
  (define done3
    (Seq (inject (vine-make [tio tdt ("ts" "r3")]
                   ((app ["dt" "req"]) life-step-node)))
      (poll-done ("ts" "r3") 4096)))
  [(If (IsApp done3) 1 0)
   ;; all three step cases pass; none read "doctest error"
   (Eq 3 (tslot-f [("ts" "passed")] 99 done3))
   (Eq 0 (tslot-f [("ts" "failed")] 99 done3))])

assert(Equal [1 1 1] (app-doctest-driver-checks 0))

;;; 7c. the build families over the /chore bridge: eval and resync ;;;;;;;;;;;;;;;;

(define tch ("ts" "chore"))
assert(Equal ["done"]
  (inject (vine-make [tio tch] ((app ["chore" "cfg"]) ("ts" "eval")))))

;; evaluate against a module's own subject, through a plain form POST
(SendCaps wh3 ["req" "POST" "/chore/eval/sept" "expr=%28add+2+3%29"] [0])
(define rc1 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc1))
assert(Eq 1 (contains? "value: 5" (_2 rc1)))
assert(Eq 1 (contains? "type:" (_2 rc1)))

;; a broken expression answers the diagnostic, not a crash
(SendCaps wh3 ["req" "POST" "/chore/eval/sept" "expr=%28frobnicate+1%29"] [0])
(define rc2 (Ix 0 (Recv 0)))
assert(Eq 500 (_1 rc2))

;; recompiling an unchanged module reports an empty changeset and
;; green doctests, and the mirror remount rides the same request
(SendCaps wh3 ["req" "POST" "/chore/compile/sept" ""] [0])
(define rc3 (Ix 0 (Recv 0)))
assert(Eq 200 (_1 rc3))
assert(Eq 1 (contains? "0 changed" (_2 rc3)))
assert(Eq 1 (contains? "0 added" (_2 rc3)))
assert(Eq 1 (contains? "passed" (_2 rc3)))

;; an unknown chore verb is a 404, answered without touching the driver
(SendCaps wh3 ["req" "POST" "/chore/zap/sept" ""] [0])
(define rc4 (Ix 0 (Recv 0)))
assert(Eq 404 (_1 rc4))

;;; 8. clean shutdown ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Equal ["bye"] (Ix 0 (ask ["stop"])))

(print "helm-http tests passed")
