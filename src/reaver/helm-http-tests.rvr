assert(Equal ["done"] (inject (vine-poke [tio thttp] (t-data [("ts" "keep")] 3))))
(Seq (define vb2 (Ix 0 (ask ["query" [("ts" "data") ("ts" "vbox")]]))) (DeepSeq vb2 0))
assert(Eq 42 (nat-slot [("ts" "n")] 0 (_0 vb2)))

