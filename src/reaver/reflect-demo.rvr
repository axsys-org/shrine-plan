;; Reflection demo: compile with the caller's prepared publication context and use
;; the reflection API to render every declaration's type, inspect a
;; generic's scheme, and type a live expression.
(#bind std (#module std))
(#import std)
(#bind rex (#module rex))
(#bind foil-sast (#module foil-sast))
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind elab (#module foil-new-elab))
(#bind nt (#module foil-new-types))
(#bind render (#module foil-render))

(define src "
+  temp
  '  A labelled temperature reading.
  :  site=iota celsius=nat
+  reading
  &  ($ok temp)
     $missing
+  stash
  (@@ v)
  +  empty
    :
  +  node
    :  val=v rest=stash[v]
  &  stash/empty
     stash/node[v]
  +  put
    \  x=v s=stash[v]
    ^  stash[v]
    (stash/node[v] x s)
+  mean_c
  \  rs=row[temp]
  ^  nat
  =  total rs.fold(0 (\ acc t acc.add(t.celsius)))
  (div total rs.len)
")
(define (run context cache)
(define tree (rex:ParseRexNorm src))
(define compiled (driver:compile-rex context cache "reflect-demo" tree))
(define sut (driver:perc-subject (_1 compiled)))
(define compiler (elab:compiler-for sut))

;; 1. Every declaration's rendered type, straight off the subject.
(define (sig name)
  [(print-path name)
   (render:ty-text (tc-ty (got-entry-tc (Weld (sut-root sut) name) sut)))])
(define signatures
  (map sig
    [["temp"] ["reading"] ["stash"] ["stash" "node"] ["stash" "put"]
     ["temp" "celsius"] ["temp" "set_celsius"] ["mean_c"]]))

;; 2. The world: look a generic up and take its scheme apart.
(define world (elab:compiler-world compiler))
(define stash-entry (_1 (nt:lookup-type-entry world (canon-path ["stash"] sut))))
(define stash-facts
  ["params"
   (map nt:parameter-name
     (nt:scheme-parameters (nt:type-entry-scheme stash-entry)))
   "brand" (nt:type-entry-runtime-brand stash-entry)
   "body" (render:ty-text (nt:scheme-body (nt:type-entry-scheme stash-entry)))])

;; 3. A ground instantiation materializes on demand; render its body.
(define ground
  (nt:intern-type-application world (canon-path ["stash"] sut)
    [(nt:type-arg (nt:type-ref (canon-path ["nat"] sut)))]))
(define ground-body
  (render:ty-text
    (nt:type-entry-body (_1 (nt:lookup-type-entry (_0 ground) (_1 ground))))))

;; 4. Live value elaboration: the type of an expression against the
;; compiled subject, as a tool/REPL would ask for it.
(define (type-of txt)
  (render:ty-text
    (tc-ty
      (_1 (elab:elab-value (elab:compiler-for sut)
            (foil-sast:parse-val-sast (rex:ParseRexNorm txt)))))))
(define live
  [["(temp 'kit 21)"   (type-of "(temp 'kit 21)")]
   ["($ok (temp 'kit 21))" (type-of "($ok (temp 'kit 21))")]
   ["(stash/node[nat] 3 .empty)"
    (type-of "(stash/node[nat] 3 .empty)")]
   ["mean_c" (type-of "mean_c")]])

["SIGNATURES" signatures
 "STASH" stash-facts
 "GROUND stash[nat]" ground-body
 "LIVE" live])

;; Prepare the complete source before calling run; imported identities are pinned.
(#export src run)
