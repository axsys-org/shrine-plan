
(#bind std (#module std))
(#import std)


(define (reap str count)
  (If (Eq count 0) ""
      (strWeld (reap str (Dec count)) str)))

(define (snoc x xs) (xs x))

(define (find f xs)
  (foldl (lambda (acc x) (Or acc (Ifz (f x) 0 [x])))
         0
         xs))

(define (call f x) (f x))

(define (snap ax f x)
  (define nex (f (Ix ax x)))
  (Seq nex
  (Up ax nex x)))

(define-syntax (pipe form)
  (foldr (lambda (f x) [f x]) (_1 form) (drop 2 form)))

(define (find-idx-go f xs idx)
  (print ["go" idx xs (f (_0 xs))])
  (If (Eq 0 (Sz xs))
       0
      (If (Eq 0 (f (_0 xs)))
        (find-idx-go f (drop 1 xs) (Inc idx))
        [idx])))

(define (find-idx f xs) (define ret (find-idx-go f xs 0))
  (print ["find-idx" ret]) ret)

(define (cork f g x) (f (g x)))
(define (corl f g x) (g (f x)))

(assert (Eq [[3 4]] (find (cork _0 (Eq 3)) [[1 2] [3 4]])))



