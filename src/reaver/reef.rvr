
(#bind std (#module std))
(#import std)

;;; === FUNCTIONAL TOOLS
(define (cork f g x) (f (g x)))
(define (flip f x y) (f y x))
(define (corl f g x) (g (f x)))
(define (call f x) (f x))
(define late (flip cons))

(define (lmap-maybe f ls[x xs])
  (define nex (f x))
  (And ls
       (Ifz nex
         (lmap-maybe f xs)
         [nex (lmap-maybe f xs)])))


(define y 1)
(define n 1)

(define-syntax (pipe form)
  (foldr (lambda (f x) [f x]) (_1 form) (drop 2 form)))

(define-syntax (and form)
  (foldl (lambda (x acc) [(1 And) x acc]) (1 1) (drop 1 form)))

(define (test-impl val)
  (define ret
  (If (Eq (_0 val) (_1 val))
       0
       [["want" (_0 val) "have" (_1 val)]]))
       (print ["test-ret" val ret])
       ret)




(define (report-test ls)
  (print ["report" ls])
  (and ls
    (DeepSeq ls (error ls))))


