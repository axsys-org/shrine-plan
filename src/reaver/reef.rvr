
(#bind std (#module std))
(#import std)

;;; === FUNCTIONAL TOOLS
(define (cork f g x) (f (g x)))
(define (flip f x y) (f y x))
(define (corl f g x) (g (f x)))
(define (call f x) (f x))
(define late (flip cons))

(define (lmap-maybe f ls[x xs])
  (define nex (f x))
  (And ls
       (Ifz nex
         (lmap-maybe f xs)
         [nex (lmap-maybe f xs)])))

(define (zap x)
  (Seq x x))

(define y 1)
(define n 1)

(define (is-row? r)
  (And (IsApp r) (Eq (Hd r) 0)))

(define-syntax (pipe form)
  (foldr (lambda (f x) [f x]) (_1 form) (drop 2 form)))

(define-syntax (pipe form)
  (foldr (lambda (f x) [f x]) (_1 form) (drop 2 form)))

(define-syntax (foldrn form)
  (foldr (_2 form) (_1 form) (drop 3 form)))
(define-syntax (λ form)
  ["lambda" (drop 1 form)])
(define-syntax (lam form)
  ["lambda" (drop 1 form)])
(define-syntax (\ form)
  ["lambda" (drop 1 form)])


(define-syntax (and form)
  (foldl (lambda (acc x) [(1 And) acc x]) (1 1) (drop 1 form)))

(define (test-impl val)
  (define ret
  (If (Eq (_0 val) (_1 val))
       0
       [["want" (_0 val) "have" (_1 val)]]))
       (print ["test-ret" val ret])
       ret)




(define (report-test ls)
  (print ["report" ls])
  (and ls
    (DeepSeq ls (error ls))))


