; === arithmetic ===


(define (max x y) (If (Ge x y) x y))
(define (min x y) (If (Le x y) x y))

; === list utils ===

(define (snap ax f x)
  (define nex (f (Ix ax x)))
  (Seq nex
  (Up ax nex x)))

(define (lhas e list[x xs])
  (And list
    (Or (Eq e x)
      (lhas e xs))))

(define (countdown n)
  (define m (Dec n))
  (And n (Seq m [m (countdown m)])))

(define lsing (late 0))

(define (lzip xlist[x xs] ylist[y ys])
  (and xlist ylist
      [[x y] (lzip xs ys)]))

(define (lrange x)
  (Seq x
    [x (lrange (Inc x))]))

(define (lrear ls[x xs])
  (and ls
    (Ifz xs x (lrear xs))))

(define (rear r)
  (lrear (stream r)))

(define (lsnip ls[x xs])
  (and ls
    (Ifz xs ~ [x (lsnip xs)])))


(define (snip r)
  (Row (Dec (Sz r)) (stream (lsnip r))))

(define (foreach f ls[x xs])
  (Ifz ls 0
    (Seq (f x) (foreach xs))))

(define (llen list)
  (lfoldl (lambda (acc x) (Inc acc)) 0 list))

(define (zip x y)
  (Row 0 (min (Sz x) (Sz y))
    (lzip (stream x) (stream y))))


(define (lix-error ctx i list[x xs])
  (Ifz list
    (error ["lix-error" ctx])
    (Ifz i x
      (lix-error ctx (Dec i) xs))))


(define (resize n arr) (Row 0 n (stream n arr)))

(define (lgenfrom i n f) (And (Lt i n) [(f i) (lgenfrom (Inc i) n f)]))
(define (lgen n f)       (lgenfrom 0 n f))
(define (gen n f)        (Row 0 n (lgen n f)))


(define (find-idx-go f xs idx)
  (If (Eq 0 (Sz xs))
       0
      (If (Eq 0 (f (_0 xs)))
        (find-idx-go f (drop 1 xs) (Inc idx))
        [idx])))

(define (find-idx f xs) (find-idx-go f xs 0))

(define (snoc x xs) (xs x))

(define (find f xs)
  (foldl (lambda (acc x) (Or acc (Ifz (f x) 0 [x])))
         0
         xs))

; === string utils ===

;; tape -> row of chars
;; cape -> list of chars
(define (ltrip str)
  (Ifz str 0
    [(Trunc8 str) (ltrip (Rsh str 8))]))

(define (lexplode-step str i)
  (Load8 i str))

(define (lexplode str)
  (lgen (Bytes str) (lexplode-step str)))

(define (fall default unit)
  (Ifz unit default (_0 unit)))
(define need _0)

(define (some x) [x])

(define (lzing lls[l ls])
  (Ifz lls 0
    (lweld l (lzing ls))))

(define (zing lls)
  (Row 0 (foldr (lambda (arg acc) (Add acc (Sz arg))) 1 lls)
    (lzing (stream (map stream lls)))))

assert(Eq [1 2 3 4] (zing [[1 2] [3 4]]))




(define (apple xs)
  (Ifz xs [1 0]
    (lfoldl
      (lambda (arg acc) (Trace [acc arg] [arg acc]))
      (_0 xs)
      (stream (drop 1 xs)))))

(define (trip str)
  (Row 0 (Bytes str) (lexplode str)))

(define (reap str count)
  (If (Eq count 0) ""
      (strWeld (reap str (Dec count)) str)))

(define (load-num acc bs[c cs])
  (Seq acc
    (Ifz bs acc
      (load-num (Add (Mul 10 acc) (Sub c 48)) cs))))

(define (parse-nat x)
  (load-num 0 (lexplode x)))

(define (/ x y)
  [x y])

assert(Eq (parse-nat "10") 10)





(define (char-numeric? x) (And (Gt x 47) (Lt x 58)))

(define (str-numeric? str) (lall char-numeric? (ltrip str)))

assert(Eq 0 (str-numeric? "test"))
assert(Eq 1 (str-numeric? "123"))

assert(Eq "foofoo" (reap "foo" 2))


