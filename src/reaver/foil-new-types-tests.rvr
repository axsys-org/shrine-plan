(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind nt (#module foil-new-types))


;;; Namespace declarations and application overlays ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define nat (nt:type-ref ["nat"]))
(define atom-a (nt:type-ref ["a"]))
(define atom-b (nt:type-ref ["b"]))

(define world0 nt:empty-type-world)
(define world1
  (nt:declare-type world0 ["nat"] (nt:mono (nt:tnat 0)) "nat" 0 "builtin"))
(define world2
  (nt:declare-type world1 ["a"]
    (nt:mono (nt:trow "a" [])) "a" 0 "test"))
(define world3
  (nt:declare-type world2 ["b"]
    (nt:mono (nt:trow "b" [])) "b" 0 "test"))

(define box-scheme
  (nt:scheme [(nt:type-param "v")]
    (nt:trow "box" [(nt:trow-item "value" (nt:type-var "v"))])))
(define world4
  (nt:declare-type world3 ["box"] box-scheme "box" 1 "box source"))

;; A recursive generic closes directly through its own materialized path.
(define node-scheme
  (nt:scheme [(nt:type-param "v")]
    (nt:trow "node"
      [(nt:trow-item "head" (nt:type-var "v"))
       (nt:trow-item "tail"
         (nt:type-app ["node"] [(nt:type-arg (nt:type-var "v"))]))])))
(define world5
  (nt:declare-type world4 ["node"] node-scheme "node" 2 "node source"))

(define sized-scheme
  (nt:scheme [(nt:const-param "n" (nt:tnat 0))]
    (nt:trow "sized"
      [(nt:trow-item "size" (nt:const-var "n"))])))
(define world6
  (nt:declare-type world5 ["sized"] sized-scheme "sized" 1 "sized source"))

(define box-nat-result
  (nt:intern-type-application world6 ["box"] [(nt:type-arg nat)]))
(define world7 (_0 box-nat-result))
(define box-nat-path (_1 box-nat-result))
(define expected-box-nat-path
  (ty-ap-encode [["box"] ["nat"]]))

assert(Equal expected-box-nat-path box-nat-path)
assert(Eq 6 (Sz (nt:type-world-entries world7)))

(define box-nat-lookup (nt:lookup-type-entry world7 box-nat-path))
(define box-nat-entry (_1 box-nat-lookup))
assert(Equal ["box"] (nt:type-entry-origin box-nat-entry))
assert(Equal [(nt:type-arg nat)] (nt:type-entry-arguments box-nat-entry))
assert(Eq "box" (nt:type-entry-runtime-brand box-nat-entry))
assert(Equal nat
  (nt:row-item-value (_0 (nt:row-items (nt:type-entry-body box-nat-entry)))))

;; Repeated lookup is stable and does not turn the overlay into a declaration.
(define box-nat-again (nt:lookup-type-entry (_0 box-nat-lookup) box-nat-path))
assert(Equal box-nat-entry (_1 box-nat-again))
assert(Eq 6 (Sz (nt:type-world-entries (_0 box-nat-again))))

(define node-nat-result
  (nt:intern-type-application (_0 box-nat-again) ["node"] [(nt:type-arg nat)]))
(define world8 (_0 node-nat-result))
(define node-nat-path (_1 node-nat-result))
(define node-nat-entry (_1 (nt:lookup-type-entry world8 node-nat-path)))
(define node-items (nt:row-items (nt:type-entry-body node-nat-entry)))
assert(Equal nat (nt:row-item-value (_0 node-items)))
assert(Equal (nt:type-ref node-nat-path) (nt:row-item-value (_1 node-items)))
assert(nt:resolved-type? (nt:type-entry-body node-nat-entry))

;; Const arguments are checked and become exact Const nodes in the body.
(define sized-3-result
  (nt:intern-type-application world8 ["sized"] [(nt:const-arg 3)]))
(define world9 (_0 sized-3-result))
(define sized-3-entry (_1 (nt:lookup-type-entry world9 (_1 sized-3-result))))
assert(Equal (nt:tconst 3)
  (nt:row-item-value (_0 (nt:row-items (nt:type-entry-body sized-3-entry)))))

;; A nat row like [3] is path-shaped and rides as a path part (the
;; ambiguity is inherent to the encoding); a nested row cannot.
(define bad-const
  (Try (lambda (z)
    (nt:intern-type-application world9 ["sized"] [(nt:const-arg [[3]])])) 0))
assert(Eq 1 (Hd bad-const))


;;; Relations and weak joins ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(nt:subtype? world9 (nt:tconst 3) (nt:tnat 0))
assert(Nil (nt:subtype? world9 nt:tany (nt:tnat 0)))
assert(Nil (nt:subtype? world9 (nt:tnat 0) nt:tany))

;; Template applications view symbolically through their base scheme and
;; compare coinductively.
(define node-w (nt:type-app ["node"] [(nt:type-arg (nt:type-var "w"))]))
(define node-w-view (nt:view world9 node-w))
assert(nt:row-type? (_1 node-w-view))
assert(Equal (nt:type-var "w")
  (nt:row-item-value (_0 (nt:row-items (_1 node-w-view)))))
assert(Equal node-w
  (nt:row-item-value (_1 (nt:row-items (_1 node-w-view)))))
assert(nt:subtype? (_0 node-w-view) node-w node-w)
assert(nt:subtype? (_0 node-w-view) (_1 node-w-view) node-w)
assert(Nil (nt:subtype? (_0 node-w-view)
  (nt:type-app ["node"] [(nt:type-arg (nt:type-var "u"))]) node-w))

;; Template matching (inference): first binding wins, constants widen to
;; nat at binding sites, /ty-ap actuals decode, conflicts reject.
assert(Equal [["a" (nt:tnat 0)]]
  (_1 (nt:match-template world9 [] (nt:type-var "a") (nt:tnat 0))))
assert(Equal [["a" (nt:tnat 0)]]
  (_1 (nt:match-template world9 [] (nt:type-var "a") (nt:tconst 5))))
assert(Equal [["a" (nt:type-ref ["nat"])]]
  (_1 (nt:match-template world9 []
        (nt:type-app ["node"] [(nt:type-arg (nt:type-var "a"))])
        (nt:type-ref (ty-ap-encode [["node"] ["nat"]])))))
assert(Nil (nt:match-template world9 []
  (nt:tfun [(nt:type-var "a") (nt:type-var "a")] (nt:type-var "a"))
  (nt:tfun [(nt:tnat 0) (nt:trow "x" [])] (nt:tnat 0))))

;; Consistent subtyping: Any is compatible at any depth; every other rule
;; keeps static strictness.
assert(nt:consistent-subtype? world9 nt:tany (nt:tnat 0))
assert(nt:consistent-subtype? world9 (nt:tnat 0) nt:tany)
assert(nt:consistent-subtype? world9
  (nt:trow "p" [(nt:trow-item 0 nt:tany)])
  (nt:trow "p" [(nt:trow-item 0 (nt:tnat 0))]))
assert(Nil (nt:consistent-subtype? world9 (nt:tnat 0) (nt:tnat "t")))
assert(Nil (nt:consistent-subtype? world9
  (nt:trow "a" []) (nt:trow "b" [])))
assert(nt:consistent-subtype? world9 nt:tany
  (nt:tfun [(nt:tnat 0)] (nt:tnat 0)))
assert(nt:consistent-subtype? world9
  (nt:tfun [nt:tany] (nt:tnat 0))
  (nt:tfun [(nt:tnat 0)] (nt:tnat 0)))

(define distinct-join
  (nt:join world9 (nt:trow "left" []) (nt:trow "right" [])))
assert(Eq nt:tsum-pax (Hd (_1 distinct-join)))

;; Different static applications inherit one runtime brand.  If neither is a
;; subtype of the other, synthesis cannot invent a dispatchable union.
(define box-a (nt:intern-type-application world9 ["box"] [(nt:type-arg atom-a)]))
(define box-b (nt:intern-type-application (_0 box-a) ["box"] [(nt:type-arg atom-b)]))
(define colliding-join
  (Try (lambda (z)
    (nt:join (_0 box-b) (nt:type-ref (_1 box-a)) (nt:type-ref (_1 box-b)))) 0))
assert(Eq 1 (Hd colliding-join))

(define unkeyed-join
  (Try (lambda (z)
    (nt:join world9
      (nt:tfun [(nt:tnat 0)] (nt:tnat 0))
      (nt:tfun [(nt:trow "x" [])] (nt:tnat 0)))) 0))
assert(Eq 1 (Hd unkeyed-join))


;;; Relocation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (into-libx path)
  (If (Eq "boot" (Ix 0 path)) (Weld ["libx"] (drop 1 path)) path))

(define reloc-scheme
  (nt:scheme [(nt:type-param "v")]
    (nt:trow "cell"
      [(nt:trow-item "head" (nt:type-ref ["boot" "elem"]))
       (nt:trow-item "tail"
         (nt:type-app ["boot" "cell"]
           [(nt:type-arg (nt:type-var "v"))]))])))
(define relocated-scheme (nt:relocate-scheme into-libx reloc-scheme))
(define relocated-items (nt:row-items (nt:scheme-body relocated-scheme)))
assert(Equal (nt:type-ref ["libx" "elem"])
  (nt:row-item-value (_0 relocated-items)))
assert(Equal ["libx" "cell"]
  (nt:ty-app-base (nt:row-item-value (_1 relocated-items))))
;; The runtime constructor is identity, not location: never rewritten.
assert(Eq "cell" (nt:row-cstr (nt:scheme-body relocated-scheme)))

;; The rewriter receives full /ty-ap selectors; relocate-path lifts a plain
;; per-declaration rewriter, decomposing part-wise with /ty-val opaque.
(define ap-ref
  (nt:type-ref
    (ty-ap-encode [["boot" "box"] ["boot" "elem"] [ty-val-tag 3]])))
(define relocated-ap
  (nt:relocate-type (nt:relocate-path into-libx) ap-ref))
assert(Equal
  (ty-ap-encode [["libx" "box"] ["libx" "elem"] [ty-val-tag 3]])
  (nt:type-ref-path relocated-ap))

;; Unowned paths pass through untouched.
assert(Equal (nt:type-ref ["nat"])
  (nt:relocate-type into-libx (nt:type-ref ["nat"])))

;;; Aura'd nats: type-level auras over bare nats ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Widening: an aura'd nat is a nat; never the reverse; auras don't
;; cross-flow.
assert(nt:subtype? world9 (nt:tnat "ts") (nt:tnat 0))
assert(Nil (nt:subtype? world9 (nt:tnat 0) (nt:tnat "ts")))
assert(Nil (nt:subtype? world9 (nt:tnat "ts") (nt:tnat "tu")))
assert(nt:subtype? world9 (nt:tnat "ts") (nt:tnat "ts"))
;; Consts flow into plain nat only — an aura is a refinement the const
;; cannot claim.
assert(nt:subtype? world9 (nt:tconst 5) (nt:tnat 0))
assert(Nil (nt:subtype? world9 (nt:tconst "foo") (nt:tnat "ts")))
;; Joins collapse to the shared bare-nat representation.
assert(Equal (nt:tnat 0)
  (nt:join-type world9 (nt:tnat "ts") (nt:tnat "tu")))
assert(Equal (nt:tnat 0)
  (nt:join-type world9 (nt:tconst 5) (nt:tnat "ts")))
assert(Equal (nt:tnat 0)
  (nt:join-type world9 (nt:tnat "ts") (nt:tnat 0)))
;; Meets: refinement wins; disjoint auras are empty.
assert(Equal (nt:tnat "ts")
  (nt:meet-type world9 (nt:tnat "ts") (nt:tnat 0)))
assert(Equal nt:tbot
  (nt:meet-type world9 (nt:tnat "ts") (nt:tnat "tu")))

(print "foil-new-types tests passed")
