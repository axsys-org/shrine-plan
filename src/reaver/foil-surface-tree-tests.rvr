(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; surface_tree.foil: renderer-neutral authoring/compiler structure and laws.

(define sut (foil:compile-mod foil:default-subject "surface_tree"))
(define (sf path) (foil:source-entry-val path sut))

(define scene (sf ["surface_tree" "scene"]))
(define plate (sf ["surface_tree" "plate"]))
(define block (sf ["surface_tree" "block"]))
(define slot-resolved (sf ["surface_tree" "slot_resolved"]))
(define slot-refused (sf ["surface_tree" "slot_refused"]))
(define hole (sf ["surface_tree" "hole"]))
(define slot-fallback (sf ["surface_tree" "slot_fallback"]))
(define text-node (sf ["surface_tree" "text"]))
(define glyph (sf ["surface_tree" "glyph"]))
(define one (sf ["surface_tree" "one"]))
(define put-node (sf ["surface_tree" "put"]))
(define valid (sf ["surface_tree" "valid"]))
(define issues (sf ["surface_tree" "issues"]))
(define kind-of (sf ["surface_tree" "kind_of"]))
(define role-of (sf ["surface_tree" "role_of"]))
(define name-of (sf ["surface_tree" "name_of"]))
(define source-of (sf ["surface_tree" "source_of"]))
(define action-of (sf ["surface_tree" "action_of"]))
(define report-of (sf ["surface_tree" "report_of"]))
(define state-of (sf ["surface_tree" "state_of"]))
(define fallback-of (sf ["surface_tree" "fallback_of"]))
(define text-of (sf ["surface_tree" "text_of"]))
(define with-source (sf ["surface_tree" "with_source"]))
(define with-action (sf ["surface_tree" "with_action"]))
(define with-report (sf ["surface_tree" "with_report"]))
(define renderer-slot (sf ["surface_tree" "renderer_slot"]))

(define myth-new (sf ["myth" "new"]))
(define myth-sing (sf ["myth" "sing"]))
(define myth-add (sf ["myth" "add"]))
(define myth-text (sf ["myth" "txt_at"]))
(define twig-txt (sf ["twig" "txt"]))
(define twig-pat (sf ["twig" "pat"]))
(define twig-iota (sf ["twig" "iota"]))
(define kind-slot (sf ["surface_tree" "kind_slot"]))

(define q-scene ("ts" "scene"))
(define q-plate ("ts" "plate"))
(define q-block ("ts" "block"))
(define q-slot ("ts" "slot"))
(define q-text ("ts" "text"))
(define q-glyph ("ts" "glyph"))
(define q-resolved ("ts" "resolved"))
(define q-pending ("ts" "pending"))
(define q-fallback ("ts" "fallback"))
(define q-refused ("ts" "refused"))

(define chat-role [("ts" "chat") ("ts" "scene")])
(define log-role [("ts" "chat") ("ts" "log")])
(define msg-role [("ts" "chat") ("ts" "message")])
(define avatar-role [("ts" "identity") ("ts" "avatar")])
(define source-path [("ts" "chat") ("ts" "log")])
(define action-path [("ts" "chat") ("ts" "send")])
(define report-path [("ts" "o") ("u" 1) ("ts" "chat")])
(define fallback-path [("ts" "foundry") ("ts" "fallback")])
(define content ("ts" "content"))
(define avatar ("ts" "avatar"))

;;; Canonical constructors and accessors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define s (scene chat-role))
(define p (plate log-role))
(define b (block msg-role))
(define tx (text-node msg-role "hello"))
(define gl (glyph avatar-role))

assert(Equal ("/boot/maybe/some" q-scene) (kind-of s))
assert(Equal ("/boot/maybe/some" q-plate) (kind-of p))
assert(Equal ("/boot/maybe/some" q-block) (kind-of b))
assert(Equal ("/boot/maybe/some" q-text) (kind-of tx))
assert(Equal ("/boot/maybe/some" q-glyph) (kind-of gl))
assert(Equal ("/boot/maybe/some" chat-role) (role-of s))
assert(Equal ("/boot/maybe/some" "hello") (text-of tx))

(define live-block
  (with-report report-path
    (with-action action-path
      (with-source source-path b))))
assert(Equal ("/boot/maybe/some" source-path) (source-of live-block))
assert(Equal ("/boot/maybe/some" action-path) (action-of live-block))
assert(Equal ("/boot/maybe/some" report-path) (report-of live-block))

;;; Named Slot, Hole, fallback, and refusal states ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define resolved (slot-resolved content log-role))
(define pending (hole content log-role report-path))
(define fallen (slot-fallback avatar avatar-role fallback-path))
(define refused (slot-refused content log-role))

assert(Equal ("/boot/maybe/some" q-slot) (kind-of resolved))
assert(Equal ("/boot/maybe/some" content) (name-of resolved))
assert(Equal ("/boot/maybe/some" q-resolved) (state-of resolved))
assert(Equal ("/boot/maybe/some" q-pending) (state-of pending))
assert(Equal ("/boot/maybe/some" report-path) (report-of pending))
assert(Equal ("/boot/maybe/some" q-fallback) (state-of fallen))
assert(Equal ("/boot/maybe/some" fallback-path) (fallback-of fallen))
assert(Equal ("/boot/maybe/some" q-refused) (state-of refused))

(define good-tree
  (put-node [content]
    resolved
    (put-node [content ("ts" "message")]
      live-block
      (one s))))
assert(Eq 1 (valid good-tree))
assert(Eq 0 (Sz (issues good-tree)))

(define hole-tree (put-node [content] pending (one s)))
(define fallback-tree (put-node [avatar] fallen (one s)))
assert(Eq 1 (valid hole-tree))
assert(Eq 1 (valid fallback-tree))

;;; Validation laws ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A Slot's name is its attachment name, not an unrelated label.
(define mismatched-slot-tree
  (put-node [("ts" "sidebar")] resolved (one s)))
assert(Eq 0 (valid mismatched-slot-tree))

;; Glyphs are terminal even when the attempted child is otherwise valid.
(define glyph-with-child
  (put-node [("ts" "caption")] tx (one gl)))
assert(Eq 0 (valid glyph-with-child))

;; Every semantic record carries a role.
(define no-role (myth-add (twig-iota kind-slot q-scene) myth-new))
assert(Eq 0 (valid (one no-role)))

;; Renderer vocabulary is rejected anywhere in a record slot path.
assert(Eq 1 (renderer-slot [("ts" "html")]))
assert(Eq 1 (renderer-slot [("ts" "surface") ("ts" "backend")]))
assert(Eq 0 (renderer-slot [("ts" "surface") ("ts" "role")]))
(define html-record
  (myth-add (twig-txt [("ts" "html")] "<b>no</b>") s))
assert(Eq 0 (valid (one html-record)))

;; Opaque compiled code is a backend handle even under an innocent name.
(define code-record
  ;; Nominal row construction across the RVR boundary is by rep.
  (myth-sing [("ts" "custom") ("ts" "payload")] ("/boot/pails/code" 7)))
(define code-role-record
  (myth-add
    (twig-pat [("ts" "surface") ("ts" "role")] chat-role)
    (myth-add (twig-iota kind-slot q-scene) code-record)))
assert(Eq 0 (valid (one code-role-record)))

;;; Open records: unknown semantic slots survive ordinary decoration ;;;;;;;;;;;;

(define custom-slot [("ts" "custom") ("ts" "note")])
(define extended (myth-add (twig-txt custom-slot "kept") s))
(define extended2 (with-source source-path extended))
assert(Equal "kept" (myth-text custom-slot extended2))
assert(Eq 1 (valid (one extended2)))
