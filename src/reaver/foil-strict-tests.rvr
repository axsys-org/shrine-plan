(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind rex (#module rex))
(#bind subject (#module foil-subject))

(define (check z)
  (define (compile-tree cache name tree)
    (define result (source:compile-rex cache name tree))
    [(_0 result) (foil:perc-subject (_1 result))])
  ;;;; Explicit demand, evaluated through the production Foil compiler.
  (define sut (foil:perc-subject (_1 (source:compile-rex 0 "strict-fixture" (rex:ParseRexNorm "
+  ignore
  \ x=nat
  ^ nat
  0
+  lazy
  \ tick={\ nat}nat
  ^ nat
  = x (tick 1)
  0
+  binder
  \ tick={\ nat}nat
  ^ nat
  = ;x=nat (tick 1)
  0
+  initializer
  \ tick={\ nat}nat
  ^ nat
  = x ;(tick 1)
  (add x x)
+  both
  \ tick={\ nat}nat
  ^ nat
  = ;x=nat ;(tick 1)
  x
+  argument
  \ tick={\ nat}nat
  ^ nat
  (ignore ;(tick 1))
+  body
  \ tick={\ nat}nat
  ^ nat
  ; (tick 1)
  (tick 2)
+  branch
  \ tick={\ nat}nat
  ^ nat
  ? 0
    ;(tick 1)
  7
+  deferred
  \ tick={\ nat}nat
  ^ nat
  = x
      ; (tick 1)
      8
  0
+  callee
  \ ;x=nat y=nat
  ^ nat
  0
+  caller
  \ tick={\ nat}nat
  ^ nat
  (callee (tick 1) ;(tick 2))
+  partial
  \ tick={\ nat}nat
  ^ {\ nat}nat
  (callee (tick 1))
+  explicit_partial
  \ tick={\ nat}nat
  ^ {\ nat}nat
  (callee ;(tick 1))
+  final
  \ tick={\ nat}nat
  ^ nat
  ;(tick 1)
+  captured
  \ tick={\ nat}nat
  ^ {\ nat}nat
  \ ;x=nat
  ^ nat
  (tick x)
+  destructure
  \ tick={\ nat}nat
  ^ nat
  = ;[x y] [(tick 1) (tick 2)]
  0
+  shadows
  \ tick={\ nat}nat
  ^ nat
  = x 9
  ; (tick 1)
  = x ;(tick x)
  x
+  maker
  \ tick={\ nat}nat
  ^ {\ nat}nat
  ; (tick 1)
  ignore
+  boundary
  \ tick={\ nat}nat
  ^ nat
  ((maker tick) ;(tick 2))
+  tall_boundary
  \ tick={\ nat}nat
  ^ nat
  | (maker tick) ;(tick 2)
+  operator
  \ tick={\ nat}nat
  ^ nat
  (;(maker tick) (tick 2))
+  row_mark
  \ tick={\ nat}nat
  ^ [a=nat b=nat]
  [;(tick 1) (tick 2)]
+  branch_yes
  \ tick={\ nat}nat
  ^ nat
  ? 1
    ;(tick 1)
  7
+  parameter_order
  \ ;x=nat ;y=nat
  ^ nat
  (add x y)
+  parameters
  \ tick={\ nat}nat
  ^ nat
  (parameter_order (tick 1) (tick 2))
+  nested
  \ tick={\ nat}nat
  ^ nat
  (ignore ;(ignore ;(tick 1)))
")))))
  (define (entry name) (foil:source-entry-val [name] sut))
  (define (tick n) (Trace (strcat ["STRICT-EVENT-" (showNat n)]) n))
  (define (assert-eq wanted got)
    (If (Equal wanted got) 0 (error ["strict result" wanted got])))
  (define (run name expected)
    (Seq (print (strcat ["STRICT-BEGIN-" name]))
      (Seq (assert-eq expected ((entry name) tick))
        (print (strcat ["STRICT-END-" name])))))
  (run "lazy" 0)
  (run "binder" 0)
  (run "initializer" 2)
  (run "both" 1)
  (run "argument" 0)
  (run "body" 2)
  (run "branch" 7)
  (run "deferred" 0)
  (run "caller" 0)
  (run "final" 1)
  (run "destructure" 0)
  (run "shadows" 9)
   ;;;; Keep returned functions local: REPL printing can force their captures.
  (define (check-returned name call-name argument expected)
    (Seq (print (strcat ["STRICT-BEGIN-" name]))
      (let ((f ((entry name) tick)))
        (Seq f
          (Seq (print (strcat ["STRICT-END-" name]))
            (Seq (print (strcat ["STRICT-BEGIN-" call-name]))
              (Seq (assert-eq expected (f argument))
                (print (strcat ["STRICT-END-" call-name])))))))))
  (check-returned "partial" "partial_call" 8 0)
  (check-returned "explicit_partial" "explicit_partial_call" 8 0)
  (check-returned "captured" "captured_call" 3 3)
  (run "boundary" 0)
  (run "tall_boundary" 0)
  (run "operator" 0)
  (run "branch_yes" 1)
  (run "parameters" 3)
  (run "nested" 0)
  (print "STRICT-BEGIN-row_mark")
  (Seq ((entry "row_mark") tick) (print "STRICT-END-row_mark"))
  (print "STRICT-BEGIN-failure")
  (define (fail-tick n)
    (Trace (strcat ["STRICT-EVENT-" (showNat n)]) (error "strict failure")))
  assert(Eq 1 (Hd (Try (lambda (z) ((entry "body") fail-tick)) 0)))
  (print "STRICT-END-failure")

  ;; A valid cached module is reusable, and returns its original compiled value.
  (define cache-rex (rex:ParseRexNorm "+ x 7"))
  (define cached (compile-tree 0 "strict-cache" cache-rex))
  assert(Eq 7 (foil:source-entry-val ["x"]
    (_1 (compile-tree (_0 cached) "strict-cache" cache-rex))))
  (print "foil strict tests passed")

  1)
assert(Equal 1 (check 0))
