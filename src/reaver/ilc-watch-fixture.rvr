(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind subject (#module foil-subject))
(#bind nt (#module foil-new-types))
(#bind fixture (#module foil-test-lain))

;; Resolve the real published react and its nominal constructors. Compilation
;; is setup work, never part of a benchmark timing window.
(define (create ignored)
  (define perc (_1 (fixture:compiled 0)))
  (define sut (foil:perc-subject perc))
  (define world (foil:perc-world perc))
  (define (app path) (foil:source-entry-val path sut))
  (define (brand path)
    (_0 (_1 (nt:runtime-key world (nt:type-ref (subject:canon-path path sut))))))
  [(app ["react"]) (app ["axal" "tap"]) (app ["axal" "put"])
   (app ["axal" "del"]) ((app ["mk_news"]) []) (app ["fires"])
   (brand ["sign"]) (brand ["dep"])
   [(brand ["care" "x"]) (brand ["care" "y"]) (brand ["care" "z"])]
   (app ["bee" "get"]) (app ["bee" "tap"]) (app ["axal" "kid_put"])])
(define (path n) [("ts" "watched") ("ts" (showNat n))])
(define (subscribers api count seed)
  (gen count (lambda (i)
    ((Ix 7 api) (Ix (Mod (Add seed i) 3) (Ix 8 api))
      [("ts" "subscriber") ("ts" (showNat i))]))))
(define (eyes api paths subscribers-per-path)
  (foldl (lambda (out i)
    ((_2 api) (path i) (subscribers api subscribers-per-path i) out))
    (Ix 4 api) (gen paths (lambda (i) i))))
(define (signs api paths changed seed grade)
  (foldl (lambda (out i)
    ((_2 api) (path (Mod (Add seed i) paths))
      ((Ix 6 api) grade (Mod (Add seed i) 3) (Mod seed 3)) out))
    (Ix 4 api) (gen changed (lambda (i) i))))
(#export create path subscribers eyes signs)
