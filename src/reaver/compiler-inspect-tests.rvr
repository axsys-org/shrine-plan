(#bind brand (#module shrine-brand))
(#bind fixture (#module foil-test-context))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind inspect (#module compiler-inspect))
(#bind build (#module compiler-build))
(#bind source (#module foil-source))
(#bind rex (#module rex))
(#bind render (#module foil-render))
(#bind parse (#module parse))

(#bind nt (#module foil-new-types))
(#bind entry (#module foil-entry))
(#bind subject (#module foil-subject))
(#bind core (#module foil-type-core))
(#bind elab (#module foil-new-elab))

;; Only real type and TC positions produce metadata edges.
(define ghost (nt:type-ref ["ghost"]))
(define spoof (subject:tc-global ghost ["fake-call"]))
(define (refs code) (entry:collect-refs code))
assert(Equal [] (refs (subject:tc-lit nt:tany spoof)))
assert(Equal [] (refs (subject:tc-const nt:tany ghost)))
assert(Equal [] (refs (subject:tc-ffi nt:tany spoof)))
assert(Equal [] (refs (subject:tc-mean spoof)))
assert(Equal [] (refs (subject:tc-lit (nt:tconst ghost) 0)))
(define signature
  (nt:scheme [(nt:type-param "a")
              (nt:const-param "cmp" (nt:type-ref ["comparator"]))]
    (nt:tfun [(nt:tarr (nt:type-ref ["element"]))
              (nt:tpin (nt:type-ref ["pinned"]))]
      (nt:type-app ["box"]
        [(nt:type-arg (nt:type-ref ["element"]))
         (nt:const-arg ghost)]))))
(define signature-refs (refs (subject:tc-typ signature)))
assert(Equal (sort cmp-total
    [["type" ["element"]] ["type" ["pinned"]]
     ["type" ["box"]] ["type" ["comparator"]]])
  (sort cmp-total signature-refs))
(define path-app (subject:ty-ap-encode
  [["box"] ["element"] [subject:ty-val-tag ghost]]))
assert(Equal (sort cmp-total
    [["type" path-app] ["type" ["box"]] ["type" ["element"]]])
  (sort cmp-total (refs (subject:tc-lit (nt:type-ref path-app) 0))))
(define arm (subject:tc-arm nt:tany (nt:type-ref ["pattern"])
  (subject:tc-global (nt:type-ref ["result"]) ["called"]) spoof))
assert(Equal (sort cmp-total
    [["type" ["pattern"]] ["type" ["result"]] ["call" ["called"]]])
  (sort cmp-total (refs arm)))
;; Stale or mixed declarations cannot silently disappear during replay.
(define old-type ("/foil/types/tnat" 0))
(define bad-subject (subject:insert-tc ["bad"] subject:wack-span
  (subject:tc-typ old-type) core:core-subject))
assert(Eq 1 (Hd (Try (lambda (z)
  (DeepSeq (core:world-from-subject bad-subject) 0)) 0)))
assert(Eq 1 (Hd (Try (elab:normalize-tc (elab:compiler-for core:core-subject))
  (subject:tc-lit (nt:tarr old-type) 0))))
assert(Eq 1 (Hd (Try render:ty-text old-type)))

(define mirror-root [("x" 17) ("ts" "mirror")])
(define (boot-ent-node mod name)
  (Weld mirror-root (Weld (map (lambda (s) ("ts" s)) (parse:split-str "/" mod))
    (Weld [("u" (Sz name))] (map (lambda (s) ("ts" s)) name)))))

(define (check z)
  (define policy (_1 (source:compile (fixture:files 0 ["boot_tools"]) 0 "boot_tools")))
  (define (tool path) (driver:get-perc path policy))
  (define (brand key) (build:brand policy (parse:split-str "/" key)))
  (define (describe-cache refs docs cache)
    (inspect:describe-cache mirror-root policy inspect:read-source refs docs 0 cache))
  (define (ref-table cache) (inspect:ref-table mirror-root tool cache))
  (define (ns-groups cache) (inspect:ns-groups mirror-root tool cache))
  (define (doctest-work cache) (inspect:doctest-work mirror-root tool brand cache))
  ;;;; Real boot-tool descriptions from new compiler metadata.

  (define (compile cache name text)
    (driver:compile-rex (fixture:tree cache name (rex:ParseRexNormFile text)) cache name (rex:ParseRexNormFile text)))
  (define dep (compile driver:empty-foil-cache "inspect_dep"
    "+ token
  ' A dependency token.
  : value=nat
+ double
  \ x=nat
  ^ nat
  | mul 2 x
"))
  (define text
    "' Generated inspector fixture.
- inspect_dep [at=lib]
+ token
  ' Local token documentation.
  : field=nat
+ twice
  ' Double via the dependency.
  ' ?= ((twice 3) 6)
  \ x=nat
  ^ nat
  | lib/double x
+ boxed | lib/token 9
+ choice
  & choice/yes choice/no
  + yes
    : value=nat
  + no
    :
+ identity
  \ x=token
  ^ token
  x
+ imported_identity
  \ x=lib/token
  ^ lib/token
  x
")
  (define built (compile (_0 dep) "apps/inspect/main" text))
  (define cache (_0 built))
  (define descriptions (describe-cache 1 1 cache))
  (define (ts x) ("ts" x))
  (define module (need (find (lambda (m)
    (Equal [(ts "apps") (ts "inspect") (ts "main")] (_0 m))) descriptions)))
  (define entries (Ix 3 module))
  (define (ent name) (need (find (lambda (e) (Equal (map ts name) (_0 e))) entries)))
  assert(Ge (Sz descriptions) 2)
  (define inspected-names (map driver:perc-name (driver:cache-results cache)))
  assert(includes (Equal "inspect_dep") inspected-names)
  assert(includes (Equal "apps/inspect/main") inspected-names)
  assert(Equal "function" (_2 (ent ["twice"])))
  assert(Equal "row type" (_2 (ent ["token"])))
  assert(Equal "sum type" (_2 (ent ["choice"])))
  assert(Equal "Local token documentation." (_1 (Ix 5 (ent ["token"]))))
  assert(Gt (Sz (filter (lambda (e)
    (Equal [(ts "token") (ts "field")] (_0 e))) entries)) 0)
  assert(Nil (find (lambda (e) (Equal [(ts "double")] (_0 e))) entries))
  assert(Equal ((brand:encode (Weld (fixture:root "inspect_dep") [["ts" "token"]]) 1) 9) (_1 (ent ["boxed"])))
  assert(includes (Equal [(ts "lib") (ts "token")]) (Ix 4 module))
  assert(includes (Equal [(ts "lib") (ts "double")]) (Ix 4 module))
  assert(Nil (includes (Equal [(ts "double")]) (Ix 4 module)))
  assert(Eq 0 (Ix 5 module))
  assert(render:str-contains? "twice" (Ix 3 (ent ["twice"])))
  assert(render:str-contains? "lib / double" (Ix 3 (ent ["twice"])))
  assert(Nil (render:str-contains? "boxed" (Ix 3 (ent ["twice"]))))
  assert(render:str-contains? "Generated inspector fixture" (_1 module))

  (define from (boot-ent-node "apps/inspect/main" ["twice"]))
  (define target (boot-ent-node "inspect_dep" ["double"]))
  assert(includes (Equal [from target]) (ref-table cache))
  assert(includes (Equal target) (Ix 9 (ent ["twice"])))
  (define local-type (boot-ent-node "apps/inspect/main" ["token"]))
  (define imported-type (boot-ent-node "inspect_dep" ["token"]))
  assert(includes (Equal local-type) (Ix 9 (ent ["identity"])))
  assert(includes (Equal imported-type) (Ix 9 (ent ["imported_identity"])))
  assert(includes (Equal
    [(boot-ent-node "apps/inspect/main" ["identity"]) local-type])
    (ref-table cache))
  assert(Gt (Sz (ns-groups cache)) 0)
  ;; The existing compiled Foil renderer consumes these descriptions.
  assert(Gt (Sz ((tool ["boot_mirror" "pairs"]) mirror-root descriptions)) 0)
  (define work (doctest-work cache))
  (define twice-work (need (find (lambda (w) (Equal from (_0 w))) work)))
  assert(Eq 1 (_1 twice-work))
  assert(Equal [[0 1 0]] ((_2 twice-work) 0))

  ;; Matching disk source gives exact slices. Changed source must never be
  ;; sliced with offsets from a stale compilation, even for generated names.
  (define exact (inspect:source-info (lambda (name) text) (_1 built)))
  assert(Eq 1 (_1 exact))
  (define stale (inspect:source-info (lambda (name) "+ wrong 1") (_1 built)))
  assert(Eq 0 (_1 stale))
  assert(Nil (render:str-contains? "wrong" (_0 stale)))
  (define span (driver:perc-entry-span
    (Weld (driver:perc-root (_1 built)) ["twice"]) (_1 built)))
  assert(render:str-contains? "+ twice"
    (inspect:entry-source exact (_1 built) span))
  assert(Equal (Ix 3 (ent ["twice"]))
    (inspect:entry-source stale (_1 built) span))
  ;; The default source reader also retains exact real-file source.
  (define disk (driver:compile (fixture:files driver:empty-foil-cache ["test_fixtures/env_low"]) driver:empty-foil-cache "test_fixtures/env_low"))
  (define disk-desc (need (find (lambda (m)
    (Equal [(ts "test_fixtures") (ts "env_low")] (_0 m)))
    (describe-cache 0 1 (_0 disk)))))
  assert(Equal (inspect:read-source "test_fixtures/env_low") (_1 disk-desc))
  assert(Equal 11 (_1 (_0 (Ix 3 disk-desc))))
  assert(render:str-contains? "+  equal" (Ix 3 (_0 (Ix 3 disk-desc))))
  (print "Compiler inspection tests passed")

  1)
assert(Equal 1 (check 0))
