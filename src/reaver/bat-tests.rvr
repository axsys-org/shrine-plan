(#bind std (#module std))
(#import std)
(#bind bat (#module bat))
(#import bat)
assert(Eq 0 (bat-size bat-empty))
assert(Eq 4 (bat-size (bat-bytes "ab" 4)))
assert(bat-equal (bat-bytes "ab" 4)
  (bat-cat (bat-text "ab") (bat-repeat 0 2)))
assert(bat-equal (bat-slice (bat-cat (bat-text "abc") (bat-text "def")) 2 3)
  (bat-text "cde"))
assert(bat-equal (bat-slice (bat-text "abc") 99 4) bat-empty)
assert(bat-equal (bat-concat [(bat-text "a") (bat-text "bc") bat-empty])
  (bat-text "abc"))
assert(Equal (bat-hash (bat-concat [(bat-text "a") (bat-text "bc")]))
  (bat-hash (bat-text "abc")))
assert(Eq "abc" (bat-flatten (bat-text "abc")))
assert(bat-equal (bat-repeat 0 9437184)
  (bat-cat (bat-repeat 0 4194304) (bat-repeat 0 5242880)))
assert(Equal (bat-hash (bat-text "abc")) 194079322365208940185635241760835885748561265768579173066089958080994564536506)
assert(Equal (bat-hash (bat-bytes "ab" 4)) 225553460372322504240748334594959186531099686336888399111055261591585058030302)
