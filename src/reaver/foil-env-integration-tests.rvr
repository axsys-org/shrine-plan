(#bind fixture (#module foil-test-context))
;;;; File imports and immutable generated turns under the sole driver.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind driver (#module foil-new-env))
(#bind subject (#module foil-subject))
(#bind elab (#module foil-new-elab))
(#bind sast (#module foil-sast))
(#bind rex (#module rex))
(define (check z)
  (define (file name) (_1 (source:compile (fixture:files 0 [name]) 0 name)))
  (define a (file "test_fixtures/env_union_a"))
  (define b (file "test_fixtures/env_union_b"))
  ;; Source order breaks equal-distance ties; historical order tags are stripped.
  assert(Equal 22 (driver:get-perc ["env_winner"] a))
  assert(Equal 11 (driver:get-perc ["env_winner"] b))
  (define shadow (file "test_fixtures/env_shadow"))
  assert(Equal 99 (driver:get-perc ["equal"] shadow))
  assert(Equal 99 (driver:get-perc ["env_shadow"] shadow))
  assert(Equal 7 (driver:get-perc ["alpha"] (file "test_fixtures/env_defs_a")))
  assert(Equal 7 (driver:get-perc ["alpha"] (file "test_fixtures/env_defs_b")))
  (define prefix (file "test_fixtures/env_prefix"))
  (define sut (driver:perc-subject prefix))
  assert(Equal 7 ((driver:get-perc ["env_prefix"] prefix) 7 9))
  assert(Equal (_0 (subject:definition-key [(Weld (fixture:root "vec") [["ts" "vec"]]) 1] sut)) (subject:canon-path ["deps" "vec"] sut))
  assert(Equal ["/foil-env/unbound"] (subject:canon-path ["vec"] sut))
  (define (live txt) (_1 (elab:elab-value (elab:compiler-for sut)
    (sast:parse-val-sast (rex:ParseRexNorm txt)))))
  assert(Truth (live "deps/vec"))
  assert(Equal 1 (Hd (Try (lambda (z) (force (live "vec"))) 0)))
  assert(Equal 33 (driver:get-perc ["env_two_prefix"] (file "test_fixtures/env_two_prefix")))
  assert(Equal 1 (Hd (Try (lambda (z) (force (file "../foil-bad/env_prefix_leak"))) 0)))
  ;; Completed cache entries are reused without rebuilding or losing metadata.
  (define cold (source:compile (fixture:files 0 ["test_fixtures/env_union_a"]) 0 "test_fixtures/env_union_a"))
  (define hit (source:compile (fixture:cached-context (_0 cold) "test_fixtures/env_union_a") (_0 cold) "test_fixtures/env_union_a"))
  assert(Equal cold hit)
  (define demo (file "demo"))
  assert(includes (Equal (Weld (driver:perc-root demo) ["point" "x"]))
    (driver:perc-own-keys demo))
  ;; Explicit imports replace the old ambient-subject chaining API.
  (define (tree cache name text) (source:compile-rex (fixture:tree cache name (rex:ParseRexNormFile text)) cache name (rex:ParseRexNormFile text)))
  (define t1 (tree 0 "turn_one" "+ foo 1"))
  (define t2 (tree (_0 t1) "turn_two" "- turn_one
+ bar foo"))
  (define t3 (tree (_0 t2) "turn_three" "- turn_two
+ foo 2"))
  assert(Equal 1 (driver:get-perc ["foo"] (_1 t1)))
  assert(Equal 1 (driver:get-perc ["bar"] (_1 t2)))
  assert(Equal 2 (driver:get-perc ["foo"] (_1 t3)))
  assert(Equal 1 (driver:get-perc ["bar"] (_1 t3)))
  assert(Equal 1 (driver:get-perc ["foo"] (_1 t1)))
  ;; Unprefixed transitive methods are visible under the new import rules.
  assert(Equal 2 (driver:get-perc ["env_method_visible"] (file "test_fixtures/env_method_visible")))
  1)
assert(Equal 1 (check 0))
