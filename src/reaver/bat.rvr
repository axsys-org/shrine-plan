;;;; Binary byte trees. Length is semantic; trailing zero bytes survive.
(#bind std (#module std))
(#import std)

(#bind S (#pin 83))
(define (bat-equal a b) (S ("BatEq" a b)))
;; SHA-256 of the bytes, returned as a 32-byte bar. Independent of shape.
(define (bat-hash a) (S ("BatHash" a)))
(define (bat-flatten a) (StrTree a))
(define (bat-size a) (Ix 1 a))
(define bat-empty ["bat" 0 ["text" 0]])
(define (bat-bytes src len) ["bat" len ["slice" (Pin src) 0 len]])
(define (bat-text src) (bat-bytes src (Bytes src)))
(define (bat-bar src) (bat-bytes src (Dec (Bytes src))))
(define (bat-repeat byte count) ["bat" count ["repeat" byte count]])
(define (bat-cat a b)
  (Ifz (bat-size a) b
    (Ifz (bat-size b) a ["bat" (Add (bat-size a) (bat-size b)) ["cat" a b]])))
;; Range views share their backing chunks. Slice arguments are clamped.
(define (bat-slice a off len)
  (define start (If (Le off (bat-size a)) off (bat-size a)))
  (define count (If (Le len (Sub (bat-size a) start)) len (Sub (bat-size a) start)))
  ["bat" count ["range" a start count]])
;; Build a balanced tree from a row of BATs, without copying bytes.
(define (bat-concat-range row off count)
  (Ifz count bat-empty
    (If (Eq count 1) (Ix off row)
      (#let ((half (Div count 2)))
        (bat-cat (bat-concat-range row off half)
                 (bat-concat-range row (Add off half) (Sub count half)))))))
(define (bat-concat row) (bat-concat-range row 0 (Sz row)))
