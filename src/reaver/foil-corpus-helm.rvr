(#bind std (#module std))
(#import std)

(#bind foil (#module foil))
(#bind prev (#module foil-corpus-life))

;;; Corpus tier 6: the helmapp cone (see foil-corpus-sept).

(define result
  (foil:compile-mod-cached prev:cache foil:default-subject "helmapp"))
(define cache (_0 result))
(define helmapp-sut (_1 result))


;; The loader records these stamps into this module's cache entry: the
;; tier re-executes (recompiling only what the warm chain below it
;; does not already carry) when any compiled source changes.
(define module-file-stamps (foil:foil-closure-files ["helmapp"]))

(#export module-file-stamps cache helmapp-sut)
