(#bind std (#module std))
(#import std)
(#bind parse (#module parse))
(#import parse)

(define (strWeld a b)
  (Add (Lsh b (Mul 8 (Bytes a))) a))
(define (strcat xs)
  (foldl strWeld 0 xs))

;; HTTP Parsing

(define ws (pose ace tab))
(define ows (lstar ws))
(define rws (lplus ws))
(define special (mask "/!#$%&'*+.^_`|~"))
(define tchar (pose-two alp special))
(define vchar (shim "!" "~"))
(define token (lbass-str (lplus tchar)))
(define vtoken (lbass-str (lplus vchar)))


(define request-line (ltuple (glue ace) [token token token]))
(request-line (make-cursor "get /images/logo.png http/1.1"))

; ows — *(SP / HTAB)
; rws — 1*(SP / HTAB)
; tchar — the token charset: !#$%&'*+-.^_ ` |~ plus DIGIT and ALPHA
; token — 1*tchar (probably your single most-invoked production)
; vchar / field-vchar for header values

; request      = requestLine *headerField CRLF [body]
; requestLine  = method SP requestTarget SP httpVersion CRLF
; headerField  = fieldName ":" OWS fieldValue OWS CRLF
; method       = token
; fieldName    = token
; httpVersion  = "HTTP/" DIGIT "." DIGIT

;; TODO: MAKE WORK!
(define (milton-escape str)
  str)

(define doq 34)
(define (print-attr-value val) (strcat [doq (milton-escape val) doq]))
(define (print-attr x[key val]) (strcat [key "=" (print-attr-value val)]))
(define (print-attrs x) (map print-attr x))
(define (open-tag name attrs)
  (strcat ["<" name " " (join-str " " (print-attrs attrs)) ">"]))
(define (close-tag name) (strcat ["</" name ">"]))

(define (tag name attrs children)
  [name attrs children])

(define (t name children) (tag name 0 children))

(define (milton-print x[tag attrs children])
  (If (IsNat x) (milton-escape x)
    (strcat
      [(open-tag tag attrs)
       (strcat (map milton-print children))
       (close-tag tag)])))


(define (parse-http-request req)
  (unwrap-res (_0 (request-line (make-cursor req)))))


