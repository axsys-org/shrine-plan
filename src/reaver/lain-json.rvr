;;;; Shared JSON parser compiled by the new driver.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (parser context)
  (driver:get-perc ["parse"] (_1 (source:compile context driver:empty-foil-cache "json"))))
