;;;; Persistent Foil artifact-cache runner.
;;;;
;;;; Cache values are native pinned PLAN data.  The shell launchers bind the
;;;; result to _foil_artifact_cache_v1; Reaver's existing snapshot continuation
;;;; then persists it without a new runtime serializer or load primitive.

(#bind std (#module std))
(#import std)

(#bind foil (#module foil))

(define default-flags 0)

(define (empty-cache z)
  (foil:make-artifact-cache default-flags))

(define (normalize cache)
  (foil:artifact-cache-normalize cache default-flags))

(define (warm cache mods fresh?)
  (define cache1
    (foil:warm-mod-artifacts cache foil:default-subject
      default-flags mods fresh?))
  (DeepSeq cache1 cache1))

(define (compile cache mod)
  (foil:compile-mod-artifact-cached cache foil:default-subject
    default-flags mod))

(define (compile-info cache mod)
  (foil:compile-mod-info-artifact-cached cache foil:default-subject
    default-flags mod))

(define (entry-count cache)
  (Sz (foil:artifact-cache-entries (normalize cache))))
