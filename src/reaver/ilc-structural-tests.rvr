(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))
(#bind structural (#module ilc-structural))

(define (check derive)
  (define rules (structural:rules-with derive))
  (define old [1 [2 3] 4])
  (define dx (structural:at-path [1 0] (ilc:replace-change 8)))
  assert(Equal [1 [8 3] 4] (ilc:apply-change old dx))
  assert(Equal 0 (structural:project old dx 0))
  assert(Equal [8 3] (ilc:apply-change (_1 old) (structural:project old dx 1)))
  (define (keep-first x) (_0 x))
  assert(Equal 0 ((derive rules keep-first) old dx))
  (define (pair x) [(_0 x) (Inc (_1 x))])
  (define p [3 4])
  (define pd (structural:field 1 (ilc:replace-change 7)))
  (define out ((derive rules pair) p pd))
  assert(Equal [3 8] (ilc:apply-change (pair p) out))
  assert(Equal 0 (structural:project (pair p) out 0))
  ;; Fixed-shape row operations and higher-order collection rules, including
  ;; generated mapper derivatives and a fallback for length changes.
  (define transforms
    [(lambda (r) (Up 1 99 r))
     (lambda (r) (Coup "tag" r))
     (lambda (r) (Weld r [9 8]))
     (lambda (r) (Weld [9 8] r))
     (lambda (r) (Slice 1 2 r))
     (lambda (r) (Slice 9 2 r))
     Init Last
     (lambda (r) (Row "tag" (Sz r) (stream r)))
     (lambda (r) (map Inc r))
     (lambda (r) (gen (Sz r) (lambda (i) (Mul (Ix i r) 2))))])
  assert(all (lambda (f)
    (all (lambda (dx)
      (Equal (f (ilc:apply-change [1 2 3] dx))
        (ilc:apply-change (f [1 2 3])
          ((derive rules f) [1 2 3] dx))))
      [(structural:field 1 (ilc:replace-change 7))
       (ilc:replace-change [4 5 6 7])])) transforms)
  (define (overwrite r) (Up 1 99 r))
  assert(Equal [1 99 3]
    (ilc:apply-change (overwrite [1 2 3])
      ((derive rules overwrite) [1 2 3]
        (structural:field 1 (ilc:replace-change (error "overwritten delta demanded"))))))
  ;; A changed function head can saturate a PAP. Product shortcuts must not
  ;; infer an unchanged size/head from an arbitrary APP change.
  (define pap (Add 2))
  (define dp (ilc:app-change (ilc:replace-change Inc) 0))
  assert(Equal (Sz (ilc:apply-change pap dp))
    (ilc:apply-change (Sz pap) ((derive rules Sz) pap dp)))
  ;; Lazy selection does not inspect the unselected delta or old branch.
  (define d-if (derive rules If))
  assert(Equal (ilc:replace-change 7)
    (d-if 1 3 (error "old unselected") 0 (ilc:replace-change 7) (error "delta unselected")))
  assert(Equal 9 (ilc:apply-change 3
    (d-if 1 3 (error "old invalid, new branch repaired")
      (ilc:replace-change 0) 0 (ilc:replace-change 9))))
  ;; Demand operators must still force updated demanded operands.
  (define (demand x) (Seq (If (_0 x) 1 (error "forced changed demand")) (_1 x)))
  (define bad (structural:field 0 (ilc:replace-change 0)))
  assert(Equal 1 (Hd (Try (lambda (z) (DeepSeq
    (ilc:apply-change 7 ((derive rules demand) [1 7] bad)) 0)) 0)))
  ;; Rules for primitives agree with full calls on valid, total edits.
  assert(all (lambda (f)
    (all (lambda (a)
      (define x [a 3])
      (define change (structural:field 0 (ilc:replace-change (Inc a))))
      (define (apply x) (f (_0 x) (_1 x)))
      (Equal (apply (ilc:apply-change x change))
        (ilc:apply-change (apply x) ((derive rules apply) x change)))) [1 2 3]))
    [Eq Equal Cmp Lt Add Sub Mul Div Mod])
  1)
assert(check ilc:derive-with)
assert(check ilc:derive-staged-with)
