;; The type-only half of Foil's builtin substrate.  It is deliberately
;; independent of foil-builtins so Typed Reaver can use nominal expansion and
;; subtyping while foil-builtins is itself being assembled.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))

(define NONE 0)

;; Compiled declarations live under /boot.  Substrate type names stay
;; unrooted so ty-to-path's bare encodings agree with source-written ones.
(define boot-root ["boot"])

(define nat-ty (ty:TNOM ["nat"] 0))
(define uint-ty (ty:TNOM ["uint"] 0))
(define bool-ty (ty:TNOM ["bool"] 0))
(define unit-cstr (print-path ["unit"]))
(define unit-ty (ty:TNOM ["unit"] 0))
(define iota-ty (ty:TNOM ["iota"] 0))

(define (applied-of base items)
  (ty:TNOM (ty-ap-encode (Weld [base] (map ty:ty-to-path items))) 0))

;; Foil's row[A] is a homogeneous runtime row, represented by the compact
;; branded TARR payload.
(define (row-of item) (ty:TARR item))
(define (list-of item) (applied-of ["list"] [item]))
(define (either-of left right) (applied-of ["either"] [left right]))

(define row-typ
  (ty:TQUA "a" (ty:TARR (ty:TVAR "a"))))
(define list-typ
  (ty:TQUA "a"
    (ty:TSUM
      [(ty:TROW "nil" [])
       (ty:TROW "cons" [(ty:TVAR "a") (list-of (ty:TVAR "a"))])])))
(define either-typ
  (ty:TQUA "a"
    (ty:TQUA "b"
      (ty:TSUM
        [(ty:TROW "left" [(ty:TVAR "a")])
         (ty:TROW "right" [(ty:TVAR "b")])]))))

;; The quip aura type (quip.rvr): a '-prefixed literal parses to a tagged
;; value, one option per aura.
(define iota-typ
  (ty:TSUM
    [(ty:TROW "dm" [nat-ty])
     (ty:TROW "dr" [nat-ty])
     (ty:TROW "ds" [nat-ty])
     (ty:TROW "f" [nat-ty])
     (ty:TROW "r" [nat-ty])
     (ty:TROW "rd" [nat-ty])
     (ty:TROW "rs" [nat-ty])
     (ty:TROW "s" [nat-ty])
     (ty:TROW "ta" [nat-ty])
     (ty:TROW "ts" [nat-ty])
     (ty:TROW "tu" [nat-ty])
     (ty:TROW "u" [nat-ty])
     (ty:TROW "w" [nat-ty])
     (ty:TROW "x" [nat-ty])]))

;; The reflection descriptor sum: (^ expr) values.  This legacy mirror
;; exists so the name `type` resolves from source (the stage-1 world
;; replay keeps its own declaration in foil-new-elab's core world; the
;; pail entry is the precedent).  Member shapes must stay in sync with
;; install-core-world's stage-1 declaration.
(define type-ty (ty:TNOM ["type"] 0))
(define type-typ
  (ty:TSUM
    [(ty:TROW "any" [])
     (ty:TROW "pail" [])
     (ty:TROW "bot" [])
     (ty:TROW "opq" [])
     (ty:TROW "nat" [nat-ty])
     (ty:TROW "cst" [nat-ty])
     (ty:TROW "var" [nat-ty])
     (ty:TROW "arr" [type-ty])
     (ty:TROW "pin" [type-ty])
     (ty:TROW "fun" [(row-of type-ty) type-ty])
     (ty:TROW "sum" [(row-of type-ty)])
     (ty:TROW "rec" [nat-ty (row-of (ty:TROW 0 [nat-ty type-ty]))])
     (ty:TROW "nom" [(row-of nat-ty) (row-of type-ty)])
     (ty:TROW "gen"
       [(row-of (ty:TROW 0 [nat-ty nat-ty type-ty])) type-ty])]))

;; Keep this as a subject transformer so foil-builtins can preserve its
;; historical insertion order: in a pipe, this stage is listed first and
;; therefore runs after the runtime FFI stages.
(define (install-core-types sut)
  (pipe sut
    (ty:insert-typ-ffi ["nat"] (ty:TNAT 0))
    (ty:insert-typ-ffi ["uint"] (ty:TNAT 0))
    (ty:insert-typ-ffi ["bool"] (ty:TNAT 0))
    (ty:insert-typ-ffi ["unit"] (ty:TROW unit-cstr []))
    (ty:insert-typ-ffi ["iota"] iota-typ)
    ;; Aura'd nat aliases (sym = nat/ts, str = nat/tu).  Legacy types
    ;; cannot express auras (TNAT's field is a singleton cube, not an
    ;; aura), so they degrade to plain nat here.
    (ty:insert-typ-ffi ["sym"] (ty:TNAT 0))
    (ty:insert-typ-ffi ["str"] (ty:TNAT 0))
    (ty:insert-typ-ffi ["pail"] ty:TPAIL)
    (ty:insert-typ-ffi ["any"] ty:TANY)
    (ty:insert-typ-ffi ["row"] row-typ)
    (ty:insert-typ-ffi ["list"] list-typ)
    (ty:insert-typ-ffi ["either"] either-typ)
    (ty:insert-typ-ffi ["type"] type-typ)))

(define core-subject
  (install-core-types (set-sut-root boot-root empty-subject)))

(#export
 NONE
 boot-root
 nat-ty uint-ty bool-ty unit-cstr unit-ty iota-ty
 applied-of row-of list-of either-of
 row-typ list-typ either-typ iota-typ type-ty type-typ
 install-core-types core-subject)
