;;;; biparser-test: comprehensive tests of every primitive built so far.
;;;;
;;;; Run with:  :*biparser-test
;;;; Each `assert(...)` should evaluate to 1. If any fails, std's assert
;;;; macro prints an error to the REPL.

(#bind std (#module std))
(#import std)
(#bind biparser-prim (#module biparser-prim))
(#import biparser-prim)


;;; ---------- Helper predicates ----------

(define (is-y? b) (Eq b "y"))
(define (is-n? b) (Eq b "n"))


;;; ---------- Test cassettes ----------

(#bind y-or-n   (k7-alt (satisfy is-y?) (satisfy is-n?)))
(#bind yes-tag  (set 1 (string-pp "yes")))
(#bind no-tag   (set 2 (string-pp "no")))
(#bind yn-strs  (k7-alt yes-tag no-tag))


;;; ============================================================
;;; TEST 1: satisfy with single-byte predicate
;;; ============================================================

;; "5" is the nat 53
assert(Eq 53 (pretty digit-k7 "5"))
assert(Eq 53 (parse  digit-k7 "5"))

;; "0" is the nat 48 (digit predicate accepts it)
assert(Eq 48 (parse  digit-k7 "0"))

;; "x" fails the predicate -> 0 sentinel
assert(Eq 0  (parse  digit-k7 "x"))


;;; ============================================================
;;; TEST 2: eof
;;; ============================================================

;; eof on non-empty input -> fail
assert(Eq 0 (parse eof "x"))


;;; ============================================================
;;; TEST 3: string-pp (multi-byte literal, printer side)
;;; ============================================================

;; "hi" as nat is 'h' + 'i'*256 = 104 + 105*256 = 26984
assert(Eq 26984 (pretty (string-pp "hi") 0))


;;; ============================================================
;;; TEST 4: k7-alt with satisfy (binary parser)
;;; ============================================================

;; "y" = 121, "n" = 110
assert(Eq 121 (parse y-or-n "y"))
assert(Eq 110 (parse y-or-n "n"))
assert(Eq   0 (parse y-or-n "x"))      ; both branches fail

;; pretty side: first matching branch wins
assert(Eq 121 (pretty y-or-n "y"))     ; first branch matches
assert(Eq 110 (pretty y-or-n "n"))     ; first fails, second matches


;;; ============================================================
;;; TEST 5: set (constant value injection)
;;; ============================================================

;; parse: produces the constant 1 / 2 on match
assert(Eq 1 (parse yes-tag "yes"))
assert(Eq 2 (parse no-tag  "no"))
assert(Eq 0 (parse yes-tag "no"))      ; pattern mismatch -> fail

;; pretty: ignores input value, emits the literal
;; "yes" as nat = 'y'+'e'*256+'s'*65536 = 121 + 101*256 + 115*65536 = 7562617
assert(Eq 7562617 (pretty yes-tag 999))


;;; ============================================================
;;; TEST 6: alt + set + string-pp (full integration)
;;; ============================================================

assert(Eq 1 (parse yn-strs "yes"))
assert(Eq 2 (parse yn-strs "no"))
assert(Eq 0 (parse yn-strs "maybe"))


;;; ============================================================
;;; TEST 7: k7-compose — PP0 + PPa (sequencing)
;;; ============================================================

(#bind tagged-digit (k7-compose (string-pp "tag:") digit-k7))

;; parse: "tag:5" -> 53 (the digit), "tag:x" or wrong prefix -> 0
assert(Eq 53 (parse tagged-digit "tag:5"))
assert(Eq  0 (parse tagged-digit "tag:x"))
assert(Eq  0 (parse tagged-digit "no:5"))

;; pretty: print value -> "tag:" + that byte
assert(Eq "tag:5" (pretty tagged-digit "5"))
assert(Eq       0 (pretty tagged-digit "x"))


;;; ============================================================
;;; TEST 8: k7-compose with PP0 + PP0, wrapped in set
;;; ============================================================

(#bind paren-pair (k7-compose (string-pp "(") (string-pp ")")))
(#bind paren-tag  (set 99 paren-pair))

assert(Eq 99 (parse paren-tag "()"))
assert(Eq  0 (parse paren-tag "(x"))
assert(Eq  0 (parse paren-tag "x)"))
assert(Eq "()" (pretty paren-tag 1234))


;;; ============================================================
;;; TEST 9: nested k7-alt (3-way alternative)
;;; ============================================================

(#bind three-way
  (k7-alt digit-k7
          (k7-alt (satisfy is-y?) (satisfy is-n?))))

assert(Eq 53  (parse three-way "5"))   ; digit branch
assert(Eq 121 (parse three-way "y"))   ; y branch
assert(Eq 110 (parse three-way "n"))   ; n branch
assert(Eq   0 (parse three-way "z"))   ; all fail


;;; ============================================================
;;; TEST 10: compose with eof (exact-match grammar)
;;; ============================================================

(#bind exact-yes (set 1 (k7-compose (string-pp "yes") eof)))

assert(Eq 1 (parse exact-yes "yes"))
assert(Eq 0 (parse exact-yes "yes "))   ; trailing junk
assert(Eq 0 (parse exact-yes "yep"))    ; wrong literal


"all-tests-passed"
