(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; tmpl.foil: semidoc documents as namespace templates, exercised
;;; through the tmplapp fixture subject.  Anonymous seed rows project
;;; (0 path myth); maybe reps ("/boot/maybe/some" v) / "/boot/maybe/none";
;;; the kook pail brands "/boot/kook"; myth/pail_at yields a zero
;;; pails/n for an absent slot.

(define app-sut (stage:sut-of "tmplapp"))
(define (app path) (foil:source-entry-val path app-sut))

(define run-event (app ["run_event"]))
(define sov0 (app ["seeded"]))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define t00 (app ["myth" "new"]))
(define txt-at (app ["myth" "txt_at"]))
(define pail-at (app ["myth" "pail_at"]))
(define pact-card (app ["pact" "card"]))
(define rebase-rec (app ["pact" "rebase_rec"]))
(define slot-nat (app ["slot_nat"]))
(define slot-pail (app ["slot_pail"]))
(define slot-txt (app ["slot_txt"]))
(define wiki-parts (app ["wiki_parts"]))
(define wiki-mani (app ["wiki_mani"]))
(define wiki-vine (app ["wiki_vine"]))
(define empty-vine (app ["empty_vine"]))
(define collide-vine (app ["collide_vine"]))
(define rel-rec (app ["rel_ref_rec"]))

(define tw ("ts" "w"))
(define thome ("ts" "home"))
(define tideas ("ts" "ideas"))
(define tapp ("ts" "app"))
(define limb-path [("ts" "sys") ("ts" "limb")])
(define kind-slot [("ts" "kind")])

;;; 1. the pure walk ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define wroot (Ix 0 wiki-parts))
(define wseeds (Ix 1 wiki-parts))
assert(Eq 9 (DeepSeq wiki-parts (Sz wseeds)))
assert(Equal "doc" (txt-at kind-slot wroot))
;; the root record carries no limb: the root's behavior belongs to
;; the mounter's pact card
assert(Eq "/boot/pails/n" (Hd (pail-at limb-path wroot)))

;; 1-based index of a seed path, 0 = missing — order matters below
(define (seed-idx p)
  (define (go i)
    (cond ((Ge i (Sz wseeds)) 0)
          ((Equal p (Ix 0 (Ix i wseeds))) (Inc i))
          (else (go (Inc i)))))
  (go 0))
(define (seed-at p) (Ix 1 (Ix (Dec (seed-idx p)) wseeds)))

;; named mounts at their root-relative ids; un-named content numbered
(define home-rec (seed-at [tw thome]))
assert(Equal "doc" (txt-at kind-slot home-rec))
assert(Equal "The wiki template" (txt-at [("ts" "title")] (seed-at [("u" 0)])))
assert(Equal "Home" (txt-at [("ts" "title")] (seed-at [tw thome ("u" 0)])))
assert(Equal "Welcome." (txt-at [("ts" "text")] (seed-at [tw thome ("u" 0) ("u" 0)])))
assert(Equal "two" (txt-at [("ts" "lead")] (seed-at [tw tideas ("u" 0) ("u" 1)])))
;; parents precede kids
assert(Eq 1 (Lt (seed-idx [tw thome]) (seed-idx [tw thome ("u" 0)])))
assert(Eq 1 (Lt (seed-idx [tw tideas]) (seed-idx [tw tideas ("u" 0) ("u" 0)])))

;;; 2. the /doc/kook lift ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define home-limb (pail-at limb-path home-rec))
assert(Eq "/boot/kook" (Hd home-limb))
assert(Equal [[("ts" "kook") ("ts" "ma")]] (Ix 0 home-limb))
;; the predicate itself never lands as a slot
assert(Eq "/boot/pails/n" (Hd (pail-at [("ts" "doc") ("ts" "kook")] home-rec)))
;; the "."-relative link rides as data, marker intact until mount
(define link0 (pail-at [("ts" "doc") ("ts" "link")] home-rec))
assert(Eq "/boot/pails/p" (Hd link0))
assert(Equal [("ts" ".") tw tideas] (_0 link0))

;;; 3. rebase_rec units ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define rr (rebase-rec [tapp ("ts" "t")] rel-rec))
assert(Equal [tapp ("ts" "t") tw tideas] (_0 (pail-at [("ts" "rp")] rr)))
;; absolute path values stay put — the rule that keeps kernel refs
;; expressible from templates
assert(Equal [("ts" "boot") ("ts" "x")] (_0 (pail-at [("ts" "ap")] rr)))
assert(Equal [[tapp ("ts" "t") ("ts" "a")] [("ts" "b")]] (_0 (pail-at [("ts" "rows")] rr)))
(define rr-limb (pail-at limb-path rr))
assert(Equal [[tapp ("ts" "t") ("ts" "kook") ("ts" "doc")] [("ts" "kook") ("ts" "ma")]]
  (Ix 0 rr-limb))

;;; 4. host-side mount ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tt1 ("ts" "t1"))
(define r1 (run-event (vine-make [tapp tt1] (pact-card wiki-mani "tmpl/wiki" 0 0)) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r1))
(define s1 (_0 r1))
assert(Equal "doc" (slot-txt [tapp tt1 tw thome] kind-slot s1))
;; absolute kook ref untouched through the real pipeline
(define hl (slot-pail [tapp tt1 tw thome] limb-path s1))
assert(Eq "/boot/maybe/some" (Hd hl))
assert(Equal [[("ts" "kook") ("ts" "ma")]] (Ix 0 (_0 hl)))
;; the "."-relative link rebased under the mount root
(define lk (slot-pail [tapp tt1 tw thome] [("ts" "doc") ("ts" "link")] s1))
assert(Equal [tapp tt1 tw tideas] (_0 (_0 lk)))
;; the [] seed melded onto the mount card: template kind AND card status
assert(Equal "doc" (slot-txt [tapp tt1] kind-slot s1))
assert(Equal "live" (slot-txt [tapp tt1] [("ts" "status")] s1))
assert(Equal "The wiki template" (slot-txt [tapp tt1 ("u" 0)] [("ts" "title")] s1))

;;; 5. dispatch: the referenced behavior runs ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r5a (run-event (vine-poke [tapp tt1 tw thome] t00) 7 s1))
assert(Eq "/boot/ovum/ripe" (Hd r5a))
(define r5b (run-event (vine-poke [tapp tt1 tw thome] t00) 7 (_0 r5a)))
assert(Eq "/boot/ovum/ripe" (Hd r5b))
(define s5 (_0 r5b))
;; ma_talk appends digit 1 per poke
assert(Eq 11 (slot-nat [tapp tt1 tw thome] [("ts" "ord")] 0 s5))

;;; 6. two roots, structural isolation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tt2 ("ts" "t2"))
(define r6 (run-event (vine-make [tapp tt2] (pact-card wiki-mani "tmpl/wiki" 0 0)) 7 s5))
assert(Eq "/boot/ovum/ripe" (Hd r6))
(define s6 (_0 r6))
(define lk2 (slot-pail [tapp tt2 tw thome] [("ts" "doc") ("ts" "link")] s6))
assert(Equal [tapp tt2 tw tideas] (_0 (_0 lk2)))
;; t1's pokes never moved t2
assert(Eq 0 (slot-nat [tapp tt2 tw thome] [("ts" "ord")] 0 s6))
assert(Eq 11 (slot-nat [tapp tt1 tw thome] [("ts" "ord")] 0 s6))

;;; 7. the in-kernel path ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tt3 ("ts" "t3"))
(define r7 (run-event (wiki-vine [tapp tt3]) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r7))
(define s7 (_0 r7))
assert(Equal "doc" (slot-txt [tapp tt3 tw thome] kind-slot s7))
(define lk3 (slot-pail [tapp tt3 tw thome] [("ts" "doc") ("ts" "link")] s7))
assert(Equal [tapp tt3 tw tideas] (_0 (_0 lk3)))
;; a vine card is not an app card: no ['status]
assert(Eq 0 (slot-txt [tapp tt3] [("ts" "status")] s7))

;;; 8. the empty template ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tt4 ("ts" "t4"))
(define r8 (run-event (empty-vine [tapp tt4]) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r8))
assert(Equal "doc" (slot-txt [tapp tt4] kind-slot (_0 r8)))

;;; 9. id collisions: last in document order wins ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tt5 ("ts" "t5"))
(define r9 (run-event (collide-vine [tapp tt5]) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r9))
assert(Equal "two"
  (slot-txt [tapp tt5 tw ("ts" "dup")] [("ts" "doc") ("ts" "mark")] (_0 r9)))

;;; 10. the rendered scaffold: yoke -> template source ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define spec-parts (app ["spec_parts"]))
(define spec-refs (app ["spec_refs"]))
(define spec-vine (app ["spec_vine"]))

(define sroot (Ix 0 spec-parts))
(define sseeds (Ix 1 spec-parts))
(define (sseed-idx p)
  (define (go i)
    (cond ((Ge i (Sz sseeds)) 0)
          ((Equal p (Ix 0 (Ix i sseeds))) (Inc i))
          (else (go (Inc i)))))
  (go 0))
(define (sseed-at p) (Ix 1 (Ix (Dec (sseed-idx p)) sseeds)))

;; the scaffold is a valid template: root doc, lede prose at u0, help
;; quote at u1, the named page (skipped by numbering), exemplar at u2
assert(Eq 5 (DeepSeq spec-parts (Sz sseeds)))
assert(Equal "doc" (txt-at kind-slot sroot))
assert(Equal "A wiki spec." (txt-at [("ts" "text")] (sseed-at [("u" 0)])))
assert(Equal "Named pages plus numbered prose." (txt-at [("ts" "lead")] (sseed-at [("u" 1)])))
assert(Equal "doc" (txt-at kind-slot (sseed-at [thome])))
assert(Equal "The home page." (txt-at [("ts" "text")] (sseed-at [thome ("u" 0)])))
assert(Equal "doc" (txt-at kind-slot (sseed-at [("u" 2)])))
;; deps ride the root node's kook attr in source (parts drops root
;; refs at instantiation — the mounter owns root behavior); axal tap
;; order: "." sorts before "kook"
assert(Equal [[("ts" ".") ("ts" "w") ("ts" "form")] [("ts" "kook") ("ts" "ma")]] spec-refs)
assert(Eq "/boot/pails/n" (Hd (pail-at limb-path sroot)))

;; and it mounts through the real pipeline
(define tt6 ("ts" "t6"))
(define r10 (run-event (spec-vine [tapp tt6]) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r10))
(define s10 (_0 r10))
assert(Equal "doc" (slot-txt [tapp tt6 thome] kind-slot s10))
assert(Equal "A wiki spec." (slot-txt [tapp tt6 ("u" 0)] [("ts" "text")] s10))

(print "tmpl tests passed")
