;;;; Extend the shared shrine fixture with the lain application fixture.
(#bind std (#module std))
(#import std)
(#bind foil (#module foil))
(#bind shrine (#module foil-test-shrine))
(Seq (define compiled
       (foil:compile-mod-cached (_0 shrine:compiled)
         foil:default-subject "lainapp"))
  (DeepSeq compiled 0))
(define module-file-stamps (foil:foil-closure-files ["lainapp"]))
(#export compiled module-file-stamps)
