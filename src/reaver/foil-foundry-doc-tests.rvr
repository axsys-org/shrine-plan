(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; Pure Semidoc authoring of Foundry layers, recipes, catalogs, and DAGs.

(define sut (stage:sut-of "foundry_doc"))
(define (app path) (foil:source-entry-val path sut))
(define compile-doc (app ["foundry_doc" "compile"]))
(define compile-layer (app ["foundry_doc" "compile_layer"]))
(define compile-records (app ["foundry_doc" "compile_records"]))
(define compilation-value (app ["foundry_doc" "compilation_value"]))
(define compilation-diagnostics (app ["foundry_doc" "compilation_diagnostics"]))
(define compilation-kind (app ["foundry_doc" "compilation_kind"]))
(define compilation-name (app ["foundry_doc" "compilation_name"]))
(define document-recipe (app ["foundry_doc" "document_recipe"]))
(define document-catalog (app ["foundry_doc" "document_catalog"]))
(define document-layer (app ["foundry_doc" "document_layer"]))
(define document-surface (app ["foundry_doc" "document_surface"]))
(define recipe-role (app ["foundry_doc" "recipe_role"]))
(define recipe-output-kind (app ["foundry_doc" "recipe_output_kind"]))
(define recipe-primitive (app ["foundry_doc" "recipe_primitive"]))
(define recipe-fallbacks (app ["foundry_doc" "recipe_fallbacks"]))
(define recipe-fallback-class
  (app ["foundry_doc" "recipe_fallback_class"]))
(define recipe-features (app ["foundry_doc" "recipe_features"]))
(define recipe-native (app ["foundry_doc" "recipe_native"]))
(define recipe-subject (app ["foundry_doc" "recipe_subject"]))
(define recipe-complement (app ["foundry_doc" "recipe_complement"]))
(define recipe-amends (app ["foundry_doc" "recipe_amends"]))
(define recipe-capabilities (app ["foundry_doc" "recipe_capabilities"]))
(define recipe-inline (app ["foundry_doc" "recipe_inline"]))
(define catalog-source (app ["foundry_doc" "catalog_source"]))
(define catalog-source-role (app ["foundry_doc" "catalog_source_role"]))
(define catalog-target-role (app ["foundry_doc" "catalog_target_role"]))
(define catalog-recipes (app ["foundry_doc" "catalog_recipes"]))
(define catalog-layers (app ["foundry_doc" "catalog_layers"]))
(define catalog-terminal-role (app ["foundry_doc" "catalog_terminal_role"]))
(define surface-root (app ["foundry_doc" "surface_root"]))
(define surface-nodes (app ["foundry_doc" "surface_nodes"]))
(define surface-edges (app ["foundry_doc" "surface_edges"]))
(define node-address (app ["foundry_doc" "node_address"]))
(define node-kind (app ["foundry_doc" "node_kind"]))
(define node-role (app ["foundry_doc" "node_role"]))
(define node-hole (app ["foundry_doc" "node_hole"]))
(define node-fallback (app ["foundry_doc" "node_fallback"]))
(define node-action (app ["foundry_doc" "node_action"]))
(define node-destination (app ["foundry_doc" "node_destination"]))
(define node-contract (app ["foundry_doc" "node_contract"]))
(define slot-accepts-of (app ["foundry_doc" "slot_accepts_of"]))
(define slot-cardinality (app ["foundry_doc" "slot_cardinality"]))
(define slot-required (app ["foundry_doc" "slot_required"]))
(define slot-fallback (app ["foundry_doc" "slot_fallback"]))
(define slot-participation (app ["foundry_doc" "slot_participation"]))
(define edge-parent (app ["foundry_doc" "edge_parent"]))
(define edge-placement (app ["foundry_doc" "edge_placement"]))
(define edge-child (app ["foundry_doc" "edge_child"]))
(define diagnostic-field (app ["foundry_doc" "diagnostic_field"]))
(define diagnostic-code (app ["foundry_doc" "diagnostic_code"]))
(define layer-name (app ["foundry" "layer_name"]))
(define txt-at (app ["myth" "txt_at"]))
(define pail-at (app ["myth" "pail_at"]))

(define nl 10)
(define (unlines xs)
  (foldl (lambda (a x) (strcat [a x nl])) "" xs))

(define (value-of compilation)
  (define mv (compilation-value compilation))
  assert(Equal "/boot/maybe/some" (Hd mv))
  assert(Eq 0 (Sz (compilation-diagnostics compilation)))
  (_0 mv))

(define (some-value m)
  assert(Equal "/boot/maybe/some" (Hd m))
  (_0 m))


;;; Layer compatibility remains typed and pure.

(define dark-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name ;/pronunciation/dark"
     ";@ /foundry/guarded false"
     ";@ /token/color/accent amber"
     ";@ /token/font/body ;/fonts/inter"
     ";. /foundry/layers/dark"]))

(define dark-compilation (compile-doc dark-src))
(define dark-document (value-of dark-compilation))
(define dark (some-value (document-layer dark-document)))
assert(Equal ("ts" "layer") (_0 (compilation-kind dark-compilation)))
assert(Equal [("ts" "pronunciation") ("ts" "dark")]
  (_0 (compilation-name dark-compilation)))
assert(Equal "amber"
  (txt-at [("ts" "token") ("ts" "color") ("ts" "accent")] (_1 dark)))
(define dark-font
  (pail-at [("ts" "token") ("ts" "font") ("ts" "body")] (_1 dark)))
assert(Equal "/boot/pails/p" (Hd dark-font))
assert(Equal [("ts" "fonts") ("ts" "inter")] (_0 dark-font))
(define foundry-layer (compile-layer dark-src))
assert(Equal "/boot/maybe/some" (Hd foundry-layer))
assert(Equal [("ts" "pronunciation") ("ts" "dark")]
  (layer-name (_0 foundry-layer)))


;;; A Chat Scene recipe contains an inline addressed DAG.

(define chat-recipe-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/foundry/chat/scene"
     ";@ /recipe/role ;/projection/chat/scene"
     ";@ /recipe/input surface_tree"
     ";@ /recipe/output_role ;/projection/shrine/scene"
     ";@ /recipe/output_kind scene"
     ";@ /recipe/primitive sewn"
     ";@ /recipe/ceiling scene"
     ";@ /recipe/fallbacks ;/foundry/chat/plate ;/foundry/chat/block"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/shrine"
     ";@ /recipe/features ;/feature/sidebar ;/feature/live_log"
     ";@ /recipe/native ;/./ops/chat/messages"
     ";@ /lens/subject ;/chat/layout"
     ";@ /lens/complement ;/boot/overlay_complement"
     ";@ /lens/amends ;/desktop/window/geometry"
     ";@ /lens/capabilities ;/capability/desktop/layout/amend"
     ";. /foundry/chat/scene"
     "  ;@ /surface/kind scene"
     "  ;@ /surface/role ;/projection/chat/scene"
     "  ;. root"
     "    ;@ /surface/kind plate"
     "    ;@ /surface/role ;/projection/chat/plate"
     "    ;. plate"
     "      ;@ /surface/place ;/slot/messages"
     "      ;/message_thread"
     "    ;@ /surface/place ;/slot/preview"
     "    ;/message_thread"
     "  ;@ /surface/kind slot"
     "  ;@ /surface/role ;/projection/chat/messages"
     "  ;@ /surface/hole ;/chat/messages"
     "  ;@ /surface/fallback ;/foundry/chat/messages/text"
     "  ;@ /slot/accepts ;/surface/text ;/surface/block"
     "  ;@ /slot/cardinality many"
     "  ;@ /slot/required true"
     "  ;@ /slot/participation ;/participation/content"
     "  ;. message_thread"]))

(define chat-compilation (compile-doc chat-recipe-src))
(define chat-document (value-of chat-compilation))
(define chat-recipe (some-value (document-recipe chat-document)))
assert(Equal ("ts" "recipe") (_0 (compilation-kind chat-compilation)))
assert(Equal [("ts" "projection") ("ts" "chat") ("ts" "scene")]
  (recipe-role chat-recipe))
assert(Equal ("ts" "scene") (recipe-output-kind chat-recipe))
assert(Equal ("ts" "sewn") (recipe-primitive chat-recipe))
assert(Equal
  [[("ts" "foundry") ("ts" "chat") ("ts" "plate")]
   [("ts" "foundry") ("ts" "chat") ("ts" "block")]]
  (recipe-fallbacks chat-recipe))
assert(Equal "/boot/maybe/none" (Hd (recipe-fallback-class chat-recipe)))
assert(Equal
  [[("ts" "feature") ("ts" "sidebar")]
   [("ts" "feature") ("ts" "live_log")]]
  (recipe-features chat-recipe))
;; Relative native refs remain inert canonical paths; nothing executes them.
assert(Equal
  [("ts" ".") ("ts" "ops") ("ts" "chat") ("ts" "messages")]
  (_0 (recipe-native chat-recipe)))
assert(Equal [("ts" "chat") ("ts" "layout")]
  (_0 (recipe-subject chat-recipe)))
assert(Equal [("ts" "boot") ("ts" "overlay_complement")]
  (_0 (recipe-complement chat-recipe)))
assert(Equal [[("ts" "desktop") ("ts" "window") ("ts" "geometry")]]
  (recipe-amends chat-recipe))
assert(Equal
  [[("ts" "capability") ("ts" "desktop") ("ts" "layout") ("ts" "amend")]]
  (recipe-capabilities chat-recipe))

(define chat-surface (some-value (recipe-inline chat-recipe)))
assert(Equal [("ts" "root")] (surface-root chat-surface))
(define chat-nodes (surface-nodes chat-surface))
(define chat-edges (surface-edges chat-surface))
assert(Eq 3 (Sz chat-nodes))
assert(Eq 3 (Sz chat-edges))
assert(Equal [("ts" "root")] (node-address (Ix 0 chat-nodes)))
assert(Equal ("ts" "scene") (node-kind (Ix 0 chat-nodes)))
assert(Equal [("ts" "projection") ("ts" "chat") ("ts" "scene")]
  (node-role (Ix 0 chat-nodes)))
assert(Equal [("ts" "chat") ("ts" "messages")]
  (_0 (node-hole (Ix 2 chat-nodes))))
assert(Equal
  [("ts" "foundry") ("ts" "chat") ("ts" "messages") ("ts" "text")]
  (_0 (node-fallback (Ix 2 chat-nodes))))
(define message-contract (some-value (node-contract (Ix 2 chat-nodes))))
assert(Equal [("ts" "text") ("ts" "block")]
  (slot-accepts-of message-contract))
assert(Equal ("ts" "many") (slot-cardinality message-contract))
assert(Eq 1 (slot-required message-contract))
assert(Equal "/boot/maybe/none" (Hd (slot-fallback message-contract)))
assert(Equal [("ts" "participation") ("ts" "content")]
  (slot-participation message-contract))
;; The shared message definition is referenced by two contextual edges.
assert(Equal [("ts" "plate")] (edge-parent (Ix 1 chat-edges)))
assert(Equal [("ts" "slot") ("ts" "messages")]
  (edge-placement (Ix 1 chat-edges)))
assert(Equal [("ts" "message_thread")] (edge-child (Ix 1 chat-edges)))
assert(Equal [("ts" "root")] (edge-parent (Ix 2 chat-edges)))
assert(Equal [("ts" "slot") ("ts" "preview")]
  (edge-placement (Ix 2 chat-edges)))
assert(Equal [("ts" "message_thread")] (edge-child (Ix 2 chat-edges)))

;; The pure namespace projection retains root metadata plus addressed nodes/edges.
(define chat-records (some-value (compile-records chat-recipe-src)))
assert(Eq 7 (Sz chat-records))
assert(Equal "recipe"
  (txt-at [("ts" "foundry") ("ts" "kind")] (_1 (Ix 0 chat-records))))
(define chat-record (_1 (Ix 0 chat-records)))
(define subject-pail
  (pail-at [("ts" "lens") ("ts" "subject")] chat-record))
assert(Equal "/boot/pails/p" (Hd subject-pail))
assert(Equal [("ts" "chat") ("ts" "layout")] (_0 subject-pail))
assert(Equal "/boot/pails/n"
  (Hd (pail-at [("ts" "lens") ("ts" "kook")] chat-record)))
(define message-node-record (_1 (Ix 3 chat-records)))
(define plate-node-record (_1 (Ix 2 chat-records)))
assert(Equal "/boot/pails/p"
  (Hd (pail-at [("ts" "surface") ("ts" "action")] plate-node-record)))
(define accepts-pail
  (pail-at [("ts" "slot") ("ts" "accepts")] message-node-record))
assert(Equal "/boot/pails/ps" (Hd accepts-pail))
assert(Equal
  [[("ts" "surface") ("ts" "text")]
   [("ts" "surface") ("ts" "block")]]
  (_0 accepts-pail))
assert(Equal "many"
  (txt-at [("ts" "slot") ("ts" "cardinality")] message-node-record))
assert(Equal "true"
  (txt-at [("ts" "slot") ("ts" "required")] message-node-record))

;;; The former /lens/kook spelling was semantically wrong: its value is a
;;; stateful subject, not a behavior form.  Refuse it instead of silently
;;; mounting a recipe whose amendment destination disappeared.
(define legacy-kook-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/foundry/chat/legacy_lens"
     ";@ /recipe/role ;/projection/chat/legacy_lens"
     ";@ /recipe/input surface_tree"
     ";@ /recipe/output_kind plate"
     ";@ /recipe/primitive sewn"
     ";@ /recipe/ceiling plate"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/shrine"
     ";@ /lens/kook ;/chat/layout"
     ";. /foundry/chat/legacy_lens"]))
(define legacy-kook-compilation (compile-doc legacy-kook-src))
(define legacy-kook-diagnostics
  (compilation-diagnostics legacy-kook-compilation))
assert(Eq 1 (Sz legacy-kook-diagnostics))
assert(Equal ("ts" "field_deprecated")
  (diagnostic-code (Ix 0 legacy-kook-diagnostics)))
assert(Equal [("ts" "lens") ("ts" "kook")]
  (diagnostic-field (Ix 0 legacy-kook-diagnostics)))


;;; Catalogs supply request-selectable topology without Chat naming one.

(define catalog-src
  (unlines
    [";@ /foundry/kind catalog"
     ";@ /foundry/name ;/foundry/catalog/chat_desktop"
     ";@ /catalog/source ;/chat"
     ";@ /catalog/source_role ;/projection/chat"
     ";@ /catalog/target_role ;/projection/stage_flow/root_scene"
     ";@ /catalog/ceiling scene"
     ";@ /catalog/recipes ;/foundry/chat/plate ;/foundry/chat/scene ;/foundry/shrine/scene ;/foundry/stage_flow/root_scene"
     ";@ /catalog/layers ;/foundry/layers/base ;/foundry/layers/shrine"
     ";@ /catalog/terminal_role ;/renderer/web"
     ";. /foundry/catalog/chat_desktop"]))

(define catalog-compilation (compile-doc catalog-src))
(define catalog
  (some-value (document-catalog (value-of catalog-compilation))))
assert(Equal ("ts" "catalog") (_0 (compilation-kind catalog-compilation)))
assert(Equal [("ts" "chat")] (_0 (catalog-source catalog)))
assert(Equal [("ts" "projection") ("ts" "chat")]
  (catalog-source-role catalog))
assert(Equal [("ts" "projection") ("ts" "stage_flow") ("ts" "root_scene")]
  (catalog-target-role catalog))
assert(Eq 4 (Sz (catalog-recipes catalog)))
assert(Equal [("ts" "foundry") ("ts" "chat") ("ts" "plate")]
  (Ix 0 (catalog-recipes catalog)))
assert(Equal [("ts" "foundry") ("ts" "stage_flow") ("ts" "root_scene")]
  (Ix 3 (catalog-recipes catalog)))
assert(Eq 2 (Sz (catalog-layers catalog)))
assert(Equal [("ts" "renderer") ("ts" "web")]
  (_0 (catalog-terminal-role catalog)))


;;; Invalid kinds, duplicate addresses, cycles, and duplicate fields refuse.

;;; A Recipe becomes a fallback only through one explicit validated class.
(define typed-fallback-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/foundry/fallback/typed"
     ";@ /recipe/role ;/projection/fallback/typed"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind text"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling block"
     ";@ /recipe/fallback_class renderer"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/neutral"
     ";. /foundry/fallback/typed"
     "  ;@ /surface/kind text"
     "  ;@ /surface/role ;/projection/fallback/typed"
     "  ;@ /surface/text unavailable"
     "  ;. /foundry/fallback/typed/root"]))
(define typed-fallback
  (some-value (document-recipe (value-of (compile-doc typed-fallback-src)))))
assert(Equal ("/boot/maybe/some" ("ts" "renderer"))
  (recipe-fallback-class typed-fallback))

(define invalid-fallback-class
  (compile-doc
    (unlines
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/fallback/invalid"
       ";@ /recipe/role ;/projection/fallback/invalid"
       ";@ /recipe/input record"
       ";@ /recipe/output_kind text"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class destructive"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /foundry/fallback/invalid"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value invalid-fallback-class)))
assert(Equal ("ts" "field_invalid")
  (diagnostic-code (Ix 0
    (compilation-diagnostics invalid-fallback-class))))
assert(Equal [("ts" "recipe") ("ts" "fallback_class")]
  (diagnostic-field (Ix 0
    (compilation-diagnostics invalid-fallback-class))))

(define bad-kind
  (compile-doc
    (unlines
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/bad"
       ";@ /recipe/role ;/projection/bad"
       ";@ /recipe/input record"
       ";@ /recipe/output_kind div"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling plate"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/shrine"
       ";@ /recipe/template ;/foundry/surface/bad"
       ";. /foundry/bad"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value bad-kind)))
assert(Equal ("ts" "field_invalid")
  (diagnostic-code (Ix 0 (compilation-diagnostics bad-kind))))

(define collision
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/surface/collision"
       ";. /foundry/surface/collision"
       "  ;@ /surface/kind plate"
       "  ;@ /surface/role ;/projection/one"
       "  ;. same"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/projection/two"
       "  ;. same"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value collision)))
assert(Equal ("ts" "surface_address_collision")
  (diagnostic-code (Ix 0 (compilation-diagnostics collision))))

(define cycle
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/surface/cycle"
       ";. /foundry/surface/cycle"
       "  ;@ /surface/kind scene"
       "  ;@ /surface/role ;/projection/a"
       "  ;. a"
       "    ;/b"
       "  ;@ /surface/kind plate"
       "  ;@ /surface/role ;/projection/b"
       "  ;. b"
       "    ;/a"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value cycle)))
assert(Equal ("ts" "surface_cycle")
  (diagnostic-code
    (Ix (- (Sz (compilation-diagnostics cycle)) 1)
      (compilation-diagnostics cycle))))

(define duplicate-field
  (compile-doc
    (unlines
      [";@ /foundry/kind catalog"
       ";@ /foundry/name ;/foundry/catalog/one"
       ";@ /foundry/name ;/foundry/catalog/two"
       ";@ /catalog/source_role ;/projection/chat"
       ";@ /catalog/target_role ;/projection/stage"
       ";@ /catalog/ceiling stage"
       ";@ /catalog/recipes ;/foundry/chat/plate"
       ";. /foundry/catalog/bad"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value duplicate-field)))
assert(Equal ("ts" "field_collision")
  (diagnostic-code (Ix 0 (compilation-diagnostics duplicate-field))))
assert(Equal [("ts" "foundry") ("ts" "name")]
  (diagnostic-field (Ix 0 (compilation-diagnostics duplicate-field))))

;;; Actions preserve intent and recipient separately; destinations are
;;; semantic targets on navigation Blocks, never renderer URLs or defaults.

(define navigation-src
  (unlines
    [";@ /foundry/kind surface"
     ";@ /foundry/name ;/foundry/navigation/example"
     ";. /foundry/navigation/example"
     "  ;@ /surface/kind block"
     "  ;@ /surface/role ;/navigation/item"
     "  ;@ /surface/destination ;/flows/general"
     "  ;. root"]))
(define navigation-surface
  (some-value (document-surface (value-of (compile-doc navigation-src)))))
assert(Equal [("ts" "flows") ("ts" "general")]
  (_0 (node-destination (Ix 0 (surface-nodes navigation-surface)))))

(define ill-typed-action
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/action/partial"
       ";. /foundry/action/partial"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/action/send"
       "  ;@ /surface/action send"
       "  ;. root"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value ill-typed-action)))
assert(Equal ("ts" "field_ill_typed")
  (diagnostic-code (Ix 0 (compilation-diagnostics ill-typed-action))))

(define action-on-text
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/action/text"
       ";. /foundry/action/text"
       "  ;@ /surface/kind text"
       "  ;@ /surface/role ;/action/send"
       "  ;@ /surface/action ;/chat/actions/send"
       "  ;. root"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value action-on-text)))
assert(Equal ("ts" "action_reference_non_block")
  (diagnostic-code (Ix 0 (compilation-diagnostics action-on-text))))

(define combined-interaction
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/action/combined"
       ";. /foundry/action/combined"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/action/send"
       "  ;@ /surface/action ;/chat/actions/send"
       "  ;@ /surface/destination ;/flows/general"
       "  ;. root"])))
(define combined-surface
  (some-value (document-surface (value-of combined-interaction))))
(define combined-node (Ix 0 (surface-nodes combined-surface)))
assert(Equal [("ts" "chat") ("ts" "actions") ("ts" "send")]
  (_0 (node-action combined-node)))
assert(Equal [("ts" "flows") ("ts" "general")]
  (_0 (node-destination combined-node)))

;;; Slot contracts are all-or-nothing and belong only to Slot definitions.

(define partial-slot
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/surface/partial_slot"
       ";. /foundry/surface/partial_slot"
       "  ;@ /surface/kind slot"
       "  ;@ /surface/role ;/projection/slot"
       "  ;@ /slot/accepts ;/surface/text"
       "  ;. slot"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value partial-slot)))
assert(Equal ("ts" "field_required")
  (diagnostic-code (Ix 0 (compilation-diagnostics partial-slot))))

(define contract-on-block
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/surface/non_slot_contract"
       ";. /foundry/surface/non_slot_contract"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/projection/block"
       "  ;@ /slot/accepts ;/surface/text"
       "  ;@ /slot/cardinality one"
       "  ;@ /slot/required true"
       "  ;@ /slot/participation ;/participation/label"
       "  ;. block"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value contract-on-block)))
assert(Equal ("ts" "slot_contract_non_slot")
  (diagnostic-code (Ix 0 (compilation-diagnostics contract-on-block))))

(define invalid-slot-accepts
  (compile-doc
    (unlines
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/surface/invalid_slot_accepts"
       ";. /foundry/surface/invalid_slot_accepts"
       "  ;@ /surface/kind slot"
       "  ;@ /surface/role ;/projection/slot"
       "  ;@ /slot/accepts ;/surface/slot ;/surface/text ;/surface/text"
       "  ;@ /slot/cardinality one"
       "  ;@ /slot/required false"
       "  ;@ /slot/participation ;/participation/content"
       "  ;. slot"])))
assert(Equal "/boot/maybe/none" (Hd (compilation-value invalid-slot-accepts)))
assert(Equal ("ts" "slot_accepts_invalid")
  (diagnostic-code (Ix 0 (compilation-diagnostics invalid-slot-accepts))))
assert(Equal ("ts" "slot_accepts_duplicate")
  (diagnostic-code (Ix 1 (compilation-diagnostics invalid-slot-accepts))))

(print "foundry document tests passed")
