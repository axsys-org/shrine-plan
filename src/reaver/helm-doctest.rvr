;;;; The doctest family: a chore-driver family (helm-chore.rvr) that
;;;; evaluates documented entries' doctests against the live image's
;;;; own compiled subject and writes verdicts onto the mirror nodes
;;;; (doc/doctest-runner-explorer.md part I).
;;;;
;;;; A dt/req record MADE under /io/doctest carries a ['target]
;;;; mirror path — an exact documented node, or a /boot prefix to
;;;; sweep.  The plan turns the target into one job per documented
;;;; node; each job wants the node's current version (the verdict's
;;;; staleness anchor) and evaluates in its own leaf actor.  The
;;;; verdict rides a CHILD node (<node>/dt) through the mkp cmd — the
;;;; documented node's version stays clean as the anchor, and an
;;;; already-exists ack retries the make as a poke.
;;;;
;;;; ds = ["D" sut mcache myth/pail_at dt_card_t chore/cmd/mkp] — the
;;;;       core's subject, the mirror-shaped cache, and compiled
;;;;       lainapp/pact/chore entries, supplied by the spawner.
;;;;       Evaluation uses each cache entry's OWN subject (apps
;;;;       compile after the core chain, so the core's subject cannot
;;;;       resolve app-local names); the sut slot stays for shape
;;;;       stability.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-lore (#module foil-lore))

(#bind doctest (#module doctest))

(#bind helm (#module helm))

(define (d-sut ds) (Ix 1 ds))
(define (d-cache ds) (Ix 2 ds))
(define (d-pslot ds) (Ix 3 ds))
(define (d-card ds) (Ix 4 ds))
(define (d-mkp ds) (Ix 5 ds))

(define (ts s) ("ts" s))

;; "12" -> [1 12]; anything non-decimal -> [0 0]
(define (cord-nat s)
  (define n (Bytes s))
  (define (go i acc)
    (If (Ge i n)
      [1 acc]
      (let ((c (Load8 i s)))
        (If (And (Ge c 48) (Le c 57))
          (go (Inc i) (Add (Mul 10 acc) (Sub c 48)))
          [0 0]))))
  (If (Eq 0 n) [0 0] (go 0 0)))

(define (join-slash segs)
  (strcat
    (foldl
      (lambda (acc s) (If (Sz acc) (snoc s (snoc "/" acc)) [s]))
      [] segs)))

;; A failing doctest's got text, capped (doc provisional: ~500 bytes).
(define (cap-got s)
  (If (And (IsNat s) (Gt (Bytes s) 500))
    (strcat [(foil-lore:str-slice 0 500 s) ".."])
    s))

(define (cap-results rs)
  (map (lambda (r) [(Ix 0 r) (Ix 1 r) (cap-got (Ix 2 r))]) rs))

;; The documented-node jobs a target names: [[node lore sut] ..],
;; each carrying its owning cache entry's subject — doctests must
;; evaluate against the module's own compiled names (app modules sit
;; outside the core subject).  An exact entry path
;; ([boot ..modsegs n ..name]) is one job; anything else is a prefix
;; sweep over the cache — module headers and own entries whose lore
;; carries tests.  The cache is the index of documented nodes; no
;; namespace walk.
(define (jobs-for ds tgt)
  (define cache (d-cache ds))
  (define cords (map (Ix 0) tgt))
  (define (entry-job z)
    ;; find the count segment: cords = boot ..mod.. n ..name..
    (define n (Sz cords))
    (define (try i)
      (If (Ge i n)
        0
        (let ((cn (cord-nat (Ix i cords))))
          (If (And (Ix 0 cn) (Eq (Sub n (Inc i)) (Ix 1 cn)))
            (let* ((mod (join-slash (drop 1 (take i cords))))
                   (name (drop (Inc i) cords))
                   (hit (find (lambda (me) (Eq mod (_0 me))) cache)))
              (Ifz hit
                (try (Inc i))
                (let ((l (foil-lore:lore-for (helm:entry-lore (_0 hit)) name)))
                  (Ifz l (try (Inc i)) [[tgt (_0 l) (_1 (_0 hit))]]))))
            (try (Inc i))))))
    (If (Lt n 3) 0 (try 2)))
  (define (tested l) (Gt (Sz (foil-lore:lore-tests l)) 0))
  (define (sweep z)
    (foldl
      (lambda (acc me)
        (let* ((bsegs (Weld [(ts "boot")] (map ts (helm:mod-segs (_0 me)))))
               (lore (helm:entry-lore me)))
          (If (Nil (Equal tgt (take (Sz tgt) bsegs)))
            acc
            (let* ((mh (foil-lore:lore-for lore []))
                   (acc1
                     (If (And mh (tested (_0 mh)))
                       (snoc [bsegs (_0 mh) (_1 me)] acc)
                       acc)))
              (foldl
                (lambda (a k)
                  (let* ((name (drop 1 k))
                         (hit (foil-lore:lore-for lore name)))
                    (If (And hit (tested (_0 hit)))
                      (snoc
                        [(Weld bsegs
                           (Weld [(ts (showNat (Sz name)))] (map ts name)))
                         (_0 hit) (_1 me)]
                        a)
                      a)))
                acc1 (helm:entry-own-keys me))))))
      [] cache))
  (define ej (entry-job 0))
  (cond
    ((Nil (Equal (ts "boot") (Ix 0 tgt))) [])
    (ej ej)
    (else (sweep 0))))

;; The family's plan: resolve the ['target] path into jobs.  Every
;; job wants its node's version — the staleness anchor.  The request
;; node itself is unused: verdicts land on the targets.
(define (dt-plan ds rec reqnode)
  (define tgtp ((d-pslot ds) [(ts "target")] rec))
  (define tgt (If (Eq "/boot/pails/p" (Hd tgtp)) (_0 tgtp) []))
  (define js (Ifz (Sz tgt) [] (jobs-for ds tgt)))
  ["JOBS" (map (lambda (j) [(Ix 0 j) 1 j]) js)])

;; The family's run (in a leaf actor): evaluate the node's doctests
;; and hand back one mkp of the verdict child.  A node culled between
;; plan and case reports nothing.
(define (dt-run ds payload c)
  (define node (Ix 0 payload))
  (define lore (Ix 1 payload))
  (define msut (Ix 2 payload))
  (If (Nil (Eq "/boot/maybe/some" (Hd c)))
    [[] 0 0]
    (let* ((rs (cap-results (doctest:run-lore msut lore)))
           (np (foldl (lambda (a r) (If (Ix 1 r) (Inc a) a)) 0 rs))
           (nf (Sub (Sz rs) np))
           (dtnode (snoc (ts "dt") node))
           (card ((d-card ds) (Now 0) (_0 c) rs)))
      [[((d-mkp ds) dtnode card)] np nf])))

(define (dt-family ds)
  [(ts "doctest") (dt-plan ds) (dt-run ds)])
