(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind foil (#module foil-new-env))
(#bind rex (#module rex))

(define (check z)
  ;;;; Copyright (c) 2026 Axiomatic Systems
  ;;;; SPDX-License-Identifier: MIT
  ;;;; See LICENSE for full terms.





  ;;; Kernel regressions compile directly, without the demo application's
  ;;; web/pact imports or a staged whole-corpus snapshot.  Fixtures exercise
  ;;; all four active form arms, in-flight cards, and named dependencies.
  (define app-sut
    (foil:perc-subject (_1 (source:compile-rex 0 "lain-core-fixture"
      (rex:ParseRexNorm "
-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
+  vine_make
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/make t))
+  vine_poke
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/poke t))
+  vine_cull
  \  pax=path
  ^  task
  (./vine pax (writ/cull))
+  vine_warp
  \  pax=path op=path input=myth
  ^  task
  (./vine pax (writ/warp op input))
+  demo
  +  count_take
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    =  kk  b.kids
    =  o   cur.put(['n] (pd kk.wyt.dec))
    (yell [] o)
  +  count_form
    ^  form
    def_form.set_take(demo/count_take)
  +  echo_talk
    \  b=bowl cur=myth add=myth
    ^  yell
    =  o   cur.meld(add)
    =  cd=[p=path q=writ]  [['xeno 'log] (writ/poke add)]
    (yell [cd] o)
  +  echo_form
    ^  form
    def_form.set_talk(demo/echo_talk)
  +  spawn_init
    \  b=bowl t=myth
    ^  yell
    =  here  b.here
    =  kid   here.snoc('kid)
    =  cd    [kid (writ/make (kooked [['kook 'count]]))]
    (yell [cd] t)
  +  spawn_form
    ^  form
    def_form.set_init(demo/spawn_init)
  +  mark_hear
    \  b=bowl cur=myth r=row[dep]
    ^  yell
    =  o  cur.put(['heard] (pd r.len))
    (yell [] o)
  +  mark_form
    ^  form
    def_form.set_hear(demo/mark_hear)
  +  ma_talk
    \  b=bowl cur=myth add=myth
    ^  yell
    =  old  cur.nat_at(['ord] 0)
    =  o    cur.put(['ord] (pd old.mul(10).add(1)))
    (yell [] o)
  +  mb_talk
    \  b=bowl cur=myth add=myth
    ^  yell
    =  old  cur.nat_at(['ord] 0)
    =  o    cur.put(['ord] (pd old.mul(10).add(2)))
    (yell [] o)
  +  ma_form
    ^  form
    def_form.set_talk(demo/ma_talk)
  +  mb_form
    ^  form
    def_form.set_talk(demo/mb_talk)
  +  crew_talk
    \  b=bowl cur=myth add=myth
    ^  yell
    =  o   cur.meld(add)
    =  total
         | b.crew.tap.fold 0
         \ acc [key value]
         acc.add(value.wyt)
    =  o2  o.put(['seen] (pd total))
    (yell [] o2)
  +  crew_form
    ^  form
    def_form.set_talk(demo/crew_talk)
+  kooked_bad
  \  x=nat
  ^  myth
  =  t  myth/new
  t.put(limb_slot (pd x))
+  t_crew
  \  slot=path tgt=path refs=row[path]
  ^  myth
  =  t1  (kooked refs)
  t1.put(crew_slot (cpail (crew/sing slot (dep .z tgt))))
+  slot_nat
  \  pax=path slot=path d=nat s=sov
  ^  nat
  ?  s.x_latest(pax)
   > (./known t=myth)  t.nat_at(slot d)
  d
+  mk_news
  \  lit=row[[p=path q=row[dep]]]
  ^  axal[row[dep]]
  (axal/gas[row[dep]] lit (axal/new[row[dep]] .none))
+  empty_tree
  \ fil=maybe[myth]
  ^ axal[myth]
  (axal/new[myth] fil)
+  commit_notes
  \ writes=row[[p=path q=note]] journal=bool s=sov
  ^ verdict[[state=sov signs=axal[sign]]]
  (commit (vine_cull []) .none journal (fate writes []) s)
+  input_op
  ^ myth
  (myth/sing ['sys 'op] (op 'input 'any [] 'any 0 (\ input=myth cur=myth input)))
+  bulk_map
  ^  row[nat]
  =  empty=mop[nat nat lt] (mop/empty)
     filled empty.gas([[1 3] [2 5] [1 7]])
  [filled.gut(1 0) filled.gut(2 0) filled.gas([]).gut(1 0)]
+  seeded
  ^  sov
  =  registrations=row[[p=path f=form]]
       [[['kook 'count] demo/count_form]
        [['kook 'spawn] demo/spawn_form]
        [['kook 'echo] demo/echo_form]
        [['kook 'mark] demo/mark_form]
        [['kook 'ma] demo/ma_form]
        [['kook 'mb] demo/mb_form]
        [['kook 'crew] demo/crew_form]]
  | registrations.fold sov/new
  \ acc [p f]
  ? (run_event (vine_make p (myth/sing ['form] f)) 0 acc)
   > (./ripe state fx signs ack) state
   > (./fail err) acc
")))))
  (define (app path) (foil:source-entry-val path app-sut))

  ;; kernel + helpers through the merged subject
  (define is-xeno (app ["is_xeno"]))
  (define mode-then (app ["mode_then"]))
  (define lte-pith (app ["lte_pith"]))
  (define run-event (app ["run_event"]))
  (define kern (app ["kernel"]))
  ;; fixtures
  (define sov0 (app ["seeded"]))
  (define top0 (_2 sov0))
  assert(Eq 7 top0)
  (define t00 (app ["myth" "new"]))
  (define msing (app ["myth" "sing"]))
  (define pd-f (app ["pd"]))
  (define (t-data slot n) (msing slot (pd-f n)))
  (define kooked (app ["kooked"]))
  (define slot-nat (app ["slot_nat"]))
  (define mk-news (app ["mk_news"]))
  (define vine-make (app ["vine_make"]))
  (define vine-poke (app ["vine_poke"]))
  (define vine-cull (app ["vine_cull"]))

  (define tkook ("ts" "kook"))
  ;; kook refs are full form-node paths (rerootable; /kook by convention)
  (define kcount [tkook ("ts" "count")])
  (define kspawn [tkook ("ts" "spawn")])
  (define kecho [tkook ("ts" "echo")])
  (define kmark [tkook ("ts" "mark")])
  (define kma [tkook ("ts" "ma")])
  (define kmb [tkook ("ts" "mb")])
  (define nslot [("ts" "n")])

  ;;; smoke ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  assert(Eq 1 (is-xeno [("ts" "xeno") ("ts" "log")]))
  assert(Eq 0 (is-xeno [("ts" "chat")]))
  assert(Eq 0 (is-xeno []))
  assert(Equal "/boot/lain_types/mode/add" (mode-then "/boot/maybe/none" "/boot/lain_types/mode/add"))
  assert(Equal "/boot/lain_types/mode/del" (mode-then ("/boot/maybe/some" "/boot/lain_types/mode/add") "/boot/lain_types/mode/del"))
  assert(Equal "/boot/lain_types/mode/add" (mode-then ("/boot/maybe/some" "/boot/lain_types/mode/del") "/boot/lain_types/mode/add"))
  assert(Equal "/boot/lain_types/mode/add" (mode-then ("/boot/maybe/some" "/boot/lain_types/mode/add") "/boot/lain_types/mode/dif"))

  ;;; 1. vine-make basics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define ta ("ts" "a"))
  (define r1 (run-event (vine-make [ta] (kooked [kcount])) 7 sov0))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r1))
  (define s1 (_0 r1))
  assert(Eq (Inc top0) (_2 s1))
  assert(Eq 0 (Sz (_1 r1)))
  ;; the ripe carries the command's ack: its path tag
  assert(Equal ("/boot/maybe/some" [ta]) (_3 r1))

  ;;; 2. ingest-down + same-event raid: spawn makes a kid, count sees it ;;;;;;;;;;;;

  (define r2 (run-event (vine-make [ta] (kooked [kspawn kcount])) 7 sov0))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r2))
  (define s2 (_0 r2))
  ;; the kid exists in the same minted case
  assert(Eq (Inc top0) (_2 s2))
  ;; ... and [a]'s count take already saw it: n = 1
  assert(Eq 1 (slot-nat [ta] nslot 99 s2))

  ;;; 3. raid cascades two levels and stops at the root ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define tb ("ts" "b"))
  (define tc ("ts" "c"))
  (define td ("ts" "d"))
  (define r3a0 (run-event (vine-make [tb] (kooked [kcount])) 7 sov0))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r3a0))
  (define s3a0 (_0 r3a0))
  (define r3a (run-event (vine-make [tb tc] (kooked [kcount])) 7 s3a0))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r3a))
  (define s3a (_0 r3a))
  ;; the make of [b c] fired [b]'s take in the same event
  assert(Eq 1 (slot-nat [tb] nslot 99 s3a))
  (define r3b (run-event (vine-make [tb tc td] t00) 7 s3a))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r3b))
  (define s3b (_0 r3b))
  assert(Eq 1 (slot-nat [tb tc] nslot 99 s3b))
  assert(Eq 1 (slot-nat [tb] nslot 99 s3b))

  ;;; 4. up routing: an outside-subtree card leaves as an effect ;;;;;;;;;;;;;;;;;;;;

  (define te ("ts" "e"))
  (define r4a (run-event (vine-make [te] (kooked [kecho])) 7 sov0))
  (define s4a (_0 r4a))
  (define r4b (run-event (vine-poke [te] (t-data [("ts" "msg")] 42)) 7 s4a))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r4b))
  (define s4b (_0 r4b))
  (define fx4 (_1 r4b))
  assert(Eq 1 (Sz fx4))
  ;; a move carries one command: src, dst, writ
  (define mv (Ix 0 fx4))
  assert(Equal [te] (_0 mv))
  assert(Equal [("ts" "xeno") ("ts" "log")] (_1 mv))
  assert(Eq "/boot/lain_types/writ/poke" (Hd (_2 mv)))
  ;; the union semantics committed: msg landed, an earlier slot survives
  assert(Eq 42 (slot-nat [te] [("ts" "msg")] 0 s4b))
  (define r4c (run-event (vine-poke [te] (t-data [("ts" "other")] 5)) 7 s4b))
  (define s4c (_0 r4c))
  assert(Eq 5 (slot-nat [te] [("ts" "other")] 0 s4c))
  assert(Eq 42 (slot-nat [te] [("ts" "msg")] 0 s4c))

  ;;; 5. poke-missing fails the whole event, sovereign untouched ;;;;;;;;;;;;;;;;;;;;

  (define r5 (run-event (vine-poke [("ts" "zz")] t00) 7 s1))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "poke_missing")) r5)
  ;; s1 still drives events from its old top: nothing was written
  (define r5b (run-event (vine-make [("ts" "zz")] t00) 7 s1))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r5b))
  assert(Eq (Add top0 2) (_2 (_0 r5b)))

  ;;; 6. cull tombstones and the parent's take sees the shrink ;;;;;;;;;;;;;;;;;;;;;;

  (define tkid ("ts" "kid"))
  (define r6 (run-event (vine-cull [ta tkid]) 7 s2))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r6))
  (define s6 (_0 r6))
  ;; the kid is tombstoned at the new top ...
  assert(Eq 77 (slot-nat [ta tkid] nslot 77 s6))
  ;; ... and [a]'s count take re-fired within the same event: n = 0
  assert(Eq 0 (slot-nat [ta] nslot 99 s6))

  ;;; 7. hear fan-in: (care, path) pairs, inversion, xeno skip, empty-subscriber ;;;;;

  (define tm ("ts" "m"))
  (define r7a (run-event (vine-make [tm] (kooked [kmark])) 7 sov0))
  (define s7a (_0 r7a))
  (define chg [("ts" "chg")])
  ;; each subscription is a /dep pair: ("/boot/lain_types/dep" care subscriber-path)
  (define (mk-dep c p) ("/boot/lain_types/dep" c p))
  (define news1
    (mk-news [[chg [(mk-dep "/boot/shrine_types/care/z" [tm]) (mk-dep "/boot/shrine_types/care/z" [("ts" "xeno") ("ts" "w")])]]]))
  (define r7b (run-event ("/boot/lain_types/task/hear" news1) 7 s7a))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd r7b))
  (define s7b (_0 r7b))
  assert(Eq 1 (slot-nat [tm] [("ts" "heard")] 99 s7b))
  ;; hear events ack $none through the ovum too
  assert(Equal "/boot/maybe/none" (_3 r7b))
  (define news2 (mk-news [[chg [(mk-dep "/boot/shrine_types/care/z" [("ts" "xeno") ("ts" "w")])]]]))
  (define r7c (run-event ("/boot/lain_types/task/hear" news2) 7 s7a))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "hear_no_subs")) r7c)

  ;;; 8. multi-kook composition order ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define to1 ("ts" "o1"))
  (define to2 ("ts" "o2"))
  (define ord [("ts" "ord")])
  (define r8a (run-event (vine-make [to1] (kooked [kma kmb])) 7 sov0))
  (define r8b (run-event (vine-poke [to1] t00) 7 (_0 r8a)))
  assert(Eq 12 (slot-nat [to1] ord 0 (_0 r8b)))
  (define r8c (run-event (vine-make [to2] (kooked [kmb kma])) 7 sov0))
  (define r8d (run-event (vine-poke [to2] t00) 7 (_0 r8c)))
  assert(Eq 21 (slot-nat [to2] ord 0 (_0 r8d)))

  ;;; 9. default talk is union, add wins ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define tu ("ts" "u"))
  (define keep [("ts" "keep")])
  (define r9a (run-event (vine-make [tu] (t-data keep 5)) 7 sov0))
  (define r9b (run-event (vine-poke [tu] (t-data keep 6)) 7 (_0 r9a)))
  (define s9 (_0 r9b))
  assert(Eq 6 (slot-nat [tu] keep 0 s9))
  (define r9c (run-event (vine-poke [tu] (t-data [("ts" "new")] 7)) 7 s9))
  (define s9c (_0 r9c))
  assert(Eq 7 (slot-nat [tu] [("ts" "new")] 0 s9c))
  assert(Eq 6 (slot-nat [tu] keep 0 s9c))

  ;;; 10. unknown kook fails the event ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define r10 (run-event (vine-make [("ts" "z")] (kooked [[tkook ("ts" "zzz")]])) 7 sov0))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "kook_unknown")) r10)

  ;;; 10b. a non-kook pail in the behavior slot fails as kook_bad ;;;;;;;;;;;;;;;;;;;;

  (define kooked-bad (app ["kooked_bad"]))
  (define r10b (run-event (vine-make [("ts" "z")] (kooked-bad 3)) 7 sov0))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "kook_bad")) r10b)

  ;;; 11. fate write order is lte_pith; the doom acks the command's path ;;;;;;;;;;;;;

  (define d11 (kern (vine-make [tb tc] t00) 7 s3a0))
  assert(Eq "/boot/lain_types/doom/done" (Hd d11))
  ;; the ack is the vine command's path tag
  assert(Equal ("/boot/maybe/some" [tb tc]) (_1 d11))
  (define w11 (_0 (_0 d11)))
  ;; the make of [b c] also poked [b] (count take): two writes, sorted
  assert(Eq 2 (Sz w11))
  assert(Eq 1 (lte-pith (_0 (Ix 0 w11)) (_0 (Ix 1 w11))))
  (define (sorted-writes i)
    (If (Ge (Inc i) (Sz w11))
      1
      (And (lte-pith (_0 (Ix i w11)) (_0 (Ix (Inc i) w11)))
        (sorted-writes (Inc i)))))
  assert(Eq 1 (sorted-writes 0))

  ;;; 11b. hear events ack $none ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define d11b (kern ("/boot/lain_types/task/hear" news1) 7 s7a))
  assert(Eq "/boot/lain_types/doom/done" (Hd d11b))
  assert(Equal "/boot/maybe/none" (_1 d11b))

  ;;; 11c. crew: named deps hydrate into the bowl, keyed by slot ;;;;;;;;;;;;;;;;;;;;;

  (define t-crew (app ["t_crew"]))
  (define twd ("ts" "watched"))
  (define twk ("ts" "wk"))
  (define twr ("ts" "w"))
  (define seen [("ts" "seen")])
  ;; a watched subtree with one record, and a watcher whose /sys/crew
  ;; maps the slot ['eyes] to a z-care read of it
  (define eslot [("ts" "eyes")])
  (define rd1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
  (define rd2 (run-event (vine-make [twr] (t-crew eslot [twd] [[tkook ("ts" "crew")]])) 7 (_0 rd1)))
  (define rd3 (run-event (vine-poke [twr] t00) 7 (_0 rd2)))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd rd3))
  ;; one entry hydrated: /watched itself
  assert(Eq 1 (slot-nat [twr] seen 99 (_0 rd3)))
  ;; grow the watched subtree; the next activation sees both entries
  (define rd4 (run-event (vine-make [twd twk] (t-data nslot 6)) 7 (_0 rd3)))
  (define rd5 (run-event (vine-poke [twr] t00) 7 (_0 rd4)))
  assert(Eq 2 (slot-nat [twr] seen 99 (_0 rd5)))
  ;; the slot is indexical: another node reads the same target under a
  ;; different local name and hydrates identically
  (define twr2 ("ts" "w2s"))
  (define rd6 (run-event (vine-make [twr2] (t-crew [("ts" "other")] [twd] [[tkook ("ts" "crew")]])) 7 (_0 rd5)))
  (define rd7 (run-event (vine-poke [twr2] t00) 7 (_0 rd6)))
  assert(Eq 2 (slot-nat [twr2] seen 99 (_0 rd7)))

  ;;; 11d. the cycle: eyes derive from crews, hears cascade ;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define cycle (app ["cycle"]))
  ;; a subscriber whose crew watches /watched and whose kook is mark
  ;; (its hear writes the rely count into ['heard]) — no mk_news, no
  ;; explicit hear event: the cycle derives and delivers
  (define tsub ("ts" "sub"))
  (define heard [("ts" "heard")])
  (define rc1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
  (define rc2 (run-event (vine-make [tsub] (t-crew eslot [twd] [[tkook ("ts" "mark")]])) 7 (_0 rc1)))
  (define g1 (cycle (vine-poke [twd] (t-data nslot 6)) 7 8 (_0 rc2)))
  assert(Eq "/boot/lain_types/gyre/spun" (Hd g1))
  (define sg1 (_0 g1))
  assert(Eq 1 (slot-nat [tsub] heard 99 sg1))
  ;; a clean cascade spills nothing
  assert(Eq "/boot/maybe/none" (Ix 4 g1))
  ;; an unresolvable kook cannot get INTO the namespace to break a
  ;; later hear — both the make and a kook-swapping poke fail at write
  ;; time (the spill channel covers whatever hear failures remain)
  (define tbads ("ts" "badsub"))
  (define rcb (run-event (vine-make [tbads] (t-crew [("ts" "b")] [twd] [[tkook ("ts" "nosuch")]])) 7 (_0 rc2)))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "kook_unknown")) rcb)
  (define rcb2 (run-event (vine-make [tbads] (t-crew [("ts" "b")] [twd] [[tkook ("ts" "mark")]])) 7 (_0 rc2)))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd rcb2))
  (define rcb3 (run-event (vine-poke [tbads] (t-crew [("ts" "b")] [twd] [[tkook ("ts" "nosuch")]])) 7 (_0 rcb2)))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "kook_unknown")) rcb3)
  ;; the ack rides through the cycle
  assert(Equal ("/boot/maybe/some" [twd]) (_3 g1))
  ;; two rounds: the poke, then the hear (which changed nothing watched)
  assert(Eq 2 (Sz (_2 g1)))

  ;; second order: another node watches the subscriber; the hear's own
  ;; write cascades to it in round three
  (define tsub2 ("ts" "sub2"))
  (define rc3 (run-event (vine-make [tsub2] (t-crew [("ts" "up")] [tsub] [[tkook ("ts" "mark")]])) 7 sg1))
  (define g2 (cycle (vine-poke [twd] (t-data nslot 7)) 7 8 (_0 rc3)))
  assert(Eq "/boot/lain_types/gyre/spun" (Hd g2))
  (define sg2 (_0 g2))
  ;; /sub's second hear resolves to the same myth (heard=1), so the
  ;; deduplicated write emits no sign and cannot cascade to /sub2.
  assert(Eq 99 (slot-nat [tsub2] heard 99 sg2))
  assert(Eq 2 (Sz (_2 g2)))

  ;; a self-watcher loops; the fuel cap bounds it
  (define tloop ("ts" "loop"))
  (define rc4 (run-event (vine-make [tloop] (t-crew [("ts" "me")] [tloop] [[tkook ("ts" "mark")]])) 7 sov0))
  (define g3 (cycle (vine-poke [tloop] (t-data nslot 1)) 7 3 (_0 rc4)))
  assert(Eq "/boot/lain_types/gyre/spun" (Hd g3))
  ;; The first hear writes heard=1; the next identical hear is a no-op,
  ;; so deduplication terminates the self-watch before the fuel cap.
  assert(Eq 3 (Sz (_2 g3)))


  ;;; Journal ownership and aura boundaries.
  (define peek-f (app ["peek"]))
  (define pail-at (app ["myth" "pail_at"]))
  (define dig-show (app ["dig_show"]))
  (define (arec fat) (_0 (Ix 0 fat)))
  (define card (pail-at [("ts" "ev")]
    (arec (peek-f [("ts" "log") (dig-show (_2 sg1))] sg1))))
  assert(Eq "/boot/lain_types/log_card" (Hd card))
  assert(Eq "/boot/lain_types/task/hear" (Hd (_0 card)))
  (define reserved (run-event (vine-make [("ts" "log") ("ts" "x")] t00) 7 sov0))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "log_reserved")) reserved)
  (define text-at (app ["myth" "txt_at"]))
  (define pt (app ["pt"]))
  assert(Equal "hello" (text-at nslot (msing nslot (pt "hello"))))
  assert(Equal "" (text-at nslot (t-data nslot 42)))
  assert(Equal "" (text-at nslot t00))
  assert(Equal "/kook/42" ((app ["curb_cord"]) [("ts" "kook") ("u" 42)]))

  ;;; Bulk map inserts replace duplicates and leave existing values alone.
  assert(Equal [7 5 7] (app ["bulk_map"]))

  ;;; Version reports retain their typed fields.
  (define report (arec ((app ["h_ver"]) [ta] s1)))
  assert(Equal "live" (text-at [("ts" "state")] report))
  assert(Equal (showNat (_2 s1)) (text-at [("ts" "top")] report))
  (print "lain core tests passed")

  ;;; Exhaustion is distinct from quiet, including at the exact boundary.
  (define limited (cycle (vine-poke [twd] (t-data nslot 6)) 7 0 (_0 rc2)))
  assert(Equal ("/boot/maybe/some" ("ts" "cycle_exhausted")) (Ix 4 limited))
  assert(Eq 1 (Sz (_2 limited)))
  assert(Eq 6 (slot-nat [twd] nslot 99 (_0 limited)))
  assert(Eq 99 (slot-nat [tsub] heard 99 (_0 limited)))
  (define exact (cycle (vine-poke [twd] (t-data nslot 6)) 7 1 (_0 rc2)))
  assert(Equal "/boot/maybe/none" (Ix 4 exact))
  assert(Eq 2 (Sz (_2 exact)))
  (define quiet0 (cycle (vine-make [twd] (t-data nslot 6)) 7 0 sov0))
  assert(Equal "/boot/maybe/none" (Ix 4 quiet0))
  (define grind-with (app ["grind_with"]))
  (define flue ((app ["vine_flue"]) [ta] ("/boot/lain_types/writ/poke" t00)))
  assert(Equal ("/boot/lain_types/doom/fail" ("ts" "grind_exhausted"))
    (grind-with 0 [flue] "/boot/maybe/none" 7 sov0))
  assert(Eq "/boot/lain_types/doom/done" (Hd (grind-with 0 [] "/boot/maybe/none" 7 sov0)))

  ;;; Derived /x identity belongs to the datum, whose inputs are pinned.
  (define meld-f (app ["myth" "meld"]))
  (define axal-new (app ["empty_tree"]))
  (define view-f (app ["view"]))
  (define xch (app ["x_case_h"]))
  (define xp [("ts" "x") ("ts" "view")])
  (define vp [("ts" "view")])
  (define dp [("ts" "input")])
  (define wp [("ts" "weaver")])
  (define ws [("ts" "sys") ("ts" "weft")])
  (define ts [("ts" "sys") ("ts" "tack")])
  (define (identity-spun nm dt) dt)
  (define (args-spun nm dt) (axal-new ("/boot/maybe/some" nm)))
  (define (pin ver care path) ("/boot/shrine_types/safe" ver care path))
  (define xs0 (_0 (run-event (vine-make dp (t-data nslot 10)) 0 sov0)))
  (define xs1 (_0 (run-event (vine-make wp (msing ws ("/boot/shrine_types/spun" identity-spun "/boot/maybe/none"))) 0 xs0)))
  (define xr (meld-f (msing ws (pin 1 "/boot/shrine_types/care/x" wp)) (msing ts (pin 1 "/boot/shrine_types/care/y" dp))))
  (define xs2 (_0 (run-event (vine-make vp xr) 0 xs1)))
  (define xs3 (_0 (run-event (vine-poke dp (t-data nslot 20)) 0 xs2)))
  (define xs4 (_0 (run-event (vine-poke wp (msing ws ("/boot/shrine_types/spun" args-spun "/boot/maybe/none"))) 0 xs3)))
  assert(Equal ("/boot/maybe/some" 1) (xch 0 xp xs4))
  assert(Eq 10 ((app ["myth" "nat_at"]) nslot 99 (arec (peek-f xp xs4))))
  (define xs5 (_0 (run-event (vine-poke vp (msing ts (pin 2 "/boot/shrine_types/care/y" dp))) 0 xs4)))
  assert(Equal ("/boot/maybe/some" 2) (xch 0 xp xs5))
  assert(Eq 20 ((app ["myth" "nat_at"]) nslot 99 (arec (peek-f xp xs5))))
  assert(Eq 10 ((app ["myth" "nat_at"]) nslot 99 (arec (_0 (view-f "/boot/shrine_types/care/x" 1 xp xs5)))))
  (define xs6 (_0 (run-event (vine-poke vp (meld-f (msing ws (pin 2 "/boot/shrine_types/care/x" wp)) (t-data nslot 77))) 0 xs5)))
  assert(Equal ("/boot/maybe/some" 3) (xch 0 xp xs6))
  assert(Eq 77 ((app ["myth" "nat_at"]) nslot 99 (arec (peek-f xp xs6))))
  assert(Eq 20 ((app ["myth" "nat_at"]) nslot 99 (arec (_0 (view-f "/boot/shrine_types/care/x" 2 xp xs6)))))
  assert(Equal [("/boot/lain_types/dep" "/boot/shrine_types/care/x" vp)] ((app ["xv_trigger"]) xp xs6))
  (define xs7 (_0 (run-event (vine-poke vp (msing ts (pin 0 "/boot/shrine_types/care/y" dp))) 0 xs6)))
  assert(Equal "/boot/shrine/res/unknown" (view-f "/boot/shrine_types/care/x" 0 xp xs7))
  (define inline-record (meld-f (msing ws ("/boot/shrine_types/spun" identity-spun "/boot/maybe/none")) (msing ts (pin 1 "/boot/shrine_types/care/y" dp))))
  (define inline-state (_0 (run-event (vine-poke vp inline-record) 0 xs7)))
  assert(Eq 10 ((app ["myth" "nat_at"]) nslot 99 (arec (peek-f xp inline-state))))
  (define wrong-care (_0 (run-event (vine-poke vp (msing ts (pin 1 "/boot/shrine_types/care/x" dp))) 0 inline-state)))
  assert(Equal "/boot/shrine/res/unknown" (view-f "/boot/shrine_types/care/x" 0 xp wrong-care))
  (define future-pin (_0 (run-event (vine-poke vp (msing ts (pin 999 "/boot/shrine_types/care/y" dp))) 0 inline-state)))
  assert(Equal "/boot/shrine/res/unknown" (view-f "/boot/shrine_types/care/x" 0 xp future-pin))
  (define make-flue ((app ["vine_flue"]) vp ("/boot/lain_types/writ/make" (t-data nslot 1))))
  assert(Equal ("/boot/lain_types/doom/fail" ("ts" "grind_exhausted"))
    (grind-with 1 [make-flue] "/boot/maybe/none" 0 sov0))
  assert(Equal ("/boot/lain_types/doom/fail" ("ts" "poke_missing"))
    (grind-with 1 [flue] "/boot/maybe/none" 0 sov0))
  (print "pinned views and exhaustion passed")

  ;;; Make and warp share replacement initialization, including emitted cards.
  (define op-path [("ts" "input-op")])
  (define op-state (_0 (run-event (vine-make op-path (app ["input_op"])) 0 sov0)))
  (define warp-task (app ["vine_warp"]))
  (define initialized (kooked [kspawn kcount]))
  (define made (kern (vine-make [ta] initialized) 0 op-state))
  (define warped (kern (warp-task [ta] op-path initialized) 0 op-state))
  assert(Equal made warped)
  assert(Eq "/boot/shrine_types/note/make" (Hd (Ix 1 (Ix 0 (_0 (_0 warped))))))
  (define existing (_0 (run-event (vine-make [ta] (t-data nslot 999)) 0 op-state)))
  assert(Equal (kern (vine-make [ta] initialized) 0 existing)
    (kern (warp-task [ta] op-path initialized) 0 existing))
  assert(Equal (kern (vine-make [ta] (kooked-bad 1)) 0 op-state)
    (kern (warp-task [ta] op-path (kooked-bad 1)) 0 op-state))

  ;;; Contract checks see normalized, final changes, not pruned descendants.
  (define commit-notes (app ["commit_notes"]))
  (define latest (app ["sov" "x_latest"]))
  (define lash-slot [("ts" "sys") ("ts" "lash")])
  (define contract ((app ["lash" "texted"]) nslot 0))
  (define cp [("ts" "contract-parent")])
  (define cq [("ts" "contract-parent") ("ts" "child")])
  (define contracted (meld-f (msing lash-slot contract) (msing nslot (pt "valid"))))
  (define cs0 (_0 (run-event (vine-make cp t00) 0 sov0)))
  (define cs1 (_0 (run-event (vine-make cq contracted) 0 cs0)))
  (define bad-note ("/boot/shrine_types/note/poke" (t-data nslot 42)))
  assert(Equal ("/boot/shrine/verdict/rejected" ("ts" "curb_type"))
    (commit-notes [[cq bad-note]] 0 cs1))
  (define culled (commit-notes [[cp "/boot/shrine_types/note/cull"] [cq bad-note]] 1 cs1))
  assert(Eq "/boot/shrine/verdict/accepted" (Hd culled))
  (define cs2 (_0 (_0 culled)))
  assert(Equal "/boot/shrine/res/null" (latest cq cs2))
  assert(Eq (Inc (_2 cs1)) (_2 cs2))
  assert(Eq "/boot/shrine/res/known" (Hd (latest [("ts" "log") (dig-show (_2 cs2))] cs2)))
  assert(Equal ("/boot/shrine/verdict/rejected" ("ts" "tombstoned_ancestor"))
    (commit-notes [[cq ("/boot/shrine_types/note/make" contracted)]] 0 cs2))
  ;; Repair/revive in one event still passes through the tombstone gate.
  assert(Eq "/boot/shrine/verdict/accepted"
    (Hd (commit-notes [[cp ("/boot/shrine_types/note/make" t00)] [cq ("/boot/shrine_types/note/make" contracted)]] 0 cs2)))
  ;; Adopting a contract over legacy data is legal; unchanged legacy data
  ;; stays legal to touch, while any actual nonconforming edit is refused.
  (define legacy-path [("ts" "legacy")])
  (define legacy0 (_0 (run-event (vine-make legacy-path (t-data nslot 1)) 0 sov0)))
  (define adopted (run-event (vine-poke legacy-path (msing lash-slot contract)) 0 legacy0))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd adopted))
  (define legacy (_0 adopted))
  assert(Eq "/boot/lain_types/ovum/ripe" (Hd (run-event (vine-poke legacy-path t00) 0 legacy)))
  assert(Equal ("/boot/lain_types/ovum/fail" ("ts" "curb_type"))
    (run-event (vine-poke legacy-path (t-data nslot 2)) 0 legacy))
  assert(Eq "/boot/lain_types/ovum/ripe"
    (Hd (run-event (vine-poke legacy-path (msing nslot (pt "fixed"))) 0 legacy)))
  ;; A make may remove required slots; an ordinary poke keeps them.
  assert(Equal ("/boot/shrine/verdict/rejected" ("ts" "curb_need"))
    (commit-notes [[cq ("/boot/shrine_types/note/make" (msing lash-slot contract))]] 0 cs1))
  assert(Eq "/boot/shrine/verdict/accepted"
    (Hd (commit-notes [[cq ("/boot/shrine_types/note/poke" (msing nslot (pt "changed")))]] 0 cs1)))
  (print "normalized contracts and initialization passed")

  ;;; The commit boundary accepts notes and rejects unresolved commands by type.
  (define (fate-source write)
    (strcat ["- lain_poke" 10 "+  proof" 10 "  ^  fate" 10 "  (fate [[[] " write "]] [])" 10]))
  (define (compile-fate write)
    (foil:perc-subject (_1 (source:compile-rex 0 "fate-boundary-check" (rex:ParseRexNorm (fate-source write))))))
  assert(Eq "/boot/lain_types/fate" (Hd (foil:source-entry-val ["proof"] (compile-fate ".cull"))))
  assert(Eq 1 (Hd (Try (lambda (z)
    (DeepSeq (compile-fate "(writ/warp [] myth/new)") 1)) 0)))
  (print "fate type boundary passed")

  1)
assert(Equal 1 (check 0))
