(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; json.foil: decode/encode round-trips.  Expected strings are
;;; host-built (strcat can hold quote and backslash bytes; foil cord
;;; literals cannot).  json imports nothing, so it compiles standalone
;;; against the default subject.

(define r (foil:compile-mod-cached 0 foil:default-subject "json"))
(define json-sut (_1 r))
(define (jf path) (foil:source-entry-val path json-sut))

(define rt (jf ["rt"]))
(define q 34)
(define bs 92)

;; scalars and arrays
assert(Equal "[1,2,3]" (rt "[ 1 , 2 , 3 ]"))
assert(Equal "null" (rt "  null  "))
assert(Equal "[true,false,[-5],[]]" (rt "[true, false, [-5], []]"))
assert(Equal "-0" (rt "-0"))
assert(Equal "1234567890123456789012345678901234567890"
  (rt "1234567890123456789012345678901234567890"))

;; objects: order and duplicates preserved
(define obj1 (strcat ["{ " q "a" q " : 1 , " q "b" q " : [ true ] }"]))
assert(Equal (strcat ["{" q "a" q ":1," q "b" q ":[true]}"]) (rt obj1))
(define obj2 (strcat ["{" q "k" q ":{}}"]))
assert(Equal obj2 (rt obj2))

;; string escapes round-trip
(define sn (strcat ["[" q "x" bs "n" q "]"]))
assert(Equal sn (rt sn))
;; A decodes to A and re-encodes bare
assert(Equal (strcat [q "A" q]) (rt (strcat [q bs "u0041" q])))
;; surrogate pair: 😀 = U+1F600, four UTF-8 bytes
assert(Equal (strcat [q 240 159 152 128 q])
  (rt (strcat [q bs "uD83D" 92 "uDE00" q])))
;; control byte in a decoded string re-escapes as \u00XX
assert(Equal (strcat [q bs "u0001" q]) (rt (strcat [q bs "u0001" q])))

;; non-integral numbers keep their source lexeme (json/real): no float
;; codec is invented, and the spelling survives the round trip exactly
assert(Equal "3.14" (rt "3.14"))
assert(Equal "1e9" (rt "1e9"))
assert(Equal "-0.125" (rt "-0.125"))
assert(Equal "6.02e23" (rt "6.02e23"))
assert(Equal "1e-5" (rt "1e-5"))
assert(Equal "1E+5" (rt "1E+5"))
assert(Equal "[1.5,2,-3.25]" (rt "[1.5, 2, -3.25]"))
;; integers stay exact json/num, and keep printing as integers
assert(Equal "12" (rt "12"))
assert(Equal "-7" (rt "-7"))

;; failures name their why
assert(Equal "trailing-garbage" (rt "1 2"))
assert(Equal "bad-literal" (rt "nulL"))
assert(Equal "unexpected-byte" (rt ","))
assert(Equal "expected-comma-or-bracket" (rt "[1"))
assert(Equal "unterminated-string" (rt (strcat [q "abc"])))
assert(Equal "nul-in-string" (rt (strcat [q bs "u0000" q])))
assert(Equal "lone-high-surrogate" (rt (strcat [q bs "uD83D" q])))
assert(Equal "bad-number" (rt "-"))

;;; Scanning is LINEAR, not quadratic.
;;;
;;; The parser used to consume a cord by dividing the whole remaining
;;; string once per byte, so it cost the square of the document; it
;;; now holds the text still and threads a byte offset (sept's /cord).
;;; Containers are gathered on a list and materialized once, because
;;; row/snoc reallocates per element and was the same bug wearing a
;;; different hat.
;;;
;;; This is a tripwire in the style of plan/inline-bench: the input
;;; below is simply unreachable if either quadratic comes back.  At
;;; the old asymptotics a 256KB array took over a minute; a 1.7MB
;;; document never finished at all.

(define (grow s k) (If (Eq k 0) s (grow (strWeld s s) (Dec k))))
;; "[1,1,...,1]" — 2^16+1 elements, 128KB
(define big-arr (strcat ["[" (grow "1," 16) "1]"]))
assert(Eq 131075 (Bytes big-arr))
assert(Equal big-arr (rt big-arr))

;; a long string body: run-at-a-time copying, not byte-at-a-time
(define big-str (strcat [q (grow "abcdefgh" 12) q]))
assert(Eq 32770 (Bytes big-str))
assert(Equal big-str (rt big-str))

;; deep-ish nesting still round-trips
assert(Equal "[[[[[1]]]]]" (rt "[ [ [ [ [ 1 ] ] ] ] ]"))

(print "foil-json tests passed")
