(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; apps/life/main.foil: a real neutral Life Plate and two terminal
;;; pronunciations.  This suite compiles directly and never touches the
;;; shared staged snapshot.

(define sut (foil:compile-mod foil:default-subject "apps/life/main"))
(define (life path) (foil:source-entry-val path sut))
(define (ts s) ("ts" s))

(define board-put (life ["board_put"]))
(define board-seed (life ["board_seed"]))
(define glider (life ["glider"]))
(define show-cells (life ["show_cells"]))
(define plate-tree (life ["life_plate_tree"]))
(define plate-web (life ["life_plate_web"]))
(define plate-text (life ["life_plate_text"]))
(define old-web (life ["board_html"]))
(define valid-tree (life ["surface_tree" "valid"]))
(define record-at (life ["surface_tree" "record_at"]))
(define role-of (life ["surface_tree" "role_of"]))
(define source-of (life ["surface_tree" "source_of"]))
(define action-of (life ["surface_tree" "action_of"]))
(define nat-at (life ["myth" "nat_at"]))
(define txt-at (life ["myth" "txt_at"]))
(define pail-at (life ["myth" "pail_at"]))
(define has-at (life ["myth" "has_at"]))
(define as-node (life ["frag" "as_node"]))
(define render (life ["weft" "render"]))
(define zoo-path-at (life ["zoo" "path_at"]))

(define root-path (life ["life_root_path"]))
(define board-path (life ["life_board_path"]))
(define plate-path (life ["life_plate_recipe_path"]))
(define web-path (life ["life_web_recipe_path"]))
(define text-path (life ["life_text_recipe_path"]))
(define plate-report (life ["life_plate_report_path"]))
(define web-report (life ["life_web_report_path"]))
(define text-report (life ["life_text_report_path"]))
(define plate-role (life ["life_plate_role"]))
(define pronunciation-role (life ["life_pronunciation_role"]))
(define cells-role (life ["life_cells_role"]))
(define population-role (life ["life_population_role"]))
(define generation-role (life ["life_generation_role"]))
(define tick-role (life ["life_tick_role"]))

;;; Absolute occurrence, recipe, and nested report helpers ;;;;;;;;;;;;;;;;;;;;;;

(define app-life [(ts "app") (ts "life")])
(define board [(ts "app") (ts "life") (ts "board")])
(define plate-recipe
  [(ts "app") (ts "life") (ts "weft") (ts "foundry") (ts "plate")])
(define web-recipe
  [(ts "app") (ts "life") (ts "weft") (ts "foundry") (ts "web")])
(define text-recipe
  [(ts "app") (ts "life") (ts "weft") (ts "foundry") (ts "text")])

assert(Equal app-life root-path)
assert(Equal board board-path)
assert(Equal plate-recipe plate-path)
assert(Equal web-recipe web-path)
assert(Equal text-recipe text-path)

(define expected-plate
  [(ts "o") ("u" 1) ("u" 5)
   (ts "app") (ts "life") (ts "weft") (ts "foundry") (ts "plate")
   ("u" 3) (ts "app") (ts "life") (ts "board")])
assert(Equal expected-plate plate-report)
assert(Equal web-report
  ((life ["foundry" "chain"]) [plate-recipe web-recipe] board))
assert(Equal text-report
  ((life ["foundry" "chain"]) [plate-recipe text-recipe] board))

;;; Neutral Plate anatomy and semantic values ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define source (board-put board-seed glider 7))
(define tree (plate-tree source))
assert(Eq 1 (valid-tree tree))

(define root (_0 (_0 tree)))
(define cells (_0 (record-at [(ts "cells")] tree)))
(define pop (_0 (record-at [(ts "population")] tree)))
(define gen (_0 (record-at [(ts "generation")] tree)))
(define action (_0 (record-at [(ts "action")] tree)))

assert(Equal ("/boot/maybe/some" plate-role) (role-of root))
assert(Equal ("/boot/maybe/some" board) (source-of root))
assert(Equal ("/boot/maybe/some" board) (action-of root))
assert(Equal ("/boot/maybe/some" cells-role) (role-of cells))
assert(Equal ("/boot/maybe/some" population-role) (role-of pop))
assert(Equal ("/boot/maybe/some" generation-role) (role-of gen))
assert(Equal ("/boot/maybe/some" tick-role) (role-of action))
assert(Equal ("/boot/maybe/some" board) (action-of action))
assert(Eq glider (nat-at [(ts "life") (ts "value")] 0 cells))
assert(Eq 5 (nat-at [(ts "life") (ts "value")] 0 pop))
assert(Eq 7 (nat-at [(ts "life") (ts "value")] 0 gen))

;; Explicit semantic refs ride the root; renderer payloads do not.
assert(Equal cells-role
  (_0 (pail-at [(ts "life") (ts "ref") (ts "cells")] root)))
assert(Equal population-role
  (_0 (pail-at [(ts "life") (ts "ref") (ts "population")] root)))
assert(Equal generation-role
  (_0 (pail-at [(ts "life") (ts "ref") (ts "generation")] root)))
assert(Equal tick-role
  (_0 (pail-at [(ts "life") (ts "ref") (ts "action")] root)))
assert(Eq 0 (has-at [(ts "html")] root))
assert(Eq 0 (has-at [(ts "css")] root))
assert(Eq 0 (has-at [(ts "projection") (ts "backend")] root))

;;; Web and terminal-text pronunciations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define web-out (plate-web tree))
(define old-out (old-web source))
(define web-node (_0 (as-node (pail-at [(ts "html")] web-out))))
(define old-node (_0 (as-node (pail-at [(ts "html")] old-out))))

;; The new terminal adapter preserves the legacy component byte-for-byte.
assert(Equal (render old-node) (render web-node))
assert(Equal
  (strcat ["<div><div class=" 34 "muted" 34 ">gen 7 · pop 5</div><pre>"
           (show-cells glider) "</pre></div>"])
  (render web-node))

(define text-out (plate-text tree))
(define expected-text
  (strcat ["gen 7 · pop 5" 10 (show-cells glider)]))
assert(Equal expected-text (txt-at [(ts "text")] text-out))
assert(Eq 0 (has-at [(ts "html")] text-out))

;;; Metadata-bearing Zoo recipes and manifest registration ;;;;;;;;;;;;;;;;;;;;;

(define plate-card (life ["life_plate_card"]))
(define web-card (life ["life_web_card"]))
(define text-card (life ["life_text_card"]))

assert(Equal plate-role
  (zoo-path-at [(ts "recipe") (ts "role")] plate-card))
assert(Equal "neutral" (txt-at [(ts "recipe") (ts "renderer")] plate-card))
assert(Equal "surface-tree" (txt-at [(ts "recipe") (ts "output")] plate-card))
assert(Equal pronunciation-role
  (zoo-path-at [(ts "recipe") (ts "role")] web-card))
assert(Equal "web" (txt-at [(ts "recipe") (ts "renderer")] web-card))
assert(Equal "shrine" (txt-at [(ts "recipe") (ts "pronunciation")] web-card))
assert(Equal pronunciation-role
  (zoo-path-at [(ts "recipe") (ts "role")] text-card))
assert(Equal "text" (txt-at [(ts "recipe") (ts "renderer")] text-card))
assert(Equal "plain" (txt-at [(ts "recipe") (ts "pronunciation")] text-card))

(define seeds (Ix 3 (life ["app"])))
assert(Eq 1 (includes (lambda (e)
  (Equal [(ts "weft") (ts "foundry") (ts "plate")] (_0 e))) seeds))
assert(Eq 1 (includes (lambda (e)
  (Equal [(ts "weft") (ts "foundry") (ts "web")] (_0 e))) seeds))
assert(Eq 1 (includes (lambda (e)
  (Equal [(ts "weft") (ts "foundry") (ts "text")] (_0 e))) seeds))

(print "life foundry tests passed")
