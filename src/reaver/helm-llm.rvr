;;;; The OpenRouter client, generated at boot from the spec.
;;;;
;;;; schemagen turns src/spec/openrouter.json into two modules — the
;;;; types (with their JSON serde) and the HAND, a shrine behavior
;;;; whose take fires a fetch for each request kid and whose hear
;;;; parses the answer back into bond/res.  Neither has a file on
;;;; disk: they are tree-fed straight to the compiler, so every later
;;;; compile that imports them BY NAME — the chat app — must share the
;;;; cache this returns.  That by-name resolution off a shared cache is
;;;; exactly what foil:compile-rex-cached exists for.
;;;;
;;;; The schema is the source of truth.  There is no generated source
;;;; file to edit, and no printer that would produce one.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

(#bind schemagen (#module schemagen))

;; The operations the chat app uses, and ONLY those.  A slice, not the
;; whole document: all 89 operations generate ~2100 top-levels and a
;; module load forces every one of them.  These two cost 152 schemas
;; between them, and share nothing — model metadata and chat traffic
;; are separate type families.
(define llm-ops ["get_models" "send_chat_completion_request"])

(define llm-spec-path "spec/openrouter.json")

;; The json subject the schema parser itself runs on.
(define (llm-jsut z)
  (foil:compile-rex foil:default-subject "json"
    (rex:ParseRexNormFile (foil:get-foil "json"))))

;; Generate the client into cache: the types module first, then the
;; hand against a cache already holding it (the hand imports the types
;; by name, and a tree-fed module has no file to re-read).  The spec is
;; parsed ONCE and both trees derive from the same parts — re-deriving
;; would re-parse 1.6MB.
;; -> [cache' types-name hand-name hand-subject]
(define (llm-client-cache cache)
  (define jsut (llm-jsut 0))
  (define sv (schemagen:sg-schema-value jsut (read-text-file llm-spec-path)))
  (define parts (schemagen:sg-spec-parts sv llm-ops))
  (define tname (_0 parts))
  (define tnt (schemagen:sg-swagger-types-tree parts))
  (define c1 (foil:compile-rex-cached cache foil:default-subject tname (_1 tnt)))
  (define hnt (schemagen:sg-swagger-hand-tree parts))
  (define c2
    (foil:compile-rex-cached (_0 c1) foil:default-subject (_0 hnt) (_1 hnt)))
  (Seq (Trace ["llm-client generated" tname (_0 hnt)] 0)
    [(_0 c2) tname (_0 hnt) (_1 c2)]))

;; The generated behavior itself.  The app does NOT carry this form:
;; an app manifest is stored whole on the app card and re-expanded on
;; every remount, and this form's closure is the entire compiled
;; client (190 types plus their serde).  The host registers it once in
;; the kernel's own behavior registry instead, and the app's node
;; refers to it by path — the same arrangement the kernel uses for its
;; own behaviors (lainapp's kern_tasks).
(define (llm-serve-form lc)
  (foil:source-entry-val ["serve"] (Ix 3 lc)))
