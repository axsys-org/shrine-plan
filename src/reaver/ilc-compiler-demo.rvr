;; Run with: x/check ilc-compiler-tests
(#bind std (#module std))
(#import std)
(#bind inc (#module ilc-compiler))
(#bind fixture (#module ilc-compiler-fixture))
(#bind driver (#module foil-new-env))
(#bind pe (#module pe))

(define (walkthrough ignored)
  ;; The fixture supplies explicit publication assignments. A real editor
  ;; supplies its selected context instead; the compiler cannot invent it.
  (define cfg (fixture:config ["model" "app" "other"] ["app" "other"]))
  (define sources (inc:from-texts
    [["model" "+ value 10
"] ["app" "- model [at=m]
+ value (add m/value 32)
"] ["other" "+ value 99
"]]))
  (define retained (inc:specialize cfg sources))
  (define (answer cache) (driver:get-perc ["value"] (inc:artifact cache "app")))
  assert(Equal 42 (answer retained))
  (print ["initial answer, compiler statistics" (answer retained) (inc:stats retained)])

  ;; Capture the fixed configuration AND retained compilation. This residual
  ;; has the desired interface: g(source-delta) -> next retained compilation.
  (define g (pe:partial-eval (inc:update cfg retained)))
  assert(Equal 1 (Arity g))
  (define changed (g (inc:change [(inc:text-diff "model" 8 2 "11")])))
  assert(Equal 43 (answer changed))
  assert(Equal [2 1 0] (inc:stats changed))
  (print ["after text_diff: model and app rebuilt, other reused"
    (answer changed) (inc:stats changed)])

  ;; Capture the NEW retained compilation before accepting another relative
  ;; delta. Undo finds all original artifacts in explicit history.
  (define g2 (pe:partial-eval (inc:update cfg changed)))
  (define restored (g2 (inc:change [(inc:text-diff "model" 8 2 "10")])))
  assert(Equal 42 (answer restored))
  assert(Equal [0 3 0] (inc:stats restored))
  (print ["undo: three artifact hits, no compiler invocations" (inc:stats restored)])
  1)
assert(walkthrough 0)
