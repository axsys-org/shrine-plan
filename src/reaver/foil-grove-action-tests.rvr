(#bind grove_fixture (#module foil-grove-fixture))
(#bind abi (#module foil-abi))
;;;; Checked action synthesis against the real SRS prefix.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["action-build" result])))
(define (check local)
  (define code (_1 local))
  (define prepared (backend:prepare code))
  (define policy (_1 prepared))
  (define helpers (grove_fixture:module code "tests/grove_backend"))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing key) (grove_fixture:lookup local [] key))
  (define (compile lookup root text)
    (backend:compile prepared grove_fixture:previous lookup (grove_fixture:qualified (path root)) (parse text)))
  (define types (ok (compile missing ["lib" "grove" "types"]
    (read-text-file "grove/value_codecs.grove"))))
  (define lookup (grove_fixture:lookup local types))
  (define srs (parse (read-text-file "grove/srs.grove")))
  (define records (ok (backend:compile prepared grove_fixture:previous lookup (grove_fixture:qualified (grove_fixture:qualified (path ["gov" "srs"]))) ((helper "first") 6 srs))))
  assert(Gt (Sz records) 6)
  (define stored (grove_fixture:lookup local records))
  (define values (ok (compile stored ["test" "grades"]
    "#import grade=gov/srs/grade

values =
  ! foil
  + again
    ^ pail
    | grade/write .again
  + hard
    ^ pail
    | grade/write .hard
  + good
    ^ pail
    | grade/write .good
  + easy
    ^ pail
    | grade/write .easy
")))
  (define grade (grove_fixture:record local values (path ["test" "grades" "values"])))
  (define action (grove_fixture:record local records (grove_fixture:qualified (path ["gov" "srs" "finish"]))))
  (define (export rec key) ((helper "export") (path [key]) rec))
  assert(Equal (map (lambda (p) (grove_fixture:qualified (path p))) [["gov" "srs" "recall"]
    ["gov" "srs" "grade"] ["sys" "now"]])
    ((helper "action_summary") action))
  (define apply (export action "apply"))
  (define base ((helper "role_data") 7
    ((helper "recall_data") 100 8)))
  (define (args name)
    ((helper "action_args") (export grade name) 200))
  (define (expect name interval)
    (define result (apply (args name) base))
    (define expected ((helper "role_data") 7
      ((helper "recall_data") (Add 200 interval) interval)))
    (If (Equal ((abi:option policy "some") expected) result) 0
      (error ["outcome" name (export grade name) result expected]))
    1)
  assert(Eq 1 (expect "again" 1))
  assert(Eq 1 (expect "hard" 10))
  assert(Eq 1 (expect "good" 16))
  assert(Eq 1 (expect "easy" 24))
  (define good (args "good"))
  assert(Equal (abi:option policy "none")
    (apply good (abi:constructor policy ["mop" "empty"])))
  (define (bad mode)
    assert(Equal (abi:option policy "none")
      (apply ((helper "invalid_args") mode good) base))
    1)
  assert(Equal [1 1 1 1] (map bad [0 1 2 3]))
  ;; Import the stored action without its source or original cache.
  (define fresh (backend:prepare code))
  (define forwarded (ok (backend:compile fresh grove_fixture:previous stored (grove_fixture:qualified (grove_fixture:qualified (path ["gov" "forward"]))) (parse "#import action=gov/srs/finish

forward =
  ! foil
  + apply action/apply
"))))
  assert(Equal (apply good base)
    ((export (grove_fixture:record local forwarded (grove_fixture:qualified (path ["gov" "forward" "forward"]))) "apply") good base))

  ;; Imported receivers and zero-argument actions still validate output.
  (define clear (ok (backend:compile fresh grove_fixture:previous stored (grove_fixture:qualified (grove_fixture:qualified (path ["gov" "clear"]))) (parse "#import role=gov/srs/card

clear =
  @action
  #on ; %/role
  ! foil
  \ value=role
  ^ role
  value.set_req(.none).set_about(.none)
"))))
  assert(Equal [(grove_fixture:qualified (path ["gov" "srs" "card"]))]
    ((helper "action_summary") (grove_fixture:record local clear (grove_fixture:qualified (path ["gov" "clear" "clear"])))))
  assert(Equal (abi:option policy "none")
    ((export (grove_fixture:record local clear (grove_fixture:qualified (path ["gov" "clear" "clear"]))) "apply") good
      ((helper "req_data") base)))

  (define (reject text)
    (define result (backend:compile prepared grove_fixture:previous stored (grove_fixture:qualified (grove_fixture:qualified (path ["gov" "bad"]))) (parse text)))
    assert(Equal "err" (Hd result))
    assert(Gt (_0 (_0 (_0 result))) 0)
    1)
  assert(Eq 1 (reject "bad =
  @action
"))
  assert(Eq 1 (reject "bad =
  @action
  #on ; unknown
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #on ; role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #opt ;
    x: role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  x: role
  x: role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  ! foil
  \ value=role
  ^ nat
  0
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  x: role
  ! foil
  \ x=nat value=role
  ^ role
  value
"))
  assert(Eq 1 (reject "#import grade=gov/srs/grade

bad =
  @action
  #on ; grade
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #meta ;
    /0x11/lib/publisher_vocabulary/publisher_vocabulary/grove/action: (pails/n 1)
  ! foil
  \ value=role
  ^ role
  value
"))
  1)


;; Execute after module loading; evaluation must not mutate cached fixture pins.
(#export check)
