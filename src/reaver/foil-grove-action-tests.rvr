;;;; Checked action synthesis against the real SRS prefix.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["action-build" result])))
(define (check ignored)
  (define prepared (backend:prepare 0))
  (define policy (_1 prepared))
  (define helpers (_1 (source:compile (_0 prepared)
    "tests/grove_backend")))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing key) "/boot/maybe/none")
  (define (compile lookup root text)
    (backend:compile prepared lookup (path root) (parse text)))
  (define slots (ok (compile missing ["sys"]
    (read-text-file "grove/sys_slots.grove"))))
  (define types (ok (compile missing ["sys" "types"]
    (read-text-file "grove/sys_types.grove"))))
  (define lookup ((helper "lookup") (Weld slots types)))
  (define srs (parse (read-text-file "grove/srs.grove")))
  (define records (ok (backend:compile prepared lookup
    (path ["gov" "srs"]) ((helper "first") 6 srs))))
  assert(Eq 6 (Sz records))
  (define stored ((helper "lookup") records))
  (define values (ok (compile stored ["test" "grades"]
    "#import grade=gov/srs/grade

values =
  ! foil
  + again
    ^ pail
    | grade/write .again
  + hard
    ^ pail
    | grade/write .hard
  + good
    ^ pail
    | grade/write .good
  + easy
    ^ pail
    | grade/write .easy
")))
  (define grade (_1 (_0 values)))
  (define action (_1 (Ix 5 records)))
  (define (export rec key) ((helper "export") (path [key]) rec))
  assert(Equal (map path [["gov" "srs" "recall"]
    ["gov" "srs" "grade"] ["sys" "now"]])
    ((helper "action_summary") action))
  (define apply (export action "apply"))
  (define base ((helper "role_data") 7
    ((helper "recall_data") 100 8)))
  (define (args name)
    ((helper "action_args") (export grade name) 200))
  (define (expect name interval)
    (define result (apply (args name) base))
    (define expected ((helper "role_data") 7
      ((helper "recall_data") (Add 200 interval) interval)))
    (If (Equal ("/boot/maybe/some" expected) result) 0
      (error ["outcome" name (export grade name) result expected]))
    1)
  assert(Eq 1 (expect "again" 1))
  assert(Eq 1 (expect "hard" 10))
  assert(Eq 1 (expect "good" 16))
  assert(Eq 1 (expect "easy" 24))
  (define good (args "good"))
  assert(Equal "/boot/maybe/none"
    (apply good "/boot/sept/mop/empty"))
  (define (bad mode)
    assert(Equal "/boot/maybe/none"
      (apply ((helper "invalid_args") mode good) base))
    1)
  assert(Equal [1 1 1 1] (map bad [0 1 2 3]))
  ;; Import the stored action without its source or original cache.
  (define fresh (backend:prepare 0))
  (define forwarded (ok (backend:compile fresh stored
    (path ["gov" "forward"])
    (parse "#import action=gov/srs/finish

forward =
  ! foil
  + apply action/apply
"))))
  assert(Equal (apply good base)
    ((export (_1 (_0 forwarded)) "apply") good base))

  ;; Imported receivers and zero-argument actions still validate output.
  (define clear (ok (backend:compile fresh stored
    (path ["gov" "clear"])
    (parse "#import role=gov/srs/card

clear =
  @action
  #on ; %/role
  ! foil
  \ value=role
  ^ role
  value.set_req(.none).set_about(.none)
"))))
  assert(Equal [(path ["gov" "srs" "card"])]
    ((helper "action_summary") (_1 (_0 clear))))
  assert(Equal "/boot/maybe/none"
    ((export (_1 (_0 clear)) "apply") good
      ((helper "req_data") base)))

  (define (reject text)
    (define result (backend:compile prepared stored
      (path ["gov" "bad"]) (parse text)))
    assert(Equal "err" (Hd result))
    assert(Gt (_0 (_0 (_0 result))) 0)
    1)
  assert(Eq 1 (reject "bad =
  @action
"))
  assert(Eq 1 (reject "bad =
  @action
  #on ; unknown
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #on ; role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #opt ;
    x: role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  x: role
  x: role
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  ! foil
  \ value=role
  ^ nat
  0
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  x: role
  ! foil
  \ x=nat value=role
  ^ role
  value
"))
  assert(Eq 1 (reject "#import grade=gov/srs/grade

bad =
  @action
  #on ; grade
"))
  assert(Eq 1 (reject "#import role=gov/srs/recall

bad =
  @action
  #on ; role
  #meta ;
    /sys/grove/action: (pails/n 1)
  ! foil
  \ value=role
  ^ role
  value
"))
  1)
assert(Eq 1 (check 0))
