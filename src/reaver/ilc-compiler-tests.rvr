(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind inc (#module ilc-compiler))
(#bind fixture (#module ilc-compiler-fixture))
(#bind driver (#module foil-new-env))
(#bind context (#module foil-context))
(#bind ca (#module cairn))
(#bind bst (#module bst))
(#bind rx (#module rex-build))
(#bind ilc (#module ilc))

(define (check ignored)
  (define cfg (fixture:config ["leaf" "left" "right" "main" "extra"] ["main"]))
  (define forest (inc:from-texts
    [["leaf" "+ value 3
"]
     ["left" "- leaf [at=dep]
+ value (add dep/value 1)
"]
     ["right" "+ value 40
"]
     ["main" "- left [at=l]
- right [at=r]
+ value (add l/value r/value)
"]
     ["extra" "+ value 100
"]]))
  (define old (inc:specialize cfg forest))
  (define (value cache) (driver:get-perc ["value"] (inc:artifact cache "main")))
  (define (agrees cache)
    (And (Equal (_1 cache) (_1 (inc:specialize cfg (inc:sources cache))))
      (Equal (fixture:values (_1 cache) ["main" "leaf" "left" "right"])
        (fixture:values (inc:production cfg (inc:sources cache)) ["main" "leaf" "left" "right"]))))
  assert(Equal 44 (value old))
  assert(Equal [4 0 0] (inc:stats old))
  assert(agrees old)
  (define edit (inc:text-diff "leaf" 8 1 "4"))
  (define changed (inc:update cfg old (inc:change [edit])))
  assert(Equal 45 (value changed))
  assert(Equal [3 1 0] (inc:stats changed))
  assert(agrees changed)
  assert(Equal (inc:artifact old "right") (inc:artifact changed "right"))
  (define undo (inc:update cfg changed (inc:change [(inc:text-diff "leaf" 8 1 "3")])))
  assert(Equal [0 4 0] (inc:stats undo))
  assert(Equal (_1 old) (_1 undo))
  assert(Equal old (inc:update cfg old 0))
  ;; A shared dependency is compiled once, but both arms of the diamond
  ;; invalidate when it changes. No old completed-node table leaks across edits.
  (define diamond (inc:update cfg old (inc:change
    [["set-text" "right" "- leaf [at=dep]
+ value (add dep/value 40)
"]])))
  (define diamond-next (inc:update cfg diamond (inc:change [edit])))
  assert(Equal [4 0 0] (inc:stats diamond-next))
  assert(Equal 49 (value diamond-next))
  assert(agrees diamond-next)
  ;; Two sequential splices in one document are parsed after the batch.
  (define coalesced (inc:update cfg old (inc:change
    [(inc:text-diff "leaf" 8 1 "") (inc:text-diff "leaf" 8 0 "5")])))
  assert(Equal 46 (value coalesced))
  assert(agrees coalesced)
  ;; A Rex path addresses child indices. Structural editing retains supplied
  ;; spans but invalidates the text buffer, rather than leaving stale offsets.
  (define tree (rx:nrn "+" [(rx:nw "value") (rx:nw "6")]))
  (define structural (inc:update cfg old (inc:change [["set-rex" "leaf" tree]])))
  (define structural2 (inc:update cfg structural
    (inc:change [(inc:rex-diff "leaf" [1] (rx:nw "7"))])))
  assert(Equal 48 (value structural2))
  assert(agrees structural2)
  assert(Equal 1 (Hd (Try (lambda (z) (DeepSeq
    (inc:update cfg structural2 (inc:change [edit])) 0)) 0)))
  ;; Import edits change the dependency graph; an old parent's syntax alone
  ;; is insufficient as a cache key. New imports and mounted names are honored.
  (define redirected (inc:update cfg old (inc:change
    [["set-text" "left" "- extra [at=dep]
+ value (add dep/value 1)
"]])))
  assert(Equal 141 (value redirected))
  assert(Equal [3 1 0] (inc:stats redirected))
  assert(Equal [141] (fixture:values (inc:production cfg (inc:sources redirected)) ["main"]))
  ;; Failures publish no partial cache. The same previous cache can recover.
  (define (fails edits)
    (Equal 1 (Hd (Try (lambda (z) (DeepSeq (inc:update cfg old (inc:change edits)) 0)) 0))))
  assert(fails [["delete" "leaf"]])
  assert(fails [["set-text" "leaf" "- main
+ value 3
"]])
  assert(fails [["set-text" "leaf" "+ value missing
"]])
  assert(fails [(inc:text-diff "leaf" 999 1 "x")])
  assert(fails [(inc:rex-diff "leaf" [999] (rx:nw "8"))])
  assert(Equal 45 (value (inc:update cfg old (inc:change [edit]))))
  ;; A cold fallback has the same artifact identity and output.
  assert(Equal (_1 changed) (_1 (inc:update cfg old
    (ilc:replace-change (inc:sources changed)))))
  (define delta (inc:d-specialize cfg (error "recomputed old compiler input") (inc:change [edit])))
  assert(Equal (_1 changed) (_1 (ilc:apply-change old delta)))
  ;; Cache scope includes compiler/publication/owner and all selected moments.
  (define other-cfg (Up 0 (Up 1 (Pin "different compiler revision") (_0 cfg)) cfg))
  (define other (inc:update other-cfg old (inc:change [edit])))
  assert(Equal [4 0 0] (inc:stats other))
  (define tiny (Up 2 0 cfg))
  assert(Equal [4 0 0] (inc:stats (inc:update tiny (inc:specialize tiny forest) (inc:change [edit]))))
  ;; Installed artifacts have the same precedence as in the production
  ;; resolver. Editing masked source cannot replace an installed dependency.
  (define installed-cfg (Up 0 (Up 5
    (ca:putax ["leaf"] (Pin (inc:artifact old "leaf")) ca:empty-ax) (_0 cfg)) cfg))
  (define installed (inc:specialize installed-cfg (inc:sources changed)))
  assert(Equal [3 0 1] (inc:stats installed))
  assert(Equal 44 (value installed))
  assert(Equal [44] (fixture:values (inc:production installed-cfg (inc:sources changed)) ["main"]))
  ;; Definition moments are inputs, not something source hashes may invent.
  (define nominal-forest (inc:from-texts
    [["box" "+ token (: payload=nat)
+ value (token 7)
"] ["use" "- box
+ value (token 9)
"]]))
  (define (nominal-config revision)
    (inc:config (context:create fixture:native-selection (Pin "nominal-test") (Pin 0)
      [["box" (fixture:root "box")] ["use" (fixture:root "use")]]
      [["box" [[(snoc ["ts" "token"] (fixture:root "box")) revision]]] ["use" []]] []) ["use"] 1024))
  (define nominal-old (inc:specialize (nominal-config 1) nominal-forest))
  (define nominal-new (inc:update (nominal-config 2) nominal-old (inc:change
    [["set-text" "use" "- box
+ value (token 9)
"]])))
  (define (boxed c) (driver:get-perc ["value"] (inc:artifact c "use")))
  assert(Equal [2 0 0] (inc:stats nominal-new))
  assert(Nil (Equal (Hd (boxed nominal-old)) (Hd (boxed nominal-new))))
  assert(Equal 9 (_0 (boxed nominal-new)))
  assert(Equal [(boxed nominal-new)]
    (fixture:values (inc:production (nominal-config 2) (inc:sources nominal-new)) ["use"]))
  (print "incremental Foil compiler agrees with cold compilation and production")
  1)
assert(check 0)
