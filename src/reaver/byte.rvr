(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bst (#module bst))

;;; Symbolic er_op bytecode compiler.
;;;
;;; This module models the er_law_compile output as ordinary Reaver values:
;;;
;;;   ("byte-law" name body arity let_d bc_s labels)
;;;
;;; labels is a dense row indexed by label number.  Each label entry is a row of
;;; symbolic op values.

(define BYTE_U32_MAX 4294967295)

(define (byte-u32! ctx n)
  (If (Le n BYTE_U32_MAX) n (error ("byte-u32-overflow" ctx n))))

(define OP_PUSH_VAR_TAG 0)
(define OP_PUSH_LIT_TAG 1)
(define OP_MK_APP_TAG 2)
(define OP_CALLF_TAG 3)
(define OP_CALLS_TAG 4)
(define OP_PUSH_SELF_TAG 5)
(define OP_EVAL_TAG 6)
(define OP_TAIL_EVAL_TAG 7)
(define OP_FORCE_TAG 8)
(define OP_DROP_TAG 9)
(define OP_ROTATE_TAG 10)
(define OP_JMP_TAG 11)
(define OP_JUMP_IF_TAG 12)
(define OP_ADD_NAT_TAG 13)
(define OP_PIN_TAG 14)
(define OP_LAW_TAG 15)
(define OP_ELIM_TAG 16)
(define OP_INC_TAG 17)
(define OP_DEC_TAG 18)
(define OP_NAM_TAG 19)
(define OP_BODY_TAG 20)
(define OP_NAT_TAG 21)
(define OP_ARI_TAG 22)
(define OP_UNPIN_TAG 23)
(define OP_SZ_TAG 24)
(define OP_LAST_TAG 25)
(define OP_INIT_TAG 26)
(define OP_ADD_TAG 27)
(define OP_SUB_TAG 28)
(define OP_RSH_TAG 29)
(define OP_LSH_TAG 30)
(define OP_DIV_TAG 31)
(define OP_MUL_TAG 32)
(define OP_MOD_TAG 33)
(define OP_TEST_TAG 34)
(define OP_LOADN_TAG 35)
(define OP_LOAD_TAG 36)
(define OP_STOREN_TAG 37)
(define OP_STORE_TAG 38)
(define OP_TRUNCN_TAG 39)
(define OP_TRUNC_TAG 40)
(define OP_MET_TAG 41)
(define OP_MET_DYN_TAG 42)
(define OP_BEX_TAG 43)
(define OP_BITS_TAG 44)
(define OP_BYTES_TAG 45)
(define OP_LOAD8_TAG 46)
(define OP_STORE8_TAG 47)
(define OP_TRUNC8_TAG 48)
(define OP_TRUNC16_TAG 49)
(define OP_TRUNC32_TAG 50)
(define OP_TRUNC64_TAG 51)
(define OP_REP_TAG 52)
(define OP_SLICE_TAG 53)
(define OP_WELD_TAG 54)
(define OP_UP_TAG 55)
(define OP_COUP_TAG 56)
(define OP_HD_TAG 57)
(define OP_IX_TAG 58)
(define OP_NOT_TAG 59)
(define OP_TRU_TAG 60)
(define OP_OR_TAG 61)
(define OP_AND_TAG 62)
(define OP_EQ_TAG 63)
(define OP_LE_TAG 64)
(define OP_CMP_TAG 65)
(define OP_RET_TAG 66)
(define OP_APPLY_UNK_TAG 67)
(define OP_APPLY_FAST_TAG 68)
(define OP_MAKE_SUSP_TAG 69)
(define OP_COUNT 70)

(define (OP_PUSH_VAR slot) ("OP_PUSH_VAR" slot))
(define (OP_PUSH_LIT val) ("OP_PUSH_LIT" val))
(define (OP_MK_APP count) ("OP_MK_APP" (byte-u32! "OP_MK_APP" count)))
(define (OP_CALLF argc) ("OP_CALLF" (byte-u32! "OP_CALLF" argc)))
(define (OP_CALLS argc) ("OP_CALLS" (byte-u32! "OP_CALLS" argc)))
(define OP_PUSH_SELF ("OP_PUSH_SELF" 0))
(define OP_EVAL ("OP_EVAL" 0))
(define OP_TAIL_EVAL ("OP_TAIL_EVAL" 0))
(define OP_FORCE ("OP_FORCE" 0))
(define OP_DROP ("OP_DROP" 0))
(define (OP_ROTATE n) ("OP_ROTATE" (byte-u32! "OP_ROTATE" n)))
(define (OP_JMP label) ("OP_JMP" (byte-u32! "OP_JMP" label)))
(define (OP_JUMP_IF label) ("OP_JUMP_IF" (byte-u32! "OP_JUMP_IF" label)))
(define OP_ADD_NAT ("OP_ADD_NAT" 0))
(define OP_PIN ("OP_PIN" 0))
(define OP_LAW ("OP_LAW" 0))
(define OP_ELIM ("OP_ELIM" 0))
(define OP_INC ("OP_INC" 0))
(define OP_DEC ("OP_DEC" 0))
(define OP_NAM ("OP_NAM" 0))
(define OP_BODY ("OP_BODY" 0))
(define OP_NAT ("OP_NAT" 0))
(define OP_ARI ("OP_ARI" 0))
(define OP_UNPIN ("OP_UNPIN" 0))
(define OP_SZ ("OP_SZ" 0))
(define OP_LAST ("OP_LAST" 0))
(define OP_INIT ("OP_INIT" 0))
(define OP_ADD ("OP_ADD" 0))
(define OP_SUB ("OP_SUB" 0))
(define OP_RSH ("OP_RSH" 0))
(define OP_LSH ("OP_LSH" 0))
(define OP_DIV ("OP_DIV" 0))
(define OP_MUL ("OP_MUL" 0))
(define OP_MOD ("OP_MOD" 0))
(define OP_TEST ("OP_TEST" 0))
(define (OP_LOADN width) ("OP_LOADN" width))
(define OP_LOAD ("OP_LOAD" 0))
(define (OP_STOREN width) ("OP_STOREN" width))
(define OP_STORE ("OP_STORE" 0))
(define (OP_TRUNCN width) ("OP_TRUNCN" width))
(define OP_TRUNC ("OP_TRUNC" 0))
(define (OP_MET width) ("OP_MET" width))
(define OP_MET_DYN ("OP_MET_DYN" 0))
(define OP_BEX ("OP_BEX" 0))
(define OP_BITS ("OP_BITS" 0))
(define OP_BYTES ("OP_BYTES" 0))
(define OP_LOAD8 ("OP_LOAD8" 0))
(define OP_STORE8 ("OP_STORE8" 0))
(define OP_TRUNC8 ("OP_TRUNC8" 0))
(define OP_TRUNC16 ("OP_TRUNC16" 0))
(define OP_TRUNC32 ("OP_TRUNC32" 0))
(define OP_TRUNC64 ("OP_TRUNC64" 0))
(define OP_REP ("OP_REP" 0))
(define OP_SLICE ("OP_SLICE" 0))
(define OP_WELD ("OP_WELD" 0))
(define OP_UP ("OP_UP" 0))
(define OP_COUP ("OP_COUP" 0))
(define OP_HD ("OP_HD" 0))
(define OP_IX ("OP_IX" 0))
(define OP_NOT ("OP_NOT" 0))
(define OP_TRU ("OP_TRU" 0))
(define OP_OR ("OP_OR" 0))
(define OP_AND ("OP_AND" 0))
(define OP_EQ ("OP_EQ" 0))
(define OP_LE ("OP_LE" 0))
(define OP_CMP ("OP_CMP" 0))
(define OP_RET ("OP_RET" 0))
(define (OP_APPLY_UNK count) ("OP_APPLY_UNK" (byte-u32! "OP_APPLY_UNK" count)))
(define (OP_APPLY_FAST count) ("OP_APPLY_FAST" (byte-u32! "OP_APPLY_FAST" count)))
(define (OP_MAKE_SUSP label) ("OP_MAKE_SUSP" (byte-u32! "OP_MAKE_SUSP" label)))

(define ARG_L 0)
(define ARG_W 1)
(define ARG_N 2)

(define (prim name arity op evals)
  (If (Le arity 8)
    ("prim" name arity op evals)
    (error ("primitive-arity-too-large" name arity))))

(define (prim-name p) (_0 p))
(define (prim-arity p) (_1 p))
(define (prim-op p) (_2 p))
(define (prim-evals p) (_3 p))

(define byte-prims
  (bst:bst-gas bst:E
    [["Pin"     (prim "Pin"     1 OP_PIN      [ARG_W])]
     ["Law"     (prim "Law"     3 OP_LAW      [ARG_W ARG_W ARG_W])]
     ["Elim"    (prim "Elim"    6 OP_ELIM     [ARG_L ARG_L ARG_L ARG_L ARG_L ARG_W])]
     ["Nat"     (prim "Nat"     1 OP_NAT      [ARG_W])]
     ["Arity"   (prim "Arity"   1 OP_ARI      [ARG_W])]
     ["Name"    (prim "Name"    1 OP_NAM      [ARG_W])]
     ["Body"    (prim "Body"    1 OP_BODY     [ARG_W])]
     ["Unpin"   (prim "Unpin"   1 OP_UNPIN    [ARG_W])]
     ["Sz"      (prim "Sz"      1 OP_SZ       [ARG_W])]
     ["Last"    (prim "Last"    1 OP_LAST     [ARG_W])]
     ["Init"    (prim "Init"    1 OP_INIT     [ARG_W])]
     ["Inc"     (prim "Inc"     1 OP_INC      [ARG_W])]
     ["Dec"     (prim "Dec"     1 OP_DEC      [ARG_W])]
     ["Add"     (prim "Add"     2 OP_ADD      [ARG_W ARG_W])]
     ["Sub"     (prim "Sub"     2 OP_SUB      [ARG_W ARG_W])]
     ["Rsh"     (prim "Rsh"     2 OP_RSH      [ARG_W ARG_W])]
     ["Lsh"     (prim "Lsh"     2 OP_LSH      [ARG_W ARG_W])]
     ["Div"     (prim "Div"     2 OP_DIV      [ARG_W ARG_W])]
     ["Mul"     (prim "Mul"     2 OP_MUL      [ARG_W ARG_W])]
     ["Mod"     (prim "Mod"     2 OP_MOD      [ARG_W ARG_W])]
     ["Test"    (prim "Test"    2 OP_TEST     [ARG_W ARG_W])]
     ["LoadVar" (prim "LoadVar" 3 OP_LOAD     [ARG_W ARG_W ARG_W])]
     ["Store"   (prim "Store"   4 OP_STORE    [ARG_W ARG_W ARG_W ARG_W])]
     ["Trunc"   (prim "Trunc"   2 OP_TRUNC    [ARG_W ARG_W])]
     ["Bits"    (prim "Bits"    1 OP_BITS     [ARG_W])]
     ["Bytes"   (prim "Bytes"   1 OP_BYTES    [ARG_W])]
     ["Rep"     (prim "Rep"     3 OP_REP      [ARG_L ARG_L ARG_W])]
     ["Slice"   (prim "Slice"   3 OP_SLICE    [ARG_W ARG_W ARG_W])]
     ["Weld"    (prim "Weld"    2 OP_WELD     [ARG_W ARG_W])]
     ["Eval"    (prim "Eval"    1 OP_EVAL     [ARG_L])]
     ["Force"   (prim "Force"   1 OP_FORCE    [ARG_L])]
     ["Up"      (prim "Up"      3 OP_UP       [ARG_W ARG_L ARG_W])]
     ["Coup"    (prim "Coup"    2 OP_COUP     [ARG_L ARG_W])]
     ["Hd"      (prim "Hd"      1 OP_HD       [ARG_W])]
     ["Ix"      (prim "Ix"      2 OP_IX       [ARG_W ARG_W])]
     ["Nil"     (prim "Nil"     1 OP_NOT      [ARG_W])]
     ["Truth"   (prim "Truth"   1 OP_TRU      [ARG_W])]
     ["Or"      (prim "Or"      2 OP_OR       [ARG_W ARG_L])]
     ["And"     (prim "And"     2 OP_AND      [ARG_W ARG_L])]
     ["If"      (prim "If"      3 0           [ARG_L ARG_L ARG_L])]
     ["Ifz"     (prim "Ifz"     3 0           [ARG_L ARG_L ARG_L])]
     ["Eq"      (prim "Eq"      2 OP_EQ       [ARG_W ARG_W])]
     ["Le"      (prim "Le"      2 OP_LE       [ARG_W ARG_W])]
     ["Cmp"     (prim "Cmp"     2 OP_CMP      [ARG_W ARG_W])]]))

(define (byte-law name body arity let-d bc-s labels)
  ("byte-law" name body arity let-d bc-s labels))
(define (byte-law-name x) (_0 x))
(define (byte-law-body x) (_1 x))
(define (byte-law-arity x) (_2 x))
(define (byte-law-let-d x) (_3 x))
(define (byte-law-bc-s x) (_4 x))
(define (byte-law-labels x) (_5 x))

(define (byte-label-code labels label)
  (If (Lt label (Sz labels))
    (Ix label labels)
    (error ("bad-byte-label" label labels))))

(define (byte-app-head-cat? v n)
  (And (IsApp v) (And (IsNat (Hd v)) (Eq (Hd v) n))))

(define (law-let? body)
  (And (byte-app-head-cat? body 1) (Eq 2 (Sz body))))

(define (law-let-count body)
  (Ifz (law-let? body) 0
    (Inc (law-let-count (_1 body)))))

(define (law-let-list body)
  (Ifz (law-let? body) 0
    (0 (_0 body) (law-let-list (_1 body)))))

(define (law-let-row body)
  (define count (law-let-count body))
  (Row 0 count (law-let-list body)))

(define (drop-law-lets body)
  (Ifz (law-let? body) body (drop-law-lets (_1 body))))

(define (byte-quote v) (0 v))
(define (byte-pull-const v)
  (If (And (byte-app-head-cat? v 0) (Eq 1 (Sz v))) (_0 v) v))
(define (byte-law-var? depth v) (And (IsNat v) (lte v depth)))
(define (byte-law-call? v)
  (And (byte-app-head-cat? v 0) (Eq 2 (Sz v))))
(define (byte-law-quote? v)
  (And (byte-app-head-cat? v 0) (Eq 1 (Sz v))))

(define (byte-call-spine-inner f x)
  (If (byte-law-call? f)
    (Weld (byte-call-spine-inner (_0 f) (_1 f)) [x])
    [f x]))

(define (byte-call-spine e)
  (If (byte-law-call? e) (byte-call-spine-inner (_0 e) (_1 e)) 0))

(define (byte-lift-call f x)
  (define vals (byte-call-spine-inner f x))
  (define h (byte-pull-const (_0 vals)))
  (If (IsApp h)
    (If (And (IsNat (Hd h)) (Eq (Hd h) 0))
      vals
      (Weld (Weld [(byte-pull-const (Hd h))] (map byte-quote h)) (drop 1 vals)))
    vals))

(define (byte-local-args-list? idx xs[x rest])
  (Ifz xs 1
    (And (Eq x idx) (byte-local-args-list? (Inc idx) rest))))

(define (byte-local-args? args arity)
  (And (Eq (Sz args) arity) (byte-local-args-list? 1 (stream args))))

(define (byte-local-arg-row arity)
  (gen arity Inc))

(define (byte-route-key-if-matches key arity)
  (define found (bst:bst-search key byte-prims))
  (Ifz found 0
    (If (Eq (prim-arity (_0 found)) arity) key 0)))

(define (byte-direct-wrapper-case-a body arity)
  (define spine (byte-call-spine body))
  (define head (byte-pull-const (_0 spine)))
  (define law (If (IsPin head) (Unpin head) head))
  (define args (drop 1 spine))
  (Ifz spine 0
    (If (And (IsLaw law) (byte-local-args? args arity))
      (byte-route-key-if-matches (Name law) arity)
      0)))

(define (byte-direct-wrapper-case-b body arity)
  (define pin (byte-pull-const (_0 body)))
  (define row (_1 body))
  (define spine (byte-call-spine row))
  (define key (byte-pull-const (_0 spine)))
  (define args (drop 1 spine))
  (If (And (byte-law-call? body)
        (And (IsPin pin)
          (And (IsNat (Unpin pin))
            (And (Eq 66 (Unpin pin))
              (And spine (byte-local-args? args arity))))))
    (byte-route-key-if-matches key arity)
    0))

(define (byte-direct-primitive-wrapper body arity)
  (define key-a (byte-direct-wrapper-case-a body arity))
  (Ifz key-a (byte-direct-wrapper-case-b body arity) key-a))

(define (byte-primitive-key v)
  (define direct (byte-direct-primitive-wrapper (Body v) (Arity v)))
  (cond
    ((IsPin v) (byte-primitive-key (Unpin v)))
    ((IsLaw v) (Ifz direct (Name v) direct))
    ((And (byte-app-head-cat? v 0) (Gt (Sz v) 0))
      (byte-primitive-key (_0 v)))
    ((IsApp v) (byte-primitive-key (Hd v)))
    (else 0)))

(define (byte-primitive-for-key key)
  (bst:bst-search key byte-prims))

(define (byte-primitive-for-head v)
  (byte-primitive-for-key (byte-primitive-key v)))

(define (known arity) ("known" arity))
(define (known-arity k) (_0 k))

(define (byte-known-arity v)
  (define inner (If (IsPin v) (Unpin v) 0))
  (define app-known (byte-known-arity (Hd v)))
  (define app-left (Sub (known-arity app-known) (Sz v)))
  (cond
    ((And (IsPin v) (IsNat inner)) (known 1))
    ((And (IsPin v) (IsLaw inner)) (known (Arity inner)))
    ((IsLaw v) (known (Arity v)))
    ((And (IsApp v) app-known)
      (If (Gt (known-arity app-known) (Sz v)) (known app-left) 0))
    (else 0)))

(define (comp next labels code) ("comp" next labels code))
(define (comp-next c) (_0 c))
(define (comp-labels c) (_1 c))
(define (comp-code c) (_2 c))
(define (comp-code-set code c) (comp (comp-next c) (comp-labels c) code))
(define (comp-append code c) (comp-code-set (Weld (comp-code c) code) c))
(define (comp-append-one op c) (comp-append [op] c))
(define (comp-add-label label code c)
  (comp (comp-next c)
        (bst:bst-insert (byte-u32! "label" label) code (comp-labels c))
        (comp-code c)))
(define (comp-fresh c)
  [(comp-next c) (comp (Inc (byte-u32! "label" (comp-next c))) (comp-labels c) (comp-code c))])
(define (finish-label-code code) (Weld code [OP_RET]))

(define (byte-bst-label-code labels label)
  (define found (bst:bst-search label labels))
  (Ifz found (error ("bad-byte-label" label labels)) (_0 found)))

(define (byte-dense-labels labels count)
  (gen count (byte-bst-label-code labels)))

(define (emit-tail-eval-if tail thunk c)
  (If (And tail thunk) (comp-append-one OP_TAIL_EVAL c) c))

(define (call-builder known-fun argc tail c)
  (define fun-arity (known-arity known-fun))
  (define thunk (If (Or (Nil known-fun) (Gt argc fun-arity)) 1 0))
  (define op (If (Or (Nil known-fun) (Gt argc fun-arity))
               (OP_APPLY_UNK (Inc argc))
               (If (Lt argc fun-arity)
                 (OP_MK_APP (Inc argc))
                 (OP_CALLS argc))))
  (emit-tail-eval-if tail thunk (comp-append-one op c)))

(define (emit-rotate-repeat span count c)
  (Ifz count c
    (emit-rotate-repeat span (Dec count) (comp-append-one (OP_ROTATE span) c))))

(define (emit-arg-eval need span c)
  (define c0 (If (And (Ne need ARG_L) (Gt span 1))
               (comp-append-one (OP_ROTATE span) c)
               c))
  (define op (If (Eq need ARG_N) OP_FORCE OP_EVAL))
  (define c1 (If (Eq need ARG_L) c0 (comp-append-one op c0)))
  (If (Eq need ARG_L) c1 (emit-rotate-repeat span (Dec span) c1)))

(define (emit-primitive-arg-evals-loop evals span c)
  (Ifz evals c
    (emit-primitive-arg-evals-loop (drop 1 evals) (Dec span)
      (emit-arg-eval (_0 evals) span c))))

(define (emit-primitive-arg-evals route c)
  (emit-primitive-arg-evals-loop (prim-evals route) (prim-arity route) c))

(define COMPILE_EXPR 0)
(define COMPILE_VALUE 1)
(define COMPILE_APP_VALUE 2)

(define (compile-core mode e depth arity tail c)
  (define (as-expr x tail? acc)
    (compile-core COMPILE_EXPR x depth arity tail? acc))
  (define (as-value x acc)
    (compile-core COMPILE_VALUE x depth arity 0 acc))
  (define (as-app-value x acc)
    (compile-core COMPILE_APP_VALUE x depth arity 0 acc))
  (define (compile-value-row args acc)
    (define (go xs[x rest] st)
      (Ifz xs st (go rest (as-value x st))))
    (go (stream args) acc))
  (define (compile-app-value-row vals acc)
    (comp-append-one (OP_MK_APP (Sz vals)) (compile-value-row vals acc)))
  (define (compile-conditional route args acc)
    (define fresh[true-label c1] (comp-fresh acc))
    (define saved-code (comp-code c1))
    (define true-start (comp-code-set 0 c1))
    (define true-body (as-expr (_1 args) 1 true-start))
    (define with-true
      (comp-add-label true-label (finish-label-code (comp-code true-body))
        (comp (comp-next true-body) (comp-labels true-body) saved-code)))
    (define cond-code (as-expr (_0 args) 0 with-true))
    (define eval-code (comp-append-one OP_EVAL cond-code))
    (define test-code
      (If (Eq (prim-name route) "Ifz")
        (comp-append-one OP_NOT eval-code)
        eval-code))
    (define jump-code (comp-append-one (OP_JUMP_IF true-label) test-code))
    (as-expr (_2 args) 1 jump-code))
  (define (compile-primitive-call route head args tail? acc)
    (define argc (Sz args))
    (define primc (prim-arity route))
    (define lit (byte-pull-const head))
    (define first-args (take primc args))
    (define rest-args (drop primc args))
    (cond
      ((And tail? (And (Eq argc primc)
         (Or (Eq (prim-name route) "If") (Eq (prim-name route) "Ifz"))))
        (compile-conditional route args acc))
      ((Lt argc primc)
        (define c1 (comp-append-one (OP_PUSH_LIT lit) acc))
        (define c2 (compile-value-row args c1))
        (comp-append-one (OP_MK_APP (Inc argc)) c2))
      ((Eq argc primc)
        (define c1 (compile-value-row args acc))
        (define c2 (emit-primitive-arg-evals route c1))
        (comp-append-one (prim-op route) c2))
      (else
        (define c1 (compile-value-row first-args acc))
        (define c2 (emit-primitive-arg-evals route c1))
        (define c3 (comp-append-one (prim-op route) c2))
        (define c4 (compile-value-row rest-args c3))
        (emit-tail-eval-if tail? 1
          (comp-append-one (OP_APPLY_UNK (Inc (Sub argc primc))) c4)))))
  (define (compile-plain-call head args tail? acc)
    (define argc (Sz args))
    (define lit (byte-pull-const head))
    (define lit-is-prim-pin (And (IsPin lit) (IsNat (Unpin lit))))
    (cond
      ((And (IsNat head) (Eq head 0))
        (define c1 (comp-append-one OP_PUSH_SELF acc))
        (define c2 (compile-value-row args c1))
        (call-builder (known arity) argc tail? c2))
      ((byte-law-var? depth head)
        (define c1 (comp-append-one (OP_PUSH_VAR head) acc))
        (define c2 (compile-value-row args c1))
        (call-builder 0 argc tail? c2))
      ((And lit-is-prim-pin (Gt argc 0))
        (define c1 (comp-append-one (OP_PUSH_LIT lit) acc))
        (define c2 (as-app-value (_0 args) c1))
        (define c3 (compile-value-row (drop 1 args) c2))
        (If (Eq argc 1)
          (emit-tail-eval-if tail? 1 (comp-append-one (OP_APPLY_UNK 2) c2))
          (call-builder (known 1) argc tail? c3)))
      ((byte-law-call? lit)
        (error ("literal-call-head" lit)))
      (else
        (define c1 (comp-append-one (OP_PUSH_LIT lit) acc))
        (define c2 (compile-value-row args c1))
        (call-builder (byte-known-arity lit) argc tail? c2))))
  (define (compile-call f x tail? acc)
    (define lifted (byte-lift-call f x))
    (define head (_0 lifted))
    (define args (drop 1 lifted))
    (define found (byte-primitive-for-head (byte-pull-const head)))
    (define route (Ifz found 0 (_0 found)))
    (define is-if-route
      (And route (Or (Eq (prim-name route) "If") (Eq (prim-name route) "Ifz"))))
    (define use-primitive
      (And route
        (If is-if-route
          (And tail? (Eq (Sz args) (prim-arity route)))
          1)))
    (If use-primitive
      (compile-primitive-call route head args tail? acc)
      (compile-plain-call head args tail? acc)))
  (define (compile-value-mode acc)
    (cond
      ((byte-law-var? depth e) (comp-append-one (OP_PUSH_VAR e) acc))
      ((byte-law-call? e)
        (define lifted (byte-lift-call (_0 e) (_1 e)))
        (define head (_0 lifted))
        (define args (drop 1 lifted))
        (define c1
          (If (And (IsNat head) (Eq head 0))
            (comp-append-one OP_PUSH_SELF acc)
            (as-value head acc)))
        (define c2 (compile-value-row args c1))
        (comp-append-one (OP_APPLY_UNK (Inc (Sz args))) c2))
      ((And (IsApp e) (Nil (byte-law-quote? e)))
        (define c1 (as-value (Hd e) acc))
        (define c2 (compile-value-row e c1))
        (comp-append-one (OP_MK_APP (Inc (Sz e))) c2))
      (else (comp-append-one (OP_PUSH_LIT (byte-pull-const e)) acc))))
  (define (compile-app-value-mode acc)
    (define lifted (byte-lift-call (_0 e) (_1 e)))
    (If (byte-law-call? e)
      (compile-app-value-row lifted acc)
      (compile-value-mode acc)))
  (define (compile-expr-mode acc)
    (define direct-key (byte-direct-primitive-wrapper e arity))
    (define direct-found (byte-primitive-for-key direct-key))
    (cond
      (direct-found
        (compile-primitive-call (_0 direct-found) (byte-quote direct-key)
          (byte-local-arg-row arity) 1 acc))
      ((byte-law-var? depth e) (comp-append-one (OP_PUSH_VAR e) acc))
      ((byte-law-call? e) (compile-call (_0 e) (_1 e) tail acc))
      (else (compile-value-mode acc))))
  (cond
    ((Eq mode COMPILE_EXPR) (compile-expr-mode c))
    ((Eq mode COMPILE_VALUE) (compile-value-mode c))
    ((Eq mode COMPILE_APP_VALUE) (compile-app-value-mode c))
    (else (error ("bad-compile-mode" mode)))))

(define (compile-expr e depth arity tail c)
  (compile-core COMPILE_EXPR e depth arity tail c))

(define (compile-value e depth arity c)
  (compile-core COMPILE_VALUE e depth arity 0 c))

(define (compile-app-value e depth arity c)
  (compile-core COMPILE_APP_VALUE e depth arity 0 c))

(define (compile-law-label depth arity label body c)
  (define bodyc (compile-expr body depth arity 1 (comp-code-set 0 c)))
  (comp-add-label label (finish-label-code (comp-code bodyc))
    (comp (comp-next bodyc) (comp-labels bodyc) 0)))

(define (compile-law-lets depth arity lets idx c)
  (Ifz (Sz lets) c
    (compile-law-lets depth arity (drop 1 lets) (Inc idx)
      (compile-law-label depth arity idx (_0 lets) c))))

(define (compile-law-fields name body ari)
  (define lets (law-let-row body))
  (define let-count (byte-u32! "let_count" (Sz lets)))
  (define env-count (byte-u32! "env_count" (Inc (Add ari let-count))))
  (define depth (Dec env-count))
  (define final-body (drop-law-lets body))
  (define c0 (comp (Inc let-count) bst:E 0))
  (define c1 (compile-law-lets depth ari lets 1 c0))
  (define c2 (compile-law-label depth ari 0 final-body c1))
  (define label-count (byte-u32! "bc_s" (comp-next c2)))
  (define labels (byte-dense-labels (comp-labels c2) label-count))
  (byte-law name body ari let-count label-count labels))

(define (compile-law law)
  (compile-law-fields (Name law) (Body law) (Arity law)))

