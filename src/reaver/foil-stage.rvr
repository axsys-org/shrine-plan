(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)

(#bind foil (#module foil))
(#bind helm (#module compiler-host))
(#bind deps (#module foil-test-deps))

;;; The staged artifact is a compiler cache. Namespace mirroring belongs
;;; to boot-tools-tests, not every suite's compilation fixture.
(define roster (helm:mirror-roster (foil:read-fs-tree "foil")))
;; Compile the common runtime cone once before parallel leaf compiles.
;; Otherwise each app worker rebuilds web/helmapp independently.
(Seq (define base
       (_0 (foil:compile-mod-cached (_0 helm:tools-compiled)
             foil:default-subject "helmapp")))
  (DeepSeq base 0))
(Seq (define result
       (helm:compile-roster (deps:prepare base roster) roster))
  (DeepSeq (_1 result) 0))
(DeepSeq (map (lambda (mod) (print ["COMPILE-FAILED" mod])) (_1 result)) 0)
assert(Equal [] (_1 result))
(Seq (define cache (_0 result))
  (DeepSeq cache 0))

;; One module's compiled subject, by name ("sept", "apps/life/main").
(define (sut-of mod) (helm:cache-sut-of cache mod))

;; The loader records these stamps into this module's cache entry:
;; the stage re-executes when any compiled source changes.
(define module-file-stamps (foil:foil-closure-files roster))

(#export module-file-stamps cache sut-of)
