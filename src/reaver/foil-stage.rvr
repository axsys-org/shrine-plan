;;;; Compile the production roster in memory with the new compiler.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind compiler (#module compiler-build))
(#bind deps (#module foil-test-deps))
(#bind publication (#module foil-publication))

(define (compile cache)
  (define roster (source:read-fs-tree "foil"))
  (define plan (deps:prepare cache roster))
  (define (read name)
    (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_1 plan)))))
  (define context (publication:compilation-context plan))
  (force (foldl (lambda (state name)
    (define result (Seq (print ["COMPILING" name])
      (compiler:cache-compile-with context read (_0 state) name)))
    (Seq (print [(If (_1 result) "COMPILED" "COMPILE-FAILED") name])
      [(_0 result) (If (_1 result) (_1 state) (snoc name (_1 state)))]))
    [cache []] roster)))

(define (check z)
  (define result (compile 0))
  assert(Equal [] (_1 result))
  1)
(#export compile check)
