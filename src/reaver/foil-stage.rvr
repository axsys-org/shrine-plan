(#bind std (#module std))
(#import std)

(#bind foil (#module foil))
(#bind helm (#module helm))

;;; The staged world: one compile of everything on disk, landed in a
;;; shrine namespace whose /boot mirror carries each module's cache
;;; row as a pin (the ['sub] slot on the module's file node), then
;;; hydrated back out of the namespace.  The namespace IS the compile
;;; cache — suites read whole subjects from it instead of binding
;;; per-cone corpus tiers (foil-corpus-*, which this module replaced).
;;; The frozen artifact a template snapshot carries is `sov`; `cache`
;;; and every sut are views served from its pins.

(define core (helm:load-helm-mod "helmapp"))

(define roster
  (helm:mirror-roster (foil:read-fs-tree "foil")))

(define full-cache
  (_0 (helm:compile-roster (helm:core-cache core) roster)))

;; The world as a namespace: seeded through the compiled kernel, one
;; pact event per module subtree, row pins riding the ['sub] slots.
(define sov
  (helm:seed-tasks core (helm:core-ent core ["seeded"])
    (helm:boot-mirror-pact-tasks-with full-cache core)))

;; The cache read back OUT of the namespace: every row hydrated from
;; its mirror pin.  Compiles like any compile-mod-cached cache.
(define cache (helm:hydrate-cache core sov roster))

;; One module's compiled subject, by name ("sept", "apps/life/main").
(define (sut-of mod) (helm:cache-sut-of cache mod))

;; The loader records these stamps into this module's cache entry:
;; the stage re-executes when any compiled source changes.
(define module-file-stamps (foil:foil-closure-files roster))

(#export module-file-stamps sov cache sut-of)
