;;;; Compile a bootstrap ABI update against the saved world's own imports.
;;;; No document, care index, captured law or application history is rewritten.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind driver (#module foil-new-env))
(#bind context (#module foil-context))
(#bind subject (#module foil-subject))
(#bind world (#module eden-world))
(#bind eden (#module eden))
(#bind optimizer (#module plangrm))

(define revised (source:read-module "eden_store"))
(define (upgrade old)
  (define prior
    (context:module-context
      (subject:sut-context (driver:perc-subject (Unpin old)))))
  (define sources
    (map (lambda (pair)
      (If (Equal (_0 pair) "eden_store") ["eden_store" revised] pair))
      (Unpin (_2 prior))))
  (define selected (Up 2 (Pin sources) prior))
  (define (read name)
    (_1 (need (find (lambda (pair) (Equal name (_0 pair))) sources))))
  (define artifact (_1 (driver:compile-with selected read 0 "eden_store")))
  (unless (Equal (driver:perc-root artifact) (driver:perc-root (Unpin old)))
    (error "Bootstrap upgrade changed its publication root"))
  (unless (Equal (driver:get-perc ["eden_store" "reconnect"] artifact)
                 (driver:get-perc ["eden_store" "reconnect"] (Unpin old)))
    (error "Bootstrap upgrade changed its reconnect behavior"))
  [(Pin (world:prepare world:save)) (Pin artifact)])

(define (checked old)
  (Install optimizer:compileP1)
  (Try (lambda (ignored) (upgrade old)) 0))

(define (export ignored)
  ;; One evaluation: the compiler REPL cannot overwrite this root afterward.
  ;; The mount publisher is a bootstrap law, outside the retained namespace.
  ;; Its closure ABI is unchanged: the same captured inputs, in the same
  ;; lexical order. The native upgrader replaces that law only in service.
  (Save (Pin ("eden-bootstrap-upgrade/v2" (Pin checked) (Pin eden:start))))
  ;; A dynamic suffix distinguishes execution from a printed compiler AST.
  (print (strcat ["EDEN-UPGRADE-PREPARED:" (showNat (Now 0))]))
  ;; Keep the REPL from replacing the prepared code root. The launcher stops
  ;; this disposable process as soon as it observes the execution marker.
  (Sleep 3600))

(#export export)
