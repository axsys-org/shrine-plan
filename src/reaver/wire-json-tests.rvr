(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind publication (#module foil-publication))
(#bind core (#module foil-type-core))
(#bind driver (#module foil-new-env))
(#bind wire (#module wire-json))

(define selected
  (publication:assign-system (map (lambda (name)
    (Weld [("ts" "sys") ("ts" "types")]
      (map (lambda (part) ("ts" part)) name))) core:system-names)))
(define code "+ jres
  + ok (: value=any rest=nat)
  + err (: why=str rest=nat)
+ jkv (: key=str value=any)
+ json
  + nul (: ignored=nat)
  + boo (: value=bool)
  + num (: negative=bool magnitude=nat)
  + real (: lexeme=str)
  + str (: text=str)
  + arr (: values=row[any])
  + obj (: members=row[jkv])
")
(define (compiled previous)
  (define prepared (publication:prepare selected (Pin "test-compiler")
    (lambda (name) (rex:ParseRexNormFile code))
    [["json" [["x" 17] ["ts" "json"]]]] [] (lambda (path) previous)))
  (Unpin (_1 (_0 (_2 (publication:compile prepared driver:empty-foil-cache))))))
(define first (wire:codec (compiled 0)))
(define second (wire:codec (compiled 1)))
(define (brand codec name)
  (_1 (need (find (lambda (entry) (Equal name (_0 entry))) (_3 codec)))))
(define value ((brand first "obj")
  [((_2 first) "name" ((brand first "str") "Ada"))
   ((_2 first) "count" ((brand first "num") 0 42))
   ((_2 first) "flags" ((brand first "arr")
     [((brand first "boo") 1) ((brand first "nul") 0)]))]))
(define result ((_0 first) value 0))
(define normalized (wire:schema-value first result))
assert(Equal "Ada" (wire:jget-str "name" normalized))
assert(Equal 42 (wire:jget-nat "count" 0 normalized))
assert(Equal (strcat ["{" (wire:jq "name") ":" (wire:jq "Ada")
  "," (wire:jq "count") ":42," (wire:jq "flags") ":[true,null]}"])
  (wire:jshow normalized))
assert(Eq 1 (Hd (Try (lambda (ignored)
  (force (wire:schema-value second result))) 0)))
assert(Eq 1 (Hd (Try (lambda (ignored)
  (force (wire:normalize first ((brand first "str") "Ada" 0)))) 0)))
assert(Eq 1 (Hd (Try (lambda (ignored)
  (force (wire:normalize first ((brand first "obj")
    [((_2 second) "name" ((brand first "str") "Ada"))])))) 0)))
