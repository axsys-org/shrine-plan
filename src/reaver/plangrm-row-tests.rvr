(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind plangrm (#module plangrm))
(#import plangrm)

;; Runtime regressions for direct data construction. These laws are
;; saved AFTER compiler installation so the tests execute new code.
(define (row-lazy x) [x (error "forced lazy row element")])
(define (row-nested x) [x [(Add x 1) (Add x 2)]])
(define (row-big x) (1208925819614629174706176 x (Add x 1)))
(define (row-partial x) ((Add x) 3))
(define (row-branch x) (Ifz x [7 8] (error "untaken branch")))
(define (row-dynamic f x) (f x))

(define (row-checks tag)
  (begin
    (assert (Eq 2 (Sz (row-lazy tag))))
    (assert (Eq tag (Ix0 (row-lazy tag))))
    (assert (Equal [tag [(Add tag 1) (Add tag 2)]] (row-nested tag)))
    (assert (Eq 1208925819614629174706176 (Hd (row-big tag))))
    (assert (Eq 2 (Sz (row-big tag))))
    (assert (Eq tag (Ix0 (row-big tag))))
    (assert (Eq (Add tag 1) (Ix1 (row-big tag))))
    (assert (Eq (Add tag 3) (row-partial tag)))
    (assert (Equal [7 8] (row-branch (Sub tag tag))))
    (assert (Eq (Add tag 1) (row-dynamic Inc tag)))
    (assert (Truth (Hd (Try (lambda (z) (Ix1 (row-lazy z))) tag))))
    (print ["plangrm row runtime tests passed" tag])))

(define (row-test-main args)
  (define level (_0 args))
  (define compiler (If (Eq level "p6") compileP6 compileP5))
  (Seq (Save compiler)
    (Seq (Install compiler)
      (Seq (Save row-checks)
        (row-checks (If (Eq level "p6") 6 5))))))
