;; Run with: x/check ilc-typecheck-tests
(#bind std (#module std))
(#import std)
(#bind ilc (#module ilc))
(#bind structural (#module ilc-structural))
(#bind tc (#module ilc-typecheck))
(#bind fixture (#module ilc-typecheck-fixture))

(define (walkthrough ignored)
  ;; f([compiler-environment, surface-expression]) returns the complete
  ;; [updated-compiler, typed-IR] pair from the production expression checker.
  (define input [(fixture:compiler 0) (fixture:tree 1 10)])
  (define output (tc:check input))

  ;; Generate df from f's PLAN implementation. The rules are only generic
  ;; product/primitive/collection rules, with no entry for any checker law.
  (define df (ilc:derive-with structural:rules tc:check))

  ;; Change the left literal of (add 10 11) to 42. This delta edits a path
  ;; through the input product and AST, retaining the environment and sibling.
  (define dx (fixture:edit 1 42))
  (define next-input (ilc:apply-change input dx))
  (define dy (df input dx))
  (define next-output (ilc:apply-change output dy))
  assert(Equal next-output (tc:check next-input))
  (print "generated df agrees with checking the changed add expression")

  ;; Carry both updated input and output forward: subsequent deltas are
  ;; relative to that state. This retains results, not a module memo table.
  (define dx2 (fixture:edit 1 43))
  (define output2 (tc:update df next-input next-output dx2))
  assert(Equal output2 (tc:check (ilc:apply-change next-input dx2)))
  (print "second relative update agrees too; use x/bench-ilc-typecheck for costs")
  1)
assert(walkthrough 0)
