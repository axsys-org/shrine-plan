;;;; Native assertions used after the launcher reopens a saved test worker.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind report (#module testing-report))

(define (check started completed modules statuses)
  (define image (_0 completed))
  (define (text card slot)
    ((driver:get-perc ["str" "to_atom"] image)
      ((driver:get-perc ["myth" "txt_at"] image) [("ts" slot)] card)))
  (define (number card slot)
    ((driver:get-perc ["myth" "nat_at"] image) [("ts" slot)] 0 card))
  (define expected (If (all (Equal "pass") statuses) "passed" "failed"))
  assert(Equal expected (text (report:read completed []) "status"))
  assert(Equal "running" (text (report:read started []) "status"))
  assert(Eq (Sz statuses) (number (report:read completed []) "count"))
  (DeepSeq (map (lambda (i)
    (define card (report:read completed [("ts" "checks") ("u" i)]))
    (define source (report:read completed [("ts" "sources") ("u" i)]))
    (define name (Ix i modules))
    assert(Equal name (text card "module"))
    assert(Equal name (text source "module"))
    assert(Gt (Bytes (text source "source")) 0)
    assert(Equal (Ix i statuses) (text card "status")))
    (gen (Sz statuses) (lambda (i) i))) 0)
  (define before (report:versions started))
  (define after (report:versions completed))
  assert(all (lambda (i) (Gt (Ix i after) (Ix i before))) [0 1 2])
  assert(Equal (report:read started []) (report:read-at completed (_0 before) []))
  ;; Refuse replacing a prior report, even when the caller holds its writer.
  (define duplicate ((driver:get-perc ["testing_report" "begin"] image)
    [] (Pin 0) (_1 completed)))
  assert(Equal ("err" ("ts" "report_already_exists")) duplicate)
  (define repeated ((driver:get-perc ["testing_report" "finish"] image)
    1 [] (Pin 0) (_1 completed)))
  assert(Equal ("err" ("ts" "report_not_running")) repeated)
  1)
(#export check)
