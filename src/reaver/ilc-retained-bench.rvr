(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))
(#bind cache (#module ilc-retained))
(#bind structural (#module ilc-structural))
(#bind tc (#module ilc-typecheck))
(#bind fixture (#module ilc-typecheck-fixture))

(define (measure depth mode sample units work)
  (define start (Now 0))
  (define answer (Seq start (work 0)))
  (define end (DeepSeq answer (Now 0)))
  (Seq (print ("RETAINED-BENCH" (showNat depth) mode (showNat sample)
    (showNat units) (showNat (Sub end start)) (showNat answer))) answer))
;; Force only the observable value, never the cache (which holds lazy branches).
(define (measure-init depth mode work project)
  (define start (Now 0))
  (define answer (Seq start (work 0)))
  (define end (DeepSeq (project answer) (Now 0)))
  (Seq (print ("RETAINED-INIT" (showNat depth) mode (showNat (Sub end start)))) answer))
(define (ordinary-loop mode derivative input output edits)
  (Ifz edits 0
    (let ((next (ilc:apply-change input (_0 edits))))
      (define fresh (If (Equal mode "full") (tc:check next)
        (tc:update derivative input output (_0 edits))))
      (DeepSeq fresh (Inc (ordinary-loop mode derivative next fresh (drop 1 edits)))))))
(define (retained-loop state edits)
  (Ifz edits 0
    (let ((fresh (_1 (cache:advance state (_0 edits)))))
      (DeepSeq (cache:value fresh) (Inc (retained-loop fresh (drop 1 edits)))))))
(define (validate derivative state edits)
  (Ifz edits state
    (let ((dx (_0 edits)) (input (_1 state)) (output (cache:value state)))
      (define result (cache:advance state dx))
      (define fresh (_1 result))
      (define full (tc:check (ilc:apply-change input dx)))
      (define staged (tc:update derivative input output dx))
      (If (And (Equal full staged)
            (And (Equal full (cache:value fresh)) (Equal full (ilc:apply-change output (_0 result)))))
        (validate derivative fresh (drop 1 edits))
        (error "retained typechecker output/delta disagrees with full checking")))))
;; Keep validation's updated histories out of the timed runner's live scope.
;; Only its Boolean result survives; retained initial state is intentionally
;; shared by all trials, matching the baseline's shared original input/output.
(define (validate-reset depth derivative initial edits)
  (define validated (validate derivative initial edits))
  (define reset (DeepSeq (cache:value validated)
    (measure-init depth "reset" (lambda (z) (cache:reset validated)) cache:value)))
  (If (Equal (cache:value validated) (cache:value reset)) 1
    (error "retained reset mismatch")))
(define (run samples updates depths)
  (define compiler (fixture:compiler 0))
  (define rules (structural:rules-with ilc:derive-staged-with))
  (define derivative (ilc:derive-staged-with rules tc:check))
  (define program (cache:prepare rules tc:check))
  (define (one depth)
    (define input [compiler (fixture:tree depth 1)])
    (define edits (gen updates (lambda (i) (fixture:edit depth (Add 100 i)))))
    (define full (DeepSeq input
      (measure-init depth "full" (lambda (z) (tc:check input)) (lambda (x) x))))
    (define initial (DeepSeq full
      (measure-init depth "retained" (lambda (z) (cache:start program input)) cache:value)))
    (define ready (DeepSeq edits
      (If (Equal full (cache:value initial)) (validate-reset depth derivative initial edits)
        (error "retained initialization mismatch"))))
    (define (repeat sample)
      (If (Eq sample samples) 1
        (Seq (foldl (lambda (acc mode)
          (Seq (measure depth mode sample updates (lambda (z)
            (If (Equal mode "retained") (retained-loop initial edits)
              (ordinary-loop mode derivative input full edits)))) 0)) 0
          (If (Mod sample 2) ["retained" "staged" "full"] ["full" "staged" "retained"]))
          (repeat (Inc sample)))))
    (If ready (repeat 0) (error "retained reset mismatch")))
  (Seq (foldl (lambda (acc depth) (Seq (one depth) 0)) 0 depths)
    (print "RETAINED-BENCH-DONE")))
(#export run)
