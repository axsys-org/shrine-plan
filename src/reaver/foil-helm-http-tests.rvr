;;;; Pure typed inbound HTTP transitions: hydration, FIFO acknowledgments,
;;;; failures, duplicate notifications, and shutdown without socket effects.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(define sut (foil:compile-mod foil:default-subject "helm_http"))
(define (app p) (foil:source-entry-val p sut))
(define step (app ["http_driver" "step"]))
(define empty (app ["http_state" "empty"]))
(define new (app ["myth" "new"]))
(define add (app ["myth" "add"]))
(define twig (app ["twig" "nat"]))
(define name ("ts" "http"))
(define path [("ts" "io") name ("ts" "r1")])
(define (ev message) ("/boot/http_event/helm" message))
(define ok (ev ("/boot/driver_in/ack" ("/boot/rsvp/ok" "/boot/maybe/none"))))
(define no (ev ("/boot/driver_in/ack" ("/boot/rsvp/no" ("ts" "rejected")))))
(define request ("/boot/http_event/request" 42 ("/boot/http_action/wait" path new)))
(define queued (step name empty request))
assert(Eq 2 (Sz (_1 queued)))
assert(Eq 2 (Sz (_1 (_0 queued))))
assert(Eq "/boot/http_ack/make" (Hd (Ix 0 (_1 (_0 queued)))))
assert(Equal "/boot/http_ack/watch" (Ix 1 (_1 (_0 queued))))
;; Cleanup must contain a writ value, not a reflected type descriptor.
;; Both the request and crew publication use typed commands.
assert(Equal ["/boot/driver_out/cmd" "/boot/driver_out/cmd"]
  (map (lambda (fx) (Hd (_0 fx))) (_1 queued)))
(define response-record (add (twig [("ts" "res_status")] 200)
  (add (twig [("ts" "res_body")] "hello") new)))
(define changed (ev ("/boot/driver_in/change" path ("/boot/res/known" response-record))))
;; Hydration can arrive before the publication ack. The queue stays aligned.
(define answered (step name (_0 (step name (_0 queued) ok)) changed))
assert(Equal [] (_0 (_0 answered)))
assert(Eq 3 (Sz (_1 answered)))
assert(Equal ("/boot/http_effect/reply" 42
  ("/boot/http_response" 200 "hello" "text/plain; charset=utf-8")) (Ix 1 (_1 answered)))
assert(Equal [] (_1 (step name (_0 answered) changed)))
assert(Equal "/boot/writ/cull" (_1 (_1 (_0 (Ix 0 (_1 answered))))))
(define drained (_0 (step name (_0 (step name (_0 (step name (_0 answered) ok)) ok)) ok)))
assert(Equal empty drained)
;; A rejected request replies once, drops its watch, and queues the cleanup
;; publication behind the older publication ack.
(define rejected (step name (_0 queued) no))
assert(Equal [] (_0 (_0 rejected)))
assert(Equal ("/boot/http_effect/reply" 42
  ("/boot/http_response" 500 "rejected" "text/plain; charset=utf-8")) (Ix 0 (_1 rejected)))
(define unwatched (step name (_0 (step name (_0 queued) ok)) no))
assert(Equal [] (_0 (_0 unwatched)))
assert(Eq 500 (_0 (_1 (Ix 0 (_1 unwatched)))))
;; Writes wait for the actual kernel verdict, including failures.
(define write ("/boot/http_event/request" 99
  ("/boot/http_action/write" ("/boot/task/vine" path ("/boot/writ/poke" new)) path "/ns/a")))
(define writing (step name empty write))
assert(Eq 1 (Sz (_1 writing)))
assert(Eq 500 (_0 (_1 (Ix 0 (_1 (step name (_0 writing) no))))))
assert(Eq 200 (_0 (_1 (Ix 0 (_1 (step name (_0 writing) ok))))))
;; Shutdown releases both kinds of waiting connection.
(define stopped (step name (_0 (step name (_0 queued) write)) (ev "/boot/driver_in/die")))
assert(Eq 1 (_2 stopped))
assert(Equal empty (_0 stopped))
assert(Equal [42 99] (map (lambda (fx) (_0 fx)) (_1 stopped)))
assert(Equal [503 503] (map (lambda (fx) (_0 (_1 fx))) (_1 stopped)))
assert(Equal [] (_1 (step name empty ok)))
(print "Foil HTTP driver tests passed")
