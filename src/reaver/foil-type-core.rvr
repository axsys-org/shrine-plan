;;;; Shared new builtin types; no elaborator, FFI, or old solver dependency.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind nt (#module foil-new-types))
(#bind cairn (#module cairn))
(#bind contexts (#module foil-context))

(define nat-ref (nt:type-ref ["nat"]))

;; The fourteen kernel auras (doc/aura-spec.md).  aura-tag? gates the
;; nat/<aura> surface spelling; iota-body is the tagged-pair sum the
;; goal-directed literal rules recognize.
(define aura-tags
  ["dm" "dr" "ds" "f" "r" "rd" "rs" "s" "ta" "ts" "tu" "u" "w" "x"])
(define (aura-tag? a)
  (includes (Eq a) aura-tags))
(define iota-body
  (nt:tsum
    (map (lambda (tag)
      (nt:trow tag [(nt:trow-item 0 nat-ref)]))
      aura-tags)))

;; The substrate option's brand cords: maybe's constructors ARE these
;; rooted cords (see the maybe declaration below), and the derived
;; union members (sum-try-case) build maybe values from them.
(define maybe-some-brand "/boot/maybe/some")
(define maybe-none-brand "/boot/maybe/none")

(define (builtin path scm brand)
  (nt:make-type-entry path scm brand 0 "builtin"))

;; One declaration table supplies both the type world and source-visible TC.
(define declarations
  [
    (builtin ["nat"] (nt:mono (nt:tnat 0)) "nat")
    (builtin ["uint"] (nt:mono (nt:tnat 0)) "uint")
    (builtin ["bool"] (nt:mono (nt:tnat 0)) "bool")
    (builtin ["unit"]
      (nt:mono (nt:trow (print-path ["unit"]) []))
      (print-path ["unit"]))
    (builtin ["pail"] (nt:mono nt:tpail) 0)
    (builtin ["any"] (nt:mono nt:tany) 0)
    (builtin ["row"]
      (nt:scheme [(nt:type-param "a")]
        (nt:tarr (nt:type-var "a")))
      0)
    (builtin ["list"]
      (nt:scheme [(nt:type-param "a")]
        (nt:tsum
          [(nt:trow "nil" [])
           (nt:trow "cons"
             [(nt:trow-item 0 (nt:type-var "a"))
              (nt:trow-item 1
                (nt:type-app ["list"]
                  [(nt:type-arg (nt:type-var "a"))]))])]))
      0)
    ;; either[e a]: the hardcoded result type — error type FIRST, cases
    ;; err/ok (the < rune propagates err; see elab-prop).  Structural
    ;; rows with bare tags, like list.
    (builtin ["either"]
      (nt:scheme [(nt:type-param "e") (nt:type-param "a")]
        (nt:tsum
          [(nt:trow "err"
             [(nt:trow-item 0 (nt:type-var "e"))])
           (nt:trow "ok"
             [(nt:trow-item 0 (nt:type-var "a"))])]))
      0)
    ;; maybe[v]: the substrate option type, cases some/none.  Its
    ;; constructors are the ROOTED cords /boot/maybe/some and
    ;; /boot/maybe/none - the brand sept.foil's nominal maybe used to
    ;; carry - so hosts and tests keep the runtime shape
    ;; ("/boot/maybe/some" x) / "/boot/maybe/none"; option-member-tag
    ;; reads the last /-segment, so .some/.none still name the cases.
    ;; FFI constructors in foil-builtins share these brands.
    (builtin ["maybe"]
      (nt:scheme [(nt:type-param "v")]
        (nt:tsum
          [(nt:trow maybe-some-brand [(nt:trow-item 0 (nt:type-var "v"))])
           (nt:trow maybe-none-brand [])]))
      0)
    (builtin ["iota"] (nt:mono iota-body) 0)
    ;; Aura'd nat aliases: a sym/str value is a bare nat whose aura
    ;; rides the type and widens away to plain nat.
    (builtin ["sym"] (nt:mono (nt:tnat "ts")) 0)
    (builtin ["str"] (nt:mono (nt:tnat "tu")) 0)
    ;; Rex uses its historical tags and zero-headed spans at the FFI boundary.
    (builtin ["rex" "source_span"]
      (nt:mono (nt:trow 0
        [(nt:trow-item "line" nat-ref)
         (nt:trow-item "column" nat-ref)
         (nt:trow-item "offset" nat-ref)
         (nt:trow-item "length" nat-ref)])) 0)
    (builtin ["rex"]
      (nt:mono (nt:tsum
        [
          (nt:trow "leaf"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "shape" nt:tany)
             (nt:trow-item "text" (nt:type-ref ["str"]))])
          (nt:trow "nest"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "color" (nt:type-ref ["str"]))
             (nt:trow-item "rune" (nt:type-ref ["str"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "expr"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "color" (nt:type-ref ["str"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "pref"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "rune" (nt:type-ref ["str"]))
             (nt:trow-item "kid" (nt:type-ref ["rex"]))])
          (nt:trow "tyte"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "rune" (nt:type-ref ["str"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "bloc"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "color" (nt:type-ref ["str"]))
             (nt:trow-item "rune" (nt:type-ref ["str"]))
             (nt:trow-item "head" (nt:type-ref ["rex"]))
             (nt:trow-item "items" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "open"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "rune" (nt:type-ref ["str"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "juxt"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])
          (nt:trow "heir"
            [(nt:trow-item "span" (nt:type-ref ["rex" "source_span"]))
             (nt:trow-item "kids" (nt:tarr (nt:type-ref ["rex"])))])])) 0)
    ;; The reflection descriptor sum: (^ expr) values.  Closed and
    ;; non-generic; recursion is by nominal self-reference (a type-app
    ;; here would be a template node, which wf rejects in resolved
    ;; types). Member shapes stay in sync with foil-new-elab:reflect-encode.
    (builtin ["type"]
      (let ((self (nt:type-ref ["type"])))
        (nt:mono
          (nt:tsum
            [(nt:trow "any" [])
             (nt:trow "pail" [])
             (nt:trow "bot" [])
             ;; An opaque constant: a non-nat const value (a baked
             ;; comparator, say) that reflection cannot decompose.
             (nt:trow "opq" [])
             (nt:trow "nat" [(nt:trow-item "aura" nat-ref)])
             (nt:trow "cst" [(nt:trow-item "val" nat-ref)])
             (nt:trow "var" [(nt:trow-item "name" nat-ref)])
             (nt:trow "arr" [(nt:trow-item "item" self)])
             (nt:trow "pin" [(nt:trow-item "item" self)])
             (nt:trow "fun"
               [(nt:trow-item "args" (nt:tarr self))
                (nt:trow-item "ret" self)])
             (nt:trow "sum" [(nt:trow-item "opts" (nt:tarr self))])
             (nt:trow "rec"
               [(nt:trow-item "cstr" nat-ref)
                (nt:trow-item "items"
                  (nt:tarr
                    (nt:trow 0
                      [(nt:trow-item "face" nat-ref)
                       (nt:trow-item "item" self)])))])
             (nt:trow "ref"
               [(nt:trow-item "identity" nat-ref)
                (nt:trow-item "args" (nt:tarr self))])
             (nt:trow "nom"
               [(nt:trow-item "path" (nt:tarr nat-ref))
                (nt:trow-item "args" (nt:tarr self))])
             (nt:trow "gen"
               [(nt:trow-item "params"
                  (nt:tarr
                    (nt:trow 0
                      [(nt:trow-item "cnst" nat-ref)
                       (nt:trow-item "name" nat-ref)
                       (nt:trow-item "cty" self)])))
                (nt:trow-item "body" self)])])))
      0)])

(define (install-core-world world)
  ;; Preserve the original pipe's right-to-left insertion order.
  (foldl nt:insert-type-entry world (rev declarations)))

(define (install-core-subject sut)
  (foldl (lambda (out entry)
    (insert-tc (nt:type-entry-origin entry) wack-span
      (tc-typ (nt:type-entry-scheme entry)) out))
    sut (rev declarations)))

(define default-type-world (install-core-world nt:empty-type-world))
(define core-subject
  (install-core-subject (set-sut-root ["boot"] empty-subject)))

;; Native declarations have the same preassigned moments as source-defined
;; system types. Structural tags (Rex, list, either and descriptor layouts)
;; retain their codecs; the already-nominal unit and maybe cases are framed.
(define system-declarations
  (filter (lambda (entry)
    (Nil (Equal "rex" (_0 (nt:type-entry-origin entry))))) declarations))
(define system-names
  (Weld (map nt:type-entry-origin system-declarations)
    [["maybe" "some"] ["maybe" "none"]]))

(define (system-subject context)
  (define unit (contexts:native-unit context system-names))
  (define root (contexts:storage-root unit))
  (define (key path) (Weld root path))
  (define (variant path) (contexts:runtime-brand unit path))
  (define some
    (nt:scheme [(nt:type-param "v")]
      (nt:trow (variant ["maybe" "some"])
        [(nt:trow-item 0 (nt:type-var "v"))])))
  (define none
    (nt:scheme [(nt:type-param "v")]
      (nt:trow (variant ["maybe" "none"]) [])))
  (define maybe
    (nt:scheme [(nt:type-param "v")]
      (nt:tsum
        (map (lambda (name) (nt:type-app ["maybe" name]
          [(nt:type-arg (nt:type-var "v"))])) ["some" "none"]))))
  (define types
    (Weld (map (lambda (entry)
      (define name (nt:type-entry-origin entry))
      [name
        (cond
          ((Equal name ["unit"])
            (nt:mono (nt:trow (variant name) [])))
          ((Equal name ["maybe"]) maybe)
          (else (nt:type-entry-scheme entry)))]) system-declarations)
      [[["maybe" "some"] some] [["maybe" "none"] none]]))
  (foldl (lambda (sut pair)
    (define path (key (_0 pair)))
    (mark-visible path path
      (insert-tc path wack-span
        (tc-typ (nt:relocate-scheme key (_1 pair))) sut)))
    (set-sut-context unit (set-sut-root root empty-subject)) types))

(define boot-root ["boot"])
(define (system-path sut name)
  (Ifz (sut-context sut) name
    (let ((native (find (lambda (layer)
      (define unit (sut-context layer))
      (And unit (Equal "$system/core" (_3 unit))))
      (rowify (sut-layers sut)))))
      (If native (Weld (sut-root (_0 native)) name)
        (error ["missing-system-substrate" name])))))
(define nat-ty nat-ref)
(define uint-ty (nt:type-ref ["uint"]))
(define bool-ty (nt:type-ref ["bool"]))
(define unit-ty (nt:type-ref ["unit"]))
(define iota-ty (nt:type-ref ["iota"]))
(define row-of nt:tarr)
(define (applied-of base items)
  (nt:type-app base (map nt:type-arg items)))
(define (list-of item) (applied-of ["list"] [item]))
(define (either-of err ok) (applied-of ["either"] [err ok]))
(define (maybe-of item) (applied-of ["maybe"] [item]))
(define (quantify vars typ)
  (nt:scheme (Weld (map nt:type-param vars)
      (If (nt:scheme? typ) (nt:scheme-parameters typ) []))
    (If (nt:scheme? typ) (nt:scheme-body typ) typ)))

(define (subject-entry-tc ent0)
  (define ent (If (IsPin ent0) (Unpin ent0) ent0))
  (cond
    ((Nil (IsApp ent)) 0)
    ((Eq "TC" (Hd ent)) (_1 ent))
    ((Eq "IR_ENTRY" (Hd ent)) (_3 ent))
    (else 0)))

(define (subject-type-declaration world pair)
  (define tc (subject-entry-tc (_1 pair)))
  (Ifz (And tc (Eq "TC_TYP" (Hd tc)))
    world
    (let* ((path (_0 pair))
           (inner (tc-typ-inner tc))
           (scm
             (cond
               ((nt:scheme? inner) inner)
               ((nt:monotype? inner) (nt:mono inner))
               (else (error ["invalid type declaration" path inner])))))
      (cond
        ((Nil (nt:valid-type-value? scm))
          (error ["invalid type declaration" path inner]))
        ((nt:type-bound? world path) world)
        (else
          (let* ((mono (nt:scheme-body scm))
                 (brand (If (nt:row-type? mono) (nt:row-cstr mono) 0))
                 (arity (If (nt:row-type? mono) (Sz (nt:row-items mono)) 0)))
            (nt:declare-type world path scm brand arity 0)))))))

(define (world-from-layer world subject)
  ;; One layer's own entry ax; transitive declarations ride the tail
  ;; layers, folded by world-from-subject head-first (first declaration
  ;; wins in subject-type-declaration = nearest layer wins).  The
  ;; slot-8 mount arm this once carried is retired with the hybrid
  ;; projection.
  (foldl subject-type-declaration world
    (rowify (cairn:tapax (sut-ax subject)))))

(define (world-from-subject sut)
  (lfoldl
    world-from-layer default-type-world
    (foil-subject:sut-layers sut)))

(#export
 declarations nat-ref aura-tags aura-tag? iota-body
 maybe-some-brand maybe-none-brand
 install-core-world install-core-subject default-type-world core-subject
 system-names system-subject system-path
 boot-root nat-ty uint-ty bool-ty unit-ty iota-ty
 row-of applied-of list-of either-of maybe-of quantify
 subject-entry-tc subject-type-declaration world-from-layer world-from-subject)
