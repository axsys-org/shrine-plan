;;;; Async-building tests — futures, parallel foil compilation, and the
;;;; forge's parallel bundle warmup.
;;;;
;;;; Needs enki with the actor-request fix (merged upstream July 2026;
;;;; diagnosis in doc/enki-actor-report.md) — older runtimes SIGABRT on
;;;; the first Spawn. Run with: x/test foil-async-tests

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind async (#module async))
(#bind foil (#module foil))
(#bind forge (#module forge))

;;; Future basics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Eq 42 (async:await (async:async0 (lambda (z) 42))))

;; a crashing future resolves to a Try error at await-try; nothing dies
(define bad (async:async0 (lambda (z) (error "boom"))))
assert(Eq 1 (Hd (async:await-try bad)))

;; deep variant forces the result in the child
assert(Equal [1 2 3] (async:await (async:async-deep (lambda (n) [1 2 n]) 3)))

;;; Parallel foil compilation is deterministic ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define par (foil:compile-mods-par ["bst" "demo"]))
assert(Equal (foil:compile-mod foil:default-subject "bst") (_0 par))
assert(Equal (foil:compile-mod foil:default-subject "demo") (_1 par))

;;; Forge parallel warmup serves from the pre-seeded state ;;;;;;;;;;;;;;;;;;;;;;;;

(define wst (forge:warm-state-par forge:forge-mods))
(define r (forge:route wst "GET" "/mod/bst" ""))
assert(forge:str-contains? "/bst/insert" (_1 r))

;; axal's deliberate compile failure rides through its future as data
(define r2 (forge:route wst "GET" "/mod/axal" ""))
assert(forge:str-contains? "does not compile" (_1 r2))

(print "foil-async tests passed")
