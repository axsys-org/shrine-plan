(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))
(#bind tc (#module ilc-typecheck))
(#bind fixture (#module ilc-typecheck-fixture))
(#bind structural (#module ilc-structural))
(#bind audit (#module ilc-audit))

(define (measure depth sample mode units work)
  (define start (Now 0))
  (define answer (Seq start (work 0)))
  (define end (DeepSeq answer (Now 0)))
  (Seq (print ("TYPECHECK-BENCH" (showNat depth) mode (showNat sample)
    (showNat units) (showNat (Sub end start)) (showNat answer))) answer))
(define (step mode d ds dt input output dx)
  (cond ((Equal mode "full") (tc:check (ilc:apply-change input dx)))
        ((Equal mode "raw-ilc") (tc:update d input output dx))
        ((Equal mode "structural-ilc") (tc:update ds input output dx))
        (else (tc:update dt input output dx))))
(define (loop mode d ds dt input output edits)
  (Ifz edits 0
    (let ((fresh (step mode d ds dt input output (_0 edits))))
      (DeepSeq fresh (Inc (loop mode d ds dt (ilc:apply-change input (_0 edits))
        fresh (drop 1 edits)))))))
(define (validate d ds dt input output edits)
  (Ifz edits 1
    (let ((next (ilc:apply-change input (_0 edits))))
      (define full (tc:check next))
      (define raw (tc:update d input output (_0 edits)))
      (define structured (tc:update ds input output (_0 edits)))
      (define staged (tc:update dt input output (_0 edits)))
      (If (And (Equal full raw) (And (Equal full structured) (Equal full staged)))
        (validate d ds dt next structured (drop 1 edits))
        (error "generated typechecker derivative disagrees with full checking")))))
(define (run samples updates depths)
  (define compiler (fixture:compiler 0))
  (define d (tc:derivative []))
  (define ds (tc:derivative structural:rules))
  (define dt (ilc:derive-staged-with (structural:rules-with ilc:derive-staged-with) tc:check))
  (define (one depth)
    (define input [compiler (fixture:tree depth 1)])
    (define output (tc:check input))
    (define edits (gen updates (lambda (i) (fixture:edit depth (Add 100 i)))))
    (define ready (DeepSeq [input output edits]
      (validate d ds dt input output edits)))
    (define (repeat sample)
      (If (Eq sample samples) 1
        (Seq (foldl (lambda (acc mode)
          (Seq (measure depth sample mode updates
            (lambda (z) (loop mode d ds dt input output edits))) 0)) 0
          (If (Mod sample 2) ["staged-ilc" "structural-ilc" "raw-ilc" "full"]
            ["full" "raw-ilc" "structural-ilc" "staged-ilc"])) (repeat (Inc sample)))))
    (Seq ready (repeat 0)))
  (Seq (foldl (lambda (acc depth) (Seq (one depth) 0)) 0 depths)
    (print "TYPECHECK-BENCH-DONE")))

;; Audit a genuine application through the generated derivative. This uses a
;; separate dispatcher and is outside every timing window. It proves which
;; checker laws are transformed and exposes opaque/changed-callee fallbacks.
(define (audit-one derive marker)
  (define input [(fixture:compiler 0) (fixture:tree 1 1)])
  (define output (tc:check input))
  (define dx (fixture:edit 1 9))
  (define fresh (tc:update (derive (structural:rules-with derive) tc:check) input output dx))
  (Seq (DeepSeq fresh 0)
    (If (Equal fresh (tc:check (ilc:apply-change input dx)))
      (print marker) (error "audited derivative mismatch"))))
(define (audit-run ignored)
  (Seq (audit-one audit:derive "TYPECHECK-AUDIT-DONE")
    (audit-one audit:derive-staged "TYPECHECK-STAGED-AUDIT-DONE")))
(#export run audit-run)
