;;;; Zero-span normalized Rex builders for generated modules.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))

(define nzsp [0 0 0 0])
(define (nw s) (rex:MakeLeaf nzsp "word" s))
(define (nc s) (rex:MakeLeaf nzsp "cord" s))
(define (nq s) (rex:MakeLeaf nzsp "quip" s))
(define (nrn rune kids) (rex:MakeNest nzsp "clear" rune kids))
(define (npar kids) (rex:MakeNest nzsp "paren" "" kids))
(define (nparo rune kids) (rex:MakeNest nzsp "paren" rune kids))
(define (nbrk kids) (rex:MakeNest nzsp "brack" "" kids))
(define (nbrko rune kids) (rex:MakeNest nzsp "brack" rune kids))
(define (njx kids) (rex:MakeJuxt nzsp kids))
(define (ngrp kids) (If (Eq 1 (Sz kids)) (_0 kids) (nrn "" kids)))
(define (npth segs) (nrn "/" (map nw segs)))

;; "." chains are FLAT in normalized rex (schemagen's ndot lesson).
(define (ndot a b)
  (If (And (Eq "nest" (Hd a))
        (And (Eq "clear" (Ix 1 a)) (Eq "." (Ix 2 a))))
    (nrn "." (snoc b (Ix 3 a)))
    (nrn "." [a b])))

(#export nzsp nw nc nq nrn npar nparo nbrk nbrko njx ngrp npth ndot)
