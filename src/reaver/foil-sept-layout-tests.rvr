;;;; PLAN representation contracts; behavioral checks live in tests/sept.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(Seq
  (define sut (foil:compile-mod foil:default-subject "sept"))
  (DeepSeq sut 0))
(define (entry path) (foil:source-entry-val path sut))

;; Delete, longest-prefix fit and tap return anonymous PLAN rows.
(define one ((entry ["uon" "sing"]) ("ts" "a") 1))
assert(Eq 0 (Hd ((entry ["uon" "del"]) ("ts" "a") one)))
(define tree
  ((entry ["axal" "put"]) [("ts" "chat") ("ts" "room")] 1
    ((entry ["axal" "new"]) "/boot/maybe/none")))
assert(Eq 0
  (Hd ((entry ["axal" "fit"])
        [("ts" "chat") ("ts" "room") ("u" 7)] tree)))
assert(Eq 0 (Hd (Ix 0 ((entry ["axal" "tap"]) tree))))

;; Forty decimal text keys force a limb, not just a leaf.
(define put (entry ["bee" "put"]))
(define tree40
  (foldl (lambda (tree i) (put ("ts" (showNat i)) i tree))
    ("/boot/bee/leaf" []) (gen 40 (lambda (i) i))))
assert(Equal "/boot/bee/limb" (Hd tree40))
