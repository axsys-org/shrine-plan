(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind byte (#module byte))
(#import byte)

(define (compiled name arity body)
  (compile-law-fields name body arity))

(define (code-of body arity)
  (byte-label-code (byte-law-labels (compiled "test" arity body)) 0))

(define (label-of law idx)
  (byte-label-code (byte-law-labels law) idx))

assert(Eq 70 OP_COUNT)

;;; Spec examples.

assert(Equal
  [(OP_PUSH_VAR 0) OP_RET]
  (code-of 0 0))

assert(Equal
  [OP_PUSH_SELF (OP_PUSH_VAR 1) (OP_CALLS 1) OP_RET]
  (code-of (0 0 1) 1))

assert(Equal
  [(OP_PUSH_VAR 1) (OP_PUSH_VAR 2) (OP_APPLY_UNK 2) OP_TAIL_EVAL OP_RET]
  (code-of (0 1 2) 2))

(define let-law (compiled "let" 0 (1 (0 7) 1)))

assert(Equal 1 (byte-law-let-d let-law))
assert(Equal 2 (byte-law-bc-s let-law))
assert(Equal
  [(OP_PUSH_VAR 1) OP_RET]
  (label-of let-law 0))
assert(Equal
  [(OP_PUSH_LIT 7) OP_RET]
  (label-of let-law 1))

assert(Equal
  [(OP_PUSH_VAR 1) (OP_PUSH_VAR 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of (0 (0 Add 1) 2) 2))

(define if-law (compiled "if" 0 (0 (0 (0 If 1) 42) 7)))
assert(Equal 2 (byte-law-bc-s if-law))
assert(Equal
  [(OP_PUSH_LIT 1) OP_EVAL (OP_JUMP_IF 1) (OP_PUSH_LIT 7) OP_RET]
  (label-of if-law 0))
assert(Equal
  [(OP_PUSH_LIT 42) OP_RET]
  (label-of if-law 1))

(define ifz-law (compiled "ifz" 0 (0 (0 (0 Ifz (0 0)) 42) 7)))
assert(Equal
  [(OP_PUSH_LIT 0) OP_EVAL OP_NOT (OP_JUMP_IF 1) (OP_PUSH_LIT 7) OP_RET]
  (label-of ifz-law 0))
assert(Equal
  [(OP_PUSH_LIT 42) OP_RET]
  (label-of ifz-law 1))

;;; Source-shape edge cases.

assert(Equal
  [(OP_PUSH_LIT 1) OP_RET]
  (code-of (0 1) 2))

assert(Equal
  [(OP_PUSH_LIT 2)
   (OP_PUSH_LIT 1) (OP_PUSH_LIT 7) (OP_PUSH_LIT 3) (OP_MK_APP 3)
   (OP_MK_APP 2) OP_RET]
  (code-of (2 (1 (0 7) 3)) 0))

(define partial-add (Add 1))
assert(Equal
  [(OP_PUSH_LIT 1) (OP_PUSH_VAR 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of (0 partial-add 2) 2))

assert(Equal
  [(OP_PUSH_LIT 2) (OP_PUSH_LIT 3) (OP_PUSH_LIT 4)
   (OP_MK_APP 3) OP_RET]
  (code-of (2 3 4) 0))

;;; Call behavior.

assert(Equal
  [(OP_PUSH_LIT Add) (OP_PUSH_LIT 5) (OP_MK_APP 2) OP_RET]
  (code-of (0 Add 5) 0))

assert(Equal
  [(OP_PUSH_LIT 1) (OP_PUSH_LIT 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD
   (OP_PUSH_LIT 3) (OP_APPLY_UNK 2) OP_TAIL_EVAL OP_RET]
  (code-of (0 (0 (0 Add 1) 2) 3) 0))

(define pin66 (Pin 66))

assert(Equal
  [(OP_PUSH_LIT pin66) (OP_PUSH_LIT 2) (OP_PUSH_LIT 3)
   (OP_MK_APP 2) (OP_APPLY_UNK 2) OP_TAIL_EVAL OP_RET]
  (code-of (0 pin66 (0 2 3)) 0))

assert(Equal
  [(OP_PUSH_LIT pin66) (OP_PUSH_LIT 8) (OP_PUSH_LIT 9)
   (OP_APPLY_UNK 3) OP_TAIL_EVAL OP_RET]
  (code-of (0 (0 pin66 8) 9) 0))

assert(Equal
  [(OP_PUSH_LIT If) (OP_PUSH_LIT 1) (OP_PUSH_LIT 2) (OP_PUSH_LIT 3)
   (OP_APPLY_UNK 4) (OP_PUSH_LIT 4)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of (0 (0 Add (0 (0 (0 If 1) 2) 3)) 4) 0))

;;; Primitive recognition.

(define fake-add (Law 1 "Add" 0))

assert(Equal "Add" (byte-primitive-key fake-add))

assert(Equal
  [(OP_PUSH_LIT 1) (OP_PUSH_LIT 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of (0 (0 fake-add 1) 2) 0))

(define wrap-a-body (0 (0 fake-add 1) 2))
assert(Equal "Add" (byte-direct-primitive-wrapper wrap-a-body 2))
assert(Equal
  [(OP_PUSH_VAR 1) (OP_PUSH_VAR 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of wrap-a-body 2))

(define wrap-b-row (0 (0 "Add" 1) 2))
(define wrap-b-body (0 pin66 wrap-b-row))
assert(Equal "Add" (byte-direct-primitive-wrapper wrap-b-body 2))
assert(Equal
  [(OP_PUSH_VAR 1) (OP_PUSH_VAR 2)
   (OP_ROTATE 2) OP_EVAL (OP_ROTATE 2) OP_EVAL
   OP_ADD OP_RET]
  (code-of wrap-b-body 2))

(print "byte tests passed")
