     ";@ /token/policy/contrast ;/policy/contrast/standard"
     ";. /authoring/providers/web/chat"]))
(define contrast-guard-layer-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name ;/foundry/system/guards/high_contrast"
     ";@ /foundry/guarded true"
     ";@ /token/color/text/primary ;/provider/web/contrast/text/primary"
     ";@ /token/color/text/secondary ;/provider/web/contrast/text/secondary"
     ";@ /token/color/text/tertiary ;/provider/web/contrast/text/tertiary"
     ";@ /token/color/surface/base ;/provider/web/contrast/surface/base"
     ";@ /token/color/surface/raised ;/provider/web/contrast/surface/raised"
     ";@ /token/color/surface/sunken ;/provider/web/contrast/surface/sunken"
     ";@ /token/color/surface/overlay ;/provider/web/contrast/surface/overlay"
     ";@ /token/color/border/separator ;/provider/web/contrast/border/separator"
     ";@ /token/color/border/strong ;/provider/web/contrast/border/strong"
     ";@ /token/color/action/accent ;/provider/web/contrast/action/accent"
     ";@ /token/color/action/positive ;/provider/web/contrast/action/positive"
     ";@ /token/color/action/warning ;/provider/web/contrast/action/warning"
     ";@ /token/color/action/destructive ;/provider/web/contrast/action/destructive"
     ";@ /token/policy/contrast ;/policy/contrast/maximum"
     ";. /authoring/guards/high-contrast"]))
(define motion-guard-layer-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name ;/foundry/system/guards/reduced_motion"
     ";@ /foundry/guarded true"
     ";@ /token/motion/change ;/provider/web/motion/respect_preference"
     ";@ /token/policy/motion ;/policy/motion/respect_preference"
     ";. /authoring/guards/reduced-motion"]))
(define authored-foundation-pages
  (authored-page "reduced_motion_guard" motion-guard-layer-src
    (authored-page "high_contrast_guard" contrast-guard-layer-src
      (authored-page "web_chat_provider" web-provider-layer-src
        (authored-page "chat_foundation" foundation-layer-src
          authored-header-pages)))))
(define authored-partial-foundation-pages
  (authored-page "chat_foundation" foundation-layer-src
    authored-header-pages))
(define source-record (message_record "a" "stable source occurrence"))
(define source-tree (axal-new (some source-record)))
;;; The mounted Chat app supplies a stable semantic occurrence record at its
;;; /source child.  Its identity is content-addressed; the app manifest and
;;; live messages remain outside that independent source occurrence.
assert(Equal (ts "occurrence")
  (_0 (pail-at [(ts "semantic") (ts "kind")] source-seed)))

;;; Every authored Chat catalog derives its structural templates solely from
;;; the catalog's recipe order.  Template-free hydration/terminal recipes do
;;; not perturb the closure, and the messages recipe owns message_log.
(define (assert-closure recipes expected)
  (define result (template-closure recipes corpus-a))
  assert(Equal mnone (Hd (_1 result)))
  assert(Equal expected (_0 result)))
(assert-closure plate-catalog-recipes
  [message-template-ref plate-template-ref])
(assert-closure scene-catalog-recipes
  [message-template-ref plate-template-ref scene-template-ref])
(assert-closure shrine-catalog-recipes
  [message-template-ref plate-template-ref scene-template-ref
   shrine-template-ref])
(assert-closure desktop-catalog-recipes
  [message-template-ref plate-template-ref scene-template-ref
   shrine-template-ref desktop-template-ref])
(assert-closure contrast-catalog-recipes
  [message-template-ref plate-template-ref scene-template-ref])
;;; Repeating a structural recipe keeps the first authored occurrence only.
(assert-closure [messages-ref plate-ref messages-ref plate-ref]
  [message-template-ref plate-template-ref])
(assert-closure [plate-ref messages-ref plate-ref]
  [plate-template-ref message-template-ref])
;;; The selected catalog record, not the request kind, owns the same closure.
(define selected-catalog
  (some-value
    (corpus-record
      [(ts "foundry") (ts "chat") (ts "catalogs") (ts "test_desktop")]
      corpus-a)))
(define selected-closure (catalog-template-closure selected-catalog corpus-a))
assert(Equal mnone (Hd (_1 selected-closure)))
assert(Equal
  [message-template-ref plate-template-ref scene-template-ref
   shrine-template-ref desktop-template-ref]
  (_0 selected-closure))

;;; Complete evidence admits one bounded Begin -> Upsert* -> Complete batch.
(define frames-a (packet-frames [(ts "chat")] "desktop" corpus-a source-tree))
(define batch-a (wire-body (frames-json "chat-test" frames-a)))
assert(Eq 1 (contains? "begin" batch-a))
assert(Eq 1 (contains? "upsert" batch-a))
assert(Eq 1 (contains? "complete" batch-a))
assert(Eq 0 (contains? "refuse" batch-a))
assert(Gt (Sz frames-a) 3)
;; The producer now resolves the selected catalog's real Semidoc layer and
;; carries both the typed value and its exact winning-layer provenance in the
;; renderer-neutral Upsert.
assert(Eq 1 (contains? "resolved" batch-a))
assert(Eq 1 (contains? "provenance" batch-a))
assert(Eq 1 (contains? "green" batch-a))
assert(Eq 1 (contains? "semantic-ref" batch-a))
assert(Eq 1 (contains? "winning_test_layer" batch-a))
;;; Header is a text-attribute bundle.  Plate Header is a shared structural
;;; template; both survive the same addressed graph without identity aliasing.
assert(Eq 1 (contains? "semantic_sans" batch-a))
assert(Eq 1 (contains? "line_height" batch-a))
assert(Eq 1 (contains? "plate_header" batch-a))
assert(Eq 1 (contains? "participation" batch-a))

;;; Equal source and evidence reproduce the same roots and addresses.  A
;;; template-only change retains occurrence identity but advances recipe and
;;; revision evidence instead of mutating content under the same revision.
(define frames-a2 (packet-frames [(ts "chat")] "desktop" corpus-a source-tree))
assert(Equal frames-a frames-a2)
(define manifest-a (frame-manifest (Ix 0 frames-a)))
(define frames-b (packet-frames [(ts "chat")] "desktop" corpus-b source-tree))
(define manifest-b (frame-manifest (Ix 0 frames-b)))
assert(Equal (_1 manifest-a) (_1 manifest-b))
assert(Eq 0 (Equal (_0 manifest-a) (_0 manifest-b)))
;; Layer-only movement changes the resolved value and therefore the immutable
;; revision, while the source pin + structural occurrence addresses stay put.
(define frames-layer-b
  (packet-frames [(ts "chat")] "desktop" corpus-layer-b source-tree))
(define manifest-layer-b (frame-manifest (Ix 0 frames-layer-b)))
(define batch-layer-b
  (wire-body (frames-json "chat-layer-change" frames-layer-b)))
assert(Equal (_1 manifest-a) (_1 manifest-layer-b))
assert(Eq 0 (Equal (_0 manifest-a) (_0 manifest-layer-b)))
assert(Equal (map frame-address frames-a)
  (map frame-address frames-layer-b))
assert(Eq 1 (contains? (resolved-accent-json "violet") batch-layer-b))
;; Other authored semantic text may legitimately be the word "green"; the
;; resolved token assertion above is therefore intentionally key-specific.

;;; Missing evidence is refused by category.  The producer never hashes a
;;; shortened recipe, layer, or surface list.
(define no-recipe
  (corpus-of
    [catalog-src base-layer-src layer-src message-surface-src plate-surface-src
     plate-header-template-src scene-surface-src shrine-surface-src desktop-src]))
(define no-layer
  (corpus-of (Weld
    [catalog-src message-surface-src plate-surface-src plate-header-template-src
     scene-surface-src
     shrine-surface-src desktop-src]
    recipe-sources)))
(define no-template
  (corpus-of (Weld
    [catalog-src base-layer-src layer-src plate-surface-src
     plate-header-template-src scene-surface-src shrine-surface-src desktop-src]
    recipe-sources)))
(define invalid-recipe
  (corpus-of (Weld
    [catalog-src base-layer-src layer-src invalid-message-recipe-src
     message-surface-src plate-surface-src plate-header-template-src
     scene-surface-src shrine-surface-src desktop-src]
    non-message-recipe-sources)))
(define invalid-template
  (corpus-of (Weld
    [catalog-src base-layer-src layer-src invalid-message-template-src
     plate-surface-src plate-header-template-src scene-surface-src
     shrine-surface-src desktop-src]
    recipe-sources)))
(define invalid-layer
  (corpus-of (Weld
    [catalog-src base-layer-src invalid-layer-src message-surface-src
     plate-surface-src plate-header-template-src scene-surface-src
     shrine-surface-src desktop-src]
    recipe-sources)))
(define recipe-refusal
  (wire-body (frames-json "chat-missing-recipe"
    (packet-frames [(ts "chat")] "desktop" no-recipe source-tree))))
(define layer-refusal
  (wire-body (frames-json "chat-missing-layer"
    (packet-frames [(ts "chat")] "desktop" no-layer source-tree))))
(define template-refusal
  (wire-body (frames-json "chat-missing-template"
    (packet-frames [(ts "chat")] "desktop" no-template source-tree))))
(define invalid-recipe-refusal
  (wire-body (frames-json "chat-invalid-recipe"
    (packet-frames [(ts "chat")] "desktop" invalid-recipe source-tree))))
(define invalid-template-refusal
  (wire-body (frames-json "chat-invalid-template"
    (packet-frames [(ts "chat")] "desktop" invalid-template source-tree))))
(define invalid-layer-refusal
  (wire-body (frames-json "chat-invalid-layer"
    (packet-frames [(ts "chat")] "desktop" invalid-layer source-tree))))
(define missing-recipe-closure
  (template-closure desktop-catalog-recipes no-recipe))
(define invalid-recipe-closure
  (template-closure desktop-catalog-recipes invalid-recipe))
(define missing-template-closure
  (template-closure desktop-catalog-recipes no-template))
(define invalid-template-closure
  (template-closure desktop-catalog-recipes invalid-template))
assert(Equal (some (ts "recipe_evidence_missing"))
  (_1 missing-recipe-closure))
assert(Equal (some (ts "recipe_evidence_invalid"))
  (_1 invalid-recipe-closure))
assert(Equal (some (ts "template_evidence_missing"))
  (_1 missing-template-closure))
assert(Equal (some (ts "template_evidence_invalid"))
  (_1 invalid-template-closure))
assert(Eq 1 (contains? "recipe_missing" recipe-refusal))
assert(Eq 0 (contains? "complete" recipe-refusal))
assert(Eq 1 (contains? "recipe_invalid" invalid-recipe-refusal))
assert(Eq 0 (contains? "complete" invalid-recipe-refusal))
assert(Eq 1 (contains? "layer_evidence_missing" layer-refusal))
assert(Eq 0 (contains? "complete" layer-refusal))
assert(Eq 1 (contains? "template_evidence_missing" template-refusal))
assert(Eq 0 (contains? "complete" template-refusal))
assert(Eq 1 (contains? "template_evidence_invalid" invalid-template-refusal))
assert(Eq 0 (contains? "complete" invalid-template-refusal))
assert(Eq 1 (contains? "layer_evidence_invalid" invalid-layer-refusal))
assert(Eq 0 (contains? "complete" invalid-layer-refusal))

;;; `packet_frames` remains renderer-neutral.  Only `frame_record`, the late
;;; mechanical adapter, pairs HTML with an exact semantic Upsert as a sibling
;;; pronunciation.
assert(Eq 0 (contains? "pronunciation" batch-a))
assert(Eq 0 (contains? "html" batch-a))
(define product-a
  (packet-product [(ts "chat")] "desktop" corpus-a source-tree))
assert(Equal frames-a (_0 product-a))
(define dag-a (some-value (_1 product-a)))
(define plan-a
  (some-value (pronunciation-result (pronounce dag-a))))
(define terminal-a (pronunciation-terminal plan-a))
(define terminal-body-a (some-value (_0 terminal-a)))
assert(Equal mnone (Hd (_1 terminal-a)))
;;; An authored Action reference without a trusted admission context remains
;;; visibly inert.  The migration policy must not recover the log subject or
;;; synthesize the old Web POST mechanics from the Composer role.
assert(Eq 1 (contains? "composer-inert" terminal-body-a))
assert(Eq 1
  (contains? "data-foundry-action=\"/chat/actions/send\"" terminal-body-a))
assert(Eq 0 (contains? "<form" terminal-body-a))
assert(Eq 0 (contains? "action=\"/post" terminal-body-a))
;;; Header Text Style is inherited from resolved semantic layer data.  The
;;; title Text consumes its safe Web pronunciation; Plate Header anatomy is
;;; selected by template identity and its leading glyph is authored content.
assert(Eq 1
  (contains? "data-foundry-header-style=\"static-fallback\"" terminal-body-a))
assert(Eq 1 (contains? "data-header-size=\"header\"" terminal-body-a))
assert(Eq 1 (contains? "plate-header" terminal-body-a))
assert(Eq 1 (contains? "plate-kind" terminal-body-a))
assert(Eq 1 (contains? ">C</span>" terminal-body-a))

;;; Scene chrome copy is authored semantic content.  The component Header is
;;; a Block; its title and subtitle are separate Text occurrences whose order
;;; reaches the terminal unchanged.
(define scene-title-occurrence-a
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "scene") (ts "header")
     (ts "title")]
    plan-a))
(define scene-subtitle-occurrence-a
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "scene") (ts "header")
     (ts "subtitle")]
    plan-a))
assert(Equal "Chat"
  (occurrence-text [(ts "surface") (ts "text")] scene-title-occurrence-a))
assert(Equal "a projected conversation scene"
  (occurrence-text [(ts "surface") (ts "text")]
    scene-subtitle-occurrence-a))
assert(Eq 1
  (contains? "Chat</strong> / a projected conversation scene"
    terminal-body-a))

;;; Changing only those authored Text values changes the visible Header copy;
;;; plan_policy supplies markup and separator punctuation, not product words.
(define scene-copy-product
  (packet-product [(ts "chat")] "desktop" corpus-scene-copy source-tree))
(define scene-copy-plan
  (some-value
    (pronunciation-result (pronounce (some-value (_1 scene-copy-product))))))
(define scene-copy-terminal (pronunciation-terminal scene-copy-plan))
assert(Equal mnone (Hd (_1 scene-copy-terminal)))
(define scene-copy-body (some-value (_0 scene-copy-terminal)))
assert(Eq 1
  (contains? "Studio</strong> / authored alternate scene" scene-copy-body))
assert(Eq 0
  (contains? "Chat</strong> / a projected conversation scene"
    scene-copy-body))

;;; A normalized Nenex style definition advances revision evidence and the
;;; pronounced title style without moving any semantic occurrence.  In particular, the
;;; independently live message-log Hole keeps both its address and /chat/log
;;; source, so it is not invalidated or re-authored by a typography edit.
(define header-product
  (packet-product-authored
    [(ts "chat")] "desktop" corpus-a source-tree authored-header-pages))
(define header-frames (_0 header-product))
(define header-manifest (frame-manifest (Ix 0 header-frames)))
(define header-plan
  (some-value
    (pronunciation-result (pronounce (some-value (_1 header-product))))))
(define header-terminal (pronunciation-terminal header-plan))
(define header-body (some-value (_0 header-terminal)))
assert(Equal (_1 manifest-a) (_1 header-manifest))
assert(Eq 0 (Equal (_0 manifest-a) (_0 header-manifest)))
assert(Equal (map frame-address frames-a)
  (map frame-address header-frames))
assert(Eq 1 (contains? "data-header-size=\"large-title\"" header-body))
assert(Eq 1 (contains? "data-foundry-header-style=\"authored\"" header-body))
assert(Eq 1 (contains? "data-header-weight=\"bold\"" header-body))
assert(Eq 1 (contains? "data-header-line-height=\"relaxed\"" header-body))
assert(Eq 1 (contains? "data-header-tracking=\"wide\"" header-body))
(define messages-occurrence-a
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "messages")] plan-a))
(define messages-occurrence-header
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "messages")] header-plan))
assert(Equal
  (occurrence-semantic-address messages-occurrence-a)
  (occurrence-semantic-address messages-occurrence-header))
assert(Equal
  (some [(ts "chat") (ts "log")])
  (hole-source (some-value (occurrence-hole messages-occurrence-header))))
(define title-occurrence-a
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "title")] plan-a))
(define title-occurrence-header
  (occurrence-at-role
    [(ts "projection") (ts "chat") (ts "title")] header-plan))
assert(Equal
  (occurrence-semantic-address title-occurrence-a)
  (occurrence-semantic-address title-occurrence-header))
assert(Eq 1 (contains? "/chat/log" header-body))
;;; The cohesive authored system packet is all-or-none.  Default requests use
;;; broad semantic roles, Web provider mappings, and the mandatory guarded
;;; reduced-motion policy.  Contrast requests additionally select the guarded
;;; high-contrast Layer; canonical cascade replays it after every ordinary
;;; product Layer and retains exact winner evidence.
(define default-foundations
  (foundation-layers-from "desktop" authored-foundation-pages))
(define contrast-foundations
  (foundation-layers-from "contrast" authored-foundation-pages))
assert(Equal
  [[(ts "foundry") (ts "system") (ts "layers") (ts "chat_foundation")]
   [(ts "foundry") (ts "system") (ts "providers") (ts "web_chat")]
   [(ts "foundry") (ts "system") (ts "guards") (ts "reduced_motion")]]
  (map f-layer-name default-foundations))
assert(Equal
  [[(ts "foundry") (ts "system") (ts "layers") (ts "chat_foundation")]
   [(ts "foundry") (ts "system") (ts "providers") (ts "web_chat")]
   [(ts "foundry") (ts "system") (ts "guards") (ts "high_contrast")]
   [(ts "foundry") (ts "system") (ts "guards") (ts "reduced_motion")]]
  (map f-layer-name contrast-foundations))
assert(Equal [0 0 1] (map f-layer-guarded default-foundations))
assert(Equal [0 0 1 1] (map f-layer-guarded contrast-foundations))
assert(Equal []
  (foundation-layers-from "desktop" authored-partial-foundation-pages))
(define foundation-contrast-hydration (f-cascade contrast-foundations))
(define foundation-contrast-values
  (f-hyd-values foundation-contrast-hydration))
assert(Equal
  [(ts "provider") (ts "web") (ts "contrast") (ts "text") (ts "primary")]
  (_0 (pail-at
    [(ts "token") (ts "color") (ts "text") (ts "primary")]
    foundation-contrast-values)))
(define foundation-contrast-winner
  (some-value
    (f-winner-at
      [(ts "token") (ts "color") (ts "text") (ts "primary")]
      foundation-contrast-hydration)))
assert(Equal
  [(ts "foundry") (ts "system") (ts "guards") (ts "high_contrast")]
  (f-winner-layer foundation-contrast-winner))
assert(Eq 1 (f-winner-guarded foundation-contrast-winner))
(define foundation-product
  (packet-product-authored
    [(ts "chat")] "desktop" corpus-a source-tree authored-foundation-pages))
(define foundation-plan
  (some-value
    (pronunciation-result (pronounce (some-value (_1 foundation-product))))))
(define foundation-terminal (pronunciation-terminal foundation-plan))
(define foundation-body (some-value (_0 foundation-terminal)))
assert(Eq 1
  (contains? "data-foundry-foundations=\"authored\"" foundation-body))
assert(Eq 1 (contains? "data-foundry-density=\"regular\"" foundation-body))
assert(Eq 1
  (contains? "data-foundry-motion=\"respect-preference\"" foundation-body))
assert(Eq 1 (contains? "--surface-ink:#202124" foundation-body))
assert(Eq 1
  (contains? "--surface-sidebar:clamp(230px,22vw,330px)" foundation-body))
;;; The live Desktop packet has seven ordinary one-shot observers sharing one
;;; packet id: exact shell state plus six authored Nenex dependencies.
;;; This is truthful
;;; fan-in over the existing Weft packet store, not a fabricated multi-watch
;;; attribute.  The message Hole remains an independently mounted /chat/log
;;; report inside the terminal pronunciation.
assert(Equal "/observe/x/$case/1/chat" frames-watch)
assert(Equal
  "/observe/z/$case/3/nenex/w/header_text_style"
  frames-authored-watch)
assert(Equal
  "/observe/z/$case/3/nenex/w/plate_header_block"
  frames-contract-watch)
assert(Equal
  ["/observe/z/$case/3/nenex/w/chat_foundation"
   "/observe/z/$case/3/nenex/w/web_chat_provider"
   "/observe/z/$case/3/nenex/w/high_contrast_guard"
   "/observe/z/$case/3/nenex/w/reduced_motion_guard"]
  frames-foundation-watches)
(define authored-desktop-page
  (chat-page [(ts "chat")] [(ts "chat") (ts "desktop")]
    corpus-a source-tree authored-header-pages))
(define authored-desktop-packet
  (frame-packet-id [(ts "chat")] "desktop"))
assert(Eq 1 (contains? (strcat ["w-observe=" 34 frames-watch 34])
  authored-desktop-page))
assert(Eq 1 (contains? (strcat ["w-observe=" 34 frames-authored-watch 34])
  authored-desktop-page))
assert(Eq 7
  (text-count (strcat ["w-packet=" 34 authored-desktop-packet 34])
    authored-desktop-page 0 0))
assert(Eq 1 (contains? (strcat ["hidden=" 34 "hidden" 34])
  authored-desktop-page))
assert(Eq 1 (contains? "/chat/log" authored-desktop-page))
;;; A duplicate authored semantic name is refused by corpus admission.  Chat
;;; does not repair or choose between owners; it reuses the exact static packet.
(define duplicate-authored-product
  (packet-product-authored
    [(ts "chat")] "desktop" corpus-a source-tree authored-header-duplicate))
assert(Equal frames-a (_0 duplicate-authored-product))
(define absent-authored-product
  (packet-product-authored
    [(ts "chat")] "desktop" corpus-a source-tree (axal-new mnone)))
assert(Equal frames-a (_0 absent-authored-product))

;;; Missing Header Text Style attributes remain an admitted semantic graph but
;;; pronounce through the bounded fallback.  No authored value is copied into
;;; arbitrary CSS.
(define missing-header-product
  (packet-product [(ts "chat")] "desktop" corpus-header-missing source-tree))
(define missing-header-plan
  (some-value
    (pronunciation-result
      (pronounce (some-value (_1 missing-header-product))))))
(define missing-header-terminal (pronunciation-terminal missing-header-plan))
(define missing-header-body (some-value (_0 missing-header-terminal)))
assert(Eq 1
  (contains? "data-foundry-header-style=\"safe-fallback\"" missing-header-body))
assert(Eq 1 (contains? "data-header-size=\"header\"" missing-header-body))
;;; Authored Desktop placement order reaches HTML untouched: Life precedes
;;; Chat, and both live Hole reports derive from their plan metadata.
assert(Lt (text-index "Scene Plate / background" terminal-body-a 0)
  (text-index "Scene Plate / foreground" terminal-body-a 0))
assert(Eq 1 (contains? "/app/life/board" terminal-body-a))
assert(Eq 1 (contains? "/chat/log" terminal-body-a))
assert(Eq 1 (contains? "data-semantic-fallback" terminal-body-a))
assert(Eq 1 (contains? "/life/fallback/plate" terminal-body-a))
assert(Eq 1
  (contains? "/foundry/chat/recipes/message_log_pending_fallback"
    terminal-body-a))
;;; Hydration enters the DAG as typed text; the late policy reads that typed
;;; parameter instead of assuming the older iota/name representation.
(define contrast-product
  (packet-product [(ts "chat")] "desktop" corpus-layer-contrast source-tree))
(define contrast-plan
  (some-value
    (pronunciation-result (pronounce (some-value (_1 contrast-product))))))
(define contrast-terminal (pronunciation-terminal contrast-plan))
assert(Equal mnone (Hd (_1 contrast-terminal)))
assert(Eq 1
  (contains? "pronunciation-contrast" (some-value (_0 contrast-terminal))))
(define framed
  (frame-record (frame-context source-tree corpus-a)))
(define pronounced (txt-at [(ts "projection_frames")] framed))
assert(Eq 1 (contains? "pronunciation" pronounced))
assert(Eq 1 (contains? "semanticAddress" pronounced))
assert(Eq 1 (contains? "text/html" pronounced))

;;; A non-pronounceable DAG is refused at the late boundary rather than
;;; falling back to the legacy SurfaceTree constructor chain.
(define bad-manifest
  (make-manifest
    (manifest-revision (frame-manifest (Ix 0 frames-a)))
    [(some-value (frame-address (Ix 1 frames-a)))] [] []))
(define bad-plan-result (pronounce (make-dag bad-manifest [])))
assert(Equal mnone (Hd (pronunciation-result bad-plan-result)))

;;; The unary adapter refuses absent context branches before hashing or
;;; rendering.  HTTP additionally checks that the corresponding Sights exist.
(define no-context (frame-record (axal-new mnone)))
assert(Equal (ts "corpus_evidence_missing")
  (_0 (pail-at [(ts "projection_frames_code")] no-context)))
(define no-source-context
  (axal-rep [(ts "foundry")] corpus-a (axal-new mnone)))
(define no-source-record (frame-record no-source-context))
assert(Equal (ts "source_evidence_missing")
  (_0 (pail-at [(ts "projection_frames_code")] no-source-record)))

;;; Stable occurrence -> Plate with semantic action and independently live Hole.

(define plate (plate-tree myth-new))
assert(Eq 1 (tree-valid plate))
assert(Equal ("/boot/maybe/some" [(ts "chat") (ts "plate")])
  (role-at [] plate))
assert(Equal ("/boot/maybe/some" [(ts "chat") (ts "plate") (ts "header")])
  (role-at [(ts "header")] plate))
assert(Equal ("/boot/maybe/some" (ts "pending"))
  (state-of (record-at [(ts "messages")] plate)))
assert(Equal ("/boot/maybe/some" [(ts "chat") (ts "log")])
  (action-of (record-at [(ts "composer")] plate)))
assert(Equal ("/boot/maybe/some" messages-report)
  (report-of (record-at [(ts "messages")] plate)))

;;; Live log -> ordered semantic message structure, before any renderer.

(define log2 (log-two "a" "first" "b" "second"))
(define messages (messages-tree log2))
assert(Eq 1 (tree-valid messages))
assert(Equal ("/boot/maybe/some" [(ts "chat") (ts "messages")])
  (role-at [] messages))
assert(Equal "first"
  (txt-at [(ts "surface") (ts "text")]
    (record-at [("u" 0) (ts "body")] messages)))
assert(Equal "second"
  (txt-at [(ts "surface") (ts "text")]
    (record-at [("u" 1) (ts "body")] messages)))

;;; Structural recipes compose without renderer payloads or namespace objects.

(define scene (scene-tree plate))
(define shrine (shrine-tree scene))
(define desktop (desktop-tree shrine))
assert(Eq 1 (tree-valid scene))
assert(Eq 1 (tree-valid shrine))
assert(Eq 1 (tree-valid desktop))
assert(Equal ("/boot/maybe/some" [(ts "chat") (ts "scene")])
  (role-at [] scene))
assert(Equal ("/boot/maybe/some" [(ts "shrine") (ts "scene")])
  (role-at [] shrine))
assert(Equal ("/boot/maybe/some" [(ts "stage_flow") (ts "root_scene")])
  (role-at [] desktop))
assert(Equal ("/boot/maybe/some" (ts "scene"))
  (kind-of (record-at [] desktop)))
assert(Equal ("/boot/maybe/some" [(ts "life") (ts "plate")])
  (role-at [(ts "windows") (ts "life")] desktop))
assert(Equal ("/boot/maybe/some" (ts "pending"))
  (state-of (record-at [(ts "windows") (ts "life")] desktop)))

;;; The backwards Desktop-placement leg is an existing kook law over ordinary
;;; poke payloads.  Valid geometry updates only overlay state; invalid geometry
;;; is an observational no-op.
(define layout0 desktop-layout-seed)
(define layout1
  (desktop-layout-apply layout0
    (geometry-card 144 92 760 540)))
assert(Eq 144 (nat-at [(ts "geometry") (ts "x")] 0 layout1))
assert(Eq 760 (nat-at [(ts "geometry") (ts "width")] 0 layout1))
(define refused-layout
  (desktop-layout-apply layout1
    (geometry-card 144 92 0 500)))
assert(Equal layout1 refused-layout)

;;; Hydration precedence and provenance are inspectable and renderer-neutral.

(define normal (hydrated desktop))
(define contrast (contrasted desktop))
assert(Eq 1 (tree-valid normal))
assert(Eq 1 (tree-valid contrast))
(define normal-root (record-at [] normal))
(define contrast-root (record-at [] contrast))
assert(Equal "green"
  (txt-at [(ts "foundry") (ts "resolved") (ts "color") (ts "accent")]
    normal-root))
assert(Equal "contrast"
  (txt-at [(ts "foundry") (ts "resolved") (ts "color") (ts "accent")]
    contrast-root))
assert(Equal [(ts "client") (ts "accessibility")]
  (_0 (pail-at
    [(ts "foundry") (ts "provenance") (ts "color") (ts "accent")]
    contrast-root)))

;;; Terminal adapters are late, distinct pronunciations of the same IR.

(define rendered (frag-render (web-record contrast)))
assert(Eq 200 (Ix 0 rendered))
assert(Eq 1 (contains? "pronunciation-contrast" (Ix 1 rendered)))
assert(Eq 1 (contains? "desktop-stage" (Ix 1 rendered)))
assert(Eq 1 (contains? "/project/" (Ix 1 rendered)))
assert(Eq 1 (contains? "/post/chat/log" (Ix 1 rendered)))

(define text-out (text-record messages))
(define plain (txt-at [(ts "text")] text-out))
assert(Eq 1 (contains? "first" plain))
assert(Eq 1 (contains? "second" plain))
assert(Eq 0 (contains? "<article" plain))

(print "foundry chat vertical tests passed")
