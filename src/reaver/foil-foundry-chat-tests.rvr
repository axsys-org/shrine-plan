(define (scene-surface-source title subtitle)
  (unlines
    [";@ /foundry/kind surface"
     ";@ /foundry/name ;/foundry/chat/surfaces/chat_scene"
     ";@ /surface/root ;/foundry/chat/nodes/chat_scene"
     ";. /foundry/chat/surfaces/chat_scene"
     "  ;@ /surface/kind scene"
     "  ;@ /surface/role ;/projection/chat/scene"
     "  ;. /foundry/chat/nodes/chat_scene"
     "    ;@ /surface/kind block"
     "    ;@ /surface/role ;/projection/chat/scene/header"
     "    ;@ /surface/place ;/slot/header"
     "    ;. /foundry/chat/nodes/chat_scene/header"
     "      ;@ /surface/kind text"
     "      ;@ /surface/role ;/projection/chat/scene/header/title"
     (strcat ["      ;@ /surface/text " title])
     "      ;@ /surface/place ;/slot/title"
     "      ;. /foundry/chat/nodes/chat_scene/header/title"
     "      ;@ /surface/kind text"
     "      ;@ /surface/role ;/projection/chat/scene/header/subtitle"
     (strcat ["      ;@ /surface/text " subtitle])
     "      ;@ /surface/place ;/slot/subtitle"
     "      ;. /foundry/chat/nodes/chat_scene/header/subtitle"
