(define catalog-src
  (unlines
    [";@ /foundry/kind catalog"
     ";@ /foundry/name ;/foundry/chat/catalogs/test_desktop"
     ";@ /catalog/source ;/chat"
     ";@ /catalog/source_role ;/chat"
     ";@ /catalog/target_role ;/stage_flow"
     ";@ /catalog/ceiling scene"
     (strcat
       [";@ /catalog/recipes ;/foundry/chat/recipes/messages"
        " ;/foundry/chat/recipes/chat_plate"
        " ;/foundry/chat/recipes/chat_scene"
        " ;/foundry/chat/recipes/shrine_scene"
        " ;/foundry/chat/recipes/desktop_stage"
        " ;/foundry/chat/recipes/hydrate_stage"
        " ;/foundry/chat/recipes/web_stage"])
     (strcat
       [";@ /catalog/layers ;/foundry/chat/layers/base"
        " ;/foundry/chat/layers/winning_test_layer"])
     ";@ /catalog/terminal_role ;/renderer/web"
     ";. /foundry/chat/catalogs/test_desktop"]))

(define (recipe-src name role kind primitive ceiling native template)
  (unlines
    (Weld
      [";@ /foundry/kind recipe"
       (strcat [";@ /foundry/name ;" name])
       (strcat [";@ /recipe/role ;" role])
       ";@ /recipe/input surface_tree"
       (strcat [";@ /recipe/output_kind " kind])
       (strcat [";@ /recipe/primitive " primitive])
       (strcat [";@ /recipe/ceiling " ceiling])
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/shrine"
       (strcat [";@ /recipe/native ;" native])]
      (Weld
        (Ifz template [] [(strcat [";@ /recipe/template ;" template])])
        [(strcat [";. " name])]))))

