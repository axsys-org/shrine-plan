(define mnone "/boot/maybe/none")
(define msome "/boot/maybe/some")
(define nl 10)
(define (unlines xs)
  (foldl (lambda (a x) (strcat [a x nl])) "" xs))
(define (some-value x)
  assert(Equal msome (Hd x))
  (_0 x))
(define (some x) ("/boot/maybe/some" x))
(define (wire-body encoding)
  assert(Eq 1 (encoding-admitted encoding))
  (some-value (encoding-body encoding)))
(define (resolved-accent-json value)
  (strcat
    [34 "key" 34 ":[" 34 "foundry" 34 "," 34 "resolved" 34 ","
     34 "token" 34 "," 34 "color" 34 "," 34 "accent" 34 "],"
     34 "value" 34 ":{" 34 "kind" 34 ":" 34 "text" 34 ","
     34 "value" 34 ":" 34 value 34 "}"]))
(define (mount-source full src)
  (foldl
    (lambda (out e) (axal-put (_0 e) (_1 e) out))
    full (some-value (compile-mount-records src))))
(define (corpus-of sources)
  (axal-dip [(ts "foundry")]
    (foldl mount-source (axal-new mnone) sources)))
(define (page-tree source)
  (axal-dip [("u" 0)] (sd-remount (sd-parse source))))
(define (authored-page name source pages)
  (axal-rep [(ts name)] (page-tree source) pages))

(define (put-nat t slot n) (myth-add (twig-nat slot n) t))
(define (put-txt t slot value) (myth-add (twig-txt slot value) t))
(define (put-pat t slot value) (myth-add (twig-pat slot value) t))
(define (geometry-card x y width height)
  (put-nat
    (put-nat
      (put-nat
        (put-nat myth-new [(ts "geometry") (ts "x")] x)
        [(ts "geometry") (ts "y")] y)
      [(ts "geometry") (ts "width")] width)
    [(ts "geometry") (ts "height")] height))

(define (record-at path tree)
  (define got (tree-record path tree))
  assert(Equal "/boot/maybe/some" (Hd got))
  (_0 got))
(define (occurrence-at-role role pronunciation)
  (define occurrences (pronunciation-occurrences pronunciation))
  (define (go i)
    assert(Lt i (Sz occurrences))
    (define occurrence (Ix i occurrences))
    (If (Equal role (occurrence-role occurrence))
      occurrence
      (go (Inc i))))
  (go 0))


(define (role-at path tree)
  (role-of (record-at path tree)))

;;; The frame producer consumes two explicit read-only responder Sights and
;;; never commits a packet or projection occurrence.
assert(Equal "/chat/frames" frames-url)

;;; A minimal but complete mounted corpus exercises the real Chat producer.
;;; Every input is canonical Semidoc compiled into the same inert records used
;;; by boot mounting; no namespace projection packet is fabricated by the test.

