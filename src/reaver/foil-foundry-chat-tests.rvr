    [catalog-src base-layer-no-header-src layer-src message-surface-src
     plate-surface-src plate-header-template-src scene-surface-src
     shrine-surface-src desktop-src]
    recipe-sources)))
(define (header-style-record size weight line tracking)
  (define r0 (put-txt myth-new [(ts "kind")] "doc"))
  (define r1
    (put-pat r0 [(ts "id")]
      [(ts "authoring") (ts "foundations") (ts "type") (ts "header")]))
  (define r2 (put-txt r1 [(ts "foundry") (ts "kind")] "layer"))
  (define r3
    (put-pat r2 [(ts "foundry") (ts "name")]
      [(ts "foundry") (ts "system") (ts "styles") (ts "header_text")]))
  (define r4 (put-txt r3 [(ts "foundry") (ts "guarded")] "false"))
  (define r5
    (put-pat r4
      [(ts "token") (ts "type") (ts "header") (ts "family")]
      [(ts "token") (ts "type") (ts "family") (ts "interface")]))
  (define r6
    (put-pat r5 [(ts "token") (ts "type") (ts "header") (ts "size")] size))
  (define r7
    (put-pat r6 [(ts "token") (ts "type") (ts "header") (ts "weight")] weight))
  (define r8
    (put-pat r7
      [(ts "token") (ts "type") (ts "header") (ts "line_height")] line))
  (put-pat r8
    [(ts "token") (ts "type") (ts "header") (ts "tracking")] tracking))
(define authored-header-pages
  (axal-rep [(ts "header_text_style")]
    (axal-new (some
      (header-style-record
        [(ts "token") (ts "type") (ts "scale") (ts "large_title")]
        [(ts "token") (ts "type") (ts "weight") (ts "bold")]
        [(ts "token") (ts "type") (ts "line_height") (ts "relaxed")]
        [(ts "token") (ts "type") (ts "tracking") (ts "wide")])))
    (axal-new mnone)))
(define authored-header-duplicate
  (axal-rep [(ts "header_text_style_copy")]
    (axal-new (some
      (header-style-record
        [(ts "token") (ts "type") (ts "scale") (ts "large_title")]
        [(ts "token") (ts "type") (ts "weight") (ts "bold")]
        [(ts "token") (ts "type") (ts "line_height") (ts "relaxed")]
        [(ts "token") (ts "type") (ts "tracking") (ts "wide")])))
    authored-header-pages))
(define foundation-layer-src
