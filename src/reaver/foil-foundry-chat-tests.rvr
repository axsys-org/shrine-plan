;;; The complete Chat Foundry vertical: source occurrence -> renderer-neutral
;;; Plate -> Scene -> Shrine Scene -> Desktop Stage -> hydration -> adapters.

(define sut (stage:sut-of "apps/chat/main"))
(define (app path) (foil:source-entry-val path sut))
(define pronounce-sut (stage:sut-of "foundry_pronounce_access"))
(define (pronounce-app path) (foil:source-entry-val path pronounce-sut))
(define (ts s) ("ts" s))

(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))
(define (text-index needle hay i)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (If (Gt (Add i nb) hb)
    hb
    (If (Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb))))
      i
      (text-index needle hay (Inc i)))))
(define (text-count needle hay i acc)
  (define at (text-index needle hay i))
  (If (Eq at (Bytes hay))
    acc
    (text-count needle hay (Add at (Bytes needle)) (Inc acc))))

