;;;; The compile buddy — the forge for a terminal next to your editor.
;;;; One resident session that is a compiler (auto-resync on save), a
;;;; repl (bare expressions evaluate against the focused module's live
;;;; subject), and a test harness (doctests run on every resync).
;;;;
;;;; Two source actors feed the main loop: one pumps stdin lines, one
;;;;  accepts "poke" connections (wire :w in vim to nc — see doc/buddy.md)
;;;; so saves resync without touching the buddy. See doc/buddy.md.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind parse (#module parse))
(#import parse)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind async (#module async))
(#bind foil (#module foil))
(#bind forge (#module forge))
(#bind forge-cli (#module forge-cli))




(define NL (strcat [10]))
(define ESC 27)
(define (ansi code s) (strcat [ESC "[" code "m" s ESC "[0m"]))
(define (green s) (ansi "32" s))
(define (red s)   (ansi "31" s))
(define (dim s)   (ansi "2" s))

;;; Sync: recompile what changed on disk ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (mod-bundle fst mod)
  (find (lambda (b) (Eq mod (forge:bundle-mod b))) (forge:st-bundles fst)))

;; A bundle is stale when its stamp snapshot no longer holds — its
;; own file or any import (at any depth) was rewritten since the
;; compile.  Stamps only: a clean resync stats the tree, reading and
;; parsing nothing.
(define (mod-stale? fst mod)
  (define hit (mod-bundle fst mod))
  (Or (Nil hit)
    (Nil (forge:snapshot-fresh? (forge:bundle-imports (_0 hit))))))

(define (insert-bundle fst b)
  (snap 1 (snoc b) (forge:state-evict fst (forge:bundle-mod b))))

(define (run-tests sut lore)
  (foldl (lambda (acc l)
           (Weld acc (map (forge:run-doctest sut) (forge:lore-tests l))))
    [] lore))

(define (doctest-chip results fails)
  (define n (Sz results))
  (define nf (Sz fails))
  (cond
    ((Nil n) "")
    (nf (red (strcat [(showNat nf) " of " (showNat n) " doctests failing"])))
    (else (green (strcat [(showNat n) "/" (showNat n) " doctests pass"])))))

(define (bundle-report b)
  (define mod (forge:bundle-mod b))
  (If (Nil (forge:bundle-ok? b))
    (Weld [(strcat [mod ": " (red "does not compile")])]
      (map (strWeld "  ") (forge:diag-lines (forge:bundle-err b))))
    (let* ((results (run-tests (forge:bundle-sut b) (forge:bundle-lore b)))
           (fails (filter (lambda (r) (Ne "pass" (_0 r))) results))
           (chip (doctest-chip results fails)))
      (Weld
        [(strcat [mod ": " (green "compiled")
                  (Ifz (Bytes chip) "" (strcat ["  " chip]))])]
        (map forge-cli:dt-res-line fails)))))

;; Recompile every module whose stamps moved, one actor per
;; module, all seeded with the same pruned persistent cache — an
;; edited module's unchanged imports come from the cache instead of
;; recompiling, and independent modules compile concurrently.  The
;; per-actor caches merge back by name (entries for the same module
;; compiled from the same bytes are identical).
(define (cache-merge base caches)
  (If (And (IsApp base) (Eq "FOIL_ARTIFACT_CACHE" (_0 base)))
    (foldl
      (lambda (acc c)
        (foldl (lambda (a e) (foil:artifact-cache-put a (_0 e) (_1 e)))
          acc (foil:artifact-cache-entries c)))
      base caches)
    (foldl
      (lambda (acc c)
        (foldl
          (lambda (a e)
            (If (includes (lambda (x) (Eq (_0 e) (_0 x))) a)
              a
              (snoc e a)))
          acc c))
      base caches)))

(define (sync fst)
  (define changed (filter (mod-stale? fst) forge:forge-mods))
  (Ifz (Sz changed)
    [fst [(dim "up to date")]]
    (let* ((seed (forge:st-live-cache fst))
           (artifact? (And (IsApp seed) (Eq "FOIL_ARTIFACT_CACHE" (_0 seed))))
           (rs (async:async-all-deep
                 (lambda (mod)
                   (If artifact?
                     (forge:load-bundle-artifact-cached seed mod)
                     (forge:load-bundle-cached seed mod)))
                 changed))
           (bundles (map (Ix 1) rs))
           (cache2 (cache-merge seed (map (Ix 0) rs)))
           (stored (If artifact? cache2 (forge:cache-wrap cache2)))
           (fst2 (forge:set-st-cache stored fst)))
      [(foldl insert-bundle fst2 bundles)
       (foldl (lambda (acc b) (Weld acc (bundle-report b))) [] bundles)])))

;;; The command step: (state, line) -> [state' rows quit?] ;;;;;;;;;;;;;;;;;;;;;;;;;

(define (mk-bud fst focus vars) ["BUD" fst focus vars])
(define (bud fst focus) (mk-bud fst focus []))
(define bud-fst (Ix 1))
(define bud-focus (Ix 2))
(define bud-vars (Ix 3))

;;; Repl variables: grafted onto the focused subject at each eval as
;;; FFI entries (a runtime value with a type), so bare names resolve
;;; exactly like sibling module declarations — and they survive
;;; resyncs, since the graft happens against whatever bundle is
;;; current. `name = expr` binds; :vars lists.

(define (graft-vars sut vars)
  (foldl (lambda (s v) (insert-ffi [(_0 v)] (_1 v) (_2 v) s)) sut vars))

(define (ident-char? c)
  (Or (And (Ge c 97) (Le c 122))
    (Or (And (Ge c 65) (Le c 90))
      (Or (And (Ge c 48) (Le c 57)) (Eq c 95)))))

;; "name = expr" with a plain identifier before the =; 0 otherwise.
(define (bind-split line)
  (define n (Bytes line))
  (define (ident-end i)
    (If (And (Lt i n) (ident-char? (Load8 i line))) (ident-end (Inc i)) i))
  (define i (ident-end 0))
  (define rest (forge:str-drop i line))
  (If (And (Gt i 0) (And (forge:str-prefix? " = " rest) (Gt n (Add i 3))))
    [(forge:str-slice 0 i line) (forge:str-drop (Add i 3) line)]
    0))

(define (var-line v)
  (strcat [(_0 v) " : " (forge:ty-text (_2 v)) " = " (forge:render-plain (_1 v))]))

(define (eval-grafted b expr k)
  (forge-cli:with-bundle (bud-fst b) (bud-focus b)
    (lambda (fst1 bun)
      (define res (forge:eval-text (graft-vars (forge:bundle-sut bun) (bud-vars b)) expr))
      (If (Eq 1 (Hd res))
        [fst1 (strcat ["error:" NL (forge:diag-text (_0 res))]) 1]
        (k fst1 (_0 (_0 res)) (_1 (_0 res)))))))

(define (cmd-eval-vars b expr)
  (define r
    (eval-grafted b expr
      (lambda (fst1 val ty)
        [fst1
         (join-str NL
           (Weld [(strcat ["value: " (forge:render-plain val)])
                  (strcat ["type:  " (forge:ty-text ty)])]
             (If (forge:law-like? val) ["" (forge:render-law val)] [])))
         0])))
  [(mk-bud (_0 r) (bud-focus b) (bud-vars b)) [(_1 r)] 0])

(define (cmd-bind b name expr)
  (define r
    (eval-grafted b expr
      (lambda (fst1 val ty) [fst1 [name val ty] 0])))
  (If (_2 r)
    [(mk-bud (_0 r) (bud-focus b) (bud-vars b)) [(_1 r)] 0]
    (let* ((v (_1 r))
           (vars (snoc v (filter (lambda (w) (Ne name (_0 w))) (bud-vars b)))))
      [(mk-bud (_0 r) (bud-focus b) vars) [(var-line v)] 0])))

(define (cmd-vars b)
  (Ifz (Sz (bud-vars b))
    [b [(dim "no variables — bind with: name = expr")] 0]
    [b (map var-line (bud-vars b)) 0]))

(define help-rows
  ["the compile buddy"
   ""
   "  <expr>        evaluate against the focused module"
   "  name = expr   bind a repl variable (usable in later expressions)"
   "  :vars         list bound variables"
   "  <enter>       resync: recompile changed modules, run their doctests"
   "  :m <mod>      switch focus"
   "  :ns [root]    list namespaces, or entries under one root"
   "  :ls           entries of the focused module"
   "  :s <dotted>   inspect one entry (type, lore, refs, law, source)"
   "  :r <dotted>   who-calls / called-by"
   "  :t            run every doctest in the focused module"
   "  :h            this help"
   "  :q            quit"])

(define (strip-prefix pre s)
  (forge:str-drop (Bytes pre) s))

(define (via-cli b r[fst text _bad])
  [(mk-bud fst (bud-focus b) (bud-vars b)) [text] 0])

(define (buddy-step b line)
  (define fst (bud-fst b))
  (define focus (bud-focus b))
  (cond
    ((Eq line ":q") [b [(dim "bye")] 1])
    ((Eq line ":h") [b help-rows 0])
    ((Eq line "")
      (let ((r (sync fst)))
        [(mk-bud (_0 r) focus (bud-vars b)) (_1 r) 0]))
    ((Eq line ":vars") (cmd-vars b))
    ((forge:str-prefix? ":m " line)
      (let ((m (strip-prefix ":m " line)))
        [(mk-bud fst m (bud-vars b)) [(strcat ["focus: " m])] 0]))
    ((Eq line ":ns")
      (via-cli b (forge-cli:cmd-ns fst "")))
    ((forge:str-prefix? ":ns " line)
      (via-cli b (forge-cli:cmd-ns fst (strip-prefix ":ns " line))))
    ((Eq line ":ls")
      (via-cli b (forge-cli:cmd-ls fst focus)))
    ((forge:str-prefix? ":s " line)
      (via-cli b (forge-cli:cmd-show fst focus (strip-prefix ":s " line))))
    ((forge:str-prefix? ":r " line)
      (via-cli b (forge-cli:cmd-refs fst focus (strip-prefix ":r " line))))
    ((Eq line ":t")
      (via-cli b (forge-cli:cmd-doctest fst focus)))
    (else
      (let ((bs (bind-split line)))
        (Ifz bs
          (cmd-eval-vars b line)
          (cmd-bind b (_0 bs) (_1 bs)))))))

;;; Source actors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Pump stdin lines to the main loop; ["eof"] on ctrl-d.
(define (stdin-pump self)
  (define mc (Recv 0))
  (define out (Ix0 (Ix1 mc)))
  (define (loop z)
    (define chunk (foil:read-stdin 384))
    (Ifz chunk
      (Send out ["eof"])
      (Seq (Send out ["line" (foil:read-until 10 chunk)])
        (loop z))))
  (loop 0))

;; Accept-and-close on the poke port; each connection means "something
;; was saved" (wire your editor's write hook to it).
(define (poke-pump port self)
  (define mc (Recv 0))
  (define out (Ix0 (Ix1 mc)))
  (define listen (Try Listen port))
  (If (Eq 1 (Hd listen))
    (Send out ["nopoke"])
    (let ((fd (_0 listen)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (CloseFd conn)
          (Seq (Send out ["poke"])
            (loop z))))
      (loop 0))))

;;; The resident loop ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Write consumes bar-encoded nats (the sentinel top byte is dropped
;; on write — natBytes, the inverse of bytesBar); a raw string loses
;; its final byte.
(define (put s)
  (Write 1 (strWeld s 1)))

(define (emit rows)
  (put (join-str NL (Weld rows [""]))))

(define (emit-prompt b)
  (put (strcat [(bud-focus b) "> "])))

(define (buddy-loop b)
  (define mc (Recv 0))
  (define msg (Ix0 mc))
  (define kind (_0 msg))
  (cond
    ((Eq kind "line")
      (let ((r (buddy-step b (_1 msg))))
        (Seq (emit (_1 r))
          (If (_2 r) 0
            (Seq (emit-prompt (_0 r))
              (buddy-loop (_0 r)))))))
    ((Eq kind "poke")
      (let ((r (sync (bud-fst b))))
        (let ((b1 (mk-bud (_0 r) (bud-focus b) (bud-vars b))))
          (Seq (emit (Weld ["" (dim "── save")] (_1 r)))
            (Seq (emit-prompt b1)
              (buddy-loop b1))))))
    ((Eq kind "nopoke")
      (Seq (emit [(dim "(poke port busy — resync with <enter> only)")])
        (buddy-loop b)))
        (else (buddy-loop b))))

(define (run-buddy-state port initial-state)
  (print "starting buddy")
  (define warm (sync initial-state))
  (print (DeepSeq warm "warm"))
  (define b (bud (_0 warm) "bst"))
  (print "b")
  (Seq (DeepSeq warm warm)
    (Seq (emit (Weld ["the compile buddy — :h for help" ""] (_1 warm)))
      (let* ((sin (Spawn stdin-pump))
             (pok (Spawn (poke-pump port))))
        (Seq (SendCaps sin ["go"] [0])
          (Seq (SendCaps pok ["go"] [0])
            (Seq (emit-prompt b)
              (buddy-loop b))))))))

(define (run-buddy port)
  (run-buddy-state port forge:empty-state))

(define (run-buddy-artifact-cached port cache)
  (run-buddy-state port (forge:empty-state-with-artifact-cache cache)))
