;;;; A module's public definition locations are supplied before elaboration.
;;;; No source spelling, storage pin, or installation path is an authority.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ca (#module cairn))
(#bind brand (#module shrine-brand))

(define tag "foil/context/v1")
(define module-tag "foil/module-context/v1")

;; roots : [[loader-name, canonical Shrine path]]
;; moments : [[loader-name, [[canonical Shrine path, positive x case]]]]
;; Each resolver binding selects its own revision, so two imports can
;; resolve the same public path at different moments in one context.
;; publication and sources are pinned immutable inputs to cache identity.
(define (create publication compiler sources roots moments artifacts)
  (define (unique rows)
    (foldl (lambda (seen pair)
      (If (ca:getax (_0 pair) seen)
        (error ["duplicate-context-binding" (_0 pair)])
        (ca:putax (_0 pair) (_1 pair) seen))) ca:empty-ax rows))
  (define (named rows) (map (lambda (pair) [[(_0 pair)] (_1 pair)]) rows))
  (define root-map (unique (named roots)))
  (define (assign pair)
    (define bindings (_1 pair))
    (define found (ca:getax [(_0 pair)] root-map))
    (define (checked entry)
      (If (Equal (_0 found) (take (Sz (_0 found)) (_0 entry)))
        (brand:encode (_0 entry) (_1 entry))
        (error ["definition-outside-module-root" (_0 pair) (_0 entry)])))
    (Ifz found (error ["unresolved-module-context" (_0 pair)])
      (DeepSeq (map checked bindings)
        [[(_0 pair)] (unique bindings)])))
  (If (Nil (And (IsPin publication) (And (IsPin compiler) (IsPin sources))))
    (error "compiler-context-requires-pinned-inputs")
    (If (Nil (Eq (Sz roots) (Sz moments)))
      (error "incomplete-module-assignments")
      (DeepSeq (map (lambda (pair) (brand:encode (_1 pair) 1)) roots)
        (force (tag publication compiler sources root-map
          (unique (map assign moments)) (unique (named artifacts))))))))

(define (require-context context)
  (If (And (IsApp context)
    (And (Eq tag (Hd context)) (Eq 6 (Sz context))))
    context (error "missing-compilation-context")))

(define (publication-key context) (_0 (require-context context)))
(define (compiler-key context) (_1 (require-context context)))
(define (module-context unit) (Unpin (_2 unit)))

(define (module context name)
  (define checked (require-context context))
  (define root (ca:getax [name] (_3 checked)))
  (define assignments (ca:getax [name] (_4 checked)))
  (If (And root assignments)
    (module-tag (_0 root) (_0 assignments) (Pin checked) name)
    (error ["unresolved-module-context" name])))

(define (artifact context name)
  (define checked (require-context context))
  (ca:getax [name] (_5 checked)))

(define (public-path unit local)
  (Weld (_0 unit) (map (lambda (name) ["ts" name]) local)))
(define (find-moment unit local)
  (define path (public-path unit local))
  (define found (ca:getax path (_1 unit)))
  (If found [[path (_0 found)]] 0))
(define (moment unit local)
  (define found (find-moment unit local))
  (If found (_0 found)
    (error ["unassigned-definition-moment" (public-path unit local)])))
(define (runtime-brand unit local)
  (define identity (moment unit local))
  (brand:encode (_0 identity) (_1 identity)))

;; Reverse identity lookup is independent of the resolver's source names.
;; A miss includes a known path at a different case. Only ts suffixes can
;; name source declarations; authority and module-root auras stay intact.
(define (local-definition unit identity)
  (define path (_0 identity))
  (define found (ca:getax path (_1 unit)))
  (define suffix (drop (Sz (_0 unit)) path))
  (If (And found (Equal (_0 found) (_1 identity)))
    (If (all (lambda (segment) (Equal "ts" (_0 segment))) suffix)
      [(map (Ix 1) suffix)]
      0)
    0))

;; Native type declarations participate in the system's prepared manifest.
;; Their source is the compiler's declaration table, not a file-loader name.
;; Selecting the compiler never assigns or advances their moments.
(define (native-unit context names)
  (define checked (require-context context))
  (define selected (Unpin (publication-key checked)))
  (define root [["ts" "sys"] ["ts" "types"]])
  (define (moment name)
    (define path (Weld root (map (lambda (part) ["ts" part]) name)))
    (define runtime-path (map (lambda (part) ((_0 part) (_1 part))) path))
    (define found (find (lambda (pair) (Equal runtime-path (_0 pair))) selected))
    (Ifz found (error ["unassigned-system-definition" path])
      (let ((version (_1 (_0 found))))
        (Seq (brand:encode path version) [path version]))))
  (define assigned (map moment names))
  (force (module-tag root
    (foldl (lambda (out pair) (ca:putax (_0 pair) (_1 pair) out))
      ca:empty-ax assigned) (Pin checked) "$system/core")))

;; Scope pins are storage identity only. The exact version assignments
;; isolate simultaneous revisions; brands encode the public moment above.
(define (storage-root unit)
  ["foil-module" (Pin [(_0 unit) (sort cmp-total (rowify (ca:tapax (_1 unit))))])])
(define (cache-key context name) ["foil-cache/v2" (Pin context) name])

(#export create require-context module public-path moment runtime-brand
         storage-root cache-key artifact publication-key compiler-key module-context
         local-definition native-unit find-moment)
