;;;; JSON text plumbing for the buddy's wire port: encoders that build
;;;; response text directly, and a compiled-module codec for json.foil's
;;;; nominal values. The parser stays in json.foil. Its exact constructor
;;;; identities are supplied by its artifact, never reconstructed from names.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind abi (#module foil-abi))
(#bind parse (#module parse))
(#import parse)

;;; Encoding: response text built by hand ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (hexd n)
  (If (Lt n 10) (Add "0" n) (Add "a" (Sub n 10))))

;; Escaped body bytes of s (no surrounding quotes).
(define (jesc s)
  (define n (Bytes s))
  (define bs 92)
  (define (go i)
    (If (Ge i n)
      0
      (let ((c (Load8 i s)))
        (cond
          ((Eq c 34) (lcons bs (lcons 34 (go (Inc i)))))
          ((Eq c 92) (lcons bs (lcons 92 (go (Inc i)))))
          ((Eq c 10) (lcons bs (lcons "n" (go (Inc i)))))
          ((Eq c 9) (lcons bs (lcons "t" (go (Inc i)))))
          ((Eq c 13) (lcons bs (lcons "r" (go (Inc i)))))
          ((Lt c 32)
            (lcons bs (lcons "u" (lcons "0" (lcons "0"
              (lcons (hexd (Div c 16)) (lcons (hexd (Mod c 16))
                (go (Inc i)))))))))
          (else (lcons c (go (Inc i))))))))
  (lstrcat (go 0)))

;; A quoted, escaped JSON string.
(define (jq s)
  (strcat [34 (jesc s) 34]))

;; An array of already-encoded element texts.
(define (jarr xs)
  (strcat ["[" (join-str "," xs) "]"]))

;; An object from [key encoded-value-text] pairs.
(define (jobj pairs)
  (strcat
    ["{"
     (join-str ","
       (map (lambda (p) (strcat [(jq (Ix 0 p)) ":" (Ix 1 p)])) pairs))
     "}"]))

(define (jarr-str xs) (jarr (map jq xs)))

;;; The compiled JSON module supplies every nominal identity. Decoded
;;; values are translated once into a private host tree; these layout tags
;;; are not Shrine brands and never escape as Foil values.
(define (codec perc)
  [(abi:constructor perc ["jres" "ok"])
   (abi:constructor perc ["jres" "err"])
   (abi:constructor perc ["jkv"])
   (map (lambda (pair)
     [(_0 pair) (abi:constructor perc ["json" (_0 pair)]) (_1 pair)])
     [["nul" 1] ["boo" 1] ["num" 2] ["real" 1]
      ["str" 1] ["arr" 1] ["obj" 1]])])

(define (shaped? brand arity value)
  (And (IsApp value)
    (And (Eq brand (Hd value)) (Eq arity (Sz value)))))
(define (jok? codec result) (shaped? (_0 codec) 2 result))
(define (jval result) (_0 result))

(define (normalize codec value)
  (define found (find (lambda (entry)
    (shaped? (_1 entry) (_2 entry) value)) (_3 codec)))
  (Ifz found (error ["unknown-json-brand-or-shape" value])
    (let ((name (_0 (_0 found))))
      (cond
        ((Equal name "arr")
          ("wire/json/arr" (map (normalize codec) (_0 value))))
        ((Equal name "obj")
          ("wire/json/obj" (map (lambda (member)
            (If (shaped? (_2 codec) 2 member)
              [(_0 member) (normalize codec (_1 member))]
              (error ["unknown-json-member-brand-or-shape" member]))) (_0 value))))
        ((Equal name "num") ("wire/json/num" (_0 value) (_1 value)))
        (else ((strWeld "wire/json/" name) (_0 value)))))))

(define (schema-value codec result)
  (If (jok? codec result) (normalize codec (_0 result))
    (If (shaped? (_1 codec) 2 result)
      (error ["schema-json" (_0 result) (_1 result)])
      (error ["unknown-json-result-brand-or-shape" result]))))

(define (jget key value)
  (If (shaped? "wire/json/obj" 1 value)
    (let ((hit (find (lambda (member) (Eq key (_0 member))) (_0 value))))
      (If hit (_1 (_0 hit)) 0)) 0))
(define (jstr value)
  (If (shaped? "wire/json/str" 1 value) (_0 value) 0))
(define (jnat fallback value)
  (If (shaped? "wire/json/num" 2 value)
    (If (_0 value) fallback (_1 value)) fallback))
(define (jget-str key value) (jstr (jget key value)))
(define (jget-nat key fallback value) (jnat fallback (jget key value)))

(define (jshow value)
  (cond
    ((shaped? "wire/json/nul" 1 value) "null")
    ((shaped? "wire/json/boo" 1 value) (If (_0 value) "true" "false"))
    ((shaped? "wire/json/str" 1 value) (jq (_0 value)))
    ((shaped? "wire/json/real" 1 value) (_0 value))
    ((shaped? "wire/json/num" 2 value)
      (strWeld (If (_0 value) "-" "") (showNat (_1 value))))
    ((shaped? "wire/json/arr" 1 value) (jarr (map jshow (_0 value))))
    ((shaped? "wire/json/obj" 1 value)
      (jobj (map (lambda (member) [(_0 member) (jshow (_1 member))]) (_0 value))))
    (else (error ["invalid-host-json-value" value]))))

;;; Diagnostic rows as a JSON array ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; rows = [[line col msg] ..] (line 0 = unlocated) — the shape
;; foil-render:diag-rows extracts from a compiler error payload.
(define (jdiags rows)
  (jarr
    (map
      (lambda (r)
        (jobj
          [["line" (showNat (Ix 0 r))]
           ["col" (showNat (Ix 1 r))]
           ["msg" (jq (Ix 2 r))]]))
      rows)))
