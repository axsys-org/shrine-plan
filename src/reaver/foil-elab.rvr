(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind cairn (#module cairn))

(#bind foil-surface (#module foil-surface))
(#import foil-surface)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil-env (#module foil-env))

(#bind ty (#module foil-types))

(#bind quip (#module quip))

;; Qualified so the ordinary elaborator never evaluates profiler effects.
(#bind profile-zone (#module profile-zone))

;;; Elaboration environment ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (burp-self type)
  (define tag (ty:type-tag type))
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TSELF") (burp-self (ty:tself-val type)))
      (else type)))
  ret)
(define (burp-face ty)
  (define tag (ty:type-tag ty))
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TFAC") (burp-face (ty:tfac-val ty)))
      ((tag-is "TSELF") (burp-face (ty:tself-val ty)))
      (else ty)))
  ret)

(define empty-env [0 0 0 0 0 0 0])
(define env-locals (Ix 0)) (define set-env-locals (Up 0))
(define env-diags (Ix 1))
(define env-name (Ix 2)) (define set-env-name (Up 2))
(define env-tvars (Ix 3)) (define set-env-tvars (Up 3))
;; Nearest enclosing source span (set by s_span nodes on the way down);
;; used to locate elaboration errors.
(define env-span (Ix 4)) (define set-env-span (Up 4))
;; Const generic parameters in scope: [[name declared-type] ...].
(define env-consts (Ix 5)) (define set-env-consts (Up 5))
;; The expected type of the expression being elaborated (checking
;; mode), or 0.  Set where the context declares a type — a cast body,
;; a typed local binding, call arguments against the callee's
;; parameters, constructor arguments against the row's fields, loop
;; inits against the seed types — and cleared at every descent into a
;; position whose expected type is unknown (scrutinees, callees,
;; receivers), so a stale goal never mis-checks an inner expression.
;; Read by relative-variant resolution and (later) checking-mode
;; lambda parameter inference.
(define env-goal (Ix 6)) (define set-env-goal (Up 6))
(define (clear-env-goal env) (set-env-goal 0 env))

;;; Located errors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (span-blurb span)
  (Ifz span "unknown-location"
    ["line" (Ix 0 span) "col" (Ix 1 span)]))

(define (elab-error env what detail)
  (error ["foil-elab-error" what ["at" (span-blurb (env-span env))] detail]))

(define (elab-unsupported env feature)
  (elab-error env ["unsupported syntax" feature]
    "specified but not yet implemented"))

;; metadata-environment :: Data -> Maybe Environment
;;
;; Draft compilation carries an Environment directly; completed subjects carry
;; the same sealed environment inside their Unit envelope.  Treat both forms as
;; authoritative.  Only subjects with neither representation are legacy.
(define (metadata-environment metadata)
  (cond
    ((foil-env:environment? metadata) metadata)
    ((foil-env:unit? metadata) (foil-env:unit-environment metadata))
    (else 0)))

;; set-metadata-environment :: Environment -> Subject -> Subject
;; Preserve a completed Unit envelope while refreshing its derived environment.
(define (set-metadata-environment environment sut)
  (define metadata (sut-unit sut))
  (set-sut-unit
    (If (foil-env:unit? metadata)
      (foil-env:unit-with-environment environment metadata)
      environment)
    sut))

;; retain-context-resolutions :: Subject -> TypeContext -> Subject
(define (retain-context-resolutions sut ctx)
  (define environment (metadata-environment (sut-unit sut)))
  (Ifz environment
    sut
    (set-metadata-environment
      (foil-env:environment-with-resolutions
        (ty:type-context-resolutions ctx) environment)
      sut)))

(define (push-env-tvars vars env)
  (set-env-tvars (Weld vars (env-tvars env)) env))
(define (env-has-tvar? var env)
  (find-idx (Eq var) (env-tvars env)))

(define (wrap-tquas vars typ)
  (Ifz vars typ
    (ty:TQUA (_0 vars) (wrap-tquas (drop 1 vars) typ))))

;; Normalize a type-valued elaboration to a TTYP wrapper (idempotent).
(define (as-ttyp typ)
  (If (Eq "TTYP" (ty:type-tag typ)) typ (ty:TTYP typ)))

;; A sealed path whose declaration has no usable public signature.  TC_CONST
;; is reserved for the predeclaration phase, and the payload distinguishes this
;; case from a typed prototype.  Once the declaration elaborates, its ordinary
;; TC replaces the marker; only a genuine forward/self reference can observe it.
(define untyped-prototype-mark "FOIL_UNTYPED_PROTOTYPE")
(define (untyped-prototype ignored)
  (tc-const ty:TANY untyped-prototype-mark))
(define (untyped-prototype? tc)
  (If (IsApp tc)
    (If (Eq "TC_CONST" (Hd tc))
      (Eq untyped-prototype-mark (tc-const-val tc))
      0)
    0))

;;; /ty-ap resolution ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The subject resolves an instantiation path to its generic's entry;
;; here — where types are in play — the decoded arguments specialize
;; the entry's type.

(define (applied-type sut path)
  (If (ty-ap-path? path)
    (let* ((parts (ty-ap-decode path))
           (gty (got-type (Ix 0 parts) sut))
           (nt (ty:count-tqua gty)))
      ;; type args substitute; const args don't change the type but DO
      ;; ground its /ty-var segments (member return types like
      ;; map[k lt]) once the TCQUA layers strip.
      (ty:subst-const-args
        (map (Ix 0) (ty:cqua-pairs gty))
        (drop nt (drop 1 parts))
        (ty:strip-cquas
          (ty:type-specialize sut gty
            (map ty:path-to-ty
              (take (min nt (Sz (drop 1 parts))) (drop 1 parts)))))))
    (got-type path sut)))

(define (applied-entry-tc sut path)
  (define tc (got-entry-tc path sut))
  (If (ty-ap-path? path)
    (let* ((parts (ty-ap-decode path))
           (nt (ty:count-tqua (tc-ty tc)))
           (nc (ty:count-cqua (tc-ty tc)))
           (supplied-c (Sub (Sub (Sz parts) 1) nt)))
      ;; A member's const params must all be supplied by the path —
      ;; there is no inference for constants.
      (If (Lt supplied-c nc)
        (error ["member with const parameters requires explicit specialization"
                ["path" path]])
        ;; A monomorphic member of a generic has nothing to specialize;
        ;; past that, a failed specialization is an error, not a
        ;; fallback.
        (let* ((cnames (map (Ix 0) (ty:cqua-pairs (tc-ty tc))))
               (cargs (drop nt (drop 1 parts)))
               (ground (lambda (typ)
                         (ty:subst-const-args cnames cargs
                           (ty:strip-cquas typ)))))
          (Ifz nt
            (set-tc-ty (ground (tc-ty tc)) tc)
            (let ((typ (ty:type-specialize sut (tc-ty tc)
                         (map ty:path-to-ty
                           (take (min nt (Sz (drop 1 parts)))
                             (drop 1 parts))))))
              (If (Eq "TBAD" (ty:type-tag typ))
                (error ("cannot specialize entry" path typ))
                (set-tc-ty (ground typ) tc)))))))
    tc))

;; Encode a specialization as a /ty-ap path: 0 if an argument type is
;; not path-shaped.
(define (spec-encode sut path targs)
  (define argps (map ty:ty-to-path targs))
  (If (any Nil argps)
    0
    (ty-ap-encode (Weld [(canon-path path sut)] argps))))

;;; Type elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (elab-type-env sut env wav[tag])
  (define (tag-is x) (Eq tag x))
  (define (on-tapp items[f])
    (define fields (map (elab-type-env sut env) (drop 1 items)))
    (cond
      ((Eq "s_variant" (_0 f))
        (ty:TROW (_1 f) fields))
      ((And (Eq "s_ref" (_0 f)) (Equal ["pin"] (surf-ref-path f)))
        (unless (Eq 1 (Sz fields))
          (ty:type-error ["bad-pin-arity" fields])
          (ty:TPIN (_0 fields))))
      ;; ('$foo) — a parenthesized constant symbol (the face position
      ;; x=('$foo); rex can't take a bare quip as a rune operand).
      ((And (Eq "s_tsym" (_0 f)) (Ifz (Sz fields) 1 0))
        (ty:TNAT (_1 f)))
      ((Eq "s_ref" (_0 f))
        (let ((enc (spec-encode sut (surf-ref-path f) fields)))
          (Ifz enc
            ;; Arguments with no path form (function types, anonymous
            ;; rows) can't ride a /ty-ap name: specialize structurally.
            (ty:type-specialize sut
              (got-type (canon-path (surf-ref-path f) sut) sut)
              fields)
            (ty:TNOM enc 0))))
      (else
        (ty:type-error "uimpl tapp"))))

  (cond
    ;; An anonymous structural row: bare TROW with cstr 0, never
    ;; TTYP-wrapped here — declaration sites re-wrap via as-ttyp and
    ;; brand the cstr at insert-typ; type-use positions get the bare
    ;; row (runtime head 0, outside UFCS).
    ((tag-is "s_trow")
      (ty:TROW 0 (map (elab-type-env sut env) (surf-row-kids wav))))
    ((tag-is "s_face")
     (ty:TFAC (surf-face-name wav)
       (elab-type-env sut env (surf-face-kid wav))))
    ((tag-is "s_row")
      (ty:TROW 0 (map (elab-type-env sut env) (surf-row-kids wav))))
    ((tag-is "s_union")
      (define ret (ty:TSUM (map (elab-type-env sut env) (surf-union-opts wav))))
      (ty:TTYP ret))
    ((tag-is "s_tfun")
      (ty:TFUN (map (elab-type-env sut env) (surf-fun-args wav))
        (elab-type-env sut env (surf-fun-ret wav))))
    ((tag-is "s_ref")
      (define path (surf-ref-path wav))
      (define nm (_0 path))
      (cond
        ((And (Eq 1 (Sz path)) (env-has-tvar? nm env)) (ty:TVAR nm))
        ;; const parameters ride the /ty-var namespace in encodings
        ((And (Eq 1 (Sz path))
           (find (lambda (pr) (Eq nm (_0 pr))) (env-consts env)))
          (ty:TVAR nm))
        ;; nat literals as const arguments (map[nat 3])
        ((And (Eq 1 (Sz path)) (str-numeric? nm))
          (ty:TNAT (parse-nat nm)))
        (else
          ;; Mounted import names normalize to the entry's canonical
          ;; path: nominal identity is independent of the written name.
          (ty:TNOM (canon-path path sut) 0))))
    ((tag-is "s_variant")
      (ty:TROW (_1 wav) []))
    ((tag-is "s_tsym")
      (ty:TNAT (_1 wav)))
    ((tag-is "s_tapp")
      (on-tapp (surf-tapp-kids wav)))
    ;; Relative variants and wildcards reach type elaboration only when
    ;; written outside a pattern (elab-pat intercepts them there).
    ((tag-is "s_relvar")
      (error ["foil-elab-error"
              "relative variant (.tag) is only meaningful in pattern or value position"
              ["tag" (_1 wav)]]))
    ((tag-is "s_hole")
      (error ["foil-elab-error"
              "wildcard (_) is only meaningful inside a match pattern" 0]))
      (else (error ("unimpl type elab" wav)))))

(define (elab-type sut wav)
  (elab-type-env sut empty-env wav))

;;; Source-reference provenance ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Value elaboration already threads a TypeContext, so resolved edges live in
;;; that context alongside the type-operation memo tables.  Type elaboration
;;; historically returned only a Type, however, and consequently every name
;;; used *as a type* bypassed the environment authority and left no retained
;;; edge.  Keep the public/pure type elaborator above, and pair it with this
;;; small stateful walk at checked declaration sites.

;; resolve-source-reference :: TypeContext -> Env -> Path -> TypeContext
;;
;; The retained foil-env value is the authority for source visibility and
;; unknown-vs-cull diagnostics.  SUT remains only the typed/linking projection
;; used after the winning layer has been established.
(define (resolve-source-reference ctx env path)
  (define metadata (sut-unit (ty:type-context-sut ctx)))
  (define environment (metadata-environment metadata))
  (Ifz environment
    ;; Inline/legacy callers have no unit environment; retain their historic
    ;; lookup behavior without manufacturing provenance.
    ctx
    (let* ((recorded
             (foil-env:resolve-record (env-span env) path environment))
           (environment1 (_0 recorded))
           (resolution (_1 recorded)))
      (cond
        ((foil-env:res-unknown? resolution)
          (elab-error env "unbound reference" ["path" path]))
        ((foil-env:res-null? resolution)
          (elab-error env "culled reference"
            ["path" path]
            ["culled-by"
             (foil-env:from-label (foil-env:res-from resolution))]
            ["layer" (foil-env:from-ref (foil-env:res-from resolution))]))
        (else
          (let ((resolutions
                  (foil-env:environment-resolutions environment1)))
            (ty:type-context-record-resolution
              (_0 (rev resolutions)) ctx)))))))

;; source-paths-for-canonical :: Path -> Subject -> Row Path
;;
;; Method dispatch selects a canonical (occasionally specialized) entry after
;; receiver typing.  Provenance belongs to the source-visible spelling in the
;; merged environment, so invert the subject's visibility projection before
;; recording it.
(define (source-paths-for-canonical canonical sut)
  (define base
    (If (ty-ap-path? canonical)
      (let ((parts (ty-ap-decode canonical)))
        (Ifz parts canonical (_0 parts)))
      canonical))
  (define vis (sut-visible sut))
  (Ifz vis
    []
    (let* ((root (sut-root sut))
           ;; Builtin row brands historically carry the compilation root even
           ;; though their canonical substrate entries are stored unrooted.
           ;; Match that representational alias through the same visibility
           ;; index; unit-qualified hidden storage has no such root prefix and
           ;; therefore remains sealed.
           (unrooted
             (If (foil-env:path-prefix? root base)
               (drop (Sz root) base)
               base)))
      (map
        (lambda (pair)
          (let ((written (_0 pair)))
            (If (foil-env:path-prefix? root written)
              (drop (Sz root) written)
              written)))
        (filter (lambda (pair)
                  (Or (Equal base (_1 pair))
                    (Equal unrooted (_1 pair))))
          (rowify (cairn:tapax vis)))))))

;; record-canonical-reference :: TypeContext -> Env -> CanonPath -> TypeContext
;; Compiler-synthesized structural accessors have no layer entry and therefore
;; no namespace edge.  Declared/generated exported methods do; record those
;; without turning a computed accessor into an artificial lookup failure.
(define (record-canonical-reference ctx env canonical)
  (define sources
    (source-paths-for-canonical canonical (ty:type-context-sut ctx)))
  ;; Repeated mounts may expose the same pinned definition at several paths.
  ;; Prefer the alias through which this receiver's type/value was already
  ;; resolved at the current site; otherwise Cairn's canonical traversal gives
  ;; a deterministic representative of the same winning layer.
  (define prior (ty:type-context-resolutions ctx))
  (define preferred
    (find
      (lambda (source)
        (let ((parent (Ifz (Sz source) [] (Init source))))
          (Truth
            (find (lambda (resolution)
                    (And
                      (Equal (env-span env)
                        (foil-env:resolution-site resolution))
                      (Or
                        (Equal source (foil-env:resolution-path resolution))
                        (Equal parent
                          (foil-env:resolution-path resolution)))))
              prior))))
      sources))
  (define source (Ifz preferred (Ifz sources 0 [(_0 sources)]) preferred))
  (Ifz source
    ctx
    (let* ((metadata (sut-unit (ty:type-context-sut ctx)))
           (environment (metadata-environment metadata))
           (answer
             (If environment
               (foil-env:resolve (_0 source) environment)
               0)))
      (If (And answer (foil-env:res-known? answer))
        (resolve-source-reference ctx env (_0 source))
        ctx))))

;; record-type-references :: TypeContext -> Env -> TypeSAST -> TypeContext
;;
;; This mirrors elab-type-env's accepted grammar.  Type/const binders and
;; singleton/numeric type literals are lexical or literal forms, not namespace
;; edges.  `pin` is likewise syntax in the type grammar rather than a lookup.
(define (record-type-references ctx env wav[tag])
  (define (record-many ctx0 xs)
    (foldl (lambda (acc x) (record-type-references acc env x)) ctx0 xs))
  (define (record-ref ctx0 ref)
    (define path (surf-ref-path ref))
    (define name (_0 path))
    (If (And (Eq 1 (Sz path))
          (Or (env-has-tvar? name env)
            (Or (str-numeric? name)
              (Truth
                (find (lambda (pair) (Eq name (_0 pair)))
                  (env-consts env))))))
      ctx0
      (resolve-source-reference ctx0 env path)))
  (cond
    ((Eq tag "s_ref") (record-ref ctx wav))
    ((Or (Eq tag "s_trow") (Eq tag "s_row"))
      (record-many ctx (surf-row-kids wav)))
    ((Eq tag "s_face")
      (record-type-references ctx env (surf-face-kid wav)))
    ((Eq tag "s_union")
      (record-many ctx (surf-union-opts wav)))
    ((Eq tag "s_tfun")
      (record-type-references
        (record-many ctx (surf-fun-args wav)) env (surf-fun-ret wav)))
    ((Eq tag "s_tapp")
      (let* ((items (surf-tapp-kids wav))
             (head (_0 items))
             (ctx1
               (If (And (Eq "s_ref" (_0 head))
                     (Equal ["pin"] (surf-ref-path head)))
                 ctx
                 (If (Eq "s_ref" (_0 head))
                   (record-ref ctx head)
                   ctx))))
        (record-many ctx1 (drop 1 items))))
    ;; Constructors, singleton symbols, relative variants, and holes do not
    ;; consult the unit namespace while elaborating a type.
    (else ctx)))

;; elab-type-context :: TypeContext -> Env -> TypeSAST -> [TypeContext Type]
(define (elab-type-context ctx env wav)
  [(record-type-references ctx env wav)
   (elab-type-env (ty:type-context-sut ctx) env wav)])

;; record-pattern-type-references :: TypeContext -> Env -> PatternSAST
;;                                -> TypeContext
;; Bare names in a pattern are binders.  Only faced annotations introduce a
;; type edge; nested row/variant patterns are walked to find those faces.
(define (record-pattern-type-references ctx env pat[tag])
  (define (many ctx0 xs)
    (foldl
      (lambda (acc x) (record-pattern-type-references acc env x))
      ctx0 xs))
  (cond
    ((Eq tag "s_face")
      (record-type-references ctx env (surf-face-kid pat)))
    ((Eq tag "s_trow") (many ctx (surf-row-kids pat)))
    ((Eq tag "s_tapp") (many ctx (drop 1 (surf-tapp-kids pat))))
    (else ctx)))

;;; Value elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (push-local-env env ty)
  (set-env-locals (Weld [ty] (env-locals env)) env))
(define (push-locals env tys)
  (set-env-locals (Weld tys (env-locals env)) env))

(define (peek-ret-cast sut env body[tag])
  (If (Eq "s_cast" tag)
    (elab-type-env sut env (surf-cast-ty body))
    ty:TBAD))

;;; Field accessors and functional update ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; For every face =x= of a named row type =T= we generate three UFCS
;; methods: =v.x= (get), =v.set_x(new)= (replace), and =v.over_x(fun)=
;; (apply a function to the field).  All are ordinary FFI entries, so
;; the regular =.= method machinery resolves them.

(define (row-set-at idx val rcvr)
  (Up idx val rcvr))
(define (row-over-at idx f rcvr)
  (Up idx (f (Ix idx rcvr)) rcvr))

;; For a generic row the accessors are quantified too: the receiver is
;; TNOM loc [vars], the fun type is TQUA-wrapped, and score-meth's
;; receiver-argument specialization instantiates them at use.
(define (gen-accessors loc vars cparams items sut)
  (define faces (ty:collect-faces items))
  (define param-segs
    (Weld (map (lambda (v) [ty-var-tag v]) (Ifz vars [] vars))
      (map (lambda (c) [ty-var-tag (_0 c)]) cparams)))
  (define self-ty
    (Ifz (Sz param-segs)
      (ty:TNOM loc 0)
      (ty:TNOM (ty-ap-encode (Weld [loc] param-segs)) 0)))
  (define (qua typ)
    (wrap-tquas (Ifz vars 0 vars) (ty:wrap-tcquas cparams typ)))
  (define (go sut arg[idx fac ty])
    (define get-tc (tc-ffi (qua (ty:TFUN [self-ty] ty)) (Ix idx)))
    (define set-tc
      (tc-ffi (qua (ty:TFUN [ty self-ty] self-ty)) (row-set-at idx)))
    (define over-tc
      (tc-ffi (qua (ty:TFUN [(ty:TFUN [ty] ty) self-ty] self-ty))
        (row-over-at idx)))
    (pipe sut
      (insert-tc (Weld loc [fac]) wack-span get-tc)
      (insert-tc (Weld loc [(strWeld "set_" fac)]) wack-span set-tc)
      (insert-tc (Weld loc [(strWeld "over_" fac)]) wack-span over-tc)))
  (foldl go sut faces))

(define (self-ty sut env args body)
  (define name (rear (env-name env)))
  (define ret (peek-ret-cast sut env body))
  (define inner (ty:TFUN args ret))
  (Ifz name
     (ty:TSELF inner)
     (ty:TSELF (ty:TFAC name inner))))

(define (match-face wan typ)
  (and (Eq (ty:type-tag typ) "TFAC") (Eq (ty:tfac-face typ) wan)))

(define (match-self typ) (Eq (ty:type-tag typ) "TSELF"))

(define (tc-fold-app f xs)
  (Ifz xs f
   (tc-fold-app (tc-app ty:TBAD f (_0 xs)) (drop 1 xs))))

(define (burp-span s[tag])
  (If (Eq "s_span" tag) (_2 s) s))

(define (score-meth obj meth sut)
  (define outer-ty (tc-ty obj))
  (define ty (burp-face (tc-ty obj)))
  (define tag (ty:type-tag ty))
  (define nom (If (Eq tag "TNOM") (ty:tnom-ref ty) 0))
  ;; member-path :: CanonPath -> CanonPath
  ;;
  ;; A namespace may be reopened by an upper unit: the receiver's nominal
  ;; entry then belongs to one unit while the selected member belongs to
  ;; another.  Follow each source-visible alias first so the union overlay wins;
  ;; a same-unit hidden member is the linking fallback when no visible layer
  ;; reopens it.  This is the linking counterpart to union-mount provenance.
  (define (member-path base)
    (define raw (snoc meth base))
    (define sources (source-paths-for-canonical base sut))
    (define source
      (find
        (lambda (parent)
          (get-const (canon-path (snoc meth parent) sut) sut))
        sources))
    (define selected
      (Ifz source
        (let ((hidden? (get-const raw sut)))
          ;; A sealed unit cannot call an existing method merely because its
          ;; target unit is present as hidden linking storage: source code must
          ;; mount the exposing layer.  Absence is different—nominal aliases
          ;; such as `path = row[quip]` must be allowed to fall through and
          ;; redispatch on their unfolded representation.
          (If (And hidden? (metadata-environment (sut-unit sut)))
            (error ["no source-visible method" ["path" raw] ["method" meth]])
            (If hidden? raw (canon-path raw sut))))
        (canon-path (snoc meth (_0 source)) sut)))
    selected)
  ;; A member of an instantiation is the instantiation of the member —
  ;; but only over the vars the member kept (drop-if-unused): pair the
  ;; parent's declared var names with the ridden args, keep the args
  ;; whose name appears in the member's own chain.  Downstream
  ;; positional consumers are then correct by construction.
  (define (sel-for nom)
    (If (ty-ap-path? nom)
      (let* ((parts (ty-ap-decode nom))
             (base (Ix 0 parts))
             ;; Reopened members of builtin types insert rooted while
             ;; the builtin's own path is substrate (unrooted): resolve
             ;; the member path canonically.
             (mpath (member-path base)))
        (Ifz (get-const mpath sut)
          mpath
          (let* ((param-names
                   (lambda (ty)
                     (Weld (ty:tqua-names ty)
                       (map (Ix 0) (ty:cqua-pairs ty)))))
                 (pnames (param-names (got-type base sut)))
                 (mnames (param-names (tc-ty (got-entry-tc mpath sut))))
                 (kept (filter (lambda (pr) (includes (Eq (_0 pr)) mnames))
                         (zip pnames (drop 1 parts))))
                 (selected
                   (Ifz (Sz kept)
                     mpath
                     (ty-ap-encode (Weld [mpath] (map (Ix 1) kept))))))
            selected)))
      (member-path nom)))
  ;; Law-valued methods are referenced by name, mirroring elab-ref.
  (define (by-name path tc)
    [(If (Eq "TC_LAM" (Hd tc))
       (tc-global (tc-ty tc) path)
       tc)
     path])
  ;; Scored methods carry [TC canonical-path-or-0].  Keeping selection and
  ;; provenance together avoids a second, subtly different dispatch walk.
  (define (specialize-method scored args)
    (define tc (_0 scored))
    (Ifz args scored
      (Ifz (ty:count-tqua (tc-ty tc))
        scored
        (let ((typ (ty:type-specialize sut (tc-ty tc) args)))
          (If (Eq "TBAD" (ty:type-tag typ))
            (error ("cannot specialize method" meth typ))
            [(set-tc-ty typ tc) (_1 scored)])))))
  (define (row-item-type row)
    (Ifz (ty:trow-vals row)
      ty:TANY
      (foldl (ty:type-join sut) (_0 (ty:trow-vals row)) (drop 1 (ty:trow-vals row)))))
  ;; A method that isn't declared is a user typo, not a bad entry.
  (define (builtin-meth prefix)
    (define bsel (canon-path (Weld prefix [meth]) sut))
    (Ifz (get-const bsel sut)
      (error ["no such method" ["path" bsel]])
      [(got-entry-tc bsel sut) bsel]))
  (define (row-method)
    (specialize-method (builtin-meth ["row"]) [(row-item-type ty)]))
  (define (row-meth row)
    (define faces (ty:collect-faces (ty:trow-vals row)))
    (define hit (find (lambda (arg) (Eq meth (_1 arg))) faces))
    (define (accessor arg)
      [(tc-ffi (ty:TFUN [ty] (_2 arg)) (Ix (_0 arg))) 0])
    (Ifz hit
      (row-method)
      ;; Anonymous rows (cstr 0) are outside UFCS by design: no face
      ;; accessors, no set_/over_.  The row/* builtins above still
      ;; apply where the receiver nests as an array.
      (If (Eq 0 (ty:trow-cstr row))
        (error ["anonymous row types are outside UFCS - bind the value to a local (=  > x ...) and use the bare face name" ["face" meth]])
        (accessor (_0 hit)))))
  ;; Nominal receivers keep their names now (type-meet preserves
  ;; molds), so face access on them arrives here: when there is no
  ;; declared method under the receiver's path, fall back to the
  ;; expanded row shape and its faces.  A nominal whose entry holds
  ;; *another type* is an alias (+ path row[quip]): its own declared
  ;; methods win, then lookup re-dispatches on the unfolded type.
  (define (score-ty t)
    (define (score-nom t)
      (define nom (ty:tnom-ref t))
      (define sel (sel-for nom))
      (If (get-const sel sut)
        (by-name sel (applied-entry-tc sut sel))
        ;; Face access: use the *declared* row specialized by the
        ;; receiver's type arguments — expanding the whole receiver
        ;; would hand the accessor a denormalized face type.  An
        ;; entry holding another NOMINAL is an alias link: follow it
        ;; before falling back to the expanded row shape, so the
        ;; target's declared methods win over its span's faces.
        (let ((decl (If (And (get-const nom sut) (ty:type-entry? nom sut))
                      (applied-type sut nom)
                      ty:TBAD)))
          (cond
            ((Eq "TROW" (ty:type-tag decl)) (row-meth decl))
            ((And (Eq "TNOM" (ty:type-tag decl)) (Nil (Equal decl t)))
              (score-ty decl))
            (else
              (let ((span (ty:mold-to-span sut t)))
                (If (Eq "TROW" (ty:type-tag span))
                  (row-meth span)
                  (If (Or (Eq "TBAD" (ty:type-tag decl)) (Equal decl t))
                    (error ("bad dot call" obj meth))
                    (score-ty decl)))))))))
    (cond
      ((Eq (ty:type-tag t) "TNOM") (score-nom t))
      ((Eq (ty:type-tag t) "TROW") (row-meth t))
      ((Eq (ty:type-tag t) "TARR")
        (specialize-method (builtin-meth ["row"]) [(ty:tarr-item t)]))
      ((Eq (ty:type-tag t) "TNAT") (builtin-meth ["uint"]))
      (else (error ("bad dot call" obj meth)))))
  (score-ty ty))

(define (elab-val-context ctx env surf)
  (define sut (ty:type-context-sut ctx))
  (define (tag-is x) (Eq x (_0 surf)))
  (define elab-ty (elab-type-env sut env))
  ;; State-threaded traversal for sibling expressions.  The TC row is kept
  ;; separate from the type-operation context so public TC shapes do not move.
  ;; goals pairs each expression with its expected type (0 = none); the
  ;; plain elab-vals clears the goal for every sibling.
  (define (elab-vals-goals ctx0 env0 surfs goals)
    (foldl
      (lambda (st s)
        (let* ((g (Ifz goals 0 (Ix (Sz (_1 st)) goals)))
               (r (elab-val-context (_0 st) (set-env-goal g env0) s)))
          [(_0 r) (snoc (_1 r) (_1 st))]))
      [ctx0 []] surfs))
  (define (elab-vals ctx0 env0 surfs)
    (elab-vals-goals ctx0 env0 surfs 0))
  ;; Per-argument goals for a call: the callee's declared parameter
  ;; types when they are visible — a plain TFUN of matching arity.
  ;; Generic (TQUA) callees resolve their quas only at apply time, so
  ;; their parameters stay goalless for now.
  (define (fun-arg-goals fty n)
    (let ((b (burp-face fty)))
      (If (And (ty:is-tfun? b) (Eq n (Sz (ty:tfun-args b))))
        (ty:tfun-args b)
        0)))
  ;; Resolve a generic callee's variables from everything already
  ;; known — the non-lambda arguments (an empty row literal is
  ;; uninformative and skipped), any trailing implicit arguments (the
  ;; method receiver), and the CALL's own expected type against the
  ;; declared return.  A synthetic generic whose parameters are the
  ;; known positions and whose return is the whole signature row rides
  ;; through type-apply's ordinary inference; the instantiated
  ;; signature comes back in one piece.  -> instantiated TFUN or 0.
  (define (empty-row-ty? t)
    (And (Eq "TROW" (ty:type-tag t))
      (And (Ifz (ty:trow-cstr t) 1 0) (Ifz (Sz (ty:trow-vals t)) 1 0))))
  (define (resolve-generic fty known goal)
    ;; known = [[idx ty] ...] over the declared parameter positions
    (define use-goal (If goal (Ifz (Eq "TBAD" (ty:type-tag goal)) 1 0) 0))
    (define (rewrap t)
      (define tag (ty:type-tag t))
      (cond
        ((Eq tag "TQUA")
          (let ((r (rewrap (ty:tqua-body-value t))))
            (Ifz r 0 (ty:TQUA (ty:tqua-name t) r))))
        ((Eq tag "TFAC") (rewrap (ty:tfac-val t)))
        ((Eq tag "TSELF") (rewrap (ty:tself-val t)))
        ((ty:is-tfun? t)
          (let ((args (ty:tfun-args t)))
            (ty:TFUN
              (Weld (map (lambda (p) (Ix (_0 p) args)) known)
                (If use-goal [(ty:tfun-ret t)] []))
              (ty:TROW 0 (Weld args [(ty:tfun-ret t)])))))
        (else 0)))
    (define probe (rewrap fty))
    (Ifz probe
      0
      (let ((r (ty:type-apply sut probe
                 (Weld (map (Ix 1) known) (If use-goal [goal] [])))))
        (If (Eq "TBAD" (ty:type-tag r))
          0
          (let ((vals (ty:trow-vals r)))
            (ty:TFUN (Init vals) (Last vals)))))))
  ;; Two-phase argument elaboration for a generic callee with lambda
  ;; arguments: non-lambdas elaborate first (each under no goal), the
  ;; generic resolves from them (plus receiver and call goal), and
  ;; each lambda then checks against its instantiated parameter type.
  ;; -> [ctx exs specialized-fun-ty-or-0]
  (define (elab-vals-two-phase ctx0 env0 fty surfs post-tys)
    (define n (Sz surfs))
    (define goal
      (Ifz (env-goal env0) 0 (burp-face (env-goal env0))))
    (define (lam? i) (Eq "s_fun" (_0 (Ix i surfs))))
    (define (pass keep? gfor st0)
      (foldl
        (lambda (st i)
          (If (keep? i)
            (let ((r (elab-val-context (_0 st)
                       (set-env-goal (gfor i) env0) (Ix i surfs))))
              [(_0 r) (snoc [i (_1 r)] (_1 st))])
            st))
        st0 (gen n (lambda (i) i))))
    (define plain
      (pass (lambda (i) (Nil (lam? i))) (lambda (i) 0) [ctx0 []]))
    (define known
      (Weld
        (filter (lambda (p) (Nil (empty-row-ty? (_1 p))))
          (map (lambda (p) [(_0 p) (burp-face (tc-ty (_1 p)))]) (_1 plain)))
        (map (lambda (k) [(Add n k) (Ix k post-tys)])
          (gen (Sz post-tys) (lambda (k) k)))))
    (define spec (resolve-generic fty known goal))
    (define lams
      (pass lam?
        (lambda (i) (Ifz spec 0 (Ix i (ty:tfun-args spec))))
        [(_0 plain) (_1 plain)]))
    (define done (_1 lams))
    (define exs
      (map (lambda (i) (_1 (_0 (find (lambda (p) (Eq i (_0 p))) done))))
        (gen n (lambda (i) i))))
    [(_0 lams) exs spec])
  (define (has-quas? fty)
    (Eq "TQUA" (ty:type-tag (burp-face fty))))
  (define (any-lam? surfs)
    (Truth (find (lambda (s) (Eq "s_fun" (_0 s))) surfs)))
  (define (nests-pairs ctx0 pairs)
    (foldl
      (lambda (st pr)
        (Ifz (_1 st) st
          (ty:type-nests-context (_0 st) (_0 pr) (_1 pr))))
      [ctx0 1] pairs))
  ;; Positional binder imposition, shared by relative-variant patterns,
  ;; positional = destructuring, and lambda row parameters.  Binders
  ;; impose over declared field molds; _ leaves a field unfaced
  ;; (invisible to bare-name resolution).
  (define (relvar-pat? pat)
    (Or (Eq "s_relvar" (_0 pat))
      (And (Eq "s_tapp" (_0 pat))
        (Eq "s_relvar" (_0 (_0 (surf-tapp-kids pat)))))))
  (define (relvar-pat-field argp field)
    (define fm (burp-face field))
    (cond
      ;; _ binds nothing: the 0-face is unfindable by name AND keeps
      ;; the face scan from expanding a bare nominal field's span
      ;; (which would leak its spread faces into scope).
      ((Eq "s_hole" (_0 argp)) (ty:TFAC 0 fm))
      ((And (Eq "s_ref" (_0 argp)) (Eq 1 (Sz (surf-ref-path argp))))
        (ty:TFAC (_0 (surf-ref-path argp)) fm))
      ((Eq "s_face" (_0 argp))
        (ty:TFAC (surf-face-name argp) (elab-ty (surf-face-kid argp))))
      ;; a nested anonymous-row pattern destructures a row field by
      ;; position (the field's shape is already guaranteed by type).
      ;; Prefer the field's DECLARED row over its span roundtrip so
      ;; the binders keep nominal types (UFCS on them survives).
      ((Eq "s_trow" (_0 argp))
        (let ((frow
                (cond
                  ((Eq "TROW" (ty:type-tag fm)) fm)
                  ((Eq "TNOM" (ty:type-tag fm))
                    (let ((d (burp-face (applied-type sut (ty:tnom-ref fm)))))
                      (If (Eq "TROW" (ty:type-tag d))
                        d
                        (burp-face (ty:mold-to-span sut fm)))))
                  (else (burp-face (ty:mold-to-span sut fm)))))
              (kids (_1 argp)))
          (If (And (Eq "TROW" (ty:type-tag frow))
                (Eq (Sz kids) (Sz (ty:trow-vals frow))))
            (ty:TROW (ty:trow-cstr frow)
              (map (lambda (pr) (relvar-pat-field (_0 pr) (_1 pr)))
                (zip kids (ty:trow-vals frow))))
            (elab-error env "row pattern does not match the field's row"
              ["field" fm "pattern" argp]))))
      ;; A binding position has no else leg, so a variant pattern (a
      ;; runtime test that can fail) cannot appear here — only in a
      ;; match arm, where pat-deep handles it.
      ((relvar-pat? argp)
        (elab-error env
          "variant patterns cannot bind unconditionally - match (?) or guard (?>) on the value instead"
          argp))
      (else (elab-error env "unsupported pattern element" argp))))
  ;; Checking mode: when the context expects a function type of
  ;; matching arity (a call argument's declared parameter), bare
  ;; parameter names take their types from it, and [a b] parameters
  ;; destructure the expected row positionally.  Annotated parameters
  ;; and declaration heads (no goal in scope) elaborate as before.
  (define (elab-fun f[_ args body])
    (define gfun
      (Ifz (env-goal env) 0
        (let ((b (burp-face (env-goal env))))
          (If (And (ty:is-tfun? b) (Eq (Sz args) (Sz (ty:tfun-args b))))
            b
            0))))
    (define (param-ty ctx0 i)
      (define a (Ix i args))
      (define (goal-at)
        (Ifz gfun
          (elab-error env
            "lambda parameter needs a type - annotate it or give the callee a visible parameter type"
            a)
          (Ix i (ty:tfun-args gfun))))
      (cond
        ((And (Eq "s_ref" (_0 a)) (Eq 1 (Sz (surf-ref-path a))))
          (If gfun
            [ctx0 (ty:TFAC (_0 (surf-ref-path a)) (burp-face (goal-at)))]
            (elab-type-context ctx0 env a)))
        ((Eq "s_trow" (_0 a))
          [(record-pattern-type-references ctx0 env a)
           (relvar-pat-field a (goal-at))])
        ((Eq "s_hole" (_0 a))
          [ctx0 (ty:TFAC 0 (burp-face (goal-at)))])
        (else (elab-type-context ctx0 env a))))
    (define typed-args
      (foldl
        (lambda (st i)
          (let ((r (param-ty (_0 st) i)))
            [(_0 r) (snoc (_1 r) (_1 st))]))
        [ctx []] (gen (Sz args) (lambda (i) i))))
    (define argty (_1 typed-args))
    (define frame (Weld [(self-ty sut env argty body)] argty))
    (define inner-env (push-locals (clear-env-goal env) frame))
    (define r (elab-val-context (_0 typed-args) inner-env body))
    (define val (_1 r))
    [(_0 r) (tc-lam (ty:TFUN argty (tc-ty val)) 0 frame val)])
  (define (elab-cast c[_ ty body])
    (define tr (elab-type-context ctx env ty))
    (define want (_1 tr))
    (define r (elab-val-context (_0 tr) (set-env-goal want env) body))
    (define ret (_1 r))
    (define nr (ty:type-nests-context (_0 r) want (tc-ty ret)))
    (unless (_1 nr)
      (elab-error env "cast (^) target does not accept the value's type"
        ["want" want "got" (tc-ty ret)])
      [(_0 nr) (set-tc-ty want ret)]))
  ;; A row literal under a same-arity structural row goal checks each
  ;; element against the corresponding field.
  (define (elab-row r[_ items])
    (define goals
      (Ifz (env-goal env) 0
        (let ((gspan (burp-face (env-goal env))))
          (If (And (Eq "TROW" (ty:type-tag gspan))
                (Eq (Sz items) (Sz (ty:trow-vals gspan))))
            (ty:trow-vals gspan)
            0))))
    (define er (elab-vals-goals ctx env items goals))
    (define els (_1 er))
    (define ty (ty:TROW 0 (map tc-ty els)))
    [(_0 er) (tc-row ty (ty:trow-cstr ty) els)])
  (define (elab-variant v[_ tag])
    (define ty (ty:TROW tag []))
    [ctx (tc-row ty (ty:trow-cstr ty) [])])
  (define (elab-variant-call tag xs)
    (define ty (ty:TROW tag (map (cork burp-face tc-ty) xs)))
    (tc-row ty (ty:trow-cstr ty) xs))
  ;;; Relative variants: .tag / (./tag args) resolve against the type
  ;;; the context expects — the goal in expression position, the
  ;;; scrutinee in patterns.  Resolution IS the narrowing: the member
  ;;; is found among the expected union's own declared options, so no
  ;;; member-nests-into-parent reasoning is needed (which also
  ;;; sidesteps generic nominal members, whose instantiations do not
  ;;; nest into the instantiated parent today).
  (define (path-last-seg ref)
    (If (ty-ap-path? ref)
      (rear (Ix 0 (ty-ap-decode ref)))
      (rear ref)))
  ;; A row constructor's tag: a branded cstr is a printed path — take
  ;; the last /-segment (strings are little-endian byte nats, so
  ;; dropping the prefix is a shift); a structural cstr is the tag.
  (define (cstr-tag cstr)
    (define n (Bytes cstr))
    (define (go i last)
      (If (Ge i n)
        (Rsh cstr (Mul 8 last))
        (go (Inc i)
          (If (Eq 47 (Mod (Rsh cstr (Mul 8 i)) 256)) (Inc i) last))))
    (go 0 0))
  (define (relvar-opt-tag o)
    (define b (burp-face o))
    (cond
      ((Eq "TROW" (ty:type-tag b)) (cstr-tag (ty:trow-cstr b)))
      ((Eq "TNOM" (ty:type-tag b)) (path-last-seg (ty:tnom-ref b)))
      (else 0)))
  ;; The declared option molds of an expected union type, instantiated
  ;; (applied-type substitutes /ty-ap arguments); alias links chase.
  (define (relvar-opts expect)
    (define (chase m fuel)
      (cond
        ((Eq 0 fuel) 0)
        ((Eq "TSUM" (ty:type-tag m)) (ty:tsum-opts m))
        ((Eq "TROW" (ty:type-tag m)) [m])
        ((Eq "TNOM" (ty:type-tag m))
          (chase (burp-face (applied-type sut (ty:tnom-ref m))) (Dec fuel)))
        (else 0)))
    (chase (burp-face expect) 8))
  ;; -> [ctx fields cstr arity]: the member's positional field molds
  ;; (declared molds, not span roundtrips — binder nominality survives)
  ;; and its runtime constructor key (from the span, which carries the
  ;; brand for nominal members).
  (define (relvar-member ctx0 tag expect what)
    (define opts (relvar-opts expect))
    (define hit
      (Ifz opts 0 (find (lambda (o) (Eq tag (relvar-opt-tag o))) opts)))
    (Ifz hit
      (elab-error env ["no member named" tag "in the expected type"]
        ["expected" expect "resolving" what])
      (let* ((o (burp-face (_0 hit)))
             ;; A relative variant is a member-name reference selected from
             ;; the expected type.  Nominal members have ordinary namespace
             ;; entries, so retain the same provenance edge as an explicit
             ;; constructor reference would; structural options have no path.
             (ctx1
               (If (Eq "TNOM" (ty:type-tag o))
                 (record-canonical-reference ctx0 env (ty:tnom-ref o))
                 ctx0))
             (fields
               (If (Eq "TNOM" (ty:type-tag o))
                 ;; a legacy TNOM (structural arguments that cannot
                 ;; ride a /ty-ap path) carries them in the args row
                 (let* ((base (applied-type sut (ty:tnom-ref o)))
                        (m0 (If (Sz (ty:tnom-args o))
                              (ty:type-specialize sut base (ty:tnom-args o))
                              base))
                        (m (burp-face m0)))
                   (If (Eq "TROW" (ty:type-tag m))
                     (ty:trow-vals m)
                     (elab-error env ["member is not a row type" tag] m)))
                 (ty:trow-vals o)))
             (sr (ty:mold-to-span-context ctx1 o))
             (span (burp-face (_1 sr))))
        (unless (Eq "TROW" (ty:type-tag span))
          (elab-error env ["member has no runtime constructor" tag] span)
          [(_0 sr) fields (ty:trow-cstr span) (Sz (ty:trow-vals span))]))))
  ;; Expression position: arguments fill the member's fields
  ;; positionally; the construction is typed as the EXPECTED type (the
  ;; union), so casts and call-argument checks pass without a
  ;; member-into-union nest.
  (define (elab-relvar-call ctx0 tag xs)
    (define goal (env-goal env))
    (Ifz goal
      (elab-error env
        "relative variant (.tag) needs an expected type here - add a ^ cast or an annotation"
        ["tag" tag])
      (let* ((mr (relvar-member ctx0 tag goal "a value"))
             (fields (Ix 1 mr))
             (cstr (Ix 2 mr)))
        (If (Ne (Sz xs) (Sz fields))
          (elab-error env ["member arity mismatch" tag]
            ["want" (Sz fields) "got" (Sz xs)])
          (let* ((er (elab-vals-goals (Ix 0 mr) env xs fields))
                 (exs (_1 er))
                 (pairs (zip fields (map (cork burp-face tc-ty) exs)))
                 (nr (nests-pairs (_0 er) pairs)))
            (unless (_1 nr)
              (elab-error env
                ["member fields do not accept the arguments" tag]
                ["want" fields "got" (map tc-ty exs)])
              [(_0 nr) (tc-row (burp-face goal) cstr exs)]))))))
  ;; -> [row result-nom] for a constructible type callee, else 0. A
  ;; TTYP wrapping a /ty-ap nominal resolves through the applied view;
  ;; the nominal rides along as the construction's result type.
  (define (tc-type-row tc)
    (If (Eq "TC_TYP" (Hd tc))
      (let ((typ (tc-typ-inner tc)))
        (If (Nil (Eq (ty:type-tag typ) "TTYP"))
          0
          (let ((inner (ty:ttyp-type typ)))
            (cond
              ((Eq (ty:type-tag inner) "TROW") [inner 0])
              ((Eq (ty:type-tag inner) "TNOM")
                (let ((decl (applied-type sut (ty:tnom-ref inner))))
                  (If (Eq (ty:type-tag decl) "TROW") [decl inner] 0)))
              (else 0)))))
      0))
  ;; A constructor call's result type is the NOMINAL type when the
  ;; callee is a (possibly specialized) reference to a named type —
  ;; taken from the callee's surface, since the TC has shed the path.
  ;; The old span roundtrip recovered the name only for
  ;; unparameterized types and denormalized everything else.
  (define (construction-nom fsurf)
    (cond
      ((Eq "s_ref" (_0 fsurf))
        (ty:TNOM (canon-path (surf-ref-path fsurf) sut) 0))
      ;; bare names reach constructors as s_var (a type callee cannot
      ;; be a local, so the name is the path)
      ((Eq "s_var" (_0 fsurf))
        (ty:TNOM (canon-path [(_1 fsurf)] sut) 0))
      ((And (Eq "s_spec" (_0 fsurf)) (Eq "s_ref" (_0 (_1 fsurf))))
        (ty:TNOM (canon-path (surf-ref-path (_1 fsurf)) sut)
          (map elab-ty (_2 fsurf))))
      (else 0)))
  (define (elab-type-call ctx0 fsurf rown xs)
    (define row (Ix 0 rown))
    (define fields (ty:trow-vals row))
    (define got (map (cork burp-face tc-ty) xs))
    (define pairs (zip fields got))
    (define nom (If (Ix 1 rown) (Ix 1 rown) (construction-nom fsurf)))
    (define nr
      (If (Eq (Sz fields) (Sz got))
        (nests-pairs ctx0 pairs)
        [ctx0 0]))
    (unless (_1 nr)
      (elab-error env "constructor call does not match its row type"
        ["want" row "got" got])
      [(_0 nr) (tc-row (Ifz nom row nom) (ty:trow-cstr row) xs)]))
  (define (on-call ctx0 f xs)
    (define xs-ty (map (cork burp-face tc-ty) xs))
    (define typ (ty:type-apply sut (tc-ty f) xs-ty))
    (define app (tc-fold-app f xs))
    (If (Eq (ty:type-tag typ) "TBAD")
      (elab-error env "cannot apply function to these arguments"
        ["fun" (tc-ty f) "args" xs-ty "because" typ])
      [ctx0 (set-tc-ty typ app)]))
  ;; A loop (|) is an immediately-applied anonymous lambda: params come
  ;; from the arm patterns, inits elaborate in the OUTER env (parallel
  ;; binding — it's one call), and (_ ...) re-enters through the self
  ;; slot.  Without a ^ cast the self return type is TBOT — a self-call
  ;; joins away against the base-case branches, so the loop's type is
  ;; the join of its non-recursive exits (the same trick no-fallthrough
  ;; matches use for their missing heir).
  (define (elab-loop l[_ arms body])
    (define typed-arms
      (foldl
        (lambda (st arm)
          (let ((tr (elab-type-context (_0 st) env (_1 arm))))
            [(_0 tr) (snoc (_1 tr) (_1 st))]))
        [ctx []] arms))
    (define argty (_1 typed-arms))
    (define ir
      (elab-vals-goals (_0 typed-arms) env (map (Ix 2) arms) argty))
    (define inits (_1 ir))
    (define ret0 (peek-ret-cast sut env body))
    (define ret (If (Equal ty:TBAD ret0) ty:TBOT ret0))
    (define frame (Weld [(ty:TSELF (ty:TFUN argty ret))] argty))
    (define inner-env (push-locals (clear-env-goal env) frame))
    (define vr (elab-val-context (_0 ir) inner-env body))
    (define val (_1 vr))
    (define lam (tc-lam (ty:TFUN argty (tc-ty val)) 0 frame val))
    (on-call (_0 vr) lam inits))
  (define (elab-spec s[_ val args])
    (define br (elab-val-context ctx (clear-env-goal env) val))
    (define base (_1 br))
    (define bty0
      (If (Eq "TC_TYP" (Hd base))
        (ty:ttyp-type (tc-typ-inner base))
        (tc-ty base)))
    (define cpairs (ty:cqua-pairs bty0))
    (define nt0 (ty:count-tqua bty0))
    (define typed-targs
      (foldl
        (lambda (st arg)
          (let ((tr (elab-type-context (_0 st) env arg)))
            [(_0 tr) (snoc (_1 tr) (_1 st))]))
        [(_0 br) []] (take nt0 args)))
    (define targs (_1 typed-targs))
    (define (record-const-arg ctx0 arg)
      (If (Nil (Eq "s_ref" (_0 arg)))
        ctx0
        (let* ((path (surf-ref-path arg))
               (name (_0 path))
               (local?
                 (And (Eq 1 (Sz path))
                   (Or (str-numeric? name)
                     (Truth
                       (find (lambda (pair) (Eq name (_0 pair)))
                         (env-consts env)))))))
          (If local? ctx0 (resolve-source-reference ctx0 env path)))))
    (define spec-ctx
      (foldl record-const-arg (_0 typed-targs) (drop nt0 args)))
    (define (bad-type? typ)
      (Eq (ty:type-tag typ) "TBAD"))
    (define (specialize typ)
      (ty:type-specialize sut typ targs))
    ;; A specialized named type IS its /ty-ap path.  Bare names arrive
    ;; as s_var; the base elaborated to a type entry, so the name is a
    ;; root path — value position is nominal exactly like type position.
    (define (nom-spec)
      (cond
        ((Eq "s_ref" (_0 val))
          (spec-encode sut (surf-ref-path val) targs))
        ((Eq "s_var" (_0 val))
          (spec-encode sut [(_1 val)] targs))
        (else 0)))
    ;; --- const-bearing generics: full explicit spec, values checked
    ;; against their declared types (with the instantiation's type args
    ;; substituted in), the reference rewritten to the full /ty-ap key.
    (define (subst-cty cty)
      (foldl (lambda (acc pr) (ty:subst-type (_0 pr) (_1 pr) acc))
        cty (zip (ty:tqua-names bty0) targs)))
    (define (const-arg-path a cty)
      (If (Eq "s_tsym" (_0 a))
        (let ((n (_1 a)))
          (unless (ty:type-nests? sut cty (ty:TNAT n))
            (elab-error env "const argument type mismatch"
              ["want" cty "got" (ty:TNAT n)])
            [ty-val-tag n]))
      (If (Nil (Eq "s_ref" (_0 a)))
        (elab-error env "const argument must be a name or literal" a)
        (let* ((path (surf-ref-path a))
               (nm (_0 path))
               (chit (And (Eq 1 (Sz path))
                       (find (lambda (pr) (Eq nm (_0 pr))) (env-consts env)))))
          (cond
            (chit
              (unless (ty:type-nests? sut cty (_1 (_0 chit)))
                (elab-error env "const argument type mismatch"
                  ["want" cty "got" (_1 (_0 chit))])
                [ty-var-tag nm]))
            ((And (Eq 1 (Sz path)) (str-numeric? nm))
              (unless (ty:type-nests? sut cty (ty:TNAT (parse-nat nm)))
                (elab-error env "const argument type mismatch"
                  ["want" cty "got" (ty:TNAT (parse-nat nm))])
                [ty-val-tag (parse-nat nm)]))
            (else
              (let ((cp (canon-path path sut)))
                (Ifz (get-const cp sut)
                  (elab-error env "unbound const argument" ["path" cp])
                  (let ((rty (tc-ty (got-entry-tc cp sut))))
                    (unless (ty:type-nests? sut cty rty)
                      (elab-error env "const argument type mismatch"
                        ["want" cty "got" rty])
                      cp))))))))))
    (define (base-entry-path)
      (cond
        ((Eq "TC_GLOBAL" (Hd base)) (tc-global-path base))
        ((Eq "s_ref" (_0 val)) (canon-path (surf-ref-path val) sut))
        ((Eq "s_var" (_0 val)) (canon-path [(_1 val)] sut))
        (else 0)))
    (define (const-spec)
      (If (Ne (Sz args) (Add nt0 (Sz cpairs)))
        (elab-error env "wrong number of type arguments"
          ["want" (Add nt0 (Sz cpairs)) "got" (Sz args)])
        (let* ((bpath (base-entry-path))
               (targ-paths (map ty:ty-to-path targs))
               (cpaths
                 (map (lambda (pr)
                        (const-arg-path (_0 pr) (subst-cty (_1 (_1 pr)))))
                   (zip (drop nt0 args) cpairs))))
          (cond
            ((Ifz bpath 1 0)
              (elab-error env
                "const-parameter generics require a named base" s))
            ((any Nil targ-paths)
              (elab-error env
                "type arguments of a const-parameter generic must be path-shaped"
                targs))
            (else
              (let ((enc (ty-ap-encode (Weld [bpath] (Weld targ-paths cpaths)))))
                (If (Eq "TC_TYP" (Hd base))
                  (tc-typ (ty:TTYP (ty:TNOM enc 0)))
                  (let ((typ (ty:subst-const-args
                               (map (Ix 0) cpairs) cpaths
                               (ty:strip-cquas (specialize bty0)))))
                    (If (bad-type? typ)
                      (elab-error env "bad specialization" ["got" typ "args" args])
                      (tc-global typ enc))))))))))
    [spec-ctx
     (If (Sz cpairs)
       (const-spec)
       (If (Eq "TC_TYP" (Hd base))
       ;; The /ty-ap encoding shortcut below never runs type-specialize,
       ;; so check the argument count against the generic's arity here.
       ;; Against args, not targs: targs is take-truncated to the arity,
       ;; so its size can never expose surplus arguments.
       (let ((quas (ty:count-tqua (ty:ttyp-type (tc-typ-inner base)))))
         (If (Ne quas (Sz args))
           (elab-error env "wrong number of type arguments"
             ["want" quas "got" (Sz targs)])
           (let ((enc (nom-spec)))
             (If enc
               (tc-typ (ty:TTYP (ty:TNOM enc 0)))
               (let ((typ (specialize (ty:ttyp-type (tc-typ-inner base)))))
                 (If (bad-type? typ)
                   (elab-error env "bad specialization" ["got" typ "args" args])
                   (tc-typ (ty:TTYP typ))))))))
       ;; Value specialization: type-specialize silently ignores
       ;; surplus arguments (substitution just runs out of quas), so
       ;; the arity must be checked here too — against args, since
       ;; targs is take-truncated to the arity.
       (let ((quas (ty:count-tqua (tc-ty base))))
         (If (Ne quas (Sz args))
           (elab-error env "wrong number of type arguments"
             ["want" quas "got" (Sz targs)])
           (let ((typ (specialize (tc-ty base))))
             (If (bad-type? typ)
               (elab-error env "bad specialization" ["got" typ "args" args])
               (set-tc-ty typ base)))))))])
  ;; Callee first: its parameter (or constructor field) types become
  ;; the arguments' goals.
  (define (elab-call-fun f xs)
    (let* ((fr (elab-val-context ctx (clear-env-goal env) f))
           (tc-f (_1 fr))
           (rown (tc-type-row tc-f))
           (goals
             (If rown
               (let ((fields (ty:trow-vals (Ix 0 rown))))
                 (If (Eq (Sz xs) (Sz fields)) fields 0))
               (fun-arg-goals (tc-ty tc-f) (Sz xs))))
           (two? (And (Ifz goals 1 0)
                   (And (Ifz rown 1 0)
                     (And (has-quas? (tc-ty tc-f)) (any-lam? xs)))))
           (er
             (If two?
               (elab-vals-two-phase (_0 fr) env (burp-face (tc-ty tc-f)) xs [])
               (elab-vals-goals (_0 fr) env xs goals)))
           (exs (_1 er))
           (tc-f2
             (If (And two? (Truth (Ix 2 er)))
               (set-tc-ty (Ix 2 er) tc-f)
               tc-f)))
      (If rown
        (elab-type-call (_0 er) f rown exs)
        (on-call (_0 er) tc-f2 exs))))
  (define (elab-call c[_ f xs])
    (cond
      ((Eq "s_variant" (_0 f))
        (let ((er (elab-vals ctx env xs)))
          [(_0 er) (elab-variant-call (_1 f) (_1 er))]))
      ;; a relative-variant callee resolves against the CALL's own
      ;; expected type (env still carries it here)
      ((Eq "s_relvar" (_0 f))
        (elab-relvar-call ctx (_1 f) xs))
      (else
        (elab-call-fun f xs))))
  ;; Functions are referenced *by name* (TC_GLOBAL, carrying only the
  ;; referee's type): lowering links the referee's compiled pin in by
  ;; path.  Embedding the whole referee TC — the old behavior — made
  ;; every referrer's TC tree carry copies of its transitive callees.
  ;; Non-function entries (FFI values, types, literal-ish TCs) stay
  ;; inline; they are small and some consumers need their structure.
  (define (elab-ref r[_ path])
    ;; An unbound name is the single most common user error: a located
    ;; diagnostic, never a bare ("bad entry" ...) from the lookup.
    ;; Source paths are root-relative; the canonical (rooted) name is
    ;; what the entry and the global link carry.
    (define ctx1 (resolve-source-reference ctx env path))
    (define cpath (canon-path path (ty:type-context-sut ctx1)))
    (unless (Nil (get-const cpath sut))
      (let* ((referee (got-entry-tc cpath sut))
             (h (Hd referee)))
        (If (untyped-prototype? referee)
          (elab-error env
            "forward reference requires an explicit type annotation"
            ["path" path])
          ;; Value entries (nullary constants) reference by name too:
          ;; lowering links the referee's FORCED compiled value, giving
          ;; sharing instead of per-use recomputation.  FFI/type/literal
          ;; entries stay inline — consumers need their structure and
          ;; they are cheap.
          (If (Or (Eq "TC_FFI" h) (Or (Eq "TC_TYP" h) (Eq "TC_LIT" h)))
            [ctx1 referee]
            [ctx1 (tc-global (tc-ty referee) cpath)])))
      (elab-error env "unbound reference" ["path" path])))
  (define (slot-path path)
    (If (Eq 1 (Sz path)) (_0 path) path))
  (define (find-local-face face)
    (define (scan-ty ty path)
      (define tag (ty:type-tag ty))
      (define (scan-row vals)
        (define (go idx rest)
          (Ifz rest
            0
            (Or (scan-ty (_0 rest) (snoc idx path))
              (go (Inc idx) (drop 1 rest)))))
        (go 0 vals))
      (define (scan-tnom)
        (define span (ty:mold-to-span sut ty))
        (If (Eq "TROW" (ty:type-tag span))
          (scan-ty span path)
          0))
      (cond
        ((Eq tag "TFAC")
          (If (Eq face (ty:tfac-face ty))
            [[ty path]]
            ;; Anonymous rows are transparent aggregates: bare faces
            ;; resolve through a faced local holding one.  Named molds
            ;; stay opaque here (their faces are reached via UFCS) —
            ;; recursing into them would silently rebind bare words
            ;; like key/val inside match arms.
            (let ((inner (ty:tfac-val ty)))
              (If (And (Eq "TROW" (ty:type-tag inner))
                    (Eq 0 (ty:trow-cstr inner)))
                (scan-ty inner path)
                0))))
        ((Eq tag "TROW")
          (scan-row (ty:trow-vals ty)))
        ((Eq tag "TNOM")
          (scan-tnom))
        (else 0)))
    (define (go idx rest)
      (Ifz rest
        0
        (Or (scan-ty (_0 rest) [idx])
          (go (Inc idx) (drop 1 rest)))))
    (go 0 (env-locals env)))
  (define (on-var face found[ty path])
    (tc-local ty (slot-path path) face))
  (define (elab-var v[_ face])
    (define found (find-local-face face))
    (Ifz found
      (let ((chit (find (lambda (p) (Eq face (_0 p))) (env-consts env))))
        (Ifz chit
          (elab-ref ["s_ref" [face]])
          [ctx (tc-cparam (_1 (_0 chit)) face)]))
      [ctx (on-var face (_0 found))]))
  ;; A literal knows its value: TNAT with the constant cube (0 stays
  ;; the whole nat span — the one ambiguous literal).
  (define (elab-lit l[_ val])
    (tc-lit (ty:TNAT val) val))
  ;; '-prefixed literals carry a quip aura: the runtime value is the
  ;; tagged pair from quip:parse-quip, typed by the builtin quip sum.
  (define (elab-literal l[_ shape text])
    (cond
      ((Eq shape "quip")
        (tc-lit (ty:TNOM (canon-path ["quip"] sut) 0) (quip:parse-quip text)))
      ;; A cord is a bare text nat, typed by its constant.
      ((Eq shape "cord")
        (tc-lit (ty:TNAT text) text))
      (else (elab-unsupported env ["non-quip literal" shape]))))
  ;; Local bindings: sequential lets — each binding sees the previous
  ;; ones; recursive references are not supported (bindings elaborate
  ;; before their name enters scope).
  (define (elab-letrec l[_ arms body])
    (define outer-goal (env-goal env))
    ;; A typed binding's declared type is elaborated before its value
    ;; so the value checks against it (the goal); the binding's
    ;; nests-check keeps the diagnostics.
    (define (pat-goal ctx0 env1 pat)
      (If (Eq "s_face" (_0 pat))
        (elab-type-context ctx0 env1 (surf-face-kid pat))
        [(record-pattern-type-references ctx0 env1 pat) 0]))
    (define (bind-ty ctx0 env1 pat want val-tc)
      (define tag (_0 pat))
      (cond
        ((Eq tag "s_face")
          (let ((nr (ty:type-nests-context ctx0 want
                      (burp-face (tc-ty val-tc)))))
            (unless (_1 nr)
              (elab-error env1 "local binding value does not fit its declared type"
                ["want" want "got" (tc-ty val-tc)])
              [(_0 nr) (ty:TFAC (surf-face-name pat) want)])))
        ((And (Eq tag "s_ref") (Eq 1 (Sz (surf-ref-path pat))))
          [ctx0 (ty:TFAC (_0 (surf-ref-path pat)) (burp-face (tc-ty val-tc)))])
        ;; = [a b c] value — positional destructure: binders impose
        ;; over the value's row fields; the whole row is one local
        ;; whose faces are the binders.
        ((Eq tag "s_trow")
          [ctx0 (relvar-pat-field pat (burp-face (tc-ty val-tc)))])
        (else
          (elab-error env1 "unsupported local binding pattern" pat))))
    (define (step acc[ctx1 env1 binds] arm[_ pat val])
      (define gr (pat-goal ctx1 env1 pat))
      (define want (_1 gr))
      (define vr (elab-val-context (_0 gr) (set-env-goal want env1) val))
      (define val-tc (_1 vr))
      (define br (bind-ty (_0 vr) env1 pat want val-tc))
      [(_0 br) (push-local-env env1 (_1 br)) (snoc val-tc binds)])
    (define res[ctx2 env2 binds] (foldl step [ctx env []] arms))
    (unless (Ne foil-no-heir body)
      (elab-error env "local bindings (=) require a body" 0)
      (let* ((br (elab-val-context ctx2 (set-env-goal outer-goal env2) body))
             (btc (_1 br)))
        [(_0 br) (tc-letrec (tc-ty btc) binds btc)])))
  ;; The receiver rides last, so written argument i pairs with the
  ;; method's parameter i — goals come straight off the front.  For a
  ;; generic method with lambda arguments, the receiver's (known) type
  ;; joins the inference as the trailing implicit argument.
  (define (elab-meth-step st[ctx0 rcvr] seg)
    (define method-name (surf-mseg-name seg))
    (define scored (score-meth rcvr method-name sut))
    (define f (_0 scored))
    (define ctx1
      (Ifz (_1 scored)
        ctx0
        (record-canonical-reference ctx0 env (_1 scored))))
    (define margs (surf-mseg-args seg))
    (define goals
      (let ((g (fun-arg-goals (tc-ty f) (Inc (Sz margs)))))
        (Ifz g 0 (take (Sz margs) g))))
    (define two?
      (And (Ifz goals 1 0)
        (And (has-quas? (tc-ty f)) (any-lam? margs))))
    (define ar
      (If two?
        (elab-vals-two-phase ctx1 env (burp-face (tc-ty f)) margs
          [(burp-face (tc-ty rcvr))])
        (elab-vals-goals ctx1 env margs goals)))
    (define f2
      (If (And two? (Truth (Ix 2 ar)))
        (set-tc-ty (Ix 2 ar) f)
        f))
    (on-call (_0 ar) f2 (snoc rcvr (_1 ar))))
  (define (elab-meth-go st els)
    (Ifz els st
        (elab-meth-go (elab-meth-step st (_0 els)) (drop 1 els))))
  (define (elab-meth m[_ els])
    assert(Nil (Eq 0 (Sz els)))
    ;; The receiver slot holds either a bare name (a string — resolve
    ;; through the environment) or a parenthesized expression's SAST
    ;; node (a row — elaborate it like any value).
    (define head (_0 els))
    (define hr
      (If (IsApp head)
        (elab-val-context ctx (clear-env-goal env) head)
        (elab-var [0 head])))
    (elab-meth-go hr (drop 1 els)))
  ;; ["key" cstr arity kids] — kids all 0 for a flat pattern (no
  ;; nested constraints); pat-deep fills them for nested variants.
  (define (arm-span-key span)
    (If (Eq "TROW" (ty:type-tag span))
      (let ((n (Sz (ty:trow-vals span))))
        ["key" (ty:trow-cstr span) n (gen n (lambda (i) 0))])
      0))
  ;; During case elaboration an arm temporarily carries its one expanded
  ;; narrowed span and runtime key alongside the unchanged TC_ARM.
  (define arm-info-tc (Ix 0))
  (define arm-info-span (Ix 1))
  (define arm-info-key (Ix 2))
  ;; Deep pattern imposition for match arms -> [ctx local-ty key].
  ;; Like relvar-pat-field, but nested variant patterns are allowed:
  ;; each resolved variant narrows its position to the member's row
  ;; (its binders type as the member's fields) and contributes a
  ;; ["key" cstr arity kids] node to the arm's runtime key tree, which
  ;; lower-arm-test turns into Ix-chain probes.  An anonymous-row
  ;; pattern needs no test of its own (the type guarantees its shape)
  ;; but keys a node anyway when a nested variant sits inside it.
  (define (pat-deep ctx0 argp field)
    (define fm (burp-face field))
    (define (deep-kids ctx1 argps fields)
      (foldl
        (lambda (st pr)
          (let ((r (pat-deep (Ix 0 st) (_0 pr) (_1 pr))))
            [(Ix 0 r) (snoc (Ix 1 r) (Ix 1 st)) (snoc (Ix 2 r) (Ix 2 st))]))
        [ctx1 [] []] (zip argps fields)))
    (cond
      ((Eq "s_hole" (_0 argp)) [ctx0 (ty:TFAC 0 fm) 0])
      ((And (Eq "s_ref" (_0 argp)) (Eq 1 (Sz (surf-ref-path argp))))
        [ctx0 (ty:TFAC (_0 (surf-ref-path argp)) fm) 0])
      ((Eq "s_face" (_0 argp))
        (let ((tr (elab-type-context ctx0 env (surf-face-kid argp))))
          [(_0 tr) (ty:TFAC (surf-face-name argp) (_1 tr)) 0]))
      ((relvar-pat? argp)
        (let* ((bare? (Eq "s_relvar" (_0 argp)))
               (tag (If bare? (_1 argp) (_1 (_0 (surf-tapp-kids argp)))))
               (argps (If bare? [] (drop 1 (surf-tapp-kids argp))))
               (mr (relvar-member ctx0 tag fm "a pattern"))
               (fields (Ix 1 mr))
               (cstr (Ix 2 mr)))
          (If (Ne (Sz argps) (Sz fields))
            (elab-error env ["member arity mismatch in pattern" tag]
              ["want" (Sz fields) "got" (Sz argps)])
            (let ((kr (deep-kids (Ix 0 mr) argps fields)))
              [(Ix 0 kr)
               (ty:TROW cstr (Ix 1 kr))
               ["key" cstr (Sz fields) (Ix 2 kr)]]))))
      ((Eq "s_trow" (_0 argp))
        (let ((frow
                (cond
                  ((Eq "TROW" (ty:type-tag fm)) fm)
                  ((Eq "TNOM" (ty:type-tag fm))
                    (let ((d (burp-face (applied-type sut (ty:tnom-ref fm)))))
                      (If (Eq "TROW" (ty:type-tag d))
                        d
                        (burp-face (ty:mold-to-span sut fm)))))
                  (else (burp-face (ty:mold-to-span sut fm)))))
              (kids (_1 argp)))
          (If (And (Eq "TROW" (ty:type-tag frow))
                (Eq (Sz kids) (Sz (ty:trow-vals frow))))
            (let* ((kr (deep-kids ctx0 kids (ty:trow-vals frow)))
                   (keys (Ix 2 kr))
                   (span (burp-face (ty:mold-to-span sut fm))))
              [(Ix 0 kr)
               (ty:TROW (ty:trow-cstr frow) (Ix 1 kr))
               (Ifz (find (lambda (k) (Ifz k 0 1)) keys)
                 0
                 ["key" (ty:trow-cstr span) (Sz kids) keys])])
            (elab-error env "row pattern does not match the field's row"
              ["field" fm "pattern" argp]))))
      (else (elab-error env "unsupported pattern element" argp))))
  (define (elab-arm-classic scr-ty st[ctx infos] a[_ pat val])
    (define ptr (elab-type-context ctx env pat))
    (define pat-ty (_1 ptr))
    (define met
      (ty:type-meet-context (_0 ptr) scr-ty pat-ty))
    (define ctx1 (_0 met))
    (define narrowed (_1 met))
    (define ty (_0 narrowed))
    ;; Lowered arm tests dispatch on constructor head + arity; a pattern
    ;; that doesn't narrow the scrutinee to a row has no such key.
    (define span (burp-face (_1 narrowed)))
    ;; A binderless anonymous-row pattern binds through its own faces:
    ;; the meet burps mismatched faces, so re-impose the pattern's on
    ;; the narrowed local — the arm body's bare names then resolve to
    ;; the pattern's fields.  Named patterns are untouched.
    (define (impose-faces met)
      (ty:TROW (ty:trow-cstr met)
        (map (lambda (pr)
               (If (Eq "TFAC" (ty:type-tag (_0 pr)))
                 (ty:TFAC (ty:tfac-face (_0 pr)) (burp-face (_1 pr)))
                 (_1 pr)))
          (zip (ty:trow-vals pat-ty) (ty:trow-vals met)))))
    (define local-ty
      (If (And (Eq "TROW" (ty:type-tag pat-ty))
            (And (Eq 0 (ty:trow-cstr pat-ty))
              (And (Eq "TROW" (ty:type-tag ty))
                (Eq (Sz (ty:trow-vals pat-ty)) (Sz (ty:trow-vals ty))))))
        (impose-faces ty)
        ty))
    (unless (Eq "TROW" (ty:type-tag span))
      (elab-error env "match arm pattern is not a row (constructor) type"
        ["pattern" pat-ty "narrowed" ty])
      (let* ((rr (elab-val-context ctx1 (push-local-env env local-ty) val))
             (res (_1 rr))
             (key (arm-span-key span)))
        [(_0 rr)
         (snoc [(tc-arm (tc-ty res) ty res key) span key] infos)])))
  ;; An anonymous-row pattern with a variant inside ([(./known x) ..])
  ;; takes the deep path; a plain one keeps the classic meet.
  (define (pat-nested? pat)
    (Or (relvar-pat? pat)
      (And (Eq "s_trow" (_0 pat))
        (Ifz (find pat-nested? (_1 pat)) 0 1))))
  (define (elab-arm scr-ty st[ctx infos] a[_ pat val])
    (If (pat-nested? pat)
      (let* ((ar (pat-deep ctx pat scr-ty))
             (lty (Ix 1 ar))
             (key (Ix 2 ar))
             (rr (elab-val-context (Ix 0 ar) (push-local-env env lty) val))
             (res (_1 rr)))
        [(_0 rr)
         (snoc [(tc-arm (tc-ty res) lty res key) lty key] infos)])
      (elab-arm-classic scr-ty st a)))
  ;; Lowered arm tests dispatch on the key tree (lower-arm-test in
  ;; foil-lower.rvr).  An arm whose key SUBSUMES a later arm's — same
  ;; constructor and arity, every sub-key at least as general — matches
  ;; everything the later arm matches, so the later arm is dead code.
  ;; Reject that here (equal keys, the old check, subsume mutually).
  (define (key-subsumes? a b)
    (cond
      ((Ifz a 1 0) 1)
      ((Ifz b 1 0) 0)
      (else
        (And (Eq (_1 a) (_1 b))
          (And (Eq (_2 a) (_2 b))
            (all (lambda (pr) (key-subsumes? (_0 pr) (_1 pr)))
              (zip (Ix 3 a) (Ix 3 b))))))))
  (define (check-arms-distinct infos)
    (define (shadowed keys)
      (Ifz keys 0
        (Or (And (_0 keys)
              (Ifz (find (key-subsumes? (_0 keys)) (drop 1 keys)) 0 1))
          (shadowed (drop 1 keys)))))
    (Ifz (shadowed (map arm-info-key infos)) 0
      (elab-error env
        "match arm unreachable (an earlier arm already matches everything it matches)"
        (map (lambda (i) (tc-arm-pat (arm-info-tc i))) infos))))
  ;; A match without a fallthrough must cover every option of its
  ;; scrutinee's sum.  An arm covers an option when its key subsumes
  ;; the option's (all-binder) key — so an arm with nested variant
  ;; constraints does NOT cover its option, and a match using nested
  ;; patterns needs an explicit fallthrough (or flat companion arms).
  (define (check-exhaustive scrut-ty scrut-span infos)
    (define span (burp-face scrut-span))
    (define keys (map arm-info-key infos))
    (define (opt-key o)
      (define s (burp-face o))
      (If (Eq "TROW" (ty:type-tag s))
        (arm-span-key s)
        0))
    (define (uncovered? o)
      (define k (opt-key o))
      (Ifz k 1
        (Nil (includes (lambda (ak) (And (Truth ak) (key-subsumes? ak k)))
               keys))))
    (define opts
      (cond
        ((Eq "TSUM" (ty:type-tag span)) (ty:tsum-opts span))
        ((Eq "TROW" (ty:type-tag span)) [span])
        (else 0)))
    (Ifz opts
      (elab-error env "match without fallthrough on a non-sum scrutinee"
        scrut-ty)
      (let ((missing (filter uncovered? opts)))
        (Ifz (Sz missing) 0
          (elab-error env "non-exhaustive match" ["missing" missing])))))
  (define (elab-case c[_ scr arms fall])
    (define sr (elab-val-context ctx (clear-env-goal env) scr))
    (define scrut (_1 sr))
    (define scr-expanded
      (ty:mold-to-span-context (_0 sr) (burp-face (tc-ty scrut))))
    (define arm-state
      (foldl (elab-arm (burp-face (tc-ty scrut))) [(_0 scr-expanded) []] arms))
    (define infos (_1 arm-state))
    (define arms1 (map arm-info-tc infos))
    ;; The fallthrough leg is lowered *inside* the match's let (the
    ;; scrutinee slot), so it must be elaborated with that local in
    ;; scope or its de-bruijn references come out shifted by one.
    ;; The implicit fall carries the arms' dispatch keys so the
    ;; runtime error names the match it came from — a scrutinee can
    ;; only get here as an ill-typed value across the unchecked FFI.
    (define fallr
      (If (Eq foil-no-heir fall)
        [(_0 arm-state) (tc-mean ["unreachable" (map arm-info-key infos)])]
        (elab-val-context (_0 arm-state)
          (push-local-env env (burp-face (tc-ty scrut))) fall)))
    (define fall1 (_1 fallr))
    (define fall-ty
      (If (Eq foil-no-heir fall) ty:TBOT (tc-ty fall1)))
    (define joined
      (foldl
        (lambda (st arm)
          (ty:type-join-context (_0 st) (_1 st) (tc-ty arm)))
        [(_0 fallr) fall-ty]
        arms1))
    (define out-ty (_1 joined))
    (Seq (check-arms-distinct infos)
      (Seq (If (Eq foil-no-heir fall)
             (check-exhaustive (tc-ty scrut) (_1 scr-expanded) infos)
             0)
        [(_0 joined) (tc-match out-ty scrut arms1 fall1)])))
  (define (elab-if i[_ scr tru fall])
    (define sr (elab-val-context ctx (clear-env-goal env) scr))
    (define tr (elab-val-context (_0 sr) env tru))
    (define fr (elab-val-context (_0 tr) env fall))
    (define scrut (_1 sr))
    (define tru1 (_1 tr))
    (define fall1 (_1 fr))
    (define jr (ty:type-join-context (_0 fr) (tc-ty tru1) (tc-ty fall1)))
    (define out-ty (_1 jr))
    (define if-ty (ty:TFUN [(ty:TNAT 0) out-ty out-ty] out-ty))
    (define if-tc (set-tc-ty if-ty (got-entry-tc (canon-path ["if"] sut) sut)))
    (on-call (_0 jr) if-tc [scrut tru1 fall1]))
  (define (elab-self s[_ xs])
    (define found (find-idx match-self (env-locals env)))
    (define idx
      (Ifz found
        (elab-error env "recursive call (_) outside of a function body" 0)
        (_0 found)))
    (define fun-ty (burp-face (burp-self (Ix idx (env-locals env)))))
    ;; peek-ret-cast leaves TBAD when the enclosing function carries no
    ;; ^ return cast; catch that here rather than failing on the apply.
    (unless (And (ty:is-tfun? fun-ty) (Equal ty:TBAD (ty:tfun-ret fun-ty)))
	    (let ((ar (elab-vals-goals ctx env xs (fun-arg-goals fun-ty (Sz xs)))))
          (on-call (_0 ar) (on-var 0 [(Ix idx (env-locals env)) [idx]])
	        (_1 ar)))
      (elab-error env
        "recursive call (_) requires the enclosing function to declare its return type with a ^ cast"
        0)))
  ;; A declared variable the elaborated type never mentions is dropped
  ;; (no TQUA) — uniform for @ and @@, so namespace-scoped vars cost
  ;; nothing on members that don't use them.
  (define (elab-tvars t[_ vars body])
    (define env1 (push-env-tvars vars env))
    (define r (elab-val-context ctx env1 body))
    (define tc (_1 r))
    (define (kept typ)
      (filter (lambda (v) (ty:type-mentions-var? v typ)) vars))
    [(_0 r)
     (If (Eq "TC_TYP" (Hd tc))
       (let ((inner (ty:ttyp-type (tc-typ-inner tc))))
         (tc-typ (ty:TTYP (wrap-tquas (kept inner) inner))))
       (let ((typ (tc-ty tc)))
         (set-tc-ty (wrap-tquas (kept typ) typ) tc)))])
  ;; Const generic parameters: elab the declared types (under the tvar
  ;; env — they may mention sibling tvars), make the names visible to
  ;; the body, and keep only the params the result uses.
  (define (elab-cvars t[_ consts body])
    (define typed-consts
      (foldl
        (lambda (st c[name tysast])
          (let ((tr (elab-type-context (_0 st) env tysast)))
            [(_0 tr) (snoc [name (_1 tr)] (_1 st))]))
        [ctx []] consts))
    (define pairs (_1 typed-consts))
    (define env1 (set-env-consts (Weld pairs (env-consts env)) env))
    (define r (elab-val-context (_0 typed-consts) env1 body))
    (define tc (_1 r))
    (define typ0
      (If (Eq "TC_TYP" (Hd tc))
        (ty:ttyp-type (tc-typ-inner tc))
        (tc-ty tc)))
    (define (kept-const? p)
      (Or (tc-uses-cparam? (_0 p) tc)
        (ty:type-mentions-var? (_0 p) typ0)))
    (define kept (filter kept-const? pairs))
    [(_0 r)
     (If (Eq "TC_TYP" (Hd tc))
       (tc-typ (ty:TTYP (ty:wrap-tcquas kept typ0)))
       (set-tc-ty (ty:wrap-tcquas kept typ0) tc))])
  (cond
    ((tag-is "s_fun")  (elab-fun surf))
    ((tag-is "s_cast") (elab-cast surf))
    ((tag-is "s_row") (elab-row surf))
    ((tag-is "s_lit") [ctx (elab-lit surf)])
    ((tag-is "s_variant") (elab-variant surf))
    ((tag-is "s_relvar") (elab-relvar-call ctx (_1 surf) []))
    ((tag-is "s_app") (elab-call surf))
    ((tag-is "s_spec") (elab-spec surf))
    ((tag-is "s_ref") (elab-ref surf))
    ((tag-is "s_var") (elab-var surf))
    ((tag-is "s_case") (elab-case surf))
    ((tag-is "s_if") (elab-if surf))
    ((tag-is "s_span")
      (elab-val-context ctx (set-env-span (_1 surf) env) (burp-span surf)))
    ((tag-is "s_meth") (elab-meth surf))
    ((tag-is "s_self") (elab-self surf))
    ((tag-is "s_tvars") (elab-tvars surf))
    ((tag-is "s_cvars") (elab-cvars surf))
    ((tag-is "s_letrec") (elab-letrec surf))
    ((tag-is "s_loop") (elab-loop surf))
    ((tag-is "s_ufcs_put")
      (elab-unsupported env "UFCS put (.#) — use .set_<face>(val)"))
    ((tag-is "s_ufcs_over")
      (elab-unsupported env "UFCS update (.%) — use .over_<face>(fun)"))
    ((tag-is "s_literal") [ctx (elab-literal surf)])
    ((or
       (tag-is "s_trow")
       (tag-is "s_tfun")
       (tag-is "s_union"))
      ;; Every type-valued elaboration is normalized to TTYP so the
      ;; declaration path stores the type itself, not (say) a TFUN
      ;; whose _2 slot is its arity.
       (let ((tr (elab-type-context ctx env surf)))
         [(_0 tr) (tc-typ (as-ttyp (_1 tr)))]))
    (else (elab-error env "unimplemented surface form" surf))))

;; Public compatibility wrapper: the context and its memo tables are internal;
;; callers still receive exactly the historical TC value.
(define (elab-val sut env surf)
  (_1 (elab-val-context (ty:make-type-context sut) env surf)))

;;; Module elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Row type declarations get accessors, quantified or not: returns
;; [tvars cparams row-items] (tvars 0 when the row is not generic), or 0.
(define (can-gen-accessors? tc[ty])
  (define (unwrap vars cps typ)
    (cond
      ((Eq (ty:type-tag typ) "TQUA")
        (unwrap (snoc (ty:tqua-name typ) vars) cps (ty:tqua-body-value typ)))
      ((Eq (ty:type-tag typ) "TCQUA")
        (unwrap vars
          (snoc [(ty:tcqua-name typ) (ty:tcqua-type typ)] cps)
          (ty:tcqua-body typ)))
      ((Eq (ty:type-tag typ) "TROW")
        [(Ifz (Sz vars) 0 vars) cps (ty:trow-vals typ)])
      (else 0)))
  (If (and (Eq (Hd tc) "TC_TYP") (Eq (ty:type-tag ty) "TTYP"))
    (unwrap [] [] (ty:ttyp-type ty))
    0))

;;; Unsupported-syntax scan ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Before elaborating a module we sweep every declaration body for
;; surface forms the elaborator does not implement yet, and report all
;; of them at once — located — instead of dying mid-elaboration on the
;; first one with a raw AST dump.  (Diagnostics for *type* errors are
;; still fail-fast; accumulating those into env-diags needs elab-val to
;; return diagnostics, a larger refactor.)

(define unsupported-tags
  [["s_ufcs_put" "UFCS put (.#) — use .set_<face>(val)"]
   ["s_ufcs_over" "UFCS update (.%) — use .over_<face>(fun)"]])

(define (scan-unsupported span0 top)
  (define (fold-kids f acc row)
    (define (go i acc)
      (If (Ge i (Sz row)) acc (go (Inc i) (f acc (Ix i row)))))
    (go 0 acc))
  (define (go span acc node)
    (Ifz (IsApp node) acc
      (If (Eq "s_span" (_0 node))
        (go (_1 node) acc (_2 node))
        (letrec
          ((tag (_0 node))
           (lit-bad (And (Eq tag "s_literal")
                      (Nil (Or (Eq "quip" (_1 node)) (Eq "cord" (_1 node))))))
           (hit (find (lambda (p) (Eq (_0 p) tag)) unsupported-tags))
           (acc1 (cond
                   (lit-bad
                     (snoc ["unsupported" ["non-quip literal" (_1 node)]
                            (span-blurb span)] acc))
                   (hit
                     (snoc ["unsupported" (_1 (_0 hit)) (span-blurb span)] acc))
                   (else acc))))
          (fold-kids (go span) acc1 node)))))
  (go span0 [] top))

(define (elab-mod-go sut mod profiled?)
  (define (insert-elab-tc name span tc sut)
    (If (Eq (Hd tc) "TC_TYP")
      (ty:insert-typ name span (ty:ttyp-type (tc-typ-inner tc)) sut)
      (insert-tc name span tc sut)))

  ;; prototype-tc : Subject -> Env -> SAST -> TC
  ;; Derive the part of a declaration's type that is visible without
  ;; elaborating its body.  Keeping this deliberately signature-only is what
  ;; makes the predeclaration pass a seal rather than an order-sensitive first
  ;; elaboration.  A declaration with no explicit usable signature gets TANY;
  ;; referencing that placeholder as a function still fails at the reference
  ;; site's enclosing span when type-apply runs.
  (define (prototype-tc psut env body[tag])
    (define (recur env1 body1) (prototype-tc psut env1 body1))
    (define (wrap-vars vars tc)
      (If (Eq "TC_TYP" (Hd tc))
        (let ((inner (ty:ttyp-type (tc-typ-inner tc))))
          (tc-typ (ty:TTYP (wrap-tquas vars inner))))
        (set-tc-ty (wrap-tquas vars (tc-ty tc)) tc)))
    (define (wrap-consts pairs tc)
      (If (Eq "TC_TYP" (Hd tc))
        (let ((inner (ty:ttyp-type (tc-typ-inner tc))))
          (tc-typ (ty:TTYP (ty:wrap-tcquas pairs inner))))
        (set-tc-ty (ty:wrap-tcquas pairs (tc-ty tc)) tc)))
    (cond
      ((Eq tag "s_span")
        (recur (set-env-span (_1 body) env) (_2 body)))
      ((Eq tag "s_tvars")
        (let* ((vars (_1 body))
               (env1 (push-env-tvars vars env)))
          (wrap-vars vars (recur env1 (_2 body)))))
      ((Eq tag "s_cvars")
        (let* ((pairs
                 (map (lambda (c[name tysast])
                        [name (elab-type-env psut env tysast)])
                   (_1 body)))
               (env1 (set-env-consts (Weld pairs (env-consts env)) env)))
          (wrap-consts pairs (recur env1 (_2 body)))))
      ((Eq tag "s_fun")
        (let* ((args (map (elab-type-env psut env) (surf-fun-args body)))
               (ret (peek-ret-cast psut env (surf-fun-ret body))))
          ;; A forward call needs the declared return type.  Publishing a
          ;; guessed TFUN here would let genuinely recursive untyped code pass
          ;; through TANY; publishing TANY makes that call a located error.
          (If (Equal ty:TBAD ret)
            (untyped-prototype 0)
            (tc-const (ty:TFUN args ret) 0))))
      ((Eq tag "s_cast")
        (tc-const (elab-type-env psut env (surf-cast-ty body)) 0))
      ((Or (Eq tag "s_trow") (Or (Eq tag "s_tfun") (Eq tag "s_union")))
        (tc-typ (as-ttyp (elab-type-env psut env body))))
      (else (untyped-prototype 0))))

  ;; type-prototype-form? : SAST -> Bool
  ;; The placeholder pass must expose type declarations as TC_TYP entries so
  ;; later prototype signatures can specialize them before any body runs.
  (define (type-prototype-form? body[tag])
    (cond
      ((Eq tag "s_span") (type-prototype-form? (_2 body)))
      ((Or (Eq tag "s_tvars") (Eq tag "s_cvars"))
        (type-prototype-form? (_2 body)))
      (else (Or (Eq tag "s_trow")
              (Or (Eq tag "s_tfun") (Eq tag "s_union"))))))

  ;; predeclare-module : Subject -> [SAST] -> Subject
  ;; Insert every declaration path first, then refine signatures to a small
  ;; fixed point.  Paths, not source position, determine insertion order, so
  ;; replacing prototypes with actual entries cannot perturb subject-order.
  (define (predeclare-module base rows)
    (define decls
      (sort (lambda (a b) (cmp-total (_1 a) (_1 b)))
        (filter (lambda (r) (And (IsApp r) (Eq "s_decl" (_0 r)))) rows)))
    (define (placeholder acc ent[_ name0 span body])
      (define name (root-path acc name0))
      (If (type-prototype-form? body)
        (ty:insert-typ name span ty:TANY acc)
        (insert-tc name span (untyped-prototype 0) acc)))
    (define seeded (foldl placeholder base decls))
    (define (refine acc ent[_ name0 span body])
      (define name (root-path acc name0))
      ;; Prototype inference is best-effort.  Malformed annotations are still
      ;; diagnosed by the ordinary per-declaration elaboration pass; they must
      ;; not prevent unrelated declarations from seeing the sealed path set.
      (define pr
        (Try (lambda (z)
               (let ((tc (prototype-tc acc (set-env-name name empty-env) body)))
                 (DeepSeq tc tc)))
          0))
      (define tc (If (Eq 1 (Hd pr)) (untyped-prototype 0) (_0 pr)))
      (define acc1 (insert-elab-tc name span tc acc))
      (define gen? (can-gen-accessors? tc))
      (Ifz gen? acc1
        (gen-accessors name (_0 gen?) (_1 gen?) (_2 gen?) acc1)))
    ;; A chain of signatures may mention a generic declared later in canonical
    ;; order.  N refinements suffice for an N-node dependency chain; replacement
    ;; is idempotent once the prototypes stabilize.
    (define (settle n acc)
      (Ifz n acc (settle (Dec n) (foldl refine acc decls))))
    (define sealed (settle (max 1 (Sz decls)) seeded))
    ;; Prototype refinement also creates public row accessors.  They are
    ;; derived declarations of this unit: make them source-visible in the same
    ;; sealed world, with the original own-layer provenance, without adding
    ;; them to the source layer or its unit identity.
    (define environment (metadata-environment (sut-unit sealed)))
    (Ifz environment
      sealed
      (let* ((root (sut-root sealed))
             (local-path
               (lambda (key)
                 (If (foil-env:path-prefix? root key)
                   (drop (Sz root) key)
                   key)))
             (derived
               (filter
                 (lambda (pair)
                   (foil-env:res-unknown?
                     (foil-env:resolve (local-path (_0 pair)) environment)))
                 (subject-entry-delta base sealed))))
        (Ifz derived
          sealed
          (let* ((layer
                   (foil-env:make-layer ["derived-own"]
                     (map
                       (lambda (pair)
                         (let ((key (_0 pair)))
                           [(local-path key)
                            (foil-env:note-make (_1 pair)
                              (get-span key sealed))]))
                       derived)))
                 (environment1
                   (foil-env:extend-own-derived layer environment))
                 (sealed1 (set-metadata-environment environment1 sealed)))
            (foldl
              (lambda (acc pair)
                (let ((key (_0 pair)))
                  (mark-visible (root-path acc (local-path key)) key acc)))
              sealed1 derived))))))
  ;; Each declaration elaborates under its own Try, so one failure does
  ;; not hide the next decl's: the error is collected, a TC_MEAN poison
  ;; entry stands in (referees of the failed decl fail their own Try),
  ;; and the module reports every failed decl at once.  The TC is
  ;; deep-forced inside the Try — elaboration is lazy enough that an
  ;; unforced error would otherwise fire in a neighbor's context.
  (define (elab-entry acc ent[_ name0 span body])
    (define sut (_0 acc))
    (define diags (_1 acc))
    (define ctx (_2 acc))
    ;; Declarations insert at their rooted (canonical) key; source
    ;; references stay relative and resolve through canon-path.
    (define name (root-path sut name0))
    (define r
      (Try (lambda (z)
             (let* ((er0
                      (elab-val-context ctx
                        (set-env-name name empty-env) body))
                    (tc
                      (If profiled?
                        (profile-zone:force-zone
                          (strcat ["foil.elab.decl." (print-path name0)])
                          (_1 er0))
                        (_1 er0)))
                    (er [(_0 er0) tc]))
               ;; Force the public TC exactly as before.  The context contains
               ;; memo payloads (often large recursive spans); deep-forcing the
               ;; cache itself at every declaration defeats the memoization.
               (DeepSeq tc er)))
        0))
    (If (Eq 1 (Hd r))
      (let ((sut1 (insert-tc name span (tc-mean ["elab failed" name]) sut)))
        [sut1 (snoc [name (_0 r)] diags)
         (ty:type-context-with-subject ctx sut1 0)])
      (let* ((er (_0 r))
             (ctx1 (_0 er))
             (tc (_1 er))
             (acc? (can-gen-accessors? tc))
             (sut1 (insert-elab-tc name span tc sut))
             (sut2 (Ifz acc? sut1
                     (gen-accessors name (_0 acc?) (_1 acc?) (_2 acc?) sut1)))
             (type-env-changed? (Eq (Hd tc) "TC_TYP")))
        [sut2 diags
         (ty:type-context-with-subject ctx1 sut2 type-env-changed?)])))
  (define (scan-entry diags ent[_ name span body])
    ;; Imports are resolved by compile-mod before elaboration; one
    ;; reaching here means an inline module tried to import.
    (cond
      ((Eq "s_import" (_0 ent))
        (snoc ["in-decl" [(_3 ent)] "unresolved import (inline modules cannot import)"]
          diags))
      ;; A decl the parser could not parse (per-decl recovery).
      ((Eq "s_bad" (_0 ent))
        (snoc ["in-decl" name body (span-blurb span)] diags))
      ;; Backstop for the parse-level fence: the type-application
      ;; namespaces are not declarable.
      ((And (Sz name)
         (Or (Eq ty-ap-tag (Ix 0 name)) (Eq ty-var-tag (Ix 0 name))))
        (snoc ["in-decl" name
               "reserved name: /ty-ap and /ty-var belong to the type system"
               (span-blurb span)]
          diags))
      (else
        (Weld diags
          (map (lambda (d) ["in-decl" name d]) (scan-unsupported span body))))))
  ;; Post-pass: every type declared by the module must be well-formed
  ;; against the *final* subject (types may reference declarations that
  ;; follow them, so checking at insert time is too early).
  (define (wf-entry sut1 diags ent[_ name span body])
    (define entry-tc (got-entry-tc (root-path sut1 name) sut1))
    (define res0 (ty:check-type-wf sut1 (tc-ty entry-tc)))
    (define res
      (If profiled?
        (profile-zone:force-zone
          (strcat ["foil.elab.well-formed." (print-path name)]) res0)
        res0))
    (If (Eq "left" (Hd res))
      (snoc ["in-decl" name (_0 res) (span-blurb span)] diags)
      diags))
  (define diags0 (foldl scan-entry [] mod))
  (define diags
    (If profiled?
      (profile-zone:force-zone "foil.elab.unsupported-scan" diags0)
      diags0))
  (Ifz (Sz diags)
    (let* ((sealed (predeclare-module sut mod))
           (r (foldl elab-entry
               [sealed [] (If profiled?
                            (ty:make-profile-type-context sealed)
                            (ty:make-type-context sealed))]
               mod)))
      (Ifz (Sz (_1 r))
        (let ((wf-diags (foldl (wf-entry (_0 r)) [] mod)))
          (Ifz (Sz wf-diags)
            (retain-context-resolutions (_0 r) (_2 r))
            (error ["foil-type-wf" wf-diags])))
        (error ["foil-elab-errors" (_1 r)])))
    (error ["foil-unsupported" diags])))

(define (elab-mod sut mod)
  (elab-mod-go sut mod 0))

(define (elab-mod-profiled sut mod)
  (elab-mod-go sut mod 1))
