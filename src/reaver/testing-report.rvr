;;;; Retain test reports using the native namespace and the runtime's Save.
;;;; No report serializer or separate persistence format is involved. The
;;;; launcher binds begin/execute results in its disposable Reaver session;
;;;; normal top-level saves retain the started and completed namespace values.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind testing (#module testing))

(define (accepted result)
  (If (Equal "ok" (Hd result)) (_0 result)
    (error ["test-report-admission" (_0 result)])))
(define (helper report name)
  (driver:get-perc ["testing_report" name] (_0 report)))

;; A report holds its exact published writer artifact and namespace. Report
;; construction is independent of the publication contexts exercised by tests.
(define (begin specs procedure)
  (define self ("x" 17))
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define system (bootstrap:build-system (Pin "test-report/v1") resolve slot))
  (define local (bootstrap:build-local self system resolve slot ["testing_report"]))
  (define artifact (Unpin (_1 (need (find (lambda (pair)
    (Equal "testing_report" (_0 pair))) (_2 (_1 local)))))))
  (define inputs (map (lambda (spec)
    [(_0 spec) (_1 spec) (read-text-file (strcat
      [(If (Equal "reaver" (_0 spec)) "reaver/" "foil/") (_1 spec)
       (If (Equal "reaver" (_0 spec)) ".rvr" ".foil")]))]) specs))
  (define report [artifact (_0 local) (map _1 specs) []])
  [artifact (accepted ((helper report "begin") inputs (Pin procedure) (_1 report)))
   (_2 report) []])

;; execute returns [captured implementations, result rows]. The Foil runner
;; supplies its actual compiled artifacts; Reaver entries retain their closure.
(define (execute report procedure)
  (define outcome (Try (lambda (ignored)
    (define value (procedure 0))
    (DeepSeq value value)) 0))
  (define value
    (If (Eq 1 (Hd outcome))
      [procedure [(testing:report "error" "worker" "execution"
                     "completed worker" (testing:exception (_0 outcome)))]]
      (_0 outcome)))
  (define results (testing:complete (_2 report) (_1 value)))
  (define state (accepted ((helper report "finish") (testing:passed results)
    results (Pin (_0 value)) (_1 report))))
  [(_0 report) state (_2 report) results])

(define (read report relative) ((helper report "read") relative (_1 report)))
(define (read-at report version relative) ((helper report "read_at") version relative (_1 report)))
(define (versions report) ((helper report "versions") (_1 report)))
(define (finish report) (testing:finish (_2 report) (_3 report)))
(#export begin execute read read-at versions finish)
