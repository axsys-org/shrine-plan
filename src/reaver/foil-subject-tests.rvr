(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind cairn (#module cairn))
(#import cairn)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind nt (#module foil-new-types))


;;; AX path map behavior ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define test-ax
  (pipe empty-ax
    (putax ["foo"] "foo-val")
    (putax ["foo" "bar"] "bar-val")
    (putax ["baz"] "baz-val")))

assert(Equal "foo-val" (gotax ["foo"] test-ax))
assert(Equal "bar-val" (gotax ["foo" "bar"] test-ax))
assert(Equal "baz-val" (gotax ["baz"] test-ax))
assert(Equal "missing" (gutax ["nope"] "missing" test-ax))


;;; Subject insertion and lookup ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lit-tc (tc-lit (nt:tnat 0) 42))
(define sut-lit (insert-tc ["answer"] wack-span lit-tc empty-subject))
(define lit-entry (got-entry ["answer"] sut-lit))

assert(Equal lit-tc (got-entry-tc ["answer"] sut-lit))
assert(Equal lit-tc (tc-entry-contents lit-entry))
assert(Equal wack-span (tc-entry-span lit-entry))
assert(Equal [["answer"]] (subject-order sut-lit))

(define typ (nt:mono (nt:trow (print-path ["point"])
  [(nt:trow-item 0 (nt:tnat 0)) (nt:trow-item 1 (nt:tnat 0))])))
(define sut-typ (insert-tc ["point"] wack-span (tc-typ typ) empty-subject))
assert(Equal typ (tc-typ-inner (got-entry-tc ["point"] sut-typ)))
assert(Equal wack-span (get-span ["point"] sut-typ))
assert(Eq 0 (get-span ["missing"] sut-typ))
(define ir-span [9 2 40 7])
(define sut-ir
  (insert-entry-sut ["answer"]
    ("IR_ENTRY" ["answer"] ir-span 42 lit-tc 0) empty-subject))
assert(Equal ir-span (get-span ["answer"] sut-ir))

(define ffi-sut
  (insert-ffi ["inc"] Inc (nt:tfun [(nt:tnat 0)] (nt:tnat 0)) empty-subject))

assert(Equal (tc-ffi-val (got-entry-tc ["inc"] ffi-sut)) Inc)


;;; Obsolete artifact rejection ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define legacy-sut ("SUT" (_0 sut-lit) (subject-order sut-lit) 0 []))
(define (rejects-subject sut)
  (Eq 1 (Hd (Try (lambda (z) (force (require-subject sut))) 0))))
assert(rejects-subject legacy-sut)
assert(rejects-subject ("foil/subject/v2" (_0 sut-lit) 0 0 []))
assert(Eq 1 (Hd (Try (lambda (z)
  (force (set-sut-unit ["unit-marker"] legacy-sut))) 0)))
assert(Equal sut-lit (require-subject sut-lit))
(define current-marked (mark-visible ["answer"] ["answer"] sut-lit))
assert(Equal ["answer"] (gotax ["answer"] (sut-visible current-marked)))
assert(Equal lit-tc (got-entry-tc ["answer"] current-marked))

;;; Artifact entry replay ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define replacement-key ["replace"])
(define old-pin (Pin ["old-entry"]))
(define new-pin (Pin ["new-entry"]))
(define wrong-pin (Pin ["wrong-entry"]))
(define replacement-base
  (put-entry-pin replacement-key old-pin empty-subject))
(define replacement-final
  (put-entry-pin replacement-key new-pin replacement-base))

;; Keep the historical two-field projection stable for non-replay callers.
(define public-delta
  (subject-entry-delta replacement-base replacement-final))
assert(Eq 1 (Sz public-delta))
assert(Eq 2 (Sz (_0 public-delta)))
assert(Equal replacement-key (_0 (_0 public-delta)))
assert(Equal new-pin (_1 (_0 public-delta)))

(define passthru
  (pipe empty-subject
    (insert-entry-sut ["foo" "bar"] 3)
    push-layer))

assert(Equal (got-entry ["foo" "bar"] passthru) 3)

(print "foil-subject tests passed")

;; A shared import graph has linear traversal size, even with repeated
;; diamonds. Lookup retains its original first-import precedence.
(define diamond-leaf (insert-entry-sut ["present"] 42 empty-subject))
(define diamond
  (foldl (lambda (layer number)
    (define pin (Pin layer))
    (set-sut-root [(showNat number)]
      (head-onto-pins [pin pin] empty-subject))) diamond-leaf (gen 20 (lambda (i) i))))
assert(Equal 21 (Sz (rowify (sut-layers diamond))))
assert(Equal (sut-find ["present"] diamond-leaf) (sut-find ["present"] diamond))
assert(Equal 0 (sut-find ["missing"] diamond))
assert(Equal 0 (definition-moment ["missing"] diamond))
assert(Equal 0 (definition-key [[["x" 17] ["ts" "missing"]] 1] diamond))
(define first-import (insert-entry-sut ["same"] 1 empty-subject))
(define last-import (insert-entry-sut ["same"] 2 empty-subject))
(define precedence
  (head-onto-pins [(Pin first-import) (Pin last-import)] empty-subject))
assert(Equal (sut-find ["same"] first-import) (sut-find ["same"] precedence))
