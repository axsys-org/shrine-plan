(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind cairn (#module cairn))
(#import cairn)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))


;;; AX path map behavior ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define test-ax
  (pipe empty-ax
    (putax ["foo"] "foo-val")
    (putax ["foo" "bar"] "bar-val")
    (putax ["baz"] "baz-val")))

assert(Equal "foo-val" (gotax ["foo"] test-ax))
assert(Equal "bar-val" (gotax ["foo" "bar"] test-ax))
assert(Equal "baz-val" (gotax ["baz"] test-ax))
assert(Equal "missing" (gutax ["nope"] "missing" test-ax))


;;; Subject insertion and lookup ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define lit-tc (tc-lit (ty:TNAT 0) 42))
(define sut-lit (insert-tc ["answer"] wack-span lit-tc empty-subject))
(define lit-entry (got-entry ["answer"] sut-lit))

assert(Equal lit-tc (got-entry-tc ["answer"] sut-lit))
assert(Equal lit-tc (tc-entry-contents lit-entry))
assert(Equal wack-span (tc-entry-span lit-entry))
assert(Equal [["answer"]] (subject-order sut-lit))

(define typ (ty:TROW (print-path ["point"]) [(ty:TNAT 0) (ty:TNAT 0)]))
(define sut-typ
  (ty:insert-typ ["point"] wack-span
    (ty:TROW 0 [(ty:TNAT 0) (ty:TNAT 0)])
    empty-subject))

assert(Equal typ (got-type ["point"] sut-typ))

;; TODO: enable when get-span reads tc-entry-span for subject entries.
; assert(Equal wack-span (get-span ["point"] sut-typ))

(define ffi-sut
  (insert-ffi ["inc"] Inc (ty:TFUN [(ty:TNAT 0)] (ty:TNAT 0)) empty-subject))

assert(Equal (tc-ffi-val (got-entry-tc ["inc"] ffi-sut)) Inc)


;;; Historical subject upgrades ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Four-field subjects remain valid snapshot data.  Extended-field writes must
;; rebuild them before updating because `Up` cannot append a missing slot.
(define legacy-sut
  ("SUT"
    (_0 sut-lit)
    (subject-order sut-lit)
    (sut-tvar sut-lit)
    (sut-root sut-lit)))

assert(Eq 4 (Sz legacy-sut))
assert(Eq 0 (sut-unit legacy-sut))
assert(Eq 0 (sut-visible legacy-sut))

(define legacy-unit-written
  (set-sut-unit ["unit-marker"] legacy-sut))

;; the upgraded shape is now nine fields (vis-inverse slot 6,
;; write-log slot 7, lazy projection slot 8)
assert(Eq 10 (Sz legacy-unit-written))
assert(Equal ["unit-marker"] (sut-unit legacy-unit-written))
assert(Eq 0 (sut-visible legacy-unit-written))
assert(Equal lit-tc (got-entry-tc ["answer"] legacy-unit-written))
assert(Equal (subject-order legacy-sut)
  (subject-order legacy-unit-written))
assert(Equal (sut-root legacy-sut) (sut-root legacy-unit-written))

(define legacy-marked
  (mark-visible ["answer"] ["answer"] legacy-sut))

assert(Eq 10 (Sz legacy-marked))
assert(Equal ["answer"]
  (gotax ["answer"] (sut-visible legacy-marked)))
assert(Eq 0 (sut-unit legacy-marked))

(define legacy-both
  (set-sut-unit ["unit-marker"] legacy-marked))

assert(Equal ["unit-marker"] (sut-unit legacy-both))
assert(Equal ["answer"]
  (gotax ["answer"] (sut-visible legacy-both)))

;; The intermediate five-field shape can occur when older code wrote `unit`
;; directly.  Its value survives the same normalization.
(define intermediate-sut
  ("SUT"
    (_0 legacy-sut)
    (subject-order legacy-sut)
    (sut-tvar legacy-sut)
    (sut-root legacy-sut)
    ["old-unit"]))
(define intermediate-visible
  (set-sut-visible empty-ax intermediate-sut))
assert(Eq 10 (Sz intermediate-visible))
assert(Equal ["old-unit"] (sut-unit intermediate-visible))
assert(Equal empty-ax (sut-visible intermediate-visible))


;;; Artifact entry replay ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define replacement-key ["replace"])
(define old-pin (Pin ["old-entry"]))
(define new-pin (Pin ["new-entry"]))
(define wrong-pin (Pin ["wrong-entry"]))
(define replacement-base
  (put-entry-pin replacement-key old-pin empty-subject))
(define replacement-final
  (put-entry-pin replacement-key new-pin replacement-base))

;; Keep the historical two-field projection stable for non-replay callers.
(define public-delta
  (subject-entry-delta replacement-base replacement-final))
assert(Eq 1 (Sz public-delta))
assert(Eq 2 (Sz (_0 public-delta)))
assert(Equal replacement-key (_0 (_0 public-delta)))
assert(Equal new-pin (_1 (_0 public-delta)))

(define passthru
  (pipe empty-subject
    (insert-entry-sut ["foo" "bar"] 3)
    push-layer))

assert(Equal (got-entry ["foo" "bar"] passthru) 3)

(print "foil-subject tests passed")
