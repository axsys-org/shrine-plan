;;;; wisp-env tests — reflected Global traversal and #env call-site capture.

(#bind reef (#module reef))
(#import reef)

(#bind wisp (#module wisp))

(#bind wisp-env (#module wisp-env))
(#import wisp-env)


(define fixture
  (wisp:ginsert
    (Pin ["middle" "hello" "value" 0 0])
    (wisp:ginsert
      (Pin ["zeta" [1 2] "value" 1 ["type-info"]])
      (wisp:ginsert
        (Pin ["alpha" 7 "macro" 0 0])
        0))))

(define fixture-entries (environment-entries fixture))

assert(Equal ["alpha" "middle" "zeta"]
  (map environment-entry-name fixture-entries))

assert(Eq 3
  (environment-fold (lambda (count _) (Inc count)) 0 fixture))

assert(Equal ["macro" "value" "value"]
  (environment-map environment-entry-kind fixture))

assert(Equal
  (strcat
    ["global environment (3 bindings)" 10
     "  macro alpha = 7" 10
     "  value middle = " 34 "hello" 34 10
     "  value zeta [typed] = <app:2>"])
  (environment-text fixture))

assert(Eq 0
  (print-global-environment fixture))

;; The reflected value contains bindings established before this definition,
;; but not the definition currently being compiled.
(define captured (current-global-environment))

assert(Truth (wisp:glookup "reef" captured))
assert(Truth (wisp:glookup "wisp" captured))
assert(Truth (wisp:glookup "wisp-env" captured))
assert(Nil (wisp:glookup "captured" captured))

(print "wisp-env tests passed")
