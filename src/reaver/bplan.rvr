;; scan8 : Nat -> Nat -> Nat -> Bool -> [Nat Nat Nat]
;; Treat source as a little-endian byte string and class as a 256-bit byte-set.
;; Starting at byte index start, scan while byte membership in class equals
;; polarity (nonzero means inside the class, zero means outside).  Return
;; [end newline-count final-column], where only LF counts as a newline and
;; final-column counts bytes since the last LF in the scanned span.  If start
;; is at or past the end, return [start 0 0].
(bplan ("scan8" source start class polarity))

;; StrTree : CordTree -> Nat
;; Return the byte length represented by a deeply-normalized CordTree:
;;   ("text" bytes)                 contributes Bytes(bytes)
;;   ("slice" source offset length) contributes length
;;   ("repeat" byte count)          contributes count
;;   ("cat" left right)             contributes both subtrees
;; Every leaf field must be a Nat.  Malformed trees return 0; shared subtrees
;; are counted once per occurrence.
(bplan ("StrTree" tree))


;;; RPLAN ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind R (#pin "R"))

(#macro rplan
  (#fun pin noinline "rplan" (rplan _ u g _ _ x)
    (#let ((sig (Ix 1 x)))
      (#let ((nam (Ix 0 (Ix 0 sig))))
        (0 u g
          (0 "#bind" nam
            (0 "#fun" "pin" "noinline" (1 nam) (Up 0 nam sig)
              (0 (1 R) sig))))))))

(rplan ("Input" bytes))
(rplan ("Output" bytes))
(rplan ("Warn" bytes))
(rplan ("Spawn"       fn))
(rplan ("Send"        handle msg))
(rplan ("SendCaps"    handle msg caps))
(rplan ("Recv"        z))
(rplan ("CloseHandle" handle))
(rplan ("Listen"      port))
(rplan ("Accept"      fd))
(rplan ("Read"        fd n))
(rplan ("Write"       fd dat))
(rplan ("CloseFd"     fd))
(rplan ("ReadFile"    filename))
(rplan ("WriteFile"    filename bytes))
(rplan ("Now"    _x))
(rplan ("Dump"    _x))
(rplan ("Stamp" path))


(#bind S (#pin "S"))

(#macro splan
  (#fun pin noinline "splan" (splan _ u g _ _ x)
    (#let ((sig (Ix 1 x)))
      (#let ((nam (Ix 0 (Ix 0 sig))))
        (0 u g
          (0 "#bind" nam
            (0 "#fun" "pin" "noinline" (1 nam) (Up 0 nam sig)
              (0 (1 S) sig))))))))

(splan ("ReadFolder" filename))
(splan ("ZoneStart" label))
(splan ("ZoneEnd" handle))

;;; Essentials ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind drop
  (#fun pin noinline "drop" (_ n row)
    (Slice n (Sz row) row)))

(#bind _0 Ix0)
(#bind _1 Ix1)
(#bind _2 Ix2)
(#bind _3 Ix3)
(#bind _4 Ix4)
(#bind _5 Ix5)
(#bind _6 Ix6)
(#bind _7 Ix7)
(#bind _8 (Ix 8))
(#bind _9 (Ix 9))
