(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; Zoo recipe metadata and deterministic Foundry selection.  These tests
;;; exercise the pure registry layer only: no namespace admission, watches,
;;; host routes, or renderer execution.

(define sut (stage:sut-of "web"))
(define (app path) (foil:source-entry-val path sut))
(define (ts s) ("ts" s))

(define myth-new (app ["myth" "new"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-meld (app ["myth" "meld"]))
(define txt-at (app ["myth" "txt_at"]))
(define lore-line (app ["lore" "line"]))

(define weft-spec (app ["weft_spec_make"]))
(define weft-recipe (app ["weft_recipe_stub"]))
(define zoo-entry (app ["zoo" "entry"]))
(define zoo-defaults (app ["zoo" "recipe_defaults"]))
(define zoo-path-at (app ["zoo" "path_at"]))
(define zoo-paths-at (app ["zoo" "paths_at"]))
(define zoo-request (app ["zoo" "make_request"]))
(define zoo-resolve (app ["zoo" "resolve"]))
(define zoo-resolution-part (app ["zoo" "resolution_part"]))
(define zoo-resolution-via (app ["zoo" "resolution_via"]))
(define zoo-resolution-rank (app ["zoo" "resolution_rank"]))
(define zoo-resolution-paths (app ["zoo" "resolution_paths"]))
(define zoo-with-part (app ["zoo" "with_part"]))

(define (put rec slot pail)
  (myth-meld (myth-sing slot pail) rec))

(define root [(ts "app") (ts "spec")])
(define role-chat [(ts "chat") (ts "plate")])
(define f-css [(ts "feature") (ts "css")])
(define f-gpu [(ts "feature") (ts "gpu")])

(define (card role mode ceiling renderer pronunciation requires fallbacks n)
  (weft-recipe
    n
    [(ts "demo")]
    (lore-line "resolver fixture")
    (weft-spec role "subtree" "surface-tree" mode ceiling renderer
      pronunciation "z" requires fallbacks)))

(define (entry at role mode ceiling renderer pronunciation requires fallbacks n)
  (zoo-entry root [at] "resolver-tests"
    (card role mode ceiling renderer pronunciation requires fallbacks n)))

(define (request role mode ceiling renderer pronunciation features)
  (zoo-request role mode ceiling renderer pronunciation features))

;;; Metadata-bearing cards keep the complete declarative packet. ;;;;;;;;;;;;;;;;

(define meta-card
  (card role-chat "full" "plate" "web" "shrine" [f-css]
    [[(ts "fallback")]] 1))
assert(Equal role-chat (zoo-path-at [(ts "recipe") (ts "role")] meta-card))
assert(Equal "subtree" (txt-at [(ts "recipe") (ts "input")] meta-card))
assert(Equal "surface-tree" (txt-at [(ts "recipe") (ts "output")] meta-card))
assert(Equal "full" (txt-at [(ts "recipe") (ts "mode")] meta-card))
assert(Equal "plate" (txt-at [(ts "recipe") (ts "ceiling")] meta-card))
assert(Equal "web" (txt-at [(ts "recipe") (ts "renderer")] meta-card))
assert(Equal "shrine" (txt-at [(ts "recipe") (ts "pronunciation")] meta-card))
assert(Equal "z" (txt-at [(ts "recipe") (ts "care")] meta-card))
assert(Equal [f-css]
  (zoo-paths-at [(ts "recipe") (ts "requires")] meta-card))

;;; Exact selection requires every declared axis and required feature. ;;;;;;;;;;

(define web-entry
  (entry (ts "web") role-chat "full" "plate" "web" "shrine"
    [f-css] [] 2))
(define exact
  (zoo-resolve
    (request role-chat "full" "plate" "web" "shrine" [f-css f-gpu])
    [web-entry]))
assert(Equal "/boot/zoo/resolution/exact" (Hd exact))
assert(Equal [(ts "app") (ts "spec") (ts "web")]
  (zoo-resolution-part exact))

;;; Ordered fallback skips an incompatible first target and selects rank 1. ;;;;;

(define bad-part [(ts "app") (ts "spec") (ts "bad")])
(define text-part [(ts "app") (ts "spec") (ts "text")])
(define rich-role [(ts "chat") (ts "rich-plate")])
(define primary
  (entry (ts "rich") rich-role "full" "plate" "web" "shrine"
    [f-gpu] [bad-part text-part] 3))
(define bad-target
  (entry (ts "bad") [(ts "chat") (ts "fallback-bad")] "full" "plate"
    "text" "shrine" [f-gpu] [] 4))
(define text-target
  (entry (ts "text") [(ts "chat") (ts "fallback-text")] "full" "plate"
    "text" "shrine" [] [] 5))
(define fallback
  (zoo-resolve
    (request rich-role "full" "plate" "text" "shrine" [])
    [primary bad-target text-target]))
assert(Equal "/boot/zoo/resolution/fallback" (Hd fallback))
assert(Equal text-part (zoo-resolution-part fallback))
assert(Equal [(ts "app") (ts "spec") (ts "rich")]
  (zoo-resolution-via fallback))
assert(Eq 1 (zoo-resolution-rank fallback))

;;; Multiple compatible variants never depend on row ordering. ;;;;;;;;;;;;;;;;;

(define web-entry-2
  (entry (ts "web2") role-chat "full" "plate" "web" "shrine"
    [f-css] [] 6))
(define ambiguous
  (zoo-resolve
    (request role-chat "full" "plate" "web" "shrine" [f-css])
    [web-entry web-entry-2]))
assert(Equal "/boot/zoo/resolution/ambiguous" (Hd ambiguous))
assert(Equal
  [[(ts "app") (ts "spec") (ts "web")]
   [(ts "app") (ts "spec") (ts "web2")]]
  (zoo-resolution-paths ambiguous))

;;; Missing and incompatible are distinct refusal outcomes. ;;;;;;;;;;;;;;;;;;;;;

(define missing
  (zoo-resolve
    (request [(ts "absent")] "full" "plate" "web" "shrine" [])
    [web-entry]))
assert(Equal "/boot/zoo/resolution/missing" (Hd missing))
assert(Equal [[(ts "absent")]] (zoo-resolution-paths missing))

(define incompatible
  (zoo-resolve
    (request role-chat "compact" "plate" "web" "shrine" [f-css])
    [web-entry]))
assert(Equal "/boot/zoo/resolution/incompatible" (Hd incompatible))
assert(Equal [[(ts "app") (ts "spec") (ts "web")]]
  (zoo-resolution-paths incompatible))

;;; Legacy cards normalize without changing the original weft_card API. ;;;;;;;;;

(define legacy-part [(ts "app") (ts "legacy") (ts "log")])
(define legacy
  (zoo-defaults legacy-part "felt" myth-new))
assert(Equal legacy-part
  (zoo-path-at [(ts "recipe") (ts "role")] legacy))
assert(Equal "subtree" (txt-at [(ts "recipe") (ts "input")] legacy))
assert(Equal "record" (txt-at [(ts "recipe") (ts "output")] legacy))
assert(Equal "full" (txt-at [(ts "recipe") (ts "mode")] legacy))
assert(Equal "component" (txt-at [(ts "recipe") (ts "ceiling")] legacy))
assert(Equal "web" (txt-at [(ts "recipe") (ts "renderer")] legacy))
assert(Equal "legacy" (txt-at [(ts "recipe") (ts "pronunciation")] legacy))
assert(Equal "z" (txt-at [(ts "recipe") (ts "care")] legacy))

(define legacy-exact
  (zoo-resolve
    (request legacy-part "full" "component" "web" "legacy" [])
    [(zoo-with-part legacy-part legacy)]))
assert(Equal "/boot/zoo/resolution/exact" (Hd legacy-exact))
assert(Equal legacy-part (zoo-resolution-part legacy-exact))

(print "foundry resolver tests passed")
