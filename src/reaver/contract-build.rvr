(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module contract-source))
(#bind evm (#module contract-evm))
(#bind rp (#module restricted-plan))
(#bind json (#module wire-json))
(define (numbers value)
  (If (IsNat value) (showNat value) (json:jarr (map numbers value))))
;; reference results contain a cord tag; export just the two result words.
(define (report artifact cases)
  (json:jobj [["arity" (showNat (Arity (rp:base (_1 artifact))))]
    ["instructions" (numbers (evm:compile artifact))]
    ["reference" (json:jarr (map (lambda (args)
      (define result (rp:run artifact args))
      (If (Equal (_0 result) "executed") (numbers [args (_1 result)])
        (error ["invalid reference input" result]))) cases))]]))
