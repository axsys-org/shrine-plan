;; Surface Foil -> the production TC_* IR, checked by foil-new-types.
;;
;; The old FoilType algebra appears only in `legacy-scheme`, the compatibility
;; seam used when a source program refers to a production builtin.  Every type
;; produced, stored in a new declaration, compared, or attached to TC below is
;; a stage-1 newtype value.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind newtype (#module newtype))
(#import newtype)

(#bind foil-surface (#module foil-surface))
(#import foil-surface)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil-env (#module foil-env))
(#bind nt (#module foil-new-types))
(#bind legacy (#module foil-types))
(#bind quip (#module quip))
(#bind cairn (#module cairn))
;; NOTE on profiling: do NOT wrap the lazily-threaded pass state in
;; profile zones.  Zone effects make thunks unshareable, so downstream
;; forces replay the whole fold chain (measured: ~1000x re-entry).
;; Zones belong only around fully-forced values, the way foil-lower's
;; profiled? variants use force-zone.


;;; Compiler and environment declarations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define FOIL_NEW_ELAB_ROOT "/foil/new-elab/")

(declare-cstr NewCompiler FOIL_NEW_ELAB_ROOT
  [subject tany]
  [world tany]
  [resolutions (tarr tany)])

(declare-cstr LocalBinding FOIL_NEW_ELAB_ROOT
  [name (tnat 0)]
  [type tany])

(declare-cstr ElabEnv FOIL_NEW_ELAB_ROOT
  [locals (tarr tany)]
  [type-vars (tarr (tnat 0))]
  [const-vars (tarr tany)]
  [goal tany]
  [span tany]
  [name (tarr (tnat 0))])

(define make-compiler $NewCompiler)
(define compiler-subject NewCompiler.subject)
(define compiler-world NewCompiler.world)
(define compiler-with-subject NewCompiler.=subject)
(define compiler-with-world NewCompiler.=world)
(define compiler-resolutions NewCompiler.resolutions)
(define compiler-with-resolutions NewCompiler.=resolutions)

(define local-name LocalBinding.name)
(define local-type LocalBinding.type)

(define env-locals ElabEnv.locals)
(define env-type-vars ElabEnv.type-vars)
(define env-const-vars ElabEnv.const-vars)
(define env-goal ElabEnv.goal)
(define env-span ElabEnv.span)
(define env-name ElabEnv.name)
(define env-with-locals ElabEnv.=locals)
(define env-with-type-vars ElabEnv.=type-vars)
(define env-with-const-vars ElabEnv.=const-vars)
(define env-with-goal ElabEnv.=goal)
(define env-with-span ElabEnv.=span)
(define env-with-name ElabEnv.=name)

(define empty-env ($ElabEnv [] [] [] 0 0 []))

(define (clear-goal env) (env-with-goal 0 env))
(define (push-locals bindings env)
  (env-with-locals (Weld bindings (env-locals env)) env))
(define (push-local name typ env)
  (push-locals [($LocalBinding name typ)] env))

(define (span-blurb span)
  (Ifz span "unknown-location"
    ["line" (Ix 0 span) "col" (Ix 1 span)]))

(define (new-elab-error env what detail)
  (error ["foil-new-elab" what ["at" (span-blurb (env-span env))] detail]))

;; Guard: raise a located diagnostic unless ok.  Laziness makes the
;; error side free on the success path; the value is the historical
;; sentinel 1 so a guard can stand anywhere an expression can.
(define (need env ok what detail)
  (unless ok (new-elab-error env what detail) 1))

;; (flow st ((name expr) ...) body...) — the [state value] threading
;; convention as a binding form.  Each expr sees the freshest state
;; under the SAME name; its result pair splits into the bound name and
;; a rebound state, so the body never touches (_0 r)/(_1 r) plumbing.
(define-syntax (flow form)
  (foldr
    (lambda (binding acc)
      ["#let" [[(_1 form) (_1 binding)]]
       ["#let" [[(_0 binding) [(1 _1) (_1 form)]]
                [(_1 form) [(1 _0) (_1 form)]]]
        acc]])
    (unblock (drop 3 form))
    (_2 form)))

;; Lift a kernel [world value] pair into the compiler convention, so
;; kernel calls participate in a compiler-stated flow.
(define (lift-world compiler wr)
  [(compiler-with-world (_0 wr) compiler) (_1 wr)])

;; A declaration which failed to elaborate is poisoned with a TC_MEAN entry
;; (see run-decl-pass below).  References must fail with a readable cascade
;; diagnostic instead of consuming the poison as a type.
(define (failed-declaration? compiler path)
  (And (get-const path (compiler-subject compiler))
    (Eq "TC_MEAN" (Hd (got-entry-tc path (compiler-subject compiler))))))

(define prototype-mark "FOIL_NEW_UNTYPED_PROTOTYPE")
(define (prototype-tc) (tc-const nt:tany prototype-mark))
(define (prototype-tc? tc)
  (And (Eq "TC_CONST" (Hd tc))
    (Eq prototype-mark (tc-const-val tc))))


;;; New builtin type world ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define nat-ref (nt:type-ref ["nat"]))

;; The fourteen kernel auras (doc/aura-spec.md).  aura-tag? gates the
;; nat/<aura> surface spelling; iota-body is the tagged-pair sum the
;; goal-directed literal rules recognize.
(define aura-tags
  ["dm" "dr" "ds" "f" "r" "rd" "rs" "s" "ta" "ts" "tu" "u" "w" "x"])
(define (aura-tag? a)
  (includes (Eq a) aura-tags))
(define iota-body
  (nt:tsum
    (map (lambda (tag)
      (nt:trow tag [(nt:trow-item 0 nat-ref)]))
      aura-tags)))

(define (install-core-world world)
  ;; Every core entry has runtime arity 0 and the "builtin" source; each
  ;; `builtin` call yields one pipe stage awaiting the world.
  (define (builtin path scm brand)
    (lambda (w) (nt:declare-type w path scm brand 0 "builtin")))
  (pipe world
    (builtin ["nat"] (nt:mono (nt:tnat 0)) "nat")
    (builtin ["uint"] (nt:mono (nt:tnat 0)) "uint")
    (builtin ["bool"] (nt:mono (nt:tnat 0)) "bool")
    (builtin ["unit"]
      (nt:mono (nt:trow (print-path ["unit"]) []))
      (print-path ["unit"]))
    (builtin ["pail"] (nt:mono nt:tpail) 0)
    (builtin ["any"] (nt:mono nt:tany) 0)
    (builtin ["row"]
      (nt:scheme [(nt:type-param "a")]
        (nt:tarr (nt:type-var "a")))
      0)
    (builtin ["list"]
      (nt:scheme [(nt:type-param "a")]
        (nt:tsum
          [(nt:trow "nil" [])
           (nt:trow "cons"
             [(nt:trow-item 0 (nt:type-var "a"))
              (nt:trow-item 1
                (nt:type-app ["list"]
                  [(nt:type-arg (nt:type-var "a"))]))])]))
      0)
    (builtin ["either"]
      (nt:scheme [(nt:type-param "a") (nt:type-param "b")]
        (nt:tsum
          [(nt:trow "left"
             [(nt:trow-item 0 (nt:type-var "a"))])
           (nt:trow "right"
             [(nt:trow-item 0 (nt:type-var "b"))])]))
      0)
    (builtin ["iota"] (nt:mono iota-body) 0)
    ;; Aura'd nat aliases: a sym/str value is a bare nat whose aura
    ;; rides the type and widens away to plain nat.
    (builtin ["sym"] (nt:mono (nt:tnat "ts")) 0)
    (builtin ["str"] (nt:mono (nt:tnat "tu")) 0)
    ;; The reflection descriptor sum: (^ expr) values.  Closed and
    ;; non-generic; recursion is by nominal self-reference (a type-app
    ;; here would be a template node, which wf rejects in resolved
    ;; types).  Member shapes must stay in sync with the legacy mirror
    ;; in foil-core-types.rvr (type-typ) and with reflect-encode below.
    (builtin ["type"]
      (let ((self (nt:type-ref ["type"])))
        (nt:mono
          (nt:tsum
            [(nt:trow "any" [])
             (nt:trow "pail" [])
             (nt:trow "bot" [])
             ;; An opaque constant: a non-nat const value (a baked
             ;; comparator, say) that reflection cannot decompose.
             (nt:trow "opq" [])
             (nt:trow "nat" [(nt:trow-item "aura" nat-ref)])
             (nt:trow "cst" [(nt:trow-item "val" nat-ref)])
             (nt:trow "var" [(nt:trow-item "name" nat-ref)])
             (nt:trow "arr" [(nt:trow-item "item" self)])
             (nt:trow "pin" [(nt:trow-item "item" self)])
             (nt:trow "fun"
               [(nt:trow-item "args" (nt:tarr self))
                (nt:trow-item "ret" self)])
             (nt:trow "sum" [(nt:trow-item "opts" (nt:tarr self))])
             (nt:trow "rec"
               [(nt:trow-item "cstr" nat-ref)
                (nt:trow-item "items"
                  (nt:tarr
                    (nt:trow 0
                      [(nt:trow-item "face" nat-ref)
                       (nt:trow-item "item" self)])))])
             (nt:trow "nom"
               [(nt:trow-item "path" (nt:tarr nat-ref))
                (nt:trow-item "args" (nt:tarr self))])
             (nt:trow "gen"
               [(nt:trow-item "params"
                  (nt:tarr
                    (nt:trow 0
                      [(nt:trow-item "cnst" nat-ref)
                       (nt:trow-item "name" nat-ref)
                       (nt:trow-item "cty" self)])))
                (nt:trow-item "body" self)])])))
      0)))

(define default-type-world (install-core-world nt:empty-type-world))

;; The structural view of the current goal: unfold nominal/application
;; layers (bounded, like meth-function's resolve) so alias goals
;; (id = iota, sym = nat/ts) direct literals exactly like their
;; spelled-out forms.  Returns [compiler viewed], viewed = 0 when no
;; goal is set.
(define (view-deep compiler t0)
  (define (go c t depth)
    (If (And (Lt depth 8)
          (Or (nt:type-ref? t) (nt:type-app? t)))
      (let ((vr (nt:view (compiler-world c) t)))
        (If (Equal (_1 vr) t)
          [c t]
          (go (compiler-with-world (_0 vr) c) (_1 vr) (Inc depth))))
      [c t]))
  (go compiler t0 0))

(define (goal-view compiler env)
  (Ifz (env-goal env) [compiler 0] (view-deep compiler (env-goal env))))

;; reflect-encode :: Env -> Monotype|Scheme -> descriptor value
;;
;; The (^ expr) encoder: one descriptor case per new-ty-text branch
;; (foil-render.rvr), so the Foil-side printer can reproduce the rvr
;; renderer byte for byte.  Nominal depth: refs and applications stay
;; paths + argument descriptors — nothing unfolds.  Non-nat constants
;; (baked comparator values) are opaque: "opq".
(define (reflect-encode env typ)
  (define (enc-const v) (If (IsNat v) ("cst" v) "opq"))
  ;; One reference path -> descriptor.  /ty-ap-encoded applications
  ;; decode to a nom with argument descriptors; @var and '$val parts
  ;; ride as var/cst; unit-qualified keys carry an unprintable pin, so
  ;; they reflect as a "~"-headed local path ("~" is not a source word).
  (define (enc-ref p)
    (define parts (ty-ap-decode p))
    (Ifz parts
      (cond
        ((ty-var-path? p) ("var" (Ix 1 p)))
        ((ty-val-path? p) (enc-const (Ix 1 p)))
        ((unit-qualified-path? p)
          ("nom" (Weld ["~"] (unit-qualified-path-local p)) []))
        (else ("nom" p [])))
      (let ((base (enc-ref (Ix 0 parts))))
        (If (And (IsApp base) (Eq "nom" (Hd base)))
          ("nom" (Ix 0 base) (map enc-ref (drop 1 parts)))
          (new-elab-error env "unreflectable type application base" p)))))
  (define (enc t)
    (cond
      ((nt:scheme? t)
        ("gen"
         (map
           (lambda (param)
             (If (Eq "type" (nt:parameter-kind param))
               [0 (nt:parameter-name param) "bot"]
               [1 (nt:parameter-name param)
                  (enc (nt:const-param-type param))]))
           (nt:scheme-parameters t))
         (enc (nt:scheme-body t))))
      ((nt:type-ref? t) (enc-ref (nt:type-ref-path t)))
      ((nt:any-type? t) "any")
      ((nt:pail-type? t) "pail")
      ((nt:bottom-type? t) "bot")
      ((nt:pin-type? t) ("pin" (enc (nt:pin-item t))))
      ((nt:nat-type? t) ("nat" (nt:nat-aura t)))
      ((nt:const-type? t) (enc-const (nt:const-value t)))
      ((nt:fun-type? t)
        ("fun" (map enc (nt:fun-args t)) (enc (nt:fun-return t))))
      ((nt:row-type? t)
        ("rec" (nt:row-cstr t)
          (map
            (lambda (item)
              [(nt:row-item-face item) (enc (nt:row-item-value item))])
            (nt:row-items t))))
      ((nt:sum-type? t) ("sum" (map enc (nt:sum-options t))))
      ((nt:array-type? t) ("arr" (enc (nt:array-item t))))
      ((nt:type-var? t) ("var" (nt:ty-var-name t)))
      ((nt:const-var? t) ("var" (nt:const-var-name t)))
      ((nt:type-app? t)
        ("nom" (nt:ty-app-base t)
          (map
            (lambda (garg)
              (If (Eq "type" (nt:argument-kind garg))
                (enc (nt:argument-value garg))
                (enc-const (nt:argument-value garg))))
            (nt:ty-app-arguments t))))
      ;; A bare row-item (or anything else) is never a value's resolved
      ;; type — refuse loudly rather than encode junk.
      (else (new-elab-error env "unreflectable type" t))))
  (enc typ))


;;; Deriving the TypeWorld from a subject ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The subject is the single source of truth across units and snapshots:
;; every type declaration lives in it as a TC_TYP entry at its canonical
;; path, and a unit compile derives its TypeWorld by replaying those entries
;; over the builtin core.  Materialized /ty-ap overlays are a cache and are
;; deliberately not persisted; they re-materialize lazily on lookup.
(define (subject-entry-tc ent0)
  (define ent (If (IsPin ent0) (Unpin ent0) ent0))
  (cond
    ((Nil (IsApp ent)) 0)
    ((Eq "TC" (Hd ent)) (_1 ent))
    ((Eq "IR_ENTRY" (Hd ent)) (_3 ent))
    (else 0)))

(define (subject-type-declaration world pair)
  (define tc (subject-entry-tc (_1 pair)))
  (Ifz (And tc (Eq "TC_TYP" (Hd tc)))
    world
    (let* ((path (_0 pair))
           (inner (tc-typ-inner tc))
           (scm
             (cond
               ((nt:scheme? inner) inner)
               ((nt:monotype? inner) (nt:mono inner))
               ;; A TC_TYP whose type is not a stage-1 value is a legacy
               ;; declaration; the legacy pipeline owns it.
               (else 0))))
      (cond
        ((Nil scm) world)
        ((nt:type-bound? world path) world)
        (else
          (let* ((mono (nt:scheme-body scm))
                 (brand (If (nt:row-type? mono) (nt:row-cstr mono) 0))
                 (arity (If (nt:row-type? mono) (Sz (nt:row-items mono)) 0)))
            (nt:declare-type world path scm brand arity 0)))))))

(define (world-from-subject subject)
  ;; Slot 0 of a subject is its entry ax (the same access get-const uses).
  (foldl subject-type-declaration default-type-world
    (rowify (cairn:tapax (Ix 0 subject)))))

(define (compiler-for subject)
  ($NewCompiler subject (world-from-subject subject) []))


;;; Legacy builtin signature adapter ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A legacy nominal reference may be a /ty-ap selector whose parts include
;; template (/ty-var) segments — builtin signatures encode `List a` that
;; way.  Those become symbolic stage-1 applications; ground selectors and
;; plain paths stay nominal references.
(define (legacy-nominal-reference path)
  (If (Nil (ty-ap-path? path))
    (nt:type-ref path)
    (let ((parts (ty-ap-decode path)))
      (If (Nil (any ty-var-path? parts))
        (nt:type-ref path)
        (nt:type-app (_0 parts)
          (map
            (lambda (part)
              (cond
                ((ty-var-path? part)
                  (nt:type-arg (nt:type-var (Ix 1 part))))
                ((ty-val-path? part) (nt:const-arg (Ix 1 part)))
                (else (nt:type-arg (legacy-nominal-reference part)))))
            (drop 1 parts)))))))

(define (legacy-monotype compiler typ)
  (define tag (legacy:type-tag typ))
  (define (recur c t) (legacy-monotype c t))
  (define (many c xs) (nt:thread-map recur c xs))
  (cond
    ((Eq tag "TBOT") [compiler nt:tbot])
    ((Eq tag "TANY") [compiler nt:tany])
    ((Eq tag "TPAIL") [compiler nt:tpail])
    ((Eq tag "TNAT")
      [compiler
       (Ifz (legacy:tnat-cube typ)
         (nt:tnat 0)
         (nt:tconst (legacy:tnat-cube typ)))])
    ((Eq tag "TNOM")
      [compiler (legacy-nominal-reference (legacy:tnom-ref typ))])
    ((Eq tag "TVAR") [compiler (nt:type-var (legacy:tvar-index typ))])
    ((Eq tag "TFAC") (recur compiler (legacy:tfac-val typ)))
    ((Eq tag "TSELF") (recur compiler (legacy:tself-val typ)))
    ((Eq tag "TPIN")
      (let ((r (recur compiler (legacy:tpin-val typ))))
        [(_0 r) (nt:tpin (_1 r))]))
    ((Eq tag "TARR")
      (let ((r (recur compiler (legacy:tarr-item typ))))
        [(_0 r) (nt:tarr (_1 r))]))
    ((Eq tag "TFUN")
      (let* ((ar (many compiler (legacy:tfun-args typ)))
             (rr (recur (_0 ar) (legacy:tfun-ret typ))))
        [(_0 rr) (nt:tfun (_1 ar) (_1 rr))]))
    ((Eq tag "TROW")
      (let ((r
              (nt:thread-map
                (lambda (c pair)
                  (define i (_0 pair))
                  (define item (_1 pair))
                  (define faced (Eq "TFAC" (legacy:type-tag item)))
                  (define face (If faced (legacy:tfac-face item) i))
                  (define raw (If faced (legacy:tfac-val item) item))
                  (let ((ir (recur c raw)))
                    [(_0 ir) (nt:trow-item face (_1 ir))]))
                compiler
                (zip (gen (Sz (legacy:trow-vals typ)) (lambda (i) i))
                  (legacy:trow-vals typ)))))
        [(_0 r) (nt:trow (legacy:trow-cstr typ) (_1 r))]))
    ((Eq tag "TSUM")
      (let ((r (many compiler (legacy:tsum-opts typ))))
        [(_0 r) (nt:tsum (_1 r))]))
    ((Eq tag "TTYP") (recur compiler (legacy:ttyp-type typ)))
    (else
      (error ["foil-new-elab" "unsupported legacy builtin type" typ]))))

(define (legacy-scheme compiler typ)
  (define (go c params t)
    (define tag (legacy:type-tag t))
    (cond
      ((Eq tag "TQUA")
        (go c (snoc (nt:type-param (legacy:tqua-name t)) params)
          (legacy:tqua-body-value t)))
      ((Eq tag "TCQUA")
        (let ((tr (legacy-monotype c (legacy:tcqua-type t))))
          (go (_0 tr)
            (snoc (nt:const-param (legacy:tcqua-name t) (_1 tr)) params)
            (legacy:tcqua-body t))))
      (else
        (let ((r (legacy-monotype c t)))
          [(_0 r) (nt:scheme params (_1 r))]))))
  (go compiler [] typ))

(define (normalize-tc compiler tc)
  (define typ (tc-ty tc))
  (If (nt:type-value? typ)
    [compiler tc]
    (let ((r (legacy-scheme compiler typ)))
      [(_0 r)
       (set-tc-ty
         (Ifz (Sz (nt:scheme-parameters (_1 r)))
           (nt:scheme-body (_1 r))
           (_1 r))
         tc)])))


;;; Surface type elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (bound-type-var? env name)
  (includes (Eq name) (env-type-vars env)))

(define (const-binding env name)
  (define hit
    (find (lambda (pair) (Eq name (_0 pair))) (env-const-vars env)))
  (And hit (_0 hit)))

(define (type-path compiler path)
  (canon-path path (compiler-subject compiler)))

(define (surf-strip-spans surf)
  (If (Eq "s_span" (_0 surf)) (surf-strip-spans (_2 surf)) surf))

;; Expand every current-namespace reference (%/x, s_cref) into an
;; ordinary s_ref of anchor+suffix.  The anchor is the enclosing
;; declaration's source path, determined structurally BEFORE any
;; declaration elaborates: %/ performs no parent search and no
;; rooted-first fallback of its own — it forms one exact written path,
;; which then resolves through the ordinary environment machinery
;; (canon-path: visibility, mounts, aliases).
(define (cref-expand anchor x)
  (Ifz (IsApp x)
    x
    (If (And (Sz x) (Eq "s_cref" (_0 x)))
      ["s_ref" (Weld anchor (_1 x))]
      (gen (Sz x) (lambda (i) (cref-expand anchor (Ix i x)))))))

;; A declaration row with its body's %/ references expanded at the
;; declaration's own namespace position.
(define (expand-decl-crefs row)
  (If (And (IsApp row) (Eq "s_decl" (_0 row)))
    (Up 3 (cref-expand (_1 row) (_3 row)) row)
    row))

;; The sealed environment riding the subject (an Environment during
;; module elaboration, a Unit envelope on completed subjects), or 0 for
;; bare/legacy subjects.
(define (subject-environment subject)
  (define unit (sut-unit subject))
  (cond
    ((foil-env:environment? unit) unit)
    ((foil-env:unit? unit) (foil-env:unit-environment unit))
    (else 0)))

;; Record a resolved source edge for a written spelling.  Recording is
;; observation only: the environment supplies provenance while canon-path
;; stays the resolution authority, and a spelling the environment cannot
;; see (locals, compiler-internal keys) records nothing.
(define (record-resolution compiler env written)
  (define environment
    (subject-environment (compiler-subject compiler)))
  (Ifz environment
    compiler
    (let ((res (foil-env:resolve written environment)))
      (If (foil-env:res-known? res)
        (compiler-with-resolutions
          (snoc
            (foil-env:make-resolution (env-span env) written
              (foil-env:res-from res) (foil-env:res-tag res))
            (compiler-resolutions compiler))
          compiler)
        compiler))))

;; Method dispatch selects a canonical (occasionally unit-qualified)
;; member after receiver typing.  Provenance belongs to a source-visible
;; spelling, so invert the subject's visibility projection — preferring
;; an alias whose own or parent path was already recorded (the alias the
;; receiver's type resolved through), otherwise the first written alias.
(define (record-member-resolution compiler env member vis-pairs)
  (define subject (compiler-subject compiler))
  (Ifz (Sz vis-pairs)
    compiler
    (let* ((root (sut-root subject))
           (sources
             (map
               (lambda (pair)
                 (let ((written (_0 pair)))
                   (If (foil-env:path-prefix? root written)
                     (drop (Sz root) written)
                     written)))
               (filter (lambda (pair) (Equal member (_1 pair)))
                 vis-pairs)))
           (prior (compiler-resolutions compiler))
           (preferred
             (find
               (lambda (source)
                 (let ((parent (Ifz (Sz source) [] (Init source))))
                   (Truth
                     (find
                       (lambda (resolution)
                         (Or
                           (Equal source
                             (foil-env:resolution-path resolution))
                           (Equal parent
                             (foil-env:resolution-path resolution))))
                       prior))))
               sources))
           (source
             (Ifz preferred (Ifz (Sz sources) 0 [(_0 sources)]) preferred)))
      (Ifz source
        compiler
        (record-resolution compiler env (_0 source))))))

(define (const-surface-argument compiler env arg)
  (define tag (_0 arg))
  (cond
    ((Eq tag "s_tsym") (nt:const-arg (_1 arg)))
    ;; Literal const arguments ride /ty-ap paths as /ty-val segments,
    ;; which only admit naturals.  Reject anything else here, where the
    ;; span is still available, rather than deep inside encoding.
    ((Eq tag "s_lit")
      (If (IsNat (_1 arg))
        (nt:const-arg (_1 arg))
        (new-elab-error env "const argument must be a natural number" arg)))
    ((And (Or (Eq tag "s_ref") (Eq tag "s_var"))
       (let ((name
               (If (Eq tag "s_var") (_1 arg)
                 (If (Eq 1 (Sz (surf-ref-path arg)))
                   (_0 (surf-ref-path arg)) 0))))
         (And name (const-binding env name))))
      (let ((name
              (If (Eq tag "s_var") (_1 arg)
                (_0 (surf-ref-path arg)))))
        (nt:const-arg (nt:const-var name))))
    ((And (Eq tag "s_ref")
       (And (Eq 1 (Sz (surf-ref-path arg)))
         (str-numeric? (_0 (surf-ref-path arg)))))
      (nt:const-arg (parse-nat (_0 (surf-ref-path arg)))))
    ;; A reference to a global value (map[k lt]'s comparator): the const
    ;; argument is the canonical path, riding /ty-ap paths as a plain
    ;; part; materialization resolves the referee.
    ((Or (Eq tag "s_ref") (Eq tag "s_var"))
      (let* ((path0
               (If (Eq tag "s_var") [(_1 arg)] (surf-ref-path arg)))
             (path (canon-path path0 (compiler-subject compiler))))
        (If (get-const path (compiler-subject compiler))
          (nt:const-arg path)
          (new-elab-error env "unbound const argument reference" arg))))
    (else
      (new-elab-error env "const argument must be a literal or const parameter"
        arg))))

;; Delegate to the kernel's notion: an argument is template while any
;; part of it mentions variables and so cannot ride a canonical path.
(define template-argument? nt:template-argument?)

;; Encode one specialization argument as a /ty-ap path part.  Inside a
;; generic body a symbolic argument rides as a /ty-var segment (const
;; parameters share the /ty-var namespace in encodings, as in legacy);
;; materialization's subst-tc rewrites them at each ground
;; instantiation.  Ground arguments encode canonically.
(define (specialization-argument-part garg)
  (define value (nt:argument-value garg))
  (cond
    ((nt:type-var? value) [ty-var-tag (nt:ty-var-name value)])
    ((nt:const-var? value) [ty-var-tag (nt:const-var-name value)])
    (else (nt:argument-path garg))))

;; Convert surface generic arguments against declared parameters.  Shared by
;; type elaboration and value specialization; `elab` is elab-type, passed
;; explicitly so this single definition can precede it.
(define (type-application-arguments-using elab compiler env params args)
  (need env (Eq (Sz params) (Sz args))
    "wrong number of type arguments" ["want" (Sz params) "got" (Sz args)])
  (nt:thread-map
    (lambda (c pair)
      (define param (_0 pair))
      (define arg (_1 pair))
      (If (Eq "type" (nt:parameter-kind param))
        (let ((r (elab c env arg 0)))
          [(_0 r) (nt:type-arg (_1 r))])
        [c (const-surface-argument c env arg)]))
    compiler (zip params args)))

;; elab-type :: Compiler -> Env -> TypeSAST -> top-row-brand-or-0
;;           -> [Compiler MonotypeTemplate]
(define (elab-type compiler env surf top-brand)
  (define (type-row-items compiler env kids)
    (nt:thread-map
      (lambda (c pair)
        (define i (_0 pair))
        (define kid (_1 pair))
        (define faced (Eq "s_face" (_0 kid)))
        (define face (If faced (surf-face-name kid) i))
        (define raw (If faced (surf-face-kid kid) kid))
        (let ((r (elab-type c env raw 0)))
          [(_0 r) (nt:trow-item face (_1 r))]))
      compiler
      (zip (gen (Sz kids) (lambda (i) i)) kids)))
  (define tag (_0 surf))
  (define (recur c x) (elab-type c env x 0))
  (define (many c xs) (nt:thread-map recur c xs))
  (cond
    ((Eq tag "s_span")
      (elab-type compiler (env-with-span (_1 surf) env) (_2 surf) top-brand))
    ((Eq tag "s_face") (recur compiler (surf-face-kid surf)))
    ((Or (Eq tag "s_trow") (Eq tag "s_row"))
      (let ((r (type-row-items compiler env (surf-row-kids surf))))
        [(_0 r) (nt:trow top-brand (_1 r))]))
    ((Eq tag "s_tfun")
      (let* ((ar (many compiler (surf-fun-args surf)))
             (rr (recur (_0 ar) (surf-fun-ret surf))))
        [(_0 rr) (nt:tfun (_1 ar) (_1 rr))]))
    ((Eq tag "s_union")
      (let ((r (many compiler (surf-union-opts surf))))
        [(_0 r) (nt:tsum (_1 r))]))
    ((Eq tag "s_tsym") [compiler (nt:tconst (_1 surf))])
    ((Eq tag "s_variant") [compiler (nt:trow (_1 surf) [])])
    ((Eq tag "s_ref")
      (let* ((path (surf-ref-path surf))
             (name (If (Eq 1 (Sz path)) (_0 path) 0))
             (cb (And name (const-binding env name))))
        (cond
          ((And name (bound-type-var? env name))
            [compiler (nt:type-var name)])
          (cb [compiler (nt:const-var name)])
          ((And name (str-numeric? name))
            [compiler (nt:tconst (parse-nat name))])
          ;; nat/<aura> — the aura-refined nat spelling (the renderer's
          ;; own output).  Type-level only: the value is a bare nat.
          ((And (Eq 2 (Sz path))
             (And (Eq "nat" (_0 path)) (aura-tag? (_1 path))))
            [compiler (nt:tnat (_1 path))])
          (else
            (let ((rooted (type-path compiler path)))
              (If (failed-declaration? compiler rooted)
                (new-elab-error env
                  "reference to a declaration that failed to elaborate" rooted)
                [(record-resolution compiler env path)
                 (nt:type-ref rooted)]))))))
    ;; Alias declaration bodies parse in value position: a bare word is
    ;; s_var and a specialization is s_spec.  Normalize both onto the
    ;; type spellings.
    ((Eq tag "s_var")
      (elab-type compiler env ["s_ref" [(_1 surf)]] top-brand))
    ((Eq tag "s_spec")
      (let ((head0 (surf-strip-spans (_1 surf))))
        (elab-type compiler env
          ["s_tapp"
           (Weld
             [(If (Eq "s_var" (_0 head0))
                ["s_ref" [(_1 head0)]]
                (_1 surf))]
             (_2 surf))]
          top-brand)))
    ((Eq tag "s_tapp")
      (let* ((kids (surf-tapp-kids surf))
             (head (_0 kids))
             (args (drop 1 kids)))
        (cond
          ;; ('$foo) — a parenthesized constant symbol (the face position
          ;; x=('$foo); rex can't take a bare quip as a rune operand).
          ((And (Eq "s_tsym" (_0 head)) (Ifz (Sz args) 1 0))
            [compiler (nt:tconst (_1 head))])
          ((Eq "s_variant" (_0 head))
            (let ((r (many compiler args)))
              [(_0 r)
               (nt:trow (_1 head)
                 (map (lambda (pair)
                   (nt:trow-item (_0 pair) (_1 pair)))
                   (zip (gen (Sz (_1 r)) (lambda (i) i)) (_1 r))))]))
          ;; pin[a] is type-grammar syntax, not a namespace entry — the
          ;; bare name stays the FFI value.
          ((And (Eq "s_ref" (_0 head))
             (Equal ["pin"] (surf-ref-path head)))
            (need env (Eq 1 (Sz args))
              "pin takes exactly one type argument" surf)
            (let ((r (recur compiler (_0 args))))
              [(_0 r) (nt:tpin (_1 r))]))
          ((Eq "s_ref" (_0 head))
            (let* ((base (type-path compiler (surf-ref-path head)))
                   (checked
                     (If (failed-declaration? compiler base)
                       (new-elab-error env
                         "reference to a declaration that failed to elaborate"
                         base)
                       base)))
            (flow compiler
              ((entry
                 (lift-world compiler
                   (nt:lookup-type-entry
                     (compiler-world compiler) checked)))
               (gargs
                 (type-application-arguments-using elab-type
                   (record-resolution compiler env (surf-ref-path head))
                   env
                   (nt:scheme-parameters (nt:type-entry-scheme entry))
                   args)))
              ;; Intern only nominally-ground applications.  Template
              ;; args ground later; structural ground args (function
              ;; types) have no path form and stay symbolic permanently.
              (If (all nt:path-ridable-argument? gargs)
                (flow compiler
                  ((path
                     (lift-world compiler
                       (nt:intern-type-application
                         (compiler-world compiler) base gargs))))
                  [compiler (nt:type-ref path)])
                [compiler (nt:type-app base gargs)]))))
          (else (new-elab-error env "type application needs a named head" surf)))))
    ((Eq tag "s_hole")
      (new-elab-error env "wildcard is not a type" surf))
    (else (new-elab-error env "unsupported type syntax" surf))))

(define (type-application-arguments compiler env params args)
  (type-application-arguments-using elab-type compiler env params args))

;; Elaborate [[name type-sast] ...] const-parameter entries, extending an
;; initial parameter row.  Returns [compiler [[name type] ...] params].
(define (elab-const-entries compiler env params entries)
  (foldl
    (lambda (state ent)
      (let ((r (elab-type (_0 state) env (_1 ent) 0)))
        [(_0 r)
         (snoc [(_0 ent) (_1 r)] (_1 state))
         (snoc (nt:const-param (_0 ent) (_1 r)) (_2 state))]))
    [compiler [] params] entries))

(define (type-mentions-name? name typ)
  (nt:type-any?
    (lambda (node)
      (Or (And (nt:type-var? node) (Eq name (nt:ty-var-name node)))
        (And (nt:const-var? node) (Eq name (nt:const-var-name node)))))
    typ))

;; Prepend scheme parameters onto a TC's type, merging with any
;; quantification the inner elaboration already produced.  Legacy parity
;; (elab-tvars/elab-cvars): a declared variable the elaborated type never
;; mentions is dropped — uniform for @ and @@, so namespace-scoped vars
;; cost nothing on members that don't use them.  A const parameter also
;; survives when the value body references it (TC_CPARAM): its type may
;; be var-free (add_n's {nat; nat}).
(define (tc-with-parameters params tc)
  (define typ (tc-ty tc))
  (define body (If (nt:scheme? typ) (nt:scheme-body typ) typ))
  (define old (If (nt:scheme? typ) (nt:scheme-parameters typ) []))
  (define kept
    (filter
      (lambda (param)
        (let ((name (nt:parameter-name param)))
          (Or (type-mentions-name? name body)
            (And (Eq "const" (nt:parameter-kind param))
              (tc-uses-cparam? name tc)))))
      params))
  (If (And (Ifz (Sz kept) 1 0) (Ifz (Sz old) 1 0))
    tc
    (set-tc-ty (nt:scheme (Weld kept old) body) tc)))

;; A value or type declaration's explicit @/@@ prefix becomes a Scheme.
(define (elab-scheme compiler env surf top-brand)
  (define (go c e params node)
    (define tag (_0 node))
    (cond
      ((Eq tag "s_span")
        (go c (env-with-span (_1 node) e) params (_2 node)))
      ((Eq tag "s_tvars")
        (let* ((vars (_1 node))
               (e1 (env-with-type-vars (Weld vars (env-type-vars e)) e))
               (ps (Weld params (map nt:type-param vars))))
          (go c e1 ps (_2 node))))
      ((Eq tag "s_cvars")
        (let ((cr (elab-const-entries c e params (_1 node))))
          (go (_0 cr)
            (env-with-const-vars (Weld (_1 cr) (env-const-vars e)) e)
            (_2 cr) (_2 node))))
      (else
        ;; Drop-if-unused, uniform with tc-with-parameters: a member
        ;; type declaration under @@ keeps exactly the scoped vars its
        ;; elaborated body mentions (mop/kv[k v] under (@@ k v lt)).
        (let* ((r (elab-type c e node top-brand))
               (body (_1 r))
               (kept
                 (filter
                   (lambda (p)
                     (type-mentions-name? (nt:parameter-name p) body))
                   params)))
          [(_0 r) (nt:scheme kept body)]))))
  (go compiler env [] surf))


;;; Value lookup and checking ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (find-local env name)
  (define hit
    (find-idx (lambda (binding) (Eq name (local-name binding)))
      (env-locals env)))
  (And hit [(_0 hit) (Ix (_0 hit) (env-locals env))]))

;; The already-canonical entry point: unit-qualified member keys (a
;; mounted type's methods) must not pass through canon-path again, which
;; would bounce them off the visibility index.
(define (global-reference-canonical compiler env path)
  (define world (compiler-world compiler))
  (cond
    ((nt:type-bound? world path)
      (let* ((lr (nt:lookup-type-entry world path))
             (entry (_1 lr))
             (scm (nt:type-entry-scheme entry))
             (inner
               (Ifz (Sz (nt:scheme-parameters scm))
                 (nt:type-ref path)
                 scm)))
        [(compiler-with-world (_0 lr) compiler) (tc-typ inner)]))
    ((failed-declaration? compiler path)
      (new-elab-error env
        "reference to a declaration that failed to elaborate" path))
    ((get-const path (compiler-subject compiler))
      (let* ((raw (got-entry-tc path (compiler-subject compiler)))
             (nr (normalize-tc compiler raw))
             (tc (_1 nr)))
        (If (prototype-tc? tc)
          (new-elab-error env
            "forward reference requires an explicit type annotation" path)
          [(_0 nr)
           (If (Or (Eq "TC_FFI" (Hd tc)) (Eq "TC_LIT" (Hd tc)))
             tc
             (tc-global (tc-ty tc) path))])))
    (else (new-elab-error env "unbound reference" path))))

(define (global-reference compiler env path0)
  (flow compiler
    ((tc (global-reference-canonical compiler env
           (canon-path path0 (compiler-subject compiler)))))
    [(record-resolution compiler env path0) tc]))

(define (view-type compiler env typ what)
  (need env (Nil (nt:scheme? typ))
    what "generic value requires explicit specialization")
  (let ((r (nt:view (compiler-world compiler) typ)))
    [(compiler-with-world (_0 r) compiler) (_1 r)]))

;; Elaboration check boundaries use consistent subtyping: Any (the Pail
;; escape hatch and unchecked FFI values) is compatible at any depth,
;; while every other rule keeps its static strictness.  The runtime
;; boundary remains responsible for values that abuse the permission.
(define (ensure-subtype compiler env actual expected what)
  (need env (And (Nil (nt:scheme? actual)) (Nil (nt:scheme? expected)))
    what ["actual" actual "expected" expected])
  (let ((r (nt:consistent-subtype (compiler-world compiler) actual expected)))
    (need env (_1 r) what ["want" expected "got" actual])
    (compiler-with-world (_0 r) compiler)))

(define (fold-tc-app f xs result-type)
  (define app
    (foldl (lambda (acc x) (tc-app result-type acc x)) f xs))
  (set-tc-ty result-type app))

(define (peek-return-type compiler env body)
  (define tag (_0 body))
  (cond
    ((Eq tag "s_span")
      (peek-return-type compiler (env-with-span (_1 body) env) (_2 body)))
    ((Eq tag "s_cast") (elab-type compiler env (surf-cast-ty body) 0))
    (else [compiler 0])))

(define (function-goal compiler env arity)
  (Ifz (env-goal env)
    [compiler 0]
    (let ((vr (view-type compiler env (env-goal env)
                "lambda goal is not a function")))
      (need env (And (nt:fun-type? (_1 vr)) (Eq arity (Sz (nt:fun-args (_1 vr)))))
        "lambda goal has the wrong arity" (env-goal env))
      vr)))

(define (lambda-parameters compiler env args goal-fun)
  (foldl
    (lambda (state pair)
      (define i (_0 pair))
      (define arg (_1 pair))
      (define tag (_0 arg))
      (define inferred
        (If goal-fun (Ix i (nt:fun-args goal-fun)) 0))
      (cond
        ((Eq tag "s_face")
          (let ((r (elab-type (_0 state) env (surf-face-kid arg) 0)))
            [(_0 r)
             (snoc [($LocalBinding (surf-face-name arg) (_1 r)) (_1 r)]
               (_1 state))]))
        ((And (Eq tag "s_ref") (Eq 1 (Sz (surf-ref-path arg))))
          (need env inferred "lambda parameter needs a type annotation" arg)
          [(_0 state)
           (snoc [($LocalBinding (_0 (surf-ref-path arg)) inferred) inferred]
             (_1 state))])
        ((Eq tag "s_hole")
          (need env inferred
            "lambda wildcard needs an expected function type" arg)
          [(_0 state) (snoc [($LocalBinding 0 inferred) inferred] (_1 state))])
        (else (new-elab-error env "unsupported lambda parameter" arg))))
    [compiler []]
    (zip (gen (Sz args) (lambda (i) i)) args)))

(define (constructor-path compiler surf tc)
  (define (go node)
    (cond
      ((Eq "s_span" (_0 node)) (go (_2 node)))
      ((Eq "s_ref" (_0 node))
        (canon-path (surf-ref-path node) (compiler-subject compiler)))
      ((Eq "s_var" (_0 node))
        (canon-path [(_1 node)] (compiler-subject compiler)))
      ((Eq "s_spec" (_0 node))
        (let ((inner (tc-typ-inner tc)))
          (And (nt:type-ref? inner) (nt:type-ref-path inner))))
      (else 0)))
  (If (And (Eq "TC_TYP" (Hd tc)) (nt:type-ref? (tc-typ-inner tc)))
    (nt:type-ref-path (tc-typ-inner tc))
    (go surf)))

(define (specialization-base-path compiler surf)
  (cond
    ((Eq "s_ref" (_0 surf))
      (canon-path (surf-ref-path surf) (compiler-subject compiler)))
    ((Eq "s_var" (_0 surf))
      (canon-path [(_1 surf)] (compiler-subject compiler)))
    ((Eq "s_span" (_0 surf)) (specialization-base-path compiler (_2 surf)))
    (else 0)))


;;; Union members, dispatch keys, and relative variants ;;;;;;;;;;;;;;;;;;;;;;;

(define (lambda-surf? surf)
  (Eq "s_fun" (_0 (surf-strip-spans surf))))

(define (path-last-segment path)
  (Ix (Dec (Sz path)) path))

;; The member tag of a structural row constructor: its last /-separated
;; segment (a rootless constructor is its own tag).
(define (cstr-tag cstr)
  (define n (Bytes cstr))
  (define (go i last)
    (If (Ge i n)
      (Rsh cstr (Mul 8 last))
      (go (Inc i)
        (If (Eq 47 (Mod (Rsh cstr (Mul 8 i)) 256)) (Inc i) last))))
  (go 0 0))

(define (option-member-tag option)
  (cond
    ((nt:type-ref? option)
      (let ((path (nt:type-ref-path option)))
        (path-last-segment
          (If (ty-ap-path? path) (_0 (ty-ap-decode path)) path))))
    ((nt:type-app? option)
      (path-last-segment (nt:ty-app-base option)))
    ((nt:row-type? option) (cstr-tag (nt:row-cstr option)))
    (else 0)))

;; The options of a union scrutinee or goal: a sum's options, or the type
;; itself when it is (or unfolds to) a single row.
(define (union-options compiler env typ what)
  (define vr (view-type compiler env typ what))
  (define viewed (_1 vr))
  (cond
    ((nt:sum-type? viewed) [(_0 vr) (nt:sum-options viewed)])
    ((nt:row-type? viewed) [(_0 vr) [viewed]])
    (else (new-elab-error env what typ))))

;; Option runtime keys ([brand arity] or 0), threaded through the compiler.
(define (option-keys compiler options)
  (foldl
    (lambda (state option)
      (let ((r (nt:runtime-key (compiler-world (_0 state)) option)))
        [(compiler-with-world (_0 r) (_0 state)) (snoc (_1 r) (_1 state))]))
    [compiler []] options))

;; Encode a runtime key in the ["key" cstr arity kids] shape lower-arm-test
;; dispatches on.  Flat patterns constrain no fields, so every kid is 0.
(define (flat-arm-key key)
  ["key" (_0 key) (_1 key) (gen (_1 key) (lambda (i) 0))])

;; [compiler member-row member-type key] for the expected type's option
;; named by a relative-variant tag.
(define (relvar-member compiler env tag expect what)
  (define or0 (union-options compiler env expect what))
  (define hit
    (find (lambda (o) (Eq tag (option-member-tag o))) (_1 or0)))
  (need env hit
    ["no member named" tag "in the expected type"]
    ["expected" expect "resolving" what])
  (define member (_0 hit))
  (define vr (view-type (_0 or0) env member "member is not a row type"))
  (define row (_1 vr))
  (need env (nt:row-type? row) ["member is not a row type" tag] member)
  (define kr (nt:runtime-key (compiler-world (_0 vr)) row))
  [(compiler-with-world (_0 kr) (_0 vr)) row member (flat-arm-key (_1 kr))])

;; The scrutinee rides the arm frame under a name no source binder can
;; produce, so bare names and s_self keep resolving past it.
(define match-scrutinee-name "#foil-new-elab/scrutinee")

;; A field projection (Ix idx scrutinee) as a TC, for binder lets whose
;; scrutinee sits `distance` slots up the frame.
(define (field-projection-tc scrut-ty field-ty idx distance)
  (fold-tc-app
    (tc-ffi (nt:tfun [scrut-ty] field-ty) (Ix idx))
    [(tc-local scrut-ty distance 0)]
    field-ty))

;; Re-type the innermost local (the match scrutinee elab-case pushed)
;; without moving it, so arm bodies see the narrowed member's faces while
;; slot accounting stays aligned with lower-match's one-let framing.
(define (narrow-scrutinee env narrowed)
  (env-with-locals
    (Weld [($LocalBinding match-scrutinee-name narrowed)]
      (drop 1 (env-locals env)))
    env))

;; Bare-name field resolution: a local whose type views to a row exposes
;; its faces as bare names, resolving to a projection of that local.  The
;; first local (innermost first) carrying the face wins, mirroring the
;; legacy face-spread scoping.
(define (local-face-reference compiler env name)
  (define locals (env-locals env))
  (define (scan compiler i)
    (If (Ge i (Sz locals))
      0
      (let* ((binding (Ix i locals))
             (lty (local-type binding)))
        (If (Or (Nil (IsApp lty)) (nt:scheme? lty))
          (scan compiler (Inc i))
          (let* ((vr (nt:view (compiler-world compiler) lty))
                 (c1 (compiler-with-world (_0 vr) compiler))
                 (viewed (_1 vr)))
            (If (Nil (nt:row-type? viewed))
              (scan c1 (Inc i))
              (let ((hit
                      (find-idx
                        (lambda (item) (Eq name (nt:row-item-face item)))
                        (nt:row-items viewed))))
                (If hit
                  (let ((fty
                          (nt:row-item-value
                            (Ix (_0 hit) (nt:row-items viewed)))))
                    [c1
                     (fold-tc-app
                       (tc-ffi (nt:tfun [lty] fty) (Ix (_0 hit)))
                       [(tc-local lty i (local-name binding))]
                       fty)])
                  (scan c1 (Inc i))))))))))
  (scan compiler 0))

;;; Generated field accessors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (row-set-at idx val rcvr) (Up idx val rcvr))
(define (row-over-at idx f rcvr) (Up idx (f (Ix idx rcvr)) rcvr))

;; For every named face x of a named row type T, generate three UFCS
;; methods as ordinary FFI entries: T/x (get), T/set_x (replace), and
;; T/over_x (apply a function to the field).  A generic row's accessors
;; are quantified with the type's own parameters; receiver-driven method
;; specialization instantiates them at use.  Positional fields (face =
;; index) generate nothing.
(define (gen-accessors path scm subject)
  (define params (nt:scheme-parameters scm))
  (define row (nt:scheme-body scm))
  (define self-ty
    (Ifz (Sz params)
      (nt:type-ref path)
      (nt:type-app path (map nt:parameter-template-argument params))))
  (define (qua typ) (Ifz (Sz params) typ (nt:scheme params typ)))
  ;; Generated members join source visibility only when an explicit
  ;; index exists (union-mount subjects), so an explicit (point/x fst)
  ;; call resolves; bare/legacy subjects keep inferring from storage.
  (define (mark-derived key sut)
    (If (sut-visible sut) (mark-visible key key sut) sut))
  (define (go sut pair)
    (define idx (_0 pair))
    (define item (_1 pair))
    (define face (nt:row-item-face item))
    (define fty (nt:row-item-value item))
    (define get-key (Weld path [face]))
    (define set-key (Weld path [(strWeld "set_" face)]))
    (define over-key (Weld path [(strWeld "over_" face)]))
    (If (Eq face idx)
      sut
      (pipe sut
        (insert-tc get-key wack-span
          (tc-ffi (qua (nt:tfun [self-ty] fty)) (Ix idx)))
        (mark-derived get-key)
        (insert-tc set-key wack-span
          (tc-ffi (qua (nt:tfun [fty self-ty] self-ty)) (row-set-at idx)))
        (mark-derived set-key)
        (insert-tc over-key wack-span
          (tc-ffi (qua (nt:tfun [(nt:tfun [fty] fty) self-ty] self-ty))
            (row-over-at idx)))
        (mark-derived over-key))))
  (foldl go subject
    (zip (gen (Sz (nt:row-items row)) (lambda (i) i)) (nt:row-items row))))

;;; Core expression elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (elab-value-go compiler env surf)
  (define (check-value compiler env surf expected)
    (define r (elab-value-go compiler (env-with-goal expected env) surf))
    (define tc (_1 r))
    (define c1
      (ensure-subtype (_0 r) env (tc-ty tc) expected "type mismatch"))
    [c1 (set-tc-ty expected tc)])
  (define (elab-values compiler env surfs goals)
    (need env (Or (Nil goals) (Eq (Sz surfs) (Sz goals)))
      "argument arity mismatch" ["want" (Sz goals) "got" (Sz surfs)])
    (nt:thread-map
      (lambda (c pair)
        (If goals
          (check-value c env (_0 pair) (_1 pair))
          (elab-value-go c (clear-goal env) (_0 pair))))
      compiler
      (zip surfs (If goals goals (gen (Sz surfs) (lambda (i) 0))))))
  ;; Apply a monomorphic callee.  An under-application is a partial
  ;; application: PLAN application is natively curried, so the runtime
  ;; value is already right and only the type keeps the remaining
  ;; parameters.
  (define (elab-checked-apply-go compiler env f args fun)
    (need env (nt:fun-type? fun)
      "application expected a function" (tc-ty f))
    (define params (nt:fun-args fun))
    (need env (Le (Sz args) (Sz params))
      "function arity mismatch" ["want" (Sz params) "got" (Sz args)])
    (define ar (elab-values compiler env args (take (Sz args) params)))
    (define ret
      (If (Eq (Sz args) (Sz params))
        (nt:fun-return fun)
        (nt:tfun (drop (Sz args) params) (nt:fun-return fun))))
    [(_0 ar) (fold-tc-app f (_1 ar) ret)])
  (define (elab-checked-apply compiler env f args)
    (define vr
      (view-type compiler env (tc-ty f) "application expected a function"))
    (define fun (_1 vr))
    ;; A zero-argument application of a non-function — (labeled/tagof['$foo])
    ;; — is a bare force: value and type pass through unchanged.
    (cond
      ((And (Ifz (Sz args) 1 0) (Nil (nt:fun-type? fun)))
        [(_0 vr) f])
      ;; Applying a dynamically-typed value: the consistency boundary
      ;; lets Any apply to anything, arguments synthesize goal-free,
      ;; and the result is Any.
      ((nt:any-type? fun)
        (let ((ar (elab-values (_0 vr) env args 0)))
          [(_0 ar) (fold-tc-app f (_1 ar) nt:tany)]))
      ;; PLAN applies pins transparently: a pinned function calls like
      ;; the function itself ((pin[{a=nat; b=nat; nat}] add) 1 2).
      ((nt:pin-type? fun)
        (let ((ir
                (view-type (_0 vr) env (nt:pin-item fun)
                  "application expected a function")))
          (elab-checked-apply-go (_0 ir) env f args (_1 ir))))
      (else (elab-checked-apply-go (_0 vr) env f args fun))))
  ;; Two-phase inference for a generic callee without explicit
  ;; specialization: synthesize the non-lambda arguments and match the
  ;; parameter templates against their types (extra-known pairs — the
  ;; method receiver — join first), then the caller re-checks every
  ;; argument against the instantiated type, giving lambdas their goals.
  ;; Returns [compiler specialized-monotype].
  (define (infer-generic compiler env scm args extra-known what)
    (need env (Ifz (nt:scheme-const-parameter-count scm) 1 0)
      "const-generic call requires explicit specialization" what)
    (define body (nt:scheme-body scm))
    (need env (nt:fun-type? body) "application expected a function" scm)
    (define params (nt:fun-args body))
    (need env (Le (Sz args) (Sz params))
      "function arity mismatch" ["want" (Sz params) "got" (Sz args)])
    (define sr
      (foldl
        (lambda (state pair)
          (If (lambda-surf? (_1 pair))
            state
            (let ((r (elab-value-go (_0 state) (clear-goal env) (_1 pair))))
              [(_0 r)
               (snoc [(Ix (_0 pair) params) (tc-ty (_1 r))] (_1 state))])))
        [compiler extra-known]
        (zip (gen (Sz args) (lambda (i) i)) args)))
    (define arg-mr
      (foldl
        (lambda (state pair)
          (Ifz state
            0
            (nt:match-template (_0 state) (_1 state) (_0 pair) (_1 pair))))
        [(compiler-world (_0 sr)) []] (_1 sr)))
    ;; A variable that appears only in the return position (unpin's
    ;; {Any; a}) is invisible to argument matching; the call-site goal
    ;; determines it.  Goal joins after the arguments so their bindings
    ;; win, and best-effort: a goal that doesn't match the return
    ;; template never sinks an inference the arguments already solved.
    (define mr
      (let ((goal (env-goal env)))
        (If (And arg-mr goal)
          (let ((gm
                  (nt:match-template (_0 arg-mr) (_1 arg-mr)
                    (nt:fun-return body) goal)))
            (If gm gm arg-mr))
          arg-mr)))
    (need env mr
      "cannot infer type arguments from this call - specialize explicitly"
      what)
    (define lambda-args? (Ifz (find lambda-surf? args) 0 1))
    (define gargs
      (map
        (lambda (param)
          (define hit
            (find (lambda (b) (Eq (nt:parameter-name param) (_0 b)))
              (_1 mr)))
          (cond
            (hit (nt:type-arg (_1 (_0 hit))))
            ;; A variable only lambda arguments could determine (map's
            ;; @b, in the lambda's return) falls to Any: phase 2 still
            ;; hands the lambda its parameter types, and consistency
            ;; carries the result.  Legacy's two-phase recovered the
            ;; precise result type; tighten here if that ever bites.
            (lambda-args? (nt:type-arg nt:tany))
            (else
              (new-elab-error env
                ["could not infer type argument" (nt:parameter-name param)]
                what))))
        (nt:scheme-parameters scm)))
    (define spr (nt:specialize-scheme (_0 mr) scm gargs))
    [(compiler-with-world (_0 spr) (_0 sr)) (_1 spr)])
  ;; Expression position: a relative variant's arguments fill the member's
  ;; fields positionally, and the construction is typed as the EXPECTED
  ;; type (the union), so casts and call-argument checks pass without a
  ;; member-into-union subtype step.
  (define (relvar-construct compiler env tag args)
    (define goal (env-goal env))
    (Ifz goal
      (new-elab-error env
        "relative variant (.tag) needs an expected type here - add a ^ cast or an annotation"
        ["tag" tag])
      (let* ((mr (relvar-member compiler env tag goal "a value"))
             (row (_1 mr))
             (fields (map nt:row-item-value (nt:row-items row))))
        (need env (Eq (Sz args) (Sz fields))
          ["member arity mismatch" tag] ["want" (Sz fields) "got" (Sz args)])
        (let ((er (elab-values (_0 mr) env args fields)))
          [(_0 er) (tc-row goal (nt:row-cstr row) (_1 er))]))))
  (define (elab-ordinary-call compiler env fsurf args)
    (flow compiler
      ((f (elab-value-go compiler (clear-goal env) fsurf)))
      (If (Eq "TC_TYP" (Hd f))
        (let ((path (constructor-path compiler fsurf f)))
          (If path
            (flow compiler
              ((entry
                 (lift-world compiler
                   (nt:lookup-type-entry (compiler-world compiler) path))))
              (define body (nt:type-entry-body entry))
              (cond
                ((Nil body)
                  ;; A generic constructor instantiates from the
                  ;; expected type, exactly like a relative variant: the
                  ;; goal names the union (or member), the entry names
                  ;; which member.
                  (cond
                    ((env-goal env)
                      (relvar-construct compiler env
                        (path-last-segment path) args))
                    ;; Goal-less and nullary (map/empty in a plain
                    ;; let): the runtime value is just the brand, so
                    ;; instantiate at Any and let consistency carry
                    ;; later uses.
                    ((Ifz (Sz args) 1 0)
                      (flow compiler
                        ((key
                           (lift-world compiler
                             (nt:runtime-key (compiler-world compiler)
                               (nt:type-ref path)))))
                        (need env (Ifz (_1 key) 1 0)
                          "generic constructor requires explicit specialization"
                          path)
                        [compiler (tc-row nt:tany (_0 key) [])]))
                    (else
                      (new-elab-error env
                        "generic constructor requires explicit specialization"
                        path))))
                ((Nil (nt:row-type? body))
                  (new-elab-error env "called type is not a row constructor"
                    [path body]))
                (else
                  (flow compiler
                    ((fields
                       (elab-values compiler env args
                         (map nt:row-item-value (nt:row-items body)))))
                    [compiler
                     (tc-row (nt:type-ref path) (nt:row-cstr body)
                       fields)]))))
            (let ((inner (tc-typ-inner f)))
              (need env (Nil (nt:scheme? inner))
                "generic constructor requires explicit specialization" inner)
              ;; A template application (bst[@v] inside a @v body) or
              ;; plain monotype views to its row; the construction is
              ;; typed as the callee type itself.
              (flow compiler
                ((body
                   (view-type compiler env inner
                     "anonymous called type is not a row"))
                 (fields
                   (Seq
                     (need env (nt:row-type? body)
                       "anonymous called type is not a row" inner)
                     (elab-values compiler env args
                       (map nt:row-item-value (nt:row-items body))))))
                [compiler (tc-row inner (nt:row-cstr body) fields)]))))
        (If (nt:scheme? (tc-ty f))
          ;; Explicit-specialization-free generic call: infer, then
          ;; apply at the instantiated type.
          (flow compiler
            ((inst (infer-generic compiler env (tc-ty f) args [] (tc-ty f))))
            (elab-checked-apply compiler env (set-tc-ty inst f) args))
          (elab-checked-apply compiler env f args)))))
  ;; An absolute variant call constructs by tag: against a goal it is a
  ;; relative variant (typed as the expected union); without one it
  ;; synthesizes a structural row.
  (define (variant-construct compiler env tag args)
    (If (env-goal env)
      (relvar-construct compiler env tag args)
      (let ((ar (elab-values compiler (clear-goal env) args 0)))
        [(_0 ar)
         (tc-row
           (nt:trow tag
             (map
               (lambda (pair) (nt:trow-item (_0 pair) (tc-ty (_1 pair))))
               (zip (gen (Sz (_1 ar)) (lambda (i) i)) (_1 ar))))
           tag
           (_1 ar))])))
  (define (elab-call compiler env fsurf args)
    (define fhead (surf-strip-spans fsurf))
    (cond
      ((Eq "s_relvar" (_0 fhead))
        (relvar-construct compiler env (_1 fhead) args))
      ((Eq "s_variant" (_0 fhead))
        (variant-construct compiler env (_1 fhead) args))
      (else (elab-ordinary-call compiler env fsurf args))))
  (define (elab-specialization compiler env val args)
    (flow compiler
      ((base (elab-value-go compiler (clear-goal env) val))
       (gargs
         (let ((scm (tc-ty base)))
           (need env (nt:scheme? scm)
             "explicit specialization requires a generic value" scm)
           (type-application-arguments compiler env
             (nt:scheme-parameters scm) args))))
      (define scm (tc-ty base))
      (If (Eq "TC_TYP" (Hd base))
        (let ((path (specialization-base-path compiler val)))
          (need env path "type specialization needs a named base" val)
          ;; Inside a generic body the specialization stays symbolic;
          ;; it grounds (and interns) at an enclosing ground
          ;; specialization.  Structural ground args (function types)
          ;; have no path form and stay symbolic permanently.
          (If (all nt:path-ridable-argument? gargs)
            (flow compiler
              ((path1
                 (lift-world compiler
                   (nt:intern-type-application
                     (compiler-world compiler) path gargs))))
              [compiler (tc-typ (nt:type-ref path1))])
            [compiler (tc-typ (nt:type-app path gargs))]))
        (flow compiler
          ((spec
             (lift-world compiler
               (nt:specialize-scheme (compiler-world compiler)
                 scm gargs))))
          (Ifz (nt:scheme-const-parameter-count scm)
            ;; Type-only specialization erases at runtime: the value
            ;; is the base itself at its specialized type.
            [compiler (set-tc-ty spec base)]
            ;; A const-bearing instantiation is its own runtime entity.
            ;; It references the canonical /ty-ap member path; the base
            ;; entry skips lowering, and materialize-consts substitutes
            ;; the constants into a fresh entry at this path before
            ;; lowering.  Ground arguments make a canonical reference;
            ;; symbolic ones (inside a generic body) ride as /ty-var
            ;; segments rewritten per instantiation.
            (Seq
              (need env (Eq "TC_GLOBAL" (Hd base))
                "const-generic specialization requires a named value" val)
              [compiler
               (tc-global spec
                 (ty-ap-encode
                   (Weld [(tc-global-path base)]
                     (map specialization-argument-part gargs))))]))))))
  ;; One match arm -> [compiler [arm-tc key]].  env already carries the
  ;; scrutinee local (slot 0), matching lower-match's one-let framing; a
  ;; binder pattern adds TC_LET projections over that slot.
  (define (elab-case-arm compiler env scrut-ty opt-keys arm)
    (define pat (surf-strip-spans (surf-arm-pat arm)))
    (define body-surf (surf-arm-val arm))
    (define goal (env-goal env))
    (define (arm-body c e)
      (If goal
        (check-value c e body-surf goal)
        (elab-value-go c (clear-goal e) body-surf)))
    (define (member-arm tag binders)
      (define mr (relvar-member compiler env tag scrut-ty "a pattern"))
      (define row (_1 mr))
      (define narrowed (_2 mr))
      (define key (_3 mr))
      (define items (nt:row-items row))
      (need env (Or (Nil (Sz binders)) (Eq (Sz binders) (Sz items)))
        ["member arity mismatch in pattern" tag]
        ["want" (Sz items) "got" (Sz binders)])
      (define bound
        (foldl
          (lambda (state pair)
            (define i (_0 pair))
            (define binder (surf-strip-spans (_1 pair)))
            (define fty (nt:row-item-value (Ix i items)))
            (define c (_0 state))
            (define e (_1 state))
            (define binds (_2 state))
            (cond
              ((Eq "s_hole" (_0 binder)) state)
              ((And (Eq "s_ref" (_0 binder))
                 (Eq 1 (Sz (surf-ref-path binder))))
                [c
                 (push-local (_0 (surf-ref-path binder)) fty e)
                 (snoc (field-projection-tc scrut-ty fty i (Sz binds))
                   binds)])
              ;; A faced binder imposes its annotation as the binder's
              ;; type; the member's field must fit the annotation.
              ((Eq "s_face" (_0 binder))
                (let* ((tr (elab-type c env (surf-face-kid binder) 0))
                       (ann (_1 tr))
                       (c1 (ensure-subtype (_0 tr) env fty ann
                             "pattern annotation does not fit the member field")))
                  [c1
                   (push-local (surf-face-name binder) ann e)
                   (snoc (field-projection-tc scrut-ty ann i (Sz binds))
                     binds)]))
              (else
                (new-elab-error env "unsupported pattern binder" binder))))
          ;; Arm bodies see the scrutinee narrowed to the member, so its
          ;; faces spread as bare names alongside any explicit binders.
          [(_0 mr) (narrow-scrutinee env narrowed) []]
          (zip (gen (Sz binders) (lambda (i) i)) binders)))
      (define br (arm-body (_0 bound) (_1 bound)))
      (define body-tc
        (Ifz (Sz (_2 bound))
          (_1 br)
          (tc-letrec (tc-ty (_1 br)) (_2 bound) (_1 br))))
      [(_0 br) [(tc-arm (tc-ty (_1 br)) narrowed body-tc key) key]])
    ;; A named-type arm: narrow the scrutinee to the pattern type.  With a
    ;; binder name (the classic (name : Type) arm) the whole member binds
    ;; as one local, via a let over the re-typed scrutinee slot.
    (define (typed-arm binder-name pat-ty-surf)
      (let* ((tr (elab-type compiler env pat-ty-surf 0))
             (typ (_1 tr))
             (vr (view-type (_0 tr) env typ
                   "match arm pattern is not a row (constructor) type"))
             (row (_1 vr)))
        (need env (nt:row-type? row)
          "match arm pattern is not a row (constructor) type" typ)
        (let* ((kr (nt:runtime-key (compiler-world (_0 vr)) row))
               (key (flat-arm-key (_1 kr)))
               (c1 (compiler-with-world (_0 kr) (_0 vr))))
          ;; Open mode (opt-keys 0): every branded row arm is admissible.
          (need env (Or (Ifz opt-keys 1 0) (includes (Equal key) opt-keys))
            "match arm is not a member of the scrutinee union" typ)
          (let* ((e0 (narrow-scrutinee env typ))
                 (e1 (Ifz binder-name e0 (push-local binder-name typ e0)))
                 (br (arm-body c1 e1))
                 (body-tc
                   (Ifz binder-name
                     (_1 br)
                     (tc-letrec (tc-ty (_1 br))
                       [(tc-local typ 0 binder-name)] (_1 br)))))
            [(_0 br)
             [(tc-arm (tc-ty (_1 br)) typ body-tc key) key]]))))
    ;; Relative variants and absolute variants share the member-by-tag
    ;; route: a structural variant's constructor IS its tag.
    (define (pattern-member-tag node)
      (cond
        ((Eq "s_relvar" (_0 node)) (_1 node))
        ((Eq "s_variant" (_0 node)) (_1 node))
        (else 0)))
    (cond
      ((pattern-member-tag pat) (member-arm (pattern-member-tag pat) []))
      ((And (Eq "s_tapp" (_0 pat))
         (pattern-member-tag
           (surf-strip-spans (_0 (surf-tapp-kids pat)))))
        (member-arm
          (pattern-member-tag
            (surf-strip-spans (_0 (surf-tapp-kids pat))))
          (drop 1 (surf-tapp-kids pat))))
      ((Eq "s_face" (_0 pat))
        (typed-arm (surf-face-name pat) (surf-face-kid pat)))
      ((Or (Eq "s_ref" (_0 pat)) (Eq "s_var" (_0 pat)))
        (typed-arm 0 pat))
      ;; A binderless anonymous-row pattern ([x=nat y=nat]) narrows like
      ;; a typed arm; its faces spread through the narrowed scrutinee.
      ((Eq "s_trow" (_0 pat))
        (typed-arm 0 pat))
      (else (new-elab-error env "unsupported match arm pattern" pat))))
  (define (elab-case compiler env surf)
    (define goal (env-goal env))
    (define sr (elab-value-go compiler (clear-goal env) (_1 surf)))
    (define scrut (_1 sr))
    (define scrut-ty (tc-ty scrut))
    ;; A pail (or Any) scrutinee is the open universe of branded rows:
    ;; every nominal row arm is admissible, coverage is unknowable, and
    ;; the fallthrough is mandatory.  opt-keys 0 marks the open mode.
    (define svr
      (view-type (_0 sr) env scrut-ty
        "match scrutinee is not a union or row type"))
    (define open?
      (Or (nt:any-type? (_1 svr)) (nt:pail-type? (_1 svr))))
    (define or0
      (If open?
        [(_0 svr) []]
        (union-options (_0 svr) env scrut-ty
          "match scrutinee is not a union or row type")))
    (define okr (option-keys (_0 or0) (_1 or0)))
    (define opt-keys
      (If open?
        0
        (map (lambda (k) (Ifz k 0 (flat-arm-key k))) (_1 okr))))
    (define env1 (push-local match-scrutinee-name scrut-ty env))
    (define ar
      (foldl
        (lambda (state arm)
          (let ((r (elab-case-arm (_0 state) env1 scrut-ty opt-keys arm)))
            [(_0 r) (snoc (_1 r) (_1 state))]))
        [(_0 okr) []] (_2 surf)))
    (define infos (_1 ar))
    (define arm-tcs (map (Ix 0) infos))
    (define arm-keys (map (Ix 1) infos))
    ;; Equal keys dispatch identically, so a later duplicate is dead code.
    (define (dup? keys)
      (Ifz (Sz keys) 0
        (Or (includes (Equal (_0 keys)) (drop 1 keys))
          (dup? (drop 1 keys)))))
    (need env (Nil (dup? arm-keys))
      "match arm unreachable (an earlier arm already matches everything it matches)"
      arm-keys)
    (define fall (_3 surf))
    (define no-heir? (Eq foil-no-heir fall))
    (define uncovered
      (Ifz opt-keys
        ["(the open pail universe)"]
        (filter
          (lambda (k) (Or (Nil k) (Nil (includes (Equal k) arm-keys))))
          opt-keys)))
    (need env (Nil (And no-heir? (Sz uncovered)))
      "non-exhaustive match" ["missing" uncovered])
    ;; The fallthrough elaborates with the scrutinee local in scope: it is
    ;; lowered inside the match's let, so its slots must account for it.
    (define fallr
      (If no-heir?
        [(_0 ar) (tc-mean ["unreachable" arm-keys])]
        (If goal
          (check-value (_0 ar) env1 fall goal)
          (elab-value-go (_0 ar) (clear-goal env1) fall))))
    (define out-r
      (If goal
        [(_0 fallr) goal]
        (foldl
          (lambda (state arm)
            (let ((j
                    (nt:join (compiler-world (_0 state))
                      (_1 state) (tc-ty arm))))
              [(compiler-with-world (_0 j) (_0 state)) (_1 j)]))
          [(_0 fallr)
           (If no-heir? nt:tbot (tc-ty (_1 fallr)))]
          arm-tcs)))
    [(_0 out-r) (tc-match (_1 out-r) scrut arm-tcs (_1 fallr))])
  ;; A loop (|) is an immediately-applied anonymous lambda: params come
  ;; from the arm patterns, inits elaborate in the OUTER env (parallel
  ;; binding - it is one call), and (_ ...) re-enters via the self slot.
  (define (elab-loop compiler env surf)
    (define arms (_1 surf))
    (define body (_2 surf))
    (define pr
      (foldl
        (lambda (state arm)
          (define pat (surf-strip-spans (_1 arm)))
          (need env (Eq "s_face" (_0 pat))
            "loop parameter must be a faced type" pat)
          (let ((r (elab-type (_0 state) env (surf-face-kid pat) 0)))
            [(_0 r)
             (snoc (surf-face-name pat) (_1 state))
             (snoc (_1 r) (_2 state))]))
        [compiler [] []] arms))
    (define names (_1 pr))
    (define argtys (_2 pr))
    (define ir (elab-values (_0 pr) env (map (Ix 2) arms) argtys))
    (define rr (peek-return-type (_0 ir) env body))
    (define declared (_1 rr))
    (define self-ret (If declared declared nt:tbot))
    (define self-type (nt:tfun argtys self-ret))
    (define frame
      (Weld [($LocalBinding 0 self-type)]
        (map (lambda (pair) ($LocalBinding (_0 pair) (_1 pair)))
          (zip names argtys))))
    (define inner (push-locals frame (clear-goal env)))
    (define br
      (If declared
        (check-value (_0 rr) inner body declared)
        (elab-value-go (_0 rr) inner body)))
    (define typ (nt:tfun argtys (tc-ty (_1 br))))
    (define lam (tc-lam typ 0 (Weld [self-type] argtys) (_1 br)))
    [(_0 br) (fold-tc-app lam (_1 ir) (tc-ty (_1 br)))])
  ;; Method resolution: a member entry under the receiver's nominal path
  ;; wins (box[nat].get -> /boot/box/get); a bare source-visible global is
  ;; the UFCS fallback.  The receiver rides last, so written argument i
  ;; pairs with the method's parameter i.
  (define (meth-function compiler env rcvr-ty name)
    (define subject (compiler-subject compiler))
    (define (nominal-of t)
      (cond
        ((nt:type-ref? t)
          (let ((p (nt:type-ref-path t)))
            (If (ty-ap-path? p) (ty-ap-base p) p)))
        ;; A template-typed receiver (bst[@v] inside a generic body)
        ;; dispatches through its base namespace like a ground one.
        ((nt:type-app? t) (nt:ty-app-base t))
        ;; Structural receivers dispatch through their builtin nominal
        ;; namespaces, the same redispatch legacy score-meth performs.
        ((nt:array-type? t) ["row"])
        ;; A cstr-0 structural row is a PLAN row at runtime, so the row
        ;; builtins reach it (litlen's [1 2 3].len).  Branded rows keep
        ;; their nominal namespace via the reference clauses above.
        ((And (nt:row-type? t) (Ifz (nt:row-cstr t) 1 0))
          ["row"])
        ((nt:nat-type? t) ["nat"])
        (else 0)))
    ;; The receiver's nominal path is already canonical — for a mounted
    ;; type that means unit-qualified, and canon-path on a qualified key
    ;; would bounce off the visibility index.  Probe the raw member key
    ;; first; canon only resolves source-relative spellings.
    ;; A mounted extension (mapx adding map/has) stores its members under
    ;; its own unit, so neither probe can find them from the base unit's
    ;; canonical prefix.  Only the written namespace unifies the prefix:
    ;; reverse-map the canonical base to its written aliases and resolve
    ;; the member through the visibility index.
    ;; One shared inversion of the visibility index: written->canonical
    ;; pairs, computed lazily (forced only by mounted-receiver probes)
    ;; and scanned by the alias/extension/recording steps below instead
    ;; of each re-walking the index.
    (define vis (sut-visible subject))
    (define vis-pairs (Ifz vis [] (rowify (cairn:tapax vis))))
    (define (extension-member nominal)
      (define (member-at pair)
        (And (Equal nominal (_1 pair))
          (let ((m (cairn:getax (Weld (_0 pair) [name]) vis)))
            (And m (And (get-const (_0 m) subject) (_0 m))))))
      (let ((hit (find member-at vis-pairs)))
        (If hit (member-at (_0 hit)) 0)))
    (define (visible-canonical? key)
      (Truth
        (find (lambda (pair) (Equal key (_1 pair))) vis-pairs)))
    (define (member-for nominal)
      (And nominal
        (let* ((raw (snoc name nominal))
               (stored (get-const raw subject)))
          (cond
            ;; Legacy subjects infer visibility from storage: probe the
            ;; raw key, then the canonical spelling.
            ((Nil vis)
              (If stored
                raw
                (let ((mp (canon-path raw subject)))
                  (And (get-const mp subject) mp))))
            ;; A stored canonical key is admissible only through a
            ;; written alias: hidden transitive linking storage must
            ;; not leak methods into scope.
            ((And stored (visible-canonical? raw)) raw)
            (else
              (let* ((mp (canon-path raw subject))
                     (hit (And (get-const mp subject) mp))
                     (ext (Ifz hit (extension-member nominal) 0)))
                (cond
                  (hit hit)
                  (ext ext)
                  (stored
                    ;; The detail row leads with the legacy tag so
                    ;; tooling that scans error trees by head keeps
                    ;; recognizing the fence.
                    (new-elab-error env "no source-visible method"
                      ["no source-visible method"
                       ["method" name] ["receiver" nominal]]))
                  (else 0))))))))
    ;; A transparent alias contributes its own members first, then
    ;; unfolds one weak-head layer at a time so the target's method set
    ;; (and, transitively, the builtin structural namespaces) is
    ;; reachable through it.  The result carries the receiver type the
    ;; member actually resolved AGAINST — a ground const-generic alias
    ;; (myth = mop[path pail lt_pith]) supplies the /ty-ap arguments
    ;; its target's methods specialize from.
    (define (resolve c t depth)
      (define member (member-for (nominal-of t)))
      (cond
        (member
          (let ((gr (global-reference-canonical c env member)))
            [(record-member-resolution (_0 gr) env member vis-pairs)
             (_1 gr) t]))
        ((And (Lt depth 8)
           (Or (nt:type-ref? t) (nt:type-app? t)))
          (let* ((vr (nt:view (compiler-world c) t))
                 (c1 (compiler-with-world (_0 vr) c)))
            (If (Equal (_1 vr) t)
              (let ((r (global-reference c1 env [name])))
                [(_0 r) (_1 r) rcvr-ty])
              (resolve c1 (_1 vr) (Inc depth)))))
        (else
          (let ((r (global-reference c env [name])))
            [(_0 r) (_1 r) rcvr-ty]))))
    (resolve compiler rcvr-ty 0))
  ;; A generic method instantiates from its receiver: a template-typed
  ;; receiver (bst[@v]) supplies its symbolic arguments, a ground /ty-ap
  ;; reference decodes its own, and otherwise the receiver joins the
  ;; two-phase argument matching as the trailing parameter.
  (define (meth-specialize compiler env f rcvr-ty name margs)
    (define scm (tc-ty f))
    (define world (compiler-world compiler))
    (define param-count (Sz (nt:scheme-parameters scm)))
    ;; Type-only specialization erases at runtime, so the method keeps the
    ;; base reference.  A const-bearing instantiation at ground arguments is
    ;; its own runtime entity and must reference the canonical /ty-ap member
    ;; path (mirroring elab-specialization), or lowering meets the unsealed
    ;; base entry.
    (define (specialized-reference compiler1 sr args)
      (If (And (Lt 0 (nt:scheme-const-parameter-count scm))
            (Eq "TC_GLOBAL" (Hd f)))
        [(compiler-with-world (_0 sr) compiler1)
         (tc-global (_1 sr)
           (ty-ap-encode
             (Weld [(tc-global-path f)]
               (map specialization-argument-part args))))]
        [(compiler-with-world (_0 sr) compiler1) (set-tc-ty (_1 sr) f)]))
    (cond
      ;; The receiver-driven fast paths apply only when the method is
      ;; generic over exactly the receiver's arguments (accessors); a
      ;; method with extra parameters (map's @b) goes through matching.
      ((And (nt:type-app? rcvr-ty)
         (Eq param-count (Sz (nt:ty-app-arguments rcvr-ty))))
        (let ((sr (nt:specialize-scheme world scm
                    (nt:ty-app-arguments rcvr-ty))))
          (specialized-reference compiler sr
            (nt:ty-app-arguments rcvr-ty))))
      ((And (nt:type-ref? rcvr-ty)
         (And (ty-ap-path? (nt:type-ref-path rcvr-ty))
           (Eq param-count
             (Sz (drop 1 (ty-ap-decode (nt:type-ref-path rcvr-ty)))))))
        (let* ((dr (nt:decode-application-arguments nt:lookup-type-entry
                     world (nt:scheme-parameters scm)
                     (drop 1 (ty-ap-decode (nt:type-ref-path rcvr-ty)))))
               (sr (nt:specialize-scheme (_0 dr) scm (_1 dr))))
          (specialized-reference compiler sr (_1 dr))))
      (else
        (let ((body (nt:scheme-body scm)))
          (need env (And (nt:fun-type? body) (Eq (Inc (Sz margs)) (Sz (nt:fun-args body))))
            ["method arity mismatch" name] scm)
          (let ((gr
                  (infer-generic compiler env scm margs
                    [[(Ix (Sz margs) (nt:fun-args body)) rcvr-ty]]
                    name)))
            [(_0 gr) (set-tc-ty (_1 gr) f)])))))
  (define (elab-meth-step env state seg)
    (define rcvr (_1 state))
    (define name (surf-mseg-name seg))
    (define margs (surf-mseg-args seg))
    (define fr0 (meth-function (_0 state) env (tc-ty rcvr) name))
    (flow compiler
      ((f
         (If (nt:scheme? (tc-ty (_1 fr0)))
           (meth-specialize (_0 fr0) env (_1 fr0) (_2 fr0) name margs)
           [(_0 fr0) (_1 fr0)]))
       (fun (view-type compiler env (tc-ty f) "method is not a function"))
       (margs-tc
         (Seq
           (need env (nt:fun-type? fun)
             "method is not a function" [name (tc-ty f)])
           (Seq
             (need env (Eq (Inc (Sz margs)) (Sz (nt:fun-args fun)))
               ["method arity mismatch" name]
               ["want" (Sz (nt:fun-args fun)) "got" (Inc (Sz margs))])
             (elab-values compiler env margs
               (take (Sz margs) (nt:fun-args fun)))))))
      [(ensure-subtype compiler env (tc-ty rcvr)
         (Ix (Sz margs) (nt:fun-args fun))
         "receiver does not fit the method's trailing parameter")
       (fold-tc-app f (snoc rcvr margs-tc) (nt:fun-return fun))]))
  (define (elab-meth compiler env surf)
    (define els (_1 surf))
    (define head (_0 els))
    ;; The receiver slot holds a bare name (resolve like s_var) or a
    ;; parenthesized expression's SAST node.
    (define hr
      (elab-value-go compiler (clear-goal env)
        (If (IsApp head) head ["s_var" head])))
    (foldl (elab-meth-step env) hr (drop 1 els)))
  (define tag (_0 surf))
  (cond
    ((Eq tag "s_span")
      (elab-value-go compiler (env-with-span (_1 surf) env) (_2 surf)))
    ((Eq tag "s_lit")
      [compiler (tc-lit (nt:tconst (surf-lit-val surf)) (surf-lit-val surf))])
    ;; Aura literals are goal-directed (doc/aura-spec.md Part III): at
    ;; an iota goal they build the tagged pair; at an aura'd-nat goal
    ;; (or none) the value is the bare payload nat and the aura rides
    ;; the type alone.
    ((Eq tag "s_literal")
      (let* ((gv (goal-view compiler env))
             (gc (_0 gv))
             (goal (_1 gv))
             (iota-goal? (And goal (Equal iota-body goal)))
             (aura-goal
               (If (And goal
                     (And (nt:nat-type? goal)
                       (Ifz (nt:nat-aura goal) 0 1)))
                 (nt:nat-aura goal)
                 0)))
        (cond
          ((Eq "cord" (_1 surf))
            (cond
              (iota-goal?
                [gc (tc-lit (env-goal env)
                      (quip:cord-to-text-quip (_2 surf)))])
              ((Eq "tu" aura-goal)
                [gc (tc-lit (nt:tnat "tu") (_2 surf))])
              (else [gc (tc-lit (nt:tconst (_2 surf)) (_2 surf))])))
          ;; '/foo/bar — a path literal: a row of iotas, one segment
          ;; per aura spelling ('/ alone is the empty path).  Synthesizes
          ;; row[iota]; check-value's subtype pass admits it at path
          ;; (and other alias) goals.
          ((And (Eq "quip" (_1 surf)) (Eq "/" (Load8 0 (_2 surf))))
            [gc (tc-lit (nt:tarr (nt:type-ref ["iota"]))
                  (quip:parse-path (_2 surf)))])
          ((Eq "quip" (_1 surf))
            (let* ((p (quip:parse-quip (_2 surf)))
                   (ptag (Hd p)))
              (cond
                (iota-goal? [gc (tc-lit (env-goal env) p)])
                (aura-goal
                  (If (Eq ptag aura-goal)
                    [gc (tc-lit (nt:tnat ptag) (Ix 0 p))]
                    (new-elab-error env "aura mismatch"
                      ["literal" ptag "goal" aura-goal])))
                (else [gc (tc-lit (nt:tnat ptag) (Ix 0 p))]))))
          (else (new-elab-error env "unsupported literal shape" (_1 surf))))))
    ((Eq tag "s_ref")
      (global-reference compiler env (surf-ref-path surf)))
    ((Eq tag "s_var")
      (let ((local (find-local env (_1 surf))))
        (If local
          (let ((binding (_1 local)))
            [compiler
             (tc-local (local-type binding) (_0 local) (local-name binding))])
          (let ((cb (const-binding env (_1 surf))))
            (If cb
              [compiler (tc-cparam (_1 cb) (_1 surf))]
              ;; Resolvable globals win over face-spread: (lock nd ns)
              ;; constructs even when a local carries a .lock field;
              ;; a bare face only captures names the namespace cannot
              ;; see.
              (let* ((gpath
                       (canon-path [(_1 surf)]
                         (compiler-subject compiler)))
                     (bound
                       (Or
                         (nt:type-bound?
                           (compiler-world compiler) gpath)
                         (get-const gpath (compiler-subject compiler)))))
                (If bound
                  (global-reference compiler env [(_1 surf)])
                  (let ((fr
                          (local-face-reference compiler env (_1 surf))))
                    (If fr
                      fr
                      (global-reference compiler env
                        [(_1 surf)]))))))))))
    ((Eq tag "s_cast")
      (let* ((tr (elab-type compiler env (surf-cast-ty surf) 0))
             (vr (check-value (_0 tr) env (_2 surf) (_1 tr))))
        [(_0 vr) (set-tc-ty (_1 tr) (_1 vr))]))
    ;; (^ expr) — unary type reflection: elaborate the operand, take
    ;; the type elaboration assigned to it (a named type reflects its
    ;; inner type), and splice the descriptor as a literal.  The
    ;; operand's TC is discarded — never lowered, never evaluated.
    ((Eq tag "s_reflect")
      (let* ((vr (elab-value-go compiler (clear-goal env) (_1 surf)))
             (tc (_1 vr))
             (named? (Eq "TC_TYP" (Hd tc)))
             (typ0 (If named? (tc-typ-inner tc) (tc-ty tc)))
             ;; Reflecting a TYPE NAME that names a row or sum yields
             ;; its declared structure (record faces are what the
             ;; explorer's value registry needs); scalar names stay
             ;; references ((^ nat) is /nat), and VALUE operands
             ;; always reflect their static type unchanged.
             (dv (If (And named?
                       (Or (nt:type-ref? typ0) (nt:type-app? typ0)))
                   (view-deep (_0 vr) typ0)
                   [(_0 vr) typ0]))
             (typ (If (Or (nt:row-type? (_1 dv)) (nt:sum-type? (_1 dv)))
                    (_1 dv)
                    typ0)))
        [(_0 dv)
         (tc-lit (nt:type-ref ["type"]) (reflect-encode env typ))]))
    ((Eq tag "s_fun")
      ;; A positional-row parameter ((\ acc [key val] ...)) desugars to
      ;; a fresh parameter destructured by the letrec machinery.  Fresh
      ;; names are small nats (1-indexed; 0 is the self slot): no source
      ;; word can collide with them.
      (let* ((raw-args (surf-fun-args surf))
             (dr
               (foldl
                 (lambda (st pair)
                   (define i (_0 pair))
                   (define a (_1 pair))
                   (define stripped (surf-strip-spans a))
                   (If (Eq "s_trow" (_0 stripped))
                     [(snoc ["s_ref" [(Inc i)]] (_0 st))
                      (snoc [0 stripped ["s_var" (Inc i)]] (_1 st))]
                     [(snoc a (_0 st)) (_1 st)]))
                 [[] []]
                 (zip (gen (Sz raw-args) (lambda (i) i)) raw-args)))
             (fun-args (_0 dr))
             (body-surf
               (Ifz (Sz (_1 dr))
                 (surf-fun-ret surf)
                 ["s_letrec" (_1 dr) (surf-fun-ret surf)]))
             (gr (function-goal compiler env (Sz fun-args)))
             (goal-fun (_1 gr))
             (pr
               (lambda-parameters (_0 gr) env fun-args goal-fun))
             (pairs (_1 pr))
             (bindings (map (Ix 0) pairs))
             (arg-types (map (Ix 1) pairs))
             (rr (peek-return-type (_0 pr) env body-surf))
             (declared-ret
               (If (_1 rr) (_1 rr)
                 (If goal-fun (nt:fun-return goal-fun) 0)))
             (self-ret (If declared-ret declared-ret nt:tbot))
             (self-type (nt:tfun arg-types self-ret))
             (frame-bindings
               (Weld [($LocalBinding 0 self-type)] bindings))
             (inner
               (push-locals frame-bindings
                 (clear-goal env)))
             (br
               (If declared-ret
                 (check-value (_0 rr) inner body-surf declared-ret)
                 (elab-value-go (_0 rr) inner body-surf)))
             (typ (nt:tfun arg-types (tc-ty (_1 br))))
             (c1
               (If goal-fun
                 (ensure-subtype (_0 br) env typ (env-goal env)
                   "lambda does not match its expected function type")
                 (_0 br)))
             (out-type (If goal-fun (env-goal env) typ)))
        [c1
         (tc-lam out-type 0 (Weld [self-type] arg-types) (_1 br))]))
    ((Eq tag "s_self")
      (let ((self (find-local env 0)))
        (need env self "recursive call outside a function" surf)
        (let ((binding (_1 self)))
          (need env (nt:fun-type? (local-type binding))
            "recursive function has no declared return type"
            (local-type binding))
          ;; An undeclared self-return is Bot: the recursive call
          ;; contributes nothing to a join, so an uncast loop types as
          ;; the join of its non-recursive exits.  Under-application is
          ;; a partial application, as everywhere: (_) alone takes the
          ;; recursive function itself as a value.
          (let* ((fun (local-type binding))
                 (params (nt:fun-args fun))
                 (args (_1 surf)))
            (need env (Le (Sz args) (Sz params))
              "recursive call arity mismatch"
              ["want" (Sz params) "got" (Sz args)])
            (let ((ar
                    (elab-values compiler env args
                      (take (Sz args) params))))
              [(_0 ar)
               (fold-tc-app
                 (tc-local fun (_0 self) 0)
                 (_1 ar)
                 (If (Eq (Sz args) (Sz params))
                   (nt:fun-return fun)
                   (nt:tfun (drop (Sz args) params)
                     (nt:fun-return fun))))])))))
    ((Eq tag "s_app")
      (elab-call compiler env (_1 surf) (_2 surf)))
    ((Eq tag "s_relvar")
      (relvar-construct compiler env (_1 surf) []))
    ((Eq tag "s_case") (elab-case compiler env surf))
    ((Eq tag "s_loop") (elab-loop compiler env surf))
    ((Eq tag "s_meth") (elab-meth compiler env surf))
    ((Eq tag "s_ufcs_put")
      (new-elab-error env "unsupported surface form"
        "UFCS put (.#) - use .set_<face>(val); not ported to the new elaborator yet"))
    ((Eq tag "s_ufcs_over")
      (new-elab-error env "unsupported surface form"
        "UFCS update (.%) - use .over_<face>(fun); not ported to the new elaborator yet"))
    ((Eq tag "s_spec")
      (elab-specialization compiler env
        (surf-spec-val surf) (surf-spec-args surf)))
    ((Eq tag "s_row")
      ;; goal-view (not the single-layer view-type): a row goal can sit
      ;; behind an alias chain (path -> row[iota] -> tarr), and the
      ;; element goals must reach the kids or aura literals in paths
      ;; would synthesize bare instead of building iota pairs.
      (let* ((gvr (goal-view compiler env))
             (array-goal
               (If (And (_1 gvr) (nt:array-type? (_1 gvr)))
                 (_1 gvr) 0))
             (row-goal
               (If (And (_1 gvr) (nt:row-type? (_1 gvr)))
                 (_1 gvr) 0))
             ;; A row goal of the wrong arity must fail here.  Falling back
             ;; to synthesis and then stamping the literal with the goal
             ;; type would let any row check against any row goal.  An
             ;; array goal types every element at its item type instead.
             (goals
               (cond
                 (array-goal
                   (gen (Sz (surf-row-kids surf))
                     (lambda (i) (nt:array-item array-goal))))
                 (row-goal
                   (If (Eq (Sz (surf-row-kids surf))
                         (Sz (nt:row-items row-goal)))
                     (map nt:row-item-value (nt:row-items row-goal))
                     (new-elab-error env "row literal arity mismatch"
                       ["want" (Sz (nt:row-items row-goal))
                        "got" (Sz (surf-row-kids surf))])))
                 (else 0)))
             (er
               (elab-values (_0 gvr) env (surf-row-kids surf) goals))
             (body
               (If row-goal row-goal
                 (nt:trow 0
                   (map (lambda (pair)
                     (nt:trow-item (_0 pair) (tc-ty (_1 pair))))
                     (zip (gen (Sz (_1 er)) (lambda (i) i)) (_1 er))))))
             (typ
               (If (Or array-goal row-goal) (env-goal env) body)))
        [(_0 er)
         (tc-row typ
           (If array-goal 0 (nt:row-cstr body))
           (_1 er))]))
    ((Eq tag "s_variant")
      (let ((typ (nt:trow (_1 surf) [])))
        [compiler (tc-row typ (_1 surf) [])]))
    ((Eq tag "s_if")
      (flow compiler
        ((cnd (check-value compiler (clear-goal env) (_1 surf) (nt:tnat 0)))
         (yes
           (If (env-goal env)
             (check-value compiler env (_2 surf) (env-goal env))
             (elab-value-go compiler (clear-goal env) (_2 surf))))
         (no
           (If (env-goal env)
             (check-value compiler env (_3 surf) (env-goal env))
             (elab-value-go compiler (clear-goal env) (_3 surf))))
         (out
           (If (env-goal env)
             [compiler (env-goal env)]
             (lift-world compiler
               (nt:join (compiler-world compiler)
                 (tc-ty yes) (tc-ty no))))))
        [compiler
         (fold-tc-app (tc-ffi (nt:tfun [(nt:tnat 0) out out] out) If)
           [cnd yes no] out)]))
    ((Eq tag "s_letrec")
      (let* ((outer-goal (env-goal env))
             (lr
               (foldl
                 (lambda (state arm)
                   (define c (_0 state))
                   (define e (_1 state))
                   (define binds (_2 state))
                   (define pat (_1 arm))
                   (define value (_2 arm))
                   (define stripped (surf-strip-spans pat))
                   (If (Eq "s_trow" (_0 stripped))
                     ;; = [a b] value — positional destructure: the whole
                     ;; value binds under a hidden slot, then each name
                     ;; as a field projection of it (distance i: i locals
                     ;; are pushed between the parent and projection i).
                     ;; A faced kid ([x=nat y=nat]) annotates its
                     ;; binding; the row's field must fit the annotation.
                     ;; specs: [name-or-0 [ann-surf]-or-0] per position.
                     (let* ((specs
                              (map
                                (lambda (k)
                                  (let ((ks (surf-strip-spans k)))
                                    (cond
                                      ((And (Eq "s_ref" (_0 ks))
                                         (Eq 1 (Sz (surf-ref-path ks))))
                                        [(_0 (surf-ref-path ks)) 0])
                                      ;; A hole occupies its position
                                      ;; without binding.
                                      ((Eq "s_hole" (_0 ks)) [0 0])
                                      ((Eq "s_face" (_0 ks))
                                        [(surf-face-name ks)
                                         [(surf-face-kid ks)]])
                                      (else
                                        (new-elab-error e
                                          "unsupported local binding pattern"
                                          pat)))))
                                (_1 stripped)))
                            (vr (elab-value-go c (clear-goal e) value))
                            (typ (tc-ty (_1 vr)))
                            (wr
                              (view-type (_0 vr) e typ
                                "destructuring needs a row value"))
                            (row (_1 wr)))
                       (need e (And (nt:row-type? row) (Eq (Sz specs) (Sz (nt:row-items row))))
                         "destructuring arity mismatch"
                         ["pattern" (map (Ix 0) specs) "value" typ])
                       (let* ((items
                                (map nt:row-item-value (nt:row-items row)))
                              (out
                                (foldl
                                  (lambda (st i)
                                    (If (Nil (_0 (Ix i specs)))
                                      st
                                      (let* ((ann-surf (_1 (Ix i specs)))
                                             (tr
                                               (If ann-surf
                                                 (elab-type (_0 st) e
                                                   (_0 ann-surf) 0)
                                                 [(_0 st) 0]))
                                             (c2
                                               (If ann-surf
                                                 (ensure-subtype (_0 tr) e
                                                   (Ix i items) (_1 tr)
                                                   "destructuring annotation does not fit the row field")
                                                 (_0 tr)))
                                             (ty
                                               (If ann-surf
                                                 (_1 tr)
                                                 (Ix i items))))
                                        [c2
                                         (push-local (_0 (Ix i specs))
                                           ty (_1 st))
                                         (snoc
                                           (field-projection-tc typ
                                             ty i (_3 st))
                                           (_2 st))
                                         (Inc (_3 st))])))
                                  [(_0 wr)
                                   (push-local "#foil-new-elab/destructure"
                                     typ e)
                                   (snoc (_1 vr) binds)
                                   0]
                                  (gen (Sz specs) (lambda (i) i)))))
                         [(_0 out) (_1 out) (_2 out)]))
                     (let* ((faced (Eq "s_face" (_0 pat)))
                            (name
                              (cond
                                (faced (surf-face-name pat))
                                ((And (Eq "s_ref" (_0 pat))
                                   (Eq 1 (Sz (surf-ref-path pat))))
                                  (_0 (surf-ref-path pat)))
                                (else
                                  (new-elab-error e
                                    "unsupported local binding pattern" pat))))
                            (tr
                              (If faced
                                (elab-type c e (surf-face-kid pat) 0)
                                [c 0]))
                            (vr
                              (If (_1 tr)
                                (check-value (_0 tr) e value (_1 tr))
                                (elab-value-go (_0 tr) (clear-goal e) value)))
                            (typ (If (_1 tr) (_1 tr) (tc-ty (_1 vr)))))
                       [(_0 vr) (push-local name typ e)
                        (snoc (_1 vr) binds)])))
                 [compiler (clear-goal env) []] (_1 surf)))
             (br
               (If outer-goal
                 (check-value (_0 lr) (env-with-goal outer-goal (_1 lr))
                   (_2 surf) outer-goal)
                 (elab-value-go (_0 lr) (_1 lr) (_2 surf)))))
        [(_0 br) (tc-letrec (tc-ty (_1 br)) (_2 lr) (_1 br))]))
    ((Eq tag "s_tvars")
      (let* ((vars (_1 surf))
             (e1 (env-with-type-vars (Weld vars (env-type-vars env)) env))
             (r (elab-value-go compiler e1 (_2 surf))))
        [(_0 r) (tc-with-parameters (map nt:type-param vars) (_1 r))]))
    ((Eq tag "s_cvars")
      (let* ((cr (elab-const-entries compiler env [] (_1 surf)))
             (e1
               (env-with-const-vars (Weld (_1 cr) (env-const-vars env)) env))
             (r (elab-value-go (_0 cr) e1 (_2 surf))))
        [(_0 r) (tc-with-parameters (_2 cr) (_1 r))]))
    ((Or (Eq tag "s_trow")
       (Or (Eq tag "s_tfun") (Eq tag "s_union")))
      (let ((r (elab-scheme compiler env surf 0)))
        [(_0 r) (tc-typ (_1 r))]))
    (else (new-elab-error env "unsupported surface form" surf))))

(define (elab-value compiler surf)
  ;; A live value elaborates at module level: %/ anchors at the
  ;; compilation root.
  (elab-value-go compiler empty-env (cref-expand [] surf)))


;;; Module sealing and elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (type-form? surf)
  (define tag (_0 surf))
  (cond
    ((Eq tag "s_span") (type-form? (_2 surf)))
    ((Or (Eq tag "s_tvars") (Eq tag "s_cvars"))
      (type-form? (_2 surf)))
    (else (Or (Eq tag "s_trow")
            (Or (Eq tag "s_tfun") (Eq tag "s_union"))))))

;; The bare-reference head of a candidate alias body (+ myn nat,
;; + spot pt, + path row[quip]), or 0.
(define (alias-target-path surf)
  (define tag (_0 surf))
  (cond
    ((Eq tag "s_span") (alias-target-path (_2 surf)))
    ((Or (Eq tag "s_tvars") (Eq tag "s_cvars"))
      (alias-target-path (_2 surf)))
    ((Eq tag "s_ref") (surf-ref-path surf))
    ((Eq tag "s_var") [(_1 surf)])
    ((Eq tag "s_tapp")
      (let ((head (surf-strip-spans (_0 (surf-tapp-kids surf)))))
        (If (Eq "s_ref" (_0 head)) (surf-ref-path head) 0)))
    ((Eq tag "s_spec")
      (alias-target-path (surf-strip-spans (_1 surf))))
    (else 0)))

;; A declaration is a type declaration if its body is a type form, or a
;; bare-word alias whose target names a bound type.  The alias check is
;; stable across passes: targets are builtins or earlier declarations of
;; this module, both seeded before anything consults them.
(define (type-declaration? compiler body)
  (Or (type-form? body)
    (let ((target (alias-target-path body)))
      (And target
        (Or
          ;; nat/<aura> is type grammar, not a namespace entry.
          (And (Eq 2 (Sz target))
            (And (Eq "nat" (_0 target)) (aura-tag? (_1 target))))
          (nt:type-bound? (compiler-world compiler)
            (type-path compiler target)))))))

(define (placeholder-parameters surf)
  (define tag (_0 surf))
  (cond
    ((Eq tag "s_span") (placeholder-parameters (_2 surf)))
    ((Eq tag "s_tvars")
      (Weld (map nt:type-param (_1 surf))
        (placeholder-parameters (_2 surf))))
    ((Eq tag "s_cvars")
      (Weld (map (lambda (ent) (nt:const-param (_0 ent) nt:tany))
              (_1 surf))
        (placeholder-parameters (_2 surf))))
    (else [])))

(define (seed-type-declaration compiler row)
  (define path (root-path (compiler-subject compiler) (_1 row)))
  (define body (_3 row))
  (Ifz (type-declaration? compiler body)
    compiler
    (let* ((scm (nt:scheme (placeholder-parameters body) nt:tany))
           (world (compiler-world compiler))
           (world1
             (If (nt:type-bound? world path)
               (nt:replace-type world path scm 0 0 body)
               (nt:declare-type world path scm 0 0 body)))
           (subject1
             (insert-tc path (_2 row) (tc-typ scm)
               (compiler-subject compiler))))
      ;; Forcing the artifact here keeps any elaboration error inside this
      ;; declaration's Try (see run-decl-pass); an unforced error would
      ;; otherwise fire in whichever neighbor demands it first.
      (Seq (DeepSeq scm 1)
        ($NewCompiler subject1 world1 (compiler-resolutions compiler))))))

(define (refine-type-declaration compiler row)
  (define path (root-path (compiler-subject compiler) (_1 row)))
  (define body (_3 row))
  (Ifz (type-declaration? compiler body)
    compiler
    (let* ((env (env-with-name path empty-env))
           (sr (elab-scheme compiler env body (print-path path)))
           (scm (_1 sr))
           (mono (nt:scheme-body scm))
           ;; A row body brands itself; an alias body (type-ref/app to
           ;; its target) forwards the target's runtime key, so pattern
           ;; matching through the alias dispatches on the real brand.
           (kr
             (If (nt:row-type? mono)
               [(compiler-world (_0 sr))
                [(nt:row-cstr mono) (Sz (nt:row-items mono))]]
               (nt:runtime-key (compiler-world (_0 sr)) mono)))
           (key (_1 kr))
           (brand (If key (_0 key) 0))
           (arity (If key (_1 key) 0))
           (world1
             (nt:replace-type (_0 kr) path scm
               brand arity body))
           (subject1
             (insert-tc path (_2 row) (tc-typ scm)
               (compiler-subject (_0 sr))))
           (subject2
             (If (nt:row-type? mono)
               (gen-accessors path scm subject1)
               subject1)))
      (Seq (DeepSeq scm 1)
        ($NewCompiler subject2 world1 (compiler-resolutions compiler))))))

(define (prototype-value compiler env surf)
  (define tag (_0 surf))
  (cond
    ((Eq tag "s_span")
      (prototype-value compiler (env-with-span (_1 surf) env) (_2 surf)))
    ((Eq tag "s_tvars")
      (let* ((vars (_1 surf))
             (r
               (prototype-value compiler
                 (env-with-type-vars (Weld vars (env-type-vars env)) env)
                 (_2 surf))))
        [(_0 r) (tc-with-parameters (map nt:type-param vars) (_1 r))]))
    ((Eq tag "s_cvars")
      (let* ((cr (elab-const-entries compiler env [] (_1 surf)))
             (e1
               (env-with-const-vars (Weld (_1 cr) (env-const-vars env)) env))
             (r (prototype-value (_0 cr) e1 (_2 surf))))
        [(_0 r) (tc-with-parameters (_2 cr) (_1 r))]))
    ((Eq tag "s_cast")
      (let ((r (elab-type compiler env (surf-cast-ty surf) 0)))
        [(_0 r) (tc-const (_1 r) 0)]))
    ;; A reflection's type is always the descriptor sum: forward
    ;; references to reflect-bodied declarations need no annotation.
    ((Eq tag "s_reflect")
      [compiler (tc-const (nt:type-ref ["type"]) 0)])
    ((Eq tag "s_fun")
      (let* ((pr (lambda-parameters compiler env (surf-fun-args surf) 0))
             (rr (peek-return-type (_0 pr) env (surf-fun-ret surf))))
        (Ifz (_1 rr)
          [(_0 rr) (prototype-tc)]
          [(_0 rr)
           (tc-const (nt:tfun (map (Ix 1) (_1 pr)) (_1 rr)) 0)])))
    (else [compiler (prototype-tc)])))

(define (seed-value-declaration compiler row)
  (define body (_3 row))
  (If (type-declaration? compiler body)
    compiler
    (let* ((path (root-path (compiler-subject compiler) (_1 row)))
           (env (env-with-name path empty-env))
           (pr (prototype-value compiler env body))
           (subject1
             (insert-tc path (_2 row) (_1 pr)
               (compiler-subject (_0 pr)))))
      (Seq (DeepSeq (_1 pr) 1)
        (compiler-with-subject subject1 (_0 pr))))))

(define (elab-declaration compiler row)
  (define path (root-path (compiler-subject compiler) (_1 row)))
  (define body (_3 row))
  (If (type-declaration? compiler body)
    compiler
    (let* ((env (env-with-name path empty-env))
           (r (elab-value-go compiler env body))
           (subject1
             (insert-tc path (_2 row) (_1 r)
               (compiler-subject (_0 r)))))
      (Seq (DeepSeq (_1 r) 1)
        (compiler-with-subject subject1 (_0 r))))))

(define (module-declarations mod)
  (filter (lambda (row) (And (IsApp row) (Eq "s_decl" (_0 row)))) mod))


;;; Module diagnostics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Diagnostic rows are ["in-decl" name detail blurb], the shape the
;; production driver already consumes from the legacy elaborator.
(define (decl-diag name detail span)
  ["in-decl" name detail (span-blurb span)])

(define (reserved-decl-name? name)
  (And (IsApp name)
    (And (Sz name)
      (Or (Eq ty-ap-tag (Ix 0 name)) (Eq ty-var-tag (Ix 0 name))))))

;; Pre-scan for rows the declaration passes cannot diagnose themselves:
;; parse failures (s_bad carries the s_decl shape), imports which should
;; have been resolved before elaboration, and reserved namespaces.
(define (module-scan-diags mod)
  (foldl
    (lambda (diags row)
      (cond
        ((Nil (IsApp row)) diags)
        ((Eq "s_bad" (_0 row))
          (snoc (decl-diag (_1 row) (_3 row) (_2 row)) diags))
        ((Eq "s_import" (_0 row))
          (snoc (decl-diag [(_3 row)]
                  "unresolved import (inline modules cannot import)"
                  (_2 row))
            diags))
        ((And (Eq "s_decl" (_0 row)) (reserved-decl-name? (_1 row)))
          (snoc (decl-diag (_1 row)
                  "reserved name: /ty-ap and /ty-var belong to the type system"
                  (_2 row))
            diags))
        (else diags)))
    [] mod))

(define (decl-poison compiler path span)
  (compiler-with-subject
    (insert-tc path span (tc-mean ["elab failed" path])
      (compiler-subject compiler))
    compiler))

;; One per-declaration step of one pass, under Try.  The pass deep-forces
;; its artifact internally, so the Try observes this declaration's errors
;; and only those.  A failed declaration is poisoned with TC_MEAN — its
;; referees then fail their own Try with a readable cascade diagnostic —
;; and the remaining passes skip it.
(define (run-decl-pass pass state row)
  (define compiler (_0 state))
  (define diags (_1 state))
  (define failed (_2 state))
  (define path (root-path (compiler-subject compiler) (_1 row)))
  (If (Or (includes (Equal path) failed) (reserved-decl-name? (_1 row)))
    state
    (let ((r (Try (lambda (z) (pass compiler row)) 0)))
      (If (Eq 1 (Hd r))
        [(decl-poison compiler path (_2 row))
         (snoc (decl-diag path (_0 r) (_2 row)) diags)
         (snoc path failed)]
        [(_0 r) diags failed]))))

(define (run-pass pass state decls)
  (foldl (run-decl-pass pass) state decls))

;; Post-pass well-formedness: every declaration's stored type must resolve
;; all of its nominal references against the FINAL world (types may
;; reference declarations that follow them, so checking at insert time is
;; too early).  elab-type deliberately emits references without lookup;
;; this is where a dangling one in a never-unfolded position surfaces.
(define (wf-declaration compiler row)
  (define path (root-path (compiler-subject compiler) (_1 row)))
  (define typ (tc-ty (got-entry-tc path (compiler-subject compiler))))
  (Seq
    (cond
      ((nt:scheme? typ)
        (nt:check-scheme-wf (compiler-world compiler) typ))
      ((nt:monotype? typ)
        (nt:check-template-wf (compiler-world compiler) typ))
      (else 0))
    compiler))


;;; Module elaboration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Prototype refinement creates public row accessors.  They are derived
;; declarations of this unit: make them source-visible in the same
;; sealed environment, with the original own-layer provenance, without
;; adding them to the source layer or its unit identity (mirror of the
;; legacy derived-own extension).
(define (extend-derived-environment base-subject compiler)
  (define subject (compiler-subject compiler))
  (define unit (sut-unit subject))
  (Ifz (foil-env:environment? unit)
    compiler
    (let* ((root (sut-root subject))
           (local-path
             (lambda (key)
               (If (foil-env:path-prefix? root key)
                 (drop (Sz root) key)
                 key)))
           (derived
             (filter
               (lambda (pair)
                 (foil-env:res-unknown?
                   (foil-env:resolve (local-path (_0 pair)) unit)))
               (subject-entry-delta base-subject subject))))
      (Ifz (Sz derived)
        compiler
        (compiler-with-subject
          (set-sut-unit
            (foil-env:extend-own-derived
              (foil-env:make-layer ["derived-own"]
                (map
                  (lambda (pair)
                    (let ((key (_0 pair)))
                      [(local-path key)
                       (foil-env:note-make (_1 pair)
                         (get-span key subject))]))
                  derived))
              unit)
            subject)
          compiler)))))

;; Retain the accumulated source edges in the sealed environment riding
;; the subject, mirroring legacy retain-context-resolutions: the unit
;; envelope built from this subject then exposes them as
;; unit-resolutions.
(define (retain-resolutions compiler)
  (define subject (compiler-subject compiler))
  (define unit (sut-unit subject))
  (define rs (compiler-resolutions compiler))
  (Ifz (Sz rs)
    compiler
    (cond
      ((foil-env:environment? unit)
        (compiler-with-subject
          (set-sut-unit
            (foil-env:environment-with-resolutions
              (Weld (foil-env:environment-resolutions unit) rs)
              unit)
            subject)
          compiler))
      ((foil-env:unit? unit)
        (compiler-with-subject
          (set-sut-unit
            (foil-env:unit-with-resolutions
              (Weld (foil-env:unit-resolutions unit) rs)
              unit)
            subject)
          compiler))
      (else compiler))))

;; elab-mod-diags :: NewCompiler -> ModuleSAST -> [NewCompiler (Row Diag)]
;; Names and signatures are sealed before bodies, so annotated forward and
;; mutually recursive references have the same TC_GLOBAL behavior as the
;; production elaborator.  Every declaration elaborates even when its
;; neighbors fail; the compiler carries poison entries for the failures.
(define (ez lbl v)
  (define h (ZoneStart lbl))
  (Seq h (Seq (DeepSeq v 0) (Seq (ZoneEnd h) v))))

(define (elab-mod-diags compiler mod)
  (define base-subject (compiler-subject compiler))
  ;; %/ references expand structurally at each declaration's own
  ;; namespace position before any pass consumes the bodies.
  (define decls (map expand-decl-crefs (module-declarations mod)))
  (define state0 [compiler (module-scan-diags mod) []])
  (define seeded-types (ez "e-seed-types" (run-pass seed-type-declaration state0 decls)))
  (define refined-types (ez "e-refine-types" (run-pass refine-type-declaration seeded-types decls)))
  (define seeded-values (ez "e-seed-values" (run-pass seed-value-declaration refined-types decls)))
  (define elabbed (ez "e-elab-decls" (run-pass elab-declaration seeded-values decls)))
  (define result (ez "e-wf" (run-pass wf-declaration elabbed decls)))
  [(retain-resolutions
     (extend-derived-environment base-subject (_0 result)))
   (_1 result)])

;; elab-mod :: NewCompiler -> ModuleSAST -> NewCompiler
;; The throwing contract of the production elaborator: one error carrying
;; every diagnostic at once.
(define (elab-mod compiler mod)
  (define r (elab-mod-diags compiler mod))
  (Ifz (Sz (_1 r))
    (_0 r)
    (error ["foil-new-elab-errors" (_1 r)])))

(define (elab-mod-from subject world mod)
  (elab-mod ($NewCompiler subject world []) mod))
