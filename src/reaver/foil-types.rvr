(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind cairn (#module cairn))

;; Kept qualified and dormant for normal contexts.  Profiling contexts are
;; created only by the opt-in compiler in foil-profile.rvr.
(#bind profile-zone (#module profile-zone))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

;;; Type constructors and accessors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define TYPE "type")
;; bottom type
;; TBOT obeys distribution
;; TBAD should not
;; i.e. A | TBOT = A
;; but A | TBAD = TBAD
(define TBOT [TYPE "TBOT"])
;; natural, optionally constant
(define (TNAT cube) [TYPE "TNAT" cube])
(define (type-not-bottom? x[_ tag]) (Ne tag "TBOT"))
;; sum type
;; Canonicalization drops bottoms, sorts the options, and *deliberately*
;; dedups structurally-equal options (a sum offers each alternative once).
(define (TSUM opts)
  (define canon (uniq (sort cmp-total (filter type-not-bottom? opts))))
  (define sz (Sz canon))
  (cond
    ((Eq 1 sz) (_0 canon))
    ((Eq 0 sz) TBOT)
    ;; TODO: walk, flatten
    (else [TYPE "TSUM" canon])))
(define tsum-opts (Ix 2)) ;
;; qualify name in body
(define (TQUA name body) [TYPE "TQUA" name body])
;; A const generic parameter layer: name, its declared type (which may
;; mention sibling tvars), body.  Sits inside the TQUA chain; carries
;; no quantification of its own (the constant's VALUE rides the /ty-ap
;; path, its type does not change) — count-tqua stops at it.
(define (TCQUA name cty body) [TYPE "TCQUA" name cty body])
;; nominal reference, possibly applied
(define (TNOM ref args) [TYPE "TNOM" ref args])
(define tnom-ref (Ix 2))
;; type variable
(define (TVAR idx) [TYPE "TVAR" idx])
;; function
(define (TFUN args ret) [TYPE "TFUN" (Sz args) args ret])
;; is
(define (TSELF x) [TYPE "TSELF" x])
(define tself-val Ix2)
;;
(define (is-tfun? x) (Eq (_1 x) "TFUN")) (define (tfun-ari x) (_2 x))
(define (tfun-args x) (_3 x)) (define (tfun-ret x) (_4 x))

(define (TFAC fac val) [TYPE "TFAC" fac val])
(define tfac-val (Ix 3))
(define (type-row-cstr? cstr) (IsNat cstr))
(define (TROW cstr vals)
  (unless (type-row-cstr? cstr)
    (error ["bad-row-constructor" cstr])
    [TYPE "TROW" cstr vals]))
(define trow-cstr (Ix 2))
(define trow-vals (Ix 3))
(define (TPIN box) [TYPE "TPIN" box])
(define tpin-val (Ix 2))
;; TANY is the *dynamic* type — a deliberate gradual-typing escape
;; hatch, not a lattice element: it nests both ways (see
;; type-nests-span?), refines away in meets, and absorbs in joins.
;; Only builtins should introduce it (FFI boundaries such as eq, the
;; empty-row element type); elaboration must never infer it into a
;; user-written declaration.
(define TANY [TYPE "TANY"])
;; TPAIL is the pail type: the open union of every nominal row type in
;; the namespace, tagged by name — the head of a nominal row value IS
;; the print-path brand of its declaration, so TPAIL dispatches by
;; branded head.  Supertype only (it nests into nothing but TANY), it
;; does not absorb joins of non-members, and — being an open universe —
;; a match on it always requires a fallthrough.  Sums do not inhabit
;; it: a sum value's head is its option tag, not a type path.
(define TPAIL [TYPE "TPAIL"])
;; A declaration brand: print-path cords carry a leading "/" (47),
;; which no variant option tag or bare word does.
(define (branded-cstr? c)
  (And (Nil (Eq 0 c)) (Eq 47 (Mod c 256))))
(define (TTYP typ) [TYPE "TTYP" typ])
(define TBAD [TYPE "TBAD"])
(define (TARR item) [TYPE "TARR" item])

;;; Result helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; data Either = Left a | Right
(define (left x) ("left" x)) (define (right x) ("right" x))
(define (is-left? x) (Eq (Hd x) "left")) (define (is-right? x) (Eq (Hd x) "right"))

;;; /ty-ap paths <-> types ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Specialized generics are encoded as paths (see foil-subject.rvr):
;; the type argument of an application must itself be path-shaped.

(define (path-to-ty p)
  (cond
    ((ty-var-path? p) (TVAR (Ix 1 p)))
    ((ty-val-path? p) (TNAT (Ix 1 p)))
    (else (TNOM p 0))))

;; -> the path for an encodable type argument, 0 otherwise.
(define (ty-to-path t[_ tag])
  (cond
    ((Eq tag "TNOM") (Ifz (Sz (_3 t)) (_2 t) 0))
    ((Eq tag "TVAR") [ty-var-tag (_2 t)])
    ((Eq tag "TNAT") (Ifz (_2 t) ["nat"] [ty-val-tag (_2 t)]))
    (else 0)))

;; Substitute a tvar inside an encoded path's arguments.
(define (subst-path name repl path)
  (Ifz (ty-ap-path? path) path
    (let ((parts (ty-ap-decode path)))
      (Ifz parts path
        (ty-ap-encode
          (map (lambda (p)
                 (cond
                   ((And (ty-var-path? p) (Eq name (Ix 1 p)))
                     (let ((rp (ty-to-path repl))) (Ifz rp p rp)))
                   ((ty-ap-path? p) (subst-path name repl p))
                   (else p)))
            parts))))))

;;; Well-formedness and substitution ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; check-type-wf lives after mold-to-span (its sum check expands
;; options) — see below.

;; Deep search for a TVAR node; fences substitution capture.
(define (type-has-tvar? v x)
  (If (Equal (TVAR v) x) 1
    (If (IsApp x) (any (type-has-tvar? v) x) 0)))

;; Does a path mention /ty-var v?  /ty-ap encodings are FLAT, so the
;; segments must be decoded — a bare Equal search misses them.
(define (path-mentions-var? v p)
  (cond
    ((ty-var-path? p) (Eq v (Ix 1 p)))
    ((ty-ap-path? p)
      (let ((parts (ty-ap-decode p)))
        (Ifz parts 0 (any (path-mentions-var? v) parts))))
    (else 0)))

;; Does a type mention variable v (as a TVAR node or inside a /ty-ap
;; path)?  Drives drop-if-unused for @ / @@ declarations.
(define (type-mentions-var? v x[_ tag])
  (define recur (type-mentions-var? v))
  (cond
    ((Eq tag "TVAR") (Eq (_2 x) v))
    ((Eq tag "TNOM")
      (Or (path-mentions-var? v (_2 x)) (any recur (_3 x))))
    ((Eq tag "TQUA") (And (Nil (Eq (_2 x) v)) (recur (_3 x))))
    ((Eq tag "TCQUA")
      (Or (recur (_3 x))
        (And (Nil (Eq (_2 x) v)) (recur (_4 x)))))
    ((Eq tag "TFUN")
      (Or (any recur (tfun-args x)) (recur (tfun-ret x))))
    ((Eq tag "TROW") (any recur (trow-vals x)))
    ((Eq tag "TSUM") (any recur (tsum-opts x)))
    ((Eq tag "TFAC") (recur (_3 x)))
    ((Eq tag "TPIN") (recur (tpin-val x)))
    ((Eq tag "TSELF") (recur (tself-val x)))
    ((Eq tag "TARR") (recur (_2 x)))
    ((Eq tag "TTYP") (recur (_2 x)))
    (else 0)))

(define (subst-type name repl ty[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (subst-type name repl))
  ;; A structural replacement (an anonymous row, a function type)
  ;; cannot ride a /ty-ap path.  Fall back to the legacy
  ;; args-row TNOM — expansion handles that form — instead of leaving
  ;; the variable as an unsubstituted path residue.
  (define (subst-nom ty)
    (define ref (_2 ty))
    (cond
      ((And (ty-var-path? ref) (Eq name (Ix 1 ref))) repl)
      ((And (ty-ap-path? ref)
         (And (path-mentions-var? name ref) (Ifz (ty-to-path repl) 1 0)))
        (let ((parts (ty-ap-decode ref)))
          (TNOM (Ix 0 parts)
            (map (lambda (p) (recur (path-to-ty p))) (drop 1 parts)))))
      (else (TNOM (subst-path name repl ref) (map recur (_3 ty))))))
  (cond
    ((tag-is "TVAR") (If (Eq (_2 ty) name) repl ty))
    ((tag-is "TFUN") (TFUN (map recur (tfun-args ty)) (recur (tfun-ret ty))))
    ((tag-is "TNOM") (subst-nom ty))
    ((tag-is "TFAC") (TFAC (_2 ty) (recur (_3 ty))))
    ((tag-is "TPIN") (TPIN (recur (tpin-val ty))))
    ((tag-is "TARR") (TARR (recur (_2 ty))))
    ((tag-is "TNAT") ty)
    ((tag-is "TQUA")
      (cond
        ((Eq (_2 ty) name) ty)
        ((type-has-tvar? (_2 ty) repl)
          ;; substituting under this binder would capture repl's variable
          (error ("subst-type capture" (_2 ty) name repl)))
        (else (TQUA (_2 ty) (recur (_3 ty))))))
    ((tag-is "TCQUA")
      ;; the const name lives in the same /ty-var namespace: shadow it,
      ;; but its declared type still specializes by sibling tvars.
      (If (Eq (_2 ty) name)
        (TCQUA (_2 ty) (recur (_3 ty)) (_4 ty))
        (TCQUA (_2 ty) (recur (_3 ty)) (recur (_4 ty)))))
    ((tag-is "TSUM") (TSUM (map recur (_2 ty))))
    ((tag-is "TROW") (TROW (trow-cstr ty) (map recur (trow-vals ty))))
    ((tag-is "TSELF") (TSELF (recur (tself-val ty))))
    ((tag-is "TTYP") (TTYP (recur (_2 ty))))
    ;; Remaining tags (TANY, TBOT, TBAD, TVAR-mismatch, TEXI, ...) are
    ;; leaves with no type children: substitution leaves them unchanged.
    (else ty)))

(define (type-specialize-span f args)
  (Ifz args
    f
    (cond
      ((Eq (_1 f) "TQUA")
        (type-specialize-span
          (subst-type (_2 f) (_0 args) (_3 f))
          (drop 1 args)))
      ((Eq (_1 f) "TFAC")
        (TFAC (_2 f) (type-specialize-span (tfac-val f) args)))
      ((Eq (_1 f) "TSELF")
        (TSELF (type-specialize-span (tself-val f) args)))
      (else (TBAD ["bad-explicit-specialization" f args])))))

;;; Span nesting and type application ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (ty-match name x) (And (Eq (_1 x) "TVAR") (Eq (_2 x) name)))
(define (find-tvar name args) (find-idx (ty-match name) args))
;;; Mold/span conversion ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (name-row-span name span[_ tag])
  (If (Eq tag "TROW")
    ;; Storage identity is unit-qualified, but imported runtime row values were
    ;; already lowered with their declaration-local brand.  Static TNOM edges
    ;; retain the unit pin; only the erased constructor uses the local path so
    ;; matches and constructors agree across a mount.
    (TROW
      (print-path
        (If (unit-qualified-path? name)
          (unit-qualified-path-local name)
          name))
      (trow-vals span))
    span))

;; The arity of a generic: TQUA binders wrapping the type (skipping
;; TFAC/TSELF, mirroring type-specialize-span's traversal).
(define (count-tqua ty[_ tag])
  (cond
    ((Eq tag "TQUA") (Inc (count-tqua (_3 ty))))
    ((Eq tag "TFAC") (count-tqua (tfac-val ty)))
    ((Eq tag "TSELF") (count-tqua (tself-val ty)))
    (else 0)))

;; The const-parameter layers of a generic's type: [[name cty] ...] in
;; declared order (descending through TQUA/TFAC/TSELF).
(define (cqua-pairs ty[_ tag])
  (cond
    ((Eq tag "TQUA") (cqua-pairs (_3 ty)))
    ((Eq tag "TCQUA") (Weld [[(_2 ty) (_3 ty)]] (cqua-pairs (_4 ty))))
    ((Eq tag "TFAC") (cqua-pairs (tfac-val ty)))
    ((Eq tag "TSELF") (cqua-pairs (tself-val ty)))
    (else [])))

(define (count-cqua ty) (Sz (cqua-pairs ty)))

;; Remove the TCQUA layers along the TQUA/TFAC/TSELF spine (the shape
;; consumers see once an instantiation has supplied the constants).
(define (strip-cquas ty[_ tag])
  (cond
    ((Eq tag "TQUA") (TQUA (_2 ty) (strip-cquas (_3 ty))))
    ((Eq tag "TCQUA") (strip-cquas (_4 ty)))
    ((Eq tag "TFAC") (TFAC (_2 ty) (strip-cquas (tfac-val ty))))
    ((Eq tag "TSELF") (TSELF (strip-cquas (tself-val ty))))
    (else ty)))

;; Substitute supplied const-argument paths for the parameter names'
;; /ty-var segments (used after the TCQUA layers strip, so member
;; return types like map[k lt] become ground once lt is supplied).
(define (subst-const-args names cargs typ)
  (foldl (lambda (acc pr) (subst-type (_0 pr) (path-to-ty (_1 pr)) acc))
    typ (zip names cargs)))

(define (wrap-tcquas pairs typ)
  (Ifz (Sz pairs)
    typ
    (TCQUA (_0 (_0 pairs)) (_1 (_0 pairs))
      (wrap-tcquas (drop 1 pairs) typ))))

(define (mold-to-span-seen sut seen ty[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (mold-to-span-seen sut seen))
  (cond
    ((tag-is "TNOM")
      (define ref (tnom-ref ty))
      ;; /ty-ap refs carry their type arguments in the path. The
      ;; arguments substitute into the generic's mold BEFORE expansion
      ;; — the body's recursive references then carry the instantiated
      ;; paths and the seen-cut (keyed on the full encoded path) fires;
      ;; substituting after expansion recurses with the declared tvar
      ;; and never matches seen. Rows are named by the GENERIC (the
      ;; declared row's baked constructor); the arguments live in the
      ;; field types.
      (If (find (Equal ref) seen)
        ty
        (If (ty-ap-path? ref)
          (let* ((parts (ty-ap-decode ref))
                 (gty (got-type ref sut))
                 (nt (count-tqua gty))
                 ;; type args only — const args ride the path but never
                 ;; substitute into the type; the TCQUA layers strip.
                 (rest (drop 1 parts))
                 (cnames (map (Ix 0) (cqua-pairs gty)))
                 (applied-mold
                   (subst-const-args cnames (drop nt rest)
                     (strip-cquas
                       (type-specialize-span gty
                         (map path-to-ty (take (min nt (Sz rest)) rest)))))))
            (name-row-span (Ix 0 parts)
              (mold-to-span-seen sut (snoc ref seen) applied-mold)))
          (let ((stored (got-type ref sut)))
            ;; An entry holding another NOMINAL is an alias link — a
            ;; reference, not a definition: expand to the target's
            ;; span WITHOUT re-branding, so alias and target spans
            ;; stay identical (row cstrs compare by brand).
            (If (And (Eq "TNOM" (_1 stored)) (Ifz (Sz (_3 ty)) 1 0))
              (mold-to-span-seen sut (snoc ref seen) stored)
              (let ((base (mold-to-span-seen sut (snoc ref seen) stored))
                    (applied-args (map recur (_3 ty))))
                (name-row-span ref (type-specialize-span base applied-args))))))))
    ((tag-is "TFUN") (TFUN (map recur (tfun-args ty)) (recur (tfun-ret ty))))
    ((tag-is "TFAC") (TFAC (_2 ty) (recur (tfac-val ty))))
    ((tag-is "TPIN") (TPIN (recur (tpin-val ty))))
    ((tag-is "TSELF") (TSELF (recur (tself-val ty))))
    ((tag-is "TQUA") (TQUA (_2 ty) (recur (_3 ty))))
    ((tag-is "TCQUA") (TCQUA (_2 ty) (recur (_3 ty)) (recur (_4 ty))))
    ((tag-is "TSUM") (TSUM (map recur (tsum-opts ty))))
    ((tag-is "TROW") (TROW (trow-cstr ty) (map recur (trow-vals ty))))
    ((tag-is "TTYP") (TTYP (recur (_2 ty))))
    ((tag-is "TARR") (TARR (recur (_2 ty))))
    (else ty)))

(define (mold-to-span sut ty)
  (mold-to-span-seen sut 0 ty))

;;; Phase-local type-operation context ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; The compiler is pure, so memo tables are threaded explicitly.  Only a
;;; top-level TNOM expansion is cached: recursive expansions depend on their
;;; seen cut and deliberately continue through mold-to-span-seen directly.

;; A phase-local context also carries the resolved source edges accumulated by
;; elaboration.  Keeping that row here reuses the context threading already
;; required by type expansion and subtyping instead of introducing a second
;; state-passing protocol through every value form.
(define (make-type-context sut)
  ["TYCTX" sut 0 cairn:empty-ax [] 0 []])
(define (make-profile-type-context sut)
  ["TYCTX" sut 0 cairn:empty-ax [] 1 []])
(define type-context-sut (Ix 1))
(define type-context-generation (Ix 2))
(define type-context-expansions (Ix 3))
(define type-context-nests (Ix 4))
(define type-context-profiled? (Ix 5))
;; type-context-resolutions :: TypeContext -> Row Resolution
(define (type-context-resolutions ctx)
  (If (Gt (Sz ctx) 6) (Ix 6 ctx) []))
;; type-context-record-resolution :: Resolution -> TypeContext -> TypeContext
(define (type-context-record-resolution resolution ctx)
  (define prior (type-context-resolutions ctx))
  (If (includes (Equal resolution) prior)
    ctx
    (Up 6 (snoc resolution prior) ctx)))

(define (profile-type-context-result ctx label result)
  (If (type-context-profiled? ctx)
    (profile-zone:force-pair-value-zone label result)
    result))

(define (type-context-with-subject ctx sut type-env-changed?)
  (If type-env-changed?
    ["TYCTX" sut (Inc (type-context-generation ctx))
     cairn:empty-ax [] (type-context-profiled? ctx)
     (type-context-resolutions ctx)]
    (snap 1 (lambda (z) sut) ctx)))

(define (mold-to-span-context ctx ty[_ tag])
  ;; The common applied-nominal representation carries every argument in its
  ;; flat /ty-ap reference path.  Legacy TNOMs with a separate args row are
  ;; expanded normally: their structured args are not valid Cairn key segments.
  (define result
    (If (Or (Nil (Eq tag "TNOM")) (Sz (_3 ty)))
      [ctx (mold-to-span (type-context-sut ctx) ty)]
      ;; /ty-ap paths are length-prefixed flat rows, so the entire nominal path
      ;; can safely become Cairn path segments without losing identity.
      (let* ((key (Weld [(type-context-generation ctx) "nom"] (tnom-ref ty)))
             (hit (cairn:getax key (type-context-expansions ctx))))
        (If hit
          [ctx (_0 hit)]
          (let ((span (mold-to-span (type-context-sut ctx) ty)))
            [(snap 3
               (cairn:putax key span) ctx)
             span])))))
  (profile-type-context-result ctx "foil.type.expand" result))

(define (mold-rec-seed ty[_ tag])
  (cond
    ((Eq tag "TNOM") [(tnom-ref ty)])
    ((Eq tag "TFAC") (mold-rec-seed (tfac-val ty)))
    ((Eq tag "TPIN") (mold-rec-seed (tpin-val ty)))
    ((Eq tag "TSELF") (mold-rec-seed (tself-val ty)))
    (else 0)))

(define (type-entry? path sut)
  (Eq (Hd (got-entry-tc path sut)) "TC_TYP"))


;; Coinductive span subtyping: /ty-ap TNOM residues (seen-cuts, join
;; embeddings) unfold on demand, and a revisited (sup, sub) pair is
;; success — the standard equirecursive construction, so unrolling
;; offsets never matter.
(define (type-nests-span? sut seen sup[_ stag] sub[_ subtag])
  (define (recur a b) (type-nests-span? sut seen a b))
  (define (opt-has-sub opt) (recur opt sub))
  (define (sup-has-opt opt) (recur sup opt))
  (define (row-nests? a b)
    (and (Eq (trow-cstr a) (trow-cstr b))
      (and (Eq (Sz (trow-vals a)) (Sz (trow-vals b)))
        (all (uncurry recur)
          (zip (trow-vals a) (trow-vals b))))))
  (define (arr-nests-row? arr row)
    (And (Eq 0 (trow-cstr row))
      (all (recur (_2 arr)) (trow-vals row))))
  (define (law-type? ty)
    (Eq "TFUN" (_1 ty)))
  (define (pin-law-nests? pin other)
    (And (law-type? (tpin-val pin))
      (recur (tpin-val pin) other)))
  ;; Functions: arguments are contravariant (the subtype's parameters
  ;; must accept everything the supertype's do), returns covariant.
  ;; The TFAC cases above make faces transparent on both sides.
  (define (fun-nests? sup sub)
    (and (Eq (tfun-ari sup) (tfun-ari sub))
      (and (all (uncurry (flip recur))
             (zip (tfun-args sup) (tfun-args sub)))
        (recur (tfun-ret sup) (tfun-ret sub)))))
  (define (unfold t)
    (If (Eq (_1 t) "TNOM") (mold-to-span sut t) t))
  (cond
    ((Equal sup sub) 1)
    ((Eq stag "TANY") 1)
    ((Eq subtag "TANY") 1)
    ((Eq subtag "TBOT") 1)
    ((Eq stag "TFAC") (recur (tfac-val sup) sub))
    ((Eq subtag "TFAC") (recur sup (tfac-val sub)))
    ((Or (Eq stag "TNOM") (Eq subtag "TNOM"))
      (let ((key [sup sub]))
        (If (includes (Equal key) seen)
          1
          (type-nests-span? sut (snoc key seen)
            (unfold sup) (unfold sub)))))
    ;; TPAIL: a row inhabits the pail universe iff its cstr is a
    ;; declaration brand.  (TNOM subs unfolded above; sums fall
    ;; through — their options are tagged, not branded.)
    ((Eq stag "TPAIL")
      (And (Eq subtag "TROW") (branded-cstr? (trow-cstr sub))))
    ((And (Eq stag "TPIN") (Eq subtag "TPIN"))
      (recur (tpin-val sup) (tpin-val sub)))
    ((and (Eq stag "TARR") (Eq subtag "TARR"))
      (recur (_2 sup) (_2 sub)))
    ((and (Eq stag "TARR") (Eq subtag "TROW"))
      (arr-nests-row? sup sub))
    ((and (Eq stag "TFUN") (Eq subtag "TFUN")) (fun-nests? sup sub))
    ((and (Eq stag "TROW") (Eq subtag "TROW")) (row-nests? sup sub))
    ;; Sums dispatch before the lone-TPIN pin-law cases: a sum
    ;; supertype must check its options against a pinned subtype
    ;; (pin-law-nests? only understands pinned laws and would veto).
    ((and (Eq stag "TSUM") (Eq subtag "TSUM")) (all sup-has-opt (tsum-opts sub)))
    ((Eq stag "TSUM") (any opt-has-sub (tsum-opts sup)))
    ((Eq subtag "TSUM") (all sup-has-opt (tsum-opts sub)))
    ((Eq stag "TPIN") (pin-law-nests? sup sub))
    ((Eq subtag "TPIN") (pin-law-nests? sub sup))
    ((and (Eq stag "TNAT") (Eq subtag "TNAT"))
      (or (Eq 0 (_2 sup)) (Eq (_2 sup) (_2 sub))))
    (else 0)))

(define (check-type-wf sut x[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (check-type-wf sut))
  (define (check-tfun-args args)
    (define res (filter is-left? (map (check-type-wf sut) args)))
    (Ifz (Sz res) (right 0) (_0 res)))
  (define (type-and x y) (If (is-left? x) x y))
  ;; A nominal ref may be a /ty-var path, a /ty-ap application (whose
  ;; base must be a type of matching arity and whose argument paths must
  ;; themselves be well-formed), or a plain path.
  (define (check-const-arg p)
    (cond
      ((ty-var-path? p)
        (Ifz (sut-get-tvar? (Ix 1 p) sut)
          (left ["unbound const parameter" (Ix 1 p)])
          (right 0)))
      ((ty-val-path? p) (right 0))
      ((Ifz (get-const p sut) 1 0)
        (left ["bad const argument reference" ["path" p]]))
      (else (right 0))))
  (define (check-nom-ref ref)
    (cond
      ((ty-var-path? ref)
        (Ifz (sut-get-tvar? (Ix 1 ref) sut)
          (left ["unbound ty var" (Ix 1 ref)])
          (right 0)))
      ((ty-ap-path? ref)
        (let ((parts (ty-ap-decode ref)))
          (Ifz parts
            (left ["malformed type application path" ["path" ref]])
            (let* ((base (Ix 0 parts))
                   (targs (drop 1 parts)))
              (cond
                ((Nil (get-const base sut))
                  (left ["bad type reference" ["path" base]]))
                ((Nil (type-entry? base sut))
                  (left ["type application of a non-type" ["path" base]]))
                (else
                  ;; type args first, then const args, declared order;
                  ;; consts are values (bound names, literals, declared
                  ;; entries) — elab-spec does the deep cty check with
                  ;; located errors.
                  (let* ((gty (got-type base sut))
                         (nt (count-tqua gty))
                         (nc (count-cqua gty)))
                    (If (Ne (Add nt nc) (Sz targs))
                      (left ["wrong number of type arguments" ["path" ref]
                             "want" (Add nt nc) "got" (Sz targs)])
                      (let* ((bad-t (filter is-left?
                                      (map check-nom-ref (take nt targs))))
                             (bad-c (filter is-left?
                                      (map check-const-arg (drop nt targs)))))
                        (cond
                          ((Sz bad-t) (_0 bad-t))
                          ((Sz bad-c) (_0 bad-c))
                          (else (right 0))))))))))))
      (else
        (Ifz (get-const ref sut)
          (left ["bad type reference" ["path" ref]])
          (right 0)))))
  ;; Lowered match tests dispatch on constructor head + arity only, so a
  ;; sum whose options agree on both is unmatchable — reject at the type.
  (define (strip-fac t)
    (cond
      ((Eq (_1 t) "TFAC") (strip-fac (tfac-val t)))
      ((Eq (_1 t) "TSELF") (strip-fac (tself-val t)))
      (else t)))
  (define (opt-key o)
    (define s (strip-fac (mold-to-span sut o)))
    (If (Eq "TROW" (_1 s))
      ["key" (trow-cstr s) (Sz (trow-vals s))]
      0))
  (define (dup-key keys)
    (Ifz keys 0
      (If (And (_0 keys) (includes (Equal (_0 keys)) (drop 1 keys)))
        (_0 keys)
        (dup-key (drop 1 keys)))))
  (define (check-sum-opts opts)
    (define dup (dup-key (map opt-key opts)))
    (Ifz dup
      (right 0)
      (left ["sum options collide on constructor+arity"
             "cstr" (Ix 1 dup) "arity" (Ix 2 dup)])))
  (cond
    ((tag-is "TVAR")
     (Ifz (sut-get-tvar? (_2 x) sut)
       (left ["unbound ty var" (_2 x)])
       (right 0)))
     ((tag-is "TFUN")
       (type-and (check-tfun-args (tfun-args x)) (recur (tfun-ret x))))
     ((tag-is "TNOM") (check-nom-ref (_2 x)))
     ((tag-is "TFAC") (recur (_3 x)))
     ((tag-is "TPIN") (recur (tpin-val x)))
     ((tag-is "TARR") (recur (_2 x)))
     ((tag-is "TNAT") (right 0))
     ((tag-is "TQUA") (check-type-wf (sut-put-tvar (_2 x) sut) (_3 x)))
     ((tag-is "TCQUA")
       (type-and (recur (_3 x))
         (check-type-wf (sut-put-tvar (_2 x) sut) (_4 x))))
     ((tag-is "TSUM")
       (type-and (check-tfun-args (_2 x)) (check-sum-opts (_2 x))))
     ((tag-is "TROW")
       (type-and
         (If (type-row-cstr? (trow-cstr x))
           (right 0)
           (left ["bad row constructor" (trow-cstr x)]))
         (check-tfun-args (trow-vals x))))
     ((tag-is "TSELF") (recur (tself-val x)))
     ((tag-is "TTYP") (recur (_2 x)))
     ;; Remaining tags (TANY, TBOT, TBAD) are leaves.
     (else (right 0))))

;; Binder names of a generic's TQUA chain, outermost first (skipping
;; faces/self, mirroring count-tqua's traversal).
(define (tqua-names ty[_ tag])
  (cond
    ((Eq tag "TQUA") (Weld [(_2 ty)] (tqua-names (_3 ty))))
    ((Eq tag "TFAC") (tqua-names (tfac-val ty)))
    ((Eq tag "TSELF") (tqua-names (tself-val ty)))
    (else [])))

;; The body under the binders (same unwrap).
(define (tqua-body ty[_ tag])
  (cond
    ((Eq tag "TQUA") (tqua-body (_3 ty)))
    ((Eq tag "TFAC") (tqua-body (tfac-val ty)))
    ((Eq tag "TSELF") (tqua-body (tself-val ty)))
    (else ty)))

;; A recovered argument path must be expandable before the acceptance
;; check expands it: ty-to-path mints ["nat"] from a bare TNAT span and
;; nothing guarantees the subject binds it.
(define (inst-path-ok? sut p)
  (cond
    ((ty-var-path? p) 1)
    ((ty-ap-path? p)
      (let ((parts (ty-ap-decode p)))
        (Ifz parts 0 (all (lambda (q) (inst-path-ok? sut q)) parts))))
    (else
      (Ifz (get-const p sut) 0 (type-entry? p sut)))))

(define (find-exact-name-for-span sut span[_ tag])
  ;; Reject declarations whose stored head cannot possibly recover this
  ;; row/sum.  Transparent nominal aliases remain candidates; generics are
  ;; handled by find-inst-name-for-span below.
  (define (head-ok? path)
    (define decl (got-type path sut))
    (define body (tqua-body decl))
    (define btag (_1 body))
    (And (Eq 0 (count-tqua decl))
      (cond
        ((Eq btag "TNOM") 1)
        ((And (Eq tag "TROW") (Eq btag "TROW"))
          ;; Legacy/raw TC_TYP entries may still store a zero row head;
          ;; nominal expansion brands that head with the declaration path.
          (And (Equal (trow-cstr span)
                 (Ifz (trow-cstr body) (print-path path) (trow-cstr body)))
            (Eq (Sz (trow-vals span)) (Sz (trow-vals body)))))
        ((And (Eq tag "TSUM") (Eq btag "TSUM"))
          (Eq (Sz (tsum-opts span)) (Sz (tsum-opts body))))
        (else 0))))
  (define (matches path)
    (If (Or (Nil (type-entry? path sut)) (Nil (head-ok? path)))
      0
      (Equal span (mold-to-span sut (TNOM path 0)))))
  (If (or (Eq tag "TROW") (Eq tag "TSUM"))
    (find matches (subject-order sut))
    0))

;; An instantiation g[args] has no subject entry (the /ty-ap namespace
;; is virtual), so its expansion needs recovery: for each generic type
;; entry whose declared body head matches the span's shape, unify the
;; generic's SELF-instantiation template (g[v1..vn], tvars in place —
;; the same span gen-accessors' self-ty produces) against the span.
;; Template tvars solve to argument paths; every occurrence must agree;
;; the recovered application must expand back to exactly this span.
;; -> 0 | [encoded-path], boxed like find-exact-name-for-span.
(define (find-inst-name-for-span sut span[_ tag])
  ;; Path of a concrete sub-span standing where a template tvar is:
  ;; leaf paths directly, named/instantiation spans by (recursive)
  ;; recovery.  -> path | 0.
  (define (span-arg-path got)
    ;; Minted leaf paths (ty-to-path's bare ["nat"]) normalize to the
    ;; subject's canonical name so recovered encodings match the
    ;; elaborator's rooted ones.
    (define direct0 (ty-to-path got))
    (define direct (Ifz direct0 0 (canon-path direct0 sut)))
    (define gtag (_1 got))
    (If direct
      direct
      (If (Or (Eq gtag "TSUM")
            (And (Eq gtag "TROW") (Nil (Eq 0 (trow-cstr got)))))
        (let ((exact (find-exact-name-for-span sut got)))
          (Ifz exact
            (let ((rec (find-inst-name-for-span sut got)))
              (Ifz rec 0 (_0 rec)))
            (_0 exact)))
        0)))
  ;; Unify template vs concrete span.  sols: row of [name path];
  ;; -> 0 | [sols].  Strict and symmetric outside tvar positions.
  (define (unify vars tmpl[_ ttag] got[_ gtag] sols)
    (define (var-name t)
      (If (And (Eq "TVAR" (_1 t)) (includes (Eq (_2 t)) vars)) (_2 t) 0))
    (define (bind name path s)
      (define hit (find (lambda (b) (Eq name (_0 b))) s))
      (Ifz hit
        [(snoc [name path] s)]
        (If (Equal path (_1 (_0 hit))) [s] 0)))
    (define (go-row ts gs s)
      (Ifz (Sz ts) [s]
        (let ((r (unify vars (_0 ts) (_0 gs) s)))
          (Ifz r 0 (go-row (drop 1 ts) (drop 1 gs) (_0 r))))))
    (define (go-path tp gp s)
      (define (walk tps gps s1)
        (Ifz (Sz tps) [s1]
          (let ((r (go-path (_0 tps) (_0 gps) s1)))
            (Ifz r 0 (walk (drop 1 tps) (drop 1 gps) (_0 r))))))
      (cond
        ((And (ty-var-path? tp) (includes (Eq (Ix 1 tp)) vars))
          (bind (Ix 1 tp) gp s))
        ((Equal tp gp) [s])
        ((And (ty-ap-path? tp) (ty-ap-path? gp))
          (let ((tparts (ty-ap-decode tp))
                (gparts (ty-ap-decode gp)))
            (cond
              ((Ifz tparts 1 (Ifz gparts 1 0)) 0)
              ((Ne (Sz tparts) (Sz gparts)) 0)
              ((Nil (Equal (Ix 0 tparts) (Ix 0 gparts))) 0)
              (else (walk (drop 1 tparts) (drop 1 gparts) s)))))
        (else 0)))
    (cond
      ((var-name tmpl)
        (let ((p (span-arg-path got)))
          (Ifz p 0 (bind (var-name tmpl) p sols))))
      ((And (Eq ttag "TROW") (Eq gtag "TROW"))
        (If (And (Equal (trow-cstr tmpl) (trow-cstr got))
              (Eq (Sz (trow-vals tmpl)) (Sz (trow-vals got))))
          (go-row (trow-vals tmpl) (trow-vals got) sols)
          0))
      ((And (Eq ttag "TSUM") (Eq gtag "TSUM"))
        ;; Both sides are TSUM-canonical; wf sums order their options
        ;; content-independently (cstr decides, then arity), so
        ;; positional matching aligns.  The acceptance check backstops.
        (If (Eq (Sz (tsum-opts tmpl)) (Sz (tsum-opts got)))
          (go-row (tsum-opts tmpl) (tsum-opts got) sols)
          0))
      ((And (Eq ttag "TNOM") (Eq gtag "TNOM"))
        (go-path (tnom-ref tmpl) (tnom-ref got) sols))
      ((And (Eq ttag "TFAC") (Eq gtag "TFAC"))
        (If (Eq (_2 tmpl) (_2 got))
          (unify vars (tfac-val tmpl) (tfac-val got) sols)
          0))
      ((And (Eq ttag "TPIN") (Eq gtag "TPIN"))
        (unify vars (tpin-val tmpl) (tpin-val got) sols))
      ((And (Eq ttag "TARR") (Eq gtag "TARR"))
        (unify vars (_2 tmpl) (_2 got) sols))
      ((And (Eq ttag "TFUN") (Eq gtag "TFUN"))
        (If (Eq (tfun-ari tmpl) (tfun-ari got))
          (let ((r (go-row (tfun-args tmpl) (tfun-args got) sols)))
            (Ifz r 0 (unify vars (tfun-ret tmpl) (tfun-ret got) (_0 r))))
          0))
      ((Equal tmpl got) [sols])
      (else 0)))
  ;; Cheap shape prefilter on the DECLARED body — cstrs are baked
  ;; constants (name-top-row), and option counts survive substitution
  ;; (wf forbids same-cstr+same-arity options, so none can collapse).
  (define (head-ok? body[_ btag])
    (define (row-key x)
      (define y (If (Eq "TFAC" (_1 x)) (tfac-val x) x))
      (If (Eq "TROW" (_1 y))
        [(trow-cstr y) (Sz (trow-vals y))]
        0))
    (define (sum-shape x)
      (map row-key (tsum-opts x)))
    (cond
      ((And (Eq tag "TROW") (Eq btag "TROW"))
        (And (Equal (trow-cstr span) (trow-cstr body))
          (Eq (Sz (trow-vals span)) (Sz (trow-vals body)))))
      ((And (Eq tag "TSUM") (Eq btag "TSUM"))
        (And (Eq (Sz (tsum-opts span)) (Sz (tsum-opts body)))
          (let ((ss (sum-shape span)) (bs (sum-shape body)))
            (If (Or (any Nil ss) (any Nil bs)) 1 (Equal ss bs)))))
      (else 0)))
  (define (attempt path)
    (define decl (got-type path sut))
    (define vars (tqua-names decl))
    (define (solved sols v)
      (define hit (find (lambda (b) (Eq v (_0 b))) sols))
      (Ifz hit 0 (_1 (_0 hit))))
    (define (accept enc)
      (If (Equal span (mold-to-span sut (TNOM enc 0))) [enc] 0))
    (cond
      ((Eq 0 (Sz vars)) 0)
      ((Nil (head-ok? (tqua-body decl))) 0)
      (else
        (let* ((self-enc
                 (ty-ap-encode
                   (Weld [path] (map (lambda (v) [ty-var-tag v]) vars))))
               (tmpl (mold-to-span sut (TNOM self-enc 0)))
               (res (unify vars tmpl span 0)))
          (Ifz res 0
            (let ((args (map (solved (_0 res)) vars)))
              (If (any Nil args)
                0
                (If (all (lambda (a) (inst-path-ok? sut a)) args)
                  (accept (ty-ap-encode (Weld [path] args)))
                  0))))))))
  (define (scan order)
    (Ifz (Sz order) 0
      (If (Nil (type-entry? (_0 order) sut))
        (scan (drop 1 order))
        (let ((r (attempt (_0 order))))
          (Ifz r (scan (drop 1 order)) r)))))
  (If (Or (Eq tag "TSUM")
        (And (Eq tag "TROW") (Nil (Eq 0 (trow-cstr span)))))
    (scan (subject-order sut))
    0))

(define (find-type-name-for-span sut span)
  (define exact (find-exact-name-for-span sut span))
  (Ifz exact (find-inst-name-for-span sut span) exact))

(define (span-to-mold sut ty[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (span-to-mold sut))
  (define nom (find-type-name-for-span sut ty))
  (Ifz nom
    (cond
      ((tag-is "TROW") (TROW (trow-cstr ty) (map recur (trow-vals ty))))
      ((tag-is "TFUN") (TFUN (map recur (tfun-args ty)) (recur (tfun-ret ty))))
      ((tag-is "TFAC") (TFAC (_2 ty) (recur (tfac-val ty))))
      ((tag-is "TPIN") (TPIN (recur (tpin-val ty))))
      ((tag-is "TSELF") (TSELF (recur (tself-val ty))))
      ((tag-is "TQUA") (TQUA (_2 ty) (recur (_3 ty))))
      ((tag-is "TCQUA") (TCQUA (_2 ty) (recur (_3 ty)) (recur (_4 ty))))
      ((tag-is "TSUM") (TSUM (map recur (tsum-opts ty))))
      ((tag-is "TTYP") (TTYP (recur (_2 ty))))
      ((tag-is "TARR") (TARR (recur (_2 ty))))
      (else ty))
    (TNOM (_0 nom) 0)))

(define (span-to-mold-context ctx span)
  (If (type-context-profiled? ctx)
    (profile-zone:force-zone "foil.type.reverse-recovery"
      (span-to-mold (type-context-sut ctx) span))
    (span-to-mold (type-context-sut ctx) span)))

(define (type-nests? sut sup sub)
  (cond
    ((Equal sup sub) 1)
    ((Eq (_1 sup) "TFAC") (type-nests? sut (tfac-val sup) sub))
    ((Eq (_1 sub) "TFAC") (type-nests? sut sup (tfac-val sub)))
    (else
      ;; The span comparison is coinductive: residual /ty-ap TNOMs
      ;; unfold on demand with a pair memo, so unrolling offsets
      ;; (a join result embedding a cut vs a comparand cut at its own
      ;; top) never matter.
      (type-nests-span? sut []
        (mold-to-span sut sup)
        (mold-to-span-seen sut (mold-rec-seed sup) sub)))))

(define (type-nests-context ctx sup sub)
  ;; Pair keys contain arbitrary type trees.  Pins compare by content hash, so
  ;; the association scan stays shallow instead of repeatedly walking both
  ;; recursive types (Cairn ordering only supports atomic path segments).
  (define key (Pin [(type-context-generation ctx) sup sub]))
  (define hit
    (find (lambda (e) (Equal key (_0 e))) (type-context-nests ctx)))
  (define result
    (If hit
      [ctx (_1 (_0 hit))]
      (let* ((sx (mold-to-span-context ctx sup))
             (ctx1 (_0 sx))
             ;; The RHS cut is relative to the LHS nominal seed.  It is
             ;; intentionally not put in the top-level expansion cache: recursive
             ;; comparisons can reach the same nominal at different cut points.
             (sy (mold-to-span-seen (type-context-sut ctx1)
                   (mold-rec-seed sup) sub))
             (res (type-nests-span? (type-context-sut ctx1) [] (_1 sx) sy)))
        [(snap 4 (snoc [key res]) ctx1) res])))
  (profile-type-context-result ctx "foil.type.nests" result))

(define (type-apply sut f x)
  ;; The first successful occurrence wins, exactly as in the old span
  ;; inference.  A /ty-ap match extracts the actual argument path
  ;; directly, retaining its nominal mold without any reverse lookup.
  (define (first-some xs)
    (define hit (find (lambda (x) x) xs))
    (Ifz hit 0 (_0 hit)))
  (define (infer-path name want got)
    (cond
      ((And (ty-var-path? want) (Eq name (Ix 1 want)))
        [(path-to-ty got)])
      ((And (ty-ap-path? want) (ty-ap-path? got))
        (let ((wps (ty-ap-decode want))
              (gps (ty-ap-decode got)))
          (If (And wps
                (And gps
                  (And (Eq (Sz wps) (Sz gps))
                    (Equal (_0 wps) (_0 gps)))))
            (first-some
              (map (uncurry (infer-path name))
                (zip (drop 1 wps) (drop 1 gps))))
            0)))
      (else 0)))
  ;; Follow a transparent alias before expanding it structurally; an
  ;; alias of g[nat] still carries useful path evidence for g[a].
  (define (alias-target ty[_ tag])
    (If (And (Eq tag "TNOM")
          (And (Nil (ty-ap-path? (tnom-ref ty))) (Ifz (Sz (_3 ty)) 1 0)))
      (let ((stored (got-type (tnom-ref ty) sut)))
        (If (Eq "TNOM" (_1 stored)) stored 0))
      0))
  (define (infer-mold name want got seen)
    (define wtag (_1 want))
    (define gtag (_1 got))
    (define (recur w g) (infer-mold name w g seen))
    (define (expand-nominals)
      (let ((key [want got]))
        (If (includes (Equal key) seen)
          0
          (let ((w1 (If (Eq wtag "TNOM") (mold-to-span sut want) want))
                (g1 (If (Eq gtag "TNOM") (mold-to-span sut got) got)))
            (If (And (Equal want w1) (Equal got g1))
              0
              (infer-mold name w1 g1 (snoc key seen)))))))
    (cond
      ((ty-match name want) [got])
      ((Eq wtag "TFAC") (recur (tfac-val want) got))
      ((Eq gtag "TFAC") (recur want (tfac-val got)))
      ((And (Eq wtag "TPIN") (Eq gtag "TPIN"))
        (recur (tpin-val want) (tpin-val got)))
      ((And (Eq wtag "TFUN") (Eq gtag "TFUN"))
        (first-some
          (Weld
            (map (uncurry recur) (zip (tfun-args want) (tfun-args got)))
            [(recur (tfun-ret want) (tfun-ret got))])))
      ((And (Eq wtag "TROW") (Eq gtag "TROW"))
        (first-some
          (map (uncurry recur) (zip (trow-vals want) (trow-vals got)))))
      ((And (Eq wtag "TARR") (Eq gtag "TARR"))
        (recur (_2 want) (_2 got)))
      ((And (Eq wtag "TARR") (Eq gtag "TROW"))
        (first-some (map (recur (_2 want)) (trow-vals got))))
      ((And (Eq wtag "TNOM") (Eq gtag "TNOM"))
        (Or (infer-path name (tnom-ref want) (tnom-ref got))
          (let ((wa (alias-target want)) (ga (alias-target got)))
            (If (Or wa ga)
              (infer-mold name (Ifz wa want wa) (Ifz ga got ga)
                (snoc [want got] seen))
              (expand-nominals)))))
      ((Or (Eq wtag "TNOM") (Eq gtag "TNOM")) (expand-nominals))
      (else 0)))
  (define (find-inferred name wants gots)
    (first-some
      (map (lambda (pr) (infer-mold name (_0 pr) (_1 pr) []))
        (zip wants gots))))
  ;; Most substitutions take this fast path: a path-shaped inferred
  ;; mold rewrites /ty-var segments in place.  For an anonymous mold,
  ;; expand only a nominal node whose encoded path cannot carry it;
  ;; recursive residues deliberately remain and fail the invariant.
  (define (specialize-inferred name repl ty)
    (define (go seen ty[_ tag])
      (define recur (go seen))
      (cond
        ((Eq tag "TVAR") (If (Eq (_2 ty) name) repl ty))
        ((Eq tag "TFUN")
          (TFUN (map recur (tfun-args ty)) (recur (tfun-ret ty))))
        ((Eq tag "TNOM")
          (let ((direct
                  (TNOM (subst-path name repl (tnom-ref ty))
                    (map recur (_3 ty)))))
            (If (path-mentions-var? name (tnom-ref direct))
              (If (includes (Equal (tnom-ref ty)) seen)
                direct
                (go (snoc (tnom-ref ty) seen) (mold-to-span sut ty)))
              direct)))
        ((Eq tag "TFAC") (TFAC (_2 ty) (recur (tfac-val ty))))
        ((Eq tag "TPIN") (TPIN (recur (tpin-val ty))))
        ((Eq tag "TARR") (TARR (recur (_2 ty))))
        ((Eq tag "TQUA")
          (cond
            ((Eq (_2 ty) name) ty)
            ((type-has-tvar? (_2 ty) repl)
              (error ("subst-type capture" (_2 ty) name repl)))
            (else (TQUA (_2 ty) (recur (_3 ty))))))
        ((Eq tag "TCQUA")
          (If (Eq (_2 ty) name)
            (TCQUA (_2 ty) (recur (_3 ty)) (_4 ty))
            (TCQUA (_2 ty) (recur (_3 ty)) (recur (_4 ty)))))
        ((Eq tag "TSUM") (TSUM (map recur (tsum-opts ty))))
        ((Eq tag "TROW") (TROW (trow-cstr ty) (map recur (trow-vals ty))))
        ((Eq tag "TSELF") (TSELF (recur (tself-val ty))))
        ((Eq tag "TTYP") (TTYP (recur (_2 ty))))
        (else ty)))
    (If (ty-to-path repl) (subst-type name repl ty) (go [] ty)))
  (define (qua-apply apply-go f x)
    (define name (_2 f))
    (define fun (_3 f))
    ;; A multi-variable generic nests its TQUA layers; the argument
    ;; positions for inference live on the TFUN underneath.  Each
    ;; layer resolves against them in turn — specialization keeps the
    ;; inner wrappers, and the recursion (apply-go) strips the next.
    (define (peek-tfun t)
      (cond
        ((Eq (_1 t) "TFUN") t)
        ((Eq (_1 t) "TQUA") (peek-tfun (_3 t)))
        ((Eq (_1 t) "TFAC") (peek-tfun (tfac-val t)))
        ((Eq (_1 t) "TSELF") (peek-tfun (tself-val t)))
        (else 0)))
    (define tfun (peek-tfun fun))
    (unless
      (Truth tfun)
      (TBAD ["too complicated" f x])
      (let ((first-arg (find-tvar name (tfun-args tfun))))
        (define (infer-first-pin)
          (Ifz x 0
            (Ifz (tfun-args tfun) 0
              (let ((want (_0 (tfun-args tfun))) (got (_0 x)))
                (If (And (Eq "TPIN" (_1 want))
                      (And (Eq "TPIN" (_1 got))
                        (ty-match name (tpin-val want))))
                  [(tpin-val got)]
                  0)))))
        (define inferred
          (Or (infer-first-pin)
            (find-inferred name (tfun-args tfun) x)))
        ;; A constant nat widens only when it binds a type variable.
        (define (widen t)
          (If (And (Eq "TNAT" (_1 t)) (_2 t)) (TNAT 0) t))
        (define chosen
          (Ifz first-arg
            (Ifz inferred 0 (widen (_0 inferred)))
            (If (Lt (_0 first-arg) (Sz x))
              (widen (Ix (_0 first-arg) x))
              0)))
        (Ifz chosen
          (Ifz first-arg
            (TBAD ["failed to resolve polymorphism by arguments, please specify"
                   f x])
            (TBAD ["polymorphism not first arg" f x]))
          (let ((specialized (specialize-inferred name chosen fun)))
            ;; The replacement may itself be an identically named
            ;; variable from an enclosing generic.  That occurrence is
            ;; valid after this TQUA disappears; only a newly retained
            ;; name signals an unencodable substitution residue.
            (If (And (Nil (type-mentions-var? name chosen))
                  (type-mentions-var? name specialized))
              (TBAD ["failed to materialize inferred polymorphism"
                     name chosen fun])
              (apply-go specialized x)))))))
  ;; Everything else applies at the MOLD level: arguments are checked
  ;; with type-nests? (span comparison inside, robust to expansion
  ;; asymmetry) and the result is the fun's *declared* return mold —
  ;; span-roundtripping the return denormalizes parameterized nominal
  ;; types.
  (define (go f x)
    (Ifz x f
      (let ((tag (_1 f)))
        (cond
          ((Eq tag "TQUA") (qua-apply go f x))
          ((Eq tag "TFAC") (go (tfac-val f) x))
          ((Eq tag "TPIN")
            (If (Eq "TFUN" (_1 (tpin-val f)))
              (go (tpin-val f) x)
              (TBAD ["pinned non-law apply" f x])))
          ((Eq tag "TSELF") (go (tself-val f) x))
          ((Eq tag "TFUN")
            (If (type-nests? sut (_0 (tfun-args f)) (_0 x))
              (go (If (Eq 1 (Sz (tfun-args f)))
                    (tfun-ret f)
                    (TFUN (drop 1 (tfun-args f)) (tfun-ret f)))
                (drop 1 x))
              (TBAD ["nest-fail" (_0 (tfun-args f)) (_0 x)])))
          ((Eq tag "TBAD") f)
          (else (TBAD ["weird apply" f x]))))))
  (go f x))

(define (type-specialize sut f args)
  (type-specialize-span f args))

;;; Joins, meets, and fit checks ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; type union
(define (type-join-span sut x[_ xtag] y[_ ytag])
  (define (homo-join tag x y)
    (define (tag-is z) (Eq tag z))
    (cond
      ((tag-is "TNAT") (TNAT 0))
      ((tag-is "TSUM")
       (TSUM (Weld (tsum-opts x) (tsum-opts y))))
      ((And (tag-is "TROW")
         (And (Eq (trow-cstr x) (trow-cstr y))
           (Eq (Sz (trow-vals x)) (Sz (trow-vals y)))))
        (TROW (trow-cstr x)
          (map (uncurry (type-join-span sut)) (zip (trow-vals x) (trow-vals y)))))
      ((tag-is "TARR")
        (TARR (type-join-span sut (_2 x) (_2 y))))
      (else (TSUM [x y]))))
  (define (flat-sum sum[_ _ opts] other)
    (TSUM (snoc other opts)))
  (cond
    ((Equal x y) x)
    ;; TANY (dynamic) absorbs in joins.
    ((Eq xtag "TANY") x)
    ((Eq ytag "TANY") y)
    ;; TPAIL absorbs joins with its members only; non-members fall
    ;; through to a genuine sum.
    ((And (Eq xtag "TPAIL") (type-nests-span? sut [] x y)) x)
    ((And (Eq ytag "TPAIL") (type-nests-span? sut [] y x)) y)
    ((Eq xtag "TFAC") (type-join-span sut (tfac-val x) y))
    ((Eq ytag "TFAC") (type-join-span sut x (tfac-val y)))
    ((And (Eq xtag "TPIN") (Eq ytag "TPIN"))
      (TPIN (type-join-span sut (tpin-val x) (tpin-val y))))
    ((Eq xtag ytag) (homo-join xtag x y))
    ((Eq xtag "TSUM") (flat-sum x y))
    ((Eq ytag "TSUM") (flat-sum y x))
    (else (TSUM [x y]))))

;; Identical molds join to themselves — the span roundtrip is lossy for
;; parameterized nominal types (span-to-mold's name recovery only
;; matches unparameterized ones), so avoid it when there is nothing to
;; join.
(define (type-join sut x y)
  (cond
    ((Equal x y) x)
    ;; Bottom is the join identity (elab-case seeds its arm fold with
    ;; TBOT when there is no fallthrough).
    ((Eq (_1 x) "TBOT") y)
    ((Eq (_1 y) "TBOT") x)
    (else
      (let* ((xs (mold-to-span sut x))
             (ys (mold-to-span sut y))
             (joined (type-join-span sut xs ys))
             (is-x (Equal joined xs))
             (is-y (Equal joined ys)))
        (cond
          ((And is-x (Nil is-y)) x)
          ((And is-y (Nil is-x)) y)
          (else (span-to-mold sut joined)))))))

(define (type-join-context ctx x y)
  (define result
    (cond
      ((Equal x y) [ctx x])
      ((Eq (_1 x) "TBOT") [ctx y])
      ((Eq (_1 y) "TBOT") [ctx x])
      (else
        (let* ((xr (mold-to-span-context ctx x))
               (yr (mold-to-span-context (_0 xr) y))
               (ctx1 (_0 yr))
               (xs (_1 xr))
               (ys (_1 yr))
               (joined (type-join-span (type-context-sut ctx1) xs ys))
               (is-x (Equal joined xs))
               (is-y (Equal joined ys)))
          [ctx1
           (cond
             ((And is-x (Nil is-y)) x)
             ((And is-y (Nil is-x)) y)
             (else (span-to-mold-context ctx1 joined)))]))))
  (profile-type-context-result ctx "foil.type.join" result))

;; type intersection
(define (type-meet-span sut x[_ xtag] y[_ ytag])
  (define (homo-meet tag x y)
    (define (tag-is z) (Eq tag z))
    (cond
      ;; (TNAT 0) is the whole nat span; a nonzero cube is that constant.
      ;; Equal cubes are caught by the Equal case above, so two distinct
      ;; constants meet at bottom.
      ((tag-is "TNAT")
        (cond
          ((Eq 0 (_2 x)) y)
          ((Eq 0 (_2 y)) x)
          (else TBOT)))
      ((tag-is "TSUM") (TSUM (intersect Equal (tsum-opts x) (tsum-opts y))))
      ((And (tag-is "TROW")
         (And (Eq (trow-cstr x) (trow-cstr y))
           (Eq (Sz (trow-vals x)) (Sz (trow-vals y)))))
        (TROW (trow-cstr x)
          (map (uncurry (type-meet-span sut)) (zip (trow-vals x) (trow-vals y)))))
      ((tag-is "TARR")
        (TARR (type-meet-span sut (_2 x) (_2 y))))
      (else TBOT)))
  (define (distr-sum sum[_ _ opts] other)
    (TSUM (map (type-meet-span sut other) opts)))
  (define (distr-face face[_ _ face val] other)
    (TFAC face (type-meet-span sut val other)))
    (Force (cond
    ((Equal x y) x)
    ;; TANY (dynamic) refines away in meets.
    ((Eq xtag "TANY") y)
    ((Eq ytag "TANY") x)
    ;; TPAIL refines to its member on the other side.
    ((And (Eq xtag "TPAIL") (type-nests-span? sut [] x y)) y)
    ((And (Eq ytag "TPAIL") (type-nests-span? sut [] y x)) x)
    ((And (Eq xtag "TPIN") (Eq ytag "TPIN"))
      (TPIN (type-meet-span sut (tpin-val x) (tpin-val y))))
    ((Eq xtag ytag) (homo-meet xtag x y))
    ((Eq xtag "TFAC") (distr-face x y))
    ((Eq ytag "TFAC") (distr-face y x))
    ((Eq xtag "TSUM") (distr-sum x y))
    ((Eq ytag "TSUM") (distr-sum y x))
    (else TBOT))))

;; Meet using already-expanded operands.  The pair return lets match
;; elaboration reuse the narrowed span for runtime keys and exhaustiveness.
(define (type-meet-expanded-go sut profiled? x xspan y yspan)
  (define nests-xy (type-nests-span? sut [] xspan yspan))
  (define nests-yx (type-nests-span? sut [] yspan xspan))
  (cond
    ((Eq (_1 x) "TANY") [y yspan])
    ((Eq (_1 y) "TANY") [x xspan])
    ((And nests-xy nests-yx)
      (cond
        ((Equal x y) [x xspan])
        ((And (Eq (_1 x) "TFAC") (Eq (_1 y) "TFAC"))
          (type-meet-expanded-go sut profiled?
            (tfac-val x)
            (If (Eq "TFAC" (_1 xspan)) (tfac-val xspan) xspan)
            (tfac-val y)
            (If (Eq "TFAC" (_1 yspan)) (tfac-val yspan) yspan)))
        ((Eq (_1 y) "TFAC") [y yspan])
        (else [x xspan])))
    (nests-xy [y yspan])
    (nests-yx [x xspan])
    (else
      (let ((span (type-meet-span sut xspan yspan)))
        [(If profiled?
           (profile-zone:force-zone "foil.type.reverse-recovery"
             (span-to-mold sut span))
           (span-to-mold sut span))
         span]))))

(define (type-meet-expanded sut x xspan y yspan)
  (type-meet-expanded-go sut 0 x xspan y yspan))

;; When one side nests in the other, the meet IS the nested mold — and
;; keeping the nominal mold matters: the span roundtrip denormalizes
;; parameterized nominal types (span-to-mold's name recovery only
;; matches unparameterized ones), which poisons everything derived from
;; the result (match-arm locals, their faces, applications of them).
(define (type-meet sut x y)
  ;; Keep the old cheap mold-level cases ahead of any forward expansion.
  ;; These dominate face-heavy elaboration and are also the strongest form of
  ;; operand identity preservation.
  (cond
    ((Equal x y) x)
    ((Eq (_1 x) "TANY") y)
    ((Eq (_1 y) "TANY") x)
    ((And (Eq (_1 x) "TFAC") (Eq (_1 y) "TFAC"))
      (type-meet sut (tfac-val x) (tfac-val y)))
    ((And (Eq (_1 x) "TFAC") (Equal (tfac-val x) y)) x)
    ((And (Eq (_1 y) "TFAC") (Equal x (tfac-val y))) y)
    (else
      (_0 (type-meet-expanded sut x (mold-to-span sut x) y
            (mold-to-span-seen sut (mold-rec-seed x) y))))))

(define (type-meet-context ctx x y)
  (define result
    (let* ((xr (mold-to-span-context ctx x))
           (ctx1 (_0 xr))
           ;; As in type-nests-context, this expansion's recursive cut depends on
           ;; the opposite operand and therefore stays local to the comparison.
           (ys (mold-to-span-seen (type-context-sut ctx1) (mold-rec-seed x) y))
           (res (type-meet-expanded-go (type-context-sut ctx1)
                  (type-context-profiled? ctx1) x (_1 xr) y ys)))
      [ctx1 res]))
  (profile-type-context-result ctx "foil.type.meet" result))

(define (fits-err err)
  (1 [err]))
(define (fits-weld a[ae] b[be])
  (1 (Weld ae be)))
(define (fits-or a b)
  (Ifz a 0 b))
(define (fits-and a b)
  (Ifz a b
    (Ifz b a
      (fits-weld a b))))
(define (type-fits-span sut ty[_ tag] val)
  (define (tag-is x) (Eq x tag))
  (define recur (type-fits-span sut))
  (define recur-row (uncurry (type-fits-span sut)))
  (define (law-like? x)
    (Or (IsLaw x)
      (And (IsPin x) (IsLaw (Unpin x)))))
  (define (fun-fits ty val)
    (Ifz (law-like? val)
      (fits-err "not law")
      0))
  (define (pin-fits inner val)
    (If (And (Eq "TFUN" (_1 inner)) (law-like? val))
      (fun-fits inner val)
      (Ifz (IsPin val)
        (fits-err "not pin")
        (recur inner (Unpin val)))))
  (define (row-fits cstr tys val)
    (cond
      ((And (Eq 0 (Sz tys)) (Eq cstr val)) 0)
      ((Nil (IsApp val)) (fits-err "fit row into bottom"))
      ((Ne cstr (Hd val)) (fits-err "bad type constructor"))
      ((Ne (Sz tys) (Sz val)) (fits-err "fit row into bad size"))
      (else (foldr fits-and 0 (map recur-row (zip tys val))))))
  (define (arr-fits item val)
    (cond
      ((Nil (is-row? val)) (fits-err "not row"))
      (else (foldr fits-and 0 (map (recur item) val)))))
  (cond
    ((tag-is "TBOT") (fits-err "nothing fits bottom"))
    ((tag-is "TROW") (row-fits (trow-cstr ty) (trow-vals ty) val))
    ((tag-is "TNOM") (recur (mold-to-span sut ty) val))
    ((tag-is "TFAC") (recur (tfac-val ty) val))
    ((tag-is "TPIN") (pin-fits (tpin-val ty) val))
    ((tag-is "TFUN") (fun-fits ty val))
    ((tag-is "TARR") (arr-fits (_2 ty) val))
    ((tag-is "TSUM")
      (foldl fits-or
             (fits-err "fell through sum")
             (map recur-row (late-zip val (tsum-opts ty)))))
    ((tag-is "TNAT") (If (IsNat val) 0 (fits-err "not nat")))
    ;; A pail value carries a branded head: an app headed by a
    ;; print-path cord, or (arity-0 rows) the bare brand itself.
    ((tag-is "TPAIL")
      (If (Or (And (IsApp val) (branded-cstr? (Hd val)))
            (And (IsNat val) (branded-cstr? val)))
        0
        (fits-err "not a pail (unbranded head)")))
    (else (fits-err ["fallthrough uimpl" tag]))))

(define (type-fits sut ty val)
  (type-fits-span sut (mold-to-span sut ty) val))

;;; Shallow runtime fit checks ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Typed Reaver uses these at an untyped/typed boundary.  Unlike type-fits,
;; this checks only the outer constructor of a value: it never walks row
;; elements or wraps a nested function.  Nominals expand only far enough to
;; discover that outer constructor.

(define (type-shape-fits-span sut ty[_ tag] val)
  (define (tag-is x) (Eq x tag))
  (define recur (type-shape-fits-span sut))
  (define (law-like? x)
    (Or (IsLaw x)
      (And (IsPin x) (IsLaw (Unpin x)))))
  (define (row-shape cstr tys)
    (cond
      ((And (Eq 0 (Sz tys)) (Eq cstr val)) 0)
      ((Nil (IsApp val)) (fits-err "not row"))
      ((Ne cstr (Hd val)) (fits-err "bad type constructor"))
      ((Ne (Sz tys) (Sz val)) (fits-err "bad row size"))
      (else 0)))
  (cond
    ((tag-is "TANY") 0)
    ((tag-is "TVAR") 0)
    ((tag-is "TBOT") (fits-err "nothing fits bottom"))
    ((tag-is "TBAD") (fits-err "invalid expected type"))
    ((tag-is "TNAT") (If (IsNat val) 0 (fits-err "not nat")))
    ((tag-is "TFUN") (If (law-like? val) 0 (fits-err "not law")))
    ((tag-is "TPIN") (If (IsPin val) 0 (fits-err "not pin")))
    ((tag-is "TARR") (If (is-row? val) 0 (fits-err "not row")))
    ((tag-is "TROW") (row-shape (trow-cstr ty) (trow-vals ty)))
    ((tag-is "TSUM")
      (foldl fits-or (fits-err "fell through sum")
        (map (lambda (opt) (recur opt val)) (tsum-opts ty))))
    ((tag-is "TNOM") (recur (mold-to-span sut ty) val))
    ((tag-is "TFAC") (recur (tfac-val ty) val))
    ((tag-is "TSELF") (recur (tself-val ty) val))
    ((tag-is "TQUA") (recur (_3 ty) val))
    ((tag-is "TCQUA") (recur (_4 ty) val))
    ((tag-is "TTYP") (recur (_2 ty) val))
    ((tag-is "TPAIL")
      (If (Or (And (IsApp val) (branded-cstr? (Hd val)))
            (And (IsNat val) (branded-cstr? val)))
        0
        (fits-err "not a pail (unbranded head)")))
    (else (fits-err ["shape-check uimpl" tag]))))

(define (type-shape-fits sut typ val)
  (type-shape-fits-span sut (mold-to-span sut typ) val))

;;; Subject insertion and type AST conversion ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tc-poison
  (tc "POISON" TBAD))
(define (tc-ttyp typ)
  (tc-typ (TTYP typ)))
;; Quantifiers are transparent to naming: a generic row declaration
;; (TQUA v (TROW ...)) is still nominally the declared constructor.
(define (name-top-row key typ[_ tag])
  (cond
    ((Eq tag "TROW") (TROW (print-path key) (trow-vals typ)))
    ((Eq tag "TQUA") (TQUA (_2 typ) (name-top-row key (_3 typ))))
    ((Eq tag "TCQUA") (TCQUA (_2 typ) (_3 typ) (name-top-row key (_4 typ))))
    (else typ)))
(define (insert-typ key span typ sut)
  (define ent (make-tc-entry key span (tc-ttyp (name-top-row key typ))))
  (insert-entry-sut key ent sut))

(define (insert-typ-ffi key typ sut)
  (insert-typ key wack-span typ sut))

;;; Row face helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (collect-faces items)
  (define (go acc[idx ls] arg[_ tag face ty])
    [(Inc idx)
    (unless (Eq tag "TFAC")
      ls
      (snoc [idx face ty] ls))])
  (_1 (foldl go [0 0] items)))

