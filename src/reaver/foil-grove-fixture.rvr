;;;; One explicitly selected system and local publisher for Grove fixtures.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind abi (#module foil-abi))
(define (root name) [["x" 17] ["ts" "lib"] ["ts" name]])
(define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
(define (create ignored)
  (define system (bootstrap:build-system (Pin "grove-fixture/v3") root slot))
  (define local (bootstrap:build-local ("x" 17) system root slot
    ["grove_backend" "grove_role_runtime" "tests/grove_backend"]))
  [(_0 local) (_1 local) system])
(define (module code name)
  (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_2 code))))))
(define (qualified path)
  (If (Sz path)
    (If (Or (Eq "x" (Hd (_0 path))) (Equal ("ts" "sys") (_0 path)))
      path (Weld [("x" 17)] path))
    [("x" 17)]))
(define (lookup local records path)
  (define helpers (module (_1 local) "tests/grove_backend"))
  (define actual
    (If (Equal [("ts" "codecs")] (take 1 path))
      (Weld [("x" 17) ("ts" "lib") ("ts" "grove") ("ts" "types")]
        (drop 1 path)) (qualified path)))
  ((driver:get-perc ["grove_backend_checks" "lookup_namespace"] helpers)
    (_0 local) records actual))
(define (record local records path) (_0 (lookup local records path)))
(define (previous path) 0)
(define (boot local)
  (bootstrap:build-local ("x" 17) (_2 local) root slot
    ["tests/grove_install" "tests/grove_publication"]))
(#export create module qualified lookup record previous boot)
