;;;; Native transport adapter for the Foil outbound HTTP driver.
;;;; Scheduling, deduplication, ack state, and namespace writes live in
;;;; foil/helm_fetch.foil. These callbacks implement its typed fetch_ports.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind http-client (#module http-client))
(#import http-client)
(#bind helm (#module helm))

;; The native Fetch ABI uses bars. The typed driver uses decoded atom slots,
;; matching the existing request/response records in the namespace.
(define (join-hdrs hs)
  (strcat (map (lambda (h) (strcat [(_0 h) ": " (_1 h) (strWeld 13 10)])) hs)))

(define (typed-result r)
  (If (fetch-ok? r)
    ("/boot/fetch_result/ok" (res-status r) (res-url r)
      (join-hdrs (res-headers r)) (res-body r))
    ("/boot/fetch_result/err" (fetch-err r))))

(define (native-request request)
  [(mk-req (_0 request) (_1 request) (_2 request) (_3 request))
   (mk-cfg (Ix 4 request) (Ix 5 request) (Ix 6 request) (Ix 7 request))])

(define (fetch-actor request kid self)
  (define mc (Recv 0))
  (define worker (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define transfer (native-request request))
  (define message ("/boot/fetch_event/done" kid
    (typed-result (Fetch (_0 transfer) (_1 transfer)))))
  (Seq worker (DeepSeq message (Send worker message))))

(define (receive-event z)
  (define msg (Ix 0 (Recv 0)))
  (If (Eq (Hd msg) "/boot/fetch_event/done") msg
    (let ((event (helm:driver-message msg)))
      (If event ("/boot/fetch_event/helm" event) (receive-event z)))))

;; run is the compiled fetch_driver/run entry, not an indexed helper table.
(define (mk-fetch-worker run name self)
  (define mc (Recv 0))
  (define coord (Seq (DeepSeq mc mc) (Ix 0 (Ix 1 mc))))
  (define initial (helm:driver-message (Ix 0 mc)))
  (define (send message) (DeepSeq message (SendCaps coord message [0])))
  (define (start kid request)
    (DeepSeq request
      (let ((actor (Spawn (fetch-actor request kid))))
        (SendCaps actor ["go"] [0]))))
  (define (failed kid) (Trace ["fetch: cmd failed" kid] 0))
  (define ports ("/boot/fetch_ports" receive-event send start failed))
  (Seq coord (run ports name initial)))

;; Compile adapter paths in MAIN without invoking Fetch or receiving a message.
(define (warm z)
  (DeepSeq [receive-event fetch-actor mk-fetch-worker
    (helm:driver-message ["die"])
    (typed-result (0 [200 (mk-bar "url") [[(mk-bar "X") (mk-bar "y")]] (mk-bar "body")]))
    (native-request ("/boot/fetch_request" "GET" "url" [] 0 0 30000 0 1048576))]
    0))
