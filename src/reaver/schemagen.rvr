;;;; schemagen: JSON schema -> foil types + serde, compiled with no
;;;; source text at all.  The schema (parsed by json.foil) maps to a
;;;; typedef IR, the IR emits NORMALIZED REX directly (Leaf/Nest/Juxt
;;;; with inert zero spans — the structure refactor made spans pure
;;;; diagnostics), and the tree feeds foil:compile-rex.  A human view
;;;; is a printer concern, not a compilation artifact.
;;;;
;;;; v1 subset: records (object + required/optional -> maybe), string/
;;;; integer/boolean fields, arrays of prims/refs, #/$defs/<n> refs
;;;; (topo-sorted, cycles rejected), string enums -> sums.  Rejected
;;;; loudly: floats ("number"), inline objects/enums (hoist to $defs),
;;;; nested arrays, oneOf (v2 - rides the enum machinery).

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

;;; json value access (reps probed 2026-07-28: cstr-headed apps,
;;; brands "/boot/json/<v>", fields from Ix 0) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (sg-error why what) (error ["schemagen" why what]))

(define (jv? tag v) (And (IsApp v) (Eq tag (Hd v))))
(define (jv-obj? v) (jv? "/boot/json/obj" v))
(define (jv-str? v) (jv? "/boot/json/str" v))
(define (jv-arr? v) (jv? "/boot/json/arr" v))

(define (jv-str! v)
  (Ifz (jv-str? v) (sg-error "expected-string" v) (Ix 0 v)))
(define (jv-kvs v) (Ix 0 v))
(define (jv-xs! v)
  (Ifz (jv-arr? v) (sg-error "expected-array" v) (Ix 0 v)))

;; The value at key k: 0 or [val].
(define (jv-get k v)
  (Ifz (jv-obj? v) 0
    (let ((hit (find (lambda (e) (Eq k (Ix 0 e))) (jv-kvs v))))
      (Ifz hit 0 [(Ix 1 (_0 hit))]))))

;;; Names ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (sg-word-byte? c)
  (Or (And (Ge c 97) (Le c 122))
    (Or (Eq c 95) (And (Ge c 48) (Le c 57)))))

(define (sg-sane-name? s)
  (define cs (trip s))
  (And (Sz cs)
    (And (And (Ge (_0 cs) 97) (Le (_0 cs) 122))
      (all sg-word-byte? cs))))

;; The import surface (json + the generated prelude) a schema name must
;; not shadow.  Generated per-type names (T_r, T_from, T_to, d_*, r_*)
;; are prefixed or suffixed away from single-word schema names.
(define sg-reserved
  ["jres" "json" "jkv" "jnull" "cat2" "snoc8" "show_nat" "ws" "lit"
   "digit" "hexv" "hexd" "hex2" "utf8" "hex4" "esc2" "p_str" "p_num"
   "p_arr" "p_obj" "p_val" "parse" "show_str" "show" "rt" "run_cat"
   "jget" "jpath" "jidx" "maybe" "bool" "nat" "row" "ok" "err"
   ;; sept's cord vocabulary, which json now imports
   "cord" "digit_byte"
   ;; builtins json now leans on
   "list" "list_row" "nil" "cons" "load8" "loadvar"])

(define (sg-check-name s)
  (Ifz (sg-sane-name? s) (sg-error "bad-name (want [a-z][a-z0-9_]*)" s)
    (If (includes (Eq s) sg-reserved) (sg-error "reserved-name" s) s)))

(define (dedupe-eq xs)
  (foldl (lambda (acc x) (If (includes (Eq x) acc) acc (snoc x acc))) [] xs))

;;; Name normalization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Real-world specs name types in PascalCase and operations in
;;; camelCase; foil wants [a-z][a-z0-9_]*.  Normalization is a
;;; MAPPING, not a check: the same function must run on schema keys
;;; and on $ref targets so the two agree, and the caller must assert
;;; the mapping stays injective (sg-name-map).

(define (sg-upper? c) (And (Ge c 65) (Le c 90)))
(define (sg-lower? c) (And (Ge c 97) (Le c 122)))
(define (sg-digit? c) (And (Ge c 48) (Le c 57)))
(define (sg-alnum? c) (Or (sg-lower? c) (Or (sg-upper? c) (sg-digit? c))))
(define (sg-to-lower c) (If (sg-upper? c) (Add c 32) c))

;; "AABenchmarkEntry" -> "aabenchmark_entry"; "jobId" -> "job_id";
;; "text/event-stream" -> "text_event_stream".  A leading digit is
;; left in place for sg-check-name to reject.
(define (sg-norm-name s)
  (define cs (trip s))
  (define n (Sz cs))
  ;; lowercase, break at lower|digit -> upper boundaries, non-alnum -> _
  (define (emit i acc)
    (If (Ge i n) acc
      (let* ((c (Ix i cs))
             (prev (If (Eq i 0) 0 (Ix (Dec i) cs))))
        (cond
          ((Ifz (sg-alnum? c) 1 0) (emit (Inc i) (Weld acc [95])))
          ((And (sg-upper? c) (Or (sg-lower? prev) (sg-digit? prev)))
            (emit (Inc i) (Weld acc [95 (sg-to-lower c)])))
          (else (emit (Inc i) (Weld acc [(sg-to-lower c)])))))))
  (define raw (emit 0 []))
  ;; collapse runs of _ and drop leading ones
  (define (clean i acc)
    (If (Ge i (Sz raw)) acc
      (let ((c (Ix i raw)))
        (If (Eq c 95)
          (If (Ifz (Sz acc) 1 0) (clean (Inc i) acc)
            (If (Eq 95 (Ix (Dec (Sz acc)) acc)) (clean (Inc i) acc)
              (clean (Inc i) (Weld acc [c]))))
          (clean (Inc i) (Weld acc [c]))))))
  (define body (clean 0 []))
  ;; drop a trailing _
  (define trimmed
    (Ifz (Sz body) body
      (If (Eq 95 (Ix (Dec (Sz body)) body)) (take (Dec (Sz body)) body) body)))
  (strcat trimmed))

;; Normalize AND validate: the name a generated module will use.
(define (sg-name s) (sg-check-name (sg-norm-name s)))

;; [[orig norm] ..] for a row of source names, asserting injectivity —
;; two schemas that normalize alike would silently merge.
(define (sg-name-map names)
  (define pairs (map (lambda (s) [s (sg-norm-name s)]) names))
  (define norms (map (lambda (p) (Ix 1 p)) pairs))
  (define dups
    (filter (lambda (nm) (Gt (Sz (filter (Eq nm) norms)) 1)) (dedupe-eq norms)))
  (Ifz (Sz dups) pairs (sg-error "name-collision after normalization" dups)))

(define (nat-str n)
  (If (Lt n 10) (Add "0" n)
    (strcat [(nat-str (Div n 10)) (Add "0" (Mod n 10))])))

;; Double every quote byte for embedding in a foil cord literal.
(define (dq-escape s)
  (strcat
    (map (lambda (c) (If (Eq c 34) (strcat [34 34]) c))
      (trip s))))

;;; Schema -> typedef IR ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; ftype:   ["str"] ["int"] ["bool"] ["ref" name] ["row" ftype]
;;; field:   [name ftype req]
;;; typedef: ["rec" name fields] | ["enum" name [[vname wire] ..]]

(define (sg-strip-prefix pre s)
  ;; 0 when s lacks the prefix, [tail] otherwise
  (define w (Lsh 1 (Mul 8 (Bytes pre))))
  (If (Eq pre (Mod s w)) [(Div s w)] 0))

;; The three spellings of "a named schema in this document": JSON
;; Schema $defs, Swagger 2.0 definitions, OpenAPI 3.x components.
(define sg-ref-prefixes
  ["#/$defs/" "#/definitions/" "#/components/schemas/"])

;; -> the bare target name (errors on an unrecognized $ref shape)
(define (sg-ref-target s)
  (define hit
    (foldl (lambda (acc pre) (Ifz acc (sg-strip-prefix pre s) acc))
      0 sg-ref-prefixes))
  (Ifz hit (sg-error "bad-ref (want #/$defs/, #/definitions/ or #/components/schemas/)" s)
    (_0 hit)))

;; -> 0 when v is not a $ref, else [target] (the wrapped shape callers expect)
(define (sg-ref-name v)
  (define r (jv-get "$ref" v))
  (Ifz r 0 [(sg-ref-target (jv-str! (_0 r)))]))

;;; allOf, and schemas that are only aliases ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Many named schemas are not types in their own right: a bare $ref, a
;;; $ref wrapped in allOf so prose can hang off it (59 of this
;;; document's 95 allOf sites are exactly that), an array of something
;;; else, a bare string.  Minting a nominal foil type for each would
;;; produce hundreds of one-field wrappers that callers then have to
;;; convert between, all of them structurally identical.  They are
;;; ALIASES: nothing is emitted, and every reference resolves through.
;;;
;;; The allOf sites that DO add something are single inheritance —
;;; base plus extra fields — and get merged.  `required` merges
;;; separately from `properties`, because a branch may add no field at
;;; all and only promote one it inherited.

(define (sg-allof v)
  (define r (jv-get "allOf" v))
  (Ifz r [] (jv-xs! (_0 r))))

(define (sg-props-of v)
  (define r (jv-get "properties" v))
  (Ifz r [] (jv-kvs (_0 r))))

(define (sg-reqs-of v)
  (define r (jv-get "required" v))
  (Ifz r [] (map jv-str! (jv-xs! (_0 r)))))

;; Does a branch contribute anything beyond prose?
;; The enum's values with any null dropped (the null is the nullable
;; spelling, handled by sg-nullable?).  -> [] when there is no enum.
(define (sg-enum-vals v)
  (define r (jv-get "enum" v))
  (Ifz r []
    (filter (lambda (x) (Ifz (jv? "/boot/json/nul" x) 1 0)) (jv-xs! (_0 r)))))

;; A single-value enum is a CONSTANT, not an enumeration: the wire
;; always carries that one string.  In a discriminated union it is the
;; tag; on its own it is a field nothing branches on.  Either way a sum
;; with one variant would be noise, so it stays a string — 435 of this
;; document's 522 inline enums are of this shape.
(define (sg-const-enum? v) (Eq 1 (Sz (sg-enum-vals v))))
(define (sg-real-enum? v) (Gt (Sz (sg-enum-vals v)) 1))

;; The arms of a oneOf/anyOf, with a bare `null` arm dropped — that arm
;; is the nullable spelling again, not a member of the union.
(define (sg-union-arms v)
  (define (real xs)
    (filter (lambda (b)
              (let ((t (jv-get "type" b)))
                (Ifz t 1 (Ifz (Eq "null" (jv-str! (_0 t))) 1 0))))
      xs))
  (define one (jv-get "oneOf" v))
  (define any-r (jv-get "anyOf" v))
  (Weld (Ifz one [] (real (jv-xs! (_0 one))))
    (Ifz any-r [] (real (jv-xs! (_0 any-r))))))

;; A union every one of whose arms is a bare constant is an ENUM spelled
;; the long way — this document does that 12 times.
(define (sg-union-is-enum? v)
  (define arms (sg-union-arms v))
  (And (Gt (Sz arms) 1)
    (If (all sg-const-enum? arms) 1 0)))

(define (sg-branch-adds? b)
  (Or (If (Sz (sg-props-of b)) 1 0)
    (Or (If (Sz (sg-reqs-of b)) 1 0)
      (Or (Ifz (jv-get "enum" b) 0 1)
        (Ifz (jv-get "items" b) 0 1)))))

(define (sg-ref-branches ao)
  (filter (lambda (b) (Ifz (Nil (sg-ref-name b)) 1 0)) ao))

(define sg-prim-types ["string" "integer" "boolean" "number" "array"])

;; The declared type, ignoring a null beside it (the nullable reading
;; proper is sg-null-union, below).  -> 0 or [string]
(define (sg-type-str-raw v)
  (define t (jv-get "type" v))
  (Ifz t 0
    (If (jv-arr? (_0 t))
      (let ((real (filter (lambda (x) (Ifz (Eq "null" x) 1 0))
                    (map jv-str! (jv-xs! (_0 t))))))
        (Ifz (Sz real) 0 [(_0 real)]))
      [(jv-str! (_0 t))])))

;; Is this named schema merely a pointer at another type?
;; -> 0, or [the schema to take the ftype from instead]
(define (sg-alias-subst v)
  (define ao (sg-allof v))
  (define refs (sg-ref-branches ao))
  (cond
    ;; a bare $ref
    ((Ifz (Nil (sg-ref-name v)) 1 0) [v])
    ;; exactly one $ref branch, and nothing else adds a field
    ((And (Sz ao)
       (And (Eq 1 (Sz refs)) (Ifz (any sg-branch-adds? ao) 1 0)))
      [(_0 refs)])
    ;; any other allOf is a real merge
    ((Sz ao) 0)
    ;; an enum is a type of its own, whatever its base type says
    ((Ifz (jv-get "enum" v) 0 1) 0)
    (else
      (let ((t (sg-type-str-raw v)))
        (Ifz t 0
          (cond
            ((includes (Eq (_0 t)) sg-prim-types) [v])
            ;; An object that declares no properties says nothing about
            ;; its KEYS — it is any JSON object, not a record with none.
            ;; That covers both spellings this document uses: a literal
            ;; `properties: {}`, and additionalProperties, which is a map
            ;; whose value type the IR has no way to say yet.  Carrying
            ;; it undecoded is what sg-ftype-go already does for the same
            ;; schema in field position; this makes the NAMED case agree
            ;; instead of failing the whole schema.
            ((And (Eq "object" (_0 t))
               (And (Ifz (Sz (sg-props-of v)) 1 0)
                 (Ifz (Sz (sg-union-arms v)) 1 0)))
              [v])
            (else 0)))))))

;; name -> substitute schema, for every alias in the document.
(define (sg-alias-map defs)
  (foldl
    (lambda (acc e)
      (let ((al (sg-alias-subst (Ix 1 e))))
        (Ifz (Nil al) (snoc [(Ix 0 e) (_0 al)] acc) acc)))
    [] defs))

(define (sg-alias-look aliases nm)
  (define hit (find (lambda (e) (Eq nm (Ix 0 e))) aliases))
  (Ifz hit 0 [(Ix 1 (_0 hit))]))

;; An env threads the document's schemas and its alias map through
;; ftype resolution.
(define (sg-env defs) [defs (sg-alias-map defs)])
(define (sg-env-defs env) (_0 env))
(define (sg-env-aliases env) (_1 env))
(define sg-env-none [[] []])

;; A record view of a schema with allOf resolved: [props reqs].
(define (sg-flat-record env v depth)
  (Ifz (Lt depth 24) (sg-error "allOf nested too deep" depth)
    (let ((ao (sg-allof v)))
      (Ifz (Sz ao) [(sg-props-of v) (sg-reqs-of v)]
        (foldl
          (lambda (acc b)
            (let* ((r (sg-ref-name b))
                   (bs (Ifz (Nil r)
                         (let ((hit (find (lambda (e) (Eq (_0 r) (Ix 0 e)))
                                     (sg-env-defs env))))
                           (Ifz hit
                             (sg-error "dangling-ref (no such schema)" (_0 r))
                             (Ix 1 (_0 hit))))
                         b))
                   (sub (sg-flat-record env bs (Inc depth))))
              ;; a later branch's field wins; required is a union
              [(Weld
                 (filter (lambda (x)
                           (Ifz (find (lambda (y) (Eq (Ix 0 y) (Ix 0 x))) (_0 sub))
                             1 0))
                   (_0 acc))
                 (_0 sub))
               (Weld (_1 acc) (_1 sub))]))
          [(sg-props-of v) (sg-reqs-of v)] ao)))))

;;; Discriminating a union ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; "Discriminator" is not a property of a field but of a field
;;; RELATIVE TO A UNION.  A field discriminates when matching on it is
;;; enough to pick an arm, which means: present in every arm, pinned to
;;; one value in every arm, and those values pairwise distinct.  Derived
;;; that way it agrees with all 40 of this document's declared
;;; `discriminator` keys and finds 31 more, so the keyword is never read.

;; The one value a property schema pins, as a wire string, or 0.
(define (sg-pin-val ps)
  (define c (jv-get "const" ps))
  (Ifz c
    (let ((vs (sg-enum-vals ps)))
      (If (And (Eq 1 (Sz vs)) (jv-str? (_0 vs))) [(jv-str! (_0 vs))] 0))
    (If (jv-str? (_0 c)) [(jv-str! (_0 c))] 0)))

;; An arm's properties, following a $ref and flattening allOf.
(define (sg-arm-props env b depth)
  (Ifz (Lt depth 16) []
    (let ((r (sg-ref-name b)))
      (Ifz (Nil r)
        (let ((hit (find (lambda (e) (Eq (_0 r) (Ix 0 e))) (sg-env-defs env))))
          (Ifz hit [] (sg-arm-props env (Ix 1 (_0 hit)) (Inc depth))))
        (_0 (sg-flat-record env b 0))))))

;; The field that discriminates these arms, or 0.
(define (sg-union-tag env arms)
  (define views (map (lambda (b) (sg-arm-props env b 0)) arms))
  (define (pin f view)
    (define hit (find (lambda (e) (Eq f (Ix 0 e))) view))
    (Ifz hit 0 (sg-pin-val (Ix 1 (_0 hit)))))
  (define (tags? f)
    (define vs (map (lambda (vw) (pin f vw)) views))
    (And (all (lambda (x) (Ifz (Nil x) 1 0)) vs)
      (let ((ss (map (lambda (x) (_0 x)) vs)))
        (If (Eq (Sz ss) (Sz (dedupe-eq ss))) 1 0))))
  (define cands
    (Ifz (Sz views) []
      (filter tags? (map (lambda (e) (Ix 0 e)) (_0 views)))))
  (Ifz (Sz cands) 0 [(_0 cands)]))

;; OpenAPI 3.1 spells "nullable T" as type: ["T","null"] — one real
;; type beside the null.  It becomes T, and the field carrying it
;; becomes OPTIONAL: absent and explicitly null both read as .none,
;; which is a deliberate flattening of a distinction foil's maybe
;; cannot make.  A union of two real types is a different feature
;; (oneOf's business) and is still rejected.
;; -> 0, or [type-string]
(define (sg-null-union v)
  (define t (jv-get "type" v))
  (Ifz t 0
    (Ifz (jv-arr? (_0 t)) 0
      (let* ((xs (map jv-str! (jv-xs! (_0 t))))
             (real (filter (lambda (x) (Ifz (Eq "null" x) 1 0)) xs)))
        (If (And (includes (Eq "null") xs) (Eq 1 (Sz real)))
          [(_0 real)]
          (sg-error "type-union of two real types (needs oneOf)" xs))))))

(define (sg-type-str v)
  (define t (jv-get "type" v))
  (Ifz t 0
    (If (jv-arr? (_0 t))
      (sg-null-union v)
      [(jv-str! (_0 t))])))

;; Does this schema admit null?  Such a field is optional however the
;; record's `required` list reads.  A $ref is followed, because the
;; nullability can be declared on the NAMED type — this document's
;; InstructType is an enum with a null among its values, and the API
;; really does send it.
(define (sg-nullable-go env v depth)
  (Ifz (Lt depth 16) 0
    (let ((r (sg-ref-name v)))
      (Ifz (Nil r)
        (let ((hit (find (lambda (e) (Eq (_0 r) (Ix 0 e))) (sg-env-defs env))))
          (Ifz hit 0 (sg-nullable-go env (Ix 1 (_0 hit)) (Inc depth))))
        (Ifz (Nil (sg-null-union v)) 1
          (let ((en (jv-get "enum" v)))
            (Ifz en 0
              (If (any (lambda (x) (jv? "/boot/json/nul" x)) (jv-xs! (_0 en)))
                1 0))))))))
(define (sg-nullable? env v) (sg-nullable-go env v 0))

(define (sg-ftype-go env v depth)
  (Ifz (Lt depth 24) (sg-error "alias chain too deep" depth)
  (let ((r (sg-ref-name v)))
  (Ifz (Nil r)
    ;; a reference to an alias resolves through to what it names
    (let ((al (sg-alias-look (sg-env-aliases env) (_0 r))))
      (Ifz (Nil al)
        (sg-ftype-go env (_0 al) (Inc depth))
        ["ref" (sg-name (_0 r))]))
    ;; an allOf here is either an alias to a $ref or an inline object
    (If (Sz (sg-allof v))
      (let ((al (sg-alias-subst v)))
        (Ifz (Nil al)
          (sg-ftype-go env (_0 al) (Inc depth))
          (sg-error "inline-object (hoist to $defs)" v)))
    ;; A constant is a string on the wire.  A real enumeration needs a
    ;; name, which only sg-typedef-go can mint, so reaching here with
    ;; one means it was used somewhere lifting does not run.
    (If (sg-real-enum? v)
      (sg-error "inline-enum (hoist to $defs)" v)
    (If (sg-const-enum? v) ["str"]
    ;; A union reached HERE is one lifting never got to: inside an
    ;; array's items, or inside another union's arm.  A union in plain
    ;; field position is minted by sg-typedef-go and arrives as a $ref,
    ;; so oneOf itself is supported — what is missing is hoisting the
    ;; nested ones, exactly as with inline objects and enums above.
    (If (Sz (sg-union-arms v))
      (sg-error "inline-union (hoist to $defs)" v)
      (let ((t (sg-type-str v)))
        ;; No type and no $ref means "any JSON value" — the document is
        ;; declining to say more, so the field carries the value as it
        ;; arrived.  An object with only additionalProperties is the
        ;; same statement about a whole object.
        (Ifz t ["any"]
          (let ((ty (_0 t)))
            (cond
              ((Eq ty "string") ["str"])
              ((Eq ty "integer") ["int"])
              ((Eq ty "boolean") ["bool"])
              ;; A JSON number arrives as its DECIMAL TEXT, because
              ;; there is no honest float here and a client does not
              ;; need one — it must show what it received and send
              ;; back what it was given, and the lexeme does both
              ;; exactly.  Integral numbers render canonically.
              ((Eq ty "number") ["num"])
              ;; an object with no declared properties says nothing
              ;; about its keys, so it is any JSON object
              ((Eq ty "object")
                (Ifz (Sz (_0 (sg-flat-record env v 0)))
                  ["any"]
                  (sg-error "inline-object (hoist to $defs)" v)))
              ((Eq ty "array")
                (let ((it (jv-get "items" v)))
                  (Ifz it (sg-error "array-without-items" v)
                    (let ((et (sg-ftype-go env (_0 it) (Inc depth))))
                      (If (Eq "row" (_0 et))
                        (sg-error "nested-array-unsupported" v)
                        ["row" et])))))
              (else (sg-error "unsupported-type" ty))))))))))))))

(define (sg-ftype-of env v) (sg-ftype-go env v 0))

;; A property carrying a whole type inline needs a name of its own: a
;; record, a real enumeration, or a union spelled as constants.  It is
;; LIFTED and referenced, never flattened into the parent — the nesting
;; has to survive the encode direction, and a sum needs a declaration.
(define (sg-liftable? env v)
  (And (Nil (sg-ref-name v))
    (Or (sg-real-enum? v)
      (Or (sg-union-is-enum? v)
        (Or (If (Sz (sg-union-arms v)) 1 0)
          (And (Nil (sg-alias-subst v))
            (And (Ifz (jv-get "enum" v) 1 0)
              (If (Sz (_0 (sg-flat-record env v 0))) 1 0))))))))

;; The minted name must not collide with one the document already uses.
(define (sg-mint env owner fname)
  (define nm (strcat [owner "_" fname]))
  (define taken
    (any (lambda (e) (Eq nm (sg-norm-name (Ix 0 e)))) (sg-env-defs env)))
  (If taken
    (sg-error "lifted-name collides with a declared schema" nm)
    nm))

;; Each variant keeps BOTH spellings: the normalized foil name and the
;; wire string.  They differ often ("Qwen" is a legal value of this
;; document's ModelGroup, and the variant is qwen), and matching the
;; normalized one against the wire would reject every value that is not
;; already lowercase.
(define (sg-enum-pairs vals)
  (map (lambda (x) (let ((s (jv-str! x))) [(sg-name s) s])) vals))

;; Dedupe on the WIRE string.  dedupe-eq cannot do this: Eq is shallow,
;; so on [vname wire] rows it does not compare the contents.
(define (sg-dedupe-pairs ps)
  (foldl (lambda (acc p)
           (If (any (lambda (q) (Eq (Ix 1 q) (Ix 1 p))) acc) acc (snoc p acc)))
    [] ps))

;; Every union gets a trailing catch-all holding the value undecoded.
;; 145 enum sites in this document carry x-speakeasy-unknown-values, so
;; the server reserves the right to send a tag nobody has seen: an
;; unmatched arm keeps parsing and re-encodes verbatim instead of
;; turning every API addition into a client outage.
(define sg-union-else "unknown")

;;; Shape discrimination ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; When no FIELD settles a union, the arms' JSON constructors often do:
;;; 43 of this document's 77 fieldless unions have pairwise-disjoint
;;; shapes, 21 of them the plain `string | array`.  Dispatch then reads
;;; the constructor of the value itself rather than a key inside it.

;; The json constructors a shape can arrive as.  `num` claims BOTH,
;; because json splits numbers by spelling, not by type: an integral
;; literal is json/num and any other is json/real (it keeps the source
;; lexeme).  So one `number` arm needs two match arms.  That also means
;; an `integer` arm and a `number` arm are NOT disjoint — json/num
;; answers to both — and such a union is rejected rather than decided by
;; arm order.  This document never writes one.
(define (sg-shape-ctors s)
  (cond
    ((Eq "str" s) ["str"])
    ((Eq "int" s) ["num"])
    ((Eq "num" s) ["num" "real"])
    ((Eq "boo" s) ["boo"])
    ((Eq "arr" s) ["arr"])
    ((Eq "obj" s) ["obj"])
    (else [])))

(define (sg-shape-of-type t)
  (cond
    ((Eq "string" t) ["str"])
    ((Eq "integer" t) ["int"])
    ((Eq "number" t) ["num"])
    ((Eq "boolean" t) ["boo"])
    ((Eq "array" t) ["arr"])
    ((Eq "object" t) ["obj"])
    (else 0)))

;; The json shape an arm arrives as, following $refs and allOf.
;; -> 0 (undecidable) or [shape-key]
(define (sg-arm-shape env b depth)
  (Ifz (Lt depth 16) 0
    (let ((r (sg-ref-name b)))
      (Ifz (Nil r)
        (let ((hit (find (lambda (e) (Eq (_0 r) (Ix 0 e))) (sg-env-defs env))))
          (Ifz hit 0 (sg-arm-shape env (Ix 1 (_0 hit)) (Inc depth))))
        ;; a nested union has no single constructor of its own
        (Ifz (Sz (sg-union-arms b))
          (let ((t (sg-type-str b)))
            (Ifz (Nil t)
              (sg-shape-of-type (_0 t))
              ;; no declared type: read it off the structure
              (cond
                ;; a substantive allOf is a record merge
                ((Sz (sg-allof b)) ["obj"])
                ((Ifz (jv-get "enum" b) 0 1) ["str"])
                ((Sz (sg-props-of b)) ["obj"])
                ((Ifz (jv-get "items" b) 0 1) ["arr"])
                (else 0))))
          0)))))

;; The arms' shapes, if every arm has one and no two can arrive as the
;; same json constructor.  -> 0, or [shape-key ..] parallel to arms
(define (sg-union-shape env arms)
  (define shapes (map (lambda (b) (sg-arm-shape env b 0)) arms))
  (Ifz (all (lambda (s) (Ifz (Nil s) 1 0)) shapes) 0
    (let* ((keys (map (lambda (s) (_0 s)) shapes))
           (ctors (foldl (lambda (acc k) (Weld acc (sg-shape-ctors k))) [] keys)))
      (If (Eq (Sz ctors) (Sz (dedupe-eq ctors))) keys 0))))

;; -> [disc specs], disc = ["tag" field] | ["shape"],
;;    spec = [vname arm-schema key]  (key = the tag's wire value, or the shape)
;;
;; Deliberately stops short of the arms' FTYPES.  An arm can itself be an
;; inline type needing a name of its own, and minting one is
;; sg-typedef-go's job — which is defined after this, so it cannot be
;; called from here.
(define (sg-union-plan env name v)
  (define arms (sg-union-arms v))
  (define tag (sg-union-tag env arms))
  (Ifz (Nil tag)
    (let* ((tf (_0 tag))
           (built
             (map (lambda (b)
                    (let* ((props (sg-arm-props env b 0))
                           (hit (find (lambda (e) (Eq tf (Ix 0 e))) props))
                           (wire (_0 (sg-pin-val (Ix 1 (_0 hit))))))
                      [(sg-name wire) b wire]))
               arms)))
      (If (any (lambda (a) (Eq sg-union-else (_0 a))) built)
        (sg-error "union arm collides with the catch-all name" name)
        [["tag" tf] built]))
    ;; No field settles it — try the arms' json constructors.  The
    ;; shape keys are str/arr/obj/num/boo, so they cannot collide with
    ;; the catch-all the way a tag's wire value can.
    (let ((shapes (sg-union-shape env arms)))
      (Ifz (Nil shapes)
        [["shape"]
         (gen (Sz arms)
           (lambda (i) [(Ix i shapes) (Ix i arms) (Ix i shapes)]))]
        ;; Neither a field nor a shape: the genuinely ambiguous ones
        ;; (this document has 5, one with 49 arms carrying type:"message"
        ;; on three).  Guessing between them would be worse than saying so.
        (sg-error "union has no discriminating field or shape" name)))))

;; -> [typedef [extra-typedef ..]]   extras are lifted inline types
(define (sg-typedef-go env name v depth)
  ;; A union whose every arm is a bare constant is an enum written the
  ;; long way; take its arms' values as the variants.
  (define vals
    (If (sg-union-is-enum? v)
      (foldl (lambda (acc b) (Weld acc (sg-enum-vals b))) [] (sg-union-arms v))
      (sg-enum-vals v)))
  (Ifz (Lt depth 12) (sg-error "inline types nested too deep" name)
  (If (Sz vals)
    (let ((pairs (sg-dedupe-pairs (sg-enum-pairs vals))))
      [["enum" name pairs] []])
  (If (Sz (sg-union-arms v))
    ;; A union's ARMS lift exactly as a record's properties do: an arm
    ;; that is an inline object, enum or union gets a name of its own and
    ;; is referenced.  Without this an arm could only ever be a $ref or a
    ;; primitive, which is what made `string | array-of-<union>` (this
    ;; document's BaseInputs and Inputs) unreachable.
    (let* ((plan (sg-union-plan env name v))
           (step
             (foldl
               (lambda (acc s)
                 (let* ((vname (_0 s))
                        (b (Ix 1 s))
                        (key (Ix 2 s))
                        (items (jv-get "items" b))
                        (arr-lift
                          (And (Ifz items 0 1)
                            (If items (sg-liftable? env (_0 items)) 0))))
                   (cond
                     ((sg-liftable? env b)
                       (let* ((nm (sg-mint env name vname))
                              (sub (sg-typedef-go env nm b (Inc depth))))
                         [(snoc [vname ["ref" nm] key] (_0 acc))
                          (Weld (_1 acc) (snoc (_0 sub) (_1 sub)))]))
                     (arr-lift
                       (let* ((nm (sg-mint env name vname))
                              (sub (sg-typedef-go env nm (_0 items) (Inc depth))))
                         [(snoc [vname ["row" ["ref" nm]] key] (_0 acc))
                          (Weld (_1 acc) (snoc (_0 sub) (_1 sub)))]))
                     (else
                       [(snoc [vname (sg-ftype-of env b) key] (_0 acc))
                        (_1 acc)]))))
               [[] []] (Ix 1 plan))))
      [["union" name (_0 plan) (_0 step)] (_1 step)])
    ;; a record: its own properties, plus any inherited through allOf
    (let* ((flat (sg-flat-record env v 0))
           (props (_0 flat))
           (reqs (_1 flat))
           (t (sg-type-str v)))
      (Ifz (Or (Sz (sg-allof v)) (And t (Eq "object" (_0 t))))
        (sg-error "unsupported-def (want object or enum)" name)
        (let* ((step
                 (foldl
                   (lambda (acc e)
                     (let* ((fname (sg-name (Ix 0 e)))
                            (pv (Ix 1 e))
                            ;; nullable beats required: a field the
                            ;; server may send as null cannot be bare T
                            (req (If (And (includes (Eq (Ix 0 e)) reqs)
                                       (Nil (sg-nullable? env pv)))
                                   1 0))
                            (items (jv-get "items" pv))
                            (arr-lift
                              (And (Ifz items 0 1)
                                (If items (sg-liftable? env (_0 items)) 0))))
                       (cond
                         ((sg-liftable? env pv)
                           (let* ((nm (sg-mint env name fname))
                                  (sub (sg-typedef-go env nm pv (Inc depth))))
                             [(snoc [fname ["ref" nm] req] (_0 acc))
                              (Weld (_1 acc) (snoc (_0 sub) (_1 sub)))]))
                         (arr-lift
                           (let* ((nm (sg-mint env name fname))
                                  (sub (sg-typedef-go env nm (_0 items)
                                         (Inc depth))))
                             [(snoc [fname ["row" ["ref" nm]] req] (_0 acc))
                              (Weld (_1 acc) (snoc (_0 sub) (_1 sub)))]))
                         (else
                           [(snoc [fname (sg-ftype-of env pv) req] (_0 acc))
                            (_1 acc)]))))
                   [[] []] props))
               (fields (_0 step)))
          (Ifz (Sz fields) (sg-error "empty-object" name)
            [["rec" name fields] (_1 step)]))))))))

;; The typedef alone, for callers that only need to know it elaborates.
(define (sg-typedef-of env name v) (_0 (sg-typedef-go env name v 0)))

;; The typedef plus everything lifted out of it, in emission order.
(define (sg-typedefs-of env name v)
  (define r (sg-typedef-go env name v 0))
  (snoc (_0 r) (_1 r)))

;; ref names reachable from a typedef's fields.
(define (sg-ft-refs ft)
  (cond
    ((Eq "ref" (_0 ft)) [(Ix 1 ft)])
    ((Eq "row" (_0 ft)) (sg-ft-refs (Ix 1 ft)))
    (else [])))

(define (sg-td-deps td)
  (cond
    ((Eq "rec" (_0 td))
      (foldl (lambda (acc f) (Weld acc (sg-ft-refs (Ix 1 f)))) [] (Ix 2 td)))
    ;; a union names its arms' types, so they must be emitted first
    ((Eq "union" (_0 td))
      (foldl (lambda (acc a) (Weld acc (sg-ft-refs (Ix 1 a)))) [] (Ix 3 td)))
    (else [])))

;; Emission order: a def before its dependents; cycles rejected.
(define (sg-topo tds)
  (define (go done rest)
    (Ifz (Sz rest) done
      (let* ((names (map (Ix 1) done))
             (ready?
               (lambda (td)
                 (all (lambda (d) (includes (Eq d) names)) (sg-td-deps td))))
             (rd (filter ready? rest))
             (rst (filter (lambda (td) (Nil (ready? td))) rest)))
        (Ifz (Sz rd)
          (sg-error "ref-cycle (or dangling $ref)" (map (Ix 1) rest))
          (go (Weld done rd) rst)))))
  (go [] tds))

;; -> [root-name [typedef ..]] in emission order.
(define (sg-schema-typedefs sv)
  (define title-r (jv-get "title" sv))
  (define root-name
    (Ifz title-r (sg-error "missing-title" 0)
      (sg-name (jv-str! (_0 title-r)))))
  (define defs-r (jv-get "$defs" sv))
  (define defs (Ifz defs-r [] (jv-kvs (_0 defs-r))))
  (define env (sg-env defs))
  ;; aliases emit nothing: references to them resolved through already
  (define def-tds
    (foldl (lambda (acc e)
            (Weld acc (sg-typedefs-of env (sg-name (Ix 0 e)) (Ix 1 e))))
      []
      (filter (lambda (e) (Nil (sg-alias-subst (Ix 1 e)))) defs)))
  (define tds (Weld (sg-typedefs-of env root-name sv) def-tds))
  (define names (map (Ix 1) tds))
  (Ifz (Eq (Sz names) (Sz (dedupe-eq names)))
    (sg-error "duplicate-type-name" names)
    [root-name (sg-topo tds)]))

;;; Shared naming ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define sg-q 34)

;; Quote for embedding inside doctest lore text (the doctest runner
;; re-parses the ?= expression, so its cords need real quote bytes).
(define (qq s) (strcat [sg-q s sg-q]))

;; helper-name suffix of an ftype.
(define (sg-ft-key ft)
  (cond
    ((Eq "str" (_0 ft)) "str")
    ((Eq "int" (_0 ft)) "int")
    ((Eq "bool" (_0 ft)) "boo")
    ((Eq "num" (_0 ft)) "num")
    ((Eq "any" (_0 ft)) "any")
    ((Eq "ref" (_0 ft)) (Ix 1 ft))
    ((Eq "row" (_0 ft)) (strcat ["row_" (sg-ft-key (Ix 1 ft))]))))

;; The result sum whose ok holds a bare (required) value of ft: a ref's
;; own <R>_r, else the generated r_<key>.
(define (sg-ft-rsum ft)
  (If (Eq "ref" (_0 ft))
    (strcat [(Ix 1 ft) "_r"])
    (strcat ["r_" (sg-ft-key ft)])))

;; The value-decoder entry for ft (json -> result sum above).
(define (sg-ft-dval ft)
  (If (Eq "ref" (_0 ft))
    (strcat [(Ix 1 ft) "_from"])
    (strcat ["d_val_" (sg-ft-key ft)])))


;; Merge a [ft req opt] use into the per-rec key list, OR-ing modes.
(define (sg-merge-entry acc ent)
  (define key (sg-ft-key (Ix 0 ent)))
  (define hit (find (lambda (e) (Eq key (sg-ft-key (Ix 0 e)))) acc))
  (Ifz hit
    (snoc ent acc)
    (map (lambda (e)
           (If (Eq key (sg-ft-key (Ix 0 e)))
             [(Ix 0 e) (Or (Ix 1 e) (Ix 1 ent)) (Or (Ix 2 e) (Ix 2 ent))]
             e))
      acc)))

;; Keys a row ftype's ELEMENT needs (d_val only -> req=0 opt=0 entry).
(define (sg-elem-keys ft)
  (If (And (Eq "row" (_0 ft)) (Nil (Eq "ref" (_0 (Ix 1 ft)))))
    [[(Ix 1 ft) 0 0]]
    []))

;;; Tree emitter ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Emits normalized rex DIRECTLY — Leaf/Nest/Juxt with inert zero
;;; spans, straight into foil:compile-rex.  Shapes mirror what
;;; ParseRexNormFile produces for the same source (probe-transcribed);
;;; the dev oracle was Equal against the span-zapped parse of the text
;;; emitter's output.

(define nzsp [0 0 0 0])
(define (nw s) (rex:MakeLeaf nzsp "word" s))
(define (nc s) (rex:MakeLeaf nzsp "cord" s))
(define (nrn rune kids) (rex:MakeNest nzsp "clear" rune kids))
(define (npar kids) (rex:MakeNest nzsp "paren" "" kids))
(define (nbrk kids) (rex:MakeNest nzsp "brack" "" kids))
(define (nbrko rune kids) (rex:MakeNest nzsp "brack" rune kids))
(define (njx kids) (rex:MakeJuxt nzsp kids))
(define (ngrp kids) (If (Eq 1 (Sz kids)) (_0 kids) (nrn "" kids)))

;; BUG-COMPATIBLE, twice over: the parser's lore-line join writes a
;; LITERAL backslash-n (rex-unlines-go, rex.rvr:301 — string literals
;; process no escapes), and DECL-level continuation lines keep a "' "
;; prefix while top-level ones are stripped.  Match both so generated
;; lore is indistinguishable from parsed lore; flip in lockstep when
;; the newline bug is fixed.
(define (nslug-join sep lines)
  (rex:MakeLeaf nzsp "slug"
    (foldl (lambda (acc l)
             (Ifz acc (strcat [" " l]) (strcat [acc sep l])))
      0 lines)))
(define (nslug-top lines) (nslug-join (strcat ["\n" " "]) lines))
(define (nslug lines) (nslug-join (strcat ["\n" "  '  "]) lines))

(define (npth segs) (nrn "/" (map nw segs)))
(define (nfc name ty) (nrn "=" [(nw name) ty]))
;; "." chains are FLAT in normalized rex (a.b.c(x) is ONE "." nest with
;; kids [a b c-juxt]; parse-meth rejects a nested "." receiver), so a
;; "."-nest receiver splices its kids.
(define (ndot a b)
  (If (And (Eq "nest" (Hd a))
        (And (Eq "clear" (Ix 1 a)) (Eq "." (Ix 2 a))))
    (nrn "." (snoc b (Ix 3 a)))
    (nrn "." [a b])))
(define (ndotw a b) (ndot (nw a) (nw b)))
(define (nmeth recv seg args)
  (ndot recv (njx [(nw seg) (npar args)])))
(define (nrelv name) (nrn "." [(nw name)]))
(define (nrelap name args)
  (npar (cons (nrn "./" [(nw name)]) args)))
(define (nspec name args) (njx [(nw name) (nbrk args)]))

;; foil type tree of an ftype.
(define (sg-ft-ty-t ft)
  (cond
    ((Eq "str" (_0 ft)) (nw "nat"))
    ((Eq "int" (_0 ft)) (nw "nat"))
    ((Eq "bool" (_0 ft)) (nw "bool"))
    ;; decimal text, not an arithmetic value
    ((Eq "num" (_0 ft)) (nw "nat"))
    ;; the value exactly as it arrived, undecoded
    ((Eq "any" (_0 ft)) (nw "json"))
    ((Eq "ref" (_0 ft)) (nw (Ix 1 ft)))
    ((Eq "row" (_0 ft)) (nspec "row" [(sg-ft-ty-t (Ix 1 ft))]))))

(define (sg-maybe-t ty) (nspec "maybe" [ty]))

;; (name/variant args...) application.
(define (nvap sum variant args)
  (npar (cons (npth [sum variant]) args)))

(define (sg-sum-tree name vty)
  (nrn "+"
    [(nw name)
     (nrn "&" [(npth [name "ok"]) (npth [name "err"])])
     (nrn "+" [(nw "ok") (nrn ":" [(nfc "v" vty)])])
     (nrn "+" [(nw "err")
               (nrn ":" [(nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])])]))

(define (sg-dval-tree ft)
  (define key (sg-ft-key ft))
  (define rs (strcat ["r_" key]))
  (define (err why) (nvap rs "err" [(nw "p") (nc why)]))
  (define (ok v) (nvap rs "ok" [v]))
  (define body
    (cond
      ((Eq "str" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "str"])) (ok (ndotw "t" "s"))])
                  (err "expected-string")]))
      ((Eq "int" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "num"]))
                            (nrn "?" [(ndotw "t" "neg") (err "negative")])
                            (ok (ndotw "t" "n"))])
                  (err "expected-integer")]))
      ((Eq "bool" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "boo"])) (ok (ndotw "t" "b"))])
                  (err "expected-boolean")]))
      ;; Any JSON value passes through undecoded, so there is nothing
      ;; that can fail.
      ((Eq "any" (_0 ft)) (ok (nw "j")))
      ;; A number keeps its decimal text: json/real already holds the
      ;; source lexeme, and an integral json/num is rendered back to
      ;; the same spelling it arrived with.
      ((Eq "num" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "real"])) (ok (ndotw "t" "lex"))])
                  (nrn ">" [(nfc "t" (npth ["json" "num"]))
                            (nrn "?" [(ndotw "t" "neg")
                                      (ok (npar [(nw "cat2") (nc "-")
                                                 (npar [(nw "show_nat")
                                                        (ndotw "t" "n")])]))])
                            (ok (npar [(nw "show_nat") (ndotw "t" "n")]))])
                  (err "expected-number")]))
      ((Eq "row" (_0 ft))
        (let* ((et (Ix 1 ft))
               (ety (sg-ft-ty-t et))
               (edv (sg-ft-dval et)))
          (nrn "?"
            [(nw "j")
             (nrn ">"
               [(nfc "t" (npth ["json" "arr"]))
                ;; one-line arm chains: the second > rides as a kid
                ;; of the first (loop-arm-chain unchains them)
                (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")
                                    (nrn ">" [(nfc "out" (nspec "row" [ety]))
                                              (nbrk [])])])])
                (nrn "^" [(nw rs)])
                (nrn "?" [(npar [(nw "eq") (nw "i")
                                 (nrn "." [(nw "t") (nw "xs") (nw "len")])])
                          (ok (nw "out"))])
                (nrn "?"
                  [(npar [(nw edv)
                          (nrn "." [(nw "t") (nw "xs")
                                    (njx [(nw "at") (npar [(nw "i")])])])
                          (npar [(nw "jidx") (nw "p") (nw "i")])])
                   (nrn ">" [(npar [(nrn "./" [(nw "err")])
                                    (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
                             (nvap rs "err" [(nw "path") (nw "why")])])
                   (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" ety)])
                             (npar [(nw "_") (ndotw "i" "inc")
                                    (nmeth (nw "out") "snoc" [(nw "v")])])])])])
             (err "expected-array")])))
      (else (sg-error "dval-of-ref" ft))))
  (nrn "+"
    [(nw (strcat ["d_val_" key]))
     (nrn "\" [(nfc "j" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rs)])
     body]))

(define (sg-dreq-tree ft)
  (define key (sg-ft-key ft))
  (define rs (sg-ft-rsum ft))
  (define dv (sg-ft-dval ft))
  (nrn "+"
    [(nw (strcat ["d_req_" key]))
     (nrn "\" [(nfc "m" (sg-maybe-t (nw "json"))) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rs)])
     (nrn "?"
       [(nw "m")
        (nrn ">" [(nrelv "none") (nvap rs "err" [(nw "p") (nc "missing")])])
        (nrn ">" [(npar [(nrn "./" [(nw "some")]) (nw "j")])
                  (npar [(nw dv) (nw "j") (nw "p")])])])]))

(define (sg-dopt-body ors ty dv)
  (define decode
    (nrn "?"
      [(npar [(nw dv) (nw "j") (nw "p")])
       (nrn ">" [(npar [(nrn "./" [(nw "err")])
                        (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
                 (nvap ors "err" [(nw "path") (nw "why")])])
       (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" ty)])
                 (nvap ors "ok" [(nrelap "some" [(nw "v")])])])]))
  (define present
    (nrn "?"
      [(nw "j")
       (nrn ">" [(nfc "z" (npth ["json" "nul"]))
                 (nvap ors "ok" [(nrelv "none")])])
       decode]))
  (nrn "?"
    [(nw "m")
     (nrn ">" [(nrelv "none") (nvap ors "ok" [(nrelv "none")])])
     (nrn ">" [(npar [(nrn "./" [(nw "some")]) (nw "j")]) present])]))

(define (sg-dopt-tree ft)
  (define key (sg-ft-key ft))
  (define ty (sg-ft-ty-t ft))
  (define ors (strcat ["r_o_" key]))
  (define dv (sg-ft-dval ft))
  [(sg-sum-tree ors (sg-maybe-t ty))
   (nrn "+"
     [(nw (strcat ["d_opt_" key]))
      (nrn "\" [(nfc "m" (sg-maybe-t (nw "json"))) (nfc "p" (nw "nat"))])
      (nrn "^" [(nw ors)])
      ;; An explicit null reads as absent.  A key the server sends as
      ;; null is not a value this field can hold, and EVERY nullable
      ;; spelling lands here — type: [T,null], a null among enum
      ;; values, or either of those behind a $ref — rather than each
      ;; needing to be recognised at the use site.
      (sg-dopt-body ors ty dv)])])

;; Helper members for one field use, emitted once per (part, key).
(define (sg-part-trees seen ft req opt)
  (define key (sg-ft-key ft))
  (define is-ref (Eq "ref" (_0 ft)))
  (define (add tag emit st)
    (let ((tagk (strcat [tag key])))
      (If (includes (Eq tagk) (_0 st)) st
        [(snoc tagk (_0 st)) (Weld (_1 st) (emit 0))])))
  (define st0 [seen []])
  (define st1
    (Ifz is-ref
      (add "v:"
        (lambda (z)
          [(sg-sum-tree (strcat ["r_" key]) (sg-ft-ty-t ft))
           (sg-dval-tree ft)])
        st0)
      st0))
  (define st2 (Ifz req st1 (add "q:" (lambda (z) [(sg-dreq-tree ft)]) st1)))
  (Ifz opt st2 (add "o:" (lambda (z) (sg-dopt-tree ft)) st2)))

(define (sg-rec-decl-tree name fields)
  (nrn "+"
    [(nw name)
     (nrn ":"
       (map (lambda (f)
              (let ((ty (sg-ft-ty-t (Ix 1 f))))
                (nfc (Ix 0 f) (If (Ix 2 f) ty (sg-maybe-t ty)))))
         fields))]))

(define (sg-rec-from-tree name fields)
  (define rsum (strcat [name "_r"]))
  (define n (Sz fields))
  (define (chain i)
    (If (Eq i n)
      (nvap rsum "ok"
        [(npar (cons (nw name)
                 (map (lambda (k) (nw (strcat ["v" (nat-str k)])))
                   (gen n (lambda (k) k)))))])
      (let* ((f (Ix i fields))
             (fname (Ix 0 f))
             (ft (Ix 1 f))
             (req (Ix 2 f))
             (dfn (strcat [(If req "d_req_" "d_opt_") (sg-ft-key ft)]))
             (vty (If req (sg-ft-ty-t ft) (sg-maybe-t (sg-ft-ty-t ft))))
             (ix (nat-str i)))
        (nrn "?"
          [(npar [(nw dfn)
                  (npar [(nw "jget") (nc fname) (ndotw "o" "kvs")])
                  (npar [(nw "jpath") (nw "p") (nc fname)])])
           (nrn ">" [(npar [(nrn "./" [(nw "err")])
                            (nfc (strcat ["path" ix]) (nw "nat"))
                            (nfc (strcat ["why" ix]) (nw "nat"))])
                     (nvap rsum "err"
                       [(nw (strcat ["path" ix])) (nw (strcat ["why" ix]))])])
           (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                            (nfc (strcat ["v" ix]) vty)])
                     (chain (Inc i))])]))))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nslug [(strcat ["Decode a " name " from a json value; p is the"])
             "breadcrumb prefix."])
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(nw "v")
        (nrn ">" [(nfc "o" (npth ["json" "obj"])) (chain 0)])
        (nvap rsum "err" [(nw "p") (nc "expected-object")])])]))

;; Encode one field value expression.
(define (sg-enc-t ft exp)
  (cond
    ((Eq "str" (_0 ft)) (npar [(npth ["json" "str"]) exp]))
    ((Eq "int" (_0 ft)) (npar [(npth ["json" "num"]) (nrelv "false") exp]))
    ((Eq "bool" (_0 ft)) (npar [(npth ["json" "boo"]) exp]))
    ;; the stored decimal text goes back out verbatim, unquoted
    ((Eq "num" (_0 ft)) (npar [(npth ["json" "real"]) exp]))
    ;; an undecoded value is already json
    ((Eq "any" (_0 ft)) exp)
    ((Eq "ref" (_0 ft)) (npar [(nw (strcat [(Ix 1 ft) "_to"])) exp]))
    (else (sg-error "enc-of-row-inline" ft))))

;; A row[json] built from src's elements, each encoded with et.  src is
;; the receiver as a list of path components (`[x tags]` -> x.tags), and
;; every loop variable is suffixed with ix so that several of these can
;; sit in one function without colliding.  Rows cannot go through
;; sg-enc-t: they need a loop, and the loop needs that fresh index.
(define (sg-enc-row-loop ix outv src et)
  [(nrn "|" [(nrn ">" [(nfc (strcat ["i" ix]) (nw "nat")) (nw "0")
                       (nrn ">" [(nfc outv (nspec "row" [(nw "json")]))
                                 (nbrk [])])])])
   (nrn "?" [(npar [(nw "eq") (nw (strcat ["i" ix]))
                    (nrn "." (snoc (nw "len") src))])
             (nw outv)])
   (npar [(nw "_") (ndotw (strcat ["i" ix]) "inc")
          (nmeth (nw outv) "snoc"
            [(sg-enc-t et
               (nrn "." (snoc (njx [(nw "at") (npar [(nw (strcat ["i" ix]))])])
                          src)))])])])

;; The whole json/arr for a row-typed value.
(define (sg-enc-row ix src et)
  (npar [(npth ["json" "arr"])
         (ngrp (sg-enc-row-loop ix (strcat ["b" ix]) src et))]))

(define (sg-rec-to-tree name fields)
  (define n (Sz fields))
  (define (row-loop ix outv src et) (sg-enc-row-loop ix outv src et))
  (define (field-trees i)
    (define f (Ix i fields))
    (define fname (Ix 0 f))
    (define ft (Ix 1 f))
    (define req (Ix 2 f))
    (define ix (nat-str i))
    (define acc0 (strcat ["k" (nat-str i)]))
    (define acc1 (strcat ["k" (nat-str (Inc i))]))
    (define is-row (Eq "row" (_0 ft)))
    (define (snoc-kv enc)
      (nmeth (nw acc0) "snoc" [(npar [(nw "jkv") (nc fname) enc])]))
    (If req
      (If is-row
        [(nrn "=" [(nw (strcat ["a" ix]))
                   (ngrp (row-loop ix (strcat ["b" ix])
                           [(nw "x") (nw fname)] (Ix 1 ft)))])
         (nrn "=" [(nw acc1)
                   (snoc-kv (npar [(npth ["json" "arr"]) (nw (strcat ["a" ix]))]))])]
        [(nrn "=" [(nw acc1) (snoc-kv (sg-enc-t ft (ndotw "x" fname)))])])
      (If is-row
        [(nrn "="
           [(nw acc1)
            (nrn "?"
              [(ndotw "x" fname)
               (nrn ">" [(nrelv "none") (nw acc0)])
               (nrn ">"
                 [(npar [(nrn "./" [(nw "some")]) (nw (strcat ["w" ix]))])
                  (nrn "=" [(nw (strcat ["a" ix]))
                            (ngrp (row-loop ix (strcat ["b" ix])
                                    [(nw (strcat ["w" ix]))] (Ix 1 ft)))])
                  (snoc-kv (npar [(npth ["json" "arr"]) (nw (strcat ["a" ix]))]))])])])]
        [(nrn "="
           [(nw acc1)
            (nrn "?"
              [(ndotw "x" fname)
               (nrn ">" [(nrelv "none") (nw acc0)])
               (nrn ">" [(npar [(nrn "./" [(nw "some")]) (nw (strcat ["w" ix]))])
                         (snoc-kv (sg-enc-t ft (nw (strcat ["w" ix]))))])])])])))
  (nrn "+"
    (Weld
      [(nw (strcat [name "_to"]))
       (nrn "\" [(nfc "x" (nw name))])
       (nrn "^" [(nw "json")])
       (nrn "=" [(nw "k0") (nbrk [])])]
      (snoc
        (npar [(npth ["json" "obj"]) (nw (strcat ["k" (nat-str n)]))])
        (foldl (lambda (acc i) (Weld acc (field-trees i))) []
          (gen n (lambda (i) i)))))))

;; vals are [variant-name wire-string] pairs: the foil variant is the
;; normalized name, but decode and encode both speak the wire string.
(define (sg-vname p) (_0 p))
(define (sg-vwire p) (Ix 1 p))

;; An enum is OPEN, exactly as a union is: a value nobody declared is
;; carried in a catch-all variant holding the wire string, not an error.
;; Every one of this document's 181 multi-value enum sites carries
;; x-speakeasy-unknown-values: allow, so a closed enum would turn each
;; new tokenizer or model group into a client outage on a live endpoint.
;;
;; The catch-all cannot simply be named: three of those enums (including
;; Quantization) declare "unknown" as a value of their own, spelling the
;; escape hatch the same way.  Underscores are appended until the name is
;; free, which the first step always achieves since sg-norm-name trims a
;; trailing _ and so can never produce one.
(define (sg-enum-else vals)
  (define (go nm)
    (If (any (lambda (p) (Eq nm (sg-vname p))) vals)
      (go (strcat [nm "_"]))
      nm))
  (go sg-union-else))

(define (sg-enum-decl-tree name vals)
  (define els (sg-enum-else vals))
  (define vns (snoc els (map (lambda (p) (sg-vname p)) vals)))
  (nrn "+"
    (Weld
      [(nw name)
       (nrn "&" (map (lambda (v) (npth [name v])) vns))]
      ;; the declared variants carry a dummy; the catch-all's field is
      ;; the only one that ever holds anything, so it says what it is
      (map (lambda (v)
             (nrn "+" [(nw v)
                       (nrn ":" [(nfc (If (Eq v els) "s" "z") (nw "nat"))])]))
        vns))))

(define (sg-enum-from-tree name vals)
  (define rsum (strcat [name "_r"]))
  (define els (sg-enum-else vals))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nslug [(strcat ["Decode a " name "; an undeclared value rides in"])
             (strcat [els ", which encodes back to the same string.  A"])
             "non-string is still an error: the schema does say string."])
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(nw "v")
        (nrn ">"
          (Weld [(nfc "t" (npth ["json" "str"]))]
            (snoc (nvap rsum "ok" [(nvap name els [(ndotw "t" "s")])])
              (map (lambda (p)
                     (nrn "?" [(npar [(nw "eq") (ndotw "t" "s")
                                      (nc (sg-vwire p))])
                               (nvap rsum "ok"
                                 [(nvap name (sg-vname p) [(nw "0")])])]))
                vals))))
        (nvap rsum "err" [(nw "p") (nc "expected-string")])])]))

(define (sg-enum-to-tree name vals)
  (define els (sg-enum-else vals))
  (nrn "+"
    [(nw (strcat [name "_to"]))
     (nrn "\" [(nfc "x" (nw name))])
     (nrn "^" [(nw "json")])
     (nrn "?"
       (Weld
         (Weld [(nw "x")]
           (snoc
             ;; the catch-all writes back the string it was handed
             (nrn ">" [(nfc (strcat ["e_" els]) (npth [name els]))
                       (npar [(npth ["json" "str"])
                              (ndotw (strcat ["e_" els]) "s")])])
             (map (lambda (p)
                    (nrn ">" [(nfc (strcat ["e_" (sg-vname p)])
                                (npth [name (sg-vname p)]))
                              (npar [(npth ["json" "str"])
                                     (nc (sg-vwire p))])]))
               vals)))
         [(npar [(npth ["json" "str"]) (nc (sg-vwire (_0 vals)))])]))]))

;;; Union emitters ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; A variant WRAPS its arm's type in a single field rather than
;;; flattening the arm's fields in: flattening would duplicate them into
;;; the union decl and break outright when two arms share a field name
;;; at different types.
;;;
;;; The tag needs no special handling in either direction, because every
;;; arm's own schema declares it and a single-value enum is already a
;;; plain string field.  Decode reads it to choose the arm and then lets
;;; the arm decode it as an ordinary field; encode writes it back the
;;; same way.  So the tag cannot drift out of step with the variant.

;; arm = [vname ftype wire]
(define (sg-union-decl-tree name arms)
  (define all-arms
    (snoc [sg-union-else ["any"] 0] arms))
  (nrn "+"
    (Weld
      [(nw name)
       (nrn "&" (map (lambda (a) (npth [name (_0 a)])) all-arms))]
      (map (lambda (a)
             (nrn "+" [(nw (_0 a))
                       (nrn ":" [(nfc "v" (sg-ft-ty-t (Ix 1 a)))])]))
        all-arms))))

;; Decode one arm: run its own decoder, wrap the ok in this variant.
(define (sg-union-arm-decode name rsum a)
  (nrn "?"
    [(npar [(nw (sg-ft-dval (Ix 1 a))) (nw "v") (nw "p")])
     (nrn ">" [(npar [(nrn "./" [(nw "err")])
                      (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
               (nvap rsum "err" [(nw "path") (nw "why")])])
     (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                      (nfc "av" (sg-ft-ty-t (Ix 1 a)))])
               (nvap rsum "ok" [(nvap name (_0 a) [(nw "av")])])])]))

;; Dispatch on the constructor the value actually arrived as.  Each arm
;; contributes one match arm per constructor it can answer to (two for a
;; number), and the arm's own decoder still receives the whole value, so
;; nothing here has to unwrap it.
(define (sg-union-shape-from-tree name arms)
  (define rsum (strcat [name "_r"]))
  (define catch-all
    (nvap rsum "ok" [(nvap name sg-union-else [(nw "v")])]))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nslug [(strcat ["Decode a " name " by the json constructor it"])
             "arrived as; any other shape rides undecoded."])
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       (Weld [(nw "v")]
         (snoc catch-all
           (foldl
             (lambda (acc a)
               (Weld acc
                 (map (lambda (c)
                        (nrn ">" [(nfc (strcat ["j_" c]) (npth ["json" c]))
                                  (sg-union-arm-decode name rsum a)]))
                   (sg-shape-ctors (_0 a)))))
             [] arms))))]))

(define (sg-union-from-tree name tagf arms)
  (define rsum (strcat [name "_r"]))
  (define catch-all
    (nvap rsum "ok" [(nvap name sg-union-else [(nw "v")])]))
  (define dispatch
    (nrn "?"
      (Weld [(nw "tj")]
        [(nrn ">"
           (Weld [(nfc "ts" (npth ["json" "str"]))]
             (snoc catch-all
               (map (lambda (a)
                      (nrn "?" [(npar [(nw "eq") (ndotw "ts" "s")
                                       (nc (Ix 2 a))])
                                (sg-union-arm-decode name rsum a)]))
                 arms))))
         (nvap rsum "err" [(nw "p") (nc "tag-not-a-string")])])))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nslug [(strcat ["Decode a " name " by its " tagf " tag; an"])
             "unrecognised tag rides undecoded."])
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(nw "v")
        (nrn ">"
          [(nfc "o" (npth ["json" "obj"]))
           (nrn "?"
             [(npar [(nw "jget") (nc tagf) (ndotw "o" "kvs")])
              (nrn ">" [(nrelv "none")
                        (nvap rsum "err" [(nw "p") (nc "missing-tag")])])
              (nrn ">" [(npar [(nrn "./" [(nw "some")])
                               (nfc "tj" (nw "json"))])
                        dispatch])])])
        (nvap rsum "err" [(nw "p") (nc "expected-object")])])]))

(define (sg-union-to-tree name arms)
  (define all-arms (snoc [sg-union-else ["any"] 0] arms))
  (nrn "+"
    [(nw (strcat [name "_to"]))
     (nrn "\" [(nfc "x" (nw name))])
     (nrn "^" [(nw "json")])
     (nrn "?"
       (Weld [(nw "x")]
         (gen (Sz all-arms)
           (lambda (i)
             (let* ((a (Ix i all-arms))
                    (ft (Ix 1 a))
                    (bnd (strcat ["u_" (_0 a)])))
               (nrn ">"
                 [(nfc bnd (npth [name (_0 a)]))
                  ;; an array arm needs the same loop a record field
                  ;; does; the arm index keeps its variables distinct
                  (If (Eq "row" (_0 ft))
                    (sg-enc-row (nat-str i) [(nw bnd) (nw "v")] (Ix 1 ft))
                    (sg-enc-t ft (ndotw bnd "v")))]))))))]))

(define sg-prelude-trees
  [(nrn "-" [(nw "sept") (nbrko "=" [(nw "order") (nw "10")])])
   (nrn "-" [(nw "json") (nbrko "=" [(nw "order") (nw "20")])])
   (nslug-top ["Generated by schemagen.  The schema is the source of truth;"
               "there is no source file to edit."])
   (nrn "+"
     [(nw "jget")
      (nslug ["The value at key k, if present."])
      (nrn "\" [(nfc "k" (nw "nat")) (nfc "kvs" (nspec "row" [(nw "jkv")]))])
      (nrn "^" [(sg-maybe-t (nw "json"))])
      (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")])])
      (nrn "^" [(sg-maybe-t (nw "json"))])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "kvs" "len")])
                (nrelv "none")])
      (nrn "=" [(nw "e") (nmeth (nw "kvs") "at" [(nw "i")])])
      (nrn "?" [(npar [(nw "eq") (ndotw "e" "k") (nw "k")])
                (nrelap "some" [(ndotw "e" "v")])])
      (npar [(nw "_") (ndotw "i" "inc")])])
   (nrn "+"
     [(nw "jpath")
      (nslug ["Breadcrumb: p.f, or f at the root."])
      (nrn "\" [(nfc "p" (nw "nat")) (nfc "f" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (nrn "?" [(npar [(nw "eq") (nw "p") (nw "0")]) (nw "f")])
      (npar [(nw "cat2") (npar [(nw "cat2") (nw "p") (nc ".")]) (nw "f")])])
   (nrn "+"
     [(nw "jidx")
      (nslug ["Breadcrumb: p[i]."])
      (nrn "\" [(nfc "p" (nw "nat")) (nfc "i" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (npar [(nw "cat2")
             (npar [(nw "cat2")
                    (npar [(nw "cat2") (nw "p") (nc "[")])
                    (npar [(nw "show_nat") (nw "i")])])
             (nc "]")])])])

(define (sg-td-trees seen td)
  (define kind (_0 td))
  (define name (Ix 1 td))
  (If (Eq "union" kind)
    ;; each arm needs its own value decoder, exactly as a row's element
    ;; type does: request it with req=0 opt=0
    (let* ((disc (Ix 2 td))
           (arms (Ix 3 td))
           (wanted
             (foldl (lambda (acc a) (sg-merge-entry acc [(Ix 1 a) 0 0]))
               [] arms))
           (hst
             (foldl (lambda (st e)
                      (let ((r (sg-part-trees (_0 st) (Ix 0 e) 0 0)))
                        [(_0 r) (Weld (_1 st) (_1 r))]))
               [seen []] wanted)))
      [(_0 hst)
       (Weld (_1 hst)
         [(sg-union-decl-tree name arms)
          (sg-sum-tree (strcat [name "_r"]) (nw name))
          (If (Eq "shape" (_0 disc))
            (sg-union-shape-from-tree name arms)
            (sg-union-from-tree name (Ix 1 disc) arms))
          (sg-union-to-tree name arms)])])
  (If (Eq "enum" kind)
    (let ((vals (Ix 2 td)))
      [seen
       [(sg-enum-decl-tree name vals)
        (sg-sum-tree (strcat [name "_r"]) (nw name))
        (sg-enum-from-tree name vals)
        (sg-enum-to-tree name vals)]])
    (let* ((fields (Ix 2 td))
           (wanted
             (foldl (lambda (acc f)
                      (foldl sg-merge-entry
                        (sg-merge-entry acc
                          [(Ix 1 f) (Ix 2 f) (Nil (Ix 2 f))])
                        (sg-elem-keys (Ix 1 f))))
               [] fields))
           (wanted-sorted
             (Weld (filter (lambda (e) (Nil (Eq "row" (_0 (Ix 0 e))))) wanted)
               (filter (lambda (e) (Eq "row" (_0 (Ix 0 e)))) wanted)))
           (hst
             (foldl (lambda (st e)
                      (let ((r (sg-part-trees (_0 st) (Ix 0 e)
                                 (Ix 1 e) (Ix 2 e))))
                        [(_0 r) (Weld (_1 st) (_1 r))]))
               [seen []] wanted-sorted))
           (seen1 (_0 hst))
           (helpers (_1 hst)))
      [seen1
       (Weld [(sg-rec-decl-tree name fields)
              (sg-sum-tree (strcat [name "_r"]) (nw name))]
         (Weld helpers
           [(sg-rec-from-tree name fields)
            (sg-rec-to-tree name fields)]))]))))

(define (sg-root-trees root-name examples)
  (define rsum (strcat [root-name "_r"]))
  (define rt-lore
    (Weld
      ["Decode then re-encode: the canonical spelling, or"
       "path:why on failure.  The doctest surface."]
      (map (lambda (ex)
             (strcat ["?=  ((rt " (qq (dq-escape ex)) ") "
                      (qq (dq-escape ex)) ")"]))
        examples)))
  [(nrn "+"
     [(nw (strcat ["parse_" root-name]))
      (nslug [(strcat ["Decode a " root-name " from JSON text."])])
      (nrn "\" [(nfc "s" (nw "nat"))])
      (nrn "^" [(nw rsum)])
      (nrn "?"
        [(npar [(nw "parse") (nw "s")])
         (nrn ">" [(npar [(nrn "./" [(nw "err")])
                          (nfc "why" (nw "nat")) (nfc "rest" (nw "nat"))])
                   (nvap rsum "err" [(nw "0") (nw "why")])])
         (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                          (nfc "v" (nw "json")) (nfc "rest" (nw "nat"))])
                   (npar [(nw (strcat [root-name "_from"])) (nw "v") (nw "0")])])])])
   (nrn "+"
     [(nw (strcat ["show_" root-name]))
      (nslug [(strcat ["Encode a " root-name " compactly."])])
      (nrn "\" [(nfc "x" (nw root-name))])
      (nrn "^" [(nw "nat")])
      (npar [(nw "show") (npar [(nw (strcat [root-name "_to"])) (nw "x")])])])
   (nrn "+"
     [(nw "rt")
      (nslug rt-lore)
      (nrn "\" [(nfc "s" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (nrn "?"
        [(npar [(nw (strcat ["parse_" root-name])) (nw "s")])
         (nrn ">"
           [(npar [(nrn "./" [(nw "err")])
                   (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
            (nrn "?" [(npar [(nw "eq") (nw "path") (nw "0")]) (nw "why")])
            (npar [(nw "cat2") (npar [(nw "cat2") (nw "path") (nc ":")])
                   (nw "why")])])
         (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" (nw root-name))])
                   (npar [(nw (strcat ["show_" root-name])) (nw "v")])])])])])

;; -> [root-name tree]
(define (sg-gen-tree show-fn sv)
  (define nt (sg-schema-typedefs sv))
  (define root-name (_0 nt))
  (define tds (_1 nt))
  (define exs-r (jv-get "examples" sv))
  (define examples
    (Ifz exs-r [] (map show-fn (jv-xs! (_0 exs-r)))))
  (define td-trees
    (_1 (foldl (lambda (st td)
                 (let ((r (sg-td-trees (_0 st) td)))
                   [(_0 r) (Weld (_1 st) (_1 r))]))
          [[] []] tds)))
  [root-name
   (ngrp
     (Weld sg-prelude-trees
       (Weld td-trees (sg-root-trees root-name examples))))])

;;; Swagger ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Swagger 2.0 subset: definitions ride through the schema typedef
;;; machinery ($ref spelled #/definitions/<n>); paths/operations map
;;; to an op IR the hand emitter consumes.
;;; op: [opid method segs pparams qparams body resp]
;;;   segs:    [["lit" cord] | ["par" name]] from the path template
;;;   pparams: [[name ftype] ..]   (path params, always required)
;;;   qparams: [[name ftype req] ..]
;;;   body:    0 | [defname]
;;;   resp:    defname (the 200 response $ref)

(define (sg-need k v why)
  (define r (jv-get k v))
  (Ifz r (sg-error why v) (_0 r)))

;;; Spec dialect ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Swagger 2.0 and OpenAPI 3.x say the same things in different
;;; places.  These accessors are the ONLY code that knows which:
;;; everything downstream sees one shape.
;;;
;;;   2.0                          3.x
;;;   definitions                  components.schemas
;;;   basePath ("/v1")             servers[0].url ("https://h/v1")
;;;   parameters[in=body].schema   requestBody.content[mt].schema
;;;   responses.200.schema         responses.200.content[mt].schema

;; 3 when the document is OpenAPI 3.x, 0 when Swagger 2.0.
(define (sg-v3? sv) (Ifz (jv-get "openapi" sv) 0 1))

;; The named-schema map as kvs: [[source-name val] ..].
(define (sg-spec-schemas sv)
  (define r
    (If (sg-v3? sv)
      (let ((c (jv-get "components" sv)))
        (Ifz c 0 (jv-get "schemas" (_0 c))))
      (jv-get "definitions" sv)))
  (Ifz r [] (jv-kvs (_0 r))))

;; The document title, normalized — the generated module's name.
(define (sg-spec-title sv)
  (sg-name (jv-str! (sg-need "title" (sg-need "info" sv "spec: missing info")
                      "spec: info needs title"))))

;; The base url the hand prepends to every path.  2.0 gives a path
;; fragment; 3.x gives a whole origin+prefix, which is the same string
;; in the place the url builders splice it.
(define (sg-spec-base sv)
  (If (sg-v3? sv)
    (let ((ss (jv-get "servers" sv)))
      (Ifz ss ""
        (let ((xs (jv-xs! (_0 ss))))
          (Ifz (Sz xs) ""
            (jv-str! (sg-need "url" (_0 xs) "spec: server needs url"))))))
    (Ifz (jv-get "basePath" sv) "" (jv-str! (_0 (jv-get "basePath" sv))))))

;; What the url builders BAKE IN, as distinct from what the caller
;; injects at the root record's ['base].  Swagger 2.0's basePath is a
;; path fragment, so it belongs in the url and the caller supplies only
;; an origin.  OpenAPI 3.x's servers[0].url is already the whole
;; origin-plus-prefix and IS the injected base, so nothing is baked —
;; baking it too would spell the host twice.
(define (sg-spec-url-prefix sv)
  (If (sg-v3? sv) "" (sg-spec-base sv)))

(define sg-json-mt "application/json")

;; How the document says a client authenticates, in the only shape the
;; hand can act on: a request header.  -> 0, or [header-name prefix]
;; where the header value is prefix ++ the credential.  A query-key or
;; OAuth flow is a different shape and is not guessed at.  The header
;; name is lowercased: HTTP field names are case-insensitive, and a
;; lowercase quip needs no escaping in the emitted path literal.
(define (sg-spec-auth sv)
  (define c (jv-get "components" sv))
  (define (str-at k s d)
    (define r (jv-get k s))
    (Ifz r d (jv-str! (_0 r))))
  (Ifz c 0
    (let ((ss (jv-get "securitySchemes" (_0 c))))
      (Ifz ss 0
        (let ((es (jv-kvs (_0 ss))))
          (Ifz (Sz es) 0
            (let* ((s (Ix 1 (_0 es)))
                   (ty (str-at "type" s ""))
                   (sc (str-at "scheme" s "")))
              (cond
                ((And (Eq ty "http") (Eq sc "bearer")) ["authorization" "Bearer "])
                ((And (Eq ty "apiKey") (Eq "header" (str-at "in" s "")))
                  [(sg-norm-name (str-at "name" s "authorization")) ""])
                (else 0)))))))))

;; The application/json schema out of a 3.x content map.  Other media
;; types (text/event-stream, multipart, audio/*) are a driver-protocol
;; question, not a codegen one: rejected here, deliberately.
(define (sg-content-schema cv why)
  (define kvs (jv-kvs cv))
  (define hit (find (lambda (e) (Eq sg-json-mt (Ix 0 e))) kvs))
  (Ifz hit
    (sg-error (strcat [why " (no " sg-json-mt "; have)"])
      (map (lambda (e) (Ix 0 e)) kvs))
    (sg-need "schema" (Ix 1 (_0 hit)) why)))

;; The request-body schema of an operation: 0 or [schema].
(define (sg-op-body-schema v3 opv)
  (If v3
    (let ((rb (jv-get "requestBody" opv)))
      (Ifz rb 0
        [(sg-content-schema
           (sg-need "content" (_0 rb) "spec: requestBody needs content")
           "spec: requestBody schema")]))
    (let* ((ps (jv-get "parameters" opv))
           (xs (Ifz ps [] (jv-xs! (_0 ps))))
           (hit (find (lambda (p) (Eq "body"
                                   (Ifz (jv-get "in" p) ""
                                     (jv-str! (_0 (jv-get "in" p)))))) xs)))
      (Ifz hit 0
        [(sg-need "schema" (_0 hit) "spec: body param needs schema")]))))

;; The 200-response schema of an operation: 0 or [schema].
(define (sg-op-resp-schema v3 opv)
  (define rs (jv-get "responses" opv))
  (Ifz rs 0
    (let ((r (jv-get "200" (_0 rs))))
      (Ifz r 0
        (If v3
          (let ((c (jv-get "content" (_0 r))))
            (Ifz c 0 [(sg-content-schema (_0 c) "spec: 200 response schema")]))
          (let ((s (jv-get "schema" (_0 r))))
            (Ifz s 0 [(_0 s)])))))))

;;; Ref walking and slicing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; A real spec is far larger than any one client needs (713 schemas
;;; for OpenRouter, ~2100 generated top-levels).  Module load forces
;;; every top-level, so generating whole documents is not viable:
;;; callers name the operations they want and get their transitive
;;; schema closure.

;; Every $ref target named anywhere inside a schema value, source
;; spelling, duplicates included.
(define (sg-refs-of v)
  (define (go v acc)
    (Ifz (IsApp v) acc
      (Ifz (jv-obj? v)
        (Ifz (jv-arr? v) acc (foldl (lambda (a x) (go x a)) acc (Ix 0 v)))
        (foldl
          (lambda (a e)
            (If (Eq "$ref" (Ix 0 e))
              (snoc (sg-ref-target (jv-str! (Ix 1 e))) a)
              (go (Ix 1 e) a)))
          acc (jv-kvs v)))))
  (go v []))

;; Transitive closure of seed names over the schema map (source
;; spellings throughout).  Dangling refs are an error, not a silent
;; drop — the generated module would not compile.
(define (sg-closure schemas seeds)
  (define (lookup nm)
    (define hit (find (lambda (e) (Eq nm (Ix 0 e))) schemas))
    (Ifz hit (sg-error "dangling-ref (no such schema)" nm) (Ix 1 (_0 hit))))
  (define (go pending seen)
    (Ifz (Sz pending) seen
      (let ((nm (_0 pending)) (rest (drop 1 pending)))
        (If (includes (Eq nm) seen)
          (go rest seen)
          (go (Weld rest (sg-refs-of (lookup nm))) (snoc nm seen))))))
  (go (dedupe-eq seeds) []))

;; The operations of a spec as [[path method opv] ..].
(define sg-http-methods ["get" "put" "post" "delete" "patch" "head" "options"])
(define (sg-spec-op-entries sv)
  (foldl
    (lambda (acc pe)
      (foldl
        (lambda (a me)
          (If (includes (Eq (Ix 0 me)) sg-http-methods)
            (snoc [(Ix 0 pe) (Ix 0 me) (Ix 1 me)] a)
            a))
        acc (jv-kvs (Ix 1 pe))))
    [] (jv-kvs (sg-need "paths" sv "spec: missing paths"))))

;; Source-spelled schema names an operation entry directly names.
(define (sg-op-seed-names v3 ent)
  (define opv (Ix 2 ent))
  (define b (sg-op-body-schema v3 opv))
  (define r (sg-op-resp-schema v3 opv))
  (Weld (Ifz (Nil b) (sg-refs-of (_0 b)) [])
    (Ifz (Nil r) (sg-refs-of (_0 r)) [])))

;; Select operations by NORMALIZED operationId.  -> [[path method opv] ..]
(define (sg-select-ops sv opids)
  (define ents (sg-spec-op-entries sv))
  (define (opid-of ent)
    (define r (jv-get "operationId" (Ix 2 ent)))
    (Ifz r "" (sg-norm-name (jv-str! (_0 r)))))
  (define hits (filter (lambda (e) (includes (Eq (opid-of e)) opids)) ents))
  (define got (dedupe-eq (map opid-of hits)))
  (define missing (filter (lambda (o) (Ifz (includes (Eq o) got) 1 0)) opids))
  (Ifz (Sz missing) hits (sg-error "no such operationId" missing)))

;; The schema-name closure needed by a set of operations.
(define (sg-slice sv opids)
  (define v3 (sg-v3? sv))
  (define schemas (sg-spec-schemas sv))
  (define ents (sg-select-ops sv opids))
  (sg-closure schemas
    (foldl (lambda (acc e) (Weld acc (sg-op-seed-names v3 e))) [] ents)))

;; "/pets/{pet_id}" -> [["lit" "pets"] ["par" "pet_id"]]
(define (sg-path-segs s)
  (define cs (trip s))
  (define n (Sz cs))
  (define (seg-of cur)
    (define m (Bytes cur))
    (If (And (Gt m 2)
          (And (Eq 123 (Mod cur 256))
            (Eq 125 (Div cur (Lsh 1 (Mul 8 (Dec m)))))))
      ["par" (sg-name
               (Div (Mod cur (Lsh 1 (Mul 8 (Dec m)))) 256))]
      ["lit" cur]))
  (define (go i cur acc)
    (If (Ge i n)
      (If (Bytes cur) (snoc (seg-of cur) acc) acc)
      (let ((c (Ix i cs)))
        (If (Eq c 47)
          (go (Inc i) "" (If (Bytes cur) (snoc (seg-of cur) acc) acc))
          (go (Inc i) (strcat [cur c]) acc)))))
  (go 0 "" []))

(define (sg-ref-defname v)
  ;; a {"$ref": "#/$defs/x"} object (post-swaggerize) -> "x"
  (define r (sg-ref-name v))
  (Ifz (Nil r) (_0 r) (sg-error "swagger: expected a $ref schema" v)))

;; Resolve a parameter that may itself be a $ref into components.parameters.
(define (sg-param-deref sv p)
  (define r (jv-get "$ref" p))
  (Ifz r p
    (let* ((s (jv-str! (_0 r)))
           (tail (sg-strip-prefix "#/components/parameters/" s)))
      (Ifz tail (sg-error "spec: unsupported parameter $ref" s)
        (let ((c (jv-get "components" sv)))
          (Ifz c (sg-error "spec: parameter $ref with no components" s)
            (sg-need (_0 tail) (sg-need "parameters" (_0 c) "spec: no components.parameters")
              "spec: no such component parameter")))))))

(define (sg-op-of env sv v3 pathstr method opv)
  (define opid
    (sg-name (jv-str! (sg-need "operationId" opv "spec: op needs operationId"))))
  (define params
    (map (lambda (p) (sg-param-deref sv p))
      (Ifz (jv-get "parameters" opv) []
        (jv-xs! (_0 (jv-get "parameters" opv))))))
  (define (req-of p)
    (If (Nil (jv-get "required" p)) 0
      (If (jv? "/boot/json/boo" (_0 (jv-get "required" p)))
        (Ix 0 (_0 (jv-get "required" p))) 0)))
  ;; 3.x puts a parameter's type under `schema`; 2.0 inlines it.
  ;; An enum in a path or query parameter stays a STRING: on the wire
  ;; it is one, the constraint is the server's to enforce, and minting
  ;; a sum per query filter would bury the caller in variants.  Enums
  ;; in bodies and responses are types and are not treated this way.
  (define (ptype p)
    (define s (jv-get "schema" p))
    (define pv (Ifz s p (_0 s)))
    (Ifz (jv-get "enum" pv)
      (sg-ftype-of env pv)
      ["str"]))
  (define (fold-param acc p)
    (define where (jv-str! (sg-need "in" p "spec: param needs in")))
    (define pname (sg-name (jv-str! (sg-need "name" p "spec: param needs name"))))
    (cond
      ((Eq where "path")
        [(snoc [pname (ptype p)] (_0 acc)) (_1 acc)])
      ((Eq where "query")
        [(_0 acc) (snoc [pname (ptype p) (req-of p)] (_1 acc))])
      ;; An OPTIONAL header is omissible without loss (the server
      ;; applies its default); a required one would silently change
      ;; the request, so it stops the build.
      ((Eq where "header")
        (Ifz (req-of p) acc
          (sg-error "spec: required header param unsupported" pname)))
      ;; 2.0's body param is read by sg-op-body-schema, not here.
      ((Eq where "body") acc)
      (else (sg-error "spec: unsupported param location" where))))
  (define pq (foldl fold-param [[] []] params))
  (define body-r (sg-op-body-schema v3 opv))
  (define body
    (Ifz (Nil body-r) [(sg-name (sg-ref-defname (_0 body-r)))] 0))
  (define resp-r (sg-op-resp-schema v3 opv))
  (define resp
    (Ifz (Nil resp-r) (sg-name (sg-ref-defname (_0 resp-r)))
      (sg-error "spec: op needs a 200 response schema" opid)))
  [opid method (sg-path-segs pathstr) (_0 pq) (_1 pq) body resp])

;; -> [name basepath [typedef ..] [op ..]]
;; opids = [] means every operation; otherwise the named ones only,
;; and the typedefs are cut down to their transitive closure.
(define (sg-spec-parts sv opids)
  (define v3 (sg-v3? sv))
  (define name (sg-spec-title sv))
  (define base (sg-spec-base sv))
  (define schemas (sg-spec-schemas sv))
  (define env (sg-env schemas))
  (define ents
    (Ifz (Sz opids) (sg-spec-op-entries sv) (sg-select-ops sv opids)))
  (define reachable
    (Ifz (Sz opids) (map (lambda (e) (Ix 0 e)) schemas)
      (sg-closure schemas
        (foldl (lambda (acc e) (Weld acc (sg-op-seed-names v3 e))) [] ents))))
  ;; an alias is not a type: nothing is emitted for it, and references
  ;; to it were already resolved through by sg-ftype-of
  (define wanted
    (filter (lambda (nm)
              (let ((hit (find (lambda (e) (Eq nm (Ix 0 e))) schemas)))
                (Ifz hit 1 (Nil (sg-alias-subst (Ix 1 (_0 hit)))))))
      reachable))
  ;; injectivity is asserted over the names we actually emit
  (define nm-ok (sg-name-map wanted))
  (define tds
    (sg-topo
      (foldl
        (lambda (acc nm)
          (let ((hit (find (lambda (e) (Eq nm (Ix 0 e))) schemas)))
            (Ifz hit (sg-error "dangling-ref (no such schema)" nm)
              (Weld acc (sg-typedefs-of env (sg-name nm) (Ix 1 (_0 hit)))))))
        [] (Seq nm-ok wanted))))
  (define ops
    (map (lambda (e) (sg-op-of env sv v3 (Ix 0 e) (Ix 1 e) (Ix 2 e))) ents))
  [name base tds ops (sg-spec-auth sv) (sg-spec-url-prefix sv)])

;; Back-compat: the whole document, every operation.
(define (sg-swagger-parts sv) (sg-spec-parts sv []))

;; parse_<t> for every distinct response type: JSON text -> <t>_r.
(define (sg-resp-parser-tree tname)
  (define rsum (strcat [tname "_r"]))
  (nrn "+"
    [(nw (strcat ["parse_" tname]))
     (nslug [(strcat ["Decode a " tname " from JSON text."])])
     (nrn "\" [(nfc "s" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(npar [(nw "parse") (nw "s")])
        (nrn ">" [(npar [(nrn "./" [(nw "err")])
                         (nfc "why" (nw "nat")) (nfc "rest" (nw "nat"))])
                  (nvap rsum "err" [(nw "0") (nw "why")])])
        (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                         (nfc "v" (nw "json")) (nfc "rest" (nw "nat"))])
                  (npar [(nw (strcat [tname "_from"])) (nw "v") (nw "0")])])])]))

;; The swagger TYPES module: definitions + serde + per-response
;; parsers.  (The hand emit joins this tree; reference phase first.)
(define (sg-swagger-types-tree parts)
  (define name (_0 parts))
  (define tds (Ix 2 parts))
  (define ops (Ix 3 parts))
  (define resps (dedupe-eq (map (lambda (o) (Ix 6 o)) ops)))
  (define td-trees
    (_1 (foldl (lambda (st td)
                 (let ((r (sg-td-trees (_0 st) td)))
                   [(_0 r) (Weld (_1 st) (_1 r))]))
          [[] []] tds)))
  [name
   (ngrp
     (Weld sg-prelude-trees
       (Weld td-trees (map sg-resp-parser-tree resps))))])

;;; Hand emitter ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; The kook hand: requests are kids /<root>/[req-id] carrying bond/req
;;; (a sum with one variant per operation); take issues the fetch via
;;; the crew-injected http-client (['http]) and subscribes the req-id
;;; crew slot; hear parses res_body per the originating operation and
;;; answers bond/res with the response type's RESULT VARIANT record.
;;; Shapes mirror the hand-written zz_swagger_ref.foil (the dev
;;; oracle).  Base URL from the root record's ['base].

(define sg-hand-prelude-trees
  [(nrn "-" [(nw "sept") (nbrko "=" [(nw "order") (nw "10")])])
   (nrn "-" [(nw "json") (nbrko "=" [(nw "order") (nw "20")])])
   (nrn "-" [(nw "shrine_types") (nbrko "=" [(nw "order") (nw "30")])])
   (nrn "-" [(nw "lain") (nbrko "=" [(nw "order") (nw "40")])])
   (nrn "-" [(nw "web") (nbrko "=" [(nw "order") (nw "50")])])
   (nrn "-" [(nw "bond") (nbrko "=" [(nw "order") (nw "60")])])
   (nrn "-" [(nw "pact") (nbrko "=" [(nw "order") (nw "70")])])])

;; the generated TYPES module, imported by name at order 80
(define (sg-types-import name)
  (nrn "-" [(nw name) (nbrko "=" [(nw "order") (nw "80")])]))

;; a match arm (./some x) / .none pair helpers
(define (nsome-arm binder ty body-kids)
  (nrn ">" (Weld [(npar [(nrn "./" [(nw "some")])
                         (If ty (nfc binder ty) (nw binder))])]
             body-kids)))
(define (nnone-arm body) (nrn ">" [(nrelv "none") body]))

(define (nquip s) (rex:MakeLeaf nzsp "quip" s))
;; ['base] / ['io 'http] — bracketed quip path literals
(define (npl segs)
  (nbrk (map (lambda (t) (nquip (strcat ["'" t]))) segs)))
(define (nmget recv slot) (nmeth recv "get" [slot]))
;; (a/b) — parse normalization absorbs a paren's single rune kid into
;; the paren itself, so emit the absorbed form directly.
(define (nparp segs) (rex:MakeNest nzsp "paren" "/" (map nw segs)))
(define (nself args) (npar (Weld [(nw "_")] args)))
(define nyell (npar [(nw "yell") (nw "cards") (nw "out")]))
(define nskip (nself [(nw "next") (nw "cards") (nw "out")]))
;; row[[p=path q=writ]]
(define ncards-ty
  (nspec "row" [(nbrk [(nfc "p" (nw "path")) (nfc "q" (nw "writ"))])]))
;; the i/cards/out loop head (one-line > chain nests successively)
(define nloop-head
  (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")
                      (nrn ">" [(nfc "cards" ncards-ty) (nbrk [])
                                (nrn ">" [(nfc "out" (nw "myth"))
                                          (nw "cur")])])])]))

(define sg-hand-fixed-trees-a
  [(nrn "+"
     [(nw "base_of")
      (nslug ["The server base url from the root record's ['base]."])
      (nrn "\" [(nfc "cur" (nw "myth"))])
      (nrn "^" [(nw "nat")])
      (nrn "?"
        [(nmget (nw "cur") (npl ["base"]))
         (nsome-arm "held" (nw "pail")
           [(nrn "?" [(nw "held")
                      (nrn ">" [(nfc "t" (npth ["pails" "t"]))
                                (ndotw "t" "t")])
                      (nw "0")])])
         (nw "0")])])
   (nrn "+"
     [(nw "qjoin")
      (nslug ["The query string from k=v fragments, skipping the absent"
              "ones (0): ? before the first that is set, & between the"
              "rest.  Empty when nothing is set.  Values are spliced"
              "verbatim — percent-encoding is not done yet."])
      (nrn "\" [(nfc "ps" (nspec "row" [(nw "nat")]))])
      (nrn "^" [(nw "nat")])
      (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")
                          (nrn ">" [(nfc "out" (nw "nat")) (nw "0")
                                    (nrn ">" [(nfc "some" (nw "bool"))
                                              (nrelv "false")])])])])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "ps" "len")])
                (nw "out")])
      (nrn "=" [(nw "p") (nmeth (nw "ps") "at" [(nw "i")])])
      (nrn "?" [(npar [(nw "eq") (nw "p") (nw "0")])
                (nself [(ndotw "i" "inc") (nw "out") (nw "some")])])
      (nrn "?" [(nw "some")
                (nself [(ndotw "i" "inc")
                        (npar [(nw "cat2")
                               (npar [(nw "cat2") (nw "out") (nc "&")])
                               (nw "p")])
                        (nrelv "true")])])
      (nself [(ndotw "i" "inc")
              (npar [(nw "cat2") (nc "?") (nw "p")])
              (nrelv "true")])])
   (nrn "+"
     [(nw "auth_of")
      (nslug ["The credential from the root record's ['auth], or 0 when"
              "none was injected — an unauthenticated call is a real"
              "case, so a missing credential is not an error here."])
      (nrn "\" [(nfc "cur" (nw "myth"))])
      (nrn "^" [(nw "nat")])
      (nrn "?"
        [(nmget (nw "cur") (npl ["auth"]))
         (nsome-arm "held" (nw "pail")
           [(nrn "?" [(nw "held")
                      (nrn ">" [(nfc "t" (npth ["pails" "t"]))
                                (ndotw "t" "t")])
                      (nw "0")])])
         (nw "0")])])
   (nrn "+"
     [(nw "crew_of_rec")
      (nslug ["The crew mop in a record's /sys/crew, or empty."])
      (nrn "\" [(nfc "cur" (nw "myth"))])
      (nrn "^" [(nw "crew")])
      (nrn "?"
        [(nmget (nw "cur") (npth ["bond" "crew"]))
         (nsome-arm "held" (nw "pail")
           [(nrn "?" [(nw "held")
                      (nrn ">" [(nfc "c" (nw "cpail")) (ndotw "c" "crew")])
                      (npar [(npth ["mop" "empty"])])])])
         (npar [(npth ["mop" "empty"])])])])
   (nrn "+"
     [(nw "http_of")
      (nslug ["The injected http-client root from the crew slot ['http]."])
      (nrn "\" [(nfc "cur" (nw "myth"))])
      (nrn "^" [(nspec "maybe" [(nw "path")])])
      (nrn "?"
        [(nmget (npar [(nw "crew_of_rec") (nw "cur")]) (npl ["http"]))
         (nnone-arm (nrelv "none"))
         (nsome-arm "d" (nw "dep")
           [(nrelap "some" [(ndotw "d" "p")])])])])
   (nrn "+"
     [(nw "crew_put")
      (nrn "\" [(nfc "cur" (nw "myth")) (nfc "slot" (nw "path"))
                (nfc "d" (nw "dep"))])
      (nrn "^" [(nw "myth")])
      (nmeth (nw "cur") "put"
        [(npth ["bond" "crew"])
         (npar [(nw "cpail")
                (nmeth (npar [(nw "crew_of_rec") (nw "cur")]) "put"
                  [(nw "slot") (nw "d")])])])])
   (nrn "+"
     [(nw "crew_del")
      (nrn "\" [(nfc "cur" (nw "myth")) (nfc "slot" (nw "path"))])
      (nrn "^" [(nw "myth")])
      (nrn "=" [(nw "es")
                (ndot (npar [(nw "crew_of_rec") (nw "cur")]) (nw "tap"))])
      (nrn "="
        [(nw "c2")
         (ngrp
           [(nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")
                                (nrn ">" [(nfc "acc" (nw "crew"))
                                          (npar [(npth ["mop" "empty"])])])])])
            (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "es" "len")])
                      (nw "acc")])
            (nrn "=" [(nw "h") (nmeth (nw "es") "at" [(nw "i")])])
            (nrn "?" [(npar [(nw "eq_pith") (ndotw "h" "key") (nw "slot")])
                      (nself [(ndotw "i" "inc") (nw "acc")])])
            (nself [(ndotw "i" "inc")
                    (nmeth (nw "acc") "put"
                      [(ndotw "h" "key") (ndotw "h" "val")])])])])
      (nmeth (nw "cur") "put"
        [(npth ["bond" "crew"]) (npar [(nw "cpail") (nw "c2")])])])
   (nrn "+"
     [(nw "crew_slot_for")
      (nslug ["The crew slot whose dep watches path p."])
      (nrn "\" [(nfc "cur" (nw "myth")) (nfc "p" (nw "path"))])
      (nrn "^" [(nspec "maybe" [(nw "path")])])
      (nrn "=" [(nw "es")
                (ndot (npar [(nw "crew_of_rec") (nw "cur")]) (nw "tap"))])
      (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")])])
      (nrn "^" [(nspec "maybe" [(nw "path")])])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "es" "len")])
                (nrelv "none")])
      (nrn "=" [(nw "h") (nmeth (nw "es") "at" [(nw "i")])])
      (nrn "?" [(npar [(nw "eq_pith")
                       (nrn "." [(nw "h") (nw "val") (nw "p")])
                       (nw "p")])
                (nrelap "some" [(ndotw "h" "key")])])
      (nself [(ndotw "i" "inc")])])])

(define sg-hand-fixed-trees-b
  [(nrn "+"
     [(nw "take")
      (nslug ["Handle request kids: for each non-deleted gift with a bond/req"
              "and no bond/res, emit the fetch make-card and subscribe the"
              "req-id crew slot to the fetch node."])
      (nrn "\" [(nfc "b" (nw "bowl")) (nfc "cur" (nw "myth"))
                (nfc "gift" (nspec "axal" [(nw "mode")]))])
      (nrn "^" [(nw "yell")])
      (nrn "=" [(nw "entries") (ndotw "gift" "tap")])
      nloop-head
      (nrn "^" [(nw "yell")])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "entries" "len")])
                nyell])
      (nrn "=" [(nw "ent") (nmeth (nw "entries") "at" [(nw "i")])
                (njx [(nw "next") (ndotw "i" "inc")])])
      (nrn "=" [(nbrk [(nfc "gp" (nw "path")) (nfc "gm" (nw "mode"))])
                (nw "ent")])
      (nrn "?"
  [(nw "gm")
    (nrn ">" [(nfc "d0" (npth ["mode" "del"])) nskip])
    (nrn "?"
      [(nmget (ndotw "b" "kids") (nw "gp"))
        (nnone-arm nskip)
        (nsome-arm
          "t"
          (nw "myth")
          [(nrn "?"
              [(nmget (nw "t") (npth ["bond" "res"]))
                (nsome-arm "done" (nw "pail") [nskip])
                (nnone-arm
                  (nrn "?"
                    [(nmget (nw "t") (npth ["bond" "req"]))
                      (nnone-arm nskip)
                      (nsome-arm
                        "held"
                        (nw "pail")
                        [(nrn "="
                            [(nw "fr")
                              (npar [(nw "fetch_for") (npar [(nw "base_of") (nw "cur")]) (npar [(nw "auth_of") (nw "cur")]) (nw "held")])])
                          (nrn "?" [(npar [(nw "eq") (nw "0") (ndotw "fr" "len")]) nskip])
                          (nrn "?"
                            [(npar [(nw "http_of") (nw "out")])
                              (nnone-arm nskip)
                              (nsome-arm
                                "hp"
                                (nw "path")
                                [(nrn "=" [(nw "dst") (nmeth (nw "hp") "weld" [(nw "gp")])])
                                  (nself
                                    [(nw "next")
                                      (nmeth
                                        (nw "cards")
                                        "snoc"
                                        [(nbrk
                                            [(nw "dst") (npar [(npth ["writ" "make"]) (nmeth (nw "fr") "at" [(nw "0")])])])])
                                      (npar
                                        [(nw "crew_put")
                                          (nw "out")
                                          (nw "gp")
                                          (npar [(nw "dep") (nparp ["care" "x"]) (nw "dst")])])])])])])]))])])])])])
   (nrn "+"
     [(nw "pd_of")
      (nslug ["Any nominal record as a pail, unchanged (records inhabit pails)."])
      (nrn "\" [(nfc "v" (nw "pail"))])
      (nrn "^" [(nw "pail")])
      (nw "v")])
   (nrn "+"
     [(nw "res_body_nat")
      (nrn "\" [(nfc "fm" (nw "myth")) (nfc "slot" (nw "path"))])
      (nrn "^" [(nw "nat")])
      (nrn "?"
        [(nmget (nw "fm") (nw "slot"))
         (nsome-arm "bp" (nw "pail")
           [(nrn "?" [(nw "bp")
                      (nrn ">" [(nfc "n" (npth ["pails" "n"]))
                                (ndotw "n" "n")])
                      (nw "0")])])
         (nw "0")])])])

(define (sg-hand-fixed-trees-c name)
  [(nrn "+"
     [(nw "hear")
      (nslug ["Handle fetch completions: parse res_body per the originating"
              "request's operation, answer bond/res, unsubscribe."])
      (nrn "\" [(nfc "b" (nw "bowl")) (nfc "cur" (nw "myth"))
                (nfc "changed" (nspec "row" [(nw "dep")]))])
      (nrn "^" [(nw "yell")])
      nloop-head
      (nrn "^" [(nw "yell")])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "changed" "len")])
                nyell])
      (nrn "=" [(nw "d") (nmeth (nw "changed") "at" [(nw "i")])
                (njx [(nw "next") (ndotw "i" "inc")])])
      (nrn "?"
  [(npar [(nw "crew_slot_for") (nw "out") (ndotw "d" "p")])
    (nnone-arm nskip)
    (nsome-arm
      "k"
      (nw "path")
      [(nrn "?"
          [(nmget (ndotw "b" "crew") (nw "k"))
            (nnone-arm nskip)
            (nsome-arm
              "ax"
              0
              [(nrn "?"
                  [(ndotw "ax" "fil")
                    (nnone-arm nskip)
                    (nsome-arm
                      "fm"
                      (nw "myth")
                      [(nrn "?"
                          [(nmget (nw "fm") (npl ["res_done"]))
                            (nnone-arm nskip)
                            (nsome-arm
                              "dn"
                              (nw "pail")
                              [(nrn "="
                                  [(nw "okf")
                                    (npar [(nw "res_body_nat") (nw "fm") (npl ["res_ok"])])
                                    (njx
                                      [(nw "body") (npar [(nw "res_body_nat") (nw "fm") (npl ["res_body"])])])])
                                (nrn "?"
                                  [(nmget (ndotw "b" "kids") (nw "k"))
                                    (nnone-arm nskip)
                                    (nsome-arm
                                      "t"
                                      (nw "myth")
                                      [(nrn "?"
                                          [(nmget (nw "t") (npth ["bond" "req"]))
                                            (nnone-arm nskip)
                                            (nsome-arm
                                              "held"
                                              (nw "pail")
                                              [(nrn "="
                                                  [(nw "ecode")
                                                    (npar
                                                      [(nw "cat2")
                                                        (nc "fetch-err-")
                                                        (npar
                                                          [(nw "show_nat") (npar [(nw "res_body_nat") (nw "fm") (npl ["res_err"])])])])])
                                                (nrn "="
                                                  [(nw "resp")
                                                    (npar [(nw "resp_for") (nw "held") (nw "okf") (nw "body") (nw "ecode")])])
                                                (nrn "?" [(npar [(nw "eq") (nw "0") (ndotw "resp" "len")]) nskip])
                                                (nself
                                                  [(nw "next")
                                                    (nmeth
                                                      (nw "cards")
                                                      "snoc"
                                                      [(nbrk
                                                          [(nw "k")
                                                            (npar
                                                              [(npth ["writ" "poke"])
                                                                (npar
                                                                  [(npth ["myth" "sing"])
                                                                    (npth ["bond" "res"])
                                                                    (nmeth (nw "resp") "at" [(nw "0")])])])])])
                                                    (npar [(nw "crew_del") (nw "out") (nw "k")])])])])])])])])])])])])])])])
   (nrn "+"
     [(nw "serve")
      (nslug ["The generated behavior: requests in take, responses in hear."])
      (nrn "^" [(nw "form")])
      (nrn "." [(nw "def_form")
                (njx [(nw "set_take") (npar [(nw "take")])])
                (njx [(nw "set_hear") (npar [(nw "hear")])])])])
   (nrn "+"
     [(nw "decl")
      (nrn "^" [(npth ["kook" "decl"])])
      (npar [(npth ["kook" "decl"]) (nquip (strcat ["'" name])) (nw "serve")
             (npar [(npth ["lore" "line"])
                    (nc (strcat ["Generated " name " API hand."]))])])])])

;; url piece plan for one op: merge literal runs, params by ftype.
;; -> the url builder member tree.
(define (sg-url-tree base op)
  (define opid (Ix 0 op))
  (define segs (Ix 2 op))
  (define pparams (Ix 3 op))
  (define qparams (Ix 4 op))
  (define (conv ft x)
    (cond
      ((Eq "int" (_0 ft)) (npar [(nw "show_nat") x]))
      ((Eq "str" (_0 ft)) x)
      ;; a number is already carried as its decimal text
      ((Eq "num" (_0 ft)) x)
      (else (sg-error "swagger: unsupported url param type" ft))))
  (define (pft name)
    (define hit (find (lambda (pp) (Eq name (Ix 0 pp))) pparams))
    (Ifz hit (sg-error "swagger: path param not declared" name)
      (Ix 1 (_0 hit))))
  ;; fold segs into [lit-run-cord | ["p" name]] pieces
  (define pieces
    (foldl
      (lambda (acc sg)
        (If (Eq "lit" (_0 sg))
          (let ((lastlit (And (Sz acc)
                           (Nil (IsApp (Ix (Dec (Sz acc)) acc))))))
            (If lastlit
              (Up (Dec (Sz acc))
                (strcat [(Ix (Dec (Sz acc)) acc) "/" (Ix 1 sg)]) acc)
              (snoc (strcat ["/" (Ix 1 sg)]) acc)))
          (let ((lastlit (And (Sz acc)
                           (Nil (IsApp (Ix (Dec (Sz acc)) acc))))))
            (If lastlit
              (snoc ["p" (Ix 1 sg)]
                (Up (Dec (Sz acc)) (strcat [(Ix (Dec (Sz acc)) acc) "/"]) acc))
              (snoc ["p" (Ix 1 sg)] (snoc "/" acc))))))
      (If (Bytes base) [base] [])
      segs))
  ;; base expr: cat2-chain over pieces onto the base param
  (define url-expr
    (foldl
      (lambda (acc pc)
        (If (IsApp pc)
          (npar [(nw "cat2") acc (conv (pft (Ix 1 pc)) (nw (Ix 1 pc)))])
          (npar [(nw "cat2") acc (nc pc)])))
      (nw "u0")
      pieces))
  (define params
    (Weld
      (map (lambda (pp) (nfc (Ix 0 pp) (sg-ft-ty-t (Ix 1 pp)))) pparams)
      (map (lambda (qp)
             (nfc (Ix 0 qp)
               (If (Ix 2 qp) (sg-ft-ty-t (Ix 1 qp))
                 (sg-maybe-t (sg-ft-ty-t (Ix 1 qp))))))
        qparams)))
  ;; Each query param becomes a "k=v" fragment, or 0 when an optional
  ;; one is absent.  Which fragment gets the "?" and which get "&"
  ;; cannot be decided here — it depends on what is set at the call —
  ;; so qjoin settles it at runtime.
  (define (qfrag qp)
    (define qn (Ix 0 qp))
    (define pref (nc (strcat [qn "="])))
    (define (kv x) (npar [(nw "cat2") pref (conv (Ix 1 qp) x)]))
    (nrn "="
      [(nw (strcat ["q_" qn]))
       (If (Ix 2 qp)
         (kv (nw qn))
         (nrn "?" [(nw qn)
                   (nnone-arm (nw "0"))
                   (nsome-arm "qv" 0 [(kv (nw "qv"))])]))]))
  (define qtail
    (Ifz (Sz qparams) [(nw "u1")]
      (Weld (map qfrag qparams)
        [(npar [(nw "cat2") (nw "u1")
                (npar [(nw "qjoin")
                       (nbrk (map (lambda (qp)
                                    (nw (strcat ["q_" (Ix 0 qp)])))
                               qparams))])])])))
  (nrn "+"
    (Weld
      [(nw (strcat ["url_" opid]))
       (nrn "\" (Weld [(nfc "u0" (nw "nat"))] params))
       (nrn "^" [(nw "nat")])
       (nrn "=" [(nw "u1") url-expr])]
      qtail)))

;; The req sum: a variant per operation.
(define (sg-req-sum-tree ops)
  (define (vfields op)
    (Weld
      (map (lambda (pp) (nfc (Ix 0 pp) (sg-ft-ty-t (Ix 1 pp)))) (Ix 3 op))
      (Weld
        (map (lambda (qp)
               (nfc (Ix 0 qp)
                 (If (Ix 2 qp) (sg-ft-ty-t (Ix 1 qp))
                   (sg-maybe-t (sg-ft-ty-t (Ix 1 qp))))))
          (Ix 4 op))
        (Ifz (Ix 5 op) []
          [(nrn "=" [(nw (_0 (Ix 5 op)))])]))))
  (nrn "+"
    (Weld
      [(nw "req")
       (nslug ["One request: a variant per swagger operation."])
       (nrn "&" (map (lambda (o) (npth ["req" (Ix 0 o)])) ops))]
      (map (lambda (o)
             (nrn "+" [(nw (Ix 0 o)) (nrn ":" (vfields o))]))
        ops))))

;; fetch_for: the driver request myth per req variant.
(define (sg-fetch-for-tree ops auth)
  ;; The driver honors one ['hdr <name>] slot per request header, so the
  ;; credential rides as a slot put onto the request record rather than
  ;; anything the fetch/req builder knows about.
  (define (with-auth req)
    (Ifz auth req
      (nmeth req "put"
        [(npl ["hdr" (_0 auth)])
         (npar [(nw "pd")
                (npar [(nw "cat2") (nc (Ix 1 auth)) (nw "auth")])])])))
  (define (arm i op)
    (define opid (Ix 0 op))
    (define b (nw (strcat ["g" (nat-str i)])))
    (define url-args
      (Weld
        (map (lambda (pp) (ndot b (nw (Ix 0 pp)))) (Ix 3 op))
        (map (lambda (qp) (ndot b (nw (Ix 0 qp)))) (Ix 4 op))))
    (define body-expr
      (Ifz (Ix 5 op) (nw "0")
        (npar [(nw "show")
               (npar [(nw (strcat [(_0 (Ix 5 op)) "_to"]))
                      (ndot b (nw (_0 (Ix 5 op))))])])))
    (define mth
      (cond
        ((Eq "get" (Ix 1 op)) "GET")
        ((Eq "post" (Ix 1 op)) "POST")
        ((Eq "put" (Ix 1 op)) "PUT")
        ((Eq "delete" (Ix 1 op)) "DELETE")
        (else (sg-error "swagger: unsupported method" (Ix 1 op)))))
    (nrn ">"
      [(nfc (strcat ["g" (nat-str i)]) (npth ["req" opid]))
       (nbrk [(with-auth
                (npar (Weld [(npth ["fetch" "req"]) (nc mth)
                             (npar (Weld [(nw (strcat ["url_" opid]))
                                          (nw "base")]
                                     url-args))]
                        [body-expr (nw "30000")])))])]))
  (nrn "+"
    (Weld
      [(nw "fetch_for")
       (nslug ["The driver request myth for one req variant, or empty"
               "row when the pail is not a request."])
       (nrn "\" [(nfc "base" (nw "nat")) (nfc "auth" (nw "nat"))
                 (nfc "held" (nw "pail"))])
       (nrn "^" [(nspec "row" [(nw "myth")])])]
      (Weld [(nrn "?" (Weld [(nw "held")]
                        (Weld (map (lambda (i) (arm i (Ix i ops)))
                                (gen (Sz ops) (lambda (i) i)))
                          [(nbrk [])])))]
        []))))

;; resp_for: parse per originating op; result VARIANT records as pails.
(define (sg-resp-for-tree ops)
  (define (arm i op)
    (define opid (Ix 0 op))
    (define resp (Ix 6 op))
    (define rs (strcat [resp "_r"]))
    (define ix (nat-str i))
    (nrn ">"
      [(nfc (strcat ["g" ix]) (npth ["req" opid]))
       (nrn "?"
         [(nw "okf")
          (nrn "?"
            [(npar [(nw (strcat ["parse_" resp])) (nw "body")])
             (nrn ">" [(nfc (strcat ["o" ix]) (npth [rs "ok"]))
                       (nbrk [(npar [(nw "pd_of") (nw (strcat ["o" ix]))])])])
             (nrn ">" [(nfc (strcat ["e" ix]) (npth [rs "err"]))
                       (nbrk [(npar [(nw "pd_of") (nw (strcat ["e" ix]))])])])])])
       (nbrk [(npar [(nw "pd_of")
                     (nvap rs "err" [(nc "") (nw "ecode")])])])]))
  (nrn "+"
    (Weld
      [(nw "resp_for")
       (nslug ["The bond/res pail for one completed fetch: parse per the"
               "originating operation, or the op's error record."])
       (nrn "\" [(nfc "held" (nw "pail")) (nfc "okf" (nw "nat"))
                 (nfc "body" (nw "nat")) (nfc "ecode" (nw "nat"))])
       (nrn "^" [(nspec "row" [(nw "pail")])])]
      [(nrn "?" (Weld [(nw "held")]
                  (Weld (map (lambda (i) (arm i (Ix i ops)))
                          (gen (Sz ops) (lambda (i) i)))
                    [(nbrk [])])))])))

;; -> [name tree]: the HAND module.  Types + serde live in the
;; separate types module (gen-swagger-types), imported by name — the
;; arrangement the hand-written reference validated.
(define (sg-swagger-hand-tree parts)
  (define name (_0 parts))
  ;; the prefix to bake, NOT the injected base — see sg-spec-url-prefix
  (define base (Ix 5 parts))
  (define ops (Ix 3 parts))
  [(strcat [name "_hand"])
   (ngrp
     (Weld (snoc (sg-types-import name) sg-hand-prelude-trees)
       (Weld
         [(nslug-top
            [(strcat ["Generated by schemagen from the " name " swagger."])
             "The schema is the source of truth; there is no source file"
             "to edit.  Requests are kids /<root>/[req-id] carrying"
             "bond/req; answers arrive in bond/res."])]
         (Weld [(sg-req-sum-tree ops)]
           (Weld (map (lambda (o) (sg-url-tree base o)) ops)
             (Weld sg-hand-fixed-trees-a
               (Weld [(sg-fetch-for-tree ops (Ix 4 parts))]
                 (Weld sg-hand-fixed-trees-b
                   (Weld [(sg-resp-for-tree ops)]
                     (sg-hand-fixed-trees-c name))))))))))])

;;; Public API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Parse a schema document with json.foil's parse (jsut: a compiled
;; json subject).
(define (sg-schema-value jsut txt)
  (define r ((foil:source-entry-val ["parse"] jsut) txt))
  (If (Eq "/boot/jres/ok" (Hd r))
    (Ix 0 r)
    (sg-error "schema-json" (Ix 0 r))))

;; Generate the module tree for a schema document.  -> [name tree]
(define (gen-tree jsut schema-txt)
  (sg-gen-tree (foil:source-entry-val ["show"] jsut)
    (sg-schema-value jsut schema-txt)))

;;; Spec inspection ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Read-only queries over a spec document: what it declares, and how
;;; much of it today's type subset can express.  The coverage number
;;; is a RATCHET (see foil-schemagen-tests): it may only go up.

;; [v3? title base #schemas #ops]
(define (spec-summary sv)
  [(sg-v3? sv) (sg-spec-title sv) (sg-spec-base sv)
   (Sz (sg-spec-schemas sv)) (Sz (sg-spec-op-entries sv))])

;; Normalized operationIds, in document order.
(define (spec-opids sv)
  (map (lambda (e)
         (let ((r (jv-get "operationId" (Ix 2 e))))
           (Ifz r "" (sg-norm-name (jv-str! (_0 r))))))
    (sg-spec-op-entries sv)))

;; The transitive schema closure of named operations (source spellings).
(define (spec-slice sv opids) (sg-slice sv opids))

;; Can this named schema be expressed?  An ALIAS counts as expressible:
;; it emits no type of its own, and every reference to it resolves
;; through to what it names.  -> 0, or [name why]
(define (sg-cov-check env schemas nm)
  (define hit (find (lambda (e) (Eq nm (Ix 0 e))) schemas))
  (Ifz hit [nm "dangling-ref (no such schema)"]
    (let* ((v (Ix 1 (_0 hit)))
           (r (Try (lambda (z)
                     (Ifz (Nil (sg-alias-subst v))
                       (let ((ft (sg-ftype-of env v))) (DeepSeq ft ft))
                       (let ((td (sg-typedef-of env (sg-name nm) v)))
                         (DeepSeq td td)))) 0)))
      (If (Eq 1 (Hd r)) [nm (Ix 1 (_0 r))] 0))))

;; How many named schemas the typedef IR can express today.
;; -> [clean total [[name why] ..]]  (why = the first rejection reason)
(define (spec-coverage sv)
  (define schemas (sg-spec-schemas sv))
  (define env (sg-env schemas))
  (define rs (map (lambda (e) (sg-cov-check env schemas (Ix 0 e))) schemas))
  (define bad (filter (lambda (x) (Ifz (Nil x) 1 0)) rs))
  [(Sub (Sz schemas) (Sz bad)) (Sz schemas) bad])

;; Coverage restricted to one operation's closure. -> [clean total bad]
(define (spec-coverage-of sv opids)
  (define schemas (sg-spec-schemas sv))
  (define env (sg-env schemas))
  (define names (sg-slice sv opids))
  (define rs (map (lambda (nm) (sg-cov-check env schemas nm)) names))
  (define bad (filter (lambda (x) (Ifz (Nil x) 1 0)) rs))
  [(Sub (Sz names) (Sz bad)) (Sz names) bad])

;; Generate AND compile.  -> [name tree subject]
(define (compile-schema sut jsut schema-txt)
  (define g (gen-tree jsut schema-txt))
  [(_0 g) (_1 g)
   (foil:compile-rex sut (_0 g) (_1 g))])

;; Swagger: generate the TYPES module tree.  -> [name basepath ops tree]
;; opids = [] for the whole document, or the operations wanted — a real
;; spec is far larger than any one client needs, and module load forces
;; every top-level, so naming the operations is the normal case.
(define (gen-swagger-types jsut swagger-txt opids)
  (define parts (sg-spec-parts (sg-schema-value jsut swagger-txt) opids))
  (define nt (sg-swagger-types-tree parts))
  [(_0 nt) (Ix 1 parts) (Ix 3 parts) (_1 nt)])

;; Swagger: generate the HAND module tree (imports the types module by
;; name).  -> [hand-name tree]
(define (gen-swagger-hand jsut swagger-txt opids)
  (sg-swagger-hand-tree
    (sg-spec-parts (sg-schema-value jsut swagger-txt) opids)))

;; Generate AND compile both modules: the types module first, then the
;; hand against a cache holding it (a tree-fed module has no file, so
;; the hand's by-name import must resolve from the cache).
;; -> [types-name hand-name subject]
(define (compile-swagger-hand sut jsut swagger-txt opids)
  (define parts (sg-spec-parts (sg-schema-value jsut swagger-txt) opids))
  (define tname (_0 parts))
  (define tnt (sg-swagger-types-tree parts))
  (define c1 (foil:compile-rex-cached 0 sut tname (_1 tnt)))
  (define hnt (sg-swagger-hand-tree parts))
  (define c2 (foil:compile-rex-cached (_0 c1) sut (_0 hnt) (_1 hnt)))
  [tname (_0 hnt) (_1 c2)])
