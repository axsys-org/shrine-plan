;;;; schemagen: JSON schema -> foil types + serde, compiled with no
;;;; source text at all.  The schema (parsed by json.foil) maps to a
;;;; typedef IR, the IR emits NORMALIZED REX directly (Leaf/Nest/Juxt
;;;; with inert zero spans — the structure refactor made spans pure
;;;; diagnostics), and the tree feeds foil:compile-rex.  A human view
;;;; is a printer concern, not a compilation artifact.
;;;;
;;;; v1 subset: records (object + required/optional -> maybe), string/
;;;; integer/boolean fields, arrays of prims/refs, #/$defs/<n> refs
;;;; (topo-sorted, cycles rejected), string enums -> sums.  Rejected
;;;; loudly: floats ("number"), inline objects/enums (hoist to $defs),
;;;; nested arrays, oneOf (v2 - rides the enum machinery).

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

;;; json value access (reps probed 2026-07-28: cstr-headed apps,
;;; brands "/boot/json/<v>", fields from Ix 0) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (sg-error why what) (error ["schemagen" why what]))

(define (jv? tag v) (And (IsApp v) (Eq tag (Hd v))))
(define (jv-obj? v) (jv? "/boot/json/obj" v))
(define (jv-str? v) (jv? "/boot/json/str" v))
(define (jv-arr? v) (jv? "/boot/json/arr" v))

(define (jv-str! v)
  (Ifz (jv-str? v) (sg-error "expected-string" v) (Ix 0 v)))
(define (jv-kvs v) (Ix 0 v))
(define (jv-xs! v)
  (Ifz (jv-arr? v) (sg-error "expected-array" v) (Ix 0 v)))

;; The value at key k: 0 or [val].
(define (jv-get k v)
  (Ifz (jv-obj? v) 0
    (let ((hit (find (lambda (e) (Eq k (Ix 0 e))) (jv-kvs v))))
      (Ifz hit 0 [(Ix 1 (_0 hit))]))))

;;; Names ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (sg-word-byte? c)
  (Or (And (Ge c 97) (Le c 122))
    (Or (Eq c 95) (And (Ge c 48) (Le c 57)))))

(define (sg-sane-name? s)
  (define cs (trip s))
  (And (Sz cs)
    (And (And (Ge (_0 cs) 97) (Le (_0 cs) 122))
      (all sg-word-byte? cs))))

;; The import surface (json + the generated prelude) a schema name must
;; not shadow.  Generated per-type names (T_r, T_from, T_to, d_*, r_*)
;; are prefixed or suffixed away from single-word schema names.
(define sg-reserved
  ["jres" "json" "jkv" "jnull" "cat2" "snoc8" "show_nat" "ws" "lit"
   "digit" "hexv" "hexd" "hex2" "utf8" "hex4" "esc2" "p_str" "p_num"
   "p_arr" "p_obj" "p_val" "parse" "show_str" "show" "rt"
   "jget" "jpath" "jidx" "maybe" "bool" "nat" "row" "ok" "err"])

(define (sg-check-name s)
  (Ifz (sg-sane-name? s) (sg-error "bad-name (want [a-z][a-z0-9_]*)" s)
    (If (includes (Eq s) sg-reserved) (sg-error "reserved-name" s) s)))

(define (dedupe-eq xs)
  (foldl (lambda (acc x) (If (includes (Eq x) acc) acc (snoc x acc))) [] xs))

(define (nat-str n)
  (If (Lt n 10) (Add "0" n)
    (strcat [(nat-str (Div n 10)) (Add "0" (Mod n 10))])))

;; Double every quote byte for embedding in a foil cord literal.
(define (dq-escape s)
  (strcat
    (map (lambda (c) (If (Eq c 34) (strcat [34 34]) c))
      (trip s))))

;;; Schema -> typedef IR ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; ftype:   ["str"] ["int"] ["bool"] ["ref" name] ["row" ftype]
;;; field:   [name ftype req]
;;; typedef: ["rec" name fields] | ["enum" name [vname ..]]

(define sg-ref-prefix "#/$defs/")

(define (sg-ref-name v)
  (define r (jv-get "$ref" v))
  (Ifz r 0
    (let* ((s (jv-str! (_0 r)))
           (w (Lsh 1 (Mul 8 (Bytes sg-ref-prefix)))))
      (Ifz (Eq sg-ref-prefix (Mod s w))
        (sg-error "bad-ref (want #/$defs/<name>)" s)
        [(Div s w)]))))

(define (sg-type-str v)
  (define t (jv-get "type" v))
  (Ifz t 0 [(jv-str! (_0 t))]))

(define (sg-ftype-of v)
  (define r (sg-ref-name v))
  (Ifz (Nil r) ["ref" (sg-check-name (_0 r))]
    (Ifz (Nil (jv-get "enum" v))
      (sg-error "inline-enum (hoist to $defs)" v)
      (let ((t (sg-type-str v)))
        (Ifz t (sg-error "untyped-field (want type or $ref)" v)
          (let ((ty (_0 t)))
            (cond
              ((Eq ty "string") ["str"])
              ((Eq ty "integer") ["int"])
              ((Eq ty "boolean") ["bool"])
              ((Eq ty "number") (sg-error "float-unsupported (no honest representation yet)" v))
              ((Eq ty "object") (sg-error "inline-object (hoist to $defs)" v))
              ((Eq ty "array")
                (let ((it (jv-get "items" v)))
                  (Ifz it (sg-error "array-without-items" v)
                    (let ((et (sg-ftype-of (_0 it))))
                      (If (Eq "row" (_0 et))
                        (sg-error "nested-array-unsupported" v)
                        ["row" et])))))
              (else (sg-error "unsupported-type" ty)))))))))

(define (sg-typedef-of name v)
  (define en (jv-get "enum" v))
  (Ifz (Nil en)
    (let ((vals (map (lambda (x) (sg-check-name (jv-str! x)))
                  (jv-xs! (_0 en)))))
      (Ifz (Sz vals) (sg-error "empty-enum" name)
        ["enum" name vals]))
    (let ((t (sg-type-str v)))
      (Ifz (And t (Eq "object" (_0 t)))
        (sg-error "unsupported-def (want object or enum)" name)
        (let* ((props-r (jv-get "properties" v))
               (props (Ifz props-r [] (jv-kvs (_0 props-r))))
               (reqs-r (jv-get "required" v))
               (reqs (Ifz reqs-r [] (map jv-str! (jv-xs! (_0 reqs-r)))))
               (fields
                 (map (lambda (e)
                        (let ((fname (sg-check-name (Ix 0 e))))
                          [fname (sg-ftype-of (Ix 1 e))
                           (If (includes (Eq (Ix 0 e)) reqs) 1 0)]))
                   props)))
          (Ifz (Sz fields) (sg-error "empty-object" name)
            ["rec" name fields]))))))

;; ref names reachable from a typedef's fields.
(define (sg-ft-refs ft)
  (cond
    ((Eq "ref" (_0 ft)) [(Ix 1 ft)])
    ((Eq "row" (_0 ft)) (sg-ft-refs (Ix 1 ft)))
    (else [])))

(define (sg-td-deps td)
  (If (Eq "rec" (_0 td))
    (foldl (lambda (acc f) (Weld acc (sg-ft-refs (Ix 1 f)))) [] (Ix 2 td))
    []))

;; Emission order: a def before its dependents; cycles rejected.
(define (sg-topo tds)
  (define (go done rest)
    (Ifz (Sz rest) done
      (let* ((names (map (Ix 1) done))
             (ready?
               (lambda (td)
                 (all (lambda (d) (includes (Eq d) names)) (sg-td-deps td))))
             (rd (filter ready? rest))
             (rst (filter (lambda (td) (Nil (ready? td))) rest)))
        (Ifz (Sz rd)
          (sg-error "ref-cycle (or dangling $ref)" (map (Ix 1) rest))
          (go (Weld done rd) rst)))))
  (go [] tds))

;; -> [root-name [typedef ..]] in emission order.
(define (sg-schema-typedefs sv)
  (define title-r (jv-get "title" sv))
  (define root-name
    (Ifz title-r (sg-error "missing-title" 0)
      (sg-check-name (jv-str! (_0 title-r)))))
  (define defs-r (jv-get "$defs" sv))
  (define def-tds
    (Ifz defs-r []
      (map (lambda (e) (sg-typedef-of (sg-check-name (Ix 0 e)) (Ix 1 e)))
        (jv-kvs (_0 defs-r)))))
  (define tds (snoc (sg-typedef-of root-name sv) def-tds))
  (define names (map (Ix 1) tds))
  (Ifz (Eq (Sz names) (Sz (dedupe-eq names)))
    (sg-error "duplicate-type-name" names)
    [root-name (sg-topo tds)]))

;;; Shared naming ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define sg-q 34)

;; Quote for embedding inside doctest lore text (the doctest runner
;; re-parses the ?= expression, so its cords need real quote bytes).
(define (qq s) (strcat [sg-q s sg-q]))

;; helper-name suffix of an ftype.
(define (sg-ft-key ft)
  (cond
    ((Eq "str" (_0 ft)) "str")
    ((Eq "int" (_0 ft)) "int")
    ((Eq "bool" (_0 ft)) "boo")
    ((Eq "ref" (_0 ft)) (Ix 1 ft))
    ((Eq "row" (_0 ft)) (strcat ["row_" (sg-ft-key (Ix 1 ft))]))))

;; The result sum whose ok holds a bare (required) value of ft: a ref's
;; own <R>_r, else the generated r_<key>.
(define (sg-ft-rsum ft)
  (If (Eq "ref" (_0 ft))
    (strcat [(Ix 1 ft) "_r"])
    (strcat ["r_" (sg-ft-key ft)])))

;; The value-decoder entry for ft (json -> result sum above).
(define (sg-ft-dval ft)
  (If (Eq "ref" (_0 ft))
    (strcat [(Ix 1 ft) "_from"])
    (strcat ["d_val_" (sg-ft-key ft)])))


;; Merge a [ft req opt] use into the per-rec key list, OR-ing modes.
(define (sg-merge-entry acc ent)
  (define key (sg-ft-key (Ix 0 ent)))
  (define hit (find (lambda (e) (Eq key (sg-ft-key (Ix 0 e)))) acc))
  (Ifz hit
    (snoc ent acc)
    (map (lambda (e)
           (If (Eq key (sg-ft-key (Ix 0 e)))
             [(Ix 0 e) (Or (Ix 1 e) (Ix 1 ent)) (Or (Ix 2 e) (Ix 2 ent))]
             e))
      acc)))

;; Keys a row ftype's ELEMENT needs (d_val only -> req=0 opt=0 entry).
(define (sg-elem-keys ft)
  (If (And (Eq "row" (_0 ft)) (Nil (Eq "ref" (_0 (Ix 1 ft)))))
    [[(Ix 1 ft) 0 0]]
    []))

;;; Tree emitter ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Emits normalized rex DIRECTLY — Leaf/Nest/Juxt with inert zero
;;; spans, straight into foil:compile-rex.  Shapes mirror what
;;; ParseRexNormFile produces for the same source (probe-transcribed);
;;; the dev oracle was Equal against the span-zapped parse of the text
;;; emitter's output.

(define nzsp [0 0 0 0])
(define (nw s) (rex:MakeLeaf nzsp "word" s))
(define (nc s) (rex:MakeLeaf nzsp "cord" s))
(define (nrn rune kids) (rex:MakeNest nzsp "clear" rune kids))
(define (npar kids) (rex:MakeNest nzsp "paren" "" kids))
(define (nbrk kids) (rex:MakeNest nzsp "brack" "" kids))
(define (nbrko rune kids) (rex:MakeNest nzsp "brack" rune kids))
(define (njx kids) (rex:MakeJuxt nzsp kids))
(define (ngrp kids) (If (Eq 1 (Sz kids)) (_0 kids) (nrn "" kids)))

;; BUG-COMPATIBLE, twice over: the parser's lore-line join writes a
;; LITERAL backslash-n (rex-unlines-go, rex.rvr:301 — string literals
;; process no escapes), and DECL-level continuation lines keep a "' "
;; prefix while top-level ones are stripped.  Match both so generated
;; lore is indistinguishable from parsed lore; flip in lockstep when
;; the newline bug is fixed.
(define (nslug-join sep lines)
  (rex:MakeLeaf nzsp "slug"
    (foldl (lambda (acc l)
             (Ifz acc (strcat [" " l]) (strcat [acc sep l])))
      0 lines)))
(define (nslug-top lines) (nslug-join (strcat ["\n" " "]) lines))
(define (nslug lines) (nslug-join (strcat ["\n" "  '  "]) lines))

(define (npth segs) (nrn "/" (map nw segs)))
(define (nfc name ty) (nrn "=" [(nw name) ty]))
(define (ndot a b) (nrn "." [a b]))
(define (ndotw a b) (ndot (nw a) (nw b)))
(define (nmeth recv seg args)
  (nrn "." [recv (njx [(nw seg) (npar args)])]))
(define (nrelv name) (nrn "." [(nw name)]))
(define (nrelap name args)
  (npar (cons (nrn "./" [(nw name)]) args)))
(define (nspec name args) (njx [(nw name) (nbrk args)]))

;; foil type tree of an ftype.
(define (sg-ft-ty-t ft)
  (cond
    ((Eq "str" (_0 ft)) (nw "nat"))
    ((Eq "int" (_0 ft)) (nw "nat"))
    ((Eq "bool" (_0 ft)) (nw "bool"))
    ((Eq "ref" (_0 ft)) (nw (Ix 1 ft)))
    ((Eq "row" (_0 ft)) (nspec "row" [(sg-ft-ty-t (Ix 1 ft))]))))

(define (sg-maybe-t ty) (nspec "maybe" [ty]))

;; (name/variant args...) application.
(define (nvap sum variant args)
  (npar (cons (npth [sum variant]) args)))

(define (sg-sum-tree name vty)
  (nrn "+"
    [(nw name)
     (nrn "&" [(npth [name "ok"]) (npth [name "err"])])
     (nrn "+" [(nw "ok") (nrn ":" [(nfc "v" vty)])])
     (nrn "+" [(nw "err")
               (nrn ":" [(nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])])]))

(define (sg-dval-tree ft)
  (define key (sg-ft-key ft))
  (define rs (strcat ["r_" key]))
  (define (err why) (nvap rs "err" [(nw "p") (nc why)]))
  (define (ok v) (nvap rs "ok" [v]))
  (define body
    (cond
      ((Eq "str" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "str"])) (ok (ndotw "t" "s"))])
                  (err "expected-string")]))
      ((Eq "int" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "num"]))
                            (nrn "?" [(ndotw "t" "neg") (err "negative")])
                            (ok (ndotw "t" "n"))])
                  (err "expected-integer")]))
      ((Eq "bool" (_0 ft))
        (nrn "?" [(nw "j")
                  (nrn ">" [(nfc "t" (npth ["json" "boo"])) (ok (ndotw "t" "b"))])
                  (err "expected-boolean")]))
      ((Eq "row" (_0 ft))
        (let* ((et (Ix 1 ft))
               (ety (sg-ft-ty-t et))
               (edv (sg-ft-dval et)))
          (nrn "?"
            [(nw "j")
             (nrn ">"
               [(nfc "t" (npth ["json" "arr"]))
                ;; one-line arm chains: the second > rides as a kid
                ;; of the first (loop-arm-chain unchains them)
                (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")
                                    (nrn ">" [(nfc "out" (nspec "row" [ety]))
                                              (nbrk [])])])])
                (nrn "^" [(nw rs)])
                (nrn "?" [(npar [(nw "eq") (nw "i")
                                 (nrn "." [(nw "t") (nw "xs") (nw "len")])])
                          (ok (nw "out"))])
                (nrn "?"
                  [(npar [(nw edv)
                          (nrn "." [(nw "t") (nw "xs")
                                    (njx [(nw "at") (npar [(nw "i")])])])
                          (npar [(nw "jidx") (nw "p") (nw "i")])])
                   (nrn ">" [(npar [(nrn "./" [(nw "err")])
                                    (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
                             (nvap rs "err" [(nw "path") (nw "why")])])
                   (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" ety)])
                             (npar [(nw "_") (ndotw "i" "inc")
                                    (nmeth (nw "out") "snoc" [(nw "v")])])])])])
             (err "expected-array")])))
      (else (sg-error "dval-of-ref" ft))))
  (nrn "+"
    [(nw (strcat ["d_val_" key]))
     (nrn "\" [(nfc "j" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rs)])
     body]))

(define (sg-dreq-tree ft)
  (define key (sg-ft-key ft))
  (define rs (sg-ft-rsum ft))
  (define dv (sg-ft-dval ft))
  (nrn "+"
    [(nw (strcat ["d_req_" key]))
     (nrn "\" [(nfc "m" (sg-maybe-t (nw "json"))) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rs)])
     (nrn "?"
       [(nw "m")
        (nrn ">" [(nrelv "none") (nvap rs "err" [(nw "p") (nc "missing")])])
        (nrn ">" [(npar [(nrn "./" [(nw "some")]) (nw "j")])
                  (npar [(nw dv) (nw "j") (nw "p")])])])]))

(define (sg-dopt-tree ft)
  (define key (sg-ft-key ft))
  (define ty (sg-ft-ty-t ft))
  (define ors (strcat ["r_o_" key]))
  (define dv (sg-ft-dval ft))
  [(sg-sum-tree ors (sg-maybe-t ty))
   (nrn "+"
     [(nw (strcat ["d_opt_" key]))
      (nrn "\" [(nfc "m" (sg-maybe-t (nw "json"))) (nfc "p" (nw "nat"))])
      (nrn "^" [(nw ors)])
      (nrn "?"
        [(nw "m")
         (nrn ">" [(nrelv "none") (nvap ors "ok" [(nrelv "none")])])
         (nrn ">"
           [(npar [(nrn "./" [(nw "some")]) (nw "j")])
            (nrn "?"
              [(npar [(nw dv) (nw "j") (nw "p")])
               (nrn ">" [(npar [(nrn "./" [(nw "err")])
                                (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
                         (nvap ors "err" [(nw "path") (nw "why")])])
               (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" ty)])
                         (nvap ors "ok" [(nrelap "some" [(nw "v")])])])])])])])])

;; Helper members for one field use, emitted once per (part, key).
(define (sg-part-trees seen ft req opt)
  (define key (sg-ft-key ft))
  (define is-ref (Eq "ref" (_0 ft)))
  (define (add tag emit st)
    (let ((tagk (strcat [tag key])))
      (If (includes (Eq tagk) (_0 st)) st
        [(snoc tagk (_0 st)) (Weld (_1 st) (emit 0))])))
  (define st0 [seen []])
  (define st1
    (Ifz is-ref
      (add "v:"
        (lambda (z)
          [(sg-sum-tree (strcat ["r_" key]) (sg-ft-ty-t ft))
           (sg-dval-tree ft)])
        st0)
      st0))
  (define st2 (Ifz req st1 (add "q:" (lambda (z) [(sg-dreq-tree ft)]) st1)))
  (Ifz opt st2 (add "o:" (lambda (z) (sg-dopt-tree ft)) st2)))

(define (sg-rec-decl-tree name fields)
  (nrn "+"
    [(nw name)
     (nrn ":"
       (map (lambda (f)
              (let ((ty (sg-ft-ty-t (Ix 1 f))))
                (nfc (Ix 0 f) (If (Ix 2 f) ty (sg-maybe-t ty)))))
         fields))]))

(define (sg-rec-from-tree name fields)
  (define rsum (strcat [name "_r"]))
  (define n (Sz fields))
  (define (chain i)
    (If (Eq i n)
      (nvap rsum "ok"
        [(npar (cons (nw name)
                 (map (lambda (k) (nw (strcat ["v" (nat-str k)])))
                   (gen n (lambda (k) k)))))])
      (let* ((f (Ix i fields))
             (fname (Ix 0 f))
             (ft (Ix 1 f))
             (req (Ix 2 f))
             (dfn (strcat [(If req "d_req_" "d_opt_") (sg-ft-key ft)]))
             (vty (If req (sg-ft-ty-t ft) (sg-maybe-t (sg-ft-ty-t ft))))
             (ix (nat-str i)))
        (nrn "?"
          [(npar [(nw dfn)
                  (npar [(nw "jget") (nc fname) (ndotw "o" "kvs")])
                  (npar [(nw "jpath") (nw "p") (nc fname)])])
           (nrn ">" [(npar [(nrn "./" [(nw "err")])
                            (nfc (strcat ["path" ix]) (nw "nat"))
                            (nfc (strcat ["why" ix]) (nw "nat"))])
                     (nvap rsum "err"
                       [(nw (strcat ["path" ix])) (nw (strcat ["why" ix]))])])
           (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                            (nfc (strcat ["v" ix]) vty)])
                     (chain (Inc i))])]))))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nslug [(strcat ["Decode a " name " from a json value; p is the"])
             "breadcrumb prefix."])
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(nw "v")
        (nrn ">" [(nfc "o" (npth ["json" "obj"])) (chain 0)])
        (nvap rsum "err" [(nw "p") (nc "expected-object")])])]))

;; Encode one field value expression.
(define (sg-enc-t ft exp)
  (cond
    ((Eq "str" (_0 ft)) (npar [(npth ["json" "str"]) exp]))
    ((Eq "int" (_0 ft)) (npar [(npth ["json" "num"]) (nrelv "false") exp]))
    ((Eq "bool" (_0 ft)) (npar [(npth ["json" "boo"]) exp]))
    ((Eq "ref" (_0 ft)) (npar [(nw (strcat [(Ix 1 ft) "_to"])) exp]))
    (else (sg-error "enc-of-row-inline" ft))))

(define (sg-rec-to-tree name fields)
  (define n (Sz fields))
  (define (row-loop ix outv src et)
    ;; a row[json] loop from src's elements
    [(nrn "|" [(nrn ">" [(nfc (strcat ["i" ix]) (nw "nat")) (nw "0")
                         (nrn ">" [(nfc outv (nspec "row" [(nw "json")]))
                                   (nbrk [])])])])
     (nrn "?" [(npar [(nw "eq") (nw (strcat ["i" ix]))
                      (nrn "." (snoc (nw "len") src))])
               (nw outv)])
     (npar [(nw "_") (ndotw (strcat ["i" ix]) "inc")
            (nmeth (nw outv) "snoc"
              [(sg-enc-t et
                 (nrn "." (snoc (njx [(nw "at") (npar [(nw (strcat ["i" ix]))])])
                            src)))])])])
  (define (field-trees i)
    (define f (Ix i fields))
    (define fname (Ix 0 f))
    (define ft (Ix 1 f))
    (define req (Ix 2 f))
    (define ix (nat-str i))
    (define acc0 (strcat ["k" (nat-str i)]))
    (define acc1 (strcat ["k" (nat-str (Inc i))]))
    (define is-row (Eq "row" (_0 ft)))
    (define (snoc-kv enc)
      (nmeth (nw acc0) "snoc" [(npar [(nw "jkv") (nc fname) enc])]))
    (If req
      (If is-row
        [(nrn "=" [(nw (strcat ["a" ix]))
                   (ngrp (row-loop ix (strcat ["b" ix])
                           [(nw "x") (nw fname)] (Ix 1 ft)))])
         (nrn "=" [(nw acc1)
                   (snoc-kv (npar [(npth ["json" "arr"]) (nw (strcat ["a" ix]))]))])]
        [(nrn "=" [(nw acc1) (snoc-kv (sg-enc-t ft (ndotw "x" fname)))])])
      (If is-row
        [(nrn "="
           [(nw acc1)
            (nrn "?"
              [(ndotw "x" fname)
               (nrn ">" [(nrelv "none") (nw acc0)])
               (nrn ">"
                 [(npar [(nrn "./" [(nw "some")]) (nw (strcat ["w" ix]))])
                  (nrn "=" [(nw (strcat ["a" ix]))
                            (ngrp (row-loop ix (strcat ["b" ix])
                                    [(nw (strcat ["w" ix]))] (Ix 1 ft)))])
                  (snoc-kv (npar [(npth ["json" "arr"]) (nw (strcat ["a" ix]))]))])])])]
        [(nrn "="
           [(nw acc1)
            (nrn "?"
              [(ndotw "x" fname)
               (nrn ">" [(nrelv "none") (nw acc0)])
               (nrn ">" [(npar [(nrn "./" [(nw "some")]) (nw (strcat ["w" ix]))])
                         (snoc-kv (sg-enc-t ft (nw (strcat ["w" ix]))))])])])])))
  (nrn "+"
    (Weld
      [(nw (strcat [name "_to"]))
       (nrn "\" [(nfc "x" (nw name))])
       (nrn "^" [(nw "json")])
       (nrn "=" [(nw "k0") (nbrk [])])]
      (snoc
        (npar [(npth ["json" "obj"]) (nw (strcat ["k" (nat-str n)]))])
        (foldl (lambda (acc i) (Weld acc (field-trees i))) []
          (gen n (lambda (i) i)))))))

(define (sg-enum-decl-tree name vals)
  (nrn "+"
    (Weld
      [(nw name)
       (nrn "&" (map (lambda (v) (npth [name v])) vals))]
      (map (lambda (v)
             (nrn "+" [(nw v) (nrn ":" [(nfc "z" (nw "nat"))])]))
        vals))))

(define (sg-enum-from-tree name vals)
  (define rsum (strcat [name "_r"]))
  (nrn "+"
    [(nw (strcat [name "_from"]))
     (nrn "\" [(nfc "v" (nw "json")) (nfc "p" (nw "nat"))])
     (nrn "^" [(nw rsum)])
     (nrn "?"
       [(nw "v")
        (nrn ">"
          (Weld [(nfc "t" (npth ["json" "str"]))]
            (snoc (nvap rsum "err" [(nw "p") (nc "bad-enum")])
              (map (lambda (v)
                     (nrn "?" [(npar [(nw "eq") (ndotw "t" "s") (nc v)])
                               (nvap rsum "ok" [(nvap name v [(nw "0")])])]))
                vals))))
        (nvap rsum "err" [(nw "p") (nc "expected-string")])])]))

(define (sg-enum-to-tree name vals)
  (nrn "+"
    [(nw (strcat [name "_to"]))
     (nrn "\" [(nfc "x" (nw name))])
     (nrn "^" [(nw "json")])
     (nrn "?"
       (Weld
         (Weld [(nw "x")]
           (map (lambda (v)
                  (nrn ">" [(nfc (strcat ["e_" v]) (npth [name v]))
                            (npar [(npth ["json" "str"]) (nc v)])]))
             vals))
         [(npar [(npth ["json" "str"]) (nc (_0 vals))])]))]))

(define sg-prelude-trees
  [(nrn "-" [(nw "sept") (nbrko "=" [(nw "order") (nw "10")])])
   (nrn "-" [(nw "json") (nbrko "=" [(nw "order") (nw "20")])])
   (nslug-top ["Generated by schemagen.  The schema is the source of truth;"
               "there is no source file to edit."])
   (nrn "+"
     [(nw "jget")
      (nslug ["The value at key k, if present."])
      (nrn "\" [(nfc "k" (nw "nat")) (nfc "kvs" (nspec "row" [(nw "jkv")]))])
      (nrn "^" [(sg-maybe-t (nw "json"))])
      (nrn "|" [(nrn ">" [(nfc "i" (nw "nat")) (nw "0")])])
      (nrn "^" [(sg-maybe-t (nw "json"))])
      (nrn "?" [(npar [(nw "eq") (nw "i") (ndotw "kvs" "len")])
                (nrelv "none")])
      (nrn "=" [(nw "e") (nmeth (nw "kvs") "at" [(nw "i")])])
      (nrn "?" [(npar [(nw "eq") (ndotw "e" "k") (nw "k")])
                (nrelap "some" [(ndotw "e" "v")])])
      (npar [(nw "_") (ndotw "i" "inc")])])
   (nrn "+"
     [(nw "jpath")
      (nslug ["Breadcrumb: p.f, or f at the root."])
      (nrn "\" [(nfc "p" (nw "nat")) (nfc "f" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (nrn "?" [(npar [(nw "eq") (nw "p") (nw "0")]) (nw "f")])
      (npar [(nw "cat2") (npar [(nw "cat2") (nw "p") (nc ".")]) (nw "f")])])
   (nrn "+"
     [(nw "jidx")
      (nslug ["Breadcrumb: p[i]."])
      (nrn "\" [(nfc "p" (nw "nat")) (nfc "i" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (npar [(nw "cat2")
             (npar [(nw "cat2")
                    (npar [(nw "cat2") (nw "p") (nc "[")])
                    (npar [(nw "show_nat") (nw "i")])])
             (nc "]")])])])

(define (sg-td-trees seen td)
  (define kind (_0 td))
  (define name (Ix 1 td))
  (If (Eq "enum" kind)
    (let ((vals (Ix 2 td)))
      [seen
       [(sg-enum-decl-tree name vals)
        (sg-sum-tree (strcat [name "_r"]) (nw name))
        (sg-enum-from-tree name vals)
        (sg-enum-to-tree name vals)]])
    (let* ((fields (Ix 2 td))
           (wanted
             (foldl (lambda (acc f)
                      (foldl sg-merge-entry
                        (sg-merge-entry acc
                          [(Ix 1 f) (Ix 2 f) (Nil (Ix 2 f))])
                        (sg-elem-keys (Ix 1 f))))
               [] fields))
           (wanted-sorted
             (Weld (filter (lambda (e) (Nil (Eq "row" (_0 (Ix 0 e))))) wanted)
               (filter (lambda (e) (Eq "row" (_0 (Ix 0 e)))) wanted)))
           (hst
             (foldl (lambda (st e)
                      (let ((r (sg-part-trees (_0 st) (Ix 0 e)
                                 (Ix 1 e) (Ix 2 e))))
                        [(_0 r) (Weld (_1 st) (_1 r))]))
               [seen []] wanted-sorted))
           (seen1 (_0 hst))
           (helpers (_1 hst)))
      [seen1
       (Weld [(sg-rec-decl-tree name fields)
              (sg-sum-tree (strcat [name "_r"]) (nw name))]
         (Weld helpers
           [(sg-rec-from-tree name fields)
            (sg-rec-to-tree name fields)]))])))

(define (sg-root-trees root-name examples)
  (define rsum (strcat [root-name "_r"]))
  (define rt-lore
    (Weld
      ["Decode then re-encode: the canonical spelling, or"
       "path:why on failure.  The doctest surface."]
      (map (lambda (ex)
             (strcat ["?=  ((rt " (qq (dq-escape ex)) ") "
                      (qq (dq-escape ex)) ")"]))
        examples)))
  [(nrn "+"
     [(nw (strcat ["parse_" root-name]))
      (nslug [(strcat ["Decode a " root-name " from JSON text."])])
      (nrn "\" [(nfc "s" (nw "nat"))])
      (nrn "^" [(nw rsum)])
      (nrn "?"
        [(npar [(nw "parse") (nw "s")])
         (nrn ">" [(npar [(nrn "./" [(nw "err")])
                          (nfc "why" (nw "nat")) (nfc "rest" (nw "nat"))])
                   (nvap rsum "err" [(nw "0") (nw "why")])])
         (nrn ">" [(npar [(nrn "./" [(nw "ok")])
                          (nfc "v" (nw "json")) (nfc "rest" (nw "nat"))])
                   (npar [(nw (strcat [root-name "_from"])) (nw "v") (nw "0")])])])])
   (nrn "+"
     [(nw (strcat ["show_" root-name]))
      (nslug [(strcat ["Encode a " root-name " compactly."])])
      (nrn "\" [(nfc "x" (nw root-name))])
      (nrn "^" [(nw "nat")])
      (npar [(nw "show") (npar [(nw (strcat [root-name "_to"])) (nw "x")])])])
   (nrn "+"
     [(nw "rt")
      (nslug rt-lore)
      (nrn "\" [(nfc "s" (nw "nat"))])
      (nrn "^" [(nw "nat")])
      (nrn "?"
        [(npar [(nw (strcat ["parse_" root-name])) (nw "s")])
         (nrn ">"
           [(npar [(nrn "./" [(nw "err")])
                   (nfc "path" (nw "nat")) (nfc "why" (nw "nat"))])
            (nrn "?" [(npar [(nw "eq") (nw "path") (nw "0")]) (nw "why")])
            (npar [(nw "cat2") (npar [(nw "cat2") (nw "path") (nc ":")])
                   (nw "why")])])
         (nrn ">" [(npar [(nrn "./" [(nw "ok")]) (nfc "v" (nw root-name))])
                   (npar [(nw (strcat ["show_" root-name])) (nw "v")])])])])])

;; -> [root-name tree]
(define (sg-gen-tree show-fn sv)
  (define nt (sg-schema-typedefs sv))
  (define root-name (_0 nt))
  (define tds (_1 nt))
  (define exs-r (jv-get "examples" sv))
  (define examples
    (Ifz exs-r [] (map show-fn (jv-xs! (_0 exs-r)))))
  (define td-trees
    (_1 (foldl (lambda (st td)
                 (let ((r (sg-td-trees (_0 st) td)))
                   [(_0 r) (Weld (_1 st) (_1 r))]))
          [[] []] tds)))
  [root-name
   (ngrp
     (Weld sg-prelude-trees
       (Weld td-trees (sg-root-trees root-name examples))))])

;;; Public API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Parse a schema document with json.foil's parse (jsut: a compiled
;; json subject).
(define (sg-schema-value jsut txt)
  (define r ((foil:source-entry-val ["parse"] jsut) txt))
  (If (Eq "/boot/jres/ok" (Hd r))
    (Ix 0 r)
    (sg-error "schema-json" (Ix 0 r))))

;; Generate the module tree for a schema document.  -> [name tree]
(define (gen-tree jsut schema-txt)
  (sg-gen-tree (foil:source-entry-val ["show"] jsut)
    (sg-schema-value jsut schema-txt)))

;; Generate AND compile.  -> [name tree subject]
(define (compile-schema sut jsut schema-txt)
  (define g (gen-tree jsut schema-txt))
  [(_0 g) (_1 g)
   (foil:compile-rex sut (_0 g) (_1 g))])
