(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; Corpus admission turns explicitly named Semidoc definitions into a typed,
;;; deterministic semantic DAG.  Page location is retained only as provenance.

(define sut (stage:sut-of "foundry_corpus"))
(define (app path) (foil:source-entry-val path sut))
(define (ts s) ("ts" s))
(define none "/boot/maybe/none")

(define provenance (app ["foundry_corpus" "provenance"]))
(define source (app ["foundry_corpus" "source"]))
(define record-source (app ["foundry_corpus" "record_source"]))
(define page-source (app ["foundry_corpus" "page_source"]))
(define admit (app ["foundry_corpus" "admit"]))
(define admit-records (app ["foundry_corpus" "admit_records"]))
(define admit-pages (app ["foundry_corpus" "admit_pages"]))
(define admit-axal (app ["foundry_corpus" "admit_axal"]))
(define corpus-index (app ["foundry_corpus" "index"]))
(define admission-document (app ["foundry_corpus" "admission_document"]))
(define admission-surface-recipe
  (app ["foundry_corpus" "admission_surface_recipe"]))
(define admission-fallback-recipes
  (app ["foundry_corpus" "admission_fallback_recipes"]))
(define admission-record (app ["foundry_corpus" "admission_record"]))
(define admission-layer (app ["foundry_corpus" "admission_layer"]))
(define close-corpus (app ["foundry_corpus" "close"]))
(define source-impact (app ["foundry_corpus" "source_impact"]))
(define admission-definitions
  (app ["foundry_corpus" "admission_definitions"]))
(define admission-references
  (app ["foundry_corpus" "admission_references"]))
(define admission-backlinks
  (app ["foundry_corpus" "admission_backlinks"]))
(define admission-diagnostics
  (app ["foundry_corpus" "admission_diagnostics"]))
(define definition-name (app ["foundry_corpus" "definition_name"]))
(define definition-kind (app ["foundry_corpus" "definition_kind"]))
(define definition-source (app ["foundry_corpus" "definition_source"]))
(define definition-record (app ["foundry_corpus" "definition_record"]))
(define reference-from (app ["foundry_corpus" "reference_from"]))
(define reference-target (app ["foundry_corpus" "reference_target"]))
(define reference-expected (app ["foundry_corpus" "reference_expected"]))
(define diagnostic-source (app ["foundry_corpus" "diagnostic_source"]))
(define diagnostic-subject (app ["foundry_corpus" "diagnostic_subject"]))
(define diagnostic-code (app ["foundry_corpus" "diagnostic_code"]))
(define backlink-target (app ["foundry_corpus" "backlink_target"]))
(define backlink-sources (app ["foundry_corpus" "backlink_sources"]))
(define closure-definitions (app ["foundry_corpus" "closure_definitions"]))
(define closure-diagnostics (app ["foundry_corpus" "closure_diagnostics"]))
(define impact-definitions (app ["foundry_corpus" "impact_definitions"]))
(define impact-incoming (app ["foundry_corpus" "impact_incoming"]))
(define impact-diagnostics (app ["foundry_corpus" "impact_diagnostics"]))
(define index-entry-name (app ["foundry_corpus" "index_entry_name"]))
(define index-entry-forward (app ["foundry_corpus" "index_entry_forward"]))
(define index-entry-incoming (app ["foundry_corpus" "index_entry_incoming"]))
(define sd-parse (app ["semidoc" "parse"]))
(define sd-remount (app ["semidoc" "remount"]))
(define compile-records (app ["foundry_doc" "compile_records"]))
(define document-surface (app ["foundry_doc" "document_surface"]))
(define surface-recipe-recipe
  (app ["foundry_doc" "surface_recipe_recipe"]))
(define surface-recipe-surface
  (app ["foundry_doc" "surface_recipe_surface"]))
(define recipe-name (app ["foundry_doc" "recipe_name"]))
(define surface-name (app ["foundry_doc" "surface_name"]))
(define layer-name (app ["foundry" "layer_name"]))
(define layer-values (app ["foundry" "layer_values"]))
(define axal-new (app ["axal" "new"]))
(define axal-dip (app ["axal" "dip"]))
(define axal-get (app ["axal" "get"]))
(define axal-put (app ["axal" "put"]))
(define axal-rep (app ["axal" "rep"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-meld (app ["myth" "meld"]))
(define myth-txt-at (app ["myth" "txt_at"]))
(define pails-t (app ["pails" "t"]))

(define nl 10)
(define (unlines xs)
  (foldl (lambda (a x) (strcat [a x nl])) "" xs))
(define (path xs) (map ts xs))
(define (src locator text)
  (source (provenance (path locator) none) text))
(define (page-tree text)
  (axal-dip [("u" 0)] (sd-remount (sd-parse text))))
(define (wrapped-page-tree text stale-source)
  (axal-put []
    (myth-meld
      (myth-sing (path ["src"]) (pails-t stale-source))
      (myth-sing (path ["sys" "kook"]) (pails-t "wrapper machinery")))
    (sd-remount (sd-parse text))))
(define (page-src locator text)
  (page-source (provenance (path locator) none)
    (page-tree text)))
(define (records-src locator text)
  (record-source (provenance (path locator) none)
    (some-value (compile-records text))))
(define (some-value x)
  assert(Equal "/boot/maybe/some" (Hd x))
  (_0 x))
(define (definition-names corpus)
  (map definition-name (admission-definitions corpus)))
(define (definition-kinds corpus)
  (map definition-kind (admission-definitions corpus)))
(define (diagnostic-codes corpus)
  (map diagnostic-code (admission-diagnostics corpus)))

(define layer-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name ;/defs/base"
     ";@ /foundry/guarded false"
     ";@ /vendor/future kept"
     ";@ /token/color/ink black"
     ";. page-local-layer-name"]))

(define surface-src
  (unlines
    [";@ /foundry/kind surface"
     ";@ /foundry/name ;/defs/plate"
     ";@ /surface/root ;/nodes/plate"
     ";. unrelated-page-doc-id"
     "  ;@ /surface/kind plate"
     "  ;@ /surface/role ;/projection/example/plate"
     "  ;. /nodes/plate"]))

(define recipe-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/defs/render"
     ";@ /recipe/role ;/projection/example/plate"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind plate"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling plate"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/test"
     ";@ /recipe/template ;/defs/plate"
     ";. another-page-doc-id"]))

(define catalog-src
  (unlines
    [";@ /foundry/kind catalog"
     ";@ /foundry/name ;/defs/catalog"
     ";@ /catalog/source_role ;/source/example"
     ";@ /catalog/target_role ;/projection/example/plate"
     ";@ /catalog/ceiling plate"
     ";@ /catalog/recipes ;/defs/render"
     ";@ /catalog/layers ;/defs/base"
     ";. page-doc-id-is-not-semantic-identity"]))

;;; Deliberately reverse dependency order: catalog and recipe forward-reference
;;; symbols that are compiled later.  Admission sorts by semantic name, not page
;;; order, while every definition retains its exact authoring page.
(define corpus-a
  (admit
    [(src ["wiki" "catalog-page"] catalog-src)
     (src ["wiki" "recipe-page"] recipe-src)
     (src ["wiki" "surface-page"] surface-src)
     (src ["wiki" "layer-page"] layer-src)]))

assert(Eq 0 (Sz (admission-diagnostics corpus-a)))
assert(Equal
  [(path ["defs" "base"])
   (path ["defs" "catalog"])
   (path ["defs" "plate"])
   (path ["defs" "render"])
   (path ["nodes" "plate"])]
  (definition-names corpus-a))
assert(Equal
  [(ts "layer") (ts "catalog") (ts "surface") (ts "recipe")
   (ts "surface_node")]
  (definition-kinds corpus-a))

;;; Expanded Nenex records are the primary corpus input.  They reconstruct the
;;; same four typed document kinds and the same typed DAG as source admission,
;;; without reading a page's ['src] application slot.
(define page-corpus-a
  (admit-pages
    [(page-src ["wiki" "catalog-page"] catalog-src)
     (page-src ["wiki" "recipe-page"] recipe-src)
     (page-src ["wiki" "surface-page"] surface-src)
     (page-src ["wiki" "layer-page"] layer-src)]))
assert(Eq 0 (Sz (admission-diagnostics page-corpus-a)))
assert(Equal (definition-names corpus-a) (definition-names page-corpus-a))
assert(Equal (definition-kinds corpus-a) (definition-kinds page-corpus-a))
assert(Equal
  (map reference-from (admission-references corpus-a))
  (map reference-from (admission-references page-corpus-a)))
assert(Equal
  (map reference-target (admission-references corpus-a))
  (map reference-target (admission-references page-corpus-a)))
assert(Equal
  (map reference-expected (admission-references corpus-a))
  (map reference-expected (admission-references page-corpus-a)))
assert(Equal
  (some-value (admission-document (path ["defs" "base"]) corpus-a))
  (some-value (admission-document (path ["defs" "base"]) page-corpus-a)))
assert(Equal
  (some-value (admission-document (path ["defs" "plate"]) corpus-a))
  (some-value (admission-document (path ["defs" "plate"]) page-corpus-a)))
assert(Equal
  (some-value (admission-document (path ["defs" "render"]) corpus-a))
  (some-value (admission-document (path ["defs" "render"]) page-corpus-a)))
assert(Equal
  (some-value (admission-document (path ["defs" "catalog"]) corpus-a))
  (some-value (admission-document (path ["defs" "catalog"]) page-corpus-a)))

;;; Convenience admission consumes the already-descended /nenex/w axal.
(define nenex-pages-0 (axal-new none))
(define nenex-pages-1
  (axal-rep (path ["catalog-page"]) (page-tree catalog-src) nenex-pages-0))
(define nenex-pages-2
  (axal-rep (path ["recipe-page"]) (page-tree recipe-src) nenex-pages-1))
(define nenex-pages-3
  (axal-rep (path ["surface-page"]) (page-tree surface-src) nenex-pages-2))
(define nenex-pages-4
  (axal-rep (path ["layer-page"]) (page-tree layer-src) nenex-pages-3))
(define axal-corpus
  (admit-axal (path ["nenex" "w"]) nenex-pages-4))
assert(Eq 0 (Sz (admission-diagnostics axal-corpus)))
assert(Equal (definition-names page-corpus-a) (definition-names axal-corpus))
assert(Equal (path ["nenex" "w" "layer-page"])
  (definition-source (Ix 0 (admission-definitions axal-corpus))))

;;; A live Nenex page is not the document subtree used above: its root record
;;; carries app-owned /src and /sys/kook state, while the expanded Semidoc
;;; document lives at numeric child 0.  Normalized admission must select the
;;; child document, ignore stale wrapper source, and retain only document
;;; evidence for the admitted layer.
(define wrapped-pages
  (axal-rep (path ["layer-page"])
    (wrapped-page-tree layer-src "this stale wrapper source is invalid")
    (axal-new none)))
(define wrapped-corpus
  (admit-axal (path ["nenex" "w"]) wrapped-pages))
assert(Eq 0 (Sz (admission-diagnostics wrapped-corpus)))
(define wrapped-layer
  (some-value (admission-layer (path ["defs" "base"]) wrapped-corpus)))
assert(Equal (path ["defs" "base"]) (layer-name wrapped-layer))
(define wrapped-record
  (some-value (admission-record (path ["defs" "base"]) wrapped-corpus)))
assert(Eq 0 (myth-txt-at (path ["src"]) wrapped-record))
assert(Eq 0 (myth-txt-at (path ["sys" "kook"]) wrapped-record))

;;; The older foundry_doc/records packet remains an equivalent migration input.
(define record-corpus-a
  (admit-records
    [(records-src ["wiki" "catalog-page"] catalog-src)
     (records-src ["wiki" "recipe-page"] recipe-src)
     (records-src ["wiki" "surface-page"] surface-src)
     (records-src ["wiki" "layer-page"] layer-src)]))
assert(Eq 0 (Sz (admission-diagnostics record-corpus-a)))
assert(Equal (definition-names corpus-a) (definition-names record-corpus-a))
assert(Equal
  (map reference-target (admission-references corpus-a))
  (map reference-target (admission-references record-corpus-a)))

;;; Page names are provenance only for normalized inputs too.
(define page-corpus-renamed
  (admit-pages
    [(page-src ["renamed" "z-layer"] layer-src)
     (page-src ["renamed" "x-surface"] surface-src)
     (page-src ["renamed" "y-recipe"] recipe-src)
     (page-src ["renamed" "w-catalog"] catalog-src)]))
assert(Equal (definition-names page-corpus-a)
  (definition-names page-corpus-renamed))
assert(Equal (path ["wiki" "layer-page"])
  (definition-source (Ix 0 (admission-definitions page-corpus-a))))
assert(Equal (path ["renamed" "z-layer"])
  (definition-source (Ix 0 (admission-definitions page-corpus-renamed))))

;;; Unknown inert root slots survive record admission as exact evidence.
(define retained-layer-record
  (some-value (admission-record (path ["defs" "base"]) page-corpus-a)))
assert(Equal "kept"
  (myth-txt-at (path ["vendor" "future"]) retained-layer-record))

;;; The page's local name and its position never become semantic identity.
;;; Renaming every page changes provenance but leaves the definition order and
;;; typed reference graph exactly the same.
(define corpus-b
  (admit
    [(src ["renamed" "z-layer"] layer-src)
     (src ["renamed" "x-surface"] surface-src)
     (src ["renamed" "y-recipe"] recipe-src)
     (src ["renamed" "w-catalog"] catalog-src)]))
assert(Equal (definition-names corpus-a) (definition-names corpus-b))
assert(Equal
  (map reference-from (admission-references corpus-a))
  (map reference-from (admission-references corpus-b)))
assert(Equal
  (map reference-target (admission-references corpus-a))
  (map reference-target (admission-references corpus-b)))
assert(Equal (path ["wiki" "layer-page"])
  (definition-source (Ix 0 (admission-definitions corpus-a))))
assert(Equal (path ["renamed" "z-layer"])
  (definition-source (Ix 0 (admission-definitions corpus-b))))

;;; References are typed after the whole definition table exists.
(define refs-a (admission-references corpus-a))
assert(Eq 4 (Sz refs-a))
assert(Equal
  [(ts "layer") (ts "recipe") (ts "surface_node") (ts "surface")]
  (map reference-expected refs-a))

;;; Closure is dependency-first and includes both document definitions and
;;; addressed surface-node definitions in the same semantic DAG.
(define closed (close-corpus (path ["defs" "catalog"]) corpus-a))
assert(Eq 0 (Sz (closure-diagnostics closed)))
assert(Equal
  [(path ["defs" "base"])
   (path ["nodes" "plate"])
   (path ["defs" "plate"])
   (path ["defs" "render"])
   (path ["defs" "catalog"])]
  (map definition-name (closure-definitions closed)))

;;; Reverse edges are derived impact only.  They neither alter admission nor
;;; appear in the closure identity inputs.
(define backlinks-a (admission-backlinks corpus-a))
(define plate-backlink
  (Ix 2 backlinks-a))
assert(Equal (path ["defs" "plate"])
  (backlink-target plate-backlink))
assert(Equal [(path ["defs" "render"])]
  (backlink-sources plate-backlink))
(define surface-impact
  (source-impact (path ["wiki" "surface-page"]) corpus-a))
assert(Equal
  [(path ["defs" "plate"]) (path ["nodes" "plate"])]
  (impact-definitions surface-impact))
assert(Equal
  [(path ["defs" "plate"]) (path ["defs" "render"])]
  (impact-incoming surface-impact))
assert(Eq 0 (Sz (impact-diagnostics surface-impact)))

;;; Ordinary Nenex/Semidoc pages do not opt into Foundry and therefore do not
;;; generate noisy compiler errors.
(define ordinary
  (admit [(src ["wiki" "notes"]
    (unlines [";. /wiki/notes" "" "  ;= Notes" "" "    ordinary prose"]))]))
assert(Eq 0 (Sz (admission-definitions ordinary)))
assert(Eq 0 (Sz (admission-diagnostics ordinary)))
(define ordinary-page
  (admit-pages [(page-src ["wiki" "notes"]
    (unlines [";. /wiki/notes" "" "  ;= Notes" "" "    ordinary prose"]))]))
assert(Eq 0 (Sz (admission-definitions ordinary-page)))
assert(Eq 0 (Sz (admission-diagnostics ordinary-page)))

;;; A direct normalized-record edit is authoritative even when a stale ['src]
;;; slot says something invalid.  Admission observes records only.
(define layer-page (page-tree layer-src))
(define layer-root (some-value (axal-get [] layer-page)))
(define edit-delta
  (myth-meld
    (myth-sing (path ["token" "color" "ink"]) (pails-t "magenta"))
    (myth-sing (path ["src"]) (pails-t "this is stale and invalid source"))))
(define edited-root (myth-meld edit-delta layer-root))
(define edited-page (axal-put [] edited-root layer-page))
(define edited-corpus
  (admit-pages [(page-source
    (provenance (path ["wiki" "layer-page"]) none) edited-page)]))
assert(Eq 0 (Sz (admission-diagnostics edited-corpus)))
(define edited-layer
  (some-value (admission-layer (path ["defs" "base"]) edited-corpus)))
assert(Equal (path ["defs" "base"]) (layer-name edited-layer))
assert(Equal "magenta"
  (myth-txt-at (path ["token" "color" "ink"])
    (layer-values edited-layer)))
assert(Equal "this is stale and invalid source"
  (myth-txt-at (path ["src"])
    (some-value (admission-record (path ["defs" "base"]) edited-corpus))))

;;; Invalid normalized records refuse: no definition or typed layer escapes.
(define invalid-page-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name not-a-reference"
     ";@ /foundry/guarded false"
     ";@ /token/color/ink black"
     ";. invalid-record-page"]))
(define invalid-page-corpus
  (admit-pages [(page-src ["wiki" "invalid-record"] invalid-page-src)]))
assert(Equal [(ts "field_ill_typed")]
  (diagnostic-codes invalid-page-corpus))
assert(Eq 0 (Sz (admission-definitions invalid-page-corpus)))
assert(Equal none
  (admission-layer (path ["defs" "base"]) invalid-page-corpus))

;;; The corpus index is a pure metadata observation.  It excludes surface-node
;;; implementation symbols and exposes only identity/provenance/edges/status.
(define observed-index (corpus-index page-corpus-a))
assert(Eq 4 (Sz observed-index))
assert(Equal (path ["defs" "catalog"])
  (index-entry-name (Ix 1 observed-index)))
assert(Equal
  [(path ["defs" "base"]) (path ["defs" "render"])]
  (index-entry-forward (Ix 1 observed-index)))
assert(Equal [(path ["defs" "render"])]
  (index-entry-incoming (Ix 2 observed-index)))
assert(Equal observed-index (corpus-index page-corpus-a))

;;; Missing references, type errors, collisions, and cycles are deterministic
;;; corpus diagnostics attributed to source provenance.
(define missing-src
  (unlines
    [";@ /foundry/kind catalog"
     ";@ /foundry/name ;/bad/missing"
     ";@ /catalog/source_role ;/source/example"
     ";@ /catalog/target_role ;/projection/example"
     ";@ /catalog/ceiling plate"
     ";@ /catalog/recipes ;/bad/no-such-recipe"
     ";. local-name"]))
(define missing-corpus
  (admit [(src ["wiki" "missing"] missing-src)]))
assert(Equal [(ts "reference_missing")] (diagnostic-codes missing-corpus))
assert(Equal (path ["wiki" "missing"])
  (diagnostic-source (Ix 0 (admission-diagnostics missing-corpus))))
assert(Equal (path ["bad" "missing"])
  (diagnostic-subject (Ix 0 (admission-diagnostics missing-corpus))))

(define wrong-type-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/bad/wrong-type"
     ";@ /recipe/role ;/projection/example"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind plate"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling plate"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/test"
     ";@ /recipe/template ;/defs/base"
     ";. local-name"]))
(define wrong-type-corpus
  (admit
    [(src ["wiki" "layer"] layer-src)
     (src ["wiki" "wrong-type"] wrong-type-src)]))
assert(Equal [(ts "reference_ill_typed")]
  (diagnostic-codes wrong-type-corpus))

;;; An authored Slot fallback is an ordinary typed recipe edge in the corpus
;;; DAG.  It is not flattened into renderer fallback content.
(define slot-fallback-recipe-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/defs/slot_fallback"
     ";@ /recipe/role ;/projection/example/fallback"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind text"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling block"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/test"
     ";@ /recipe/template ;/defs/slot_fallback_surface"
     ";. local-fallback-recipe"]))
(define slot-fallback-surface-src
  (unlines
    [";@ /foundry/kind surface"
     ";@ /foundry/name ;/defs/slot_fallback_surface"
     ";@ /surface/root ;/nodes/slot-fallback-text"
     ";. local-fallback-surface"
     "  ;@ /surface/kind text"
     "  ;@ /surface/role ;/projection/example/fallback"
     "  ;@ /surface/text unavailable"
     "  ;. /nodes/slot-fallback-text"]))
(define slot-surface-src
  (unlines
    [";@ /foundry/kind surface"
     ";@ /foundry/name ;/defs/slot_surface"
     ";. local-slot-surface"
     "  ;@ /surface/kind slot"
     "  ;@ /surface/role ;/projection/example/content"
     "  ;@ /slot/accepts ;/surface/text"
     "  ;@ /slot/cardinality one"
     "  ;@ /slot/required false"
     "  ;@ /slot/fallback ;/defs/slot_fallback"
     "  ;@ /slot/participation ;/participation/content"
     "  ;. /nodes/content-slot"]))
(define slot-fallback-corpus
  (admit
    [(src ["wiki" "slot-surface"] slot-surface-src)
     (src ["wiki" "slot-fallback"] slot-fallback-recipe-src)
     (src ["wiki" "slot-fallback-surface"] slot-fallback-surface-src)]))
assert(Eq 0 (Sz (admission-diagnostics slot-fallback-corpus)))
(define slot-refs
  (filter
    (lambda (r) (Equal (path ["nodes" "content-slot"])
                  (reference-from r)))
    (admission-references slot-fallback-corpus)))
assert(Eq 1 (Sz slot-refs))
assert(Equal (path ["defs" "slot_fallback"])
  (reference-target (Ix 0 slot-refs)))
assert(Equal (ts "recipe") (reference-expected (Ix 0 slot-refs)))

;; Definition existence and materialization are distinct.  The admitted
;; Recipe becomes available only because its exact template Surface is also
;; admitted; the Slot template closes that pair without copying either node.
(define fallback-materialized
  (some-value
    (admission-surface-recipe (path ["defs" "slot_fallback"])
      slot-fallback-corpus)))
assert(Equal (path ["defs" "slot_fallback"])
  (recipe-name (surface-recipe-recipe fallback-materialized)))
assert(Equal (path ["defs" "slot_fallback_surface"])
  (surface-name (surface-recipe-surface fallback-materialized)))
(define slot-template-doc
  (some-value
    (admission-document (path ["defs" "slot_surface"])
      slot-fallback-corpus)))
(define slot-template (some-value (document-surface slot-template-doc)))
(define fallback-set
  (some-value
    (admission-fallback-recipes slot-template slot-fallback-corpus)))
assert(Eq 1 (Sz fallback-set))

;; A typed Recipe with no inline or external Surface remains unavailable.
(define unmaterialized-recipe-src
  (unlines
    [";@ /foundry/kind recipe"
     ";@ /foundry/name ;/defs/unmaterialized"
     ";@ /recipe/role ;/projection/example/fallback"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind text"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling block"
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/test"
     ";. local-unmaterialized"]))
(define unmaterialized-corpus
  (admit [(src ["wiki" "unmaterialized"] unmaterialized-recipe-src)]))
assert(Equal none
  (admission-surface-recipe (path ["defs" "unmaterialized"])
    unmaterialized-corpus))

(define layer-alias-src
  (unlines
    [";@ /foundry/kind layer"
     ";@ /foundry/name ;/defs/base"
     ";@ /foundry/guarded false"
     ";@ /token/color/ink gray"
     ";. another-page-name"]))
(define duplicate-corpus
  (admit
    [(src ["wiki" "layer-b"] layer-alias-src)
     (src ["wiki" "layer-a"] layer-src)]))
assert(Equal [(ts "definition_collision")]
  (diagnostic-codes duplicate-corpus))
;; Source sorting makes the collision owner deterministic despite input order.
assert(Equal (path ["wiki" "layer-a"])
  (diagnostic-source (Ix 0 (admission-diagnostics duplicate-corpus))))

(define (fallback-recipe name fallback)
  (unlines
    [(strcat [";@ /foundry/kind recipe"])
     (strcat [";@ /foundry/name ;/cycle/" name])
     ";@ /recipe/role ;/projection/cycle"
     ";@ /recipe/input record"
     ";@ /recipe/output_kind plate"
     ";@ /recipe/primitive knit"
     ";@ /recipe/ceiling plate"
     (strcat [";@ /recipe/fallbacks ;/cycle/" fallback])
     ";@ /recipe/backend neutral"
     ";@ /recipe/pronunciation ;/pronunciation/test"
     ";. local-name"]))
(define cycle-corpus
  (admit
    [(src ["wiki" "b"] (fallback-recipe "b" "a"))
     (src ["wiki" "a"] (fallback-recipe "a" "b"))]))
assert(Equal [(ts "reference_cycle") (ts "reference_cycle")]
  (diagnostic-codes cycle-corpus))

;;; A missing closure root is explicit; the routine never fabricates a partial
;;; root or hides corpus diagnostics.
(define rootless (close-corpus (path ["no" "root"]) corpus-a))
assert(Equal [(ts "closure_root_missing")]
  (map diagnostic-code (closure-diagnostics rootless)))
