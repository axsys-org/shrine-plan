(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind rex (#module rex))
(#bind sast (#module foil-sast))
(#bind foil (#module foil-new-env))

(define (check z)
  ;;;; Expansion and execution regressions for the generic builder syntax.
  (define sut (foil:perc-subject (_1 (source:compile 0 "sail_builder_tests"))))
  (define (value name) (foil:source-entry-val name sut))
  (define render (value ["sail" "render"]))
  (define card (value ["builder_card"]))
  (define definition (value ["builder_definition"]))
  assert(Eq "<dt>status</dt><dd>ready</dd>" (render (definition "status" "ready")))
  assert(Eq "Hi &lt;Ada&gt;" (render ((value ["builder_local"]) "<Ada>")))
  assert(Eq "<p>hello world</p>" (render (value ["builder_multiline"])))
  assert(Eq "<div>none</div>" (render ((value ["builder_match"]) ("/boot/maybe/none"))))
  assert(Eq "<div><b>ok</b>!</div>" (render ((value ["builder_match"]) ("/boot/maybe/some" "ok"))))
  (define (quoted x) (strcat [34 x 34]))
  (define (expected status people checked)
    (strcat ["<section class=" (quoted "card") " aria-label=" (quoted "A&amp;B")
      "><h2>Hello world</h2><p>" status "</p><ul>" people
      "</ul><dl><dt>status</dt><dd>ready</dd></dl><input type=" (quoted "checkbox")
      checked "></section>"]))
  assert(Eq (expected "Disabled" "" "") (render (card 0 [])))
  assert(Eq (expected "Enabled"
    (strcat ["<li class=" (quoted "person") ">Ada</li><li class="
      (quoted "person") ">&lt;Bob&gt;</li>"]) " checked")
    (render (card 1 ["Ada" "<Bob>"])))
  (print "builder execution tests passed")
  assert(Eq "missing" (render ((value ["builder_guard"]) ("/boot/maybe/none"))))
  assert(Eq "found" (render ((value ["builder_guard"]) ("/boot/maybe/some" "found"))))
  assert(Eq "tail" (render ((value ["builder_optional"]) 0)))
  assert(Eq "yestail" (render ((value ["builder_optional"]) 1)))
  assert(Equal [24] (value ["builder_generic"]))
  assert(Eq "done" (render ((value ["builder_loop"]) 3)))
  (define (reject src)
    (define result (Try (lambda (z) (DeepSeq (sast:parse-val-sast (rex:ParseRexNorm src)) 1)) 0))
    (Eq 1 (Hd result)))
  assert(reject "~. 1")
  assert(reject "~")
  assert(reject "~ sail (~.)")
  assert(reject "
~ sail
~#
  ~. 1
")
  assert(reject "
~ sail
~| 'div
  'id 1
")
  assert(reject "
~ sail
~# 'div
  'id
")
  (print "builder control and diagnostic tests passed")
  assert(Equal [] (value ["builder_empty"]))
  assert(Eq "<dt>a</dt><dd>b</dd>end" (render (value ["builder_call"])))
  assert(Eq "safe" (render ((value ["builder_scope"]) 1 2 3 4)))
  (print "builder scope and empty tests passed")
  assert(Eq (strcat ["<a class=" (quoted "button primary") " href="
    (quoted "/users/A&amp;B") ">View A&amp;B (42)</a>"])
    (render ((value ["builder_link"]) "A&B" 42)))
  (print "builder expression tests passed")

  1)
assert(Equal 1 (check 0))
