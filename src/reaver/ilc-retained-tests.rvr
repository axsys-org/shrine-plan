(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))
(#bind cache (#module ilc-retained))
(#bind structural (#module ilc-structural))
(define rules (structural:rules-with ilc:derive-staged-with))
(define (square x) (Mul x x))
(define (pair x) [x (square x)])
(define (sum-to x) (Ifz x 0 (Add x (sum-to (Dec x)))))
(define (check f x ys)
  (define program (cache:prepare rules f))
  (define initial (cache:start program x))
  assert(Equal (f x) (cache:value initial))
  (define (loop state ys)
    (Ifz ys 1
      (let ((next (_0 ys)) (old (cache:value state)))
        (define result (cache:advance state (ilc:replace-change next)))
        (define fresh (_1 result))
        assert(Equal (f next) (cache:value fresh))
        assert(Equal (cache:value fresh) (ilc:apply-change old (_0 result)))
        assert(Equal (f next) (cache:value (cache:reset fresh)))
        (loop fresh (drop 1 ys)))))
  (loop initial ys))
assert(check square 2 [3 4 0 7])
assert(check pair 2 [3 4 0 7])
assert(check sum-to 2 [5 0 3])
(define forward-law (Law 0 "forward" (1 3 (1 (0 Inc 1) 2))))
(define shared-law (Law 0 "shared" (1 (0 (0 Mul 1) 1) (0 (0 Add 2) 2))))
assert(check forward-law 3 [7 4])
assert(check shared-law 3 [7 4])
(define (call input) ((_0 input) (_1 input)))
assert(check call [Inc 3] [[Add 3] [Inc 5] [(Mul 3) 5] [(Add 2) 9]])
(define (captured x) (define f (Add x)) (f x))
assert(check captured 2 [7 0 4])
(define (over x) ((If x Inc Dec) x))
assert(check over 3 [0 5])
(define (fail x) (error "retained unused branch demanded"))
(define (branch x) (Ifz x 19 (fail 0)))
(define (check-lazy ignored)
  (define bad-state (cache:start (cache:prepare rules branch) 1))
  assert(Equal 19 (cache:value (_1 (cache:advance bad-state (ilc:replace-change 0)))))
  (define (choose x) (If (_0 x) (_1 x) (_2 x)))
  (define old (cache:start (cache:prepare rules choose) [1 7 (fail 0)]))
  assert(Equal 7 (cache:value old))
  (define dx (structural:fields [[0 (ilc:replace-change 0)] [2 (ilc:replace-change 9)]]))
  assert(Equal 9 (cache:value (_1 (cache:advance old dx))))
  assert(Equal 7 (cache:value old))
  assert(Equal 7 (cache:value (_1 (cache:advance old 0))))
  1)
assert(check-lazy 0)

;; White-box transfer test: seed a sentinel into an internal cached value.
;; This deliberately invalid state is NOT a semantic-equivalence test; it
;; proves update reads the saved Inc result instead of executing old Inc again.
(define cached-law
  (Law 0 "cache-load" (0 (0 Add (0 Inc (0 Ix0 1))) (0 Ix1 1))))
(define (check-cache-load ignored)
  (define state (cache:start (cache:prepare rules cached-law) [4 5]))
  assert(Equal 10 (cache:value state))
  (define root (_2 state))
  (define root-trace (_1 root))
  (define call (_2 root-trace))
  (define children (_0 (_1 call)))
  (define seeded-children (Up 0 (Up 0 99 (_0 children)) children))
  (define seeded-call (Up 1 (Up 0 seeded-children (_1 call)) call))
  (define seeded-root (Up 1 (Up 2 seeded-call root-trace) root))
  (define seeded-state (Up 2 seeded-root state))
  (define dx (structural:field 1 (ilc:replace-change 7)))
  assert(Equal 12 (cache:value (_1 (cache:advance state dx))))
  assert(Equal 106 (cache:value (_1 (cache:advance seeded-state dx))))
  1)
assert(check-cache-load 0)

(#bind tc (#module ilc-typecheck))
(#bind fixture (#module ilc-typecheck-fixture))
(#bind elab (#module foil-new-elab))
(#bind builtins (#module foil-builtins))
(#bind elab-fixture (#module foil-test-elaboration))
(#bind sast (#module foil-sast))
(#bind rex (#module rex))
(define (checker-tests ignored)
  (define compiler (fixture:compiler 0))
  (define (input text) [compiler (fixture:expression text)])
  assert(check tc:check (input "1") [(input "2") (input "3")])
  assert(check tc:check (input "(add 1 2)")
    [(input "(add 1 3)") (input "(mul 4 5)") (input "(add 6 7)")])
  assert(check tc:check (input "(\ x=nat (add x 1))")
    [(input "(\ x=nat (add x 2))")])
  assert(check tc:check (input "(? 1 2 3)") [(input "(? 0 4 5)")])
  assert(check tc:check (input "
  ^ nat
  1") [(input "
  ^ nat
  2")])
  (define state (cache:start (cache:prepare rules tc:check) [compiler (fixture:tree 1 1)]))
  (define next (_1 (cache:advance state (fixture:edit 1 9))))
  (define next2 (_1 (cache:advance next (fixture:edit 1 10))))
  assert(Equal (tc:check (_1 next2)) (cache:value next2))
  (define (attempt f) (Try (lambda (z) (DeepSeq (f 0) (f 0))) 0))
  (define bad (structural:field 1 (ilc:replace-change (fixture:expression "(add 1 (\ x x))"))))
  ;; Parsed editor inputs preserve the ordinary located diagnostic across
  ;; successive retained updates and leave the last valid state usable.
  (define parsed (cache:start (cache:prepare rules tc:check) (input "(add 1 2)")))
  (define parsed1 (_1 (cache:advance parsed (ilc:replace-change (input "(add 3 4)")))))
  (define parsed2 (_1 (cache:advance parsed1 (ilc:replace-change (input "(add 5 6)")))))
  (define expected (attempt (lambda (z) (tc:check (ilc:apply-change (_1 parsed2) bad)))))
  (define actual-error (attempt (lambda (z) (cache:value (_1 (cache:advance parsed2 bad))))))
  assert(Equal 1 (Hd expected))
  assert(Equal expected actual-error)
  assert(Equal (tc:check (_1 parsed2)) (cache:value parsed2))
  ;; Existing ILC has a diagnostic-order limitation when an unlocated fixture
  ;; AST becomes a located, invalid AST. Retention must agree with staged ILC;
  ;; this does not assert exact diagnostic equality with a cold full check.
  (define bridge-error (attempt (lambda (z) (cache:value (_1 (cache:advance next2 bad))))))
  assert(Equal 1 (Hd bridge-error))
  assert(Equal bridge-error (attempt (lambda (z)
    (tc:update (ilc:derive-staged-with rules tc:check) (_1 next2) (tc:check (_1 next2)) bad))))
  (define (bound text)
    (elab-fixture:elab-mod (elab:compiler-for builtins:default-subject)
      (sast:parse-module-sast 0 (rex:ParseRexNormFile text))))
  (define ca (bound "+ x 1"))
  (define cb (bound "+ x (\ a=nat a)"))
  assert(check tc:check [ca (fixture:expression "x")] [[cb (fixture:expression "x")]])
  1)
assert(checker-tests 0)

;; Recursive cached data stays lazy; only finite observations are requested.
(define cyclic-law (Law 0 "cyclic" (1 (0 (0 (0 0) 1) 2) 2)))
(define self-law (Pin (Law 0 "self" 0)))
(define (check-recursive ignored)
  (define old (cache:start (cache:prepare rules cyclic-law) 3))
  (define next (_1 (cache:advance old (ilc:replace-change 8))))
  assert(Equal 8 (_0 (_1 (_1 (cache:value next)))))
  (define self-state (cache:start (cache:prepare rules self-law) 3))
  assert(Equal self-law (cache:value (_1 (cache:advance self-state (ilc:replace-change 8)))))
  (define plain (cache:start (cache:prepare [] square) 3))
  assert(Equal 25 (cache:value (_1 (cache:advance plain (ilc:replace-change 5)))))
  1)
assert(check-recursive 0)
(print "retained ILC and production checker tests passed")
