;;;; Forge tests — the whole tool above the socket is a pure function
;;;; (state, method, target, body) -> [state', response], so the tests
;;;; drive it exactly the way the browser does and assert on the HTML.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind forge (#module forge))

;;; Shell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r0 (forge:route forge:empty-state "GET" "/" ""))
assert(forge:str-contains? "/mod/bst" (_1 r0))
assert(forge:str-contains? "workspace" (_1 r0))

;;; Module browser reads the live subject ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r1 (forge:route (_0 r0) "GET" "/mod/bst" ""))
assert(forge:str-contains? "/bst/insert" (_1 r1))
;; generated accessors appear because the browser reads the subject
assert(forge:str-contains? "set_sz" (_1 r1))
assert(forge:str-contains? "over_sz" (_1 r1))
;; lore heads ride along in the entry rows
assert(forge:str-contains? "Number of nodes" (_1 r1))

;;; Entry inspector: type, lore, doctests, references, pipeline ;;;;;;;;;;;;;;;;;;

(define r2 (forge:route (_0 r1) "GET" "/entry/bst/bst.size" ""))
assert(forge:str-contains? "function" (_1 r2))
;; doctests executed against the live subject, all green
assert(forge:str-contains? "dt-pass" (_1 r2))
assert(Nil (forge:str-contains? "dt-fail" (_1 r2)))
;; who-calls is a TC_GLOBAL query: balance calls size
assert(forge:str-contains? "referenced by" (_1 r2))
assert(forge:str-contains? "/bst/balance" (_1 r2))
;; the pipeline drawers are there
assert(forge:str-contains? "typed core" (_1 r2))
assert(forge:str-contains? "lowered IR" (_1 r2))
assert(forge:str-contains? "compiled value" (_1 r2))

;;; Workspace evaluation runs compiled output ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r3
  (forge:route (_0 r2) "POST" "/eval/bst" "(bst:got 2 (bst:duo 1 10 2 20))"))
assert(forge:str-contains? ">20</pre>" (_1 r3))

;; a bad expression renders a located diagnostic, nothing crashes
(define r4 (forge:route (_0 r3) "POST" "/eval/bst" "(bst:got 1 2 3 4 5)"))
assert(forge:str-contains? "evaluation error" (_1 r4))

;;; Accept with identical source: an empty structural changeset ;;;;;;;;;;;;;;;;;;

(define bst-bundle (_1 (forge:state-bundle (_0 r4) "bst")))
(define r5
  (forge:route (_0 r4) "POST" "/save/bst" (forge:bundle-src bst-bundle)))
assert(forge:str-contains? "0 changed" (_1 r5))
assert(forge:str-contains? "0 added" (_1 r5))

;;; A module that does not compile renders its diagnostics as a pane ;;;;;;;;;;;;;

(define r6 (forge:route (_0 r5) "GET" "/mod/axal" ""))
assert(forge:str-contains? "does not compile" (_1 r6))

(print "forge tests passed")
