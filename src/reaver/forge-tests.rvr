;;;; Forge tests — the whole tool above the socket is a pure function
;;;; (state, method, target, body) -> [state', response], so the tests
;;;; drive it exactly the way the browser does and assert on the HTML.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind forge (#module forge))
(#bind forge-cli (#module forge-cli))
(#bind ty (#module foil-types))
(#bind foil-subject (#module foil-subject))

;;; Shell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r0 (forge:route forge:empty-state "GET" "/" ""))
assert(forge:str-contains? "/mod/bst" (_1 r0))
assert(forge:str-contains? "workspace" (_1 r0))

;;; Module browser reads the live subject ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r1 (forge:route (_0 r0) "GET" "/mod/bst" ""))
assert(forge:str-contains? "/bst/insert" (_1 r1))
;; generated accessors appear because the browser reads the subject
assert(forge:str-contains? "set_sz" (_1 r1))
assert(forge:str-contains? "over_sz" (_1 r1))
;; lore heads ride along in the entry rows
assert(forge:str-contains? "Number of nodes" (_1 r1))

;;; Entry inspector: type, lore, doctests, references, pipeline ;;;;;;;;;;;;;;;;;;

(define r2 (forge:route (_0 r1) "GET" "/entry/bst/bst.size" ""))
assert(forge:str-contains? "function" (_1 r2))
;; doctests executed against the live subject, all green
assert(forge:str-contains? "dt-pass" (_1 r2))
assert(Nil (forge:str-contains? "dt-fail" (_1 r2)))
;; who-calls is a TC_GLOBAL query: balance calls size
assert(forge:str-contains? "referenced by" (_1 r2))
assert(forge:str-contains? "/bst/balance" (_1 r2))
;; the pipeline drawers are there
assert(forge:str-contains? "typed core" (_1 r2))
assert(forge:str-contains? "lowered IR" (_1 r2))
assert(forge:str-contains? "compiled value" (_1 r2))

;;; Workspace evaluation runs compiled output ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r3
  (forge:route (_0 r2) "POST" "/eval/bst"
    "(bst/got[nat] 2 0 (bst/duo[nat] 1 10 2 20))"))
assert(forge:str-contains? ">20</pre>" (_1 r3))

;; a bad expression renders a located diagnostic, nothing crashes
(define r4 (forge:route (_0 r3) "POST" "/eval/bst" "(bst/got 1 2 3 4 5)"))
assert(forge:str-contains? "evaluation error" (_1 r4))

;;; Accept with identical source: an empty structural changeset ;;;;;;;;;;;;;;;;;;

(define bst-bundle (_1 (forge:state-bundle (_0 r4) "bst")))
(define r5
  (forge:route (_0 r4) "POST" "/save/bst" (forge:bundle-src bst-bundle)))
assert(forge:str-contains? "0 changed" (_1 r5))
assert(forge:str-contains? "0 added" (_1 r5))

;;; A module that does not compile renders its diagnostics as a pane ;;;;;;;;;;;;;

(define r6 (forge:route (_0 r5) "GET" "/mod/axal" ""))
assert(forge:str-contains? "does not compile" (_1 r6))

;;; The CLI port: the same panes as text, threading the same state ;;;;;;;;;;;;;;;

(define c0 (forge-cli:render-cmd (_0 r6) ["mods" "" ""]))
assert(forge:str-contains? "bst" (_1 c0))

(define c1 (forge-cli:render-cmd (_0 c0) ["ls" "bst" ""]))
assert(forge:str-contains? "/bst/insert" (_1 c1))
assert(forge:str-contains? "generated" (_1 c1))
assert(forge:str-contains? "Number of nodes" (_1 c1))

(define c2 (forge-cli:render-cmd (_0 c1) ["show" "bst" "bst.size"]))
assert(forge:str-contains? "pass" (_1 c2))
assert(forge:str-contains? "referenced by:" (_1 c2))
assert(forge:str-contains? "type: @v {" (_1 c2))

(define c3 (forge-cli:render-cmd (_0 c2) ["doctest" "bst" ""]))
assert(forge:str-contains? "passed, 0 failed" (_1 c3))
assert(Eq 0 (_2 c3))

(define c4
  (forge-cli:render-cmd (_0 c3)
    ["eval" "bst" "(bst/got[nat] 2 0 (bst/duo[nat] 1 10 2 20))"]))
assert(forge:str-contains? "value: 20" (_1 c4))
assert(Eq 0 (_2 c4))

;; a failing command reports bad=1
(define c5 (forge-cli:render-cmd (_0 c4) ["eval" "bst" "(bst/got 1 2 3)"]))
assert(Eq 1 (_2 c5))

;;; Diagnostic rendering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define diag-nat (ty:TNAT 0))
(define diag-bst-nat
  (ty:TNOM (foil-subject:ty-ap-encode [["bst"] ["nat"]]) 0))

;; elab errors: message, location, label/value details with types decoded.
assert(Equal
  ["cast (^) target does not accept the value's type"
   "  at line 12, col 4"
   "  want: /bst[/nat]"
   "  got: nat"]
  (forge:diag-lines
    ["foil-elab-error" "cast (^) target does not accept the value's type"
     ["at" ["line" 12 "col" 4]]
     ["want" diag-bst-nat "got" diag-nat]]))

;; sast errors: message and location; the raw node stays out of view.
assert(Equal
  ["wack rune" "  at line 3, col 1"]
  (forge:diag-lines
    ["foil-sast-error" "wack rune" ["at" ["line" 3 "col" 1]] 0]))

;; module wf diags: one line per decl, tagged paths decoded.
assert(Equal
  ["types are not well-formed"
   "  in /bad_lam (line 2, col 3): bad type reference /bogus"]
  ;; tagged ["path" p] payload entries decode through path-text
  (forge:diag-lines
    ["foil-type-wf"
     [["in-decl" ["bad_lam"]
       ["bad type reference" ["path" ["bogus"]]]
       ["line" 2 "col" 3]]]]))

;; import diagnostics
assert(Equal
  ["import cycle: module vec is already being imported"
   "  at line 1, col 1"]
  (forge:diag-lines
    ["foil-import-cycle" ["module" "vec"] ["at" ["line" 1 "col" 1]]]))
assert(Equal
  ["import collision: /vec is declared more than once"
   "  at line 3, col 1"]
  (forge:diag-lines
    ["foil-import-collision" ["path" ["vec"]] ["at" ["line" 3 "col" 1]]]))

;; unknown location and unknown shapes degrade gracefully.
assert(Equal
  ["boom" "  at unknown location"]
  (forge:diag-lines
    ["foil-sast-error" "boom" ["at" "unknown-location"] 0]))
assert(Equal [(forge:render-plain ("some" 5))]
  (forge:diag-lines ("some" 5)))

(print "forge tests passed")
