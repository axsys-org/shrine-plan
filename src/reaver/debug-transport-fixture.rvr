;;;; Shared native startup for disposable transport regression workers.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind compiler (#module foil-new-env))
(#bind source (#module foil-source))
(#bind backend (#module foil-grove-backend))
(#bind debugger-source (#module grove-debugger-source))

(define (start port mode count)
  (print "TRANSPORT-PREPARING")
  (define prepared (backend:prepare-with compiler:empty-foil-cache "debugger_contract"))
  (print "TRANSPORT-COMPILING-FIXTURE")
  (define compiled (source:compile (_0 prepared) "tests/debug_http"))
  (define entry (compiler:get-perc ["debug_http" "main"] (_1 compiled)))
  (print ("TRANSPORT-FIXTURE-READY" (Seq (force entry) 1)))
  ;; Compile only the selected data fixture, not every transport family.
  (define fixture
    (cond ((Eq mode "journal") "journal_http")
          ((Eq mode "value") "value_http")
          ((Eq mode "journal-eden") "debug_http")
          (else "physical_http")))
  (define state-build (If (Eq fixture "debug_http") compiled
    (source:compile (_0 compiled) (strcat ["tests/" fixture]))))
  (define state-name
    (cond ((Eq mode "journal-eden") "initial")
          ((Eq mode "physical-epoch") "epoch_state")
          (else "state")))
  (define state-entry (compiler:get-perc [fixture state-name] (_1 state-build)))
  (define state (If (Or (Eq mode "journal") (Eq mode "physical-large"))
    (state-entry port count) (state-entry port)))
  (define compile (backend:compile-port (_1 prepared) (_2 prepared)))
  (define (compile-request request)
    (print ("TRANSPORT-GROVE-COMPILING" (_0 request)))
    (define result (compile request))
    (Seq result (print ("TRANSPORT-GROVE-COMPILED" (_0 request))))
    result)
  (print "TRANSPORT-PUBLISHING")
  (entry port mode state
    (read-text-file "grove/sys_slots.grove")
    (read-text-file "grove/sys_types.grove")
    (debugger-source:read 0)
    compile-request))

(#export start)
