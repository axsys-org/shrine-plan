;;;; Typed outbound driver: pure transitions and the native ABI adapter.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind rex (#module rex))
(#bind host (#module helm-fetch))
(#bind helm (#module helm-wire))
(#bind http (#module http-client))
(define sut (foil:compile-mod foil:default-subject "helm_fetch"))
(define (app p) (foil:source-entry-val p sut))
(define step (app ["fetch_driver" "step"]))
(define empty (app ["fetch_state" "empty"]))
(define add (app ["myth" "add"]))
(define twig (app ["twig" "nat"]))
(define new (app ["myth" "new"]))
(define slot (app ["myth" "nat_at"]))
(define request (app ["fetch" "req"]))
(define name ("ts" "http_client"))
(define kid ("ts" "r1"))
(define other ("ts" "other"))
(define dpath [("ts" "io") name])
(define path (snoc kid dpath))
(define (known t) ("/boot/res/known" t))
(define (event msg) ("/boot/fetch_event/helm" msg))
(define marker (add (twig [("ts" "fresh") kid] 1) new))
(define go (event ("/boot/driver_in/go" (known marker))))
(define born (step name empty go))
assert(Equal [kid] (_0 (_0 born)))
assert(Equal [kid] (_1 (_0 born)))
assert(Equal [("/boot/fetch_effect/send" ("/boot/driver_out/read" path))] (_1 born))
;; A repeated notification doesn't duplicate an outstanding read.
(define changed (event ("/boot/driver_in/change" dpath (known marker))))
assert(Equal [] (_1 (step name (_0 born) changed)))
assert(Equal [] (_1 (step name empty
  (event ("/boot/driver_in/change" [other] (known marker))))))

(define req (request "GET" "https://example.invalid/" 0 5000))
(define read (event ("/boot/driver_in/qres" path (known req))))
(define started (step name (_0 born) read))
(define state (_0 started))
assert(Equal [] (_1 state))
assert(Equal [kid] (_2 state))
(define effect (Ix 0 (_1 started)))
assert(Eq "/boot/fetch_effect/start" (Hd effect))
(define transfer (_1 effect))
assert(Equal ["GET" "https://example.invalid/" [] 0 0 5000 0 1048576]
  (Coup 0 transfer))
assert(Equal [(http:mk-req "GET" "https://example.invalid/" [] 0)
              (http:mk-cfg 0 5000 0 1048576)]
  (host:native-request transfer))
assert(Eq 0 (host:warm 0))
assert(Equal [] (_1 (step name state read)))
;; Wrong-path and unsolicited replies cannot claim another request.
assert(Equal [] (_1 (step name (_0 born)
  (event ("/boot/driver_in/qres" [("ts" "io") other kid] (known req))))))
assert(Equal [] (_1 (step name (_0 born)
  (event ("/boot/driver_in/qres" [] (known req))))))

(define done ("/boot/fetch_event/done" kid
  ("/boot/fetch_result/ok" 201 "https://example.invalid/" "X: y" "body")))
(define answered (step name state done))
(define next (_0 answered))
assert(Equal [] (_2 next))
assert(Eq 2 (Sz (_3 next)))
assert(Equal [] (_1 (step name next done)))
(define writes (_1 answered))
assert(Eq 2 (Sz writes))
(define command (_0 (Ix 0 writes)))
assert(Eq "/boot/driver_out/cmd" (Hd command))
assert(Equal name (_0 command))
(define task (_1 command))
assert(Equal path (_0 task))
(define response (_0 (_1 task)))
assert(Eq 201 (slot [("ts" "res_status")] 0 response))
assert(Eq "body" (slot [("ts" "res_body")] 0 response))
(define clear-task (_1 (_0 (Ix 1 writes))))
assert(Equal dpath (_0 clear-task))
assert(Eq 0 (slot [("ts" "fresh") kid] 99 (_0 (_1 clear-task))))

(define ok (event ("/boot/driver_in/ack" ("/boot/rsvp/ok" "/boot/maybe/none"))))
(define ack1 (_0 (step name next ok)))
assert(Equal [kid] (_0 ack1))
(define ack2 (_0 (step name ack1 ok)))
assert(Equal [] (_0 ack2))
assert(Equal [] (_3 ack2))
assert(Equal [] (_1 (step name ack2 ok)))
assert(Eq 1 (Sz (_1 (step name ack2 changed))))
;; A failed marker-clear remains claimed and is reported.
(define no (event ("/boot/driver_in/ack" ("/boot/rsvp/no" ("ts" "rejected")))))
(define failed (step name ack1 no))
assert(Equal [kid] (_0 (_0 failed)))
assert(Equal [("/boot/fetch_effect/failed" kid)] (_1 failed))

;; Vanished requests only clear their marker; malformed records answer bad-url.
(define vanished (step name (_0 born) (event ("/boot/driver_in/qres" path "/boot/res/null"))))
assert(Eq 1 (Sz (_1 vanished)))
assert(Equal [] (_1 (_0 vanished)))
(define malformed (step name (_0 born) (event ("/boot/driver_in/qres" path (known new)))))
assert(Eq 2 (Sz (_1 malformed)))
(define bad-response (_0 (_1 (_1 (_0 (Ix 0 (_1 malformed)))))))
assert(Eq 0 (slot [("ts" "res_err")] 99 bad-response))
assert(Eq 1 (_2 (step name state (event "/boot/driver_in/die"))))
assert(Equal [] (_1 (step name empty done)))

;; The coordinator codec and native response codec are the only wire adapters.
assert(Equal ("/boot/rsvp/no" ("ts" "task_crashed")) helm:driver-crash-rsvp)
assert(Equal ("/boot/driver_in/go" (known marker)) (helm:driver-message ["go" (known marker)]))
assert(Equal ["cmd" name task] (helm:driver-command command))
assert(Equal ["read" path] (helm:driver-command ("/boot/driver_out/read" path)))
assert(Equal ("/boot/fetch_result/err" 4) (host:typed-result (1 4)))
assert(Equal ("/boot/fetch_result/ok" 200 "url" (strcat ["X: y" 13 10]) "body")
  (host:typed-result (0 [200 (http:mk-bar "url")
    [[(http:mk-bar "X") (http:mk-bar "y")]] (http:mk-bar "body")])))

;; Passing a Helm-to-driver message to the outbound port must fail to typecheck.
(define wrong (Try (lambda (z)
  (foil:compile-rex sut "bad-driver" (rex:ParseRexNorm "
+ bad
  \ ports=fetch_ports
  ^ nat
  (ports.send driver_in/die)
"))) 0))
assert(Eq 1 (Hd wrong))
;; Exercise the real Foil effect loop in MAIN with deterministic host ports.
;; A read must be sent before receiving die; an unforced Send would deadlock
;; the production worker at its next Recv.
(define (test-send message)
  (If (Eq "/boot/driver_out/read" (Hd message))
    (Trace "FETCH-ORDER-read" 0) (error "unexpected driver message")))
(define (test-recv z)
  (Trace "FETCH-ORDER-recv" (event "/boot/driver_in/die")))
(define (no-start kid request) (error "unexpected transfer"))
(define (no-fail kid) (error "unexpected failure"))
(define ports ("/boot/fetch_ports" test-recv test-send no-start no-fail))
assert(Eq 0 ((app ["fetch_driver" "run"]) ports name ("/boot/driver_in/go" (known marker))))
(print "Foil fetch driver tests passed")
