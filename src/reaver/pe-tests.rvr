(#bind std (#module std))
(#import std)
(#bind pe (#module pe))
(#bind ilc (#module ilc))

assert(Equal 5 ((pe:partial-eval (Add 2)) 3))
assert(Equal 1 (Arity (pe:partial-eval (Add 2))))
(define (sum3 x y z) (Add x (Add y z)))
assert(Equal 10 ((pe:partial-eval (sum3 2 3)) 5))
;; Original self keeps its arity and static arguments during recursion.
(define (loop base n) (Ifz n base (Inc (loop base (Dec n)))))
assert(Equal 12 ((pe:partial-eval (loop 7)) 5))
(define escape (Law 1 "escape" 0))
assert(Equal escape ((pe:partial-eval (escape 9)) 3))
;; Forward lets, original self and literals that look like law expressions.
(define forward (Law 1 "forward" (1 4 (1 (0 1 2) 3))))
assert(Equal 8 ((pe:partial-eval (forward Inc)) 7))
(define quoted (Law 1 "quoted" (0 (0 1 2))))
assert(Equal (0 1 2) ((pe:partial-eval (quoted 4)) 7))
(define pap (Law 1 "pap" (If 1 23)))
assert(Equal (If 1 23) ((pe:partial-eval (pap 4)) 7))
assert(Equal 0 (pe:law-call? 2 (If 1 23)))
assert(Equal 0 (pe:subst-body-var 3 9 0))
assert(Equal [0] (pe:get-const 2 (0 0)))
assert(Equal [(0 1 2)] (pe:get-const 2 (0 (0 1 2))))
;; Constant saturated calls are folded only with explicit authorization.
(define raw (Law 1 "raw" (0 (0 Add (0 Inc 1)) 2)))
(define folded (pe:partial-eval-with [Inc Add] (raw 3)))
assert(Equal 4 (pe:pull-const (_0 (pe:pull-const (_0 (Body folded))))))
assert(Equal 9 (folded 5))
(define (fail x) (error "PE executed an unapproved function"))
(define (branch static dynamic) (Ifz dynamic 42 (fail static)))
assert(Equal 42 ((pe:partial-eval (branch 7)) 0))
assert(Equal 42 ((pe:partial-eval-with [Inc] (branch 7)) 0))
assert(Equal 1 (Hd (Try pe:partial-eval 0)))
;; Domain changes can update a retained output without recomputing its base.
(define (add-change old increment) (Add old increment))
assert(Equal 12 (ilc:apply-change 5 (ilc:custom-change add-change 7)))
assert(Equal 15
  (ilc:apply-change 5
    (ilc:compose-change 5 (ilc:custom-change add-change 7)
      (ilc:custom-change add-change 3))))
(print "partial evaluator tests passed")
