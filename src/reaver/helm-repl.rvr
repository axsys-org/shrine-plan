;;;; The namespace REPL: buddy's terminal session rebuilt on the live
;;;; lain stack.  MAIN boots the full namespace (mirror, apps, chore
;;;; and doctest drivers, the explorer on a real port — browse in a
;;;; browser while you type), then runs this loop instead of parking.
;;;; Every command is namespace traffic: evals/resyncs ride build
;;;; chore requests, doctests ride dt requests, browsing reads the
;;;; /boot mirror — the REPL owns no compiler state of its own.
;;;;
;;;; Commands:
;;;;   <expr>            evaluate against the focus module
;;;;   name = expr       bind a REPL variable (re-evaluated as a
;;;;                     textual prelude on later evals, so vars
;;;;                     survive resyncs by construction)
;;;;   :m <mod>          switch focus
;;;;   :c [mod]          recompile (report + changeset + remount)
;;;;   :t [mod]          run the module's doctests
;;;;   :s <mod> <dotted> inspect one mirror entry (bst bst.size)
;;;;   :ns <root>        entries under a source namespace root
;;;;   :vars  :h  :q
;;;;   <enter>           recompile the focus module
;;;;
;;;; The poke port (x/repl wires your editor's save hook to it)
;;;; triggers the same resync as :c.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind parse (#module parse))
(#import parse)

(#bind quip (#module quip))
(#bind foil (#module foil))
(#bind foil-lore (#module foil-lore))
(#bind helm (#module helm))
(#bind helm-http (#module helm-http))
(#bind helm-run (#module helm-run))
(#bind wire-json (#module wire-json))

(define (ts s) ("ts" s))
(define NL (strcat [10]))

(define (starts-with pre s)
  (Eq pre (Mod s (Lsh 1 (Mul 8 (Bytes pre))))))

(define (words s)
  (filter Bytes (helm-http:split-ch 32 s)))

;; "name = expr" -> [name expr] when name is a plain identifier; 0
;; otherwise.  Splits on the FIRST " = " only.
(define (bind-split line)
  (define n (Bytes line))
  (define (ident? w)
    (define (go i)
      (Or (Ge i (Bytes w))
        (And (let ((c (Load8 i w)))
               (Or (And (Ge c 97) (Le c 122))
                 (Or (And (Ge c 48) (Le c 57)) (Eq c 95))))
          (go (Inc i)))))
    (And (Gt (Bytes w) 0) (go 0)))
  (define (find-eq i)
    (cond
      ((Ge (Add i 2) n) 0)
      ((And (Eq 32 (Load8 i line))
         (And (Eq 61 (Load8 (Add i 1) line))
           (Eq 32 (Load8 (Add i 2) line))))
        [i])
      (else (find-eq (Inc i)))))
  (define hit (find-eq 0))
  (Ifz hit
    0
    (let* ((i (Ix 0 hit))
           (name (foil-lore:str-slice 0 i line))
           (expr (Rsh line (Mul 8 (Add i 3)))))
      (If (And (ident? name) (Gt (Bytes expr) 0))
        [name expr]
        0))))

;;; The pure step: (state line) -> [state' action] ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; state = [focus vars serial]; vars = [[name expr] ..]
;;; actions: ["quit"] ["rows" rows] ["eval" mod text] ["resync" mod]
;;;          ["doctest" mod] ["show" mod dotted] ["nsroot" root]

(define (st-focus st) (Ix 0 st))
(define (st-vars st) (Ix 1 st))
(define (st-serial st) (Ix 2 st))

(define help-rows
  ["the namespace repl — every command is namespace traffic"
   ""
   "  <expr>             evaluate against the focus module"
   "  name = expr        bind a repl variable (:vars lists them)"
   "  :m <mod>           switch focus"
   "  :c [mod]           recompile: report, changeset, remount"
   "  :t [mod]           run the module's doctests"
   "  :s <mod> <dotted>  inspect one entry (:s bst bst.size)"
   "  :ns <root>         entries under a namespace root"
   "  <enter>            recompile the focus module"
   "  :q                 quit (the explorer dies with the image)"])

;; A var's prelude line; stacked = forms each take the rest as body.
(define (var-prelude vars)
  (strcat
    (map (lambda (v) (strcat ["=  " (Ix 0 v) "  " (Ix 1 v) NL])) vars)))

(define (repl-step st line)
  (define focus (st-focus st))
  (define vars (st-vars st))
  (define ws (words line))
  (define (arg i dflt) (If (Gt (Sz ws) i) (Ix i ws) dflt))
  (define bind (bind-split line))
  (cond
    ((Eq 0 (Bytes line)) [st ["resync" focus]])
    ((Equal line ":q") [st ["quit"]])
    ((Equal line ":h") [st ["rows" help-rows]])
    ((Equal line ":vars")
      [st ["rows"
           (Ifz (Sz vars)
             ["no vars"]
             (map (lambda (v) (strcat ["  " (Ix 0 v) " = " (Ix 1 v)]))
               vars))]])
    ((Equal (arg 0 "") ":m")
      (let ((mod (arg 1 focus)))
        [[mod vars (st-serial st)]
         ["rows" [(strcat ["focus: " mod])]]]))
    ((Equal (arg 0 "") ":c") [st ["resync" (arg 1 focus)]])
    ((Equal (arg 0 "") ":t") [st ["doctest" (arg 1 focus)]])
    ((Equal (arg 0 "") ":s") [st ["show" (arg 1 focus) (arg 2 "")]])
    ((Equal (arg 0 "") ":ns") [st ["nsroot" (arg 1 "")]])
    ((starts-with ":" line)
      [st ["rows" [(strcat ["unknown command " line " — :h for help"])]]])
    (bind
      (let ((name (Ix 0 bind))
            (expr (Ix 1 bind)))
        [[focus
          (snoc [name expr]
            (filter (lambda (v) (Nil (Equal name (Ix 0 v)))) vars))
          (st-serial st)]
         ["eval" focus (strcat [(var-prelude vars) expr])]]))
    (else
      [st ["eval" focus (strcat [(var-prelude vars) line])]])))

;;; Rendering chore answers as terminal rows ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; rs = ["R" txt-at nat-at pail-at tyshow] — compiled myth readers.
(define (r-txt rs) (Ix 1 rs))
(define (r-nat rs) (Ix 2 rs))
(define (r-pail rs) (Ix 3 rs))
(define (r-tyshow rs) (Ix 4 rs))

;; The rendered bond/mold slot: a pails/ty descriptor through the compiled
;; tyshow printer; 0 when absent (the mirror writes no zero slots).
(define (ty-text rs m)
  (define p ((r-pail rs) [(ts "sys") (ts "mold")] m))
  (If (Eq "/boot/pails/ty" (Hd p))
    ((r-tyshow rs) (_0 p))
    0))

(define (path-rows rs label m slot)
  (define pl ((r-pail rs) [(ts slot)] m))
  (If (Nil (Eq "/boot/pails/ps" (Hd pl)))
    []
    (let ((paths (_0 pl)))
      (Ifz (Sz paths)
        []
        (cons label
          (map (lambda (p)
                 (strcat ["  /" (join-str "/" (map (Ix 0) p))]))
            paths))))))

(define (render-done rs m)
  (define txt (r-txt rs))
  (define err (txt [(ts "err")] m))
  (define report (txt [(ts "report")] m))
  (define value (txt [(ts "value")] m))
  (cond
    (err ["error:" err])
    (report
      (Weld [report]
        (Weld (path-rows rs "changed:" m "changed")
          (Weld (path-rows rs "added:" m "added")
            (path-rows rs "removed:" m "removed")))))
    (value
      (let ((tyt (ty-text rs m))
            (law (txt [(ts "law")] m)))
        (Weld [(strcat ["value: " value])]
          (Weld (Ifz tyt [] [(strcat ["type:  " tyt])])
            (Ifz law [] ["" law])))))
    (else
      [(strcat ["done: " (showNat ((r-nat rs) [(ts "passed")] 0 m))
                " passed, " (showNat ((r-nat rs) [(ts "failed")] 0 m))
                " failed"])])))

;; An entry record's inspection rows: kind, type, lore head, refs, src.
(define (render-entry rs m)
  (define txt (r-txt rs))
  (define kind (txt [(ts "kind")] m))
  (define tyt (ty-text rs m))
  (define src (txt [(ts "sys") (ts "src")] m))
  (Weld (Ifz kind [] [(strcat ["[" kind "]"])])
    (Weld (Ifz tyt [] [(strcat ["type: " tyt])])
      (Weld (path-rows rs "calls:" m "calls")
        (Weld (path-rows rs "referenced by:" m "called_by")
          (Ifz src [] ["" src]))))))

;;; The driver loop ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (put s)
  (Write 1 (strWeld s 1)))

(define (emit rows)
  (put (join-str NL (Weld rows [""]))))

(define (emit-prompt st)
  (put (strcat [(st-focus st) "> "])))

;; Pump stdin lines to the main loop; ["eof"] on ctrl-d.
(define (stdin-pump self)
  (define mc (Recv 0))
  (define out (Ix 0 (Ix 1 mc)))
  (define (loop z)
    (define chunk (foil:read-stdin 384))
    (Ifz chunk
      (Send out ["eof"])
      (Seq (Send out ["line" (foil:read-until 10 chunk)])
        (loop z))))
  (loop 0))

;; Accept-and-close on the poke port; each connection means "something
;; was saved" (wire your editor's write hook to it).
(define (poke-pump port self)
  (define mc (Recv 0))
  (define out (Ix 0 (Ix 1 mc)))
  (define listen (Try Listen port))
  (If (Eq 1 (Hd listen))
    (Send out ["nopoke"])
    (let ((fd (_0 listen)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (CloseFd conn)
          (Seq (Send out ["poke"])
            (loop z))))
      (loop 0))))

(define (mk-repl-env core coord)
  (define (app path) (helm:core-ent core path))
  (define (ask m)
    (Seq (SendCaps coord (DeepSeq m m) [0])
      (Recv 0)))
  (define (inject t)
    (Ix 0 (ask ["task" t])))
  (define rs
    ["R" (app ["myth" "txt_at"]) (app ["myth" "nat_at"])
     (app ["myth" "pail_at"]) (app ["tyshow" "show"])])
  ["E" core coord app ask inject rs])

(define (e-core e) (Ix 1 e))
(define (e-app e) (Ix 3 e))
(define (e-ask e) (Ix 4 e))
(define (e-inject e) (Ix 5 e))
(define (e-rs e) (Ix 6 e))

;; Wait for a request node's ['res_done]; each try is a coordinator
;; barrier, and the budget covers a cold leaf-actor compile.
(define (poll-done e pax tries)
  (If (Eq 0 tries)
    0
    (let ((r (Ix 0 ((e-ask e) ["query" pax]))))
      (If (And (Eq "/boot/res/known" (Hd r))
            (Eq 1 ((Ix 2 (e-rs e)) [(ts "res_done")] 0 (_0 r))))
        (_0 r)
        (poll-done e pax (Sub tries 1))))))

;; Make a request record under a driver, wait, hand back the myth.
(define (drive e driver serial record)
  (define kid (ts (strcat ["repl" (showNat serial)])))
  (define pax [(ts "io") driver kid])
  (Seq ((e-inject e) (((e-app e) ["vine_make"]) pax record))
    (poll-done e pax 8192)))

;; One action against the namespace -> rows.
(define (run-action e serial action)
  (define app (e-app e))
  (define rs (e-rs e))
  (define kind (Ix 0 action))
  (cond
    ((Eq kind "rows") (Ix 1 action))
    ((Eq kind "eval")
      (let ((m (drive e (ts "chore") serial
                 ((app ["build" "eval_req"]) (Ix 1 action) (Ix 2 action)))))
        (Ifz m ["(timed out)"] (render-done rs m))))
    ((Eq kind "resync")
      (let ((m (drive e (ts "chore") serial
                 ((app ["build" "compile_req"]) (Ix 1 action)))))
        (Ifz m ["(timed out)"] (render-done rs m))))
    ((Eq kind "doctest")
      (let* ((tgt (Weld [(ts "boot")]
                    (map ts (helm:mod-segs (Ix 1 action)))))
             (m (drive e (ts "doctest") serial ((app ["dt" "req"]) tgt))))
        (Ifz m ["(timed out)"] (render-done rs m))))
    ((Eq kind "show")
      (let* ((mod (Ix 1 action))
             (parts (filter Bytes (helm-http:split-ch 46 (Ix 2 action))))
             (node
               (Weld (Weld [(ts "boot")] (map ts (helm:mod-segs mod)))
                 (If (Sz parts)
                   (Weld [("u" (Sz parts))] (map ts parts))
                   [])))
             (r (Ix 0 ((e-ask e) ["query" node]))))
        (If (Eq "/boot/res/known" (Hd r))
          (render-entry rs (_0 r))
          [(strcat ["no entry at /" (join-str "/" (map (Ix 0) node))])])))
    ((Eq kind "nsroot")
      (let ((r (Ix 0 ((e-ask e) ["query" [(ts "boot") (ts "ns") (ts (Ix 1 action))]]))))
        (If (Eq "/boot/res/known" (Hd r))
          (path-rows rs (strcat ["/" (Ix 1 action) ":"]) (_0 r) "entries")
          [(strcat ["no namespace root " (Ix 1 action)])])))
    (else [])))

;;; The wire port: the poke port grown into a data port ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; One JSON request per connection, one JSON reply, close — the
;;; editor protocol (doc/buddy-wire.md).  Requests ride the main loop's
;;; mailbox, so wire traffic and terminal commands serialize against
;;; the same image and share the serial counter.

;; json.foil imports nothing, so it compiles standalone against the
;; default subject (the foil-json-tests precedent) — its parse is the
;; wire's request decoder; responses are built as text (wire-json).
(define json-mod (foil:compile-mod-cached 0 foil:default-subject "json"))
(define jparse (foil:source-entry-val ["parse"] (Ix 1 json-mod)))

(define (wire-ok pairs)
  (wire-json:jobj (cons ["ok" "true"] pairs)))

(define (wire-fail msg pairs)
  (wire-json:jobj
    (Weld [["ok" "false"] ["error" (wire-json:jq msg)]] pairs)))

;; A chore answer's failure payload: the pretty text plus the located
;; rows the leaf wrote at ['diag] (raw JSON, embedded verbatim).
(define (wire-chore-fail rs m)
  (define err ((r-txt rs) [(ts "err")] m))
  (define dg ((r-txt rs) [(ts "diag")] m))
  (wire-fail err [["diags" (Ifz dg "[]" dg)]]))

(define (wire-timeout z)
  (wire-fail "timed out" []))

;; Mirror node paths as JSON string rows.
(define (wire-paths ps)
  (wire-json:jarr (map (lambda (p) (wire-json:jq (quip:print-path p))) ps)))

(define (wire-path-slot rs m slot)
  (define pl ((r-pail rs) [(ts slot)] m))
  (If (Eq "/boot/pails/ps" (Hd pl))
    (wire-paths (_0 pl))
    "[]"))

;; The entry node for mod + dotted name ("" names the module node).
(define (wire-node mod dotted)
  (define parts (filter Bytes (helm-http:split-ch 46 dotted)))
  (Weld (Weld [(ts "boot")] (map ts (helm:mod-segs mod)))
    (If (Sz parts)
      (Weld [("u" (Sz parts))] (map ts parts))
      [])))

(define (wire-eval e serial mod expr)
  (define rs (e-rs e))
  (define m (drive e (ts "chore") serial
              (((e-app e) ["build" "eval_req"]) mod expr)))
  (Ifz m
    (wire-timeout 0)
    (let ((err ((r-txt rs) [(ts "err")] m))
          (value ((r-txt rs) [(ts "value")] m)))
      (cond
        (err (wire-chore-fail rs m))
        (value
          (let ((tyt (ty-text rs m))
                (law ((r-txt rs) [(ts "law")] m)))
            (wire-ok
              [["value" (wire-json:jq value)]
               ["type" (Ifz tyt "null" (wire-json:jq tyt))]
               ["law" (Ifz law "null" (wire-json:jq law))]])))
        (else (wire-fail "no result" []))))))

(define (wire-compile e serial mod)
  (define rs (e-rs e))
  (define m (drive e (ts "chore") serial
              (((e-app e) ["build" "compile_req"]) mod)))
  (Ifz m
    (wire-timeout 0)
    (let ((err ((r-txt rs) [(ts "err")] m))
          (report ((r-txt rs) [(ts "report")] m)))
      (cond
        (err (wire-chore-fail rs m))
        (report
          (wire-ok
            [["report" (wire-json:jq report)]
             ["changed" (wire-path-slot rs m "changed")]
             ["added" (wire-path-slot rs m "added")]
             ["removed" (wire-path-slot rs m "removed")]]))
        (else (wire-fail "no result" []))))))

(define (wire-doctest e serial mod)
  (define rs (e-rs e))
  (define tgt (Weld [(ts "boot")] (map ts (helm:mod-segs mod))))
  (define m (drive e (ts "doctest") serial (((e-app e) ["dt" "req"]) tgt)))
  (Ifz m
    (wire-timeout 0)
    (let ((err ((r-txt rs) [(ts "err")] m)))
      (If err
        (wire-chore-fail rs m)
        (wire-ok
          [["passed" (showNat ((r-nat rs) [(ts "passed")] 0 m))]
           ["failed" (showNat ((r-nat rs) [(ts "failed")] 0 m))]])))))

(define (wire-describe e mod dotted)
  (define rs (e-rs e))
  (define node (wire-node mod dotted))
  (define r (Ix 0 ((e-ask e) ["query" node])))
  (If (Nil (Eq "/boot/res/known" (Hd r)))
    (wire-fail (strcat ["no entry at " (quip:print-path node)]) [])
    (let* ((m (_0 r))
           (txt (r-txt rs))
           (kind (txt [(ts "kind")] m))
           (tyt (ty-text rs m))
           (lede (txt [(ts "sys") (ts "lede")] m))
           (src (txt [(ts "sys") (ts "src")] m))
           (defline ((r-nat rs) [(ts "defline")] 0 m)))
      (wire-ok
        [["kind" (Ifz kind "null" (wire-json:jq kind))]
         ["type" (Ifz tyt "null" (wire-json:jq tyt))]
         ["lede" (Ifz lede "null" (wire-json:jq lede))]
         ["line" (Ifz defline "null" (showNat defline))]
         ["src" (Ifz src "null" (wire-json:jq src))]
         ["calls" (wire-path-slot rs m "calls")]
         ["called_by" (wire-path-slot rs m "called_by")]]))))

;; A module's own entry names: the module node's ['entries] rows with
;; the module prefix and the segment-count marker stripped, "/"-joined
;; (the spelling foil source uses).
(define (wire-complete e mod prefix)
  (define rs (e-rs e))
  (define mnode (Weld [(ts "boot")] (map ts (helm:mod-segs mod))))
  (define r (Ix 0 ((e-ask e) ["query" mnode])))
  (If (Nil (Eq "/boot/res/known" (Hd r)))
    (wire-fail (strcat ["no module " mod]) [])
    (let ((pl ((r-pail rs) [(ts "entries")] (_0 r))))
      (If (Nil (Eq "/boot/pails/ps" (Hd pl)))
        (wire-ok [["names" "[]"]])
        (let* ((names
                 (map
                   (lambda (p)
                     (join-str "/"
                       (map (Ix 0) (drop (Inc (Sz mnode)) p))))
                   (_0 pl)))
               (hits
                 (If (Bytes prefix)
                   (filter (starts-with prefix) names)
                   names)))
          (wire-ok [["names" (wire-json:jarr-str hits)]]))))))

(define (wire-nsls e root)
  (define rs (e-rs e))
  (define r (Ix 0 ((e-ask e) ["query" [(ts "boot") (ts "ns") (ts root)]])))
  (If (Nil (Eq "/boot/res/known" (Hd r)))
    (wire-fail (strcat ["no namespace root " root]) [])
    (wire-ok [["entries" (wire-path-slot rs (_0 r) "entries")]])))

;; One request line -> one response line (no trailing newline; the
;; connection actor adds it).
(define (wire-handle e serial line)
  (define pr (jparse line))
  (If (Nil (wire-json:jok? pr))
    (wire-fail "bad json" [])
    (let* ((v (wire-json:jval pr))
           (op (wire-json:jget-str "op" v))
           (mod (wire-json:jget-str "module" v)))
      (cond
        ((Eq op "ping")
          (wire-ok [["server" (wire-json:jq "buddy-wire")] ["v" "1"]]))
        ((Eq op "eval")
          (let ((text (wire-json:jget-str "text" v)))
            (If (Or (Nil mod) (Nil text))
              (wire-fail "eval needs module and text" [])
              (wire-eval e serial mod text))))
        ((Eq op "compile")
          (If (Nil mod)
            (wire-fail "compile needs module" [])
            (wire-compile e serial mod)))
        ((Eq op "doctest")
          (If (Nil mod)
            (wire-fail "doctest needs module" [])
            (wire-doctest e serial mod)))
        ((Eq op "describe")
          (If (Nil mod)
            (wire-fail "describe needs module" [])
            (wire-describe e mod (wire-json:jget-str "name" v))))
        ((Eq op "complete")
          (If (Nil mod)
            (wire-fail "complete needs module" [])
            (wire-complete e mod (wire-json:jget-str "prefix" v))))
        ((Eq op "nsls")
          (let ((root (wire-json:jget-str "root" v)))
            (If (Nil root)
              (wire-fail "nsls needs root" [])
              (wire-nsls e root))))
        (else (wire-fail (strcat ["unknown op " op]) []))))))

;;; Wire sockets ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Read fd until the accumulated request holds a LF (or EOF); Read
;; returns a bar (data then a 0x01 top byte) — strip the terminator.
(define (wire-read fd)
  (define (has-lf? s)
    (define n (Bytes s))
    (define (go i)
      (And (Lt i n) (Or (Eq 10 (Load8 i s)) (go (Inc i)))))
    (go 0))
  (define (go acc)
    (define raw (Read fd 65536))
    (If (Le raw 1)
      acc
      (let* ((chunk (foil-lore:str-slice 0 (Dec (Bytes raw)) raw))
             (acc2 (strWeld acc chunk)))
        (If (has-lf? acc2) acc2 (go acc2)))))
  (go ""))

(define (first-line s)
  (define n (Bytes s))
  (define (go i)
    (If (Ge i n) n (If (Eq 10 (Load8 i s)) i (go (Inc i)))))
  (foil-lore:str-slice 0 (go 0) s))

;; One actor per connection: handshake for the main-loop cap, read the
;; request, ask the loop, write the reply, close (the helm-http
;; conn-actor pattern).
(define (wire-conn fd self)
  (define mc (Recv 0))
  (define out (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define line (first-line (wire-read fd)))
  (define m ["wire" line])
  (Seq (DeepSeq m m)
    (Seq (SendCaps out m [0])
      (let ((r (Ix 0 (Recv 0))))
        (Seq (Write fd (strWeld (strcat [(Ix 1 r) NL]) 1))
          (CloseFd fd))))))

(define (wire-pump port self)
  (define mc (Recv 0))
  (define out (Ix 0 (Ix 1 mc)))
  (define listen (Try Listen port))
  (If (Eq 1 (Hd listen))
    (Trace ["wire: listen failed" port] 0)
    (let ((fd (_0 listen)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (let ((c (Spawn (wire-conn conn))))
               (SendCaps c ["go"] [out]))
          (loop z)))
      (Seq out (loop 0)))))

(define (repl-loop e st)
  (define mc (Recv 0))
  (define msg (Ix 0 mc))
  (define kind (_0 msg))
  (define (step line)
    (define r (repl-step st line))
    (define st1 (Ix 0 r))
    (define action (Ix 1 r))
    (If (Equal ["quit"] action)
      (emit ["bye"])
      (let ((rows (run-action e (st-serial st1) action)))
        (Seq (emit rows)
          (let ((st2 [(st-focus st1) (st-vars st1) (Inc (st-serial st1))]))
            (Seq (emit-prompt st2)
              (repl-loop e st2)))))))
  (cond
    ((Eq kind "line") (step (_1 msg)))
    ((Eq kind "poke") (step ""))
    ((Eq kind "wire")
      ;; a wire request: answer the connection actor, burn a serial,
      ;; leave the terminal state (focus, vars, prompt) alone
      (let ((r ["wres" (wire-handle e (st-serial st) (_1 msg))]))
        (Seq (helm:send! (Ix 0 (Ix 1 mc)) r)
          (repl-loop e [(st-focus st) (st-vars st) (Inc (st-serial st))]))))
    ((Eq kind "eof") (emit ["bye"]))
    ((Eq kind "nopoke")
      (Seq (emit ["(poke port busy — resync with <enter> only)"])
        (repl-loop e st)))
    (else (repl-loop e st))))

;; Boot the full lain stack (explorer live on http-port), then take
;; the terminal.  fetch?=0 skips the outbound-fetch driver — the local
;; runtime lacks the Fetch primop.  wire-port 0 skips the editor wire.
(define (run-repl http-port poke-port wire-port fetch?)
  (define r
    (helm-run:boot-lain-stack http-port fetch?
      (helm:load-helm-mod "helmapp")))
  (define e (mk-repl-env (Ix 0 r) (Ix 1 r)))
  (define st ["sept" [] 0])
  (Seq (emit ["the namespace repl — :h for help"
              (strcat ["explorer: http://localhost:" (showNat http-port) "/ns"])])
    (let* ((sin (Spawn stdin-pump))
           (pok (Spawn (poke-pump poke-port))))
      (Seq (SendCaps sin ["go"] [0])
        (Seq (SendCaps pok ["go"] [0])
          (Seq (Ifz wire-port
                 0
                 (let ((wir (Spawn (wire-pump wire-port))))
                   (SendCaps wir ["go"] [0])))
            (Seq (emit-prompt st)
              (repl-loop e st))))))))
