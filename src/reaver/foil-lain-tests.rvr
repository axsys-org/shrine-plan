(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; lain.foil: the reactive application layer, exercised through the
;;; sept -> shrine -> lain -> web -> lainapp import chain.  Nominal
;;; members brand their runtime reps: tasks ("/boot/task/vine" path
;;; writ) / ("/boot/task/hear" news); outcomes ("/boot/ovum/ripe" sov
;;; fx signs ack) / ("/boot/ovum/fail" ("ts" err)); kernel dooms
;;; ("/boot/doom/done" fate ack) / ("/boot/doom/fail" err); sov faces
;;; project _0=rec _1=idx _2=top; moves project _0=src _1=dst _2=writ;
;;; anon tap rows (0 p q); cared pairs (0 care path) with care
;;; "/boot/care/x|y|z".

(define app-sut (foil:compile-mod foil:default-subject "lainapp"))
(define (app path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) app-sut)))

;; kernel + helpers through the merged subject
(define is-xeno (app ["is_xeno"]))
(define mode-then (app ["mode_then"]))
(define lte-pith (app ["lte_pith"]))
(define run-event (app ["run_event"]))
(define kern (app ["kernel"]))
;; fixtures
(define sov0 (app ["seeded"]))
(define top0 (_2 sov0))
(define t00 (app ["myth" "new"]))
(define msing (app ["myth" "sing"]))
(define pd-f (app ["pd"]))
(define (t-data slot n) (msing slot (pd-f n)))
(define kooked (app ["kooked"]))
(define slot-nat (app ["slot_nat"]))
(define mk-news (app ["mk_news"]))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define vine-cull (app ["vine_cull"]))

(define tkook ("ts" "kook"))
;; kook refs are full form-node paths (rerootable; /kook by convention)
(define kcount [tkook ("ts" "count")])
(define kspawn [tkook ("ts" "spawn")])
(define kecho [tkook ("ts" "echo")])
(define kmark [tkook ("ts" "mark")])
(define kma [tkook ("ts" "ma")])
(define kmb [tkook ("ts" "mb")])
(define nslot [("ts" "n")])

;;; smoke ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Eq 1 (is-xeno [("ts" "xeno") ("ts" "log")]))
assert(Eq 0 (is-xeno [("ts" "chat")]))
assert(Eq 0 (is-xeno []))
assert(Equal "/boot/mode/add" (mode-then "/boot/maybe/none" "/boot/mode/add"))
assert(Equal "/boot/mode/del" (mode-then ("/boot/maybe/some" "/boot/mode/add") "/boot/mode/del"))
assert(Equal "/boot/mode/add" (mode-then ("/boot/maybe/some" "/boot/mode/del") "/boot/mode/add"))
assert(Equal "/boot/mode/add" (mode-then ("/boot/maybe/some" "/boot/mode/add") "/boot/mode/dif"))

;;; 1. vine-make basics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ta ("ts" "a"))
(define r1 (run-event (vine-make [ta] (kooked [kcount])) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r1))
(define s1 (_0 r1))
assert(Eq (Inc top0) (_2 s1))
assert(Eq 0 (Sz (_1 r1)))
;; the ripe carries the command's ack: its path tag
assert(Equal ("/boot/maybe/some" [ta]) (_3 r1))

;;; 2. ingest-down + same-event raid: spawn makes a kid, count sees it ;;;;;;;;;;;;

(define r2 (run-event (vine-make [ta] (kooked [kspawn kcount])) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r2))
(define s2 (_0 r2))
;; the kid exists in the same minted case
assert(Eq (Inc top0) (_2 s2))
;; ... and [a]'s count take already saw it: n = 1
assert(Eq 1 (slot-nat [ta] nslot 99 s2))

;;; 3. raid cascades two levels and stops at the root ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tb ("ts" "b"))
(define tc ("ts" "c"))
(define td ("ts" "d"))
(define r3a0 (run-event (vine-make [tb] (kooked [kcount])) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r3a0))
(define s3a0 (_0 r3a0))
(define r3a (run-event (vine-make [tb tc] (kooked [kcount])) 7 s3a0))
assert(Eq "/boot/ovum/ripe" (Hd r3a))
(define s3a (_0 r3a))
;; the make of [b c] fired [b]'s take in the same event
assert(Eq 1 (slot-nat [tb] nslot 99 s3a))
(define r3b (run-event (vine-make [tb tc td] t00) 7 s3a))
assert(Eq "/boot/ovum/ripe" (Hd r3b))
(define s3b (_0 r3b))
assert(Eq 1 (slot-nat [tb tc] nslot 99 s3b))
assert(Eq 1 (slot-nat [tb] nslot 99 s3b))

;;; 4. up routing: an outside-subtree card leaves as an effect ;;;;;;;;;;;;;;;;;;;;

(define te ("ts" "e"))
(define r4a (run-event (vine-make [te] (kooked [kecho])) 7 sov0))
(define s4a (_0 r4a))
(define r4b (run-event (vine-poke [te] (t-data [("ts" "msg")] 42)) 7 s4a))
assert(Eq "/boot/ovum/ripe" (Hd r4b))
(define s4b (_0 r4b))
(define fx4 (_1 r4b))
assert(Eq 1 (Sz fx4))
;; a move carries one command: src, dst, writ
(define mv (Ix 0 fx4))
assert(Equal [te] (_0 mv))
assert(Equal [("ts" "xeno") ("ts" "log")] (_1 mv))
assert(Eq "/boot/writ/poke" (Hd (_2 mv)))
;; the union semantics committed: msg landed, an earlier slot survives
assert(Eq 42 (slot-nat [te] [("ts" "msg")] 0 s4b))
(define r4c (run-event (vine-poke [te] (t-data [("ts" "other")] 5)) 7 s4b))
(define s4c (_0 r4c))
assert(Eq 5 (slot-nat [te] [("ts" "other")] 0 s4c))
assert(Eq 42 (slot-nat [te] [("ts" "msg")] 0 s4c))

;;; 5. poke-missing fails the whole event, sovereign untouched ;;;;;;;;;;;;;;;;;;;;

(define r5 (run-event (vine-poke [("ts" "zz")] t00) 7 s1))
assert(Equal ("/boot/ovum/fail" ("ts" "poke_missing")) r5)
;; s1 still drives events from its old top: nothing was written
(define r5b (run-event (vine-make [("ts" "zz")] t00) 7 s1))
assert(Eq "/boot/ovum/ripe" (Hd r5b))
assert(Eq (Add top0 2) (_2 (_0 r5b)))

;;; 6. cull tombstones and the parent's take sees the shrink ;;;;;;;;;;;;;;;;;;;;;;

(define tkid ("ts" "kid"))
(define r6 (run-event (vine-cull [ta tkid]) 7 s2))
assert(Eq "/boot/ovum/ripe" (Hd r6))
(define s6 (_0 r6))
;; the kid is tombstoned at the new top ...
assert(Eq 77 (slot-nat [ta tkid] nslot 77 s6))
;; ... and [a]'s count take re-fired within the same event: n = 0
assert(Eq 0 (slot-nat [ta] nslot 99 s6))

;;; 7. hear fan-in: (care, path) pairs, inversion, xeno skip, empty-subscriber ;;;;;

(define tm ("ts" "m"))
(define r7a (run-event (vine-make [tm] (kooked [kmark])) 7 sov0))
(define s7a (_0 r7a))
(define chg [("ts" "chg")])
;; each subscription is a /dep pair: ("/boot/dep" care subscriber-path)
(define (mk-dep c p) ("/boot/dep" c p))
(define news1
  (mk-news [[chg [(mk-dep "/boot/care/z" [tm]) (mk-dep "/boot/care/z" [("ts" "xeno") ("ts" "w")])]]]))
(define r7b (run-event ("/boot/task/hear" news1) 7 s7a))
assert(Eq "/boot/ovum/ripe" (Hd r7b))
(define s7b (_0 r7b))
assert(Eq 1 (slot-nat [tm] [("ts" "heard")] 99 s7b))
;; hear events ack $none through the ovum too
assert(Equal "/boot/maybe/none" (_3 r7b))
(define news2 (mk-news [[chg [(mk-dep "/boot/care/z" [("ts" "xeno") ("ts" "w")])]]]))
(define r7c (run-event ("/boot/task/hear" news2) 7 s7a))
assert(Equal ("/boot/ovum/fail" ("ts" "hear_no_subs")) r7c)

;;; 8. multi-kook composition order ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define to1 ("ts" "o1"))
(define to2 ("ts" "o2"))
(define ord [("ts" "ord")])
(define r8a (run-event (vine-make [to1] (kooked [kma kmb])) 7 sov0))
(define r8b (run-event (vine-poke [to1] t00) 7 (_0 r8a)))
assert(Eq 12 (slot-nat [to1] ord 0 (_0 r8b)))
(define r8c (run-event (vine-make [to2] (kooked [kmb kma])) 7 sov0))
(define r8d (run-event (vine-poke [to2] t00) 7 (_0 r8c)))
assert(Eq 21 (slot-nat [to2] ord 0 (_0 r8d)))

;;; 9. default talk is union, add wins ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define tu ("ts" "u"))
(define keep [("ts" "keep")])
(define r9a (run-event (vine-make [tu] (t-data keep 5)) 7 sov0))
(define r9b (run-event (vine-poke [tu] (t-data keep 6)) 7 (_0 r9a)))
(define s9 (_0 r9b))
assert(Eq 6 (slot-nat [tu] keep 0 s9))
(define r9c (run-event (vine-poke [tu] (t-data [("ts" "new")] 7)) 7 s9))
(define s9c (_0 r9c))
assert(Eq 7 (slot-nat [tu] [("ts" "new")] 0 s9c))
assert(Eq 6 (slot-nat [tu] keep 0 s9c))

;;; 10. unknown kook fails the event ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r10 (run-event (vine-make [("ts" "z")] (kooked [[tkook ("ts" "zzz")]])) 7 sov0))
assert(Equal ("/boot/ovum/fail" ("ts" "kook_unknown")) r10)

;;; 10b. a non-kook pail in the behavior slot fails as kook_bad ;;;;;;;;;;;;;;;;;;;;

(define kooked-bad (app ["kooked_bad"]))
(define r10b (run-event (vine-make [("ts" "z")] (kooked-bad 3)) 7 sov0))
assert(Equal ("/boot/ovum/fail" ("ts" "kook_bad")) r10b)

;;; 10c. rerooting: a form node at an arbitrary path dispatches by that path ;;;;;;;

(define formed-f (app ["formed"]))
(define count-form (app ["demo" "count_form"]))
(define lore1-f (app ["lore1"]))
(define tz1 ("ts" "zoo"))
(define tz2 ("ts" "reg"))
(define r10c0
  (run-event
    (vine-make [tz1 tz2] (formed-f count-form (lore1-f "a rerooted counter")))
    7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r10c0))
(define r10c (run-event (vine-make [("ts" "zz")] (kooked [[tz1 tz2]])) 7 (_0 r10c0)))
assert(Eq "/boot/ovum/ripe" (Hd r10c))

;;; 10d. the pact mount form: one make expands the whole app subtree ;;;;;;;;;;;;;;;

;; the manifest fixture is foil-built (demo_mani): nominal-row ctors
;; applied from rvr produce non-canonical reps that no pail match sees
(define app-card-t (app ["app_card_t"]))
(define tapp ("ts" "app"))
(define tdemo ("ts" "demo"))
(define m10d (app ["demo" "mani"]))
(define r10d
  (run-event (vine-make [tapp tdemo] (app-card-t m10d "apps/demo/main")) 7 sov0))
assert(Eq "/boot/ovum/ripe" (Hd r10d))
(define s10d (_0 r10d))
;; the mounted behavior resolves by its in-app path — the registry is
;; the app's own subtree, not /kook
(define r10d2
  (run-event
    (vine-make [("ts" "zz2")]
      (kooked [[tapp tdemo ("ts" "kook") ("ts" "count")]]))
    7 s10d))
assert(Eq "/boot/ovum/ripe" (Hd r10d2))
;; the same manifest mounts at a second root: the root is a free
;; parameter, isolation is structural
(define r10d3
  (run-event (vine-make [("ts" "zoo2")] (app-card-t m10d "apps/demo/main")) 7 s10d))
assert(Eq "/boot/ovum/ripe" (Hd r10d3))
(define r10d4
  (run-event
    (vine-make [("ts" "zz3")]
      (kooked [[("ts" "zoo2") ("ts" "kook") ("ts" "count")]]))
    7 (_0 r10d3)))
assert(Eq "/boot/ovum/ripe" (Hd r10d4))

;;; 11. fate write order is lte_pith; the doom acks the command's path ;;;;;;;;;;;;;

(define d11 (kern (vine-make [tb tc] t00) 7 s3a0))
assert(Eq "/boot/doom/done" (Hd d11))
;; the ack is the vine command's path tag
assert(Equal ("/boot/maybe/some" [tb tc]) (_1 d11))
(define w11 (_0 (_0 d11)))
;; the make of [b c] also poked [b] (count take): two writes, sorted
assert(Eq 2 (Sz w11))
assert(Eq 1 (lte-pith (_0 (Ix 0 w11)) (_0 (Ix 1 w11))))
(define (sorted-writes i)
  (If (Ge (Inc i) (Sz w11))
    1
    (And (lte-pith (_0 (Ix i w11)) (_0 (Ix (Inc i) w11)))
      (sorted-writes (Inc i)))))
assert(Eq 1 (sorted-writes 0))

;;; 11b. hear events ack $none ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define d11b (kern ("/boot/task/hear" news1) 7 s7a))
assert(Eq "/boot/doom/done" (Hd d11b))
assert(Equal "/boot/maybe/none" (_1 d11b))

;;; 11c. crew: named deps hydrate into the bowl, keyed by slot ;;;;;;;;;;;;;;;;;;;;;

(define t-crew (app ["t_crew"]))
(define twd ("ts" "watched"))
(define twk ("ts" "wk"))
(define twr ("ts" "w"))
(define seen [("ts" "seen")])
;; a watched subtree with one record, and a watcher whose /sys/crew
;; maps the slot ['eyes] to a z-care read of it
(define eslot [("ts" "eyes")])
(define rd1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
(define rd2 (run-event (vine-make [twr] (t-crew eslot [twd] [[tkook ("ts" "crew")]])) 7 (_0 rd1)))
(define rd3 (run-event (vine-poke [twr] t00) 7 (_0 rd2)))
assert(Eq "/boot/ovum/ripe" (Hd rd3))
;; one entry hydrated: /watched itself
assert(Eq 1 (slot-nat [twr] seen 99 (_0 rd3)))
;; grow the watched subtree; the next activation sees both entries
(define rd4 (run-event (vine-make [twd twk] (t-data nslot 6)) 7 (_0 rd3)))
(define rd5 (run-event (vine-poke [twr] t00) 7 (_0 rd4)))
assert(Eq 2 (slot-nat [twr] seen 99 (_0 rd5)))
;; the slot is indexical: another node reads the same target under a
;; different local name and hydrates identically
(define twr2 ("ts" "w2s"))
(define rd6 (run-event (vine-make [twr2] (t-crew [("ts" "other")] [twd] [[tkook ("ts" "crew")]])) 7 (_0 rd5)))
(define rd7 (run-event (vine-poke [twr2] t00) 7 (_0 rd6)))
assert(Eq 2 (slot-nat [twr2] seen 99 (_0 rd7)))

;;; 11d. the cycle: eyes derive from crews, hears cascade ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define cycle (app ["cycle"]))
;; a subscriber whose crew watches /watched and whose kook is mark
;; (its hear writes the rely count into ['heard]) — no mk_news, no
;; explicit hear event: the cycle derives and delivers
(define tsub ("ts" "sub"))
(define heard [("ts" "heard")])
(define rc1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
(define rc2 (run-event (vine-make [tsub] (t-crew eslot [twd] [[tkook ("ts" "mark")]])) 7 (_0 rc1)))
(define g1 (cycle (vine-poke [twd] (t-data nslot 6)) 7 8 (_0 rc2)))
assert(Eq "/boot/gyre/spun" (Hd g1))
(define sg1 (_0 g1))
assert(Eq 1 (slot-nat [tsub] heard 99 sg1))
;; the ack rides through the cycle
assert(Equal ("/boot/maybe/some" [twd]) (_3 g1))
;; two rounds: the poke, then the hear (which changed nothing watched)
assert(Eq 2 (Sz (_2 g1)))

;; second order: another node watches the subscriber; the hear's own
;; write cascades to it in round three
(define tsub2 ("ts" "sub2"))
(define rc3 (run-event (vine-make [tsub2] (t-crew [("ts" "up")] [tsub] [[tkook ("ts" "mark")]])) 7 sg1))
(define g2 (cycle (vine-poke [twd] (t-data nslot 7)) 7 8 (_0 rc3)))
assert(Eq "/boot/gyre/spun" (Hd g2))
(define sg2 (_0 g2))
;; /sub's second hear resolves to the same myth (heard=1), so the
;; deduplicated write emits no sign and cannot cascade to /sub2.
assert(Eq 99 (slot-nat [tsub2] heard 99 sg2))
assert(Eq 2 (Sz (_2 g2)))

;; a self-watcher loops; the fuel cap bounds it
(define tloop ("ts" "loop"))
(define rc4 (run-event (vine-make [tloop] (t-crew [("ts" "me")] [tloop] [[tkook ("ts" "mark")]])) 7 sov0))
(define g3 (cycle (vine-poke [tloop] (t-data nslot 1)) 7 3 (_0 rc4)))
assert(Eq "/boot/gyre/spun" (Hd g3))
;; The first hear writes heard=1; the next identical hear is a no-op,
;; so deduplication terminates the self-watch before the fuel cap.
assert(Eq 3 (Sz (_2 g3)))

;;; 12. reactivity machine: signs match the eyes, fired watchers leave ;;;;;;;;;;;;;

(define react (app ["react"]))
(define agut (app ["axal" "gut"]))
(define tw ("ts" "w2"))
(define tq ("ts" "quiet"))
;; making [w2] grades [w2] (2 2 2) AND the root: / holds the
;; namespace-root record (root_tasks), so it owns a ledger and its
;; kid-set change emits a sign like any other node
(define rx (run-event (vine-make [tw] (kooked [kcount])) 7 s7a))
assert(Eq "/boot/ovum/ripe" (Hd rx))
(define sx (_0 rx))
(define sgx (_2 rx))
;; the index: [w2] watched at x and (by a xeno) at y; the root watched
;; at x AND z by [m]; an untouched path watched at z
(define dx-m (mk-dep "/boot/care/x" [tm]))
(define dy-xeno (mk-dep "/boot/care/y" [("ts" "xeno") ("ts" "w")]))
(define dx-root (mk-dep "/boot/care/x" [tm]))
(define dz-root (mk-dep "/boot/care/z" [tm]))
(define dz-quiet (mk-dep "/boot/care/z" [tm]))
(define eyes1
  (mk-news
    [[[tw] [dx-m dy-xeno]]
     [[] [dx-root dz-root]]
     [[tq] [dz-quiet]]]))
(define rr (react sgx eyes1))
(define nws (_0 rr))
(define rest (_1 rr))
;; [w2] moved on every care: both watchers fire (xeno filtering is
;; invert's job, not react's)
assert(Equal [dx-m dy-xeno] (agut [tw] 0 nws))
assert(Eq 0 (agut [tw] 0 rest))
;; the asserted root signs the kid make at z (subtree) but its own
;; record is untouched: the z watcher fires, the x watcher survives
assert(Equal [dz-root] (agut [] 0 nws))
assert(Equal [dx-root] (agut [] 0 rest))
;; the untouched path keeps its watcher and emits no news
assert(Eq 0 (agut [tq] 0 nws))
assert(Equal [dz-quiet] (agut [tq] 0 rest))
;; the news feeds straight back as a hear event: [m] hears its two
;; fired deps — [w2]'s x and the root's z (the xeno subscriber is
;; dropped by invert)
(define rh (run-event ("/boot/task/hear" nws) 7 sx))
assert(Eq "/boot/ovum/ripe" (Hd rh))
assert(Eq 2 (slot-nat [tm] [("ts" "heard")] 99 (_0 rh)))

;;; 13. /h: the temporal-transposition overlays ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; /h/care/case/len/...path resolves (care, case) against the first
;;; len segments and dips the rest.  Read-only, committed-only, and
;;; constant: answers at minted cases never change.

(define peek-f (app ["peek"]))
(define tslot (app ["myth" "nat_at"]))
(define txt-slot (app ["myth" "txt_at"]))
;; kid enumeration rides the axal boundary helper (the kid map is a
;; bee of pinned links now, not a raw uon)
(define kidkeys (app ["axal" "kid_keys"]))
(define xqh (app ["x_query_h"]))
(define xch (app ["x_case_h"]))
(define cyclef (app ["cycle"]))

(define th ("ts" "h"))
(define htx ("ts" "x"))
(define hty ("ts" "y"))
(define htz ("ts" "z"))
(define ttt ("ts" "tt"))
(define tkd ("ts" "kid"))
(define (u n) ("u" n))

;; the record itself of an /h read
(define (arec fat) (_0 (Ix 0 fat)))

;; Standard seeded states explicitly assert /io with its driver helpdoc;
;; the reserved roots carry their convention lore (shrine-apps.md 7).
(define tio ("ts" "io"))
(define has-slot-f (app ["myth" "has_at"]))
(define iodoc (arec (peek-f [tio] sov0)))
assert(Equal
  "I/O driver registry. Each live child names a Helm-managed driver; make, poke, and cull child records to start, reconfigure, or stop it."
  (txt-slot [("ts" "doc")] iodoc))
assert(Eq 1 (has-slot-f [("ts" "lore")] iodoc))
assert(Eq 1 (has-slot-f [("ts" "lore")] (arec (peek-f [tkook] sov0))))
assert(Eq 1 (has-slot-f [("ts" "lore")] (arec (peek-f [("ts" "app")] sov0))))
assert(Eq 1 (has-slot-f [("ts" "lore")] (arec (peek-f [("ts" "out")] sov0))))

;; Three internal epochs, but path-local cases: /tt has x=2 and
;; y=z=3; /tt/kid independently has x=y=z=1.
(define ht1 (run-event (vine-make [ttt] (t-data nslot 1)) 7 sov0))
(define ht2 (run-event (vine-make [ttt tkd] (t-data nslot 2)) 7 (_0 ht1)))
(define ht3 (run-event (vine-poke [ttt] (t-data nslot 3)) 7 (_0 ht2)))
(define sh (_0 ht3))

;; x: the record at each case — history is eternal after later writes
assert(Eq 1 (tslot nslot 99 (arec (peek-f [th htx (u 1) (u 1) ttt] sh))))
assert(Eq 3 (tslot nslot 99 (arec (peek-f [th htx (u 2) (u 1) ttt] sh))))
;; y at the kid's mint case: the parent still shows its old record and
;; the rel dip walks into the kid
assert(Eq 1 (tslot nslot 99 (arec (peek-f [th hty (u 2) (u 1) ttt] sh))))
assert(Eq 2 (tslot nslot 99 (arec (peek-f [th hty (u 2) (u 1) ttt tkd] sh))))
;; z rel dip agrees
assert(Eq 2 (tslot nslot 99 (arec (peek-f [th htz (u 2) (u 1) ttt tkd] sh))))
;; before the kid existed there is nothing to dip into
assert(Equal "/boot/maybe/none" (Ix 0 (peek-f [th htz (u 1) (u 1) ttt tkd] sh)))
;; zero and cases beyond this target/care's local counter shrug
assert(Equal "/boot/maybe/none" (Ix 0 (peek-f [th htx (u 0) (u 1) ttt] sh)))
assert(Equal "/boot/maybe/none" (Ix 0 (peek-f [th htx (u 3) (u 1) ttt] sh)))
;; decimal text segments parse the same as u-aura ones
assert(Eq 1 (tslot nslot 99 (arec (peek-f [th htx ("ts" "1") ("ts" "1") ttt] sh))))
;; the structural levels: /h lists the cares (and the version view),
;; while /h/x cannot enumerate cases before a target is known
assert(Equal [("ts" "v") htx hty htz] (kidkeys (peek-f [th] sh)))
assert(Equal [] (kidkeys (peek-f [th htx] sh)))
;; Incomplete target prefixes are explanatory markers without case
;; children; once the complete target is present, its snapshot can
;; enumerate relative descendants normally.
assert(Equal [] (kidkeys (peek-f [th htz (u 2) (u 2) ttt] sh)))
assert(Equal [tkd] (kidkeys (peek-f [th htz (u 2) (u 1) ttt] sh)))
assert(Equal [] (kidkeys (peek-f [th htz (u 1) (u 1) ttt] sh)))

;; the overlay is read-only: any write under /h fails the event
(define hbad (run-event (vine-make [th ("ts" "zap")] t00) 7 sh))
assert(Equal ("/boot/ovum/fail" ("ts" "h_reserved")) hbad)

;; x_query_h serves /h (the case rides in the path) and delegates the
;; rest; x_case_h answers the constant case 1 on /h
(define hpx [th htx (u 1) (u 1) ttt])
assert(Eq "/boot/res/known" (Hd (xqh 0 hpx sh)))
assert(Eq 1 (tslot nslot 99 (_0 (xqh 0 hpx sh))))
assert(Equal ("/boot/maybe/some" 1) (xch 0 hpx sh))
assert(Eq "/boot/res/known" (Hd (xqh (_2 sh) [ttt] sh)))
assert(Equal "/boot/res/unknown" (xqh 0 [th htx (u 999999) (u 1) ttt] sh))

;; throwaway subscription: a crew dep into /h never fires — signs
;; cannot land under /h, so the cycle stays one round and the
;; subscriber never hears
(define thsub ("ts" "hsub"))
(define hr1 (run-event (vine-make [thsub] (t-crew eslot hpx [kmark])) 7 sh))
(define hg (cyclef (vine-poke [ttt] (t-data nslot 4)) 7 8 (_0 hr1)))
assert(Eq "/boot/gyre/spun" (Hd hg))
assert(Eq 99 (slot-nat [thsub] [("ts" "heard")] 99 (_0 hg)))
assert(Eq 1 (Sz (_2 hg)))

;; /h/v: the target-first version view — independent lock counters as
;; decimal text, mint time and block, and no ambiguous global kids
(define tv ("ts" "v"))
(define hv (peek-f [th tv (u 1) ttt] sh))
(define hvm (arec hv))
assert(Equal "live" (txt-slot [("ts" "state")] hvm))
assert(Equal "2" (txt-slot [("ts" "x_data")] hvm))
assert(Equal "1" (txt-slot [("ts" "x_shape")] hvm))
assert(Equal "3" (txt-slot [("ts" "y_data")] hvm))
assert(Equal "2" (txt-slot [("ts" "y_shape")] hvm))
assert(Equal "3" (txt-slot [("ts" "z_data")] hvm))
assert(Equal "2" (txt-slot [("ts" "z_shape")] hvm))
assert(Equal [] (kidkeys hv))
;; A culled node keeps its locks, and a later live write below that
;; tombstone is rejected without advancing the sovereign.
(define htc (run-event (vine-cull [ttt tkd]) 7 sh))
(define hv2m (arec (peek-f [th tv (u 2) ttt tkd] (_0 htc))))
assert(Equal "tombstone" (txt-slot [("ts" "state")] hv2m))
assert(Equal "2" (txt-slot [("ts" "x_data")] hv2m))
assert(Equal "2" (txt-slot [("ts" "x_shape")] hv2m))
(define htd (run-event (vine-make [ttt tkd ("ts" "deep")] (t-data nslot 8)) 7 (_0 htc)))
assert(Equal ("/boot/ovum/fail" ("ts" "tombstoned_ancestor")) htd)

;; y is a frontier care: the /h/y overlay shows a deep record through
;; a transparent intermediate at its full relative pith
(define thh ("ts" "hh"))
(define tdp ("ts" "deep"))
(define hf1 (run-event (vine-make [ttt thh tdp] (t-data nslot 9)) 7 sh))
assert(Eq 9 (tslot nslot 99 (arec (peek-f [th hty (u 4) (u 1) ttt thh tdp] (_0 hf1)))))
;; The intermediate path remains transparent: no /h/v record exists.
assert(Equal "/boot/maybe/none" (Ix 0 (peek-f [th tv (u 2) ttt thh] (_0 hf1))))

;;; 15. the /log journal: every cycle epoch leaves its node ;;;;;;;;;;;;;;;;;;;;;;;;

(define dig-show (app ["dig_show"]))
(define pail-at (app ["myth" "pail_at"]))
(define tlog ("ts" "log"))
(define evslot [("ts" "ev")])

;; g1 (section 11d) drove a poke through the cycle: two rounds, two
;; epochs, two journal nodes.  The driving event's entry carries the
;; task verbatim, the ack it earned, and its (empty) effects.
(define top-g1 (_2 sg1))
(define lrec1 (arec (peek-f [tlog (dig-show (Sub top-g1 1))] sg1)))
assert(Eq 1 (has-slot-f evslot lrec1))
(define card1 (pail-at evslot lrec1))
assert(Eq "/boot/log_card" (Hd card1))
assert(Equal (vine-poke [twd] (t-data nslot 6)) (_0 card1))
assert(Equal ("/boot/maybe/some" [twd]) (_1 card1))
assert(Equal [] (_2 card1))
;; the cascade's hear round journals too, at the top epoch, acked none
(define card2 (pail-at evslot (arec (peek-f [tlog (dig-show top-g1)] sg1))))
assert(Eq "/boot/log_card" (Hd card2))
assert(Eq "/boot/task/hear" (Hd (_0 card2)))
assert(Equal "/boot/maybe/none" (_1 card2))

;; run_event (seeding, probes) stays journal-free: no /log node mints
(define nj (run-event (vine-make [("ts" "njt")] (t-data nslot 1)) 7 sov0))
assert(Equal "/boot/maybe/none" (Ix 0 (peek-f [tlog (dig-show (_2 (_0 nj)))] (_0 nj))))

;; the journal is commit-owned: kernel writes to /log fail the event
(define lgw (run-event (vine-make [tlog ("ts" "zz")] (t-data nslot 1)) 7 sov0))
assert(Equal ("/boot/ovum/fail" ("ts" "log_reserved")) lgw)

;; a node crewing /log derives no eyes: the journal's own signs can
;; never feed back into the cascade
(define tlw ("ts" "lw"))
(define rl1 (run-event (vine-make [tlw] (t-crew eslot [tlog] [[tkook ("ts" "mark")]])) 7 sov0))
(define gl (cycle (vine-make [twd] (t-data nslot 5)) 7 8 (_0 rl1)))
assert(Eq "/boot/gyre/spun" (Hd gl))
assert(Eq 1 (Sz (_2 gl)))
assert(Eq 99 (slot-nat [tlw] heard 99 (_0 gl)))
