(#bind brand (#module shrine-brand))
;;;; Copyright (c) 2026 Axiomatic Systems
;;;; SPDX-License-Identifier: MIT
;;;; See LICENSE for full terms.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil-new-env))
(#bind nt (#module foil-new-types))
(#bind fixture (#module foil-test-lain))

;; Execute every assertion without publishing a compiled cache.
(define (check z)


  ;;; lain_poke.foil: the reactive application layer, exercised through the
  ;;; sept -> shrine -> lain -> web -> lainapp import chain.  Nominal
  ;;; members brand their runtime reps: tasks ((brand:encode (Weld (fixture:root "task") [["ts" "vine"]]) 1) path
  ;;; writ) / ((brand:encode (Weld (fixture:root "task") [["ts" "hear"]]) 1) news); outcomes ("/boot/ovum/ripe" sov
  ;;; fx signs ack) / ("/boot/ovum/fail" ("ts" err)); kernel dooms
  ;;; ("/boot/doom/done" fate ack) / ("/boot/doom/fail" err); sov faces
  ;;; project _0=rec _1=idx _2=top; moves project _0=src _1=dst _2=writ;
  ;;; anon tap rows (0 p q); cared pairs (0 care path) with care
  ;;; (brand:encode [["ts" "sys"] ["ts" "shrine"] ["ts" "care"] ["ts" "x|y|z"]] 1).

  (define perc (_1 (fixture:compiled 0)))
  (define app-sut (foil:perc-subject perc))
  (define world (foil:perc-world perc))
  (define (brand path)
    (define key (_1 (nt:runtime-key world (nt:type-ref (canon-path path app-sut)))))
    (unless (_0 key) (error ["missing fixture brand" path]))
    (_0 key))
  (DeepSeq app-sut 0)
  (define (app path) (foil:source-entry-val path app-sut))

  ;; kernel + helpers through the merged subject
  (define run-event (app ["run_event"]))
  (DeepSeq run-event 0)
  ;; fixtures
  (define sov0 (app ["seeded"]))
  (DeepSeq sov0 0)
  (define t00 (app ["myth" "new"]))
  (DeepSeq t00 0)
  (define msing (app ["myth" "sing"]))
  (DeepSeq msing 0)
  (define pd-f (app ["pd"]))
  (DeepSeq pd-f 0)
  (define (t-data slot n) (msing slot (pd-f n)))
  (define kooked (app ["kooked"]))
  (DeepSeq kooked 0)
  (define slot-nat (app ["slot_nat"]))
  (DeepSeq slot-nat 0)
  (define mk-news (app ["mk_news"]))
  (DeepSeq mk-news 0)
  (define vine-make (app ["vine_make"]))
  (DeepSeq vine-make 0)
  (define vine-poke (app ["vine_poke"]))
  (DeepSeq vine-poke 0)
  (define vine-cull (app ["vine_cull"]))
  (DeepSeq vine-cull 0)

  (define tkook ("ts" "kook"))
  (DeepSeq tkook 0)
  ;; kook refs are full form-node paths (rerootable; /kook by convention)
  (define kcount [tkook ("ts" "count")])
  (DeepSeq kcount 0)
  (define kmark [tkook ("ts" "mark")])
  (DeepSeq kmark 0)
  (define nslot [("ts" "n")])
  (DeepSeq nslot 0)

  ;;; Kernel make/poke/cull, dispatch, ordering and cascade assertions are
  ;;; owned by foil-lain-core-tests. Only setup needed by the distinct
  ;;; app, history, overlay and journal cases below remains here.


  (define tm ("ts" "m"))
  (DeepSeq tm 0)
  (define r7a (run-event (vine-make [tm] (kooked [kmark])) 7 sov0))
  (DeepSeq r7a 0)
  (define s7a (_0 r7a))
  (DeepSeq s7a 0)
  (define (mk-dep c p) ((brand ["dep"]) c p))
  (define t-crew (app ["t_crew"]))
  (DeepSeq t-crew 0)
  (define twd ("ts" "watched"))
  (DeepSeq twd 0)
  (define eslot [("ts" "eyes")])
  (DeepSeq eslot 0)
  (define cycle (app ["cycle"]))
  (DeepSeq cycle 0)
  (define tsub ("ts" "sub"))
  (DeepSeq tsub 0)
  (define heard [("ts" "heard")])
  (DeepSeq heard 0)
  (define rc1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
  (DeepSeq rc1 0)
  (define rc2 (run-event (vine-make [tsub] (t-crew eslot [twd] [[tkook ("ts" "mark")]])) 7 (_0 rc1)))
  (DeepSeq rc2 0)
  (define g1 (cycle (vine-poke [twd] (t-data nslot 6)) 7 8 (_0 rc2)))
  (DeepSeq g1 0)
  (define sg1 (_0 g1))
  (DeepSeq sg1 0)

  ;;; rerooting: a form node at an arbitrary path dispatches by that path ;;;;;;;

  (define form-card (app ["form" "card"]))
  (DeepSeq form-card 0)
  (define count-form (app ["demo" "count_form"]))
  (DeepSeq count-form 0)
  (define lore-line (app ["lore" "line"]))
  (DeepSeq lore-line 0)
  (define tz1 ("ts" "zoo"))
  (DeepSeq tz1 0)
  (define tz2 ("ts" "reg"))
  (DeepSeq tz2 0)
  (define r10c0
    (run-event
      (vine-make [tz1 tz2] (form-card count-form (lore-line "a rerooted counter")))
      7 sov0))
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10c0))
  (define r10c (run-event (vine-make [("ts" "zz")] (kooked [[tz1 tz2]])) 7 (_0 r10c0)))
  (DeepSeq r10c 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10c))

  ;;; the pact mount form: one make expands the whole app subtree ;;;;;;;;;;;;;;;

  ;; the manifest fixture is foil-built (demo_mani): nominal-row ctors
  ;; applied from rvr produce non-canonical reps that no pail match sees
  (define app-card-t (app ["store_pact_card"]))
  (DeepSeq app-card-t 0)
  (define tapp ("ts" "app"))
  (DeepSeq tapp 0)
  (define tdemo ("ts" "demo"))
  (DeepSeq tdemo 0)
  (define m10d (app ["demo" "mani"]))
  (DeepSeq m10d 0)
  (define r10d
    (run-event (vine-make [tapp tdemo] (app-card-t m10d "apps/demo/main" 0 0)) 7 sov0))
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10d))
  (define s10d (_0 r10d))
  (DeepSeq s10d 0)
  ;; the mounted behavior resolves by its in-app path — the registry is
  ;; the app's own subtree, not /kook
  (define r10d2
    (run-event
      (vine-make [("ts" "zz2")]
        (kooked [[tapp tdemo ("ts" "kook") ("ts" "count")]]))
      7 s10d))
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10d2))
  ;; the same manifest mounts at a second root: the root is a free
  ;; parameter, isolation is structural
  (define r10d3
    (run-event (vine-make [("ts" "zoo2")] (app-card-t m10d "apps/demo/main" 0 0)) 7 s10d))
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10d3))
  (define r10d4
    (run-event
      (vine-make [("ts" "zz3")]
        (kooked [[("ts" "zoo2") ("ts" "kook") ("ts" "count")]]))
      7 (_0 r10d3)))
  assert(Eq (brand ["ovum" "ripe"]) (Hd r10d4))

  ;;; the kept crew index tracks the full derivation ;;;;;;;;;;;;;;;;;;;;;;;;;;

  ;; cycle_with threads an index across events instead of re-walking the
  ;; namespace each round.  The invariant every driver rests on: after
  ;; any event, the index it hands back projects to exactly the watcher
  ;; index a full walk of the committed namespace would derive.

  (define cycle-with (app ["cycle_with"]))
  (DeepSeq cycle-with 0)
  (define hive-of (app ["hive_of"]))
  (DeepSeq hive-of 0)
  (define eyes-from (app ["eyes_from"]))
  (DeepSeq eyes-from 0)
  (define (gyre-sov g) (_0 g))
  (define (agrees? cw)
    (Equal (eyes-from (_1 cw)) (eyes-from (hive-of (gyre-sov (_0 cw))))))

  ;; a crewed node MADE through the cycle enters the index
  (define k1 (run-event (vine-make [twd] (t-data nslot 5)) 7 sov0))
  (DeepSeq k1 0)
  (define k2
    (cycle-with (hive-of (_0 k1))
      (vine-make [tsub] (t-crew eslot [twd] [[tkook ("ts" "mark")]])) 7 8 (_0 k1)))
  assert(Eq (brand ["gyre" "spun"]) (Hd (_0 k2)))
  assert(Eq 1 (agrees? k2))

  ;; and it hears through the kept index, exactly as a derived one
  (define k3 (cycle-with (_1 k2) (vine-poke [twd] (t-data nslot 6)) 7 8 (gyre-sov (_0 k2))))
  (DeepSeq k3 0)
  assert(Eq 1 (slot-nat [tsub] heard 99 (gyre-sov (_0 k3))))
  assert(Eq 1 (agrees? k3))

  ;; culled, it leaves the index — and the next change reaches nobody
  (define k4 (cycle-with (_1 k3) (vine-cull [tsub]) 7 8 (gyre-sov (_0 k3))))
  (DeepSeq k4 0)
  assert(Eq 1 (agrees? k4))
  (define k5 (cycle-with (_1 k4) (vine-poke [twd] (t-data nslot 8)) 7 8 (gyre-sov (_0 k4))))
  (DeepSeq k5 0)
  assert(Eq 1 (Sz (_2 (_0 k5))))
  assert(Eq 1 (agrees? k5))

  ;; a RECURSIVE cull takes the watcher under it with the subtree: the
  ;; culled ancestor is signed, its dead descendants need not be
  (define tpar ("ts" "par"))
  (DeepSeq tpar 0)
  (define tkidw ("ts" "kw"))
  (DeepSeq tkidw 0)
  (define k6 (run-event (vine-make [tpar] (t-data nslot 1)) 7 (gyre-sov (_0 k5))))
  (DeepSeq k6 0)
  (define k7
    (run-event (vine-make [tpar tkidw] (t-crew eslot [twd] [[tkook ("ts" "mark")]])) 7 (_0 k6)))
  (define k8 (cycle-with (hive-of (_0 k7)) (vine-cull [tpar]) 7 8 (_0 k7)))
  (DeepSeq k8 0)
  assert(Eq (brand ["gyre" "spun"]) (Hd (_0 k8)))
  assert(Eq 1 (agrees? k8))
  (define k9 (cycle-with (_1 k8) (vine-poke [twd] (t-data nslot 9)) 7 8 (gyre-sov (_0 k8))))
  (DeepSeq k9 0)
  assert(Eq 1 (Sz (_2 (_0 k9))))
  assert(Eq 1 (agrees? k9))

  ;;; reactivity machine: signs match the eyes, fired watchers leave ;;;;;;;;;;;;;

  (define react (app ["react"]))
  (DeepSeq react 0)
  (define agut (app ["axal" "gut"]))
  (DeepSeq agut 0)
  (define tw ("ts" "w2"))
  (DeepSeq tw 0)
  (define tq ("ts" "quiet"))
  (DeepSeq tq 0)
  ;; making [w2] grades [w2] (2 2 2) AND the root: / holds the
  ;; namespace-root record (root_tasks), so it owns a ledger and its
  ;; kid-set change emits a sign like any other node
  (define rx (run-event (vine-make [tw] (kooked [kcount])) 7 s7a))
  (DeepSeq rx 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd rx))
  (define sx (_0 rx))
  (DeepSeq sx 0)
  (define sgx (_2 rx))
  (DeepSeq sgx 0)
  ;; the index: [w2] watched at x and (by a xeno) at y; the root watched
  ;; at x AND z by [m]; an untouched path watched at z
  (define dx-m (mk-dep (brand ["care" "x"]) [tm]))
  (DeepSeq dx-m 0)
  (define dy-xeno (mk-dep (brand ["care" "y"]) [("ts" "xeno") ("ts" "w")]))
  (DeepSeq dy-xeno 0)
  (define dx-root (mk-dep (brand ["care" "x"]) [tm]))
  (DeepSeq dx-root 0)
  (define dz-root (mk-dep (brand ["care" "z"]) [tm]))
  (DeepSeq dz-root 0)
  (define dz-quiet (mk-dep (brand ["care" "z"]) [tm]))
  (DeepSeq dz-quiet 0)
  (define eyes1
    (mk-news
      [[[tw] [dx-m dy-xeno]]
       [[] [dx-root dz-root]]
       [[tq] [dz-quiet]]]))
  (define rr (react sgx eyes1))
  (DeepSeq rr 0)
  (define nws (_0 rr))
  (DeepSeq nws 0)
  (define rest (_1 rr))
  (DeepSeq rest 0)
  ;; [w2] moved on every care: both watchers fire (xeno filtering is
  ;; invert's job, not react's)
  assert(Equal [dx-m dy-xeno] (agut [tw] 0 nws))
  assert(Eq 0 (agut [tw] 0 rest))
  ;; the asserted root signs the kid make at z (subtree) but its own
  ;; record is untouched: the z watcher fires, the x watcher survives
  assert(Equal [dz-root] (agut [] 0 nws))
  assert(Equal [dx-root] (agut [] 0 rest))
  ;; the untouched path keeps its watcher and emits no news
  assert(Eq 0 (agut [tq] 0 nws))
  assert(Equal [dz-quiet] (agut [tq] 0 rest))
  ;; the news feeds straight back as a hear event: [m] hears its two
  ;; fired deps — [w2]'s x and the root's z (the xeno subscriber is
  ;; dropped by invert)
  (define rh (run-event ((brand ["task" "hear"]) nws) 7 sx))
  (DeepSeq rh 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd rh))
  assert(Eq 2 (slot-nat [tm] [("ts" "heard")] 99 (_0 rh)))

  ;;; /h: the temporal-transposition overlays ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  ;;; /h/care/case/len/...path resolves (care, case) against the first
  ;;; len segments and dips the rest.  Read-only, committed-only, and
  ;;; constant: answers at minted cases never change.

  (define peek-f (app ["peek"]))
  (DeepSeq peek-f 0)
  (define tslot (app ["myth" "nat_at"]))
  (DeepSeq tslot 0)
  (define txt-slot (app ["myth" "txt_at"]))
  (DeepSeq txt-slot 0)
  ;; kid enumeration rides the axal boundary helper (the kid map is a
  ;; bee of pinned links now, not a raw uon)
  (define kidkeys (app ["axal" "kid_keys"]))
  (DeepSeq kidkeys 0)
  (define xqh (app ["x_query_h"]))
  (DeepSeq xqh 0)
  (define xch (app ["x_case_h"]))
  (DeepSeq xch 0)
  (define cyclef (app ["cycle"]))
  (DeepSeq cyclef 0)

  (define th ("ts" "h"))
  (DeepSeq th 0)
  (define htx ("ts" "x"))
  (DeepSeq htx 0)
  (define hty ("ts" "y"))
  (DeepSeq hty 0)
  (define htz ("ts" "z"))
  (DeepSeq htz 0)
  (define ttt ("ts" "tt"))
  (DeepSeq ttt 0)
  (define tkd ("ts" "kid"))
  (DeepSeq tkd 0)
  (define (u n) ("u" n))

  ;; the record itself of an /h read
  (define (arec fat) (_0 (Ix 0 fat)))

  ;; Standard seeded states explicitly assert /io with its driver helpdoc;
  ;; the reserved roots carry their convention lore (shrine-apps.md 7).
  (define tio ("ts" "io"))
  (DeepSeq tio 0)
  (define has-slot-f (app ["myth" "has_at"]))
  (DeepSeq has-slot-f 0)
  (define iodoc (arec (peek-f [tio] sov0)))
  (DeepSeq iodoc 0)
  assert(Equal
    "I/O driver registry. Each live child names a Helm-managed driver; make, poke, and cull child records to start, reconfigure, or stop it."
    (txt-slot (app ["publisher_vocabulary" "doc"]) iodoc))
  assert(Eq 1 (has-slot-f [("ts" "sys") ("ts" "help")] iodoc))
  assert(Eq 1 (has-slot-f [("ts" "sys") ("ts" "help")] (arec (peek-f [tkook] sov0))))
  assert(Eq 1 (has-slot-f [("ts" "sys") ("ts" "help")] (arec (peek-f [("ts" "app")] sov0))))
  assert(Eq 1 (has-slot-f [("ts" "sys") ("ts" "help")] (arec (peek-f [("ts" "out")] sov0))))

  ;; Three internal epochs, but path-local cases: /tt has x=2 and
  ;; y=z=3; /tt/kid independently has x=y=z=1.
  (define ht1 (run-event (vine-make [ttt] (t-data nslot 1)) 7 sov0))
  (DeepSeq ht1 0)
  (define ht2 (run-event (vine-make [ttt tkd] (t-data nslot 2)) 7 (_0 ht1)))
  (DeepSeq ht2 0)
  (define ht3 (run-event (vine-poke [ttt] (t-data nslot 3)) 7 (_0 ht2)))
  (DeepSeq ht3 0)
  (define sh (_0 ht3))
  (DeepSeq sh 0)

  ;; x: the record at each case — history is eternal after later writes
  assert(Eq 1 (tslot nslot 99 (arec (peek-f [th htx (u 1) (u 1) ttt] sh))))
  assert(Eq 3 (tslot nslot 99 (arec (peek-f [th htx (u 2) (u 1) ttt] sh))))
  ;; y at the kid's mint case: the parent still shows its old record and
  ;; the rel dip walks into the kid
  assert(Eq 1 (tslot nslot 99 (arec (peek-f [th hty (u 2) (u 1) ttt] sh))))
  assert(Eq 2 (tslot nslot 99 (arec (peek-f [th hty (u 2) (u 1) ttt tkd] sh))))
  ;; z rel dip agrees
  assert(Eq 2 (tslot nslot 99 (arec (peek-f [th htz (u 2) (u 1) ttt tkd] sh))))
  ;; before the kid existed there is nothing to dip into
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [th htz (u 1) (u 1) ttt tkd] sh)))
  ;; zero and cases beyond this target/care's local counter shrug
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [th htx (u 0) (u 1) ttt] sh)))
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [th htx (u 3) (u 1) ttt] sh)))
  ;; text segments no longer parse as cases: digit segments ride as u
  ;; quips since the aura codec landed, and a string quip at the case
  ;; position shrugs
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [th htx ("ta" "1") (u 1) ttt] sh)))
  ;; the structural levels: /h lists the cares (and the version view),
  ;; while /h/x cannot enumerate cases before a target is known
  assert(Equal [("ts" "v") htx hty htz] (kidkeys (peek-f [th] sh)))
  assert(Equal [] (kidkeys (peek-f [th htx] sh)))
  ;; Incomplete target prefixes are explanatory markers without case
  ;; children; once the complete target is present, its snapshot can
  ;; enumerate relative descendants normally.
  assert(Equal [] (kidkeys (peek-f [th htz (u 2) (u 2) ttt] sh)))
  assert(Equal [tkd] (kidkeys (peek-f [th htz (u 2) (u 1) ttt] sh)))
  assert(Equal [] (kidkeys (peek-f [th htz (u 1) (u 1) ttt] sh)))

  ;; the overlay is read-only: any write under /h fails the event
  (define hbad (run-event (vine-make [th ("ts" "zap")] t00) 7 sh))
  (DeepSeq hbad 0)
  assert(Equal ((brand ["ovum" "fail"]) ("ts" "h_reserved")) hbad)

  ;; x_query_h serves /h (the case rides in the path) and delegates the
  ;; rest; x_case_h answers the constant case 1 on /h
  (define hpx [th htx (u 1) (u 1) ttt])
  (DeepSeq hpx 0)
  assert(Eq (brand ["res" "known"]) (Hd (xqh 0 hpx sh)))
  assert(Eq 1 (tslot nslot 99 (_0 (xqh 0 hpx sh))))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 1) (xch 0 hpx sh))
  assert(Eq (brand ["res" "known"]) (Hd (xqh (_2 sh) [ttt] sh)))
  assert(Equal (brand ["res" "unknown"]) (xqh 0 [th htx (u 999999) (u 1) ttt] sh))

  ;; throwaway subscription: a crew dep into /h never fires — signs
  ;; cannot land under /h, so the cycle stays one round and the
  ;; subscriber never hears
  (define thsub ("ts" "hsub"))
  (DeepSeq thsub 0)
  (define hr1 (run-event (vine-make [thsub] (t-crew eslot hpx [kmark])) 7 sh))
  (DeepSeq hr1 0)
  (define hg (cyclef (vine-poke [ttt] (t-data nslot 4)) 7 8 (_0 hr1)))
  (DeepSeq hg 0)
  assert(Eq (brand ["gyre" "spun"]) (Hd hg))
  assert(Eq 99 (slot-nat [thsub] [("ts" "heard")] 99 (_0 hg)))
  assert(Eq 1 (Sz (_2 hg)))

  ;; /h/v: the target-first version view — independent lock counters as
  ;; decimal text, mint time and block, and no ambiguous global kids
  (define tv ("ts" "v"))
  (DeepSeq tv 0)
  (define hv (peek-f [th tv (u 1) ttt] sh))
  (DeepSeq hv 0)
  (define hvm (arec hv))
  (DeepSeq hvm 0)
  assert(Equal "live" (txt-slot (app ["publisher_vocabulary" "version" "state"]) hvm))
  assert(Equal "2" (txt-slot (app ["publisher_vocabulary" "version" "x_data"]) hvm))
  assert(Equal "1" (txt-slot (app ["publisher_vocabulary" "version" "x_shape"]) hvm))
  assert(Equal "3" (txt-slot (app ["publisher_vocabulary" "version" "y_data"]) hvm))
  assert(Equal "2" (txt-slot (app ["publisher_vocabulary" "version" "y_shape"]) hvm))
  assert(Equal "3" (txt-slot (app ["publisher_vocabulary" "version" "z_data"]) hvm))
  assert(Equal "2" (txt-slot (app ["publisher_vocabulary" "version" "z_shape"]) hvm))
  assert(Equal [] (kidkeys hv))
  ;; A culled node keeps its locks, and a later live write below that
  ;; tombstone is rejected without advancing the sovereign.
  (define htc (run-event (vine-cull [ttt tkd]) 7 sh))
  (DeepSeq htc 0)
  (define hv2m (arec (peek-f [th tv (u 2) ttt tkd] (_0 htc))))
  (DeepSeq hv2m 0)
  assert(Equal "tombstone" (txt-slot (app ["publisher_vocabulary" "version" "state"]) hv2m))
  assert(Equal "2" (txt-slot (app ["publisher_vocabulary" "version" "x_data"]) hv2m))
  assert(Equal "2" (txt-slot (app ["publisher_vocabulary" "version" "x_shape"]) hv2m))
  (define htd (run-event (vine-make [ttt tkd ("ts" "deep")] (t-data nslot 8)) 7 (_0 htc)))
  (DeepSeq htd 0)
  assert(Equal ((brand ["ovum" "fail"]) ("ts" "tombstoned_ancestor")) htd)

  ;; y is a frontier care: the /h/y overlay shows a deep record through
  ;; a transparent intermediate at its full relative pith
  (define thh ("ts" "hh"))
  (DeepSeq thh 0)
  (define tdp ("ts" "deep"))
  (DeepSeq tdp 0)
  (define hf1 (run-event (vine-make [ttt thh tdp] (t-data nslot 9)) 7 sh))
  (DeepSeq hf1 0)
  assert(Eq 9 (tslot nslot 99 (arec (peek-f [th hty (u 4) (u 1) ttt thh tdp] (_0 hf1)))))
  ;; The intermediate path remains transparent: no /h/v record exists.
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [th tv (u 2) ttt thh] (_0 hf1))))

  ;;; /o: the overlay lens ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  ;;; /o/case/olen/...opath/dlen/...dpath applies the weft ctor minted
  ;;; at opath's x case `case` (its /sys/weft slot) to the CURRENT
  ;;; committed data at dpath: the function is pinned by case, the
  ;;; data is live.  Result cases follow the ctor's case algebra —
  ;;; dyed/knit carry the data's x case, felt/sewn its z case.
  ;;; Read-only.

  ;; weft ctors are record TYPES in the subject — construct the branded
  ;; rows directly (memory: source-entry-val on a record type applies
  ;; silently and yields an unreadable slot)
  (define meld-f (app ["myth" "meld"]))
  (DeepSeq meld-f 0)
  (define axal-new (app ["axal" "new"]))
  (DeepSeq axal-new 0)
  (define mnone (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1))
  (DeepSeq mnone 0)

  (define to ("ts" "o"))
  (DeepSeq to 0)
  (define wslot [("ts" "sys") ("ts" "weft")])
  (DeepSeq wslot 0)
  (define xslot [("ts" "extra")])
  (DeepSeq xslot 0)

  ;; a dyed overlay: meld an extra slot onto the data myth (distinct
  ;; slot, so the data's nslot rides through unmasked).  The get
  ;; functions are unary closures — a partially applied foil law is
  ;; not a callable-of-one at the PLAN layer.
  (define (add-extra t) (meld-f (t-data xslot 42) t))
  (define (add-extra2 t) (meld-f (t-data xslot 77) t))
  (define tov ("ts" "ov"))
  (DeepSeq tov 0)
  (define ovd (run-event
    (vine-make [tov] (msing wslot ((brand ["dyed"]) add-extra mnone)))
    7 sh))
  (DeepSeq ovd 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd ovd))
  (define so1 (_0 ovd))
  (DeepSeq so1 0)
  ;; a second version of the overlay function: /ov advances to x case 2
  (define ovd2 (run-event
    (vine-poke [tov] (msing wslot ((brand ["dyed"]) add-extra2 mnone)))
    7 so1))
  (DeepSeq ovd2 0)
  (define so1b (_0 ovd2))
  (DeepSeq so1b 0)

  ;; the case pins the FUNCTION version; the data is read live (/tt's
  ;; latest record is n=3)
  (define op1 [to (u 1) (u 1) tov (u 1) ttt])
  (DeepSeq op1 0)
  (define op2 [to (u 2) (u 1) tov (u 1) ttt])
  (DeepSeq op2 0)
  assert(Eq 3 (tslot nslot 99 (arec (peek-f op1 so1b))))
  assert(Eq 42 (tslot xslot 99 (arec (peek-f op1 so1b))))
  assert(Eq 3 (tslot nslot 99 (arec (peek-f op2 so1b))))
  assert(Eq 77 (tslot xslot 99 (arec (peek-f op2 so1b))))
  ;; before the second version minted, its case shrugs
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f op2 so1)))
  ;; zero, unminted cases, and unregistered overlay paths shrug
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [to (u 0) (u 1) tov (u 1) ttt] so1)))
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [to (u 9) (u 1) tov (u 1) ttt] so1)))
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [to (u 1) (u 1) ("ts" "nosuch") (u 1) ttt] so1)))
  ;; structural levels: the root and incomplete prefixes are markers
  ;; without enumerable kids
  assert(Equal [] (kidkeys (peek-f [to] so1)))
  assert(Equal [] (kidkeys (peek-f [to (u 1)] so1)))
  assert(Equal [] (kidkeys (peek-f [to (u 1) (u 2) tov] so1)))

  ;; a knit overlay: build a one-node tree from the data's live record
  (define (wrap-axal t) (axal-new ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) t)))
  (define tok ("ts" "ok"))
  (DeepSeq tok 0)
  (define ovk (run-event
    (vine-make [tok] (msing wslot ((brand ["knit"]) wrap-axal mnone)))
    7 so1b))
  (DeepSeq ovk 0)
  (define so2 (_0 ovk))
  (DeepSeq so2 0)
  assert(Eq 3 (tslot nslot 99 (arec (peek-f [to (u 1) (u 1) tok (u 1) ttt] so2))))

  ;; a sewn overlay: identity on the live z snapshot — the rel dip
  ;; reaches the kid
  (define (idf x) x)
  (define tos ("ts" "os"))
  (DeepSeq tos 0)
  (define ovs (run-event
    (vine-make [tos] (msing wslot ((brand ["sewn"]) idf mnone)))
    7 so2))
  (DeepSeq ovs 0)
  (define so3 (_0 ovs))
  (DeepSeq so3 0)
  assert(Eq 3 (tslot nslot 99 (arec (peek-f [to (u 1) (u 1) tos (u 1) ttt] so3))))
  assert(Eq 2 (tslot nslot 99 (arec (peek-f [to (u 1) (u 1) tos (u 1) ttt tkd] so3))))

  ;; a felt overlay: collapse the live subtree to its root record
  (define (take-root fat) (_0 (Ix 0 fat)))
  (define tof ("ts" "of"))
  (DeepSeq tof 0)
  (define ovf (run-event
    (vine-make [tof] (msing wslot ((brand ["felt"]) take-root mnone)))
    7 so3))
  (DeepSeq ovf 0)
  (define so4 (_0 ovf))
  (DeepSeq so4 0)
  assert(Eq 3 (tslot nslot 99 (arec (peek-f [to (u 1) (u 1) tof (u 1) ttt] so4))))

  ;; the data is live through a pinned function: poking /tt shows up
  ;; under the same /o path, same overlay case
  (define ovp (run-event (vine-poke [ttt] (t-data nslot 5)) 7 so4))
  (DeepSeq ovp 0)
  (define so5 (_0 ovp))
  (DeepSeq so5 0)
  assert(Eq 5 (tslot nslot 99 (arec (peek-f op1 so5))))
  assert(Eq 42 (tslot xslot 99 (arec (peek-f op1 so5))))

  ;; composition: dpath may itself be derived.  Through /h the data is
  ;; pinned too — function AND data constant, so the answer survives
  ;; the /tt poke unchanged, and the result reports the constant case
  (define ophd [to (u 1) (u 1) tov (u 5) th htx (u 1) (u 1) ttt])
  (DeepSeq ophd 0)
  assert(Eq 1 (tslot nslot 99 (arec (peek-f ophd so1b))))
  assert(Eq 42 (tslot xslot 99 (arec (peek-f ophd so1b))))
  assert(Eq 1 (tslot nslot 99 (arec (peek-f ophd so5))))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 1) (xch 0 ophd so5))
  ;; felt over the /h z view: the subtree-shaped read composes too
  assert(Eq 1 (tslot nslot 99 (arec (peek-f [to (u 1) (u 1) tof (u 5) th htz (u 2) (u 1) ttt] so5))))
  ;; /o over /o: dyed v2 over the knit result, both reading live data;
  ;; the reported case recurses into the inner lens's algebra
  (define opoo [to (u 2) (u 1) tov (u 6) to (u 1) (u 1) tok (u 1) ttt])
  (DeepSeq opoo 0)
  assert(Eq 5 (tslot nslot 99 (arec (peek-f opoo so5))))
  assert(Eq 77 (tslot xslot 99 (arec (peek-f opoo so5))))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 3) (xch 0 opoo so5))
  ;; /h over /o: time travel through a live lens — the /h case indexes
  ;; the underlying data's timeline per the algebra.  The knit lens as
  ;; of /tt's x cases 2 and 3, read from the same post-poke state
  (define hoo2 [th htx (u 2) (u 6) to (u 1) (u 1) tok (u 1) ttt])
  (DeepSeq hoo2 0)
  (define hoo3 [th htx (u 3) (u 6) to (u 1) (u 1) tok (u 1) ttt])
  (DeepSeq hoo3 0)
  assert(Eq 3 (tslot nslot 99 (arec (peek-f hoo2 so5))))
  assert(Eq 5 (tslot nslot 99 (arec (peek-f hoo3 so5))))
  ;; /h/z over the sewn lens: the subtree as of /tt's z case 2, rel
  ;; dipped into the kid
  assert(Eq 2 (tslot nslot 99 (arec (peek-f [th htz (u 2) (u 6) to (u 1) (u 1) tos (u 1) ttt tkd] so5))))

  ;;; /x evaluates the datum's stored function against its pinned tack.
  ;;; The defining datum's own case is the result case.

  (define txq ("ts" "xq"))
  (DeepSeq txq 0)
  (define txx ("ts" "x"))
  (DeepSeq txx 0)
  (define tack-slot [("ts" "sys") ("ts" "tack")])
  (DeepSeq tack-slot 0)
  (define lim-slot [("ts" "limit")])
  (DeepSeq lim-slot 0)

  ;; the spun: meld the node's own ['limit] onto the tack root's
  ;; record as ['extra] — a one-node result tree proving both inputs
  ;; arrived (2-arg host closure; foil applies (get nm dt))
  (define (queue-fn nm dt)
    (axal-new ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1)
                (meld-f (t-data xslot (tslot lim-slot 0 nm)) (arec dt)))))

  (define xrec (meld-f (msing wslot ((brand ["spun"]) queue-fn mnone))
                 (meld-f (msing tack-slot ((brand ["safe"]) (_0 ((app ["sov" "y_case"]) [ttt] so5)) (brand ["care" "y"]) [ttt]))
                   (t-data lim-slot 9))))
  (DeepSeq xrec 0)
  (define xv0 (run-event (vine-make [txq] xrec) 7 so5))
  (DeepSeq xv0 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd xv0))
  (define sx0 (_0 xv0))
  (DeepSeq sx0 0)

  ;; the derived tree: tack root's pinned n (5 after the /tt poke) plus
  ;; the node's limit riding as extra
  (define xp [txx txq])
  (DeepSeq xp 0)
  assert(Eq 5 (tslot nslot 99 (arec (peek-f xp sx0))))
  assert(Eq 9 (tslot xslot 99 (arec (peek-f xp sx0))))

  ;; the weft/args are LIVE: poke a new limit, same path answers anew
  (define xv1 (run-event (vine-poke [txq] (t-data lim-slot 12)) 7 sx0))
  (DeepSeq xv1 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd xv1))
  (define sx1 (_0 xv1))
  (DeepSeq sx1 0)
  assert(Eq 12 (tslot xslot 99 (arec (peek-f xp sx1))))
  ;; changing the target leaves the pinned result unchanged
  (define xv2 (run-event (vine-poke [ttt] (t-data nslot 8)) 7 sx1))
  (DeepSeq xv2 0)
  (define sx2 (_0 xv2))
  (DeepSeq sx2 0)
  assert(Eq 5 (tslot nslot 99 (arec (peek-f xp sx2))))

  ;; Only a change to the defining datum advances derived identity.
  (define xc0 (xch 0 xp sx0))
  (DeepSeq xc0 0)
  (define xc1 (xch 0 xp sx1))
  (DeepSeq xc1 0)
  (define xc2 (xch 0 xp sx2))
  (DeepSeq xc2 0)
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 1) xc0)
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 2) xc1)
  assert(Equal xc1 xc2)

  ;; a node without weft/tack shrugs; the root is a marker, no kids
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [txx ttt] sx2)))
  assert(Equal [] (kidkeys (peek-f [txx] sx2)))
  ;; writes under /x fail the event
  (define xw (run-event (vine-poke [txx txq] (t-data nslot 1)) 7 sx2))
  (DeepSeq xw 0)
  assert(Eq (brand ["ovum" "fail"]) (Hd xw))

  ;;; writ/warp: poke with an overlay — the op card's fn applied to
  ;;; (transient input, current record), committed as a REPLACE.

  (define vine-warp (app ["vine_warp"]))
  (DeepSeq vine-warp 0)
  (define bump-card (app ["demo" "bump_card"]))
  (DeepSeq bump-card 0)
  (define topx ("ts" "opx"))
  (DeepSeq topx 0)
  (define twt ("ts" "wt"))
  (DeepSeq twt 0)
  (define dslot [("ts" "d")])
  (DeepSeq dslot 0)

  (define wp0 (run-event (vine-make [topx] bump-card) 7 sx2))
  (DeepSeq wp0 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wp0))
  ;; the target: n=1 plus a doomed extra slot
  (define wp1 (run-event (vine-make [twt]
                           (meld-f (t-data nslot 1) (t-data xslot 7))) 7 (_0 wp0)))
  (DeepSeq wp1 0)
  (define wp2 (run-event (vine-warp [twt] [topx] (t-data dslot 4)) 7 (_0 wp1)))
  (DeepSeq wp2 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wp2))
  (define wrec (arec (peek-f [twt] (_0 wp2))))
  (DeepSeq wrec 0)
  ;; fn saw both: cur.n + input.d
  assert(Eq 5 (tslot nslot 99 wrec))
  ;; REPLACE: the slot the fn dropped is gone...
  assert(Eq 99 (tslot xslot 99 wrec))
  ;; ...and the input never landed anywhere
  assert(Eq 99 (tslot dslot 99 wrec))
  ;; an unknown op fails the event
  assert(Eq (brand ["ovum" "fail"])
    (Hd (run-event (vine-warp [twt] [("ts" "nosuch")] t00) 7 (_0 wp2))))

  ;; make-with-overlay-if-absent: a MISSING dst applies the fn against
  ;; the empty record instead of failing
  (define twnew ("ts" "wnew"))
  (DeepSeq twnew 0)
  (define wpm (run-event (vine-warp [twnew] [topx] (t-data dslot 4)) 7 (_0 wp2)))
  (DeepSeq wpm 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wpm))
  assert(Eq 4 (tslot nslot 99 (arec (peek-f [twnew] (_0 wpm)))))

  ;; a kooked result resolves and threads init in the same event:
  ;; spawn_card's fn returns a record carrying the spawn kook, so the
  ;; warp-made node grows its 'kid child
  (define spawn-card (app ["demo" "spawn_card"]))
  (DeepSeq spawn-card 0)
  (define tops ("ts" "ops"))
  (DeepSeq tops 0)
  (define twk ("ts" "wk"))
  (DeepSeq twk 0)
  (define wps0 (run-event (vine-make [tops] spawn-card) 7 (_0 wpm)))
  (DeepSeq wps0 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wps0))
  (define wps (run-event (vine-warp [twk] [tops] t00) 7 (_0 wps0)))
  (DeepSeq wps 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wps))
  assert(Equal [("ts" "kid")] (kidkeys (peek-f [twk] (_0 wps))))

  ;; the lens is read-only: any write under /o fails the event
  (define obad (run-event (vine-make [to ("ts" "zap")] t00) 7 so4))
  (DeepSeq obad 0)
  assert(Equal ((brand ["ovum" "fail"]) ("ts" "o_reserved")) obad)

  ;; x_query_h serves /o; x_case_h answers the case algebra: dyed
  ;; results carry /tt's x case (2, then 3 after the poke), sewn its
  ;; z case
  assert(Eq (brand ["res" "known"]) (Hd (xqh 0 op1 so1b)))
  assert(Eq 3 (tslot nslot 99 (_0 (xqh 0 op1 so1b))))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 2) (xch 0 op1 so1b))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 3) (xch 0 op1 so5))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) 3) (xch 0 [to (u 1) (u 1) tos (u 1) ttt] so3))
  assert(Equal (brand ["res" "unknown"]) (xqh 0 [to (u 9) (u 1) tov (u 1) ttt] so1))

  ;; lens reactivity: a crew dep into /o fires when the underlying
  ;; data moves — the dep translates to its real trigger, the hear
  ;; carries the /o path the subscriber named (its hear writes the
  ;; rely count into ['heard])
  (define tosub ("ts" "osub"))
  (DeepSeq tosub 0)
  (define or1 (run-event (vine-make [tosub] (t-crew eslot op1 [kmark])) 7 so5))
  (DeepSeq or1 0)
  (define og (cyclef (vine-poke [ttt] (t-data nslot 6)) 7 8 (_0 or1)))
  (DeepSeq og 0)
  assert(Eq (brand ["gyre" "spun"]) (Hd og))
  assert(Eq 2 (Sz (_2 og)))
  assert(Eq 1 (slot-nat [tosub] [("ts" "heard")] 99 (_0 og)))

  ;; a dep into /o-over-/h has no trigger (fully pinned) and stays quiet
  (define tohsub ("ts" "ohsub"))
  (DeepSeq tohsub 0)
  (define ohr (run-event (vine-make [tohsub] (t-crew eslot ophd [kmark])) 7 so5))
  (DeepSeq ohr 0)
  (define ohg (cyclef (vine-poke [ttt] (t-data nslot 7)) 7 8 (_0 ohr)))
  (DeepSeq ohg 0)
  assert(Eq 1 (Sz (_2 ohg)))
  assert(Eq 99 (slot-nat [tohsub] [("ts" "heard")] 99 (_0 ohg)))

  ;; nested lenses: a dep on /o-over-/o fires from the innermost data
  (define tnsub ("ts" "nsub"))
  (DeepSeq tnsub 0)
  (define nr1 (run-event (vine-make [tnsub] (t-crew eslot opoo [kmark])) 7 so5))
  (DeepSeq nr1 0)
  (define ng (cyclef (vine-poke [ttt] (t-data nslot 8)) 7 8 (_0 nr1)))
  (DeepSeq ng 0)
  assert(Eq 1 (slot-nat [tnsub] [("ts" "heard")] 99 (_0 ng)))

  ;; trigger cares discriminate: making a fresh kid under /tt grades z
  ;; but not x, so a felt dep fires and a dyed dep stays quiet
  (define tfsub ("ts" "fsub"))
  (DeepSeq tfsub 0)
  (define t2sub ("ts" "x2sub"))
  (DeepSeq t2sub 0)
  (define fr1 (run-event (vine-make [tfsub] (t-crew eslot [to (u 1) (u 1) tof (u 1) ttt] [kmark])) 7 so5))
  (DeepSeq fr1 0)
  (define fr2 (run-event (vine-make [t2sub] (t-crew eslot op1 [kmark])) 7 (_0 fr1)))
  (DeepSeq fr2 0)
  (define fg (cyclef (vine-make [ttt ("ts" "kid2")] (t-data nslot 9)) 7 8 (_0 fr2)))
  (DeepSeq fg 0)
  assert(Eq 1 (slot-nat [tfsub] [("ts" "heard")] 99 (_0 fg)))
  assert(Eq 99 (slot-nat [t2sub] [("ts" "heard")] 99 (_0 fg)))

  ;; an unminted pin falls back to watching the overlay path itself:
  ;; the eye wakes on the event that mints the pin (lens deps
  ;; translate against the pre-round sov, so the answer's first
  ;; change — unknown to known — fires)
  (define op3 [to (u 3) (u 1) tov (u 1) ttt])
  (DeepSeq op3 0)
  (define tpsub ("ts" "psub"))
  (DeepSeq tpsub 0)
  (define pr1 (run-event (vine-make [tpsub] (t-crew eslot op3 [kmark])) 7 so5))
  (DeepSeq pr1 0)
  assert(Eq 99 (slot-nat [tpsub] [("ts" "heard")] 99 (_0 pr1)))
  (define pg (cyclef (vine-poke [tov] (msing wslot ((brand ["dyed"]) add-extra mnone))) 7 8 (_0 pr1)))
  (DeepSeq pg 0)
  assert(Eq 2 (Sz (_2 pg)))
  assert(Eq 1 (slot-nat [tpsub] [("ts" "heard")] 99 (_0 pg)))

  ;;; the /log journal: every cycle epoch leaves its node ;;;;;;;;;;;;;;;;;;;;;;;;

  (define dig-show (app ["dig_show"]))
  (DeepSeq dig-show 0)
  (define pail-at (app ["myth" "pail_at"]))
  (DeepSeq pail-at 0)
  (define tlog ("ts" "log"))
  (DeepSeq tlog 0)
  (define evslot [("ts" "ev")])
  (DeepSeq evslot 0)

  ;; The g1 fixture drove a poke through the cycle: two rounds, two
  ;; epochs, two journal nodes.  The driving event's entry carries the
  ;; task verbatim, the ack it earned, and its (empty) effects.
  (define top-g1 (_2 sg1))
  (DeepSeq top-g1 0)
  (define lrec1 (arec (peek-f [tlog (dig-show (Sub top-g1 1))] sg1)))
  (DeepSeq lrec1 0)
  assert(Eq 1 (has-slot-f evslot lrec1))
  (define card1 (pail-at evslot lrec1))
  (DeepSeq card1 0)
  assert(Eq (brand ["log_card"]) (Hd card1))
  assert(Equal (vine-poke [twd] (t-data nslot 6)) (_0 card1))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) [twd]) (_1 card1))
  assert(Equal [] (_2 card1))
  ;; the cascade's hear round journals too, at the top epoch, acked none
  (define card2 (pail-at evslot (arec (peek-f [tlog (dig-show top-g1)] sg1))))
  (DeepSeq card2 0)
  assert(Eq (brand ["log_card"]) (Hd card2))
  assert(Eq (brand ["task" "hear"]) (Hd (_0 card2)))
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (_1 card2))

  ;; run_event (seeding, probes) stays journal-free: no /log node mints
  (define nj (run-event (vine-make [("ts" "njt")] (t-data nslot 1)) 7 sov0))
  (DeepSeq nj 0)
  assert(Equal (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "none"]] 1) (Ix 0 (peek-f [tlog (dig-show (_2 (_0 nj)))] (_0 nj))))

  ;; the journal is commit-owned: kernel writes to /log fail the event
  (define lgw (run-event (vine-make [tlog ("ts" "zz")] (t-data nslot 1)) 7 sov0))
  (DeepSeq lgw 0)
  assert(Equal ((brand ["ovum" "fail"]) ("ts" "write_outside_authority")) lgw)

  ;; a node crewing /log derives no eyes: the journal's own signs can
  ;; never feed back into the cascade
  (define tlw ("ts" "lw"))
  (DeepSeq tlw 0)
  (define rl1 (run-event (vine-make [tlw] (t-crew eslot [tlog] [[tkook ("ts" "mark")]])) 7 sov0))
  (DeepSeq rl1 0)
  (define gl (cycle (vine-make [twd] (t-data nslot 5)) 7 8 (_0 rl1)))
  (DeepSeq gl 0)
  assert(Eq (brand ["gyre" "spun"]) (Hd gl))
  assert(Eq 1 (Sz (_2 gl)))
  assert(Eq 99 (slot-nat [tlw] heard 99 (_0 gl)))

  ;;; fragment components: ['html] markup through the lens ;;;;;;;;;;;;;;;;;;;;;;

  ;; a component is an overlay ctor whose get writes a weft/node at
  ;; ['html] (web's frag/html); the /frag responder renders it bare.
  ;; The markup builders are foil FUNCTION entries applied host-side
  ;; (functions cross the FFI fine; only record-type ctors yield
  ;; non-canonical reps), so the node values are canonical.
  (define frag-html (app ["frag" "html"]))
  (DeepSeq frag-html 0)
  (define weft-tx (app ["weft" "tx"]))
  (DeepSeq weft-tx 0)
  (define weft-render (app ["weft" "render"]))
  (DeepSeq weft-render 0)
  (define weft-shownat (app ["weft" "show_nat"]))
  (DeepSeq weft-shownat 0)
  (define as-node (app ["frag" "as_node"]))
  (DeepSeq as-node 0)
  (define hslot [("ts" "html")])
  (DeepSeq hslot 0)

  (define (num-html t) (frag-html "b" [] [(weft-tx (weft-shownat (tslot nslot 0 t)))]))
  (define twc ("ts" "wc"))
  (DeepSeq twc 0)
  (define wc1 (run-event (vine-make [twc] (msing wslot ((brand ["dyed"]) num-html mnone))) 7 so5))
  (DeepSeq wc1 0)
  assert(Eq (brand ["ovum" "ripe"]) (Hd wc1))
  (define sw1 (_0 wc1))
  (DeepSeq sw1 0)
  (define opw [to (u 1) (u 1) twc (u 1) ttt])
  (DeepSeq opw 0)
  ;; the fragment renders the live data (/tt is n=5 at so5)
  (define nd1 (as-node (pail-at hslot (arec (peek-f opw sw1)))))
  (DeepSeq nd1 0)
  assert(Eq (brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1) (Hd nd1))
  assert(Equal "<b>5</b>" (weft-render (_0 nd1)))
  ;; the data stays live through the pinned component: poke, re-read,
  ;; and the same /o path renders the new markup
  (define wc2 (run-event (vine-poke [ttt] (t-data nslot 12)) 7 sw1))
  (DeepSeq wc2 0)
  (define nd2 (as-node (pail-at hslot (arec (peek-f opw (_0 wc2))))))
  (DeepSeq nd2 0)
