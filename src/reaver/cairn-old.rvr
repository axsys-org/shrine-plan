;

;;  term is either a nat, law, app, cast or app
;;  value is either
(define (is-val v)
  (any (lambda (tag) (Equal tag (-0 v))) ["vnat", "vpin", "vlaw", "vrow", "varr"]))

;;
(define (vnat n)
  assert(IsNat n)
  ["vnat" n])

(define (vpin p)
  assert(IsPin p)
  ["vpin" p])

(define (vlaw l)
  assert(IsLaw l)
  ["vlaw" l])

(define (vrow lvl v)
  assert(all (is-val v))
  assert(IsNat lvl)
  ["vrow" lvl v])

(define (varr lvl item)
  assert(IsNat lvl)
  assert(is-val item)
  ["varr" lvl item])


(define (is-sem-type ty)
  (any (lambda (tag) (Equal tag (-0 ty))) ["s-top", "s-nat", "s-law", "s-row",
  "s-arr", "s-pin", "s-sum", "s-uni", "s-unk", "s-know"))

(define (s-top u)
  assert(IsNat u)
  (Row 1 "s-top" u))

(define s-nat
  (Row 1 "s-nat"))

(define (s-law args res)
  assert(all is-sem-type args)
  assert(is-sem-type res)
  (Row 1 "s-law" args res))

(define (s-arr lvl ty)
  assert(IsNat lvl)
  assert(is-sem-type ty)
  (Row 1 "s-arr" args res))

(define (s-pin p)
  assert(is-sem-type p)
  (Row 1 "s-pin" p))

(define (s-sum opts)
  assert(all is-sem-type opts)
  (Row 1 "s-sum" opts))

(define (s-uni lvl)
  assert(IsNat lvl)
  (Row 1 "s-uni" lvl))

(define s-unk
  (Row 1 "s-unk"))

(define (s-know v)
  assert(is-val v)
  (Row 1 "s-know" v))

(define t-nat
  (Row 1 0))

;; [1 2 [0 ]]
(define (t-sum opts)
  (Row 1 2 opts))

(define (t-law args res)
  (Row 1 3 args res))

(define (t-uni lvl)
  assert(IsNat lvl)
  (Row 1 4 lvl))

(define (t-pin p)
  (Row 1 5 p))

(define (t-row len vals)
  assert(IsNat len)
  (Row 1 6 len vals))


(define t-top
  (Row 1 7))

(define t-unk
  (Row 1 8))

(define (t-val v)
  (Row 1 9 v))

(define (t-arr arr)
  (Row 1 10 arr))

(define (decode-1 ty)
  assert(Equal 1 (_0 ty))
  (letone hed (_1 ty)
    (cond
      ((Equal hed 0) s-nat)
      ((Equal hed 2) (s-sum (map decode-1 (_2 ty)))) ;; sum
      ((Equal hed 3) (s-law (map decode-1 (_2 ty))) (decode-1 (_3 ty)))) ;; law
      ((Equal hed 4) (s-uni (_2 ty))) ;; universe
      ((Equal hed 5) (s-pin (_2 (decode-1 ty))))
      ((Equal hed 6) (s-row (_2 ty) (decode-1 (_3 ty))))
      ((Equal hed 7) s-top)
      ((Equal hed 8) s-unk)
      ((Equal hed 9) (s-know (_2 ty)))
      ((Equal hed 10) (s-arr (_2 ty)))
      (else error("bad ty" ty))))








