;;;; New-driver compiler operations; Foil owns manifest composition.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind subject (#module foil-subject))
(#bind abi (#module foil-abi))
(#bind grove (#module grove))
(#bind render (#module foil-render))

(define (probe-file path)
  (define result (Try (lambda (z)
    (define text (read-text-file path)) (DeepSeq text text)) 0))
  (If (Eq 1 (Hd result)) 0 (_0 result)))
(define (error-text error)
  (define result (Try render:diag-flat error))
  (If (Eq 1 (Hd result)) "unrenderable compiler error" (_0 result)))

;; A failed module cannot publish partially compiled dependencies.
(define (cache-compile-with context read cache mod)
  (define result (Try (lambda (z)
    (force (driver:compile-with context read cache mod))) 0))
  (If (Eq 1 (Hd result)) [cache 0] [(_0 (_0 result)) 1]))
(define (cache-compile context cache mod)
  (cache-compile-with context source:read-module cache mod))
(define (compile-roster-with context read cache mods)
  (foldl (lambda (state mod)
    (define result (cache-compile-with context read (_0 state) mod))
    [(_0 result) (If (_1 result) (_1 state) (snoc mod (_1 state)))])
    [cache []] mods))
(define (compile-roster context cache mods)
  (compile-roster-with context source:read-module cache mods))

(define brand abi:constructor)
(define (optional-manifest policy perc)
  (define hit (Try (lambda (z) (driver:get-perc ["app"] perc)) 0))
  (If (Eq 1 (Hd hit)) (abi:option policy "none")
    (If ((driver:get-perc ["mani" "ok"] policy) (_0 hit))
      ((abi:option policy "some") (_0 hit))
      (error "app-entry-not-mani"))))

;; Constructor identities are taken from the compiled policy module.
;; Builtin maybe stays shared; module-defined records are qualified.
(define (ports context read policy)
  (define compiled (brand policy ["app_compiled"]))
  (define ready (brand policy ["app_attempt" "ready"]))
  (define failed (brand policy ["app_attempt" "failed"]))
  (define port-tag (brand policy ["app_compile_ports"]))
  (define (code cache mod)
    (define result (source:compile context cache mod))
    (compiled (_0 result) (optional-manifest policy (_1 result)) (abi:option policy "none")))
  (define (spec cache name text)
    (define result (source:compile-rex context cache
      (strcat ["apps/" name "/main_spec"])
      (grove:grove-tree name text)))
    (compiled (_0 result) (optional-manifest policy (_1 result))
      ((abi:option policy "some") (driver:get-perc ["spec"] (_1 result)))))
  (define (attempt thunk)
    (define result (Try (lambda (z) (force (thunk 0))) 0))
    (If (Eq 1 (Hd result)) (failed (error-text (_0 result)))
      (ready (_0 result))))
  (port-tag read code spec attempt))

(define (compile-apps-nonempty context read cache names)
  (define policy-result (source:compile context cache "app_install"))
  (define policy (_1 policy-result))
  (define built ((driver:get-perc ["app_compile" "many"] policy)
    (ports context read policy) (_0 policy-result) names))
  (define ready (brand policy ["app_manifest" "ready"]))
  (define catalog (map (lambda (item)
    (define result (_1 item))
    [(_0 item) (If (Eq ready (Hd result)) ["OK" (_0 result)]
      ["ERR" (_0 result)])]) (_1 built)))
  ;; Policy compilation is scaffolding: all-failure/empty batches keep the
  ;; caller's original cache, just like a failed individual app.
  [(If (includes (lambda (item) (Eq "OK" (_0 (_1 item)))) catalog)
      (_0 built) cache)
   catalog])
(define (compile-apps-with context read cache names)
  (Ifz (Sz names) [cache []] (compile-apps-nonempty context read cache names)))
(define (compile-apps context cache names)
  (compile-apps-with context probe-file cache names))
(define (compile-app context cache name)
  (define result (compile-apps context cache [name]))
  [(_0 result) (_1 (_0 (_1 result)))])

(define (compile-code context cache mod)
  (define policy (_1 (source:compile context cache "app_install")))
  ((_1 (ports context probe-file policy)) cache mod))
(define (compile-grove context cache name text)
  (define policy (_1 (source:compile context cache "app_install")))
  ((_2 (ports context probe-file policy)) cache name text))
