(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

(#bind foil-rex (#module foil-rex))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

(#bind schemagen (#module schemagen))


;;; schemagen: JSON schema -> generated foil types + serde, compiled
;;; through the tree-fed seam (foil:compile-rex).  Schema and payload
;;; text is host-built (quote bytes can't ride foil literals, and the
;;; fixtures are JSON).

(define q 34)
(define (js s) (strcat [q s q]))
(define (kv k v) (strcat [(js k) ":" v]))

;;; compile-rex identity: a parsed tree compiles like the file did.

(define jsrc (foil:get-foil "json"))
(define jsut (foil:compile-rex foil:default-subject "json"
               (rex:ParseRexNormFile jsrc)))
(define jrt (foil:source-entry-val ["rt"] jsut))
assert(Equal "[1,2,3]" (jrt "[ 1 , 2 , 3 ]"))

;;; The zero-span property: past the tokenizer, spans are diagnostics
;;; only.  A normalized tree with every span zeroed must compile and
;;; behave identically — structure lives in containment, never in
;;; columns or offsets.

(define zspan [0 0 0 0])
(define (zap r)
  (cond
    ((foil-rex:rx-leaf? r)
      (foil-rex:rx-leaf zspan (foil-rex:rx-leaf-shape r)
        (foil-rex:rx-leaf-str r)))
    ((foil-rex:rx-nest? r)
      (foil-rex:rx-nest zspan (foil-rex:rx-nest-color r)
        (foil-rex:rx-nest-rune r) (map zap (foil-rex:rx-nest-kids r))))
    ((foil-rex:rx-juxt? r)
      (foil-rex:rx-juxt zspan (map zap (foil-rex:rx-juxt-kids r))))
    (else r)))

(define zsut (foil:compile-rex foil:default-subject "json"
               (zap (rex:ParseRexNormFile jsrc))))
(define zrt (foil:source-entry-val ["rt"] zsut))
assert(Equal "[1,2,3]" (zrt "[ 1 , 2 , 3 ]"))
assert(Equal "expected-comma-or-bracket" (zrt "[1"))

;;; The fixture: a record with required/optional prims, an array, a
;;; record ref, and an enum ref.

(define schema-txt
  (strcat
    ["{" (kv "title" (js "task")) "," (kv "type" (js "object")) ","
     (kv "required" (strcat ["[" (js "name") "," (js "done") "]"])) ","
     (kv "properties"
       (strcat
         ["{" (kv "name" (strcat ["{" (kv "type" (js "string")) "}"])) ","
          (kv "done" (strcat ["{" (kv "type" (js "boolean")) "}"])) ","
          (kv "count" (strcat ["{" (kv "type" (js "integer")) "}"])) ","
          (kv "tags" (strcat ["{" (kv "type" (js "array")) ","
                              (kv "items" (strcat ["{" (kv "type" (js "string")) "}"]))
                              "}"])) ","
          (kv "peer" (strcat ["{" (kv "$ref" (js "#/$defs/peer")) "}"])) ","
          (kv "hue" (strcat ["{" (kv "$ref" (js "#/$defs/hue")) "}"]))
          "}"])) ","
     (kv "$defs"
       (strcat
         ["{" (kv "peer"
                (strcat ["{" (kv "type" (js "object")) ","
                         (kv "required" (strcat ["[" (js "host") "," (js "port") "]"])) ","
                         (kv "properties"
                           (strcat ["{" (kv "host" (strcat ["{" (kv "type" (js "string")) "}"])) ","
                                    (kv "port" (strcat ["{" (kv "type" (js "integer")) "}"]))
                                    "}"]))
                         "}"])) ","
          (kv "hue" (strcat ["{" (kv "enum" (strcat ["[" (js "red") "," (js "green") "]"])) "}"]))
          "}"])) ","
     (kv "examples"
       (strcat ["[{" (kv "name" (js "a")) "," (kv "done" "true") "}]"]))
     "}"]))

(define g (schemagen:compile-schema foil:default-subject jsut schema-txt))
assert(Equal "task" (_0 g))
(define gsut (Ix 2 g))
(define rt (foil:source-entry-val ["rt"] gsut))

;;; Round-trips: canonical spelling back, optional keys ride only when
;;; present, order preserved.

(define t-min (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") "}"]))
assert(Equal t-min (rt t-min))

(define t-full
  (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") ","
           (kv "count" "3") ","
           (kv "tags" (strcat ["[" (js "x") "," (js "y") "]"])) ","
           (kv "peer" (strcat ["{" (kv "host" (js "h")) "," (kv "port" "80") "}"])) ","
           (kv "hue" (js "red")) "}"]))
assert(Equal t-full (rt t-full))

;; whitespace and key order normalize to the declaration order
(define t-sloppy
  (strcat ["{ " (kv "done" "true") " , " (kv "name" (js "a")) " }"]))
assert(Equal t-min (rt t-sloppy))

;;; Decode failures carry field-path breadcrumbs.

assert(Equal "name:missing" (rt (strcat ["{" (kv "done" "true") "}"])))
assert(Equal "peer.port:missing"
  (rt (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") ","
               (kv "peer" (strcat ["{" (kv "host" (js "h")) "}"])) "}"])))
assert(Equal "name:expected-string"
  (rt (strcat ["{" (kv "name" "1") "," (kv "done" "true") "}"])))
assert(Equal "count:negative"
  (rt (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") ","
               (kv "count" "-1") "}"])))
assert(Equal "tags[1]:expected-string"
  (rt (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") ","
               (kv "tags" (strcat ["[" (js "x") ",2]"])) "}"])))
assert(Equal "hue:bad-enum"
  (rt (strcat ["{" (kv "name" (js "a")) "," (kv "done" "true") ","
               (kv "hue" (js "blue")) "}"])))
assert(Equal "expected-key" (rt "{,}"))

;;; Typed access on the generated record.

(define parse-task (foil:source-entry-val ["parse_task"] gsut))
(define pr (parse-task t-full))
assert(Equal "/boot/task_r/ok" (Hd pr))

;;; The generated tree is normalized rex, never text.

(define gtree (_1 g))
assert(IsApp gtree)

;;; Unsupported schema shapes are rejected loudly.

(define (gen-fails schema)
  (define r (Try (lambda (z) (schemagen:gen-tree jsut schema)) 0))
  (If (Eq 1 (Hd r)) (Ix 1 (_0 r)) 0))

assert(Equal "float-unsupported (no honest representation yet)"
  (gen-fails
    (strcat ["{" (kv "title" (js "t")) "," (kv "type" (js "object")) ","
             (kv "properties"
               (strcat ["{" (kv "x" (strcat ["{" (kv "type" (js "number")) "}"])) "}"]))
             "}"])))
assert(Equal "missing-title"
  (gen-fails (strcat ["{" (kv "type" (js "object")) "}"])))
assert(Equal "reserved-name"
  (gen-fails
    (strcat ["{" (kv "title" (js "parse")) "," (kv "type" (js "object")) ","
             (kv "properties"
               (strcat ["{" (kv "x" (strcat ["{" (kv "type" (js "string")) "}"])) "}"]))
             "}"])))

(print "foil-schemagen tests passed")

;;; Swagger: the petstore fixture -> generated types + hand modules,
;;; the hand's take/hear driven by pure laws.  The law driver is a
;;; foil module (request values MUST be constructed in foil: rvr-built
;;; variant applications do not match foil pail-matches), compiled
;;; from embedded text against a cache holding the two generated
;;; modules (the cached chain is compile-swagger-hand's shape, kept
;;; open here so the driver can join the same cache).

(define (sw-commas xs)
  (Ifz (Sz xs) ""
    (foldl (lambda (acc x) (strcat [acc "," x])) (_0 xs) (drop 1 xs))))
(define (jobj pairs) (strcat ["{" (sw-commas pairs) "}"]))
(define (jarr xs) (strcat ["[" (sw-commas xs) "]"]))
(define (jref d) (jobj [(kv "$ref" (js (strcat ["#/definitions/" d])))]))
(define jint (jobj [(kv "type" (js "integer"))]))
(define jstr (jobj [(kv "type" (js "string"))]))

(define (sw-op opid params resp)
  (jobj [(kv "operationId" (js opid))
         (kv "parameters" (jarr params))
         (kv "responses"
           (jobj [(kv "200" (jobj [(kv "schema" (jref resp))]))]))]))

(define swagger-txt
  (jobj
    [(kv "swagger" (js "2.0"))
     (kv "info" (jobj [(kv "title" (js "petstore"))
                       (kv "version" (js "1.0.0"))]))
     (kv "basePath" (js "/v1"))
     (kv "paths"
       (jobj
         [(kv "/pets/{pet_id}"
            (jobj [(kv "get"
                     (sw-op "get_pet"
                       [(jobj [(kv "name" (js "pet_id")) (kv "in" (js "path"))
                               (kv "required" "true") (kv "type" (js "integer"))])]
                       "pet"))]))
          (kv "/pets"
            (jobj [(kv "get"
                     (sw-op "list_pets"
                       [(jobj [(kv "name" (js "limit")) (kv "in" (js "query"))
                               (kv "required" "false") (kv "type" (js "integer"))])]
                       "pets"))
                   (kv "post"
                     (sw-op "make_pet"
                       [(jobj [(kv "name" (js "new_pet")) (kv "in" (js "body"))
                               (kv "required" "true")
                               (kv "schema" (jref "new_pet"))])]
                       "pet"))]))]))
     (kv "definitions"
       (jobj
         [(kv "pet"
            (jobj [(kv "type" (js "object"))
                   (kv "required" (jarr [(js "id") (js "name")]))
                   (kv "properties"
                     (jobj [(kv "id" jint) (kv "name" jstr) (kv "tag" jstr)
                            (kv "kind" (jref "kind"))]))]))
          (kv "new_pet"
            (jobj [(kv "type" (js "object"))
                   (kv "required" (jarr [(js "name")]))
                   (kv "properties" (jobj [(kv "name" jstr) (kv "tag" jstr)]))]))
          (kv "kind"
            (jobj [(kv "enum" (jarr [(js "cat") (js "dog") (js "bird")]))]))
          (kv "pets"
            (jobj [(kv "type" (js "object"))
                   (kv "required" (jarr [(js "items")]))
                   (kv "properties"
                     (jobj [(kv "items"
                              (jobj [(kv "type" (js "array"))
                                     (kv "items" (jref "pet"))]))]))]))]))]))

(define sw-tnt (schemagen:gen-swagger-types jsut swagger-txt))
assert(Equal "petstore" (_0 sw-tnt))
(define sw-hnt (schemagen:gen-swagger-hand jsut swagger-txt))
assert(Equal "petstore_hand" (_0 sw-hnt))
assert(IsApp (_1 sw-hnt))

(define nl 10)
(define (sw-unlines ls)
  (strcat (foldl (lambda (acc l) (Weld acc [l nl])) [] ls)))

(define sw-driver-txt
  (sw-unlines
    ["-  sept [order=10]"
     "-  shrine_types [order=20]"
     "-  lain [order=30]"
     "-  bond [order=40]"
     "-  petstore [order=50]"
     "-  petstore_hand [order=60]"
     "'  Pure-law driver for the generated petstore hand: build bowls"
     "'  and gifts by hand, drive take and hear directly, and surface"
     "'  simple values for the rvr suite to assert on."
     "+  t_root"
     "  '  Test root record: base url + injected http crew."
     "  ^  myth"
     "  .  (myth/new)"
     (strcat ["     put(['base] (pails/t " (js "http://m") "))"])
     "     put(bond/crew (cpail (crew/sing ['http] (dep (care/x) ['io 'http]))))"
     "+  t_bowl"
     "  '  Test bowl: one pending request kid at [r1]."
     "  \  rq=pail"
     "  ^  bowl"
     "  (bowl ['u] ['api] 0 0"
     "    (axal/new[myth] .none).put(['r1] (myth/sing bond/req rq))"
     "    (mop/empty))"
     "+  t_lim"
     "  '  0 = no limit (the maybe is constructed in foil)."
     "  \  lim=nat"
     "  ^  maybe[nat]"
     "  ?  (eq lim 0)"
     "     .none"
     "  (./some lim)"
     "+  t_take_url"
     "  '  Drive take with one get_pet request; the fetch card's ['url]."
     "  \  pet_id=nat"
     "  ^  nat"
     "  =  rq    (req/get_pet pet_id)"
     "  =  gift  (axal/new[mode] .none).put(['r1] (mode/add))"
     "  =  y     (take (t_bowl rq) t_root gift)"
     "  ?  (eq 1 y.cards.len)"
     "     =  [cp=path cq=writ]  y.cards.at(0)"
     "     ?  cq"
     "      > w=writ/make"
     "        ?  w.myth.get(['url])"
     "         > (./some up=pail)"
     "           ?  up"
     "            > n=pails/n  n.n"
     "           0"
     "         0"
     "      0"
     "  0"
     "+  t_take_list_url"
     "  '  list_pets with and without the optional limit (0 = none)."
     "  \  lim=nat"
     "  ^  nat"
     "  =  rq    (req/list_pets (t_lim lim))"
     "  =  gift  (axal/new[mode] .none).put(['r1] (mode/add))"
     "  =  y     (take (t_bowl rq) t_root gift)"
     "  ?  (eq 1 y.cards.len)"
     "     =  [cp=path cq=writ]  y.cards.at(0)"
     "     ?  cq"
     "      > w=writ/make"
     "        ?  w.myth.get(['url])"
     "         > (./some up=pail)"
     "           ?  up"
     "            > n=pails/n  n.n"
     "           0"
     "         0"
     "      0"
     "  0"
     "+  t_take_post"
     "  '  make_pet: the fetch card's ['method] and ['body]."
     "  \  nm=nat"
     "  ^  row[nat]"
     "  =  rq    (req/make_pet (new_pet nm .none))"
     "  =  gift  (axal/new[mode] .none).put(['r1] (mode/add))"
     "  =  y     (take (t_bowl rq) t_root gift)"
     "  ?  (eq 1 y.cards.len)"
     "     =  [cp=path cq=writ]  y.cards.at(0)"
     "     ?  cq"
     "      > w=writ/make"
     "        =  gv"
     "             \  s=path"
     "             ^  nat"
     "             ?  w.myth.get(s)"
     "              > (./some vp=pail)"
     "                ?  vp"
     "                 > n=pails/n  n.n"
     "                0"
     "              0"
     "        [(gv ['method]) (gv ['body])]"
     "      []"
     "  []"
     "+  t_take_card_ok"
     "  '  1 when the make-card lands at the http client's fetch path."
     "  \  pet_id=nat"
     "  ^  nat"
     "  =  rq    (req/get_pet pet_id)"
     "  =  gift  (axal/new[mode] .none).put(['r1] (mode/add))"
     "  =  y     (take (t_bowl rq) t_root gift)"
     "  ?  (eq 1 y.cards.len)"
     "     =  [cp2=path cq2=writ]  y.cards.at(0)"
     "     (eq_pith cp2 ['io 'http 'r1])"
     "  0"
     "+  t_hear_res"
     "  '  Drive hear after a completed fetch; the bond/res pail poked back."
     "  \  pet_id=nat okf=nat body=nat"
     "  ^  maybe[pail]"
     "  =  rq     (req/get_pet pet_id)"
     "  =  root0  t_root"
     "  =  gift   (axal/new[mode] .none).put(['r1] (mode/add))"
     "  =  y1     (take (t_bowl rq) root0 gift)"
     "  =  fnode"
     "       .  (myth/new)"
     "          put(['res_done] (pd 1))"
     "          put(['res_ok] (pd okf))"
     "          put(['res_body] (pd body))"
     "          put(['res_err] (pd 2))"
     "  =  b2"
     "       (bowl ['u] ['api] 1 0"
     "         (axal/new[myth] .none).put(['r1] (myth/sing bond/req rq))"
     "         (mop/sing[path axal[myth] lt_pith] ['r1] (axal/new[myth] (./some fnode))))"
     "  =  y2  (hear b2 y1.out [(dep (care/x) ['io 'http 'r1])])"
     "  ?  (eq 1 y2.cards.len)"
     "     =  [cp3=path cq3=writ]  y2.cards.at(0)"
     "     ?  cq3"
     "      > w=writ/poke"
     "        w.myth.get(bond/res)"
     "      .none"
     "  .none"]))

(define sw-c1
  (foil:compile-rex-cached 0 foil:default-subject "petstore" (Ix 3 sw-tnt)))
(define sw-c2
  (foil:compile-rex-cached (_0 sw-c1) foil:default-subject "petstore_hand"
    (_1 sw-hnt)))
(define sw-c3
  (foil:compile-rex-cached (_0 sw-c2) foil:default-subject "petstore_laws"
    (rex:ParseRexNormFile sw-driver-txt)))
(define sw-sut (_1 sw-c3))
(define (sw-law nm) (foil:source-entry-val [nm] sw-sut))

assert(Equal "http://m/v1/pets/7" ((sw-law "t_take_url") 7))
assert(Equal "http://m/v1/pets" ((sw-law "t_take_list_url") 0))
assert(Equal "http://m/v1/pets?limit=5" ((sw-law "t_take_list_url") 5))
assert(Equal ["POST" (jobj [(kv "name" (js "x"))])]
  ((sw-law "t_take_post") 120))
assert(Equal 1 ((sw-law "t_take_card_ok") 7))

(define sw-petjson (jobj [(kv "id" "7") (kv "name" (js "rex"))]))
(define sw-hok ((sw-law "t_hear_res") 7 1 sw-petjson))
assert(Equal "/boot/maybe/some" (Hd sw-hok))
assert(Equal "/boot/pet_r/ok" (Hd (Ix 0 sw-hok)))
assert(Equal "/boot/pet" (Hd (Ix 0 (Ix 0 sw-hok))))
assert(Equal 7 (Ix 0 (Ix 0 (Ix 0 sw-hok))))
assert(Equal "rex" (Ix 1 (Ix 0 (Ix 0 sw-hok))))
(define sw-herr ((sw-law "t_hear_res") 7 0 sw-petjson))
assert(Equal "/boot/maybe/some" (Hd sw-herr))
assert(Equal "/boot/pet_r/err" (Hd (Ix 0 sw-herr)))
assert(Equal "fetch-err-2" (Ix 1 (Ix 0 sw-herr)))

;;; OpenAPI 3.1: dialect, name normalization, slicing, coverage ratchet.
;;;
;;; The fixture is the WHOLE 1.7MB OpenRouter document — 713 schemas,
;;; 89 operations.  It used to be a hand-cut slice, because json.foil
;;; walked a cord by dividing it once per byte and a full parse never
;;; finished; scanning by index made it 1.6s, so the workaround and
;;; its tool are gone.

;;; A. name normalization is a mapping, and must be injective.

assert(Equal "aabenchmark_entry" (schemagen:sg-norm-name "AABenchmarkEntry"))
assert(Equal "job_id" (schemagen:sg-norm-name "jobId"))
assert(Equal "chat_request" (schemagen:sg-norm-name "ChatRequest"))
assert(Equal "base64_image" (schemagen:sg-norm-name "Base64Image"))
assert(Equal "text_event_stream" (schemagen:sg-norm-name "text/event-stream"))
assert(Equal "gpt_4" (schemagen:sg-norm-name "gpt-4"))
assert(Equal "already_snake" (schemagen:sg-norm-name "already_snake"))
;; idempotent: normalizing an already-normal name changes nothing
assert(Equal "job_id" (schemagen:sg-norm-name (schemagen:sg-norm-name "jobId")))
;; a collision is an error, never a silent merge
(define (names-fail xs)
  (define r (Try (lambda (z) (schemagen:sg-name-map xs)) 0))
  (If (Eq 1 (Hd r)) (Ix 1 (_0 r)) 0))
assert(Equal 0 (names-fail ["Foo" "Bar"]))
assert(Equal "name-collision after normalization" (names-fail ["fooBar" "FooBar"]))

;;; B. the Swagger 2.0 dialect still reads (the petstore path above).

(define sw-v (schemagen:sg-schema-value jsut swagger-txt))
assert(Equal [0 "petstore" "/v1" 4 3] (schemagen:spec-summary sw-v))
assert(Equal ["get_pet" "list_pets" "make_pet"]
  (schemagen:dedupe-eq (schemagen:spec-opids sw-v)))
assert(Equal ["pet" "kind"] (schemagen:spec-slice sw-v ["get_pet"]))
;; naming an operation that does not exist is an error, not an empty slice
(define (slice-fail ids)
  (define r (Try (lambda (z) (schemagen:spec-slice sw-v ids)) 0))
  (If (Eq 1 (Hd r)) (Ix 1 (_0 r)) 0))
assert(Equal "no such operationId" (slice-fail ["nope"]))

;;; C. the OpenAPI 3.1 dialect reads: components.schemas, servers[0].url,
;;;    responses.200.content["application/json"].schema.

(define oa-v (schemagen:sg-schema-value jsut
               (read-text-file "spec/openrouter.json")))
assert(Equal [1 "open_router_api" "https://openrouter.ai/api/v1" 713 89]
  (schemagen:spec-summary oa-v))
(define oa-ids (schemagen:spec-opids oa-v))
assert(Equal 89 (Sz oa-ids))
;; camelCase operationIds arrive normalized
assert(Eq 1 (includes (Eq "get_models") oa-ids))
assert(Eq 1 (includes (Eq "send_chat_completion_request") oa-ids))

;;; Slicing: a client wants a few operations, not 713 schemas (~2100
;;; generated top-levels, all of which a module load forces).
assert(Equal 20 (Sz (schemagen:spec-slice oa-v ["get_models"])))
assert(Equal 132 (Sz (schemagen:spec-slice oa-v ["send_chat_completion_request"])))
;; these two share nothing — model metadata and chat traffic are
;; separate type families — so their union is exactly the sum
assert(Equal 152 (Sz (schemagen:spec-slice oa-v
                       ["get_models" "send_chat_completion_request"])))
;; and either way a slice is a small fraction of the whole
assert(Eq 1 (Lt 152 713))

;;; D. THE RATCHET.  How many named schemas the typedef IR can express.
;;; This number may only go UP.  Raise it when a phase lands; never
;;; lower it to make a change pass.

(define oa-cov (schemagen:spec-coverage oa-v))
assert(Equal 713 (Ix 1 oa-cov))
assert(Eq 1 (Ge (_0 oa-cov) 116))

;;; The rejections are the Phase 1 worklist, and each must name its
;;; own feature — a nullable type union is not a malformed string.
(define oa-whys (schemagen:dedupe-eq (map (lambda (b) (Ix 1 b)) (Ix 2 oa-cov))))
(define (why? w) (includes (Eq w) oa-whys))
assert(Eq 1 (why? "nullable-type-union (type: [T,null])"))
assert(Eq 1 (why? "float-unsupported (no honest representation yet)"))
assert(Eq 1 (why? "inline-object (hoist to $defs)"))
