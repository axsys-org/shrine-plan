(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))


;;; Constructors and canonicalization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define nat (ty:TNAT 0))
(define nat-const (ty:TNAT 7))
(define tvar-a (ty:TVAR "a"))
(define tvar-b (ty:TVAR "b"))
(define anon-pair (ty:TROW 0 [nat nat]))
(define anon-none (ty:TROW "none" []))

assert(Equal nat (ty:TNAT 0))
assert(Equal ty:TBOT (ty:TSUM [ty:TBOT]))
assert(Equal nat (ty:TSUM [ty:TBOT nat]))
assert(Equal
  (ty:TSUM [(ty:TNAT 1) (ty:TNAT 2)])
  (ty:TSUM [(ty:TNAT 2) (ty:TNAT 1)]))

assert(Equal 0 (ty:trow-cstr anon-pair))
assert(Equal [nat nat] (ty:trow-vals anon-pair))


;;; Substitution ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Equal nat
  (ty:subst-type "a" nat tvar-a))

assert(Equal tvar-b
  (ty:subst-type "a" nat tvar-b))

assert(Equal
  (ty:TFUN [nat] nat)
  (ty:subst-type "a" nat (ty:TFUN [tvar-a] tvar-a)))

assert(Equal
  (ty:TQUA "a" tvar-a)
  (ty:subst-type "a" nat (ty:TQUA "a" tvar-a)))

assert(Equal
  (ty:TROW "pair" [nat])
  (ty:subst-type "a" nat (ty:TROW "pair" [tvar-a])))

assert(Equal
  (ty:TPIN nat)
  (ty:subst-type "a" nat (ty:TPIN tvar-a)))

;; Tags without type children survive substitution unchanged (the old
;; fallthrough replaced them with a stray Either value).

assert(Equal ty:TANY (ty:subst-type "a" nat ty:TANY))
assert(Equal ty:TBOT (ty:subst-type "a" nat ty:TBOT))
assert(Equal ty:TBAD (ty:subst-type "a" nat ty:TBAD))

;; ...and tags with children recurse through them.

assert(Equal (ty:TSELF nat)
  (ty:subst-type "a" nat (ty:TSELF tvar-a)))
assert(Equal (ty:TTYP nat)
  (ty:subst-type "a" nat (ty:TTYP tvar-a)))


;;; Mold/span conversion ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define point-cstr (print-path ["point"]))
(define point-span (ty:TROW point-cstr [nat nat]))
(define point-sut
  (ty:insert-typ ["point"] wack-span (ty:TROW 0 [nat nat]) empty-subject))
(define raw-point-sut
  (insert-tc ["point"] wack-span
    (tc-typ (ty:TTYP (ty:TROW 0 [nat nat])))
    empty-subject))
(define mixed-point-sut
  (ty:insert-typ ["point"] wack-span (ty:TROW 0 [nat nat])
    (insert-ffi ["inc"] Inc (ty:TFUN [nat] nat) empty-subject)))

assert(Equal point-span
  (got-type ["point"] point-sut))

assert(Equal point-span
  (ty:mold-to-span point-sut (ty:TNOM ["point"] 0)))

assert(Equal (ty:TNOM ["point"] 0)
  (ty:span-to-mold point-sut point-span))

assert(Equal point-span
  (ty:mold-to-span raw-point-sut (ty:TNOM ["point"] 0)))

assert(Equal (ty:TNOM ["point"] 0)
  (ty:span-to-mold raw-point-sut point-span))

assert(Equal (ty:TNOM ["point"] 0)
  (ty:span-to-mold mixed-point-sut point-span))


;;; Application and lattice operations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define id-fun (ty:TQUA "a" (ty:TFUN [tvar-a] tvar-a)))
(define unpin-fun (ty:TQUA "a" (ty:TFUN [(ty:TPIN tvar-a)] tvar-a)))
(define nat-to-nat (ty:TFUN [nat] nat))
(define pin-nat (ty:TPIN nat))
(define pin-nat-to-nat (ty:TPIN nat-to-nat))
(define faced-nat-to-nat
  (ty:TFUN [(ty:TFAC "x" nat)] nat))
(define expects-faced-nat-to-nat
  (ty:TFUN [(ty:TFAC "fun" nat-to-nat) nat] nat))

assert(Equal (ty:TFUN [nat] nat)
  (ty:type-specialize 0 id-fun [nat]))

assert(Equal nat
  (ty:type-apply 0 (ty:type-specialize 0 id-fun [nat]) [nat]))

assert(Equal nat
  (ty:type-apply 0 (ty:type-specialize 0 unpin-fun [nat]) [pin-nat]))

assert(Equal nat
  (ty:type-apply 0 nat-to-nat [nat]))

assert(Equal
  (ty:TFUN [nat] nat)
  (ty:type-apply 0 (ty:TFUN [nat nat] nat) [nat]))

assert(Equal nat
  (ty:type-join 0 nat nat))

assert(Equal nat
  (ty:type-join 0 nat nat-const))

assert(Equal nat
  (ty:type-join 0 (ty:TFAC "a" nat) (ty:TFAC "default" nat)))

assert(Equal nat
  (ty:type-join 0 ty:TBOT nat))

assert(Equal nat
  (ty:type-meet 0 nat nat))

;; (TNAT 7) nests inside (TNAT 0), so their meet is the constant, and
;; the meet is commutative.

assert(Equal nat-const
  (ty:type-meet 0 nat nat-const))
assert(Equal nat-const
  (ty:type-meet 0 nat-const nat))
assert(Equal ty:TBOT
  (ty:type-meet 0 nat-const (ty:TNAT 8)))

;; Lattice laws w.r.t. type-nests?: meets are lower bounds, joins are
;; upper bounds.

assert(ty:type-nests? 0 nat (ty:type-meet 0 nat nat-const))
assert(ty:type-nests? 0 nat-const (ty:type-meet 0 nat nat-const))
assert(ty:type-nests? 0 (ty:type-join 0 nat nat-const) nat)
assert(ty:type-nests? 0 (ty:type-join 0 nat nat-const) nat-const)
assert(Equal
  (ty:type-join 0 anon-none anon-pair)
  (ty:type-join 0 anon-pair anon-none))
assert(ty:type-nests? 0 (ty:type-join 0 anon-none anon-pair) anon-none)
assert(ty:type-nests? 0 (ty:type-join 0 anon-none anon-pair) anon-pair)

;; A sum offers each option once: duplicates collapse.

assert(Equal
  (ty:TSUM [anon-none anon-pair])
  (ty:TSUM [anon-pair anon-none anon-pair]))
assert(Equal anon-pair (ty:TSUM [anon-pair anon-pair]))

;; TANY (the dynamic type) refines away in meets and absorbs in joins.

assert(Equal nat (ty:type-meet 0 ty:TANY nat))
assert(Equal nat (ty:type-meet 0 nat ty:TANY))
assert(Equal ty:TANY (ty:type-join 0 ty:TANY nat))
assert(Equal ty:TANY (ty:type-join 0 nat ty:TANY))

;; Function variance: arguments contravariant, returns covariant.

assert(ty:type-nests? 0 (ty:TFUN [nat-const] nat) (ty:TFUN [nat] nat))
assert(Nil (ty:type-nests? 0 (ty:TFUN [nat] nat) (ty:TFUN [nat-const] nat)))
assert(ty:type-nests? 0 (ty:TFUN [nat] nat) (ty:TFUN [nat] nat-const))
assert(Nil (ty:type-nests? 0 (ty:TFUN [nat] nat-const) (ty:TFUN [nat] nat)))

assert(Equal (ty:TNOM ["point"] 0)
  (ty:type-join point-sut (ty:TNOM ["point"] 0) point-span))

assert(ty:type-nests? 0 ty:TANY nat)
assert(ty:type-nests? 0 nat ty:TANY)
assert(ty:type-nests? 0 nat nat)
assert(ty:type-nests? 0 pin-nat pin-nat)
assert(Nil (ty:type-nests? 0 nat pin-nat))
assert(Nil (ty:type-nests? 0 pin-nat nat))
assert(ty:type-nests? 0 nat-to-nat pin-nat-to-nat)
assert(ty:type-nests? 0 pin-nat-to-nat nat-to-nat)
assert(Equal nat
  (ty:type-apply 0 pin-nat-to-nat [nat]))
assert(Equal (ty:TFUN [nat] nat)
  (ty:type-apply 0 expects-faced-nat-to-nat [faced-nat-to-nat]))
assert(ty:type-nests? point-sut (ty:TNOM ["point"] 0) point-span)
assert(Nil (ty:type-nests? point-sut (ty:TNOM ["point"] 0) anon-pair))
assert(Nil (ty:type-nests? point-sut anon-pair (ty:TNOM ["point"] 0)))


;;; Runtime fit checks ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Equal 0
  (ty:type-fits 0 nat 3))

assert(Equal 0
  (ty:type-fits 0 pin-nat (Pin 3)))

assert(Nil (Equal 0
  (ty:type-fits 0 nat (Pin 3))))

(define id-law (Law 1 "id" 1))
assert(Equal 0
  (ty:type-fits 0 nat-to-nat id-law))

assert(Equal 0
  (ty:type-fits 0 nat-to-nat (Pin id-law)))

assert(Equal 0
  (ty:type-fits 0 pin-nat-to-nat (Pin id-law)))

assert(Nil (Equal 0
  (ty:type-fits 0 nat [3])))

assert(Equal 0
  (ty:type-fits 0 anon-pair [3 4]))

assert(Nil (Equal 0
  (ty:type-fits 0 anon-pair [3])))

assert(Equal 0
  (ty:type-fits 0 anon-none "none"))

assert(Equal 0
  (ty:type-fits point-sut (ty:TNOM ["point"] 0) (point-cstr 3 4)))

assert(Nil (Equal 0
  (ty:type-fits point-sut (ty:TNOM ["point"] 0) [3 4])))


;;; Well-formedness: /ty-ap refs, sum option keys, generic arity ;;;;;;;;;;;;;;;;

(define wf-nat-sut
  (ty:insert-typ ["nat"] wack-span (ty:TNAT 0) empty-subject))
(define wf-box-sut
  (ty:insert-typ ["box"] wack-span
    (ty:TQUA "v" (ty:TROW 0 [(ty:TVAR "v")]))
    wf-nat-sut))

(define (wf-nom paths)
  (ty:check-type-wf wf-box-sut (ty:TNOM (ty-ap-encode paths) 0)))

assert(Eq "right" (Hd (ty:check-type-wf wf-box-sut (ty:TNOM ["nat"] 0))))
assert(Eq "right" (Hd (wf-nom [["box"] ["nat"]])))
assert(Eq "left" (Hd (ty:check-type-wf wf-box-sut (ty:TNOM ["bogus"] 0))))
assert(Eq "left" (Hd (wf-nom [["box"] ["bogus"]])))
assert(Eq "left" (Hd (wf-nom [["box"] ["nat"] ["nat"]])))
assert(Eq "left" (Hd (wf-nom [["box"]])))
assert(Eq "left" (Hd (wf-nom [["box"] [ty-var-tag "q"]])))
;; Under a binder the same ty-var argument is well-formed.
assert(Eq "right"
  (Hd (ty:check-type-wf wf-box-sut
    (ty:TQUA "q" (ty:TNOM (ty-ap-encode [["box"] [ty-var-tag "q"]]) 0)))))

;; The TVAR check itself: unbound vs TQUA-bound.
assert(Eq "left" (Hd (ty:check-type-wf empty-subject (ty:TVAR "a"))))
assert(Eq "right"
  (Hd (ty:check-type-wf empty-subject (ty:TQUA "a" (ty:TVAR "a")))))

;; Sum options that agree on constructor+arity are unmatchable at runtime.
assert(Eq "left"
  (Hd (ty:check-type-wf empty-subject
    (ty:TSUM [(ty:TROW "some" [nat]) (ty:TROW "some" [nat-const])]))))
assert(Eq "right"
  (Hd (ty:check-type-wf empty-subject
    (ty:TSUM [(ty:TROW "some" [nat]) (ty:TROW "some" [])]))))

;; count-tqua: generic arity, skipping faces.
assert(Eq 0 (ty:count-tqua nat))
assert(Eq 2 (ty:count-tqua (ty:TQUA "a" (ty:TQUA "b" nat))))
assert(Eq 1 (ty:count-tqua (ty:TFAC "f" (ty:TQUA "a" nat))))

;;; Lattice properties ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Executable laws over an enumerated corpus — the regression net for
;; the next span-roundtrip disease.  Laws hold up to spans (molds keep
;; nominal names; the lattice operates on structure).

(define prop-sut
  (ty:insert-typ ["plist"] wack-span
    (ty:TQUA "v"
      (ty:TSUM
        [(ty:TROW "pnil" [])
         (ty:TROW "pcons"
           [(ty:TVAR "v")
            (ty:TNOM (ty-ap-encode [["plist"] [ty-var-tag "v"]]) 0)])]))
    (ty:insert-typ ["pbox"] wack-span
      (ty:TQUA "v" (ty:TROW 0 [(ty:TVAR "v")]))
      (ty:insert-typ ["pair"] wack-span (ty:TROW 0 [nat nat])
        (ty:insert-typ ["nat"] wack-span (ty:TNAT 0) empty-subject)))))

(define prop-types
  [nat
   nat-const
   (ty:TNOM ["nat"] 0)
   (ty:TNOM ["pair"] 0)
   (ty:TNOM (ty-ap-encode [["pbox"] ["nat"]]) 0)
   (ty:TNOM (ty-ap-encode [["plist"] ["nat"]]) 0)
   (ty:TROW "some" [nat])
   (ty:TROW "none" [])
   (ty:TSUM [(ty:TROW "some" [nat]) (ty:TROW "none" [])])
   (ty:TFUN [nat] nat)
   (ty:TARR nat)
   (ty:TFAC "f" nat)
   (ty:TPIN nat)
   ty:TANY
   ty:TBOT])

(define (prop-span t) (ty:mold-to-span prop-sut t))
(define (all-types f) (all f prop-types))
(define (all-pairs f)
  (all (lambda (a) (all (f a) prop-types)) prop-types))

;; nests? is reflexive
assert(all-types (lambda (a) (ty:type-nests? prop-sut a a)))

;; join and meet commute, up to spans
assert(all-pairs (lambda (a b)
  (Equal (prop-span (ty:type-join prop-sut a b))
         (prop-span (ty:type-join prop-sut b a)))))
assert(all-pairs (lambda (a b)
  (Equal (prop-span (ty:type-meet prop-sut a b))
         (prop-span (ty:type-meet prop-sut b a)))))

;; join and meet are idempotent, up to spans
assert(all-types (lambda (a)
  (Equal (prop-span (ty:type-join prop-sut a a)) (prop-span a))))
assert(all-types (lambda (a)
  (Equal (prop-span (ty:type-meet prop-sut a a)) (prop-span a))))

;; join is an upper bound of both arguments
assert(all-pairs (lambda (a b)
  (And (ty:type-nests? prop-sut (ty:type-join prop-sut a b) a)
    (ty:type-nests? prop-sut (ty:type-join prop-sut a b) b))))

;; meet is a lower bound of both arguments
assert(all-pairs (lambda (a b)
  (And (ty:type-nests? prop-sut a (ty:type-meet prop-sut a b))
    (ty:type-nests? prop-sut b (ty:type-meet prop-sut a b)))))

;; bot is the join identity, up to spans
assert(all-types (lambda (a)
  (Equal (prop-span (ty:type-join prop-sut ty:TBOT a)) (prop-span a))))

;; mold -> span -> mold -> span is stable (name recovery roundtrip)
assert(all-types (lambda (a)
  (Equal (prop-span (ty:span-to-mold prop-sut (prop-span a)))
         (prop-span a))))


;;; /ty-ap name recovery ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The strong law: an instantiation's expansion recovers its mold.

(define pbox-nat-mold (ty:TNOM (ty-ap-encode [["pbox"] ["nat"]]) 0))
(define plist-nat-mold (ty:TNOM (ty-ap-encode [["plist"] ["nat"]]) 0))
assert(Equal pbox-nat-mold
  (ty:span-to-mold prop-sut (prop-span pbox-nat-mold)))
assert(Equal plist-nat-mold
  (ty:span-to-mold prop-sut (prop-span plist-nat-mold)))

;; nested arguments: named sub-spans and recursive recovery
(define pbox-pair-mold (ty:TNOM (ty-ap-encode [["pbox"] ["pair"]]) 0))
assert(Equal pbox-pair-mold
  (ty:span-to-mold prop-sut (prop-span pbox-pair-mold)))
(define pbox-pbox-nat-mold
  (ty:TNOM (ty-ap-encode [["pbox"] (ty-ap-encode [["pbox"] ["nat"]])]) 0))
assert(Equal pbox-pbox-nat-mold
  (ty:span-to-mold prop-sut (prop-span pbox-pbox-nat-mold)))

;; negatives: recovery must not claim these
assert(Equal (ty:TROW "some" [nat])
  (ty:span-to-mold prop-sut (ty:TROW "some" [nat])))
assert(Equal (ty:TROW 0 [nat nat])
  (ty:span-to-mold prop-sut (ty:TROW 0 [nat nat])))
assert(Equal (ty:TROW "pnil" [])
  (ty:span-to-mold prop-sut (ty:TROW "pnil" [])))
;; inconsistent solve (elem says nat, recursive tail says pair)
(define bad-plist-span
  (ty:TSUM
    [(ty:TROW "pnil" [])
     (ty:TROW "pcons"
       [nat (ty:TNOM (ty-ap-encode [["plist"] ["pair"]]) 0)])]))
assert(Equal bad-plist-span
  (ty:span-to-mold prop-sut bad-plist-span))

(print "foil-types tests passed")
