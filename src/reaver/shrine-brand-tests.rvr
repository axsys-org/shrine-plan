(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind brand (#module shrine-brand))

(define p [["ts" "sys"] ["ts" "types"] ["ts" "text"]])
(define b (brand:encode p 1))
assert(Equal [[p 1]] (brand:decode b))
assert(Eq "text" (brand:member-name b))
assert(Nil (Eq b (brand:encode p 2)))
assert(Nil (Eq b (brand:encode [["x" 1] ["ts" "text"]] 1)))
assert(Nil (Eq (brand:encode [["x" 1] ["ts" "a/b"]] 1)
              (brand:encode [["x" 1] ["ts" "a"] ["ts" "b"]] 1)))
assert(Nil (Eq (brand:encode [["x" 1] ["ts" 42]] 1)
              (brand:encode [["x" 1] ["u" 42]] 1)))
assert(Equal [] (brand:decode "/boot/pails/t"))
assert(Equal [] (brand:decode 0))
assert(Equal [] (brand:decode [b]))
assert(Equal [] (brand:decode (Mul b 256)))
assert(Equal [] (brand:decode (Rsh b 8)))
assert(Equal [] (brand:decode (Dec b)))
(define bad-case (Try (lambda (z) (brand:encode p 0)) 0))
assert(Eq 1 (Hd bad-case))
(define bad-root (Try (lambda (z) (brand:encode [["ts" "boot"]] 1)) 0))
assert(Eq 1 (Hd bad-root))

;; Independently specified byte-level vector: /sys at x data case one.
assert(Eq 215056239906719952707665662443295853352195813950258124675841318387627037479930579803146955973789606449969096118698927718657
  (brand:encode [["ts" "sys"]] 1))
assert(Equal [] (brand:decode 215056239906719952707665661892611695653836183332791591054003663841617277809856037551175291457123583397147704315904014680321))

assert(Eq b (brand:encode-path [("ts" "sys") ("ts" "types") ("ts" "text")] 1))
assert(Equal [[[("ts" "sys") ("ts" "types") ("ts" "text")] 1]]
  (brand:decode-path b))

assert(Eq b (brand:value-brand b))
assert(Eq b (brand:value-brand (b 42)))
assert(Eq 0 (brand:value-brand ("cons" 42 0)))
assert(Eq 0 (brand:value-brand "/boot/types/text"))
assert(Eq 0 (brand:value-brand (Pin b)))
