(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))

;;; The jShrine app must compile as an ordinary mounted Foil app.  Lain owns
;;; Locus context and view transitions; browser code only projects this schema.

(define sut (foil:compile-mod foil:default-subject "apps/jshrine/main"))
(define (app path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) sut)))

(define manifest ((app ["app"]) 0))
(assert (IsApp manifest))

"jshrine tests passed"
