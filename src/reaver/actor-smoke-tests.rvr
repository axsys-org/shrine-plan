;;;; Minimal actor transport regression, independent of Helm/Foil/Fetch.
(#bind std (#module std))
(#import std)
(define (echo self)
  (define mc (Recv 0))
  (Send (Ix 0 (Ix 1 mc)) (Ix 0 mc)))
(define h (Spawn echo))
(define reply (Seq (SendCaps h ["hello"] [0]) (Recv 0)))
assert(Equal ["hello"] (Ix 0 reply))
(print "actor smoke tests passed")
