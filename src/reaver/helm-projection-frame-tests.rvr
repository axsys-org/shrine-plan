(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind helm-http (#module helm-http))


;;; Narrow, read-only HTTP contract for an exact projection-producer report.

(define report
  (helm-http:projection-frame-report-spec
    "/projection-frame/2/chat/desktop"))
assert(Equal [[("ts" "chat") ("ts" "desktop")]] report)
assert(Eq 1
  (helm-http:projection-frame-url?
    "/projection-frame/2/chat/desktop"))
assert(Eq 0
  (helm-http:projection-frame-url? "/projection-frames/2/chat/desktop"))
assert(Eq 0
  (helm-http:projection-frame-report-spec "/projection-frame/2/chat"))

(define no-frames-helpers
  ["H" 0 0 0 0 (lambda (path record) 0)])
(define no-producer
  (helm-http:projection-frame-res-of no-frames-helpers
    ("/boot/res/known" 1)))
assert(Eq 501 (_0 no-producer))
assert(Eq 1 (contains? "projection_producer_unavailable" (_1 no-producer)))
assert(Eq 1 (starts-with "application/problem+json" (_2 no-producer)))

(define frames-body "{\"packet\":\"chat-desktop\",\"frames\":[]}")
(define frames-helpers
  ["H" 0 0 0 0
   (lambda (path record)
     (If (Equal [("ts" "projection_frames")] path) frames-body 0))])
(define produced
  (helm-http:projection-frame-res-of frames-helpers
    ("/boot/res/known" 1)))
assert(Eq 200 (_0 produced))
assert(Equal frames-body (_1 produced))
assert(Eq 1
  (starts-with "application/vnd.shrine.projection-frames+json" (_2 produced)))

(define absent
  (helm-http:projection-frame-res-of frames-helpers
    "/boot/res/unknown"))
assert(Eq 404 (_0 absent))
assert(Eq 1 (contains? "projection_report_missing" (_1 absent)))

(print "helm projection frame tests passed")
