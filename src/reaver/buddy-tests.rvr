;;;; Compile-buddy tests — the step function is pure over the forge
;;;; state, so the tests drive it exactly the way the resident loop
;;;; does and assert on the rendered rows. Needs the actor runtime
;;;; (parallel warm) — run with: x/test buddy-tests

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind parse (#module parse))
(#import parse)

(#bind forge (#module forge))
(#bind buddy (#module buddy))

(define (rows-contain? needle rows)
  (forge:str-contains? needle (join-str (strcat [10]) rows)))

;;; Warm boot: parallel compile of every module, doctests reported ;;;;;;;;;;;;;;;;

(define warm (buddy:sync forge:empty-state))
(define b0 (buddy:bud (_0 warm) "bst"))
assert(rows-contain? "bst: " (_1 warm))
assert(rows-contain? "doctests pass" (_1 warm))
assert(rows-contain? "does not compile" (_1 warm))   ;; axal, deliberately
assert(Nil (rows-contain? "failing" (_1 warm)))

;;; Enter on a clean tree: nothing to do ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r0 (buddy:buddy-step b0 ""))
assert(rows-contain? "up to date" (_1 r0))
assert(Eq 0 (_2 r0))

;;; Bare expressions evaluate against the focus ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r1 (buddy:buddy-step (_0 r0) "(bst/got[nat] 2 0 (bst/duo[nat] 1 10 2 20))"))
assert(rows-contain? "value: 20" (_1 r1))

;; an error renders as data, the buddy survives
(define r2 (buddy:buddy-step (_0 r1) "(bst/got 1 2 3)"))
assert(rows-contain? "error" (_1 r2))
assert(Eq 0 (_2 r2))

;;; Repl variables ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define v1 (buddy:buddy-step (_0 r2) "t = (bst/duo[nat] 1 10 2 20)"))
assert(rows-contain? "t : " (_1 v1))
(define v2 (buddy:buddy-step (_0 v1) "(bst/got[nat] 2 0 t)"))
assert(rows-contain? "value: 20" (_1 v2))

;; variables can reference variables
(define v3 (buddy:buddy-step (_0 v2) "u = (bst/got[nat] 1 0 t)"))
(define v4 (buddy:buddy-step (_0 v3) "u"))
assert(rows-contain? "value: 10" (_1 v4))

;; rebinding replaces; :vars lists
(define v5 (buddy:buddy-step (_0 v4) "u = (bst/got[nat] 9 0 t)"))
(define v6 (buddy:buddy-step (_0 v5) ":vars"))
assert(rows-contain? "t : " (_1 v6))
assert(rows-contain? "u : " (_1 v6))
(define v7 (buddy:buddy-step (_0 v6) "u"))
assert(rows-contain? "value: 0" (_1 v7))

;; a failed binding leaves the variables untouched
(define v8 (buddy:buddy-step (_0 v7) "w = (bst/got 1 2 3)"))
assert(rows-contain? "error" (_1 v8))
(define v9 (buddy:buddy-step (_0 v8) "w"))
assert(rows-contain? "error" (_1 v9))

;; variables survive a resync
(define v10 (buddy:buddy-step (_0 v9) ""))
(define v11 (buddy:buddy-step (_0 v10) "(bst/got[nat] 2 0 t)"))
assert(rows-contain? "value: 20" (_1 v11))

;;; Focus switching ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r3 (buddy:buddy-step (_0 v11) ":m demo"))
assert(rows-contain? "focus: demo" (_1 r3))
(define r4 (buddy:buddy-step (_0 r3) "(point/x fst)"))
assert(rows-contain? "value: 3" (_1 r4))

;;; Browser commands ride the forge-cli handlers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r5 (buddy:buddy-step (buddy:bud (buddy:bud-fst (_0 r4)) "bst") ":ls"))
assert(rows-contain? "/bst/insert" (_1 r5))
(define r6 (buddy:buddy-step (_0 r5) ":s bst.size"))
assert(rows-contain? "type: @v {" (_1 r6))
assert(rows-contain? "referenced by:" (_1 r6))
(define r7 (buddy:buddy-step (_0 r6) ":t"))
assert(rows-contain? "passed, 0 failed" (_1 r7))

;;; Quit ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define r8 (buddy:buddy-step (_0 r7) ":q"))
assert(Eq 1 (_2 r8))

(print "buddy tests passed")
