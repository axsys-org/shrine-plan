(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module contract-source))
(#bind lower (#module contract-lower))
(#bind evm (#module contract-evm))
(#bind rp (#module restricted-plan))
(define artifact (source:compile "contracts/checked"))
assert(Equal ["executed" [0 7]] (rp:run artifact [6 7 7]))
assert(Equal ["executed" [0 0]] (rp:run artifact [(Bex 255) 2 0]))
assert(Equal ["executed" [1 2]] (rp:run artifact [(Bex 255) 2 1]))
assert(Gt (Sz (evm:compile artifact)) 0)
(define bad [[0 [1 0]] [17 [1 0]] [1 [0 1]] [1 [1 (Bex 256)]] [1 [99 0]]])
assert(all (lambda (manifest) (Eq 1 (Hd (Try lower:lower manifest)))) bad)
