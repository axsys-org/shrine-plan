(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind plangrm (#module plangrm))

;; Keep PlanGrm's optimizer and its fallback semantics in one place.  Only
;; the final vocabulary changes: operands/branch offsets remain row offsets.
(define forth-ops
  ["var" "lit" "thunk" "force" "call" 0 0 "return"
   "app" "slot" "branch" "jump" "entry" "known" "fast" "slow"])
(define (forth-emit code)
  (define (go pc)
    (If (Ge pc (Sz code)) []
      (begin
        (define op (Ix pc code))
        (define width
          (cond
            ((Or (Eq op 3) (Eq op 7)) 1)
            ((Eq op 2) (If (Eq 4 (Mod (Ix (Add pc 2) code) 8)) 5 3))
            ((Eq op 10) (Add 2 (Ix (Inc pc) code)))
            ((Or (Eq op 4) (Eq op 14)) 3)
            ((Eq op 13) 4)
            (else 2)))
        (define word (Ix op forth-ops))
        (Ifz word (error ["forth: unsupported opcode" op])
          (cons word
            (weld (take (Dec width) (drop (Inc pc) code))
              (go (Add pc width))))))))
  ["navi-forth-v1" (go 0)])
(define (forth-compiler law) (forth-emit (plangrm:compileP5 law)))
