(#bind fixture (#module foil-test-context))
;;;; Compiler cases use the production tree-fed module pipeline.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))

;; Each case gets a fresh cache and a stable module-qualified identity.
(define (compile txt)
  (foil:perc-subject (_1 (source:compile-rex (fixture:tree foil:empty-foil-cache "exec_case" (rex:ParseRexNormFile txt)) foil:empty-foil-cache "exec_case"
    (rex:ParseRexNormFile txt)))))
(define (compile-module name)
  (foil:perc-subject (_1 (source:compile (fixture:files foil:empty-foil-cache [name]) foil:empty-foil-cache name))))

;; [entry-name argument-row expected-value]; [] reads a constant.
(define (run sut rows)
  (define (one row)
    (define val (foil:source-entry-val [(_0 row)] sut))
    (define got (foldl (lambda (f arg) (f arg)) val (_1 row)))
    (If (Equal (Ix 2 row) got) 0
      (error ["exec-case-result" (_0 row) (Ix 2 row) got])))
  (DeepSeq (map one rows) 0))

(define (reject name txt)
  (define r (Try (lambda (z)
                   (let ((sut (compile txt))) (DeepSeq sut 0))) 0))
  (If (Eq 1 (Hd r)) 0
    (error ["exec-case-accepted" name])))
