;; A small stage-1 type kernel.  The central invariant is that every ground
;; generic application is a normal nominal reference: its canonical /ty-ap
;; path resolves to a TypeEntry in TypeWorld.overlays.  Encoding and decoding
;; application paths are confined to the environment boundary below.

(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind cairn (#module cairn))

(#bind newtype (#module newtype))
(#import newtype)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)


;;; Stage-1 data declarations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define FOIL_NEW_TYPE_ROOT "/foil/new-types/")

;; Var and App are template-only nodes.  A resolved monotype contains neither.
(declare-cstr TyVar FOIL_NEW_TYPE_ROOT
  [name (tnat 0)])

(declare-cstr ConstVar FOIL_NEW_TYPE_ROOT
  [name (tnat 0)])

(declare-cstr TyArg FOIL_NEW_TYPE_ROOT
  [value tany])

(declare-cstr ConstArg FOIL_NEW_TYPE_ROOT
  [value tany])

(decl-union GenericArgument TyArg ConstArg)

(declare-cstr TyApp FOIL_NEW_TYPE_ROOT
  [base (tarr (tnat 0))]
  [arguments (tarr GenericArgument)])

;; Quantification belongs to schemes, rather than the monotype spine.
(declare-cstr TyParam FOIL_NEW_TYPE_ROOT
  [name (tnat 0)])

(declare-cstr ConstParam FOIL_NEW_TYPE_ROOT
  [name (tnat 0)]
  [declared-type tany])

(decl-union SchemeParameter TyParam ConstParam)

(declare-cstr Scheme FOIL_NEW_TYPE_ROOT
  [parameters (tarr SchemeParameter)]
  [body tany])

;; One entry shape serves both declarations and materialized applications.
;; `scheme` is the declaration template.  Applied entries additionally carry
;; a saturated `body`; their scheme has no remaining parameters.
(declare-cstr TypeEntry FOIL_NEW_TYPE_ROOT
  [path (tarr (tnat 0))]
  [origin (tarr (tnat 0))]
  [arguments (tarr GenericArgument)]
  [scheme Scheme]
  [body tany]
  [runtime-brand (tnat 0)]
  [runtime-arity (tnat 0)]
  [source tany])

(declare-cstr TypeWorld FOIL_NEW_TYPE_ROOT
  [namespace tany]
  [overlays tany]
  [namespace-revision (tnat 0)]
  [unfold-cache tany]
  [subtype-cache tany])

;; A binding is deliberately explicit.  This keeps template substitution
;; local and prevents variables from leaking into namespace paths.
(declare-cstr TypeBinding FOIL_NEW_TYPE_ROOT
  [name (tnat 0)]
  [argument GenericArgument])


;;; Public constructor vocabulary ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define type-var $TyVar)
(define const-var $ConstVar)
(define type-arg $TyArg)
(define const-arg $ConstArg)
(define type-app $TyApp)
(define type-param $TyParam)
(define const-param $ConstParam)
(define scheme $Scheme)
(define type-ref $Path)

(define (mono body) ($Scheme [] body))

;; Generated dotted accessors are macros and therefore do not compose with a
;; module qualifier at call sites.  Export ordinary functional projections at
;; the module seam while continuing to use the generated declarations here.
(define ty-var-name TyVar.name)
(define const-var-name ConstVar.name)
(define ty-app-base TyApp.base)
(define ty-app-arguments TyApp.arguments)
(define scheme-parameters Scheme.parameters)
(define scheme-body Scheme.body)
(define type-entry-path TypeEntry.path)
(define type-entry-origin TypeEntry.origin)
(define type-entry-arguments TypeEntry.arguments)
(define type-entry-scheme TypeEntry.scheme)
(define type-entry-body TypeEntry.body)
(define type-entry-runtime-brand TypeEntry.runtime-brand)
(define type-entry-runtime-arity TypeEntry.runtime-arity)
(define type-entry-source TypeEntry.source)
(define world-namespace TypeWorld.namespace)
(define world-overlays TypeWorld.overlays)
(define world-revision TypeWorld.namespace-revision)
(define row-items Row.items)
(define row-cstr Row.cstr)
(define row-item-face RowItem.face)
(define row-item-value RowItem.value)
(define fun-args Fun.args)
(define fun-return Fun.return)
(define sum-options Sum.options)
(define array-item Arr.item)
(define const-value Const.value)
(define nat-aura Nat.aura)
(define type-ref-path Path.p)

(define (type-error what detail)
  (error ["foil-new-types" what detail]))

;; Thread a state value through a per-item step which returns [state item].
;; This is the calling convention used throughout this kernel and the
;; surface elaborator; thread-map replaces the hand-written fold plumbing
;; that convention otherwise forces at every call site.
(define (thread-map f state xs)
  (foldl
    (lambda (acc x)
      (let ((r (f (_0 acc) x)))
        [(_0 r) (snoc (_1 r) (_1 acc))]))
    [state []] xs))

;; Unit-qualified storage keys carry a content pin as a segment, so path
;; segments are naturals or pins.
(define (path-segment? seg) (Or (IsNat seg) (IsPin seg)))

(define (valid-path? path)
  (And (IsApp path)
    (And (Sz path) (all path-segment? path))))

(define (need-path what path)
  (unless (valid-path? path)
    (type-error what ["expected nonempty path" path])
    path))

(define (type-node-tag typ) (And (IsApp typ) (Hd typ)))
(define (type-is-tag? tag typ) (Eq tag (type-node-tag typ)))
(define (type-ref? typ) (type-is-tag? tpath-pax typ))
(define (type-var? typ) (type-is-tag? "/foil/new-types/tyvar" typ))
(define (const-var? typ) (type-is-tag? "/foil/new-types/constvar" typ))
(define (type-app? typ) (type-is-tag? "/foil/new-types/tyapp" typ))
(define (scheme? value) (type-is-tag? "/foil/new-types/scheme" value))

(define (argument-kind arg)
  (cond
    ((type-is-tag? "/foil/new-types/tyarg" arg) "type")
    ((type-is-tag? "/foil/new-types/constarg" arg) "const")
    (else (type-error "bad generic argument" arg))))

(define (parameter-kind param)
  (? SchemeParameter param
    (TyParam "type")
    (ConstParam "const")))

(define (parameter-name param)
  (? SchemeParameter param
    (TyParam [name] name)
    (ConstParam [name] name)))

;; The declared type of a const parameter (errors on a type parameter,
;; which carries none).
(define (const-param-type param)
  (? SchemeParameter param
    (TyParam (type-error "type parameter has no declared type" param))
    (ConstParam [declared-type] declared-type)))

(define (argument-value arg)
  (? GenericArgument arg
    (TyArg [value] value)
    (ConstArg [value] value)))

;; Keep tag inspection at this module boundary.  Clients such as the surface
;; elaborator and the TC lowerer should not need to know which stage-0 paxes
;; happen to implement the public type vocabulary.
(define (bottom-type? typ) (type-is-tag? tbot-pax typ))
(define (any-type? typ) (type-is-tag? tany-pax typ))
(define (pail-type? typ) (type-is-tag? tpail-pax typ))
(define (nat-type? typ) (type-is-tag? tnat-pax typ))
(define (const-type? typ) (type-is-tag? tconst-pax typ))
(define (row-item-type? typ) (type-is-tag? trow-item-pax typ))
(define (row-type? typ) (type-is-tag? trow-pax typ))
(define (sum-type? typ) (type-is-tag? tsum-pax typ))
(define (fun-type? typ) (type-is-tag? tfun-pax typ))
(define (array-type? typ) (type-is-tag? tarr-pax typ))
(define (pin-type? typ) (type-is-tag? tpin-pax typ))
(define pin-item TyPin.item)

(define (monotype? typ)
  (any (lambda (pred) (pred typ))
    [bottom-type? any-type? pail-type? nat-type? const-type?
     row-item-type? row-type? sum-type? fun-type? array-type?
     pin-type? type-ref? type-var? const-var? type-app?]))

(define (type-value? typ) (Or (scheme? typ) (monotype? typ)))

(define (scheme-const-parameter-count scm)
  (Sz (filter (lambda (p) (Eq "const" (parameter-kind p)))
        (Scheme.parameters scm))))


;;; TypeWorld and declaration insertion ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define empty-type-world
  ($TypeWorld cairn:empty-ax cairn:empty-ax 0
    cairn:empty-ax cairn:empty-ax))

(define (make-type-world namespace)
  ($TypeWorld namespace cairn:empty-ax 0
    cairn:empty-ax cairn:empty-ax))

(define (world-with-overlays world overlays)
  (TypeWorld.=overlays overlays world))

(define (world-with-unfold-cache world cache)
  (TypeWorld.=unfold-cache cache world))

(define (world-with-subtype-cache world cache)
  (TypeWorld.=subtype-cache cache world))

(define (world-clear-caches world)
  (pipe world
    (TypeWorld.=unfold-cache cairn:empty-ax)
    (TypeWorld.=subtype-cache cairn:empty-ax)))

(define (world-bump-revision world)
  (TypeWorld.=namespace-revision
    (Inc (TypeWorld.namespace-revision world)) world))

(define (world-find-direct world path)
  (define over (cairn:getax path (TypeWorld.overlays world)))
  (If over over
    (cairn:getax path (TypeWorld.namespace world))))

(define (make-type-entry path scm runtime-brand runtime-arity source)
  (need-path "bad type-entry path" path)
  (unless (scheme? scm)
    (type-error "bad type-entry scheme" scm)
    1)
  ($TypeEntry path path [] scm
    (Ifz (Sz (Scheme.parameters scm)) (Scheme.body scm) 0)
    runtime-brand runtime-arity source))

(define (insert-type-entry world entry)
  (define path (TypeEntry.path entry))
  (need-path "bad inserted path" path)
  (unless (Nil (world-find-direct world path))
    (type-error "duplicate type entry" path)
    1)
  (pipe world
    (TypeWorld.=namespace (cairn:putax path entry (TypeWorld.namespace world)))
    world-bump-revision
    world-clear-caches))

(define (declare-type world path scm runtime-brand runtime-arity source)
  (insert-type-entry world
    (make-type-entry path scm runtime-brand runtime-arity source)))

;; The surface elaborator seals all declaration names before compiling their
;; bodies.  A sealed placeholder is then refined exactly once (or repeatedly
;; by a fixed-point prototype pass) without changing its path identity.
(define (replace-type world path scm runtime-brand runtime-arity source)
  (need-path "bad replacement type path" path)
  (unless (world-find-direct world path)
    (type-error "cannot replace missing type entry" path)
    1)
  (define entry
    (make-type-entry path scm runtime-brand runtime-arity source))
  ;; Materialized applications are specializations of namespace entries, so
  ;; replacement invalidates them wholesale: an overlay interned against
  ;; this entry's placeholder (during the seal -> refine module pass) must
  ;; not survive the refinement.  They are a cache and re-materialize
  ;; lazily on lookup.
  (pipe world
    (TypeWorld.=namespace (cairn:putax path entry (TypeWorld.namespace world)))
    (TypeWorld.=overlays cairn:empty-ax)
    world-bump-revision
    world-clear-caches))

(define (type-world-entries world)
  ;; Overlays are intentionally absent: they are lookupable but second-class
  ;; for enumeration, so declaration order never becomes a cache dump.
  (rowify (cairn:tapax (TypeWorld.namespace world))))


;;; Generic arguments and canonical application paths ;;;;;;;;;;;;;;;;;;;;;;;;;

(define (binding-find name bindings)
  (define hit
    (find (lambda (binding) (Eq name (TypeBinding.name binding))) bindings))
  (And hit (_0 hit)))

(define (binding-argument name bindings)
  (define hit (binding-find name bindings))
  (unless hit
    (type-error "unbound template variable" name)
    (TypeBinding.argument hit)))

(define (argument-path arg)
  (cond
    ((type-is-tag? "/foil/new-types/tyarg" arg)
      (let ((value (TyArg.value arg)))
        (unless (type-ref? value)
          (type-error "type application argument must be a resolved Path" value)
          (Path.p value))))
    ((type-is-tag? "/foil/new-types/constarg" arg)
      ;; Literal consts ride as /ty-val segments; a path-valued const (a
      ;; comparator function) rides as a plain path part — the parameter
      ;; kind disambiguates on decode.
      (let ((value (ConstArg.value arg)))
        (cond
          ((IsNat value) [ty-val-tag value])
          ((valid-path? value) value)
          (else
            (type-error "const argument cannot ride a path" value)))))
    (else (type-error "bad application argument" arg))))

(define (application-path base arguments)
  ;; This is one of the two intentionally small /ty-ap encoding boundaries.
  (need-path "bad type application base" base)
  (ty-ap-encode (Weld [base] (map argument-path arguments))))

(define (ground-application-path? path)
  (define (ground-part? part)
    (cond
      ((ty-var-path? part) 0)
      ((ty-ap-path? part)
        (let ((nested (ty-ap-decode part)))
          (And nested (all ground-part? nested))))
      (else (valid-path? part))))
  (define parts (ty-ap-decode path))
  (And parts
    (And (Equal path (ty-ap-encode parts))
      (And (Gt (Sz parts) 1) (all ground-part? parts)))))

(define (type-bound? world path)
  (If (world-find-direct world path) 1
    (And (ty-ap-path? path) (ground-application-path? path))))

(define (arguments-match-parameters? params arguments)
  (And (Eq (Sz params) (Sz arguments))
    (all (lambda (pair)
      (Eq (parameter-kind (_0 pair)) (argument-kind (_1 pair))))
      (zip params arguments))))


;;; One central type walk ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; map-type rebuilds every type-bearing node.  Const payloads and Path values
;; are opaque.  Closure, free-variable checks, validation, and template
;; substitution below all share this vocabulary, so adding a new node cannot
;; silently leave a variable or ZeroRec under an unvisited child.
(define (map-type f typ)
  (define recur (map-type f))
  (define rebuilt
    (cond
      ((type-is-tag? trow-item-pax typ)
        (trow-item (RowItem.face typ) (recur (RowItem.value typ))))
      ((type-is-tag? trow-pax typ)
        (trow (Row.cstr typ)
          (map (lambda (item)
            (trow-item (RowItem.face item) (recur (RowItem.value item))))
            (Row.items typ))))
      ((type-is-tag? tsum-pax typ)
        (tsum (map recur (Sum.options typ))))
      ((type-is-tag? tfun-pax typ)
        (tfun (map recur (Fun.args typ)) (recur (Fun.return typ))))
      ((type-is-tag? tarr-pax typ)
        (tarr (recur (Arr.item typ))))
      ((type-is-tag? tpin-pax typ)
        (tpin (recur (TyPin.item typ))))
      ((type-app? typ)
        (type-app (TyApp.base typ)
          (map (lambda (arg)
            (? GenericArgument arg
              (TyArg [value] (type-arg (recur value)))
              (ConstArg arg)))
            (TyApp.arguments typ))))
      ;; Bot, Any, Nat, Const, Path, ZeroRec, TyVar, and ConstVar are leaves.
      (else typ)))
  (f rebuilt))

(define (type-any? pred typ)
  (define recur (type-any? pred))
  (Or (pred typ)
    (cond
      ((type-is-tag? trow-item-pax typ) (recur (RowItem.value typ)))
      ((type-is-tag? trow-pax typ)
        (any (lambda (item) (recur (RowItem.value item))) (Row.items typ)))
      ((type-is-tag? tsum-pax typ) (any recur (Sum.options typ)))
      ((type-is-tag? tfun-pax typ)
        (Or (any recur (Fun.args typ)) (recur (Fun.return typ))))
      ((type-is-tag? tarr-pax typ) (recur (Arr.item typ)))
      ((type-is-tag? tpin-pax typ) (recur (TyPin.item typ)))
      ((type-app? typ)
        (any (lambda (arg)
          (? GenericArgument arg
            (TyArg [value] (recur value))
            ;; A symbolic const argument is a ConstVar leaf; ground consts
            ;; (nats, paths) never satisfy a type predicate.
            (ConstArg [value] (pred value))))
          (TyApp.arguments typ)))
      (else 0))))

(define (resolved-type? typ)
  (Nil (type-any?
    (lambda (node)
      (Or (type-var? node)
        (Or (const-var? node)
          (Or (type-app? node)
            (type-is-tag? tzero-rec-pax node)))))
    typ)))


;;; Relocation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Rewrite every nominal path in a type value.  The rewriter receives full
;; canonical paths — including /ty-ap selectors — because relocation policy
;; (foil-relocate's qualify-canonical-path) needs the whole selector to
;; decide ownership.  Row runtime constructors are never rewritten: they are
;; runtime identity, not location.  A simple per-declaration rewriter lifts
;; to the full contract with (relocate-path plain-rewrite), which decomposes
;; /ty-ap selectors and passes /ty-val and /ty-var segments through opaquely.
(define (relocate-path rewrite path)
  (cond
    ((ty-ap-path? path)
      (let ((parts (ty-ap-decode path)))
        (unless parts
          (type-error "malformed /ty-ap path" path)
          1)
        (ty-ap-encode (map (relocate-path rewrite) parts))))
    ((ty-val-path? path) path)
    ((ty-var-path? path) path)
    (else (rewrite path))))

(define (relocate-type rewrite typ)
  (map-type
    (lambda (node)
      (cond
        ((type-ref? node)
          (type-ref (rewrite (Path.p node))))
        ((type-app? node)
          (type-app (rewrite (TyApp.base node))
            (TyApp.arguments node)))
        (else node)))
    typ))

(define (relocate-scheme rewrite scm)
  (unless (scheme? scm)
    (type-error "relocate-scheme expected a Scheme" scm)
    1)
  (scheme
    (map (lambda (param)
      (? SchemeParameter param
        (TyParam param)
        (ConstParam [name declared-type]
          (const-param name (relocate-type rewrite declared-type)))))
      (Scheme.parameters scm))
    (relocate-type rewrite (Scheme.body scm))))

(define (relocate-type-value rewrite value)
  (If (scheme? value)
    (relocate-scheme rewrite value)
    (relocate-type rewrite value)))


;;; Specialization and overlay materialization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; An argument is template while it still mentions variables (or an
;; unresolved application) and therefore cannot ride a canonical path.
(define (template-argument? arg)
  (? GenericArgument arg
    (TyArg [value] (Nil (resolved-type? value)))
    (ConstArg [value] (const-var? value))))

;; An argument rides a canonical /ty-ap path only as a resolved nominal
;; reference or a ground constant; anything else (template nodes, ground
;; structural types) keeps its application symbolic.
(define (path-ridable-argument? arg)
  (? GenericArgument arg
    (TyArg [value] (type-ref? value))
    (ConstArg [value] (Nil (const-var? value)))))

;; A parameter as its own symbolic argument, for eta-expanding a bare
;; reference to a parameterized entry: `empty` viewed inside a @v body
;; means empty[@v].
(define (parameter-template-argument param)
  (? SchemeParameter param
    (TyParam [name] (type-arg (type-var name)))
    (ConstParam [name] (const-arg (const-var name)))))

(define (bind-parameters params arguments)
  (unless (arguments-match-parameters? params arguments)
    (type-error "generic argument mismatch"
      ["parameters" params "arguments" arguments])
    1)
  (map (lambda (pair)
    ($TypeBinding (parameter-name (_0 pair)) (_1 pair)))
    (zip params arguments)))

(define (specialize-template-resolving resolve world bindings self-path typ)
  (define (recur w t)
    (specialize-template-resolving resolve w bindings self-path t))
  (define (specialize-args w arguments)
    (thread-map
      (lambda (w1 arg)
        (? GenericArgument arg
          (TyArg [value]
            (let ((r (recur w1 value)))
              [(_0 r) (type-arg (_1 r))]))
          (ConstArg [value]
            (If (const-var? value)
              (let ((bound (binding-argument (ConstVar.name value) bindings)))
                (? GenericArgument bound
                  (ConstArg [value] [w1 (const-arg value)])
                  (TyArg
                    (type-error "type argument in const position" value))))
              [w1 arg]))))
      w arguments))
  (cond
    ((type-var? typ)
      (let ((arg (binding-argument (TyVar.name typ) bindings)))
        (? GenericArgument arg
          (TyArg [value] [world value])
          (ConstArg
            (type-error "const argument used as a type variable" typ)))))
    ((const-var? typ)
      (let ((arg (binding-argument (ConstVar.name typ) bindings)))
        (? GenericArgument arg
          (ConstArg [value]
            ;; A template const argument substitutes symbolically; a
            ;; ground one becomes its singleton type.
            (If (const-var? value) [world value] [world (tconst value)]))
          (TyArg
            (type-error "type argument used as a const variable" typ)))))
    ((type-app? typ)
      (let* ((r (specialize-args world (TyApp.arguments typ)))
             (args (_1 r)))
        (If (all path-ridable-argument? args)
          (let ((path (application-path (TyApp.base typ) args)))
            (If (And self-path (Equal path self-path))
              [(_0 r) (type-ref self-path)]
              (let ((resolved (resolve (_0 r) path)))
                [(_0 resolved) (type-ref path)])))
          ;; Substitution did not produce path-ridable arguments (still
          ;; template, or ground but structural): keep the application
          ;; symbolic.  Views, runtime keys, and subtyping all work on
          ;; the symbolic form; it interns if a later specialization
          ;; grounds it nominally.
          [(_0 r) (type-app (TyApp.base typ) args)])))
    ((type-is-tag? trow-item-pax typ)
      (let ((r (recur world (RowItem.value typ))))
        [(_0 r) (trow-item (RowItem.face typ) (_1 r))]))
    ((type-is-tag? trow-pax typ)
      (let ((r
              (thread-map
                (lambda (w1 item)
                  (let ((ir (recur w1 (RowItem.value item))))
                    [(_0 ir) (trow-item (RowItem.face item) (_1 ir))]))
                world (Row.items typ))))
        [(_0 r) (trow (Row.cstr typ) (_1 r))]))
    ((type-is-tag? tsum-pax typ)
      (let ((r (thread-map recur world (Sum.options typ))))
        [(_0 r) (tsum (_1 r))]))
    ((type-is-tag? tfun-pax typ)
      (let* ((ra (thread-map recur world (Fun.args typ)))
             (rr (recur (_0 ra) (Fun.return typ))))
        [(_0 rr) (tfun (_1 ra) (_1 rr))]))
    ((type-is-tag? tarr-pax typ)
      (let ((r (recur world (Arr.item typ))))
        [(_0 r) (tarr (_1 r))]))
    ((type-is-tag? tpin-pax typ)
      (let ((r (recur world (TyPin.item typ))))
        [(_0 r) (tpin (_1 r))]))
    ((type-is-tag? tzero-rec-pax typ)
      (If self-path
        [world (type-ref self-path)]
        (type-error "ZeroRec outside a materialized entry" typ)))
    (else [world typ])))

(define (specialize-const-parameter-types resolve world params arguments)
  ;; A declared const-parameter type may be a nominal reference (the surface
  ;; elaborator emits e.g. Path ["nat"]).  The shallow fit below needs the
  ;; underlying representation, so chase references through their entries.
  (define (deref w t)
    (If (type-ref? t)
      (let ((lr (resolve w (Path.p t))))
        (unless (TypeEntry.body (_1 lr))
          (type-error "const parameter type is an unspecialized generic" t)
          1)
        (deref (_0 lr) (TypeEntry.body (_1 lr))))
      [w t]))
  ;; Parameters are ordered.  A const parameter's declared type may mention
  ;; earlier type parameters, but never later ones.
  (define (walk w done-params done-args rest-params rest-args)
    (Ifz (Sz rest-params)
      w
      (let ((param (_0 rest-params))
            (arg (_0 rest-args)))
        (? SchemeParameter param
          (TyParam
            (walk w (snoc param done-params) (snoc arg done-args)
              (drop 1 rest-params) (drop 1 rest-args)))
          (ConstParam [declared-type]
            (If (Nil (IsNat (ConstArg.value arg)))
              ;; Template const arguments defer their fit to the
              ;; grounding specialization; path-valued consts defer to
              ;; materialization, which resolves the referee.  Only
              ;; ground naturals shallow-check here.
              (walk w (snoc param done-params) (snoc arg done-args)
                (drop 1 rest-params) (drop 1 rest-args))
              (let* ((prior-bindings (bind-parameters done-params done-args))
                     (r (specialize-template-resolving resolve w
                          prior-bindings 0 declared-type))
                     (wr (deref (_0 r) (_1 r)))
                     (want (_1 wr))
                     (value (ConstArg.value arg)))
                (unless (shallow-type-fits? want value)
                  (type-error "const generic argument type mismatch"
                    ["parameter" (ConstParam.name param)
                     "expected" want "actual" value])
                  1)
                (walk (_0 wr) (snoc param done-params) (snoc arg done-args)
                  (drop 1 rest-params) (drop 1 rest-args)))))))))
  (walk world [] [] params arguments))

(define (specialize-scheme-at-resolving resolve world scm arguments self-path)
  (define params (Scheme.parameters scm))
  (unless (arguments-match-parameters? params arguments)
    (type-error "scheme specialization mismatch"
      ["parameters" params "arguments" arguments])
    1)
  (let ((checked-world
          (specialize-const-parameter-types resolve world params arguments)))
    (specialize-template-resolving resolve checked-world
      (bind-parameters params arguments) self-path (Scheme.body scm))))

(define (decode-application-arguments resolve world params parts)
  ;; This is the other /ty-ap decoding boundary.  Nothing downstream sees
  ;; path syntax; it receives ordinary GenericArgument values.
  (unless (Eq (Sz params) (Sz parts))
    (type-error "type application arity mismatch"
      ["expected" (Sz params) "actual" (Sz parts)])
    1)
  (thread-map
    (lambda (w pair)
      (define param (_0 pair))
      (define part (_1 pair))
      (? SchemeParameter param
        (TyParam
          (let ((bad-const-path (ty-val-path? part)))
            (unless (Nil bad-const-path)
              (type-error "const path supplied for type parameter" part)
              1)
            ;; Resolve nested applications now.  Plain paths are validated by
            ;; ordinary lookup as well, making bad arguments fail at the seam.
            (let ((lr (resolve w part)))
              [(_0 lr) (type-arg (type-ref part))])))
        (ConstParam
          (If (ty-val-path? part)
            [w (const-arg (Ix 1 part))]
            ;; A plain path part under a const parameter is a
            ;; path-valued const argument (a comparator function).
            [w (const-arg part)]))))
    world (zip params parts)))

(define (materialize-type-application-resolving resolve world path)
  (unless (ground-application-path? path)
    (type-error "application path must be canonical and ground" path)
    1)
  (let* ((parts (ty-ap-decode path))
         (base (_0 parts))
         (base-result (resolve world base))
         (world1 (_0 base-result))
         (generic (_1 base-result))
         (params (Scheme.parameters (TypeEntry.scheme generic)))
         (decoded
           (decode-application-arguments resolve world1 params (drop 1 parts)))
         (args (_1 decoded))
         ;; Tie the knot for recursive generics.  The body being specialized
         ;; can reach this same application through a member (map[nat] names
         ;; map/node[nat] whose fields name map[nat] again), which the
         ;; self-path short-circuit below cannot see.  Lookups made while the
         ;; body specializes must find a placeholder instead of re-entering
         ;; this materialization; the real entry overwrites it on completion.
         ;; The placeholder body is a self-reference: mid-specialization only
         ;; `resolve` touches this entry, never a view of its body.
         (placeholder
           ($TypeEntry path base args (mono (type-ref path)) (type-ref path)
             (TypeEntry.runtime-brand generic)
             (TypeEntry.runtime-arity generic)
             (TypeEntry.source generic)))
         (world-tied
           (world-with-overlays (_0 decoded)
             (cairn:putax path placeholder
               (TypeWorld.overlays (_0 decoded)))))
         (body-result
           (specialize-scheme-at-resolving resolve world-tied
             (TypeEntry.scheme generic) args path))
         (body (_1 body-result)))
    (unless (resolved-type? body)
      (type-error "materialized application is not ground" [path body])
      1)
    (let* ((entry
             ($TypeEntry path base args (mono body) body
               (TypeEntry.runtime-brand generic)
               (TypeEntry.runtime-arity generic)
               (TypeEntry.source generic)))
           (world2
             (world-with-overlays (_0 body-result)
               (cairn:putax path entry
                 (TypeWorld.overlays (_0 body-result))))))
      [world2 entry])))

(define (lookup-type-entry world path)
  (need-path "bad lookup path" path)
  (let ((direct (world-find-direct world path)))
    (cond
      (direct [world (_0 direct)])
      ((ty-ap-path? path)
        (materialize-type-application-resolving lookup-type-entry world path))
      (else (type-error "unbound type" path)))))

(define (intern-type-application world base arguments)
  (define path (application-path base arguments))
  (define resolved (lookup-type-entry world path))
  [(_0 resolved) path])

(define (specialize-scheme world scm arguments)
  (specialize-scheme-at-resolving lookup-type-entry world scm arguments 0))


;;; Weak-head views and validation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (unfold-type world ref)
  (unless (type-ref? ref)
    (type-error "unfold-type expected Path" ref)
    1)
  (let* ((path (Path.p ref))
         (cached (cairn:getax path (TypeWorld.unfold-cache world))))
    (If cached
      [world (_0 cached)]
      (let* ((looked (lookup-type-entry world path))
             (world1 (_0 looked))
             (entry (_1 looked))
             (direct (TypeEntry.body entry))
             (br
               (If direct
                 [world1 direct]
                 ;; A bare reference to a parameterized entry views as
                 ;; the symbolic application of the entry to its own
                 ;; parameters (auto-eta).
                 (specialize-scheme-at-resolving lookup-type-entry world1
                   (TypeEntry.scheme entry)
                   (map parameter-template-argument
                     (Scheme.parameters (TypeEntry.scheme entry)))
                   0)))
             (body (_1 br)))
        [(world-with-unfold-cache (_0 br)
           (cairn:putax path body (TypeWorld.unfold-cache (_0 br))))
         body]))))

(define (view world typ)
  (cond
    ((type-ref? typ) (unfold-type world typ))
    ;; A template application views through its base scheme by symbolic
    ;; substitution: bst[@v] becomes bst's body with @v in place of the
    ;; parameter, nested applications staying symbolic while any of
    ;; their arguments remains template.  Substitution is purely syntactic
    ;; over the base entry, so the result is memoizable on the application
    ;; value alone; recursive generics (map[k lt]) re-view the same app at
    ;; every subtype/match step and blow up without this.
    ((type-app? typ)
      (let* ((key ["#app-view" typ])
             (cached (cairn:getax key (TypeWorld.unfold-cache world))))
        (If cached
          [world (_0 cached)]
          (let* ((lr (lookup-type-entry world (TyApp.base typ)))
                 (br
                   (specialize-scheme-at-resolving lookup-type-entry (_0 lr)
                     (TypeEntry.scheme (_1 lr)) (TyApp.arguments typ) 0))
                 (body (_1 br)))
            [(world-with-unfold-cache (_0 br)
               (cairn:putax key body (TypeWorld.unfold-cache (_0 br))))
             body]))))
    (else [world typ])))

(define (runtime-key world typ)
  (cond
    ((type-ref? typ)
      (let* ((r (lookup-type-entry world (Path.p typ)))
             (entry (_1 r))
             (brand (TypeEntry.runtime-brand entry))
             (arity (TypeEntry.runtime-arity entry))
             (body (TypeEntry.body entry)))
        ;; An alias entry (body itself a reference or application) with
        ;; no key of its own forwards its target's runtime key, so
        ;; matching through the alias dispatches on the real brand.
        (If (And (Ifz brand 1 0)
              (And (Ifz arity 1 0)
                (Or (type-ref? body) (type-app? body))))
          (runtime-key (_0 r) body)
          [(_0 r) [brand arity]])))
    ;; Type arguments erase at runtime, so a template application keys
    ;; exactly as its base.
    ((type-app? typ)
      (let ((r (lookup-type-entry world (TyApp.base typ))))
        [(_0 r)
         [(TypeEntry.runtime-brand (_1 r))
          (TypeEntry.runtime-arity (_1 r))]]))
    ((type-is-tag? trow-pax typ)
      [world [(Row.cstr typ) (Sz (Row.items typ))]])
    (else [world 0])))

(define (check-sum-runtime-keys world options)
  (define (walk w seen rest)
    (Ifz (Sz rest)
      w
      (let ((kr (runtime-key w (_0 rest))))
        (define key (_1 kr))
        (unless (Nil (And key (includes (Equal key) seen)))
          (type-error "sum alternatives collide at runtime" key)
          1)
        (walk (_0 kr) (If key (snoc key seen) seen) (drop 1 rest)))))
  (walk world [] options))

(define (check-type-wf world typ)
  (define (walk w t)
    (cond
      ((Or (type-var? t) (Or (const-var? t) (type-app? t)))
        (type-error "template node in resolved type" t))
      ((type-is-tag? tzero-rec-pax t)
        (type-error "open recursion in resolved type" t))
      ((type-ref? t)
        (_0 (lookup-type-entry w (Path.p t))))
      ((type-is-tag? trow-item-pax t)
        (walk w (RowItem.value t)))
      ((type-is-tag? trow-pax t)
        (foldl (lambda (acc item) (walk acc (RowItem.value item)))
          w (Row.items t)))
      ((type-is-tag? tsum-pax t)
        (let ((w1 (foldl walk w (Sum.options t))))
          (check-sum-runtime-keys w1 (Sum.options t))))
      ((type-is-tag? tfun-pax t)
        (walk (foldl walk w (Fun.args t)) (Fun.return t)))
      ((type-is-tag? tarr-pax t) (walk w (Arr.item t)))
      (else w)))
  (walk world typ))

;; Like check-type-wf, but template nodes are acceptable: a declaration
;; template is well-formed when every nominal reference in it resolves.
;; This is the module post-pass check — types may reference declarations
;; that follow them, so it runs against the final world.
(define (check-template-wf world typ)
  (define (walk w t)
    (cond
      ((type-var? t) w)
      ((const-var? t) w)
      ((type-app? t)
        (let ((w1 (_0 (lookup-type-entry w (TyApp.base t)))))
          (foldl
            (lambda (acc arg)
              (? GenericArgument arg
                (TyArg [value] (walk acc value))
                (ConstArg acc)))
            w1 (TyApp.arguments t))))
      ((type-is-tag? tzero-rec-pax t)
        (type-error "open recursion in resolved type" t))
      ((type-ref? t) (_0 (lookup-type-entry w (Path.p t))))
      ((type-is-tag? trow-item-pax t) (walk w (RowItem.value t)))
      ((type-is-tag? trow-pax t)
        (foldl (lambda (acc item) (walk acc (RowItem.value item)))
          w (Row.items t)))
      ((type-is-tag? tsum-pax t)
        (let ((w1 (foldl walk w (Sum.options t))))
          (check-sum-runtime-keys w1 (Sum.options t))))
      ((type-is-tag? tfun-pax t)
        (walk (foldl walk w (Fun.args t)) (Fun.return t)))
      ((type-is-tag? tarr-pax t) (walk w (Arr.item t)))
      (else w)))
  (walk world typ))

(define (check-scheme-wf world scm)
  (define w1
    (foldl
      (lambda (w param)
        (? SchemeParameter param
          (TyParam w)
          (ConstParam [declared-type] (check-template-wf w declared-type))))
      world (Scheme.parameters scm)))
  (check-template-wf w1 (Scheme.body scm)))


;;; Static subtyping and gradual consistency ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (seen-pair? actual expected seen)
  (includes (lambda (pair)
    (And (Equal actual (_0 pair)) (Equal expected (_1 pair)))) seen))

;; One walk serves both the strict and the gradual boundary relation:
;; any-ok? is the single point where they differ.  Consistent subtyping
;; (any-ok? = 1) keeps every other rule of static subtyping — auras,
;; constants, contravariant function arguments, nominal identity — and
;; only lets Any stand for any type, at any depth.
(define (subtype-go any-ok? world seen actual expected)
  (If (seen-pair? actual expected seen)
    [world 1]
    (let ((seen1 (snoc [actual expected] seen)))
      (define (recur w a b) (subtype-go any-ok? w seen1 a b))
      (define (all-pairs w pairs contra?)
        (foldl
          (lambda (state pair)
            (Ifz (_1 state)
              state
              (let ((r
                      (If contra?
                        (recur (_0 state) (_1 pair) (_0 pair))
                        (recur (_0 state) (_0 pair) (_1 pair)))))
                [(_0 r) (_1 r)])))
          [w 1] pairs))
      (define (all-options w options target options-actual?)
        (foldl
          (lambda (state option)
            (Ifz (_1 state)
              state
              (let ((r
                      (If options-actual?
                        (recur (_0 state) option target)
                        (recur (_0 state) target option))))
                [(_0 r) (_1 r)])))
          [w 1] options))
      (define (any-options w options target options-expected?)
        (foldl
          (lambda (state option)
            (If (_1 state)
              state
              (let ((r
                      (If options-expected?
                        (recur (_0 state) target option)
                        (recur (_0 state) option target))))
                [(_0 r) (_1 r)])))
          [w 0] options))
      (cond
        ((Equal actual expected) [world 1])
        ;; Under strict subtyping Any is not top or bottom; a dynamic
        ;; boundary opts in via consistent-subtype.
        ((Or (type-is-tag? tany-pax actual)
             (type-is-tag? tany-pax expected))
          [world any-ok?])
        ((type-is-tag? tbot-pax actual) [world 1])
        ((type-is-tag? tbot-pax expected) [world 0])
        ;; Preserve nominal identity when equal; otherwise inspect one weak
        ;; head layer and let the coinductive pair memo tie recursive knots.
        ;; Template applications view symbolically the same way.
        ((Or (type-ref? actual) (type-ref? expected))
          (let* ((ar (view world actual))
                 (er (view (_0 ar) expected)))
            (recur (_0 er) (_1 ar) (_1 er))))
        ((Or (type-app? actual) (type-app? expected))
          (let* ((ar (view world actual))
                 (er (view (_0 ar) expected)))
            (recur (_0 er) (_1 ar) (_1 er))))
        ;; The pail universe admits exactly the branded nominal rows:
        ;; anonymous (cstr-0) rows and sums stay outside it.  After the
        ;; view clauses (both sides are weak-head structural here) and
        ;; before the sum clauses, so a sum never slips in option-wise.
        ((type-is-tag? tpail-pax expected)
          (If (type-is-tag? trow-pax actual)
            [world (Ifz (Row.cstr actual) 0 1)]
            [world (type-is-tag? tpail-pax actual)]))
        ((type-is-tag? tpail-pax actual) [world 0])
        ((type-is-tag? tsum-pax actual)
          (all-options world (Sum.options actual) expected 1))
        ((type-is-tag? tsum-pax expected)
          (any-options world (Sum.options expected) actual 1))
        ((And (type-is-tag? tconst-pax actual)
              (type-is-tag? tnat-pax expected))
          [world (IsNat (Const.value actual))])
        ((And (type-is-tag? tnat-pax actual)
              (type-is-tag? tnat-pax expected))
          [world
           (Or (Eq (Nat.aura actual) (Nat.aura expected))
             (Eq 0 (Nat.aura expected)))])
        ((And (type-is-tag? tconst-pax actual)
              (type-is-tag? tconst-pax expected))
          [world (Equal (Const.value actual) (Const.value expected))])
        ((And (type-is-tag? tarr-pax actual)
              (type-is-tag? tarr-pax expected))
          (recur world (Arr.item actual) (Arr.item expected)))
        ((And (type-is-tag? tpin-pax actual)
              (type-is-tag? tpin-pax expected))
          (recur world (TyPin.item actual) (TyPin.item expected)))
        ((And (type-is-tag? tfun-pax actual)
              (type-is-tag? tfun-pax expected))
          (Ifz (Eq (Sz (Fun.args actual)) (Sz (Fun.args expected)))
            [world 0]
            (let ((args-result
                    (all-pairs world
                      (zip (Fun.args actual) (Fun.args expected)) 1)))
              (Ifz (_1 args-result)
                args-result
                (recur (_0 args-result)
                  (Fun.return actual) (Fun.return expected))))))
        ;; A cstr-0 structural row is a PLAN row at runtime, so it nests
        ;; as an array whenever every item fits the element type.
        ((And (type-is-tag? trow-pax actual)
              (And (Ifz (Row.cstr actual) 1 0)
                (type-is-tag? tarr-pax expected)))
          (all-options world
            (map RowItem.value (Row.items actual))
            (Arr.item expected) 1))
        ((And (type-is-tag? trow-pax actual)
              (type-is-tag? trow-pax expected))
          (Ifz (And (Eq (Row.cstr actual) (Row.cstr expected))
                  (Eq (Sz (Row.items actual)) (Sz (Row.items expected))))
            [world 0]
            (all-pairs world
              (zip (map RowItem.value (Row.items actual))
                   (map RowItem.value (Row.items expected)))
              0)))
        (else [world 0])))))

(define (subtype-with-cache any-ok? world actual expected)
  (define key
    (If any-ok? ["cs" actual expected] [actual expected]))
  (define cached (cairn:getax key (TypeWorld.subtype-cache world)))
  (If cached
    [world (_0 cached)]
    (let ((r (subtype-go any-ok? world [] actual expected)))
      [(world-with-subtype-cache (_0 r)
         (cairn:putax key (_1 r) (TypeWorld.subtype-cache (_0 r))))
       (_1 r)])))

(define (subtype world actual expected)
  (subtype-with-cache 0 world actual expected))

(define (subtype? world actual expected)
  (_1 (subtype world actual expected)))

(define (consistent-subtype world actual expected)
  (subtype-with-cache 1 world actual expected))

(define (consistent-subtype? world actual expected)
  (_1 (consistent-subtype world actual expected)))


;;; Template matching (inference) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Match a template monotype against an actual type, accumulating type
;; variable bindings ([name type] rows).  First binding wins; a later
;; occurrence must relate by subtyping in one direction, the binding
;; widening when the new actual is wider.  Constants widen to plain nat
;; at binding sites: tconst is the const-parameter vocabulary, not an
;; inference target.  A fully resolved template defers to consistent
;; subtyping.  Returns [world bindings] or 0 (no match).
(define (match-template world bindings template actual0)
  (define (widen-constant t)
    (If (const-type? t) (tnat 0) t))
  (define actual (widen-constant actual0))
  (define (match-many w bs pairs)
    (foldl
      (lambda (state pair)
        (Ifz state
          0
          (match-template (_0 state) (_1 state) (_0 pair) (_1 pair))))
      [w bs] pairs))
  (define (match-arguments w bs targs aargs)
    (And (Eq (Sz targs) (Sz aargs))
      (foldl
        (lambda (state pair)
          (Ifz state
            0
            (? GenericArgument (_0 pair)
              (TyArg [value]
                (If (Eq "type" (argument-kind (_1 pair)))
                  (match-template (_0 state) (_1 state) value
                    (argument-value (_1 pair)))
                  0))
              (ConstArg
                (If (Equal (_0 pair) (_1 pair)) state 0)))))
        [w bs] (zip targs aargs))))
  (define (match-argument-parts w bs targs parts)
    (And (Eq (Sz targs) (Sz parts))
      (foldl
        (lambda (state pair)
          (Ifz state
            0
            (? GenericArgument (_0 pair)
              (TyArg [value]
                (If (ty-val-path? (_1 pair))
                  0
                  (match-template (_0 state) (_1 state) value
                    (type-ref (_1 pair)))))
              (ConstArg [value]
                (If (ty-val-path? (_1 pair))
                  (If (Equal value (Ix 1 (_1 pair))) state 0)
                  (If (Equal value (_1 pair)) state 0))))))
        [w bs] (zip targs parts))))
  (cond
    ((type-var? template)
      (let* ((name (ty-var-name template))
             (hit (find (lambda (b) (Eq name (_0 b))) bindings)))
        (Ifz hit
          [world (snoc [name actual] bindings)]
          (let ((bound (_1 (_0 hit))))
            (cond
              ((Equal bound actual) [world bindings])
              ((consistent-subtype? world actual bound) [world bindings])
              ((consistent-subtype? world bound actual)
                [world
                 (map (lambda (b) (If (Eq name (_0 b)) [name actual] b))
                   bindings)])
              (else 0))))))
    ;; The identity shortcut is only sound for resolved templates: an
    ;; identical SYMBOLIC pair ({@v; @w} against itself, calling a
    ;; sibling generic from a generic body) must still walk the
    ;; structure so each template variable binds (symbolically) to the
    ;; caller's variable of the same name.
    ((And (Equal template actual) (resolved-type? template))
      [world bindings])
    ((resolved-type? template)
      (If (consistent-subtype? world actual template) [world bindings] 0))
    ((type-app? template)
      (cond
        ((And (type-app? actual)
           (Equal (TyApp.base template) (TyApp.base actual)))
          (match-arguments world bindings
            (TyApp.arguments template) (TyApp.arguments actual)))
        ((And (type-ref? actual) (ty-ap-path? (Path.p actual)))
          (let ((parts (ty-ap-decode (Path.p actual))))
            (And (Equal (TyApp.base template) (_0 parts))
              (match-argument-parts world bindings
                (TyApp.arguments template) (drop 1 parts)))))
        (else 0)))
    ;; A nominal actual against a structural template views one weak
    ;; head layer and retries — BEFORE the structural clauses, which
    ;; would otherwise reject the shape mismatch outright.
    ((Or (type-ref? actual) (type-app? actual))
      (let ((vr (view world actual)))
        (match-template (_0 vr) bindings template (_1 vr))))
    ((type-is-tag? tfun-pax template)
      (And (type-is-tag? tfun-pax actual)
        (And (Eq (Sz (Fun.args template)) (Sz (Fun.args actual)))
          (match-many world bindings
            (snoc [(Fun.return template) (Fun.return actual)]
              (zip (Fun.args template) (Fun.args actual)))))))
    ((type-is-tag? tarr-pax template)
      (cond
        ((type-is-tag? tarr-pax actual)
          (match-template world bindings
            (Arr.item template) (Arr.item actual)))
        ;; A cstr-0 structural row nests as an array (see subtype-go):
        ;; every item matches the element template in turn, first
        ;; binding wins.  An empty literal binds nothing — the item
        ;; variable falls to the caller's fallback.
        ((And (type-is-tag? trow-pax actual) (Ifz (Row.cstr actual) 1 0))
          (match-many world bindings
            (map (lambda (item) [(Arr.item template) (RowItem.value item)])
              (Row.items actual))))
        (else 0)))
    ((type-is-tag? tpin-pax template)
      (And (type-is-tag? tpin-pax actual)
        (match-template world bindings
          (TyPin.item template) (TyPin.item actual))))
    ((type-is-tag? trow-item-pax template)
      (And (type-is-tag? trow-item-pax actual)
        (match-template world bindings
          (RowItem.value template) (RowItem.value actual))))
    ((type-is-tag? trow-pax template)
      (And (type-is-tag? trow-pax actual)
        (And (Eq (Row.cstr template) (Row.cstr actual))
          (And (Eq (Sz (Row.items template)) (Sz (Row.items actual)))
            (match-many world bindings
              (zip (map RowItem.value (Row.items template))
                (map RowItem.value (Row.items actual))))))))
    (else 0)))


;;; Weak joins and narrowing meets ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (flat-sum-options typ)
  (If (type-is-tag? tsum-pax typ) (Sum.options typ) [typ]))

(define (check-join-runtime-keys world options)
  (define (walk w seen rest)
    (Ifz (Sz rest)
      w
      (let ((kr (runtime-key w (_0 rest))))
        (define key (_1 kr))
        (unless key
          (type-error "join requires an annotation (no runtime dispatch key)"
            (_0 rest))
          1)
        (unless (Nil (includes (Equal key) seen))
          (type-error "join requires an annotation (runtime key collision)" key)
          1)
        (walk (_0 kr) (snoc key seen) (drop 1 rest)))))
  (walk world [] options))

(define (join world a b)
  (cond
    ((Equal a b) [world a])
    (else
      (let ((ab (subtype world a b)))
        (If (_1 ab)
          [(_0 ab) b]
          (let ((ba (subtype (_0 ab) b a)))
            (If (_1 ba)
              [(_0 ba) a]
              ;; Distinct constants share no runtime dispatch key;
              ;; their join is the shared representation type, not a
              ;; sum (.true joins .false as nat).
              (If (And (const-type? a) (const-type? b))
                [(_0 ba) (tnat 0)]
                (let* ((opts
                         (Weld (flat-sum-options a) (flat-sum-options b)))
                       (checked (check-join-runtime-keys (_0 ba) opts)))
                  [checked (tsum opts)])))))))))

(define (join-type world a b) (_1 (join world a b)))

(define (meet world a b)
  (cond
    ((Equal a b) [world a])
    (else
      (let ((ab (subtype world a b)))
        (If (_1 ab)
          [(_0 ab) a]
          (let ((ba (subtype (_0 ab) b a)))
            (If (_1 ba)
              [(_0 ba) b]
              [(_0 ba) tbot])))))))

(define (meet-type world a b) (_1 (meet world a b)))
