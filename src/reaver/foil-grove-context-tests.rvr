(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind backend (#module foil-grove-backend))
(#bind abi (#module foil-abi))
(#bind brand (#module shrine-brand))

(define (run ignored)
  (define compiler (Pin "grove-context-test-compiler"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define system (bootstrap:build-system compiler resolve slot))
  (define local (bootstrap:build-local ("x" 17) system resolve slot
    ["grove_backend" "tests/grove_backend"]))
  (define code (_1 local))
  (define prepared (backend:prepare code))
  (define policy (_1 prepared))
  (define checks
    (Unpin (_1 (need (find (lambda (pair)
      (Equal "tests/grove_backend" (_0 pair))) (_2 code))))))
  (define (check name) (driver:get-perc ["grove_backend_checks" name] checks))
  (define (path names) (Weld [("x" 17)] (map (lambda (name) ("ts" name)) names)))
  (define (ok result)
    (If (Equal "ok" (Hd result)) (_0 result)
      (error ["grove-context-test" (_0 result)])))
  (define (parse text) (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing path) (abi:option policy "none"))
  (define root (path ["definitions"]))
  (define document (parse (strWeld (read-text-file "grove/backend.grove") "
variant =
  ! foil
  + yes : value=nat
  + no :
  & variant/yes variant/no
")))
  (define records (ok (backend:compile prepared (lambda (path) 0) missing root document)))
  (define counter (_0 (((check "lookup") records) (path ["definitions" "counter"]))))
  (define make ((check "export") [("ts" "make")] counter))
  (define value (make 42))
  assert(Equal [[[["x" 17] ["ts" "definitions"] ["ts" "token"]] 1]]
    (brand:decode (Hd value)))
  (define revised (ok (backend:compile prepared (lambda (path) 1) missing root document)))
  (define make-revised ((check "export") [("ts" "make")] (_0 (((check "lookup") revised) (path ["definitions" "counter"])))))
  assert(Equal [[[["x" 17] ["ts" "definitions"] ["ts" "token"]] 2]]
    (brand:decode (Hd (make-revised 42))))
  assert(Nil (Equal (Hd value) (Hd (make-revised 42))))
  (define lookup ((check "lookup") records))
  (define consumer (parse (strcat
    ["#import tok=" 34 "/0x11/definitions/token" 34 10
     "#import count=" 34 "/0x11/definitions/counter" 34 10
     "use =
  ! foil
  + value
    ^ tok
    | count/make 73
"])))
  (define imported (ok (backend:compile (backend:prepare code)
    (lambda (path) 0) lookup (path ["consumer"]) consumer)))
  (define imported-value ((check "export") [("ts" "value")] (_0 (((check "lookup") imported) (path ["consumer" "use"])))))
  assert(Equal (Hd value) (Hd imported-value))
  assert(Equal 73 (_0 imported-value))
  (define published (ok (backend:publish prepared records 0 0 (_0 local))))
  (define state (_0 published))
  assert(Equal (_2 (_0 local)) (_2 state))
  (define version (driver:get-perc ["namespace" "case"] policy))
  (define x (abi:constructor policy ["care" "x"]))
  (define some (abi:option policy "some"))
  assert(Equal (some 1) (version x (path ["definitions" "variant" "yes"]) state))
  assert(Equal "err" (Hd (backend:publish prepared records 0 0 state)))
  (define published-again (ok (backend:publish prepared revised 0 0 state)))
  assert(Equal (some 2)
    (version x (path ["definitions" "variant" "yes"]) (_0 published-again)))
  (define module-slot (driver:get-perc ["grove_backend" "module_slot"] policy))
  assert(Equal ("x" 17) (_0 module-slot))
  (define machinery (driver:get-perc ["publisher_vocabulary" "machinery"] policy))
  assert(machinery module-slot)
  assert(Nil (machinery [("ts" "sys") ("ts" "content")]))
  0)
assert(Equal 0 (run 0))
