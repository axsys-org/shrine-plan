;;;; Evaluate one Foil value against an explicit compiled subject.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind doctest (#module doctest))
(#bind render (#module foil-render))

(define (compiler policy)
  (define artifact (driver:get-perc ["goo_value" "artifact"] policy))
  (define default-context (doctest:bundle (driver:perc-subject policy)))
  (lambda (context text state)
    (define (evaluate ignored)
      (define scope
        (Ifz (Sz context) default-context
          (let ((found (artifact context state)))
            (Ifz (Sz found) (error "Choose a compiled Foil definition as the context.")
              (doctest:bundle (driver:perc-subject (driver:require-perc (Unpin (_0 found)))))))))
      (define result (doctest:eval-text scope text))
      (If (Eq 1 (Hd result)) ("err" (render:render-plain (_0 result)))
        ("ok" (_0 (_0 result)))))
    (define result (Try (lambda (ignored) (force (evaluate 0))) 0))
    (If (Eq 1 (Hd result)) ("err" (render:render-plain (_0 result))) (_0 result))))

(#export compiler)
