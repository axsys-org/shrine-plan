(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; helm.foil: the pure IO-driver core.  Runtime shapes: boot/pulse/
;;; exec return (0 hm out); hm is the helm row ("/boot/helm" sov reg
;;; eyes crew) — _0=sov _1=reg _2=eyes _3=crew; duties are
;;; ("birth" n res) / ("fell" n) / ("tell" n res) / ("ack" n rsvp);
;;; rsvp is ("ok" maybe-path) / ("no" err); res is ("known" m) /
;;; "null" / "unknown".  The demo registry and task builders come
;;; from a separate lainapp compile — PLAN values interop.

;; one compilation serves both the helm core and the lainapp fixtures
(define helm-sut (foil:compile-mod foil:default-subject "helmapp"))
(define (hlm path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) helm-sut)))
(define app hlm)

(define helm-boot (hlm ["helm" "boot"]))
(define helm-exec (hlm ["helm" "exec"]))
(define ukeys (hlm ["uon" "keys"]))

(define seeded ((app ["seeded"]) 0))
(define sov0 seeded)
(define t00 ((app ["t0"]) 0))
(define t-data (app ["t_data"]))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define vine-cull (app ["vine_cull"]))
(define run-event (app ["run_event"]))

(define na ("ts" "a"))
(define nb ("ts" "b"))
(define nc ("ts" "c"))
(define tio ("ts" "io"))
(define slot [("ts" "s")])

;; a sovereign with /io/a and /io/b already made
(define r0a (run-event (vine-make [tio na] (t-data slot 1)) 0 sov0))
(define r0b (run-event (vine-make [tio nb] (t-data slot 2)) 0 (_0 r0a)))
(define sAB (_0 r0b))

;;; 1. boot births every existing name and sets the crew ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define b0 (helm-boot sAB))
(define hm0 (_0 b0))
(define out0 (_1 b0))
assert(Eq 2 (Sz out0))
(define d0a (Ix 0 out0))
assert(Eq "birth" (Hd d0a))
assert(Equal na (_0 d0a))
assert(Eq "known" (Hd (_1 d0a)))
assert(Eq "birth" (Hd (Ix 1 out0)))
assert(Equal nb (_0 (Ix 1 out0)))
assert(Equal [na nb] (ukeys (_2 hm0)))

;; boot on a fresh sovereign births nothing
(define bfresh (helm-boot sov0))
assert(Eq 0 (Sz (_1 bfresh)))
assert(Equal [] (ukeys (_2 (_0 bfresh))))

;;; 2. a poke to a driven name tells its actor and acks the sender ;;;;;;;;;;;;;;;;;

(define e1 (helm-exec ("some" na) (vine-poke [tio na] (t-data slot 7)) hm0))
(define hm1 (_0 e1))
(define out1 (_1 e1))
assert(Eq 2 (Sz out1))
(define d1t (Ix 0 out1))
assert(Eq "tell" (Hd d1t))
assert(Equal na (_0 d1t))
;; the tell names the watched path that fired
assert(Equal [tio na] (_1 d1t))
assert(Eq "known" (Hd (_2 d1t)))
(define d1k (Ix 1 out1))
assert(Equal ("ack" na ("ok" ("some" [tio na]))) d1k)

;;; 3. membership: makes birth, culls fell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define e2 (helm-exec ("some" na) (vine-make [tio nc] (t-data slot 3)) hm1))
(define hm2 (_0 e2))
(define out2 (_1 e2))
;; a birth for c (no tell: it was never watched), then the ack
assert(Eq 2 (Sz out2))
assert(Eq "birth" (Hd (Ix 0 out2)))
assert(Equal nc (_0 (Ix 0 out2)))
assert(Eq "ack" (Hd (Ix 1 out2)))
assert(Equal [na nb nc] (ukeys (_2 hm2)))

(define e3 (helm-exec ("some" na) (vine-cull [tio nb]) hm2))
(define hm3 (_0 e3))
(define out3 (_1 e3))
assert(Eq 2 (Sz out3))
assert(Equal ("fell" nb) (Ix 0 out3))
assert(Eq "ack" (Hd (Ix 1 out3)))
assert(Equal [na nc] (ukeys (_2 hm3)))

;;; 4. non-/io writes stay silent; failures nack and leave the helm ;;;;;;;;;;;;;;;;

(define e4 (helm-exec ("some" nc) (vine-make [("ts" "data") ("ts" "x")] t00) hm3))
(define out4 (_1 e4))
assert(Eq 1 (Sz out4))
assert(Equal ("ack" nc ("ok" ("some" [("ts" "data") ("ts" "x")]))) (Ix 0 out4))

(define e5 (helm-exec ("some" nc) (vine-poke [("ts" "zz")] t00) (_0 e4)))
assert(Equal [("ack" nc ("no" ("ts" "poke_missing")))] (_1 e5))
;; the sovereign did not advance
assert(Eq (_2 (_0 (_0 e4))) (_2 (_0 (_0 e5))))

;; an unnamed source gets no ack duty
(define e6 (helm-exec "none" (vine-poke [tio na] (t-data slot 8)) (_0 e5)))
assert(Eq 1 (Sz (_1 e6)))
assert(Eq "tell" (Hd (Ix 0 (_1 e6))))

;;; 5. fired watches re-arm: consecutive changes both tell ;;;;;;;;;;;;;;;;;;;;;;;;;

(define e7 (helm-exec "none" (vine-poke [tio na] (t-data slot 9)) (_0 e6)))
assert(Eq 1 (Sz (_1 e7)))
assert(Eq "tell" (Hd (Ix 0 (_1 e7))))
(define e8 (helm-exec "none" (vine-poke [tio nc] (t-data slot 4)) (_0 e7)))
assert(Eq 1 (Sz (_1 e8)))
assert(Equal nc (_0 (Ix 0 (_1 e8))))

;;; 6. spies: one-shot watches on arbitrary paths ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define helm-spy (hlm ["helm" "spy"]))
(define dx [("ts" "data") ("ts" "x")])
(define hm-s (helm-spy na dx (_0 e8)))
(define e9 (helm-exec "none" (vine-poke dx (t-data slot 11)) hm-s))
(define out9 (_1 e9))
assert(Eq 1 (Sz out9))
(define d9 (Ix 0 out9))
assert(Eq "tell" (Hd d9))
assert(Equal na (_0 d9))
assert(Equal dx (_1 d9))
assert(Eq "known" (Hd (_2 d9)))
;; the spy is consumed: a second write is silent
(define e10 (helm-exec "none" (vine-poke dx (t-data slot 12)) (_0 e9)))
assert(Eq 0 (Sz (_1 e10)))
;; re-spying tells again
(define hm-s2 (helm-spy na dx (_0 e10)))
(define e11 (helm-exec "none" (vine-poke dx (t-data slot 13)) hm-s2))
assert(Eq 1 (Sz (_1 e11)))
assert(Equal dx (_1 (Ix 0 (_1 e11))))
;; a spy for a dead name fires into the void
(define hm-s3 (helm-spy nb dx (_0 e11)))
(define e12 (helm-exec "none" (vine-poke dx (t-data slot 14)) hm-s3))
assert(Eq 0 (Sz (_1 e12)))

;;; 7. the /boot mirror pails: tpail/code construct, read, render ;;;;;;;;;;;;;;;;;;

(define show-pail (app ["show_pail"]))
assert(Equal "hi" (show-pail ("/boot/tpail" "hi")))
assert(Equal "code" (show-pail ("/boot/code" 42)))

(define boot-ent-t (app ["boot_ent_t"]))
(define txt-slot (app ["txt_slot"]))
(define code-slot (app ["code_slot"]))
(define has-slot (app ["has_slot"]))
(define kslot [("ts" "kind")])
(define cslot [("ts" "code")])

;; lowered: kind, src, and the value
(define me1 (boot-ent-t 7 "function" "+ x" 1 0 0 [] []))
assert(Equal "function" (txt-slot kslot me1))
assert(Equal "+ x" (txt-slot [("ts" "src")] me1))
assert(Eq 7 (code-slot cslot me1))
;; unlowered: no code slot
(define me0 (boot-ent-t 7 "function" "+ x" 0 0 0 [] []))
assert(Eq 0 (has-slot cslot me0))
;; a code slot read through the text reader is 0, and vice versa
assert(Eq 0 (txt-slot cslot me1))
assert(Eq 0 (code-slot kslot me1))

;; lore: present when the flag is set, absent when not; the pail
;; renders opaque until the explorer learns it (shrine-apps phase 6)
(define lslot [("ts" "lore")])
(define meL
  (boot-ent-t 7 "function" "+ x" 1
    1 "adds." ["adds." "twice."] [["(add 1 1)" "2"]]))
assert(Eq 1 (has-slot lslot meL))
assert(Eq 0 (has-slot lslot me1))
;; the explorer renders lore: head only, doctest count when present
assert(Equal "h" (show-pail ("/boot/lore" "h" ["h"] [])))
(define boot-src-t (app ["boot_src_t"]))
(define msL (boot-src-t "-  lain" 1 "the module." ["the module."] []))
assert(Eq 1 (has-slot lslot msL))
assert(Equal "-  lain" (txt-slot [("ts" "src")] msL))
assert(Eq 0 (has-slot lslot (boot-src-t "-  lain" 0 0 [] [])))
