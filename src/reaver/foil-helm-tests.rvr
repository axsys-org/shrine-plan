(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind fixture (#module foil-test-helm))


;;; Application exports, mirror records and chore inbox wiring.
;;; Pure driver scenarios live in foil-helm-core-tests.

;; one compilation serves both the helm core and the lainapp fixtures
(Seq (define helm-sut (_1 fixture:compiled)) (DeepSeq helm-sut 0))
(define (hlm path) (foil:source-entry-val path helm-sut))
(Seq (define app hlm) (DeepSeq app 0))

(Seq (define helm-boot (hlm ["helm" "boot"])) (DeepSeq helm-boot 0))
(Seq (define ukeys (hlm ["uon" "keys"])) (DeepSeq ukeys 0))

(Seq (define seeded (app ["seeded"])) (DeepSeq seeded 0))
(Seq (define t00 (app ["myth" "new"])) (DeepSeq t00 0))
(Seq (define msing (app ["myth" "sing"])) (DeepSeq msing 0))
(Seq (define pd (app ["pd"])) (DeepSeq pd 0))
(define (t-data slot n) (msing slot (pd n)))
(Seq (define vine-make (app ["vine_make"])) (DeepSeq vine-make 0))
(Seq (define vine-poke (app ["vine_poke"])) (DeepSeq vine-poke 0))
(Seq (define vine-cull (app ["vine_cull"])) (DeepSeq vine-cull 0))
(Seq (define run-event (app ["run_event"])) (DeepSeq run-event 0))

;;; Driver reconciliation lives in foil-helm-core-tests. This checks the
;;; application's exported driver and seeded state once.
(Seq (define fresh (helm-boot seeded)) (DeepSeq fresh 0))
assert(Equal [] (_1 fresh))
assert(Equal [] (ukeys (_2 (_0 fresh))))
(Seq (define tio ("ts" "io")) (DeepSeq tio 0))

;;; the /boot mirror pails: tpail/code construct, read, render ;;;;;;;;;;;;;;;;;;

(Seq (define show-pail (app ["show" "pail"])) (DeepSeq show-pail 0))
assert(Equal "hi" (show-pail ("/boot/pails/t" "hi")))
assert(Equal "code" (show-pail ("/boot/pails/code" 42)))

(Seq (define boot-ent-t (app ["mirror" "entry"])) (DeepSeq boot-ent-t 0))
(Seq (define txt-slot (app ["myth" "txt_at"])) (DeepSeq txt-slot 0))
(Seq (define code-slot (app ["myth" "code_at"])) (DeepSeq code-slot 0))
(Seq (define has-slot (app ["myth" "has_at"])) (DeepSeq has-slot 0))
(Seq (define kslot [("ts" "kind")]) (DeepSeq kslot 0))
(Seq (define cslot [("ts" "code")]) (DeepSeq cslot 0))

;; lowered: kind, src, and the value
(Seq (define me1 (boot-ent-t 7 "function" "+ x" 1 0 0 [] [])) (DeepSeq me1 0))
assert(Equal "function" (txt-slot kslot me1))
assert(Equal "+ x" (txt-slot [("ts" "sys") ("ts" "src")] me1))
assert(Eq 7 (code-slot cslot me1))
;; unlowered: no code slot
(Seq (define me0 (boot-ent-t 7 "function" "+ x" 0 0 0 [] [])) (DeepSeq me0 0))
assert(Eq 0 (has-slot cslot me0))
;; a code slot read through the text reader is 0, and vice versa
assert(Eq 0 (txt-slot cslot me1))
assert(Eq 0 (code-slot kslot me1))

;; lore: present when the flag is set, absent when not; the pail
;; renders opaque until the explorer learns it (shrine-apps phase 6)
(Seq (define lslot [("ts" "sys") ("ts" "help")]) (DeepSeq lslot 0))
(define meL
  (boot-ent-t 7 "function" "+ x" 1
    1 "adds." ["adds." "twice."] [["(add 1 1)" "2"]]))
assert(Eq 1 (has-slot lslot meL))
assert(Eq 0 (has-slot lslot me1))
;; the explorer renders lore: head only, doctest count when present
assert(Equal "h" (show-pail ("/boot/lore" "h" ["h"] [])))
(Seq (define boot-src-t (app ["mirror" "src"])) (DeepSeq boot-src-t 0))
(Seq (define msL (boot-src-t "-  lain" 1 "the module." ["the module."] [])) (DeepSeq msL 0))
assert(Eq 1 (has-slot lslot msL))
assert(Equal "-  lain" (txt-slot [("ts" "sys") ("ts" "src")] msL))
assert(Eq 0 (has-slot lslot (boot-src-t "-  lain" 0 0 [] [])))

;; the extra mirror slots: the reflected type descriptor when given,
;; law and refs only when present — absent means no slot, not a zero
;; slot.  Descriptors are `type` sum values (short-brand rows, like
;; iotas): ("nat" 0) is the plain-nat descriptor.
(Seq (define boot-ent-x (app ["mirror" "extras"])) (DeepSeq boot-ent-x 0))
(Seq (define tyslot [("ts" "sys") ("ts" "mold")]) (DeepSeq tyslot 0))
(Seq (define lawslot [("ts" "law")]) (DeepSeq lawslot 0))
(Seq (define callslot [("ts" "calls")]) (DeepSeq callslot 0))
(Seq (define cbslot [("ts" "called_by")]) (DeepSeq cbslot 0))
(Seq (define pxa9 [("ts" "boot") ("ts" "bst")]) (DeepSeq pxa9 0))
(Seq (define mex (boot-ent-x ("/boot/maybe/some" ("nat" 0)) 0 [pxa9] [] me1)) (DeepSeq mex 0))
assert(Eq 1 (has-slot tyslot mex))
assert(Eq 0
  (has-slot tyslot (boot-ent-x "/boot/maybe/none" 0 [pxa9] [] me1)))
assert(Eq 0 (has-slot lawslot mex))
assert(Eq 1 (has-slot callslot mex))
assert(Eq 0 (has-slot cbslot mex))
;; the base record's slots survive the layering
assert(Equal "function" (txt-slot kslot mex))
(Seq (define mex0 (boot-ent-x "/boot/maybe/none" 0 [] [] me1)) (DeepSeq mex0 0))
assert(Eq 0 (has-slot tyslot mex0))
;; fail cards and ns indices
(Seq (define boot-fail-t (app ["mirror" "fail"])) (DeepSeq boot-fail-t 0))
(Seq (define mf (boot-fail-t "boom")) (DeepSeq mf 0))
assert(Equal "failed" (txt-slot [("ts" "status")] mf))
assert(Equal "boom" (txt-slot [("ts" "err")] mf))
(Seq (define boot-ns-t (app ["mirror" "index"])) (DeepSeq boot-ns-t 0))
assert(Eq 1 (has-slot [("ts" "entries")] (boot-ns-t [pxa9])))

;;; the chore vocabulary: the generic async-task records ;;;;;;;;;;;;;;;;;;;;;;;;

(Seq (define chore-req (app ["chore" "req"])) (DeepSeq chore-req 0))
(Seq (define chore-cfg (app ["chore" "cfg"])) (DeepSeq chore-cfg 0))
(Seq (define fam-of (app ["chore" "fam_of"])) (DeepSeq fam-of 0))
(Seq (define done-t (app ["chore" "done_t"])) (DeepSeq done-t 0))
(Seq (define fail-t (app ["chore" "fail_t"])) (DeepSeq fail-t 0))
(Seq (define clear-t (app ["chore" "clear_t"])) (DeepSeq clear-t 0))
(Seq (define cmd-parts (app ["chore" "cmd_parts"])) (DeepSeq cmd-parts 0))
(Seq (define cmd-mkp (app ["chore" "mkp_t"])) (DeepSeq cmd-mkp 0))
(Seq (define cmd-mk (app ["chore" "make_t"])) (DeepSeq cmd-mk 0))
(Seq (define cmd-pk (app ["chore" "poke_t"])) (DeepSeq cmd-pk 0))
(Seq (define nat-slot (app ["myth" "nat_at"])) (DeepSeq nat-slot 0))
(Seq (define fresh-f (app ["fetch" "fresh"])) (DeepSeq fresh-f 0))
(Seq (define tdbl ("ts" "dbl")) (DeepSeq tdbl 0))

;; family resolution: the record's own fam, else the default
assert(Equal tdbl (fam-of ("ts" "zz") (chore-req tdbl)))
assert(Equal ("ts" "zz") (fam-of ("ts" "zz") t00))
assert(Equal tdbl (fam-of 0 (chore-cfg tdbl)))

;; completion records
(Seq (define dn (done-t 3 1)) (DeepSeq dn 0))
assert(Eq 1 (nat-slot [("ts" "res_done")] 0 dn))
assert(Eq 3 (nat-slot [("ts" "passed")] 0 dn))
assert(Eq 1 (nat-slot [("ts" "failed")] 0 dn))
(Seq (define fl (fail-t ("ts" "fam_unknown"))) (DeepSeq fl 0))
assert(Eq 1 (nat-slot [("ts" "res_done")] 0 fl))
assert(Eq 0 (nat-slot [("ts" "res_ok")] 1 fl))
assert(Eq 0 (nat-slot [("ts" "fresh") ("ts" "k")] 1 (clear-t ("ts" "k"))))

;; the cmd vocabulary, host-shaped: [kind pax t]
(Seq (define pxa [("ts" "a")]) (DeepSeq pxa 0))
assert(Equal [0 pxa t00] (cmd-parts (cmd-mkp pxa t00)))
assert(Equal [1 pxa t00] (cmd-parts (cmd-mk pxa t00)))
assert(Equal [2 pxa t00] (cmd-parts (cmd-pk pxa t00)))

;; a chore driver node marks fresh request kids through the shared
;; inbox kook, and a cull clears them — the worker's notification
(Seq (define xq (app ["x_query_h"])) (DeepSeq xq 0))
;; the committed read wants the sovereign's current epoch as its case
;; (what helm-loop's query verb passes), not 0
(define (xq-now pax sv) (xq (Ix 2 sv) pax sv))
(Seq (define tcx ("ts" "cx")) (DeepSeq tcx 0))
(Seq (define rc1 (run-event (vine-make [tio tcx] (chore-cfg tdbl)) 0 seeded)) (DeepSeq rc1 0))
(Seq (define rc2 (run-event (vine-make [tio tcx ("ts" "r1")] (chore-req tdbl)) 0 (_0 rc1))) (DeepSeq rc2 0))
(Seq (define drec (xq-now [tio tcx] (_0 rc2))) (DeepSeq drec 0))
assert(Eq "/boot/res/known" (Hd drec))
assert(Equal [("ts" "r1")] (fresh-f (_0 drec)))
(Seq (define rc3 (run-event (vine-cull [tio tcx ("ts" "r1")]) 0 (_0 rc2))) (DeepSeq rc3 0))
(Seq (define drec2 (xq-now [tio tcx] (_0 rc3))) (DeepSeq drec2 0))
assert(Equal [] (fresh-f (_0 drec2)))
