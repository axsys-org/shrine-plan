(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; helm.foil: the pure IO-driver core.  Runtime shapes: boot/pulse/
;;; exec return (0 hm out); hm is the helm row ("/boot/helm" sov reg
;;; eyes crew) — _0=sov _1=reg _2=eyes _3=crew; duties are
;;; ("/boot/duty/birth" n res) / ("/boot/duty/fell" n) /
;;; ("/boot/duty/tell" n res) / ("/boot/duty/ack" n rsvp); rsvp is
;;; ("/boot/rsvp/ok" maybe-path) / ("/boot/rsvp/no" err); res is
;;; ("/boot/res/known" m) / "/boot/res/null" / "/boot/res/unknown".
;;; The demo registry and task builders come from a separate lainapp
;;; compile — PLAN values interop.

;; one compilation serves both the helm core and the lainapp fixtures
(define helm-sut (foil:compile-mod foil:default-subject "helmapp"))
(define (hlm path) (foil:source-entry-val path helm-sut))
(define app hlm)

(define helm-boot (hlm ["helm" "boot"]))
(define helm-exec (hlm ["helm" "exec"]))
(define ukeys (hlm ["uon" "keys"]))

(define seeded (app ["seeded"]))
(define sov0 seeded)
(define t00 (app ["myth" "new"]))
(define msing (app ["myth" "sing"]))
(define pd (app ["pd"]))
(define (t-data slot n) (msing slot (pd n)))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define vine-cull (app ["vine_cull"]))
(define run-event (app ["run_event"]))

(define na ("ts" "a"))
(define nb ("ts" "b"))
(define nc ("ts" "c"))
(define tio ("ts" "io"))
(define slot [("ts" "s")])

;; a sovereign with /io/a and /io/b already made
(define r0a (run-event (vine-make [tio na] (t-data slot 1)) 0 sov0))
(define r0b (run-event (vine-make [tio nb] (t-data slot 2)) 0 (_0 r0a)))
(define sAB (_0 r0b))

;;; 1. boot births every existing name and sets the crew ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define b0 (helm-boot sAB))
(define hm0 (_0 b0))
(define out0 (_1 b0))
assert(Eq 2 (Sz out0))
(define d0a (Ix 0 out0))
assert(Eq "/boot/duty/birth" (Hd d0a))
assert(Equal na (_0 d0a))
assert(Eq "/boot/res/known" (Hd (_1 d0a)))
assert(Eq "/boot/duty/birth" (Hd (Ix 1 out0)))
assert(Equal nb (_0 (Ix 1 out0)))
assert(Equal [na nb] (ukeys (_2 hm0)))

;; boot on a fresh sovereign births nothing
(define bfresh (helm-boot sov0))
assert(Eq 0 (Sz (_1 bfresh)))
assert(Equal [] (ukeys (_2 (_0 bfresh))))

;;; 2. a poke to a driven name tells its actor and acks the sender ;;;;;;;;;;;;;;;;;

(define e1 (helm-exec ("/boot/maybe/some" na) (vine-poke [tio na] (t-data slot 7)) hm0))
(define hm1 (_0 e1))
(define out1 (_1 e1))
assert(Eq 2 (Sz out1))
(define d1t (Ix 0 out1))
assert(Eq "/boot/duty/tell" (Hd d1t))
assert(Equal na (_0 d1t))
;; the tell names the watched path that fired
assert(Equal [tio na] (_1 d1t))
assert(Eq "/boot/res/known" (Hd (_2 d1t)))
(define d1k (Ix 1 out1))
assert(Equal ("/boot/duty/ack" na ("/boot/rsvp/ok" ("/boot/maybe/some" [tio na]))) d1k)

;;; 3. membership: makes birth, culls fell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define e2 (helm-exec ("/boot/maybe/some" na) (vine-make [tio nc] (t-data slot 3)) hm1))
(define hm2 (_0 e2))
(define out2 (_1 e2))
;; a birth for c (no tell: it was never watched), then the ack
assert(Eq 2 (Sz out2))
assert(Eq "/boot/duty/birth" (Hd (Ix 0 out2)))
assert(Equal nc (_0 (Ix 0 out2)))
assert(Eq "/boot/duty/ack" (Hd (Ix 1 out2)))
assert(Equal [na nb nc] (ukeys (_2 hm2)))

(define e3 (helm-exec ("/boot/maybe/some" na) (vine-cull [tio nb]) hm2))
(define hm3 (_0 e3))
(define out3 (_1 e3))
assert(Eq 2 (Sz out3))
assert(Equal ("/boot/duty/fell" nb) (Ix 0 out3))
assert(Eq "/boot/duty/ack" (Hd (Ix 1 out3)))
assert(Equal [na nc] (ukeys (_2 hm3)))

;;; 4. non-/io writes stay silent; failures nack and leave the helm ;;;;;;;;;;;;;;;;

(define e4 (helm-exec ("/boot/maybe/some" nc) (vine-make [("ts" "data") ("ts" "x")] t00) hm3))
(define out4 (_1 e4))
assert(Eq 1 (Sz out4))
assert(Equal ("/boot/duty/ack" nc ("/boot/rsvp/ok" ("/boot/maybe/some" [("ts" "data") ("ts" "x")]))) (Ix 0 out4))

(define e5 (helm-exec ("/boot/maybe/some" nc) (vine-poke [("ts" "zz")] t00) (_0 e4)))
assert(Equal [("/boot/duty/ack" nc ("/boot/rsvp/no" ("ts" "poke_missing")))] (_1 e5))
;; the sovereign did not advance
assert(Eq (_2 (_0 (_0 e4))) (_2 (_0 (_0 e5))))

;; an unnamed source gets no ack duty
(define e6 (helm-exec "/boot/maybe/none" (vine-poke [tio na] (t-data slot 8)) (_0 e5)))
assert(Eq 1 (Sz (_1 e6)))
assert(Eq "/boot/duty/tell" (Hd (Ix 0 (_1 e6))))

;;; 5. fired watches re-arm: consecutive changes both tell ;;;;;;;;;;;;;;;;;;;;;;;;;

(define e7 (helm-exec "/boot/maybe/none" (vine-poke [tio na] (t-data slot 9)) (_0 e6)))
assert(Eq 1 (Sz (_1 e7)))
assert(Eq "/boot/duty/tell" (Hd (Ix 0 (_1 e7))))
(define e8 (helm-exec "/boot/maybe/none" (vine-poke [tio nc] (t-data slot 4)) (_0 e7)))
assert(Eq 1 (Sz (_1 e8)))
assert(Equal nc (_0 (Ix 0 (_1 e8))))

;;; 6. spies: one-shot watches on arbitrary paths ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define helm-spy (hlm ["helm" "spy"]))
(define dx [("ts" "data") ("ts" "x")])
(define hm-s (helm-spy na dx (_0 e8)))
(define e9 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 11)) hm-s))
(define out9 (_1 e9))
assert(Eq 1 (Sz out9))
(define d9 (Ix 0 out9))
assert(Eq "/boot/duty/tell" (Hd d9))
assert(Equal na (_0 d9))
assert(Equal dx (_1 d9))
assert(Eq "/boot/res/known" (Hd (_2 d9)))
;; the spy is consumed: a second write is silent
(define e10 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 12)) (_0 e9)))
assert(Eq 0 (Sz (_1 e10)))
;; re-spying tells again
(define hm-s2 (helm-spy na dx (_0 e10)))
(define e11 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 13)) hm-s2))
assert(Eq 1 (Sz (_1 e11)))
assert(Equal dx (_1 (Ix 0 (_1 e11))))
;; a spy for a dead name fires into the void
(define hm-s3 (helm-spy nb dx (_0 e11)))
(define e12 (helm-exec "/boot/maybe/none" (vine-poke dx (t-data slot 14)) hm-s3))
assert(Eq 0 (Sz (_1 e12)))

;;; 7. the /boot mirror pails: tpail/code construct, read, render ;;;;;;;;;;;;;;;;;;

(define show-pail (app ["show_pail"]))
assert(Equal "hi" (show-pail ("/boot/pails/t" "hi")))
assert(Equal "code" (show-pail ("/boot/pails/code" 42)))

(define boot-ent-t (app ["boot_ent_t"]))
(define txt-slot (app ["myth" "txt_at"]))
(define code-slot (app ["myth" "code_at"]))
(define has-slot (app ["myth" "has_at"]))
(define kslot [("ts" "kind")])
(define cslot [("ts" "code")])

;; lowered: kind, src, and the value
(define me1 (boot-ent-t 7 "function" "+ x" 1 0 0 [] []))
assert(Equal "function" (txt-slot kslot me1))
assert(Equal "+ x" (txt-slot [("ts" "src")] me1))
assert(Eq 7 (code-slot cslot me1))
;; unlowered: no code slot
(define me0 (boot-ent-t 7 "function" "+ x" 0 0 0 [] []))
assert(Eq 0 (has-slot cslot me0))
;; a code slot read through the text reader is 0, and vice versa
assert(Eq 0 (txt-slot cslot me1))
assert(Eq 0 (code-slot kslot me1))

;; lore: present when the flag is set, absent when not; the pail
;; renders opaque until the explorer learns it (shrine-apps phase 6)
(define lslot [("ts" "lore")])
(define meL
  (boot-ent-t 7 "function" "+ x" 1
    1 "adds." ["adds." "twice."] [["(add 1 1)" "2"]]))
assert(Eq 1 (has-slot lslot meL))
assert(Eq 0 (has-slot lslot me1))
;; the explorer renders lore: head only, doctest count when present
assert(Equal "h" (show-pail ("/boot/lore" "h" ["h"] [])))
(define boot-src-t (app ["boot_src_t"]))
(define msL (boot-src-t "-  lain" 1 "the module." ["the module."] []))
assert(Eq 1 (has-slot lslot msL))
assert(Equal "-  lain" (txt-slot [("ts" "src")] msL))
assert(Eq 0 (has-slot lslot (boot-src-t "-  lain" 0 0 [] [])))

;; the extra mirror slots: type text always when given, law and refs
;; only when present — absent means no slot, not a zero slot
(define boot-ent-x (app ["boot_ent_x"]))
(define tyslot [("ts" "ty")])
(define lawslot [("ts" "law")])
(define callslot [("ts" "calls")])
(define cbslot [("ts" "called_by")])
(define pxa9 [("ts" "boot") ("ts" "bst")])
(define mex (boot-ent-x "nat" 0 [pxa9] [] me1))
assert(Equal "nat" (txt-slot tyslot mex))
assert(Eq 0 (has-slot lawslot mex))
assert(Eq 1 (has-slot callslot mex))
assert(Eq 0 (has-slot cbslot mex))
;; the base record's slots survive the layering
assert(Equal "function" (txt-slot kslot mex))
(define mex0 (boot-ent-x 0 0 [] [] me1))
assert(Eq 0 (has-slot tyslot mex0))
;; fail cards and ns indices
(define boot-fail-t (app ["boot_fail_t"]))
(define mf (boot-fail-t "boom"))
assert(Equal "failed" (txt-slot [("ts" "status")] mf))
assert(Equal "boom" (txt-slot [("ts" "err")] mf))
(define boot-ns-t (app ["boot_ns_t"]))
assert(Eq 1 (has-slot [("ts" "entries")] (boot-ns-t [pxa9])))

;;; 8. the chore vocabulary: the generic async-task records ;;;;;;;;;;;;;;;;;;;;;;;;

(define chore-req (app ["chore" "req"]))
(define chore-cfg (app ["chore" "cfg"]))
(define fam-of (app ["chore" "fam_of"]))
(define done-t (app ["chore" "done_t"]))
(define fail-t (app ["chore" "fail_t"]))
(define clear-t (app ["chore" "clear_t"]))
(define cmd-parts (app ["chore" "cmd_parts"]))
(define cmd-mkp (app ["chore" "mkp_t"]))
(define cmd-mk (app ["chore" "make_t"]))
(define cmd-pk (app ["chore" "poke_t"]))
(define nat-slot (app ["myth" "nat_at"]))
(define fresh-f (app ["fetch" "fresh"]))
(define tdbl ("ts" "dbl"))

;; family resolution: the record's own fam, else the default
assert(Equal tdbl (fam-of ("ts" "zz") (chore-req tdbl)))
assert(Equal ("ts" "zz") (fam-of ("ts" "zz") t00))
assert(Equal tdbl (fam-of 0 (chore-cfg tdbl)))

;; completion records
(define dn (done-t 3 1))
assert(Eq 1 (nat-slot [("ts" "res_done")] 0 dn))
assert(Eq 3 (nat-slot [("ts" "passed")] 0 dn))
assert(Eq 1 (nat-slot [("ts" "failed")] 0 dn))
(define fl (fail-t ("ts" "fam_unknown")))
assert(Eq 1 (nat-slot [("ts" "res_done")] 0 fl))
assert(Eq 0 (nat-slot [("ts" "res_ok")] 1 fl))
assert(Eq 0 (nat-slot [("ts" "fresh") ("ts" "k")] 1 (clear-t ("ts" "k"))))

;; the cmd vocabulary, host-shaped: [kind pax t]
(define pxa [("ts" "a")])
assert(Equal [0 pxa t00] (cmd-parts (cmd-mkp pxa t00)))
assert(Equal [1 pxa t00] (cmd-parts (cmd-mk pxa t00)))
assert(Equal [2 pxa t00] (cmd-parts (cmd-pk pxa t00)))

;; a chore driver node marks fresh request kids through the shared
;; inbox kook, and a cull clears them — the worker's notification
(define xq (app ["x_query_h"]))
;; the committed read wants the sovereign's current epoch as its case
;; (what helm-loop's query verb passes), not 0
(define (xq-now pax sv) (xq (Ix 2 sv) pax sv))
(define tcx ("ts" "cx"))
(define rc1 (run-event (vine-make [tio tcx] (chore-cfg tdbl)) 0 seeded))
(define rc2 (run-event (vine-make [tio tcx ("ts" "r1")] (chore-req tdbl)) 0 (_0 rc1)))
(define drec (xq-now [tio tcx] (_0 rc2)))
assert(Eq "/boot/res/known" (Hd drec))
assert(Equal [("ts" "r1")] (fresh-f (_0 drec)))
(define rc3 (run-event (vine-cull [tio tcx ("ts" "r1")]) 0 (_0 rc2)))
(define drec2 (xq-now [tio tcx] (_0 rc3)))
assert(Equal [] (fresh-f (_0 drec2)))
