(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind debugger-source (#module grove-debugger-source))
(#bind driver (#module foil-new-env))
(#bind bootstrap (#module foil-bootstrap))
(#bind abi (#module foil-abi))
(#bind eden (#module eden))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define self ("x" 17))
(define (qualified xs) (Weld [self] (path xs)))
(define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
(define slot (qualified ["compiler" "artifact"]))
(define (module name code)
  (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) (_2 code))))))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["debugger-build" result])))
(define (check ignored)
  (print "DEBUGGER-BOOTSTRAPPING-SYSTEM")
  (define system (bootstrap:build-system (Pin "grove-debugger-fixture/v2") resolve slot))
  (Seq (force system) (print "DEBUGGER-BOOTSTRAPPING-LOCAL"))
  (define local (bootstrap:build-local self system resolve slot
    ["eden_debug" "grove_backend" "tests/grove_backend"
     "tests/grove_debugger" "tests/web_debug"]))
  (define code (_1 local))
  (define prepared (backend:prepare-with code "debugger_contract"))
  (define policy (_1 prepared))
  (define host (module "eden_debug" code))
  (define fixtures (module "tests/grove_debugger" code))
  (define helpers (module "tests/grove_backend" code))
  (define (helper name) (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (fixture name) (driver:get-perc ["debugger_fixture" name] fixtures))
  (print ("DEBUGGER-HOST-COMPILED"
    (Seq (force (driver:get-perc ["eden_debug" "main"] host)) 1)))
  ;; This runs the production publisher/installer, but never starts actors.
  (define state (ok ((driver:get-perc ["eden_debug" "boot"] host)
    self (bootstrap:trusted system) (_1 (_0 local)) 18131
    (read-text-file "grove/value_codecs.grove")
    (debugger-source:read 0) (abi:option host "none")
    (eden:application-ports prepared host))))
  (define (record names)
    (_0 ((helper "lookup_namespace") state [] (qualified names))))
  (define shell (record ["gov" "debug" "shell"]))
  assert(Equal (map qualified [["gov" "debug" "request"]
    ["gov" "debug" "response"]]) ((helper "sewn_summary") shell))
  assert(Eq 1 ((fixture "invalid") shell))
  (print ("DEBUGGER-HTML" ((fixture "render") shell)))
  (print ("DEBUGGER-DETAILS-HTML" ((fixture "details") (record ["gov" "debug" "inspector"]))))
  (define first-installed ((fixture "application") state
    (qualified ["gov" "debug"]) (qualified ["app" "second-debugger"])))
  (define second-installed ((fixture "application") state
    (qualified ["gov" "debug"]) (qualified ["app" "another-debugger"])))
  assert(Eq 1 (Sz first-installed))
  assert(Eq 1 (Sz second-installed))
  (define app (_0 first-installed))
  (define second (_0 second-installed))
  assert(Eq 1 ((fixture "application_checks") app second))
  assert(Eq 1 ((fixture "capture_checks") state (qualified ["app" "debug" "page"])))
  (print "DEBUGGER-PINNED-BOUNDARY-PASS")
  (print "DEBUGGER-APPLICATION-PASS")
  (print ("DEBUGGER-PAGE-HTML" ((fixture "page") app)))
  (print ("DEBUGGER-EDGE-HTML" ((fixture "page_edge") app)))
  (print ("DEBUGGER-DOCUMENT-HTML" ((fixture "document") app)))
  (define boundary (module "tests/web_debug" code))
  assert(Eq 0 (Sz ((fixture "failures") (driver:get-perc ["tests"] boundary))))
  ;; Import stored definitions under the same publication/compiler identity.
  (define test-policy (backend:prepare-with code "tests/grove_debugger"))
  (define (lookup requested)
    ((helper "lookup_namespace") state [] requested))
  (define x (abi:constructor host ["care" "x"]))
  (define (previous canonical)
    (define found ((driver:get-perc ["namespace" "case"] host) x
      (map (lambda (part) ((_0 part) (_1 part))) canonical) state))
    (If (Eq 1 (Sz found)) (_0 found) 0))
  (define document (ok ((driver:get-perc ["grove" "parse"] policy)
    (read-text-file "grove/tests/debugger.grove"))))
  (define tests (ok (backend:compile test-policy previous lookup
    (qualified ["test" "debugger"]) document)))
  (define checks (_0 ((helper "lookup") tests (qualified ["test" "debugger" "debugger_checks"]))))
  (define failures ((fixture "failures") ((helper "export") (path ["tests"]) checks)))
  (print ("DEBUGGER-MODEL-FAILURES" failures))
  assert(Eq 0 (Sz failures))
  (print "DEBUGGER-DECLARATION-PASS")
  1)
assert(Eq 1 (check 0))
