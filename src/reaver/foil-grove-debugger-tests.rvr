(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind debugger-source (#module grove-debugger-source))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["debugger-build" result])))
(define (check ignored)
  (define prepared (backend:prepare-with 0 "debugger_contract"))
  (define policy (_1 prepared))
  (define helpers (source:compile (_0 prepared) "tests/grove_backend"))
  (define fixture-build (source:compile (_0 helpers) "tests/grove_debugger"))
  (define fixtures (_1 fixture-build))
  ;; Type-check the real host entry too: a rendering fixture alone cannot
  ;; prove that the separate namespace can actually be launched.
  (define host (source:compile (_0 fixture-build) "eden_debug"))
  ;; Lowered entries may be pinned; PLAN Arity is not their source signature.
  (print ("DEBUGGER-HOST-COMPILED"
    (Seq (force (driver:get-perc ["eden_debug" "main"] (_1 host))) 1)))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] (_1 helpers)))
  (define (fixture name)
    (driver:get-perc ["debugger_fixture" name] fixtures))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing key) "/boot/maybe/none")
  (define types (ok (backend:compile prepared missing (path ["sys" "types"])
    (parse (read-text-file "grove/sys_types.grove")))))
  (define records (ok (backend:compile prepared ((helper "lookup") types)
    (path ["weft" "debug" "v1"])
    (parse (debugger-source:read 0)))))
  (define shell (_0 (((helper "lookup") records) (path ["weft" "debug" "v1" "shell"]))))
  assert(Equal (map path [["weft" "debug" "v1" "request"]
    ["weft" "debug" "v1" "response"]]) ((helper "sewn_summary") shell))
  assert(Eq 1 ((fixture "invalid") shell))
  (print ("DEBUGGER-HTML" ((fixture "render") shell)))
  (define inspector (_0 (((helper "lookup") records) (path ["weft" "debug" "v1" "inspector"]))))
  (print ("DEBUGGER-DETAILS-HTML" ((fixture "details") inspector)))
  (define page (_0 (((helper "lookup") records) (path ["weft" "debug" "v1" "page"]))))
  (print ("DEBUGGER-PAGE-HTML" ((fixture "page") page)))
  (print ("DEBUGGER-DOCUMENT-HTML" ((fixture "document") records)))
  (define boundary (source:compile (_0 host) "tests/web_debug"))
  assert(Eq 0 (Sz ((fixture "failures") (driver:get-perc ["tests"] (_1 boundary)))))
  ;; Compile a consumer against stored Grove exports, not a duplicate renderer.
  (define test-policy (backend:prepare-with (_0 host) "tests/grove_debugger"))
  (define tests (ok (backend:compile test-policy ((helper "lookup") records)
    (path ["test" "debugger"]) (parse (read-text-file "grove/tests/debugger.grove")))))
  (define checks (_0 (((helper "lookup") tests) (path ["test" "debugger" "debugger_checks"]))))
  (define failures ((fixture "failures") ((helper "export") (path ["tests"]) checks)))
  (print ("DEBUGGER-MODEL-FAILURES" failures))
  assert(Eq 0 (Sz failures))
  (print ("DEBUGGER-DECLARATION-PASS" (Sz records)))
  1)
assert(Eq 1 (check 0))
