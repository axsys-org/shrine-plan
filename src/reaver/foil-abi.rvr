;;;; Runtime constructor identities come from the selected compiled subject.
;;;; Hosts never reconstruct a nominal brand from a loader name or a path cord.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind subject (#module foil-subject))
(#bind nt (#module foil-new-types))
(#bind elab (#module foil-new-elab))

(define (constructor perc path)
  (define sut (driver:perc-subject perc))
  (define key (subject:resolve-source-path path sut))
  (define runtime (_1 (nt:runtime-key (driver:perc-world perc)
    (nt:type-ref key))))
  (If (And runtime (_0 runtime)) (_0 runtime)
    (error ["missing-compiler-abi-constructor" path])))

(define (member perc path name arguments)
  (define sut (driver:perc-subject perc))
  (define key (subject:resolve-source-path path sut))
  (define typ
    (If (Sz arguments) (nt:type-app key (map nt:type-arg arguments))
      (nt:type-ref key)))
  (define found (elab:relvar-member (elab:compiler-for sut)
    0 name typ "compiler ABI member"))
  (_1 (_3 found)))

(define (option perc name) (member perc ["maybe"] name [nt:tany]))
(define (result perc name) (member perc ["either"] name [nt:tany nt:tany]))

(#export constructor member option result)
