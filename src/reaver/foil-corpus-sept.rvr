(#bind std (#module std))
(#import std)

(#bind foil (#module foil))

;;; Tier 1 of the shared test corpus.  Each tier compiles one slice of
;;; the corpus, continuing the previous tier's compile-mod-cached
;;; cache, so a suite binds exactly its chain prefix: standalone runs
;;; pay their own corpus only, while an aggregate session compiles
;;; each module once.  Module loading forces top-levels, so laziness
;;; cannot do this within one module — the tiers are the laziness.

(define result (foil:compile-mod-cached 0 foil:default-subject "sept"))
(define cache (_0 result))
(define sept-sut (_1 result))

(#export cache sept-sut)
