;;;; Tree transformations validate both sides of their norm boundary.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["sewn-build" result])))
(define (check ignored)
  (define prepared (backend:prepare 0))
  (define policy (_1 prepared))
  (define helpers (_1 (source:compile (_0 prepared)
    "tests/grove_backend")))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing key) "/boot/maybe/none")
  (define (compile lookup root text)
    (backend:compile prepared lookup (path root) (parse text)))
  (define slots (ok (compile missing ["sys"]
    (read-text-file "grove/sys_slots.grove"))))
  (define types (ok (compile missing ["sys" "types"]
    (read-text-file "grove/sys_types.grove"))))
  (define lookup ((helper "lookup") (Weld slots types)))
  (define srs (parse (read-text-file "grove/srs.grove")))
  (define records (ok (backend:compile prepared lookup
    (path ["gov" "srs"]) srs)))
  assert(Eq 10 (Sz records))
  (define stored ((helper "lookup") records))
  assert(Eq 1 ((helper "tree_seed_checks") records))
  (define (tree key body)
    (strcat [34 key 34 " =
  @tree
" body "
"]))
  (define (reject text)
    (define result (compile stored ["gov" "bad"] text))
    assert(Equal "err" (Hd result))
    assert(Gt (_0 (_0 (_0 result))) 0)
    1)
  assert(Eq 1 (reject (strcat [(tree "/same" "")
    (tree "/same" "")])))
  ;; Definition and instance names belong to distinct namespaces.
  assert(Eq 2 (Sz (ok (compile missing ["gov" "separate"]
    (strcat ["same =
  @slot

" (tree "/same" "")])))))
  assert(Eq 1 (reject (tree "/a//b" "")))
  assert(Eq 1 (reject (tree "/a/../b" "")))
  assert(Eq 1 (reject (tree "/view" "  tack: '@/y/%/missing
")))
  assert(Eq 1 (reject (strcat [
    "#import n=gov/srs/cards_by_id

"
    (tree "/items" "  #like ; n
  #like ; n
") ])))
  assert(Eq 1 (reject (strcat [
    "#import n=gov/srs/cards_by_id

"
    (tree "/items" "  #like ; n
")
    (tree "/items/bad" "") ])))
  assert(Eq 1 (reject (strcat [
    "#import n=gov/srs/card

"
    (tree "/items" "  #like ; n
") ])))
  assert(Eq 1 (reject (strcat [
    "#import n=gov/srs/card

"
    (tree "/view" (strcat ["  " 34 "/sys/weft" 34
      ": n
  " 34 "/sys/tack" 34 ": '@/y/%/cards
"])) ])))
  (define fresh (backend:prepare 0))
  (define external (ok (backend:compile fresh stored
    (path ["gov" "external"])
    (parse (strcat ["#import n=gov/srs/cards_by_id

"
      (tree "/items" "  #like ; n
")])))))
  assert(Eq 1 (Sz external))
  (define install-mod (_1 (source:compile (_0 prepared)
    "tests/grove_install")))
  (define install (driver:get-perc ["grove_install_checks" "check"]
    install-mod))
  assert(Eq 1 (ok (install records)))
  ;; Compilation produces shared publications and reusable templates.
  (define boot-mod (_1 (source:compile (_0 prepared) "tests/eden_srs")))
  (define (boot-helper name)
    (driver:get-perc ["eden_srs" name] boot-mod))
  (define build (ok ((boot-helper "compile")
    (read-text-file "grove/sys_slots.grove")
    (read-text-file "grove/sys_types.grove")
    (read-text-file "grove/srs.grove")
    (backend:compile-port (_1 prepared) (_2 prepared)))))
  assert(Equal records (_1 (_2 build)))
  (define first ((boot-helper "boot") 18131 build))
  (define second ((boot-helper "boot") 18132 build))
  assert(Equal "ok" (Hd first))
  assert(Equal "ok" (Hd second))
  assert(Eq 1 ((driver:get-perc
    ["eden_srs_checks" "atomic_install"] boot-mod) build))
  assert(Eq 1 ((driver:get-perc
    ["eden_srs_checks" "instance_install"] boot-mod) build))
  ;; Existing publication roots cannot be overwritten.
  assert(Equal "err" (Hd ((boot-helper "publish") build (ok first))))
  1)
assert(Eq 1 (check 0))
