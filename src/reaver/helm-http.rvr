(#bind quip (#module quip))
(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind milton (#module milton))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind http-client (#module http-client))
(#bind helm-fetch (#module helm-fetch))
(#bind helm-chore (#module helm-chore))
(#bind helm-doctest (#module helm-doctest))
(#bind helm-build (#module helm-build))
(#bind doctest (#module doctest))
(#bind foil-render (#module foil-render))


;;; The HTTP driver: a helm worker whose requests ride the namespace.
;;; An incoming request is WRITTEN as a record at a fresh path under
;;; the driver's own name (/io/<name>/r<serial>), carrying the kook
;;; named by the driver's config record; the serving behavior writes
;;; ['res_status] / ['res_body] slots onto it — same event (init) or
;;; later — and the driver, watching the node through a helm spy,
;;; feeds those slots back as the HTTP response and culls the node.
;;;
;;; Config record at /io/<name>: ['serve] = the behavior id to stamp
;;; on request nodes; ['port] = the TCP port (absent: no listener —
;;; the mode tests use, driving requests as messages).
;;;
;;; Worker mailbox:
;;;   from the coordinator: ["go" res] ["change" pax res]
;;;                         ["ack" rsvp] ["die"]
;;;   from connection actors (or tests): ["req" method url body],
;;;     caps = [reply-handle]; answered with ["res" status body].
;;;
;;; Ack correlation: worker->coordinator sends are FIFO and the
;;; coordinator acks each cmd within its turn, so acks return in cmd
;;; order — a queue of [pax kind] entries pairs each ack with its
;;; command (failed acks carry no path).  Write-box entries are
;;; [pax "vine" conn-cap]: the connection waits on the ack, so the
;;; reply reports the kernel's actual verdict and never races the
;;; commit.  EVERY cmd this worker sends must push a queue entry, or
;;; later acks pop the wrong one.

;;; HTTP plumbing (local — forge's helpers, without dragging forge in)

(define crlf (strWeld 13 10))

(define (str-drop off src)
  (Rsh src (Mul 8 off)))

;; The index just past the header/body separator (CRLFCRLF), or 0.
(define (request-body-start input)
  (define n (Bytes input))
  (define (go i)
    (cond
      ((Ge (Add i 3) n) 0)
      ((and (Eq 13 (Load8 i input))
         (and (Eq 10 (Load8 (Add i 1) input))
           (and (Eq 13 (Load8 (Add i 2) input))
             (Eq 10 (Load8 (Add i 3) input)))))
        (Add i 4))
      (else (go (Inc i)))))
  (go 0))

(define (request-body input)
  (define start (request-body-start input))
  (Ifz start "" (str-drop start input)))

(define (status-line status)
  (cond
    ((Eq status 200) "HTTP/1.0 200 OK")
    ((Eq status 400) "HTTP/1.0 400 Bad Request")
    ((Eq status 404) "HTTP/1.0 404 Not Found")
    ((Eq status 500) "HTTP/1.0 500 Internal Server Error")
    (else (strcat ["HTTP/1.0 " (showNat status) " Status"]))))

(define (http-res status ctype body)
  (lstrcat
    ~[(status-line status) crlf
      "Content-Type: " ctype crlf
      crlf body]))

(define (str-slice off len src)
  (Mod (Rsh src (Mul 8 off)) (Lsh 1 (Mul 8 len))))

(define (split-ch ch s)
  (define n (Bytes s))
  (define (go i start acc)
    (If (Ge i n)
      (snoc (str-slice start (Sub i start) s) acc)
      (If (Eq ch (Load8 i s))
        (go (Inc i) (Inc i) (snoc (str-slice start (Sub i start) s) acc))
        (go (Inc i) start acc))))
  (go 0 0 []))

;; "/ns/a/3/$s" -> [[("ts" "a") ("u" 3) ("ta" "s")]]; "/", "/ns" -> [[]].
;; Each segment parses through the aura codec, so numeric segments
;; arrive as u quips and $-segments as strings; an unparseable segment
;; yields 0 and the caller 404s.  A leading "ns" segment is the
;; explorer's own prefix and is dropped.
(define (url-target u)
  (define parts (filter (lambda (x) (Nil (Eq 0 (Bytes x)))) (split-ch 47 u)))
  (define parts2
    (If (And (Sz parts) (Equal "ns" (Ix 0 parts)))
      (drop 1 parts)
      parts))
  (define (go i acc)
    (If (Eq i (Sz parts2)) [acc]
      (let ((r (quip:parse-quip-soft (Ix i parts2))))
        (Ifz r 0 (go (Inc i) (snoc (_0 r) acc))))))
  (go 0 []))

;; Rendered text for a kernel rejection's err iota: the canonical quip
;; spelling when it has one, else the flat diagnostic walk.
(define (err-text e)
  (define r (Try (lambda (z) (quip:print-quip e)) 0))
  (If (Eq 1 (Hd r)) (foil-render:diag-flat e) (_0 r)))

;; The write box's replies, both minted only when the ack lands.
(define (vine-back-page pax)
  (define loc (strWeld "/ns" (quip:print-path pax)))
  (strcat ["<!doctype html><html><head><meta http-equiv=" 34 "refresh" 34
           " content=" 34 "0;url=" loc 34 "></head><body>committed; <a href="
           34 loc 34 ">back to the node</a></body></html>"]))

(define (vine-fail-page pax err)
  (define loc (strWeld "/ns" (quip:print-path pax)))
  (strcat ["<!doctype html><html><body><p>write rejected: <code>"
           (err-text err) "</code></p><p><a href=" 34 loc 34
           ">back to the node</a></p></body></html>"]))

;; A myth is a mop at runtime; anything else poked into the kernel
;; dies INSIDE the coordinator's exec (a non-exhaustive mop match), so
;; the write box refuses non-myth expression values up front.
(define (myth-rep? v)
  (Or (Eq "/boot/mop/empty" v)
    (And (IsApp v) (Eq "/boot/mop/node" (Hd v)))))

;;; Socket layer (thin; blocking IO lives in its own actors) ;;;;;;;;;;;;;;;;;;;;;;;

;; One actor per connection: handshake for the worker handle (handles
;; are per-actor capabilities — they only cross actors through caps,
;; never through closures), then read, parse, ask the worker, write
;; the response (with the sentinel byte — Write drops the top byte),
;; close.
(define (conn-actor fd self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  ;; Read returns a bar (data then a 0x01 terminator): strip the
  ;; terminator, or a request body would carry a stray trailing 0x01
  (define raw (Read fd 65536))
  (define input (str-slice 0 (Dec (Bytes raw)) raw))
  (define parsed (Try milton:parse-http-request input))
  (define method (If (Eq 1 (Hd parsed)) "GET" (Ix 0 (_0 parsed))))
  (define target (If (Eq 1 (Hd parsed)) "/" (Ix 1 (_0 parsed))))
  (define body (request-body input))
  (define m ["req" method target body])
  (Seq (DeepSeq m m)
    (Seq (SendCaps wh m [0])
      (let ((r (Ix 0 (Recv 0))))
        (Seq (Write fd (strWeld (http-res (_1 r) (_3 r) (_2 r)) 1))
          (CloseFd fd))))))

;; Accept loop: handshake for the worker handle, then one actor per
;; connection — the worker cap is re-delegated to each via SendCaps.
(define (listener-pump port self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define listenx (Try Listen port))
  (If (Eq 1 (Hd listenx))
    (Seq (Trace ["pump: listen failed" port (_0 listenx)] 0)
      (Send wh ["noport" port]))
    (let ((fd (_0 listenx)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (let ((c (Spawn (conn-actor conn))))
               (SendCaps c ["go"] [wh]))
          (loop z)))
      (Seq (Trace ["pump: listening" port] 0)
        (Seq wh (loop 0))))))

;;; Form bodies (application/x-www-form-urlencoded) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (hex-val c)
  (cond
    ((And (Ge c 48) (Le c 57)) (Sub c 48))
    ((And (Ge c 97) (Le c 102)) (Sub c 87))
    ((And (Ge c 65) (Le c 70)) (Sub c 55))
    (else 0)))

;; CR bytes are dropped: browsers normalize every form value to CRLF
;; on submit, and nothing downstream (semidoc reparse, foil eval)
;; speaks \r — an editor POST arrived as \r\n-lines and wrecked the
;; reparse, and even a one-line run expr picked up a trailing \r.
(define (url-decode s)
  (define n (Bytes s))
  (define (emit c rest)
    (If (Eq c 13) rest (lcons c rest)))
  (define (go i)
    (If (Ge i n)
      0
      (let ((c (Load8 i s)))
        (cond
          ((Eq c 43) (lcons 32 (go (Inc i))))
          ((And (Eq c 37) (Lt (Add i 2) n))
            (emit
              (Add (Mul 16 (hex-val (Load8 (Add i 1) s)))
                (hex-val (Load8 (Add i 2) s)))
              (go (Add i 3))))
          (else (emit c (go (Inc i))))))))
  (lstrcat (go 0)))

;; Strip leading/trailing whitespace bytes (space, tab, LF, CR).
(define (trim-ws s)
  (define n (Bytes s))
  (define (ws? b) (Or (Eq b 32) (Or (Eq b 9) (Or (Eq b 10) (Eq b 13)))))
  (define (start i) (If (And (Lt i n) (ws? (Load8 i s))) (start (Inc i)) i))
  (define (end i) (If (And (Gt i 0) (ws? (Load8 (Dec i) s))) (end (Dec i)) i))
  (define a (start 0))
  (define b (end n))
  (If (Ge a b) "" (Trunc (Mul 8 (Sub b a)) (Rsh s (Mul 8 a)))))

;; One urlencoded field's decoded value, or "".
(define (form-field name body)
  (define pre (strcat [name "="]))
  (define hit
    (find (lambda (p) (Eq pre (Mod p (Lsh 1 (Mul 8 (Bytes pre))))))
      (split-ch 38 body)))
  (Ifz hit "" (url-decode (Rsh (_0 hit) (Mul 8 (Bytes pre))))))

;; Every form field as decoded [name value] pairs, in body order.
;; Fields without an = are skipped.
(define (field-eq-idx p)
  (define n (Bytes p))
  (define (go i)
    (cond
      ((Ge i n) 0)
      ((Eq 61 (Load8 i p)) [i])
      (else (go (Inc i)))))
  (go 0))
(define (form-fields body)
  (define (pair p)
    (define hit (field-eq-idx p))
    (Ifz hit 0
      (let ((i (_0 hit)))
        [[(str-slice 0 i p)
          (url-decode (Rsh p (Mul 8 (Inc i))))]])))
  (foldl (lambda (acc p) (Weld acc (pair p))) [] (split-ch 38 body)))

;;; The worker ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; helpers = ["H" http/req myth/nat_at vine_make vine_cull myth/txt_at
;;            build/eval_req build/compile_req build/save_req] —
;; compiled lainapp/build entries, supplied by whoever spawns the
;; coordinator.  The last four ride only where the /chore bridge is
;; wired (the boot passes them; a short bundle disables the bridge).
(define (h-req hs) (Ix 1 hs))
(define (h-slot hs) (Ix 2 hs))
(define (h-make hs) (Ix 3 hs))
(define (h-cull hs) (Ix 4 hs))
(define (h-txt hs) (Ix 5 hs))
(define (h-evalreq hs) (Ix 6 hs))
(define (h-compreq hs) (Ix 7 hs))
(define (h-savereq hs) (Ix 8 hs))
(define (h-bridge? hs) (Gt (Sz hs) 5))
;; vine_poke + the compiled boot subject: the explorer's write box
;; (POST /vine/<path>) evaluates its expression against the subject
;; and emits the writ as a driver cmd.  Only the full boot bundle
;; carries them.
(define (h-poke hs) (Ix 9 hs))
(define (h-sut hs) (Ix 10 hs))
(define (h-vine? hs) (Gt (Sz hs) 9))
;; myth/new + myth/add + twig/txt: the form-post endpoint builds its
;; poke myth from the fields directly — no expression evaluation.
(define (h-myth0 hs) (Ix 11 hs))
(define (h-madd hs) (Ix 12 hs))
(define (h-twigt hs) (Ix 13 hs))
(define (h-post? hs) (Gt (Sz hs) 11))

;; "/vine" or "/vine/..." — the write box's endpoint.
(define (vine-url? u)
  (And (Eq "/vine" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; "/post/..." — the form-post endpoint: POST /post/<path> pokes the
;; target with a myth of ['post <field>] text slots, one per form
;; field (the "back" field is control data: the bounce destination).
;; The target's own talk arm decides what the post means — the same
;; authority split as the write box, minus the expression language.
(define (post-url? u)
  (And (Eq "/post" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; The poke myth for a form body: each field k=v except "back"
;; becomes a text pail at slot ['post <k>].
(define (post-myth hs body)
  (foldl
    (lambda (m kv)
      (If (Equal "back" (_0 kv))
        m
        ((h-madd hs)
         ((h-twigt hs) [("ts" "post") ("ts" (_0 kv))] (_1 kv))
         m)))
    (h-myth0 hs)
    (form-fields body)))

;; The form post's bounce: straight back to the page the form named.
(define (post-back-page loc)
  (strcat ["<!doctype html><html><head><meta http-equiv=" 34 "refresh" 34
           " content=" 34 "0;url=" loc 34 "></head><body>posted; <a href="
           34 loc 34 ">back</a></body></html>"]))

(define (pend-get pending pax)
  (find (lambda (e) (Equal pax (_0 e))) pending))

(define (pend-drop pending pax)
  (filter (lambda (e) (Nil (Equal pax (_0 e)))) pending))

;; A known record's myth, or 0 — the shared prologue of every
;; response reader.
(define (known-myth resrec)
  (If (Eq "/boot/res/known" (Hd resrec)) (_0 resrec) 0))

;; The record's response, if the serving behavior wrote it yet:
;; [status body ctype].
(define (res-of hs resrec)
  (define m (known-myth resrec))
  (Ifz m
    0
    (let ((status ((h-slot hs) [("ts" "res_status")] 0 m)))
      (Ifz status
        0
        [status
         ((h-slot hs) [("ts" "res_body")] 0 m)
         ((h-slot hs) [("ts" "res_ctype")] "text/plain; charset=utf-8" m)]))))

(define chore-nl (strcat [10]))

;; A chore request node's answer, once ['res_done] lands: the build
;; families' result slots rendered as plain text.
(define (chore-res-of hs resrec)
  (define m (known-myth resrec))
  (If (Or (Ifz m 1 0) (Nil (Eq 1 ((h-slot hs) [("ts" "res_done")] 0 m))))
    0
    (let* ((txt (h-txt hs))
               (err (txt [("ts" "err")] m))
               (report (txt [("ts" "report")] m))
               (value (txt [("ts" "value")] m))
               (tyt (txt [("ts" "ty")] m))
               (law (txt [("ts" "law")] m))
               (ct "text/plain; charset=utf-8"))
          (cond
            (err [500 err ct])
            (report [200 report ct])
            (value
              [200
               (strcat
                 ["value: " value
                  (Ifz tyt "" (strcat [chore-nl "type:  " tyt]))
                  (Ifz law "" (strcat [chore-nl chore-nl law]))])
               ct])
            (else [500 "chore failed" ct])))))

(define (mk-http-worker hs name self)
  ;; go handshake: the coordinator handle rides the caps; the config
  ;; record rides the message.  Forced before the loop (lazy defines
  ;; would let the loop steal it).  The config's serving kook — not
  ;; this driver — is what answers requests: request records are made
  ;; bare, the /io/<name> take installs the responder on them.
  (define mc (Recv 0))
  (define coord (Seq (DeepSeq mc mc) (Ix 0 (Ix 1 mc))))
  (define rec0 (_1 (Ix 0 mc)))
  (define port
    (If (Eq "/boot/res/known" (Hd rec0))
      ((h-slot hs) [("ts" "port")] 0 (_0 rec0))
      0))
  (define (rpath i)
    [("ts" "io") name ("ts" (strcat ["r" (showNat i)]))])
  ;; state: serial, pending = [[pax conn-cap] ..], queue = [[pax kind] ..]
  (define (loop serial pending queue)
    (define m (Recv 0))
    (define msg (Ix 0 m))
    (define caps (Ix 1 m))
    (define kind (_0 msg))
    ;; a /chore/<verb>/<mod..> request builds a build/*_req record
    ;; under the chore driver instead of an explorer request; the
    ;; response reads the finished chore node's result slots
    (define (chore-record parts body)
      (define verb (Ix 1 parts))
      (define mod (helm-doctest:join-slash (drop 2 parts)))
      (cond
        ;; an expr is one expression: trim the whitespace a browser
        ;; form ships around it (the run form's literal body ends
        ;; with the newline it was written with)
        ((Eq verb "eval") ((h-evalreq hs) mod (trim-ws (form-field "expr" body))))
        ((Eq verb "compile") ((h-compreq hs) mod))
        ((Eq verb "save") ((h-savereq hs) mod (form-field "src" body)))
        (else 0)))
    ;; answer a waiting connection: cull the request node, send the
    ;; response, retire the pending entry (the cull ack's own drop is
    ;; then a no-op)
    (define (answer hit pax r serial2 pending2 queue2)
      (Seq (helm:send! coord ["cmd" name ((h-cull hs) pax)])
        (Seq (helm:send! (_1 (_0 hit)) ["res" (_0 r) (_1 r) (_2 r)])
          (loop serial2 (pend-drop pending2 pax) (snoc [pax "cull"] queue2)))))
    ;; not ready: re-spy AND re-read — the next write may have
    ;; committed before this re-arm; the read's qres catches exactly
    ;; that window
    (define (rearm pax)
      (Seq (helm:send! coord ["spy" name pax])
        (let ((rm ["read" pax]))
          (Seq (DeepSeq rm rm) (SendCaps coord rm [0])))))
    ;; The explorer's write box: POST /vine/<path> with verb=make|
    ;; poke|cull and (for make/poke) expr, a foil expression that
    ;; evaluates against the boot subject to the writ's myth.  The
    ;; task goes out as an ordinary driver cmd — the same effect
    ;; channel every request-node make uses — and the connection then
    ;; WAITS on the cmd's ack (the [pax "vine" cap] queue entry): the
    ;; reply is the kernel's verdict, a bounce back to the node on
    ;; commit or the rendered rejection.  Only eval and parse failures
    ;; answer immediately (nothing was emitted).
    (define (vine! z)
      (define url (_2 msg))
      (define body (_3 msg))
      (define verb (form-field "verb" body))
      (define target (url-target (Rsh url 40)))
      (define expr (form-field "expr" body))
      (define (reply status body2)
        (Seq (helm:send! (Ix 0 caps) ["res" status body2 "text/html; charset=utf-8"])
          (loop serial pending queue)))
      (define (emit task pax)
        (Seq (helm:send! coord ["cmd" name task])
          (loop serial pending (snoc [pax "vine" (Ix 0 caps)] queue))))
      (cond
        ((Ifz target 1 0) (reply 404 "unparseable path segment"))
        ((Eq verb "cull") (emit ((h-cull hs) (_0 target)) (_0 target)))
        ((Or (Eq verb "make") (Eq verb "poke"))
          (let ((r (doctest:eval-text (h-sut hs) expr)))
            (If (Eq 1 (Hd r))
              (reply 400 (foil-render:diag-text (_0 r)))
              ;; force the value HERE, under Try — a lazily-crashing
              ;; or non-myth value must answer 400, not die in the
              ;; coordinator's exec
              (let ((fv (Try (lambda (z)
                               (let ((v (_0 (_0 r))))
                                 (Seq (DeepSeq v v) v)))
                          0)))
                (cond
                  ((Eq 1 (Hd fv)) (reply 400 (err-text (_0 fv))))
                  ((Nil (myth-rep? (_0 fv)))
                    (reply 400 "expression must evaluate to a myth (e.g. (myth/sing ['n] (pd 41)))"))
                  (else
                    (emit
                      ((If (Eq verb "make") (h-make hs) (h-poke hs))
                       (_0 target) (_0 fv))
                      (_0 target))))))))
        (else (reply 400 "verb must be make, poke, or cull"))))
    ;; The form-post endpoint: POST /post/<path> pokes the target with
    ;; the fields as ['post <k>] text slots and waits on the kernel's
    ;; ack, bouncing back to the form's own page on commit.  The
    ;; target's talk arm gives the post its meaning.
    (define (post! z)
      (define url (_2 msg))
      (define body (_3 msg))
      (define target (url-target (Rsh url 40)))
      (define back0 (form-field "back" body))
      (If (Ifz target 1 0)
        (Seq (helm:send! (Ix 0 caps)
               ["res" 404 "unparseable path segment" "text/plain; charset=utf-8"])
          (loop serial pending queue))
        (let ((back (If (Eq 0 (Bytes back0))
                      (strWeld "/ns" (quip:print-path (_0 target)))
                      back0))
              (task ((h-poke hs) (_0 target) (post-myth hs body))))
          (Seq (helm:send! coord ["cmd" name task])
            (loop serial pending (snoc [(_0 target) "post" (Ix 0 caps) back] queue))))))
    (cond
      ((And (Eq kind "req")
         (And (h-post? hs) (post-url? (_2 msg))))
        (post! 0))
      ((And (Eq kind "req")
         (And (h-vine? hs) (vine-url? (_2 msg))))
        (vine! 0))
      ((Eq kind "req")
        ;; a new part of the namespace for this connection
        (let* ((parts (filter Bytes (split-ch 47 (_2 msg))))
               (chore? (And (h-bridge? hs)
                         (And (Gt (Sz parts) 1)
                           (Equal "chore" (Ix 0 parts)))))
               (target (url-target (_2 msg)))
               (record
                 (If chore?
                   (chore-record parts (_3 msg))
                   (Ifz target 0
                     ((h-req hs) (_1 msg) (_2 msg) (_3 msg) (_0 target)))))
               (pax
                 (If chore?
                   [("ts" "io") ("ts" "chore")
                    ("ts" (strcat ["b" (_0 name) (showNat serial)]))]
                   (rpath serial))))
          (If (And (Nil chore?) (Ifz target 1 0))
            (Seq (helm:send! (Ix 0 caps)
                   ["res" 404 "unparseable path segment" "text/plain; charset=utf-8"])
              (loop serial pending queue))
          (If (And chore? (Ifz record 1 0))
            (Seq (helm:send! (Ix 0 caps)
                   ["res" 404 "unknown chore verb" "text/plain; charset=utf-8"])
              (loop serial pending queue))
            (let ((task ((h-make hs) pax record)))
              ;; spy before cmd: worker->coordinator sends are FIFO,
              ;; so the watch is armed before the request node exists
              (Seq (helm:send! coord ["spy" name pax])
                (Seq (helm:send! coord ["cmd" name task])
                  (loop (Inc serial)
                    (snoc [pax (Ix 0 caps)] pending)
                    (snoc [pax "make"] queue)))))))))
      ((Eq kind "change")
        ;; the watched request node moved: respond when the behavior
        ;; has written the response slots, else re-arm and keep waiting
        (let ((pax (_1 msg))
              (hit (pend-get pending (_1 msg))))
          (Ifz hit
            (loop serial pending queue)
            (let ((r (let ((r0 (res-of hs (_2 msg))))
                       (If (Or r0 (Nil (h-bridge? hs)))
                         r0
                         (chore-res-of hs (_2 msg))))))
              (Ifz r
                (Seq (rearm pax)
                  (loop serial pending queue))
                (answer hit pax r serial pending queue))))))
      ((Eq kind "qres")
        ;; a committed re-read of a pending chore node: answer if the
        ;; result landed; otherwise the armed spy carries on
        (let ((pax (_1 msg))
              (hit (pend-get pending (_1 msg))))
          (Ifz hit
            (loop serial pending queue)
            (let ((r (If (h-bridge? hs) (chore-res-of hs (_2 msg)) 0)))
              (Ifz r
                (loop serial pending queue)
                (answer hit pax r serial pending queue))))))
      ((Eq kind "ack")
        ;; acks return in cmd order: pop the queue head
        (let ((head (Ix 0 queue))
              (rest (drop 1 queue))
              (rsvp (_1 msg)))
          (cond
            ((Equal "post" (_1 head))
              ;; the form post answers with the kernel's verdict:
              ;; committed (bounce to the form's page) or rejected
              (Seq (helm:send! (_2 head)
                     (If (Eq "/boot/rsvp/no" (Hd rsvp))
                       ["res" 500 (vine-fail-page (_0 head) (_0 rsvp))
                        "text/html; charset=utf-8"]
                       ["res" 200 (post-back-page (_3 head))
                        "text/html; charset=utf-8"]))
                (loop serial pending rest)))
            ((Equal "vine" (_1 head))
              ;; the write box answers here, with the kernel's verdict:
              ;; committed (bounce back to the node) or rejected (500,
              ;; the rendered err)
              (Seq (helm:send! (_2 head)
                     (If (Eq "/boot/rsvp/no" (Hd rsvp))
                       ["res" 500 (vine-fail-page (_0 head) (_0 rsvp))
                        "text/html; charset=utf-8"]
                       ["res" 200 (vine-back-page (_0 head))
                        "text/html; charset=utf-8"]))
                (loop serial pending rest)))
            ((Eq "/boot/rsvp/no" (Hd rsvp))
              ;; the command failed — if its connection still waits,
              ;; answer 500 with the failure
              (let ((hit (pend-get pending (_0 head))))
                (Ifz hit
                  (loop serial pending rest)
                  (Seq (helm:send!
                         (_1 (_0 hit))
                         ["res" 500 (err-text (_0 rsvp)) "text/plain; charset=utf-8"])
                    (loop serial (pend-drop pending (_0 head)) rest)))))
            ((Equal "cull" (_1 head))
              ;; the request node is gone: this connection is done
              (loop serial (pend-drop pending (_0 head)) rest))
            (else (loop serial pending rest)))))
      ((Eq kind "noport")
        (loop serial pending queue))
      ((Eq kind "die") ["dead"])
      (else (loop serial pending queue))))
  (Seq coord
    (Seq (Ifz port
           0
           (let ((pump (Spawn (listener-pump port))))
             (SendCaps pump ["go"] [0])))
      (loop 0 [] []))))


;;; Boot ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
