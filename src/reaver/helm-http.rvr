;;; The HTTP driver: a helm worker whose requests ride the namespace.
;;; An incoming request is WRITTEN as a record at a fresh path under
;;; the driver's own name (/io/<name>/r<serial>), carrying the kook
;;; named by the driver's config record; the serving behavior writes
;;; ['res_status] / ['res_body] slots onto it — same event (init) or
;;; later — and the driver, watching the node through a helm spy,
;;; feeds those slots back as the HTTP response and culls the node.
;;;
;;; Config record at /io/<name>: ['serve] = the behavior id to stamp
;;; on request nodes; ['port] = the TCP port (absent: no listener —
;;; the mode tests use, driving requests as messages).
;;;
;;; Worker mailbox:
;;;   from the coordinator: ["go" res] ["change" pax res]
;;;                         ["ack" rsvp] ["die"]
;;;   from connection actors (or tests): ["req" method url body],
;;;     caps = [reply-handle]; answered with ["res" status body].
;;;
;;; Ack correlation: worker->coordinator sends are FIFO and the
;;; coordinator acks each cmd within its turn, so acks return in cmd
;;; order — a queue of [pax kind] entries pairs each ack with its
;;; command (failed acks carry no path).

;;; HTTP plumbing (local — forge's helpers, without dragging forge in)

(define crlf (strWeld 13 10))

(define (str-drop off src)
  (Rsh src (Mul 8 off)))

;; The index just past the header/body separator (CRLFCRLF), or 0.
(define (request-body-start input)
  (define n (Bytes input))
  (define (go i)
    (cond
      ((Ge (Add i 3) n) 0)
      ((and (Eq 13 (Load8 i input))
         (and (Eq 10 (Load8 (Add i 1) input))
           (and (Eq 13 (Load8 (Add i 2) input))
             (Eq 10 (Load8 (Add i 3) input)))))
        (Add i 4))
      (else (go (Inc i)))))
  (go 0))

(define (request-body input)
  (define start (request-body-start input))
  (Ifz start "" (str-drop start input)))

(define (status-line status)
  (cond
    ((Eq status 200) "HTTP/1.0 200 OK")
    ((Eq status 404) "HTTP/1.0 404 Not Found")
    ((Eq status 500) "HTTP/1.0 500 Internal Server Error")
    (else (strcat ["HTTP/1.0 " (showNat status) " Status"]))))

(define (http-res status ctype body)
  (lstrcat
    ~[(status-line status) crlf
      "Content-Type: " ctype crlf
      crlf body]))

(define (str-slice off len src)
  (Mod (Rsh src (Mul 8 off)) (Lsh 1 (Mul 8 len))))

(define (split-ch ch s)
  (define n (Bytes s))
  (define (go i start acc)
    (If (Ge i n)
      (snoc (str-slice start (Sub i start) s) acc)
      (If (Eq ch (Load8 i s))
        (go (Inc i) (Inc i) (snoc (str-slice start (Sub i start) s) acc))
        (go (Inc i) start acc))))
  (go 0 0 []))

;; "/ns/a/3/$s" -> [[("ts" "a") ("u" 3) ("ta" "s")]]; "/", "/ns" -> [[]].
;; Each segment parses through the aura codec, so numeric segments
;; arrive as u quips and $-segments as strings; an unparseable segment
;; yields 0 and the caller 404s.  A leading "ns" segment is the
;; explorer's own prefix and is dropped.
(define (url-target u)
  (define parts (filter (lambda (x) (Nil (Eq 0 (Bytes x)))) (split-ch 47 u)))
  (define parts2
    (If (And (Sz parts) (Equal "ns" (Ix 0 parts)))
      (drop 1 parts)
      parts))
  (define (go i acc)
    (If (Eq i (Sz parts2)) [acc]
      (let ((r (quip:parse-quip-soft (Ix i parts2))))
        (Ifz r 0 (go (Inc i) (snoc (_0 r) acc))))))
  (go 0 []))

;;; Socket layer (thin; blocking IO lives in its own actors) ;;;;;;;;;;;;;;;;;;;;;;;

;; One actor per connection: handshake for the worker handle (handles
;; are per-actor capabilities — they only cross actors through caps,
;; never through closures), then read, parse, ask the worker, write
;; the response (with the sentinel byte — Write drops the top byte),
;; close.
(define (conn-actor fd self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  ;; Read returns a bar (data then a 0x01 terminator): strip the
  ;; terminator, or a request body would carry a stray trailing 0x01
  (define raw (Read fd 65536))
  (define input (str-slice 0 (Dec (Bytes raw)) raw))
  (define parsed (Try milton:parse-http-request input))
  (define method (If (Eq 1 (Hd parsed)) "GET" (Ix 0 (_0 parsed))))
  (define target (If (Eq 1 (Hd parsed)) "/" (Ix 1 (_0 parsed))))
  (define body (request-body input))
  (define m ["req" method target body])
  (Seq (DeepSeq m m)
    (Seq (SendCaps wh m [0])
      (let ((r (Ix 0 (Recv 0))))
        (Seq (Write fd (strWeld (http-res (_1 r) (_3 r) (_2 r)) 1))
          (CloseFd fd))))))

;; Accept loop: handshake for the worker handle, then one actor per
;; connection — the worker cap is re-delegated to each via SendCaps.
(define (listener-pump port self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define listenx (Try Listen port))
  (If (Eq 1 (Hd listenx))
    (Seq (Trace ["pump: listen failed" port (_0 listenx)] 0)
      (Send wh ["noport" port]))
    (let ((fd (_0 listenx)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (let ((c (Spawn (conn-actor conn))))
               (SendCaps c ["go"] [wh]))
          (loop z)))
      (Seq (Trace ["pump: listening" port] 0)
        (Seq wh (loop 0))))))

;;; Form bodies (application/x-www-form-urlencoded) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (hex-val c)
  (cond
    ((And (Ge c 48) (Le c 57)) (Sub c 48))
    ((And (Ge c 97) (Le c 102)) (Sub c 87))
    ((And (Ge c 65) (Le c 70)) (Sub c 55))
    (else 0)))

(define (url-decode s)
  (define n (Bytes s))
  (define (go i)
    (If (Ge i n)
      0
      (let ((c (Load8 i s)))
        (cond
          ((Eq c 43) (lcons 32 (go (Inc i))))
          ((And (Eq c 37) (Lt (Add i 2) n))
            (lcons
              (Add (Mul 16 (hex-val (Load8 (Add i 1) s)))
                (hex-val (Load8 (Add i 2) s)))
              (go (Add i 3))))
          (else (lcons c (go (Inc i))))))))
  (lstrcat (go 0)))

;; One urlencoded field's decoded value, or "".
(define (form-field name body)
  (define pre (strcat [name "="]))
  (define hit
    (find (lambda (p) (Eq pre (Mod p (Lsh 1 (Mul 8 (Bytes pre))))))
      (split-ch 38 body)))
  (Ifz hit "" (url-decode (Rsh (_0 hit) (Mul 8 (Bytes pre))))))

;;; The worker ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; helpers = ["H" http/req myth/nat_at vine_make vine_cull myth/txt_at
;;            build/eval_req build/compile_req build/save_req] —
;; compiled lainapp/build entries, supplied by whoever spawns the
;; coordinator.  The last four ride only where the /chore bridge is
;; wired (the boot passes them; a short bundle disables the bridge).
(define (h-req hs) (Ix 1 hs))
(define (h-slot hs) (Ix 2 hs))
(define (h-make hs) (Ix 3 hs))
(define (h-cull hs) (Ix 4 hs))
(define (h-txt hs) (Ix 5 hs))
(define (h-evalreq hs) (Ix 6 hs))
(define (h-compreq hs) (Ix 7 hs))
(define (h-savereq hs) (Ix 8 hs))
(define (h-bridge? hs) (Gt (Sz hs) 5))

(define (pend-get pending pax)
  (find (lambda (e) (Equal pax (_0 e))) pending))

(define (pend-drop pending pax)
  (filter (lambda (e) (Nil (Equal pax (_0 e)))) pending))

;; A known record's myth, or 0 — the shared prologue of every
;; response reader.
(define (known-myth resrec)
  (If (Eq "/boot/res/known" (Hd resrec)) (_0 resrec) 0))

;; The record's response, if the serving behavior wrote it yet:
;; [status body ctype].
(define (res-of hs resrec)
  (define m (known-myth resrec))
  (Ifz m
    0
    (let ((status ((h-slot hs) [("ts" "res_status")] 0 m)))
      (Ifz status
        0
        [status
         ((h-slot hs) [("ts" "res_body")] 0 m)
         ((h-slot hs) [("ts" "res_ctype")] "text/plain; charset=utf-8" m)]))))

(define chore-nl (strcat [10]))

;; A chore request node's answer, once ['res_done] lands: the build
;; families' result slots rendered as plain text.
(define (chore-res-of hs resrec)
  (define m (known-myth resrec))
  (If (Or (Ifz m 1 0) (Nil (Eq 1 ((h-slot hs) [("ts" "res_done")] 0 m))))
    0
    (let* ((txt (h-txt hs))
               (err (txt [("ts" "err")] m))
               (report (txt [("ts" "report")] m))
               (value (txt [("ts" "value")] m))
               (tyt (txt [("ts" "ty")] m))
               (law (txt [("ts" "law")] m))
               (ct "text/plain; charset=utf-8"))
          (cond
            (err [500 err ct])
            (report [200 report ct])
            (value
              [200
               (strcat
                 ["value: " value
                  (Ifz tyt "" (strcat [chore-nl "type:  " tyt]))
                  (Ifz law "" (strcat [chore-nl chore-nl law]))])
               ct])
            (else [500 "chore failed" ct])))))

(define (mk-http-worker hs name self)
  ;; go handshake: the coordinator handle rides the caps; the config
  ;; record rides the message.  Forced before the loop (lazy defines
  ;; would let the loop steal it).  The config's serving kook — not
  ;; this driver — is what answers requests: request records are made
  ;; bare, the /io/<name> take installs the responder on them.
  (define mc (Recv 0))
  (define coord (Seq (DeepSeq mc mc) (Ix 0 (Ix 1 mc))))
  (define rec0 (_1 (Ix 0 mc)))
  (define port
    (If (Eq "/boot/res/known" (Hd rec0))
      ((h-slot hs) [("ts" "port")] 0 (_0 rec0))
      0))
  (define (rpath i)
    [("ts" "io") name ("ts" (strcat ["r" (showNat i)]))])
  ;; state: serial, pending = [[pax conn-cap] ..], queue = [[pax kind] ..]
  (define (loop serial pending queue)
    (define m (Recv 0))
    (define msg (Ix 0 m))
    (define caps (Ix 1 m))
    (define kind (_0 msg))
    ;; a /chore/<verb>/<mod..> request builds a build/*_req record
    ;; under the chore driver instead of an explorer request; the
    ;; response reads the finished chore node's result slots
    (define (chore-record parts body)
      (define verb (Ix 1 parts))
      (define mod (helm-doctest:join-slash (drop 2 parts)))
      (cond
        ((Eq verb "eval") ((h-evalreq hs) mod (form-field "expr" body)))
        ((Eq verb "compile") ((h-compreq hs) mod))
        ((Eq verb "save") ((h-savereq hs) mod (form-field "src" body)))
        (else 0)))
    ;; answer a waiting connection: cull the request node, send the
    ;; response, retire the pending entry (the cull ack's own drop is
    ;; then a no-op)
    (define (answer hit pax r serial2 pending2 queue2)
      (Seq (helm:send! coord ["cmd" name ((h-cull hs) pax)])
        (Seq (helm:send! (_1 (_0 hit)) ["res" (_0 r) (_1 r) (_2 r)])
          (loop serial2 (pend-drop pending2 pax) (snoc [pax "cull"] queue2)))))
    ;; not ready: re-spy AND re-read — the next write may have
    ;; committed before this re-arm; the read's qres catches exactly
    ;; that window
    (define (rearm pax)
      (Seq (helm:send! coord ["spy" name pax])
        (let ((rm ["read" pax]))
          (Seq (DeepSeq rm rm) (SendCaps coord rm [0])))))
    (cond
      ((Eq kind "req")
        ;; a new part of the namespace for this connection
        (let* ((parts (filter Bytes (split-ch 47 (_2 msg))))
               (chore? (And (h-bridge? hs)
                         (And (Gt (Sz parts) 1)
                           (Equal "chore" (Ix 0 parts)))))
               (target (url-target (_2 msg)))
               (record
                 (If chore?
                   (chore-record parts (_3 msg))
                   (Ifz target 0
                     ((h-req hs) (_1 msg) (_2 msg) (_3 msg) (_0 target)))))
               (pax
                 (If chore?
                   [("ts" "io") ("ts" "chore")
                    ("ts" (strcat ["b" (_0 name) (showNat serial)]))]
                   (rpath serial))))
          (If (And (Nil chore?) (Ifz target 1 0))
            (Seq (helm:send! (Ix 0 caps)
                   ["res" 404 "unparseable path segment" "text/plain; charset=utf-8"])
              (loop serial pending queue))
          (If (And chore? (Ifz record 1 0))
            (Seq (helm:send! (Ix 0 caps)
                   ["res" 404 "unknown chore verb" "text/plain; charset=utf-8"])
              (loop serial pending queue))
            (let ((task ((h-make hs) pax record)))
              ;; spy before cmd: worker->coordinator sends are FIFO,
              ;; so the watch is armed before the request node exists
              (Seq (helm:send! coord ["spy" name pax])
                (Seq (helm:send! coord ["cmd" name task])
                  (loop (Inc serial)
                    (snoc [pax (Ix 0 caps)] pending)
                    (snoc [pax "make"] queue)))))))))
      ((Eq kind "change")
        ;; the watched request node moved: respond when the behavior
        ;; has written the response slots, else re-arm and keep waiting
        (let ((pax (_1 msg))
              (hit (pend-get pending (_1 msg))))
          (Ifz hit
            (loop serial pending queue)
            (let ((r (let ((r0 (res-of hs (_2 msg))))
                       (If (Or r0 (Nil (h-bridge? hs)))
                         r0
                         (chore-res-of hs (_2 msg))))))
              (Ifz r
                (Seq (rearm pax)
                  (loop serial pending queue))
                (answer hit pax r serial pending queue))))))
      ((Eq kind "qres")
        ;; a committed re-read of a pending chore node: answer if the
        ;; result landed; otherwise the armed spy carries on
        (let ((pax (_1 msg))
              (hit (pend-get pending (_1 msg))))
          (Ifz hit
            (loop serial pending queue)
            (let ((r (If (h-bridge? hs) (chore-res-of hs (_2 msg)) 0)))
              (Ifz r
                (loop serial pending queue)
                (answer hit pax r serial pending queue))))))
      ((Eq kind "ack")
        ;; acks return in cmd order: pop the queue head
        (let ((head (Ix 0 queue))
              (rest (drop 1 queue))
              (rsvp (_1 msg)))
          (cond
            ((Eq "/boot/rsvp/no" (Hd rsvp))
              ;; the command failed — if its connection still waits,
              ;; answer 500 with the failure
              (let ((hit (pend-get pending (_0 head))))
                (Ifz hit
                  (loop serial pending rest)
                  (Seq (helm:send!
                         (_1 (_0 hit))
                         ["res" 500 (_0 (_0 rsvp)) "text/plain; charset=utf-8"])
                    (loop serial (pend-drop pending (_0 head)) rest)))))
            ((Equal "cull" (_1 head))
              ;; the request node is gone: this connection is done
              (loop serial (pend-drop pending (_0 head)) rest))
            (else (loop serial pending rest)))))
      ((Eq kind "noport")
        (loop serial pending queue))
      ((Eq kind "die") ["dead"])
      (else (loop serial pending queue))))
  (Seq coord
    (Seq (Ifz port
           0
           (let ((pump (Spawn (listener-pump port))))
             (SendCaps pump ["go"] [0])))
      (loop 0 [] []))))


;;; Boot ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
