(#bind quip (#module quip))
(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind milton (#module milton))


(#bind helm (#module helm))
(#bind helm-doctest (#module helm-doctest))
(#bind doctest (#module doctest))
(#bind foil-render (#module foil-render))


;;; The HTTP host adapter. Foil's http_driver/step owns pending requests,
;;; persistent watches, the command ack queue, and response completion.
;;; The host owns sockets, connection capabilities, and browser route parsing.
;;; Routes produce http_action; the driver emits http_effect and driver_out.
;;; Every typed command, including crew publication, has a FIFO ack entry.

;;; HTTP plumbing (local — forge's helpers, without dragging forge in)

(define crlf (strWeld 13 10))

(define (str-drop off src)
  (Rsh src (Mul 8 off)))

;; The index just past the header/body separator (CRLFCRLF), or 0.
(define (request-body-start input)
  (define n (Bytes input))
  (define (go i)
    (cond
      ((Ge (Add i 3) n) 0)
      ((and (Eq 13 (Load8 i input))
         (and (Eq 10 (Load8 (Add i 1) input))
           (and (Eq 13 (Load8 (Add i 2) input))
             (Eq 10 (Load8 (Add i 3) input)))))
        (Add i 4))
      (else (go (Inc i)))))
  (go 0))

(define (request-body input)
  (define start (request-body-start input))
  (Ifz start "" (str-drop start input)))

(define (status-line status)
  (cond
    ((Eq status 200) "HTTP/1.0 200 OK")
    ((Eq status 400) "HTTP/1.0 400 Bad Request")
    ((Eq status 404) "HTTP/1.0 404 Not Found")
    ((Eq status 500) "HTTP/1.0 500 Internal Server Error")
    (else (strcat ["HTTP/1.0 " (showNat status) " Status"]))))

(define (http-res status ctype body)
  (lstrcat
    ~[(status-line status) crlf
      "Content-Type: " ctype crlf
      crlf body]))

(define (str-slice off len src)
  (Mod (Rsh src (Mul 8 off)) (Lsh 1 (Mul 8 len))))

(define (split-ch ch s)
  (define n (Bytes s))
  (define (go i start acc)
    (If (Ge i n)
      (snoc (str-slice start (Sub i start) s) acc)
      (If (Eq ch (Load8 i s))
        (go (Inc i) (Inc i) (snoc (str-slice start (Sub i start) s) acc))
        (go (Inc i) start acc))))
  (go 0 0 []))

;; "/ns/a/3/$s" -> [[("ts" "a") ("u" 3) ("ta" "s")]]; "/", "/ns" -> [[]].
;; Each segment parses through the aura codec, so numeric segments
;; arrive as u quips and $-segments as strings; an unparseable segment
;; yields 0 and the caller 404s.  A leading "ns" segment is the
;; explorer's own prefix and is dropped.
(define (url-target u)
  (define parts (filter (lambda (x) (Nil (Eq 0 (Bytes x)))) (split-ch 47 u)))
  (define parts2
    (If (And (Sz parts) (Equal "ns" (Ix 0 parts)))
      (drop 1 parts)
      parts))
  (define (go i acc)
    (If (Eq i (Sz parts2)) [acc]
      (let ((r (quip:parse-quip-soft (Ix i parts2))))
        (Ifz r 0 (go (Inc i) (snoc (_0 r) acc))))))
  (go 0 []))

;; Rendered text for a kernel rejection's err iota: the canonical quip
;; spelling when it has one, else the flat diagnostic walk.
(define (err-text e)
  (define r (Try (lambda (z) (quip:print-quip e)) 0))
  (If (Eq 1 (Hd r)) (foil-render:diag-flat e) (_0 r)))

;; A myth is a mop at runtime; anything else poked into the kernel
;; dies INSIDE the coordinator's exec (a non-exhaustive mop match), so
;; the write box refuses non-myth expression values up front.
(define (myth-rep? v)
  (Or (Eq "/boot/mop/empty" v)
    (And (IsApp v) (Eq "/boot/mop/node" (Hd v)))))

;;; Socket layer (thin; blocking IO lives in its own actors) ;;;;;;;;;;;;;;;;;;;;;;;

;; One actor per connection: handshake for the worker handle (handles
;; are per-actor capabilities — they only cross actors through caps,
;; never through closures), then read, parse, ask the worker, write
;; the response (with the sentinel byte — Write drops the top byte),
;; close.
(define (conn-actor fd self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  ;; Read returns a bar (data then a 0x01 terminator): strip the
  ;; terminator, or a request body would carry a stray trailing 0x01
  (define raw (Read fd 65536))
  (define input (str-slice 0 (Dec (Bytes raw)) raw))
  (define parsed (Try milton:parse-http-request input))
  (define method (If (Eq 1 (Hd parsed)) "GET" (Ix 0 (_0 parsed))))
  (define target (If (Eq 1 (Hd parsed)) "/" (Ix 1 (_0 parsed))))
  (define body (request-body input))
  (define m ["req" method target body])
  (Seq (DeepSeq m m)
    (Seq (SendCaps wh m [0])
      (let ((r (Ix 0 (Recv 0))))
        (Seq (Write fd (strWeld (http-res (_1 r) (_3 r) (_2 r)) 1))
          (CloseFd fd))))))

;; Accept loop: handshake for the worker handle, then one actor per
;; connection — the worker cap is re-delegated to each via SendCaps.
(define (listener-pump port self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define listenx (Try Listen port))
  (If (Eq 1 (Hd listenx))
    (Seq (Trace ["pump: listen failed" port (_0 listenx)] 0)
      (Send wh ["noport" port]))
    (let ((fd (_0 listenx)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (let ((c (Spawn (conn-actor conn))))
               (SendCaps c ["go"] [wh]))
          (loop z)))
      (Seq (Trace ["pump: listening" port] 0)
        (Seq wh (loop 0))))))

;;; Form bodies (application/x-www-form-urlencoded) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (hex-val c)
  (cond
    ((And (Ge c 48) (Le c 57)) (Sub c 48))
    ((And (Ge c 97) (Le c 102)) (Sub c 87))
    ((And (Ge c 65) (Le c 70)) (Sub c 55))
    (else 0)))

;; CR bytes are dropped: browsers normalize every form value to CRLF
;; on submit, and nothing downstream (semidoc reparse, foil eval)
;; speaks \r — an editor POST arrived as \r\n-lines and wrecked the
;; reparse, and even a one-line run expr picked up a trailing \r.
(define (url-decode s)
  (define n (Bytes s))
  (define (emit c rest)
    (If (Eq c 13) rest (lcons c rest)))
  (define (go i)
    (If (Ge i n)
      0
      (let ((c (Load8 i s)))
        (cond
          ((Eq c 43) (lcons 32 (go (Inc i))))
          ((And (Eq c 37) (Lt (Add i 2) n))
            (emit
              (Add (Mul 16 (hex-val (Load8 (Add i 1) s)))
                (hex-val (Load8 (Add i 2) s)))
              (go (Add i 3))))
          (else (emit c (go (Inc i))))))))
  (lstrcat (go 0)))

;; Strip leading/trailing whitespace bytes (space, tab, LF, CR).
(define (trim-ws s)
  (define n (Bytes s))
  (define (ws? b) (Or (Eq b 32) (Or (Eq b 9) (Or (Eq b 10) (Eq b 13)))))
  (define (start i) (If (And (Lt i n) (ws? (Load8 i s))) (start (Inc i)) i))
  (define (end i) (If (And (Gt i 0) (ws? (Load8 (Dec i) s))) (end (Dec i)) i))
  (define a (start 0))
  (define b (end n))
  (If (Ge a b) "" (Trunc (Mul 8 (Sub b a)) (Rsh s (Mul 8 a)))))

;; One urlencoded field's decoded value, or "".
(define (form-field name body)
  (define pre (strcat [name "="]))
  (define hit
    (find (lambda (p) (Eq pre (Mod p (Lsh 1 (Mul 8 (Bytes pre))))))
      (split-ch 38 body)))
  (Ifz hit "" (url-decode (Rsh (_0 hit) (Mul 8 (Bytes pre))))))

;; Every form field as decoded [name value] pairs, in body order.
;; Fields without an = are skipped.
(define (field-eq-idx p)
  (define n (Bytes p))
  (define (go i)
    (cond
      ((Ge i n) 0)
      ((Eq 61 (Load8 i p)) [i])
      (else (go (Inc i)))))
  (go 0))
(define (form-fields body)
  (define (pair p)
    (define hit (field-eq-idx p))
    (Ifz hit 0
      (let ((i (_0 hit)))
        [[(str-slice 0 i p)
          (url-decode (Rsh p (Mul 8 (Inc i))))]])))
  (foldl (lambda (acc p) (Weld acc (pair p))) [] (split-ch 38 body)))

;;; Browser application route context ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Legacy browser application entries, private to prepare (not the driver ABI).
;; helpers = ["H" http/req myth/nat_at vine_make vine_cull myth/txt_at
;;            build/eval_req build/compile_req build/save_req] —
;; compiled lainapp/build entries, supplied by whoever spawns the
;; coordinator.  The last four ride only where the /chore bridge is
;; wired (the boot passes them; a short bundle disables the bridge).
(define (h-req hs) (Ix 1 hs))
(define (h-slot hs) (Ix 2 hs))
(define (h-make hs) (Ix 3 hs))
(define (h-cull hs) (Ix 4 hs))
(define (h-txt hs) (Ix 5 hs))
(define (h-evalreq hs) (Ix 6 hs))
(define (h-compreq hs) (Ix 7 hs))
(define (h-savereq hs) (Ix 8 hs))
(define (h-bridge? hs) (Gt (Sz hs) 5))
;; vine_poke + the compiled boot subject: the explorer's write box
;; (POST /vine/<path>) evaluates its expression against the subject
;; and emits the writ as a driver cmd.  Only the full boot bundle
;; carries them.
(define (h-poke hs) (Ix 9 hs))
(define (h-sut hs) (Ix 10 hs))
(define (h-vine? hs) (Gt (Sz hs) 9))
;; myth/new + myth/add + twig/txt: the form-post endpoint builds its
;; poke myth from the fields directly — no expression evaluation.
(define (h-myth0 hs) (Ix 11 hs))
(define (h-madd hs) (Ix 12 hs))
(define (h-twigt hs) (Ix 13 hs))
(define (h-post? hs) (Gt (Sz hs) 11))
;; the /w.js runtime cord: served statically, no namespace event.
(define (h-wjs hs) (Ix 14 hs))
(define (h-wjs? hs) (Gt (Sz hs) 14))
;; vine_warp + twig/nat: the op endpoint (POST /op/<dst>) builds a
;; warp task from the form fields.
(define (h-warp hs) (Ix 15 hs))
(define (h-twign hs) (Ix 16 hs))
(define (h-op? hs) (Gt (Sz hs) 16))

;; "/vine" or "/vine/..." — the write box's endpoint.
(define (vine-url? u)
  (And (Eq "/vine" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; "/post/..." — the form-post endpoint: POST /post/<path> pokes the
;; target with a myth of ['post <field>] text slots, one per form
;; field (the "back" field is control data: the bounce destination).
;; The target's own talk arm decides what the post means — the same
;; authority split as the write box, minus the expression language.
(define (post-url? u)
  (And (Eq "/post" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; "/frag/..." — the fragment endpoint: GET /frag/<case>/<olen>/
;; <op..>/<dlen>/<dp..> serves the component markup at the
;; corresponding /o path, bare.  The worker conses the 'o head back
;; on and stamps the request record with the ['frag] marker; the
;; responder (web's route_talk) answers the rendered ['html] slot
;; instead of a page.
(define (frag-url? u)
  (And (Eq "/frag" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; "/edit/..." — the in-place edit endpoint: POST /edit/<path> pokes
;; the target with the fields as DIRECT text slots (['<k>], not
;; ['post <k>]) — the write-through half of w-edit.  A kookless
;; record melds the slot; a kook's talk sees the poke like any
;; other; watchers (sync hears, felt components) re-render whatever
;; the write means.
(define (edit-url? u)
  (And (Eq "/edit" (Mod u (Lsh 1 40)))
    (Or (Eq 5 (Bytes u)) (Eq "/" (Load8 5 u)))))

;; "/op/..." — the op endpoint: POST /op/<dst> with op=<op node
;; path>, optional back=<bounce url>; every other field k=v becomes
;; an input slot at the "/"-split key (all-digit values as pd nats,
;; else text), plus ['when] stamped with the host clock.  The task is
;; a warp: the op card's fn applied to (input, dst's record) — ops
;; are how apps expose write protocols (grove # forms) and how apps
;; install (/kook/install).
(define (op-url? u)
  (And (Eq "/op" (Mod u (Lsh 1 24)))
    (Or (Eq 3 (Bytes u)) (Eq "/" (Load8 3 u)))))

;; Leading decimal run of a form field, 0 when none.
(define (parse-nat s)
  (define n (Bytes s))
  (define (go i acc)
    (If (Ge i n) acc
      (let ((c (Load8 i s)))
        (If (And (Ge c 48) (Le c 57))
          (go (Inc i) (Add (Mul 10 acc) (Sub c 48)))
          acc))))
  (go 0 0))

;; The poke myth for a form body: each field k=v except "back"
;; becomes a text pail at slot ['post <k>].
(define (post-myth hs body)
  (foldl
    (lambda (m kv)
      (If (Equal "back" (_0 kv))
        m
        ((h-madd hs)
         ((h-twigt hs) [("ts" "post") ("ts" (_0 kv))] (_1 kv))
         m)))
    (h-myth0 hs)
    (form-fields body)))

;; The edit myth: fields as DIRECT text slots — ['<k>], no post
;; prefix.  The write-through poke for in-place edits.
(define (edit-myth hs body)
  (foldl
    (lambda (m kv)
      (If (Equal "back" (_0 kv))
        m
        ((h-madd hs) ((h-twigt hs) [("ts" (_0 kv))] (_1 kv)) m)))
    (h-myth0 hs)
    (form-fields body)))

;; Every byte a decimal digit (and at least one): parse-nat would
;; happily coerce "12abc", so op fields gate on this first.
(define (all-digits? s)
  (define n (Bytes s))
  (define (go i)
    (If (Ge i n) 1
      (let ((c (Load8 i s)))
        (If (And (Ge c 48) (Le c 57)) (go (Inc i)) 0))))
  (And n (go 0)))

;; The op input myth: fields as slots at their "/"-split keys (the
;; same quip codec as url-target, so "srs/grade" lands at ['srs
;; 'grade]), digits as data pails, text otherwise; "op" and "back"
;; are control fields; ['when] carries the host clock for ops that
;; need a timestamp.  An unparseable key drops its field.
(define (op-myth hs now body)
  (foldl
    (lambda (m kv)
      (cond
        ((Equal "op" (_0 kv)) m)
        ((Equal "back" (_0 kv)) m)
        (else
          (let ((sk (url-target (_0 kv))))
            (Ifz sk m
              ((h-madd hs)
               (If (all-digits? (_1 kv))
                 ((h-twign hs) (_0 sk) (parse-nat (_1 kv)))
                 ((h-twigt hs) (_0 sk) (_1 kv)))
               m))))))
    ((h-madd hs) ((h-twign hs) [("ts" "when")] now) (h-myth0 hs))
    (form-fields body)))

;; Browser application adapter. It translates routes into typed actions;
;; request lifetimes, dependency publication, and ack handling are Foil.
(define (prepare hs name serial msg)
  (define method (_1 msg))
  (define url (_2 msg))
  (define body (_3 msg))
  (define (reply status text ctype)
    ("/boot/http_action/reply" ("/boot/http_response" status text ctype)))
  (define (bad status text) (reply status text "text/plain; charset=utf-8"))
  (define (back p) (strWeld "/ns" (quip:print-path p)))
  (define (write task p loc) ("/boot/http_action/write" task p loc))
  (define (wait p record) ("/boot/http_action/wait" p record))
  (define rpath [("ts" "io") name ("ts" (strcat ["r" (showNat serial)]))])
  (define (form-write edit?)
    (define target (url-target (Rsh url 40)))
    (Ifz target (bad 404 "unparseable path segment")
      (let* ((p (_0 target))
             (loc (form-field "back" body))
             (record (If edit? (edit-myth hs body) (post-myth hs body))))
        (write ((h-poke hs) p record) p
          (If (Or edit? (Eq loc 0)) (back p) loc)))))
  (define (vine z)
    (define target (url-target (Rsh url 40)))
    (define verb (form-field "verb" body))
    (cond
      ((Nil target) (bad 404 "unparseable path segment"))
      ((Eq verb "cull") (write ((h-cull hs) (_0 target)) (_0 target) (back (_0 target))))
      ((Or (Eq verb "make") (Eq verb "poke"))
        (let ((r (doctest:eval-text (h-sut hs) (form-field "expr" body))))
          (If (Eq 1 (Hd r)) (bad 400 (foil-render:diag-text (_0 r)))
            (let ((fv (Try (lambda (z) (let ((v (_0 (_0 r)))) (Seq (DeepSeq v v) v))) 0)))
              (cond
                ((Eq 1 (Hd fv)) (bad 400 (err-text (_0 fv))))
                ((Nil (myth-rep? (_0 fv))) (bad 400 "expression must evaluate to a myth"))
                (else (write ((If (Eq verb "make") (h-make hs) (h-poke hs)) (_0 target) (_0 fv))
                        (_0 target) (back (_0 target)))))))))
      (else (bad 400 "verb must be make, poke, or cull"))))
  (define (op z)
    (define dst (url-target (Rsh url 24)))
    (define opp (url-target (form-field "op" body)))
    (define loc (form-field "back" body))
    (cond
      ((Nil dst) (bad 404 "unparseable path segment"))
      ((Or (Nil opp) (Nil (Sz (_0 opp)))) (bad 400 "op= must be a namespace path"))
      (else (write ((h-warp hs) (_0 dst) (_0 opp)
                     (op-myth hs (Div (Now 0) 1000000000) body))
              (_0 dst) (If loc loc (back (_0 dst)))))))
  (define (regular z)
    (define parts (filter Bytes (split-ch 47 url)))
    (define chore? (And (h-bridge? hs) (And (Gt (Sz parts) 1) (Eq "chore" (Ix 0 parts)))))
    (define target (url-target url))
    (If chore?
      (let* ((verb (Ix 1 parts))
             (mod (helm-doctest:join-slash (drop 2 parts)))
             (record (cond
                       ((Eq verb "eval") ((h-evalreq hs) mod (trim-ws (form-field "expr" body))))
                       ((Eq verb "compile") ((h-compreq hs) mod))
                       ((Eq verb "save") ((h-savereq hs) mod (form-field "src" body)))
                       (else 0))))
        (If record
          (wait [("ts" "io") ("ts" "chore") ("ts" (strcat ["b" (_0 name) (showNat serial)]))] record)
          (bad 404 "unknown chore verb")))
      (Ifz target (bad 404 "unparseable path segment")
        (wait rpath ((h-req hs) method url body (_0 target))))))
  (cond
    ((And (h-wjs? hs) (Eq url "/w.js")) (reply 200 (h-wjs hs) "application/javascript"))
    ((Eq url "/style.css") (reply 200 (ReadFile "foil/style.css") "text/css"))
    ((And (h-wjs? hs) (frag-url? url))
      (let ((rest (url-target (Rsh url 40))))
        (Ifz rest (bad 404 "unparseable fragment path")
          (wait rpath ((h-madd hs) ((h-twigt hs) [("ts" "frag")] "1")
                        ((h-req hs) method url body (weld [("ts" "o")] (_0 rest))))))))
    ((And (h-post? hs) (post-url? url)) (form-write 0))
    ((And (h-post? hs) (edit-url? url)) (form-write 1))
    ((And (h-vine? hs) (vine-url? url)) (vine 0))
    ((And (h-op? hs) (op-url? url)) (op 0))
    (else (regular 0))))

;; The host interprets the Foil effect list in order. Connection capabilities
;; never enter a Foil value: only monotonically allocated request tickets do.
(define (mk-http-worker planner step name self)
  (define mc (Recv 0))
  (define coord (Seq (DeepSeq mc mc) (Ix 0 (Ix 1 mc))))
  (define initial ("/boot/http_event/helm" (helm:driver-message (Ix 0 mc))))
  (define (perform routes effect)
    (define kind (Hd effect))
    (cond
      ((Eq kind "/boot/http_effect/send")
        (Seq (helm:send! coord (_0 effect)) routes))
      ((Eq kind "/boot/http_effect/listen")
        (Seq (let ((pump (Spawn (listener-pump (_0 effect)))))
               (SendCaps pump ["go"] [0])) routes))
      ((Eq kind "/boot/http_effect/reply")
        (let ((hit (find (lambda (r) (Eq (_0 r) (_0 effect))) routes)))
          (Ifz hit routes
            (let ((response (_1 effect)))
              (Seq (helm:send! (_1 (_0 hit)) ["res" (_0 response) (_1 response) (_2 response)])
                (filter (lambda (r) (Nil (Eq (_0 r) (_0 effect)))) routes))))))
      (else (error ["unknown HTTP effect" effect]))))
  (define (loop state routes serial event)
    (define turn (step name state event))
    (define routes2 (Seq (DeepSeq turn turn) (foldl perform routes (_1 turn))))
    (Seq (DeepSeq routes2 routes2)
      (If (_2 turn) ["dead"]
        (let* ((mail (Recv 0))
               (msg (Ix 0 mail))
               (caps (Ix 1 mail)))
          (If (Eq (_0 msg) "req")
            (let ((action (Try (lambda (z) (let ((a (planner name serial msg))) (Seq (DeepSeq a a) a))) 0)))
              (loop (_0 turn) (snoc [serial (Ix 0 caps)] routes2) (Inc serial)
                ("/boot/http_event/request" serial
                  (If (Eq 1 (Hd action))
                    ("/boot/http_action/reply" ("/boot/http_response" 400 (err-text (_0 action)) "text/plain; charset=utf-8"))
                    (_0 action)))))
            (let ((message (helm:driver-message msg)))
              (If message
                (loop (_0 turn) routes2 serial ("/boot/http_event/helm" message))
                ;; Unknown transport notifications leave driver state alone.
                (loop (_0 turn) routes2 serial "/boot/http_event/idle"))))))))
  (Seq coord (loop ("/boot/http_state" [] []) [] 0 initial)))
