(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind milton (#module milton))

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind helm (#module helm))
(#bind http-client (#module http-client))
(#bind helm-fetch (#module helm-fetch))


;;; The HTTP driver: a helm worker whose requests ride the namespace.
;;; An incoming request is WRITTEN as a record at a fresh path under
;;; the driver's own name (/io/<name>/r<serial>), carrying the kook
;;; named by the driver's config record; the serving behavior writes
;;; ['res_status] / ['res_body] slots onto it — same event (init) or
;;; later — and the driver, watching the node through a helm spy,
;;; feeds those slots back as the HTTP response and culls the node.
;;;
;;; Config record at /io/<name>: ['serve] = the behavior id to stamp
;;; on request nodes; ['port] = the TCP port (absent: no listener —
;;; the mode tests use, driving requests as messages).
;;;
;;; Worker mailbox:
;;;   from the coordinator: ["go" res] ["change" pax res]
;;;                         ["ack" rsvp] ["die"]
;;;   from connection actors (or tests): ["req" method url body],
;;;     caps = [reply-handle]; answered with ["res" status body].
;;;
;;; Ack correlation: worker->coordinator sends are FIFO and the
;;; coordinator acks each cmd within its turn, so acks return in cmd
;;; order — a queue of [pax kind] entries pairs each ack with its
;;; command (failed acks carry no path).

;;; HTTP plumbing (local — forge's helpers, without dragging forge in)

(define crlf (strWeld 13 10))

(define (str-drop off src)
  (Rsh src (Mul 8 off)))

;; The index just past the header/body separator (CRLFCRLF), or 0.
(define (request-body-start input)
  (define n (Bytes input))
  (define (go i)
    (cond
      ((Ge (Add i 3) n) 0)
      ((and (Eq 13 (Load8 i input))
         (and (Eq 10 (Load8 (Add i 1) input))
           (and (Eq 13 (Load8 (Add i 2) input))
             (Eq 10 (Load8 (Add i 3) input)))))
        (Add i 4))
      (else (go (Inc i)))))
  (go 0))

(define (request-body input)
  (define start (request-body-start input))
  (Ifz start "" (str-drop start input)))

(define (status-line status)
  (cond
    ((Eq status 200) "HTTP/1.0 200 OK")
    ((Eq status 404) "HTTP/1.0 404 Not Found")
    ((Eq status 500) "HTTP/1.0 500 Internal Server Error")
    (else (strcat ["HTTP/1.0 " (showNat status) " Status"]))))

(define (http-res status ctype body)
  (lstrcat
    ~[(status-line status) crlf
      "Content-Type: " ctype crlf
      crlf body]))

;; "/ns/a/b" -> [("ts" "a") ("ts" "b")]; "/", "/ns" -> [].  A leading
;; "ns" segment is the explorer's own prefix and is dropped.
(define (str-slice off len src)
  (Mod (Rsh src (Mul 8 off)) (Lsh 1 (Mul 8 len))))

(define (split-ch ch s)
  (define n (Bytes s))
  (define (go i start acc)
    (If (Ge i n)
      (snoc (str-slice start (Sub i start) s) acc)
      (If (Eq ch (Load8 i s))
        (go (Inc i) (Inc i) (snoc (str-slice start (Sub i start) s) acc))
        (go (Inc i) start acc))))
  (go 0 0 []))

(define (url-target u)
  (define parts (filter (lambda (x) (Nil (Eq 0 (Bytes x)))) (split-ch 47 u)))
  (define parts2
    (If (And (Sz parts) (Equal "ns" (Ix 0 parts)))
      (drop 1 parts)
      parts))
  (map (lambda (t) ("ts" t)) parts2))

;;; Socket layer (thin; blocking IO lives in its own actors) ;;;;;;;;;;;;;;;;;;;;;;;

;; One actor per connection: handshake for the worker handle (handles
;; are per-actor capabilities — they only cross actors through caps,
;; never through closures), then read, parse, ask the worker, write
;; the response (with the sentinel byte — Write drops the top byte),
;; close.
(define (conn-actor fd self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  ;; Read returns a bar (data then a 0x01 terminator): strip the
  ;; terminator, or a request body would carry a stray trailing 0x01
  (define raw (Read fd 65536))
  (define input (str-slice 0 (Dec (Bytes raw)) raw))
  (define parsed (Try milton:parse-http-request input))
  (define method (If (Eq 1 (Hd parsed)) "GET" (Ix 0 (_0 parsed))))
  (define target (If (Eq 1 (Hd parsed)) "/" (Ix 1 (_0 parsed))))
  (define body (request-body input))
  (define m ["req" method target body])
  (Seq (DeepSeq m m)
    (Seq (SendCaps wh m [0])
      (let ((r (Ix 0 (Recv 0))))
        (Seq (Write fd (strWeld (http-res (_1 r) (_3 r) (_2 r)) 1))
          (CloseFd fd))))))

;; Accept loop: handshake for the worker handle, then one actor per
;; connection — the worker cap is re-delegated to each via SendCaps.
(define (listener-pump port self)
  (define mc (Recv 0))
  (define wh (Seq (Ix 0 mc) (Ix 0 (Ix 1 mc))))
  (define listenx (Try Listen port))
  (If (Eq 1 (Hd listenx))
    (Seq (Trace ["pump: listen failed" port (_0 listenx)] 0)
      (Send wh ["noport" port]))
    (let ((fd (_0 listenx)))
      (define (loop z)
        (define conn (Accept fd))
        (Seq (let ((c (Spawn (conn-actor conn))))
               (SendCaps c ["go"] [wh]))
          (loop z)))
      (Seq (Trace ["pump: listening" port] 0)
        (Seq wh (loop 0))))))

;;; The worker ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; helpers = ["H" http-req tslot vine-make vine-cull] — compiled
;; lainapp entries, supplied by whoever spawns the coordinator.
(define (h-req hs) (Ix 1 hs))
(define (h-slot hs) (Ix 2 hs))
(define (h-make hs) (Ix 3 hs))
(define (h-cull hs) (Ix 4 hs))

(define (pend-get pending pax)
  (find (lambda (e) (Equal pax (_0 e))) pending))

(define (pend-drop pending pax)
  (filter (lambda (e) (Nil (Equal pax (_0 e)))) pending))

;; The record's response, if the serving behavior wrote it yet:
;; [status body ctype].
(define (res-of hs resrec)
  (If (Eq "known" (Hd resrec))
    (let ((m (_0 resrec)))
      (let ((status ((h-slot hs) [("ts" "res_status")] 0 m)))
        (Ifz status
          0
          [status
           ((h-slot hs) [("ts" "res_body")] 0 m)
           ((h-slot hs) [("ts" "res_ctype")] "text/plain; charset=utf-8" m)])))
    0))

(define (mk-http-worker hs name self)
  ;; go handshake: the coordinator handle rides the caps; the config
  ;; record rides the message.  Forced before the loop (lazy defines
  ;; would let the loop steal it).  The config's serving kook — not
  ;; this driver — is what answers requests: request records are made
  ;; bare, the /io/<name> take installs the responder on them.
  (define mc (Recv 0))
  (define coord (Seq (DeepSeq mc mc) (Ix 0 (Ix 1 mc))))
  (define rec0 (_1 (Ix 0 mc)))
  (define port
    (If (Eq "known" (Hd rec0))
      ((h-slot hs) [("ts" "port")] 0 (_0 rec0))
      0))
  (define (rpath i)
    [("ts" "io") name ("ts" (strcat ["r" (showNat i)]))])
  ;; state: serial, pending = [[pax conn-cap] ..], queue = [[pax kind] ..]
  (define (loop serial pending queue)
    (define m (Recv 0))
    (define msg (Ix 0 m))
    (define caps (Ix 1 m))
    (define kind (_0 msg))
    (cond
      ((Eq kind "req")
        ;; a new part of the namespace for this connection
        (let* ((pax (rpath serial))
               (record ((h-req hs) (_1 msg) (_2 msg) (_3 msg) (url-target (_2 msg))))
               (task ((h-make hs) pax record))
               (sm ["spy" name pax])
               (cm ["cmd" name task]))
          (Seq (DeepSeq cm (DeepSeq sm sm))
            (Seq (Send coord sm)
              (Seq (Send coord cm)
                (loop (Inc serial)
                  (snoc [pax (Ix 0 caps)] pending)
                  (snoc [pax "make"] queue)))))))
      ((Eq kind "change")
        ;; the watched request node moved: respond when the behavior
        ;; has written the response slots, else re-spy and keep waiting
        (let ((pax (_1 msg))
              (hit (pend-get pending (_1 msg))))
          (Ifz hit
            (loop serial pending queue)
            (let ((r (res-of hs (_2 msg))))
              (Ifz r
                (let ((sm ["spy" name pax]))
                  (Seq (DeepSeq sm sm)
                    (Seq (Send coord sm)
                      (loop serial pending queue))))
                (let ((cm ["cmd" name ((h-cull hs) pax)])
                      (rm ["res" (_0 r) (_1 r) (_2 r)]))
                  (Seq (DeepSeq cm (DeepSeq rm rm))
                    (Seq (Send coord cm)
                      (Seq (Send (_1 (_0 hit)) rm)
                        (loop serial pending (snoc [pax "cull"] queue)))))))))))
      ((Eq kind "ack")
        ;; acks return in cmd order: pop the queue head
        (let ((head (Ix 0 queue))
              (rest (drop 1 queue))
              (rsvp (_1 msg)))
          (cond
            ((Eq "no" (Hd rsvp))
              ;; the command failed — if its connection still waits,
              ;; answer 500 with the failure
              (let ((hit (pend-get pending (_0 head))))
                (Ifz hit
                  (loop serial pending rest)
                  (let ((rm ["res" 500 (_0 (_0 rsvp)) "text/plain; charset=utf-8"]))
                    (Seq (DeepSeq rm rm)
                      (Seq (Send (_1 (_0 hit)) rm)
                        (loop serial (pend-drop pending (_0 head)) rest)))))))
            ((Equal "cull" (_1 head))
              ;; the request node is gone: this connection is done
              (loop serial (pend-drop pending (_0 head)) rest))
            (else (loop serial pending rest)))))
      ((Eq kind "noport")
        (loop serial pending queue))
      ((Eq kind "die") ["dead"])
      (else (loop serial pending queue))))
  (Seq coord
    (Seq (Ifz port
           0
           (let ((pump (Spawn (listener-pump port))))
             (SendCaps pump ["go"] [0])))
      (loop 0 [] []))))

;;; Boot ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The live stack, end to end: compile the helm chain, spawn the
;; coordinator with this HTTP worker, seed a little namespace to
;; explore, make /io/http with the explorer kook + a real port, then
;; park.  Everything after boot is namespace-driven: the serving kook
;; installs the responder, crews hydrate views, the cycle cascades.
;; core0 is passed unevaluated (laziness defers any compile inside it
;; until after the warm block runs in MAIN).
(define (run-lain-boot port core0)
  ;; Warm the socket path in MAIN: spawned actors have no compiler,
  ;; so any lazily-expanded define first demanded inside one dies
  ;; with "no compiler set".  DeepSeq stops at pins, so the warmup
  ;; CALLS each path once — executing in main compiles the whole
  ;; call graph the pump and connection actors will touch.
  (define warm
    (DeepSeq
      [(DeepSeq [conn-actor listener-pump mk-http-worker res-of
                 pend-get pend-drop
                 helm-fetch:mk-fetch-worker helm-fetch:fetch-actor] 0)
       (Try (lambda (z) (milton:parse-http-request "get /x http/1.1")) 0)
       (Try (lambda (z) (milton:parse-http-request "GET /x HTTP/1.1")) 0)
       (url-target "/ns/a/b")
       (http-res 200 "text/plain" "hi")
       (http-res 500 "text/plain" "no")
       (request-body (strcat ["GET / HTTP/1.0" crlf crlf "body"]))
       (helm-fetch:join-hdrs [["a" "b"]])
       (helm-fetch:row-has 1 [1 2])
       (helm-fetch:row-drop 1 [1 2])
       (helm-fetch:row-weld [1] [2])
       (http-client:fetch-warm 0)]
      0))
  (define core (Seq warm core0))
  (define (app path) (helm:core-ent core path))
  (define sov0 ((app ["seeded"]) 0))
  ;; apps compile before the mirror is built, against the core's own
  ;; cache, so app modules mirror (lore included) like kernel code
  (define ar (helm:compile-apps core (helm:core-cache core) (helm:discover-apps 0)))
  ;; the boot image, introspectable at /boot
  (define mirror (helm:boot-mirror-tasks-with (_0 ar) core))
  (define sov1
    (Seq (Trace ["mirroring /boot" (Sz mirror)] 0)
      (helm:seed-tasks core sov0 mirror)))
  ;; one event per app: the pact form expands the whole subtree
  (define sov2
    (Seq (Trace ["mounting apps" (Sz (_1 ar))] 0)
      (helm:mount-apps core sov1 (_1 ar))))
  (define t-data (app ["t_data"]))
  (define vine-make (app ["vine_make"]))
  (define cfg-port (app ["http_cfg_port"]))
  (define helpers
    ["H" (app ["http_req"]) (app ["tslot"]) (app ["vine_make"]) (app ["vine_cull"])])
  (define fhelpers
    ["F" (app ["tslot"]) (app ["fetch_fresh"]) (app ["fetch_hdrs"])
     (app ["fetch_res_ok"]) (app ["fetch_res_err"]) (app ["put_nat"])
     (app ["t0"]) (app ["vine_poke"])])
  (define (mk-worker n)
    (If (Equal n ("ts" "http-client"))
      (helm-fetch:mk-fetch-worker fhelpers n)
      (mk-http-worker helpers n)))
  ;; seed in MAIN (DeepSeq before Spawn): the reef seeding code cannot
  ;; compile-on-demand inside the coordinator ("no compiler set")
  (define coord
    (Seq (DeepSeq sov2 sov2)
      (Spawn (helm:helm-actor core mk-worker sov2))))
  (define (inject t)
    (Seq (SendCaps coord (DeepSeq t ["task" t]) [0])
      (Recv 0)))
  ;; something to look at
  (Seq (inject (vine-make [("ts" "data") ("ts" "hello")] (t-data [("ts" "num")] 41)))
    (Seq (inject (vine-make [("ts" "data") ("ts" "hello") ("ts" "world")] (t-data [("ts" "num")] 42)))
      ;; the drivers: explorer responder on a real listener, plus the
      ;; outbound fetch driver at /io/http-client
      (Seq (inject (vine-make [("ts" "io") ("ts" "http")] (cfg-port ("ts" "hex") port)))
        (Seq (inject (vine-make [("ts" "io") ("ts" "http-client")] ((app ["fetch_cfg"]) 0)))
        (Seq (Trace ["lain listening" port] 0)
          ;; park: the coordinator and its actors do the work now
          (let ((park (lambda (go z) (Seq (Recv 0) (go go z)))))
            (park park 0))))))))

(define (run-lain port)
  (run-lain-boot port (helm:load-helm-mod "helmapp")))

(define (run-lain-artifact-cached port cache)
  (run-lain-boot port (helm:load-helm-mod-artifact-cached cache "helmapp")))

;; Boot from a persisted precompiled image (x/lain binds it to a
;; snapshot top level and refreshes it in a prior session).  A stale
;; or malformed image still boots — refresh falls back to a fresh
;; source build — so this entry can never serve outdated code.
(define (run-lain-image port img)
  (run-lain-boot port
    (helm:helm-image-core (helm:helm-image-refresh img "helmapp"))))
