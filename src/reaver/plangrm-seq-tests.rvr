(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind plangrm (#module plangrm))
(#import plangrm)

(define (seq-one a b) (Seq a b))
(define (seq-two a b c) (Seq2 a b (Ifz c 99 100)))
(define (seq-lazy c x) (Ifz c (Seq x 7) 9))
(define (seq-nested x) (Add (Seq x (Add x 3)) 4))
(define (seq-shared x)
  (define v (Trace ["SEQ-ONCE" x] (Add x 1)))
  (Seq2 v v (Add v v)))
(define (seq-loop i acc)
  (Seq2 i acc (Ifz i acc (seq-loop (Dec i) (Add acc i)))))
(define (seq-checks tag)
  (define first (Try (lambda (z) (error ["first" z])) tag))
  (define second (Try (lambda (z) (error ["second" z])) tag))
  (begin
    (assert (Equal first
      (Try (lambda (z) (seq-one (error ["first" z]) (error ["second" z]))) tag)))
    (assert (Equal first
      (Try (lambda (z) (seq-two (error ["first" z]) (error ["second" z])
                                         (error ["third" z]))) tag)))
    (assert (Equal second
      (Try (lambda (z) (seq-two z (error ["second" z]) (error ["third" z]))) tag)))
    (assert (Eq 9 (seq-lazy tag (error "untaken sequence"))))
    (assert (Eq 2 (Sz (seq-one tag [tag (error "deep force")]))))
    (assert (Eq (Add tag 7) (seq-nested tag)))
    (assert (Eq (Mul 2 (Add tag 1)) (seq-shared tag)))
    (assert (Eq 50005000 (seq-loop 10000 0)))
    (print ["plangrm sequencing tests passed" tag])))
;; These tests must exercise optimised code, not silent dumb fallback.
assert(Nil (Equal (compileP5 seq-two) (codegenLaw seq-two)))
assert(Nil (Equal (compileP6 seq-two) (codegenLaw seq-two)))
assert(Nil (Equal (compileP5 seq-loop) (codegenLaw seq-loop)))
assert(Nil (Equal (compileP6 seq-loop) (codegenLaw seq-loop)))

(define (seq-test-main args)
  (define level (_0 args))
  (define compiler (If (Eq level "p6") compileP6 compileP5))
  (Seq (Save compiler)
    (Seq (Install compiler)
      (Seq (Save seq-checks)
        (seq-checks (If (Eq level "p6") 6 5))))))
