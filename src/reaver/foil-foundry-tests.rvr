(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; foundry.foil: ephemeral requests, immutable /o chains, projection
;;; ceilings, hydration precedence, and provenance.  Surface artifacts are
;;; compiler intermediates, not addressed delivery packets; renderer payloads
;;; are deliberately absent from this test surface.

(define sut (stage:sut-of "foundry"))
(define (app path) (foil:source-entry-val path sut))
(define doc-sut (stage:sut-of "foundry_doc"))
(define (doc-app path) (foil:source-entry-val path doc-sut))

(define f-request (app ["foundry" "make_request"]))
(define f-layer (app ["foundry" "make_layer"]))
(define f-cascade (app ["foundry" "cascade"]))
(define f-hydrate (app ["foundry" "hydrate"]))
(define f-chain (app ["foundry" "chain"]))
(define f-step (app ["foundry" "make_step"]))
(define f-compile (app ["foundry" "compile"]))
(define f-within (app ["foundry" "within"]))
(define f-cache-key (app ["foundry" "make_cache_key"]))
(define f-cache-new (app ["foundry" "cache_new"]))
(define f-cache-get (app ["foundry" "cache_get"]))
(define f-cache-put (app ["foundry" "cache_put"]))
(define f-plan-record (app ["foundry" "plan_record"]))
(define f-plan-report (app ["foundry" "plan_report"]))
(define f-plan-recipes (app ["foundry" "plan_recipes"]))
(define f-plan-diagnostics (app ["foundry" "plan_diagnostics"]))
(define f-hyd-values (app ["foundry" "hydration_values"]))
(define f-hyd-provenance (app ["foundry" "hydration_provenance"]))
(define f-winner-at (app ["foundry" "cascade_winner_at"]))
(define f-winner-layer (app ["foundry" "winner_layer"]))
(define f-winner-guarded (app ["foundry" "winner_guarded"]))
(define f-winner-ordinal (app ["foundry" "winner_ordinal"]))
(define f-fallback (app ["foundry" "make_fallback"]))
(define f-fallback-edge (app ["foundry" "make_fallback_edge"]))
(define f-resolve-fallbacks (app ["foundry" "resolve_fallbacks"]))
(define f-fallback-selected
  (app ["foundry" "fallback_resolution_selected"]))
(define f-fallback-trace
  (app ["foundry" "fallback_resolution_trace"]))
(define f-fallback-code
  (app ["foundry" "fallback_resolution_code"]))
(define f-trace-selected (app ["foundry" "fallback_trace_selected"]))
(define f-trace-class (app ["foundry" "fallback_trace_class"]))
(define f-trace-chain (app ["foundry" "fallback_trace_chain"]))
(define f-trace-observations
  (app ["foundry" "fallback_trace_observations"]))
(define f-trace-actions (app ["foundry" "fallback_trace_actions"]))
(define f-slot (app ["foundry" "make_slot_contract"]))
(define f-resolve-slot (app ["foundry" "resolve_slot"]))
(define f-slot-code (app ["foundry" "slot_outcome_code"]))
(define f-surface-artifact-tree (app ["foundry" "surface_artifact_tree"]))
(define f-legacy-packet-tree (app ["foundry" "packet_tree"]))
(define f-cache-read-value (app ["foundry" "cache_read_value"]))
(define f-cache-read-next (app ["foundry" "cache_read_next"]))
(define f-cache-entries (app ["foundry" "cache_entries"]))
(define f-cache-hits (app ["foundry" "cache_hits"]))
(define f-cache-misses (app ["foundry" "cache_misses"]))
(define f-text-record (app ["foundry" "text_record"]))
(define f-text-layer (app ["foundry" "text_layer"]))
(define f-layer-values (app ["foundry" "layer_values"]))
(define tree-one (app ["surface_tree" "one"]))
(define mnew (app ["myth" "new"]))
(define txt-at (app ["myth" "txt_at"]))
(define pail-at (app ["myth" "pail_at"]))

(define d-compile (doc-app ["foundry_doc" "compile"]))
(define d-value (doc-app ["foundry_doc" "compilation_value"]))
(define d-kind (doc-app ["foundry_doc" "compilation_kind"]))
(define d-name (doc-app ["foundry_doc" "compilation_name"]))
(define d-document-layer (doc-app ["foundry_doc" "document_layer"]))
(define d-document-surface (doc-app ["foundry_doc" "document_surface"]))
(define d-surface-nodes (doc-app ["foundry_doc" "surface_nodes"]))
(define d-node-kind (doc-app ["foundry_doc" "node_kind"]))
(define d-node-role (doc-app ["foundry_doc" "node_role"]))

(define ts (lambda (s) ("ts" s)))
(define accent [(ts "color") (ts "accent")])
(define density [(ts "layout") (ts "density")])

;;; composition ceilings ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Eq 1 (f-within (ts "glyph") (ts "plate")))
assert(Eq 1 (f-within (ts "plate") (ts "plate")))
assert(Eq 0 (f-within (ts "scene") (ts "plate")))
assert(Eq 1 (f-within (ts "stage") (ts "stage")))

;;; canonical nested /o reports ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define src [(ts "chat") (ts "log")])
(define p0 [(ts "chat") (ts "weft") (ts "surface")])
(define p1 [(ts "chat") (ts "weft") (ts "scene")])
(define report (f-chain [p0 p1] src))
(define first
  [(ts "o") ("u" 1) ("u" 3) (ts "chat") (ts "weft") (ts "surface")
   ("u" 2) (ts "chat") (ts "log")])
assert(Equal
  [(ts "o") ("u" 1) ("u" 3) (ts "chat") (ts "weft") (ts "scene")
   ("u" 9)
   (ts "o") ("u" 1) ("u" 3) (ts "chat") (ts "weft") (ts "surface")
   ("u" 2) (ts "chat") (ts "log")]
  report)
assert(Equal first (f-chain [p0] src))

;;; typed compiler plans and ceiling refusal ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define plate-req
  (f-request src [(ts "chat") (ts "plate")] (ts "full") (ts "plate")
    (ts "web") [(ts "pronunciation") (ts "shrine")] []))
(define refused
  (f-compile plate-req
    [(f-step p0 (ts "plate")) (f-step p1 (ts "scene"))]))
assert(Equal src (f-plan-report refused))
assert(Eq 0 (Sz (f-plan-recipes refused)))
assert(Eq 1 (Sz (f-plan-diagnostics refused)))
(define stage-req
  (f-request src [(ts "desktop") (ts "stage")] (ts "full") (ts "stage")
    (ts "web") [(ts "pronunciation") (ts "shrine")] []))
(define admitted
  (f-compile stage-req
    [(f-step p0 (ts "plate")) (f-step p1 (ts "scene"))]))
assert(Equal report (f-plan-report admitted))
assert(Equal [p0 p1] (f-plan-recipes admitted))
assert(Eq 0 (Sz (f-plan-diagnostics admitted)))

;;; case-keyed compiler-artifact cache and inspectable refusal ;;;;;;;;;;;;;;;;

(define admitted-record (f-plan-record admitted))
assert(Equal (ts "admitted")
  (_0 (pail-at [(ts "foundry") (ts "status")] admitted-record)))
(define refused-record (f-plan-record refused))
assert(Equal (ts "refused")
  (_0 (pail-at [(ts "foundry") (ts "status")] refused-record)))
assert(Equal (ts "ceiling_refused")
  (_0 (pail-at
    [(ts "foundry") (ts "diagnostic") (ts "code")] refused-record)))

;;; hydration cascade and protected pronunciation ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define broad
  (f-text-layer [(ts "foundry") (ts "baseline")]
    accent "blue" 0))
(define space
  (f-text-layer [(ts "space") (ts "default")]
    density "comfortable" 0))
(define plate
  (f-text-layer [(ts "plate") (ts "chat")]
    accent "green" 0))
(define access
  (f-text-layer [(ts "client") (ts "accessibility")]
    accent "contrast" 1))

;; Guarded layers apply after every ordinary layer even when supplied first.
(define hyd (f-cascade [access broad space plate]))
(define vals (f-hyd-values hyd))
(define prov (f-hyd-provenance hyd))
assert(Equal "contrast" (txt-at accent vals))
assert(Equal "comfortable" (txt-at density vals))
assert(Equal [(ts "client") (ts "accessibility")] (_0 (pail-at accent prov)))
assert(Equal [(ts "space") (ts "default")] (_0 (pail-at density prov)))

;; Winner evidence retains guard state and original declaration position even
;; though guarded fragments replay after every ordinary fragment.
(define accent-winner (_0 (f-winner-at accent hyd)))
(define density-winner (_0 (f-winner-at density hyd)))
assert(Equal [(ts "client") (ts "accessibility")]
  (f-winner-layer accent-winner))
assert(Eq 1 (f-winner-guarded accent-winner))
assert(Eq 0 (f-winner-ordinal accent-winner))
assert(Equal [(ts "space") (ts "default")]
  (f-winner-layer density-winner))
assert(Eq 0 (f-winner-guarded density-winner))
assert(Eq 2 (f-winner-ordinal density-winner))

;; Guarded accessibility policy wins independently of where it appears in the
;; authored input row.  Its ordinal remains provenance, not precedence.
(define hyd-reordered (f-cascade [plate broad space access]))
assert(Equal "contrast" (txt-at accent (f-hyd-values hyd-reordered)))
assert(Equal [(ts "client") (ts "accessibility")]
  (_0 (pail-at accent (f-hyd-provenance hyd-reordered))))
(define accent-winner-reordered
  (_0 (f-winner-at accent hyd-reordered)))
assert(Eq 1 (f-winner-guarded accent-winner-reordered))
assert(Eq 3 (f-winner-ordinal accent-winner-reordered))

;;; Slot attachment, fallback, omission, and refusal laws ;;;;;;;;;;;;;;;;;;;;;

(define title-fallback
  (f-fallback (ts "semantic")
    [(ts "foundry") (ts "system") (ts "fallbacks") (ts "plain_title")]
    (ts "text") (ts "text")))
(define title-slot
  (f-slot [(ts "foundry") (ts "system") (ts "slots") (ts "plate_header")
           (ts "title")]
    [(ts "text")] (ts "one") 1
    ("/boot/maybe/some" title-fallback)
    [(ts "participation") (ts "label")]))

(define title-resolved
  (f-resolve-slot title-slot [(ts "text")] (ts "plate") 0))
assert(Equal "/boot/foundry/slot_outcome/resolved" (Hd title-resolved))
(define title-fell-back
  (f-resolve-slot title-slot [] (ts "plate") 1))
assert(Equal "/boot/foundry/slot_outcome/fallback" (Hd title-fell-back))
(define title-refused
  (f-resolve-slot title-slot [] (ts "plate") 0))
assert(Equal "/boot/foundry/slot_outcome/refused" (Hd title-refused))
assert(Equal ("/boot/maybe/some" (ts "slot_fallback_unavailable"))
  (f-slot-code title-refused))

(define optional-status
  (f-slot [(ts "foundry") (ts "system") (ts "slots") (ts "plate_header")
           (ts "status")]
    [(ts "block") (ts "text") (ts "glyph")] (ts "one") 0
    "/boot/maybe/none" [(ts "participation") (ts "status")]))
assert(Equal "/boot/foundry/slot_outcome/omitted"
  (Hd (f-resolve-slot optional-status [] (ts "plate") 0)))
assert(Equal ("/boot/maybe/some" (ts "slot_cardinality_exceeded"))
  (f-slot-code
    (f-resolve-slot optional-status [(ts "text") (ts "glyph")]
      (ts "plate") 0)))
assert(Equal ("/boot/maybe/some" (ts "slot_attachment_incompatible"))
  (f-slot-code
    (f-resolve-slot title-slot [(ts "block")] (ts "plate") 0)))

;; Structural fallback may reduce, never widen.  Refusal is an outcome, not a
;; fifth fallback class.
(define widening
  (f-fallback (ts "structural") [(ts "fallback") (ts "wide")]
    (ts "block") (ts "plate")))
(define widening-slot
  (f-slot [(ts "slot") (ts "wide")] [(ts "plate")] (ts "one") 1
    ("/boot/maybe/some" widening) [(ts "participation") (ts "content")]))
assert(Equal ("/boot/maybe/some" (ts "fallback_widened"))
  (f-slot-code (f-resolve-slot widening-slot [] (ts "plate") 1)))

;;; Ordered fallback DAG, cycle, ceiling, and authority laws ;;;;;;;;;;;;;;;;;;

(define fallback-root [(ts "projection") (ts "chat") (ts "message")])
(define fallback-a [(ts "foundry") (ts "fallback") (ts "compact")])
(define fallback-b [(ts "foundry") (ts "fallback") (ts "text")])
(define fallback-c [(ts "foundry") (ts "fallback") (ts "terminal")])
(define observe-log [(ts "observe") (ts "chat") (ts "log")])
(define observe-title [(ts "observe") (ts "chat") (ts "title")])
(define send-message [(ts "action") (ts "chat") (ts "send")])
(define edit-layout [(ts "action") (ts "desktop") (ts "layout")])

(define edge-a
  (f-fallback-edge fallback-root
    (f-fallback (ts "structural") fallback-a (ts "plate") (ts "block"))
    [observe-log] [send-message]))
(define edge-a-terminal
  (f-fallback-edge fallback-a
    (f-fallback (ts "renderer") fallback-c (ts "block") (ts "block"))
    [] []))
(define edge-b
  (f-fallback-edge fallback-root
    (f-fallback (ts "structural") fallback-b (ts "plate") (ts "text"))
    [] []))

;; The first authored chain wins completely.  Membership-row order for known
;; and available definitions cannot change that result.
(define ordered-a
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [observe-log observe-title] [send-message edit-layout]
    [fallback-root fallback-a fallback-b fallback-c]
    [fallback-b fallback-c]
    [edge-a edge-a-terminal edge-b]))
(define ordered-b
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [observe-log observe-title] [send-message edit-layout]
    [fallback-c fallback-b fallback-a fallback-root]
    [fallback-c fallback-b]
    [edge-a edge-a-terminal edge-b]))
assert(Eq 1 (f-fallback-selected ordered-a))
assert(Equal ordered-a ordered-b)
(define ordered-trace (_0 (f-fallback-trace ordered-a)))
assert(Equal fallback-c (f-trace-selected ordered-trace))
assert(Equal (ts "renderer") (f-trace-class ordered-trace))
assert(Equal [fallback-root fallback-a fallback-c]
  (f-trace-chain ordered-trace))
assert(Equal [] (f-trace-observations ordered-trace))
assert(Equal [] (f-trace-actions ordered-trace))

;; A cyclic first chain refuses instead of falling through to a later sibling.
(define cycle-edge
  (f-fallback-edge fallback-a
    (f-fallback (ts "structural") fallback-root (ts "block") (ts "block"))
    [observe-log] [send-message]))
(define cyclic
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [observe-log] [send-message]
    [fallback-root fallback-a fallback-b]
    [fallback-b]
    [edge-a cycle-edge edge-b]))
assert(Eq 0 (f-fallback-selected cyclic))
assert(Equal ("/boot/maybe/some" (ts "fallback_cycle"))
  (f-fallback-code cyclic))

;; Neither observation nor action authority can widen while degrading.
(define observation-wide
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [observe-log] [send-message]
    [fallback-root fallback-a] []
    [(f-fallback-edge fallback-root
       (f-fallback (ts "structural") fallback-a (ts "plate") (ts "block"))
       [observe-log observe-title] [send-message])]))
assert(Equal ("/boot/maybe/some" (ts "fallback_observation_widened"))
  (f-fallback-code observation-wide))
(define action-wide
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [observe-log] [send-message]
    [fallback-root fallback-a] []
    [(f-fallback-edge fallback-root
       (f-fallback (ts "structural") fallback-a (ts "plate") (ts "block"))
       [observe-log] [send-message edit-layout])]))
assert(Equal ("/boot/maybe/some" (ts "fallback_action_widened"))
  (f-fallback-code action-wide))

;; Missing targets and an exhausted graph are explicit refusal evidence.
(define missing-target
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [] [] [fallback-root] [] [edge-b]))
assert(Equal ("/boot/maybe/some" (ts "fallback_target_missing"))
  (f-fallback-code missing-target))
(define exhausted
  (f-resolve-fallbacks fallback-root (ts "plate") (ts "plate")
    [] [] [fallback-root] [] []))
assert(Equal ("/boot/maybe/some" (ts "fallback_exhausted"))
  (f-fallback-code exhausted))

;;; Shared system definitions keep style, structure, and chrome distinct ;;;;;;

(define (doc-compilation file) (d-compile (read-text-file file)))
(define (doc-value compilation)
  (define value (d-value compilation))
  assert(Equal "/boot/maybe/some" (Hd value))
  (_0 value))

(define header-style-comp
  (doc-compilation "foil/foundry/system/00-style-header-text.sd"))
assert(Equal ("/boot/maybe/some" (ts "layer")) (d-kind header-style-comp))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "styles") (ts "header_text")])
  (d-name header-style-comp))
(define header-style
  (_0 (d-document-layer (doc-value header-style-comp))))
(define header-values (_1 header-style))
assert(Equal "/boot/pails/p"
  (Hd (pail-at [(ts "token") (ts "type") (ts "header") (ts "weight")]
    header-values)))
;; Header Text Style deliberately owns no structural anatomy or text color.
assert(Equal "/boot/pails/n"
  (Hd (pail-at [(ts "token") (ts "color") (ts "text")]
    header-values)))

(define plate-header-comp
  (doc-compilation "foil/foundry/system/10-block-plate-header.sd"))
(define title-bar-comp
  (doc-compilation "foil/foundry/system/11-block-title-bar.sd"))
(define plain-fallback-surface-comp
  (doc-compilation "foil/foundry/system/12-surface-plain-text-fallback.sd"))
(define plain-fallback-recipe-comp
  (doc-compilation "foil/foundry/system/13-recipe-plain-text-fallback.sd"))
(define fallback-specimen-comp
  (doc-compilation "foil/foundry/system/14-block-fallback-specimen.sd"))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "blocks") (ts "plate_header")])
  (d-name plate-header-comp))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "blocks") (ts "title_bar")])
  (d-name title-bar-comp))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "fallbacks")
     (ts "plain_text_surface")])
  (d-name plain-fallback-surface-comp))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "recipes")
     (ts "plain_text_fallback")])
  (d-name plain-fallback-recipe-comp))
assert(Equal
  ("/boot/maybe/some"
    [(ts "foundry") (ts "system") (ts "blocks")
     (ts "fallback_specimen")])
  (d-name fallback-specimen-comp))
(define plate-header
  (_0 (d-document-surface (doc-value plate-header-comp))))
(define title-bar
  (_0 (d-document-surface (doc-value title-bar-comp))))
(define plate-header-nodes (d-surface-nodes plate-header))
(define title-bar-nodes (d-surface-nodes title-bar))
assert(Eq 7 (Sz plate-header-nodes))
assert(Eq 3 (Sz title-bar-nodes))
assert(Equal (ts "block") (d-node-kind (Ix 0 plate-header-nodes)))
assert(Equal
  [(ts "foundry") (ts "system") (ts "blocks") (ts "plate_header")]
  (d-node-role (Ix 0 plate-header-nodes)))
assert(Equal
  [(ts "foundry") (ts "system") (ts "chrome") (ts "title_bar")]
  (d-node-role (Ix 0 title-bar-nodes)))

;;; compiler artifact stamping preserves unknown semantic root data ;;;;;;;;;;;

(define unknown [(ts "vendor") (ts "future")])
(define root (f-text-record unknown "preserved"))
(define tree (tree-one root))
(define req
  (f-request src [(ts "chat") (ts "plate")] (ts "full") (ts "plate")
    (ts "web") [(ts "pronunciation") (ts "shrine")] []))
(define artifact (f-hydrate req tree [broad plate access]))
(define out-tree (f-surface-artifact-tree artifact))
;; The old accessor remains only while Chat is cut over to addressed delivery.
assert(Equal out-tree (f-legacy-packet-tree artifact))
(define out-root (_0 (_0 out-tree)))
assert(Equal "preserved" (txt-at unknown out-root))
assert(Equal "contrast"
  (txt-at [(ts "foundry") (ts "resolved") (ts "color") (ts "accent")]
    out-root))
assert(Equal [(ts "client") (ts "accessibility")]
  (_0 (pail-at
        [(ts "foundry") (ts "provenance") (ts "color") (ts "accent")]
        out-root)))
assert(Eq 2
  (_0 (pail-at
        [(ts "foundry") (ts "cascade") (ts "ordinal")
         (ts "color") (ts "accent")]
        out-root)))
assert(Equal (ts "guarded")
  (_0 (pail-at
        [(ts "foundry") (ts "cascade") (ts "guard")
         (ts "color") (ts "accent")]
        out-root)))
assert(Equal src (_0 (pail-at [(ts "projection") (ts "source")] out-root)))
assert(Equal [(ts "chat") (ts "plate")]
  (_0 (pail-at [(ts "projection") (ts "role")] out-root)))

(define key1
  (f-cache-key report 10 [[(ts "foundry") (ts "baseline")]]
    (ts "web") [(ts "shrine") (ts "default")] []))
(define key2
  (f-cache-key report 11 [[(ts "foundry") (ts "baseline")]]
    (ts "web") [(ts "shrine") (ts "default")] []))
(define cache0 (f-cache-new 1))
(define miss1 (f-cache-get key1 cache0))
assert(Equal "/boot/maybe/none" (Hd (f-cache-read-value miss1)))
assert(Eq 1 (f-cache-misses (f-cache-read-next miss1)))
(define cache1 (f-cache-put key1 artifact (f-cache-read-next miss1)))
(define hit1 (f-cache-get key1 cache1))
assert(Equal "/boot/maybe/some" (Hd (f-cache-read-value hit1)))
assert(Eq 1 (f-cache-hits (f-cache-read-next hit1)))
;; A source/report case movement is an explicit cache miss.
(define miss2 (f-cache-get key2 (f-cache-read-next hit1)))
assert(Equal "/boot/maybe/none" (Hd (f-cache-read-value miss2)))
;; Limit-one FIFO retains only the newly stored case.
(define cache2 (f-cache-put key2 artifact (f-cache-read-next miss2)))
assert(Eq 1 (Sz (f-cache-entries cache2)))
assert(Equal "/boot/maybe/none"
  (Hd (f-cache-read-value (f-cache-get key1 cache2))))

(print "foundry tests passed")
