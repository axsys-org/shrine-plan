;;;; One Grove compilation unit, organized by named composition responsibility.
;;;; No generated HTML or executable renderer substitution lives in the host.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(define (read ignored)
  (strcat [
    (read-text-file "grove/debugger/application.grove") 10
    (read-text-file "grove/debugger.grove") 10
    (read-text-file "grove/debugger/chrome.grove") 10
    (read-text-file "grove/debugger/presentation.grove") 10
    (read-text-file "grove/debugger/model.grove") 10
    (read-text-file "grove/debugger/document.grove") 10
    (read-text-file "grove/debugger/instance.grove")]))
(#export read)
