(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind abi (#module foil-abi))

(define (run ignored)
  (define compiler (Pin "bootstrap-test-compiler"))
  (define slot [("x" 17) ("ts" "compiler") ("ts" "artifact")])
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define build (bootstrap:build-system compiler resolve slot))
  (define system (bootstrap:trusted build))
  (define local (bootstrap:build-local ("x" 17) build resolve slot ["eden" "test_fixtures/published_documentation"]))
  (define state (_0 local))
  (define code (Unpin (_1 local)))
  (define eden
    (Unpin (_1 (need (find (lambda (pair) (Equal "eden" (_0 pair))) (_2 code))))))
  (define ready
    ((driver:get-perc ["eden" "boot"] eden)
      ("x" 17) system (_1 state) 18131))
  (If (Equal "err" (Hd ready)) (error ["grounded-eden-boot-failed" (_0 ready)]) 0)
  assert(Equal "ok" (Hd ready))
  assert(Equal system (_2 (_0 ready)))
  (define version (driver:get-perc ["namespace" "case"] eden))
  (define x (abi:constructor eden ["care" "x"]))
  (define some (abi:option eden "some"))
  (define definition
    [("x" 17) ("ts" "lib") ("ts" "eden")
     ("ts" "eden") ("ts" "boot")])
  assert(Equal (some 1) (version x definition state))
  assert(Equal (some 1) (version x definition (_0 ready)))
  assert(Equal (some 1)
    (version x [("ts" "sys") ("ts" "mold")] (_0 ready)))
  ;; Former publisher keys and supplemental vocabulary are system definitions.
  (DeepSeq (map (lambda (path)
    (assert-impl "published-system-slot"
      (Equal (some 1) (version x path (_0 ready)))))
    [[("ts" "sys") ("ts" "face")]
     [("ts" "sys") ("ts" "fs") ("ts" "source") ("ts" "status")]
     [("ts" "sys") ("ts" "content")]
     [("ts" "sys") ("ts" "codex") ("ts" "command")]]) 0)
  ;; Read committed records without the documentation browser or its reader.
  (define docs
    (Unpin (_1 (need (find (lambda (pair)
      (Equal "test_fixtures/published_documentation" (_0 pair))) (_2 code))))))
  (DeepSeq (map (lambda (check) (assert-impl (_0 check) (_1 check)))
    ((driver:get-perc ["publication_documentation_checks"] docs) (_0 ready))) 0)
  0)
assert(Equal 0 (run 0))
