;;;; Native authoring transport. No expression DSL, Python state, or model.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind sub (#module foil-subject))
(#bind render (#module foil-render))
(#bind doctest (#module doctest))
(#bind wire (#module wire-json))
(#bind parse (#module parse))
(#import parse)
(#bind opt (#module plangrm))

(define compiled (Pin (foil:compile-mod-cached 0 foil:default-subject "shadow")))
(define sut (Pin (_1 (Unpin compiled))))
(define (ent p) (foil:source-entry-val p (Unpin sut)))
(define parse-json (ent ["parse"]))
(define show-json (ent ["show"]))
(define empty (ent ["myth" "new"]))
(define initial (ent ["sov" "new"]))
(define initial-index ((ent ["hive_of"]) initial))
(define (ts s) ("ts" s))
(define (segment j)
  (If (Eq "/boot/json/str" (Hd j)) (ts (_0 j))
    (let ((tag (wire:jget-str "tag" j)) (value (wire:jget "value" j)))
      (If (Eq "/boot/json/num" (Hd value)) (tag (wire:jnat 0 value)) (Throw "Expected a native path segment")))))
(define (path j) (map segment (_0 j)))
(define (segment-json q)
  (If (Eq "ts" (Hd q)) (wire:jq (_0 q)) (wire:jobj [["tag" (wire:jq (Hd q))] ["value" (showNat (_0 q))]])))
(define (path-json p) (wire:jarr (map segment-json p)))
(define (path-text p) (strcat ["/" (join-str "/" (map (lambda (q) (If (Eq "ts" (Hd q)) (_0 q) (strcat ["~" (Hd q) ":" (showNat (_0 q))]))) p))]))
(define (field key val t) ((ent ["shadow" "put"]) key val t))
(define (get key t) ((ent ["shadow" "get"]) key t))
(define (exact p state) ((ent ["shadow" "exact"]) p state))
(define (case-at p state) ((ent ["shadow" "case"]) p state))
(define (need-record p c state)
  (define r (Ifz c (exact p state) ((ent ["shadow" "historical"]) c p state)))
  (If (Eq "/boot/maybe/some" (Hd r)) (_0 r) (Throw ["record unavailable" (path-text p) c])))
(define (need-slot p c slot state)
  (define r (get slot (need-record p c state)))
  (If (Eq "/boot/maybe/some" (Hd r)) (_0 r) (Throw ["slot unavailable" (path-text p) (path-text slot)])))
(define (native-ref p c slot unbox)
  (wire:jobj [["$native" (wire:jobj [["path" (path-json p)] ["case" (showNat c)] ["slot" (path-json slot)] ["unbox" (If unbox "true" "false")]])]]))
(define (ref-value r state)
  (define p (path (wire:jget "path" r)))
  (define c (wire:jget-nat "case" 0 r))
  (Ifz c (Throw "native references require a historical case")
    (let ((v (need-slot p c (path (wire:jget "slot" r)) state)))
      (If (Eq "/boot/json/boo" (Hd (wire:jget "unbox" r)))
        (If (_0 (wire:jget "unbox" r))
          (If (Eq "/boot/pails/code" (Hd v)) (_0 v) (Throw "reference is not boxed code")) v)
        v))))
(define (decode-value j state)
  (define r (wire:jget "$native" j))
  (cond
    (r (let ((v (ref-value r state)))
         (If (And (IsApp v) (IsNat (Hd v))) v ("/boot/pails/code" v))))
    ((wire:jget "$literal" j) ((ent ["shadow" "pack"]) (wire:jget "$literal" j)))
    (else ((ent ["shadow" "pack"]) j))))
(define (decode-slots j state)
  (foldl (lambda (t item)
    (field (path (wire:jget "key" item)) (decode-value (wire:jget "value" item) state) t)) empty (_0 j)))
(define (value-json v p c slot)
  (cond
    ((Eq "/boot/pails/t" (Hd v)) (wire:jq (_0 v)))
    ((Eq "/boot/pails/n" (Hd v)) (showNat (_0 v)))
    ((Eq "/boot/shadow/literal" (Hd v)) (show-json (_0 v)))
    (else (native-ref p c slot 0))))
(define (record-json-at p t c state)
  (define slots ((ent ["shadow" "slots"]) t))
  (wire:jobj [["path" (wire:jq (path-text p))] ["path_segments" (path-json p)] ["case" (showNat c)]
    ["crew" (wire:jarr (map (lambda (d) (wire:jobj [["slot" (path-json (Ix 0 d))] ["path" (wire:jq (path-text (Ix 1 d)))] ["care" (wire:jq (Ix 2 d))]])) ((ent ["shadow" "crew_rows"]) t)))]
    ["behaviors" (wire:jarr (map (lambda (p) (wire:jq (path-text p))) ((ent ["shadow" "behaviors"]) t)))]
    ["slots" (wire:jarr (map (lambda (kv)
      (wire:jobj [["key" (path-json (_0 kv))] ["value" (value-json (_1 kv) p c (_0 kv))]
        ["type" (wire:jq (If (IsNat (Hd (_1 kv))) (Hd (_1 kv)) "native"))]
        ["render" (wire:jq (render:dt-val (_1 kv)))]
        ["ref" (native-ref p c (_0 kv) 0)]])) slots))]]))
(define (record-json p t state) (record-json-at p t (case-at p state) state))
(define (move-json m state)
  (define w (Ix 2 m))
  (define op (cond ((Eq "/boot/writ/make" (Hd w)) "make") ((Eq "/boot/writ/poke" (Hd w)) "poke") (else "cull")))
  (wire:jobj [["source" (wire:jq (path-text (Ix 0 m)))] ["path" (wire:jq (path-text (Ix 1 m)))]
    ["op" (wire:jq op)] ["slots" (If (Eq op "cull") "[]"
      (wire:jarr (map (lambda (kv) (wire:jobj [["key" (path-json (_0 kv))]
        ["value" (cond ((Eq "/boot/pails/p" (Hd (_1 kv))) (wire:jq (path-text (_0 (_1 kv)))))
                       ((Eq "/boot/pails/t" (Hd (_1 kv))) (wire:jq (_0 (_1 kv))))
                       (else (wire:jq (render:dt-val (_1 kv)))))]])) ((ent ["shadow" "slots"]) (_0 w)))))]]))
(define (apply-write op p t expected state index)
  ((ent ["shadow" "run"]) op p t expected state index))
(define (write-reply r before effect-json)
  (define state (Ix 0 r))
  (wire:jobj [["ok" (If (Ix 2 r) "true" "false")] ["error" (wire:jq (Ix 3 r))]
    ["ack" (If (Eq "/boot/maybe/some" (Hd (Ix 4 r))) (wire:jq (path-text (_0 (Ix 4 r)))) "null")]
    ["effects" effect-json]
    ["changes" (wire:jarr (map (lambda (p)
      (let ((cur (exact p state)))
        (wire:jobj [["path" (wire:jq (path-text p))] ["case" (showNat (case-at p state))]
          ["record" (If (Eq "/boot/maybe/some" (Hd cur)) (record-json p (_0 cur) state) "null")]]))) (Ix 6 r)))]]))
(define (vault id v ty state index)
  (define p [(ts "_shadow") (ts "values") (ts id)])
  (define t (field [(ts "value")] ("/boot/pails/code" v)
    (field [(ts "type")] ("/boot/pails/code" ty) empty)))
  (define r (apply-write "make" p t ("/boot/maybe/some" 0) state index))
  (Ifz (Ix 2 r) (Throw ["vault write failed" (Ix 3 r)])
    [(Ix 0 r) (Ix 1 r) p (case-at p (Ix 0 r))]))
(define (type-at p) (sub:tc-ty (foil:ent-tc (foil:entry-parts (Unpin sut) (sub:canon-path p (Unpin sut))))))
(define (typed-ref r state)
  (define p (path (wire:jget "path" r)))
  (define c (wire:jget-nat "case" 0 r))
  [(ref-value r state) (If (Eq "/boot/json/boo" (Hd (wire:jget "unbox" r)))
    (If (_0 (wire:jget "unbox" r)) (_0 (need-slot p c [(ts "type")] state)) (type-at ["shadow" "sample_pail"]))
    (type-at ["shadow" "sample_pail"]))])
(define (typed-input j state)
  (define r (wire:jget "$native" j))
  (define record (wire:jget "$record" j))
  (cond
    (r (typed-ref r state))
    (record [(need-record (path (wire:jget "path" record)) (wire:jget-nat "case" 0 record) state) (type-at ["myth" "new"])])
    (else [(decode-value j state) (type-at ["shadow" "sample_pail"])])))
(define (input-subject inputs state base)
  (Ifz inputs base
    (foldl (lambda (acc kv)
      (let* ((name (_0 kv)) (r (wire:jget "$native" (_1 kv)))
             (pair (typed-input (_1 kv) state))
             (key (Weld (sub:sut-root acc) [name])))
        (sub:mark-visible key key (sub:insert-ffi key (_0 pair) (_1 pair) acc)))) base (_0 inputs))))
(define (decode-record j state)
  (define input ("/boot/json/obj" [["record" j]]))
  (define subject (input-subject input state (Unpin sut)))
  (define got (doctest:eval-text subject "(shadow/as_record record)"))
  (If (Eq 1 (Hd got)) (Throw (_0 got)) (_0 (_0 got))))
(define (retain-effects id r)
  (define (go i state index out)
    (If (Ge i (Sz (Ix 5 r))) [state index (wire:jarr out)]
      (let* ((m (Ix i (Ix 5 r)))
             (h (vault (strcat ["effect-" id "-" (showNat i)]) m (type-at ["shadow" "sample_move"]) state index))
             (ref (native-ref (Ix 2 h) (Ix 3 h) [(ts "value")] 1))
             (preview (move-json m (Ix 0 h)))
             (obj (wire:jval (parse-json preview)))
             (encoded (wire:jobj (snoc ["native" ref] (map (lambda (kv) [(_0 kv) (show-json (_1 kv))]) (_0 obj))))))
        (go (Inc i) (Ix 0 h) (Ix 1 h) (snoc encoded out)))))
  (go 0 (Ix 0 r) (Ix 1 r) []))
(define (compile-request v state index)
  (define mod (wire:jget-str "module" v))
  (define id (wire:jget-str "id" v))
  (define cr (foil:compile-mod-cached (_0 (Unpin compiled)) foil:default-subject mod))
  (define ms (_1 cr))
  (define held (vault id ms 0 state index))
  (define mp (Ix 2 held))
  (define module-ref (native-ref mp (Ix 3 held) [(ts "value")] 1))
  (define names (wire:jget "exports" v))
  (define (go i st hi out)
    (If (Ge i (Sz (_0 names)))
      [st hi (wire:jobj [["ok" "true"] ["module" module-ref] ["import_closure" (wire:jarr-str (foil:foil-closure-files [mod]))] ["exports" (wire:jobj out)]])]
      (let* ((sp (map wire:jstr (_0 (Ix i (_0 names)))))
             (ep (sub:canon-path sp ms))
             (e (foil:entry-parts ms ep))
             (ev (If (foil:ent-lowered e) (foil:ent-val e) (Throw "export is not executable")))
             (h (vault (strcat [id "-" (showNat i)]) ev (sub:tc-ty (foil:ent-tc e)) st hi)))
        (go (Inc i) (Ix 0 h) (Ix 1 h)
          (snoc [(join-str "/" sp) (native-ref (Ix 2 h) (Ix 3 h) [(ts "value")] 1)] out)))))
  (DeepSeq cr (go 0 (Ix 0 held) (Ix 1 held) [])))
(define (eval-request v state index)
  (define mr (wire:jget "$native" (wire:jget "module" v)))
  (define base (If mr (ref-value mr state) (Unpin sut)))
  (define target (input-subject (wire:jget "inputs" v) state base))
  (define got (doctest:eval-text target (wire:jget-str "expression" v)))
  (If (Eq 1 (Hd got)) (Throw (_0 got))
    (let* ((pair (_0 got)) (h (vault (wire:jget-str "id" v) (_0 pair) (_1 pair) state index)))
      [(Ix 0 h) (Ix 1 h) (wire:jobj [["ok" "true"]
        ["value" (native-ref (Ix 2 h) (Ix 3 h) [(ts "value")] 1)]
        ["type" (wire:jq (render:ty-text (_1 pair)))] ["render" (wire:jq (render:dt-val (_0 pair)))]] )])))
(define (request v state index)
  (define op (wire:jget-str "op" v))
  (cond
    ((Eq op "abort") [state index (wire:jobj [["ok" "false"] ["error" (wire:jq "Previous native attempt did not commit; retained for explicit retry")]])])
    ((Eq op "compile") (compile-request v state index))
    ((Eq op "eval") (eval-request v state index))
    ((Eq op "read")
      (let* ((p (path (wire:jget "path" v))) (c (wire:jget-nat "case" 0 v))
             (recursive (wire:jget-nat "recursive" 0 v))
             (rows (If c [[p (need-record p c state)]]
                     (If recursive ((ent ["shadow" "rows"]) p state)
                       (let ((hit (exact p state))) (If (Eq "/boot/maybe/some" (Hd hit)) [[p (_0 hit)]] []))))))
        [state index (wire:jobj [["ok" "true"] ["records" (wire:jarr (map (lambda (kv) (If c (record-json-at (_0 kv) (_1 kv) c state) (record-json (_0 kv) (_1 kv) state))) rows))]])]))
    ((Or (Eq op "make") (Or (Eq op "poke") (Eq op "cull")))
      (let* ((p (path (wire:jget "path" v)))
             (t (If (Eq op "cull") empty (If (wire:jget "record" v) (decode-record (wire:jget "record" v) state) (decode-slots (wire:jget "slots" v) state))))
             (ec (wire:jget "expected_case" v))
             (expected (If (Eq "/boot/json/num" (Hd ec)) ("/boot/maybe/some" (wire:jnat 0 ec)) "/boot/maybe/none"))
             (r (apply-write op p t expected state index))
             (held (retain-effects (showNat (wire:jget-nat "sequence" 0 v)) r)))
        [(Ix 0 held) (Ix 1 held) (write-reply r state (Ix 2 held))]))
    (else (Throw "unknown native operation"))))

(define (with-field reply key value)
  (define obj (wire:jval (parse-json reply)))
  (wire:jobj (snoc [key value] (map (lambda (kv) [(_0 kv) (show-json (_1 kv))]) (_0 obj)))))
(define (retain seq request next)
  (define p [(ts "_shadow") (ts "receipts") (ts (showNat seq))])
  (define fields (field [(ts "operation")] ("/boot/pails/t" (wire:jget-str "op" request))
    (field [(ts "inputs")] ((ent ["shadow" "pack"]) request)
      (field [(ts "reported_result")] ((ent ["shadow" "pack"]) (wire:jval (parse-json (Ix 2 next)))) empty))))
  (define receipt (apply-write "make" p fields ("/boot/maybe/some" 0) (Ix 0 next) (Ix 1 next)))
  (Ifz (Ix 2 receipt) (Throw "native receipt persistence failed")
    [(Ix 0 receipt) (Ix 1 receipt) (with-field (Ix 2 next) "receipt"
      (wire:jobj [["path" (wire:jq (path-text p))] ["case" (showNat (case-at p (Ix 0 receipt)))]]))]))

(define (read-line z)
  (define (go acc)
    (define raw (Input 1))
    (If (Le raw 1) 0
      (let ((c (Load8 0 raw)))
        (If (Eq c 10) (lstrcat (lrev acc)) (go (lcons c acc))))))
  (go 0))
(define (put-line s) (Write 1 (strWeld (strcat ["SHRINE_V5 " s 10]) 1)))
(define (resume state index seq last)
(define (loop state index sequence last)
  (define line (read-line 0))
  (Ifz line 0
    (let ((parsed (parse-json line)))
      (Ifz (wire:jok? parsed)
        (Seq (put-line (wire:jobj [["ok" "false"] ["error" (wire:jq "Invalid native JSON; state unchanged")]]))
          (loop state index sequence last))
        (let* ((v (wire:jval parsed))
               (seq (wire:jget-nat "sequence" sequence v))
               (r (Try (lambda (z)
                    (let* ((answer (request v state index))
                           (saved (If (Eq seq sequence) answer (retain seq v answer))))
                      (DeepSeq saved saved))) 0))
               (saved (If (Eq 1 (Hd r)) [state index (wire:jobj [["ok" "false"] ["error" (wire:jq (render:diag-text (_0 r)))]] )] (_0 r)))
               (reply (Ix 2 saved)))
          (Seq (If (Eq seq sequence) 0
                 (Save (Pin (lambda (args)
                   (Seq (Install opt:codegenLaw) (resume (Ix 0 saved) (Ix 1 saved) seq reply))))))
            (Seq (put-line reply) (loop (Ix 0 saved) (Ix 1 saved) seq reply))))))))
  (Seq (put-line (wire:jobj [["ready" "true"] ["protocol_version" "5"] ["sequence" (showNat seq)] ["last" last]]))
    (loop state index seq last)))
(define (serve z)
  (Seq (DeepSeq [compiled initial initial-index] 0)
    (Seq (Save opt:codegenLaw)
      (Seq (Save (Pin (lambda (args) (Seq (Install opt:codegenLaw) (resume initial initial-index 0 "null")))))
        (resume initial initial-index 0 "null")))))
(#export serve)
