;;;; Parse the real Grove v2 document through compiled Foil.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind foil (#module foil-new-env))

(define (check ignored)
  (define loaded (source:compile 0 "tests/grove"))
  (define sut (foil:perc-subject (_1 loaded)))
  (define summary
    (foil:source-entry-val ["grove_checks" "srs_summary"] sut))
  (define text (read-text-file "grove/srs.grove"))
  ;; Success, imports, declarations, tree names, implementations,
  ;; grade tags, or/opt properties, or comments, get code,
  ;; first definition, final expression.
  assert(Equal [1 2 13 4 3 2 2 1 1 1 1 1] (summary text))
  1)
assert(Equal 1 (check 0))
