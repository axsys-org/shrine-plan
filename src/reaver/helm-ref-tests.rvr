(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil (#module foil))
(#bind helm (#module helm))

;; Imported TC_GLOBAL edges are relocated under the imported unit's identity.
;; The /boot mirror must map that storage spelling back to the source entry.
(define compiled
  (foil:compile-mod-cached 0 foil:default-subject "helm_ref_caller"))
(define expected
  [(helm:boot-ent-node "helm_ref_caller" ["ref_caller"])
   (helm:boot-ent-node "helm_ref_target" ["ref_target"])])

assert(includes (Equal expected) (helm:boot-ref-table (_0 compiled)))

(print "helm reference tests passed")
