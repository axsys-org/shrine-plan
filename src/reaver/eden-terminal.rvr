;;;; Run a mounted terminal entrypoint on the main actor. The script reader
;;;; consumes a file; Input and Output belong to the mounted program.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind json (#module wire-json))
(#bind render (#module foil-render))
(define (run entry server arguments)
  (define result (Try (lambda (ignored) (force (entry server arguments))) 0))
  (If (Eq 1 (Hd result))
    (json:jobj [["ok" "false"] ["error" (json:jq (render:diag-text (_0 result)))]])
    (If (And (IsNat (_0 result)) (Le (_0 result) 255))
      (json:jobj [["ok" "true"] ["status" (showNat (_0 result))]])
      (json:jobj [["ok" "false"] ["error" (json:jq "Terminal entrypoint must return an exit status from 0 to 255")]]))))
(#export run)
