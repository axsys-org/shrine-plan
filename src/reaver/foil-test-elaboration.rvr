;;;; Explicit nominal assignments for tests of the private type substrate.
;;;; Keep scratch storage keys independent from these public definition moments.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind context (#module foil-context))
(#bind brand (#module shrine-brand))
(#bind subject (#module foil-subject))
(#bind elab (#module foil-new-elab))
(#bind nt (#module foil-new-types))
(#bind core (#module foil-type-core))
(define root [["x" 17] ["ts" "internal_elaboration"]])
(define (path local) (Weld root (map (lambda (name) ["ts" name]) local)))
(define (identity local) (brand:encode (path local) 1))
(define (prepare compiler declarations)
  (define names (foldl (lambda (out declaration)
    (If (Eq "s_decl" (_0 declaration))
      (If (includes (Equal (_1 declaration)) out) out
        (snoc (_1 declaration) out)) out)) [] declarations))
  (define selected (context:create
    (Pin "private-native-type-substrate") (Pin "elaboration-fixture/v1")
    (Pin declarations)
    [["fixture" root] ["$system/core" [["ts" "sys"] ["ts" "types"]]]]
    [["fixture" (map (lambda (name) [(path name) 1]) names)]
     ["$system/core" []]] []))
  (define base (elab:compiler-subject compiler))
  (define storage (subject:sut-root base))
  (define visible (foldl (lambda (out key)
    (define local (If (Equal storage (take (Sz storage) key))
      (drop (Sz storage) key) key))
    (subject:mark-visible (subject:root-path base local) key out))
    base (subject:subject-order-all base)))
  (define named (foldl (lambda (out local)
    (define key (subject:root-path base local))
    (subject:mark-visible key key out)) visible names))
  ;; These tests inspect the raw native algebra itself. Its empty storage
  ;; root retains those private keys; only test declarations mint brands.
  (define native (subject:set-sut-context (context:module selected "$system/core")
    (subject:set-sut-root [] base)))
  (define native (foldl (lambda (out pair)
    (subject:insert-tc ["maybe" (_0 pair)] subject:wack-span
      (subject:tc-typ (nt:scheme [(nt:type-param "v")]
        (nt:trow (_1 pair) (_2 pair)))) out)) native
    [["some" core:maybe-some-brand [(nt:trow-item 0 (nt:type-var "v"))]]
     ["none" core:maybe-none-brand []]]))
  (elab:compiler-for (subject:set-sut-context (context:module selected "fixture")
    (subject:set-sut-visible (subject:sut-visible named)
      (subject:head-onto-pins [(Pin native)] named)))))
(define (elab-mod compiler declarations)
  (elab:elab-mod (prepare compiler declarations) declarations))
(define (elab-mod-diags compiler declarations)
  (elab:elab-mod-diags (prepare compiler declarations) declarations))
(#export identity elab-mod elab-mod-diags)
