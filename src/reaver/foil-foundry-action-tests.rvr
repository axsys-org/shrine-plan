(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; Source-owned Action declarations and contextual admission.

(define sut (stage:sut-of "apps/chat/main"))
(define (app path) (foil:source-entry-val path sut))
(define (ts s) ("ts" s))
(define (path xs) (map ts xs))

(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))

(define myth-new (app ["myth" "new"]))
(define myth-sing (app ["myth" "sing"]))
(define myth-meld (app ["myth" "meld"]))
(define myth-has-at (app ["myth" "has_at"]))
(define declaration-of (app ["foundry_action" "declaration_of"]))
(define declaration-value (app ["foundry_action" "declaration_value"]))
(define declaration-code (app ["foundry_action" "declaration_code"]))
(define declaration-identity
  (app ["foundry_action" "declaration_identity"]))
(define declaration-subject
  (app ["foundry_action" "declaration_subject"]))
(define declaration-input (app ["foundry_action" "declaration_input"]))
(define declaration-requirements
  (app ["foundry_action" "declaration_requirements"]))
(define declaration-attenuation
  (app ["foundry_action" "declaration_attenuation"]))
(define declaration-result-policy
  (app ["foundry_action" "declaration_result_policy"]))
(define declaration-refusal-policy
  (app ["foundry_action" "declaration_refusal_policy"]))
(define declaration-receipt-policy
  (app ["foundry_action" "declaration_receipt_policy"]))
(define make-context (app ["foundry_action" "make_context"]))
(define admission-witness (app ["foundry_action" "admission_witness"]))
(define admit (app ["foundry_action" "admit"]))
(define admission-mount (app ["foundry_action" "admission_mount"]))
(define admission-code (app ["foundry_action" "admission_code"]))
(define mount-action (app ["foundry_delivery" "action_mount_action"]))
(define mount-pin (app ["foundry_delivery" "action_mount_pin"]))
(define mount-input (app ["foundry_delivery" "action_mount_input"]))
(define mount-witness (app ["foundry_delivery" "action_mount_admission"]))
(define digest-valid (app ["foundry_digest" "valid"]))
(define limb-slot (app ["limb_slot"]))

(define none "/boot/maybe/none")
(define (some-value x)
  assert(Equal "/boot/maybe/some" (Hd x))
  (_0 x))
(define (put rec slot pail)
  (myth-meld (myth-sing slot pail) rec))
(define (pp p) ("/boot/pails/p" p))
(define (pps ps) ("/boot/pails/ps" ps))
(define (pq q) ("/boot/pails/q" q))

(define action (path ["chat" "actions" "send"]))
(define subject (path ["chat" "log"]))
(define input (path ["chat" "contracts" "send_message"]))
(define capability (path ["chat" "capabilities" "send_message"]))
(define attenuation (path ["chat" "interaction" "send_message"]))
(define result-policy (path ["chat" "policies" "send_result"]))
(define refusal-policy (path ["chat" "policies" "send_refusal"]))
(define receipt-policy (path ["chat" "contracts" "action_receipt"]))

(define (action-record-with-horizons result requirements attenuations)
  (put
    (put
      (put
        (put
          (put
            (put
              (put
                (put
                  (put (myth-new)
                    (path ["semantic" "kind"]) (pq (ts "action")))
                  (path ["action" "identity"]) (pp action))
                (path ["action" "subject"]) (pp subject))
              (path ["action" "input"]) (pp input))
            (path ["action" "requirements"]) (pps requirements))
          (path ["action" "attenuation"]) (pps attenuations))
        (path ["action" "result"]) (pp result))
      (path ["action" "refusal"]) (pp refusal-policy))
    (path ["action" "receipt"]) (pp receipt-policy)))
(define (action-record result)
  (action-record-with-horizons result [capability] [attenuation]))

(define record (action-record result-policy))
(define parsed (declaration-of record))
assert(Equal none (declaration-code parsed))
(define declaration (some-value (declaration-value parsed)))
assert(Equal action (declaration-identity declaration))
assert(Equal subject (declaration-subject declaration))
assert(Equal input (declaration-input declaration))
assert(Equal [capability] (declaration-requirements declaration))
assert(Equal [attenuation] (declaration-attenuation declaration))
assert(Equal result-policy (declaration-result-policy declaration))
assert(Equal refusal-policy (declaration-refusal-policy declaration))
assert(Equal receipt-policy (declaration-receipt-policy declaration))

;;; Admission requires all three independent facts: target-declared Action
;;; horizon, actor capability intersection, and enclosing attenuation contract.
;;; The upstream resolver supplies its witness; this module validates it and
;;; derives a declaration/context-bound mount witness rather than copying it.
(define witness
  [9 9 9 9 9 9 9 9 9 9 9 9 9 9 9 9
   9 9 9 9 9 9 9 9 9 9 9 9 9 9 9 9])
(define actor (path ["actors" "alice"]))
(define context
  (make-context actor subject [action] [capability] [attenuation] witness))
(define admitted (admit action record context))
assert(Equal none (admission-code admitted))
(define mount (some-value (admission-mount admitted)))
assert(Equal action (mount-action mount))
assert(Equal input (mount-input mount))
assert(Eq 1 (digest-valid (mount-witness mount)))
assert(Nil (Equal witness (mount-witness mount)))
assert(Equal (admission-witness (mount-pin mount) context)
  (mount-witness mount))
assert(Eq 1 (digest-valid (mount-pin mount)))

;;; A capability name does not resurrect an Action omitted from the effective
;;; horizon, and an Action name cannot bypass capability or attenuation.
(define no-action
  (make-context actor subject [] [capability] [attenuation] witness))
assert(Equal (some-value (admission-code (admit action record no-action)))
  (ts "action_not_in_horizon"))
(define no-capability
  (make-context actor subject [action] [] [attenuation] witness))
assert(Equal (some-value (admission-code (admit action record no-capability)))
  (ts "action_capability_refused"))
(define no-attenuation
  (make-context actor subject [action] [capability] [] witness))
assert(Equal (some-value (admission-code (admit action record no-attenuation)))
  (ts "action_attenuation_refused"))

;;; The declaration's presence is never itself admission.  A context must carry
;;; a real 32-byte upstream witness, and every declaration/context horizon row
;;; must contain unique, nonempty semantic references.
(define bad-witness
  (make-context actor subject [action] [capability] [attenuation] [1 2 3]))
assert(Equal (some-value (admission-code (admit action record bad-witness)))
  (ts "action_witness_invalid"))
(define duplicate-horizon
  (make-context actor subject [action action] [capability] [attenuation]
    witness))
assert(Equal
  (some-value (admission-code (admit action record duplicate-horizon)))
  (ts "action_horizon_invalid"))
(define empty-capability-member
  (make-context actor subject [action] [capability []] [attenuation] witness))
assert(Equal
  (some-value (admission-code (admit action record empty-capability-member)))
  (ts "action_capability_horizon_invalid"))
(define duplicate-capability-horizon
  (make-context actor subject [action] [capability capability]
    [attenuation] witness))
assert(Equal
  (some-value
    (admission-code (admit action record duplicate-capability-horizon)))
  (ts "action_capability_horizon_invalid"))
(define empty-action-member
  (make-context actor subject [action []] [capability] [attenuation] witness))
assert(Equal
  (some-value (admission-code (admit action record empty-action-member)))
  (ts "action_horizon_invalid"))
(define duplicate-attenuation-horizon
  (make-context actor subject [action] [capability]
    [attenuation attenuation] witness))
assert(Equal
  (some-value
    (admission-code (admit action record duplicate-attenuation-horizon)))
  (ts "action_attenuation_horizon_invalid"))
(define empty-context-attenuation-member
  (make-context actor subject [action] [capability] [attenuation []] witness))
assert(Equal
  (some-value
    (admission-code (admit action record empty-context-attenuation-member)))
  (ts "action_attenuation_horizon_invalid"))
(define duplicate-requirements
  (action-record-with-horizons result-policy
    [capability capability] [attenuation]))
assert(Equal
  (some-value (declaration-code (declaration-of duplicate-requirements)))
  (ts "action_requirements_invalid"))
(define empty-requirement-member
  (action-record-with-horizons result-policy [capability []] [attenuation]))
assert(Equal
  (some-value (declaration-code (declaration-of empty-requirement-member)))
  (ts "action_requirements_invalid"))
(define duplicate-declaration-attenuation
  (action-record-with-horizons result-policy [capability]
    [attenuation attenuation]))
assert(Equal
  (some-value
    (declaration-code (declaration-of duplicate-declaration-attenuation)))
  (ts "action_attenuation_invalid"))
(define empty-attenuation-member
  (action-record-with-horizons result-policy [capability] [attenuation []]))
assert(Equal
  (some-value (declaration-code (declaration-of empty-attenuation-member)))
  (ts "action_attenuation_invalid"))

;;; The content pin covers policy content, not the namespace route alone.
(define other-record
  (action-record (path ["chat" "policies" "send_result_v2"])))
(define other-mount
  (some-value (admission-mount (admit action other-record context))))
assert(Nil (Equal (mount-pin mount) (mount-pin other-mount)))

;;; A declaration never treats its subject as its input contract.
assert(Nil (Equal subject (mount-input mount)))

;;; The Chat manifest authors the declaration and every referenced contract as
;;; separate ordinary namespace records.  Manifest presence is only syntax;
;;; it is not an admission context or an effective capability grant.
(define chat-seeds (Ix 3 (app ["app"])))
(define (manifest-seeds? relative)
  (includes (lambda (entry) (Equal relative (_0 entry))) chat-seeds))
assert(Eq 1 (manifest-seeds? (path ["actions" "send"])))
assert(Eq 1 (manifest-seeds? (path ["contracts" "send_message"])))
assert(Eq 1 (manifest-seeds? (path ["contracts" "action_receipt"])))
assert(Eq 1 (manifest-seeds? (path ["capabilities" "send_message"])))
assert(Eq 1 (manifest-seeds? (path ["interaction" "send_message"])))
assert(Eq 1 (manifest-seeds? (path ["policies" "send_result"])))
assert(Eq 1 (manifest-seeds? (path ["policies" "send_refusal"])))

;;; The source declaration owns only semantic references.  In particular it
;;; cannot smuggle executable behavior, a terminal route, an actor, an
;;; authority witness, or an effective capability grant into source data.
(define source-declaration (app ["send_action_seed"]))
assert(Eq 1 (myth-has-at (path ["semantic" "kind"]) source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "identity"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "subject"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "input"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "requirements"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "attenuation"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "result"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "refusal"])
  source-declaration))
assert(Eq 1 (myth-has-at (path ["action" "receipt"])
  source-declaration))
assert(Eq 0 (myth-has-at limb-slot source-declaration))
assert(Eq 0 (myth-has-at (path ["form"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["kook"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["callback"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "callback"])
  source-declaration))
assert(Eq 0 (myth-has-at (path ["url"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "url"])
  source-declaration))
assert(Eq 0 (myth-has-at (path ["renderer"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["route"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "route"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["actor"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "actor"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["witness"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "witness"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["capabilities"]) source-declaration))
assert(Eq 0 (myth-has-at (path ["action" "capabilities"])
  source-declaration))

;;; These are bounded source checks, deliberately not a fabricated live HTTP
;;; admission.  http/req hydrates the Action and occurrence through distinct
;;; read-only Sights, and the authored Composer exposes only Action identity.
(define web-source (read-text-file "foil/web.foil"))
assert(Eq 1 (contains? "['face_action]" web-source))
assert(Eq 1 (contains? "(dep .x ['chat 'actions 'send])" web-source))
assert(Eq 1 (contains? "['face_source1]" web-source))
assert(Eq 1 (contains? "(dep .x source1.snoc('source))" web-source))

(define composer-source
  (read-text-file "foil/foundry/chat/11-surface-chat-plate.sd"))
assert(Eq 1
  (contains? "/surface/action ;/chat/actions/send" composer-source))
assert(Eq 0
  (contains? "/surface/source ;/chat/log" composer-source))

(print "foundry action tests passed")
