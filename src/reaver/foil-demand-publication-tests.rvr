(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind source (#module foil-source))
(#bind pub (#module foil-publication))
(#bind driver (#module foil-new-env))
(#bind context (#module foil-context))
(#bind subject (#module foil-subject))
(#bind bootstrap (#module foil-bootstrap))

;; A policy can be republished while stored constructors retain the exact view
;; contract. The native interpreter never knows this module's name.
(define (read generation name)
  (If (Equal name "demand_publication_policy")
    (rex:ParseRexNormFile (strcat ["- sys/demand
+ constructor
  ^ woven
  | woven
    \ record=myth cr=care relative=path selection=view_select
    ^ view_plan
    | view_plan/done (axal/new[myth] (./some (myth/sing ['value] (pails/n " (showNat generation) "))))
"]))
    (If (Equal name "demand_publication_consumer")
      (rex:ParseRexNormFile "- lain_peek
- sys/demand
- demand_publication_policy
+ current constructor
+ legacy
  ^ pail
  | cell (\ context=myth input=axal[myth] [context input])
+ accepts_legacy
  \ candidate=pail
  ^ nat
  ?> retained=cell candidate 0
  | 1
+ run
  \ candidate=pail
  ^ nat
  ?> held=woven candidate 0
  = plan (held.get myth/new .x [] .all)
    evaluated (woven_run plan (store_reader sov/new))
  ?> (./known tree) evaluated.value 0
  ?> (./some record) tree.fil 0
  | record.nat_at ['value] 0
")
      (source:read-module name))))
(define (check ignored)
  ;; Build the system inside this invocation, not while importing the suite.
  (define compiler (Pin "sovereign-fixture-compiler/v3"))
  (define system-plan (pub:prepare-system compiler source:read-module bootstrap:system-roots))
  (define system-code (pub:compile system-plan driver:empty-foil-cache))
  (define system (context:publication-key (pub:compilation-context system-plan)))
  (define (root name) [["x" 17] ["ts" "fixtures"] ["ts" name]])
  (define (system-root name)
    (define found (find (lambda (pair) (Equal name (_0 pair))) bootstrap:system-roots))
    (If found (_1 (_0 found)) (root name)))
  (define names ["demand_publication_policy" "demand_publication_consumer"])
  (define first-plan (source:prepare-publication-with (read 1) system compiler system-root
    (_2 system-code) (lambda (path) 0) (Weld names (map _0 (_2 system-code)))))
  (define first (pub:compile first-plan driver:empty-foil-cache))
  (define images (_2 first))
  (define (image name artifacts)
    (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair))) artifacts)))))
  (define old (image "demand_publication_consumer" images))
  (define captured (driver:get-perc ["current"] old))
  (define legacy (driver:get-perc ["legacy"] old))
  (define initial-context (pub:compilation-context first-plan))
  (define core-images (foldl (lambda (out binding)
    (define artifact (context:artifact initial-context (_0 binding)))
    (If artifact (snoc [(_0 binding) (_0 artifact)] out) out))
    [] bootstrap:system-roots))
  (define dependencies (filter (lambda (pair)
    (Nil (includes (Equal (_0 pair)) names))) images))
  (define selected (source:pinned-imports ["sys/demand"] (Weld images core-images)))
  (define imports (Weld selected
    (Weld (filter (lambda (pair) (Nil (Equal "sys/demand" (_0 pair)))) core-images) dependencies)))
  (define (resolve name)
    (define prior (find (lambda (pair) (Equal name (_0 pair))) imports))
    (If prior (_0 (subject:sut-context
        (driver:perc-subject (Unpin (_1 (_0 prior)))))) (root name)))
  (define second-plan (source:prepare-publication-with
    (lambda (name)
      (If (Equal name "sys/demand") (error "pinned-demand-source-must-not-be-read") (read 2 name)))
    system compiler resolve imports (lambda (path) 1) names))
  (define second (pub:compile second-plan driver:empty-foil-cache))
  (define current (image "demand_publication_consumer" (_2 second)))
  (define run (driver:get-perc ["run"] current))
  (assert-impl "new demand policy does not replace existing cell contract"
    (Eq 1 ((driver:get-perc ["accepts_legacy"] current) legacy)))
  (assert-impl "new native interpreter accepts captured constructor through exact pinned contract"
    (Eq 1 (run captured)))
  (assert-impl "explicitly selected new constructor follows policy publication"
    (Eq 2 (run (driver:get-perc ["current"] current))))
  (assert-impl "old consumer and policy remain captured"
    (Eq 1 ((driver:get-perc ["run"] old) captured)))
  1)
(#export check)
