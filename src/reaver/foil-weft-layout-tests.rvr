;;;; The generic builder retains Weft's PLAN node identity.
(#bind std (#module std))
(#import std)
(#bind foil (#module foil))
(Seq (define sut (foil:compile-mod foil:default-subject "weft_builder_tests"))
  (DeepSeq sut 0))
(define card (foil:source-entry-val ["weft_builder_card"] sut))
assert(Eq "/boot/weft/node/el" (Hd (Ix 0 (card 0 []))))
assert(Eq [] (foil:source-entry-val ["weft_builder_empty"] sut))
