(#bind brand (#module shrine-brand))
(#bind fixture (#module foil-test-context))
(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind foil (#module foil-new-env))

(define (check z)
  ;;;; The generic builder retains Weft's PLAN node identity.
  (define sut (foil:perc-subject (_1 (source:compile (fixture:files 0 ["weft_builder_tests"]) 0 "weft_builder_tests"))))
    (DeepSeq sut 0)
  (define card (foil:source-entry-val ["weft_builder_card"] sut))
  assert(Eq (brand:encode (Weld (fixture:root "weft") [["ts" "weft"] ["ts" "node"] ["ts" "el"]]) 1) (Hd (Ix 0 (card 0 []))))
  assert(Eq [] (foil:source-entry-val ["weft_builder_empty"] sut))

  1)
assert(Equal 1 (check 0))
