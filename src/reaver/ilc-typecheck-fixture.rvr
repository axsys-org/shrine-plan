(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind elab (#module foil-new-elab))
(#bind builtins (#module foil-builtins))
(#bind fixture (#module foil-test-elaboration))
(#bind surface (#module foil-surface))
(#bind rex (#module rex))
(#bind sast (#module foil-sast))
(#bind ilc (#module ilc))
(#bind structural (#module ilc-structural))

(define (compiler ignored)
  (fixture:elab-mod (elab:compiler-for builtins:default-subject) []))
(define (expression text)
  (_3 (_0 (sast:parse-module-sast 0 (rex:ParseRexNormFile (strWeld "+ test " text))))))
(define (tree depth seed)
  (Ifz depth (surface:surf-lit seed)
    (surface:surf-app (surface:surf-ref ["add"])
      [(tree (Dec depth) seed) (tree (Dec depth) (Add seed (Bex (Dec depth))))])))
(define (left-path depth)
  (Ifz depth [1] (Weld [2 0] (left-path (Dec depth)))))
(define (edit depth value)
  (structural:at-path (cons 1 (left-path depth)) (ilc:replace-change value)))
(#export compiler expression tree left-path edit)
