;;;; Extend the shared lain fixture with the helm application fixture.
(#bind std (#module std))
(#import std)
(#bind foil (#module foil))
(#bind lain (#module foil-test-lain))
(Seq (define compiled
       (foil:compile-mod-cached (_0 lain:compiled)
         foil:default-subject "helmapp"))
  (DeepSeq compiled 0))
(define module-file-stamps (foil:foil-closure-files ["helmapp"]))
(#export compiled module-file-stamps)
