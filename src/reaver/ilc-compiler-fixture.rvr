(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind context (#module foil-context))
(#bind core (#module foil-type-core))
(#bind inc (#module ilc-compiler))
(#bind bst (#module bst))
(#bind driver (#module foil-new-env))

;; Explicit publication assignments for this experiment; publication/moment
;; selection is deliberately outside the incremental compiler's authority.
(define native-selection
  (Pin (map (lambda (name)
    [(Weld [("ts" "sys") ("ts" "types")]
       (map (lambda (part) ("ts" part)) name)) 1]) core:system-names)))
(define (root name) [["x" 31] ["ts" "ilc-compiler"] ["ts" name]])
(define (config names roots)
  (inc:config (context:create native-selection (Pin "ilc-compiler-experiment/v1") (Pin 0)
    (map (lambda (name) [name (root name)]) names)
    (map (lambda (name) [name []]) names) []) roots 1024))
(define (values artifacts names)
  (map (lambda (name) (driver:get-perc ["value"]
    (Unpin (bst:bst-idx name artifacts)))) names))
(#export native-selection root config values)
