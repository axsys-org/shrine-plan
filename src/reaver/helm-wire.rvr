;;;; Compatibility codecs for native actor transport.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)

(define (send! h m) (DeepSeq m (Send h m)))

(define (driver-message msg)
  (define kind (_0 msg))
  (cond
    ((Eq kind "go") ("/boot/driver_in/go" (_1 msg)))
    ((Eq kind "change") ("/boot/driver_in/change" (_1 msg) (_2 msg)))
    ((Eq kind "view") ("/boot/driver_in/view" (_1 msg) (_2 msg)))
    ((Eq kind "qres") ("/boot/driver_in/qres" (_1 msg) (_2 msg)))
    ((Eq kind "ack") ("/boot/driver_in/ack" (_1 msg)))
    ((Eq kind "die") "/boot/driver_in/die")
    ((includes (Eq (Hd msg))
       ["/boot/driver_in/go" "/boot/driver_in/change" "/boot/driver_in/view"
        "/boot/driver_in/qres" "/boot/driver_in/ack"]) msg)
    ((Eq msg "/boot/driver_in/die") msg)
    (else 0)))

;; Host exceptions are arbitrary values, whereas rsvp/no promises an iota.
;; Keep the detailed exception in the coordinator trace, not in that field.
(define driver-crash-rsvp ("/boot/rsvp/no" ("ts" "task_crashed")))

;; Typed driver requests enter the same coordinator transition path.
(define (driver-command msg)
  (cond
    ((Eq (Hd msg) "/boot/driver_out/cmd") ["cmd" (_0 msg) (_1 msg)])
    ((Eq (Hd msg) "/boot/driver_out/read") ["read" (_0 msg)])
    (else msg)))

