;;;; PLAN tags and field order; behavior lives in tests/semidoc.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(Seq (define sut (foil:compile-mod foil:default-subject "semidoc"))
  (DeepSeq sut 0))
(define (entry path) (foil:source-entry-val path sut))
(define parse (entry ["parse"]))
(define tree (parse ";. doc
;= title
;- item
;> quote
;$ text
  body
;/ref
prose"))
assert(Equal
  [("/boot/snode/doc" ["doc"] [] [])
   ("/boot/snode/sect" "title" [] [])
   ("/boot/snode/item" "item" [] [])
   ("/boot/snode/quote" "quote" [] [])
   ("/boot/snode/lit" "text" [] "body")
   ("/boot/snode/ref" ["ref"] [])
   ("/boot/snode/prose" "prose" [])] tree)
(define node (_0 (parse ";@ /tag token ;/ref
anchor")))
(define attr (_0 (Ix 1 node)))
assert(Equal ("/boot/sattr" ["tag"]
  [("/boot/sval/word" "token") ("/boot/sval/ref" ["ref"])]) attr)
(define vals (Ix 1 attr))
assert(Equal ("/boot/pails/t" "token") ((entry ["val_pail"]) (_0 vals)))
assert(Equal ("/boot/pails/p" [("ts" "ref")])
  ((entry ["val_pail"]) (_1 vals)))
assert(Eq "/boot/smount" (Hd (_0 ((entry ["myths"]) [] tree))))
(define flag ((entry ["node_myth"]) (_0 (parse ";@ /doc/flag
anchor"))))
assert(Equal ("/boot/pails/t" 0)
  ((entry ["myth" "pail_at"]) [("ts" "doc") ("ts" "flag")] flag))
