(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))

(define (check z)
  ;;;; PLAN tags and field order; behavior lives in tests/semidoc.
  (define sut (foil:perc-subject (_1 (source:compile 0 "semidoc"))))
    (DeepSeq sut 0)
  (define (entry path) (foil:source-entry-val path sut))
  (define parse (entry ["parse"]))
  (define tree (parse ";. doc
;= title
;- item
;> quote
;$ text
  body
;/ref
prose"))
  assert(Equal
    [("/boot/semidoc/snode/doc" ["doc"] [] [])
     ("/boot/semidoc/snode/sect" "title" [] [])
     ("/boot/semidoc/snode/item" "item" [] [])
     ("/boot/semidoc/snode/quote" "quote" [] [])
     ("/boot/semidoc/snode/lit" "text" [] "body")
     ("/boot/semidoc/snode/ref" ["ref"] [])
     ("/boot/semidoc/snode/prose" "prose" [])] tree)
  (define node (_0 (parse ";@ /tag token ;/ref
anchor")))
  (define attr (_0 (Ix 1 node)))
  assert(Equal ("/boot/semidoc/sattr" ["tag"]
    [("/boot/semidoc/sval/word" "token") ("/boot/semidoc/sval/ref" ["ref"])]) attr)
  (define vals (Ix 1 attr))
  assert(Equal ("/boot/lain_types/pails/t" "token") ((entry ["val_pail"]) (_0 vals)))
  assert(Equal ("/boot/lain_types/pails/p" [("ts" "ref")])
    ((entry ["val_pail"]) (_1 vals)))
  assert(Eq "/boot/semidoc/smount" (Hd (_0 ((entry ["myths"]) [] tree))))
  (define flag ((entry ["node_myth"]) (_0 (parse ";@ /doc/flag
anchor"))))
  assert(Equal ("/boot/lain_types/pails/t" 0)
    ((entry ["myth" "pail_at"]) [("ts" "doc") ("ts" "flag")] flag))

  1)
assert(Equal 1 (check 0))
