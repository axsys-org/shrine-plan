(#bind brand (#module shrine-brand))
(#bind fixture (#module foil-test-context))
(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))

(define (check z)
  ;;;; PLAN tags and field order; behavior lives in tests/semidoc.
  (define sut (foil:perc-subject (_1 (source:compile (fixture:files 0 ["semidoc"]) 0 "semidoc"))))
    (DeepSeq sut 0)
  (define (entry path) (foil:source-entry-val path sut))
  (define parse (entry ["parse"]))
  (define tree (parse ";. doc
;= title
;- item
;> quote
;$ text
  body
;/ref
prose"))
  assert(Equal
    [((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "doc"]]) 1) ["doc"] [] [])
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "sect"]]) 1) "title" [] [])
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "item"]]) 1) "item" [] [])
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "quote"]]) 1) "quote" [] [])
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "lit"]]) 1) "text" [] "body")
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "ref"]]) 1) ["ref"] [])
     ((brand:encode (Weld (fixture:root "semidoc") [["ts" "snode"] ["ts" "prose"]]) 1) "prose" [])] tree)
  (define node (_0 (parse ";@ /tag token ;/ref
anchor")))
  (define attr (_0 (Ix 1 node)))
  assert(Equal ((brand:encode (Weld (fixture:root "semidoc") [["ts" "sattr"]]) 1) ["tag"]
    [((brand:encode (Weld (fixture:root "semidoc") [["ts" "sval"] ["ts" "word"]]) 1) "token") ((brand:encode (Weld (fixture:root "semidoc") [["ts" "sval"] ["ts" "ref"]]) 1) ["ref"])]) attr)
  (define vals (Ix 1 attr))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "pails"] ["ts" "t"]] 1) "token") ((entry ["val_pail"]) (_0 vals)))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "pails"] ["ts" "p"]] 1) [("ts" "ref")])
    ((entry ["val_pail"]) (_1 vals)))
  assert(Eq (brand:encode (Weld (fixture:root "semidoc") [["ts" "smount"]]) 1) (Hd (_0 ((entry ["myths"]) [] tree))))
  (define flag ((entry ["node_myth"]) (_0 (parse ";@ /doc/flag
anchor"))))
  assert(Equal ((brand:encode [["ts" "sys"] ["ts" "types"] ["ts" "pails"] ["ts" "t"]] 1) 0)
    ((entry ["myth" "pail_at"]) [("ts" "doc") ("ts" "flag")] flag))

  1)
assert(Equal 1 (check 0))
