(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))

(#bind foil-sast (#module foil-sast))
(#import foil-sast)


;;; Type surface parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (parse-type src)
  (parse-type-sast (rex:ParseRexNorm src)))

assert(Equal (surf-ref ["foo" "bar" "baz"])
  (parse-type "foo:bar:baz"))

assert(Equal (surf-ref ["baz"])
  (parse-type "baz"))

assert(Equal (surf-face "foo" (surf-ref ["bar"]))
  (parse-type "foo=bar"))

assert(Equal (surf-face "n" (surf-ref ["bst" "node"]))
  (parse-type "n=bst:node"))

assert(Equal
  (surf-tapp [(surf-ref ["foo"]) (surf-ref ["bar"])])
  (parse-type "(foo bar)"))

assert(Equal
  (surf-trow [(surf-ref ["foo"]) (surf-ref ["bar"])])
  (parse-type "[foo bar]"))

assert(Equal (surf-variant "some")
  (parse-type "$some"))

assert(Equal (surf-variant "some_value")
  (parse-type "$some_value"))

assert(Equal
  (surf-tapp [(surf-variant "some") (surf-ref ["nat"])])
  (parse-type "($some nat)"))

assert(Equal
  (surf-tfun [(surf-ref ["nat"])] (surf-ref ["nat"]))
  (parse-type "{nat; nat}"))

assert(Equal
  (surf-tfun [(surf-ref ["nat"]) (surf-ref ["nat"])] (surf-ref ["nat"]))
  (parse-type "{nat; nat; nat}"))

assert(Equal
  (surf-trow [(surf-face "x" (surf-ref ["nat"]))
              (surf-face "y" (surf-ref ["nat"]))])
  (parse-type "{x=nat y=nat}"))

assert(Equal
  (surf-tapp [(surf-ref ["maybe"]) (surf-ref ["nat"])])
  (parse-type "maybe[nat]"))


;;; Value surface parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (parse-val src)
  (parse-val-sast (rex:ParseRexNorm src)))

assert(Equal (surf-lit 42)
  (parse-val "42"))

assert(Equal (surf-var "foo")
  (parse-val "foo"))

assert(Equal (surf-ref ["foo" "bar"])
  (parse-val "foo:bar"))

assert(Equal (surf-meth ["foo" (surf-mseg "bar" [])])
  (parse-val "foo.bar"))

assert(Equal (surf-meth ["foo" (surf-mseg "bar" [(surf-lit 1)])])
  (parse-val "foo.bar(1)"))

assert(Equal
  (surf-meth ["foo"
    (surf-mseg "bar"
      [(surf-app (surf-var "add") [(surf-lit 3)])])])
  (parse-val "foo.bar((add 3))"))

assert(Equal
  (surf-app (surf-var "foo") [(surf-lit 1) (surf-var "bar")])
  (parse-val "(foo 1 bar)"))

assert(Equal
  (surf-app (surf-ref ["foo" "bar"]) [])
  (parse-val "(foo:bar)"))

assert(Equal
  (surf-app (surf-ref ["bst" "empty"]) [])
  (parse-val "(bst:empty)"))

assert(Equal
  (surf-app (surf-ref ["bst" "node"])
    [(surf-lit 1) (surf-lit 2) (surf-lit 3)])
  (parse-val "(bst:node 1 2 3)"))

assert(Equal
  (surf-row [(surf-lit 1) (surf-var "foo")])
  (parse-val "[1 foo]"))

assert(Equal (surf-variant "none")
  (parse-val "$none"))

assert(Equal (surf-variant "none_value")
  (parse-val "$none_value"))

assert(Equal
  (surf-app (surf-variant "some") [(surf-lit 3)])
  (parse-val "($some 3)"))

assert(Equal
  (surf-literal "cord" "hello")
  (parse-val (strcat [34 "hello" 34])))

(define test-span [1 1 0 1])
(define test-word-a ["leaf" test-span "word" "a"])
(define test-word-x ["leaf" test-span "word" "x"])
(define test-word-nat ["leaf" test-span "word" "nat"])
(define test-lit-1 ["leaf" test-span "word" "1"])

assert(Equal
  (surf-tvars ["a"] (surf-lit 1))
  (parse-val-sast
    ["juxt" test-span
      [["nest" test-span "paren" "$" [test-word-a]]
       test-lit-1]]))

assert(Equal
  (surf-letrec [(surf-arm (surf-ref ["nat"]) (surf-lit 1))] (surf-var "x"))
  (parse-val-sast
    ["juxt" test-span
      [["nest" test-span "paren" "="
         [["nest" test-span "clear" ">" [test-word-nat test-lit-1]]]]
       test-word-x]]))

assert(Equal
  (surf-ufcs-put test-word-x
    ["juxt" test-span [test-word-a ["nest" test-span "paren" "" [test-lit-1]]]])
  (parse-val-sast
    ["nest" test-span "clear" ".#"
      [test-word-x
       ["juxt" test-span [test-word-a ["nest" test-span "paren" "" [test-lit-1]]]]]]))

assert(Equal
  (surf-ufcs-over test-word-x
    ["juxt" test-span [test-word-a ["nest" test-span "paren" "" [test-lit-1]]]])
  (parse-val-sast
    ["nest" test-span "clear" ".%"
      [test-word-x
       ["juxt" test-span [test-word-a ["nest" test-span "paren" "" [test-lit-1]]]]]]))


;;; Module surface parsing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define parsed-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  foo
  3
+  bar
  foo
")))

assert(Equal 2 (Sz parsed-module))
assert(Equal ["foo"] (_1 (_0 parsed-module)))
assert(Equal ["bar"] (_1 (_1 parsed-module)))
assert(Equal "s_span" (_0 (_3 (_0 parsed-module))))
assert(Equal (surf-lit 3) (_2 (_3 (_0 parsed-module))))
assert(Equal (surf-var "foo") (_2 (_3 (_1 parsed-module))))

(define parsed-apex-after-child
  (parse-module-sast 0 (rex:ParseRexNorm "
+  outer
  +  child
    1
  2
")))

assert(Equal 2 (Sz parsed-apex-after-child))
assert(Equal ["outer"] (_1 (_0 parsed-apex-after-child)))
assert(Equal ["outer" "child"] (_1 (_1 parsed-apex-after-child)))
assert(Equal (surf-lit 2) (_2 (_3 (_0 parsed-apex-after-child))))
assert(Equal (surf-lit 1) (_2 (_3 (_1 parsed-apex-after-child))))

(print "foil-sast tests passed")
