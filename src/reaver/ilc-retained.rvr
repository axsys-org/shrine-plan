;; Experimental cache-transfer transform for pure PLAN. Nodes are lazy pairs
;; [value trace]. Never DeepSeq a state/trace: it contains suspended branches.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind pe (#module pe))
(#bind ilc (#module ilc))

(define (invoke f args) (foldl (lambda (f x) (f x)) f args))
(define (changed args ds)
  (gen (Sz args) (lambda (i) (ilc:apply-change (Ix i args) (Ix i ds)))))
(define (find-rule rules f)
  (find (lambda (entry) (Equal f (_0 entry))) rules))
(define (opaque-init f args) [(invoke f args) 0])
(define (rule-step derivative args ds old)
  (define dy (invoke (invoke derivative args) ds))
  [dy [(ilc:apply-change (_0 old) dy) 0]])
(define (pap-init init captured args) (init (Weld captured args)))
(define (pap-step step captured args ds old)
  (step (Weld captured args) (Weld (map (lambda (x) 0) captured) ds) old))

;; Call-site metadata is independent of the callee's result. Reading children
;; of an old, unselected call must not evaluate its old body.
(define (call-init init children)
  (define inner (init (map _0 children)))
  [(_0 inner) ("ILC_CALL" children inner)])
(define (call-step step old updates)
  (define trace (_1 old))
  (define result (step (map _0 (_0 trace)) (map _0 updates) (_1 trace)))
  [(_0 result) [(_0 (_1 result)) ("ILC_CALL" (map _1 updates) (_1 result))]])
(define (data-init f x) [((_0 f) (_0 x)) ("ILC_APP_CACHE" f x 0)])
(define (data-step old fu xu)
  (define dy (ilc:app-change (_0 fu) (_0 xu)))
  [dy [(ilc:apply-change (_0 old) dy) ("ILC_APP_CACHE" (_1 fu) (_1 xu) 0)]])

;; Compilation helpers use a build callback to tie recursion without forward
;; module definitions. Generated recursive calls use their own self slot.
(define (emit f args) (foldl (lambda (f x) (0 f x)) f args))
(define (q x) (pe:law-quote x))
(define (get index expression) (emit (q Ix) [(q index) expression]))
(define (row xs) (emit (q 0) xs))
(define (split body)
  (If (And (Equal 1 (Hd body)) (Eq 2 (Sz body)))
    (let ((rest (split (_1 body)))) [(cons (_0 body) (_0 rest)) (_1 rest)])
    [[] body]))
(define (call? depth body) (pe:law-call? depth body))
(define (literal body) (If (Equal 0 (Hd body)) (pe:pull-const body) body))
(define (spine depth body)
  (If (call? depth body)
    (let ((s (spine depth (_0 body)))) [(_0 s) (Weld (_1 s) [(_1 body)])])
    [body []]))
(define (known owner depth head)
  (If (pe:law-var? depth head) (Ifz head [owner] 0) [(literal head)]))

;; mode=0 initializes an expression node; mode=1 updates it. Source lets are
;; node slots in init, [delta,new-node] slots in step. All are mutually in scope.
(define (expression build app-init app-step rules owner arity depth mode old body)
  (define (recur old body)
    (expression build app-init app-step rules owner arity depth mode old body))
  (define (constant value)
    (If mode (row [(q 0) (row [(q value) (q 0)])]) (row [(q value) (q 0)])))
  (cond
    ((pe:law-var? depth body)
      (cond
        ((Nil body) (constant owner))
        ((Le body arity)
          (define value (get (Dec body) 1))
          (define delta (get (Dec body) 2))
          (If mode (row [delta (row [(emit (q ilc:apply-change) [value delta]) (q 0)])])
            (row [value (q 0)])))
        (else (Add (If mode 3 1) (Sub body arity)))))
    ((call? depth body)
      (define s (spine depth body))
      (define fixed (known owner depth (_0 s)))
      (define args (_1 s))
      (define n (If fixed (pe:plan-arity (_0 fixed)) 0))
      (define trace (get 1 old))
      (cond
        ((And fixed (And n (Eq n (Sz args))))
          (define f (_0 fixed))
          ;; Self is safe only when it has no overriding rule.
          (define target (If (And (Equal f owner) (Nil (find-rule rules f))) 0
            (q (Ix mode (Memo (build rules) f)))))
          (define children (gen (Sz args) (lambda (i)
            (recur (get i (get 0 trace)) (Ix i args)))))
          (If mode (emit (q call-step) [target old (row children)])
            (emit (q call-init) [target (row children)])))
        (else
          (define fn (recur (get 0 trace) (_0 body)))
          (define arg (recur (get 1 trace) (_1 body)))
          (define data? (And fixed (Or (Nil n) (Lt (Sz args) n))))
          (If mode
            (If data? (emit (q data-step) [old fn arg])
              (emit (q app-step) [(q build) (q rules) old fn arg]))
            (If data? (emit (q data-init) [fn arg])
              (emit (q app-init) [(q build) (q rules) fn arg]))))))
    (else (constant (literal body)))))

(define (law-init build app-init app-step rules f)
  (define law (If (IsPin f) (Unpin f) f))
  (define arity (Arity law))
  (define parts (split (Body law)))
  (define binds (_0 parts))
  (define count (Sz binds))
  (define depth (Add arity count))
  (define (expr body) (expression build app-init app-step rules f arity depth 0 (q 0) body))
  (define result-slot (Add count 2))
  (Law 0 (strWeld "retain-" (Name law))
    (foldr (lambda (b rest) (1 (expr b) rest))
      (1 (expr (_1 parts))
        (row [(get 0 result-slot)
          (emit (q "ILC_LAW_CACHE") [(q f) (row (gen count (lambda (i) (Add i 2)))) result-slot])])) binds)))
(define (law-step build app-init app-step rules f)
  (define law (If (IsPin f) (Unpin f) f))
  (define arity (Arity law))
  (define parts (split (Body law)))
  (define binds (_0 parts))
  (define count (Sz binds))
  (define depth (Add arity count))
  (define trace (get 1 3))
  (define (expr old body) (expression build app-init app-step rules f arity depth 1 old body))
  (define result-slot (Add count 4))
  (define new-result (get 1 result-slot))
  (Law 2 (strWeld "transfer-" (Name law))
    (foldr (lambda (i rest)
      (1 (expr (get i (get 1 trace)) (Ix i binds)) rest))
      (1 (expr (get 2 trace) (_1 parts))
        (row [(get 0 result-slot)
          (row [(get 0 new-result)
            (emit (q "ILC_LAW_CACHE") [(q f)
              (row (gen count (lambda (i) (get 1 (Add i 4))))) new-result])])]))
      (gen count (lambda (i) i)))))

;; A changed callee/rule can make the old inner cache incompatible. Rebuild
;; only that call's cache; never mistake an opaque result for a law trace.
(define (law-compatible? f old)
  (And (Equal "ILC_LAW_CACHE" (Hd (_1 old))) (Equal f (_0 (_1 old)))))
(define (dispatch-step build rules f df args ds old)
  (define rule (find-rule rules f))
  (define law (If (IsPin f) (Unpin f) f))
  (cond
    ((And (Nil df) rule) (rule-step (_1 (_0 rule)) args ds old))
    ((And (IsApp f) (Or (Nil df) (Equal "ILC_APP" (Hd df))))
      (dispatch-step build rules (Init f) (Ifz df 0 (_0 df))
        (cons (Last f) args) (cons (Ifz df 0 (_1 df)) ds) old))
    ((And (Nil df) (IsLaw law))
      (define program (Memo (build rules) f))
      ((_1 program) args ds (If (law-compatible? f old) old ((_0 program) args))))
    (else
      (define fresh [(invoke (ilc:apply-change f df) (changed args ds)) 0])
      [(ilc:replace-change (_0 fresh)) fresh])))
(define (app-init build rules fn arg)
  (define f (_0 fn))
  (define x (_0 arg))
  (define inner (If (Eq 1 (pe:plan-arity f))
    ((_0 (Memo (build rules) f)) [x]) [(f x) 0]))
  [(_0 inner) ("ILC_APP_CACHE" fn arg inner)])
(define (app-step build rules old fu xu)
  (define trace (_1 old))
  (define f (_0 (_0 trace)))
  (define x (_0 (_1 trace)))
  (define result (If (Eq 1 (pe:plan-arity f))
    (dispatch-step build rules f (_0 fu) [x] [(_0 xu)]
      ;; Unsaturated-to-saturated transitions have no old inner cache.
      (If (_2 trace) (_2 trace) [(_0 old) 0]))
    (let ((dy (ilc:app-change (_0 fu) (_0 xu))))
      [dy [(ilc:apply-change (_0 old) dy) 0]])))
  [(_0 result) [(_0 (_1 result))
    ("ILC_APP_CACHE" (_1 fu) (_1 xu) (_1 result))]])

(define (compile rules f)
  (define rule (find-rule rules f))
  (define law (If (IsPin f) (Unpin f) f))
  (cond
    (rule [(opaque-init f) (rule-step (_1 (_0 rule)))])
    ((IsApp f)
      (define base (Memo (compile rules) (Init f)))
      (define captured [(Last f)])
      [(pap-init (_0 base) captured) (pap-step (_1 base) captured)])
    ((IsLaw law)
      [(law-init compile app-init app-step rules f) (law-step compile app-init app-step rules f)])
    (else [(opaque-init f) (rule-step (ilc:derive-staged-with rules f))])))

;; Public API is unary; multi-argument computations can take an input row.
;; States are immutable and relative edits must use the corresponding state.
(define (prepare rules f)
  (If (Eq 1 (pe:plan-arity f)) [f (Memo (compile rules) f)]
    (error "retained: expected a unary callable")))
(define (start program input) [program input ((_0 (_1 program)) [input])])
(define (value state) (_0 (_2 state)))
(define (advance state dx)
  (Ifz dx [0 state]
    (let ((program (_0 state)) (input (_1 state)))
      (define result ((_1 (_1 program)) [input] [dx] (_2 state)))
      [(_0 result) [program (ilc:apply-change input dx) (_1 result)]])))
(define (reset state) (start (_0 state) (_1 state)))
(#export prepare start value advance reset)
