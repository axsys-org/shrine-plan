;;;; Pinned /x seeds compile without the application-layer imports.

(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind grove (#module grove))

(define (check z)
  (define ir (grove:gv-read (strcat ["+  view" 10 "  :  tack '?/y;input" 10])))
  (define node (grove:gv-armor (Ix 1 ir)))
  (define child (Ix 2 (Ix 0 (Ix 1 node))))
  assert(Equal [["kook" "fresh"]] (map grove:gv-kook-texts (Ix 2 child)))
  (define value (Ix 1 (grove:gv-slotval-t (Ix 0 (Ix 3 child)))))
  (define sut (_1 (source:compile-rex 0 "grove-pin-fixture"
      (grove:ngrp (Weld grove:gv-prelude [(grove:gv-decl-t "pin" "safe" value)])))))
  (DeepSeq sut 0)
  assert(Equal ("/boot/shrine_types/safe" 1 "/boot/shrine_types/care/y" [("ts" "input")])
    (driver:get-perc ["pin"] sut))
  (print "grove pin tests passed")

  1)

assert(Equal 1 (check 0))
