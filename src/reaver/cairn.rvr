(define new-demo "
+  add
  |  a=nat  b=nat
  ^  nat
  %  (if (eq a 0) b)
  (add (dec a) (inc b))
  +  add_one
    |  a=nat
    ^  nat
    (inc a)
  +  add_two
    |  a=nat
    ^  nat
    (inc (inc a))
    ")

