(define (mk-doccord doc val)
  ["doccord" doc val])

(define (rune-to-ast rune children)
  [(strWeld "rune-" rune) (Sz children)])

(define (is-rune rune node)
  (And (Eq (_0 node) "open") (Eq (_2 node) rune)))


(define (id x) x)

(define (get-leaf-str node)
  assert(Eq "leaf" (_0 node))
  (_3 node))

;;  decl: ["name" val]
(define (make-decl hed rest cont)
  ["decl" (get-leaf-str (_0 hed)) (cont rest)])

(define (get-decl-name decl) (_1 decl))
(define (get-decl-rest decl) (_2 decl))

(define empty (Row 0 0))







(define (rex-to-ast r)
  ;; constructors
  (define (parse-type-word x)
    (cond ((Eq x "'@") "nat")
          ((Eq x "':") "row")
          ((Eq x "'#") "pin")
          ((Eq x "'$") "fun")
          (else ["ref" x])))

  (define (parse-type-tyte rune kids cont)
    (cond
      ((Eq rune "=")
        ["bind" (get-leaf-str (_0 kids)) (cont (_1 kids))])
      (else ["bad"])))

  (define (parse-type x)
    (cond
     ((Eq (_0 x) "leaf") (parse-type-word (get-leaf-str x)))
     ((Eq (_0 x) "tyte") (parse-type-tyte (_2 x) (_3 x) parse-type))
          (else ["bad" x])))


  ;; cast:  [type val]
  (define (make-cast hed rest cont)
    ["cast" (parse-type (_0 hed)) (cont rest)])

  (define (make-func hed rest cont)
    ["func" (map parse-type hed) (cont rest)])

  (define (make-call hed rest cont)
    ; (print ["make-call" hed rest])
    ["call" (rex-to-ast (_0 hed)) (cont rest)])
  (define (make-call-direct hed tel)
    ["call" (rex-to-ast hed) (rex-to-ast tel)])
  ;; parsers


  (define (parse-expr brak kids cont)
    (cond
      ((Eq "paren" brak)
          (If (Eq 2 (Sz kids))
              (make-call-direct (cont (_0 kids)) (cont (_1 kids)))
              (make-call-direct (cont (_0 kids)) (parse-expr brak (drop 1 kids)
              cont))))
      (else "weird brak")))
  ;;
  (define (merge-heir els)
    (If (Eq 0 (Sz els)) "ret"
      (let ((hed (_0 els)))
      (cond
        ((Eq "leaf" (_0 hed)) (merge-heir (drop 1 els)))
        ((is-rune "+" hed) (make-decl (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "|" hed) (make-func (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "^" hed) (make-cast (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "%" hed) (make-call (_3 hed) (drop 1 els) merge-heir))
        ((Eq "expr" (_0 hed)) (rex-to-ast hed))
         (else [(strWeld "untagged" (_0 hed)) els])))))
        ;; (begin (print ["expr" hed]) (make-call-direct (_3 hed))))

  ;; body
  (cond
    ((Eq "heir" (_0 r)) (merge-heir (_2 r)))
    ((Eq "slug" (_0 r)) "slug")
    ((Eq "expr" (_0 r)) (parse-expr (_2 r) (_3 r) rex-to-ast))
    ((Eq "leaf" (_0 r)) ["ref" (get-leaf-str r)])
    ((Eq "open" (_0 r)) (rune-to-ast (_2 r) (_3 r)))
    (else r)))

; (define (make-context))


(define y 1)
(define n 0)

(define (reap str count)
  (If (Eq count 0) ""
      (strWeld (reap str (Dec count)) str)))

(define (spaces count) (reap " " count))


;; Maybe
(define (SOME x) ["some" x])
(define NONE 0)

(define TYPE "type")


(define (TNAT cube) [TYPE "TNAT" cube])
(define (TSUM opts) [TYPE "TSUM" opts])
(define THOL  [TYPE "THOL"])
(define (TVAR idx) [TYPE "TVAR" idx])
(define (TFUN args ret) [TYPE "TFUN" (Sz args) args ret])
;;
(define (is-tfun? x) (Eq (_1 x) "TFUN"))
(define (tfun-ari x) (_2 x))
(define (tfun-args x) (_3 x))
(define (tfun-ret x) (_3 x))
(define (TFAC fac val) [TYPE "TFAC" fac val])
(define (TROW vals) [TYPE "TROW" vals])
(define (TUNI lvl) [TYPE "TUNI" lvl])
(define (TPIN box) [TYPE "TPIN" box])
(define TANY [TYPE "TANY"])
(define TBAD [TYPE "TBAD"])
(define (TBOX val) [TYPE "TBOX" val])
(define (TARR item) [TYPE "TARR" item])

(define (type-nests? sup sub) y)

(define (type-apply f x)
  (If (Eq 0 (is-tfun? f))
      (TBAD ["applying" f x])
      (If (Eq 1 (tfun-ari f))
          (If (type-nests? (_0 (tfun-args f) x))
              (tfun-ret f)
              (TFUN (drop 1 (tfun-args f)) (tfun-ret f))))))


(define empty-subject
  ["SUT" 0 0 TANY ""])

;;

(define (insert-const name const sut)
  (snap 2 (bst-insert name const) sut))

(define if-ty
  (TFUN [TANY (TNAT 0) (TNAT 0)] (TNAT 0)))




(define default-subject-one (insert-const "nat" (TNAT 0) empty-subject))
(define default-subject-two (insert-const "if" if-ty default-subject-one))
;(define default-subject default-subject-two)

(define unary-nat-ty (TFUN [(TNAT NONE)] (TNAT NONE)))
(define eq-ty (TFUN [TANY TANY] (TNAT NONE)))
(define default-subject
   (pipe empty-subject
     (insert-const "nat" (TNAT NONE))
     (insert-const "if" if-ty)
     (insert-const "inc" unary-nat-ty)
     (insert-const "dec" unary-nat-ty)
     (insert-const "eq" eq-ty)))


(define (get-const name sut) (bst-search name (_2 sut)))
(define (got-const name sut) (_0 (get-const name sut)))

assert(Eq (got-const "if" default-subject) if-ty)

assert(Eq (TNAT NONE) (_0 (get-const "nat" default-subject)))

(define (get-prod sut)
  (_3 sut))

(define (get-name sut) (_4 sut))
(define (set-name name sut) (Up 4 name sut))
;
(define (set-sut-prod prod sut) (Up 3 prod sut))

(define (V n) ["V_" n]) ;; local ref (de bruijn)
(define (K v) ["K_" v]) ;; constant
(define (G v) ["G_" v]) ;; name
(define (A f x) ["A_" f x]) ;; app
(define (L v b) ["L_" v b]) ;; let
(define (R vs b) ["R_" vs b]) ;; letrec
(define (M s) ["M_" s]) ;; mark
;; function
(define (F pin mark rec name arity body) ["F_" pin mark rec name arity body])

(define f-pinned (Ix 1)) (define set-f-pinned (Up 1))
(define f-marked (Ix 2)) (define set-f-marked (Up 2))
(define f-recur (Ix 3)) (define set-f-recur (Up 3))
(define f-name (Ix 4)) (define set-f-name (Up 4))
(define f-arity (Ix 5)) (define set-f-arity (Up 5))
(define f-arity (Ix 6)) (define set-f-arity (Up 6))

(define (elaborate sut ast)
  ; (print ["elaborate" sut ast])
  ;; retrieve type
  (define (get-type node sut-new)
    (cond
      ((Eq "ref" (_0 node)) (got-const (_1 node) sut-new))
      (else TANY)))
  (define (put-bind bind t sut-new)
    (bst-insert (_1 bind) (get-type (_2 bind) sut-new) t))
  (define (bind-to-type sut bind)
    (TFAC (_1 bind) (get-type (_2 bind) sut)))

  (define (insert-type-bind sut b)
    (define entry [(_2 b) (_3 b)])
    (snap 1 (lambda (x) (weld x [entry])) sut))

  ; (define ex (cork (Eq b) (Ix )))
  (define (binder b x) (define ret ((Eq b) (Ix 0 x)))
    (print ["binder" x ret]) ret)

;

  (define (find-bind-idx b sut)
    (print sut)
    (define ret (find-idx (binder b) (Ix 1 sut)))
    (print ["find-idx-ret" ret])
    ret)
  ;


  (define (got-bind idx sut)
    (Ix idx (_1 sut)))

  (define (elaborate-decl name rest sut-new)
    ;; two-pass, fix
    (define stub (insert-const name TANY sut-new))
    (define r[inner-sut ir] (elaborate (set-name name stub) rest))
    [(insert-const name (got-const name inner-sut) sut-new) ir])

  (define (elaborate-func args body sut-new)
    (define name (get-name sut-new))
    (define argty (map (bind-to-type sut-new) args))
    (define inner-ty
       (foldl insert-type-bind sut-new argty))
    (define prod[sut-prod body-ir] (elaborate inner-ty body))
    (define funty (TFUN argty (get-prod sut-prod)))
    (define fun-ir
       (F y y y name (Sz argty) body-ir))
    [(insert-const (get-name sut-new) funty sut-new) fun-ir])

  ;; todo: typecheck inner
  (define (elaborate-cast ty val sut-new)
    (define r[s ir] (elaborate sut-new val))
    (define prod-ty (get-type ty sut-new))
    ;; assert(nest prod-ty (get-prod s))
    [(set-sut-prod (get-type ty sut-new) sut-new) ir])

  (define (elaborate-call f x sut-new)
    (define ef[f-sut fir] (elaborate sut-new f))
    (define ex[x-sut xir] (elaborate sut-new x))
    (define fty (get-prod f-sut))
    (define xty (get-prod x-sut))
    (define resty (type-apply fty xty))
    (define resir (A fir xir))
    [(set-sut-prod resty sut) resir])
;
  (define (elaborate-ref face sut-new)
    ;(print ["face" face])
    (print ["sut-new" sut-new])
    (define gval (get-const face sut-new))
    (define lval (find-bind-idx face sut-new))
    ;(print ["gval" gval])
    (print ["lval" face lval])
    (cond ((Truth lval) [(got-bind lval) (V (_0 lval))])
          ((Truth gval) [(_0 gval) (G face)])
          (else [TBAD ["missing-face" face]])))

  (cond
    ((Eq "decl" (_0 ast))
      (elaborate-decl (get-decl-name ast) (get-decl-rest ast) sut))
    ((Eq "func" (_0 ast))
      (elaborate-func (_1 ast) (_2 ast) sut))
    ((Eq "func" (_0 ast))
      (elaborate-func (_1 ast) (_2 ast) sut))
    ((Eq "cast" (_0 ast))
      (elaborate-cast (_1 ast) (_2 ast) sut))
    ((Eq "call" (_0 ast))
      (If (Gt (Sz ast) 3)
        (error ["bad call"])
      (elaborate-call (_1 ast) (_2 ast) sut)))
    ((Eq "ref" (_0 ast))
      (elaborate-ref (_1 ast) sut))
    (else
      (begin (print ["ast" ast]) [(set-sut-prod TBAD sut) 0]))))






(define (pin-arity x)
  (define i (Unpin x))
  (If (IsLaw i) (Arity i) 1))

(define (plan-arity x)
  (Case4 (Type x)
     0
     (pin-arity x)
     (Arity x)
     (Dec (plan-arity (Init x)))))






