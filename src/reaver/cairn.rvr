(define types-demo "
+  point
  $  [x=nat y=nat]
+  example_point
  ^(point 3 4)
+  add_both
  |  a=nat p=point
  ^(point (add p.x a) (add p.y a))
")





(define tvar-demo "
+  maybe
  '  @ introduces type var
  @  x
  '  & is sum type
  &  [#some x]
     #none
  '  functions
  +  map
    @  x  y
    |  f={(maybe x) (maybe y)}
    ^  (maybe y)
    ?  a
      >  [#some v=x]  [#some (f v)]
      >  #none        #none
  '  note receiver last to enable currying
  +  or_else
    @  x
    |  def=x  a=(maybe x)
    ^  x
    ?  a
      >  [#some v=x]  v
      >  'none        def
  ")

(define pattern-demo "
' test
+  switch
|  a=foo
^  nat
?  a
  >  [%bar nat]  (add 4 5)
  >  [%foo nat nat]
    %  (do-some big)
    call
    ")

