(define (pin-arity x)
  (define i (Unpin x))
  (If (IsLaw i) (Arity i) 1))

(define (plan-arity x)
  (Case4 (Type x)
     0
     (pin-arity x)
     (Arity x)
     (Dec (plan-arity (Init x)))))


(define (is-constant-app f x)
 (and (Eq "VAL" (_0 f)) (Eq "VAL" (_0 x)) (Ne 1 (plan-arity (_1 f)))))

(define (folding-apply f x)
  (If (is-constant-app f x)
    (VAL ((_1 f) (_1 x)))
    (APP f x)))

(define (ingest-mark ingest compile s env m[_ x])
  (ingest compile s x env))


;; =ingest-local= just translates the reference into the new
;; representation (unique key per binding) by indexing into a stack.
(define (ingest-local ingest compile s env l[_ i])
  [env (lix-error "ingest-local" i s)])


;; =ingest-global= just produces a constant.
(define (ingest-global ingest compile s env l[_ g])
  (define val (If (IsPin g) (Unpin g) g))
  [env (VAL (bind-val val))])

(define (ingest-constant ingest compile s env l[_ c])
  [env (VAL c)])

(define (ingest-apply ingest compile s env0 app[_ fa xa])
  (define one[env1 f] (ingest compile s fa env0))
  (define two[env2 x] (ingest compile s xa env1))
  [env2 (folding-apply f x)])



(define (ingest-let ingest compile s env0 l[v b])
  (define ilet[env1 vr] (ingest compile s v env0))
  (define nex1 (Sz env1))
  (define is-app (Eq "APP" (_0 vr)))
  (define s2 (lcons (If is-app (VAR nex1) vr) s))
  (define env2 (If is-app (snoc env1 vr) env1))
  (ingest compile s2 b env2))

(define (ingest-letrec-step ingest compile s env0 l[_ vx k])
  (define one[env1 vr] (ingest compile s vx env0))
  (Up k vr env1))

(define (ingest-letrec ingest compile s env0 l[_ vs b])
  (define n-binds (Sz vs))
  (define nex0 (Sz env0))
  (define ks (gen n-binds (Add nex0)))
  (define env1 (resize (Add nex0 n-binds) env0))
  (define s2 (lweld (stream map VAR ks) s))
  (ingest compile s2 b
    (foldl (ingest-letrec-step ingest compile s2) env1 (zip vs ks))))



(define (ingest-lambda ingest compile s env0 lam)
  (define selfkey (Sz env0))
  (define argkey1 (Inc selfkey))
  (define argkeys (lgen (f-arity lam) (Add argkey1)))
  (define nex2    (Add argkey1 (f-arity lam)))
  (define one[bin bod]
    (ingest compile
      (lweld (lrev (lmap VAR argkeys)) (lcons (VAR selfkey) s))
      (f-body lam)
      (Rep 0 0 nex2)))
  (define nex3 (Sz bin))
  (define two[cns free] (compile (FUN (f-pinned lam) (f-name lam) selfkey
                                      argkeys bin bod)))

  [env0 (lfoldl APP (Sap VAL cns) (lmap VAR free))])


(define (ingest compile scope ir env)
  (define hed-eq (Eq (_0 ir)))
  ((cond
    ((hed-eq "M_") ingest-mark)
    ((hed-eq "V_") ingest-local)
    ((hed-eq "G_") ingest-global)
    ((hed-eq "K_") ingest-constant)
    ((hed-eq "A_") ingest-apply)
    ((hed-eq "L_") ingest-local)
    ((hed-eq "R_") ingest-letrec)
    ((hed-eq "F_") ingest-lambda)) ingest compile scope env ir))



(define (ingest-expr x)
  (ingest compile NIL x []))



(define (expr-is-value? x[xk])
  (Eq "VAL" xk))

(define (make-dummy-function b[bin bod])
  (define nex (Sz bin))
  (FUN 0 "dummy" nex (lsing (Inc nex)) bin bod))

(define (compile-dummy-function b[bin bod])
  (define nex (Sz bin))
  (_1
    (compile
      (FUN 0 "dummy" nex (lsing (Inc nex)) bin bod))))

(define (compile-expr x)
  (define res[bin bod] (ingest-expr x))
  (If (expr-is-value? bod)
    (_1 bod)
    (compile-dummy-function res 0)))






;(print (ParseRex demo))
(print (rex-to-ast (ParseRex demo)))
(define elab (elaborate default-subject (rex-to-ast (ParseRex demo))))
(define result (compile-expr (_1 elab)))

(define (compile-cairn src)
  (define ast (rex-to-ast (ParseRex src)))
  (define sut (elaborate default-subject ast))
  (define result (compile-expr (_1 sut)))
  result)
(define result-two (compile-cairn demo))

(print demo)
(print result)
(print (result 3 4))
