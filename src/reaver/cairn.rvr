(define (mk-doccord doc val)
  ["doccord" doc val])

(define (rune-to-ast rune children)
  [(strWeld "rune-" rune) (Sz children)])

(define (is-rune rune node)
  (And (Eq (_0 node) "open") (Eq (_2 node) rune)))


(define (id x) x)

(define (get-leaf-str node)
  assert(Eq "leaf" (_0 node))
  (_3 node))

;;  decl: ["name" val]
(define (make-decl hed rest cont)
  ["decl" (get-leaf-str (_0 hed)) (cont rest)])

(define (get-decl-name decl) (_1 decl))
(define (get-decl-rest decl) (_2 decl))

(define empty (Row 0 0))

(define (parse-leaf leaf)
  (cond
    ((str-numeric? leaf) ["lit" "num" (parse-nat leaf)])
    (else ["ref" [leaf]])))




(define (split-once f x)
  (define (go acc r[x xs])
    (Ifz r [(rowify (lflop acc)) 0]
    (If (f x)
      [(rowify (lflop acc)) (rowify r)]
      (go (lcons x acc) xs))))
  (go 0 (stream x)))

(ParseRex types-demo)
(define (rex-to-ast r)
  ;; a heir node implies a rune poem + possible children
  ;; accumulate until we see a new decl, return [self kids]
  (define (split-heir xs)
    (split-once (lambda (x) (or (Eq (_0 x) "open") (Eq (_0 x) "heir"))) xs))

  (define (split-word xs)
    (split-once (lambda (x) (and (Eq (_0 x) "leaf") (Eq (_2 "word")))) xs))
  (define (split-decl xs) (split-once (is-rune "+") xs))
  (define (make-call-direct hed tel) ["call" (rex-to-ast hed) (rex-to-ast tel)])

  (define (parse-type-word x)
    (cond ((Eq x "'@") "nat")
          ((Eq x "':") "row")
          ((Eq x "'#") "pin")
          ((Eq x "'$") "fun")
          (else ["ref" [x]])))

  (define (parse-type-tyte rune kids cont)
    (cond
      ((Eq rune "=")
        ["bind" (get-leaf-str (_0 kids)) (cont (_1 kids))])
      (else ["bad"])))

  (define (parse-type x)
    (cond
     ((Eq (_0 x) "leaf") (parse-type-word (get-leaf-str x)))
     ((Eq (_0 x) "tyte") (parse-type-tyte (_2 x) (_3 x) parse-type))
          (else ["bad" x])))


  (define (parse-decl-name x)
    (define r[name rest] (split-word x))
    (get-leaf-str name))

  (define (parse-type-bind parse-type-decl kids)
    assert(Eq (Sz kids) 2)
    ["bind" (get-leaf-str (_0 kids)) (parse-type-decl (_1 kids))])

  (define (parse-type-decl-tyte parse-type-decl x)
    (define rune (_2 x))
    (cond
      ((Eq rune "=") (parse-type-bind parse-type-decl (_3 x)))
      (else (error "bad-ty-decl-tyte"))))

  (define (parse-type-decl-expr parse-type-decl brak x)
    (cond
      ((Eq "brack" brak)
        ["row" (map parse-type-decl x)])
        (else (error "weird-brak"))))

  (define (parse-type-decl x)
    (define (hd-is y) (Eq (_0 x) y))
    (cond
      ((hd-is "expr") (parse-type-decl-expr parse-type-decl (_2 x) (_3 x)))
      ((hd-is "tyte") (parse-type-decl-tyte parse-type-decl x))
      ((hd-is "leaf") ["ref" [(_3 x)]])
      (else (error [x "wack ast"]))))

      ;; % (f x)  y -> (f x y)

  (define (uncurry-cen call rest)
    (define inner (rex-to-ast call))
    (If
      (Eq "call" (_0 inner))
      (snoc rest inner)
      ["call" inner rest]))


  (define (fold-body body[x xs])
    (define (hd-rune r) (is-rune r x))
    (define kids)
    (Ifz body "fold-empty-body"
      (cond
        ((hd-rune "$") ["span" (parse-type-decl (_0 (_3 x)))])
        ((hd-rune "|") ["func" (map parse-type (_3 x)) (fold-body xs)])
        ; ((hd-rune "%") ["call" (rex-to-ast (_0 (_3 x))) (fold-body xs)])
        ((hd-rune "%") (uncurry-cen (_0 (_3 x)) (fold-body xs)))
        ((hd-rune "^") ["cast" (parse-type (_0 (_3 x))) (fold-body xs)])
        (else (rex-to-ast x)))))
        ;;  (if (eq 0 a) b (add (inc b) (dec a)))

  ;; a decl is ["decl" self kids]
  (define (make-decl x)
    (define c[name contents] (split-heir x))
    (define contents-list
      (If (Eq (_0 (_0 contents)) "heir")
          (_2 (_0 contents))
          contents))
    (define fam[self kids] (split-decl contents-list))
    ["decl" (parse-decl-name (_0 name))
     (fold-body (stream self))
     (map rex-to-ast kids)])

  (define (parse-expr brak kids)
    (cond
      ((Eq "paren" brak)
        (weld ["call"] (map rex-to-ast kids)))

        (else (error "weird-brak"))))


  (define (is-hd x) (Eq (_0 r) x))
  (cond
    ((is-rune "+" r) (make-decl (_3 r)))
    ((is-hd "expr") (parse-expr (_2 r) (_3 r)))
    ((is-hd "leaf") (parse-leaf (get-leaf-str r)))
    (else r)))

(define (parse-ast src) (rex-to-ast (ParseRex src)))
(print (parse-ast demo))

