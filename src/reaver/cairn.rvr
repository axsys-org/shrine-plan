(define tvar-demo "
+  maybe
  '  @ introduces type var
  @  x
  '  & is sum type
  &  [#some x]
     #none
  '  functions
  +  map
    @  x  y
    |  f={(maybe x) (maybe y)}
    ^  (maybe y)
    ?  a
      >  [#some v=x]  [#some (f v)]
      >  #none        #none
  '  note receiver last to enable currying
  +  or_else
    @  x
    |  def=x  a=(maybe x)
    ^  x
    ?  a
      >  [#some v=x]  v
      >  'none        def
  ")

