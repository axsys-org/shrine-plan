(define (mk-doccord doc val)
  ["doccord" doc val])

(define (rune-to-ast rune children)
  [(strWeld "rune-" rune) (Sz children)])

(define (is-rune rune node)
  (And (Eq (_0 node) "open") (Eq (_2 node) rune)))


(define (id x) x)

(define (get-leaf-str node)
  (print node)
  assert(Eq "leaf" (_0 node))
  (_3 node))

;;  decl: ["name" val]
(define (make-decl hed rest cont)
  ["decl" (get-leaf-str (_0 hed)) (cont rest)])

(define (get-decl-name decl) (_1 decl))
(define (get-decl-rest decl) (_2 decl))

(define empty (Row 0 0))

(define (parse-leaf leaf)
  (cond
    ((str-numeric? leaf) ["lit" "num" (parse-nat leaf)])
    (else ["ref" [leaf]])))




(define (split-once f x)
  (define (go acc r[x xs])
    (Ifz r [(rowify (lflop acc)) 0]
    (If (f x)
      [(rowify (lflop acc)) (rowify r)]
      (go (lcons x acc) xs))))
  (go 0 (stream x)))



