(define y 1)
(define n 0)

(define (reap str count)
  (If (Eq count 0) ""
      (strWeld (reap str (Dec count)) str)))

(define spaces (reap " "))
;; Maybe
(define (SOME x) ["some" x])
(define NONE 0)

(define ax-self [0])
(define ax-kid [1])
(define empty-ax ("AX" 0 0))

(define empty-subject
  ("SUT" empty-ax 0 0 0 0))

(define subject-loc (Ix 2))
(define set-subject-loc (Up 2))
(define sut-tvar (Ix 3))
(define set-sut-tvar (Up 3))
(define sut-decl-order (Ix 4))
(define (sut-decl-order-count sut)
  ; (print ("decl count" (Ix 4 sut)))
  (Sz (sut-decl-order sut)))
(define set-sut-decl-order (Up 4))
(define (push-sut-decl new-decl) (snap 4 ((flip Weld) [new-decl])))
(define (pop-sut-decl sut)
  (define order (sut-decl-order sut))
  [(_0 order) (set-sut-decl-order (drop 1 order) sut)])



;; setf :: [Nat] -> a -> b -> a ; treats nat list as an axis into b, replacing it with a
(define (setf road new val)
  (define ret (If (Eq 0 (Sz road)) (Trace ("new" road new val) new)
    (snap (_0 road) (setf (drop 1 road) new)) val))
  ret)


;; updf :: [Nat] -> (a -> b) -> c -> c
;; treats nat list as an axis into c,
;; replacing it with the application of the func
(define (updf road f val)
  (Ifz road (zap (f val))
    (snap (_0 road) (lambda (x) (updf (drop 1 road) f x)) val)))

;; get :: [Nat] -> a -> b
;; treats nat list as an axis into a returning result
(define (getf road val)
  (Ifz road val
    (getf (drop 1 road) (Ix (_0 road) val))))

(define test [3 4])
assert(Eq 4 (getf [1] test))
assert(Eq 4 (getf [1] test))

(define (dipax path ax)
  (Ifz path ax
    (dipax (drop 1 path) (bst-gut (_0 path) empty-ax (getf ax-kid ax)))))

(define (getax path ax)
  (getf ax-self (dipax path ax)))

(define (gotax path ax) (needful ["gotax" path ax] (getax path ax)))

(define (gutax path def ax) (fall def (getax path ax)))

(define (putax path val ax)
  (define ret (Ifz path (Up 0 [val] ax)
    (updf ax-kid
      (lambda (kid)
        (bst-ups (_0 path) empty-ax (putax (drop 1 path) val) kid)) ax)))
        ret)

(define (delax path val ax)
  (define ret (Ifz path (Up 1 (_1 ax) empty-ax)
    (updf ax-kid
      (lambda (kid)
        (bst-ups (_0 path) empty-ax (putax (drop 1 path) val) kid)) ax)))
        ret)


(define (mapax f ax)
  (define ret ("AX"
    (Ifz (_0 ax) 0 (0 (f (_0 (_0 ax)))))
    (bst-map (mapax f) (_1 ax))))
  ret)

;

(define test-ax
  (pipe empty-ax
    (putax ["foo" "bar"] "test")
    (putax ["foo"] "foo")
    (putax ["baz"] "baz")
    (putax ["foo" "bar" "qux"] "qux")))

;
assert(Eq "test" (gotax ["foo" "bar"] test-ax))
assert(Eq "foo" (gotax ["foo"] test-ax))
assert(Eq "baz" (gotax ["baz"] test-ax))
assert(Eq "qux" (gotax ["foo" "bar" "qux"] test-ax))


(define (tapax-go ax here)
  (define fat (getf ax-self ax))
  (define kids (bst-ltap x))
  (define (recurse x)
    (define kids (bst-ltap x))
    (lzing (lmap (lambda (x[k v])
      (tapax-go v (snoc k here)))
      kids)))
  (define rec (recurse (getf ax-kid ax)))
  (Ifz fat rec (lcons [here (_0 fat)] rec)))

(define (tapax ax)
  (define ls (tapax-go ax 0))
  ls)

(define (print-path x)
  (foldl strWeld "" (map (cork print-nat (strWeld "/")) x)))
(define (print-ref x)
  (foldl strWeld "" (map (cork print-nat (strWeld ":")) x)))

(define (pretty-kv f x[k v])
  (pretty-pair (dtext (print-path k)) (f v)))

(define (pretty-ax f ax)
  (define entries (tapax ax))
  (define len (llen entries))
  (define pentries
    (join-with
      (dcat (dtext ", ") dline)
      (lmap (pretty-kv f) entries)))
  (dgroup (foldl dcat dempty
    [(dtext "{") (dnest 2 (dcat dline pentries)) dline (dtext "}")])))

(define VAL "VAL")
(define DECL "DECL")

(define (make-val key val tc exp ty) [VAL key val tc exp ty])
(define (make-decl key params val) [DECL key params val])
(define bind-key  Ix1) (define set-bind-key  (Up 1))
(define bind-val  Ix2) (define set-bind-val  (Up 2))
(define bind-expr Ix3) (define set-bind-expr (Up 3))
(define bind-ty Ix4) (define set-bind-ty (Up 4))
(define bind-type-decl Ix5) (define set-bind-ty-decl (Up 5))

(define (bind-span x)
  (define ty[_ tag val] (bind-ty x))
  ; (print ("bind-span" x ty))
  (If (Eq tag "TTYP") val 0))


(define (pretty-kv k v)
  (dcat
    (dcat (dtext k) (dcat (dtext "=") softline)) v))


(define (pretty-entry ent)
  (define key (pretty-kv "key" (dtext (print-path (bind-key ent)))))
  (define val
    (pretty-kv "val" (dtext (Ifz (bind-val ent) "missing" "exists"))))
  (define expr
    (pretty-kv
      "expr"
      (dtext (Ifz (bind-expr ent) "missing" "exists"))))
  (define pentries
    (join-with (dcat (dtext ", ") dline) (stream [key val expr])))
  (dgroup (foldl dcat dempty
    [(dtext "{") (dnest 2 (dcat dline pentries)) dline (dtext "}")])))


(define (print-globals s) (drender 80 ((pretty-ax pretty-entry) (_0 s))))

(define (pretty-subject sut)
  (dgroup (foldl dcat dempty
    [(dtext "sut=[")
     softline
     (dtext "entries=")
     softline
     (pretty-ax (lambda (x) (dtext (print-nat x))) (_0 sut))
     (dtext "local=")
     softline
     (dtext "uimpl")
   ])))

(define (print-subject sut) (print (drender 80 (pretty-subject sut))))

(define lss (tapax test-ax))
(define ax-len (llen lss))
(print (Row 0 4 lss))


(define (sut-get-tvar? tvar sut) (find-idx (Eq tvar) (sut-tvar sut)))
(define (sut-put-tvar tvar sut) (snap 3 (snoc tvar) sut))

(define (get-const name sut) (getax name (_0 sut)))
(define (got-const name sut) (need (get-const name sut)))
(define (get-span name sut)
  (define entry (get-const name sut))
  (Ifz entry 0
    (bind-span (_0 entry))))

(define (got-span name sut)
  (define res (get-span name sut))
  (Ifz res (error ["bad span lookup" name sut])
    res))


(define (binder b x) (Eq b (Ix 0 x))) ;
(define (find-bind-idx b sut) (find-idx (binder b) (rev (Ix 1 sut))))

(define (find-bind-idx-norm b sut) (find-idx (binder b) (Ix 1 sut)))

(define (lookup-name name sut)
  (define gval[gres] (get-const name sut))
  (define lval[lres]
    (If
      (Eq 1 (Sz name))
      (find-bind-idx-norm (_0 name) sut)
      0))
  (Ifz lval
       (Ifz gval 0
         [(bind-ty gres)])
         (_1 (Ix gres (_1 sut)))))







(define (get-prod sut)
  (_3 sut))

(define (get-name sut) (_2 sut))
(define (set-name name sut) (Up 2 name sut))
