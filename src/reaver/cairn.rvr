(define (sut-get-tvar? tvar sut) (find-idx (Eq tvar) (sut-tvar sut)))
(define (sut-put-tvar tvar sut) (snap 3 (snoc tvar) sut))

(define (get-const name sut) (getax name (_0 sut)))
(define (got-const name sut) (need (get-const name sut)))
(define (get-span name sut)
  (define entry (get-const name sut))
  (Ifz entry 0
    (bind-span (_0 entry))))

(define (got-span name sut)
  (define res (get-span name sut))
  (Ifz res (error ["bad span lookup" name sut])
    res))

(define (check-type-wf sut x[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (check-type-wf sut))
  (define (check-tfun-args args)
    (define res (filter is-left? (map (check-type-wf sut) args)))
    (Ifz (Sz res) (right 0) (_0 res)))
  (define (type-and x y) (If (is-left? x) x y))
  (cond
    ((tag-is "TVAR")
     (Ifz (sut-get-tvar? (_2 x)) (left "unbound ty var") (right 0)))
     ((tag-is "TFUN")
       (type-and (check-tfun-args (tfun-args x)) (recur (tfun-ret x))))
     ((tag-is "TNOM") (Ifz (get-const (_2 x) sut) (left "bad type reference")
         (right 0)))
     ((tag-is "TFAC") (check-type-wf (_3 x)))
     ((tag-is "TNAT") (right 0))
     ((tag-is "TQUA") (check-type-wf (sut-put-tvar (_2 x) sut) (_3 x)))
     ((tag-is "TSUM") (check-tfun-args (_2 x)))
     ((tag-is "TROW") (check-tfun-args (_2 x)))
     (else (print "unhandled") (right 0))))


(define (subst-type name repl ty[_ tag])
  (define (tag-is y) (Eq y tag))
  (define recur (subst-type name repl))
  (cond
    ((tag-is "TVAR") (If (Eq (_2 ty) name) repl ty))
    ((tag-is "TFUN") (TFUN (map recur (tfun-args ty)) (recur (tfun-ret ty))))
    ((tag-is "TNOM") (TNOM (_2 ty) (map recur (_3 ty))))
    ((tag-is "TFAC") (TFAC (_2 ty) (recur (_3 ty))))
    ((tag-is "TNAT") ty)
    ((tag-is "TQUA") (If (Eq (_2 ty) name) ty (TQUA (_2 ty) (recur (_3 ty)))))
    ((tag-is "TSUM") (TSUM (map recur (_2 ty))))
    ((tag-is "TROW") (map recur (_2 ty)))
    (else (print [ty "unhandled"]) (right 0))))

(define (binder b x) (Eq b (Ix 0 x))) ;
(define (find-bind-idx b sut) (find-idx (binder b) (rev (Ix 1 sut))))

(define (find-bind-idx-norm b sut) (find-idx (binder b) (Ix 1 sut)))

(define (lookup-name name sut)
  (define gval[gres] (get-const name sut))
  (define lval[lres]
    (If
      (Eq 1 (Sz name))
      (find-bind-idx-norm (_0 name) sut)
      0))
  (Ifz lval
       (Ifz gval 0
         [(bind-ty gres)])
         (_1 (Ix gres (_1 sut)))))


(define (type-nests? sup sub) (or (Eq sup sub) (Eq (_1 sup) "TANY") (Eq (_1 sub) "TANY")))
(define (ty-match name x) (And (Eq (_1 x) "TVAR") (Eq (_2 x) name)))
(define (find-tvar name args) (find-idx (ty-match name) args))

(define (type-apply f x)
  ;; just try and expand this easy case
  ;; combined with the UFCS should get 90% of polymorphism
  (define (type-apply-qua f x)
    (define name (_2 f))
    (define fun (_3 f))
    (define first-arg[idx] (find-tvar name (tfun-args fun)))
    (define result
      (subst-type name x fun))
    (unless
      (Eq (_1 fun) "TFUN")
      (TBAD ["too complicated" f x])
      (Ifz first-arg
           (TBAD ["failed to resolve polymorphism by arguments, please specify"
                  f x])
           (If (Lt idx (Sz x))
             (type-apply (subst-type name (Ix idx x) fun) x)
             (TBAD ["polymorphism not first arg" f x])))))
  (define (f-hd y) (Eq (_1 f) y))
  (define (type-apply-fun args ret x)
    ;(print ["apply fun" args ret x])
    (If (type-nests? (_0 args) x)
        (If (Eq 1 (Sz args)) ret
          (TFUN (drop 1 args) ret))
        (TBAD ["nest-fail" (_0 args) x])))
  (Ifz x f
  (cond
    ((f-hd "TQUA") (type-apply-qua f x))
    ((f-hd "TFUN")
      (type-apply (type-apply-fun (tfun-args f) (tfun-ret f) (_0 x)) (drop 1 x)))
    ((f-hd "TBAD") f)
    (else (TBAD ["weird apply" f x])))))

(define (insert-const name val exp ty sut)
  (define ent (make-val name val exp ty))
  (snap 0 (putax name ent) sut))

(define (insert-const-ty name ty sut)
  (insert-const name 0 0 ty sut))

(define (insert-const-ir name exp ty sut)
  (insert-const name 0 exp ty sut))

(define (insert-const-type name ty sut)
  (insert-const name 0 0 (TTYP ty) sut))

(define (insert-const-ffi name val ty sut)
  (insert-const name val 0 ty sut))

(define (bizarre-if x pred y) (If pred x y))
(define if-ty
  (TQUA "a" (TFUN [(TNAT 0) (TVAR "a") (TVAR "a")] (TVAR "a"))))

(define unary-nat-ty (TFUN [(TNAT NONE)] (TNAT NONE)))
(define binary-nat-ty (TFUN [(TNAT NONE) (TNAT NONE)] (TNAT NONE)))
(define eq-ty (TFUN [TANY TANY] (TNAT NONE)))


(define default-subject
   (pipe empty-subject
     (insert-const-ty ["nat"] (TTYP (TNAT 0)))
     (insert-const-ffi ["if"] If if-ty)
     (insert-const-ffi ["inc"] Inc unary-nat-ty)
     (insert-const-ffi ["dec"] Dec unary-nat-ty)
     (insert-const-ffi ["eq"] Eq eq-ty)))

(define (get-prod sut)
  (_3 sut))

(define (get-name sut) (_2 sut))
(define (set-name name sut) (Up 2 name sut))
