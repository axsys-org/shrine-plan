;;;; Compiler path maps. Nodes hold an optional value and a BST of children.
(#bind bst (#module bst))
(#import bst)
(#bind reef (#module reef))
(#import reef)

(define ax-self [0])
(define ax-kid [1])
(define empty-ax ("AX" 0 0))

(define (updf road f val)
  (Ifz road (zap (f val))
    (snap (_0 road) (lambda (x) (updf (drop 1 road) f x)) val)))

;; get :: [Nat] -> a -> b
;; treats nat list as an axis into a returning result
(define (getf road val)
  (Ifz road val
    (getf (drop 1 road) (Ix (_0 road) val))))

(define (dipax path ax)
  (Ifz path ax
    (dipax (drop 1 path) (bst-gut (_0 path) empty-ax (getf ax-kid ax)))))

(define (getax path ax)
  (getf ax-self (dipax path ax)))

(define (gotax path ax) (needful ["gotax" path ax] (getax path ax)))

(define (gutax path def ax) (fall def (getax path ax)))

(define (putax path val ax)
  ;; bst compares path components with reef's total PLAN ordering, so axal
  ;; paths may safely contain content pins as well as historical nat/cord keys.
  (define ret (Ifz path (Up 0 [val] ax)
    (updf ax-kid
      (lambda (kid)
        (bst-ups (_0 path) empty-ax (putax (drop 1 path) val) kid)) ax)))
        ret)

(define test-ax
  (pipe empty-ax
    (putax ["foo" "bar"] "test")
    (putax ["foo"] "foo")
    (putax ["baz"] "baz")
    (putax ["foo" "bar" "qux"] "qux")))

;
assert(Eq "test" (gotax ["foo" "bar"] test-ax))
assert(Eq "foo" (gotax ["foo"] test-ax))
assert(Eq "baz" (gotax ["baz"] test-ax))
assert(Eq "qux" (gotax ["foo" "bar" "qux"] test-ax))


(define (tapax-go ax here)
  (define fat (getf ax-self ax))
  (define (recurse x)
    (define kids (bst-ltap x))
    (lzing (lmap (lambda (x[k v])
      (tapax-go v (snoc k here)))
      kids)))
  (define rec (recurse (getf ax-kid ax)))
  (Ifz fat rec (lcons [here (_0 fat)] rec)))

(define (tapax ax)
  (define ls (tapax-go ax 0))
  ls)


(#export getax putax gutax empty-ax tapax gotax)
