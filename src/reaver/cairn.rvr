(define (mk-doccord doc val)
  ["doccord" doc val])

(define (rune-to-ast rune children)
  [(strWeld "rune-" rune) (Sz children)])

(define (is-rune rune node)
  (And (Eq (_0 node) "open") (Eq (_2 node) rune)))


(define (id x) x)

(define (get-leaf-str node)
  assert(Eq "leaf" (_0 node))
  (_3 node))

;;  decl: ["name" val]
(define (make-decl hed rest cont)
  ["decl" (get-leaf-str (_0 hed)) (cont rest)])

(define (get-decl-name decl) (_1 decl))
(define (get-decl-rest decl) (_2 decl))

(define empty (Row 0 0))





(define (parse-leaf leaf)
  (cond
    ((str-numeric? leaf) ["lit" "num" (parse-nat leaf)])
    (else ["ref" leaf])))



(define (rex-to-ast r)
  ;; constructors
  (define (parse-type-word x)
    (cond ((Eq x "'@") "nat")
          ((Eq x "':") "row")
          ((Eq x "'#") "pin")
          ((Eq x "'$") "fun")
          (else ["ref" x])))

  (define (parse-type-tyte rune kids cont)
    (cond
      ((Eq rune "=")
        ["bind" (get-leaf-str (_0 kids)) (cont (_1 kids))])
      (else ["bad"])))

  (define (parse-type x)
    (cond
     ((Eq (_0 x) "leaf") (parse-type-word (get-leaf-str x)))
     ((Eq (_0 x) "tyte") (parse-type-tyte (_2 x) (_3 x) parse-type))
          (else ["bad" x])))


  ;; cast:  [type val]
  (define (make-cast hed rest cont)
    ["cast" (parse-type (_0 hed)) (cont rest)])

  (define (make-func hed rest cont)
    ["func" (map parse-type hed) (cont rest)])

  (define (make-call hed rest cont)
    ; (print ["make-call" hed rest])
    ["call" (rex-to-ast (_0 hed)) (cont rest)])
  (define (make-call-direct hed tel)
    ["call" (rex-to-ast hed) (rex-to-ast tel)])
  ;; parsers


  (define (parse-expr brak kids cont)
    (cond
      ((Eq "paren" brak)
        ; (define kids1 (map cont kids))
        (foldl make-call-direct (_0 kids) (drop 1 kids)))
        (else (error "weird-brak"))))
          ; (If (Eq 2 (Sz kids))
          ;     (make-call-direct (cont (_0 kids)) (cont (_1 kids)))
          ;     ; (make-call-direct (cont (_0 kids)) (parse-expr brak (drop 1 kids)
          ;     (make-call-direct (parse-expr brak (drop 1 kids)
          ;       cont) (cont (rear kids)))))
                ; (else "weird brak")))
  ;;
  (define (merge-heir els)
    (If (Eq 0 (Sz els)) "ret"
      (let ((hed (_0 els)))
      (cond
        ((Eq "leaf" (_0 hed)) (merge-heir (drop 1 els)))
        ((is-rune "+" hed) (make-decl (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "|" hed) (make-func (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "^" hed) (make-cast (_3 hed) (drop 1 els) merge-heir))
        ((is-rune "%" hed) (make-call (_3 hed) (drop 1 els) merge-heir))
        ((Eq "expr" (_0 hed)) (rex-to-ast hed))
         (else [(strWeld "untagged" (_0 hed)) els])))))
        ;; (begin (print ["expr" hed]) (make-call-direct (_3 hed))))

  ;; body
  (cond
    ((Eq "heir" (_0 r)) (merge-heir (_2 r)))
    ((Eq "slug" (_0 r)) "slug")
    ((Eq "expr" (_0 r)) (parse-expr (_2 r) (_3 r) rex-to-ast))
    ((Eq "leaf" (_0 r)) (parse-leaf (get-leaf-str r)))
    ((Eq "open" (_0 r)) (rune-to-ast (_2 r) (_3 r)))
    (else r)))

; (define (make-context))


(define y 1)
(define n 0)

(define (reap str count)
  (If (Eq count 0) ""
      (strWeld (reap str (Dec count)) str)))

; (define (spaces count) (reap " " count))

(define spaces (reap " "))


;; Maybe
(define (SOME x) ["some" x])
(define NONE 0)

(define TYPE "type")


(define (TNAT cube) [TYPE "TNAT" cube])
(define (TSUM opts) [TYPE "TSUM" opts])
(define THOL  [TYPE "THOL"])
(define (TVAR idx) [TYPE "TVAR" idx])
(define (TFUN args ret) [TYPE "TFUN" (Sz args) args ret])
;;
(define (is-tfun? x) (Eq (_1 x) "TFUN"))
(define (tfun-ari x) (_2 x))
(define (tfun-args x) (_3 x))
(define (tfun-ret x) (_3 x))
(define (TFAC fac val) [TYPE "TFAC" fac val])
(define (TROW vals) [TYPE "TROW" vals])
(define (TUNI lvl) [TYPE "TUNI" lvl])
(define (TPIN box) [TYPE "TPIN" box])
(define TANY [TYPE "TANY"])
(define TBAD [TYPE "TBAD"])
(define (TBOX val) [TYPE "TBOX" val])
(define (TARR item) [TYPE "TARR" item])

(define (type-nests? sup sub) y)

(define (type-apply f x)
  (If (Eq 0 (is-tfun? f))
      (TBAD ["applying" f x])
      (If (Eq 1 (tfun-ari f))
          (If (type-nests? (_0 (tfun-args f) x))
              (tfun-ret f)
              (TFUN (drop 1 (tfun-args f)) (tfun-ret f))))))


(define ENTRY "ENTRY")
(define (make-entry key val exp ty) [ENTRY key val exp ty])
(define bind-key  Ix1) (define set-bind-key  (Up 1))
(define bind-val  Ix2) (define set-bind-val  (Up 2))
(define bind-expr Ix3) (define set-bind-expr (Up 3))
(define bind-ty Ix4) (define set-bind-ty (Up 4))


(define empty-subject
  ["SUT" 0 0 TANY ""])

(define (insert-const name val exp ty sut)
  (define ent (make-entry name val exp ty))
  (snap 2 (bst-insert name ent) sut))

(define (insert-const-ty name ty sut)
  (insert-const name 0 0 ty sut))

(define (insert-const-ir name exp ty sut)
  (insert-const name 0 exp ty sut))


(define (insert-const-ffi name val ty sut)
  (insert-const name val 0 ty sut))

(define if-ty
  (TFUN [TANY (TNAT 0) (TNAT 0)] (TNAT 0)))

(define unary-nat-ty (TFUN [(TNAT NONE)] (TNAT NONE)))
(define eq-ty (TFUN [TANY TANY] (TNAT NONE)))
(define default-subject
   (pipe empty-subject
     (insert-const-ty "nat" (TNAT 0))
     (insert-const-ffi "if" If if-ty)
     (insert-const-ffi "inc" Inc unary-nat-ty)
     (insert-const-ffi "dec" Dec unary-nat-ty)
     (insert-const-ffi "eq" Eq eq-ty)))


(define (get-const name sut) (bst-search name (_2 sut)))
(define (got-const name sut) (_0 (get-const name sut)))

assert(Eq (got-const "if" default-subject) if-ty)

assert(Eq (TNAT NONE) (_0 (get-const "nat" default-subject)))

(define (get-prod sut)
  (_3 sut))

(define (get-name sut) (_4 sut))
(define (set-name name sut) (Up 4 name sut))
;
(define (set-sut-prod prod sut) (Up 3 prod sut))



(define (V n) ["V_" n]) ;; local ref (de bruijn)
(define (K v) ["K_" v]) ;; constant
(define (G v) ["G_" v]) ;; name
(define (A f x) ["A_" f x]) ;; app
(define (L v b) ["L_" v b]) ;; let
(define (R vs b) ["R_" vs b]) ;; letrec
(define (M s) ["M_" s]) ;; mark
;; function
(define (F pin mark rec name arity body) ["F_" pin mark rec name arity body])

(define f-pinned (Ix 1)) (define set-f-pinned (Up 1))
(define f-pinned (Ix 1)) (define set-f-pinned (Up 1))
(define f-marked (Ix 2)) (define set-f-marked (Up 2))
(define f-recur (Ix 3)) (define set-f-recur (Up 3))
(define f-name (Ix 4)) (define set-f-name (Up 4))
(define f-arity (Ix 5)) (define set-f-arity (Up 5))
(define f-body (Ix 6)) (define set-f-body (Up 6))

(define (FUN pinned name self args binds body)
  ["FUN" pinned name self args binds body])

(define fun-pinned (Ix 1))
(define fun-name   (Ix 2))
(define fun-self   (Ix 3)) (define set-fun-self  (Up 3))
(define fun-args   (Ix 4)) (define set-fun-args  (Up 4))
(define fun-binds  (Ix 5)) (define set-fun-binds (Up 5))
(define fun-body   (Ix 6)) (define set-fun-body (Up 6))

(define (VAL v) ["VAL" v])
(define (VAR n) ["VAR" n])
(define (APP f x) ["APP" f x])




(define (elaborate sut ast)
  ; (print ["elaborate" sut ast])
  ;; retrieve type
  (define (get-type node sut-new)
    (cond
      ((Eq "ref" (_0 node)) (got-const (_1 node) sut-new))
      (else TANY)))
  (define (put-bind bind t sut-new)
    (bst-insert (_1 bind) (get-type (_2 bind) sut-new) t))
  (define (bind-to-type sut bind)
    (TFAC (_1 bind) (get-type (_2 bind) sut)))

  (define (insert-type-bind sut b)
    (define entry [(_2 b) (_3 b)])
    (snap 1 (lambda (x) (weld x [entry])) sut))

  ; (define ex (cork (Eq b) (Ix )))
  (define (binder b x) ((Eq b) (Ix 0 x)))

;

  (define (find-bind-idx b sut)
    (find-idx (binder b) (rev (Ix 1 sut))))
  ;


  (define (got-bind idx sut)
    (Ix idx (_1 sut)))

  (define (elaborate-decl name rest sut-new)
    ;; two-pass, fix
    (define stub (insert-const-ty name TANY sut-new))
    (define r[inner-sut ir] (elaborate (set-name name stub) rest))
    [(insert-const-ir name ir (got-const name inner-sut) sut-new) ir])

  (define (elaborate-func args body sut-new)
    (define name (get-name sut-new))
    (define argty (map (bind-to-type sut-new) args))
    (define selfty (TFAC name TANY))
    (define inner-ty
      (foldl insert-type-bind (insert-type-bind sut-new selfty) argty))
    (define prod[sut-prod body-ir] (elaborate inner-ty body))
    (define funty (TFUN argty (get-prod sut-prod)))
    (define fun-ir
       (F y y y name (Sz argty) body-ir))
    [(insert-const (get-name sut-new) funty sut-new) fun-ir])

  ;; todo: typecheck inner
  (define (elaborate-cast ty val sut-new)
    (define r[s ir] (elaborate sut-new val))
    (define prod-ty (get-type ty sut-new))
    ;; assert(nest prod-ty (get-prod s))
    [(set-sut-prod (get-type ty sut-new) sut-new) ir])

  (define (elaborate-call f x sut-new)
    (define ef[f-sut fir] (elaborate sut-new f))
    (define ex[x-sut xir] (elaborate sut-new x))
    (define fty (get-prod f-sut))
    (define xty (get-prod x-sut))
    (define resty (type-apply fty xty))
    (define resir (A fir xir))
    [(set-sut-prod resty sut-new) resir])
;
  (define (elaborate-ref face sut-new)
    (define gval[gres] (get-const face sut-new))
    (define lval (find-bind-idx face sut-new))
    (cond
      ((Truth lval) [(set-sut-prod (got-bind lval) sut-new) (V (_0 lval))])
      ((Truth gval) [(set-sut-prod (bind-ty gres)) (G gres)])
      (else [TBAD ["missing-face" face]])))

  (define (elaborate-lit tag lit sut-new)
    (cond
      ((Eq tag "num")
        (define ty (TNAT (SOME lit)))
        [(set-sut-prod ty sut-new) (K lit)])
      (else (error "wack"))))

  (cond
    ((Eq "decl" (_0 ast))
      (elaborate-decl (get-decl-name ast) (get-decl-rest ast) sut))
    ((Eq "func" (_0 ast))
      (elaborate-func (_1 ast) (_2 ast) sut))
    ((Eq "func" (_0 ast))
      (elaborate-func (_1 ast) (_2 ast) sut))
    ((Eq "cast" (_0 ast))
      (elaborate-cast (_1 ast) (_2 ast) sut))
    ((Eq "call" (_0 ast))
      (If (Gt (Sz ast) 3)
        (error ["bad call"])
      (elaborate-call (_1 ast) (_2 ast) sut)))
    ((Eq "ref" (_0 ast))
      (elaborate-ref (_1 ast) sut))
    ((Eq "lit" (_0 ast))
      (elaborate-lit (_1 ast) (_2 ast) sut))
    (else
      (begin (print ["ast" ast]) [(set-sut-prod TBAD sut) 0]))))

;; ====== CODEGEN =======

(define (is-ref-let-bound? fun ref)
  (Ix ref (fun-binds fun)))

assert(Eq (VAR 5) (is-ref-let-bound? (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))
assert(Eq 0       (is-ref-let-bound? (FUN 0 0 0 0 [0 (VAR 5)] 0) 0))


; (define (bind-idx idx) (Ix (Inc idx)))
; (define (set-bind-idx idx) (Up (Inc idx)))
; (define (set-bind-field idx) (Up (Inc idx)))

(define (bump k st)
  (define count (Inc (Ix k st)))
  (Seq count (Up k count st)))

(define (is-unseen-ref-to-let ref fun st[seen])
  (And (Nil (Test ref (Hd st)))
    (is-ref-let-bound? fun ref)))

(define (countloop fun st[seen] sx[tag a b])
   (define tag-is (Eq tag))
   (cond
     ((tag-is "VAL") st)
     ((tag-is "APP" (countloop fun (countloop fun st a) b)))
     ((tag-is "VAR") (bump a
                        (Ifz (is-unseen-ref-to-let a fun st) st
                             (countloop fun
                               (Coup (Set a (Hd st)) st)
                               (Ix a (fun-binds fun))))))))

(define (refcount fun)
  (countloop fun
    (Rep 0 0 (Sz (fun-binds fun)))
    (fun-body fun)))

(define (is-single-use-let? counts fun ref)
  (And
    (is-ref-let-bound? fun ref)
    (Eq 1 (Ix ref counts))))

assert(Eq 1 (is-single-use-let? [0 1] (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))
assert(Eq 0 (is-single-use-let? [0 2] (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))
assert(Eq 0 (is-single-use-let? [0 1] (FUN 0 0 0 0 [0 0]       0) 1))


(define (should-keep-bind? counts fn ref)
  (And (Ix ref (fun-binds fn))
    (Gt (Ix ref counts) 1)))

assert(Eq 1 (should-keep-bind? [0 2] (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))
assert(Eq 0 (should-keep-bind? [0 1] (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))
assert(Eq 0 (should-keep-bind? [0 2] (FUN 0 0 0 0 [0 0]       0) 1))
assert(Eq 0 (should-keep-bind? [0 0] (FUN 0 0 0 0 [0 (VAR 5)] 0) 1))

(define (app-is-code? outer x)
  (define hx (Hd x))
  (Case3 (Dec (Sz x))
    (Nil hx) ; -> 0[a] -> 1
    (Or (Nil hx) (and outer (Eq 1 hx)));  ->
    0))

(define (is-code? outer maxref v)
  (Case4 (Type v)
         (Le v maxref) ;; nat
         0 0 ;;  pin/law
         (app-is-code? outer v)))

assert(Eq  (is-code? 0 5 (1 9))   0 )
assert(Eq  (is-code? 0 5 (0 9))   1 )
assert(Eq  (is-code? 1 5 (1 0 0)) 1 )
assert(Eq  (is-code? 0 5 (1 0 0)) 0 )
assert(Eq  (is-code? 1 5 (0 0 0)) 1 )
assert(Eq  (is-code? 0 5 (0 0 0)) 1 )
assert(Eq  (is-code? 0 5 0)       1 )
assert(Eq  (is-code? 0 5 5)       1 )
assert(Eq  (is-code? 0 5 6)       0 )

(define (cgen outer table counts maxref fn s[t a b])
  (define tag-is (Eq t))
  (cond
    ((tag-is "VAL")
      (If (is-code? outer maxref a) (0 a) a))
    ((tag-is "VAR")
      (If (is-single-use-let? counts fn a)
        (cgen outer table counts maxref fn (Ix a (fun-binds fn)))
        (Ix a table)))
    ((tag-is "APP") (0 (cgen 0 table counts maxref fn a)
      (cgen 0 table counts maxref fn b)))
    (else (error "bad tag cgen"))))

(define (genlet-step table counts maxref fn k rest)
  (1 (cgen 1 table counts maxref fn (Ix k (fun-binds fn)))
    rest))

(define (codegen fn counts)
  (define n-bind (Sz (fun-binds fn)))
  (define f-arg (fun-args fn))
  (define f-self (fun-self fn))
  (define binds (lfilter (should-keep-bind? counts fn)
    (ltake n-bind (lrange 0))))
  (define n-keep (llen binds))
  (define n-arg (llen f-arg))
  (define maxref (Inc (Add n-arg n-keep)))
  (define scope (lcons f-self (lweld f-arg binds)))
  (define table
    (lfoldl
      (lambda (t kv) (Up (_0 kv) (_1 kv) t))
      (Rep 0 0 n-bind)
      (lzip scope (ltake maxref (lrange 0)))))
  (define law
    (Law (Dec n-arg)
         (fun-name fn)
         (lfoldr (genlet-step table counts maxref fn)
                 (cgen 1 table counts maxref fn (fun-body fn))
                 binds)))
  (If (fun-pinned fn) (Pin law) law))


(define (is-free? fn ref)
  (Nor (Eq (fun-self fn) ref)
    (or (Ix ref (fun-binds fn))
      (lhas ref (fun-args fn)))))

(define (cf-step rc fun k)
  (And (Ix k rc)
    (is-free? fun k)))

(define (compile f0[_ pin0 tag0 slf0 arg0 bin0 bod0])
  (define rc0 (refcount f0))
  (define n0 (Sz bin0))
  (define free (lfilter (cf-step rc0 f0) (countdown n0)))
  (define new-self (lfoldl APP (VAR n0) (lmap VAR free)))
  (define f1
    (pipe f0
          (set-fun-self n0)
          (set-fun-args (lweld free arg0))
          (set-fun-binds (Up slf0 new-self (snoc bin0 0)))))
  (Seq rc0
    [(codegen
       (Ifz free f0 f1)
       (Ifz free rc0 (refcount f1)))
       free]))


