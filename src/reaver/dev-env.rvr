;;; HTML helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (attr key val) [key val])
(define (cls val)      (attr "class" val))
(define (id val)       (attr "id" val))
(define no-attrs 0)

(define (node tag attrs children) [tag attrs children])
(define (leaf tag attrs text)     (node tag attrs [text]))

(define (h1 text) (leaf "h1" no-attrs text))
(define (h2 text) (leaf "h2" no-attrs text))
(define (h3 text) (leaf "h3" no-attrs text))
(define (p text)  (leaf "p"  no-attrs text))

(define (button attrs text)
  (leaf "button" attrs text))

(define (pre attrs text)
  (leaf "pre" attrs text))

(define (textarea attrs text)
  (leaf "textarea" attrs text))

(define (input attrs)
  (node "input" attrs []))

(define (span attrs text)
  (leaf "span" attrs text))

(define (div attrs children)
  (node "div" attrs children))

(define (section attrs children)
  (node "section" attrs children))

(define (details attrs summary children)
  (node "details" attrs
    (Weld [(leaf "summary" no-attrs summary)] children)))

(define (script js)
  (node "script" no-attrs [js]))

(define (script-module src)
  (node "script" [(attr "type" "module") (attr "src" src)] []))

(define (style css)
  (node "style" no-attrs [css]))

(define (hx-button url target text)
  (button
    [(attr "type" "button")
     (cls "list-item")
     (attr "hx-get" url)
     (attr "hx-target" target)]
    text))

(define (list-button text)
  (button [(attr "type" "button") (cls "list-item passive")] text))

(define (browser-pane title content)
  (section [(cls "browser-pane")]
    [(h2 title)
     content]))


;;; Text and value rendering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (str-slice off len src)
  (Trunc (Mul 8 len) (Rsh src (Mul 8 off))))

(define (str-drop off src)
  (str-slice off (Sub (Bytes src) off) src))

(define (str-prefix? pre src)
  (define len (Bytes pre))
  (And (Le len (Bytes src))
       (Eq pre (str-slice 0 len src))))

(define (drop-suffix len str)
  (str-slice 0 (Sub (Bytes str) len) str))

(define (foil-file-stem file)
  (drop-suffix 5 file))

(define (reaver-file-stem file)
  (drop-suffix 4 file))

(define (path-segments target)
  (split-byte "/" (Ix0 (split-byte "?" target))))

(define (path-segment idx segs)
  (If (Gt (Sz segs) idx) (Ix idx segs) 0))

(define (or-default val fallback)
  (If val val fallback))

(define (request-body-start input i)
  (If (Lt (Add i 3) (Bytes input))
    (If (And (Eq 13 (Load8 i input))
          (And (Eq 10 (Load8 (Inc i) input))
            (And (Eq 13 (Load8 (Add i 2) input))
                 (Eq 10 (Load8 (Add i 3) input)))))
      (Add i 4)
      (request-body-start input (Inc i)))
    0))

(define (request-body input)
  (define start (request-body-start input 0))
  (If start (str-drop start input) ""))

(define (print-val val)
  (define (print-pin p)
    (If (IsLaw p)
      (strcat ["#(" (Name p) ")"])
      (strcat ["#pin(" (print-val p) ")"])))
  (define (print-law a m b)
      (strcat ["{" (showNat a) " " (showNat m) " "
             (print-val b) "}"]))
  (define (print-app a)
    (strcat ["(" (print-val (Hd a)) " "
             (join-str " " (map print-val a)) ")"]))
  (cond
    ((IsPin val) (print-pin (Unpin val)))
    ((IsLaw val) (print-law (Arity val) (Name val) (Body val)))
    ((IsApp val) (print-app val))
    (else (showNat val))))


;;; Foil browser shell ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (foil-inspector-shell mod)
  (section [(cls "foil-browser") (attr "data-foil-browser" mod)]
    [(div [(cls "pane-head compact-head")]
       [(div [(cls "pane-title")]
          [(h2 "Definitions")
           (p (strcat ["entries for foil/" mod ".foil"]))])
        (div [(cls "tools")]
          [(span [(cls "status")
                  (attr "data-status" "saved")
                  (attr "data-entry-count" "1")]
             "0 entries")])])
     (div [(cls "entry-browser")]
       [(div [(cls "entry-toolbar")]
          [(input [(attr "type" "search")
                   (attr "placeholder" "filter entries")
                   (attr "data-entry-filter" "1")])])
        (div [(cls "entry-layout")]
          [(div [(cls "entry-list") (attr "data-entry-list" "1")] [])
           (div [(id "entry-detail") (cls "entry-detail-stack")
                 (attr "data-entry-detail" "1")]
             [(pre [(cls "mono")] "Select a Foil entry.")])])])]))


;;; Foil panes ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define foil-files
  ["bst.foil"
   "demo.foil"])

(define (foil-file-link file)
  (define stem (foil-file-stem file))
  (hx-button (strcat ["/foil/" stem]) "#workspace" file))

(define (foil-file-list _)
  (div [(cls "stack")]
    (map foil-file-link foil-files)))

(define (source-editor area mod title source)
  (node "form"
    [(cls "editor-form")
     (attr "method" "post")
     (attr "action" (strcat ["/save/" area "/" mod]))
     (attr "data-editor-form" "1")]
    [(div [(cls "pane-head")]
       [(div [(cls "pane-title")]
          [(h2 title)
           (p (strcat ["protocol: source  category: " area]))])
        (div [(cls "tools")]
          [(span [(cls "status") (attr "data-status" "clean")] "unchanged")
           (button [(attr "type" "submit") (cls "save-button")] "accept")])])
     (node "spine-code-editor"
       [(attr "name" "source")
        (attr "mite" "/text/reaver")
        (attr "vim" "true")
        (attr "lineNumbers" "true")
        (attr "pairMatching" "true")]
       [(node "script" [(attr "type" "text/plain")] [source])])]))

(define (foil-panel mod)
  (define file (strcat ["foil/" mod ".foil"]))
  (section [(cls "pane")]
    [(div [(cls "foil-tool")]
        [(source-editor "foil" mod
          (strcat ["foil/" mod ".foil"])
          (read-text-file file))
        (foil-inspector-shell mod)])]))


