;;;; Real coordinator/worker transport, using a malformed request so no network
;;;; or native Fetch support is needed. A successful completion crosses both
;;;; typed protocol directions and the Foil driver's ordered effect loop.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind helm (#module helm))
(#bind host (#module helm-fetch))
(#bind tests (#module foil-helm-fetch-tests))
(#import tests)
(define core (helm:helm-pack [0 sut]))
(define run-event (app ["run_event"]))
(define (make p t s)
  (define r (run-event ("/boot/task/vine" p ("/boot/writ/make" t)) 0 s))
  (If (Eq "/boot/ovum/ripe" (Hd r)) (_0 r) (error r)))
(define seed (make path new
  (make dpath marker (make [("ts" "io")] new (app ["sov" "new"])))))
(define fetch-run (app ["fetch_driver" "run"]))
(define (mk-worker n) (host:mk-fetch-worker fetch-run n))
(define coord (Seq (DeepSeq [(host:warm 0) seed (mk-worker name)] 0)
  (Spawn (helm:helm-actor core mk-worker (lambda (hm) 0) seed))))
(define (read-record p)
  (Seq (SendCaps coord ("/boot/driver_out/read" p) [0])
    (Ix 0 (Recv 0))))
(define (await-result fuel)
  (define r (read-record path))
  (If (And (Eq "/boot/driver_in/qres" (Hd r))
        (Eq 1 (slot [("ts" "res_done")] 0 (_0 (_1 r)))))
    r
    (Ifz fuel (error "fetch driver did not complete") (await-result (Dec fuel)))))
(define result (await-result 1000))
assert(Eq 0 (slot [("ts" "res_err")] 99 (_0 (_1 result))))
(Seq (SendCaps coord ["stop"] [0]) (Recv 0))
(print "Helm Foil fetch transport tests passed")
