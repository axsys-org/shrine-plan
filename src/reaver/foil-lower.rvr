(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))
(#bind cgen (#module codegen))

;;; Lowered module entries ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (make-ir-entry key span val tc ir)
  ("IR_ENTRY" key span val tc ir))
(define ir-entry-val (Ix 2))
(define ir-entry-tc (Ix 3))
(define ir-entry-ir (Ix 4))

;;; TC lowering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define fold-app cgen:fold-app)

(define (lower-tc sut val)
  (define (tag-is x) (Eq (Hd val) x))
  (define (lower-lam lam)
    (define body (lower-tc sut (tc-lam-body lam)))
    ;; tc-lam-args holds the whole frame (self + args); the PLAN law
    ;; arity is the argument count only.  Flags: pinned, marked, recur.
    (cgen:F yes yes yes "LAM" (Dec (tc-lam-arity val)) body))
  (define (get-row typ[_ tag])
    (define typ1 (If (Eq tag "TFAC") (ty:tfac-val typ) typ))
    (define span[_ stag] (ty:mold-to-span sut typ1))
    (define (tag-is x) (Eq stag x))
    (cond
      ((tag-is "TROW") span)
      (else
        (begin (print ("fallthrough" typ))
          0))))
  (define (get-hd typ)
    (ty:trow-cstr (get-row typ)))
  (define (call1 f a)
    (cgen:A (cgen:K f) a))
  (define (call2 f a b)
    (cgen:A (call1 f a) b))
  (define (call3 f a b c)
    (cgen:A (call2 f a b) c))
  ;; The generated test only checks constructor head + arity.  This is
  ;; sound because elaboration rejects matches over sums whose options
  ;; are indistinguishable by (head, arity) — see check-arms-distinct in
  ;; foil-elab.rvr.
  (define (lower-arm-test pat-ty)
    (define row (get-row pat-ty))
    (define cstr (ty:trow-cstr row))
    (define arity (Sz (ty:trow-vals row)))
    (define val (cgen:V 0))
    (Ifz arity
      (call2 Ne val (cgen:K cstr))
      (call3 If
        (call1 IsApp val)
        (call2 Or
          (call2 Ne (call1 Hd val) (cgen:K cstr))
          (call2 Ne (call1 Sz val) (cgen:K arity)))
        (cgen:K 1))))
  (define (lower-arms fall arms)
    (Ifz arms (lower-tc sut fall)
      (letrec
        ((arm (_0 arms))
         (pat-ty (tc-arm-pat arm))
         (leg-tc (lower-tc sut (tc-arm-val arm)))
         (test-ir (lower-arm-test pat-ty)))
         (cgen:A
           (cgen:A (cgen:A (cgen:K Ifz) test-ir)
             leg-tc)
            (lower-arms fall (drop 1 arms))))))
  (define (lower-match val)
    (cgen:L (lower-tc sut (tc-match-scrut val))
      (lower-arms (tc-match-fall val) (tc-match-arms val))))
  ;; Local bindings lower to nested lets: binding i's value sits inside
  ;; i enclosing lets, matching the one-local-per-binding elaboration.
  (define (lower-let val)
    (define (go bs)
      (Ifz bs
        (lower-tc sut (tc-letrec-body val))
        (cgen:L (lower-tc sut (_0 bs)) (go (drop 1 bs)))))
    (go (tc-letrec-binds val)))
  (define (lower-row row)
    (fold-app
      (cgen:K (tc-row-hd row))
      (map (lower-tc sut) (tc-row-items row))))
  (define (lower-local-path path)
    (define (go acc idx)
      (cgen:A (cgen:A (cgen:K Ix) (cgen:K idx)) acc))
    (foldl go (cgen:V (_0 path)) (drop 1 path)))
  (define (lower-local slot)
    (If (IsApp slot)
      (If (Eq 1 (Sz slot))
        (cgen:V (_0 slot))
        (lower-local-path slot))
      (cgen:V slot)))
  (cond
    ((tag-is "TC_LOCAL")  (lower-local (tc-local-slot val)))
    ((tag-is "TC_GLOBAL") (cgen:G (got-const (tc-global-path val))))
    ((tag-is "TC_LIT")    (cgen:K (tc-lit-val val)))
    ((tag-is "TC_FFI")    (cgen:K (tc-ffi-val val)))
    ((tag-is "TC_APP")    (cgen:A (lower-tc sut (tc-app-f val))
                             (lower-tc sut (tc-app-x val))))
    ((tag-is "TC_LAM")    (lower-lam val))
    ((tag-is "TC_ROW")    (lower-row val))
    ((tag-is "TC_TYP")    (cgen:K val))
    ((tag-is "TC_MATCH")  (lower-match val))
    ((tag-is "TC_LET")    (lower-let val))
    ((tag-is "TC_MEAN")   (cgen:A (cgen:K error) (cgen:K "unreachable")))
    (else (error ("lowering" val)))))

(define (lower-tc-entry ctx out key ent)
  (define tc (tc-entry-contents ent))
  (define ir (lower-tc ctx tc))
  (define span (tc-entry-span ent))
  (define val (cgen:compile-expr ir))
  (define ent1 (make-ir-entry key span val tc ir))
  (insert-entry-sut key ent1 out))

;; FFI entries are already runtime values, type entries have no runtime
;; representation, and IR entries were lowered previously: none of them
;; need (re-)lowering.
(define (lowerable-entry? ent)
  (define tc (tc-entry-contents ent))
  (And (Eq (Hd ent) "TC")
    (Nil (Or (Eq (Hd tc) "TC_FFI") (Eq (Hd tc) "TC_TYP")))))

(define (lower-tc-mod-go ctx sut out)
  (define n[next sut1] (pop-subject-order sut))
  (define entry (got-entry next sut))
  (Ifz (subject-order sut) out
    (let ((out1 (If (lowerable-entry? entry)
                  (lower-tc-entry ctx out next entry)
                  out)))
      (lower-tc-mod-go ctx sut1 out1))))

(define (lower-tc-mod sut out)
  (lower-tc-mod-go sut sut out))
