(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind cairn (#module cairn))
(#import cairn)

(#bind ty (#module foil-types))
(#bind new-ty (#module foil-new-types))
(#bind cgen (#module codegen))
(#bind profile-zone (#module profile-zone))

;;; Lowered module entries ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (make-ir-entry key span val tc ir)
  ("IR_ENTRY" key span val tc ir))

;; Unit-grouped entries do not embed their compiled value directly: the
;; whole group's runtime row (and IR) is serialized behind ONE pin, and
;; each entry stores only ["#group" group-pin index].  Without this
;; boundary every entry pin re-serializes a private copy of the shared
;; dispatcher closure — content-addressed sharing dedupes only at pin
;; boundaries — and a ~30KB module writes tens of MB of store (the
;; global.plan cost model: bound pin churn per update).  The accessors
;; re-derive the projection at each read, so the boundary survives
;; forcing.
(define (group-slot? v)
  (And (IsApp v) (And (Eq 3 (Sz v)) (Eq "#group" (_0 v)))))

(define (entry-slot v)
  (If (group-slot? v) (Ix (_2 v) (Unpin (_1 v))) v))

(define (ir-entry-val ent) (entry-slot (Ix 2 ent)))
(define ir-entry-tc (Ix 3))
(define (ir-entry-ir ent) (entry-slot (Ix 4 ent)))

;;; TC lowering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define fold-app cgen:fold-app)

(define (lower-tc-go resolve-global sut depth val)
  (define (at d x) (lower-tc-go resolve-global sut d x))
  (define recur (at depth))
  (define (tag-is x) (Eq (Hd val) x))
  (define (lower-lam lam)
    ;; The TC frame is self followed by the arguments.  Same-unit global
    ;; slots live outside that whole frame, so their de-Bruijn index advances
    ;; by its complete width while lowering the body.
    (define body
      (at (Add depth (Sz (tc-lam-args lam))) (tc-lam-body lam)))
    ;; tc-lam-args holds the whole frame (self + args); the PLAN law
    ;; arity is the argument count only.  Flags: pinned, marked, recur.
    (cgen:F yes yes yes "LAM" (Dec (tc-lam-arity val)) body))
  (define (call1 f a)
    (cgen:A (cgen:K f) a))
  (define (call2 f a b)
    (cgen:A (call1 f a) b))
  (define (call3 f a b c)
    (cgen:A (call2 f a b) c))
  ;; The generated test walks the arm's key tree ["key" cstr arity
  ;; kids]: constructor head + arity at each node, recursing into
  ;; constrained fields (nested variant patterns) through Ix probes.
  ;; This is sound because elaboration rejects arms an earlier arm's
  ;; key subsumes — see check-arms-distinct in foil-elab.rvr.
  ;; Nonzero result = no match (arms chain through Ifz).
  (define (lower-arm-test key)
    (define (probe val key)
      (define cstr (_1 key))
      (define arity (_2 key))
      (define kid-tests
        (foldl
          (lambda (acc i)
            (let ((k (Ix i (Ix 3 key))))
              (Ifz k acc
                (snoc (probe (call2 Ix (cgen:K i) val) k) acc))))
          [] (gen arity (lambda (i) i))))
      (Ifz arity
        (call2 Ne val (cgen:K cstr))
        (call3 If
          (call1 IsApp val)
          (foldl (lambda (acc t) (call2 Or acc t))
            (call2 Or
              (call2 Ne (call1 Hd val) (cgen:K cstr))
              (call2 Ne (call1 Sz val) (cgen:K arity)))
            kid-tests)
          (cgen:K 1))))
    (Ifz key
      ;; elaboration keys every arm; a keyless arm is a compiler bug,
      ;; not a user error — fail loudly instead of miscompiling.
      (error ("match arm without a dispatch key" key))
      (probe (cgen:V 0) key)))
  (define (lower-arms inner-depth fall arms)
    (Ifz arms (at inner-depth fall)
      (letrec
        ((arm (_0 arms))
         (leg-tc (at inner-depth (tc-arm-val arm)))
         (test-ir (lower-arm-test (tc-arm-key arm))))
         (cgen:A
           (cgen:A (cgen:A (cgen:K Ifz) test-ir)
             leg-tc)
            (lower-arms inner-depth fall (drop 1 arms))))))
  (define (lower-match val)
    ;; Match lowers to one let holding the scrutinee.  Arm bodies and the
    ;; fallthrough therefore see one more lexical slot than the scrutinee.
    (cgen:L (recur (tc-match-scrut val))
      (lower-arms (Inc depth) (tc-match-fall val) (tc-match-arms val))))
  ;; Local bindings lower to nested lets: binding i's value sits inside
  ;; i enclosing lets, matching the one-local-per-binding elaboration.
  (define (lower-let val)
    (define (go d bs)
      (Ifz bs
        (at d (tc-letrec-body val))
        (cgen:L (at d (_0 bs)) (go (Inc d) (drop 1 bs)))))
    (go depth (tc-letrec-binds val)))
  (define (lower-row row)
    (fold-app
      (cgen:K (tc-row-hd row))
      (map recur (tc-row-items row))))
  (define (lower-local-path path)
    (define (go acc idx)
      (cgen:A (cgen:A (cgen:K Ix) (cgen:K idx)) acc))
    (foldl go (cgen:V (_0 path)) (drop 1 path)))
  (define (lower-local slot)
    (If (IsApp slot)
      (If (Eq 1 (Sz slot))
        (cgen:V (_0 slot))
        (lower-local-path slot))
      (cgen:V slot)))
  (cond
    ((tag-is "TC_LOCAL")  (lower-local (tc-local-slot val)))
    ((tag-is "TC_GLOBAL")
      (resolve-global depth (tc-global-path val)))
    ((tag-is "TC_LIT")    (cgen:K (tc-lit-val val)))
    ((tag-is "TC_FFI")    (cgen:K (tc-ffi-val val)))
    ((tag-is "TC_APP")    (cgen:A (recur (tc-app-f val))
                             (recur (tc-app-x val))))
    ((tag-is "TC_LAM")    (lower-lam val))
    ((tag-is "TC_ROW")    (lower-row val))
    ((tag-is "TC_TYP")    (cgen:K val))
    ((tag-is "TC_MATCH")  (lower-match val))
    ((tag-is "TC_LET")    (lower-let val))
    ((tag-is "TC_MEAN")   (cgen:A (cgen:K error) (cgen:K (tc-ty val))))
    (else (error ("lowering" val)))))

;; lower-tc : Subject -> TC -> IR
;; Legacy entry-at-a-time lowering: every global is resolved immediately to
;; the pinned entry already present in the progressively lowered subject.
(define (lower-tc sut val)
  (define (legacy-global depth path)
    (cgen:G (got-const path sut)))
  (lower-tc-go legacy-global sut 0 val))

;; Lowering resolves TC_GLOBAL references from =out= — the subject that
;; accumulates IR entries — so a referee's compiled value is available
;; by the time its referrers lower (declaration order is
;; define-before-use, enforced by elaboration).
(define (lower-tc-entry out key ent)
  (define tc (tc-entry-contents ent))
  (define ir (lower-tc out tc))
  (define span (tc-entry-span ent))
  (define val (cgen:compile-expr ir))
  (define ent1 (make-ir-entry key span val tc ir))
  (insert-entry-sut key ent1 out))

;; Profiling keeps lowering and PLAN code generation separate.  The final
;; subject insertion is intentionally outside either forced zone so we do not
;; repeatedly deep-force the cumulative module subject.
(define (lower-tc-entry-profiled out key ent)
  (define label (print-path key))
  (define tc (tc-entry-contents ent))
  (define ir
    (profile-zone:force-zone (strcat ["foil.lower.ir." label])
      (lower-tc out tc)))
  (define span (tc-entry-span ent))
  (define val
    (profile-zone:force-zone (strcat ["foil.lower.codegen." label])
      (cgen:compile-expr ir)))
  (define ent1 (make-ir-entry key span val tc ir))
  (insert-entry-sut key ent1 out))

;; FFI entries are already runtime values, type entries have no runtime
;; representation, IR entries were lowered previously, and members that
;; reference const generic parameters cannot lower at the base — their
;; instantiations materialize (materialize-consts) and lower instead.
(define (type-const-param-count typ)
  (cond
    ((new-ty:scheme? typ) (new-ty:scheme-const-parameter-count typ))
    ;; New monotypes never carry quantifiers.  Keep the legacy walk wholly on
    ;; legacy values so a stage-0 Path/Fun is not fed to FoilType matching.
    ((new-ty:monotype? typ) 0)
    (else (ty:count-cqua typ))))

(define (const-param-base-tc? tc)
  (Or (tc-has-cparam? tc) (Lt 0 (type-const-param-count (tc-ty tc)))))

(define (lowerable-entry? ent)
  (define tc (tc-entry-contents ent))
  (And (Eq (Hd ent) "TC")
    (Nil (Or (Eq (Hd tc) "TC_FFI")
           (Or (Eq (Hd tc) "TC_TYP")
             (Or (tc-has-cparam? tc)
               (And (Nil (ty-ap-path? (_0 ent)))
                 (Lt 0 (type-const-param-count (tc-ty tc))))))))))

;;; Sealed-unit lowering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; unit-own-lowerable-keys : Subject -> [Path] -> [Path]
;; Normalize caller-supplied keys to the final subject's root, discard type/FFI
;; entries, deduplicate, and sort by content rather than declaration order.
(define (unit-own-lowerable-keys final own-keys)
  (define (canon key)
    (If (get-const key final) key (root-path final key)))
  (define keys (uniq (sort cmp-total (map canon own-keys))))
  (filter
    (lambda (key)
      (let ((ent (get-const key final)))
        (And ent (lowerable-entry? (got-entry key final)))))
    keys))

;; lower-tc-unit-go : Subject -> Subject -> [Path] -> Bool -> Subject
;; Compile all lowerable entries owned by one sealed unit behind one recursive
;; dispatcher law.  Calling the dispatcher produces the canonical member row;
;; a same-unit reference projects from a recursive call through the dispatcher's
;; lexical self.  Unlike PLAN's strict sequential lets, this representation can
;; construct mutually recursive closures without first constructing a cyclic
;; runtime value.  (A letrec (cgen:R) variant was prototyped 2026-07-27 and
;; reverted: it knots genuinely cyclic heap values, which the content-addressed
;; store cannot pin — the acyclicity here is a load-bearing invariant.)
;; Imported references remain pinned G edges through `base`.
(define (lower-tc-unit-go base final own-keys profiled?)
  (define paths (unit-own-lowerable-keys final own-keys))
  (define (slot-of path)
    ;; Runtime erases ordinary type arguments.  Prefer an exact materialized
    ;; const-generic entry, then let a virtual /ty-ap reference share the slot
    ;; of its generic base (the same transparency rule as subject lookup).
    (define direct (find-idx (Equal path) paths))
    (If direct
      direct
      (If (ty-ap-path? path)
        (find-idx (Equal (ty-ap-base path)) paths)
        0)))
  (define (resolve-global depth path)
    (define hit (slot-of path))
    (Ifz hit
      (let ((external? (get-const path base)))
        (Ifz external?
          (error ["foil-lower-unit-unsealed-global" ["path" path]])
          (cgen:G (got-const path base))))
      (let ((unit-row (cgen:A (cgen:V depth) (cgen:K 0))))
        (cgen:A (cgen:A (cgen:K Ix) (cgen:K (_0 hit))) unit-row))))
  (define (lower-one key)
    (define ent (got-entry key final))
    (lower-tc-go resolve-global final 0 (tc-entry-contents ent)))
  (define (lower-all z)
    (map lower-one paths))
  (define binds
    (If profiled?
      (profile-zone:force-zone "foil.lower.unit.ir" (lower-all 0))
      (lower-all 0)))
  (Ifz (Sz paths)
    final
    (let* ((row-body
             (fold-app (cgen:K 0)
               binds))
           ;; At row-body depth zero, V 0 is UNIT's self and V 1 is its
           ;; deliberately unused forcing argument.  Entry-local lambdas add
           ;; their complete frames to the resolver depth above.
           (dispatcher (cgen:F yes yes yes "UNIT" 1 row-body))
           (group-ir (cgen:A dispatcher (cgen:K 0)))
           (values
             (If profiled?
               (profile-zone:force-zone "foil.lower.unit.codegen"
                 (cgen:compile-expr group-ir))
               (cgen:compile-expr group-ir)))
           (values-pin (Pin values))
           (insert-one
             (lambda (out pair[i key])
               (let* ((old (got-entry key final))
                      (tc (tc-entry-contents old))
                      ;; The retained IR is debug metadata with no
                      ;; production consumer, and measured ~20x the
                      ;; size of the compiled code itself: persisting
                      ;; it dominated snapshot mass.  Tooling that
                      ;; wants IR re-lowers the entry's TC on demand.
                      (ent (make-ir-entry key (tc-entry-span old)
                             ["#group" values-pin i] tc 0)))
                 (insert-entry-sut key ent out)))))
      ;; The shared dispatcher is compiled once; every entry stores an indexed
      ;; value and a projection IR suitable for downstream caches/debugging.
      (foldl insert-one final
        (zip (gen (Sz paths) (lambda (i) i)) paths)))))

;; lower-tc-unit : Subject -> Subject -> [Path] -> Subject
;; `base` contains mounted/imported lowered entries; `final` is the sealed,
;; elaborated unit subject; `own-keys` identifies this unit's layer.
(define (lower-tc-unit base final own-keys)
  (lower-tc-unit-go base final own-keys 0))

;; lower-tc-unit-profiled : Subject -> Subject -> [Path] -> Subject
(define (lower-tc-unit-profiled base final own-keys)
  (lower-tc-unit-go base final own-keys 1))

;;; Const-parameter materialization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; A generic member that uses const parameters keeps its base entry as
;; a TC (skipped above).  Every GROUND instantiation referenced
;; anywhere in the module gets a real entry at its full /ty-ap key:
;; the member's TC with the parameters substituted (a placeholder
;; becomes the concrete constant; internal /ty-ap references rewrite
;; their /ty-var segments), inserted into the order immediately before
;; its first referrer, transitive dependencies first.

;; Does a path contain no /ty-var segments (recursively)?
(define (path-ground? p)
  (If (ty-ap-path? p)
    (let ((parts (ty-ap-decode p)))
      (Ifz parts 0 (all path-ground? parts)))
    (Nil (ty-var-path? p))))

;; Rewrite the /ty-var segments of a path per mapping [[name path] ..].
(define (subst-path-args mapping p)
  (cond
    ((ty-var-path? p)
      (let ((hit (find (lambda (m) (Eq (Ix 1 p) (_0 m))) mapping)))
        (Ifz hit p (_1 (_0 hit)))))
    ((ty-ap-path? p)
      (let ((parts (ty-ap-decode p)))
        (Ifz parts p
          (ty-ap-encode (map (lambda (q) (subst-path-args mapping q)) parts)))))
    (else p)))

;; Substitute concrete const arguments into a member's TC.
(define (subst-tc mapping sut tc)
  (define (tag-is x) (And (IsApp tc) (Eq (Hd tc) x)))
  (define recur (subst-tc mapping sut))
  (cond
    ((tag-is "TC_CPARAM")
      (let ((hit (find (lambda (m) (Eq (tc-cparam-name tc) (_0 m))) mapping)))
        (Ifz hit
          (error ["unsubstituted const parameter" (tc-cparam-name tc)])
          (let ((arg (_1 (_0 hit))))
            (If (ty-val-path? arg)
              ;; The literal's singleton type follows the parameter's algebra.
              (let ((v (Ix 1 arg)))
                (tc-lit
                  (If (new-ty:type-value? (tc-ty tc))
                    (new-ty:tconst v)
                    (ty:TNAT v))
                  v))
              (let ((referee (got-entry-tc arg sut)))
                (If (Eq "TC_LAM" (Hd referee))
                  (tc-global (tc-ty referee) arg)
                  referee)))))))
    ((tag-is "TC_GLOBAL")
      (tc-global (tc-ty tc) (subst-path-args mapping (tc-global-path tc))))
    ((tag-is "TC_APP")
      (tc-app (tc-ty tc) (recur (tc-app-f tc)) (recur (tc-app-x tc))))
    ((tag-is "TC_LAM")
      (tc-lam (tc-ty tc) (Ix 1 tc) (tc-lam-args tc) (recur (tc-lam-body tc))))
    ((tag-is "TC_ROW")
      (tc-row (tc-ty tc) (tc-row-hd tc) (map recur (tc-row-items tc))))
    ((tag-is "TC_MATCH")
      (tc-match (tc-ty tc) (recur (tc-match-scrut tc))
        (map recur (tc-match-arms tc))
        (let ((f (tc-match-fall tc))) (Ifz f 0 (recur f)))))
    ((tag-is "TC_ARM")
      (tc-arm (tc-ty tc) (tc-arm-pat tc) (recur (tc-arm-val tc))
        (tc-arm-key tc)))
    ((tag-is "TC_LET")
      (tc-letrec (tc-ty tc) (map recur (tc-letrec-binds tc))
        (recur (tc-letrec-body tc))))
    (else tc)))

;; The ground const-bearing /ty-ap paths a TC references.
(define (const-deps sut x)
  (define (dep? p)
    (And (ty-ap-path? p)
      (And (path-ground? p)
        (Ifz (get-const (ty-ap-base p) sut)
          0
          (const-param-base-tc? (got-entry-tc (ty-ap-base p) sut))))))
  (define (go x)
    (If (IsApp x)
      (If (And (Eq "TC_GLOBAL" (Hd x)) (dep? (tc-global-path x)))
        [(tc-global-path x)]
        (foldl (lambda (acc i) (Weld acc (go (Ix i x))))
          [] (gen (Sz x) (lambda (i) i))))
      []))
  (foldl (lambda (acc d) (If (includes (Equal d) acc) acc (snoc d acc)))
    [] (go x)))

;; Materialize every referenced ground instantiation: walk the order;
;; before each referrer, DFS-insert its (transitive) materializations.
(define (materialize-consts-go sut profiled?)
  ;; materialize-entry :: Cord -> Path -> Ax -> Entry
  ;; Keep cache/linking projection bugs inside the compiler's structured
  ;; diagnostic vocabulary instead of leaking an unlocated `need-fail`.
  (define (materialize-entry phase key ax)
    (define hit (getax key ax))
    (Ifz hit
      (error ["foil-materialize-missing-entry" ["phase" phase] ["path" key]])
      (unpin-soft (_0 hit))))
  (define (member-mapping key)
    (define base (ty-ap-base key))
    (define bentry (materialize-entry "member-mapping" base (_0 sut)))
    (define bty (tc-ty (tc-entry-contents bentry)))
    ;; Parameter names in declaration order, from whichever algebra the
    ;; base's type belongs to.
    (define names
      (If (new-ty:scheme? bty)
        (map new-ty:parameter-name (new-ty:scheme-parameters bty))
        (Weld (ty:tqua-names bty) (map (Ix 0) (ty:cqua-pairs bty)))))
    (zip names (drop 1 (ty-ap-decode key))))
  (define (materialize st key)
    (define ax (_0 st))
    (define done (_1 st))
    (define order (_2 st))
    (cond
      ((includes (Equal key) done) st)
      ;; An imported subject already materialized (and lowered) this
      ;; exact instantiation: reuse its entry.  Overwriting it with a
      ;; fresh TC would lower it a second time and duplicate its key
      ;; in the order.
      ((Ifz (getax key ax) 0 1)
        [ax (snoc key done) order])
      (else
        (let* ((base (ty-ap-base key))
               (bent (materialize-entry "generic-base" base ax))
               (btc (tc-entry-contents bent))
               (mtc0 (subst-tc (member-mapping key) sut btc))
               (mtc (If profiled?
                      (profile-zone:force-zone
                        (strcat ["foil.materialize.const." (print-path key)])
                        mtc0)
                      mtc0))
               (st1 (foldl materialize [ax (snoc key done) order]
                      (const-deps sut mtc))))
          [(putax key (Pin (make-tc-entry key (tc-entry-span bent) mtc))
             (_0 st1))
           (_1 st1)
           (snoc key (_2 st1))]))))
  (define (walk st key)
    (define ent (materialize-entry "subject-order" key (_0 st)))
    (define st1
      (If (Eq (Hd ent) "TC")
        (foldl materialize st (const-deps sut (tc-entry-contents ent)))
        st))
    [(_0 st1) (_1 st1) (snoc key (_2 st1))])
  (define final
    (foldl walk [(_0 sut) [] []] (subject-order sut)))
  (set-subject-order (_2 final) (snap 0 (lambda (z) (_0 final)) sut)))

(define (materialize-consts sut)
  (materialize-consts-go sut 0))

(define (materialize-consts-profiled sut)
  (materialize-consts-go sut 1))

(define (lower-tc-mod-go sut out)
  (define n[next sut1] (pop-subject-order sut))
  (define entry (got-entry next sut))
  (Ifz (subject-order sut) out
    (let ((out1 (If (lowerable-entry? entry)
                  (lower-tc-entry out next entry)
                  out)))
      (lower-tc-mod-go sut1 out1))))

(define (lower-tc-mod sut out)
  (lower-tc-mod-go sut out))

(define (lower-tc-mod-profiled-go sut out)
  (define n[next sut1] (pop-subject-order sut))
  (define entry (got-entry next sut))
  (Ifz (subject-order sut) out
    (let ((out1 (If (lowerable-entry? entry)
                  (lower-tc-entry-profiled out next entry)
                  out)))
      (lower-tc-mod-profiled-go sut1 out1))))

(define (lower-tc-mod-profiled sut out)
  (lower-tc-mod-profiled-go sut out))
