;;;; See LICENSE for full terms.
;;;; grove: the namespace-spec DSL compiled through the tree-fed seam.
;;;; Reader IR asserted as plain rows; the end-to-end oracle is a
;;;; HANDWRITTEN foil module spelling the same constructions in the
;;;; same order (mop insertion order is structural), compiled
;;;; side-by-side and compared with Equal on entry values.

(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rex (#module rex))
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind grove (#module grove))
(#bind quip (#module quip))

(define (check z)
  (define nl 10)
  (define q 34)
  (define (unlines ls)
    (foldl (lambda (acc l) (If acc (strcat [acc nl l]) l)) 0 ls))
  (define (cd s) (strcat [q s q]))

  ;;; Segment spellings ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  assert(Equal "'foo" (grove:gv-seg-content "foo"))
  assert(Equal "'42" (grove:gv-seg-content "42"))
  assert(Equal "'$x!y" (grove:gv-seg-content "$x!y"))
  assert(Equal "'$todo-list" (grove:gv-seg-content "todo-list"))

  ;;; Reader IR: slots, types, clauses, need groups ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  ;;;
  ;;; gv-read -> [roles [root-lash-or-0 arms]]
  ;;;   lash IR [curbs need lede help]

  (define ir1 (grove:gv-read "!  a t | b/c my/ty"))
  assert(Equal [] (Ix 0 ir1))
  (define l1 (Ix 0 (Ix 1 ir1)))
  assert(Equal [[["a"] [["boot" "pails" "t"]]]
                [["b" "c"] [["my" "ty"]]]]
    (Ix 0 l1))
  assert(Equal [[["a"] ["b" "c"]]] (Ix 1 l1))
  assert(Equal [] (Ix 1 (Ix 1 ir1)))

  ;; A ? line types without demanding; union curbs from repeated slots.
  (define ir2 (grove:gv-read (unlines ["?  a t" "!  a u"])))
  (define l2 (Ix 0 (Ix 1 ir2)))
  assert(Equal [[["a"] [["boot" "pails" "t"] ["boot" "pails" "u"]]]]
    (Ix 0 l2))
  assert(Equal [[["a"]]] (Ix 1 l2))

  ;;; Roles: define, meld order, docs ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define role-src
    (unlines
      ["=  described"
       "  !  lede t | about path"
       ""
       "=  actionable described"
       "  '  can be acted on"
       "  !  status t"
       ""
       "+  items actionable"
       ""]))
  (define ir3 (grove:gv-read role-src))
  (define actionable (Ix 1 (Ix 1 (Ix 0 ir3))))
  assert(Equal
    [[["lede"] [["boot" "pails" "t"]]]
     [["about"] [["boot" "pails" "path"]]]
     [["status"] [["boot" "pails" "t"]]]]
    (Ix 0 actionable))
  assert(Equal [[["lede"] ["about"]] [["status"]]] (Ix 1 actionable))
  assert(Equal "can be acted on" (Ix 3 actionable))

  ;; Consecutive slug lines arrive from rex as ONE token joined with a
  ;; LITERAL backslash-n plus the "'  " marker; grove renormalizes to
  ;; real newlines with markers stripped.
  (define ir5 (grove:gv-read (unlines ["=  r" "  '  one two" "  '  three"])))
  assert(Equal (strcat ["one two" 10 "three"])
    (Ix 3 (Ix 1 (Ix 0 (Ix 0 ir5)))))
  ;; the arm melds the citation into its node lash
  (define items-arm (Ix 0 (Ix 1 (Ix 1 ir3))))
  assert(Equal "lit" (Ix 0 items-arm))
  assert(Equal "'items" (Ix 1 items-arm))
  assert(Equal actionable (Ix 0 (Ix 2 items-arm)))

  ;;; Deps and kooks ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define ir4 (grove:gv-read
    (unlines ["+  home"
              "  @  kook/ma ./w/form"
              "&  kook/ma x req"
              "&  ./w/form y"
              "&  fetch"
              "&  serve 9090"])))
  (define home-arm (Ix 0 (Ix 1 (Ix 1 ir4))))
  assert(Equal [["path" [0 ["kook" "ma"]]] ["path" [1 ["w" "form"]]]]
    (Ix 2 (Ix 2 home-arm)))
  assert(Equal [[[0 ["kook" "ma"]] "x" 1]
                [[1 ["w" "form"]] "y" 0]]
    (Ix 2 ir4))
  assert(Equal [["fetch"] ["serve" "9090"]] (Ix 3 ir4))

  ;; %-imports, code# refs, : kook rows
  (define ir7 (grove:gv-read
    (unlines ["-  code %/main"
              "+  a"
              "  :  kook [code#decorate kook/ma ./w/f]"])))
  assert(Equal [["code" "main"]] (Ix 4 ir7))
  (define a-arm (Ix 0 (Ix 1 (Ix 1 ir7))))
  assert(Equal [["code" "code" "decorate"]
                ["path" [0 ["kook" "ma"]]]
                ["path" [1 ["w" "f"]]]]
    (Ix 2 (Ix 2 a-arm)))
  ;; a code ref against an undeclared alias rejects at emission
  (define (lint-rejects? src)
    (Eq 1 (Hd (Try (lambda (z)
                     (let ((r (grove:grove-tree "lintprobe" src)))
                     (DeepSeq r 1)))
              0))))
  assert(Eq 1 (lint-rejects? (unlines
    ["+  a" "  :  kook [ghost#decorate]"])))

  ;; : lines: seed slot values on concrete nodes
  (define ir6 (grove:gv-read
    (unlines ["+  home"
              (strcat [":  status " (cd "live")])
              "+  pen"
              "  :  n 41"
              "  :  about ./home"])))
  (define ir6-node (Ix 1 ir6))
  assert(Equal [[["status"] ["t" "live"]]] (Ix 3 ir6-node))
  (define pen-arm (Ix 1 (Ix 1 ir6-node)))
  assert(Equal [[["n"] ["n" "41"]]
                [["about"] ["p" [1 ["home"]]]]]
    (Ix 3 (Ix 2 pen-arm)))

  ;;; Reader rejections ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  ;; Try: (0 value) on success, (1 payload) on a caught error.
  (define (rejects? src)
    (Eq 1 (Hd (Try (lambda (z) (let ((r (grove:gv-read src))) (DeepSeq r 1)))
              0))))

  assert(rejects? (unlines ["+  a" "  *  ta" "  *  u"]))          ;; two var arms
  assert(rejects? (unlines ["+  a" "+  a"]))                       ;; duplicate lit
  assert(rejects? "+  a ghost")                                    ;; unknown role
  assert(rejects? (unlines ["+  a" "  *  zz"]))                    ;; unknown aura
  assert(rejects? (unlines ["=  r" "=  r"]))                       ;; duplicate role
  assert(rejects? (unlines ["=  r" "  +  kid"]))                   ;; arm inside role
  assert(rejects? "?  a")                                          ;; untyped ? line
  assert(rejects? (unlines ["+  a" "  &  kook/ma"]))               ;; dep inside node
  assert(rejects? (unlines ["=  r" "  @  kook/ma"]))               ;; kook inside role
  assert(rejects? "&  kook/ma w")                                  ;; bad care word
  assert(rejects? "&  fetch extra")                                ;; fetch takes nothing
  assert(rejects? "&  serve")                                      ;; serve needs a port
  assert(rejects? "-  code other/main")                            ;; only %/ imports
  assert(rejects? (unlines ["+  a" "  *  ta" (strcat ["    :  s " (cd "x")])]))
                                                                   ;; : under a var arm
  assert(rejects? (unlines ["=  r" (strcat ["  :  s " (cd "x")])])) ;; : inside a role

  ;;; Seed linting: contract violations reject at BUILD time.
  ;; the ease-typo class: schedule vals present, needed slot misspelled
  assert(Eq 1 (lint-rejects? (unlines
    ["=  recall" "  !  ease n"
     "+  a recall"
     "  :  easy 3"])))
  ;; a val breaking its curb type rejects even alone
  assert(Eq 1 (lint-rejects? (unlines
    ["=  recall" "  !  ease n"
     "+  a recall"
     (strcat ["  :  ease " (cd "three")])])))
  ;; a docs-only scaffold under the same contract stays legal
  assert(Eq 0 (lint-rejects? (unlines
    ["=  recall" "  !  ease n"
     (strcat ["+  a recall " (cd "unfilled scaffold")])])))
  ;; a conforming seed passes
  assert(Eq 0 (lint-rejects? (unlines
    ["=  recall" "  !  ease n"
     "+  a recall"
     "  :  ease 2500"])))
  assert(Eq 0 (Hd (Try (lambda (z)
                         (let ((r (grove:gv-read "!  a"))) (DeepSeq r 1)))
                    0)))                                           ;; bare ! is fine

  ;;; End to end against the handwritten oracle ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define demo-src
    (unlines
      ["=  described"
       "  !  lede t | about path"
       ""
       "=  actionable described"
       "  '  a thing that can be acted on"
       "  !  status t"
       ""
       (strcat ["+  'todo-list " (cd "a todo list")])
       "  ?  title t"
       "  +  items"
       "    *  ta actionable"
       "  +  tags"
       "    *  ta"
       (strcat ["      " (cd "a tag")])
       "      !  title t"
       ""]))

  ;; Only production imports are shared. Generated fixtures keep distinct
  ;; module names and independent new-driver results, so the oracle
  ;; cannot see declarations emitted by the Grove compiler.
  (define imports (_0 (source:compile 0 "tmpl")))
  (DeepSeq imports 0)

  (define sut (_1 (grove:grove-compile-cached imports "grove_demo" demo-src)))
  (DeepSeq sut 0)

  ;; Cold and cached entry points share identity without publishing into inputs.
  (define cold (grove:grove-compile "grove_demo" demo-src))
  assert(Equal ["boot" "grove_demo"] (driver:perc-root cold))
  assert(Equal (driver:get-perc ["spec"] sut) (driver:get-perc ["spec"] cold))
  assert(Equal 0 (driver:get-foil-cache "grove_demo" imports))

  ;; Contract resolution follows every companion import, not just %/main.
  ;; A slot with the same spelling must keep its original namespace path.
  (define custom-cache (source:compile-rex imports "apps/grove_custom/model"
    (rex:ParseRexNormFile (unlines
      ["-  sept" "-  lain_poke" "+  custom" "  :  value=nat"
       "+  accepts" "  \ cb=curb" "  ^  bool" "  (curb_ok cb (custom 7))"
       "+  rejects" "  \ cb=curb" "  ^  bool" "  (curb_ok cb (pd 7))"]))))
  (define custom (_1 (grove:grove-compile-cached (_0 custom-cache) "grove_custom"
    (unlines ["-  code %/model" "+  item" "  !  boot/custom boot/custom"]))))
  (define custom-at (driver:get-perc ["yoke" "at"] custom))
  (define custom-lash (_0 (custom-at [("ts" "item")] (driver:get-perc ["spec"] custom))))
  assert(Equal [("ts" "boot") ("ts" "custom")] (_1 (_1 custom-lash)))
  assert(Equal [[("ts" "boot") ("ts" "apps/grove_custom/model") ("ts" "custom")]]
    (_2 (_1 custom-lash)))
  assert(Equal 1 ((driver:get-perc ["accepts"] custom) (_2 (_1 custom-lash))))
  assert(Equal 0 ((driver:get-perc ["rejects"] custom) (_2 (_1 custom-lash))))

  ;; The same values spelled directly (curb chains outermost-first in
  ;; row order, matching the emitter's foldr).
  (define oracle-src
    (unlines
      ["-  sept [order=10]"
       "-  shrine_types [order=20]"
       ""
       "+  described"
       "  ^  lash"
       "  (lash (mop/empty) (mop/put[path curb lt_pith] ['lede] [['boot 'lain_types 'pails 't]] (mop/put[path curb lt_pith] ['about] [['boot 'pails 'path]] (mop/empty))) [[['lede] ['about]]] 0 0)"
       ""
       "+  actionable"
       "  ^  lash"
       (strcat
         ["  (lash (mop/empty) (mop/put[path curb lt_pith] ['lede] [['boot 'lain_types 'pails 't]] (mop/put[path curb lt_pith] ['about] [['boot 'pails 'path]] (mop/put[path curb lt_pith] ['status] [['boot 'lain_types 'pails 't]] (mop/empty)))) [[['lede] ['about]] [['status]]] 0 "
          (cd "a thing that can be acted on") ")"])
       ""
       "+  spec"
       "  ^  yoke"
       (strcat
         ["  (yoke lash/new [(soma/arm (zeta/lit '$todo-list) (soma (./some (lash (mop/empty) (mop/put[path curb lt_pith] ['title] [['boot 'lain_types 'pails 't]] (mop/empty)) [] "
          (cd "a todo list")
          " 0)) [(soma/arm (zeta/lit 'items) (soma .none [(soma/arm (zeta/var "
          (cd "ta")
          ") (soma (./some actionable) []))])) (soma/arm (zeta/lit 'tags) (soma .none [(soma/arm (zeta/var "
          (cd "ta")
          ") (soma (./some (lash (mop/empty) (mop/put[path curb lt_pith] ['title] [['boot 'lain_types 'pails 't]] (mop/empty)) [[['title]]] "
          (cd "a tag")
          " 0)) []))]))]))] (axal/new[fief] .none))"])
       ""]))

  (define osut (_1 (source:compile-rex imports "grove_oracle"
                   (rex:ParseRexNormFile oracle-src))))
  (DeepSeq osut 0)

  assert(Equal (driver:get-perc ["described"] osut)
    (driver:get-perc ["described"] sut))
  assert(Equal (driver:get-perc ["actionable"] osut)
    (driver:get-perc ["actionable"] sut))
  assert(Equal (driver:get-perc ["spec"] osut)
    (driver:get-perc ["spec"] sut))

  ;;; The app layer: kooks + deps -> tpl + mani ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  ;;;
  ;;; The tpl assertion is a SNAPSHOT of semidoc's unparse (probe-
  ;;; captured); it pins grove's template emission shape end to end --
  ;;; named ids root-relative, attr lines decorating the node below,
  ;;; deps as root kook documentation, one un-named exemplar per var.

  (define wiki-src
    (unlines
      ["-  code %/main"
       ""
       "=  paged"
       "  !  title t"
       ""
       "#  mark_it"
       "  '  stamp a page"
       "  :  paged"
       "  >"
       "    :  d  n"
       "  <"
       "    paged"
       ""
       (strcat ["+  w " (cd "the wiki")])
       "  +  home paged"
       (strcat ["    " (cd "the home page")])
       "    @  kook/ma"
       "    :  kook [code#mark]"
       (strcat ["    :  status " (cd "live")])
       (strcat ["    :  title " (cd "Home")])
       "  *  ta paged"
       "  +  q"
       (strcat ["    " (cd "the page queue")])
       "    :  weft code#pick"
       "    :  limit 3"
       "    :  tack '?/y;%/w"
       ""
       "&  kook/ma x req"
       "&  ./w/form y"
       "&  fetch"
       "&  serve 9090"
       ""]))

  ;; The companion module, compiled into the cache under the app-shaped
  ;; name the %-import resolves to (the tree-fed by-name-import seam).
  (define companion-src
    (unlines
      ["-  sept [order=10]"
       "-  shrine_types [order=20]"
       "-  bond [order=25]"
       "-  shrine [order=30]"
       "-  lain_types [order=38]"
       "-  lain_peek [order=39]"
       "-  lain_poke [order=40]"
       ""
       "+  mark"
       "  ^  form"
       "  def_form"
       ""
       "+  mark_it"
       "  \  input=myth cur=myth"
       "  ^  myth"
       "  cur.meld(input)"
       ""
       "+  pick"
       "  \  nm=myth fat=axal[myth]"
       "  ^  axal[myth]"
       "  fat"
       ""]))
  (define ccache
      (source:compile-rex imports "apps/grove_wiki/main"
        (rex:ParseRexNormFile companion-src)))
  (DeepSeq ccache 0)

  (define wsut (Ix 1 (grove:grove-compile-cached (Ix 0 ccache)
                         "grove_wiki" wiki-src)))
  (DeepSeq wsut 0)

  (define wiki-tpl
    (unlines
      [";@ /doc/kook ;/kook/ma"
       ";@ /doc/kook ;/./w/form"
       ";@ /doc/kook ;/./w"
       ";."
       ""
       "  op mark_it: paged > d n < paged"
       ""
       "  ;@ /doc/kook ;/kook/ward"
       "  ;. /w"
       ""
       "    the wiki"
       ""
       "    ;@ /doc/kook ;/kook/ma"
       "    ;@ /doc/kook ;/./kook/mark"
       "    ;. /w/home"
       ""
       "      the home page"
       ""
       "    ;."
       ""
       "    ;@ /doc/kook ;/kook/fresh"
       "    ;. /w/q"
       ""
       "      the page queue"]))

  assert(Equal wiki-tpl (driver:get-perc ["tpl"] wsut))
  assert(Eq "/boot/pact/mani" (Hd (driver:get-perc ["app"] wsut)))
  ;; grant lines ride as the mani's wants (asks, not decisions)
  assert(Equal ["/boot/pact/grant/gfetch" ("/boot/pact/grant/gserve" 9090)]
    (Ix 4 (driver:get-perc ["app"] wsut)))
  ;; the code# kook minted a decl on the mani
  (define wdecls (Ix 2 (driver:get-perc ["app"] wsut)))
  assert(Eq 1 (Sz wdecls))
  assert(Eq "/boot/pact/kook/decl" (Hd (Ix 0 wdecls)))
  assert(Equal ("ts" "mark") (Ix 0 (Ix 0 wdecls)))
  ;; the yoke rides along: deps keyed under "." (rel) and kook
  (define wspec (driver:get-perc ["spec"] wsut))
  assert(Eq "/boot/shrine_types/yoke" (Hd wspec))

  ;;; Adopted contracts: mani seeds carry ['sys 'lash] where the yoke
  ;;; lashes their paths (tmpl/adopt via tmpl/mani_spec).

  ;; A myth value is a specialized mop: empty is an atom; nodes are apps.
  ;; Walk the nodes for a key (deep Equal).
  (define (mop-has-key? key m)
    (If (IsApp m)
      (Or (Equal key (Ix 1 m))
        (Or (mop-has-key? key (Ix 3 m)) (mop-has-key? key (Ix 4 m))))
      0))

  (define lash-key [(quip:parse-quip "sys") (quip:parse-quip "lash")])
  (define wseeds (Ix 3 (driver:get-perc ["app"] wsut)))
  (define (seed-at p) (find (lambda (s) (Equal p (Ix 0 s))) wseeds))
  (define (lashed? p)
    (define hit (seed-at p))
    (Ifz hit 0 (mop-has-key? lash-key (Ix 1 (_0 hit)))))

  ;; named node with a spec'd lash: adopted
  assert(Eq 1 (lashed? [(quip:parse-quip "w") (quip:parse-quip "home")]))
  ;; the op card mounted at ['op 'mark_it] carrying its op record
  (define op-key [(quip:parse-quip "sys") (quip:parse-quip "op")])
  (define opcard-hit (seed-at [(quip:parse-quip "op") (quip:parse-quip "mark_it")]))
  assert(Eq 1 (mop-has-key? op-key (Ix 1 (_0 opcard-hit))))
  ;; the view node carries its lowered weft + tack + limit
  (define weft-key [(quip:parse-quip "sys") (quip:parse-quip "weft")])
  (define tack-key [(quip:parse-quip "sys") (quip:parse-quip "tack")])
  (define q-hit (seed-at [(quip:parse-quip "w") (quip:parse-quip "q")]))
  assert(Eq 1 (mop-has-key? weft-key (Ix 1 (_0 q-hit))))
  assert(Eq 1 (mop-has-key? tack-key (Ix 1 (_0 q-hit))))
  assert(Eq 1 (mop-has-key? [(quip:parse-quip "limit")] (Ix 1 (_0 q-hit))))
  ;; and its : line melded onto the same seed record
  (define status-key [(quip:parse-quip "status")])
  (define whome-hit (seed-at [(quip:parse-quip "w") (quip:parse-quip "home")]))
  assert(Eq 1 (mop-has-key? status-key (Ix 1 (_0 whome-hit))))
  ;; the root's lash is empty (lash/new): skipped, not adopted
  assert(Eq 0 (lashed? []))
  ;; numbered content under w: prose, no spec: bare
  assert(Eq 0 (lashed? [(quip:parse-quip "w") (quip:parse-quip "0")]))

  ;;; Face vals: 'h;care;path hunt quips and ctor-family weft refs ;;;;;;;;;;;;;;;;;

  (define face-companion-src
    (unlines
      ["-  sept [order=10]"
       "-  shrine_types [order=20]"
       "-  bond [order=25]"
       "-  shrine [order=30]"
       "-  lain_types [order=38]"
       "-  lain_peek [order=39]"
       "-  lain_poke [order=40]"
       ""
       "+  felty"
       "  \  fat=axal[myth]"
       "  ^  myth"
       "  myth/new"
       ""
       "+  dy"
       "  \  t=myth"
       "  ^  myth"
       "  t"
       ""
       "+  pick2"
       "  \  nm=myth fat=axal[myth]"
       "  ^  axal[myth]"
       "  fat"
       ""]))
  (define fcache
      (source:compile-rex imports "apps/grove_face/main"
        (rex:ParseRexNormFile face-companion-src)))
  (DeepSeq fcache 0)

  (define face-src
    (unlines
      ["-  code %/main"
       ""
       (strcat ["+  f " (cd "the face fixture")])
       "  :  sys/face 'h;z;%/f/v"
       "  :  claim 'h;x"
       "  +  v"
       (strcat ["    " (cd "a felt view")])
       "    :  weft felt#felty"
       "    :  demo ./f"
       "  +  d"
       "    :  weft dyed#dy"
       "  +  s"
       "    :  weft code#pick2"
       ""]))
  (define fsut (Ix 1 (grove:grove-compile-cached (Ix 0 fcache)
                         "grove_face" face-src)))
  (DeepSeq fsut 0)

  (define fseeds (Ix 3 (driver:get-perc ["app"] fsut)))
  (define (fseed-at p) (find (lambda (s) (Equal p (Ix 0 s))) fseeds))
  (define (mop-val-of key m)
    (If (IsApp m)
      (If (Equal key (Ix 1 m)) (Ix 2 m)
        (let ((l (mop-val-of key (Ix 3 m))))
          (Ifz l (mop-val-of key (Ix 4 m)) l)))
      0))

  assert(Eq "/boot/shrine_types/safe" (Hd (mop-val-of tack-key (Ix 1 (_0 q-hit)))))

  ;; the hunt landed at ['sys 'face]: a hunt pail, care z, rel path
  (define tf (quip:parse-quip "f"))
  (define face-key [(quip:parse-quip "sys") (quip:parse-quip "face")])
  (define fhunt (mop-val-of face-key (Ix 1 (_0 (fseed-at [tf])))))
  assert(Eq "/boot/shrine_types/hunt" (Hd fhunt))
  assert(Eq "/boot/shrine_types/care/z" (Ix 0 fhunt))
  ;; pact/rel prepended the "." marker; the tail names the ctor node
  (define tdot ("ts" "."))
  assert(Equal [tdot tf (quip:parse-quip "v")] (Ix 1 fhunt))

  ;; a bare 'h;x claim: x care, empty path
  (define fclaim (mop-val-of [(quip:parse-quip "claim")] (Ix 1 (_0 (fseed-at [tf])))))
  assert(Eq "/boot/shrine_types/hunt" (Hd fclaim))
  assert(Eq "/boot/shrine_types/care/x" (Ix 0 fclaim))
  assert(Equal [] (Ix 1 fclaim))

  ;; ctor families: felt#/dyed# mint their ctor, code# stays spun
  (define fweft-key [(quip:parse-quip "sys") (quip:parse-quip "weft")])
  (define (fweft-of kid)
    (mop-val-of fweft-key (Ix 1 (_0 (fseed-at [tf (quip:parse-quip kid)])))))
  assert(Eq "/boot/shrine_types/felt" (Hd (fweft-of "v")))
  assert(Eq "/boot/shrine_types/dyed" (Hd (fweft-of "d")))
  assert(Eq "/boot/shrine_types/spun" (Hd (fweft-of "s")))

  1)

assert(Equal 1 (check 0))
