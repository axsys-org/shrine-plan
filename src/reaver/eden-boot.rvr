;;;; Thin host shim: Eden owns boot policy and all namespace installation.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind actor (#module helm-actor))
(#bind http (#module helm-http))
(#bind eden-http (#module eden-http))

(define compiled (foil:compile-mod-cached 0 foil:default-subject "eden"))
(define sut (_1 compiled))
(define run (foil:source-entry-val ["helm_actor" "run"] sut))
(define boot (foil:source-entry-val ["eden" "boot"] sut))
(define worker (eden-http:worker sut))

(define (start port)
  (define result (boot port))
  (If (Eq "/boot/eden/failed" (Hd result))
    (error ["Eden boot failed" (_0 result) (_1 result)])
    (let ((state (_0 result)))
      (Seq (DeepSeq [state run actor:receive actor:reply actor:attempt
                    actor:report (worker ("ts" "http"))
                    http:listener-pump http:conn-actor] 0)
        (Spawn (actor:actor run worker (lambda (hm) 0) state))))))
(print "Eden compiled")
