;;; Public parsing API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (get-foil fnam)
  (read-text-file (strcat ["foil/" fnam ".foil"])))

;; Profiling spans (wisp --profile-json): force the stage INSIDE the
;; zone so laziness cannot smear attribution.  DeepSeq stops at pins.
(define (zspan lbl v)
  (define h (ZoneStart lbl))
  (Seq h (Seq (DeepSeq v 0) (Seq (ZoneEnd h) v))))

(define (parse-foil fnam)
  (foil-sast:parse-module-sast 0 (rex:ParseRexNormFile (get-foil fnam))))

(define (parse-foil-val txt)
  (foil-sast:parse-val-sast (rex:ParseRexNorm txt)))

;;; Public compatibility aliases ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; default-subject :: Subject
;; Shared typed/runtime substrate for every file-backed compilation.
(define default-subject foil-builtins:default-subject)

;; elab-mod :: Subject -> Row SastRow -> Subject
;; Seals declared and compiler-derived public names before checking bodies.
;; Routes through the stage-1 pipeline (foil-new-elab), deriving its
;; TypeWorld from the subject.  Throwing contract: one error carrying
;; every diagnostic.
(define (elab-mod sut decls)
  (foil-new-elab:compiler-subject
    (foil-new-elab:elab-mod (foil-new-elab:compiler-for sut) decls)))

;; Completed Unit metadata remains the sealed source-resolution authority for
;; live value elaboration.  Its visibility projection also normalizes rooted
;; builtin row brands and nominal aliases without exposing unit-qualified
;; linking storage.
(define (elab-val sut surf)
  (_1 (foil-new-elab:elab-value (foil-new-elab:compiler-for sut) surf)))

;; world-from-subject :: Subject -> TypeWorld — public alias so eval
;; drivers can share one world across an expression storm.
(define world-from-subject foil-new-elab:world-from-subject)

;; elab-val-in :: TypeWorld -> Subject -> Sast -> TC
;;
;; elab-val with a caller-supplied world (see world-from-subject).
(define (elab-val-in world sut surf)
  (_1 (foil-new-elab:elab-value
        (foil-new-elab:compiler-for-with world sut) surf)))

(define make-ir-entry foil-lower:make-ir-entry)
(define ir-entry-val foil-lower:ir-entry-val)
(define ir-entry-tc foil-lower:ir-entry-tc)
(define ir-entry-ir foil-lower:ir-entry-ir)
;; source-entry-val :: Path -> Subject -> Any
;; Resolve a root-relative source spelling through the retained visibility
;; projection before reading its lowered value.  Imported units deliberately do
;; not occupy their historical raw storage paths.
(define (source-entry-val path sut)
  (ir-entry-val
    (foil-subject:got-entry (foil-subject:canon-path path sut) sut)))
(define lower-tc foil-lower:lower-tc)
(define lower-tc-entry foil-lower:lower-tc-entry)
(define lower-tc-mod foil-lower:lower-tc-mod)
;; materialize-consts :: Subject -> Subject
(define materialize-consts foil-lower:materialize-consts)

;;; Imports ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; mod-import? :: SastRow -> Bool
(define (mod-import? row) (Eq "s_import" (_0 row)))

;; mod-decl? :: SastRow -> Bool
(define (mod-decl? row) (Eq "s_decl" (_0 row)))

(define (import-blurb span)
  (Ifz span "unknown-location" ["line" (Ix 0 span) "col" (Ix 1 span)]))

;; Direct import names of a module, by name; [] when the file is
;; missing or unparsable (the compile proper will say why).
(define (module-imports mod)
  (define rowsx
    (Try (lambda (z)
           (map foil-surface:surf-import-modname
             (filter mod-import? (parse-foil mod))))
      0))
  (If (Eq 1 (Hd rowsx)) [] (_0 rowsx)))

;; canonical-path-set :: Row Path -> Row Path
(define (canonical-path-set paths)
  (map (Ix 0)
    (rowify (cairn:tapax
      (foldl (lambda (ax path) (cairn:putax path 1 ax))
        cairn:empty-ax paths)))))

;; The keys a compiled module declared (directly or via its own imports).
;; Subject-order subtraction recovers historical/imported entries, while the
;; retained export layer is authoritative for own entries: an own declaration
;; may replace a builtin and therefore already occur in the baseline order.
;; The baseline entry order as an index.  Computed once: default-subject
;; is fixed for the process, and the per-key linear scan this replaces
;; dominated every cache-entry construction (~15s on shrine alone).
(define default-subject-order-index
  (foldl (lambda (ax path) (cairn:putax path 1 ax))
    cairn:empty-ax
    (foil-subject:subject-order default-subject)))

(define (module-decl-keys imp)
  (define conventional
    (filter
      (lambda (k) (Nil (cairn:getax k default-subject-order-index)))
      (foil-subject:subject-order imp)))
  (define unit (foil-subject:sut-unit imp))
  (define own
    (If (foil-env:unit? unit)
      (map
        (lambda (pair)
          (Weld (foil-subject:sut-root imp) (_0 pair)))
        (foil-env:layer-entries (foil-env:unit-export-layer unit)))
      []))
  (canonical-path-set (Weld conventional own)))

;;; Union-mount compiler projection ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; foil-env is the source-of-truth namespace.  SUT remains the compatibility
;;; projection consumed by the existing type elaborator and PLAN lowerer.  A
;;; separate visibility index prevents the projection's hidden linking entries
;;; from becoming ambient source bindings.

;; strip-surface-spans :: Sast -> Sast
;;
;; Semantic layer identity excludes source locations.  The current parser puts
;; a declaration-wide s_span around each body; recursively stripping these
;; wrappers also future-proofs identity for exact per-reference spans.
(define (strip-surface-spans x)
  (Ifz (IsApp x)
    x
    (If (And (Sz x) (Eq "s_span" (_0 x)))
      (strip-surface-spans (_2 x))
      (gen (Sz x) (lambda (i) (strip-surface-spans (Ix i x)))))))

;; make-own-layer :: Cord -> Row SastRow -> Layer
(define (make-own-layer label rows)
  (foil-env:make-layer label
    (map
      (lambda (decl)
        [(Ix 1 decl)
         (foil-env:note-make (strip-surface-spans (Ix 3 decl)) (Ix 2 decl))])
      (filter mod-decl? rows))))

;; A path row as a cairn AX index — membership at scale (a helm-cone
;; module imports ~1,500 keys; deep-Equal includes-scans there are
;; O(declared x imported)).
(define (path-ax paths)
  (foldl (lambda (ax p) (cairn:putax p 1 ax)) cairn:empty-ax paths))

;; own-keys-from-cache-fields :: [Path] -> [Path] -> [Path]
(define (own-keys-from-cache-fields declared imported)
  (define imp-ax (path-ax imported))
  (filter (lambda (key) (Nil (cairn:getax key imp-ax))) declared))

;; source-key? :: Subject -> Path -> Bool
(define (source-key? sut key)
  (define root (foil-subject:sut-root sut))
  (And (Nil (foil-subject:ty-ap-path? key))
    (Or (Ifz (Sz root) 1 0) (foil-env:path-prefix? root key))))

;; make-export-layer :: Cord -> [Path] -> Subject -> Layer
;;
;; Export-layer bodies are the already-pinned entries.  They are a projection,
;; not part of the unit's semantic identity; the unit envelope keeps both the
;; span-free source layer and this compiled linking view.
(define (make-export-layer label own-keys sut)
  (define root (foil-subject:sut-root sut))
  (foil-env:make-layer label
    (map
      (lambda (key)
        [(drop (Sz root) key)
         (foil-env:note-make (cairn:gotax key (foil-subject:sut-ax sut))
           (foil-subject:get-span key sut))])
      (filter (source-key? sut) own-keys))))

(define RESOLVED-IMPORT "FOIL_RESOLVED_IMPORT")

;; typed-value? :: RowType -> Data -> Bool
(define (typed-value? typ value)
  (And (IsApp value) (Eq (_0 typ) (Hd value))))

;; Compile-internal (never persisted), so a branded newtype row.
;;
;; make-resolved-import :: SastImport -> Subject -> [Path] -> [Path]
;;                      -> Layer -> Layer -> Mount -> Pin -> [Path]
;;                      -> ResolvedImport
(define ResolvedImport
  (trow RESOLVED-IMPORT
    [["sast" tany] ["subject" tany] ["keys" tany] ["own-keys" tany]
     ["layer" tany] ["export-layer" tany] ["mount" tany] ["unit-id" tany]
     ["projected-keys" tany] ["pack" tany] ["row-pin" tany]]))
(define make-resolved-import $ResolvedImport)
(define resolved-import-own-keys ResolvedImport.own-keys)
(define resolved-import-layer ResolvedImport.layer)
(define resolved-import-mount ResolvedImport.mount)
(define resolved-import-unit-id ResolvedImport.unit-id)
(define resolved-import-pack ResolvedImport.pack)
;; the imported row's durable pin: the lazy mount record carries THIS
;; so DeepSeq of a projected subject stops at the mount boundary
(define resolved-import-row-pin ResolvedImport.row-pin)

;;; Per-unit import pack ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Everything a consumer derives from an imported unit that does NOT depend
;;; on the consumer: ownership partition, unit identity, qualified storage
;;; keys, and — the expensive part — the relocated entry clones
;;; (clone-qualified-entry-pin walks every entry's whole TC tree).  Computed
;;; lazily once per cache row and shared by every importer; previously each
;;; consumer redid the clone walk, which dominated the per-module import
;;; envelope (a 19-line app importing the world paid ~9s).

(define (unit-import-pack name imped keys imported)
  (define own (own-keys-from-cache-fields keys imported))
  ;; ownership tested per key below and per TC node inside the clone
  ;; walks — index once, and relocate accepts the AX directly
  (define own-ax (foil-relocate:own-index own))
  (define prior-unit (foil-subject:sut-unit imped))
  (define exports
    (If (foil-env:unit? prior-unit)
      (foil-env:unit-export-layer prior-unit)
      (make-export-layer name own imped)))
  ;; Profiled 2026-08-07: this line, not the clone walks, was the pack's
  ;; dominant cost (1.8s of a 2.6s pack for a 2000-key module).
  ;; unit-mount-layer re-sorts both layers' entries and then make-layer
  ;; sorts the merge — three sorts of an already-ordered row, which was
  ;; quadratic until reef's sort stopped pivoting on the head element.
  (define layer
    (If (foil-env:unit? prior-unit)
      (foil-env:unit-mount-layer prior-unit)
      exports))
  (define unit-id
    (If (foil-env:unit? prior-unit)
      (foil-env:unit-identity prior-unit)
      (foil-env:layer-ref layer)))
  (define qualified-own
    (map (foil-relocate:qualify-canonical-path own-ax unit-id) own))
  (define dependencies
    (filter (lambda (key) (Nil (cairn:getax key own-ax))) keys))
  (define projected (canonical-path-set (Weld dependencies qualified-own)))
  ;; [[qualified-key cloned-pin] ..] for the unit's own storage entries.
  (define own-pairs
    (map
      (lambda (k)
        [(foil-relocate:qualify-canonical-path own-ax unit-id k)
         (foil-relocate:clone-qualified-entry-pin own-ax unit-id
           (cairn:gotax k (Ix 0 imped)))])
      own))
  ;; [[relpath make? pin-or-note canonical] ..] for the export layer.
  (define export-rows
    (map
      (lambda (pair)
        (let ((note (_1 pair)))
          (If (foil-env:note-make? note)
            (let* ((pin
                     (foil-relocate:clone-qualified-entry-pin own-ax unit-id
                       (foil-env:note-body note)))
                   (entry (foil-subject:unpin-soft pin)))
              [(_0 pair) 1 pin (_0 entry)])
            [(_0 pair) 0 note 0])))
      (foil-env:layer-entries exports)))
  ;; Lookup indexes (lazily forced with the pack, shared per unit):
  ;; project-one-mount aliases the qualified and export spellings into
  ;; the consumer head ax through `own-lookup` / `export-lookup`.
  (define own-lookup
    (foldl (lambda (ax pair) (cairn:putax (_0 pair) (_1 pair) ax))
      cairn:empty-ax own-pairs))
  (define export-make-pairs
    (map (lambda (row) [(Ix 3 row) (Ix 2 row)])
      (filter (Ix 1) export-rows)))
  (define export-lookup
    (foldl (lambda (ax pair) (cairn:putax (_0 pair) (_1 pair) ax))
      cairn:empty-ax export-make-pairs))
  ;; export keys colliding with the substrate stay eagerly inserted
  ;; (trie-first lookup would let a builtin win over its replacement)
  (define substrate-shadows
    (filter
      (lambda (pair) (If (cairn:getax (_0 pair) default-subject-order-index) 1 0))
      export-make-pairs))
  [own exports layer unit-id projected export-rows own-lookup export-lookup
   substrate-shadows])

;; The pack stays a plain (headless) row built literally above: a $
;; constructor Seq-forces every field, and pack fields are shared
;; lazy thunks by design.  declare-row names the faces over the same
;; representation.
(declare-row Pack
  [own tany]
  [exports tany]
  [layer tany]
  [unit-id tany]
  [projected tany]
  [export-rows tany]
  [own-lookup tany]
  [export-lookup tany]
  [substrate-shadows tany])
(define pack-own Pack.own)
(define pack-exports Pack.exports)
(define pack-layer Pack.layer)
(define pack-unit-id Pack.unit-id)
(define pack-projected Pack.projected)
(define pack-export-rows Pack.export-rows)
(define pack-own-lookup Pack.own-lookup)
(define pack-export-lookup Pack.export-lookup)
(define pack-substrate-shadows Pack.substrate-shadows)
;; Cache rows stay plain (headless) rows: construction is the literal
;; row6-plus-lazy-tail in cache-entry (the pin/world/sut-pin fields
;; must remain unforced thunks, which a $ constructor would Seq), and
;; hydrated rows from older tooling are narrower than the declared
;; shape — the entry-* accessors below keep their Sz guards.
(declare-row CacheEntry
  [name tany]
  [subject tany]
  [decl-keys tany]
  [imported-keys tany]
  [lore tany]
  [pack tany]
  [pin tany]
  [world tany]
  [sut-pin tany])

(define (require-current-cache e)
  ;; IR_ENTRY v2 carries positioned strict lets. Persisted v1 subjects must
  ;; be rebuilt rather than feeding the old L layout into the new compiler.
  (If (all (lambda (key)
        (let ((ent (foil-subject:got-entry key (CacheEntry.subject e))))
          (Or (Ne "IR_ENTRY" (Hd ent))
            (And (Ge (Sz ent) 6) (Eq 2 (Ix 5 ent))))))
        (CacheEntry.decl-keys e))
    e (error ["foil-cache-version: clear and rebuild cached module" (CacheEntry.name e)])))

;; Cache rows created before the pack field existed (or mirror-shaped rows
;; built by tooling) fall back to computing the pack in place.
(define (entry-pack e)
  ;; a pre-hybrid pack (narrower shape) recomputes in place
  (define held (If (Lt 5 (Sz e)) (CacheEntry.pack e) 0))
  (If (And (IsApp held) (Gt (Sz held) 13))
    held
    (unit-import-pack (CacheEntry.name e) (CacheEntry.subject e)
      (CacheEntry.decl-keys e) (CacheEntry.imported-keys e))))

;; import-mount :: Layer -> SastImport -> Mount
(define (import-mount layer imp)
  (foil-env:make-mount layer
    (foil-surface:surf-import-at imp)
    (foil-surface:surf-import-order imp)
    (foil-surface:surf-import-span imp)))

;; find-resolved-import :: Mount -> Row ResolvedImport -> ResolvedImport
(define (find-resolved-import mount resolved)
  (define ref (foil-env:layer-ref (foil-env:mount-layer mount)))
  (need
    (find (lambda (ri) (Equal ref (foil-env:layer-ref
                              (resolved-import-layer ri))))
      resolved)))

;; project-export-entry :: Path -> [Path] -> Pin -> Note -> Subject -> Subject
(define (project-export-entry written own unit-id note sut)
  (Ifz (foil-env:note-make? note)
    ;; A cull has no compiled entry, but it still occupies source visibility:
    ;; type-only lookup must not fall through to a hidden import or builtin.
    (foil-subject:mark-visible written ["/foil-env/unbound"] sut)
    (let* ((pin
             (foil-relocate:clone-qualified-entry-pin own unit-id
               (foil-env:note-body note)))
           (entry (foil-subject:unpin-soft pin))
           (canonical (_0 entry))
           (sut1 (foil-subject:put-entry-pin canonical pin sut)))
      (foil-subject:mark-visible written canonical sut1))))

;; Hybrid-lazy projection: a mount's entries stay in its pack; the
;; consumer materializes only the substrate-shadow keys and the
;; visibility marks (resolution semantics untouched), appends one
;; lazy mount record, and extends the combined dispatch index with
;; the mount's reachable keys — later mounts overwrite, preserving
;; later-import-wins.  Dependencies resolve transitively through the
;; imported subject; the eager dependency overlay and per-entry
;; storage/export inserts are gone.

;; project-one-mount :: Row ResolvedImport -> Subject -> Mount -> Subject
(define (project-one-mount resolved sut mount)
  (define ri (find-resolved-import mount resolved))
  (define own (resolved-import-own-keys ri))
  (define unit-id (resolved-import-unit-id ri))
  (define pack (resolved-import-pack ri))
  ;; eager residue 1: import exports that replace a substrate key
  (define sut1
    (zspan "p-shadows"
      (foil-subject:put-entry-pins (pack-substrate-shadows pack) sut)))
  (define prefix (Weld (foil-subject:sut-root sut1) (foil-env:mount-at mount)))
  ;; Culls live in the symbolic mount layer; compiled makes live in the export
  ;; layer.  Apply the former first so a later make/revival can replace it.
  (define with-culls
    (foldl
      (lambda (acc pair)
        (If (foil-env:note-cull? (_1 pair))
          (project-export-entry (Weld prefix (_0 pair)) own unit-id (_1 pair) acc)
          acc))
      sut1 (foil-env:layer-entries (resolved-import-layer ri))))
  ;; visibility marks stay fully materialized (canon-path and the
  ;; method-resolution inverse are untouched by laziness)
  (define export-rows (pack-export-rows pack))
  (define with-marks
    (Seq (Trace ["p-mount" (foil-env:mount-at mount) "exports" (Sz export-rows)] 0)
      (zspan "p-marks"
        (foldl
          (lambda (acc row)
            (let ((written (Weld prefix (_0 row))))
              (Ifz (_1 row)
                ;; A cull occupies source visibility without a compiled entry.
                (foil-subject:mark-visible written ["/foil-env/unbound"] acc)
                (foil-subject:mark-visible written (Ix 3 row) acc))))
          with-culls export-rows))))
  ;; entries themselves ride the chain layer spliced by
  ;; project-mounts-base; what the chain cannot answer are the
  ;; unit-qualified and export SPELLINGS the slot-8 own/export lookups
  ;; used to serve — alias their pinned entries into the head ax
  ;; (navigation only, no order join, the graft-subject pattern)
  (snap 0
    (lambda (ax)
      (foldl (lambda (a pair) (cairn:putax (_0 pair) (_1 pair) a)) ax
        (Weld (rowify (cairn:tapax (pack-own-lookup pack)))
          (rowify (cairn:tapax (pack-export-lookup pack))))))
    with-marks))

;; mark-substrate-visible :: Subject -> Subject
;;
;; The subject supplied by the caller is the trusted compiler/runtime
;; substrate.  Snapshot its source-visible entries before hidden import
;; storage is overlaid, so an explicit visibility miss can never fall through
;; to a transitive import that happens to use an unrooted canonical key.
(define (mark-substrate-visible sut)
  ;; A compiled subject is itself an immutable environment value suitable as
  ;; the base of the next REPL turn.  Its explicit aliases are authoritative;
  ;; rebuilding them from storage order would drop prefix mounts and expose
  ;; hidden linking keys.  Only legacy/builtin subjects need reconstruction.
  (If (foil-subject:sut-visible sut)
    sut
    (let ((root (foil-subject:sut-root sut)))
      (foldl
        (lambda (acc key)
          (let* ((entry (foil-subject:got-entry key sut))
                 (canonical (_0 entry))
                 (written
                   (If (foil-env:path-prefix? root key) key (Weld root key))))
            (foil-subject:mark-visible written canonical acc)))
        (foil-subject:set-sut-visible cairn:empty-ax sut)
        (foil-subject:subject-order sut)))))

;; mark-substrate-into :: Subject -> Subject -> Subject
;;
;; Copy the base subject's naming authority into a fresh chain head:
;; a compiled base's explicit vis pairs verbatim, a bare builtin
;; base's identity marks rebuilt from its storage order — the
;; head-relocated twin of mark-substrate-visible.
(define (mark-substrate-into base head)
  (define bvis (foil-subject:sut-visible base))
  (If bvis
    (foldl
      (lambda (acc pair)
        (foil-subject:mark-visible (_0 pair) (_1 pair) acc))
      head (rowify (cairn:tapax bvis)))
    (let ((root (foil-subject:sut-root base)))
      (foldl
        (lambda (acc key)
          (let* ((entry (foil-subject:got-entry key base))
                 (canonical (_0 entry))
                 (written
                   (If (foil-env:path-prefix? root key) key (Weld root key))))
            (foil-subject:mark-visible written canonical acc)))
        head (foil-subject:subject-order base)))))

;; make-substrate-layer :: Subject -> Layer
;;
;; Convert the caller-supplied compiler/runtime substrate into the explicit
;; bottom namespace layer used for sealed source resolution, provenance, and
;; unit identity.  The visibility projection already deduplicates aliases at
;; their written paths; layer bodies retain the exact pinned entries.
(define (make-substrate-layer sut)
  (define rooted (mark-substrate-visible sut))
  (define root (foil-subject:sut-root sut))
  (foil-env:make-layer ["foil-core" (Pin sut)]
    (map
      (lambda (pair)
        (let* ((written (_0 pair))
               (canonical (_1 pair))
               (relative
                 (If (foil-env:path-prefix? root written)
                   (drop (Sz root) written)
                   written)))
          [relative
           (foil-env:note-make (foil-subject:got-const canonical sut)
             (foil-subject:get-span canonical sut))]))
      (rowify (cairn:tapax (foil-subject:sut-visible rooted))))))

;; project-mounts-base :: Subject -> Row ResolvedImport -> Row Mount -> Subject
;;
;; The import-derived part of the compile world: every mount landed
;; (storage shadows, visibility marks, the inverse) plus the sealed
;; dispatch.  A pure function of (substrate, the mounts' unit
;; contents, the mount prefixes, order) and NOTHING of the consuming
;; module's own declarations — which is what makes it memoizable per
;; consumer (the #world rows compile-rex-go-sub threads through the
;; cache): recompiling a module whose imports did not change skips
;; the whole ~50k-key reassembly (measured 5.5s for chat).
(define (project-mounts-base sut0 resolved mounts)
  ;; Layered imports (slot 8's dispatch/mount records are retired):
  ;; each resolved import's compiled subject becomes one chain layer
  ;; under a fresh head; later mounts splice nearer the head, which is
  ;; the dispatch's old newest-first / later-import-wins rule.  Entry
  ;; lookup, visibility, and the TypeWorld all walk the chain.
  ;; Substrate visibility rides the base layer's own index (vis-find
  ;; probes it through the chain).
  (define vmounts (foil-env:validate-mounts mounts))
  ;; prev = each import's SHARED cache pin (row-pin = entry-sut-pin),
  ;; later-import-first, with the substrate pinned last so a zero-import
  ;; module still reaches it.  No spine rebuild — diamonds share.
  (define prev-pins
    (Weld
      (rev (map
             (lambda (mount)
               (resolved-import-row-pin (find-resolved-import mount resolved)))
             vmounts))
      [(Pin sut0)]))
  ;; visibility is HEAD state: copy the substrate's naming authority
  ;; into the fresh head (a compiled base's own vis is authoritative;
  ;; a bare builtin base rebuilds from its storage order)
  (define head
    (mark-substrate-into sut0 (foil-subject:head-onto-pins prev-pins sut0)))
  ;; per-mount eager residue (substrate shadows, culls) and the
  ;; written->canonical visibility marks land in the fresh head
  (foldl (project-one-mount resolved) head vmounts))

;; project-own :: Subject -> Row SastRow -> Subject
;;
;; The whole own layer is visible before any body elaborates: the sealed
;; fixpoint world.  elab-mod's prototype pass supplies the storage entries.
(define (project-own mounted decls)
  (zspan "p-own"
    (foldl
      (lambda (sut decl)
        (let ((path (foil-subject:root-path sut (Ix 1 decl))))
          (foil-subject:mark-visible path path sut)))
      mounted (filter mod-decl? decls))))

;; project-mounts :: Subject -> Row ResolvedImport -> Row Mount -> Row SastRow -> Subject
(define (project-mounts sut0 resolved mounts decls)
  (project-own (project-mounts-base sut0 resolved mounts) decls))

;; NOTE (2026-08-21): a per-consumer memo of project-mounts-base (the
;; "#world" cache rows) was built and REVERTED here.  The hit path
;; worked (chat recompile 18s -> 11s), but on kernel rebuilds the
;; memoized-world plumbing sent commits into multi-minute pl_eq_deep
;; walks (value-identical, pointer-fresh worlds defeat Equal's ptr
;; fast path) and 10GB RSS.  The memo needs runtime-level cheap value
;; identity first: a working RefEq primop (the name resolves to an
;; UNIMPLEMENTED primop and a call kills the actor — that was the
;; "deadlocked serve"), pin-hash-at-alloc, or interning.  See the
;; sync-time notes in doc/ and the project-mounts-base split, which
;; remains (it is the memoizable boundary when this returns).

;; retain-warnings :: Row Warning -> Any -> Any
(define (retain-warnings warnings value)
  (foldl
    (lambda (out warning)
      (Seq (Trace ["FOIL WARNING" warning] 0) out))
    value warnings))

;; subject-warnings :: Subject -> Row Warning
(define (subject-warnings sut)
  (define unit (foil-subject:sut-unit sut))
  (If (foil-env:unit? unit) (foil-env:unit-warnings unit) []))

;; emit-subject-warnings :: Subject -> Subject
;;
;; Cache hits must pass through the same retained diagnostic boundary as cold
;; compiles.  Keeping unit extraction here avoids three subtly different cache
;; paths learning the retained-unit representation independently.
(define (emit-subject-warnings sut)
  (retain-warnings (subject-warnings sut) sut))

;; Compile a module by name, resolving its imports first.  Imports are
;; order-independent: all of them merge (and mount, when nested under a
;; +) before any declaration elaborates.  cache is
;; [[name subject decl-keys imported-keys lore] ..] so diamond imports
;; compile once and a hit pays neither the recompile nor the decl-key
;; derivation; stack is the import chain, for cycle detection.
;; Returns [cache' compiled imported-keys lore].
(define (cache-entry name compiled imported lore)
  (define keys (zspan "c-declkeys" (module-decl-keys compiled)))
  ;; The pack rides the row lazily: it computes on first import and is
  ;; shared by every later consumer threading this cache.
  ;; The PIN rides last: the entry's six durable fields (pack
  ;; included, so a hydrated row keeps the shared forced pack),
  ;; deep-forced — thunks must not hide inside a durable entry — and
  ;; pinned, so the whole row can land in stores that dedup and
  ;; persist by pin: the namespace write-through path.  Lazy: an
  ;; interactive compile that never pins never forces the pack here.
  ;; Additive: nothing indexes past the pack.
  (define pack
    (zspan "c-pack" (unit-import-pack name compiled keys imported)))
  (define row6 [name compiled keys imported lore pack])
  ;; index 7: the module's TypeWorld, lazily shared like the pack —
  ;; OUTSIDE the pin and never DeepSeq'd at construction, so it costs
  ;; nothing until an eval driver reads it (and then only once per
  ;; row).
  (Weld row6
    [(zspan "c-pin" (Seq (DeepSeq row6 0) (Pin row6)))
     (foil-new-elab:world-from-subject compiled)
     ;; index 8: the SUBJECT's own pin, lazily shared — the lazy mount
     ;; records carry this (content-addressed on the subject alone, so
     ;; every compile path that produces the same subject produces the
     ;; same mount record)
     (Pin compiled)]))

;; The entry's durable fields as a pin; rows from older tooling pin
;; in place.  (Unpin (entry-pin e)) round-trips to a pack-bearing
;; six-field row — Weld the pin back on to recover the full entry.
(define (entry-pin e)
  (If (Lt 6 (Sz e))
    (CacheEntry.pin e)
    (Pin e)))

;; The row's lazily shared TypeWorld; pre-world rows derive unfshared.
(define (entry-world e)
  (If (Gt (Sz e) 7)
    (CacheEntry.world e)
    (foil-new-elab:world-from-subject (CacheEntry.subject e))))

;; The row's lazily shared subject pin; older rows pin in place.
(define (entry-sut-pin e)
  (If (Gt (Sz e) 8)
    (CacheEntry.sut-pin e)
    (Pin (CacheEntry.subject e))))

;; compile-rex-go-sub :: ByNameCompiler -> [Cord] -> Cache
;;                    -> [MarkedSubject Layer] -> [MarkedSubject Layer]
;;                    -> Cord -> Rex -> Result
;; The tree-fed compile seam: rexn is an already-parsed normalized rex
;; tree (the module's whole source), so generated modules (schemagen)
;; compile without ever existing as text.  compile-sub is the by-name
;; compiler used for imports — parameterized to avoid a forward
;; reference to compile-mod-go-sub (the rex-normalize-juxt pattern).
;; pair0 is this module's substrate (marked subject + layer); dpair is
;; the default-subject substrate every import compile starts from.
;; See compile-mod-go below for the threading rationale.
(define (compile-rex-go-sub compile-sub stack cache0 pair0 dpair mod rexn)
  (define sut0 (_0 pair0))
  (define rows (zspan "c-sast" (foil-sast:parse-module-sast 0 rexn)))
  (define lore (zspan "c-lore" (foil-lore:capture-lore rexn)))
  (define imps (filter mod-import? rows))
  (define decls (filter (lambda (r) (Nil (mod-import? r))) rows))
  ;; Resolve imports to completed unit values first.  No namespace mutation
  ;; occurs during this walk; the pure foil-env fold happens after every layer
  ;; reference is known.
  (define (resolve-import st imp)
    (define cache (_0 st))
    (define resolved (_1 st))
    (define seen (_2 st))
    (define span (foil-surface:surf-import-span imp))
    (define name (foil-surface:surf-import-modname imp))
    (define blurb (import-blurb span))
    (define hit (find (lambda (e) (Eq name (CacheEntry.name e))) cache))
    ;; The imported module compiles under a Try so its failure carries
    ;; its name: ["foil-in-module" name err].  Chains nest — a failure
    ;; three imports deep reads in-module a > in-module b > the error.
    (define (compile-import z)
      (compile-sub (snoc name stack) cache dpair dpair name))
    (If (includes (Eq name) stack)
      (error ["foil-import-cycle" ["module" name] ["at" blurb]])
      (let* ((r (Ifz hit
                  (let ((c (Try compile-import 0)))
                    (If (Eq 1 (Hd c))
                      (error ["foil-in-module" name (_0 c)])
                      (let ((e (cache-entry name (_1 (_0 c)) (_2 (_0 c))
                                 (_3 (_0 c)))))
                        [(snoc e (_0 (_0 c))) e])))
                  [cache (require-current-cache (_0 hit))]))
             (e (_1 r))
             (imped (CacheEntry.subject e))
             (keys (CacheEntry.decl-keys e))
             ;; Unit-fixed derivations come from the row's shared pack —
             ;; computed once per unit, not once per consumer.
             (pack (entry-pack e))
             (own (pack-own pack))
             (exports (pack-exports pack))
             (layer (pack-layer pack))
             (mount (import-mount layer imp))
             (unit-id (pack-unit-id pack))
             (projected (pack-projected pack))
             (ri
               (make-resolved-import imp imped keys own layer exports mount
                 unit-id projected pack (entry-sut-pin e))))
        [(_0 r) (snoc ri resolved) (Weld seen projected)])))
  (define resolved-state (foldl resolve-import [cache0 [] []] imps))
  (define resolved (_1 resolved-state))
  (define mounts (map resolved-import-mount resolved))
  ;; make-layer rejects duplicate own paths and normalizes same-layer culls
  ;; before anything is projected or elaborated.
  (define own-layer (make-own-layer mod decls))
  (define substrate-layer (_1 pair0))
  (define environment
    (zspan "c-env"
      (foil-env:build-environment-with-base substrate-layer mounts own-layer)))
  (define pre
    (zspan "c-project"
      (foil-subject:set-sut-unit environment
        (project-mounts sut0 resolved mounts decls))))
  ;; Force the lore here so the cache entry carries plain data — an
  ;; unforced capture would pin the module's whole rex tree in every
  ;; long-lived cache.
  (define elabbed
    ;; Mount validation and the pure merge are part of compilation, not lazy
    ;; metadata attached to its result.  Force the sealed environment while
    ;; compile-mod's error boundary is active so malformed headers cannot
    ;; escape later when tooling first inspects the retained Unit.
    (DeepSeq lore (DeepSeq environment (zspan "c-elab" (elab-mod pre decls)))))
  ;; Materialize every referenced ground instantiation of const-param
  ;; generics before lowering (their base members skip lowering).
  (define final (zspan "c-consts" (foil-lower:materialize-consts elabbed)))
  (define declared
    (map (lambda (d) (foil-subject:root-path final (Ix 1 d)))
      (filter mod-decl? decls)))
  (define delta
    (zspan "c-delta" (foil-subject:subject-entry-delta pre final)))
  (define own-keys
    (zspan "c-ownkeys"
      (canonical-path-set (Weld declared (map (Ix 0) delta)))))
  ;; lower-tc-unit is the fixpoint-aware path; until a module actually has an
  ;; internal cycle it is behaviorally identical to the historical fold.
  (define lowered
    (zspan "c-lower" (foil-lower:lower-tc-unit pre final own-keys)))
  (define exports (zspan "c-exports" (make-export-layer mod own-keys lowered)))
  (define unit0
    (foil-env:make-unit-with-base mod substrate-layer mounts own-layer exports))
  (define draft-environment (foil-subject:sut-unit lowered))
  (define unit
    (If (foil-env:environment? draft-environment)
      ;; Retain the exact sealed environment, including compiler-derived own
      ;; declarations.  Rebuilding from mounts alone would preserve reference
      ;; rows but make resolve/replay forget those generated bindings.
      (foil-env:unit-with-environment draft-environment unit0)
      unit0))
  (define compiled
    ;; durable boundary: derived state (vis inverse, write log) is
    ;; retired/per-compiler now, so the pinned form is just the lowered
    ;; subject with its sealed unit
    (foil-subject:set-sut-unit unit lowered))
  [(_0 resolved-state)
   (zspan "c-warn" (emit-subject-warnings compiled))
   (_2 resolved-state)
   lore])

;; The by-name seam: parse-foil's two steps inlined so the raw rex is
;; in scope for lore capture (doc/shrine-apps.md section 4.1) without a
;; second parse.
(define (compile-mod-go-sub stack cache0 pair0 dpair mod)
  (compile-rex-go-sub compile-mod-go-sub stack cache0 pair0 dpair mod
    (rex:ParseRexNormFile (get-foil mod))))

;; The compile entry point: mark the caller's substrate and derive its
;; layer ONCE, then thread both through the whole import chain.  Import
;; compiles always start from default-subject, so the chain shares one
;; lazily-computed default pair instead of re-marking the substrate and
;; re-deriving (and re-pinning) its layer once per module — a measured
;; ~0.5s per chain module.  Threading is by argument, deliberately: a
;; process-global marked default-subject broke the bare elab-mod path,
;; and identity guards are unavailable (PLAN Eq is shallow, Equal has
;; no pointer fast path).
(define (compile-mod-go stack cache0 sut0 mod)
  (define marked0 (mark-substrate-visible sut0))
  (define pair0 [marked0 (make-substrate-layer marked0)])
  ;; Lazy: forced only when a cold import actually compiles.  When sut0
  ;; is default-subject (every production caller) this recomputes the
  ;; same pair once per top-level compile — the price of not having an
  ;; identity test — and every deeper chain module then shares it.
  (define dmarked (mark-substrate-visible default-subject))
  (define dpair [dmarked (make-substrate-layer dmarked)])
  (compile-mod-go-sub stack cache0 pair0 dpair mod))

;;; Public compile API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (compile-mod sut mod)
  (define r (Try (lambda (z) (compile-mod-go [mod] 0 sut mod)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    (_1 (_0 r))))

;; Compile with a persistent cache: returns [cache' compiled].  The
;; cache ([[name subject decl-keys imported-keys lore] ..], seed with 0)
;; carries every compiled module's subject ACROSS calls, so sibling
;; top-level compiles sharing an import chain (helm + lainapp over
;; sept/shrine/lain) walk it once, and re-requesting a cached module
;; returns it outright.  Entries are compiled against default-subject
;; — only thread the cache between compiles that also start from it.
(define (compile-mod-cached cache sut mod)
  (define hit (find (lambda (e) (Eq mod (CacheEntry.name e))) cache))
  (Ifz hit
    (let ((r (Try (lambda (z) (compile-mod-go [mod] cache sut mod)) 0)))
      (If (Eq 1 (Hd r))
        (error ["foil-in-module" mod (_0 r)])
        [(snoc (cache-entry mod (_1 (_0 r)) (_2 (_0 r)) (_3 (_0 r)))
           (_0 (_0 r)))
         (_1 (_0 r))]))
    [cache (emit-subject-warnings (CacheEntry.subject (require-current-cache (_0 hit))))]))

;; Compile an already-parsed normalized rex tree as the module named
;; mod.  The tree-fed twin of compile-mod: generated modules (schemagen)
;; hand their trees straight to the compiler — no text, no file.
;; Imports named by the tree resolve by name as usual.
(define (compile-rex-go stack cache0 sut0 mod rexn)
  (define marked0 (mark-substrate-visible sut0))
  (define pair0 [marked0 (make-substrate-layer marked0)])
  (define dmarked (mark-substrate-visible default-subject))
  (define dpair [dmarked (make-substrate-layer dmarked)])
  (compile-rex-go-sub compile-mod-go-sub stack cache0 pair0 dpair mod rexn))

(define (compile-rex sut mod rexn)
  (define r (Try (lambda (z) (compile-rex-go [mod] 0 sut mod rexn)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    (_1 (_0 r))))

;; The cached twin: threads the same cache rows as compile-mod-cached,
;; so a generated module can be imported BY NAME by later compiles
;; sharing the cache (tree-fed modules have no file to re-read).
;; -> [cache' compiled].
(define (compile-rex-cached cache sut mod rexn)
  (define hit (find (lambda (e) (Eq mod (CacheEntry.name e))) cache))
  (Ifz hit
    (let ((r (Try (lambda (z) (compile-rex-go [mod] cache sut mod rexn)) 0)))
      (If (Eq 1 (Hd r))
        (error ["foil-in-module" mod (_0 r)])
        [(snoc (cache-entry mod (_1 (_0 r)) (_2 (_0 r)) (_3 (_0 r)))
           (_0 (_0 r)))
         (_1 (_0 r))]))
    [cache (emit-subject-warnings (CacheEntry.subject (require-current-cache (_0 hit))))]))

;; The cached compile-mod-info: [cache' [compiled imported-keys lore]].
(define (compile-mod-info-cached cache sut mod)
  (define hit (find (lambda (e) (Eq mod (CacheEntry.name e))) cache))
  (Ifz hit
    (let ((r (Try (lambda (z) (compile-mod-go [mod] cache sut mod)) 0)))
      (If (Eq 1 (Hd r))
        (error ["foil-in-module" mod (_0 r)])
        [(snoc (cache-entry mod (_1 (_0 r)) (_2 (_0 r)) (_3 (_0 r)))
           (_0 (_0 r)))
         [(_1 (_0 r)) (_2 (_0 r)) (_3 (_0 r))]]))
    [cache [(emit-subject-warnings (CacheEntry.subject (require-current-cache (_0 hit))))
            (CacheEntry.imported-keys (_0 hit)) (CacheEntry.lore (_0 hit))]]))

(define (module-closure mods)
  (define (go seen pending)
    (Ifz (Sz pending)
      seen
      (let* ((mod (_0 pending))
             (rest (drop 1 pending)))
        (If (includes (Eq mod) seen)
          (go seen rest)
          (go (snoc mod seen) (Weld rest (module-imports mod)))))))
  (go [] mods))

;; The .foil file paths of some modules' transitive import closure.
;; The corpus tiers hand these to the module loader as their
;; module-file-stamps declaration: the tier's cached value then
;; invalidates when any source it compiled changes, instead of
;; freezing a stale world into the snapshot (the dep-blind corpus
;; cache).
(define (foil-closure-files mods)
  (map (lambda (m) (strcat ["foil/" m ".foil"]))
    (module-closure mods)))

;;; Entry inspection ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A subject entry decomposed either way it is stored.  Const-generic
;; base members skip lowering and stay ("TC" key tc span); everything
;; else is an IR_ENTRY.
(define Ent
  (trow "ENT"
    [["path" tany] ["tc" tany] ["span" tany]
     ["ir" tany] ["val" tany] ["lowered" tany]]))

(define (entry-parts sut path)
  (define ent (foil-subject:got-entry path sut))
  (If (Eq (Hd ent) "IR_ENTRY")
    ($Ent path (foil-lower:ir-entry-tc ent) (Ix 1 ent)
      (foil-lower:ir-entry-ir ent) (foil-lower:ir-entry-val ent) 1)
    ($Ent path (foil-subject:tc-entry-contents ent)
      (foil-subject:tc-entry-span ent) 0 0 0)))

(define ent-tc Ent.tc)
(define ent-span Ent.span)
(define ent-val Ent.val)
(define ent-lowered Ent.lowered)

(define (entry-kind sut path tc)
  (define hd (Hd tc))
  (cond
    ((Eq hd "TC_TYP")
      (If (Eq "TSUM" (ty:type-tag (ty:ttyp-type (foil-subject:tc-typ-inner tc))))
        "sum type"
        "row type"))
    ((Eq hd "TC_LAM") "function")
    ((Eq hd "TC_FFI") "generated")
    ((Eq hd "TC_LIT") "literal")
    ((Eq hd "TC_ROW") "value")
    ((Eq hd "TC_LET") "value")
    ((Eq hd "TC_APP") "value")
    (else "entry")))

;; An entry's own source text, from its span's offset/len into the
;; module source.
(define (source-slice src espan)
  (define off (Ix 2 espan))
  (define len (Ix 3 espan))
  (If len (Trunc (Mul 8 len) (Rsh src (Mul 8 off))) ""))

;; Compile several modules in parallel actors, one future per module,
;; each deep-forced in its child. Deterministic: results are Equal to
;; sequential compile-mod output. Needs enki with the actor-request
;; fix (merged July 2026; doc/enki-actor-report.md).
(define (compile-mods-par mods)
  (async:async-all-deep (lambda (m) (compile-mod default-subject m)) mods))

;; Parallel CACHED compiles: each module in its own actor against the
;; same immutable base cache (so an already-compiled import chain is a
;; hit in every actor), results merged in mods order.  Deterministic:
;; compiles are deterministic, so a dependency reached from two actors
;; produces Equal rows and first-occurrence merge is sound.  Each
;; module runs under its own Try — a failure costs that module only.
;; -> [cache' failed-mods], the compile-roster shape.
;; Merge legacy cache rows by module name, keeping the base's row on a
;; collision (the rows describe the same compile; first seen wins).
(define (legacy-cache-merge base more)
  (foldl
    (lambda (acc e)
      (If (includes (lambda (x) (Eq (CacheEntry.name e) (CacheEntry.name x)))
            acc)
        acc
        (snoc e acc)))
    base more))

(define (compile-mods-par-cached cache mods)
  (define rs
    (async:async-all-deep
      (lambda (m)
        (Try (lambda (z) (compile-mod-cached cache default-subject m)) 0))
      mods))
  (foldl
    (lambda (st pair)
      (define r (_1 pair))
      (If (Eq 1 (Hd r))
        [(_0 st) (snoc (_0 pair) (_1 st))]
        [(legacy-cache-merge (_0 st) (_0 (_0 r))) (_1 st)]))
    [cache []] (zip mods rs)))


;;; Reference index — who-calls as a query over the TCs ;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; (moved from forge with the renderers: the mirror writes these as
;;; namespace slots, forge rebinds)

(define (fold-kids f acc row)
  (define (go i acc)
    (If (Ge i (Sz row)) acc (go (Inc i) (f acc (Ix i row)))))
  (go 0 acc))

(define (snoc-new x xs)
  (If (includes (Equal x) xs) xs (snoc x xs)))

;; Collect ["call" path] (TC_GLOBAL) and ["type" path] (TNOM) refs.
(define (collect-refs tcv)
  (define (go acc v)
    (Ifz (IsApp v) acc
      (cond
        ((Eq (Hd v) "TC_GLOBAL")
          (snoc-new ["call" (foil-subject:tc-global-path v)] acc))
        ((Eq (Hd v) "/foil/types/tnom")
          (fold-kids go (snoc-new ["type" (ty:tnom-ref v)] acc) v))
        (else (fold-kids go acc v)))))
  (go [] tcv))

;;; Module discovery and staleness stamps ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; (moved from forge: the resync chore family stats these)

(define (get-extension fnam) (Last (parse:split-str "." fnam)))

;; "bst.foil" -> "bst" (only called on names known to end in .foil)
(define (strip-foil fnam)
  (foil-lore:str-slice 0 (Sub (Bytes fnam) 5) fnam))

;; Module names under a file root: one per .foil file, named the way
;; the compiler expects — relative to the root, no extension ("bst",
;; "apps/life/main").
(define (read-fs-tree root)
  (define listing (ReadFolder root))
  (foldl
    (lambda (acc arg[folder? name])
      (cond
        (folder?
          (Weld acc
            (map (lambda (m) (strcat [name "/" m]))
              (read-fs-tree (strcat [root "/" name])))))
        ((Equal "foil" (get-extension name))
          (snoc (strip-foil name) acc))
        (else acc)))
  [] listing))

;;; REPL helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Input blocks are treated as bar-encoded: the empty bar is 1, and no
;; nonempty bar is <= 1 (a lone 0x01 content byte encodes as 0x101).
;; A raw 0 (plain EOF) is also "empty" under Le 1.
(define (bytes-is-empty? bytes)
  (Le bytes 1))

(define (read-stdin block-size)
  (define bytes (Input block-size))
  (And (Nil (bytes-is-empty? bytes))
    (lweld (lexplode bytes)
      (read-stdin block-size))))

(define (read-until stop input)
  (define (go input[ch chs])
    (Ifz input 0
      (If (Eq ch stop) 0
        [ch (go chs)])))
  (lstrcat (go input)))

assert(Equal "ab" (read-until 10 [97 [98 [10 [99 0]]]]))
assert(Equal "ab" (read-until 10 [97 [98 0]]))
