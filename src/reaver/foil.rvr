(define (get-foil fnam)
  (read-text-file (strcat ["foil/" fnam ".foil"])))
(define (parse-foil fnam)
  (parse-module-sast 0 (ParseRex (get-foil fnam))))

(define (parse-foil-val txt) (parse-val-sast (ParseRex txt)))



(define (burp-self type[_ tag f val])
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TSELF") (burp-self (ty:tself-val type)))
      (else type)))
  ret)
(define (burp-face ty[_ tag f val])
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TFAC") (burp-face (ty:tfac-val ty)))
      ((tag-is "TSELF") (burp-face (ty:tself-val ty)))
      (else ty)))
  ret)


(define empty-env [0 0 ty:TANY 0 0])
(define env-locals (Ix 0)) (define set-env-locals (Up 0))
(define env-diags (Ix 1))
(define env-goal (Ix 2)) (define set-env-goal (Up 2))
(define (push-env-goal x env) (snap 2 (cons x) env))
(define (peek-env-goal env)
  (_0 (env-goal env)))
(define (pop-env-goal env)
  [(peek-env-goal env) (snap 2 (drop 1) env)])
(define env-name (Ix 3)) (define set-env-name (Up 3))
(define env-tvars (Ix 4))

;;; SUBJECT

(define (make-err-entry key span err)
  ("ERR" key err))
(define (make-compiled-entry key val))

(define if-ty
  (ty:TQUA "a" (ty:TFUN [(ty:TNAT 0) (ty:TVAR "a") (ty:TVAR "a")] (ty:TVAR "a"))))

(define unary-nat-ty (ty:TFUN [(ty:TNAT NONE)] (ty:TNAT NONE)))
(define binary-nat-ty (ty:TFUN [(ty:TNAT NONE) (ty:TNAT NONE)] (ty:TNAT NONE)))
(define eq-ty (ty:TFUN [ty:TANY ty:TANY] (ty:TNAT NONE)))


(define default-subject
  (pipe empty-subject
    (ty:insert-typ-ffi ["nat"] (ty:TNAT 0))
    (insert-ffi ["if"] If if-ty)
    (insert-ffi ["eq"] Eq eq-ty)
    (insert-ffi ["inc"] Inc unary-nat-ty)
    (insert-ffi ["mul"] Mul binary-nat-ty)
    (insert-ffi ["dec"] Dec unary-nat-ty)))




;;; END SUBJECT

(define (elab-type sut wav[tag])
  (define (tag-is x) (Eq tag x))
  (define (on-tapp items[f])
    (define fields (map (elab-type sut) (drop 1 items)))
    (If (Eq "s_variant" (_0 f))
      (ty:TROW (_1 f) fields)
      (ty:TBAD "uimpl tapp")))

  (cond
    ((tag-is "s_trow")
      (ty:TTYP (ty:TROW 0 (map (elab-type sut) (surf-row-kids wav)))))

    ((tag-is "s_face")
     (ty:TFAC (surf-face-name wav)
       (elab-type sut (surf-face-kid wav))))
    ((tag-is "s_row")
      (ty:TROW 0 (map (elab-type sut) (surf-row-kids wav))))
    ((tag-is "s_union")
      (define ret (ty:TSUM (map (elab-type sut) (surf-union-opts wav))))
      (ty:TTYP ret))
    ((tag-is "s_ref")
      (ty:TNOM (surf-ref-val wav) 0))
    ((tag-is "s_variant")
      (ty:TROW (_1 wav) []))
    ((tag-is "s_tapp")
      (on-tapp (surf-tapp-kids wav)))
      (else (error ("unimpl type elab" wav)))))


(define (push-local-env env ty)
  (set-env-locals (Weld [ty] (env-locals env)) env))
(define (push-locals env tys)
  (set-env-locals (Weld tys (env-locals env)) env))

(define (peek-ret-cast sut body[tag])
  (If (Eq "s_cast" tag)
    (elab-type sut (surf-cast-ty body))
    ty:TBAD))

(define (collect-faces items)
  (define (go acc[idx ls] arg[_ tag face ty])
    [(Inc idx)
    (unless (Eq tag "TFAC")
      ls
      (snoc [idx face ty] ls))])
  (_1 (foldl go [0 0] items)))

(define (gen-accessors loc items sut)
  (define faces (collect-faces items))
  ; (print ["faces" faces])
  (define (go sut arg[idx fac ty])
    (define new-loc (Weld loc [fac]))
    ; (print ["new-loc" idx new-loc])
    (define typ (ty:TFUN [(ty:TNOM loc 0)] ty))
    (define tc (tc-ffi typ (Ix idx)))
    (insert-tc new-loc wack-span tc sut))
  (foldl go sut faces))

(define (self-ty sut env args body)
  (define name (rear (env-name env)))
  (define ret (peek-ret-cast sut body))
  (define inner (ty:TFUN args ret))
  (Ifz name
     (ty:TSELF inner)
     (ty:TSELF (ty:TFAC name inner))))

(define (match-face wan ty[_ tag hav])
  (and (Eq tag "TFAC") (Eq hav wan)))

(define (match-self ty[_ tag]) (Eq tag "TSELF"))

  ;;(set-env-locals (Weld [ty] (env-locals env))))

(define (tc-fold-app f xs)
  (Ifz xs f
   (tc-fold-app (tc-app ty:TBAD f (_0 xs)) (drop 1 xs))))

(define (burp-span s[tag])
  (If (Eq "s_span" tag) (_2 s) s))


(define (score-meth obj meth sut)
  (define outer-ty (tc-ty obj))
  (define ty[_ tag nom] (burp-face (tc-ty obj)))
  (define sel (snoc meth nom))
  (If (Eq tag "TNOM") (got-entry-tc sel sut)
    (error ("bad dot call" obj meth))))


;; -> tc
(define (elab-val sut env surf)
  (define (tag-is x) (Eq x (_0 surf)))
  (define elab-ty (elab-type sut))
  (define (elab-fun f[_ args body])
    (define argty (map elab-ty args))
    (define frame (Weld [(self-ty sut env argty body)] argty))
    (define inner-env (push-locals env frame))
    (define val (elab-val sut inner-env body))
    (tc-lam (ty:TFUN argty (tc-ty val)) 0 frame val))
	  (define (elab-cast c[_ ty body])
	    (define want (elab-ty ty))
	    (define env1 (set-env-goal want env))
	    (define ret (elab-val sut env1 body))
	    (unless (ty:type-nests? sut want (tc-ty ret))
        (error ["bad-cast" want (tc-ty ret) ret])
	      (set-tc-ty want ret)))
	  (define (elab-row r[_ items])
	    (define els (map (elab-val sut env) items))
	    (define ty (ty:TROW 0 (map tc-ty els)))
	    (tc-row ty (ty:trow-cstr ty) els))
  (define (elab-variant v[_ tag])
    (define ty (ty:TROW tag []))
    (tc-row ty (ty:trow-cstr ty) []))
  (define (elab-variant-call tag xs)
    (define ty (ty:TROW tag (map tc-ty xs)))
    (tc-row ty (ty:trow-cstr ty) xs))
  (define (tc-type-row tc)
    (If (Eq "TC_TYP" (Hd tc))
      (let ((typ (tc-typ-inner tc)))
        (If (and (Eq (_1 typ) "TTYP")
              (Eq (_1 (_2 typ)) "TROW"))
          (_2 typ)
          0))
      0))
  (define (elab-type-call tc xs)
    (define row (tc-type-row tc))
    (define row-span (ty:mold-to-span sut row))
    (define fields (ty:trow-vals row))
    (define got (map (cork burp-face tc-ty) xs))
    (define pairs (zip fields got))
    (unless (and (Eq (Sz fields) (Sz got))
              (all (uncurry (ty:type-nests? sut)) pairs))
      (error ["bad-constructor-call" row got])
      (tc-row (ty:span-to-mold sut row-span) (ty:trow-cstr row-span) xs)))
  (define (on-call f xs)
    ;; UGLY HACK, PLS FIX!
    (define xs-ty (map (cork burp-face tc-ty) xs))
	    (define ty[_ tag] (ty:type-apply sut (tc-ty f) xs-ty))
    (define app (tc-fold-app f xs))
    (If (Eq tag "TBAD") (error ("bad apply" ty (tc-ty f) xs-ty))
      (set-tc-ty ty app)))
  (define (elab-call c[_ f xs])
    (define exs (map (elab-val sut env) xs))
    (define variant-call? (Eq "s_variant" (_0 f)))
    (define tc-f (If variant-call? 0 (elab-val sut env f)))
    ;(print ("elab-call" env))
    (define ret
      (If variant-call?
        (elab-variant-call (_1 f) exs)
      (If (tc-type-row tc-f)
        (elab-type-call tc-f exs)
        (on-call tc-f exs))))
    ;(print ("call" c ret))
    ret)
  (define (elab-ref r[_ path])
    (got-entry-tc path sut));
  (define (on-var face idx)
    (define locals (env-locals env))
    (tc-local (Ix idx locals) idx face))
  (define (elab-var v[_ face])
    (define idx (find-idx (match-face face) (env-locals env)))
    (Ifz idx
      (begin
        ; (print ("fallthrough" face env))
        (elab-ref ["s_ref" [face]]))
      (on-var face (_0 idx))))
  (define (elab-lit l[_ val])
    (tc-lit (ty:TNAT 0) val))
  (define (elab-meth-go rcvr els)
    (define f (score-meth rcvr (_0 els) sut))
    (Ifz els rcvr
        (elab-meth-go (on-call f [rcvr]) (drop 1 els))))
  (define (elab-meth m[_ els])
    assert(Nil (Eq 0 (Sz els)))
    (define head (_0 els))
    (define head-tc (elab-var [0 (_0 els)]))
    (elab-meth-go head-tc (drop 1 els)))
  ;; scrutinee gets let bound by case
  ;; so push a local representing the type
  (define (elab-arm scr-ty a[_ pat val])
    (define ty (ty:type-meet sut scr-ty (elab-ty pat)))
    (define res (elab-val sut (push-local-env env ty) val))
    (tc-arm (tc-ty res) ty res))
  ;;
  (define (elab-case c[_ scr arms fall])
    (define scrut (elab-val sut env scr))
    (define arms1 (map (elab-arm (burp-face (tc-ty scrut))) arms))
    (define fall1
      (If (Eq "no-heir" fall)
        (tc-mean "unreachable")
        (elab-val sut env fall)))
    (define fall-ty
      (If (Eq "no-heir" fall) ty:TBOT (tc-ty fall1)))
    (define out-ty (foldl (ty:type-join sut) fall-ty (map tc-ty arms1)))
    (tc-match out-ty scrut arms1 fall1))
  (define (elab-self s[_ xs])
    (define idx
      (needful "missing self" (find-idx match-self (env-locals env))))
    (on-call (on-var 0 idx) (map (elab-val sut env) xs)))
    ; (define arm (map ))
  (cond
    ((tag-is "s_fun")  (elab-fun surf))
    ((tag-is "s_cast") (elab-cast surf))
    ((tag-is "s_row") (elab-row surf))
    ((tag-is "s_lit") (elab-lit surf))
    ((tag-is "s_variant") (elab-variant surf))
    ((tag-is "s_app") (elab-call surf))
    ((tag-is "s_ref") (elab-ref surf))
    ((tag-is "s_var") (elab-var surf))
    ((tag-is "s_case") (elab-case surf))
    ((tag-is "s_span") (elab-val sut env (burp-span surf)))
    ((tag-is "s_meth") (elab-meth surf))
    ((tag-is "s_self") (elab-self surf))
    ((or
       (tag-is "s_trow")
       (tag-is "s_union"))
       (tc-typ (elab-ty surf)))
    (else (error ("uimpl" surf)))))

(define (can-gen-accessors? tc[ty])
	  (If (and (Eq (Hd tc) "TC_TYP")
	       (Eq (_1 ty) "TTYP")
	       (Eq (_1 (_2 ty)) "TROW"))
	       (ty:trow-vals (_2 ty))
	       0))


;; ->
(define (elab-mod sut mod)
  (define (insert-elab-tc name span tc sut)
    (If (Eq (Hd tc) "TC_TYP")
      (ty:insert-typ name span (_2 (tc-typ-inner tc)) sut)
      (insert-tc name span tc sut)))
  (define (elab-entry sut ent[_ name span body])
    (define tc (elab-val sut (set-env-name name empty-env) body))
    (define acc? (can-gen-accessors? tc))
    (define sut1 (insert-elab-tc name span tc sut))
    ; (print ("name" name acc?))
    (Ifz acc? sut1
      (gen-accessors name acc? sut1)))
  (foldl elab-entry sut mod))


(define (make-ir-entry key span val tc ir)
  ("IR_ENTRY" key span val tc ir))
(define ir-entry-val (Ix 2))
(define ir-entry-tc (Ix 3))
(define ir-entry-ir (Ix 4))

(define (fold-app f xs)
  (Ifz xs f
    (fold-app (cgen:A f (_0 xs)) (drop 1 xs))))

(define (lower-tc sut val)
  (define (tag-is x) (Eq (Hd val) x))
  (define (lower-lam lam)
    (define body (lower-tc sut (tc-lam-body lam)))
    (cgen:F y y y "LAM" (tc-lam-arity val) body))
    (define (get-hd typ[_ tag])
      (define span[_ stag] (ty:mold-to-span sut typ))
      (define (tag-is x) (Eq stag x))
      (cond
        ((tag-is "TROW") (ty:trow-cstr span))
        (else
          (begin (print ("fallthrough" typ))
            0))))
  (define (lower-arms fall arms)
    (Ifz arms (lower-tc sut fall)
      (letrec
        ((arm (_0 arms))
         (pat-ty (tc-arm-pat arm))
         (leg-tc (lower-tc sut (tc-arm-val arm)))
         ;; we test the let binding we made in lower-match
         (test-ir (cgen:A (cgen:K (ty:type-fits sut pat-ty)) (cgen:V 0))))
         (cgen:A
           (cgen:A (cgen:A (cgen:K Ifz) test-ir) ;; if match
             leg-tc ;; then execute pattern
            )
            (lower-arms fall (drop 1 arms)))))) ;; continue pattern
  (define (lower-match val)
    (cgen:L (tc-match-scrut val)
      (lower-arms (tc-match-fall val) (tc-match-arms val))))
  (define (lower-row row)
    (fold-app
      (cgen:K (tc-row-hd row))
      (map (lower-tc sut) (tc-row-items row))))
  (cond
    ((tag-is "TC_LOCAL")  (cgen:V (tc-local-slot val)))
    ((tag-is "TC_GLOBAL") (cgen:G (got-const (tc-global-path val))))
    ((tag-is "TC_LIT")    (cgen:K (tc-lit-val val)))
    ((tag-is "TC_FFI")    (cgen:K (tc-ffi-val val)))
    ((tag-is "TC_APP")    (cgen:A (lower-tc sut (tc-app-f val))
                             (lower-tc sut (tc-app-x val))))
    ((tag-is "TC_LAM")    (lower-lam val))
    ((tag-is "TC_ROW")    (lower-row val))
    ((tag-is "TC_TYP")    (cgen:K val))
    ((tag-is "TC_MATCH")  (lower-match val))
    ((tag-is "TC_MEAN")   (cgen:A (cgen:K error) (cgen:K "unreachable")))
    (else (error ("lowering" val)))))


(define (lower-tc-entry sut key ent)
  (define tc (tc-entry-contents ent))
  (define ir (lower-tc sut tc))
  (define span (tc-entry-span ent))
  ; (print ("ir" ir))
  (define val (cgen:compile-expr ir))
  (define ent1 (make-ir-entry key span val tc ir))
  (insert-entry-sut key ent1 sut))

(define (lower-tc-mod sut out)
  (define n[next sut1] (pop-subject-order sut))
  (define entry (got-entry next sut))
  (Ifz (subject-order sut) out
    (let ((out1 (lower-tc-entry out next entry)))
      (lower-tc-mod sut1 out1))))

(lower-tc-mod (elab-mod default-subject (parse-foil "demo")) empty-subject)

(define (compile-mod sut mod)
  (lower-tc-mod (elab-mod sut (parse-foil "demo")) sut))


(define (bytes-is-empty? bytes)
  (Le bytes 1))

(define (read-stdin block-size)
  (define bytes (Input block-size))
  (And (Nil (bytes-is-empty? bytes))
    (lweld (lexplode bytes)
      (read-stdin block-size))))

(define (read-until stop input)
  (define (go input[ch chs])
    (print ("ch" ch))
    (If (Eq ch stop) 0
      [ch (go chs)]))
  (define res (go input))
  (print res)
  (lstrcat res))


(define (foil-repl mod)
  (define sut (compile-mod default-subject mod))
  (define (repl input)
    (define ast (parse-foil-val input))
    (define tc  (elab-val sut empty-env ast))
    (print ("tc" tc))
    (define val (lower-tc sut tc))
    (If (Eq "q" input) 0
      (begin
        (print val)
        (repl (read-until 10 (read-stdin 384))))))
  (repl (read-until 10 (read-stdin 384))))
