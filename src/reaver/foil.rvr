;;; Public parsing API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (get-foil fnam)
  (read-text-file (strcat ["foil/" fnam ".foil"])))

(define (parse-foil fnam)
  (foil-sast:parse-module-sast 0 (rex:ParseRexNorm (get-foil fnam))))

(define (parse-foil-val txt)
  (foil-sast:parse-val-sast (rex:ParseRexNorm txt)))

;;; Public compatibility aliases ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define default-subject foil-builtins:default-subject)

(define empty-env foil-elab:empty-env)
(define env-locals foil-elab:env-locals)
(define set-env-locals foil-elab:set-env-locals)
(define env-diags foil-elab:env-diags)
(define env-name foil-elab:env-name)
(define set-env-name foil-elab:set-env-name)
(define env-tvars foil-elab:env-tvars)

(define burp-self foil-elab:burp-self)
(define burp-face foil-elab:burp-face)
(define elab-type foil-elab:elab-type)
(define elab-val foil-elab:elab-val)
(define elab-mod foil-elab:elab-mod)

(define make-ir-entry foil-lower:make-ir-entry)
(define ir-entry-val foil-lower:ir-entry-val)
(define ir-entry-tc foil-lower:ir-entry-tc)
(define ir-entry-ir foil-lower:ir-entry-ir)
(define lower-tc foil-lower:lower-tc)
(define lower-tc-entry foil-lower:lower-tc-entry)
(define lower-tc-mod foil-lower:lower-tc-mod)
(define materialize-consts foil-lower:materialize-consts)

;;; Imports ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (mod-import? row) (Eq "s_import" (_0 row)))

(define (import-blurb span)
  (Ifz span "unknown-location" ["line" (Ix 0 span) "col" (Ix 1 span)]))

;; Direct import names of a module, by name; [] when the file is
;; missing or unparsable (the compile proper will say why).
(define (module-imports mod)
  (define rowsx
    (Try (lambda (z) (map (Ix 3) (filter mod-import? (parse-foil mod)))) 0))
  (If (Eq 1 (Hd rowsx)) [] (_0 rowsx)))

;; The keys a compiled module declared (directly or via its own
;; imports): its order minus the builtin baseline.
(define (module-decl-keys imp)
  (define base (foil-subject:subject-order default-subject))
  (filter
    (lambda (k) (Nil (includes (Equal k) base)))
    (foil-subject:subject-order imp)))

;; Compile a module by name, resolving its imports first.  Imports are
;; order-independent: all of them merge (and mount, when nested under a
;; +) before any declaration elaborates.  cache is
;; [[name subject decl-keys imported-keys] ..] so diamond imports
;; compile once and a hit pays neither the recompile nor the decl-key
;; derivation; stack is the import chain, for cycle detection.
;; Returns [cache' compiled imported-keys].
(define (cache-entry name compiled imported)
  [name compiled (module-decl-keys compiled) imported])

(define (compile-mod-go stack cache0 sut0 mod)
  (define rows (parse-foil mod))
  (define imps (filter mod-import? rows))
  (define decls (filter (lambda (r) (Nil (mod-import? r))) rows))
  (define (apply-import st imp[_ mount span name])
    (define cache (_0 st))
    (define sut (_1 st))
    (define seen (_2 st))
    (define blurb (import-blurb span))
    (define hit (find (lambda (e) (Eq name (_0 e))) cache))
    ;; The imported module compiles under a Try so its failure carries
    ;; its name: ["foil-in-module" name err].  Chains nest — a failure
    ;; three imports deep reads in-module a > in-module b > the error.
    (define (compile-import z)
      (compile-mod-go (snoc name stack) cache default-subject name))
    (If (includes (Eq name) stack)
      (error ["foil-import-cycle" ["module" name] ["at" blurb]])
      (let* ((r (Ifz hit
                  (let ((c (Try compile-import 0)))
                    (If (Eq 1 (Hd c))
                      (error ["foil-in-module" name (_0 c)])
                      (let ((e (cache-entry name (_1 (_0 c)) (_2 (_0 c)))))
                        [(snoc e (_0 (_0 c))) (_1 e) (_2 e)])))
                  (let ((e (_0 hit)))
                    [cache (_1 e) (_2 e)])))
             (imped (_1 r))
             (keys (_2 r))
             (sut1 (foil-subject:merge-subject blurb keys imped sut))
             (sut2 (Ifz (Sz mount)
                     sut1
                     (foil-subject:mount-subject blurb mount keys imped sut1))))
        [(_0 r) sut2 (Weld seen keys)])))
  (define merged (foldl apply-import [cache0 sut0 0] imps))
  ;; A declaration whose path an import or earlier local declaration
  ;; already occupies would silently shadow at insert time.  Imported
  ;; keys are rooted; local decl paths are source-relative.  Both
  ;; checks go through indexed sets — per-decl scans over the imported
  ;; key row made this O(decls * imports).
  (define root (foil-subject:sut-root sut0))
  (define imp-ax
    (foldl (lambda (a k) (cairn:putax k 1 a)) cairn:empty-ax (_2 merged)))
  (define (check-collision seen d[_ name span body])
    (cond
      ((Ifz (cairn:getax (Weld root name) imp-ax) 0 1)
        (error ["foil-import-collision" ["path" name] ["at" (import-blurb span)]]))
      ((Ifz (cairn:getax name seen) 0 1)
        (error ["foil-duplicate-decl" ["path" name] ["at" (import-blurb span)]]))
      (else (cairn:putax name 1 seen))))
  (define checked (foldl check-collision cairn:empty-ax decls))
  (define elabbed (Seq checked (elab-mod (_1 merged) decls)))
  ;; Materialize every referenced ground instantiation of const-param
  ;; generics before lowering (their base members skip lowering).
  (define final (foil-lower:materialize-consts elabbed))
  [(_0 merged) (lower-tc-mod final final) (_2 merged)])

;;; Public compile API ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (compile-mod sut mod)
  (define r (Try (lambda (z) (compile-mod-go [mod] 0 sut mod)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    (_1 (_0 r))))

;; Compile with a persistent cache: returns [cache' compiled].  The
;; cache ([[name subject decl-keys imported-keys] ..], seed with 0)
;; carries every compiled module's subject ACROSS calls, so sibling
;; top-level compiles sharing an import chain (helm + lainapp over
;; sept/shrine/lain) walk it once, and re-requesting a cached module
;; returns it outright.  Entries are compiled against default-subject
;; — only thread the cache between compiles that also start from it.
(define (compile-mod-cached cache sut mod)
  (define hit (find (lambda (e) (Eq mod (_0 e))) cache))
  (Ifz hit
    (let ((r (Try (lambda (z) (compile-mod-go [mod] cache sut mod)) 0)))
      (If (Eq 1 (Hd r))
        (error ["foil-in-module" mod (_0 r)])
        [(snoc (cache-entry mod (_1 (_0 r)) (_2 (_0 r))) (_0 (_0 r)))
         (_1 (_0 r))]))
    [cache (_1 (_0 hit))]))

(define (compile-mod-info sut mod)
  (define r (Try (lambda (z) (compile-mod-go [mod] 0 sut mod)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    [(_1 (_0 r)) (_2 (_0 r))]))

;; The cached compile-mod-info: [cache' [compiled imported-keys]].
(define (compile-mod-info-cached cache sut mod)
  (define hit (find (lambda (e) (Eq mod (_0 e))) cache))
  (Ifz hit
    (let ((r (Try (lambda (z) (compile-mod-go [mod] cache sut mod)) 0)))
      (If (Eq 1 (Hd r))
        (error ["foil-in-module" mod (_0 r)])
        [(snoc (cache-entry mod (_1 (_0 r)) (_2 (_0 r))) (_0 (_0 r)))
         [(_1 (_0 r)) (_2 (_0 r))]]))
    [cache [(_1 (_0 hit)) (_3 (_0 hit))]]))

;;; Content-addressed module artifacts ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Unlike compile-mod-cached's process-local cumulative subjects, these
;;; entries contain only a module's pinned subject additions.  The cache value
;;; itself is ordinary PLAN data, so putting it in a Reaver top-level binding
;;; makes it survive in the existing content-addressed snapshot graph.

(define artifact-schema 1)

(define (artifact-compiler-token z)
  ;; A source/compiler change alters one of these transitive pinned closures.
  ;; artifact-schema covers payload/replay changes in this section itself.
  (Pin [artifact-schema compile-mod-go foil-elab:elab-mod
        foil-lower:materialize-consts foil-lower:lower-tc-mod
        foil-subject:subject-entry-delta foil-subject:apply-entry-delta
        default-subject]))

(define (make-artifact-cache flags)
  ["FOIL_ARTIFACT_CACHE" artifact-schema (artifact-compiler-token 0) flags []])

(define artifact-cache-flags (Ix 3))
(define artifact-cache-entries (Ix 4))

(define (artifact-cache-normalize cache flags)
  (If (And (IsApp cache)
        (And (Eq "FOIL_ARTIFACT_CACHE" (Hd cache))
          (And (Eq artifact-schema (Ix 1 cache))
            (And (Equal (artifact-compiler-token 0) (Ix 2 cache))
              (Equal flags (artifact-cache-flags cache))))))
    cache
    (make-artifact-cache flags)))

;; Artifact body:
;; [tag schema name source compiler-token initial-subject-pin flags
;;  [[import-sast artifact-pin] ..] imported-keys decl-keys entry-delta]
(define artifact-name (Ix 2))
(define artifact-source (Ix 3))
(define artifact-compiler (Ix 4))
(define artifact-initial (Ix 5))
(define artifact-flags (Ix 6))
(define artifact-direct (Ix 7))
(define artifact-imported (Ix 8))
(define artifact-decl-keys (Ix 9))
(define artifact-delta (Ix 10))

(define (artifact-body art)
  (If (IsPin art) (Unpin art) 0))

(define (artifact-shaped? art)
  (define b (artifact-body art))
  (And (IsApp b)
    (And (Eq "FOIL_ARTIFACT" (Hd b))
      (Eq artifact-schema (Ix 1 b)))))

(define (artifact-cache-find cache mod)
  (find (lambda (e) (Eq mod (_0 e))) (artifact-cache-entries cache)))

(define (artifact-cache-put cache mod art)
  (snap 4
    (lambda (entries)
      (snoc [mod art]
        (filter (lambda (e) (Ne mod (_0 e))) entries)))
    cache))

(define (legacy-cache-merge base more)
  (foldl
    (lambda (acc e)
      (If (includes (lambda (x) (Eq (_0 e) (_0 x))) acc)
        acc
        (snoc e acc)))
    base more))

(define (artifact-base-valid? art mod src compiler init flags)
  (Ifz (artifact-shaped? art)
    0
    (let ((b (artifact-body art)))
      (And (Eq mod (artifact-name b))
        (And (Equal src (artifact-source b))
          (And (Equal compiler (artifact-compiler b))
            (And (Equal init (artifact-initial b))
              (Equal flags (artifact-flags b)))))))))

(define (artifact-valid? art mod src compiler init flags direct)
  (And (artifact-base-valid? art mod src compiler init flags)
    (Equal (map (Ix 1) direct)
      (map (Ix 1) (artifact-direct (artifact-body art))))))

;; -> [cache artifact compiled imported-keys legacy-cache]
(define (compile-artifact-go stack cache0 sut0 flags mod)
  (define src (get-foil mod))
  (define compiler (artifact-compiler-token 0))
  (define init (Pin sut0))
  (define found (artifact-cache-find cache0 mod))
  (define art (Ifz found 0 (_1 (_0 found))))
  ;; An exact source/compiler/subject hit can trust the import SAST stored in
  ;; the pinned artifact.  That is what lets a warm module skip lexing and
  ;; parsing altogether; dependency pins are checked after resolving imports.
  (define candidate? (artifact-base-valid? art mod src compiler init flags))
  (define imps
    (If candidate?
      (map (Ix 0) (artifact-direct (artifact-body art)))
      (filter mod-import?
        (foil-sast:parse-module-sast 0 (rex:ParseRexNorm src)))))
  (define (apply-import st[cache sut seen direct legacy] imp[_ mount span name])
    (define blurb (import-blurb span))
    (If (includes (Eq name) stack)
      (error ["foil-import-cycle" ["module" name] ["at" blurb]])
      (let* ((r (compile-artifact-go (snoc name stack) cache
                   default-subject flags name))
             (cache1 (_0 r))
             (art (_1 r))
             (imped (_2 r))
             (keys (artifact-decl-keys (artifact-body art)))
             (legacy1 (legacy-cache-merge legacy (Ix 4 r)))
             (sut1 (foil-subject:merge-subject blurb keys imped sut))
             (sut2 (Ifz (Sz mount)
                     sut1
                     (foil-subject:mount-subject blurb mount keys imped sut1))))
        [cache1 sut2 (Weld seen keys) (snoc [imp art] direct) legacy1])))
  (define merged
    (foldl apply-import [cache0 sut0 0 [] []] imps))
  (define cache (_0 merged))
  (define pre (_1 merged))
  (define direct (_3 merged))
  (define legacy (Ix 4 merged))
  (If (artifact-valid? art mod src compiler init flags direct)
    (let* ((body (artifact-body art))
           (compiled
             (foil-subject:apply-entry-delta
               ["cached module" mod] (artifact-delta body) pre))
           (imported (artifact-imported body))
           (legacy1
             (snoc (cache-entry mod compiled imported)
               (filter (lambda (e) (Ne mod (_0 e))) legacy))))
      [cache art compiled imported legacy1])
    ;; Imports have already been resolved to cumulative subjects above.
    ;; Seed the old in-process cache with them so the cold module compile
    ;; does not elaborate the import graph a second time.
    (let* ((cold (compile-mod-go stack legacy sut0 mod))
           (compiled (_1 cold))
           (imported (_2 cold))
           (decl-keys (module-decl-keys compiled))
           (delta (foil-subject:subject-entry-delta pre compiled))
           (body ["FOIL_ARTIFACT" artifact-schema mod src compiler init flags
                  direct imported decl-keys delta])
           (art1 (Pin body))
           (cache1 (artifact-cache-put cache mod art1))
           (legacy1
             (snoc (cache-entry mod compiled imported)
               (filter (lambda (e) (Ne mod (_0 e))) (_0 cold)))))
      [cache1 art1 compiled imported legacy1])))

(define (compile-mod-artifact-cached cache sut flags mod)
  (define cache0 (artifact-cache-normalize cache flags))
  (define r
    (Try (lambda (z) (compile-artifact-go [mod] cache0 sut flags mod)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    [(_0 (_0 r)) (_2 (_0 r))]))

(define (compile-mod-info-artifact-cached cache sut flags mod)
  (define cache0 (artifact-cache-normalize cache flags))
  (define r
    (Try (lambda (z) (compile-artifact-go [mod] cache0 sut flags mod)) 0))
  (If (Eq 1 (Hd r))
    (error ["foil-in-module" mod (_0 r)])
    [(_0 (_0 r)) [(_2 (_0 r)) (_3 (_0 r))]]))

(define (artifact-module-closure mods)
  (define (go seen pending)
    (Ifz (Sz pending)
      seen
      (let* ((mod (_0 pending))
             (rest (drop 1 pending)))
        (If (includes (Eq mod) seen)
          (go seen rest)
          (go (snoc mod seen) (Weld rest (module-imports mod)))))))
  (go [] mods))

(define (artifact-cache-drop cache names)
  (snap 4
    (filter (lambda (e) (Nil (includes (Eq (_0 e)) names))))
    cache))

(define (warm-mod-artifacts cache sut flags mods fresh?)
  (define cache0 (artifact-cache-normalize cache flags))
  (define cache1
    (If fresh?
      (artifact-cache-drop cache0 (artifact-module-closure mods))
      cache0))
  (foldl
    (lambda (acc mod)
      (_0 (compile-mod-artifact-cached acc sut flags mod)))
    cache1 mods))

;;; Entry inspection ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A subject entry decomposed either way it is stored:
;; -> ["ENT" path tc span ir val lowered?].  Const-generic base
;; members skip lowering and stay ("TC" key tc span); everything else
;; is an IR_ENTRY.
(define (entry-parts sut path)
  (define ent (foil-subject:got-entry path sut))
  (If (Eq (Hd ent) "IR_ENTRY")
    ["ENT" path (Ix 3 ent) (Ix 1 ent) (Ix 4 ent) (Ix 2 ent) 1]
    ["ENT" path (Ix 1 ent) (Ix 2 ent) 0 0 0]))

(define ent-tc (Ix 2))
(define ent-span (Ix 3))
(define ent-ir (Ix 4))
(define ent-val (Ix 5))
(define ent-lowered (Ix 6))

(define (entry-kind sut path tc)
  (define hd (Hd tc))
  (cond
    ((Eq hd "TC_TYP")
      (If (Eq "TSUM" (_1 (_2 (foil-subject:tc-typ-inner tc)))) "sum type" "row type"))
    ((Eq hd "TC_LAM") "function")
    ((Eq hd "TC_FFI") "generated")
    ((Eq hd "TC_LIT") "literal")
    ((Eq hd "TC_ROW") "value")
    ((Eq hd "TC_LET") "value")
    ((Eq hd "TC_APP") "value")
    (else "entry")))

;; An entry's own source text, from its span's offset/len into the
;; module source.
(define (source-slice src espan)
  (define off (Ix 2 espan))
  (define len (Ix 3 espan))
  (If len (Trunc (Mul 8 len) (Rsh src (Mul 8 off))) ""))

;; Compile several modules in parallel actors, one future per module,
;; each deep-forced in its child. Deterministic: results are Equal to
;; sequential compile-mod output. Needs enki with the actor-request
;; fix (merged July 2026; doc/enki-actor-report.md).
(define (compile-mods-par mods)
  (async:async-all-deep (lambda (m) (compile-mod default-subject m)) mods))

;;; REPL helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Input blocks are treated as bar-encoded: the empty bar is 1, and no
;; nonempty bar is <= 1 (a lone 0x01 content byte encodes as 0x101).
;; A raw 0 (plain EOF) is also "empty" under Le 1.
(define (bytes-is-empty? bytes)
  (Le bytes 1))

(define (read-stdin block-size)
  (define bytes (Input block-size))
  (And (Nil (bytes-is-empty? bytes))
    (lweld (lexplode bytes)
      (read-stdin block-size))))

(define (read-until stop input)
  (define (go input[ch chs])
    (Ifz input 0
      (If (Eq ch stop) 0
        [ch (go chs)])))
  (lstrcat (go input)))

assert(Equal "ab" (read-until 10 [97 [98 [10 [99 0]]]]))
assert(Equal "ab" (read-until 10 [97 [98 0]]))
