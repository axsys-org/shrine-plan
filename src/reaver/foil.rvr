(define (pin-arity x)
  (define i (Unpin x))
  (If (IsLaw i) (Arity i) 1))

(define (compile-church-boolean v t f)
  (If (Eq v "true") t f))

(define (law-var? arity body) (And (IsNat body) (lte body arity)))
(define (law-call? arity body) (And (Eq 2 (Sz body)) (Eq (Hd body) 0)))
(define (law-lit? arity body)
  (Nil (Or (law-call? arity body) (law-var? arity body))))

(define (get-const arity body)
  (define rec (get-const arity))
  (define (on-app f x)
    (define ff (rec f))
    (define xx (rec x))
    (and ff xx ((_0 ff) (_0 xx))))
  (cond
    ((law-var? arity body) 0)
    ((law-call? arity body) (And (rec (_0 body)) (rec (_1 body))))
    (else [body])))

(define (lift-call arity f x)
  (If (law-call? arity f)
    ((lift-call arity (_0 f) (_1 f)) x)
    [f x]))

(define (subst-body-var arity arg body)
  (define rec (subst-body-var arity arg))
  (define is-var? (law-var? arity body))
  (cond
    ((Eq 1 body) arg)
    ((law-var? arity body) (Dec body))
    ((law-call? arity body) (map rec body))
    (else body)))

(define (subst-body-vars arity vars body)
  (Ifz vars body
    (subst-body-vars (Dec arity) (drop 1 vars)
      (subst-body-var arity (_0 vars) body))))

(define (plan-arity x)
  (Case4 (Type x)
     0
     (pin-arity x)
     (Arity x)
     (Dec (plan-arity (Init x)))))

(define (is-const v)
  (Nil (law-var? v)))

(define (constant-fold arity body)
  (define rec (constant-fold arity))
  (define (on-app f x)
    (define ff (rec f))
    (define xx (rec x))
    (define lifted[func] (lift-call arity ff xx))
    (If
      (Or (Nil lifted) (all is-const lifted))
      (0 f x)
      (let ((arity (plan-arity func)))
        (If (Eq arity (Dec (Sz lifted)))
          (Coup func (drop 1 lifted))
          (0 f x)))))
  (cond
    ((law-var? arity body) body)
    ((law-call? arity body) (on-app (_0 body) (_1 body)))
    (else body)))

(define (partial-eval app)
  (define hd (Hd app))
  (define law (If (IsPin hd) (Unpin hd) hd))
  (define appl (Sz app))
  (define arity (Sub (Arity law) appl))
  (define name (strWeld "eval" (Name law)))
  (Law (Dec arity) name
       (constant-fold arity
         (subst-body-vars (Arity law) app (Body law)))))


(define (get-foil fnam)
  (read-text-file (strcat ["foil/" fnam ".foil"])))
(define (parse-foil fnam)
  (parse-module-sast 0 (ParseRex (get-foil fnam))))


(define (tc tag) (strWeld "TC_" tag))
(define tc-ty (Ix 0))
(define set-tc-ty (Up 0))
(define (tc-local ty slot face)
  (tc "LOCAL" ty slot face))
(define tc-local-slot (Ix 1))
(define (tc-global ty path)
  (tc "GLOBAL" ty path))
(define (tc-lit ty lit)
  (tc "LIT" ty lit))
(define tc-lit-val (Ix 1))
(define tc-global-path (Ix 1))
(define (tc-const ty val)
  (tc "CONST" ty val))
(define tc-const-val (Ix 1))
(define (tc-ffi ty val)
  (tc "FFI" ty val))
(define tc-ffi-val (Ix 1))
(define (tc-app ty f x)
  (tc "APP" ty f x))
(define tc-app-f (Ix 1))
(define tc-app-x (Ix 2))
(define (tc-typ ty)
  (tc "TYP" ty))
(define (tc-ttyp ty)
  (tc-typ (TTYP ty)))
(define tc-typ-inner (Ix 0))
(define (tc-mean cause)
  (tc "mean" cause))

(define (tc-lam ty meta args body)
  (tc "LAM" ty meta args body))
(define tc-lam-args (Ix 2))
(define (tc-lam-arity l) (Sz (Ix 2 l)))
(define tc-lam-body (Ix 3))

(define (tc-letrec ty binds body)
  (tc "LET" ty binds body))

(define (tc-row ty hd row)
  (tc "ROW" ty hd row))
(define tc-row-items (Ix 2))

(define (tc-match ty scrut arms fall)
  (tc "MATCH" ty scrut arms fall))
(define tc-match-scrut (Ix 1))
(define tc-match-arms (Ix 2))
(define tc-match-fall (Ix 3))
(define (tc-arm ty pat val)
  (tc "ARM" ty pat val))
(define tc-arm-pat (Ix 1))
(define tc-arm-val (Ix 2))

(define tc-poison
  (tc "POISON" TBAD))


(define (burp-self ty[_ tag f val])
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TSELF") (burp-self (tself-val ty)))
      (else ty)))
  ret)
(define (burp-face ty[_ tag f val])
  (define (tag-is x) (Eq tag x))
  (define ret
    (cond
      ((tag-is "TFAC") (burp-face (tfac-val ty)))
      ((tag-is "TSELF") (burp-face (tself-val ty)))
      (else ty)))
  ret)


(define empty-env [0 0 TANY 0 0])
(define env-locals (Ix 0)) (define set-env-locals (Up 0))
(define env-diags (Ix 1))
(define env-goal (Ix 2)) (define set-env-goal (Up 2))
(define (push-env-goal x env) (snap 2 (cons x) env))
(define (peek-env-goal env)
  (_0 (env-goal env)))
(define (pop-env-goal env)
  [(peek-env-goal env) (snap 2 (drop 1) env)])
(define env-name (Ix 3)) (define set-env-name (Up 3))
(define env-tvars (Ix 4))

;;; SUBJECT
(define (make-subject ax) ("SUT" ax 0))
(define subject-order Ix1)
(define set-subject-order (Up 1))
(define (push-subject-order name sut)
  (set-subject-order (snoc name (subject-order sut)) sut))
(define (pop-subject-order sut)
  (define ord (subject-order sut))
  [(_0 ord) (set-subject-order (drop 1 ord) sut)])
(define empty-subject (make-subject empty-ax))
(define (insert-entry-sut key val sut)
  (pipe sut
    (snap 0 (putax key val))
    (push-subject-order key)))
(define (make-tc-entry key span tc)
  ("TC" key tc span))
(define tc-entry-contents (Ix 1))
(define tc-entry-span (Ix 2))
(define (insert-tc key span tc sut)
  (define ent (make-tc-entry key span tc))
  (insert-entry-sut key ent sut))
(define wack-span [0 0 0 0])

(define (insert-ffi key val ty sut)
  (define tc (tc-ffi ty val))
  (insert-tc key wack-span tc sut))
(define (insert-typ key span typ sut)
  (define ent (make-tc-entry key span (tc-ttyp typ)))
  (insert-entry-sut key ent sut))
(define (insert-typ-ffi key typ sut)
  (insert-typ key wack-span typ sut))
(define (got-entry path sut)
  (print ("got" path sut))
  (gotax path (_0 sut)))

(define (got-entry-tc path sut)
  (define ent (got-entry path sut))
  (If (Eq (Hd ent) "TC")
      (_1 ent)
      (error ("bad entry" path ent))))

(define (got-type path sut)
  (define tc (got-entry-tc path sut))
  (print ("got type" path tc))
  (unless (Eq (Hd tc) "TC_TYP") (error "bad type")
    (_2 (tc-typ-inner tc))))

(define (make-err-entry key span err)
  ("ERR" key err))
(define (make-compiled-entry key val))

(define if-ty
  (TQUA "a" (TFUN [(TNAT 0) (TVAR "a") (TVAR "a")] (TVAR "a"))))

(define unary-nat-ty (TFUN [(TNAT NONE)] (TNAT NONE)))
(define binary-nat-ty (TFUN [(TNAT NONE) (TNAT NONE)] (TNAT NONE)))
(define eq-ty (TFUN [TANY TANY] (TNAT NONE)))


(define default-subject
  (pipe empty-subject
    (insert-typ-ffi ["nat"] (TNAT 0))
    (insert-ffi ["if"] If if-ty)
    (insert-ffi ["eq"] Eq eq-ty)
    (insert-ffi ["inc"] Inc unary-nat-ty)
    (insert-ffi ["mul"] Inc binary-nat-ty)
    (insert-ffi ["dec"] Inc unary-nat-ty)))
;; type union
(define (type-join sut x[_ xtag] y[_ ytag])
  (define (homo-join tag x y)
    (define (tag-is z) (Eq tag z))
    (cond
      ((tag-is "TNAT") (TNAT 0))
      ((tag-is "TSUM")
       (TSUM (Weld (tsum-opts x) (tsum-opts y))))
      ((And (tag-is "TROW") (Eq (Sz (trow-vals x)) (Sz (trow-vals y))))
        (TROW (map (uncurry (type-join sut)) (zip (trow-vals x) (trow-vals y)))))
      (else (TSUM [x y]))))
  (define (flat-sum sum[_ _ opts] other)
    (TSUM (snoc other opts)))
  (cond
    ((Equal x y) x)
    ((Eq xtag ytag) (homo-join xtag x y))
    ((Eq xtag "TSUM") (flat-sum x y))
    ((Eq ytag "TSUM") (flat-sum y x))
    (else (TSUM [x y]))))

;; type intersection
(define (type-meet sut x[_ xtag] y[_ ytag])
  (define (homo-nom x[_ _ x-nom] y[_ _ y-nom])
    (define x-typ[_ x-tag] (got-type x-nom sut))
    (define y-typ[_ y-tag] (got-type y-nom sut))
    (cond
      ((And (Eq x-tag "TSUM") (Eq y-tag "TSUM")) (type-meet sut x-typ y-typ))
      ((Eq x-tag "TSUM") (type-meet sut x-typ y))
      ((Eq y-tag "TSUM") (type-meet sut y-typ x))
      (else TBOT)))
  (define (homo-meet tag x y)
    (define (tag-is z) (Eq tag z))
    (cond
      ;; should be caught be deepeq
      ((tag-is "TNAT") TBOT)
      ((tag-is "TSUM") (TSUM (intersect Equal (tsum-opts x) (tsum-opts y))))
      ((tag-is "TNOM") (homo-nom x y))
      (else TBOT)))
  (define (distr-sum sum[_ _ opts] other)
    (TSUM (map (type-meet sut other) opts)))
  (define (distr-face face[_ _ face val] other)
    (TFAC face (type-meet sut val other)))
  (define (handle-nom nom[_ _ nam] other[_ other-tag])
    (define typ[_ tag] (got-type nam sut))
    ;; XX: this is a smell, should probably treat
    (cond
      ((Eq tag "TSUM") (distr-sum typ other))
      (else TBOT)))
    (Force (cond
    ((Equal x y) x)
    ((Eq xtag ytag) (homo-meet xtag x y))
    ((Eq xtag "TFAC") (distr-face x y))
    ((Eq ytag "TFAC") (distr-face y x))
    ((Eq xtag "TSUM") (distr-sum x y))
    ((Eq ytag "TSUM") (distr-sum y x))
    ((Eq xtag "TNOM") (handle-nom x y))
    ((Eq ytag "TNOM") (handle-nom y x))
    (else TBOT))))

(begin
  (define g-nat (TFAC "g" (TNAT 0)))
  (define have (type-meet empty-subject g-nat (TNAT 0)))
  (print have)
  assert(Equal have g-nat))


(define (fits-err err)
  (1 [err]))
(define (fits-weld a[ae] b[be])
  (1 (Weld ae be)))
(define (fits-or a b)
  (Ifz a 0 b))
(define (fits-and a b)
  (Ifz a b
    (Ifz b a
      (fits-weld a b))))
(define (type-fits sut ty[_ tag] val)
  (define (tag-is x) (Eq x tag))
  (define (try-recur ty1 val) ((Try (type-fits sut)) ty val))
  (define recur (type-fits sut))
  (define recur-row (uncurry (type-fits sut)))
  (define (row-fits tys val)
    (cond
      ((Nil (IsApp val)) (fits-err "fit row into bottom"))
      ((Ne (Sz tys) (Sz val)) (fits-err "fit row into bad size"))
      (else (foldr fits-and 0 (map recur-row (zip tys val))))))
  (define (handle-nom nom val)
    (define typ (got-type sut nom))
    (unless (Eq (Hd val) (print-path nom))
      (fits-err "bad type constructor")
      (recur sut typ val)))
  (cond
    ((tag-is "TBOT") (fits-err "nothing fits bottom"))
    ((tag-is "TROW") (row-fits (trow-vals ty) val))
    ((tag-is "TFAC") (recur (tfac-val ty) val))
    ((tag-is "TSUM")
      (foldl fits-or
             (fits-err "fell through sum")
             (map recur-row (late-zip val (tsum-opts ty)))))
    ((tag-is "TNOM") (handle-nom (tnom-ref ty) val))
    ((tag-is "TNAT") (If (IsNat val) 0 (fits-err "not nat")))
    (else (fits-err ["fallthrough uimpl" tag]))))

;;; END SUBJECT

(define (elab-type sut wav[tag])
  (define (tag-is x) (Eq tag x))
  (define (on-tapp items[f])
    (define hd (elab-type sut f))
    (define hdty (tc-ty hd))
    (define (ty-is x) (Eq (_1 hdty) x))
    ;; either an anonymous constructor
    (TBAD "uimpl tapp"))
    ;; or a type constructor
    ; (error ("uimpl tapp")))

(cond
    ((tag-is "s_trow")
      (TTYP (TROW (map (elab-type sut) (surf-row-kids wav)))))

    ((tag-is "s_face")
     (TFAC (surf-face-name wav)
       (elab-type sut (surf-face-kid wav))))
    ((tag-is "s_row")
      (TROW (map (elab-type sut) (surf-row-kids wav))))
    ((tag-is "s_union")
      (define ret (TSUM (map (elab-type sut) (surf-union-opts wav))))
      (TTYP ret))
    ((tag-is "s_ref")
      (TNOM (surf-ref-val wav) 0))
    ((tag-is "s_tapp")
      (on-tapp (surf-tapp-kids wav)))
      (else (error ("unimpl type elab" wav)))))


(define (push-local-env env ty)
  (set-env-locals (Weld [ty] (env-locals env)) env))
(define (push-locals env tys)
  (set-env-locals (Weld tys (env-locals env)) env))

(define (peek-ret-cast sut body[tag])
  (If (Eq "s_cast" tag)
    (elab-type sut (surf-cast-ty body))
    TBAD))

(define (collect-faces items)
  (define (go acc[idx ls] arg[_ tag face ty])
    [(Inc idx)
    (unless (Eq tag "TFAC")
      ls
      (snoc [idx face ty] ls))])
  (_1 (foldl go [0 0] items)))

(define (gen-accessors loc items sut)
  (define faces (collect-faces items))
  ; (print ["faces" faces])
  (define (go sut arg[idx fac ty])
    (define new-loc (Weld loc [fac]))
    ; (print ["new-loc" idx new-loc])
    (define typ (TFUN [(TNOM loc 0)] ty))
    (define tc (tc-ffi typ (Ix idx)))
    (insert-tc new-loc wack-span tc sut))
  (foldl go sut faces))

(define (self-ty sut env args body)
  (define name (rear (env-name env)))
  (define ret (peek-ret-cast sut body))
  (define inner (TFUN args ret))
  (Ifz name
     (TSELF inner)
     (TSELF (TFAC name inner))))
(define (match-face wan ty)
  (define burped[_ tag hav] (burp-self ty))
  (and (Eq tag "TFAC") (Eq hav wan)))

(define (match-self ty[_ tag]) (Eq tag "TSELF"))

  ;;(set-env-locals (Weld [ty] (env-locals env))))

(define (tc-fold-app f xs)
  (Ifz xs f
   (tc-fold-app (tc-app TBAD f (_0 xs)) (drop 1 xs))))

(define (burp-span s[tag])
  (If (Eq "s_span" tag) (_2 s) s))


(define (score-meth obj meth sut)
  (define outer-ty (tc-ty obj))
  (define ty[_ tag nom] (burp-face (tc-ty obj)))
  (define sel (snoc meth nom))
  (If (Eq tag "TNOM") (got-entry-tc sel sut)
    (error ("bad dot call" obj meth))))


;; -> tc
(define (elab-val sut env surf)
  (define (tag-is x) (Eq x (_0 surf)))
  (define elab-ty (elab-type sut))
  (define (elab-fun f[_ args body])
    (define argty (map elab-ty args))
    (define frame (Weld [(self-ty sut env argty body)] argty))
    (define inner-env (push-locals env frame))
    (define val (elab-val sut inner-env body))
    (tc-lam (TFUN argty (tc-ty val)) 0 frame val))
  (define (elab-cast c[_ ty body])
    (define want (elab-ty ty))
    (define env1 (set-env-goal want env))
    (define ret (elab-val sut env1 body))
    assert(type-nests? want (tc-ty ret))
    (set-tc-ty want ret))
  (define (elab-row r[_ items])
    (define els (map (elab-val sut env) items))
    (define ty (TROW (map tc-ty els) 0 els))
    (tc-row ty 0 els))
  (define (on-call f xs)
    ;; UGLY HACK, PLS FIX!
    (define xs-ty (map (cork burp-face tc-ty) xs))
    (define ty[_ tag] (type-apply (tc-ty f) xs-ty))
    (define app (tc-fold-app f xs))
    (If (Eq tag "TBAD") (error ("bad apply" (tc-ty f) xs-ty))
      (set-tc-ty ty app)))
  (define (elab-call c[_ f xs])
    (define tc-f (elab-val sut env f))
    (define exs (map (elab-val sut env) xs))
    ;(print ("elab-call" env))
    (on-call tc-f exs))
  (define (elab-ref r[_ path])
    (got-entry-tc path sut));
  (define (on-var face idx)
    (define locals (env-locals env))
    (tc-local (Ix idx locals) idx face))
  (define (elab-var v[_ face])
    (define idx (find-idx (match-face face) (env-locals env)))
    (Ifz idx
      (begin
        ; (print ("fallthrough" face env))
        (elab-ref ["s_ref" [face]]))
      (on-var face (_0 idx))))
  (define (elab-lit l[_ val])
    (tc-lit (TNAT 0) val))
  (define (elab-meth-go rcvr els)
    (define f (score-meth rcvr (_0 els) sut))
    (Ifz els rcvr
        (elab-meth-go (on-call f [rcvr]) (drop 1 els))))
  (define (elab-meth m[_ els])
    assert(Nil (Eq 0 (Sz els)))
    (define head (_0 els))
    (define head-tc (elab-var [0 (_0 els)]))
    (elab-meth-go head-tc (drop 1 els)))
  ;; scrutinee gets let bound by case
  ;; so push a local representing the type
  (define (elab-arm scr-ty a[_ pat val])
    (define ty (type-meet sut scr-ty (elab-ty pat)))
    (define res (elab-val sut (push-local-env env ty) val))
    (tc-arm (tc-ty res) ty res))
  ;;
  (define (elab-case c[_ scr arms fall])
    (define scrut (elab-val sut env scr))
    (define arms1 (map (elab-arm (burp-face (tc-ty scrut))) arms))
    (define fall1
      (If (Eq "no-heir" fall)
        (tc-mean "unreachable")
        (elab-val sut env fall)))
    (define out-ty (foldl (type-join sut) fall1 (map tc-ty arms)))
    (tc-match out-ty scrut arms1 fall1))
  (define (elab-self s[_ xs])
    (define idx
      (needful "missing self" (find-idx match-self (env-locals env))))
    (on-call (on-var 0 idx) (map (elab-val sut env) xs)))
    ; (define arm (map ))
  (cond
    ((tag-is "s_fun")  (elab-fun surf))
    ((tag-is "s_cast") (elab-cast surf))
    ((tag-is "s_row") (elab-row surf))
    ((tag-is "s_lit") (elab-lit surf))
    ((tag-is "s_app") (elab-call surf))
    ((tag-is "s_ref") (elab-ref surf))
    ((tag-is "s_var") (elab-var surf))
    ((tag-is "s_case") (elab-case surf))
    ((tag-is "s_span") (elab-val sut env (burp-span surf)))
    ((tag-is "s_meth") (elab-meth surf))
    ((tag-is "s_self") (elab-self surf))
    ((or
       (tag-is "s_trow")
       (tag-is "s_union"))
       (tc-typ (elab-ty surf)))
    (else (error ("uimpl" surf)))))

(define (can-gen-accessors? tc[ty])
  (If (and (Eq (Hd tc) "TC_TYP")
       (Eq (_1 ty) "TTYP")
       (Eq (_1 (_2 ty)) "TROW"))
       (_2 (_2 ty))
       0))


;; ->
(define (elab-mod sut mod)
  (define (elab-entry sut ent[_ name span body])
    (define tc (elab-val sut (set-env-name name empty-env) body))
    (define acc? (can-gen-accessors? tc))
    (define sut1 (insert-tc name span tc sut))
    (print ("name" name acc?))
    (Ifz acc? sut1
      (gen-accessors name acc? sut1)))
  (foldl elab-entry sut mod))


(define (make-ir-entry key span val tc ir)
  ("IR_ENTRY" key span val tc ir))
(define ir-entry-val (Ix 2))
(define ir-entry-tc (Ix 3))
(define ir-entry-ir (Ix 4))

(define (fold-app f xs)
  (Ifz xs f
    (fold-app (A f (_0 xs)) (drop 1 xs))))

(define (lower-tc sut val)
  (define (tag-is x) (Eq (Hd val) x))
  (define (lower-lam lam)
    (define body (lower-tc sut (tc-lam-body lam)))
    (F y y y "LAM" (tc-lam-arity val) body))
  (define (get-hd ty[_ tag])
    (define (tag-is x) (Eq tag x))
    (cond
      ((tag-is "TNOM") (print-ref (tnom-ref ty)))
      (else
        (begin (print ("fallthrough" ty))
          0))))
  (define (lower-arms fall arms)
    (Ifz arms (lower-tc fall)
      (letrec
        ((arm (_0 arms))
         (pat-tc (lower-tc (tc-arm-pat arm)))
         (leg-tc (lower-tc (tc-arm-val arm)))
         ;; we test the let binding we made in lower-match
         (test-ir (A (K (type-fits sut (tc-ty pat-tc)) (V 0)))))
         (A
           (A (A (K Ifz) test-ir) ;; if match
             leg-tc ;; then execute pattern
            )
            (lower-arms fall (drop 1 arms)))))) ;; continue pattern
  (define (lower-match val)
    (L (tc-match-scrut val)
      (lower-arms (tc-match-fall val) (tc-match-arms val))))
  (define (lower-row row)
    (fold-app
      (K (get-hd (tc-ty row)))
      (map (lower-tc sut) (tc-row-items row))))
  (cond
    ((tag-is "TC_LOCAL")  (V (tc-local-slot val)))
    ((tag-is "TC_GLOBAL") (G (got-const (tc-global-path val))))
    ((tag-is "TC_LIT")    (K (tc-lit-val val)))
    ((tag-is "TC_FFI")    (K (tc-ffi-val val)))
    ((tag-is "TC_APP")    (A (lower-tc sut (tc-app-f val))
                             (lower-tc sut (tc-app-x val))))
    ((tag-is "TC_LAM")    (lower-lam val))
    ((tag-is "TC_ROW")    (lower-row val))
    ((tag-is "TC_TYP")    (K val))
    ((tag-is "TC_MATCH")  (lower-match val))
    (else (error ("lowering" val)))))


(define (lower-tc-entry sut key ent)
  (define tc (tc-entry-contents ent))
  (define ir (lower-tc sut tc))
  (define span (tc-entry-span ent))
  (print ("ir" ir))
  (define val (compile-expr ir))
  (define ent1 (make-ir-entry key span val tc ir))
  (insert-entry-sut key ent1 sut))

(define (lower-tc-mod sut out)
  (define n[next sut1] (pop-subject-order sut))
  (define entry (got-entry next sut))
  (Ifz (subject-order sut) out
    (let ((out1 (lower-tc-entry out next entry)))
      (lower-tc-mod sut1 out1))))

(lower-tc-mod (elab-mod default-subject (parse-foil "demo")) empty-subject)
