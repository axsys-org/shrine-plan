(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind context (#module foil-context))
(#bind core (#module foil-type-core))
(#bind subject (#module foil-subject))
(#bind nt (#module foil-new-types))
(#bind elab (#module foil-new-elab))
(#bind brand (#module shrine-brand))
(#bind builtins (#module foil-builtins))

(define (selection revision)
  (Pin (map (lambda (name)
    [(Weld [("ts" "sys") ("ts" "types")]
       (map (lambda (part) ("ts" part)) name)) revision]) core:system-names)))
(define (ctx revision)
  (context:create (selection revision) (Pin "compiler") (Pin "native declarations")
    [] [] []))
(define first (core:system-subject (ctx 1)))
(define second (core:system-subject (ctx 2)))
(define (path sut name) (Weld (subject:sut-root sut) name))
(define (runtime sut name)
  (_1 (nt:runtime-key (core:world-from-subject sut)
    (nt:type-ref (path sut name)))))
(define some1 (_0 (runtime first ["maybe" "some"])))
(define some2 (_0 (runtime second ["maybe" "some"])))
assert(Nil (Equal some1 some2))
assert(Equal [[[["ts" "sys"] ["ts" "types"] ["ts" "maybe"] ["ts" "some"]] 1]]
  (brand:decode some1))
assert(Equal 1 (_1 (runtime first ["maybe" "some"])))
assert(Equal 0 (_1 (runtime first ["maybe" "none"])))
assert(Equal 0 (_1 (runtime first ["unit"])))
(define description (elab:reflect-in-subject first 0
  (nt:type-ref (path first ["type"]))))
assert(Equal ("ref" (brand:encode
  [["ts" "sys"] ["ts" "types"] ["ts" "type"]] 1) []) description)
(define incomplete (context:create (Pin []) (Pin "compiler") (Pin "source")
  [] [] []))
assert(Eq 1 (Hd (Try (lambda (z) (force (core:system-subject incomplete))) 0)))

(define hosts (builtins:for-context (ctx 2)))
(define (host name)
  (define key (If (Equal "rex" (_0 name)) name (path hosts name)))
  (subject:tc-ffi-val (core:subject-entry-tc
    (_0 (subject:sut-find key hosts)))))
(define parse (host ["nat" "parse"]))
assert(Equal (some2 42) (parse "42"))
assert(Equal (_0 (runtime second ["maybe" "none"])) (parse "bad"))
assert(Equal 1 ((host ["maybe" "is_some"]) (parse "42")))
assert(Equal 0 ((host ["maybe" "is_some"]) (some1 42)))
assert(Equal 1 ((host ["maybe" "is_none"]) (parse "bad")))
assert(Equal (_0 (runtime second ["unit"])) (host ["unit" "unit"]))
;; Successful conversion preserves an opaque payload even when its bytes
;; happen to resemble an old constructor brand.
assert(Equal (some2 "/boot/maybe/some")
  ((host ["iota" "text"]) ("tu" "/boot/maybe/some")))
;; Host FFI storage keys do not invent public system definition moments.
assert(Equal 0 (subject:definition-moment (path hosts ["lt"]) hosts))
assert(Equal "opq" (elab:reflect-in-subject hosts 0
  (nt:type-ref (path hosts ["lt"]))))
