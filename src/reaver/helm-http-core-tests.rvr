;;;; Persistent HTTP dependency integration without the web/demo bundle.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind core-tests (#module foil-helm-core-tests))
(#import core-tests)

;;; HTTP request completion can precede dependency publication: hydration delivers it.
(#bind host-helm (#module helm-host))
(#bind host-http (#module helm-http))
(define host-core (host-helm:helm-pack [0 helm-sut]))
(define reply-record
  ((hlm ["myth" "add"]) ((hlm ["twig" "nat"]) [("ts" "res_body")] "ok")
    (t-data [("ts" "res_status")] 200)))
(define (request-record method url body target) reply-record)
(define http-helpers
  ["H" request-record (hlm ["myth" "nat_at"]) vine-make vine-cull (hlm ["myth" "txt_at"])])
(#bind http-foil (#module foil))
(define http-sut (http-foil:compile-mod http-foil:default-subject "helm_http"))
(define http-step (http-foil:source-entry-val ["http_driver" "step"] http-sut))
(define (mk-http name) (host-http:mk-http-worker (host-http:prepare http-helpers) http-step name))
(define http-seed (_0 (run-event (vine-make [tio na] t00) 0 sov0)))
(define coord
  (Seq (DeepSeq [http-helpers request-crew http-seed (mk-http na)] 0)
    (Spawn (host-helm:helm-actor host-core mk-http (lambda (hm) 0) http-seed))))
(SendCaps coord ["handle" na] [0])
(define handle-reply (Recv 0))
(define worker (Ix 0 (Ix 1 handle-reply)))
(SendCaps worker ["req" "GET" "/first" ""] [0])
(define response1 (Ix 0 (Recv 0)))
assert(Equal ["res" 200 "ok" "text/plain; charset=utf-8"] response1)
(SendCaps worker ["req" "GET" "/second" ""] [0])
(define response2 (Ix 0 (Recv 0)))
assert(Equal response1 response2)
;; A response also retires its temporary request node through a real cull.
(SendCaps coord ["query" [tio na ("ts" "r0")]] [0])
assert(Equal "/boot/res/null" (Ix 0 (Recv 0)))
(SendCaps coord ["query" [tio na ("ts" "r1")]] [0])
assert(Equal "/boot/res/null" (Ix 0 (Recv 0)))
(SendCaps coord ["stop"] [0])
(Recv 0)
(print "HTTP persistent dependency integration passed")


(print "helm HTTP core tests passed")
