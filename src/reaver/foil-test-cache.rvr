;;;; In-memory new-compiler inputs for native tests and doctests.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))
(#bind deps (#module foil-test-deps))

;; Read the graph that actually produced the cached code, including
;; generated modules and the defining modules behind test aliases.
(define (closure cache mod)
  (define (go seen pending)
    (Ifz (Sz pending) seen
      (let* ((name (_0 pending)) (rest (drop 1 pending)))
        (If (includes (Equal name) seen) (go seen rest)
          (let ((hit (foil:get-foil-cache name cache)))
            (go (snoc name seen)
              (Weld rest (If hit (foil:perc-dependencies (_0 hit)) []))))))))
  (go [] [mod]))

(define (refresh cache changed)
  (foldl (lambda (kept perc)
    (If (any (lambda (name) (includes (Equal name) changed))
          (closure cache (foil:perc-name perc)))
      kept
      (foil:put-foil-cache (foil:perc-name perc) perc kept)))
    foil:empty-foil-cache (foil:cache-results cache)))

(define (prepare cache changed mods)
  (foldl (lambda (cache mod) (_0 (source:compile cache mod)))
    (deps:prepare (refresh cache changed) mods) mods))
