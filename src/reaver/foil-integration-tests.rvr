(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-sast (#module foil-sast))
(#import foil-sast)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))

(#bind cgen (#module codegen))

(#bind foil (#module foil))


;;; Integration smoke test for the checked-in Foil fixture.  The assertions below
;;; cover both the parsed surface module and the elaborated typed subject.

(define demo-module
  (parse-module-sast 0 (ParseRex (read-text-file "foil/demo.foil"))))

(define (decl-name decl) (_1 decl))

assert(Equal 12 (Sz demo-module))
assert(Equal ["add"]             (decl-name (_0 demo-module)))
assert(Equal ["point"]           (decl-name (_1 demo-module)))
assert(Equal ["point" "add"]     (decl-name (_2 demo-module)))
assert(Equal ["circle"]          (decl-name (_3 demo-module)))
assert(Equal ["circle" "area"]   (decl-name (_4 demo-module)))
assert(Equal ["geometry"]        (decl-name (_5 demo-module)))
assert(Equal ["geometry" "area"] (decl-name (_6 demo-module)))
assert(Equal ["fst"]             (decl-name (_7 demo-module)))
assert(Equal ["snd"]             (decl-name (_8 demo-module)))
assert(Equal ["geo"]             (decl-name (_9 demo-module)))
assert(Equal ["getx"]            (decl-name (Ix 10 demo-module)))
assert(Equal ["same_as_getx"]    (decl-name (Ix 11 demo-module)))

(define typed-demo
  (foil:elab-mod foil:default-subject demo-module))

(define geometry-area-path ["geometry" "area"])

(define nat-mold (ty:TNOM ["nat"] 0))
(define nat-span (ty:TNAT 0))
(define point-mold (ty:TNOM ["point"] 0))
(define circle-mold (ty:TNOM ["circle"] 0))
(define geometry-mold (ty:TNOM ["geometry"] 0))

(define point-row-mold
  (ty:TROW (print-path ["point"])
    [(ty:TFAC "x" nat-mold)
     (ty:TFAC "y" nat-mold)]))
(define point-row-span
  (ty:TROW (print-path ["point"])
    [(ty:TFAC "x" nat-span)
     (ty:TFAC "y" nat-span)]))
(define circle-row-mold
  (ty:TROW (print-path ["circle"])
    [(ty:TFAC "center" point-mold)
     (ty:TFAC "radius" nat-mold)]))
(define circle-row-span
  (ty:TROW (print-path ["circle"])
    [(ty:TFAC "center" point-row-span)
     (ty:TFAC "radius" nat-span)]))

(define add-ty
  (ty:TFUN
    [(ty:TFAC "a" nat-mold)
     (ty:TFAC "b" nat-mold)]
    nat-mold))
(define point-add-ty
  (ty:TFUN
    [(ty:TFAC "l" point-mold)
     (ty:TFAC "r" point-mold)]
    point-mold))
(define point-accessor-ty
  (ty:TFUN [point-mold] nat-mold))
(define circle-area-ty
  (ty:TFUN [(ty:TFAC "c" circle-mold)] nat-mold))
(define geometry-area-ty
  (ty:TFUN [(ty:TFAC "g" geometry-mold)] nat-mold))

(define (binary-app-f app)
  (tc-app-f (tc-app-f app)))
(define (binary-app-left app)
  (tc-app-x (tc-app-f app)))
(define (binary-app-right app)
  (tc-app-x app))

(define point-cstr (print-path ["point"]))
(define circle-cstr (print-path ["circle"]))
(define point-val (point-cstr 3 4))
(define circle-val (circle-cstr point-val 9))

(define geometry-area-tc
  (got-entry-tc geometry-area-path typed-demo))
(define circle-area-tc
  (got-entry-tc ["circle" "area"] typed-demo))
(define circle-area-body
  (tc-lam-body circle-area-tc))
(define circle-area-radius-mul
  (binary-app-right circle-area-body))
(define geometry-area-body
  (tc-lam-body geometry-area-tc))
(define geometry-area-scrut
  (tc-match-scrut geometry-area-body))
(define geometry-area-arms
  (tc-match-arms geometry-area-body))
(define point-arm (_0 geometry-area-arms))
(define circle-arm (_1 geometry-area-arms))
(define circle-arm-val (tc-arm-val circle-arm))

(define geometry-area-ref
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (ParseRex "geometry:area"))))
(define geometry-area-fst
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (ParseRex "(geometry:area fst)"))))
(define plain-row
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (ParseRex "[1 2]"))))
(define constructed-point
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (ParseRex "(point 1 2)"))))
(define point-add-body
  (tc-lam-body (got-entry-tc ["point" "add"] typed-demo)))
(define geo-tc
  (got-entry-tc ["geo"] typed-demo))
(define geo-ir
  (foil:lower-tc typed-demo geo-tc))

assert(Equal point-row-mold (got-type ["point"] typed-demo))
assert(Equal point-row-span
  (ty:mold-to-span typed-demo (got-type ["point"] typed-demo)))
assert(Equal point-mold
  (ty:span-to-mold typed-demo point-row-span))

assert(Equal circle-row-mold (got-type ["circle"] typed-demo))
assert(Equal circle-row-span
  (ty:mold-to-span typed-demo (got-type ["circle"] typed-demo)))
assert(Equal circle-mold
  (ty:span-to-mold typed-demo circle-row-span))

assert(Equal (ty:TSUM [circle-mold point-mold])
  (got-type ["geometry"] typed-demo))
assert(Equal "/geometry/area" (print-path geometry-area-path))

assert(Equal Inc (tc-ffi-val (got-entry-tc ["inc"] foil:default-subject)))
assert(Equal Mul (tc-ffi-val (got-entry-tc ["mul"] foil:default-subject)))
assert(Equal Dec (tc-ffi-val (got-entry-tc ["dec"] foil:default-subject)))

assert(Equal add-ty
  (tc-ty (got-entry-tc ["add"] typed-demo)))
assert(Equal point-add-ty
  (tc-ty (got-entry-tc ["point" "add"] typed-demo)))
assert(Equal point-accessor-ty
  (tc-ty (got-entry-tc ["point" "x"] typed-demo)))
assert(Equal point-accessor-ty
  (tc-ty (got-entry-tc ["point" "y"] typed-demo)))
assert(Equal (ty:TFUN [circle-mold] point-mold)
  (tc-ty (got-entry-tc ["circle" "center"] typed-demo)))
assert(Equal (ty:TFUN [circle-mold] nat-mold)
  (tc-ty (got-entry-tc ["circle" "radius"] typed-demo)))
assert(Equal circle-area-ty
  (tc-ty circle-area-tc))
assert(Equal geometry-area-ty
  (tc-ty geometry-area-tc))

assert(Equal "TC_APP" (Hd circle-area-body))
assert(Equal Mul (tc-ffi-val (binary-app-f circle-area-body)))
assert(Equal "TC_LIT" (Hd (binary-app-left circle-area-body)))
assert(Equal 3 (tc-lit-val (binary-app-left circle-area-body)))
assert(Equal "TC_APP" (Hd circle-area-radius-mul))
assert(Equal Mul (tc-ffi-val (binary-app-f circle-area-radius-mul)))

assert(ty:type-nests? typed-demo geometry-mold point-mold)
assert(ty:type-nests? typed-demo geometry-mold circle-mold)
assert(Nil (ty:type-nests? typed-demo point-mold geometry-mold))
assert(Nil (ty:type-nests? typed-demo point-mold (tc-ty plain-row)))
assert(Nil (ty:type-nests? typed-demo (tc-ty plain-row) point-mold))
assert(Equal nat-span
  (ty:type-apply typed-demo geometry-area-ty [point-mold]))
assert(Equal nat-span
  (ty:type-apply typed-demo geometry-area-ty [circle-mold]))

assert(Equal 0 (ty:type-fits typed-demo point-mold point-val))
assert(Equal 0 (ty:type-fits typed-demo circle-mold circle-val))
assert(Equal 0 (ty:type-fits typed-demo geometry-mold point-val))
assert(Equal 0 (ty:type-fits typed-demo geometry-mold circle-val))
assert(Nil (Equal 0 (ty:type-fits typed-demo point-mold circle-val)))

assert(Equal geometry-area-tc geometry-area-ref)
assert(Equal nat-span (tc-ty geometry-area-fst))
assert(Equal geometry-area-tc (tc-app-f geometry-area-fst))
assert(Equal (got-entry-tc ["fst"] typed-demo) (tc-app-x geometry-area-fst))
assert(Equal (ty:TROW 0 [nat-span nat-span]) (tc-ty plain-row))
assert(Equal point-mold (tc-ty constructed-point))
assert(Equal "TC_ROW" (Hd constructed-point))
assert(Equal "TC_ROW" (Hd point-add-body))
assert(Equal point-mold (tc-ty point-add-body))
assert(Equal
  (cgen:A (cgen:A (cgen:K point-cstr) (cgen:K 3)) (cgen:K 4))
  geo-ir)

assert(Equal "TC_MATCH" (Hd geometry-area-body))
assert(Equal nat-mold (tc-ty geometry-area-body))
assert(Equal (ty:TFAC "g" geometry-mold) (tc-ty geometry-area-scrut))
assert(Equal 1 (tc-local-slot geometry-area-scrut))
assert(Equal 2 (Sz geometry-area-arms))
assert(Equal (tc-mean "unreachable") (tc-match-fall geometry-area-body))
assert(Equal point-mold (tc-arm-pat point-arm))
assert(Equal nat-span (tc-ty point-arm))
assert(Equal nat-span (tc-ty (tc-arm-val point-arm)))
assert(Equal (ty:TFAC "c" circle-mold) (tc-arm-pat circle-arm))
assert(Equal nat-span (tc-ty circle-arm))
assert(Equal nat-span (tc-ty circle-arm-val))
assert(Equal "TC_APP" (Hd circle-arm-val))
assert(Equal circle-area-tc (tc-app-f circle-arm-val))
assert(Equal 0 (tc-local-slot (tc-app-x circle-arm-val)))
assert(Equal (ty:TFAC "c" circle-mold)
  (tc-ty (tc-app-x circle-arm-val)))

assert(Equal point-mold
  (tc-ty (got-entry-tc ["fst"] typed-demo)))
assert(Equal point-mold
  (tc-ty (got-entry-tc ["snd"] typed-demo)))
assert(Equal geometry-mold
  (tc-ty geo-tc))
assert(Equal nat-span
  (tc-ty (got-entry-tc ["getx"] typed-demo)))
assert(Equal nat-span
  (tc-ty (got-entry-tc ["same_as_getx"] typed-demo)))

(print "foil integration tests passed")
