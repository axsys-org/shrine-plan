(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-sast (#module foil-sast))
(#import foil-sast)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind ty (#module foil-types))

(#bind cgen (#module codegen))

(#bind rex (#module rex))

(#bind foil (#module foil))


;;; Integration smoke test for the checked-in Foil fixture.  The assertions below
;;; cover both the parsed surface module and the elaborated typed subject.

(define demo-module
  (parse-module-sast 0 (rex:ParseRexNorm (read-text-file "foil/demo.foil"))))

(define (decl-name decl) (_1 decl))

assert(Equal 20 (Sz demo-module))
assert(Equal ["add"]             (decl-name (_0 demo-module)))
assert(Equal ["point"]           (decl-name (_1 demo-module)))
assert(Equal ["point" "add"]     (decl-name (_2 demo-module)))
assert(Equal ["circle"]          (decl-name (_3 demo-module)))
assert(Equal ["circle" "area"]   (decl-name (_4 demo-module)))
assert(Equal ["geometry"]        (decl-name (_5 demo-module)))
assert(Equal ["geometry" "area"] (decl-name (_6 demo-module)))
assert(Equal ["fst"]             (decl-name (_7 demo-module)))
assert(Equal ["snd"]             (decl-name (_8 demo-module)))
assert(Equal ["geo"]             (decl-name (_9 demo-module)))
assert(Equal ["getx"]            (decl-name (Ix 10 demo-module)))
assert(Equal ["same_as_getx"]    (decl-name (Ix 11 demo-module)))
assert(Equal ["maybe_nat"]       (decl-name (Ix 12 demo-module)))
assert(Equal ["maybe_nat" "map"] (decl-name (Ix 13 demo-module)))
assert(Equal ["maybe_nat" "or_default"] (decl-name (Ix 14 demo-module)))
assert(Equal ["test_maybe_nat"]  (decl-name (Ix 15 demo-module)))
assert(Equal ["test_maybe_nat_missing"] (decl-name (Ix 16 demo-module)))
assert(Equal ["test_maybe_inc"]  (decl-name (Ix 17 demo-module)))
assert(Equal ["test_add_ufcs"]   (decl-name (Ix 18 demo-module)))
assert(Equal ["test_or_default"] (decl-name (Ix 19 demo-module)))

(define typed-demo
  (foil:elab-mod foil:default-subject demo-module))

(define geometry-area-path ["boot" "geometry" "area"])

;; Nominal identities are rooted: /boot is the compilation root.
(define (bt p) (Weld ["boot"] p))
(define nat-mold (ty:TNOM ["nat"] 0))
(define nat-span (ty:TNAT 0))
(define uint-mold (ty:TNOM ["uint"] 0))
(define unit-mold (ty:TNOM ["unit"] 0))
;; Applications are /ty-ap paths.
(define (applied-mold base args)
  (ty:TNOM (ty-ap-encode (Weld [base] args)) 0))
(define row-uint-mold (applied-mold ["row"] [["uint"]]))
(define list-uint-mold (applied-mold ["list"] [["uint"]]))
(define either-uint-unit-mold (applied-mold ["either"] [["uint"] ["unit"]]))
(define point-mold (ty:TNOM (bt ["point"]) 0))
(define circle-mold (ty:TNOM (bt ["circle"]) 0))
(define geometry-mold (ty:TNOM (bt ["geometry"]) 0))
(define maybe_nat_mold (ty:TNOM (bt ["maybe_nat"]) 0))

(define point-row-mold
  (ty:TROW (print-path ["boot" "point"])
    [(ty:TFAC "x" nat-mold)
     (ty:TFAC "y" nat-mold)]))
(define point-row-span
  (ty:TROW (print-path ["boot" "point"])
    [(ty:TFAC "x" nat-span)
     (ty:TFAC "y" nat-span)]))
(define circle-row-mold
  (ty:TROW (print-path ["boot" "circle"])
    [(ty:TFAC "center" point-mold)
     (ty:TFAC "radius" nat-mold)]))
(define circle-row-span
  (ty:TROW (print-path ["boot" "circle"])
    [(ty:TFAC "center" point-row-span)
     (ty:TFAC "radius" nat-span)]))
(define some-row-mold
  (ty:TROW "some" [nat-mold]))
(define some-row-span
  (ty:TROW "some" [nat-span]))
(define some-a-row-span
  (ty:TROW "some" [(ty:TFAC "a" nat-span)]))
;; Arm patterns keep their declared molds now (type-meet returns the
;; nested side unexpanded).
(define some-a-row-mold
  (ty:TROW "some" [(ty:TFAC "a" nat-mold)]))
(define none-row
  (ty:TROW "none" []))
(define maybe_nat_type
  (ty:TSUM [some-row-mold none-row]))
(define maybe_nat_span
  (ty:TSUM [some-row-span none-row]))
(define poly-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  maybe
  (@ a)
  &  ($some a)
     $none
+  maybe_nat_alias
  maybe[nat]
+  id
  (@ a)
  \  x=a
  x
+  id_nat
  ^  nat
  (id[nat] 3)
")))
(define typed-poly
  (foil:elab-mod foil:default-subject poly-module))
(define builtins-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  num
  ^  uint
  10
+  num_added
  ^  uint
  num.add(4)
+  num_subbed
  ^  uint
  num.sub(3)
+  num_lt
  ^  uint
  num.lt(20)
+  nums
  ^  row[uint]
  [1 2 3]
+  nums_size
  ^  uint
  nums.size
+  nums_get
  ^  uint
  nums.get(1)
+  nums_more
  ^  row[uint]
  nums.snoc(4)
+  nums_prefixed
  ^  row[uint]
  nums.cons(0)
+  nums_take
  ^  row[uint]
  nums.take(2)
+  nums_drop
  ^  row[uint]
  nums.drop(1)
+  nums_list
  ^  list[uint]
  (list/cons[uint] 1 list/nil[uint])
+  nums_list_more
  ^  list[uint]
  nums_list.cons(0)
+  nums_list_head
  ^  uint
  nums_list.head
+  nums_list_tail
  ^  list[uint]
  nums_list.tail
+  nums_list_nonempty
  ^  uint
  nums_list.is_cons
+  nums_list_mapped
  nums_list.map(inc)
+  either_val
  ^  either[uint unit]
  (either/left[uint unit] 7)
+  either_right
  ^  either[uint unit]
  (either/right[uint unit] (unit))
+  either_check
  ^  uint
  either_val.is_left
+  either_unwrap
  ^  uint
  either_val.left_val
")))
(define typed-builtins
  (foil:elab-mod foil:default-subject builtins-module))
(define maybe-poly-type
  (ty:TQUA "a"
    (ty:TSUM [(ty:TROW "some" [(ty:TVAR "a")]) none-row])))
(define id-poly-type
  (ty:TQUA "a"
    (ty:TFUN [(ty:TFAC "x" (ty:TVAR "a"))]
      (ty:TFAC "x" (ty:TVAR "a")))))

(define add-ty
  (ty:TFUN
    [(ty:TFAC "a" nat-mold)
     (ty:TFAC "b" nat-mold)]
    nat-mold))
(define add-ty-span
  (ty:TFUN
    [(ty:TFAC "a" nat-span)
     (ty:TFAC "b" nat-span)]
    nat-span))
(define point-add-ty
  (ty:TFUN
    [(ty:TFAC "l" point-mold)
     (ty:TFAC "r" point-mold)]
    point-mold))
(define point-accessor-ty
  (ty:TFUN [point-mold] nat-mold))
(define circle-area-ty
  (ty:TFUN [(ty:TFAC "c" circle-mold)] nat-mold))
(define geometry-area-ty
  (ty:TFUN [(ty:TFAC "g" geometry-mold)] nat-mold))
(define or-default-ty
  (ty:TFUN
    [(ty:TFAC "default" nat-mold)
     (ty:TFAC "x" maybe_nat_mold)]
    nat-mold))
(define maybe-nat-map-ty
  (ty:TFUN
    [(ty:TFAC "fun" (ty:TFUN [nat-mold] nat-mold))
     (ty:TFAC "x" maybe_nat_mold)]
    nat-mold))

(define (binary-app-f app)
  (tc-app-f (tc-app-f app)))
(define (binary-app-left app)
  (tc-app-x (tc-app-f app)))
(define (binary-app-right app)
  (tc-app-x app))

(define point-cstr (print-path ["boot" "point"]))
(define circle-cstr (print-path ["boot" "circle"]))
(define point-val (point-cstr 3 4))
(define circle-val (circle-cstr point-val 9))
(define some-val ("some" 3))
(define none-val "none")

(define geometry-area-tc
  (got-entry-tc geometry-area-path typed-demo))
(define test-maybe-nat-tc
  (got-entry-tc (Weld ["boot"] ["test_maybe_nat"]) typed-demo))
(define or-default-tc
  (got-entry-tc (Weld ["boot"] ["maybe_nat" "or_default"]) typed-demo))
(define maybe-nat-map-tc
  (got-entry-tc (Weld ["boot"] ["maybe_nat" "map"]) typed-demo))
(define test-maybe-inc-tc
  (got-entry-tc (Weld ["boot"] ["test_maybe_inc"]) typed-demo))
(define test-add-ufcs-tc
  (got-entry-tc (Weld ["boot"] ["test_add_ufcs"]) typed-demo))
(define test-or-default-tc
  (got-entry-tc (Weld ["boot"] ["test_or_default"]) typed-demo))
(define or-default-body
  (tc-lam-body or-default-tc))
(define or-default-scrut
  (tc-match-scrut or-default-body))
(define or-default-arms
  (tc-match-arms or-default-body))
(define or-default-some-arm
  (_0 or-default-arms))
(define or-default-none-arm
  (_1 or-default-arms))
(define or-default-some-val
  (tc-arm-val or-default-some-arm))
(define or-default-none-val
  (tc-arm-val or-default-none-arm))
(define circle-area-tc
  (got-entry-tc (Weld ["boot"] ["circle" "area"]) typed-demo))
(define circle-area-body
  (tc-lam-body circle-area-tc))
(define circle-area-radius-mul
  (binary-app-right circle-area-body))
(define geometry-area-body
  (tc-lam-body geometry-area-tc))
(define geometry-area-scrut
  (tc-match-scrut geometry-area-body))
(define geometry-area-arms
  (tc-match-arms geometry-area-body))
(define point-arm (_0 geometry-area-arms))
(define circle-arm (_1 geometry-area-arms))
(define circle-arm-val (tc-arm-val circle-arm))

(define geometry-area-ref
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "geometry/area"))))
(define geometry-area-fst
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "(geometry/area fst)"))))
(define plain-row
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "[1 2]"))))
(define constructed-point
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "(point 1 2)"))))
(define some-three
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "($some 3)"))))
(define none-tc
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "$none"))))
(define maybe-some-three
  (foil:elab-val typed-demo foil:empty-env
    (surf-cast (surf-ref ["maybe_nat"])
      (surf-app (surf-variant "some") [(surf-lit 3)]))))
(define maybe-none
  (foil:elab-val typed-demo foil:empty-env
    (surf-cast (surf-ref ["maybe_nat"])
      (surf-variant "none"))))
(define pinned-nat
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "(pin[nat] 3)"))))
(define unpinned-nat
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "(unpin[nat] (pin[nat] 3))"))))
(define pinned-add
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "(pin[{a=nat; b=nat; nat}] add)"))))
(define pinned-add-call
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "((pin[{a=nat; b=nat; nat}] add) 1 2)"))))
(define truthy-if-nat
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm "? 1 2
3"))))
(define point-add-body
  (tc-lam-body (got-entry-tc (Weld ["boot"] ["point" "add"]) typed-demo)))
(define geo-tc
  (got-entry-tc (Weld ["boot"] ["geo"]) typed-demo))
(define geo-ir
  (foil:lower-tc typed-demo geo-tc))

assert(Equal point-row-mold (got-type (Weld ["boot"] ["point"]) typed-demo))
assert(Equal point-row-span
  (ty:mold-to-span typed-demo (got-type (Weld ["boot"] ["point"]) typed-demo)))
assert(Equal point-mold
  (ty:span-to-mold typed-demo point-row-span))

assert(Equal circle-row-mold (got-type (Weld ["boot"] ["circle"]) typed-demo))
assert(Equal circle-row-span
  (ty:mold-to-span typed-demo (got-type (Weld ["boot"] ["circle"]) typed-demo)))
assert(Equal circle-mold
  (ty:span-to-mold typed-demo circle-row-span))

assert(Equal (ty:TSUM [circle-mold point-mold])
  (got-type (Weld ["boot"] ["geometry"]) typed-demo))
assert(Equal maybe_nat_type
  (got-type (Weld ["boot"] ["maybe_nat"]) typed-demo))
assert(Equal maybe_nat_span
  (ty:mold-to-span typed-demo (got-type (Weld ["boot"] ["maybe_nat"]) typed-demo)))
assert(Equal "/boot/geometry/area" (print-path geometry-area-path))
assert(Equal maybe-poly-type
  (got-type (Weld ["boot"] ["maybe"]) typed-poly))
;; A bare-name alias is nominal — the same /ty-ap path type position
;; produces — and still expands to the structural sum.
assert(Equal (applied-mold (bt ["maybe"]) [["nat"]])
  (got-type (Weld ["boot"] ["maybe_nat_alias"]) typed-poly))
assert(Equal maybe_nat_span
  (ty:mold-to-span typed-poly (got-type (Weld ["boot"] ["maybe_nat_alias"]) typed-poly)))
assert(Equal id-poly-type
  (tc-ty (got-entry-tc (Weld ["boot"] ["id"]) typed-poly)))
assert(Equal nat-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["id_nat"]) typed-poly)))

;; A named function type stores the function type itself (regression:
;; unwrapped s_tfun used to store its arity via the TTYP extraction).

(define tfun-decl-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  natfun
  $  {nat; nat}
")))
(define typed-tfun
  (foil:elab-mod foil:default-subject tfun-decl-module))
assert(Equal (ty:TFUN [nat-mold] nat-mold)
  (got-type (Weld ["boot"] ["natfun"]) typed-tfun))

assert(Equal Inc (tc-ffi-val (got-entry-tc ["inc"] foil:default-subject)))
assert(Equal Mul (tc-ffi-val (got-entry-tc ["mul"] foil:default-subject)))
assert(Equal Dec (tc-ffi-val (got-entry-tc ["dec"] foil:default-subject)))
assert(Equal Pin (tc-ffi-val (got-entry-tc ["pin"] foil:default-subject)))
assert(Equal Unpin (tc-ffi-val (got-entry-tc ["unpin"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["uint" "add"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["row" "size"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["list" "cons"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["either" "left"] foil:default-subject)))

assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["num_added"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["num_subbed"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["num_lt"]) typed-builtins)))
assert(Equal row-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_size"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_get"]) typed-builtins)))
assert(Equal row-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_more"]) typed-builtins)))
assert(Equal row-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_prefixed"]) typed-builtins)))
assert(Equal row-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_take"]) typed-builtins)))
assert(Equal row-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_drop"]) typed-builtins)))
assert(Equal list-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list"]) typed-builtins)))
assert(Equal list-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list_more"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list_head"]) typed-builtins)))
assert(Equal list-uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list_tail"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list_nonempty"]) typed-builtins)))
;; An inferred generic result keeps the declared /ty-ap result name;
;; quantified application does not recover it from a structural span.
assert(Equal (applied-mold ["list"] [["nat"]])
  (tc-ty (got-entry-tc (Weld ["boot"] ["nums_list_mapped"]) typed-builtins)))
assert(Equal either-uint-unit-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["either_val"]) typed-builtins)))
assert(Equal either-uint-unit-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["either_right"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["either_check"]) typed-builtins)))
assert(Equal uint-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["either_unwrap"]) typed-builtins)))

assert(Equal add-ty
  (tc-ty (got-entry-tc (Weld ["boot"] ["add"]) typed-demo)))
assert(Equal point-add-ty
  (tc-ty (got-entry-tc (Weld ["boot"] ["point" "add"]) typed-demo)))
assert(Equal point-accessor-ty
  (tc-ty (got-entry-tc (Weld ["boot"] ["point" "x"]) typed-demo)))
assert(Equal point-accessor-ty
  (tc-ty (got-entry-tc (Weld ["boot"] ["point" "y"]) typed-demo)))
assert(Equal (ty:TFUN [circle-mold] point-mold)
  (tc-ty (got-entry-tc (Weld ["boot"] ["circle" "center"]) typed-demo)))
assert(Equal (ty:TFUN [circle-mold] nat-mold)
  (tc-ty (got-entry-tc (Weld ["boot"] ["circle" "radius"]) typed-demo)))
assert(Equal circle-area-ty
  (tc-ty circle-area-tc))
assert(Equal geometry-area-ty
  (tc-ty geometry-area-tc))
assert(Equal maybe_nat_mold
  (tc-ty test-maybe-nat-tc))
assert(Equal or-default-ty
  (tc-ty or-default-tc))
assert(Equal maybe-nat-map-ty
  (tc-ty maybe-nat-map-tc))
;; Applications now keep the declared (nominal) return mold instead of
;; span-expanding it.
assert(Equal nat-mold
  (tc-ty test-maybe-inc-tc))
assert(Equal nat-mold
  (tc-ty test-add-ufcs-tc))
assert(Equal nat-mold
  (tc-ty test-or-default-tc))
assert(Equal (ty:TPIN nat-mold)
  (tc-ty pinned-nat))
assert(Equal nat-mold
  (tc-ty unpinned-nat))
assert(Equal (ty:TPIN add-ty)
  (tc-ty pinned-add))
assert(Equal nat-mold
  (tc-ty pinned-add-call))
assert(Equal nat-span
  (tc-ty truthy-if-nat))
assert(Equal If
  (tc-ffi-val (tc-app-f (tc-app-f (tc-app-f truthy-if-nat)))))

assert(Equal "TC_APP" (Hd circle-area-body))
assert(Equal Mul (tc-ffi-val (binary-app-f circle-area-body)))
assert(Equal "TC_LIT" (Hd (binary-app-left circle-area-body)))
assert(Equal 3 (tc-lit-val (binary-app-left circle-area-body)))
assert(Equal "TC_APP" (Hd circle-area-radius-mul))
assert(Equal Mul (tc-ffi-val (binary-app-f circle-area-radius-mul)))

assert(ty:type-nests? typed-demo geometry-mold point-mold)
assert(ty:type-nests? typed-demo geometry-mold circle-mold)
assert(Nil (ty:type-nests? typed-demo point-mold geometry-mold))
assert(Nil (ty:type-nests? typed-demo point-mold (tc-ty plain-row)))
assert(Nil (ty:type-nests? typed-demo (tc-ty plain-row) point-mold))
assert(ty:type-nests? typed-demo maybe_nat_mold (tc-ty some-three))
assert(ty:type-nests? typed-demo maybe_nat_mold (tc-ty none-tc))
assert(Equal nat-mold
  (ty:type-apply typed-demo geometry-area-ty [point-mold]))
assert(Equal nat-mold
  (ty:type-apply typed-demo geometry-area-ty [circle-mold]))

assert(Equal 0 (ty:type-fits typed-demo point-mold point-val))
assert(Equal 0 (ty:type-fits typed-demo circle-mold circle-val))
assert(Equal 0 (ty:type-fits typed-demo geometry-mold point-val))
assert(Equal 0 (ty:type-fits typed-demo geometry-mold circle-val))
assert(Equal 0 (ty:type-fits typed-demo maybe_nat_mold some-val))
assert(Equal 0 (ty:type-fits typed-demo maybe_nat_mold none-val))
assert(Nil (Equal 0 (ty:type-fits typed-demo point-mold circle-val)))
assert(Nil (Equal 0 (ty:type-fits typed-demo maybe_nat_mold point-val)))

;; Function references elaborate by name: a TC_GLOBAL carrying the
;; referee's type, not the embedded referee TC.
(define geometry-area-glo
  (tc-global geometry-area-ty geometry-area-path))
assert(Equal geometry-area-glo geometry-area-ref)
assert(Equal nat-mold (tc-ty geometry-area-fst))
assert(Equal geometry-area-glo (tc-app-f geometry-area-fst))
;; Value entries reference by name too (nullary constants share their
;; forced compiled value instead of re-elaborating per use).
assert(Equal
  (tc-global (tc-ty (got-entry-tc (Weld ["boot"] ["fst"]) typed-demo))
    (Weld ["boot"] ["fst"]))
  (tc-app-x geometry-area-fst))
;; literal precision: row-literal elements carry their constants
assert(Equal (ty:TROW 0 [(ty:TNAT 1) (ty:TNAT 2)]) (tc-ty plain-row))
assert(Equal point-mold (tc-ty constructed-point))
assert(Equal (ty:TROW "some" [(ty:TNAT 3)]) (tc-ty some-three))
assert(Equal none-row (tc-ty none-tc))
assert(Equal maybe_nat_mold (tc-ty maybe-some-three))
assert(Equal maybe_nat_mold (tc-ty maybe-none))
assert(Equal "TC_ROW" (Hd constructed-point))
assert(Equal "TC_ROW" (Hd some-three))
assert(Equal "TC_ROW" (Hd none-tc))
assert(Equal "TC_ROW" (Hd point-add-body))
assert(Equal point-mold (tc-ty point-add-body))
;; geo references the value entry fst by name now: its IR is a global
;; link to fst's forced compiled value, not an inline reconstruction.
assert(Equal
  (cgen:G (got-const (Weld ["boot"] ["fst"]) typed-demo))
  geo-ir)
assert(Equal
  (cgen:A (cgen:K "some") (cgen:K 3))
  (foil:lower-tc typed-demo some-three))
assert(Equal
  (cgen:K "none")
  (foil:lower-tc typed-demo none-tc))
assert(Equal
  (cgen:A (cgen:K "some") (cgen:K 3))
  (foil:lower-tc typed-demo test-maybe-nat-tc))

assert(Equal "TC_MATCH" (Hd or-default-body))
assert(Equal nat-mold (tc-ty or-default-body))
assert(Equal (ty:TFAC "x" maybe_nat_mold) (tc-ty or-default-scrut))
assert(Equal 2 (tc-local-slot or-default-scrut))
assert(Equal 2 (Sz or-default-arms))
;; the implicit fall names the match: it carries the arms' dispatch keys
assert(Equal (tc-mean ["unreachable" [["key" "some" 1] ["key" "none" 0]]])
             (tc-match-fall or-default-body))
assert(Equal some-a-row-mold (tc-arm-pat or-default-some-arm))
assert(Equal none-row (tc-arm-pat or-default-none-arm))
assert(Equal (ty:TFAC "a" nat-mold) (tc-ty or-default-some-arm))
assert(Equal (ty:TFAC "default" nat-mold) (tc-ty or-default-none-arm))
assert(Equal "TC_LOCAL" (Hd or-default-some-val))
assert(Equal "TC_LOCAL" (Hd or-default-none-val))
assert(Equal [0 0] (tc-local-slot or-default-some-val))
assert(Equal 2 (tc-local-slot or-default-none-val))
assert(Equal (ty:TFAC "a" nat-mold) (tc-ty or-default-some-val))
assert(Equal (ty:TFAC "default" nat-mold) (tc-ty or-default-none-val))
assert(Equal
  (cgen:A (cgen:A (cgen:K Ix) (cgen:K 0)) (cgen:V 0))
  (foil:lower-tc typed-demo or-default-some-val))
assert(Equal
  (cgen:V 2)
  (foil:lower-tc typed-demo or-default-none-val))

assert(Equal "TC_MATCH" (Hd geometry-area-body))
assert(Equal nat-mold (tc-ty geometry-area-body))
assert(Equal (ty:TFAC "g" geometry-mold) (tc-ty geometry-area-scrut))
assert(Equal 1 (tc-local-slot geometry-area-scrut))
assert(Equal 2 (Sz geometry-area-arms))
assert(Equal (tc-mean ["unreachable" [["key" point-cstr 2] ["key" circle-cstr 2]]])
             (tc-match-fall geometry-area-body))
assert(Equal point-mold (tc-arm-pat point-arm))
assert(Equal nat-span (tc-ty point-arm))
assert(Equal nat-span (tc-ty (tc-arm-val point-arm)))
assert(Equal (ty:TFAC "c" circle-mold) (tc-arm-pat circle-arm))
assert(Equal nat-mold (tc-ty circle-arm))
assert(Equal nat-mold (tc-ty circle-arm-val))
assert(Equal "TC_APP" (Hd circle-arm-val))
assert(Equal (tc-global circle-area-ty (bt ["circle" "area"]))
  (tc-app-f circle-arm-val))
assert(Equal 0 (tc-local-slot (tc-app-x circle-arm-val)))
assert(Equal (ty:TFAC "c" circle-mold)
  (tc-ty (tc-app-x circle-arm-val)))

assert(Equal point-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["fst"]) typed-demo)))
assert(Equal point-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["snd"]) typed-demo)))
assert(Equal geometry-mold
  (tc-ty geo-tc))
assert(Equal nat-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["getx"]) typed-demo)))
assert(Equal nat-mold
  (tc-ty (got-entry-tc (Weld ["boot"] ["same_as_getx"]) typed-demo)))

(define compiled-bst
  (foil:compile-mod foil:default-subject "bst"))

assert(Equal "TC_TYP"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "empty"]) compiled-bst)))
assert(Equal "TC_TYP"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "node"]) compiled-bst)))
assert(Equal "TC_FFI"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "node" "l"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "size"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "get"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "map"]) compiled-bst)))

(print "foil integration tests passed")
