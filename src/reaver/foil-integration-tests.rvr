(#bind brand (#module shrine-brand))
(#bind reflection-demo (#module reflect-demo))
(#bind fixture (#module foil-test-context))
(#bind elab (#module foil-new-elab))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil-sast (#module foil-sast))
(#import foil-sast)
(#bind foil-subject (#module foil-subject))
(#import foil-subject)
(#bind rex (#module rex))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind builtins (#module foil-builtins))

(define (check z)
  (define (compile name tree)
    (driver:perc-subject (_1 (source:compile-rex
      (fixture:tree 0 name tree) 0 name tree))))
  (define (live-elab sut surf)
    (_1 (elab:elab-value (elab:compiler-for sut) surf)))
  ;;;; Copyright (c) 2026 xoCore Technologies, Benjamin Summers
  ;;;; SPDX-License-Identifier: MIT
  ;;;; See LICENSE for full terms.








  ;;; Integration smoke test for the checked-in Foil fixture.  The parsed
  ;;; surface shape is asserted exactly; for elaboration the test is that
  ;;; the fixtures COMPILE and that live value elaboration produces TCs.
  ;;; Type-value shape assertions live in foil-new-types-tests and
  ;;; foil-new-elab-tests; this suite checks source-level integration.

  (define demo-tree (source:read-module "demo"))
  (define demo-module (foil-sast:parse-module-sast 0 demo-tree))

  (define (decl-name decl) (_1 decl))

  assert(Equal 22 (Sz demo-module))
  assert(Equal ["add"]             (decl-name (_0 demo-module)))
  assert(Equal ["point"]           (decl-name (_1 demo-module)))
  assert(Equal ["point" "add"]     (decl-name (_2 demo-module)))
  assert(Equal ["circle"]          (decl-name (_3 demo-module)))
  assert(Equal ["circle" "area"]   (decl-name (_4 demo-module)))
  assert(Equal ["geometry"]        (decl-name (_5 demo-module)))
  assert(Equal ["geometry" "area"] (decl-name (_6 demo-module)))
  assert(Equal ["fst"]             (decl-name (_7 demo-module)))
  assert(Equal ["snd"]             (decl-name (_8 demo-module)))
  assert(Equal ["geo"]             (decl-name (_9 demo-module)))
  assert(Equal ["getx"]            (decl-name (Ix 10 demo-module)))
  assert(Equal ["same_as_getx"]    (decl-name (Ix 11 demo-module)))
  assert(Equal ["maybe_nat"]       (decl-name (Ix 12 demo-module)))
  assert(Equal ["maybe_nat" "some"] (decl-name (Ix 13 demo-module)))
  assert(Equal ["maybe_nat" "none"] (decl-name (Ix 14 demo-module)))
  assert(Equal ["maybe_nat" "map"] (decl-name (Ix 15 demo-module)))
  assert(Equal ["maybe_nat" "or_default"] (decl-name (Ix 16 demo-module)))
  assert(Equal ["test_maybe_nat"]  (decl-name (Ix 17 demo-module)))
  assert(Equal ["test_maybe_nat_missing"] (decl-name (Ix 18 demo-module)))
  assert(Equal ["test_maybe_inc"]  (decl-name (Ix 19 demo-module)))
  assert(Equal ["test_add_ufcs"]   (decl-name (Ix 20 demo-module)))
  assert(Equal ["test_or_default"] (decl-name (Ix 21 demo-module)))

  ;;; Elaboration uses an explicitly prepared system and publisher context.

  (define typed-demo
    (compile "demo" demo-tree))
  assert(IsApp (got-entry-tc (root-path typed-demo ["geometry" "area"]) typed-demo))
  assert(IsApp (got-entry-tc (root-path typed-demo ["maybe_nat" "or_default"]) typed-demo))
  assert(IsApp (got-entry-tc (root-path typed-demo ["point" "x"]) typed-demo))
  assert(IsApp (got-entry-tc (root-path typed-demo ["same_as_getx"]) typed-demo))

  (define poly-tree
    (rex:ParseRexNorm "
+  maybe
  (@ a)
  &  ($some a)
     $none
+  maybe_nat_alias
  maybe[nat]
+  id
  (@ a)
  \  x=a
  x
+  id_nat
  ^  nat
  (id[nat] 3)
"))
  (define typed-poly
    (compile "integration_poly" poly-tree))
  assert(IsApp (got-entry-tc (root-path typed-poly ["maybe"]) typed-poly))
  assert(IsApp (got-entry-tc (root-path typed-poly ["id_nat"]) typed-poly))

  (define builtins-tree
    (rex:ParseRexNorm "
+  num
  ^  uint
  10
+  num_added
  ^  uint
  num.add(4)
+  num_subbed
  ^  uint
  num.sub(3)
+  num_lt
  ^  uint
  num.lt(20)
+  nums
  ^  row[uint]
  [1 2 3]
+  nums_size
  ^  uint
  nums.size
+  nums_get
  ^  uint
  nums.get(1)
+  nums_more
  ^  row[uint]
  nums.snoc(4)
+  nums_prefixed
  ^  row[uint]
  nums.cons(0)
+  nums_take
  ^  row[uint]
  nums.take(2)
+  nums_drop
  ^  row[uint]
  nums.drop(1)
+  nums_list
  ^  list[uint]
  (list/cons[uint] 1 list/nil[uint])
+  nums_list_more
  ^  list[uint]
  nums_list.cons(0)
+  nums_list_head
  ^  uint
  nums_list.head
+  nums_list_tail
  ^  list[uint]
  nums_list.tail
+  nums_list_nonempty
  ^  uint
  nums_list.is_cons
+  nums_list_mapped
  nums_list.map(inc)
+  either_val
  ^  either[uint unit]
  (either/err[uint unit] 7)
+  either_right
  ^  either[uint unit]
  (either/ok[uint unit] (unit))
+  either_check
  ^  uint
  either_val.is_err
+  either_unwrap
  ^  uint
  either_val.err_val
"))
  (define typed-builtins
    (compile "integration_builtins" builtins-tree))
  assert(IsApp (got-entry-tc (root-path typed-builtins ["nums_list_mapped"]) typed-builtins))
  assert(IsApp (got-entry-tc (root-path typed-builtins ["either_unwrap"]) typed-builtins))

  ;; A named function type retains its complete signature.
  (define tfun-decl-tree
    (rex:ParseRexNorm "
+  natfun
  $  {\ nat}nat
"))
  (define typed-tfun
    (compile "integration_tfun_decl" tfun-decl-tree))
  assert(IsApp (got-entry-tc (root-path typed-tfun ["natfun"]) typed-tfun))

  ;;; Builtin substrate entries.

  assert(Equal Inc (tc-ffi-val (got-entry-tc ["inc"] builtins:default-subject)))
  assert(Equal Mul (tc-ffi-val (got-entry-tc ["mul"] builtins:default-subject)))
  assert(Equal Dec (tc-ffi-val (got-entry-tc ["dec"] builtins:default-subject)))
  (define builtin-pin (tc-ffi-val (got-entry-tc ["pin"] builtins:default-subject)))
  (define builtin-unpin (tc-ffi-val (got-entry-tc ["unpin"] builtins:default-subject)))
  assert(IsPin (builtin-pin 7))
  assert(Eq 7 (builtin-unpin (builtin-pin 7)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["uint" "add"] builtins:default-subject)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["row" "size"] builtins:default-subject)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["list" "cons"] builtins:default-subject)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["either" "err"] builtins:default-subject)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["maybe" "some"] builtins:default-subject)))
  assert(Equal "TC_FFI" (Hd (got-entry-tc ["str" "cat"] builtins:default-subject)))
  ;; This scratch subject is the private type-checker substrate, not a
  ;; published compilation context. Contextual constructor tests are separate.
  assert(Equal "/boot/maybe/none"
    (tc-ffi-val (got-entry-tc ["maybe" "none"] builtins:default-subject)))

  ;;; Live value elaboration against the completed subject: every spelling
  ;;; a REPL turn can produce elaborates to a TC.

  (define (live txt)
    (live-elab typed-demo
      (parse-val-sast (rex:ParseRexNorm txt))))

  assert(IsApp (live "geometry/area"))
  assert(IsApp (live "(geometry/area fst)"))
  assert(IsApp (live "[1 2]"))
  assert(IsApp (live "(point 1 2)"))
  assert(IsApp (live "($some 3)"))
  assert(IsApp (live "$none"))
  assert(IsApp
    (live-elab typed-demo
      (surf-cast (surf-ref ["maybe_nat"])
        (surf-app (surf-relvar "some") [(surf-lit 3)]))))
  assert(IsApp
    (live-elab typed-demo
      (surf-cast (surf-ref ["maybe_nat"])
        (surf-relvar "none"))))
  assert(IsApp (live "(pin[nat] 3)"))
  assert(IsApp (live "(unpin[nat] (pin[nat] 3))"))
  assert(IsApp (live "(pin[{\ a=nat b=nat}nat] add)"))
  assert(IsApp (live "((pin[{\ a=nat b=nat}nat] add) 1 2)"))
  assert(IsApp (live "? 1 2
3"))

  ;;; The bst fixture: entry algebra heads survive compilation.

  (define compiled-bst
    (driver:perc-subject (_1 (source:compile (fixture:files 0 ["bst"]) 0 "bst"))))

  assert(Equal "TC_TYP"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "empty"]) compiled-bst)))
  assert(Equal "TC_TYP"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "node"]) compiled-bst)))
  assert(Equal "TC_FFI"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "node" "l"]) compiled-bst)))
  assert(Equal "TC_LAM"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "size"]) compiled-bst)))
  assert(Equal "TC_LAM"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "get"]) compiled-bst)))
  assert(Equal "TC_LAM"
    (Hd (got-entry-tc (Weld (sut-root compiled-bst) ["bst" "map"]) compiled-bst)))

  (define demo-context
    (fixture:tree 0 "reflect-demo" (rex:ParseRexNorm reflection-demo:src)))
  (define reflected (reflection-demo:run demo-context 0))
  assert(Equal "SIGNATURES" (_0 reflected))
  assert(Eq 8 (Sz (_1 reflected)))
  (print "foil integration tests passed")


  1)
assert(Equal 1 (check 0))
