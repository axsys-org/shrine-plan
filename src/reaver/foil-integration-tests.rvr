(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-sast (#module foil-sast))
(#import foil-sast)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind rex (#module rex))

(#bind foil (#module foil))


;;; Integration smoke test for the checked-in Foil fixture.  The parsed
;;; surface shape is asserted exactly; for elaboration the test is that
;;; the fixtures COMPILE and that live value elaboration produces TCs.
;;; Type-value shape assertions live with each pipeline's own suite
;;; (foil-types-tests / foil-new-elab-tests), so this module stays
;;; agnostic over the elaborator the flip switch selects.

(define demo-module
  (foil:parse-foil "demo"))

(define (decl-name decl) (_1 decl))

assert(Equal 22 (Sz demo-module))
assert(Equal ["add"]             (decl-name (_0 demo-module)))
assert(Equal ["point"]           (decl-name (_1 demo-module)))
assert(Equal ["point" "add"]     (decl-name (_2 demo-module)))
assert(Equal ["circle"]          (decl-name (_3 demo-module)))
assert(Equal ["circle" "area"]   (decl-name (_4 demo-module)))
assert(Equal ["geometry"]        (decl-name (_5 demo-module)))
assert(Equal ["geometry" "area"] (decl-name (_6 demo-module)))
assert(Equal ["fst"]             (decl-name (_7 demo-module)))
assert(Equal ["snd"]             (decl-name (_8 demo-module)))
assert(Equal ["geo"]             (decl-name (_9 demo-module)))
assert(Equal ["getx"]            (decl-name (Ix 10 demo-module)))
assert(Equal ["same_as_getx"]    (decl-name (Ix 11 demo-module)))
assert(Equal ["maybe_nat"]       (decl-name (Ix 12 demo-module)))
assert(Equal ["maybe_nat" "some"] (decl-name (Ix 13 demo-module)))
assert(Equal ["maybe_nat" "none"] (decl-name (Ix 14 demo-module)))
assert(Equal ["maybe_nat" "map"] (decl-name (Ix 15 demo-module)))
assert(Equal ["maybe_nat" "or_default"] (decl-name (Ix 16 demo-module)))
assert(Equal ["test_maybe_nat"]  (decl-name (Ix 17 demo-module)))
assert(Equal ["test_maybe_nat_missing"] (decl-name (Ix 18 demo-module)))
assert(Equal ["test_maybe_inc"]  (decl-name (Ix 19 demo-module)))
assert(Equal ["test_add_ufcs"]   (decl-name (Ix 20 demo-module)))
assert(Equal ["test_or_default"] (decl-name (Ix 21 demo-module)))

;;; Elaboration: the fixtures compile under whichever elaborator the
;;; flip switch selects, and every declaration produced an entry.

(define typed-demo
  (foil:elab-mod foil:default-subject demo-module))
assert(IsApp (got-entry-tc (Weld ["boot"] ["geometry" "area"]) typed-demo))
assert(IsApp (got-entry-tc (Weld ["boot"] ["maybe_nat" "or_default"]) typed-demo))
assert(IsApp (got-entry-tc (Weld ["boot"] ["point" "x"]) typed-demo))
assert(IsApp (got-entry-tc (Weld ["boot"] ["same_as_getx"]) typed-demo))

(define poly-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  maybe
  (@ a)
  &  ($some a)
     $none
+  maybe_nat_alias
  maybe[nat]
+  id
  (@ a)
  \  x=a
  x
+  id_nat
  ^  nat
  (id[nat] 3)
")))
(define typed-poly
  (foil:elab-mod foil:default-subject poly-module))
assert(IsApp (got-entry-tc (Weld ["boot"] ["maybe"]) typed-poly))
assert(IsApp (got-entry-tc (Weld ["boot"] ["id_nat"]) typed-poly))

(define builtins-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  num
  ^  uint
  10
+  num_added
  ^  uint
  num.add(4)
+  num_subbed
  ^  uint
  num.sub(3)
+  num_lt
  ^  uint
  num.lt(20)
+  nums
  ^  row[uint]
  [1 2 3]
+  nums_size
  ^  uint
  nums.size
+  nums_get
  ^  uint
  nums.get(1)
+  nums_more
  ^  row[uint]
  nums.snoc(4)
+  nums_prefixed
  ^  row[uint]
  nums.cons(0)
+  nums_take
  ^  row[uint]
  nums.take(2)
+  nums_drop
  ^  row[uint]
  nums.drop(1)
+  nums_list
  ^  list[uint]
  (list/cons[uint] 1 list/nil[uint])
+  nums_list_more
  ^  list[uint]
  nums_list.cons(0)
+  nums_list_head
  ^  uint
  nums_list.head
+  nums_list_tail
  ^  list[uint]
  nums_list.tail
+  nums_list_nonempty
  ^  uint
  nums_list.is_cons
+  nums_list_mapped
  nums_list.map(inc)
+  either_val
  ^  either[uint unit]
  (either/left[uint unit] 7)
+  either_right
  ^  either[uint unit]
  (either/right[uint unit] (unit))
+  either_check
  ^  uint
  either_val.is_left
+  either_unwrap
  ^  uint
  either_val.left_val
")))
(define typed-builtins
  (foil:elab-mod foil:default-subject builtins-module))
assert(IsApp (got-entry-tc (Weld ["boot"] ["nums_list_mapped"]) typed-builtins))
assert(IsApp (got-entry-tc (Weld ["boot"] ["either_unwrap"]) typed-builtins))

;; A named function type stores a function type (regression: unwrapped
;; s_tfun used to store its arity via the TTYP extraction).
(define tfun-decl-module
  (parse-module-sast 0 (rex:ParseRexNorm "
+  natfun
  $  {nat; nat}
")))
(define typed-tfun
  (foil:elab-mod foil:default-subject tfun-decl-module))
assert(IsApp (got-entry-tc (Weld ["boot"] ["natfun"]) typed-tfun))

;;; Builtin substrate entries.

assert(Equal Inc (tc-ffi-val (got-entry-tc ["inc"] foil:default-subject)))
assert(Equal Mul (tc-ffi-val (got-entry-tc ["mul"] foil:default-subject)))
assert(Equal Dec (tc-ffi-val (got-entry-tc ["dec"] foil:default-subject)))
(define builtin-pin (tc-ffi-val (got-entry-tc ["pin"] foil:default-subject)))
(define builtin-unpin (tc-ffi-val (got-entry-tc ["unpin"] foil:default-subject)))
assert(IsPin (builtin-pin 7))
assert(Eq 7 (builtin-unpin (builtin-pin 7)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["uint" "add"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["row" "size"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["list" "cons"] foil:default-subject)))
assert(Equal "TC_FFI" (Hd (got-entry-tc ["either" "left"] foil:default-subject)))

;;; Live value elaboration against the completed subject: every spelling
;;; a REPL turn can produce elaborates to a TC.

(define (live txt)
  (foil:elab-val typed-demo foil:empty-env
    (parse-val-sast (rex:ParseRexNorm txt))))

assert(IsApp (live "geometry/area"))
assert(IsApp (live "(geometry/area fst)"))
assert(IsApp (live "[1 2]"))
assert(IsApp (live "(point 1 2)"))
assert(IsApp (live "($some 3)"))
assert(IsApp (live "$none"))
assert(IsApp
  (foil:elab-val typed-demo foil:empty-env
    (surf-cast (surf-ref ["maybe_nat"])
      (surf-app (surf-relvar "some") [(surf-lit 3)]))))
assert(IsApp
  (foil:elab-val typed-demo foil:empty-env
    (surf-cast (surf-ref ["maybe_nat"])
      (surf-relvar "none"))))
assert(IsApp (live "(pin[nat] 3)"))
assert(IsApp (live "(unpin[nat] (pin[nat] 3))"))
assert(IsApp (live "(pin[{a=nat; b=nat; nat}] add)"))
assert(IsApp (live "((pin[{a=nat; b=nat; nat}] add) 1 2)"))
assert(IsApp (live "? 1 2
3"))

;;; The bst fixture: entry algebra heads survive compilation.

(define compiled-bst
  (foil:compile-mod foil:default-subject "bst"))

assert(Equal "TC_TYP"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "empty"]) compiled-bst)))
assert(Equal "TC_TYP"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "node"]) compiled-bst)))
assert(Equal "TC_FFI"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "node" "l"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "size"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "get"]) compiled-bst)))
assert(Equal "TC_LAM"
  (Hd (got-entry-tc (Weld ["boot"] ["bst" "map"]) compiled-bst)))

(print "foil integration tests passed")
