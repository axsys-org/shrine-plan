;;;; Shared result adapter for Foil tests and lore examples.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))
(#bind abi (#module foil-abi))
(#bind publication (#module foil-publication))
(#bind doctest (#module doctest))
(#bind lore (#module foil-lore))
(#bind render (#module foil-render))
(#bind deps (#module foil-test-deps))
(#bind testing (#module testing))

;; All protocol fields are cords. The host parses printed rows, including
;; wrapped rows and escaped quotes, rather than grepping arbitrary text.
(define report testing:report)

(define (native entry)
  (define mod (foil:perc-name entry))
  (define sut (foil:perc-subject entry))
  (define case-unit (abi:constructor entry ["unit"]))
  (define cases (foil:source-entry-val ["tests"] sut))
  (define (run-case c)
    (define name (_0 c))
    (testing:attempt render:render-plain mod name
      (lambda (ignored)
        (define checks ((_1 c) case-unit))
        (map (lambda (i)
          (define check (Ix i checks))
          (report (If (Eq 1 (_1 check)) "pass" "fail") mod
            (strcat [name "/" (showNat i) ": " (_0 check)])
            (_2 check) (_3 check)))
          (gen (Sz checks) (lambda (i) i))))))
  (If (Eq 0 (Sz cases))
    [(report "fail" mod "tests" "at least one case" "empty suite")]
    (cat (map run-case cases))))

(define (docs entry)
  (define mod (foil:perc-name entry))
  (define subj (doctest:bundle-with (foil:perc-world entry) (foil:perc-subject entry)))
  (define (run-entry l)
    (define (run-one i)
      (define dt (Ix i (lore:lore-tests l)))
      (define name (strcat [(render:path-text (lore:lore-path l))
                            "/" (showNat i) ": " (_1 dt)]))
      (Seq (report "start" mod name "" "")
        (let ((r (doctest:run-doctest subj dt)))
          (report (_0 r) mod name
            (cond
              ((Equal "error" (_0 r)) "successful evaluation")
              ((Equal "broken" (_0 r)) "valid doctest pair")
              (else (render:render-plain (Ix 3 r))))
            (render:render-plain (Ix 2 r))))))
    (map run-one (gen (Sz (lore:lore-tests l)) (lambda (i) i))))
  (define results (cat (map run-entry (foil:perc-lore entry))))
  (If (Sz results) results
    [(report "fail" mod "doctests" "at least one example" "empty suite")]))

;; Share the validated input cache; callers can also pass 0 for cold probes.
;; Cases always execute, even when their module's compilation is cached.
(define (evaluate cache kind mods)
  (define (step state mod)
    (define cache (_0 state))
    (define previous (_1 state))
    (define result
      (Try (lambda (z)
             (let* ((plan (deps:prepare cache [mod]))
                    (built (publication:compile plan cache))
                    (r (foil:compile-context
                         (publication:compilation-context plan)
                         (lambda (name) (error ["unprepared-test-source" name]))
                         (_1 built) mod)))
               (DeepSeq (_1 r) r))) 0))
    (If (Eq 1 (Hd result))
      [cache (snoc (report "error" mod "compile" "compiled module"
                    (render:render-plain (_0 result))) previous)]
      (let* ((next (_0 (_0 result)))
             (entry (_1 (_0 result)))
             (r (Try (lambda (z)
                       (let ((results (If (Equal kind "native")
                                        (native entry) (docs entry))))
                         (DeepSeq results results))) 0)))
        [next (Weld previous (If (Eq 1 (Hd r))
                [(report "error" mod "runner" "completed suite"
                   (render:render-plain (_0 r)))]
                (_0 r)))])))
  ;; Force results inside the suite boundary, before proceeding to another
  ;; compilation. Return data for callers instead of discarding it after print.
  (define final (foldl (lambda (state mod)
    (define next (step state mod))
    (DeepSeq (_1 next) next)) [cache []] mods))
  ;; Retain the compiled artifacts and their contexts, not elaborator scratch
  ;; caches. These pins carry the definitions actually used by the tests.
  [(map Pin (foil:cache-results (_0 final))) (_1 final)])
(define (run cache kind mods) (_1 (evaluate cache kind mods)))
