;;;; Shared result adapter for Foil tests and lore examples.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))
(#bind source (#module foil-source))
(#bind builtins (#module foil-builtins))
(#bind doctest (#module doctest))
(#bind lore (#module foil-lore))
(#bind render (#module foil-render))
(#bind deps (#module foil-test-deps))

;; All protocol fields are cords. The host parses printed rows, including
;; wrapped rows and escaped quotes, rather than grepping arbitrary text.
(define (report status mod name want got)
  (print ("TEST" status mod (strWeld "~:" name)
           (strWeld "~:" want) (strWeld "~:" got))))

;; The case argument is the builtin unit. Build it once against the tiny
;; substrate, not by rebuilding a whole application's doctest world.
(Seq (define case-unit (_0 (_0 (doctest:eval-text builtins:default-subject "(unit)"))))
  (DeepSeq case-unit 0))

(define (native entry)
  (define mod (foil:perc-name entry))
  (define sut (foil:perc-subject entry))
  (define cases (foil:source-entry-val ["tests"] sut))
  (define (run-case c)
    (define name (_0 c))
    (Seq (report "start" mod name "" "")
      (let ((r (Try (lambda (z) (let ((value ((_1 c) case-unit))) (DeepSeq value value))) 0)))
        (If (Eq 1 (Hd r))
          (report "error" mod name "" (render:render-plain (_0 r)))
          (let ((checks (_0 r)))
            (If (Eq 0 (Sz checks))
              (report "fail" mod name "at least one check" "empty case")
              (DeepSeq
                (map (lambda (i)
                       (let ((c (Ix i checks)))
                         (report (If (Eq 1 (_1 c)) "pass" "fail") mod
                           (strcat [name "/" (showNat i) ": " (_0 c)])
                           (_2 c) (_3 c))))
                  (gen (Sz checks) (lambda (i) i)))
                0)))))))
  (If (Eq 0 (Sz cases))
    (report "fail" mod "tests" "at least one case" "empty suite")
    (DeepSeq (map run-case cases) 0)))

(define (docs entry)
  (define mod (foil:perc-name entry))
  (define subj (doctest:bundle-with (foil:perc-world entry) (foil:perc-subject entry)))
  (define (run-entry l)
    (define (run-one i)
      (define dt (Ix i (lore:lore-tests l)))
      (define name (strcat [(render:path-text (lore:lore-path l))
                            "/" (showNat i) ": " (_1 dt)]))
      (Seq (report "start" mod name "" "")
        (let ((r (doctest:run-doctest subj dt)))
          (report (_0 r) mod name
            (cond
              ((Equal "error" (_0 r)) "successful evaluation")
              ((Equal "broken" (_0 r)) "valid doctest pair")
              (else (render:render-plain (Ix 3 r))))
            (render:render-plain (Ix 2 r))))))
    (DeepSeq (map run-one (gen (Sz (lore:lore-tests l)) (lambda (i) i))) 0))
  (DeepSeq (map run-entry (foil:perc-lore entry)) 0))

;; Share the validated input cache; callers can also pass 0 for cold probes.
;; Cases always execute, even when their module's compilation is cached.
(define (run cache kind mods)
  (define (step cache mod)
    (define result
      (Try (lambda (z)
             (let ((r (source:compile (deps:prepare cache [mod]) mod)))
               (DeepSeq (_1 r) r))) 0))
    (If (Eq 1 (Hd result))
      (Seq (report "error" mod "compile" "compiled module"
             (render:render-plain (_0 result))) cache)
      (let* ((next (_0 (_0 result)))
             (entry (_1 (_0 result)))
             (r (Try (lambda (z)
                       (If (Equal kind "native")
                         (native entry) (docs entry))) 0)))
        (Seq (If (Eq 1 (Hd r))
               (report "error" mod "runner" "completed suite"
                 (render:render-plain (_0 r)))
               0)
          next))))
  (Seq (foldl step cache mods) 0))
