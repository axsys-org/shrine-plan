;; Opt-in observation of the generic ILC dispatcher. No typechecker-specific
;; rules. The staged audit counts only remaining dynamic calls, not direct
;; generated calls. PAP peeling is excluded in both modes. Never include
;; printing in performance measurements. The normal entrypoints do not trace.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))

(define (dispatch-with forward recur marker rules f df args deltas)
  (define law (If (IsPin f) (Unpin f) f))
  (define matched (find (lambda (pair) (Equal f (_0 pair))) rules))
  (define peel (And (IsApp f) (Or (Nil df) (Equal (Hd df) "ILC_APP"))))
  (define kind (cond ((And (Nil df) matched) "rule")
                    (peel "peel")
                    ((And (Nil df) (IsLaw law)) "law")
                    ((Nil df) "opaque")
                    (else "changed-function")))
  (Seq (If peel 0 (print (marker kind (If (IsLaw law) (Name law) "opaque"))))
    (forward recur rules f df args deltas)))
(define (dispatch rules f df args deltas)
  (dispatch-with ilc:change-call-with dispatch "ILC-AUDIT" rules f df args deltas))
(define (staged-dispatch rules f df args deltas)
  (dispatch-with ilc:staged-change-call-with staged-dispatch "STAGED-ILC-AUDIT" rules f df args deltas))
(define (derive-staged rules f) (ilc:derive-staged-with-dispatch staged-dispatch rules f))
(define (derive rules f) (ilc:derive-with-dispatch dispatch rules f))
(#export derive derive-staged)
