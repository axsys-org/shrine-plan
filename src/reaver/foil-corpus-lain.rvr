(#bind std (#module std))
(#import std)

(#bind foil (#module foil))
(#bind prev (#module foil-corpus-shrine))

;;; Corpus tier 4: the lainapp cone (see foil-corpus-sept).  Forks
;;; from the shrine tier, NOT the weft tier: module loading deep-
;;; forces every bound tier's cumulative subject, and the lain suites
;;; have no use for the weft/tyshow corpus (weft still compiles once
;;; inside the lainapp import chain).  The weft tier is a sibling
;;; fork; only weft/tyshow suites pay it.

(define result
  (foil:compile-mod-cached prev:cache foil:default-subject "lainapp"))
(define cache (_0 result))
(define lainapp-sut (_1 result))

(#export cache lainapp-sut)
