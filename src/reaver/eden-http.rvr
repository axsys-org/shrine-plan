;;;; Browser route wiring for Eden; socket and typed driver execution stay
;;;; in helm-http. No namespace installation happens in this adapter.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind http (#module helm-http))

(define (worker sut)
  (define (entry path) (foil:source-entry-val path sut))
  (define helpers
    ["H" (entry ["http" "req"]) (entry ["myth" "nat_at"])
     (entry ["eden" "make"]) (entry ["eden" "cull"]) (entry ["myth" "txt_at"])
     0 0 0 (entry ["eden" "poke"]) sut
     (entry ["myth" "new"]) (entry ["myth" "add"]) (entry ["twig" "txt"])
     (entry ["weft" "runtime"]) (entry ["eden" "warp"]) (entry ["twig" "nat"])])
  (define (plan name serial msg)
    (define url (_2 msg))
    (define parts (filter Bytes (http:split-ch 47 url)))
    (If (And (Sz parts) (Eq "chore" (Ix 0 parts)))
      ("/boot/http_action/reply"
        ("/boot/http_response" 501 "Compiler driver is not installed." "text/plain; charset=utf-8"))
      (http:prepare helpers name serial msg)))
  ;; Warm expression evaluation in MAIN before a leaf actor can demand it.
  ;; This constructs actions only; it does not execute namespace commands.
  (Seq (DeepSeq [(plan ("ts" "http") 0 ["req" "GET" "/ns" ""])
                 (plan ("ts" "http") 0 ["req" "POST" "/vine/hello" "verb=poke&expr=(myth/new)"])] 0)
    (http:mk-http-worker plan (entry ["http_driver" "step"]))))
