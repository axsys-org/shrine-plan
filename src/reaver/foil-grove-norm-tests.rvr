;;;; Closed occupied paths with inherited and inline record constraints.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (path xs) (map (lambda (x) ("ts" x)) xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result)
    (error ["norm-build" result])))
(define (check ignored)
  (define prepared (backend:prepare 0))
  (define policy (_1 prepared))
  (define helpers (_1 (source:compile (_0 prepared)
    "tests/grove_backend")))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing key) "/boot/maybe/none")
  (define (compile lookup root text)
    (backend:compile prepared lookup (path root) (parse text)))
  (define slots (ok (compile missing ["sys"]
    (read-text-file "grove/sys_slots.grove"))))
  (define types (ok (compile missing ["sys" "types"]
    (read-text-file "grove/sys_types.grove"))))
  (define lookup ((helper "lookup") (Weld slots types)))
  (define srs (parse (read-text-file "grove/srs.grove")))
  (define records (ok (backend:compile prepared lookup
    (path ["gov" "srs"]) ((helper "first") 8 srs))))
  assert(Eq 8 (Sz records))
  (define ids (_1 (Ix 6 records)))
  (define list (_1 (Ix 7 records)))
  (define (export rec key) ((helper "export") (path [key]) rec))
  assert(Equal ["ts"] ((helper "norm_summary") ids))
  assert(Equal ["u"] ((helper "norm_summary") list))
  assert(Equal 1 ((helper "norm_spec_at") (path ["alpha"]) ids))
  assert(Equal 0 ((helper "norm_spec_at") [] ids))
  assert(Equal 0 ((helper "norm_spec_at") (path ["alpha" "x"]) ids))
  (define card ((helper "role_data") 7
    ((helper "req_data") ((helper "recall_data") 100 8))))
  (define (tree mode) ((helper "norm_tree") mode card))
  (define (accept rec tree)
    assert(Equal ("/boot/maybe/some" tree)
      ((export rec "check") tree))
    assert(Equal "/boot/maybe/none" ((export rec "validate") tree))
    1)
  (define (reject-tree rec tree)
    assert(Equal "/boot/maybe/none" ((export rec "check") tree))
    assert(Equal "/boot/maybe/some"
      (Hd ((export rec "validate") tree)))
    1)
  assert(Eq 1 (accept ids (tree 0)))
  assert(Eq 1 (accept ids (tree 1)))
  assert(Eq 1 (reject-tree ids (tree 2)))
  assert(Eq 1 (reject-tree ids (tree 3)))
  assert(Eq 1 (reject-tree ids (tree 4)))
  assert(Eq 1 (accept ids (tree 5)))
  assert(Eq 1 (reject-tree ids
    ((helper "norm_tree") 1 "/boot/sept/mop/empty")))
  assert(Eq 1 (reject-tree ids
    ((helper "norm_tree") 1 ((helper "role_data") 3 card))))
  assert(Eq 1 (accept list (tree 0)))
  assert(Eq 1 (reject-tree list (tree 2)))
  assert(Eq 1 (reject-tree list (tree 5)))
  assert(Eq 1 (accept list (tree 6)))
  assert(Eq 1 (reject-tree list (tree 7)))
  assert(Equal ("/boot/maybe/some" [])
    ((export ids "validate") (tree 3)))

  ;; Fresh compiler restores both the norm and its receiver codecs.
  (define fresh (backend:prepare 0))
  (define stored ((helper "lookup") records))
  (define imported (ok (backend:compile fresh stored
    (path ["gov" "nested"])
    (parse (strcat ["#import role=gov/srs/card
#import norm=gov/srs/cards_by_id

nested =
  @norm
  #here ; '/cards/[id=@ts]
  #with ; role

forward =
  ! foil
  + check norm/check
  + validate norm/validate

root =
  @norm
  #here ; " 34 "/" 34 "
  #with ; role

literal =
  @norm
  #here ; '/0
  #with ; role

captures =
  @norm
  #here ; '/[first=@ts]/[second=@ts]
  #with ; role
"])))))
  (define nested (_1 (_0 imported)))
  assert(Equal ["/cards" "ts"] ((helper "norm_summary") nested))
  assert(Eq 1 (accept nested (tree 8)))
  assert(Eq 1 (accept nested (tree 9)))
  assert(Eq 1 (reject-tree nested (tree 10)))
  assert(Eq 1 (reject-tree nested (tree 11)))
  assert(Eq 1 (accept (_1 (_1 imported)) (tree 1)))
  assert(Eq 1 (accept (_1 (Ix 2 imported)) (tree 3)))
  assert(Eq 1 (reject-tree (_1 (Ix 2 imported)) (tree 1)))
  assert(Eq 1 (accept (_1 (Ix 3 imported)) (tree 2)))
  assert(Eq 1 (reject-tree (_1 (Ix 3 imported)) (tree 1)))
  assert(Eq 1 (accept (_1 (Ix 4 imported)) (tree 8)))
  assert(Eq 1 (reject-tree (_1 (Ix 4 imported)) (tree 1)))

  (define (reject text)
    (define result (compile stored ["gov" "bad"] text))
    assert(Equal "err" (Hd result))
    assert(Gt (_0 (_0 (_0 result))) 0)
    1)
  assert(Eq 1 (reject "bad =
  @norm
"))
  assert(Eq 1 (reject "bad =
  @norm
  #here ; '/[x=@u]
  #here ; '/[y=@u]
"))
  (define (bad-pattern pattern)
    (reject (strcat ["bad =" 10 "  @norm" 10
      "  #here ; " pattern 10])))
  assert(Equal [1 1 1 1 1 1]
    (map bad-pattern ["'/[x=@wat]" "'/[x=u]" "'/[x=@u]/[x=@u]"
      "'/a//b" "'/[x=@u" "unquoted"]))
  assert(Eq 1 (reject "bad =
  @norm
  #here ; '/[x=@u]
  #with ; missing
"))
  assert(Eq 1 (reject "bad =
  @norm
  #here ; '/[x=@u]
  ! foil
  nat
"))
  assert(Eq 1 (reject "bad =
  @norm
  #here ; '/[x=@u]
  #meta ;
    /sys/grove/norm: (pails/n 1)
"))
  assert(Eq 1 (reject "bad =
  @norm
  #here ; '/[x=@u]
  #to ; missing
"))
  assert(Eq 1 (reject "bad =
  @norm
  @role
  #here ; '/[x=@u]
"))
  1)
assert(Eq 1 (check 0))
