
(#bind reef (#module reef))
(#import reef)

(define (size-nat w x) (Mod x (Bex w)))
(define (lift-size2 w f x y) (size-nat w (f x y)))

(define (bit-not width val)
  (define (go idx acc)
    (define next
       (If (Test idx val) acc
         (Add (Bex idx) acc)))
    (Ifz idx next (go (Dec idx) next)))
  (go (Dec width) 0))

(define (xor l r)
  (And (Or l r) (Nil (And l r))))

assert(Eq 1 (xor 1 0))
assert(Eq 0 (xor 0 0))
assert(Eq 0 (xor 1 1))

(define (lift-bitwise f l r)
  (define (go idx acc)
    (define test (f (Test idx l) (Test idx r)))
    (define next
      (If test (Add (Bex idx) acc)
        acc))
    (Ifz idx next (go (Dec idx) next)))
    (go (max (Bits l) (Bits r))))
(define bit-xor (lift-bitwise xor))
(define bit-and (lift-bitwise And))

(define (rand-u32 seed)
  (define index (size-nat 32 seed))
  (define index1 (bit-xor (Lsh index 13) index))
  (define add (lift-size2 32 Add))
  (define mul (lift-size2 32 Mul))
  (add 1376312589
       (mul index1
            (add 789221
              (foldr 1 mul [index1 index1 15731])))))

(define (rand-words seed)
  (define next (rand-u32 seed))
  (0 next (rand-words next)))


(define (all-ones w)
  (Dec (Bex w)))

assert(Equal (bit-not 4 3) 12)


