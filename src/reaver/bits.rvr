
(#bind reef (#module reef))
(#import reef)

(define (size-nat w x) (Mod x (Bex w)))
(define (lift-size2 w f x y) (size-nat w (f x y)))

(define (bit-not width val)
  (define (go idx acc)
    (define next
       (If (Test idx val) acc
         (Add (Bex idx) acc)))
    (Ifz idx next (go (Dec idx) next)))
  (go (Dec width) 0))

(define (xor l r)
  (And (Or l r) (Nil (And l r))))

assert(Eq 1 (xor 1 0))
assert(Eq 0 (xor 0 0))
assert(Eq 0 (xor 1 1))

(define (lift-bitwise f l r)
  (define (go idx acc)
    (define test (f (Test idx l) (Test idx r)))
    (define next
      (If test (Add (Bex idx) acc)
        acc))
    (Ifz idx next (go (Dec idx) next)))
    (go (max (Bits l) (Bits r))))
(define bit-xor (lift-bitwise xor))
(define bit-and (lift-bitwise And))

(define (rand-u32 seed)
  (define index (size-nat 32 seed))
  (define index1 (bit-xor (Lsh index 13) index))
  (define add (lift-size2 32 Add))
  (define mul (lift-size2 32 Mul))
  (add 1376312589
       (mul index1
            (add 789221
              (foldr 1 mul [index1 index1 15731])))))

(define (rand-words seed)
  (define next (rand-u32 seed))
  (0 next (rand-words next)))


(define (all-ones w)
  (Dec (Bex w)))

(define (slice i len bytes)
  (LoadVar i len bytes))
(define (slice-to i j bytes)
  (LoadVar i (Sub j i) bytes))


(define (slice-r i len bytes)
  (define cnt (Bytes bytes))
  ;; a,b,c
  (define j (Sub (Sub cnt i) len))
  (slice j len bytes))

(define (byte-trunc-by drop bytes)
  (define len (Bytes bytes))
  (Trunc (Mul 8 (Sub len drop)) bytes))



assert(Equal (bit-not 4 3) 12)


(define (make-berm len val)
  (Set len val))

(define (slice-row start len val)
  (take len (drop start val)))


(define (unberm val)
  (Clear (Dec (Bits val)) val))
(define (met w val)
  (div-roundup (Bits val) w))
(define (berm-met w val)
  (div-roundup (Dec (Bits val)) w))

(define (make-berm-bloq w val)
  (make-berm (Mul w (met w val)) val))
(define make-berm8 (make-berm-bloq 8))

(define (berm-byteswp a)
  (make-berm-bloq 8 (lstrcat (lrev (lexplode (unberm a))))))

(define (berm-load8 i b)
  (Load8 i b))

(define (berm-rip w val)
  (define len (berm-met w val))
  (define blen (met w (unberm val)))
  (define leading (Sub len blen))
  (define (go rem v)
    (define l (size-nat w v))
    (define next (Rsh v w))
    (Ifz rem 0
      (Weld [l] (go (Dec rem) next))))
      (Weld (reap-row 0 leading) (go blen val)))


(define (high-nibble byt) (Mod (Rsh byt 4) 16))
(define (low-nibble byt) (Mod byt 16))

(define (chunks siz ls[x xs])
  (And ls
    [(Row 0 siz (ltake siz ls)) (chunks siz (ldrop siz ls))]))





