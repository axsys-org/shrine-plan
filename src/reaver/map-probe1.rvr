;; Probe: cross-scope generic method inference (axal/run shape).
(#bind std (#module std))
(#import std)
(#bind rex (#module rex))
(#bind foil-sast (#module foil-sast))
(#bind foil (#module foil))
(define src "
+  perhaps
  (@@ v)
  &  ($just v)
     $nix
  +  run
    (@ w)
    \  fun={v; w} m=perhaps[v]
    ^  perhaps[w]
    ?  m
     > ($just x)  ($just (fun x))
     > $nix  $nix
+  outer
  (@@ v)
  +  box
    :  fil=perhaps[v]
  +  count
    (@ w)
    \  fun={v; w} b=outer/box[v]
    ^  perhaps[w]
    b.fil.run(fun)
")
(define rows (foil-sast:parse-module-sast 0 (rex:ParseRexNorm src)))
(define r (Try (lambda (z) (DeepSeq (foil:elab-mod foil:default-subject rows) 1)) 0))
["PROBE" (Hd r) (If (Eq 1 (Hd r)) (_0 r) "OK")]
