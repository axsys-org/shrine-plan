;;;; Eden boots only with a supplied identity, system publication and local store.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind bootstrap (#module foil-bootstrap))
(#bind driver (#module foil-new-env))
(#bind abi (#module foil-abi))

(define (check ignored)
  (define self ("x" 17))
  (define (resolve name) [["x" 17] ["ts" "lib"] ["ts" name]])
  (define slot [self ("ts" "compiler") ("ts" "artifact")])
  (define build (bootstrap:build-system (Pin "eden-test/v3") resolve slot))
  (define local (bootstrap:build-local self build resolve slot ["eden"]))
  (define state (_0 local))
  (define code (_1 local))
  (define eden (Unpin (_1 (need (find (lambda (pair)
    (Equal "eden" (_0 pair))) (_2 code))))))
  (define (entry path) (driver:get-perc path eden))
  (define boot (entry ["eden" "boot"]))
  (define system (bootstrap:trusted build))
  (define failure (abi:constructor eden ["eden" "failed"]))
  (define invalid (boot self system (_1 state) 0))
  assert(Equal ("err" (failure ("ts" "http") ("ts" "invalid_port"))) invalid)
  assert(Equal invalid (boot self system (_1 state) 65536))
  assert(Equal "err" (Hd (boot ("x" 18) system (_1 state) 18131)))
  (define ready (boot self system (_1 state) 18131))
  (If (Equal "err" (Hd ready)) (error ["eden-boot" (_0 ready)]) 0)
  assert(Equal "ok" (Hd ready))
  (define running (_0 ready))
  assert(Equal system (_2 running))
  (define (path names) (Weld [self] (map (lambda (s) ("ts" s)) names)))
  (define (record names)
    (define tree ((entry ["sovereign_peek"]) (path names) running))
    (define fil (_0 tree))
    (If (Equal (abi:option eden "some") (Hd fil)) (_0 fil)
      (error ["missing-eden-record" names])))
  (define has (entry ["myth" "has_at"]))
  (define nat-at (entry ["myth" "nat_at"]))
  assert(Eq 1 (has [("ts" "sys") ("ts" "form")] (record ["kook" "pact"])))
  assert(Eq 1 (has (entry ["pact" "slot"]) (record [])))
  assert(Eq 18131 (nat-at [("ts" "port")] 0 (record ["io" "http"])))
  1)
assert(Equal 1 (check 0))
