(#bind source (#module foil-source))
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil-new-env))

(define (check z)

  (define sut (foil:perc-subject (_1 (source:compile 0 "eden"))))
  (define (entry path) (foil:source-entry-val path sut))
  (define boot (entry ["eden" "boot"]))
  (define install (entry ["eden" "install"]))
  (define make (entry ["eden" "make"]))
  (define empty (entry ["myth" "new"]))
  (define query (entry ["sov" "x_latest"]))
  (define has (entry ["myth" "has_at"]))
  (define nat-at (entry ["myth" "nat_at"]))
  assert(Equal ("/boot/eden/eden/failed" ("ts" "http") ("ts" "invalid_port")) (boot 0))
  assert(Equal (boot 0) (boot 65536))
  (define bad (install [[("ts" "bad") (make [("ts" "h") ("ts" "x")] empty)]]))
  assert(Eq "/boot/eden/eden/failed" (Hd bad))
  assert(Equal ("ts" "bad") (_0 bad))
  (define ready (boot 18131))
  assert(Eq "/boot/eden/eden/ready" (Hd ready))
  (define state (_0 ready))
  (define (record path)
    (define result (query path state))
    (If (Eq "/boot/shrine/res/known" (Hd result)) (_0 result) (error result)))
  assert(Eq 1 (has [("ts" "form")] (record [("ts" "pact")])))
  assert(Eq 1 (has [("ts" "pact")] (record [])))
  assert(Eq 1 (has [("ts" "form")] (record [("ts" "kook") ("ts" "hex")])))
  assert(Eq 18131 (nat-at [("ts" "port")] 0 (record [("ts" "io") ("ts" "http")])))
  (print "foil-eden tests passed")

  1)
assert(Equal 1 (check 0))
