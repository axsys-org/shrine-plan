;;;; Narrow compiler port for the Foil Grove backend.
;;;; Artifacts contain the native subject graph, not reflected-type rebuilds.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(define (require pred fail) (If pred 0 fail))
(define (ts s) ("ts" s))
(#bind driver (#module foil-new-env))
(#bind publication (#module foil-publication))
(#bind contexts (#module foil-context))
(#bind ca (#module cairn))
(#bind subject (#module foil-subject))
(#bind sast (#module foil-sast))
(#bind builtins (#module foil-builtins))
(#bind entry (#module foil-entry))
(#bind elab (#module foil-new-elab))
(#bind abi (#module foil-abi))
(#bind render (#module foil-render))
(#bind rx (#module foil-rex))

(define artifact-tag "grove/compiler-artifact/v3")
(define (unpath path) (map (Ix 0) path))
(define (brand policy name)
  (abi:constructor policy ["grove_backend" name]))
(define (tool policy name)
  (driver:get-perc ["grove_backend" name] policy))
(define (error-text cause)
  (define result (Try render:diag-flat cause))
  (If (Eq 1 (Hd result)) "Grove compiler failure" (_0 result)))

;; The complete artifact is pinned for nominal type dependencies. Only
;; explicit exported keys receive visible spellings in the fresh head.
(define (artifact dep)
  (define bundle (_2 dep))
  (define image (Ix 4 bundle))
  (require (And (Eq artifact-tag (Hd image)) (Eq 5 (Sz image)))
    (error ["invalid-grove-compiler-artifact" (_0 dep)]))
  (require (Eq 3 (_0 bundle))
    (error ["invalid-grove-bundle-layout" (_0 dep)]))
  (define unit (subject:sut-context (_1 image)))
  (require (And unit
    (Equal (_0 image) (map (lambda (part) ((_0 part) (_1 part))) (_0 unit))))
    (error ["invalid-grove-artifact-root" (_0 dep)]))
  (require (Equal (_1 bundle) (_0 image))
    (error ["grove-artifact-identity-mismatch" (_0 dep)]))
  image)
(define (has-code dep) (Truth (Ix 4 (_2 dep))))
(define (import-pins deps)
  (foldl (lambda (pins dep)
    (define pin (Pin (_1 (artifact dep))))
    (If (includes (Equal pin) pins) pins (snoc pin pins))) [] (filter has-code deps)))
(define (mark-code-dependency policy root sut dep)
  (define image (artifact dep))
  (define bundle (_2 dep))
  (define prefix (unpath (_2 bundle)))
  (foldl (lambda (head binding)
    (define local (unpath (_1 binding)))
    (define key (Weld (subject:sut-root (_1 image)) local))
    (require (And (Equal prefix (take (Sz prefix) local))
      (includes (Equal key) (_2 image)))
      (error ["invalid-grove-export-key" local (_0 dep)]))
    (subject:mark-visible (Weld root (unpath (_0 binding))) key head))
    sut ((tool policy "bindings") dep)))

(define (mark-dependency policy root sut dep)
  (If (has-code dep) (mark-code-dependency policy root sut dep)
    (Ifz (Sz ((tool policy "bindings") dep)) sut
      (error ["grove-code-import-requires-artifact" (_0 dep)]))))

;; Artifact dependencies must use the selected system and compiler. Different
;; moments at the same public root are allowed; private keys keep them apart.
(define (check-identities context deps)
  (foldl (lambda (seen dep)
    (define image (artifact dep))
    (define sut (_1 image))
    (define origin (contexts:module-context (subject:sut-context sut)))
    (require (And
      (Equal (contexts:publication-key context) (contexts:publication-key origin))
      (Equal (contexts:compiler-key context) (contexts:compiler-key origin)))
      (error ["incompatible-grove-context" (_0 dep)]))
    (DeepSeq (map (lambda (other)
      (require (Or (Nil (Equal (subject:sut-root sut)
                              (subject:sut-root (_1 other))))
        (Equal image other))
        (error ["conflicting-grove-artifacts" (_0 dep)]))) seen) 0)
    (snoc image seen)) [] deps))

(define (compile-unit policy prelude previous request)
  (define name "$grove/unit")
  (define location (_0 request))
  (define canonical (map (lambda (part) [(Hd part) (_0 part)]) location))
  (define tree (_1 request))
  (define deps (_2 request))
  (define origin
    (contexts:module-context (subject:sut-context (driver:perc-subject policy))))
  (define plan (publication:prepare
    (contexts:publication-key origin) (contexts:compiler-key origin)
    (lambda (ignored) tree) [[name canonical]] [] previous))
  (define context (publication:compilation-context plan))
  (define expected
    (foldl (lambda (out local)
      (define path (Weld canonical (map (lambda (part) [(Hd part) (_0 part)]) local)))
      (If (ca:getax path out) out (ca:putax path (previous path) out)))
      (publication:expected-cases plan) (_4 request)))
  (DeepSeq expected 0)
  (DeepSeq (check-identities context (filter has-code deps)) 0)
  (define declarations (sast:parse-module-sast 0 tree))
  (require (Nil (includes driver:mod-import? declarations))
    (error "grove-compiler-port-does-not-load-source-imports"))
  (driver:check-declarations declarations)
  (define base (builtins:for-context context))
  (define head (driver:make-head context name base
    (Weld (import-pins deps) [(Pin prelude) (Pin base)])
    [[prelude []]] declarations))
  (define sut
    (foldl (mark-dependency policy (subject:sut-root head)) head deps))
  (DeepSeq sut 0)
  (define out (driver:elab-mod-info sut declarations))
  (define layer (_0 out))
  (define keys (_1 out))
  (define root (subject:sut-root layer))
  (define image (artifact-tag location layer keys (Pin plan) expected))
  (define (describe key)
    (define part (entry:entry-parts layer key))
    (define local (map ts (drop (Sz root) key)))
    [local
      ((brand policy "entry") local (entry:ent-val part)
        (elab:reflect-in-subject layer 0 (subject:tc-ty (entry:ent-tc part)))
        (entry:entry-kind layer key (entry:ent-tc part)))])
  (define own (filter (lambda (key)
    (Equal root (take (Sz root) key))) keys))
  (define metadata (map (lambda (path)
    (driver:source-entry-val (unpath path) layer)) (_3 request)))
  (define definitions
    (map (lambda (binding)
      (define local (drop (Sz canonical) (_0 binding)))
      (define key (Weld root (map (Ix 1) local)))
      (define present (subject:get-const key layer))
      (define descriptor
        (If present
          (let ((part (entry:entry-parts layer key)))
            (elab:reflect-in-subject layer 0 (subject:tc-ty (entry:ent-tc part))))
          "opq"))
      [(map (lambda (part) ((_0 part) (_1 part))) local) (_1 binding) descriptor])
      (rowify (ca:tapax expected))))
  (force ((tool policy "compiled_from") (map describe own) metadata image definitions)))

(define (cause-span cause fallback)
  ;; The compiler's located declaration diagnostic is a four-field blurb.
  ;; Keep its line/column and retain the full native cause as well.
  (cond
    ((And (IsApp cause) (Eq "in-decl" (_0 cause)))
      (let ((at (_3 cause)))
        (cause-span (_2 cause) [(_1 at) (_3 at) 0 0])))
    ((And (IsApp cause) (Eq "foil-new-elab-errors" (_0 cause)))
      (If (Sz (_1 cause)) (cause-span (_0 (_1 cause)) fallback) fallback))
    ((And (IsApp cause)
      (includes (Eq (_0 cause)) ["foil-new-elab" "foil-sast-error"]))
      (let ((at (_2 cause)))
        (If (And (Eq "at" (_0 at)) (_1 (_1 at)))
          [(_1 (_1 at)) (_3 (_1 at)) 0 0] fallback)))
    ((And (IsApp cause)
      (includes (Eq (_0 cause))
        ["invalid-grove-compiler-artifact" "invalid-grove-bundle-layout"
         "invalid-grove-artifact-root" "grove-artifact-identity-mismatch"
         "grove-cannot-import-own-source-root" "conflicting-grove-artifacts"]))
      (_1 cause))
    ((And (IsApp cause) (Eq "invalid-grove-export-key" (_0 cause)))
      (_2 cause))
    (else fallback)))
(define (find-span location tree)
  (define span (rx:rx-span tree))
  (If (Equal (take 2 span) (take 2 location)) [span]
    (let ((kids
      (cond
        ((rx:rx-nest? tree) (rx:rx-nest-kids tree))
        ((rx:rx-juxt? tree) (rx:rx-juxt-kids tree))
        (else []))))
      (foldl (lambda (found child)
        (If found found (find-span location child))) 0 kids))))
(define (located-span cause tree)
  (define location (cause-span cause (rx:rx-span tree)))
  (define original (find-span location tree))
  (If original (_0 original) location))
(define (compile-port prepared previous request)
  (define policy (_1 prepared))
  (define prelude (_2 prepared))
  (define result (Try (lambda (z)
    (force (compile-unit policy prelude previous request))) 0))
  (If (Eq 1 (Hd result))
    ((abi:result policy "err") ((brand policy "diagnostic")
      (located-span (_0 result) (_1 request)) (error-text (_0 result))
      ((abi:option policy "some") (_0 result))))
    ((abi:result policy "ok") (_0 result))))

 ;; A prepared publication supplies the policy and prelude. No implicit
;; source compilation or default compiler substrate is accepted here.
(define (prepare-with compiled prelude-module)
  (define plan (Unpin (_0 compiled)))
  (contexts:require-context (publication:compilation-context plan))
  (define (module name)
    (Unpin (_1 (need (find (lambda (pair) (Equal name (_0 pair)))
      (_2 compiled))))))
  (define policy (module "grove_backend"))
  (define prelude (driver:perc-subject (module prelude-module)))
  (require (subject:sut-context (driver:perc-subject policy))
    (error "grove-requires-compilation-context"))
  [(_1 compiled) policy prelude])
(define (prepare compiled)
  (prepare-with compiled "grove_role_runtime"))
(define (ports prepared previous lookup)
  ((brand (_1 prepared) "ports") lookup
    (compile-port prepared previous)))
(define (compile prepared previous lookup root document)
  ((tool (_1 prepared) "compile") root document
    (ports prepared previous lookup)))

;; The artifact retained each predecessor before elaboration. Publication
;; consumes that assignment, never guesses it from the post-compile store.
(define (publish prepared records now block state)
  (define policy (_1 prepared))
  (define origin
    (contexts:module-context (subject:sut-context (driver:perc-subject policy))))
  (define images
    (foldl (lambda (out record)
      (define found ((tool policy "artifact_of") (_1 record)))
      (require (And (IsApp found) (Eq 1 (Sz found)))
        (error ["missing-grove-publication-artifact" (_0 record)]))
      (define image (_0 found))
      (require (And (Eq artifact-tag (Hd image)) (Eq 5 (Sz image)))
        (error "stale-grove-publication: rebuild definitions"))
      (define pin (Pin image))
      (If (includes (Equal pin) out) out (snoc pin out))) [] records))
  (define expected
    (foldl (lambda (out image)
      (foldl (lambda (out pair)
        (define old (ca:getax (_0 pair) out))
        (require (Or (Nil old) (Equal (_0 old) (_1 pair)))
          (error "conflicting-grove-publication-moments"))
        (ca:putax (_0 pair) (_1 pair) out))
        out (rowify (ca:tapax (_4 (Unpin image)))))) ca:empty-ax images))
  (define versions (map (lambda (pair)
    [(map (lambda (part) ((_0 part) (_1 part))) (_0 pair)) (_1 pair)])
    (rowify (ca:tapax expected))))
  ((tool policy "commit") (contexts:publication-key origin)
    versions records now block state))
