;;;; Narrow compiler port for the Foil Grove backend.
;;;; Artifacts contain the native subject graph, not reflected-type rebuilds.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(define (require pred fail) (If pred 0 fail))
(define (ts s) ("ts" s))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind subject (#module foil-subject))
(#bind sast (#module foil-sast))
(#bind builtins (#module foil-builtins))
(#bind entry (#module foil-entry))
(#bind elab (#module foil-new-elab))
(#bind nt (#module foil-new-types))
(#bind render (#module foil-render))
(#bind rx (#module foil-rex))

(define artifact-tag "grove/compiler-artifact/v1")
(define (unpath path) (map (Ix 0) path))
(define (brand policy name)
  (define key (_1 (nt:runtime-key (driver:perc-world policy)
    (nt:type-ref (subject:canon-path ["grove_backend" name]
      (driver:perc-subject policy))))))
  (_0 key))
(define (tool policy name)
  (driver:get-perc ["grove_backend" name] policy))
(define (error-text cause)
  (define result (Try render:diag-flat cause))
  (If (Eq 1 (Hd result)) "Grove compiler failure" (_0 result)))

;; The complete artifact is pinned for nominal type dependencies. Only
;; explicit exported keys receive visible spellings in the fresh head.
(define (artifact dep)
  (define bundle (_2 dep))
  (define image (Ix 4 bundle))
  (require (And (Eq artifact-tag (Hd image)) (Eq 3 (Sz image)))
    (error ["invalid-grove-compiler-artifact" (_0 dep)]))
  (require (And (Eq 1 (_0 bundle)) (Eq 1 (Sz (_2 bundle))))
    (error ["invalid-grove-bundle-layout" (_0 dep)]))
  (require (Equal ["boot" (_0 image)] (subject:sut-root (_1 image)))
    (error ["invalid-grove-artifact-root" (_0 dep)]))
  (require (Eq (_1 bundle) (_0 image))
    (error ["grove-artifact-identity-mismatch" (_0 dep)]))
  image)
(define (import-pins deps)
  ;; Several declaration imports commonly share one compilation artifact.
  ;; Retain that layer once; duplicate tails amplify failed-name searches.
  (_1 (foldl (lambda (state dep)
    (define image (artifact dep))
    (If (includes (Eq (_0 image)) (_0 state)) state
      [(snoc (_0 image) (_0 state))
       (snoc (Pin (_1 image)) (_1 state))])) [[] []] deps)))
(define (mark-dependency policy root sut dep)
  (define image (artifact dep))
  (define bundle (_2 dep))
  (define prefix
    (Weld (subject:sut-root (_1 image)) (unpath (_2 bundle))))
  (foldl (lambda (head binding)
    (define key (unpath (_1 binding)))
    (require (And (Equal prefix (take (Sz prefix) key))
      (includes (Equal key) (_2 image)))
      (error ["invalid-grove-export-key" key (_0 dep)]))
    (subject:mark-visible (Weld root (unpath (_0 binding))) key head))
    sut ((tool policy "bindings") dep)))

(define (check-identities name deps)
  (foldl (lambda (seen dep)
    (define image (artifact dep))
    (require (Nil (Eq name (_0 image)))
      (error ["grove-cannot-import-own-source-root" (_0 dep)]))
    (DeepSeq (map (lambda (other)
      (require (Or (Nil (Eq (_0 image) (_0 other)))
        (Equal image other))
        (error ["conflicting-grove-artifacts" (_0 dep)]))) seen) 0)
    (snoc image seen)) [] deps))

(define (compile-unit policy prelude request)
  (define name (_0 request))
  (define tree (_1 request))
  (define deps (_2 request))
  (DeepSeq (check-identities name deps) 0)
  (define declarations (sast:parse-module-sast 0 tree))
  (require (Nil (includes driver:mod-import? declarations))
    (error "grove-compiler-port-does-not-load-source-imports"))
  (driver:check-declarations declarations)
  (define base builtins:default-subject)
  (define head (driver:make-head name base
    (Weld (import-pins deps) [(Pin prelude) (Pin base)])
    [[prelude []]] declarations))
  (define sut
    (foldl (mark-dependency policy (subject:sut-root head)) head deps))
  (DeepSeq sut 0)
  (define out (driver:elab-mod-info sut declarations))
  (define layer (_0 out))
  (define keys (_1 out))
  (define root (subject:sut-root layer))
  (define image (artifact-tag name layer keys))
  (define (describe key)
    (define part (entry:entry-parts layer key))
    [(map ts (drop (Sz root) key))
      ((brand policy "entry") (map ts key) (entry:ent-val part)
        (elab:reflect-encode 0 (subject:tc-ty (entry:ent-tc part)))
        (entry:entry-kind layer key (entry:ent-tc part)))])
  ;; Materialized generic entries outside this unit stay in the artifact,
  ;; but never become declaration exports.
  (define own (filter (lambda (key)
    (Equal root (take (Sz root) key))) keys))
  (define metadata (map (lambda (path)
    (driver:source-entry-val (unpath path) layer)) (_3 request)))
  (force ((tool policy "compiled_from") (map describe own) metadata image)))

(define (cause-span cause fallback)
  ;; The compiler's located declaration diagnostic is a four-field blurb.
  ;; Keep its line/column and retain the full native cause as well.
  (cond
    ((And (IsApp cause) (Eq "in-decl" (_0 cause)))
      (let ((at (_3 cause)))
        (cause-span (_2 cause) [(_1 at) (_3 at) 0 0])))
    ((And (IsApp cause) (Eq "foil-new-elab-errors" (_0 cause)))
      (If (Sz (_1 cause)) (cause-span (_0 (_1 cause)) fallback) fallback))
    ((And (IsApp cause)
      (includes (Eq (_0 cause)) ["foil-new-elab" "foil-sast-error"]))
      (let ((at (_2 cause)))
        (If (And (Eq "at" (_0 at)) (_1 (_1 at)))
          [(_1 (_1 at)) (_3 (_1 at)) 0 0] fallback)))
    ((And (IsApp cause)
      (includes (Eq (_0 cause))
        ["invalid-grove-compiler-artifact" "invalid-grove-bundle-layout"
         "invalid-grove-artifact-root" "grove-artifact-identity-mismatch"
         "grove-cannot-import-own-source-root" "conflicting-grove-artifacts"]))
      (_1 cause))
    ((And (IsApp cause) (Eq "invalid-grove-export-key" (_0 cause)))
      (_2 cause))
    (else fallback)))
(define (find-span location tree)
  (define span (rx:rx-span tree))
  (If (Equal (take 2 span) (take 2 location)) [span]
    (let ((kids
      (cond
        ((rx:rx-nest? tree) (rx:rx-nest-kids tree))
        ((rx:rx-juxt? tree) (rx:rx-juxt-kids tree))
        (else []))))
      (foldl (lambda (found child)
        (If found found (find-span location child))) 0 kids))))
(define (located-span cause tree)
  (define location (cause-span cause (rx:rx-span tree)))
  (define original (find-span location tree))
  (If original (_0 original) location))
(define (compile-port policy prelude request)
  (define result (Try (lambda (z)
    (force (compile-unit policy prelude request))) 0))
  (If (Eq 1 (Hd result))
    ("err" ((brand policy "diagnostic")
      (located-span (_0 result) (_1 request)) (error-text (_0 result))
      ("/boot/maybe/some" (_0 result))))
    ("ok" (_0 result))))

;; Prepare once per host cache/revision. The closure retains the trusted
;; prelude and policy; external Grove sources and build caches are unused.
(define (prepare-with cache prelude-module)
  (define result (source:compile cache "grove_backend"))
  (define policy (_1 result))
  ;; Only the trusted host selects a prelude. Grove source cannot import Foil
  ;; modules; external dependencies still resolve through pinned artifacts.
  (define loaded (source:compile (_0 result) prelude-module))
  [(_0 loaded) policy (driver:perc-subject (_1 loaded))])
(define (prepare cache)
  (prepare-with cache "grove_role_runtime"))
(define (prepare-ui cache)
  (prepare-with cache "grove_ui_runtime"))
(define (ports prepared lookup)
  ((brand (_1 prepared) "ports") lookup
    (compile-port (_1 prepared) (_2 prepared))))
(define (compile prepared lookup root document)
  ((tool (_1 prepared) "compile") root document (ports prepared lookup)))
