;;;; Explicit, deterministic publication assignments for compiler fixtures.
;;;; File fixtures import the real system definitions as pinned artifacts.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind driver (#module foil-new-env))
(#bind publication (#module foil-publication))
(#bind context (#module foil-context))
(#bind subject (#module foil-subject))
(#bind bootstrap (#module foil-bootstrap))

(define compiler (Pin "sovereign-fixture-compiler/v3"))
(Seq (define system-plan
  (publication:prepare-system compiler source:read-module bootstrap:system-roots)) (DeepSeq system-plan 0))
(Seq (define system-code (publication:compile system-plan driver:empty-foil-cache)) (DeepSeq system-code 0))
(define system (context:publication-key (publication:compilation-context system-plan)))
(define (root name) [["x" 17] ["ts" "fixtures"] ["ts" name]])

;; A cache can retain the same publication through several importing contexts.
;; Compare its source and defining/dependency moments, not the importing graph.
(define (publication-signature perc)
  (define unit (subject:sut-context (driver:perc-subject perc)))
  (define selected (context:module-context unit))
  [(driver:perc-root perc) (driver:perc-rex perc)
   (context:publication-key selected) (context:compiler-key selected)
   (map (lambda (name)
     [name (context:storage-root (context:module selected name))])
     (driver:perc-dependencies perc))])

;; Cached dependencies are pinned imports, not an alternate identity resolver.
;; A fixture that needs two revisions supplies an explicit context itself.
(define (prepare read cache names)
  (define prior (filter (lambda (perc)
    (Nil (includes (Equal (driver:perc-name perc)) names)))
    (driver:cache-results cache)))
  (define images (foldl (lambda (out perc)
    (define name (driver:perc-name perc))
    (define found (find (lambda (pair) (Equal name (_0 pair))) out))
    (If found
      (If (Equal (publication-signature (Unpin (_1 (_0 found))))
                 (publication-signature perc)) out
        (error ["ambiguous-fixture-import" name]))
      (snoc [name (Pin perc)] out))) (_2 system-code) prior))
  (define (resolve name)
    (define found (find (lambda (pair) (Equal name (_0 pair))) images))
    (If found
      (_0 (subject:sut-context (driver:perc-subject (Unpin (_1 (_0 found))))))
      (root name)))
  (source:prepare-publication-with read system compiler resolve images
    (lambda (path) 0) (Weld names (map _0 images))))
(define (files cache names)
  (publication:compilation-context (prepare source:read-module cache names)))
(define (tree cache name rex)
  (publication:compilation-context
    (prepare (lambda (mod) (If (Equal mod name) (source:new-imports rex)
      (source:read-module mod))) cache [name])))
(define (trees cache sources)
  (define (read name)
    (define hit (find (lambda (pair) (Equal name (_0 pair))) sources))
    (If hit (_1 (_0 hit)) (source:read-module name)))
  (publication:compilation-context (prepare read cache (map _0 sources))))
(define (graph read cache names)
  (publication:compilation-context (prepare read cache names)))
(define (cached-context cache name)
  (define matches (foldl (lambda (out perc)
    (If (includes (Equal perc) out) out (snoc perc out))) []
    (filter (lambda (perc) (Equal name (driver:perc-name perc)))
      (driver:cache-results cache))))
  (If (Eq 1 (Sz matches))
    (context:module-context (subject:sut-context (driver:perc-subject (_0 matches))))
    (error ["ambiguous-fixture-cache-context" name])))
(#export compiler system root prepare files tree trees graph cached-context)
