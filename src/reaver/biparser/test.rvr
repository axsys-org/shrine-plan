(#bind std (#module std))
(#import std)
(#bind tr (#module tr))
(#import tr)
(#bind k7 (#module k7))
(#import k7)
(#bind prim (#module prim))
(#import prim)
(#bind combinator (#module combinator))
(#import combinator)


;;; Entry-point helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; parse: returns the produced value on success, 0 on failure.
;;; pretty: returns the built byte-string on success, 0 on failure.
;;; witness: returns the witness tree on success, 0 on failure.

(define (value-ok _s v) v)
(define (state-ok s _v) s)
(define (zero-no _s _v) 0)

(define (parse k7 s)
    ((k7-parse k7) value-ok zero-no s 0))

(define (pretty k7 v)
    ((k7-print k7) state-ok zero-no 0 v))

(define (witness k7 v)
    ((k7-witness k7) value-ok zero-no 0 v))

(define (round-trip k7 s) (pretty k7 (parse k7 s)))


;;; Predicates ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (is-digit? b)
    (Ifz (Lt b 48) 0
    (Ifz (Lt 57 b) 0 1)))

(define (is-y? b) (Eq b 121))
(define (is-n? b) (Eq b 110))


;;; satisfy / byte ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind digit (satisfy is-digit?))

assert(Eq 49 (parse digit "1"))
assert(Eq 53 (parse digit "5"))
assert(Eq  0 (parse digit "x"))
assert(Eq  0 (parse digit ""))
assert(Eq "5" (pretty digit 53))
assert(Eq "5" (round-trip digit "5"))

assert(Eq 65 (parse byte "A"))
assert(Eq "A" (pretty byte 65))


;;; literal ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind hi (literal "hi"))
(#bind hi-tag (set 1 hi))

assert(Eq 1 (parse hi-tag "hi"))
assert(Eq 0 (parse hi-tag "ho"))
assert(Eq 0 (parse hi-tag ""))
assert(Eq "hi" (pretty hi-tag 1))


;;; eof / nothing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind eof-tag (set 1 eof))
assert(Eq 1 (parse eof-tag ""))
assert(Eq 0 (parse eof-tag "x"))

(#bind nothing-tag (set 1 nothing))
assert(Eq 1 (parse nothing-tag ""))
assert(Eq 1 (parse nothing-tag "x"))


;;; k7-cons ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind two-digits (k7-cons digit digit))

assert(Eq [49 50] (parse two-digits "12"))
assert(Eq "12" (pretty two-digits [49 50]))
assert(Eq "12" (round-trip two-digits "12"))


;;; k7-alt ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind y-or-n (k7-alt (satisfy is-y?) (satisfy is-n?)))

assert(Eq 121 (parse y-or-n "y"))
assert(Eq 110 (parse y-or-n "n"))
assert(Eq   0 (parse y-or-n "x"))
assert(Eq "y" (pretty y-or-n 121))
assert(Eq "n" (pretty y-or-n 110))
assert(Eq "y" (round-trip y-or-n "y"))
assert(Eq "n" (round-trip y-or-n "n"))


;;; k7-compose ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind tag-then-digit (k7-compose (literal "tag:") digit))

assert(Eq 53 (parse tag-then-digit "tag:5"))
assert(Eq  0 (parse tag-then-digit "no:5"))
assert(Eq "tag:5" (pretty tag-then-digit 53))
assert(Eq "tag:5" (round-trip tag-then-digit "tag:5"))


;;; many ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind digits (many digit))

assert(Eq 0 (parse digits ""))
assert(Eq [49 0] (parse digits "1"))
assert(Eq [49 [50 0]] (parse digits "12"))
assert(Eq [49 [50 [51 0]]] (parse digits "123"))
assert(Eq "" (pretty digits 0))
assert(Eq "1" (pretty digits [49 0]))
assert(Eq "12" (pretty digits [49 [50 0]]))
assert(Eq "123" (round-trip digits "123"))
assert(Eq "" (round-trip digits ""))


;;; choice ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(#bind yna (choice [(satisfy is-y?) [(satisfy is-n?) [digit 0]]]))
assert(Eq 121 (parse yna "y"))
assert(Eq 110 (parse yna "n"))
assert(Eq  53 (parse yna "5"))
assert(Eq   0 (parse yna "x"))


;;; witness ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; A satisfy-leaf is ["leaf" off 1].
assert(Eq ["leaf" 0 1] (witness digit 49))

;;; A literal is ["leaf" off len].
assert(Eq ["leaf" 0 2] (witness hi 0))

;;; cons should produce ["cons" off len f-w g-w].
assert(Eq ["cons" 0 2 ["leaf" 0 1] ["leaf" 1 1]]
       (witness two-digits [49 50]))

;;; many on parsed [49 [50 0]] should give a "many" with two leaf children.
assert(Eq ["many" 2 [["leaf" 0 1] [["leaf" 1 1] 0]]]
       (witness digits [49 [50 0]]))

;;; many on empty list = "many" of zero length, empty witness list.
assert(Eq ["many" 0 0] (witness digits 0))


"all-tests-passed"
