(#bind std (#module std))
(#import std)
(#bind k7 (#module k7))
(#import k7)
(#bind prim (#module prim))
(#import prim)
(#bind seq (#module seq))
(#import seq)
(#bind int (#module int))
(#import int)
(#bind wrap (#module wrap))
(#import wrap)


;;; ============================================================================
;;; helpers
;;; ============================================================================

(define (round-trip-pretty k7 s)
    (pretty k7 (parse k7 s)))

(define (round-trip-parse k7 v)
    (parse k7 (pretty k7 v)))


;;; ============================================================================
;;; byte — source is a row of bytes
;;; ============================================================================

;; parse: one byte → integer
assert(Equal 65 (parse byte [65]))
assert(Equal 48 (parse byte [48]))
assert(Equal 0  (parse byte []))                       ;; empty fails → 0

;; pretty: integer → 1-byte row
assert(Equal [65] (pretty byte 65))
assert(Equal [48] (pretty byte 48))

;; round-trip
assert(Equal [65] (round-trip-pretty byte [65]))
assert(Equal 65   (round-trip-parse byte 65))

;; witness: returns [final-off witness-tree]
assert(Equal [1 [0 1 0]] (witness byte 0 65))
assert(Equal [5 [4 1 0]] (witness byte 4 99))


;;; ============================================================================
;;; nothing — zero-byte cassette
;;; ============================================================================

assert(Equal 0  (parse nothing []))
assert(Equal 0  (parse nothing [65]))
assert(Equal [] (pretty nothing 0))

assert(Equal [0 [0 0 0]] (witness nothing 0 0))
assert(Equal [5 [5 0 0]] (witness nothing 5 0))


;;; ============================================================================
;;; cons
;;; ============================================================================

(#bind two-bytes (cons byte byte))

assert(Equal [65 66] (parse two-bytes [65 66]))
assert(Equal [65 66] (pretty two-bytes [65 66]))

assert(Equal [65 66] (round-trip-pretty two-bytes [65 66]))
assert(Equal [65 66] (round-trip-parse two-bytes [65 66]))

assert(Equal [2 [0 2 [[0 1 0] [1 1 0]]]] (witness two-bytes 0 [65 66]))


;;; ============================================================================
;;; many
;;; ============================================================================

(#bind bytes (many byte))

assert(Equal 0                (parse bytes []))
assert(Equal [65 0]           (parse bytes [65]))
assert(Equal [65 [66 0]]      (parse bytes [65 66]))
assert(Equal [65 [66 [67 0]]] (parse bytes [65 66 67]))

assert(Equal []         (pretty bytes 0))
assert(Equal [65]       (pretty bytes [65 0]))
assert(Equal [65 66 67] (pretty bytes [65 [66 [67 0]]]))

assert(Equal [65 66 67] (round-trip-pretty bytes [65 66 67]))

assert(Equal [3 [0 3 [[0 1 0] [[1 1 0] [[2 1 0] 0]]]]]
             (witness bytes 0 [65 [66 [67 0]]]))


;;; ============================================================================
;;; take-n
;;; ============================================================================

(#bind three-take (take-n 3 byte))

assert(Equal [65 [66 [67 0]]] (parse three-take [65 66 67]))
assert(Equal [65 66 67]       (pretty three-take [65 [66 [67 0]]]))
assert(Equal [65 66 67]       (round-trip-pretty three-take [65 66 67]))


;;; ============================================================================
;;; tagged-alt
;;; ============================================================================

;; tag 0 = nothing, tag 1 = byte
(#bind opt-byte (tagged-alt [nothing byte]))

assert(Equal [0 0]  (parse opt-byte [0]))           ;; tag=0, inner=0
assert(Equal [1 65] (parse opt-byte [1 65]))         ;; tag=1, inner=65

assert(Equal [0]    (pretty opt-byte [0 0]))
assert(Equal [1 65] (pretty opt-byte [1 65]))

assert(Equal 0 (parse opt-byte [5 65]))              ;; out-of-range tag → fail


;;; byte or two-bytes
(#bind small-or-pair (tagged-alt [byte two-bytes]))

assert(Equal [0 42] (parse small-or-pair [0 42]))
assert(Equal [0 42] (pretty small-or-pair [0 42]))

assert(Equal [1 [65 66]] (parse small-or-pair [1 65 66]))
assert(Equal [1 65 66]   (pretty small-or-pair [1 [65 66]]))


;;; ============================================================================
;;; length-prefixed
;;; ============================================================================

(#bind lp-bytes (length-prefixed bytes))

assert(Equal [65 [66 [67 0]]] (parse lp-bytes [3 0 0 0 65 66 67]))
assert(Equal [3 0 0 0 65 66 67] (pretty lp-bytes [65 [66 [67 0]]]))
assert(Equal [3 0 0 0 65 66 67] (round-trip-pretty lp-bytes [3 0 0 0 65 66 67]))

assert(Equal 0           (parse lp-bytes [0 0 0 0]))   ;; empty payload → empty list (0)
assert(Equal [0 0 0 0]   (pretty lp-bytes 0))

assert(Equal 0 (parse lp-bytes [5 0 0 0 65 66 67]))    ;; says 5 bytes, has 3 → fail


;;; ============================================================================
;;; int helpers
;;; ============================================================================

assert(Equal [0 0 0 0]     (u32-bytes 0))
assert(Equal [1 0 0 0]     (u32-bytes 1))
assert(Equal [210 4 0 0]   (u32-bytes 1234))
assert(Equal [255 255 0 0] (u32-bytes 65535))

assert(Equal 0     (bytes-u32 [0 0 0 0]))
assert(Equal 1     (bytes-u32 [1 0 0 0]))
assert(Equal 1234  (bytes-u32 [210 4 0 0]))
assert(Equal 65535 (bytes-u32 [255 255 0 0]))

assert(Equal 0     (bytes-u32 (u32-bytes 0)))
assert(Equal 1234  (bytes-u32 (u32-bytes 1234)))
assert(Equal 65535 (bytes-u32 (u32-bytes 65535)))


;;; ============================================================================
;;; milestone — cons + tagged-alt + many + length-prefixed
;;; ============================================================================

(#bind milestone-bp
    (tagged-alt [(cons byte byte)
                 (length-prefixed (many byte))]))

;; branch 0: cons of two bytes
assert(Equal [0 [42 99]] (parse milestone-bp [0 42 99]))
assert(Equal [0 42 99]   (pretty milestone-bp [0 [42 99]]))

;; branch 1: length-prefixed list
assert(Equal [1 [65 [66 [67 0]]]] (parse milestone-bp [1 3 0 0 0 65 66 67]))
assert(Equal [1 3 0 0 0 65 66 67] (pretty milestone-bp [1 [65 [66 [67 0]]]]))


"all-tests-passed"
