(#bind std (#module std))
(#import std)

;; ok - success contiunation ()
;; no - failure contiunation (ns nv)
;; s - string buffer 
;; v - value 
;; ns - new string 
;; nv - new value 

;; succeed unchanged 
(define (tr-id ok no s v)
  (ok s v))

;; always fail
(define (tr-empty ok no s v)
  (no s v))

;; tr-compose: run on f then g on f's output
(define (tr-compose-ok g ok no ns nv)
  (g ok no ns nv))

(define (tr-compose f g ok no s v)
  (f (tr-compose-ok g ok no) no s v))

;; tr-alt: try f, on failure try g
(define (tr-alt-no g ok no s v _f-s _f-v)
  (g ok no s v))

(define (tr-alt f g ok no s v)
  (f ok (tr-alt-no g ok no s v) s v))