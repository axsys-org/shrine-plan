(#bind std (#module std))
(#import std)
(#bind tr (#module tr))
(#import tr)
(#bind k-7 (#module k7))
(#import k7)

(define (satisfy-witness ok no off _v)
    (ok (Add off 1) ["leaf" off 1]))

(define (satisfy-parse p ok no s _v)
    (Ifz (Eq 0 (Sz s))
      (#let ((b (Ix 0 s)))
         (Ifz (p b) 
           (no s _v)
           (ok (drop 1 s) b)))
    (no s _v)))
    
(define (satisfy-pretty p ok no s v)
    (Ifz (p v)
        (no s v)
        (ok (snoc s v) v)))

(define (satisfy p) 
    (k7-mk (satisfy-pretty p) (satisfy-parse p) satisfy-witness))

(define (always-true _b) 1)

(define (prefix-match? bs s)
    (Ifz (Sz bs) 1
    (Ifz (Sz s) 0
    (Ifz (Eq (Ix 0 bs) (Ix 0 s))
        0
        (prefix-match? (drop 1 bs) (drop 1 s))))))

(define (literal-pretty bs ok no s v)
    (ok (Weld s bs) v))

(define (literal-parse bs ok no s v)
    (Ifz (prefix-match? bs s)
        (no s v)
        (ok (drop (Sz bs) s) v)))

(define (literal-witness bs ok no off _v)
    (ok (Add off (Sz bs)) ["leaf" off (Sz bs)]))

(define (literal bs)
    (k7-mk 
        (literal-pretty bs) 
        (literal-parse bs) 
        (literal-witness bs)))

(define (set-pretty x p ok no s _v)
  (p ok no s x))

(define (set-parse-ok x ok ns _nv)
    (ok ns x))

(define (set-parse p x ok no s v)
  (p (set-parse-ok x ok) no s v)) 

(define (set-witness p ok no off _v)
    (p ok no off 0))

(define (set x p)
  (k7-mk (set-pretty x (k7-print p))
         (set-parse (k7-parse p) x)
         (set-witness (k7-witness p))))

(define (unset-pretty p default ok no s _v)
  (p ok no s default))

(define (unset-parse-ok ok ns _nv)
  (ok ns 0))

(define (unset-parse p ok no s v)
  (p (unset-parse-ok ok) no s v))

(define (unset default p)
  (k7-mk (unset-pretty (k7-print p) default)
         (unset-parse (k7-parse p))
         (set-witness (k7-witness p))))

(define (nothing-c ok no off _v)
    (ok off ["empty" off 0]))

(define (eof-parse ok no s v)
    (Ifz (Sz s) (ok s v) (no s v)))

(#bind byte (satisfy always-true))
(#bind nothing (k7-mk tr-id tr-id nothing-c))
(#bind eof (k7-mk tr-id eof-parse nothing-c))
