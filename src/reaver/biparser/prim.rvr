(#bind std (#module std))
(#import std)
(#bind k7 (#module k7))
(#import k7)
(#bind tr (#module tr))
(#import tr)

(define (flatten-chunks chunks)
  (#let ((forward (lrev chunks)))
    (Row 0 (lsum (lmap Sz forward)) (lcatmap stream forward))))

(define (byte-pretty ok no s v)
    (ok [[v] s] v))

;; increment the offset, return leaf witness
(define (byte-witness ok no off _v)
    (ok (Add off 1) [off 1 0]))

;; parse the head, thread the remaining stream
(define (byte-parse ok no s _v)
    (Ifz (Sz s)
        (no s _v)
        (ok (drop 1 s) (Ix0 s))))

(#bind byte (k7-mk byte-pretty byte-parse byte-witness))

;; parse returns the parsed v 
(define (parse-ok _s v) v)
(define (parse-no _s _v) 0)
(define (parse k7 s) ((k7-b k7) parse-ok parse-no s 0))

;; pretty returns final s
(define (pretty-ok s _v) (flatten-chunks s))
(define (pretty-no _s _v) 0)
(define (pretty k7 v) ((k7-a k7) pretty-ok pretty-no 0 v))

;; witness returns offset and witnesses 
(define (witness-ok off w) [off w])
(define (witness-no _off _len _w) 0)
(define (witness k7 off v) ((k7-c k7) witness-ok witness-no off v))

(define (nothing-witness ok no off _v)
    (ok off [off 0 0]))

(#bind nothing (k7-mk tr-id tr-id nothing-witness))