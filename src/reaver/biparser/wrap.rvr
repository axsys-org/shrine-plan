(#bind k7 (#module k7))
(#import k7)


(define (tagged-alt-pretty b1 b2 ok no s v)
    (Ifz (Or (Eq (Ix0 v) 0) (Eq (Ix0 v) 1)) (no s v)
    (Ifz (Ix0 v)
        (b1 ok no [[0] s] (Ix1 v)) 
        (b2 ok no [[1] s] (Ix1 v))
    )))

(define (tagged-alt-parse-cont ok tag s v)
    (ok s [tag v]))

(define (tagged-alt-parse b1 b2 ok no s v) 
    (Ifz (Sz s) (no s v)
    (Ifz (Or (Eq (Ix0 s) 0) (Eq (Ix0 s) 1)) (no s v)
    (Ifz (Ix0 s) 
        (b1 (tagged-alt-parse-cont ok 0) no (drop 1 s) 0)
        (b2 (tagged-alt-parse-cont ok 1) no (drop 1 s) 0)
    ))))

(define (tagged-alt-witness-cont ok tag start-off off wit)
    (ok off [start-off (Sub off start-off) tag [wit]]))

;;tag=0: inner wit looks like b1's output (e.g. [1 1 0] for byte)
;;tag=1: inner wit looks like b2's output (e.g. [1 2 [[1 1 0] [2 1 0]]] for cons)


(define (tagged-alt-witness b1 b2 ok no off v)
    (Ifz (Or (Eq (Ix0 v) 0) (Eq (Ix0 v) 1)) (no off v)
    (Ifz (Ix0 v)  
        (b1 (tagged-alt-witness-cont ok 0 off) no (Add off 1) (Ix1 v))
        (b2 (tagged-alt-witness-cont ok 1 off) no (Add off 1) (Ix1 v))
    )))


(define (tagged-alt b1 b2  
    (k7-mk 
        (tagged-alt-pretty (k7-a b1) (k7-a b2))
        (tagged-alt-parse (k7-b b1) (k7-b b2))
        (tagged-alt-witness (k7-c b1) (k7-c b2))
    )
))

