(#bind std (#module std))
(#import std)
(#bind k7 (#module k7))
(#import k7)
(#bind int (#module int))
(#import int)


(define (tagged-alt-pretty b ok no s v)
    (Ifz (Sz v) (no s v)
        (#let ((tag (Ix0 v)))
            (Ifz (Lt tag (Sz b)) (no s v)
                (#let ((branch (Ix tag b)))
                    (branch ok no [[tag] s] (Ix1 v)))))))


(define (tagged-alt-parse-cont ok tag s v)
    (ok s [tag v]))

(define (tagged-alt-parse b ok no s v)
    (Ifz (Sz s) (no s v)
        (#let ((tag (Ix0 s)))
            (Ifz (Lt tag (Sz b)) (no s v)
                (#let ((branch (Ix tag b)))
                    (branch (tagged-alt-parse-cont ok tag) no (drop 1 s) 0))))))


(define (tagged-alt-witness-cont ok tag start-off off wit)
    (ok off [start-off (Sub off start-off) tag [wit]]))

(define (tagged-alt-witness b ok no off v)
    (#let ((tag (Ix0 v)))
        (Ifz (Lt tag (Sz b)) (no off v)
            (#let ((branch (Ix tag b)))
                (branch (tagged-alt-witness-cont ok tag off) no (Add off 1) (Ix1 v))))))


(define (tagged-alt b)
    (k7-mk (tagged-alt-pretty  (map k7-a b))
           (tagged-alt-parse   (map k7-b b))
           (tagged-alt-witness (map k7-c b))))


(define (lp-pretty-cont ok s ns nv)
    (ok (lweld ns [(u32-bytes (lsum (lmap Sz ns))) s]) nv))

(define (lp-pretty p ok no s v)
    (p (lp-pretty-cont ok s) no 0 v))

(define (lp-parse-cont ok no after ns nv)
    (Ifz (Sz ns) (ok after nv) (no ns 0)))

(define (lp-parse p ok no s v)
    (Ifz (Lt (Sz s) 4)
        (#let ((size (bytes-u32 (Slice 0 4 s))))
            (#let ((rest (drop 4 s)))
                (Ifz (Lt (Sz rest) size)
                    (#let ((after (drop size rest)))
                        (p (lp-parse-cont ok no after) no (Slice 0 size rest) 0))
                    (no s v))))
        (no s v)))

(define (lp-witness-cont ok start-off off wit)
    (ok off [start-off (Sub off start-off) "lp" [wit]]))

(define (lp-witness p ok no off v)
    (p (lp-witness-cont ok off) no (Add off 4) v))

(define (length-prefixed p)
    (k7-mk (lp-pretty   (k7-a p))
           (lp-parse    (k7-b p))
           (lp-witness  (k7-c p))))
