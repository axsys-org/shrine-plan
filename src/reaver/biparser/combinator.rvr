(#bind std (#module std))
(#import std)
(#bind tr (#module tr))
(#import tr)
(#bind k7 (#module k7))
(#import k7)

(define (choice cassettes)
    (Ifz cassettes  k7-empty
        (Ifz (Ix1 cassettes) (Ix0 cassettes)
          (k7-alt (Ix0 cassettes) (choice (Ix1 cassettes))))))

(define (many-parse-done ok head ns tail)
    (ok ns [head tail]))

(define (many-parse-no ok s _ns _nv)
    (ok s 0))

(define (many-parse-ok rec p ok no ns head)
    (rec p (many-parse-done ok head) no ns 0))

(define (many-parse p ok no s xs)
    (p  (many-parse-ok many-parse p ok no)
        (many-parse-no ok s) s 0))

(define (many-print-ok rec p ok no tail ns _nv)
    (rec p ok no ns tail))

(define (many-print p ok no s xs)
    (Ifz xs
        (ok s xs)
        (p (many-print-ok many-print p ok no (Ix1 xs)) no s (Ix0 xs))))

(define (many-witness-loop-ok rec p ok no start-off tail wits off head)
    (rec p ok no start-off off (lweld wits [head 0]) tail))

(define (many-witness-loop p ok no start-off off wits xs)
    (Ifz xs
        (ok off ["many" (Sub off start-off) wits])
        (p (many-witness-loop-ok
            many-witness-loop p ok no start-off (Ix1 xs) wits) no off (Ix0 xs))))

(define (many-witness p ok no off xs)
    (many-witness-loop p ok no off off 0 xs))


(define (many p)
    (k7-mk (many-print (k7-print p))
           (many-parse (k7-parse p))
           (many-witness (k7-witness p))))




           