(#bind prim (#module prim))
(#import prim)
(#bind seq (#module seq))
(#import seq)

(#bind u8 byte)
(#bind u16 (take-n 2 byte))
(#bind u32 (take-n 4 byte))
(#bind u64 (take-n 8 byte))

(define (u32-bytes n)
    [(Trunc8 n)
     (Trunc8 (Rsh n 8))
     (Trunc8 (Rsh n 16))
     (Trunc8 (Rsh n 24))])

(define (bytes-u32 bs)
    (Add (Ix0 bs) 
      (Add (Lsh (Ix 1 bs) 8)
         (Add (Lsh (Ix 2 bs) 16)
            (Add (Lsh (Ix 3 bs) 24)
    )))))