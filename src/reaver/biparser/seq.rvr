(#bind std (#module std))
(#import std)
(#bind k7 (#module k7))
(#import k7)


;;; ============================================================================
;;; many — zero or more elements of p
;;; ============================================================================

(define (many-parse-done ok head ns tail)
    (ok ns [head tail]))

(define (many-parse-cont rec p ok no ns head)
    (rec p (many-parse-done ok head) no ns 0))

(define (many-parse-exit ok s _ns _nv)
    (ok s 0))

;; try to parse the head of s
;; on success: thread the remaining string and parsed head to cont
;; on empty string: pass the final success function
(define (many-parse p ok no s _v)
    (p (many-parse-cont many-parse p ok no)
       (many-parse-exit ok s)
       s 0))


(define (many-pretty-cont rec p ok no tail ns _nv)
    (rec p ok no ns tail))

;; try to print head of v, pass the tail on success
(define (many-pretty p ok no s v)
    (Ifz v
        (ok s 0)
        (p (many-pretty-cont many-pretty p ok no (Ix1 v)) no s (Ix0 v))))


(define (many-witness-cont rec p ok no start-off tail wits off wit)
    (rec p ok no start-off tail off [wit wits]))

;; given a starting offset, walk v and accumulate child witnesses
(define (many-witness-loop p ok no start-off v off wits)
    (Ifz v
        (ok off [start-off (Sub off start-off) (lrev wits)])
        (p (many-witness-cont many-witness-loop p ok no start-off (Ix1 v) wits)
           no off (Ix0 v))))

(define (many-witness p ok no start-off v)
    (many-witness-loop p ok no start-off v start-off 0))


(define (many p)
    (k7-mk (many-pretty  (k7-a p))
           (many-parse   (k7-b p))
           (many-witness (k7-c p))))


;;; ============================================================================
;;; cons — pair of f then g
;;; ============================================================================

;; print the head of v via f, then print the tail of v via g
(define (cons-pretty-cont g ok no tail ns _nv)
    (g ok no ns tail))

(define (cons-pretty f g ok no s v)
    (f (cons-pretty-cont g ok no (Ix1 v)) no s (Ix0 v)))


(define (cons-parse-done ok head ns tail)
    (ok ns [head tail]))

(define (cons-parse-cont g ok no ns head)
    (g (cons-parse-done ok head) no ns 0))

(define (cons-parse f g ok no s _v)
    (f (cons-parse-cont g ok no) no s 0))


(define (cons-witness-done ok start-off f-wit end-off g-wit)
    (ok end-off [start-off (Sub end-off start-off) [f-wit g-wit]]))

(define (cons-witness-cont g ok no start-off tail mid-off wit)
    (g (cons-witness-done ok start-off wit) no mid-off tail))

(define (cons-witness f g ok no off v)
    (f (cons-witness-cont g ok no off (Ix1 v)) no off (Ix0 v)))


(define (cons f g)
    (k7-mk (cons-pretty  (k7-a f) (k7-a g))
           (cons-parse   (k7-b f) (k7-b g))
           (cons-witness (k7-c f) (k7-c g))))


;;; ============================================================================
;;; take-n — exactly n elements of p
;;; ============================================================================

(define (take-pretty-cont rec n p ok no tail ns _nv)
    (rec n p ok no ns tail))

;; print exactly n elements of v via p
(define (take-pretty n p ok no s v)
    (Ifz n
        (ok s 0)
        (Ifz v
            (no s v)
            (p (take-pretty-cont take-pretty (Sub n 1) p ok no (Ix1 v))
               no s (Ix0 v)))))


(define (take-parse-done ok head ns tail)
    (ok ns [head tail]))

(define (take-parse-cont rec n p ok no ns head)
    (rec n p (take-parse-done ok head) no ns 0))

;; parse exactly n elements via p, build list
(define (take-parse n p ok no s _v)
    (Ifz n
        (ok s 0)
        (p (take-parse-cont take-parse (Sub n 1) p ok no) no s 0)))


(define (take-witness-cont rec n p ok no start-off tail wits off wit)
    (rec n p ok no start-off tail off [wit wits]))

;; walk n elements of v via p, build [start len kids] with n kids
(define (take-witness-loop n p ok no start-off v off wits)
    (Ifz n
        (ok off [start-off (Sub off start-off) (lrev wits)])
        (p (take-witness-cont take-witness-loop (Sub n 1) p ok no start-off (Ix1 v) wits)
           no off (Ix0 v))))

(define (take-witness n p ok no start-off v)
    (take-witness-loop n p ok no start-off v start-off 0))


(define (take-n n p)
    (k7-mk (take-pretty  n (k7-a p))
           (take-parse   n (k7-b p))
           (take-witness n (k7-c p))))
