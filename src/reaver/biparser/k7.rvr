(#bind biparser-tr (#module tr))
(#import tr)

(define (k7-mk a b c)
    ["K7" a b c "opaque" 0])

(define (k7-mk-meta a b c kind args)
    ["K7" a b c kind args])

(define (k7-a k7) (_1 k7))
(define (k7-b k7) (_2 k7))
(define (k7-c k7) (_3 k7))
(define (k7-kind k7) (_4 k7))
(define (k7-args k7) (_5 k7))
