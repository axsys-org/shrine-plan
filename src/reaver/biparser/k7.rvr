(#bind std (#module std))
(#import std)
(#bind biparser-tr (#module tr))
(#import tr)

(define (k7-mk print parse witness)
    ["K7" print parse witness])

(define (k7-print k7) (_1 k7))
(define (k7-parse k7) (_2 k7))
(define (k7-witness k7) (_3 k7))

(define (k7-compose f g)
    (k7-mk (tr-compose (k7-print f) (k7-print g))
           (tr-compose (k7-parse f) (k7-parse g))
           (tr-compose (k7-witness f) (k7-witness g))))

(define (k7-alt-witness-f-ok start-off ok end-off f-w)
    (ok end-off
        ["alt" start-off (Sub end-off start-off) 0 f-w]))

(define (k7-alt-witness-g-ok start-off ok end-off g-w)
    (ok end-off
        ["alt" start-off (Sub end-off start-off) 1 g-w]))

(define (k7-alt-witness-f-no g start-off ok no _f-off _f-v)
    (g (k7-alt-witness-g-ok start-off ok) no start-off 0))

(define (k7-alt-witness f g ok no off _v)
    (f (k7-alt-witness-f-ok off ok)
       (k7-alt-witness-f-no g off ok no) off 0))

(define (k7-alt f g)
    (k7-mk (tr-alt (k7-print f) (k7-print g))
           (tr-alt (k7-parse f) (k7-parse g))
           (k7-alt-witness (k7-witness f) (k7-witness g))))

;; parse head with f and tail with g
(define (k7-cons-parse-done ok head ns tail)
    (ok ns [head tail]))

(define (k7-cons-parse-ok g ok no ns head)
    (g (k7-cons-parse-done ok head) no ns 0))

(define (k7-cons-parse f g ok no s v)
    (f (k7-cons-parse-ok g ok no) no s v))

;; print the head by running f and then print the tail by running g
(define (k7-cons-print-ok g ok no tail ns _nv)
    (g ok no ns tail))

(define (k7-cons-print f g ok no s v)
    (f (k7-cons-print-ok g ok no (Ix1 v)) no s (Ix0 v)))

;; leaves
;; ["leaf" off len]
;; ["empty" off 0]
;; ["cons" off len head-w tail-w]
;; ["many" off len [w0 w1 w2 ... ]]
;; ["alt" off len branch-idx inner-w]

(define (k7-cons-witness-done start-off ok f-w end-off g-w)
    (ok end-off
        ["cons" start-off (Sub end-off start-off) f-w g-w]))

(define (k7-cons-witness-ok g start-off ok no tail mid-off f-w)
    (g (k7-cons-witness-done start-off ok f-w) no mid-off tail))

(define (k7-cons-witness f g ok no off v)
    (f (k7-cons-witness-ok g off ok no (Ix1 v)) no off (Ix0 v)))

(define (k7-cons f g)
    (k7-mk (k7-cons-print (k7-print f) (k7-print g))
           (k7-cons-parse (k7-parse f) (k7-parse g))
           (k7-cons-witness (k7-witness f) (k7-witness g))))

(define (k7-id)
    (k7-mk tr-id tr-id tr-id))

(#bind k7-empty (k7-mk tr-empty tr-empty tr-empty))