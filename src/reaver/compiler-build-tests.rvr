;;;; New cache operations, app composition and generated contracts.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind build (#module compiler-build))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind rex (#module rex))
(define (tree text) (rex:ParseRexNormFile text))
(define (read name)
  (cond
    ((Equal name "cb_good") (tree "+ answer 42"))
    ((Equal name "cb_dep") (tree "+ value 7"))
    ((Equal name "cb_bad") (tree "- cb_dep
+ broken | missing 1
"))
    (else (error ["unexpected module" name]))))
(define roster (build:compile-roster-with read driver:empty-foil-cache
  ["cb_bad" "cb_good"]))
assert(Equal ["cb_bad"] (_1 roster))
assert(Nil (driver:get-foil-cache "cb_dep" (_0 roster)))
assert(Eq 42 (driver:get-perc ["answer"]
  (_0 (driver:get-foil-cache "cb_good" (_0 roster)))))
assert(Equal [(_0 roster) 1]
  (build:cache-compile-with (lambda (name) (error "unexpected read"))
    (_0 roster) "cb_good"))
assert(Equal [(_0 roster) 0]
  (build:cache-compile-with read (_0 roster) "cb_bad"))

assert(Equal [driver:empty-foil-cache []]
  (build:compile-apps-with (lambda (path) (error "unexpected read"))
    driver:empty-foil-cache []))

(define (check-apps z)
  (define policy (source:compile driver:empty-foil-cache "app_install"))
  (define cache (_0 policy))
  (define good (source:compile-rex cache "apps/cb_code/main"
    (tree "- pact
+ doc
  ^ str
  0
+ app
  ^ mani
  | mani 'code (lore/line doc) [] [] []
")))
  (define only (source:compile-rex (_0 good) "apps/cb_only/main"
    (driver:perc-rex (_1 good))))
  (define wrong (source:compile-rex (_0 only) "apps/cb_wrong/main"
    (tree "- pact
+ mani
  + ok
    \ value=pail
    ^ bool
    .true
+ app 7
")))
  (define (files path)
    (cond
      ((Equal path "foil/apps/cb_code/main.foil") "cached")
      ((Equal path "foil/apps/cb_only/main.foil") "cached")
      ((Equal path "foil/apps/cb_nomani/main.grove") "+ item
  ! title t
")
      ((Equal path "foil/apps/cb_wrong/main.foil") "cached")
      ((Equal path "foil/apps/cb_grove/main.grove")
        "+ item
  ! title n
  : title 7
")
      ((Equal path "foil/apps/cb_code/main.grove")
        "+ item
  ! title t
")
      (else 0)))
  (define bad (build:compile-apps-with files (_0 wrong) ["cb_wrong" "cb_missing" "cb_nomani"]))
  assert(Equal (_0 wrong) (_0 bad))
  assert(Equal ["ERR" "ERR" "ERR"] (map (lambda (e) (_0 (_1 e))) (_1 bad)))
  assert(Nil (driver:get-foil-cache "apps/cb_nomani/main_spec" (_0 bad)))
  (define result (build:compile-apps-with files (_0 wrong)
    ["cb_code" "cb_grove" "cb_only" "cb_missing"]))
  assert(Equal ["OK" "OK" "OK" "ERR"]
    (map (lambda (e) (_0 (_1 e))) (_1 result)))
  assert(Equal "/boot/pact/mani" (Hd (_1 (_1 (_0 (_1 result))))))
  assert(Truth (driver:get-foil-cache "apps/cb_code/main_spec" (_0 result)))
  assert(Truth (driver:get-foil-cache "apps/cb_grove/main_spec" (_0 result)))
  (define spec (_0 (driver:get-foil-cache "apps/cb_grove/main_spec" (_0 result))))
  (define yoke (driver:get-perc ["spec"] spec))
  (define at (driver:get-perc ["yoke" "at"] spec))
  (define lash (_0 (at [("ts" "item")] yoke)))
  ;; Inspect the concrete map node: the contract type is module-qualified.
  assert(Equal [[("ts" "boot") ("ts" "lain_types") ("ts" "pails") ("ts" "n")]]
    (_2 (_1 lash)))
  (define real (build:compile-app 0 (_0 result) "board"))
  assert(Equal "OK" (_0 (_1 real)))
  assert(Equal "/boot/pact/mani" (Hd (_1 (_1 real))))
  1)
assert(Eq 1 (check-apps 0))
(define disk (build:cache-compile driver:empty-foil-cache "test_fixtures/env_low"))
assert(Eq 1 (_1 disk))
assert(Truth (driver:get-foil-cache "test_fixtures/env_low" (_0 disk)))
(print "Compiler build tests passed")
