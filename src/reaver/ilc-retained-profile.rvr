;; Profiling only: force observable values, never retained traces.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ilc (#module ilc))
(#bind cache (#module ilc-retained))
(#bind structural (#module ilc-structural))
(#bind tc (#module ilc-typecheck))
(#bind fixture (#module ilc-typecheck-fixture))
(#bind zone (#module profile-zone))

(define (phase label work project)
  (define mark (print ("PROFILE-START" label)))
  (define handle (Seq mark (zone:zone-start label)))
  (define start (Seq handle (Now 0)))
  (define answer (Seq start (work 0)))
  (define end (DeepSeq (project answer) (Now 0)))
  (Seq end (Seq (zone:zone-end handle)
    (Seq (print ("PROFILE-END" label (showNat (Sub end start)))) answer))))
;; Preserve the benchmark's validation order, including output-delta checking.
(define (validated derivative state edits)
  (Ifz edits state
    (let ((dx (_0 edits)) (input (_1 state)) (output (cache:value state)))
      (define result (cache:advance state dx))
      (define fresh (_1 result))
      (define full (tc:check (ilc:apply-change input dx)))
      (define staged (tc:update derivative input output dx))
      (If (And (Equal full staged)
            (And (Equal full (cache:value fresh)) (Equal full (ilc:apply-change output (_0 result)))))
        (validated derivative fresh (drop 1 edits))
        (error "profile validation mismatch")))))
(define (updated state edits index)
  (Ifz edits state
    (let ((fresh (DeepSeq (cache:value state)
      (phase (strWeld "update." (showNat index))
        (lambda (z) (_1 (cache:advance state (_0 edits)))) cache:value))))
      (DeepSeq (cache:value fresh) (updated fresh (drop 1 edits) (Inc index))))))
;; Profiling ablation only: fully normalize this valid fixture's input and
;; output, then return only program/input/output, with no old cache/history.
(define (detached-input depth count)
  (define compiler (fixture:compiler 0))
  (define input [compiler (fixture:tree depth 1)])
  (define rules (structural:rules-with ilc:derive-staged-with))
  (define derivative (ilc:derive-staged-with rules tc:check))
  (define program (cache:prepare rules tc:check))
  (define edits (gen count (lambda (i) (fixture:edit depth (Add 100 i)))))
  (define full (DeepSeq [input edits]
    (phase "initial.full" (lambda (z) (tc:check input)) (lambda (x) x))))
  (define initial (DeepSeq full
    (phase "initial.retained" (lambda (z) (cache:start program input)) cache:value)))
  (define history (DeepSeq (cache:value initial)
    (phase "validation" (lambda (z) (validated derivative initial edits)) cache:value)))
  (DeepSeq [(_1 history) (cache:value history)]
    [program (_1 history) (cache:value history)]))
(define (run-detached depth count)
  (define ready (detached-input depth count))
  (define fresh (Seq ready
    (phase "reset" (lambda (z) (cache:start (_0 ready) (_1 ready))) cache:value)))
  (If (Equal (_2 ready) (cache:value fresh)) (print "RETAINED-PROFILE-DONE")
    (error "detached reset mismatch")))
(define (run-held variant depth count)
  (define compiler (fixture:compiler 0))
  (define input [compiler (fixture:tree depth 1)])
  (define rules (structural:rules-with ilc:derive-staged-with))
  (define derivative (ilc:derive-staged-with rules tc:check))
  (define program (cache:prepare rules tc:check))
  (define edits (gen count (lambda (i) (fixture:edit depth (Add 100 i)))))
  (define full (DeepSeq [input edits]
    (phase "initial.full" (lambda (z) (tc:check input)) (lambda (x) x))))
  (define initial (DeepSeq full
    (phase "initial.retained" (lambda (z) (cache:start program input)) cache:value)))
  (define history (DeepSeq (cache:value initial)
    (If (Equal variant "updates-only") (updated initial edits 0)
      (phase "validation" (lambda (z) (validated derivative initial edits)) cache:value))))
  (define prepared (DeepSeq (cache:value history)
    (If (Equal variant "input-forced")
      (phase "input.force" (lambda (z) (_1 history)) (lambda (x) x)) 0)))
  (define reset (Seq prepared
    (phase "reset" (lambda (z)
      (If (Equal variant "reconstructed")
        (cache:start program (Ifz count input (ilc:apply-change input (fixture:edit depth (Add 99 count)))))
        (cache:reset history))) cache:value)))
  (Seq (cache:value reset)
    (If (Equal (cache:value history) (cache:value reset))
      (print "RETAINED-PROFILE-DONE") (error "profile reset mismatch"))))
(define (run variant depth count)
  (If (Equal variant "detached") (run-detached depth count) (run-held variant depth count)))
(#export run)
