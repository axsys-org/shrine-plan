(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; weft.foil: HTML from arithmetic.  Expected strings are host-built
;;; (strcat/strWeld can hold quote bytes; foil cord literals cannot).

(define weft-sut (stage:sut-of "weft"))
(define (wf path) (foil:source-entry-val path weft-sut))

(define cat2 (wf ["weft" "cat2"]))
(define cat (wf ["weft" "cat"]))
(define wjoin (wf ["weft" "join"]))
(define esc (wf ["weft" "esc"]))
(define show-nat (wf ["weft" "show_nat"]))
(define blen (wf ["weft" "blen"]))
(define w-el (wf ["weft" "el"]))
(define w-leaf (wf ["weft" "leaf"]))
(define w-tx (wf ["weft" "tx"]))
(define w-raw (wf ["weft" "raw"]))
(define w-cls (wf ["weft" "cls"]))
(define w-href (wf ["weft" "href"]))
(define render (wf ["weft" "render"]))
(define page (wf ["weft" "page"]))

(define q 34)

;;; string layer ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Eq 0 (blen 0))
assert(Eq 5 (blen "hello"))
assert(Equal "abcd" (cat2 "ab" "cd"))
assert(Equal "x" (cat2 0 "x"))
assert(Equal "x" (cat2 "x" 0))
assert(Equal "a/b/c" (wjoin "/" ["a" "b" "c"]))
assert(Eq 0 (wjoin "/" []))
assert(Equal "a" (wjoin "/" ["a"]))
assert(Equal "a&amp;b&lt;c&gt;d&quot;e" (esc (strcat ["a&b<c>d" (strWeld q "e")])))
assert(Equal "0" (show-nat 0))
assert(Equal "12345" (show-nat 12345))

;;; node layer ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; attrs render quoted, values escaped
(define a1 (render (w-leaf "a" [(w-href "/ns/x")] "go")))
assert(Equal (strcat ["<a href=" q "/ns/x" q ">go</a>"]) a1)

;; classes, nesting, raw, and render-time escaping
(define nd
  (w-el "div" [(w-cls "row")]
    [(w-tx "a<b")
     (w-raw "<hr>")
     (w-leaf "span" [] "ok")]))
(define h1 (render nd))
assert(Equal
  (strcat ["<div class=" q "row" q ">a&lt;b<hr><span>ok</span></div>"])
  h1)

;; the page shell
(define pg (page "t" "body{color:red}" [(w-leaf "h1" [] "hi")]))
;; the quote byte, spliced — string literals cannot carry escapes
(define qb 34)
(define want-pg
  (strcat
    ["<!doctype html><html><head><title>t</title>"
     "<style>body{color:red}</style>"
     ;; every page links the disk-read dev stylesheet after its
     ;; inline block (weft/page, 2026-08-16)
     ;; weft/render closes every element - no void-tag handling - so
     ;; the link carries a (browser-ignored) close tag
     "<link rel=" qb "stylesheet" qb " href=" qb "/style.css" qb "></link>"
     "</head>"
     "<body><h1>hi</h1></body></html>"]))
assert(Equal want-pg pg)

(print "weft tests passed")
