(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; weft.foil: HTML from arithmetic.  Expected strings are host-built
;;; (strcat/strWeld can hold quote bytes; foil cord literals cannot).

(define weft-sut (stage:sut-of "weft"))
(define (wf path) (foil:source-entry-val path weft-sut))

(define cat2 (wf ["weft" "cat2"]))
(define cat (wf ["weft" "cat"]))
(define wjoin (wf ["weft" "join"]))
(define esc (wf ["weft" "esc"]))
(define show-nat (wf ["weft" "show_nat"]))
(define blen (wf ["weft" "blen"]))
(define w-el (wf ["weft" "el"]))
(define w-leaf (wf ["weft" "leaf"]))
(define w-tx (wf ["weft" "tx"]))
(define w-raw (wf ["weft" "raw"]))
(define w-cls (wf ["weft" "cls"]))
(define w-href (wf ["weft" "href"]))
(define packet-terminal (wf ["weft" "packet_terminal"]))
(define packet-mount (wf ["weft" "packet_mount"]))
(define render (wf ["weft" "render"]))
(define runtime (wf ["weft" "runtime"]))
(define page (wf ["weft" "page"]))

(define q 34)
(define (contains? needle hay)
  (define nb (Bytes needle))
  (define hb (Bytes hay))
  (define (go i)
    (cond
      ((Gt (Add i nb) hb) 0)
      ((Eq needle (Mod (Rsh hay (Mul 8 i)) (Lsh 1 (Mul 8 nb)))) 1)
      (else (go (Inc i)))))
  (go 0))

;;; string layer ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

assert(Eq 0 (blen 0))
assert(Eq 5 (blen "hello"))
assert(Equal "abcd" (cat2 "ab" "cd"))
assert(Equal "x" (cat2 0 "x"))
assert(Equal "x" (cat2 "x" 0))
assert(Equal "a/b/c" (wjoin "/" ["a" "b" "c"]))
assert(Eq 0 (wjoin "/" []))
assert(Equal "a" (wjoin "/" ["a"]))
assert(Equal "a&amp;b&lt;c&gt;d&quot;e" (esc (strcat ["a&b<c>d" (strWeld q "e")])))
assert(Equal "0" (show-nat 0))
assert(Equal "12345" (show-nat 12345))

;;; node layer ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; attrs render quoted, values escaped
(define a1 (render (w-leaf "a" [(w-href "/ns/x")] "go")))
assert(Equal (strcat ["<a href=" q "/ns/x" q ">go</a>"]) a1)

;; classes, nesting, raw, and render-time escaping
(define nd
  (w-el "div" [(w-cls "row")]
    [(w-tx "a<b")
     (w-raw "<hr>")
     (w-leaf "span" [] "ok")]))
(define h1 (render nd))
assert(Equal
  (strcat ["<div class=" q "row" q ">a&lt;b<hr><span>ok</span></div>"])
  h1)

;; Progressive packet markup keeps its three namespaces separate:
;; packet is opaque cache correlation, terminal targets are local
;; pronunciation handles, and semantic occurrence addresses exist only in
;; the JSON frames fetched from the mechanical delivery location.
(define packet-html
  (render
    (packet-mount "packet-7" "/projection/frames/7"
      "/observe/z/$case/projection/7" "z"
      [(packet-terminal "scene-root" [(w-tx "loading scene")])
       (packet-terminal "chat-log" [])])))
(define want-packet-html
  (strcat
    ["<div w-packet=" q "packet-7" q
     " w-frame-get=" q "/projection/frames/7" q
     " w-observe=" q "/observe/z/$case/projection/7" q
     " w-watch=" q "z" q ">"
     "<div w-terminal=" q "scene-root" q ">loading scene</div>"
     "<div w-terminal=" q "chat-log" q "></div>"
     "</div>"]))
assert(Equal want-packet-html packet-html)
assert(Eq 1 (contains? (strcat ["w-packet=" q "packet-7" q]) packet-html))
assert(Eq 1 (contains? (strcat ["w-terminal=" q "scene-root" q]) packet-html))
assert(Eq 0 (contains? "w-address" packet-html))
assert(Eq 0 (contains? "occurrence-axis" packet-html))
assert(Eq 0 (contains? "/chat/layout" packet-html))

;; Every helper-provided value still goes through normal attribute/text
;; escaping, including the packet key and terminal fallback.
(define escaped-packet
  (render
    (packet-mount "cache&key" "/frames?a=1&b=2" "/observe/$case" "x"
      [(packet-terminal "root<main" [(w-tx "waiting < now")])])))
assert(Eq 1
  (contains? (strcat ["w-packet=" q "cache&amp;key" q]) escaped-packet))
assert(Eq 1
  (contains? (strcat ["w-terminal=" q "root&lt;main" q]) escaped-packet))
assert(Eq 1 (contains? "waiting &lt; now" escaped-packet))

;; the page shell
(define pg (page "t" "body{color:red}" [(w-leaf "h1" [] "hi")]))
(define want-pg
  (strcat
    ["<!doctype html><html><head><title>t</title>"
     "<style>body{color:red}</style></head>"
     "<body><h1>hi</h1></body></html>"]))
assert(Equal want-pg pg)

;; the browser helper preserves submit order and refuses stale loads
assert(Eq 1 (contains? "var queue=Promise.resolve()" runtime))
assert(Eq 1 (contains? "queue=queue.catch" runtime))
assert(Eq 1 (contains? "el._wLoad===n" runtime))
assert(Eq 1 (contains? "el._wLast===t" runtime))
assert(Eq 1 (contains? "function scrollAfter(f,els,ok)" runtime))
assert(Eq 1 (contains? "querySelector('[w-scroll-target]')" runtime))
assert(Eq 1 (contains? "t.scrollTop=t.scrollHeight" runtime))
assert(Eq 1 (contains? "scrollAfter(f,targets,ok)" runtime))
assert(Eq 1 (contains? "w-watch" runtime))
assert(Eq 1 (contains? "w-observe" runtime))
assert(Eq 1 (contains? "replace('$case',String(c))" runtime))
assert(Eq 0 (contains? "u.slice(5)" runtime))
assert(Eq 0 (contains? "'/watch/'" runtime))
;; A project may reveal nested live holes and forms.  Every swap scans
;; the inserted branch, while element-local guards prevent duplicate
;; observe and submit loops when an ancestor refreshes again.
assert(Eq 1 (contains? "armWithin(root)" runtime))
assert(Eq 1 (contains? "armWithin(document)" runtime))
assert(Eq 1 (contains? "if(el._wArmed){return}" runtime))
assert(Eq 1 (contains? "if(f._wWired){return}" runtime))
assert(Eq 1 (contains? "root.querySelectorAll('[w-get]')" runtime))
assert(Eq 1 (contains? "root.querySelectorAll('form[w-post]')" runtime))
assert(Eq 1 (contains? "el.isConnected" runtime))
assert(Eq 1 (contains? "refresh(el,0)" runtime))
assert(Eq 0 (contains? "{wait(el,0)}" runtime))
assert(Eq 0 (contains? "setInterval" runtime))

;;; Progressive projection delivery remains a small mechanical browser
;;; assembler.  Semantic DAG contents and durable identity arrive from the
;;; server; the runtime only folds exact revision frames, paints optional
;;; terminal pronunciations at explicit terminal targets, and commits atomically.
assert(Eq 1 (contains? "window.WeftProjection=" runtime))
assert(Eq 1 (contains? "function applyFrame(f)" runtime))
assert(Eq 1 (contains? "k==='begin'" runtime))
assert(Eq 1 (contains? "if(k==='upsert')" runtime))
assert(Eq 1 (contains? "k==='withdraw'" runtime))
assert(Eq 1 (contains? "k==='complete'" runtime))
assert(Eq 1 (contains? "k==='refuse'" runtime))
assert(Eq 1 (contains? "!sameManifest(p.manifest,m)||s.closed[r]" runtime))
assert(Eq 1 (contains? "s.committed=p;s.pending=null" runtime))
assert(Eq 1 (contains? "w-pending-revision" runtime))
assert(Eq 1 (contains? "w-revision" runtime))
assert(Eq 1 (contains? "if(s.closed[r]" runtime))
assert(Eq 1 (contains? "if(s.closedOrder.length>32)" runtime))

;; Addressed DAG entries and exact manifests are supplied by the server.  A
;; pending DAG begins empty: immutable reuse is permitted only for the
;; manifest's explicit retain set, matching foundry_delivery vocabulary.
assert(Eq 1 (contains? "typeof id!=='string'||!id.length" runtime))
assert(Eq 1 (contains? "var a=f&&f.address" runtime))
assert(Eq 1 (contains? "manifest:m,entries:Object.create(null)" runtime))
assert(Eq 1 (contains? "!Array.isArray(m.roots)" runtime))
assert(Eq 1 (contains? "!Array.isArray(m.retain)" runtime))
assert(Eq 1 (contains? "!Array.isArray(m.frontier)" runtime))
assert(Eq 1 (contains? "if(!rs.length){return{dag:p,terminal:t}}" runtime))
assert(Eq 1 (contains? "if(own(c.entries,a))" runtime))
assert(Eq 1 (contains? "next=retained(s,m);if(!next){return false}" runtime))
assert(Eq 1 (contains? "s.pending=next.dag" runtime))
assert(Eq 1 (contains? "stamp(s,'w-pending-revision',r);paintAll(s,old,true)" runtime))
assert(Eq 1 (contains? "getAttribute('w-terminal')===a" runtime))
assert(Eq 0 (contains? "getAttribute('w-address')" runtime))
assert(Eq 0 (contains? "split('/')" runtime))
assert(Eq 0 (contains? "occurrenceAxis=" runtime))
assert(Eq 0 (contains? "resolveRecipe" runtime))
assert(Eq 1 (contains? "semanticAddress:a,target:p.target" runtime))
assert(Eq 1 (contains? "committedTerminal:Object.create(null)" runtime))
assert(Eq 1 (contains? "s.committedTerminal=s.pendingTerminal" runtime))
assert(Eq 1 (contains? "packet:s.id,dag:c,terminal:t" runtime))
assert(Eq 0 (contains? "pronunciations:Object.create(null)" runtime))

;; Upsert cannot mutate an occupied canonical address.  Resolve is deliberately
;; narrower: the exact addressed pending entry must still be a same-kind hole.
assert(Eq 1 (contains? "JSON.stringify(p.entries[a])!==JSON.stringify(e)" runtime))
assert(Eq 1 (contains? "if(k==='resolve')" runtime))
assert(Eq 1 (contains? "!own(p.entries,a)" runtime))
assert(Eq 1 (contains? "if(!old.hole||old.kind!==e.kind){return false}" runtime))
assert(Eq 1 (contains? "kind:'tombstone',target:kind,hole:false" runtime))
assert(Eq 1 (contains? "function rebuildWithdrawn(p)" runtime))
assert(Eq 1 (contains? "if(e&&e.kind==='tombstone')" runtime))
assert(Eq 1 (contains? "if(e.kind==='tombstone'){if(e.target!==kind)" runtime))

;; Complete mirrors Foundry's structural completion gate.  Roots must be live
;; nodes; listed placements must exist under their exact parent; dependencies,
;; children, and fallbacks must be present or explicitly in the frontier.
;; A malformed or partial progressive prefix therefore remains pending.
assert(Eq 1 (contains? "function completeDag(p)" runtime))
assert(Eq 1 (contains? "if(!live(p,roots[i],'node'))" runtime))
assert(Eq 1 (contains? "p.entries[s.placements[j]].object.placement.parent!==e.address" runtime))
assert(Eq 1 (contains? "if(!known(p,s.dependencies[j]))" runtime))
assert(Eq 1 (contains? "if(!completeDag(p)){return false}" runtime))

;; Only completed, scrubbed snapshots reach IndexedDB.  Open or refused
;; revisions stay in memory, and database failure resolves to memory-only.
assert(Eq 1 (contains? "window.indexedDB.open('weft-projection-cache',1)" runtime))
assert(Eq 1 (contains? "if(!window.indexedDB){done(null);return}" runtime))
assert(Eq 1 (contains? "q.onblocked=function(){done(null)}" runtime))
assert(Eq 1 (contains? "f.cachePolicy==='non-authoritative'" runtime))
assert(Eq 1 (contains? "if(!c||!allowed){return}" runtime))
assert(Eq 1 (contains? "t[ks[i]].cachePolicy!=='non-authoritative'" runtime))
assert(Eq 1 (contains? "function cachedDag(id,x)" runtime))
assert(Eq 1 (contains? "return completeDag(m)?m:null" runtime))
assert(Eq 0 (contains? "manifest.persistence" runtime))
assert(Eq 1 (contains? "if(k==='complete')" runtime))
assert(Eq 1 (contains? "paintAll(s,old,true);save(s,allowed);return true" runtime))
assert(Eq 1 (contains? "authority|authorization|capability|capabilities" runtime))
assert(Eq 1 (contains? "actiontoken|authoritytoken|capabilitytoken|sendcaps" runtime))
assert(Eq 0 (contains? "localStorage" runtime))
assert(Eq 0 (contains? "BroadcastChannel" runtime))

;; New frame streams use the same load-first, one-shot observation discipline
;; as legacy HTML fragments.  Legacy w-get and refresh(el,0) remain intact.
assert(Eq 1 (contains? "w-frame-get" runtime))
assert(Eq 1 (contains? "frameRefresh(el,0)" runtime))
assert(Eq 1 (contains? "frameLoad(el).then" runtime))
assert(Eq 1 (contains? "refresh(el,0)" runtime))
assert(Eq 1 (contains? "load(el).then" runtime))
assert(Eq 1 (contains? "restore(id);paintAll(s,null,false)" runtime))
assert(Eq 1 (contains? "else if(el.getAttribute('w-frame-get'))" runtime))

;; HTTP refusal is not a transport failure.  Every 4xx and 501 is terminal;
;; outside that set typed server retryability wins and ordinary 5xx retries.
;; Terminal responses stop the refresh loop and expose their problem without
;; replacing a previously committed or server-fallback pronunciation.
assert(Eq 1 (contains? "function httpProblem(r,x)" runtime))
assert(Eq 1
  (contains? "typeof p.retryable==='boolean'?p.retryable" runtime))
assert(Eq 1
  (contains? "terminal=r.status===501||(r.status>=400&&r.status<500)"
    runtime))
assert(Eq 1
  (contains? "retry=terminal?false:" runtime))
assert(Eq 1
  (contains? "return{ok:false,retry:p.retryable,terminal:!p.retryable}"
    runtime))
assert(Eq 1
  (contains? "if(x.retry){retry(function(){frameRefresh(el,c)})}" runtime))
assert(Eq 1
  (contains? "function frameRefresh(el,c){if(!el.isConnected){return}"
    runtime))
assert(Eq 0
  (contains? "else{retry(function(){frameRefresh(el,c)})}" runtime))
assert(Eq 0 (contains? "return r.ok?r.json():null" runtime))

;; Diagnostics are inspectable both without a framework and through the small
;; runtime API.  Semantic Refuse frames use the same signal but remain distinct
;; from retryable transport problems.
assert(Eq 1 (contains? "w-frame-status" runtime))
assert(Eq 1 (contains? "w-frame-error" runtime))
assert(Eq 1 (contains? "w-frame-retryable" runtime))
assert(Eq 1 (contains? "weft:projection-refusal" runtime))
assert(Eq 1 (contains? "kind:'projection',status:200" runtime))
assert(Eq 1 (contains? "refusal:s.refusal,problem:s.problem" runtime))

;; A complete fetch of the manifest already committed by this packet is a
;; benign stale read.  It neither reopens the closed revision nor becomes a
;; protocol refusal, and observation can simply be armed again.
assert(Eq 1 (contains? "function sameCommittedBatch(s,x)" runtime))
assert(Eq 1
  (contains? "if(sameCommittedBatch(s,x)){clearProblem(s);return{ok:true,retry:false,same:true}}"
    runtime))

;; Malformed successful frame/observe bodies are authoritative protocol
;; failures rather than permanent one-second retry loops.  Network rejection
;; remains explicitly retryable.
assert(Eq 1 (contains? "invalid_frame_json" runtime))
assert(Eq 1 (contains? "invalid_frame_envelope" runtime))
assert(Eq 1 (contains? "invalid_frame_batch" runtime))
assert(Eq 1 (contains? "invalid_observe_case" runtime))
assert(Eq 1 (contains? "frame_processing_failed" runtime))
assert(Eq 1 (contains? "observe_processing_failed" runtime))
assert(Eq 1 (contains? "if(phase==='apply')" runtime))
assert(Eq 1 (contains? "transport_failure" runtime))
assert(Eq 1 (contains? "return{ok:false,retry:true}" runtime))

(print "weft tests passed")
