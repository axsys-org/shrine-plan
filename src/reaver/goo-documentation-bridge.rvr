;;;; Read metadata from the exact pinned artifact already attached to a record.
;;;; This bridge never loads source files, compiles, evaluates examples, or writes.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind ca (#module cairn))
(#bind driver (#module foil-new-env))
(#bind subject (#module foil-subject))
(#bind context (#module foil-context))
(#bind lore (#module foil-lore))
(#bind entry (#module foil-entry))
(#bind inspect (#module compiler-inspect))

(define (reader policy slot)
  (define artifact (driver:get-perc ["goo_documentation" "artifact"] policy))
  (define metadata (driver:get-perc ["goo_documentation" "metadata"] policy))
  (lambda (target card)
    (define (read ignored)
      (define found (artifact slot card))
      (If (Nil found) card
        (let* ((perc (driver:require-perc (Unpin (_0 found))))
               (sut (driver:perc-subject perc))
               (unit (subject:sut-context sut))
               (path (map (lambda (part) [(Hd part) (_0 part)]) target))
               (moment (ca:getax path (_1 unit))))
          (If (Nil moment) card
            (let* ((local (need (context:local-definition unit [path (_0 moment)])))
                   (key (subject:root-path sut local))
                   (part (entry:entry-parts sut key))
                   (doc (lore:lore-for (driver:perc-lore perc) local))
                   (source (inspect:entry-source ["" 0] perc (driver:perc-entry-span key perc))))
              (metadata card (If doc (lore:lore-head (_0 doc)) "")
                (If doc (lore:lore-body (_0 doc)) [])
                (If doc (lore:lore-test-pairs (_0 doc)) [])
                source
                (entry:entry-kind sut key (entry:ent-tc part))))))))
    (define result (Try (lambda (ignored) (force (read 0))) 0))
    (If (Eq 1 (Hd result)) card (_0 result))))

(#export reader)
