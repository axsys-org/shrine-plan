(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))


;;; Helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (rx-strip-spans r)
  (define tag (Hd r))
  (cond
    ((Eq tag "leaf") ["leaf" (_1 r) (_2 r)])
    ((Eq tag "nest") ["nest" (_1 r) (_2 r) (map rx-strip-spans (_3 r))])
    ((Eq tag "juxt") ["juxt" (map rx-strip-spans (_1 r))])
    (else (error ["bad-normalized-rex" r]))))

(define (rx-norm src)
  (rx-strip-spans (rex:ParseRexNorm src)))

(define (rx-leaf s)
  ["leaf" "word" s])

(define (rx-cord s)
  ["leaf" "cord" s])

(define (rx-nest color rune kids)
  ["nest" color rune kids])

(define (rx-juxt kids)
  ["juxt" kids])

(define (assert-norm expect src)
  (define got (rx-norm src))
  (If (Equal expect got)
      0
      (error ["rex-normalize" src "want" expect "got" got])))

(define (assert-print expect src)
  (define got (rex:PrintRex (rex:ParseRexNorm src)))
  (If (Equal expect got)
      0
      (error ["rex-print-normalized" src "want" expect "got" got])))


;;; Final three-case normalization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert-norm
  (rx-leaf "foo")
  "foo")

(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-leaf "x")])
  "(f x)")

(assert-norm
  (rx-nest "brack" "" [(rx-leaf "a") (rx-leaf "b")])
  "[a b]")

(assert-norm
  (rx-nest "curly" "" [])
  "{}")

(assert-print "(f x)" "(f x)")
(assert-print "[a b]" "[a b]")
(assert-print "{}" "{}")

(assert-norm
  (rx-nest "paren" "+" [(rx-leaf "a") (rx-leaf "b")])
  "(+ a b)")

(assert-norm
  (rx-nest "brack" "+" [(rx-leaf "a") (rx-leaf "b")])
  "[+ a b]")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "3") (rx-leaf "4")])
  "+ 3
  4")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "a")])
  "+a")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "a") (rx-leaf "b") (rx-leaf "c")])
  "a+b+c")

(assert-norm
  (rx-nest "clear" "." [(rx-leaf "a") (rx-leaf "b")])
  "a.b")

(assert-norm
  (rx-juxt [(rx-leaf "foo")
            (rx-nest "paren" "+" [(rx-leaf "3") (rx-leaf "4")])])
  "foo(+ 3 4)")

(assert-norm
  (rx-juxt [(rx-leaf "b") (rx-cord "hello")])
  (strcat ["b" 34 "hello" 34]))

;; A multi-line body is ONE vertical group kid (the empty-rune clear
;; nest) — statements never splice beside the head.  A single body
;; line stays unwrapped (see `+ 3 / 4` above).
(assert-norm
  (rx-nest "clear" "="
    [(rx-nest "clear" "" [(rx-leaf "f") (rx-leaf "x")])
     (rx-nest "clear" "" [(rx-leaf "a") (rx-leaf "b")])])
  "f x =
  a
  b")

(assert-norm
  (rx-nest "clear" "~"
    [(rx-leaf "a")
     (rx-leaf "b")
     (rx-leaf "c")
     (rx-nest "clear" ""
       [(rx-nest "clear" "+" [(rx-leaf "foo") (rx-leaf "bar")])
        (rx-nest "clear" "+" [(rx-leaf "zaz")])])])
  "~ a b c + foo bar
        + zaz")

(assert-norm
  (rx-nest "curly" ","
    [(rx-nest "clear" ":" [(rx-leaf "x") (rx-leaf "3")])
     (rx-nest "clear" ":" [(rx-leaf "y") (rx-leaf "4")])])
  "{x:3, y:4}")

;;; Quip leaves: the lexer passes aura spellings through as raw slices
;;; (tick included) — sigil dispatch belongs to quip.rvr, not rex.

(define (rx-quip s)
  ["leaf" "quip" s])

(assert-norm (rx-quip "'foo") "'foo")
(assert-norm (rx-quip "'$hello") "'$hello")
(assert-norm (rx-quip "'$!aGk") "'$!aGk")
(assert-norm (rx-quip "'0.y") "'0.y")
(assert-norm (rx-quip "'0s-5") "'0s-5")
(assert-norm (rx-quip "'0x1f") "'0x1f")
(assert-norm (rx-quip "'@h1.m30") "'@h1.m30")
(assert-norm (rx-quip "'0fd1.5e-3") "'0fd1.5e-3")
(assert-norm (rx-quip "'@@2026.7.27..12.0.0") "'@@2026.7.27..12.0.0")
(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-quip "'@ms250")])
  "(f '@ms250)")
(assert-norm (rx-quip "'/foo/bar") "'/foo/bar")
(assert-norm (rx-quip "'/a/3/$b") "'/a/3/$b")
(assert-norm (rx-quip "'/") "'/")
(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-quip "'/foo/bar")])
  "(f '/foo/bar)")

(print "rex normalization tests passed")

;;; Parse modes ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; "reaver" is the default column discipline; "haskell" reproduces the
;; reference implementation's poem rules (Tree2.hs / Rex.hs).  Each
;; case states both shapes so the divergence is on record.

(define (rx-norm-in mode src)
  (rx-strip-spans (rex:ParseRexNormWith mode src)))

(define (assert-modes reaver haskell src)
  (define got-r (rx-norm-in "reaver" src))
  (define got-h (rx-norm-in "haskell" src))
  (If (Equal reaver got-r) 0
      (error ["rex-mode-reaver" src "want" reaver "got" got-r]))
  (If (Equal haskell got-h) 0
      (error ["rex-mode-haskell" src "want" haskell "got" got-h])))

;; The default entry points are the reaver mode.
assert(Equal (rx-norm-in "reaver" "+ a\n  b") (rx-norm "+ a\n  b"))

;; Peer or child is decided at a rune's START column here, at its LAST
;; character in the reference: a wider rune at the same start column
;; is a peer here and a child there.
(assert-modes
  (rx-nest "clear" ""
    [(rx-nest "clear" "+" [(rx-leaf "foo")])
     (rx-nest "clear" "?>" [(rx-leaf "x")])])
  (rx-nest "clear" "+"
    [(rx-leaf "foo")
     (rx-nest "clear" "?>" [(rx-leaf "x")])])
  "+ foo
?> x")

;; The heir-rune exception: a free rune starting left of the anchor
;; but ending on it stays in the poem in the reference (an heir of
;; `|`), while here it pops out to the enclosing `+` and peers it.
(assert-modes
  (rx-nest "clear" ""
    [(rx-nest "clear" "+"
       [(rx-leaf "a") (rx-nest "clear" "|" [(rx-leaf "foo")])])
     (rx-nest "clear" "?>" [(rx-leaf "x")])])
  (rx-nest "clear" "+"
    [(rx-leaf "a")
     (rx-nest "clear" ""
       [(rx-nest "clear" "|" [(rx-leaf "foo")])
        (rx-nest "clear" "?>" [(rx-leaf "x")])])])
  "+ a
 | foo
?> x")

;; Body lines deeper than the first operand are one sub-block here;
;; the reference converts children flat.
(assert-modes
  (rx-nest "clear" "="
    [(rx-leaf "x")
     (rx-nest "clear" "" [(rx-leaf "1") (rx-leaf "2")])])
  (rx-nest "clear" "="
    [(rx-leaf "x") (rx-leaf "1") (rx-leaf "2")])
  "= x
    1
    2")

;; Several nodes on one body line are a juxt here, flat children there.
(assert-modes
  (rx-nest "clear" "="
    [(rx-leaf "a") (rx-juxt [(rx-leaf "b") (rx-leaf "c")])])
  (rx-nest "clear" "="
    [(rx-leaf "a") (rx-leaf "b") (rx-leaf "c")])
  "= a
  b c")

;; A line at the rune's own column is a peer in both.
(assert-modes
  (rx-nest "clear" ""
    [(rx-nest "clear" "?" [(rx-leaf "c")])
     (rx-nest "clear" "." [(rx-leaf "f")])])
  (rx-nest "clear" ""
    [(rx-nest "clear" "?" [(rx-leaf "c")])
     (rx-nest "clear" "." [(rx-leaf "f")])])
  "? c
.f")

;; An unknown mode is a located error, not silent reaver behaviour.
(define (rx-bad-mode ignored)
  (define r (Try (lambda (z) (rex:ParseRexWith "haskel" "+ a")) 0))
  assert(Eq 1 (Hd r))
  1)
(rx-bad-mode 0)

(print "rex parse mode tests passed")

;;; Reference document boundaries and decoded multiline literals.
(define (rx-document-check ignored)
  (define blocks (rex:ParseRexBlocks "grade =
  @type

due =
  @slot"))
  assert(Equal 2 (Sz blocks))
  assert(Equal "bloc" (Hd (_0 blocks)))
  assert(Equal "bloc" (Hd (_1 blocks)))
  assert(Equal [4 0 17 13] (_0 (_1 blocks)))
  assert(Equal [] (rex:ParseRexBlocks ""))
  assert(Equal [] (rex:ParseRexBlocks "  "))
  1)
(rx-document-check 0)
(define (rx-literal shape text src)
  (define got (rex:ParseRex src))
  assert(Equal "leaf" (Hd got))
  assert(Equal shape (_1 got))
  assert(Equal text (_2 got))
  1)
(rx-literal "quip"
  (strcat ["'foo{" 10 "  bar" 10 "}"])
  (strcat ["'foo{" 10 "  bar" 10 "}"]))
(rx-literal "slug" (strcat ["first" 10 "second"])
  (strcat ["  ' first" 10 "  ' second"]))
(rx-literal "cord" (strcat ["first" 10 "second"])
  (strcat [34 "first" 10 " second" 34]))
(rx-literal "tape" (strcat ["first" 10 "second"])
  (strcat [34 10 "  first" 10 "  second" 10 "  " 34]))
(rx-literal "page" (strcat ["first" 10 "second"])
  (strcat ["'''" 10 "  first" 10 "  second" 10 "  '''"]))
(rx-literal "span" (strcat ["first" 10 "second"])
  (strcat ["'''first" 10 "   second'''"]))
(rx-literal "cord" (strcat [92 "n"])
  (strcat [34 92 "n" 34]))
