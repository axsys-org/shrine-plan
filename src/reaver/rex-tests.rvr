(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind rex (#module rex))


;;; Helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (rx-strip-spans r)
  (define tag (Hd r))
  (cond
    ((Eq tag "leaf") ["leaf" (_1 r) (_2 r)])
    ((Eq tag "nest") ["nest" (_1 r) (_2 r) (map rx-strip-spans (_3 r))])
    ((Eq tag "juxt") ["juxt" (map rx-strip-spans (_1 r))])
    (else (error ["bad-normalized-rex" r]))))

(define (rx-norm src)
  (rx-strip-spans (rex:ParseRexNorm src)))

(define (rx-leaf s)
  ["leaf" "word" s])

(define (rx-cord s)
  ["leaf" "cord" s])

(define (rx-nest color rune kids)
  ["nest" color rune kids])

(define (rx-juxt kids)
  ["juxt" kids])

(define (assert-norm expect src)
  (define got (rx-norm src))
  (If (Equal expect got)
      0
      (error ["rex-normalize" src "want" expect "got" got])))

(define (assert-print expect src)
  (define got (rex:PrintRex (rex:ParseRexNorm src)))
  (If (Equal expect got)
      0
      (error ["rex-print-normalized" src "want" expect "got" got])))


;;; Final three-case normalization ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert-norm
  (rx-leaf "foo")
  "foo")

(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-leaf "x")])
  "(f x)")

(assert-norm
  (rx-nest "brack" "" [(rx-leaf "a") (rx-leaf "b")])
  "[a b]")

(assert-norm
  (rx-nest "curly" "" [])
  "{}")

(assert-print "(f x)" "(f x)")
(assert-print "[a b]" "[a b]")
(assert-print "{}" "{}")

(assert-norm
  (rx-nest "paren" "+" [(rx-leaf "a") (rx-leaf "b")])
  "(+ a b)")

(assert-norm
  (rx-nest "brack" "+" [(rx-leaf "a") (rx-leaf "b")])
  "[+ a b]")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "3") (rx-leaf "4")])
  "+ 3
  4")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "a")])
  "+a")

(assert-norm
  (rx-nest "clear" "+" [(rx-leaf "a") (rx-leaf "b") (rx-leaf "c")])
  "a+b+c")

(assert-norm
  (rx-nest "clear" "." [(rx-leaf "a") (rx-leaf "b")])
  "a.b")

(assert-norm
  (rx-juxt [(rx-leaf "foo")
            (rx-nest "paren" "+" [(rx-leaf "3") (rx-leaf "4")])])
  "foo(+ 3 4)")

(assert-norm
  (rx-juxt [(rx-leaf "b") (rx-cord "hello")])
  (strcat ["b" 34 "hello" 34]))

(assert-norm
  (rx-nest "clear" "="
    [(rx-nest "clear" "" [(rx-leaf "f") (rx-leaf "x")])
     (rx-leaf "a")
     (rx-leaf "b")])
  "f x =
  a
  b")

(assert-norm
  (rx-nest "clear" "~"
    [(rx-leaf "a")
     (rx-leaf "b")
     (rx-leaf "c")
     (rx-juxt
       [(rx-nest "clear" "+" [(rx-leaf "foo") (rx-leaf "bar")])
        (rx-nest "clear" "+" [(rx-leaf "zaz")])])])
  "~ a b c + foo bar
        + zaz")

(assert-norm
  (rx-nest "curly" ","
    [(rx-nest "clear" ":" [(rx-leaf "x") (rx-leaf "3")])
     (rx-nest "clear" ":" [(rx-leaf "y") (rx-leaf "4")])])
  "{x:3, y:4}")

;;; Quip leaves: the lexer passes aura spellings through as raw slices
;;; (tick included) — sigil dispatch belongs to quip.rvr, not rex.

(define (rx-quip s)
  ["leaf" "quip" s])

(assert-norm (rx-quip "'foo") "'foo")
(assert-norm (rx-quip "'$hello") "'$hello")
(assert-norm (rx-quip "'$!aGk") "'$!aGk")
(assert-norm (rx-quip "'0.y") "'0.y")
(assert-norm (rx-quip "'0s-5") "'0s-5")
(assert-norm (rx-quip "'0x1f") "'0x1f")
(assert-norm (rx-quip "'@h1.m30") "'@h1.m30")
(assert-norm (rx-quip "'0fd1.5e-3") "'0fd1.5e-3")
(assert-norm (rx-quip "'@@2026.7.27..12.0.0") "'@@2026.7.27..12.0.0")
(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-quip "'@ms250")])
  "(f '@ms250)")
(assert-norm (rx-quip "'/foo/bar") "'/foo/bar")
(assert-norm (rx-quip "'/a/3/$b") "'/a/3/$b")
(assert-norm (rx-quip "'/") "'/")
(assert-norm
  (rx-nest "paren" "" [(rx-leaf "f") (rx-quip "'/foo/bar")])
  "(f '/foo/bar)")

(print "rex normalization tests passed")
