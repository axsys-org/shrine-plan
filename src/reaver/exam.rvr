(#bind std (#module std))
(#import std)
::*newtype
::*reef

(define (exam-gensym uniq offset)
  (strWeld "#exam-gensym/" (Add uniq offset)))

(define dummy ("/test/tuple" 1 2 3))

(define (exam-err msg ctx)
  error((strWeld "expect: " msg) ctx))

(#macro need
  (macwrap
    (#fun nopin noinline "need" (need form)
      (Seq (print form)
        [(1 unless) (_2 form)
                    [(1 error) (1 (strWeld "need-fail: " (_0 (_1 form))))]
                    (1 1)]))))

(define (get-global name glo)
  (define pin (wisp:glookup name glo))
  (unless (IsPin pin) 0
    (_1 (Unpin pin))))

(define (got-global name glo)
  (define get (get-global name glo))
  (need "global to exist" (Nil (Equal 0 get)))
  get)



(define match-any (0 0))
(define (match-lit x) (1 x))
(define (match-bind nm) (2 nm))
(define match-app 3)

(define PFIX "/test/")

(define (expect-parse-app parse input[hd])
  (need "hd is nat" (IsNat hd))
  (define len (Dec (Sz input)))
  (Coup 3 (Weld (match-app hd)
    (map parse (drop 1 input)))))

(define (expect-parse input)
  (cond
    ((And (IsNat input) (Eq "_" input)) match-any)
    ;; XX: lookup and assert equality is nat
    ((Eq (Hd input) 1) input)
    ((And (IsApp input) (Eq (Hd input) 0)) (expect-parse-app expect-parse input))
    (else error("uimpl" input))))


;;

(define (expect-app exp binds have want[brand])
  (print ("expect-app" have want))
  (define len (Sz have))
  (need "brand to match" (Equal (strWeld PFIX brand) (Hd have)))
  (need "size to match" (Eq (Dec (Sz want)) len))
  (define (go i bins)
    (define next[bs ok] (exp bins (Ix i have) (Ix (Inc i) want)))
    (print ("i" i bs ok))
    (If (Eq i len) [bins 1]
      (Ifz ok [bs 0]
        (go (Inc i) bs))))
  (define res (go 0 binds))
  res)

(define (trace-equal have want)
  (print ("trace-have" have))
  (print ("trace-want" want))
  (Equal have want))

(define (expect-match binds have want[wan])
  (print ("match" have want))
  (Case4 (Hd want)
    [binds 1]
    [binds (trace-equal have wan)]
    [binds 1] ; [#bind wan have]
    (expect-app expect-match binds have want)))

(define (expect-run ctx uniq glo loc depth form[_ have want])
  (print "a")
  (define hav (get-global have glo))
  (define wan (expect-parse want))
  (define res[binds success_p] (expect-match 0 hav wan))
  [uniq glo (Weld binds (If success_p 0 error("failed" ctx)))])

(define three 3)

(#macro expect
  (#fun pin noinline "expect" (expect ctx uniq glo loc depth form)
    (expect-run ctx uniq glo loc depth form)))

(expect dummy (tuple 1 _ 3))
(expect three 3)
(expect three _)
; (expect three @tri)
