(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(define (check z)
  ;;;; Copyright (c) 2026 Axiomatic Systems
  ;;;; SPDX-License-Identifier: MIT
  ;;;; See LICENSE for full terms.





  ;;; Checked-in Foil BST fixture ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  (define typed-bst (driver:perc-subject (_1 (source:compile 0 "bst"))))

  (define (bst-tc path)
    (got-entry-tc (canon-path path typed-bst) typed-bst))

  ;; Names and generated entry kinds are compiler contracts. Declaration
  ;; counts, source positions and identical match-body shapes are not.
  assert(Equal "TC_TYP" (Hd (bst-tc ["bst" "empty"])))
  assert(Equal "TC_TYP" (Hd (bst-tc ["bst" "node"])))
  assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "sz"])))
  assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "key"])))
  assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "val"])))
  assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "l"])))
  assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "r"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "size"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "insert"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "get"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "got"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "has"])))
  assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "map"])))

  (print "foil-bst tests passed")

  1)
assert(Equal 1 (check 0))
