(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil (#module foil))
(#bind foil-subject (#module foil-subject))
(#import foil-subject)


;;; Checked-in Foil BST fixture ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define bst-module
  (foil:parse-foil "bst"))

(define typed-bst
  (foil:elab-mod foil:default-subject bst-module))

(define (decl-name decl) (_1 decl))
(define (bst-tc path) (got-entry-tc (Weld ["boot"] path) typed-bst))
(define (bst-body path) (tc-lam-body (bst-tc path)))

(define size-body (bst-body ["bst" "size"]))
(define insert-body (bst-body ["bst" "insert"]))
(define get-body (bst-body ["bst" "get"]))
(define got-body (bst-body ["bst" "got"]))
(define has-body (bst-body ["bst" "has"]))
(define map-body (bst-body ["bst" "map"]))

assert(Equal 21 (Sz bst-module))
assert(Equal ["bst_maybe"] (decl-name (_0 bst-module)))
assert(Equal ["bst"] (decl-name (_1 bst-module)))
assert(Equal ["bst" "empty"] (decl-name (_2 bst-module)))
assert(Equal ["bst" "node"] (decl-name (_3 bst-module)))
assert(Equal ["bst" "size"] (decl-name (_4 bst-module)))
assert(Equal ["bst" "n"] (decl-name (_5 bst-module)))
assert(Equal ["bst" "insert"] (decl-name (Ix 14 bst-module)))
assert(Equal ["bst" "get"] (decl-name (Ix 16 bst-module)))
assert(Equal ["bst" "got"] (decl-name (Ix 17 bst-module)))
assert(Equal ["bst" "has"] (decl-name (Ix 18 bst-module)))
assert(Equal ["bst" "map"] (decl-name (Ix 19 bst-module)))

assert(Equal "TC_TYP" (Hd (bst-tc ["bst" "empty"])))
assert(Equal "TC_TYP" (Hd (bst-tc ["bst" "node"])))
assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "sz"])))
assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "key"])))
assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "val"])))
assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "l"])))
assert(Equal "TC_FFI" (Hd (bst-tc ["bst" "node" "r"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "size"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "insert"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "get"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "got"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "has"])))
assert(Equal "TC_LAM" (Hd (bst-tc ["bst" "map"])))

assert(Equal "TC_MATCH" (Hd size-body))
assert(Equal 2 (Sz (tc-match-arms size-body)))
assert(Equal "TC_MATCH" (Hd insert-body))
assert(Equal 2 (Sz (tc-match-arms insert-body)))
assert(Equal "TC_MATCH" (Hd get-body))
assert(Equal 2 (Sz (tc-match-arms get-body)))
assert(Equal "TC_MATCH" (Hd got-body))
assert(Equal 2 (Sz (tc-match-arms got-body)))
assert(Equal "TC_MATCH" (Hd has-body))
assert(Equal 2 (Sz (tc-match-arms has-body)))
assert(Equal "TC_MATCH" (Hd map-body))
assert(Equal 2 (Sz (tc-match-arms map-body)))

(print "foil-bst tests passed")
