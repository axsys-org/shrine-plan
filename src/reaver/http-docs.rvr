;;;; http-demo.rvr
;;;; A minimal HTTP/1.1 server.
;;;; Listens on port 8080, spawns a handler actor per connection.

(#bind std (#module std))
(#import std)
(#bind milton (#module milton))
(#import milton)
(#bind print (#module print))
(#import print)
(#bind cairn (#module cairn))
(#import cairn)

;;; Actor / network primitives ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rplan ("Spawn"       fn))
(rplan ("Send"        handle msg))
(rplan ("SendCaps"    handle msg caps))
(rplan ("Recv"        z))
(rplan ("CloseHandle" handle))
(rplan ("Listen"      port))
(rplan ("Accept"      fd))
(rplan ("Read"        fd n))
(rplan ("Write"       fd dat))
(rplan ("CloseFd"     fd))
(rplan ("ReadFile"    filename))


(define (strWeld a b)
  (Add (Lsh b (Mul 8 (Bytes a))) a))

(define spine-editor (ReadFile "web/code-editor.js"))
(define feather-css (ReadFile "web/feather.css"))

;;; String helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (tid str)
  (define a[name rest] (split-byte "#" str))
  (define attrs[id] (split-byte "." rest))
  [name
    [
     ["id" id]
     ["class" (join-str " " (drop 1 attrs))]]])
(define (tcl str)
  (define a[name rest] (split-byte "." str))
  [name
    [["class" (join-str " " (drop 1 a))]]])

;;; HTTP response ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define cr 13)
(define lf 10)
(define crlf (strWeld cr lf))

; (define html-body
  ; "<html><body><h1>Hello from Reaver!</h1></body></html>")


(define (print-sut-path pax) (join-str ":" pax))

(define (print-val val)
  (define (print-pin p)
    (If (IsLaw p)
      (strcat ["#(" (Name p) ")"])
      (strcat ["<" (print-val p) ">"])))
  (define (print-law a m b) (strcat ["{" (print-nat a) " " (print-nat m) " "
    (print-val b) "}"]))
  (define (print-app a)
    (strcat (Weld ["(" (print-val (Hd a)) " "] [(join-str " " (map print-val a)) ")"])))
  (cond
    ((IsPin val) (print-pin (Unpin val)))
    ((IsLaw val) (print-law (Arity val) (Name val) (Body val)))
    ((IsApp val) (print-app val))
    (else (print-nat val))))


(define (sut-entry-to-html ent)
  (tid
    "details"
    [
      (tid "summary" [(print-sut-path (bind-key ent))])
      (tid "pre"
        [(print-val ent)])
      ]))

(define env-pane
  (define foil (compile-foil "demo"))
  (print foil)
  (rowify (lmap (lambda (a[k v]) (sut-entry-to-html v)) (tapax (_0 foil)))))

(define (mi-style style)
  ["style" 0 [style]])
(define (mi-inl-esm js)
  ["script" [["type" "module"]]
    [js]])
(define (wrap-html-body body)
  ["html" 0
    [["head" 0
      [(mi-style feather-css)
       (mi-inl-esm spine-editor)
       ]]
    ["body" 0 body]]])



(define (with-sidebar side content)
  (tid "div#wall.fr.grow.scroll-none.wf.hf"
  [(tid "aside#sidebar.b1.tab.fc.grow.scroll-none" side)
    content]))



(define (pane sel ch)
  (tid (strWeld sel "") ch))
(define content
  (tid "main#lurgo-main.grow.basis-half.fc.hf.wf.scroll-none"
    [
     (pane "section#env" env-pane)
     (pane "section#editor" ["editor"])
     (pane "section#shell" ["shell"])
   ]))


(define sidebar
  (define file-list (ReadFolder "foil"))
  (define (file-list-item item)
    ["li" 0 [item]])
  [["ul" 0
    (map file-list-item file-list)
   ]])
(define default-response
  (wrap-html-body [(with-sidebar sidebar content)]))
(define (response x)
  (print default-response)
  (lstrcat
    ~[ "HTTP/1.0 200 OK" crlf
       "Content-Type: text/html" crlf crlf
       (milton-print default-response)]))


;;; Connection handler ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Receives a single message containing the connection fd,
;;; reads the request, writes the response, closes, exits.


; (define )

(define (handle-connection conn)
  (print ("handler: reading" conn))
  (define input (Read conn 4096))
  (print ("handler: read" input))
  (define res (parse-http-request input))
  (print ("handler: request" res))
  (Write conn (response 0))
  (print ("handler: wrote response"))
  (CloseFd conn)
  (print "handler: closed connection")
  (print "handler: exiting")
  "test")


; (define (race a b)
;   (define (coll-handler self)
;     (define next[msg caps] (Recv 0))
;     (Send (_0 caps) msg))
;     (define run (Spawn coll-handler)))



;;; Listener loop ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Loops forever: accept a connection, spawn a handler, send it the fd.

(define (listener-loop listen state)
  (print ("listener: accept" listen))
  (define conn-fd (Accept listen))
  (print ("listener: conn-fd" conn-fd))
  (define handler (handle-connection conn-fd))
  ; (define handler (Spawn (handle-connection conn-fd)))
  (print ("listener: handler" handler))
  (print ("listener: request count" state))
  ; (CloseHandle handler)
  (print "listener: closed")
  (listener-loop listen (Inc state)))

(define empty-state 0)

(define (run-http port)
  (print ("run-http" port))
  (define listen (Listen port))
  (print ("run-http" listen))
  (listener-loop listen empty-state))


;;; Main ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (serve x) (Spawn (run-http 8080)))
