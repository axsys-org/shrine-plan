;;;; A trusted launcher prepares an isolated candidate in the supervisor.
;;;; Nothing is installed until all core and mount compilations, type checks,
;;;; publication and namespace validation have succeeded.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind eden (#module eden))
(#bind driver (#module foil-new-env))
(#bind abi (#module foil-abi))
(#bind render (#module foil-render))
(#bind compatibility (#module foil-reload))

(define (replace system images server self resolve slot port specs scan-port scan-token)
  (define old (eden:module images "stdlib/runtime"))
  (define (old-tool path) (driver:get-perc path old))
  (define (prepare checkpoint)
    (define state (Ix 2 checkpoint))
    (define roster (Ix 3 checkpoint))
    (define (build ignored)
      (define built (eden:prepare self system resolve slot port specs scan-port scan-token "" [[state images]]))
      (define current (_0 built))
      (define core (compatibility:require-interface old
        (eden:module (_3 built) "stdlib/runtime")
        [["helm" "supervisor" "continue"]
         ["helm" "supervisor" "endpoint_continue"]
         ["fs_foot" "continue"] ["fs_read" "remote"]
         ["http_foot" "continue"] ["http_foot" "inspect_renderer"]
         ["http_foot" "fanout_continue"]]))
      (define (tool path) (driver:get-perc path core))
      (define access (_1 built))
      (define config (_2 built))
      (define keep (_1 checkpoint))
      (define continue (tool ["helm" "supervisor" "continue"]))
      (define endpoint (tool ["helm" "supervisor" "endpoint_continue"]))
      (define fs (tool ["fs_foot" "continue"]))
      (define read-files ((tool ["fs_read" "remote"]) scan-port scan-token))
      (define http (tool ["http_foot" "continue"]))
      (define renderer (tool ["http_foot" "inspect_renderer"]))
      (define fanout (tool ["http_foot" "fanout_continue"]))
      (define empty (old-tool ["axal" "new"]))
      (define none (abi:option old "none"))
      (define foot-reload (abi:constructor old ["feet" "task" "reload"]))
      (define endpoint-reload (abi:constructor old ["helm" "supervisor" "endpoint_reload"]))
      (define render-reload (abi:constructor old ["http_foot" "render_reload"]))
      (define stream-reload (abi:constructor old ["http_foot" "stream_msg" "reload"]))
      ;; Evaluate changed bindings before committing. New readers may fail;
      ;; no foot may observe a candidate until every read has succeeded.
      (define page (_0 access))
      (define y (abi:constructor old ["care" "y"]))
      (define fact (abi:constructor old ["feet" "task" "fact"]))
      (define members (map (lambda (member)
        (define answer (page y none (_0 member) current))
        (define binding (If (Equal (Hd answer) (abi:constructor old ["res" "known"]))
          (_0 answer) (empty none)))
        ((Hd member) (_0 member) (_1 member) binding (_3 member))) roster))
      (define changed (filter (lambda (member)
        (Nil (Equal (_2 member) (_2 (need (find (lambda (old-member)
          (Equal (_0 member) (_0 old-member))) roster)))))) members))
      (define (resume-fs saved)
        (fs read-files (_1 saved) (_2 saved) (_3 saved)))
      (define (resume-http saved)
        (Seq (Send (_2 saved) (render-reload (lambda (actor) (renderer (_1 config) actor))))
          (Seq (Send (_3 saved) (stream-reload (lambda (held) (fanout (_0 held) (_1 held)))))
            (http config (_1 saved) (_2 saved) (_3 saved) (_4 saved)
              (Ix 5 saved) (Ix 6 saved) (empty none) (Ix 8 saved)))))
      (define (resume-endpoint saved)
        (endpoint (_0 saved) (_1 saved) (_2 saved) (_3 saved)))
      (define requests (map (lambda (member)
        (define path (_0 member))
        (define resume
          (cond
            ((Equal path [self ("ts" "io") ("ts" "fs")]) resume-fs)
            ((Equal path [self ("ts" "io") ("ts" "http")]) resume-http)
            (else (error ["reload-unsupported-foot" path]))))
        [(_1 member) (foot-reload resume) (_3 member) (endpoint-reload resume-endpoint)]) roster))
      (unless (And (Equal (_2 state) (_2 current)) (Equal (_0 state) (_0 current)))
        (error "reload-changed-authority"))
      (define valid ((tool ["namespace" "create"]) self (_1 current) (_2 current)))
      (unless (Equal "ok" (Hd valid)) (error ["reload-invalid-state" (_0 valid)]))
      (define facts (map (lambda (member) [(_1 member) (fact (_2 member))]) changed))
      (DeepSeq [current access config requests continue members facts read-files] 0)
      (define (commit ignored)
        (Seq (keep current)
          (Seq (DeepSeq (map (lambda (req)
            (Seq (Send (_2 req) (_3 req)) (Send (_0 req) (_1 req)))) requests) 0)
            (DeepSeq (map (lambda (req) (Send (_0 req) (_1 req))) facts) 0))))
      (define (resume ignored)
        (continue access keep current members (Ix 4 checkpoint)))
      ((abi:result old "ok") ((abi:constructor old ["helm" "supervisor" "prepared"]) commit resume (Pin (_3 built)))))
    (define result (Try (lambda (ignored) (force (build 0))) 0))
    (If (Eq 1 (Hd result))
      ((abi:result old "err") (render:diag-text (_0 result)))
      (_0 result)))
  (define card ((abi:constructor old ["helm" "supervisor" "reload"]) prepare))
  (define reply (Seq (SendCaps server card [0]) (Recv 0)))
  (Seq ((old-tool ["helm" "supervisor" "close_caps"]) (_1 reply))
    (let ((answer (_0 reply)))
      (If (Equal (Hd answer) (abi:constructor old ["helm" "supervisor" "reloaded"]))
        [1 (Unpin (_0 answer)) ""]
        [0 images (_2 answer)]))))
(#export replace)
