;;;; New builtin types work without the FFI substrate.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind core (#module foil-type-core))
(#bind nt (#module foil-new-types))
(#bind sut (#module foil-subject))
(#bind elab (#module foil-new-elab))
(#bind rex (#module rex))
(#bind sast (#module foil-sast))

(define (check z)
  (define world core:default-type-world)
  (define subject core:core-subject)
  (define paths [["nat"] ["uint"] ["bool"] ["unit"] ["pail"] ["any"]
    ["row"] ["list"] ["either"] ["maybe"] ["iota"] ["sym"] ["str"] ["type"] ["rex"] ["rex" "source_span"]])
  assert(Eq 16 (Sz (nt:type-world-entries world)))
  (DeepSeq (map (lambda (path)
    (define entry (_1 (nt:lookup-type-entry world path)))
    (define tc (sut:got-entry-tc path subject))
    assert(Equal "TC_TYP" (Hd tc))
    assert(Equal path (sut:canon-path path subject))
    assert(Equal (nt:type-entry-scheme entry) (sut:tc-typ-inner tc))
    (force (nt:check-scheme-wf world (sut:tc-typ-inner tc)))
    1) paths) 0)
  assert(Equal (nt:type-world-entries world)
    (nt:type-world-entries (elab:world-from-subject subject)))
  (define (view path) (_1 (nt:view world (nt:type-ref path))))
  assert(Equal (nt:tnat "ts") (view ["sym"]))
  assert(Equal (nt:tnat "tu") (view ["str"]))
  assert(Equal (nt:tnat 0) (view ["nat"]))
  assert(Equal ["nat" 0] (_1 (nt:runtime-key world (nt:type-ref ["nat"]))))
  assert(Equal ["/unit" 0] (_1 (nt:runtime-key world (nt:type-ref ["unit"]))))
  assert(Eq 14 (Sz (nt:sum-options (view ["iota"]))))
  (define (application path args)
    (define result (nt:intern-type-application world path (map nt:type-arg args)))
    [(_0 result) (nt:type-ref (_1 result))])
  (define list-nat (application ["list"] [core:nat-ref]))
  (define options (nt:sum-options (_1 (nt:view (_0 list-nat) (_1 list-nat)))))
  (define cons-row (need (find (lambda (row) (Eq "cons" (nt:row-cstr row))) options)))
  assert(Equal core:nat-ref (nt:row-item-value (_0 (nt:row-items cons-row))))
  assert(Equal (_1 list-nat) (nt:row-item-value (_1 (nt:row-items cons-row))))
  (define (brands app)
    (sort cmp-total (map nt:row-cstr (nt:sum-options (_1 (nt:view (_0 app) (_1 app)))))))
  assert(Equal (sort cmp-total ["err" "ok"])
    (brands (application ["either"] [core:nat-ref (nt:type-ref ["str"])])))
  assert(Equal (sort cmp-total ["/boot/maybe/some" "/boot/maybe/none"])
    (brands (application ["maybe"] [core:nat-ref])))
  assert(Equal (sort cmp-total ["any" "pail" "bot" "opq" "nat" "cst" "var"
      "arr" "pin" "fun" "sum" "rec" "nom" "gen"])
    (sort cmp-total (map nt:row-cstr (nt:sum-options (view ["type"])))))
  ;; Bare builtin names elaborate using only the new type subject. Local
  ;; nominal types survive replay alongside the shared builtin world.
  (define compiled (elab:elab-mod (elab:compiler-for subject)
    (sast:parse-module-sast 0 (rex:ParseRexNormFile "+ sample
  : text=str symbol=sym nums=list[nat] result=either[nat str] opt=maybe[nat]
+ descriptor
  \ value=sample
  ^ type
  (^ value)
"))))
  (define replay (elab:world-from-subject (elab:compiler-subject compiled)))
  assert(nt:type-bound? replay ["boot" "sample"])
  assert(Equal ["/boot/sample" 5]
    (_1 (nt:runtime-key replay (nt:type-ref ["boot" "sample"]))))
  1)
assert(Equal 1 (check 0))
(print "Shared builtin type core tests passed")
