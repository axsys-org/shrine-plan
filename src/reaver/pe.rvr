(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind cgen (#module codegen))

(define pin-arity cgen:pin-arity)
(define plan-arity cgen:plan-arity)

(define (compile-church-boolean v t f)
  (If (Equal v "true") t f))

;; 'arity' in the expression helpers is the largest in-scope reference,
;; including let slots. Numeric Eq must not classify a pin-headed PAP as code.
(define (law-var? arity body) (And (IsNat body) (Le body arity)))
(define (law-call? arity body)
  (And (Equal 0 (Hd body)) (Eq 2 (Sz body))))
(define (law-lit? arity body)
  (Nil (Or (law-call? arity body) (law-var? arity body))))
(define (law-quote v) (0 v))
(define (quote-const arity v)
  (If (Or (IsApp v) (law-var? arity v)) (law-quote v) v))
(define (is-const arity v) (law-lit? arity v))
(define (pull-const v)
  (If (And (Equal 0 (Hd v)) (Eq 1 (Sz v))) (_0 v) v))

;; Static-value discovery never executes an unknown saturated call. A row
;; wraps the result so that literal zero is distinct from 'not static'.
(define (get-const arity body)
  (cond
    ((law-var? arity body) 0)
    ((law-call? arity body)
      (let ((f (get-const arity (_0 body))) (x (get-const arity (_1 body))))
        (If (And f x)
          (If (Eq 1 (plan-arity (_0 f))) 0 [((_0 f) (_0 x))]) 0)))
    (else [(pull-const body)])))

(define (lift-call-inner arity f x)
  (If (law-call? arity f) ((lift-call-inner arity (_0 f) (_1 f)) x) [f x]))
(define (explode-app row[f])
  (If (And (IsApp f) (Nil (Equal 0 (Hd f))))
    (Weld (Weld [(Hd f)] (map 0 f)) (drop 1 row)) row))
(define (lift-call arity f x)
  (explode-app (lift-call-inner arity f x)))

(define (subst-body-var arity arg body)
  (cond
    ((law-var? arity body)
      (Ifz body 0
        (If (Eq 1 body) (quote-const (Dec arity) arg) (Dec body))))
    ((law-call? arity body)
      (0 (subst-body-var arity arg (_0 body))
         (subst-body-var arity arg (_1 body))))
    (else body)))
(define (subst-body-vars arity vars body)
  (Ifz vars body
    (subst-body-vars (Dec arity) (drop 1 vars)
      (subst-body-var arity (_0 vars) body))))

;; Only explicitly trusted pure, total callees may be executed at staging
;; time. Without this policy, constant folding can run effects or force an
;; unused failing branch. Unsaturated calls/data construction are always safe.
;; Trust applies to the head of a PAP as well as the bare function.
(define (foldable? allowed f)
  (any (lambda (v) (Equal v (If (IsApp f) (Hd f) f))) allowed))
(define (constant-fold-with allowed arity body)
  (Ifz (law-call? arity body) body
    (let ((f (constant-fold-with allowed arity (_0 body)))
          (x (constant-fold-with allowed arity (_1 body))))
      (define fv (get-const arity f))
      (define xv (get-const arity x))
      (If (And fv xv)
        (If (Or (Ne 1 (plan-arity (_0 fv))) (foldable? allowed (_0 fv)))
          (quote-const arity ((_0 fv) (_0 xv)))
          (0 f x))
        (0 f x)))))
(define (constant-fold arity body) (constant-fold-with [] arity body))

(define (split-lets body)
  (If (And (Equal 1 (Hd body)) (Eq 2 (Sz body)))
    (let ((rest (split-lets (_1 body))))
      [(cons (_0 body) (_0 rest)) (_1 rest)])
    [[] body]))

;; Keep original self: its recursive calls and escaping values still have
;; the original arity. Every let is in scope, including forward references.
(define (specialize-body self depth args body)
  (cond
    ((law-var? depth body)
      (Ifz body (law-quote self)
        (If (Le body (Sz args)) (law-quote (Ix (Dec body) args))
          (Sub body (Sz args)))))
    ((law-call? depth body)
      (0 (specialize-body self depth args (_0 body))
         (specialize-body self depth args (_1 body))))
    (else (law-quote (pull-const body)))))

;; Specialize a law/PAP's static prefix. This is conservative substitution
;; and constant folding, not recursive inlining or automatic loop unrolling.
;; The argument must still have at least one dynamic parameter left.
(define (partial-eval-with allowed app)
  (define self (If (IsApp app) (Hd app) app))
  (define law (If (IsPin self) (Unpin self) self))
  (define args (If (IsApp app) (map (lambda (x) x) app) []))
  (define parts (split-lets (Body law)))
  (define depth (Add (Arity law) (Sz (_0 parts))))
  (define (residual body)
    (constant-fold-with allowed (Sub depth (Sz args))
      (specialize-body self depth args body)))
  (If (And (IsLaw law) (Lt (Sz args) (Arity law)))
    (Law (Dec (Sub (Arity law) (Sz args))) (strWeld "eval-" (Name law))
      (foldr (lambda (body rest) (1 (residual body) rest))
        (residual (_1 parts)) (_0 parts)))
    (error ["partial-eval: expected an unsaturated law" app])))
(define (partial-eval app) (partial-eval-with [] app))
