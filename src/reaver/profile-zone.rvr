(#bind std (#module std))
(#import std)

;; The profiler primops are provisional op-83 effects.  Keep their raw
;; wrappers here so profiling code cannot accidentally persist an opaque
;; handle across Reaver evaluations (handles are local to a PLAN thread).
(#bind ProfileEffect (#pin 83))

(#bind zone-start
  (#fun pin noinline "zone-start" (zone-start label)
    (ProfileEffect ("ZoneStart" label))))

(#bind zone-end
  (#fun pin noinline "zone-end" (zone-end handle)
    (ProfileEffect ("ZoneEnd" handle))))

;; Force value completely while the zone is live.  The leading Seq is
;; important: without it, laziness can evaluate value before ZoneStart.
(define (force-zone label value)
  (define handle (zone-start label))
  (Seq handle
    (DeepSeq value
      (Seq (zone-end handle) value))))

;; Context-threaded compiler operations return [context value].  Forcing the
;; whole pair would also force the memo tables carried by context, turning the
;; profiler into a cache traversal benchmark.  Force only the operation result
;; while leaving the updated context lazy.
(define (force-pair-value-zone label pair)
  (define handle (zone-start label))
  (Seq handle
    (DeepSeq (_1 pair)
      (Seq (zone-end handle) pair))))
