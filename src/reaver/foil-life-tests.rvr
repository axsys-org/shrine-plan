(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))
(#bind stage (#module foil-stage))


;;; apps/life/main.foil: Conway's Life as a mounted shrine app.  The
;;; pure core is asserted directly; the app is then mounted through
;;; the real pact expansion (one make, whole subtree in one epoch)
;;; and driven with tick pokes through the cycle, so the census kid's
;;; crew watch is exercised by real facts.  Runtime shapes as in
;;; foil-lain-tests: outcomes ("/boot/ovum/ripe" sov ..), gyres
;;; ("/boot/gyre/spun" sov ..), res ("/boot/res/known" myth) /
;;; "/boot/res/null" / "/boot/res/unknown".

(define sut (stage:sut-of "apps/life/main"))
(define (app path) (foil:source-entry-val path sut))

;;; 1. the pure core ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define pow2 (app ["pow2"]))
(define step (app ["step"]))
(define pop-of (app ["pop_of"]))
(define show-cells (app ["show_cells"]))
(define glider (app ["glider"]))
(define blinker (app ["blinker"]))

assert(Eq 64 (pow2 6))
assert(Eq 459778 glider)
assert(Eq 131586 blinker)
assert(Eq 5 (pop-of glider))
assert(Eq 3 (pop-of blinker))
;; the blinker oscillates with period two
assert(Eq 1792 (step blinker))
assert(Eq blinker (step (step blinker)))
;; the glider's next phase, and the one-cell southeast shift at four
assert(Eq 33948928 (step glider))
assert(Eq 235406336 (step (step (step (step glider)))))
;; the rendered board: rows joined with newlines, # live, . dead
(define nl 10)
(define g0-view
  (strcat [".#......" nl "..#....." nl "###....." nl "........" nl
           "........" nl "........" nl "........" nl "........"]))
assert(Equal g0-view (show-cells glider))

;;; 2. the mount: one make expands the whole app subtree ;;;;;;;;;;;;;;;;;;;;;;;;;;

(define run-event (app ["run_event"]))
(define vine-make (app ["vine_make"]))
(define vine-poke (app ["vine_poke"]))
(define slot-nat (app ["slot_nat"]))
(define txt-slot (app ["myth" "txt_at"]))
(define has-slot (app ["myth" "has_at"]))
(define x-latest (app ["sov" "x_latest"]))
(define cycle (app ["cycle"]))
(define tick-t (app ["tick_t"]))
(define msing (app ["myth" "sing"]))
(define pd (app ["pd"]))
(define (t-data slot n) (msing slot (pd n)))

(define life-mani (app ["app"]))
(define card ((app ["pact" "card"]) life-mani "apps/life/main" 0 0))
(define sov0 (app ["seeded_kern"]))

(define tapp ("ts" "app"))
(define tlife ("ts" "life"))
(define board [tapp tlife ("ts" "board")])
(define census [tapp tlife ("ts" "board") ("ts" "census")])
(define gslot [("ts" "gen")])
(define pslot [("ts" "pop")])
(define cslot [("ts" "cells")])
(define vslot [("ts" "view")])
(define xslot [("ts" "peak")])
(define fslot [("ts" "form")])

(define m1 (run-event (vine-make [tapp tlife] card) 0 sov0))
assert(Eq "/boot/ovum/ripe" (Hd m1))
(define s1 (_0 m1))
;; the board seeded and rendered in the mount epoch
assert(Eq 0 (slot-nat board gslot 99 s1))
assert(Eq 459778 (slot-nat board cslot 99 s1))
assert(Eq 5 (slot-nat board pslot 99 s1))
(define bm1 (x-latest board s1))
assert(Eq "/boot/res/known" (Hd bm1))
assert(Equal g0-view (txt-slot vslot (_0 bm1)))
;; the app's behaviors live inside its own subtree
(define kf (x-latest [tapp tlife ("ts" "kook") ("ts" "life")] s1))
assert(Eq "/boot/res/known" (Hd kf))
assert(Eq 1 (has-slot fslot (_0 kf)))
;; the census kid exists, made by the board's init in the same epoch
(define cm1 (x-latest census s1))
assert(Eq "/boot/res/known" (Hd cm1))

;;; 3. a tick: one generation, and the census hears the fact ;;;;;;;;;;;;;;;;;;;;;;

(define g1 (cycle (vine-poke board (tick-t 1)) 0 8 s1))
assert(Eq "/boot/gyre/spun" (Hd g1))
(define s2 (_0 g1))
assert(Eq 1 (slot-nat board gslot 99 s2))
assert(Eq 33948928 (slot-nat board cslot 99 s2))
assert(Eq 5 (slot-nat board pslot 99 s2))
;; the census heard the committed generation
assert(Eq 5 (slot-nat census pslot 99 s2))
assert(Eq 1 (slot-nat census gslot 99 s2))
assert(Eq 5 (slot-nat census xslot 99 s2))

;;; 4. three more ticks: the glider translates one cell southeast ;;;;;;;;;;;;;;;;;

(define g2 (cycle (vine-poke board (tick-t 1)) 0 8 s2))
(define g3 (cycle (vine-poke board (tick-t 1)) 0 8 (_0 g2)))
(define g4 (cycle (vine-poke board (tick-t 1)) 0 8 (_0 g3)))
(define s5 (_0 g4))
assert(Eq 4 (slot-nat board gslot 99 s5))
assert(Eq 235406336 (slot-nat board cslot 99 s5))
assert(Eq 5 (slot-nat census pslot 99 s5))
assert(Eq 4 (slot-nat census gslot 99 s5))

;;; 5. loading a pattern: poke fresh cells, then tick ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define p1 (cycle (vine-poke board (t-data cslot blinker)) 0 8 s5))
assert(Eq "/boot/gyre/spun" (Hd p1))
(define s6 (_0 p1))
assert(Eq 131586 (slot-nat board cslot 99 s6))
assert(Eq 3 (slot-nat board pslot 99 s6))
;; a load does not advance the generation
assert(Eq 4 (slot-nat board gslot 99 s6))
;; the census peak remembers the glider
assert(Eq 5 (slot-nat census xslot 99 s6))
(define p2 (cycle (vine-poke board (tick-t 1)) 0 8 s6))
(define s7 (_0 p2))
assert(Eq 1792 (slot-nat board cslot 99 s7))
assert(Eq 5 (slot-nat board gslot 99 s7))
assert(Eq 3 (slot-nat census pslot 99 s7))
