;;;; Compile the real system vocabularies and the SRS role prefix.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind backend (#module foil-grove-backend))
(#bind driver (#module foil-new-env))
(#bind source (#module foil-source))
(define (ts x) ("ts" x))
(define (path xs) (map ts xs))
(define (ok result)
  (If (Eq "ok" (Hd result)) (_0 result) (error ["role-build" result])))
(define (check ignored)
  (define prepared (backend:prepare 0))
  (define policy (_1 prepared))
  (define helpers (_1 (source:compile (_0 prepared) "tests/grove_backend")))
  (define (helper name)
    (driver:get-perc ["grove_backend_checks" name] helpers))
  (define (parse text)
    (ok ((driver:get-perc ["grove" "parse"] policy) text)))
  (define (missing path) "/boot/maybe/none")
  (define (compile lookup root text)
    (backend:compile prepared lookup (path root) (parse text)))
  (define slots (ok (compile missing ["sys"]
    (read-text-file "grove/sys_slots.grove"))))
  (define types (ok (compile missing ["sys" "types"]
    (read-text-file "grove/sys_types.grove"))))
  (define lookup ((helper "lookup") (Weld slots types)))
  (define srs (parse (read-text-file "grove/srs.grove")))
  (define first-five ((helper "first_five") srs))
  (define records (ok (backend:compile prepared lookup
    (path ["gov" "srs"]) first-five)))
  assert(Eq 5 (Sz records))
  (define recall (_1 (Ix 3 records)))
  (define card (_1 (Ix 4 records)))
  (define (export rec name) ((helper "export") (path [name]) rec))
  (define empty "/boot/sept/mop/empty")
  assert(Equal "/boot/maybe/none" ((export recall "from_myth") empty))
  (define base ((helper "recall_data") 100 8))
  (define decoded ((export recall "from_myth") base))
  assert(Equal "/boot/maybe/some" (Hd decoded))
  assert(Eq 100 (_0 (_0 decoded)))
  assert(Eq 8 (_1 (_0 decoded)))
  assert(Equal ("/boot/maybe/some" base)
    ((export recall "to_myth") (_0 decoded)))
  assert(Equal "/boot/maybe/none" ((export card "from_myth") base))
  (define one ((helper "req_data") base))
  (define decoded-card ((export card "from_myth") one))
  assert(Equal "/boot/maybe/some" (Hd decoded-card))
  assert(Equal ("/boot/maybe/some" one)
    ((export card "to_myth") (_0 decoded-card)))
  ;; OR is inclusive, and every present field must have the right type.
  (define read-card (export card "from_myth"))
  (define write-card (export card "to_myth"))
  (define data (helper "role_data"))
  (define both (data 2 one))
  assert(Equal "/boot/maybe/some" (Hd (read-card (data 2 base))))
  assert(Equal "/boot/maybe/some" (Hd (read-card both)))
  assert(Equal "/boot/maybe/none" (read-card (data 3 both)))
  assert(Equal "/boot/maybe/none" (read-card (data 4 both)))
  assert(Equal "/boot/maybe/none" (read-card (data 5 both)))
  assert(Equal "/boot/maybe/none" (read-card (data 8 both)))
  (define rich (data 7 (data 6 both)))
  assert(Equal ("/boot/maybe/some" rich)
    (write-card (_0 (read-card rich))))
  assert(Equal [5 3 2] ((helper "role_summary") card))

  ;; A manually constructed value with both alternatives absent still
  ;; cannot be converted to a valid myth.
  (define val (_0 decoded-card))
  (define neither ((Hd val) (_0 val) (_1 val)
    "/boot/maybe/none" "/boot/maybe/none" (_4 val) (_5 val)))
  assert(Equal "/boot/maybe/none" (write-card neither))

  ;; Restore a role through only its stored schema and module bundle.
  (define fresh (backend:prepare 0))
  (define role-lookup ((helper "lookup") records))
  (define child (ok (backend:compile fresh role-lookup
    (path ["gov" "child"])
    (parse "#import parent=gov/srs/card

child =
  @role
  #with ; parent
"))))
  (define restored (_1 (_0 child)))
  (define read-child (export restored "from_myth"))
  assert(Equal "/boot/maybe/none" (read-child base))
  assert(Equal "/boot/maybe/some" (Hd (read-child rich)))
  assert(Equal ("/boot/maybe/some" rich)
    ((export restored "to_myth") (_0 (read-child rich))))

  (define (reject text)
    (define result (compile missing ["gov" "bad"] text))
    assert(Equal "err" (Hd result))
    assert(Gt (_0 (_0 (_0 result))) 0)
    1)
  assert(Eq 1 (reject "a =
  @role
  #with ; b

b =
  @role
  #with ; a
"))
  assert(Eq 1 (reject "a =
  @role
  #with ; absent
"))
  assert(Eq 1 (reject "a =
  @role
  x: nat
  x: nat
"))
  assert(Eq 1 (reject "a =
  @role
  #or ;
    ' Empty group.
"))
  assert(Eq 1 (reject "a =
  @role
  #opt ;
    #with ; other
"))
  assert(Eq 1 (reject "a =
  @role
  ! foil
  nat
"))
  1)
assert(Eq 1 (check 0))
