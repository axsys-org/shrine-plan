;;;; Builder syntax expands directly to the existing surface AST.
(#bind std (#module std))
(#import std)
(#bind foil-rex (#module foil-rex))
(#import foil-rex)
(#bind foil-surface (#module foil-surface))
(#import foil-surface)

(define (builder-form? x)
  (Or (rx-rune? "~." x) (Or (rx-rune? "~|" x) (rx-rune? "~#" x))))

;; Only vertical containers are sequences. A juxt is one ordinary call
;; or one field pair, and must not be flattened into separate children.
(define (builder-items xs)
  (hr-stem (rx-group-flat xs)))

(define (builder-expand parse-val parse-type parse-heir fail ns items)
  (define empty (surf-row []))
  (define (call name args) (surf-app (surf-ref (Weld ns [name])) args))
  (define (join a b)
    (If (Equal a empty) b
      (If (Equal b empty) a
        (surf-app (surf-spec (surf-ref ["row" "weld"])
          [(surf-ref (Weld ns ["child"]))]) [b a]))))
  (define (literal x)
    (If (rx-shape? "quip" x)
      (surf-literal "cord" (Rsh (rx-leaf-str x) 8))
      (parse-val x)))
  (define (text x) (call "text" [(literal x)]))
  (define (field x)
    (define ks (If (rx-juxt? x) (rx-juxt-kids x) []))
    (unless (Eq 2 (Sz ks))
      (fail "builder field requires a key and one value expression" x)
      (call "field" [(literal (_0 ks)) (literal (_1 ks))])))
  (define (field? x)
    (Or (rx-shape? "quip" x)
      (And (rx-juxt? x)
        (And (Sz (rx-juxt-kids x)) (rx-shape? "quip" (_0 (rx-juxt-kids x)))))))
  (define (expand xs)
    (builder-expand parse-val parse-type parse-heir fail ns xs))
  (define (component x)
    (If (rx-juxt? x)
      (let ((ks (rx-juxt-kids x)))
        (If (And (Gt (Sz ks) 1)
              (And (rx-nest? (_1 ks)) (Eq "paren" (rx-nest-color (_1 ks)))))
          (surf-app (parse-val (_0 ks))
            (foldl Weld [] (map (lambda (arg)
              (If (rx-plain? "paren" arg)
                (map parse-val (rx-nest-kids arg)) [(parse-val arg)])) (drop 1 ks))))
          (parse-val x)))
      (parse-val x)))
  (define (pipe-body x)
    (define ks (builder-items (rx-rune-kids x)))
    (If (And (Gt (Sz ks) 1) (Nil (builder-form? (_0 ks))))
      (component x)
      (expand ks)))
  (define (one x)
    (define ks (If (rx-nest? x) (builder-items (rx-nest-kids x)) []))
    (cond
      ((rx-plain? "clear" x) (expand ks))
      ((rx-rune? "~." x)
        (unless (Sz ks)
          (fail "atomic builder (~.) requires a value" x)
          (If (rx-shape? "quip" (_0 ks))
            (surf-row [(call "node" [(literal (_0 ks)) empty
              (surf-row (map text (rx-juxt-flat (drop 1 ks))))])])
            (surf-row [(call "texts" [(surf-row (map literal (rx-juxt-flat ks)))])]))))
      ((Or (rx-rune? "~|" x) (rx-rune? "~#" x))
        ;; A head is on the rune's line. With no head, every kid is
        ;; part of the fragment, including an ordinary expression.
        (let ((headed (And (Sz ks)
                (Eq (span-line (rx-span x)) (span-line (rx-span (_0 ks)))))))
          (If (Nil headed)
            (If (rx-rune? "~#" x)
              (fail "configured builder (~#) requires a head" x)
              (expand ks))
            (let* ((body (drop 1 ks))
                   (fields (filter field? body))
                   (children (filter (lambda (k) (Nil (field? k))) body)))
              (If (And (rx-rune? "~|" x) (Sz fields))
                (fail "fields require a configured builder (~#)" x)
                (surf-row [(call "node" [(literal (_0 ks))
                  (surf-row (map field fields)) (expand children)])]))))))
      ;; A bare expression is already a row of children (component).
      ((builder-form? x) (fail "malformed builder form" x))
      (else (component x))))
  (define xs (builder-items items))
  (Ifz (Sz xs) empty
    (let* ((x (_0 xs)) (rest (drop 1 xs))
           (ks (If (rx-nest? x) (builder-items (rx-nest-kids x)) [])))
      (cond
        ((rx-rune? "?" x)
          (unless (Gt (Sz ks) 1)
            (fail "builder conditional requires a condition and a body" x)
            (let* ((body (drop 1 ks))
                   (arms (filter (rx-rune? ">") body))
                   (has-else (And (Sz rest) (rx-rune? "|" (_0 rest))))
                   (no (If has-else (pipe-body (_0 rest)) empty))
                   (tail (If has-else (drop 1 rest) rest)))
              (join
                (If (Sz arms)
                  (If (Ne (Sz arms) (Sz body))
                    (fail "builder match fallthrough must follow |" x)
                  (surf-case (parse-val (_0 ks))
                    (map (lambda (arm)
                      (let ((ak (builder-items (rx-rune-kids arm))))
                        (unless (Gt (Sz ak) 1)
                          (fail "builder match arm requires a pattern and a body" arm)
                          (surf-arm (parse-type (_0 ak)) (expand (drop 1 ak)))))) arms)
                    (If has-else no foil-no-heir)))
                  (surf-if (parse-val (_0 ks)) (expand body) no))
                (expand tail)))))
        ((Or (rx-rune? "?>" x) (rx-rune? ">" x))
          (unless (And (Or (Eq 2 (Sz ks)) (Eq 3 (Sz ks)))
                    (Or (rx-rune? ">" x) (Eq 3 (Sz ks))))
            (fail "builder guard requires a pattern, value, and failure body" x)
            (If (Eq 2 (Sz ks))
              (surf-letrec [(surf-arm (parse-type (_0 ks)) (parse-val (_1 ks)))]
                (expand rest))
              (surf-case (parse-val (_1 ks))
                [(surf-arm (parse-type (_0 ks)) (expand rest))]
                (expand [(_2 ks)])))))
        ((rx-rune? "<" x)
          (unless (Or (Eq 2 (Sz ks)) (Eq 3 (Sz ks)))
            (fail "builder propagation requires a pattern and value" x)
            (surf-prop (parse-type (_0 ks)) (parse-val (_1 ks))
              (If (Eq 3 (Sz ks)) (parse-val (_2 ks)) 0) (expand rest))))
        ;; The untyped `% item row` iteration abbreviation is local to
        ;; builder syntax. It lowers to a normal library bind call.
        ((And (rx-rune? "%" x) (And (Gt (Sz ks) 2) (rx-word? (_0 ks))))
          (join (call "bind" [(parse-val (_1 ks))
            (surf-fun [(parse-type (_0 ks))] (expand (drop 2 ks)))])
            (expand rest)))
        ;; Continuation forms retain their ordinary parser and binding
        ;; rules; only the continuation becomes a child sequence.
        ((Or (rx-rune? "=" x) (Or (rx-rune? "\" x)
          (Or (rx-rune? "%" x) (Or (rx-rune? "^" x) (rx-rune? ";" x)))))
          (parse-heir x (expand rest)))
        ((rx-rune? "|" x)
          (join (pipe-body x) (expand rest)))
        (else (join (one x) (expand rest)))))))
