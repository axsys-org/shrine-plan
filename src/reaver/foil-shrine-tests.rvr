(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil-subject (#module foil-subject))
(#import foil-subject)

(#bind foil (#module foil))


;;; shrine.foil: the versioned namespace over sept's uon/axal.
;;; Runtime shapes: diffs are notes ("/boot/note/make" m) /
;;; ("/boot/note/poke" m) / "/boot/note/cull"; results ("known" m) /
;;; "null" / "unknown"; options ("some" n) / "none"; piths are rows
;;; of quips; step takes (diffs now block s) and returns
;;; (0 state signs); sign rows project _0/_1/_2.  Records ride
;;; opaquely (make never melds), so bare nats stand in for myths.

(define shrine-sut (foil:compile-mod foil:default-subject "shrine"))
(define (shr path) (foil:ir-entry-val (got-entry (Weld ["boot"] path) shrine-sut)))

;; sept arms through the merged subject
(define anew (shr ["axal" "new"]))
(define aput (shr ["axal" "put"]))
(define agut (shr ["axal" "gut"]))
(define akeys (shr ["axal" "keys"]))
(define ugut (shr ["uon" "gut"]))

;; shrine arms
(define snew (shr ["sov" "new"]))
(define xc (shr ["sov" "x_case"]))
(define xq (shr ["sov" "x_query"]))
(define yc (shr ["sov" "y_case"]))
(define yq (shr ["sov" "y_query"]))
(define zc (shr ["sov" "z_case"]))
(define zq (shr ["sov" "z_query"]))
(define sstep (shr ["sov" "step"]))

(define chat ("ts" "chat"))
(define room ("ts" "room"))

(define (sign-of pax signs) (agut pax 0 signs))
(define (grades nt) [(_0 nt) (_1 nt) (_2 nt)])


;;; empty sovereign ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define s0 (snew 0))
assert(Eq 0 (_2 s0))
assert(Equal "unknown" (xq 5 [chat] s0))
assert(Equal "none" (xc 5 [chat] s0))
assert(Equal "unknown" (yq 5 [] s0))
assert(Equal "unknown" (zq 5 [] s0))


;;; step 1: create /chat and /chat/room ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define diffs1
  (aput [chat] ("/boot/note/make" 100) (aput [chat room] ("/boot/note/make" 1) (anew "none"))))
(define r1 (sstep diffs1 0 0 s0))
(define s1 (_0 r1))
(define n1 (_1 r1))

assert(Eq 1 (_2 s1))
;; notes: both paths created (grade 2 everywhere they touch); the root
;; sees y from its direct kid and z from the subtree
assert(Equal [2 2 2] (grades (sign-of [chat] n1)))
assert(Equal [2 2 2] (grades (sign-of [chat room] n1)))
assert(Equal [0 2 2] (grades (sign-of [] n1)))
assert(Equal [[] [chat] [chat room]] (akeys n1))

;; the record stores the diff verbatim at case 1
assert(Equal diffs1 (ugut ("u" 1) 0 (_0 s1)))


;;; step 2: modify /chat/room (data only) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define diffs2 (aput [chat room] ("/boot/note/make" 2) (anew "none")))
(define r2 (sstep diffs2 0 0 s1))
(define s2 (_0 r2))
(define n2 (_1 r2))

assert(Eq 2 (_2 s2))
assert(Equal [1 1 1] (grades (sign-of [chat room] n2)))
assert(Equal [0 1 1] (grades (sign-of [chat] n2)))
assert(Equal [0 0 1] (grades (sign-of [] n2)))


;;; step 3: tombstone /chat/room (shape moves) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define diffs3 (aput [chat room] "/boot/note/cull" (anew "none")))
(define r3 (sstep diffs3 0 0 s2))
(define s3 (_0 r3))
(define n3 (_1 r3))

assert(Eq 3 (_2 s3))
assert(Equal [2 2 2] (grades (sign-of [chat room] n3)))
assert(Equal [0 2 2] (grades (sign-of [chat] n3)))
assert(Equal [0 0 2] (grades (sign-of [] n3)))


;;; historical resolution ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; x: /chat/room across its whole history
assert(Equal "unknown" (xq 0 [chat room] s3))
assert(Equal ("known" 1) (xq 1 [chat room] s3))
assert(Equal ("known" 2) (xq 2 [chat room] s3))
assert(Equal "null" (xq 3 [chat room] s3))
assert(Equal ("some" 1) (xc 1 [chat room] s3))
assert(Equal ("some" 2) (xc 2 [chat room] s3))
assert(Equal ("some" 3) (xc 3 [chat room] s3))
;; /chat's own x never moves after creation
assert(Equal ("some" 1) (xc 3 [chat] s3))
assert(Equal ("known" 100) (xq 3 [chat] s3))
;; beyond top is a shrug, never a guess: the future must stay open so
;; a given (case, care, path) answer is eternal once given
assert(Equal "unknown" (xq 9 [chat room] s3))
assert(Equal "unknown" (xq 9 [chat] s3))
assert(Equal "none" (xc 9 [chat] s3))
assert(Equal "none" (yc 9 [chat] s3))
assert(Equal "none" (zc 9 [] s3))
assert(Equal "unknown" (yq 9 [chat] s3))
assert(Equal "unknown" (zq 9 [chat] s3))

;; y: /chat moves with its kid
assert(Equal ("some" 1) (yc 1 [chat] s3))
assert(Equal ("some" 2) (yc 2 [chat] s3))
assert(Equal ("some" 3) (yc 3 [chat] s3))
;; y epic at case 2 holds both; the tombstone drops room at case 3
(define ye2 (yq 2 [chat] s3))
assert(Eq "known" (Hd ye2))
(define ye2e (_0 ye2))
assert(Equal [[] [room]] (akeys ye2e))
assert(Eq 100 (agut [] 0 ye2e))
assert(Eq 2 (agut [room] 0 ye2e))
(define ye3e (_0 (yq 3 [chat] s3)))
assert(Equal [[]] (akeys ye3e))
;; y of a non-node is unknown
assert(Equal "unknown" (yq 2 [("ts" "nosuch")] s3))

;; z: cases resolve over the subtree even where the root has no value
assert(Equal ("some" 1) (zc 1 [] s3))
assert(Equal ("some" 2) (zc 2 [] s3))
assert(Equal ("some" 3) (zc 3 [] s3))
;; the unasserted root is not a node, so its epic is unknown (spec)
assert(Equal "unknown" (zq 2 [] s3))
;; /chat's z epic reaches the subtree
(define ze2e (_0 (zq 2 [chat] s3)))
assert(Equal [[] [room]] (akeys ze2e))
assert(Eq 2 (agut [room] 0 ze2e))
(define ze3e (_0 (zq 3 [chat] s3)))
assert(Equal [[]] (akeys ze3e))


;;; spine paths: deep creation notifies without inventing nodes ;;;;;;;;;;;;;;;;;;;

(define ka ("ts" "a"))
(define kb ("ts" "b"))
(define kc ("ts" "c"))
(define rdeep (sstep (aput [ka kb kc] ("/boot/note/make" 9) (anew "none")) 0 0 (snew 0)))
(define sdeep (_0 rdeep))
(define ndeep (_1 rdeep))
assert(Equal [2 2 2] (grades (sign-of [ka kb kc] ndeep)))
assert(Equal [0 2 2] (grades (sign-of [ka kb] ndeep)))
assert(Equal [0 0 2] (grades (sign-of [ka] ndeep)))
assert(Equal [0 0 2] (grades (sign-of [] ndeep)))
;; the spine carries no assertions: not nodes, no x anywhere on it
assert(Equal "unknown" (xq 1 [ka] sdeep))
assert(Equal "unknown" (xq 1 [ka kb] sdeep))
assert(Equal ("known" 9) (xq 1 [ka kb kc] sdeep))
assert(Equal "unknown" (yq 1 [ka] sdeep))


;;; referential transparency: minting never changes a past answer ;;;;;;;;;;;;;;;;;

;; capture the full (case, care) surface of s3, mint another case,
;; and re-ask: every answer at c <= 3 must be bit-identical.
(define diffs4 (aput [chat] ("/boot/note/make" 500) (anew "none")))
(define r4 (sstep diffs4 0 0 s3))
(define s4 (_0 r4))
assert(Eq 4 (_2 s4))
;; the future read that was a shrug on s3 now resolves on s4 ...
assert(Equal ("known" 500) (xq 4 [chat] s4))
assert(Equal ("some" 4) (xc 4 [chat] s4))
;; ... and every historical answer is exactly what s3 said
assert(Equal (xq 1 [chat room] s3) (xq 1 [chat room] s4))
assert(Equal (xq 2 [chat room] s3) (xq 2 [chat room] s4))
assert(Equal (xq 3 [chat room] s3) (xq 3 [chat room] s4))
assert(Equal (xq 3 [chat] s3) (xq 3 [chat] s4))
assert(Equal (xc 3 [chat] s3) (xc 3 [chat] s4))
assert(Equal (xc 3 [chat room] s3) (xc 3 [chat room] s4))
assert(Equal (yc 1 [chat] s3) (yc 1 [chat] s4))
assert(Equal (yc 2 [chat] s3) (yc 2 [chat] s4))
assert(Equal (yc 3 [chat] s3) (yc 3 [chat] s4))
assert(Equal (zc 1 [] s3) (zc 1 [] s4))
assert(Equal (zc 2 [] s3) (zc 2 [] s4))
assert(Equal (zc 3 [] s3) (zc 3 [] s4))
assert(Equal (yq 2 [chat] s3) (yq 2 [chat] s4))
assert(Equal (yq 3 [chat] s3) (yq 3 [chat] s4))
assert(Equal (zq 2 [chat] s3) (zq 2 [chat] s4))
assert(Equal (zq 3 [chat] s3) (zq 3 [chat] s4))
;; the gate rides forward: beyond the new top is still a shrug
assert(Equal "unknown" (xq 9 [chat] s4))
assert(Equal "none" (yc 9 [chat] s4))
assert(Equal "none" (zc 9 [] s4))
