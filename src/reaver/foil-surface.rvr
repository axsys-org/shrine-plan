(#bind std (#module std))
(#import std)

;;; Surface AST constructors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define foil-no-heir "no-heir")

(define (surf-ref ref)
  assert(Gt (Sz ref) 0)
  ["s_ref" ref])
(define surf-ref-path (Ix 1))

(define (surf-lit lit)
  ["s_lit" lit])
(define surf-lit-val (Ix 1))

(define (surf-var v)
  assert(IsNat v)
  ["s_var" v])

(define (surf-typ-mode x)
  ["s_typ"])

(define (surf-arm pat val)
  ["s_arm" pat val])
(define surf-arm-pat (Ix 1))
(define surf-arm-val (Ix 2))

(define (surf-self args) ["s_self" args])

(define (surf-tvar var body)
  assert(IsNat var)
  ["s_tvar" var body])
(define (surf-tvars vars body)
  ["s_tvars" vars body])

;; Const generic parameters: consts = [[name type-sast] ...].  Nests
;; inside s_tvars so the declared types may mention sibling tvars.
(define (surf-cvars consts body)
  ["s_cvars" consts body])

;; A constant symbol type: '$foo is the singleton type of the bare
;; symbol nat "foo" (TNAT with a symbol cube).
(define (surf-tsym n)
  ["s_tsym" n])
(define (surf-letrec arms body)
  ["s_letrec" arms body])
;; A loop (|): an immediately-applied lambda.  Each arm declares one
;; loop parameter (pattern = faced type) with its initial value; the
;; body re-enters via the self-call (_ ...).
(define (surf-loop arms body)
  ["s_loop" arms body])
(define (surf-ufcs-put var app)
  ["s_ufcs_put" var app])
(define (surf-ufcs-over var app)
  ["s_ufcs_over" var app])
(define (surf-literal shape text)
  ["s_literal" shape text])

(define (surf-spec val args)
  ["s_spec" val args])
(define surf-spec-val (Ix 1))
(define surf-spec-args (Ix 2))

(define (surf-cast ty body)
  ["s_cast" ty body])
(define surf-cast-ty (Ix 1))
(define (surf-union opts)
  ["s_union" opts])
(define surf-union-opts (Ix 1))
(define (surf-case scrut arms fall)
  ["s_case" scrut arms fall])
(define (surf-if scrut yes no)
  ["s_if" scrut yes no])

(define (surf-app f x)
  ["s_app" f x])
(define (surf-tapp args)
  ["s_tapp" args])
(define surf-tapp-kids (Ix 1))

(define (surf-face face ty)
  ["s_face" face ty])
(define surf-face-name (Ix 1))
(define surf-face-kid (Ix 2))

(define (surf-row row)
  ["s_row" row])
(define surf-row-kids (Ix 1))
(define (surf-trow row)
  ["s_trow" row])
(define (surf-sum vars)
  ["s_sum" vars])

(define (surf-variant tag)
  ["s_variant" tag])

;; A relative variant: .tag / (./tag args) resolves against the type
;; the context expects (the scrutinee in patterns, the goal in
;; expressions) — the member analog of a relative path.
(define (surf-relvar tag)
  ["s_relvar" tag])
(define surf-relvar-tag (Ix 1))

(define (surf-fun args ret)
  ["s_fun" args ret])
(define surf-fun-args (Ix 1))
(define surf-fun-ret (Ix 2))
(define (surf-tfun args ret)
  ["s_tfun" args ret])

(define (surf-meth args)
  ["s_meth" args])
(define (surf-mseg name args)
  ["s_mseg" name args])
(define (surf-mseg-name seg)
  (If (IsNat seg) seg (Ix 1 seg)))
(define (surf-mseg-args seg)
  (If (IsNat seg) [] (Ix 2 seg)))

(define surf-hole ["s_hole"])

(define (surf-mod decls)
  ["s_mod" decls])

(define (surf-decl name span clause)
  ["s_decl" name span clause])

;; An import/mount declaration.  `at` is the explicit mount point, or the
;; enclosing declaration path supplied by the parser for the legacy nested
;; `+ app / - dep` spelling.  `order` is optional: 0 means absent and [n]
;; means explicitly ordered at n.  The one-item row keeps order zero distinct
;; from absence.
;;
;; Keep the historical three-argument constructor as the unordered form so
;; callers which construct surface imports directly continue to work.
(define (surf-import-at-order at span modname order)
  ["s_import" at span modname order])
(define (surf-import at span modname)
  (surf-import-at-order at span modname 0))

;; Accessors accept both the new row and historical four-field imports.  This
;; makes cached/test surface values readable while the compiler migrates to
;; the extended representation.
(define surf-import-at (Ix 1))
(define surf-import-mount surf-import-at)
(define surf-import-span (Ix 2))
(define surf-import-modname (Ix 3))
(define (surf-import-order imp)
  (If (Gt (Sz imp) 4) (Ix 4 imp) 0))

(define (surf-span span val)
  ["s_span" span val])

(define (surf-doc text kids)
  ["s_doc" text kids])
