(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind rp (#module restricted-plan))

(define (call f args) (foldl (lambda (body arg) (0 body arg)) f args))
(define ops [rp:plus rp:minus rp:times rp:quotient rp:equals rp:less rp:choose])
(define (expression argc e depth)
  (If (Gt depth 128) (error "contract expression depth")
    (Ifz (And (rp:row? e) (Ge (Sz e) 2)) (error "contract expression shape")
      (let ((tag (_0 e)))
        (cond
          ((Equal tag 0)
            (If (And (Eq (Sz e) 2) (And (IsNat (_1 e)) (Lt (_1 e) argc)))
              (call rp:lift [(Inc (_1 e))]) (error "contract argument index")))
          ((Equal tag 1)
            (If (And (Eq (Sz e) 2) (rp:word? (_1 e)))
              (call rp:lift [(0 (_1 e))]) (error "contract literal range")))
          ((And (IsNat tag) (And (Ge tag 2) (Le tag 8)))
            (If (Eq (Sz e) (If (Eq tag 8) 4 3))
              (call (Ix (Sub tag 2) ops)
                (map (lambda (x) (expression argc x (Inc depth))) (drop 1 e)))
              (error "contract operation arity")))
          (else (error "unknown contract expression")))))))
(define (lower manifest)
  (Ifz (And (rp:record? 2 manifest)
    (And (IsNat (_0 manifest)) (And (Gt (_0 manifest) 0) (Le (_0 manifest) 16))))
    (error "contract argument count")
    (let* ((argc (_0 manifest))
           (entry (Pin (Law (Dec argc) "contract-entry" (expression argc (_1 manifest) 0))))
           (artifact ["restricted-plan/0" entry
             [[entry (gen argc (lambda (i) rp:WORD)) rp:RESULT]]])
           (valid (rp:validate artifact)))
      (If (_0 valid) artifact (error ["contract rejected" (_1 valid)])))))
