;;;; Native loading and capability bridge for the Foil coordinator.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind foil (#module foil))
(#bind actor-host (#module helm-actor))

(define (helm-pack r)
  (define sut (_1 r))
  ;; Compile once during packing. A saved core carries the coordinator
  ;; gate and its cache, so resume never recompiles it from disk.
  (define actor (foil:compile-mod-cached (_0 r) foil:default-subject "helm_actor"))
  (define (sv path) (foil:source-entry-val path sut))
  ["HELM" (sv ["helm" "boot"]) (sv ["helm" "exec"]) (sv ["x_query_h"])
   sut (_0 actor) (foil:source-entry-val ["helm_actor" "run"] (_1 actor))])

(define (load-helm-mod mod)
  (helm-pack (foil:compile-mod-cached 0 foil:default-subject mod)))

;; The bare driver chain.  The argument is ignored (a zero-argument
;; define does not reduce when applied).
(define (load-helm z)
  (load-helm-mod "helm"))

(define (core-boot c) (Ix 1 c))
(define (core-exec c) (Ix 2 c))
(define (core-xq c) (Ix 3 c))
(define (core-sut c) (Ix 4 c))
(define (core-cache c) (Ix 5 c))
(define (core-run c) (Ix 6 c))

;; An app entry from the core's own compilation.
(define (core-ent core path)
  (foil:source-entry-val path (core-sut core)))

(define (helm-actor core mk-worker persist seed)
  (define run (core-run core))
  (Seq (DeepSeq [run actor-host:receive actor-host:reply actor-host:attempt
                actor-host:report] 0)
    (actor-host:actor run mk-worker persist seed)))
