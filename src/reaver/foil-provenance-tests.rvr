;;;; Defining-module identity survives type annotations and alias mounts.
(#bind std (#module std))
(#import std)
(#bind reef (#module reef))
(#import reef)
(#bind source (#module foil-source))
(#bind driver (#module foil-new-env))
(#bind subject (#module foil-subject))
(#bind elab (#module foil-new-elab))
(#bind sast (#module foil-sast))
(#bind rex (#module rex))
(define (check z)
  (define perc (_1 (source:compile 0 "test_fixtures/env_type_user")))
  (define sut (driver:perc-subject perc))
  assert(Equal ["boot" "test_fixtures/env_type_provider" "token"]
    (subject:canon-path ["types" "token"] sut))
  assert(Equal ["boot" "test_fixtures/env_type_provider" "token" "value"]
    (subject:canon-path ["types" "token" "value"] sut))
  assert(Truth (_1 (elab:elab-value (elab:compiler-for sut)
    (sast:parse-val-sast (rex:ParseRexNorm "types/token")))))
  assert(Equal ["/foil-env/unbound"] (subject:canon-path ["x"] sut))
  (define aliased (_1 (source:compile 0 "test_fixtures/env_type_alias_user")))
  (define asut (driver:perc-subject aliased))
  assert(Equal (subject:canon-path ["left" "token"] asut)
    (subject:canon-path ["right" "token"] asut))
  assert(Equal (subject:canon-path ["left" "token" "value"] asut)
    (subject:canon-path ["right" "token" "value"] asut))
  assert(Truth (driver:import-span (_0 (driver:perc-imports aliased))))
  assert(Truth (driver:perc-entry-span
    (_0 (driver:perc-declared-keys aliased)) aliased))
  1)
assert(Equal 1 (check 0))
