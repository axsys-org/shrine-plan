(#bind std (#module std))
(#import std)

(#bind reef (#module reef))
(#import reef)

(#bind foil (#module foil))
(#bind env (#module foil-env))
(#bind subject (#module foil-subject))

;; resolution-at :: Path -> Unit -> Maybe Resolution
(define (resolution-at path unit)
  (find (lambda (resolution)
          (Equal path (env:resolution-path resolution)))
    (env:unit-resolutions unit)))

;; The provider is mounted only at `types`.  `types/token` occurs solely as a
;; parameter annotation in this unit, while `types/token/value` is selected by
;; UFCS dispatch.  Both must survive elaboration as resolved source edges, even
;; though their compiled entries live below unit-qualified storage keys.
;; compiled :: Subject
(define compiled
  (foil:compile-mod foil:default-subject "env_type_user"))
(define unit (subject:sut-unit compiled))

;; Completed subjects retain a Unit envelope.  Direct/live elaboration must
;; still resolve a visible qualified name through that Unit's environment.
(define completed-type-edge
  (foil:elab-val compiled foil:empty-env
    (foil:parse-foil-val "types/token")))
assert(Truth completed-type-edge)

(define type-edge (resolution-at ["types" "token"] unit))
assert(Truth type-edge)
assert(Eq "env_type_provider"
  (env:from-label (env:resolution-from (_0 type-edge))))
assert(Truth (env:resolution-site (_0 type-edge)))

(define method-edge (resolution-at ["types" "token" "value"] unit))
assert(Truth method-edge)
assert(Eq "env_type_provider"
  (env:from-label (env:resolution-from (_0 method-edge))))
assert(Truth (env:resolution-site (_0 method-edge)))

;; The lambda parameter is lexical and must never be misreported as an
;; environment edge merely because it is a name in the surface tree.
assert(Nil (resolution-at ["x"] unit))

;; Repeated aliases share one canonical unit-qualified entry.  The method edge
;; follows the receiver's source alias at this site, rather than whichever
;; visibility entry happens to sort first.
(define aliased
  (foil:compile-mod foil:default-subject "env_type_alias_user"))
(define aliased-unit (subject:sut-unit aliased))
assert(Truth (resolution-at ["right" "token"] aliased-unit))
assert(Truth (resolution-at ["right" "token" "value"] aliased-unit))
assert(Nil (resolution-at ["left" "token" "value"] aliased-unit))

"foil provenance tests passed"
