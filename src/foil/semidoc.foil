+  myths_kids
  '  A node row as numbered children of root, preorder.
  \  root=path ns=row[snode]
  ^  row[smount]
  |  > i=nat 0  > out=row[smount] []
  ^  row[smount]
  ?  (ge i ns.len)
     out
  (_ i.inc out.weld((node_mounts root.snoc(($u i)) ns.at(i))))
+  node_mounts
  '  One node and its subtree as namespace writes: the node's own
  '  record first (parents before kids), then the kids numbered in
  '  document order — ordering survives as path order.
  \  at=path nd=snode
  ^  row[smount]
  =  own  [(smount at (node_myth nd))]
  ?  nd
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./item lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./lit lang=nat as=row[sattr] body=nat)
     own
   > (./ref p=row[nat] as=row[sattr])
     own
   > (./prose text=nat as=row[sattr])
     own
+  myths
  '  The compiled tree as namespace writes rooted wherever the
  '  mounter chooses — the root is a parameter, never the document's
  '  business.  Make them in order and the document is namespace
  '  data: browsable in the explorer, watchable through crews,
  '  scrubbed by /h like everything else.
  \  root=path ns=row[snode]
  ^  row[smount]
  (myths_kids root ns)
+  seg_texts
  '  A namespace path back to canonical text segments: text auras
  '  keep their cords, numeric auras render as decimal.
  '  ?=  ((seg_texts ['a 'b]) ["a" "b"])
  \  p=path
  ^  row[nat]
  |  > i=nat 0  > out=row[nat] []
  ^  row[nat]
  ?  (ge i p.len)
     out
  =  q  p.at(i)
  ?  (is_text q)
     (_ i.inc out.snoc((quip_val q)))
  (_ i.inc out.snoc((weft/show_nat (quip_val q))))
+  reserved_slot
  '  The slots the node forms own, plus /sys machinery: everything
  '  else on a record reads back as an attribute.
  \  s=path
  ^  bool
  ?  (eq 0 s.len)
     .true
  ?  (eq_iota s.at(0) 'sys)
     .true
  ?  (gt s.len 1)
     .false
  ?  (eq_iota s.at(0) 'kind)
     .true
  ?  (eq_iota s.at(0) 'title)
     .true
  ?  (eq_iota s.at(0) 'lead)
     .true
  ?  (eq_iota s.at(0) 'text)
     .true
  ?  (eq_iota s.at(0) 'lang)
     .true
  ?  (eq_iota s.at(0) 'body)
     .true
  ?  (eq_iota s.at(0) 'ref)
     .true
  ?  (eq_iota s.at(0) 'id)
     .true
  .false
+  sval_back
  '  A slot pail back to an attribute value, when it reads as one.
  \  pl=pail
  ^  maybe[sval]
  ?  pl
   > tp=pails/t  (./some (sval/word tp.t))
   > pp=pails/p  (./some (sval/ref (seg_texts pp.p)))
  .none
+  attrs_back
  '  A record's non-reserved slots as attributes — the inverse of
  '  /put_attrs .
  \  t=myth
  ^  row[sattr]
  =  entries  t.tap
  |  > i=nat 0  > out=row[sattr] []
  ^  row[sattr]
  ?  (ge i entries.len)
     out
  =  e  entries.at(i)
  ?  (reserved_slot e.key)
     (_ i.inc out)
  ?  (sval_back e.val)
   > (./some v=sval)
     (_ i.inc out.snoc((sattr (seg_texts e.key) [v])))
   > .none  (_ i.inc out)
+  kid_nodes
  '  The numbered kids of a hydrated subtree, in document order, as
  '  nodes.  Non-numeric kids (a /kook subtree, say) are not part of
  '  the document.
  \  fat=axal[myth]
  ^  row[snode]
  =  kids  fat.kid_tap
  |  > i=nat 0  > out=row[snode] []
  ^  row[snode]
  ?  (ge i kids.len)
     out
  =  e  kids.at(i)
  ?  e.key
   > ($u n=nat)
     ?  (node_back e.val)
      > (./some nd=snode)  (_ i.inc out.snoc(nd))
      > .none  (_ i.inc out)
  (_ i.inc out)
+  node_back
  '  A namespace record back to a document node, when its ['kind]
  '  names one — the inverse of /node_myth .
  \  fat=axal[myth]
  ^  maybe[snode]
  ?  fat.fil
   > .none  .none
   > (./some t=myth)
     =  k  (myth/txt_at ['kind] t)
     =  as  (attrs_back t)
     ?  (eq k "prose")
        (./some (snode/prose (myth/txt_at ['text] t) as))
     ?  (eq k "lit")
        (./some (snode/lit (myth/txt_at ['lang] t) as (myth/txt_at ['body] t)))
     ?  (eq k "ref")
        =  rp=row[nat]
             ?  t.get(['ref])
              > (./some pl=pail)
                ?  pl
                 > pp=pails/p  (seg_texts pp.p)
                []
              > .none  []
        (./some (snode/ref rp as))
     ?  (eq k "item")
        (./some (snode/item (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "quote")
        (./some (snode/quote (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "sect")
        (./some (snode/sect (myth/txt_at ['title] t) as (kid_nodes fat)))
     ?  (eq k "doc")
        =  did=row[nat]
             ?  t.get(['id])
              > (./some pl2=pail)
                ?  pl2
                 > pp2=pails/p  (seg_texts pp2.p)
                []
              > .none  []
        (./some (snode/doc did as (kid_nodes fat)))
     .none
+  nodes_of
  '  A hydrated subtree as document nodes: a record that IS a node
  '  renders itself (deep targets), anything else renders its
  '  numbered kids — the inverse of /myths .
  \  fat=axal[myth]
  ^  row[snode]
  ?  (node_back fat)
   > (./some nd=snode)  [nd]
   > .none  (kid_nodes fat)
+  view_page
  '  A hydrated subtree served as its page: parse nothing, render
  '  whatever is committed — the namespace is the document.
  \  fat=axal[myth]
  ^  nat
  (page (nodes_of fat))
