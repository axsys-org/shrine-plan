-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  web [order=60]
'  semidoc: a minimal semantic documentation format (spec draft 0).
'  Seven block forms and nothing else: ;. document, ;= section,
'  ;- item, ;> quotation, ;$ literal, ;@ attribute, ;/ reference;
'  every other line is prose.  Layout is indentation: children sit
'  deeper than their parent, section depth is nesting, there are no
'  heading levels.  The parser assigns no meaning to any attribute —
'  predicates are namespace paths, and aliases (;@ /doc/alias d /doc)
'  are lexical only: compiled documents carry canonical paths.
'  Attributes decorate the FOLLOWING node, exactly as specified; a
'  container's trailing attributes (no following node) attach to the
'  container itself.  Literal payloads are opaque: dedented to their
'  own base indent, never parsed.  The tree has two projections,
'  both separate concerns from parsing: /page renders it as HTML
'  through weft (references link into the explorer), and /myths
'  emits it as namespace records — one myth per node, kids numbered
'  to preserve order, attribute predicates as slot keys — so a
'  compiled document mounts as ordinary namespace citizens.  The
'  renderer interprets one standard vocabulary (spec section 18):
'  a literal attributed /doc/interpret-as /formats/test renders
'  with a run form posting its body to the /chore/eval bridge —
'  examples execute against the live image (/doc/eval-with names
'  the module subject, default sept).  The PARSER still assigns no
'  meaning to any attribute.
+  sval
  '  One attribute value: a bare word, or a ;/namespace reference.
  &  sval/word
     sval/ref

  +  word
    :  t=nat

  +  ref
    :  p=row[nat]
+  sattr
  '  One attribute: a canonical predicate path and its values.
  :  pred=row[nat] vals=row[sval]
+  snode
  '  A compiled document node.  Every variant carries its decorating
  '  attributes.
  &  snode/doc
     snode/sect
     snode/item
     snode/quote
     snode/lit
     snode/ref
     snode/prose

  +  doc
    :  id=row[nat] as=row[sattr] kids=row[snode]

  +  sect
    :  title=nat as=row[sattr] kids=row[snode]

  +  item
    :  lead=nat as=row[sattr] kids=row[snode]

  +  quote
    :  lead=nat as=row[sattr] kids=row[snode]

  +  lit
    :  lang=nat as=row[sattr] body=nat

  +  ref
    :  p=row[nat] as=row[sattr]

  +  prose
    :  text=nat as=row[sattr]
+  sline
  '  One source line: its indent, its text past the indent, and
  '  whether it is blank.
  :  ind=nat txt=nat blank=nat
+  salias
  '  One lexical alias: a short name for a path prefix.
  :  name=nat target=row[nat]
+  spar
  '  A parsed sequence: the nodes, the line index just past them,
  '  the aliases as extended, and any trailing undelivered
  '  attributes (the caller's container adopts them).
  :  nodes=row[snode] next=nat al=row[salias] pend=row[sattr]
+  sflush
  '  A paragraph flush: the output with the paragraph appended (when
  '  one was open) and the attributes still pending.
  :  out=row[snode] pend=row[sattr]
+  slitb
  '  A literal payload: the dedented body and the line index just
  '  past it.
  :  body=nat next=nat
+  lines_of
  '  The source as sline records, in order.  Blank lines survive —
  '  they end paragraphs and ride inside literal payloads.
  \  s=nat
  ^  row[sline]
  =  n  (cord/len s)
  |  > i=nat 0  > out=row[sline] []
  ^  row[sline]
  ?  (ge i n)
     out
  =  e  (cord/span_while (\ c (if (eq c 10) 0 1)) s i)
  =  raw  (cord/slice s i (sub e i))
  =  ind  (cord/span_while (\ c (eq c 32)) raw 0)
  =  txt  (cord/slice raw ind (sub (cord/len raw) ind))
  (_ e.inc out.snoc((sline ind txt (if (eq 0 (cord/len txt)) 1 0))))
+  split_byte
  '  The non-empty runs between occurrences of byte b.
  '  ?=  ((split_byte 47 "/a/b") ["a" "b"])
  '  ?=  ((split_byte 32 "one  two") ["one" "two"])
  '  ?=  ((split_byte 47 "") [])
  \  b=nat s=nat
  ^  row[nat]
  =  n  (cord/len s)
  |  > i=nat 0  > start=nat 0  > out=row[nat] []
  ^  row[nat]
  ?  (ge i n)
     ?  (gt i start)
        out.snoc((cord/slice s start (sub i start)))
     out
  ?  (eq b (cord/at s i))
     ?  (gt i start)
        (_ i.inc i.inc out.snoc((cord/slice s start (sub i start))))
     (_ i.inc i.inc out)
  (_ i.inc start out)
+  spaces
  '  A cord of n spaces.
  '  ?=  ((spaces 0) 0)
  '  ?=  ((spaces 2) "  ")
  \  n=nat
  ^  nat
  |  > k=nat n  > acc=nat 0
  ?  (eq k 0)
     acc
  (_ k.dec (cord/cat " " acc))
+  joined
  '  A row of cords joined by one byte.
  '  ?=  ((joined 32 ["a" "b"]) "a b")
  \  b=nat xs=row[nat]
  ^  nat
  |  > i=nat 0  > acc=nat 0
  ?  (ge i xs.len)
     acc
  ?  (eq i 0)
     (_ i.inc xs.at(0))
  (_ i.inc (cord/cat (cord/cat acc b) xs.at(i)))
+  rune_of
  '  The block form a line opens, or 0 for prose.  A rune is ; plus
  '  one byte, followed by a space or the end of the line — except
  '  ;/ , whose path glues on directly.
  '  ?=  ((rune_of ";= Title") "sect")
  '  ?=  ((rune_of ";/a/b") "ref")
  '  ?=  ((rune_of "; nope") 0)
  '  ?=  ((rune_of ";=x") 0)
  '  ?=  ((rune_of "plain prose") 0)
  \  t=nat
  ^  nat
  =  n  (cord/len t)
  ?  (lt n 2)
     0
  ?  (if (eq 59 (cord/at t 0)) 0 1)
     0
  =  b  (cord/at t 1)
  ?  (eq b 47)
     "ref"
  ?  (if (eq n 2) 0 (if (eq 32 (cord/at t 2)) 0 1))
     0
  ?  (eq b 46)
     "doc"
  ?  (eq b 61)
     "sect"
  ?  (eq b 45)
     "item"
  ?  (eq b 62)
     "quote"
  ?  (eq b 36)
     "lit"
  ?  (eq b 64)
     "attr"
  0
+  rest_of
  '  The line past its rune and separating space.
  '  ?=  ((rest_of ";= Title words") "Title words")
  '  ?=  ((rest_of ";.") 0)
  \  t=nat
  ^  nat
  =  n  (cord/len t)
  ?  (le n 3)
     0
  (cord/slice t 3 (sub n 3))
+  canon
  '  A predicate path canonicalized: absolute paths split; relative
  '  paths whose head names an alias expand through it; anything
  '  else splits as written.
  '  ?=  ((canon [] "/doc/status") ["doc" "status"])
  '  ?=  ((canon [(salias "d" ["doc"])] "d/status") ["doc" "status"])
  '  ?=  ((canon [] "d/status") ["d" "status"])
  \  al=row[salias] t=nat
  ^  row[nat]
  =  segs  (split_byte 47 t)
  ?  (eq 47 (cord/at t 0))
     segs
  ?  (eq 0 segs.len)
     segs
  =  hd  segs.at(0)
  =  hit
       |  > i=nat 0
       ^  maybe[row[nat]]
       ?  (ge i al.len)
          .none
       =  a  al.at(i)
       ?  (eq a.name hd)
          (./some a.target)
       (_ i.inc)
  ?  hit
   > (./some tgt)  tgt.weld(segs.drop(1))
   > .none  segs
+  val_of
  '  One attribute value token: ;/paths become references.
  '  ?=  ((val_of ";/people/liam") (sval/ref ["people" "liam"]))
  '  ?=  ((val_of "draft") (sval/word "draft"))
  \  tok=nat
  ^  sval
  ?  (if (eq 59 (cord/at tok 0)) (eq 47 (cord/at tok 1)) 0)
     (sval/ref (split_byte 47 (cord/slice tok 1 (sub (cord/len tok) 1))))
  (sval/word tok)
+  vals_of
  '  Every value token of an attribute line.
  \  toks=row[nat]
  ^  row[sval]
  |  > i=nat 0  > out=row[sval] []
  ^  row[sval]
  ?  (ge i toks.len)
     out
  (_ i.inc out.snoc((val_of toks.at(i))))
+  alias_pred
  '  Is this canonical predicate the alias declaration, /doc/alias ?
  \  pred=row[nat]
  ^  bool
  ?  (eq 2 pred.len)
     (if (eq "doc" pred.at(0)) (eq "alias" pred.at(1)) 0)
  0
+  flush_para
  '  Close an open paragraph: it becomes a prose node adopting the
  '  pending attributes (it was the following node).  No paragraph,
  '  no change.
  \  para=row[nat] pend=row[sattr] out=row[snode]
  ^  sflush
  ?  (eq 0 para.len)
     (sflush out pend)
  (sflush out.snoc((snode/prose (joined 32 para) pend)) [])
+  lit_body
  '  The opaque payload after a literal opener at indent ind: every
  '  following blank-or-deeper line, dedented to the payload's own
  '  base indent, trailing blanks trimmed, newline-joined.  Never
  '  parsed.
  \  ls=row[sline] i0=nat ind=nat
  ^  slitb
  =  raws
       |  > i=nat i0  > out=row[sline] []
       ^  row[sline]
       ?  (ge i ls.len)
          out
       =  ln  ls.at(i)
       ?  ln.blank
          (_ i.inc out.snoc(ln))
       ?  (gt ln.ind ind)
          (_ i.inc out.snoc(ln))
       out
  =  next  (add i0 raws.len)
  =  keep
       |  > k=nat raws.len
       ^  nat
       ?  (eq k 0)
          0
       ?  raws.at(k.dec).blank
          (_ k.dec)
       k
  =  lead
       |  > k=nat 0
       ^  nat
       ?  (ge k keep)
          k
       ?  raws.at(k).blank
          (_ k.inc)
       k
  =  base
       |  > i=nat lead  > b=nat 0  > seen=nat 0
       ^  nat
       ?  (ge i keep)
          b
       =  ln  ls.at((add i0 i))
       ?  ln.blank
          (_ i.inc b seen)
       ?  seen
          ?  (lt ln.ind b)
             (_ i.inc ln.ind 1)
          (_ i.inc b 1)
       (_ i.inc ln.ind 1)
  =  body
       |  > i=nat lead  > out=row[nat] []
       ^  nat
       ?  (ge i keep)
          (joined 10 out)
       =  ln  ls.at((add i0 i))
       ?  ln.blank
          (_ i.inc out.snoc(0))
       (_ i.inc out.snoc((cord/cat (spaces (sub ln.ind base)) ln.txt)))
  (slitb body next)
+  parse_seq
  '  The node sequence at indentation ind or deeper, from line i0:
  '  the heart of the grammar.  Containers recurse one level deeper;
  '  a shallower line ends the sequence.  Attributes accumulate and
  '  attach to the next node built; aliases extend lexically and
  '  flow forward.
  \  ls=row[sline] i0=nat ind=nat al0=row[salias]
  ^  spar
  |  > i=nat i0  > out=row[snode] []  > pend=row[sattr] []  > para=row[nat] []  > al=row[salias] al0
  ^  spar
  ?  (ge i ls.len)
     =  f  (flush_para para pend out)
     (spar f.out i al f.pend)
  =  ln  ls.at(i)
  ?  ln.blank
     =  fb  (flush_para para pend out)
     (_ i.inc fb.out fb.pend [] al)
  ?  (lt ln.ind ind)
     =  f  (flush_para para pend out)
     (spar f.out i al f.pend)
  =  r  (rune_of ln.txt)
  ?  (eq r "attr")
     =  fa  (flush_para para pend out)
     =  toks  (split_byte 32 (rest_of ln.txt))
     ?  (eq 0 toks.len)
        (_ i.inc fa.out fa.pend [] al)
     =  pred  (canon al toks.at(0))
     ?  (alias_pred pred)
        ?  (lt toks.len 3)
           (_ i.inc fa.out fa.pend [] al)
        (_ i.inc fa.out fa.pend [] al.snoc((salias toks.at(1) (canon al toks.at(2)))))
     (_ i.inc fa.out fa.pend.snoc((sattr pred (vals_of toks.drop(1)))) [] al)
  ?  (eq r "ref")
     =  fr  (flush_para para pend out)
     =  p  (split_byte 47 (cord/slice ln.txt 1 (sub (cord/len ln.txt) 1)))
     (_ i.inc fr.out.snoc((snode/ref p fr.pend)) [] [] al)
  ?  (eq r "lit")
     =  fl  (flush_para para pend out)
     =  lb  (lit_body ls i.inc ln.ind)
     (_ lb.next fl.out.snoc((snode/lit (rest_of ln.txt) fl.pend lb.body)) [] [] al)
  ?  (eq r "doc")
     =  fd  (flush_para para pend out)
     =  sub  (parse_seq ls i.inc ln.ind.inc al)
     =  nd  (snode/doc (split_byte 47 (rest_of ln.txt)) fd.pend.weld(sub.pend) sub.nodes)
     (_ sub.next fd.out.snoc(nd) [] [] sub.al)
  ?  (eq r "sect")
     =  fs  (flush_para para pend out)
     =  sub  (parse_seq ls i.inc ln.ind.inc al)
     =  nd  (snode/sect (rest_of ln.txt) fs.pend.weld(sub.pend) sub.nodes)
     (_ sub.next fs.out.snoc(nd) [] [] sub.al)
  ?  (eq r "item")
     =  fi  (flush_para para pend out)
     =  sub  (parse_seq ls i.inc ln.ind.inc al)
     =  nd  (snode/item (rest_of ln.txt) fi.pend.weld(sub.pend) sub.nodes)
     (_ sub.next fi.out.snoc(nd) [] [] sub.al)
  ?  (eq r "quote")
     =  fq  (flush_para para pend out)
     =  sub  (parse_seq ls i.inc ln.ind.inc al)
     =  nd  (snode/quote (rest_of ln.txt) fq.pend.weld(sub.pend) sub.nodes)
     (_ sub.next fq.out.snoc(nd) [] [] sub.al)
  (_ i.inc out pend para.snoc(ln.txt) al)
+  parse
  '  A whole semidoc source as its top-level node sequence.  The
  '  compiled tree carries only canonical paths — aliases are gone.
  \  s=nat
  ^  row[snode]
  (parse_seq (lines_of s) 0 0 []).nodes
+  pred_text
  '  A canonical path as text.
  '  ?=  ((pred_text ["doc" "status"]) "/doc/status")
  \  p=row[nat]
  ^  nat
  (cord/cat "/" (joined 47 p))
+  href_of
  '  The explorer link for a reference: references resolve in the
  '  same namespace as everything else.
  '  ?=  ((href_of ["people" "liam"]) "/ns/people/liam")
  \  p=row[nat]
  ^  nat
  (cord/cat "/ns/" (joined 47 p))
+  val_node
  '  One attribute value rendered: words as text, references as
  '  explorer links.
  \  v=sval
  ^  weft/node
  ?  v
   > (./word t=nat)  (weft/tx t)
   > (./ref p=row[nat])
     (weft/leaf "a" [(weft/href (href_of p))] (pred_text p))
+  attr_node
  '  One attribute as a chip: the predicate then its values.
  \  a=sattr
  ^  weft/node
  =  vals
       |  > i=nat 0  > out=row[weft/node] []
       ^  row[weft/node]
       ?  (ge i a.vals.len)
          out
       (_ i.inc out.snoc((weft/tx " ")).snoc((val_node a.vals.at(i))))
  =  hd  [(weft/leaf "span" [(weft/cls "pred")] (pred_text a.pred))]
  (weft/el "span" [(weft/cls "attr")] hd.weld(vals))
+  attrs_row
  '  A node's attribute chips, or nothing.
  \  as=row[sattr]
  ^  row[weft/node]
  ?  (eq 0 as.len)
     []
  =  chips
       |  > i=nat 0  > out=row[weft/node] []
       ^  row[weft/node]
       ?  (ge i as.len)
          out
       (_ i.inc out.snoc((attr_node as.at(i))))
  [(weft/el "span" [(weft/cls "attrs")] chips)]
+  attr_word
  '  The single word value of an attribute at pred, or 0: the
  '  renderer's peek into the vocabulary it interprets.
  \  as=row[sattr] pred=row[nat]
  ^  nat
  |  > i=nat 0
  ^  nat
  ?  (ge i as.len)
     0
  =  a  as.at(i)
  ?  (eq_rowcord a.pred pred)
     ?  (eq 1 a.vals.len)
        ?  a.vals.at(0)
         > (./word t=nat)  t
         > (./ref p=row[nat])  0
     0
  (_ i.inc)
+  attr_ref
  '  The single reference value of an attribute at pred, or none:
  '  the renderer's peek for path-valued vocabulary.
  \  as=row[sattr] pred=row[nat]
  ^  maybe[row[nat]]
  |  > i=nat 0
  ^  maybe[row[nat]]
  ?  (ge i as.len)
     .none
  =  a  as.at(i)
  ?  (eq_rowcord a.pred pred)
     ?  (eq 1 a.vals.len)
        ?  a.vals.at(0)
         > (./word t=nat)  .none
         > (./ref p=row[nat])  (./some p)
     .none
  (_ i.inc)
+  embed_id
  '  A mount id for an embedded reference: its path dashed — stable,
  '  and distinct per target.
  '  ?=  ((embed_id ["chat" "log"]) "sd-chat-log")
  \  p=row[nat]
  ^  nat
  (cord/cat "sd-" (joined 45 p))
+  eq_rowcord
  '  Two rows of cords, equal segment-wise.
  \  a=row[nat] b=row[nat]
  ^  bool
  ?  (eq a.len b.len)
     |  > i=nat 0
     ^  bool
     ?  (ge i a.len)
        .true
     ?  (eq a.at(i) b.at(i))
        (_ i.inc)
     .false
  .false
+  run_form
  '  The runnable-example form: the literal's body as the expression,
  '  evaluated against a module's live subject through the /chore
  '  bridge.
  \  mod=nat body=nat
  ^  weft/node
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/chore/eval/" mod))
     (weft/cls "run")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "expr")
        (weft/att "value" body)] [])
     (weft/leaf "button" [] (weft/cat2 "run against " mod))])
+  at_text
  '  A mount-relative path as its w-edit spelling: segments joined
  '  by slash, "." for the node itself.
  '  ?=  ((at_text []) ".")
  \  at=path
  ^  nat
  ?  (eq 0 at.len)
     "."
  (joined 47 (seg_texts at))
+  ed_attr
  '  The in-place editing affordance: click, retype, blur — the
  '  /w.js runtime resolves the enclosing mount's data path plus
  '  this relative path and pokes the slot through /edit.  Outside
  '  a mount the attribute is inert.
  \  at=path slot=nat
  ^  row[weft/att]
  [(weft/att "w-edit" (cord/cat_all [(at_text at) " " slot]))]
+  ed_span
  '  An editable text run: the slot's text, marked for the runtime.
  \  at=path slot=nat t=nat
  ^  weft/node
  (weft/el "span" (ed_attr at slot) [(weft/tx t)])
+  render_nodes
  '  A node row as weft nodes, in order, each node's mount-relative
  '  path threaded so its text runs carry the editing affordance.
  \  at=path ns=row[snode]
  ^  row[weft/node]
  |  > i=nat 0  > out=row[weft/node] []
  ^  row[weft/node]
  ?  (ge i ns.len)
     out
  (_ i.inc out.snoc((render_node at.snoc(($u i)) ns.at(i))))
+  render_node
  '  One document node as HTML: sections nest, items indent, literal
  '  payloads stay preformatted (and escape at render like all text).
  '  at is the node's mount-relative path — prose text, item and
  '  quote leads, and section titles render as editable runs.
  \  at=path nd=snode
  ^  weft/node
  ?  nd
   > (./prose text=nat as=row[sattr])
     (weft/el "p" [] (attrs_row as).weld([(ed_span at "text" text)]))
   > (./ref p=row[nat] as=row[sattr])
     ?  (attr_ref as ["doc" "embed"])
      > (./some op=row[nat])
        (weft/el "div" [(weft/cls "sdembed")]
          (attrs_row as).weld([(frag/mount (embed_id p) (seg_iotas op) (seg_iotas p) 2)]))
      > .none
        (weft/el "p" [(weft/cls "sdref")]
          (attrs_row as).weld([(weft/leaf "a" [(weft/href (href_of p))] (pred_text p))]))
   > (./lit lang=nat as=row[sattr] body=nat)
     =  pre
          (weft/el "pre" [(weft/cls (weft/cat2 "lit " lang))]
            (attrs_row as).weld([(weft/tx body)]))
     ?  (eq "/formats/test" (attr_word as ["doc" "interpret-as"]))
        =  mod0  (attr_word as ["doc" "eval-with"])
        =  mod
             ?  (eq 0 mod0)
                "sept"
             mod0
        (weft/el "div" [(weft/cls "littest")] [pre (run_form mod body)])
     pre
   > (./item lead=nat as=row[sattr] kids=row[snode])
     (weft/el "div" [(weft/cls "item")]
       (attrs_row as).weld([(ed_span at "lead" lead)]).weld((render_nodes at kids)))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     (weft/el "blockquote" []
       (attrs_row as).weld([(ed_span at "lead" lead)]).weld((render_nodes at kids)))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     =  hd  [(weft/el "h2" (ed_attr at "title") [(weft/tx title)])]
     (weft/el "section" []
       hd.weld((attrs_row as)).weld((render_nodes at kids)))
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     =  hd=row[weft/node]
          ?  (eq 0 id.len)
             []
          [(weft/leaf "h2" [(weft/cls "docid")] (pred_text id))]
     (weft/el "article" []
       hd.weld((attrs_row as)).weld((render_nodes at kids)))
+  sd_css
  ^  nat
  "body{font-family:sans-serif;max-width:44em;margin:2em auto;padding:0 1em;line-height:1.5;color:#222} section{margin:1em 0;padding-left:1em;border-left:2px solid #dde} h2{font-size:1.1em;color:#345;margin:.6em 0 .2em} .docid{color:#778;font-family:monospace} .item{margin:.2em 0 .2em 1em} .item:before{content:'- ';color:#99a} blockquote{color:#556;border-left:3px solid #ccd;margin:.5em 0;padding-left:.8em} pre.lit{background:#f4f5f7;padding:.6em .8em;border-radius:6px;overflow-x:auto} .attrs{display:block;font-size:.75em;color:#889} .attr{margin-right:.8em} .pred{font-family:monospace;color:#667} a{color:#367} p{margin:.4em 0} .sdembed{margin:.6em 0;padding:.5em;border:1px dashed #ccd;border-radius:6px}"
+  page
  '  The rendered document: one HTML page for a parsed tree.  The
  '  /w.js runtime rides every page so embedded fragments stay
  '  fresh; without mounts it is inert.
  \  ns=row[snode]
  ^  nat
  (weft/page "semidoc" sd_css (render_nodes [] ns).snoc(frag/script))
+  smount
  '  One namespace write: a node's path and its record.
  :  p=path t=myth
+  seg_iotas
  '  Canonical text segments as a namespace path.
  '  ?=  ((seg_iotas ["a" "b"]) ['a 'b])
  \  segs=row[nat]
  ^  path
  |  > i=nat 0  > out=path []
  ^  path
  ?  (ge i segs.len)
     out
  (_ i.inc out.snoc(($ts segs.at(i))))
+  val_pail
  '  One attribute value as a pail: words are text, references are
  '  paths.
  \  v=sval
  ^  pail
  ?  v
   > (./word t=nat)  (pails/t t)
   > (./ref p=row[nat])  (pails/p (seg_iotas p))
+  vals_text
  '  Multi-valued attributes flatten to one text pail: words as
  '  written, references by their path text.
  \  vs=row[sval]
  ^  nat
  =  parts
       |  > i=nat 0  > out=row[nat] []
       ^  row[nat]
       ?  (ge i vs.len)
          out
       =  v  vs.at(i)
       ?  v
        > (./word t=nat)  (_ i.inc out.snoc(t))
        > (./ref p=row[nat])  (_ i.inc out.snoc((pred_text p)))
  (joined 32 parts)
+  put_attrs
  '  Attributes onto a record: the canonical predicate path IS the
  '  slot key — an attributed relation is just a slot.
  \  as=row[sattr] t0=myth
  ^  myth
  |  > i=nat 0  > acc=myth t0
  ^  myth
  ?  (ge i as.len)
     acc
  =  a  as.at(i)
  =  slot  (seg_iotas a.pred)
  ?  (eq 1 a.vals.len)
     (_ i.inc acc.put(slot (val_pail a.vals.at(0))))
  (_ i.inc acc.put(slot (pails/t (vals_text a.vals))))
+  node_myth
  '  One node's own record: ['kind] names the form, the form's data
  '  rides typed slots, attributes land at their predicate paths.
  \  nd=snode
  ^  myth
  ?  nd
   > (./prose text=nat as=row[sattr])
     (put_attrs as (myth/new).put(['kind] (pails/t "prose")).put(['text] (pails/t text)))
   > (./ref p=row[nat] as=row[sattr])
     (put_attrs as (myth/new).put(['kind] (pails/t "ref")).put(['ref] (pails/p (seg_iotas p))))
   > (./lit lang=nat as=row[sattr] body=nat)
     (put_attrs as (myth/new).put(['kind] (pails/t "lit")).put(['lang] (pails/t lang)).put(['body] (pails/t body)))
   > (./item lead=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "item")).put(['lead] (pails/t lead)))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "quote")).put(['lead] (pails/t lead)))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "sect")).put(['title] (pails/t title)))
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     =  t
          ?  (eq 0 id.len)
             (myth/new).put(['kind] (pails/t "doc"))
          (myth/new).put(['kind] (pails/t "doc")).put(['id] (pails/p (seg_iotas id)))
     (put_attrs as t)
+  myths_kids
  '  A node row as numbered children of root, preorder.
  \  root=path ns=row[snode]
  ^  row[smount]
  |  > i=nat 0  > out=row[smount] []
  ^  row[smount]
  ?  (ge i ns.len)
     out
  (_ i.inc out.weld((node_mounts root.snoc(($u i)) ns.at(i))))
+  node_mounts
  '  One node and its subtree as namespace writes: the node's own
  '  record first (parents before kids), then the kids numbered in
  '  document order — ordering survives as path order.
  \  at=path nd=snode
  ^  row[smount]
  =  own  [(smount at (node_myth nd))]
  ?  nd
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./item lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./lit lang=nat as=row[sattr] body=nat)
     own
   > (./ref p=row[nat] as=row[sattr])
     own
   > (./prose text=nat as=row[sattr])
     own
+  myths
  '  The compiled tree as namespace writes rooted wherever the
  '  mounter chooses — the root is a parameter, never the document's
  '  business.  Make them in order and the document is namespace
  '  data: browsable in the explorer, watchable through crews,
  '  scrubbed by /h like everything else.
  \  root=path ns=row[snode]
  ^  row[smount]
  (myths_kids root ns)
+  seg_texts
  '  A namespace path back to canonical text segments: text auras
  '  keep their cords, numeric auras render as decimal.
  '  ?=  ((seg_texts ['a 'b]) ["a" "b"])
  \  p=path
  ^  row[nat]
  |  > i=nat 0  > out=row[nat] []
  ^  row[nat]
  ?  (ge i p.len)
     out
  =  q  p.at(i)
  ?  (is_text q)
     (_ i.inc out.snoc((quip_val q)))
  (_ i.inc out.snoc((weft/show_nat (quip_val q))))
+  reserved_slot
  '  The slots the node forms own, plus /sys machinery: everything
  '  else on a record reads back as an attribute.
  \  s=path
  ^  bool
  ?  (eq 0 s.len)
     .true
  ?  (eq_iota s.at(0) 'sys)
     .true
  ?  (gt s.len 1)
     .false
  ?  (eq_iota s.at(0) 'kind)
     .true
  ?  (eq_iota s.at(0) 'title)
     .true
  ?  (eq_iota s.at(0) 'lead)
     .true
  ?  (eq_iota s.at(0) 'text)
     .true
  ?  (eq_iota s.at(0) 'lang)
     .true
  ?  (eq_iota s.at(0) 'body)
     .true
  ?  (eq_iota s.at(0) 'ref)
     .true
  ?  (eq_iota s.at(0) 'id)
     .true
  .false
+  sval_back
  '  A slot pail back to an attribute value, when it reads as one.
  '  An EMPTY text pail reads back as no value: it is what a
  '  valueless ;@ mounts as, and the sweep value a withdrawn
  '  attribute melds down to — either way, not a value.
  \  pl=pail
  ^  maybe[sval]
  ?  pl
   > tp=pails/t
     ?  (eq 0 tp.t)
        .none
     (./some (sval/word tp.t))
   > pp=pails/p  (./some (sval/ref (seg_texts pp.p)))
  .none
+  attrs_back
  '  A record's non-reserved slots as attributes — the inverse of
  '  /put_attrs .
  \  t=myth
  ^  row[sattr]
  =  entries  t.tap
  |  > i=nat 0  > out=row[sattr] []
  ^  row[sattr]
  ?  (ge i entries.len)
     out
  =  e  entries.at(i)
  ?  (reserved_slot e.key)
     (_ i.inc out)
  ?  (sval_back e.val)
   > (./some v=sval)
     (_ i.inc out.snoc((sattr (seg_texts e.key) [v])))
   > .none  (_ i.inc out)
+  kid_nodes
  '  The numbered kids of a hydrated subtree, in document order, as
  '  nodes.  Non-numeric kids (a /kook subtree, say) are not part of
  '  the document.
  \  fat=axal[myth]
  ^  row[snode]
  =  kids  fat.kid_tap
  |  > i=nat 0  > out=row[snode] []
  ^  row[snode]
  ?  (ge i kids.len)
     out
  =  e  kids.at(i)
  ?  e.key
   > ($u n=nat)
     ?  (node_back e.val)
      > (./some nd=snode)  (_ i.inc out.snoc(nd))
      > .none  (_ i.inc out)
  (_ i.inc out)
+  node_back
  '  A namespace record back to a document node, when its ['kind]
  '  names one — the inverse of /node_myth .
  \  fat=axal[myth]
  ^  maybe[snode]
  ?  fat.fil
   > .none  .none
   > (./some t=myth)
     =  k  (myth/txt_at ['kind] t)
     =  as  (attrs_back t)
     ?  (eq k "prose")
        (./some (snode/prose (myth/txt_at ['text] t) as))
     ?  (eq k "lit")
        (./some (snode/lit (myth/txt_at ['lang] t) as (myth/txt_at ['body] t)))
     ?  (eq k "ref")
        =  rp=row[nat]
             ?  t.get(['ref])
              > (./some pl=pail)
                ?  pl
                 > pp=pails/p  (seg_texts pp.p)
                []
              > .none  []
        (./some (snode/ref rp as))
     ?  (eq k "item")
        (./some (snode/item (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "quote")
        (./some (snode/quote (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "sect")
        (./some (snode/sect (myth/txt_at ['title] t) as (kid_nodes fat)))
     ?  (eq k "doc")
        =  did=row[nat]
             ?  t.get(['id])
              > (./some pl2=pail)
                ?  pl2
                 > pp2=pails/p  (seg_texts pp2.p)
                []
              > .none  []
        (./some (snode/doc did as (kid_nodes fat)))
     .none
+  nodes_of
  '  A hydrated subtree as document nodes: a record that IS a node
  '  renders itself (deep targets), anything else renders its
  '  numbered kids — the inverse of /myths .
  \  fat=axal[myth]
  ^  row[snode]
  ?  (node_back fat)
   > (./some nd=snode)  [nd]
   > .none  (kid_nodes fat)
+  render_fat
  '  A hydrated subtree rendered with mount-relative paths that
  '  match the namespace: a record that IS a node renders itself AT
  '  the mount root (rel "."), anything else renders its numbered
  '  kids at their own numbers — so a w-edit rel path is exactly the
  '  edited record's path under the mount.
  \  fat=axal[myth]
  ^  row[weft/node]
  ?  (node_back fat)
   > (./some nd=snode)  [(render_node [] nd)]
   > .none  (render_nodes [] (kid_nodes fat))
+  view_page
  '  A hydrated subtree served as its page: parse nothing, render
  '  whatever is committed — the namespace is the document.
  \  fat=axal[myth]
  ^  nat
  (page (nodes_of fat))
+  remount
  '  A parsed forest as the hydrated subtree its /myths writes would
  '  build: every mount put at its numbered path, no root record —
  '  node_back's bench, and the raw material of an app's sync law.
  \  ns=row[snode]
  ^  axal[myth]
  (myths_kids [] ns).fold((axal/new[myth] .none) (\ acc m acc.put(m.p m.t)))
+  split_lines
  '  Every newline-separated run, empties KEPT — unlike /split_byte,
  '  which drops them: a literal body's blank lines must survive as
  '  0 entries.
  \  s=nat
  ^  row[nat]
  =  n  (cord/len s)
  |  > i=nat 0  > start=nat 0  > out=row[nat] []
  ^  row[nat]
  ?  (ge i n)
     ?  (eq 0 n)
        out
     out.snoc((cord/slice s start (sub i start)))
  ?  (eq 10 (cord/at s i))
     (_ i.inc i.inc out.snoc((cord/slice s start (sub i start))))
  (_ i.inc start out)
+  joined_all
  '  A row of cords joined by one byte, balanced — /joined folds
  '  /cord/cat and goes quadratic on document-sized output.
  '  ?=  ((joined_all 32 ["a" "b"]) "a b")
  \  b=nat xs=row[nat]
  ^  nat
  ?  (eq 0 xs.len)
     0
  =  rest
       |  > i=nat 1  > out=row[nat] []
       ^  row[nat]
       ?  (ge i xs.len)
          out
       (_ i.inc out.snoc(b).snoc(xs.at(i)))
  (cord/cat xs.at(0) (cord/cat_all rest))
+  clean_text
  '  Inline text made line-safe: newline and carriage-return runs
  '  collapse to single spaces (parse joins paragraph lines with
  '  spaces anyway).  Rune-shaped text cannot be escaped — semidoc
  '  has no escape — so /unparse is normalizing, not injective.
  \  t=nat
  ^  nat
  (joined 32 (split_byte 13 (joined 32 (split_byte 10 t))))
+  tok_text
  '  One attribute value as source text: words as written, references
  '  as glued ;/paths — the inverse of /val_of .
  '  ?=  ((tok_text (sval/ref ["people" "liam"])) ";/people/liam")
  \  v=sval
  ^  nat
  ?  v
   > (./word t)  t
   > (./ref p)   (cord/cat ";" (pred_text p))
+  attr_line
  '  One attribute line at an indent: ;@ then the canonical
  '  predicate, then each value token.  A valueless attribute closes
  '  bare.
  \  ind=nat a=sattr
  ^  nat
  =  head=row[nat]  [(spaces ind) ";@ " (pred_text a.pred)]
  (cord/cat_all head.weld(a.vals.bind((\ v [" " (tok_text v)]))))
+  head_line
  '  A node's opening line at an indent: the rune, then the payload
  '  when there is one — empty payloads close the rune bare, exactly
  '  the forms /rune_of admits.  A ref glues its path; prose is its
  '  text alone.
  \  ind=nat nd=snode
  ^  nat
  =  pre  (spaces ind)
  ?  nd
   > (./doc id _ _)
     ?  (eq 0 id.len)
        (cord/cat pre ";.")
     (cord/cat_all [pre ";. " (pred_text id)])
   > (./sect title _ _)
     ?  (eq 0 (cord/len title))
        (cord/cat pre ";=")
     (cord/cat_all [pre ";= " (clean_text title)])
   > (./item lead _ _)
     ?  (eq 0 (cord/len lead))
        (cord/cat pre ";-")
     (cord/cat_all [pre ";- " (clean_text lead)])
   > (./quote lead _ _)
     ?  (eq 0 (cord/len lead))
        (cord/cat pre ";>")
     (cord/cat_all [pre ";> " (clean_text lead)])
   > (./lit lang _ _)
     ?  (eq 0 (cord/len lang))
        (cord/cat pre ";$")
     (cord/cat_all [pre ";$ " (clean_text lang)])
   > (./ref p _)
     (cord/cat_all [pre ";" (pred_text p)])
   > (./prose text _)
     (cord/cat pre (clean_text text))
+  lit_lines
  '  A literal payload re-indented under its opener: every body line
  '  shifted right to the kid indent, blank entries (0) as truly
  '  empty lines.  The exact inverse of /lit_body: parse takes every
  '  blank-or-deeper line, dedents non-blanks to their minimum
  '  indent — exactly the kid indent here, since a parse-produced
  '  body's own minimum indent is 0 — reads blanks back as 0, and
  '  trims trailing blanks, which this emit never produces.
  \  ind=nat body=nat
  ^  row[nat]
  ?  (eq 0 body)
     []
  (split_lines body).map((\ l (if (eq 0 (cord/len l)) 0 (cord/cat (spaces ind) l))))
+  attrs_of
  '  Every variant's decorating attributes.
  \  nd=snode
  ^  row[sattr]
  ?  nd
   > (./doc _ as _)    as
   > (./sect _ as _)   as
   > (./item _ as _)   as
   > (./quote _ as _)  as
   > (./lit _ as _)    as
   > (./ref _ as)      as
   > (./prose _ as)    as
+  emit_node
  '  One node as source lines at depth d: its attribute lines, its
  '  opening line, then its payload — a literal body re-indented
  '  under the opener, container kids one level deeper.
  \  d=nat nd=snode
  ^  row[nat]
  =  ind  (mul 2 d)
  =  base  (attrs_of nd).map((attr_line ind)).snoc((head_line ind nd))
  ?  nd
   > (./lit _ _ body)    base.weld((lit_lines (add ind 2) body))
   > (./doc _ _ kids)    base.weld((emit_kids d.inc kids))
   > (./sect _ _ kids)   base.weld((emit_kids d.inc kids))
   > (./item _ _ kids)   base.weld((emit_kids d.inc kids))
   > (./quote _ _ kids)  base.weld((emit_kids d.inc kids))
  base
+  emit_kids
  '  Sibling blocks one level deeper: each block's lines, one blank
  '  line before each — the seed sources' own layout.
  \  d=nat ns=row[snode]
  ^  row[nat]
  ns.bind((\ nd (emit_node d nd).cons(0)))
+  unparse
  '  A node row as canonical semidoc source — the inverse of /parse
  '  up to normalization: two-space indent steps, one blank line
  '  between sibling blocks, attribute lines glued above their node,
  '  no trailing newline.  Laws: (parse (unparse ns)) equals ns
  '  whenever ns is parse's own image (or node_back's over
  '  expand-written records), and unparse-of-reparse is a fixpoint
  '  from the first regeneration on.  Content the line grammar
  '  cannot carry — embedded newlines, rune-shaped prose, a
  '  leading-blank literal line — normalizes rather than escapes:
  '  semidoc has no escape.
  \  ns=row[snode]
  ^  nat
  ?  (eq 0 ns.len)
     0
  =  blocks  ns.map((emit_node 0))
  =  lines
       |  > i=nat 1  > out=row[nat] blocks.at(0)
       ^  row[nat]
       ?  (ge i blocks.len)
          out
       (_ i.inc out.snoc(0).weld(blocks.at(i)))
  (joined_all 10 lines)
