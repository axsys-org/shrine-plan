-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
-  foundry_delivery [order=40]
'  foundry_action: source-owned semantic Action declarations and the pure
'  admission cut into projection interaction evidence.
'
'  The declaration is ordinary namespace data.  It owns intent, its stateful
'  subject, contracts, and policy references; it never owns an admitted actor,
'  an effective capability set, a renderer callback, a route, or a kook/form
'  reference.  Admission consumes an already-resolved contextual horizon and
'  can only narrow it.  Lain dispatch remains downstream: an accepted server
'  invocation resolves the declaration's subject and that subject resolves its
'  own kook in the ordinary task/vine path.
+  foundry_action
  +  declaration
    :  identity=path
       subject=path
       input=path
       requirements=row[path]
       attenuation=row[path]
       result=path
       refusal=path
       receipt=path

  +  diagnostic
    :  code=iota field=path

  +  declaration_result
    &  foundry_action/declaration_result/admitted
       foundry_action/declaration_result/refused

    +  admitted
      '  record is retained so the content pin covers the exact admitted
      '  ordinary declaration rather than a lossy parsed projection of it.
      :  declaration=foundry_action/declaration record=myth

    +  refused
      :  diagnostic=foundry_action/diagnostic

  +  context
    '  An upstream authority resolver supplies this already-attenuated
    '  horizon.  `actions` is the target-declared/effective Action set;
    '  capabilities and attenuation are the explicit intersections that
    '  survived every enclosing contract.  witness pins that upstream proof.
    '  This constructor has no ambient defaults and grants nothing by itself.
    :  actor=path
       target=path
       actions=row[path]
       capabilities=row[path]
       attenuation=row[path]
       witness=foundry_digest

  +  witness_evidence
    '  Content addressed binding between the exact declaration pin and the
    '  already-admitted contextual proof.  Set-like horizons are canonicalized
    '  before hashing, so incidental row order cannot change the witness.
    :  declaration=foundry_digest
       upstream=foundry_digest
       actor=path
       target=path
       actions=row[path]
       capabilities=row[path]
       attenuation=row[path]

  +  admission
    &  foundry_action/admission/admitted
       foundry_action/admission/refused

    +  admitted
      :  declaration=foundry_action/declaration
         mount=projection_action_mount

    +  refused
      :  diagnostic=foundry_action/diagnostic

  +  issue
    \  code=iota field=path
    ^  foundry_action/diagnostic
    (foundry_action/diagnostic code field)

  +  path_field
    \  at=path t=myth
    ^  maybe[path]
    ?  t.get(at)
     > .none  .none
     > (./some held=pail)
       ?  held
        > p=pails/p  (./some p.p)
       .none

  +  paths_field
    \  at=path t=myth
    ^  maybe[row[path]]
    ?  t.get(at)
     > .none  .none
     > (./some held=pail)
       ?  held
        > ps=pails/ps  (./some ps.ps)
       .none

  +  nonempty_path_field
    \  at=path t=myth
    ^  bool
    ?  (foundry_action/path_field at t)
     > .none  .false
     > (./some p=path)  (gt p.len 0)

  +  paths_well_formed
    '  Semantic reference rows are sets at admission: every member is nonempty
    '  and duplicates are refused instead of silently manufacturing evidence.
    \  paths=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i paths.len)  .true
    ?  (eq 0 paths.at(i).len)  .false
    ?  (foundry_action/path_in paths.at(i) paths.take(i))  .false
    (_ i.inc)

  +  kind_field_present
    \  t=myth
    ^  bool
    ?  t.quip_at(['semantic 'kind])
     > .none  .false
     > (./some kind=iota)  .true

  +  kind_field_is_action
    \  t=myth
    ^  bool
    ?  t.quip_at(['semantic 'kind])
     > .none  .false
     > (./some kind=iota)  (eq_iota kind 'action)

  +  paths_field_present
    \  at=path t=myth
    ^  bool
    ?  (foundry_action/paths_field at t)
     > .none  .false
     > (./some paths=row[path])  .true

  +  paths_field_well_formed
    \  at=path t=myth
    ^  bool
    ?  (foundry_action/paths_field at t)
     > .none  .false
     > (./some paths=row[path])
       (foundry_action/paths_well_formed paths)

  +  declaration_issue
    '  Stable first-failure validation for the ordinary source record.  Empty
    '  requirement rows are legal, but the row-valued fields themselves must
    '  be present so absence is never mistaken for unconditional admission.
    \  t=myth
    ^  maybe[foundry_action/diagnostic]
    ?  !(foundry_action/kind_field_present t)
       (./some (foundry_action/issue 'action_kind_required
         ['semantic 'kind]))
    ?  !(foundry_action/kind_field_is_action t)
       (./some (foundry_action/issue 'action_kind_invalid
         ['semantic 'kind]))
    ?  !(foundry_action/nonempty_path_field ['action 'identity] t)
       (./some (foundry_action/issue 'action_identity_required
         ['action 'identity]))
    ?  !(foundry_action/nonempty_path_field ['action 'subject] t)
       (./some (foundry_action/issue 'action_subject_required
         ['action 'subject]))
    ?  !(foundry_action/nonempty_path_field ['action 'input] t)
       (./some (foundry_action/issue 'action_input_contract_required
         ['action 'input]))
    ?  !(foundry_action/paths_field_present ['action 'requirements] t)
       (./some (foundry_action/issue 'action_requirements_required
         ['action 'requirements]))
    ?  !(foundry_action/paths_field_well_formed ['action 'requirements] t)
       (./some (foundry_action/issue 'action_requirements_invalid
         ['action 'requirements]))
    ?  !(foundry_action/paths_field_present ['action 'attenuation] t)
       (./some (foundry_action/issue 'action_attenuation_required
         ['action 'attenuation]))
    ?  !(foundry_action/paths_field_well_formed ['action 'attenuation] t)
       (./some (foundry_action/issue 'action_attenuation_invalid
         ['action 'attenuation]))
    ?  !(foundry_action/nonempty_path_field ['action 'result] t)
       (./some (foundry_action/issue 'action_result_policy_required
         ['action 'result]))
    ?  !(foundry_action/nonempty_path_field ['action 'refusal] t)
       (./some (foundry_action/issue 'action_refusal_policy_required
         ['action 'refusal]))
    ?  !(foundry_action/nonempty_path_field ['action 'receipt] t)
       (./some (foundry_action/issue 'action_receipt_policy_required
         ['action 'receipt]))
    .none

  +  path_value
    '  Internal opener used only after declaration_issue has proved the field.
    \  at=path t=myth
    ^  path
    ?  (foundry_action/path_field at t)
     > .none  []
     > (./some p=path)  p

  +  paths_value
    '  Internal opener used only after declaration_issue has proved the field.
    \  at=path t=myth
    ^  row[path]
    ?  (foundry_action/paths_field at t)
     > .none  []
     > (./some ps=row[path])  ps

  +  declaration_of
    '  Parse one exact ordinary namespace record into a typed source-owned
    '  declaration.  No projection or runtime behavior is produced here.
    \  t=myth
    ^  foundry_action/declaration_result
    ?  (foundry_action/declaration_issue t)
     > (./some diagnostic=foundry_action/diagnostic)
       (foundry_action/declaration_result/refused diagnostic)
     > .none
       (foundry_action/declaration_result/admitted
         (foundry_action/declaration
           (foundry_action/path_value ['action 'identity] t)
           (foundry_action/path_value ['action 'subject] t)
           (foundry_action/path_value ['action 'input] t)
           (foundry_action/paths_value ['action 'requirements] t)
           (foundry_action/paths_value ['action 'attenuation] t)
           (foundry_action/path_value ['action 'result] t)
           (foundry_action/path_value ['action 'refusal] t)
           (foundry_action/path_value ['action 'receipt] t))
         t)

  +  path_in
    \  needle=path hay=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i hay.len)  .false
    ?  (eq_pith needle hay.at(i))  .true
    (_ i.inc)

  +  paths_subset
    \  subset=row[path] superset=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i subset.len)  .true
    ?  !(foundry_action/path_in subset.at(i) superset)  .false
    (_ i.inc)

  +  path_insert
    \  value=path paths=row[path]
    ^  row[path]
    |  > i=nat 0
    ?  (ge i paths.len)  paths.snoc(value)
    ?  (lte_pith value paths.at(i))
       paths.take(i).snoc(value).weld(paths.drop(i))
    (_ i.inc)

  +  sort_paths
    \  paths=row[path]
    ^  row[path]
    paths.fold([] (\ out value (foundry_action/path_insert value out)))

  +  admission_witness
    '  Derive the mount witness only after declaration and contextual checks.
    '  The upstream witness remains embedded, so this proof cannot outlive or
    '  substitute for the authority resolver which produced the horizon.
    \  declaration=foundry_digest context=foundry_action/context
    ^  foundry_digest
    (pin_hash (pin_save (pin
      (foundry_action/witness_evidence declaration context.witness
        context.actor context.target
        (foundry_action/sort_paths context.actions)
        (foundry_action/sort_paths context.capabilities)
        (foundry_action/sort_paths context.attenuation)))))

  +  context_issue
    '  This boundary validates witness shape, not authority provenance.  Only
    '  the trusted actor/Space/Scene resolver may construct the upstream proof;
    '  accepting arbitrary client bytes here would be an authority bug.
    \  context=foundry_action/context
    ^  maybe[foundry_action/diagnostic]
    ?  (eq 0 context.actor.len)
       (./some (foundry_action/issue 'action_actor_required ['actor]))
    ?  (eq 0 context.target.len)
       (./some (foundry_action/issue 'action_target_required ['target]))
    ?  !(foundry_digest/valid context.witness)
       (./some (foundry_action/issue 'action_witness_invalid ['witness]))
    ?  !(foundry_action/paths_well_formed context.actions)
       (./some (foundry_action/issue 'action_horizon_invalid ['actions]))
    ?  !(foundry_action/paths_well_formed context.capabilities)
       (./some (foundry_action/issue 'action_capability_horizon_invalid
         ['capabilities]))
    ?  !(foundry_action/paths_well_formed context.attenuation)
       (./some (foundry_action/issue 'action_attenuation_horizon_invalid
         ['attenuation]))
    .none

  +  admit
    '  Narrow an explicit contextual Action horizon into the canonical mount.
    '  The declaration record supplies the immutable content pin; the caller's
    '  already-admitted context supplies the attenuation witness.  A capability
    '  name alone is insufficient: the Action must also be in the effective
    '  target Action set and every declared attenuation contract must survive.
    \  reference=path record=myth context=foundry_action/context
    ^  foundry_action/admission
    ?  (foundry_action/declaration_of record)
     > x=foundry_action/declaration_result/refused
       (foundry_action/admission/refused x.diagnostic)
     > x=foundry_action/declaration_result/admitted
       =  declaration  x.declaration
       ?  !(eq_pith reference declaration.identity)
          (foundry_action/admission/refused
            (foundry_action/issue 'action_identity_mismatch
              ['action 'identity]))
       ?  (foundry_action/context_issue context)
        > (./some diagnostic=foundry_action/diagnostic)
          (foundry_action/admission/refused diagnostic)
        > .none
          ?  !(eq_pith context.target declaration.subject)
             (foundry_action/admission/refused
               (foundry_action/issue 'action_target_mismatch
                 ['action 'subject]))
          ?  !(foundry_action/path_in declaration.identity context.actions)
             (foundry_action/admission/refused
               (foundry_action/issue 'action_not_in_horizon ['actions]))
          ?  !(foundry_action/paths_subset declaration.requirements
                context.capabilities)
             (foundry_action/admission/refused
               (foundry_action/issue 'action_capability_refused
                 ['capabilities]))
          ?  !(foundry_action/paths_subset declaration.attenuation
                context.attenuation)
             (foundry_action/admission/refused
               (foundry_action/issue 'action_attenuation_refused
                 ['attenuation]))
          =  pin  (foundry_delivery/digest_myth x.record)
             witness  (foundry_action/admission_witness pin context)
          (foundry_action/admission/admitted declaration
            (foundry_delivery/make_action_mount declaration.identity pin
              declaration.input witness))

  '  Read-only accessors for hosts and focused tests.
  +  make_context
    '  Runtime construction gate.  Every authority-bearing row and witness is
    '  explicit; there is intentionally no permissive/default constructor.
    \  actor=path target=path actions=row[path] capabilities=row[path]
       attenuation=row[path] witness=foundry_digest
    ^  foundry_action/context
    (foundry_action/context actor target actions capabilities attenuation
      witness)
  +  declaration_value
    \  result=foundry_action/declaration_result
    ^  maybe[foundry_action/declaration]
    ?  result
     > x=foundry_action/declaration_result/admitted
       (./some x.declaration)
     > foundry_action/declaration_result/refused  .none
  +  declaration_code
    \  result=foundry_action/declaration_result
    ^  maybe[iota]
    ?  result
     > foundry_action/declaration_result/admitted  .none
     > x=foundry_action/declaration_result/refused
       (./some x.diagnostic.code)
  +  declaration_identity
    \  declaration=foundry_action/declaration
    ^  path
    declaration.identity
  +  declaration_subject
    \  declaration=foundry_action/declaration
    ^  path
    declaration.subject
  +  declaration_input
    \  declaration=foundry_action/declaration
    ^  path
    declaration.input
  +  declaration_requirements
    \  declaration=foundry_action/declaration
    ^  row[path]
    declaration.requirements
  +  declaration_attenuation
    \  declaration=foundry_action/declaration
    ^  row[path]
    declaration.attenuation
  +  declaration_result_policy
    \  declaration=foundry_action/declaration
    ^  path
    declaration.result
  +  declaration_refusal_policy
    \  declaration=foundry_action/declaration
    ^  path
    declaration.refusal
  +  declaration_receipt_policy
    \  declaration=foundry_action/declaration
    ^  path
    declaration.receipt
  +  admission_mount
    \  admission=foundry_action/admission
    ^  maybe[projection_action_mount]
    ?  admission
     > x=foundry_action/admission/admitted  (./some x.mount)
     > foundry_action/admission/refused     .none
  +  admission_code
    \  admission=foundry_action/admission
    ^  maybe[iota]
    ?  admission
     > foundry_action/admission/admitted  .none
     > x=foundry_action/admission/refused  (./some x.diagnostic.code)
