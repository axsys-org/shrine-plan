- tests/cells [at=fixture]
- graph
- testing

+ graph_union_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = one=path [($x 1) 'user 'orgs 'one]
      two=path [($x 1) 'peer 'user 'firms 'two]
      assertion=path one.weld(['claims 'date])
      retracted=path one.weld(['claims 'withdrawn])
      root=path [($x 1) 'user 'views 'union]
      seed (fixture/cell_tests/put one (myth/sing ['founded] (pails/n 2010)).put(['same] (safe 0 .x two)) sov/new)
      seed (fixture/cell_tests/put two (myth/sing ['founded] (pails/n 2011)) seed)
      claim (myth/sing ['slot] (pails/t "founded")).put(['value] (pails/n 2012)).put(['why] (pails/t "Registry filing"))
      seed (fixture/cell_tests/put assertion claim seed)
      seed (fixture/cell_tests/put retracted claim.put(['value] (pails/n 1900)).put(['retracted] (pails/b .true)) seed)
      config (myth/sing bond/weft (woven graph/union/get)).put(bond/tack (safe 0 .x one))
      seed (fixture/cell_tests/put root config seed)
      conflict_suffix=path ['conflicts ($u 1) 'founded]
      conflict_path=path root.cons('x).weld(conflict_suffix)
      tree
        ?> (./known tree) (view .z 0 conflict_path seed) (axal/new[myth] .none)
        tree
      records=row[[path myth]] tree.tap.filter((\ [at record] (maybe/is_some record.get(['value]))))
      values=row[nat] (records.map((\ [at record] record.nat_at(['value] 0))))
      evidence=bool
        | records.any
          \ [at record]
          ?> (./some source) (graph/view/reference ['source] record) .false
          | and (equal[path] source.path assertion) (equal[str] (record.txt_at(['evidence 'why])) "Registry filing")
      records_suffix=path ['records]
      member=path root.cons('x).weld(records_suffix).weld(two.cons(($u two.len)))
      outline (view .y 0 root.cons('x) seed)
      count
        ?> (./known tree) outline 0
        tree.kid.size
      claim_slot (graph/union/claim_slot claim)
      claimed_slot=str
        ?> (./some slot) claim_slot "missing"
        | path_show slot
      claim_folder=path one.weld(['claims])
      claim_records=nat
        ?> (./known tree) (view .z 0 claim_folder seed) 0
        tree.tap.len
      observations
        | graph/union/facts [(safe 0 .x one)]
          \ facts=row[graph/union/fact]
          ^ view_plan
          | ./done (axal/new[myth] (./some (myth/sing ['count] (pails/n facts.len))))
      collected (woven_run observations (store_reader seed))
    [(testing/text "claim slot decodes as its actual slot" "/founded" claimed_slot)
     (testing/nat "transparent claim folder remains readable" 2 claim_records)
     (testing/nat "facts include the active supporting claim" 2 (fixture/cell_tests/nat_at ['count] collected.value))
     (testing/nat "identity union exposes its navigable branches" 5 count)
     (testing/nat "conflicting values remain separate assertions" 3 records.len)
     (testing/nat "retracted assertions are excluded" 0 (values.any((\ value (eq value 1900)))))
     (testing/nat "claim evidence and source remain attached" 1 evidence)
     (testing/nat "identity member remains a readable canonical graft" 2011 (fixture/cell_tests/nat_at ['founded] (view .x 0 member seed)))]

+ tests
  ^ row[testing/case]
  [(testing/case "attributed identity union" graph_union_tests/checks)]
