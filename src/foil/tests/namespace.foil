- namespace
- testing

+ namespace_tests
  + item
    : value=nat
  + record
    \ value=nat
    ^ myth
    | myth/sing ['sys 'content] (namespace_tests/item value)
  + seed
    \ name=path value=nat state=sov
    ^ sov
    = diff
        | axal/new[note] .none
    ? (sov/step
        diff.put(name (note/make (namespace_tests/record value)))
        0 0 state)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       next
     > (./rejected why) state
  + initial
    ^ namespace
    = shared
        | namespace_tests/seed ['sys 'types 'text] 11 sov/new
      local
        | namespace_tests/seed [($x 1) 'app 'demo] 22 sov/new
      publication | pin (system_publication 1 shared
            (system_publication/assigned shared))
    | namespace ($x 1) local publication
  + unwrap
    \ held=pail
    ^ nat
    ?> item=namespace_tests/item held 0
    item.value
  + value
    \ answer=res[axal[saga]]
    ^ nat
    ?> (./known records) answer 0
    = found records.fil
    ?> (./some record) found 0
    = contents | unpin record.myth
      item | contents.get ['sys 'content]
    ?> (./some held) item 0
    | namespace_tests/unwrap held
  + journal_system
    \ state=namespace
    ^ maybe[pin[system_publication]]
    = answer | state.page .x .none [state.self 'log ($u state.local.top)]
    ?> (./known records) answer .none
    = found records.fil
    ?> (./some record) found .none
    = contents | unpin record.myth
      item | contents.get ['sys 'content]
    ?> (./some held) item .none
    ?> event=namespace_event held .none
    | ./some event.system

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = state namespace_tests/initial
      target=path [($x 1) 'app 'demo]
      diff (axal/new[note] .none).put(target
        (note/poke (namespace_tests/record 33)))
      result | namespace/step diff 0 0 state
      later
        ? result
         > (./accepted committed) committed.state
         > (./rejected _) state
      bad
        | namespace/step
          diff.put(['sys 'types 'text]
            (note/poke (namespace_tests/record 99)))
          0 0 state
      mixed
        | namespace_tests/seed [($x 2) 'foreign] 7 state.local
      denied | namespace/create ($x 1) mixed state.system
      constructed | namespace/create ($x 1) state.local state.system
      bad_revision
        | namespace/create ($x 1) state.local
          (pin (system_publication 2 (unpin state.system).state
            (unpin state.system).definitions))
      roots | later.root .z
      log_write
        | namespace/step
          ((axal/new[note] .none).put([($x 1) 'log ($u 1)] (note/cull)))
          0 0 later
      root_cull
        | namespace/step
          ((axal/new[note] .none).put([($x 1)] (note/cull)))
          0 0 later
      selected | namespace_tests/journal_system later
      noop | namespace/step diff 0 0 later
      unchanged
        ? noop
         > (./accepted result)
          ? !(eq result.signs.wyt 0) .false
          | equal[namespace] result.state later
         > (./rejected _) .false
      empty_event | namespace_event later.system (pin diff) later.local.top 0 0
      empty_replay | later.replay empty_event
      event | namespace_event state.system (pin diff) state.local.top 0 0
      replayed | state.replay event
      repeated | later.replay event
      alternate | pin (system_publication 2 (unpin state.system).state
            (unpin state.system).definitions)
      mismatched | state.replay event.set_system(alternate)
      replay_equal
        ? replayed
         > (./accepted result) (equal[namespace] result.state later)
         > (./rejected _) .false
    [(testing/nat "no-op preserves both stores and journal" 1 unchanged)
     (testing/nat "no-op journal replay is rejected" 1 ?=((./rejected _) empty_replay))
     (testing/nat "valid stores construct a namespace" 1 ?=((./ok _) constructed))
     (testing/nat "selected system revision is validated" 1 ?=((./err _) bad_revision))
     (testing/nat "journal replay reproduces local commit" 1 replay_equal)
     (testing/nat "journal replay checks predecessor" 1 ?=((./rejected _) repeated))
     (testing/nat "journal replay checks system publication" 1 ?=((./rejected _) mismatched))
     (testing/nat "journal records selected publication" 1
       (equal[maybe[pin[system_publication]]] (./some state.system) selected))
     (testing/nat "journal cannot be written directly" 1
       ?=((./rejected _) log_write))
     (testing/nat "ancestor cull cannot remove journal" 1
       ?=((./rejected _) root_cull))
     (testing/nat "local write" 33
       (namespace_tests/value later.page(.x .none target)))
     (testing/nat "system history unchanged" 1
       (equal[pin[system_publication]] state.system later.system))
     (testing/nat "old local case" 22
       (namespace_tests/value later.page(.x (./some 1) target)))
     (testing/nat "system case uses independent epoch" 11
       (namespace_tests/value
         later.page(.x (./some 1) ['sys 'types 'text])))
     (testing/nat "mixed-authority batch rejected" 1
       ?=((./rejected _) bad))
     (testing/nat "foreign state rejected" 1
       ?=((./err _) denied))
     (testing/nat "composed root has no assertion" 1
       ?=(.none roots.fil))
     (testing/nat "composed root contains both authorities" 2 roots.kid_tap.len)
     (testing/nat "global root has no case" 1
       ?=(.none later.case(.z [])))
     (testing/nat "global history is unknown" 1
       ?=(.unknown later.page(.z (./some 1) [])))
     (testing/nat "uncached foreign read is unknown" 1
       ?=(.unknown later.page(.x .none [($x 2) 'other])))
     (testing/nat "configured service root" 1
       (equal[path] [($x 1) 'io 'http] later.service(['io 'http])))]

+ tests
  ^ row[testing/case]
  [(testing/case "sovereign namespace stores" namespace_tests/checks)]
