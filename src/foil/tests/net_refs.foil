- helm
- net
- pact
- grove_install
- testing
- tests/namespace [at=fixture]
- tests/grove_install [at=installer]

' These tests show what a world can do with what a peer published to it. 0x17
' has the standard behaviours installed, and 0x18 publishes to 0x17. There is
' no transport. The test passes the epic that a foot carries when a transport
' is there.
+ net_refs
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + me
    ' It gives the reader that holds the peer's key on its card for the peer.
    ^ namespace
    = fresh (installer/grove_install_checks/bootstrap [])
      met=row[[p=path q=writ]] [[[($x 17) 'io 'mesa ($x 18)] (writ/make (myth/sing ['key] (pails/n (Ed25519PublicKey (net_refs/seed 18)))))]]
    ? (grove_install/changes met fresh)
     > (./ok next) next
     > (./err why) fresh
  + peer
    ^ namespace
    | namespace ($x 18) sov/new (fixture/namespace_tests/initial).system
  + root
    ^ path
    [($x 18) 'our ($x 17)]
  + mount
    ^ path
    [($x 17) 'her ($x 18)]
  + card
    ^ path
    [($x 17) 'io 'mesa ($x 18)]
  + pub
    \ rel=path
    ^ path
    | (net_refs/root).weld(rel)
  + mnt
    \ rel=path
    ^ path
    | (net_refs/mount).weld(rel)
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + head
    \ state=namespace
    ^ nat
    | state.case(.z net_refs/root).fall(0)
  + take
    ' It lands an epic as one event.
    \ change=net/epic reader=namespace
    ^ namespace
    ? (net/land net_refs/mount net_refs/card (net/seal (net_refs/seed 18) net_refs/root change) reader)
     > (./err why) reader
     > (./ok writes) (net_refs/apply writes reader)
  + land
    ' It lands what the publisher holds now, from the head where the reader
    ' stands.
    \ publisher=namespace from=nat reader=namespace
    ^ namespace
    ?> (./some change) (net/delta 0 net_refs/root from (net_refs/head publisher) publisher) reader
    | net_refs/take change reader
  + count
    \ answer=res[axal[myth]]
    ^ nat
    ?> (./known tree) answer 999
    ?> (./some record) tree.fil 999
    | record.nat_at ['count] 999
  + pin
    ' It gives the version that the reference slot of a record holds.
    \ holder=path slot=path state=namespace
    ^ nat
    ?> (./some record) (sovereign_care .x holder state).fil 0
    ?> (./some held) record.get(slot) 0
    ?> link=safe held 0
    | link.ver
  + through
    ' It gives what the reference slot of a record reads.
    \ holder=path slot=path state=namespace
    ^ nat
    ?> (./some record) (sovereign_care .x holder state).fil 0
    ?> (./some held) record.get(slot) 0
    ?> link=safe held 0
    ?> (./known records) (sovereign_view .x 0 (safe/spell link) state) 0
    ?> (./some found) records.fil 0
    | found.nat_at(['value] 0)
  + heard
    ' The journal says that an event was a reaction to some names. This
    ' function gives those names.
    \ epoch=nat state=namespace
    ^ row[path]
    = none=row[path] []
    ?> (./some record) (sovereign_care .x [state.self 'log ($u epoch)] state).fil none
    ?> (./some held) record.get(system_vocabulary/heard) none
    ?> names=pails/ps held none
    | names.ps
  + names
    \ wanted=path listed=row[path]
    ^ nat
    ? (listed.any((\ name=path (equal[path] name wanted)))) 1
    0
  + show
    \ result=either[iota namespace]
    ^ str
    ? result
     > (./ok next) "ok"
     > (./err why) (str/from_atom (iota_show why))
  + asks
    ' This test uses a peer's record that refers to a name of the reader. The
    ' reader did not make that name.
    \ _=unit
    ^ row[testing/check]
    = mine=path [($x 17) 'our ($x 18) 'ask]
      ask=myth (net_refs/rec 7).put(['answer] (safe 0 .x mine))
      writes=row[[p=path q=writ]] [[net_refs/root (writ/make (net_refs/rec 1))]
        [(net_refs/pub ['ask]) (writ/make ask)]]
      p1 (net_refs/apply writes net_refs/peer)
      m1 (net_refs/land p1 0 net_refs/me)
      listing=path (r_spell mine)
      edge=path listing.weld([($u 1) 'answer]).weld((net_refs/pub ['ask]))
    [(testing/nat "the peer's record landed" 7 (net_refs/value (net_refs/mnt ['ask]) m1))
     (testing/nat "its reference to my unmade name is listed" 1 (net_refs/count (sovereign_view .x 0 listing m1)))
     (testing/nat "under the peer's own spelling of its record" 1 (?=((./known _) (sovereign_view .x 0 edge m1))))
     (testing/nat "and my name is still unmade" 0 (net/live mine m1))]
  + live
    ' A live reference to a peer's name follows the peer's versions.
    \ _=unit
    ^ row[testing/check]
    = doc=path (net_refs/pub ['doc])
      first=row[[p=path q=writ]] [[net_refs/root (writ/make (net_refs/rec 1))]
        [doc (writ/make (net_refs/rec 10))]]
      second=row[[p=path q=writ]] [[doc (writ/poke (net_refs/rec 11))]]
      third=row[[p=path q=writ]] [[doc (writ/poke (net_refs/rec 12))]]
      fourth=row[[p=path q=writ]] [[doc (writ/poke (net_refs/rec 13))]]
      p3 (net_refs/apply third (net_refs/apply second (net_refs/apply first net_refs/peer)))
      m1 (net_refs/land p3 0 net_refs/me)
      registry=path [($x 17) 'kook 'fresh]
      watcher=path [($x 17) 'app 'watcher]
      held=myth (myth/sing limb_slot (kook [registry])).put(['source] (safe 1 .x doc))
      made=row[[p=path q=writ]] [[watcher (writ/make held)]]
      m2 (net_refs/apply made m1)
      p4 (net_refs/apply fourth p3)
      m3 (net_refs/land p4 (net_refs/head p3) m2)
    [(testing/nat "the peer's name is at its third version" 3 p3.case(.x doc).fall(0))
     (testing/nat "the mount holds that version beside its own first" 3 (net/version (net_refs/mnt ['doc]) m1))
     (testing/nat "a reference at the local case that got it reads its content" 12 (net_refs/through watcher ['source] m2))
     (testing/nat "the peer's change arrives" 13 (net_refs/value (net_refs/mnt ['doc]) m3))
     (testing/nat "and the live reference holds the new local case" 2 (net_refs/pin watcher ['source] m3))
     (testing/nat "and reads the new content" 13 (net_refs/through watcher ['source] m3))
     (testing/nat "the arrival and the reaction are two events" (add m2.local.top 2) m3.local.top)
     (testing/nat "the journal says the reaction heard the peer's name" 1 (net_refs/names (net_refs/mnt ['doc]) (net_refs/heard m3.local.top m3)))
     (testing/nat "and that the arrival heard nothing" 0 (net_refs/heard m3.local.top.dec m3).len)]
  + template
    ' The reader instantiates a template that a peer published, toward that
    ' peer.
    \ _=unit
    ^ row[testing/check]
    = here=path []
      offer=path (net_refs/pub ['offer])
      seeds=row[[path myth]] [[here (myth/sing ['title] (pails/n 1))]
        [['part] (net_refs/rec 2)]]
      shape (grove_template grove_templates/version seeds)
      writes=row[[p=path q=writ]] [[net_refs/root (writ/make (net_refs/rec 1))]
        [offer (writ/make (myth/sing grove_templates/slot shape))]]
      p1 (net_refs/apply writes net_refs/peer)
      m1 (net_refs/land p1 0 net_refs/me)
      version (net/version (net_refs/mnt ['offer]) m1)
      target=path [($x 17) 'our ($x 18) 'thing]
      made (grove_install/instantiate offer version target m1)
      m2
        ? made
         > (./ok next) next
         > (./err why) m1
    [(testing/nat "the peer's template landed at its version" 1 version)
     (testing/text "it can be instantiated toward the peer" "ok" (net_refs/show made))
     (testing/nat "which makes the part" 2 (net_refs/value target.weld(['part]) m2))
     (testing/nat "the instance cites the template at the peer's version" version (net_refs/pin target grove_templates/source_slot m2))
     (testing/nat "and the template lists its instance" 1 (net_refs/count (sovereign_view .x 0 (r_spell offer) m2)))]
  + inert
    ' This test uses a peer's record that names one of the reader's
    ' behaviours.
    \ _=unit
    ^ row[testing/check]
    = here=path []
      private=path [($x 17) 'app 'private]
      registry=path [($x 17) 'kook 'fresh]
      bait=myth (myth/sing limb_slot (kook [registry])).put(['source] (safe 1 .x private))
      entries=row[net/entry] [(net/put here (net/stamp 0 1) (net_refs/rec 1))
        (net/put ['bait] (net/stamp 0 1) bait)]
      mine=row[[p=path q=writ]] [[private (writ/make (net_refs/rec 1))]]
      later=row[[p=path q=writ]] [[private (writ/poke (net_refs/rec 2))]]
      m0 (net_refs/apply mine net_refs/me)
      m1 (net_refs/take (net/epic 0 (net/stamp 0 2) 0 entries) m0)
      m2 (net_refs/apply later m1)
      landed (sovereign_care .x (net_refs/mnt ['bait]) m1).fil.fall(myth/new)
    [(testing/nat "the record landed" 1 (net/live (net_refs/mnt ['bait]) m1))
     (testing/nat "as one event" m0.local.top.inc m1.local.top)
     (testing/nat "none of my behaviours ran on it" 0 (maybe/is_some landed.get(crew_slot)))
     (testing/nat "a later change of mine is one event" m1.local.top.inc m2.local.top)
     (testing/nat "and leaves the peer's record as it was" 1 (net_refs/pin (net_refs/mnt ['bait]) ['source] m2))]

+ tests
  ^ row[testing/case]
  [(testing/case "a peer's reference to my unmade name is an ask I can see" net_refs/asks)
   (testing/case "a live reference follows a peer's versions" net_refs/live)
   (testing/case "a peer's template is instantiated toward it" net_refs/template)
   (testing/case "a landed record runs none of my behaviours" net_refs/inert)]
