- testing
- fs_read

+ fs_read_tests
  + has
    \ name=str data=nat files=row[fs_read/file]
    ^ bool
    | files.any
     \ file=fs_read/file
     | and (equal[str] file.name name) (eq file.bytes data)

  + files
    \ ignored=unit
    ^ row[testing/check]
    = ;scan | fs_read/read "foil/fixtures/fs_read"
    ? scan
     > (./err why)
      [(testing/text "directory read succeeds" "" why)]
     > (./ok files)
      [(testing/nat "only immediate files" 3 files.len)
       (testing/nat "empty file keeps sentinel" 1
         (fs_read_tests/has "empty" 1 files))
       (testing/nat "binary file keeps trailing NUL" 1
         (fs_read_tests/has "binary" 65601 files))
       (testing/nat "filename stays a single string" 1
         (fs_read_tests/has "two words.txt"
           292948653401448 files))]

  + failures
    \ ignored=unit
    ^ row[testing/check]
    = ;unset | fs_read/read ""
      ;scan
        | fs_read/entries "foil/fixtures/fs_read"
          [[0 "binary"] [0 "missing"]]
    [(testing/nat "unset directory fails" 1
       (either/is_err unset))
     (testing/nat "failed file discards partial bag" 1
       (either/is_err scan))]

+ tests
  ^ row[testing/case]
  [(testing/case "flat directory snapshot" fs_read_tests/files)
   (testing/case "scan failures" fs_read_tests/failures)]
