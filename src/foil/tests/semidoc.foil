-  sept [order=10]
-  shrine_types [order=20]
-  lain_types [order=38]
-  semidoc [order=80]
-  testing [order=100]

+  semidoc_tests
  +  starts
    \ pre=nat text=nat
    ^ bool
    | eq pre | cord/slice 0 (cord/len pre) text
  +  source
    ^ nat
    | cord/cat_all
      [";@ /doc/alias d /doc" 10 ";@ /doc/alias p /project" 10
       ";. /shrine/roadmap" 10 "  ;= Unix Driver" 10
       "    ;@ p/status /status/in-progress" 10
       "    ;@ p/owner ;/people/liam" 10
       "    Provide deterministic access to Unix programs." 10 10
       "    ;= Acceptance" 10 "      ;- Batch execution works." 10
       "      ;- Output streams correctly." 10
       "      ;- Capabilities remain deterministic." 10
       "    ;= Example" 10 "      ;@ d/interpret-as /formats/test" 10
       "      ;$ foil" 10 "        +result = resolve(path)"]
  +  expected
    ' Handwritten oracle; hydration sorts attributes by predicate.
    \ sorted=bool
    ^ row[snode]
    = status (sattr ["project" "status"]
               [(sval/word "/status/in-progress")])
      owner (sattr ["project" "owner"]
              [(sval/ref ["people" "liam"])])
    = attrs=row[sattr]
        ? sorted [owner status]
        [status owner]
    [(snode/doc ["shrine" "roadmap"] []
      [(snode/sect "Unix Driver" []
        [(snode/prose
          "Provide deterministic access to Unix programs." attrs)
         (snode/sect "Acceptance" []
          [(snode/item "Batch execution works." [] [])
           (snode/item "Output streams correctly." [] [])
           (snode/item "Capabilities remain deterministic." [] [])])
         (snode/sect "Example" []
          [(snode/lit "foil"
            [(sattr ["doc" "interpret-as"]
              [(sval/word "/formats/test")])]
            "+result = resolve(path)")])])])]
  +  literal
    ^ nat
    | cord/cat_all [";$ text" 10 10 "  unknown -> known" 10 10
                    "    deeper survives" 10 "  ;= not a section"]
  +  examples
    ^ row[[name=str src=nat want=row[snode]]]
    [["spec example" semidoc_tests/source (semidoc_tests/expected 0)]
     ["quote and reference"
      (cord/cat_all [";> attributed to nobody" 10 10
        "  the quoted passage itself" 10 10 ";/shrine/moment"])
      [(snode/quote "attributed to nobody" []
        [(snode/prose "the quoted passage itself" [])])
       (snode/ref ["shrine" "moment"] [])]]
     ["paragraphs" (cord/cat_all ["one two" 10 "three" 10 10 "four"])
      [(snode/prose "one two three" []) (snode/prose "four" [])]]
     ["opaque literal" semidoc_tests/literal
      [(snode/lit "text" []
        (cord/cat_all ["unknown -> known" 10 10
                      "  deeper survives" 10 ";= not a section"]))]]
     ["trailing attributes"
      (cord/cat_all [";= Widget" 10 10 "  some prose" 10 10
                     "  ;@ /doc/status draft"])
      [(snode/sect "Widget"
        [(sattr ["doc" "status"] [(sval/word "draft")])]
        [(snode/prose "some prose" [])])]]
     ["lexical aliases"
      (cord/cat_all [";@ /doc/alias q /questions" 10
                     ";@ q/open why" 10 ";@ zz/other val" 10
                     "prose anchor"])
      [(snode/prose "prose anchor"
        [(sattr ["questions" "open"] [(sval/word "why")])
         (sattr ["zz" "other"] [(sval/word "val")])])]]
     ["anonymous document" (cord/cat_all [";." 10 10 "  body prose"])
      [(snode/doc [] [] [(snode/prose "body prose" [])])]]]
  +  parsing
    \ _=unit
    ^ row[testing/check]
    = examples semidoc_tests/examples
    | examples.fold []
     \ out=row[testing/check] ex=[name=str src=nat want=row[snode]]
     = [name src want] ex
       tree | parse src
       text | unparse tree
     | out.weld
       [(testing/nat name 1 (equal want tree))
        (testing/nat (str/cat " round trip" name) 1
          (equal tree (parse text)))
        (testing/nat (str/cat " text fixpoint" name) 1
          (equal text (unparse (parse text))))]
  +  rendering
    \ _=unit
    ^ row[testing/check]
    = tree | parse semidoc_tests/source
      html | page tree
      contains
        \ needle=nat
        ^ testing/check
        | testing/nat (str/from_atom needle) 1
          (cord/has needle html)
    = needles=row[nat]
        ["<section><h2 " ">Unix Driver</h2>" "/shrine/roadmap"
         "/project/status" "/ns/people/liam" "+result = resolve(path)"
         "/chore/eval/sept" "run against sept"]
    | needles.map(contains).weld
      [(testing/nat "page prefix" 1
         (semidoc_tests/starts "<!doctype html>" html))
       (testing/nat "literal escaping" 1
         (cord/has "unknown -&gt; known"
           (page (parse semidoc_tests/literal))))]
  +  mounts
    \ _=unit
    ^ row[testing/check]
    = tree | parse semidoc_tests/source
      mounts | myths ['d] tree
      prose mounts.at(2).t
      actual | mounts.map (\ m=smount m.p)
      paths=row[path]
        [['d ($u 0)] ['d ($u 0) ($u 0)]
         ['d ($u 0) ($u 0) ($u 0)] ['d ($u 0) ($u 0) ($u 1)]
         ['d ($u 0) ($u 0) ($u 1) ($u 0)]
         ['d ($u 0) ($u 0) ($u 1) ($u 1)]
         ['d ($u 0) ($u 0) ($u 1) ($u 2)]
         ['d ($u 0) ($u 0) ($u 2)] ['d ($u 0) ($u 0) ($u 2) ($u 0)]]
      lit mounts.at(8).t
      word
        \ name=str want=str slot=path rec=myth
        ^ testing/check
        | testing/text name want (myth/txt_at slot rec)
    [(testing/nat "preorder mount paths" 1 (equal paths actual))
     (word "document kind" "doc" ['kind] mounts.at(0).t)
     (word "prose kind" "prose" ['kind] prose)
     (word "prose text" "Provide deterministic access to Unix programs."
       ['text] prose)
     (word "status slot" "/status/in-progress" ['project 'status] prose)
     (testing/nat "owner path pail" 1
       (equal (pails/p ['people 'liam])
         (myth/pail_at ['project 'owner] prose)))
     (word "literal kind" "lit" ['kind] lit)
     (word "literal language" "foil" ['lang] lit)
     (word "literal body" "+result = resolve(path)" ['body] lit)
     (word "literal vocabulary" "/formats/test"
       ['doc ($ts "interpret-as")] lit)
     (word "item order" "Capabilities remain deterministic."
       ['lead] mounts.at(6).t)]
  +  records
    \ _=unit
    ^ row[testing/check]
    = back | nodes_of | remount | parse semidoc_tests/source
      multi | parse | cord/cat_all [";@ /doc/tags a ;/t/b" 10 "anchor"]
      flat | nodes_of | remount multi
      flag | node_myth | (parse
        (cord/cat_all [";@ /doc/flag" 10 "anchor"])).at(0)
    [(testing/nat "record tree and sorted attributes" 1
       (equal (semidoc_tests/expected 1) back))
     (testing/nat "record parse round trip" 1
       (equal back (parse (unparse back))))
     (testing/nat "record projection fixpoint" 1
       (equal back (nodes_of (remount (parse (unparse back))))))
     (testing/nat "multi-valued attribute flattens" 1
       (equal [(snode/prose "anchor"
         [(sattr ["doc" "tags"] [(sval/word "a /t/b")])])] flat))
     (testing/nat "flattening fixpoint" 1
       (equal flat (nodes_of (remount (parse (unparse flat))))))
     (testing/nat "valueless attribute mounts empty text" 1
       (equal (pails/t "") (myth/pail_at ['doc 'flag] flag)))
     (testing/nat "valueless attribute disappears" 0
       (attrs_back flag).len)
     (testing/nat "canonical document prefix" 1
       (semidoc_tests/starts ";. /shrine/roadmap"
         (unparse (parse semidoc_tests/source))))
     (testing/same[nat] "canonical literal" str/from_atom
       (cord/cat_all [";$ text" 10 "  unknown -> known" 10 10
                     "    deeper survives" 10 "  ;= not a section"])
       (unparse (parse semidoc_tests/literal)))
     (testing/same[nat] "reference spelling" str/from_atom
       ";/shrine/moment" (unparse (parse ";/shrine/moment")))]

+  tests
  ^ row[testing/case]
  [(testing/case "parse and round trips" semidoc_tests/parsing)
   (testing/case "HTML rendering" semidoc_tests/rendering)
   (testing/case "namespace mounts" semidoc_tests/mounts)
   (testing/case "record projection" semidoc_tests/records)]
