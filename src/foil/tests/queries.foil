- tests/composition [at=fixture]
- tests/cells [at=fixture]
- lain_peek
- view_ops
- view_cache
- testing

+ query_tests
  + cost
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | ./need (view_read source (view_select/slots [['lead_time_days] ['price]]))
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (./fail "missing supplier")
      ?> (./some record) tree.fil (./fail "missing supplier")
      | ./done (axal/new[myth] (./some (myth/sing ['value]
        (pails/n (add (record.nat_at(['lead_time_days] 0)) (record.nat_at(['price] 0)))))))
  + forever
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | ./need (view_read source .names)
      \ ignored=res[axal[myth]]
      ^ view_plan
      | query_tests/forever context cr relative select
  + repeated
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = read (view_read source .all)
    | ./need read
      \ first=res[axal[myth]]
      ^ view_plan
      | ./need read
        \ second=res[axal[myth]]
        ^ view_plan
        ?> (./known tree) second (./fail "input unavailable")
        | ./done tree
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      supplier=iota 'supplier
      source=path [($x 1) 'supplier]
      calc=path [($x 1) 'calculation]
      group=path [($x 1) 'review]
      bad=path [($x 1) 'unrelated]
      virtual=path calc.cons(xs)
      record (myth/sing ['lead_time_days] (pails/n 90))
      seed (fixture/cell_tests/put source record sov/new)
      seed (fixture/cell_tests/put calc (myth/sing bond/weft (woven query_tests/cost)).put(bond/tack (safe 0 .x source)) seed)
      seed (fixture/cell_tests/put bad (myth/sing bond/weft (woven query_tests/forever)).put(bond/tack (safe 0 .x source)) seed)
      seed (fixture/cell_tests/put group (myth/sing bond/weft (woven view_ops/gather)).put(['supplier] (safe 0 .x virtual)).put(['unopened] (safe 0 .x bad.cons(xs))) seed)
      cached (woven_evaluate 0 calc .x [] (store_reader seed))
      phone (fixture/cell_tests/put source record.put(['phone] (pails/t "555-0100")) seed)
      lead (fixture/cell_tests/put source record.put(['lead_time_days] (pails/n 180)) phone)
      price (fixture/cell_tests/put source record.put(['price] (pails/n 185)) phone)
      frozen (fixture/composition_tests/pinned seed.top virtual)
      child=path group.cons(xs).snoc(supplier)
      childcalc=path [($x 1) 'nested]
      nested (fixture/cell_tests/put childcalc (myth/sing bond/weft (cell fixture/composition_tests/identity)).put(bond/tack (safe 0 .x child)) seed)
      count=path [($x 1) 'count]
      counted (fixture/cell_tests/put count (myth/sing bond/weft (woven view_ops/count)).put(bond/tack (safe 0 .y group.cons(xs))) seed)
      number
        \ name=path state=sov
        ^ nat
        | fixture/cell_tests/nat_at ['value] (view .x 0 name state)
      origin=bool
        ?> (./known tree) (view .x 0 child seed) .false
        ?> (./some record) tree.fil .false
        ?> (./some held) record.get(['sys 'view 'origin]) .false
        ?> ref=safe held .false
        | equal[path] ref.path virtual
      pinned_origin=nat
        = pinned (fixture/composition_tests/pinned seed.top child)
        ?> (./known tree) (view .x 0 pinned lead) 0
        ?> (./some record) tree.fil 0
        ?> (./some held) record.get(['sys 'view 'origin]) 0
        ?> ref=safe held 0
        | fixture/cell_tests/nat_at ['value] (view ref.care ref.ver ref.path lead)
      parent (woven_evaluate 0 group .x [supplier] (store_reader seed))
      token=pin[any] (pin 17)
      request (view_read (safe 0 .x child) .all)
      [cold cache cold_hit] (view_cache/read request (store_reader seed) seed.top token view_cache/new)
      [warm cache warm_hit] (view_cache/read request (store_reader seed) seed.top token cache)
      [unchanged cache unchanged_hit] (view_cache/read request (store_reader phone) phone.top token cache)
      [changed cache changed_hit] (view_cache/read request (store_reader lead) lead.top token cache)
      oldmeta (h_ver source seed)
      historicalmeta (h_ver source lead.set_top(seed.top))
      repeated (woven_run (query_tests/repeated (myth/sing bond/tack (safe 0 .x source)) .x [] .all) (store_reader seed))
      context (view .z 0 virtual.cons('c) seed)
      observed_source=str
        ?> (./known tree) context ""
        ?> (./some record) tree.dip(['looks ($u 1)]).fil ""
        ?> (./some held) record.get(['source]) ""
        ?> ref=safe held ""
        | path_show ref.path
      constrained (woven_evaluate 0 bad .x [] (store_reader seed).set_fuel(8))
      failed (woven_run (view_plan/fail "source is awaiting review") (store_reader seed))
    [(testing/nat "demand cell evaluates selected slots" 90 (number virtual seed))
     (testing/nat "unrelated slot preserves cached result" 1 (woven_valid cached (store_reader phone)))
     (testing/nat "changed selected slot invalidates cache" 0 (woven_valid cached (store_reader lead)))
     (testing/nat "previously missing selected slot invalidates cache" 0 (woven_valid cached (store_reader price)))
     (testing/nat "live demand cell sees changed input" 180 (number virtual lead))
     (testing/nat "epoch pin freezes dynamically discovered input" 90 (number frozen lead))
     (testing/nat "gather navigates only selected member" 90 (number child seed))
     (testing/nat "graft retains authoritative name" 1 origin)
     (testing/nat "origin followed outside a pinned view retains its snapshot" 90 pinned_origin)
     (testing/nat "ordinary cell consumes demand view subtree" 90 (number childcalc.cons(xs) nested))
     (testing/nat "query budget refuses an endless plan" 1 (?=(.unknown (woven_evaluate 0 bad .x [] (store_reader seed).set_fuel(8)).value)))
     (testing/nat "historical metadata keeps historical clocks" 1 (equal oldmeta historicalmeta))
     (testing/nat "query manifest records precise slot selection" 2 cached.observations.len)
     (testing/nat "nested query records leaf observations" 1
       (parent.observations.all((\ observed !(is_xv observed.read.source.path)))))
     (testing/nat "nested query ignores an unobserved slot edit" 1 (woven_valid parent (store_reader phone)))
     (testing/nat "nested query observes a selected slot edit" 0 (woven_valid parent (store_reader lead)))
     (testing/nat "first cached request computes" 0 cold_hit)
     (testing/nat "same epoch reuses native cache" 1 warm_hit)
     (testing/nat "unrelated write reuses native cache" 1 unchanged_hit)
     (testing/nat "changed dependency recomputes native cache" 0 changed_hit)
     (testing/nat "only necessary evaluations run" 2 cache.evaluations)
     (testing/nat "changed cached value is current" 180 (fixture/cell_tests/nat_at ['value] changed.value))
     (testing/nat "repeated input reads share one observation within a computation" 1 repeated.observations.len)
     (testing/nat "memoized continuations still consume the traversal budget" 3 repeated.steps)
     (testing/text "query context exposes resolved state" "ready" (fixture/cell_tests/text_at ['sys 'view 'status] context))
     (testing/nat "query context exposes actual dependency count" 2 (fixture/cell_tests/nat_at ['sys 'view 'observations] context))
     (testing/text "query context retains selected observation source" (path_show source) observed_source)
     (testing/text "query budget reports the reason" "computation read budget exhausted" constrained.fault)
     (testing/text "query failure retains the computation's explanation" "source is awaiting review" failed.fault)]

  + locality
    \ ignored=unit
    ^ row[testing/check]
    = a=iota ($x 17)
      b=iota ($x 18)
      c=iota ($x 19)
      xs=iota 'x
      root=path [($x 1) 'compose]
      one=path [($x 1) 'fixtures a]
      two=path [($x 1) 'fixtures b]
      three=path [($x 1) 'fixtures c]
      first=path ['orgs 'mckenzie 'employees 'bob]
      second=path ['orgs 'mckenzie 'employees 'charlie]
      misplaced=path ['people 'david]
      firm=path ['orgs 'mckenzie]
      seed (fixture/cell_tests/put (fixture/composition_tests/append one ['orgs 'verisk]) (myth/sing ['name] (pails/t "Verisk")) sov/new)
      seed (fixture/cell_tests/put two.weld(first) (myth/sing ['name] (pails/t "Bob")) seed)
      seed (fixture/cell_tests/put three.weld(second) (myth/sing ['name] (pails/t "Charlie")) seed)
      seed (fixture/cell_tests/put three.weld(misplaced) (myth/sing ['name] (pails/t "David")) seed)
      seed (fixture/cell_tests/put two.weld(firm) (myth/sing ['value] (pails/n 10)) seed)
      seed (fixture/cell_tests/put three.weld(firm) (myth/sing ['value] (pails/n 20)) seed)
      config
        | (myth/sing bond/weft (woven view_ops/compose)).put(['world a] (safe 0 .z one)).put(['world b] (safe 0 .z two)).put(['world c] (safe 0 .z three))
      seed (fixture/cell_tests/put root config seed)
      composed=path (fixture/composition_tests/append root.cons(xs) [a b 'orgs c 'mckenzie 'employees])
      repeated=path (fixture/composition_tests/append root.cons(xs) [a b 'orgs c c 'mckenzie 'employees])
      absent=path (fixture/composition_tests/append root.cons(xs) [a b 'orgs c 'people])
      disagreement=path (fixture/composition_tests/append root.cons(xs) [b c 'orgs 'mckenzie])
      tree
        ?> (./known tree) (view .z 0 composed seed) (axal/new[myth] .none)
        tree
      alternatives=nat
        ?> (./known tree) (view .x 0 disagreement seed) 0
        ?> (./some record) tree.fil 0
        ?> (./some held) record.get(['value]) 0
        ?> conflict=view_alternatives held 0
        conflict.values.len
    [(testing/nat "composition enriches the current locality" 2 tree.tap.len)
     (testing/nat "repeated world is idempotent" 1 (equal (view .z 0 composed seed) (view .z 0 repeated seed)))
     (testing/nat "missing locality never falls back to world root" 1 (?=(.unknown (view .z 0 absent seed))))
     (testing/nat "conflicting values retain both sources" 2 alternatives)]

+ tests
  ^ row[testing/case]
  [(testing/case "demand-driven views and observations" query_tests/checks)
   (testing/case "locality-preserving namespace composition" query_tests/locality)]
