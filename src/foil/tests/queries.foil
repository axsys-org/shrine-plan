- tests/composition [at=fixture]
- tests/cells [at=fixture]
- testing

' These tests describe the actual supplied-input model. A cell can choose
' within an input tree, but Lain resolves its declared inputs eagerly. No
' demand interpreter, slot-selective cache or discovered read is implied.
+ query_tests
  + select
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    = selected context.path_at(['selected]).fall([])
      context context.put(['input_records] (pails/n input.tap.len))
    | [context input.dip(selected)]
  + input_status
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    = unavailable context.has(['sys 'view 'empty 'unopened])
      result (myth/sing ['unopened_unavailable] (pails/b unavailable))
    | [context (axal/new[myth] (./some result))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      cs=iota 'c
      source=path [($x 1) 'suppliers]
      selected=path source.snoc('selected)
      sibling=path source.snoc('sibling)
      calc=path [($x 1) 'calculation]
      selected_calc=path [($x 1) 'selected_calculation]
      broken=path [($x 1) 'broken]
      aggregate=path [($x 1) 'aggregate]
      empty=path [($x 1) 'empty]
      pointer (safe 0 .x [($x 1) 'elsewhere])
      record (myth/sing ['price] (pails/n 90)).put(['next] pointer)
      seed (fixture/cell_tests/put selected record sov/new)
      seed (fixture/cell_tests/put sibling (myth/sing ['price] (pails/n 180)) seed)
      seed (fixture/cell_tests/put empty myth/new seed)
      seed (fixture/cell_tests/put calc
        (myth/sing bond/weft (cell query_tests/select)).put(bond/tack (safe 0 .z source)).put(['selected] (pails/p ['selected])) seed)
      seed (fixture/cell_tests/put selected_calc
        (myth/sing bond/weft (cell fixture/composition_tests/identity)).put(bond/tack (safe 0 .x selected)) seed)
      seed (fixture/cell_tests/put broken
        (myth/sing bond/weft (cell fixture/composition_tests/identity)).put(bond/tack (safe 0 .x [($x 1) 'absent])) seed)
      seed (fixture/cell_tests/put aggregate
        (myth/sing bond/weft (cell query_tests/input_status)).put(bond/tack (safe 0 .x selected)).put(['unopened] (safe 0 .x broken.cons(xs))) seed)
      answer (view .x 0 calc.cons(xs) seed)
      context (view .x 0 calc.cons(xs).cons(cs) seed)
      fault (view .x 0 broken.cons(xs).cons(cs) seed)
      tagged (view .x 0 aggregate.cons(xs) seed)
      secondary_context (view .x 0 aggregate.cons(xs).cons(cs) seed)
      declared (xv_trigger calc.cons(xs) seed)
      selected_dependencies (xv_trigger selected_calc.cons(xs) seed)
      change (fixture/cell_tests/put sibling (myth/sing ['price] (pails/n 999)) seed)
      pointer_survives
        ?> (./known tree) answer .false
        ?> (./some record) tree.fil .false
        | equal[maybe[pail]] (record.get(['next])) (./some pointer)
    [(testing/nat "a transformation selects a record from its supplied tree" 90
       (fixture/cell_tests/nat_at ['price] answer))
     (testing/nat "selection still receives both records in the declared input tree" 2
       (fixture/cell_tests/nat_at ['input_records] context))
     (testing/nat "a safe discovered in supplied data remains a reference, not a reader effect" 1 pointer_survives)
     (testing/nat "whole-tree computation declares the whole supplied scope" 1
       (declared.any((\ d (and (equal[care] d.c .z) (equal d.p source))))))
     (testing/nat "an explicitly narrower input declares only that exact record" 1
       (selected_dependencies.any((\ d (and (equal[care] d.c .x) (equal d.p selected))))))
     (testing/nat "explicit narrow input has no sibling dependency" 0
       (selected_dependencies.any((\ d (equal d.p sibling)))))
     (testing/nat "sibling edits do not change the selected result" 90
       (fixture/cell_tests/nat_at ['price] (view .x 0 selected_calc.cons(xs) change)))
     (testing/nat "declared secondary inputs are resolved even when the function does not use them" 1
       (fixture/cell_tests/bool_at ['unopened_unavailable] tagged))
     (testing/nat "an unavailable secondary retains its explicit diagnostic" 1
       (fixture/cell_tests/has ['sys 'view 'empty 'unopened] secondary_context))
     (testing/nat "a failed primary computation remains unknown" 1
       (fixture/cell_tests/probe (view .x 0 broken.cons(xs) seed)))
     (testing/nat "the failed primary computation exposes its cause" 1
       (fixture/cell_tests/has ['sys 'view 'fault] fault))
     (testing/nat "an absent physical record is unknown" 1
       (fixture/cell_tests/probe (view .x 0 [($x 1) 'absent] seed)))
     (testing/nat "an explicitly asserted empty record remains known" 4
       (fixture/cell_tests/probe (view .x 0 empty seed)))]

+ tests
  ^ row[testing/case]
  [(testing/case "supplied-tree selection and declared dependency scope" query_tests/checks)]
