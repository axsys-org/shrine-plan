- http_foot
- testing

+ transport_tests
  + route
    \ status=nat request=http_foot/request now=nat
    ^ http_foot/action
    | ./reply (http_driver/response status "fixture")
  + status
    \ routes=row[http_foot/route] target=str
    ^ nat
    = request (http_foot/request "GET" target "")
    ? (http_foot/dispatch routes request 0)
     > (./reply response) response.status
    0
  + asset_checks
    \ ignored=unit
    ^ row[testing/check]
    = home=path [($x 1) 'io 'fs 'demo]
    = bindings=row[[str str]] [["/a" "main.css"]]
    = get (http_foot/request "GET" "/a?cache=1" "")
    = plan (http_foot/live_plan home bindings (transport_tests/route 200))
    [(testing/nat "declared GET reads current mount" 1
        (equal (plan get 0) (http_foot/action/asset home "main.css" "text/plain; charset=utf-8")))
     (testing/nat "undeclared URL retains handler" 1
        (equal (plan get.set_target("/other") 0) (transport_tests/route 200 get 0)))
     (testing/nat "POST retains handler" 1
        (equal (plan get.set_method("POST") 0) (transport_tests/route 200 get 0)))
     (testing/nat "errors retain handler" 1
        (equal (http_foot/live_plan home bindings (transport_tests/route 405) get 0)
          (transport_tests/route 405 get 0)))
     (testing/nat "binary bar retains trailing zero" 1
        (eq (load8 (sub (wid (http_foot/encode_bytes 200 65537 "image/png")) 2)
          (http_foot/encode_bytes 200 65537 "image/png")) 0))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = routes=row[http_foot/route]
        [(http_foot/route "/a" (transport_tests/route 201))
         (http_foot/route "/a/b" (transport_tests/route 202))]
    = duplicate
        | Try (http_foot/add_routes routes)
          (http_foot/add_routes routes http_foot/empty)
    [(testing/nat "empty registry is bare" 404
        (transport_tests/status [] "/ns"))
     (testing/nat "root prefix is a fallback" 203
        (transport_tests/status [(http_foot/route "/" (transport_tests/route 203))] "/other"))
     (testing/nat "longest prefix wins" 202
        (transport_tests/status routes "/a/b/c?x=1"))
     (testing/nat "segment boundary matters" 404
        (transport_tests/status routes "/abc"))
     (testing/nat "query is not a route suffix" 201
        (transport_tests/status routes "/a?x=1"))
     (testing/nat "duplicate registration rejected" 1
        (either/is_err duplicate))]

+ tests
  ^ row[testing/case]
  [(testing/case "HTTP registration" transport_tests/checks)
   (testing/case "live mount assets" transport_tests/asset_checks)]
