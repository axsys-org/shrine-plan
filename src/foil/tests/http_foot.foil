- http_foot
- testing

+ http_foot_tests
  + parser
    \ ignored=unit
    ^ row[testing/check]
    = fields (http_foot/fields "message=hello+world&back=%2Fns%2Fhello&literal=%2B")
      malformed (Try[str str] (http_foot/decode .true) "%zz")
      duplicate (Try[str nat] http_foot/content_length
        (str/cat_all ["POST / HTTP/1.1" http_foot/crlf
          "Content-Length: 1" http_foot/crlf "Content-Length: 2" http_foot/crlf]))
      length (http_foot/content_length
        (str/cat_all ["POST / HTTP/1.1" http_foot/crlf "content-length: 12" http_foot/crlf]))
      parts (http_foot/target "/ns/a/3/$s")
    [(testing/text "form percent decoding" "/ns/hello" (http_foot/field "back" fields))
     (testing/text "form spaces" "hello world" (http_foot/field "message" fields))
     (testing/text "literal plus" "+" (http_foot/field "literal" fields))
     (testing/nat "malformed escapes rejected" 1 (either/is_err malformed))
     (testing/nat "duplicate framing rejected" 1 (either/is_err duplicate))
     (testing/nat "content length" 12 length)
     (testing/nat "aura paths preserved" 1 (equal[path] parts ['a ($u 3) ($ta "s")] ))]

  + routes
    \ ignored=unit
    ^ row[testing/check]
    = edit (http_foot/plan (http_foot/request "POST" "/edit/hello" "message=updated") 0)
      post (http_foot/plan (http_foot/request "POST" "/post/hello" "name=world&back=%2Fns") 0)
      op (http_foot/plan (http_foot/request "POST" "/op/hello" "op=%2Fops%2Fdo&count=12&label=hi") 123)
      compiler (http_foot/plan (http_foot/request "POST" "/vine/hello" "verb=poke&expr=0") 0)
      install (http_foot/plan (http_foot/request "POST"
        "/grove/install" "source=%2F0x11%2Fgov%2Fsrs&version=1&root=%2F0x11%2Fapp%2Fsrs") 0)
      install_ok=bool
        ? install
         > (./install source version target)
          ? !(equal[path] source [($x 17) 'gov 'srs]) .false
          ? !(equal[path] target [($x 17) 'app 'srs]) .false
          | eq version 1
        .false
      read_install (http_foot/plan (http_foot/request "GET"
        "/grove/install" "") 0)
      read_status=nat
        ? read_install
         > (./reply response) response.status
        0
      edit_ok=bool
        ? edit
         > (./write pax wit back)
          ? wit
           > (./poke record)
            (equal[str] record.txt_at(['message]) "updated")
          .false
        .false
      post_ok=bool
        ? post
         > (./write pax wit back)
          ? wit
           > (./poke record) (equal[str] record.txt_at(['post 'name]) "world")
          .false
        .false
      op_ok=bool
        ? op
         > (./write pax wit back)
          ? wit
           > (./warp target input)
            ? !(equal[path] target ['ops 'do]) .false
            ? !(eq input.nat_at(['when] 0) 123) .false
            | eq input.nat_at(['count] 0) 12
          .false
        .false
      status=nat
        ? compiler
         > (./reply response) response.status
        0
    [(testing/nat "install names template and instance root" 1 install_ok)
     (testing/nat "install requires POST" 405 read_status)
     (testing/nat "edit produces direct text slots" 1 edit_ok)
     (testing/nat "post produces post-prefixed slots" 1 post_ok)
     (testing/nat "operation carries typed fields and timestamp" 1 op_ok)
     (testing/nat "expression route explicitly unavailable" 501 status)]

  + request_care
    \ ignored=unit
    ^ row[testing/check]
    = selected
        \ target=path expected=care
        ?> (./some held) (http/req "GET" "/ns" "" target).get(crew_slot) .false
        ?> dependencies=cpail held .false
        ?> (./some dependency) dependencies.crew.get(['view]) .false
        | equal[care] expected dependency.c
    [(testing/nat "global explorer requests only root frontier" 1 (selected [] .y))
     (testing/nat "non-root views retain full renderer input" 1 (selected [($x 17) 'hello] .z))]

+ tests
  ^ row[testing/case]
  [(testing/case "HTTP parsing" http_foot_tests/parser)
   (testing/case "HTTP routes" http_foot_tests/routes)
   (testing/case "HTTP request read depth" http_foot_tests/request_care)]
