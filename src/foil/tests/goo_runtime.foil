- goo_runtime
- testing
- overlay_cache
- tests/grove_install [at=installer]
- tests/grove_template [at=fixture]

+ goo_runtime_checks
  + expression
    \ text=str
    ^ rex
    | rex/normalize (either/ok_val (rex/parse text))
  + setup
    \ ignored=unit
    ^ [namespace goo_runtime/request]
    = target=path [($x 17) 'app 'interactive]
      view_path=path [($x 17) 'gov 'interactive 'edit]
      input (rex/rune "=" [(rex/quip "'/sys/req") (goo_runtime_checks/expression ".input(card.req)")])
      group (goo/node rex/zero_span "group" (((list/one[rex] (rex/rune "=" [(rex/word "myth") (rex/expr rex/zero_span "curly" [input])])).cons((rex/rune "=" [(rex/word "action") (goo_runtime_checks/expression ".poke")]))).cons((rex/rune "=" [(rex/word "on") (rex/word "card")]))) (list/one (goo/node rex/zero_span "action" (list/one[rex] (rex/cord "Save")) .nil)))
      view (goo/view rex/zero_span view_path ['role] ['sys 'slot 'edit] "card" (list/one group))
      contract (grove_role_runtime/spec [[['sys 'req] (curb/of_type (^ pails/t))]] [[['sys 'req]]])
      published (goo/published view .nil contract (./ok view))
      state (installer/grove_install_checks/bootstrap [])
      state (fixture/grove_template_checks/seed view_path
        (note/make (myth/sing publisher_vocabulary/grove/view published)) state)
      state (fixture/grove_template_checks/seed target
        (note/make (myth/sing ['sys 'req] (pails/t "Before"))) state)
      query (goo_runtime/request "act" target target view_path [0 0]
        (state.case(.x target)).fall(0) (state.case(.y target)).fall(0)
        (goo_runtime/publication state) [["/sys/req" "After"]] 0)
    [state query]
  + grade
    :
  + batch_sum
    \ tree=axal[myth]
    ^ myth
    = total (tree.tap.fold(0 (\ total [path card] (add total (card.nat_at(['value] 0))))))
    | myth/sing ['value] (pails/n total)
  + batches
    \ ignored=unit
    ^ row[testing/check]
    = initial (installer/grove_install_checks/bootstrap [])
      root=path [initial.self 'app 'batch_values]
      a root.snoc('a)
      b root.snoc('b)
      output=path [initial.self 'app 'batch_sum]
      code=path [initial.self 'gov 'batch_sum]
      initial (either/ok_val (grove_install/change_many
        [[root (writ/make myth/new)]
         [a (writ/make (myth/sing ['value] (pails/n 1)))]
         [b (writ/make (myth/sing ['value] (pails/n 2)))]
         [code (writ/make (myth/sing bond/weft (felt goo_runtime_checks/batch_sum .none)))]] initial))
      cached (overlay_cache/install output (overlay_cache/path (initial.case(.x code)).fall(0) code root) initial)
      ready (either/ok_val cached)
      first (sovereign_run_batch
        [[a (writ/poke (myth/sing ['value] (pails/n 10)))]
         [b (writ/poke (myth/sing ['value] (pails/n 20)))]] 0 0 0 ready)
      committed=namespace
        ? first
         > (./ripe state _ _ _) state
        ready
      changed (grove_install/change_many
        [[a (writ/poke (myth/sing ['value] (pails/n 10)))]
         [b (writ/poke (myth/sing ['value] (pails/n 20)))]] ready)
      next (either/ok_val changed)
      indexed (grove_install/change_many_with
        [[a (writ/poke (myth/sing ['value] (pails/n 10)))]
         [b (writ/poke (myth/sing ['value] (pails/n 20)))]] ready (sovereign_hive ready))
      [indexed_state index] (either/ok_val indexed)
      [removed removed_index] (either/ok_val (grove_install/change_many_with
        [[output .cull]] indexed_state index))
      [later later_index] (either/ok_val (grove_install/change_many_with
        [[a (writ/poke (myth/sing ['value] (pails/n 11)))]] removed removed_index))
      sum (overlay_cache/value (goo_runtime/record .x output next).fall(myth/new)).fil.fall(myth/new).nat_at(['value] 0)
      rejected (grove_install/change_many
        [[a (writ/poke (myth/sing ['value] (pails/n 100)))]
         [[($x 99) 'app 'foreign] (writ/make myth/new)]] ready)
      missing (grove_install/change_many
        [[a (writ/poke (myth/sing ['value] (pails/n 100)))]
         [root.snoc('missing) (writ/poke myth/new)]] ready)
      empty (grove_install/change_many [] ready)
    [(testing/nat "batch observer installs" 1 (either/is_ok cached))
     (testing/nat "batch observer initially reads both values" 3 (overlay_cache/value (goo_runtime/record .x output ready).fall(myth/new)).fil.fall(myth/new).nat_at(['value] 0))
     (testing/nat "batch is one native commit before reactions" ready.local.top.inc committed.local.top)
     (testing/nat "both changed records are visible in the same commit" 20 (goo_runtime/record .x b committed).fall(myth/new).nat_at(['value] 0))
     (testing/nat "existing native subscriptions see complete batch" 30 sum)
     (testing/nat "owner-index action preserves ordinary transaction results" 1 (equal indexed_state next))
     (testing/nat "incremental index equals native reconstructed index" 1 (equal index (sovereign_hive indexed_state)))
     (testing/nat "removing a watcher preserves the native crew bindings" 1 (equal removed_index.tap (sovereign_hive removed).tap))
     (testing/nat "removed subscription cannot resurrect its former subject" 1 (maybe/is_none (goo_runtime/record .x output later)))
     (testing/nat "foreign target rejects entire batch" 1 (either/is_err rejected))
     (testing/nat "missing second target rejects entire batch" 1 (either/is_err missing))
     (testing/nat "failed batch leaves original subject unchanged" 1 (goo_runtime/record .x a ready).fall(myth/new).nat_at(['value] 0))
     (testing/nat "empty batch does not create history" 1 (equal (either/ok_val empty) ready))]
  + installed
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      target=path [state.self 'app 'installed]
      card (myth/sing ['sys 'req] (pails/t "Before"))
      child target.snoc('child)
      state (either/ok_val (grove_install/mount target
        [[target card] [child (myth/sing ['sys 'content] (pails/t "Keep me"))]] state))
      original (goo_runtime/record .x target state).fall(myth/new)
      query query.set_target(target).set_subject(target).set_expected((state.case(.x target)).fall(0)).set_displayed((state.case(.y target)).fall(0))
      reinstalled (either/ok_val (grove_install/change target
        (writ/make original.put(['sys 'req] (pails/t "After"))) state))
      [changed status _] (goo_runtime/run query state)
      current (goo_runtime/record .x target changed).fall(myth/new)
      again query.set_expected((changed.case(.x target)).fall(0)).set_displayed((changed.case(.y target)).fall(0))
      [unchanged same_status _] (goo_runtime/run again changed)
      removed (goo_runtime/change target original original.del(['sys 'req]) state)
    [(testing/nat "installed subject accepts edit" 200 status)
     (testing/text "replacement reproduces seed restoration" "Before" (goo_runtime/record .x target reinstalled).fall(myth/new).txt_at(['sys 'req]))
     (testing/text "editing installed root does not replay template defaults" "After" (current.txt_at(['sys 'req])))
     (testing/nat "installed behavior remains attached" 1 (equal current.get(limb_slot) original.get(limb_slot)))
     (testing/nat "installation provenance is preserved" 1 (equal current.get(pact/slot) original.get(pact/slot)))
     (testing/text "shared child survives root edit" "Keep me" (goo_runtime/record .x child changed).fall(myth/new).txt_at(['sys 'content]))
     (testing/nat "unchanged action does not append history" 1 (equal unchanged changed))
     (testing/nat "formed slot removal is explicit rather than silently restored" 1 (either/is_err removed))]
  + handlers
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      action=path [($x 17) 'gov 'interactive 'finish]
      current (goo_runtime/record .x query.target state).fall(myth/new)
      invoke
        \ args=myth current=myth
        ^ maybe[myth]
        < held args.get(['grade])
        ?> grade=goo_runtime_checks/grade held .none
        | ./some current.put(['done] (pails/b .true))
      state (fixture/grove_template_checks/seed action
        (note/make (myth/sing ['sys 'grove 'action_handler] (grove_action_handler invoke))) state)
      ref (rex/quip (str/cat_all ["'" (path_show action)]))
      constants (myth/sing ['grade 'good] (goo_runtime_checks/grade))
      published (myth/sing grove_view_publication/constants_slot (grove_view_constants constants))
      value (goo_runtime/argument published [] 0 ['grade] (rex/quip "'/grade/good"))
      args (myth/sing ['grade] (either/ok_val value))
      success (goo_runtime/dispatch ref args current lash/new state)
      rejected (goo_runtime/dispatch ref myth/new current lash/new state)
      explode
        \ args=myth current=myth
        ^ maybe[myth]
        | Seq[maybe[myth]] (error (pails/t "Intentional action failure")) .none
      broken (fixture/grove_template_checks/seed action
        (note/poke (myth/sing ['sys 'grove 'action_handler] (grove_action_handler explode))) state)
      failed (goo_runtime/dispatch ref args current lash/new broken)
    [(testing/nat "nominal constant retains its brand" 1 (equal (either/ok_val value) (goo_runtime_checks/grade)))
     (testing/nat "compiled handler applies typed argument" 1 (either/ok_val success).has(['done]))
     (testing/nat "handler rejects missing typed argument" 1 (either/is_err rejected))
     (testing/nat "thrown action error is caught" 1 (either/is_err failed))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      prepared (goo_runtime/prepare query state)
      published (either/ok_val (goo_runtime/published (goo_runtime/record .y query.view state).fall(myth/new)))
      current (goo_runtime/record .x query.target state).fall(myth/new)
      rejected (goo_runtime/matching_view published.set_result((./err (grove/error/syntax rex/zero_span "Expected an exact slot path."))) current)
      diagnostic=str
        ? rejected
         > (./err message) message
        "missing"
      [next status body] (goo_runtime/run query state)
      [stale stale_status message] (goo_runtime/run query next)
      [missing missing_status message] (goo_runtime/run query.set_inputs([]) state)
      [unknown unknown_status message] (goo_runtime/run query.set_control([9]) state)
      [recompiled recompiled_status message] (goo_runtime/run query.set_publication(query.publication.inc) state)
      [wrong wrong_status message] (goo_runtime/run query.set_subject([($x 17) 'app 'other]) state)
      parsed (goo_runtime_checks/expression (str/join (str/from_atom 10)
        ["{" "  '/sys/req = .input(card.req)" "  '/sys/res = .input(card.res)" "}"]))
      form (goo_runtime/arguments myth/new [["/sys/req" "Prompt"] ["/sys/res" "Response"]] 0 (goo_runtime/fields parsed))
      provider (goo_runtime/argument myth/new [] 0 ['sys 'now] (goo_runtime_checks/expression ".provider"))
      context (grove_views/context [($x 17) 'gov 'srs] (grove/document .nil)
        (\ ignored=path (maybe/none[myth])) .nil .nil .nil)
      resolved (grove_views/interaction_reference context (goo_runtime_checks/expression "%/grade/again"))
      due=nat
        ?> (./ok held) provider 0
        ?> value=pails/dm held 0
        value.n
    [(testing/nat "action can be assessed before committing" 1 (either/is_ok prepared))
     (testing/text "view rejection retains actionable native diagnostic"
       (str/cat_all ["View " (path_show published.view.name) " at 0:0: Expected an exact slot path."]) diagnostic)
     (testing/text "prepared action retains exact original record" "Before" (either/ok_val prepared).before.txt_at(['sys 'req]))
     (testing/text "prepared action contains proposed result" "After" (either/ok_val prepared).after.txt_at(['sys 'req]))
     (testing/nat "prepared action preserves exact native target" 1 (equal[path] query.target (either/ok_val prepared).target))
     (testing/nat "nested local case resolves as a complete path" 1
       (equal (goo_runtime/read_path resolved) (maybe/some[path] [($x 17) 'gov 'srs 'grade 'again])))
     (testing/nat "multiline input bindings parse" 2 (goo_runtime/fields parsed).len)
     (testing/text "multiline input binding value" "Response" (either/ok_val form).txt_at(['sys 'res]))
     (testing/nat "different concrete object rejected" 409 wrong_status)
     (testing/nat "different concrete object leaves state intact" 1 (equal wrong state))
     (testing/nat "editable view saves through namespace" 200 status)
     (testing/text "saved value" "After" (goo_runtime/record .x query.target next).fall(myth/new).txt_at(['sys 'req]))
     (testing/nat "stale submission rejected" 409 stale_status)
     (testing/nat "stale submission does not mutate" 1 (equal stale next))
     (testing/nat "missing input rejected" 409 missing_status)
     (testing/nat "missing input rolls back" 1 (equal missing state))
     (testing/nat "unknown control rejected" 409 unknown_status)
     (testing/nat "unknown control rolls back" 1 (equal unknown state))
     (testing/nat "changed publication rejected" 409 recompiled_status)
     (testing/nat "changed publication rolls back" 1 (equal recompiled state))
     (testing/nat "provider uses Apollo timestamp epoch" (quip_val '@1970.1.1..0.0.0) due)]

+ tests
  ^ row[testing/case]
  [(testing/case "Goo interaction dispatch" goo_runtime_checks/checks)
   (testing/case "Native multi-subject transaction" goo_runtime_checks/batches)
   (testing/case "Goo actions over installed subjects" goo_runtime_checks/installed)
   (testing/case "Typed action invocation" goo_runtime_checks/handlers)]
