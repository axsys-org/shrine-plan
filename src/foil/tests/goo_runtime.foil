- system_vocabulary
- goo_runtime
- testing
- tests/grove_install [at=installer]
- tests/grove_template [at=fixture]

+ goo_runtime_checks
  + expression
    \ text=str
    ^ rex
    | rex/normalize (either/ok_val (rex/parse text))
  + setup
    \ ignored=unit
    ^ [namespace goo_runtime/request]
    = target=path [($x 17) 'app 'interactive]
      view_path=path [($x 17) 'gov 'interactive 'edit]
      input (rex/rune "=" [(rex/quip "'/sys/req") (goo_runtime_checks/expression ".input(card.req)")])
      group (goo/node rex/zero_span "group" (((list/one[rex] (rex/rune "=" [(rex/word "myth") (rex/expr rex/zero_span "curly" [input])])).cons((rex/rune "=" [(rex/word "action") (goo_runtime_checks/expression ".poke")]))).cons((rex/rune "=" [(rex/word "on") (rex/word "card")]))) (list/one (goo/node rex/zero_span "action" (list/one[rex] (rex/cord "Save")) .nil)))
      view (goo/view rex/zero_span view_path ['role] ['sys 'slot 'edit] "card" (list/one group) .false .nil)
      contract (grove_role_runtime/spec [[system_vocabulary/req (curb/of_type (^ pails/t))]] [[system_vocabulary/req]])
      published (goo/published view .nil contract (./ok view))
      state (installer/grove_install_checks/bootstrap [])
      state (fixture/grove_template_checks/seed view_path
        (note/make (myth/sing system_vocabulary/grove/view published)) state)
      state (fixture/grove_template_checks/seed target
        (note/make (myth/sing system_vocabulary/req (pails/t "Before"))) state)
      query (goo_runtime/request "act" target target view_path [0 0]
        (state.case(.x target)).fall(0) (state.case(.y target)).fall(0)
        (goo_runtime/publication state) [["/sys/req" "After"]] 0)
    [state query]
  + make_setup
    \ destination=rex
    ^ [namespace goo_runtime/request]
    = [state query] (goo_runtime_checks/setup [])
      role_path=path [($x 17) 'gov 'interactive 'new_role]
      record (goo_runtime/record .x query.view state).fall(myth/new)
      published (either/ok_val (goo_runtime/published record))
      group published.view.children.head
      args (group.arguments.keep((\ arg (and (maybe/is_none (goo_runtime/named "on" (list/one arg))) (maybe/is_none (goo_runtime/named "action" (list/one arg)))))))
      args args.snoc((rex/rune "=" [(rex/word "make") destination]))
      args args.snoc((rex/rune "=" [(rex/word "role") (rex/quip (str/cat_all ["'" (path_show role_path)]))]))
      view published.view.set_children((list/one group.set_arguments(args)))
      published published.set_view(view).set_result((./ok view)).set_fields((list/one (goo/field "about" system_vocabulary/about ['lib 'grove 'types 'path] .true)))
      state (fixture/grove_template_checks/seed query.view (note/make record.put(system_vocabulary/grove/view published)) state)
      state (fixture/grove_template_checks/seed role_path (note/make (myth/sing system_vocabulary/grove/role_contract published.contract)) state)
      state (fixture/grove_template_checks/seed query.target (note/poke (myth/sing system_vocabulary/about (pails/p [($x 17) 'app 'new_card]))) state)
      query query.set_expected((state.case(.x query.target)).fall(0)).set_displayed((state.case(.y query.target)).fall(0)).set_publication((goo_runtime/publication state))
    [state query]
  + creation
    \ ignored=unit
    ^ row[testing/check]
    = destination=path [($x 17) 'app 'new_card]
      [state query] (goo_runtime_checks/make_setup (rex/quip "'/0x11/app/new_card"))
      [created status body] (goo_runtime/run query state)
      [occupied occupied_status body] (goo_runtime/run query created)
      [missing missing_status body] (goo_runtime/run query.set_inputs([]) state)
      [dynamic dynamic_query] (goo_runtime_checks/make_setup (goo_runtime_checks/expression "card.about"))
      [dynamic_next dynamic_status body] (goo_runtime/run dynamic_query dynamic)
      [foreign foreign_query] (goo_runtime_checks/make_setup (rex/quip "'/0x12/app/new_card"))
      [foreign_next foreign_status body] (goo_runtime/run foreign_query foreign)
      child (fixture/grove_template_checks/seed destination.snoc('child) (note/make myth/new) state)
      [blocked blocked_status body] (goo_runtime/run query child)
      role_path=path [($x 17) 'gov 'interactive 'new_role]
      stricter (grove_role_runtime/spec [[system_vocabulary/res (curb/of_type (^ pails/t))]] [[system_vocabulary/res]])
      invalid (fixture/grove_template_checks/seed role_path (note/make (myth/sing system_vocabulary/grove/role_contract stricter)) state)
      invalid_query query.set_publication((goo_runtime/publication invalid))
      [invalid_next invalid_status body] (goo_runtime/run invalid_query invalid)
      retry_query query.set_inputs(query.inputs.snoc(["$invocation" "create-once"]))
      [once once_status once_body] (goo_runtime/run retry_query state)
      [twice twice_status twice_body] (goo_runtime/run retry_query once)
    [(testing/nat "make creates absent destination" 200 status)
     (testing/text "make installs supplied fields" "After" (goo_runtime/record .x destination created).fall(myth/new).txt_at(system_vocabulary/req))
     (testing/text "make preserves presenting receiver" "Before" (goo_runtime/record .x query.target created).fall(myth/new).txt_at(system_vocabulary/req))
     (testing/nat "make does not install a Grove pact" 0 (goo_runtime/record .x destination created).fall(myth/new).has(['pact]))
     (testing/nat "make attaches role contract" 1 (goo_runtime/record .x destination created).fall(myth/new).has(system_vocabulary/lash))
     (testing/nat "make rejects occupied destination" 409 occupied_status)
     (testing/nat "occupied rejection preserves state" 1 (equal occupied created))
     (testing/nat "make rejects missing inputs" 409 missing_status)
     (testing/nat "missing input rolls back creation" 1 (equal missing state))
     (testing/nat "make resolves receiver path field" 200 dynamic_status)
     (testing/nat "make rejects foreign authority" 409 foreign_status)
     (testing/nat "foreign authority rejection preserves state" 1 (equal foreign foreign_next))
     (testing/nat "make rejects occupied subtree" 409 blocked_status)
     (testing/nat "subtree rejection preserves state" 1 (equal child blocked))
     (testing/nat "make enforces destination role" 409 invalid_status)
     (testing/nat "role rejection preserves state" 1 (equal invalid invalid_next))
     (testing/nat "make retry returns success" 200 twice_status)
     (testing/nat "make retry does not repeat write" 1 (equal once twice))]
  + grade
    :
  + handlers
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      action=path [($x 17) 'gov 'interactive 'finish]
      current (goo_runtime/record .x query.target state).fall(myth/new)
      invoke
        \ args=myth current=myth
        ^ maybe[myth]
        < held args.get(['grade])
        ?> grade=goo_runtime_checks/grade held .none
        | ./some current.put(['done] (pails/b .true))
      state (fixture/grove_template_checks/seed action
        (note/make (myth/sing system_vocabulary/grove/action_handler (grove_action_handler invoke))) state)
      ref (rex/quip (str/cat_all ["'" (path_show action)]))
      constants (myth/sing ['grade 'good] (goo_runtime_checks/grade))
      published (myth/sing grove_view_publication/constants_slot (grove_view_constants constants))
      value (goo_runtime/argument published [] 0 ['grade] (rex/quip "'/grade/good"))
      args (myth/sing ['grade] (either/ok_val value))
      success (goo_runtime/dispatch ref args current lash/new state)
      rejected (goo_runtime/dispatch ref myth/new current lash/new state)
      explode
        \ args=myth current=myth
        ^ maybe[myth]
        | Seq[maybe[myth]] (error (pails/t "Intentional action failure")) .none
      broken (fixture/grove_template_checks/seed action
        (note/poke (myth/sing system_vocabulary/grove/action_handler (grove_action_handler explode))) state)
      failed (goo_runtime/dispatch ref args current lash/new broken)
    [(testing/nat "nominal constant retains its brand" 1 (equal (either/ok_val value) (goo_runtime_checks/grade)))
     (testing/nat "compiled handler applies typed argument" 1 (either/ok_val success).has(['done]))
     (testing/nat "handler rejects missing typed argument" 1 (either/is_err rejected))
     (testing/nat "thrown action error is caught" 1 (either/is_err failed))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      [next status body] (goo_runtime/run query state)
      [stale stale_status message] (goo_runtime/run query next)
      [missing missing_status message] (goo_runtime/run query.set_inputs([]) state)
      [unknown unknown_status message] (goo_runtime/run query.set_control([9]) state)
      [recompiled recompiled_status message] (goo_runtime/run query.set_publication(query.publication.inc) state)
      [wrong wrong_status message] (goo_runtime/run query.set_subject([($x 17) 'app 'other]) state)
      parsed (goo_runtime_checks/expression (str/join (str/from_atom 10)
        ["{" "  '/sys/req = .input(card.req)" "  '/sys/res = .input(card.res)" "}"]))
      form (goo_runtime/arguments myth/new [["/sys/req" "Prompt"] ["/sys/res" "Response"]] 0 (goo_runtime/fields parsed))
      provider (goo_runtime/argument myth/new [] 0 system_vocabulary/now (goo_runtime_checks/expression ".provider"))
      context (grove_views/context [($x 17) 'gov 'srs] (grove/document .nil)
        (\ ignored=path (maybe/none[myth])) .nil .nil .nil)
      resolved (grove_views/interaction_reference context (goo_runtime_checks/expression "%/grade/again"))
      due=nat
        ?> (./ok held) provider 0
        ?> value=pails/dm held 0
        value.n
    [(testing/nat "nested local case resolves as a complete path" 1
       (equal (goo_runtime/read_path resolved) (maybe/some[path] [($x 17) 'gov 'srs 'grade 'again])))
     (testing/nat "multiline input bindings parse" 2 (goo_runtime/fields parsed).len)
     (testing/text "multiline input binding value" "Response" (either/ok_val form).txt_at(system_vocabulary/res))
     (testing/nat "different concrete object rejected" 409 wrong_status)
     (testing/nat "different concrete object leaves state intact" 1 (equal wrong state))
     (testing/nat "editable view saves through namespace" 200 status)
     (testing/text "saved value" "After" (goo_runtime/record .x query.target next).fall(myth/new).txt_at(system_vocabulary/req))
     (testing/nat "stale submission rejected" 409 stale_status)
     (testing/nat "stale submission does not mutate" 1 (equal stale next))
     (testing/nat "missing input rejected" 409 missing_status)
     (testing/nat "missing input rolls back" 1 (equal missing state))
     (testing/nat "unknown control rejected" 409 unknown_status)
     (testing/nat "unknown control rolls back" 1 (equal unknown state))
     (testing/nat "changed publication rejected" 409 recompiled_status)
     (testing/nat "changed publication rolls back" 1 (equal recompiled state))
     (testing/nat "provider uses Apollo timestamp epoch" (quip_val '@1970.1.1..0.0.0) due)]

  + tree_pages
    \ ignored=unit
    ^ row[testing/check]
    = [initial query] (goo_runtime_checks/setup [])
      source=path [initial.self 'app 'wide]
      initial (fixture/grove_template_checks/seed source (note/make myth/new) initial)
      state=namespace
        % index=nat 0 state=namespace initial
        ? (eq index 80) state
        | _ index.inc (fixture/grove_template_checks/seed source.snoc(($u index)) (note/make myth/new) state)
      branch=path source.snoc(($u 0))
      state (fixture/grove_template_checks/seed branch.snoc('leaf) (note/make myth/new) state)
      query query.set_target(source).set_inputs([["$axis" "z"]])
      first (goo_runtime/tree_page query state)
    ? (either/is_err first) [(testing/text "tree page succeeds" "success" (either/err_val first))]
    = decode
        \ body=str
        ^ json
        ?> (jres/ok value rest) (parse body) jnull
        value
      items
        \ value=json
        ^ row[json]
        ?> (json/arr values) (goo_runtime/json_field "members" value) []
        values
      first (decode (either/ok_val first))
      epoch (goo_runtime/json_text (goo_runtime/json_field "epoch" first))
      cursor (goo_runtime/json_text (goo_runtime/json_field "next" first))
      inputs=row[[str str]] [["$axis" "z"] ["$parent" (path_show source)] ["$after" cursor] ["$epoch" epoch]]
      second (goo_runtime/tree_page query.set_inputs(inputs) state)
    ? (either/is_err second) [(testing/text "continuation succeeds" "success" (either/err_val second))]
    = second (decode (either/ok_val second))
      children (goo_runtime/tree_page query.set_inputs([["$axis" "z"] ["$parent" (path_show branch)] ["$epoch" epoch]]) state)
    ? (either/is_err children) [(testing/text "branch load succeeds" "success" (either/err_val children))]
    = children (decode (either/ok_val children))
      selected (items second).at(0)
      captured=row[[str str]] [["/selected" (show (json/obj [(jkv "member" selected)]))]]
      expression (goo_runtime_checks/expression ".capture('/current)")
      fields (list/one (rex/rune "=" [(rex/quip "'/selected") expression]))
      raw_source=path [state.self 'app 'opaque]
      raw_state=namespace
        % index=nat 0 current=namespace state
        ? (eq index 65) current
        = key=iota ($ts (cord/cat "-raw-" (nat/show index)))
        | _ index.inc (fixture/grove_template_checks/seed raw_source.snoc(key) (note/make myth/new) current)
      raw_query query.set_target(raw_source).set_inputs([])
      raw_first (decode (either/ok_val (goo_runtime/tree_page raw_query raw_state)))
      raw_cursor (goo_runtime/json_text (goo_runtime/json_field "next" raw_first))
      raw_epoch (goo_runtime/json_text (goo_runtime/json_field "epoch" raw_first))
      raw_next (decode (either/ok_val (goo_runtime/tree_page raw_query.set_inputs([["$parent" (path_show raw_source)] ["$after" raw_cursor] ["$epoch" raw_epoch]]) raw_state)))
    [(testing/nat "first page includes root and 64 direct children" 65 (items first).len)
     (testing/nat "second page contains remaining direct children" 16 (items second).len)
     (testing/nat "complete page has no continuation" 1 (equal (goo_runtime/json_field "next" second) jnull))
     (testing/nat "closed branch keeps disclosure hint" 1 (equal (goo_runtime/json_field "hasChildren" (items first).at(1)) (json/boo .true)))
     (testing/nat "expansion loads only immediate children" 1 (items children).len)
     (testing/nat "loaded descendant capture in a large source is valid" 1 (either/is_ok (goo_runtime/validate_captures captured fields state)))
     (testing/nat "stale page epoch is rejected" 1 (either/is_err (goo_runtime/tree_page query.set_inputs([["$epoch" "0"]]) state)))
     (testing/nat "continuation requires epoch" 1 (either/is_err (goo_runtime/tree_page query.set_inputs([["$after" cursor]]) state)))
     (testing/nat "parent cannot escape root" 1 (either/is_err (goo_runtime/tree_page query.set_inputs([["$parent" "/outside"]]) state)))
     (testing/nat "cursor cannot escape parent" 1 (either/is_err (goo_runtime/tree_page query.set_inputs([["$after" "/outside/child"] ["$epoch" epoch]]) state)))
     (testing/nat "unspellable keys leave a navigable root" 1 (items raw_first).len)
     (testing/nat "unspellable keys are counted per bounded page" 1 (equal (goo_runtime/json_field "omitted" raw_first) (json/num .false 64)))
     (testing/nat "opaque cursor roundtrips" 1 (maybe/is_some (physical_key/decode raw_cursor)))
     (testing/nat "opaque continuation advances past unspellable keys" 1 (equal (goo_runtime/json_field "omitted" raw_next) (json/num .false 1)))
     (testing/nat "opaque continuation terminates" 1 (equal (goo_runtime/json_field "next" raw_next) jnull))]

  + captures
    \ ignored=unit
    ^ row[testing/check]
    = [state query] (goo_runtime_checks/setup [])
      source=path [state.self 'app 'cards]
      subject=path source.snoc('a)
      state (fixture/grove_template_checks/seed source (note/make myth/new) state)
      state (fixture/grove_template_checks/seed subject (note/make (myth/sing system_vocabulary/req (pails/t "A"))) state)
      source_body (goo_runtime/source query.set_target(source) state)
      source_json=json
        ?> (jres/ok value rest) (parse source_body) jnull
        value
      source_count=nat
        ?> (json/arr members) (goo_runtime/json_field "members" source_json) 0
        members.len
      captured (show (json/obj [(jkv "member" (goo_runtime/member source subject state))]))
      expression (goo_runtime_checks/expression ".capture('/current)")
      fields (list/one (rex/rune "=" [(rex/quip "'/selected") expression]))
      input=row[[str str]] [["/selected" captured]]
      selection_args (list/one[rex] (rex/quip "'/current"))
      selection_args selection_args.snoc((rex/rune "=" [(rex/word "source") (rex/quip (str/cat_all ["'" (path_show source)]))]))
      selection (goo/node rex/zero_span "selection" selection_args
        (list/one (goo/node rex/zero_span "action" .nil .nil)))
      grandchild=path subject.snoc('nested)
      tree_state (fixture/grove_template_checks/seed grandchild (note/make myth/new) state)
      tree_json=json
        ?> (jres/ok value rest) (parse (goo_runtime/tree_source query.set_target(source) tree_state)) jnull
        value
      tree_members=row[json]
        ?> (json/arr members) (goo_runtime/json_field "members" tree_json) []
        members
      axis_members
        \ axis=str
        ^ row[json]
        = body (goo_runtime/tree_source query.set_target(source).set_inputs([["$axis" axis]]) tree_state)
        ?> (jres/ok value rest) (parse body) []
        ?> (json/arr members) (goo_runtime/json_field "members" value) []
        members
      y_members (axis_members "y")
      x_members (axis_members "x")
      version (tree_state.case(.z source)).fall(0)
      history_prefix=path ['h 'z ($u version) ($u source.len)]
      historical=path history_prefix.weld(source)
      historical_json=json
        ?> (jres/ok value rest) (parse (goo_runtime/tree_source query.set_target(historical) tree_state)) jnull
        value
      historical_members=row[json]
        ?> (json/arr members) (goo_runtime/json_field "members" historical_json) []
        members
      tree_input=row[[str str]] [["/selected" (show (json/obj [(jkv "member" tree_members.at(2))]))]]
      tree_selection selection.set_arguments(selection_args.snoc((rex/rune "=" [(rex/word "topology") (rex/cord "tree")])))
      scoped (goo_runtime/bound_captures (list/one selection) [0 0] fields input)
      forged (goo_runtime/bound_captures .nil [0 0] fields input)
      valid (goo_runtime/validate_captures input fields state)
      argument (goo_runtime/argument myth/new input 0 ['selected] expression)
      changed (fixture/grove_template_checks/seed subject (note/poke (myth/sing system_vocabulary/req (pails/t "B"))) state)
      stale (goo_runtime/validate_captures input fields changed)
      removed (either/ok_val (grove_install/change subject .cull state))
      recreated (fixture/grove_template_checks/seed subject (note/make (myth/sing system_vocabulary/req (pails/t "A"))) removed)
      replaced (goo_runtime/validate_captures input fields recreated)
      empty (goo_runtime/validate_captures [] fields state)
      query query.set_inputs(query.inputs.snoc(["$invocation" "test-invocation"]))
      [next status response] (goo_runtime/run query state)
      [retry retry_status retry_response] (goo_runtime/run query.set_now(123) next)
      changed_query query.set_inputs([["/sys/req" "Different"] ["$invocation" "test-invocation"]])
      [rejected rejected_status rejected_response] (goo_runtime/run changed_query next)
    [(testing/nat "virtual historical source includes descendants" 3 historical_members.len)
     (testing/text "virtual historical member is available" "available"
       (goo_runtime/json_text (goo_runtime/json_field "status" historical_members.at(2))))
     (testing/nat "x projection is root only" 1 x_members.len)
     (testing/nat "y projection stops at nearest records" 2 y_members.len)
     (testing/text "members retain projection axis" "y" (goo_runtime/json_text (goo_runtime/json_field "axis" y_members.at(1))))
     (testing/nat "tree source includes root and nested members" 3 tree_members.len)
     (testing/text "tree source retains immediate parent" (path_show subject)
       (goo_runtime/json_text (goo_runtime/json_field "parent" tree_members.at(2))))
     (testing/nat "declared tree capture admits descendant" 1
       (either/is_ok (goo_runtime/bound_captures (list/one tree_selection) [0 0] fields tree_input)))
     (testing/nat "capture cannot forge projection axis" 1
       (either/is_err (goo_runtime/bound_captures
         (list/one tree_selection.set_arguments(tree_selection.arguments.snoc((rex/rune "=" [(rex/word "axis") (rex/cord "y")])))) [0 0] fields tree_input)))
     (testing/nat "direct-child declaration rejects tree capture" 1
       (either/is_err (goo_runtime/bound_captures (list/one selection) [0 0] fields tree_input)))
     (testing/nat "tree capture validates current finite membership" 1
       (either/is_ok (goo_runtime/validate_captures tree_input fields tree_state)))
     (testing/nat "S24 capture source checked against declaration" 1 (either/is_ok scoped))
     (testing/nat "S24 forged out-of-scope capture rejected" 1 (either/is_err forged))
     (testing/nat "S01 finite source returns only actual members" 1 source_count)
     (testing/nat "S24 typed capture evidence validates" 1 (either/is_ok valid))
     (testing/nat "S23 selection normalizes to concrete path codec" 1 (equal (either/ok_val argument) (pails/p subject)))
     (testing/nat "S24 stale captured data rejected" 1 (either/is_err stale))
     (testing/nat "S09 live data revision preserves subject lifetime" (goo_runtime/lifetime subject state) (goo_runtime/lifetime subject changed))
     (testing/nat "S09 recreated subject rejects old membership" 1 (either/is_err replaced))
     (testing/nat "S24 empty capture rejected" 1 (either/is_err empty))
     (testing/nat "S24 ordinary action with invocation id commits" 200 status)
     (testing/nat "S24 retry returns success" 200 retry_status)
     (testing/nat "S24 retry does not edit namespace again" 1 (equal retry next))
     (testing/text "S24 retry retains original response" response retry_response)
     (testing/nat "S24 changed payload cannot reuse identity" 409 rejected_status)
     (testing/nat "S24 conflicting retry cannot mutate" 1 (equal rejected next))]

+ tests
  ^ row[testing/case]
  [(testing/case "Selection capture and invocation retry" goo_runtime_checks/captures)
   (testing/case "Goo interaction dispatch" goo_runtime_checks/checks)
   (testing/case "Typed action invocation" goo_runtime_checks/handlers)]
