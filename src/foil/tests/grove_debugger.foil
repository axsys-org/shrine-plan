- debugger_contract
- web
- grove_install
- eden
- testing
+ debugger_fixture
  + request
    \ target=str
    ^ myth
    = workspace
        | weft/node/el "sh-triptych"
          [(weft/att "data-path" (str/to_atom target))]
          [(weft/node/el "main" [(weft/att "slot" "content")]
            [(weft/tx "Declaration fixture")])]
    | (myth/new).put(['authority] (pails/p [($x 17)])).put(['target] (pails/t target)).put(['workspace] workspace)
  + render
    \ component=myth
    ^ nat
    > (./some output) (grove_fragment/render component (debugger_fixture/request "/"))
      | error (pails/t "Missing declared debugger output")
    | weft/render output
  + invalid
    \ component=myth
    ^ bool
    > (./some held) component.get(['sys 'weft])
      .false
    > transform=spun held
      .false
    ? (Try (transform.get (myth/new)) (axal/new[myth] (./some (myth/new))))
     > (./err _) .true
     > (./ok _) .false
  + details
    \ component=myth
    ^ nat
    = version
        . (myth/new)
          put(publisher_vocabulary/version/x_data (pails/t "900719925474099312345"))
          put(publisher_vocabulary/version/x_shape (pails/t "0"))
          put(publisher_vocabulary/version/y_data (pails/t "0"))
          put(publisher_vocabulary/version/state (pails/t "live"))
          put(publisher_vocabulary/version/top (pails/t "0"))
      input
        . (myth/new)
          put(['target] (pails/t "/hello"))
          put(['version] (grove_record version))
          put(['reference] (weft/node/el "div" [] [(weft/tx "Authored definition")]))
    > (./some output) (grove_fragment/render component input)
      | error (pails/t "Missing inspector output")
    | weft/render output
  + data
    ^ grove_debug_data
    = card
        . (myth/new)
          put(['sys 'lede] (pails/t "Hello namespace"))
          put(['message] (pails/t "An authored slot"))
          put(['zero] (pails/n 0))
    | grove_debug_data ['hello] (axal/new[myth] (./some card))
      (axal/new[myth] .none) [] .none .false 'document .none
  + page
    \ app=grove_app/binding
    ^ nat
    = data debugger_fixture/data
    > (./some output) (grove_app/render app (debugger/inputs app.authority data))
      | error (pails/t "Missing declared page output")
    | weft/render output

  + document
    \ app=grove_app/binding
    ^ nat
    | debugger/render_declared app debugger_fixture/data

  + application
    \ published=namespace source=path root=path
    ^ maybe[grove_app/binding]
    ' The host supplies a real published namespace; no listener is started.
    ?> (./some version) (namespace/case .x source published)
      .none
    = installation (grove_install/instantiate source version root published)
    ?> (./ok installed) installation
      ? installation
       > (./err reason) (Trace reason (maybe/none[grove_app/binding]))
       > (./ok _) .none
    = app (grove_app/capture root.snoc('page) installed)
    ? (maybe/is_some app) app
    | Trace "debugger fixture capture failed" (maybe/none[grove_app/binding])

  + application_checks
    \ app=grove_app/binding second=grove_app/binding
    ^ bool
    = fields app.fields.fields
      values (debugger/inputs app.authority debugger_fixture/data)
      first (grove_app/project app.fields values)
      other (grove_app/project second.fields values)
      malformed values.put(['scope] (pails/p ['invalid]))
      rejected
        ? (Try (grove_app/render app) malformed)
         > (./err _) .true
         > (./ok _) .false
      missing_rejected
        ? (Try (grove_app/render app) values.del(['target]))
         > (./err _) .true
         > (./ok _) .false
    ? !(eq fields.len 9) .false
    ? !(eq first.size 7) .false
    ? first.has(['data]) .false
    ? !(equal[myth] first other) .false
    ? !rejected .false
    ? !missing_rejected .false
    | eq (debugger_fixture/page app) (debugger_fixture/page second)

  + replace
    \ name=path card=myth state=namespace
    ^ maybe[namespace]
    = change (axal/new[note] .none).put(name (note/make card))
    ? (namespace/step change 0 0 state)
     > (./accepted committed) (./some committed.state)
     > (./rejected _) .none

  + capture_checks
    \ state=namespace entry=path
    ^ bool
    ?> (./some original) (grove_app/capture entry state) .false
    ?> (./some page) (sovereign_peek entry state).fil .false
    ?> (./some held) page.get(['sys 'weft]) .false
    ?> renderer=safe held .false
    ?> (./known code) (sovereign_view .x renderer.ver renderer.path state) .false
    ?> (./some component) code.fil .false
    ?> (./some held) component.get(publisher_vocabulary/grove/sewn) .false
    ?> boundary=grove_sewn_schema held .false
    ?> (./some norm) (sovereign_peek boundary.source state).fil .false
    ?> (./some earlier) state.case(.x boundary.source) .false
    ' Evolve the source norm's ordinary published metadata independently of
    ' the installed renderer. An empty role would erase all request inputs.
    = incompatible boundary.source_schema.set_item((grove_role_schema [] []))
      declaration norm.put(publisher_vocabulary/grove/norm incompatible)
    ?> (./some revised) (debugger_fixture/replace boundary.source declaration state) .false
    ?> (./some later) revised.case(.x boundary.source) .false
    ? !(gt later earlier) .false
    ?> (./some captured) (grove_app/capture entry revised) .false
    ? !(equal original.fields captured.fields) .false
    ? !(eq (debugger_fixture/page original) (debugger_fixture/page captured)) .false
    ' Request overlays are isolated: rendering a different target must not
    ' become the installed input or leak into the next request.
    = values (debugger/inputs captured.authority debugger_fixture/data)
      other values.put(['target] (pails/p ['other]))
    ?> (./some first) (grove_app/render captured values) .false
    ?> (./some second) (grove_app/render captured other) .false
    ? (eq (weft/render first) (weft/render second)) .false
    ?> (./some again) (grove_app/render captured values) .false
    ? !(eq (weft/render first) (weft/render again)) .false
    ' Do not rescue missing compiled metadata with the latest norm. A newly
    ' selected renderer without its boundary must fail capture closed.
    = missing component.del(publisher_vocabulary/grove/sewn)
    ?> (./some changed) (debugger_fixture/replace renderer.path missing revised) .false
    ?> (./some version) changed.case(.x renderer.path) .false
    = selected page.put(['sys 'weft] (safe version .x renderer.path))
    ?> (./some selected) (debugger_fixture/replace entry selected changed) .false
    | !(maybe/is_some (grove_app/capture entry selected))

  + values
    ^ myth
    = base=myth myth/new
    | base.gas
      [[['text] (pt "hello")]
       [['long] (pt (str/repeat 2047 "a").cat("€tail"))]
       [['threshold] (pt (str/repeat 2048 "a"))]
       [['body] (pd (str/to_atom (str/repeat 1025 "b")))]
       [['nul] (pt (str/from_atom (add 65 (mul 65536 66))))]
       [['invalid] (pt (str/from_atom 255))]
       [['zero] (pd 0)]
       [['huge] (pd (bex 2048))]
       [['opaque] (pails/p ['other])]
       [['a 'b] (pt "opaque slot key")]]

  + failures
    \ cases=row[testing/case]
    ^ row[str]
    % pending=row[testing/case] cases failed=row[str] []
    ? (eq pending.len 0) failed
    = run pending.at(0).run
      checks (run (unit))
      failed
        % rest=row[testing/check] checks out=row[str] failed
        ? (eq rest.len 0) out
        = check rest.at(0)
        | _ rest.drop(1) (? check.pass out out.snoc(check.name))
    | _ pending.drop(1) failed
