- debugger_contract
- web
- testing
+ debugger_fixture
  + request
    \ target=str
    ^ myth
    = workspace
        | weft/node/el "sh-triptych"
          [(weft/att "data-path" (str/to_atom target))]
          [(weft/node/el "main" [(weft/att "slot" "content")]
            [(weft/tx "Declaration fixture")])]
    | (myth/new).put(['target] (pails/t target)).put(['workspace] workspace)
  + render
    \ component=myth
    ^ nat
    > (./some output) (grove_fragment/render component (debugger_fixture/request "/"))
      | error (pails/t "Missing declared debugger output")
    | weft/render output
  + invalid
    \ component=myth
    ^ bool
    > (./some held) component.get(['sys 'weft])
      .false
    > transform=spun held
      .false
    ? (Try (transform.get (myth/new)) (axal/new[myth] (./some (myth/new))))
     > (./err _) .true
     > (./ok _) .false
  + details
    \ component=myth
    ^ nat
    = version
        . (myth/new)
          put(['x_data] (pails/t "900719925474099312345"))
          put(['x_shape] (pails/t "0"))
          put(['y_data] (pails/t "0"))
          put(['state] (pails/t "live"))
          put(['top] (pails/t "0"))
      input
        . (myth/new)
          put(['target] (pails/t "/hello"))
          put(['version] (grove_record version))
          put(['reference] (weft/node/el "div" [] [(weft/tx "Authored definition")]))
    > (./some output) (grove_fragment/render component input)
      | error (pails/t "Missing inspector output")
    | weft/render output
  + data
    ^ grove_debug_data
    = card
        . (myth/new)
          put(['sys 'lede] (pails/t "Hello namespace"))
          put(['message] (pails/t "An authored slot"))
          put(['zero] (pails/n 0))
    | grove_debug_data ['hello] (axal/new[myth] (./some card))
      (axal/new[myth] .none) [] .none .false 'document .none
  + page
    \ component=myth
    ^ nat
    = data debugger_fixture/data
    > (./some output) (grove_fragment/render component ((myth/new).put(['data] data)))
      | error (pails/t "Missing declared page output")
    | weft/render output

  + document
    \ records=row[[path myth]]
    ^ nat
    = components
        % rest=row[[path myth]] records tree=axal[myth] (axal/new[myth] .none)
        ? (eq rest.len 0) tree
        = [path card] rest.at(0)
        | _ rest.drop(1) tree.put(path.drop(3) card)
    | debugger/render_declared components debugger_fixture/data

  + values
    ^ myth
    = base=myth myth/new
    | base.gas
      [[['text] (pt "hello")]
       [['long] (pt (str/repeat 2047 "a").cat("€tail"))]
       [['threshold] (pt (str/repeat 2048 "a"))]
       [['body] (pd (str/to_atom (str/repeat 1025 "b")))]
       [['nul] (pt (str/from_atom (add 65 (mul 65536 66))))]
       [['invalid] (pt (str/from_atom 255))]
       [['zero] (pd 0)]
       [['huge] (pd (bex 2048))]
       [['opaque] (pails/p ['other])]
       [['a 'b] (pt "opaque slot key")]]

  + failures
    \ cases=row[testing/case]
    ^ row[str]
    % pending=row[testing/case] cases failed=row[str] []
    ? (eq pending.len 0) failed
    = run pending.at(0).run
      checks (run (unit))
      failed
        % rest=row[testing/check] checks out=row[str] failed
        ? (eq rest.len 0) out
        = check rest.at(0)
        | _ rest.drop(1) (? check.pass out out.snoc(check.name))
    | _ pending.drop(1) failed
