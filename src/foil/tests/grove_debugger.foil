- debugger_contract
- web
- grove_install
- eden
- testing
+ debugger_fixture
  + request
    \ target=str
    ^ myth
    = workspace
        | weft/node/el "sh-triptych"
          [(weft/att "data-path" (str/to_atom target))]
          [(weft/node/el "main" [(weft/att "slot" "content")]
            [(weft/tx "Declaration fixture")])]
    | (myth/new).put(['target] (pails/t target)).put(['workspace] workspace)
  + render
    \ component=myth
    ^ nat
    > (./some output) (grove_fragment/render component (debugger_fixture/request "/"))
      | error (pails/t "Missing declared debugger output")
    | weft/render output
  + invalid
    \ component=myth
    ^ bool
    > (./some held) component.get(['sys 'weft])
      .false
    > transform=spun held
      .false
    ? (Try (transform.get (myth/new)) (axal/new[myth] (./some (myth/new))))
     > (./err _) .true
     > (./ok _) .false
  + details
    \ component=myth
    ^ nat
    = version
        . (myth/new)
          put(['x_data] (pails/t "900719925474099312345"))
          put(['x_shape] (pails/t "0"))
          put(['y_data] (pails/t "0"))
          put(['state] (pails/t "live"))
          put(['top] (pails/t "0"))
      input
        . (myth/new)
          put(['target] (pails/t "/hello"))
          put(['version] (grove_record version))
          put(['reference] (weft/node/el "div" [] [(weft/tx "Authored definition")]))
    > (./some output) (grove_fragment/render component input)
      | error (pails/t "Missing inspector output")
    | weft/render output
  + data
    ^ grove_debug_data
    = card
        . (myth/new)
          put(['sys 'lede] (pails/t "Hello namespace"))
          put(['message] (pails/t "An authored slot"))
          put(['zero] (pails/n 0))
    | grove_debug_data ['hello] (axal/new[myth] (./some card))
      (axal/new[myth] .none) [] .none .false 'document .none
  + page
    \ app=grove_app/binding
    ^ nat
    = data debugger_fixture/data
    > (./some output) (grove_app/render app (debugger/inputs data))
      | error (pails/t "Missing declared page output")
    | weft/render output

  + document
    \ app=grove_app/binding
    ^ nat
    | debugger/render_declared app debugger_fixture/data

  + application
    \ records=row[[path myth]] root=path
    ^ maybe[grove_app/binding]
    ' Boot constructs state only; this fixture never calls eden/serve.
    ?> (./ready initial) (eden/boot 18131)
      | Trace "debugger fixture boot failed" (maybe/none[grove_app/binding])
    = publication (grove_install/mount ['gov 'debug] records initial)
    ?> (./ok published) publication
      ? publication
       > (./err reason) (Trace reason (maybe/none[grove_app/binding]))
       > (./ok _) .none
    ?> (./some version) published.x_case(['gov 'debug])
      .none
    = installation (grove_install/instantiate ['gov 'debug] version root published)
    ?> (./ok installed) installation
      ? installation
       > (./err reason) (Trace reason (maybe/none[grove_app/binding]))
       > (./ok _) .none
    = app (grove_app/capture root.snoc('page) installed)
    ? (maybe/is_some app) app
    | Trace "debugger fixture capture failed" (maybe/none[grove_app/binding])

  + application_checks
    \ app=grove_app/binding second=grove_app/binding
    ^ bool
    = fields app.fields.fields
      values (debugger/inputs debugger_fixture/data)
      first (grove_app/project app.fields values)
      other (grove_app/project second.fields values)
      malformed values.put(['scope] (pails/p ['invalid]))
      rejected
        ? (Try (grove_app/render app) malformed)
         > (./err _) .true
         > (./ok _) .false
    ? !(eq fields.len 8) .false
    ? !(eq first.size 6) .false
    ? first.has(['data]) .false
    ? !(equal[myth] first other) .false
    ? !rejected .false
    | eq (debugger_fixture/page app) (debugger_fixture/page second)

  + values
    ^ myth
    = base=myth myth/new
    | base.gas
      [[['text] (pt "hello")]
       [['long] (pt (str/repeat 2047 "a").cat("€tail"))]
       [['threshold] (pt (str/repeat 2048 "a"))]
       [['body] (pd (str/to_atom (str/repeat 1025 "b")))]
       [['nul] (pt (str/from_atom (add 65 (mul 65536 66))))]
       [['invalid] (pt (str/from_atom 255))]
       [['zero] (pd 0)]
       [['huge] (pd (bex 2048))]
       [['opaque] (pails/p ['other])]
       [['a 'b] (pt "opaque slot key")]]

  + failures
    \ cases=row[testing/case]
    ^ row[str]
    % pending=row[testing/case] cases failed=row[str] []
    ? (eq pending.len 0) failed
    = run pending.at(0).run
      checks (run (unit))
      failed
        % rest=row[testing/check] checks out=row[str] failed
        ? (eq rest.len 0) out
        = check rest.at(0)
        | _ rest.drop(1) (? check.pass out out.snoc(check.name))
    | _ pending.drop(1) failed
