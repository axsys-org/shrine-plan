- lain_poke

' Single-store harness for low-level dispatch regressions. This is test code,
' not a runtime boot API. Production commits require namespace authority.
+  is_xeno
  '  Is this path remote (under /xeno)?
  \ p=path
  ^ bool
  p.starts('xeno)

+  is_io
  '  Is this path under the driver boundary (/io)?  Crew-derived
  '  subscriptions skip such nodes: their reactivity belongs to the
  '  driver through persistent watches, not kernel hears.
  \ p=path
  ^ bool
  p.starts('io)

+  log_root
  '  The event journal: one node per accepted post-boot epoch,
  '  /log/<epoch>, holding the driving task, its ack, and its
  '  outbound effects.  Commit-owned — kernel writes here fail the
  '  event, and crew subscriptions to /log are skipped, so the
  '  journal never feeds back into reactivity.  Signs for /log
  '  paths still mint but are inert (no eyes ever match them).
  ^  path
  ['log]
+  is_log
  '  Is this path under the event journal (/log)?
  \ p=path
  ^ bool
  p.starts('log)

+  kook_root
  '  Where the KERNEL's behaviors live, by convention only — kook
  '  refs are full paths and resolve anywhere; this constant is where
  '  boot seeding puts the kernel's own form nodes.
  ^  path
  ['kook]
+  invert
  '  Turn news (changed path -> cared subscribers) into subscriber ->
  '  cared changed paths, skipping remote (/xeno) subscribers.
  \  news=axal[row[dep]]
  ^  axal[row[dep]]
  =  es news.tap
  %  i=nat 0
     acc=axal[row[dep]] (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  chg p
  =  acc2
       %  j=nat 0
          a2=axal[row[dep]] acc
       ?  (eq j q.len)
          a2
       =  e q.at(j)
       =  sub e.p
       ?  (is_xeno sub)
          (_ j.inc a2)
       =  cur a2.gut(sub [])
       (_ j.inc a2.put(sub cur.snoc((dep e.c chg))))
  (_ i.inc acc2)
+  node_deps
  '  What a node's record subscribes to: its crew's deps, journal
  '  paths dropped (nothing may watch /log — such an eye would fire
  '  on every commit and burn the cascade's fuel forever).  Empty
  '  when the node carries no crew.
  \  t=myth
  ^  row[dep]
  ?  t.get(crew_slot)
   > .none  []
   > (./some pl=pail)
     ?  pl
      > c2=cpail
        =  ds c2.crew.tap
        %  j=nat 0
           acc=row[dep] []
        ?  (eq j ds.len)
           acc
        =  e ds.at(j)
        =  d e.val
        ?  (is_log d.p)
           (_ j.inc acc)
        (_ j.inc acc.snoc(d))
     []
+  hive_of
  '  Derive the crew index from the whole namespace — one full walk,
  '  paid when a driver takes the helm and on resume; every round
  '  after that bumps the index instead.  /io and /log nodes are
  '  skipped (see /is_io): their reactivity belongs to the driver,
  '  and journal nodes subscribe to nothing.
  \  s=sov
  ^  hive
  =  fat (peek [] s)
  =  es fat.tap
  %  i=nat 0
     acc=hive (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  ?  ((is_io sub) || (is_log sub))
     (_ i.inc acc)
  =  t q
  =  ds (node_deps t)
  ?  (eq 0 ds.len)
     (_ i.inc acc)
  (_ i.inc acc.put(sub ds))
+  hive_bump
  '  Fold one round's signs into the crew index.  A signed node is
  '  re-read once: it enters the index if it now carries a crew,
  '  leaves if it does not, and takes its whole subtree with it when
  '  its record is gone — a cull is recursive, and signs walk parent
  '  before kids, so a path re-made under a culled ancestor still
  '  lands after the subtree drop.  Ancestors ride the signs for
  '  their y/z grades and re-read to the same answer.
  \  hv=hive sg=axal[sign] s=sov
  ^  hive
  =  ps sg.keys
  %  i=nat 0
     acc=hive hv
  ?  (eq i ps.len)
     acc
  =  pax ps.at(i)
  ?  ((is_io pax) || (is_log pax))
     (_ i.inc acc)
  ?  s.x_latest(pax)
   > (./known t=myth)
     =  ds (node_deps t)
     ?  (eq 0 ds.len)
        (_ i.inc acc.del(pax))
     (_ i.inc acc.put(pax ds))
   (_ i.inc acc.lop(pax))
+  eyes_of
  '  Derive the namespace's subscriptions from every node's crew:
  '  each named dep subscribes its node (as watcher) to the watched
  '  path.  Persistent and declarative — the full derivation, kept
  '  as the reference semantics the incremental index reproduces.
  '  /io nodes are skipped (see /is_io), and so is /log on both
  '  sides: journal nodes subscribe to nothing and nothing may
  '  watch the journal (a /log eye would fire on every commit,
  '  burning the cascade's fuel forever).
  \  s=sov
  ^  eyes
  (eyes_from (hive_of s))
+  lens_from
  \ hv=hive s=sov
  ^ lens
  = reader
      | namespace_reader
        (\ car version target (store_page car version target s))
        (\ car epoch target (store_epoch car epoch target s))
        (\ target=path (./known (h_ver target s)))
  | lens_from_reader hv reader
+  ovum
  '  The full-cycle outcome: new sovereign, outbound moves, the step's
  '  change signs, and the command's ack (its path tag; .none for hear
  '  events) — or a failure with the sovereign untouched.
  &  ovum/ripe
     ovum/fail

  +  ripe
    :  state=sov effects=row[move] signs=axal[sign] ack=maybe[path]

  +  fail
    :  err=iota
+  log_card
  '  One journal entry: the input event verbatim, the ack it earned,
  '  and the outbound moves it produced.  Rides as the ['ev] slot of
  '  the /log/<epoch> node, committed in the event's own step.
  :  t=task ack=maybe[path] fx=row[move]
+  gyre
  '  The reactive-cycle outcome: the final sovereign, all outbound
  '  moves, each round's signs (first = the driving event), and the
  '  driving event's ack — or a failure with the sovereign untouched.
  '  spill carries cycle_exhausted or a cascaded hear failure when it stopped
  '  the cascade: the committed rounds stand, but the error is
  '  SURFACED, not swallowed — the driver decides how to report it.
  &  gyre/spun
     gyre/fail

  +  spun
    :  state=sov
       moves=row[move]
       rounds=row[axal[sign]]
       ack=maybe[path]
       spill=maybe[iota]



  +  fail
    :  err=iota
+ store_access
  \ state=sov
  ^ dispatch_reader
  | dispatch_reader
    (\ target transaction (read_x target transaction state))
    (\ car target transaction (read car target transaction state))
    (\ record transaction (crew_of record transaction state))
    (\ target !(is_log target))
+  resolve
  \ t=myth wm=worm s=sov
  ^ kres
  | resolve_access t wm (store_access s)
+  initialize
  \ b=bowl t=myth wm=worm s=sov
  ^ wend
  | initialize_access b t wm (store_access s)
+  dispatch
  \ f=flue wm=worm s=sov
  ^ wend
  | dispatch_access f wm (store_access s)
+  raid
  \ wm=worm s=sov
  ^ worm
  | raid_access wm (store_access s)
+  grind_with
  \ fuel=nat dn=row[flue] ack=maybe[path] eny=nat s=sov
  ^ doom
  | grind_with_access fuel dn ack eny (store_access s)
+  grind
  '  Bound each event to 4096 dispatch/raid steps. Exhaustion rejects
  '  the whole event; no partial worm state reaches commit.
  \  dn=row[flue] ack=maybe[path] eny=nat s=sov
  ^  doom
  (grind_with 4096 dn ack eny s)
+  kernel
  '  One event against the committed state: a fate (acked with the
  '  command's path tag for vine events), or a failure.
  \  t=task eny=nat s=sov
  ^  doom
  ?  t
   > (./vine p=path w=writ)
     (grind [(vine_flue p w)] (./some p) eny s)
   > (./hear news=axal[row[dep]])
     =  subs (invert news)
     ?  (eq 0 subs.wyt)
        (./fail 'hear_no_subs)
     (grind (hear_flues subs) .none eny s)
+  commit
  '  Apply a fate's resolved notes to the sovereign. The
  '  namespace expands recursive culls, rejects live writes through
  '  unrevived tombstones, then melds and deduplicates resolved values.
  '  Shape contracts gate here too: a diff whose final record carries
  '  ['sys 'lash] must fit it after normalization, or the event rejects.
  '  The accepted event owns one internal epoch; every affected
  '  (path, care) mints at most one independent local case.  Apollo
  '  time and PKI blockheight are zeroed in this port — the runtime
  '  supplies them a layer out.
  '  When journal is set, a /log/<epoch> node carrying the driving
  '  task, its ack, and its effects rides the same diff set — the
  '  event and its journal entry are one epoch, indivisible.
  \  t=task a=maybe[path] journal=bool f=fate s=sov
  ^  verdict[[state=sov signs=axal[sign]]]
  =  raw (axal/gas[note] f.write (axal/new[note] .none))
  =  diffs
       ?  journal
          =  card (log_card t a f.effects)
          raw.put(['log (dig_show s.top.inc)]
                  (note/make (myth/sing ['ev] card)))
       raw
  =  eff (gate/prepare diffs s.top s.idx)
  ?  !(gate/valid eff s.top s.idx)
     (./rejected 'tombstoned_ancestor)
  ?  (guard_diffs eff s)
   > (./some why=iota)  (./rejected why)
   > .none  (./accepted s.apply(eff diffs 0 0))
+  run_event_with
  '  The full cycle: run the kernel and, on success, commit — the new
  '  sovereign, the outbound moves, and the step's change signs.  On
  '  failure the sovereign is untouched.  journal selects whether
  '  the commit also writes the /log entry.
  \  journal=bool t=task eny=nat s=sov
  ^  ovum
  ?  (kernel t eny s)
   > (./fail e=iota)  (./fail e)
   > (./done f=fate a=maybe[path])
     ?  (commit t a journal f s)
      > (./rejected e=iota)  (./fail e)
      > (./accepted r=[state=sov signs=axal[sign]])
        =  fx f.effects
        (./ripe state fx signs a)
+  run_event
  '  A journal-free event: seeding and probes — no /log entry.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with .false t eny s)
+  run_event_log
  '  A journaled event: the live loop — every accepted epoch leaves
  '  its /log node.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with .true t eny s)
+  cycle_with
  '  /cycle over a kept crew index: each round bumps the caller's
  '  index from its own signs instead of re-deriving it from the
  '  whole namespace, and the index rides back out for the next
  '  event.  A failed event returns the index untouched — nothing
  '  committed, so nothing moved.
  \  hv=hive t=task eny=nat fuel=nat s=sov
  ^  [g=gyre hv2=hive]
  ?  (run_event_log t eny s)
   > (./fail e=iota)  [(./fail e) hv]
   > (./ripe s1=sov fx1=row[move] sg1=axal[sign] a=maybe[path])
     %  cur=sov s1
        prev=sov s
        moves=row[move] fx1
        rounds=row[axal[sign]] [sg1]
        sg=axal[sign] sg1
        gas=nat fuel
        hz=hive (hive_bump hv sg1 s1)
     ^  [g=gyre hv2=hive]
     =  [news rest] (react sg (eyes_from hz))
     '  Lens deps translate against the PRE-round sov: the round's
     '  signs graded that state, and an /o answer's first change
     '  (an unminted pin minting) must wake its watcher.
     =  lt (react_lens sg (lens_from hz prev)).tap
     =  nws
          %  i2=nat 0
             acc=axal[row[dep]] news
          ?  (eq i2 lt.len)
             acc
          =  [p q] lt.at(i2)
          (_ i2.inc acc.put(p q))
     ?  (eq 0 nws.wyt)
        [(./spun cur moves rounds a .none) hz]
     ?  (eq 0 gas)
        [(./spun cur moves rounds a (./some 'cycle_exhausted)) hz]
     ?  (run_event_log (./hear nws) eny cur)
      > (./fail e2=iota)  [(./spun cur moves rounds a (./some e2)) hz]
      > (./ripe s2=sov fx2=row[move] sg2=axal[sign] a2=maybe[path])
        =  m2 moves.weld(fx2)
        =  r2 rounds.snoc(sg2)
        (_ s2 cur m2 r2 sg2 gas.dec (hive_bump hz sg2 s2))
+  cycle
  '  Run one external event, then let the namespace react to itself:
  '  derive the eyes from every crew, match the signs, and feed the
  '  news back as hear events until quiet — or until fuel runs out
  '  (apps may legally self-loop; the cap bounds them).  A failed
  '  hear round stops the cascade, keeping the rounds that committed.
  '  Every accepted round journals: one /log node per epoch.
  '  The index is derived here and dropped; a driver that runs many
  '  events keeps one across them with /cycle_with.
  \  t=task eny=nat fuel=nat s=sov
  ^  gyre
  =  [g=gyre hv2=hive]  (cycle_with (hive_of s) t eny fuel s)
  g
