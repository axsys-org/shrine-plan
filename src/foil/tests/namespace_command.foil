- helm
- testing
- tests/namespace [at=fixture]

+ command_tests
  + initial
    ^ namespace
    = fixture fixture/namespace_tests/initial
    | namespace ($x 17) sov/new fixture.system
  + root
    ^ path
    [($x 17) 'user 'work]
  + evidence
    ^ path
    [($x 17) 'user 'evidence]
  + operation
    ^ path
    [($x 17) 'gov 'command]
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack why) (maybe/is_none why)
    .false
  + plan
    \ target=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    = current state.case(.x command_tests/evidence).fall(0)
    ? !(eq current input.nat_at(['expected] 0)) (./err 'stale_evidence)
    = result (myth/sing ['value] (pails/n input.nat_at(['value] 0)))
    | ./ok [[target (writ/make result)]
      [target.snoc('decision) (writ/make result)]]
  + seeded
    ^ [namespace hive feet/task[unit]]
    = state command_tests/initial
      published (myth/sing system_vocabulary/op (namespace_op command_tests/plan))
    | helm/supervisor/steps
      [[command_tests/evidence (writ/make (myth/sing ['value] (pails/n 4)))]
       [command_tests/root (writ/make (myth/sing ['value] (pails/n 0)))]
       [command_tests/operation (writ/make published)]]
      0 0 state (sovereign_hive state)
  + guarded
    \ _=unit
    ^ row[testing/check]
    = [state index seeded] command_tests/seeded
      expected state.case(.x command_tests/evidence).fall(0)
      input (myth/sing ['expected] (pails/n expected)).put(['value] (pails/n 9))
      [accepted ai okay]
        | helm/supervisor/admit
          (namespace_command/plan command_tests/root command_tests/operation input)
          state index
      [edited ei edit_ack]
        | helm/supervisor/step command_tests/evidence
          (writ/poke (myth/sing ['value] (pails/n 5))) 0 0 accepted ai
      [refused ri stale]
        | helm/supervisor/admit
          (namespace_command/plan command_tests/root command_tests/operation input)
          edited ei
    [(testing/nat "guarded command admitted" 1 (command_tests/accepted okay))
     (testing/nat "canonical value committed" 9 (command_tests/value command_tests/root accepted))
     (testing/nat "decision committed in same event" 9 (command_tests/value (command_tests/root).snoc('decision) accepted))
     (testing/nat "single event for both writes" state.local.top.inc accepted.local.top)
     (testing/nat "changed evidence refuses old command" 0 (command_tests/accepted stale))
     (testing/nat "refusal preserves namespace" 1 (equal refused edited))
     (testing/nat "refusal preserves dependency index" 1 (equal ri ei))]
  + invalid
    \ _=unit
    ^ row[testing/check]
    = [state index seeded] command_tests/seeded
      partial
        \ ignored=namespace
        ^ either[iota row[[p=path q=writ]]]
        | ./ok [[command_tests/root (writ/make (myth/sing ['value] (pails/n 99)))]
          [[($x 18) 'foreign] (writ/make myth/new)]]
      [refused ri answer] (helm/supervisor/admit partial state index)
      empty
        \ ignored=namespace
        ^ either[iota row[[p=path q=writ]]]
        | ./ok []
      [same si ack] (helm/supervisor/admit empty state index)
      crash
        \ ignored=namespace
        ^ either[iota row[[p=path q=writ]]]
        | Seq[either[iota row[[p=path q=writ]]]] (error (pails/t "test planner failure")) (./ok [])
      [failed fi failure] (helm/supervisor/admit crash state index)
    [(testing/nat "invalid batch refused" 0 (command_tests/accepted answer))
     (testing/nat "no partial writes" 1 (equal refused state))
     (testing/nat "empty plan succeeds" 1 (command_tests/accepted ack))
     (testing/nat "empty plan creates no event" 1 (equal same state))
     (testing/nat "failed planner refuses" 0 (command_tests/accepted failure))
     (testing/nat "failed planner changes nothing" 1 (equal failed state))]
  + ordinary
    \ _=unit
    ^ row[testing/check]
    = [state index seeded] command_tests/seeded
      fn
        \ input=myth current=myth
        ^ myth
        | current.put(['value] (pails/n input.nat_at(['value] 0)))
      card (myth/sing system_vocabulary/op (op 'set 'value [] 'value 0 fn))
      [installed ii made]
        | helm/supervisor/step command_tests/operation (writ/make card) 0 0 state index
      input (myth/sing ['value] (pails/n 12))
      [next ni ack]
        | helm/supervisor/admit
          (namespace_command/plan command_tests/root command_tests/operation input)
          installed ii
      [missing mi bad]
        | helm/supervisor/admit
          (namespace_command/plan command_tests/root [($x 17) 'absent] input)
          next ni
    [(testing/nat "ordinary record operation still works" 1 (command_tests/accepted ack))
     (testing/nat "ordinary record result" 12 (command_tests/value command_tests/root next))
     (testing/nat "missing operation refuses" 0 (command_tests/accepted bad))
     (testing/nat "missing operation leaves state untouched" 1 (equal next missing))]
  + broken
    \ input=myth current=myth
    ^ myth
    | Seq[myth] (error (pails/t "operation failed")) current
  + broken_hear
    \ context=bowl record=myth news=row[dep]
    ^ yell
    = source context.crew.gut(['source] (axal/new[myth] .none)).fil.fall(myth/new)
    ? (gt source.nat_at(['value] 0) 0)
      | Seq[yell] (error (pails/t "reaction failed")) (yell [] record)
    | yell [] record
  + execution_failure
    \ ignored=unit
    ^ row[testing/check]
    = [state index seeded] command_tests/seeded
      operation (myth/sing system_vocabulary/op (op 'broken 'value [] 'value 0 command_tests/broken))
      hand=path [state.self 'gov 'broken_hand]
      watcher=path [state.self 'user 'watcher]
      watching (myth/sing limb_slot (kook [hand])).put(crew_slot
        (cpail (crew/sing ['source] (dep .x command_tests/root))))
    ?> (./ok state) (grove_install/changes
        [[command_tests/operation (writ/make operation)]
         [hand (writ/make (myth/sing system_vocabulary/form (def_form.set_hear(command_tests/broken_hear))))]
         [watcher (writ/make watching)]] state)
      [(testing/nat "failure fixture admitted" 1 0)]
    = index (sovereign_hive state)
      [failed fi rejected]
        | helm/supervisor/admit
          (namespace_command/plan command_tests/root command_tests/operation myth/new) state index
      [reacted ri reaction_reply]
        | helm/supervisor/step command_tests/root
          (writ/poke (myth/sing ['value] (pails/n 9))) 0 0 failed fi
      [healthy hi success]
        | helm/supervisor/step command_tests/evidence
          (writ/poke (myth/sing ['value] (pails/n 6))) 0 0 reacted ri
      execution_error
        \ reply=feet/task[unit]
        ^ bool
        ?> (./ack why) reply .false
        ?> (./some held) why .false
        ?> rejected=helm/supervisor/rejection held .false
        | eq_iota 'command_execution_failed rejected.reason
    [(testing/nat "execution exception becomes refusal" 0 (command_tests/accepted rejected))
     (testing/nat "operation exception identifies execution failure" 1 (execution_error rejected))
     (testing/nat "execution refusal preserves world and history" 1 (equal state failed))
     (testing/nat "execution refusal preserves hive" 1 (equal index fi))
     (testing/nat "reaction exception becomes refusal" 0 (command_tests/accepted reaction_reply))
     (testing/nat "reaction exception identifies execution failure" 1 (execution_error reaction_reply))
     (testing/nat "reaction exception rolls back initiating write and history" 1 (equal state reacted))
     (testing/nat "reaction exception preserves hive" 1 (equal index ri))
     (testing/nat "subsequent command succeeds" 1 (command_tests/accepted success))
     (testing/nat "subsequent value committed" 6 (command_tests/value command_tests/evidence healthy))]
  + response
    \ _=unit
    ^ row[testing/check]
    = [state index seeded] command_tests/seeded
      expected state.case(.x command_tests/evidence).fall(0)
      input (myth/sing ['expected] (pails/n expected)).put(['value] (pails/n 17))
      finish
        \ outcome=maybe[pail] before=nat current=namespace
        ^ [nat str str]
        | [200 (nat/show (command_tests/value command_tests/root current))
          (nat/show before)]
      [next ni response]
        | helm/supervisor/handle
          (helm/card/admit 42
            (namespace_command/plan command_tests/root command_tests/operation input) finish)
          state index
      result=[nat nat str str]
        ? response
         > (./admitted request status body line) [request status body line]
        [0 0 "" ""]
      [request status body line] result
      empty
        \ ignored=namespace
        ^ either[iota row[[p=path q=writ]]]
        | ./ok []
      [same si repeated]
        | helm/supervisor/handle (helm/card/admit 43 empty finish) next ni
      repeated_result=[nat nat str str]
        ? repeated
         > (./admitted request status body line) [request status body line]
        [0 0 "" ""]
      [repeat_request repeat_status repeat_body repeat_line] repeated_result
    [(testing/nat "response request correlation" 42 request)
     (testing/nat "response status" 200 status)
     (testing/text "then response sees admitted value" "17" body)
     (testing/text "stream response receives admission starting epoch" (nat/show state.local.top) line)
     (testing/nat "retry response request correlation" 43 repeat_request)
     (testing/nat "retry response status" 200 repeat_status)
     (testing/text "retry still renders current state" "17" repeat_body)
     (testing/text "no-op retry emits no commit stream line" "" repeat_line)
     (testing/nat "no-op retry retains same epoch" next.local.top same.local.top)]

+ tests
  ^ row[testing/case]
  [(testing/case "shared cascade admission" command_cascade/checks)
   (testing/case "bounded cascade rollback" command_cascade/bounded)
   (testing/case "guarded native operations" command_tests/guarded)
   (testing/case "atomic refusal and no-op" command_tests/invalid)
   (testing/case "ordinary op compatibility" command_tests/ordinary)
   (testing/case "execution exception containment" command_tests/execution_failure)
   (testing/case "admitted snapshot response" command_tests/response)]

+ command_cascade
  + node
    \ n=nat
    ^ path
    [($x 17) 'user 'chain ($u n)]
  + hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    = source b.crew.gut(['previous] (axal/new[myth] .none)).fil.fall(myth/new)
    | yell [] record.put(['value] source.pail_at(['value]))
  + relay
    \ n=nat
    ^ [p=path q=writ]
    = hand=path [($x 17) 'gov 'relay]
      record (myth/sing ['value] (pails/n 0)).put(limb_slot (kook [hand])).put(crew_slot (cpail (crew/sing ['previous] (dep .x (command_cascade/node n.dec)))))
    | [(command_cascade/node n) (writ/make record)]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
      hand=path [($x 17) 'gov 'relay]
      records=row[[p=path q=writ]] [[hand (writ/make (myth/sing system_vocabulary/form (def_form.set_hear(command_cascade/hear))))]
        [(command_cascade/node 0) (writ/make (myth/sing ['value] (pails/n 0)))]]
      records records.weld((row/range 1 11).map(command_cascade/relay))
    ?> (./ok state) (grove_install/changes records initial) [(testing/nat "fixture admitted" 1 0)]
    = writes=row[[p=path q=writ]] [[(command_cascade/node 0) (writ/poke (myth/sing ['value] (pails/n 42)))]]
      plan (\ state=namespace (either/ok[iota row[[p=path q=writ]]] writes))
      [supervised index reply] (helm/supervisor/admit plan state (sovereign_hive state))
      accepted (grove_install/changes writes state)
    [(testing/nat "supervisor and Goo share cascade admission" 1 (equal accepted (either/ok[iota namespace] supervised)))
     (testing/nat "supervisor completes all ten hands" 42 (command_tests/value (command_cascade/node 10) supervised))]
  + bounded
    \ ignored=unit
    ^ row[testing/check]
    = initial command_tests/initial
      hand=path [($x 17) 'gov 'relay]
      records=row[[p=path q=writ]] [[hand (writ/make (myth/sing system_vocabulary/form (def_form.set_hear(command_cascade/hear))))]
        [(command_cascade/node 0) (writ/make (myth/sing ['value] (pails/n 0)))]]
      records records.weld((row/range 1 130).map(command_cascade/relay))
    ?> (./ok state) (grove_install/changes records initial) [(testing/nat "bounded fixture admitted" 1 0)]
    ' From node 1, exactly 128 reactions reach node 129 and quiesce. From
    ' node 0, the 129th reaction would exceed the shared admission budget.
    = writes=row[[p=path q=writ]] [[(command_cascade/node 1) (writ/poke (myth/sing ['value] (pails/n 42)))]]
      [accepted index reply] (helm/supervisor/steps writes 0 0 state (sovereign_hive state))
      excessive=row[[p=path q=writ]] [[(command_cascade/node 0) (writ/poke (myth/sing ['value] (pails/n 99)))]]
      plan (\ state=namespace (either/ok[iota row[[p=path q=writ]]] excessive))
      [refused ri rejection] (helm/supervisor/admit plan accepted index)
      reason=iota
        ?> (./ack why) rejection 'missing_rejection
        ?> (./some held) why 'missing_rejection
        ?> error=helm/supervisor/rejection held 'invalid_rejection
        error.reason
      installed (grove_install/changes excessive accepted)
    [(testing/nat "128 reactions can reach quiescence" 1 (command_tests/accepted reply))
     (testing/nat "last allowed reaction is committed" 42 (command_tests/value (command_cascade/node 129) accepted))
     (testing/nat "129th reaction refuses the entire command" 0 (command_tests/accepted rejection))
     (testing/nat "refusal identifies exhausted reaction budget" 1 (eq_iota 'cycle_exhausted reason))
     (testing/nat "exhaustion preserves all namespace and history state" 1 (equal accepted refused))
     (testing/nat "exhaustion preserves subscription index" 1 (equal index ri))
     (testing/nat "installation uses the same exhaustion policy" 1 (equal installed (either/err[iota namespace] 'cycle_exhausted)))]
