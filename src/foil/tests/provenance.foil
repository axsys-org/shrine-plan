- helm
- net
- testing
- tests/namespace [at=fixture]

' Five worlds that never share a database. A laboratory (0x24) tests a
' batch for a mill (0x23). The mill certifies the batch to a distributor
' (0x22), citing the test and showing it. The distributor tells a builder
' (0x21) it delivered, citing the certificate and showing it. A carrier
' (0x25) tells the builder something else about the same delivery. The
' builder holds only what was published to it, and from its own requirement
' walks to the laboratory's signed result, checking each step against the
' key of the world that said it. Both delivery claims stand.
+ prov
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + key
    \ n=nat
    ^ nat
    | Ed25519PublicKey (prov/seed n)
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + world
    ' A world that holds the keys of the worlds it will hear from.
    \ n=nat knows=row[nat]
    ^ namespace
    = self=iota ($x n)
      blank (namespace self sov/new (fixture/namespace_tests/initial).system)
      cards
        | knows.map
          \ other=nat
          ^ [p=path q=writ]
          = at=path [self 'io 'mesa ($x other)]
          [at (writ/make (myth/sing ['key] (pails/n (prov/key other))))]
    | prov/apply cards blank
  + send
    ' Everything one world publishes to another, signed and landed.
    \ from=nat publisher=namespace to=nat reader=namespace
    ^ namespace
    = root=path [($x from) 'our ($x to)]
      mount=path [($x to) 'her ($x from)]
      card=path [($x to) 'io 'mesa ($x from)]
      head publisher.case(.z root).fall(0)
    ?> (./some change) (net/delta 0 root 0 head publisher) reader
    ? (net/land mount card (net/seal (prov/seed from) root change) reader)
     > (./err why) reader
     > (./ok writes) (prov/apply writes reader)
  + record
    \ name=path state=namespace
    ^ myth
    | (sovereign_care .x name state).fil.fall(myth/new)
  + cite
    ' A pinned reference to a name this world holds of a publisher, at the
    ' publisher's own version of it.
    \ name=path state=namespace
    ^ safe
    | safe (net/version name state) .x (reference_index/canonical state.self name)
  + showing
    ' A record that states a number, cites a held name and shows it.
    \ slot=iota v=nat name=path state=namespace
    ^ myth
    = base (myth/sing [slot] (pails/n v)).put(['cites] (prov/cite name state))
    ?> (./some item) (net/show name state) base
    | base.put(['shows] item)
  + step
    : found=bool record=myth cited=safe
  + walk
    ' From a record: the record it shows, when the one who holds a key said
    ' it and it is the very name and version the record cites.
    \ key=nat from=myth
    ^ prov/step
    = nowhere=path []
      lost (prov/step .false myth/new (safe 0 .x nowhere))
    ?> (./some link) from.get(['cites]) lost
    ?> cited=safe link lost
    ?> (./some held) from.get(['shows]) lost
    ?> (./some item) (net/seen key held) lost
    ? !(equal[path] item.name cited.path) lost
    ? !(eq item.said.version cited.ver) lost
    | prov/step .true (unpin item.record) cited
  + checks
    \ _=unit
    ^ row[testing/check]
    = builder 21
      dist 22
      mill 23
      lab 24
      carrier 25
      nobody=row[nat] []
      knows_lab=row[nat] [lab]
      knows_mill=row[nat] [mill]
      knows_all=row[nat] [dist carrier mill lab]
      l0 (prov/world lab nobody)
      m0 (prov/world mill knows_lab)
      d0 (prov/world dist knows_mill)
      b0 (prov/world builder knows_all)
      c0 (prov/world carrier nobody)
      test=path [($x lab) 'our ($x mill) 'test]
      lab_root=path [($x lab) 'our ($x mill)]
      lab_writes=row[[p=path q=writ]] [[lab_root (writ/make (myth/sing ['title] (pails/n 1)))] [test (writ/make (myth/sing ['strength] (pails/n 42)))]]
      l1 (prov/apply lab_writes l0)
      m1 (prov/send lab l1 mill m0)
      held_test=path [($x mill) 'her ($x lab) 'test]
      cert=path [($x mill) 'our ($x dist) 'cert]
      mill_root=path [($x mill) 'our ($x dist)]
      mill_writes=row[[p=path q=writ]] [[mill_root (writ/make (myth/sing ['title] (pails/n 1)))] [cert (writ/make (prov/showing 'grade 500 held_test m1))]]
      m2 (prov/apply mill_writes m1)
      d1 (prov/send mill m2 dist d0)
      held_cert=path [($x dist) 'her ($x mill) 'cert]
      delivery=path [($x dist) 'our ($x builder) 'delivery]
      dist_root=path [($x dist) 'our ($x builder)]
      dist_writes=row[[p=path q=writ]] [[dist_root (writ/make (myth/sing ['title] (pails/n 1)))] [delivery (writ/make (prov/showing 'tons 20 held_cert d1))]]
      d2 (prov/apply dist_writes d1)
      b1 (prov/send dist d2 builder b0)
      claim=path [($x carrier) 'our ($x builder) 'delivery]
      carrier_root=path [($x carrier) 'our ($x builder)]
      carrier_writes=row[[p=path q=writ]] [[carrier_root (writ/make (myth/sing ['title] (pails/n 1)))] [claim (writ/make (myth/sing ['tons] (pails/n 18)))]]
      c1 (prov/apply carrier_writes c0)
      b2 (prov/send carrier c1 builder b1)
      mine=path [($x builder) 'her ($x dist) 'delivery]
      theirs=path [($x builder) 'her ($x carrier) 'delivery]
      need=path [($x builder) 'need]
      need_writes=row[[p=path q=writ]] [[need (writ/make (myth/sing ['wants] (prov/cite mine b2)))]]
      b3 (prov/apply need_writes b2)
      wanted (prov/record need b3)
      start
        ?> (./some link) wanted.get(['wants]) myth/new
        ?> cited=safe link myth/new
        ?> (./known records) (sovereign_view .x 0 (safe/spell cited) b3) myth/new
        | records.fil.fall(myth/new)
      mill_card=path [($x builder) 'io 'mesa ($x mill)]
      lab_card=path [($x builder) 'io 'mesa ($x lab)]
      lab_mount=path [($x builder) 'her ($x lab)]
      to_cert (prov/walk (net/key mill_card b3) start)
      to_test (prov/walk (net/key lab_card b3) to_cert.record)
      wrong_key (prov/walk (net/key lab_card b3) start)
      bent start.put(['cites] (safe 7 .x cert))
      said_d (net/said mine b3)
      said_c (net/said theirs b3)
    [(testing/nat "the builder's requirement cites the distributor's delivery, which it holds" 20 start.nat_at(['tons] 0))
     (testing/nat "the delivery shows the mill's certificate, and the mill said it" 1 to_cert.found)
     (testing/nat "the certificate is the one the delivery cites" 1 (equal[path] cert to_cert.cited.path))
     (testing/nat "with its grade" 500 to_cert.record.nat_at(['grade] 0))
     (testing/nat "the certificate shows the laboratory's test, and the laboratory said it" 1 to_test.found)
     (testing/nat "which is the test the certificate cites" 1 (equal[path] test to_test.cited.path))
     (testing/nat "the builder reads the laboratory's result, which was never published to it" 42 to_test.record.nat_at(['strength] 0))
     (testing/nat "and holds nothing of the laboratory's" 0 (net/live lab_mount b3))
     (testing/nat "checked against another world's key, the certificate is not believed" 0 wrong_key.found)
     (testing/nat "shown beside a citation of another version, it is not that citation's" 0 (prov/walk (net/key mill_card b3) bent).found)
     (testing/nat "the carrier's claim about the same delivery stands beside the distributor's" 18 (prov/record theirs b3).nat_at(['tons] 0))
     (testing/nat "each under its own publisher's signature: the distributor's" 1 (net/attested (prov/key dist) delivery said_d (prov/record mine b3)))
     (testing/nat "and the carrier's" 1 (net/attested (prov/key carrier) claim said_c (prov/record theirs b3)))
     (testing/nat "neither replaced the other" 20 (prov/record mine b3).nat_at(['tons] 0))]

+ tests
  ^ row[testing/case]
  [(testing/case "a disclosed chain is walked to its signed source" prov/checks)]
