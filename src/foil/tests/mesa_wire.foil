- helm
- mesa_wire
- testing

' These tests are for the bytes of one connection. They also show what a
' failed connection does.
+ wire_tests
  + bar
    \ raw=nat len=nat
    ^ nat
    | add raw (bex (mul 8 len))
  + checks
    \ _=unit
    ^ row[testing/check]
    = one (wire_tests/bar 4276803 3)
      zeros (wire_tests/bar 0 5)
      long (wire_tests/bar (bex 4000) 600)
      sent=row[nat] [one zeros long]
      empty=row[nat] []
      bytes (mesa_wire/frames 18 sent)
      back (mesa_wire/unframe bytes)
      count
        ?> (./some got) back 0
        | got.packets.len
      from
        ?> (./some got) back 0
        got.from
      same
        ?> (./some got) back 0
        ? !(eq got.packets.len 3) 0
        | and (eq got.packets.at(0) one) (and (eq got.packets.at(1) zeros) (eq got.packets.at(2) long))
      none
        ?> (./some got) (mesa_wire/unframe (mesa_wire/frames 7 empty)) 9
        | got.packets.len
      cut (maybe/is_some (mesa_wire/unframe (wire_tests/bar 5 21)))
      short (maybe/is_some (mesa_wire/unframe (wire_tests/bar 5 3)))
      ;refused (SendTo 0 "127.0.0.1" 1 bytes)
      ;door (Listen 39477)
      ;carried (SendTo 0 "127.0.0.1" 39477 bytes)
      ;inward (Accept door)
      ;arrived (ReadAll inward 1048576)
      ;shut (CloseFd inward)
      ;closed (CloseFd door)
    [(testing/nat "three packets come back" 3 count)
     (testing/nat "from the number that sent them" 18 from)
     (testing/nat "each as it was, zero bytes and all" 1 same)
     (testing/nat "a connection may carry none" 0 none)
     (testing/nat "bytes that are not frames are refused" 0 cut)
     (testing/nat "and so is less than a sender's number" 0 short)
     (testing/nat "a connection that is refused answers 0, and the sender goes on" 0 refused)
     (testing/nat "a connection that is accepted carries the bytes" 1 carried)
     (testing/nat "and they arrive as they were sent" 1 (eq arrived bytes))]
  + rift_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.rift
  + top_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.top
  + marks
    ' The mark is two files. A write that stops before its end makes one file
    ' not whole, and the foot still has the mark from before.
    \ _=unit
    ^ row[testing/check]
    = file=str "mesa_wire_test_mark"
      cut=str "mesa_wire_test_cut"
      lost=str "mesa_wire_test_lost"
      empty (bex 0)
      ;none (mesa_wire/marked file)
      ;w1 (mesa_wire/remark file 0 5)
      ;m1 (mesa_wire/marked file)
      ;w2 (mesa_wire/remark file 1 9)
      ;m2 (mesa_wire/marked file)
      ;broke (WriteFile (str/cat_all [file ".b"]) empty)
      ;m3 (mesa_wire/marked file)
      ;w3 (mesa_wire/remark file 1 12)
      ;m4 (mesa_wire/marked file)
      ;first (WriteFile (str/cat_all [cut ".a"]) empty)
      ;m5 (mesa_wire/marked cut)
      ;la (WriteFile (str/cat_all [lost ".a"]) empty)
      ;lb (WriteFile (str/cat_all [lost ".b"]) empty)
      ;m6 (mesa_wire/marked lost)
    [(testing/nat "a world with no mark starts at rift 0" 0 (wire_tests/rift_of none))
     (testing/nat "a mark is written" 1 w1)
     (testing/nat "and read: the top" 5 (wire_tests/top_of m1))
     (testing/nat "the second mark is the later mark: the rift" 1 (wire_tests/rift_of m2))
     (testing/nat "and the top" 9 (wire_tests/top_of m2))
     (testing/nat "the file of the later mark is made empty: the mark from before is read" 5 (wire_tests/top_of m3))
     (testing/nat "at its rift" 0 (wire_tests/rift_of m3))
     (testing/nat "the next write goes to the file that is not whole" 12 (wire_tests/top_of m4))
     (testing/nat "the first write of all did not finish: the world starts at zeros" 0 (wire_tests/top_of m5))
     (testing/nat "the two files are not whole: there is no mark, and no zeros" 1 (maybe/is_none m6))]

+ tests
  ^ row[testing/case]
  [(testing/case "frames" wire_tests/checks)
   (testing/case "the mark stays through a write that stops" wire_tests/marks)]
