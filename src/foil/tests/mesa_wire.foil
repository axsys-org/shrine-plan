- helm
- mesa_wire
- testing

' These tests are for the mark of a foot: the file outside the world that
' holds its rift, the highest epoch that it announced, and the lowest revision
' of its key manifest that it accepts.
+ wire_tests
  + rift_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.rift
  + top_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.top
  + floor_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.floor
  + marks
    ' The runtime writes a mark as a new file and then gives it its name.
    ' Thus a write that stops before its end leaves the mark from before.
    \ _=unit
    ^ row[testing/check]
    = file=str "mesa_wire_test_mark"
      bad=str "mesa_wire_test_bad"
      ;none (mesa_wire/marked file)
      ;w1 (mesa_wire/remark file 0 5 1)
      ;m1 (mesa_wire/marked file)
      ;w2 (mesa_wire/remark file 1 9 4)
      ;m2 (mesa_wire/marked file)
      ;broke (WriteFile bad (add 7 (bex 24)))
      ;m3 (mesa_wire/marked bad)
    [(testing/nat "a world with no mark starts at rift 0" 0 (wire_tests/rift_of none))
     (testing/nat "at top 0" 0 (wire_tests/top_of none))
     (testing/nat "and accepts each revision of its key manifest" 0 (wire_tests/floor_of none))
     (testing/nat "a mark is written" 1 w1)
     (testing/nat "and read: the top" 5 (wire_tests/top_of m1))
     (testing/nat "and the floor" 1 (wire_tests/floor_of m1))
     (testing/nat "the second mark replaces the first: the rift" 1 (wire_tests/rift_of m2))
     (testing/nat "the top" 9 (wire_tests/top_of m2))
     (testing/nat "and the floor" 4 (wire_tests/floor_of m2))
     (testing/nat "a file that does not hold a mark gives no mark, and no zeros" 1 (maybe/is_none m3))]

+ tests
  ^ row[testing/case]
  [(testing/case "the mark is one file that is written whole" wire_tests/marks)]
