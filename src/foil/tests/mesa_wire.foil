- helm
- net
- mesa_wire
- testing

' Tests for a foot's mark: the file outside the world's store that holds its
' rift, the highest epoch it announced, and the lowest key manifest revision
' it accepts.
+ wire_tests
  + rift_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.rift
  + top_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.top
  + floor_of
    \ found=maybe[mesa_wire/mark]
    ^ nat
    ?> (./some held) found 999
    held.floor
  + marks
    ' The runtime writes a mark as a new file and then renames it, so a write
    ' that stops halfway leaves the old mark. A mark that is damaged, or missing
    ' for a world that started before, gives no mark: the foot then stops and
    ' does not start at zeros.
    \ _=unit
    ^ row[testing/check]
    = file=str "mesa_wire_test_mark"
      ring=str "mesa_wire_test_ring"
      bad=str "mesa_wire_test_bad"
      empty=str "mesa_wire_test_empty"
      lost=str "mesa_wire_test_lost"
      begun=str "mesa_wire_test_begun"
      ;none (mesa_wire/marked file ring)
      ;w1 (mesa_wire/remark file 0 5 1)
      ;m1 (mesa_wire/marked file ring)
      ;w2 (mesa_wire/remark file 1 9 4)
      ;m2 (mesa_wire/marked file ring)
      ;part (WriteFile (str/cat_all [file ".partial"]) (add 7 (bex 24)))
      ;m3 (mesa_wire/marked file ring)
      ;w3 (mesa_wire/remark file 1 12 4)
      ;m4 (mesa_wire/marked file ring)
      ;broke (WriteFile bad (add 7 (bex 24)))
      ;m5 (mesa_wire/marked bad ring)
      ;hollow (WriteFile empty (bex 0))
      ;m6 (mesa_wire/marked empty ring)
      ;started (WriteFile (str/cat_all [begun ".manifest"]) (add 7 (bex 24)))
      ;m7 (mesa_wire/marked lost begun)
    [(testing/nat "a world that never started has no mark and starts at rift 0" 0 (wire_tests/rift_of none))
     (testing/nat "at top 0" 0 (wire_tests/top_of none))
     (testing/nat "and accepts each revision of its key manifest" 0 (wire_tests/floor_of none))
     (testing/nat "a mark is written" 1 w1)
     (testing/nat "and read: the top" 5 (wire_tests/top_of m1))
     (testing/nat "and the floor" 1 (wire_tests/floor_of m1))
     (testing/nat "the second mark replaces the first: the rift" 1 (wire_tests/rift_of m2))
     (testing/nat "the top" 9 (wire_tests/top_of m2))
     (testing/nat "and the floor" 4 (wire_tests/floor_of m2))
     (testing/nat "a write that stopped left a part of a file: the mark from before is read" 9 (wire_tests/top_of m3))
     (testing/nat "and the next write is whole" 12 (wire_tests/top_of m4))
     (testing/nat "a file that does not hold a mark gives no mark, and no zeros" 1 (maybe/is_none m5))
     (testing/nat "an empty file gives no mark" 1 (maybe/is_none m6))
     (testing/nat "a world that started before and has no mark gives no mark" 1 (maybe/is_none m7))]
  + resumes
    ' A world that is behind what it announced was restored to an older copy.
    ' Its rift goes up, and every version it publishes after that is later than
    ' every version it published before.
    \ _=unit
    ^ row[testing/check]
    = was (mesa_wire/mark 2 100 5)
      same (mesa_wire/resumed was 100)
      ahead (mesa_wire/resumed was 120)
      behind (mesa_wire/resumed was 50)
      twice (mesa_wire/resumed behind 10)
    [(testing/nat "a world at the epoch that it announced keeps its rift" 2 same.rift)
     (testing/nat "a world that went on keeps its rift" 2 ahead.rift)
     (testing/nat "and announces its new epoch" 120 ahead.top)
     (testing/nat "a world that is behind what it announced has a later rift" 3 behind.rift)
     (testing/nat "and keeps the highest epoch that it announced" 100 behind.top)
     (testing/nat "the floor of the key manifest does not change" 5 behind.floor)
     (testing/nat "the first version after the restore is later than the last version before it" 1 (gt (net/stamp behind.rift 1) (net/stamp was.rift 100)))
     (testing/nat "a second restore gives a later rift again" 4 twice.rift)
     (testing/nat "and its first version is later than each version of the first restore" 1 (gt (net/stamp twice.rift 1) (net/stamp behind.rift 4294967295)))]

+ tests
  ^ row[testing/case]
  [(testing/case "the mark is one file that is written whole" wire_tests/marks)
   (testing/case "a restored world does not use a published version again" wire_tests/resumes)]
