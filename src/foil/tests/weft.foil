-  sept [order=10]
-  weft [order=20]
-  weft_builder_tests [order=30]
-  testing [order=100]

+  weft_tests
  +  text
    \ name=str want=nat got=nat
    ^ testing/check
    | testing/same[nat] name str/from_atom want got
  +  card
    \ status=nat people=nat
    ^ nat
    | cord/cat_all
      ["<section class=" 34 "card" 34 " id=" 34 "main" 34
       " aria-label=" 34 "A&amp;B" 34 "><h2>Hello world</h2><p>"
       status "</p><ul>" people "</ul><a href=" 34
       "/a?x=1&amp;y=2" 34 ">go &lt;now&gt;</a><input disabled="
       34 34 "></input></section>"]
  +  strings
    \ _=unit
    ^ row[testing/check]
    [(testing/nat "empty byte length" 0 (weft/blen 0))
     (testing/nat "byte length" 5 (weft/blen "hello"))
     (weft_tests/text "concatenate" "abcd" (weft/cat2 "ab" "cd"))
     (weft_tests/text "empty left" "x" (weft/cat2 0 "x"))
     (weft_tests/text "empty right" "x" (weft/cat2 "x" 0))
     (weft_tests/text "join" "a/b/c" (weft/join "/" ["a" "b" "c"]))
     (weft_tests/text "empty join" "" (weft/join "/" []))
     (weft_tests/text "singleton join" "a" (weft/join "/" ["a"]))
     (weft_tests/text "all escapes" "a&amp;b&lt;c&gt;d&quot;e"
       (weft/esc (cord/cat_all ["a&b<c>d" 34 "e"])))
     (weft_tests/text "zero" "0" (weft/show_nat 0))
     (weft_tests/text "decimal" "12345" (weft/show_nat 12345))]
  +  nodes
    \ _=unit
    ^ row[testing/check]
    =   nested
      | weft/el "div" [(weft/cls "row")]
        [(weft/tx "a<b") (weft/raw "<hr>")
         (weft/leaf "span" [] "ok")]
    =   shell
      | cord/cat_all
        ["<!doctype html><html lang=" 34 "en" 34 "><head>"
         "<meta charset=" 34 "utf-8" 34 "></meta>"
         "<meta name=" 34 "viewport" 34 " content=" 34
         "width=device-width, initial-scale=1" 34 "></meta>"
         "<title>t</title><style>body{color:red}</style>"
         "<link rel=" 34 "stylesheet" 34 " href=" 34
         "/style.css" 34 "></link><script defer=" 34 "defer" 34
         " src=" 34 weft/mash_url 34 "></script>"
         "</head><body data-mash-catalogue=" 34 "mash" 34
         "><h1>hi</h1></body></html>"]
    [(weft_tests/text "quoted attributes"
       (cord/cat_all ["<a href=" 34 "/ns/x" 34 ">go</a>"])
       (weft/render (weft/leaf "a" [(weft/href "/ns/x")] "go")))
     (weft_tests/text "classes, nesting, raw and escaped text"
       (cord/cat_all ["<div class=" 34 "row" 34
         ">a&lt;b<hr><span>ok</span></div>"])
       (weft/render nested))
     (weft_tests/text "complete page shell" shell
       (weft/page "t" "body{color:red}" [(weft/leaf "h1" [] "hi")]))]
  +  builder
    \ _=unit
    ^ row[testing/check]
    =   people
      | cord/cat_all
        ["<li data-name=" 34 "Ada" 34 ">Ada</li><li data-name="
         34 "&lt;Bob&gt;" 34 ">&lt;Bob&gt;</li>"]
    [(weft_tests/text "disabled card" (weft_tests/card "Disabled" "")
       (weft/render_many (weft_builder_card 0 [])))
     (weft_tests/text "enabled card" (weft_tests/card "Enabled" people)
       (weft/render_many (weft_builder_card 1 ["Ada" "<Bob>"])))
     (weft_tests/text "hidden fragment" "tail"
       (weft/render_many (weft_builder_fragment 0)))
     (weft_tests/text "visible fragment" "visibletail"
       (weft/render_many (weft_builder_fragment 1)))
     (weft_tests/text "bad selector"
       "<x-bad-selector>p.</x-bad-selector>"
       (weft/render_many weft_builder_bad))
     (weft_tests/text "empty render" "" (weft/render_many []))]

+  tests
  ^ row[testing/case]
  [(testing/case "strings" weft_tests/strings)
   (testing/case "nodes and page" weft_tests/nodes)
   (testing/case "builder" weft_tests/builder)]
