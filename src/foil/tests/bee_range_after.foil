- sept
- testing

+ bee_range_after_tests
  + values
    \ entries=row[bee/kv[nat]]
    ^ row[nat]
    | entries.map (\ e=bee/kv[nat] e.val)

  + same
    \ name=str want=row[nat] got=row[bee/kv[nat]]
    ^ testing/check
    | testing/nat name 1 (equal want (bee_range_after_tests/values got))

  + seq
    \ count=nat
    ^ bee[nat]
    % n=nat 0 tree=bee[nat] (bee/leaf[nat] [])
    ? (eq n count) tree
    | _ n.inc tree.put(($u n) n)

  + from_keys
    ' Insert backwards so expected order is independent of insertion order.
    \ keys=row[iota]
    ^ bee[nat]
    % n=nat keys.len tree=bee[nat] (bee/leaf[nat] [])
    ? (eq n 0) tree
    | _ n.dec tree.put(keys.at(n.dec) n.dec)

  + pages
    \ size=nat tree=bee[nat]
    ^ row[bee/kv[nat]]
    % after=maybe[iota] .none out=row[bee/kv[nat]] []
    = page | tree.range_after after size
    ? (eq page.len 0) out
    | _ (maybe/some page.at(page.len.dec).key) out.weld(page)

  + edge_cases
    \ ignored=unit
    ^ row[testing/check]
    = empty=bee[nat] (bee/leaf[nat] [])
      tree | empty.put(($u 0) 0).put(($u 2) 2).put(($u 9) 9).put(($u 10) 10)
    [(bee_range_after_tests/same "empty" [] empty.range_after(.none 40))
     (bee_range_after_tests/same "zero limit" [] tree.range_after(.none 0))
     (bee_range_after_tests/same "ascending numeric order, not decimal text"
       [0 2 9 10] tree.range_after(.none 40))
     (bee_range_after_tests/same "exact limit" [0 2] tree.range_after(.none 2))
     (bee_range_after_tests/same "exclusive existing key" [9 10]
       tree.range_after((maybe/some ($u 2)) 40))
     (bee_range_after_tests/same "absent key between entries" [9 10]
       tree.range_after((maybe/some ($u 8)) 40))
     (bee_range_after_tests/same "maximum is excluded" []
       tree.range_after((maybe/some ($u 10)) 40))
     (bee_range_after_tests/same "above maximum" []
       tree.range_after((maybe/some ($u 11)) 40))
     (bee_range_after_tests/same "zero is a real exclusive cursor" [2 9 10]
       tree.range_after((maybe/some ($u 0)) 40))
     (bee_range_after_tests/same "earlier aura starts before all numeric keys"
       [0 2 9 10] tree.range_after((maybe/some ($dm 0)) 40))]

  + aura_order
    \ ignored=unit
    ^ row[testing/check]
    ' Every aura, including the internal r marker. Same-aura payloads
    ' distinguish numeric, byte-lexicographic, signed and IEEE ordering.
    = keys=row[iota]
        [($dm 0) ($dm 10) ($dr 0) ($dr 10) ($ds 0) ($ds 10)
         ($f 0) ($f 1) ($r 0) ($r 10)
         ($rd (bex 63)) ($rd 0) ($rs (bex 31)) ($rs 0)
         ($s 9) ($s 1) ($s 0) ($s 2)
         ($ta "aa") ($ta "b") ($ts "aa") ($ts "b")
         ($tu "aa") ($tu "b") ($u 2) ($u 10) ($w 2) ($w 10) ($x 2) ($x 10)]
      tree | bee_range_after_tests/from_keys keys
      text=bee[nat] (bee/leaf[nat] [])
      text | text.put(($ts "a") 1).put(($ts "aa") 2).put(($ts "b") 3)
      floats=row[iota]
        [($rd (add (bex 63) 9218868437227405312))
         ($rd (add (bex 63) 4607182418800017408))
         ($rd (bex 63)) ($rd 0) ($rd 4607182418800017408)
         ($rd 9218868437227405312) ($rd 9221120237041090560)
         ($rs (add (bex 31) 2139095040))
         ($rs (add (bex 31) 1065353216))
         ($rs (bex 31)) ($rs 0) ($rs 1065353216)
         ($rs 2139095040) ($rs 2143289344)]
      float_tree | bee_range_after_tests/from_keys floats
    [(bee_range_after_tests/same "all fourteen auras use native ordering"
       (row/range 0 keys.len) tree.range_after(.none 100))
     (bee_range_after_tests/same "mixed-aura small pages cross separators"
       (row/range 0 keys.len) (bee_range_after_tests/pages 3 tree))
     (testing/nat "every aura cursor is exclusive" 1
       (row/all[nat]
         (\ i=nat
           (equal (row/range i.inc keys.len)
             (bee_range_after_tests/values tree.range_after((maybe/some keys.at(i)) 100))))
         (row/range 0 keys.len)))
     (bee_range_after_tests/same "missing text cursor uses byte ordering"
       [2 3] text.range_after((maybe/some ($ts "aA")) 40))
     (bee_range_after_tests/same "present text cursor excludes only itself"
       [3] text.range_after((maybe/some ($ts "aa")) 40))
     (bee_range_after_tests/same "both float auras preserve negative-zero and infinity order"
       (row/range 0 floats.len) float_tree.range_after(.none 40))]

  + missing_link
    \ code=nat
    ^ bee/k[nat]
    = links=row[bee/k[nat]] []
    | links.at (Throw code)

  + traverse_guards
    \ ignored=unit
    ^ row[testing/check]
    = low (bee/k[nat] (pin (bee/leaf[nat]
        [(bee/kv[nat] ($u 1) 1) (bee/kv[nat] ($u 8) 8)])))
      high (bee/k[nat] (pin (bee/leaf[nat]
        [(bee/kv[nat] ($u 9) 9) (bee/kv[nat] ($u 12) 12)])))
      no_later=bee[nat] (bee/limb[nat] 4 [($u 9)]
        [low (bee_range_after_tests/missing_link 91)])
      no_earlier=bee[nat] (bee/limb[nat] 4 [($u 9)]
        [(bee_range_after_tests/missing_link 92) high])
      empty_branch=bee[nat] (bee/limb[nat] 0 [($u 5)]
        [(bee_range_after_tests/missing_link 93) (bee_range_after_tests/missing_link 94)])
      sparse=bee[nat] (bee/limb[nat] 2 [($u 9)]
        [(bee/k[nat] (pin empty_branch)) high])
      roots=row[bee[nat]] []
    [(bee_range_after_tests/same "filled page never opens later sibling" [1 8]
       no_later.range_after(.none 2))
     (bee_range_after_tests/same "absent cursor skips earlier sibling" [12]
       no_earlier.range_after((maybe/some ($u 10)) 2))
     (bee_range_after_tests/same "equal separator routes right and stays exclusive" [12]
       no_earlier.range_after((maybe/some ($u 9)) 1))
     (bee_range_after_tests/same "zero cached size skips every child" []
       empty_branch.range_after(.none 40))
     (bee_range_after_tests/same "empty internal subtree is skipped without opening its children" [9 12]
       sparse.range_after(.none 2))
     (bee_range_after_tests/same "zero limit does not inspect tree" []
       (bee/range_after[nat] .none 0 roots.at((Throw 95))))]

  + guarded_tree
    \ code=nat
    ^ bee[nat]
    = low (bee/k[nat] (pin (bee/leaf[nat] [(bee/kv[nat] ($u 1) 1)])))
    | bee/limb[nat] 2 [($u 9)] [low (bee_range_after_tests/missing_link code)]

  + full_scan
    \ code=nat
    ^ row[bee/kv[nat]]
    | bee/tap[nat] (bee_range_after_tests/guarded_tree code)

  + larger_page
    \ code=nat
    ^ row[bee/kv[nat]]
    | bee/range_after[nat] .none 2 (bee_range_after_tests/guarded_tree code)

  + guard_controls
    \ ignored=unit
    ^ row[testing/check]
    = scan (Try bee_range_after_tests/full_scan 96)
      larger (Try bee_range_after_tests/larger_page 97)
    [(testing/nat "control: full tap opens throwing sibling" 1 (either/is_err scan))
     (testing/nat "control: larger page must open throwing sibling" 1 (either/is_err larger))]

  + large
    \ ignored=unit
    ^ row[testing/check]
    = tree | bee_range_after_tests/seq 10000
      lookahead | tree.range_after .none 41
      first | lookahead.take 40
      cursor | maybe/some[iota] first.at(39).key
      second | tree.range_after cursor 41
      grown | tree.put(($dm 0) 10000).put(($u 10000) 10000)
      removed | tree.del2 ($u 39)
      boundaries=row[nat] [0 7 8 15 16 71 72 79 80 511 512 648 1000 5832 9958]
    [(testing/nat "10k tree size" 10000 tree.size)
     (bee_range_after_tests/same "page size plus one lookahead"
       (row/range 0 41) lookahead)
     (testing/nat "lookahead count" 41 lookahead.len)
     (bee_range_after_tests/same "next page excludes last displayed key"
       (row/range 40 81) second)
     (testing/nat "inserts before and after page do not shift exclusive continuation" 1
       (equal second grown.range_after(cursor 41)))
     (testing/nat "deleted cursor still seeks correctly" 1
       (equal second removed.range_after(cursor 41)))
     (bee_range_after_tests/same "last key boundary is empty" []
       tree.range_after((maybe/some ($u 9999)) 41))
     (bee_range_after_tests/same "short last page" [9998 9999]
       tree.range_after((maybe/some ($u 9997)) 41))
     (testing/nat "cursor boundaries across all tree levels" 1
       (row/all[nat]
         (\ cursor=nat
           (equal (row/range cursor.inc (add cursor 42))
             (bee_range_after_tests/values tree.range_after((maybe/some ($u cursor)) 41))))
         boundaries))
     (bee_range_after_tests/same "all 10k keys appear once across 41-key pages"
       (row/range 0 10000) (bee_range_after_tests/pages 41 tree))]

  + lazy_deletion
    \ ignored=unit
    ^ row[testing/check]
    = tree | bee_range_after_tests/seq 257
      trimmed
        % n=nat 1 acc=bee[nat] tree
        ? (eq n 250) acc
        | _ n.inc acc.del2(($u n))
    [(bee_range_after_tests/same "lazy deletion preserves remaining order"
       [0 250 251 252 253 254 255 256] trimmed.range_after(.none 40))
     (bee_range_after_tests/same "deleted interior cursor skips empty branches"
       [250 251 252 253 254 255 256] trimmed.range_after((maybe/some ($u 200)) 40))
     (bee_range_after_tests/same "small pages cross lazily empty branches"
       [0 250 251 252 253 254 255 256] (bee_range_after_tests/pages 2 trimmed))]

+ tests
  ^ row[testing/case]
  [(testing/case "ascending cursor boundaries" bee_range_after_tests/edge_cases)
   (testing/case "all iota auras" bee_range_after_tests/aura_order)
   (testing/case "bounded traversal guards" bee_range_after_tests/traverse_guards)
   (testing/case "traversal guard positive controls" bee_range_after_tests/guard_controls)
   (testing/case "10k ascending pages" bee_range_after_tests/large)
   (testing/case "lazy deletion" bee_range_after_tests/lazy_deletion)]
