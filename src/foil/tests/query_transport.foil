- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- helm
- view_ops
- testing

+ transport_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = root=path [($x 1) 'input]
      cell=path [($x 1) 'view]
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put root (myth/sing ['value] (pails/n 90)) initial.local)
      local (fixture/cell_tests/put cell (myth/sing bond/weft (woven view_ops/children)).put(bond/tack (safe 0 .x root)) local)
      initial initial.set_local(local)
      request (view_read (safe 0 .x ['x ($x 1) 'view]) (view_select/slots [['value]]))
      render
        \ values=row[res[axal[myth]]] epoch=nat
        ^ [nat str]
        | [200 (nat/show (fixture/cell_tests/nat_at ['value] values.at(0)))]
      ;server (Spawn (helm/supervisor/run initial))
    ; (SendCaps server (helm/card/look 1 [request] render) [0])
    = ;[first caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/look 2 [request] render) [0])
    = ;[second caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/step root (writ/poke (myth/sing ['value] (pails/n 180)))) [0])
    = ;[written caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/look 3 [request] render) [0])
    = ;[third caps] (Recv[feet/task[unit]] 0)
      batch_render
        \ values=row[res[axal[myth]]] epoch=nat
        ^ [nat str]
        | [200 (str/cat_all [(nat/show (fixture/cell_tests/nat_at ['value] values.at(0))) ":" (nat/show (fixture/cell_tests/nat_at ['value] values.at(1)))])]
    ; (SendCaps server (helm/card/look 4 [request request] batch_render) [0])
    = ;[batch caps] (Recv[feet/task[unit]] 0)
      wrapped
        \ id=str
        ^ {\ row[res[axal[myth]]] nat}[nat str]
        \ values=row[res[axal[myth]]] epoch=nat
        ^ [nat str]
        = [status body] (batch_render values epoch)
        | [status (str/cat_all [id ":" body])]
    ; (SendCaps server (helm/card/look 5 [request request] (wrapped "first")) [0])
    = ;[encoded_first caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/look 6 [request request] (wrapped "second")) [0])
    = ;[encoded_second caps] (Recv[feet/task[unit]] 0)
      valid
        \ expected=str reply=feet/task[unit]
        ^ bool
        ?> (feet/task/develop id status body) reply .false
        | and (eq status 200) (equal[str] body expected)
    ; (CloseHandle server)
    [(testing/nat "supervisor serves a native query" 1 (valid "90" first))
     (testing/nat "supervisor serves the repeated query" 1 (valid "90" second))
     (testing/nat "supervisor invalidates query after committed edit" 1 (valid "180" third))
     (testing/nat "computed batch uses one committed snapshot" 1 (valid "180:180" batch))
     (testing/nat "a wrapped render sees the requested values" 1 (valid "first:180:180" encoded_first))
     (testing/nat "a second wrapped render keeps its own envelope" 1 (valid "second:180:180" encoded_second))]

+ tests
  ^ row[testing/case]
  [(testing/case "cached look transport" transport_tests/checks)]
