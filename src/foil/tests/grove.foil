- grove
- testing

+ grove_checks
  + lines
    \ parts=row[str]
    ^ str
    | str/join (str/from_atom 10) parts
  + doc
    \ text=str
    ^ grove/document
    | either/ok_val[grove/error grove/document] (grove/parse text)
  + declaration_count
    \ item=grove/item
    ^ nat
    ? item
     > (grove/declaration span name body) 1
    0
  + import_count
    \ item=grove/item
    ^ nat
    ? item
     > (grove/import_decl span alias target) 1
    0
  + tree_count
    \ item=grove/item
    ^ nat
    ? item
     > (grove/declaration span name body)
      ? name
       > (grove/name/tree_path text) 1
      0
    0
  + implementations
    \ body=row[grove/statement]
    ^ row[grove/implementation]
    ? (eq body.len 0) []
    = rest | grove_checks/implementations body.drop(1)
    ? body.at(0)
     > (grove/implementation span code)
      | row/weld[grove/implementation] rest
       [(grove/implementation span code)]
     > (grove/block span kind kids)
      | (grove_checks/implementations kids).weld(rest)
    rest
  + item_implementations
    \ item=grove/item
    ^ row[grove/implementation]
    ? item
     > (grove/declaration span name body)
      | grove_checks/implementations body
    []
  + body_named
    \ text=str doc=grove/document
    ^ row[grove/statement]
    % items=row[grove/item] doc.items
    ? (eq items.len 0) []
    ? items.at(0)
     > (grove/declaration span name body)
      ? name
       > (grove/name/identifier name)
        ? (eq name text) body
        | _ items.drop(1)
      | _ items.drop(1)
    | _ items.drop(1)
  + groups
    \ kind=grove/block_kind body=row[grove/statement]
    ^ row[grove/statement]
    ? (eq body.len 0) []
    ? body.at(0)
     > (grove/block span name kids)
      ? (equal[grove/block_kind] name kind) kids
      | grove_checks/groups kind body.drop(1)
    | grove_checks/groups kind body.drop(1)
  + property_count
    \ stmt=grove/statement
    ^ nat
    ? stmt
     > (grove/property span slot value) 1
    0
  + tag_count
    \ stmt=grove/statement
    ^ nat
    ? stmt
     > (grove/tag span kind) 1
    0
  + comment_count
    \ stmt=grove/statement
    ^ nat
    ? stmt
     > (grove/comment span text) 1
    0
  + sum
    \ nums=row[nat]
    ^ nat
    | nums.fold 0 add
  + ends_with
    \ word=str code=row[rex]
    ^ bool
    ? (eq code.len 0) .false
    ? code.at((dec code.len))
     > (./leaf span shape text) (eq word text)
    .false
  + starts_with_definition
    \ word=str code=row[rex]
    ^ bool
    ? (eq code.len 0) .false
    ? code.at(0)
     > (./open span rune kids)
      ? !(eq rune "+") .false
      ? (eq kids.len 0) .false
      ? kids.at(0)
       > (./leaf span shape text) (eq word text)
      .false
    .false
  + fixture_summary
    \ text=str
    ^ row[nat]
    = doc | grove_checks/doc text
      adjustment | grove_checks/body_named "adjustment" doc
      entry | grove_checks/body_named "entry" doc
      ordered | grove_checks/body_named "ordered" doc
      ors | grove_checks/groups (grove/block_kind/or) entry
      opts | grove_checks/groups (grove/block_kind/opt) entry
      get | grove_checks/groups (grove/block_kind/get) ordered
      code | (grove_checks/implementations get).at(0).code
      impls | doc.items.map(grove_checks/item_implementations)
    [1
     (grove_checks/sum doc.items.map(grove_checks/import_count))
     (grove_checks/sum doc.items.map(grove_checks/declaration_count))
     (grove_checks/sum doc.items.map(grove_checks/tree_count))
     (grove_checks/sum impls.map(row/len[grove/implementation]))
     (grove_checks/sum adjustment.map(grove_checks/tag_count))
     (grove_checks/sum ors.map(grove_checks/property_count))
     (grove_checks/sum opts.map(grove_checks/property_count))
     (grove_checks/sum ors.map(grove_checks/comment_count))
     (grove_checks/implementations get).len
     (grove_checks/starts_with_definition "cmp" code)
     (grove_checks/ends_with "out" code)]
  + sample
    ^ str
    | grove_checks/lines
      ["#import sys=sys/slots" "" "x =" "  @type" "  @slot"
       "  #meta ;" "    sys/title: ""hello"""
       "  ! foil" "  + answer 42"]
  + parsing
    \ ignored=unit
    ^ row[testing/check]
    = src grove_checks/sample
      doc | grove_checks/doc src
      body | grove_checks/body_named "x" doc
      impls | grove_checks/implementations body
    [(testing/nat "empty document" 0 (grove_checks/doc "").items.len)
     (testing/nat "import and declaration" 2 doc.items.len)
     (testing/nat "multiple tags" 2
       (grove_checks/sum body.map(grove_checks/tag_count)))
     (testing/nat "embedded Foil" 1 impls.len)
     (testing/nat "code remains one surface Open" 1
       ?=((./open _ _ _) impls.at(0).code.at(0)))
     (testing/nat "declaration source line" 3
       (grove_checks/item_line doc.items.at(1)))]
  + item_line
    \ item=grove/item
    ^ nat
    ? item
     > (grove/declaration span name body) span.line
    0
  + errors
    \ ignored=unit
    ^ row[testing/check]
    = bad=row[str] [(grove_checks/lines ["x =" "  @unknown"])
           (grove_checks/lines ["x =" "  #what ; y"])
           (grove_checks/lines ["x =" "  #unknown ;" "    a: b"])
           (grove_checks/lines ["x =" "  a:"])
           "#import x"
           (grove_checks/lines ["x =" "  ! other" "  + x 1"])
           (grove_checks/lines ["x =" "  ! foil"])
           (grove_checks/lines ["x =" "  @slot" "" "+ stray 1"])]
      results | bad.map(grove/parse)
    [(testing/nat "malformed forms rejected" bad.len
       (grove_checks/sum
         results.map(either/is_err[grove/error grove/document])))
     (testing/nat "located syntax error" 2
       (grove_checks/error_line results.at(0)))]
  + error_line
    \ result=either[grove/error grove/document]
    ^ nat
    ? result
     > (./err cause)
      ? cause
       > (grove/error/syntax span message) span.line
      0
    0
  + opaque
    \ ignored=unit
    ^ row[testing/check]
    = span | rex/make_span 2 3 9 40
      first | rex/open span "!" [(rex/word "foil")]
      code | rex/heir span [(rex/word "a") (rex/word "b")]
      parsed | grove/read_body [(rex/heir span [first code])]
      body | either/ok_val parsed
      impls | grove_checks/implementations body
      bad | either/ok_val[any rex] (rex/parse (str/from_atom 34))
      prop | rex/rune ":" [(rex/word "key") bad]
      kept | either/ok_val (grove/read_statement prop)
    [(testing/nat "replacement code not flattened" 1
       (equal[row[rex]] [code] impls.at(0).code))
     (testing/nat "implementation span preserved" 1
       (equal[rex/source_span] span impls.at(0).span))
     (testing/nat "bad literal remains property payload" 1
       (grove_checks/property_matches bad kept))]
  + property_matches
    \ want=rex stmt=grove/statement
    ^ bool
    ? stmt
     > (grove/property span slot value) (equal[rex] want value)
    .false

+ tests
  ^ row[testing/case]
  [(testing/case "parsing" grove_checks/parsing)
   (testing/case "errors" grove_checks/errors)
   (testing/case "opaque Rex" grove_checks/opaque)]
