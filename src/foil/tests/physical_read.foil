- physical_read
- testing

' Internal selector tests. These do not introduce an HTTP route, serialize
' arbitrary pails, or claim that loading a cold record pin is byte-bounded.
+ physical_tests
  + version
    \ record=myth
    ^ saga
    | saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0)) (pin record)
  + history
    \ epoch=nat record=myth
    ^ tome
    | tome (pin (uon/sing[ass] ($u epoch) (ass/ker (physical_tests/version record))))
  + state
    \ index=axal[tome] top=nat
    ^ sov
    | sov (ledger [] []) index top (axal/new[urn] .none)
  + page
    \ query=physical_read/request state=sov
    ^ physical_read/page
    ? (physical_read/read query state)
     > (./ok page) page
     > (./err reason)
       = pages=row[physical_read/page] []
       | pages.at (Throw 700)
  + error
    \ query=physical_read/request state=sov
    ^ iota
    ? (physical_read/read query state)
     > (./err reason) reason
     > (./ok _) 'unexpected_success
  + rejects
    \ name=str reason=iota query=physical_read/request state=sov
    ^ testing/check
    | testing/nat name 1 (eq_iota reason (physical_tests/error query state))
  + keys
    \ page=physical_read/page
    ^ row[path]
    | page.entries.map
      \ entry=physical_read/entry
      ? entry
       > (./child key _) [key]
       > (./slot key _) key
  + numbers
    ' Force every selected natural pail, rather than checking only length.
    \ page=physical_read/page
    ^ row[nat]
    | page.entries.map
      \ entry=physical_read/entry
      ? entry
       > (./slot _ value)
         ? value
          > n=pails/n n.n
         999999
       > (./child _ node) node.epoch.fall(0)
  + child
    \ offset=nat page=physical_read/page
    ^ physical_read/node
    ? page.entries.at(offset)
     > (./child _ node) node
     > (./slot _ _)
       = nodes=row[physical_read/node] []
       | nodes.at (Throw 708)
  + seq
    \ count=nat
    ^ sov
    = index
        % n=nat 0 out=axal[tome] (axal/new[tome] .none)
        ? (eq n count) out
        | _ n.inc out.put([($u n)] (physical_tests/history 1 (myth/sing ['n] (pd n))))
    | physical_tests/state index 1
  + empty
    \ ignored=unit
    ^ row[testing/check]
    = root (physical_tests/page (physical_read/request [] .none 'children .none 40) sov/new)
      blank (physical_tests/state (axal/new[tome] (./some (physical_tests/history 1 myth/new))) 1)
      slots (physical_tests/page (physical_read/request [] .none 'slots .none 40) blank)
    [(testing/nat "empty namespace has a physical root" 0 root.total)
     (testing/nat "empty page has no entries" 0 root.entries.len)
     (testing/nat "empty page has no continuation" 1 (maybe/is_none root.next))
     (testing/nat "empty namespace captures epoch zero" 0 root.epoch)
     (testing/nat "transparent root is unknown, not deleted" 1 (equal[res[pin[myth]]] .unknown (physical_read/record root.own)))
     (testing/nat "empty asserted record has zero slots" 0 slots.total)
     (testing/nat "empty asserted record retains its assertion" 1 (maybe/is_some slots.own.assertion))
     (physical_tests/rejects "absent path is not an empty transparent node" 'path_missing
       (physical_read/request ['missing] .none 'children .none 40) sov/new)
     (physical_tests/rejects "transparent slots are explicitly missing" 'record_missing
       (physical_read/request [] .none 'slots .none 40) sov/new)]
  + large
    \ ignored=unit
    ^ row[testing/check]
    = state (physical_tests/seq 10000)
      query (physical_read/request [] .none 'children .none 40)
      first (physical_tests/page query state)
      next (physical_tests/page (physical_read/request [] (./some first.epoch) 'children first.next 40) state)
      final (physical_tests/page (physical_read/request [] (./some 1) 'children (./some [($u 9959)]) 40) state)
      terminal (physical_tests/page (physical_read/request [] (./some 1) 'children (./some [($u 9999)]) 40) state)
      absent (physical_tests/page (physical_read/request [] (./some 1) 'children (./some [($u 20000)]) 40) state)
      mini (physical_tests/page (physical_read/request [] .none 'children .none 1) state)
      keys (row/range 0 40).map((\ n=nat [($u n)]))
    [(testing/nat "10k direct physical keys use cached total" 10000 first.total)
     (testing/nat "first page contains at most forty entries" 40 first.entries.len)
     (testing/nat "ascending numeric keys retain 9 before 10" 1 (equal keys (physical_tests/keys first)))
     (testing/nat "lookahead is not the continuation cursor" 1 (equal[maybe[path]] (./some [($u 39)]) first.next))
     (testing/nat "exclusive cursor starts at following child" 1 (equal [($u 40)] (physical_tests/keys next).at(0)))
     (testing/nat "all displayed children have their own epoch" 1 (equal (row/range 0 40).map((\ n=nat 1)) (physical_tests/numbers first)))
     (testing/nat "exact terminal page retains forty entries" 40 final.entries.len)
     (testing/nat "exact terminal page has no false continuation" 1 (maybe/is_none final.next))
     (testing/nat "maximum cursor yields an empty page" 0 terminal.entries.len)
     (testing/nat "absent cursor beyond maximum yields empty" 0 absent.entries.len)
     (testing/nat "minimum limit has one result" 1 mini.entries.len)
     (testing/nat "minimum limit continues from displayed zero key" 1 (equal[maybe[path]] (./some [($u 0)]) mini.next))
     (testing/nat "request path survives unchanged" 1 (equal query.pax first.pax))
     (testing/nat "request collection survives unchanged" 1 (eq_iota query.collection first.collection))
     (testing/nat "same immutable snapshot gives identical page" 1 (equal first (physical_tests/page query state)))]
  + all_pages
    \ ignored=unit
    ^ row[testing/check]
    = state (physical_tests/seq 257)
      keys
        % after=maybe[path] .none out=row[path] []
        = page (physical_tests/page (physical_read/request [] (./some 1) 'children after 17) state)
          next out.weld((physical_tests/keys page))
        ? (maybe/is_none page.next) next
        | _ page.next next
      trimmed state.set_idx(state.idx.set_kid(state.idx.kid.del2(($u 16))))
      after_missing (physical_tests/page (physical_read/request [] (./some 1) 'children (./some [($u 16)]) 2) trimmed)
    [(testing/nat "complete pagination emits every physical key once" 1
       (equal (row/range 0 257).map((\ n=nat [($u n)])) keys))
     (testing/nat "exclusive absent cursor still seeks a successor" 1
       (equal [[($u 17)] [($u 18)]] (physical_tests/keys after_missing)))]
  + structure
    \ ignored=unit
    ^ row[testing/check]
    = record (myth/sing ['value] (pt "root"))
      old (physical_tests/version record)
      changed (physical_tests/version record.put(['value] (pt "new")))
      history (uon/sing[ass] ($u 1) (ass/ker old)).put(($u 4) (ass/ker changed))
      dead (tome (pin (uon/sing[ass] ($u 3) (ass/nul old.aeon))))
      index (axal/new[tome] (./some (tome (pin history))))
      index index.put(['live] (physical_tests/history 2 record))
      index index.put(['live 'hidden] (physical_tests/history 2 record))
      index index.put(['spine 'deep] (physical_tests/history 2 record))
      index index.put(['dead] dead)
      index index.put(['future] (physical_tests/history 9 record))
      state (physical_tests/state index 5)
      page (physical_tests/page (physical_read/request [] .none 'children .none 40) state)
      spine (physical_tests/page (physical_read/request ['spine] .none 'children .none 40) state)
      gone (physical_tests/page (physical_read/request ['dead] .none 'children .none 40) state)
      future (physical_tests/page (physical_read/request ['future] .none 'children .none 40) state)
      frontier
        ? state.y_at(5 [])
         > (./known tree) tree
        | axal/new[myth] .none
    [(testing/nat "physical direct children include transparent and history-only nodes" 4 page.total)
     (testing/nat "page epoch is sovereign epoch, not own assertion epoch" 5 page.epoch)
     (testing/nat "own assertion floor retains its actual epoch" 4 page.own.epoch.fall(0))
     (testing/nat "own record remains the original assertion pin" 1
       (equal[res[pin[myth]]] (./known changed.myth) (physical_read/record page.own)))
     (testing/nat "transparent spine has no invented assertion" 1 (maybe/is_none spine.own.assertion))
     (testing/nat "transparent spine has one physical child" 1 spine.total)
     (testing/nat "tombstone remains distinct from unknown" 1 (equal[res[pin[myth]]] .null (physical_read/record gone.own)))
     (testing/nat "tombstone retains actual assertion epoch" 3 gone.own.epoch.fall(0))
     (testing/nat "history-only future node has no present assertion" 1 (maybe/is_none future.own.assertion))
     (physical_tests/rejects "tombstone slot selection refuses" 'record_deleted
       (physical_read/request ['dead] .none 'slots .none 40) state)
     (testing/nat "physical page does not flatten through a transparent spine" 1
       (equal[row[path]] [['dead] ['future] ['live] ['spine]] (physical_tests/keys page)))
     (testing/nat "existing y frontier still crosses a transparent spine" 1 (maybe/is_some frontier.get(['spine 'deep])))
     (testing/nat "existing y frontier still stops at nearest live child" 1 (maybe/is_none frontier.get(['live 'hidden])))
     (testing/nat "physical selection leaves y snapshot unchanged" 1 (equal[res[axal[myth]]] (./known frontier) state.y_at(5 [])))]
  + long_path
    \ count=nat
    ^ path
    | (row/range 0 count).map (\ n=nat 'b)
  + slots
    \ ignored=unit
    ^ row[testing/check]
    = deep (physical_tests/long_path 80)
      empty=myth myth/new
      record empty.put([] (pd 0)).put(['a] (pd 1)).put(['a 'b] (pd 2)).put(deep (pd 3)).put(['z] (pd 4))
      index (axal/new[tome] .none).put(deep (physical_tests/history 7 record))
      state (physical_tests/state index 9)
      first (physical_tests/page (physical_read/request deep .none 'slots .none 1) state)
      second (physical_tests/page (physical_read/request deep (./some 9) 'slots first.next 2) state)
      deep_page (physical_tests/page (physical_read/request deep (./some 9) 'slots second.next 1) state)
      final (physical_tests/page (physical_read/request deep (./some 9) 'slots deep_page.next 1) state)
      everything (physical_tests/page (physical_read/request deep .none 'slots .none 40) state)
      missing_cursor (physical_tests/page (physical_read/request deep (./some 9) 'slots (./some ['a 'c]) 1) state)
    [(testing/nat "target path beyond sixty-four segments remains addressable" 80 first.pax.len)
     (testing/nat "opaque slot total is not namespace descendant count" 5 first.total)
     (testing/nat "empty slot key remains a real displayed key" 1 (equal[row[path]] [[]] (physical_tests/keys first)))
     (testing/nat "empty slot cursor is distinct from no cursor" 1 (equal[maybe[path]] (./some []) first.next))
     (testing/nat "empty cursor correctly advances to nonempty keys" 1 (equal[row[path]] [['a] ['a 'b]] (physical_tests/keys second)))
     (testing/nat "multisegment slot is retained as one opaque key" 1 (equal[maybe[path]] (./some ['a 'b]) second.next))
     (testing/nat "generated long cursor is not truncated" 1 (equal[maybe[path]] (./some deep) deep_page.next))
     (testing/nat "generated long cursor roundtrips to following slot" 1 (equal[row[path]] [['z]] (physical_tests/keys final)))
     (testing/nat "last slot has no cursor" 1 (maybe/is_none final.next))
     (testing/nat "all selected pails retain exact values" 1 (equal[row[nat]] [0 1 2 3 4] (physical_tests/numbers everything)))
     (testing/nat "absent opaque cursor seeks using path comparator" 1 (equal [deep] (physical_tests/keys missing_cursor)))
     (testing/nat "slot own epoch differs legitimately from request epoch" 7 first.own.epoch.fall(0))]
  + missing_index
    \ code=nat
    ^ axal[tome]
    = indexes=row[axal[tome]] []
    | indexes.at (Throw code)
  + validation
    \ ignored=unit
    ^ row[testing/check]
    = poisoned (physical_tests/state (physical_tests/missing_index 701) 7)
    [(physical_tests/rejects "zero limit rejects before index access" 'invalid_limit
       (physical_read/request [] .none 'children .none 0) poisoned)
     (physical_tests/rejects "over-limit rejects before index access" 'invalid_limit
       (physical_read/request [] .none 'children .none 41) poisoned)
     (physical_tests/rejects "unknown collection rejects before index access" 'invalid_collection
       (physical_read/request [] .none 'unknown .none 2) poisoned)
     (physical_tests/rejects "history overlay is not silently resolved physically" 'derived_path
       (physical_read/request ['h] .none 'children .none 2) poisoned)
     (physical_tests/rejects "overlay lens is not silently resolved physically" 'derived_path
       (physical_read/request ['o 'root] .none 'children .none 2) poisoned)
     (physical_tests/rejects "view lens is not silently resolved physically" 'derived_path
       (physical_read/request ['x 'root] .none 'children .none 2) poisoned)
     (physical_tests/rejects "empty children cursor is invalid" 'invalid_cursor
       (physical_read/request [] (./some 7) 'children (./some []) 2) poisoned)
     (physical_tests/rejects "children cursor cannot contain multiple segments" 'invalid_cursor
       (physical_read/request [] (./some 7) 'children (./some ['a 'b]) 2) poisoned)
     (physical_tests/rejects "children continuation cannot float epochs" 'epoch_required
       (physical_read/request [] .none 'children (./some ['a]) 2) poisoned)
     (physical_tests/rejects "empty opaque slot continuation still requires epoch" 'epoch_required
       (physical_read/request [] .none 'slots (./some []) 2) poisoned)
     (physical_tests/rejects "older epoch conflicts before any index access" 'epoch_conflict
       (physical_read/request [] (./some 6) 'children .none 2) poisoned)
     (physical_tests/rejects "future epoch conflicts before any index access" 'epoch_conflict
       (physical_read/request [] (./some 8) 'children .none 2) poisoned)
     (physical_tests/rejects "older continuation conflicts before any index access" 'epoch_conflict
       (physical_read/request [] (./some 6) 'slots (./some ['a]) 2) poisoned)]
  + epochs
    \ ignored=unit
    ^ row[testing/check]
    = state (physical_tests/seq 3)
      first (physical_tests/page (physical_read/request [] .none 'children .none 1) state)
      grown state.set_idx(state.idx.put([($u 3)] (physical_tests/history 2 myth/new))).set_top(2)
      latest (physical_tests/page (physical_read/request [] .none 'children .none 1) grown)
    [(physical_tests/rejects "committed growth invalidates captured continuation" 'epoch_conflict
       (physical_read/request [] (./some first.epoch) 'children first.next 1) grown)
     (testing/nat "explicit latest restart captures new epoch" 2 latest.epoch)
     (testing/nat "latest restart sees new physical total" 4 latest.total)
     (testing/nat "original immutable state retains original total" 3
       (physical_tests/page (physical_read/request [] (./some first.epoch) 'children .none 1) state).total)]
  + bad_child
    \ code=nat
    ^ axal/k[tome]
    = links=row[axal/k[tome]] []
    | links.at (Throw code)
  + guarded_children
    \ limit=nat
    ^ physical_read/page
    = child (axal/k[tome] (pin (axal/new[tome] .none)))
      kids=bee[axal/k[tome]] (bee/leaf[axal/k[tome]]
        [(bee/kv[axal/k[tome]] ($u 0) child)
         (bee/kv[axal/k[tome]] ($u 1) (physical_tests/bad_child 702))
         (bee/kv[axal/k[tome]] ($u 2) (physical_tests/bad_child 703))])
      state (physical_tests/state (axal[tome] .none kids) 1)
    | physical_tests/page (physical_read/request [] .none 'children .none limit) state
  + force_children
    \ limit=nat
    ^ row[nat]
    | physical_tests/numbers (physical_tests/guarded_children limit)
  + bad_pail
    \ code=nat
    ^ pail
    = values=row[pail] []
    | values.at (Throw code)
  + guarded_slots
    ' Exercise selection independently from unavoidable cold pin loading.
    \ limit=nat
    ^ physical_read/page
    = right=myth (mop/node[path pail lt_pith] 1 ['b] (physical_tests/bad_pail 704) (mop/empty) (mop/empty))
      record=myth (mop/node[path pail lt_pith] 2 ['a] (pd 1) (mop/empty) right)
      own (physical_read/node .none .none 0)
    | physical_read/slots (physical_read/request [] (./some 1) 'slots .none limit) 1 own record
  + force_slots
    \ limit=nat
    ^ row[nat]
    | physical_tests/numbers (physical_tests/guarded_slots limit)
  + force_bad_index
    \ ignored=nat
    ^ nat
    | (physical_tests/page (physical_read/request [] (./some 7) 'children .none 1)
        (physical_tests/state (physical_tests/missing_index 705) 7)).total
  + bad_history
    \ code=nat
    ^ tome
    = histories=row[tome] []
    | histories.at (Throw code)
  + descendant_state
    ' A displayed child's grandchild has an unavailable history. Reading
    ' the selected child's own descriptor must not hydrate that history.
    \ code=nat
    ^ sov
    = grand (axal/k[tome] (pin (axal/new[tome] (./some (physical_tests/bad_history code)))))
      child (axal[tome] (./some (physical_tests/history 1 myth/new))
        (bee/leaf[axal/k[tome]] [(bee/kv[axal/k[tome]] 'grand grand)]))
      index (axal[tome] .none
        (bee/leaf[axal/k[tome]] [(bee/kv[axal/k[tome]] 'child (axal/k[tome] (pin child)))]))
    | physical_tests/state index 1
  + force_descendant
    \ ignored=nat
    ^ nat
    | (physical_tests/page (physical_read/request ['child 'grand] .none 'children .none 1)
        (physical_tests/descendant_state 706)).own.epoch.fall(0)
  + bad_record
    \ code=nat
    ^ pin[myth]
    = records=row[pin[myth]] []
    | records.at (Throw code)
  + held_state
    \ code=nat
    ^ sov
    = version (saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0))
        (physical_tests/bad_record code))
      history (tome (pin (uon/sing[ass] ($u 1) (ass/ker version))))
    | physical_tests/state (axal/new[tome] (./some history)) 1
  + force_record
    \ ignored=nat
    ^ nat
    | (physical_tests/page (physical_read/request [] .none 'slots .none 1)
        (physical_tests/held_state 707)).total
  + guards
    \ ignored=unit
    ^ row[testing/check]
    = child_page (physical_tests/guarded_children 1)
      slot_page (physical_tests/guarded_slots 1)
      child_control (Try physical_tests/force_children 2)
      slot_control (Try physical_tests/force_slots 2)
      index_control (Try physical_tests/force_bad_index 0)
      descendants (physical_tests/page (physical_read/request [] .none 'children .none 1)
        (physical_tests/descendant_state 706))
      selected (physical_tests/child 0 descendants)
      descendant_control (Try physical_tests/force_descendant 0)
      held (physical_tests/page (physical_read/request [] .none 'children .none 1)
        (physical_tests/held_state 707))
      record_control (Try physical_tests/force_record 0)
      live=bool
        ? (physical_read/record held.own)
         > (./known _) .true
        .false
    [(testing/nat "lookahead child key never resolves its unavailable node or history" 1
       (equal [[($u 0)]] (physical_tests/keys child_page)))
     (testing/nat "selected child own descriptor is fully usable" 1
       (equal (physical_read/node .none .none 0) (physical_tests/child 0 child_page)))
     (testing/nat "lookahead cursor comes from selected child" 1 (equal[maybe[path]] (./some [($u 0)]) child_page.next))
     (testing/nat "unselected child count is cached without resolution" 3 child_page.total)
     (testing/nat "lookahead pail is not forced while selecting one slot" 1
       (equal[row[nat]] [1] (physical_tests/numbers slot_page)))
     (testing/nat "lookahead pail key is not emitted" 1 (equal[row[path]] [['a]] (physical_tests/keys slot_page)))
     (testing/nat "control: selecting unavailable child throws" 1 (either/is_err child_control))
     (testing/nat "control: selecting unavailable pail and reading it throws" 1 (either/is_err slot_control))
     (testing/nat "control: valid request reaches poisoned index" 1 (either/is_err index_control))
     (testing/nat "selected child has one physical descendant without traversing it" 1 selected.children)
     (testing/nat "selected child's own history is fully resolved" 1 selected.epoch.fall(0))
     (testing/nat "selected child assertion is preserved" 1 (maybe/is_some selected.assertion))
     (testing/nat "control: directly selecting poisoned grandchild history throws" 1 (either/is_err descendant_control))
     (testing/nat "children page leaves own record pin unopened" 1 live)
     (testing/nat "own descriptor remains usable without opening its record" 1 held.own.epoch.fall(0))
     (testing/nat "control: slot selection opens unavailable own record" 1 (either/is_err record_control))]

+ tests
  ^ row[testing/case]
  [(testing/case "empty and absent physical records" physical_tests/empty)
   (testing/case "ten thousand physical children" physical_tests/large)
   (testing/case "complete exclusive pagination" physical_tests/all_pages)
   (testing/case "assertion floors and unchanged y frontier" physical_tests/structure)
   (testing/case "opaque slots and deep cursor roundtrip" physical_tests/slots)
   (testing/case "pre-index request validation" physical_tests/validation)
   (testing/case "strict sovereign epoch continuation" physical_tests/epochs)
   (testing/case "bounded selection and positive poison controls" physical_tests/guards)]
