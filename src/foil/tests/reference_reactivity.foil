- tests/namespace [at=fixture]
- tests/cells [at=fixture]
- tests/composition [at=fixture]
- helm
- testing

+ reference_reactivity
  + refresh
    \ b=bowl record=myth changed=row[dep]
    ^ yell
    = tree (b.crew.gut(['incoming] (axal/new[myth] .none)))
      count tree.fil.fall(myth/new).nat_at(['count] 999)
    | yell [] record.put(['count] (pails/n count)).put(['notifications] (pails/n record.nat_at(['notifications] 0).inc))
  + write
    \ target=path command=writ state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/handle
        (helm/card/step target command) state (sovereign_hive state))
    ?> (./ack failure) reply state
    ? (maybe/is_some failure) state
    next
  + fixed_view
    \ context=myth input=axal[myth]
    ^ axal[myth]
    | (axal/new[myth] (./some (myth/sing ['count] (pails/n context.nat_at(['count] 7))))).put(['child] (myth/sing ['count] (pails/n 9)))
  + echo
    \ context=myth input=axal[myth]
    ^ axal[myth]
    input
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      root=path [($x 1) 'later_cell]
      exact=path [($x 1) 'exact_waiter]
      child=path [($x 1) 'child_waiter]
      behavior=path [($x 1) 'kook 'cell_waiter]
      target=path [($x 1) 'input]
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put behavior (form/card def_form.set_hear(reference_reactivity/refresh) (lore/line "Cell creation watcher")) initial.local)
      local (fixture/cell_tests/put target (myth/sing ['count] (pails/n 7)) local)
      local (fixture/cell_tests/put target.snoc('child) (myth/sing ['count] (pails/n 9)) local)
      initial initial.set_local(local)
      definition (myth/sing bond/weft (spun reference_reactivity/fixed_view .none)).put(bond/tack (safe 0 .z target))
      exact_record (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x root.cons(xs)))))
      child_record (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x root.snoc('child).cons(xs)))))
      grouped=namespace
        ?> (./ok next) (grove_install/changes [[root (writ/make definition)] [exact (writ/make exact_record)] [child (writ/make child_record)]] initial) initial
        next
      awaiting initial.set_local((fixture/cell_tests/put child child_record (fixture/cell_tests/put exact exact_record initial.local)))
      created (reference_reactivity/write root (writ/make definition) awaiting)
      inert awaiting.set_local((fixture/cell_tests/put root (myth/sing ['text] (pails/t "Not a cell yet")) awaiting.local))
      activated (reference_reactivity/write root (writ/make definition) inert)
      closer definition.put(['count] (pails/n 11))
      shadowed (reference_reactivity/write root.snoc('child) (writ/make closer) created)
      withdrawn (reference_reactivity/write root.snoc('child) .cull shadowed)
      outer=path [($x 1) 'nested_view]
      nested_watcher=path [($x 1) 'nested_waiter]
      outer_record (myth/sing bond/weft (spun reference_reactivity/echo .none)).put(bond/tack (safe 0 .x root.snoc('child).cons(xs)))
      nested_record (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x outer.cons(xs)))))
      nested created.set_local((fixture/cell_tests/put nested_watcher nested_record (fixture/cell_tests/put outer outer_record created.local)))
      nested_shadowed (reference_reactivity/write root.snoc('child) (writ/make closer) nested)
      nested_withdrawn (reference_reactivity/write root.snoc('child) .cull nested_shadowed)
      ordinary=path [($x 1) 'ordinary_view]
      ordinary_record (myth/sing bond/weft (spun reference_reactivity/echo .none))
      overlay (fixture/composition_tests/overlay ordinary target)
      overlay_outer outer_record.put(bond/tack (safe 0 .x overlay))
      nested_overlay nested.set_local((fixture/cell_tests/put outer overlay_outer (fixture/cell_tests/put ordinary ordinary_record nested.local)))
      overlay_changed (reference_reactivity/write target (writ/poke (myth/sing ['count] (pails/n 13))) nested_overlay)
      choices (xv_trigger_reader root.snoc('child).cons(xs) (sovereign_reader created))
      count
        \ at=path state=namespace
        ^ nat
        | (sovereign_peek at state).fil.fall(myth/new).nat_at(['count] 999)
    [(testing/nat "nearer explicit cell shadows virtual child reactively" 11 (count child shadowed))
     (testing/nat "removing nearer definition restores virtual child reactively" 9 (count child withdrawn))
     (testing/nat "nested ordinary cell wakes when a nearer cell is created" 11 (count nested_watcher nested_shadowed))
     (testing/nat "nested ordinary cell wakes when the nearer cell is removed" 9 (count nested_watcher nested_withdrawn))
     (testing/nat "nested ordinary overlay observes its physical input" 13 (count nested_watcher overlay_changed))
     (testing/nat "definition choice ignores ancestors above resolved root" 0 (choices.any((\ dependency (equal[path] dependency.p root.take(1))))))
     (testing/nat "unresolved nested cell retains defining record trigger" 1
       ((xv_trigger_reader root.cons(xs).cons(xs) (sovereign_reader initial)).any((\ dependency (and (equal[care] dependency.c .x) (equal[path] dependency.p root))))))
     (testing/nat "same admission creates cell and wakes its watcher" 7 (count exact grouped))
     (testing/nat "same admission wakes virtual child watcher" 9 (count child grouped))
     (testing/nat "missing cell creation wakes existing watcher" 7 (count exact created))
     (testing/nat "missing ancestor definition wakes virtual child watcher" 9 (count child created))
     (testing/nat "ordinary record becoming cell wakes watcher" 7 (count exact activated))
     (testing/nat "ordinary ancestor becoming cell wakes virtual child watcher" 9 (count child activated))]

+ tests
  ^ row[testing/case]
  [(testing/case "native cell and composed overlay reactivity" reference_reactivity/checks)]
