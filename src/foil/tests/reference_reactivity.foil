- tests/namespace [at=fixture]
- reference_index
- tests/cells [at=fixture]
- helm
- testing

' A watcher of a /r listing wakes exactly when an edge to its target
' appears or ends, through a live commit and through reconciliation, and
' a listing read in a mount's spelling wakes on edges to the publisher's
' name.
+ reference_reactivity
  + refresh
    \ b=bowl record=myth changed=row[dep]
    ^ yell
    = tree (b.crew.gut(['incoming] (axal/new[myth] .none)))
      count (tree.fil.fall(myth/new)).nat_at(['count] 999)
    | yell [] record.put(['count] (pails/n count)).put(['notifications] (pails/n record.nat_at(['notifications] 0).inc))

  + write
    \ target=path command=writ state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/handle
        (helm/card/step target command) state (sovereign_hive state))
    ?> (./ack failure) reply state
    ? (maybe/is_some failure) state
    next

  + watching
    \ watcher=path behavior=path listing=path local=sov
    ^ sov
    | fixture/cell_tests/put watcher (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .z listing)))) local

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 1) 'subject]
      holder=path [($x 1) 'claim]
      watcher=path [($x 1) 'watcher]
      remote_watcher=path [($x 1) 'remote_watcher]
      behavior=path [($x 1) 'kook 'incoming]
      mount=path [($x 1) 'her ($x 2) 'widgets]
      published=path [($x 2) 'our ($x 1) 'widgets]
      citing=path [($x 1) 'needs 'w]
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put behavior (form/card def_form.set_hear(reference_reactivity/refresh) (lore/line "Incoming reference watcher")) initial.local)
      local (reference_reactivity/watching watcher behavior (r_spell target) local)
      local (reference_reactivity/watching remote_watcher behavior (r_spell mount) local)
      initial initial.set_local(local)
      relation (myth/sing ['property] (safe 0 .x target))
      added (reference_reactivity/write holder (writ/make relation) initial)
      edited (reference_reactivity/write holder (writ/poke (myth/sing ['description] (pails/t "Only a literal edit"))) added)
      removed (reference_reactivity/write holder .cull edited)
      cited (reference_reactivity/write citing (writ/make (myth/sing ['source] (safe 0 .x published))) initial)
      published_state=namespace
        ?> (./accepted committed) (namespace/step (axal/new[note] .none).put(holder (note/make relation)) 0 0 initial) initial
        committed.state
      reconciled=namespace
        ?> (./ok next) (sovereign_reconcile initial published_state 0 0) published_state
        next
      read
        \ at=path state=namespace
        ^ myth
        | (sovereign_peek at state).fil.fall myth/new
    [(testing/nat "the first incoming edge wakes a watcher of the listing" 1 (read watcher added).nat_at(['count] 999))
     (testing/nat "a literal edit does not wake it" 1 (read watcher edited).nat_at(['notifications] 0))
     (testing/nat "ending the last edge wakes it with an empty listing" 0 (read watcher removed).nat_at(['count] 999))
     (testing/nat "reconciliation wakes it from the listing's case" 1 (read watcher reconciled).nat_at(['count] 999))
     (testing/nat "a listing in a mount's spelling wakes on the publisher's name" 1 (read remote_watcher cited).nat_at(['count] 999))
     (testing/nat "an edge elsewhere does not wake the mount's watcher" 0 (read remote_watcher added).nat_at(['notifications] 0))]

+ tests
  ^ row[testing/case]
  [(testing/case "reactive reverse listings" reference_reactivity/checks)]
