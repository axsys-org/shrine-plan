- tests/namespace [at=fixture]
- reference_index
- tests/cells [at=fixture]
- helm
- graph
- testing

+ reference_reactivity
  + incoming
    ' Keep the fixture's configuration out of the reference index so the
    ' first tested relationship really is the first edge to this target.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    = target (context.path_at(['target])).fall([])
    | ./graft (safe 0 cr (r_spell target).weld(relative))

  + refresh
    \ b=bowl record=myth changed=row[dep]
    ^ yell
    = tree (b.crew.gut(['incoming] (axal/new[myth] .none)))
      count (tree.fil.fall(myth/new)).nat_at(['count] 999)
    | yell [] record.put(['count] (pails/n count)).put(['notifications] (pails/n record.nat_at(['notifications] 0).inc))

  + write
    \ target=path command=writ state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/handle
        (helm/card/step target command) state (sovereign_hive state))
    ?> (./ack failure) reply state
    ? (maybe/is_some failure) state
    next

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($x 1) 'subject]
      holder=path [($x 1) 'claim]
      cell=path [($x 1) 'incoming]
      watcher=path [($x 1) 'watcher]
      behavior=path [($x 1) 'kook 'incoming]
      query_path=path ['x ($x 1) 'incoming]
      initial fixture/namespace_tests/initial
      local (fixture/cell_tests/put behavior (form/card def_form.set_hear(reference_reactivity/refresh) (lore/line "Incoming reference watcher")) initial.local)
      local (fixture/cell_tests/put cell (myth/sing bond/weft (woven reference_reactivity/incoming)).put(['target] (pails/p target)) local)
      local (fixture/cell_tests/put watcher (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x query_path)))) local)
      initial initial.set_local(local)
      relation (myth/sing ['property] (safe 0 .x target))
      added (reference_reactivity/write holder (writ/make relation) initial)
      edited (reference_reactivity/write holder (writ/poke (myth/sing ['description] (pails/t "Only a literal edit"))) added)
      removed (reference_reactivity/write holder .cull edited)
      published=namespace
        ?> (./accepted committed) (namespace/step (axal/new[note] .none).put(holder (note/make relation)) 0 0 initial) initial
        committed.state
      reconciled=namespace
        ?> (./ok next) (sovereign_reconcile initial published 0 0) published
        next
      read
        \ state=namespace
        ^ myth
        | (sovereign_peek watcher state).fil.fall myth/new
    [(testing/nat "first incoming edge wakes a watcher of the computed view" 1 (read added).nat_at(['count] 999))
     (testing/nat "literal edit does not wake a reverse-only watcher" 1 (read edited).nat_at(['notifications] 0))
     (testing/nat "removing the last incoming edge refreshes the computed view" 0 (read removed).nat_at(['count] 999))
     (testing/nat "publication reconciliation follows reverse dependencies through a cell" 1 (read reconciled).nat_at(['count] 999))]

+ tests
  ^ row[testing/case]
  [(testing/case "reactive incoming reference views" reference_reactivity/checks)]
