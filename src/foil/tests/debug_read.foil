- tests/physical_read
- helm
- testing
- tests/namespace [at=fixture]
- tests/namespace_views [at=views]

+ debug_read_tests
  + state
    \ count=nat
    ^ sov
    = card
        % i=nat 0 out=myth (myth/sing ['sys 'lede] (pails/t "Test namespace"))
        ? (eq i count) out
        | _ i.inc out.put([($u i)] (pd i))
      live (physical_tests/history 1 card)
      child (physical_tests/history 1 (myth/sing ['sys 'lede] (pails/t "Child")))
      index
        % i=nat 0 out=axal[tome] (axal/new[tome] (./some live))
        ? (eq i count) out
        | _ i.inc out.put([($u i)] child).put([($u i) 'deep] child)
    | physical_tests/state index 1
  + answer
    \ query=debug_read/request state=sov
    ^ debug_read/result
    ? (debug_read/safe_read query state)
     > (./ok answer) answer
     > (./err _) (debug_read/result [] (axal/new[myth] .none) (axal/new[myth] .none)
         [] (debug_read/page 0 .none .none 0 .none .none 0) 'document .false)
  + qualify
    \ state=sov
    ^ namespace
    = initial fixture/namespace_tests/initial
      index (axal/new[tome] .none)
      local state.set_idx(index.set_kid(index.kid_put(initial.self state.idx)))
    | namespace initial.self local initial.system
  + bounds
    \ ignored=unit
    ^ row[testing/check]
    = state (debug_read_tests/state 101)
      query (debug_read/request [] .none .none .none 'workspace)
      first (debug_read_tests/answer query state)
      second (debug_read_tests/answer (debug_read/request [] (./some first.paging.epoch)
        first.paging.next_children first.paging.next_slots 'workspace) state)
      outline (debug_read_tests/answer query.set_scope('outline) state)
      qualified (debug_read_tests/qualify state)
      reactive (sovereign_hive qualified)
      [same index answer] (helm/supervisor/handle
        (helm/card/debug 17 query.set_pax([qualified.self])) qualified reactive)
      shallow (first.view.kid_tap.all((\ entry (eq entry.val.kid.size 0))))
    [(testing/nat "physical children selected before render" 40 first.view.kid.size)
     (testing/nat "no grandchild hydration" 1 shallow)
     (testing/nat "all physical children counted" 101 first.paging.child_count)
     (testing/nat "all own slots counted" 102 first.paging.slot_count)
     (testing/nat "slot page stays bounded including semantic metadata" 1
       (le first.view.fil.fall(myth/new).size 41))
     (testing/nat "outline carries semantic metadata only" 1 outline.view.fil.fall(myth/new).size)
     (testing/nat "next child page is different" 0 (equal first.view.kid.keys second.view.kid.keys))
     (testing/nat "reads preserve complete namespace" 1 (equal qualified same))
     (testing/nat "reads preserve index" 1 (equal index reactive))
     (testing/nat "stale continuation rejected" 1
       (equal (debug_read/safe_read query.set_epoch((./some 0)) state) (either/err[iota debug_read/result] 'epoch_conflict)))
     (testing/nat "cursor requires captured epoch" 1
       (equal (debug_read/safe_read query.set_children((./some [($u 10)])) state) (either/err[iota debug_read/result] 'epoch_required)))]
  + frontier
    \ ignored=unit
    ^ row[testing/check]
    = live (physical_tests/history 1 myth/new)
      history (uon/sing[ass] ($u 1) (ass/ker (physical_tests/version myth/new)))
      gone (tome (pin history.put(($u 2) (ass/nul (physical_tests/version myth/new).aeon))))
      index (axal/new[tome] (./some live))
      index index.put(['barrier] live).put(['barrier 'hidden] live)
      index index.put(['transparent 'leaf] live).put(['gone] gone).put(['gone 'visible] live)
      state (physical_tests/state index 2)
      current=maybe[axal[myth]]
        ? state.y_at(2 [])
         > (./known tree) (./some tree)
        .none
      earlier=maybe[axal[myth]]
        ? state.y_at(1 [])
         > (./known tree) (./some tree)
        .none
      actual current.fall((axal/new[myth] .none))
      old earlier.fall((axal/new[myth] .none))
      missing=res[axal[myth]] .unknown
    [(testing/nat "live record terminates frontier" 0 (maybe/is_some actual.get(['barrier 'hidden])))
     (testing/nat "transparent path passes through" 1 (maybe/is_some actual.get(['transparent 'leaf])))
     (testing/nat "tombstone passes through" 1 (maybe/is_some actual.get(['gone 'visible])))
     (testing/nat "earlier live record still terminates" 0 (maybe/is_some old.get(['gone 'visible])))
     (testing/nat "unknown root stays unknown" 1 (equal (state.y_at(2 ['missing])) missing))]
  + namespace_fixture
    ^ namespace
    = initial fixture/namespace_tests/initial
      shared (views/namespace_view_tests/put ['sys 'value]
        (myth/sing ['text] (pails/t "shared")) (unpin initial.system).state)
      identity
        \ record=myth
        ^ myth
        record
      shared (views/namespace_view_tests/put ['sys 'view 'identity]
        (myth/sing bond/weft (dyed identity .none)) shared)
      local (views/namespace_view_tests/put [initial.self 'value]
        (myth/sing ['text] (pails/t "local")) initial.local)
      local (views/namespace_view_tests/put [initial.self 'other] myth/new local)
      local (views/namespace_view_tests/put [initial.self 'last] myth/new local)
    | namespace initial.self local
      (pin (system_publication shared.top shared (system_publication/assigned shared)))
  + namespace_answer
    \ query=debug_read/request state=namespace
    ^ debug_read/result
    ? (debug_read/namespace_safe_read query state)
     > (./ok answer) answer
     > (./err _) (debug_read/result [] (axal/new[myth] .none) (axal/new[myth] .none)
         [] (debug_read/page 0 .none .none 0 .none .none 0) 'document .false)
  + authorities
    \ ignored=unit
    ^ row[testing/check]
    = state debug_read_tests/namespace_fixture
      shared (unpin state.system).state
      base (debug_read/request [] .none .none .none 'workspace)
      local (debug_read_tests/namespace_answer base.set_pax([state.self 'value]) state)
      system (debug_read_tests/namespace_answer base.set_pax(['sys 'value]) state)
      root (debug_read_tests/namespace_answer base state)
      grown state.set_local((views/namespace_view_tests/put [state.self 'new] myth/new state.local))
      stable (debug_read_tests/namespace_answer
        base.set_pax(['sys 'value]).set_epoch((./some shared.top)) grown)
      stale (debug_read/namespace_safe_read
        base.set_pax([state.self 'value]).set_epoch((./some state.local.top)) grown)
      history=path ['h 'x ($u 1) ($u 2) 'sys 'value]
      historical (debug_read_tests/namespace_answer base.set_pax(history) state)
      overlay=path ['o ($u 1) ($u 3) 'sys 'view 'identity ($u 2) state.self 'value]
      transformed (debug_read_tests/namespace_answer base.set_pax(overlay) state)
      physical (physical_read/namespace_read
        (physical_read/request ['sys 'value] (./some shared.top) 'slots .none 1) grown)
      physical_epoch=nat
        ? physical
         > (./ok page) page.epoch
         > (./err _) 0
      exact (value_read/namespace_safe_read
        (value_read/request ['sys 'value] ['text] shared.top 0 6) grown)
      bytes=str
        ? exact
         > (./ok chunk) chunk.hex
         > (./err _) ""
      foreign (debug_read/namespace_safe_read base.set_pax([($x 2) 'value]) state)
      denied (debug_read_tests/namespace_answer base.set_pax([state.self 'log]) state)
      invalid base.set_pax(history).set_epoch((./some state.local.top)).set_children((./some []))
    [(testing/nat "fixture has independent authority clocks" 0 (eq shared.top state.local.top))
     (testing/nat "physical local read uses local epoch" state.local.top local.paging.epoch)
     (testing/nat "system read uses publication epoch" shared.top system.paging.epoch)
     (testing/nat "local edit does not invalidate immutable system cursor" shared.top stable.paging.epoch)
     (testing/nat "local edit invalidates local cursor" 1
       (equal stale (either/err[iota debug_read/result] 'epoch_conflict)))
     (testing/nat "root exposes only two authority links" 2 root.view.kid.size)
     (testing/nat "root has no fabricated version" 0 root.versions.wyt)
     (testing/nat "root does not hydrate authority children" 1
       (root.view.kid_tap.all((\ entry (eq entry.val.kid.size 0)))))
     (testing/nat "system byte read uses correct history" 1 (equal[str] bytes "736861726564"))
     (testing/nat "system physical page uses correct history" shared.top physical_epoch)
     (testing/nat "foreign authority rejected" 1
       (equal foreign (either/err[iota debug_read/result] 'unknown_authority)))
     (testing/nat "system is read-only" 0 system.writable)
     (testing/nat "local own record is writable" 1 local.writable)
     (testing/nat "local journal is protected" 0 denied.writable)
     (testing/nat "system historical view resolves its authority" 1
       (equal[str] historical.view.fil.fall(myth/new).txt_at(['text]) "shared"))
     (testing/nat "system transformation can read local authority" 1
       (equal[str] transformed.view.fil.fall(myth/new).txt_at(['text]) "local"))
     (testing/nat "derived cursor is a render revision" state.local.top historical.paging.epoch)
     (testing/nat "derived child cursor must identify one child" 1
       (equal (debug_read/namespace_safe_read invalid state)
         (either/err[iota debug_read/result] 'invalid_cursor)))
     (testing/nat "derived output never becomes writable" 0 transformed.writable)]
  + derived_versions
    \ ignored=unit
    ^ row[testing/check]
    = initial debug_read_tests/namespace_fixture
      source=path [initial.self 'value]
      child source.snoc('child)
      before (views/namespace_view_tests/put child
        (myth/sing ['text] (pails/t "earlier child")) initial.local)
      later (views/namespace_view_tests/put child
        (myth/sing ['text] (pails/t "latest child")) before)
      transform=path ['sys 'view 'subtree]
      identity
        \ tree=axal[myth]
        ^ axal[myth]
        tree
      render
        \ record=myth tree=axal[myth]
        ^ axal[myth]
        tree
      shared (views/namespace_view_tests/put transform
        (myth/sing bond/weft (sewn identity .none)) (unpin initial.system).state)
      shared (views/namespace_view_tests/put ['sys 'view 'render]
        (myth/sing bond/weft (spun render .none)) shared)
      declaration=path [initial.self 'render]
      declared (myth/sing bond/weft (safe 1 .x ['sys 'view 'render]))
      local (views/namespace_view_tests/put declaration
        declared.put(bond/tack (safe 1 .y source)) later)
      state (namespace initial.self local
        (pin (system_publication shared.top shared (system_publication/assigned shared))))
      base (debug_read/request source .none .none .none 'workspace)
      physical (debug_read_tests/namespace_answer base state)
      historical=path ['h 'z ($u 2) ($u 2) initial.self 'value 'child]
      overlay=path ['o ($u 1) ($u 3) 'sys 'view 'subtree ($u 2) initial.self 'value 'child]
      view=path ['x initial.self 'render]
      old (debug_read_tests/namespace_answer base.set_pax(historical) state)
      transformed (debug_read_tests/namespace_answer base.set_pax(overlay) state)
      rendered (debug_read_tests/namespace_answer base.set_pax(view) state)
      answers=row[debug_read/result] [old transformed rendered]
      version physical.versions.fil.fall(myth/new)
    [(testing/text "fixture source x and z cases differ" "1"
       version.txt_at(publisher_vocabulary/version/x_data))
     (testing/text "physical subtree history remains reported" "3"
       version.txt_at(publisher_vocabulary/version/z_data))
     (testing/nat "physical assertion provenance remains reported" 1
       version.has(publisher_vocabulary/version/top))
     (testing/text "historical descendant retains its selected ancestor case" "earlier child"
       (old.view.fil.fall(myth/new).txt_at(['text])))
     (testing/text "transformed descendant resolves current subtree input" "latest child"
       (transformed.view.fil.fall(myth/new).txt_at(['text])))
     (testing/text "spun output resolves the defining datum pins" "local"
       (rendered.view.fil.fall(myth/new).txt_at(['text])))
     (testing/nat "derived metadata never borrows source cases, shapes, epoch or state" 1
       (answers.all((\ answer (eq answer.versions.wyt 0)))))
     (testing/nat "derived outputs retain their exact target identity" 1
       (equal[row[path]] [historical overlay view] answers.map((\ answer answer.target))))
     (testing/nat "all derived outputs stay read-only" 1
       (answers.all((\ answer (eq answer.writable 0)))))]
+ tests
  ^ row[testing/case]
  [(testing/case "read-only bounded debugger snapshots" debug_read_tests/bounds)
   (testing/case "linked frontier preserves history and barriers" debug_read_tests/frontier)
   (testing/case "authority-scoped reads and derived views" debug_read_tests/authorities)
   (testing/case "derived output does not inherit source history" debug_read_tests/derived_versions)]
