- stdlib/runtime
- tests/namespace [at=fixture]
- stdlib/base

+ bounded_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      items=row[path] [[initial.self 'app 'n1] [initial.self 'app 'n2] [initial.self 'app 'n3] [initial.self 'app 'n4] [initial.self 'app 'n5]]
      state=namespace
        % i=nat 0 state=namespace initial
        ? (eq i items.len) state
        = next (? (eq i 4) items.at(4) items.at(i.inc))
        | _ i.inc (either/ok_val (grove_install/change items.at(i)
            (writ/make (myth/sing ['reply_to] (pails/p next))) state))
      chain (either/ok_val (goo_bounded/chain items.at(0) ['reply_to] 5 state))
      missing (either/ok_val (goo_bounded/chain items.at(0) ['missing] 5 state))
      repeated (either/ok_val (goo_bounded/repeat items 3))
    [(testing/nat "repeat never pads a short source" 1 (either/ok_val (goo_bounded/repeat items.take(1) 2)).items.len)
     (testing/nat "repeat empty source stays empty" 0 (either/ok_val (goo_bounded/repeat [] 2)).items.len)
     (testing/nat "PROVISIONAL five footnotes render before cycle cut" 5 chain.items.len)
     (testing/text "PROVISIONAL data self-reference is a runtime mark" "cycle" chain.stop)
     (testing/nat "PROVISIONAL missing edge ends the chain" 1 missing.items.len)
     (testing/nat "PROVISIONAL repeat clips at max" 3 repeated.items.len)
     (testing/nat "PROVISIONAL repeat exposes hidden count" 2 repeated.hidden)
     (testing/nat "repeat rejects above 256" 1 ?=((./err _) (goo_bounded/repeat items 257)))
     (testing/nat "chain rejects above 16" 1 ?=((./err _) (goo_bounded/chain items.at(0) ['reply_to] 17 state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Bounded view materialisation" bounded_checks/checks)]
