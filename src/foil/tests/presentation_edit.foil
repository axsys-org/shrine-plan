- presentation_edit
- testing

+ presentation_edit_checks
  + literal
    ' Test fixture quoting only; Grove itself still parses the resulting source.
    \ text=str
    ^ str
    | str/join (str/from_atom 10)
        (str/join (str/from_atom 34) text.split_byte(96)).split_byte(124)
  + source
    \ body=str
    ^ str
    | str/join (str/from_atom 10)
      ["edit =" "  @view" "  #on ; '/demo/card" "  #for ; '/sys/slot/edit" (presentation_edit_checks/literal body)]
  + group
    \ content=str
    ^ str
    | str/cat_all ["  card => group(on = card, action = .poke, myth = { '/sys/req = .input(card.req) }) {|    " content "|  }"]
  + lookup
    \ name=path
    ^ maybe[myth]
    .none
  + original
    ^ goo/published
    = source (presentation_edit_checks/source (presentation_edit_checks/group "input('/sys/req)|    action(`Save`)"))
      document (either/ok_val (grove/parse source))
      views (either/ok_val (grove_views/index ['demo] document presentation_edit_checks/lookup))
      view views.at(0)
      field (goo/field "req" ['sys 'req] ['lib 'grove 'types 'text] .false)
      contract (grove_role_runtime/spec [[['sys 'req] (curb/of_type (^ pails/t))]] [[['sys 'req]]])
      context (grove_views/context ['demo] document presentation_edit_checks/lookup
        (list/one (goo/role view.role (list/one field)))
        (grove_view_publication/renderers presentation_edit_checks/lookup) views)
      lowered (grove_views/lower_nodes context (list/one view.name) view view.children)
      result=either[grove/error goo/view]
        < children lowered
        | ./ok view.set_children(children)
    | goo/published view (list/one field) contract result
  + check
    \ ignored=unit
    ^ row[testing/check]
    = original presentation_edit_checks/original
      compile (presentation_edit/compile original)
      evaluate
        \ content=str
        | compile (presentation_edit_checks/source (presentation_edit_checks/group content)) presentation_edit_checks/lookup
      changed (evaluate "col(`editor`) {|      show(card.req, '/sys/slot/title)|      input('/sys/req)|    }|    action(`Keep`)")
      bad_input (evaluate "input('/sys/other)|    action(`Save`)")
      removed (evaluate "text(`No controls`)")
      duplicate (evaluate "input('/sys/req)|    action(`Save`)|    action(`Again`)")
      unknown (evaluate "show(card.missing, '/sys/slot/title)|    input('/sys/req)|    action(`Save`)")
      behavior (compile (str/cat_all [(presentation_edit_checks/source (presentation_edit_checks/group "input('/sys/req)|    action(`Save`)")) (presentation_edit_checks/literal "|behavior =|  ! foil|  0")]) presentation_edit_checks/lookup)
      retarget (compile (presentation_edit_checks/source "  card => group(on = card, action = .poke, myth = { '/sys/other = .input(card.req) }) { input('/sys/req)|    action(`Save`) }") presentation_edit_checks/lookup)
      renamed (compile (presentation_edit_checks/literal "other =|  @view|  #on ; '/demo/card|  #for ; '/sys/slot/edit|  card => text(`Different`)") presentation_edit_checks/lookup)
      wrong_role (compile (presentation_edit_checks/literal "edit =|  @view|  #on ; '/demo/other|  #for ; '/sys/slot/edit|  card => text(`Different`)") presentation_edit_checks/lookup)
      selected_source (presentation_edit_checks/source (presentation_edit_checks/group "input('/sys/req)|    action(`Save`)"))
      source_unit (str/cat_all [(presentation_edit_checks/literal "#import lede=sys/lede||unrelated =|  @tree|  lede: `Keep`||") selected_source])
      excerpt (presentation_edit/excerpt original.view.name source_unit)
      diagnostic=str
        ? changed
         > (./ok _) "ok"
         > (./err issue)
          ? issue
           > (grove/error/syntax _ message) message
          "Parser error"
    [(testing/nat "the installed fixture is lowered" 1 (either/is_ok original.result))
     (testing/text "extract exact authored source" (str/cat_all [(presentation_edit_checks/literal "#import lede=sys/lede||") selected_source]) excerpt.fall("No excerpt"))
     (testing/text "compile an authored layout through Grove" "ok"
       diagnostic)
     (testing/nat "source extraction preserves one compilable view and imports" 1
       (either/is_ok (compile excerpt.fall("") presentation_edit_checks/lookup)))
     (testing/nat "preserve the pinned receiver contract" 1 (equal original.contract (either/ok_val changed).contract))
     (testing/nat "preserve nominal field information" 1 (equal original.fields (either/ok_val changed).fields))
     (testing/nat "reject changed input placement" 1 (either/is_err bad_input))
     (testing/nat "reject removed controls" 1 (either/is_err removed))
     (testing/nat "reject duplicated operations" 1 (either/is_err duplicate))
     (testing/nat "unknown fields fail native lowering" 1 (either/is_err unknown))
     (testing/nat "ordinary code cannot enter through presentation refinement" 1 (either/is_err behavior))
     (testing/nat "reject changed action arguments" 1 (either/is_err retarget))
     (testing/nat "reject renamed publication target" 1 (either/is_err renamed))
     (testing/nat "reject different receiver role" 1 (either/is_err wrong_role))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native presentation refinement" presentation_edit_checks/check)]
