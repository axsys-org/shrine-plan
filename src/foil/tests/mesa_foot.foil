- helm
- net
- mesa_foot
- testing
- tests/namespace [at=fixture]

' Three worlds in one process, each with its own foot and its own real Mesa
' engine. Nothing is passed by hand but packets: a world writes, its foot
' hints, the reader's foot asks, pages cross fragment by fragment, and each
' landing goes through the kernel's own admission. 0x17 publishes; 0x18 is
' the peer it publishes to; 0x19 is a third world that may read only what is
' public.
+ foot_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + world
    : state=namespace foot=mesa_foot/foot
  + packet
    : to=nat from=nat bytes=nat
  + net
    ' The worlds, the packets on their way, and how many were carried and
    ' how many were lost.
    : worlds=row[foot_tests/world] wire=row[foot_tests/packet] carried=nat lost=nat
  + everyone
    ^ row[nat]
    [17 18 19]
  + others
    \ n=nat
    ^ row[nat]
    | (foot_tests/everyone).keep((\ other=nat !(eq other n)))
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + boot
    ' A world that holds each other world's key on its card for it, and a
    ' foot for it.
    \ n=nat
    ^ foot_tests/world
    = self=iota ($x n)
      blank (namespace self sov/new (fixture/namespace_tests/initial).system)
      cards
        | (foot_tests/others n).map
          \ other=nat
          ^ [p=path q=writ]
          = at=path [self 'io 'mesa ($x other)]
          [at (writ/make (myth/sing ['key] (pails/n (Ed25519PublicKey (foot_tests/seed other)))))]
      peers
        | (foot_tests/others n).map
          \ other=nat
          ^ mesa_foot/peer
          | mesa_foot/peer ($x other) other (Ed25519PublicKey (foot_tests/seed other))
    | foot_tests/world (foot_tests/apply cards blank) (mesa_foot/start self (foot_tests/seed n) 0 peers)
  + again
    ' The same world with a new foot: what a restart leaves.
    \ rift=nat me=foot_tests/world
    ^ foot_tests/world
    = n (mesa_foot/id me.state.self)
      peers
        | (foot_tests/others n).map
          \ other=nat
          ^ mesa_foot/peer
          | mesa_foot/peer ($x other) other (Ed25519PublicKey (foot_tests/seed other))
    | foot_tests/world me.state (mesa_foot/start me.state.self (foot_tests/seed n) rift peers)
  + fresh
    ' Not a constant: a net holds live engines, which are made when asked
    ' for and never kept as a value of the module.
    \ _=nat
    ^ foot_tests/net
    = none=row[foot_tests/packet] []
      worlds (foot_tests/everyone).map(foot_tests/boot)
    | foot_tests/net worlds none 0 0
  + of
    \ id=nat all=row[foot_tests/world]
    ^ foot_tests/world
    | all.keep((\ item=foot_tests/world (eq (mesa_foot/id item.state.self) id))).at(0)
  + put
    \ me=foot_tests/world all=row[foot_tests/world]
    ^ row[foot_tests/world]
    | all.map
      \ item=foot_tests/world
      ^ foot_tests/world
      ? (eq_iota item.state.self me.state.self) me
      item
  + settled
    : world=foot_tests/world out=row[foot_tests/packet]
  + settle
    ' Do what a foot asks, as the actor that runs it would: queue what it
    ' sends; admit what it lands, tell it how that went, and tell it the
    ' world moved.
    \ me=foot_tests/world does=row[mesa_foot/effect]
    ^ foot_tests/settled
    = none=row[foot_tests/packet] []
      landed=maybe[iota] .none
    % at=foot_tests/world me
      todo=row[mesa_foot/effect] does
      out=row[foot_tests/packet] none
    ^ foot_tests/settled
    ? !(todo.len) (foot_tests/settled at out)
    = first todo.at(0)
      rest todo.drop(1)
    ? first
     > (./send to bytes)
      | _ at rest out.snoc((foot_tests/packet to (mesa_foot/id at.foot.self) bytes))
     > (./admit request plan)
      ? (namespace_command/admit plan at.state (sovereign_hive at.state))
       > (./err why)
        = refused=maybe[iota] (./some why)
          told (mesa_foot/landed request refused at.foot)
        | _ (foot_tests/world at.state told.foot) rest.weld(told.does) out
       > (./ok pair)
        = [next index] pair
          told (mesa_foot/landed request landed at.foot)
          moved (mesa_foot/turned next told.foot)
        | _ (foot_tests/world next moved.foot) rest.weld(told.does).weld(moved.does) out
  + took
    ' A net after one of its worlds took a turn.
    \ me=foot_tests/world turn=mesa_foot/turn now=foot_tests/net
    ^ foot_tests/net
    = done (foot_tests/settle (foot_tests/world me.state turn.foot) turn.does)
    | now.set_worlds((foot_tests/put done.world now.worlds)).set_wire(now.wire.weld(done.out))
  + carry
    ' Deliver packets, oldest first, until none is left or the fuel is
    ' spent. fate says what becomes of the n-th packet carried: 0 it
    ' arrives, 1 it is lost, 2 it arrives twice, 3 it is overtaken by
    ' everything behind it.
    \ fate={\ nat}nat fuel=nat start=foot_tests/net
    ^ foot_tests/net
    % left=nat fuel
      now=foot_tests/net start
    ^ foot_tests/net
    ? !(left) now
    ? !(now.wire.len) now
    = first now.wire.at(0)
      rest now.wire.drop(1)
      what (fate now.carried)
      counted now.set_carried(now.carried.inc)
    ? (eq what 1) (_ left.dec counted.set_wire(rest).set_lost(now.lost.inc))
    ? (eq what 3) (_ left.dec counted.set_wire(rest.snoc(first)))
    = target (foot_tests/of first.to now.worlds)
      ;turn (mesa_foot/heard first.from first.bytes target.state target.foot)
      queue (? (eq what 2) rest.snoc(first) rest)
    | _ left.dec (foot_tests/took target turn counted.set_wire(queue))
  + clean
    \ n=nat
    ^ nat
    0
  + rough
    ' One packet in five is lost, one in ten arrives twice and one in ten is
    ' overtaken, by a hash of the packet's number: the same every run, and
    ' with no rhythm an exchange could fall into step with.
    \ n=nat
    ^ nat
    = r (mod (Sha256 (add n (bex 64))) 100)
    ? (lt r 20) 1
    ? (lt r 30) 2
    ? (lt r 40) 3
    0
  + write
    ' A world commits some writes and its foot is told.
    \ id=nat writes=row[[p=path q=writ]] now=foot_tests/net
    ^ foot_tests/net
    = me (foot_tests/of id now.worlds)
      next (foot_tests/apply writes me.state)
      moved (foot_tests/world next me.foot)
    | foot_tests/took moved (mesa_foot/turned next me.foot) now
  + tick
    ' Time passes for every world.
    \ time=nat start=foot_tests/net
    ^ foot_tests/net
    | (foot_tests/everyone).fold start
      \ now=foot_tests/net id=nat
      ^ foot_tests/net
      = me (foot_tests/of id now.worlds)
      | foot_tests/took me (mesa_foot/tick time me.state me.foot) now
  + weather
    ' Rounds of time passing and packets being carried, until the wire is
    ' quiet for a whole round or the rounds run out.
    \ fate={\ nat}nat rounds=nat start=foot_tests/net
    ^ foot_tests/net
    % round=nat 1
      now=foot_tests/net start
    ^ foot_tests/net
    ? (gt round rounds) now
    | _ round.inc (foot_tests/carry fate 4000 (foot_tests/tick (mul round 1000) now))
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + state
    \ id=nat now=foot_tests/net
    ^ namespace
    | (foot_tests/of id now.worlds).state
  + hash
    \ name=path state=namespace
    ^ nat
    ?> (./known records) (namespace/page .x .none name state) 0
    ?> (./some record) records.fil 0
    | PinHash record.myth
  + why
    \ card=path state=namespace
    ^ str
    = record (sovereign_care .x card state).fil.fall(myth/new)
    ?> (./some held) record.get(['why]) "none"
    ?> (./some said) (pail/as[pails/q] held) "none"
    | str/from_atom (iota_show said.q)
  + boxed
    ' A record's value that holds a pin: bytes kept apart from the record.
    : held=pin[row[nat]]
  + coded
    ' A record's value that holds code.
    : run=pin[{\ nat}nat]
  + unboxed
    \ name=path state=namespace
    ^ nat
    = record (sovereign_care .x name state).fil.fall(myth/new)
    ?> (./some held) record.get(['blob]) 0
    ?> (./some box) (pail/as[foot_tests/boxed] held) 0
    | (unpin box.held).fold 0 add
  + pub
    \ rel=path
    ^ path
    = root=path [($x 17) 'our ($x 18)]
    | root.weld(rel)
  + open
    \ rel=path
    ^ path
    = root=path [($x 17) 'our 'public]
    | root.weld(rel)
  + first
    ' The publisher's first commit: a root for its peer with a doc and a
    ' deep name, and a public root with a note.
    ^ row[[p=path q=writ]]
    [[(foot_tests/pub []) (writ/make (foot_tests/rec 1))]
     [(foot_tests/pub ['doc]) (writ/make (foot_tests/rec 10))]
     [(foot_tests/pub ['a 'b]) (writ/make (foot_tests/rec 20))]
     [(foot_tests/open []) (writ/make (foot_tests/rec 2))]
     [(foot_tests/open ['note]) (writ/make (foot_tests/rec 40))]]
  + crossing
    \ _=unit
    ^ row[testing/check]
    = bob_doc=path [($x 18) 'her ($x 17) 'doc]
      bob_deep=path [($x 18) 'her ($x 17) 'a 'b]
      bob_note=path [($x 18) 'her ($x 17) 'public 'note]
      bob_card=path [($x 18) 'io 'mesa ($x 17)]
      carol_doc=path [($x 19) 'her ($x 17) 'doc]
      carol_note=path [($x 19) 'her ($x 17) 'public 'note]
      n0 (foot_tests/fresh 0)
      n1 (foot_tests/write 17 foot_tests/first n0)
      hints n1.wire.len
      n2 (foot_tests/carry foot_tests/clean 4000 n1)
      alice (foot_tests/state 17 n2)
      bob (foot_tests/state 18 n2)
      carol (foot_tests/state 19 n2)
      said (net/said bob_doc bob)
      held (sovereign_care .x bob_doc bob).fil.fall(myth/new)
      key (Ed25519PublicKey (foot_tests/seed 17))
    [(testing/nat "a commit sends a hint for each root that holds something" 3 hints)
     (testing/nat "nothing is left on the wire" 0 n2.wire.len)
     (testing/nat "the peer holds the doc" 10 (foot_tests/value bob_doc bob))
     (testing/nat "and the deep name" 20 (foot_tests/value bob_deep bob))
     (testing/nat "and what is public" 40 (foot_tests/value bob_note bob))
     (testing/nat "its card stands at the publisher's head" (net/stamp 0 alice.case(.z (foot_tests/pub [])).fall(0)) (net/held ['head] bob_card bob))
     (testing/nat "the record is the publisher's own pin, byte for byte" 1 (eq (foot_tests/hash (foot_tests/pub ['doc]) alice) (foot_tests/hash bob_doc bob)))
     (testing/nat "its version header carries the publisher's signature" 1 (gt said.sig 0))
     (testing/nat "which anyone holding the key can check against the record" 1 (net/attested key (foot_tests/pub ['doc]) said held))
     (testing/nat "the third world holds what is public" 40 (foot_tests/value carol_note carol))
     (testing/nat "and nothing published to the peer" 0 (net/live carol_doc carol))]
  + gate
    ' The third world asks the publisher for the peer's root by name.
    \ _=unit
    ^ row[testing/check]
    = n1 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 foot_tests/first (foot_tests/fresh 0)))
      alice (foot_tests/of 17 n1.worlds)
      carol (foot_tests/of 19 n1.worlds)
      head (net/stamp 0 alice.state.case(.z (foot_tests/pub [])).fall(0))
      asking (mesa_foot/read_page 17 101 18 0 head carol.state carol.foot)
      packets asking.does.keep((\ item=mesa_foot/effect ?=((./send _ _) item)))
      first
        ?> (./send to bytes) packets.at(0) 0
        bytes
      ;refused (mesa_foot/heard 19 first alice.state alice.foot)
      ;allowed (mesa_foot/heard 18 first alice.state alice.foot)
    [(testing/nat "the ask leaves the third world" 1 (gt packets.len 0))
     (testing/nat "asked by the third world, the publisher answers nothing" 0 refused.does.len)
     (testing/nat "asked by the peer, it answers" 1 (gt allowed.does.len 0))]
  + changes
    \ _=unit
    ^ row[testing/check]
    = bob_doc=path [($x 18) 'her ($x 17) 'doc]
      bob_deep=path [($x 18) 'her ($x 17) 'a 'b]
      bob_new=path [($x 18) 'her ($x 17) 'c]
      bob_card=path [($x 18) 'io 'mesa ($x 17)]
      gone=writ .cull
      second=row[[p=path q=writ]] [[(foot_tests/pub ['doc]) (writ/poke (foot_tests/rec 11))]
        [(foot_tests/pub ['c]) (writ/make (foot_tests/rec 30))]
        [(foot_tests/pub ['a 'b]) gone]]
      n1 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 foot_tests/first (foot_tests/fresh 0)))
      before (foot_tests/state 18 n1).local.top
      n2 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 second n1))
      bob (foot_tests/state 18 n2)
      alice (foot_tests/state 17 n2)
      restarted n2.set_worlds((foot_tests/put (foot_tests/again 0 (foot_tests/of 17 n2.worlds)) (foot_tests/put (foot_tests/again 0 (foot_tests/of 18 n2.worlds)) n2.worlds)))
      third=row[[p=path q=writ]] [[(foot_tests/pub ['doc]) (writ/poke (foot_tests/rec 12))]]
      n3 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 third restarted))
    [(testing/nat "a change crosses" 11 (foot_tests/value bob_doc bob))
     (testing/nat "an addition crosses" 30 (foot_tests/value bob_new bob))
     (testing/nat "a removal crosses" 0 (net/live bob_deep bob))
     (testing/nat "as one event in the reader" before.inc bob.local.top)
     (testing/nat "the card follows" (net/stamp 0 alice.case(.z (foot_tests/pub [])).fall(0)) (net/held ['head] bob_card bob))
     (testing/nat "after both feet restart, the next change still crosses" 12 (foot_tests/value bob_doc (foot_tests/state 18 n3)))]
  + faults
    \ _=unit
    ^ row[testing/check]
    = bob_doc=path [($x 18) 'her ($x 17) 'doc]
      bob_new=path [($x 18) 'her ($x 17) 'c]
      bob_deep=path [($x 18) 'her ($x 17) 'a 'b]
      carol_note=path [($x 19) 'her ($x 17) 'public 'note]
      gone=writ .cull
      second=row[[p=path q=writ]] [[(foot_tests/pub ['doc]) (writ/poke (foot_tests/rec 11))]
        [(foot_tests/pub ['c]) (writ/make (foot_tests/rec 30))]
        [(foot_tests/pub ['a 'b]) gone]]
      third=row[[p=path q=writ]] [[(foot_tests/pub ['doc]) (writ/poke (foot_tests/rec 12))]
        [(foot_tests/open ['note]) (writ/poke (foot_tests/rec 41))]]
      n1 (foot_tests/carry foot_tests/rough 4000 (foot_tests/write 17 foot_tests/first (foot_tests/fresh 0)))
      n2 (foot_tests/carry foot_tests/rough 4000 (foot_tests/write 17 second n1))
      n3 (foot_tests/carry foot_tests/rough 4000 (foot_tests/write 17 third n2))
      n4 (foot_tests/weather foot_tests/rough 40 n3)
      bob (foot_tests/state 18 n4)
      alice (foot_tests/state 17 n4)
      carol (foot_tests/state 19 n4)
    [(testing/nat "packets were lost" 1 (gt n4.lost 0))
     (testing/nat "and still the peer ends where the publisher is: the doc" 12 (foot_tests/value bob_doc bob))
     (testing/nat "the addition" 30 (foot_tests/value bob_new bob))
     (testing/nat "the removal" 0 (net/live bob_deep bob))
     (testing/nat "byte for byte" 1 (eq (foot_tests/hash (foot_tests/pub ['doc]) alice) (foot_tests/hash bob_doc bob)))
     (testing/nat "and the third world what is public" 41 (foot_tests/value carol_note carol))]
  + values
    \ _=unit
    ^ row[testing/check]
    = bob_blob=path [($x 18) 'her ($x 17) 'blob]
      bob_code=path [($x 18) 'her ($x 17) 'code]
      bob_doc=path [($x 18) 'her ($x 17) 'doc]
      bob_card=path [($x 18) 'io 'mesa ($x 17)]
      bytes=row[nat] [5 6 7 8]
      double
        \ n=nat
        ^ nat
        | mul n 2
      blob=row[[p=path q=writ]] [[(foot_tests/pub ['blob]) (writ/make (myth/sing ['blob] (foot_tests/boxed (pin bytes))))]]
      code=row[[p=path q=writ]] [[(foot_tests/pub ['code]) (writ/make (myth/sing ['code] (foot_tests/coded (pin double))))]]
      gone=writ .cull
      uncode=row[[p=path q=writ]] [[(foot_tests/pub ['code]) gone]
        [(foot_tests/pub ['doc]) (writ/poke (foot_tests/rec 13))]]
      n1 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 foot_tests/first (foot_tests/fresh 0)))
      n2 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 blob n1))
      held (foot_tests/state 18 n2)
      n3 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 code n2))
      stuck (foot_tests/state 18 n3)
      n4 (foot_tests/carry foot_tests/clean 4000 (foot_tests/write 17 uncode n3))
      freed (foot_tests/state 18 n4)
    [(testing/nat "a record that holds a pin crosses with it" 26 (foot_tests/unboxed bob_blob held))
     (testing/nat "and is the publisher's pin" 1 (eq (foot_tests/hash (foot_tests/pub ['blob]) (foot_tests/state 17 n2)) (foot_tests/hash bob_blob held)))
     (testing/nat "a record that holds code does not land" 0 (net/live bob_code stuck))
     (testing/text "the card says why" "net_unfit" (foot_tests/why bob_card stuck))
     (testing/nat "and what the mount held stays" 26 (foot_tests/unboxed bob_blob stuck))
     (testing/nat "once the publisher takes the code away, its next change lands" 13 (foot_tests/value bob_doc freed))]

+ tests
  ^ row[testing/case]
  [(testing/case "a first commit crosses between three worlds" foot_tests/crossing)
   (testing/case "a peer's root is served to that peer only" foot_tests/gate)
   (testing/case "changes, removals and restarts cross" foot_tests/changes)
   (testing/case "loss, duplication and reordering" foot_tests/faults)
   (testing/case "values that hold pins cross; values that hold code do not" foot_tests/values)]
