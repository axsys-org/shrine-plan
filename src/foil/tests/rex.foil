- rex
- testing

+ rex_checks
  + node_count
    \ tree=rex
    ^ nat
    | rex/fold[nat] (\ node counts (counts.fold(1 add))) tree
  + replace_word
    \ tree=rex
    ^ rex
    ? tree
     > (./leaf span shape text)
      ? (eq text "old") (rex/word "new").with_span(span)
      tree
    tree
  + sample
    ^ rex
    | rex/rune "+" [(rex/word "answer") (rex/word "42")]
  + variants
    \ span=rex/source_span
    ^ row[rex]
    = kid | (rex/word "x").with_span(span)
    [(rex/leaf span "word" "x")
     (rex/nest span "paren" "" [kid])
     (rex/expr span "paren" [kid])
     (rex/pref span "!" kid)
     (rex/tyte span "/" [kid kid])
     (rex/bloc span "clear" ";" kid [kid])
     (rex/open span "+" [kid])
     (rex/juxt span [kid])
     (rex/heir span [kid])]
  + constructors
    \ ignored=unit
    ^ row[testing/check]
    = span | rex/make_span 2 3 5 7
      all | rex_checks/variants span
      normalized | all.map(rex/normalize)
    [(testing/nat "nine constructors" 9 all.len)
     (testing/nat "span line" 2 span.line)
     (testing/nat "span column" 3 span.column)
     (testing/nat "span offset" 5 span.offset)
     (testing/nat "span length" 7 span.length)
     (testing/nat "span on every variant" 1 (eq 0 (row/any[rex] (\ tree !(equal[rex/source_span] tree.span span)) all)))
     (testing/nat "normalization subset" 1 (eq 0 (row/any[rex] (\ tree !(tree.is_normalized)) normalized)))
     (testing/nat "normalization idempotent" 1 (equal[row[rex]] normalized normalized.map(rex/normalize)))
     (testing/nat "surface variant distinct" 0 all.at(2).is_normalized)
     (testing/text "cord escaping" (str/from_atom (cord/cat_all [34 "a<b" 34])) (rex/cord "a<b").print)
     (testing/text "path" "a / b" (rex/path ["a" "b"]).print)
     (testing/nat "dot flattened" 3 (rex/word "a").dot((rex/word "b")).dot((rex/word "c")).children.len)
     (testing/nat "nested surface is not normalized" 0 (rex/paren [(rex/pref span "!" (rex/word "x"))]).is_normalized)
     (testing/nat "word kind" 1 (equal[maybe[str]] (rex/word "x").leaf_kind (maybe/some[str] "word")))
     (testing/nat "foreign leaf shape" 1 (equal[maybe[str]] (rex/leaf span (rex/word "shape") "x").leaf_error maybe/none[str]))
     (testing/nat "non-leaf has no kind" 1 (equal[maybe[str]] (rex/paren []).leaf_kind maybe/none[str]))
     (testing/nat "singleton group" 1 (equal[rex] (rex/group [(rex/word "a")]) (rex/word "a")))]
  + parsing
    \ ignored=unit
    ^ row[testing/check]
    = parsed | rex/parse "+ old 1"
      rewritten | (either/ok_val[any rex] parsed).walk(rex_checks/replace_word).print
      normalized | rex/parse_normalized "+ old 1"
      norm_ok | (either/ok_val[any rex] normalized).is_normalized
      malformed | rex/parse ")"
      bad | rex/parse (str/from_atom 34)
      bad_count | rex/fold[nat] rex_checks/count_errors (either/ok_val[any rex] bad)
    [(testing/nat "parse succeeds" 1 (either/is_ok parsed))
     (testing/nat "parse failure is a result" 1 (either/is_err malformed))
     (testing/text "rewrite" "+ new 1" rewritten)
     (testing/nat "normalized parse" 1 norm_ok)
     (testing/nat "recoverable bad leaf" 1 bad_count)]
  + count_errors
    \ node=rex counts=row[nat]
    ^ nat
    | counts.fold ?=((./some _) node.leaf_error) add
  + traversal
    \ ignored=unit
    ^ row[testing/check]
    = tree (rex/bloc (rex/make_span 1 2 3 4) "clear" ";" (rex/word "head") [(rex/word "old") (rex/word "last")])
      walked | tree.walk(rex_checks/replace_word)
      replaced | (rex/word "x").walk((\ node (rex/group [node node])))
    [(testing/nat "Bloc head precedes items" 1
       (equal[row[rex]] tree.children [(rex/word "head") (rex/word "old") (rex/word "last")]))
     (testing/nat "fold includes head" 4 (rex_checks/node_count tree))
     (testing/nat "walk preserves parent span" 1 (equal[rex/source_span] tree.span walked.span))
     (testing/nat "map children preserves metadata" 1
       (equal[rex] tree tree.map_children((\ node node))))
     (testing/nat "replacement is not revisited" 3 (rex_checks/node_count replaced))
     (testing/nat "strip every span" 1 (rex/fold[bool] rex_checks/spans_clear tree.strip_spans))]
  + spans_clear
    \ node=rex kids=row[bool]
    ^ bool
    ? !(equal[rex/source_span] node.span rex/zero_span) .false
    | eq 0 (row/any[bool] (\ value (eq value 0)) kids)


+ tests
  ^ row[testing/case]
  [(testing/case "constructors" rex_checks/constructors)
   (testing/case "parsing" rex_checks/parsing)
   (testing/case "traversal" rex_checks/traversal)]
