- eden_store
- helm
- net
- testing
- tests/namespace [at=fixture]

' These tests use two worlds in one process. 0x17 publishes to 0x18, and 0x18
' lands what 0x17 publishes in the store that it keeps for 0x17. There is no
' transport. The test passes the epic that a foot carries when a transport is
' there. Each landing goes through the land command of the supervisor.
+ net_tests
  + alice
    ^ namespace
    | namespace ($x 17) sov/new (fixture/namespace_tests/initial).system (mop/empty)
  + seed
    ' It gives a key that a test world signs with. The key is 32 bytes in the
    ' form that the runtime accepts.
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + key
    ^ nat
    | Ed25519PublicKey (net_tests/seed 17)
  + stranger
    ' It gives the reader before the reader holds the publisher's key.
    ^ namespace
    | namespace ($x 18) sov/new (fixture/namespace_tests/initial).system (mop/empty)
  + bob
    ' It gives the reader that holds the publisher's key on its card for the
    ' publisher.
    ^ namespace
    = met=row[[p=path q=writ]] [[[($x 18) 'io 'mesa ($x 17)] (writ/make (myth/sing ['key] (pails/n net_tests/key)))]]
    ? (eden_store/changes met net_tests/stranger)
     > (./ok next) next
     > (./err why) net_tests/stranger
  + root
    ^ path
    [($x 17) 'our ($x 18)]
  + card
    ^ path
    [($x 18) 'io 'mesa ($x 17)]
  + pub
    \ rel=path
    ^ path
    | (net_tests/root).weld(rel)
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (eden_store/changes writes state)
     > (./ok next) next
     > (./err why) state
  + landing
    : state=namespace why=iota
  + admit
    ' It gives the plan of a landing to the supervisor as one land command.
    ' It gives the world after the command, or the reason that the world did
    ' not accept it.
    \ peer=iota plan=net/landing state=namespace
    ^ either[iota namespace]
    = [next index reply] (helm/supervisor/land peer plan.base plan.diffs plan.writes state (sovereign_hive state))
      unknown=iota 'refused
    ? reply
     > (./ack err)
      ?> (./some why) err (./ok next)
      ?> (./some said) (pail/as[helm/supervisor/rejection] why) (./err unknown)
      | ./err said.reason
    | ./ok next
  + why
    ' It gives the reason that the rules gave for no plan.
    \ got=either[iota net/landing]
    ^ iota
    ? got
     > (./err reason) reason
     > (./ok plan) 'planned
  + planned
    ' It gives the plan that the rules gave, or an empty plan.
    \ got=either[iota net/landing]
    ^ net/landing
    = none=row[[p=path q=writ]] []
    ? got
     > (./err reason) (net/landing 0 (axal/new[note] .none) none)
     > (./ok plan) plan
  + epochs
    ' It gives the epoch of the store that a reader keeps for the publisher.
    \ state=namespace
    ^ nat
    = peer=path [($x 17)]
    ?> (./some store) state.peers.get(peer) 0
    store.top
  + take
    ' It does what the two feet do with an answer. The publisher's foot signs
    ' the answer. The reader's foot plans the landing and gives the plan to
    ' the world as one land command.
    \ answer=maybe[net/epic] reader=namespace
    ^ net_tests/landing
    = silent=iota 'no_answer
    ?> (./some change) answer (net_tests/landing reader silent)
    | net_tests/raw (net/seal (net_tests/seed 17) net_tests/root change) reader
  + raw
    ' It lands an epic and does not change the epic. If the rules or the
    ' world do not accept the epic, this function gives the reason.
    \ change=net/epic reader=namespace
    ^ net_tests/landing
    = landed=iota 'landed
    ? (net/land net_tests/root net_tests/card change reader)
     > (./err why) (net_tests/landing reader why)
     > (./ok plan)
      ? (net_tests/admit ($x 17) plan reader)
       > (./ok next) (net_tests/landing next landed)
       > (./err why) (net_tests/landing reader why)
  + show
    \ why=iota
    ^ str
    | str/from_atom (iota_show why)
  + head
    \ state=namespace
    ^ nat
    | state.case(.z net_tests/root).fall(0)
  + xcase
    \ rel=path state=namespace
    ^ nat
    | state.case(.x (net_tests/pub rel)).fall(0)
  + stands
    \ state=namespace
    ^ nat
    | net/held ['head] net_tests/card state
  + names
    \ state=namespace
    ^ nat
    | (sovereign_peek net_tests/root state).wyt
  + pinned
    ' It gives a name of the publisher as the reader reads it through a pinned
    ' reference: /h/x/<case>/<len>/<the name>. The case is a case of the store
    ' that the reader keeps for the publisher.
    \ rel=path version=nat state=namespace
    ^ nat
    = cited=path (net_tests/pub rel)
      head=path ['h 'x ($u version) ($u cited.len)]
      spelled=path head.weld(cited)
    ?> (./known records) (sovereign_view .x 0 spelled state) 0
    ?> (./some record) records.fil 0
    | record.nat_at(['value] 0)
  + cited_version
    \ holder=path state=namespace
    ^ nat
    = record (sovereign_care .x holder state).fil
    | (reference_index/slots record).fold 0
      \ acc=nat item=[slot=path target=safe]
      ^ nat
      = [slot target] item
      target.ver
  + hash
    ' It gives the content hash of the record that a name holds now.
    \ name=path state=namespace
    ^ nat
    ?> (./known records) (namespace/page .x .none name state) 0
    ?> (./some record) records.fil 0
    | PinHash record.myth
  + size
    \ answer=maybe[net/epic]
    ^ nat
    ?> (./some change) answer 0
    | change.entries.len
  + first
    ' It gives the publisher after its first commit. The commit makes the
    ' root, a doc and a deep name below a folder that holds no record.
    ^ namespace
    = writes=row[[p=path q=writ]] [[net_tests/root (writ/make (net_tests/rec 1))]
        [(net_tests/pub ['doc]) (writ/make (net_tests/rec 10))]
        [(net_tests/pub ['a 'b]) (writ/make (net_tests/rec 20))]]
    | net_tests/apply writes net_tests/alice
  + second
    ' It gives the publisher after one more event that changes, adds and
    ' removes records.
    ^ namespace
    = gone=writ .cull
      writes=row[[p=path q=writ]] [[(net_tests/pub ['doc]) (writ/poke (net_tests/rec 11))]
        [(net_tests/pub ['c]) (writ/make (net_tests/rec 30))]
        [(net_tests/pub ['a 'b]) gone]]
    | net_tests/apply writes net_tests/first
  + exact
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      a2 net_tests/second
      z1 (net_tests/head a1)
      z2 (net_tests/head a2)
      b0 net_tests/bob
      doc=path (net_tests/pub ['doc])
      deep=path (net_tests/pub ['a 'b])
      l1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) b0)
      b1 l1.state
      l2 (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b1)
      b2 l2.state
      fresh (net_tests/take (net/delta 0 net_tests/root 0 z2 a2) b0).state
    [(testing/nat "the publisher's root moved" 1 (gt z2 z1))
     (testing/text "everything lands" "landed" (net_tests/show l1.why))
     (testing/nat "the doc" 10 (net_tests/value doc b1))
     (testing/nat "the deep name" 20 (net_tests/value deep b1))
     (testing/nat "one event of this world for the whole epic" b0.local.top.inc b1.local.top)
     (testing/nat "and one epoch of the store of the publisher" 1 (net_tests/epochs b1))
     (testing/nat "the record is not among the names of this world" 0 (maybe/is_some b1.local.x_case(doc)))
     (testing/nat "the record has a case of the store of the publisher" 1 b1.case(.x doc).fall(0))
     (testing/nat "a landed record keeps its published version" (net/stamp 0 (net_tests/xcase ['doc] a1)) (net/version doc b1))
     (testing/nat "the store holds the publisher's own pin, byte for byte" 1 (eq (net_tests/hash (net_tests/pub ['doc]) a1) (net_tests/hash doc b1)))
     (testing/nat "and no slot was added to the record" 0 (net/held ['remote_case] doc b1))
     (testing/nat "the card stands at the publisher's head" (net/stamp 0 z1) (net_tests/stands b1))
     (testing/nat "the store holds the publisher's names and no other" 3 (net_tests/names b1))
     (testing/nat "where the root stands is not kept in the store of the publisher" 0 (net/held ['head] net_tests/root b1))
     (testing/text "a delta lands" "landed" (net_tests/show l2.why))
     (testing/nat "a delta changes" 11 (net_tests/value doc b2))
     (testing/nat "a delta adds" 30 (net_tests/value (net_tests/pub ['c]) b2))
     (testing/nat "a delta removes" 0 (net/live deep b2))
     (testing/nat "the delta is one event" b1.local.top.inc b2.local.top)
     (testing/nat "deltas equal everything at once: the doc" (net_tests/value doc fresh) (net_tests/value doc b2))
     (testing/nat "deltas equal everything at once: the added name" (net_tests/value (net_tests/pub ['c]) fresh) (net_tests/value (net_tests/pub ['c]) b2))
     (testing/nat "deltas equal everything at once: the head" (net_tests/stands fresh) (net_tests/stands b2))
     (testing/nat "deltas equal everything at once: the names" (net_tests/names fresh) (net_tests/names b2))
     (testing/nat "deltas equal everything at once: the versions" (net/version doc fresh) (net/version doc b2))
     (testing/nat "what the publisher removed is not in a fresh store" 0 (net/live deep fresh))
     (testing/nat "everything is every name" 3 (net_tests/size (net/delta 0 net_tests/root 0 z1 a1)))
     (testing/nat "a delta carries only what changed" 3 (net_tests/size (net/delta 0 net_tests/root z1 z2 a2)))]
  + atomic
    ' The two parts of a landing are one admission, and a landing changes the
    ' store of one peer only.
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      z1 (net_tests/head a1)
      b0 net_tests/bob
      nothing=row[net/entry] []
      none=row[[p=path q=writ]] []
      change (net/delta 0 net_tests/root 0 z1 a1).fall((net/epic 0 0 0 nothing))
      plan (net_tests/planned (net/land net_tests/root net_tests/card (net/seal (net_tests/seed 17) net_tests/root change) b0))
      far=path [($x 99) 'x]
      near=path [($x 18) 'x]
      bad=row[[p=path q=writ]] [[far (writ/make (net_tests/rec 1))]]
      own (axal/new[note] .none).put(near (note/make (net_tests/rec 1)))
      index (sovereign_hive b0)
      [spoiled i1 r1] (helm/supervisor/land ($x 17) plan.base plan.diffs bad b0 index)
      [strayed i2 r2] (helm/supervisor/land ($x 17) plan.base plan.diffs.put(far (note/make (net_tests/rec 1))) plan.writes b0 index)
      [mine i3 r3] (helm/supervisor/land ($x 18) 0 own none b0 index)
      [whole i4 r4] (helm/supervisor/land ($x 17) plan.base plan.diffs plan.writes b0 index)
    [(testing/nat "the plan changes three names of the publisher" 3 plan.diffs.wyt)
     (testing/nat "a landing whose writes this world does not accept changes no store: the store of the publisher" 0 (net_tests/epochs spoiled))
     (testing/nat "nor the names of this world" b0.local.top spoiled.local.top)
     (testing/nat "a landing with a name of a different world changes no store" 0 (net_tests/epochs strayed))
     (testing/nat "nor the names of this world either" b0.local.top strayed.local.top)
     (testing/nat "a landing is not a way to write the names of this world" 0 (net/live near mine))
     (testing/nat "the whole plan is one epoch of the store of the publisher" 1 (net_tests/epochs whole))
     (testing/nat "and one event of this world" b0.local.top.inc whole.local.top)]
  + monotone
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      a2 net_tests/second
      z1 (net_tests/head a1)
      z2 (net_tests/head a2)
      b0 net_tests/bob
      b1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) b0).state
      b2 (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b1).state
      again (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b2)
      whole (net_tests/take (net/delta 0 net_tests/root 0 z2 a2) b2)
      older (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) b2)
      gap (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b0)
      nothing=row[net/entry] []
      change (net/delta 0 net_tests/root z1 z2 a2).fall((net/epic 0 0 0 nothing))
      early (net/land net_tests/root net_tests/card (net/seal (net_tests/seed 17) net_tests/root change) b1)
      late=iota
        ? early
         > (./err why) why
         > (./ok plan)
          ? (net_tests/admit ($x 17) plan b2)
           > (./err why) why
           > (./ok next) 'landed
    [(testing/text "the same epic twice is refused" "net_stale" (net_tests/show again.why))
     (testing/nat "and makes no event" b2.local.top again.state.local.top)
     (testing/text "the same head by another epic is refused" "net_stale" (net_tests/show whole.why))
     (testing/nat "and makes no event either" b2.local.top whole.state.local.top)
     (testing/text "an older epic is refused" "net_stale" (net_tests/show older.why))
     (testing/nat "and nothing goes back" 11 (net_tests/value (net_tests/pub ['doc]) older.state))
     (testing/nat "nor does what was removed come back" 0 (net/live (net_tests/pub ['a 'b]) older.state))
     (testing/text "a delta that does not start where the root stands is refused" "net_gap" (net_tests/show gap.why))
     (testing/nat "and lands nothing" b0.local.top gap.state.local.top)
     (testing/text "a plan made before the store of the publisher moved is refused" "peer_store_moved" (net_tests/show late))
     (testing/nat "a hint past what is held is asked for" 1 (net/wants net_tests/card (net/stamp 0 z2) b1))
     (testing/nat "a hint at what is held is not" 0 (net/wants net_tests/card (net/stamp 0 z2) b2))
     (testing/nat "nor a hint behind it" 0 (net/wants net_tests/card (net/stamp 0 z1) b2))]
  + history
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      a2 net_tests/second
      z1 (net_tests/head a1)
      z2 (net_tests/head a2)
      b0 net_tests/bob
      b1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) b0).state
      b2 (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b1).state
      lost (net_tests/take (net/delta 0 net_tests/root (add z2 5) (add z2 6) a2) b1)
      recovered (net_tests/take (net/delta 0 net_tests/root 0 z2 a2) b1)
      gone=writ .cull
      away=row[[p=path q=writ]] [[(net_tests/pub ['doc]) gone]]
      back=row[[p=path q=writ]] [[(net_tests/pub ['doc]) (writ/make (net_tests/rec 12))]]
      a3 (net_tests/apply away a2)
      a4 (net_tests/apply back a3)
      z4 (net_tests/head a4)
      b4 (net_tests/take (net/delta 0 net_tests/root z2 z4 a4) b2)
    [(testing/nat "a head that does not exist has no answer" 1 (maybe/is_none (net/delta 0 net_tests/root 0 (add z2 5) a2)))
     (testing/nat "a base that does not exist has no answer" 1 (maybe/is_none (net/delta 0 net_tests/root (add z2 5) (add z2 6) a2)))
     (testing/nat "a base at or past the head has no answer" 1 (maybe/is_none (net/delta 0 net_tests/root z2 z2 a2)))
     (testing/nat "the head itself has one" 1 (maybe/is_some (net/delta 0 net_tests/root 0 z2 a2)))
     (testing/text "no answer lands nothing" "no_answer" (net_tests/show lost.why))
     (testing/nat "and leaves the root where it stood" (net_tests/stands b1) (net_tests/stands lost.state))
     (testing/text "the reader then reads everything" "landed" (net_tests/show recovered.why))
     (testing/nat "which brings what changed" 11 (net_tests/value (net_tests/pub ['doc]) recovered.state))
     (testing/nat "and what was added" 30 (net_tests/value (net_tests/pub ['c]) recovered.state))
     (testing/nat "and removes what the publisher no longer has" 0 (net/live (net_tests/pub ['a 'b]) recovered.state))
     (testing/nat "the recovered store is the one the deltas made: the names" (net_tests/names b2) (net_tests/names recovered.state))
     (testing/nat "the recovered store is the one the deltas made: the head" (net_tests/stands b2) (net_tests/stands recovered.state))
     (testing/nat "a name removed and made again takes a new version" 1 (gt (net_tests/xcase ['doc] a4) (net_tests/xcase ['doc] a2)))
     (testing/text "and a reader that saw neither step follows" "landed" (net_tests/show b4.why))
     (testing/nat "to the remade content" 12 (net_tests/value (net_tests/pub ['doc]) b4.state))]
  + restore
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      z1 (net_tests/head a1)
      b0 net_tests/bob
      b1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) b0).state
      edit=row[[p=path q=writ]] [[(net_tests/pub ['doc]) (writ/poke (net_tests/rec 11))]]
      a2 (net_tests/apply edit a1)
      z2 (net_tests/head a2)
      b2 (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b1).state
      other=row[[p=path q=writ]] [[(net_tests/pub ['doc]) (writ/poke (net_tests/rec 99))]]
      a3 (net_tests/apply other a1)
      z3 (net_tests/head a3)
      x1 (net_tests/xcase ['doc] a1)
      x2 (net_tests/xcase ['doc] a2)
      x3 (net_tests/xcase ['doc] a3)
      cite=row[[p=path q=writ]] [[(net_tests/pub ['cite]) (writ/make (myth/sing ['source] (safe x3 .x (net_tests/pub ['doc]))))]]
      a4 (net_tests/apply cite a3)
      z4 (net_tests/head a4)
      unsafe (net_tests/take (net/delta 0 net_tests/root 0 z3 a3) b2)
      l3 (net_tests/take (net/delta 1 net_tests/root 0 z4 a4) b2)
      b3 l3.state
    [(testing/nat "the restored world reuses a case for other content" x2 x3)
     (testing/nat "and reaches the same head" z2 z3)
     (testing/text "served without a new rift, it is refused as nothing new" "net_stale" (net_tests/show unsafe.why))
     (testing/nat "and the reader keeps what it held" 11 (net_tests/value (net_tests/pub ['doc]) unsafe.state))
     (testing/text "under a new rift it lands" "landed" (net_tests/show l3.why))
     (testing/nat "with the new content" 99 (net_tests/value (net_tests/pub ['doc]) b3))
     (testing/nat "as one event" b2.local.top.inc b3.local.top)
     (testing/nat "a pin that the reader made before the restore still names the old content" 11 (net_tests/pinned ['doc] 2 b3))
     (testing/nat "an older pin still names its content" 10 (net_tests/pinned ['doc] 1 b3))
     (testing/nat "a case that the reader did not make names nothing" 0 (net_tests/pinned ['doc] 9 b3))
     (testing/nat "the publisher's own pin crosses as the published version" (net/stamp 1 x3) (net_tests/cited_version (net_tests/pub ['cite]) b3))]
  + breach
    ' This test uses a restore to a time before the publisher made a record.
    ' The new history does not make that record, but it makes a name below
    ' that record.
    \ _=unit
    ^ row[testing/check]
    = gone=writ .cull
      found=row[[p=path q=writ]] [[net_tests/root (writ/make (net_tests/rec 1))]]
      p0 (net_tests/apply found net_tests/alice)
      box=row[[p=path q=writ]] [[(net_tests/pub ['box]) (writ/make (net_tests/rec 5))]
        [(net_tests/pub ['box 'one]) (writ/make (net_tests/rec 6))]]
      p1 (net_tests/apply box p0)
      away=row[[p=path q=writ]] [[(net_tests/pub ['box]) gone]]
      p2 (net_tests/apply away p1)
      two=row[[p=path q=writ]] [[(net_tests/pub ['box 'two]) (writ/make (net_tests/rec 7))]]
      q1 (net_tests/apply two p0)
      r1 (net_tests/take (net/delta 0 net_tests/root 0 (net_tests/head p1) p1) net_tests/bob).state
      over (net_tests/take (net/delta 1 net_tests/root 0 (net_tests/head q1) q1) r1)
      r2 (net_tests/take (net/delta 0 net_tests/root (net_tests/head p1) (net_tests/head p2) p2) r1).state
      under (net_tests/take (net/delta 1 net_tests/root 0 (net_tests/head q1) q1) r2)
    [(testing/nat "the new history holds a name beneath a folder with no record" 0 (net/live (net_tests/pub ['box]) q1))
     (testing/text "over a record the reader still holds, it lands" "landed" (net_tests/show over.why))
     (testing/nat "the new name is there" 7 (net_tests/value (net_tests/pub ['box 'two]) over.state))
     (testing/nat "the old name beneath is gone" 0 (net/live (net_tests/pub ['box 'one]) over.state))
     (testing/nat "the old record's content is gone" 0 (net_tests/value (net_tests/pub ['box]) over.state))
     (testing/nat "a pin to the old record still names it" 5 (net_tests/pinned ['box] 1 over.state))
     (testing/nat "a record with names beneath it keeps its publisher's version" (net/stamp 0 (net_tests/xcase ['box] p1)) (net/version (net_tests/pub ['box]) r1))
     (testing/nat "the reader had landed the removal" 0 (net/live (net_tests/pub ['box]) r2))
     (testing/text "over a record the reader removed, it lands" "landed" (net_tests/show under.why))
     (testing/nat "and the new name is there" 7 (net_tests/value (net_tests/pub ['box 'two]) under.state))]
  + refused
    ' This test uses a record of a publisher that does not obey the contract
    ' that it carries. The record lands: this world keeps what the publisher
    ' signed, and it judges only the names of this world. Then the test
    ' records a head that was refused.
    \ _=unit
    ^ row[testing/check]
    = b0 net_tests/bob
      here=path []
      held (lash/texted ['title] 0)
      whole (myth/sing ['title] (pails/t "first")).put(system_vocabulary/lash held)
      broken (myth/sing ['value] (pails/n 2)).put(system_vocabulary/lash held)
      hand=path [($x 17) 'kook 'none]
      acting (myth/sing ['value] (pails/n 3)).put(limb_slot (kook [hand]))
      one=row[net/entry] [(net/put here (net/stamp 0 1) (net_tests/rec 1))
        (net/put ['doc] (net/stamp 0 1) whole)]
      bad=row[net/entry] [(net/put here (net/stamp 0 2) (net_tests/rec 2))
        (net/put ['doc] (net/stamp 0 2) broken)
        (net/put ['act] (net/stamp 0 2) acting)]
      good=row[net/entry] [(net/put here (net/stamp 0 6) (net_tests/rec 6))]
      b1 (net_tests/take (./some (net/epic 0 (net/stamp 0 3) 0 one)) b0).state
      l2 (net_tests/take (./some (net/epic (net/stamp 0 3) (net/stamp 0 4) 0 bad)) b1)
      b2 l2.state
      noted=row[[p=path q=writ]] [(net/refuse net_tests/card (net/stamp 0 5) 'net_forged b2)]
      no (net_tests/apply noted b2)
      yes (net_tests/take (./some (net/epic (net/stamp 0 4) (net/stamp 0 6) 0 good)) no)
    [(testing/nat "a record lands with its contract" (net/stamp 0 3) (net_tests/stands b1))
     (testing/text "a record that breaks its contract lands as its publisher signed it" "landed" (net_tests/show l2.why))
     (testing/nat "this world holds it" 2 (net_tests/value (net_tests/pub ['doc]) b2))
     (testing/nat "a record with a behaviour lands as data" 3 (net_tests/value (net_tests/pub ['act]) b2))
     (testing/nat "and the kernel knows no node of the publisher" 0 (sovereign_hive b2).tap.keep((\ [watcher deps] !(b2.owns(watcher)))).len)
     (testing/nat "a refused head is kept where the root stands" (net/stamp 0 5) (net/held ['refused] net_tests/card no))
     (testing/nat "the root stands where it stood" (net/stamp 0 4) (net_tests/stands no))
     (testing/nat "the refused head is not asked for again" 0 (net/wants net_tests/card (net/stamp 0 5) no))
     (testing/nat "a later head is" 1 (net/wants net_tests/card (net/stamp 0 6) no))
     (testing/text "which lands from where the root stood" "landed" (net_tests/show yes.why))
     (testing/nat "at its head" (net/stamp 0 6) (net_tests/stands yes.state))]

  + signed
    ' This test shows who said an epic. If the publisher's key did not sign
    ' all of an epic, the reader does not accept that epic. What lands keeps
    ' the publisher's signature in a statement beside the card.
    \ _=unit
    ^ row[testing/check]
    = a1 net_tests/first
      z1 (net_tests/head a1)
      b0 net_tests/bob
      nothing=row[net/entry] []
      plain=net/epic (net/delta 0 net_tests/root 0 z1 a1).fall((net/epic 0 0 0 nothing))
      good (net/seal (net_tests/seed 17) net_tests/root plain)
      other (net/seal (net_tests/seed 99) net_tests/root plain)
      bent
        | good.entries.map
          \ item=net/entry
          ^ net/entry
          ?> (./some record) item.record item
          | item.set_record((./some record.put(['value] (pails/n 666))))
      b1 (net_tests/raw good b0).state
      bare (net/read (net/wired good)).fall(good)
      filled
        | good.entries.fold bare
          \ acc=net/epic item=net/entry
          ^ net/epic
          ?> (./some record) item.record acc
          | net/given item.hash record acc
      doc=path (net_tests/pub ['doc])
      said (net/said doc b1)
      record (sovereign_care .x doc b1).fil.fall(myth/new)
      cited=path (net_tests/pub ['doc])
      own=path [($x 18) 'our ($x 17)]
    [(testing/text "an unsigned epic is refused" "net_forged" (net_tests/show (net_tests/raw plain b0).why))
     (testing/text "one signed by another key is refused" "net_forged" (net_tests/show (net_tests/raw other b0).why))
     (testing/text "one whose record was changed after signing is refused" "net_forged" (net_tests/show (net_tests/raw good.set_entries(bent) b0).why))
     (testing/text "one whose head was changed after signing is refused" "net_forged" (net_tests/show (net_tests/raw good.set_head(good.head.inc) b0).why))
     (testing/text "a reader that holds no key for the publisher refuses it" "net_stranger" (net_tests/show (net_tests/raw good net_tests/stranger).why))
     (testing/text "an epic for a name of this world has no plan" "net_outside" (net_tests/show (net_tests/why (net/land own net_tests/card good b0))))
     (testing/nat "none of those landed anything" b0.local.top (net_tests/raw other b0).state.local.top)
     (testing/text "the publisher's own epic lands" "landed" (net_tests/show (net_tests/raw good b0).why))
     (testing/nat "an epic travels without its records and says which it lacks" 3 (net/lacks net_tests/root bare b0).len)
     (testing/text "it does not land until they arrive" "net_missing" (net_tests/show (net_tests/raw bare b0).why))
     (testing/text "with each record given by its hash it lands" "landed" (net_tests/show (net_tests/raw filled b0).why))
     (testing/nat "a reader that already holds them lacks none" 0 (net/lacks net_tests/root bare b1).len)
     (testing/nat "the held record's header carries a signature" 1 (gt said.sig 0))
     (testing/nat "which anyone with the key can check against the record" 1 (net/attested net_tests/key cited said record))
     (testing/nat "and which fails for a different record" 0 (net/attested net_tests/key cited said (net_tests/rec 11)))
     (testing/nat "or a different name" 0 (net/attested net_tests/key (net_tests/pub ['other]) said record))
     (testing/nat "or a different key" 0 (net/attested (Ed25519PublicKey (net_tests/seed 99)) cited said record))]
  + told
    ' It gives a number that the statement of a name of the publisher held at
    ' one of the cases of the statement.
    \ slot=path name=path case=nat state=namespace
    ^ nat
    ?> (./known records) (namespace/page .x (./some case) (net/note ($x 18) name) state) 0
    ?> (./some record) records.fil 0
    | (unpin record.myth).nat_at(slot 0)
  + was
    ' It gives the value that a name of the publisher held, in the store that
    ' the reader keeps for the publisher, at one of its cases there.
    \ name=path case=nat state=namespace
    ^ nat
    ?> (./known records) (namespace/page .x (./some case) name state) 0
    ?> (./some record) records.fil 0
    | (unpin record.myth).nat_at(['value] 0)
  + fits
    ' It tells if the statement at a case names the content that the record
    ' held at a case.
    \ name=path said=nat held=nat state=namespace
    ^ nat
    ?> (./known records) (namespace/page .x (./some held) name state) 0
    ?> (./some record) records.fil 0
    ? (eq (PinHash record.myth) (net_tests/told ['hash] name said state)) 1
    0
  + observed
    ' The values of a publisher and what this world knows of them are two
    ' records, and each has its own cases. The reader in this test does not
    ' get two of the versions of the publisher. From the cases of the
    ' statement, a hand can tell which versions this world got, and thus
    ' which it did not get.
    \ _=unit
    ^ row[testing/check]
    = doc=path (net_tests/pub ['doc])
      held=path doc
      a1 net_tests/first
      z1 (net_tests/head a1)
      b1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) net_tests/bob).state
      e2=row[[p=path q=writ]] [[doc (writ/poke (net_tests/rec 11))]]
      e3=row[[p=path q=writ]] [[doc (writ/poke (net_tests/rec 12))]]
      e4=row[[p=path q=writ]] [[doc (writ/poke (net_tests/rec 13))]]
      a4 (net_tests/apply e4 (net_tests/apply e3 (net_tests/apply e2 a1)))
      z4 (net_tests/head a4)
      b2 (net_tests/take (net/delta 0 net_tests/root z1 z4 a4) b1).state
      gone=writ .cull
      away=row[[p=path q=writ]] [[doc gone]]
      a5 (net_tests/apply away a4)
      z5 (net_tests/head a5)
      b3 (net_tests/take (net/delta 0 net_tests/root z4 z5 a5) b2).state
      first (net_tests/told ['stamp] held 1 b2)
      last (net_tests/told ['stamp] held 2 b2)
    [(testing/nat "the publisher made four versions" 4 (net_tests/xcase ['doc] a4))
     (testing/nat "the reader holds two: the record has two cases in the store of the publisher" 2 b2.case(.x held).fall(0))
     (testing/nat "its first case is the first content" 10 (net_tests/was held 1 b2))
     (testing/nat "its second case is the fourth content" 13 (net_tests/was held 2 b2))
     (testing/nat "the statement is a record with cases of its own" 2 b2.case(.x (net/note ($x 18) held)).fall(0))
     (testing/nat "at its first case it names the first version of the publisher" (net/stamp 0 1) first)
     (testing/nat "at its second case it names the fourth" (net/stamp 0 4) last)
     (testing/nat "each statement keeps the key that this world examined it with" net_tests/key (net_tests/told ['key] held 2 b2))
     (testing/nat "thus this world can tell that it did not get two versions" 2 (sub (sub last first) 1))
     (testing/nat "the first statement names the content of the first case" 1 (net_tests/fits held 1 1 b2))
     (testing/nat "the second statement names the content of the second case" 1 (net_tests/fits held 2 2 b2))
     (testing/nat "and not the content of the first" 0 (net_tests/fits held 2 1 b2))
     (testing/nat "the publisher removes the name: this world holds no record" 0 (net/live held b3))
     (testing/nat "and the statement has a third case" 3 b3.case(.x (net/note ($x 18) held)).fall(0))
     (testing/nat "which says that the name is gone" 0 (net_tests/told ['hash] held 3 b3))
     (testing/nat "at the version where the publisher removed it" (net/stamp 0 z5) (net_tests/told ['stamp] held 3 b3))]
  + open
    ' It lands what the publisher holds below its public root, from where the
    ' reader stands.
    \ publisher=namespace reader=namespace
    ^ namespace
    = root=path [($x 17) 'our 'public]
      card=path [($x 18) 'io 'mesa ($x 17) 'public]
      base (net/held ['head] card reader)
      head publisher.case(.z root).fall(0)
    ?> (./some change) (net/delta 0 root base head publisher) reader
    ? (net/land root card (net/seal (net_tests/seed 17) root change) reader)
     > (./err why) reader
     > (./ok plan)
      ? (net_tests/admit ($x 17) plan reader)
       > (./err why) reader
       > (./ok next) next
  + roots
    ' A publisher has two roots for one reader: the root for that reader only,
    ' and the public root. The reader holds the two in the one store that it
    ' keeps for the publisher. The publisher removes the first root, and the
    ' reader keeps the second.
    \ _=unit
    ^ row[testing/check]
    = shared=path [($x 17) 'our 'public]
      note=path shared.snoc('note)
      stand=path [($x 18) 'io 'mesa ($x 17) 'public]
      doc=path (net_tests/pub ['doc])
      both=row[[p=path q=writ]] [[shared (writ/make (net_tests/rec 2))]
        [note (writ/make (net_tests/rec 40))]]
      a1 (net_tests/apply both net_tests/first)
      z1 (net_tests/head a1)
      b1 (net_tests/open a1 (net_tests/take (net/delta 0 net_tests/root 0 z1 a1) net_tests/bob).state)
      gone=writ .cull
      away=row[[p=path q=writ]] [[net_tests/root gone]]
      a2 (net_tests/apply away a1)
      z2 (net_tests/head a2)
      l2 (net_tests/take (net/delta 0 net_tests/root z1 z2 a2) b1)
      b2 l2.state
    [(testing/nat "the reader holds the record of the first root" 10 (net_tests/value doc b1))
     (testing/nat "and the record of the public root" 40 (net_tests/value note b1))
     (testing/nat "the two landings are two epochs of the one store" 2 (net_tests/epochs b1))
     (testing/nat "the publisher removes the first root" 0 (net/live net_tests/root a2))
     (testing/text "the removal lands" "landed" (net_tests/show l2.why))
     (testing/nat "the record of the first root is gone" 0 (net/live doc b2))
     (testing/nat "the record of the public root is there" 40 (net_tests/value note b2))
     (testing/nat "and the public root stands where it stood" (net/held ['head] stand b1) (net/held ['head] stand b2))]

+ tests
  ^ row[testing/case]
  [(testing/case "an epic is its publisher's or it does not land" net_tests/signed)
   (testing/case "a landing is the publication, exactly" net_tests/exact)
   (testing/case "a landing is one admission" net_tests/atomic)
   (testing/case "landing is monotone and idempotent" net_tests/monotone)
   (testing/case "history that cannot be answered is recovered by reading everything" net_tests/history)
   (testing/case "a restore cannot reuse a published version" net_tests/restore)
   (testing/case "a restored history lands over the old one" net_tests/breach)
   (testing/case "a refused epic lands nothing and is not asked again" net_tests/refused)
   (testing/case "what a publisher said and what this world holds are cased separately" net_tests/observed)
   (testing/case "the removal of one root of a publisher keeps the other root" net_tests/roots)]
