- eden_store
- helm
- net
- mesa_foot
- testing
- tests/namespace [at=fixture]

' These tests are for the node of the foot, /<self>/io/mesa, and its hand.
' 0x18 has the node, and it holds the key of 0x17. There is no foot and no
' transport: the test pokes the node as the foot does.
+ hand_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + home
    ^ path
    [($x 18) 'io 'mesa]
  + card
    ^ path
    [($x 18) 'io 'mesa ($x 17)]
  + mount
    ^ path
    [($x 18) 'her ($x 17)]
  + root
    ^ path
    [($x 17) 'our ($x 18)]
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (eden_store/changes writes state)
     > (./ok next) next
     > (./err why) state
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + reader
    ' It gives the world of the reader as the foot leaves it at its start:
    ' /<self>/our holds a record, the records of the two hands are there, and each of the two nodes has its behaviour and its
    ' crew.
    ^ namespace
    = self=iota ($x 18)
      start (namespace self sov/new (fixture/namespace_tests/initial).system)
      first=row[[p=path q=writ]] [[hand_tests/home (writ/make myth/new)]
        [[self 'our] (writ/make myth/new)]
        [hand_tests/card (writ/make (myth/sing ['key] (pails/n (Ed25519PublicKey (hand_tests/seed 17)))))]
        [(net/hand self) (writ/make (form/card mesa_foot/form (lore/line "The hand of the Mesa foot")))]
        [(net/horn self) (writ/make (form/card net/herald (lore/line "Tells the Mesa foot of news")))]]
      second=row[[p=path q=writ]] [[hand_tests/home (writ/poke (net/seat self))]
        [[self 'our] (writ/poke (net/watch self))]]
    | hand_tests/apply second (hand_tests/apply first start)
  + publisher
    ^ namespace
    = start (namespace ($x 17) sov/new (fixture/namespace_tests/initial).system)
      writes=row[[p=path q=writ]] [[hand_tests/root (writ/make (hand_tests/rec 1))]
        [(hand_tests/root).snoc('doc) (writ/make (hand_tests/rec 10))]]
    | hand_tests/apply writes start
  + poke
    ' It pokes an errand on the node, as the foot does.
    \ item=mesa_foot/errand state=namespace
    ^ namespace
    = writes=row[[p=path q=writ]] [[hand_tests/home (writ/poke (myth/sing ['errand] item))]]
    | hand_tests/apply writes state
  + value
    \ slot=path name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(slot 0)
  + checks
    \ _=unit
    ^ row[testing/check]
    = b0 hand_tests/reader
      a1 hand_tests/publisher
      head a1.case(.z hand_tests/root).fall(0)
      change (net/delta 0 hand_tests/root 0 head a1)
      sealed (net/seal (hand_tests/seed 17) hand_tests/root change.fall((net/epic 0 0 0 [])))
      b1 (hand_tests/poke (mesa_foot/bid (mesa_foot/order/land hand_tests/mount hand_tests/card sealed)) b0)
      b2 (hand_tests/poke (mesa_foot/bid (mesa_foot/order/land hand_tests/mount hand_tests/card sealed)) b1)
      mine=row[[p=path q=writ]] [[[($x 18) 'our ($x 17)] (writ/make (hand_tests/rec 5))]]
      b3 (hand_tests/apply mine b2)
      t0 (hand_tests/value ['tide] hand_tests/home b0)
    [(testing/nat "the node is seated" 1 (maybe/is_some (sovereign_care .x hand_tests/home b0).fil.fall(myth/new).get(limb_slot)))
     (testing/nat "one poke lands the epic: the record" 10 (hand_tests/value ['value] (hand_tests/mount).snoc('doc) b1))
     (testing/nat "and the statement of its publisher" 1 (gt (net/version (hand_tests/mount).snoc('doc) (net/sees b1)) 0))
     (testing/nat "and where the mount stands" (net/stamp 0 head) (net/held ['head] hand_tests/card (net/sees b1)))
     (testing/nat "the errand is not kept on the node" 0 (maybe/is_some (sovereign_care .x hand_tests/home b1).fil.fall(myth/new).get(['errand])))
     (testing/nat "the record, the statement and where the mount stands are one event" b0.local.top.inc b1.local.top)
     (testing/nat "the same epic a second time does not move where the mount stands" b1.case(.x hand_tests/card).fall(0) b2.case(.x hand_tests/card).fall(0))
     (testing/nat "nor the record" b1.case(.x (hand_tests/mount).snoc('doc)).fall(0) b2.case(.x (hand_tests/mount).snoc('doc)).fall(0))
     (testing/nat "nor the statement" b1.case(.x (net/note (hand_tests/mount).snoc('doc))).fall(0) b2.case(.x (net/note (hand_tests/mount).snoc('doc))).fall(0))
     (testing/nat "a landing does not count as news" t0 (hand_tests/value ['tide] hand_tests/home b2))
     (testing/nat "a change of what this world publishes counts" t0.inc (hand_tests/value ['tide] hand_tests/home b3))]

+ tests
  ^ row[testing/case]
  [(testing/case "the node of the foot lands by one poke and counts the news" hand_tests/checks)]
