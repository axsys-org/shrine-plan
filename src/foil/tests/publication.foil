- publication
- testing

+ publication_tests
  + description
    : revision=nat
  + record
    \ revision=nat
    ^ myth
    | myth/sing ['sys 'mold] (publication_tests/description revision)
  + case
    \ name=path state=sov
    ^ nat
    ? state.x_case(name)
     > (./some number) number
     > .none 0
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = name=path ['sys 'types 'sample]
      names=row[path] [name]
      initial | publication_batch/prepare 'sys names sov/new
    ?> (./ok first) initial
      [(testing/nat "prepare initial" 1 0)]
    = records
        | (axal/new[myth] .none).put name (publication_tests/record 1)
      result | first.publish records 0 0 sov/new
    ?> (./ok one) result
      [(testing/nat "publish initial" 1 0)]
    = prepared | publication_batch/prepare 'sys names one
    ?> (./ok second) prepared
      [(testing/nat "prepare revision" 1 0)]
    = revised
        | records.put name (publication_tests/record 2)
      result | second.publish revised 0 0 one
    ?> (./ok two) result
      [(testing/nat "publish revision" 1 0)]
    = stale | first.publish revised 0 0 one
      unchanged | second.publish records 0 0 one
      incomplete | second.publish (axal/new[myth] .none) 0 0 one
      untyped | second.publish (records.put(name myth/new)) 0 0 one
      foreign | publication_batch/prepare ($x 1) names sov/new
      duplicate | publication_batch/prepare 'sys [name name] sov/new
      history | two.x_query 1 name
      forged | first.set_authority('invalid).publish records 0 0 sov/new
    [(testing/nat "forged authority rejected" 1 ?=((./err _) forged))
     (testing/nat "fresh definition case one" 1
       (publication_tests/case name one))
     (testing/nat "new publication advances moment" 2
       (publication_tests/case name two))
     (testing/nat "original store unchanged" 1
       (publication_tests/case name one))
     (testing/nat "previous moment remains readable" 1
       ?=((./known _) history))
     (testing/nat "stale batch rejected" 1 ?=((./err _) stale))
     (testing/nat "nonadvancing batch rejected" 1 ?=((./err _) unchanged))
     (testing/nat "partial batch rejected" 1 ?=((./err _) incomplete))
     (testing/nat "missing descriptor rejected" 1 ?=((./err _) untyped))
     (testing/nat "foreign definition rejected" 1 ?=((./err _) foreign))
     (testing/nat "duplicate assignment rejected" 1 ?=((./err _) duplicate))]

+ brand_reference_checks
  \ ignored=unit
  ^ row[testing/check]
  = reference (definition_reference ['sys 'types 'sample] 1)
    parsed | definition_reference/parse reference.brand
    later (definition_reference reference.path 2)
    old | definition_reference/parse "/boot/sample"
  [(testing/nat "published reference brand round trip" 1
      (equal[maybe[definition_reference]] (./some reference) parsed))
   (testing/nat "different moments have different brands" 0
      (eq reference.brand later.brand))
   (testing/nat "old brand formats are rejected" 1 ?=(.none old))]

+ tests
  ^ row[testing/case]
  [(testing/case "atomic definition publication" publication_tests/checks)
   (testing/case "definition brand references" brand_reference_checks)]
