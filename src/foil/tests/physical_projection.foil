- physical_projection
- testing

' These checks parse the actual forced wire response, never a parallel model.
+ projection_tests
  + fail_json
    \ code=nat
    ^ json
    = values=row[json] []
    | values.at (Throw code)
  + member
    \ key=str object=json
    ^ json
    ?> record=json/obj object (projection_tests/fail_json 850)
    % i=nat 0
    ^ json
    ? (eq i record.kvs.len) (projection_tests/fail_json 851)
    = entry record.kvs.at(i)
    ? (equal[str] entry.k key) entry.v
    | _ i.inc
  + has
    \ key=str object=json
    ^ bool
    ?> record=json/obj object .false
    | record.kvs.any((\ entry=jkv (equal[str] key entry.k)))
  + text
    \ value=json
    ^ str
    ?> text=json/str value (str/from_atom (Throw 852))
    text.s
  + number
    \ value=json
    ^ nat
    ?> number=json/num value (Throw 853)
    number.n
  + boolean
    \ value=json
    ^ bool
    ?> boolean=json/boo value (Throw 854)
    boolean.b
  + null
    \ value=json
    ^ bool
    ? value
     > json/nul .true
    .false
  + items
    \ value=json
    ^ row[json]
    = arrays=row[row[json]] []
    ?> array=json/arr value arrays.at((Throw 855))
    array.xs
  + parse_document
    \ body=str
    ^ json
    ? (parse body)
     > (jres/ok value _) value
     > (jres/err _ _) (projection_tests/fail_json 856)
  + version
    \ record=myth
    ^ saga
    | saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0)) (pin record)
  + history
    \ record=myth
    ^ tome
    | tome (pin (uon/sing[ass] ($u 1) (ass/ker (projection_tests/version record))))
  + state
    \ index=axal[tome]
    ^ sov
    | sov (ledger [] []) index 3 (axal/new[urn] .none)
  + rooted
    \ record=myth
    ^ sov
    | projection_tests/state (axal/new[tome] (./some (projection_tests/history record)))
  + request
    \ collection=iota after=maybe[path]
    ^ physical_read/request
    | physical_read/request [] (./some 3) collection after 40
  + raw
    \ query=physical_read/request state=sov
    ^ str
    ? (physical_projection/safe_json query state)
     > (./ok body) body
     > (./err _) (str/from_atom (Throw 857))
  + document
    \ query=physical_read/request state=sov
    ^ json
    | projection_tests/parse_document (projection_tests/raw query state)
  + error
    \ query=physical_read/request state=sov
    ^ iota
    ? (physical_projection/safe_json query state)
     > (./err reason) reason
     > (./ok _) 'unexpected_success
  + encoded
    \ key=path
    ^ str
    ?> (./ok text) (physical_key/encode key) (str/from_atom (Throw 858))
    text
  + decoded
    \ text=str
    ^ path
    = paths=row[path] []
    ?> (./some key) (physical_key/decode text) paths.at((Throw 859))
    key
  + entries
    \ document=json
    ^ row[json]
    | projection_tests/items (projection_tests/member "entries" document)
  + keys
    \ document=json
    ^ row[path]
    | (projection_tests/entries document).map
      (\ entry=json
        (projection_tests/decoded (projection_tests/text (projection_tests/member "key" entry))))
  + next
    \ document=json
    ^ maybe[path]
    = value (projection_tests/member "next" document)
    ? (projection_tests/null value) .none
    | ./some (projection_tests/decoded (projection_tests/text value))
  + entry
    \ key=path document=json
    ^ json
    = wanted (projection_tests/encoded key)
      entries (projection_tests/entries document)
    % i=nat 0
    ^ json
    ? (eq i entries.len) (projection_tests/fail_json 860)
    = entry entries.at(i)
    ? (equal[str] wanted (projection_tests/text (projection_tests/member "key" entry))) entry
    | _ i.inc
  + value
    \ key=path document=json
    ^ json
    | projection_tests/member "value" (projection_tests/entry key document)
  + own
    \ document=json
    ^ json
    | projection_tests/member "own" document

  + states
    \ ignored=unit
    ^ row[testing/check]
    = empty (projection_tests/document (physical_read/request [] .none 'children .none 40) sov/new)
      own (projection_tests/own empty)
      blank (projection_tests/document (projection_tests/request 'slots .none) (projection_tests/rooted myth/new))
      old (projection_tests/version myth/new)
      dead (tome (pin (uon/sing[ass] ($u 2) (ass/nul old.aeon))))
      gone (projection_tests/state (axal/new[tome] (./some dead)))
      dead_page (projection_tests/document (projection_tests/request 'children .none) gone)
      dead_own (projection_tests/own dead_page)
    [(testing/nat "wire version is numeric1" 1 (projection_tests/number (projection_tests/member "version" empty)))
     (testing/text "physical resolution is explicit" "physical" (projection_tests/text (projection_tests/member "resolution" empty)))
     (testing/text "root identity is lossless" "v1" (projection_tests/text (projection_tests/member "pathKey" empty)))
     (testing/text "initial epoch captured as exact decimal string" "0" (projection_tests/text (projection_tests/member "epoch" empty)))
     (testing/nat "empty namespace has empty entries" 0 (projection_tests/entries empty).len)
     (testing/nat "empty namespace complete" 1 (projection_tests/boolean (projection_tests/member "complete" empty)))
     (testing/nat "empty page after null" 1 (projection_tests/null (projection_tests/member "after" empty)))
     (testing/nat "empty page next null" 1 (projection_tests/null (projection_tests/member "next" empty)))
     (testing/text "unknown own state is not tombstone" "unknown" (projection_tests/text (projection_tests/member "state" own)))
     (testing/nat "unknown own field count unavailable" 1 (projection_tests/null (projection_tests/member "fields" own)))
     (testing/nat "unknown own epoch unavailable" 1 (projection_tests/null (projection_tests/member "recordEpoch" own)))
     (testing/text "live empty record retains state" "live" (projection_tests/text (projection_tests/member "state" (projection_tests/own blank))))
     (testing/text "live empty record has zero fields" "0" (projection_tests/text (projection_tests/member "fields" (projection_tests/own blank))))
     (testing/text "own epoch differs from snapshot epoch" "1" (projection_tests/text (projection_tests/member "recordEpoch" (projection_tests/own blank))))
     (testing/text "tombstone retains its state" "tombstone" (projection_tests/text (projection_tests/member "state" dead_own)))
     (testing/text "tombstone retains actual assertion epoch" "2" (projection_tests/text (projection_tests/member "recordEpoch" dead_own)))
     (testing/nat "tombstone does not invent zero fields" 1 (projection_tests/null (projection_tests/member "fields" dead_own)))
     (testing/nat "tombstone slots reject distinctly" 1 (eq_iota 'record_deleted (projection_tests/error (projection_tests/request 'slots .none) gone)))]

  + metadata
    \ ignored=unit
    ^ row[testing/check]
    = lede (str/repeat 300 "L")
      line (str/repeat 400 "B")
      record (myth/sing bond/lede (pails/t lede)).put(bond/help (lore "Fallback" ["" "" line "ignored"] []))
      document (projection_tests/document (projection_tests/request 'children .none) (projection_tests/rooted record))
      own (projection_tests/own document)
      label (projection_tests/member "label" own)
      help (projection_tests/member "help" own)
      fallback (myth/sing bond/help (lore "Authored head" ["" "" "" "" "fifth line is outside preview"] []))
      fallback_doc (projection_tests/own (projection_tests/document (projection_tests/request 'children .none) (projection_tests/rooted fallback)))
      plain (myth/sing bond/help (pails/t "Plain help"))
      plain_doc (projection_tests/own (projection_tests/document (projection_tests/request 'children .none) (projection_tests/rooted plain)))
    [(testing/text "lede wins over lore headline" "lede" (projection_tests/text (projection_tests/member "labelSource" own)))
     (testing/text "authored label bytes" (str/repeat 256 "4c") (projection_tests/text (projection_tests/member "hex" label)))
     (testing/text "label reports full byte count" "300" (projection_tests/text (projection_tests/member "total" label)))
     (testing/nat "clipped label is not complete" 0 (projection_tests/boolean (projection_tests/member "complete" label)))
     (testing/text "help source is authored lore body" "lore-body" (projection_tests/text (projection_tests/member "helpSource" own)))
     (testing/nat "help line index is explicit" 2 (projection_tests/number (projection_tests/member "helpLine" own)))
     (testing/text "help bytes bounded to256" (str/repeat 256 "42") (projection_tests/text (projection_tests/member "hex" help)))
     (testing/text "help reports full selected line bytes" "400" (projection_tests/text (projection_tests/member "total" help)))
     (testing/nat "clipped help is not complete" 0 (projection_tests/boolean (projection_tests/member "complete" help)))
     (testing/text "lore head used only when lede absent" "lore-head" (projection_tests/text (projection_tests/member "labelSource" fallback_doc)))
     (testing/nat "no scan beyond first four lore entries" 1 (projection_tests/null (projection_tests/member "help" fallback_doc)))
     (testing/nat "unselected help line is null" 1 (projection_tests/null (projection_tests/member "helpLine" fallback_doc)))
     (testing/text "text help gets explicit source" "help-text" (projection_tests/text (projection_tests/member "helpSource" plain_doc)))
     (testing/nat "plain text help has no invented line index" 1 (projection_tests/null (projection_tests/member "helpLine" plain_doc)))]

  + values
    \ ignored=unit
    ^ row[testing/check]
    = target=path [($ta "a/b") ($rd 9221120237041090561)]
      record=myth myth/new
      record record.put(['text] (pails/t (str/repeat 10000 "a"))).put(['natural] (pails/n (bex 8192)))
      record record.put(['nul] (pails/t (str/from_atom 4259905))).put(['invalid] (pails/t (str/from_atom 255)))
      record record.put(['path] (pails/p target)).put(['safe] (safe 7 .y target))
      record record.put(['opaque] (pails/q 'hidden)).put(['zero] (pails/n 0))
      document (projection_tests/document (projection_tests/request 'slots .none) (projection_tests/rooted record))
      text (projection_tests/value ['text] document)
      natural (projection_tests/value ['natural] document)
      nul (projection_tests/value ['nul] document)
      invalid (projection_tests/value ['invalid] document)
      path (projection_tests/value ['path] document)
      reference (projection_tests/value ['safe] document)
      opaque (projection_tests/value ['opaque] document)
      zero (projection_tests/value ['zero] document)
    [(testing/text "huge text type preserved" "text" (projection_tests/text (projection_tests/member "type" text)))
     (testing/text "huge text exact first256 bytes" (str/repeat 256 "61") (projection_tests/text (projection_tests/member "hex" text)))
     (testing/text "huge text total retained" "10000" (projection_tests/text (projection_tests/member "total" text)))
     (testing/nat "huge text marked incomplete" 0 (projection_tests/boolean (projection_tests/member "complete" text)))
     (testing/text "huge natural type preserved" "natural" (projection_tests/text (projection_tests/member "type" natural)))
     (testing/text "natural retains zero-filled byte prefix" (str/repeat 256 "00") (projection_tests/text (projection_tests/member "hex" natural)))
     (testing/text "natural exact byte total" "1025" (projection_tests/text (projection_tests/member "total" natural)))
     (testing/nat "natural is incomplete" 0 (projection_tests/boolean (projection_tests/member "complete" natural)))
     (testing/text "embedded NUL preserved in wire bytes" "410041" (projection_tests/text (projection_tests/member "hex" nul)))
     (testing/nat "small binary text is byte-complete" 1 (projection_tests/boolean (projection_tests/member "complete" nul)))
     (testing/text "invalid UTF8 remains raw hex" "ff" (projection_tests/text (projection_tests/member "hex" invalid)))
     (testing/nat "reference path identity remains exact" 1 (eq_pith target (projection_tests/decoded (projection_tests/text (projection_tests/member "pathKey" path)))))
     (testing/nat "unsafe lexical path display is omitted" 1 (projection_tests/null (projection_tests/member "displayPath" path)))
     (testing/text "safe reference stays opaque" "opaque" (projection_tests/text (projection_tests/member "type" reference)))
     (testing/nat "safe does not lose care/version through a plain link" 0 (projection_tests/has "pathKey" reference))
     (testing/text "unsupported pail stays opaque" "opaque" (projection_tests/text (projection_tests/member "type" opaque)))
     (testing/text "opaque reason is honest" "unsupported_type" (projection_tests/text (projection_tests/member "reason" opaque)))
     (testing/text "zero natural has empty raw hex" "" (projection_tests/text (projection_tests/member "hex" zero)))
     (testing/nat "zero natural is complete" 1 (projection_tests/boolean (projection_tests/member "complete" zero)))]

  + wide_key
    \ n=nat
    ^ path
    [($tu (str/to_atom (str/repeat 4000 "k"))) ($u n)]
  + wide_state
    ^ sov
    = record
        % n=nat 0 record=myth myth/new
        ? (eq n 40) record
        | _ n.inc record.put((projection_tests/wide_key n) (pails/n n))
    | projection_tests/rooted record
  + budgets
    \ ignored=unit
    ^ row[testing/check]
    = source projection_tests/wide_state
      raw (projection_tests/raw (projection_tests/request 'slots .none) source)
      document (projection_tests/parse_document raw)
      keys (projection_tests/keys document)
      next (projection_tests/next document)
      entries (projection_tests/entries document)
      entry_bytes entries.fold(0 (\ used=nat entry=json (add used (show entry).len.inc)))
      everything
        % after=maybe[path] .none out=row[path] []
        = page (projection_tests/document (projection_tests/request 'slots after) source)
          all out.weld((projection_tests/keys page))
          next (projection_tests/next page)
        ? (maybe/is_none next) all
        | _ next all
      expected (row/range 0 40).map(projection_tests/wide_key)
      too_large=path [($tu (bex 32744))]
      bad_record (myth/sing too_large (pails/n 1))
    [(testing/nat "wire response within131072bytes" 1 (le raw.len 131072))
     (testing/nat "serialized entries within98304bytes" 1 (le entry_bytes 98304))
     (testing/nat "entry budget yields a nonempty shorter page" 1
       (? (eq keys.len 0) .false (lt keys.len 40)))
     (testing/nat "full physical total remains40" 1
       (equal[str] "40" (projection_tests/text (projection_tests/member "total" document))))
     (testing/nat "byte-limited page is incomplete" 0 (projection_tests/boolean (projection_tests/member "complete" document)))
     (testing/nat "cursor is last included key" 1 (equal[maybe[path]] (./some keys.at(keys.len.dec)) next))
     (testing/nat "byte-limited later pages retain complete access" 1 (equal[row[path]] expected everything))
     (testing/nat "oversized slot key refuses without clipping/skipping" 1
       (eq_iota 'key_too_large (projection_tests/error (projection_tests/request 'slots .none) (projection_tests/rooted bad_record))))]

  + ordering
    \ ignored=unit
    ^ row[testing/check]
    = record=myth myth/new
      record record.put([($u 256)] (pails/n 3)).put([] (pails/n 0))
      record record.put(['a 'b] (pails/n 2)).put(['a] (pails/n 1)).put([($u 255)] (pails/n 4))
      document (projection_tests/document (projection_tests/request 'slots .none) (projection_tests/rooted record))
    [(testing/nat "wire keeps opaque slot order not hex-string order" 1
       (equal[row[path]] [[] ['a] ['a 'b] [($u 255)] [($u 256)]] (projection_tests/keys document)))
     (testing/nat "full smaller page has no continuation" 1 (maybe/is_none (projection_tests/next document)))]

  + bad_record
    \ code=nat
    ^ pin[myth]
    = records=row[pin[myth]] []
    | records.at (Throw code)
  + broken
    \ code=nat
    ^ sov
    = version (saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0))
        (projection_tests/bad_record code))
      history (tome (pin (uon/sing[ass] ($u 1) (ass/ker version))))
    | projection_tests/state (axal/new[tome] (./some history))
  + force_broken
    \ code=nat
    ^ either[iota str]
    | physical_projection/force_json
        [(projection_tests/request 'children .none) (projection_tests/broken code)]
  + recovery
    \ ignored=unit
    ^ row[testing/check]
    = broken (projection_tests/broken 861)
      failure (projection_tests/error (projection_tests/request 'children .none) broken)
      positive (Try projection_tests/force_broken 862)
      healthy (projection_tests/document (projection_tests/request 'slots .none)
        (projection_tests/rooted (myth/sing ['healthy] (pails/t "works"))))
    [(testing/nat "full forced projection catches malformed record" 1 (eq_iota 'read_failed failure))
     (testing/nat "control: uncaught projection really throws" 1 (either/is_err positive))
     (testing/text "healthy read succeeds after contained error" "776f726b73"
       (projection_tests/text (projection_tests/member "hex" (projection_tests/value ['healthy] healthy))))]

+ tests
  ^ row[testing/case]
  [(testing/case "wire states and envelope" projection_tests/states)
   (testing/case "fixed bounded authored metadata" projection_tests/metadata)
   (testing/case "exact scalar bytes and honest opaque values" projection_tests/values)
   (testing/case "entry byte budgets and complete continuation" projection_tests/budgets)
   (testing/case "native structural key ordering" projection_tests/ordering)
   (testing/case "forced error containment and recovery" projection_tests/recovery)]
