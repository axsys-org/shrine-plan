- helm
- net
- pass
- door
- http_foot
- testing
- tests/namespace [at=base]

' A world's door: which sessions open it. 0x12 states a custody key on its
' own card; its grants are signed with that key's seed.
+ door_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + put
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + world
    ' A world whose card states the custody key of a seed.
    \ custody=nat
    ^ namespace
    = home=path [($x 18) 'io 'mesa]
      blank (namespace ($x 18) sov/new (base/namespace_tests/initial).system)
      writes=row[[p=path q=writ]] [[home (writ/make (myth/sing ['custody] (pails/n (Ed25519PublicKey custody))))]]
    | door_tests/put writes blank
  + let
    ' The world after it keeps a grant.
    \ g=pass/grant state=namespace
    ^ namespace
    = writes=row[[p=path q=writ]] [[(door/at ($x 18) g.session) (writ/make (door/grant g))]]
    | door_tests/put writes state
  + yes
    \ open=bool
    ^ nat
    ? open 1
    0
  + checks
    \ _=unit
    ^ row[testing/check]
    = custody (door_tests/seed 300)
      live (door_tests/seed 301)
      session (door/named "the secret a browser keeps")
      other (door/named "another secret")
      w0 (door_tests/world custody)
      good (door_tests/let (pass/allow custody 18 session 5000) w0)
      by_live (door_tests/let (pass/allow live 18 session 5000) w0)
      elsewhere (door_tests/let (pass/allow custody 19 session 5000) w0)
      moved=row[[p=path q=writ]] [[[($x 18) 'io 'mesa] (writ/poke (myth/sing ['custody] (pails/n (Ed25519PublicKey (door_tests/seed 310)))))]]
      after (door_tests/put moved good)
      nl http_foot/crlf
      head (str/cat_all ["GET /x HTTP/1.1" nl "Host: a" nl "Authorization: Bearer the secret a browser keeps" nl "Content-Length: 0" nl])
      shout (str/cat_all ["GET /x HTTP/1.1" nl "AUTHORIZATION:   bearer the secret a browser keeps  " nl])
      basic (str/cat_all ["GET /x HTTP/1.1" nl "Authorization: Basic abc" nl])
      none (str/cat_all ["GET /x HTTP/1.1" nl "Host: a" nl])
    [(testing/nat "a session with a grant the world's custody signed opens the door" 1 (door_tests/yes (door/open session 1000 good)))
     (testing/nat "a session with no grant does not" 0 (door_tests/yes (door/open other 1000 good)))
     (testing/nat "nobody does not" 0 (door_tests/yes (door/open 0 1000 good)))
     (testing/nat "a grant ends" 0 (door_tests/yes (door/open session 5000 good)))
     (testing/nat "a grant signed by the key that runs the world opens nothing" 0 (door_tests/yes (door/open session 1000 by_live)))
     (testing/nat "nor one made for another world" 0 (door_tests/yes (door/open session 1000 elsewhere)))
     (testing/nat "after custody moves, the old grant opens nothing" 0 (door_tests/yes (door/open session 1000 after)))
     (testing/nat "a world that states no custody has no door to open" 0 (door_tests/yes (door/open session 1000 (door_tests/let (pass/allow custody 18 session 5000) (namespace ($x 18) sov/new (base/namespace_tests/initial).system)))))
     (testing/nat "a request's session is the hash of the secret it carries" 1 (eq session (http_foot/session head)))
     (testing/nat "however the header is spelled" 1 (eq session (http_foot/session shout)))
     (testing/nat "another kind of authorization is nobody" 0 (http_foot/session basic))
     (testing/nat "and so is none" 0 (http_foot/session none))]

+ tests
  ^ row[testing/case]
  [(testing/case "which sessions open a world's door" door_tests/checks)]
