- ethereum_word
- testing

+ ethereum_word_tests
  + show
    \ result=either[ethereum_word/fault nat]
    ^ str
    ? result
     > (./ok n) (nat/show n)
     > (./err fault)
      ? fault
       > .range "range"
       > .overflow "overflow"
       > .underflow "underflow"
       > .zero_divisor "zero_divisor"
  + check
    \ name=str want=either[ethereum_word/fault nat] got=either[ethereum_word/fault nat]
    ^ testing/check
    | testing/same[either[ethereum_word/fault nat]] name ethereum_word_tests/show want got
  + boundaries
    \ ignored=unit
    ^ row[testing/check]
    = limit (bex 256)
      last (dec limit)
    [(ethereum_word_tests/check "largest word" (./ok last) (ethereum_word/check last))
     (ethereum_word_tests/check "range is exclusive" (./err .range) (ethereum_word/check limit))
     (ethereum_word_tests/check "addition at limit" (./ok last) (ethereum_word/add_checked last 0))
     (ethereum_word_tests/check "addition overflow" (./err .overflow) (ethereum_word/add_checked last 1))
     (ethereum_word_tests/check "subtraction to zero" (./ok 0) (ethereum_word/sub_checked last last))
     (ethereum_word_tests/check "subtraction does not saturate" (./err .underflow) (ethereum_word/sub_checked 0 1))
     (ethereum_word_tests/check "multiply at limit" (./ok last) (ethereum_word/mul_checked last 1))
     (ethereum_word_tests/check "multiply overflow" (./err .overflow) (ethereum_word/mul_checked last 2))
     (ethereum_word_tests/check "invalid operand is not erased by zero" (./err .range) (ethereum_word/mul_checked limit 0))
     (ethereum_word_tests/check "division floors" (./ok 3) (ethereum_word/div_checked 7 2))
     (ethereum_word_tests/check "division by zero" (./err .zero_divisor) (ethereum_word/div_checked 0 0))
     (ethereum_word_tests/check "division validates denominator" (./err .range) (ethereum_word/div_checked 1 limit))
     (ethereum_word_tests/check "ratio floors after multiplication" (./ok 10) (ethereum_word/mul_div 7 3 2))
     (ethereum_word_tests/check "ratio rejects intermediate overflow" (./err .overflow) (ethereum_word/mul_div last 2 2))]

+ tests
  ^ row[testing/case]
  [(testing/case "checked uint256 boundaries" ethereum_word_tests/boundaries)]
