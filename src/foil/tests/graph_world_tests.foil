- tests/cells [at=fixture]
- graph_world
- view_cache
- testing

'  A thing as a world, read as the page reads it: folders by direction and
'  label, items by name, each thing once on the page, incoming folders
'  closed beyond the subject, every item saying which world asserts it.
+ graph_world_tests
  + folder
    \ direction=iota label=path
    ^ path
    = head=path [direction ($u label.len)]
    | head.weld(label)
  + item
    \ name=path
    ^ path
    = head=path [($u name.len)]
    | head.weld(name)
  + record_at
    \ at=path tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.dip(at).fil.fall(myth/new)
    myth/new
  + root
    \ tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.fil.fall(myth/new)
    myth/new
  + paths_under
    ' Diagnostic: the relative paths beneath a point of the page, joined.
    \ at=path tree=res[axal[myth]]
    ^ str
    ? tree
     > (./known found)
       = names (found.tap.map((\ [rel record] (path_show rel))))
       | str/join " | " names
    "unknown"
  + kids_at
    \ at=path tree=res[axal[myth]]
    ^ nat
    ? tree
     > (./known found) found.dip(at).kid.size
    0
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = property=path [($x 1) 'user 'properties 'building]
      insurer=path [($x 1) 'w12 'user 'carriers 'atlas]
      claim=path [($x 1) 'w12 'user 'claims 'claim_884]
      model=path [($x 1) 'w13 'user 'models 'flood]
      zone=path [($x 1) 'w13 'user 'zones 'ae]
      material=path [($x 1) 'w14 'user 'materials 'panel]
      viewroot=path [($x 1) 'user 'views 'building]
      zoneroot=path [($x 1) 'user 'views 'zone]
      seed (fixture/cell_tests/put property (myth/sing ['name] (pails/t "100 Biscayne")).put(['insured_by] (safe 0 .x insurer)) sov/new)
      seed (fixture/cell_tests/put insurer (myth/sing ['name] (pails/t "Atlas")).put(['model] (safe 0 .x model)).put(['lead_time_days] (pails/n 90)) seed)
      seed (fixture/cell_tests/put claim (myth/sing ['name] (pails/t "Claim 884")).put(['property] (safe 0 .x property)).put(['carrier] (safe 0 .x insurer)).put(['amount] (pails/n 1800000)) seed)
      seed (fixture/cell_tests/put model (myth/sing ['name] (pails/t "Flood v4")).put(['projects] (safe 0 .x zone)) seed)
      seed (fixture/cell_tests/put zone (myth/sing ['name] (pails/t "Zone AE")).put(['contains] (safe 0 .x property)) seed)
      seed (fixture/cell_tests/put material (myth/sing ['name] (pails/t "Panel")).put(['suitable_for] (safe 0 .x zone)) seed)
      config (myth/sing bond/weft (woven graph_world/get)).put(bond/tack (safe 0 .x property)).put(['depth] (pails/n 6))
      seed (fixture/cell_tests/put viewroot config seed)
      seed (fixture/cell_tests/put zoneroot config.put(bond/tack (safe 0 .x zone)) seed)
      page (view .z 0 viewroot.cons('x) seed)
      insured (graph_world_tests/folder 'out ['insured_by])
      atlas insured.weld((graph_world_tests/item insurer))
      flood atlas.weld((graph_world_tests/folder 'out ['model])).weld((graph_world_tests/item model))
      ae flood.weld((graph_world_tests/folder 'out ['projects])).weld((graph_world_tests/item zone))
      claims (graph_world_tests/folder 'in ['property])
      claimed claims.weld((graph_world_tests/item claim))
      again claimed.weld((graph_world_tests/folder 'out ['carrier])).weld((graph_world_tests/item insurer))
      contained (graph_world_tests/folder 'in ['contains]).weld((graph_world_tests/item zone))
      suitable contained.weld((graph_world_tests/folder 'in ['suitable_for]))
      zone_page (view .z 0 zoneroot.cons('x) seed)
      opened (graph_world_tests/folder 'in ['suitable_for]).weld((graph_world_tests/item material))
      direct (view_read (safe 0 .x viewroot.cons('x).weld(atlas)) (view_select/slots [['name]]))
      token=pin[any] (pin 17)
      [first cache cold] (view_cache/read direct (store_reader seed) seed.top token view_cache/new)
      renamed (fixture/cell_tests/put insurer (myth/sing ['name] (pails/t "Atlas Re")).put(['model] (safe 0 .x model)).put(['lead_time_days] (pails/n 90)) seed)
      [second cache hit] (view_cache/read direct (store_reader renamed) renamed.top token cache)
      frontier (view .z 0 viewroot.cons('x) (fixture/cell_tests/put viewroot config.put(['depth] (pails/n 1)) seed))
    [(testing/text "the subject names its world" "0x01" ((graph_world_tests/root page).txt_at(['world])))
     (testing/text "an outgoing relation is a folder holding the thing, named" "Atlas" ((graph_world_tests/record_at atlas page).txt_at(['name])))
     (testing/text "an item says which world owns it" "w12" ((graph_world_tests/record_at atlas page).txt_at(['world])))
     (testing/text "an item says which world asserts the relation" "0x01" ((graph_world_tests/record_at atlas page).txt_at(['by])))
     (testing/nat "a folder counts its items" 1 ((graph_world_tests/record_at insured page).nat_at(['count] 0)))
     (testing/text "the chain opens beneath each item" "Zone AE" ((graph_world_tests/record_at ae page).txt_at(['name])))
     (testing/text "an incoming relation at the subject is open and attributed to the asserting world" "w12" ((graph_world_tests/record_at claimed page).txt_at(['by])))
     (testing/nat "a thing already opened on the page is listed, not opened again" 1 (? (maybe/is_some (graph_world_tests/record_at again page).get(['seen])) 1 0))
     (testing/nat "incoming folders beyond the subject are closed, as a count" 1 ((graph_world_tests/record_at suitable page).nat_at(['count] 0)))
     (testing/nat "a closed folder lists nothing" 0 (graph_world_tests/kids_at suitable page))
     (testing/text "reading the thing as a world opens what was closed" "Panel" ((graph_world_tests/record_at opened zone_page).txt_at(['name])))
     (testing/nat "the subject's back-reference from an ancestor is not shown" 0 (graph_world_tests/kids_at contained.weld((graph_world_tests/folder 'out ['contains])) page))
     (testing/nat "a thing reached again deeper is listed, not opened" 1 (? (maybe/is_some (graph_world_tests/record_at ae page).get(['seen])) 1 0))
     (testing/text "an item branch is addressable and cached" "Atlas" (fixture/cell_tests/text_at ['name] first.value))
     (testing/nat "a change to a listed name invalidates the branch" 0 hit)
     (testing/nat "a frontier read opens nothing beneath its items" 0 (graph_world_tests/kids_at atlas frontier))]

+ tests
  ^ row[testing/case]
  [(testing/case "a thing as a world" graph_world_tests/checks)]
