- bond
- lain_peek
- weft_std
- tests/namespace [at=fixture]
- testing

' Cells on the native /x lens: a record with /sys/weft (x-care safe to
' a standard cell) and /sys/tack (y-care safe to its input).  A live
' tack (version 0) follows the input; a pinned tack is frozen; a cell
' may take another cell's /x as its input; cycles read unknown.
+ cell_tests
  + put
    \ name=path record=myth state=sov
    ^ sov
    = diffs | (axal/new[note] .none).put name (note/make record)
    ? (sov/step diffs 0 0 state)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       next
     > (./rejected _) state
  + cull
    \ name=path state=sov
    ^ sov
    = gone=note .cull
      diffs | (axal/new[note] .none).put name gone
    ? (sov/step diffs 0 0 state)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       next
     > (./rejected _) state
  + churn
    ' count events, one record each under folder: past /ass/span and
    ' /track/span, so the root's history and clocks are sealed behind
    ' pins by the time a cell is read.
    \ folder=path count=nat state=sov
    ^ sov
    % i=nat 1 s=sov state
    ^ sov
    ? (gt i count) s
    | _ i.inc (cell_tests/put folder.snoc(($u i)) (myth/sing ['n] (pails/n i)) s)
  + deal
    \ amount=nat status=str when=nat owner=str
    ^ myth
    | (myth/sing ['amount] (pails/n amount)).put(['status] (pails/t status)).put(['when] (pails/n when)).put(['owner] (pails/t owner))
  + text_at
    \ slot=path answer=res[axal[myth]]
    ^ str
    ?> (./known records) answer ""
    ?> (./some record) records.fil ""
    ?> (./some held) record.get(slot) ""
    ? held
     > t=pails/t t.t
     > q=pails/q (iota_show q.q)
     > n=pails/n (nat/show n.n)
    ""
  + child_nat
    ' A slot of the child at key, through a y read.
    \ key=iota slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    ?> (./some child) records.kid_get(key) 0
    ?> (./some record) child.fil 0
    ?> (./some held) record.get(slot) 0
    ? held
     > n=pails/n n.n
    0
  + child_text
    \ key=iota slot=path answer=res[axal[myth]]
    ^ str
    ?> (./known records) answer ""
    ?> (./some child) records.kid_get(key) ""
    ?> (./some record) child.fil ""
    ?> (./some held) record.get(slot) ""
    ? held
     > t=pails/t t.t
     > q=pails/q (iota_show q.q)
    ""
  + ref_at
    ' The path a reference slot of a child points at, as text.
    \ key=iota slot=path answer=res[axal[myth]]
    ^ str
    ?> (./known records) answer ""
    ?> (./some child) records.kid_get(key) ""
    ?> (./some record) child.fil ""
    ?> (./some held) record.get(slot) ""
    ?> s=safe held ""
    | path_show s.path
  + text_in
    ' A text slot of the record at a path of the answer.
    \ p=path slot=path answer=res[axal[myth]]
    ^ str
    ?> (./known records) answer ""
    ?> (./some record) (records.dip(p)).fil ""
    ?> (./some held) record.get(slot) ""
    ? held
     > t=pails/t t.t
    ""
  + present
    ' Whether a record exists at a path of the answer.
    \ p=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    | ? (maybe/is_some (records.dip(p)).fil) 1 0
  + child_bool
    ' A boolean slot of the child at key: 1 true, 0 false, 2 absent.
    \ key=iota slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 2
    ?> (./some child) records.kid_get(key) 2
    ?> (./some record) child.fil 2
    ?> (./some held) record.get(slot) 2
    ? held
     > b=pails/b (? b.b 1 0)
    2
  + bool_at
    \ slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 2
    ?> (./some record) records.fil 2
    ?> (./some held) record.get(slot) 2
    ? held
     > b=pails/b (? b.b 1 0)
    2
  + make
    \ ctor=path tack=safe params=row[[path pail]]
    ^ myth
    | params.fold (myth/sing bond/weft (safe 1 .x ctor)).put(bond/tack tack)
      \ record [slot value]
      | record.put slot value
  + nat_at
    \ slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    ?> (./some record) records.fil 0
    ?> (./some held) record.get(slot) 0
    ? held
     > n=pails/n n.n
    0
  + neg_at
    ' The magnitude of a signed (negative) number at a slot, 0 otherwise.
    \ slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    ?> (./some record) records.fil 0
    ?> (./some held) record.get(slot) 0
    ? held
     > z=pails/z (? z.neg z.n 0)
    0
  + kids
    \ answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    records.kid.size
  + has
    \ slot=path answer=res[axal[myth]]
    ^ bool
    ?> (./known records) answer .false
    ?> (./some record) records.fil .false
    | maybe/is_some record.get(slot)
  + probe
    ' 1 unknown, 2 null, 3 known without root, 4 known with root
    \ answer=res[axal[myth]]
    ^ nat
    ? answer
     > .unknown 1
     > .null 2
     > (./known records) (? (maybe/is_some records.fil) 4 3)
    0
  + text_len
    \ slot=path answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    ?> (./some record) records.fil 0
    ?> (./some held) record.get(slot) 0
    ? held
     > t=pails/t t.t.len
    0
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      self=iota ($x 1)
      lib=path [self 'weft 'stdlib]
      deals=path [self 'org 'deals]
      views=path [self 'org 'views]
      x
        \ name=iota
        ^ path
        | ['x self 'org 'views name]
      live
        \ target=path
        ^ safe
        | safe 0 .y target
      seeds=row[[path myth]] weft_std/seeds
      with_lib
        | seeds.fold initial.local
          \ state [name record]
          | cell_tests/put name.cons(self) record state
      with_deals
        = diffs
            | (axal/new[note] .none).gas
              [[deals (note/make (myth/sing ['title] (pails/t "Deals")))]
               [deals.snoc('d1) (note/make (cell_tests/deal 50 "closed" 10 "ann"))]
               [deals.snoc('d2) (note/make (cell_tests/deal 70 "open" 20 "bo"))]
               [deals.snoc('d3) (note/make (cell_tests/deal 25 "closed" 30 "ann"))]
               [[self 'org 'prices 'p1] (note/make (myth/sing ['sku] (pails/t "a")).put(['price] (pails/n 5)))]
               [[self 'org 'prices 'p2] (note/make (myth/sing ['sku] (pails/t "b")).put(['price] (pails/n 7)))]
               [[self 'org 'items 'i1] (note/make (myth/sing ['sku] (pails/t "a")).put(['qty] (pails/n 2)))]
               [[self 'org 'items 'i2] (note/make (myth/sing ['sku] (pails/t "b")).put(['qty] (pails/n 3)))]
               [[self 'org 'money 'm1] (note/make (myth/sing ['amount] (pails/n 1250)).put(['scale] (pails/n 2)))]
               [[self 'org 'money 'm2] (note/make (myth/sing ['amount] (pails/n 75)).put(['scale] (pails/n 1)))]
               [[self 'org 'flags 'f1] (note/make (myth/sing ['ok] (pails/b .true)))]
               [[self 'org 'flags 'f2] (note/make (myth/sing ['ok] (pails/b .false)))]
               [[self 'org 'extra 'e1] (note/make (myth/sing ['amount] (pails/n 1)))]
               [[self 'org 'notes 'n1] (note/make (myth/sing ['slot] (pails/t "/revenue")).put(['value] (pails/n 80)).put(['case] (pails/n 1)))]
               [[self 'org 'notes 'n2] (note/make (myth/sing ['slot] (pails/t "/extra")).put(['value] (pails/t "x")).put(['case] (pails/n 0)))]
               [[self 'org 'rownotes 'r1] (note/make (myth/sing ['slot] (pails/t "/d1/amount")).put(['value] (pails/n 60)).put(['case] (pails/n 1)))]
               [[self 'org 'rownotes 'r2] (note/make (myth/sing ['slot] (pails/t "/d9/amount")).put(['value] (pails/n 1)).put(['case] (pails/n 1)))]
               [[self 'org 'days 'x1] (note/make (myth/sing ['day] (pails/n 20260407)))]
               [[self 'org 'days 'x2] (note/make (myth/sing ['day] (pails/t "2025-12-31")))]
               [[self 'org 'txt 't1] (note/make (myth/sing ['s] (pails/t "  Ann  ")).put(['u] (pails/t "ab-cd-ab")))]
               [[self 'org 'ties 'a] (note/make (myth/sing ['g] (pails/n 1)).put(['v] (pails/n 5)))]
               [[self 'org 'ties 'b] (note/make (myth/sing ['g] (pails/n 1)).put(['v] (pails/n 3)))]
               [[self 'org 'ties 'c] (note/make (myth/sing ['g] (pails/n 0)).put(['v] (pails/n 9)))]
               [[self 'org 'flatkeys 'a_x] (note/make (myth/sing ['n] (pails/n 1)))]
               [[self 'org 'flatkeys 'b] (note/make (myth/sing ['n] (pails/n 2)))]]
        ? (sov/step diffs 0 0 with_lib)
         > (./accepted result=[next=sov signs=axal[sign]])
           = [next signs] result
           next
         > (./rejected _) with_lib
      cell_at
        \ name=iota ctor=iota tack=safe params=row[[path pail]] state=sov
        ^ sov
        | cell_tests/put views.snoc(name) (cell_tests/make lib.snoc(ctor) tack params) state
      s1 (cell_at 'count 'count (live deals) [] with_deals)
      s2 (cell_at 'frozen 'count (safe 1 .y deals) [] s1)
      s3 (cell_at 'closed 'where (live deals) [[['key] (pails/t "/status")] [['value] (pails/t "closed")]] s2)
      s4 (cell_at 'revenue 'sum (live (x 'closed)) [[['slot] (pails/t "/amount")] [['into] (pails/t "/revenue")]] s3)
      s5 (cell_at 'left 'subtract (live (x 'revenue)) [[['left] (pails/t "300")] [['right] (pails/t "/revenue")]] s4)
      s6 (cell_at 'hole 'sum (live deals) [] s5)
      s7 (cell_at 'loop 'count (live views) [] s6)
      s8 (cell_at 'ping 'count (live (x 'pong)) [] s7)
      s9 (cell_at 'pong 'count (live (x 'ping)) [] s8)
      s10 (cell_tests/put [self 'org 'budget] (myth/sing ['amount] (pails/n 300)) s9)
      s11 (cell_at 'remaining 'subtract (live (x 'revenue))
        [[['budget] (safe 1 .x [self 'org 'budget])] [['left] (pails/t "/views/budget/amount")] [['right] (pails/t "/revenue")]] s10)
      identity
        \ record=myth children=axal[myth]
        ^ axal[myth]
        children
      s12 (cell_tests/put views.snoc('inline)
        (myth/sing bond/weft (spun identity .none)).put(bond/tack (safe 1 .y deals)) s11)
      t (\ v=str (pails/t v))
      prices=path [self 'org 'prices]
      money=path [self 'org 'money]
      library=row[[iota iota safe row[[path pail]]]]
        [['min 'min (live deals) [[['slot] (t "/amount")]]]
         ['max 'max (live deals) [[['slot] (t "/amount")]]]
         ['avg 'avg (live deals) [[['slot] (t "/amount")]]]
         ['anyok 'any (live [self 'org 'flags]) [[['slot] (t "/ok")]]]
         ['allok 'all (live [self 'org 'flags]) [[['slot] (t "/ok")]]]
         ['big 'where (live deals) [[['key] (t "/amount")] [['op] (t "over")] [['value] (t "40")]]]
         ['anns 'where (live deals) [[['key] (t "/owner")] [['op] (t "contains")] [['value] (t "n")]]]
         ['sorted 'sort (live deals) [[['slot] (t "/amount")]]]
         ['top2 'top (live deals) [[['slot] (t "/amount")] [['count] (t "2")]]]
         ['last 'latest (live deals) [[['slot] (t "/when")]]]
         ['first 'earliest (live deals) [[['slot] (t "/when")]]]
         ['doubled 'each (live deals) [[['left] (t "/amount")] [['op] (t "multiply")] [['right] (t "2")] [['into] (t "/double")]]]
         ['priced 'lookup (live [self 'org 'items]) [[['key] (t "/sku")] [['take] (t "/price")] [['table] (live prices)]]]
         ['statuses 'distinct (live deals) [[['slot] (t "/status")]]]
         ['amounts 'select (live deals) [[['slots] (t "/amount")]]]
         ['bystatus 'by (live deals) [[['key] (t "/status")] [['op] (t "sum")] [['slot] (t "/amount")]]]
         ['gridded 'grid (live deals) [[['row] (t "/status")] [['col] (t "/owner")]]]
         ['flat 'flatten (live deals) []]
         ['merged 'merge (live deals) [[['extra] (live [self 'org 'extra])]]]
         ['twice 'multiply (live (x 'revenue)) [[['left] (t "2")] [['right] (t "/revenue")]]]
         ['quarter 'divide (live (x 'revenue)) [[['left] (t "300")] [['right] (t "/revenue")]]]
         ['picked 'pick (live (x 'revenue)) [[['budget] (safe 1 .x [self 'org 'budget])] [['from] (t "/views/budget/amount")] [['into] (t "/budget")]]]
         ['noted 'put (live (x 'revenue)) [[['into] (t "/note")] [['value] (t "hello")]]]
         ['cash 'sum (live money) [[['slot] (t "/amount")]]]
         ['meancash 'avg (live money) [[['slot] (t "/amount")]]]
         ['rounded 'round (live (x 'cash)) [[['slot] (t "/total")] [['places] (t "1")]]]
         ['age 'since (live (x 'last)) [[['slot] (t "/when")] [['from] (t "10")]]]
         ['mid 'between (live deals) [[['slot] (t "/when")] [['from] (t "15")] [['to] (t "35")]]]
         ['amended 'amend (live (x 'revenue)) [[['notes] (live [self 'org 'notes])]]]
         ['rows_amended 'amend (live (x 'closed)) [[['notes] (live [self 'org 'rownotes])]]]
         ['owed 'subtract (live (x 'revenue)) [[['left] (t "50")] [['right] (t "/revenue")]]]
         ['gathered 'gather (live deals) [[['extra] (live [self 'org 'extra])]]]
         ['rootdiff 'diff (live deals) [[['other] (live [self 'org 'extra])]]]
         ['flagged 'when (live deals) [[['key] (t "/status")] [['value] (t "closed")] [['then] (t "yes")] [['else] (t "no")] [['into] (t "/flag")]]]
         ['defaulted 'coalesce (live deals) [[['slot] (t "/note")] [['value] (t "none")]]]
         ['weekdays 'part (live [self 'org 'days]) [[['slot] (t "/day")] [['unit] (t "weekday")]]]
         ['quarters 'part (live [self 'org 'days]) [[['slot] (t "/day")] [['unit] (t "quarter")]]]
         ['shifted 'shift (live [self 'org 'days]) [[['slot] (t "/day")] [['by] (t "-7")]]]
         ['monthed 'shift (live [self 'org 'days]) [[['slot] (t "/day")] [['by] (t "2")] [['unit] (t "month")] [['into] (t "/later")]]]
         ['totals 'running (live deals) [[['slot] (t "/amount")]]]
         ['ranks 'rank (live deals) []]
         ['changes 'change (live deals) [[['slot] (t "/amount")]]]
         ['moved 'moving (live deals) [[['slot] (t "/amount")] [['window] (t "2")]]]
         ['shares 'percent (live deals) [[['slot] (t "/amount")]]]
         ['trimmed 'trim (live [self 'org 'txt]) [[['slot] (t "/s")]]]
         ['upper 'case (live [self 'org 'txt]) [[['slot] (t "/s")] [['to] (t "upper")]]]
         ['replaced 'replace (live [self 'org 'txt]) [[['slot] (t "/u")] [['find] (t "ab")] [['with] (t "x")]]]
         ['lengths 'length (live [self 'org 'txt]) [[['slot] (t "/u")]]]
         ['starting 'starts (live [self 'org 'txt]) [[['slot] (t "/u")] [['value] (t "ab")]]]
         ['ending 'ends (live [self 'org 'txt]) [[['slot] (t "/u")] [['value] (t "cd")]]]
         ['refd 'reference (live [self 'org 'items]) [[['key] (t "/sku")] [['table] (live prices)] [['into] (t "/price_ref")]]]
         ['followed 'follow (live (x 'refd)) [[['slot] (t "/price_ref")] [['prices] (live prices)]]]
         ['middle 'median (live deals) [[['slot] (t "/amount")]]]
         ['topmost 'percentile (live deals) [[['slot] (t "/amount")] [['at] (t "100")]]]
         ['spread 'variance (live deals) [[['slot] (t "/amount")]]]
         ['dev 'stddev (live deals) [[['slot] (t "/amount")]]]
         ['common 'mode (live deals) [[['slot] (t "/status")]]]
         ['bytwo 'by (live deals) [[['key] (t "/status /owner")]]]
         ['sort2 'sort (live [self 'org 'ties]) [[['slot] (t "/g /v")]]]
         ['grouped 'group (live deals) [[['key] (t "/status")]]]
         ['renamed 'rename (live deals) [[['from] (t "/amount")] [['to] (t "/value")]]]
         ['dropped 'drop (live deals) [[['slots] (t "/amount /status")]]]
         ['deepened 'unflatten (live [self 'org 'flatkeys]) []]
         ['exploded 'explode (live [self 'org 'txt]) [[['slot] (t "/u")] [['with] (t "-")]]]
         ['invalid 'validate (live deals) [[['key] (t "/amount")] [['op] (t "over")] [['value] (t "40")]]]
         ['dupes 'unique (live deals) [[['key] (t "/owner")]]]]
      with_cells
        | library.fold s12
          \ st [name ctor tack params]
          | cell_at name ctor tack params st
      ' a folder written, a cell over it, then the folder culled
      gone=path [self 'org 'gone]
      with_gone (cell_tests/put gone.snoc('g1) (myth/sing ['n] (pails/n 1)) (cell_tests/put gone (myth/sing ['title] (pails/t "Gone")) with_cells))
      with_over_gone (cell_at 'over_gone 'count (live gone) [] with_gone)
      before_cull
        | initial.set_local with_over_gone
      culled
        | initial.set_local
          (cell_tests/cull gone with_over_gone)
      state | initial.set_local with_cells
      grown
        | initial.set_local
          (cell_tests/put deals.snoc('d4) (cell_tests/deal 10 "closed" 40 "bo") with_cells)
      churn_folder=path [self 'org 'churn]
      churning
        | initial.set_local
          (cell_tests/churn churn_folder 20 (cell_at 'churned 'count (live churn_folder) [] with_cells))
      read
        \ name=iota state=namespace
        ^ res[axal[myth]]
        | sovereign_view .x 0 (x name) state
      read_y
        \ name=iota state=namespace
        ^ res[axal[myth]]
        | sovereign_view .y 0 (x name) state
      read_z
        \ name=iota state=namespace
        ^ res[axal[myth]]
        | sovereign_view .z 0 (x name) state
      context
        \ name=iota state=namespace
        ^ res[axal[myth]]
        | sovereign_view .x 0 (x name).cons('c) state
      yc=care .y
      triggers=row[dep] (xv_trigger (x 'count) state.local)
      chain=row[dep] (xv_trigger (x 'revenue) state.local)
    [(testing/nat "live count reads the input's children" 3
       (cell_tests/nat_at ['count] (read 'count state)))
     (testing/nat "live count follows a new child" 4
       (cell_tests/nat_at ['count] (read 'count grown)))
     (testing/nat "pinned tack stays frozen" 3
       (cell_tests/nat_at ['count] (read 'frozen grown)))
     (testing/nat "a live cell at a pinned case reads unknown" 1
       (cell_tests/probe (sovereign_view .x 1 (x 'count) state)))
     (testing/nat "and says why in its context" 1
       (cell_tests/has ['sys 'view 'fault] (sovereign_view .x 1 (x 'count).cons('c) state)))
     (testing/nat "a cell over a culled folder reads unknown" 1
       (cell_tests/probe (read 'over_gone culled)))
     (testing/nat "and its context says the input was culled" 1
       (cell_tests/has ['sys 'view 'fault] (context 'over_gone culled)))
     (testing/nat "before the cull the same cell counted" 1
       (cell_tests/nat_at ['count] (read 'over_gone before_cull)))
     (testing/nat "subtract below zero is a signed figure: 50 minus 75" 25
       (cell_tests/neg_at ['result] (read 'owed state)))
     (testing/nat "gather nests each secondary input under its slot name" 4
       (cell_tests/kids (read_y 'gathered state)))
     (testing/nat "diff counts the differing roots as one changed row" 1
       (cell_tests/nat_at ['changed] (read 'rootdiff state)))
     (testing/nat "and the rows only one side has" 3
       (cell_tests/nat_at ['added] (read 'rootdiff state)))
     (testing/nat "where keeps the matching children" 2
       (cell_tests/kids (read_y 'closed state)))
     (testing/nat "a cell of a cell: sum over where" 75
       (cell_tests/nat_at ['revenue] (read 'revenue state)))
     (testing/nat "a chain of three follows the input" 85
       (cell_tests/nat_at ['revenue] (read 'revenue grown)))
     (testing/nat "subtract reads a literal and an input slot" 225
       (cell_tests/nat_at ['result] (read 'left state)))
     (testing/nat "a missing parameter passes the input through" 3
       (cell_tests/kids (read_y 'hole state)))
     (testing/nat "and names the parameter in the context" 1
       (cell_tests/has ['sys 'view 'missing] (context 'hole state)))
     (testing/nat "the context carries the cell's own parameters" 1
       (cell_tests/has ['slot] (context 'revenue state)))
     (testing/nat "a cell's tree carries no context" 0
       (? (cell_tests/has ['slot] (read 'revenue state)) 1 0))
     (testing/nat "an input that contains the cell reads unknown" 1
       (cell_tests/probe (read 'loop state)))
     (testing/nat "and its context names the cycle" 1
       (cell_tests/has ['sys 'view 'fault] (context 'loop state)))
     (testing/nat "two cells that feed each other read a cycle fault" 1
       (cell_tests/has ['sys 'view 'fault] (context 'ping state)))
     (testing/nat "an inline stateless spun still works" 3
       (cell_tests/kids (read_y 'inline state)))
     (testing/nat "min" 25 (cell_tests/nat_at ['min] (read 'min state)))
     (testing/nat "max" 70 (cell_tests/nat_at ['max] (read 'max state)))
     (testing/nat "avg rounds half up" 48 (cell_tests/nat_at ['avg] (read 'avg state)))
     (testing/nat "any" 1 (cell_tests/bool_at ['any] (read 'anyok state)))
     (testing/nat "all" 0 (cell_tests/bool_at ['all] (read 'allok state)))
     (testing/nat "where over" 2 (cell_tests/kids (read_y 'big state)))
     (testing/nat "where contains" 2 (cell_tests/kids (read_y 'anns state)))
     (testing/nat "sort ascending puts the smallest first" 1
       (? (equal (cell_tests/child_text ($u 1) ['key] (read_y 'sorted state)) "d3") 1 0))
     (testing/nat "top keeps the largest" 1
       (? (and (eq (cell_tests/kids (read_y 'top2 state)) 2) (equal (cell_tests/child_text ($u 1) ['key] (read_y 'top2 state)) "d2")) 1 0))
     (testing/nat "latest is the greatest date" 1
       (? (equal (cell_tests/text_at ['key] (read 'last state)) "d3") 1 0))
     (testing/nat "earliest is the smallest date" 1
       (? (equal (cell_tests/text_at ['key] (read 'first state)) "d1") 1 0))
     (testing/nat "each derives a slot per child" 100 (cell_tests/child_nat 'd1 ['double] (read_y 'doubled state)))
     (testing/nat "lookup brings a slot from the table" 7 (cell_tests/child_nat 'i2 ['price] (read_y 'priced state)))
     (testing/nat "distinct counts the values" 2 (cell_tests/kids (read_y 'statuses state)))
     (testing/nat "select keeps only the named slots" 1
       (? (and (eq (cell_tests/child_nat 'd1 ['amount] (read_y 'amounts state)) 50) (equal (cell_tests/child_text 'd1 ['status] (read_y 'amounts state)) "")) 1 0))
     (testing/nat "by groups and sums" 75 (cell_tests/child_nat ($ts "closed") ['sum] (read_y 'bystatus state)))
     (testing/nat "grid counts per row and column" 2 (cell_tests/child_nat ($ts "closed") [($ts "ann")] (read_y 'gridded state)))
     (testing/nat "flatten keys children by path" 3 (cell_tests/kids (read_y 'flat state)))
     (testing/nat "merge adds a secondary input's children" 4 (cell_tests/kids (read_y 'merged state)))
     (testing/nat "multiply" 150 (cell_tests/nat_at ['result] (read 'twice state)))
     (testing/nat "divide" 4 (cell_tests/nat_at ['result] (read 'quarter state)))
     (testing/nat "pick copies from a secondary input" 300 (cell_tests/nat_at ['budget] (read 'picked state)))
     (testing/nat "put sets a literal" 1 (? (equal (cell_tests/text_at ['note] (read 'noted state)) "hello") 1 0))
     (testing/nat "decimals: sum aligns scales" 2000 (cell_tests/nat_at ['total] (read 'cash state)))
     (testing/nat "decimals: the output carries its scale" 2 (cell_tests/nat_at ['scale] (read 'cash state)))
     (testing/nat "decimals: avg at the input's scale" 1000 (cell_tests/nat_at ['avg] (read 'meancash state)))
     (testing/nat "round to one place" 200 (cell_tests/nat_at ['total] (read 'rounded state)))
     (testing/nat "since" 20 (cell_tests/nat_at ['since] (read 'age state)))
     (testing/nat "between" 2 (cell_tests/kids (read_y 'mid state)))
     (testing/nat "amend lays a note over the answer" 80 (cell_tests/nat_at ['revenue] (read 'amended state)))
     (testing/nat "a note at the input's case applies quietly" 0
       (? (cell_tests/has ['sys 'view 'note 'n1] (context 'amended state)) 1 0))
     (testing/nat "a note behind the input's case is reported" 1
       (cell_tests/has ['sys 'view 'note 'n2] (context 'amended state)))
     (testing/nat "a note's slot can be a path into the answer: one row corrected" 60
       (cell_tests/child_nat 'd1 ['amount] (read_y 'rows_amended state)))
     (testing/nat "a path with no record in the answer is reported, not created" 1
       (? (and (cell_tests/has ['sys 'view 'note 'r2] (context 'rows_amended state)) (eq (cell_tests/kids (read_y 'rows_amended state)) 2)) 1 0))
     (testing/nat "a secondary input is read at its case" 225
       (cell_tests/nat_at ['result] (read 'remaining state)))
     (testing/nat "a live cell depends on its input" 1
       triggers.any((\ d=dep (and (equal d.c yc) (eq_pith d.p deals)))))
     (testing/nat "a cell of a cell depends on the data" 1
       chain.any((\ d=dep (eq_pith d.p deals))))
     (testing/nat "a cell reads after twenty events sealed the root's history and clocks" 20
       (cell_tests/nat_at ['count] (read 'churned churning)))
     (testing/nat "when: then on a match" 1 (? (equal (cell_tests/child_text 'd1 ['flag] (read_y 'flagged state)) "yes") 1 0))
     (testing/nat "when: else otherwise" 1 (? (equal (cell_tests/child_text 'd2 ['flag] (read_y 'flagged state)) "no") 1 0))
     (testing/nat "coalesce fills a missing slot" 1 (? (equal (cell_tests/child_text 'd2 ['note] (read_y 'defaulted state)) "none") 1 0))
     (testing/nat "part: weekday of a day number (2026-04-07 is a Tuesday)" 2 (cell_tests/child_nat 'x1 ['weekday] (read_y 'weekdays state)))
     (testing/nat "part: weekday of a text date (2025-12-31 is a Wednesday)" 3 (cell_tests/child_nat 'x2 ['weekday] (read_y 'weekdays state)))
     (testing/nat "part: quarter" 4 (cell_tests/child_nat 'x2 ['quarter] (read_y 'quarters state)))
     (testing/nat "shift: a week back crosses a month" 20260331 (cell_tests/child_nat 'x1 ['day] (read_y 'shifted state)))
     (testing/nat "shift: two months on, the day clamped" 20260228 (cell_tests/child_nat 'x2 ['later] (read_y 'monthed state)))
     (testing/nat "running total in row order" 120 (cell_tests/child_nat 'd2 ['running] (read_y 'totals state)))
     (testing/nat "rank is the position" 3 (cell_tests/child_nat 'd3 ['rank] (read_y 'ranks state)))
     (testing/nat "change from the previous row" 20 (cell_tests/child_nat 'd2 ['change] (read_y 'changes state)))
     (testing/nat "change below zero is signed" 1 (? (equal (cell_tests/child_text 'd3 ['change] (read_y 'changes state)) "") 1 0))
     (testing/nat "moving mean over the last two, half up" 48 (cell_tests/child_nat 'd3 ['moving] (read_y 'moved state)))
     (testing/nat "percent in hundredths: 50 of 145" 3448 (cell_tests/child_nat 'd1 ['percent] (read_y 'shares state)))
     (testing/nat "trim" 1 (? (equal (cell_tests/child_text 't1 ['s] (read_y 'trimmed state)) "Ann") 1 0))
     (testing/nat "case upper" 1 (? (equal (cell_tests/child_text 't1 ['s] (read_y 'upper state)) "  ANN  ") 1 0))
     (testing/nat "replace every occurrence" 1 (? (equal (cell_tests/child_text 't1 ['u] (read_y 'replaced state)) "x-cd-x") 1 0))
     (testing/nat "length in bytes" 8 (cell_tests/child_nat 't1 ['length] (read_y 'lengths state)))
     (testing/nat "starts" 1 (cell_tests/child_bool 't1 ['starts] (read_y 'starting state)))
     (testing/nat "ends" 0 (cell_tests/child_bool 't1 ['ends] (read_y 'ending state)))
     (testing/nat "reference points at the table row" 1
       (? (equal (cell_tests/ref_at 'i2 ['price_ref] (read_y 'refd state)) (path_show prices.snoc('p2))) 1 0))
     (testing/nat "follow brings the pointed record's slots under the slot" 7 (cell_tests/child_nat 'i2 ['price_ref 'price] (read_y 'followed state)))
     (testing/nat "median" 50 (cell_tests/nat_at ['median] (read 'middle state)))
     (testing/nat "percentile 100 is the largest" 70 (cell_tests/nat_at ['percentile] (read 'topmost state)))
     (testing/nat "variance of 25, 50, 70" 339 (cell_tests/nat_at ['variance] (read 'spread state)))
     (testing/nat "stddev of 25, 50, 70" 18 (cell_tests/nat_at ['stddev] (read 'dev state)))
     (testing/nat "mode" 1 (? (equal (cell_tests/text_at ['mode] (read 'common state)) "closed") 1 0))
     (testing/nat "distinct counts its values on the root" 2 (cell_tests/nat_at ['count] (read 'statuses state)))
     (testing/nat "by two keys" 2 (cell_tests/child_nat 'closed_ann ['count] (read_y 'bytwo state)))
     (testing/nat "sort by two slots breaks ties by the second" 1 (? (equal (cell_tests/child_text '2 ['key] (read_y 'sort2 state)) "b") 1 0))
     (testing/nat "group keeps the rows under their value" 1 (cell_tests/present ['closed 'd1] (read_z 'grouped state)))
     (testing/nat "rename" 50 (cell_tests/child_nat 'd1 ['value] (read_y 'renamed state)))
     (testing/nat "drop" 1 (? (and (eq (cell_tests/child_nat 'd1 ['amount] (read_y 'dropped state)) 0) (equal (cell_tests/child_text 'd1 ['owner] (read_y 'dropped state)) "ann")) 1 0))
     (testing/nat "unflatten" 1 (cell_tests/present ['a 'x] (read_z 'deepened state)))
     (testing/nat "explode: one row per piece, under the row's name" 1 (cell_tests/present ['t1 ($u 3)] (read_z 'exploded state)))
     (testing/nat "explode: the piece at the slot" 1 (? (equal (cell_tests/text_in ['t1 ($u 2)] ['u] (read_z 'exploded state)) "cd") 1 0))
     (testing/nat "validate keeps the failing rows with a reason" 1 (cell_tests/kids (read_y 'invalid state)))
     (testing/nat "validate's reason is the rule in words" 1 (? (equal (cell_tests/child_text 'd3 ['reason] (read_y 'invalid state)) "/amount is not over 40") 1 0))
     (testing/nat "unique keeps the repeated rows with their count" 2 (cell_tests/child_nat 'd1 ['count] (read_y 'dupes state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "cells" cell_tests/checks)]
