- eden
- tests/namespace [at=fixture]
- testing

+ namespace_boot_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = fixture fixture/namespace_tests/initial
      system fixture.system
      ready | eden/boot ($x 17) system sov/new 18131
      initial | namespace ($x 17) sov/new system
      state
        ? ready
         > (./ok state) state
         > (./err why) initial
      root=path [($x 17)]
      greeting=str
        ?> (./known records) state.page(.x .none root.snoc('hello))
          ""
        ?> (./some record) records.fil ""
        | (unpin record.myth).txt_at ['message]
      listener
        ?> (./known records)
          state.page(.x .none [($x 17) 'io 'http])
          myth/new
        ?> (./some record) records.fil myth/new
        | unpin record.myth
      invalid | eden/boot 'sys system sov/new 18131
      foreign | eden/boot ($x 0) system sov/new 18131
      [same index page]
        | helm/supervisor/handle
          (helm/card/peek .x (./some 1) ['sys 'types 'text])
          state (sovereign_hive state)
      value
        ?> (./page target answer) page 0
        | fixture/namespace_tests/value answer
    [(testing/nat "boot succeeds with explicit authority" 1
       ?=((./ok _) ready))
     (testing/text "Eden mounts under its node" "Hello from Eden."
       greeting)
     (testing/nat "HTTP service has configured port" 18131
       listener.nat_at(['port] 0))
     (testing/nat "HTTP service keeps full authority" 1
       (equal[maybe[path]] (./some [($x 17) 'kook 'hserve])
         listener.path_at(['serve])))
     (testing/nat "system publication stays fixed" 1
       (equal[pin[system_publication]] system state.system))
     (testing/nat "both roots browse" 2 state.root(.z).kid_tap.len)
     (testing/nat "supervisor reads independent system history" 11 value)
     (testing/nat "boot journal pins system publication" 1
       (equal[maybe[pin[system_publication]]] (./some system)
         (fixture/namespace_tests/journal_system state)))
     (testing/nat "system is not a node identity" 1
       ?=((./err _) invalid))
     (testing/nat "zero is not a node identity" 1
       ?=((./err _) foreign))]

+ tests
  ^ row[testing/case]
  [(testing/case "namespace Eden boot" namespace_boot_tests/checks)
   (testing/case "namespace installation" namespace_boot_tests/install)
   (testing/case "namespace actor" namespace_boot_tests/actor)]

+ namespace_boot_tests
  + install
    \ ignored=unit
    ^ row[testing/check]
    = fixture fixture/namespace_tests/initial
      initial=namespace
        ? (eden/boot ($x 17) fixture.system sov/new 18131)
         > (./ok state) state
         > (./err _) (namespace ($x 17) sov/new fixture.system)
      source=path [($x 17) 'definitions 'example]
      reference=path [($x 17) 'definitions 'shared]
      card
        | (myth/sing ['sys 'content] (fixture/namespace_tests/item 42)).put
          [($x 17) 'slots 'reference] (pails/p reference)
      card
        | card.put [($x 17) 'slots 'local]
          (grove_instance_ref .x [])
      template | grove_template grove_templates/version [[[] card]]
      record | myth/sing grove_templates/slot template
      [published index ack]
        | helm/supervisor/handle
          (helm/card/step source (writ/make record))
          initial (sovereign_hive initial)
      [revised index ack]
        | helm/supervisor/handle
          (helm/card/step source
            (writ/poke (myth/sing ['sys 'lede] (pails/t "revision"))))
          published index
      one=path [($x 17) 'app 'one]
      two=path [($x 17) 'app 'two]
      first | grove_install/instantiate source 1 one revised
      next
        ? first
         > (./ok state) state
         > (./err _) revised
      second | grove_install/instantiate source 1 two next
      last
        ? second
         > (./ok state) state
         > (./err _) next
      one_value
        | fixture/namespace_tests/value last.page(.x .none one)
      two_value
        | fixture/namespace_tests/value last.page(.x .none two)
      one_record | sovereign_peek one last
      two_record | sovereign_peek two last
      one_card | one_record.fil.fall myth/new
      two_card | two_record.fil.fall myth/new
      literal_slot=path [($x 17) 'slots 'reference]
      instance_slot=path [($x 17) 'slots 'local]
      foreign_target=path [($x 18) 'app]
      system_target=path ['sys 'app]
      foreign
        | grove_install/instantiate
          source 1 foreign_target last
      system
        | grove_install/instantiate source 1 system_target last
    [(testing/nat "historical template installs first instance" 1
       ?=((./ok _) first))
     (testing/nat "same definition installs second instance" 1
       ?=((./ok _) second))
     (testing/nat "first instance shares value brand" 42 one_value)
     (testing/nat "second instance shares value brand" 42 two_value)
     (testing/nat "publisher references remain identical" 1
       (equal[maybe[pail]] one_card.get(literal_slot)
         two_card.get(literal_slot)))
     (testing/nat "first instance reference is explicit and local" 1
       (equal[maybe[pail]] (./some (safe 1 .x one))
         one_card.get(instance_slot)))
     (testing/nat "second instance reference is explicit and local" 1
       (equal[maybe[pail]] (./some (safe 1 .x two))
         two_card.get(instance_slot)))
     (testing/nat "installation preserves system publication" 1
       (equal[pin[system_publication]] fixture.system last.system))
     (testing/nat "installation rejects foreign target" 1
       ?=((./err _) foreign))
     (testing/nat "installation rejects system target" 1
       ?=((./err _) system))]

+ namespace_boot_tests
  + actor
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      ;server (Spawn (helm/supervisor/run initial))
      target=path [initial.self 'app 'actor]
    ; (SendCaps server
        (helm/card/step target
          (writ/make (fixture/namespace_tests/record 57))) [0])
    = ;[ack caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/peek .x .none target) [0])
    = ;[page caps] (Recv[feet/task[unit]] 0)
      value
        ?> (./page path answer) page 0
        | fixture/namespace_tests/value answer
    ; (SendCaps server
        (helm/card/step ['sys 'types 'text]
          (writ/poke (fixture/namespace_tests/record 99))) [0])
    = ;[denied caps] (Recv[feet/task[unit]] 0)
      rejected
        ?> (./ack error) denied .false
        | maybe/is_some error
    ; (SendCaps server
        (helm/card/peek .x (./some 1) ['sys 'types 'text]) [0])
    = ;[page caps] (Recv[feet/task[unit]] 0)
      system_value
        ?> (./page path answer) page 0
        | fixture/namespace_tests/value answer
    ; (CloseHandle server)
    [(testing/nat "namespace actor commits local write" 57 value)
     (testing/nat "namespace actor rejects system write" 1 rejected)
     (testing/nat "namespace actor preserves system history" 11
       system_value)]
