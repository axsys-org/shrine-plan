- pact
- tests/namespace [at=fixture]
- testing

+ namespace_fresh_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      root=path [initial.self]
      registry=path [initial.self 'kook 'fresh]
      target=path [initial.self 'app 'demo]
      watcher=path [initial.self 'app 'watcher]
      seeds
        | (axal/new[note] .none).put(root (note/make myth/new)).put
          registry (note/make (myth/sing bond/form fresh/form))
      state
        ? (namespace/step seeds 0 0 initial)
         > (./accepted result) result.state
        initial
      card
        | (myth/sing limb_slot (kook [registry])).put
          bond/tack (safe 1 .x target)
      [created index]
        | sovereign_cycle_with (sovereign_hive state)
          (task/vine watcher (writ/make card)) 0 8 0 0 state
      quiet
        ? created
         > (./spun next effects rounds ack spill)
          ? (maybe/is_some spill) .false
          | eq next.local.top state.local.top.inc
        .false
      next
        ? created
         > (./spun next effects rounds ack spill) next
        state
      [changed refreshed_index]
        | sovereign_cycle_with index
          (task/vine target (writ/poke (fixture/namespace_tests/record 33)))
          0 8 0 0 next
      refreshed
        ? changed
         > (./spun after effects rounds ack spill)
          ? (maybe/is_some spill) .false
          ?> (./some record) (sovereign_peek watcher after).fil .false
          ?> (./some held) record.get(bond/tack) .false
          ?> link=safe held .false
          | eq link.ver 2
        .false
    [(testing/nat "version-only notification settles without journaling" 1 quiet)
     (testing/nat "target change refreshes the exact case and settles" 1 refreshed)]

+ tests
  ^ row[testing/case]
  [(testing/case "namespace live links" namespace_fresh_tests/checks)]
