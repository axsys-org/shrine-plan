- vanes
- stdlib/runtime
- stdlib/runtime
- stdlib/base

+ copy_checks
  \ ignored=unit
  ^ row[testing/check]
  = supplied (root/named "Authored title" "Authored description")
    preserved (root/ensure_title ['some_name] supplied)
    fallback (root/ensure_title ['hello_world] myth/new)
  [(testing/text "identifier fallback" "Hello world" (root/path_title ['hello_world]))
   (testing/text "root fallback" "Namespace" (root/path_title []))
   (testing/text "authored title preserved" "Authored title" (myth/txt_at bond/lede preserved))
   (testing/text "authored description preserved" "Authored description" (myth/txt_at bond/help preserved))
   (testing/text "missing title supplied" "Hello world" (myth/txt_at bond/lede fallback))
   (testing/text "empty title filled" "Some name" ((root/ensure_title ['some_name] (root/named "" "Help")).txt_at(bond/lede)))
   (testing/text "fallback keeps description" "Help" ((root/ensure_title ['some_name] (root/named "" "Help")).txt_at(bond/help)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Bootstrap record copy" copy_checks)]
