- helm
- testing

' What a machine's own world may execute, as the kernel sees it in an
' ordinary process: one that was not started with a worlds root. Entropy and
' Usage answer. Host gives no handle, and every World operation refuses
' whatever stands in for one. Folder makes folders inside the file root only.
+ host_ops_tests
  + checks
    \ _=unit
    ^ row[testing/check]
    = ;a (Entropy 32)
      ;b (Entropy 32)
      ;u (Usage 0)
      ;h (Host 0)
    [(testing/nat "entropy is the bytes asked for" 33 (wid a))
     (testing/nat "and is not the same twice" 0 (eq a b))
     (testing/nat "none for nothing asked" 0 (Entropy 0))
     (testing/nat "and none for more than 64" 0 (Entropy 65))
     (testing/nat "usage is four numbers of eight bytes" 33 (wid u))
     (testing/nat "a process with no worlds root is given no handle" 0 h)
     (testing/nat "a number is not a handle: nothing is made" 0 (WorldMake 7 "abc"))
     (testing/nat "nothing is started" 0 (WorldStart 7 "abc" 1))
     (testing/nat "nothing is stopped" 0 (WorldStop 7 "abc"))
     (testing/nat "and nothing is reported alive" 0 (WorldAlive 7 "abc"))
     (testing/nat "a folder that is there is there" 1 (Folder "foil/tests"))
     (testing/nat "a folder is not made above the file root" 0 (Folder "../host_ops_probe"))
     (testing/nat "nor by a path that climbs on its way" 0 (Folder "foil/../host_ops_probe"))
     (testing/nat "nor at a path from the top of the machine" 0 (Folder "/tmp/host_ops_probe"))
     (testing/nat "nor with no name" 0 (Folder ""))]

+ tests
  ^ row[testing/case]
  [(testing/case "what a machine's own world may execute" host_ops_tests/checks)]
