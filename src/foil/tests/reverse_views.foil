- tests/namespace [at=fixture]
- tests/composition [at=fixture]
- helm
- testing

+ reverse_tests
  + put
    \ target=path change=writ state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/handle (helm/card/step target change) state (sovereign_hive state))
    ?> (./ack failure) reply (Seq[namespace] (error (pails/t "reverse fixture expected acknowledgement")) state)
    ? (maybe/is_some failure) (Seq[namespace] (error (pails/t "reverse fixture admission failed")) state)
    next
  + count
    \ address=path state=namespace
    ^ nat
    | reverse_tests/result_count (sovereign_view .x 0 address state)
  + result_count
    \ answer=res[axal[myth]]
    ^ nat
    ?> (./known tree) answer 999
    | tree.fil.fall(myth/new).nat_at ['count] 999
  + number
    \ address=path slot=path state=namespace
    ^ nat
    | (sovereign_peek address state).fil.fall(myth/new).nat_at slot 999
  + echo
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    | [context input]
  + refresh
    \ b=bowl record=myth changes=row[dep]
    ^ yell
    = incoming b.crew.gut(['incoming] (axal/new[myth] .none))
    | yell [] record.put(['count] (pails/n incoming.fil.fall(myth/new).nat_at(['count] 999))).put(['notifications] (pails/n record.nat_at(['notifications] 0).inc))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = a=path [($x 1) 'subjects 'a]
      b=path [($x 1) 'subjects 'b]
      holder=path [($x 1) 'sources 'report]
      root=path [($x 1) 'incoming_cell]
      output root.cons('x)
      waiter=path [($x 1) 'incoming_waiter]
      nested=path [($x 1) 'nested_waiter]
      parent_waiter=path [($x 1) 'parent_waiter]
      overlay_waiter=path [($x 1) 'overlay_waiter]
      overlay_definition=path [($x 1) 'definitions 'incoming]
      behavior=path [($x 1) 'kook 'reverse_waiter]
      lens (r_spell a)
      empty fixture/namespace_tests/initial
      base (reverse_tests/put behavior (writ/make (myth/sing system_vocabulary/form def_form.set_hear(reverse_tests/refresh))) empty)
      base (reverse_tests/put root (writ/make ((myth/sing bond/weft (cell reverse_tests/echo)).put(bond/tack (safe 0 .z lens)))) base)
      waiting (kooked [behavior]).put(crew_slot (cpail (crew/sing ['incoming] (dep .x lens))))
      base (reverse_tests/put waiter (writ/make waiting) base)
      nested_waiting waiting.put(crew_slot (cpail (crew/sing ['incoming] (dep .x output))))
      base (reverse_tests/put nested (writ/make nested_waiting) base)
      parent_config waiting.put(crew_slot (cpail (crew/sing ['incoming] (dep .x (r_spell a.take(2))))))
      base (reverse_tests/put parent_waiter (writ/make parent_config) base)
      base (reverse_tests/put overlay_definition (writ/make (myth/sing bond/weft (spun (\ context=myth input=axal[myth] input) .none))) base)
      application (fixture/composition_tests/overlay overlay_definition lens)
      overlay_config waiting.put(crew_slot (cpail (crew/sing ['incoming] (dep .x application))))
      base (reverse_tests/put overlay_waiter (writ/make overlay_config) base)
      original (myth/sing ['cites 'primary] (safe 3 .z a))
      linked (reverse_tests/put holder (writ/make original) base)
      changed (reverse_tests/put holder (writ/poke (myth/sing ['text] (pails/t "New source prose"))) linked)
      rebound (reverse_tests/put holder (writ/make (myth/sing ['cites 'primary] (safe 0 .x b))) changed)
      gone (reverse_tests/put holder .cull rebound)
      restored (reverse_tests/put holder (writ/make original) gone)
      pinned (fixture/composition_tests/pinned linked.local.top lens)
      entry=path [($u 2) 'cites 'primary]
      entry entry.weld(holder)
      item (sovereign_peek lens.weld(entry) linked).fil.fall(myth/new)
      unknown_reader (sovereign_reader linked).set_references((\ target=path .unknown))
      bulk=namespace
        ?> (./accepted accepted) (namespace/step ((axal/new[note] .none).put(holder (note/make original))) 0 0 base) (Seq[namespace] (error (pails/t "reverse fixture bulk commit failed")) base)
        accepted.state
      caughtup=namespace
        ?> (./ok value) (sovereign_reconcile base bulk 0 0) (Seq[namespace] (error (pails/t "reverse fixture reconcile failed")) bulk)
        value
      frozen_reader
        = freeze (sovereign_reader gone).freeze
        | (freeze linked.local.top).fall((sovereign_reader gone))
    [(testing/nat "known empty incoming set exists before a subject or its first edge" 0 (reverse_tests/count lens base))
     (testing/nat "ordinary cell consumes the reverse lens" 1 (reverse_tests/count output linked))
     (testing/nat "direct native hand wakes on first incoming edge" 1 (reverse_tests/number waiter ['count] linked))
     (testing/nat "cell-dependent native hand wakes on incoming membership" 1 (reverse_tests/number nested ['count] linked))
     (testing/nat "incoming membership changes notify target-prefix consumers" 1 (reverse_tests/number parent_waiter ['count] linked))
     (testing/nat "ordinary /o composition retains reverse membership dependencies" 1 (reverse_tests/number overlay_waiter ['count] linked))
     (testing/nat "literal content edits do not change membership or retrigger its hand" 1
       (equal (sovereign_peek waiter linked) (sovereign_peek waiter changed)))
     (testing/nat "retarget releases old incoming membership" 0 (reverse_tests/count lens rebound))
     (testing/nat "retarget adds new incoming membership" 1 (reverse_tests/count (r_spell b) rebound))
     (testing/nat "retarget notifies the old subject's hand" 0 (reverse_tests/number waiter ['count] rebound))
     (testing/nat "deleting the last holder leaves a known empty result" 0 (reverse_tests/count (r_spell b) gone))
     (testing/nat "restoration notifies the original subject's hand" 1 (reverse_tests/number waiter ['count] restored))
     (testing/nat "epoch-pinned lens retains the old incoming set after rebind and cull" 1 (reverse_tests/count pinned gone))
     (testing/nat "frozen reader current cannot borrow the latest incoming set" 1
       (reverse_tests/result_count (resolve_view .x 0 lens frozen_reader)))
     (testing/nat "a local case cannot stand in for an incoming-set epoch" 1 (?=(.unknown (sovereign_view .x 1 lens linked))))
     (testing/nat "unavailable index metadata propagates through the native view" 1 (?=(.unknown (resolve_view .z 0 lens unknown_reader))))
     (testing/nat "reverse edges retain exact holder names" 1 (equal item.pail_at(['holder]) (pails/p holder)))
     (testing/nat "reverse edges retain exact multi-segment slots" 1 (equal item.pail_at(['slot]) (pails/p ['cites 'primary])))
     (testing/nat "reverse edges retain the asserted care and version" 1 (equal item.pail_at(['target]) (safe 3 .z a)))
     (testing/nat "a reverse read does not mint an assertion" 0 (maybe/is_some restored.local.idx.get(lens)))
     (testing/nat "reverse signals do not mint x clocks" 0 (maybe/is_some restored.local.x_case(lens)))
     (testing/nat "reverse signals do not mint y clocks" 0 (maybe/is_some restored.local.y_case(lens)))
     (testing/nat "reverse signals do not mint z clocks" 0 (maybe/is_some restored.local.z_case(lens)))
     (testing/nat "bulk publication reconciliation notifies index-only dependencies" 1 (reverse_tests/number waiter ['count] caughtup))
     (testing/nat "source x history survives retarget and deletion" 1 (?=((./known _) (gone.local.x_at(linked.local.top holder)))))
     (testing/nat "future epoch-pinned incoming results stay unavailable" 1
       (?=(.unknown (sovereign_view .z 0 (fixture/composition_tests/pinned gone.local.top.inc lens) gone))))]

+ tests
  ^ row[testing/case]
  [(testing/case "native incoming-reference lens" reverse_tests/checks)]
