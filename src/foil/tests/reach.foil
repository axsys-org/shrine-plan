- helm
- net
- reach
- pact
- grove_install
- testing
- tests/namespace [at=fixture]
- tests/grove_install [at=installer]

' Four worlds in one process. 0x17 is the one asking. 0x18 is a university,
' 0x19 a registrar, 0x20 a peer who has been through it. Nobody registers a
' capability. The university publishes two shapes, an offer that gives one of
' them, and an enrollment it made for 0x17. The registrar publishes a shape
' and an offer that takes the university's two shapes and gives its own: it
' names them and wires nothing. The peer tells 0x17 it has had a review.
' What 0x17 can ask for is then read off what has landed in it.
+ reach_tests
  + me
    ^ namespace
    | installer/grove_install_checks/bootstrap []
  + world
    \ name=iota
    ^ namespace
    | namespace name sov/new (fixture/namespace_tests/initial).system
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + land
    ' Bring one published root of a world up to what that world holds.
    \ publisher=namespace root=path from=nat reader=namespace
    ^ namespace
    = mount=path (reference_index/mounted reader.self root).fall(root)
      base=path [reader.self 'io 'mesa]
      card=path base.weld(root)
      head publisher.case(.z root).fall(0)
      seed (reach_tests/seed (quip_val root.at(0)))
      met=row[[p=path q=writ]] [[card (writ/make (myth/sing ['key] (pails/n (Ed25519PublicKey seed))))]]
      ready (? (net/live card reader) reader (reach_tests/apply met reader))
    ?> (./some change) (net/delta 0 root from head publisher) ready
    ? (net/land mount card (net/seal seed root change) ready)
     > (./err why) ready
     > (./ok writes) (reach_tests/apply writes ready)
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + shape
    ' A template with one record.
    \ v=nat
    ^ myth
    = here=path []
      seeds=row[[path myth]] [[here (reach_tests/rec v)]]
    | myth/sing grove_templates/slot (grove_template grove_templates/version seeds)
  + instance
    ' A record its maker stamps as an instance of a template.
    \ v=nat template=path
    ^ myth
    | (reach_tests/rec v).put(grove_templates/source_slot (safe 1 .x template))
  + status
    ' How one template stands on the way to what is wanted.
    \ name=path steps=row[reach/need]
    ^ str
    = none=iota 'absent
      found
        | steps.fold none
          \ acc=iota item=reach/need
          ^ iota
          ? (equal[path] item.want name) item.status
          acc
    | str/from_atom (iota_show found)
  + place
    \ name=path steps=row[reach/need]
    ^ nat
    % i=nat 0
    ^ nat
    ? (ge i steps.len) 99
    ? (equal[path] steps.at(i).want name) i
    | _ i.inc
  + via
    ' The world whose offer gives a template, on the way.
    \ name=path steps=row[reach/need]
    ^ nat
    | steps.fold 0
      \ acc=nat item=reach/need
      ^ nat
      ? !(equal[path] item.want name) acc
      ?> (./some offer) item.by acc
      | quip_val offer.by
  + checks
    \ _=unit
    ^ row[testing/check]
    = mine=iota ($x 17)
      uni=iota ($x 18)
      reg=iota ($x 19)
      pal=iota ($x 20)
      uni_public=path [uni 'our 'public]
      uni_mine=path [uni 'our mine]
      reg_public=path [reg 'our 'public]
      pal_mine=path [pal 'our mine]
      enrolled=path [uni 'our 'public 'enrolled]
      transcript=path [uni 'our 'public 'transcript]
      transcripts=path [uni 'our 'public 'transcripts]
      review=path [reg 'our 'public 'review]
      reviews=path [reg 'our 'public 'reviews]
      enrollment=path [uni 'our mine 'enrollment]
      answer=path [uni 'our mine 'answer]
      note=path [pal 'our mine 'note]
      asking=path [mine 'our uni 'asking]
      gives_transcript=myth (reach_tests/shape 3).put(reach/gives (safe 1 .x transcript))
      wanted=myth
        . (reach_tests/shape 4)
          put(reach/gives (safe 1 .x review))
          put(['takes 'enrollment] (safe 1 .x enrolled))
          put(['takes 'transcript] (safe 1 .x transcript))
      said=myth (reach_tests/rec 9).put(['had] (safe 1 .x review))
      uni_writes=row[[p=path q=writ]] [[uni_public (writ/make (reach_tests/rec 1))]
        [enrolled (writ/make (reach_tests/shape 1))]
        [transcript (writ/make (reach_tests/shape 2))]
        [transcripts (writ/make gives_transcript)]
        [uni_mine (writ/make (reach_tests/rec 1))]
        [enrollment (writ/make (reach_tests/instance 2026 enrolled))]]
      reg_writes=row[[p=path q=writ]] [[reg_public (writ/make (reach_tests/rec 1))]
        [review (writ/make (reach_tests/shape 5))]
        [reviews (writ/make wanted)]]
      pal_writes=row[[p=path q=writ]] [[pal_mine (writ/make (reach_tests/rec 1))]
        [note (writ/make said)]]
      answered=row[[p=path q=writ]] [[answer (writ/make (reach_tests/instance 38 transcript))]]
      u1 (reach_tests/apply uni_writes (reach_tests/world uni))
      r1 (reach_tests/apply reg_writes (reach_tests/world reg))
      p1 (reach_tests/apply pal_writes (reach_tests/world pal))
      m0 reach_tests/me
      before (reach/way review m0)
      m1 (reach_tests/land u1 uni_public 0 m0)
      m2 (reach_tests/land u1 uni_mine 0 m1)
      partly (reach/way review m2)
      m3 (reach_tests/land r1 reg_public 0 m2)
      m4 (reach_tests/land p1 pal_mine 0 m3)
      first (reach/way review m4)
      asked (grove_install/instantiate transcripts 1 asking m4)
      m5
        ? asked
         > (./ok next) next
         > (./err why) m4
      u2 (reach_tests/apply answered u1)
      m6 (reach_tests/land u2 uni_mine u1.case(.z uni_mine).fall(0) m5)
      second (reach/way review m6)
    [(testing/nat "with nothing landed, nothing is declared" 0 (reach/offers m0).len)
     (testing/text "and the review is unknown" "unknown" (reach_tests/status review before))
     (testing/nat "the university's templates are declared once they land" 3 (reach/offers m2).len)
     (testing/text "but nothing yet says how a review is given" "unknown" (reach_tests/status review partly))
     (testing/nat "the registrar's land too" 5 (reach/offers m4).len)
     (testing/text "now a review can be asked for" "ask" (reach_tests/status review first))
     (testing/nat "of the registrar" (quip_val reg) (reach_tests/via review first))
     (testing/text "it takes an enrollment, which I already hold" "held" (reach_tests/status enrolled first))
     (testing/text "and a transcript, which I do not" "ask" (reach_tests/status transcript first))
     (testing/nat "which the university gives" (quip_val uni) (reach_tests/via transcript first))
     (testing/nat "inputs come before what takes them" 1 (lt (reach_tests/place transcript first) (reach_tests/place review first)))
     (testing/nat "three things in all" 3 first.len)
     (testing/nat "one peer I know has cited the review" 1 (reach/witnesses review m4).len)
     (testing/nat "nobody had cited the university's offer" 0 (reach/cited transcripts m4).len)
     (testing/nat "asking the university is instantiating its offer toward it" 1 (?=((./ok _) asked)))
     (testing/nat "and my ask then cites that offer" 1 (reach/cited transcripts m5).len)
     (testing/text "once the answer lands, the transcript is held" "held" (reach_tests/status transcript second))
     (testing/text "and the review is still to be asked for" "ask" (reach_tests/status review second))]

+ tests
  ^ row[testing/case]
  [(testing/case "what can be asked for is read off what has landed" reach_tests/checks)]
