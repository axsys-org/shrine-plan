- namespace
- stdlib/base
- tests/namespace [at=fixture]
- tests/cells [at=fixture]

+ namespace_polish
  + pages
    \ ignored=unit
    ^ row[testing/check]
    = initial     fixture/namespace_tests/initial
      target=path [($x 1) 'app 'demo]
    = local (fixture/cell_tests/cull target initial.local)
      gone  initial.set_local(local)
    | row/cons[testing/check]
      | testing/nat "x preserves a tombstone at the root" 1
        ?=(.null gone.page(.x .none target))
    | row/cons[testing/check]
      | testing/nat "y treats a tombstoned root as unknown" 1
        ?=(.unknown gone.page(.y .none target))
    | row/cons[testing/check]
      | testing/nat "z treats a tombstoned root as unknown" 1
        ?=(.unknown gone.page(.z .none target))
    | row/cons[testing/check]
      | testing/nat "historical x survives the cull" 1
        ?=((./known _) gone.page(.x (./some 1) target))
    | row/cons[testing/check]
      | testing/nat "historical y survives the cull" 1
        ?=((./known _) gone.page(.y (./some 1) target))
    | row/cons[testing/check]
      | testing/nat "historical z survives the cull" 1
        ?=((./known _) gone.page(.z (./some 1) target))
    []

  + readers
    \ ignored=unit
    ^ row[testing/check]
    =   state
      | fixture/cell_tests/put ['parent 'child] myth/new sov/new
    = exact           (store_page_reader state)
      visible         (store_reader state)
      exact_page      exact.page
      visible_page    visible.page
      exact_version   exact.version
      visible_version visible.version
    | row/cons[testing/check]
      | testing/nat "trigger reader excludes transparent folders" 1
        ?=(.unknown (exact_page .y 0 ['parent]))
    | row/cons[testing/check]
      | testing/nat "ordinary reader includes transparent folders" 1
        ?=((./known _) (visible_page .y 0 ['parent]))
    | row/cons[testing/check]
      | testing/nat "trigger reader retains its root version answer" 1
        ?=((./known _) (exact_version []))
    | row/cons[testing/check]
      | testing/nat "ordinary reader has no root version answer" 1
        ?=(.unknown (visible_version []))
    []

  + triggers
    \ ignored=unit
    ^ row[testing/check]
    = reader  (store_reader sov/new)
      reverse (dep .y (r_spell ['target]))
      real    (dep .z ['ordinary])
      context (dep .x ['c 'x 'cell])
      history (dep .z ['h 'z ($u 1) ($u 1) 'target])
    = direct   (\ d=dep (derived_triggers d reader .true))
      expanded (\ d=dep (derived_triggers d reader .false))
    | row/cons[testing/check]
      | testing/nat "reconcile retains reverse subscription care" 1
        | equal [reverse] (direct reverse)
    | row/cons[testing/check]
      | testing/nat "lens expands the reverse subscription" 1
        | equal (reverse_triggers reverse.p) (expanded reverse)
    | row/cons[testing/check]
      | testing/nat "reconcile retains ordinary subscriptions" 1
        | equal [real] (direct real)
    | row/cons[testing/check]
      | testing/nat "lens excludes ordinary subscriptions" 0
        (expanded real).len
    | row/cons[testing/check]
      | testing/nat "reconcile retains context subscriptions" 1
        | equal [context] (direct context)
    | row/cons[testing/check]
      | testing/nat "pinned history stays immutable" 0
        (direct history).len
    []

  + assignments
    \ ignored=unit
    ^ row[testing/check]
    = first=path   ['sys 'first]
      second=path  ['sys 'second]
      foreign=path [($x 1) 'foreign]
    = seed (fixture/cell_tests/put first myth/new sov/new)
    > (./ok batch) (publication_batch/prepare 'sys [first second] seed)
      [(testing/nat "prepare failed" 1 0)]
    =   duplicate=either[iota publication_batch]
      (./err 'duplicate_definition)
    =   authority=either[iota publication_batch]
      (./err 'authority_mismatch)
    | row/cons[testing/check]
      | testing/nat "existing definitions increment their own case" 2
        batch.assigned.gut(first 0)
    | row/cons[testing/check]
      | testing/nat "new definitions start at case one" 1
        batch.assigned.gut(second 0)
    | row/cons[testing/check]
      | testing/nat "late duplicates retain their original error" 1
        | equal duplicate
          | publication_batch/prepare 'sys [first second first] seed
    | row/cons[testing/check]
      | testing/nat "first error still follows input order" 1
        | equal authority
          | publication_batch/prepare 'sys [foreign first first] seed
    []

+ tests
  ^ row[testing/case]
  [
    (testing/case "page tombstones" namespace_polish/pages)
    (testing/case "exact trigger readers" namespace_polish/readers)
    (testing/case "trigger modes" namespace_polish/triggers)
    (testing/case "publication iteration" namespace_polish/assignments)]
