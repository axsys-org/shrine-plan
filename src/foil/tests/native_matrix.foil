- native_matrix
- testing

+ matrix_checks
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = source (native_matrix/generate 4 3 (\ x=nat y=nat (add x (mul y 4))))
      region (either/ok_val (native_matrix/region source 1 1 2 2))
      painted (either/ok_val (native_matrix/write source (native_matrix/position 2 1 4 3) 90))
      transpose (either/ok_val (native_matrix/transpose source))
      mapped (native_matrix/map nat/inc source)
      stroke (either/ok_val (native_matrix/paint[nat] source [[0 1] [3 1]] 99))
    [(testing/nat "generated value has a checked shape" 1 (native_matrix/valid source))
     (testing/nat "selected position is the original matrix element" 6 (native_matrix/read source 2 1).fall(999))
     (testing/nat "point edit changes that position" 90 (native_matrix/read painted 2 1).fall(999))
     (testing/nat "point edit preserves its neighbor" 7 (native_matrix/read painted 3 1).fall(999))
     (testing/nat "old geometry cannot redirect a write" 1 (either/is_err (native_matrix/write source (native_matrix/position 2 1 3 4) 90)))
     (testing/nat "crop retains correct original coordinates" 5 region.cells.at(0))
     (testing/nat "crop retains the next original row" 10 region.cells.at(3))
     (testing/nat "transpose exchanges axes" 6 (native_matrix/read transpose 1 2).fall(999))
     (testing/nat "transformation is ordinary higher-order native computation" 7 (native_matrix/read mapped 2 1).fall(999))
     (testing/nat "stroke interpolation is native computation" 99 (native_matrix/read stroke 2 1).fall(999))
     (testing/nat "stroke does not modify adjacent rows" 2 (native_matrix/read stroke 2 0).fall(999))
     (testing/nat "invalid shape does not become a value" 1
       (maybe/is_none (native_matrix/read (native_matrix/value[nat] 4 3 [1 2]) 0 0)))
     (testing/nat "out of range remains unresolved" 1 (maybe/is_none (native_matrix/read source 4 0)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native matrix value operations" matrix_checks/checks)]
