- tests/value_read
- eden

' Real Eden and the registered HTTP foot, exclusively in disposable state.
+ value_http
  + quoted_name
    ^ str
    | str/cat_all ["quote" (str/from_atom 34) "slash" (str/from_atom 92)]
  + fail
    \ initial=namespace reason=str
    ^ namespace
    ; (error (eden/err reason))
    initial
  + state
    \ initial=namespace
    ^ namespace
    = original=myth value_tests/record
      record original.put(['large] (pt (str/repeat 70000 "a").cat("END"))).put(['escaped] (pt "<script>alert(1)</script> & quoted"))
      base_changes (axal/new[note] .none).put([initial.self 'demo] (note/make record))
      changes base_changes.put([initial.self ($ta value_http/quoted_name)] (note/make (myth/sing [($ta value_http/quoted_name)] (pt "quoted identifier"))))
    ?> (./accepted seeded) initial.step(changes 0 0)
        (value_http/fail initial "Value fixture seed failed")
    seeded.state
