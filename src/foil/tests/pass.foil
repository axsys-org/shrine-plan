- helm
- net
- pass
- testing
- tests/namespace [at=fixture]

' A name, its log, and a reader's card for it. Secrets and seeds here are
' test numbers: 32 bytes as the runtime takes them.
+ pass_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + key
    \ n=nat
    ^ nat
    | Ed25519PublicKey (pass_tests/seed n)
  + show
    \ result=either[iota pass/standing]
    ^ str
    ? result
     > (./err why) (str/from_atom (iota_show why))
     > (./ok at) "ok"
  + told
    \ result=either[iota row[[p=path q=writ]]]
    ^ str
    ? result
     > (./err why) (str/from_atom (iota_show why))
     > (./ok writes) "ok"
  + stand
    \ result=either[iota pass/standing]
    ^ pass/standing
    ? result
     > (./err why) (pass/standing 0 0 0 0 0 0)
     > (./ok at) at
  + apply
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) result state
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + rules
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      host (pass_tests/key 1)
      made (pass/mint secret 0 host)
      name made.name
      one=row[pass/statement] [made.first]
      at1 (pass_tests/stand (pass/read name made.made one))
      own (pass_tests/seed 50)
      claimed (pass/claim secret name at1 (Ed25519PublicKey own) (pass_tests/key 2))
      at2 (pass_tests/stand (pass/next name at1 claimed))
      by_host (pass/state (pass_tests/seed 1) name at1 2 0 (pass_tests/key 3) host)
      rotated (pass/state own name at2 3 0 (pass_tests/key 4) (Ed25519PublicKey own))
      same_life (pass/state own name at2 2 0 (pass_tests/key 4) (Ed25519PublicKey own))
      back (pass/state own name at2 1 0 (pass_tests/key 2) (Ed25519PublicKey own))
      restored (pass/state own name at2 2 1 (pass_tests/key 2) (Ed25519PublicKey own))
      other (pass/claim secret name at1 (pass_tests/key 60) (pass_tests/key 61))
      whole=row[pass/statement] [made.first claimed rotated]
      elsewhere (pass/mint (pass_tests/seed 901) 0 host)
      strange (pass/founding 2 made.made.custody made.made.dat)
    [(testing/nat "a name is 128 bits of its founding" 1 (lt name 340282366920938463463374607431768211456))
     (testing/nat "another secret makes another name" 0 (eq name elsewhere.name))
     (testing/nat "a founding names its form, the one there is" 1 (eq pass/form made.made.form))
     (testing/nat "and the form is in the name" 0 (eq name (pass/name strange)))
     (testing/text "a form this kernel does not read is refused" "pass_form" (pass_tests/show (pass/read (pass/name strange) strange one)))
     (testing/text "a minted name reads from its founding" "ok" (pass_tests/show (pass/read name made.made one)))
     (testing/nat "at life 1 with the host's key" 1 (and (eq 1 at1.life) (eq host at1.live)))
     (testing/text "a log read under another name is refused" "pass_name" (pass_tests/show (pass/read name.inc made.made one)))
     (testing/text "the claim follows" "ok" (pass_tests/show (pass/next name at1 claimed)))
     (testing/nat "and custody is then the claimant's own" 1 (eq at2.custody (Ed25519PublicKey own)))
     (testing/nat "under the next life with a new key" 1 (and (eq 2 at2.life) (eq (pass_tests/key 2) at2.live)))
     (testing/text "the host cannot make a statement" "pass_forged" (pass_tests/show (pass/next name at1 by_host)))
     (testing/text "after the claim the invitation signs nothing" "pass_forged" (pass_tests/show (pass/next name at2 (pass/state (pass/custody secret) name at2 3 0 (pass_tests/key 9) (pass_tests/key 9)))))
     (testing/text "the owner changes its key under a new life" "ok" (pass_tests/show (pass/next name at2 rotated)))
     (testing/text "a new key under the same life is refused" "pass_key" (pass_tests/show (pass/next name at2 same_life)))
     (testing/text "a life does not go back" "pass_back" (pass_tests/show (pass/next name at2 back)))
     (testing/text "a restore raises the rift under the same key" "ok" (pass_tests/show (pass/next name at2 restored)))
     (testing/text "a statement out of turn is a gap" "pass_gap" (pass_tests/show (pass/next name at1 rotated)))
     (testing/text "the whole log reads" "ok" (pass_tests/show (pass/read name made.made whole)))
     (testing/nat "two claims of one invitation are a fork" 1 (pass/forked name at1 claimed other))
     (testing/nat "a statement is not a fork of itself" 0 (pass/forked name at1 claimed claimed))
     (testing/nat "a log names every key the name has had" 3 (pass/lives whole).len)]
  + cards
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      host_seed (pass_tests/seed 1)
      made (pass/mint secret 0 (Ed25519PublicKey host_seed))
      name made.name
      me (namespace ($x 18) sov/new (fixture/namespace_tests/initial).system)
      card=path [($x 18) 'io 'mesa ($x name)]
      one=row[pass/statement] [made.first]
      wrong=path [($x 18) 'io 'mesa ($x name.inc)]
      met (pass/meet card made.made one me)
      m1 (pass_tests/apply met me)
      at1 (pass_tests/stand (pass/read name made.made one))
      own (pass_tests/seed 50)
      new_seed (pass_tests/seed 2)
      claimed (pass/claim secret name at1 (Ed25519PublicKey own) (Ed25519PublicKey new_seed))
      turned (pass/turn card claimed m1)
      m2 (pass_tests/apply turned m1)
      other (pass/claim secret name at1 (pass_tests/key 60) (pass_tests/key 61))
      forked (pass/turn card other m2)
      m3 (pass_tests/apply forked m2)
      root=path [($x name) 'our ($x 18)]
      mount=path [($x 18) 'her ($x name)]
      doc (myth/sing ['value] (pails/n 10))
      here=path []
      entries=row[net/entry] [(net/put here (net/stamp 0 1) doc)]
      change (net/epic 0 (net/stamp 0 1) 0 entries)
      by_host (net/seal host_seed root change)
      by_owner (net/seal new_seed root change)
      landed (pass_tests/apply (net/land mount card by_owner m2) m2)
      held (sovereign_care .x mount landed).fil.fall(myth/new)
      whole=row[pass/statement] [made.first claimed]
    [(testing/text "a card kept under another name refuses the log" "pass_name" (pass_tests/told (pass/meet wrong made.made one me)))
     (testing/text "the log is kept on the card for its name" "ok" (pass_tests/told met))
     (testing/nat "the card's key is the live key" 1 (eq (Ed25519PublicKey host_seed) (net/key card m1)))
     (testing/text "before the claim the host's epic lands" "ok" (pass_tests/told (net/land mount card by_host m1)))
     (testing/text "the claim turns the card" "ok" (pass_tests/told turned))
     (testing/nat "to the claimant's key" 1 (eq (Ed25519PublicKey new_seed) (net/key card m2)))
     (testing/text "after it the host's epic is forged" "net_forged" (pass_tests/told (net/land mount card by_host m2)))
     (testing/text "and the owner's lands" "ok" (pass_tests/told (net/land mount card by_owner m2)))
     (testing/text "the same statement again changes nothing" "pass_known" (pass_tests/told (pass/turn card claimed m2)))
     (testing/text "a second claim of the invitation is kept as a fork" "ok" (pass_tests/told forked))
     (testing/nat "the card says so" 2 (net/held ['fork] card m3))
     (testing/text "and nothing more lands from that name" "net_forked" (pass_tests/told (net/land mount card by_owner m3)))
     (testing/nat "a record shown to a third world checks against the log" 1 (pass/attested whole root (net/said mount landed) held))
     (testing/nat "and does not check against another name's log" 0 (pass/attested [(pass/mint (pass_tests/seed 901) 0 (pass_tests/key 7)).first] root (net/said mount landed) held))]

+ tests
  ^ row[testing/case]
  [(testing/case "a name, its custody and its log" pass_tests/rules)
   (testing/case "a reader's card follows a name's log" pass_tests/cards)]
