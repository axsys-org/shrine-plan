- eden_store
- helm
- net
- pass
- testing
- tests/namespace [at=fixture]

' These tests are for a name, the log of the name and a reader's card for the
' name. The secrets and the seeds here are test numbers. Each number is 32
' bytes in the form that the runtime accepts.
+ pass_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + key
    \ n=nat
    ^ nat
    | Ed25519PublicKey (pass_tests/seed n)
  + show
    \ result=either[iota pass/standing]
    ^ str
    ? result
     > (./err why) (str/from_atom (iota_show why))
     > (./ok at) "ok"
  + told
    \ result=either[iota row[[p=path q=writ]]]
    ^ str
    ? result
     > (./err why) (str/from_atom (iota_show why))
     > (./ok writes) "ok"
  + stand
    \ result=either[iota pass/standing]
    ^ pass/standing
    ? result
     > (./err why) (pass/standing 0 0 0 0 0 0)
     > (./ok at) at
  + apply
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) result state
    ? (eden_store/changes writes state)
     > (./ok next) next
     > (./err why) state
  + rules
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      host (pass_tests/key 1)
      made (pass/mint secret 0 host)
      name made.name
      one=row[pass/statement] [made.first]
      at1 (pass_tests/stand (pass/read name made.made one))
      own (pass_tests/seed 50)
      claimed (pass/claim secret name at1 (Ed25519PublicKey own) (pass_tests/key 2))
      at2 (pass_tests/stand (pass/next name at1 claimed))
      by_host (pass/state (pass_tests/seed 1) name at1 2 0 (pass_tests/key 3) host)
      rotated (pass/state own name at2 3 0 (pass_tests/key 4) (Ed25519PublicKey own))
      same_life (pass/state own name at2 2 0 (pass_tests/key 4) (Ed25519PublicKey own))
      back (pass/state own name at2 1 0 (pass_tests/key 2) (Ed25519PublicKey own))
      restored (pass/state own name at2 2 1 (pass_tests/key 2) (Ed25519PublicKey own))
      other (pass/claim secret name at1 (pass_tests/key 60) (pass_tests/key 61))
      whole=row[pass/statement] [made.first claimed rotated]
      elsewhere (pass/mint (pass_tests/seed 901) 0 host)
      strange (pass/founding 2 made.made.custody made.made.dat)
    [(testing/nat "a name is 128 bits of its founding" 1 (lt name 340282366920938463463374607431768211456))
     (testing/nat "another secret makes another name" 0 (eq name elsewhere.name))
     (testing/nat "a founding names its form, the one there is" 1 (eq pass/form made.made.form))
     (testing/nat "and the form is in the name" 0 (eq name (pass/name strange)))
     (testing/text "a form this kernel does not read is refused" "pass_form" (pass_tests/show (pass/read (pass/name strange) strange one)))
     (testing/text "a minted name reads from its founding" "ok" (pass_tests/show (pass/read name made.made one)))
     (testing/nat "at life 1 with the host's key" 1 (and (eq 1 at1.life) (eq host at1.live)))
     (testing/text "a log read under another name is refused" "pass_name" (pass_tests/show (pass/read name.inc made.made one)))
     (testing/text "the claim follows" "ok" (pass_tests/show (pass/next name at1 claimed)))
     (testing/nat "and custody is then the claimant's own" 1 (eq at2.custody (Ed25519PublicKey own)))
     (testing/nat "under the next life with a new key" 1 (and (eq 2 at2.life) (eq (pass_tests/key 2) at2.live)))
     (testing/text "the host cannot make a statement" "pass_forged" (pass_tests/show (pass/next name at1 by_host)))
     (testing/text "after the claim the invitation signs nothing" "pass_forged" (pass_tests/show (pass/next name at2 (pass/state (pass/custody secret) name at2 3 0 (pass_tests/key 9) (pass_tests/key 9)))))
     (testing/text "the owner changes its key under a new life" "ok" (pass_tests/show (pass/next name at2 rotated)))
     (testing/text "a new key under the same life is refused" "pass_key" (pass_tests/show (pass/next name at2 same_life)))
     (testing/text "a life does not go back" "pass_back" (pass_tests/show (pass/next name at2 back)))
     (testing/text "a restore raises the rift under the same key" "ok" (pass_tests/show (pass/next name at2 restored)))
     (testing/text "a statement out of turn is a gap" "pass_gap" (pass_tests/show (pass/next name at1 rotated)))
     (testing/text "the whole log reads" "ok" (pass_tests/show (pass/read name made.made whole)))
     (testing/nat "two claims of one invitation are a fork" 1 (pass/forked name at1 claimed other))
     (testing/nat "a statement is not a fork of itself" 0 (pass/forked name at1 claimed claimed))
     (testing/nat "a log names every key the name has had" 3 (pass/lives whole).len)]
  + cards
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      host_seed (pass_tests/seed 1)
      made (pass/mint secret 0 (Ed25519PublicKey host_seed))
      name made.name
      me (namespace ($x 18) sov/new (fixture/namespace_tests/initial).system)
      card=path [($x 18) 'io 'mesa ($x name)]
      one=row[pass/statement] [made.first]
      wrong=path [($x 18) 'io 'mesa ($x name.inc)]
      met (pass/meet card made.made one me)
      m1 (pass_tests/apply met me)
      at1 (pass_tests/stand (pass/read name made.made one))
      own (pass_tests/seed 50)
      new_seed (pass_tests/seed 2)
      claimed (pass/claim secret name at1 (Ed25519PublicKey own) (Ed25519PublicKey new_seed))
      turned (pass/turn card claimed m1)
      m2 (pass_tests/apply turned m1)
      other (pass/claim secret name at1 (pass_tests/key 60) (pass_tests/key 61))
      forked (pass/turn card other m2)
      m3 (pass_tests/apply forked m2)
      root=path [($x name) 'our ($x 18)]
      mount=path [($x 18) 'her ($x name)]
      doc (myth/sing ['value] (pails/n 10))
      here=path []
      entries=row[net/entry] [(net/put here (net/stamp 0 1) doc)]
      change (net/epic 0 (net/stamp 0 1) 0 entries)
      by_host (net/seal host_seed root change)
      by_owner (net/seal new_seed root change)
      landed (pass_tests/apply (net/land mount card by_owner m2) m2)
      held (sovereign_care .x mount landed).fil.fall(myth/new)
      whole=row[pass/statement] [made.first claimed]
    [(testing/text "a card kept under another name refuses the log" "pass_name" (pass_tests/told (pass/meet wrong made.made one me)))
     (testing/text "the log is kept on the card for its name" "ok" (pass_tests/told met))
     (testing/nat "the card's key is the live key" 1 (eq (Ed25519PublicKey host_seed) (net/key card m1)))
     (testing/text "before the claim the host's epic lands" "ok" (pass_tests/told (net/land mount card by_host m1)))
     (testing/text "the claim turns the card" "ok" (pass_tests/told turned))
     (testing/nat "to the claimant's key" 1 (eq (Ed25519PublicKey new_seed) (net/key card m2)))
     (testing/text "after it the host's epic is forged" "net_forged" (pass_tests/told (net/land mount card by_host m2)))
     (testing/text "and the owner's lands" "ok" (pass_tests/told (net/land mount card by_owner m2)))
     (testing/text "the same statement again changes nothing" "pass_known" (pass_tests/told (pass/turn card claimed m2)))
     (testing/text "a second claim of the invitation is kept as a fork" "ok" (pass_tests/told forked))
     (testing/nat "the card says so" 2 (net/held ['fork] card m3))
     (testing/text "and nothing more lands from that name" "net_forked" (pass_tests/told (net/land mount card by_owner m3)))
     (testing/nat "a record shown to a third world checks against the log" 1 (pass/attested whole root (net/said mount landed) held))
     (testing/nat "and does not check against another name's log" 0 (pass/attested [(pass/mint (pass_tests/seed 901) 0 (pass_tests/key 7)).first] root (net/said mount landed) held))]
  + shows
    \ result=maybe[pass/introduction]
    ^ nat
    ? (maybe/is_some result) 1
    0
  + bringing
    ' A name brings a world before a community, and the world claimed that
    ' name there. 18 is the community. n is the name that the community minted
    ' and the person claimed. r is a world that the person already has, with a
    ' log of two statements.
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      minted (pass/mint secret 0 (pass_tests/key 1))
      n minted.name
      n1 (pass_tests/stand (pass/read n minted.made [minted.first]))
      mine (pass_tests/seed 50)
      claimed (pass/claim secret n n1 (Ed25519PublicKey mine) (pass_tests/key 2))
      n2 (pass_tests/stand (pass/next n n1 claimed))
      custody (pass_tests/seed 70)
      made (pass/founding pass/form (Ed25519PublicKey custody) 0)
      r (pass/name made)
      first (pass/state custody r (pass/born made) 1 0 (pass_tests/key 71) (Ed25519PublicKey custody))
      r1 (pass_tests/stand (pass/next r (pass/born made) first))
      moved (pass_tests/seed 72)
      second (pass/state custody r r1 2 0 (pass_tests/key 73) (Ed25519PublicKey moved))
      r2 (pass_tests/stand (pass/next r r1 second))
      one=row[pass/statement] [first]
      both=row[pass/statement] [first second]
      none=row[pass/statement] []
      good (pass/introduce mine custody 18 n r made r1 "10.0.0.7" 9100)
      later (pass/introduce mine moved 18 n r made r2 "10.0.0.7" 9100)
      stale (pass/introduce mine custody 18 n r made r2 "10.0.0.7" 9100)
      unasked (pass/introduce mine (pass_tests/seed 99) 18 n r made r1 "10.0.0.7" 9100)
      stranger (pass/introduce (pass_tests/seed 98) custody 18 n r made r1 "10.0.0.7" 9100)
      old (pass/introduce (pass/custody secret) custody 18 n r made r1 "10.0.0.7" 9100)
      moved_host (pass/introduction good.to good.by good.name good.made good.seq good.last "10.0.0.8" good.port good.vouch good.consent)
      renamed (pass/introduction good.to good.by r.inc good.made good.seq good.last good.host good.port good.vouch good.consent)
      back (pass/opened (pass/letter good))
      again
        ?> (./some i) back (pass/introduction 0 0 0 made 0 0 "" 0 0 0)
        i
    [(testing/text "custody of the bringing name and of the world brought both sign: it holds" "ok" (pass_tests/show (pass/introduced 18 n2 one good)))
     (testing/nat "and says where the world brought stands" 1 (eq (pass_tests/key 71) (pass_tests/stand (pass/introduced 18 n2 one good)).live))
     (testing/text "shown to another world it proves nothing" "pass_other" (pass_tests/show (pass/introduced 19 n2 one good)))
     (testing/text "a world whose custody did not sign is not brought" "pass_consent" (pass_tests/show (pass/introduced 18 n2 one unasked)))
     (testing/text "a name whose custody did not sign brings nobody" "pass_vouch" (pass_tests/show (pass/introduced 18 n2 one stranger)))
     (testing/text "after the claim the invitation's secret brings nobody" "pass_vouch" (pass_tests/show (pass/introduced 18 n2 one old)))
     (testing/text "before the claim the claimant's custody brings nobody" "pass_vouch" (pass_tests/show (pass/introduced 18 n1 one good)))
     (testing/text "another address under the same signatures is refused" "pass_vouch" (pass_tests/show (pass/introduced 18 n2 one moved_host)))
     (testing/text "another name over the same founding is refused" "pass_name" (pass_tests/show (pass/introduced 18 n2 one renamed)))
     (testing/text "a reader that lacks the log so far waits" "pass_short" (pass_tests/show (pass/introduced 18 n2 none good)))
     (testing/text "a reader that lacks its later part waits" "pass_short" (pass_tests/show (pass/introduced 18 n2 one later)))
     (testing/text "consent is the custody in force where the words say" "ok" (pass_tests/show (pass/introduced 18 n2 both later)))
     (testing/text "and not the custody of an earlier standing" "pass_consent" (pass_tests/show (pass/introduced 18 n2 both stale)))
     (testing/text "an introduction made earlier holds after the world moves on" "ok" (pass_tests/show (pass/introduced 18 n2 both good)))
     (testing/nat "which then stands where its whole log leaves it" 1 (eq (pass_tests/key 73) (pass_tests/stand (pass/introduced 18 n2 both good)).live))
     (testing/nat "an introduction travels as bytes and comes back whole" 1 (equal[pass/introduction] good again))
     (testing/nat "a statement's bytes are not an introduction" 0 (pass_tests/shows (pass/opened (pass/sent first))))
     (testing/nat "an introduction's bytes are not a statement" 0 (? (maybe/is_some (pass/got (pass/letter good))) 1 0))
     (testing/nat "an introduction is under 700 bytes, half a packet" 1 (lt (wid (pass/letter good)) 700))]
  + port
    \ card=path state=namespace
    ^ nat
    | net/held ['port] card state
  + arriving
    ' This test shows the same as cards in the world of the community, 18. n
    ' is the name that the community minted, and the community keeps a log for
    ' n with no address. r is a world that the community does not know, and
    ' the log of r is two statements long.
    \ _=unit
    ^ row[testing/check]
    = secret (pass_tests/seed 900)
      minted (pass/mint secret 0 (pass_tests/key 1))
      n minted.name
      one=row[pass/statement] [minted.first]
      me (namespace ($x 18) sov/new (fixture/namespace_tests/initial).system)
      n_card=path [($x 18) 'io 'mesa ($x n)]
      m0 (pass_tests/apply (pass/meet n_card minted.made one me) me)
      n1 (pass_tests/stand (pass/read n minted.made one))
      mine (pass_tests/seed 50)
      claimed (pass/claim secret n n1 (Ed25519PublicKey mine) (pass_tests/key 2))
      n2 (pass_tests/stand (pass/next n n1 claimed))
      custody (pass_tests/seed 70)
      made (pass/founding pass/form (Ed25519PublicKey custody) 0)
      r (pass/name made)
      r_card=path [($x 18) 'io 'mesa ($x r)]
      first (pass/state custody r (pass/born made) 1 0 (pass_tests/key 71) (Ed25519PublicKey custody))
      r1 (pass_tests/stand (pass/next r (pass/born made) first))
      second (pass/state custody r r1 2 0 (pass_tests/key 73) (Ed25519PublicKey custody))
      r2 (pass_tests/stand (pass/next r r1 second))
      letter (pass/introduce mine custody 18 n r made r2 "10.0.0.7" 9100)
      unasked (pass/introduce mine (pass_tests/seed 99) 18 n r made r2 "10.0.0.7" 9100)
      elsewhere (pass/introduce mine custody 19 n r made r2 "10.0.0.7" 9100)
      unknown (pass/introduce mine custody 18 n.inc r made r2 "10.0.0.7" 9100)
      here (pass/introduce mine mine 18 n n minted.made n2 "10.0.0.9" 9200)
      m1 (pass_tests/apply (pass/follow n_card claimed m0) m0)
      m2 (pass_tests/apply (pass/welcome n_card here m1) m1)
      m3 (pass_tests/apply (pass/welcome r_card letter m2) m2)
      m4 (pass_tests/apply (pass/follow r_card first m3) m3)
      m5 (pass_tests/apply (pass/welcome r_card letter m4) m4)
      m6 (pass_tests/apply (pass/follow r_card second m5) m5)
      m7 (pass_tests/apply (pass/welcome r_card letter m6) m6)
      held (sovereign_care .x r_card m7).fil.fall(myth/new)
    [(testing/text "before the claim is known, the claimant's custody brings nobody" "pass_vouch" (pass_tests/told (pass/welcome r_card letter m0)))
     (testing/text "nor says where the minted name runs" "pass_vouch" (pass_tests/told (pass/welcome n_card here m0)))
     (testing/text "a statement for a name with no card is not kept" "pass_unmet" (pass_tests/told (pass/follow r_card first m0)))
     (testing/text "the claim is taken from a sender that is not heard" "ok" (pass_tests/told (pass/follow n_card claimed m0)))
     (testing/nat "and the card follows it" 2 (net/held ['seq] n_card m1))
     (testing/nat "which gives the card no address" 0 (pass_tests/port n_card m1))
     (testing/text "the claimed name says where it runs" "ok" (pass_tests/told (pass/welcome n_card here m1)))
     (testing/nat "and its card has its address: it is a route" 9200 (pass_tests/port n_card m2))
     (testing/text "a card that has an address takes no other this way" "pass_met" (pass_tests/told (pass/welcome n_card here m2)))
     (testing/text "an introduction for another world is not taken" "pass_other" (pass_tests/told (pass/welcome r_card elsewhere m2)))
     (testing/text "nor one brought by a name this world holds no log for" "pass_unmet" (pass_tests/told (pass/welcome r_card unknown m2)))
     (testing/text "nor one kept under another name's card" "pass_name" (pass_tests/told (pass/welcome n_card letter m1)))
     (testing/text "a vouched introduction is kept before any of the log is" "ok" (pass_tests/told (pass/welcome r_card letter m2)))
     (testing/nat "and gives no address" 0 (pass_tests/port r_card m3))
     (testing/nat "and no key" 0 (net/key r_card m3))
     (testing/text "the first statement begins the log from the founding it states" "ok" (pass_tests/told (pass/follow r_card first m3)))
     (testing/nat "the log is then one long" 1 (net/held ['seq] r_card m4))
     (testing/nat "short of what the words say, the introduction still gives no address" 0 (pass_tests/port r_card m5))
     (testing/text "the next statement follows" "ok" (pass_tests/told (pass/follow r_card second m5)))
     (testing/nat "a statement gives no address either" 0 (pass_tests/port r_card m6))
     (testing/text "with the whole log, an introduction its custody did not sign is refused" "pass_consent" (pass_tests/told (pass/welcome r_card unasked m6)))
     (testing/text "and the one it signed is taken" "ok" (pass_tests/told (pass/welcome r_card letter m6)))
     (testing/nat "the world brought is then a route" 9100 (pass_tests/port r_card m7))
     (testing/text "at the address its custody signed" "10.0.0.7" held.txt_at(['host]))
     (testing/nat "with the key its log gives it" 1 (eq (pass_tests/key 73) (net/key r_card m7)))
     (testing/nat "and the card keeps who brought it" 1 (? (maybe/is_some (pass/pending r_card m7)) 1 0))]
  + said
    \ result=either[iota nat]
    ^ str
    ? result
     > (./err why) (str/from_atom (iota_show why))
     > (./ok at) "ok"
  + whose
    \ result=either[iota nat]
    ^ nat
    ? result
     > (./err why) 0
     > (./ok session) session
  + doors
    ' This test uses a world that another made, and it shows who can act at
    ' the door of that world. The maker founds the world on its own custody
    ' key and binds what the world starts as.
    \ _=unit
    ^ row[testing/check]
    = maker (pass_tests/seed 300)
      pack=path [($x 18) 'gov 'community]
      other=path [($x 18) 'gov 'school]
      start (pass/origin pack 4 18)
      made (pass/founding pass/form (Ed25519PublicKey maker) (pass/binds start))
      name (pass/name made)
      first (pass/state maker name (pass/born made) 1 0 (pass_tests/key 301) (Ed25519PublicKey maker))
      at1 (pass_tests/stand (pass/next name (pass/born made) first))
      theirs (pass_tests/seed 310)
      handed (pass/state maker name at1 2 0 (pass_tests/key 311) (Ed25519PublicKey theirs))
      at2 (pass_tests/stand (pass/next name at1 handed))
      session (Sha256 (pass_tests/seed 77))
      mine (pass/allow maker name session 5000)
      live (pass/allow (pass_tests/seed 301) name session 5000)
      fresh (pass/allow theirs name session 5000)
      stretched (pass/grant mine.name mine.session 9000 mine.sig)
      swapped (pass/grant mine.name (Sha256 (pass_tests/seed 78)) mine.until mine.sig)
    [(testing/nat "a founding binds the first tree its maker names" 1 (pass/begun made start))
     (testing/nat "and not another pack" 0 (pass/begun made (pass/origin other 4 18)))
     (testing/nat "nor the same pack at another version" 0 (pass/begun made (pass/origin pack 5 18)))
     (testing/nat "nor another maker" 0 (pass/begun made (pass/origin pack 4 19)))
     (testing/nat "what it binds is in the name" 0 (eq name (pass/name (pass/founding pass/form (Ed25519PublicKey maker) (pass/binds (pass/origin other 4 18))))))
     (testing/text "custody opens the door for a session" "ok" (pass_tests/said (pass/allowed name at1 1000 mine)))
     (testing/nat "and the grant says which session" 1 (eq session (pass_tests/whose (pass/allowed name at1 1000 mine))))
     (testing/text "a grant for one world opens no other" "pass_other" (pass_tests/said (pass/allowed name.inc at1 1000 mine)))
     (testing/text "a grant ends" "pass_ended" (pass_tests/said (pass/allowed name at1 5000 mine)))
     (testing/text "and cannot be made to last longer" "pass_forged" (pass_tests/said (pass/allowed name at1 6000 stretched)))
     (testing/text "nor moved to another session" "pass_forged" (pass_tests/said (pass/allowed name at1 1000 swapped)))
     (testing/text "the key that runs the world cannot open its door" "pass_forged" (pass_tests/said (pass/allowed name at1 1000 live)))
     (testing/text "after custody moves, the maker's grant is nothing" "pass_forged" (pass_tests/said (pass/allowed name at2 1000 mine)))
     (testing/text "and the new custody's opens it" "ok" (pass_tests/said (pass/allowed name at2 1000 fresh)))]

+ tests
  ^ row[testing/case]
  [(testing/case "a name, its custody and its log" pass_tests/rules)
   (testing/case "a reader's card follows a name's log" pass_tests/cards)
   (testing/case "a world brought by a name that stands there" pass_tests/bringing)
   (testing/case "a claim and an introduction arrive from senders that are not heard" pass_tests/arriving)
   (testing/case "a founding binds its first tree; custody opens the door" pass_tests/doors)]
