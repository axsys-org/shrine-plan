- lain_peek
- sys/demand
- tests/cells [at=fixture]
- tests/namespace [at=fixture]
- tests/reference_reactivity [at=fixture]
- test_fixtures/demand_policy
- testing

+ demand_tests
  + identity
    \ context=myth input=axal[myth]
    ^ axal[myth]
    input
  + ordinary
    \ source=safe
    ^ myth
    | (myth/sing bond/weft (spun demand_tests/identity .none)).put(bond/tack source)
  + demand
    \ source=safe
    ^ myth
    | (myth/sing bond/weft (woven demand_policy/selected)).put(['source] source)
  + unknown
    \ source=safe state=sov
    ^ nat
    ? (view source.care source.ver source.path state)
     > .unknown 1
    0
  + cycles
    \ ignored=unit
    ^ row[testing/check]
    = a=path [($x 17) 'a]
      b=path [($x 17) 'b]
      data=path [($x 17) 'data]
      av (row/cons[iota] 'x a)
      bv (row/cons[iota] 'x b)
      seed (fixture/cell_tests/put data (myth/sing ['value] (pails/n 7)) sov/new)
      self (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x av)) seed)
      both (fixture/cell_tests/put b (demand_tests/ordinary (safe 1 .x av)) (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x bv)) seed))
      second (demand_tests/ordinary (safe 1 .x data)).put(['other] (safe 1 .x av))
      secondary (fixture/cell_tests/put a second seed)
      historical=path ['h 'x ($u 1) ($u av.len)]
      historical historical.weld(av)
      alias (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x historical)) seed)
      base (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x data)) seed)
      finite (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x av)) base)
      shared (demand_tests/ordinary (safe 1 .x av)).put(['left] (safe 1 .x av)).put(['right] (safe 1 .x av))
      dag (fixture/cell_tests/put b shared base)
      wide
        | (row/range 0 70).fold (demand_tests/ordinary (safe 0 .x data))
          \ out index
          | out.put [($u index)] (safe 0 .x data)
      wide_state (fixture/cell_tests/put b (demand_tests/ordinary (safe 0 .x av)) (fixture/cell_tests/put a wide seed))
      overlay_def=path [($x 17) 'overlay]
      overlay=path ['o ($u 1) ($u overlay_def.len)]
      overlay overlay.weld(overlay_def).snoc(($u av.len)).weld(av)
      via_overlay (fixture/cell_tests/put overlay_def (myth/sing bond/weft (spun demand_tests/identity .none)) seed)
      via_overlay (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x overlay)) via_overlay)
      child=path data.snoc('child)
      ancestor (fixture/cell_tests/put child (demand_tests/ordinary (safe 0 .x data)) seed)
      old_epoch=path ['h 'x ($ts (str/cat_all ["e" base.top.show])) ($u av.len)]
      old_epoch old_epoch.weld(av)
      frozen_chain (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x old_epoch)) base)
      self_epoch=path ['h 'x ($ts (str/cat_all ["e" seed.top.inc.show])) ($u av.len)]
      self_epoch self_epoch.weld(av)
      frozen_cycle (fixture/cell_tests/put a (demand_tests/ordinary (safe 1 .x self_epoch)) seed)
    [(testing/nat "pinned computed self-reference terminates unresolved" 1 (demand_tests/unknown (safe 0 .x av) self))
     (testing/nat "pinned mutual references terminate unresolved" 1 (demand_tests/unknown (safe 0 .x av) both))
     (testing/nat "pinned secondary-input cycle terminates unresolved" 1 (demand_tests/unknown (safe 0 .x av) secondary))
     (testing/nat "historical alias cannot conceal a pinned cycle" 1 (demand_tests/unknown (safe 0 .x av) alias))
     (testing/nat "snapshot freeze cannot clear active cycle trail" 1 (demand_tests/unknown (safe 0 .x av) frozen_cycle))
     (testing/nat "earlier snapshot is a distinct valid computation" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 av frozen_chain)))
     (testing/nat "overlay and pinned cell cycle terminates unresolved" 1 (demand_tests/unknown (safe 0 .x av) via_overlay))
     (testing/nat "earlier self version is a valid finite dependency" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 av finite)))
     (testing/nat "repeated completed dependency is not a cycle" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 bv dag)))
     (testing/nat "more than 64 acyclic dependency edges remain valid" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 bv wide_state)))
     (testing/nat "reading raw ancestor record remains valid" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 (row/cons[iota] 'x child) ancestor)))
     (testing/nat "earlier cell case is retained after newer self reference" 7 (fixture/cell_tests/nat_at ['value] (view .x 1 av finite)))]
  + demanded
    \ ignored=unit
    ^ row[testing/check]
    = source=path [($x 17) 'source]
      cell=path [($x 17) 'demand]
      selected (myth/sing ['value] (pails/n 11)).put(['ignored] (pails/n 1))
      state (fixture/cell_tests/put cell (demand_tests/demand (safe 0 .x source)) (fixture/cell_tests/put source selected sov/new))
      reader (store_reader state)
      answer (woven_evaluate 0 cell .x [] reader)
      unrelated (fixture/cell_tests/put source selected.put(['ignored] (pails/n 2)) state)
      changed (fixture/cell_tests/put source selected.put(['value] (pails/n 12)) state)
      missing_state (fixture/cell_tests/put cell (demand_tests/demand (safe 0 .x source)) sov/new)
      missing (woven_evaluate 0 cell .x [] (store_reader missing_state))
      restored (fixture/cell_tests/put source selected missing_state)
      graft=path [($x 17) 'graft]
      graft_record (myth/sing bond/weft (woven demand_policy/graft)).put(['source] (safe 0 .x source))
      graft_state (fixture/cell_tests/put graft graft_record state)
      self (fixture/cell_tests/put cell (demand_tests/demand (safe 0 .x (row/cons[iota] 'x cell))) sov/new)
      nested=path [($x 17) 'nested]
      nested_state (fixture/cell_tests/put nested (demand_tests/demand (safe 0 .x (row/cons[iota] 'x cell))) state)
      nested_answer (woven_evaluate 0 nested .x [] (store_reader nested_state))
    [(testing/nat "published demand constructor reads only requested value" 11 (fixture/cell_tests/nat_at ['value] answer.value))
     (testing/nat "unselected slot edits preserve observed answer" 1 (woven_valid answer (store_reader unrelated)))
     (testing/nat "selected slot edit invalidates answer" 0 (woven_valid answer (store_reader changed)))
     (testing/nat "missing input is an observation even with fallback value" 0 (woven_valid missing (store_reader restored)))
     (testing/nat "missing input remains a native wake dependency" 1 ((woven_triggers missing).any((\ dep (eq_pith dep.p source)))))
     (testing/nat "graft resolves through native reader" 11 (fixture/cell_tests/nat_at ['value] (view .x 0 (row/cons[iota] 'x graft) graft_state)))
     (testing/nat "nested demand observes underlying source" 1 (nested_answer.observations.any((\ observed (eq_pith observed.read.source.path source)))))
     (testing/nat "nested demand validity sees underlying changes" 0 (woven_valid nested_answer (store_reader (fixture/cell_tests/put source selected.put(['value] (pails/n 12)) nested_state))))
     (testing/nat "demand cycle terminates unresolved" 1 (demand_tests/unknown (safe 0 .x (row/cons[iota] 'x cell)) self))]
  + broad
    \ context=myth cr=care relative=path selection=view_select
    ^ view_plan
    = tree (axal/new[myth] (./some (myth/sing ['value] (pails/n 11))))
      tree tree.put(['child] (myth/sing ['value] (pails/n 22))).put(['child 'grand] (myth/sing ['value] (pails/n 33)))
    | view_plan/done tree.dip(relative)
  + synthesized
    \ context=myth cr=care relative=path selection=view_select
    ^ view_plan
    | view_plan/need (view_read (safe 0 .x [($x 17) 'secret]) .all)
      \ observed=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) observed (view_plan/done (axal/new[myth] .none))
      | view_plan/done tree
  + boundaries
    \ ignored=unit
    ^ row[testing/check]
    = source=path [($x 17) 'secret]
      root=path [($x 17) 'synthesized]
      broad=path [($x 17) 'broad]
      definition=path [($x 17) 'definition]
      state (fixture/cell_tests/put source (myth/sing ['value] (pails/n 7)) sov/new)
      state (fixture/cell_tests/put root (myth/sing bond/weft (woven demand_tests/synthesized)) state)
      state (fixture/cell_tests/put broad (myth/sing bond/weft (woven demand_tests/broad)).put(['unused] (safe 0 .x source)) state)
      state (fixture/cell_tests/put definition (myth/sing bond/weft (woven demand_tests/synthesized)) state)
      computed (row/cons[iota] 'x root)
      wide (row/cons[iota] 'x broad)
      overlay=path ['o ($u 1) ($u definition.len)]
      overlay overlay.weld(definition).snoc(($u source.len)).weld(source)
      epoch=path ['h 'x ($ts (str/cat_all ["e" state.top.show])) ($u computed.len)]
      epoch epoch.weld(computed)
      changed (fixture/cell_tests/put source (myth/sing ['value] (pails/n 8)) state)
      count
        \ care=care
        ^ nat
        ?> (./known tree) (view care 0 wide state) 999
        | tree.wyt
      inner=path [($x 17) 'inner]
      nested (fixture/cell_tests/put inner (demand_tests/demand (safe 1 .x overlay)) state)
    [(testing/nat "synthesized live input works for current cell" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 computed state)))
     (testing/nat "pinned cell rejects actual synthesized live input" 1 (demand_tests/unknown (safe 1 .x computed) state))
     (testing/nat "pinned overlay rejects actual synthesized live input" 1 (demand_tests/unknown (safe 1 .x overlay) state))
     (testing/nat "nested pinned overlay cannot hide illegal live input with fallback" 1 (demand_tests/unknown (safe 0 .x (row/cons[iota] 'x inner)) nested))
     (testing/nat "unused live argument does not invalidate pinned constant" 11 (fixture/cell_tests/nat_at ['value] (view .x 1 wide state)))
     (testing/nat "epoch snapshot permits reads within its captured boundary" 7 (fixture/cell_tests/nat_at ['value] (view .x 0 epoch changed)))
     (testing/nat "current demand follows changed evidence" 8 (fixture/cell_tests/nat_at ['value] (view .x 0 computed changed)))
     (testing/nat "native x care excludes policy-returned descendants" 1 (count .x))
     (testing/nat "native y care excludes policy-returned grandchildren" 2 (count .y))
     (testing/nat "native z care retains policy-returned subtree" 3 (count .z))]
  + hear
    \ bowl=bowl record=myth changes=row[dep]
    ^ yell
    = value bowl.crew.gut(['answer] (axal/new[myth] .none)).fil.fall(myth/new).nat_at(['value] 999)
    | yell [] record.put(['value] (pails/n value))
  + reactivity
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      source=path [initial.self 'demand_source]
      ordinary=path [initial.self 'ordinary]
      demanded=path [initial.self 'demanded]
      waiting=path [initial.self 'demand_waiter]
      behavior=path [initial.self 'kook 'demand_waiter]
      local (fixture/cell_tests/put behavior (form/card def_form.set_hear(demand_tests/hear) (lore/line "Demand observer")) initial.local)
      local (fixture/cell_tests/put source (myth/sing ['value] (pails/n 1)) local)
      local (fixture/cell_tests/put ordinary (demand_tests/ordinary (safe 0 .x source)) local)
      local (fixture/cell_tests/put demanded (demand_tests/demand (safe 0 .x (row/cons[iota] 'x ordinary))) local)
      local (fixture/cell_tests/put waiting
        (kooked [behavior]).put(crew_slot (cpail (crew/sing ['answer] (dep .x (row/cons[iota] 'x demanded))))) local)
      base initial.set_local(local)
      changed (fixture/reference_reactivity/write source (writ/poke (myth/sing ['value] (pails/n 2))) base)
      missing=path [initial.self 'not_yet]
      rebound (fixture/reference_reactivity/write ordinary (writ/make (demand_tests/ordinary (safe 0 .x missing))) changed)
      restored (fixture/reference_reactivity/write missing (writ/make (myth/sing ['value] (pails/n 3))) rebound)
      virtual (fixture/reference_reactivity/write ordinary (writ/make (myth/sing bond/weft (woven demand_tests/broad))) restored)
      virtual (fixture/reference_reactivity/write demanded (writ/make (demand_tests/demand (safe 0 .x (row/cons[iota] 'x ordinary.snoc('child))))) virtual)
      captured (woven_evaluate 0 demanded .x [] (sovereign_reader virtual))
      nearer (fixture/reference_reactivity/write ordinary.snoc('child) (writ/make (myth/sing bond/weft (woven demand_tests/broad))) virtual)
      captured_nearer (woven_evaluate 0 demanded .x [] (sovereign_reader nearer))
      withdrawn (fixture/reference_reactivity/write ordinary.snoc('child) .cull nearer)
      number
        \ state=namespace
        ^ nat
        | (sovereign_care .x waiting state).fil.fall(myth/new).nat_at ['value] 999
    [(testing/nat "demand over ordinary cell expands to physical native triggers" 2 (number changed))
     (testing/nat "unavailable ordinary input invokes explicit demand fallback" 0 (number rebound))
     (testing/nat "native hand wakes when missing nested input arrives" 3 (number restored))
     (testing/nat "nested demand initially reads virtual child" 22 (number virtual))
     (testing/nat "nearer definition invalidates flattened observations" 0 (woven_valid captured (sovereign_reader nearer)))
     (testing/nat "nearer definition wakes outer native hand" 11 (number nearer))
     (testing/nat "removing nearer definition invalidates captured choice" 0 (woven_valid captured_nearer (sovereign_reader withdrawn)))
     (testing/nat "removing nearer definition restores virtual child reactively" 22 (number withdrawn))]
  + pending_constructor
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      source=path [initial.self 'late_source]
      root=path [initial.self 'late_cell]
      constructor=path [initial.self 'late_constructor]
      waiting=path [initial.self 'late_waiter]
      behavior=path [initial.self 'kook 'late_waiter]
      counting_hear
        \ bowl=bowl record=myth changes=row[dep]
        ^ yell
        = value bowl.crew.gut(['answer] (axal/new[myth] .none)).fil.fall(myth/new).nat_at(['value] 999)
        | yell [] record.put(['value] (pails/n value)).put(['calls] (pails/n record.nat_at(['calls] 0).inc))
      local (fixture/cell_tests/put behavior (form/card def_form.set_hear(counting_hear) (lore/line "Late constructor observer")) initial.local)
      local (fixture/cell_tests/put source (myth/sing ['value] (pails/n 7)) local)
      local (fixture/cell_tests/put root (myth/sing bond/weft (safe 1 .x constructor)).put(['source] (safe 0 .x source)) local)
      local (fixture/cell_tests/put waiting (kooked [behavior]).put(crew_slot (cpail (crew/sing ['answer] (dep .x (row/cons[iota] 'x root))))) local)
      changed (fixture/reference_reactivity/write source (writ/poke (myth/sing ['value] (pails/n 8))) initial.set_local(local))
      published (fixture/reference_reactivity/write constructor (writ/make (myth/sing bond/weft (woven demand_policy/selected))) changed)
      replaced (fixture/reference_reactivity/write constructor (writ/make (myth/sing bond/weft (woven demand_tests/broad))) published)
      cached (sovereign_care .x waiting published).fil.fall(myth/new).nat_at(['value] 999)
      fresh (fixture/cell_tests/nat_at ['value] (sovereign_view .x 0 (row/cons[iota] 'x root) replaced))
      calls
        \ state=namespace
        ^ nat
        | (sovereign_care .x waiting state).fil.fall(myth/new).nat_at ['calls] 0
    [(testing/nat "publishing a missing constructor wakes the existing native hand" 8 cached)
     (testing/nat "later constructor replacement preserves the selected implementation" 8 fresh)
     (testing/nat "resolved constructor pin releases its temporary watch" (calls published) (calls replaced))]
+ tests
  ^ row[testing/case]
  [(testing/case "pinned resolution cycles" demand_tests/cycles)
   (testing/case "demanded native reads" demand_tests/demanded)
   (testing/case "demanded native reactivity" demand_tests/reactivity)
   (testing/case "demand reading boundaries" demand_tests/boundaries)
   (testing/case "pending constructor publication" demand_tests/pending_constructor)]
