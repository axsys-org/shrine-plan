- helm
- testing

' These tests are for fit[t], a checked cast. fit[t] gives the type t to a
' value from outside only when the representation of the value is that of t at
' each depth.
+ fit_tests
  + point
    : x=nat y=nat
  + tree
    & fit_tests/tree/leaf
      fit_tests/tree/node
    + leaf
      :
    + node
      : value=nat l=fit_tests/tree r=fit_tests/tree
  + yes
    (@ t)
    \ found=maybe[t]
    ^ nat
    ? (maybe/is_some found) 1
    0
  + checks
    \ _=unit
    ^ row[testing/check]
    = made=any (fit_tests/point 3 4)
      plain=any [3 4]
      short=any [3]
      nats=any [1 2 3]
      mixed=any [1 [2] 3]
      spelled=path ['a 'b]
      names=any spelled
      whole=any (fit_tests/tree/node 1 (fit_tests/tree/leaf) (fit_tests/tree/node 2 (fit_tests/tree/leaf) (fit_tests/tree/leaf)))
      broken=any [1 2]
      record=any (myth/sing ['value] (pails/n 7))
      cited=any (safe 1 .x ['a 'b])
      paths=row[path] [['a] ['b 'c]]
      typed=[a=nat b=row[path]] [5 paths]
      both=any typed
      bad_both=any [5 [spelled 6]]
      back
        ?> (./some got) (fit[fit_tests/point] made) 0
        | add got.x got.y
    [(testing/nat "a record fits its own type" 1 (fit_tests/yes[fit_tests/point] (fit[fit_tests/point] made)))
     (testing/nat "and comes back typed" 7 back)
     (testing/nat "a plain row is not that record" 0 (fit_tests/yes[fit_tests/point] (fit[fit_tests/point] plain)))
     (testing/nat "a row of nats is a row of nats" 1 (fit_tests/yes[row[nat]] (fit[row[nat]] nats)))
     (testing/nat "a row with a row in it is not" 0 (fit_tests/yes[row[nat]] (fit[row[nat]] mixed)))
     (testing/nat "a nat is not a row" 0 (fit_tests/yes[row[nat]] (fit[row[nat]] (fit_tests/any_nat 5))))
     (testing/nat "a path fits" 1 (fit_tests/yes[path] (fit[path] names)))
     (testing/nat "a row of nats is not a path" 0 (fit_tests/yes[path] (fit[path] nats)))
     (testing/nat "a recursive value fits to its leaves" 1 (fit_tests/yes[fit_tests/tree] (fit[fit_tests/tree] whole)))
     (testing/nat "a row is not a tree" 0 (fit_tests/yes[fit_tests/tree] (fit[fit_tests/tree] broken)))
     (testing/nat "a record of the namespace fits" 1 (fit_tests/yes[myth] (fit[myth] record)))
     (testing/nat "a nat is not one" 0 (fit_tests/yes[myth] (fit[myth] (fit_tests/any_nat 5))))
     (testing/nat "a reference fits" 1 (fit_tests/yes[safe] (fit[safe] cited)))
     (testing/nat "a record is not a reference" 0 (fit_tests/yes[safe] (fit[safe] record)))
     (testing/nat "a plain row type is checked inside" 1 (fit_tests/yes[[a=nat b=row[path]]] (fit[[a=nat b=row[path]]] both)))
     (testing/nat "to any depth" 0 (fit_tests/yes[[a=nat b=row[path]]] (fit[[a=nat b=row[path]]] bad_both)))
     (testing/nat "and to its length" 0 (fit_tests/yes[[a=nat b=row[path]]] (fit[[a=nat b=row[path]]] short)))]
  + any_nat
    \ n=nat
    ^ any
    n

+ tests
  ^ row[testing/case]
  [(testing/case "a checked cast" fit_tests/checks)]
