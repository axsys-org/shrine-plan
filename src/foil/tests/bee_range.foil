- sept
- testing

+ bee_range_tests
  + values
    \ entries=row[uon/kv[nat]]
    ^ row[nat]
    | entries.map (\ e=uon/kv[nat] e.val)

  + same
    \ name=str want=row[nat] got=row[uon/kv[nat]]
    ^ testing/check
    | testing/nat name 1 (equal want (bee_range_tests/values got))

  + seq
    ' Numeric iotas, not lexicographic decimal text.
    \ count=nat
    ^ bee[nat]
    % n=nat 0 tree=bee[nat] (bee/leaf[nat] [])
    ? (eq n count) tree
    | _ n.inc tree.put(($u n) n)

  + missing_link
    ' A deliberately unavailable child. Any attempt to access this
    ' link throws; bounded queries must leave pruned siblings alone.
    \ code=nat
    ^ bee/k[nat]
    = links=row[bee/k[nat]] []
    | links.at (Throw code)

  + edge_cases
    \ ignored=unit
    ^ row[testing/check]
    = empty=bee[nat] (bee/leaf[nat] [])
      tree | empty.put(($u 0) 0).put(($u 2) 2).put(($u 9) 9).put(($u 10) 10)
    [(bee_range_tests/same "empty" [] empty.range_rev(.none 40))
     (bee_range_tests/same "zero limit" [] tree.range_rev(.none 0))
     (bee_range_tests/same "newest first, numeric 10 before 9" [10 9 2 0]
       tree.range_rev(.none 40))
     (bee_range_tests/same "exact limit" [10 9] tree.range_rev(.none 2))
     (bee_range_tests/same "exclusive existing key" [9 2 0]
       tree.range_rev((maybe/some ($u 10)) 40))
     (bee_range_tests/same "absent key between entries" [2 0]
       tree.range_rev((maybe/some ($u 8)) 40))
     (bee_range_tests/same "above maximum" [10 9 2 0]
       tree.range_rev((maybe/some ($u 11)) 40))
     (bee_range_tests/same "minimum is excluded" []
       tree.range_rev((maybe/some ($u 0)) 40))
     (bee_range_tests/same "cursor below all auras" []
       tree.range_rev((maybe/some ($ds 0)) 40))]

  + aura_order
    \ ignored=unit
    ^ row[testing/check]
    = empty=bee[nat] (bee/leaf[nat] [])
      tree | empty.put(($u 2) 20).put(($ts "b") 2).put(($u 1) 10)
      tree | tree.put(($ta "z") 26).put(($ts "a") 1)
      signed | empty.put(($s 9) 9).put(($s 1) 1).put(($s 0) 0).put(($s 2) 2)
    [(bee_range_tests/same "mixed auras follow iota order" [20 10 2 1 26]
       tree.range_rev(.none 40))
     (bee_range_tests/same "text cursor is structural and exclusive" [1 26]
       tree.range_rev((maybe/some ($ts "b")) 40))
     (bee_range_tests/same "absent text cursor" [1 26]
       tree.range_rev((maybe/some ($ts "aa")) 40))
     (bee_range_tests/same "signed keys use decoded ordering" [2 0 1 9]
       signed.range_rev(.none 40))]

  + traverse_guards
    \ ignored=unit
    ^ row[testing/check]
    ' These are behavioral traversal guards, not timing assertions:
    ' a full tap/reverse/take or tap/drop implementation must throw.
    = low (bee/k[nat] (pin (bee/leaf[nat]
        [(uon/kv[nat] ($u 1) 1) (uon/kv[nat] ($u 8) 8)])))
      high (bee/k[nat] (pin (bee/leaf[nat]
        [(uon/kv[nat] ($u 9) 9) (uon/kv[nat] ($u 10) 10)])))
      no_older=bee[nat] (bee/limb[nat] 4 [($u 9)]
        [(bee_range_tests/missing_link 91) high])
      no_newer=bee[nat] (bee/limb[nat] 4 [($u 9)]
        [low (bee_range_tests/missing_link 92)])
      dead=bee[nat] (bee/limb[nat] 0 [($u 9)]
        [(bee_range_tests/missing_link 93) (bee_range_tests/missing_link 94)])
      roots=row[bee[nat]] []
    [(bee_range_tests/same "filled page never reads older siblings" [10 9]
       no_older.range_rev(.none 2))
     (bee_range_tests/same "cursor skips newer siblings" [8 1]
       no_newer.range_rev((maybe/some ($u 9)) 2))
     (bee_range_tests/same "zero cached size skips every child" []
       dead.range_rev(.none 40))
     (bee_range_tests/same "zero limit does not inspect the tree" []
       (bee/range_rev[nat] .none 0 roots.at((Throw 95))))]

  + guarded_tree
    \ code=nat
    ^ bee[nat]
    = high (bee/k[nat] (pin (bee/leaf[nat] [(uon/kv[nat] ($u 10) 10)])))
    | bee/limb[nat] 2 [($u 10)] [(bee_range_tests/missing_link code) high]

  + full_scan
    \ code=nat
    ^ row[uon/kv[nat]]
    | bee/tap[nat] (bee_range_tests/guarded_tree code)

  + larger_page
    \ code=nat
    ^ row[uon/kv[nat]]
    | bee/range_rev[nat] .none 2 (bee_range_tests/guarded_tree code)

  + guard_controls
    \ ignored=unit
    ^ row[testing/check]
    = full_scan (Try bee_range_tests/full_scan 96)
      larger_page (Try bee_range_tests/larger_page 97)
    [(testing/nat "control: a full tap reaches the throwing child" 1
       (either/is_err full_scan))
     (testing/nat "control: a larger page needs the throwing child" 1
       (either/is_err larger_page))]

  + large
    \ ignored=unit
    ^ row[testing/check]
    = tree | bee_range_tests/seq 10000
      lookahead | tree.range_rev .none 41
      first | lookahead.take 40
      cursor | maybe/some first.at(39).key
      second | tree.range_rev cursor 41
      grown | tree.put(($u 10000) 10000).put(($u 10001) 10001)
      removed | tree.del2 ($u 9960)
      expected | (row/range 9959 10000).rev
      boundaries=row[nat] [8 16 72 80 512 648 1000 5832 9992]
    [(testing/nat "10k tree count" 10000 tree.size)
     (bee_range_tests/same "limit + 1 is bounded newest lookahead" expected lookahead)
     (testing/nat "page has one lookahead item" 41 lookahead.len)
     (testing/nat "first cursor excludes the last displayed key" 9959 second.at(0).val)
     (testing/nat "second page exact limit" 41 second.len)
     (testing/nat "second page last key" 9919 second.at(40).val)
     (testing/nat "newer inserts do not shift an exclusive older page" 1
       (equal second grown.range_rev(cursor 41)))
     (testing/nat "absent deleted cursor still seeks correctly" 1
       (equal second removed.range_rev(cursor 41)))
     (bee_range_tests/same "first key boundary returns empty" []
       tree.range_rev((maybe/some ($u 0)) 41))
     (bee_range_tests/same "cursor near earliest key" [2 1 0]
       tree.range_rev((maybe/some ($u 3)) 41))
     (testing/nat "cursor boundaries across tree levels" 1
       (row/all[nat]
         (\ cursor=nat
           (equal (row/range (sub cursor 41) cursor).rev
             (bee_range_tests/values tree.range_rev((maybe/some ($u cursor)) 41))))
         boundaries))]

  + all_pages
    \ ignored=unit
    ^ row[testing/check]
    = tree | bee_range_tests/seq 257
      rows
        % before=maybe[iota] .none out=row[uon/kv[nat]] []
        = page | tree.range_rev before 17
        ? (eq page.len 0) out
        | _ (maybe/some page.at(page.len.dec).key) out.weld(page)
      trimmed
        % n=nat 1 acc=bee[nat] tree
        ? (eq n 250) acc
        | _ n.inc acc.del2(($u n))
    [(bee_range_tests/same "every key appears exactly once across pages"
       (row/range 0 257).rev rows)
     (bee_range_tests/same "lazy deletion skips empty interior branches"
       [256 255 254 253 252 251 250 0] trimmed.range_rev(.none 40))
     (bee_range_tests/same "cursor can seek through empty branches"
       [0] trimmed.range_rev((maybe/some ($u 200)) 40))]

+ tests
  ^ row[testing/case]
  [(testing/case "range boundaries" bee_range_tests/edge_cases)
   (testing/case "iota ordering" bee_range_tests/aura_order)
   (testing/case "bounded traversal guards" bee_range_tests/traverse_guards)
   (testing/case "traversal guard positive controls" bee_range_tests/guard_controls)
   (testing/case "10k cursor pages" bee_range_tests/large)
   (testing/case "complete pagination and lazy deletion" bee_range_tests/all_pages)]
