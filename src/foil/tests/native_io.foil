- testing

+ native_io_tests
  + failure
    : code=nat

  + caught
    \ ignored=unit
    ^ row[testing/check]
    = success | Try (\ n=nat n.inc) 41
      failure | Try (\ n=nat | error (native_io_tests/failure n)) 7
      deep | Try (\ n=nat [n (Throw n)]) 9
      value=nat
        ? success
         > (./ok n) n
         > (./err _) 0
      code=nat
        ? failure
         > (./err e)
          ? (equal[any] e (native_io_tests/failure 7)) 7
          0
         > (./ok _) 0
    [(testing/nat "Try success" 42 value)
     (testing/nat "Try retains thrown value" 7 code)
     (testing/nat "Try forces nested results" 1 (either/is_err deep))
     (testing/text "Seq preserves result type" "ok" (Seq[str] 0 "ok"))
     (testing/text "DeepSeq preserves result type" "ok" (DeepSeq[str] [1 2] "ok"))]

  + clock
    \ ignored=unit
    ^ row[testing/check]
    = ;before (Now 0)
    ; (Sleep 0)
    = ;after (Now 0)
    [(testing/nat "clock advances monotonically during probe" 1 (ge after before))]

  + fetch
    \ ignored=unit
    ^ row[testing/check]
    '  Invalid empty method/url and zero deadline: no network transfer.
    = ;result (Fetch [1 1 [] []] [[] 0 0 [1024]])
    [(testing/nat "Fetch returns typed error" 1 (either/is_err result))]

  + files
    \ ignored=unit
    ^ row[testing/check]
    = ;contents (ReadFile "foil/tests/native_io.foil")
      ;entries (ReadFolder "foil/tests")
      ;stamp (Stamp "foil/tests/native_io.foil")
    [(testing/nat "ReadFile returns bytes" 1 (gt contents 1))
     (testing/nat "ReadFolder returns typed rows" 1
       (row/any[[directory=nat name=str]]
         (\ [directory name] (equal[str] name "native_io.foil")) entries))
     (testing/nat "Stamp returns modification time" 1 (gt stamp 0))]

  + roundtrip
    '  The host test supplies a temporary filename and loopback server port.
    \ filename=str port=nat
    ^ row[testing/check]
    = ;written (WriteFile filename 65601)
      ;contents (ReadFile filename)
      ;fd (Connect 0 "127.0.0.1" port)
    ; (Write fd 65601)
    = ;reply (Read fd 2)
    ; (CloseFd fd)
    = ;listener (Listen 0)
    ; (CloseFd listener)
    = ;zone (ZoneStart "foil-native-io-test")
    ; (ZoneEnd zone)
    ; (Output 1)
    ; (Warn 1)
    ; (Print "")
    [(testing/nat "WriteFile success" 1 written)
     (testing/nat "file preserves trailing NUL" 65601 contents)
     (testing/nat "socket preserves trailing NUL" 65601 reply)]

  + accept
    \ port=nat
    ^ nat
    = ;listener (Listen port)
      ;fd (Accept listener)
      ;bytes (Read fd 2)
    ; (Write fd bytes)
    ; (CloseFd fd)
    ; (CloseFd listener)
    bytes

  + fetch_response
    \ method=nat url=nat
    ^ row[testing/check]
    = ;result (Fetch [method url [] []] [[] 5000 0 [1024]])
    ? result
     > (./ok response)
      = [status final_url headers body] response
      [(testing/nat "Fetch success status" 200 status)
       (testing/nat "Fetch response preserves trailing NUL" 65601 body)]
     > (./err code)
      [(testing/nat "Fetch succeeds" 0 code)]

  + worker
    \ self=nat
    ^ nat
    = ;[message caps] (Recv[nat] 0)
      ;result (Fetch [1 1 [] []] [[] 0 0 [1024]])
      ;caught (Try (\ n=nat (Throw n)) message)
    ; (Send caps.at(0) [(either/is_err result) (either/is_err caught)])
    | CloseHandle caps.at(0)

  + actor
    \ ignored=unit
    ^ row[testing/check]
    = ;child (Spawn native_io_tests/worker)
    ; (SendCaps child 7 [0])
    = ;[reply caps] (Recv[row[nat]] 0)
    ; (CloseHandle child)
    [(testing/nat "Fetch works inside a foot" 1 reply.at(0))
     (testing/nat "Try works inside a foot" 1 reply.at(1))]

+ tests
  ^ row[testing/case]
  [(testing/case "native exception boundary" native_io_tests/caught)
   (testing/case "native clock" native_io_tests/clock)
   (testing/case "native Fetch validation" native_io_tests/fetch)
   (testing/case "native file reads" native_io_tests/files)
   (testing/case "native operations in actors" native_io_tests/actor)]
