- tests/namespace [at=fixture]
- tests/composition [at=fixture]
- lain_peek
- testing

+ publication_tests
  + commit
    \ target=path record=myth state=namespace
    ^ namespace
    = changes (axal/new[note] .none).put(target (note/make record))
    ?> (./accepted result) (namespace/step changes 0 0 state) state
    result.state
  + number
    \ address=path state=namespace
    ^ nat
    ?> (./known tree) (sovereign_view .x 0 address state) 0
    ?> (./some record) tree.fil 0
    ?> (./some held) record.get(system_vocabulary/content) 0
    | fixture/namespace_tests/unwrap held
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = cell_root=path [($x 1) 'policy_view]
      output=path ['x ($x 1) 'policy_view]
      policy=path ['sys 'types 'text]
      definition (myth/sing bond/weft (cell fixture/composition_tests/identity)).put(bond/tack (safe 0 .x policy))
      original (publication_tests/commit cell_root definition fixture/namespace_tests/initial)
      pinned (fixture/composition_tests/pinned original.local.top output)
      shared (fixture/namespace_tests/seed policy 99 (unpin original.system).state)
      replacement (pin (system_publication shared.top shared (system_publication/assigned shared)))
      changed (publication_tests/commit [($x 1) 'notice] myth/new original.set_system(replacement))
      latest (fixture/composition_tests/pinned changed.local.top output)
      raw fixture/namespace_tests/initial
      freeze (sovereign_reader raw).freeze
      missing_publication (freeze raw.local.top)
      system_epoch=iota ($ts (str/cat_all ["e" shared.top.show]))
      system_snapshot=path ['h 'x system_epoch ($u policy.len)]
      system_snapshot system_snapshot.weld(policy)
      raw_physical (fixture/composition_tests/pinned raw.local.top [($x 1) 'app 'demo])
      stamp_root=path [($x 1) 'historical_stamp]
      stamped (publication_tests/commit stamp_root
        (myth/sing bond/weft (cell fixture/composition_tests/stamp)).put(bond/tack (safe 0 .x system_snapshot)) changed)
      stamp=nat
        ?> (./known tree) (sovereign_view .x 0 (row/cons[iota] 'x stamp_root) stamped) 999
        | tree.fil.fall(myth/new).nat_at(['value] 999)
    [(testing/nat "live view uses selected system publication" 99 (publication_tests/number output changed))
     (testing/nat "historical computation retains its system publication" 11 (publication_tests/number pinned changed))
     (testing/nat "later pin retains the replacement system publication" 99 (publication_tests/number latest changed))
     (testing/nat "a missing historical publication cannot fall back to current system" 1
       (?=(.none missing_publication)))
     (testing/nat "physical system history uses the system authority epoch" 99
       (publication_tests/number system_snapshot changed))
     (testing/nat "physical local history needs no executable publication recovery" 22
       (publication_tests/number raw_physical raw))
     (testing/nat "explicit system historical input carries the constant historical-view case" 1 stamp)]

+ tests
  ^ row[testing/case]
  [(testing/case "complete local computation snapshot" publication_tests/checks)]
