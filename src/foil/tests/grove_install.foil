- grove_install
- eden
- tests/namespace [at=fixture]

+ grove_install_checks
  + bootstrap
    \ ignored=unit
    ^ namespace
    = fixture fixture/namespace_tests/initial
    ? (eden/boot ($x 17) fixture.system sov/new 18131)
     > (./ok state) state
    fixture/namespace_tests/initial
  + check
    \ records=row[[path myth]]
    ^ either[iota nat]
    = source=path [($x 17) 'gov 'srs]
      root=path [($x 17) 'app 'one]
      other=path [($x 17) 'app 'two]
      state (grove_install_checks/bootstrap [])
    < published (grove_install/mount source records state)
    ?> (./some version) published.case(.x source)
      | ./err 'missing_template
    < first (grove_install/instantiate source version root published)
    < mounted (grove_install/instantiate source version other first)
    ?> (./known original) (sovereign_view .x 0 source published)
      | ./err 'missing_published_template
    ?> (./known unchanged) (sovereign_view .x 0 source mounted)
      | ./err 'missing_shared_template
    ? !(equal original unchanged) (./err 'template_was_modified)
    ? (sovereign_view .x 0 [($x 17) 'app 'one 'grade] mounted)
     > (./known _) (./err 'copied_definition)
    ?> (./known next) (sovereign_view .x 0 [($x 17) 'app 'one 'next] mounted)
      | ./err 'missing_instance_view
    ?> (./some held) next.fil.fall(myth/new).get(['sys 'weft])
      | ./err 'missing_weft
    ?> code=safe held (./err 'invalid_weft)
    ? !(equal[path] code.path [($x 17) 'gov 'srs 'queue])
      | ./err 'definition_reference_rebased
    ?> (./some held) next.fil.fall(myth/new).get(['sys 'tack])
      | ./err 'missing_tack
    ?> input=safe held (./err 'invalid_tack)
    ? !(equal[path] input.path [($x 17) 'app 'one 'cards])
      | ./err 'instance_reference_not_rebased
    ?> (./known result) (sovereign_view .y 0 ['x ($x 17) 'app 'one 'next] mounted)
      | ./err 'missing_queue_view
    ?> (./some card) result.dip([($u 0)]).fil
      | ./err 'missing_queue_card
    ? !(eq card.nat_at([($x 17) 'gov 'srs 'interval] 0) 1)
      | ./err 'definition_slot_rebased
    = update
        | task/vine [($x 17) 'app 'one 'cards 'demo]
          (writ/poke (myth/sing [($x 17) 'gov 'srs 'due] (pails/n 17)))
    = [result index] | sovereign_cycle_with (sovereign_hive mounted) update 0 128 0 0 mounted
    ?> (./spun changed moves rounds ack spill) result
      | ./err 'valid_update_failed
    ? (maybe/is_some spill) (./err 'update_cascade_failed)
    ?> (./known later) (sovereign_view .y 0 ['x ($x 17) 'app 'one 'next] changed)
      | ./err 'missing_updated_view
    ?> (./some updated) later.dip([($u 0)]).fil
      | ./err 'missing_updated_card
    ? !(eq updated.nat_at([($x 17) 'gov 'srs 'due] 0) 17)
      | ./err 'view_pin_did_not_advance
    ?> (./known second) (sovereign_view .y 0 ['x ($x 17) 'app 'two 'next] changed)
      | ./err 'missing_second_view
    ?> (./some other_card) second.dip([($u 0)]).fil
      | ./err 'missing_second_card
    ? !(eq other_card.nat_at([($x 17) 'gov 'srs 'due] 99) 0)
      | ./err 'instances_share_state
    = change
        | task/vine [($x 17) 'app 'one 'cards 'demo]
          (writ/poke (myth/sing [($x 17) 'gov 'srs 'due] (pails/t "bad")))
    ? (sovereign_run_event change 0 0 0 changed)
     > (./ripe next effects signs ack)
      | ./err 'invalid_edit_accepted
     > (./fail reason)
      ? (grove_install/instantiate source version root mounted)
       > (./ok next) (./err 'duplicate_instance_accepted)
       > (./err reason) (./ok 1)
