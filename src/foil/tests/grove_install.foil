- grove_install

+ grove_install_checks
  + bootstrap
    \ ignored=unit
    ^ sov
    = commands=row[task]
        [(task/vine ['pact]
          (writ/make (form/card pact/form (lore/line "Pact"))))
         (task/vine ['kook 'ward]
          (writ/make (form/card ward/form (lore/line "Ward"))))
         (task/vine ['kook 'fresh]
          (writ/make (form/card fresh/form (lore/line "Fresh"))))]
    | commands.fold sov/new
    \ state command
    ? (run_event command 0 state)
     > (./ripe next effects signs ack) next
    state
  + check
    \ records=row[[path myth]]
    ^ either[iota nat]
    = source=path ['gov 'srs]
      root=path ['app 'one]
      other=path ['app 'two]
      state (grove_install_checks/bootstrap [])
    < published (grove_install/mount source records state)
    ?> (./some version) published.x_case(source)
      | ./err 'missing_template
    < first (grove_install/instantiate source version root published)
    < mounted (grove_install/instantiate source version other first)
    ?> (./known original) published.x_latest(source)
      | ./err 'missing_published_template
    ?> (./known unchanged) mounted.x_latest(source)
      | ./err 'missing_shared_template
    ? !(equal original unchanged) (./err 'template_was_modified)
    ? mounted.x_latest(['app 'one 'grade])
     > (./known _) (./err 'copied_definition)
    ?> (./known next) mounted.x_latest(['app 'one 'next])
      | ./err 'missing_instance_view
    ?> (./some held) next.get(['sys 'weft])
      | ./err 'missing_weft
    ?> code=safe held (./err 'invalid_weft)
    ? !(equal[path] code.path ['gov 'srs 'queue])
      | ./err 'definition_reference_rebased
    ?> (./some held) next.get(['sys 'tack])
      | ./err 'missing_tack
    ?> input=safe held (./err 'invalid_tack)
    ? !(equal[path] input.path ['app 'one 'cards])
      | ./err 'instance_reference_not_rebased
    ?> (./known result) (view .y 0 ['x 'app 'one 'next] mounted)
      | ./err 'missing_queue_view
    ?> (./some card) result.dip([($u 0)]).fil
      | ./err 'missing_queue_card
    ? !(eq card.nat_at(['gov 'srs 'interval] 0) 1)
      | ./err 'definition_slot_rebased
    = update
        | task/vine ['app 'one 'cards 'demo]
          (writ/poke (myth/sing ['gov 'srs 'due] (pails/n 17)))
    ?> (./spun changed moves rounds ack spill)
      (cycle update 0 128 mounted)
      | ./err 'valid_update_failed
    ? (maybe/is_some spill) (./err 'update_cascade_failed)
    ?> (./known later) (view .y 0 ['x 'app 'one 'next] changed)
      | ./err 'missing_updated_view
    ?> (./some updated) later.dip([($u 0)]).fil
      | ./err 'missing_updated_card
    ? !(eq updated.nat_at(['gov 'srs 'due] 0) 17)
      | ./err 'view_pin_did_not_advance
    ?> (./known second) (view .y 0 ['x 'app 'two 'next] changed)
      | ./err 'missing_second_view
    ?> (./some other_card) second.dip([($u 0)]).fil
      | ./err 'missing_second_card
    ? !(eq other_card.nat_at(['gov 'srs 'due] 99) 0)
      | ./err 'instances_share_state
    = change
        | task/vine ['app 'one 'cards 'demo]
          (writ/poke (myth/sing ['gov 'srs 'due] (pails/t "bad")))
    ? (run_event change 0 changed)
     > (./ripe next effects signs ack)
      | ./err 'invalid_edit_accepted
     > (./fail reason)
      ? (grove_install/instantiate source version root mounted)
       > (./ok next) (./err 'duplicate_instance_accepted)
       > (./err reason) (./ok 1)
