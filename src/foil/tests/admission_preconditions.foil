- helm
- tests/namespace [at=fixture]
- testing

+ compat_admission
  + boom
    \ input=myth current=myth
    ^ myth
    | Seq[myth] (error (pails/t "compatibility operation failure")) current
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = original fixture/namespace_tests/initial
      target=path [original.self 'app 'demo]
      key=path ['sys 'if_case]
      current (sovereign_peek target original).fil.fall(myth/new)
      expected original.case(.x target).fall(0)
      stale (myth/sing ['compat 'value] (pails/n 17)).put(key (pails/n expected.inc))
      [bad bi denied] (helm/supervisor/step target (writ/poke stale) 0 0 original (sovereign_hive original))
      rejected=bool
        ?> (./ack failure) denied .false
        | maybe/is_some failure
      fresh (myth/sing ['compat 'value] (pails/n 19)).put(key (pails/n expected))
      [good gi accepted] (helm/supervisor/step target (writ/poke fresh) 0 0 original (sovereign_hive original))
      operation=path [original.self 'gov 'compat_throw]
      law (op 'compat_throw 'record [] 'record 0 compat_admission/boom)
      [ready ri reply] (helm/supervisor/step operation (writ/make (myth/sing bond/op law)) 0 0 original (sovereign_hive original))
      invoke
        \ state=namespace
        ^ bool
        = index (sovereign_hive state)
          [next ni reply] (helm/supervisor/step target (writ/warp operation myth/new) 0 0 state index)
        ?> (./ack failure) reply .false
        | and (maybe/is_some failure) (and (equal[namespace] state next) (equal[hive] index ni))
      contained=bool
        ?> (./ok result) (Try invoke ready) .false
        result
    [(testing/nat "raw stale-case writes refuse atomically" 1 (and rejected (equal[namespace] original bad)))
     (testing/nat "accepted native preconditions are consumed rather than stored" 0
       (sovereign_peek target good).fil.fall(myth/new).has(key))
     (testing/nat "operation exceptions return refusal with original namespace and hive" 1 contained)]

+ tests
  ^ row[testing/case]
  [(testing/case "compatible native admission contracts" compat_admission/checks)]
