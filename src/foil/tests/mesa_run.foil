- eden_store
- helm
- net
- mesa_foot
- mesa_wire
- testing
- tests/namespace [at=fixture]

' These tests run two worlds in one process as real worlds run. Each world is
' a supervisor actor with the foot registered at /io/mesa and with its
' acceptors, senders and clock. The worlds connect through loopback sockets.
' Writes go in through each supervisor, and the test reads them back through
' the other supervisor, by the name that the publisher gave them.
+ run_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (eden_store/changes writes state)
     > (./ok next) next
     > (./err why) state
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + world
    ' It makes a world that runs and gives its supervisor. The world has a
    ' foot that listens on a port, and it has a card for one peer.
    \ n=nat port=nat other=nat other_port=nat
    ^ nat
    = self=iota ($x n)
      ring (str/cat (nat/show n) "mesa_run_ring_")
      mark (str/cat (nat/show n) "mesa_run_mark_")
      home=path [self 'io 'mesa]
      card=path [self 'io 'mesa ($x other)]
      own
        . (myth/sing ['port] (pails/n port))
          put(['ring] (pails/t ring))
          put(['mark] (pails/t mark))
      peer
        . (myth/sing ['key] (pails/n (Ed25519PublicKey (run_tests/seed other))))
          put(['host] (pails/t "127.0.0.1"))
          put(['port] (pails/n other_port))
      writes=row[[p=path q=writ]] [[home (writ/make own)] [card (writ/make peer)]]
      blank (namespace self sov/new (fixture/namespace_tests/initial).system (mop/empty))
      ;saved (WriteFile ring (run_tests/seed n))
      ;server (Spawn (helm/supervisor/run (run_tests/apply writes blank)))
      ;seated (mesa_wire/seat server self)
    ; (SendCaps server (helm/supervisor/register home mesa_wire/run) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    server
  + serve
    ' It makes a supervisor for a state, with the foot registered at its home.
    \ state=namespace
    ^ nat
    = home=path [state.self 'io 'mesa]
      ;server (Spawn (helm/supervisor/run state))
      ;seated (mesa_wire/seat server state.self)
    ; (SendCaps server (helm/supervisor/register home mesa_wire/run) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    server
  + slot
    ' It gives a number kept on a record of a world that runs.
    \ server=nat name=path key=iota
    ^ nat
    ; (SendCaps server (helm/card/peek .y .none name) [0])
    = ;[answer caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? answer
     > (./page pax result)
      ? result
       > (./known tree)
        ? tree.fil
         > (./some version)
          | (unpin version.myth).nat_at [key] 0
        0
      0
    0
  + write
    \ server=nat target=path change=writ
    ^ bool
    ; (SendCaps server (helm/card/step target change) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    | run_tests/accepted reply
  + value
    \ server=nat name=path
    ^ nat
    ; (SendCaps server (helm/card/peek .y .none name) [0])
    = ;[answer caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? answer
     > (./page pax result)
      ? result
       > (./known tree)
        ? tree.fil
         > (./some version)
          | (unpin version.myth).nat_at ['value] 0
        0
      0
    0
  + await
    ' It tells if a name holds a value before a number of seconds pass.
    \ server=nat name=path want=nat seconds=nat
    ^ bool
    % left=nat seconds
    ^ bool
    = ;now (run_tests/value server name)
    ? (eq now want) .true
    ? !(left) .false
    ; (Sleep 1)
    | _ left.dec
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + checks
    \ _=unit
    ^ row[testing/check]
    = ;a (run_tests/world 81 39581 82 39582)
      ;b (run_tests/world 82 39582 81 39581)
      a_root=path [($x 81) 'our ($x 82)]
      a_doc=path [($x 81) 'our ($x 82) 'doc]
      b_root=path [($x 82) 'our ($x 81)]
      b_reply=path [($x 82) 'our ($x 81) 'reply]
      ;made (run_tests/write a a_root (writ/make (run_tests/rec 1)))
      ;first (run_tests/write a a_doc (writ/make (run_tests/rec 10)))
      ;arrived (run_tests/await b a_doc 10 30)
      ;second (run_tests/write a a_doc (writ/poke (run_tests/rec 11)))
      ;changed (run_tests/await b a_doc 11 30)
      ;back_root (run_tests/write b b_root (writ/make (run_tests/rec 1)))
      ;back (run_tests/write b b_reply (writ/make (run_tests/rec 77)))
      ;returned (run_tests/await a b_reply 77 30)
      ;gone (run_tests/write a a_doc .cull)
      ;removed (run_tests/await b a_doc 0 30)
      a_foot=path [($x 81) 'io 'mesa]
      b_foot=path [($x 82) 'io 'mesa]
      stop (myth/sing ['stop] (pails/n 1))
      ;stop_a (run_tests/write a a_foot (writ/poke stop))
      ;stop_b (run_tests/write b b_foot (writ/poke stop))
    ; (Sleep 4)
    ; (CloseHandle a)
    ; (CloseHandle b)
    [(testing/nat "the publisher takes its writes" 1 (and made first))
     (testing/nat "a record crosses between two running worlds" 1 arrived)
     (testing/nat "a change crosses" 1 changed)
     (testing/nat "the other direction too" 1 (and (and back_root back) returned))
     (testing/nat "a removal crosses" 1 (and gone removed))
     (testing/nat "a foot stops when its record says to" 1 (and stop_a stop_b))]

+ tests
  ^ row[testing/case]
  [(testing/case "two running worlds over loopback" run_tests/checks)]
