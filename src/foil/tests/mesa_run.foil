- helm
- net
- pass
- mesa_foot
- mesa_wire
- testing
- tests/namespace [at=fixture]

' Two worlds in one process as they really run: each a supervisor actor
' with the foot registered at /io/mesa, its acceptors, senders and clock,
' talking over loopback sockets. Writes go in through each supervisor and
' are read back through the other.
+ run_tests
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack err)
      ? err
       > .none .true
       > (./some _) .false
    .false
  + world
    ' A running world: its supervisor, with a foot that listens on a port
    ' and a card for one peer.
    \ n=nat port=nat other=nat other_port=nat
    ^ nat
    = self=iota ($x n)
      ring (str/cat (nat/show n) "mesa_run_ring_")
      mark (str/cat (nat/show n) "mesa_run_mark_")
      home=path [self 'io 'mesa]
      card=path [self 'io 'mesa ($x other)]
      own
        . (myth/sing ['port] (pails/n port))
          put(['ring] (pails/t ring))
          put(['mark] (pails/t mark))
      peer
        . (myth/sing ['key] (pails/n (Ed25519PublicKey (run_tests/seed other))))
          put(['host] (pails/t "127.0.0.1"))
          put(['port] (pails/n other_port))
      writes=row[[p=path q=writ]] [[home (writ/make own)] [card (writ/make peer)]]
      blank (namespace self sov/new (fixture/namespace_tests/initial).system)
      ;saved (WriteFile ring (run_tests/seed n))
      ;server (Spawn (helm/supervisor/run (run_tests/apply writes blank)))
    ; (SendCaps server (helm/supervisor/register home mesa_wire/run .true) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    server
  + serve
    ' A supervisor for a state, with the foot registered at its home.
    \ state=namespace
    ^ nat
    = home=path [state.self 'io 'mesa]
      ;server (Spawn (helm/supervisor/run state))
    ; (SendCaps server (helm/supervisor/register home mesa_wire/run .true) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    server
  + slot
    ' A number kept on a record of a running world.
    \ server=nat name=path key=iota
    ^ nat
    ; (SendCaps server (helm/card/peek .y .none name) [0])
    = ;[answer caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? answer
     > (./page pax result)
      ? result
       > (./known tree)
        ? tree.fil
         > (./some version)
          | (unpin version.myth).nat_at [key] 0
        0
      0
    0
  + found
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) result state
    | run_tests/apply writes state
  + write
    \ server=nat target=path change=writ
    ^ bool
    ; (SendCaps server (helm/card/step target change) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    | run_tests/accepted reply
  + value
    \ server=nat name=path
    ^ nat
    ; (SendCaps server (helm/card/peek .y .none name) [0])
    = ;[answer caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? answer
     > (./page pax result)
      ? result
       > (./known tree)
        ? tree.fil
         > (./some version)
          | (unpin version.myth).nat_at ['value] 0
        0
      0
    0
  + await
    ' Whether a name comes to hold a value within some seconds.
    \ server=nat name=path want=nat seconds=nat
    ^ bool
    % left=nat seconds
    ^ bool
    = ;now (run_tests/value server name)
    ? (eq now want) .true
    ? !(left) .false
    ; (Sleep 1)
    | _ left.dec
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + checks
    \ _=unit
    ^ row[testing/check]
    = ;a (run_tests/world 81 39581 82 39582)
      ;b (run_tests/world 82 39582 81 39581)
      a_root=path [($x 81) 'our ($x 82)]
      a_doc=path [($x 81) 'our ($x 82) 'doc]
      b_doc=path [($x 82) 'her ($x 81) 'doc]
      b_root=path [($x 82) 'our ($x 81)]
      b_reply=path [($x 82) 'our ($x 81) 'reply]
      a_reply=path [($x 81) 'her ($x 82) 'reply]
      ;made (run_tests/write a a_root (writ/make (run_tests/rec 1)))
      ;first (run_tests/write a a_doc (writ/make (run_tests/rec 10)))
      ;arrived (run_tests/await b b_doc 10 30)
      ;second (run_tests/write a a_doc (writ/poke (run_tests/rec 11)))
      ;changed (run_tests/await b b_doc 11 30)
      ;back_root (run_tests/write b b_root (writ/make (run_tests/rec 1)))
      ;back (run_tests/write b b_reply (writ/make (run_tests/rec 77)))
      ;returned (run_tests/await a a_reply 77 30)
      ;gone (run_tests/write a a_doc .cull)
      ;removed (run_tests/await b b_doc 0 30)
      a_foot=path [($x 81) 'io 'mesa]
      b_foot=path [($x 82) 'io 'mesa]
      stop (myth/sing ['stop] (pails/n 1))
      ;stop_a (run_tests/write a a_foot (writ/poke stop))
      ;stop_b (run_tests/write b b_foot (writ/poke stop))
    ; (Sleep 4)
    ; (CloseHandle a)
    ; (CloseHandle b)
    [(testing/nat "the publisher takes its writes" 1 (and made first))
     (testing/nat "a record crosses between two running worlds" 1 arrived)
     (testing/nat "a change crosses" 1 changed)
     (testing/nat "the other direction too" 1 (and (and back_root back) returned))
     (testing/nat "a removal crosses" 1 (and gone removed))
     (testing/nat "a foot stops when its record says to" 1 (and stop_a stop_b))]
  + rotation
    ' A world founded under a name with an identity log, run by a host, and
    ' a peer introduced to it by that log. The claim arrives at the world's
    ' own port as a packet that only carries it; the world's ring file
    ' already holds the claimant's seed. The running foot moves to the new
    ' key, and the peer follows from a hint.
    \ _=unit
    ^ row[testing/check]
    = secret (run_tests/seed 900)
      host (run_tests/seed 1)
      own (run_tests/seed 50)
      fresh (run_tests/seed 2)
      made (pass/mint secret 0 (Ed25519PublicKey host))
      name made.name
      a_self=iota ($x name)
      b_self=iota ($x 84)
      a_home=path [a_self 'io 'mesa]
      b_home=path [b_self 'io 'mesa]
      a_card=path [a_self 'io 'mesa b_self]
      b_card=path [b_self 'io 'mesa a_self]
      first=row[pass/statement] [made.first]
      a_ring=str "mesa_run_ring_named"
      b_ring=str "mesa_run_ring_84"
      a_own
        . (myth/sing ['port] (pails/n 39583))
          put(['ring] (pails/t a_ring))
          put(['mark] (pails/t "mesa_run_mark_named"))
      b_own
        . (myth/sing ['port] (pails/n 39584))
          put(['ring] (pails/t b_ring))
          put(['mark] (pails/t "mesa_run_mark_84"))
      to_b
        . (myth/sing ['key] (pails/n (Ed25519PublicKey (run_tests/seed 84))))
          put(['host] (pails/t "127.0.0.1"))
          put(['port] (pails/n 39584))
      to_a
        . (myth/sing ['host] (pails/t "127.0.0.1"))
          put(['port] (pails/n 39583))
      a_writes=row[[p=path q=writ]] [[a_home (writ/make a_own)] [a_card (writ/make to_b)]]
      b_writes=row[[p=path q=writ]] [[b_home (writ/make b_own)]]
      b_reach=row[[p=path q=writ]] [[b_card (writ/poke to_a)]]
      a0 (run_tests/apply a_writes (namespace a_self sov/new (fixture/namespace_tests/initial).system))
      a1 (run_tests/found (pass/meet a_home made.made first a0) a0)
      b0 (run_tests/apply b_writes (namespace b_self sov/new (fixture/namespace_tests/initial).system))
      b1 (run_tests/found (pass/meet b_card made.made first b0) b0)
      b2 (run_tests/apply b_reach b1)
      ;ring_a (WriteFile a_ring host)
      ;ring_b (WriteFile b_ring (run_tests/seed 84))
      ;a (run_tests/serve a1)
      ;b (run_tests/serve b2)
      root=path [a_self 'our b_self]
      doc=path [a_self 'our b_self 'doc]
      b_doc=path [b_self 'her a_self 'doc]
      ;made_root (run_tests/write a root (writ/make (run_tests/rec 1)))
      ;made_doc (run_tests/write a doc (writ/make (run_tests/rec 10)))
      ;arrived (run_tests/await b b_doc 10 30)
      one=row[pass/statement] [made.first]
      at1
        ? (pass/read name made.made one)
         > (./err why) (pass/standing 0 0 0 0 0 0)
         > (./ok at) at
      claimed (pass/claim secret name at1 (Ed25519PublicKey own) (Ed25519PublicKey fresh))
      nothing (MesaName 104 0 0 0)
      packets=row[nat] [(MesaHint name name nothing nothing (pass/sent claimed) mesa_foot/limits)]
      ;ring_new (WriteFile a_ring fresh)
      ;delivered (SendTo 0 "127.0.0.1" 39583 (mesa_wire/frames name packets))
      ;changed (run_tests/write a doc (writ/poke (run_tests/rec 11)))
      ;followed (run_tests/await b b_doc 11 60)
      ;a_key (run_tests/slot a a_home 'key)
      ;b_key (run_tests/slot b b_card 'key)
      stop (myth/sing ['stop] (pails/n 1))
      ;stop_a (run_tests/write a a_home (writ/poke stop))
      ;stop_b (run_tests/write b b_home (writ/poke stop))
    ; (Sleep 4)
    ; (CloseHandle a)
    ; (CloseHandle b)
    [(testing/nat "before the claim the peer reads what the host serves" 1 arrived)
     (testing/nat "the claim is delivered to the world's own port" 1 delivered)
     (testing/nat "the running world's card moves to the claimant's key" 1 (eq a_key (Ed25519PublicKey fresh)))
     (testing/nat "the peer's card follows" 1 (eq b_key (Ed25519PublicKey fresh)))
     (testing/nat "and what the claimed world publishes next arrives" 1 followed)]

+ tests
  ^ row[testing/case]
  [(testing/case "two running worlds over loopback" run_tests/checks)
   (testing/case "a running world is claimed and its peer follows" run_tests/rotation)]
