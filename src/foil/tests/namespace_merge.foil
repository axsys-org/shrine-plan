- namespace
- tests/namespace [at=fixture]
- stdlib/base

+ namespace_merge_tests
  + same
    \ raw=axal[note] derived=axal[note]
    ^ bool
    = former=axal[note]
        | derived.tap.fold raw
        \ out [name change]
        | out.put name change
    | equal[axal[note]] former (namespace/merge_notes raw derived)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = empty (axal/new[note] .none)
      raw (empty.put(['a] (note/make (fixture/namespace_tests/record 1)))).put(['parent] .cull)
      derived ((empty.put(['a] (note/make (fixture/namespace_tests/record 2)))).put(['parent 'child] .cull)).put(['only_derived] (note/make (fixture/namespace_tests/record 3)))
      bulk=axal[note]
        % i=nat 0 out=axal[note] derived
        ^ axal[note]
        ? (eq i 256) out
        | _ i.inc out.put(['idx ($u i)] (note/make (fixture/namespace_tests/record i)))
    [(testing/nat "raw only" 1 (namespace_merge_tests/same raw empty))
     (testing/nat "derived only" 1 (namespace_merge_tests/same empty derived))
     (testing/nat "derived conflict precedence and ancestor culls" 1 (namespace_merge_tests/same raw derived))
     (testing/nat "large index batch preserves all source and derived notes" 1 (namespace_merge_tests/same raw bulk))]

+ tests
  ^ row[testing/case]
  [(testing/case "Index note merge compatibility" namespace_merge_tests/checks)]
