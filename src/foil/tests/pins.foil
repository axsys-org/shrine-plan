- helm
- testing

' These tests are for pins as values. The runtime names a pin by the SHA-256
' of its canonical stream. With these operations, kernel code can read that
' name, get the stream and make the pin again from the stream. Thus a value
' can leave one store and arrive in another store as the same pin. A signature
' is made over the hash of a pin.
+ pin_tests
  + rec
    \ v=nat
    ^ myth
    | myth/sing ['value] (pails/n v)
  + reload
    \ stream=nat
    ^ maybe[pin[myth]]
    | PinFrom stream
  + pair
    \ stream=nat
    ^ maybe[pin[row[pin[myth]]]]
    | PinFrom stream
  + value
    \ found=maybe[pin[myth]]
    ^ nat
    ?> (./some held) found 0
    | (unpin held).nat_at(['value] 0)
  + same
    ' It tells if a pin that was made again has the expected hash.
    \ hash=nat found=maybe[pin[myth]]
    ^ nat
    ?> (./some held) found 0
    | eq hash (PinHash held)
  + checks
    \ _=unit
    ^ row[testing/check]
    = pa (pin (pin_tests/rec 7))
      pb (pin (pin_tests/rec 8))
      again (pin (pin_tests/rec 7))
      ha (PinHash pa)
      stream (PinBytes pa)
      back (pin_tests/reload stream)
      both=row[pin[myth]] [pa pb]
      outer (pin both)
      outer_back (pin_tests/pair (PinBytes outer))
      part
        ?> (./some held) outer_back 0
        | eq ha (PinHash (unpin held).at(0))
      whole
        ?> (./some held) outer_back 0
        | eq (PinHash outer) (PinHash held)
      w32 4294967296
      w64 (mul w32 w32)
      w256 (mul (mul w64 w64) (mul w64 w64))
      seed (add w256 12345)
      key (Ed25519PublicKey seed)
      sig (Ed25519Sign seed ha)
      bent (pin_tests/reload (add stream w64))
      named (PinNames (PinBytes outer))
      held (PinParts outer)
      inner
        ? (lt held.len 1) 0
        | eq ha (PinHash held.at(0))
    [(testing/nat "equal values have one hash" 1 (eq ha (PinHash again)))
     (testing/nat "different values have different hashes" 0 (eq ha (PinHash pb)))
     (testing/nat "the hash is the SHA-256 of the stream" 1 (eq ha (Sha256 stream)))
     (testing/nat "a stream rebuilds the pin under the same hash" 1 (pin_tests/same ha back))
     (testing/nat "with the same value" 7 (pin_tests/value back))
     (testing/nat "a value holding pins names them and rebuilds" 1 whole)
     (testing/nat "and its parts are the same pins" 1 part)
     (testing/nat "a changed stream does not rebuild this pin" 0 (pin_tests/same ha bent))
     (testing/nat "a stream names the pins it holds" 2 named.len)
     (testing/nat "by their hashes" 1 (eq ha named.at(0)))
     (testing/nat "a stream that holds none names none" 0 (PinNames stream).len)
     (testing/nat "a pin gives the pins it holds" 2 held.len)
     (testing/nat "the same ones" 1 inner)
     (testing/nat "a signature over a pin's hash verifies" 1 (Ed25519Verify key ha sig))
     (testing/nat "and does not verify over another" 0 (Ed25519Verify key (PinHash pb) sig))]

+ tests
  ^ row[testing/case]
  [(testing/case "pins as values" pin_tests/checks)]
