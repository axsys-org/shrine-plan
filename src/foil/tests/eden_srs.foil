- eden_srs

+ eden_srs_checks
  + atomic_install
    \ build=eden_srs/build
    ^ bool
    ?> (./ready state) (eden/boot 18131) .false
    ' Fail the last mount after both dependency batches have succeeded.
    = bad
        | eden_srs/build build.slots build.types
            (eden_srs/batch build.slots.root build.srs.records)
    ? (eden_srs/publish bad state)
     > (./ok next) .false
     > (./err cause)
      ? (eden_srs/publish build state)
       > (./ok next) .true
       > (./err cause) .false
  + instance_install
    \ build=eden_srs/build
    ^ bool
    ?> (./ok state) (eden_srs/boot 18131 build) .false
    = source=path ['gov 'srs]
      target=path ['app 'srs]
    ?> (./some version) state.x_case(source) .false
    ?> (./known _) state.x_latest(['gov 'srs 'queue]) .false
    ? state.x_latest(['gov 'srs 'cards 'demo])
     > (./known _) .false
    = index (hive_of state)
      [same same_index denied]
        | helm/supervisor/handle
            (helm/card/install source version.inc target) state index
    ? !(equal same state) .false
    ? !(equal same_index index) .false
    = [next next_index reply]
        | helm/supervisor/handle
            (helm/card/install source version target) state index
    ?> (./ack err) reply .false
    ? (maybe/is_some err) .false
    ?> (./known _) next.x_latest(['app 'srs 'cards 'demo]) .false
    ?> (./some after) next.x_case(source) .false
    ? !(eq version after) .false
    = [again unchanged rejected]
        | helm/supervisor/handle
            (helm/card/install source version target) next next_index
    ? !(equal again next) .false
    = [second second_index answer]
        | helm/supervisor/handle
            (helm/card/install source version ['app 'second])
            next next_index
    ?> (./ack err) answer .false
    | !(maybe/is_some err)
