- eden_srs

+ eden_srs_checks
  + instance_install
    \ state=namespace
    ^ bool
    = source=path [state.self 'gov 'srs]
      target=path [state.self 'app 'srs]
      types=path [state.self 'lib 'grove 'types]
    ?> (./some system_path) (sovereign_peek ['sys 'types 'path] state).fil .false
    ?> (./some resolved_system) (eden_srs/lookup types state ['sys 'types 'path]) .false
    ? !(equal[myth] system_path resolved_system) .false
    ?> (./some codec) (sovereign_peek types.snoc('path) state).fil .false
    ?> (./some resolved_codec) (eden_srs/lookup types state ['codecs 'path]) .false
    ? !(equal[myth] codec resolved_codec) .false
    ?> (./some version) state.case(.x source) .false
    ?> (./some queue) (sovereign_peek source.snoc('queue) state).fil .false
    ? (maybe/is_some (sovereign_peek source.weld(['cards 'demo]) state).fil)
      .false
    = index (sovereign_hive state)
      [same same_index denied]
        | helm/supervisor/handle
            (helm/card/install source version.inc target) state index
    ? !(equal same state) .false
    ? !(equal same_index index) .false
    = [next next_index reply]
        | helm/supervisor/handle
            (helm/card/install source version target) state index
    ?> (./ack err) reply .false
    ? (maybe/is_some err) .false
    ?> (./some card) (sovereign_peek target.weld(['cards 'demo]) next).fil .false
    ?> (./some after) next.case(.x source) .false
    ? !(eq version after) .false
    = [again unchanged rejected]
        | helm/supervisor/handle
            (helm/card/install source version target) next next_index
    ? !(equal again next) .false
    = [second second_index answer]
        | helm/supervisor/handle
            (helm/card/install source version [state.self 'app 'second])
            next next_index
    ?> (./ack err) answer .false
    | !(maybe/is_some err)
