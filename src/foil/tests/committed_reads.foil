- namespace
- tests/cells [at=fixture]

+ committed_reads
  + record
    ^ myth
    | myth/sing '/value (pails/n 7)

  + assertion
    ' Nonzero sentinels detect accidental loss or reconstruction.
    ^ saga
    | saga
      | aeon (yuga (lock 3 1) (lock 5 2) (lock 8 4) 11 13)
        (oath 17 19)
      | pin committed_reads/record

  + state
    ^ sov
    = assertion (ass/ker committed_reads/assertion)
      history   (uon/sing[ass] ($u 1) assertion)
      held      (tome (pin history))
    = tree (axal/new[tome] .none).put('/root held)
      tree tree.put('/root/folder/leaf held)
    | sov (ledger [] []) tree 1 (axal/new[urn] .none)
      reference_index/new

  + same
    \ relative=path answer=res[axal[saga]]
    ^ bool
    > (./known tree) answer .false
    > (./some record) tree.get(relative) .false
    | equal[saga] record committed_reads/assertion

  + physical
    \ ignored=unit
    ^ row[testing/check]
    = state committed_reads/state
      reader (store_reader state)
      page reader.page
    [
      (testing/nat "x preserves the entire assertion" 1
        (committed_reads/same ('/) (store_page .x 0 '/root state)))
      (testing/nat "y preserves frontier assertion headers" 1
        (committed_reads/same '/folder/leaf state.y_at(1 '/root)))
      (testing/nat "z preserves descendant assertion headers" 1
        (committed_reads/same '/folder/leaf state.z_at(1 '/root)))
      (testing/nat "transparent prefix keeps child assertions" 1
        (committed_reads/same '/leaf (page .y 0 '/root/folder)))
      (testing/nat "physical reads reject future epochs" 1
        ?=(.unknown state.z_at(2 '/root)))
      (testing/nat "data projection retains the original value" 1
        (equal[res[myth]] (./known committed_reads/record)
          state.x_at(1 '/root)))]

  + hydration
    \ ignored=unit
    ^ row[testing/check]
    = state committed_reads/state
    =   card
      | myth/sing crew_slot
        | crew/pail | crew/sing '/source (dep .z '/root)
    = replacement (myth/sing '/value (pails/n 99))
    =   pending
      | (axal/new[note] .none).put '/root (note/make replacement)
    = transaction (worm pending [] 0 [] (axal/new[mode] .none) 0 0)
      crew (crew_of (./some card) transaction state)
    =   context
      | bowl ('/) '/consumer 0 0
        (read .z '/root transaction state) crew
    =   hydrated=bool
      (
        > (./some tree) crew.get('/source) .false
        | committed_reads/same ('/) (./known tree))
    [
      (testing/nat "crew retains the committed assertion" 1 hydrated)
      (testing/nat "crew values ignore pending replacement" 7
        (context.crew_value('/source).fil.fall(myth/new)).nat_at(
          '/value 0))
      (testing/nat "pending kids retain uncommitted plain values" 99
        context.kids.fil.fall(myth/new).nat_at('/value 0))]

  + computed
    \ ignored=unit
    ^ row[testing/check]
    = identity (\ context=myth tree=axal[myth] tree)
      source committed_reads/record
      first (fixture/cell_tests/put '/input source sov/new)
    =   definition
        | (myth/sing bond/weft (spun identity .none)).put
          bond/tack (safe 1 .y '/input)
    = second (fixture/cell_tests/put '/cell definition first)
    =   third
      | fixture/cell_tests/put '/cell
        definition.put('/argument (pails/n 1)) second
    = latest (view .x 0 '/x/cell third)
      earlier (view .x 1 '/x/cell third)
    =   read_case
      (
        \ answer=res[axal[saga]]
        ^ nat
        > (./known tree) answer 0
        > (./some record) tree.fil 0
        record.aeon.yuga.x.data)
    =   unsigned=bool
      (
        > (./known tree) latest .false
        > (./some record) tree.fil .false
        | equal[oath] record.aeon.oath (oath 0 0))
    =   declaration
      | myth/sing crew_slot
        | crew/pail | crew/sing '/derived (dep .x '/x/cell)
    =   transaction
        | worm (axal/new[note] .none) [] 0 []
          (axal/new[mode] .none) 0 0
    = hydrated (crew_of (./some declaration) transaction third)
    =   same=bool
      (
        > (./some tree) hydrated.get('/derived) .false
        | equal[res[axal[saga]]] latest (./known tree))
    [
      (testing/nat "computed read carries its own current case" 2
        (read_case latest))
      (testing/nat "computed historical read retains its case" 1
        (read_case earlier))
      (testing/nat "computed read oath is unsigned" 1 unsigned)
      (testing/nat "computed crew retains the result assertion" 1 same)
      (testing/nat "computed payload remains the original value" 7
        (fixture/cell_tests/nat_at '/value
          latest.run(saga/values)))]

  + historical
    \ ignored=unit
    ^ row[testing/check]
    =   first
      | fixture/cell_tests/put '/input committed_reads/record sov/new
    =   second
      | fixture/cell_tests/put '/input
        (myth/sing '/value (pails/n 99)) first
    = historical (safe 1 .x '/input).spell
      original (store_page .x 1 '/input second)
    [
      (testing/nat "history preserves the original assertion" 1
        (equal[res[axal[saga]]] original
          (view .x 0 historical second)))
      (testing/nat "historical browsing preserves assertions" 1
        (equal[res[axal[saga]]] original
          (./known (peek historical second))))]

+ tests
  ^ row[testing/case]
  [
    (testing/case "committed assertion preservation"
      committed_reads/physical)
    (testing/case "crew and pending separation"
      committed_reads/hydration)
    (testing/case "computed assertions" committed_reads/computed)
    (testing/case "historical assertions" committed_reads/historical)]
