- overlay_cache
- source_mount
- tests/source_mount [at=source_fixture]
- tests/namespace [at=fixture]
- testing

+ overlay_cache_tests
  + write
    \ target=path command=writ state=namespace
    ^ namespace
    = [next index reply] (helm/supervisor/handle
        (helm/card/step target command) state (sovereign_hive state))
    ?> (./ack failure) reply state
    ? (maybe/is_some failure) state
    next
  + record
    \ value=nat
    ^ myth
    | myth/sing ['value] (pails/n value)
  + plus_ten
    \ record=myth
    ^ myth
    | overlay_cache_tests/record (add 10 (record.nat_at(['value] 0)))
  + plus_hundred
    \ record=myth
    ^ myth
    | overlay_cache_tests/record (add 100 (record.nat_at(['value] 0)))
  + cached
    \ target=path state=namespace
    ^ axal[myth]
    | overlay_cache/value ((sovereign_care .x target state).fil.fall(myth/new))
  + number
    \ target=path state=namespace
    ^ nat
    | ((overlay_cache_tests/cached target state).fil.fall(myth/new)).nat_at ['value] 0
  + failure
    \ expected=iota result=either[iota namespace]
    ^ bool
    ? result
     > (./err why) (equal expected why)
     > (./ok _) .false
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = input=path [($x 1) 'app 'demo]
      transform=path [($x 1) 'weft 'plus]
      cache=path [($x 1) 'weft 'cached]
      initial (overlay_cache_tests/write input (writ/make (overlay_cache_tests/record 1)) fixture/namespace_tests/initial)
      initial (overlay_cache_tests/write transform
        (writ/make (myth/sing bond/weft (dyed overlay_cache_tests/plus_ten .none))) initial)
      source (overlay_cache/path 1 transform input)
      installed (overlay_cache/install cache source initial)
      ready
        ? installed
         > (./ok state) state
         > (./err _) initial
      unrelated (overlay_cache_tests/write [($x 1) 'other]
        (writ/make (overlay_cache_tests/record 9)) ready)
      changed (overlay_cache_tests/write input (writ/poke (overlay_cache_tests/record 2)) unrelated)
      upgraded (overlay_cache_tests/write transform
        (writ/make (myth/sing bond/weft (dyed overlay_cache_tests/plus_hundred .none))) changed)
      again (overlay_cache_tests/write input (writ/poke (overlay_cache_tests/record 3)) upgraded)
      removed (overlay_cache_tests/write input .cull again)
      restored (overlay_cache_tests/write input (writ/make (overlay_cache_tests/record 4)) removed)
      another=path [($x 1) 'other]
      rebound (overlay_cache_tests/write cache
        (writ/poke (myth/sing overlay_cache/source_slot (pails/p (overlay_cache/path 2 transform another)))) restored)
      old_changed (overlay_cache_tests/write input (writ/poke (overlay_cache_tests/record 5)) rebound)
      new_changed (overlay_cache_tests/write another (writ/poke (overlay_cache_tests/record 8)) old_changed)
    [(testing/nat "cache installs" 1 ?=((./ok _) installed))
     (testing/nat "cache is primed before installation returns" 11 (overlay_cache_tests/number cache ready))
     (testing/nat "unrelated write does not invalidate cache" 1
       (equal (ready.case(.x cache)) (unrelated.case(.x cache))))
     (testing/nat "source update refreshes before acknowledgement" 12 (overlay_cache_tests/number cache changed))
     (testing/nat "new function case does not replace pinned function" 13 (overlay_cache_tests/number cache again))
     (testing/nat "source removal clears cached result" 0 (overlay_cache_tests/cached cache removed).wyt)
     (testing/nat "source revival refreshes cache" 14 (overlay_cache_tests/number cache restored))
     (testing/nat "reconfiguration primes new dependency" 109 (overlay_cache_tests/number cache rebound))
     (testing/nat "old dependency no longer refreshes cache" 1
       (equal (rebound.case(.x cache)) (old_changed.case(.x cache))))
     (testing/nat "new dependency refreshes cache" 108 (overlay_cache_tests/number cache new_changed))
     (testing/nat "self-dependent cache rejected" 1
       (overlay_cache_tests/failure 'cache_inside_source (overlay_cache/install input source initial)))
     (testing/nat "malformed overlay rejected" 1
       (overlay_cache_tests/failure 'invalid_overlay_path (overlay_cache/install cache ['o] initial)))]

  + identity
    \ tree=axal[myth]
    ^ axal[myth]
    tree
  + subtree
    \ ignored=unit
    ^ row[testing/check]
    = input=path [($x 1) 'app 'demo]
      transform=path [($x 1) 'weft 'subtree]
      cache=path [($x 1) 'weft 'subtree_cache]
      initial (overlay_cache_tests/write transform
        (writ/make (myth/sing bond/weft (sewn overlay_cache_tests/identity .none))) fixture/namespace_tests/initial)
      source (overlay_cache/path 1 transform input)
      ready
        ? (overlay_cache/install cache source initial)
         > (./ok state) state
         > (./err _) initial
      child input.snoc('child)
      changed (overlay_cache_tests/write child (writ/make (overlay_cache_tests/record 7)) ready)
      removed (overlay_cache_tests/write child .cull changed)
      nested=path [($x 1) 'weft 'nested_cache]
      nested_source (overlay_cache/path 1 transform source)
      nested_state
        ? (overlay_cache/install nested nested_source changed)
         > (./ok state) state
         > (./err _) changed
      nested_changed (overlay_cache_tests/write child (writ/poke (overlay_cache_tests/record 8)) nested_state)
    [(testing/nat "subtree addition invalidates sewn cache" 7
       ((overlay_cache_tests/cached cache changed).gut(['child] myth/new)).nat_at(['value] 0))
     (testing/nat "subtree removal clears cached child" 0
       (overlay_cache_tests/cached cache removed).kid_keys.len)
     (testing/nat "nested overlay cache primes" 7
       ((overlay_cache_tests/cached nested nested_state).gut(['child] myth/new)).nat_at(['value] 0))
     (testing/nat "nested overlay source changes invalidate cache" 8
       ((overlay_cache_tests/cached nested nested_changed).gut(['child] myth/new)).nat_at(['value] 0))]

  + raw_publish
    \ home=path state=namespace
    ^ either[pail namespace]
    = files (source_mount/snapshot home state)
    ? (eq files.len 0) (./err (pails/t "Missing source"))
    = [name value] files.at(0)
    ? (eq value 0) (./err (pails/t "Rejected source"))
    = changes (axal/new[note] .none).put([state.self 'app 'demo]
        (note/make (overlay_cache_tests/record value)))
    ? (namespace/step changes 0 0 state)
     > (./accepted committed) (./ok committed.state)
     > (./rejected _) (./err (pails/t "Rejected batch"))
  + publication
    \ ignored=unit
    ^ row[testing/check]
    = transform=path [($x 1) 'weft 'plus]
      input=path [($x 1) 'app 'demo]
      cache=path [($x 1) 'weft 'published_cache]
      initial (overlay_cache_tests/write transform
        (writ/make (myth/sing bond/weft (dyed overlay_cache_tests/plus_ten .none))) fixture/namespace_tests/initial)
      ready
        ? (overlay_cache/install cache (overlay_cache/path 1 transform input) initial)
         > (./ok state) state
         > (./err _) initial
      scanned (source_fixture/source_mount_tests/state 1 7 [] ready)
      ports (source_mount/ports overlay_cache_tests/raw_publish)
      updated (source_mount/reconcile_one ports source_fixture/source_mount_tests/home scanned)
      failed_scan (source_fixture/source_mount_tests/state 2 0 [] updated)
      failed (source_mount/reconcile_one ports source_fixture/source_mount_tests/home failed_scan)
    [(testing/nat "prepared publication refreshes cached overlay" 17 (overlay_cache_tests/number cache updated))
     (testing/nat "prepared publication completes" 1 (source_mount/status_at source_fixture/source_mount_tests/home updated).ready)
     (testing/nat "failed publication keeps cached result" 17 (overlay_cache_tests/number cache failed))
     (testing/nat "failed publication keeps cache version" 1
       (equal (updated.case(.x cache)) (failed.case(.x cache))))]

+ tests
  ^ row[testing/case]
  [(testing/case "cached overlays" overlay_cache_tests/checks)
   (testing/case "cached subtree and nested overlays" overlay_cache_tests/subtree)
   (testing/case "cached publication" overlay_cache_tests/publication)]
