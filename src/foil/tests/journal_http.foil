- tests/journal_page

' Socket fixture for the journal's real registered HTTP foot. Everything
' runs in a disposable compiler worker; this never opens the user's state.
+ journal_http
  + state
    \ port=nat count=nat
    ^ sov
    = initial (journal_tests/state count)
      record (http/cfg_port 'hex port)
      version (saga (journal_tests/version 1).aeon (pin record))
      history (tome (pin (uon/sing[ass] ($u 1) (ass/ker version))))
      index initial.idx.put(['io 'http] history)
      epoch (? (eq count 0) 1 count)
    | initial.set_idx(index).set_top(epoch)

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = empty (journal_tests/page .none 40 (journal_http/state 8080 0))
      filled (journal_tests/page .none 40 (journal_http/state 8080 3))
    [(testing/nat "empty socket fixture has no journal entries" 0 empty.total)
     (testing/nat "HTTP configuration does not add a journal key" 3 filled.total)]

+ tests
  ^ row[testing/case]
  [(testing/case "isolated HTTP fixture state" journal_http/checks)]
