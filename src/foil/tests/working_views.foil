- tests/cells [at=fixture]
- view_ops
- view_cache
- testing

+ working_tests
  + unavailable
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | ./fail "Evidence has not been investigated"
  + put
    \ name=path record=myth state=sov
    ^ sov
    | fixture/cell_tests/put name record state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = fact=path [($x 1) 'supplier]
      gap=path [($x 1) 'financials]
      coverage=path [($x 1) 'coverage]
      working=path [($x 1) 'working]
      outline=path [($x 1) 'outline]
      state (working_tests/put fact (myth/sing ['lead_time_days] (pails/n 90)) sov/new)
      state (working_tests/put gap (myth/sing bond/weft (woven working_tests/unavailable)) state)
      state (working_tests/put coverage (myth/sing ['scope] (pails/t "Known supplier references only")).put(['status] (pails/q 'not_investigated)) state)
      members
        . (myth/sing bond/weft (woven view_ops/gather))
          put(['supplier] (safe 0 .x fact))
          put(['financials] (safe 0 .x gap.cons('x)))
          put(['coverage] (safe 0 .x coverage))
      state (working_tests/put working members state)
      state (working_tests/put outline (myth/sing bond/weft (woven view_ops/outline)).put(bond/tack (safe 0 .y working.cons('x))) state)
      structure (woven_evaluate 0 outline .y [] (store_reader state))
      shape
        ?> (./known tree) structure.value (axal/new[myth] .none)
        tree
      supplier_shape (shape.get(['supplier])).fall(myth/new)
      only_definitions
        | structure.observations.all
          \ observed
          | ((equal[path] observed.read.source.path outline) || (equal[path] observed.read.source.path working))
      supplier (woven_evaluate 0 working .x ['supplier] (store_reader state))
      partial (woven_evaluate 0 working .y [] (store_reader state))
      partial_tree
        ?> (./known tree) partial.value (axal/new[myth] .none)
        tree
      gap_record (partial_tree.get(['financials])).fall(myth/new)
      unresolved
        ?> (./some held) gap_record.get(['sys 'view 'state]) .false
        ?> status=pails/q held .false
        | eq_iota status.q 'unresolved
      token=pin[any] (pin 17)
      request (view_read (safe 0 .y outline.cons('x)) .all)
      [first cache cold_hit] (view_cache/read request (store_reader state) state.top token view_cache/new)
      changed (working_tests/put fact (myth/sing ['lead_time_days] (pails/n 180)) state)
      [after cache reused] (view_cache/read request (store_reader changed) changed.top token cache)
      retained
        ?> (./known record) changed.x_latest(coverage) .false
        ?> (./some held) record.get(['status]) .false
        ?> status=pails/q held .false
        | eq_iota status.q 'not_investigated
    [(testing/nat "outline reveals every named branch" 4 shape.tap.len)
     (testing/nat "outline observes definitions without opening records" 1 only_definitions)
     (testing/nat "outline leaves record contents unobserved" 0
       (maybe/is_some supplier_shape.get(['lead_time_days])))
     (testing/nat "selected branch reads its authoritative value" 90
       (fixture/cell_tests/nat_at ['lead_time_days] supplier.value))
     (testing/nat "partial composition keeps an unresolved branch visible" 1 unresolved)
     (testing/nat "unresolved branch retains a reference for later investigation" 1
       (maybe/is_some gap_record.get(['sys 'view 'origin])))
     (testing/nat "changing a record does not invalidate its collection outline" 1 reused)
     (testing/nat "uninvestigated coverage stays explicit after data changes" 1 retained)]

+ tests
  ^ row[testing/case]
  [(testing/case "bounded persistent working views" working_tests/checks)]
