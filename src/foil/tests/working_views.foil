- tests/cells [at=fixture]
- tests/composition [at=fixture]
- testing

' Read-only working views do not create work state or reinterpret absence.
' They expose the source and leave explicit investigation status authoritative.
+ working_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      evidence=path [($x 1) 'evidence]
      fact=path evidence.snoc('supplier)
      coverage=path evidence.snoc('coverage)
      working=path [($x 1) 'working]
      state (fixture/cell_tests/put fact (myth/sing ['lead_time_days] (pails/n 90)) sov/new)
      state (fixture/cell_tests/put coverage
        (myth/sing ['scope] (pails/t "Known supplier references only")).put(['status] (pails/q 'not_investigated)) state)
      state (fixture/cell_tests/put working
        (myth/sing bond/weft (cell fixture/composition_tests/identity)).put(bond/tack (safe 0 .z evidence)) state)
      current (view .z 0 working.cons(xs) state)
      frozen (fixture/composition_tests/pinned state.top working.cons(xs))
      changed (fixture/cell_tests/put fact (myth/sing ['lead_time_days] (pails/n 180)) state)
      retained
        ?> (./known record) changed.x_latest(coverage) .false
        ?> (./some held) record.get(['status]) .false
        ?> status=pails/q held .false
        | eq_iota status.q 'not_investigated
      snapshot (view .z 0 frozen changed)
    [(testing/nat "ordinary working view exposes the supplied evidence" 90
       (fixture/cell_tests/child_nat 'supplier ['lead_time_days] current))
     (testing/nat "live view follows evidence through native reads" 180
       (fixture/cell_tests/child_nat 'supplier ['lead_time_days] (view .z 0 working.cons(xs) changed)))
     (testing/nat "snapshot retains the original working evidence" 90
       (fixture/cell_tests/child_nat 'supplier ['lead_time_days] snapshot))
     (testing/nat "a data edit does not claim previously uninvestigated coverage" 1 retained)
     (testing/nat "source x history is retained" 1
       (equal (state.x_query(1 fact)) (changed.x_query(1 fact))))
     (testing/nat "source y history is retained" 1
       (equal (state.y_query(1 fact)) (changed.y_query(1 fact))))
     (testing/nat "source z history is retained" 1
       (equal (state.z_query(1 fact)) (changed.z_query(1 fact))))]

+ tests
  ^ row[testing/case]
  [(testing/case "ordinary working views preserve explicit evidence and history" working_tests/checks)]
