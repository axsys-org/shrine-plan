- stdlib/base

+ text_order_tests
  + former
    \ a=nat b=nat
    ^ bool
    ? (eq a b) .true
    ? !(a) .true
    ? !(b) .false
    = ab (mod a 256) bb (mod b 256)
    ? (lt ab bb) .true
    ? (lt bb ab) .false
    | _ (div a 256) (div b 256)
  + agrees
    \ a=nat b=nat
    ^ bool
    = expected (text_order_tests/former a b)
    ? !(eq expected (lte_iota ($ts a) ($ts b))) .false
    ? !(eq (and expected !(eq a b)) (lt_iota ($ts a) ($ts b))) .false
    ? !(eq expected (lte_iota ($ta a) ($ta b))) .false
    | eq expected (lte_iota ($tu a) ($tu b))
  + bytes
    \ ignored=unit
    ^ bool
    % i=nat 0
    ^ bool
    ? (eq i 65536) .true
    ? !(text_order_tests/agrees (div i 256) (mod i 256)) .false
    | _ i.inc
  + generated
    \ ignored=unit
    ^ bool
    % i=nat 0
    ^ bool
    ? (eq i 512) .true
    = a (add (bex (mod i 160)) (mul i 65537))
      b (add (bex (mod (mul i 7) 160)) (mul i 257))
    ? !(text_order_tests/agrees a b) .false
    ? !(text_order_tests/agrees b a) .false
    | _ i.inc
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = examples=row[nat] [0 1 255 256 65536 65537 16777216 (str/to_atom "שלום") (str/to_atom "東京") (str/to_atom "a") (str/to_atom "a b") (str/to_atom "ab")]
      pairs (examples.all((\ a=nat (examples.all((\ b=nat (text_order_tests/agrees a b)))))))
    [(testing/nat "all one-byte pairs preserve three text aura orders" 1 (text_order_tests/bytes ignored))
     (testing/nat "multi-limb generated pairs preserve strict and non-strict order" 1 (text_order_tests/generated ignored))
     (testing/nat "empty, prefixes, internal NULs and Unicode match old ordering" 1 pairs)
     (testing/nat "numeric aura ordering is unchanged" 1 (lt_iota ($u 2) ($u 10)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Text iota ordering compatibility" text_order_tests/checks)]
