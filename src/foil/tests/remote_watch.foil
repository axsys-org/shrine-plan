- helm
- testing
- tests/namespace [at=fixture]

' This test tells if a hand that watches a name in another world wakes when
' that name lands in the mount. One watcher spells the name as the mount holds
' it. The other watcher spells the name as its publisher spells it. The two
' ways to spell it give the same name.
+ remote_watch
  + initial
    ^ namespace
    | namespace ($x 17) sov/new (fixture/namespace_tests/initial).system
  + mount
    ^ path
    [($x 17) 'her ($x 18) 'doc]
  + published
    ^ path
    [($x 18) 'our ($x 17) 'doc]
  + node
    \ n=nat
    ^ path
    [($x 17) 'user 'watch ($u n)]
  + hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | yell [] record.put(['woken] (pails/n record.nat_at(['woken] 0).inc))
  + watcher
    \ n=nat watched=path
    ^ [p=path q=writ]
    = hand=path [($x 17) 'gov 'watch]
      record (myth/sing ['woken] (pails/n 0)).put(limb_slot (kook [hand])).put(crew_slot (cpail (crew/sing ['it] (dep .x watched))))
    | [(remote_watch/node n) (writ/make record)]
  + woken
    \ n=nat state=namespace
    ^ nat
    | (sovereign_care .x (remote_watch/node n) state).fil.fall(myth/new).nat_at(['woken] 0)
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial remote_watch/initial
      hand=path [($x 17) 'gov 'watch]
      records=row[[p=path q=writ]] [[hand (writ/make (myth/sing system_vocabulary/form (def_form.set_hear(remote_watch/hear))))]
        (remote_watch/watcher 1 remote_watch/mount)
        (remote_watch/watcher 2 remote_watch/published)]
    ?> (./ok state) (grove_install/changes records initial) [(testing/nat "fixture admitted" 1 0)]
    = landing=row[[p=path q=writ]] [[remote_watch/mount (writ/make (myth/sing ['value] (pails/n 7)))]]
    ?> (./ok landed) (grove_install/changes landing state) [(testing/nat "landing admitted" 1 0)]
    [(testing/nat "the publisher's name reads through the mount" 7 (remote_watch/value remote_watch/published landed))
     (testing/nat "a watcher of the mount path wakes on the landing" 1 (sub (remote_watch/woken 1 landed) (remote_watch/woken 1 state)))
     (testing/nat "a watcher of the publisher's name wakes on the landing" 1 (sub (remote_watch/woken 2 landed) (remote_watch/woken 2 state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "watching a name in another world" remote_watch/checks)]
