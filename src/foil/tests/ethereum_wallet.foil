- ethereum_wallet_app
- tests/namespace [at=fixture]
- testing

+ ethereum_wallet_tests
  + address
    ^ str
    "0x1111111111111111111111111111111111111111"
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = address ethereum_wallet_tests/address
      initial (ethereum_wallet_app/install address fixture/namespace_tests/initial)
      queued (ethereum_wallet_app/step (ethereum_wallet/command/prepare "deploy" "0x" "0x0100") initial)
      prepared (ethereum_wallet_app/step (ethereum_wallet/command/quote "deploy" 11155111 address 4 100 10 50000 10000000000000000) queued)
      reserved (ethereum_wallet_app/state prepared)
      duplicate (ethereum_wallet_app/step (ethereum_wallet/command/prepare "deploy" "0x" "0x0100") prepared)
      item (ethereum_wallet/find "deploy" reserved)
      signed (ethereum_wallet_app/step (ethereum_wallet/command/signed "deploy" item.digest 0 1 1) prepared)
      signed_item (ethereum_wallet/find "deploy" (ethereum_wallet_app/state signed))
      sent (ethereum_wallet_app/step (ethereum_wallet/command/sent "deploy" signed_item.hash) signed)
      last (ethereum_wallet/find "deploy" (ethereum_wallet_app/state sent))
      conflict (Try (ethereum_wallet_app/step (ethereum_wallet/command/prepare "deploy" "0x" "0x02")) sent)
      mismatch (Try (ethereum_wallet_app/step (ethereum_wallet/command/sent "deploy" "0x00")) signed)
      next (ethereum_wallet_app/step (ethereum_wallet/command/prepare "other" "0x" "0x00") sent)
      expensive (Try (ethereum_wallet_app/step (ethereum_wallet/command/quote "other" 11155111 address 5 40000000000 0 21000 10000000000000000)) next)
      unfunded (Try (ethereum_wallet_app/step (ethereum_wallet/command/quote "other" 11155111 address 5 100 10 50000 0)) next)
      next_quoted (ethereum_wallet_app/step (ethereum_wallet/command/quote "other" 11155111 address 0 100 10 50000 10000000000000000) next)
      wrong (Try (ethereum_wallet_app/step (ethereum_wallet/command/quote "other" 1 address 5 100 10 50000 10000000000000000)) next)
    [(testing/nat "namespace reserves nonce" 5 reserved.next_nonce)
     (testing/nat "signed bytes precede broadcast" 2 signed_item.phase)
     (testing/nat "broadcast phase stored" 3 last.phase)
     (testing/nat "duplicate intent does not advance namespace" prepared.local.top duplicate.local.top)
     (testing/nat "intent conflict rejects" 1 (either/is_err conflict))
     (testing/nat "wrong chain rejects" 1 (either/is_err wrong))
     (testing/nat "wrong broadcast hash rejects" 1 (either/is_err mismatch))
     (testing/nat "fee cap rejects" 1 (either/is_err expensive))
     (testing/nat "insufficient balance rejects" 1 (either/is_err unfunded))
     (testing/nat "consecutive reservation prevents nonce reuse" 6 (ethereum_wallet_app/state next_quoted).next_nonce)
     (testing/nat "signed bytes preserved" 1 (equal signed_item.raw last.raw))]

  + events
    \ ignored=unit
    ^ row[testing/check]
    = address ethereum_wallet_tests/address
      initial (ethereum_wallet/initial address)
      subscribed (ethereum_wallet/apply (ethereum_wallet/command/subscribe "s" address 10 0) initial)
      block (ethereum_wallet/log_block 10 "a" "parent" [(json/str "event")])
      scanned (ethereum_wallet/apply (ethereum_wallet/command/scan "s" "" 9 "" [block]) subscribed)
      repeated (ethereum_wallet/apply (ethereum_wallet/command/scan "s" "a" 10 "a" []) scanned)
      replacement (ethereum_wallet/log_block 10 "b" "parent" [])
      changed (ethereum_wallet/apply (ethereum_wallet/command/scan "s" "a" 9 "" [replacement]) repeated)
      stream changed.streams.at(0)
      acked (ethereum_wallet/apply (ethereum_wallet/command/ack "s" 1) changed)
      stale (Try (ethereum_wallet/apply (ethereum_wallet/command/scan "s" "a" 9 "" [])) changed)
      gap (Try (ethereum_wallet/apply (ethereum_wallet/command/scan "s" "b" 8 "" [])) changed)
      unknown (Try (ethereum_wallet/apply (ethereum_wallet/command/ack "s" 3)) changed)
      badstart (Try (ethereum_wallet/apply (ethereum_wallet/command/subscribe "bad" address 0 0)) initial)
    [(testing/nat "scan no-op retains batch" 1 (equal scanned repeated))
     (testing/nat "reorg retains both unacknowledged batches" 2 stream.batches.len)
     (testing/nat "reorg removes original event" 1 (equal stream.batches.at(0).added stream.batches.at(1).removed))
     (testing/nat "ack discards only acknowledged batches" 1 acked.streams.at(0).batches.len)
     (testing/nat "stale scan rejects" 1 (either/is_err stale))
     (testing/nat "invalid ancestor rejects" 1 (either/is_err gap))
     (testing/nat "unknown ack rejects" 1 (either/is_err unknown))
     (testing/nat "genesis start rejects" 1 (either/is_err badstart))]

+ tests
  ^ row[testing/case]
  [(testing/case "wallet namespace transitions" ethereum_wallet_tests/checks)
   (testing/case "wallet event batches" ethereum_wallet_tests/events)]
