-  json [order=10]
-  testing [order=20]

+  json_tests
  +  scalars
    \ _=unit
    ^ row[testing/check]
    | testing/table[str str] "round trip" (\ x=str x) rt
      [["[ 1 , 2 , 3 ]" "[1,2,3]"]
       ["  null  " "null"]
       ["[true, false, [-5], []]" "[true,false,[-5],[]]"]
       ["-0" "-0"]
       ["1234567890123456789012345678901234567890"
        "1234567890123456789012345678901234567890"]]

  +  errors
    \ _=unit
    ^ row[testing/check]
    | testing/table[str str] "invalid input" (\ x=str x) rt
      [["1 2" "trailing-garbage"]
       ["nulL" "bad-literal"]
       ["," "unexpected-byte"]
       ["[1" "expected-comma-or-bracket"]
       ["-" "bad-number"]]

+  tests
  ^ row[testing/case]
  [(testing/case "scalars and arrays" json_tests/scalars)
   (testing/case "invalid inputs" json_tests/errors)]
