-  testing

+  testing_tests
  +  checks
    \ _=unit
    ^ row[testing/check]
    = same (testing/nat "equal" 7 7)
      diff (testing/nat "different" 7 8)
      blank (testing/text "empty" "" "")
    [(testing/nat "equal passes" 1 same.pass)
     (testing/nat "different fails" 0 diff.pass)
     (testing/text "expected rendered" "7" diff.want)
     (testing/text "actual rendered" "8" diff.got)
     (testing/nat "empty text passes" 1 blank.pass)]

+  tests
  ^ row[testing/case]
  [(testing/case "check results" testing_tests/checks)]
