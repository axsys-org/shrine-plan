- helm
- eden
- testing
- tests/namespace [at=fixture]

+ supervisor_tests
  + initial
    ^ namespace
    = fixture fixture/namespace_tests/initial
    | namespace ($x 17) sov/new fixture.system
  + value
    \ answer=feet/task[unit]
    ^ nat
    ? answer
     > (./page pax result)
      ? result
       > (./known tree)
        ? tree.fil
         > (./some version)
          | (unpin version.myth).nat_at ['value] 0
        0
      0
    0

  + accepted
    \ answer=feet/task[unit]
    ^ bool
    ? answer
     > (./ack err)
      ? err
       > .none .true
      .false
    .false

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = empty supervisor_tests/initial
      record | myth/sing ['value] (pd 42)
      [made index ack]
        | helm/supervisor/handle
          (helm/card/step [($x 17) 'demo] (writ/make record))
          empty (sovereign_hive empty)
      [unchanged same_index page]
        | helm/supervisor/handle
          (helm/card/peek .y .none [($x 17) 'demo]) made index
      [rejected old_index failure]
        | helm/supervisor/handle
          (helm/card/step [($x 17) 'missing] (writ/poke record)) made index
      [later later_index later_ack]
        | helm/supervisor/handle
          (helm/card/step [($x 17) 'demo]
            (writ/poke (myth/sing ['value] (pd 99)))) made index
      historical | namespace/page .y (./some 1) [($x 17) 'demo] later
    [ (testing/nat "write accepted" 1
        (supervisor_tests/accepted ack))
      (testing/nat "page contains committed record" 42
        (supervisor_tests/value page))
      (testing/nat "read preserves state" 1 (equal made unchanged))
      (testing/nat "poke of missing record rejected" 0
        (supervisor_tests/accepted failure))
      (testing/nat "rejection preserves state" 1 (equal made rejected))
      (testing/nat "rejection preserves index" 1 (equal index old_index))
      (testing/nat "historical page" 42
        (supervisor_tests/value (feet/task/page [($x 17) 'demo] historical)))
      (testing/nat "absent page is a runtime unknown value" 1
        ?=(.unknown (namespace/page .y .none [($x 17) 'missing] made)))
    ]

  + actor
    \ ignored=unit
    ^ row[testing/check]
    = ;server (Spawn (helm/supervisor/run supervisor_tests/initial))
      record | myth/sing ['value] (pd 42)
    ; (SendCaps server
        (helm/card/step [($x 17) 'demo] (writ/make record)) [0])
    = ;[ack caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server
        (helm/card/peek .y .none [($x 17) 'demo]) [0])
    = ;[page more_caps] (Recv[feet/task[unit]] 0)
    ; (CloseHandle server)
    [ (testing/nat "actor acknowledges write" 1
        (supervisor_tests/accepted ack))
      (testing/nat "actor reads committed write" 42
        (supervisor_tests/value page))
    ]

+ tests
  ^ row[testing/case]
  [ (testing/case "namespace requests" supervisor_tests/checks)
    (testing/case "native supervisor loop" supervisor_tests/actor)
    (testing/case "Eden booted namespace" supervisor_tests/eden)
    (testing/case "registered foot loop" supervisor_tests/feet)
  ]

+ supervisor_tests
  + eden
    \ ignored=unit
    ^ row[testing/check]
    '  Actual eden/main now opens sockets and is covered by x/eden --check.
    = fixture supervisor_tests/initial
      initial=namespace
        ? (eden/boot ($x 17) fixture.system sov/new 8080)
         > (./ok state) state
         > (./err reason) supervisor_tests/initial
      ;server (Spawn (helm/supervisor/run initial))
    ; (SendCaps server
        (helm/card/peek .x .none [($x 17) 'hello]) [0])
    = ;[page caps] (Recv[feet/task[unit]] 0)
      greeting=str
        ? page
         > (./page pax result)
          ? result
           > (./known tree)
            ? tree.fil
             > (./some version)
              | (unpin version.myth).txt_at ['message]
            ""
          ""
        ""
    ; (CloseHandle server)
    [(testing/text "serves booted namespace" "Hello from Eden." greeting)]

+ supervisor_tests
  + binding_value
    \ binding=axal[saga]
    ^ nat
    ? binding.fil
     > (./some version) (unpin version.myth).nat_at(['value] 0)
    0

  + foot
    '  Init -> relative write -> fact -> ack -> relative child -> fact.
    '  Publish proof at an absolute path, exercising both write modes.
    \ initial=feet/task/init self=nat
    ^ nat
    = initial_value (supervisor_tests/binding_value initial.ax)
    ; (Send initial.parent (feet/gift/pass []
        (writ/poke (myth/sing ['value] (pd initial_value.inc)))))
    = ;[first caps] (Recv[feet/task[unit]] 0)
      first_value=nat
        ? first
         > (./fact binding) (supervisor_tests/binding_value binding)
        0
    = ;[ack caps] (Recv[feet/task[unit]] 0)
    ; (Send initial.parent (feet/gift/pass ['child]
        (writ/make (myth/sing ['value] (pd first_value.inc)))))
    = ;[second caps] (Recv[feet/task[unit]] 0)
      child_value=nat
        ? second
         > (./fact binding)
          ? binding.get(['child])
           > (./some version) (unpin version.myth).nat_at(['value] 0)
          0
        0
    = ;[child_ack caps] (Recv[feet/task[unit]] 0)
      proof | myth/sing ['value] (pd child_value)
      proof | proof.put ['initial] (pd initial_value)
      proof | proof.put ['ack] (pd (supervisor_tests/accepted ack))
      proof | proof.put ['child_ack] (pd (supervisor_tests/accepted child_ack))
    ; (Send initial.parent (feet/gift/poke [($x 17) 'proof] (writ/make proof)))
    % ignored=nat 0
    ; (Recv[feet/task[unit]] 0)
    | _ 0

  + await_proof
    \ server=nat attempts=nat
    ^ feet/task[unit]
    ; (SendCaps server
        (helm/card/peek .x .none [($x 17) 'proof]) [0])
    = ;[page caps] (Recv[feet/task[unit]] 0)
    ? (supervisor_tests/value page) page
    ? (eq attempts 0) page
    | _ server attempts.dec

  + feet
    \ ignored=unit
    ^ row[testing/check]
    = [initial index ack]
        | helm/supervisor/handle
          (helm/card/step [($x 17) 'feet 'demo]
            (writ/make (myth/sing ['value] (pd 7))))
            supervisor_tests/initial
            (sovereign_hive supervisor_tests/initial)
      ;server (Spawn (helm/supervisor/run initial))
    ; (SendCaps server
        (helm/supervisor/register [($x 17) 'feet 'demo] supervisor_tests/foot) [0])
    = ;[registered caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server
        (helm/supervisor/register [($x 17) 'feet 'demo] supervisor_tests/foot) [0])
    = ;[duplicate caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server
        (helm/supervisor/register [($x 17) 'missing] supervisor_tests/foot) [0])
    = ;[missing caps] (Recv[feet/task[unit]] 0)
      ;proof (supervisor_tests/await_proof server 500)
      record=myth
        ? proof
         > (./page pax result)
          ? result
           > (./known tree)
            ? tree.fil
             > (./some version) (unpin version.myth)
            myth/new
          myth/new
        myth/new
    ; (SendCaps server
        (helm/card/peek .x .none [($x 17) 'feet 'demo 'child]) [0])
    = ;[child caps] (Recv[feet/task[unit]] 0)
    ; (CloseHandle server)
    [(testing/nat "foot registered" 1 (supervisor_tests/accepted registered))
     (testing/nat "duplicate rejected" 0 (supervisor_tests/accepted duplicate))
     (testing/nat "missing binding rejected" 0 (supervisor_tests/accepted missing))
     (testing/nat "initial binding received" 7 record.nat_at(['initial] 0))
     (testing/nat "own and child updates received before acks" 9 (supervisor_tests/value proof))
     (testing/nat "relative child lands under registered path" 9 (supervisor_tests/value child))
     (testing/nat "own write acknowledged" 1 record.nat_at(['ack] 0))
     (testing/nat "child write acknowledged" 1 record.nat_at(['child_ack] 0))]
