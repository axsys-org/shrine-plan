- sept
- testing

+ mop_range_after_tests
  + values
    (@ k)
    \ entries=row[mop/kv[k nat]]
    ^ row[nat]
    | entries.map (\ e=mop/kv[k nat] e.val)

  + same
    (@ k)
    \ name=str want=row[nat] got=row[mop/kv[k nat]]
    ^ testing/check
    | testing/nat name 1 (equal want (mop_range_after_tests/values[k] got))

  + seq
    \ count=nat
    ^ mop[nat nat lt]
    % n=nat 0 tree=mop[nat nat lt] (mop/empty)
    ? (eq n count) tree
    | _ n.inc tree.put(n n)

  + edge_cases
    \ ignored=unit
    ^ row[testing/check]
    = empty=mop[nat nat lt] (mop/empty)
      tree empty.put(0 0).put(2 2).put(9 9).put(10 10)
    [(mop_range_after_tests/same[nat] "empty map" [] empty.range_after(.none 40))
     (mop_range_after_tests/same[nat] "zero limit" [] tree.range_after(.none 0))
     (mop_range_after_tests/same[nat] "ascending numeric order" [0 2 9 10]
       tree.range_after(.none 40))
     (mop_range_after_tests/same[nat] "exact limit" [0 2] tree.range_after(.none 2))
     (mop_range_after_tests/same[nat] "exclusive existing cursor" [9 10]
       tree.range_after((maybe/some 2) 40))
     (mop_range_after_tests/same[nat] "absent cursor seeks successor" [9 10]
       tree.range_after((maybe/some 8) 40))
     (mop_range_after_tests/same[nat] "minimum cursor excluded" [2 9 10]
       tree.range_after((maybe/some 0) 40))
     (mop_range_after_tests/same[nat] "maximum cursor excluded" []
       tree.range_after((maybe/some 10) 40))
     (mop_range_after_tests/same[nat] "above maximum" []
       tree.range_after((maybe/some 11) 40))]

  + comparator_order
    \ ignored=unit
    ^ row[testing/check]
    = reverse=mop[nat nat gt] (mop/empty)
      reverse reverse.put(2 2).put(9 9).put(0 0).put(10 10)
      paths=mop[path nat lt_pith] (mop/empty)
      paths paths.put(['b] 4).put(['a 'b] 3).put([] 0)
      paths paths.put(['a 'a] 2).put(['a] 1)
    [(mop_range_after_tests/same[nat] "reverse comparator owns order" [10 9 2 0]
       reverse.range_after(.none 40))
     (mop_range_after_tests/same[nat] "reverse comparator owns cursor exclusion" [2 0]
       reverse.range_after((maybe/some 9) 40))
     (mop_range_after_tests/same[nat] "reverse absent cursor" [2 0]
       reverse.range_after((maybe/some 8) 40))
     (mop_range_after_tests/same[path] "path order includes root before descendants" [0 1 2 3 4]
       paths.range_after(.none 40))
     (mop_range_after_tests/same[path] "empty path is a real exclusive cursor" [1 2 3 4]
       paths.range_after((maybe/some[path] []) 40))
     (mop_range_after_tests/same[path] "multisegment cursor excludes itself" [3 4]
       paths.range_after((maybe/some[path] ['a 'a]) 40))
     (mop_range_after_tests/same[path] "absent multisegment cursor" [3 4]
       paths.range_after((maybe/some[path] ['a 'a 'z]) 40))
     (mop_range_after_tests/same[path] "prefix cursor includes all its descendants" [2 3 4]
       paths.range_after((maybe/some[path] ['a]) 40))]

  + missing_tree
    \ code=nat
    ^ mop[nat nat lt]
    = trees=row[mop[nat nat lt]] []
    | trees.at (Throw code)

  + missing_value
    \ code=nat
    ^ nat
    = values=row[nat] []
    | values.at (Throw code)

  + guarded_tree
    \ code=nat
    ^ mop[nat nat lt]
    | mop/node[nat nat lt] 3 2 2
      (mop/sing[nat nat lt] 1 1)
      (mop_range_after_tests/missing_tree code)

  + traverse_guards
    \ ignored=unit
    ^ row[testing/check]
    = no_later (mop_range_after_tests/guarded_tree 91)
      no_earlier=mop[nat nat lt]
        (mop/node[nat nat lt] 3 2 (mop_range_after_tests/missing_value 92)
          (mop_range_after_tests/missing_tree 93)
          (mop/sing[nat nat lt] 3 3))
      root_value=mop[nat nat lt]
        (mop/node[nat nat lt] 2 2 (mop_range_after_tests/missing_value 94)
          (mop/sing[nat nat lt] 1 1)
          (mop/empty))
    [(mop_range_after_tests/same[nat] "filled page does not inspect later subtree" [1 2]
       no_later.range_after(.none 2))
     (mop_range_after_tests/same[nat] "cursor prunes earlier subtree and excluded value" [3]
       no_earlier.range_after((maybe/some 2) 1))
     (mop_range_after_tests/same[nat] "filled left page does not inspect root value" [1]
       root_value.range_after(.none 1))
     (mop_range_after_tests/same[nat] "zero limit does not inspect root" []
       (mop/range_after[nat nat lt] .none 0 (mop_range_after_tests/missing_tree 95)))]

  + full_scan
    \ code=nat
    ^ nat
    = tree (mop_range_after_tests/guarded_tree code)
      entries tree.tap
    entries.len

  + larger_page
    \ code=nat
    ^ nat
    = tree (mop_range_after_tests/guarded_tree code)
      entries tree.range_after(.none 3)
    entries.len

  + read_poisoned_value
    \ code=nat
    ^ nat
    = tree=mop[nat nat lt] (mop/sing[nat nat lt] 1
        (mop_range_after_tests/missing_value code))
      entries tree.range_after(.none 1)
    entries.at(0).val

  + guard_controls
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "control: tap reaches excluded throwing subtree" 1
       (either/is_err (Try mop_range_after_tests/full_scan 96)))
     (testing/nat "control: larger page reaches throwing subtree" 1
       (either/is_err (Try mop_range_after_tests/larger_page 97)))
     (testing/nat "control: selected value is actually poisonous" 1
       (either/is_err (Try mop_range_after_tests/read_poisoned_value 98)))]

  + large
    \ ignored=unit
    ^ row[testing/check]
    = tree (mop_range_after_tests/seq 10000)
      lookahead tree.range_after(.none 41)
      first lookahead.take(40)
      cursor (maybe/some[nat] first.at(39).key)
      second tree.range_after(cursor 41)
      grown tree.put(10000 10000).put(10001 10001)
      boundaries=row[nat] [0 1 8 16 72 80 512 648 1000 5832 9959 9998 9999]
    [(testing/nat "10k cached count" 10000 tree.size)
     (mop_range_after_tests/same[nat] "bounded ascending lookahead"
       (row/range 0 41) lookahead)
     (testing/nat "first cursor excludes last displayed key" 40 second.at(0).val)
     (testing/nat "second page remains exact limit" 41 second.len)
     (testing/nat "second page last item" 80 second.at(40).val)
     (testing/nat "later inserts do not shift an existing page" 1
       (equal second grown.range_after(cursor 41)))
     (testing/nat "seek works across tree levels" 1
       (row/all[nat]
         (\ bound=nat
           (equal (row/range bound.inc (? (lt bound 9958) (add bound 42) 10000))
             (mop_range_after_tests/values[nat] tree.range_after((maybe/some bound) 41))))
         boundaries))]

  + all_pages
    \ ignored=unit
    ^ row[testing/check]
    = tree (mop_range_after_tests/seq 10000)
      rows
        % after=maybe[nat] .none out=row[mop/kv[nat nat]] []
        = page tree.range_after(after 41)
          displayed page.take(40)
          out out.weld(displayed)
        ? (le page.len 40) out
        | _ (maybe/some displayed.at(displayed.len.dec).key) out
    [(mop_range_after_tests/same[nat] "all 10k keys appear once across lookahead pages"
       (row/range 0 10000) rows)]

+ tests
  ^ row[testing/case]
  [(testing/case "exclusive cursor boundaries" mop_range_after_tests/edge_cases)
   (testing/case "generic comparator and path keys" mop_range_after_tests/comparator_order)
   (testing/case "bounded subtree and value traversal" mop_range_after_tests/traverse_guards)
   (testing/case "throwing guard positive controls" mop_range_after_tests/guard_controls)
   (testing/case "10k balanced tree seeks" mop_range_after_tests/large)
   (testing/case "complete paged access" mop_range_after_tests/all_pages)]
