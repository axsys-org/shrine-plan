- helm
- testing
- tests/namespace [at=fixture]

' A peer's moment lands as one kernel event that also holds the checkpoint of
' the transport. If a plan only tries the moment, any kernel rule can cause
' the kernel to accept no part of the plan. Then the checkpoint stays, and the
' transport gives the same message again and does not stop. A total landing
' moves the checkpoint forward if the kernel accepts the moment and also if it
' does not.
+ landing_tests
  + initial
    ^ namespace
    = fixture fixture/namespace_tests/initial
    | namespace ($x 17) sov/new fixture.system
  + peer
    ^ path
    [($x 17) 'her ($x 18)]
  + doc
    ^ path
    [($x 17) 'her ($x 18) 'doc]
  + flow
    ^ path
    [($x 17) 'io 'mesa 'flow ($x 18)]
  + refused
    \ mark=nat
    ^ path
    [($x 17) 'io 'mesa 'refused ($x 18) ($u mark)]
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + through
    \ state=namespace
    ^ nat
    | (sovereign_care .x landing_tests/flow state).fil.fall(myth/new).nat_at(['through] 0)
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ? reply
     > (./ack why) (maybe/is_none why)
    .false
  + reason
    \ reply=feet/task[unit]
    ^ iota
    = unknown=iota 'unknown
    ? reply
     > (./ack why)
      ?> (./some held) why unknown
      ? held
       > rejected=helm/supervisor/rejection rejected.reason
      unknown
    unknown
  + mark
    \ through=nat
    ^ [p=path q=writ]
    | [landing_tests/flow (writ/make (myth/sing ['through] (pails/n through)))]
  + naive
    ' It writes the moment and the checkpoint. If the kernel does not accept
    ' them, it writes no record.
    \ record=myth through=nat state=namespace index=hive
    ^ [state=namespace index=hive reply=feet/task[unit]]
    = writes=row[[p=path q=writ]] [[landing_tests/doc (writ/make record)]
        (landing_tests/mark through)]
      plan (\ current=namespace (either/ok[iota row[[p=path q=writ]]] writes))
    | helm/supervisor/admit plan state index
  + total
    ' It writes the moment and the checkpoint. If the kernel does not accept
    ' them, it writes the reason and the checkpoint.
    \ record=myth through=nat state=namespace index=hive
    ^ [state=namespace index=hive reply=feet/task[unit]]
    = [next ni reply] (landing_tests/naive record through state index)
    ? (landing_tests/accepted reply) [next ni reply]
    = why (landing_tests/reason reply)
      writes=row[[p=path q=writ]] [[(landing_tests/refused through) (writ/make (myth/sing ['why] (pails/q why)))]
        (landing_tests/mark through)]
      plan (\ current=namespace (either/ok[iota row[[p=path q=writ]]] writes))
    | helm/supervisor/admit plan state index
  + honest
    \ _=unit
    ^ row[testing/check]
    = state landing_tests/initial
      record (myth/sing ['value] (pails/n 7))
      [next ni reply] (landing_tests/naive record 1 state (sovereign_hive state))
    [(testing/nat "landing admitted" 1 (landing_tests/accepted reply))
     (testing/nat "moment landed under her" 7 (landing_tests/value landing_tests/doc next))
     (testing/nat "checkpoint written" 1 (landing_tests/through next))
     (testing/nat "one event holds both" state.local.top.inc next.local.top)]
  + tombstone
    \ _=unit
    ^ row[testing/check]
    = state landing_tests/initial
      first (myth/sing ['value] (pails/n 7))
      [landed li ok] (landing_tests/naive first 1 state (sovereign_hive state))
      [removed ri gone] (helm/supervisor/step landing_tests/peer .cull 0 0 landed li)
      second (myth/sing ['value] (pails/n 8))
      [stuck si no] (landing_tests/naive second 2 removed ri)
      [again ai still] (landing_tests/naive second 2 stuck si)
      [moved mi yes] (landing_tests/total second 2 again ai)
      want=iota 'tombstoned_ancestor
    [(testing/nat "first landing admitted" 1 (landing_tests/accepted ok))
     (testing/nat "peer removed" 1 (landing_tests/accepted gone))
     (testing/nat "naive landing refused" 0 (landing_tests/accepted no))
     (testing/nat "refused for the tombstone" 1 (equal (landing_tests/reason no) want))
     (testing/nat "checkpoint did not advance" 1 (landing_tests/through stuck))
     (testing/nat "redelivery refused again" 0 (landing_tests/accepted still))
     (testing/nat "total landing admitted" 1 (landing_tests/accepted yes))
     (testing/nat "total landing advances the checkpoint" 2 (landing_tests/through moved))
     (testing/nat "total landing records the refusal" 1 (maybe/is_some (sovereign_care .x (landing_tests/refused 2) moved).fil))
     (testing/nat "nothing landed beneath the tombstone" 0 (landing_tests/value landing_tests/doc moved))]
  + contract
    \ _=unit
    ^ row[testing/check]
    = state landing_tests/initial
      held (lash/texted ['title] 0)
      first (myth/sing ['title] (pails/t "first")).put(system_vocabulary/lash held)
      [landed li ok] (landing_tests/naive first 1 state (sovereign_hive state))
      second (myth/sing ['value] (pails/n 2)).put(system_vocabulary/lash held)
      [stuck si no] (landing_tests/naive second 2 landed li)
      [moved mi yes] (landing_tests/total second 2 stuck si)
      want=iota 'curb_need
    [(testing/nat "first landing with its contract admitted" 1 (landing_tests/accepted ok))
     (testing/nat "peer breaks its own contract: refused" 0 (landing_tests/accepted no))
     (testing/nat "refused for the contract" 1 (equal (landing_tests/reason no) want))
     (testing/nat "checkpoint did not advance" 1 (landing_tests/through stuck))
     (testing/nat "total landing admitted" 1 (landing_tests/accepted yes))
     (testing/nat "total landing advances the checkpoint" 2 (landing_tests/through moved))
     (testing/nat "the earlier moment still stands" 0 (landing_tests/value landing_tests/doc moved))]

+ tests
  ^ row[testing/case]
  [(testing/case "a landing is one event with its checkpoint" landing_tests/honest)
   (testing/case "a tombstone wedges a naive landing" landing_tests/tombstone)
   (testing/case "a broken contract wedges a naive landing" landing_tests/contract)]
