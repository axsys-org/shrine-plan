- goo_runtime
- grove_surface_wire
- overlay_cache
- testing
- tests/grove_install [at=fixture]

+ grove_surface_checks
  + at
    \ name=iota
    ^ path
    [($x 17) 'app 'surface_test name]
  + read
    \ context=grove_surface_context target=path
    ^ maybe[myth]
    = found (context.inputs.keep((\ input=grove_observed (equal[path] input.dependency.p target))))
    ? !(eq found.len 1) .none
    ?> (./known tree) found.at(0).value .none
    tree.fil
  + resolve
    \ context=grove_surface_context key=path parameters=myth
    ^ either[str grove_occurrence]
    ? !(eq key.len 3) (./err "Expected a keyed field occurrence.")
    ? !(eq_iota key.at(0) 'cells) (./err "Unknown family.")
    = target (grove_surface_checks/at key.at(1))
      slot=path [key.at(2)]
    ?> (./some card) (grove_surface_checks/read context target) (./err "Unknown row identity.")
    ? !(card.has(slot)) (./err "Unknown field.")
    | ./ok (grove_occurrence key (grove_focus (safe 0 .x target) slot .none)
        (./some [($x 17) 'gov 'surface_test 'edit]) rex/zero_span "Original native field")
  + render
    \ context=grove_surface_context
    ^ either[str grove_surface_output]
    < first (grove_surface_checks/resolve context ['cells 'a 'value] myth/new)
    < second (grove_surface_checks/resolve context ['cells 'b 'value] myth/new)
    | ./ok (grove_surface_output (weft/node/el "table" [] []) [first second] [['cells]])
  + prepare
    \ context=grove_surface_context occurrence=grove_occurrence args=myth
    ^ either[str grove_change_plan]
    ?> (./some before) (grove_surface_checks/read context occurrence.focus.source.path) (./err "Missing original row.")
    ?> (./some held) args.get(['value]) (./err "Missing numeric argument.")
    ?> value=pails/n held (./err "Expected a native number.")
    = edit (grove_record_edit occurrence.focus.source.path (./some before)
        (./some before.put(occurrence.focus.slot value)))
    | ./ok (grove_change_plan [edit] [(./ok [])])
  + setup
    \ ignored=unit
    ^ [namespace goo_runtime/captured_surface]
    = initial (fixture/grove_install_checks/bootstrap [])
      a (grove_surface_checks/at 'a)
      b (grove_surface_checks/at 'b)
      owner (grove_surface_checks/at 'view)
      code=path [initial.self 'gov 'surface_test]
      program (grove_surface_program grove_surface_checks/render grove_surface_checks/resolve grove_surface_checks/prepare)
      state (either/ok_val (grove_install/change_many
        [[a (writ/make (myth/sing ['value] (pails/n 10)).put(['unrelated] (pails/t "Keep")))]
         [b (writ/make (myth/sing ['value] (pails/n 20)))]
         [code (writ/make (myth/sing goo_runtime/program_slot program))]] initial))
      binding (grove_surface_binding (safe (state.case(.x code)).fall(0) .x code)
        [(dep .x a) (dep .x b)] [(grove_slot_scope a [['value]]) (grove_slot_scope b [['value]])])
      state (either/ok_val (grove_install/change owner (writ/make (myth/sing goo_runtime/surface_slot binding)) state))
    [state (either/ok_val (goo_runtime/capture_surface owner myth/new state))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      a (grove_surface_checks/at 'a)
      b (grove_surface_checks/at 'b)
      key=path ['cells 'b 'value]
      raw (either/ok_val (captured.program.resolve captured.context key myth/new))
      occurrence (either/ok_val (goo_runtime/seal_occurrence captured raw state))
      output (either/ok_val (captured.program.render captured.context))
      plan (either/ok_val (captured.program.prepare captured.context occurrence (myth/sing ['value] (pails/n 35))))
      prepared (goo_runtime/prepared_surface_action captured occurrence plan)
      updated (goo_runtime/commit_surface_action prepared state)
      next (either/ok_val updated)
      old (goo_runtime/record .x b state).fall(myth/new)
      widened (grove_change_plan [(grove_record_edit b (./some old) (./some old.put(['secret] (pails/t "No"))))] [])
      double (grove_change_plan plan.edits.weld(plan.edits) [])
      unchecked plan.set_checks([(./err "Retained invariant failed.")])
      unknown (captured.program.resolve captured.context ['cells 'missing 'value] myth/new)
      reordered captured.set_context(captured.context.set_inputs(captured.context.inputs.rev))
      reordered_occurrence (either/ok_val (reordered.program.resolve reordered.context key myth/new))
      changed (either/ok_val (grove_install/change a (writ/poke (myth/sing ['value] (pails/n 99))) state))
      foreign raw.set_focus(raw.focus.set_source((safe 0 .x [($x 99) 'app 'private])))
      owner_card (goo_runtime/record .x captured.owner.path state).fall(myth/new)
      rebound (either/ok_val (grove_install/change captured.owner.path
        (writ/poke (myth/sing goo_runtime/surface_slot captured.binding.set_writes([]))) state))
    [(testing/nat "surface captures exact source records without a workspace registry" 2 captured.context.inputs.len)
     (testing/nat "native presentation supplies repeated correspondence" 1 output.families.len)
     (testing/nat "occurrence is the original row rather than a copy" 1 (equal[path] occurrence.focus.source.path b))
     (testing/nat "occurrence is sealed to exact native case" (state.case(.x b)).fall(0) occurrence.focus.source.ver)
     (testing/nat "reordering input presentation does not change row identity" 1 (equal[path] reordered_occurrence.focus.source.path b))
     (testing/nat "prepared native action applies" 1 (either/is_ok updated))
     (testing/nat "native action edits selected original row" 35 (goo_runtime/record .x b next).fall(myth/new).nat_at(['value] 0))
     (testing/nat "other row is unchanged" 10 (goo_runtime/record .x a next).fall(myth/new).nat_at(['value] 0))
     (testing/text "unrelated slots survive" "Keep" (goo_runtime/record .x a next).fall(myth/new).txt_at(['unrelated]))
     (testing/nat "code cannot widen installed slot authority" 1 (either/is_err (goo_runtime/surface_plan_allowed captured widened state)))
     (testing/nat "duplicate targets require explicit composition" 1 (either/is_err (goo_runtime/surface_plan_allowed captured double state)))
     (testing/nat "failed check blocks commit" 1 (either/is_err (goo_runtime/surface_plan_allowed captured unchecked state)))
     (testing/nat "stale input blocks the prepared action" 1 (either/is_err (goo_runtime/commit_surface_action prepared changed)))
     (testing/nat "changed binding invalidates captured action" 1 (either/is_err (goo_runtime/commit_surface_action prepared rebound)))
     (testing/nat "unknown repeated key remains unresolved" 1 (either/is_err unknown))
     (testing/nat "outside correspondence is rejected" 1 (either/is_err (goo_runtime/seal_occurrence captured foreign state)))
     (testing/nat "surface cannot run without bounded native execution" 1 (either/is_err (goo_runtime/render_surface captured state)))]
  + wire
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      root=path [state.self 'app 'many_subjects]
      commands (row/range 0 101).map((\ i [root.snoc(($u i)) (writ/make (myth/sing ['sys 'lede] (pails/t (nat/show i))))]))
      state (either/ok_val (grove_install/change_many commands state))
      first (either/ok_val (grove_surface_wire/discover root (json/obj []) state))
      cursor (grove_dev/field "next" first)
      second (either/ok_val (grove_surface_wire/discover root
        (json/obj [(jkv "cursor" cursor) (jkv "epoch" (grove_dev/field "epoch" first))]) state))
      many
        | (row/range 0 71).fold myth/new
          \ out i
          | out.put [($u i) 'opaque] (pails/n i)
      wide root.snoc('wide)
      state (either/ok_val (grove_install/change wide (writ/make many) state))
      fields (either/ok_val (grove_surface_wire/discover wide (json/obj []) state))
      following (either/ok_val (grove_surface_wire/discover wide (json/obj
        [(jkv "slot_cursor" (grove_dev/field "next_slots" fields))
         (jkv "epoch" (grove_dev/field "epoch" fields))]) state))
      input (json/obj [(jkv "slot" (json/str "/opaque/value")) (jkv "kind" (json/str "natural")) (jkv "value" (json/str "9007199254740993"))])
      args (grove_surface_wire/arguments (json/arr [input]))
      duplicate (grove_surface_wire/arguments (json/arr [input input]))
      old (grove_surface_wire/basis captured)
      shifted (grove_surface_wire/basis captured.set_context(captured.context.set_viewport((myth/sing ['width] (pails/n 500)))))
    [(testing/nat "namespace has more subjects than the old prototype ceiling" 102 (sovereign_care .z root state).wyt)
     (testing/nat "discovery returns a bounded first page" 40 (grove_dev/items (grove_dev/field "children" first)).len)
     (testing/nat "discovery continues through existing native index" 40 (grove_dev/items (grove_dev/field "children" second)).len)
     (testing/nat "opaque slots have a bounded first page" 40 (grove_dev/items (grove_dev/field "slots" fields)).len)
     (testing/nat "opaque slot paging reaches the remaining original slots" 31 (grove_dev/items (grove_dev/field "slots" following)).len)
     (testing/nat "geometry contributes to the displayed basis" 0 (equal[json] old shifted))
     (testing/nat "native argument numbers avoid browser precision loss" 9007199254740993 (either/ok_val args).nat_at(['opaque 'value] 0))
     (testing/nat "duplicate opaque argument slots are rejected" 1 (either/is_err duplicate))]
  + derived
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      a (grove_surface_checks/at 'a)
      code=path [state.self 'gov 'derived_focus]
      identity (\ card=myth card)
      state (either/ok_val (grove_install/change code (writ/make (myth/sing bond/weft (dyed identity .none))) state))
      source (overlay_cache/path (state.case(.x code)).fall(0) code a)
      owner (grove_surface_checks/at 'derived)
      binding captured.binding.set_reads([(dep .x source)]).set_writes([])
      state (either/ok_val (grove_install/change owner (writ/make (myth/sing goo_runtime/surface_slot binding)) state))
      derived (either/ok_val (goo_runtime/capture_surface owner myth/new state))
      item (grove_occurrence ['output] (grove_focus (safe 0 .x source) ['value] .none) .none rex/zero_span "Derived value")
      sealed (goo_runtime/seal_occurrence derived item state)
      next (either/ok_val (grove_install/change a (writ/poke (myth/sing ['value] (pails/n 11))) state))
    [(testing/nat "derived case follows its input through native lens algebra" (state.case(.x a)).fall(0) (sovereign_case .x source state).fall(0))
     (testing/nat "derived focus is sealed without pretending it is physical" 1 (either/is_ok sealed))
     (testing/nat "changed original invalidates captured derived basis" 0 (goo_runtime/surface_current derived next))
     (testing/nat "old derived focus cannot edit newer input" 1 (either/is_err (goo_runtime/seal_occurrence derived item next)))]
  + reversal
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      target (grove_surface_checks/at 'a)
      before (goo_runtime/record .x target state).fall(myth/new)
      after before.put(['value] (pails/n 40))
      plan (grove_change_plan [(grove_record_edit target (./some before) (./some after))] [])
      next (either/ok_val (grove_install/change target (writ/poke (myth/sing ['value] (pails/n 40))) state))
      later (either/ok_val (grove_install/change target (writ/poke (myth/sing ['unrelated] (pails/t "Later observation"))) next))
      reversed (goo_runtime/reverse_plan plan later)
      restored (either/ok_val reversed).edits.at(0).after.fall(myth/new)
      conflict (either/ok_val (grove_install/change target (writ/poke (myth/sing ['value] (pails/n 41))) later))
      creation (grove_change_plan [(grove_record_edit target .none (./some after))] [])
    [(testing/nat "undo restores only the originally changed slot" 10 restored.nat_at(['value] 0))
     (testing/text "undo preserves later unrelated observations" "Later observation" restored.txt_at(['unrelated]))
     (testing/nat "undo refuses a conflicting later value" 1 (either/is_err (goo_runtime/reverse_plan plan conflict)))
     (testing/nat "creation does not acquire an invented inverse" 1 (either/is_err (goo_runtime/reverse_plan creation later)))]
  + undo_origin
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      key=path ['cells 'a 'value]
      raw (either/ok_val (captured.program.resolve captured.context key myth/new))
      occurrence (either/ok_val (goo_runtime/seal_occurrence captured raw state))
      plan (either/ok_val (captured.program.prepare captured.context occurrence (myth/sing ['value] (pails/n 40))))
      prepared (goo_runtime/prepared_surface_action captured occurrence plan)
      next (either/ok_val (goo_runtime/commit_surface_action prepared state))
      event=path [state.self 'journal 'grove 'events ($ta "original")]
      receipt (grove_surface_wire/receipt "administrator" captured.owner.path
        (grove_surface_wire/basis captured) key myth/new myth/new "native/act" "")
      origin (grove_surface_wire/action_origin captured.binding.implementation occurrence)
      audit (myth/sing grove_surface_wire/receipt_slot receipt).put(grove_surface_wire/change_slot plan).put(grove_surface_wire/origin_slot origin)
      next (either/ok_val (grove_install/change_many [[event (writ/make audit)]] next))
      current (either/ok_val (goo_runtime/capture_surface captured.owner.path myth/new next))
      undo (grove_surface_wire/reverse current "original" "administrator" next)
    ?> (./ok reversed) undo [(testing/text "undo preparation" "ok" (either/err_val undo))]
    = restored (goo_runtime/commit_surface_action reversed next)
    ?> (./ok restored_state) restored [(testing/text "undo application" "ok" (either/err_val restored))]
    =
      target occurrence.focus.source.path
      changed current.set_binding(current.binding.set_implementation(current.binding.implementation.set_ver(99)))
      narrowed current.set_context(current.context.set_inputs([]))
      denied current.set_binding(current.binding.set_writes([]))
      other current.set_owner(current.owner.set_path((grove_surface_checks/at 'other)))
      missing (either/ok_val (grove_install/change_many [[event (writ/make audit.del(grove_surface_wire/origin_slot))]] next))
      forged_scope current.set_binding(current.binding.set_writes([(grove_slot_scope event [grove_surface_wire/origin_slot])]))
      forged_plan (grove_change_plan [(grove_record_edit event (./some audit)
        (./some audit.del(grove_surface_wire/origin_slot)))] [])
    [(testing/nat "undo uses retained correspondence without rerunning a live resolver" 1 (either/is_ok undo))
     (testing/nat "retained occurrence keeps its original native case" occurrence.focus.source.ver
        (either/ok_val undo).occurrence.focus.source.ver)
     (testing/nat "retained undo restores the original slot" 10
        (goo_runtime/record .x target restored_state).fall(myth/new).nat_at(['value] 0))
     (testing/nat "changed implementation requires explicit undo reconciliation" 1
        (either/is_err (grove_surface_wire/reverse changed "original" "administrator" next)))
     (testing/nat "undo cannot leave the current input scope" 1
        (either/is_err (grove_surface_wire/undo_occurrence narrowed origin)))
     (testing/nat "historical correspondence cannot widen current write authority" 1
        (either/is_err (grove_surface_wire/reverse denied "original" "administrator" next)))
     (testing/nat "undo retains the original principal" 1
        (either/is_err (grove_surface_wire/reverse current "original" "agent" next)))
     (testing/nat "undo retains the original surface" 1
        (either/is_err (grove_surface_wire/reverse other "original" "administrator" next)))
     (testing/nat "old receipts without native correspondence fail explicitly" 1
        (either/is_err (grove_surface_wire/reverse current "original" "administrator" missing)))
     (testing/nat "an installed action cannot forge retained correspondence" 1
        (either/is_err (goo_runtime/surface_plan_allowed forged_scope forged_plan next)))]
  + retained
    \ ignored=unit
    ^ row[testing/check]
    = [state captured] (grove_surface_checks/setup [])
      invariant
        \ proposed=goo_runtime/action_assessment
        ^ commitment/verdict
        ? (proposed.plan.edits.all((\ edit (le edit.after.fall(myth/new).nat_at(['value] 0) 50))))
          .holding
        | commitment/verdict/failed "Approved upper bound is 50."
      promise (commitment/retained[goo_runtime/action_assessment] ['upper_bound] captured.owner.path "Values remain at most 50"
        "Customer-endorsed invariant" captured.owner.ver invariant)
      policy (goo_runtime/action_commitments [promise])
      target (grove_surface_checks/at 'a)
      before (goo_runtime/record .x target state).fall(myth/new)
      bad (grove_change_plan [(grove_record_edit target (./some before) (./some before.put(['value] (pails/n 51))))] [])
      good bad.set_edits([(grove_record_edit target (./some before) (./some before.put(['value] (pails/n 50))))])
      findings (goo_runtime/assess_action policy captured.context bad)
      good_findings (goo_runtime/assess_action policy captured.context good)
      verdict_text
        \ verdict=commitment/verdict
        ^ str
        ? verdict
         > .holding "holding"
         > (./failed reason) reason
         > (./unknown reason) reason
      owner (goo_runtime/record .x captured.owner.path state).fall(myth/new)
      installed (either/ok_val (grove_install/change captured.owner.path
        (writ/poke (myth/sing goo_runtime/commitments_slot policy)) state))
      current (either/ok_val (goo_runtime/capture_surface captured.owner.path myth/new installed))
      widened current.set_binding(current.binding.set_writes([(grove_slot_scope captured.owner.path [goo_runtime/commitments_slot])]))
      protected (grove_change_plan [(grove_record_edit captured.owner.path
        (./some owner.put(goo_runtime/commitments_slot policy)) (./some owner))] [])
    [(testing/nat "candidate omitting checks still fails the retained invariant" 0 (commitment/admissible .true findings))
     (testing/nat "the declared boundary value satisfies the same retained checker" 1
        (commitment/admissible .true good_findings))
     (testing/text "the approved checker accepts the boundary directly" "holding"
        (verdict_text (invariant (goo_runtime/action_assessment captured.context good))))
     (testing/text "bounded assessment preserves the successful verdict" "holding"
        (verdict_text good_findings.at(0).verdict))
     (testing/text "findings keep their approved provenance" "Customer-endorsed invariant" findings.at(0).provenance)
     (testing/nat "retained checks fail closed without bounded evaluation" 1 (either/is_err (goo_runtime/surface_plan_allowed current good installed)))
     (testing/nat "even a widened field grant cannot delete retained commitments" 1 (either/is_err (goo_runtime/surface_plan_allowed widened protected installed)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Native repeated surface correspondence" grove_surface_checks/checks)
   (testing/case "Native surface wire boundary" grove_surface_checks/wire)
   (testing/case "Derived native correspondence" grove_surface_checks/derived)
   (testing/case "Scoped native undo" grove_surface_checks/reversal)
   (testing/case "Retained native undo correspondence" grove_surface_checks/undo_origin)
   (testing/case "Independent retained action commitments" grove_surface_checks/retained)]
