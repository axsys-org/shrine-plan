- stdlib/runtime
- tests/namespace [at=fixture]
- stdlib/base

+ context_checks
  + declarations
    ^ goo_context/declarations
    | either/ok_val (goo_context/declare
        [(goo_context/slot ['folder] "address" "key" [['folders]] "push" [] .true)
         (goo_context/slot ['file] "selection" "key" [['rows]] "replace" [['folder]] .false)
         (goo_context/slot ['filter] "filter" "key" [['filters]] "replace" [] .true)]
        [($x 1) 'bridge])
  + record
    ^ myth
    | goo_context/record context_checks/declarations [($x 1) 'kook 'context] myth/new
  + write
    \ slot=path port=path value=str order=nat cur=myth
    ^ either[str myth]
    | goo_context/reduce [($x 1) 'bridge] cur
        (goo_context/stamp port order (myth/sing slot (pails/t value)))
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = first (either/ok_val (context_checks/write ['folder] ['folders] "one" 1 context_checks/record))
      selected (either/ok_val (context_checks/write ['file] ['rows] "file-one" 2 first))
      second (either/ok_val (context_checks/write ['folder] ['folders] "two" 3 selected))
      third (either/ok_val (context_checks/write ['folder] ['folders] "three" 4 second))
      filtered (either/ok_val (context_checks/write ['filter] ['filters] "sealed" 5 third))
      history=goo_context/history
        ?> (./some held) filtered.get(goo_context/history_slot) (goo_context/history [] 0 mop/empty)
        ?> h=goo_context/history held (goo_context/history [] 0 mop/empty)
        h
      dirty selected.put(goo_context/guard_slot (goo_context/guard [['file]]))
    [(testing/nat "dependent file retires atomically" 1 (maybe/is_none (second.get(['file]))))
     (testing/nat "push then replace preserves four history entries" 4 history.entries.len)
     (testing/text "replace is in current history frame" "sealed" (history.entries.at(3).txt_at(['filter])))
     (testing/text "back frame retains channel two" "two" (history.entries.at(2).txt_at(['folder])))
     (testing/nat "newer parent intent supersedes late dependent write" 1
       ?=((./err _) (context_checks/write ['file] ['rows] "late" 2 second)))
     (testing/nat "dirty dependent refuses parent change" 1
       ?=((./err _) (context_checks/write ['folder] ['folders] "two" 3 dirty)))
     (testing/nat "untrusted text port cannot write selection" 1
       ?=((./err _) (context_checks/write ['file] ['rich_link] "forged" 6 filtered)))
     (testing/nat "claimed port without authenticated source is refused" 1
       ?=((./err _) (goo_context/reduce ['out] first
         (goo_context/stamp ['folders] 9 (myth/sing ['folder] (pails/t "forged"))))))]
  + emit
    \ context=bowl cur=myth add=myth
    ^ yell
    | yell [[[($x 1) 'app 'context] (writ/poke add)]] cur
  + namespace_hand
    \ ignored=unit
    ^ row[testing/check]
    = state fixture/namespace_tests/initial
      behavior (form/card (def_form.set_talk(goo_context/talk)) (lore/line "Context hand"))
      state (either/ok_val (grove_install/change [($x 1) 'kook 'context] (writ/make behavior) state))
      bridge_behavior (form/card (def_form.set_talk(context_checks/emit)) (lore/line "Published port bridge"))
      state (either/ok_val (grove_install/change [($x 1) 'kook 'bridge] (writ/make bridge_behavior) state))
      state (either/ok_val (grove_install/change [($x 1) 'bridge]
        (writ/make (myth/sing limb_slot (kook [[($x 1) 'kook 'bridge]]))) state))
      state (either/ok_val (grove_install/change [($x 1) 'app 'context] (writ/make context_checks/record) state))
      request (myth/sing goo_context/intent_slot (goo_context/stamp ['folders] 1 (myth/sing ['folder] (pails/t "accepted"))))
      forged (either/ok_val (grove_install/change [($x 1) 'app 'context] (writ/poke request) state))
      accepted (either/ok_val (grove_install/change [($x 1) 'bridge] (writ/poke request) state))
      card (sovereign_care .x [($x 1) 'app 'context] accepted).fil.fall(myth/new)
      selected (either/ok_val (grove_install/change [($x 1) 'bridge]
        (writ/poke (myth/sing goo_context/intent_slot (goo_context/stamp ['rows] 2 (myth/sing ['file] (pails/t "selected"))))) accepted))
      moved (either/ok_val (grove_install/change [($x 1) 'bridge]
        (writ/poke (myth/sing goo_context/intent_slot (goo_context/stamp ['folders] 3 (myth/sing ['folder] (pails/t "next"))))) selected))
      moved_card (sovereign_care .x [($x 1) 'app 'context] moved).fil.fall(myth/new)
      returned (either/ok_val (grove_install/change [($x 1) 'bridge]
        (writ/poke (myth/sing goo_context/intent_slot (goo_context/traversal 1))) moved))
      returned_card (sovereign_care .x [($x 1) 'app 'context] returned).fil.fall(myth/new)
      hidden (either/ok_val (grove_install/change [($x 1) 'bridge]
        (writ/poke (myth/sing goo_context/intent_slot (goo_context/clear ['rows] 5 [['file]]))) returned))
      hidden_card (sovereign_care .x [($x 1) 'app 'context] hidden).fil.fall(myth/new)
    [(testing/nat "namespace hand actually removes dependent slot" 1 (maybe/is_none (moved_card.get(['file]))))
     (testing/text "namespace history actually restores dependent slot" "selected" (returned_card.txt_at(['file])))
     (testing/nat "namespace clear removes slot without merge resurrection" 1 (maybe/is_none (hidden_card.get(['file]))))
     (testing/nat "unstamped direct write leaves namespace unchanged" 1 (equal state forged))
     (testing/text "registered hand accepts bridge-stamped port in namespace" "accepted" (card.txt_at(['folder])))
     (testing/nat "transient intent never persists" 1 (maybe/is_none (card.get(goo_context/intent_slot))))
     (testing/nat "namespace journal advances on accepted position" 1 (gt accepted.local.top state.local.top))]

  + pails
    \ ignored=unit
    ^ row[testing/check]
    = state fixture/namespace_tests/initial
      state (either/ok_val (grove_install/change [state.self 'app] (writ/make myth/new) state))
      document=path [state.self 'app 'document]
      state (either/ok_val (grove_install/change document (writ/make (myth/sing system_vocabulary/content (pails/t "one / one"))) state))
      revision (state.case(.x document)).fall(0)
      range (goo_context/range document revision 6 9 "one")
      source=path [state.self 'app]
      member (goo_context/member source (goo_context/lifetime source state) document document (goo_context/lifetime document state) revision .y)
      before (goo_context/record (goo_context/declarations [(goo_context/slot ['range] "selection" "range" [['gloss]] "replace" [] .false)] [state.self 'bridge]) [state.self 'kook 'context] myth/new)
      coupled before.put(goo_context/config_slot (goo_context/declarations
        [(goo_context/slot ['gloss] "selection" "key" [['gloss]] "push" [] .false)
         (goo_context/slot ['range] "selection" "range" [['gloss]] "replace" [['gloss]] .false)] [state.self 'bridge]))
      accepted (either/ok_val (goo_context/reduce [state.self 'bridge] coupled
        (goo_context/stamp ['gloss] 1 ((myth/sing ['gloss] (pails/t "gloss-9")).put(['range] range)))))
      blocked coupled.put(goo_context/guard_slot (goo_context/guard [['range]]))
      relation=path [state.self 'app 'stamps]
      edge_path relation.snoc('stamp)
      state (either/ok_val (grove_install/change edge_path
        (writ/make ((myth/sing ['from] (pails/p document)).put(['to] (pails/p document)))) state))
      edge (goo_context/edge relation edge_path (state.case(.x edge_path)).fall(0) document member.life document member.life)
      unstamped (either/ok_val (goo_context/remove_edge edge state))
      removed (either/ok_val (grove_install/change document .cull state))
      recreated (either/ok_val (grove_install/change document (writ/make (myth/sing system_vocabulary/content (pails/t "one / one"))) removed))
    [(testing/nat "second quote accepted by exact offsets" 1 ?=((./ok _) (goo_context/validate_pail range state)))
     (testing/nat "mismatching quote refused" 1 ?=((./err _) (goo_context/validate_pail (range.set_quote("two")) state)))
     (testing/nat "gloss and range accepted together" 1 (and (maybe/is_some (accepted.get(['gloss]))) (maybe/is_some (accepted.get(['range])))))
     (testing/nat "coupled dirty range refuses whole intent" 1
       ?=((./err _) (goo_context/reduce [state.self 'bridge] blocked (goo_context/stamp ['gloss] 1 ((myth/sing ['gloss] (pails/t "gloss-9")).put(['range] range))))))
     (testing/nat "unstamp deletes edge" 1 (maybe/is_none (sovereign_care .x edge_path unstamped).fil))
     (testing/nat "unstamp never changes message case" revision (unstamped.case(.x document)).fall(0))
     (testing/nat "recreated subject invalidates old life" 1 (goo_context/stale member recreated))
     (testing/nat "member remains valid after edge removal" 1 ?=((./ok _) (goo_context/validate_member member unstamped)))
     (testing/nat "aggregate cell refuses edits" 1 ?=((./err _) (goo_context/validate_pail (goo_context/cell member ['name] .none) state)))]

  + history_commands
    \ ignored=unit
    ^ row[testing/check]
    = first (either/ok_val (context_checks/write ['folder] ['folders] "one" 1 context_checks/record))
      selected (either/ok_val (context_checks/write ['file] ['rows] "file-one" 2 first))
      second (either/ok_val (context_checks/write ['folder] ['folders] "two" 3 selected))
      back (either/ok_val (goo_context/command [($x 1) 'bridge] second (goo_context/traversal 1)))
      forward (either/ok_val (goo_context/command [($x 1) 'bridge] back (goo_context/traversal 2)))
      cleared (either/ok_val (goo_context/command [($x 1) 'bridge] back (goo_context/clear ['rows] 8 [['file]])))
      guarded selected.put(goo_context/guard_slot (goo_context/guard [['file]]))
      branched (either/ok_val (context_checks/write ['folder] ['folders] "branch" 9 back))
      history=goo_context/history
        ?> (./some held) branched.get(goo_context/history_slot) (goo_context/history [] 0 mop/empty)
        ?> h=goo_context/history held (goo_context/history [] 0 mop/empty)
        h
    [(testing/text "Back restores dependent selection" "file-one" (back.txt_at(['file])))
     (testing/text "Forward restores parent and cleared selection" "two" (forward.txt_at(['folder])))
     (testing/nat "Forward does not resurrect dependent" 1 (maybe/is_none (forward.get(['file]))))
     (testing/nat "clear removes optional selection" 1 (maybe/is_none (cleared.get(['file]))))
     (testing/nat "clear requires authenticated bridge" 1 ?=((./err _) (goo_context/command ['forged] back (goo_context/clear ['rows] 8 [['file]]))))
     (testing/nat "clear requires declared writer" 1 ?=((./err _) (goo_context/command [($x 1) 'bridge] back (goo_context/clear ['folders] 8 [['file]]))))
     (testing/nat "clear cannot bypass dirty owner" 1 ?=((./err _) (goo_context/command [($x 1) 'bridge] guarded (goo_context/clear ['rows] 8 [['file]]))))
     (testing/nat "travel cannot bypass dirty owner" 1 ?=((./err _) (goo_context/command [($x 1) 'bridge] guarded (goo_context/traversal 0))))
     (testing/nat "travel requires authenticated bridge" 1 ?=((./err _) (goo_context/command ['forged] second (goo_context/traversal 0))))
     (testing/nat "travel refuses missing destination" 1 ?=((./err _) (goo_context/command [($x 1) 'bridge] second (goo_context/traversal 99))))
     (testing/nat "late dependent intent remains superseded after Back" 1 ?=((./err _) (context_checks/write ['file] ['rows] "late" 2 back)))
     (testing/nat "branch truncates forward history" 3 history.entries.len)
     (testing/text "branch replaces old forward destination" "branch" (history.entries.at(2).txt_at(['folder])))]

  + locations
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      subject=path [initial.self 'app 'demo]
      captured (either/ok_val (goo_context/capture_location subject initial))
      branch (either/ok_val (goo_context/capture_location [initial.self 'app] initial))
      system (either/ok_val (goo_context/capture_location ['sys 'types 'text] initial))
      changed (either/ok_val (grove_install/change subject (writ/poke (myth/sing ['extra] (pails/t "hello"))) initial))
      deleted (either/ok_val (grove_install/change subject .cull changed))
      tombstone (either/ok_val (goo_context/capture_location subject deleted))
      recreated (either/ok_val (grove_install/change subject (writ/make myth/new) deleted))
    [(testing/nat "global root is a valid location" 1 ?=((./ok _) (goo_context/capture_location [] initial)))
     (testing/text "structural branch is unknown, not a missing record" "unknown" branch.state)
     (testing/text "system record is browsable" "live" system.state)
     (testing/nat "ordinary record edits preserve followed location" 0 (goo_context/location_stale captured changed))
     (testing/nat "admission refuses outdated record observation" 1 ?=((./err _) (goo_context/validate_pail captured changed)))
     (testing/nat "deleted record invalidates old location" 1 (goo_context/location_stale captured deleted))
     (testing/text "tombstones are browsable" "tombstone" tombstone.state)
     (testing/nat "recreation cannot retarget old live location" 1 (goo_context/location_stale captured recreated))
     (testing/nat "recreation cannot retarget tombstone location" 1 (goo_context/location_stale tombstone recreated))
     (testing/nat "missing paths are refused" 1 ?=((./err _) (goo_context/capture_location [initial.self 'missing] initial)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Physical namespace locations" context_checks/locations)
   (testing/case "History and clear commands" context_checks/history_commands)
   (testing/case "Pail identity and dependent writes" context_checks/pails)
   (testing/case "Context intent semantics" context_checks/checks)
   (testing/case "Namespace context hand" context_checks/namespace_hand)]
