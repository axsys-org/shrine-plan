- helm
- tests/namespace_views [at=views]
- tests/namespace [at=fixture]
- testing

+ namespace_dispatch_tests
  + initialize
    \ context=bowl record=myth
    ^ yell
    = updated | record.put bond/content (fixture/namespace_tests/item 77)
      child | context.here.snoc 'child
    = destination=path
        ? (eq context.here.len 1) [($x 1) 'log 'forged]
        [($x 2) 'remote]
    | yell
      [[child (writ/make (fixture/namespace_tests/record 88))]
       [destination (writ/make (fixture/namespace_tests/record 99))]]
      updated
  + listen
    \ context=bowl record=myth changes=row[dep]
    ^ yell
    ?> (./some view) context.crew.get(bond/content) (yell [] record)
    ?> (./some source) view.fil (yell [] record)
    ?> (./some value) source.get(bond/content) (yell [] record)
    | yell [] record.put(bond/content value)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      implementation=path ['sys 'hand 'fixture]
      behavior (form namespace_dispatch_tests/initialize def_talk def_take def_hear def_dead def_dead)
      shared
        | views/namespace_view_tests/put implementation
          (myth/sing bond/form behavior) (unpin initial.system).state
      operation=path ['sys 'schema 'fixture]
      transform
        \ input=myth current=myth
        ^ myth
        | current.meld input
      shared2
        | views/namespace_view_tests/put operation
          (myth/sing bond/op (op 'fixture 'record [] 'record 0 transform)) shared
      listener=path ['sys 'hand 'listener]
      listen_form (form def_init def_talk def_take namespace_dispatch_tests/listen def_dead def_dead)
      shared3
        | views/namespace_view_tests/put listener (myth/sing bond/form listen_form) shared2
      identity
        \ record=myth
        ^ myth
        record
      shared4
        | views/namespace_view_tests/put ['sys 'view 'identity]
          (myth/sing bond/weft (dyed identity .none)) shared3
      overlay=path ['o ($u 1) ($u 3) 'sys 'view 'identity
                    ($u 3) ($x 1) 'app 'demo]
      watcher
        | (myth/sing limb_slot (kook [listener])).put crew_slot
          (cpail (crew/sing bond/content (dep .x overlay)))
      local
        | views/namespace_view_tests/put [($x 1) 'watcher] watcher initial.local
      state (namespace initial.self local (pin (system_publication shared4.top shared4
            (system_publication/assigned shared4))))
      target=path [($x 1) 'app 'instance]
      record | myth/sing limb_slot (kook [implementation])
      result (sovereign_run_event (task/vine target (writ/make record)) 0 123 4 state)
      next
        ? result
         > (./ripe committed effects signs ack) committed
         > (./fail _) state
      effects
        ? result
         > (./ripe committed effects signs ack) effects.len
         > (./fail _) 0
      warped
        | sovereign_run_event
          (task/vine [($x 1) 'app 'demo]
            (writ/warp operation (fixture/namespace_tests/record 55)))
          0 124 4 next
      after
        ? warped
         > (./ripe committed effects signs ack) committed
         > (./fail _) next
      index | sovereign_hive state
      [rolled_back rollback_index rejected]
        | helm/supervisor/step target (writ/make record) 0 0 state index
      [supervised supervisor_index accepted]
        | helm/supervisor/step [($x 1) 'app 'demo]
          (writ/warp operation (fixture/namespace_tests/record 66)) 0 0 state index
      forbidden=row[path]
        [[] ['sys 'hand 'fixture] [($x 2) 'remote] [($x 1) 'log 'bad]]
      rejected_children=iota
        ? (sovereign_run_event
             (task/vine [($x 1)] (writ/make record)) 0 0 0 state)
         > (./fail why) why
         > (./ripe _ _ _ _) 'accepted
      denied
        | forbidden.all
          \ path
          ? (sovereign_run_event (task/vine path (writ/make record)) 0 0 0 state)
           > (./fail _) .true
           > (./ripe _ _ _ _) .false
    [(testing/nat "system-defined behavior initializes local record" 77
       (fixture/namespace_tests/value (namespace/page .x .none target next)))
     (testing/nat "behavior child command commits locally" 88
       (fixture/namespace_tests/value (namespace/page .x .none (row/snoc[iota] 'child target) next)))
     (testing/nat "foreign effect survives at kernel boundary" 1 effects)
     (testing/nat "system operation transforms local record" 55
       (fixture/namespace_tests/value
         (namespace/page .x .none [($x 1) 'app 'demo] after)))
     (testing/nat "system publication is unchanged" 1 (equal state.system after.system))
     (testing/nat "journal records selected publication" 1
       (equal[maybe[pin[system_publication]]] (./some state.system) (fixture/namespace_tests/journal_system after)))
     (testing/nat "forbidden command targets reject before dispatch" 1 denied)
     (testing/nat "generated journal write rejects entire event"
       (quip_val 'write_outside_authority) (quip_val rejected_children))
     (testing/nat "supervisor rejects outbound candidate atomically" 1
       (equal state rolled_back))
     (testing/nat "supervisor preserves index on rejection" 1
       (equal index rollback_index))
     (testing/nat "derived watcher reads across authorities during cascade" 66
       (fixture/namespace_tests/value
         (namespace/page .x .none [($x 1) 'watcher] supervised)))
     (testing/nat "incremental crew index matches full derivation" 1
       (equal supervisor_index (sovereign_hive supervised)))
     (testing/nat "supervisor commits supported local operation" 66
       (fixture/namespace_tests/value
         (namespace/page .x .none [($x 1) 'app 'demo] supervised)))]

+ tests
  ^ row[testing/case]
  [(testing/case "sovereign dispatch" namespace_dispatch_tests/checks)]
