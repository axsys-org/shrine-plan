- http_foot
- testing

+ journal_tests
  + version
    \ value=nat
    ^ saga
    = head (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0))
      event (log_card (task/vine ['items ($u value)] .cull) .none [])
      record
        ? (eq (mod value 7) 0) (myth/sing ['value] (pd value))
        | myth/sing ['ev] event
    | saga head (pin record)

  + history
    \ value=nat
    ^ tome
    | tome (pin (uon/sing[ass] ($u value) (ass/ker (journal_tests/version value))))

  + state
    ' An isolated physical index fixture, not a live kernel mutation.
    \ count=nat
    ^ sov
    = index
        % n=nat 1 out=axal[tome] (axal/new[tome] .none)
        ? (gt n count) out
        | _ n.inc out.put(['log ($u n)] (journal_tests/history n))
    | sov (ledger [] []) index count (axal/new[urn] .none)

  + page
    \ before=maybe[nat] limit=nat state=sov
    ^ helm/journal_page
    ? (helm/supervisor/journal before limit state)
     > (./ok page) page
     > (./err reason)
       ; (error (helm/supervisor/rejection reason))
       | helm/journal_page 0 .none 1 0 .none (axal/new[saga] .none)

  + keys
    \ page=helm/journal_page
    ^ row[iota]
    | page.view.kid.keys.rev

  + status
    \ target=str
    ^ nat
    ? (http_foot/plan (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./journal before limit) 200
    0

  + attribute
    \ name=nat value=nat
    ^ nat
    | weft/cat [name "=" 34 value 34]

  + query
    \ ignored=unit
    ^ row[testing/check]
    = large=nat 123456789012345678901234567890
      request (http_foot/plan (http_foot/request "GET"
        "/debug/log?before=123456789012345678901234567890&limit=7&view=rendered" "") 0)
      exact=bool
        ? request
         > (./journal before limit)
           ? !(equal before (maybe/some large)) .false
           | eq limit 7
        .false
      defaults=bool
        ? (http_foot/plan (http_foot/request "GET" "/debug/log" "") 0)
         > (./journal before limit)
           ? (maybe/is_some before) .false
           | eq limit 40
        .false
      invalid=row[str]
        ["/debug/log?before=" "/debug/log?before=-1" "/debug/log?before=1.5"
         "/debug/log?before=1e3" "/debug/log?before=+1" "/debug/log?before=%201"
         "/debug/log?before=01" "/debug/log?before=00" "/debug/log?limit=01"
         "/debug/log?before=1&before=2" "/debug/log?before=1&%62efore=2"
         "/debug/log?limit=0" "/debug/log?limit=41" "/debug/log?limit=-1"
         "/debug/log?limit=1.0" "/debug/log?limit=" "/debug/log?limit=3&limit=3"
         "/debug/log?view=other" "/debug/log?view=rendered&view=rendered"
         "/debug/log?offset=40" "/debug/log?care=z" "/debug/log?before=%zz"
         "/debug/log?before=3?limit=2" "/debug/log?limit=3&" "/debug/log?=1"]
      rejected (row/all[str] (\ url=str (eq 400 (journal_tests/status url))) invalid)
      zero (journal_tests/status "/debug/log?before=0&limit=1")
      mode (journal_tests/status "/debug/log?view=rendered")
    [(testing/nat "collection bypasses HTTP namespace records" 1 defaults)
     (testing/nat "arbitrary precision decimal cursor" 1 exact)
     (testing/nat "all invalid duplicate and unknown queries reject" 1 rejected)
     (testing/nat "zero cursor is a valid exclusive lower boundary" 200 zero)
     (testing/nat "client rendered mode is accepted" 200 mode)
     (testing/nat "encoded collection path uses same bounded route" 200
       (journal_tests/status "/debug/%6Cog?limit=2"))]

  + bounds
    \ ignored=unit
    ^ row[testing/check]
    = state (journal_tests/state 3)
      first (journal_tests/page .none 2 state)
      last (journal_tests/page first.next 2 state)
      empty (journal_tests/page .none 40 sov/new)
      below (journal_tests/page (./some 1) 40 state)
      invalid (helm/supervisor/journal .none 41 state)
      zero_limit (helm/supervisor/journal .none 0 state)
      foreign state.set_idx(state.idx.put(['log 'foreign] (journal_tests/history 1)))
    [(testing/nat "page contains exact requested children" 2 first.view.kid.size)
     (testing/nat "total is whole physical collection" 3 first.total)
     (testing/nat "epoch captured" 3 first.epoch)
     (testing/nat "cursor is last displayed key, not lookahead" 1 (equal first.next (maybe/some 2)))
     (testing/nat "exclusive next page" 1 (equal (journal_tests/keys last) [($u 1)]))
     (testing/nat "end has no next cursor" 1 (maybe/is_none last.next))
     (testing/nat "empty journal is a successful empty page" 0 empty.view.kid.size)
     (testing/nat "empty total" 0 empty.total)
     (testing/nat "minimum excluded" 0 below.view.kid.size)
     (testing/nat "supervisor independently validates limit" 1 (either/is_err invalid))
     (testing/nat "supervisor rejects zero limit" 1 (either/is_err zero_limit))
     (testing/nat "nonnumeric physical keys fail explicitly" 1
       (either/is_err (helm/supervisor/journal .none 40 foreign)))]

  + large
    \ ignored=unit
    ^ row[testing/check]
    = state (journal_tests/state 10000)
      index (hive_of sov/new)
      [unchanged same_index answer]
        | helm/supervisor/handle (helm/card/journal 17 .none 40) state index
      page=helm/journal_page
        ? answer
         > (feet/task/journal request result)
           ? result
            > (./ok value) value
           | journal_tests/page .none 1 sov/new
        | journal_tests/page .none 1 sov/new
      second (journal_tests/page page.next 40 state)
      grown state.set_idx(state.idx.put(['log ($u 10001)] (journal_tests/history 10001))).set_top(10001)
      stable (journal_tests/page page.next 40 grown)
      deleted state.set_idx(state.idx.lop(['log ($u 9961)]))
      after_deleted (journal_tests/page page.next 40 deleted)
      html (debugger/journal_page page)
      expected (row/map[nat iota] dig_show (row/range 9961 10001).rev)
    [(testing/nat "10k keys do not grow displayed page" 40 page.view.kid.size)
     (testing/nat "large physical total is exact" 10000 page.total)
     (testing/nat "display order is newest first" 1 (equal expected (journal_tests/keys page)))
     (testing/nat "read preserves entire sovereign" 1 (equal state unchanged))
     (testing/nat "read preserves reactive index" 1 (equal index same_index))
     (testing/nat "newer insertion cannot shift the older page" 1 (equal second.view stable.view))
     (testing/nat "deleted exclusive cursor still seeks the same older keys" 1
       (equal second.view after_deleted.view))
     (testing/nat "HTML event rows are bounded including malformed payloads" 40
       (cord/count (journal_tests/attribute "class" "debug-event") html))
     (testing/nat "HTML serialized children use the identical page" 40
       (cord/count (journal_tests/attribute "data-shrine-lane" "1") html))
     (testing/nat "malformed physical entry remains a permalink" 1
       (cord/has "/debug/log/9996" html))
     (testing/nat "unselected old entry is not serialized" 0
       (cord/has "/debug/log/9950" html))
     (testing/nat "lookahead entry is not serialized" 0
       (cord/has "/debug/log/9960" html))
     (testing/nat "no old unbounded paths disclosure" 0 (cord/has "debug-older-events" html))
     (testing/nat "paging feature flag" 1 (cord/has (journal_tests/attribute "data-paging" "journal") html))
     (testing/nat "exact total metadata" 1 (cord/has (journal_tests/attribute "data-child-count" "10000") html))
     (testing/nat "captured epoch metadata" 1 (cord/has (journal_tests/attribute "data-page-epoch" "10000") html))
     (testing/nat "exclusive next cursor metadata" 1 (cord/has (journal_tests/attribute "data-page-next-before" "9961") html))
     (testing/nat "older link has real cursor" 1 (cord/has "before=9961" html))]

  + physical
    \ ignored=unit
    ^ row[testing/check]
    = initial (journal_tests/state 3)
      structural initial.set_idx(initial.idx.del(['log ($u 3)]).put(
        ['log ($u 3) 'deep 'hidden] (journal_tests/history 1)))
      page (journal_tests/page .none 2 structural)
      child page.view.dip([($u 3)])
      html (debugger/journal_page page)
      exact (journal_tests/page .none 40 (journal_tests/state 40))
      overflow (journal_tests/page .none 40 (journal_tests/state 41))
    [(testing/nat "structural event key occupies a real page slot" 1
       (equal (journal_tests/keys page) [($u 3) ($u 2)]))
     (testing/nat "structural event has no invented own record" 1 (maybe/is_none child.fil))
     (testing/nat "selected event descendants are not hydrated" 0 child.kid.size)
     (testing/nat "structural event remains a permalink" 1 (cord/has "/debug/log/3" html))
     (testing/nat "event descendants are not serialized" 0 (cord/has "/debug/log/3/deep" html))
     (testing/nat "exactly full last page has no older cursor" 1 (maybe/is_none exact.next))
     (testing/nat "one physical lookahead produces the last displayed cursor" 1
       (equal overflow.next (maybe/some 2)))]

  + actor
    \ ignored=unit
    ^ row[testing/check]
    = initial (journal_tests/state 3)
      ;server (Spawn (helm/supervisor/run initial))
    ; (SendCaps server (helm/card/journal 99 .none 2) [0])
    = ;[first caps] (Recv[feet/task[unit]] 0)
    ; (SendCaps server (helm/card/journal 100 .none 2) [0])
    = ;[second more] (Recv[feet/task[unit]] 0)
      first_ok=bool
        ? first
         > (feet/task/journal request result)
           ? result
            > (./ok page)
              ? !(eq request 99) .false
              ? !(eq page.epoch 3) .false
              | eq page.total 3
           .false
        .false
      second_ok=bool
        ? second
         > (feet/task/journal request result)
           ? result
            > (./ok page)
              ? !(eq request 100) .false
              ? !(eq page.epoch 3) .false
              | eq page.total 3
           .false
        .false
    ; (CloseHandle server)
    [(testing/nat "native actor returns correlated page" 1 first_ok)
     (testing/nat "repeated actor reads do not create epochs or entries" 1 second_ok)
     (testing/nat "foot gift normalizes to read-only card" 1
       (equal (feet/gift/normalize ['io 'http] (feet/gift/journal 8 .none 2))
         (maybe/some (helm/card/journal 8 .none 2))))]

+ tests
  ^ row[testing/case]
  [(testing/case "strict journal query contract" journal_tests/query)
   (testing/case "bounded physical snapshot" journal_tests/bounds)
   (testing/case "large journal rendering and state preservation" journal_tests/large)
   (testing/case "structural entries and physical page boundaries" journal_tests/physical)
   (testing/case "read-only native supervisor transport" journal_tests/actor)]
