- grove_install
- testing
- tests/grove_install [at=installer]

+ grove_template_checks
  + seed
    \ name=path change=note state=namespace
    ^ namespace
    = diffs | (axal/new[note] .none).put(name change)
    ? (namespace/step diffs 0 0 state)
     > (./accepted committed) committed.state
     > (./rejected _) state
  + state
    \ template=grove_template
    ^ namespace
    | grove_template_checks/seed [($x 17) 'defs]
      (note/make (myth/sing grove_templates/slot template))
      (installer/grove_install_checks/bootstrap [])
  + reason
    \ expected=iota result=either[iota namespace]
    ^ bool
    ? result
     > (./err reason) (eq_iota expected reason)
     > (./ok _) .false
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = source=path [($x 17) 'defs 'queue]
      literal=path [($x 17) 'defs 'cards]
      card (myth/sing ['sys 'weft] (safe 1 .x source))
      card card.put(['sys 'tack] (grove_instance_ref .y ['cards]))
      card card.put([($x 17) 'vocabulary 'literal] (pails/p literal))
      template (grove_template grove_templates/version [[['next] card]])
      entries (grove_templates/records [($x 17) 'app 'one] template)
      [name record] entries.at(0)
      intact (equal record.get([($x 17) 'vocabulary 'literal]) card.get([($x 17) 'vocabulary 'literal]))
      code (equal record.get(['sys 'weft]) card.get(['sys 'weft]))
      input
        | equal record.get(['sys 'tack])
            (maybe/some[pail] (safe 1 .y [($x 17) 'app 'one 'cards]))
      state (grove_template_checks/state template)
      missing (grove_install/instantiate [($x 17) 'defs] 1 [($x 17) 'app] state)
      first
        | grove_template_checks/seed source
          (note/make (myth/sing ['sys 'content] (pd 1)))
          (installer/grove_install_checks/bootstrap [])
      revised
        | grove_template_checks/seed source
          (note/poke (myth/sing ['sys 'content] (pd 2))) first
      pinned_card | myth/sing ['sys 'weft] (safe 1 .x source)
      pinned_template | grove_template grove_templates/version [[[] pinned_card]]
      published
        | grove_template_checks/seed [($x 17) 'defs]
          (note/make (myth/sing grove_templates/slot pinned_template)) revised
      retained
        ? (grove_install/instantiate [($x 17) 'defs] 1 [($x 17) 'app 'test] published)
         > (./ok installed)
           = held | (sovereign_peek [($x 17) 'app 'test] installed).fil
           ?> (./some record) held .false
           | equal record.get(['sys 'weft]) pinned_card.get(['sys 'weft])
         > (./err _) .false
      opaque_marker
        | grove_template grove_templates/version
          [[[] (myth/sing [($x 17) 'vocabulary 'custom] (grove_instance_ref .x ['absent]))]]
      unresolved
        | grove_install/instantiate [($x 17) 'defs] 1 [($x 17) 'app]
          (grove_template_checks/state opaque_marker)
      future (grove_template_checks/state template.set_version(99))
      incompatible
        | grove_install/instantiate [($x 17) 'defs] 1 [($x 17) 'app] future
    [(testing/nat "instance paths rebase" 1
        (equal[path] name [($x 17) 'app 'one 'next]))
     (testing/nat "opaque path values stay absolute" 1 intact)
     (testing/nat "definition code stays shared" 1 code)
     (testing/nat "explicit local inputs rebase" 1 input)
     (testing/nat "missing targets reject" 1
        (grove_template_checks/reason 'unresolved_instance_reference
          missing))
     (testing/nat "instance markers in publisher slots must resolve" 1
        (grove_template_checks/reason 'unresolved_instance_reference unresolved))
     (testing/nat "installation preserves an older published pin" 1 retained)
     (testing/nat "unknown template formats reject" 1
        (grove_template_checks/reason 'grove_template_version
          incompatible))]

+ tests
  ^ row[testing/case]
  [(testing/case "Grove instance templates" grove_template_checks/checks)]
