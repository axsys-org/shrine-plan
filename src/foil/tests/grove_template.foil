- grove_install
- testing

+ grove_template_checks
  + state
    \ template=grove_template
    ^ sov
    = command
        | task/vine ['defs]
          (writ/make (myth/sing grove_templates/slot template))
    ? (run_event command 0 sov/new)
     > (./ripe next effects signs ack) next
    sov/new
  + reason
    \ expected=iota result=either[iota sov]
    ^ bool
    ? result
     > (./err reason) (eq_iota expected reason)
     > (./ok _) .false
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = source=path ['defs 'queue]
      literal=path ['defs 'cards]
      card (myth/sing ['sys 'weft] (safe 1 .x source))
      card card.put(['sys 'tack] (grove_instance_ref .y ['cards]))
      card card.put(['literal] (pails/p literal))
      template (grove_template 1 [[['next] card]])
      entries (grove_templates/records ['app 'one] template)
      [name record] entries.at(0)
      intact (equal record.get(['literal]) card.get(['literal]))
      code (equal record.get(['sys 'weft]) card.get(['sys 'weft]))
      input
        | equal record.get(['sys 'tack])
            (maybe/some[pail] (safe 1 .y ['app 'one 'cards]))
      state (grove_template_checks/state template)
      missing (grove_install/instantiate ['defs] 1 ['app] state)
      future (grove_template_checks/state template.set_version(99))
      incompatible
        | grove_install/instantiate ['defs] 1 ['app] future
    [(testing/nat "instance paths rebase" 1
        (equal[path] name ['app 'one 'next]))
     (testing/nat "opaque path values stay absolute" 1 intact)
     (testing/nat "definition code stays shared" 1 code)
     (testing/nat "explicit local inputs rebase" 1 input)
     (testing/nat "missing targets reject" 1
        (grove_template_checks/reason 'missing_installation_target
          missing))
     (testing/nat "unknown template formats reject" 1
        (grove_template_checks/reason 'grove_template_version
          incompatible))]

+ tests
  ^ row[testing/case]
  [(testing/case "Grove instance templates" grove_template_checks/checks)]
