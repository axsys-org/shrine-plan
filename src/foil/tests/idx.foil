- namespace
- tests/namespace [at=fixture]
- stdlib/base

' Backward indexes as the commit maintains them: rebuild and incremental
' filing agree, crashing wings file nothing, content is kernel-owned, and
' the kernel's dependency index matches the watcher index it replaced.
+ idx_tests
  + tags
    ' File a record under each path listed at ['tags].
    \ name=path record=myth
    ^ myth
    ?> (./some held) record.get(['tags]) myth/new
    ?> listed=pails/ps held myth/new
    | listed.ps.fold myth/new
      \ out tag
      | out.put tag (pails/n 1)

  + fragile
    ' Tags, except that a ['boom] record crashes outright and a ['lazy]
    ' record files an entry whose payload crashes only when forced.
    \ name=path record=myth
    ^ myth
    ? record.has(['boom])
      = ;crash=nat (error (pails/n 7))
      myth/new
    ? record.has(['lazy])
      | myth/sing ['lazy] (pails/n (error (pails/n 8)))
    | idx_tests/tags name record

  + declaration
    \ w={\ path myth}myth c=care p=path
    ^ myth
    | (myth/sing ['sys 'limb] (wing w)).put ['sys 'tack] (hunt c p)

  + note
    \ tags=row[path]
    ^ myth
    | myth/sing ['tags] (pails/ps tags)

  + watcher
    \ watched=path
    ^ myth
    | myth/sing ['sys 'crew] (cpail (crew/sing ['view] (dep .y watched)))

  + write
    \ name=path change=note state=namespace
    ^ namespace
    ? (namespace/step ((axal/new[note] .none).put(name change)) 0 0 state)
     > (./accepted done) done.state
     > (./rejected _) state

  + make
    \ name=path record=myth state=namespace
    ^ namespace
    | idx_tests/write name (note/make record) state

  + refusal
    \ name=path change=note state=namespace
    ^ nat
    ? (namespace/step ((axal/new[note] .none).put(name change)) 0 0 state)
     > (./accepted _) 0
     > (./rejected why) (quip_val why)

  + filed
    ' The entry source filed under key in the index at declaration.
    \ declaration=path key=path source=path state=namespace
    ^ bool
    ?> (./some record) (idx/record_at declaration.weld((idx/slot key)) state.local) .false
    | record.has(source)

  + width
    ' How many sources are filed under key.
    \ declaration=path key=path state=namespace
    ^ nat
    ?> (./some record) (idx/record_at declaration.weld((idx/slot key)) state.local) 0
    record.size

  + content
    \ declaration=path state=namespace
    ^ axal[myth]
    | (idx/live declaration state.local).del []

  + flat
    ' Content in canonical order: trees and records compare by entries,
    ' since their balanced shapes depend on insertion history.
    \ declaration=path state=namespace
    ^ row[[p=path q=row[[k=path v=pail]]]]
    = start=row[[p=path q=row[[k=path v=pail]]]] []
      none=row[[k=path v=pail]] []
    | (idx_tests/content declaration state).tap.fold start
      \ out [name record]
      = slots | record.tap.fold none (\ acc e acc.snoc([e.key e.val]))
      | out.snoc [name slots]

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      self ($x 1)
      notes=path [self 'notes]
      at=path [self 'notes 'idx 'tags]
      again=path [self 'notes 'idx 'again]
      red=path ['red]
      blue=path ['blue]
      green=path ['green]
      a=path [self 'notes 'a]
      b=path [self 'notes 'b]
      c=path [self 'notes 'c]
      d=path [self 'notes 'd]
      tagged (idx_tests/declaration idx_tests/tags .z [])
      ' Sources first, so the declaration's arrival rebuilds over them.
      s1 | idx_tests/make a (idx_tests/note [red]) initial
      s2 | idx_tests/make b (idx_tests/note [red blue]) s1
      s3 | idx_tests/make at tagged s2
      ' Then incremental changes: a new source, a retag, a removal.
      s4 | idx_tests/make c (idx_tests/note [green]) s3
      s5 | idx_tests/make b (idx_tests/note [green]) s4
      s6 | idx_tests/write a .cull s5
      ' A second declaration rebuilt from scratch over the same state.
      s7 | idx_tests/make again tagged s6
      ' A poke that leaves the claim alone keeps the index incremental.
      s8 | idx_tests/write at (note/poke (myth/sing ['sys 'lede] (pails/t "tags"))) s7
      s9 | idx_tests/make d (idx_tests/note [blue]) s8
      fragile=path [self 'notes 'idx 'fragile]
      f1 | idx_tests/make fragile (idx_tests/declaration idx_tests/fragile .z []) s9
      boom=path [self 'notes 'boom]
      lazy=path [self 'notes 'lazy]
      f2 | idx_tests/make boom (idx_tests/note [red]).put(['boom] (pails/n 1)) f1
      f3 | idx_tests/make lazy (idx_tests/note [red]).put(['lazy] (pails/n 1)) f2
      retired | idx_tests/write fragile .cull f3
      occupied=path [self 'held 'idx 'n]
      o1 | idx_tests/make occupied.snoc('x) (idx_tests/note []) s9
      ' The kernel's own index.
      watched=path [self 'notes 'b]
      w=path [self 'app 'watcher]
      k1 | idx_tests/make w (idx_tests/watcher watched) s9
      k2 | idx_tests/make w (idx_tests/watcher c) k1
      home (idx/deps/home self)
    [(testing/nat "rebuild files existing sources" 1
       (and (idx_tests/filed at red a s3) (idx_tests/filed at red b s3)))
     (testing/nat "rebuild files every key" 1 (idx_tests/filed at blue b s3))
     (testing/nat "incremental files a new source" 1 (idx_tests/filed at green c s4))
     (testing/nat "a retag leaves its old key" 0 (idx_tests/filed at blue b s5))
     (testing/nat "a retag joins its new key" 2 (idx_tests/width at green s5))
     (testing/nat "a removed source leaves" 0 (idx_tests/width at red s6))
     (testing/nat "an emptied key culls its record" 1
       ?=(.null (s6.local.x_latest(at.weld((idx/slot red))))))
     (testing/nat "incremental agrees with rebuild" 1
       (equal (idx_tests/flat at s7) (idx_tests/flat again s7)))
     (testing/nat "an unchanged claim keeps filing" 1 (idx_tests/filed at blue d s9))
     (testing/nat "and still agrees with rebuild" 1
       (equal (idx_tests/flat at s9) (idx_tests/flat again s9)))
     (testing/nat "a crashing wing never rejects" 1 (idx/record_at boom f2.local).is_some)
     (testing/nat "a crash files nothing" 0 (idx_tests/filed fragile red boom f2))
     (testing/nat "a forced lazy crash files nothing" 0 (idx_tests/width fragile ['lazy] f3))
     (testing/nat "other sources still file" 1 (idx_tests/filed fragile green b f3))
     (testing/nat "retiring a declaration buries its content" 0
       (idx_tests/content fragile retired).wyt)
     (testing/nat "content is kernel-owned" (quip_val 'idx_reserved)
       (idx_tests/refusal at.weld((idx/slot red)) (note/make (idx_tests/note [])) s9))
     (testing/nat "a declaration may not claim data" (quip_val 'idx_occupied)
       (idx_tests/refusal occupied (note/make tagged) o1))
     (testing/nat "the kernel declares its index" 1
       (equal (idx/claim_at home s9.local) (idx/read idx/deps/declaration)))
     (testing/nat "the kernel declaration is protected" (quip_val 'idx_kernel)
       (idx_tests/refusal home .cull s9))
     (testing/nat "a crew files under its watched path" 1 (idx_tests/filed home watched w k1))
     (testing/nat "a moved crew refiles" 1
       (and !(idx_tests/filed home watched w k2) (idx_tests/filed home c w k2)))
     (testing/nat "the index matches the derived watcher index" 1
       (equal (sovereign_watchers k2).tap (eyes_from (sovereign_hive k2)).tap))]

+ tests
  ^ row[testing/case]
  [(testing/case "backward indexes" idx_tests/checks)]
