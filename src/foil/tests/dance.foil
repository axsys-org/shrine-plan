- eden_store
- helm
- net
- testing
- tests/namespace [at=fixture]
- tests/net [at=shared]

' This test tells if two worlds can drive each other with records, crews and
' hands only. 0x18 asks and 0x17 answers:
' - An ask is a record below /0x18/our/0x17/ask. It crosses as each record of
'   that root crosses.
' - 0x17 has a node with a hand. The crew of the node is the children of the
'   asks, by the name that 0x18 gave them: 0x17 holds them in the store that
'   it keeps for 0x18. The hand makes one answer for each ask.
' - An answer is a record below /0x17/our/0x18/answer. It crosses in the same
'   way.
' - 0x18 has a node with a hand. The crew of the node is one answer, by the
'   name that 0x17 gave it.
'
' There is no transport. The test passes the epic that a foot carries when a
' transport is there. No hand reads or writes a card, an epic or a version.
+ dance
  + answering
    ' This is the hand of the node that answers. It makes one answer for each
    ' ask that this world holds.
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    = none=row[[p=path q=writ]] []
      base=path [b.here.at(0) 'our ($x 18) 'answer]
    ?> (./some asks) b.crew.get(['asks]) (yell none cur)
    = cards
        | asks.kid_tap.fold none
          \ out=row[[p=path q=writ]] [name tree]
          ^ row[[p=path q=writ]]
          ?> (./some ask) tree.fil out
          | out.snoc([base.snoc(name) (writ/make (myth/sing ['unit] (pails/n (mul 2 ask.nat_at(['qty] 0)))))])
    | yell cards cur
  + hearing
    ' This is the hand of the node that asked. It keeps what the answer says.
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    = none=row[[p=path q=writ]] []
    ?> (./some tree) b.crew.get(['answer]) (yell none cur)
    ?> (./some answer) tree.fil (yell none cur)
    | yell none cur.put(['unit] (pails/n answer.nat_at(['unit] 0))).put(['state] (pails/n 1))
  + apply
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (eden_store/changes writes state)
     > (./ok next) next
     > (./err why) state
  + world
    ' It gives a world with its card for the other world, and the root that it
    ' publishes to that world.
    \ n=nat other=nat
    ^ namespace
    = self=iota ($x n)
      start (namespace self sov/new (fixture/namespace_tests/initial).system (mop/empty))
      writes=row[[p=path q=writ]] [[[self 'io 'mesa ($x other)] (writ/make (myth/sing ['port] (pails/n 1)))]
        [[self 'our ($x other)] (writ/make (myth/sing ['value] (pails/n 1)))]]
    | dance/apply writes start
  + node
    ' It gives the record of a node: its behaviour and its crew of one
    ' dependency.
    \ hand=path slot=path care=care name=path
    ^ myth
    | (myth/sing limb_slot (kook [hand])).put(crew_slot (cpail (crew/sing slot (dep care name))))
  + seller
    ^ namespace
    = self=iota ($x 17)
      hand=path [self 'kook 'desk]
      asks=path [($x 18) 'our self 'ask]
      first=row[[p=path q=writ]] [[hand (writ/make (form/card def_form.set_hear(dance/answering) (lore/line "Answers asks")))]]
      second=row[[p=path q=writ]] [[[self 'app 'desk] (writ/make (dance/node hand ['asks] .y asks))]]
    | dance/apply second (dance/apply first (dance/world 17 18))
  + buyer
    ^ namespace
    = self=iota ($x 18)
      hand=path [self 'kook 'order]
      answer=path [($x 17) 'our self 'answer 'q1]
      first=row[[p=path q=writ]] [[hand (writ/make (form/card def_form.set_hear(dance/hearing) (lore/line "Hears an answer")))]]
      second=row[[p=path q=writ]] [[[self 'app 'order] (writ/make (dance/node hand ['answer] .x answer))]]
    | dance/apply second (dance/apply first (dance/world 18 17))
  + head
    \ root=path state=namespace
    ^ nat
    | state.case(.z root).fall(0)
  + carry
    ' It does what the two feet do: it lands in the reader what the publisher
    ' holds now below the root that it publishes to the reader, from where
    ' the reader stands.
    \ from=nat publisher=namespace to=nat reader=namespace
    ^ namespace
    = root=path [($x from) 'our ($x to)]
      card=path [($x to) 'io 'mesa ($x from)]
      base (net/held ['head] card reader)
    ?> (./some change) (net/delta 0 root base (dance/head root publisher) publisher) reader
    ? (net/land root card change reader)
     > (./err why) reader
     > (./ok plan)
      ? (shared/net_tests/admit ($x from) plan reader)
       > (./err why) reader
       > (./ok next) next
  + value
    \ slot=path name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(slot 0)
  + checks
    \ _=unit
    ^ row[testing/check]
    = ask=path [($x 18) 'our ($x 17) 'ask]
      answer=path [($x 17) 'our ($x 18) 'answer]
      order=path [($x 18) 'app 'order]
      asked=row[[p=path q=writ]] [[ask (writ/make myth/new)]
        [ask.snoc('q1) (writ/make (myth/sing ['qty] (pails/n 40)))]]
      b1 (dance/apply asked dance/buyer)
      a1 (dance/carry 18 b1 17 dance/seller)
      b2 (dance/carry 17 a1 18 b1)
      more=row[[p=path q=writ]] [[ask.snoc('q2) (writ/make (myth/sing ['qty] (pails/n 5)))]]
      b3 (dance/apply more b2)
      a2 (dance/carry 18 b3 17 a1)
      b4 (dance/carry 17 a2 18 b3)
      a3 (dance/carry 18 b4 17 a2)
    [(testing/nat "the ask crosses as a record, under the name that the buyer gave it" 40 (dance/value ['qty] ask.snoc('q1) a1))
     (testing/nat "the seller holds it in the store that it keeps for the buyer, and not in its own names" 0 (maybe/is_some a1.local.x_case(ask.snoc('q1))))
     (testing/nat "the hand of the seller makes the answer" 80 (dance/value ['unit] answer.snoc('q1) a1))
     (testing/nat "the answer crosses as a record" 80 (dance/value ['unit] answer.snoc('q1) b2))
     (testing/nat "the hand of the buyer hears it" 80 (dance/value ['unit] order b2))
     (testing/nat "and the order is done" 1 (dance/value ['state] order b2))
     (testing/nat "a second ask is a second child" 5 (dance/value ['qty] ask.snoc('q2) a2))
     (testing/nat "and the seller makes a second answer" 10 (dance/value ['unit] answer.snoc('q2) a2))
     (testing/nat "which crosses" 10 (dance/value ['unit] answer.snoc('q2) b4))
     (testing/nat "the first answer is as it was" 80 (dance/value ['unit] answer.snoc('q1) b4))
     (testing/nat "at rest, nothing more crosses to the seller" a2.local.top a3.local.top)]

+ tests
  ^ row[testing/case]
  [(testing/case "an ask is a child, an answer is a child, and hands drive the exchange" dance/checks)]
