- lain_peek
- tests/namespace [at=fixture]
- testing

+ namespace_view_tests
  + put
    \ name=path record=myth state=sov
    ^ sov
    = diffs | (axal/new[note] .none).put name (note/make record)
    ? (sov/step diffs 0 0 state)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       next
     > (./rejected _) state
  + value
    \ answer=res[axal[myth]]
    ^ nat
    ?> (./known records) answer 0
    ?> (./some record) records.fil 0
    ?> (./some held) record.get(bond/content) 0
    | fixture/namespace_tests/unwrap held
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      target=path [($x 1) 'app 'demo]
      lens=path ['sys 'view 'identity]
      identity
        \ record=myth
        ^ myth
        record
      render
        \ record=myth children=axal[myth]
        ^ axal[myth]
        children
      system
        | namespace_view_tests/put lens
          (myth/sing bond/weft (dyed identity .none))
          (unpin initial.system).state
      system2
        | namespace_view_tests/put ['sys 'view 'children]
          (myth/sing bond/weft (spun render .none)) system
      local
        | fixture/namespace_tests/seed target 33 initial.local
      empty myth/new
      view_record
        | empty.gas
          [[bond/weft (safe 1 .x ['sys 'view 'children])]
           [bond/tack (safe 1 .y target)]]
      local2
        | namespace_view_tests/put [($x 1) 'render] view_record local
      state
        | namespace initial.self local2
          (pin (system_publication system2.top system2
            (system_publication/assigned system2)))
      overlay=path ['o ($u 1) ($u 3) 'sys 'view 'identity
                    ($u 3) ($x 1) 'app 'demo]
      historical=path ['h 'x ($u 1) ($u 3) ($x 1) 'app 'demo]
      shared_history=path ['h 'x ($u 1) ($u 3) 'sys 'types 'text]
      pending
        | (axal/new[note] .none).gas
          [[target (note/make (fixture/namespace_tests/record 44))]
           [['sys 'types 'text] (note/make (fixture/namespace_tests/record 99))]
           [[($x 2) 'app] (note/make (fixture/namespace_tests/record 99))]]
      transaction | worm pending [] 0 [] (axal/new[mode] .none) 0 0
      dependencies
        | myth/sing crew_slot
          (cpail (crew/sing bond/content (dep .x target)))
      hydrated | sovereign_crew_of (./some dependencies) state
      crew_value
        ?> (./some records) hydrated.get(bond/content) 0
        | namespace_view_tests/value (./known records)
      root | sovereign_view .z 0 [] state
      root_count
        ? root
         > (./known records) records.kid_tap.len
        0
    [(testing/nat "local reads include pending changes" 44
       (namespace_view_tests/value
         (./known (sovereign_read .x target transaction state))))
     (testing/nat "system reads ignore pending changes" 11
       (namespace_view_tests/value
         (./known (sovereign_read .x ['sys 'types 'text] transaction state))))
     (testing/nat "foreign pending changes are invisible" 0
       (sovereign_read .x [($x 2) 'app] transaction state).wyt)
     (testing/nat "crew hydration stays committed" 33 crew_value)
     (testing/nat "derived reader composes both roots" 2 root_count)
     (testing/nat "local historical target" 22
       (namespace_view_tests/value (sovereign_view .x 0 historical state)))
     (testing/nat "system historical target" 11
       (namespace_view_tests/value (sovereign_view .x 0 shared_history state)))
     (testing/nat "system overlay reads local latest case" 33
       (namespace_view_tests/value (sovereign_view .x 0 overlay state)))
     (testing/nat "system overlay reads local first case" 22
       (namespace_view_tests/value (sovereign_view .x 1 overlay state)))
     (testing/nat "spun resolves inputs across authorities" 22
       (namespace_view_tests/value
         (sovereign_view .x 0 ['x ($x 1) 'render] state)))
     (testing/nat "global historical epoch is rejected" 1
       ?=(.unknown (sovereign_view .x 0 ['h 'x 'e1 ($u 0)] state)))
     (testing/nat "foreign authority is unresolved" 1
       ?=(.unknown (sovereign_view .x 0 [($x 2) 'app] state)))]

+ tests
  ^ row[testing/case]
  [(testing/case "sovereign derived views" namespace_view_tests/checks)
   (testing/case "authority-local version views" namespace_view_tests/versions)
   (testing/case "frontier projection" namespace_view_tests/frontiers)
   (testing/case "exact read projection" namespace_view_tests/exacts)]

+ namespace_view_tests
  + frontiers
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      parent=path [initial.self 'app]
      child=path [initial.self 'app 'nested 'leaf]
      before | fixture/namespace_tests/seed child 55 initial.local
      after | fixture/namespace_tests/seed parent 66 before
      state | initial.set_local after
      cares=row[care] [.x .y .z]
      same
        \ c=care
        | equal[axal[myth]] (sorge[myth] c (sovereign_peek [] state))
          (sovereign_care c [] state)
      hydrated_same
        \ c=care
        = record | myth/sing crew_slot (cpail (crew/sing bond/content (dep c [])))
          hydrated | sovereign_crew_of (./some record) state
        ?> (./some records) hydrated.get(bond/content) .false
        | equal[axal[myth]] records (sorge[myth] c (sovereign_peek [] state))
    [(testing/nat "committed root care matches subtree restriction" 1 cares.all(same))
     (testing/nat "root crew hydration preserves requested care" 1 cares.all(hydrated_same))
     (testing/nat "global frontier matches full projection" 1
       (equal[axal[saga]] (namespace/root .z state).snip (namespace/root .y state)))
     (testing/nat "historical frontier passes through unasserted paths" 1
       (equal[axal[saga]] (namespace/records before.top [] after).snip
         (namespace/frontier before.top [] after)))
     (testing/nat "frontier stops at a live parent" 1
       (equal[axal[saga]] (namespace/records after.top [] after).snip
         (namespace/frontier after.top [] after)))
     (testing/nat "subtree frontier retains its root" 1
       (equal[axal[saga]] (namespace/records after.top parent after).snip
         (namespace/frontier after.top parent after)))]

  + version
    \ requested=path state=namespace
    ^ str
    ?> (./known tree) (sovereign_view .y 0 requested state) "missing"
    ?> (./some record) tree.fil "missing"
    | record.txt_at publisher_vocabulary/version/x_data
  + versions
    \ ignored=unit
    ^ row[testing/check]
    = state fixture/namespace_tests/initial
      local=path ['h 'v ($u 3) ($x 1) 'app 'demo]
      system=path ['h 'v ($u 3) 'sys 'types 'text]
      updated
        | namespace_view_tests/put [($x 1) 'app 'demo]
          (fixture/namespace_tests/record 77) state.local
      next | state.set_local updated
      triggers | h_version_triggers local
    [(testing/nat "history root exposes four read vocabularies" 4
       (sovereign_peek ['h] state).kid_tap.len)
     (testing/nat "incomplete historical target has a marker" 1
       (sovereign_peek ['h 'x ($u 1) ($u 3) 'sys] state).wyt)
     (testing/nat "invalid history care has no marker" 0
       (sovereign_peek ['h 'bad] state).wyt)
     (testing/text "local version uses local history" "1"
       (namespace_view_tests/version local state))
     (testing/text "local version advances" "2"
       (namespace_view_tests/version local next))
     (testing/text "system version uses pinned history" "1"
       (namespace_view_tests/version system next))
     (testing/nat "global root has no version" 1
       ?=(.unknown (sovereign_view .y 0 ['h 'v ($u 0)] next)))
     (testing/nat "version views do not invent historical cases" 1
       ?=(.unknown (sovereign_view .y 1 local next)))
     (testing/nat "version views watch target and authority" 2 triggers.len)
     (testing/same[path] "version trigger retains authority" path_show
       [($x 1) 'app 'demo] triggers.at(0).p)
     (testing/same[path] "version top watches only its authority" path_show
       [($x 1)] triggers.at(1).p)
     (testing/nat "pinned historical views have no live triggers" 0
       (h_version_triggers ['h 'x ($u 1) ($u 3) ($x 1) 'app 'demo]).len)]

+ namespace_view_tests
  + exacts
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      parent=path [initial.self 'app]
      child=path [initial.self 'app 'demo]
      local | fixture/namespace_tests/seed parent 66 initial.local
      state | initial.set_local local
      empty | axal/new[note] .none
      record | fixture/namespace_tests/record 77
      writes=row[axal[note]]
        [empty
         empty.put(parent (note/make record))
         empty.put(parent (note/poke record))
         empty.put(parent .cull)
         empty.put(child .cull)
         empty.put(parent .cull).put(child (note/make record))]
      same
        \ diffs=axal[note]
        = transaction | worm diffs [] 0 [] (axal/new[mode] .none) 0 0
          expected
            | sorge[myth] .x
              (muck (sovereign_peek parent state) diffs.dip(parent))
        | equal[axal[myth]] expected
          (sovereign_read .x parent transaction state)
      paths=row[path] [[state.self] parent child [state.self 'missing]]
      committed_same
        \ name=path
        | equal[axal[myth]]
          (sorge[myth] .x (sovereign_peek name state))
          (sovereign_care .x name state)
    [(testing/nat "exact pending reads match full overlay" 1 writes.all(same))
     (testing/nat "exact committed reads preserve absent prefixes" 1 paths.all(committed_same))]
