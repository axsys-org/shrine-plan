- helm
- net
- pass
- system_vocabulary
- grove_role_runtime
- weave
- testing
- tests/namespace [at=base]

' A course, written by hand as records: no Grove, no feet, no wire. 0x12
' keeps it. 0x11 fills the chair, 0x13 the first seat, nobody the second,
' and 0x14 is a world that sits nowhere. The table is six rows; everything
' checked below is read off it. A capture names one seat when the position's
' own path binds it (the s of work/[s] is the seat that writes the work, and
' the seat its mark is for) and every seat when it does not (any).
+ course_tests
  + lit
    \ name=iota
    ^ weave/seg
    | weave/seg .true name
  + cap
    \ name=iota
    ^ weave/seg
    | weave/seg .false name
  + table
    ^ row[weave/position]
    = top=row[weave/seg] []
      chair_at=row[weave/seg] [(course_tests/lit 'chair)]
      seats_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 's)]
      set_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a)]
      work_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'work) (course_tests/cap 's)]
      mark_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'work) (course_tests/cap 's) (course_tests/lit 'mark)]
      every_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 'any)]
      maker (weave/who .true top)
      chair (weave/who .false chair_at)
      seat (weave/who .false seats_at)
      seats (weave/who .false every_at)
      all=row[weave/who] [chair seats]
      to_seats=row[weave/who] [seats]
      to_seat=row[weave/who] [seat]
      to_chair=row[weave/who] [chair]
    [(weave/position top maker all "" "" "")
     (weave/position chair_at maker all "" "" "")
     (weave/position seats_at maker all "" "" "")
     (weave/position set_at chair to_seats "" "" "")
     (weave/position work_at seat to_chair "" "" "")
     (weave/position mark_at chair to_seat "" "" "")]
  + course
    ^ weave/comp
    = rel=path ['app 'course]
    | weave/comp 18 rel course_tests/table
  + side
    ' Where each world keeps what it writes of the course.
    \ n=nat
    ^ weave/side
    = kept=path [($x 18) 'app 'course]
      mine=path [($x n) 'mine 'course]
    ? (eq n 18) (weave/side 18 kept)
    | weave/side n mine
  + blank
    \ n=nat
    ^ namespace
    | namespace ($x n) sov/new (base/namespace_tests/initial).system
  + put
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + told
    ' A world after it wrote what the table says it must into others' roots.
    \ n=nat state=namespace
    ^ namespace
    | course_tests/put (weave/tell course_tests/course (course_tests/side n) state) state
  + sent
    ' A record as its publisher sends it: itself, or the record it stands
    ' for, read at the case it names.
    \ from=nat record=myth source=namespace
    ^ myth
    ?> (./some link) (net/standin ($x from) record) record
    ?> (./known records) (namespace/page .x (./some link.ver) link.path source) record
    ?> (./some held) records.fil record
    | unpin held.myth
  + land
    ' What one world wrote for another, arrived: a stand-in for the wire.
    ' As publication does, a name that stands for another is carried as
    ' the record it names (net/standin).
    \ from=nat to=nat source=namespace state=namespace
    ^ namespace
    = outward=path [($x from) 'our ($x to)]
      inward=path [($x to) 'her ($x from)]
      none=row[[p=path q=writ]] []
      moved
        | (sovereign_peek outward source).tap.fold none
          \ acc [rel record]
          | acc.snoc([inward.weld(rel) (writ/make (course_tests/sent from record source))])
    | course_tests/put moved state
  + wrote
    ' A world writes one record on its own side.
    \ n=nat rel=path record=myth state=namespace
    ^ namespace
    = target=path (course_tests/side n).root.weld(rel)
      writes=row[[p=path q=writ]] [[target (writ/make record)]]
    | course_tests/put writes state
  + text
    \ slot=iota said=str
    ^ myth
    = at=path [slot]
    | myth/sing at (pails/t said)
  + seat
    \ world=nat
    ^ myth
    | myth/sing ['world] (pails/n world)
  + stated
    ' One row of the table as a record states it.
    \ where=str by=str readers=str
    ^ myth
    . (myth/sing ['path] (pails/t where))
      put(['by] (pails/t by))
      put(['for] (pails/t readers))
  + written
    ' The same table, as records beneath the course's own tree. The first
    ' row is the table's own: the maker writes it for everyone.
    \ state=namespace
    ^ namespace
    = at=path [($x 18) 'app 'course 'table]
      writes=row[[p=path q=writ]] [[at.snoc(($u 1)) (writ/make (course_tests/stated "table/[n]" "maker" "chair seats/[any]"))] [at.snoc(($u 2)) (writ/make (course_tests/stated "" "maker" "chair seats/[any]"))] [at.snoc(($u 3)) (writ/make (course_tests/stated "chair" "maker" "chair seats/[any]"))] [at.snoc(($u 4)) (writ/make (course_tests/stated "seats/[s]" "maker" "chair seats/[any]"))] [at.snoc(($u 5)) (writ/make (course_tests/stated "assignments/[a]" "chair" "seats/[any]"))] [at.snoc(($u 6)) (writ/make (course_tests/stated "assignments/[a]/work/[s]" "seats/[s]" "chair"))] [at.snoc(($u 7)) (writ/make (course_tests/stated "assignments/[a]/work/[s]/mark" "chair" "seats/[s]"))]]
    | course_tests/put writes state
  + records
    \ _=unit
    ^ row[testing/check]
    = rel=path ['app 'course]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      seat1=path ['seats ($u 1)]
      chair=path ['chair]
      top=path []
      set=path ['assignments ($u 3)]
      m0 (course_tests/written (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18)))))
      read (weave/rows 18 rel ms m0)
      c (weave/comp 18 rel read)
      m1 (course_tests/put (weave/tell c ms m0) m0)
      k0 (course_tests/land 18 17 m1 (course_tests/blank 17))
      theirs (weave/rows 18 rel ks k0)
      kc (weave/comp 18 rel theirs)
      k1 (course_tests/wrote 17 set (course_tests/text 'title "Assignment 3") k0)
      nothing=row[weave/seg] []
      shape (weave/pattern "assignments/[a]/work/[s]").fall(nothing)
    [(testing/nat "seven rows are read from seven records" 7 read.len)
     (testing/nat "a path is its names and captures" 4 shape.len)
     (testing/nat "a capture is not a fixed name" 0 (? shape.at(1).fixed 1 0))
     (testing/nat "the top is no segments at all" 0 (weave/pattern "").fall(shape).len)
     (testing/nat "the table reaches whoever sits, as records the maker writes" 7 theirs.len)
     (testing/nat "and reads the same there: the chair's assignment is written for the seat" 3 (weave/tell kc ks k1).len)
     (testing/nat "a row that names a writer nobody can spell is not a row" 0 (? (maybe/is_some (weave/row (course_tests/stated "x" "[" ""))) 1 0))]
  + norm
    ' A norm's record as a Grove unit publishes it: the shape as data, and
    ' who writes and who reads as the unit's author wrote them.
    \ segments=row[grove_norm_segment] by=str readers=str
    ^ myth
    = fields=row[grove_role_field] []
      need=row[row[path]] []
    . (myth/sing system_vocabulary/grove/norm (grove_norm_schema segments (grove_role_schema fields need)))
      put(['by] (pails/t by))
      put(['for] (pails/t readers))
  + name
    \ text=str
    ^ grove_norm_segment
    | grove_norm_segment "" (zeta/lit ($ts text))
  + open
    \ label=str
    ^ grove_norm_segment
    | grove_norm_segment label (zeta/var "u")
  + published
    \ _=unit
    ^ row[testing/check]
    = unit=path [($x 18) 'gov 'course]
      top=row[grove_norm_segment] []
      chair_at=row[grove_norm_segment] [(course_tests/name "chair")]
      seats_at=row[grove_norm_segment] [(course_tests/name "seats") (course_tests/open "s")]
      set_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a")]
      work_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a") (course_tests/name "work") (course_tests/open "s")]
      mark_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a") (course_tests/name "work") (course_tests/open "s") (course_tests/name "mark")]
      writes=row[[p=path q=writ]] [[unit.snoc('a_course) (writ/make (course_tests/norm top "maker" "chair seats/[any]"))] [unit.snoc('b_chair) (writ/make (course_tests/norm chair_at "maker" "chair seats/[any]"))] [unit.snoc('c_seats) (writ/make (course_tests/norm seats_at "maker" "chair seats/[any]"))] [unit.snoc('d_set) (writ/make (course_tests/norm set_at "chair" "seats/[any]"))] [unit.snoc('e_work) (writ/make (course_tests/norm work_at "seats/[s]" "chair"))] [unit.snoc('f_mark) (writ/make (course_tests/norm mark_at "chair" "seats/[s]"))] [unit.snoc('a_role) (writ/make (course_tests/text 'lede "a role is not a norm"))]]
      m0 (course_tests/put writes (course_tests/blank 18))
      table (weave/unit unit m0)
      root=path [($x 18) 'app 'course]
      rel=path ['app 'course]
      ms (course_tests/side 18)
      m1 (course_tests/put (weave/tabled table root m0) m0)
      back (weave/rows 18 rel ms m1)
      hand course_tests/table
      work (course_tests/pick "assignments/[a]/work/[s]" table)
      mark (course_tests/pick "assignments/[a]/work/[s]/mark" table)
      everyone (course_tests/text_at ['for] (weave/stated (weave/own table)))
    [(testing/nat "each norm a unit publishes is a row; what is not a norm is not" 6 table.len)
     (testing/text "a row's path is the norm's own pattern" "assignments/[a]/work/[s]" (weave/spelled work.path))
     (testing/text "its writer is what the norm's record says" "seats/[s]" (weave/said work.writer))
     (testing/nat "the rows are written beneath the composition, the table's own row first" 7 (weave/tabled table root m0).len)
     (testing/nat "written again when nothing moved, nothing is written" 0 (weave/tabled table root m1).len)
     (testing/nat "a table that does not say who writes the top is given that row: the maker, for everyone" 7 (weave/whole table.keep((\ p=weave/position (gt p.path.len 0)))).len)
     (testing/nat "and read back they are the same seven" 7 back.len)
     (testing/nat "the table's own row is for every seat path the table names, each once" 3 (str/split_byte 32 everyone).len)
     (testing/text "the mark's row reads the same from Grove as written by hand" (weave/spelled hand.at(5).path) (weave/spelled mark.path))
     (testing/text "and so does who reads it" (weave/said hand.at(5).readers.at(0)) (weave/said mark.readers.at(0)))]
  + pick
    ' The row at a path, however the rows are ordered.
    \ where=str table=row[weave/position]
    ^ weave/position
    = top=row[weave/seg] []
      nobody=row[weave/who] []
      missing (weave/position top (weave/who .true top) nobody "" "" "")
      found table.keep((\ p=weave/position (equal[str] where (weave/spelled p.path))))
    ? !(found.len) missing
    | found.at(0)
  + text_at
    \ slot=path record=myth
    ^ str
    | record.txt_at(slot)
  + who_wrote
    ' Whose record stands at a place of the course, as a world reads it.
    \ where=path n=nat state=namespace
    ^ nat
    ?> (./some found) (weave/find course_tests/course where) 0
    | weave/writer_of course_tests/course (course_tests/side n) found.pos (weave/spot where found.binds) state
  + reseated
    ' The first seat is given to another world after its work is in. 19
    ' filled it, 21 fills it now; 17 is the chair, who reads the work.
    \ _=unit
    ^ row[testing/check]
    = c course_tests/course
      top=path []
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      seat2=path ['seats ($u 2)]
      set=path ['assignments ($u 3)]
      work=path ['assignments ($u 3) 'work ($u 1)]
      ks (course_tests/side 17)
      m0 (course_tests/wrote 18 seat2 (course_tests/text 'lede "a seat nobody fills") (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18)))))
      m1 (course_tests/told 18 m0)
      k0 (course_tests/land 18 17 m1 (course_tests/blank 17))
      s0 (course_tests/land 18 19 m1 (course_tests/blank 19))
      k1 (course_tests/wrote 17 set (course_tests/text 'title "Assignment 3") k0)
      k2 (course_tests/told 17 k1)
      s1 (course_tests/land 17 19 k2 s0)
      s2 (course_tests/wrote 19 work (course_tests/text 'work "an essay") s1)
      s3 (course_tests/told 19 s2)
      k3 (course_tests/land 19 17 s3 k2)
      m2 (course_tests/wrote 18 seat1 (course_tests/seat 21) m1)
      m3 (course_tests/told 18 m2)
      k4 (course_tests/land 18 17 m3 k3)
      s5 (course_tests/wrote 19 work (course_tests/text 'work "a later essay") s3)
      s6 (course_tests/told 19 s5)
      k5 (course_tests/land 19 17 s6 k4)
      n0 (course_tests/land 18 21 m3 (course_tests/blank 21))
      n1 (course_tests/land 17 21 k2 n0)
      n2 (course_tests/wrote 21 work (course_tests/text 'work "her own essay") n1)
      n3 (course_tests/told 21 n2)
      k6 (course_tests/land 21 17 n3 k5)
      seats_at (course_tests/table).at(2).path
      in_one=row[weave/bind] [(weave/bind 's ($u 1))]
      landed=path [($x 17) 'her ($x 19) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
    [(testing/nat "the seat's world wrote the work" 19 (course_tests/who_wrote work 17 k3))
     (testing/nat "the seat is given to another world: it fills the seat now" 21 (weave/sitters c ks seats_at in_one k4).at(0))
     (testing/nat "the work is still the first world's" 19 (course_tests/who_wrote work 17 k4))
     (testing/text "and still reads" "an essay" (weave/seen c ks 19 work k4).fall(myth/new).txt_at(['work]))
     (testing/nat "the chair held that the seat was the first world's until one of its own epochs" 1 (gt (weave/left c ks 19 work k4) 0))
     (testing/text "what the first world says of it afterwards arrives" "a later essay" (sovereign_care .x landed k5).fil.fall(myth/new).txt_at(['work]))
     (testing/text "and is not read: the work is as it stood when the seat changed" "an essay" (weave/seen c ks 19 work k5).fall(myth/new).txt_at(['work]))
     (testing/nat "the new world writes there: the work is now its own" 21 (course_tests/who_wrote work 17 k6))
     (testing/text "and reads as it wrote it" "her own essay" (weave/seen c ks 21 work k6).fall(myth/new).txt_at(['work]))
     (testing/nat "a seat nobody has changed is read as it stands" 0 (weave/left c ks 17 set k6))]
  + checks
    \ _=unit
    ^ row[testing/check]
    = c course_tests/course
      top=path []
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      seat2=path ['seats ($u 2)]
      set=path ['assignments ($u 3)]
      stray=path ['assignments ($u 4)]
      work=path ['assignments ($u 3) 'work ($u 1)]
      mark=path ['assignments ($u 3) 'work ($u 1) 'mark]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      ss (course_tests/side 19)
      m0 (course_tests/wrote 18 seat2 (course_tests/text 'lede "a seat nobody fills") (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18)))))
      first (weave/tell c ms m0)
      m1 (course_tests/told 18 m0)
      k0 (course_tests/land 18 17 m1 (course_tests/blank 17))
      s0 (course_tests/land 18 19 m1 (course_tests/blank 19))
      k1 (course_tests/wrote 17 set (course_tests/text 'title "Assignment 3") k0)
      second (weave/tell c ks k1)
      k2 (course_tests/told 17 k1)
      s1 (course_tests/land 17 19 k2 s0)
      to_maker=path [($x 17) 'our ($x 18) ($x 18) 'app 'course 'assignments ($u 3)]
      forged=path [($x 17) 'her ($x 20) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
      lie=row[[p=path q=writ]] [[forged (writ/make (course_tests/text 'work "not hers"))]]
      kf (course_tests/put lie k2)
      s2 (course_tests/wrote 19 work (course_tests/text 'work "an essay") s1)
      s3 (course_tests/told 19 s2)
      k3 (course_tests/land 19 17 s3 k2)
      k4 (course_tests/wrote 17 mark (course_tests/text 'grade "A-") k3)
      k5 (course_tests/told 17 k4)
      s4 (course_tests/land 17 19 k5 s3)
      sx (course_tests/wrote 19 stray (course_tests/text 'title "not hers to set") s4)
      got (weave/seen c ss 17 mark s4).fall(myth/new)
      seats_at (course_tests/table).at(2).path
      in_one=row[weave/bind] [(weave/bind 's ($u 1))]
      in_two=row[weave/bind] [(weave/bind 's ($u 2))]
      for_chair=path [($x 19) 'our ($x 17) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
      for_maker=path [($x 19) 'our ($x 18) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
    [(testing/nat "the maker writes each of its four records for both who sit, and a root for each" 10 first.len)
     (testing/nat "told again when nothing moved, it writes nothing" 0 (weave/tell c ms m1).len)
     (testing/nat "who fills a seat is read off the seat" 1 (eq 19 (weave/sitters c ks seats_at in_one k0).at(0)))
     (testing/nat "a seat nobody fills names nobody" 0 (weave/sitters c ks seats_at in_two k0).len)
     (testing/nat "the chair's assignment is written for the seat that is filled, and roots for the two others" 3 second.len)
     (testing/nat "and not for the maker, who does not read assignments" 0 (? (net/live to_maker k2) 1 0))
     (testing/nat "the student has one thing to do: the work only that seat writes" 1 (weave/todo c ss s1).len)
     (testing/nat "at the assignment, in its own seat" 1 (? (equal[path] work (weave/todo c ss s1).at(0)) 1 0))
     (testing/nat "the chair has nothing to do yet" 0 (weave/todo c ks k2).len)
     (testing/nat "and waits on one thing: that seat's work, not the empty seat's" 1 (weave/waits c ks k2).len)
     (testing/nat "work published by a world that does not fill the seat is not read" 0 (? (maybe/is_some (weave/seen c ks 19 work kf)) 1 0))
     (testing/nat "and gives the chair nothing to mark" 0 (weave/todo c ks kf).len)
     (testing/nat "the student's work is written for the chair" 1 (? (net/live for_chair s3) 1 0))
     (testing/nat "and for nobody else: the maker does not read work" 0 (? (net/live for_maker s3) 1 0))
     (testing/nat "submitted, the student has nothing to do" 0 (weave/todo c ss s3).len)
     (testing/nat "and waits on the chair for a mark" 1 (weave/waits c ss s3).len)
     (testing/nat "the chair now has one thing to do: mark it" 1 (weave/todo c ks k3).len)
     (testing/nat "which is the mark of that work" 1 (? (equal[path] mark (weave/todo c ks k3).at(0)) 1 0))
     (testing/nat "the mark is written for that seat alone" 1 (weave/tell c ks k4).len)
     (testing/text "and the student holds it, from the chair" "A-" got.txt_at(['grade]))
     (testing/nat "after which nobody waits" 0 (add (weave/waits c ss s4).len (weave/waits c ks k5).len))
     (testing/nat "and nobody has anything to do" 0 (add (weave/todo c ss s4).len (weave/todo c ks k5).len))
     (testing/nat "what a world writes where it does not write is written for nobody" 0 (weave/tell c ss sx).len)]
  + asking_table
    ' The course's table with one more row: a seat may ask for an
    ' assignment to be extended, and the chair, who writes assignments,
    ' applies it. Whole: with the table's own row and the answer's.
    ^ row[weave/position]
    = seats_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 's)]
      chair_at=row[weave/seg] [(course_tests/lit 'chair)]
      ask_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'extensions) (course_tests/cap 's)]
      to_chair=row[weave/who] [(weave/who .false chair_at)]
      more=row[weave/position] [(weave/position ask_at (weave/who .false seats_at) to_chair "/gov/course/extend" "" "")]
    | weave/whole (course_tests/table).weld(more)
  + asking_course
    ^ weave/comp
    = rel=path ['app 'course]
    | weave/comp 18 rel course_tests/asking_table
  + spoke
    ' A world after it wrote what that table says it must, and answered
    ' what it was asked.
    \ n=nat state=namespace
    ^ namespace
    = c course_tests/asking_course
      s (course_tests/side n)
    | course_tests/put (weave/tell c s state).weld((weave/answers c s state)) state
  + kept
    ' A record put into a world as it is, code and all.
    \ name=path record=myth state=namespace
    ^ namespace
    = diffs (axal/new[note] .none).put(name (note/make record))
    ? (namespace/step diffs 0 0 state)
     > (./accepted committed) committed.state
     > (./rejected _) state
  + extend
    ' The action as the chair's world holds it: so many days more, and
    ' none is refused.
    \ arguments=myth current=myth
    ^ maybe[myth]
    = days arguments.nat_at(['days] 0)
    ? (eq 0 days) .none
    | ./some current.put(['due] (pails/n (add days current.nat_at(['due] 0))))
  + asking
    ' The seat asks for three days more on an assignment. The chair's
    ' world applies it and answers; the seat holds the new date and the
    ' answer. A world that sits nowhere asks and is not heard.
    \ _=unit
    ^ row[testing/check]
    = c course_tests/asking_course
      top=path []
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      set=path ['assignments ($u 3)]
      ask=path ['assignments ($u 3) 'extensions ($u 1)]
      reply=path ['assignments ($u 3) 'extensions ($u 1) 'answer]
      action=path [($x 17) 'gov 'course 'extend]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      ss (course_tests/side 19)
      due=path ['due]
      days=path ['days]
      m0 (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18))))
      m1 (course_tests/spoke 18 m0)
      k0 (course_tests/kept action (myth/sing system_vocabulary/grove/action_handler (grove_action_handler course_tests/extend)) (course_tests/land 18 17 m1 (course_tests/blank 17)))
      s0 (course_tests/land 18 19 m1 (course_tests/blank 19))
      k1 (course_tests/spoke 17 (course_tests/wrote 17 set (myth/sing due (pails/n 10)) k0))
      s1 (course_tests/land 17 19 k1 s0)
      s2 (course_tests/spoke 19 (course_tests/wrote 19 ask (myth/sing days (pails/n 3)) s1))
      k2 (course_tests/land 19 17 s2 k1)
      asked (weave/asked c ks k2)
      k3 (course_tests/spoke 17 k2)
      k4 (course_tests/spoke 17 k3)
      s3 (course_tests/land 17 19 k4 s2)
      forged=path [($x 17) 'her ($x 20) ($x 18) 'app 'course 'assignments ($u 3) 'extensions ($u 1)]
      lie=row[[p=path q=writ]] [[forged (writ/make (myth/sing days (pails/n 99)))]]
      kf (course_tests/put lie k1)
      nothing (course_tests/land 19 17 (course_tests/spoke 19 (course_tests/wrote 19 ask (myth/sing days (pails/n 0)) s1)) k1)
      refused (course_tests/spoke 17 nothing)
      bare (course_tests/land 19 17 s2 (course_tests/spoke 17 (course_tests/wrote 17 set (myth/sing due (pails/n 10)) (course_tests/land 18 17 m1 (course_tests/blank 17)))))
      unheld (course_tests/spoke 17 bare)
      work=path ['assignments ($u 3) 'work ($u 1)]
      in_seat=path [($x 19) 'her ($x 17) ($x 18) 'app 'course 'assignments ($u 3)]
      own_work=path [($x 19) 'mine 'course 'assignments ($u 3) 'work ($u 1)]
      added=path ['assignments 'a]
    [(testing/nat "a row that applies an action brings its answer's row: the thing's writer writes it" 1 (course_tests/asking_table).keep((\ p=weave/position (equal[str] "assignments/[a]/extensions/[s]/answer" (weave/spelled p.path)))).len)
     (testing/text "for whoever asked" "seats/[s]" (weave/said (course_tests/pick "assignments/[a]/extensions/[s]/answer" course_tests/asking_table).readers.at(0)))
     (testing/text "and the chair writes it" "chair" (weave/said (course_tests/pick "assignments/[a]/extensions/[s]/answer" course_tests/asking_table).writer))
     (testing/nat "the seat may ask one thing: more time on the assignment" 1 (weave/may c ss s1).len)
     (testing/nat "which is not something it has to do: that is still only its work" 1 (weave/todo c ss s1).len)
     (testing/nat "the chair may ask nothing" 0 (weave/may c ks k1).len)
     (testing/nat "asked, the seat may ask no more there" 0 (weave/may c ss s2).len)
     (testing/nat "and waits on the chair for the answer" 1 (course_tests/yes (weave/waits c ss s2).any((\ [place on] (equal[path] place reply)))))
     (testing/nat "the chair is asked one thing" 1 asked.len)
     (testing/nat "by the world that fills the seat" 19 asked.at(0).asker)
     (testing/nat "of the assignment it writes" 1 (course_tests/yes (equal[path] set asked.at(0).thing)))
     (testing/nat "its world applies the action it holds: three days more" 13 (course_tests/record_at 17 set k3).nat_at(due 0))
     (testing/nat "and answers: done" 1 (course_tests/record_at 17 reply k3).nat_at(['done] 0))
     (testing/nat "answered, it is asked nothing" 0 (weave/asked c ks k3).len)
     (testing/nat "the seat holds the new date, from the chair" 13 (weave/seen c ss 17 set s3).fall(myth/new).nat_at(due 0))
     (testing/nat "and the answer" 1 (weave/seen c ss 17 reply s3).fall(myth/new).nat_at(['done] 0))
     (testing/nat "an ask from a world that does not fill the seat is not heard" 0 (weave/asked c ks kf).len)
     (testing/nat "an ask the action refuses is answered: not" 2 (course_tests/record_at 17 reply refused).nat_at(['done] 0))
     (testing/nat "and the assignment stands as it was" 10 (course_tests/record_at 17 set refused).nat_at(due 0))
     (testing/nat "a world that does not hold the action answers: not, and says why" 2 (course_tests/record_at 17 reply unheld).nat_at(['done] 0))
     (testing/nat "and changes nothing" 10 (course_tests/record_at 17 set unheld).nat_at(due 0))
     (testing/nat "laid for the seat before it asks: it holds the top, the chair, its seat and the assignment" 4 (course_tests/kinds "held" (weave/laid c ss s1)))
     (testing/nat "has one thing to do" 1 (course_tests/kinds "todo" (weave/laid c ss s1)))
     (testing/nat "may ask one thing" 1 (course_tests/kinds "may" (weave/laid c ss s1)))
     (testing/nat "and waits on nothing" 0 (course_tests/kinds "waits" (weave/laid c ss s1)))
     (testing/nat "the table's own rows are not places in it" 0 (weave/laid c ss s1).keep(course_tests/of_table).len)
     (testing/nat "once it asks, the ask is held and it waits on the answer" 1 (course_tests/kinds "waits" (weave/laid c ss s2)))
     (testing/nat "laid for the chair, the ask is held and its answer is the chair's to do" 1 (course_tests/kinds "todo" (weave/laid c ks k2)))
     (testing/nat "and it waits on the seat's work" 1 (course_tests/kinds "waits" (weave/laid c ks k2)))
     (testing/nat "the chair may add an assignment, and nothing else is its to add to" 1 (course_tests/kinds "more" (weave/laid c ks k2)))
     (testing/text "shown at the collection, under the capture's own name" "more" (course_tests/kind_at added (weave/laid c ks k2)))
     (testing/nat "a seat adds to nothing: where it writes, the table names the place" 0 (course_tests/kinds "more" (weave/laid c ss s1)))
     (testing/nat "a place is shown where this world holds it: the chair's assignment, in the seat's world, beneath the chair's root" 1 (course_tests/yes (equal[path] in_seat (course_tests/held_at set (weave/laid c ss s1)))))
     (testing/nat "and a place to do, where this world would write it: on its own side" 1 (course_tests/yes (equal[path] own_work (course_tests/held_at work (weave/laid c ss s1)))))
     (testing/nat "as text it is one line a place" 6 (str/split_byte 10 (weave/shown (weave/laid c ss s1))).len)]
  + yes
    \ said=bool
    ^ nat
    ? said 1
    0
  + of_table
    ' Whether a laid place is one of the table's own rows.
    \ item=weave/place
    ^ bool
    ? (eq 0 item.spot.len) .false
    | weave/same item.spot.at(0) 'table
  + kinds
    ' How many places of a laid composition stand one way.
    \ kind=str places=row[weave/place]
    ^ nat
    | places.keep((\ item=weave/place (equal[str] kind item.kind))).len
  + held_at
    ' Where a laid composition says a place is held or would be written.
    \ spot=path places=row[weave/place]
    ^ path
    = nowhere=path []
      found places.keep((\ item=weave/place (equal[path] spot item.spot)))
    ? !(found.len) nowhere
    | found.at(0).held
  + record_at
    ' What a world wrote on its own side at a place.
    \ n=nat rel=path state=namespace
    ^ myth
    | (sovereign_care .x (course_tests/side n).root.weld(rel) state).fil.fall(myth/new)
  + seed
    \ n=nat
    ^ nat
    = w32 4294967296
      w64 (mul w32 w32)
    | add (mul (mul w64 w64) (mul w64 w64)) n
  + own
    ' A name of its own: its founding, and a log of one statement that
    ' gives it a live key. Seeds are test numbers.
    : name=nat made=pass/founding log=row[pass/statement]
  + born
    \ n=nat
    ^ course_tests/own
    = custody (course_tests/seed n)
      live (course_tests/seed (add 1000 n))
      made (pass/founding pass/form (Ed25519PublicKey custody) 0)
      name (pass/name made)
      first (pass/state custody name (pass/born made) 1 0 (Ed25519PublicKey live) (Ed25519PublicKey custody))
      log=row[pass/statement] [first]
    | course_tests/own name made log
  + said
    ' A record as a test name publishes it to a reader, at a place of a
    ' composition, signed with the key its log gives it: a witness.
    \ n=nat reader=nat maker=nat rel=path place=path version=nat record=myth
    ^ pass/witness
    = who (course_tests/born n)
      head=path [($x who.name) 'our ($x reader) ($x maker)]
      name=path head.weld(rel).weld(place)
      word (net/word ($x who.name) name version (net/content record))
      sig (Ed25519Sign (course_tests/seed (add 1000 n)) word)
    | pass/witness name (oath sig version) record who.made who.log
  + ruled_rows
    ' The course's table as its maker, test name 1, publishes it to a
    ' reader: one witness a row.
    \ reader=nat maker=nat rel=path
    ^ row[pass/witness]
    = none=row[pass/witness] []
      rows (weave/whole course_tests/table)
    % i=nat 0
      out=row[pass/witness] none
    ^ row[pass/witness]
    ? (ge i rows.len) out
    = at=path ['table ($u i.inc)]
    | _ i.inc out.snoc((course_tests/said 1 reader maker rel at 5 (weave/stated rows.at(i))))
  + skip
    ' A proof without one of its witnesses.
    \ n=nat proof=row[pass/witness]
    ^ row[pass/witness]
    = none=row[pass/witness] []
    % i=nat 0
      out=row[pass/witness] none
    ^ row[pass/witness]
    ? (ge i proof.len) out
    ? (eq i n) (_ i.inc out)
    | _ i.inc out.snoc(proof.at(i))
  + count
    ' How many records a proof showed at a place.
    \ place=path got=row[weave/stood]
    ^ nat
    | got.keep((\ f=weave/stood (equal[path] f.place place))).len
  + shown_at
    \ place=path got=row[weave/stood]
    ^ weave/stood
    = nowhere=path []
      blank (weave/stood nowhere myth/new 0 0)
    | got.fold blank
      \ acc=weave/stood f=weave/stood
      ^ weave/stood
      ? (equal[path] f.place place) f
      acc
  + took
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    ?> (./ok writes) result state
    | course_tests/put writes state
  + with_table
    ' Entries for the course's table beneath a root, after some others.
    \ inner=path start=row[net/entry]
    ^ row[net/entry]
    = rows (weave/whole course_tests/table)
    % i=nat 0
      out=row[net/entry] start
    ^ row[net/entry]
    ? (ge i rows.len) out
    = at=path inner.snoc('table).snoc(($u i.inc))
    | _ i.inc out.snoc((net/put at (net/stamp 0 1) (weave/stated rows.at(i))))
  + standing
    ' A mark the chair wrote for a seat, shown to a world that holds
    ' nothing of the course but its maker's name. Test name 1 keeps the
    ' course, 2 fills the chair, 3 the first seat, and 4 sits nowhere.
    \ _=unit
    ^ row[testing/check]
    = m (course_tests/born 1)
      k (course_tests/born 2)
      a (course_tests/born 3)
      x (course_tests/born 4)
      rel=path ['app 'course]
      other=path ['app 'other]
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      seat2=path ['seats ($u 2)]
      work=path ['assignments ($u 3) 'work ($u 1)]
      place=path ['assignments ($u 3) 'work ($u 1) 'mark]
      grade (course_tests/text 'grade "A-")
      essay (course_tests/text 'body "an essay")
      rows (course_tests/ruled_rows a.name m.name rel)
      sits (course_tests/said 1 a.name m.name rel chair 5 (course_tests/seat k.name))
      mark (course_tests/said 2 a.name m.name rel place 9 grade)
      whole rows.snoc(sits).snoc(mark)
      got (weave/vouched m.name rel whole)
      found (course_tests/shown_at place got)
      usurped (course_tests/said 1 a.name m.name rel chair 5 (course_tests/seat x.name))
      forged (course_tests/said 4 a.name m.name rel place 9 grade)
      altered (pass/witness mark.name mark.said (course_tests/text 'grade "A+") mark.made mark.log)
      borrowed (pass/witness mark.name mark.said mark.record x.made x.log)
      gap (course_tests/skip 2 rows).snoc(sits).snoc(mark)
      rows_k (course_tests/ruled_rows k.name m.name rel)
      seat_a (course_tests/said 1 k.name m.name rel seat1 5 (course_tests/seat a.name))
      seat_b (course_tests/said 1 k.name m.name rel seat2 5 (course_tests/seat a.name))
      handed (course_tests/said 3 k.name m.name rel work 7 essay)
    [(testing/nat "a mark is shown by the table, the chair's seat and the mark" 1 (course_tests/count place got))
     (testing/nat "it was said by the world the maker says fills the chair" 1 (? (eq found.by k.name) 1 0))
     (testing/nat "for the seat it was written for" 1 (? (eq found.reader a.name) 1 0))
     (testing/nat "and it is the record" 1 (? (equal[myth] found.record grade) 1 0))
     (testing/nat "the seat is shown with it; the table's rows are how it is read, and are not" 2 got.len)
     (testing/nat "without the seat the mark is nobody's" 0 (course_tests/count place (weave/vouched m.name rel rows.snoc(mark))))
     (testing/nat "a seat that names another world does not vouch for the chair" 0 (course_tests/count place (weave/vouched m.name rel rows.snoc(usurped).snoc(mark))))
     (testing/nat "a world that sits nowhere signs a mark and is not believed" 0 (course_tests/count place (weave/vouched m.name rel rows.snoc(sits).snoc(forged))))
     (testing/nat "a record changed after it was signed is not shown" 0 (course_tests/count place (weave/vouched m.name rel rows.snoc(sits).snoc(altered))))
     (testing/nat "nor one that comes with another name's log" 0 (course_tests/count place (weave/vouched m.name rel rows.snoc(sits).snoc(borrowed))))
     (testing/nat "a proof that leaves out a row before the one it wants says nothing" 0 (weave/vouched m.name rel gap).len)
     (testing/nat "against another maker's name it shows nothing" 0 (weave/vouched x.name rel whole).len)
     (testing/nat "nor for another tree of the same maker" 0 (weave/vouched m.name other whole).len)
     (testing/nat "work is shown by the seat that wrote it" 1 (course_tests/count work (weave/vouched m.name rel rows_k.snoc(seat_a).snoc(handed))))
     (testing/nat "and not by a world that fills another seat" 0 (course_tests/count work (weave/vouched m.name rel rows_k.snoc(seat_b).snoc(handed))))]
  + seat_world
    ' The first seat's world, test name 3, as it holds the course. The
    ' maker's top, table and seats and the chair's assignment landed under
    ' their signatures; each name's founding and log is kept on its card;
    ' and its own work stands on its side. With the chair's mark, or
    ' before it.
    \ marked=bool
    ^ namespace
    = m (course_tests/born 1)
      k (course_tests/born 2)
      me (course_tests/born 3).name
      inner=path [($x m.name) 'app 'course]
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      set=path ['assignments ($u 3)]
      work=path ['assignments ($u 3) 'work ($u 1)]
      place=path ['assignments ($u 3) 'work ($u 1) 'mark]
      card_m=path [($x me) 'io 'mesa ($x m.name)]
      card_k=path [($x me) 'io 'mesa ($x k.name)]
      mount_m=path [($x me) 'her ($x m.name)]
      mount_k=path [($x me) 'her ($x k.name)]
      root_m=path [($x m.name) 'our ($x me)]
      root_k=path [($x k.name) 'our ($x me)]
      mine=path [($x me) 'mine 'course]
      a0 (course_tests/blank me)
      a1 (course_tests/took (pass/meet card_m m.made m.log a0) a0)
      a2 (course_tests/took (pass/meet card_k k.made k.log a1) a1)
      seats=row[net/entry] [(net/put inner (net/stamp 0 1) (course_tests/text 'title "CS396")) (net/put inner.weld(chair) (net/stamp 0 1) (course_tests/seat k.name)) (net/put inner.weld(seat1) (net/stamp 0 1) (course_tests/seat me))]
      epic_m (net/seal (course_tests/seed 1001) root_m (net/epic 0 (net/stamp 0 1) 0 (course_tests/with_table inner seats)))
      a3 (course_tests/took (net/land mount_m card_m epic_m a2) a2)
      before=row[net/entry] [(net/put inner.weld(set) (net/stamp 0 1) (course_tests/text 'title "Assignment 3"))]
      after before.snoc((net/put inner.weld(place) (net/stamp 0 1) (course_tests/text 'grade "A-")))
      epic_k (net/seal (course_tests/seed 1002) root_k (net/epic 0 (net/stamp 0 1) 0 (? marked after before)))
      a4 (course_tests/took (net/land mount_k card_k epic_k a3) a3)
      own=row[[p=path q=writ]] [[mine.weld(work) (writ/make (course_tests/text 'body "an essay"))]]
    | course_tests/put own a4
  + carried
    ' The same mark, as the seat's world holds it.
    \ _=unit
    ^ row[testing/check]
    = m (course_tests/born 1)
      me (course_tests/born 3).name
      rel=path ['app 'course]
      work=path ['assignments ($u 3) 'work ($u 1)]
      place=path ['assignments ($u 3) 'work ($u 1) 'mark]
      later=path ['assignments ($u 4) 'work ($u 1) 'mark]
      a3 (course_tests/seat_world .false)
      a4 (course_tests/seat_world .true)
      mine=path [($x me) 'mine 'course]
      s (weave/side me mine)
      c (weave/comp m.name rel (weave/rows m.name rel s a4))
      proof (weave/carry c s place a4)
      got (weave/vouched m.name rel proof)
    [(testing/nat "the table reaches the seat under its maker's signature" 7 c.table.len)
     (testing/nat "a seat carries the table to the mark's row, the mark, and the chair's seat" 9 proof.len)
     (testing/nat "and a stranger to the course takes the mark from that alone" 1 (course_tests/count place got))
     (testing/nat "what a world writes itself it was not given, and does not carry" 0 (weave/carry c s work a4).len)
     (testing/nat "a place nobody has written carries nothing" 0 (weave/carry c s later a4).len)
     (testing/nat "before the mark landed there was nothing to carry" 0 (weave/carry c s place a3).len)]
  + job_table
    ' A job's table. The buyer keeps it and says what it wants shown; a
    ' supplier's seat shows it; the quote sits beneath what is shown.
    ^ row[weave/position]
    = top=row[weave/seg] []
      wants_at=row[weave/seg] [(course_tests/lit 'wants)]
      seat_at=row[weave/seg] [(course_tests/lit 'suppliers) (course_tests/cap 's)]
      stand_at=row[weave/seg] [(course_tests/lit 'suppliers) (course_tests/cap 's) (course_tests/lit 'standing)]
      quote_at=row[weave/seg] [(course_tests/lit 'suppliers) (course_tests/cap 's) (course_tests/lit 'standing) (course_tests/lit 'quote)]
      every_at=row[weave/seg] [(course_tests/lit 'suppliers) (course_tests/cap 'any)]
      maker (weave/who .true top)
      supplier (weave/who .false seat_at)
      to_all=row[weave/who] [(weave/who .false every_at)]
      to_maker=row[weave/who] [maker]
      rows=row[weave/position] [(weave/position wants_at maker to_all "" "" "") (weave/position seat_at maker to_all "" "" "") (weave/position stand_at supplier to_maker "" "wants" "") (weave/position quote_at supplier to_maker "" "" "")]
    | weave/whole rows
  + kind_at
    ' How a laid composition says a place stands; nothing when the place
    ' is not in it.
    \ spot=path places=row[weave/place]
    ^ str
    = nothing=str ""
    | places.fold nothing
      \ acc=str item=weave/place
      ^ str
      ? (equal[path] spot item.spot) item.kind
      acc
  + wanting
    ' What a job's buyer wants shown: a record at a position of a
    ' composition, named where its maker keeps it.
    \ of=path at=str
    ^ myth
    | (myth/sing ['at] (pails/t at)).put(['of] (safe 0 .x of))
  + proof_for
    ' The proof a world can give for the first thing it owes, from one
    ' composition.
    \ owed=row[[place=path want=weave/want]] c=weave/comp s=weave/side state=namespace
    ^ row[pass/witness]
    = none=row[pass/witness] []
    ? (eq 0 owed.len) none
    = [place want] owed.at(0)
    | weave/show c s want state
  + showing
    ' A job wants a mark in the course shown. The seat's world takes a
    ' supplier's seat and shows it. Test name 5 keeps the job and holds
    ' nothing of the course; 4 fills the second seat.
    \ _=unit
    ^ row[testing/check]
    = m (course_tests/born 1)
      x (course_tests/born 4)
      j (course_tests/born 5)
      me (course_tests/born 3).name
      rel=path ['app 'course]
      jrel=path ['app 'job]
      wants=path ['wants]
      seat=path ['suppliers 'first]
      stand=path ['suppliers 'first 'standing]
      quote=path ['suppliers 'first 'standing 'quote]
      seat2=path ['suppliers 'second]
      stand2=path ['suppliers 'second 'standing]
      quote2=path ['suppliers 'second 'standing 'quote]
      course_at=path [($x m.name) 'app 'course]
      other_at=path [($x m.name) 'app 'other]
      spelled=str "assignments/[a]/work/[s]/mark"
      wanted (course_tests/wanting course_at spelled)
      title (course_tests/text 'title "A job")
      note (course_tests/text 'title "My mark in the course")
      jc (weave/comp j.name jrel course_tests/job_table)
      theirs=path [($x me) 'her ($x j.name) ($x j.name) 'app 'job]
      mine=path [($x me) 'mine 'job]
      sa (weave/side me mine)
      learned=path [($x me) 'mine 'course]
      s (weave/side me learned)
      from_j=row[[p=path q=writ]] [[theirs (writ/make title)] [theirs.weld(wants) (writ/make wanted)] [theirs.weld(seat) (writ/make (course_tests/seat me))]]
      b0 (course_tests/put from_j (course_tests/seat_world .true))
      c (weave/comp m.name rel (weave/rows m.name rel s b0))
      chosen=row[[p=path q=writ]] [[mine.weld(stand) (writ/make note)]]
      b1 (course_tests/put chosen b0)
      owed (weave/owes jc sa b1)
      proof (course_tests/proof_for owed c s b1)
      given=row[[p=path q=writ]] [[mine.weld(stand) (writ/poke (myth/sing ['proof] (pails/n (pass/shown proof))))]]
      b2 (course_tests/put given b1)
      shown (sovereign_care .x mine.weld(stand) b2).fil.fall(myth/new)
      own=path [($x j.name) 'app 'job]
      sj (weave/side j.name own)
      from_a=path [($x j.name) 'her ($x me) ($x j.name) 'app 'job]
      from_x=path [($x j.name) 'her ($x x.name) ($x j.name) 'app 'job]
      kept=row[[p=path q=writ]] [[own (writ/make title)] [own.weld(wants) (writ/make wanted)] [own.weld(seat) (writ/make (course_tests/seat me))] [own.weld(seat2) (writ/make (course_tests/seat x.name))] [from_a.weld(stand) (writ/make shown)] [from_x.weld(stand2) (writ/make shown)]]
      j0 (course_tests/put kept (course_tests/blank j.name))
      elsewhere=row[[p=path q=writ]] [[own.weld(wants) (writ/make (course_tests/wanting other_at spelled))]]
      j1 (course_tests/put elsewhere j0)
      bare=row[[p=path q=writ]] [[from_a.weld(stand) (writ/make note)]]
      j2 (course_tests/put bare j0)
      back=maybe[pin[any]] (PinFrom (PinBytes (pin shown)))
      sent=myth
        ?> (./some arrived) back myth/new
        | (net/sound (unpin arrived)).fall(myth/new)
      crossed=row[[p=path q=writ]] [[from_a.weld(stand) (writ/make sent)]]
      j3 (course_tests/put crossed j0)
    [(testing/text "a place that must show something is the supplier's to fill" "todo" (course_tests/kind_at stand (weave/laid jc sa b0)))
     (testing/text "what sits beneath it is not open" "" (course_tests/kind_at quote (weave/laid jc sa b0)))
     (testing/nat "until the world chooses to show, it owes nothing" 0 (weave/owes jc sa b0).len)
     (testing/nat "it fills the place, and owes a proof of what the buyer wants" 1 owed.len)
     (testing/nat "what it holds of that: the course's table, the mark, and the chair's seat" 9 proof.len)
     (testing/text "without the proof its record does not stand" "unproven" (course_tests/kind_at stand (weave/laid jc sa b1)))
     (testing/text "with it, it does" "held" (course_tests/kind_at stand (weave/laid jc sa b2)))
     (testing/text "and what sits beneath opens" "todo" (course_tests/kind_at quote (weave/laid jc sa b2)))
     (testing/nat "nothing more is owed" 0 (weave/owes jc sa b2).len)
     (testing/text "the buyer holds nothing of the course, and takes the standing from the proof" "held" (course_tests/kind_at stand (weave/laid jc sj j0)))
     (testing/text "and waits on the quote" "waits" (course_tests/kind_at quote (weave/laid jc sj j0)))
     (testing/text "another world shows the same proof: the mark was not written for it" "unproven" (course_tests/kind_at stand2 (weave/laid jc sj j0)))
     (testing/text "and nothing opens beneath that" "" (course_tests/kind_at quote2 (weave/laid jc sj j0)))
     (testing/text "a proof of a record somewhere the buyer did not name shows nothing" "unproven" (course_tests/kind_at stand (weave/laid jc sj j1)))
     (testing/text "nor does a record that carries none" "unproven" (course_tests/kind_at stand (weave/laid jc sj j2)))
     (testing/nat "the record is the same after it travels as bytes" 1 (equal[myth] shown sent))
     (testing/text "and its proof still checks where it lands" "held" (course_tests/kind_at stand (weave/laid jc sj j3)))
     (testing/text "a record that shows what it must is not doubted: the only doubt is of the other" "why /suppliers/second/standing written-for-another-world" (weave/doubts jc sj j3).at(0))
     (testing/nat "and there is one" 1 (weave/doubts jc sj j3).len)
     (testing/text "one that carries no proof is, and the reading says why" "why /suppliers/first/standing it-carries-no-proof" (weave/doubts jc sj j2).at(0))
     (testing/nat "a proof of a record written for another world is doubted for that" 1 (weave/doubts jc sj j0).len)
     (testing/text "and one of a record the buyer did not name, for that" "why /suppliers/first/standing no-witness-is-of-the-composition-wanted" (weave/doubts jc sj j1).at(0))]

+ tests
  ^ row[testing/case]
  [(testing/case "a course, read off its table" course_tests/checks)
   (testing/case "a seat is read at its case" course_tests/reseated)
   (testing/case "the table itself is records" course_tests/records)
   (testing/case "a Grove unit's norms are the table" course_tests/published)
   (testing/case "an action asked across worlds" course_tests/asking)
   (testing/case "a record shown to a stranger, checked against the maker's name" course_tests/standing)
   (testing/case "what a seat holds, carried as a proof" course_tests/carried)
   (testing/case "a place that shows what its writer was given elsewhere" course_tests/showing)]
