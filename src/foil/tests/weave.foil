- helm
- net
- system_vocabulary
- grove_role_runtime
- weave
- testing
- tests/namespace [at=base]

' A course, written by hand as records: no Grove, no feet, no wire. 0x12
' keeps it. 0x11 fills the chair, 0x13 the first seat, nobody the second,
' and 0x14 is a world that sits nowhere. The table is six rows; everything
' checked below is read off it. A capture names one seat when the position's
' own path binds it (the s of work/[s] is the seat that writes the work, and
' the seat its mark is for) and every seat when it does not (any).
+ course_tests
  + lit
    \ name=iota
    ^ weave/seg
    | weave/seg .true name
  + cap
    \ name=iota
    ^ weave/seg
    | weave/seg .false name
  + table
    ^ row[weave/position]
    = top=row[weave/seg] []
      chair_at=row[weave/seg] [(course_tests/lit 'chair)]
      seats_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 's)]
      set_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a)]
      work_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'work) (course_tests/cap 's)]
      mark_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'work) (course_tests/cap 's) (course_tests/lit 'mark)]
      every_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 'any)]
      maker (weave/who .true top)
      chair (weave/who .false chair_at)
      seat (weave/who .false seats_at)
      seats (weave/who .false every_at)
      all=row[weave/who] [chair seats]
      to_seats=row[weave/who] [seats]
      to_seat=row[weave/who] [seat]
      to_chair=row[weave/who] [chair]
    [(weave/position top maker all "")
     (weave/position chair_at maker all "")
     (weave/position seats_at maker all "")
     (weave/position set_at chair to_seats "")
     (weave/position work_at seat to_chair "")
     (weave/position mark_at chair to_seat "")]
  + course
    ^ weave/comp
    = rel=path ['app 'course]
    | weave/comp 18 rel course_tests/table
  + side
    ' Where each world keeps what it writes of the course.
    \ n=nat
    ^ weave/side
    = kept=path [($x 18) 'app 'course]
      mine=path [($x n) 'mine 'course]
    ? (eq n 18) (weave/side 18 kept)
    | weave/side n mine
  + blank
    \ n=nat
    ^ namespace
    | namespace ($x n) sov/new (base/namespace_tests/initial).system
  + put
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    ? (grove_install/changes writes state)
     > (./ok next) next
     > (./err why) state
  + told
    ' A world after it wrote what the table says it must into others' roots.
    \ n=nat state=namespace
    ^ namespace
    | course_tests/put (weave/tell course_tests/course (course_tests/side n) state) state
  + land
    ' What one world wrote for another, arrived: a stand-in for the wire.
    \ from=nat to=nat source=namespace state=namespace
    ^ namespace
    = outward=path [($x from) 'our ($x to)]
      inward=path [($x to) 'her ($x from)]
      none=row[[p=path q=writ]] []
      moved
        | (sovereign_peek outward source).tap.fold none
          \ acc [rel record]
          | acc.snoc([inward.weld(rel) (writ/make record)])
    | course_tests/put moved state
  + wrote
    ' A world writes one record on its own side.
    \ n=nat rel=path record=myth state=namespace
    ^ namespace
    = target=path (course_tests/side n).root.weld(rel)
      writes=row[[p=path q=writ]] [[target (writ/make record)]]
    | course_tests/put writes state
  + text
    \ slot=iota said=str
    ^ myth
    = at=path [slot]
    | myth/sing at (pails/t said)
  + seat
    \ world=nat
    ^ myth
    | myth/sing ['world] (pails/n world)
  + stated
    ' One row of the table as a record states it.
    \ where=str by=str readers=str
    ^ myth
    . (myth/sing ['path] (pails/t where))
      put(['by] (pails/t by))
      put(['for] (pails/t readers))
  + written
    ' The same table, as records beneath the course's own tree. The first
    ' row is the table's own: the maker writes it for everyone.
    \ state=namespace
    ^ namespace
    = at=path [($x 18) 'app 'course 'table]
      writes=row[[p=path q=writ]] [[at.snoc(($u 1)) (writ/make (course_tests/stated "table/[n]" "maker" "chair seats/[any]"))] [at.snoc(($u 2)) (writ/make (course_tests/stated "" "maker" "chair seats/[any]"))] [at.snoc(($u 3)) (writ/make (course_tests/stated "chair" "maker" "chair seats/[any]"))] [at.snoc(($u 4)) (writ/make (course_tests/stated "seats/[s]" "maker" "chair seats/[any]"))] [at.snoc(($u 5)) (writ/make (course_tests/stated "assignments/[a]" "chair" "seats/[any]"))] [at.snoc(($u 6)) (writ/make (course_tests/stated "assignments/[a]/work/[s]" "seats/[s]" "chair"))] [at.snoc(($u 7)) (writ/make (course_tests/stated "assignments/[a]/work/[s]/mark" "chair" "seats/[s]"))]]
    | course_tests/put writes state
  + records
    \ _=unit
    ^ row[testing/check]
    = rel=path ['app 'course]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      seat1=path ['seats ($u 1)]
      chair=path ['chair]
      top=path []
      set=path ['assignments ($u 3)]
      m0 (course_tests/written (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18)))))
      read (weave/rows 18 rel ms m0)
      c (weave/comp 18 rel read)
      m1 (course_tests/put (weave/tell c ms m0) m0)
      k0 (course_tests/land 18 17 m1 (course_tests/blank 17))
      theirs (weave/rows 18 rel ks k0)
      kc (weave/comp 18 rel theirs)
      k1 (course_tests/wrote 17 set (course_tests/text 'title "Assignment 3") k0)
      nothing=row[weave/seg] []
      shape (weave/pattern "assignments/[a]/work/[s]").fall(nothing)
    [(testing/nat "seven rows are read from seven records" 7 read.len)
     (testing/nat "a path is its names and captures" 4 shape.len)
     (testing/nat "a capture is not a fixed name" 0 (? shape.at(1).fixed 1 0))
     (testing/nat "the top is no segments at all" 0 (weave/pattern "").fall(shape).len)
     (testing/nat "the table reaches whoever sits, as records the maker writes" 7 theirs.len)
     (testing/nat "and reads the same there: the chair's assignment is written for the seat" 3 (weave/tell kc ks k1).len)
     (testing/nat "a row that names a writer nobody can spell is not a row" 0 (? (maybe/is_some (weave/row (course_tests/stated "x" "[" ""))) 1 0))]
  + norm
    ' A norm's record as a Grove unit publishes it: the shape as data, and
    ' who writes and who reads as the unit's author wrote them.
    \ segments=row[grove_norm_segment] by=str readers=str
    ^ myth
    = fields=row[grove_role_field] []
      need=row[row[path]] []
    . (myth/sing system_vocabulary/grove/norm (grove_norm_schema segments (grove_role_schema fields need)))
      put(['by] (pails/t by))
      put(['for] (pails/t readers))
  + name
    \ text=str
    ^ grove_norm_segment
    | grove_norm_segment "" (zeta/lit ($ts text))
  + open
    \ label=str
    ^ grove_norm_segment
    | grove_norm_segment label (zeta/var "u")
  + published
    \ _=unit
    ^ row[testing/check]
    = unit=path [($x 18) 'gov 'course]
      top=row[grove_norm_segment] []
      chair_at=row[grove_norm_segment] [(course_tests/name "chair")]
      seats_at=row[grove_norm_segment] [(course_tests/name "seats") (course_tests/open "s")]
      set_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a")]
      work_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a") (course_tests/name "work") (course_tests/open "s")]
      mark_at=row[grove_norm_segment] [(course_tests/name "assignments") (course_tests/open "a") (course_tests/name "work") (course_tests/open "s") (course_tests/name "mark")]
      writes=row[[p=path q=writ]] [[unit.snoc('a_course) (writ/make (course_tests/norm top "maker" "chair seats/[any]"))] [unit.snoc('b_chair) (writ/make (course_tests/norm chair_at "maker" "chair seats/[any]"))] [unit.snoc('c_seats) (writ/make (course_tests/norm seats_at "maker" "chair seats/[any]"))] [unit.snoc('d_set) (writ/make (course_tests/norm set_at "chair" "seats/[any]"))] [unit.snoc('e_work) (writ/make (course_tests/norm work_at "seats/[s]" "chair"))] [unit.snoc('f_mark) (writ/make (course_tests/norm mark_at "chair" "seats/[s]"))] [unit.snoc('a_role) (writ/make (course_tests/text 'lede "a role is not a norm"))]]
      m0 (course_tests/put writes (course_tests/blank 18))
      table (weave/unit unit m0)
      root=path [($x 18) 'app 'course]
      rel=path ['app 'course]
      ms (course_tests/side 18)
      m1 (course_tests/put (weave/tabled table root m0) m0)
      back (weave/rows 18 rel ms m1)
      hand course_tests/table
      work (course_tests/pick "assignments/[a]/work/[s]" table)
      mark (course_tests/pick "assignments/[a]/work/[s]/mark" table)
      everyone (course_tests/text_at ['for] (weave/stated (weave/own table)))
    [(testing/nat "each norm a unit publishes is a row; what is not a norm is not" 6 table.len)
     (testing/text "a row's path is the norm's own pattern" "assignments/[a]/work/[s]" (weave/spelled work.path))
     (testing/text "its writer is what the norm's record says" "seats/[s]" (weave/said work.writer))
     (testing/nat "the rows are written beneath the composition, the table's own row first" 7 (weave/tabled table root m0).len)
     (testing/nat "written again when nothing moved, nothing is written" 0 (weave/tabled table root m1).len)
     (testing/nat "a table that does not say who writes the top is given that row: the maker, for everyone" 7 (weave/whole table.keep((\ p=weave/position (gt p.path.len 0)))).len)
     (testing/nat "and read back they are the same seven" 7 back.len)
     (testing/nat "the table's own row is for every seat path the table names, each once" 3 (str/split_byte 32 everyone).len)
     (testing/text "the mark's row reads the same from Grove as written by hand" (weave/spelled hand.at(5).path) (weave/spelled mark.path))
     (testing/text "and so does who reads it" (weave/said hand.at(5).readers.at(0)) (weave/said mark.readers.at(0)))]
  + pick
    ' The row at a path, however the rows are ordered.
    \ where=str table=row[weave/position]
    ^ weave/position
    = top=row[weave/seg] []
      nobody=row[weave/who] []
      missing (weave/position top (weave/who .true top) nobody "")
      found table.keep((\ p=weave/position (equal[str] where (weave/spelled p.path))))
    ? !(found.len) missing
    | found.at(0)
  + text_at
    \ slot=path record=myth
    ^ str
    | record.txt_at(slot)
  + checks
    \ _=unit
    ^ row[testing/check]
    = c course_tests/course
      top=path []
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      seat2=path ['seats ($u 2)]
      set=path ['assignments ($u 3)]
      stray=path ['assignments ($u 4)]
      work=path ['assignments ($u 3) 'work ($u 1)]
      mark=path ['assignments ($u 3) 'work ($u 1) 'mark]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      ss (course_tests/side 19)
      m0 (course_tests/wrote 18 seat2 (course_tests/text 'lede "a seat nobody fills") (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18)))))
      first (weave/tell c ms m0)
      m1 (course_tests/told 18 m0)
      k0 (course_tests/land 18 17 m1 (course_tests/blank 17))
      s0 (course_tests/land 18 19 m1 (course_tests/blank 19))
      k1 (course_tests/wrote 17 set (course_tests/text 'title "Assignment 3") k0)
      second (weave/tell c ks k1)
      k2 (course_tests/told 17 k1)
      s1 (course_tests/land 17 19 k2 s0)
      to_maker=path [($x 17) 'our ($x 18) ($x 18) 'app 'course 'assignments ($u 3)]
      forged=path [($x 17) 'her ($x 20) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
      lie=row[[p=path q=writ]] [[forged (writ/make (course_tests/text 'work "not hers"))]]
      kf (course_tests/put lie k2)
      s2 (course_tests/wrote 19 work (course_tests/text 'work "an essay") s1)
      s3 (course_tests/told 19 s2)
      k3 (course_tests/land 19 17 s3 k2)
      k4 (course_tests/wrote 17 mark (course_tests/text 'grade "A-") k3)
      k5 (course_tests/told 17 k4)
      s4 (course_tests/land 17 19 k5 s3)
      sx (course_tests/wrote 19 stray (course_tests/text 'title "not hers to set") s4)
      got (weave/seen c ss 17 mark s4).fall(myth/new)
      seats_at (course_tests/table).at(2).path
      in_one=row[weave/bind] [(weave/bind 's ($u 1))]
      in_two=row[weave/bind] [(weave/bind 's ($u 2))]
      for_chair=path [($x 19) 'our ($x 17) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
      for_maker=path [($x 19) 'our ($x 18) ($x 18) 'app 'course 'assignments ($u 3) 'work ($u 1)]
    [(testing/nat "the maker writes each of its four records for both who sit, and a root for each" 10 first.len)
     (testing/nat "told again when nothing moved, it writes nothing" 0 (weave/tell c ms m1).len)
     (testing/nat "who fills a seat is read off the seat" 1 (eq 19 (weave/sitters c ks seats_at in_one k0).at(0)))
     (testing/nat "a seat nobody fills names nobody" 0 (weave/sitters c ks seats_at in_two k0).len)
     (testing/nat "the chair's assignment is written for the seat that is filled, and roots for the two others" 3 second.len)
     (testing/nat "and not for the maker, who does not read assignments" 0 (? (net/live to_maker k2) 1 0))
     (testing/nat "the student has one thing to do: the work only that seat writes" 1 (weave/todo c ss s1).len)
     (testing/nat "at the assignment, in its own seat" 1 (? (equal[path] work (weave/todo c ss s1).at(0)) 1 0))
     (testing/nat "the chair has nothing to do yet" 0 (weave/todo c ks k2).len)
     (testing/nat "and waits on one thing: that seat's work, not the empty seat's" 1 (weave/waits c ks k2).len)
     (testing/nat "work published by a world that does not fill the seat is not read" 0 (? (maybe/is_some (weave/seen c ks 19 work kf)) 1 0))
     (testing/nat "and gives the chair nothing to mark" 0 (weave/todo c ks kf).len)
     (testing/nat "the student's work is written for the chair" 1 (? (net/live for_chair s3) 1 0))
     (testing/nat "and for nobody else: the maker does not read work" 0 (? (net/live for_maker s3) 1 0))
     (testing/nat "submitted, the student has nothing to do" 0 (weave/todo c ss s3).len)
     (testing/nat "and waits on the chair for a mark" 1 (weave/waits c ss s3).len)
     (testing/nat "the chair now has one thing to do: mark it" 1 (weave/todo c ks k3).len)
     (testing/nat "which is the mark of that work" 1 (? (equal[path] mark (weave/todo c ks k3).at(0)) 1 0))
     (testing/nat "the mark is written for that seat alone" 1 (weave/tell c ks k4).len)
     (testing/text "and the student holds it, from the chair" "A-" got.txt_at(['grade]))
     (testing/nat "after which nobody waits" 0 (add (weave/waits c ss s4).len (weave/waits c ks k5).len))
     (testing/nat "and nobody has anything to do" 0 (add (weave/todo c ss s4).len (weave/todo c ks k5).len))
     (testing/nat "what a world writes where it does not write is written for nobody" 0 (weave/tell c ss sx).len)]
  + asking_table
    ' The course's table with one more row: a seat may ask for an
    ' assignment to be extended, and the chair, who writes assignments,
    ' applies it. Whole: with the table's own row and the answer's.
    ^ row[weave/position]
    = seats_at=row[weave/seg] [(course_tests/lit 'seats) (course_tests/cap 's)]
      chair_at=row[weave/seg] [(course_tests/lit 'chair)]
      ask_at=row[weave/seg] [(course_tests/lit 'assignments) (course_tests/cap 'a) (course_tests/lit 'extensions) (course_tests/cap 's)]
      to_chair=row[weave/who] [(weave/who .false chair_at)]
      more=row[weave/position] [(weave/position ask_at (weave/who .false seats_at) to_chair "/gov/course/extend")]
    | weave/whole (course_tests/table).weld(more)
  + asking_course
    ^ weave/comp
    = rel=path ['app 'course]
    | weave/comp 18 rel course_tests/asking_table
  + spoke
    ' A world after it wrote what that table says it must, and answered
    ' what it was asked.
    \ n=nat state=namespace
    ^ namespace
    = c course_tests/asking_course
      s (course_tests/side n)
    | course_tests/put (weave/tell c s state).weld((weave/answers c s state)) state
  + kept
    ' A record put into a world as it is, code and all.
    \ name=path record=myth state=namespace
    ^ namespace
    = diffs (axal/new[note] .none).put(name (note/make record))
    ? (namespace/step diffs 0 0 state)
     > (./accepted committed) committed.state
     > (./rejected _) state
  + extend
    ' The action as the chair's world holds it: so many days more, and
    ' none is refused.
    \ arguments=myth current=myth
    ^ maybe[myth]
    = days arguments.nat_at(['days] 0)
    ? (eq 0 days) .none
    | ./some current.put(['due] (pails/n (add days current.nat_at(['due] 0))))
  + asking
    ' The seat asks for three days more on an assignment. The chair's
    ' world applies it and answers; the seat holds the new date and the
    ' answer. A world that sits nowhere asks and is not heard.
    \ _=unit
    ^ row[testing/check]
    = c course_tests/asking_course
      top=path []
      chair=path ['chair]
      seat1=path ['seats ($u 1)]
      set=path ['assignments ($u 3)]
      ask=path ['assignments ($u 3) 'extensions ($u 1)]
      reply=path ['assignments ($u 3) 'extensions ($u 1) 'answer]
      action=path [($x 17) 'gov 'course 'extend]
      ms (course_tests/side 18)
      ks (course_tests/side 17)
      ss (course_tests/side 19)
      due=path ['due]
      days=path ['days]
      m0 (course_tests/wrote 18 seat1 (course_tests/seat 19) (course_tests/wrote 18 chair (course_tests/seat 17) (course_tests/wrote 18 top (course_tests/text 'title "CS396") (course_tests/blank 18))))
      m1 (course_tests/spoke 18 m0)
      k0 (course_tests/kept action (myth/sing system_vocabulary/grove/action_handler (grove_action_handler course_tests/extend)) (course_tests/land 18 17 m1 (course_tests/blank 17)))
      s0 (course_tests/land 18 19 m1 (course_tests/blank 19))
      k1 (course_tests/spoke 17 (course_tests/wrote 17 set (myth/sing due (pails/n 10)) k0))
      s1 (course_tests/land 17 19 k1 s0)
      s2 (course_tests/spoke 19 (course_tests/wrote 19 ask (myth/sing days (pails/n 3)) s1))
      k2 (course_tests/land 19 17 s2 k1)
      asked (weave/asked c ks k2)
      k3 (course_tests/spoke 17 k2)
      k4 (course_tests/spoke 17 k3)
      s3 (course_tests/land 17 19 k4 s2)
      forged=path [($x 17) 'her ($x 20) ($x 18) 'app 'course 'assignments ($u 3) 'extensions ($u 1)]
      lie=row[[p=path q=writ]] [[forged (writ/make (myth/sing days (pails/n 99)))]]
      kf (course_tests/put lie k1)
      nothing (course_tests/land 19 17 (course_tests/spoke 19 (course_tests/wrote 19 ask (myth/sing days (pails/n 0)) s1)) k1)
      refused (course_tests/spoke 17 nothing)
      bare (course_tests/land 19 17 s2 (course_tests/spoke 17 (course_tests/wrote 17 set (myth/sing due (pails/n 10)) (course_tests/land 18 17 m1 (course_tests/blank 17)))))
      unheld (course_tests/spoke 17 bare)
    [(testing/nat "a row that applies an action brings its answer's row: the thing's writer writes it" 1 (course_tests/asking_table).keep((\ p=weave/position (equal[str] "assignments/[a]/extensions/[s]/answer" (weave/spelled p.path)))).len)
     (testing/text "for whoever asked" "seats/[s]" (weave/said (course_tests/pick "assignments/[a]/extensions/[s]/answer" course_tests/asking_table).readers.at(0)))
     (testing/text "and the chair writes it" "chair" (weave/said (course_tests/pick "assignments/[a]/extensions/[s]/answer" course_tests/asking_table).writer))
     (testing/nat "the seat may ask one thing: more time on the assignment" 1 (weave/may c ss s1).len)
     (testing/nat "which is not something it has to do: that is still only its work" 1 (weave/todo c ss s1).len)
     (testing/nat "the chair may ask nothing" 0 (weave/may c ks k1).len)
     (testing/nat "asked, the seat may ask no more there" 0 (weave/may c ss s2).len)
     (testing/nat "and waits on the chair for the answer" 1 (course_tests/yes (weave/waits c ss s2).any((\ [place on] (equal[path] place reply)))))
     (testing/nat "the chair is asked one thing" 1 asked.len)
     (testing/nat "by the world that fills the seat" 19 asked.at(0).asker)
     (testing/nat "of the assignment it writes" 1 (course_tests/yes (equal[path] set asked.at(0).thing)))
     (testing/nat "its world applies the action it holds: three days more" 13 (course_tests/record_at 17 set k3).nat_at(due 0))
     (testing/nat "and answers: done" 1 (course_tests/record_at 17 reply k3).nat_at(['done] 0))
     (testing/nat "answered, it is asked nothing" 0 (weave/asked c ks k3).len)
     (testing/nat "the seat holds the new date, from the chair" 13 (weave/seen c ss 17 set s3).fall(myth/new).nat_at(due 0))
     (testing/nat "and the answer" 1 (weave/seen c ss 17 reply s3).fall(myth/new).nat_at(['done] 0))
     (testing/nat "an ask from a world that does not fill the seat is not heard" 0 (weave/asked c ks kf).len)
     (testing/nat "an ask the action refuses is answered: not" 2 (course_tests/record_at 17 reply refused).nat_at(['done] 0))
     (testing/nat "and the assignment stands as it was" 10 (course_tests/record_at 17 set refused).nat_at(due 0))
     (testing/nat "a world that does not hold the action answers: not, and says why" 2 (course_tests/record_at 17 reply unheld).nat_at(['done] 0))
     (testing/nat "and changes nothing" 10 (course_tests/record_at 17 set unheld).nat_at(due 0))]
  + yes
    \ said=bool
    ^ nat
    ? said 1
    0
  + record_at
    ' What a world wrote on its own side at a place.
    \ n=nat rel=path state=namespace
    ^ myth
    | (sovereign_care .x (course_tests/side n).root.weld(rel) state).fil.fall(myth/new)

+ tests
  ^ row[testing/case]
  [(testing/case "a course, read off its table" course_tests/checks)
   (testing/case "the table itself is records" course_tests/records)
   (testing/case "a Grove unit's norms are the table" course_tests/published)
   (testing/case "an action asked across worlds" course_tests/asking)]
