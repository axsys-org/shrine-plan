- http_foot
- testing
- tests/namespace [at=fixture]

+ value_tests
  + record
    ^ myth
    = base=myth myth/new
    | base.gas
      [[['text] (pt "hello")]
       [['long] (pt (str/repeat 2047 "a").cat("€tail"))]
       [['threshold] (pt (str/repeat 2048 "a"))]
       [['body] (pd (str/to_atom (str/repeat 1025 "b")))]
       [['nul] (pt (str/from_atom (add 65 (mul 65536 66))))]
       [['invalid] (pt (str/from_atom 255))]
       [['zero] (pd 0)]
       [['huge] (pd (bex 2048))]
       [['opaque] (pails/p ['other])]
       [['a 'b] (pt "opaque slot key")]]
  + version
    \ record=myth
    ^ saga
    | saga (aeon/unsigned (yuga (lock 1 1) (lock 1 1) (lock 1 1) 0 0)) (pin record)
  + state
    ^ sov
    = original=myth value_tests/record
      old (value_tests/version original)
      updated (value_tests/version original.put(['text] (pt "changed")))
      history (uon/sing[ass] ($u 1) (ass/ker old)).put(($u 3) (ass/ker updated)).put(($u 4) (ass/nul old.aeon))
      index (axal/new[tome] .none).put(['demo] (tome (pin history)))
    | sov (ledger [] []) index 4 (axal/new[urn] .none)
  + read
    \ slot=path epoch=nat offset=nat limit=nat
    ^ either[iota value_read/chunk]
    | value_read/read (value_read/request ['demo] slot epoch offset limit) value_tests/state
  + chunk
    \ slot=path epoch=nat offset=nat limit=nat
    ^ value_read/chunk
    ? (value_tests/read slot epoch offset limit)
     > (./ok chunk) chunk
     > (./err reason)
       ; (error (helm/supervisor/rejection reason))
       | value_read/chunk [] [] 0 0 "text" 0 0 .none ""
  + error
    \ result=either[iota value_read/chunk]
    ^ iota
    ? result
     > (./err reason) reason
     > (./ok _) 'unexpected_success
  + core
    \ ignored=unit
    ^ row[testing/check]
    = first (value_tests/chunk ['text] 2 0 2)
      end (value_tests/chunk ['text] 2 2 65536)
      nul (value_tests/chunk ['nul] 1 1 1)
      eof (value_tests/chunk ['text] 1 5 1)
      empty (value_tests/chunk ['zero] 1 0 1)
      huge (value_tests/chunk ['huge] 1 255 2)
      initial fixture/namespace_tests/initial
      query (value_read/request [initial.self 'demo] ['text] 2 0 2)
      raw value_tests/state
      tree (axal/new[tome] .none)
      state (namespace initial.self
        raw.set_idx(tree.set_kid(tree.kid_put(initial.self raw.idx))) initial.system)
      index (sovereign_hive state)
      [after_state after_index answer] (helm/supervisor/handle (helm/card/value 99 query) state index)
      correlated
        ? answer
         > (./value request _) (eq request 99)
        .false
    [(testing/text "first exact bytes" "6865" first.hex)
     (testing/nat "requested epoch retained" 2 first.epoch)
     (testing/nat "actual assertion epoch retained" 1 first.record_epoch)
     (testing/nat "next is an exclusive byte offset" 2 first.next.fall(0))
     (testing/text "last chunk exact bytes" "6c6c6f" end.hex)
     (testing/nat "last chunk has no next" 0 (maybe/is_some end.next))
     (testing/text "embedded NUL survives one-byte chunk" "00" nul.hex)
     (testing/nat "embedded NUL counts toward length" 3 nul.total)
     (testing/text "UTF-8 split byte is preserved" "82" (value_tests/chunk ['long] 1 2048 1).hex)
     (testing/text "invalid UTF-8 is exact raw bytes" "ff" (value_tests/chunk ['invalid] 1 0 1).hex)
     (testing/text "zero is empty minimal natural" "" empty.hex)
     (testing/nat "zero length" 0 empty.total)
     (testing/text "huge natural does not use decimal formatting" "0001" huge.hex)
     (testing/nat "huge natural exact byte count" 257 huge.total)
     (testing/text "EOF is empty" "" eof.hex)
     (testing/nat "EOF has no next" 0 (maybe/is_some eof.next))
     (testing/text "later version differs" "6368616e676564" (value_tests/chunk ['text] 3 0 40).hex)
     (testing/text "old version remains exact after later commit and deletion" "68656c6c6f" (value_tests/chunk ['text] 1 0 40).hex)
     (testing/nat "opaque slot path is not a child path" 15 (value_tests/chunk ['a 'b] 1 0 40).total)
     (testing/nat "read handler preserves state" 1 (equal state after_state))
     (testing/nat "read handler preserves hive" 1 (equal index after_index))
     (testing/nat "reply preserves correlation" 1
       correlated)
     (testing/nat "stored trailing zero bits have no invented length" 1 (wid (add 97 (mul 256 0))))]
  + failures
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "future epoch refuses floating live value" 1 (eq_iota 'future_epoch (value_tests/error (value_tests/read ['text] 5 0 4))))
     (testing/nat "before first assertion is missing" 1 (eq_iota 'record_missing (value_tests/error (value_tests/read ['text] 0 0 4))))
     (testing/nat "tombstone is distinct" 1 (eq_iota 'record_deleted (value_tests/error (value_tests/read ['text] 4 0 4))))
     (testing/nat "missing slot is distinct" 1 (eq_iota 'slot_missing (value_tests/error (value_tests/read ['missing] 1 0 4))))
     (testing/nat "opaque pail is not rendered as raw" 1 (eq_iota 'unsupported_type (value_tests/error (value_tests/read ['opaque] 1 0 4))))
     (testing/nat "out of range refuses" 1 (eq_iota 'offset_out_of_range (value_tests/error (value_tests/read ['text] 1 6 4))))
     (testing/nat "zero limit refuses" 1 (eq_iota 'invalid_limit (value_tests/error (value_tests/read ['text] 1 0 0))))
     (testing/nat "oversize limit refuses" 1 (eq_iota 'invalid_limit (value_tests/error (value_tests/read ['text] 1 0 65537))))
     (testing/nat "derived path is not empty physical fallback" 1
       (eq_iota 'derived_path (value_tests/error (value_read/read (value_read/request ['x 'demo] ['text] 1 0 4) value_tests/state))))]
  + status
    \ target=str
    ^ nat
    ? (http_foot/plan (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./value query) 200
    0
  + queries
    \ ignored=unit
    ^ row[testing/check]
    = base=str "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=40"
      invalid=row[str]
        ["/debug-read/value" "/debug-read/value?path=/demo"
         base.cat("&epoch=2") base.cat("&%65poch=2") base.cat("&unknown=1") base.cat("&")
         base.cat("?limit=4")
         "/debug-read/value?path=demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo/&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=//demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/./demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/../demo&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%00&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%09&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%0A&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%7F&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/%zz&slot=/text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=text&epoch=1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=01&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=+1&offset=0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=-1&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=1.0&limit=4"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=0"
         "/debug-read/value?path=/demo&slot=/text&epoch=1&offset=0&limit=65537"]
    [(testing/nat "canonical query bypasses namespace HTTP record" 200 (value_tests/status base))
     (testing/nat "invalid query matrix" 1 (invalid.all((\ url (eq 400 (value_tests/status url))))))
     (testing/nat "encoded canonical keys and values accepted" 200
       (value_tests/status "/debug-read/value?%70ath=%2Fdemo&slot=%2Fa%2Fb&epoch=123456789012345678901234567890&offset=0&limit=65536"))]
  + serialization
    \ ignored=unit
    ^ row[testing/check]
    = name (str/cat_all ["quote" (str/from_atom 34) "slash" (str/from_atom 92)])
      pax=path [($ta name)]
      chunk (value_read/chunk pax pax 4 1 "text" 3 0 .none "410042")
      expected (show (json/obj
        [(jkv "version" (json/num .false 1))
         (jkv "path" (json/str (path_show pax)))
         (jkv "slot" (json/str (path_show pax)))
         (jkv "epoch" (json/str "4"))
         (jkv "recordEpoch" (json/str "1"))
         (jkv "type" (json/str "text"))
         (jkv "representation" (json/str "utf8-bytes"))
         (jkv "encoding" (json/str "hex"))
         (jkv "total" (json/str "3"))
         (jkv "offset" (json/str "0"))
         (jkv "next" (json/nul 0))
         (jkv "complete" (json/boo .true))
         (jkv "hex" (json/str "410042"))]))
      sparse (add (str/to_atom (str/repeat 31 "a")) (bex 512))
      maximum (str/to_atom (str/repeat 65536 "a"))
    [(testing/text "specialized envelope is byte-identical to standard JSON with escaped identities" expected (value_read/json chunk))
     (testing/text "block boundaries retain zero runs" (str/cat_all [(str/repeat 31 "61") (str/repeat 33 "00") "01"])
       (value_read/hex_slice sparse 0 65))
     (testing/text "full 64K hex window is exact" (str/repeat 65536 "61") (value_read/hex_slice maximum 0 65536))]

+ tests
  ^ row[testing/case]
  [(testing/case "typed value chunks" value_tests/core)
   (testing/case "typed value errors" value_tests/failures)
   (testing/case "strict value query grammar" value_tests/queries)
   (testing/case "bounded byte serialization" value_tests/serialization)]
