- tests/physical_read
- tests/journal_page
- eden

' Real registered HTTP transport, only for disposable compiler workers.
+ physical_http
  + key
    \ pax=path
    ^ str
    ? (physical_key/encode pax)
     > (./ok text) text
     > (./err _) "invalid"
  + url
    \ pax=path collection=str
    ^ str
    | str/cat_all ["/debug-read/physical?pathKey=" (physical_http/key pax) "&collection=" collection]
  + record
    ^ myth
    = base=myth myth/new
    | base.gas
      [[[] (pt "empty key")]
       [['sys 'lede] (pt "Authored fixture")]
       [['sys 'help] (lore "Fallback title" ["" "Authored help" "Later line"] [])]
       [['text] (pt "hello")]
       [['long] (pt (str/repeat 255 "a").cat("€tail"))]
       [['nul] (pt (str/from_atom (add 65 (mul 65536 66))))]
       [['zero] (pd 0)]
       [['huge] (pd (bex 4096))]
       [['reference] (pails/p ['elsewhere])]
       [['opaque] (lore/line "Opaque as a field")]
       [['a 'b] (pt "one opaque slot key")]]
  + order_keys
    ^ row[iota]
    [($dm 0) ($dr 0) ($ds 0) ($f 0) ($f 1) ($f 2) ($r 0)
     ($rd (add (bex 63) 4607182418800017408)) ($rd (bex 63)) ($rd 0)
     ($rd 4607182418800017408) ($rd 9221120237041090560) ($rd (add (bex 64) 4607182418800017408))
     ($rs (add (bex 31) 1065353216)) ($rs (bex 31)) ($rs 0)
     ($rs 1065353216) ($rs 2143289344) ($rs (add (bex 32) 1065353216))
     ($s 3) ($s 1) ($s 0) ($s 2)
     ($ta "aa") ($ta "b") ($ts 255) ($ts "aa") ($ts "b")
     ($tu 255) ($tu "aa") ($tu "b") ($u 0) ($u 10) ($w 0) ($x 0)]
  + state
    \ port=nat count=nat
    ^ sov
    = simple (physical_tests/history 1 (myth/sing ['value] (pd 7)))
      big
        % i=nat 0 out=axal[tome] (axal/new[tome] .none)
        ? (eq i count) out
        | _ i.inc out.put([($u i)] simple)
      slots
        % i=nat 0 out=myth myth/new
        ? (eq i count) out
        | _ i.inc out.put([($u i)] (pd i))
      ordered
        = keys=row[iota] physical_http/order_keys
        | keys.fold (axal/new[tome] .none)
        \ out=axal[tome] key=iota
        | out.put [key] simple
      wide
        % i=nat 0 out=myth myth/new
        ? (eq i 20) out
        = key ($ta (str/repeat 3500 "a").cat((nat/show i)))
        | _ i.inc out.put([key] (pt "wide identity"))
      old (physical_tests/version myth/new)
      dead (tome (pin (uon/sing[ass] ($u 2) (ass/nul old.aeon))))
      broken (axal[tome] .none (bee/limb[axal/k[tome]] (bex 300) [] []))
      oversized (axal/new[tome] .none).put([($ta (str/repeat 4100 "z"))] simple)
      index (axal/new[tome] (./some simple))
      index index.put(['io 'http] (physical_tests/history 1
        (http/cfg_port [($x 17) 'kook 'hserve] [($x 17) 'kook 'hex] port)))
      index index.rep(['big] big).put(['slots] (physical_tests/history 1 slots))
      index index.rep(['order] ordered).put(['wide] (physical_tests/history 1 wide))
      index index.put(['demo] (physical_tests/history 1 physical_http/record))
      index index.put(['empty] (physical_tests/history 1 myth/new))
      index index.put(['spine 'leaf] simple).put(['dead] dead)
      index index.rep(['zzzbroken] broken).rep(['oversized] oversized)
      index index.put(['log ($u 1)] (journal_tests/history 1))
    | physical_tests/state index 3
  + epoch_fail
    \ initial=namespace reason=str
    ^ namespace
    ; (error (eden/err reason))
    initial
  + epoch_state
    ' A real clean commit fixture, separate from the synthetic large index
    ' and its deliberately malformed/unsupported read-only branches.
    \ initial=namespace
    ^ namespace
    = changes (axal/new[note] .none).put([initial.self 'demo] (note/make physical_http/record))
    ?> (./accepted seeded) initial.step(changes 0 0)
        (physical_http/epoch_fail initial "Physical epoch fixture seed failed")
    seeded.state
  + status
    \ target=str
    ^ nat
    ? (http_foot/plan (http_foot/request "GET" target "") 0)
     > (./reply response) response.status
     > (./physical _) 200
    0
  + queries
    \ ignored=unit
    ^ row[testing/check]
    = base (physical_http/url ['demo] "children")
      maximum (str/cat_all ["v1" (str/repeat 2730 "/f:")])
      invalid=row[str]
        ["/debug-read/physical" "/debug-read/physical?" "/debug-read/physical?pathKey=v1"
         base.cat("&pathKey=v1") base.cat("&%70athKey=v1") base.cat("&collection=slots")
         base.cat("&epoch=3&epoch=3") base.cat("&limit=1&limit=1")
         base.cat("&unknown=1") base.cat("&") base.cat("&&limit=1") base.cat("?limit=1")
         base.cat("&epoch=") base.cat("&epoch=01") base.cat("&epoch=-1") base.cat("&epoch=+1")
         base.cat("&epoch=1.0") base.cat("&epoch=%203")
         base.cat("&epoch=").cat((str/repeat 129 "1"))
         base.cat("&limit=0") base.cat("&limit=41") base.cat("&limit=01")
         base.cat("&after=v1/u:") base.cat("&epoch=3&after=v1")
         base.cat("&epoch=3&after=v1/u:/u:")
         "/debug-read/physical?pathKey=v1/u:%00&collection=children"
         "/debug-read/physical?pathKey=v1/u:%09&collection=children"
         "/debug-read/physical?pathKey=v1/u:%7f&collection=children"
         "/debug-read/physical?pathKey=v1/u:%zz&collection=children"
         "/debug-read/physical?pathKey=v1/u:00&collection=children"
         "/debug-read/physical?pathKey=v1/u:AA&collection=children"
         "/debug-read/physical?pathKey=v1&collection=other"]
      request (http_foot/plan (http_foot/request "GET" base "") 0)
      defaults
        ? request
         > (./physical query)
           ? !(eq query.limit 40) .false
           ? (maybe/is_some query.epoch) .false
           | maybe/is_none query.after
        .false
    [(testing/nat "physical route bypasses ordinary namespace action" 1 defaults)
     (testing/nat "strict invalid query matrix" 1 (row/all[str] (\ url=str (eq 400 (physical_http/status url))) invalid))
     (testing/nat "root structural identity accepted" 200 (physical_http/status "/debug-read/physical?pathKey=v1&collection=children"))
     (testing/nat "empty opaque slot cursor retained" 200 (physical_http/status "/debug-read/physical?pathKey=v1&collection=slots&epoch=3&after=v1"))
     (testing/nat "encoded names and exact values accepted" 200 (physical_http/status "/debug-read/physical?%70athKey=v1%2Fu%3A01&collection=children&epoch=3&after=v1%2Fu%3A&limit=1"))
     (testing/nat "maximum path and opaque cursor fit canonical raw query" 200
       (physical_http/status (str/cat_all ["/debug-read/physical?pathKey=" maximum "&collection=slots&epoch=3&after=" maximum])))
     (testing/nat "raw request line NUL is rejected before tokenization" 0
       (http_foot/request_line_valid (str/cat_all ["GET /" (str/from_atom (add 65 (mul 65536 66))) " HTTP/1.1" (str/from_atom 13)])))
     (testing/nat "normal CR terminated request line remains valid" 1
       (http_foot/request_line_valid "GET / HTTP/1.1".cat((str/from_atom 13))))
     (testing/nat "socket sentinel NUL boundary rejects before unpacking" 1
       (either/is_err (Try http_foot/request_chunk (add 65 (bex 16)))))
     (testing/text "normal socket sentinel payload is unchanged" "A"
       (http_foot/request_chunk (add 65 (bex 8))))
     (testing/text "unescaped physical identity remains exact" "v1/u:0001"
       (http_foot/physical_decode "v1/u:0001"))
     (testing/text "percent and plus retain existing strict decoding" "v1/u: a"
       (http_foot/physical_decode "%76%31%2Fu%3A+a"))]
  + framing
    \ ignored=unit
    ^ row[testing/check]
    = delimiter (http_foot/crlf).cat(http_foot/crlf)
      boundary (str/repeat 16382 "x").cat(delimiter)
      short=row[str] ["" (str/from_atom 13) http_foot/crlf
        (http_foot/crlf).cat((str/from_atom 13)) "\n\n"]
    [(testing/nat "partial or non-CRLF header endings are absent" 1
       (row/all[str] (\ text=str (maybe/is_none (http_foot/header_end text))) short))
     (testing/nat "empty header delimiter ends at four" 1
       (equal (http_foot/header_end delimiter) (maybe/some[nat] 4)))
     (testing/nat "first delimiter wins even with body delimiters" 1
       (equal (http_foot/header_end (str/cat_all ["x" delimiter "body" delimiter])) (maybe/some[nat] 5)))
     (testing/nat "overlapping CR prefix does not skip delimiter" 1
       (equal (http_foot/header_end (str/from_atom 13).cat(delimiter)) (maybe/some[nat] 5)))
     (testing/nat "first socket chunk retains incomplete delimiter" 1
       (maybe/is_none (http_foot/header_end boundary.slice(0 16384))))
     (testing/nat "cross-chunk delimiter is recognized on completion" 1
       (equal (http_foot/header_end boundary) (maybe/some[nat] 16386)))
     (testing/nat "maximum delimiter-free header is scanned safely" 1
       (maybe/is_none (http_foot/header_end (str/repeat 65536 "x"))))]
  + transport
    \ ignored=unit
    ^ row[testing/check]
    = state (journal_tests/qualify (physical_http/state 8080 3))
      index (sovereign_hive state)
      query (physical_read/request [state.self 'demo] .none 'slots .none 40)
      [same same_index answer] (helm/supervisor/handle (helm/card/physical 73 query) state index)
      exact
        ? answer
         > (./physical request result)
           ? !(eq request 73) .false
           | equal result (physical_projection/namespace_safe_json query state)
        .false
      bad (physical_read/request [state.self 'zzzbroken] .none 'children .none 40)
      [same_bad same_bad_index failed] (helm/supervisor/handle (helm/card/physical 74 bad) state index)
      failure
        ? failed
         > (./physical request result)
           ? !(eq request 74) .false
           ? result
            > (./err reason) (eq_iota reason 'read_failed)
           .false
        .false
    [(testing/nat "supervisor returns exact forced JSON and correlation" 1 exact)
     (testing/nat "success preserves sovereign" 1 (equal state same))
     (testing/nat "success preserves hive" 1 (equal index same_index))
     (testing/nat "gift maps only to physical read card" 1
       (equal (feet/gift/normalize ['io 'http] (feet/gift/physical 73 query)) (maybe/some[helm/card] (helm/card/physical 73 query))))
     (testing/nat "stored projection error becomes correlated failure" 1 failure)
     (testing/nat "failure preserves sovereign and hive" 1 (? (equal state same_bad) (equal index same_bad_index) .false))
     (testing/nat "JSON response success content type" 1
       (eq (http_foot/physical_response (./ok "{}")).ctype "application/json; charset=utf-8"))
     (testing/nat "read_failed response is HTTP500" 500 (http_foot/physical_response (./err 'read_failed)).status)]

+ tests
  ^ row[testing/case]
  [(testing/case "strict physical HTTP queries" physical_http/queries)
   (testing/case "bounded socket header framing" physical_http/framing)
   (testing/case "read-only physical transport" physical_http/transport)]
