-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  weft [order=80]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  helm [order=130]
-  testing [order=170]
-  lainapp [order=180]
-  tmplapp [order=190]
-  app_test_world [order=200]

+  check
  \ n=nat yes=bool
  ^ testing/check
  | testing/nat (nat/show n) 1 yes

+  pail_value
  \ item=maybe[pail]
  ^ pail
  ?> (./some value) item (pd 0)
  value
+  pail_path
  \ item=pail
  ^ path
  ?> value=pails/p item []
  value.p
+  pail_paths
  \ item=pail
  ^ row[path]
  ?> value=pails/ps item []
  value.ps
+  kook_refs
  \ item=pail
  ^ row[path]
  ?> value=kook item []
  value.refs
+  seed_index
  \ target=path seeds=row[[path myth]]
  ^ nat
  % index=nat 0
  ? (ge index seeds.len) 0
  = [path record] seeds.at(index)
  ? (equal target path) index.inc
  | _ index.inc
+  seed_at
  \ target=path seeds=row[[path myth]]
  ^ myth
  = index | seed_index target seeds
  ? !(index) myth/new
  = [path record] seeds.at(index.dec)
  record

+  behavior
  \ _=unit
  ^ row[testing/check]
  = base (app_world/make ['kook 'ma] (form/card demo/ma_form (lore/line
      "Dispatch probe." )) app_world/seed)
  = tw=iota 'w
  = thome=iota 'home
  = tideas=iota 'ideas
  = tapp=iota 'app
  = limb_path=path ['sys 'limb]
  = kind_slot=path ['kind]
  = [wroot wseeds] wiki_parts
  = home_rec (seed_at [tw thome] wseeds)
  = home_limb (myth/pail_at limb_path home_rec)
  = link0 (myth/pail_at ['doc 'link] home_rec)
  = rr (pact/rebase_rec [tapp 't] rel_ref_rec)
  = rr_limb (myth/pail_at limb_path rr)
  = tt1=iota 't1
  = r1 (app_world/make [tapp tt1] (pact/card wiki_mani "tmpl/wiki" 0 0)
      base)
  = s1 r1
  = hl (app_world/pail [tapp tt1 tw thome] limb_path s1)
  = lk (app_world/pail [tapp tt1 tw thome] ['doc 'link] s1)
  = r5a (app_world/step (task/vine [tapp tt1 tw thome] (writ/poke
      myth/new)) s1)
  = r5b (app_world/step (task/vine [tapp tt1 tw thome] (writ/poke
      myth/new)) r5a)
  = s5 r5b
  = tt2=iota 't2
  = r6 (app_world/make [tapp tt2] (pact/card wiki_mani "tmpl/wiki" 0 0)
      s5)
  = s6 r6
  = lk2 (app_world/pail [tapp tt2 tw thome] ['doc 'link] s6)
  = tt3=iota 't3
  = r7 (app_world/step (wiki_vine [tapp tt3]) base)
  = s7 r7
  = lk3 (app_world/pail [tapp tt3 tw thome] ['doc 'link] s7)
  = tt4=iota 't4
  = r8 (app_world/step (empty_vine [tapp tt4]) base)
  = tt5=iota 't5
  = r9 (app_world/step (collide_vine [tapp tt5]) base)
  = [sroot sseeds] spec_parts
  = tt6=iota 't6
  = r10 (app_world/step (spec_vine [tapp tt6]) base)
  = s10 r10
  = lash_slot=path ['sys 'lash]
  = status_slot=path ['status]
  = tg=iota 'g1
  = g0 (app_world/make [tapp tg] (pact/card gate_mani "tmpl/gated" 0 0)
      base)
  = gsov g0
  = ghl (app_world/pail [tapp tg thome] lash_slot gsov)
  = gbad (app_world/refuses (task/vine [tapp tg thome] (writ/poke
      (myth/sing status_slot (pd 7)))) gsov)
  = gok (app_world/poke [tapp tg thome] (myth/sing status_slot (pt
      "doing" )) gsov)
  = ws12 (weld_app).seeds
  = textra=iota 'extra
  = whome (seed_at [thome] ws12)
  = tw13=iota 'w13
  = tkid=iota 'kid
  = w0 (app_world/make [tapp tw13] ward_seed base)
  = w1 (app_world/make [tapp tw13 tkid] (myth/sing ['note] (pt "hi" ))
      w0)
  = klash (app_world/pail [tapp tw13 tkid] lash_slot w1)
  = w2 (app_world/refuses (task/vine [tapp tw13 tkid] (writ/poke
      (myth/sing status_slot (pd 7)))) w1)
  = w3 (app_world/poke [tapp tw13 tkid] (myth/sing status_slot (pt "ok"
      )) w1)
  = loose (app_world/step (task/vine [tapp tw13 tkid] (writ/poke
      (myth/sing lash_slot lash/new))) w3)
  = llash (app_world/pail [tapp tw13 tkid] lash_slot loose)
  [
    (check 1 (equal[nat] (row/len wseeds) 9))
    (check 2 (equal[str] (myth/txt_at kind_slot wroot) "doc"))
    (check 3 ?=(held=pails/n (myth/pail_at limb_path wroot)))
    (check 4 (equal[str] (myth/txt_at kind_slot home_rec) "doc"))
    (check 5 (equal[str] (myth/txt_at ['title] (seed_at [($u 0)]
      wseeds)) "The wiki template" ))
    (check 6 (equal[str] (myth/txt_at ['title] (seed_at [tw thome ($u
      0)] wseeds)) "Home" ))
    (check 7 (equal[str] (myth/txt_at ['text] (seed_at [tw thome ($u 0)
      ($u 0)] wseeds)) "Welcome." ))
    (check 8 (equal[str] (myth/txt_at ['lead] (seed_at [tw tideas ($u 0)
      ($u 1)] wseeds)) "two" ))
    (check 9 (equal[nat] (lt (seed_index [tw thome] wseeds) (seed_index
      [tw thome ($u 0)] wseeds)) 1))
    (check 10 (equal[nat] (lt (seed_index [tw tideas] wseeds)
      (seed_index [tw tideas ($u 0) ($u 0)] wseeds)) 1))
    (check 11 ?=(held=kook home_limb))
    (check 12 (equal[row[path]] (kook_refs home_limb) [['kook 'ma]]))
    (check 13 ?=(held=pails/n (myth/pail_at ['doc 'kook] home_rec)))
    (check 14 ?=(held=pails/p link0))
    (check 15 (equal[path] (pail_path link0) [($ts ".") tw tideas]))
    (check 16 (equal[path] (pail_path (myth/pail_at ['rp] rr)) [tapp 't
      tw tideas]))
    (check 17 (equal[path] (pail_path (myth/pail_at ['ap] rr)) ['boot
      'x]))
    (check 18 (equal[row[path]] (pail_paths (myth/pail_at ['rows] rr))
      [[tapp 't 'a] ['b]]))
    (check 19 (equal[row[path]] (kook_refs rr_limb) [[tapp 't 'kook
      'doc] ['kook 'ma]]))
    (check 20 r1.valid)
    (check 21 (equal[str] (app_world/text [tapp tt1 tw thome] kind_slot
      s1) "doc" ))
    (check 22 ?=((./some _) hl))
    (check 23 (equal[row[path]] (kook_refs (pail_value hl)) [['kook
      'ma]]))
    (check 24 (equal[path] (pail_path (pail_value lk)) [tapp tt1 tw
      tideas]))
    (check 25 (equal[str] (app_world/text [tapp tt1] kind_slot s1) "doc"
      ))
    (check 26 (equal[str] (app_world/text [tapp tt1] ['status] s1)
      "live" ))
    (check 27 (equal[str] (app_world/text [tapp tt1 ($u 0)] ['title] s1)
      "The wiki template" ))
    (check 28 r5a.valid)
    (check 29 r5b.valid)
    (check 30 (equal[nat] (app_world/number [tapp tt1 tw thome] ['ord] 0
      s5) 11))
    (check 31 r6.valid)
    (check 32 (equal[path] (pail_path (pail_value lk2)) [tapp tt2 tw
      tideas]))
    (check 33 (equal[nat] (app_world/number [tapp tt2 tw thome] ['ord] 0
      s6) 0))
    (check 34 (equal[nat] (app_world/number [tapp tt1 tw thome] ['ord] 0
      s6) 11))
    (check 35 r7.valid)
    (check 36 (equal[str] (app_world/text [tapp tt3 tw thome] kind_slot
      s7) "doc" ))
    (check 37 (equal[path] (pail_path (pail_value lk3)) [tapp tt3 tw
      tideas]))
    (check 38 (equal[str] (app_world/text [tapp tt3] ['status] s7) ""))
    (check 39 r8.valid)
    (check 40 (equal[str] (app_world/text [tapp tt4] kind_slot r8) "doc"
      ))
    (check 41 r9.valid)
    (check 42 (equal[str] (app_world/text [tapp tt5 tw 'dup] ['doc
      'mark] r9) "two" ))
    (check 43 (equal[nat] (row/len sseeds) 5))
    (check 44 (equal[str] (myth/txt_at kind_slot sroot) "doc"))
    (check 45 (equal[str] (myth/txt_at ['text] (seed_at [($u 0)]
      sseeds)) "A wiki spec." ))
    (check 46 (equal[str] (myth/txt_at ['lead] (seed_at [($u 1)]
      sseeds)) "Named pages plus numbered prose." ))
    (check 47 (equal[str] (myth/txt_at kind_slot (seed_at [thome]
      sseeds)) "doc" ))
    (check 48 (equal[str] (myth/txt_at ['text] (seed_at [thome ($u 0)]
      sseeds)) "The home page." ))
    (check 49 (equal[str] (myth/txt_at kind_slot (seed_at [($u 2)]
      sseeds)) "doc" ))
    (check 50 (equal[row[path]] spec_refs [[($ts "." ) 'w 'form] ['kook
      'ma]]))
    (check 51 ?=(held=pails/n (myth/pail_at limb_path sroot)))
    (check 52 r10.valid)
    (check 53 (equal[str] (app_world/text [tapp tt6 thome] kind_slot
      s10) "doc" ))
    (check 54 (equal[str] (app_world/text [tapp tt6 ($u 0)] ['text] s10)
      "A wiki spec." ))
    (check 55 g0.valid)
    (check 56 ?=((./some _) ghl))
    (check 57 ?=(held=lash (pail_value ghl)))
    (check 58 gbad)
    (check 59 gok.valid)
    (check 60 (equal[str] (app_world/text [tapp tg thome] status_slot
      gok) "doing" ))
    (check 61 (equal[iota] (weld_app).name 'gated))
    (check 62 (equal[nat] (row/len ws12) 3))
    (check 63 (equal[nat] (!(eq 0 (seed_index [thome] ws12))) 1))
    (check 64 (equal[str] (myth/txt_at kind_slot whome) "doc"))
    (check 65 (equal[str] (myth/txt_at ['note] whome) "from code"))
    (check 66 ?=(held=lash (myth/pail_at ['sys 'lash] whome)))
    (check 67 (equal[nat] (!(eq 0 (seed_index [textra] ws12))) 1))
    (check 68 ?=(held=pails/n (myth/pail_at ['sys 'lash] (seed_at
      [textra] ws12))))
    (check 69 w0.valid)
    (check 70 w1.valid)
    (check 71 ?=((./some _) klash))
    (check 72 ?=(held=lash (pail_value klash)))
    (check 73 w2)
    (check 74 w3.valid)
    (check 75 (equal[str] (app_world/text [tapp tw13 tkid] status_slot
      w3) "ok" ))
    (check 76 loose.valid)
    (check 77 (equal[pail] (pail_value llash) lash/new))
  ]

+  tests
  ^ row[testing/case]
  [(testing/case "tmpl behavior" behavior)]
