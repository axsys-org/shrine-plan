-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=50]
'  Focused regressions for the application kit's shared expansion.
+  pact_tests
  +  mount
    \ upgrade=bool
    ^ bool
    = here=path ['app 'test]
      seed (myth/sing ['value] (pd 7))
      app (mani 'test (lore/line "Test app")
            [(kook/decl 'worker def_form (lore/line "Worker"))]
            [[[] seed] [['kook 'worker] seed] [['data] seed]] [])
      kids (axal/new[myth] .none)
      kids
        ? upgrade
          kids.put(['kook 'worker] seed).put(['data] seed)
        kids
      b (bowl [] here 0 0 kids (mop/empty))
      card (pact/card app "test" 0 0)
      got
        ? upgrade
          | pact/talk b (myth/sing ['keep] (pd 9)) card
        | pact/init b card
      first=writ
        ? upgrade (./poke (form/card def_form (lore/line "Worker")))
        | ./make (form/card def_form (lore/line "Worker"))
      last=writ
        ? upgrade (./poke seed)
        | ./make seed
      expected=row[[p=path q=writ]]
        [[here.weld(['kook 'worker]) first]
         [here (writ/poke seed)]
         [here.weld(['kook 'worker]) (writ/poke seed)]
         [here.snoc('data) last]]
    ? !(equal got.cards expected) .false
    ? !(equal (myth/txt_at bond/lede got.out) "Test app") .false
    ? upgrade
      | equal got.out.get(['keep]) (maybe/some[pail] (pd 9))
    | equal got.out.get(pact/slot) (maybe/some[pail] app)

  +  invalid
    \ n=nat
    ^ bool
    = b (bowl [] ['app] 0 0 (axal/new[myth] .none) (mop/empty))
      cur (myth/sing ['keep] (pd n))
      bad (myth/sing pact/slot (pd n))
    ? !(equal (pact/init b cur) (yell [] cur)) .false
    ? !(equal (pact/init b bad) (yell [] bad)) .false
    ? !(equal (pact/talk b cur bad) (yell [] cur.meld(bad))) .false
    | equal (pact/talk b cur myth/new) (yell [] cur)

  +  rebase
    \ n=nat
    ^ bool
    = here=path ['app 'test]
      rel (pact/rel ['data])
      abs=path ['shared]
      dest here.snoc('data)
      card
        . (myth/new)
          put(['k] (kook [rel abs]))
          put(['p] (pails/p rel))
          put(['ps] (pails/ps [rel abs]))
          put(['h] (hunt .x rel))
          put(['s] (safe n .y rel))
          put(['n] (pd n))
      expected
        . (myth/new)
          put(['k] (kook [dest abs]))
          put(['p] (pails/p dest))
          put(['ps] (pails/ps [dest abs]))
          put(['h] (hunt .x dest))
          put(['s] (safe n .y dest))
          put(['n] (pd n))
    ? !(equal (pact/rebase_rec here card) expected) .false
    ? !(equal (pact/rebase_path here []) []) .false
    | equal (pact/rebase_path here (pact/rel [])) here

  +  refresh
    \ n=nat
    ^ bool
    = target=path ['target]
      original (myth/sing ['link] (safe n .x target))
      cur original.put(crew_slot (cpail (crew/sing ['other] (dep .y ['elsewhere]))))
      scanned (fresh/scan cur)
      deps (fresh/crew_at scanned)
      view (axal/new[myth] (./some (myth/sing ['x_data] (pails/t "8"))))
      views=mop[path axal[myth] lt_pith] (mop/empty)
      b (bowl [] ['app] 0 0 (axal/new[myth] .none)
           views.put(['freshv 'link] view))
      got (fresh/hear b scanned [(dep .x target)])
    ? !(eq deps.tap.len 3) .false
    ? !(equal deps.get(['other]) (maybe/some[dep] (dep .y ['elsewhere]))) .false
    ? !(equal got.out.get(['link]) (maybe/some[pail] (safe 8 .x target))) .false
    ? !(equal (fresh/hear b scanned []).out scanned) .false
    | equal (fresh/scan scanned) scanned

  +  grants
    \ port=nat
    ^ bool
    = asks=row[grant] [(./gserve port) .gfetch]
    ? !(eq (grant/has_fetch asks) 1) .false
    ? !(eq (grant/serve_port asks) port) .false
    ? !(eq (grant/has_fetch []) 0) .false
    | eq (grant/serve_port [.gfetch]) 0

-  testing [order=100]

+  pact_checks
  \ _=unit
  ^ row[testing/check]
  [
  (testing/nat "check 1" 1 (pact_tests/mount 0))
  (testing/nat "check 2" 1 (pact_tests/mount 1))
  (testing/nat "check 3" 1 (pact_tests/invalid 7))
  (testing/nat "check 4" 1 (pact_tests/rebase 7))
  (testing/nat "check 5" 1 (pact_tests/refresh 3))
  (testing/nat "check 6" 1 (pact_tests/grants 8099))
  ]

+  namespace_readers
  \ _=unit
  ^ row[testing/check]
  = old=myth | (myth/sing ['path] (pails/p [])).put(['other] (pd 7))
    dst=myth | myth/sing ['other] (pd 9)
    dep | dep .y ['source]
    crew | crew/sing ['watch] dep
    rec=myth | old.put(crew_slot (cpail crew))
  [
    (testing/nat "root path is present" 1 (equal old.path_at(['path]) (maybe/some[path] [])))
    (testing/nat "missing path" 1 (equal old.path_at(['missing]) maybe/none[path]))
    (testing/nat "foreign path" 1 (equal old.path_at(['other]) maybe/none[path]))
    (testing/nat "crew payload" 1 (equal rec.crew_at(crew_slot).get(['watch]) (maybe/some dep)))
    (testing/nat "missing crew" 0 old.crew_at(crew_slot).size)
    (testing/nat "foreign crew" 0 old.crew_at(['other]).size)
    (testing/nat "copy overwrites" 7 (dst.copy_slot(['other] old)).nat_at(['other] 0))
    (testing/nat "absent copy preserves" 9 (dst.copy_slot(['other] (myth/new))).nat_at(['other] 0))
    (testing/nat "copy path pail" 1 (equal (dst.copy_slot(['path] old)).path_at(['path]) (maybe/some[path] [])))
  ]

+  tests
  ^ row[testing/case]
  [(testing/case "pact behavior" pact_checks)
   (testing/case "namespace readers" namespace_readers)]
