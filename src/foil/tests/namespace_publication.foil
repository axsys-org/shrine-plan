- compiler_publication
- tests/namespace_context [at=ctx]
- testing

+ namespace_publication_checks
  + publish
    \ name=path value=nat state=namespace
    ^ namespace
    = artifact=pin[any] (pin (pails/n value))
      slot=path [state.self 'compiler 'artifact]
      prior state.case(.x name).fall(0)
    ?> (./ok committed) (compiler_publication/local (unpin state.system).definitions slot
        [[name prior (^ pails/n) artifact []]] 0 0 state)
      | Seq[namespace] (error (pails/t "Native publication refused")) state
    committed.state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = prefix=path [($x 17) 'lib 'probe_module]
      definition=path prefix.snoc('value)
      hand=path [($x 17) 'gov 'watch]
      watcher=path [($x 17) 'user 'watch_module]
      context=path [($x 17) 'user 'watch_context]
      cell_path=path [($x 17) 'user 'module_cell]
      cx=path (row/cons[iota] 'c (row/cons[iota] 'x cell_path))
      constructor=path [($x 17) 'lib 'identity]
      overlay (ctx/namespace_context_checks/overlay constructor cx)
      composed=path [($x 17) 'user 'watch_overlay]
      other=path [($x 17) 'user 'watch_other_module]
      first (namespace_publication_checks/publish definition 1 ctx/namespace_context_checks/initial)
      waiter (myth/sing limb_slot (kook [hand]))
      state (ctx/namespace_context_checks/put
        [[hand (writ/make (myth/sing system_vocabulary/form def_form.set_hear(ctx/namespace_context_checks/hear)))]
         [watcher (writ/make waiter.put(crew_slot (cpail (crew/sing ['module] (dep .z prefix)))))]
         [cell_path (writ/make ((myth/sing bond/weft (cell ctx/namespace_context_checks/echo)).put(bond/tack (safe 0 .x definition))))]
         [constructor (writ/make (myth/sing bond/weft (dyed (\ record=myth record) .none)))]
         [composed (writ/make waiter.put(crew_slot (cpail (crew/sing ['overlay] (dep .x overlay)))))]
         [other (writ/make waiter.put(crew_slot (cpail (crew/sing ['other] (dep .z [($x 17) 'lib 'unrelated_module])))))]
         [context (writ/make waiter.put(crew_slot (cpail (crew/sing ['context] (dep .x cx)))))]] first)
      ordinary (ctx/namespace_context_checks/put [[definition (writ/poke (myth/sing ['note] (pails/t "ordinary edit")))]] state)
      published (namespace_publication_checks/publish definition 2 state)
      count ctx/namespace_context_checks/count
    ?> (./ok reconciled) (namespace_command/reconcile state published 0 0)
      [(testing/nat "native publication reconciles without refusal" 1 0)]
    ' Publication settles a committed candidate, including a removed export.
    ' Cull directly through the native commit boundary so ordinary reactions
    ' cannot mask a missing publication notification.
    ?> (./accepted removed) (namespace/step (axal/new[note] .none).put(definition .cull) 0 0 reconciled)
      [(testing/nat "export cull commits" 1 0)]
    ?> (./ok culled) (namespace_command/reconcile reconciled removed.state 0 0)
      [(testing/nat "cull publication reconciles" 1 0)]
    = restored (namespace_publication_checks/publish definition 3 culled)
    ?> (./ok revived) (namespace_command/reconcile culled restored 0 0)
      [(testing/nat "revived export publication reconciles" 1 0)]
    [(testing/nat "publication does not assert module prefix" 0 (maybe/is_some (sovereign_care .x prefix state).fil))
     (testing/nat "transparent module prefix has no z case" 1 (maybe/is_none (state.case(.z prefix))))
     (testing/nat "ordinary descendant edit notifies prefix watcher" 1 (gt (count watcher ordinary) (count watcher state)))
     (testing/nat "publication changes exported definition case" 1 (gt published.case(.x definition).fall(0) state.case(.x definition).fall(0)))
     (testing/nat "publication leaves prefix without an invented clock" 1 (maybe/is_none (reconciled.case(.z prefix))))
     (testing/nat "publication notifies transparent-prefix watcher" 1 (gt (count watcher reconciled) (count watcher state)))
     (testing/nat "publication notifies computed-context watcher" 1 (gt (count context reconciled) (count context state)))
     (testing/nat "publication notifies overlay consuming context" 1 (gt (count composed reconciled) (count composed state)))
     (testing/nat "culled export is absent" 1 (maybe/is_none (sovereign_care .x definition culled).fil))
     (testing/nat "cull notifies transparent-prefix watcher" 1 (gt (count watcher culled) (count watcher reconciled)))
     (testing/nat "cull notifies composed context watcher" 1 (gt (count composed culled) (count composed reconciled)))
     (testing/nat "revived export is present" 1 (maybe/is_some (sovereign_care .x definition revived).fil))
     (testing/nat "revival notifies transparent-prefix watcher" 1 (gt (count watcher revived) (count watcher culled)))
     (testing/nat "revival notifies composed context watcher" 1 (gt (count composed revived) (count composed culled)))
     (testing/nat "cull and revival do not mint a prefix clock" 1
       (and (maybe/is_none (culled.case(.z prefix))) (maybe/is_none (revived.case(.z prefix)))))
     (testing/nat "unrelated prefix watcher stays cool throughout publication" (count other state) (count other revived))
     (testing/nat "cull and revival preserve original export history on every axis" 1
       (row/all[care] (\ axis=care (equal (namespace/page axis state.case(axis definition) definition state)
         (namespace/page axis state.case(axis definition) definition revived))) [.x .y .z]))
     (testing/nat "publication preserves prior exported definition history" 1
       (equal (namespace/page .x state.case(.x definition) definition state)
         (namespace/page .x state.case(.x definition) definition reconciled)))]
+ tests
  ^ row[testing/case]
  [(testing/case "Native publication dependency reconciliation" namespace_publication_checks/checks)]
