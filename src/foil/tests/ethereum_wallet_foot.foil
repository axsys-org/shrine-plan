- ethereum_wallet_world
- testing
+ checks
  \ ignored=unit
  ^ row[testing/check]
  = state (ethereum_wallet_world/boot "0x1111111111111111111111111111111111111111")
  [(testing/nat "namespace wallet starts empty" 0 (ethereum_wallet_app/state state).intents.len)]
+ tests
  ^ row[testing/case]
  [(testing/case "wallet world boot" checks)]
