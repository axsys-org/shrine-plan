- web
- http_foot
- testing

+ tests
  ^ row[testing/case]
  [(testing/case "Debugger HTTP boundary"
    (\ ignored=unit
     ^ row[testing/check]
     = request (http_foot/plan (http_foot/request "GET" "/debug/weft" "") 0)
       route=bool
         ? request
          > (./debug query) (equal[path] query.pax ['weft])
         .false
       views=mop[path axal[myth] lt_pith] (mop/empty)
       views views.put(['view] (axal/new[myth] .none).put(['kook] myth/new))
       bowl (bowl [] ['io 'http 'test] 0 0 (axal/new[myth] .none) views)
       zoo_response (zoo/talk bowl (myth/sing ['vpath] (pails/p ['weft])) myth/new).out
       unavailable (debugger/talk bowl (myth/sing ['vpath] (pails/p ['weft])) myth/new).out
       unavailable_log (http_foot/journal_response (./ok
         (helm/journal_page 0 .none 1 0 .none (axal/new[saga] .none) ['log])))
     [(testing/nat "missing Grove page fails explicitly" 503 unavailable.nat_at(['res_status] 0))
      (testing/nat "missing Grove page never falls back to legacy shell" 0
        (cord/has "sh-triptych" unavailable.nat_at(['res_body] 0)))
      (testing/nat "missing Grove journal page fails explicitly" 503 unavailable_log.status)
      (testing/nat "explicit inspection route preserves path" 1 route)
      (testing/nat "zoo internal child does not hide empty state" 1
        (cord/has "No components registered." zoo_response.nat_at(['res_body] 0)))]))]
