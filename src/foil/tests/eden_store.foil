- eden_store
- eden
- testing
- tests/namespace [at=fixture]

+ eden_store_tests
  + read
    \ card=helm/card state=nat index=hive
    ^ [nat hive feet/task[unit]]
    [state index (feet/task/ack .none)]
  + write
    \ card=helm/card state=nat index=hive
    ^ [nat hive feet/task[unit]]
    [state.inc index (feet/task/ack .none)]
  + fail
    \ state=nat
    ^ nat
    | Throw state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = base (helm/supervisor/access[nat]
        (\ car=care version=maybe[nat] target=path state=nat .null)
        eden_store_tests/write (\ state=nat (axal/new[row[dep]] .none)) (\ state=nat state)
        (\ target=path state=nat .true))
      card (helm/card/peek .x .none [])
      written (eden_store/handle[nat] base (\ state=nat 0) card 7 (axal/new[row[dep]] .none))
      [written_state _ _] written
      failed (Try (\ ignored=nat (eden_store/handle[nat] base eden_store_tests/fail card 7 (axal/new[row[dep]] .none))) 0)
      read (Try (\ ignored=nat (eden_store/handle[nat] base.set_handle(eden_store_tests/read) eden_store_tests/fail card 7 (axal/new[row[dep]] .none))) 0)
    [(testing/nat "committed write preserves the complete candidate" 8 written_state)
     (testing/nat "storage failure prevents returning a write acknowledgement" 1 (either/is_err failed))
     (testing/nat "pure reads require no snapshot commit" 1 (either/is_ok read))]
  + reconnect
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      home=path [initial.self 'io 'http]
      responder=path [initial.self 'kook 'application]
      configured (http/cfg_port [initial.self 'kook 'hserve] responder 8130).put(['application_setting] (pails/t "retained"))
      ready
        ? (grove_install/changes
            [[[initial.self 'kook 'hserve] (writ/make (form/card http/serve_form (lore/line "HTTP")))]
             [responder (writ/make (form/card http/respond_form (lore/line "Application")))]
             [home (writ/make configured)]
             [home.snoc('r42) (writ/make (myth/sing ['request] (pails/t "old connection")))]
             [home.snoc('custom) (writ/make (myth/sing ['setting] (pails/t "retained")))]] initial)
         > (./ok next) next
         > (./err _) initial
      restored (eden_store/reconnect 8300 ready)
      record (sovereign_care .x home restored).fil.fall(myth/new)
    [(testing/nat "restart changes the HTTP port" 8300 record.nat_at(['port] 0))
     (testing/nat "restart preserves the application responder" 1 (equal (record.path_at(['serve])) (maybe/some[path] responder)))
     (testing/nat "restart preserves application configuration" 1 (equal (record.txt_at(['application_setting])) "retained"))
     (testing/nat "restart retires abandoned HTTP requests" 0 (maybe/is_some (sovereign_care .x home.snoc('r42) restored).fil))
     (testing/nat "restart keeps other HTTP children" 1 (maybe/is_some (sovereign_care .x home.snoc('custom) restored).fil))]

+ tests
  ^ row[testing/case]
  [(testing/case "native world commit boundary" eden_store_tests/checks)
   (testing/case "native service reconnect" eden_store_tests/reconnect)]
