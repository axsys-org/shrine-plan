-  lint
-  rex
-  testing

+  lint_checks
  +  lines
    \ parts=row[str]
    ^ str
    | str/join (str/from_atom 10) parts

  +  tree
    \ text=str
    ^ rex
    | either/ok_val[any rex] (rex/parse text)

  +  rules_of
    \ rep=lint/report
    ^ row[str]
    | row/uniq[str] rep.errors.weld(rep.warnings).map((\ d d.rule))

  +  fired
    '  Rule ids the default configuration reports for a snippet.
    \ parts=row[str]
    ^ row[str]
    | lint_checks/rules_of (lint/check (lint_checks/tree (lint_checks/lines parts)))

  +  fired_all
    '  The same with every rule on, the TODO-gated ones included.
    \ parts=row[str]
    ^ row[str]
    | lint_checks/rules_of (lint/check_all (lint_checks/tree (lint_checks/lines parts)))

  +  fires
    \ rule=str parts=row[str]
    ^ bool
    | row/has[str] rule (lint_checks/fired parts)

  +  fires_all
    \ rule=str parts=row[str]
    ^ bool
    | row/has[str] rule (lint_checks/fired_all parts)

  +  count
    '  How many findings of one rule a snippet gets.
    \ rule=str parts=row[str]
    ^ nat
    = rep | lint/check (lint_checks/tree (lint_checks/lines parts))
      all rep.errors.weld(rep.warnings)
    all.keep((\ d (eq d.rule rule))).len

  +  first_line
    '  The line of the first reported finding, 0 when clean.
    \ parts=row[str]
    ^ nat
    = rep | lint/check (lint_checks/tree (lint_checks/lines parts))
      all rep.errors.weld(rep.warnings)
    ? (eq all.len 0) 0
    all.at(0).span.line

  +  guide
    '  The style guide's opening example, with its doctest slug
    '  shortened below the suspect width and its quotes dropped.
    ^ row[str]
    ["+  is_txt"
     "  '  Whether v is printable ASCII."
     "  '  ?=  ((tyshow/is_txt 3) 0)"
     "  \ v=nat"
     "  ^ bool"
     "  ? | eq v 0"
     "   .false"
     "  % rest=nat v"
     "  ? | eq rest 0"
     "   .true"
     "  = byte | mod rest 256"
     "  ? | lt byte 32"
     "   .false"
     "  ? | lt 126 byte"
     "   .false"
     "  | _ | div rest 256"]

  +  wide_line
    '  A code line padded to the given width.
    \ width=nat
    ^ str
    | "  ^ ".cat((str/repeat (sub width 4) "a"))

  +  widths
    \ ignored=unit
    ^ row[testing/check]
    = long=row[str]  ["+  x" (lint_checks/wide_line 74)]
      sus=row[str]   ["+  x" (lint_checks/wide_line 59)]
      fine=row[str]  ["+  x" (lint_checks/wide_line 54)]
      slug=row[str]  ["+  x" "  '  ".cat((str/repeat 70 "a"))]
      many=row[str]  ["+  x" "  | f ".cat((str/repeat 14 "(g x) "))]
      later=row[str] ["+  x" "  ^ nat" (lint_checks/wide_line 80) "  1"]
    [(testing/nat "74 columns is an error" 1 (lint_checks/fires "line-too-long" long))
     (testing/nat "74 columns is not also suspect" 0 (lint_checks/fires "line-suspect" long))
     (testing/nat "59 columns is suspect" 1 (lint_checks/fires "line-suspect" sus))
     (testing/nat "59 columns is not an error" 0 (lint_checks/fires "line-too-long" sus))
     (testing/nat "54 columns is fine" 0 (lint_checks/fires "line-suspect" fine))
     (testing/nat "a wide slug line counts" 1 (lint_checks/fires "line-too-long" slug))
     (testing/nat "one finding per line" 1 (lint_checks/count "line-too-long" many))
     (testing/nat "findings are located" 3 (lint_checks/first_line later))]

  +  decls
    \ ignored=unit
    ^ row[testing/check]
    = one=row[str]    ["+ x" "  1"]
      two=row[str]    ["+  x" "  1"]
      deep=row[str]   ["+  x" "   ^ nat" "   1"]
      nested=row[str] ["+  x" "  +  y" "    ^ nat" "    1"]
    [(testing/nat "one space after + fires" 1 (lint_checks/fires "decl-head-gap" one))
     (testing/nat "two spaces after + is right" 0 (lint_checks/fires "decl-head-gap" two))
     (testing/nat "body at +3 fires" 1 (lint_checks/fires "decl-children" deep))
     (testing/nat "body at +2 is right" 0 (lint_checks/fires "decl-children" two))
     (testing/nat "nested + keeps +2" 0 (lint_checks/fires "decl-children" nested))
     (testing/nat "the guide example is clean" 0 (lint_checks/fired lint_checks/guide).len)]

  +  runes
    \ ignored=unit
    ^ row[testing/check]
    = gap=row[str]     ["+  x" "  ^  nat" "  1"]
      tight=row[str]   ["+  x" "  ^ nat" "  1"]
      import2=row[str] ["-  sept" "+  x" "  1"]
      import3=row[str] ["-   sept" "+  x" "  1"]
      gutter2=row[str] ["+  x" "  \ v=nat" "  ? v" "    1" "  0"]
      gutter1=row[str] ["+  x" "  \ v=nat" "  ? v" "   1" "  0"]
      params=row[str]  ["+  x" "  \ a=nat" "    b=nat" "  (add a b)"]
      guard=row[str]   ["+  x" "  \ m=maybe[nat]" "  ?> (./some v) m" "    0" "  v"]
      top=row[str]     ["+  x" "  1" "(add 1 2)"]
    [(testing/nat "two spaces after ^ fires" 1 (lint_checks/fires "rune-gap" gap))
     (testing/nat "one space after ^ is right" 0 (lint_checks/fires "rune-gap" tight))
     (testing/nat "an import may take two spaces" 0 (lint_checks/fires "rune-gap" import2))
     (testing/nat "an import may not take three" 1 (lint_checks/fires "rune-gap" import3))
     (testing/nat "a branch at +2 fires" 1 (lint_checks/fires "gutter" gutter2))
     (testing/nat "a branch at +1 is right" 0 (lint_checks/fires "gutter" gutter1))
     (testing/nat "params continue under the first" 0 (lint_checks/fires "gutter" params))
     (testing/nat "a ?> else sits past the rune" 0 (lint_checks/fires "gutter" guard))
     (testing/nat "no gutter outside declarations" 0 (lint_checks/fires "gutter" top))]

  +  lets
    \ ignored=unit
    ^ row[testing/check]
    = two=row[str]     ["+  x" "  =  bar 3" "  bar"]
      one=row[str]     ["+  x" "  = bar 3" "  bar"]
      queen=row[str]   ["+  x" "  =   bar" "    | add 1 2" "  bar"]
      queen3=row[str]  ["+  x" "  =   bar" "     | add 1 2" "  bar"]
      queen2=row[str]  ["+  x" "  =  bar" "    | add 1 2" "  bar"]
      spill=row[str]   ["+  x" "  =   bar" "    | add 1 2" "    3" "  bar"]
      multi=row[str]   ["+  x" "  = a | add 1" "         2" "  a"]
      ragged=row[str]  ["+  x" "  = ab 1" "    c 2" "  (add ab c)"]
      padded=row[str]  ["+  x" "  = ab 1" "    c  2" "  (add ab c)"]
      shifted=row[str] ["+  x" "  = ab 1" "     c 2" "  (add ab c)"]
      mixed=row[str]   ["+  x" "  = a 1" "    b" "      (add 1" "       2)" "  b"]
    [(testing/nat "two spaces after = fires" 1 (lint_checks/fires "let-gap" two))
     (testing/nat "one space is kingside" 0 (lint_checks/fires "let-gap" one))
     (testing/nat "three spaces is queenside" 0 (lint_checks/fires "let-gap" queen))
     (testing/nat "queenside at +4 and +2 is right" 0 (lint_checks/fires "let-queenside" queen))
     (testing/nat "a queenside value at +3 fires" 1 (lint_checks/fires "let-queenside" queen3))
     (testing/nat "a queenside name at +3 fires" 1 (lint_checks/fires "let-queenside" queen2))
     (testing/nat "a spilled queenside value fires" 1 (lint_checks/fires "let-queenside" spill))
     (testing/nat "a multi-line kingside value fires" 1 (lint_checks/fires "let-kingside-multiline" multi))
     (testing/nat "a one-line kingside value is fine" 0 (lint_checks/fires "let-kingside-multiline" one))
     (testing/nat "ragged values fire" 1 (lint_checks/fires "let-kingside-align" ragged))
     (testing/nat "padded values are aligned" 0 (lint_checks/fires "let-kingside-align" padded))
     (testing/nat "a shifted name fires" 1 (lint_checks/fires "let-kingside-align" shifted))
     (testing/nat "a spilled value in a kingside group fires" 1 (lint_checks/fires "let-kingside-multiline" mixed))
     (testing/nat "a spilled value is not also misaligned" 0 (lint_checks/fires "let-kingside-align" mixed))]

  +  calls
    \ ignored=unit
    ^ row[testing/check]
    = wide=row[str]    ["+  x" "  (| add 1 2)"]
      lambda=row[str]  ["+  x" "  | f (\ y y)"]
      paren=row[str]   ["+  x" "  (add 1 2)"]
      tall=row[str]    ["+  x" "  | add 1 2"]
      operand=row[str] ["+  x" "  ? (eq 1 1) 1" "  0"]
      split=row[str]   ["+  x" "  = a (add 1" "         2)" "  a"]
      simple=row[str]  ["+  x" "  | foo" "   | bar baz"]
      dotted=row[str]  ["+  x" "  . | unpin p" "   meld(m)"]
      flat=row[str]    ["+  x" "  | foo (bar baz) qux"]
      big=row[str]     ["+  x" "  | foo" ("   ".cat((str/repeat 60 "a")))]
      lambda2=row[str] ["+  x" "  \ a=row[nat]" "  | a.uno" "   \ k2 old new old" "  0"]
    [(testing/nat "wide form is reported" 1 (lint_checks/fires "wide-form" wide))
     (testing/nat "wide form is an error" 1 (lint_checks/error_count wide))
     (testing/nat "an inline lambda is not wide form" 0 (lint_checks/fires "wide-form" lambda))
     (testing/nat "a paren call statement fires" 1 (lint_checks/fires "prefer-tall" paren))
     (testing/nat "a tall call is right" 0 (lint_checks/fires "prefer-tall" tall))
     (testing/nat "a paren call operand is allowed" 0 (lint_checks/fires "prefer-tall" operand))
     (testing/nat "a paren call over two lines fires" 1 (lint_checks/fires "prefer-tall" split))
     (testing/nat "too simple for its height" 1 (lint_checks/fires "too-simple" simple))
     (testing/nat "a dotted poem too simple" 1 (lint_checks/fires "too-simple" dotted))
     (testing/nat "a flat call is not too simple" 0 (lint_checks/fires "too-simple" flat))
     (testing/nat "a wide vertical call is not too simple" 0 (lint_checks/fires "too-simple" big))
     (testing/nat "a lambda operand line is not too simple" 0 (lint_checks/fires "too-simple" lambda2))]

  +  error_count
    \ parts=row[str]
    ^ nat
    (lint/check (lint_checks/tree (lint_checks/lines parts))).errors.len

  +  names
    \ ignored=unit
    ^ row[testing/check]
    = camel=row[str]   ["+  x" "  \ SendCaps=nat" "  1"]
      pascal=row[str]  ["+  Foo" "  1"]
      call=row[str]    ["+  x" "  \ v=nat" "  | Try v"]
      pattern=row[str] ["+  x" "  = ;[root caps] (Recv 0)" "  root"]
      number=row[str]  ["+  x" "  ? 1" "   > (./some 42) 1" "  0"]
      longer=row[str]  ["+  x" "  \ counter=nat" "  counter"]
      lapid=row[str]   ["+  x" "  \ cnt=nat" "  cnt"]
      nested=row[str]  ["+  x" "  \ j=nat out=row[nat]" "  | _ j.inc out.snoc((f a (g b c)))"]
      lifted=row[str]  ["+  x" "  \ j=nat out=row[nat]" "  = nex | f a (g b c)" "  | _ j.inc out.snoc(nex)"]
    [(testing/nat "a camelCase parameter fires" 1 (lint_checks/fires "snake-case" camel))
     (testing/nat "a PascalCase declaration fires" 1 (lint_checks/fires "snake-case" pascal))
     (testing/nat "a PascalCase call is not a binding" 0 (lint_checks/fires "snake-case" call))
     (testing/nat "bracket patterns bind names" 0 (lint_checks/fires "snake-case" pattern))
     (testing/nat "a number in a pattern is not a name" 0 (lint_checks/fires "snake-case" number))
     (testing/nat "lapidary is off by default" 0 (lint_checks/fires "lapidary" longer))
     (testing/nat "lapidary fires when asked" 1 (lint_checks/fires_all "lapidary" longer))
     (testing/nat "a short name satisfies lapidary" 0 (lint_checks/fires_all "lapidary" lapid))
     (testing/nat "ufcs-lift is off by default" 0 (lint_checks/fires "ufcs-lift" nested))
     (testing/nat "a nested method argument fires" 1 (lint_checks/fires_all "ufcs-lift" nested))
     (testing/nat "a lifted argument is fine" 0 (lint_checks/fires_all "ufcs-lift" lifted))]

  +  api
    \ ignored=unit
    ^ row[testing/check]
    = parsed | lint/check_text (lint_checks/lines lint_checks/guide)
      broken | lint/check_text ")"
      base   lint/default_rules
      every  lint/all_rules
    [(testing/nat "check_text parses" 1 (either/is_ok parsed))
     (testing/nat "check_text reports a bad parse" 1 (either/is_err broken))
     (testing/text "wide-form is an error" "error" (lint/level_of "wide-form"))
     (testing/text "gutter is a warning" "warning" (lint/level_of "gutter"))
     (testing/nat "the default rules are on" 17 base.len)
     (testing/nat "two rules wait on the guide" 19 every.len)]

  +  decl_of
    '  A declaration with n one-line statements after its parameter.
    \ n=nat
    ^ str
    = nl=str (str/from_atom 10)
      head   | lint_checks/lines ["+  x" "  \ a=nat"]
      stmt   | str/cat_all [nl "  = b a"]
      body   | str/repeat n stmt
    | str/cat_all [head body nl "  a"]

  +  nest_of
    '  A declaration with n tall calls nested one column deeper each.
    \ n=nat
    ^ str
    % i=nat 0 out=row[str] ["+  x"]
    ? (eq i n) (lint_checks/lines out.snoc("  1"))
    = pad  | str/repeat (add 2 i) " "
      line | str/cat_all [pad "| f"]
    | _ i.inc out.snoc(line)

  +  fires_text
    \ rule=str text=str
    ^ nat
    = rep | lint/check (lint_checks/tree text)
      all rep.errors.weld(rep.warnings)
    all.keep((\ d (eq d.rule rule))).len

  +  size
    \ ignored=unit
    ^ row[testing/check]
    = short=row[str]  ["+  x" "  +  y" "    1" "  +  z" "    1"]
    [(testing/nat "45 statements is too long" 1 (lint_checks/fires_text "decl-too-long" (lint_checks/decl_of 45)))
     (testing/nat "20 statements is fine" 0 (lint_checks/fires_text "decl-too-long" (lint_checks/decl_of 20)))
     (testing/nat "a namespace of declarations is not measured" 0 (lint_checks/fires "decl-too-long" short))
     (testing/nat "eight levels is too deep" 1 (lint_checks/fires_text "deep-nesting" (lint_checks/nest_of 8)))
     (testing/nat "seven levels is fine" 0 (lint_checks/fires_text "deep-nesting" (lint_checks/nest_of 7)))
     (testing/nat "one finding per deep branch" 1 (lint_checks/fires_text "deep-nesting" (lint_checks/nest_of 12)))]

  +  deprecated
    \ ignored=unit
    ^ row[testing/check]
    = guard=row[str]  ["+  x" "  \ m=maybe[nat]" "  ?> (./some v) m" "    0" "  v"]
      either=row[str] ["+  x" "  \ a=bool b=bool" "  (a || b)"]
      bang=row[str]   ["+  x" "  \ a=bool" "  !(a)"]
      bare=row[str]   ["+  x" "  \ a=bool" "  !a"]
      match=row[str]  ["+  x" "  \ m=maybe[nat]" "  ? m" "   > (./some v) v" "  0"]
      negpat=row[str] ["+  x" "  \ m=maybe[nat]" "  !?=(.none m)"]
    [(testing/nat "?> is deprecated" 1 (lint_checks/fires "deprecated-rune" guard))
     (testing/nat "|| is deprecated" 1 (lint_checks/fires "deprecated-rune" either))
     (testing/nat "!(x) is deprecated" 1 (lint_checks/fires "deprecated-rune" bang))
     (testing/nat "!x is deprecated" 1 (lint_checks/fires "deprecated-rune" bare))
     (testing/nat "a ? match is fine" 0 (lint_checks/fires "deprecated-rune" match))
     (testing/nat "!?= is a different rune" 0 (lint_checks/fires "deprecated-rune" negpat))]

+  tests
  ^ row[testing/case]
  [(testing/case "widths" lint_checks/widths)
   (testing/case "decls" lint_checks/decls)
   (testing/case "runes" lint_checks/runes)
   (testing/case "lets" lint_checks/lets)
   (testing/case "calls" lint_checks/calls)
   (testing/case "names" lint_checks/names)
   (testing/case "api" lint_checks/api)
   (testing/case "deprecated" lint_checks/deprecated)
   (testing/case "size" lint_checks/size)]
