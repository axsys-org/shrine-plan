- lain_peek
- testing

+ reference_tests
  + count
    \ answer=res[axal[myth]]
    ^ nat
    ?> (./known tree) answer 999
    ?> (./some record) tree.fil 999
    | record.nat_at ['count] 999
  + put
    \ path=path record=myth state=sov
    ^ sov
    ?> (./accepted result) (sov/step ((axal/new[note] .none).put(path (note/make record))) 0 0 state) state
    = [next signs] result
    next
  + cull
    \ path=path state=sov
    ^ sov
    ?> (./accepted result) (sov/step ((axal/new[note] .none).put(path .cull)) 0 0 state) state
    = [next signs] result
    next
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = a=path [($x 1) 'a]
      b=path [($x 1) 'b]
      holder=path [($x 1) 'holder]
      original (myth/sing ['related] (safe 0 .x a))
      first (reference_tests/put holder original sov/new)
      literal (reference_tests/put holder original.put(['description] (pails/t "changed")) first)
      second (reference_tests/put holder (myth/sing ['related] (safe 3 .z b)) literal)
      removed (reference_tests/cull holder second)
      past (reference_index/beneath a first.top removed.references)
      current (reference_index/beneath b 0 second.references)
      rebuilt (sov/reindex_references removed.set_references(reference_index/new))
      prose (reference_tests/put holder (myth/sing ['note] (pails/t "see [/0x1/a]")) sov/new)
    [(testing/nat "a reference enters the index under its target" 1 (reference_index/beneath a 0 first.references).len)
     (testing/nat "a prefix finds the references beneath it" 1 (reference_index/beneath [($x 1)] 0 first.references).len)
     (testing/nat "a literal change leaves the index as it was" 1 (equal first.references literal.references))
     (testing/nat "retargeting ends the old edge" 0 (reference_index/beneath a 0 second.references).len)
     (testing/nat "retargeting opens the new edge" 1 current.len)
     (testing/nat "the target keeps its case" 3 current.at(0).target.ver)
     (testing/nat "a cull ends the edge" 0 (reference_index/beneath b 0 removed.references).len)
     (testing/nat "the edges at an epoch survive later changes" 1 past.len)
     (testing/nat "an ended edge keeps its holder" 1 (equal past.at(0).holder holder))
     (testing/nat "an ended edge keeps when it appeared and ended" 1 (and (eq past.at(0).since first.top) (eq past.at(0).until second.top)))
     (testing/nat "text that mentions a path is not an edge" 0 (reference_index/beneath a 0 prose.references).len)
     (testing/nat "a listing's case is the epoch its edges last moved" second.top ((reference_index/case a second.references).fall(0)))
     (testing/nat "a prefix's case moves with the edges beneath it" removed.top ((reference_index/case [($x 1)] removed.references).fall(0)))
     (testing/nat "a literal change does not move a listing's case" first.top ((reference_index/case a literal.references).fall(0)))
     (testing/nat "rebuilding from the journal gives the same index" 1 (equal removed.references rebuilt.references))
     (testing/nat "rebuilding keeps the journal" 1 (equal removed.rec rebuilt.rec))
     (testing/nat "rebuilding keeps every record history" 1 (equal removed.idx rebuilt.idx))
     (testing/nat "rebuilding keeps every case ledger" 1 (equal removed.cases rebuilt.cases))
     (testing/nat "the reverse view is an ordinary named read" 1
       (reference_tests/count (view .x 0 ['r ($u 2) ($x 1) 'a] first)))
     (testing/nat "the reverse view is empty after a retarget" 0
       (reference_tests/count (view .x 0 ['r ($u 2) ($x 1) 'a] second)))
     (testing/nat "the reverse view at an epoch is that epoch's edges" 1
       (reference_tests/count (view .x first.top ['r ($u 2) ($x 1) 'a] removed)))
     (testing/nat "the reverse view refuses an epoch not yet committed" 1
       (?=(.unknown (view .x removed.top.inc ['r ($u 2) ($x 1) 'a] removed))))
     (testing/nat "each edge has its own address" 1
       (?=((./known _) (view .x 0 ['r ($u 2) ($x 1) 'a ($u 1) 'related ($x 1) 'holder] first))))]

+ mount_tests
  + put
    \ path=path record=myth state=sov
    ^ sov
    | reference_tests/put path record state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = self=iota ($x 1)
      mount=path [($x 1) 'her ($x 2) 'widgets]
      published=path [($x 2) 'our ($x 1) 'widgets]
      public_mount=path [($x 1) 'her ($x 2) 'public 'list]
      listing=path [($x 2) 'our 'public 'list]
      private=path [($x 2) 'our ($x 3) 'quote]
      need=path [($x 1) 'needs 'w]
      cited (mount_tests/put need (myth/sing ['source] (safe 0 .x mount)) sov/new)
      material=path [($x 3) 'our ($x 2) 'plate]
      carried (mount_tests/put mount (myth/sing ['made_of] (safe 0 .x material)) sov/new)
      held (reference_index/beneath material 0 carried.references)
      at_mount=maybe[path] (./some mount)
      at_public=maybe[path] (./some public_mount)
    [(testing/nat "a pairwise mount is the publisher's /our name for this world" 1 (equal (reference_index/canonical self mount) published))
     (testing/nat "a public mount is the publisher's /our/public name" 1 (equal (reference_index/canonical self public_mount) listing))
     (testing/nat "a name published to this world resolves to its mount" 1 (equal (reference_index/mounted self published) at_mount))
     (testing/nat "a public name resolves to its mount" 1 (equal (reference_index/mounted self listing) at_public))
     (testing/nat "a name published to another world does not resolve here" 1 (?=(.none (reference_index/mounted self private))))
     (testing/nat "a world's own name is never a mount" 1 (?=(.none (reference_index/mounted self need))))
     (testing/nat "a reference written through the mount names the publisher's name" 1 (reference_index/beneath published 0 cited.references).len)
     (testing/nat "the mount spelling is not a second key" 0 (reference_index/beneath mount 0 cited.references).len)
     (testing/nat "a mounted record's references are held in its publisher's name" 1 (equal held.at(0).holder published))
     (testing/nat "a reference a publisher makes to a third world is indexed, not followed" 1 held.len)]

+ tests
  ^ row[testing/case]
  [(testing/case "the reverse index" reference_tests/checks)
   (testing/case "names through mounts" mount_tests/checks)]
