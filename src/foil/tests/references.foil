- lain_peek
- testing

+ reference_tests
  + count
    \ answer=res[row[reference_edge]]
    ^ nat
    ?> (./known edges) answer 999
    edges.len
  + put
    \ path=path record=myth state=sov
    ^ sov
    ?> (./accepted result) (sov/step ((axal/new[note] .none).put(path (note/make record))) 0 0 state) state
    = [next signs] result
    next
  + many
    \ holder=path target=path count=nat state=sov
    ^ sov
    % i=nat 0 current=sov state
    ^ sov
    ? (eq i count) current
    | _ i.inc (reference_tests/put holder (myth/sing ['related] (safe i.inc .x target)) current)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = a=path [($x 1) 'a]
      b=path [($x 1) 'b]
      holder=path [($x 1) 'holder]
      original (myth/sing ['related] (safe 0 .x a))
      first (reference_tests/put holder original sov/new)
      literal (reference_tests/put holder original.put(['description] (pails/t "changed")) first)
      second (reference_tests/put holder (myth/sing ['related] (safe 3 .z b)) literal)
      removed
        ?> (./accepted result) (sov/step ((axal/new[note] .none).put(holder .cull)) 0 0 second) second
        = [next signs] result
        next
      raw_path=path [($x 1) 'r ($u 2) ($x 1) 'a]
      physical (reference_tests/put raw_path (myth/sing ['count] (pails/n 42)) first)
      raw_value=nat
        ?> (./known tree) (view .x 0 raw_path physical) 0
        ?> (./some record) tree.fil 0
        | record.nat_at ['count] 0
      aged (reference_tests/many holder a 70 removed)
      past (reference_index/beneath a first.top removed.references)
      current (reference_index/beneath b 0 second.references)
      rebuilt (sov/reindex_references removed.set_references(reference_index/new))
    [(testing/nat "reference enters target index" 1 (reference_index/beneath a 0 first.references).len)
     (testing/nat "prefix lookup finds descendant targets" 1 (reference_index/beneath [($x 1)] 0 first.references).len)
     (testing/nat "literal change preserves reference index" 1 (equal first.references literal.references))
     (testing/nat "retarget removes the old edge" 0 (reference_index/beneath a 0 second.references).len)
     (testing/nat "retarget inserts the new edge" 1 current.len)
     (testing/nat "target revision is retained" 3 current.at(0).target.ver)
     (testing/nat "cull removes edges" 0 (reference_index/beneath b 0 removed.references).len)
     (testing/nat "history survives retarget and cull" 1 past.len)
     (testing/nat "historical edge retains its holder" 1 (equal past.at(0).holder holder))
     (testing/nat "reindex preserves the original journal" 1 (equal removed.rec rebuilt.rec))
     (testing/nat "reindex preserves complete record history" 1 (equal removed.idx rebuilt.idx))
     (testing/nat "reindex preserves every case ledger" 1 (equal removed.cases rebuilt.cases))
     (testing/nat "reindex restores historical references" 1 (reference_index/beneath a first.top rebuilt.references).len)
     (testing/nat "reindex restores historical retargeting" 1 (reference_index/beneath b second.top rebuilt.references).len)
     (testing/nat "reindex retains the later cull" 0 (reference_index/beneath b 0 rebuilt.references).len)
     (testing/nat "explicit incoming query reads current edges" 1
       (reference_tests/count (reference_index/lookup a 0 first.top first.references)))
     (testing/nat "explicit incoming query preserves known empty" 0
       (reference_tests/count (reference_index/lookup a 0 second.top second.references)))
     (testing/nat "explicit incoming query retains selected epoch" 1
       (reference_tests/count (reference_index/lookup a first.top removed.top removed.references)))
     (testing/nat "current at a frozen boundary cannot read future edges" 1
       (reference_tests/count (reference_index/lookup a 0 first.top removed.references)))
     (testing/nat "genesis lookup cannot borrow the latest edges" 0
       (reference_tests/count (reference_index/lookup a 0 0 first.references)))
     (testing/nat "expired frozen current remains unknown" 1
       (?=(.unknown (reference_index/lookup a 0 first.top aged.references))))
     (testing/nat "future incoming snapshots stay unknown" 1
       (?=(.unknown (reference_index/lookup a removed.top.inc removed.top removed.references))))
     (testing/nat "prose is not a declared reference" 0
       (reference_index/slots (./some (myth/sing ['note] (pails/t "Citation [/0x01/a]")))).len)
     (testing/nat "expired incoming snapshots stay unknown" 1
       (?=(.unknown (reference_index/lookup a first.top aged.top aged.references))))
     (testing/nat "index retention does not cull the world history" 1
       (?=((./known _) (aged.x_at(first.top holder)))))
     (testing/nat "known empty before the first edge remains known" 0
       (reference_tests/count (reference_index/lookup a 1 1 reference_index/new)))
     (testing/nat "an authority-owned r child remains an ordinary record" 42 raw_value)
     (testing/nat "reverse lens enumerates typed incoming references" 1
       (peek (r_spell a) first).fil.fall(myth/new).nat_at(['count] 999))]

+ tests
  ^ row[testing/case]
  [(testing/case "incremental reference index" reference_tests/checks)]
