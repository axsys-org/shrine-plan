- namespace
- stdlib/base
- tests/cells [at=fixture]

+  namespace_dedup
  +  identity
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    [context tree]

  +  fault
    \ target=path state=sov
    ^ str
    > (./known pair) (cell_run 0 target (store_reader state)) "unknown"
    = [context tree] pair
    > (./some held) context.get(['sys 'view 'fault]) ""
    > text=pails/t held ""
    text.t

  +  wefts
    \ ignored=unit
    ^ row[testing/check]
    = put fixture/cell_tests/put
    = bad (myth/sing bond/weft (pails/n 7))
    = state (put ['direct] bad sov/new)
    = state (put ['definition] bad state)
    = ref (safe 1 .x ['definition])
    = indirect (myth/sing bond/weft ref)
    = state (put ['indirect] indirect state)
    = state (put ['data] myth/new state)
    = tack (safe 0 .x ['data])
    = state (put ['applied] indirect.put(bond/tack tack) state)
    = named (myth/sing bond/weft (pails/q 'no_ctor))
    = state (put ['named] named state)
    = state (put ['chain] (myth/sing bond/weft ref) state)
    = reader (store_reader state)
    = once=either[str pail] (./ok ref)
    | row/cons[testing/check]
     | testing/text "direct invalid weft wins over missing tack"
      "weft: not a reference, a ctor, or a ctor's name"
      | namespace_dedup/fault ['direct] state
    | row/cons[testing/check]
     | testing/text "resolved invalid ctor waits for tack validation"
      "tack: this cell has no /sys/tack"
      | namespace_dedup/fault ['indirect] state
    | row/cons[testing/check]
     | testing/text "resolved invalid ctor keeps its distinct fault"
      "weft: the definition is not a cell ctor"
      | namespace_dedup/fault ['applied] state
    | row/cons[testing/check]
     | testing/text "unknown standard ctor also waits for tack"
      "tack: this cell has no /sys/tack"
      | namespace_dedup/fault ['named] state
    | row/cons[testing/check]
     | testing/nat "weft references dereference exactly once" 1
      | equal once (resolve_weft (safe 1 .x ['chain]) reader)
    []

  +  overlay
    \ definition=path input=path
    ^ path
    = prefix=path ['o ($u 1) ($u definition.len)]
    | prefix.weld(definition).snoc(($u input.len)).weld(input)

  +  overlay_cases
    \ ignored=unit
    ^ row[testing/check]
    = put fixture/cell_tests/put
    = ctor (cell namespace_dedup/identity)
    = formula (myth/sing bond/weft ctor)
    = state (put ['data] myth/new sov/new)
    = live formula.put(bond/tack (safe 0 .x ['data]))
    = state (put ['derived] live state)
    = dye (dyed (\ record=myth record) .none)
    = felt (felt (\ tree=axal[myth] tree.fil.fall(myth/new)) .none)
    = state (put ['dye] (myth/sing bond/weft dye) state)
    = state (put ['felt] (myth/sing bond/weft felt) state)
    = state (put ['cell] formula state)
    = target=path ['x 'derived]
    =   read
      (\ fn=path (o_case (namespace_dedup/overlay fn target) state))
    = none=maybe[nat] .none
    = one=maybe[nat] (./some 1)
    | row/cons[testing/check]
     | testing/nat "dyed overlay keeps stored case for virtual input" 1
      | equal none (read ['dye])
    | row/cons[testing/check]
     | testing/nat "felt overlay keeps stored case for virtual input" 1
      | equal none (read ['felt])
    | row/cons[testing/check]
     | testing/nat "cell overlay follows derived input case" 1
      | equal one (read ['cell])
    | row/cons[testing/check]
     | testing/nat "context path remains outside reserved write paths" 1
      | maybe/is_none (reserved_virtual_err ['c 'x 'derived])
    | row/cons[testing/check]
     | testing/nat "context path remains a virtual read" 1
      | is_virtual ['c 'x 'derived]
    []

  +  demand
    \ source=safe
    ^ view_plan
    | ./need (view_read source .all)
     \ value=res[axal[myth]]
     ^ view_plan
     > (./known tree) value (./fail "missing")
     | ./done tree

  +  budgets
    \ ignored=unit
    ^ row[testing/check]
    = state (fixture/cell_tests/put ['data] myth/new sov/new)
    = reader (store_reader state)
    = source (safe 0 .x ['data])
    = need (namespace_dedup/demand source)
    = graft=view_plan (./graft source)
    = n1 (woven_run need reader.set_fuel(1))
    = g1 (woven_run graft reader.set_fuel(1))
    | row/cons[testing/check]
     | testing/nat "need overflow drops the new observation" 0
      n1.observations.len
    | row/cons[testing/check]
     | testing/nat "graft overflow drops the new observation" 0
      g1.observations.len
    | row/cons[testing/check]
     | testing/nat "need overflow charges remaining fuel" 1
      n1.steps
    | row/cons[testing/check]
     | testing/nat "graft overflow charges remaining fuel" 1
      g1.steps
    | row/cons[testing/check]
     | testing/text "need overflow retains exact reason"
      "computation read budget exhausted"
      n1.fault
    | row/cons[testing/check]
     | testing/text "graft overflow retains exact reason"
      "computation read budget exhausted"
      g1.fault
    []

  +  exact_budget
    \ ignored=unit
    ^ row[testing/check]
    = state (fixture/cell_tests/put ['data] myth/new sov/new)
    = reader (store_reader state)
    = source (safe 0 .x ['data])
    = need (namespace_dedup/demand source)
    = graft=view_plan (./graft source)
    = n2 (woven_run need reader.set_fuel(2))
    = g2 (woven_run graft reader.set_fuel(2))
    = n3 (woven_run need reader.set_fuel(3))
    | row/cons[testing/check]
     | testing/nat "exact-budget need retains its observation" 1
      n2.observations.len
    | row/cons[testing/check]
     | testing/nat "exact-budget need cannot advance" 1
      ?=(.unknown n2.value)
    | row/cons[testing/check]
     | testing/nat "graft completes at exact budget" 1
      ?=((./known _) g2.value)
    | row/cons[testing/check]
     | testing/nat "graft charges both read and interpreter step" 2
      g2.steps
    | row/cons[testing/check]
     | testing/nat "need completes with room for its continuation" 1
      ?=((./known _) n3.value)
    | row/cons[testing/check]
     | testing/nat "continuation does not charge an extra read" 2
      n3.steps
    []

+  tests
  ^ row[testing/case]
  [
   (testing/case "weft fault ordering" namespace_dedup/wefts)
   (testing/case "overlay cases" namespace_dedup/overlay_cases)
   (testing/case "woven read overflow" namespace_dedup/budgets)
   (testing/case "woven exact budget" namespace_dedup/exact_budget)]
