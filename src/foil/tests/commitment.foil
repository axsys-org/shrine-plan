- development
- testing

+ commitment_checks
  + promise
    \ expected=nat
    ^ commitment/retained[nat]
    = check
        \ actual=nat
        ^ commitment/verdict
        ? (eq actual expected) .holding
        | ./failed "Demonstrated outcome changed."
    | commitment/retained[nat] ['example] ['availability] "Keep my demonstrated result" "user demonstration" 1 check
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = live (development/installed[nat] ['availability] 1 10 [])
      candidate (development/candidate[nat] ['availability] 1 7 15 "Use 15 minutes" [(commitment_checks/promise 15)])
      installed (development/publish[nat] 7 .true live candidate)
      approved (either/ok_val installed)
      regression (development/candidate[nat] ['availability] 2 8 10 "Later change" [])
      unknown (commitment/retained[nat] ['unknown] ['availability] "Preserve output contract" "declared constraint" 1
        (\ ignored=nat (commitment/verdict/unknown "No evidence for this input")))
      broken (commitment/retained[nat] ['broken] ['availability] "Checker failure" "declared boundary" 1
        (\ ignored=nat (Seq[commitment/verdict] (error (pails/t "checker failed")) (commitment/verdict/holding))))
    [(testing/nat "an established retained case permits its demonstrated value" 1
       (commitment/admissible .true (commitment/assess[nat] [(commitment_checks/promise 15)] 15)))
     (testing/nat "publication retains endorsed demonstration" 1 approved.commitments.len)
     (testing/nat "later regression blocked without repeating the instruction" 1
       (either/is_err (development/publish[nat] 8 .true approved regression)))
     (testing/nat "candidate cannot remove the baseline checker" 1
       (development/assess[nat] approved regression).len)
     (testing/nat "stale basis cannot publish" 1
       (either/is_err (development/publish[nat] 7 .true approved candidate)))
     (testing/nat "approval of another revision rejected" 1
       (either/is_err (development/publish[nat] 6 .true live candidate)))
     (testing/nat "limited coverage cannot establish compatibility" 1
       (either/is_err (development/publish[nat] 7 .false live candidate)))
     (testing/nat "unknown commitment blocks" 0
       (commitment/admissible .true (commitment/assess[nat] [unknown] 15)))
     (testing/nat "thrown checker becomes unknown" 0
       (commitment/admissible .true (commitment/assess[nat] [broken] 15)))
     (testing/nat "duplicate commitment identity rejected" 0
       (commitment/unique[nat] [(commitment_checks/promise 15) (commitment_checks/promise 10)]))
     (testing/nat "wrong subject rejected" 1
       (either/is_err (development/publish[nat] 7 .true live candidate.set_subject(['other]))))]

+ tests
  ^ row[testing/case]
  [(testing/case "Retained human commitments" commitment_checks/checks)]
