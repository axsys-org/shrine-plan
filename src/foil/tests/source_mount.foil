- source_mount
- tests/namespace [at=fixture]
- testing

+ source_mount_tests
  + home
    ^ path
    [($x 1) 'io 'fs 'example]
  + put
    \ home=path record=myth state=namespace
    ^ namespace
    = old (source_mount/record home state)
    = request (helm/card/step home (writ/make old.meld(record)))
    = [next index reply]
        (helm/supervisor/handle request state (sovereign_hive state))
    next
  + state
    \ epoch=nat bytes=nat missing=row[str] state=namespace
    ^ namespace
    = home source_mount_tests/home
    = target home.snoc('source)
    = state
        | source_mount_tests/put home
          (myth/sing bond/res
            (fs/report epoch target ["main.foil"] missing)) state
    | source_mount_tests/put target.snoc(($ta "main.foil"))
      (myth/sing bond/content (pails/n bytes)) state
  + publish
    \ home=path state=namespace
    ^ either[pail namespace]
    = files (source_mount/snapshot home state)
    ? (eq files.len 0)
      | ./err (pails/t "Missing module")
    = [name bytes] files.at(0)
    ? (eq bytes 0)
      | ./err (pails/t "Compilation failed")
    | ./ok
      | source_mount_tests/put [state.self 'compiled]
        (myth/sing bond/content (pails/n bytes)) state
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = ports (source_mount/ports source_mount_tests/publish)
    = home source_mount_tests/home
    = initial fixture/namespace_tests/initial
    = first (source_mount_tests/state 1 99 [] initial)
    = first (source_mount/reconcile_one ports home first)
    = duplicate (source_mount/reconcile_one ports home first)
    = unreadable
        | source_mount_tests/put home
          (myth/sing bond/res (fs/failure 2 (myth/new) "Scan denied")) first
    = unreadable (source_mount/reconcile_one ports home unreadable)
    = recovered (source_mount_tests/state 3 99 [] unreadable)
    = recovered (source_mount/reconcile_one ports home recovered)
    = failed (source_mount_tests/state 2 0 [] first)
    = failed (source_mount/reconcile_one ports home failed)
    = missing (source_mount_tests/state 3 99 ["main.foil"] failed)
    = missing (source_mount/reconcile_one ports home missing)
    = fixed (source_mount_tests/state 4 100 [] missing)
    = fixed (source_mount/reconcile_one ports home fixed)
    = same (source_mount_tests/state 5 100 [] fixed)
    = same (source_mount/reconcile_one ports home same)
    = stale (source_mount_tests/state 4 101 [] same)
    = rejected (source_mount/reconcile_one ports home stale)
    = output (source_mount/record [initial.self 'compiled] failed)
    = rescan (source_mount/rescan myth/new
        (myth/sing bond/epoch (pails/n 10)))
    [(testing/nat "rescan advances request epoch" 11
        rescan.nat_at(bond/epoch 0))
     (testing/nat "rescan keeps current control data" 1
        (maybe/is_some rescan.get(bond/pending)))
     (testing/nat "initial publication" 1
        (source_mount/status_at home first).ready)
     (testing/nat "duplicate completion is no-op" 1
        (equal first duplicate))
     (testing/text "scan errors are visible" "Scan denied"
        (source_mount/status_at home unreadable).message)
     (testing/nat "scan error retains publication" 1
        (eq (source_mount/status_at home first).publication
          (source_mount/status_at home unreadable).publication))
     (testing/nat "unchanged recovery is ready" 1
        (source_mount/status_at home recovered).ready)
     (testing/nat "unchanged recovery reuses last publication" 1
        (eq (source_mount/status_at home first).publication
          (source_mount/status_at home recovered).publication))
     (testing/nat "failure retains working output" 99
        output.nat_at(bond/content 0))
     (testing/nat "failure is visible" 0
        (source_mount/status_at home failed).ready)
     (testing/nat "missing inputs are excluded" 0
        (source_mount/snapshot home missing).len)
     (testing/nat "corrected input publishes" 1
        (source_mount/status_at home fixed).ready)
     (testing/nat "unchanged inputs preserve publication" 1
        (eq (source_mount/status_at home same).publication
          (source_mount/status_at home fixed).publication))
     (testing/nat "obsolete completion does not publish" 1
        (equal stale rejected))]

+ tests
  ^ row[testing/case]
  [(testing/case "source publication" source_mount_tests/checks)]
