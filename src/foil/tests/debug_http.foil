- eden_debug

' Socket harness composition only. Compile and publish the production Grove
' declarations, never an alternate renderer. Synthetic indexes keep their
' exact journal/epoch fixtures; their read-only foot receives the separately
' published registry without modifying that index.
+ debug_http
  + initial
    \ port=nat
    ^ sov
    ? (eden/boot port)
     > (./ready state) state
     > (./failed stage reason)
       ; (error (eden/failed stage reason))
       sov/new
  + main
    \ port=nat mode=str initial=sov slots=str types=str debugger=str
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ nat
    ?> (./ok batches) (eden_debug/compile slots types debugger .none compiler)
      | error (pails/t "Socket fixture Grove compilation failed")
    = synthetic ((eq mode "journal") || (eq mode "physical-large"))
      base (? synthetic (debug_http/initial port) initial)
    ?> (./ok published) (eden_debug/publish batches base)
      | error (pails/t "Socket fixture Grove publication failed")
    > (./known registry) published.y_latest(['weft 'debug 'v1])
      | error (pails/t "Socket fixture has no published debugger registry")
    > (./some page) registry.dip(['page]).fil
      | error (pails/t "Socket fixture has no published debugger page")
    = state (? synthetic initial published)
    | eden/serve_with state (http_foot/run_with (./some registry))
