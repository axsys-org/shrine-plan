- temporal
- testing

+ temporal_checks
  \ ignored=unit
  ^ row[testing/check]
  [(testing/text "calendar timestamp" "2026-09-30 12:00:00 UTC"
     (temporal/timestamp '@2026.9.30..12.0.0))
   (testing/text "high precision timestamp" "1969-07-21 02:56:15 UTC"
     (temporal/timestamp '@@1969.7.21..2.56.15))
   (testing/text "binary millisecond fraction" "1970-01-01 00:00:00.0009765625 UTC"
     (temporal/timestamp ($dm (add (quip_val '@1970.1.1..0.0.0) 1))))
   (testing/text "high precision fraction is not rounded away" ".00000000000000088817841970012523233890533447265625"
     (temporal/fraction 1 50))
   (testing/text "duration" "2d 3h 4m 5s 250ms" (temporal/duration (quip_val '@d2.h3.m4.s5.ms250)))
   (testing/text "zero duration" "0ms" (temporal/duration 0))]

+ tests
  ^ row[testing/case]
  [(testing/case "temporal formatting" temporal_checks)]
