- tests/cells [at=fixture]
- testing

+ composition_tests
  + append
    \ root=path tail=path
    ^ path
    | root.weld tail
  + overlay
    \ definition=path input=path
    ^ path
    = prefix=path ['o ($u 1) ($u definition.len)]
    | prefix.weld(definition).snoc(($u input.len)).weld(input)
  + identity
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    [context tree]
  + stamp
    ' The same native cell must receive the same input stamp via /x and /o.
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing ['value]
        (pails/n context.nat_at(['sys 'tack 'case] 0)))))]
  + pinned
    \ epoch=nat target=path
    ^ path
    = version=iota ($ts (str/cat_all ["e" epoch.show]))
      prefix=path ['h 'z version ($u target.len)]
    | prefix.weld target
  + total
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = primary tree.fil.fall(myth/new).nat_at(['value] 0)
      secondary
        ?> (./some other) (weft_std/view context 'extra) 0
        | other.fil.fall(myth/new).nat_at ['value] 0
    | [context (axal/new[myth] (./some (myth/sing ['value] (pails/n (add primary secondary)))))]
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      input=path [($x 1) 'input]
      subject=path input.weld(['orgs 'acme])
      definition=path [($x 1) 'definitions 'identity]
      standard=path [($x 1) 'definitions 'count]
      ' The cell stands beside its input, not beneath it: a live input that
      ' contains the cell is a cycle.
      datum=path [($x 1) 'view]
      virtual=path datum.cons(xs)
      seed (fixture/cell_tests/put input (myth/sing ['title] (pails/t "World")) sov/new)
      seed (fixture/cell_tests/put subject (myth/sing ['value] (pails/n 7)) seed)
      seed (fixture/cell_tests/put (composition_tests/append subject ['people 'ann]) (myth/sing ['value] (pails/n 8)) seed)
      seed (fixture/cell_tests/put definition (myth/sing bond/weft (cell composition_tests/identity)) seed)
      seed (fixture/cell_tests/put standard (myth/sing bond/weft (pails/q 'count)) seed)
      seed (fixture/cell_tests/put datum
        (myth/sing bond/weft (safe 1 .x definition)).put(bond/tack (safe 0 .z input)) seed)
      first (composition_tests/overlay definition virtual)
      second (composition_tests/overlay definition first)
      third (composition_tests/overlay standard (composition_tests/append second ['orgs 'acme 'people]))
      child=path virtual.weld(['orgs 'acme])
      chain=path [($x 1) 'next]
      seed (fixture/cell_tests/put chain
        (myth/sing bond/weft (safe 1 .x standard)).put(bond/tack (safe 0 .z (composition_tests/append child ['people]))) seed)
      extra=path [($x 1) 'extra]
      both=path [($x 1) 'both]
      seed (fixture/cell_tests/put extra (myth/sing ['value] (pails/n 10)) seed)
      seed (fixture/cell_tests/put both
        (myth/sing bond/weft (cell composition_tests/total)).put(bond/tack (safe 0 .x subject)).put(['extra] (safe 0 .x extra)) seed)
      pinned_child (composition_tests/pinned seed.top child)
      pinned_both (composition_tests/pinned seed.top both.cons(xs))
      changed (fixture/cell_tests/put subject (myth/sing ['value] (pails/n 9)) seed)
      changed (fixture/cell_tests/put extra (myth/sing ['value] (pails/n 20)) changed)
      frozen=path [($x 1) 'frozen]
      changed (fixture/cell_tests/put frozen
        (myth/sing bond/weft (safe 1 .x definition)).put(bond/tack (safe 1 .x subject)) changed)
      loop=path [($x 1) 'loop]
      looping (fixture/cell_tests/put loop
        (myth/sing bond/weft (safe 1 .x definition)).put(bond/tack
          (safe 0 .z (composition_tests/overlay definition loop.cons(xs)))) changed)
      stamp_definition=path [($x 1) 'definitions 'stamp]
      stamped=path [($x 1) 'stamped]
      stamped_state (fixture/cell_tests/put stamp_definition
        (myth/sing bond/weft (cell composition_tests/stamp)) changed)
      stamped_state (fixture/cell_tests/put stamped
        (myth/sing bond/weft (safe 1 .x stamp_definition)).put(bond/tack (safe 0 .z subject)) stamped_state)
      stamp_overlay (composition_tests/overlay stamp_definition subject)
      nested_stamp_overlay (composition_tests/overlay stamp_definition
        (composition_tests/overlay definition subject))
      captured_stamp=path [($x 1) 'captured_stamp]
      stamped_state (fixture/cell_tests/put captured_stamp
        (myth/sing bond/weft (safe 1 .x stamp_definition)).put(bond/tack (safe 1 .z subject)) stamped_state)
      stamped_snapshot (composition_tests/pinned stamped_state.top stamp_overlay)
      stamp_changed (fixture/cell_tests/put subject
        (myth/sing ['value] (pails/n 20)) stamped_state)
      future_source=path [($x 1) 'future_source]
      future_cell=path [($x 1) 'future_cell]
      before_future (fixture/cell_tests/put future_source
        (myth/sing ['value] (pails/n 1)) seed)
      before_future (fixture/cell_tests/put future_cell
        (myth/sing bond/weft (safe 1 .x definition)).put(bond/tack (safe 2 .x future_source)) before_future)
      future_snapshot (composition_tests/pinned before_future.top future_cell.cons(xs))
      after_future (fixture/cell_tests/put future_source
        (myth/sing ['value] (pails/n 2)) before_future)
      retained_both=path [($x 1) 'retained_both]
      retained_state (fixture/cell_tests/put retained_both
        (myth/sing bond/weft (cell composition_tests/total)).put(bond/tack (safe 1 .x subject)).put(['extra] (safe 1 .x extra)) changed)
      culled_state (fixture/cell_tests/cull subject retained_state)
      culled_state (fixture/cell_tests/cull extra culled_state)
      revived_state (fixture/cell_tests/put subject (myth/sing ['value] (pails/n 90)) culled_state)
      revived_state (fixture/cell_tests/put extra (myth/sing ['value] (pails/n 100)) revived_state)
      triggers (xv_trigger child seed)
      overlay_triggers (o_trigger second seed)
      count
        \ name=path state=sov
        ^ nat
        | fixture/cell_tests/nat_at ['count] (view .x 0 name state)
      value
        \ name=path state=sov
        ^ nat
        | fixture/cell_tests/nat_at ['value] (view .x 0 name state)
    [(testing/nat "virtual child is independently addressable" 7 (value child seed))
     (testing/nat "virtual grandchild is independently addressable" 8 (value (composition_tests/append child ['people 'ann]) seed))
     (testing/nat "virtual child follows its source" 9 (value child changed))
     (testing/nat "a cell consumes another cell's virtual subtree" 1 (count chain.cons(xs) seed))
     (testing/nat "a cell formula applies as an overlay" 7 (value (composition_tests/append first ['orgs 'acme]) seed))
     (testing/nat "overlay of overlay retains child addresses" 8 (value (composition_tests/append second ['orgs 'acme 'people 'ann]) seed))
     (testing/nat "stdlib formula consumes a composed subtree" 1 (count third seed))
     (testing/nat "pinned cell input remains stable" 7 (value frozen.cons(xs) changed))
     (testing/nat "epoch pin freezes a live computed child" 7 (value pinned_child changed))
     (testing/nat "live cell reads both current inputs" 29 (value both.cons(xs) changed))
     (testing/nat "epoch pin freezes primary and secondary dependencies" 17 (value pinned_both changed))
     (testing/nat "virtual child does not invent a local case" 1 (?=(.none (xv_case child seed))))
     (testing/nat "virtual child tracks the stored input" 1 (triggers.any((\ d (equal[path] d.p input)))))
     (testing/nat "nested overlay tracks the cell's stored input" 1 (overlay_triggers.any((\ d (equal[path] d.p input)))))
     (testing/nat "evaluation cycle through an overlay is rejected" 1
       (fixture/cell_tests/probe (view .z 0 loop.cons(xs) looping)))
     (testing/nat "cell and overlay application receive the same input case" 1
       (equal (value stamped.cons(xs) stamped_state) (value stamp_overlay stamped_state)))
     (testing/nat "overlay application receives a nonzero input case" 1
       (gt (value stamp_overlay stamped_state) 0))
     (testing/nat "ordinary cell overlay has a case" 1
       (maybe/is_some (o_case stamp_overlay stamped_state)))
     (testing/nat "nested overlay stamps the same underlying input case" 1
       (equal (value stamp_overlay stamped_state) (value nested_stamp_overlay stamped_state)))
     (testing/nat "pinned input stamps its selected case rather than the latest source case" 1
       (value captured_stamp.cons(xs) stamped_state))
     (testing/nat "historical overlay stamp stays at its captured input case" 1
       (equal (value stamp_overlay stamped_state) (value stamped_snapshot stamp_changed)))
     (testing/nat "case-pinned live computation remains unavailable" 1
       (fixture/cell_tests/probe (view .x 1 virtual changed)))
     (testing/nat "case-pinned secondary live input remains unavailable" 1
       (fixture/cell_tests/probe (view .x 1 both.cons(xs) changed)))
     (testing/nat "reference to a future source case starts unavailable" 1
       (fixture/cell_tests/probe (view .x 0 future_cell.cons(xs) before_future)))
     (testing/nat "live computation can resolve the explicitly requested source case once it exists" 2
       (value future_cell.cons(xs) after_future))
     (testing/nat "old epoch cannot see a source case minted in the future" 1
       (fixture/cell_tests/probe (view .x 0 future_snapshot after_future)))
     (testing/nat "pinned primary and secondary inputs survive live source cull" 17
       (value retained_both.cons(xs) culled_state))
     (testing/nat "pinned primary and secondary inputs survive restoration" 17
       (value retained_both.cons(xs) revived_state))
     (testing/nat "a live primary input is unavailable after cull" 1
       (fixture/cell_tests/probe (view .x 0 both.cons(xs) culled_state)))
     (testing/nat "live primary and secondary resume with restored values" 190
       (value both.cons(xs) revived_state))
     (testing/nat "missing virtual child is unknown" 1
       (fixture/cell_tests/probe (view .x 0 (composition_tests/append child ['missing]) seed)))]

  + shadow_history
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      input=path [($x 1) 'shadow_input]
      parent=path [($x 1) 'shadow_parent]
      child=path parent.snoc('child)
      replacement=path [($x 1) 'replacement]
      seed (fixture/cell_tests/put input myth/new sov/new)
      seed (fixture/cell_tests/put input.snoc('child) (myth/sing ['value] (pails/n 7)) seed)
      source_case seed.z_case(input).fall(0)
      seed (fixture/cell_tests/put parent
        (myth/sing bond/weft (cell composition_tests/identity)).put(bond/tack (safe source_case .z input)) seed)
      virtual=path child.cons(xs)
      epoch (composition_tests/pinned seed.top virtual)
      target=path parent.cons(xs)
      explicit_root=path ['h 'z ($u 1) ($u target.len)]
      explicit_root (row/snoc[iota] 'child (explicit_root.weld(target)))
      changed (fixture/cell_tests/put replacement (myth/sing ['value] (pails/n 99)) seed)
      changed (fixture/cell_tests/put child
        (myth/sing bond/weft (cell composition_tests/identity)).put(bond/tack (safe 1 .x replacement)) changed)
      value
        \ target=path version=nat state=sov
        ^ nat
        | fixture/cell_tests/nat_at ['value] (view .x version target state)
    [(testing/nat "live virtual child initially comes from its ancestor" 7 (value virtual 0 seed))
     (testing/nat "virtual child owns no case before an exact definition exists" 1
       (?=(.none (xv_case virtual seed))))
     (testing/nat "numeric case does not borrow an ancestor's unrelated local counter" 1
       (fixture/cell_tests/probe (view .x 1 virtual seed)))
     (testing/nat "live child resolves the newly explicit definition" 99 (value virtual 0 changed))
     (testing/nat "new exact definition has its own stable first case" 99 (value virtual 1 changed))
     (testing/nat "epoch-captured virtual child keeps its original defining root" 7 (value epoch 0 changed))
     (testing/nat "explicit ancestor case plus projection keeps its original child" 7 (value explicit_root 0 changed))]

  + overlay_cycles
    \ ignored=unit
    ^ row[testing/check]
    = xs=iota 'x
      source=path [($x 1) 'cycle_source]
      scope=path [($x 1) 'cycle_scope]
      child=path scope.snoc('child)
      left=path [($x 1) 'definitions 'left]
      right=path [($x 1) 'definitions 'right]
      dyed_at=path [($x 1) 'definitions 'dyed]
      knit_at=path [($x 1) 'definitions 'knit]
      felt_at=path [($x 1) 'definitions 'felt]
      sewn_at=path [($x 1) 'definitions 'sewn]
      pinned_at=path [($x 1) 'definitions 'pinned_secondary]
      left_view (composition_tests/overlay left source)
      right_view (composition_tests/overlay right source)
      identity
        \ record=myth
        ^ myth
        record
      expand
        \ record=myth
        ^ axal[myth]
        | axal/new[myth] (./some record)
      collapse
        \ tree=axal[myth]
        ^ myth
        | tree.fil.fall myth/new
      tree_identity
        \ tree=axal[myth]
        ^ axal[myth]
        tree
      seed (fixture/cell_tests/put source (myth/sing ['value] (pails/n 10)) sov/new)
      seed (fixture/cell_tests/put scope (myth/sing ['value] (pails/n 4)) seed)
      seed (fixture/cell_tests/put left
        (myth/sing bond/weft (cell composition_tests/identity)).put(['extra] (safe 0 .z right_view)) seed)
      seed (fixture/cell_tests/put right
        (myth/sing bond/weft (cell composition_tests/identity)).put(['extra] (safe 0 .z left_view)) seed)
      seed (fixture/cell_tests/put dyed_at (myth/sing bond/weft (dyed identity .none)) seed)
      seed (fixture/cell_tests/put knit_at (myth/sing bond/weft (knit expand .none)) seed)
      seed (fixture/cell_tests/put felt_at (myth/sing bond/weft (felt collapse .none)) seed)
      seed (fixture/cell_tests/put sewn_at (myth/sing bond/weft (sewn tree_identity .none)) seed)
      dyed_view (composition_tests/overlay dyed_at scope)
      knit_view (composition_tests/overlay knit_at scope)
      felt_view (composition_tests/overlay felt_at scope)
      sewn_view (composition_tests/overlay sewn_at scope)
      with_input
        \ input=path
        ^ sov
        | fixture/cell_tests/put child
          (myth/sing bond/weft (cell composition_tests/identity)).put(bond/tack (safe 0 .z input)) seed
      dyed_state (with_input dyed_view)
      knit_state (with_input knit_view)
      felt_state (with_input felt_view)
      sewn_state (with_input sewn_view)
      seed (fixture/cell_tests/put pinned_at
        (myth/sing bond/weft (cell composition_tests/total)).put(['extra] (safe 1 .x scope)) seed)
      pinned_view (composition_tests/overlay pinned_at source)
      changed (fixture/cell_tests/put scope (myth/sing ['value] (pails/n 99)) seed)
      culled (fixture/cell_tests/cull scope changed)
      value
        \ target=path state=sov
        ^ nat
        | fixture/cell_tests/nat_at ['value] (view .x 0 target state)
      reader (store_reader seed)
      triggers (o_trigger left_view seed)
    [(testing/nat "secondary overlay cycle is detected before evaluation" 1
       (tack_cycle left_view .z right_view reader))
     (testing/nat "mutually secondary-referencing overlays are unavailable" 1
       (fixture/cell_tests/probe (view .z 0 left_view seed)))
     (testing/nat "cyclic overlay trigger discovery terminates with its concrete source" 1
       (equal triggers [(dep .z source)]))
     (testing/nat "dyed overlay reads an ancestor record without its descendant cell" 4
       (value child.cons(xs) dyed_state))
     (testing/nat "knit overlay reads an ancestor record without its descendant cell" 4
       (value child.cons(xs) knit_state))
     (testing/nat "dyed overlay watches exact-record care" 1
       (equal (o_trigger dyed_view seed) [(dep .x scope)]))
     (testing/nat "knit overlay watches exact-record care" 1
       (equal (o_trigger knit_view seed) [(dep .x scope)]))
     (testing/nat "felt overlay subtree input containing the cell is rejected" 1
       (fixture/cell_tests/probe (view .z 0 child.cons(xs) felt_state)))
     (testing/nat "sewn overlay subtree input containing the cell is rejected" 1
       (fixture/cell_tests/probe (view .z 0 child.cons(xs) sewn_state)))
     (testing/nat "pinned overlay secondary input is not a live cycle edge" 0
       (tack_cycle scope .z pinned_view reader))
     (testing/nat "pinned overlay secondary survives evidence changes" 14
       (value pinned_view changed))
     (testing/nat "pinned overlay secondary survives evidence cull" 14
       (value pinned_view culled))
     (testing/nat "pinned overlay secondary contributes no live trigger" 1
       (equal (o_trigger pinned_view changed) [(dep .z source)]))]

+ tests
  ^ row[testing/case]
  [(testing/case "composable cell namespaces" composition_tests/checks)
   (testing/case "virtual child captures retain their defining scope" composition_tests/shadow_history)
   (testing/case "overlay cycle checks follow constructor input boundaries" composition_tests/overlay_cycles)]
