- paramutuel_rules
- testing

+ paramutuel_rules_tests
  + result
    \ name=str want=nat got=either[ethereum_word/fault nat]
    ^ testing/check
    | testing/nat name 1 (equal got (either/ok[ethereum_word/fault nat] want))
  + policy_weights
    \ ignored=unit
    ^ row[testing/check]
    [(testing/nat "single winner matches" 1 (paramutuel_rules/weight .single_winner 0 2 2))
     (testing/nat "single winner loses" 0 (paramutuel_rules/weight .single_winner 0 1 2))
     (testing/nat "single winner rejects multi-bit truth" 0 (paramutuel_rules/weight .single_winner 0 1 3))
     (testing/nat "any overlap pays one unit" 1 (paramutuel_rules/weight .any_of 0 7 3))
     (testing/nat "disjoint ticket loses" 0 (paramutuel_rules/weight .any_of 0 4 3))
     (testing/nat "exact set matches" 1 (paramutuel_rules/weight .exact_set 0 3 3))
     (testing/nat "exact set is not subset" 0 (paramutuel_rules/weight .exact_set 0 1 3))
     (testing/nat "threshold met" 1 (paramutuel_rules/weight .at_least_k 2 7 3))
     (testing/nat "threshold missed" 0 (paramutuel_rules/weight .at_least_k 2 3 5))
     (testing/nat "weighted overlap counts truth bits" 2 (paramutuel_rules/weight .weighted_overlap 0 7 3))
     (testing/nat "high mask bit is preserved" 1 (paramutuel_rules/weight .weighted_overlap 0 (bex 254) (bex 254)))
     (testing/nat "zero overlap has zero weight" 0 (paramutuel_rules/weight .at_least_k 0 1 2))]
  + accounting
    \ ignored=unit
    ^ row[testing/check]
    [(paramutuel_rules_tests/result "fee total floors" 3 (paramutuel_rules/fees 101 333))
     (paramutuel_rules_tests/result "net pot subtracts fee" 98 (paramutuel_rules/net_pot 101 333))
     (paramutuel_rules_tests/result "retraction refunds net of fees" 9 (paramutuel_rules/refund 10 101 333))
     (paramutuel_rules_tests/result "full fees leave zero refund" 0 (paramutuel_rules/refund 10 10 10000))
     (paramutuel_rules_tests/result "floor each distinct ticket before sum" 2 (paramutuel_rules/payout_lines [[1 1] [1 1]] 5 3))
     (paramutuel_rules_tests/result "same-mask deposits aggregate before flooring" 3 (paramutuel_rules/payout_lines [[2 1]] 5 3))
     (paramutuel_rules_tests/result "weighted claim preserves line rounding" 22 (paramutuel_rules/payout_lines [[4 2] [2 1]] 23 10))
     (paramutuel_rules_tests/result "losing ticket adds no payout" 0 (paramutuel_rules/payout_lines [[4 0]] 23 10))
     (testing/nat "fee above full pot is rejected" 1 (equal (paramutuel_rules/fees 100 10001) (either/err[ethereum_word/fault nat] .range)))
     (testing/nat "refund stake above gross is rejected" 1 (equal (paramutuel_rules/refund 101 100 0) (either/err[ethereum_word/fault nat] .range)))
     (testing/nat "zero denominator is rejected" 1 (equal (paramutuel_rules/payout_lines [[1 1]] 1 0) (either/err[ethereum_word/fault nat] .zero_divisor)))
     (testing/nat "fee intermediate overflow is preserved" 1 (equal (paramutuel_rules/fees (dec (bex 256)) 2) (either/err[ethereum_word/fault nat] .overflow)))
     (testing/nat "payout intermediate overflow is preserved" 1 (equal (paramutuel_rules/payout_lines [[(dec (bex 256)) 1]] 2 2) (either/err[ethereum_word/fault nat] .overflow)))
     (testing/nat "ticket weight multiplication can overflow" 1 (equal (paramutuel_rules/payout_lines [[(dec (bex 256)) 2]] 1 2) (either/err[ethereum_word/fault nat] .overflow)))
     (testing/nat "sum of individually valid payouts can overflow" 1 (equal (paramutuel_rules/payout_lines [[(dec (bex 256)) 1] [1 1]] 1 1) (either/err[ethereum_word/fault nat] .overflow)))
     (testing/nat "payout net must fit a word" 1 (equal (paramutuel_rules/payout_lines [[1 1]] (bex 256) 1) (either/err[ethereum_word/fault nat] .range)))]

+ tests
  ^ row[testing/case]
  [(testing/case "Paramutuel policy weights" paramutuel_rules_tests/policy_weights)
   (testing/case "Paramutuel integer accounting" paramutuel_rules_tests/accounting)]
