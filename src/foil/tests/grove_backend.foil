- lain_peek
- publisher_vocabulary
- grove_backend
+ grove_backend_checks
  + lookup
    \ records=row[[path myth]] key=path
    ^ maybe[myth]
    % rest=row[[path myth]] records
    ^ maybe[myth]
    ? (eq rest.len 0) .none
    = [path card] rest.at(0)
    ? (equal path key) (./some card)
    | _ rest.drop(1)
  + lookup_namespace
    \ state=namespace records=row[[path myth]] key=path
    ^ maybe[myth]
    ? (grove_backend_checks/lookup records key)
     > (./some card) (./some card)
    | (sovereign_peek key state).fil
  + module
    \ card=myth
    ^ grove_backend/bundle
    > (./some value) card.get(grove_backend/module_slot)
      | grove_backend/bundle 0 [] [] (mop/empty) 0
    > bundle=grove_backend/bundle value
      | grove_backend/bundle 0 [] [] (mop/empty) 0
    bundle
  + export
    \ key=path card=myth
    ^ any
    = bundle (grove_backend_checks/module card)
    > (./some entry) bundle.exports.get(key)
      | error (pails/t "Missing export")
    entry.value
  + size
    \ card=myth
    ^ nat
    = bundle (grove_backend_checks/module card)
    | mop/size[path grove_backend/entry lt_pith] bundle.exports
  + version
    \ version=nat card=myth
    ^ myth
    = bundle (grove_backend_checks/module card)
      replacement
        | grove_backend/bundle version bundle.identity bundle.prefix
          bundle.exports bundle.artifact
    | card.put grove_backend/module_slot replacement
  + title
    \ card=myth
    ^ str
    | card.txt_at [($x 17) 'vocabulary 'title]
  + count
    \ card=myth
    ^ nat
    | card.nat_at [($x 17) 'vocabulary 'count] 0
  + without_artifact
    \ card=myth
    ^ myth
    = bundle (grove_backend_checks/module card)
      replacement
        | grove_backend/bundle bundle.version bundle.identity
          bundle.prefix bundle.exports 0
    | card.put grove_backend/module_slot replacement
  + first_five
    \ doc=grove/document
    ^ grove/document
    | grove_backend_checks/first 5 doc
  + first
    \ limit=nat doc=grove/document
    ^ grove/document
    % rest=row[grove/item] doc.items out=row[grove/item] [] n=nat 0
    ^ grove/document
    ? ((eq n limit) || (eq rest.len 0)) (grove/document out)
    = item rest.at(0)
      next=nat
        ? item
         > (grove/declaration span name body) n.inc
        n
    | _ rest.drop(1) out.snoc(item) next
  + recall_data
    \ due=nat interval=nat
    ^ myth
    = card=myth (mop/empty)
    = card card.put([($x 17) 'gov 'srs 'due] (pails/n due))
    | card.put [($x 17) 'gov 'srs 'interval] (pails/n interval)
  + req_data
    \ card=myth
    ^ myth
    | card.put ['sys 'req] (pails/t "Review this")
  + role_data
    \ mode=nat card=myth
    ^ myth
    ? (eq mode 1) card.put(['sys 'req] (pails/t "Question"))
    ? (eq mode 2) card.put(['sys 'about] (pails/p ['topic]))
    ? (eq mode 3) card.put(['sys 'req] (pails/n 1))
    ? (eq mode 4) card.put(['sys 'about] (pails/n 1))
    ? (eq mode 5) card.put(['sys 'res] (pails/n 1))
    ? (eq mode 6) card.put(['sys 'res] (pails/t "Answer"))
    ? (eq mode 7) card.put(['unrelated] (pails/t "Keep me"))
    | card.del [($x 17) 'gov 'srs 'interval]
  + role_summary
    \ card=myth
    ^ row[nat]
    > (./some held) card.get(publisher_vocabulary/grove/role)
      []
    > shape=grove_role_schema held
      []
    [shape.fields.len shape.need.len shape.need.at(2).len]

  + action_args
    \ grade=pail now=nat
    ^ myth
    = input=myth (mop/empty)
    = input input.put([($x 17) 'gov 'srs 'grade] grade)
    | input.put ['sys 'now] (pails/n now)
  + invalid_args
    \ mode=nat input=myth
    ^ myth
    ? (eq mode 0) input.del([($x 17) 'gov 'srs 'grade])
    ? (eq mode 1) input.put([($x 17) 'gov 'srs 'grade] (pails/n 0))
    ? (eq mode 2) input.del(['sys 'now])
    | input.put ['sys 'now] (pails/t "bad")
  + action_summary
    \ card=myth
    ^ row[path]
    > (./some held) card.get(publisher_vocabulary/grove/action)
      []
    > schema=grove_action_schema held
      []
    = slots schema.arguments.fields.map((\ field field.slot))
    | slots.cons schema.receiver
  + norm_tree
    \ mode=nat card=myth
    ^ axal[myth]
    = tree (axal/new[myth] .none)
    ? (eq mode 0) tree
    ? (eq mode 1) tree.put(['alpha] card)
    ? (eq mode 2) tree.put([($u 0)] card)
    ? (eq mode 3) tree.put([] card)
    ? (eq mode 4) tree.put(['alpha 'extra] card)
    ? (eq mode 5)
      | tree.put ['alpha] card.put(['sys 'from] (pails/p ['original]))
    ? (eq mode 6)
      | tree.put [($u 0)] card.put(['sys 'from] (pails/p ['original]))
    ? (eq mode 7)
      | tree.put [($u 0)] card.put(['sys 'from] (pails/t "wrong"))
    ? (eq mode 8) tree.put(['cards 'alpha] card)
    ? (eq mode 9)
      = tree tree.put(['cards] (mop/empty))
      | tree.put ['cards 'alpha] card
    ? (eq mode 10)
      = tree tree.put(['cards] card)
      | tree.put ['cards 'alpha] card
    | tree.put ['wrong 'alpha] card
  + norm_summary
    \ card=myth
    ^ row[str]
    > (./some held) card.get(publisher_vocabulary/grove/norm)
      []
    > schema=grove_norm_schema held
      []
    | schema.segments.map
    \ segment
    ? segment.pattern
     > (zeta/var aura) (str/from_atom aura)
     > (zeta/lit value) (path_show [value])
  + norm_spec_at
    \ path=path card=myth
    ^ bool
    = raw (grove_backend_checks/export ['spec] card)
    > spec=soma raw
      .false
    | maybe/is_some (soma/at path spec)
  + queue_input
    \ count=nat
    ^ axal[myth]
    | (row/range 0 count).fold (axal/new[myth] .none)
    \ tree i
    = name=str (str/join "" ["card" (nat/show i)])
      record (grove_backend_checks/recall_data (sub count i) 1)
      card (grove_backend_checks/req_data record)
    | tree.put [($ts name)] card
  + queue_summary
    \ tree=axal[myth]
    ^ row[[nat nat path]]
    | tree.tap.map
    \ [path card]
    > (./some held) card.get(['sys 'from])
      [999 999 []]
    > from=pails/p held
      [998 998 []]
    [ (quip_val path.at(0))
      card.nat_at([($x 17) 'gov 'srs 'due] 0) from.p ]
  + sewn_summary
    \ card=myth
    ^ row[path]
    > (./some held) card.get(publisher_vocabulary/grove/sewn)
      []
    > schema=grove_sewn_schema held
      []
    [schema.source schema.target]
  + queue_ties
    \ scaffold=bool
    ^ axal[myth]
    = card
        | grove_backend_checks/req_data
          (grove_backend_checks/recall_data 100 1)
      base
        ? scaffold (axal/new[myth] (./some (mop/empty)))
        | axal/new[myth] .none
    | base.put(['c] card).put(['a] card).put(['b] card)

  + tree_seed_checks
    \ records=row[[path myth]]
    ^ bool
    = base (grove_backend_checks/lookup records [($x 17) 'gov 'srs])
    ?> (./some root) base .false
    ?> (./some held) root.get(grove_templates/slot) .false
    ?> template=grove_template held .false
    ? !(eq template.seeds.len 4) .false
    = find (grove_backend_checks/lookup template.seeds)
    ?> (./some demo) (find ['cards 'demo]) .false
    ?> (./some cards) (find ['cards]) .false
    ?> (./some next) (find ['next]) .false
    ? demo.has(grove_backend/module_slot) .false
    ? !(eq demo.nat_at([($x 17) 'gov 'srs 'interval] 0) 1) .false
    ? !(demo.has(['sys 'lash])) .false
    ? !(cards.has(publisher_vocabulary/spec)) .false
    ?> (./some held) next.get(['sys 'weft]) .false
    ?> link=safe held .false
    ? !(equal[path] link.path [($x 17) 'gov 'srs 'queue]) .false
    ?> (./some held) next.get(['sys 'tack]) .false
    ?> tack=grove_instance_ref held .false
    | equal[path] tack.path ['cards]

  + path_codec_checks
    \ ignored=unit
    ^ bool
    = word | rex/word "0x0001"
      absolute | rex/cord "/0x0001/slot"
    ?> (./ok segment) (grove_roles/parts word) .false
    ? !(equal[path] segment [($x 256)]) .false
    ?> (./ok slot) (grove_roles/parts absolute) .false
    ? !(equal[path] slot [($x 256) 'slot]) .false
    ?> (./ok backend_segment) (grove_backend/path_parts word) .false
    ? !(equal[path] backend_segment segment) .false
    ?> (./ok backend_slot) (grove_backend/namespace_path absolute) .false
    ? !(equal[path] backend_slot slot) .false
    ?> (./ok tree) (grove_trees/parse_path word.span "/0x0001/7") .false
    | equal[path] tree [($x 256) ($u 7)]
