- helm
- net
- pass
- mesa_foot
- door
- desk
- scope
- scope_foot
- grove_role_runtime
- grove_template
- testing
- tests/mesa_foot [at=fixture]
- tests/namespace [at=base]
- tests/grove_install [at=installer]
- tests/weave [at=woven]

' A community, 0x18, with three places. Alice is invited to the first and
' comes as the name minted for it. Bob is invited to the second and comes
' as a world he already had. The third admits only on approval. Then the
' catalog reaches a member, who meets the others from it. Last, the link
' to the first place is handed to the world prepared for it, which joins.
+ scope_tests
  + seed
    \ n=nat
    ^ nat
    | fixture/foot_tests/seed n
  + keys
    ^ desk/keys
    | desk/keys (scope_tests/seed 18) (scope_tests/seed 180) (scope_tests/seed 181)
  + root
    ^ path
    [($x 18) 'app 'community]
  + place
    ' Where the nth place is. A pack lays its places out as it likes, so
    ' these are not in one folder: a seat, a position in an office, a
    ' supplier of a project, and a seat nobody is invited to yet.
    \ n=nat
    ^ path
    ? (eq n 1) (scope_tests/root).weld(['members 'alice])
    ? (eq n 2) (scope_tests/root).weld(['projects 'bridge 'suppliers 'steel])
    ? (eq n 3) (scope_tests/root).weld(['office 'positions 'purchasing])
    | (scope_tests/root).weld(['members 'later])
  + put
    \ writes=row[[p=path q=writ]] state=namespace
    ^ namespace
    | fixture/foot_tests/apply writes state
  + found
    \ result=either[iota row[[p=path q=writ]]] state=namespace
    ^ namespace
    | fixture/foot_tests/found result state
  + step
    ' The scope's hand, once: every place one step.
    \ state=namespace
    ^ namespace
    | scope_tests/put (scope/tended scope_tests/root state) state
  + desked
    ' The foot's desk, once: every ask that waits is answered.
    \ foot=mesa_foot/foot state=namespace
    ^ namespace
    | (desk/pending ($x 18) state).fold state
      \ now=namespace item=[at=path ask=myth]
      ^ namespace
      = [where ask] item
        turn (desk/answer scope_tests/keys 0 where ask now foot)
      | (fixture/foot_tests/settle (fixture/foot_tests/world now foot) turn.does).world.state
  + slot
    \ name=path at=path state=namespace
    ^ nat
    | net/held name at state
  + start
    ' The community with its three places written, each with a number.
    \ n=nat
    ^ namespace
    = c (fixture/foot_tests/boot 18)
      one=myth (myth/sing ['lede] (pails/t "a seat for Alice")).put(['invite] (pails/n 1))
      two=myth (myth/sing ['lede] (pails/t "a seat for Bob")).put(['invite] (pails/n 2))
      three=myth (myth/sing ['lede] (pails/t "a seat that waits")).put(['invite] (pails/n 3)).put(['terms] (pails/t "on approval"))
      plan=myth (myth/sing ['lede] (pails/t "a seat nobody is invited to yet"))
      writes=row[[p=path q=writ]] [[(scope_tests/place 1) (writ/make one)] [(scope_tests/place 2) (writ/make two)] [(scope_tests/place 3) (writ/make three)] [(scope_tests/place 4) (writ/make plan)]]
    | scope_tests/put writes c.state
  + ready
    ' After the hand asked, the desk minted and the hand took the names.
    \ n=nat
    ^ namespace
    = c (fixture/foot_tests/boot 18)
    | scope_tests/step (scope_tests/desked c.foot (scope_tests/step (scope_tests/start 0)))
  + minted
    \ n=nat
    ^ pass/minted
    | pass/mint (desk/invitation scope_tests/keys n) 0 (Ed25519PublicKey (scope_tests/seed 18))
  + alice
    ' The name minted for place 1, claimed, and saying where it runs.
    \ state=namespace
    ^ namespace
    = made (scope_tests/minted 1)
      n made.name
      card=path [($x 18) 'io 'mesa ($x n)]
      mine (scope_tests/seed 50)
      at1 (fixture/foot_tests/stand (pass/read n made.made [made.first]))
      claimed (pass/claim (desk/invitation scope_tests/keys 1) n at1 (Ed25519PublicKey mine) (Ed25519PublicKey (scope_tests/seed 51)))
      at2 (fixture/foot_tests/stand (pass/next n at1 claimed))
      here (pass/introduce mine mine 18 n n made.made at2 "10.0.0.5" 9105)
      s1 (scope_tests/found (pass/follow card claimed state) state)
    | scope_tests/found (pass/welcome card here s1) s1
  + bob_made
    ^ pass/minted
    | pass/mint (scope_tests/seed 700) 0 (Ed25519PublicKey (scope_tests/seed 3))
  + bob
    ' The name minted for place 2 is claimed by Bob, whose own world is
    ' brought by it. signed says whether Bob's world signed too.
    \ signed=bool state=namespace
    ^ namespace
    = made (scope_tests/minted 2)
      n made.name
      n_card=path [($x 18) 'io 'mesa ($x n)]
      mine (scope_tests/seed 60)
      at1 (fixture/foot_tests/stand (pass/read n made.made [made.first]))
      claimed (pass/claim (desk/invitation scope_tests/keys 2) n at1 (Ed25519PublicKey mine) (Ed25519PublicKey (scope_tests/seed 61)))
      w (scope_tests/bob_made)
      w_card=path [($x 18) 'io 'mesa ($x w.name)]
      wat (fixture/foot_tests/stand (pass/read w.name w.made [w.first]))
      signer (? signed (pass/custody (scope_tests/seed 700)) (scope_tests/seed 99))
      letter (pass/introduce mine signer 18 n w.name w.made wat "10.0.0.6" 9106)
      s1 (scope_tests/found (pass/follow n_card claimed state) state)
      s2 (scope_tests/found (pass/welcome w_card letter s1) s1)
      s3 (scope_tests/found (pass/follow w_card w.first s2) s2)
    | scope_tests/found (pass/welcome w_card letter s3) s3
  + twice
    ' Bob's world, already heard, is brought again: by the name minted
    ' for place 3, which Bob claims too.
    \ state=namespace
    ^ namespace
    = made (scope_tests/minted 3)
      n made.name
      n_card=path [($x 18) 'io 'mesa ($x n)]
      mine (scope_tests/seed 60)
      at1 (fixture/foot_tests/stand (pass/read n made.made [made.first]))
      claimed (pass/claim (desk/invitation scope_tests/keys 3) n at1 (Ed25519PublicKey mine) (Ed25519PublicKey (scope_tests/seed 61)))
      w (scope_tests/bob_made)
      w_card=path [($x 18) 'io 'mesa ($x w.name)]
      wat (fixture/foot_tests/stand (pass/read w.name w.made [w.first]))
      letter (pass/introduce mine (pass/custody (scope_tests/seed 700)) 18 n w.name w.made wat "10.0.0.6" 9106)
      s1 (scope_tests/found (pass/follow n_card claimed state) state)
      s2 (scope_tests/found (pass/welcome w_card letter s1) s1)
    | scope_tests/found (pass/welcome w_card letter s2) s2
  + places
    \ _=unit
    ^ row[testing/check]
    = begun (scope_tests/start 0)
      asked (scope_tests/step begun)
      opened (scope_tests/ready 0)
      a (scope_tests/minted 1).name
      b (scope_tests/bob_made).name
      a_entry=path (scope_tests/root).weld(['catalog ($x a)])
      b_entry=path (scope_tests/root).weld(['catalog ($x b)])
      came (scope_tests/alice opened)
      sat (scope_tests/step came)
      seated (scope_tests/step sat)
      both (scope_tests/step (scope_tests/step (scope_tests/bob .true seated)))
      unsigned (scope_tests/step (scope_tests/step (scope_tests/bob .false seated)))
      again (scope_tests/step (scope_tests/twice both))
    [(testing/nat "each place with a number asks the desk for its invitation" 3 (desk/pending ($x 18) asked).len)
     (testing/nat "a record with no invitation's number is only planned: it asks for nothing" 0 (scope_tests/slot ['name] (scope_tests/place 4) opened))
     (testing/nat "a place deep in the tree is a place like any other" 1 (gt (scope_tests/slot ['name] (scope_tests/place 2) opened) 0))
     (testing/nat "the place takes the name the desk minted" 1 (eq a (scope_tests/slot ['name] (scope_tests/place 1) opened)))
     (testing/nat "an open place is not filled" 0 (scope_tests/slot ['world] (scope_tests/place 1) opened))
     (testing/nat "nothing moves while nobody has come" 0 (scope/tended scope_tests/root opened).len)
     (testing/nat "the name claimed and heard fills its place" 1 (eq a (scope_tests/slot ['world] (scope_tests/place 1) sat)))
     (testing/nat "and is listed at once" 1 (eq a (scope_tests/slot ['world] a_entry seated)))
     (testing/nat "the world Bob brought fills his place, not the name he claimed" 1 (eq b (scope_tests/slot ['world] (scope_tests/place 2) both)))
     (testing/nat "and is listed" 1 (eq b (scope_tests/slot ['world] b_entry both)))
     (testing/nat "two worlds are listed" 2 (scope/listed scope_tests/root both).len)
     (testing/nat "without that world's own signature the place stays open" 0 (scope_tests/slot ['world] (scope_tests/place 2) unsigned))
     (testing/nat "and one world is listed" 1 (scope/listed scope_tests/root unsigned).len)
     (testing/nat "once everyone is seated nothing moves" 0 (scope/tended scope_tests/root both).len)
     (testing/nat "a world already heard, brought by a second name, fills that place too" 1 (eq b (scope_tests/slot ['world] (scope_tests/place 3) again)))
     (testing/nat "and keeps the place it had" 1 (eq b (scope_tests/slot ['world] (scope_tests/place 2) again)))
     (testing/nat "where it is reached is as it was" 9106 (scope_tests/slot ['port] [($x 18) 'io 'mesa ($x b)] again))]
  + approval
    \ _=unit
    ^ row[testing/check]
    = opened (scope_tests/ready 0)
      made (scope_tests/minted 3)
      n made.name
      card=path [($x 18) 'io 'mesa ($x n)]
      mine (scope_tests/seed 70)
      at1 (fixture/foot_tests/stand (pass/read n made.made [made.first]))
      claimed (pass/claim (desk/invitation scope_tests/keys 3) n at1 (Ed25519PublicKey mine) (Ed25519PublicKey (scope_tests/seed 71)))
      at2 (fixture/foot_tests/stand (pass/next n at1 claimed))
      here (pass/introduce mine mine 18 n n made.made at2 "10.0.0.7" 9107)
      s1 (scope_tests/found (pass/follow card claimed opened) opened)
      s2 (scope_tests/found (pass/welcome card here s1) s1)
      waiting (scope_tests/step (scope_tests/step s2))
      entry=path (scope_tests/root).weld(['catalog ($x n)])
      yes=row[[p=path q=writ]] [[(scope_tests/place 3) (writ/poke (myth/sing ['approved] (pails/n 1)))]]
      admitted (scope_tests/step (scope_tests/put yes waiting))
    [(testing/nat "a place that waits is filled when its world is heard" 1 (eq n (scope_tests/slot ['world] (scope_tests/place 3) waiting)))
     (testing/nat "and is not listed" 0 (scope/listed scope_tests/root waiting).len)
     (testing/nat "until its record says it is approved" 1 (eq n (scope_tests/slot ['world] entry admitted)))]
  + landed
    ' What a member holds once the scope's root for it has landed: the
    ' same records beneath /<member>/her/<scope>. A test's stand-in for
    ' the wire, which the foot's own suite covers.
    \ member=nat source=namespace state=namespace
    ^ namespace
    = from=path [($x 18) 'our ($x member)]
      to=path [($x member) 'her ($x 18)]
      none=row[[p=path q=writ]] []
      moved
        | (sovereign_peek from source).tap.fold none
          \ acc [rel record]
          | acc.snoc([to.weld(rel) (writ/make record)])
    | scope_tests/put moved state
  + catalog
    \ _=unit
    ^ row[testing/check]
    = both (scope_tests/step (scope_tests/step (scope_tests/bob .true (scope_tests/step (scope_tests/step (scope_tests/alice (scope_tests/ready 0)))))))
      a (scope_tests/minted 1).name
      b (scope_tests/bob_made).name
      told (scope/tell scope_tests/root a both)
      after (scope_tests/put told both)
      seat=path [($x 18) 'our ($x a) 'catalog ($x b)]
      hers (namespace ($x a) sov/new (base/namespace_tests/initial).system)
      held (scope_tests/landed a after hers)
      met (scope_tests/put (scope/take 18 held) held)
      card=path [($x a) 'io 'mesa ($x b)]
      shown=path [($x a) 'her ($x 18) 'catalog ($x b) 'pass]
      own=path [($x 18) 'our ($x a) 'catalog ($x a)]
      keeper=path [($x 18) 'our ($x a) 'catalog ($x 18)]
      lie=row[[p=path q=writ]] [[shown (writ/poke (myth/sing ['custody] (pails/n (Ed25519PublicKey (scope_tests/seed 5)))))]]
      lied (scope_tests/put lie held)
    [(testing/nat "the scope tells a member of the other listed world" 1 (eq (Ed25519PublicKey (scope_tests/seed 3)) (scope_tests/slot ['key] seat after)))
     (testing/nat "with where it is reached" 9106 (scope_tests/slot ['port] seat after))
     (testing/nat "and its founding" 1 (eq (scope_tests/bob_made).made.custody (scope_tests/slot ['custody] seat.snoc('pass) after)))
     (testing/nat "and not of the member itself" 0 (? (net/live own after) 1 0))
     (testing/nat "nor of itself: its name was not made from a founding, and proves nothing" 0 (? (net/live keeper after) 1 0))
     (testing/nat "told again when nothing moved, it writes nothing" 0 (scope/tell scope_tests/root a after).len)
     (testing/nat "everyone listed is told" 1 (gt (scope/told scope_tests/root both).len told.len))
     (testing/nat "the member meets the other from what landed: its log is kept" 1 (scope_tests/slot ['seq] card met))
     (testing/nat "under the key the log gives" 1 (eq (Ed25519PublicKey (scope_tests/seed 3)) (net/key card met)))
     (testing/nat "at the address the scope gave: it is a route with no peer configured" 9106 (scope_tests/slot ['port] card met))
     (testing/nat "met, there is nothing more to take" 0 (scope/take 18 met).len)
     (testing/nat "a scope that passes on a founding that is not the name's introduces nobody" 0 (scope/take 18 lied).len)]
  + settle
    ' The scope's foot, turn after turn, until nothing is due or the turns
    ' run out.
    \ turns=nat state=namespace
    ^ namespace
    % left=nat turns
      now=namespace state
    ^ namespace
    ? !(left) now
    = due (scope_foot/all now)
    ? !(due.len) now
    | _ left.dec (scope_tests/put due now)
  + tending
    ' The same, run by the foot: a record beneath its own names the root
    ' it tends, and at a member a record names the scope it is listed in.
    \ _=unit
    ^ row[testing/check]
    = c (fixture/foot_tests/boot 18)
      at_c=path [($x 18) 'io 'scope 'community]
      tends=row[[p=path q=writ]] [[at_c (writ/make (myth/sing ['root] (safe 0 .x scope_tests/root)))]]
      begun (scope_tests/put tends (scope_tests/start 0))
      idle (fixture/foot_tests/boot 18).state
      asked (scope_tests/settle 8 begun)
      named (scope_tests/settle 8 (scope_tests/desked c.foot asked))
      a (scope_tests/minted 1).name
      b (scope_tests/bob_made).name
      full (scope_tests/settle 8 (scope_tests/bob .true (scope_tests/settle 8 (scope_tests/alice named))))
      seat=path [($x 18) 'our ($x a) 'catalog ($x b)]
      back=path [($x 18) 'our ($x b) 'catalog ($x a)]
      hers (namespace ($x a) sov/new (base/namespace_tests/initial).system)
      at_a=path [($x a) 'io 'scope 'community]
      listed=row[[p=path q=writ]] [[at_a (writ/make (myth/sing ['scope] (pails/n 18)))]]
      member (scope_tests/settle 8 (scope_tests/landed a full (scope_tests/put listed hers)))
      card=path [($x a) 'io 'mesa ($x b)]
    [(testing/nat "with no record beneath it the foot has nothing to do" 0 (scope_foot/all idle).len)
     (testing/nat "a record that names a root: each open place asks for its invitation" 3 (desk/pending ($x 18) asked).len)
     (testing/nat "and then nothing is due until the desk answers" 0 (scope_foot/all asked).len)
     (testing/nat "the names are taken" 1 (eq a (scope_tests/slot ['name] (scope_tests/place 1) named)))
     (testing/nat "everyone who came is seated and listed" 2 (scope/listed scope_tests/root full).len)
     (testing/nat "each is told of the other, in its own root" 9106 (scope_tests/slot ['port] seat full))
     (testing/nat "both ways" 9105 (scope_tests/slot ['port] back full))
     (testing/nat "and the foot has settled" 0 (scope_foot/all full).len)
     (testing/nat "at a member, a record that names the scope: the listed world is met" 9106 (scope_tests/slot ['port] card member))
     (testing/nat "and that foot has settled too" 0 (scope_foot/all member).len)]
  + record
    \ at=path state=namespace
    ^ myth
    | (sovereign_care .x at state).fil.fall(myth/new)
  + yes
    \ said=bool
    ^ nat
    ? said 1
    0
  + reached
    ' The community once it says where it is itself reached.
    \ state=namespace
    ^ namespace
    = home=path [($x 18) 'io 'mesa]
      said=myth (myth/sing ['key] (pails/n (Ed25519PublicKey (scope_tests/seed 18)))).put(['host] (pails/t "10.0.0.1")).put(['port] (pails/n 9100))
      writes=row[[p=path q=writ]] [[home (writ/make said)]]
    | scope_tests/put writes state
  + linking
    ' The link to the first place, and the world prepared for that place,
    ' which is handed the link and joins: it claims itself, meets the
    ' community, takes its part and asks to be brought before it.
    \ _=unit
    ^ row[testing/check]
    = at_c=path [($x 18) 'io 'scope 'community]
      tends=row[[p=path q=writ]] [[at_c (writ/make (myth/sing ['root] (safe 0 .x scope_tests/root)))]]
      silent (scope_tests/put tends (scope_tests/ready 0))
      opened (scope_tests/reached silent)
      n (scope_tests/minted 1).name
      secret (desk/invitation scope_tests/keys 1)
      empty (scope/link 0 0 "" 0 "" 0 (pass/founding 0 0 0) 0)
      l (scope/linked scope_tests/root (scope_tests/place 1) opened).fall(empty)
      text (scope/show l)
      whole (str/cat_all [text "," (nat/show secret)])
      back (scope/read whole).fall(empty)
      by_number (scope_foot/invitation 1 opened).fall(empty)
      self=iota ($x n)
      host (scope_tests/seed 18)
      nobody=row[mesa_foot/peer] []
      foot (mesa_foot/start self host 0 nobody)
      k (desk/keys host (scope_tests/seed 500) (scope_tests/seed 501))
      hers (namespace self sov/new (base/namespace_tests/initial).system)
      home=path [self 'io 'mesa]
      peer=path [self 'io 'mesa ($x 18)]
      rec=path (scope/joining self n)
      ask=path (scope/claims self n)
      session (door/named "a secret the browser made")
      born (desk/founded (pass/birth l.made l.first) foot)
      h0 (fixture/foot_tests/settle (fixture/foot_tests/world hers foot) born.does).world.state
      j0 (scope_tests/found (scope/join l 7 session 5000 h0) h0)
      early (scope/joined rec (scope_tests/record rec j0) j0)
      asked (scope_tests/record ask j0)
      turn (desk/answer k secret ask asked j0 foot)
      j1 (fixture/foot_tests/settle (fixture/foot_tests/world j0 foot) turn.does).world.state
      j2 (scope_tests/settle 8 j1)
      said=row[[p=path q=writ]] [[home (writ/poke (myth/sing ['host] (pails/t "10.0.0.9")).put(['port] (pails/n 9109)))]]
      j3 (scope_tests/settle 8 (scope_tests/put said j2))
      bring (scope_tests/record (scope/brings self n) j3)
      wrong (desk/answer k (scope_tests/seed 9) ask asked j0 foot)
      w1 (fixture/foot_tests/settle (fixture/foot_tests/world j0 foot) wrong.does).world.state
      w2 (scope_tests/settle 8 w1)
      cleared=row[[p=path q=writ]] [[ask (writ/poke (myth/sing ['spent] (pails/n 1)))]]
      w3 (scope_tests/put cleared w2)
    [(testing/nat "a place has no link while its scope does not say where it is reached" 0 (scope_tests/yes (maybe/is_some (scope/linked scope_tests/root (scope_tests/place 1) silent))))
     (testing/nat "once it does, the link names the name minted for the place" 1 (scope_tests/yes (eq n l.name)))
     (testing/nat "and where the scope is reached" 9100 l.port)
     (testing/text "and where the place's root sits there" "/app/community" l.rel)
     (testing/nat "a record that is no place has no link" 0 (scope_tests/yes (maybe/is_some (scope/linked scope_tests/root (scope_tests/place 4) opened))))
     (testing/nat "the link is found by the invitation's number" 1 (scope_tests/yes (eq n by_number.name)))
     (testing/nat "and no link by a number nothing holds" 0 (scope_tests/yes (maybe/is_some (scope_foot/invitation 9 opened))))
     (testing/nat "as text and back it is the same link" 1 (scope_tests/yes (equal[str] text (scope/show back))))
     (testing/nat "the secret follows the link" 1 (scope_tests/yes (eq secret (scope/secret whole))))
     (testing/nat "and is no part of it" 0 (scope/secret text))
     (testing/nat "text that is not a link reads as none" 0 (scope_tests/yes (maybe/is_some (scope/read "1,2,3"))))
     (testing/nat "the last four parts of a link are what a host starts a world under the name with" 1 (scope_tests/yes (equal[str] (pass/birth l.made l.first) (str/join "," (str/split_byte 44 text).drop(7)))))
     (testing/nat "a world started with them keeps the name's founding and first statement" 1 (scope_tests/slot ['seq] home h0))
     (testing/nat "a link to this world's own name may be handed over by nobody, while it has let nobody in" 1 (scope_tests/yes (scope/unlocked l h0)))
     (testing/nat "a link to another name may not" 0 (scope_tests/yes (scope/unlocked l opened)))
     (testing/nat "a world that was not started under the name cannot claim it" 1 (scope_tests/yes (either/is_err (scope/join l 7 session 5000 hers))))
     (testing/nat "handed the link, the prepared world asks its desk to claim the name" 1 (desk/pending self j0).len)
     (testing/nat "and takes nothing else on the link's word: no card for the scope" 0 (scope_tests/yes (net/live peer j0)))
     (testing/nat "and no step, until the claim is made" 0 early.len)
     (testing/nat "the claim made, custody is its own" 2 (scope_tests/slot ['seq] home j1))
     (testing/nat "and the session the claim named is let in" 1 (scope_tests/yes (door/open session 1000 j1)))
     (testing/nat "so the next link is handed over by someone" 0 (scope_tests/yes (scope/unlocked l j1)))
     (testing/nat "then the scope is met at the address the link gave" 9100 (scope_tests/slot ['port] peer j2))
     (testing/nat "under the key the link gave" 1 (scope_tests/yes (eq l.key (scope_tests/slot ['key] peer j2))))
     (testing/nat "the record names the scope this world is listed in" 18 (scope_tests/slot ['scope] rec j2))
     (testing/nat "and the composition it takes part in" 18 (scope_tests/slot ['maker] rec j2))
     (testing/nat "it does not ask to be brought while it does not say where it is reached" 0 (scope_tests/yes (net/live (scope/brings self n) j2)))
     (testing/nat "once it does, it asks to be brought before the scope" 18 bring.nat_at(['to] 0))
     (testing/nat "at its own address" 9109 bring.nat_at(['port] 0))
     (testing/nat "and the foot has settled" 0 (scope_foot/all j3).len)
     (testing/nat "joined, it is not handed the link again" 1 (scope_tests/yes (either/is_err (scope/join l 8 0 0 j3))))
     (testing/nat "nor in the moment between its claim and its part" 1 (scope_tests/yes (either/is_err (scope/join l 8 0 0 (scope_tests/put cleared j1)))))
     (testing/nat "with another secret the claim is refused" 2 (scope_tests/slot ['done] ask w1))
     (testing/nat "nobody is let in" 0 (scope_tests/yes (door/open session 1000 w2)))
     (testing/nat "and the scope is not met" 0 (scope_tests/yes (net/live peer w2)))
     (testing/nat "while a claim waits, the link is not handed over again" 1 (scope_tests/yes (either/is_err (scope/join l 7 session 5000 j0))))
     (testing/nat "nor while a refused claim's secret has not been cleared away" 1 (scope_tests/yes (either/is_err (scope/join l 7 session 5000 w2))))
     (testing/nat "once it has, the link is taken again" 1 (scope_tests/yes (either/is_ok (scope/join l 7 session 5000 w3))))]
  + making
    ' A composition made from a Grove unit because a record asks. 0x11
    ' publishes a unit: a template of two records, one of them a place,
    ' and two norms that say who writes and who reads.
    \ _=unit
    ^ row[testing/check]
    = self=iota ($x 17)
      unit=path [self 'gov 'course]
      target=path [self 'app 'course]
      at=path [self 'io 'scope 'course]
      lost=path [self 'io 'scope 'lost]
      taken=path [self 'io 'scope 'taken]
      here=path []
      chair=path ['chair]
      seeds=row[[path myth]] [[here (myth/sing ['title] (pails/t "A course"))] [chair (myth/sing ['invite] (pails/n 1))]]
      top=myth (myth/sing grove_templates/slot (grove_template grove_templates/version seeds))
      chair_at=row[grove_norm_segment] [(woven/course_tests/name "chair")]
      set_at=row[grove_norm_segment] [(woven/course_tests/name "assignments") (woven/course_tests/open "a")]
      published=row[[p=path q=writ]] [[unit (writ/make top)] [unit.snoc('a_chair) (writ/make (woven/course_tests/norm chair_at "maker" "chair"))] [unit.snoc('b_set) (writ/make (woven/course_tests/norm set_at "chair" "chair"))]]
      s0 (scope_tests/put published (installer/grove_install_checks/bootstrap []))
      asks=myth (myth/sing ['make] (safe 0 .x unit)).put(['rel] (pails/t "/app/course"))
      asked=row[[p=path q=writ]] [[at (writ/make asks)]]
      s1 (scope_tests/put asked s0)
      s2 (scope_tests/settle 12 s1)
      nothing=path [self 'gov 'nothing]
      wants=myth (myth/sing ['make] (safe 0 .x nothing)).put(['rel] (pails/t "/app/nothing"))
      vain=row[[p=path q=writ]] [[lost (writ/make wants)]]
      s3 (scope_tests/settle 12 (scope_tests/put vain s0))
      full=path [self 'app 'full]
      gone=path [self 'app 'nothing]
      again=myth (myth/sing ['make] (safe 0 .x unit)).put(['rel] (pails/t "/app/full"))
      stands=row[[p=path q=writ]] [[full (writ/make (myth/sing ['title] (pails/t "something else")))] [taken (writ/make again)]]
      s4 (scope_tests/settle 12 (scope_tests/put stands s0))
    [(testing/nat "the unit is published before anything asks" 1 (scope_tests/yes (net/live unit s0)))
     (testing/nat "a record that names the unit asks for a composition: its template is mounted" 1 (scope_tests/slot ['invite] target.snoc('chair) s2))
     (testing/text "with what the template says" "A course" (scope_tests/record target s2).txt_at(['title]))
     (testing/nat "stamped with the unit it came from" 1 (scope_tests/yes (scope_foot/sprung unit target s2)))
     (testing/nat "its table is written beneath it, read off the unit's norms: two, the top and the table's own" 1 (scope_tests/yes (net/live target.weld(['table ($u 4)]) s2)))
     (testing/nat "and no more" 0 (scope_tests/yes (net/live target.weld(['table ($u 5)]) s2)))
     (testing/nat "the record becomes a scope this world keeps" 1 (scope_tests/yes (maybe/is_some (scope_foot/rooted (scope_tests/record at s2)))))
     (testing/nat "and a composition this world is the maker of" 17 (scope_tests/slot ['maker] at s2))
     (testing/nat "so its places are tended: the chair asks for its invitation" 1 (desk/pending self s2).len)
     (testing/nat "and the foot has settled" 0 (scope_foot/all s2).len)
     (testing/nat "a record that names a unit nobody published makes nothing" 0 (scope_tests/yes (net/live gone s3)))
     (testing/nat "and says why" 1 (scope_tests/yes (gt (scope_tests/record lost s3).txt_at(['why]).len 0)))
     (testing/nat "once" 0 (scope_foot/all s3).len)
     (testing/nat "where something else stands, no table is written over it" 0 (scope_tests/yes (net/live full.weld(['table ($u 1)]) s4)))
     (testing/nat "and the record says so" 1 (scope_tests/yes (gt (scope_tests/record taken s4).txt_at(['why]).len 0)))]
  + named
    \ _=unit
    ^ row[testing/check]
    = custody (scope_tests/seed 800)
      live (scope_tests/seed 801)
      made (pass/founding pass/form (Ed25519PublicKey custody) 0)
      s (pass/name made)
      first (pass/state custody s (pass/born made) 1 0 (Ed25519PublicKey live) (Ed25519PublicKey custody))
      log=row[pass/statement] [first]
      a 77
      home=path [($x s) 'io 'mesa]
      root=path [($x s) 'app 'school]
      entry=path [($x s) 'our ($x a) 'catalog ($x s)]
      card=path [($x a) 'io 'mesa ($x s)]
      k0 (namespace ($x s) sov/new (base/namespace_tests/initial).system)
      k1 (scope_tests/found (pass/meet home made log k0) k0)
      reach=myth (myth/sing ['host] (pails/t "10.0.0.9")).put(['port] (pails/n 9109))
      setup=row[[p=path q=writ]] [[home (writ/poke reach)] [root.weld(['catalog ($x a)]) (writ/make (myth/sing ['world] (pails/n a)))]]
      k2 (scope_tests/put setup k1)
      told (scope/tell root a k2)
      k3 (scope_tests/put told k2)
      keyed=myth (myth/sing ['key] (pails/n (Ed25519PublicKey live))).put(['host] (pails/t "10.0.0.9")).put(['port] (pails/n 9109))
      linked=row[[p=path q=writ]] [[card (writ/make keyed)]]
      h0 (scope_tests/put linked (namespace ($x a) sov/new (base/namespace_tests/initial).system))
      from=path [($x s) 'our ($x a)]
      to=path [($x a) 'her ($x s)]
      none=row[[p=path q=writ]] []
      moved
        | (sovereign_peek from k3).tap.fold none
          \ acc [rel record]
          | acc.snoc([to.weld(rel) (writ/make record)])
      h1 (scope_tests/put moved h0)
      h2 (scope_tests/put (scope/take s h1) h1)
    [(testing/nat "a scope whose name its founding makes tells a member of itself: where it stands" 1 (scope_tests/slot ['seq] entry k3))
     (testing/nat "its founding" 1 (? (eq made.custody (scope_tests/slot ['custody] entry.snoc('pass) k3)) 1 0))
     (testing/nat "and its log" 1 (? (net/live (pass/at entry 1) k3) 1 0))
     (testing/nat "told again when nothing moved, it writes nothing" 0 (scope/tell root a k3).len)
     (testing/nat "the member held only the key its link gave" 0 (? (maybe/is_some (pass/founded card h1)) 1 0))
     (testing/nat "from what landed it holds the founding and the log, checked against the scope's name" 1 (scope_tests/slot ['seq] card h2))
     (testing/nat "under the same key" 1 (? (eq (Ed25519PublicKey live) (net/key card h2)) 1 0))
     (testing/nat "and where the scope is reached" 9109 (scope_tests/slot ['port] card h2))
     (testing/nat "after which there is nothing more to take" 0 (scope/take s h2).len)]

  + gave
    \ got=either[str row[[p=path q=writ]]]
    ^ row[[p=path q=writ]]
    = none=row[[p=path q=writ]] []
    ? got
     > (./err why) none
     > (./ok writes) writes
  + why
    \ got=either[str row[[p=path q=writ]]]
    ^ str
    = nothing=str ""
    ? got
     > (./err why) why
     > (./ok writes) nothing
  + opening
    ' A place its keeper opened: 0x11 makes a course whose seats are open
    ' to two. Whoever shows a ticket is given a seat with the next
    ' invitation number, once; the third is told there is none left.
    \ _=unit
    ^ row[testing/check]
    = self=iota ($x 17)
      unit=path [self 'gov 'course]
      target=path [self 'app 'course]
      at=path [self 'io 'scope 'course]
      here=path []
      chair=path ['chair]
      seats=path ['seats]
      name=iota 'course
      opened=myth (myth/sing ['open] (pails/n 2)).put(['title] (pails/t "Seats"))
      seeds=row[[path myth]] [[here (myth/sing ['title] (pails/t "A course"))] [chair (myth/sing ['invite] (pails/n 1))] [seats opened]]
      top=myth (myth/sing grove_templates/slot (grove_template grove_templates/version seeds))
      chair_at=row[grove_norm_segment] [(woven/course_tests/name "chair")]
      seat_at=row[grove_norm_segment] [(woven/course_tests/name "seats") (woven/course_tests/open "s")]
      published=row[[p=path q=writ]] [[unit (writ/make top)] [unit.snoc('a_chair) (writ/make (woven/course_tests/norm chair_at "maker" "chair"))] [unit.snoc('b_seats) (writ/make (woven/course_tests/norm seat_at "maker" "chair"))]]
      s0 (scope_tests/put published (installer/grove_install_checks/bootstrap []))
      asks=myth (myth/sing ['make] (safe 0 .x unit)).put(['rel] (pails/t "/app/course"))
      asked=row[[p=path q=writ]] [[at (writ/make asks)]]
      s1 (scope_tests/settle 12 (scope_tests/put asked s0))
      tab (str/from_atom 9)
      offered=row[str] ["/course" "/seats" "2" "A course" "Seats"]
      first (scope_tests/gave (scope_foot/taking name seats 555 s1))
      s2 (scope_tests/put first s1)
      seat=path target.weld(['seats 'o555])
      again (scope_foot/taking name seats 555 s2)
      s3 (scope_tests/put (scope_tests/gave (scope_foot/taking name seats 777 s2)) s2)
      other=path target.weld(['seats 'o777])
      s4 (scope_tests/settle 12 s3)
      plain=path target.weld(['seats 'plain])
      added=row[[p=path q=writ]] [[plain (writ/make (myth/sing ['title] (pails/t "A seat")))]]
      s5 (scope_tests/put added s3)
      wanted=path ['seats 'plain]
      had=path ['seats 'o555]
      s6 (scope_tests/put (scope_tests/gave (scope_foot/inviting name wanted s5)) s5)
    [(testing/text "the door shows nobody the place its keeper opened, and how many are left" (str/join tab offered) (scope_foot/offers s1))
     (testing/nat "a ticket takes one place there" 1 first.len)
     (testing/nat "which holds the next invitation number this world has not used" 2 (scope_tests/slot ['invite] seat s2))
     (testing/nat "and the ticket" 555 (scope_tests/slot ['ticket] seat s2))
     (testing/text "and starts as what the open place's record says of each" "Seats" (scope_tests/record seat s2).txt_at(['title]))
     (testing/nat "but is not itself open" 0 (scope_tests/slot ['open] seat s2))
     (testing/nat "the ticket names its invitation" 2 (scope_foot/ticket 555 s2))
     (testing/nat "and another names none" 0 (scope_foot/ticket 556 s2))
     (testing/nat "shown again, it takes nothing more" 0 (scope_tests/gave again).len)
     (testing/text "and is not refused" "" (scope_tests/why again))
     (testing/nat "a second ticket takes a second place, numbered after the first" 3 (scope_tests/slot ['invite] other s3))
     (testing/text "a third is told there is none left" "Every place offered there is taken." (scope_tests/why (scope_foot/taking name seats 888 s3)))
     (testing/nat "and the door offers nothing more" 0 (scope_foot/offers s3).len)
     (testing/text "a place nobody opened gives nothing" "That place is not open." (scope_tests/why (scope_foot/taking name chair 999 s1)))
     (testing/text "nor does anything without a ticket" "Show a ticket: a secret of your own making." (scope_tests/why (scope_foot/taking name seats 0 s1)))
     (testing/nat "each place taken is tended like any invited place: three invitations are asked for" 3 (desk/pending self s4).len)
     (testing/nat "a place that holds no invitation is given the next number" 4 (scope_tests/slot ['invite] plain s6))
     (testing/nat "asked again, it keeps the one it has" 0 (scope_tests/gave (scope_foot/inviting name wanted s6)).len)
     (testing/nat "as does a place that held one before" 0 (scope_tests/gave (scope_foot/inviting name had s5)).len)
     (testing/text "nothing is invited where nothing stands" "Nothing stands at that place yet." (scope_tests/why (scope_foot/inviting name chair.snoc('nobody) s5)))]

+ tests
  ^ row[testing/case]
  [(testing/case "places are opened, filled and listed" scope_tests/places)
   (testing/case "a place that admits on approval" scope_tests/approval)
   (testing/case "the catalog reaches a member, who meets the others from it" scope_tests/catalog)
   (testing/case "a scope with a founding ties its key to its name for its members" scope_tests/named)
   (testing/case "the scope's foot runs the rules until they settle" scope_tests/tending)
   (testing/case "a link is made, handed over and joined" scope_tests/linking)
   (testing/case "a composition is made from a Grove unit" scope_tests/making)
   (testing/case "an open place gives each ticket a place of its own" scope_tests/opening)]
