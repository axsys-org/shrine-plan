- tests/cells [at=fixture]
- graph_workspace
- testing

'  Several standings as one picture: standings that meet over established
'  hops share a component; a meeting through a text is a route, drawn and
'  counted soft, but joins nothing; a standing nothing established reaches
'  is an island; a gap says how many tentative routes it has.
+ graph_workspace_tests
  + record_at
    \ at=path tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.dip(at).fil.fall(myth/new)
    myth/new
  + root
    \ tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.fil.fall(myth/new)
    myth/new
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = property=path [($x 1) 'user 'properties 'building]
      insurer=path [($x 1) 'w12 'user 'carriers 'atlas]
      zone=path [($x 1) 'w13 'user 'zones 'ae]
      lonely=path [($x 1) 'w14 'user 'things 'lonely]
      text=path [($x 1) 'user 'web 'pages 'host 'page 'r1]
      mentions text.snoc('mentions)
      viewroot=path [($x 1) 'user 'views 'workspace]
      seed (fixture/cell_tests/put property (myth/sing ['name] (pails/t "100 Biscayne")).put(['insured_by] (safe 0 .x insurer)) sov/new)
      seed (fixture/cell_tests/put insurer (myth/sing ['name] (pails/t "Atlas")) seed)
      seed (fixture/cell_tests/put zone (myth/sing ['name] (pails/t "Zone AE")).put(['contains] (safe 0 .x property)) seed)
      seed (fixture/cell_tests/put lonely (myth/sing ['name] (pails/t "Lonely")) seed)
      seed (fixture/cell_tests/put text (myth/sing ['heading] (pails/t "A page that names both")) seed)
      seed (fixture/cell_tests/put mentions (myth/sing ['building] (safe 0 .x property)).put(['lonely] (safe 0 .x lonely)) seed)
      config (myth/sing bond/weft (woven graph_workspace/get)).put(bond/tack (safe 0 .x property)).put(['standing 'b] (safe 0 .x zone)).put(['standing 'c] (safe 0 .x lonely)).put(['depth] (pails/n 4))
      seed (fixture/cell_tests/put viewroot config seed)
      page (view .z 0 viewroot.cons('x) seed)
      top (graph_workspace_tests/root page)
      first (graph_workspace_tests/record_at ['route ($u 0)] page)
      second (graph_workspace_tests/record_at ['route ($u 1)] page)
      hop (graph_workspace_tests/record_at ['route ($u 0) 'here ($u 0)] page)
      third (graph_workspace_tests/record_at ['standing ($u 2)] page)
      gap (graph_workspace_tests/record_at ['gap ($u 0)] page)
      island (? (equal[pail] third.get(['island]).fall((pails/b .false)) (pails/b .true)) 1 0)
    [(testing/nat "three standings" 3 top.nat_at(['standings] 0))
     (testing/nat "two components: a mention joins nothing" 2 top.nat_at(['components] 0))
     (testing/nat "one island" 1 top.nat_at(['islands] 0))
     (testing/nat "two routes: one established, one through the text" 2 top.nat_at(['routes] 0))
     (testing/nat "the established route is one hop" 1 first.nat_at(['hops] 0))
     (testing/nat "with no soft hop" 0 first.nat_at(['soft] 0))
     (testing/text "a hop says which world asserts it" "w13" hop.txt_at(['by]))
     (testing/nat "the route through the text has two soft hops" 2 second.nat_at(['soft] 0))
     (testing/nat "the lonely standing is an island" 1 island)
     (testing/nat "the gap to the island counts its tentative route" 1 gap.nat_at(['tentative] 0))]

+ tests
  ^ row[testing/case]
  [(testing/case "several standings as one picture" graph_workspace_tests/checks)]
