- tests/cells [at=fixture]
- graph
- testing

'  Several standings as one picture: standings that meet over any reference
'  share a virtual root; a standing nothing reaches is an island, a root of
'  its own; a text whose prose names two things, as paths in brackets, joins
'  them, and the hop says the text holds the name.
+ graph_workspace_tests
  + record_at
    \ at=path tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.dip(at).fil.fall(myth/new)
    myth/new
  + paths_under
    \ at=path tree=res[axal[myth]]
    ^ str
    ? tree
     > (./known found)
       = names (found.dip(at).tap.map((\ [rel record] (path_show rel))))
       | str/join " | " names
    "unknown"
  + pinned
    ' A reference to a thing as of an epoch: /h/x/e<epoch>/<len>/<path>.
    \ epoch=nat target=path
    ^ path
    = head=path ['h 'x ($ts (str/cat_all ["e" epoch.show])) ($u target.len)]
    | head.weld(target)
  + root
    \ tree=res[axal[myth]]
    ^ myth
    ? tree
     > (./known found) found.fil.fall(myth/new)
    myth/new
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = property=path [($x 1) 'user 'properties 'building]
      insurer=path [($x 1) 'w12 'user 'carriers 'atlas]
      zone=path [($x 1) 'w13 'user 'zones 'ae]
      lonely=path [($x 1) 'w14 'user 'things 'lonely]
      apart=path [($x 1) 'w14 'user 'things 'apart]
      text=path [($x 1) 'user 'web 'pages 'host 'page 'r1]
      viewroot=path [($x 1) 'user 'views 'workspace]
      seed (fixture/cell_tests/put property (myth/sing ['name] (pails/t "100 Biscayne")).put(['insured_by] (safe 0 .x insurer)) sov/new)
      seed (fixture/cell_tests/put insurer (myth/sing ['name] (pails/t "Atlas")) seed)
      seed (fixture/cell_tests/put zone (myth/sing ['name] (pails/t "Zone AE")).put(['contains] (safe 0 .x property)) seed)
      seed (fixture/cell_tests/put lonely (myth/sing ['name] (pails/t "Lonely")) seed)
      seed (fixture/cell_tests/put apart (myth/sing ['name] (pails/t "Apart")) seed)
      seed (fixture/cell_tests/put text (myth/sing ['heading] (pails/t "A page that names both")).put(['text] (pails/t "The [/0x01/user/properties/building] is insured by Atlas; [/0x01/w14/user/things/lonely] stands alone.")) seed)
      config (myth/sing bond/weft (woven graph/overlay/get)).put(bond/tack (safe 0 .x property)).put(['standing 'b] (safe 0 .x zone)).put(['standing 'c] (safe 0 .x lonely)).put(['standing 'd] (safe 0 .x apart)).put(['depth] (pails/n 4))
      seed (fixture/cell_tests/put viewroot config seed)
      page (view .z 0 viewroot.cons('x) seed)
      top (graph_workspace_tests/root page)
      first=path [($u 0)]
      folder=path ['in ($u 1) 'text]
      mentioned first.weld(property).weld(folder)
      item=path [($u text.len)]
      heldby ((graph_workspace_tests/record_at mentioned.weld(item).weld(text) page).get(['via])).fall((pails/b .false))
      held=nat
        ? heldby
         > v=safe (? (equal[path] (graph/op/name v) text) 1 0)
        0
      second=path [($u 1)]
      before=nat seed.top
      judged (fixture/cell_tests/put property.weld(['same 'apart]) (myth/sing ['same] (safe 0 .x apart)) seed)
      live (view .z 0 viewroot.cons('x) judged)
      pinroot=path [($x 1) 'user 'views 'pinned]
      ' Every standing pinned at the epoch before: the picture as of then, both ways.
      pinned_config
        . (myth/sing bond/weft (woven graph/overlay/get))
          put(bond/tack (safe 0 .x (graph_workspace_tests/pinned before property)))
          put(['standing 'b] (safe 0 .x (graph_workspace_tests/pinned before zone)))
          put(['standing 'c] (safe 0 .x (graph_workspace_tests/pinned before lonely)))
          put(['standing 'd] (safe 0 .x (graph_workspace_tests/pinned before apart)))
          put(['depth] (pails/n 4))
      judged (fixture/cell_tests/put pinroot pinned_config judged)
      pinned (view .z 0 pinroot.cons('x) judged)
    [(testing/nat "four standings" 4 top.nat_at(['standings] 0))
     (testing/nat "two components: a text joins what it names; a thing nothing names stands apart" 2 top.nat_at(['components] 0))
     (testing/nat "one island" 1 top.nat_at(['islands] 0))
     (testing/text "the first standing opens under the first virtual root" "0x01" ((graph_workspace_tests/record_at first.weld(property) page).txt_at(['world])))
     (testing/nat "the text that names the standing is a folder beneath it, under the slot its prose sits in" 1 ((graph_workspace_tests/record_at mentioned page).nat_at(['count] 0)))
     (testing/nat "the hop says the text itself holds the name" 1 held)
     (testing/nat "the island stands under a root of its own" 1 (? (maybe/is_some (graph_workspace_tests/record_at second.weld(apart) page).get(['standing])) 1 0))
     (testing/nat "a same judgement joins the island on the next live read" 1 (graph_workspace_tests/root live).nat_at(['components] 0))
     (testing/nat "pinned at the epoch before the judgement, the island still stands" 2 (graph_workspace_tests/root pinned).nat_at(['components] 0))
     (testing/nat "pinned, the text that names the standing is still a folder beneath it" 1 ((graph_workspace_tests/record_at mentioned pinned).nat_at(['count] 0)))]

+ tests
  ^ row[testing/case]
  [(testing/case "several standings as one picture" graph_workspace_tests/checks)]
