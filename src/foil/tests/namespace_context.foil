- helm
- testing

' Native context dependencies and event-start conditional writes.
+ namespace_context_checks
  + initial
    ^ namespace
    = empty sov/new
      changes (axal/new[note] .none).put(['sys 'probe] (note/make myth/new))
    ?> (./accepted result) (sov/step changes 0 0 empty)
      | namespace ($x 17) empty (pin (system_publication 1 empty (pin [])))
    = [system signs] result
    | namespace ($x 17) empty (pin (system_publication system.top system (system_publication/assigned system)))
  + put
    \ writes=row[[path writ]] state=namespace
    ^ namespace
    ?> (./ok next) (grove_install/changes writes state)
      | Seq[namespace] (error (pails/t "Context fixture refused")) state
    next
  + input
    ^ path
    [($x 17) 'user 'input]
  + root
    ^ path
    [($x 17) 'user 'cell]
  + echo
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    [context input]
  + hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    | yell [] record.put(['notifications] (pails/n record.nat_at(['notifications] 0).inc))
  + context
    \ ignored=unit
    ^ row[testing/check]
    = root namespace_context_checks/root
      input namespace_context_checks/input
      hand=path [($x 17) 'gov 'watch]
      x (row/cons[iota] 'x root)
      cx (row/cons[iota] 'c x)
      wx=path [($x 17) 'user 'watch_x]
      wc=path [($x 17) 'user 'watch_context]
      bx=path [($x 17) 'user 'downstream_x]
      bc=path [($x 17) 'user 'downstream_context]
      card (myth/sing bond/weft (cell namespace_context_checks/echo)).put(bond/tack (safe 0 .x input))
      waiter (myth/sing limb_slot (kook [hand]))
      state (namespace_context_checks/put
        [[hand (writ/make (myth/sing system_vocabulary/form def_form.set_hear(namespace_context_checks/hear)))]
         [input (writ/make (myth/sing ['value] (pails/n 1)))]
         [root (writ/make card)]
         [wx (writ/make waiter.put(crew_slot (cpail (crew/sing ['seen] (dep .x x)))))]
         [wc (writ/make waiter.put(crew_slot (cpail (crew/sing ['seen] (dep .x cx)))))]
         [bx (writ/make card.put(bond/tack (safe 0 .x x)))]
         [bc (writ/make card.put(bond/tack (safe 0 .x cx)))]] namespace_context_checks/initial)
      changed (namespace_context_checks/put [[input (writ/poke (myth/sing ['value] (pails/n 2)))]] state)
      count namespace_context_checks/count
      reader (sovereign_reader changed)
      px (xv_trigger_reader (row/cons[iota] 'x bx) reader)
      pc (xv_trigger_reader (row/cons[iota] 'x bc) reader)
      observes
        \ dependencies=row[dep]
        ^ bool
        | dependencies.any((\ d (equal[path] d.p input)))
    [(testing/nat "x watcher fires on input change" 1 (gt (count wx changed) (count wx state)))
     (testing/nat "context watcher fires on input change" 1 (gt (count wc changed) (count wc state)))
     (testing/nat "downstream x cell inherits source trigger" 1 (observes px))
     (testing/nat "downstream context cell inherits source trigger" 1 (observes pc))
     (testing/nat "x self-reference is recognized as a cycle" 1 (tack_cycle root .x x reader))
     (testing/nat "context self-reference is recognized as a cycle" 1 (tack_cycle root .x cx reader))
     (testing/nat "indirect context reference is recognized as a cycle" 1 (tack_cycle root .x (row/cons[iota] 'x bc) reader))]
  + target
    ^ path
    [($x 17) 'user 'guarded]
  + overlay
    \ constructor=path input=path
    ^ path
    = head=path ['o ($u 1) ($u constructor.len)]
    | head.weld(constructor).snoc(($u input.len)).weld(input)
  + count
    \ at=path state=namespace
    ^ nat
    | (sovereign_care .x at state).fil.fall(myth/new).nat_at(['notifications] 0)
  + accepted
    \ reply=feet/task[unit]
    ^ bool
    ?> (./ack error) reply .false
    | maybe/is_none error
  + reflect_input
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some record) input.fil [context input]
    | [context.put(['input_value] record.pail_at(['value])) input]
  + secondary
    \ context=myth input=axal[myth]
    ^ [myth axal[myth]]
    ?> view=cell_view context.pail_at(['views 'context]) [context input]
    | [context (unpin view.tree)]
  + overlays
    \ ignored=unit
    ^ row[testing/check]
    = input namespace_context_checks/input
      root namespace_context_checks/root
      cx=path (row/cons[iota] 'c (row/cons[iota] 'x root))
      identity=path [($x 17) 'lib 'identity]
      secondary=path [($x 17) 'lib 'secondary]
      primary (namespace_context_checks/overlay identity cx)
      side (namespace_context_checks/overlay secondary [($x 17) 'user 'other])
      hand=path [($x 17) 'gov 'watch]
      direct=path [($x 17) 'user 'watch_direct]
      wp=path [($x 17) 'user 'watch_primary]
      ws=path [($x 17) 'user 'watch_secondary]
      waiter (myth/sing limb_slot (kook [hand]))
      state (namespace_context_checks/put
        [[input (writ/make (myth/sing ['value] (pails/n 1)))]
         [[($x 17) 'user 'other] (writ/make myth/new)]
         [root (writ/make ((myth/sing bond/weft (cell namespace_context_checks/reflect_input)).put(bond/tack (safe 0 .x input))))]
         [identity (writ/make (myth/sing bond/weft (dyed (\ record=myth record) .none)))]
         [secondary (writ/make ((myth/sing bond/weft (cell namespace_context_checks/secondary)).put(['context] (safe 0 .x cx))))]
         [hand (writ/make (myth/sing system_vocabulary/form def_form.set_hear(namespace_context_checks/hear)))]
         [direct (writ/make waiter.put(crew_slot (cpail (crew/sing ['seen] (dep .x cx)))))]
         [wp (writ/make waiter.put(crew_slot (cpail (crew/sing ['seen] (dep .x primary)))))]
         [ws (writ/make waiter.put(crew_slot (cpail (crew/sing ['seen] (dep .x side)))))]] namespace_context_checks/initial)
      changed (namespace_context_checks/put [[input (writ/poke (myth/sing ['value] (pails/n 2)))]] state)
      unrelated (namespace_context_checks/put [[[($x 17) 'user 'unrelated] (writ/make myth/new)]] changed)
      value
        \ at=path state=namespace
        ^ nat
        | (sovereign_care .x at state).fil.fall(myth/new).nat_at(['input_value] 0)
      watches
        \ at=path
        ^ bool
        | (o_trigger_reader at (sovereign_reader state)).any((\ d (equal[path] d.p input)))
      count namespace_context_checks/count
    [(testing/nat "primary context overlay initially reads evidence" 1 (value primary state))
     (testing/nat "secondary context overlay initially reads evidence" 1 (value side state))
     (testing/nat "primary context overlay reads changed evidence" 2 (value primary changed))
     (testing/nat "secondary context overlay reads changed evidence" 2 (value side changed))
     (testing/nat "direct context hand wakes" 1 (gt (count direct changed) (count direct state)))
     (testing/nat "primary context overlay hand wakes" 1 (gt (count wp changed) (count wp state)))
     (testing/nat "secondary context overlay hand wakes" 1 (gt (count ws changed) (count ws state)))
     (testing/nat "primary context overlay inherits evidence trigger" 1 (watches primary))
     (testing/nat "secondary context overlay inherits evidence trigger" 1 (watches side))
     (testing/nat "unrelated write leaves overlay hands cool" 1
       (and (eq (count wp changed) (count wp unrelated)) (eq (count ws changed) (count ws unrelated))))
     (testing/nat "overlay reads and reactions preserve prior evidence on every axis" 1
       (row/all[care] (\ axis=care (equal (namespace/page axis state.case(axis input) input state)
         (namespace/page axis state.case(axis input) input changed))) [.x .y .z]))]
  + emit_guard
    \ b=bowl record=myth input=myth
    ^ yell
    = update (myth/sing ['value] (pails/n 99)).put(if_case_slot input.pail_at(['expected]))
    | yell [[namespace_context_checks/target (writ/poke update)]] record
  + guarded
    \ ignored=unit
    ^ row[testing/check]
    = target namespace_context_checks/target
      hand=path [($x 17) 'gov 'emit_guard]
      trigger=path [($x 17) 'user 'emitter]
      state (namespace_context_checks/put
        [[target (writ/make (myth/sing ['value] (pails/n 1)))]
         [hand (writ/make (myth/sing system_vocabulary/form def_form.set_talk(namespace_context_checks/emit_guard)))]
         [trigger (writ/make (myth/sing limb_slot (kook [hand])))]] namespace_context_checks/initial)
      stale state.case(.x target).fall(0).inc
      index (sovereign_hive state)
      guarded (myth/sing ['value] (pails/n 99)).put(if_case_slot (pails/n stale))
      [refused ri direct] (helm/supervisor/step target (writ/poke guarded) 0 0 state index)
      [emitted ei reply] (helm/supervisor/step trigger (writ/poke (myth/sing ['expected] (pails/n stale))) 0 0 state index)
      [fresh fi fresh_reply] (helm/supervisor/step trigger (writ/poke (myth/sing ['expected] (pails/n stale.dec))) 0 0 state index)
      [batch bi batch_reply] (helm/supervisor/steps
        [[target (writ/poke ((myth/sing ['value] (pails/n 22)).put(if_case_slot (pails/n stale.dec))))]
         [trigger (writ/poke (myth/sing ['expected] (pails/n stale.dec)))]] 0 0 state index)
      [future future_index future_reply] (helm/supervisor/steps
        [[target (writ/poke ((myth/sing ['value] (pails/n 22)).put(if_case_slot (pails/n stale.dec))))]
         [trigger (writ/poke (myth/sing ['expected] (pails/n stale)))]] 0 0 state index)
      after (sovereign_care .x target emitted).fil.fall(myth/new)
      saved (sovereign_care .x target fresh).fil.fall(myth/new)
      accepted namespace_context_checks/accepted
    [(testing/nat "submitted stale if_case refuses" 0 (accepted direct))
     (testing/nat "direct refusal retains world" 1 (equal[namespace] refused state))
     (testing/nat "emitted stale if_case refuses" 0 (accepted reply))
     (testing/nat "emitted stale write retains target" 1 after.nat_at(['value] 0))
     (testing/nat "emitted stale refusal preserves namespace" 1 (equal[namespace] state emitted))
     (testing/nat "emitted stale refusal preserves index" 1 (equal[hive] index ei))
     (testing/nat "emitted current if_case succeeds" 1 (accepted fresh_reply))
     (testing/nat "emitted current write changes target" 99 saved.nat_at(['value] 0))
     (testing/nat "emitted current guard is consumed" 0 saved.has(if_case_slot))
     (testing/nat "same-event submitted and emitted guards share the starting case" 1 (accepted batch_reply))
     (testing/nat "same-event emitted write follows the submitted write" 99 (sovereign_care .x target batch).fil.fall(myth/new).nat_at(['value] 0))
     (testing/nat "same-event emitted guard is consumed" 0 (sovereign_care .x target batch).fil.fall(myth/new).has(if_case_slot))
     (testing/nat "pending write cannot mint a case for an emitted guard" 0 (accepted future_reply))
     (testing/nat "stale emitted guard rolls back earlier pending write and index" 1 (and (equal[namespace] state future) (equal[hive] index future_index)))]
  + make_on_hear
    \ b=bowl record=myth news=row[dep]
    ^ yell
    = source b.crew.gut(['source] (axal/new[myth] .none)).fil.fall(myth/new)
      created (myth/sing ['value] (pails/n 7)).put(if_case_slot source.pail_at(['expected]))
    | yell [[[($x 17) 'user 'created] (writ/make created)]] record
  + guarded_hear
    \ ignored=unit
    ^ row[testing/check]
    = source=path [($x 17) 'user 'source]
      target=path [($x 17) 'user 'created]
      hand=path [($x 17) 'gov 'create]
      watcher=path [($x 17) 'user 'creator]
      first (namespace_context_checks/put
        [[hand (writ/make (myth/sing system_vocabulary/form def_form.set_hear(namespace_context_checks/make_on_hear)))]
         [watcher (writ/make ((myth/sing limb_slot (kook [hand])).put(crew_slot (cpail (crew/sing ['source] (dep .x source))))))]] namespace_context_checks/initial)
      index (sovereign_hive first)
      [created ci good] (helm/supervisor/step source (writ/make (myth/sing ['expected] (pails/n 0))) 0 0 first index)
      [refused ri bad] (helm/supervisor/step source (writ/make (myth/sing ['expected] (pails/n 1))) 0 0 first index)
      record (sovereign_care .x target created).fil.fall(myth/new)
      accepted namespace_context_checks/accepted
    [(testing/nat "hear-emitted make accepts absent case zero" 1 (accepted good))
     (testing/nat "hear-emitted make creates its target" 7 record.nat_at(['value] 0))
     (testing/nat "hear-emitted make consumes its guard" 0 record.has(if_case_slot))
     (testing/nat "hear-emitted make refuses stale case" 0 (accepted bad))
     (testing/nat "hear refusal rolls back initiating source and reaction" 1 (equal[namespace] first refused))
     (testing/nat "hear refusal preserves subscription index" 1 (equal[hive] index ri))]
+ tests
  ^ row[testing/case]
  [(testing/case "Context dependencies and cycles" namespace_context_checks/context)
   (testing/case "Overlay context dependencies" namespace_context_checks/overlays)
   (testing/case "Emitted conditional writes" namespace_context_checks/guarded)
   (testing/case "Hear-emitted conditional creation" namespace_context_checks/guarded_hear)]
