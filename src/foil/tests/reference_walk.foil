- tests/cells [at=fixture]
- tests/composition [at=fixture]
- tests/queries [at=fixture]
- view_walk
- view_cache
- testing

+ walk_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = property=path [($x 1) 'w11 'building]
      insurer=path [($x 1) 'w12 'atlas]
      claim=path [($x 1) 'w12 'claim_884]
      model=path [($x 1) 'w13 'flood_v4]
      zone=path [($x 1) 'w13 'zone_ae]
      material=path [($x 1) 'w14 'panel_7]
      supplier=path [($x 1) 'w15 'coastal_supply]
      viewroot=path [($x 1) 'property_world]
      readroot=path ['x ($x 1) 'property_world]
      seed (fixture/cell_tests/put property (myth/sing ['insured_by] (safe 0 .x insurer)) sov/new)
      seed (fixture/cell_tests/put insurer (myth/sing ['model] (safe 0 .x model)) seed)
      seed (fixture/cell_tests/put claim (myth/sing ['property] (safe 0 .x property)).put(['amount] (pails/n 1800000)) seed)
      seed (fixture/cell_tests/put model (myth/sing ['projects] (safe 0 .x zone)) seed)
      seed (fixture/cell_tests/put zone (myth/sing ['contains] (safe 0 .x property)) seed)
      seed (fixture/cell_tests/put material (myth/sing ['suitable_for] (safe 0 .x zone)).put(['supplier] (safe 0 .x supplier)) seed)
      supplier_record (myth/sing ['lead_time_days] (pails/n 90))
      seed (fixture/cell_tests/put supplier supplier_record seed)
      seed (fixture/cell_tests/put viewroot (myth/sing bond/weft (woven view_walk/get)).put(bond/tack (safe 0 .x property)).put(['depth] (pails/n 5)) seed)
      front=path ['out ($u 1) 'insured_by 'out ($u 1) 'model 'out ($u 1) 'projects]
      incoming=path ['in ($u 1) 'suitable_for ($u 3) ($x 1) 'w14 'panel_7]
      last=path ['out ($u 1) 'supplier]
      branch readroot.weld(front).weld(incoming).weld(last)
      claimbranch=path ['in ($u 1) 'property ($u 3) ($x 1) 'w12 'claim_884]
      cyclebranch=path ['out ($u 1) 'contains]
      cycle readroot.weld(front).weld(cyclebranch)
      select (view_select/slots [['lead_time_days]])
      request (view_read (safe 0 .x branch) select)
      token=pin[any] (pin 17)
      [first cache hit] (view_cache/read request (store_reader seed) seed.top token view_cache/new)
      phone (fixture/cell_tests/put supplier supplier_record.put(['phone] (pails/t "555-0100")) seed)
      [same cache ignored_phone] (view_cache/read request (store_reader phone) phone.top token cache)
      changed (fixture/cell_tests/put supplier supplier_record.put(['lead_time_days] (pails/n 180)) phone)
      [next cache reused_lead] (view_cache/read request (store_reader changed) changed.top token cache)
      pinned (fixture/composition_tests/pinned seed.top branch)
      cycle_value=bool
        ?> (./known tree) (view .x 0 cycle seed) .false
        ?> (./some record) tree.fil .false
        ?> (./some value) record.get(['sys 'view 'cycle]) .false
        ?> flag=pails/b value .false
        flag.b
      dependency=bool
        | first.observations.any
          \ observed
          | and (equal[path] observed.read.source.path supplier) (equal[view_select] observed.read.select select)
      context=bool
        ?> (./known tree) (view .x 0 ['c 'x ($x 1) 'property_world] seed) .false
        ?> (./some record) tree.fil .false
        | maybe/is_some record.get(bond/weft)
    [(testing/nat "five local worlds are navigable through references" 90 (fixture/cell_tests/nat_at ['lead_time_days] first.value))
     (testing/nat "incoming claim has an individually readable path" 1800000 (fixture/cell_tests/nat_at ['amount] (view .x 0 readroot.weld(claimbranch) seed)))
     (testing/nat "cycle is visible and bounded" 1 cycle_value)
     (testing/nat "walk observes the selected terminal slot" 1 dependency)
     (testing/nat "phone edit keeps the composed branch cached" 1 ignored_phone)
     (testing/nat "lead time edit invalidates the composed branch" 0 reused_lead)
     (testing/nat "updated branch reports the changed lead time" 180 (fixture/cell_tests/nat_at ['lead_time_days] next.value))
     (testing/nat "historical branch retains original lead time" 90 (fixture/cell_tests/nat_at ['lead_time_days] (view .x 0 pinned changed)))
     (testing/nat "query context is readable without expanding inputs" 1 context)
     (testing/nat "read-only queries do not write derived records" 0 (eq (maybe/is_some seed.idx.get(branch)) 1))]

+ tests
  ^ row[testing/case]
  [(testing/case "incremental reference composition" walk_tests/checks)]
