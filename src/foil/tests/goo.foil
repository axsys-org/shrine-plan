- grove_views
- testing

+ goo_checks
  + lines
    \ lines=row[str]
    ^ str
    | str/join (str/from_atom 10) lines
  + missing
    \ path=path
    ^ maybe[myth]
    .none
  + root
    ^ path
    ['demo]
  + renderers
    ^ row[goo/renderer]
    | goo/html_types ['lib 'grove 'types]
  + base
    ^ str
    | goo_checks/lines
      ["#import text=lib/grove/types/text"
       "#import path_type=lib/grove/types/path"
       "#import time=lib/grove/types/time"
       "#import req=sys/req"
       "#import about=sys/about"
       "#import res=sys/res"
       ""
       "recall =" "  @role" "  due: time"
       ""
       "card =" "  @role" "  #with ; recall"
       "  #or ;" "    req: text" "    about: path_type"
       "  #opt ;" "    res: text" "  record: text"
       ""
       "label =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/label"
       "  ! goo" "  record => {" "    or {"
       "      show(record.req, '/sys/slot/title)"
       "      show(record.about, '/sys/slot/title)"
       "    }" "    show(record.record, '/sys/slot/content)"
       "    show(record.due, '/sys/slot/content)" "  }"
       ""
       "front =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/req"
       "  item => {" "    present(item, '/sys/slot/label)"
       "    action(""Show"", become = '/sys/slot/res)" "  }"
       ""
       "outer =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/outer"
       "  x => { present(x, '/sys/slot/req) }"
       ""
       "edit =" "  @view" "  #on ; %/card" "  #for ; /sys/slot/edit"
       "  card => group(on = card, action = .poke, myth = {"
       "    '/sys/req = .input(card.req)"
       "    '/sys/res = .input(card.res)" "  }) {"
       "    group {" "      show(""Prompt"", '/sys/slot/label)"
       "      input('/sys/req)" "    }"
       "    group {" "      show(""Response"", '/sys/slot/label)"
       "      input('/sys/res)" "    }" "  }" ""]
  + compile
    \ source=str name=str renderers=row[goo/renderer]
    ^ either[grove/error goo/view]
    < doc (grove/parse source)
    | grove_views/compile goo_checks/root doc goo_checks/missing [] renderers name
  + built
    \ name=str
    ^ goo/view
    | either/ok_val (goo_checks/compile goo_checks/base name goo_checks/renderers)
  + error
    \ result=either[grove/error goo/view]
    ^ str
    ? result
     > (./err cause)
      ? cause
       > (grove/error/syntax span message) message
       > (grove/error/parser cause) "parser error"
     > (./ok value) "unexpected success"
  + extra
    \ lines=row[str]
    ^ str
    | str/cat_all [goo_checks/base (str/from_atom 10) (goo_checks/lines lines)]
  + reject
    \ lines=row[str]
    ^ str
    | goo_checks/error
      (goo_checks/compile (goo_checks/extra lines) "bad" goo_checks/renderers)
  + show_bad
    \ expression=str
    ^ str
    | goo_checks/reject
      ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
       (str/cat_all ["  c => { show(" expression ", '/sys/slot/content) }"])]
  + lowering
    \ ignored=unit
    ^ row[testing/check]
    = label (goo_checks/built "label")
      front (goo_checks/built "front")
      present front.children.at(0)
      or present.children.at(0)
      edit (goo_checks/built "edit")
      group edit.children.at(0)
      outer (goo_checks/built "outer")
      text outer.children.at(0).children.at(0).children.at(0).children.at(0)
    [(testing/text "compiles successfully" "unexpected success"
       (goo_checks/error (goo_checks/compile goo_checks/base "front" goo_checks/renderers)))
     (testing/text "binding is independent of role name" "item" front.binding)
     (testing/nat "role resolved" 1 (equal[path] front.role ['demo 'card]))
     (testing/nat "slot resolved" 1 (equal[path] front.slot ['sys 'slot 'req]))
     (testing/text "present retained" "present" present.constructor)
     (testing/nat "expanded children" 3 present.children.len)
     (testing/text "or retained" "or" or.constructor)
     (testing/text "text field lowers" "text" or.children.at(0).constructor)
     (testing/text "path field lowers" "link" or.children.at(1).constructor)
     (testing/text "inherited field type lowers" "time" present.children.at(2).constructor)
     (testing/nat "receiver substitution" 1
       (equal[rex] (rex/strip_spans (rex/normalize (either/ok_val (rex/parse "item.req"))))
          (rex/strip_spans or.children.at(0).arguments.at(0))))
     (testing/nat "member names not substituted" 1
       (equal[rex] (rex/strip_spans (rex/normalize (either/ok_val (rex/parse "item.record"))))
          (rex/strip_spans present.children.at(1).arguments.at(0))))
     (testing/nat "nested presentation substitution" 1
       (equal[rex] (rex/strip_spans (rex/normalize (either/ok_val (rex/parse "x.req"))))
          (rex/strip_spans text.arguments.at(0))))
     (testing/nat "style preserved" 1
       (equal[rex] label.children.at(0).children.at(0).arguments.at(1)
         or.children.at(0).arguments.at(1)))
     (testing/text "action retained" "action" front.children.at(1).constructor)
     (testing/nat "action named argument retained" 2 front.children.at(1).arguments.len)
     (testing/text "group constructor" "group" group.constructor)
     (testing/nat "group arguments" 3 group.arguments.len)
     (testing/nat "nested groups" 2 group.children.len)
     (testing/text "literal lowers" "text" group.children.at(0).children.at(0).constructor)
     (testing/text "input retained" "input" group.children.at(1).children.at(1).constructor)
     (testing/nat "source location retained" 1 (gt or.children.at(0).span.line 20))]
  + diagnostics
    \ ignored=unit
    ^ row[testing/check]
    [(testing/text "missing receiver" "View requires one #on role."
       (goo_checks/reject ["bad =" "  @view" "  #for ; /bad" "  c => {} "]))
     (testing/text "missing slot" "View requires one #for slot."
       (goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  c => {} "]))
     (testing/text "missing view"
       "Missing view for role and slot; reflection fallback is not implemented."
       (goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => { present(c, '/unknown) }"]))
     (testing/text "competing views"
       "Competing views for role and slot; precedence is not defined."
       (goo_checks/reject ["duplicate =" "  @view" "  #on ; %/card"
         "  #for ; /sys/slot/label" "  other => {}" ""
         "bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => { present(c, '/sys/slot/label) }"]))
     (testing/text "cyclic presentation" "Cyclic view presentation."
       (goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => { present(c, '/bad) }"]))
     (testing/text "unknown field" "Unknown or ambiguous role field."
       (goo_checks/show_bad "c.unknown"))
     (testing/text "unbound receiver" "Unbound Goo value."
       (goo_checks/show_bad "wrong.req"))
     (testing/text "unknown native type" "No native UI constructor for this type."
       (goo_checks/error (goo_checks/compile goo_checks/base "label" [])))
     (testing/text "show arity" "show/present require a value and slot, with no explicit children."
       (goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => { show(c.req) }"]))
     (testing/text "unknown constructor" "Unknown Goo constructor."
       (goo_checks/reject ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
         "  c => { typo(c.req) }"]))]

  + registry
    \ ignored=unit
    ^ row[testing/check]
    = custom (goo/renderer ['lib 'grove 'types 'text] "rich_text")
    = standard goo_checks/renderers
    = renderers standard.drop(1).snoc(custom)
    = result (goo_checks/compile goo_checks/base "front" renderers)
    = view (either/ok_val result)
    = competing (goo_checks/compile goo_checks/base "front" standard.snoc(custom))
    = doc
        | either/ok_val
          (grove/parse (goo_checks/lines
            ["#import external=library/card" ""
             "front =" "  @view" "  #on ; external" "  #for ; /label"
             "  item => { show(item.req, '/title) }"]))
    = imported
        | goo/role ['library 'card]
          [(goo/field "req" ['sys 'req] ['lib 'grove 'types 'text] .true)]
    = remote
        | grove_views/compile goo_checks/root doc goo_checks/missing
            [imported] goo_checks/renderers "front"
    = remote_view (either/ok_val remote)
    [(testing/text "custom renderer compiles" "unexpected success" (goo_checks/error result))
     (testing/text "native constructor comes from type registry" "rich_text"
       view.children.at(0).children.at(0).children.at(0).constructor)
     (testing/text "competing renderers rejected" "Competing native UI constructors for this type."
       (goo_checks/error competing))
     (testing/text "imported role compiles" "unexpected success" (goo_checks/error remote))
     (testing/text "imported optional field lowers" "text" remote_view.children.at(0).constructor)
     (testing/text "missing imported type information"
       "Unknown role; imported roles require field type information."
       (goo_checks/error (grove_views/compile goo_checks/root doc goo_checks/missing
           [] goo_checks/renderers "front")))]
  + recursion
    \ ignored=unit
    ^ row[testing/check]
    [(testing/text "mutual presentation cycle" "Cyclic view presentation."
       (goo_checks/reject
         ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
          "  one => { present(one, '/other) }" ""
          "other =" "  @view" "  #on ; %/card" "  #for ; /other"
          "  two => { present(two, '/bad) }"]))
     (testing/text "role inheritance cycle" "Cyclic role inheritance."
       (goo_checks/reject
         ["cyclic =" "  @role" "  #with ; cyclic" ""
          "bad =" "  @view" "  #on ; %/cyclic" "  #for ; /bad"
          "  c => {}"]))
     (testing/text "duplicate #on" "Duplicate #on on view."
       (goo_checks/reject
         ["bad =" "  @view" "  #on ; %/card" "  #on ; %/card"
          "  #for ; /bad" "  c => {}"]))
     (testing/text "explicit present children rejected"
       "show/present require a value and slot, with no explicit children."
       (goo_checks/reject
         ["bad =" "  @view" "  #on ; %/card" "  #for ; /bad"
          "  c => { present(c, '/sys/slot/label) { text(c.req) } }"]))
     (testing/text "unknown entry" "Unknown entry view."
       (goo_checks/error (goo_checks/compile goo_checks/base "missing" goo_checks/renderers)))]

+ tests
  ^ row[testing/case]
  [(testing/case "lowering" goo_checks/lowering)
   (testing/case "diagnostics" goo_checks/diagnostics)
   (testing/case "registry" goo_checks/registry)
   (testing/case "recursion" goo_checks/recursion)]
