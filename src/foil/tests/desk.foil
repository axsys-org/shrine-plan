- helm
- net
- pass
- mesa_foot
- desk
- testing
- tests/mesa_foot [at=fixture]

' The foot's desk: asks answered with test secrets. A community, 0x18, mints
' an invitation; a world that exists claims it and is brought before the
' community; a world prepared for a place claims itself; a door is opened.
+ desk_tests
  + seed
    \ n=nat
    ^ nat
    | fixture/foot_tests/seed n
  + keys
    ' A world's three secrets, by a test number: its live seed is the one
    ' its foot was started with.
    \ live=nat custody=nat maker=nat
    ^ desk/keys
    | desk/keys live custody maker
  + run
    ' A world after its foot's desk answered one ask it held.
    \ k=desk/keys secret=nat at=path ask=myth me=fixture/foot_tests/world
    ^ namespace
    = asked=row[[p=path q=writ]] [[at (writ/make ask)]]
      had (fixture/foot_tests/apply asked me.state)
      turn (desk/answer k secret at ask had me.foot)
    | (fixture/foot_tests/settle (fixture/foot_tests/world had me.foot) turn.does).world.state
  + record
    \ at=path state=namespace
    ^ myth
    | (sovereign_care .x at state).fil.fall(myth/new)
  + done
    \ at=path state=namespace
    ^ nat
    | (desk_tests/record at state).nat_at(['done] 0)
  + minting
    \ _=unit
    ^ row[testing/check]
    = c (fixture/foot_tests/boot 18)
      k (desk_tests/keys (desk_tests/seed 18) (desk_tests/seed 180) (desk_tests/seed 181))
      other (desk_tests/keys (desk_tests/seed 18) (desk_tests/seed 180) (desk_tests/seed 182))
      at=path [($x 18) 'io 'mesa 'ask ($u 1)]
      ask=myth (myth/sing ['want] (pails/t "mint")).put(['id] (pails/n 7))
      state (desk_tests/run k 0 at ask c)
      name (desk_tests/record at state).nat_at(['name] 0)
      expected (pass/mint (desk/invitation k 7) 0 (Ed25519PublicKey (desk_tests/seed 18)))
      card=path [($x 18) 'io 'mesa ($x name)]
      again (desk_tests/run k 0 at ask (fixture/foot_tests/world state c.foot))
      nameless=myth (myth/sing ['want] (pails/t "mint"))
      bad=path [($x 18) 'io 'mesa 'ask ($u 2)]
      refused (desk_tests/run k 0 bad nameless c)
      odd=myth (myth/sing ['want] (pails/t "sing"))
      link=myth (myth/sing ['want] (pails/t "link")).put(['id] (pails/n 7))
      linked (desk_tests/run k 0 bad link c)
      waiting=row[[p=path q=writ]] [[at (writ/make ask)] [bad (writ/make nameless)]]
      held (fixture/foot_tests/apply waiting c.state)
    [(testing/nat "an invitation's secret is 32 bytes" 33 (wid (desk/invitation k 7)))
     (testing/nat "another number makes another secret" 0 (eq (desk/invitation k 7) (desk/invitation k 8)))
     (testing/nat "and so does another maker" 0 (eq (desk/invitation k 7) (desk/invitation other 7)))
     (testing/nat "an ask to mint is answered" 1 (desk_tests/done at state))
     (testing/nat "with the name the invitation's secret founds" 1 (eq name expected.name))
     (testing/nat "whose card this world keeps, with its first statement" 1 (net/held ['seq] card state))
     (testing/nat "and no address: nobody runs it yet" 0 (net/held ['port] card state))
     (testing/nat "the live key is this world's until the name is claimed" 1 (eq (Ed25519PublicKey (desk_tests/seed 18)) (net/key card state)))
     (testing/nat "asked again, the same card stands" 1 (net/held ['seq] card again))
     (testing/nat "an ask with no number is refused, and marked so" 2 (desk_tests/done bad refused))
     (testing/nat "an ask the desk does not know is refused" 2 (desk_tests/done bad (desk_tests/run k 0 bad odd c)))
     (testing/nat "an ask for an invitation's link is marked, and told nothing" 1 (desk_tests/done bad linked))
     (testing/nat "the secret is not in the record" 0 (desk_tests/record bad linked).nat_at(['secret] 0))
     (testing/nat "a link to no invitation is refused" 2 (desk_tests/done bad (desk_tests/run k 0 bad (myth/sing ['want] (pails/t "link")) c)))
     (testing/nat "two asks wait until they are answered" 2 (desk/pending ($x 18) held).len)
     (testing/nat "and an answered one waits no more" 0 (desk/pending ($x 18) state).len)]
  + claiming
    ' Bob's world, 0x17, claims the name the community minted, with the
    ' secret its door was handed and the name's founding and first
    ' statement from the invitation's page.
    \ _=unit
    ^ row[testing/check]
    = ck (desk_tests/keys (desk_tests/seed 18) (desk_tests/seed 180) (desk_tests/seed 181))
      secret (desk/invitation ck 7)
      minted (pass/mint secret 0 (Ed25519PublicKey (desk_tests/seed 18)))
      n minted.name
      w (fixture/foot_tests/boot 17)
      k (desk_tests/keys (desk_tests/seed 17) (desk_tests/seed 170) (desk_tests/seed 171))
      at=path [($x 17) 'io 'mesa 'ask ($u 1)]
      ask=myth
        . (myth/sing ['want] (pails/t "claim"))
          put(['name] (pails/n n))
          put(['form] (pails/n minted.made.form))
          put(['custody] (pails/n minted.made.custody))
          put(['dat] (pails/n minted.made.dat))
          put(['first] (pails/n (pass/sent minted.first)))
      card=path [($x 17) 'io 'mesa ($x n)]
      state (desk_tests/run k secret at ask w)
      wrong (desk_tests/run k (desk/invitation ck 8) at ask w)
      none (desk_tests/run k 0 at ask w)
      forged (desk_tests/run k secret at ask.put(['custody] (pails/n (Ed25519PublicKey (desk_tests/seed 5)))) w)
    [(testing/nat "the claim is made" 1 (desk_tests/done at state))
     (testing/nat "the claimant keeps the name's log, now two long" 2 (net/held ['seq] card state))
     (testing/nat "custody is a key the claimant derives for the name" 1 (eq (Ed25519PublicKey (desk/claimed k n)) (net/held ['custody] card state)))
     (testing/nat "and not the claimant's own custody" 0 (eq (Ed25519PublicKey k.custody) (net/held ['custody] card state)))
     (testing/nat "the live key is the claimant's" 1 (eq (Ed25519PublicKey (desk_tests/seed 17)) (net/key card state)))
     (testing/nat "another invitation's secret claims nothing" 2 (desk_tests/done at wrong))
     (testing/nat "and no card is kept" 0 (net/held ['seq] card wrong))
     (testing/nat "with no secret handed over nothing is claimed" 2 (desk_tests/done at none))
     (testing/nat "a founding that is not the name's is refused" 2 (desk_tests/done at forged))]
  + prepared
    ' A world prepared for a place runs under the minted name and claims
    ' itself: custody becomes its own. Then it is brought before the
    ' community by its own name, and its door is opened for a session.
    \ _=unit
    ^ row[testing/check]
    = secret (desk_tests/seed 900)
      host (desk_tests/seed 1)
      made (pass/mint secret 0 (Ed25519PublicKey host))
      n made.name
      self=iota ($x n)
      me (fixture/foot_tests/of n (fixture/foot_tests/pair secret host).worlds)
      k (desk_tests/keys host (desk_tests/seed 500) (desk_tests/seed 501))
      home=path [self 'io 'mesa]
      peer=path [self 'io 'mesa ($x 18)]
      at=path [self 'io 'mesa 'ask ($u 1)]
      claim=myth (myth/sing ['want] (pails/t "claim")).put(['name] (pails/n n))
      claimed (desk_tests/run k secret at claim me)
      mine (fixture/foot_tests/world claimed me.foot)
      stands (pass/held home claimed).fall((pass/standing 0 0 0 0 0 0))
      b_at=path [self 'io 'mesa 'ask ($u 2)]
      bring=myth
        . (myth/sing ['want] (pails/t "bring"))
          put(['to] (pails/n 18))
          put(['host] (pails/t "10.0.0.7"))
          put(['port] (pails/n 9100))
      brought (desk_tests/run k 0 b_at bring mine)
      letter (pass/opened (net/held ['bring] peer brought))
      holds
        ?> (./some i) letter 0
        ? (either/is_ok (pass/introduced 18 stands (pass/log home brought) i)) 1
        0
      early (desk_tests/run k 0 b_at bring me)
      early_letter (pass/opened (net/held ['bring] peer early))
      before (pass/held home me.state).fall((pass/standing 0 0 0 0 0 0))
      early_holds
        ?> (./some i) early_letter 0
        ? (either/is_ok (pass/introduced 18 before (pass/log home early) i)) 1
        0
      g_at=path [self 'io 'mesa 'ask ($u 3)]
      session (Sha256 (desk_tests/seed 77))
      grant=myth
        . (myth/sing ['want] (pails/t "grant"))
          put(['session] (pails/n session))
          put(['until] (pails/n 5000))
      granted (desk_tests/run k 0 g_at grant mine)
      g (pass/grant n session 5000 (desk_tests/record g_at granted).nat_at(['sig] 0))
      old (desk_tests/run k 0 g_at grant me)
      old_g (pass/grant n session 5000 (desk_tests/record g_at old).nat_at(['sig] 0))
      spent=myth claim.put(['handed] (pails/n 4))
      left (desk_tests/run k secret at spent me)
    [(testing/nat "a prepared world claims itself" 1 (desk_tests/done at claimed))
     (testing/nat "its own card moves to the claim" 2 stands.seq)
     (testing/nat "and custody is its own custody seed" 1 (eq (Ed25519PublicKey k.custody) stands.custody))
     (testing/nat "with another secret it claims nothing" 2 (desk_tests/done at (desk_tests/run k (desk_tests/seed 901) at claim me)))
     (testing/nat "it is brought before the community: the ask is answered" 1 (desk_tests/done b_at brought))
     (testing/nat "and its card for the community holds an introduction that the community will take" 1 holds)
     (testing/nat "before the claim, its custody seed signs nothing the community would take" 0 early_holds)
     (testing/nat "an introduction needs an address" 2 (desk_tests/done b_at (desk_tests/run k 0 b_at bring.put(['port] (pails/n 0)) mine)))
     (testing/nat "its door is opened for a session" 1 (desk_tests/done g_at granted))
     (testing/nat "by a grant its own log bears out" 1 (? (either/is_ok (pass/allowed n stands 1000 g)) 1 0))
     (testing/nat "a grant its custody seed made before the claim opens nothing" 0 (? (either/is_ok (pass/allowed n before 1000 old_g)) 1 0))
     (testing/nat "an answered ask that was handed a secret is listed until the secret is gone" 1 (desk/used self left).len)
     (testing/nat "and one that was handed none is not" 0 (desk/used self claimed).len)]

+ tests
  ^ row[testing/case]
  [(testing/case "an invitation is minted when a record asks" desk_tests/minting)
   (testing/case "a world claims a name that is not its own" desk_tests/claiming)
   (testing/case "a prepared world claims itself, is brought, and opens its door" desk_tests/prepared)]
