- lain_peek
- testing
- tests/namespace [at=fixture]

+ tree_projection_tests
  + keep
    \ value=nat
    ^ maybe[nat]
    ? (lt value 100) .none
    | ./some value.inc

  + checks
    \ ignored=unit
    ^ row[testing/check]
    = source
        | (row/range 0 128).fold (axal/new[nat] (./some 999))
        \ tree n
        | tree.put [($u n) 'leaf] n
      projected (source.filter_map(tree_projection_tests/keep))
      expected
        | (row/range 100 128).fold (axal/new[nat] (./some 1000))
        \ tree n
        | tree.put [($u n) 'leaf] n.inc
      revived projected.put([($u 1) 'leaf] 42)
      empty=axal[nat] (source.filter_map((\ value .none)))
    [(testing/nat "projected values and order" 1 (equal expected.tap projected.tap))
     (testing/nat "dead branches removed from child keys" 1
       (equal expected.kid_keys projected.kid_keys))
     (testing/nat "live branch lookup across empty B-tree partitions" 128
       (projected.gut([($u 127) 'leaf] 0)))
     (testing/nat "insert into a pruned B-tree partition" 42
       (revived.gut([($u 1) 'leaf] 0)))
     (testing/nat "projected child count" 28 projected.kid.size)
     (testing/nat "empty projection has no children" 0 empty.kid.size)
     (testing/nat "empty projection has no root value" 1 (maybe/is_none empty.fil))]

  + reference
    \ epoch=nat root=path history=sov
    ^ axal[saga]
    | history.idx.dip(root).tap.fold (axal/new[saga] .none)
    \ out [relative held]
    > (./some record) (ass/saga epoch (unpin held.held)) out
    | out.put relative record

  + histories
    \ ignored=unit
    ^ row[testing/check]
    = first (fixture/namespace_tests/seed ['a 'gone 'leaf] 1 sov/new)
      second (fixture/namespace_tests/seed ['a 'hollow 'live] 2 first)
      later
        ? (sov/step ((axal/new[note] .none).put(['a 'gone] (note/cull))) 0 0 second)
         > (./accepted result)
           = [next signs] result
           next
         > (./rejected _) second
      old (namespace/records second.top ['a] later)
      current (namespace/records later.top ['a] later)
      wanted_old (tree_projection_tests/reference second.top ['a] later)
      wanted_current (tree_projection_tests/reference later.top ['a] later)
      read (peek ['a] later)
    [(testing/nat "cull fixture committed" second.top.inc later.top)
     (testing/nat "historical records survive a later cull" 1
       (equal wanted_old.tap old.tap))
     (testing/nat "current projection removes tombstones" 1
       (equal wanted_current.tap current.tap))
     (testing/nat "dead structural branch is absent" 1 (equal[row[iota]] ['hollow] current.kid_keys))
     (testing/nat "committed dependency matches live records" 1
       (equal (wanted_current.run((\ record (unpin record.myth)))).tap read.tap))
     (testing/nat "committed dependency prunes dead branch" 1 (equal[row[iota]] ['hollow] read.kid_keys))
     (testing/nat "unasserted parent retains live descendant" 1 read.wyt)]

+ tests
  ^ row[testing/case]
  [(testing/case "structural tree projection" tree_projection_tests/checks)
   (testing/case "historical tree projection" tree_projection_tests/histories)]
