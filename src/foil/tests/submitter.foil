- helm
- testing
- tests/namespace [at=fixture]

' For an outside write, the journal keeps the foot that submitted it. A foot
' does not say who it is. The supervisor's endpoint for the foot adds the path
' where the foot was registered.
+ submitter_tests
  + initial
    ^ namespace
    | namespace ($x 17) sov/new (fixture/namespace_tests/initial).system
  + by
    ' The journal says who submitted the event of an epoch. This function
    ' gives that answer.
    \ epoch=nat state=namespace
    ^ path
    = none=path []
    ?> (./some record) (sovereign_care .x [state.self 'log ($u epoch)] state).fil none
    ?> (./some held) record.get(system_vocabulary/by) none
    ?> named=pails/p held none
    | named.p
  + value
    \ name=path state=namespace
    ^ nat
    | (sovereign_care .x name state).fil.fall(myth/new).nat_at(['value] 0)
  + checks
    \ _=unit
    ^ row[testing/check]
    = empty submitter_tests/initial
      door=path [($x 17) 'io 'door]
      target=path [($x 17) 'demo]
      record (myth/sing ['value] (pails/n 42))
      other (myth/sing ['value] (pails/n 43))
      [made index ack]
        | helm/supervisor/handle
          (helm/card/sent door (helm/card/step target (writ/make record)))
          empty (sovereign_hive empty)
      [later later_index later_ack]
        | helm/supervisor/handle
          (helm/card/step target (writ/poke other)) made index
      plan
        \ now=namespace
        ^ either[iota row[[p=path q=writ]]]
        | either/ok[iota row[[p=path q=writ]]] [[target (writ/poke record)]]
      finish
        \ outcome=maybe[pail] now=namespace
        ^ [nat str str]
        [200 "" ""]
      [last last_index last_ack]
        | helm/supervisor/handle
          (helm/card/sent door (helm/card/admit 7 plan finish)) later later_index
      wrapped
        ?> (./some card) (feet/gift/normalize door (feet/gift/poke target (writ/make record))) 0
        ?> sent=helm/card/sent card 0
        | equal[path] sent.by door
      reading
        ?> (./some card) (feet/gift/normalize door (feet/gift/peek target)) 0
        ?> sent=helm/card/sent card 1
        0
    [(testing/nat "the write is made" 42 (submitter_tests/value target made))
     (testing/nat "the journal names the foot that submitted it" 1 (equal[path] door (submitter_tests/by made.local.top made)))
     (testing/nat "a write no foot submitted names none" 0 (submitter_tests/by later.local.top later).len)
     (testing/nat "a planned admission names its foot too" 1 (equal[path] door (submitter_tests/by last.local.top last)))
     (testing/nat "and is made" 42 (submitter_tests/value target last))
     (testing/nat "the endpoint gives a foot's write the path it is registered at" 1 wrapped)
     (testing/nat "a read carries none" 1 reading)]

+ tests
  ^ row[testing/case]
  [(testing/case "the journal keeps who submitted a write" submitter_tests/checks)]
