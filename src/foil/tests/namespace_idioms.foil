- namespace
- stdlib/base

+  namespace_idioms
  +  paths
    \ ignored=unit
    ^ row[testing/check]
    =   local=maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
      (./some [.x 2 0 ['target] ['child]])
    =   epoch=maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
      (./some [.z 1 17 ['target] []])
    =   overlay=maybe[[c=nat op=path dp=path rel=path]]
      (./some [2 ['fn] ['data] ['child]])
    =   bad_history=row[path]
      [['h 'x] ['h 'bad ($u 1) ($u 0)]
       ['h 'x ($u 0) ($u 0)] ['h 'x 'e0 ($u 0)]
       ['h 'x 'no_epoch ($u 0)] ['h 'x ($u 1) ($u 2) 'one]]
    =   bad_overlay=row[path]
      [['o] ['o ($u 0) ($u 0) ($u 0)]
       ['o 'bad ($u 0) ($u 0)] ['o ($u 1) ($u 2) 'one]
       ['o ($u 1) ($u 0) 'bad]
       ['o ($u 1) ($u 0) ($u 2) 'one]]
    | row/cons[testing/check]
     | testing/nat "history preserves case and relative path" 1
      | equal local (h_parse ['h 'x ($u 2) ($u 1) 'target 'child])
    | row/cons[testing/check]
     | testing/nat "epoch history uses constant case one" 1
      | equal epoch (h_parse ['h 'z 'e17 ($u 1) 'target])
    | row/cons[testing/check]
     | testing/nat "overlay preserves both paths and relative tail" 1
      | equal overlay
       | o_parse ['o ($u 2) ($u 1) 'fn ($u 1) 'data 'child]
    | row/cons[testing/check]
     | testing/nat "malformed history paths fail without a payload" 1
      (bad_history.all((\ path (maybe/is_none (h_parse path)))))
    | row/cons[testing/check]
     | testing/nat "malformed overlay paths fail without a payload" 1
      (bad_overlay.all((\ path (maybe/is_none (o_parse path)))))
    | row/cons[testing/check]
     | testing/nat "history still accepts an explicit root target" 1
      | maybe/is_some (h_parse ['h 'x ($u 1) ($u 0)])
    | row/cons[testing/check]
     | testing/nat "overlay still accepts explicit empty paths" 1
      | maybe/is_some (o_parse ['o ($u 1) ($u 0) ($u 0)])
    []

  +  watchers
    \ ignored=unit
    ^ row[testing/check]
    = first=row[dep] [(dep .x ['one]) (dep .y ['two]) (dep .x ['one])]
    = second=row[dep] [(dep .z ['one])]
    = untouched=row[dep] [(dep .x ['sleeping])]
    =   watchers=eyes
      . (axal/new[row[dep]] .none)
       put(['a] first)
       put(['b] second)
       put(['c] untouched)
    = signs (axal/new[sign] .none).put(['a] (sign 1 0 0))
    = [news rest] (react signs watchers)
    = expected_hot=row[dep] [(dep .x ['one]) (dep .x ['one])]
    = expected_cool=row[dep] [(dep .y ['two])]
    = inverted (invert watchers)
    =   expected_inverse=row[dep]
      [(dep .x ['a]) (dep .x ['a]) (dep .z ['b])]
    =   expected_flues=row[flue]
      [(flue ['a] ['a] (./hear first))
       (flue ['b] ['b] (./hear second))
       (flue ['c] ['c] (./hear untouched))]
    | row/cons[testing/check]
     | testing/nat "firing preserves duplicate watcher order" 1
      | equal expected_hot news.get(['a]).fall([])
    | row/cons[testing/check]
     | testing/nat "unfired care stays subscribed" 1
      | equal expected_cool rest.get(['a]).fall([])
    | row/cons[testing/check]
     | testing/nat "unsigned paths retain their subscriptions" 1
      | equal second rest.get(['b]).fall([])
    | row/cons[testing/check]
     | testing/nat "only signed paths produce news" 1
      news.tap.len
    | row/cons[testing/check]
     | testing/nat "inversion preserves care, order and duplicates" 1
      | equal expected_inverse inverted.get(['one]).fall([])
    | row/cons[testing/check]
     | testing/nat "hear commands keep canonical path order" 1
      | equal expected_flues (hear_flues watchers)
    []

  +  lens_checks
    \ ignored=unit
    ^ row[testing/check]
    = original (dep .y ['virtual])
    =   first=row[[tc=care od=dep w=path]]
      [[.x original ['one]] [.y original ['cold]]
       [.x original ['one]]]
    = second=row[[tc=care od=dep w=path]] [[.z original ['two]]]
    =   indexed=lens
      . (axal/new[row[[tc=care od=dep w=path]]] .none)
       put(['a] first)
       put(['b] second)
    =   signs
      . (axal/new[sign] .none)
       put(['a] (sign 1 0 0))
       put(['b] (sign 0 0 1))
    = news (react_lens signs indexed)
    = expected=row[dep] [(dep .y ['one]) (dep .y ['two])]
    | row/cons[testing/check]
     | testing/nat "lens triggers deduplicate in first-seen order" 1
      | equal expected news.get(['virtual]).fall([])
    | row/cons[testing/check]
     | testing/nat "lens news uses the original dependency path" 1
      news.tap.len
    []

  +  contracts
    \ ignored=unit
    ^ row[testing/check]
    = open=curbs (mop/empty)
    = writes open.put(['typed] [])
    = rules (lash open writes [[['required]]] 0 0)
    = base (myth/sing system_vocabulary/lash rules)
    = type_error=maybe[iota] (./some 'curb_type)
    = need_error=maybe[iota] (./some 'curb_need)
    = both base.put(['typed] (pails/n 7))
    = complete base.put(['required] (pails/n 9))
    | row/cons[testing/check]
     | testing/nat "type failure takes priority over missing slots" 1
      | equal type_error (fit_check both)
    | row/cons[testing/check]
     | testing/nat "an absent constrained slot is allowed" 1
      | equal need_error (fit_check base)
    | row/cons[testing/check]
     | testing/nat "satisfied presence groups pass" 1
      | maybe/is_none (fit_check complete)
    | row/cons[testing/check]
     | testing/nat "records without contracts remain unrestricted" 1
      | maybe/is_none (fit_check myth/new)
    []

+  tests
  ^ row[testing/case]
  [
   (testing/case "derived path guards" namespace_idioms/paths)
   (testing/case "watcher fold ordering" namespace_idioms/watchers)
   (testing/case "lens deduplication" namespace_idioms/lens_checks)
   (testing/case "contract checks" namespace_idioms/contracts)]
