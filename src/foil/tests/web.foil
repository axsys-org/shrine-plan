-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  chore [order=70]
-  fetch [order=71]
-  http [order=72]
-  web [order=80]
'  Web rendering and responder fixtures, independent of the demo apps.
+  web_tests
  +  record
    \ n=nat
    ^ myth
    . (myth/new)
      put(['message] (pails/t "<script>& text"))
      put(['module] (pails/t "example"))
      put(['path] (pails/p ['other]))
      put(bond/help (lore "Example" ["Example" "Some <docs>"] [["(add 1 1)" "2"]]))
      put(['n] (pd n))
      put(bond/lede (pails/t "Example"))
  +  page
    \ history=bool
    ^ nat
    = target=path
        ? history ['h 'x ($u 1) ($u 1) 'example]
        ['example]
      view (axal/new[myth] (./some (web_tests/record 3)))
      view view.put(['child] (myth/sing bond/lede (pails/t "A child")))
      versions
        . (myth/new)
          put(['x_data] (pails/t "2"))
          put(['y_data] (pails/t "1"))
          put(['z_data] (pails/t "1"))
      ver (axal/new[myth] (./some versions))
    | explorer/page target view ver []
  +  missing
    \ n=nat
    ^ nat
    | explorer/page [] (axal/new[myth] .none) (axal/new[myth] .none) []
  +  fragment
    \ kind=nat
    ^ [status=nat body=nat]
    = card=myth
        ? (eq kind 0) (frag/html "div" [] [(weft/tx "<hello>&")])
        ? (eq kind 1) (myth/sing ['html] (pd 7))
        myth/new
      views=mop[path axal[myth] lt_pith] (mop/empty)
      views
        ? (eq kind 3) views
        views.put(['view] (axal/new[myth] (./some card)))
      b (bowl [] ['request] 0 0 (axal/new[myth] .none) views)
      result (frag/talk b myth/new myth/new).out
    [result.nat_at(['res_status] 0) result.nat_at(['res_body] 0)]
  +  op_form
    \ n=nat
    ^ nat
    = behavior
        \ input=myth cur=myth
        ^ myth
        cur
      o (op 'update 'item [[['when] "nat"] [['value] "<text>"]] 'item "Change it" behavior)
    | weft/render (explorer/op_form ['example] [['example 'op 'update] o])
  +  slot
    \ n=nat
    ^ nat
    | weft/render (explorer/slot_val ['message] (pails/t "<script>& text"))
  +  zoo
    \ n=nat
    ^ nat
    = card
        . (web_tests/record n)
          put(['part] (pails/p ['example 'weft 'card]))
          put(['demo] (pails/p ['example 'data]))
          put(['kind] (pails/t "dyed"))
    | zoo/page1 'example card
  +  structured_slots
    \ n=nat
    ^ row[nat]
    = values=row[pail]
        [(pails/p ['other])
         (pails/ps [['one] ['two]])
         (cpail (crew/sing ['source] (dep .y ['other])))
         (kook [['one] ['two]])]
      render
        \ held=pail
        ^ nat
        | weft/render (explorer/slot_val ['slot] held)
    values.map(render)
  +  forms
    \ n=nat
    ^ nat
    | weft/render_many (explorer/forms ['boot 'example] "<source>&")
  +  scrubber
    \ n=nat
    ^ nat
    | weft/render (frag/scrubber 0 n)

-  testing [order=100]

+  web_checks
  \ _=unit
  ^ row[testing/check]
  = live (web_tests/page 0)
  = history (web_tests/page 1)
  = op (web_tests/op_form 0)
  = zoo (web_tests/zoo 0)
  = slots (web_tests/structured_slots 0)
  = forms (web_tests/forms 0)
  = scrub (web_tests/scrubber 9)
  [
  (testing/nat "check 1" 1 (cord/has "sh-triptych" live))
  (testing/nat "check 2" 1 (cord/has "&lt;script&gt;&amp; text" live))
  (testing/nat "check 3" 1 (cord/has "Some &lt;docs&gt;" live))
  (testing/nat "check 4" 1 (cord/has "/vine/example" live))
  (testing/nat "check 5" 1 (cord/has "/example/child" live))
  (testing/nat "check 6" 0 (cord/has "/vine/" history))
  (testing/nat "check 7" 1 (cord/has "view live" history))
  (testing/nat "check 8" 1 (cord/has "no record at this node"
    (web_tests/missing 0)))
  (testing/nat "check 9" 1 (equal [200 "<div>&lt;hello&gt;&amp;</div>"]
    (web_tests/fragment 0)))
  (testing/nat "check 10" 1 (equal [404 "html slot is not markup"]
    (web_tests/fragment 1)))
  (testing/nat "check 11" 1 (equal [404 "no html slot"]
    (web_tests/fragment 2)))
  (testing/nat "check 12" 1 (equal [404 "no fragment at this path"]
    (web_tests/fragment 3)))
  (testing/nat "check 13" 1 (equal "<pre>&lt;script&gt;&amp; text</pre>"
    (web_tests/slot 0)))
  (testing/nat "check 14" 1 (cord/has "/op/example" op))
  (testing/nat "check 15" 1 (cord/has "&lt;text&gt;" op))
  (testing/nat "check 16" 0 (cord/has "when" op))
  (testing/nat "check 17" 1 (cord/has
    "/frag/1/3/example/weft/card/2/example/data" zoo))
  (testing/nat "check 18" 1 (cord/has "Some &lt;docs&gt;" zoo))
  (testing/nat "check 19" 1 (cord/has "/ns/other" (slots).at(0)))
  (testing/nat "check 20" 1 (equal (slots).at(1) (slots).at(3)))
  (testing/nat "check 21" 1 (cord/has "/ns/one" (slots).at(1)))
  (testing/nat "check 22" 1 (cord/has "/ns/two" (slots).at(1)))
  (testing/nat "check 23" 1 (cord/has "care care-y" (slots).at(2)))
  (testing/nat "check 24" 1 (cord/has "/source" (slots).at(2)))
  (testing/nat "check 25" 1 (cord/has "/chore/eval/example" forms))
  (testing/nat "check 26" 1 (cord/has "/chore/save/example" forms))
  (testing/nat "check 27" 1 (cord/has "&lt;source&gt;&amp;" forms))
  (testing/nat "check 28" 1 (cord/has (cord/cat_all ["min=" 34 "1" 34])
    scrub))
  (testing/nat "check 29" 1 (cord/has (cord/cat_all ["max=" 34 "9" 34])
    scrub))
  (testing/nat "check 30" 1 (cord/has "w-scrub" scrub))
  ]

+  tests
  ^ row[testing/case]
  [(testing/case "web behavior" web_checks)]
