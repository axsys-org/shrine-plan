-  sept [order=10]
-  testing [order=20]

+  check
  \ n=nat pass=bool
  ^ testing/check
  | testing/nat (nat/show n) 1 pass

+  seed_bee
  \ tree=bee[nat] key=iota
  ^ bee[nat]
  | tree.put key (text_key key)

+  sift_next
  \ n=nat
  ^ maybe[nat]
  ? (lt 1 n) (./some n.inc)
  .none

+  text_key
  \ k=iota
  ^ nat
  ?> ($ts txt) k 0
  txt

+  as_list
  \ xs=row[nat]
  ^ list[nat]
  ? (eq xs.len 0) .nil
  | ./cons xs.at(0) (_ xs.drop(1))

+  build_uon
  \ pairs=row[[iota nat]] tree=uon[nat]
  ^ uon[nat]
  (row/fold tree (\ m=uon[nat] p=[iota nat] (uon/put (first p) (second
    p) m)) pairs)

+  seq_uon
  \ n=nat tree=uon[nat]
  ^ uon[nat]
  ? (eq n 0) tree
  | _ n.dec (tree.put(($u n) (mul 10 n)))

+  seq_uon_up
  \ n=nat tree=uon[nat]
  ^ uon[nat]
  ? (gt n 20) tree
  | _ n.inc (tree.put(($u n) n))

+  build_axal
  \ pairs=row[[path nat]] tree=axal[nat]
  ^ axal[nat]
  (row/fold tree (\ m=axal[nat] p=[path nat] (axal/put (first p) (second
    p) m)) pairs)

+  build_bee
  \ pairs=row[[iota nat]] tree=bee[nat]
  ^ bee[nat]
  (row/fold tree (\ m=bee[nat] p=[iota nat] (bee/put (first p) (second
    p) m)) pairs)

+  sorted_iota
  \ rows=row[uon/kv[nat]]
  ^ bool
  (row/all (\ i=nat (lte_iota rows.at(i).key rows.at(i.inc).key))
    (row/range 0 rows.len.dec))

+  first
  (@ a b)
  \ pair=[a b]
  ^ a
  = [x _] pair
  x
+  second
  (@ a b)
  \ pair=[a b]
  ^ b
  = [_ y] pair
  y


+  spec
  +  uon_empty (uon/del2[nat] ($u 1) (uon/sing[nat] ($u 1) 0))
  +  t5
    (build_uon [[($u 2) 20] [($ts "b") 2] [($u 1) 10] [($ta "z") 26]
      [($ts "a") 1]] spec/uon_empty)
  +  t5b (uon/put[nat] ($u 2) 99 spec/t5)
  +  t20 (seq_uon 20 spec/uon_empty)
  +  t20r (seq_uon_up 1 spec/uon_empty)
  +  t4 (uon/del2[nat] ($ts "a") spec/t5)
  +  ta (build_uon [[($u 1) 1] [($u 2) 2]] spec/uon_empty)
  +  tb (build_uon [[($u 2) 22] [($u 3) 33]] spec/uon_empty)
  +  tu (uon/uni[nat] spec/tb spec/ta)
  +  t5run (uon/run[nat nat] (add 100) spec/t5)
  +  t5gas (uon/gas[nat] (uon/tap[nat] spec/t5) spec/uon_empty)
  +  ax0 (axal/new[nat] maybe/none[nat])
  +  chat ($ts "chat")
  +  room ($ts "room")
  +  alice ($ts "alice")
  +  sys ($ts "sys")
  +  hand ($ts "hand")
  +  ns
    (build_axal [[[spec/chat spec/room] 1] [[spec/chat] 100] [[spec/sys
      spec/hand] 3] [[spec/chat spec/alice] 2]] spec/ax0)
  +  chat_sub (axal/dip[nat] [spec/chat] spec/ns)
  +  delres (uon/del[nat] ($ts "a") spec/t5)
  +  fitres (axal/fit[nat] [spec/chat spec/room ($u 7)] spec/ns)
  +  fitres2 (axal/fit[nat] [spec/chat spec/room] spec/ns)
  +  fitres3 (axal/fit[nat] [($ts "nosuch") ($u 1)] spec/ns)
  +  ns_del (axal/del[nat] [spec/chat] spec/ns)
  +  ns_lop (axal/lop[nat] [spec/chat] spec/ns)
  +  fresh
    (axal/put[nat] [] 55 (axal/put[nat] [($ts "new")] 56 spec/ax0))
  +  ns_rep (axal/rep[nat] [spec/chat] spec/fresh spec/ns)
  +  ns_gas (axal/gas[nat] (axal/tap[nat] spec/ns) spec/ax0)
  +  ns_run (axal/run[nat nat] (add 1000) spec/ns)
  +  ns_snip (axal/snip[nat] spec/ns)
  +  chat_snip (axal/snip[nat] (axal/dip[nat] [spec/chat] spec/ns))
  +  ns_rt1
    (axal/zip/top[nat] (axal/zip/up[nat] (axal/zip/down[nat] spec/chat
      (axal/zipper[nat] spec/ns))))
  +  ns_rt2
    (axal/zip/top[nat] (axal/zip/down[nat] spec/room (axal/zip/down[nat]
      spec/chat (axal/zipper[nat] spec/ns))))
  +  ns_spined
    (axal/zip/top[nat] (axal/zip/down[nat] ($ts "ghost")
      (axal/zipper[nat] spec/ns)))
  +  other
    (build_axal [[[spec/chat] 777] [[($ts "blog")] 9] [[spec/sys] 8]]
      spec/ax0)
  +  ns_uni (axal/uni[nat] spec/other spec/ns)
  +  bee_empty (bee/leaf[nat] [])
  +  bkeys40
    (row/map[nat iota] (\ i=nat ($ts (nat/show i))) (row/range 0 40))
  +  bt40
    (row/fold[iota bee[nat]] (bee/leaf[nat] [])
      seed_bee spec/bkeys40)
  +  btap40 (bee/tap[nat] spec/bt40)
  +  bt40b (bee/put[nat] ($ts (nat/show 7)) 999 spec/bt40)
  +  bmix
    (build_bee [[($u 2) 20] [($ts "b") 2] [($u 1) 10] [($ta "z") 26]
      [($ts "a") 1]] spec/bee_empty)
  +  umix
    (build_uon [[($u 2) 20] [($ts "b") 2] [($u 1) 10] [($ta "z") 26]
      [($ts "a") 1]] spec/uon_empty)
  +  bt39 (bee/del2[nat] ($ts (nat/show 3)) spec/bt40)
  +  lsp (list/split_half (as_list [1 2 3 4]))

  +  options
    \ _=unit
    ^ row[testing/check]
    [
      (check 1 (equal (maybe/then[nat nat] (\ x=nat (maybe/some (inc
        x))) (maybe/some 4)) (maybe/some 5)))
      (check 2 (equal (maybe/then[nat nat] (\ x=nat maybe/none[nat])
        (maybe/some 4)) maybe/none[nat]))
      (check 3 (equal (maybe/then[nat nat] (\ x=nat (maybe/some (inc
        x))) maybe/none[nat]) maybe/none[nat]))
    ]

