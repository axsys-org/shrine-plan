      (check 187 (equal (word_char "a") 1))
      (check 188 (equal (word_char "_") 1))
      (check 189 (equal (word_char "-") 0))
      (check 190 (equal (word_mention "home" "the home page") 1))
      (check 191 (equal (word_mention "home" "homework due") 0))
      (check 192 (equal (word_mention "ideas" "/nenex/w/ideas") 1))
    ]

  +  text
    \ _=unit
    ^ row[testing/check]
    [
      (check 193 (equal (str/cat "de" "abc") "abcde"))
      (check 194 (equal (str/cat "" "abc") "abc"))
      (check 195 (equal (str/cat "abc" "") "abc"))
      (check 196 (equal (str/cat_all ["ab" "" "cd"]) "abcd"))
      (check 197 (equal (str/cat_all []) ""))
      (check 198 (equal (str/join "," []) ""))
      (check 199 (equal (str/join "," ["a"]) "a"))
      (check 200 (equal (str/join "," ["a" "" "b"]) "a,,b"))
      (check 201 (equal (str/cat_slice "abcd" 1 3 "out") "outbc"))
      (check 202 (equal (str/cat_slice "abcd" 3 1 "out") "out"))
      (check 203 (equal (str/prefix_at "bc" 2 "aabc") (maybe/some 4)))
      (check 204 (equal (str/prefix_at "bcd" 2 "aabc") maybe/none[nat]))
      (check 205 (equal (nat/show 0) "0"))
      (check 206 (equal (nat/show 1002003) "1002003"))
      (check 207 (equal (hex/byte 0) "00"))
      (check 208 (equal (hex/byte 255) "ff"))
      (check 209 (equal (hex/read 4 1 "!0aFf?") (maybe/some 2815)))
      (check 210 (equal (hex/read 4 0 "abc") maybe/none[nat]))
      (check 211 (equal (hex/read 4 0 "0xFF") maybe/none[nat]))
      (check 212 (equal (hex/read 0 0 "") (maybe/some 0)))
      (check 213 (equal (str/snoc_utf8 65 "x") "xA"))
      (check 214 (equal (str/snoc_utf8 128 "") (cord/cat_all [194
        128])))
      (check 215 (equal (str/snoc_utf8 2047 "") (cord/cat_all [223
        191])))
      (check 216 (equal (str/snoc_utf8 2048 "") (cord/cat_all [224 160
        128])))
      (check 217 (equal (str/snoc_utf8 65535 "") (cord/cat_all [239 191
        191])))
      (check 218 (equal (str/snoc_utf8 65536 "") (cord/cat_all [240 144
        128 128])))
      (check 219 (equal (str/snoc_utf8 1114111 "") (cord/cat_all [244
        143 191 191])))
    ]

  +  decimal
    \ _=unit
    ^ row[testing/check]
    [
      (check 220 (equal (nat/parse "0") (maybe/some 0)))
      (check 221 (equal (nat/parse "00123") (maybe/some 123)))
      (check 222 (equal (nat/parse "123456789012345678901234567890")
        (maybe/some 123456789012345678901234567890)))
      (check 223 (equal (nat/parse "") maybe/none[nat]))
      (check 224 (equal (nat/parse "12x") maybe/none[nat]))
      (check 225 (equal (nat/parse "-1") maybe/none[nat]))
      (check 226 (equal (nat/parse " 1") maybe/none[nat]))
      (check 227 (equal (path/starts ($ts "x") []) 0))
      (check 228 (equal (path/starts ($ts "x") [($ts "x") ($u 2)]) 1))
      (check 229 (equal (path/starts ($ts "x") [($tu "x")]) 0))
    ]

  +  indexes
    \ _=unit
    ^ row[testing/check]
    [
      (check 230 (equal (row/has[nat] 1 []) 0))
      (check 231 (equal (row/has[nat] 2 [1 2 3]) 1))
      (check 232 (equal (row/has[row[nat]] [1 2] [[1 3] [2 1]]) 0))
      (check 233 (equal (row/has[row[nat]] [1 2] [[1 3] [1 2]]) 1))
      (check 234 (equal (uon/keys[nat] (uon/from_keys[nat] 7 [])) []))
      (check 235 (equal (uon/keys[nat] (uon/from_keys[nat] 7 [($u 2) ($u
        1) ($u 2)])) [($u 1) ($u 2)]))
      (check 236 (equal (uon/gut[nat] ($u 1) 0 (uon/from_keys[nat] 7
        [($u 1)])) 7))
    ]

  +  cords
    \ _=unit
    ^ row[testing/check]
    [
      (check 237 (equal (cord/cat "abc" "de") "abcde"))
      (check 238 (equal (cord/cat 0 "abc") "abc"))
      (check 239 (equal (cord/cat "abc" 0) "abc"))
      (check 240 (equal (cord/at "abc" 1) 98))
      (check 241 (equal (cord/at "abc" 3) 0))
      (check 242 (equal (cord/len "abc") 3))
      (check 243 (equal (cord/len 0) 0))
      (check 244 (equal (cord/eof "abc" 3) 1))
      (check 245 (equal (cord/eof "abc" 2) 0))
      (check 246 (equal (cord/slice 1 9 "abc") "bc"))
      (check 247 (equal (cord/slice 9 1 "abc") 0))
      (check 248 (equal (cord/cat_all ["a" 0 "bc" "d" 0 "e"]) "abcde"))
      (check 249 (equal (cord/cat_all []) 0))
      (check 250 (equal (cord/cat_all [256]) 256))
      (check 251 (equal (cord/len 256) 2))
      (check 252 (equal (cord/at 256 0) 0))
      (check 253 (equal (cord/at 256 1) 1))
    ]

  +  shared_text
    \ _=unit
    ^ row[testing/check]
    [
      (check 254 (equal[row[str]] (str/split_byte 47 "") [""]))
      (check 255 (equal[row[str]] (str/split_byte 47 "/a//b/") ["" "a" "" "b" ""]))
      (check 256 (equal[row[str]] (str/split_nonempty 47 "/a//b/") ["a" "b"]))
      (check 257 (equal[row[str]] (str/split_nonempty 47 "") []))
      (check 258 (equal[row[nat]] (cord/split_nonempty 47 12032) [0]))
      (check 259 (equal[nat] (cord/join "/" [0 "a" 0 "b" 0]) "/a//b/"))
      (check 260 (equal[str] (str/join "/" []) ""))
      (check 261 (equal[str] (str/repeat 0 "ab") ""))
      (check 262 (equal[str] (str/repeat 5 "ab") "ababababab"))
      (check 263 (equal[str] (str/repeat 4 "ab") "abababab"))
      (check 264 (equal[str] (str/ascii_lower "AZ az 09-_") "az az 09-_"))
      (check 265 (equal[nat] (str/to_atom (str/ascii_lower (str/from_atom 4325441))) 6422625))
      (check 266 (equal[str] (str/trim_ascii "  a b  ") "a b"))
      (check 267 (equal[str] (str/trim_ascii "   ") ""))
      (check 268 (equal[maybe[nat]] (str/find "" "") (maybe/some 0)))
      (check 269 (equal[maybe[nat]] (str/find "bc" "abcabc") (maybe/some 1)))
      (check 270 (equal[maybe[nat]] (str/find "abcd" "abc") maybe/none[nat]))
    ]

  +  map_filter
    \ _=unit
    ^ row[testing/check]
    = tree | mop/put[nat nat lt] 2 20 (mop/empty)
      tree | tree.put(1 10).put(3 30)
      kept | tree.filter (\ key val (gt val 15))
      gone | tree.del 2
    [
      (check 271 (equal kept.tap [(mop/kv[nat nat] 2 20) (mop/kv[nat nat] 3 30)]))
      (check 272 (equal gone.tap [(mop/kv[nat nat] 1 10) (mop/kv[nat nat] 3 30)]))
      (check 273 (equal tree.del(9).tap tree.tap))
      (check 274 (equal tree.filter((\ key val .false)).size 0))
      (check 275 (equal gone.put(2 99).get(2) (maybe/some 99)))
      (check 276 (equal tree.size 3))
    ]

+  tests
  ^ row[testing/case]
  [
    (testing/case "options" spec/options)
    (testing/case "ordering" spec/ordering)
    (testing/case "maps" spec/maps)
    (testing/case "paths" spec/paths)
    (testing/case "bee" spec/bee)
    (testing/case "lists" spec/lists)
    (testing/case "rows" spec/rows)
    (testing/case "words" spec/words)
    (testing/case "text" spec/text)
    (testing/case "decimal" spec/decimal)
    (testing/case "indexes" spec/indexes)
    (testing/case "cords" spec/cords)
    (testing/case "shared text" spec/shared_text)
    (testing/case "map filter" spec/map_filter)
  ]
