- ethereum_keccak
- testing
+ tests
  ^ row[testing/case]
  [(testing/case "Ethereum Keccak and bytes"
    (\ ignored=unit
      [(testing/text "empty Keccak" "0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470" (ethereum_keccak/hex []))
       (testing/text "abc Keccak" "0x4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45" (ethereum_keccak/hex (ethereum_bytes/ascii "abc")))
       (testing/text "trailing zero byte survives" "0x0100" (ethereum_bytes/hex (ethereum_bytes/unhex "0x0100")))
       (testing/text "RLP zero" "0x80" (ethereum_bytes/hex (ethereum_bytes/rlp_nat 0)))]))]
