- shrine
- shrine_types
- sept
- tests/namespace [at=fixture]
- testing

' A path written past /ass/span epochs keeps every version readable
' through its sealed past, and a clock minted past /track/span cases
' resolves every case: sealing bounds what a snapshot re-serializes
' for a touched path, never what a read answers.
+ seal_tests
  + put
    \ name=path record=myth state=sov
    ^ sov
    = diffs | (axal/new[note] .none).put name (note/make record)
    ? (sov/step diffs 0 0 state)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       next
     > (./rejected _) state
  + nat_at
    \ answer=res[myth]
    ^ nat
    ?> (./known record) answer 0
    ?> (./some held) record.get(['n]) 0
    ? held
     > n=pails/n n.n
    0
  + grow
    ' Write {n: i} at name for i in 1..count, one epoch each.
    \ name=path count=nat state=sov
    ^ sov
    % i=nat 1 s=sov state
    ^ sov
    ? (gt i count) s
    | _ i.inc (seal_tests/put name (myth/sing ['n] (pails/n i)) s)
  + resolved
    ' How many of the cases 1..count map to their epoch.
    \ base=nat count=nat tr=track
    ^ nat
    % c=nat 1 hits=nat 0
    ^ nat
    ? (gt c count) hits
    = ok
        ? (track/epoch c tr)
         > (./some ep) (? (eq ep (add base c)) 1 0)
        0
    | _ c.inc (add hits ok)
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      state0 (unpin initial.system).state
      name=path [($x 1) 'app 'seal]
      base state0.top
      count 70
      seal ass/span
      after seal.inc
      state (seal_tests/grow name count state0)
      ev state.ever_at(name)
      at
        \ i=nat
        ^ nat
        | seal_tests/nat_at state.x_at((add base i) name)
    [(testing/nat "seventy versions: the x clock reads 70" 70 ev.x.lock.data)
     (testing/nat "the latest version reads" 70 (at 70))
     (testing/nat "the first version reads, three seals down" 1 (at 1))
     (testing/nat "a version in a sealed chunk reads" 3 (at 3))
     (testing/nat "the last version before a seal reads" seal (at seal))
     (testing/nat "the first version after a seal reads" after (at after))
     (testing/nat "an epoch between versions floors to the one before" 40 (seal_tests/nat_at state.x_at((add base 40) name)))
     (testing/nat "x_query by case reaches a sealed version" 25 (seal_tests/nat_at state.x_query(25 name)))
     (testing/nat "x_query by the latest case" 70 (seal_tests/nat_at state.x_query(70 name)))
     (testing/nat "every case resolves to its epoch through the sealed clock" 70 (seal_tests/resolved base count ev.x))
     (testing/nat "the open history holds at most span entries" 1
       (? (le (tome/hist state.idx.get(name)).size ass/span) 1 0))
     (testing/nat "the open clock holds at most span cases" 1
       (? (le ev.x.epochs.size track/span) 1 0))
     (testing/nat "the clock sealed count div span chunks" (div count track/span) ev.x.past.len)]

+ tests
  ^ row[testing/case]
  [(testing/case "history_seal" seal_tests/checks)]
