- tests/cells [at=fixture]
- graph
- reference_index
- tests/namespace [at=fixture]
- testing

+ graph_tests
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = company=path [($x 1) 'user 'orgs 'mis]
      second=path [($x 1) 'peer 'user 'firms 'mckenzie]
      third=path [($x 1) 'third 'user 'companies 'mis]
      unrelated=path [($x 1) 'user 'elsewhere 'mis]
      judgement=path [($x 1) 'identities 'accepted]
      article=path [($x 1) 'user 'web 'article]
      state (fixture/cell_tests/put company (myth/sing ['name] (pails/t "MIS")) sov/new)
      state (fixture/cell_tests/put second (myth/sing ['name] (pails/t "McKenzie")).put(['lead_time] (pails/n 90)) state)
      state (fixture/cell_tests/put third (myth/sing ['name] (pails/t "MIS")) state)
      state (fixture/cell_tests/put unrelated (myth/sing ['name] (pails/t "MIS")) state)
      state (fixture/cell_tests/put company.weld(['same 'accepted]) (myth/sing ['same] (safe 0 .x second)).put(['why] (pails/t "Verified identifier")) state)
      state (fixture/cell_tests/put judgement (myth/sing ['subject] (safe 0 .x second)).put(['same] (safe 0 .x third)).put(['why] (pails/t "Verified legal entity")) state)
      state (fixture/cell_tests/put article (myth/sing ['heading] (pails/t "An article")).put(['text] (pails/t "Coverage of [/0x01/user/orgs/mis] today.")) state)
      members_plan
        | graph/view/identity [(safe 0 .x company)] (axal/new[safe] .none)
          \ members=row[safe]
          ^ view_plan
          = output
              | members.fold (axal/new[myth] .none)
                \ out=axal[myth] m=safe
                | out.put (graph/op/name m) (myth/sing ['member] m)
          | ./done output
      members
        ?> (./known value) (woven_run members_plan (store_reader state)).value (axal/new[myth] .none)
        value
      named
        ?> (./known value) (woven_read (view_read (safe 0 .z (r_spell company)) .all) (store_reader state)).value .false
        | value.tap.any
          \ [at record]
          ?> (./some holder) (graph/view/reference ['holder] record) .false
          | equal[path] holder.path article
    [(testing/nat "explicit identity assertions join three differently filed records" 3 members.tap.len)
     (testing/nat "matching text does not establish identity" 0 (maybe/is_some members.get(unrelated)))
     (testing/nat "a reference in prose is an edge the index holds" 1 named)]
  + relations
    \ ignored=unit
    ^ row[testing/check]
    = company=path [($x 1) 'user 'orgs 'mis]
      owner=path [($x 1) 'user 'orgs 'verisk]
      person=path [($x 1) 'user 'people 'forbes]
      claim=path [($x 1) 'user 'claims 'claim_884]
      article=path [($x 1) 'user 'web 'article]
      relation=path owner.weld(['acquisitions 'mis])
      assertion=path company.weld(['claims 'date])
      state (fixture/cell_tests/put company (myth/sing ['name] (pails/t "MIS")).put(['founder] (safe 0 .x person)) sov/new)
      state (fixture/cell_tests/put owner (myth/sing ['name] (pails/t "Verisk")) state)
      state (fixture/cell_tests/put person (myth/sing ['name] (pails/t "Forbes")) state)
      state (fixture/cell_tests/put relation (myth/sing ['company] (safe 0 .x company)).put(['date] (pails/t "2026-07-29")) state)
      state (fixture/cell_tests/put claim (myth/sing ['property] (safe 0 .x company)).put(['amount] (pails/n 1800000)) state)
      state (fixture/cell_tests/put article (myth/sing ['heading] (pails/t "An article")).put(['text] (pails/t "Coverage of [/0x01/user/orgs/mis] today.")) state)
      claim_record (myth/sing ['slot] (pails/t "acquired_on")).put(['value] (pails/t "2026-07-28")).put(['source] (safe 0 .x company))
      state (fixture/cell_tests/put assertion claim_record state)
      plan
        | graph/view/relations_for (safe 0 .x company)
          \ members=row[safe] edges=row[graph/view/relation]
          ^ view_plan
          = output
              | edges.fold (axal/new[myth] .none)
                \ out edge
                | out.put (graph/view/edge_name edge) (myth/sing ['other] edge.other).put(['label] (pails/p edge.label)).put(['via] edge.via)
          | ./done output
      result (woven_run plan (store_reader state))
      tree
        ?> (./known tree) result.value (axal/new[myth] .none)
        tree
      has
        \ other=path label=path
        ^ bool
        | tree.tap.any
          \ [at record]
          ?> (./some ref) (graph/view/reference ['other] record) .false
          ?> (./some actual) record.path_at(['label]) .false
          | and (equal[path] ref.path other) (equal[path] actual label)
    [(testing/nat "direct outgoing relation remains a reference" 1 (has person ['founder]))
     (testing/nat "nested relation retains its owning thing and grouping" 1 (has owner ['acquisitions]))
     (testing/nat "business claims remain visible incoming relationships" 1 (has claim ['property]))
     (testing/nat "a reference in prose is an edge, held by the text under its prose slot" 1 (has article ['text]))
     (testing/nat "a reference in prose is not a slot on the thing" 0 (has article ['mis]))
     (testing/nat "assertion records do not become domain relationships" 0 (has assertion ['source]))]
  + registry
    \ ignored=unit
    ^ row[testing/check]
    = initial fixture/namespace_tests/initial
      target=path [($x 1) 'user 'orgs 'target]
      holder=path [($x 1) 'user 'people 'person]
      viewroot=path [($x 1) 'user 'views 'overlay]
      local (fixture/cell_tests/put target (myth/sing ['name] (pails/t "Target")) initial.local)
      local (fixture/cell_tests/put holder (myth/sing ['works_at] (safe 0 .x target)) local)
      state initial.set_local(local)
      seeded graph/seeds
      installed
        | seeded.fold state
          \ acc [at record]
          | acc.set_local((fixture/cell_tests/put at.cons(($x 1)) record acc.local))
      definition=path [($x 1) 'weft 'graph 'overlay]
      version (installed.case(.x definition)).fall(0)
      config (myth/sing bond/weft (safe version .x definition)).put(bond/tack (safe 0 .x target))
      loaded installed.set_local((fixture/cell_tests/put viewroot config installed.local))
      result (sovereign_view .z 0 viewroot.cons('x) loaded)
      found
        ?> (./known tree) result .false
        | tree.tap.any
          \ [at record]
          ?> (./some source) (graph/view/reference ['at] record) .false
          | equal[path] source.path holder
    [(testing/nat "the standard woven cells are seeded at ordinary names" 1 (gt version 0))
     (testing/nat "a seeded definition names its ctor, it holds no closure" 1 (?=((./some _) (graph/by_name 'overlay))))
     (testing/nat "a cell can consume the named definition" 1 found)]

+ tests
  ^ row[testing/case]
  [(testing/case "native graph assertions and prose references" graph_tests/checks)
   (testing/case "native relation interpretation" graph_tests/relations)
   (testing/case "named graph definitions" graph_tests/registry)]
