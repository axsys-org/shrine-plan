- stdlib/runtime
- stdlib/base
+ preview_tests
  + explode
    \ n=nat
    ^ nat
    | Throw 911
  + get
    \ held=pail
    ^ value_preview/result
    ?> (./some result) (value_preview/safe held) (value_preview/result "failed" .true)
    result
  + checks
    \ ignored=unit
    ^ row[testing/check]
    = reference (preview_tests/get (safe 7 .y ['target]))
      shape (preview_tests/get (pails/ty (^ nat)))
      doc (preview_tests/get (lore "Title" ["First line" "Second line"] []))
      long_text (preview_tests/get (lore (str/repeat 40 "a ") [] []))
      boundary (value_preview/readable (str/repeat 4089 "a"))
      huge (preview_tests/get (pails/q ($x (bex 65536))))
      wide (preview_tests/get (lore "Wide" ((list/range 0 200).map((\ n=nat "example"))).row []))
      function (preview_tests/get (pails/code (pin preview_tests/explode)))
    [(testing/nat "pretty layout uses actual newlines" 1 (maybe/is_some (str/find (str/from_atom 10) doc.text)))
     (testing/nat "leaf clipping is marked" 1 long_text.clipped)
     (testing/nat "complete boundary text is not marked clipped" 0 boundary.clipped)
     (testing/nat "safe constructor remains visible" 1 (maybe/is_some (str/find "safe" reference.text)))
     (testing/nat "reference is not flattened to a path" 1 (maybe/is_some (str/find "7" reference.text)))
     (testing/text "type descriptors use type pretty printer" (str/from_atom (tyshow/pretty (^ nat))) shape.text)
     (testing/nat "lore fields appear in code" 1 (maybe/is_some (str/find "head" doc.text)))
     (testing/nat "large scalar is bounded" 1 (le huge.text.len 4096))
     (testing/nat "large scalar truncation explicit" 1 huge.clipped)
     (testing/nat "wide structure truncation explicit" 1 wide.clipped)
     (testing/nat "wide structure bounded" 1 (le wide.text.len 4096))
     (testing/nat "function is described without invocation" 1 (maybe/is_some (str/find "fn" function.text)))]
+ tests
  ^ row[testing/case]
  [(testing/case "Bounded code previews" preview_tests/checks)]
