- sys/shrine

' Publisher-owned slots follow this module's assigned publication root.
' Moving an artifact or installing an instance never changes these paths.
+ publisher_vocabulary
  + anchor
    :
  + invalid_location
    \ ignored=unit
    ^ path
    ; (error (pails/t "Publisher vocabulary has no assigned definition moment"))
    []
  + locate
    \ suffix=path
    ^ path
    = identity=nat
        ? (^ publisher_vocabulary/anchor)
         > (./ref brand arguments) brand
         > (./rec brand fields) brand
        0
    ?> (./some reference) (definition_reference/parse identity)
        (publisher_vocabulary/invalid_location [])
    | reference.path.take(reference.path.len.dec).weld suffix
  + service
    ' The bundled service registry belongs to this vocabulary's publisher.
    \ relative=path
    ^ path
    = root | publisher_vocabulary/locate []
    | row/weld relative root.take(1)
  + spec
    ^ path
    | publisher_vocabulary/locate ['spec]
  + face
    ^ path
    | publisher_vocabulary/locate ['face]
  + unreads
    ^ path
    | publisher_vocabulary/locate ['unreads]
  + grove
    + module
      ^ path
      | publisher_vocabulary/locate ['grove 'module]
    + template
      ^ path
      | publisher_vocabulary/locate ['grove 'template]
    + source
      ^ path
      | publisher_vocabulary/locate ['grove 'source]
    + seed
      ^ path
      | publisher_vocabulary/locate ['grove 'seed]
    + sewn
      ^ path
      | publisher_vocabulary/locate ['grove 'sewn]
    + norm
      ^ path
      | publisher_vocabulary/locate ['grove 'norm]
    + action
      ^ path
      | publisher_vocabulary/locate ['grove 'action]
    + role
      ^ path
      | publisher_vocabulary/locate ['grove 'role]
    + like
      ^ path
      | publisher_vocabulary/locate ['grove 'like]
  + doc
    ^ path
    | publisher_vocabulary/locate ['doc]
  + code
    ^ path
    | publisher_vocabulary/locate ['code]
  + calls
    ^ path
    | publisher_vocabulary/locate ['calls]
  + called_by
    ^ path
    | publisher_vocabulary/locate ['called_by]
  + entries
    ^ path
    | publisher_vocabulary/locate ['entries]
  + dt
    ^ path
    | publisher_vocabulary/locate ['dt]
  + version
    + state
      ^ path
      | publisher_vocabulary/locate ['version 'state]
    + x_data
      ^ path
      | publisher_vocabulary/locate ['version 'x_data]
    + x_shape
      ^ path
      | publisher_vocabulary/locate ['version 'x_shape]
    + y_data
      ^ path
      | publisher_vocabulary/locate ['version 'y_data]
    + y_shape
      ^ path
      | publisher_vocabulary/locate ['version 'y_shape]
    + z_data
      ^ path
      | publisher_vocabulary/locate ['version 'z_data]
    + z_shape
      ^ path
      | publisher_vocabulary/locate ['version 'z_shape]
    + now
      ^ path
      | publisher_vocabulary/locate ['version 'now]
    + block
      ^ path
      | publisher_vocabulary/locate ['version 'block]
    + first
      ^ path
      | publisher_vocabulary/locate ['version 'first]
    + top
      ^ path
      | publisher_vocabulary/locate ['version 'top]
  + machinery
    \ slot=path
    ^ bool
    = slots=row[path]
        [['sys 'limb] ['sys 'form] ['sys 'crew] ['sys 'lash]
         ['sys 'op] ['sys 'weft] ['sys 'tack] ['sys 'mold]
         ['sys 'req] ['sys 'res]
         publisher_vocabulary/spec publisher_vocabulary/face
         publisher_vocabulary/unreads
         publisher_vocabulary/code publisher_vocabulary/calls
         publisher_vocabulary/called_by publisher_vocabulary/entries
         publisher_vocabulary/dt
         publisher_vocabulary/grove/module
         publisher_vocabulary/grove/template
         publisher_vocabulary/grove/source
         publisher_vocabulary/grove/seed
         publisher_vocabulary/grove/sewn
         publisher_vocabulary/grove/norm
         publisher_vocabulary/grove/action
         publisher_vocabulary/grove/role
         publisher_vocabulary/grove/like]
    | slots.any (\ key (eq_pith key slot))
