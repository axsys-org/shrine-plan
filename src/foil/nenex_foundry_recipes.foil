-  sept [order=10]
-  semidoc [order=20]
'  Static Nenex Foundry recipes, catalogs, and fallback specimens.  This unit
'  owns authored Semidoc bytes only; Nenex still owns page mounts and kooks.
+  nenex_foundry_recipes
  +  plate_header_recipe_src
    '  Zoo selection metadata for lifting a record into the shared Block.  Its
    '  template reference is the typed dependency on Plate Header anatomy.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/system/recipes/plate_header"
       ";@ /recipe/role ;/foundry/system/blocks/plate_header"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/system/blocks/plate_header"
       ";@ /recipe/output_kind block"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/web"
       ";@ /recipe/template ;/foundry/system/blocks/plate_header"
       ";. /authoring/recipes/plate-header"])
  +  plate_header_catalog_src
    '  The smallest coherent system selection: one recipe supplies anatomy and
    '  one Layer supplies Header Text Style.  These references create the
    '  forward DAG and the derived used-by rows shown on the Nenex index.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind catalog"
       ";@ /foundry/name ;/foundry/system/catalogs/plate_header"
       ";@ /catalog/source_role ;/source/content/title"
       ";@ /catalog/target_role ;/foundry/system/blocks/plate_header"
       ";@ /catalog/ceiling block"
       ";@ /catalog/recipes ;/foundry/system/recipes/plate_header"
       ";@ /catalog/layers ;/foundry/system/styles/header_text"
       ";. /authoring/catalogs/plate-header"])
  +  plain_text_fallback_surface_src
    '  A renderer-neutral fallback payload.  It is a normal Surface definition,
    '  not HTML, a browser default, or content embedded inside the Slot.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/system/fallbacks/plain_text_surface"
       ";@ /surface/root ;/foundry/system/fallbacks/plain_text_surface/root"
       ";. /authoring/fallbacks/plain-text-surface"
       "  ;@ /surface/kind text"
       "  ;@ /surface/role ;/foundry/system/fallbacks/plain_text"
       "  ;@ /surface/text Unavailable"
       "  ;. /foundry/system/fallbacks/plain_text_surface/root"])
  +  plain_text_fallback_recipe_src
    '  The semantic fallback Recipe.  Availability requires this definition and
    '  its admitted Surface template; merely naming the Recipe is insufficient.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/system/recipes/plain_text_fallback"
       ";@ /recipe/role ;/foundry/system/fallbacks/plain_text"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/system/fallbacks/plain_text"
       ";@ /recipe/output_kind text"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class renderer"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/web"
       ";@ /recipe/template ;/foundry/system/fallbacks/plain_text_surface"
       ";. /authoring/recipes/plain-text-fallback"])
  +  message_text_fallback_src
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/chat/recipes/message_text_fallback"
       ";@ /recipe/role ;/foundry/chat/fallbacks/message_text"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/chat/fallbacks/message_text"
       ";@ /recipe/output_kind text"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class renderer"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /authoring/chat/fallbacks/message-text"
       "  ;@ /surface/kind text"
       "  ;@ /surface/role ;/foundry/chat/fallbacks/message_text"
       "  ;@ /surface/text Unavailable"
       "  ;. /foundry/chat/fallbacks/message_text/root"])
  +  message_log_pending_fallback_src
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/chat/recipes/message_log_pending_fallback"
       ";@ /recipe/role ;/foundry/chat/fallbacks/message_log_pending"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/chat/fallbacks/message_log_pending"
       ";@ /recipe/output_kind block"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class progressive"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /authoring/chat/fallbacks/message-log-pending"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/fallbacks/message_log_pending"
       "  ;. /foundry/chat/fallbacks/message_log_pending/root"
       "    ;@ /surface/kind text"
       "    ;@ /surface/role ;/foundry/chat/fallbacks/message_log_pending/status"
       "    ;@ /surface/text Loading"
       "    ;. /foundry/chat/fallbacks/message_log_pending/status"])
  +  composer_compact_fallback_src
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/chat/recipes/composer_compact_fallback"
       ";@ /recipe/role ;/foundry/chat/fallbacks/composer_compact"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/chat/fallbacks/composer_compact"
       ";@ /recipe/output_kind block"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class structural"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /authoring/chat/fallbacks/composer-compact"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/fallbacks/composer_compact"
       "  ;. /foundry/chat/fallbacks/composer_compact/root"
       "    ;@ /surface/kind text"
       "    ;@ /surface/role ;/foundry/chat/fallbacks/composer_compact/status"
       "    ;@ /surface/text Unavailable"
       "    ;. /foundry/chat/fallbacks/composer_compact/status"])
  +  window_title_fallback_src
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/chat/recipes/window_title_fallback"
       ";@ /recipe/role ;/foundry/chat/fallbacks/window_title"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/chat/fallbacks/window_title"
       ";@ /recipe/output_kind block"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class structural"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /authoring/chat/fallbacks/window-title"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/fallbacks/window_title"
       "  ;. /foundry/chat/fallbacks/window_title/root"
       "    ;@ /surface/kind text"
       "    ;@ /surface/role ;/foundry/chat/fallbacks/window_title/label"
       "    ;@ /surface/text Window"
       "    ;. /foundry/chat/fallbacks/window_title/label"])
  +  provider_symbol_text_fallback_src
    ^  nat
    (joined_all 10
      [";@ /foundry/kind recipe"
       ";@ /foundry/name ;/foundry/chat/recipes/provider_symbol_text_fallback"
       ";@ /recipe/role ;/foundry/chat/fallbacks/provider_symbol_text"
       ";@ /recipe/input record"
       ";@ /recipe/output_role ;/foundry/chat/fallbacks/provider_symbol_text"
       ";@ /recipe/output_kind text"
       ";@ /recipe/primitive knit"
       ";@ /recipe/ceiling block"
       ";@ /recipe/fallback_class renderer"
       ";@ /recipe/backend neutral"
       ";@ /recipe/pronunciation ;/pronunciation/neutral"
       ";. /authoring/chat/fallbacks/provider-symbol-text"
       "  ;@ /surface/kind text"
       "  ;@ /surface/role ;/foundry/chat/fallbacks/provider_symbol_text"
       "  ;@ /surface/text symbol"
       "  ;. /foundry/chat/fallbacks/provider_symbol_text/root"])
  +  fallback_specimen_block_src
    '  A bounded proof component: its required content Slot has no local child,
    '  so successful realization must traverse Slot -> Recipe -> Surface.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/system/blocks/fallback_specimen"
       ";@ /surface/root ;/foundry/system/blocks/fallback_specimen/root"
       ";. /authoring/blocks/fallback-specimen"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/system/blocks/fallback_specimen"
       "  ;. /foundry/system/blocks/fallback_specimen/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/fallback_specimen/content"
       "    ;@ /surface/place ;/slot/content"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/fallback ;/foundry/system/recipes/plain_text_fallback"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/system/blocks/fallback_specimen/content"])
