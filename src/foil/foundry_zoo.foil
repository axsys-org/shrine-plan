-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  surface_tree [order=30]
-  foundry [order=40]
-  pact [order=50]
-  web [order=60]
'  foundry_zoo: the typed seam between Zoo negotiation and Foundry
'  compilation.  Zoo selects immutable recipe identity; Foundry checks
'  structural ceilings and builds the nested /o report.  Neither side
'  receives action authority or commits a projection object.
+  foundry_zoo
  +  algebra
    '  The exact Zoo shape law.  `surface-tree` metadata normalizes to the
    '  existing subtree carrier; no fifth primitive or terminal inverse is
    '  introduced.
    :  primitive=iota input=iota output=iota

  +  pronunciation_key
    '  Generic terminal lookup key.  It is application-neutral: semantic
    '  role, backend, features, mode, and ceiling select one felt recipe.
    :  role=path
       backend=iota
       pronunciation=path
       features=row[path]
       mode=iota
       ceiling=iota

  +  pronunciation_registry
    '  A disposable lookup view derived from admitted, Catalog-visible felt
    '  Recipes.  It is not a "provider pack", not a corpus family, and not
    '  semantic authority.  Entries remain ordinary Zoo myths so all admitted
    '  Recipe sources share one resolution law.
    :  entries=row[myth]

  +  choice
    :  query=zoo/request kind=iota

  +  make_choice
    \  query=zoo/request kind=iota
    ^  foundry_zoo/choice
    (foundry_zoo/choice query kind)

  +  make_pronunciation_key
    \  role=path backend=iota pronunciation=path features=row[path]
       mode=iota ceiling=iota
    ^  foundry_zoo/pronunciation_key
    (foundry_zoo/pronunciation_key role backend pronunciation features mode
      ceiling)

  +  make_pronunciation_registry
    '  Migration/test construction gate for untyped hosts.  Production must
    '  derive this row from corpus admission and its selected Catalog;
    '  construction grants no authority, and every lookup still passes
    '  through Zoo resolution and exact felt-shape admission.
    \  entries=row[myth]
    ^  foundry_zoo/pronunciation_registry
    (foundry_zoo/pronunciation_registry entries)

  +  outcome
    &  foundry_zoo/outcome/admitted
       foundry_zoo/outcome/refused

    +  admitted
      :  step=foundry/step entry=myth fallback=bool algebra=foundry_zoo/algebra

    +  refused
      :  diagnostic=foundry/diagnostic

  +  first_or
    \  fallback=path paths=row[path]
    ^  path
    ?  (eq 0 paths.len)
       fallback
    paths.at(0)

  +  shape
    '  Registry spelling to one exact algebraic carrier.
    \  name=nat
    ^  maybe[iota]
    ?  (eq name "record")        (./some 'record)
    ?  (eq name "subtree")       (./some 'subtree)
    ?  (eq name "surface-tree")  (./some 'subtree)
    .none

  +  primitive
    \  input=iota output=iota
    ^  iota
    ?  (eq_iota input 'record)
       ?  (eq_iota output 'record)   'dyed
       'knit
    ?  (eq_iota output 'record)      'felt
    'sewn

  +  primitive_known
    \  primitive=iota
    ^  bool
    =  primitives=row[iota]  ['dyed 'knit 'sewn 'felt]
    primitives.any((\ p (eq_iota primitive p)))

  +  admit_entry
    '  Infer the only lawful primitive from input/output shape and verify any
    '  authored primitive/constructor spelling against it before admitting a
    '  Foundry step.  Keeping the check at this boundary avoids exposing an
    '  intermediate result type that callers could mistake for selection.
    \  part=path entry=myth kind=iota fallback=bool
    ^  foundry_zoo/outcome
    =  in_text  (myth/txt_at ['recipe 'input] entry)
       out_text (myth/txt_at ['recipe 'output] entry)
       declared0 (myth/txt_at ['recipe 'primitive] entry)
       declared
         ?  (gt declared0 0)  declared0
         (myth/txt_at ['kind] entry)
    ?  (foundry_zoo/shape in_text)
     > .none
       (foundry_zoo/outcome/refused
         (foundry/diagnostic 'recipe_input_shape_invalid part
           "Zoo input must be record or subtree"))
     > (./some input=iota)
       ?  (foundry_zoo/shape out_text)
        > .none
          (foundry_zoo/outcome/refused
            (foundry/diagnostic 'recipe_output_shape_invalid part
              "Zoo output must be record or subtree"))
        > (./some output=iota)
          =  exact  (foundry_zoo/primitive input output)
          ?  (gt declared 0)
             =  named  ($ts declared)
             ?  !(foundry_zoo/primitive_known named)
                (foundry_zoo/outcome/refused
                  (foundry/diagnostic 'recipe_primitive_invalid part
                    "Zoo primitive must be dyed, knit, sewn, or felt"))
             ?  !(eq_iota named exact)
                (foundry_zoo/outcome/refused
                  (foundry/diagnostic 'recipe_algebra_mismatch part
                    "Zoo primitive does not match its input/output shape"))
             (foundry_zoo/outcome/admitted (foundry/step part kind) entry
               fallback (foundry_zoo/algebra exact input output))
          (foundry_zoo/outcome/admitted (foundry/step part kind) entry
            fallback (foundry_zoo/algebra exact input output))

  +  select
    '  Turn Zoo's total resolution into a Foundry step or one stable
    '  diagnostic.  Exact and fallback both preserve the selected
    '  registry entry for inspection; missing/ambiguous/incompatible
    '  never become executable steps.
    \  q=zoo/request kind=iota entries=row[myth]
    ^  foundry_zoo/outcome
    ?  (zoo/resolve q entries)
     > x=zoo/resolution/exact
       (foundry_zoo/admit_entry x.part x.entry kind .false)
     > x=zoo/resolution/fallback
       (foundry_zoo/admit_entry x.part x.entry kind .true)
     > x=zoo/resolution/missing
       (foundry_zoo/outcome/refused
         (foundry/diagnostic 'recipe_missing x.role
           "Zoo has no recipe for this semantic role"))
     > x=zoo/resolution/ambiguous
       (foundry_zoo/outcome/refused
         (foundry/diagnostic 'recipe_ambiguous
           (foundry_zoo/first_or (zoo/request_role q) x.parts)
           "multiple compatible Zoo recipes require an explicit choice"))
     > x=zoo/resolution/incompatible
       (foundry_zoo/outcome/refused
         (foundry/diagnostic 'recipe_incompatible
           (foundry_zoo/first_or (zoo/request_role q) x.parts)
           "the known recipes do not satisfy the requested axes"))

  +  path_text
    '  Zoo's legacy registry stores pronunciation as one text cord.  Generic
    '  Foundry keys retain semantic paths and lower only a single-segment
    '  family here; multi-segment families refuse as incompatible rather than
    '  being truncated or joined into a renderer-local convention.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)  0
    ?  (eq 1 p.len)  (iota_show p.at(0))
    "__invalid_pronunciation_path__"

  +  select_pronunciation
    '  Resolve one terminal pronunciation without application switches.
    '  Zoo still owns compatibility/fallback order; this seam additionally
    '  proves the selected operation is the subtree -> record (`felt`) cut.
    \  key=foundry_zoo/pronunciation_key entries=row[myth]
    ^  foundry_zoo/outcome
    =  q  (zoo/request key.role (iota_show key.mode)
         (iota_show key.ceiling) (iota_show key.backend)
         (foundry_zoo/path_text key.pronunciation) key.features)
    ?  (foundry_zoo/select q key.ceiling entries)
     > ok=foundry_zoo/outcome/admitted
       ?  (eq_iota ok.algebra.primitive 'felt)
          ok
       ?  ok.step
        > selected=foundry/step
          (foundry_zoo/outcome/refused
            (foundry/diagnostic 'pronunciation_not_terminal selected.recipe
              "pronunciation registry entries must use felt: subtree to record"))
     > no=foundry_zoo/outcome/refused  no

  +  pronounce
    '  Select from one explicit registry.  The same addressed semantic input
    '  may be paired with different registry keys (for example Web and text)
    '  without rebuilding or renaming that input.  Unknown or incompatible
    '  roles remain refusals; there is no application default.
    \  key=foundry_zoo/pronunciation_key
       registry=foundry_zoo/pronunciation_registry
    ^  foundry_zoo/outcome
    (foundry_zoo/select_pronunciation key registry.entries)

  +  compile
    '  Resolve each requested semantic step in author order and compile
    '  only when every choice is admitted.  The first refusal terminates
    '  the pipeline as an inert diagnostic plan.
    \  req=foundry/request choices=row[foundry_zoo/choice]
       entries=row[myth]
    ^  foundry/plan
    |  > i=nat 0  > steps=row[foundry/step] []
    ?  (ge i choices.len)
       (foundry/compile req steps)
    ?  choices.at(i)
     > c=foundry_zoo/choice
       ?  (foundry_zoo/select c.query c.kind entries)
        > ok=foundry_zoo/outcome/admitted
          (_ i.inc steps.snoc(ok.step))
        > no=foundry_zoo/outcome/refused
          ?  req
           > request=foundry/request
             (foundry/plan req request.source [] [no.diagnostic])

  +  selected_recipe
    '  Inspect an admitted Zoo handoff without exposing nominal layout.
    \  out=foundry_zoo/outcome
    ^  path
    ?  out
     > ok=foundry_zoo/outcome/admitted
       ?  ok.step
        > s=foundry/step  s.recipe
     > no=foundry_zoo/outcome/refused  []

  +  outcome_primitive
    \  out=foundry_zoo/outcome
    ^  maybe[iota]
    ?  out
     > ok=foundry_zoo/outcome/admitted  (./some ok.algebra.primitive)
     > foundry_zoo/outcome/refused      .none

  +  outcome_entry
    '  The exact selected provider entry, only after terminal admission.
    \  out=foundry_zoo/outcome
    ^  maybe[myth]
    ?  out
     > ok=foundry_zoo/outcome/admitted  (./some ok.entry)
     > foundry_zoo/outcome/refused      .none

  +  outcome_fallback
    '  Whether Zoo reached the admitted entry through declared fallback.
    \  out=foundry_zoo/outcome
    ^  maybe[bool]
    ?  out
     > ok=foundry_zoo/outcome/admitted  (./some ok.fallback)
     > foundry_zoo/outcome/refused      .none

  +  outcome_code
    \  out=foundry_zoo/outcome
    ^  maybe[iota]
    ?  out
     > foundry_zoo/outcome/admitted      .none
     > no=foundry_zoo/outcome/refused    (./some no.diagnostic.code)
