-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_view [order=40]
-  foundry_pronounce [order=50]
'  Mechanical extraction of unresolved Hole evidence from admitted projection
'  cursors.  This module neither traverses the DAG nor chooses a terminal.

+  foundry_pronounce_hole
  +  semantic_ref_parameter
    \  key=path parameters=row[projection_parameter]
    ^  maybe[path]
    ?  (foundry_delivery/parameter_value key parameters)
     > .none  .none
     > (./some value=projection_value)
       (foundry_delivery/value_semantic_ref value)

  +  hole_of
    \  hole=projection_hole
    ^  projection_pronunciation_hole
    (projection_pronunciation_hole hole.kind hole.role hole.fallback
      hole.semantic_fallback
      (foundry_pronounce_hole/semantic_ref_parameter
        ['surface 'hole] hole.parameters)
      (foundry_pronounce_hole/semantic_ref_parameter
        ['surface 'source] hole.parameters)
      hole.parameters)

  +  cursor_hole
    \  cursor=projection_cursor
    ^  maybe[projection_pronunciation_hole]
    ?  cursor.hole
     > .none  .none
     > (./some hole=projection_hole)
       (./some (foundry_pronounce_hole/hole_of hole))
