-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_pronounce [order=40]
'  Pure Chat occurrence reading.  This smallest cone interprets canonical
'  pronunciation parameters without importing Web, Weft, Surface, providers,
'  or product role policy.
+  chat_foundry_occurrence
  +  occurrence_role_is
    \  role=path occurrence=projection_pronunciation_occurrence
    ^  bool
    (eq_pith role occurrence.role)

  +  occurrence_text
    \  key=path occurrence=projection_pronunciation_occurrence
    ^  nat
    ?  (foundry_delivery/parameter_value key occurrence.parameters)
     > .none  0
     > (./some value=projection_value)
       (foundry_delivery/value_text value).fall(0)

  +  occurrence_ref
    \  key=path occurrence=projection_pronunciation_occurrence
    ^  maybe[path]
    ?  (foundry_delivery/parameter_value key occurrence.parameters)
     > .none  .none
     > (./some value=projection_value)
       (foundry_delivery/value_semantic_ref value)

  +  occurrence_template_is
    \  template=path occurrence=projection_pronunciation_occurrence
    ^  bool
    ?  (chat_foundry_occurrence/occurrence_ref ['surface 'template] occurrence)
     > .none  .false
     > (./some ref=path)  (eq_pith ref template)

  +  occurrence_token_is
    \  key=path text=nat ref=path
       occurrence=projection_pronunciation_occurrence
    ^  bool
    ?  (chat_foundry_occurrence/occurrence_ref key occurrence)
     > (./some got=path)  (eq_pith got ref)
     > .none  (eq (chat_foundry_occurrence/occurrence_text key occurrence) text)
