-  weft
'  tyshow: the type pretty-printer, in Foil.  A reflected descriptor
'  ((^ expr) — the builtin `type` sum) renders to the same text the
'  compiler's own renderer produces (foil-render new-ty-text).
+  tyshow
  +  is_txt
    '  Whether v is a nonempty cord of printable ASCII bytes.
    '  ?=  ((tyshow/is_txt "abc") 1)
    '  ?=  ((tyshow/is_txt 3) 0)
    \  v=nat
    ^  bool
    ?  (eq v 0)
       .false
    |  > rest=nat v
    ?  (eq rest 0)
       .true
    =  byte  (mod rest 256)
    ?  (lt byte 32)
       .false
    ?  (lt 126 byte)
       .false
    (_ (div rest 256))

  +  atom_text
    '  A cord atom as itself when printable, else its decimal digits.
    \  v=nat
    ^  nat
    ?  (tyshow/is_txt v)
       v
    (weft/show_nat v)

  +  cst_text
    '  A constant: '$foo for printable symbols, digits otherwise.
    '  ?=  ((tyshow/cst_text "hello") "'$hello")
    '  ?=  ((tyshow/cst_text 42) "42")
    \  val=nat
    ^  nat
    ?  (tyshow/is_txt val)
       (weft/cat2 "'$" val)
    (weft/show_nat val)

  +  path_text
    '  /a/b — every segment slash-prefixed; a ~-headed path (a
    '  unit-qualified storage key) renders ~/local/path.
    '  ?=  ((tyshow/path_text ["boot" "pointy"]) "/boot/pointy")
    \  segs=row[nat]
    ^  nat
    |  > idx=nat 0  > out=nat ""
    ?  (eq idx segs.len)
       out
    =  seg   segs.at(idx)
       part
         ?  (eq idx 0)
            ?  (eq seg "~")
               "~"
            (weft/cat2 "/" (tyshow/atom_text seg))
         (weft/cat2 "/" (tyshow/atom_text seg))
    (_ idx.inc (weft/cat2 out part))

  +  show
    '  Render a type descriptor.  One arm per member of the closed
    '  `type` sum, byte-identical to the compiler's renderer.
    '  ?=  ((tyshow/show (^ 1)) "1")
    '  ?=  ((tyshow/show (^ nat)) "/nat")
    \  t0=type
    ^  nat
    |  > t=type t0
    ^  nat
    =  me  (_)
       many
         \  sep=nat ts=row[type]
         ^  nat
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx ts.len)
            (weft/join sep out)
         (_ idx.inc out.snoc((me ts.at(idx))))
    ?  t
     > .any   "any"
     > .pail  "pail"
     > .bot   "bot"
     > .opq   "'..."
     > (./nat aura)
       ?  (eq aura 0)
          "nat"
       ?  (eq aura "t")
          "str"
       (weft/cat2 "nat/" (tyshow/atom_text aura))
     > (./cst val)
       (tyshow/cst_text val)
     > (./var name)
       (weft/cat2 "@" (tyshow/atom_text name))
     > (./arr item)
       (weft/cat ["row[" (me item) "]"])
     > (./pin item)
       (weft/cat ["pin[" (me item) "]"])
     > (./fun args ret)
       (weft/cat ["{" (many " " args) "; " (me ret) "}"])
     > (./sum opts)
       (weft/cat ["(" (many " | " opts) ")"])
     > (./rec cstr items)
       =  body
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx items.len)
               (weft/join " " out)
            =  [face=nat item=type]  items.at(idx)
               part
                 ?  (eq face idx)
                    (me item)
                 (weft/cat [(tyshow/atom_text face) "=" (me item)])
            (_ idx.inc out.snoc(part))
       ?  cstr
          (weft/cat [(tyshow/atom_text cstr) "[" body "]"])
       (weft/cat ["[" body "]"])
     > (./nom path args)
       ?  args.len
          (weft/cat [(tyshow/path_text path) "[" (many " " args) "]"])
       (tyshow/path_text path)
     > (./gen params body)
       =  pre
            |  > idx=nat 0  > out=nat ""
            ?  (eq idx params.len)
               out
            =  [flag=nat name=nat cty=type]  params.at(idx)
               part
                 ?  flag
                    (weft/cat ["@[" (tyshow/atom_text name) " " (me cty) "] "])
                 (weft/cat ["@" (tyshow/atom_text name) " "])
            (_ idx.inc (weft/cat2 out part))
       (weft/cat2 pre (me body))
