-  sept
'  tyshow: the type pretty-printer, in Foil.  A reflected descriptor
'  ((^ expr) — the builtin `type` sum) renders to the same text the
'  compiler's own renderer produces (foil-render new-ty-text).
+  tyshow
  +  is_txt
    '  Whether v is a nonempty cord of printable ASCII bytes.
    '  ?=  ((tyshow/is_txt "abc") 1)
    '  ?=  ((tyshow/is_txt 3) 0)
    \ v=nat
    ^ bool
    ? (eq v 0) .false
    % i=nat 0
    ? (eq i (wid v)) .true
    = byte | load8 i v
    ? ((lt byte 32) || (gt byte 126)) .false
    | _ i.inc
  +  atom_text
    '  A cord atom as itself when printable, else its decimal digits.
    \  v=nat
    ^  nat
    ?  (tyshow/is_txt v)
       v
    | nat/show v

  +  cst_text
    '  A constant: '$foo for printable symbols, digits otherwise.
    '  ?=  ((tyshow/cst_text "hello") "'$hello")
    '  ?=  ((tyshow/cst_text 3000000000) "3000000000")
    \  val=nat
    ^  nat
    ?  (tyshow/is_txt val)
       | cord/cat "'$" val
    | nat/show val

  +  path_text
    '  /a/b — every segment slash-prefixed; a ~-headed path (a
    '  unit-qualified storage key) renders ~/local/path.
    '  ?=  ((tyshow/path_text ["sys" "types" "nat"]) "/sys/types/nat")
    \  segs=row[nat]
    ^  nat
    %  idx=nat 0  out=nat ""
    ?  (eq idx segs.len)
       out
    =  seg   segs.at(idx)
       part
         ?  (eq idx 0)
            ?  (eq seg "~")
               "~"
            | cord/cat "/" (tyshow/atom_text seg)
         | cord/cat "/" (tyshow/atom_text seg)
    | _ idx.inc (cord/cat out part)

  +  show
    '  Render a type descriptor.  One arm per member of the closed
    '  `type` sum, byte-identical to the compiler's renderer.
    '  ?=  ((tyshow/show (^ 1)) "1")
    '  ?=  ((tyshow/show (^ nat)) "/sys/types/nat@x1")
    \  t=type
    ^  nat
    =  me  (_)
       many
         \  sep=nat ts=row[type]
         ^  nat
         | cord/join sep ts.map(me)
    ?  t
     > .any   "any"
     > .pail  "pail"
     > .bot   "bot"
     > .opq   "'..."
     > (./nat aura)
       ?  (eq aura 0)
          "nat"
       | cord/cat "nat/" (tyshow/atom_text aura)
     > (./cst val)
       | tyshow/cst_text val
     > (./var name)
       | cord/cat "@" (tyshow/atom_text name)
     > (./arr item)
       | cord/cat_all ["row[" (me item) "]"]
     > (./pin item)
       | cord/cat_all ["pin[" (me item) "]"]
     > (./fun args ret)
       ?  (eq 0 args.len)
          | cord/cat_all ["{\}" (me ret)]
       | cord/cat_all ["{\ " (many " " args) "}" (me ret)]
     > (./sum opts)
       | cord/cat_all ["(" (many " | " opts) ")"]
     > (./rec cstr items)
       =  body | cord/join " " (tyshow/record_parts items)
       ?  cstr
          | cord/cat_all [(tyshow/constructor_name cstr) "[" body "]"]
       | cord/cat_all ["[" body "]"]
     > (./ref identity args)
       = name | tyshow/definition_name identity
       ? args.len
         | cord/cat_all [name "[" (many " " args) "]"]
       name
     > (./nom path args)
       ?  args.len
          | cord/cat_all [(tyshow/path_text path) "[" (many " " args) "]"]
       | tyshow/path_text path
     > (./gen params body)
       | cord/cat (tyshow/gen_prefix params) (me body)

  + constructor_name
    \ name=nat
    ^ nat
    ? (nominal_brand name) (tyshow/definition_name name)
    | tyshow/atom_text name

  + definition_name
    \ identity=nat
    ^ nat
    ?> (./some reference) (brand_decode identity)
      "<invalid-definition>"
    = [path version] reference
    | cord/cat_all [(path_show path) "@x" (nat/show version)]

  +  record_parts
    '  Shared field spelling for flat and multiline records.
    \  items=row[[face=nat item=type]]
    ^  row[nat]
    %  idx=nat 0  out=row[nat] []
    ?  (eq idx items.len)
       out
    =  [face item] items.at(idx)
       text | tyshow/show item
       part=nat
         ?  (eq face idx)
            text
         | cord/cat_all [(tyshow/atom_text face) "=" text]
    | _ idx.inc out.snoc(part)

  +  gen_prefix
    '  A generic's parameter prefix: @a for type parameters,
    '  @[name cty] for const parameters, each trailing one space.
    \  params=row[[cnst=nat name=nat cty=type]]
    ^  nat
    %  idx=nat 0  out=nat ""
    ?  (eq idx params.len)
       out
    =  [flag name cty]  params.at(idx)
       part
         ?  flag
            | cord/cat_all ["@[" (tyshow/atom_text name) " " (tyshow/show cty) "] "]
         | cord/cat_all ["@" (tyshow/atom_text name) " "]
    | _ idx.inc (cord/cat out part)

  +  pretty
    '  Render a descriptor for a page: a short type stays on one
    '  line; a long function, sum, record, or generic breaks at its
    '  top-level structure, one part per line, continuation-aligned.
    '  ?=  ((tyshow/pretty (^ nat)) "/sys/types/nat@x1")
    \  t=type
    ^  nat
    =  nl    10
       flat  (tyshow/show t)
    ?  (lt (wid flat) 64)
       flat
    =  lines
         \  open=nat sep=nat close=nat parts=row[nat]
         ^  nat
         | cord/cat_all [open (cord/join (cord/cat nl sep) parts) close]
    ?  t
     > (./fun args ret)
       | lines "{\ " "   " (cord/cat_all ["}" (tyshow/show ret)])
         args.map(tyshow/show)
     > (./sum opts)
       | lines "(  " "|  " ")" opts.map(tyshow/show)
     > (./rec cstr items)
       =  parts | tyshow/record_parts items
       ?  cstr
          | lines (cord/cat_all [(tyshow/atom_text cstr) "[  "]) "   " "]" parts
       | lines "[  " "   " "]" parts
     > (./gen params body)
       | cord/cat_all [(tyshow/gen_prefix params) nl (tyshow/pretty body)]
    flat
