-  sept
'  tyshow: the type pretty-printer, in Foil.  A
'  reflected descriptor ((^ expr), the builtin `type`
'  sum) renders to the same text the compiler's own
'  renderer produces (foil-render new-ty-text).
+  tyshow
  +  is_txt
    '  Whether v is a nonempty printable-ASCII cord.
    '  ?=  ((tyshow/is_txt "abc") 1)
    '  ?=  ((tyshow/is_txt 3) 0)
    \ v=nat
    ^ bool
    ? (eq v 0) .false
    % i=nat 0
    ? (eq i (wid v)) .true
    = byte | load8 i v
    ? (or (lt byte 32) (gt byte 126)) .false
    | _ i.inc

  +  atom_text
    '  A cord atom as itself when printable, else its
    '  decimal digits.
    \ v=nat
    ^ nat
    ? (tyshow/is_txt v) v
    | nat/show v

  +  cst_text
    '  A constant: '$foo for printable symbols, digits
    '  otherwise.
    '  ?=  ((tyshow/cst_text "hello") "'$hello")
    '  ?=  ((tyshow/cst_text 3000000000) "3000000000")
    \ val=nat
    ^ nat
    ? (tyshow/is_txt val) (cord/cat "'$" val)
    | nat/show val

  +  path_text
    '  /a/b, every segment slash-prefixed; a ~-headed
    '  path (a unit-qualified storage key) renders
    '  ~/local/path.
    '  ?=  ((tyshow/path_text ["sys" "types" "nat"]) "/sys/types/nat")
    \ segs=row[nat]
    ^ nat
    % idx=nat 0 out=nat ""
    ? (eq idx segs.len) out
    = seg segs.at(idx)
    =   part
      ? (and (eq idx 0) (eq seg "~"))
       "~"
       | cord/cat "/" (tyshow/atom_text seg)
    | _ idx.inc (cord/cat out part)

  +  show
    '  Render a type descriptor, one arm per member of
    '  the closed `type` sum, byte-identical to the
    '  compiler's renderer.
    '  ?=  ((tyshow/show (^ 1)) "1")
    '  ?=  ((tyshow/show (^ nat)) "/sys/types/nat@x1")
    \ t=type
    ^ nat
    ? t
     > .any "any"
     > .pail "pail"
     > .bot "bot"
     > .opq "'..."
     > (./nat aura) (tyshow/nat_text aura)
     > (./cst val) (tyshow/cst_text val)
     > (./var name)
      | cord/cat "@" (tyshow/atom_text name)
     > (./arr item) (tyshow/wrap "row[" item "]")
     > (./pin item) (tyshow/wrap "pin[" item "]")
     > (./fun args ret) (tyshow/fun_text args ret)
     > (./sum opts) (tyshow/sum_text opts)
     > (./rec cstr items) (tyshow/rec_text cstr items)
     > (./ref identity args)
      | tyshow/ref_text identity args
     > (./nom path args) (tyshow/nom_text path args)
     > (./gen params body)
      | tyshow/gen_text params body

  +  many
    '  Descriptors joined by a separator.
    \ sep=nat ts=row[type]
    ^ nat
    | cord/join sep ts.map(tyshow/show)

  +  wrap
    '  A descriptor between an opener and a closer.
    \ open=nat t=type close=nat
    ^ nat
    | cord/cat_all [open (tyshow/show t) close]

  +  nat_text
    '  nat, or nat/aura for an aura'd nat.
    \ aura=nat
    ^ nat
    ? (eq aura 0) "nat"
    | cord/cat "nat/" (tyshow/atom_text aura)

  +  fun_text
    '  {\ a b}c, or {\}c without arguments.
    \ args=row[type] ret=type
    ^ nat
    = ret_text  | tyshow/show ret
      args_text | tyshow/many " " args
    ? (eq 0 args.len) (cord/cat "{\}" ret_text)
    | cord/cat_all ["{\ " args_text "}" ret_text]

  +  sum_text
    '  (a | b | c)
    \ opts=row[type]
    ^ nat
    = inner | tyshow/many " | " opts
    | cord/cat_all ["(" inner ")"]

  +  rec_text
    '  [a=t b=u], with the constructor's name in front
    '  when the record has one.
    \ cstr=nat items=row[[face=nat item=type]]
    ^ nat
    = body | cord/join " " (tyshow/record_parts items)
      name | tyshow/constructor_name cstr
    ? cstr (cord/cat_all [name "[" body "]"])
    | cord/cat_all ["[" body "]"]

  +  ref_text
    '  A definition reference with its type arguments.
    \ identity=nat args=row[type]
    ^ nat
    = name | tyshow/definition_name identity
    | tyshow/applied name args

  +  nom_text
    '  A nominal path with its type arguments.
    \ path=row[nat] args=row[type]
    ^ nat
    | tyshow/applied (tyshow/path_text path) args

  +  applied
    '  name, or name[args] when there are arguments.
    \ name=nat args=row[type]
    ^ nat
    ? (eq 0 args.len) name
    = inner | tyshow/many " " args
    | cord/cat_all [name "[" inner "]"]

  +  gen_text
    '  The parameter prefix followed by the body.
    \ params=row[[cnst=nat name=nat cty=type]]
      body=type
    ^ nat
    = head | tyshow/gen_prefix params
    | cord/cat head (tyshow/show body)

  +  constructor_name
    '  A nominal constructor by its definition, else
    '  the atom itself.
    \ name=nat
    ^ nat
    ? (nominal_brand name)
     | tyshow/definition_name name
    | tyshow/atom_text name

  +  definition_name
    '  path@xN for a decodable definition brand.
    \ identity=nat
    ^ nat
    > (./some reference) (brand_decode identity)
     "<invalid-definition>"
    = [path version] reference
    = seen | path_show path
      ver  | nat/show version
    | cord/cat_all [seen "@x" ver]

  +  record_parts
    '  Shared field spelling for flat and multiline
    '  records.
    \ items=row[[face=nat item=type]]
    ^ row[nat]
    % idx=nat 0 out=row[nat] []
    ? (eq idx items.len) out
    = [face item] items.at(idx)
      text        | tyshow/show item
      label       | tyshow/atom_text face
    =   part=nat
      ? (eq face idx)
       text
       | cord/cat_all [label "=" text]
    | _ idx.inc out.snoc(part)

  +  gen_prefix
    '  A generic's parameter prefix: @a for type
    '  parameters, @[name cty] for const parameters,
    '  each trailing one space.
    \ params=row[[cnst=nat name=nat cty=type]]
    ^ nat
    % idx=nat 0 out=nat ""
    ? (eq idx params.len) out
    = [flag name cty] params.at(idx)
      label           | tyshow/atom_text name
      cty_text        | tyshow/show cty
    =   part
      ? flag
       | cord/cat_all ["@[" label " " cty_text "] "]
       | cord/cat_all ["@" label " "]
    | _ idx.inc (cord/cat out part)

  +  nl
    '  A newline, as a one-byte cord.
    ^ nat
    10

  +  lines
    '  Parts on their own lines between an opener and
    '  a closer, each continuation line led by sep.
    \ open=nat sep=nat close=nat parts=row[nat]
    ^ nat
    = glue | cord/cat tyshow/nl sep
    | cord/cat_all [open (cord/join glue parts) close]

  +  pretty
    '  Render a descriptor for a page: a short type
    '  stays on one line; a long function, sum,
    '  record, or generic breaks at its top level,
    '  one part per line, continuation-aligned.
    '  ?=  ((tyshow/pretty (^ nat)) "/sys/types/nat@x1")
    \ t=type
    ^ nat
    = flat | tyshow/show t
    ? (lt (wid flat) 64) flat
    ? t
     > (./fun args ret)
      = close | cord/cat_all ["}" (tyshow/show ret)]
        parts args.map(tyshow/show)
      | tyshow/lines "{\ " "   " close parts
     > (./sum opts)
      = parts opts.map(tyshow/show)
      | tyshow/lines "(  " "|  " ")" parts
     > (./rec cstr items)
      = parts | tyshow/record_parts items
        name  | tyshow/atom_text cstr
        open  | cord/cat_all [name "[  "]
      ? cstr (tyshow/lines open "   " "]" parts)
      | tyshow/lines "[  " "   " "]" parts
     > (./gen params body)
      = head | tyshow/gen_prefix params
        rest | tyshow/pretty body
      | cord/cat_all [head tyshow/nl rest]
    flat
