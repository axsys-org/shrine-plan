- shrine_types
- bond
- view_ops
- view_walk
- graph_views
- graph_world
- graph_union
- graph_beneath
- graph_workspace

'  The standard woven cells, by name: a record names its ctor with
'  pails/q, as the standard cells do, and never holds a closure (a
'  closure in a record is copied with every message).  Seeded under
'  /weft/graph at boot; a cell's /sys/weft points at one of them.
+  weft_graph
  +  by_name
    \ name=iota
    ^ maybe[woven]
    ? (eq_iota name 'children) (./some (woven view_ops/children))
    ? (eq_iota name 'outline) (./some (woven view_ops/outline))
    ? (eq_iota name 'trace) (./some (woven view_ops/follow))
    ? (eq_iota name 'referencing) (./some (woven view_ops/referencing))
    ? (eq_iota name 'collect) (./some (woven view_ops/gather))
    ? (eq_iota name 'tally) (./some (woven view_ops/count))
    ? (eq_iota name 'compose) (./some (woven view_ops/compose))
    ? (eq_iota name 'walk) (./some (woven view_walk/get))
    ? (eq_iota name 'links) (./some (woven graph_views/links))
    ? (eq_iota name 'identities) (./some (woven graph_views/identities))
    ? (eq_iota name 'relations) (./some (woven graph_views/relations))
    ? (eq_iota name 'placements) (./some (woven graph_views/placements))
    ? (eq_iota name 'as_world) (./some (woven graph_world/get))
    ? (eq_iota name 'frontier) (./some (woven graph_world/frontier))
    ? (eq_iota name 'union) (./some (woven graph_union/get))
    ? (eq_iota name 'beneath) (./some (woven graph_beneath/get))
    ? (eq_iota name 'workspace) (./some (woven graph_workspace/get))
    .none
  +  names
    ^ row[[iota str]]
    [['children "The input's subtree"] ['outline "The input's names, the records beneath them not read"]
     ['trace "The record the input's /slot reference names"] ['referencing "The references that name the input"]
     ['collect "The input with every reference it holds placed beneath its slot"] ['tally "The input's children, counted"]
     ['compose "The worlds at /world/<key> laid over one locality, disagreements kept"]
     ['walk "The input's references, forward and incoming, to /depth"]
     ['links "What names the input, with the slot it is named in"] ['identities "The records the input's same judgements join"]
     ['relations "The input's relations, both ways, over its identities, each with the world asserting it"]
     ['placements "The overlays that place the input"]
     ['as_world "The input as a world: its relations as folders, to /depth, each thing once"]
     ['frontier "One level of the input as a world"]
     ['union "What every world says about the input: facts by world, agreements, disagreements"]
     ['beneath "The input's stored children, bounded"]
     ['workspace "Several standings (the input and standing/<key> slots) as one picture: components, routes between them with each hop attributed and marked solid or mention, islands, gaps"]]
  +  record
    \ name=iota title=str
    ^ myth
    | (myth/sing bond/weft (pails/q name)).put bond/lede (pails/t title)
  +  seeds
    ^ row[[path myth]]
    = root=path ['weft 'graph]
      all weft_graph/names
      first=row[[path myth]] [[root (myth/sing bond/lede (pails/t "Standard woven cells"))]]
    | all.fold first
      \ out [name title]
      | out.snoc [root.snoc(name) (weft_graph/record name title)]
