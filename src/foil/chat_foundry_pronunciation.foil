-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_web_form [order=60]
-  chat_foundry_web_terminal [order=70]
'  Compatibility facade for the established Chat pronunciation entry points.
'  Semantic reading, Header resolution, provider lowering, role policy, and
'  traversal compile in dependency-ordered bounded modules; these wrappers add
'  no policy, identity, or output transformation.
+  chat_foundry_pronunciation
  +  occurrence_text
    \  key=path occurrence=projection_pronunciation_occurrence
    ^  nat
    (chat_foundry_occurrence/occurrence_text key occurrence)

  +  chat_form
    \  logp=path back=nat
    ^  weft/node
    (chat_foundry_web_form/chat_form logp back)

  +  pronunciation_terminal
    \  pronunciation=projection_pronunciation
    ^  [body=maybe[nat] code=maybe[iota]]
    (chat_foundry_web_terminal/pronunciation_terminal pronunciation)
