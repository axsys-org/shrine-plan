-  map
+  map
  (@@ k lt={k; k; nat})
  +  has
    \  key=k x=map[k lt]
    ^  nat
    ?  x
     > map/empty  0
     > n=map/node[k lt]
       ?  (lt key n.key)
          (_ key n.l)
       ?  (lt n.key key)
          (_ key n.r)
       1
  +  count
    \  x=map[k lt]
    ^  nat
    ?  x
     > map/empty  0
     > n=map/node[k lt] (add 1 (add (_ n.l) (_ n.r)))
