- namespace_command

' Reports are ordinary records in the disposable test namespace. Writes use
' the same admission and x/y/z journal as application writes.
+ testing_report
  + root
    \ state=namespace
    ^ path
    [state.self 'tests 'run]
  + write
    \ records=row[[path myth]] state=namespace
    ^ either[iota namespace]
    = writes | records.map (\ [name card] [name (writ/make card)])
    < result (namespace_command/admit
        (\ ignored=namespace (either/ok[iota row[[path writ]]] writes))
        state (sovereign_hive state))
    = [next index] result
    | ./ok next
  + begin
    \ specs=row[[kind=nat name=nat text=nat]] procedure=pin[any] state=namespace
    ^ either[iota namespace]
    = root (testing_report/root state)
    ? (sovereign_peek root state).wyt (./err 'report_already_exists)
    = card (myth/sing ['status] (pails/t "running")).put(['procedure] (pails/code procedure)).put(['selected] (pails/n specs.len))
    = sources
      | (row/range 0 specs.len).map
        \ idx=nat
        ^ [path myth]
        = [kind name text] specs.at(idx)
        = card (myth/sing ['kind] (pails/t (str/from_atom kind))).put(['module] (pails/t (str/from_atom name))).put(['source] (pails/t (str/from_atom text)))
        [root.snoc('sources).snoc(($u idx)) card]
    | testing_report/write (sources.cons([root card])) state
  + finish
    \ passed=bool results=row[[status=nat module=nat name=nat want=nat got=nat]]
      captures=pin[any] state=namespace
    ^ either[iota namespace]
    = root (testing_report/root state)
      before (sovereign_peek root state).fil.fall(myth/new)
    ? !(equal before.txt_at(['status]) "running")
      | ./err 'report_not_running
    = card before.put(['status] (pails/t (? passed "passed" "failed"))).put(['passed] (pails/n passed)).put(['count] (pails/n results.len)).put(['captures] (pails/code captures))
    = checks
      | (row/range 0 results.len).map
        \ idx=nat
        ^ [path myth]
        = [status module name want got] results.at(idx)
        = card (myth/sing ['status] (pails/t (str/from_atom status))).put(['module] (pails/t (str/from_atom module))).put(['name] (pails/t (str/from_atom name)))
          card card.put(['expected] (pails/t (str/from_atom want))).put(['actual] (pails/t (str/from_atom got)))
        [root.snoc('checks).snoc(($u idx)) card]
    | testing_report/write (checks.cons([root card])) state
  + read
    \ relative=path state=namespace
    ^ myth
    | (sovereign_peek ((testing_report/root state).weld(relative)) state).fil.fall(myth/new)
  + versions
    \ state=namespace
    ^ row[nat]
    = root (testing_report/root state)
    | row/map[care nat] (\ care (namespace/case care root state).fall(0)) [.x .y .z]
  + read_at
    \ version=nat relative=path state=namespace
    ^ myth
    = target (testing_report/root state).weld(relative)
    ?> (./known tree) (namespace/page .x (./some version) target state) myth/new
    ?> (./some record) tree.fil myth/new
    | unpin record.myth
