-  sept
- grove_install
-  shrine_types
-  shrine
-  lain_types
-  lain_peek
-  lain_poke
- value_read
- physical_projection
- debug_read

+  helm
  +  journal_page
    '  One bounded physical /log snapshot at a captured sovereign epoch.
    '  view contains only the displayed child keys, including keys whose
    '  own record is absent or malformed. next is an exclusive epoch key.
    : epoch=nat before=maybe[nat] limit=nat total=nat next=maybe[nat] view=axal[saga]

  +  card
    &  helm/card/install
       helm/card/peek
       helm/card/journal
       helm/card/value
       helm/card/physical
       helm/card/debug
       helm/card/step
    + install
      : source=path version=nat target=path
    +  step
      : pax=path wit=writ
    +  peek
      : car=care cas=maybe[nat] pax=path
    +  journal
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + debug
      : request=nat query=debug_read/request

  +  supervisor
    '  Trusted bootstrap requests carry a transferred reply capability.
    '  Feet receive a dedicated endpoint bound to their registered path.
    '  Outbound moves and incomplete cascades are rejected atomically
    '  until outbound routing is installed. No persistence or actor discovery.
    +  request
      & helm/card/install
        helm/card/step
        helm/card/peek
        helm/card/journal
        helm/card/value
        helm/card/physical
        helm/card/debug
        helm/supervisor/register
    +  register
      '  Explicit bootstrap registration; duplicate or absent paths fail.
      : pax=path entry={\ feet/task/init nat}nat
    +  member
      : pax=path actor=nat binding=axal[saga]

    +  rejection
      : reason=iota

    +  denied
      \ reason=iota
      ^ feet/task[unit]
      | feet/task/ack
      | ./some (helm/supervisor/rejection reason)

    +  page
      '  Physical namespace snapshot with committed saga metadata.
      '  none selects latest; some selects a path-local care case.
      \ car=care cas=maybe[nat] pax=path s=sov
      ^ res[axal[saga]]
      = epoch=maybe[nat]
          ? cas
           > .none (./some s.top)
           > (./some c)
            = clocks | s.ever_at pax
            ? car
             > .x (track/epoch c clocks.x)
             > .y (track/epoch c clocks.y)
             > .z (track/epoch c clocks.z)
      ?> (./some ep) epoch
         .unknown
      = snapshot=res[axal[myth]]
          ? car
           > .x
            ? s.x_at(ep pax)
             > (./known m) (./known (axal/new[myth] (./some m)))
             > .null .null
             > .unknown .unknown
           > .y s.y_at(ep pax)
           > .z s.z_at(ep pax)
      ? snapshot
       > .null .null
       > .unknown .unknown
       > (./known tree)
        | ./known
        | tree.tap.fold (axal/new[saga] .none)
        \ out [rel record]
        ?> (./some version) (ass/saga ep (s.hist(pax.weld(rel))))
           out
        | out.put rel version

    +  journal_key
      \ entry=uon/kv[axal/k[tome]]
      ^ bool
      | maybe/is_some (dig_of entry.key)

    +  journal
      '  Read the index itself, not peek/.z or a reactive HTTP record.
      '  Only limit+1 physical child links are selected; only displayed
      '  children have their own history resolved. Descendants are never
      '  hydrated. This function cannot mint a commit or journal entry.
      \ before=maybe[nat] limit=nat s=sov
      ^ either[iota helm/journal_page]
      ? ((eq limit 0) || (gt limit 40)) (./err 'invalid_journal_limit)
      = epoch s.top
        source s.idx.dip(log_root)
        bound=maybe[iota] before.run(dig_show)
        selected source.kid.range_rev(bound limit.inc)
        valid (selected.all(helm/supervisor/journal_key))
      ? !valid (./err 'invalid_journal_key)
      = count (? (lt selected.len limit) selected.len limit)
        next=maybe[nat]
          ? (gt selected.len limit) (dig_of selected.at(count.dec).key)
          .none
        root_version (ass/saga epoch (tome/hist source.fil))
        view
          % i=nat 0 out=axal[saga] (axal/new[saga] root_version)
          ? (eq i count) out
          = entry selected.at(i)
            child (unpin entry.val.held)
            version (ass/saga epoch (tome/hist child.fil))
            node (axal/new[saga] version)
          | _ i.inc out.set_kid(out.kid_put(entry.key node))
      | ./ok (helm/journal_page epoch before limit source.kid.size next view)

    +  handle
      '  Namespace work stays pure; the loop below owns communication.
      \ cad=helm/card s=sov index=hive
      ^ [state=sov index=hive reply=feet/task[unit]]
      ? cad
       > (./install source version target)
        ? (grove_install/instantiate source version target s)
         > (./err reason)
          [s index (helm/supervisor/denied reason)]
         > (./ok next)
          [next (hive_of next) (feet/task/ack .none)]
       > (./peek car cas pax)
        [s index (feet/task/page pax
          (helm/supervisor/page car cas pax s))]
       > (./journal request before limit)
        [s index (feet/task/journal request
          (helm/supervisor/journal before limit s))]
       > (./value request query)
        [s index (feet/task/value request (value_read/safe_read query s))]
       > (./physical request query)
        ' Only the fully forced bounded wire scalar crosses the mailbox.
        [s index (feet/task/physical request
          (physical_projection/safe_json query s))]
       > (./debug request query)
        [s index (feet/task/debug request (debug_read/safe_read query s))]
       > (./step pax wit)
        = [result next_index]
            | cycle_with index (task/vine pax wit) 0 8 s
        ? result
         > (./fail reason)
          [s index (helm/supervisor/denied reason)]
         > (./spun next moves rounds ack spill)
          = problem=maybe[iota]
              ? spill
               > (./some reason) (./some reason)
              ? moves.len (./some 'outbound_not_supported)
              .none
          ? problem
           > (./some reason)
            [s index (helm/supervisor/denied reason)]
           > .none [next next_index (feet/task/ack .none)]

    +  close_caps
      \ caps=row[nat]
      ^ nat
      | row/fold[nat nat] 0
        (\ ;ignored=nat handle=nat (CloseHandle handle)) caps

    +  start_foot
      '  Resolve the transferred endpoint in the foot's handle table.
      \ entry={\ feet/task/init nat}nat self=nat
      ^ nat
      = ;[initial caps] (Recv[feet/task/init] 0)
      | entry (feet/task/init initial.ax caps.at(0)) self

    +  endpoint
      '  The foot cannot supply or change its source path.
      '  Replies go directly to the registered foot, not a claimed sender.
      \ pax=path self=nat
      ^ nat
      = ;[initial caps] (Recv[nat] 0)
        server=nat caps.at(0)
        foot=nat caps.at(1)
      % ignored=nat 0
      = ;[gift extra] (Recv[feet/gift[unit]] 0)
      ; (helm/supervisor/close_caps extra)
      ? (feet/gift/normalize pax gift)
       > .none (_ 0)
       > (./some card)
        ; (SendCaps server card [foot])
        | _ 0

    +  notify
      '  Compare committed %y snapshots. An absent binding is an empty tree.
      '  Preserve registry order and deliver updates before the write ack.
      \ state=sov members=row[helm/supervisor/member]
      ^ row[helm/supervisor/member]
      | members.fold []
      \ ;out=row[helm/supervisor/member] member=helm/supervisor/member
      ^ row[helm/supervisor/member]
      = binding=axal[saga]
          ? (helm/supervisor/page .y .none member.pax state)
           > (./known tree) tree
           > .null (axal/new[saga] .none)
           > .unknown (axal/new[saga] .none)
      ? (equal binding member.binding)
        out.snoc(member)
      ; (Send member.actor (feet/task/fact binding))
      | out.snoc member.set_binding(binding)

    +  enroll
      '  Validate once, then spawn and transfer the bound endpoint.
      \ req=helm/supervisor/register state=sov
        members=row[helm/supervisor/member]
      ^ [row[helm/supervisor/member] feet/task[unit]]
      ? members.any((\ mem (equal mem.pax req.pax)))
        [members (helm/supervisor/denied 'foot_already_registered)]
      ?> (./known binding)
          (helm/supervisor/page .y .none req.pax state)
        [members (helm/supervisor/denied 'foot_binding_absent)]
      = ;foot (Spawn (helm/supervisor/start_foot req.entry))
        ;port (Spawn (helm/supervisor/endpoint req.pax))
      ; (SendCaps port 0 [0 foot])
      ; (SendCaps foot (feet/task/init binding 0) [port])
      ; (CloseHandle port)
      = member (helm/supervisor/member req.pax foot binding)
      [members.snoc(member) (feet/task/ack .none)]

    +  advance
      '  Deliver committed bindings before returning the reply.
      \ card=helm/card state=sov index=hive
        members=row[helm/supervisor/member]
      ^ [sov hive row[helm/supervisor/member] feet/task[unit]]
      = ;[next next_index answer]
          | helm/supervisor/handle card state index
        ;updated
          ? (eq next.top state.top) members
          | helm/supervisor/notify next members
      [next next_index updated answer]

    +  run
      '  Only bootstrap code receives this handle. Feet use endpoints.
      \ initial=sov self=nat
      ^ nat
      % state=sov initial index=hive (hive_of initial)
        members=row[helm/supervisor/member] []
      = ;[message caps] (Recv[helm/supervisor/request] 0)
      ? (eq caps.len 0)
        | _ state index members
      = ;[next next_index joined answer]
          ? message
           > req=helm/supervisor/register
            = ;[roster ack] (helm/supervisor/enroll req state members)
            [state index roster ack]
           > card=helm/card/install
            | helm/supervisor/advance card state index members
           > card=helm/card/step
            | helm/supervisor/advance card state index members
           > card=helm/card/peek
            | helm/supervisor/advance card state index members
           > card=helm/card/journal
            | helm/supervisor/advance card state index members
           > card=helm/card/value
            | helm/supervisor/advance card state index members
           > card=helm/card/physical
            | helm/supervisor/advance card state index members
           > card=helm/card/debug
            | helm/supervisor/advance card state index members
      ; (Send caps.at(0) answer)
      ; (helm/supervisor/close_caps caps)
      | _ next next_index joined
+  feet
  '  Foot mailbox and namespace requests. The foot owns its loop.
  '  t extends each protocol with application-specific messages.
  +  task
    '  Messages received by the foot through Recv.
    (@ t)
    & feet/task/init
      feet/task/fact
      feet/task/page
      feet/task/journal
      feet/task/value
      feet/task/physical
      feet/task/debug
      feet/task/ack
      t
    +  init
      '  Initial %y binding and recipient-local coordinator handle.
      '  The startup wrapper resolves parent through capability transfer.
      : ax=axal[saga] parent=nat
    +  fact
      '  An update to the foot's own %y binding.
      : ax=axal[saga]
    +  page
      '  Answer to gift/peek, including absent or unknown paths.
      : pax=path axe=res[axal[saga]]
    +  journal
      '  Correlated, read-only bounded journal response.
      : request=nat result=either[iota helm/journal_page]
    + value
      ' Correlated immutable physical slot bytes; no namespace work.
      : request=nat result=either[iota value_read/chunk]
    + physical
      ' Already projected JSON, never the raw physical page or its pins.
      : request=nat result=either[iota str]
    + debug
      : request=nat result=either[iota debug_read/result]
    +  ack
      '  Write result: none on success, some error on rejection.
      : err=maybe[pail]
  +  gift
    '  Namespace requests sent to the parent supplied by task/init.
    (@ t)
    & feet/gift/install
      feet/gift/poke
      feet/gift/pass
      feet/gift/peek
      feet/gift/journal
      feet/gift/value
      feet/gift/physical
      feet/gift/debug
      t
    +  normalize
      '  The endpoint supplies the registered location, never the foot.
      \ home=path gift=feet/gift[unit]
      ^ maybe[helm/card]
      ? gift
       > (./install source version target)
        | ./some (helm/card/install source version target)
       > (./poke pax wit) (./some (helm/card/step pax wit))
       > (./pass pax wit) (./some (helm/card/step home.weld(pax) wit))
       > (./peek pax) (./some (helm/card/peek .y .none pax))
       > (./journal request before limit)
        | ./some (helm/card/journal request before limit)
       > (./value request query)
        | ./some (helm/card/value request query)
       > (./physical request query)
        | ./some (helm/card/physical request query)
       > (./debug request query)
        | ./some (helm/card/debug request query)
      .none
    + install
      : source=path version=nat target=path
    +  poke
      '  Submit a write at an absolute namespace path.
      : pax=path wit=writ
    +  pass
      '  Submit a write relative to the foot's namespace location.
      : pax=path wit=writ
    +  peek
      '  Read an absolute namespace path; answered by task/page.
      : pax=path
    +  journal
      '  Read physical /log keys without creating namespace work.
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + debug
      : request=nat query=debug_read/request
