-  sept
- grove_install
-  shrine_types
-  shrine
-  lain_types
-  lain_peek
-  lain_poke
- value_read
- physical_projection
- debug_read

+  helm
  +  journal_page
    '  One bounded physical /log snapshot at a captured sovereign epoch.
    '  view contains only the displayed child keys, including keys whose
    '  own record is absent or malformed. next is an exclusive epoch key.
    : epoch=nat before=maybe[nat] limit=nat total=nat next=maybe[nat] view=axal[saga]

  +  card
    &  helm/card/install
       helm/card/peek
       helm/card/journal
       helm/card/value
       helm/card/physical
       helm/card/debug
       helm/card/step
    + install
      : source=path version=nat target=path
    +  step
      : pax=path wit=writ
    +  peek
      : car=care cas=maybe[nat] pax=path
    +  journal
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + debug
      : request=nat query=debug_read/request

  +  supervisor
    '  Trusted bootstrap requests carry a transferred reply capability.
    '  Feet receive a dedicated endpoint bound to their registered path.
    '  Outbound moves and incomplete cascades are rejected atomically
    '  until outbound routing is installed. No persistence or actor discovery.
    +  request
      & helm/card/install
        helm/card/step
        helm/card/peek
        helm/card/journal
        helm/card/value
        helm/card/physical
        helm/card/debug
        helm/supervisor/register
    +  register
      '  Explicit bootstrap registration; duplicate or absent paths fail.
      : pax=path entry={\ feet/task/init nat}nat
    +  member
      : pax=path actor=nat binding=axal[saga]

    +  rejection
      : reason=iota

    +  denied
      \ reason=iota
      ^ feet/task[unit]
      | feet/task/ack
      | ./some (helm/supervisor/rejection reason)

    + step
      ' The candidate includes every reaction round and its journal entries.
      ' Unsupported transport or a failed cascade discards that candidate.
      \ target=path command=writ now=nat block=nat state=namespace index=hive
      ^ [state=namespace index=hive reply=feet/task[unit]]
      = [result next_index]
          | sovereign_cycle_with index (task/vine target command) 0 8 now block state
      ? result
       > (./fail why) [state index (helm/supervisor/denied why)]
       > (./spun next moves rounds ack spill)
         = problem=maybe[iota]
             ? spill
              > (./some why) (./some why)
             ? moves.len (./some 'outbound_not_supported)
             .none
         ? problem
          > (./some why) [state index (helm/supervisor/denied why)]
          > .none [next next_index (feet/task/ack .none)]

    + handle
      \ card=helm/card state=namespace index=hive
      ^ [namespace hive feet/task[unit]]
      ? card
       > (./install source version target)
         ? (grove_install/instantiate
             source version target state)
          > (./err why)
            [state index (helm/supervisor/denied why)]
          > (./ok next)
            [next (sovereign_hive next) (feet/task/ack .none)]
       > (./peek car cas target)
         [state index (feet/task/page target
           (namespace/page car cas target state))]
       > (./step target command)
         | helm/supervisor/step
           target command 0 0 state index

    + access
      (@@ s)
      : page={\ care maybe[nat] path s}res[axal[saga]]
        handle={\ helm/card s hive}[s hive feet/task[unit]]
        index={\ s}hive
        version={\ s}nat
        permit={\ path s}bool

    + local_access
      ^ helm/supervisor/access[namespace]
      | helm/supervisor/access[namespace]
        namespace/page helm/supervisor/handle
        sovereign_hive (\ state state.local.top)
        (\ target state (namespace/permitted target state))

    +  close_caps
      \ caps=row[nat]
      ^ nat
      | row/fold[nat nat] 0
        (\ ;ignored=nat handle=nat (CloseHandle handle)) caps

    +  start_foot
      '  Resolve the transferred endpoint in the foot's handle table.
      \ entry={\ feet/task/init nat}nat self=nat
      ^ nat
      = ;[initial caps] (Recv[feet/task/init] 0)
      | entry (feet/task/init initial.ax caps.at(0)) self

    +  endpoint
      '  The foot cannot supply or change its source path.
      '  Replies go directly to the registered foot, not a claimed sender.
      \ pax=path self=nat
      ^ nat
      = ;[initial caps] (Recv[nat] 0)
        server=nat caps.at(0)
        foot=nat caps.at(1)
      % ignored=nat 0
      = ;[gift extra] (Recv[feet/gift[unit]] 0)
      ; (helm/supervisor/close_caps extra)
      ? (feet/gift/normalize pax gift)
       > .none (_ 0)
       > (./some card)
        ; (SendCaps server card [foot])
        | _ 0

    +  notify_with
      (@ s)
      '  Compare committed %y snapshots. An absent binding is an empty tree.
      '  Preserve registry order and deliver updates before the write ack.
      \ access=helm/supervisor/access[s]
        state=s members=row[helm/supervisor/member]
      ^ row[helm/supervisor/member]
      = page access.page
      | members.fold []
      \ ;out=row[helm/supervisor/member] member=helm/supervisor/member
      ^ row[helm/supervisor/member]
      = binding=axal[saga]
          ? (page .y .none member.pax state)
           > (./known tree) tree
           > .null (axal/new[saga] .none)
           > .unknown (axal/new[saga] .none)
      ? (equal binding member.binding)
        out.snoc(member)
      ; (Send member.actor (feet/task/fact binding))
      | out.snoc member.set_binding(binding)

    +  enroll_with
      (@ s)
      '  Validate once, then spawn and transfer the bound endpoint.
      \ access=helm/supervisor/access[s]
        req=helm/supervisor/register state=s
        members=row[helm/supervisor/member]
      ^ [row[helm/supervisor/member] feet/task[unit]]
      = page access.page
        permit access.permit
      ? !(permit req.pax state)
        [members (helm/supervisor/denied 'foot_outside_authority)]
      ? members.any((\ mem (equal mem.pax req.pax)))
        [members (helm/supervisor/denied 'foot_already_registered)]
      ?> (./known binding)
          (page .y .none req.pax state)
        [members (helm/supervisor/denied 'foot_binding_absent)]
      = ;foot (Spawn (helm/supervisor/start_foot req.entry))
        ;port (Spawn (helm/supervisor/endpoint req.pax))
      ; (SendCaps port 0 [0 foot])
      ; (SendCaps foot (feet/task/init binding 0) [port])
      ; (CloseHandle port)
      = member (helm/supervisor/member req.pax foot binding)
      [members.snoc(member) (feet/task/ack .none)]

    +  advance_with
      (@ s)
      '  Deliver committed bindings before returning the reply.
      \ access=helm/supervisor/access[s]
        card=helm/card state=s index=hive
        members=row[helm/supervisor/member]
      ^ [s hive row[helm/supervisor/member] feet/task[unit]]
      = handle access.handle
        version access.version
      = ;[next next_index answer]
          | handle card state index
        ;updated
          ? (eq (version next) (version state)) members
          | helm/supervisor/notify_with[s] access next members
      [next next_index updated answer]

    +  run_with
      (@ s)
      '  Only bootstrap code receives this handle. Feet use endpoints.
      \ access=helm/supervisor/access[s] initial=s self=nat
      ^ nat
      = index_of access.index
      % state=s initial index=hive (index_of initial)
        members=row[helm/supervisor/member] []
      = ;[message caps] (Recv[helm/supervisor/request] 0)
      ? (eq caps.len 0)
        | _ state index members
      = ;[next next_index joined answer]
          ? message
           > req=helm/supervisor/register
            = ;[roster ack] (helm/supervisor/enroll_with[s] access req state members)
            [state index roster ack]
           > card=helm/card/install
            | helm/supervisor/advance_with[s] access card state index members
           > card=helm/card/step
            | helm/supervisor/advance_with[s] access card state index members
           > card=helm/card/peek
            | helm/supervisor/advance_with[s] access card state index members
      ; (Send caps.at(0) answer)
      ; (helm/supervisor/close_caps caps)
      | _ next next_index joined
    + run
      \ initial=namespace self=nat
      ^ nat
      ? (namespace/create initial.self initial.local initial.system)
       > (./err why) (error (helm/supervisor/rejection why))
       > (./ok checked)
         | helm/supervisor/run_with[namespace]
           helm/supervisor/local_access checked self

+  feet
  '  Foot mailbox and namespace requests. The foot owns its loop.
  '  t extends each protocol with application-specific messages.
  +  task
    '  Messages received by the foot through Recv.
    (@ t)
    & feet/task/init
      feet/task/fact
      feet/task/page
      feet/task/journal
      feet/task/value
      feet/task/physical
      feet/task/debug
      feet/task/ack
      t
    +  init
      '  Initial %y binding and recipient-local coordinator handle.
      '  The startup wrapper resolves parent through capability transfer.
      : ax=axal[saga] parent=nat
    +  fact
      '  An update to the foot's own %y binding.
      : ax=axal[saga]
    +  page
      '  Answer to gift/peek, including absent or unknown paths.
      : pax=path axe=res[axal[saga]]
    +  journal
      '  Correlated, read-only bounded journal response.
      : request=nat result=either[iota helm/journal_page]
    + value
      ' Correlated immutable physical slot bytes; no namespace work.
      : request=nat result=either[iota value_read/chunk]
    + physical
      ' Already projected JSON, never the raw physical page or its pins.
      : request=nat result=either[iota str]
    + debug
      : request=nat result=either[iota debug_read/result]
    +  ack
      '  Write result: none on success, some error on rejection.
      : err=maybe[pail]
  +  gift
    '  Namespace requests sent to the parent supplied by task/init.
    (@ t)
    & feet/gift/install
      feet/gift/poke
      feet/gift/pass
      feet/gift/peek
      feet/gift/journal
      feet/gift/value
      feet/gift/physical
      feet/gift/debug
      t
    +  normalize
      '  The endpoint supplies the registered location, never the foot.
      \ home=path gift=feet/gift[unit]
      ^ maybe[helm/card]
      ? gift
       > (./install source version target)
        | ./some (helm/card/install source version target)
       > (./poke pax wit) (./some (helm/card/step pax wit))
       > (./pass pax wit) (./some (helm/card/step home.weld(pax) wit))
       > (./peek pax) (./some (helm/card/peek .y .none pax))
       > (./journal request before limit)
        | ./some (helm/card/journal request before limit)
       > (./value request query)
        | ./some (helm/card/value request query)
       > (./physical request query)
        | ./some (helm/card/physical request query)
       > (./debug request query)
        | ./some (helm/card/debug request query)
      .none
    + install
      : source=path version=nat target=path
    +  poke
      '  Submit a write at an absolute namespace path.
      : pax=path wit=writ
    +  pass
      '  Submit a write relative to the foot's namespace location.
      : pax=path wit=writ
    +  peek
      '  Read an absolute namespace path; answered by task/page.
      : pax=path
    +  journal
      '  Read physical /log keys without creating namespace work.
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + debug
      : request=nat query=debug_read/request
