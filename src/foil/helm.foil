-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
'  Helm executes tasks and granted moves through one transition path, then
'  reconciles actors once against the final namespace. Actor dependencies
'  live in their ordinary /sys/crew slots and persist until changed.
+  rsvp
  '  The ack an actor receives for its command.
  &  rsvp/ok
     rsvp/no

  +  ok
    :  ack=maybe[path]

  +  no
    :  err=iota
+  driver_in
  '  Helm-to-driver protocol. Actor capabilities stay in the host adapter.
  &  driver_in/go
     driver_in/change
     driver_in/view
     driver_in/qres
     driver_in/ack
     driver_in/die
  +  go
    :  rec=res[myth]
  +  change
    :  p=path rec=res[myth]
  +  view
    :  d=dep rec=res[axal[myth]]
  +  qres
    :  p=path rec=res[myth]
  +  ack
    :  =rsvp
  +  die
    :
+  driver_out
  '  Driver-to-Helm requests. Reads return driver_in/qres; commands ack.
  &  driver_out/cmd
     driver_out/read
  +  cmd
    :  n=iota =task
  +  read
    :  p=path
+  duty
  '  One command to the shell: spawn an actor for a name (with its
  '  record), kill one, deliver a change (which watched path fired,
  '  and its record), or deliver an ack.
  &  duty/birth
     duty/fell
     duty/tell
     duty/ack
     duty/view

  +  birth
    :  n=iota rec=res[myth]

  +  fell
    :  n=iota

  +  tell
    :  n=iota wat=path rec=res[myth]

  +  view
    '  A y/z dependency answer; x dependencies use tell for host compatibility.
    :  n=iota d=dep rec=res[axal[myth]]

  +  ack
    :  n=iota =rsvp
+  io_root
  '  Where the driver looks.
  ^  path
  ['io]
+  io_path
  '  The namespace path of one driven name.
  \  n=iota
  ^  path
  ['io n]
+  has_name
  '  Compatibility name for deep row membership, including the name's aura.
  row/has[iota]
+  io_bound
  '  Only moves into the driver subtree pass through the outbound gate.
  \  dst=path
  ^  bool
  dst.starts('io)
+  granted_fetch
  '  Walk from src to the root, accepting the first nonzero fetch grant.
  '  Mounts put ['grants 'fetch] on their app card, so grants follow
  '  the emitting subtree wherever it is rooted.  Missing or zero slots
  '  continue the search; they do not revoke an ancestor's grant.
  '  With no grant anywhere above the source, the move stays dropped.
  \  src=path s=sov
  ^  bool
  %  i=nat src.len.inc
  ?  (eq i 0)
     .false
  =  hit
       ?  s.x_latest(src.take(i.dec))
        > (./known t=myth)  t.nat_at(['grants 'fetch] 0)
        > .null  0
        > .unknown  0
  ?  hit
     .true
  (_ i.dec)
+  delivery_issue
  '  A failed outbound event or its reactive cascade; earlier commits stand.
  :  dst=path err=iota
+  helm
  '  The sovereign, actor dependencies, actor incarnation counters, and the
  '  kernel dependency index. The sovereign stays first for the host ABI.
  :  =sov watches=hive crew=uon[nat] =hive
  +  scan
    '  Only live immediate /io records are actors; structural spines are not.
    \ s=sov
    ^ path
    = sub | s.idx.dip io_root
    | sub.kid_keys.keep
    \ n
    ?=((./known _) s.x_latest((io_path n)))
  +  crew_of
    '  x shape counts distinguish removal/recreation from ordinary updates.
    \ names=path s=sov
    ^ uon[nat]
    | names.fold (uon/empty)
    \ acc n
    | acc.put n s.ever_at((io_path n)).x.lock.shape
  +  watches_of
    '  Own-record updates plus the actor's declared cared dependencies.
    \ names=path s=sov
    ^ hive
    | names.fold (axal/new[row[dep]] .none)
    \ acc n
    = pax | io_path n
      declared=row[dep]
        ? s.x_latest(pax)
         > (./known t) (node_deps t)
        []
    = own=row[dep] [(dep .x pax)]
    | acc.put pax (row/uniq[dep] own.weld(declared))
  +  request_crew
    '  HTTP workers publish their complete pending-request dependency set
    '  as an ordinary namespace task. No separate watch-registration protocol.
    \ n=iota paths=row[path]
    ^ task
    = deps=crew
        | paths.fold (mop/empty)
        \ acc p
        | acc.put p (dep .x p)
    | task/vine (io_path n)
    | writ/poke
    | myth/sing crew_slot (cpail deps)
  +  births_for
    \ names=path s=sov
    ^ row[duty]
    | names.map
    \ n
    | duty/birth n s.x_latest((io_path n))
  +  notification
    \ n=iota d=dep s=sov
    ^ duty
    ? d.c
     > .x
       = answer=res[myth]
           ? (view .x 0 d.p s)
            > (./known tree)
              ? tree.fil
               > (./some t) (./known t)
              .unknown
            > .null .null
            > .unknown .unknown
       | duty/tell n d.p answer
    | duty/view n d (view d.c 0 d.p s)
  +  changed
    '  Translate derived dependencies against both ends of the batch.
    \ d=dep signs=axal[sign] before=sov after=sov
    ^ bool
    = triggers=row[dep]
        ? (is_o d.p)
          (o_trigger d.p before).weld((o_trigger d.p after))
        ? (is_xv d.p)
          (xv_trigger d.p before).weld((xv_trigger d.p after))
        ? (is_h d.p) []
        [d]
    | triggers.any
    \ t
    ? signs.get(t.p)
     > (./some g) (fires t.c g)
    .false
  +  notifications
    '  New dependencies hydrate immediately. Existing dependencies invalidate
    '  at most once per batch. Birth already carries the actor's own record.
    \ names=path born=path watches=hive signs=axal[sign] before=helm after=helm
    ^ row[duty]
    | names.bind
    \ n
    = pax | io_path n
      fresh | born.has n
      old=row[dep]
        ? fresh []
        before.watches.gut(pax [])
    | watches.gut(pax []).sift
    \ d
    ^ maybe[duty]
    ? fresh
      ? (equal d (dep .x pax)) .none
      | ./some (helm/notification n d after.sov)
    ? (old.has(d))
      ? !(helm/changed d signs before.sov after.sov) .none
      | ./some (helm/notification n d after.sov)
    | ./some (helm/notification n d after.sov)
  +  boot
    \ s=sov
    ^ [hm=helm out=row[duty]]
    = names | helm/scan s
      watches | helm/watches_of names s
      h | helm s watches (helm/crew_of names s) (hive_of s)
      empty | helm s (axal/new[row[dep]] .none) (uon/empty) h.hive
      initial | helm/notifications names names watches (axal/new[sign] .none) empty h
    [h (helm/births_for names s).weld(initial)]
  +  signs
    '  Preserve every care that changed, including changes later reverted.
    \ rounds=row[axal[sign]]
    ^ axal[sign]
    | rounds.fold (axal/new[sign] .none)
    \ acc round
    | round.tap.fold acc
    \ out [p g]
    = old | out.gut p (sign 0 0 0)
    | out.put p (sign (nmax old.x g.x) (nmax old.y g.y) (nmax old.z g.z))
  +  reconcile
    '  Final membership with incarnation-aware restarts, then final answers.
    \ before=helm signs=axal[sign] after=helm
    ^ [hm=helm out=row[duty]]
    = names | helm/scan after.sov
      crew | helm/crew_of names after.sov
      restarted=path
        | names.keep
        \ n
        ? !(before.crew.has(n)) .false
        | gt crew.gut(n 0) before.crew.gut(n 0)
      dead | before.crew.keys.keep (\ n (!(names.has(n)) || restarted.has(n)))
      born | names.keep (\ n (!(before.crew.has(n)) || restarted.has(n)))
      watches | helm/watches_of names after.sov
      tells | helm/notifications names born watches signs before after
      fells=row[duty] | dead.map (\ n (duty/fell n))
      births | helm/births_for born after.sov
    [(helm after.sov watches crew after.hive) fells.weld(births).weld(tells)]
  +  run
    '  The sole execution path: sovereign and kernel index advance together.
    \ t=task h=helm
    ^ [hm=helm result=gyre]
    = [result index] | cycle_with h.hive t 0 8 h.sov
    ? result
     > (./fail _) [h result]
     > (./spun state _ _ _ _)
       [h.set_sov(state).set_hive(index) result]
  +  moves
    '  Each allowed move is an independent event. Secondary effects remain
    '  undelivered (one hop); failures are retained with their destinations.
    \ h=helm fx=row[move]
    ^ [mh=helm rounds=row[axal[sign]] issues=row[delivery_issue]]
    | fx.fold [h [] []]
    \ [current rounds issues] m
    ^ [mh=helm rounds=row[axal[sign]] issues=row[delivery_issue]]
    ? !(io_bound m.dst) [current rounds issues]
    ? !(granted_fetch m.src current.sov) [current rounds issues]
    = [next result] | helm/run (task/vine m.dst m.w) current
    ? result
     > (./fail err)
       [next rounds issues.snoc((delivery_issue m.dst err))]
     > (./spun _ _ more _ spill)
       = problems
           ? spill
            > (./some err) issues.snoc((delivery_issue m.dst err))
           issues
       [next rounds.weld(more) problems]
  +  answer
    \ src=maybe[iota] reply=rsvp spill=maybe[iota] issues=row[delivery_issue] duties=row[duty] h=helm
    ^ [hm=helm out=row[duty] =rsvp spill=maybe[iota] issues=row[delivery_issue]]
    = out
        ? src
         > (./some n) duties.snoc((duty/ack n reply))
        duties
    [h out reply spill issues]
  +  exec
    '  Run the driving task and its granted moves, reconcile once, ack last.
    '  Move failures never turn an already committed driving task into a nack.
    \ src=maybe[iota] t=task h=helm
    ^ [hm=helm out=row[duty] =rsvp spill=maybe[iota] issues=row[delivery_issue]]
    = [updated result] | helm/run t h
    ? result
     > (./fail err)
       | helm/answer src (rsvp/no err) .none [] [] h
     > (./spun _ effects rounds ack spill)
       = [moved more issues] | helm/moves updated effects
         signs | helm/signs rounds.weld(more)
         [settled duties] | helm/reconcile h signs moved
       | helm/answer src (rsvp/ok ack) spill issues duties settled
