-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
'  helm: the IO driver core — a pure state machine between the lain
'  kernel and the host's actors.  The shell executes duties and
'  shuttles messages; it decides nothing.
'  .
'  The helm tracks the /io subnamespace, one actor per name under it:
'  a name's birth spawns an actor (carrying its record), a change
'  tells the actor its new record, a removal fells it.  Actors send
'  tasks back through the shell into the full namespace, and every
'  task is acked to its sender — the command's path tag, or the
'  failure.  Watching rides /react: one-shot eyes on /io (membership,
'  y care) and on each /io name (content, x care), re-armed every
'  pulse.  Outbound kernel moves are dropped in this port (xeno
'  delivery is a later round).
+  rsvp
  '  The ack an actor receives for its command.
  &  rsvp/ok
     rsvp/no

  +  ok
    :  ack=maybe[path]

  +  no
    :  err=iota
+  duty
  '  One command to the shell: spawn an actor for a name (with its
  '  record), kill one, deliver a change (which watched path fired,
  '  and its record), or deliver an ack.
  &  duty/birth
     duty/fell
     duty/tell
     duty/ack

  +  birth
    :  n=iota rec=res[myth]

  +  fell
    :  n=iota

  +  tell
    :  n=iota wat=path rec=res[myth]

  +  ack
    :  n=iota =rsvp
+  io_root
  '  Where the driver looks.
  ^  path
  ['io]
+  io_path
  '  The namespace path of one driven name.
  \  n=iota
  ^  path
  ['io n]
+  has_name
  \  n=iota names=path
  ^  nat
  |  > i=nat 0
  ?  (eq i names.len)
     0
  ?  (eq_iota names.at(i) n)
     1
  (_ i.inc)
+  helm
  '  Driver state: the sovereign, the armed
  '  watches, the live-name set (a uon keyed by name; the value
  '  is unused), and the kernel's crew index — derived once when the
  '  helm is taken and bumped by every event thereafter, so a
  '  reactive round never re-walks the namespace.  The sovereign
  '  stays FIRST: the shell reads it positionally.
  :  =sov =eyes crew=uon[nat] =hive
  +  scan
    '  The live names under /io — peek already drops tombstones.
    \  s=sov
    ^  path
    =  > sub (peek io_root s)
    sub.kid_keys
  +  crew_of
    \  names=path
    ^  uon[nat]
    |  > i=nat 0  > acc=uon[nat] (uon/empty)
    ?  (eq i names.len)
       acc
    (_ i.inc acc.put(names.at(i) 0))
  +  arm
    '  Watches for the crew: membership on /io (y: kids moving),
    '  content on each name (x: its own data).  Puts are idempotent
    '  over surviving entries.
    \  names=path ey=eyes
    ^  eyes
    =  > root io_root
    =  > e1 ey.put(root [(dep .y root)])
    |  > i=nat 0  > acc=eyes e1
    ?  (eq i names.len)
       acc
    =  > pn (io_path names.at(i))
    (_ i.inc acc.put(pn [(dep .x pn)]))
  +  births_for
    '  Birth duties for names, each carrying its latest record.
    \  names=row[iota] s=sov
    ^  row[duty]
    =  > nod=row[duty] []
    names.fold(nod ;
      \  acc=row[duty] n=iota
      =  > r s.x_latest((io_path n))
      acc.snoc((duty/birth n r)))
  +  boot
    '  Take the helm: birth an actor for every existing name, arm
    '  the watches, and derive the kernel's crew index once — a
    '  seeded or resumed sovereign arrives with crews already in it,
    '  and this is the only full walk the driver ever pays.
    \  s=sov
    ^  [hm=helm out=row[duty]]
    =  > names (helm/scan s)
    =  > outs (helm/births_for names s)
    =  > ey (helm/arm names (axal/new[row[dep]] .none))
    [(helm s ey (helm/crew_of names) (hive_of s)) outs]
  +  pulse
    '  Digest one event's signs: membership first (fells, then
    '  births), tells for surviving fired names, and re-arm every
    '  fired watch.
    \  signs=axal[sign] h=helm
    ^  [hm=helm out=row[duty]]
    =  > rr (react signs h.eyes)
    =  > s h.sov
    =  > root io_root
    =  > olds h.crew.keys
    =  > memb
         ?  news.get(root)
          > (./some ds=row[dep])  1
          > .none  0
    =  > names2
         ?  memb
            (helm/scan s)
         olds
    =  > nod=row[duty] []
    =  > fells
         olds.fold(nod ;
           \  acc=row[duty] n=iota
           ?  (has_name n names2)
              acc
           acc.snoc((duty/fell n)))
    =  > births
         names2.fold(nod ;
           \  acc=row[duty] n=iota
           ?  h.crew.has(n)
              acc
           =  > r s.x_latest((io_path n))
           acc.snoc((duty/birth n r)))
    =  > tells
         news.tap.fold(nod ;
           \  acc=row[duty] [wat ds]
           ds.fold(acc ;
             \  a2=row[duty] e=dep
             =  > w e.p
             ?  !(eq 2 w.len)
                a2
             ?  !(eq_iota w.at(0) 'io)
                a2
             =  > n w.at(1)
             ?  !(has_name n names2)
                a2
             =  > r s.x_latest(wat)
             a2.snoc((duty/tell n wat r))))
    =  > ey2 (helm/arm names2 rest)
    =  > d1 fells.weld(births)
    =  > d2 d1.weld(tells)
    [(helm s ey2 (helm/crew_of names2) h.hive) d2]
  +  spy
    '  Arm a one-shot watch for a named actor on any path: the next
    '  change there tells n once, then the watch is consumed —
    '  workers re-spy for more (lazy reactivity).
    \  n=iota pax=path h=helm
    ^  helm
    h.set_eyes(h.eyes.put(pax [(dep .x (io_path n))]))
  +  exec
    '  Run one task through the reactive cycle (crew-derived hears
    '  cascade until quiet, fuel 8): the sovereign advances, every
    '  round's signs pulse the driver's own eyes, and the source
    '  actor (when named) is acked last.  The outcome ALSO returns
    '  directly (rsvp: anonymous tasks have no ack duty, but their
    '  senders still deserve the verdict), along with any cascade
    '  spill the gyre surfaced — the driver reports it.
    \  src=maybe[iota] t=task h=helm
    ^  [hm=helm out=row[duty] =rsvp spill=maybe[iota]]
    =  [g=gyre hv2=hive]  (cycle_with h.hive t 0 8 h.sov)
    ?  g
     > (./fail e=iota)
       =  > rn (rsvp/no e)
       ?  src
        > (./some n=iota)
          =  > d0 [(duty/ack n rn)]
          [h d0 rn .none]
        > .none  [h [] rn .none]
     > (./spun s2=sov fx=row[move] rounds=row[axal[sign]] a=maybe[path] spill=maybe[iota])
       =  > h1 h.set_sov(s2).set_hive(hv2)
       =  > pr
            |  > i=nat 0  > hh=helm h1  > ds=row[duty] []
            ^  [h2=helm ds2=row[duty]]
            ?  (eq i rounds.len)
               [hh ds]
            =  > r2 (helm/pulse rounds.at(i) hh)
            (_ i.inc hm ds.weld(out))
       =  > rk (rsvp/ok a)
       ?  src
        > (./some n=iota)
          =  > d3 ds2.snoc((duty/ack n rk))
          [h2 d3 rk spill]
        > .none  [h2 ds2 rk spill]
