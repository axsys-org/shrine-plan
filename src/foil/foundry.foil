-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
-  surface_tree [order=40]
'  foundry: renderer-neutral projection orchestration.  Durable source
'  identity stays in the namespace; a request, its hydrated surface artifact,
'  and the /o recipe chain are ordinary ephemeral values.  This module
'  owns neither renderer payloads nor action authority.
+  foundry
  +  backend
    '  Pronunciation families understood by recipe negotiation.  The
    '  value rides request records as an iota; backend code lives in
    '  terminal felt adapters, never here.
    +  neutral
      ^  iota
      'neutral
    +  web
      ^  iota
      'web
    +  text
      ^  iota
      'text
    +  webgpu
      ^  iota
      'webgpu

  +  mode
    +  full
      ^  iota
      'full
    +  compact
      ^  iota
      'compact
    +  preview
      ^  iota
      'preview
    +  edit
      ^  iota
      'edit
    +  inspect
      ^  iota
      'inspect

  +  request
    '  One ephemeral projection request.  Source and role are semantic
    '  namespace references; the ceiling bounds composition, backend
    '  selects a pronunciation, and features only narrow realization.
    :  source=path
       role=path
       mode=iota
       ceiling=iota
       backend=iota
       pronunciation=path
       features=row[path]

  +  layer
    '  One Foundry fragment.  Values use semantic token paths as myth
    '  slots.  Broad layers precede near layers.  Guarded layers are
    '  applied last; accessibility is the intended guarded use.
    :  name=path values=myth guarded=bool

  +  cascade_winner
    '  Exact evidence for one resolved semantic token.  `ordinal` is the
    '  layer's authored position before guarded layers are replayed last;
    '  consequently inspection does not have to infer provenance from map
    '  traversal or from the winning value.
    :  slot=path layer=path guarded=bool ordinal=nat

  +  hydration
    '  Resolved semantic values, the compatibility token -> layer map, and
    '  exact winner evidence.  The typed winners retain guarded state and
    '  authored ordinal instead of collapsing provenance to a bare path.
    :  values=myth provenance=myth winners=row[foundry/cascade_winner]

  +  step
    '  One already-resolved immutable recipe and the structural kind it
    '  may produce.  Zoo owns selection; this value is the small typed
    '  handoff into the compiler.
    :  recipe=path kind=iota

  +  diagnostic
    '  Stable compiler/refusal evidence.  `at` names the recipe or
    '  semantic source implicated by the code; detail is human-facing.
    :  code=iota at=path detail=nat

  +  fallback
    '  One explicit fallback edge.  Semantic, renderer, and progressive
    '  fallbacks preserve structural kind; structural fallbacks may only
    '  reduce it.  A refusal is deliberately not a fallback class.
    :  class=iota target=path from_kind=iota to_kind=iota

  +  fallback_edge
    '  One declared edge in the fallback graph.  Row order is semantic:
    '  callers preserve authored Recipe order and this kernel never consults
    '  map iteration.  observations and actions describe the authority left
    '  at the target and therefore may only narrow while traversing.
    :  source=path
       rule=foundry/fallback
       observations=row[path]
       actions=row[path]

  +  fallback_candidate
    :  source=path
       current=path
       kind=iota
       class=iota
       chain=row[path]
       stack=row[path]
       observations=row[path]
       actions=row[path]

  +  fallback_trace
    '  Exact successful evidence: selected target, class of the selecting
    '  edge, complete semantic chain, and the attenuated authority surface.
    :  source=path
       selected=path
       class=iota
       chain=row[path]
       observations=row[path]
       actions=row[path]

  +  fallback_expansion
    &  foundry/fallback_expansion/selected
       foundry/fallback_expansion/queued
       foundry/fallback_expansion/refused

    +  selected
      :  trace=foundry/fallback_trace
    +  queued
      :  candidates=row[foundry/fallback_candidate]
    +  refused
      :  diagnostic=foundry/diagnostic

  +  fallback_walk_result
    &  foundry/fallback_walk_result/selected
       foundry/fallback_walk_result/missed
       foundry/fallback_walk_result/refused

    +  selected
      :  trace=foundry/fallback_trace
    +  missed
      :
    +  refused
      :  diagnostic=foundry/diagnostic

  +  fallback_resolution
    '  Public total result.  Failure to realize every declared alternative is
    '  refusal evidence; a silent or renderer-invented default is impossible.
    &  foundry/fallback_resolution/selected
       foundry/fallback_resolution/refused

    +  selected
      :  trace=foundry/fallback_trace
    +  refused
      :  diagnostic=foundry/diagnostic

  +  slot_contract
    '  A Slot is an attachment contract, not layout space.  `one` and
    '  `many` bound cardinality; `required` owns the minimum.  Participation
    '  is a semantic role and grants no action authority.
    :  role=path
       accepts=row[iota]
       cardinality=iota
       required=bool
       fallback=maybe[foundry/fallback]
       participation=path

  +  slot_outcome
    '  Total Slot validation.  Missing optional Slots disappear, declared
    '  compatible fallbacks remain explicit, and every malformed or missing
    '  required realization becomes stable refusal evidence.
    &  foundry/slot_outcome/resolved
       foundry/slot_outcome/fallback
       foundry/slot_outcome/omitted
       foundry/slot_outcome/refused

    +  resolved
      :  attachments=row[iota]
    +  fallback
      :  rule=foundry/fallback
    +  omitted
      :
    +  refused
      :  diagnostic=foundry/diagnostic

  +  plan
    '  A compiled ephemeral projection.  An empty diagnostic row means
    '  the report is runnable.  A refused plan stays at the source path
    '  and carries no recipes, so no caller can accidentally execute a
    '  partially admitted hierarchy.
    :  req=foundry/request
       report=path
       recipes=row[path]
       diagnostics=row[foundry/diagnostic]

  +  projection
    '  A catalog-selected projection plan plus the terminal Zoo operation.
    '  The catalog and layer references are durable authoring identity;
    '  the plan/report remains an ephemeral request realization.
    :  plan=foundry/plan terminal=path catalog=path layers=row[path]

  +  surface_artifact
    '  A tree-shaped authoring/compiler artifact.  This value may be useful
    '  while recipes and hydration layers are still being resolved, but it
    '  is not a delivery packet and carries no occurrence identity or
    '  revision boundary.  Foundry delivery begins only after compilation
    '  into foundry_delivery/projection_dag.
    :  req=foundry/request
       tree=surface_tree
       hyd=foundry/hydration
       unresolved=row[path]
       diagnostics=row[foundry/diagnostic]

  +  cache_key
    '  Every input that may change a realized surface artifact.  report_case
    '  invalidates on live source movement; the nested report already
    '  pins immutable recipe cases.  Hydration lists immutable fragment
    '  refs, while backend/pronunciation/features distinguish terminal
    '  negotiation without entering the SurfaceTree.
    :  report=path
       report_case=nat
       hydration=row[path]
       backend=iota
       pronunciation=path
       features=row[path]

  +  cache_entry
    '  A content-pinned compiler artifact under its complete ephemeral key.
    '  This cache is upstream of addressed projection delivery.
    :  key=foundry/cache_key held=pin[foundry/surface_artifact]

  +  cache
    '  A pure worker-local compiler cache.  Nothing here is admitted to
    '  the namespace; returning a new cache value makes ownership and
    '  eviction policy mechanical at the host boundary.
    :  entries=row[foundry/cache_entry] hits=nat misses=nat limit=nat

  +  cache_read
    :  value=maybe[foundry/surface_artifact] next=foundry/cache

  '  Runtime construction gates.  Foil source can invoke nominal
  '  constructors directly; untyped Reaver and host integrations use
  '  these entries so they receive values rather than reflected types.
  +  make_request
    \  source=path role=path mode=iota ceiling=iota backend=iota
       pronunciation=path features=row[path]
    ^  foundry/request
    (foundry/request source role mode ceiling backend pronunciation features)
  +  make_step
    \  recipe=path kind=iota
    ^  foundry/step
    (foundry/step recipe kind)
  +  make_layer
    \  name=path values=myth guarded=bool
    ^  foundry/layer
    (foundry/layer name values guarded)
  +  make_fallback
    \  class=iota target=path from_kind=iota to_kind=iota
    ^  foundry/fallback
    (foundry/fallback class target from_kind to_kind)
  +  make_fallback_edge
    \  source=path rule=foundry/fallback observations=row[path]
       actions=row[path]
    ^  foundry/fallback_edge
    (foundry/fallback_edge source rule observations actions)
  +  make_slot_contract
    \  role=path accepts=row[iota] cardinality=iota required=bool
       fallback=maybe[foundry/fallback] participation=path
    ^  foundry/slot_contract
    (foundry/slot_contract role accepts cardinality required fallback
      participation)
  +  make_cache_key
    \  report=path report_case=nat hydration=row[path] backend=iota
       pronunciation=path features=row[path]
    ^  foundry/cache_key
    (foundry/cache_key report report_case hydration backend pronunciation
      features)
  +  text_record
    \  slot=path body=nat
    ^  myth
    (myth/new).put(slot (pails/t body))
  +  text_layer
    \  name=path slot=path body=nat guarded=bool
    ^  foundry/layer
    (foundry/layer name (foundry/text_record slot body) guarded)

  +  rank
    '  Composition rank for a projection ceiling.
    \  k=iota
    ^  nat
    ?  (eq_iota k 'glyph)
       0
    ?  (eq_iota k 'text)
       0
    ?  (eq_iota k 'block)
       1
    ?  (eq_iota k 'plate)
       2
    ?  (eq_iota k 'scene)
       3
    ?  (eq_iota k 'stage)
       4
    0

  +  surface_kind
    '  Kinds a Slot may accept or a fallback may preserve/reduce.  Slot is
    '  excluded because it is the attachment contract, not its attachment.
    \  k=iota
    ^  bool
    =  kinds=row[iota]  ['glyph 'text 'block 'plate 'scene 'stage]
    kinds.any((\ q (eq_iota k q)))

  +  has_kind
    \  k=iota kinds=row[iota]
    ^  bool
    kinds.any((\ q (eq_iota k q)))

  +  fallback_class
    \  class=iota
    ^  bool
    =  classes=row[iota]  ['semantic 'structural 'renderer 'progressive]
    classes.any((\ q (eq_iota class q)))

  +  slot_cardinality
    \  cardinality=iota
    ^  bool
    ?  (eq_iota cardinality 'one)   .true
    ?  (eq_iota cardinality 'many)  .true
    .false

  +  fallback_issue
    '  Validate the laws common to every explicit fallback edge.  This is
    '  structural/presentation policy only; capability attenuation remains
    '  outside Foundry and therefore cannot be widened here.
    \  f=foundry/fallback ceiling=iota at=path
    ^  maybe[foundry/diagnostic]
    ?  !(foundry/fallback_class f.class)
       (./some (foundry/diagnostic 'fallback_class_invalid at
         "fallback class must be semantic, structural, renderer, or progressive"))
    ?  (eq 0 f.target.len)
       (./some (foundry/diagnostic 'fallback_target_required at
         "fallback edges must name an explicit target"))
    ?  !(foundry/surface_kind f.from_kind)
       (./some (foundry/diagnostic 'fallback_kind_invalid at
         "fallback source kind is not a semantic Surface kind"))
    ?  !(foundry/surface_kind f.to_kind)
       (./some (foundry/diagnostic 'fallback_kind_invalid at
         "fallback target kind is not a semantic Surface kind"))
    ?  !(foundry/within f.to_kind ceiling)
       (./some (foundry/diagnostic 'fallback_ceiling_refused at
         "fallback output exceeds the current projection ceiling"))
    ?  (gt (foundry/rank f.to_kind) (foundry/rank f.from_kind))
       (./some (foundry/diagnostic 'fallback_widened at
         "fallback output cannot widen structural composition"))
    ?  !(eq_iota f.class 'structural)
       ?  !(eq_iota f.from_kind f.to_kind)
          (./some (foundry/diagnostic 'fallback_kind_changed at
            "only an explicit structural fallback may reduce kind"))
       .none
    .none

  +  path_in
    \  needle=path hay=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i hay.len)  .false
    ?  (eq_pith needle hay.at(i))  .true
    (_ i.inc)

  +  paths_subset
    '  Set containment over semantic paths; row order does not affect the
    '  answer and duplicate declarations grant nothing new.
    \  subset=row[path] superset=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i subset.len)  .true
    ?  !(foundry/path_in subset.at(i) superset)  .false
    (_ i.inc)

  +  fallback_edge_issue
    \  candidate=foundry/fallback_candidate edge=foundry/fallback_edge
       ceiling=iota
    ^  maybe[foundry/diagnostic]
    ?  !(eq_iota candidate.kind edge.rule.from_kind)
       (./some (foundry/diagnostic 'fallback_source_kind_mismatch
         edge.source "fallback edge source kind does not match traversal state"))
    ?  (foundry/fallback_issue edge.rule ceiling edge.source)
     > (./some issue=foundry/diagnostic)  (./some issue)
     > .none
       ?  !(foundry/paths_subset edge.observations candidate.observations)
          (./some (foundry/diagnostic 'fallback_observation_widened
            edge.rule.target
            "fallback cannot add observations absent from its source"))
       ?  !(foundry/paths_subset edge.actions candidate.actions)
          (./some (foundry/diagnostic 'fallback_action_widened
            edge.rule.target
            "fallback cannot add actions absent from its source"))
       .none

  +  expand_fallback_candidate
    '  Expand one candidate in authored edge order.  Child candidates retain
    '  that order; the walker prepends them so the first declared alternative
    '  and its complete chain are exhausted before a later sibling.
    \  candidate=foundry/fallback_candidate
       edges=row[foundry/fallback_edge]
       known=row[path] ceiling=iota
    ^  foundry/fallback_expansion
    |  > i=nat 0  > out=row[foundry/fallback_candidate] []
    ?  (ge i edges.len)
       (foundry/fallback_expansion/queued out)
    =  edge  edges.at(i)
    ?  !(eq_pith candidate.current edge.source)
       (_ i.inc out)
    ?  (foundry/fallback_edge_issue candidate edge ceiling)
     > (./some issue=foundry/diagnostic)
       (foundry/fallback_expansion/refused issue)
     > .none
       =  target  edge.rule.target
       ?  (foundry/path_in target candidate.stack)
          (foundry/fallback_expansion/refused
            (foundry/diagnostic 'fallback_cycle target
              "fallback declarations must form an acyclic graph"))
       ?  !(foundry/path_in target known)
          (foundry/fallback_expansion/refused
            (foundry/diagnostic 'fallback_target_missing target
              "fallback target is not an admitted semantic definition"))
       =  chain  candidate.chain.snoc(target)
       =  next
            (foundry/fallback_candidate candidate.source target
              edge.rule.to_kind edge.rule.class chain
              candidate.stack.snoc(target)
              edge.observations edge.actions)
       (_ i.inc out.snoc(next))

  +  walk_fallback_candidates
    \  candidates=row[foundry/fallback_candidate]
       edges=row[foundry/fallback_edge]
       known=row[path] available=row[path] ceiling=iota
    ^  foundry/fallback_walk_result
    |  > pending=row[foundry/fallback_candidate] candidates
    ?  (eq 0 pending.len)
       (foundry/fallback_walk_result/missed)
    =  candidate  pending.at(0)
       rest       pending.drop(1)
    ?  (if (gt candidate.chain.len 1)
           (foundry/path_in candidate.current available)
           .false)
       (foundry/fallback_walk_result/selected
         (foundry/fallback_trace candidate.source candidate.current
           candidate.class candidate.chain candidate.observations
           candidate.actions))
    ?  (foundry/expand_fallback_candidate candidate edges known ceiling)
     > x=foundry/fallback_expansion/selected
       (foundry/fallback_walk_result/selected x.trace)
     > x=foundry/fallback_expansion/refused
       (foundry/fallback_walk_result/refused x.diagnostic)
     > x=foundry/fallback_expansion/queued
       (_ x.candidates.weld(rest))

  +  resolve_fallbacks
    '  Resolve only after the exact semantic realization is unavailable.
    '  The declared edge row controls selection.  known and available are
    '  membership sets, so changing their row order cannot change the result.
    \  source=path kind=iota ceiling=iota observations=row[path]
       actions=row[path] known=row[path] available=row[path]
       edges=row[foundry/fallback_edge]
    ^  foundry/fallback_resolution
    =  initial
         (foundry/fallback_candidate source source kind 'semantic [source]
           [source] observations actions)
    ?  (foundry/walk_fallback_candidates [initial] edges known available
          ceiling)
     > x=foundry/fallback_walk_result/selected
       (foundry/fallback_resolution/selected x.trace)
     > x=foundry/fallback_walk_result/refused
       (foundry/fallback_resolution/refused x.diagnostic)
     > foundry/fallback_walk_result/missed
       (foundry/fallback_resolution/refused
         (foundry/diagnostic 'fallback_exhausted source
           "no declared fallback realization is available"))

  +  slot_refused
    \  slot=foundry/slot_contract code=iota detail=nat
    ^  foundry/slot_outcome
    (foundry/slot_outcome/refused
      (foundry/diagnostic code slot.role detail))

  +  resolve_slot
    '  Validate one Slot against its already-admitted attachment kinds.
    '  Equal inputs are total and deterministic: resolved, explicit fallback,
    '  omitted optional Slot, or refusal.  No default role is invented.
    \  slot=foundry/slot_contract attachments=row[iota] ceiling=iota
       fallback_available=bool
    ^  foundry/slot_outcome
    ?  (eq 0 slot.role.len)
       (foundry/slot_refused slot 'slot_role_required
         "Slot contracts require a semantic role")
    ?  (eq 0 slot.accepts.len)
       (foundry/slot_refused slot 'slot_accepts_required
         "Slot contracts require at least one accepted attachment kind")
    ?  !(foundry/slot_cardinality slot.cardinality)
       (foundry/slot_refused slot 'slot_cardinality_invalid
         "Slot cardinality must be one or many")
    ?  (eq 0 slot.participation.len)
       (foundry/slot_refused slot 'slot_participation_required
         "Slot participation must name a semantic role")
    =  invalid_accept
         |  > i=nat 0
         ^  bool
         ?  (ge i slot.accepts.len)  .false
         ?  !(foundry/surface_kind slot.accepts.at(i))  .true
         (_ i.inc)
    ?  invalid_accept
       (foundry/slot_refused slot 'slot_accepts_invalid
         "Slot accepts contains a non-Surface attachment kind")
    ?  slot.fallback
     > (./some rule=foundry/fallback)
       ?  (foundry/fallback_issue rule ceiling slot.role)
        > (./some issue=foundry/diagnostic)
          (foundry/slot_outcome/refused issue)
        > .none
          ?  !(foundry/has_kind rule.to_kind slot.accepts)
             (foundry/slot_refused slot 'fallback_incompatible
               "fallback output is not accepted by the Slot")
          (foundry/resolve_slot_attachments slot attachments ceiling
            fallback_available)
     > .none
       (foundry/resolve_slot_attachments slot attachments ceiling
         fallback_available)

  +  resolve_slot_attachments
    \  slot=foundry/slot_contract attachments=row[iota] ceiling=iota
       fallback_available=bool
    ^  foundry/slot_outcome
    =  invalid_attachment
         |  > i=nat 0
         ^  bool
         ?  (ge i attachments.len)  .false
         =  kind  attachments.at(i)
         ?  !(foundry/surface_kind kind)  .true
         ?  !(foundry/has_kind kind slot.accepts)  .true
         ?  !(foundry/within kind ceiling)  .true
         (_ i.inc)
    ?  invalid_attachment
       (foundry/slot_refused slot 'slot_attachment_incompatible
         "Slot attachment kind is unaccepted or exceeds the ceiling")
    ?  (eq_iota slot.cardinality 'one)
       ?  (gt attachments.len 1)
          (foundry/slot_refused slot 'slot_cardinality_exceeded
            "single-cardinality Slot received more than one attachment")
       (foundry/finish_slot slot attachments fallback_available)
    (foundry/finish_slot slot attachments fallback_available)

  +  finish_slot
    \  slot=foundry/slot_contract attachments=row[iota]
       fallback_available=bool
    ^  foundry/slot_outcome
    ?  (gt attachments.len 0)
       (foundry/slot_outcome/resolved attachments)
    ?  slot.fallback
     > (./some rule=foundry/fallback)
       ?  fallback_available
          (foundry/slot_outcome/fallback rule)
       ?  slot.required
          (foundry/slot_refused slot 'slot_fallback_unavailable
            "required Slot fallback is not available")
       (foundry/slot_outcome/omitted)
     > .none
       ?  slot.required
          (foundry/slot_refused slot 'slot_required_missing
            "required Slot has no attachment or declared fallback")
       (foundry/slot_outcome/omitted)

  +  within
    '  Whether a requested composition kind fits the request ceiling.
    \  kind=iota ceiling=iota
    ^  bool
    (le (foundry/rank kind) (foundry/rank ceiling))

  +  o_path
    '  Apply a write-once overlay path at x case 1 to a live data path.
    '  The result is the canonical nested /o report used by Lain,
    '  Helm observations, and renderer adapters.
    \  op=path dp=path
    ^  path
    =  head=path  ['o ($u 1) ($u op.len)]
    head.weld(op).snoc(($u dp.len)).weld(dp)

  +  chain
    '  Apply overlay paths left-to-right.  The returned report alone
    '  identifies the immutable recipes and live data composition.
    \  ops=row[path] source=path
    ^  path
    |  > i=nat 0  > out=path source
    ?  (ge i ops.len)
       out
    (_ i.inc (foundry/o_path ops.at(i) out))

  +  compile
    '  Compile resolved recipes into one nested /o report while
    '  enforcing the request ceiling.  This stage realizes a request;
    '  it does not resolve identity, grant actions, or mutate the
    '  namespace.  Any over-ceiling step refuses the whole plan.
    \  req=foundry/request steps=row[foundry/step]
    ^  foundry/plan
    ?  req
     > r=foundry/request
       |  > i=nat 0  > ops=row[path] []
       ?  (ge i steps.len)
          (foundry/plan req (foundry/chain ops r.source) ops [])
       ?  steps.at(i)
        > s=foundry/step
          ?  !(foundry/within s.kind r.ceiling)
             (foundry/plan req r.source []
               [(foundry/diagnostic 'ceiling_refused s.recipe
                  "recipe output exceeds the projection ceiling")])
          (_ i.inc ops.snoc(s.recipe))

  +  corpus_path
    '  Foundry documents name themselves absolutely below /foundry, while a
    '  request receives the already-descended /foundry crew view.
    \  p=path
    ^  path
    ?  (eq 0 p.len)  p
    ?  (eq_iota p.at(0) 'foundry)  p.drop(1)
    p

  +  corpus_record
    \  p=path corpus=axal[myth]
    ^  maybe[myth]
    corpus.get((foundry/corpus_path p))

  +  path_at
    '  Read a path-valued catalog field without coupling the renderer-neutral
    '  compiler to Zoo's HTTP-facing registry module.
    \  at=path t=myth
    ^  path
    ?  t.get(at)
     > (./some held=pail)
       ?  held
        > p=pails/p  p.p
       []
     > .none  []

  +  paths_at
    \  at=path t=myth
    ^  row[path]
    ?  t.get(at)
     > (./some held=pail)
       ?  held
        > p=pails/ps  p.ps
       []
     > .none  []

  +  catalog_matches
    \  source=path role=path ceiling=iota t=myth
    ^  bool
    =  cat_source  (foundry/path_at ['catalog 'source] t)
       target  (foundry/path_at ['catalog 'target_role] t)
       cat_ceiling (myth/txt_at ['catalog 'ceiling] t)
    ?  !(eq_pith target role)
       .false
    ?  !(eq cat_ceiling (iota_show ceiling))
       .false
    ?  (eq 0 cat_source.len)  .true
    ?  !(eq_pith cat_source source)  .false
    .true

  +  catalog_hits
    '  Catalog discovery is data-driven over mounted Semidoc records.  Graph
    '  node records are ignored because only document roots carry /foundry/kind.
    \  source=path role=path ceiling=iota corpus=axal[myth]
    ^  row[[p=path t=myth]]
    =  entries  corpus.tap
    |  > i=nat 0  > out=row[[p=path t=myth]] []
    ^  row[[p=path t=myth]]
    ?  (ge i entries.len)  out
    =  [at rec]  entries.at(i)
    ?  !(eq (myth/txt_at ['foundry 'kind] rec) "catalog")
       (_ i.inc out)
    ?  !(foundry/catalog_matches source role ceiling rec)
       (_ i.inc out)
    (_ i.inc out.snoc([at rec]))

  +  catalog_refused
    \  req=foundry/request at=path code=iota detail=nat
    ^  foundry/projection
    (foundry/projection
      (foundry/plan req req.source [] [(foundry/diagnostic code at detail)])
      [] [] [])

  +  compile_catalog
    '  Discover one compatible Semidoc catalog, resolve its ordered recipe
    '  references to inert native Zoo operations, enforce the request ceiling,
    '  and return the terminal operation separately.  Routes choose only the
    '  semantic request; they never enumerate the hierarchy.
    \  req=foundry/request corpus=axal[myth]
    ^  foundry/projection
    =  hits  (foundry/catalog_hits req.source req.role req.ceiling corpus)
    ?  (eq 0 hits.len)
       (foundry/catalog_refused req req.source 'catalog_missing
         "no mounted Foundry catalog satisfies this projection request")
    ?  (gt hits.len 1)
       (foundry/catalog_refused req req.source 'catalog_ambiguous
         "more than one mounted Foundry catalog satisfies this request")
    =  [_ cat]   hits.at(0)
       cat_name  (foundry/path_at ['foundry 'name] cat)
       refs      (foundry/paths_at ['catalog 'recipes] cat)
       layers    (foundry/paths_at ['catalog 'layers] cat)
       terminal_role (foundry/path_at ['catalog 'terminal_role] cat)
    |  > i=nat 0
       > steps=row[foundry/step] []
       > terminal=path []
       > ds=row[foundry/diagnostic] []
    ^  foundry/projection
    ?  (ge i refs.len)
       ?  (gt ds.len 0)
          (foundry/projection (foundry/plan req req.source [] ds)
            [] cat_name layers)
       ?  (eq 0 terminal.len)
          (foundry/catalog_refused req cat_name 'terminal_missing
            "the selected catalog has no terminal recipe")
       (foundry/projection (foundry/compile req steps)
         terminal cat_name layers)
    =  ref  refs.at(i)
    ?  (foundry/corpus_record ref corpus)
     > .none
       (_ i.inc steps terminal ds.snoc((foundry/diagnostic
          'recipe_missing ref "catalog recipe document is not mounted")))
     > (./some rec=myth)
       =  kind    (myth/txt_at ['foundry 'kind] rec)
          role    (foundry/path_at ['recipe 'role] rec)
          native  (foundry/path_at ['recipe 'native] rec)
          output  ($ts (myth/txt_at ['recipe 'output_kind] rec))
       ?  !(eq kind "recipe")
          (_ i.inc steps terminal ds.snoc((foundry/diagnostic
             'recipe_invalid ref "catalog reference does not name a recipe")))
       ?  (eq 0 native.len)
          (_ i.inc steps terminal ds.snoc((foundry/diagnostic
             'recipe_native_missing ref "recipe has no native Zoo operation")))
       ?  (gt terminal_role.len 0)
          ?  (eq_pith role terminal_role)
             ?  (gt terminal.len 0)
                (_ i.inc steps terminal ds.snoc((foundry/diagnostic
                   'terminal_ambiguous ref "catalog selects multiple terminal recipes")))
             (_ i.inc steps native ds)
          (_ i.inc steps.snoc((foundry/step native output)) terminal ds)
       (_ i.inc steps.snoc((foundry/step native output)) terminal ds)

  +  same_paths
    \  a=row[path] b=row[path]
    ^  bool
    ?  !(eq a.len b.len)
       .false
    |  > i=nat 0
    ?  (ge i a.len)
       .true
    ?  !(eq_pith a.at(i) b.at(i))
       .false
    (_ i.inc)

  +  same_key
    \  a=foundry/cache_key b=foundry/cache_key
    ^  bool
    ?  a
     > x=foundry/cache_key
       ?  b
        > y=foundry/cache_key
          ?  !(eq_pith x.report y.report)
             .false
          ?  !(eq x.report_case y.report_case)
             .false
          ?  !(foundry/same_paths x.hydration y.hydration)
             .false
          ?  !(eq_iota x.backend y.backend)
             .false
          ?  !(eq_pith x.pronunciation y.pronunciation)
             .false
          (foundry/same_paths x.features y.features)

  +  cache_new
    '  A bounded cache; zero means retain no compiler artifacts.
    \  limit=nat
    ^  foundry/cache
    (foundry/cache [] 0 0 limit)

  +  cache_get
    '  Lookup is observable only through returned hit/miss counters.
    '  A miss never fabricates a compiler artifact.
    \  key=foundry/cache_key c=foundry/cache
    ^  foundry/cache_read
    ?  c
     > state=foundry/cache
       |  > i=nat 0
       ?  (ge i state.entries.len)
          (foundry/cache_read .none
            (foundry/cache state.entries state.hits state.misses.inc state.limit))
       ?  state.entries.at(i)
        > e=foundry/cache_entry
          ?  (foundry/same_key key e.key)
             (foundry/cache_read (./some (unpin e.held))
               (foundry/cache state.entries state.hits.inc state.misses state.limit))
          (_ i.inc)

  +  cache_put
    '  Replace an equal key and retain the newest `limit` artifacts.
    '  This is deterministic FIFO eviction, sufficient for the first
    '  server worker cache and easy to inspect in tests.
    \  key=foundry/cache_key value=foundry/surface_artifact c=foundry/cache
    ^  foundry/cache
    ?  c
     > state=foundry/cache
       ?  (eq 0 state.limit)
          c
       =  kept
            |  > i=nat 0  > out=row[foundry/cache_entry] []
            ?  (ge i state.entries.len)
               out
            ?  state.entries.at(i)
             > e=foundry/cache_entry
               ?  (foundry/same_key key e.key)
                  (_ i.inc out)
               (_ i.inc out.snoc(e))
          grown kept.snoc((foundry/cache_entry key (pin value)))
          trim
            ?  (gt grown.len state.limit)
               grown.drop((sub grown.len state.limit))
            grown
       (foundry/cache trim state.hits state.misses state.limit)

  +  plan_record
    '  Renderer-neutral inspection payload for plans and refusals.
    \  p=foundry/plan
    ^  myth
    ?  p
     > plan=foundry/plan
       =  status=iota
            ?  (eq 0 plan.diagnostics.len)
               'admitted
            'refused
          out
            .  (myth/new)
               put(['foundry 'status] (pails/q status))
               put(['foundry 'report] (pails/p plan.report))
               put(['foundry 'recipes] (pails/ps plan.recipes))
               put(['foundry 'diagnostic_count] (pd plan.diagnostics.len))
       ?  (eq 0 plan.diagnostics.len)
          out
       ?  plan.diagnostics.at(0)
        > d=foundry/diagnostic
          .  out
             put(['foundry 'diagnostic 'code] (pails/q d.code))
             put(['foundry 'diagnostic 'at] (pails/p d.at))
             put(['foundry 'diagnostic 'detail] (pails/t d.detail))

  +  winner_without
    \  slot=path winners=row[foundry/cascade_winner]
    ^  row[foundry/cascade_winner]
    |  > i=nat 0  > out=row[foundry/cascade_winner] []
    ?  (ge i winners.len)  out
    ?  (eq_pith slot winners.at(i).slot)
       (_ i.inc out)
    (_ i.inc out.snoc(winners.at(i)))

  +  apply_layer_at
    '  Apply one fragment: nearer values replace broad ones and every
    '  replacement updates both compatibility provenance and exact typed
    '  winner evidence at the same semantic token key.
    \  l=foundry/layer ordinal=nat h=foundry/hydration
    ^  foundry/hydration
    ?  l
     > layer=foundry/layer
       ?  h
        > hyd=foundry/hydration
          =  es  layer.values.tap
          |  > i=nat 0  > vals=myth hyd.values  > prov=myth hyd.provenance
             > winners=row[foundry/cascade_winner] hyd.winners
          ?  (ge i es.len)
             (foundry/hydration vals prov winners)
          =  e  es.at(i)
             next  (foundry/cascade_winner e.key layer.name layer.guarded ordinal)
          (_ i.inc vals.put(e.key e.val) prov.put(e.key (pails/p layer.name))
            (foundry/winner_without e.key winners).snoc(next))

  +  apply_layer
    '  Compatibility helper for callers applying one isolated layer.
    \  l=foundry/layer h=foundry/hydration
    ^  foundry/hydration
    (foundry/apply_layer_at l 0 h)

  +  cascade
    '  Resolve broad-to-near ordinary fragments, then guarded client
    '  fragments.  Consequently a Plate-local cosmetic recipe cannot
    '  undo an admitted accessibility preference.
    \  layers=row[foundry/layer]
    ^  foundry/hydration
    =  h0    (foundry/hydration myth/new myth/new [])
       h1
         |  > i=nat 0  > h=foundry/hydration h0
         ?  (ge i layers.len)
            h
         ?  layers.at(i)
          > l=foundry/layer
            ?  l.guarded
               (_ i.inc h)
            (_ i.inc (foundry/apply_layer_at l i h))
    |  > i=nat 0  > h=foundry/hydration h1
    ?  (ge i layers.len)
       h
    ?  layers.at(i)
     > l=foundry/layer
       ?  l.guarded
          (_ i.inc (foundry/apply_layer_at l i h))
       (_ i.inc h)

  +  stamp
    '  Attach request and hydration evidence to the SurfaceTree root.
    '  All slots remain semantic; terminal adapters decide how to
    '  pronounce them.  Unknown pre-existing root slots survive.
    \  req=foundry/request hyd=foundry/hydration tree=surface_tree
    ^  surface_tree
    ?  req
     > request=foundry/request
       ?  hyd
        > hydration=foundry/hydration
          =  root
               ?  tree.fil
                > (./some t=myth)  t
                > .none            myth/new
             r1  root.put(['projection 'source] (pails/p request.source))
             r2  r1.put(['projection 'role] (pails/p request.role))
             r3  r2.put(['projection 'mode] (pails/q request.mode))
             r4  r3.put(['projection 'ceiling] (pails/q request.ceiling))
             r5  r4.put(['projection 'features] (pails/ps request.features))
             ves hydration.values.tap
             r8
               |  > i=nat 0  > acc=myth r5
               ?  (ge i ves.len)
                  acc
               =  e  ves.at(i)
                  base=path  ['foundry 'resolved]
                  at=path    base.weld(e.key)
               (_ i.inc acc.put(at e.val))
             pes hydration.provenance.tap
             r9
               |  > i=nat 0  > acc=myth r8
               ?  (ge i pes.len)
                  acc
               =  e  pes.at(i)
                  base=path  ['foundry 'provenance]
                  at=path    base.weld(e.key)
               (_ i.inc acc.put(at e.val))
             winners hydration.winners
             r10
               |  > i=nat 0  > acc=myth r9
               ?  (ge i winners.len)
                  acc
               =  winner winners.at(i)
                  ord_base=path ['foundry 'cascade 'ordinal]
                  guard_base=path ['foundry 'cascade 'guard]
                  ord_at=path ord_base.weld(winner.slot)
                  guard_at=path guard_base.weld(winner.slot)
                  guard=iota
                    ?  winner.guarded  'guarded
                    'ordinary
                  acc1  acc.put(ord_at (pails/n winner.ordinal))
               (_ i.inc acc1.put(guard_at (pails/q guard)))
          tree.set_fil((./some r10))

  +  hydrate
    '  Build an inspectable compiler artifact from already-admitted
    '  structure.  Despite the historical name this does not produce a
    '  delivery packet; foundry_delivery performs the addressed DAG bridge.
    '  Recipe selection and capability attenuation happen before this
    '  call; this function only resolves presentation fragments.
    \  req=foundry/request tree=surface_tree layers=row[foundry/layer]
    ^  foundry/surface_artifact
    =  hyd  (foundry/cascade layers)
       out  (foundry/stamp req hyd tree)
    (foundry/surface_artifact req out hyd [] [])

  '  Nominal values are deliberately opened behind these small accessors.
  '  Hosts and tests use the semantic API instead of depending on the
  '  compiler's branded tuple representation.
  +  plan_report
    \  p=foundry/plan
    ^  path
    ?  p
     > x=foundry/plan  x.report
  +  plan_recipes
    \  p=foundry/plan
    ^  row[path]
    ?  p
     > x=foundry/plan  x.recipes
  +  plan_diagnostics
    \  p=foundry/plan
    ^  row[foundry/diagnostic]
    ?  p
     > x=foundry/plan  x.diagnostics
  +  hydration_values
    \  h=foundry/hydration
    ^  myth
    ?  h
     > x=foundry/hydration  x.values
  +  hydration_provenance
    \  h=foundry/hydration
    ^  myth
    ?  h
     > x=foundry/hydration  x.provenance
  +  hydration_winners
    \  h=foundry/hydration
    ^  row[foundry/cascade_winner]
    ?  h
     > x=foundry/hydration  x.winners
  +  cascade_winner_at
    \  slot=path h=foundry/hydration
    ^  maybe[foundry/cascade_winner]
    ?  h
     > x=foundry/hydration
       |  > i=nat 0
       ^  maybe[foundry/cascade_winner]
       ?  (ge i x.winners.len)  .none
       ?  (eq_pith slot x.winners.at(i).slot)
          (./some x.winners.at(i))
       (_ i.inc)
  +  winner_layer
    \  winner=foundry/cascade_winner
    ^  path
    winner.layer
  +  winner_guarded
    \  winner=foundry/cascade_winner
    ^  bool
    winner.guarded
  +  winner_ordinal
    \  winner=foundry/cascade_winner
    ^  nat
    winner.ordinal
  +  slot_outcome_code
    \  outcome=foundry/slot_outcome
    ^  maybe[iota]
    ?  outcome
     > foundry/slot_outcome/resolved  .none
     > foundry/slot_outcome/fallback  .none
     > foundry/slot_outcome/omitted   .none
     > x=foundry/slot_outcome/refused (./some x.diagnostic.code)
  +  fallback_resolution_selected
    \  result=foundry/fallback_resolution
    ^  bool
    ?  result
     > foundry/fallback_resolution/selected  .true
     > foundry/fallback_resolution/refused   .false
  +  fallback_resolution_trace
    \  result=foundry/fallback_resolution
    ^  maybe[foundry/fallback_trace]
    ?  result
     > x=foundry/fallback_resolution/selected  (./some x.trace)
     > foundry/fallback_resolution/refused     .none
  +  fallback_resolution_code
    \  result=foundry/fallback_resolution
    ^  maybe[iota]
    ?  result
     > foundry/fallback_resolution/selected    .none
     > x=foundry/fallback_resolution/refused
       (./some x.diagnostic.code)
  +  fallback_resolution_at
    \  result=foundry/fallback_resolution
    ^  maybe[path]
    ?  result
     > foundry/fallback_resolution/selected    .none
     > x=foundry/fallback_resolution/refused
       (./some x.diagnostic.at)
  +  fallback_trace_selected
    \  trace=foundry/fallback_trace
    ^  path
    trace.selected
  +  fallback_trace_class
    \  trace=foundry/fallback_trace
    ^  iota
    trace.class
  +  fallback_trace_chain
    \  trace=foundry/fallback_trace
    ^  row[path]
    trace.chain
  +  fallback_trace_observations
    \  trace=foundry/fallback_trace
    ^  row[path]
    trace.observations
  +  fallback_trace_actions
    \  trace=foundry/fallback_trace
    ^  row[path]
    trace.actions
  +  surface_artifact_tree
    '  Read the tree-shaped compiler intermediate.  Consumers must bridge
    '  this into projection_dag before calling it delivered.
    \  p=foundry/surface_artifact
    ^  surface_tree
    ?  p
     > x=foundry/surface_artifact  x.tree
  +  packet_tree
    '  Compatibility spelling for the current Chat prototype.  New compiler
    '  code should use surface_artifact_tree; neither name denotes a packet.
    \  p=foundry/surface_artifact
    ^  surface_tree
    (foundry/surface_artifact_tree p)
  +  cache_read_value
    \  r=foundry/cache_read
    ^  maybe[foundry/surface_artifact]
    ?  r
     > x=foundry/cache_read  x.value
  +  cache_read_next
    \  r=foundry/cache_read
    ^  foundry/cache
    ?  r
     > x=foundry/cache_read  x.next
  +  cache_entries
    \  c=foundry/cache
    ^  row[foundry/cache_entry]
    ?  c
     > x=foundry/cache  x.entries
  +  cache_hits
    \  c=foundry/cache
    ^  nat
    ?  c
     > x=foundry/cache  x.hits
  +  cache_misses
    \  c=foundry/cache
    ^  nat
    ?  c
     > x=foundry/cache  x.misses
  +  layer_name
    \  l=foundry/layer
    ^  path
    ?  l
     > x=foundry/layer  x.name
  +  layer_values
    \  l=foundry/layer
    ^  myth
    ?  l
     > x=foundry/layer  x.values
  +  layer_guarded
    \  l=foundry/layer
    ^  bool
    ?  l
     > x=foundry/layer  x.guarded
