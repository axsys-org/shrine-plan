- publication
- lain_types

' Compiler products cross into the store only as a complete prepared batch.
+ compiler_publication
  + assign_system
    \ names=row[path]
    ^ pin[row[[path nat]]]
    = assigned
        | names.fold (axal/new[nat] .none)
          \ out name
          | out.put name 1
    | pin assigned.tap

  + publish
    \ slot=path who=iota
      defs=row[[name=path prior=nat mold=type image=pin[any]]]
      now=nat block=nat state=sov
    ^ either[iota sov]
    ? (eq slot.len 0) (./err 'invalid_artifact_slot)
    ? !(eq (aura_tag slot.at(0)) "x")
      | ./err 'invalid_artifact_slot
    ? (eq (quip_val slot.at(0)) 0)
      | ./err 'invalid_artifact_slot
    = names | defs.map (\ [name prior mold image] name)
    < batch (publication_batch/prepare who names state)
    = valid
        | defs.all
          \ [name prior mold image]
          ?> (./some current) batch.expected.get(name) .false
          | eq current prior
    ? !valid (./err 'stale_publication)
    = records
        | defs.fold (axal/new[myth] .none)
          \ out [name prior mold image]
          = card | myth/sing ['sys 'mold] (pails/ty mold)
          | out.put name card.put(slot (pails/code image))
    | publication_batch/publish records now block state batch

  + system
    ' System bootstrap uses the same complete assignment and commit path.
    ' No published artifact needs to contain the pin produced here.
    \ assigned=pin[row[[path nat]]] slot=path
      defs=row[[name=path prior=nat mold=type image=pin[any]]]
      now=nat block=nat
    ^ either[iota pin[system_publication]]
    < state
      | compiler_publication/publish slot 'sys defs now block sov/new
    ? !(equal assigned (system_publication/assigned state))
      | ./err 'system_definition_mismatch
    | ./ok (pin (system_publication state.top state assigned))

  + local
    ' Live definition publication participates in the namespace journal.
    ' The compiler retains the preassigned manifest, not a recursive pin
    ' of the publication containing its own artifacts. The journal keeps
    ' the complete trusted system publication pin.
    \ system=pin[row[[path nat]]] slot=path
      defs=row[[name=path prior=nat mold=type image=pin[any]]]
      now=nat block=nat state=namespace
    ^ either[iota namespace/committed]
    ? !(equal system (unpin state.system).definitions)
      | ./err 'system_publication_mismatch
    < checked
      | compiler_publication/publish slot state.self defs
          now block state.local
    = changes
        | defs.fold (axal/new[note] .none)
          \ out [name prior mold image]
          ?> (./known card) checked.x_latest(name) out
          | out.put name (note/make card)
    ? (namespace/step changes now block state)
     > (./rejected why) (./err why)
     > (./accepted committed) (./ok committed)
