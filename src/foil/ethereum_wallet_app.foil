- ethereum_wallet
- helm
- pact

+ ethereum_wallet_app
  + slot
    ^ path
    ['ethereum 'wallet]
  + read
    \ record=myth
    ^ ethereum_wallet/state
    ?> (./some held) record.get(ethereum_wallet_app/slot)
        ; (error (pails/t "missing wallet state"))
        | ethereum_wallet/initial "0x0000000000000000000000000000000000000000"
    ?> state=ethereum_wallet/state held
        ; (error (pails/t "invalid wallet state"))
        | ethereum_wallet/initial "0x0000000000000000000000000000000000000000"
    state
  + request
    : value=ethereum_wallet/command
  + command
    \ value=ethereum_wallet/command
    ^ myth
    | myth/sing ['ethereum 'command] (ethereum_wallet_app/request value)
  + talk
    \ b=bowl current=myth input=myth
    ^ yell
    ?> (./some held) input.get(['ethereum 'command])
        ; (error (pails/t "wallet accepts commands only"))
        | yell [] current
    ?> request=ethereum_wallet_app/request held
        ; (error (pails/t "invalid wallet command"))
        | yell [] current
    = old (ethereum_wallet_app/read current)
      next (ethereum_wallet/apply request.value old)
      intents
        | next.intents.map
          \ item=ethereum_wallet/intent
          = path b.here.weld(['intent ($ts item.id)])
            record (myth/sing ['ethereum 'intent] item).put(['phase] (pd item.phase))
            exists old.intents.any((\ prior=ethereum_wallet/intent (equal prior.id item.id)))
          [path (? exists (writ/poke record) (writ/make record))]
      streams
        | next.streams.map
          \ item=ethereum_wallet/stream
          = path b.here.weld(['stream ($ts item.id)])
            record (myth/sing ['ethereum 'stream] item).put(['cursor] (pails/t (ethereum_wallet/cursor item)))
            exists old.streams.any((\ prior=ethereum_wallet/stream (equal prior.id item.id)))
          [path (? exists (writ/poke record) (writ/make record))]
    | yell intents.weld(streams) current.put(ethereum_wallet_app/slot next)
  + form
    ^ form
    | def_form.set_talk ethereum_wallet_app/talk
  + seed
    \ registry=path address=str
    ^ myth
    | (kooked [registry]).put ethereum_wallet_app/slot (ethereum_wallet/initial address)
  + install
    \ address=str state=namespace
    ^ namespace
    = root=path [state.self 'app 'ethereum]
      registry=path [state.self 'kook 'ethereum_wallet]
      writes=row[[path writ]]
        [[registry (writ/make (myth/sing system_vocabulary/form ethereum_wallet_app/form))]
         [root (writ/make (ethereum_wallet_app/seed registry address))]]
      [next index reply]
        | helm/supervisor/handle (helm/card/steps writes) state (sovereign_hive state)
    ?> (./ack err) reply
        ; (error (pails/t "wallet installation failed"))
        state
    ? err
     > (./some why)
      ; (error why)
      state
     > .none next
  + state
    \ world=namespace
    ^ ethereum_wallet/state
    ?> (./known binding) world.page(.x .none [world.self 'app 'ethereum])
        ; (error (pails/t "wallet not installed"))
        | ethereum_wallet/initial "0x0000000000000000000000000000000000000000"
    ?> (./some record) binding.fil
        ; (error (pails/t "wallet record absent"))
        | ethereum_wallet/initial "0x0000000000000000000000000000000000000000"
    | ethereum_wallet_app/read (unpin record.myth)
  + step
    \ command=ethereum_wallet/command state=namespace
    ^ namespace
    = [next index reply]
        | helm/supervisor/handle
          (helm/card/step [state.self 'app 'ethereum] (writ/poke (ethereum_wallet_app/command command)))
          state (sovereign_hive state)
    ?> (./ack err) reply
        ; (error (pails/t "wallet step failed"))
        state
    ? err
     > (./some why)
      ; (error why)
      state
     > .none next
  + checked_handle
    \ input=[helm/card namespace hive]
    ^ [namespace hive feet/task[unit]]
    = [card state index] input
      result (helm/supervisor/handle card state index)
    ; (DeepSeq[nat] result 0)
    result
  + handle
    ' Convert rejected behavior evaluation into an ACK while retaining the
    ' prior namespace. A failed actor must not strand its waiting caller.
    \ card=helm/card state=namespace index=hive
    ^ [namespace hive feet/task[unit]]
    ? (Try ethereum_wallet_app/checked_handle [card state index])
     > (./ok result) result
     > (./err why) [state index (feet/task/ack (./some why))]
  + access
    ^ helm/supervisor/access[namespace]
    | helm/supervisor/access/set_handle[namespace] ethereum_wallet_app/handle helm/supervisor/local_access
