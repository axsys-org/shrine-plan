-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
-  foundry_delivery [order=40]
'  foundry_lens: lawful, renderer-neutral amendment contracts over addressed
'  projection overlays.  The projection DAG remains the delivered structure;
'  a lens observation adds only a root, a bounded object delta, and the
'  complement needed to interpret a later semantic amendment.
'
'  Observe and Amend are deliberately different result families.  Observation
'  may be complete, pending, or refused.  Amendment may be unchanged, planned,
'  or refused.  A plan is inert data for a capability-aware Lain transaction;
'  neither a complement nor a browser packet grants authority.

+  overlay_geometry
  :  x=nat y=nat width=nat height=nat

+  projection_correspondence
  '  One output occurrence introduced by an overlay and the addressed input
  '  occurrence from which it was derived.
  :  output=projection_address input=projection_address

+  overlay_complement
  '  Evidence for travelling back through one overlay.  `before` contains the
  '  overlay-owned contextual values that Get observed.  Capabilities are
  '  requirements only; possession is checked when an Amend plan is executed.
  :  revision=foundry_digest
     overlay=foundry_digest
     input_root=projection_address
     output_root=projection_address
     target=projection_address
     subject=path
     correspondences=row[projection_correspondence]
     before=row[projection_parameter]
     capabilities=row[path]

+  projection_delta
  '  A resumable addressed fragment.  Objects are fed directly to Upsert;
  '  root and frontier become the revision manifest.  No SurfaceTree or
  '  terminal payload is canonicalized here.
  :  root=projection_address
     objects=row[projection_object]
     frontier=row[projection_address]

+  overlay_observation
  &  overlay_observation/complete
     overlay_observation/pending
     overlay_observation/refused

  +  complete
    :  delta=projection_delta complement=overlay_complement
  +  pending
    :  delta=projection_delta complement=overlay_complement
       unresolved=row[projection_address]
  +  refused
    :  code=iota at=path

+  overlay_amend_request
  '  A proposed semantic change at one exact projected occurrence.  The
  '  revision prevents a browser or worker from applying a stale complement.
  :  revision=foundry_digest
     target=projection_address
     role=path
     desired=row[projection_parameter]

+  overlay_amend_plan
  '  Inert transaction input.  `effect` addresses the stateful subject with
  '  an amendment card.  Ordinary Lain dispatch resolves that subject's kook
  '  and forms; after checking their laws/capabilities they may emit make,
  '  poke, or cull.
  :  revision=foundry_digest
     overlay=foundry_digest
     source=projection_address
     target=projection_address
     role=path
     before=row[projection_parameter]
     after=row[projection_parameter]
     capabilities=row[path]
     effect=task

+  overlay_amendment
  &  overlay_amendment/unchanged
     overlay_amendment/planned
     overlay_amendment/refused

  +  unchanged
    :  complement=overlay_complement
  +  planned
    :  plan=overlay_amend_plan
  +  refused
    :  code=iota at=path

+  foundry_lens
  +  geometry
    \  x=nat y=nat width=nat height=nat
    ^  overlay_geometry
    (overlay_geometry x y width height)

  +  geometry_valid
    \  g=overlay_geometry
    ^  bool
    ?  (eq 0 g.width)   .false
    ?  (eq 0 g.height)  .false
    .true

  +  geometry_parameters
    \  g=overlay_geometry
    ^  row[projection_parameter]
    [(projection_parameter ['geometry 'x] (projection_value/count g.x))
     (projection_parameter ['geometry 'y] (projection_value/count g.y))
     (projection_parameter ['geometry 'width] (projection_value/count g.width))
     (projection_parameter ['geometry 'height] (projection_value/count g.height))]

  +  geometry_myth
    '  Existing Lain write payload for a Desktop placement overlay.  The lens
    '  does not invent another mutation vocabulary: Put eventually yields this
    '  record inside writ/poke addressed to the stateful subject.  The subject
    '  resolves its own kook and behavior forms through ordinary Lain dispatch.
    \  g=overlay_geometry
    ^  myth
    .  (myth/new)
       put(['geometry 'x] (pails/n g.x))
       put(['geometry 'y] (pails/n g.y))
       put(['geometry 'width] (pails/n g.width))
       put(['geometry 'height] (pails/n g.height))

  +  parameter
    \  key=path parameters=row[projection_parameter]
    ^  maybe[projection_value]
    |  > i=nat 0
    ^  maybe[projection_value]
    ?  (ge i parameters.len)
       .none
    ?  (eq_pith key parameters.at(i).key)
       (./some parameters.at(i).value)
    (_ i.inc)

  +  count_parameter
    \  key=path parameters=row[projection_parameter]
    ^  maybe[nat]
    ?  (foundry_lens/parameter key parameters)
     > .none  .none
     > (./some value=projection_value)
       ?  value
        > x=projection_value/count  (./some x.value)
        > projection_value/flag          .none
        > projection_value/text          .none
        > projection_value/name          .none
        > projection_value/semantic_ref  .none
        > projection_value/ref           .none

  +  parameters_geometry
    \  parameters=row[projection_parameter]
    ^  maybe[overlay_geometry]
    ?  (foundry_lens/count_parameter ['geometry 'x] parameters)
     > .none  .none
     > (./some x=nat)
       ?  (foundry_lens/count_parameter ['geometry 'y] parameters)
        > .none  .none
        > (./some y=nat)
          ?  (foundry_lens/count_parameter ['geometry 'width] parameters)
           > .none  .none
           > (./some width=nat)
             ?  (foundry_lens/count_parameter ['geometry 'height] parameters)
              > .none  .none
              > (./some height=nat)
                =  g  (overlay_geometry x y width height)
                ?  (foundry_lens/geometry_valid g)  (./some g)
                .none

  +  address_extend
    \  address=projection_address step=projection_axis
    ^  projection_address
    (projection_address address.source address.axis.snoc(step))

  +  desktop_root
    \  scene=projection_address
    ^  projection_address
    (foundry_lens/address_extend scene (projection_axis/branch 'desktop_stage))

  +  desktop_window
    \  root=projection_address
    ^  projection_address
    =  placed (foundry_lens/address_extend root
                (projection_axis/branch 'placement))
    (foundry_lens/address_extend placed (projection_axis/slot 'chat_window))

  +  desktop_capabilities
    ^  row[path]
    [['capability 'desktop 'layout 'amend]]

  +  desktop_observe
    '  The first addressed effectful overlay lens.  Get wraps one Shrine Scene
    '  definition in a Desktop Stage and attaches geometry to the contextual
    '  placement occurrence, not to the shared Scene definition.
    \  overlay=foundry_digest revision=foundry_digest
       scene=projection_address subject=path geometry=overlay_geometry
    ^  overlay_observation
    ?  !(foundry_digest/valid overlay)
       (overlay_observation/refused 'invalid_overlay ['lens 'overlay])
    ?  !(foundry_digest/valid revision)
       (overlay_observation/refused 'invalid_revision ['lens 'revision])
    ?  !(foundry_delivery/address_valid scene)
       (overlay_observation/refused 'invalid_source ['lens 'source])
    ?  !(foundry_lens/geometry_valid geometry)
       (overlay_observation/refused 'invalid_geometry ['geometry])
    =  root  (foundry_lens/desktop_root scene)
       target (foundry_lens/desktop_window root)
       params (foundry_lens/geometry_parameters geometry)
       syntax (projection_syntax 'stage ['desktop 'stage] overlay []
                [target] [scene] .none)
       node (projection_object/node
              (projection_node root (projection_node_body/semantic syntax)))
       placement (projection_object/placement
                   (projection_placement target root ['desktop 'window]
                     params .none
                     (projection_placement_target/child scene)))
       delta (projection_delta root [node placement] [scene])
       complement
         (overlay_complement revision overlay scene root target subject
           [(projection_correspondence root scene)] params
           foundry_lens/desktop_capabilities)
    (overlay_observation/complete delta complement)

  +  desktop_amend
    '  Put is intentionally not a mutation.  It validates the complement and
    '  returns either an observational no-op, an inert capability requirement,
    '  or stable refusal data.
    \  request=overlay_amend_request
       complement=maybe[overlay_complement]
    ^  overlay_amendment
    ?  complement
     > .none
       (overlay_amendment/refused 'missing_complement ['lens 'complement])
     > (./some c=overlay_complement)
       ?  !(equal request.revision c.revision)
          (overlay_amendment/refused 'stale_complement ['lens 'revision])
       ?  !(equal request.target c.target)
          (overlay_amendment/refused 'target_mismatch ['lens 'target])
       ?  !(eq_pith request.role ['desktop 'window 'geometry])
          (overlay_amendment/refused 'role_refused ['lens 'role])
       =  desired  (foundry_lens/parameters_geometry request.desired)
       ?  desired
        > .none
          (overlay_amendment/refused 'invalid_geometry ['geometry])
        > (./some geometry=overlay_geometry)
          ?  (equal request.desired c.before)
             (overlay_amendment/unchanged c)
          (overlay_amendment/planned
            (overlay_amend_plan c.revision c.overlay c.input_root c.target
              request.role c.before request.desired c.capabilities
              (task/vine c.subject
                (writ/poke (foundry_lens/geometry_myth geometry)))))

  +  request_geometry
    \  revision=foundry_digest target=projection_address
       geometry=overlay_geometry
    ^  overlay_amend_request
    (overlay_amend_request revision target ['desktop 'window 'geometry]
      (foundry_lens/geometry_parameters geometry))

  +  delta_manifest
    \  revision=foundry_digest retain=row[projection_address]
       delta=projection_delta
    ^  projection_manifest
    (projection_manifest revision [delta.root] retain delta.frontier)

  +  delta_frames
    '  Mechanical progressive transport for an observed fragment.  Complete
    '  is emitted only when the observation is complete; a pending producer
    '  can use the same prefix and later append Resolve plus Complete.
    \  revision=foundry_digest retain=row[projection_address]
       delta=projection_delta complete=bool
    ^  row[projection_frame]
    =  manifest (foundry_lens/delta_manifest revision retain delta)
    |  > i=nat 0
       > out=row[projection_frame]
         [(projection_frame/begin manifest [])]
    ^  row[projection_frame]
    ?  (ge i delta.objects.len)
       ?  complete  out.snoc((projection_frame/complete manifest))
       out
    (_ i.inc out.snoc((projection_frame/upsert manifest delta.objects.at(i))))

  '  Stable inspection gates for untyped law tests and host adapters.
  +  observe_complete
    \  observation=overlay_observation
    ^  bool
    ?  observation
     > overlay_observation/complete  .true
     > overlay_observation/pending   .false
     > overlay_observation/refused   .false
  +  observe_delta
    \  observation=overlay_observation
    ^  maybe[projection_delta]
    ?  observation
     > x=overlay_observation/complete  (./some x.delta)
     > x=overlay_observation/pending   (./some x.delta)
     > overlay_observation/refused     .none
  +  observe_complement
    \  observation=overlay_observation
    ^  maybe[overlay_complement]
    ?  observation
     > x=overlay_observation/complete  (./some x.complement)
     > x=overlay_observation/pending   (./some x.complement)
     > overlay_observation/refused     .none
  +  observe_code
    \  observation=overlay_observation
    ^  maybe[iota]
    ?  observation
     > overlay_observation/complete   .none
     > overlay_observation/pending    .none
     > x=overlay_observation/refused  (./some x.code)
  +  amend_kind
    \  amendment=overlay_amendment
    ^  iota
    ?  amendment
     > overlay_amendment/unchanged  'unchanged
     > overlay_amendment/planned    'planned
     > overlay_amendment/refused    'refused
  +  amend_plan
    \  amendment=overlay_amendment
    ^  maybe[overlay_amend_plan]
    ?  amendment
     > overlay_amendment/unchanged  .none
     > x=overlay_amendment/planned  (./some x.plan)
     > overlay_amendment/refused    .none
  +  amend_code
    \  amendment=overlay_amendment
    ^  maybe[iota]
    ?  amendment
     > overlay_amendment/unchanged  .none
     > overlay_amendment/planned    .none
     > x=overlay_amendment/refused  (./some x.code)
  +  plan_after
    \  plan=overlay_amend_plan
    ^  row[projection_parameter]
    plan.after
  +  plan_capabilities
    \  plan=overlay_amend_plan
    ^  row[path]
    plan.capabilities
  +  plan_effect
    \  plan=overlay_amend_plan
    ^  task
    plan.effect
  +  plan_effect_kind
    \  plan=overlay_amend_plan
    ^  iota
    ?  plan.effect
     > x=task/vine
       ?  x.w
        > writ/make  'make
        > writ/poke  'poke
        > writ/cull  'cull
     > task/hear  'hear
  +  plan_subject
    '  The amendment recipient encoded by the inert Lain task.  It is a
    '  stateful subject path, not a direct reference to a kook or form.
    \  plan=overlay_amend_plan
    ^  maybe[path]
    ?  plan.effect
     > x=task/vine  (./some x.p)
     > task/hear    .none
  +  complement_before
    \  complement=overlay_complement
    ^  row[projection_parameter]
    complement.before
  +  complement_target
    \  complement=overlay_complement
    ^  projection_address
    complement.target
  +  complement_subject
    \  complement=overlay_complement
    ^  path
    complement.subject
  +  delta_root
    \  delta=projection_delta
    ^  projection_address
    delta.root
  +  delta_objects
    \  delta=projection_delta
    ^  row[projection_object]
    delta.objects
