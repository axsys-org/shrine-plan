- publisher_vocabulary
- grove_role_runtime

+ grove_templates
  + version
    ^ nat
    3
  + slot
    ^ path
    publisher_vocabulary/grove/template
  + source_slot
    ^ path
    publisher_vocabulary/grove/source
  + resolved
    ' Every explicit instance marker must name a record or subtree that
    ' this template creates. This applies to publisher slots as well.
    \ template=grove_template
    ^ bool
    | template.seeds.all
      \ [relative card]
      | card.tap.all
        \ entry
        ?> link=grove_instance_ref entry.val .true
        = root=bool
            ? (eq link.path.len 0) (equal[care] link.care .x)
            .false
        ? root .true
        | template.seeds.any
          \ [target record]
          ? (equal[care] link.care .x) (equal[path] link.path target)
          | pith_prefix link.path target
  + records
    \ root=path template=grove_template
    ^ row[[path myth]]
    | template.seeds.map
    \ [relative card]
    = card
        | card.tap.fold card
        \ out entry
        ? entry.val
         > link=grove_instance_ref
          | out.put entry.key
              (safe 1 link.care root.weld(link.path))
        out
    [root.weld(relative) card]
