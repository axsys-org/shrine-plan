- grove_role_runtime

+ grove_templates
  + slot
    ^ path
    ['sys 'grove 'template]
  + source_slot
    ^ path
    ['sys 'grove 'source]
  + records
    \ root=path template=grove_template
    ^ row[[path myth]]
    | template.seeds.map
    \ [relative card]
    = card
        | card.tap.fold card
        \ out entry
        ? entry.val
         > link=grove_instance_ref
          | out.put entry.key
              (safe 1 link.care root.weld(link.path))
        out
    [root.weld(relative) card]
