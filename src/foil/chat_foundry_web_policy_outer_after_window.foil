-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_web_policy_result [order=50]
-  chat_foundry_web_policy_outer_controls [order=60]
-  chat_foundry_web_policy_outer_after_controls [order=70]
'  Ordered continuation after the outer window policy.
+  chat_foundry_web_policy_outer_after_window
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    =  controls
         (chat_foundry_web_policy_outer_controls/plan_policy occurrence children)
    ?  controls.matched  controls
    (chat_foundry_web_policy_outer_after_controls/plan_policy
      occurrence children)
