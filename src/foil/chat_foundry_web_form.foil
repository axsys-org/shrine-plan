-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  web [order=40]
'  Mechanical Chat Web form construction.  This module preserves the existing
'  /post and w-refresh protocol, but owns no pronunciation or role policy.
+  chat_foundry_web_form
  +  side_input
    '  One side of the picker: a labeled radio button.
    \  v=nat checked=nat
    ^  weft/node
    =  as
         ?  checked
            [(weft/att "type" "radio") (weft/att "name" "who")
             (weft/att "value" v) (weft/att "checked" "checked")]
         [(weft/att "type" "radio") (weft/att "name" "who")
          (weft/att "value" v)]
    (weft/el "label" [(weft/cls "side-choice")]
      [(weft/el "input" as []) (weft/tx v)])

  +  chat_form
    '  Existing /post and w-refresh protocol, shared by every shell.
    \  logp=path back=nat
    ^  weft/node
    (weft/el "form"
      [(weft/cls "composer")
       (weft/att "method" "post")
       (weft/att "action" (weft/cat2 "/post" (show/path logp)))
       (weft/att "w-post" "1") (weft/att "w-refresh" "log")
       (weft/att "w-scroll" "end")]
      [(weft/el "input"
         [(weft/att "type" "hidden") (weft/att "name" "back")
          (weft/att "value" back)] [])
       (weft/el "span" [(weft/cls "side-picker")]
         [(chat_foundry_web_form/side_input "a" 1)
          (chat_foundry_web_form/side_input "b" 0)])
       (weft/el "input"
         [(weft/att "type" "text") (weft/att "name" "text")
          (weft/att "aria-label" "Message")
          (weft/att "placeholder" "Write a message")
          (weft/att "autocomplete" "off")] [])
       (weft/leaf "button" [] "Send")])
