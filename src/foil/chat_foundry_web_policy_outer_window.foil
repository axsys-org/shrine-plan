-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  surface [order=50]
-  chat_foundry_occurrence [order=60]
-  chat_foundry_web_policy_result [order=70]
'  Quarantined compatibility policy for legacy desktop and Shrine windows.
'  Branch order is terminal behavior, not a new semantic representation.
+  chat_foundry_web_policy_outer_window
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'desktop 'window 'chat] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "article" [(weft/cls "stage-window primary")]
            [(surface/window_chrome "Chat" "Scene Plate / foreground")
             (weft/el "div" [(weft/cls "window-content")] children)])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'shrine 'scene] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "section" [(weft/cls "root-scene")]
            [(weft/el "article" [(weft/cls "scene-plate-window")]
               children)])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'shrine 'chrome] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "header" [(weft/cls "window-chrome")]
            children.snoc((weft/el "span" [(weft/cls "window-spacer")] [])))]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'shrine 'traffic_lights] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span"
            [(weft/cls "traffic-lights") (weft/att "aria-hidden" "true")]
            children)] .none)
    (chat_foundry_web_policy_result .false [] .none)
