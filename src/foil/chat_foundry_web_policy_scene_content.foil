-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_web_policy_result [order=60]
'  Quarantined compatibility policy for legacy Chat navigation and content.
'  Its ordered role switches remain a terminal adapter rather than Foundry IR.
+  chat_foundry_web_policy_scene_content
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'navigation] occurrence)
       =  heading=row[weft/node]
            [(weft/leaf "h2" [(weft/cls "sidebar-heading")]
               "Conversations")]
       (chat_foundry_web_policy_result .true
         [(weft/el "aside"
            [(weft/cls "scene-sidebar")
             (weft/att "aria-label" "Conversations")]
            heading.weld(children))]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'conversation 'active] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "a"
            [(weft/cls "sidebar-item active") (weft/href "/chat/scene")]
            [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "G")
             (weft/el "span" [(weft/cls "sidebar-copy")]
               [(weft/leaf "strong" []
                  (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))
                (weft/leaf "small" [] "The live conversation")])
             (weft/leaf "span" [(weft/cls "sidebar-badge")] "now")])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'conversation] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "a" [(weft/cls "sidebar-item")
                         (weft/href "/chat/scene")]
            [(weft/leaf "strong" []
               (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'scene 'content] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "main" [(weft/cls "scene-workspace")] children)] .none)
    (chat_foundry_web_policy_result .false [] .none)
