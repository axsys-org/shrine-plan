-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  fetch [order=50]
-  helm [order=80]
'  Outbound HTTP worker. State, scheduling, and namespace writes are Foil;
'  the host supplies actor transport and one native transfer per leaf actor.
+  fetch_request
  :  method=nat url=nat headers=row[[n=nat v=nat]] body=nat
     connect=nat deadline=nat redirects=nat maxbody=nat
+  fetch_result
  &  fetch_result/ok
     fetch_result/err
  +  ok
    :  status=nat url=nat headers=nat body=nat
  +  err
    :  code=nat
+  fetch_event
  &  fetch_event/helm
     fetch_event/done
  +  helm
    :  message=driver_in
  +  done
    :  kid=iota result=fetch_result
+  fetch_ack
  :  kid=iota clear=bool
+  fetch_state
  :  claimed=path reading=path pending=path queue=row[fetch_ack]
  +  empty
    ^  fetch_state
    | fetch_state [] [] [] []
+  fetch_effect
  &  fetch_effect/send
     fetch_effect/start
     fetch_effect/failed
  +  send
    :  message=driver_out
  +  start
    :  kid=iota request=fetch_request
  +  failed
    :  kid=iota
+  fetch_turn
  :  state=fetch_state effects=row[fetch_effect] stop=bool
+  fetch_ports
  '  Only these effects cross the host boundary. No untyped helper table.
  :  recv={\ nat}fetch_event
     send={\ driver_out}nat
     start={\ iota fetch_request}nat
     failed={\ iota}nat
+  fetch_driver
  +  without
    \ kid=iota kids=path
    ^ path
    | kids.keep
    \ k
    ! | eq_iota kid k
  +  request_path
    \ name=iota kid=iota
    ^ path
    ['io name kid]
  +  unchanged
    \ s=fetch_state
    ^ fetch_turn
    | fetch_turn s [] .false
  +  clear
    \ name=iota kid=iota
    ^ fetch_effect
    | fetch_effect/send
    | driver_out/cmd name
    | task/vine (| io_path name)
    | writ/poke (myth/new).put(['fresh kid] (| pd 0))
  +  watch
    \ name=iota rec=res[myth] s=fetch_state
    ^ fetch_turn
    ?> (./known t) rec
       | fetch_driver/unchanged s
    = kids=path
        | (| fetch/fresh t).keep
        \ k
        !(s.claimed.has(k))
      next=fetch_state
        | fetch_state s.claimed.weld(kids) s.reading.weld(kids) s.pending s.queue
      effects=row[fetch_effect]
        | kids.map
        \ kid
        | fetch_effect/send
        | driver_out/read
        | fetch_driver/request_path name kid
    | fetch_turn next effects .false
  +  respond
    \ name=iota kid=iota result=fetch_result s=fetch_state
    ^ fetch_turn
    = response=myth
        ? result
         > (./ok status url headers body)
          | fetch/res_ok status url headers body
         > (./err code)
          | fetch/res_err code
      write=fetch_effect
        | fetch_effect/send
        | driver_out/cmd name
        | task/vine (| fetch_driver/request_path name kid)
        | writ/poke response
      next=fetch_state
        | fetch_state s.claimed
          | fetch_driver/without kid s.reading
         | fetch_driver/without kid s.pending
        s.queue.snoc((| fetch_ack kid .false)).snoc((| fetch_ack kid .true))
    | fetch_turn next [write (| fetch_driver/clear name kid)] .false
  +  read
    \ name=iota p=path rec=res[myth] s=fetch_state
    ^ fetch_turn
    ? !(| eq p.len 3)
      | fetch_driver/unchanged s
    ? !(| eq_pith p.take(2) (| io_path name))
      | fetch_driver/unchanged s
    = kid p.at(2)
    ? !(s.reading.has(kid))
      | fetch_driver/unchanged s
    = next s.set_reading((| fetch_driver/without kid s.reading))
    ?> (./known t) rec
       | fetch_turn next.set_queue(s.queue.snoc((| fetch_ack kid .true)))
         [(| fetch_driver/clear name kid)] .false
    = method t.nat_at(['method] 0)
      url t.nat_at(['url] 0)
    ? ((| eq method 0) || (| eq url 0))
      | fetch_driver/respond name kid (| fetch_result/err 0) next
    = request
        | fetch_request method url (| fetch/hdrs t) t.nat_at(['body] 0)
          t.nat_at(['connect] 0) t.nat_at(['deadline] 30000)
          t.nat_at(['redirects] 0) t.nat_at(['maxbody] 1048576)
    | fetch_turn next.set_pending(s.pending.snoc(kid))
      [(| fetch_effect/start kid request)] .false
  +  ack
    \ r=rsvp s=fetch_state
    ^ fetch_turn
    ? (| eq s.queue.len 0)
      | fetch_driver/unchanged s
    = head s.queue.at(0)
      next s.set_queue(s.queue.drop(1))
    ? r
     > (./no err)
       | fetch_turn next [(| fetch_effect/failed head.kid)] .false
     > (./ok _)
       = claimed=path
           ? head.clear
             | fetch_driver/without head.kid s.claimed
           s.claimed
       | fetch_driver/unchanged next.set_claimed(claimed)
  +  step
    \ name=iota s=fetch_state event=fetch_event
    ^ fetch_turn
    ? event
     > (./done kid result)
       ? s.pending.has(kid)
         | fetch_driver/respond name kid result s
       | fetch_driver/unchanged s
     > (./helm message)
       ? message
        > (./go rec) | fetch_driver/watch name rec s
        > (./change p rec)
          ? (| eq_pith p (| io_path name))
            | fetch_driver/watch name rec s
          | fetch_driver/unchanged s
        > (./view _ _) | fetch_driver/unchanged s
        > (./qres p rec) | fetch_driver/read name p rec s
        > (./ack r) | fetch_driver/ack r s
        > .die | fetch_turn s [] .true
  +  perform
    \ ports=fetch_ports effects=row[fetch_effect]
    ^ nat
    % i=nat 0
    ? (| eq i effects.len)
      0
    ; ? effects.at(i)
       > (./send message) (ports.send message)
       > (./start kid request) (ports.start kid request)
       > (./failed kid) (ports.failed kid)
    | _ i.inc
  +  run
    \ ports=fetch_ports name=iota initial=driver_in
    ^ nat
    % state=fetch_state fetch_state/empty
      event=fetch_event | fetch_event/helm initial
    = ;turn | fetch_driver/step name state event
    ; | fetch_driver/perform ports turn.effects
    ? turn.stop
      0
    = ;next (ports.recv 0)
    | _ turn.state next
