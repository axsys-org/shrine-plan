' --- sept ---

+  uon
  (@@ v)
  +  size
    '  Number of entries; reads the cached sz.
    '  ?=  ((uon/size[nat] (uon/empty)) 0)
    \ t=uon[v]
    ^ nat
    > n=uon/node[v] t
     0
    n.sz
  +  n
    '  Node builder: recomputes the size cache.
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    | uon/node[v] l.size.inc.add(r.size)
      key val l r
  +  from_keys
    '  Build an index with one shared value; repeated keys collapse.
    \  value=v keys=row[iota]
    ^  uon[v]
    |  keys.fold (uon/empty)
    \  acc key
    acc.put(key value)
  +  sing
    '  ?=  ((uon/size[nat] (uon/sing[nat] '1 10)) 1)
    \ key=iota val=v
    ^ uon[v]
    | uon/n[v] key val  ' key val'
     (uon/empty) (uon/empty) ' l r
  +  rot_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  r
     | uon/n[v] key val
       l r
    | uon/n[v] n.key n.val
     | uon/n[v] key val l n.l
     n.r
  +  rot_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  l
      | uon/n[v] key val
        l r
    | uon/n[v] n.key n.val
      n.l
      | uon/n[v] key val n.r r
  +  rot_ll
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v]  r
     (uon/n[v] key val l r)
    > m=uon/node[v]  n.l
     (uon/rot_l[v] key val l r)
    | uon/n[v] m.key m.val
      | uon/n[v] key val l m.l
      | uon/n[v] n.key n.val m.r n.r
  +  rot_rr
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    > m=uon/node[v] n.r
     | uon/rot_r[v] key val l r
    | uon/n[v] m.key m.val
     | uon/n[v] n.key n.val n.l m.l
    | uon/n[v] key val m.r r
  +  rotate_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] r
     | uon/n[v] key val l r
    ? | lt n.l.size n.r.size.mul(2)
     | uon/rot_l[v] key val l r
    | uon/rot_ll[v] key val l r
  +  rotate_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    ? | lt n.r.size n.l.size.mul(2)
     | uon/rot_r[v] key val l r
    | uon/rot_rr[v] key val l r
  +  balance
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    ? | le l.size.add(r.size) 1
     | uon/n[v] key val l r
    ? | ge r.size (mul 4 l.size)
     | uon/rotate_l[v] key val l r
    ? | ge l.size (mul 4 r.size)
     | uon/rotate_r[v] key val l r
    | uon/n[v] key val l r
  +  put
    '  Ordered insert, replacing an existing key.
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 10 (uon/empty))) 10)
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 99 (uon/put[nat] '1 10 (uon/empty)))) 99)
    \  key=iota val=v a=uon[v]
    ^  uon[v]
    > n=uon/node[v] a
     | uon/sing[v] key val
    ? | lt_iota key n.key
     | uon/balance[v] n.key n.val (_ key val n.l) n.r
    ? | lt_iota n.key key
     | uon/balance[v] n.key n.val n.l (_ key val n.r)
    | uon/n[v] key val n.l n.r
  +  get
    '  The value at a key, or .none.
    \  key=iota a=uon[v]
    ^  maybe[v]
    >  n=uon/node[v] a
     .none
    ?  (lt_iota key n.key)
     | _ key n.l
    ?  (lt_iota n.key key)
     | _ key n.r
    | ./some n.val
  +  gut
    '  Lookup with a default.
    '  ?=  ((uon/gut[nat] '9 42 (uon/empty)) 42)
    \  key=iota def=v a=uon[v]
    ^  v
    a.get(key).fall(def)
  +  has
    \ key=iota a=uon[v]
    ^ bool
    a.get(key).is_some
  +  gas
    '  Insert a row of entries.
    \ b=row[uon/kv[v]] a=uon[v]
    ^ uon[v]
    | b.fold a
    \ acc [key val]
    acc.put(key val)
  +  tap
    '  Every entry, in ascending key order.
    \  a=uon[v]
    ^  row[uon/kv[v]]
    > n=uon/node[v] a
     []
    = l  | _ n.l
      r  | _ n.r
      kv | uon/kv[v] n.key n.val
    l.weld(r.cons(kv))
  +  keys
    '  Ascending keys.
    \ a=uon[v]
    ^ path
    | a.tap.fold []
    \ acc [key _] acc.snoc(key)
  +  vals
    '  Values in ascending key order.
    \  a=uon[v]
    ^  row[v]
    | a.tap.fold []
    \ acc [_ val] acc.snoc(val)
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \ meg={\ iota v v}v b=uon[v] a=uon[v]
    ^ uon[v]
    | b.tap.fold a
    \ acc [key new]
    | acc.put key
    > (./some old) acc.get(key)
     new
    | meg key old new
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=uon[v] a=uon[v]
    ^  uon[v]
    a.uno(take_new[v] b)
  +  nip
    '  Merge two trees whose key ranges are disjoint.
    \  l=uon[v] r=uon[v]
    ^  uon[v]
    l.uni(r)
  +  del2
    '  Delete a key, returning just the remaining tree.
    \  key=iota a=uon[v]
    ^  uon[v]
    > n=uon/node[v] a
     | uon/empty
    ? | lt_iota key n.key
     | uon/balance[v] n.key n.val (_ key n.l) n.r
    ? | lt_iota n.key key
     | uon/balance[v] n.key n.val n.l | _ key n.r
    | uon/nip[v] n.l n.r
  +  floor
    '  The greatest entry at or below a key, if any.
    '  ?=  ((maybe/is_some (uon/floor[nat] '5 (uon/empty))) .false)
    \  key=iota a=uon[v]
    ^  maybe[[k=iota val=v]]
    > n=uon/node[v] a
     .none
    ? | lt_iota key n.key
     | _ key n.l
    > (./some e) | _ key n.r
     | ./some [n.key n.val]
    | ./some e
  +  del
    '  Delete a key: the deleted value (if any) and the remaining
    '  tree, as an anonymous row.
    \  key=iota a=uon[v]
    ^  [found=maybe[v] rest=uon[v]]
    [a.get(key) a.del2(key)]
  +  run
    '  Map a function over the values.
    (@ w)
    \  fun={\ v}w a=uon[v]
    ^  uon[w]
    > n=uon/node[v] a
     uon/empty
    | uon/node[w] n.sz n.key | fun n.val
     | _ fun n.l
    | _ fun n.r

  +  apt_in
    '  Order + size-cache invariant, with open bounds.
    \  lo=maybe[iota] hi=maybe[iota] a=uon[v]
    ^  bool
    > n=uon/node[v] a
     .true
    ?  !(lt_bound lo n.key)
     .false
    ?  !(gt_bound hi n.key)
     .false
    ?  !(eq n.sz n.l.size.inc.add(n.r.size))
     .false
    ?  !(_ lo (./some n.key) n.l)
     .false
    | _ | ./some n.key
      hi n.r
  +  apt
    '  The order and size-cache invariant check.
    '  ?=  ((uon/apt[nat] (uon/empty)) 1)
    \  a=uon[v]
    ^  bool
    a.apt_in(.none .none)

' --- bond ---

' Compatibility facade for the shared system slot vocabulary.
+  bond
  '  The slot vocabulary, one member per well-known key.
  +  content
    '  The primary item at this name.
    '
    '  This is the default target of most overlays that act on a pail.
    ^  path
    system_vocabulary/content
  +  src
    '  Textual source.
    ^  path
    system_vocabulary/src
  +  lede
    '  A short title for this name.
    ^  path
    system_vocabulary/lede
  +  help
    '  A longer description of what the name is/does.
    ^  path
    system_vocabulary/help
  +  mold
    '  Canonical type description of a published definition.
    '
    '  The descriptor is grounded in the selected system publication.
    ^  path
    system_vocabulary/mold
  +  limb
    '  List of transition functions that govern the evolution of a path.
    '
    '  A list of paths to records whose /sys/form slot holds a behavior.
    '  The behavior chain: if present, must be a list of paths
    '  to behaviors; if absent, treated as if ~, meaning the path is
    '  unconstrained.
    ^  path
    system_vocabulary/limb
  +  form
    '  A behavior implementation referenced by a /sys/limb list.
    ^  path
    system_vocabulary/form
  +  crew
    '  The dependency map: from local slot name to (care, path).
    ^  path
    system_vocabulary/crew
  +  author
    ^  path
    system_vocabulary/author
  +  unreads
    '  Used to indicate that a path has unreads.
    ^  path
    system_vocabulary/unreads
  +  req
    '  The request record on a driver-minted node.
    ^  path
    system_vocabulary/req
  +  res
    '  The response record a serving behavior writes back.  Presence is
    '  the completion signal — there is no separate done flag.
    ^  path
    system_vocabulary/res
  +  weft
    ^  path
    system_vocabulary/weft
  +  tack
    '  The /x view lens's data dependency: a y-care safe pinning the
    '  subtree the node's weft runs against.
    ^  path
    system_vocabulary/tack
  +  face
    '  The datum face binding: a hunt whose care is BOTH the ctor's
    '  input care and the claim reach over this record's subtree
    '  (.x the node alone, .y plus its direct kids, .z the whole
    '  subtree), and whose path names the component ctor node the
    '  page renders through ("."-headed rebases at mount, so it is
    '  absolute post-mount — unlike a face kook's ['hunt] claim,
    '  whose path stays mount-root-relative).
    ^  path
    system_vocabulary/face
  +  lash
    ^ path
    system_vocabulary/lash
  +  op
    ^ path
    system_vocabulary/op
  +  about
    ^ path
    system_vocabulary/about
  +  from
    ^ path
    system_vocabulary/from
  +  now
    ^ path
    system_vocabulary/now
  + epoch
    ' A counter used for the purposes of triggering actions or sync
    system_vocabulary/epoch
  + pending
    ' Something waiting
    system_vocabulary/pending

' --- fs_read ---

+ fs_read
  ' A flat directory snapshot. Bytes retain the native bar sentinel.
  + file
    : name=str bytes=nat

  + entries
    \ root=str ents=row[[directory=nat name=str]]
    ^ either[str row[fs_read/file]]
    % idx=nat 0 out=row[fs_read/file] []
    ^ either[str row[fs_read/file]]
    ? (eq idx ents.len)
     | ./ok out
    = [kind leaf] ents.at(idx)
    ? kind
     | _ idx.inc out
    = name | str/cat_all [root "/" leaf]
    = ;data | ReadFile name
    ? (eq data 0)
     | ./err (str/cat_all ["Cannot read file: " name])
    | _ idx.inc out.snoc((fs_read/file leaf data))

  + read
    ' ReadFolder conflates empty directories with listing failures.
    ' Its directory flag follows symlinks; other file kinds are untyped.
    \ root=str
    ^ either[str row[fs_read/file]]
    ? (equal[str] root "")
     | ./err "Filesystem directory is unset"
    = ;ents | ReadFolder root
    | ;/entries root ents

  + response
    \ fd=nat
    ^ str
    % chunks=row[str] [] size=nat 0
    ^ str
    = ;bytes (Read fd 4096)
    ? (le bytes 1) (str/cat_all chunks)
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
      size (add size text.len)
    ? (gt size 4096) "Scanner response too large"
    | _ chunks.snoc(text) size

  + remote
    ' Refresh one selected bag through the host scanner, then capture its bytes.
    \ port=nat token=str root=str
    ^ either[str row[fs_read/file]]
    ? (eq port 0) (fs_read/read root)
    = ;fd (Connect 0 "127.0.0.1" port)
      line (str/cat_all [token (str/from_atom 10) root (str/from_atom 10)])
      bytes (add (str/to_atom line) (bex (mul 8 line.len)))
    ; (Write fd bytes)
    = ;received (Try fs_read/response fd)
    ; (CloseFd fd)
    > (./ok text) received (./err "Scanner connection failed")
    ? !(equal[str] text "OK") (./err text)
    | fs_read/read root

' --- shrine_types ---

+  yoke
  +  adopt
    '  Seed records with their spec'd contracts adopted: every seed
    '  whose path this yoke lashes gets the lash at system_vocabulary/lash.
    '  The mounting write is itself the adoption (contract-changing
    '  writes are gate-exempt), so every LATER write to the node is
    '  judged by the commit gate.  The empty lash is skipped —
    '  adopting no constraints would only add noise.
    \  y=yoke seeds=row[[p=path t=myth]]
    ^  row[[p=path t=myth]]
    =  one
         \  seed=[p=path t=myth]
         ^  [p=path t=myth]
         =  [p t]  seed
         ?  (yoke/at p y)
          > (./some l)
            ?  (equal l lash/new)  [p t]
            [p t.put(system_vocabulary/lash l)]
          > .none
            [p t]
    seeds.map(one)

' --- lain_types ---

+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (pails/n x)
+  pt
  '  A text pail: pd's twin, for hosts that hold a cord rather than a
  '  number.  Both exist because pails/n and pails/t are nominal
  '  records — a host reaching for /pails/t through the subject gets
  '  the TYPE, not a constructor, and silently builds an unreadable
  '  slot (which is how the chat app's credential became an empty
  '  Bearer header).  Call these, not the record paths.
  \  x=str
  ^  pail
  (pails/t x)
+  lash
  +  texted
    '  The one-slot starter contract: the slot must be present and
    '  must carry text — the smallest lash that does anything, and
    '  the demo spelling for adopting a contract in one poke.
    \  slot=path lede=nat
    ^  lash
    |  lash (mop/empty)
       (mop/sing[path curb lt_pith] slot (curb/of_type (^ pails/t)))
       [[slot]]
       lede
       0
+  twig
  '  Limb constructors for the common wrappers: one idiom for every
  '  slot creation — t.add((twig/nat ['n] 7)).
  +  nat
    \  s=path n=nat
    ^  twig
    (twig s (pails/n n))
  +  txt
    \  s=path t=str
    ^  twig
    (twig s (pails/t t))
  +  iota
    \  s=path q=iota
    ^  twig
    (twig s (pails/q q))
  +  pat
    \  s=path p=path
    ^  twig
    (twig s (pails/p p))
+  myth
  '  Slot readers, unwrapping the common pails by rep.
  +  nat_at
    '  Read a data slot, with default.
    \  slot=path d=nat t=myth
    ^  nat
    ?  t.get(slot)
     > .none  d
     > (./some pl=pail)
       ?  pl
        > x=pails/n  x.n
       d
  +  txt_at
    '  Read a text slot, or the empty string when absent or foreign.
    \ slot=path t=myth
    ^ str
    > (./some held) t.get(slot)
      ""
    > text=pails/t held
      ""
    text.t
  +  path_at
    '  A path-valued slot, preserving the distinction between root and absence.
    \ slot=path t=myth
    ^ maybe[path]
    > (./some held) t.get(slot)
      .none
    > val=pails/p held
      .none
    | ./some val.p
  +  crew_at
    '  A crew-valued slot, or empty when absent or foreign.
    \ slot=path t=myth
    ^ crew
    > (./some held) t.get(slot)
      (mop/empty)
    > val=crew/pail held
      (mop/empty)
    val.crew
  +  copy_slot
    '  Copy a present slot, including a foreign pail; absence leaves t intact.
    \ slot=path src=myth t=myth
    ^ myth
    > (./some held) src.get(slot)
      t
    | t.put slot held
  +  code_at
    '  Read a compiled-value slot: the code pail's payload at slot,
    '  or 0.
    \  slot=path t=myth
    ^  any
    ?  t.get(slot)
     > .none  0
     > (./some pl=pail)
       ?  pl
        > x=pails/code  x.v
       0
  +  quip_at
    '  Read a iota slot: the pails/q payload at slot, if any.
    \  slot=path t=myth
    ^  maybe[iota]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/q  (./some x.q)
       .none
  +  pail_at
    '  Read a slot's raw pail, or a zero pails/n when absent —
    '  host-side consumers unwrap by rep (the brand cord rides in
    '  the head).
    \  slot=path t=myth
    ^  pail
    ?  t.get(slot)
     > (./some pl=pail)  pl
     > .none  (pd 0)
  +  has_at
    '  Whether the myth has anything at slot — a monomorphic wrapper
    '  over the mop method, so hosts can call it across the FFI.
    \  slot=path t=myth
    ^  bool
    t.has(slot)
+  def_init
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_talk
  '  Default talk: union, the poke wins.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  o cur.meld(add)
  (yell [] o)
+  def_take
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  (yell [] cur)
+  def_hear
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  (yell [] cur)
+  def_dead
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_form
  '  The default behavior: init/talk as documented, take/hear keep
  '  state.
  ^  form
  (form def_init def_talk def_take def_hear def_dead def_dead)
+  limb_slot
  '  The well-known slot holding a node's behavior id list
  '  (bond/limb: the behavior chain).
  ^  path
  bond/limb
+  crew_slot
  '  The well-known slot holding a node's dependency map
  '  (bond/crew).
  ^  path
  bond/crew
+  is_h
  '  Is this path under the temporal-transposition overlay (/h)?
  '  Read-only and derived: writes here fail the event.
  \ p=path
  ^ bool
  p.starts('h)

+  is_o
  '  Is this path under the overlay lens (/o)?  Read-only and
  '  derived: writes here fail the event.
  \ p=path
  ^ bool
  p.starts('o)

+  is_xv
  '  Is this path under the view lens (/x)?  /x/...path runs the
  '  pinned weft and tack selected by the defining datum's case.  Read-only and derived, like /h and /o.
  \ p=path
  ^ bool
  p.starts('x)

+  kooked
  '  An empty myth carrying kook refs — full form-node paths.
  \  refs=row[path]
  ^  myth
  =  t  myth/new
  t.put(limb_slot (kook refs))

' --- path_segments ---

' Canonical document path segments and explicit instance-relative markers.
+  invalid_segment
  \ ignored=unit
  ^ path
  ; (error (pails/t "Invalid namespace segment in document"))
  []
+  seg_iotas
  ' Canonical source segments preserve each aura. A leading dot is the
  ' explicit instance-relative marker, interpreted only by installation.
  ' ?= ((seg_iotas ["a" "b"]) [($ts "a") ($ts "b")])
  ' ?= ((seg_iotas ["0x0001" "a"]) [($x 256) ($ts "a")])
  \ segs=row[nat]
  ^ path
  % i=nat 0 out=path []
  ^ path
  ? (ge i segs.len) out
  = segment segs.at(i)
  ? (eq i 0)
    ? (eq segment ".") (_ i.inc out.snoc(($ts ".")))
    > (./some parsed) (path_parse (str/from_atom (cord/cat "/" segment)))
        (invalid_segment [])
    | _ i.inc out.weld(parsed)
  > (./some parsed) (path_parse (str/from_atom (cord/cat "/" segment)))
      (invalid_segment [])
  | _ i.inc out.weld(parsed)

+  seg_texts
  ' Canonical path spelling preserves segment auras in hydrated documents.
  ' ?= ((seg_texts ['a 'b]) ["a" "b"])
  ' ?= ((seg_texts [($x 256) 'a]) ["0x0001" "a"])
  \ p=path
  ^ row[nat]
  | p.map
  \ segment=iota
  ^ nat
  ? (eq_iota segment ($ts ".")) "."
  = printed | str/to_atom (path_show [segment])
  | cord/slice 1 (sub (cord/len printed) 1) printed

' --- runtime_context ---

' Node identity comes from the prepared compilation context, never a slot key.
+ runtime_context
  + who
    ^ iota
    | context_who 0
  + service
    \ relative=path
    ^ path
    | row/weld[iota] relative [runtime_context/who]

' --- sail ---

'  HTML builder target. Builder forms expand to these ordinary functions.
+  sail
  +  attribute
    :  key=nat value=nat
  +  child
    &  sail/child/text
       sail/child/element
    +  text
      :  value=nat
    +  element
      :  tag=nat fields=row[sail/attribute] kids=row[sail/child]

  +  cat
    \ a=nat b=nat
    ^ nat
    | cord/cat a b
  +  join
    \ xs=row[nat]
    ^ nat
    | cord/cat_all xs
  +  text
    '  Text is a packed cord. Use nat_show for numeric values.
    \  value=nat
    ^  sail/child
    (./text value)
  +  texts
    '  An atomic group of text pieces contributes exactly one child.
    \  values=row[nat]
    ^  sail/child
    (sail/text (sail/join values))
  +  field
    \  key=nat value=nat
    ^  sail/attribute
    (sail/attribute key value)
  +  split
    \ sep=nat s=nat
    ^ row[nat]
    | cord/split_byte sep s
  +  class_join
    \ acc=nat x=nat
    ^  nat
    ?  (eq acc 0)
      x
    (sail/cat acc (sail/cat " " x))
  +  node
    '  A dotted head supplies CSS classes: div.card.selected.
    \  head=nat fields=row[sail/attribute] kids=row[sail/child]
    ^  sail/child
    =  parts (sail/split 46 head)
       classes (row/fold[nat nat] 0 sail/class_join parts.drop(1))
       attrs
         ?  (eq classes 0)
           fields
         (row/weld fields [(sail/field "class" classes)])
    (./element parts.at(0) attrs kids)
  +  bind
    (@ v)
    \  values=row[v] f={\ v}row[sail/child]
    ^  row[sail/child]
    values.fold([] (\ acc=row[sail/child] value=v acc.weld((f value))))
  +  escape
    \  s=nat
    ^  nat
    %  todo=nat s out=nat 0
    ?  (eq todo 0)
      out
    =  c (mod todo 256)
       piece
         ?  (eq c 38)
           "&amp;"
         ?  (eq c 60)
           "&lt;"
         ?  (eq c 62)
           "&gt;"
         ?  (eq c 34)
           "&quot;"
         c
    (_ (rsh todo 8) (sail/cat out piece))
  +  boolean_field
    \  key=nat
    ^  bool
    | row/has[nat] key
    ["checked" "disabled" "selected" "multiple" "required" "readonly"
     "autofocus" "hidden" "open" "controls" "loop" "muted" "autoplay"
     "novalidate" "formnovalidate" "reversed" "ismap" "defer" "async"
     "allowfullscreen" "inert"]
  +  render_field
    \  a=sail/attribute
    ^  nat
    ?  (sail/boolean_field a.key)
      ?  a.value
        (sail/cat " " (sail/escape a.key))
      0
    (sail/join [" " (sail/escape a.key) "=" 34 (sail/escape a.value) 34])
  +  void
    \  tag=nat
    ^  bool
    | row/has[nat] tag
    ["area" "base" "br" "col" "embed" "hr" "img" "input" "link"
     "meta" "param" "source" "track" "wbr"]
  +  render_child
    \  child=sail/child
    ^  nat
    ?  child
     > (./text value)
       (sail/escape value)
     > (./element tag fields kids)
       =  me (_)
          start (sail/join ["<" (sail/escape tag)
            (sail/join fields.map(sail/render_field)) ">"])
       ?  (sail/void tag)
         start
       (sail/join [start (sail/join kids.map(me)) "</" (sail/escape tag) ">"])
  +  render
    \  children=row[sail/child]
    ^  nat
    (sail/join children.map(sail/render_child))

' --- temporal ---

' Formatting is deterministic UTC. Keep the literal's precision in stored pails.
+ temporal
  + pad
    \ width=nat text=str
    ^ str
    | str/cat_all [(str/repeat (sub width text.len) "0") text]
  + fraction
    \ ticks=nat bits=nat
    ^ str
    = remainder (mod ticks (bex bits))
    ? (eq remainder 0) ""
    = decimal
        % left=nat bits value=nat remainder
        ? (eq left 0) (temporal/pad bits (nat/show value))
        | _ left.dec (mul value 5)
    % length=nat decimal.len
    ? (eq decimal.at(length.dec) 48) (_ length.dec)
    | str/cat_all ["." decimal.slice(0 length)]
  + timestamp
    \ value=iota
    ^ str
    = bits (? (eq (aura_tag value) "ds") 50 10)
      prefix (? (eq bits 50) 2 1)
      printed (str/from_atom (iota_show value))
      parts (printed.slice(prefix (sub printed.len prefix)).split_byte(46))
      date (str/join "-" [(temporal/pad 4 parts.at(0)) (temporal/pad 2 parts.at(1)) (temporal/pad 2 parts.at(2))])
      time (str/join ":" [(temporal/pad 2 parts.at(4)) (temporal/pad 2 parts.at(5)) (temporal/pad 2 parts.at(6))])
    | str/cat_all [date " " time (temporal/fraction (quip_val value) bits) " UTC"]
  + duration
    \ value=nat
    ^ str
    = units=row[[nat str]] [[86400000 "d"] [3600000 "h"] [60000 "m"] [1000 "s"] [1 "ms"]]
    = result
        % rest=nat value index=nat 0 out=row[str] []
        ? (eq index units.len) out
        = [scale suffix] units.at(index)
          count (div rest scale)
        | _ (mod rest scale) index.inc (? count out.snoc((str/cat_all [(nat/show count) suffix])) out)
    ? (eq result.len 0) "0ms"
    | str/join " " result

' --- testing ---

+  testing
  '  Checks are data. The host forces each named case under Try.
  +  check
    : name=str pass=bool want=str got=str

  +  case
    : name=str run={\ unit}row[testing/check]

  +  same
    (@ v)
    \ name=str show={\ v}str want=v got=v
    ^ testing/check
    | testing/check name (equal want got)
      (show want) (show got)

  +  nat
    \ name=str want=nat got=nat
    ^ testing/check
    | testing/same[nat] name nat/show want got

  +  text
    \ name=str want=str got=str
    ^ testing/check
    | testing/check name (equal want got) want got

  +  table
    (@ v w)
    \ name=str show={\ w}str func={\ v}w
       rows=row[[input=v want=w]]
    ^ row[testing/check]
    | rows.map
     \ pair=[input=v want=w]
     ^ testing/check
     = [arg want] pair
     | testing/same[w] name show want (func arg)

' --- tyshow ---

'  tyshow: the type pretty-printer, in Foil.  A
'  reflected descriptor ((^ expr), the builtin `type`
'  sum) renders to the same text the compiler's own
'  renderer produces (foil-render new-ty-text).
+  tyshow
  +  is_txt
    '  Whether v is a nonempty printable-ASCII cord.
    '  ?=  ((tyshow/is_txt "abc") 1)
    '  ?=  ((tyshow/is_txt 3) 0)
    \ v=nat
    ^ bool
    ? (eq v 0) .false
    % i=nat 0
    ? (eq i (wid v)) .true
    = byte | load8 i v
    ? (or (lt byte 32) (gt byte 126)) .false
    | _ i.inc

  +  atom_text
    '  A cord atom as itself when printable, else its
    '  decimal digits.
    \ v=nat
    ^ nat
    ? (tyshow/is_txt v) v
    | nat/show v

  +  cst_text
    '  A constant: '$foo for printable symbols, digits
    '  otherwise.
    '  ?=  ((tyshow/cst_text "hello") "'$hello")
    '  ?=  ((tyshow/cst_text 3000000000) "3000000000")
    \ val=nat
    ^ nat
    ? (tyshow/is_txt val) (cord/cat "'$" val)
    | nat/show val

  +  path_text
    '  /a/b, every segment slash-prefixed; a ~-headed
    '  path (a unit-qualified storage key) renders
    '  ~/local/path.
    '  ?=  ((tyshow/path_text ["sys" "types" "nat"]) "/sys/types/nat")
    \ segs=row[nat]
    ^ nat
    % idx=nat 0 out=nat ""
    ? (eq idx segs.len) out
    = seg segs.at(idx)
    =   part
      ? (and (eq idx 0) (eq seg "~"))
       "~"
       | cord/cat "/" (tyshow/atom_text seg)
    | _ idx.inc (cord/cat out part)

  +  show
    '  Render a type descriptor, one arm per member of
    '  the closed `type` sum, byte-identical to the
    '  compiler's renderer.
    '  ?=  ((tyshow/show (^ 1)) "1")
    '  ?=  ((tyshow/show (^ nat)) "/sys/types/nat@x1")
    \ t=type
    ^ nat
    ? t
     > .any "any"
     > .pail "pail"
     > .bot "bot"
     > .opq "'..."
     > (./nat aura) (tyshow/nat_text aura)
     > (./cst val) (tyshow/cst_text val)
     > (./var name)
      | cord/cat "@" (tyshow/atom_text name)
     > (./arr item) (tyshow/wrap "row[" item "]")
     > (./pin item) (tyshow/wrap "pin[" item "]")
     > (./fun args ret) (tyshow/fun_text args ret)
     > (./sum opts) (tyshow/sum_text opts)
     > (./rec cstr items) (tyshow/rec_text cstr items)
     > (./ref identity args)
      | tyshow/ref_text identity args
     > (./nom path args) (tyshow/nom_text path args)
     > (./gen params body)
      | tyshow/gen_text params body

  +  many
    '  Descriptors joined by a separator.
    \ sep=nat ts=row[type]
    ^ nat
    | cord/join sep ts.map(tyshow/show)

  +  wrap
    '  A descriptor between an opener and a closer.
    \ open=nat t=type close=nat
    ^ nat
    | cord/cat_all [open (tyshow/show t) close]

  +  nat_text
    '  nat, or nat/aura for an aura'd nat.
    \ aura=nat
    ^ nat
    ? (eq aura 0) "nat"
    | cord/cat "nat/" (tyshow/atom_text aura)

  +  fun_text
    '  {\ a b}c, or {\}c without arguments.
    \ args=row[type] ret=type
    ^ nat
    = ret_text  | tyshow/show ret
      args_text | tyshow/many " " args
    ? (eq 0 args.len) (cord/cat "{\}" ret_text)
    | cord/cat_all ["{\ " args_text "}" ret_text]

  +  sum_text
    '  (a | b | c)
    \ opts=row[type]
    ^ nat
    = inner | tyshow/many " | " opts
    | cord/cat_all ["(" inner ")"]

  +  rec_text
    '  [a=t b=u], with the constructor's name in front
    '  when the record has one.
    \ cstr=nat items=row[[face=nat item=type]]
    ^ nat
    = body | cord/join " " (tyshow/record_parts items)
      name | tyshow/constructor_name cstr
    ? cstr (cord/cat_all [name "[" body "]"])
    | cord/cat_all ["[" body "]"]

  +  ref_text
    '  A definition reference with its type arguments.
    \ identity=nat args=row[type]
    ^ nat
    = name | tyshow/definition_name identity
    | tyshow/applied name args

  +  nom_text
    '  A nominal path with its type arguments.
    \ path=row[nat] args=row[type]
    ^ nat
    | tyshow/applied (tyshow/path_text path) args

  +  applied
    '  name, or name[args] when there are arguments.
    \ name=nat args=row[type]
    ^ nat
    ? (eq 0 args.len) name
    = inner | tyshow/many " " args
    | cord/cat_all [name "[" inner "]"]

  +  gen_text
    '  The parameter prefix followed by the body.
    \ params=row[[cnst=nat name=nat cty=type]]
      body=type
    ^ nat
    = head | tyshow/gen_prefix params
    | cord/cat head (tyshow/show body)

  +  constructor_name
    '  A nominal constructor by its definition, else
    '  the atom itself.
    \ name=nat
    ^ nat
    ? (nominal_brand name)
     | tyshow/definition_name name
    | tyshow/atom_text name

  +  definition_name
    '  path@xN for a decodable definition brand.  Compiler module
    '  segments can contain slashes: this is a display name, so their
    '  text is kept instead of going through the symbol printer.
    \ identity=nat
    ^ nat
    > (./some reference) (brand_decode identity)
     "<invalid-definition>"
    = [path version] reference
    =   parts=row[nat]
      | path.map
       \ part
       ? (eq (aura_tag part) "ts") (quip_val part)
       | iota_show part
    = seen | cord/join "/" parts
      ver  | nat/show version
    | cord/cat_all ["/" seen "@x" ver]

  +  record_parts
    '  Shared field spelling for flat and multiline
    '  records.
    \ items=row[[face=nat item=type]]
    ^ row[nat]
    % idx=nat 0 out=row[nat] []
    ? (eq idx items.len) out
    = [face item] items.at(idx)
      text        | tyshow/show item
      label       | tyshow/atom_text face
    =   part=nat
      ? (eq face idx)
       text
       | cord/cat_all [label "=" text]
    | _ idx.inc out.snoc(part)

  +  gen_prefix
    '  A generic's parameter prefix: @a for type
    '  parameters, @[name cty] for const parameters,
    '  each trailing one space.
    \ params=row[[cnst=nat name=nat cty=type]]
    ^ nat
    % idx=nat 0 out=nat ""
    ? (eq idx params.len) out
    = [flag name cty] params.at(idx)
      label           | tyshow/atom_text name
      cty_text        | tyshow/show cty
    =   part
      ? flag
       | cord/cat_all ["@[" label " " cty_text "] "]
       | cord/cat_all ["@" label " "]
    | _ idx.inc (cord/cat out part)

  +  nl
    '  A newline, as a one-byte cord.
    ^ nat
    10

  +  lines
    '  Parts on their own lines between an opener and
    '  a closer, each continuation line led by sep.
    \ open=nat sep=nat close=nat parts=row[nat]
    ^ nat
    = glue | cord/cat tyshow/nl sep
    | cord/cat_all [open (cord/join glue parts) close]

  +  pretty
    '  Render a descriptor for a page: a short type
    '  stays on one line; a long function, sum,
    '  record, or generic breaks at its top level,
    '  one part per line, continuation-aligned.
    '  ?=  ((tyshow/pretty (^ nat)) "/sys/types/nat@x1")
    \ t=type
    ^ nat
    = flat | tyshow/show t
    ? (lt (wid flat) 64) flat
    ? t
     > (./fun args ret)
      = close | cord/cat_all ["}" (tyshow/show ret)]
        parts args.map(tyshow/show)
      | tyshow/lines "{\ " "   " close parts
     > (./sum opts)
      = parts opts.map(tyshow/show)
      | tyshow/lines "(  " "|  " ")" parts
     > (./rec cstr items)
      = parts | tyshow/record_parts items
        name  | tyshow/constructor_name cstr
        open  | cord/cat_all [name "[  "]
      ? cstr (tyshow/lines open "   " "]" parts)
      | tyshow/lines "[  " "   " "]" parts
     > (./gen params body)
      = head | tyshow/gen_prefix params
        rest | tyshow/pretty body
      | cord/cat_all [head tyshow/nl rest]
    flat

' --- weft ---

'  weft: an HTML templating library — node trees rendered to cords.
'  .
'  Cords are LE byte-packed nats. Text utilities delegate to Sept.
'  Rendering never welds as it goes — that pays bignum work per
'  append, quadratic in the page.  Instead render assembles a
'  CordTree (str_text / str_slice / str_cat nodes, O(1) each) and
'  str_run flattens it in one native pass; esc slices whole runs of
'  safe bytes found by scan8 rather than dividing per byte.  Text
'  nodes escape at render time; raw nodes (style bodies) do not.
'  ~ weft/build constructs these same nodes with the generic builder syntax.
+  weft
  +  blen
    '  Byte length of a cord (the native width).
    '  ?=  ((weft/blen 0) 0)
    '  ?=  ((weft/blen "abc") 3)
    \  s=nat
    ^  nat
    (wid s)
  +  bex8
    '  256^n — the shift for welding above an n-byte cord.  A native
    '  shift: rebuilding it by repeated multiplication made every
    '  append quadratic in the accumulated length.
    \  n=nat
    ^  nat
    (lsh 1 (mul 8 n))
  +  cat2
    '  Weld two cords: b lands above a's bytes.
    '  ?=  ((weft/cat2 "ab" "cd") "abcd")
    '  ?=  ((weft/cat2 0 "x") "x")
    \ a=nat b=nat
    ^ nat
    | cord/cat a b
  +  cat
    '  Build a CordTree and flatten once, including compile-time constants.
    '  ?=  ((weft/cat ["a" "b" "c"]) "abc")
    '  ?=  ((weft/cat []) 0)
    '  ?=  ((weft/cat [0 "ab" 0 "cd" 0]) "abcd")
    \ xs=row[nat]
    ^ nat
    = tree
        % i=nat 0 acc=any (str_text 0)
        ^ any
        ? (eq i xs.len) acc
        | _ i.inc (str_cat acc (str_text xs.at(i)))
    | str_run tree
  +  join
    '  Build separated pieces as a CordTree and flatten once.
    '  ?=  ((weft/join "/" ["a" "b"]) "a/b")
    '  ?=  ((weft/join "/" []) 0)
    '  ?=  ((weft/join "/" [0 "a" 0]) "/a/")
    '  ?=  ((weft/join "/" ["a"]) "a")
    \ sep=nat xs=row[nat]
    ^ nat
    = tree
        % i=nat 0 acc=any (str_text 0)
        ^ any
        ? (eq i xs.len) acc
        = before=any
            ? (eq i 0) acc
            | str_cat acc (str_text sep)
        | _ i.inc (str_cat before (str_text xs.at(i)))
    | str_run tree
  +  esc_class
    '  The scan8 byte-set of the four dangerous bytes (& < > quote).
    \  _z=nat
    ^  nat
    (add (bex 34) (add (bex 38) (add (bex 60) (bex 62))))
  +  ent
    '  The entity for a dangerous byte.
    '  ?=  ((weft/ent 38) "&amp;")
    '  ?=  ((weft/ent 60) "&lt;")
    \  b=nat
    ^  nat
    ?  (eq b 38)
       "&amp;"
    ?  (eq b 60)
       "&lt;"
    ?  (eq b 62)
       "&gt;"
    "&quot;"
  +  tcat
    '  Weld a row of CordTrees.
    \  xs=row[any]
    ^  any
    %  i=nat 0  acc=any (str_text 0)
    ^  any
    ?  (eq i xs.len)
       acc
    (_ i.inc (str_cat acc xs.at(i)))
  +  esc_tree
    '  HTML-escape s as a CordTree: each run of safe bytes rides as
    '  one slice of s (scan8 finds the run natively), so cost scales
    '  with the escape count, not the byte count.
    \  s=nat
    ^  any
    =  n (wid s)
    =  cls (weft/esc_class 0)
    %  i=nat 0  acc=any (str_text 0)
    ^  any
    ?  (ge i n)
       acc
    =  e (scan8_end s i cls 0)
    =  acc2 (str_cat acc (str_slice s i (sub e i)))
    ?  (ge e n)
       acc2
    (_ e.inc (str_cat acc2 (str_text (weft/ent (load8 e s)))))
  +  esc
    '  HTML-escape: the four dangerous bytes become entities.
    '  ?=  ((weft/esc "a<b") "a&lt;b")
    '  ?=  ((weft/esc "x&y") "x&amp;y")
    \  s=nat
    ^  nat
    (str_run (weft/esc_tree s))
  +  show_nat
    '  Decimal rendering of a nat.
    '  ?=  ((weft/show_nat 0) "0")
    '  ?=  ((weft/show_nat 407) "407")
    \ n=nat
    ^ nat
    | str/to_atom (nat/show n)
  +  att
    '  One attribute.
    :  k=nat v=nat
  +  node
    '  An HTML node: text (escaped at render), raw text (style
    '  bodies), or an element.
    &  weft/node/tx
       weft/node/raw
       weft/node/el

    +  tx
      :  s=nat

    +  raw
      :  s=nat

    +  el
      :  tag=nat as=row[weft/att] kids=row[weft/node]
  +  id
    \  v=nat
    (weft/att "id" v)
  +  cls
    \  v=nat
    ^  weft/att
    (weft/att "class" v)
  +  href
    \  v=nat
    ^  weft/att
    (weft/att "href" v)
  +  tx
    \  s=nat
    ^  weft/node
    (weft/node/tx s)
  +  raw
    \  s=nat
    ^  weft/node
    (weft/node/raw s)
  +  el
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  weft/node
    (weft/node/el tag as kids)
  +  leaf
    '  An element with one text kid.
    \  tag=nat as=row[weft/att] s=nat
    ^  weft/node
    (weft/node/el tag as [(weft/node/tx s)])
  +  item
    '  Anything that can appear in an element body: attributes and
    '  kids ride one interleaved list, splices flatten, nil
    '  vanishes.  weft/h partitions; the short ctors (a c hf t k ks)
    '  build members.
    &  weft/item/at
       weft/item/ats
       weft/item/kid
       weft/item/kids
       weft/item/nil

    +  at
      :  a=weft/att

    +  ats
      :  as=row[weft/att]

    +  kid
      :  n=weft/node

    +  kids
      :  ns=row[weft/node]

    +  nil
      :
  +  a
    '  An attribute item.
    \  k=nat v=nat
    ^  weft/item
    (./at (weft/att k v))
  +  c
    '  A class attribute item.
    \  v=nat
    ^  weft/item
    (./at (weft/att "class" v))
  +  hf
    '  An href attribute item.
    \  v=nat
    ^  weft/item
    (./at (weft/att "href" v))
  +  t
    '  A text kid item (escaped at render).
    \  s=nat
    ^  weft/item
    (./kid (weft/node/tx s))
  +  k
    '  A node kid item.
    \  n=weft/node
    ^  weft/item
    (./kid n)
  +  ks
    '  A splice: a row of nodes welded into the kids in place.
    \  ns=row[weft/node]
    ^  weft/item
    (./kids ns)
  +  slice
    '  n bytes of s from byte offset i.
    '  ?=  ((weft/slice "abcdef" 2 3) "cde")
    \  s=nat i=nat n=nat
    ^  nat
    (mod (div s (weft/bex8 i)) (weft/bex8 n))
  +  sel_class
    '  The scan8 byte-set of the selector delimiters . # [ .
    \  _z=nat
    ^  nat
    (add (bex 35) (add (bex 46) (bex 91)))
  +  sel_kv
    '  The scan8 byte-set ending an attribute key: = or ] .
    \  _z=nat
    ^  nat
    (add (bex 61) (bex 93))
  +  sel
    '  A selector cord "tag.cls#id[k=v][k2]" parsed to its element
    '  tag and static attributes: classes join space-separated and
    '  emit first, #id is the id attribute, [k=v] is verbatim (v may
    '  hold any byte but "]"), bare [k] gets k as its value (the
    '  defer="defer" idiom).  ok=.false on a malformed selector —
    '  empty tag, empty class/id/key, or an unclosed [ — so weft/h
    '  can render the mistake loudly rather than guess.
    \  s=nat
    ^  [tag=nat as=row[weft/att] ok=bool]
    =  n   (wid s)
       te  (scan8_end s 0 (weft/sel_class 0) 0)
    ?  (eq te 0)
       [s [] .false]
    =  tag  (weft/slice s 0 te)
    %  i=nat te  cls=nat 0  rest=row[weft/att] []
    ^  [tag=nat as=row[weft/att] ok=bool]
    ?  (ge i n)
       =  as
            ?  (eq cls 0)
               rest
            rest.cons((weft/att "class" cls))
       [tag as .true]
    =  b  (load8 i s)
    ?  (eq b 46)
       =  e  (scan8_end s i.inc (weft/sel_class 0) 0)
       ?  (eq e i.inc)
          [tag [] .false]
       =  seg  (weft/slice s i.inc (sub e i.inc))
          cls2
            ?  (eq cls 0)
               seg
            (weft/cat [cls " " seg])
       (_ e cls2 rest)
    ?  (eq b 35)
       =  e  (scan8_end s i.inc (weft/sel_class 0) 0)
       ?  (eq e i.inc)
          [tag [] .false]
       (_ e cls rest.snoc((weft/att "id" (weft/slice s i.inc (sub e i.inc)))))
    ?  (eq b 91)
       =  ke  (scan8_end s i.inc (weft/sel_kv 0) 0)
       ?  (ge ke n)
          [tag [] .false]
       ?  (eq ke i.inc)
          [tag [] .false]
       =  key  (weft/slice s i.inc (sub ke i.inc))
       ?  (eq 93 (load8 ke s))
          (_ ke.inc cls rest.snoc((weft/att key key)))
       =  ve  (scan8_end s ke.inc (bex 93) 0)
       ?  (ge ve n)
          [tag [] .false]
       (_ ve.inc cls
          rest.snoc((weft/att key (weft/slice s ke.inc (sub ve ke.inc)))))
    [tag [] .false]
  +  h
    '  An element from one interleaved item list — attributes and
    '  kids in document order, splices flattened, nils dropped.  The
    '  tag may carry weft/sel static-attribute shorthand; a selector
    '  class and (weft/c ..) items on the same element both emit, so
    '  pick one spelling per element.  A malformed selector renders
    '  as an x-bad-selector element carrying the offending cord.
    '  ?=  ((weft/render (weft/h "b" [(weft/t "hi")])) "<b>hi</b>")
    '  ?=  ((weft/render (weft/h "p.big" [])) (weft/cat ["<p class=" 34 "big" 34 "></p>"]))
    '  ?=  ((weft/render (weft/h "p." [])) "<x-bad-selector>p.</x-bad-selector>")
    \  tag=nat items=row[weft/item]
    ^  weft/node
    =  [stag sas ok]  (weft/sel tag)
    ?  !ok
       (weft/node/el "x-bad-selector" [] [(weft/node/tx tag)])
    %  idx=nat 0  as=row[weft/att] sas  kids=row[weft/node] []
    ^  weft/node
    ?  (eq idx items.len)
       (weft/node/el stag as kids)
    ?  items.at(idx)
     > (./at a=weft/att)           (_ idx.inc as.snoc(a) kids)
     > (./ats more=row[weft/att])  (_ idx.inc as.weld(more) kids)
     > (./kid n=weft/node)         (_ idx.inc as kids.snoc(n))
     > (./kids ns=row[weft/node])  (_ idx.inc as kids.weld(ns))
     > .nil                        (_ idx.inc as kids)
  +  build
    '  Builder target over the existing node representation and CordTree renderer.
    '  Use ~ weft/build; fragments are row[weft/node], including one root.
    +  child
      weft/node
    +  text
      \ value=nat
      ^ weft/node
      | weft/tx value
    +  texts
      \ values=row[nat]
      ^ weft/node
      | weft/tx | weft/cat values
    +  field
      \ key=nat value=nat
      ^ weft/att
      | weft/att key value
    +  node
      '  Preserve Weft selectors, attribute ordering, and malformed-head output.
      \ head=nat fields=row[weft/att] children=row[weft/node]
      ^ weft/node
      = [tag attrs ok] | weft/sel head
      ? !ok
        | weft/el "x-bad-selector" [] [(| weft/tx head)]
      | weft/el tag attrs.weld(fields) children
    +  bind
      (@ v)
      \ values=row[v] f={\ v}row[weft/node]
      ^ row[weft/node]
      % i=nat 0 out=row[weft/node] []
      ? (eq i values.len) out
      | _ i.inc out.weld((| f values.at(i)))
  +  lnk
    '  A link leaf: an anchor with one text kid.
    \ u=nat s=nat
    ^ weft/node
    = nodes
        ~ weft/build
        ~# 'a
          'href u
          ~. s
    nodes.at(0)
  +  when
    '  The item when the guard holds, nothing otherwise. For new markup,
    '  a builder ? branch expresses conditional children directly.
    '  ?=  ((weft/render (weft/h "b" [(weft/when .false (weft/t "x"))])) "<b></b>")
    \  p=bool it=weft/item
    ^  weft/item
    ?  p
       it
    .nil
  +  each
    '  One node per row element, spliced in order.
    '  ?=  ((weft/render (weft/h "u" [(weft/each[nat] ["a" "b"] weft/tx)])) "<u>ab</u>")
    (@ v)
    \  xs=row[v] f={\ v}weft/node
    ^  weft/item
    =  ns
         %  idx=nat 0  out=row[weft/node] []
         ?  (eq idx xs.len)
            out
         (_ idx.inc out.snoc((f xs.at(idx))))
    (./kids ns)
  +  eachi
    '  each with the element index.
    (@ v)
    \  xs=row[v] f={\ nat v}weft/node
    ^  weft/item
    =  ns
         %  idx=nat 0  out=row[weft/node] []
         ?  (eq idx xs.len)
            out
         (_ idx.inc out.snoc((f idx xs.at(idx))))
    (./kids ns)
  +  wget
    '  w-get: this element is a fragment mount fetching the URL.
    '  The w-ctors are the typed spellings of the /w.js attribute
    '  contract (see weft/runtime) — a typo here is a compile error,
    '  not a silently inert page.
    \  url=nat
    ^  weft/item
    (./at (weft/att "w-get" url))
  +  wevery
    '  w-trigger="every Ns": re-fetch the mount on an interval.
    \  secs=nat
    ^  weft/item
    (./at (weft/att "w-trigger" (weft/cat ["every " (weft/show_nat secs) "s"])))
  +  wouter
    '  w-swap="outer": fetched markup replaces the element itself.
    ^  weft/item
    (./at (weft/att "w-swap" "outer"))
  +  wpost
    '  w-post on a form: intercept submit, POST the fields, then
    '  refresh the fragment mounts named by these element ids.
    \  refresh=row[nat]
    ^  weft/item
    (./ats [(weft/att "w-post" "1") (weft/att "w-refresh" (weft/join " " refresh))])
  +  wscrub
    '  w-scrub on a range input: the omni-scrubber.
    ^  weft/item
    (./at (weft/att "w-scrub" "1"))
  +  render_tree
    '  A node tree as a CordTree: O(1) per piece, welded exactly once
    '  by the str_run in render.  Attribute values are quoted with
    '  byte 34 (cord literals cannot hold a double quote).
    \  nd0=weft/node
    ^  any
    %  nd=weft/node nd0
    ^  any
    =  me (_)
    ?  nd
     > (./tx s=nat)  (weft/esc_tree s)
     > (./raw s=nat)  (str_text s)
     > (./el tag=nat as=row[weft/att] kids=row[weft/node])
       =  astr
            %  i=nat 0  acc=any (str_text 0)
            ^  any
            ?  (eq i as.len)
               acc
            =  a as.at(i)
            (_ i.inc (weft/tcat [acc (str_text " ") (str_text a.k) (str_text "=") (str_text 34) (weft/esc_tree a.v) (str_text 34)]))
       =  kstr
            %  j=nat 0  acc2=any (str_text 0)
            ^  any
            ?  (eq j kids.len)
               acc2
            (_ j.inc (str_cat acc2 (me kids.at(j))))
       (weft/tcat [(str_text "<") (str_text tag) astr (str_text ">") kstr (str_text "</") (str_text tag) (str_text ">")])
  +  render
    '  A node tree as an HTML cord — one native flatten of the
    '  CordTree built by render_tree.
    '  ?=  ((weft/render (weft/leaf "b" [] "hi")) "<b>hi</b>")
    '  ?=  ((weft/render (weft/tx "a<b")) "a&lt;b")
    \  nd0=weft/node
    ^  nat
    (str_run (weft/render_tree nd0))
  +  render_many
    '  Render a builder fragment with one CordTree flatten, including empty rows.
    \ nodes=row[weft/node]
    ^ nat
    | str_run | weft/tcat nodes.map(weft/render_tree)
  +  runtime
    '  The shared client runtime served at /w.js — the whole
    '  interactivity story for faces, as attributes:
    '  .
    '  w-get="/frag/..."      the element is a fragment mount; fetch
    '                         the URL and swap the markup in
    '  w-trigger="every Ns"   re-fetch on an interval (fetch-on-load
    '                         always happens)
    '  w-swap="inner|outer"   how the swap lands (default inner)
    '  w-post (on a form)     intercept submit, POST the fields,
    '                         then refresh the fragments named in
    '                         w-refresh and clear the text inputs
    '  w-refresh="id id.."    fragment element ids a w-post refreshes
    '  w-scrub (on a range)   the omni-scrubber: pin every fragment
    '                         on the page to the slider's sovereign
    '                         epoch (max = now = unpinned).  While
    '                         pinned, polls idle — history is
    '                         constant — and every fetch rides /h's
    '                         epoch spelling on its data path.  The
    '                         pin mirrors into location.hash as
    '                         #e<epoch>, so any moment of a page is
    '                         a shareable, bookmarkable URL
    '  w-edit="rel slot"      the text run is editable in place:
    '                         click, retype, blur (enter commits,
    '                         escape cancels) — the runtime pokes
    '                         the slot at the enclosing mount's data
    '                         path plus rel through /edit, and the
    '                         namespace re-renders whatever the
    '                         write means.  Inert while scrubbed and
    '                         outside mounts
    '  w-op="up rel" (form)   an op form inside a mount: at submit
    '                         the runtime aims the form at the
    '                         enclosing mount's data path — action
    '                         becomes /op/<dp> and the hidden `op`
    '                         input becomes dp minus `up` segments
    '                         plus rel (the op card's path).  The
    '                         submit itself is a PLAIN post: the
    '                         kernel's verdict bounces the browser
    '                         like any /post form
    '  .
    '  Swaps are skipped when the fetched text is byte-identical to
    '  the last applied text (client-side staleness compare — the
    '  poll is cheap, the DOM stays quiet, form state survives).
    '  Mounts that ARRIVE inside a swapped fragment are armed after
    '  the swap (w-armed marks the done ones), so components nest.
    '  Cord literals cannot hold a double-quote byte, so the script
    '  is single-quote-only.
    ^  nat
    =  jopen  "(function(){var pin=null;"
       jpin   "function pinurl(u){if(pin===null){return u}var p=u.split('/');if(p[1]!=='frag'){return u}var olen=parseInt(p[3]);var di=4+olen;var dlen=parseInt(p[di]);return p.slice(0,di).concat([String(dlen+4),'h','z','e'+pin,String(dlen)]).concat(p.slice(di+1,di+1+dlen)).join('/')}"
       jswap  "function swap(el,t){if(el.getAttribute('data-w-last')===t){return}el.setAttribute('data-w-last',t);if(el.getAttribute('w-swap')==='outer'){el.outerHTML=t}else{el.innerHTML=t;rearm(el)}}"
       jload  "function load(el){var p0=pin;fetch(pinurl(el.getAttribute('w-get'))).then(function(r){return r.ok?r.text():null}).then(function(t){if(t!==null&&t!==undefined&&p0===pin){swap(el,t)}})}"
       jarm   "function arm(el){el.setAttribute('w-armed','1');load(el);var tr=el.getAttribute('w-trigger')||'';if(tr.indexOf('every ')===0){var n=parseFloat(tr.slice(6));if(n>0){setInterval(function(){if(pin===null&&document.contains(el)){load(el)}},n*1000)}}}"
       jrearm "function rearm(root){var els=root.querySelectorAll('[w-get]:not([w-armed])');var i;for(i=0;i<els.length;i++){arm(els[i])}}"
       jrel   "function reload(){var els=document.querySelectorAll('[w-get]');var i;for(i=0;i<els.length;i++){load(els[i])}}"
       jscr   "function bindscrub(s){var lab=s.parentNode?s.parentNode.querySelector('.wscrub-lab'):null;if(pin!==null){s.value=String(pin);if(lab){lab.textContent='epoch '+pin}}s.addEventListener('input',function(){var v=parseInt(s.value);var mx=parseInt(s.getAttribute('max'));if(v>=mx){pin=null;if(lab){lab.textContent='now'}location.hash=''}else{pin=v;if(lab){lab.textContent='epoch '+v}location.hash='e'+v}reload()})}"
       jwire  "function wire(f){f.addEventListener('submit',function(e){e.preventDefault();fetch(f.getAttribute('action'),{method:'POST',body:new URLSearchParams(new FormData(f))}).then(function(){var ids=(f.getAttribute('w-refresh')||'').split(' ');var i;for(i=0;i<ids.length;i++){var el=document.getElementById(ids[i]);if(el&&el.getAttribute('w-get')){load(el)}}});var ins=f.querySelectorAll('input[type=text],textarea');var j;for(j=0;j<ins.length;j++){ins[j].value=''}})}"
       jedt   "function edtarget(t){var m=t.closest('[w-get]');if(!m){return null}var p=m.getAttribute('w-get').split('/');var olen=parseInt(p[3]);var di=4+olen;var dlen=parseInt(p[di]);var dp=p.slice(di+1,di+1+dlen);var spec=(t.getAttribute('w-edit')||'').split(' ');if(spec.length<2){return null}var rel=spec[0]==='.'?[]:spec[0].split('/');return{path:dp.concat(rel).join('/'),slot:spec[1]}}"
       jeds   "function edsend(t){var tg=edtarget(t);if(!tg){return}var b=new URLSearchParams();b.append(tg.slot,t.textContent);fetch('/edit/'+tg.path,{method:'POST',body:b}).then(function(){var m=t.closest('[w-get]');if(m){load(m)}})}"
       jedc   "function ededit(e){if(pin!==null){return}var t=e.target.closest?e.target.closest('[w-edit]'):null;if(!t||t.isContentEditable){return}t.setAttribute('data-w-orig',t.textContent);t.contentEditable='true';t.focus()}"
       jedb   "function edblur(e){var t=e.target;if(!t.getAttribute||!t.getAttribute('w-edit')||t.contentEditable!=='true'){return}t.contentEditable='false';if(t.textContent!==t.getAttribute('data-w-orig')){edsend(t)}}"
       jedk   "function edkey(e){var t=e.target;if(!t.getAttribute||!t.getAttribute('w-edit')){return}if(e.key==='Enter'||e.keyCode===13){e.preventDefault();t.blur()}if(e.key==='Escape'||e.keyCode===27){t.textContent=t.getAttribute('data-w-orig');t.blur()}}"
       jwop   "function wopfix(e){var f=e.target;if(!f.getAttribute||!f.getAttribute('w-op')){return}var m=f.closest('[w-get]');if(!m){return}var p=m.getAttribute('w-get').split('/');var olen=parseInt(p[3]);var di=4+olen;var dlen=parseInt(p[di]);var dp=p.slice(di+1,di+1+dlen);var spec=f.getAttribute('w-op').split(' ');if(spec.length<2){return}var up=parseInt(spec[0]);var op=dp.slice(0,dp.length-up).concat(spec[1].split('/'));f.setAttribute('action','/op/'+dp.join('/'));var i=f.querySelector('input[name=op]');if(i){i.value='/'+op.join('/')}var b=f.querySelector('input[name=back]');if(b&&!b.value){b.value='/'+dp.join('/')}}"
       jboot  "function boot(){var h=location.hash;if(h.indexOf('#e')===0){var hv=parseInt(h.slice(2));if(hv>0){pin=hv}}var sc=document.querySelectorAll('input[w-scrub]');var m;for(m=0;m<sc.length;m++){bindscrub(sc[m])}rearm(document);var fs=document.querySelectorAll('form[w-post]');var j;for(j=0;j<fs.length;j++){wire(fs[j])}document.addEventListener('click',ededit);document.addEventListener('focusout',edblur);document.addEventListener('keydown',edkey);document.addEventListener('submit',wopfix,true)}"
       jgo    "if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot)}else{boot()}})();"
    (weft/cat [jopen jpin jswap jload jarm jrearm jrel jscr jwire jedt jeds jedc jedb jedk jwop jboot jgo])
  + page
    ' A document with caller-supplied inline CSS and no application assets.
    \ title=nat css=nat body=row[weft/node]
    ^ nat
    | weft/page_with_assets title [(weft/el "style" [] [(weft/raw css)])] body

  + page_with_assets
    ' Shared document framing. The caller declares its assets; no implicit CSS.
    \ title=nat assets=row[weft/node] body=row[weft/node]
    ^ nat
    | weft/page_with_body_attributes title assets [] body

  + page_with_body_attributes
    \ title=nat assets=row[weft/node] attributes=row[weft/att] body=row[weft/node]
    ^ nat
    = document
        ~ weft/build
        ~# 'html
          'lang "en"
          ~| 'head
            ~# 'meta
              'charset "utf-8"
            ~# 'meta
              'name "viewport"
              'content "width=device-width, initial-scale=1"
            ~. 'title title
            assets
          [(weft/el "body" attributes body)]
    | str_run
    | str_cat (str_text "<!doctype html>")
    | weft/tcat document.map(weft/render_tree)

' --- view protocol ---

+  is_cx
  '  Is this path under the context lens (/c/x)?  /c/x/...path reads
  '  the context a cell's ctor produced beside its /x tree.
  \ p=path
  ^ bool
  ? (lt p.len 2) .false
  (and (eq_iota p.at(0) 'c) (eq_iota p.at(1) 'x))

+  is_r
  '  Is this path under the reverse lens (/r)?  /r/<len>/<target...>
  '  reads the references that name the target.  Read-only and
  '  derived, like /h and /o.
  \ p=path
  ^ bool
  p.starts('r)

+  sorge
  '  Restrict a tree to a care: node only, node + direct kids, or all.
  (@ v)
  \  c=care fat=axal[v]
  ^  axal[v]
  ?  c
   > .x  (axal/new[v] fat.fil)
   > .y  (axal/snip[v] fat)
   > .z  fat

+ saga
  + value
    \ record=saga
    ^ myth
    | unpin record.myth

  + values
    \ tree=axal[saga]
    ^ axal[myth]
    | tree.run saga/value

  + computed
    ' Computed reads have a data case, but no stored shape/time ledger.
    ' Zero shape/time fields and an unsigned oath make no such claim.
    \ version=nat tree=axal[myth]
    ^ axal[saga]
    = clock (lock version 0)
      header (aeon (yuga clock clock clock 0 0) (oath 0 0))
    | tree.run (\ record (saga header (pin record)))

+ bowl
  + crew_value
    ' Unwrap one dependency only when a handler needs plain data.
    \ slot=path context=bowl
    ^ axal[myth]
    > (./some read) context.crew.get(slot)
      | axal/new[myth] .none
    | saga/values read

  + crew_values
    ' Explicit projection for handlers that inspect every dependency.
    \ context=bowl
    ^ mop[path axal[myth] lt_pith]
    | context.crew.tap.fold (mop/empty)
      \ out entry
      | out.put entry.key (saga/values entry.val)

+  view_project
  '  A view's answer cut to the selection: everything, or the part the selection names.
  \ select=view_select value=res[axal[myth]]
  ^ res[axal[myth]]
  ? select
   > .all value
  | value.run
    \ tree=axal[myth]
    | tree.run
      \ record=myth
      ^ myth
      ? select
       > (./slots keys)
         | keys.fold myth/new
           \ out key
           > (./some held) record.get(key) out
           | out.put key held
      myth/new

' --- reference_index ---

' Derived store metadata. Edges retain the complete safe, including care and
' version; the target trie is only a lookup key and never replaces that identity.
+ r_spell
  '  If A holds a safe to B, read the reverse path for B to find A and
  '  its slot. The stored edge still names B's original care and case;
  '  querying by target does not make the reference live.
  ' The /r path that reads the references naming a target: /r/<len>/<path>,
  ' length-prefixed like /h, so a target is never found by searching.
  \ target=path
  ^ path
  = head=path ['r ($u target.len)]
  | head.weld(target)


+ reference_index
  ' The current edges by target, and the last `span` snapshots of them, one per epoch that changed an edge.

  + span
    ' Snapshots kept; an epoch older than the oldest kept reads unknown.
    ^ nat
    64

  + new
    ' An empty index: no edges, no snapshots.
    ^ reference_index
    | reference_index (axal/new[row[reference_edge]] .none) (uon/empty)

  + slots
    ' Every reference a record holds: a slot whose value is a reference, and a
    ' reference inside prose, a path in brackets ([/0x11/user/orgs/verisk]),
    ' held by the slot the prose sits in.  One mechanism for sources,
    ' provenance and connection; nothing else is indexed, nothing else is named.
    \ record=maybe[myth]
    ^ row[[slot=path target=safe]]
    > (./some record) record []
    | record.tap.fold []
      \ out [slot held]
      ? held
       > target=safe out.snoc([slot target])
       > text=pails/t (reference_index/hold slot (reference_index/prose text.t) out)
      out

  + hold
    ' Every reference found in one prose slot, as [slot target] pairs.
    \ slot=path targets=row[safe] out=row[[slot=path target=safe]]
    ^ row[[slot=path target=safe]]
    % i=nat 0 out=row[[slot=path target=safe]] out
    ^ row[[slot=path target=safe]]
    ? (eq i targets.len) out
    | _ i.inc out.snoc([slot targets.at(i)])

  + prose
    ' The references inside a text: each [/path] that parses, in order.
    \ text=str
    ^ row[safe]
    = pieces=row[str] (str/split_byte 91 text)
    % i=nat 1 out=row[safe] []
    ^ row[safe]
    ? (ge i pieces.len) out
    = inner=row[str] (str/split_byte 93 pieces.at(i))
    ? (lt inner.len 2) (_ i.inc out)
    = span inner.at(0)
    ? !(eq (str/slice 0 1 span) "/") (_ i.inc out)
    > (./some target) (path_parse span) (_ i.inc out)
    | _ i.inc out.snoc((safe 0 .x target))

  + remove
    ' Drop one holder's edge to a target; a target with no edges left leaves the index.
    \ holder=path slot=path target=safe into=axal[row[reference_edge]]
    ^ axal[row[reference_edge]]
    > (./some edges) into.get(target.path) into
    = remaining
        | edges.filter
          \ edge
          | !(and (equal[path] edge.holder holder) (equal[path] edge.slot slot))
    ? (eq remaining.len 0) into.del(target.path)
    | into.put target.path remaining

  + value_references
    \ held=pail
    ^ row[safe]
    ? held
     > target=safe [target]
     > text=pails/t (reference_index/prose text.t)
    []

  + same_references
    ' Persistent posting maps usually change one non-reference slot. Skip
    ' shared subtrees and inspect only that search path. A rotation falls
    ' back to the original ordered-slot comparison for its affected subtree.
    ' This is only an equality shortcut; changed references retain the full
    ' existing replacement and signaling behavior below.
    \ before=mop[path pail lt_pith] after=mop[path pail lt_pith]
    ^ bool
    ? (equal before after) .true
    = full
        | equal (reference_index/slots (maybe/some[myth] before))
                (reference_index/slots (maybe/some[myth] after))
    > old=mop/node[path pail lt_pith] before full
    > fresh=mop/node[path pail lt_pith] after full
    ? !(equal old.key fresh.key) full
    ? !(equal (reference_index/value_references old.val) (reference_index/value_references fresh.val)) .false
    | and (reference_index/same_references old.l fresh.l)
          (reference_index/same_references old.r fresh.r)

  + replace
    ' Called only for records whose own assertion changed, after admission.
    ' Literal-only changes preserve the index value and its historical clock.
    \ holder=path before=maybe[myth] after=maybe[myth] into=axal[row[reference_edge]]
    ^ axal[row[reference_edge]]
    ? (reference_index/same_references (before.fall(myth/new)) (after.fall(myth/new))) into
    = old (reference_index/slots before)
      fresh (reference_index/slots after)
    ? (equal old fresh) into
    = removed
        | old.fold into
          \ out [slot target]
          | reference_index/remove holder slot target out
    | fresh.fold removed
      \ out [slot target]
      = edges (out.get(target.path)).fall([])
      | out.put target.path edges.snoc((reference_edge holder slot target))

  + commit
    ' Keep this epoch's edges as a snapshot when they changed, and drop the oldest past span.
    \ epoch=nat into=axal[row[reference_edge]] index=reference_index
    ^ reference_index
    ? (equal into index.into) index
    = past index.past.put(($u epoch) (pin into))
      entries past.tap
    ? (le entries.len reference_index/span) (reference_index into past)
    = [dropped kept] past.del(entries.at(0).key)
    | reference_index into kept

  + at
    ' The edges as of an epoch: the current ones at 0 or the top, the snapshot at or before the epoch otherwise, unknown past the span.
    \ epoch=nat index=reference_index
    ^ axal[row[reference_edge]]
    ? (eq epoch 0) index.into
    > (./some entry) index.past.floor(($u epoch))
      (axal/new[row[reference_edge]] .none)
    = [version held] entry
    | unpin held

  + beneath
    ' Every edge whose target is at or beneath a name, as of an epoch.
    \ target=path epoch=nat index=reference_index
    ^ row[reference_edge]
    | (index.at(epoch)).dip(target).tap.fold []
      \ out [relative edges]
      | out.weld edges

  + signals
    ' Reverse dependencies change only when reference slots change. Notify
    ' each indexed target prefix, including insertion of its first edge.
    \ before=maybe[myth] after=maybe[myth] signs=axal[sign]
    ^ axal[sign]
    ? (reference_index/same_references (before.fall(myth/new)) (after.fall(myth/new))) signs
    = old (reference_index/slots before)
      fresh (reference_index/slots after)
    ? (equal old fresh) signs
    = edges=row[[slot=path target=safe]] old.weld(fresh)
    | edges.fold signs
      \ out=axal[sign] edge=[slot=path target=safe]
      ^ axal[sign]
      = [slot target] edge
      % width=nat target.path.len result=axal[sign] out
      ^ axal[sign]
      ? (eq width 0) result
      | _ width.dec result.put((r_spell target.path.take(width)) (sign 1 2 2))

' --- weft_std ---

' Standard cells.  A cell is a record whose /sys/weft is an x-care
' safe to one of these ctor records and whose /sys/tack is a y-care
' safe to its input (version 0: live, the cell follows the input).
' Each ctor is a cell: it reads its parameters from the context
' (the cell's own slots, secondary inputs at /views/<slot>), takes
' the input tree from the tack, and returns the context and the
' derived tree.  A missing or malformed parameter passes the input
' tree through and names the parameter at /sys/view/missing in context'.
'
' Numbers.  A number slot holds a natural.  A record may carry /scale
' (a natural): every number slot in that record is an integer scaled
' by ten to that power, so 1250 with /scale 2 is 12.50; <slot>/scale
' sets the scale of one slot (amount/scale 2 leaves /when whole).
' Formulas read
' a number with its record's scale, align scales to the larger one,
' and write /scale on their output root.  A literal parameter may
' carry a point: "12.5" is 125 at scale 1.  Dates and durations are
' numbers too (pails/dm, pails/ds, pails/dr), compared in their own
' unit.  Nothing here calls, loops or branches on anything but data.
+ weft_std
  ' ---- answers
  + missing
    ' A parameter the ctor asked for and did not get: say so in the
    ' context' and pass the input tree through unchanged.
    \ context=myth tree=axal[myth] what=str
    ^ [myth axal[myth]]
    | [context.put(['sys 'view 'missing] (pails/t what)) tree]
  + root
    \ context=myth slot=path value=pail
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing slot value)))]
  + figure
    ' A root record holding one scaled number, signed.
    \ context=myth slot=path n=nat s=nat neg=bool
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing slot (weft_std/num_pail n neg)).put(['scale] (pails/n s))))]
  + done
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | [context tree]
  ' ---- parameters
  + text
    ' A text parameter of the cell.
    \ record=myth key=path
    ^ maybe[str]
    > (./some held) record.get(key) .none
    ? held
     > t=pails/t (./some t.t)
     > n=pails/n (./some (nat/show n.n))
    .none
  + text_or
    \ record=myth key=path default=str
    ^ str
    | (weft_std/text record key).fall(default)
  + slot
    ' A slot-path parameter of the cell, with a default when absent.
    \ record=myth key=path default=path
    ^ maybe[path]
    > (./some t) (weft_std/text record key) (./some default)
    | path_parse t
  + slots
    ' A space-separated list of slot paths.
    \ record=myth key=path
    ^ row[path]
    > (./some t) (weft_std/text record key) []
    | t.split_byte(32).fold []
      \ acc part
      > (./some pax) (path_parse part) acc
      acc.snoc(pax)
  + count_param
    \ record=myth key=path default=nat
    ^ nat
    > (./some t) (weft_std/text record key) default
    | (nat/parse t).fall(default)
  + view
    ' A secondary input by its slot name.
    \ record=myth name=iota
    ^ maybe[axal[myth]]
    > (./some held) record.get(['views name]) .none
    > v=cell_view held .none
    | ./some (unpin v.tree)
  ' ---- numbers
  + pow10
    \ k=nat
    ^ nat
    % i=nat 0 acc=nat 1
    ? (eq i k) acc
    | _ i.inc (mul acc 10)
  + scale_of
    ' The scale of a number slot: <slot>/scale when the record carries
    ' one for that slot, else the record's /scale, else 0.
    \ record=myth pax=path
    ^ nat
    = own=maybe[nat]
        > (./some held) record.get(pax.snoc('scale)) .none
        ? held
         > n=pails/n (./some n.n)
        .none
    ? own
     > (./some s) s
    > (./some held) record.get(['scale]) 0
    ? held
     > n=pails/n n.n
    0
  + nat_of
    ' The natural a pail holds: numbers, dates, durations.  A boolean
    ' is not a number (any and all read booleans through truthy).
    \ held=pail
    ^ maybe[nat]
    ? held
     > n=pails/n (./some n.n)
     > d=pails/dm (./some d.n)
     > d=pails/ds (./some d.n)
     > d=pails/dr (./some d.n)
    .none
  + sign_of
    ' A pail's number as magnitude and sign: a natural, a date or a
    ' duration is positive; z carries its sign.
    \ held=pail
    ^ maybe[[nat bool]]
    ? held
     > n=pails/n (./some [n.n .false])
     > z=pails/z (./some [z.n z.neg])
     > d=pails/dm (./some [d.n .false])
     > d=pails/ds (./some [d.n .false])
     > d=pails/dr (./some [d.n .false])
    .none
  + num_pail
    ' A magnitude with its sign as a pail: a natural, or z when negative.
    \ n=nat neg=bool
    ^ pail
    ? (and neg (gt n 0)) (pails/z .true n)
    | pails/n n
  + xor_sign
    ' The sign of a product or quotient: negative when exactly one side is, never for zero.
    \ a=bool b=bool n=nat
    ^ bool
    ? (eq n 0) .false
    ? a (? b .false .true)
    b
  + signed_add
    ' a + b on magnitudes with signs, at one scale.
    \ an=nat aneg=bool bn=nat bneg=bool
    ^ [nat bool]
    = same (? aneg bneg (? bneg .false .true))
    ? same [(add an bn) (and aneg (gt (add an bn) 0))]
    ? (lt an bn) [(sub bn an) bneg]
    ? (eq an bn) [0 .false]
    | [(sub an bn) aneg]
  + less
    ' Signed: is a below b?
    \ an=nat aneg=bool bn=nat bneg=bool
    ^ bool
    ? aneg (? bneg (gt an bn) .true)
    ? bneg .false
    | lt an bn
  + slot_figure
    ' A number slot of a record, with the record's scale and its sign.
    \ record=myth pax=path
    ^ maybe[[nat nat bool]]
    > (./some held) record.get(pax) .none
    > (./some sn) (weft_std/sign_of held) .none
    = [n neg] sn
    | ./some [n (weft_std/scale_of record pax) neg]
  + figure_at
    ' A number slot of a row through the name convention (a numeric
    ' child name counts), with its scale.
    \ rec=myth p=path slot=path
    ^ maybe[[nat nat bool]]
    > (./some held) (weft_std/at rec p slot) .none
    > (./some sn) (weft_std/sign_of held) .none
    = [n neg] sn
    ? !(rec.has(slot)) (./some [n 0 neg])
    | ./some [n (weft_std/scale_of rec slot) neg]
  + literal
    ' "125" is 125 at scale 0; "12.5" is 125 at scale 1; "-3" is 3, negative.
    \ t=str
    ^ maybe[[nat nat bool]]
    = neg (and (gt t.len 0) (eq t.at(0) 45))
      body (? neg t.slice(1 t.len) t)
      parts body.split_byte(46)
    ? (eq parts.len 1)
      > (./some n) (nat/parse body) .none
      | ./some [n 0 (and neg (gt n 0))]
    ? !(eq parts.len 2) .none
    = whole parts.at(0)
      frac parts.at(1)
    > (./some w) (nat/parse (? (eq whole.len 0) "0" whole)) .none
    > (./some f) (nat/parse frac) .none
    = n (add (mul w (weft_std/pow10 frac.len)) f)
    | ./some [n frac.len (and neg (gt n 0))]
  + figure_in
    ' A numeric parameter resolved against a record: a literal, a slot
    ' of that record, or /views/<slot>/<path> of a secondary input.
    \ context=myth key=path record=myth
    ^ maybe[[nat nat bool]]
    > (./some t) (weft_std/text context key) .none
    ? (weft_std/literal t)
     > (./some fig) (./some fig)
     > .none
      > (./some pax) (path_parse t) .none
      ? (and (gt pax.len 2) (eq_iota pax.at(0) 'views))
        > (./some other) (weft_std/view context pax.at(1)) .none
        > (./some orec) other.fil .none
        | weft_std/slot_figure orec pax.drop(2)
      | weft_std/slot_figure record pax
  + figure_of
    ' A numeric parameter against the input root.
    \ context=myth key=path tree=axal[myth]
    ^ maybe[[nat nat bool]]
    | weft_std/figure_in context key tree.fil.fall(myth/new)
  + rescale
    ' Move a number from one scale to another, rounding half up.
    \ n=nat from=nat to=nat
    ^ nat
    ? (eq from to) n
    ? (lt from to) (mul n (weft_std/pow10 (sub to from)))
    = d (weft_std/pow10 (sub from to))
    | div (add n (div d 2)) d
  + align
    ' Two figures at the larger of their scales, with their signs.
    \ a=[nat nat bool] b=[nat nat bool]
    ^ [nat nat nat bool bool]
    = [an as aneg] a
      [bn bs bneg] b
      s (? (lt as bs) bs as)
    | [(weft_std/rescale an as s) (weft_std/rescale bn bs s) s aneg bneg]
  + show_figure
    \ n=nat s=nat
    ^ str
    ? (eq s 0) (nat/show n)
    = d (weft_std/pow10 s)
      frac (nat/show (mod n d))
      pad
        % i=nat frac.len acc=str ""
        ? (eq i s) acc
        | _ i.inc acc.cat("0")
    | str/cat_all [(nat/show (div n d)) "." pad frac]
  + key_of
    ' A child key made from data: a symbol when the text is one path
    ' segment, else a text atom (a key that cannot print as a symbol
    ' breaks the supervisor's tracing).
    \ text=str
    ^ iota
    ? (eq text.len 0) ($ta "empty")
    > (./some p) (path_parse (str/cat_all ["/" text])) ($ta text)
    ? (eq p.len 1) p.at(0)
    ($ta text)
  + show_pail
    ' The text a pail compares and groups by.
    \ held=pail
    ^ str
    ? held
     > t=pails/t t.t
     > n=pails/n (nat/show n.n)
     > z=pails/z (str/cat_all ["-" (nat/show z.n)])
     > b=pails/b (? b.b "true" "false")
     > q=pails/q (iota_show q.q)
     > p=pails/p (path_show p.p)
     > d=pails/dm (nat/show d.n)
     > d=pails/ds (nat/show d.n)
     > d=pails/dr (nat/show d.n)
    ""
  ' ---- rows
  + rows
    ' Every record below the root, at any depth, with its path: the
    ' direct children of a y input, the whole subtree of a z input.
    \ tree=axal[myth]
    ^ row[[path myth]]
    = none=row[[path myth]] []
    | tree.tap.fold none
      \ acc [p q]
      ? (eq p.len 0) acc
      acc.snoc([p q])
  + key_pail
    ' A row's key as a value: the name for a direct child (a number
    ' when the name is numeric), the path as text below.
    \ p=path
    ^ pail
    ? !(eq p.len 1) (pails/t (path_show p))
    > (./some n) (nat/parse (iota_show p.at(0))) (pails/q p.at(0))
    | pails/n n
  + dotted
    ' A path as one key segment: its names joined by underscores (the
    ' only joiner a segment admits).
    \ p=path
    ^ iota
    = none=row[str] []
      parts
        % i=nat 0 acc=row[str] none
        ^ row[str]
        ? (eq i p.len) acc
        | _ i.inc acc.snoc((iota_show p.at(i)))
    | weft_std/key_of (str/join "_" parts)
  + at
    ' A slot of a row.  The slot called name is the row's own key (its
    ' last path segment; a numeric key counts as a number) when the
    ' record carries no name slot, so a child's name is addressable in
    ' any setting.
    \ rec=myth p=path slot=path
    ^ maybe[pail]
    = named (and (eq slot.len 1) (and (eq_iota slot.at(0) 'name) (gt p.len 0)))
      none=maybe[pail] .none
      own=maybe[pail]
        ? !named none
        = last p.at(p.len.dec)
        > (./some n) (nat/parse (iota_show last)) (./some (pails/q last))
        | ./some (pails/n n)
    > (./some held) rec.get(slot) own
    | ./some held
  + same_path
    \ a=path b=path
    ^ bool
    | (and (eq a.len b.len) (pith_prefix a b))
  + child_record
    \ child=axal[myth]
    ^ myth
    | child.fil.fall(myth/new)
  + keyed
    ' Rows ranked by a slot: [number path record], at the rows' larger
    ' scale, skipping rows without the slot.
    \ tree=axal[myth] slot=path
    ^ [row[[nat bool path myth]] nat]
    = rows (weft_std/rows tree)
      s
        | rows.fold 0
          \ acc [p rec]
          = cs (weft_std/scale_of rec slot)
          | ? (lt acc cs) cs acc
      none=row[[nat bool path myth]] []
      items
        | rows.fold none
          \ acc [p rec]
          > (./some fig) (weft_std/figure_at rec p slot) acc
          = [n cs neg] fig
          | acc.snoc([(weft_std/rescale n cs s) neg p rec])
    | [items s]
  + ranked
    ' Insertion sort of ranked rows, ascending or descending by number.
    \ items=row[[nat bool path myth]] desc=bool
    ^ row[[nat bool path myth]]
    = none=row[[nat bool path myth]] []
    | items.fold none
      \ out item
      = [n ng key child] item
      % i=nat 0
      ^ row[[nat bool path myth]]
      ? (eq i out.len) out.snoc(item)
      = [m mg k2 c2] out.at(i)
      ? (? desc (weft_std/less m mg n ng) (weft_std/less n ng m mg)) out.take(i).snoc(item).weld(out.drop(i))
      | _ i.inc
  + numbered
    ' Rows re-keyed by rank, each keeping its original key at /key.
    \ root=maybe[myth] items=row[[nat bool path myth]]
    ^ axal[myth]
    % i=nat 0 out=axal[myth] (axal/new[myth] root)
    ^ axal[myth]
    ? (eq i items.len) out
    = [n ng p rec] items.at(i)
    | _ i.inc out.put([($u i.inc)] rec.put(['key] (weft_std/key_pail p)))
  + truthy
    \ record=myth slot=path
    ^ bool
    > (./some held) record.get(slot) .false
    ? held
     > b=pails/b b.b
     > n=pails/n (gt n.n 0)
     > z=pails/z (gt z.n 0)
     > t=pails/t (gt t.t.len 0)
    .false
  + compare
    ' Two figures aligned to the larger scale, by signed value: 0 below, 1 equal, 2 above.
    \ a=[nat nat bool] b=[nat nat bool]
    ^ nat
    = [m lm s aneg bneg] (weft_std/align a b)
    ? (weft_std/less m aneg lm bneg) 0
    ? (weft_std/less lm bneg m aneg) 2
    1
  + matches
    ' One comparison of a row's slot against a literal, by operator:
    ' equals, over, under, before, after, contains.  Numbers compare
    ' by value at their scale (136 at scale 2 is 1.36); anything else
    ' compares as text.  The slot called name is the row's key.
    \ op=str rec=myth p=path slot=path value=str
    ^ bool
    > (./some held) (weft_std/at rec p slot) .false
    = shown (weft_std/show_pail held)
      both=maybe[[[nat nat bool] [nat nat bool]]]
        > (./some f) (weft_std/figure_at rec p slot) .none
        > (./some l) (weft_std/literal value) .none
        | ./some [f l]
    ? (equal op "contains") (maybe/is_some (str/find value shown))
    > (./some pair) both (and (equal op "equals") (equal shown value))
    = [f l] pair
      c (weft_std/compare f l)
    ? (equal op "equals") (eq c 1)
    ? ((equal op "over") || (equal op "after")) (eq c 2)
    ? ((equal op "under") || (equal op "before")) (eq c 0)
    .false
  + reduce
    ' count, sum, min, max or avg of a slot over ranked rows at scale s, signed.
    \ op=str items=row[[nat bool path myth]] s=nat
    ^ [nat nat bool]
    ? (equal op "count") [items.len 0 .false]
    = zero=[nat bool] [0 .false]
      [tn tneg]
        | items.fold zero
          \ acc [n ng p rec]
          = [an aneg] acc
          | weft_std/signed_add an aneg n ng
    ? (equal op "sum") [tn s tneg]
    ? (eq items.len 0) [0 s .false]
    = [n0 g0 p0 r0] items.at(0)
      first=[nat bool] [n0 g0]
      [mn mg]
        | items.fold first
          \ acc [n ng p rec]
          = [an aneg] acc
          ? (weft_std/less n ng an aneg) [n ng]
          acc
      [xn xg]
        | items.fold first
          \ acc [n ng p rec]
          = [an aneg] acc
          ? (weft_std/less an aneg n ng) [n ng]
          acc
    ? (equal op "min") [mn s mg]
    ? (equal op "max") [xn s xg]
    | [(div (add tn (div items.len 2)) items.len) s tneg]
  ' ---- reduce a tree to a figure
  + count
    ' The number of children of the input, at /count (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some into) (weft_std/slot record ['into] ['count]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/n (weft_std/rows tree).len)
  + fold_slot
    \ record=myth tree=axal[myth] op=str default=path
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot as a slot path")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    > (./some into) (weft_std/slot record ['into] default) (weft_std/missing record tree "Supply /into as a slot path")
    = [items s] (weft_std/keyed tree slot)
      [n rs ng] (weft_std/reduce op items s)
    | weft_std/figure record into n rs ng
  + sum
    ' The sum of /slot over the children, at /total (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "sum" ['total]
  + min
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "min" ['min]
  + max
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "max" ['max]
  + avg
    ' The mean of /slot over the children, rounded half up at the input's scale, at /avg.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "avg" ['avg]
  + any
    ' Whether any child has a true (or non-zero, non-empty) /slot, at /any.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    > (./some into) (weft_std/slot record ['into] ['any]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/b (weft_std/rows tree).any((\ [p rec] (weft_std/truthy rec slot))))
  + all
    ' Whether every child has a true /slot, at /all.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    > (./some into) (weft_std/slot record ['into] ['all]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/b (weft_std/rows tree).all((\ [p rec] (weft_std/truthy rec slot))))
  ' ---- keep or reshape rows
  + where
    ' The children whose /key slot matches /value under /op (equals, over, under, before, after, contains), under the input root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    > (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = op (weft_std/text_or record ['op] "equals")
      kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          ? (weft_std/matches op rec p key value) out.put(p rec)
          out
    | weft_std/done record kept
  + sort
    ' The children ranked by /slot (ascending, or /order desc), re-keyed 1, 2, 3 with the old key at /key.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = desc (equal (weft_std/text_or record ['order] "asc") "desc")
      [items s] (weft_std/keyed tree slot)
    | weft_std/done record (weft_std/numbered tree.fil (weft_std/ranked items desc))
  + top
    ' The /count (default 3) children with the largest /slot, ranked.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = n (weft_std/count_param record ['count] 3)
      [items s] (weft_std/keyed tree slot)
      sorted (weft_std/ranked items .true)
      kept (? (lt sorted.len n) sorted.len n)
    | weft_std/done record (weft_std/numbered tree.fil sorted.take(kept))
  + extreme
    \ record=myth tree=axal[myth] desc=bool
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = [items s] (weft_std/keyed tree slot)
      sorted (weft_std/ranked items desc)
    ? (eq sorted.len 0) (weft_std/done record (axal/new[myth] .none))
    = [n ng p rec] sorted.at(0)
    | weft_std/done record (axal/new[myth] (./some rec.put(['key] (weft_std/key_pail p))))
  + latest
    ' The child with the largest /slot (a date, usually), as the root, its key at /key.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/extreme record tree .true
  + earliest
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/extreme record tree .false
  + arith_op
    ' Signed arithmetic on two figures at their larger scale.
    \ op=str a=[nat nat bool] b=[nat nat bool]
    ^ either[str [nat nat bool]]
    = [an bn s aneg bneg] (weft_std/align a b)
    ? (equal op "add")
      = [n ng] (weft_std/signed_add an aneg bn bneg)
      | ./ok [n s ng]
    ? (equal op "subtract")
      = [n ng] (weft_std/signed_add an aneg bn (? bneg .false (gt bn 0)))
      | ./ok [n s ng]
    ? (equal op "multiply") (./ok [(weft_std/rescale (mul an bn) (mul s 2) s) s (weft_std/xor_sign aneg bneg (mul an bn))])
    ? (equal op "divide")
      ? (eq bn 0) (./err "Division by zero")
      | ./ok [(div (add (mul an (weft_std/pow10 s)) (div bn 2)) bn) s (weft_std/xor_sign aneg bneg an)]
    | ./err "Unknown /op: add, subtract, multiply or divide"
  + each
    ' A derived slot per child: /into = /left /op /right, where each side is a literal or a slot of the child.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some lt) (weft_std/text record ['left]) (weft_std/missing record tree "Supply /left")
    > (./some rt) (weft_std/text record ['right]) (weft_std/missing record tree "Supply /right")
    > (./some op) (weft_std/text record ['op]) (weft_std/missing record tree "Supply /op (add, subtract, multiply, divide)")
    > (./some intotext) (weft_std/text record ['into]) (weft_std/missing record tree "Supply /into")
    > (./some into) (path_parse intotext) (weft_std/missing record tree "Supply /into as a slot path")
    = out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          > (./some a) (weft_std/figure_in record ['left] rec) acc.put(p rec)
          > (./some b) (weft_std/figure_in record ['right] rec) acc.put(p rec)
          ? (weft_std/arith_op op a b)
           > (./ok fig)
            = [n s ng] fig
            | acc.put(p rec.put(into (weft_std/num_pail n ng)).put(['scale] (pails/n s)))
           > (./err _) acc.put(p rec)
    | weft_std/done record out
  + lookup
    ' For each child, bring /take from the row of /views/<from> whose /match equals the child's /key, into /into.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key")
    > (./some take) (weft_std/slot record ['take] []) (weft_std/missing record tree "Supply /take")
    ? ((eq key.len 0) || (eq take.len 0)) (weft_std/missing record tree "Supply /key and /take as slot paths")
    > (./some match) (weft_std/slot record ['match] key) (weft_std/missing record tree "Supply /match as a slot path")
    > (./some into) (weft_std/slot record ['into] take) (weft_std/missing record tree "Supply /into as a slot path")
    = from ($ts (weft_std/text_or record ['from] "table"))
    > (./some table) (weft_std/view record from) (weft_std/missing record tree "Supply a reference to the table as a slot named by /from")
    = rows (weft_std/rows table)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          > (./some held) (weft_std/at rec p key) acc.put(p rec)
          = wanted (weft_std/show_pail held)
            nothing=maybe[pail] .none
            found
              | rows.fold nothing
                \ hit [rp rrec]
                ? (maybe/is_some hit) hit
                > (./some mh) (weft_std/at rrec rp match) hit
                ? !(equal (weft_std/show_pail mh) wanted) hit
                | weft_std/at rrec rp take
          > (./some value) found acc.put(p rec)
          | acc.put(p rec.put(into value))
    | weft_std/done record out
  + distinct
    ' The values /slot takes over the children, as rows keyed 1, 2, 3 with /value and /count.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = none=row[[str pail nat]] []
      groups
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          > (./some held) (weft_std/at rec p slot) acc
          = shown (weft_std/show_pail held)
          % i=nat 0
          ^ row[[str pail nat]]
          ? (eq i acc.len) acc.snoc([shown held 1])
          = [s2 h2 c2] acc.at(i)
          ? (equal s2 shown) acc.take(i).snoc([s2 h2 c2.inc]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
    ^ [myth axal[myth]]
    ? (eq i groups.len) (weft_std/done record out)
    = [shown held c] groups.at(i)
    | _ i.inc out.put([($u i.inc)] (myth/sing ['value] held).put(['count] (pails/n c)))
  + select
    ' Keep only the slots named in /slots (space separated) on the root and each child.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = wanted (weft_std/slots record ['slots])
    ? (eq wanted.len 0) (weft_std/missing record tree "Supply /slots: slot paths separated by spaces")
    = trim
        \ p=path rec=myth
        ^ myth
        | wanted.fold myth/new
          \ acc pax
          > (./some held) (weft_std/at rec p pax) acc
          acc.put(pax held)
      none=path []
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil.run((\ r=myth (trim none r))))
          \ acc [p rec]
          | acc.put(p (trim p rec))
    | weft_std/done record out
  ' ---- change the shape
  + by
    ' Group the rows by /key (a slot, or the word depth for the row's depth), then /op (count, sum, min, max, avg) their /slot: rows keyed by group value with /value and /into.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some keytext) (weft_std/text record ['key]) (weft_std/missing record tree "Supply /key")
    = by_depth (equal keytext "depth")
      parsed=maybe[path] (? by_depth (./some []) (path_parse keytext))
    > (./some key) parsed (weft_std/missing record tree "Supply /key as a slot path or the word depth")
    = op (weft_std/text_or record ['op] "count")
      slot (weft_std/slot record ['slot] key).fall(key)
    > (./some into) (weft_std/slot record ['into] [($ts op)]) (weft_std/missing record tree "Supply /into as a slot path")
    = none=row[[str pail axal[myth]]] []
      groups
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          = held=maybe[pail] (? by_depth (./some (pails/n p.len)) (weft_std/at rec p key))
          > (./some h) held acc
          = shown (weft_std/show_pail h)
          % i=nat 0
          ^ row[[str pail axal[myth]]]
          ? (eq i acc.len) acc.snoc([shown h (axal/new[myth] .none).put(p rec)])
          = [s2 h2 sub] acc.at(i)
          ? (equal s2 shown) acc.take(i).snoc([s2 h2 sub.put(p rec)]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
    ^ [myth axal[myth]]
    ? (eq i groups.len) (weft_std/done record out)
    = [shown held sub] groups.at(i)
      [items s] (weft_std/keyed sub slot)
      [n rs ng] (? (equal op "count") [(weft_std/rows sub).len 0 .false] (weft_std/reduce op items s))
    | _ i.inc out.put([(weft_std/key_of shown)] (myth/sing ['value] held).put(into (weft_std/num_pail n ng)).put(['scale] (pails/n rs)))
  + grid
    ' Rows keyed by /row value, one slot per /col value, holding /op of /slot.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some rowk) (weft_std/slot record ['row] []) (weft_std/missing record tree "Supply /row")
    > (./some colk) (weft_std/slot record ['col] []) (weft_std/missing record tree "Supply /col")
    ? ((eq rowk.len 0) || (eq colk.len 0)) (weft_std/missing record tree "Supply /row and /col as slot paths")
    = op (weft_std/text_or record ['op] "count")
      slot (weft_std/slot record ['slot] rowk).fall(rowk)
      none=row[[str str axal[myth]]] []
      cells
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          > (./some rh) (weft_std/at rec p rowk) acc
          > (./some ch) (weft_std/at rec p colk) acc
          = r (weft_std/show_pail rh)
            c (weft_std/show_pail ch)
          % i=nat 0
          ^ row[[str str axal[myth]]]
          ? (eq i acc.len) acc.snoc([r c (axal/new[myth] .none).put(p rec)])
          = [r2 c2 sub] acc.at(i)
          ? (and (equal r2 r) (equal c2 c)) acc.take(i).snoc([r2 c2 sub.put(p rec)]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
    ^ [myth axal[myth]]
    ? (eq i cells.len) (weft_std/done record out)
    = [r c sub] cells.at(i)
      [items s] (weft_std/keyed sub slot)
      [n rs ng] (? (equal op "count") [(weft_std/rows sub).len 0 .false] (weft_std/reduce op items s))
      rkey (weft_std/key_of r)
      rrec (out.get([rkey])).fall(myth/new)
    | _ i.inc out.put([rkey] rrec.put([(weft_std/key_of c)] (weft_std/num_pail n ng)))
  + flatten
    ' Every record below the root as a child keyed by its path.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | tree.tap.fold (axal/new[myth] tree.fil)
          \ acc [p q]
          ? (eq p.len 0) acc
          | acc.put([(weft_std/dotted p)] q)
    | weft_std/done record out
  ' ---- compare with another view of the same shape
  + other_rows
    ' The rows of the secondary input named by /from (default other).
    \ record=myth
    ^ maybe[row[[path myth]]]
    = from ($ts (weft_std/text_or record ['from] "other"))
    > (./some view) (weft_std/view record from) .none
    | ./some (weft_std/rows view)
  + row_key
    ' What identifies a row across two views: the value of /key when
    ' given, else the row's path.
    \ record=myth p=path rec=myth
    ^ maybe[str]
    > (./some key) (weft_std/slot record ['key] []) (./some (path_show p))
    ? (eq key.len 0) (./some (path_show p))
    > (./some held) (weft_std/at rec p key) .none
    | ./some (weft_std/show_pail held)
  + keys_of
    \ record=myth rows=row[[path myth]]
    ^ row[str]
    = none=row[str] []
    | rows.fold none
      \ acc [p rec]
      > (./some k) (weft_std/row_key record p rec) acc
      acc.snoc(k)
  + keep_rows
    ' The input's rows whose key is (present) or is not (absent) among
    ' the other view's rows, under the input root.
    \ record=myth tree=axal[myth] present=bool
    ^ [myth axal[myth]]
    > (./some others) (weft_std/other_rows record) (weft_std/missing record tree "Supply a reference to the other view as a slot named by /from (default other)")
    = theirs (weft_std/keys_of record others)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          > (./some k) (weft_std/row_key record p rec) (? present acc acc.put(p rec))
          = found (theirs.any((\ x=str (equal x k))))
          ? (eq found present) acc.put(p rec)
          acc
    | weft_std/done record out
  + except
    ' The input's rows that the other view does not have (by /key, else by path).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/keep_rows record tree .false
  + intersect
    ' The input's rows that the other view also has (by /key, else by path).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/keep_rows record tree .true
  + identified
    ' Rows with their identity (the value of /key, else the path as
    ' text); a row without one is left out.
    \ record=myth rows=row[[path myth]]
    ^ row[[str path myth]]
    = none=row[[str path myth]] []
    | rows.fold none
      \ acc [p rec]
      > (./some k) (weft_std/row_key record p rec) acc
      acc.snoc([k p rec])
  + find_ident
    ' The first row with that identity.
    \ rows=row[[str path myth]] k=str
    ^ maybe[myth]
    = none=maybe[myth] .none
    | rows.fold none
      \ hit [k2 p rec]
      ? (maybe/is_some hit) hit
      ? (equal k2 k) (./some rec)
      hit
  + slot_diff
    ' The slots that differ between two records of the same row:
    ' <slot>/from holds the other view's value, <slot>/to the input's.
    \ old=myth new=myth
    ^ myth
    = forward
        | new.tap.fold myth/new
          \ acc [slot held]
          > (./some was) old.get(slot) acc.put(slot.weld(['to]) held)
          ? (equal (weft_std/show_pail was) (weft_std/show_pail held)) acc
          | acc.put(slot.weld(['from]) was).put(slot.weld(['to]) held)
    | old.tap.fold forward
      \ acc [slot was]
      ? new.has(slot) acc
      acc.put(slot.weld(['from]) was)
  + other_root
    ' The root record of the secondary input named by /from (default
    ' other); an empty record when the view has none.
    \ record=myth
    ^ myth
    = from ($ts (weft_std/text_or record ['from] "other"))
    > (./some vt) (weft_std/view record from) myth/new
    | vt.fil.fall(myth/new)
  + diff
    ' The input against the view at /from (default other; a /h view of
    ' the same path works): /added/<row> and /removed/<row> hold the rows
    ' only one side has, /changed/<row> the slots that differ
    ' (<slot>/from, <slot>/to); the two roots' slots as /changed/root
    ' (the input's record against the other view's); the root counts
    ' them.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some others) (weft_std/other_rows record) (weft_std/missing record tree "Supply a reference to the other view as a slot named by /from (default other)")
    = mine (weft_std/identified record (weft_std/rows tree))
      theirs (weft_std/identified record others)
      added=path ['added]
      removed=path ['removed]
      changed=path ['changed]
      start=[nat nat nat axal[myth]] [0 0 0 (axal/new[myth] .none)]
      [a r c out]
        | mine.fold start
          \ acc [k p rec]
          = [a2 r2 c2 o2] acc
          > (./some old) (weft_std/find_ident theirs k) [a2.inc r2 c2 o2.put(added.weld(p) rec)]
          = ch (weft_std/slot_diff old rec)
          ? (eq ch.tap.len 0) acc
          | [a2 r2 c2.inc o2.put(changed.weld(p) ch)]
      [r3 out3]
        | theirs.fold [r out]
          \ acc [k p rec]
          = [r2 o2] acc
          ? (maybe/is_some (weft_std/find_ident mine k)) acc
          | [r2.inc o2.put(removed.weld(p) rec)]
      mine_root tree.fil.fall(myth/new)
      root_ch (weft_std/slot_diff (weft_std/other_root record) mine_root)
      [c4 out4]
        ? (eq root_ch.tap.len 0) [c out3]
        | [c.inc out3.put(changed.weld(['root]) root_ch)]
      root (myth/sing ['added] (pails/n a)).put(['removed] (pails/n r3)).put(['changed] (pails/n c4))
    | weft_std/done record (axal/new[myth] (./some root)).uni(out4)
  + merge
    ' The input's children plus every secondary input's children (a later view wins a shared key).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | record.tap.fold (axal/new[myth] tree.fil).uni(tree)
          \ acc [k v]
          ? !(and (gt k.len 1) (eq_iota k.at(0) 'views)) acc
          > view=cell_view v acc
          | (weft_std/rows (unpin view.tree)).fold acc
            \ acc2 [p rec]
            | acc2.put(p rec)
    | weft_std/done record out
  ' ---- text
  + text_param
    \ record=myth key=path default=str
    ^ str
    > (./some t) (weft_std/text record key) default
    t
  + pieces
    ' A text cut at every occurrence of a separator (a text, not a byte);
    ' an empty separator gives the whole text.
    \ sep=str text=str
    ^ row[str]
    ? (eq sep.len 0) [text]
    % rest=str text out=list[str] .nil
    ^ row[str]
    ? (str/find sep rest)
     > (./some i)
      | _ rest.slice((add i sep.len) (sub rest.len (add i sep.len))) (list/cons[str] rest.slice(0 i) out)
     > .none (list/cons[str] rest out).row.rev
  + join
    ' Each row gains /into: the texts of /slots (space separated) joined by /with (default a space).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = wanted (weft_std/slots record ['slots])
    ? (eq wanted.len 0) (weft_std/missing record tree "Supply /slots: slot paths separated by spaces")
    = sep (weft_std/text_param record ['with] " ")
      into (weft_std/slot record ['into] ['joined]).fall(['joined])
      none=row[str] []
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          = texts
              | wanted.fold none
                \ ts pax
                > (./some held) (weft_std/at rec p pax) ts
                | ts.snoc((weft_std/show_pail held))
          ? (eq texts.len 0) acc.put(p rec)
          | acc.put(p rec.put(into (pails/t (str/join sep texts))))
    | weft_std/done record out
  + match
    ' The rows whose /key text contains (default), starts with or ends with /value.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    > (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = op (weft_std/text_or record ['op] "contains")
      hit
        \ shown=str
        ^ bool
        ? (equal op "starts") (maybe/is_some (str/prefix_at value 0 shown))
        ? (equal op "ends") (and (ge shown.len value.len) (equal[str] shown.slice((sub shown.len value.len) value.len) value))
        | maybe/is_some (str/find value shown)
      kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          > (./some held) (weft_std/at rec p key) out
          ? (hit (weft_std/show_pail held)) out.put(p rec)
          out
    | weft_std/done record kept
  + split
    ' Each row gains /into/1, /into/2, ...: its /slot text cut at /with (default a space); /into defaults to the slot.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = sep (weft_std/text_param record ['with] " ")
      into (weft_std/slot record ['into] slot).fall(slot)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          > (./some held) (weft_std/at rec p slot) acc.put(p rec)
          = parts (weft_std/pieces sep (weft_std/show_pail held))
            grown
              % i=nat 0 r=myth rec
              ^ myth
              ? (eq i parts.len) r
              | _ i.inc r.put(into.snoc(($u i.inc)) (pails/t parts.at(i)))
          | acc.put(p grown)
    | weft_std/done record out
  + date
    ' Each row gains /into (default /day): its /slot text date YYYY-MM-DD (anything after the day ignored) as the natural YYYYMMDD.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['day]).fall(['day])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          > (./some held) (weft_std/at rec p slot) acc.put(p rec)
          > (./some n) (weft_std/ymd (weft_std/show_pail held)) acc.put(p rec)
          | acc.put(p rec.put(into (pails/n n)))
    | weft_std/done record out
  + ymd
    ' "2026-10-16..." as 20261016; nothing when the first ten characters are not a date.
    \ t=str
    ^ maybe[nat]
    ? (lt t.len 10) .none
    = head t.slice(0 10)
      parts head.split_byte(45)
    ? !(eq parts.len 3) .none
    ? !(and (eq parts.at(0).len 4) (and (eq parts.at(1).len 2) (eq parts.at(2).len 2))) .none
    > (./some y) (nat/parse parts.at(0)) .none
    > (./some m) (nat/parse parts.at(1)) .none
    > (./some d) (nat/parse parts.at(2)) .none
    ? ((eq m 0) || ((gt m 12) || ((eq d 0) || (gt d 31)))) .none
    | ./some (add (mul y 10000) (add (mul m 100) d))
  + gather
    ' The input's tree with every secondary input nested under its slot
    ' name: /<slot>/... is that view, root and children.  The way to put
    ' several cells' answers in one tree, and to diff them at once.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | record.tap.fold tree
          \ acc [k v]
          ? !(and (gt k.len 1) (eq_iota k.at(0) 'views)) acc
          > view=cell_view v acc
          = name=path k.drop(1)
          | (unpin view.tree).tap.fold acc.put(name (unpin view.tree).fil.fall(myth/new))
            \ acc2 [p rec]
            | acc2.put(name.weld(p) rec)
    | weft_std/done record out
  ' ---- combine figures
  + arith
    \ record=myth tree=axal[myth] op=str
    ^ [myth axal[myth]]
    > (./some left) (weft_std/figure_of record ['left] tree) (weft_std/missing record tree "Supply /left: a number or a slot of the input")
    > (./some right) (weft_std/figure_of record ['right] tree) (weft_std/missing record tree "Supply /right: a number or a slot of the input")
    > (./some into) (weft_std/slot record ['into] ['result]) (weft_std/missing record tree "Supply /into as a slot path")
    ? (weft_std/arith_op op left right)
     > (./ok fig)
      = [n s ng] fig
      | weft_std/figure record into n s ng
     > (./err why) (weft_std/missing record tree why)
  + add
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "add"
  + subtract
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "subtract"
  + multiply
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "multiply"
  + divide
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "divide"
  + value_in
    ' Any slot: of the input root, or /views/<slot>/<path> of a secondary input.
    \ context=myth pax=path tree=axal[myth]
    ^ maybe[pail]
    ? (and (gt pax.len 2) (eq_iota pax.at(0) 'views))
      > (./some other) (weft_std/view context pax.at(1)) .none
      > (./some orec) other.fil .none
      | orec.get(pax.drop(2))
    > (./some root) tree.fil .none
    | root.get(pax)
  + pick
    ' Copy the slot at /from (of the input root, or /views/<slot>/<path>) to /into on the root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some from) (weft_std/slot record ['from] []) (weft_std/missing record tree "Supply /from")
    ? (eq from.len 0) (weft_std/missing record tree "Supply /from")
    > (./some into) (weft_std/slot record ['into] from.drop((? (eq_iota from.at(0) 'views) 2 0))) (weft_std/missing record tree "Supply /into")
    > (./some held) (weft_std/value_in record from tree) (weft_std/missing record tree "No value at /from")
    | weft_std/done record (axal/new[myth] (./some tree.fil.fall(myth/new).put(into held)))
  + put
    ' Set /into on the root to the literal /value (a number if it parses, else text).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    > (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = held=pail
        ? (nat/parse value)
         > (./some n) (pails/n n)
         > .none (pails/t value)
    | weft_std/done record (axal/new[myth] (./some tree.fil.fall(myth/new).put(into held)))
  + round
    ' Rescale the root's /slot to /places digits (half up), at /into (default: the same slot).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    > (./some into) (weft_std/slot record ['into] slot) (weft_std/missing record tree "Supply /into")
    > (./some places_text) (weft_std/text record ['places]) (weft_std/missing record tree "Supply /places: how many digits after the point")
    > (./some places) (nat/parse places_text) (weft_std/missing record tree "Supply /places as a number")
    = root tree.fil.fall(myth/new)
    > (./some fig) (weft_std/slot_figure root slot) (weft_std/missing record tree "No number at /slot")
    = [n s ng] fig
    | weft_std/figure record into (weft_std/rescale n s places) places ng
  ' ---- time
  + since
    ' /slot minus /from (a date or number; a literal or a slot), at /since, in the slot's own unit.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some later) (weft_std/figure_of record ['slot] tree) (weft_std/missing record tree "Supply /slot: a date slot of the input")
    > (./some earlier) (weft_std/figure_of record ['from] tree) (weft_std/missing record tree "Supply /from: a date or a slot")
    > (./some into) (weft_std/slot record ['into] ['since]) (weft_std/missing record tree "Supply /into")
    = [ln en s lneg eneg] (weft_std/align later earlier)
      [n ng] (weft_std/signed_add ln lneg en (? eneg .false (gt en 0)))
    | weft_std/figure record into n s ng
  + between
    ' The children whose /slot lies within /from and /to (inclusive), under the input root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    > (./some from) (weft_std/text record ['from]) (weft_std/missing record tree "Supply /from")
    > (./some to) (weft_std/text record ['to]) (weft_std/missing record tree "Supply /to")
    = kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          > (./some fig) (weft_std/figure_at rec p slot) out
          ? (and !(weft_std/matches "under" rec p slot from) !(weft_std/matches "over" rec p slot to)) out.put(p rec)
          out
    | weft_std/done record kept
  ' ---- hand edits that survive recomputation
  + amend
    ' Lay the notes at /views/<notes> over the answer.  A note is a
    ' record with /slot, /value, and /case: the input's x case when it
    ' was written.  /slot is a slot of the answer's root ("/revenue"),
    ' or a path into the answer tree with the slot last ("/d1/amount"
    ' corrects one row): the record at that path must exist, or the
    ' note is reported as dangling and nothing is created.  A note whose
    ' case is behind the input's current case still applies, and the
    ' context' says so.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = name ($ts (weft_std/text_or record ['notes] "notes"))
    > (./some notes) (weft_std/view record name) (weft_std/missing record tree "Supply a reference to the notes folder as a slot named by /notes")
    = current
        > (./some held) record.get(['sys 'tack 'case]) 0
        | (weft_std/nat_of held).fall(0)
      start [record tree]
      laid
        | (weft_std/rows notes).fold start
          \ acc [np nrec]
          = [ctx out] acc
            key (? (eq np.len 1) np.at(0) ($ta (path_show np)))
          > (./some slot) (weft_std/slot nrec ['slot] []) acc
          > (./some value) nrec.get(['value]) acc
          ? (eq slot.len 0) acc
          = stamp
              > (./some held) nrec.get(['case]) 0
              | (weft_std/nat_of held).fall(0)
            ctx2
              ? (eq stamp current) ctx
              | ctx.put(['sys 'view 'note key] (pails/t (str/cat_all ["note at case " (nat/show stamp) ", input now at case " (nat/show current)])))
            at (? (eq slot.len 1) [] slot.take(slot.len.dec))
            leaf (? (eq slot.len 1) slot [slot.at(slot.len.dec)])
          ? (and (gt at.len 0) !(maybe/is_some (out.dip(at)).fil))
            | [ctx.put(['sys 'view 'note key] (pails/t (str/cat_all ["no record at " (path_show at) " in the answer"]))) out]
          = target (out.dip(at)).fil.fall(myth/new)
          | [ctx2 out.put(at target.put(leaf value))]
      [ctx out] laid
    | [ctx.put(['sys 'view 'amended] (pails/n (weft_std/rows notes).len)) out]
  ' ---- judgement: a model's answer, stamped
  + ask
    ' A question (/prompt) put to a model (/model, default the hand's;
    ' a cell without one takes whatever model answered as current)
    ' over the input.  The answer is the stored result record at
    ' /views/result, which the ask hand writes with /answer and the stamp
    ' /case, /model and /prompt, when the stamp matches the input's
    ' current case and this cell's model and prompt.  Otherwise /x is
    ' empty and the context' says the hand is re-asking, at
    ' /sys/view/asking.  Nothing here calls a model: the hand does, and
    ' writes what it computed from.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    > (./some prompt) (weft_std/text record ['prompt]) (weft_std/missing record tree "Supply /prompt")
    = model (weft_std/text_or record ['model] "default")
      current
        > (./some held) record.get(['sys 'tack 'case]) 0
        | (weft_std/nat_of held).fall(0)
      empty (axal/new[myth] .none)
    > (./some result) (weft_std/view record 'result) [record.put(['sys 'view 'asking] (pails/t "no answer yet: the ask hand writes /result")) empty]
    > (./some answer) result.fil [record.put(['sys 'view 'asking] (pails/t "no answer yet: the ask hand writes /result")) empty]
    = stamp
        > (./some held) answer.get(['case]) 0
        | (weft_std/nat_of held).fall(0)
      same_model ((equal model "default") || (equal (weft_std/text_or answer ['model] "") model))
      same_prompt (equal (weft_std/text_or answer ['prompt] "") prompt)
    ? (and (eq stamp current) (and same_model same_prompt)) [record (axal/new[myth] (./some answer))]
    | [record.put(['sys 'view 'asking] (pails/t (str/cat_all ["re-asking " model ": answer at case " (nat/show stamp) ", input now at case " (nat/show current) (? same_prompt "" ", prompt changed") (? same_model "" ", model changed")]))) empty]
  ' ---- the registry
  + by_name
    ' The ctor a standard cell record names.  Records never hold the
    ' closure itself: a closure in the namespace is copied with every
    ' message and made each request forty times slower; a name is a
    ' pail, and travels.
    \ name=iota
    ^ maybe[cell]
    ? (eq_iota name 'count) (./some (cell weft_std/count))
    ? (eq_iota name 'sum) (./some (cell weft_std/sum))
    ? (eq_iota name 'min) (./some (cell weft_std/min))
    ? (eq_iota name 'max) (./some (cell weft_std/max))
    ? (eq_iota name 'avg) (./some (cell weft_std/avg))
    ? (eq_iota name 'any) (./some (cell weft_std/any))
    ? (eq_iota name 'all) (./some (cell weft_std/all))
    ? (eq_iota name 'where) (./some (cell weft_std/where))
    ? (eq_iota name 'sort) (./some (cell weft_std/sort))
    ? (eq_iota name 'top) (./some (cell weft_std/top))
    ? (eq_iota name 'latest) (./some (cell weft_std/latest))
    ? (eq_iota name 'earliest) (./some (cell weft_std/earliest))
    ? (eq_iota name 'each) (./some (cell weft_std/each))
    ? (eq_iota name 'lookup) (./some (cell weft_std/lookup))
    ? (eq_iota name 'distinct) (./some (cell weft_std/distinct))
    ? (eq_iota name 'select) (./some (cell weft_std/select))
    ? (eq_iota name 'by) (./some (cell weft_std/by))
    ? (eq_iota name 'grid) (./some (cell weft_std/grid))
    ? (eq_iota name 'flatten) (./some (cell weft_std/flatten))
    ? (eq_iota name 'merge) (./some (cell weft_std/merge))
    ? (eq_iota name 'gather) (./some (cell weft_std/gather))
    ? (eq_iota name 'join) (./some (cell weft_std/join))
    ? (eq_iota name 'match) (./some (cell weft_std/match))
    ? (eq_iota name 'split) (./some (cell weft_std/split))
    ? (eq_iota name 'date) (./some (cell weft_std/date))
    ? (eq_iota name 'except) (./some (cell weft_std/except))
    ? (eq_iota name 'intersect) (./some (cell weft_std/intersect))
    ? (eq_iota name 'diff) (./some (cell weft_std/diff))
    ? (eq_iota name 'add) (./some (cell weft_std/add))
    ? (eq_iota name 'subtract) (./some (cell weft_std/subtract))
    ? (eq_iota name 'multiply) (./some (cell weft_std/multiply))
    ? (eq_iota name 'divide) (./some (cell weft_std/divide))
    ? (eq_iota name 'pick) (./some (cell weft_std/pick))
    ? (eq_iota name 'put) (./some (cell weft_std/put))
    ? (eq_iota name 'round) (./some (cell weft_std/round))
    ? (eq_iota name 'since) (./some (cell weft_std/since))
    ? (eq_iota name 'between) (./some (cell weft_std/between))
    ? (eq_iota name 'amend) (./some (cell weft_std/amend))
    ? (eq_iota name 'ask) (./some (cell weft_std/ask))
    .none
  + record
    ' The record of one standard cell: the ctor's name and a title.
    \ name=iota title=str
    ^ myth
    | (myth/sing bond/weft (pails/q name)).put bond/lede (pails/t title)
  + names
    ^ row[[iota str]]
    [['count "Count the input's children"] ['sum "Sum /slot over the children"] ['min "Smallest /slot"] ['max "Largest /slot"]
     ['avg "Mean of /slot"] ['any "Whether any child has /slot true"] ['all "Whether every child has /slot true"]
     ['where "Keep the children whose /key matches /value under /op"] ['sort "Rank the children by /slot"] ['top "The /count largest by /slot"]
     ['latest "The child with the largest /slot"] ['earliest "The child with the smallest /slot"] ['each "A derived slot per child: /left /op /right into /into"]
     ['lookup "Bring /take from the table row whose /match equals each child's /key"] ['distinct "The values /slot takes, with counts"]
     ['select "Keep only /slots"] ['by "Group by /key, then /op of /slot"] ['grid "Rows by /row, a slot per /col, /op of /slot"]
     ['flatten "Every record below the root as a child keyed by its path"] ['merge "The input's children plus every secondary input's"] ['gather "The input with every secondary input nested under its slot name"]
     ['join "Each row gains /into: its /slots joined by /with"] ['match "The rows whose /key text contains, starts with or ends with /value"]
     ['split "Each row gains /into/1, /into/2: its /slot cut at /with"] ['date "Each row gains /into: its /slot text date as the natural YYYYMMDD"]
     ['except "The rows the view at /from does not have"] ['intersect "The rows the view at /from also has"]
     ['diff "Added, removed and changed rows against the view at /from"]
     ['add "Add"] ['subtract "Subtract"] ['multiply "Multiply"] ['divide "Divide"] ['pick "Copy /from to /into on the root"]
     ['put "Set /into on the root to /value"] ['round "Rescale /slot to /places digits"] ['since "/slot minus /from"]
     ['between "Keep the children whose /slot lies within /from and /to"] ['amend "Lay the notes at /views/notes over the input, with case stamps"]
     ['ask "A model's answer to /prompt over the input, stamped with the input's case; the ask hand writes it"]]
  + seeds
    ' Boot seeds under /weft/stdlib.
    ^ row[[path myth]]
    = all weft_std/names
      first=row[[path myth]] [[['weft 'stdlib] (myth/sing bond/lede (pails/t "Standard cells"))]]
    | all.fold first
      \ acc [name title]
      | acc.snoc([['weft 'stdlib name] (weft_std/record name title)])

' --- graph ---

'  The graph overlay: how the world's things connect, computed on read
'  from names and the reference index, never stored.  One thing as a
'  world (its slots as folders forward, what references it as folders
'  backward, where it sits as a folder upward, read off its own path,
'  each hop with its holder and the world asserting it), what
'  every world says about one thing (union over its same judgements),
'  several standings at once (one virtual root per connected component,
'  a standing nothing reaches an island).  The kernel names no edge of
'  its own: a folder is the slot the reference sits in, as its author
'  spelled it; a reference in a note is held by the note's slot; a cell
'  that reads a thing is a folder under the cell's name.  Identity is a
'  contract the records bring (same judgements).  Registered under
'  /weft/graph by name, so a cell applies a view by a path, never a closure.
+ graph
  + op
    ' What every view reads with: the cell's input, a name at a care, the
    ' reverse edges of a name, a collection of placements, and a safe's name.
    + input
      ' The thing a cell reads: its /sys/tack, when it is a reference.
      \ context=myth
      ^ maybe[safe]
      > (./some value) context.get(bond/tack) .none
      > source=safe value .none
      | ./some source
    + at
      ' Appending to a pinned input must select within THAT care's snapshot,
      ' not reuse its local case number as a case of a different child.
      \ source=safe relative=path cr=care
      ^ safe
      ? (eq source.ver 0) (safe 0 cr source.path.weld(relative))
      = prefix=path ['h (care/seg source.care) ($u source.ver) ($u source.path.len)]
      | safe 0 cr prefix.weld(source.path).weld(relative)
    + collection
      ' Members are placements, not copies. A selected branch reads only its
      ' matching member. Labels may contain several path segments.
      \ members=axal[safe] cr=care relative=path select=view_select
      ^ view_plan
      = placement=maybe[[safe path]]
          % width=nat relative.len
          ^ maybe[[safe path]]
          ? (members.get(relative.take(width)))
           > (./some source) (./some [source relative.drop(width)])
          ? (eq width 0) .none
          | _ width.dec
      ? placement
       > (./some found)
         = [source tail] found
         | ./graft (graph/op/at source tail cr)
      = branch members.dip(relative)
        base (axal/new[myth] (./some myth/new))
      ? (and (eq branch.kid.size 0) !(maybe/is_some branch.fil)) (./fail "missing branch")
      ? (equal[care] cr .x) (./done base)
      = entries branch.tap
      ? (equal[view_select] select .names)
        | ./done
          | entries.fold base
            \ out [name source]
            | out.put name myth/new
      % i=nat 0 result=axal[myth] base
      ^ view_plan
      ? (eq i entries.len) (./done result)
      = [name source] entries.at(i)
        read_care=care
          ? (equal[care] cr .y) .x
          .z
        ref (graph/op/at source [] read_care)
        resume (_ i.inc)
      | ./need (view_read ref select)
        \ value=res[axal[myth]]
        ^ view_plan
        = unresolved
            | myth/sing ['sys 'view 'origin] ref
          status=iota
            ? value
             > .null 'absent
            | 'unresolved
          placeholder unresolved.put(['sys 'view 'state] (pails/q status))
        > (./known tree) value (resume result.put(name placeholder))
        = tree
            > (./some record) tree.fil tree
            | tree.put [] record.put(['sys 'view 'origin] ref)
          merged
            | tree.tap.fold result
              \ out [suffix record]
              | out.put name.weld(suffix) record
        | resume merged
    + children
      ' The children of the input, as a view: a folder read through a cell.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      > (./some source) (graph/op/input context) (./fail "missing input")
      | ./graft (graph/op/at source relative cr)

    + gather
      ' Every user reference slot is a named placement. Function and tack are
      ' configuration, not members. No identity judgment is inferred here.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      = members
          | context.tap.fold (axal/new[safe] .none)
            \ out [slot held]
            ? ((equal[path] slot bond/weft) || (equal[path] slot bond/tack)) out
            > source=safe held out
            | out.put slot source
      | graph/op/collection members cr relative select

    + bind
      ' Run a plan to its tree, then go on with it: a need is forwarded, a
      ' graft read whole, a failure passed through.
      \ plan=view_plan next={\ axal[myth]}view_plan
      ^ view_plan
      ? plan
       > (./done tree) (next tree)
       > (./fail reason) (./fail reason)
       > (./need read resume)
         | ./need read (\ value (graph/op/bind (resume value) next))
       > (./graft source)
         | ./need (view_read source .all)
           \ value
           > (./known tree) value (./fail "reference unavailable")
           | next tree
    + name
      ' The name a safe reads: its path, less an /h head (/h/<care>/<case>/<len>).
      \ source=safe
      ^ path
      ? (and (is_h source.path) (ge source.path.len 4)) source.path.drop(4)
      | source.path
    + same
      ' Two references name the same thing at the same case.
      \ left=safe right=safe
      ^ bool
      | and (equal[path] (graph/op/name left) (graph/op/name right)) (eq left.ver right.ver)
    + computed
      ' A computed name: a view's result (/x) or an application (/o).  Drawn
      ' where a reference leads to it, read on demand, never evaluated inside
      ' another view, never a bridge between standings.
      \ source=safe
      ^ bool
      = name (graph/op/name source)
      | ((is_xv name) || (is_o name))
  + view
    ' Explorer policy is a set of named computations over the namespace. Nothing
    ' here owns a second store. Canonical references and assertion records remain
    ' where their authors put them; these functions only arrange observations.
    + reference
      ' The reference a record holds at a slot, when it holds one.
      \ slot=path record=myth
      ^ maybe[safe]
      > (./some held) record.get(slot) .none
      > ref=safe held .none
      | ./some ref
    + record
      ' A record read whole at care x; a name nothing was written at reads as
      ' an empty record, which is a fact to draw, not a failure.
      \ source=safe next={\ myth}view_plan
      ^ view_plan
      | ./need (view_read (graph/op/at source [] .x) .all)
        \ value=res[axal[myth]]
        ^ view_plan
        ? value
         > (./known tree) (next (tree.fil.fall(myth/new)))
        | ./need (view_read (graph/op/at source [] .y) .names)
          \ shape=res[axal[myth]]
          ^ view_plan
          ' A name nothing was written at (null, or unknown: the store does
          ' not know a never-written name) is a fact to draw, not a failure.
          | next myth/new
    + canonical
      ' Only an explicit graft origin changes authority. A cell's input is not
      ' automatically its identity: an analysis is not the record it analyzes.
      \ source=safe remaining=nat trail=row[safe] next={\ safe}view_plan
      ^ view_plan
      ? (eq remaining 0) (./fail "reference origin limit")
      ? (trail.any((\ previous (graph/op/same previous source)))) (./fail "reference origin cycle")
      | ./need (view_read (graph/op/at source [] .x) (view_select/slots [['sys 'view 'origin]]))
        \ value=res[axal[myth]]
        ^ view_plan
        > (./known tree) value (next source)
        > (./some record) tree.fil (next source)
        > (./some origin) (graph/view/reference ['sys 'view 'origin] record) (next source)
        ? (graph/op/same source origin) (next source)
        | graph/view/canonical origin remaining.dec trail.snoc(source) next
    + canonical_view
      ' The identity of a thing as the view sees it: the record and the
      ' members its same judgements join.
      \ get={\ myth care path view_select}view_plan context=myth cr=care relative=path select=view_select
      ^ view_plan
      > (./some source) (graph/op/input context) (./fail "missing input")
      | graph/view/canonical source 16 []
        \ origin=safe
        ^ view_plan
        | get context.put(bond/tack origin) cr relative select
    + pinned_r
      ' The /r read of a name inside a standing's own /h head: the edges as
      ' of that epoch or case.
      \ head=path spelled=path
      ^ path
      = prefix=path [head.at(0) 'z head.at(2) ($u spelled.len)]
      | prefix.weld(spelled)
    + incoming
      ' What references a thing, read from the index at the thing's own
      ' epoch when the standing is pinned (/h/<care>/e<epoch>/...), live
      ' otherwise: the picture as of then, both ways.
      \ source=safe next={\ axal[myth]}view_plan
      ^ view_plan
      = name (graph/op/name source)
        spelled (r_spell name)
        at=path
          ? (and (is_h source.path) (ge source.path.len 4)) (graph/view/pinned_r source.path spelled)
          spelled
      | ./need (view_read (safe 0 .z at) .all)
        \ value=res[axal[myth]]
        ^ view_plan
        ' A name nothing points at has no edges.
        = tree=axal[myth]
            > (./known found) value (axal/new[myth] .none)
            found
        = exact
            | tree.tap.fold (axal/new[myth] .none)
              \ out [at edge]
              > (./some target) (graph/view/reference ['target] edge) out
              ? !(equal[path] name (graph/op/name target)) out
              | out.put at edge
        | next exact
    + result
      ' A view's answer: the tree, cut to the relative path and the selection
      ' the reader asked for.
      \ tree=axal[myth] cr=care relative=path select=view_select
      ^ view_plan
      = tree tree.dip(relative)
      ? (and (eq tree.kid.size 0) !(maybe/is_some tree.fil)) (./fail "missing branch")
      = selected
          ? (equal[care] cr .x) (axal/new[myth] tree.fil)
          ? (equal[care] cr .y)
            | tree.kid_tap.fold (axal/new[myth] tree.fil)
              \ out [name child]
              | out.put [name] (child.fil.fall(myth/new))
          tree
      > (./known answer) (view_project select (./known selected)) (./fail "projection unavailable")
      | ./done answer
    + subject
      ' An explicit subject wins. The conventional same/<assertion> folder is
      ' an assertion about its parent, never a second copy of that parent.
      \ source=safe record=myth
      ^ safe
      ? (graph/view/reference ['subject] record)
       > (./some subject) subject
      = name (graph/op/name source)
        cut=maybe[nat]
          % i=nat 0
          ^ maybe[nat]
          ? (eq i name.len) .none
          ? (eq_iota name.at(i) 'same) (./some i)
          | _ i.inc
      ? cut
       > (./some width) (safe 0 .x name.take(width))
      source
    + identity
      ' Closure over explicit same assertions only. Matching spellings or text
      ' candidates never establish identity. Missing evidence stays unavailable.
      \ pending=row[safe] members=axal[safe] next={\ row[safe]}view_plan
      ^ view_plan
      ? (eq pending.len 0) (next (members.tap.map((\ [name ref] ref))))
      = source pending.at(0)
        name (graph/op/name source)
        rest pending.drop(1)
      ? (maybe/is_some members.get(name)) (graph/view/identity rest members next)
      ? (ge members.tap.len 64) (./fail "identity expansion limit")
      = members members.put(name source)
      | graph/view/record source
        \ record=myth
        ^ view_plan
        = outgoing
            ? (graph/view/reference ['same] record)
             > (./some other) rest.snoc(other)
            rest
        | ./need (view_read (graph/op/at source ['same] .z) .all)
          \ asserted=res[axal[myth]]
          ^ view_plan
          = outgoing
              > (./known tree) asserted outgoing
              | tree.tap.fold outgoing
                \ found [at assertion]
                > (./some other) (graph/view/reference ['same] assertion) found
                | found.snoc other
          | graph/view/incoming source
            \ incoming=axal[myth]
            ^ view_plan
            = empty=row[safe] []
              candidates
                | incoming.tap.fold empty
                  \ found [at edge]
                  > (./some slot) edge.path_at(['slot]) found
                  ? !((equal[path] slot ['same]) || (equal[path] slot ['subject])) found
                  > (./some holder) (graph/view/reference ['holder] edge) found
                  | found.snoc holder
            % i=nat 0 queue=row[safe] outgoing
            ^ view_plan
            ? (eq i candidates.len) (graph/view/identity queue members next)
            = holder candidates.at(i)
              resume (_ i.inc)
            | graph/view/record holder
              \ assertion=myth
              ^ view_plan
              > (./some other) (graph/view/reference ['same] assertion) (resume queue)
              = subject (graph/view/subject holder assertion)
              ? (equal[path] name (graph/op/name subject)) (resume queue.snoc(other))
              ? (equal[path] name (graph/op/name other)) (resume queue.snoc(subject))
              | resume queue
    + identities_at
      ' The members a thing's same judgements join, each a readable graft of
      ' its own record.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      > (./some source) (graph/op/input context) (./fail "missing input")
      | graph/view/identity [source] (axal/new[safe] .none)
        \ members=row[safe]
        ^ view_plan
        = placements
            | members.fold (axal/new[safe] .none)
              \ out member
              = name (graph/op/name member)
              | out.put name.cons(($u name.len)) member
        | graph/op/collection placements cr relative select
    + parts
      ' Segments that mark machinery beneath a thing (its talk, its asks, its
      ' views), never things of their own.
      ^ row[iota]
      ['talk 'turns 'asks 'found 'status 'taken 'context 'views 'integrated 'syncs 'runs 'repairs 'identities 'archive]
    + user_relative
      ' A name relative to its world's /user, or none when it is not a user
      ' name.
      \ name=path
      ^ maybe[path]
      % i=nat 0
      ^ maybe[path]
      ? (eq i name.len) .none
      ? (eq_iota name.at(i) 'user) (./some name.drop(i.inc))
      | _ i.inc
    + seg_is
      ' A path segment against a word: a numeric segment is simply not that
      ' word, where an iota comparison would fault.
      \ seg=iota word=iota
      ^ bool
      | equal[str] (path_show [seg]) (path_show [word])
    + private_part
      ' A name with a machinery segment in it is not a thing the page shows.
      \ name=path
      ^ bool
      = parts graph/view/parts
      | name.any((\ part (parts.any((\ hidden (graph/view/seg_is part hidden))))))
    + placement
      ' A record with a formula and an input is a cell.
      \ record=myth
      ^ bool
      | and (maybe/is_some record.get(bond/weft)) (maybe/is_some (graph/view/reference bond/tack record))
    + assertion
      ' The assertion protocol is identified by its fields. A business record
      ' under /claims is still a thing and must be visible to the property view.
      \ record=myth
      ^ bool
      | and (maybe/is_some record.get(['slot])) (maybe/is_some record.get(['value]))
    + title
      ' What a thing is called: its name, or a text's heading or page title.
      \ record=myth
      ^ str
      = name record.txt_at(['name])
      ? (gt name.len 0) name
      = heading record.txt_at(['heading])
      ? (gt heading.len 0) heading
      | record.txt_at(['title])
    + named
      ' A thing is called something: a name, or a text's heading or title.
      \ record=myth
      ^ bool
      | gt (graph/view/title record).len 0
    + thing
      ' What counts as a thing on the page: a user name with a title of its
      ' own, or a folder that holds named things; never a cell, an assertion
      ' record, or a moved name.
      \ name=path tree=axal[myth]
      ^ bool
      = record tree.fil.fall(myth/new)
      ? (graph/view/placement record) .false
      ? (maybe/is_some (graph/view/reference ['moved_to] record)) .false
      > (./some relative) (graph/view/user_relative name) .false
      ? ((lt relative.len 2) || (graph/view/private_part relative)) .false
      ? (graph/view/assertion record) .false
      ? (eq relative.len 2) ((gt record.tap.len 0) || (gt tree.kid.size 0))
      ? !(graph/view/named record) .false
      = own
          | record.tap.any
            \ [slot held]
            ? (pith_prefix ['sys] slot) .false
            | !((equal[path] slot ['name]) || ((equal[path] slot ['description]) || ((equal[path] slot ['source]) || (equal[path] slot ['sources]))))
      ? own .true
      ? (eq tree.kid.size 0) .true
      | tree.kid_tap.any
        \ [key child]
        = record child.fil.fall(myth/new)
        | and (graph/view/named record) !(graph/view/placement record)
    + frontier
      ' A record and its immediate children, at care y; a never-written name
      ' reads as empty.
      \ source=safe next={\ axal[myth]}view_plan
      ^ view_plan
      | ./need (view_read (graph/op/at source [] .y) .all)
        \ value=res[axal[myth]]
        ^ view_plan
        ' A name nothing was written at has an empty frontier (the store
        ' answers unknown for a never-written name).
        > (./known tree) value (next (axal/new[myth] .none))
        | next tree
    + holder
      ' The thing that holds a reference made from beneath it: walk up from
      ' the record to the nearest thing, and say which folder between them
      ' the reference sits in.
      \ source=safe original=path remaining=nat next={\ maybe[[safe path]]}view_plan
      ^ view_plan
      ? (eq remaining 0) (./fail "relation ownership limit")
      = name (graph/op/name source)
      > (./some relative) (graph/view/user_relative name) (next .none)
      ? (lt relative.len 2) (next .none)
      | graph/view/frontier source
        \ tree=axal[myth]
        ^ view_plan
        ? (graph/view/thing name tree)
          = label=path
              ? (equal[path] name original) []
              ? (eq original.len name.len.inc) original.drop(name.len)
              [original.at((sub original.len 2))]
          | next (./some [source label])
        = parent (safe 0 .x name.take(name.len.dec))
        | graph/view/holder parent original remaining.dec next
    + above
      ' Where a thing sits: the nearest thing above it, read off its own
      ' path, nothing stored.  The edge is labelled by the folder between
      ' them, or parts when the thing sits directly beneath, the inverse of
      ' the part edge; the hierarchy asserts it, so the thing above holds
      ' it.  A result's place is its cell; the page knows that already.
      \ source=safe next={\ row[graph/view/relation]}view_plan
      ^ view_plan
      = name (graph/op/name source)
        none=row[graph/view/relation] []
      ? ((lt name.len 2) || (graph/op/computed source)) (next none)
      | graph/view/holder (safe 0 .x name.take(name.len.dec)) name 16
        \ owner=maybe[[safe path]]
        ^ view_plan
        > (./some pair) owner (next none)
        = [holder folder] pair
          label=path (? (eq (graph/op/name holder).len.inc name.len) ['parts] folder)
        | next [(graph/view/relation 'up label holder holder source myth/new)]
    + relation
      ' via is the holder: the record whose slot points across (a thing's own
      ' record, a same judgement, a text whose prose names the thing as a path
      ' in brackets, a cell that reads the thing).  What kind of edge it is,
      ' is what the holder is; the label is always a name somebody wrote: the
      ' slot the reference sits in, or the cell.
      : direction=iota label=path other=safe via=safe about=safe note=myth
    + tacked
      ' The slots by which a cell reads a thing: its input, and the further
      ' standings of an overlay.
      \ slot=path
      ^ bool
      ? (equal[path] slot bond/tack) .true
      ? (eq slot.len 0) .false
      | graph/view/seg_is slot.at(0) 'standing
    + refs
      ' A record's references, in a slot or inside its prose, less the
      ' machinery (sys, source, moved_to): what it is about.
      \ record=myth
      ^ row[[path safe]]
      = empty=row[[path safe]] []
      | (reference_index/slots (./some record)).fold empty
        \ out [slot target]
        ? (pith_prefix ['sys] slot) out
        ? ((equal[path] slot ['source]) || ((equal[path] slot ['sources]) || (equal[path] slot ['moved_to]))) out
        | out.snoc [slot target]
    + primary
      ' The reference a child record is about, when it has exactly one:
      ' the folder names the relation.  With several, each slot names its
      ' own (folder/slot); no guess from the folder's spelling.
      \ source=safe folder=path refs=row[[path safe]]
      ^ maybe[path]
      ? (eq refs.len 1)
        = [slot target] refs.at(0)
        | ./some slot
      .none
    + qualifiers
      ' A holder's other slots: what it says beside the reference, drawn as
      ' the note on the line.
      \ record=myth keep=path
      ^ myth
      | record.tap.fold myth/new
        \ out [slot held]
        ? ((pith_prefix ['sys] slot) || (equal[path] slot keep)) out
        | out.put slot held
    + own_relations
      ' What a thing asserts itself: every reference it holds, in a slot or
      ' in its prose, labelled by the slot.
      \ source=safe record=myth
      ^ row[graph/view/relation]
      = empty=row[graph/view/relation] []
      | (reference_index/slots (./some record)).fold empty
        \ out [slot other]
        ? (pith_prefix ['sys] slot) out
        ? (equal[path] slot ['moved_to]) out
        > (./some relative) (graph/view/user_relative (graph/op/name other)) out
        | out.snoc (graph/view/relation 'out slot other source source myth/new)
    + branch_relations
      ' What a thing asserts through records filed beneath it: each child
      ' record's references, labelled by the folder when the record is about
      ' one thing and by the slot otherwise, with the record's other slots as
      ' the note.
      \ about=safe pending=row[[safe nat]] found=row[graph/view/relation] next={\ row[graph/view/relation]}view_plan
      ^ view_plan
      ? (eq pending.len 0) (next found)
      = [source depth] pending.at(0)
        rest pending.drop(1)
        name (graph/op/name source)
        relative name.drop((graph/op/name about).len)
      ? (graph/view/private_part relative) (graph/view/branch_relations about rest found next)
      | graph/view/frontier source
        \ tree=axal[myth]
        ^ view_plan
        = record tree.fil.fall(myth/new)
        ? ((graph/view/thing name tree) || ((graph/view/placement record) || (graph/view/assertion record)))
          | graph/view/branch_relations about rest found next
        = folder=path
            ? (eq relative.len 1) relative
            [relative.at((sub relative.len 2))]
          refs (graph/view/refs record)
          primary (graph/view/primary source folder refs)
          more
            | refs.fold found
              \ out [slot target]
              = included
                  > (./some selected) primary .true
                  | equal[path] selected slot
              ? !included out
              = label=path (? (maybe/is_some primary) folder folder.weld(slot))
              | out.snoc (graph/view/relation 'out label target source about (graph/view/qualifiers record slot))
          rest
            ? (eq depth 0) rest
            | tree.kid_tap.fold rest
              \ out [key child]
              | out.snoc [(graph/op/at source [key] .x) depth.dec]
        | graph/view/branch_relations about rest more next
    + incoming_relations
      ' What references a thing, from the index: a cell by its own name, a
      ' same judgement folded into identity, and every other record by the
      ' slot the reference sits in, held by the nearest thing above it.
      \ about=safe pending=row[myth] found=row[graph/view/relation] next={\ row[graph/view/relation]}view_plan
      ^ view_plan
      ? (eq pending.len 0) (next found)
      = edge pending.at(0)
        rest pending.drop(1)
        resume (graph/view/incoming_relations about rest)
      > (./some source) (graph/view/reference ['holder] edge) (resume found next)
      > (./some slot) edge.path_at(['slot]) (resume found next)
      = name (graph/op/name source)
      > (./some relative) (graph/view/user_relative name) (resume found next)
      ? (graph/view/tacked slot)
        ' A cell reads this thing: an edge to what it computes, under the
        ' cell's own name.  The result is read on demand, never inside the
        ' walk.
        = label=path [name.at(name.len.dec)]
        | resume found.snoc((graph/view/relation 'in label (safe 0 .x name.cons('x)) source about myth/new)) next
      ? ((graph/view/private_part relative) || (equal[path] slot ['moved_to])) (resume found next)
      | graph/view/record source
        \ record=myth
        ^ view_plan
        ? (graph/view/assertion record) (resume found next)
        | graph/view/holder source name 16
          \ owner=maybe[[safe path]]
          ^ view_plan
          > (./some pair) owner (resume found next)
          = [holder folder] pair
          ? (graph/op/same holder about) (resume found next)
          ? ((eq folder.len 0) || ((equal[path] slot ['source]) || (equal[path] slot ['sources])))
            ' The holder's own slot names the hop; its other slots (its prose,
            ' when the reference sits in prose) are the note on the line.
            | resume found.snoc((graph/view/relation 'in slot holder source about (graph/view/qualifiers record slot))) next
          = refs (graph/view/refs record)
            primary (graph/view/primary source folder refs)
            is_primary
              > (./some selected) primary (eq refs.len 1)
              | equal[path] selected slot
            label (? is_primary folder slot)
            note (graph/view/qualifiers record slot)
            note (? is_primary note note.put(['within] (pails/p folder)))
          | resume found.snoc((graph/view/relation 'in label holder source about note)) next
    + relations_one
      ' Every relation of one record: the records beneath it first (a
      ' judgement with its why, a sentence with its source say more than a
      ' slot alone, and a thing named twice sits in the first folder that
      ' names it), then its own slots, then where it sits, then what
      ' references it.
      \ source=safe next={\ row[graph/view/relation]}view_plan
      ^ view_plan
      | graph/view/frontier source
        \ tree=axal[myth]
        ^ view_plan
        = own (graph/view/own_relations source tree.fil.fall(myth/new))
          children=row[[safe nat]] (tree.kid_tap.map((\ [key child] [(graph/op/at source [key] .x) 2])))
          none=row[graph/view/relation] []
        | graph/view/branch_relations source children none
          \ beneath=row[graph/view/relation]
          ^ view_plan
          | graph/view/above source
            \ up=row[graph/view/relation]
            ^ view_plan
            | graph/view/incoming source
              \ incoming=axal[myth]
              ^ view_plan
              | graph/view/incoming_relations source (incoming.tap.map((\ [name edge] edge))) beneath.weld(own).weld(up) next
    + relations_for
      ' Every relation of a thing and the identity members its same
      ' judgements join, with the joins themselves left out.
      \ source=safe next={\ row[safe] row[graph/view/relation]}view_plan
      ^ view_plan
      | graph/view/identity [source] (axal/new[safe] .none)
        \ members=row[safe]
        ^ view_plan
        % i=nat 0 found=row[graph/view/relation] []
        ^ view_plan
        ? (eq i members.len) (next members found)
        = resume (_ i.inc)
        | graph/view/relations_one members.at(i)
          \ related=row[graph/view/relation]
          ^ view_plan
          = retained
              | related.filter
                \ edge
                ? ((equal[path] edge.label ['same]) || ((equal[path] edge.label ['different]) || (equal[path] edge.label ['why]))) .false
                | !(members.any((\ member (equal[path] (graph/op/name member) (graph/op/name edge.other)))))
          | resume found.weld(retained)
    + edge_name
      ' Where an edge sits in a relations tree: direction, label, and the
      ' other thing's name.
      \ edge=graph/view/relation
      ^ path
      = other (graph/op/name edge.other)
        prefix=path [edge.direction ($u edge.label.len)]
      | prefix.weld(edge.label).snoc(($u other.len)).weld(other)
    + relations_at
      ' The relations of the input as a tree, one record per edge, each
      ' assertion of the same edge beneath it.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      > (./some source) (graph/op/input context) (./fail "missing input")
      | graph/view/relations_for source
        \ members=row[safe] edges=row[graph/view/relation]
        ^ view_plan
        = root (myth/sing ['subject] source).put(['identities] (view_origins members))
        % i=nat 0 output=axal[myth] (axal/new[myth] (./some root))
        ^ view_plan
        ? (eq i edges.len) (graph/view/result output cr relative select)
        = edge edges.at(i)
          name (graph/view/edge_name edge)
          resume (_ i.inc)
        | ./need (view_read (graph/op/at edge.other [] .x) (view_select/slots [['name] ['heading] ['title]]))
          \ named=res[axal[myth]]
          ^ view_plan
          = title=str
              > (./known tree) named ""
              | graph/view/title tree.fil.fall(myth/new)
            record
              . (myth/sing ['direction] (pails/q edge.direction))
                put(['label] (pails/p edge.label))
                put(['other] edge.other)
                put(['name] (pails/t title))
                put(['via] edge.via)
                put(['about] edge.about)
            record
              | edge.note.tap.fold record
                \ acc [slot held]
                | acc.put slot.cons('note) held
            previous (output.get(name)).fall(record)
            via (graph/op/name edge.via)
            suffix=path ['assertions ($u via.len)]
            assertion name.weld(suffix).weld(via)
          | resume output.put(name previous).put(assertion record)
  + world
    ' A thing as a world: its relations as folders, each holding the things it
    ' relates to, opened again beneath them, to a depth.  A reading, not a crawl:
    ' breadth first over the whole page, so a thing opens once, where it first
    ' appears, and is only listed after that; each thing once per node, in the
    ' first folder that names it, carrying every label it has; folders capped,
    ' with a count of the rest; folders pointing at a thing closed beyond the
    ' subject, as counts, until that thing is read as a world itself.  Every item
    ' says which world asserts it.  The tree is addressable: a folder is
    ' <direction>/<n>/<label...>, an item beneath it <n>/<name...>, and an
    ' item's own folders sit beneath the item.
    + cap
      ' Items per folder at the subject, when the cell does not say (/cap).
      ' Two dozen is a folder a person reads whole.
      ^ nat
      24
    + deeper
      ' Items per folder beneath the subject, when the cell does not say
      ' (/deeper).  Six keeps a second level a glance, not a list.
      ^ nat
      6
    + nodes
      ' Things opened on one page, when the cell does not say (/nodes).  A
      ' hundred and fifty keeps a well-connected thing under a second.
      ^ nat
      150
    + bounds
      ' The page's bounds, from the cell's slots or the defaults: items per
      ' folder at the subject, items per folder beneath it, things opened.
      : cap=nat deeper=nat nodes=nat
    + bounds_of
      ' The page's bounds from the cell's slots, with the defaults as
      ' ceilings.
      \ context=myth
      ^ graph/world/bounds
      = cap (context.nat_at(['cap] graph/world/cap))
        deeper (context.nat_at(['deeper] graph/world/deeper))
        nodes (context.nat_at(['nodes] graph/world/nodes))
      | graph/world/bounds (? ((eq cap 0) || (gt cap 200)) graph/world/cap cap) (? ((eq deeper 0) || (gt deeper 50)) graph/world/deeper deeper) (? ((eq nodes 0) || (gt nodes 500)) graph/world/nodes nodes)
    + world
      ' The world a name belongs to: /0x11/0x12/user/... is 0x12's, kept
      ' under 0x11; /0x11/user/... is 0x11's.
      \ name=path
      ^ str
      = cut=maybe[nat]
          % i=nat 0
          ^ maybe[nat]
          ? (eq i name.len) .none
          ? (eq_iota name.at(i) 'user) (./some i)
          | _ i.inc
      > (./some at) cut ""
      ? (eq at 0) ""
      = shown (path_show [name.at(at.dec)])
      | shown.slice 1 shown.len
    + skipped
      ' Labels that are machinery, not relations to show: the claims protocol
      ' (to be retired into the one shape).  A source is a relation: the text
      ' that supports a line, followed like any reference, so two readers who
      ' digested one page meet through it.
      \ label=path
      ^ bool
      ? (eq label.len 0) .false
      | graph/view/seg_is label.at(0) 'claims
    + parts
      ' The things each member files beneath itself, by their folder.
      \ members=row[safe] next={\ row[graph/view/relation]}view_plan
      ^ view_plan
      % i=nat 0 found=row[graph/view/relation] []
      ^ view_plan
      ? (eq i members.len) (next found)
      = source members.at(i)
        resume (_ i.inc)
      | graph/view/frontier source
        \ tree=axal[myth]
        ^ view_plan
        = children tree.kid_tap
          source_name (graph/op/name source)
          computed ((is_xv source_name) || (is_o source_name))
        % j=nat 0 found=row[graph/view/relation] found
        ^ view_plan
        ? (eq j children.len) (resume found)
        = [key child] children.at(j)
          target (graph/op/at source [key] .x)
          name (graph/op/name target)
          advance (_ j.inc)
        ? ((graph/view/private_part [key]) || (graph/world/skipped [key])) (advance found)
        ? computed
          | advance found.snoc((graph/view/relation 'part ['beneath] target target source myth/new))
        | graph/view/frontier target
          \ child=axal[myth]
          ^ view_plan
          = record child.fil.fall(myth/new)
          ? ((graph/view/placement record) || (graph/view/assertion record)) (advance found)
          ? (graph/view/thing name child)
            | advance found.snoc((graph/view/relation 'part ['parts] target target source myth/new))
          = selected
              | child.kid_tap.fold found
                \ out [leaf subtree]
                = at (graph/op/at target [leaf] .x)
                ? !(graph/view/thing (graph/op/name at) subtree) out
                | out.snoc (graph/view/relation 'part [key] at at source myth/new)
          | advance selected
    + item
      ' One related thing in one folder, with every label it has there and
      ' the holder of the first edge that reached it.
      : other=safe labels=row[path] by=row[str] direction=iota note=myth via=safe
    + folder
      : direction=iota label=path items=row[graph/world/item]
    + rank
      ' Folder order: what the thing asserts, then its parts, then where
      ' it sits, then what points at it.
      \ direction=iota
      ^ nat
      ? (eq_iota direction 'out) 0
      ? (eq_iota direction 'part) 1
      ? (eq_iota direction 'up) 2
      3
    + key
      : direction=iota label=path
    + folders
      ' The relations and parts of one thing as folders: one thing once,
      ' in the first folder naming it, by its identity; nothing on the
      ' trail (an ancestor on the page); labels that are provenance left
      ' out.  Folders come in rank order (asserted, parts, where it sits,
      ' pointing here), then in the order their first edge appeared.
      \ relations=row[graph/view/relation] trail=row[path]
      ^ row[graph/world/folder]
      = kept
          | relations.filter
            \ edge=graph/view/relation
            ? (graph/world/skipped edge.label) .false
            | !(trail.any((\ seen=path (equal[path] seen (graph/op/name edge.other)))))
        outs (kept.filter((\ e=graph/view/relation (eq_iota e.direction 'out))))
        parts (kept.filter((\ e=graph/view/relation (eq_iota e.direction 'part))))
        ups (kept.filter((\ e=graph/view/relation (eq_iota e.direction 'up))))
        ins (kept.filter((\ e=graph/view/relation (eq_iota e.direction 'in))))
        ordered outs.weld(parts).weld(ups).weld(ins)
      % i=nat 0 items=axal[graph/world/item] (axal/new[graph/world/item] .none) keys=row[graph/world/key] [] names=row[[graph/world/key path]] []
      ^ row[graph/world/folder]
      ? (eq i ordered.len) (graph/world/arrange keys names items)
      = edge ordered.at(i)
        name (graph/op/name edge.other)
        by (graph/world/world (graph/op/name edge.via))
        k (graph/world/key edge.direction edge.label)
      ? (items.get(name))
       > (./some it)
         ' Already placed: the label and the asserting world join its item.
         = labels (? (it.labels.any((\ l=path (equal[path] l edge.label)))) it.labels it.labels.snoc(edge.label))
           bys (? (it.by.any((\ w=str (equal[str] w by)))) it.by it.by.snoc(by))
           note (graph/world/noted it.note edge.note)
         | _ i.inc items.put(name it.set_labels(labels).set_by(bys).set_note(note)) keys names
      = fresh (graph/world/item edge.other [edge.label] [by] edge.direction edge.note edge.via)
        known (keys.any((\ q=graph/world/key (and (eq_iota q.direction k.direction) (equal[path] q.label k.label)))))
      | _ i.inc items.put(name fresh) (? known keys keys.snoc(k)) names.snoc([k name])
    + noted
      ' One note joins another: later slots win.
      \ base=myth more=myth
      ^ myth
      = pairs more.tap
      % i=nat 0 out=myth base
      ^ myth
      ? (eq i pairs.len) out
      = [slot held] pairs.at(i)
      | _ i.inc out.put(slot held)
    + arrange
      ' The folders, each with the items first placed in it, in order.
      \ keys=row[graph/world/key] names=row[[graph/world/key path]] items=axal[graph/world/item]
      ^ row[graph/world/folder]
      % i=nat 0 out=row[graph/world/folder] []
      ^ row[graph/world/folder]
      ? (eq i keys.len) out
      = k keys.at(i)
        mine=row[graph/world/item]
          % j=nat 0 found=row[graph/world/item] []
          ^ row[graph/world/item]
          ? (eq j names.len) found
          = [q name] names.at(j)
          ? !(and (eq_iota q.direction k.direction) (equal[path] q.label k.label)) (_ j.inc found)
          ? (items.get(name))
           > (./some it) (_ j.inc found.snoc(it))
          | _ j.inc found
      | _ i.inc out.snoc((graph/world/folder k.direction k.label mine))
    + folder_name
      ' A folder's address: direction, the label's length, the label.
      \ f=graph/world/folder
      ^ path
      = prefix=path [f.direction ($u f.label.len)]
      | prefix.weld(f.label)
    + item_name
      ' An item's address beneath its folder: the thing's length, the thing.
      \ it=graph/world/item
      ^ path
      = other (graph/op/name it.other)
        head=path [($u other.len)]
      | head.weld(other)
    + item_record
      ' What the page says about one item: its title, its name, its world,
      ' who asserts it, every label it has here, whether it was shown above,
      ' the holder, and the holder's other slots as note/<slot>.
      \ it=graph/world/item title=str seen=bool
      ^ myth
      = worlds (str/join " " it.by)
        record
          . (myth/sing ['name] (pails/t title))
            put(['at] it.other)
            put(['world] (pails/t (graph/world/world (graph/op/name it.other))))
            put(['by] (pails/t worlds))
        record (? (gt it.labels.len 1) record.put(['also] (pails/t (str/join ", " it.labels.drop(1).map((\ l=path (path_show l)))))) record)
        record (? seen record.put(['seen] (pails/b .true)) record)
        record record.put(['via] it.via)
      | it.note.tap.fold record
        \ out=myth [slot held]
        ? (pith_prefix ['sys] slot) out
        ? held
         > ref=safe out
        | out.put slot.cons('note) held
    + mark
      ' Names opened on the page so far, so a thing opens once.
      \ names=row[path] opened=axal[nat]
      ^ axal[nat]
      % i=nat 0 out=axal[nat] opened
      ^ axal[nat]
      ? (eq i names.len) out
      | _ i.inc out.put(names.at(i) 1)
    + entry
      ' One thing waiting to be opened on the page: where its folders go,
      ' the thing, how deep it may still go, the names above it, and
      ' whether it is a standing (opened whole) or a thing reached.
      : at=path source=safe depth=nat trail=row[path] whole=bool
    + page
      ' Breadth first: the subject opens whole; a thing beneath it opens
      ' once, where it first appears; later it is listed and marked seen.
      \ queue=row[graph/world/entry] opened=axal[nat] output=axal[myth] used=nat b=graph/world/bounds cr=care relative=path select=view_select
      ^ view_plan
      ? (eq queue.len 0) (graph/view/result output cr relative select)
      = here queue.at(0)
        rest queue.drop(1)
        whole here.whole
      | graph/view/relations_for here.source
        \ members=row[safe] relations=row[graph/view/relation]
        ^ view_plan
        | graph/world/parts members
          \ parts=row[graph/view/relation]
          ^ view_plan
          = names (members.map((\ m=safe (graph/op/name m))))
            opened (graph/world/mark names opened)
            trail here.trail.weld(names)
            fs (graph/world/folders relations.weld(parts) trail)
            limit (? whole b.cap b.deeper)
            record (output.dip(here.at).fil.fall(myth/new)).put(['worlds] (pails/t (str/join " " (names.map((\ n=path (graph/world/world n)))))))
            output output.put(here.at record)
          | graph/world/place fs 0 limit whole here trail opened output used rest b cr relative select
    + place
      ' Lay one node's folders into the page, then go on to the next thing.
      \ fs=row[graph/world/folder] i=nat limit=nat whole=bool here=graph/world/entry trail=row[path] opened=axal[nat] output=axal[myth] used=nat rest=row[graph/world/entry] b=graph/world/bounds cr=care relative=path select=view_select
      ^ view_plan
      ? (eq i fs.len) (graph/world/page rest opened output used b cr relative select)
      = f fs.at(i)
        fname here.at.weld((graph/world/folder_name f))
        ' What points here and where it sits arrive closed beyond the subject;
        ' the thing above is listed at the subject, never opened beneath it:
        ' its parts are this thing's siblings, and they are its own page.
        up (eq_iota f.direction 'up)
        closed (and !whole ((eq_iota f.direction 'in) || up))
        shown (? closed 0 (? (lt f.items.len limit) f.items.len limit))
        head (myth/sing ['count] (pails/n f.items.len))
        head (? (gt f.items.len shown) head.put(['more] (pails/n (sub f.items.len shown))) head)
        head (? closed head.put(['closed] (pails/b .true)) head)
        output output.put(fname head)
      | graph/world/items f.items 0 shown fname here trail opened output used b.nodes !up
        \ opened=axal[nat] output=axal[myth] used=nat queued=row[graph/world/entry]
        ^ view_plan
        | graph/world/place fs i.inc limit whole here trail opened output used rest.weld(queued) b cr relative select
    + items
      ' The items of one folder, each named by a read of its record; a thing
      ' not yet opened on the page is queued to open beneath its item, when
      ' the folder opens its items at all.
      \ items=row[graph/world/item] j=nat shown=nat fname=path here=graph/world/entry trail=row[path] opened=axal[nat] output=axal[myth] used=nat most=nat open=bool next={\ axal[nat] axal[myth] nat row[graph/world/entry]}view_plan
      ^ view_plan
      % j=nat j opened=axal[nat] opened output=axal[myth] output used=nat used queued=row[graph/world/entry] []
      ^ view_plan
      ? (eq j shown) (next opened output used queued)
      = it items.at(j)
        name (graph/op/name it.other)
        iname fname.weld((graph/world/item_name it))
        seen (maybe/is_some opened.get(name))
        resume (_ j.inc)
      ? (graph/op/computed it.other)
        ' A view's result: named by its cell, listed.  Opened only inside a
        ' result already open, so a view's own page goes to its depth and a
        ' thing's page never evaluates the cells that read it.
        = spelled (path_show [name.at(name.len.dec)])
          title spelled.slice(1 spelled.len)
          output output.put(iname (graph/world/item_record it title seen))
        ? !(graph/op/computed here.source) (resume opened output used queued)
        ? ((seen || (eq here.depth 1)) || ((ge used most) || !open)) (resume opened output used queued)
        | resume opened.put(name 1) output used.inc queued.snoc((graph/world/entry iname it.other here.depth.dec trail .false))
      | ./need (view_read (graph/op/at it.other [] .x) (view_select/slots [['name] ['heading] ['title]]))
        \ named=res[axal[myth]]
        ^ view_plan
        = title=str
            > (./known tree) named ""
            | graph/view/title tree.fil.fall(myth/new)
          output output.put(iname (graph/world/item_record it title seen))
        ? ((seen || (eq here.depth 1)) || ((ge used most) || !open)) (resume opened output used queued)
        | resume opened.put(name 1) output used.inc queued.snoc((graph/world/entry iname it.other here.depth.dec trail .false))
  + union
    ' A union preserves assertions and their owners. Matching a slot is a way to
    ' compare claims, never permission to choose a winner or erase disagreement.
    + fact
      : about=safe source=safe slot=path value=pail evidence=myth
    + literal
      ' A slot that states a value of its own, not a name, a description, a
      ' text, or a reference.
      \ slot=path held=pail
      ^ bool
      ? (pith_prefix ['sys] slot) .false
      ? ((equal[path] slot ['name]) || ((equal[path] slot ['description]) || ((equal[path] slot ['text]) || ((equal[path] slot ['said]) || (equal[path] slot ['quote]))))) .false
      ? held
       > ref=safe .false
      .true
    + claim_slot
      ' The slot a claims record asserts, spelled as a path.
      \ record=myth
      ^ maybe[path]
      > (./some held) record.get(['slot]) .none
      ? held
       > value=pails/p (./some value.p)
       > value=pails/t
         ? (eq value.t.len 0) .none
         | path_parse (? (eq value.t.at(0) 47) value.t (str/cat_all ["/" value.t]))
      .none
    + facts
      ' Every value each identity member states, its own slots and its
      ' claims, each with the record that states it.
      \ members=row[safe] next={\ row[graph/union/fact]}view_plan
      ^ view_plan
      % i=nat 0 found=row[graph/union/fact] []
      ^ view_plan
      ? (eq i members.len) (next found)
      = member members.at(i)
        resume (_ i.inc)
      | graph/view/record member
        \ record=myth
        ^ view_plan
        = found
            | record.tap.fold found
              \ out [slot value]
              ? !(graph/union/literal slot value) out
              | out.snoc (graph/union/fact member member slot value myth/new)
        | ./need (view_read (graph/op/at member ['claims] .z) .all)
          \ claims=res[axal[myth]]
          ^ view_plan
          > (./known tree) claims (resume found)
          = found
              | tree.tap.fold found
                \ out [relative assertion]
                ? (maybe/is_some assertion.get(['retracted])) out
                > (./some slot) (graph/union/claim_slot assertion) out
                > (./some value) assertion.get(['value]) out
                = source (graph/op/at member relative.cons('claims) .x)
                | out.snoc (graph/union/fact member source slot value assertion)
          | resume found
    + tree
      ' Facts by slot, each assertion beneath it with its source, and whether
      ' the slot disagrees across worlds.
      \ facts=row[graph/union/fact] conflicts=bool
      ^ axal[myth]
      = empty=mop[path row[graph/union/fact] lt_pith] (mop/empty)
        groups
          | facts.fold empty
            \ out fact
            | out.put fact.slot (out.get(fact.slot)).fall([]).snoc(fact)
        rows=row[mop/kv[path row[graph/union/fact]]] groups.tap
        initial=axal[myth] (axal/new[myth] (./some myth/new))
      | rows.fold initial
        \ out=axal[myth] pair=mop/kv[path row[graph/union/fact]]
        ^ axal[myth]
        = [slot claims] pair
          first claims.at(0).value
          differs !(claims.all((\ fact (equal[pail] first fact.value))))
        ? (and conflicts !differs) out
        = name=path slot.cons(($u slot.len))
          record (myth/sing ['slot] (pails/p slot)).put(['disagreement] (pails/b differs)).put(['assertions] (pails/n claims.len))
          out out.put(name record)
        | claims.fold out
          \ out=axal[myth] fact=graph/union/fact
          ^ axal[myth]
          = source=path (graph/op/name fact.source)
            suffix=path ['assertions ($u source.len)]
            at name.weld(suffix).weld(source)
            record
              . (myth/sing ['value] fact.value)
                put(['source] fact.source)
                put(['about] fact.about)
                put(['slot] (pails/p fact.slot))
            record
              | fact.evidence.tap.fold record
                \ out [slot held]
                | out.put slot.cons('evidence) held
          | out.put at record
    + get
      ' What every world says about the input: its identity members, their
      ' facts, the conflicts, their relations.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      | graph/view/canonical_view graph/union/get_at context cr relative select
    + members
      ' The identity members, each a readable graft of its own record.
      \ source=safe cr=care relative=path select=view_select
      ^ view_plan
      | graph/view/identity [source] (axal/new[safe] .none)
        \ members=row[safe]
        ^ view_plan
        % i=nat 0 output=axal[myth] (axal/new[myth] (./some myth/new))
        ^ view_plan
        ? (eq i members.len) (graph/view/result output cr relative select)
        = member members.at(i)
          name (graph/op/name member)
          resume (_ i.inc)
        | ./need (view_read (graph/op/at member [] .x) (view_select/slots [['name]]))
          \ value=res[axal[myth]]
          ^ view_plan
          = record
              > (./known tree) value myth/new
              | tree.fil.fall(myth/new)
          | resume output.put(name.cons(($u name.len)) record.put(['source] member))
    + get_at
      ' The union's branches by name: records, members, facts, conflicts,
      ' relations; the outline at care y, the whole at care z.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      > (./some source) (graph/op/input context) (./fail "missing input")
      ? (gt relative.len 0)
        = first relative.at(0)
          tail relative.drop(1)
        ? (eq_iota first 'records) (graph/view/identities_at context cr tail select)
        ? (eq_iota first 'members) (graph/union/members source cr tail select)
        ? (eq_iota first 'relations) (graph/view/relations_at context cr tail select)
        ? !((eq_iota first 'facts) || (eq_iota first 'conflicts)) (./fail "missing union branch")
        | graph/view/identity [source] (axal/new[safe] .none)
          \ members=row[safe]
          ^ view_plan
          | graph/union/facts members
            \ facts=row[graph/union/fact]
            ^ view_plan
            | graph/view/result (graph/union/tree facts (eq_iota first 'conflicts)) cr tail select
      = root (myth/sing ['subject] source).put(['coverage] (pails/t "Explicit identity assertions and recorded facts; no claim of exhaustive knowledge."))
        leaf (axal/new[myth] (./some root))
      ? (equal[care] cr .x) (./done leaf)
      = keys=path ['records 'members 'facts 'conflicts 'relations]
      ? ((equal[care] cr .y) || (equal[view_select] select .names))
        = outline
            | keys.fold leaf
              \ out key
              | out.put [key] myth/new
        | ./done outline
      % i=nat 0 output=axal[myth] leaf
      ^ view_plan
      ? (eq i keys.len) (./done output)
      = key keys.at(i)
        resume (_ i.inc)
      | graph/op/bind (graph/union/get_at context .z [key] select)
        \ tree=axal[myth]
        ^ view_plan
        = merged
            | tree.tap.fold output
              \ out [name record]
              | out.put name.cons(key) record
        | resume merged
  + overlay
    ' Standings read as one picture.  Every standing is walked over its
    ' relations to a depth, breadth first; a name is owned by the standing
    ' that reached it first, and where another standing reaches it they
    ' meet.  Standings that meet, over any reference whatever holds it,
    ' form one component; a standing nothing reaches is an island, a
    ' component of one.  The result is one virtual root per component,
    ' /<n>, and beneath it the full as-world unfolding of that component's
    ' standings, each hop with its holder and its world; a standing reached
    ' inside another's unfolding says so.  Nothing it draws is written back.
    ' Standings: the input (/sys/tack) and every standing/<key> slot.  The
    ' care says what each contributes: at x the record, at y its children
    ' too, at z every thing beneath it, each a standing of its own.
    + reached
      ' A name the walk reached: by which standing, from which name, by
      ' which label; a standing itself from nothing.
      : standing=nat from=path label=path
    + entry
      : standing=nat source=safe depth=nat
    + meeting
      ' Two standings met: the one walking, the one that was there first,
      ' the name they met at, the name the walker came from and the label
      ' it crossed.
      : from=nat to=nat at=path via=path label=path
    + state
      : reach=axal[graph/overlay/reached] meetings=row[graph/overlay/meeting] used=nat
    + standings
      ' The standings of an overlay: the input, and every standing/<key>
      ' slot.
      \ context=myth
      ^ row[[iota safe]]
      = base=row[[iota safe]]
          > (./some source) (graph/op/input context) []
          [['input source]]
      | context.tap.fold base
        \ out=row[[iota safe]] [slot held]
        ? !(eq slot.len 2) out
        ? !(graph/view/seg_is slot.at(0) 'standing) out
        > source=safe held out
        | out.snoc [slot.at(1) source]
    + expand
      ' What a standing contributes, by its care: at x the record; at y its
      ' children too, each a standing of its own; at z every thing beneath
      ' it.  Read off the tree, bounded by /nodes.
      \ standings=row[[iota safe]] i=nat out=row[[iota safe]] most=nat next={\ row[[iota safe]]}view_plan
      ^ view_plan
      ? (gt out.len most) (./fail "more standings than /nodes; raise /nodes or narrow the care")
      ? (eq i standings.len) (next out)
      = [key source] standings.at(i)
        kept out.snoc([key (graph/op/at source [] .x)])
        resume (graph/overlay/expand standings i.inc)
      ? (equal[care] source.care .x) (resume kept most next)
      ? (equal[care] source.care .y)
        | graph/view/frontier source
          \ tree=axal[myth]
          ^ view_plan
          = name (graph/op/name source)
            more
              | tree.kid_tap.fold kept
                \ acc=row[[iota safe]] [k child]
                ? !(graph/view/thing name.snoc(k) child) acc
                | acc.snoc [k (graph/op/at source [k] .x)]
          | resume more most next
      | ./need (view_read (graph/op/at source [] .z) .all)
        \ value=res[axal[myth]]
        ^ view_plan
        = tree=axal[myth]
            > (./known found) value (axal/new[myth] .none)
            found
          name (graph/op/name source)
          start=row[[path axal[myth]]] [[[] tree]]
        % queue=row[[path axal[myth]]] start found=row[[iota safe]] kept
        ^ view_plan
        ? ((eq queue.len 0) || (gt found.len most)) (resume found most next)
        = [rel sub] queue.at(0)
          rest queue.drop(1)
          [queued more]
            | sub.kid_tap.fold [rest found]
              \ acc=[row[[path axal[myth]]] row[[iota safe]]] [k child]
              = [q f] acc
                at rel.snoc(k)
              ? (graph/view/private_part at) acc
              ? !(graph/view/thing name.weld(at) child) [q.snoc([at child]) f]
              | [q.snoc([at child]) f.snoc([k (graph/op/at source at .x)])]
        | _ queued more
    + fold
      ' Standings judged the same are one standing: the first keeps its
      ' place, the others fold beneath it as its other representations
      ' (same/<k> on its root); the identity is shown, never walked twice.
      \ standings=row[[iota safe]] i=nat kept=row[[iota safe]] absorbed=axal[path] mates=axal[row[safe]] next={\ row[[iota safe]] axal[row[safe]]}view_plan
      ^ view_plan
      ? (eq i standings.len) (next kept mates)
      = [key source] standings.at(i)
        name (graph/op/name source)
        none=row[safe] []
      ? (absorbed.get(name))
       > (./some owner)
         = had (mates.get(owner)).fall(none)
         | graph/overlay/fold standings i.inc kept absorbed mates.put(owner had.snoc(source)) next
      | graph/view/identity [source] (axal/new[safe] .none)
        \ members=row[safe]
        ^ view_plan
        = marked
            | members.fold absorbed
              \ acc=axal[path] m=safe
              = mn (graph/op/name m)
              ? (equal[path] mn name) acc
              | acc.put mn name
        | graph/overlay/fold standings i.inc kept.snoc([key source]) marked mates next
    + paired
      ' Two standings already known to meet.
      \ from=nat to=nat meetings=row[graph/overlay/meeting]
      ^ bool
      | meetings.any
        \ m=graph/overlay/meeting
        | ((and (eq m.from from) (eq m.to to)) || (and (eq m.from to) (eq m.to from)))
    + walk
      ' Breadth first over every standing's queue at once.
      \ queue=row[graph/overlay/entry] st=graph/overlay/state most=nat next={\ graph/overlay/state}view_plan
      ^ view_plan
      ? ((eq queue.len 0) || (ge st.used most)) (next st)
      = here queue.at(0)
        rest queue.drop(1)
      | graph/view/relations_for here.source
        \ members=row[safe] relations=row[graph/view/relation]
        ^ view_plan
        ' Placement is a relation: what a thing files beneath itself is
        ' reached like any slot, so a bucket reaches its records.
        | graph/world/parts members
        \ parts=row[graph/view/relation]
        ^ view_plan
        = kept
            | relations.weld(parts).filter
              \ e=graph/view/relation
              ? (graph/world/skipped e.label) .false
              | !(graph/op/computed e.other)
          shown (? (lt kept.len graph/world/cap) kept kept.take(graph/world/cap))
          ' Identity members (same judgements) are reached over one hop.
          joined
            | members.fold [st.reach st.meetings]
              \ acc=[axal[graph/overlay/reached] row[graph/overlay/meeting]] m=safe
              ^ [axal[graph/overlay/reached] row[graph/overlay/meeting]]
              = [reach meetings] acc
                name (graph/op/name m)
              ? (equal[path] name (graph/op/name here.source)) [reach meetings]
              ? (reach.get(name))
               > (./some r)
                 ? ((eq r.standing here.standing) || (graph/overlay/paired r.standing here.standing meetings)) [reach meetings]
                 | [reach meetings.snoc((graph/overlay/meeting here.standing r.standing name (graph/op/name here.source) ['same]))]
              | [reach.put(name (graph/overlay/reached here.standing (graph/op/name here.source) ['same])) meetings]
          [reach0 meetings0] joined
        % i=nat 0 reach=axal[graph/overlay/reached] reach0 meetings=row[graph/overlay/meeting] meetings0 queued=row[graph/overlay/entry] rest
        ^ view_plan
        ? (eq i shown.len) (graph/overlay/walk queued (graph/overlay/state reach meetings st.used.inc) most next)
        = edge shown.at(i)
          other (graph/op/name edge.other)
        ? (reach.get(other))
         > (./some r)
           ? ((eq r.standing here.standing) || (graph/overlay/paired r.standing here.standing meetings)) (_ i.inc reach meetings queued)
           | _ i.inc reach meetings.snoc((graph/overlay/meeting here.standing r.standing other (graph/op/name here.source) edge.label)) queued
        = reach reach.put(other (graph/overlay/reached here.standing (graph/op/name here.source) edge.label))
          queued (? (eq here.depth 1) queued queued.snoc((graph/overlay/entry here.standing edge.other here.depth.dec)))
        | _ i.inc reach meetings queued
    + components
      ' A component label per standing: standings that meet share one.
      \ count=nat meetings=row[graph/overlay/meeting]
      ^ row[nat]
      = start=row[nat]
          % i=nat 0 out=row[nat] []
          ^ row[nat]
          ? (eq i count) out
          | _ i.inc out.snoc(i)
      | meetings.fold start
        \ labels=row[nat] m=graph/overlay/meeting
        ^ row[nat]
        = keep labels.at(m.from)
          drop labels.at(m.to)
        | labels.map (\ l=nat (? (eq l drop) keep l))
    + titles
      ' What each standing is called, read once.
      \ standings=row[[iota safe]] i=nat names=row[str] next={\ row[str]}view_plan
      ^ view_plan
      ? (eq i standings.len) (next names)
      = [key source] standings.at(i)
      | ./need (view_read (graph/op/at source [] .x) (view_select/slots [['name] ['heading] ['title]]))
        \ named=res[axal[myth]]
        ^ view_plan
        = title=str
            > (./known tree) named ""
            | graph/view/title tree.fil.fall(myth/new)
        | graph/overlay/titles standings i.inc names.snoc(title) next
    + chain
      ' The names from a reached name back toward its standing, each with
      ' the label it was reached by, nearest first; the standing itself is
      ' where the chain ends and is not included.
      \ reach=axal[graph/overlay/reached] start=path most=nat
      ^ row[[path path]]
      % cur=path start out=row[[path path]] [] n=nat 0
      ^ row[[path path]]
      ? (ge n most) out
      ? (reach.get(cur))
       > (./some r)
         ? (eq r.from.len 0) out
         | _ r.from out.snoc([cur r.label]) n.inc
      out
    + routes
      ' How the standings of one component meet: for each meeting, the
      ' names from the walker's standing to the name it came from, the
      ' label it crossed, the name met at, and the names from there back
      ' to the standing that was there first.  routes/<k> {from, to, at,
      ' via, label}, beneath it a/<j> and b/<j> {at, label}, nearest the
      ' meeting first.
      \ standings=row[[iota safe]] labels=row[nat] label=nat root=path st=graph/overlay/state depth=nat output=axal[myth]
      ^ axal[myth]
      % k=nat 0 out=axal[myth] output m=nat 0
      ^ axal[myth]
      ? (eq m st.meetings.len) out
      = mt st.meetings.at(m)
      ? !(eq labels.at(mt.from) label) (_ k out m.inc)
      = [kf sf] standings.at(mt.from)
        [kt stt] standings.at(mt.to)
        rk=path ['routes ($u k)]
        rp root.weld(rk)
        record (myth/sing ['from] sf).put(['to] stt).put(['at] (safe 0 .x mt.at)).put(['via] (safe 0 .x mt.via)).put(['label] (pails/p mt.label))
        most (mul depth 2)
        a (graph/overlay/chain st.reach mt.via most)
        bb (graph/overlay/chain st.reach mt.at most)
        out out.put(rp record)
        out
          % j=nat 0 o=axal[myth] out
          ^ axal[myth]
          ? (eq j a.len) o
          = [nm lb] a.at(j)
            aj=path ['a ($u j)]
          | _ j.inc o.put(rp.weld(aj) (myth/sing ['at] (safe 0 .x nm)).put(['label] (pails/p lb)))
        out
          % j=nat 0 o=axal[myth] out
          ^ axal[myth]
          ? (eq j bb.len) o
          = [nm lb] bb.at(j)
            bj=path ['b ($u j)]
          | _ j.inc o.put(rp.weld(bj) (myth/sing ['at] (safe 0 .x nm)).put(['label] (pails/p lb)))
      | _ k.inc out m.inc
    + roots
      ' The virtual roots: for each component, how its standings meet
      ' (routes), then its standings' worlds unfolded beneath /<n>, one
      ' page per component so a standing reached inside another's
      ' unfolding is listed there, not opened again.
      \ standings=row[[iota safe]] names=row[str] labels=row[nat] distinct=row[nat] i=nat b=graph/world/bounds depth=nat st=graph/overlay/state mates=axal[row[safe]] output=axal[myth] cr=care relative=path select=view_select
      ^ view_plan
      ? (eq i distinct.len) (graph/view/result output cr relative select)
      = label distinct.at(i)
        root=path [($u i)]
        mine
          % j=nat 0 queue=row[graph/world/entry] [] out=axal[myth] output titles=row[str] []
          ^ [row[graph/world/entry] axal[myth] row[str]]
          ? (eq j standings.len) [queue out titles]
          ? !(eq labels.at(j) label) (_ j.inc queue out titles)
          = [key source] standings.at(j)
            name (graph/op/name source)
            at root.weld(name)
            record
              . (myth/sing ['at] source)
                put(['name] (pails/t names.at(j)))
                put(['key] (pails/p [key]))
                put(['world] (pails/t (graph/world/world name)))
                put(['standing] (pails/b .true))
            ' The standings judged the same as this one: its other representations, same/<k>.
            nothing=row[safe] []
            ms (mates.get(name)).fall(nothing)
            record
              % k=nat 0 r=myth record
              ^ myth
              ? (eq k ms.len) r
              = sk=path ['same ($u k)]
              | _ k.inc r.put(sk ms.at(k))
          = none=row[path] []
          | _ j.inc queue.snoc((graph/world/entry at source depth none .true)) out.put(at record) titles.snoc(names.at(j))
        [queue seeded titles] mine
        ' Every standing opens at its root; reached inside another's
        ' unfolding it is listed as seen, not opened again.
        all=row[path]
          % j=nat 0 out=row[path] []
          ^ row[path]
          ? (eq j standings.len) out
          = [key source] standings.at(j)
          | _ j.inc out.snoc((graph/op/name source))
        opened (graph/world/mark all (axal/new[nat] .none))
        ' A root is named by its standings: what the component is, read as a line.
        named seeded.put(root (myth/sing ['standings] (pails/n queue.len)).put(['name] (pails/t (str/join " · " titles))))
        start (graph/overlay/routes standings labels label root st depth named)
        whole=care .z
        top=path []
        all=view_select .all
      | graph/op/bind (graph/world/page queue opened start 0 b whole top all)
        \ unfolded=axal[myth]
        ^ view_plan
        | graph/overlay/roots standings names labels distinct i.inc b depth st mates unfolded cr relative select
    + get
      ' The overlay: the standings, what each contributes by its care,
      ' their titles, a walk over every reference, the components and
      ' islands, and one virtual root per component with its standings
      ' unfolded beneath.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      = written (graph/overlay/standings context)
      ? (eq written.len 0) (./fail "no standings: set /sys/tack or standing/<key> slots")
      ? (gt written.len 12) (./fail "at most 12 standings")
      = depth (context.nat_at(['depth] 3))
      ? ((gt depth 6) || (eq depth 0)) (./fail "depth: 1 to 6")
      = b (graph/world/bounds_of context)
      | graph/overlay/expand written 0 [] b.nodes
        \ expanded=row[[iota safe]]
        ^ view_plan
        | graph/overlay/fold expanded 0 [] (axal/new[path] .none) (axal/new[row[safe]] .none)
        \ standings=row[[iota safe]] mates=axal[row[safe]]
        ^ view_plan
        = seeded
            % i=nat 0 queue=row[graph/overlay/entry] [] reach=axal[graph/overlay/reached] (axal/new[graph/overlay/reached] .none)
            ^ [row[graph/overlay/entry] axal[graph/overlay/reached]]
            ? (eq i standings.len) [queue reach]
            = [key source] standings.at(i)
            | _ i.inc queue.snoc((graph/overlay/entry i source depth)) reach.put((graph/op/name source) (graph/overlay/reached i [] []))
          [queue reach] seeded
        | graph/overlay/titles standings 0 []
          \ names=row[str]
          ^ view_plan
          | graph/overlay/walk queue (graph/overlay/state reach [] 0) b.nodes
          \ st=graph/overlay/state
          ^ view_plan
          = labels (graph/overlay/components standings.len st.meetings)
            none=row[nat] []
            distinct
              | labels.fold none
                \ out=row[nat] l=nat
                ? (out.any((\ seen=nat (eq seen l)))) out
                | out.snoc l
            islands
              % i=nat 0 n=nat 0
              ^ nat
              ? (eq i distinct.len) n
              ? (eq (labels.filter((\ m=nat (eq m distinct.at(i))))).len 1) (_ i.inc n.inc)
              | _ i.inc n
            root
              . (myth/sing ['standings] (pails/n standings.len))
                put(['components] (pails/n distinct.len))
                put(['islands] (pails/n islands))
                put(['opened] (pails/n st.used))
          | graph/overlay/roots standings names labels distinct 0 b depth st mates (axal/new[myth] (./some root)) cr relative select
    + frontier
      ' One level of the overlay: depth 1.
      \ context=myth cr=care relative=path select=view_select
      ^ view_plan
      | graph/overlay/get context.put(['depth] (pails/n 1)) cr relative select
  +  by_name
    ' The definition a name under /weft/graph applies: a path names it, never
    ' a closure.
    \ name=iota
    ^ maybe[woven]
    ? (eq_iota name 'overlay) (./some (woven graph/overlay/get))
    ? (eq_iota name 'frontier) (./some (woven graph/overlay/frontier))
    ? (eq_iota name 'union) (./some (woven graph/union/get))
    .none
  +  names
    ' The names registered under /weft/graph, with what each is.
    ^ row[[iota str]]
    [['overlay "Standings (the input and standing/<key> slots; at x the record, at y its children too, at z everything beneath) as one picture: a virtual root per connected component, first how its standings meet (routes: the names from each standing to the name they met at, each hop labelled), then each unfolded as a world to /depth, slots forward, where it sits upward, what references it backward, every hop with its holder and world; a cell that reads a thing is a folder named after it, holding what it computes"]
     ['frontier "One level of the overlay"]
     ['union "What every world says about the input: facts by world, agreements, disagreements"]]
  +  record
    ' A record read whole at care x; a name nothing was written at reads as
    ' an empty record, which is a fact to draw, not a failure.
    \ name=iota title=str
    ^ myth
    | (myth/sing bond/weft (pails/q name)).put bond/lede (pails/t title)
  +  seeds
    ' The records seeded under /weft/graph: a folder, and one definition
    ' record per name.
    ^ row[[path myth]]
    = root=path ['weft 'graph]
      all graph/names
      first=row[[path myth]] [[root (myth/sing bond/lede (pails/t "Standard woven cells"))]]
    | all.fold first
      \ out [name title]
      | out.snoc [root.snoc(name) (graph/record name title)]

' --- wire_proto ---

' Protobuf framing primitives. Domain messages live in goo_app/wire.
' All length-delimited fields share BAT chunks; lengths are cached, not scanned.
+ wire_proto
  + varint
    \ n=nat
    ^ any
    ? (lt n 128) (bat_bytes n 1)
    | bat_cat (bat_bytes (add 128 (mod n 128)) 1) (wire_proto/varint (div n 128))
  + number
    \ tag=nat value=nat
    ^ any
    | bat_cat (wire_proto/varint (mul tag 8)) (wire_proto/varint value)
  + message
    \ tag=nat body=any
    ^ any
    | bat_concat [(wire_proto/varint (add (mul tag 8) 2)) (wire_proto/varint (bat_size body)) body]
  + text
    \ tag=nat value=str
    ^ any
    | wire_proto/message tag (bat_text (str/to_atom value))
  + fixed64
    \ tag=nat bits=nat
    ^ any
    | bat_cat (wire_proto/varint (add (mul tag 8) 1)) (bat_bytes bits 8)
  + envelope
    \ tag=nat body=any
    ^ any
    | bat_cat (wire_proto/number 1 2) (wire_proto/message tag body)
  + failure
    \ why=str
    ^ any
    | wire_proto/envelope 7 (wire_proto/text 1 why)
