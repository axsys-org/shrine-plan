  ?  nd
   > (./prose text=nat as=row[sattr])
     (put_attrs as (myth/new).put(['kind] (pails/t "prose")).put(['text] (pails/t (str/from_atom text))))
   > (./ref p=row[nat] as=row[sattr])
     (put_attrs as (myth/new).put(['kind] (pails/t "ref")).put(['ref] (pails/p (seg_iotas p))))
   > (./lit lang=nat as=row[sattr] body=nat)
     (put_attrs as (myth/new).put(['kind] (pails/t "lit")).put(['lang] (pails/t (str/from_atom lang))).put(['body] (pails/t (str/from_atom body))))
   > (./item lead=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "item")).put(['lead] (pails/t (str/from_atom lead))))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "quote")).put(['lead] (pails/t (str/from_atom lead))))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     (put_attrs as (myth/new).put(['kind] (pails/t "sect")).put(['title] (pails/t (str/from_atom title))))
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     =  t
          ?  (eq 0 id.len)
             (myth/new).put(['kind] (pails/t "doc"))
          (myth/new).put(['kind] (pails/t "doc")).put(['id] (pails/p (seg_iotas id)))
     (put_attrs as t)
+  myths_kids
  '  A node row as numbered children of root, preorder.
  \  root=path ns=row[snode]
  ^  row[smount]
  %    i=nat 0    out=row[smount] []
  ^  row[smount]
  ?  (ge i ns.len)
     out
  (_ i.inc out.weld((node_mounts root.snoc(($u i)) ns.at(i))))
+  node_mounts
  '  One node and its subtree as namespace writes: the node's own
  '  record first (parents before kids), then the kids numbered in
  '  document order — ordering survives as path order.
  \  at=path nd=snode
  ^  row[smount]
  =  own  [(smount at (node_myth nd))]
  ?  nd
   > (./doc id=row[nat] as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./sect title=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./item lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./quote lead=nat as=row[sattr] kids=row[snode])
     own.weld((myths_kids at kids))
   > (./lit lang=nat as=row[sattr] body=nat)
     own
   > (./ref p=row[nat] as=row[sattr])
     own
   > (./prose text=nat as=row[sattr])
     own
+  myths
  '  The compiled tree as namespace writes rooted wherever the
  '  mounter chooses — the root is a parameter, never the document's
  '  business.  Make them in order and the document is namespace
  '  data: browsable in the explorer, watchable through crews,
  '  scrubbed by /h like everything else.
  \  root=path ns=row[snode]
  ^  row[smount]
  (myths_kids root ns)
+  reserved_slot
  '  The slots the node forms own, plus explicit machinery: everything
  '  else on a record reads back as an attribute.
  \  s=path
  ^  bool
  ?  (eq 0 s.len)
     .true
  ?  (slot_presentation/machinery s)
     .true
  ?  (gt s.len 1)
     .false
  ?  (eq_iota s.at(0) 'kind)
     .true
  ?  (eq_iota s.at(0) 'title)
     .true
  ?  (eq_iota s.at(0) 'lead)
     .true
  ?  (eq_iota s.at(0) 'text)
     .true
  ?  (eq_iota s.at(0) 'lang)
     .true
  ?  (eq_iota s.at(0) 'body)
     .true
  ?  (eq_iota s.at(0) 'ref)
     .true
  ?  (eq_iota s.at(0) 'id)
     .true
  .false
+  sval_back
  '  A slot pail back to an attribute value, when it reads as one.
  '  An EMPTY text pail reads back as no value: it is what a
  '  valueless ;@ mounts as, and the sweep value a withdrawn
  '  attribute melds down to — either way, not a value.
  \  pl=pail
  ^  maybe[sval]
  ?  pl
   > tp=pails/t
     ?  (eq 0 tp.t)
        .none
     (./some (sval/word tp.t))
   > pp=pails/p  (./some (sval/ref (seg_texts pp.p)))
  .none
+  attrs_back
  '  A record's non-reserved slots as attributes — the inverse of
  '  /put_attrs .
  \  t=myth
  ^  row[sattr]
  =  entries  t.tap
  %    i=nat 0    out=row[sattr] []
  ^  row[sattr]
  ?  (ge i entries.len)
     out
  =  e  entries.at(i)
  ?  (reserved_slot e.key)
     (_ i.inc out)
  ?  (sval_back e.val)
   > (./some v=sval)
     (_ i.inc out.snoc((sattr (seg_texts e.key) [v])))
   > .none  (_ i.inc out)
+  kid_nodes
  '  The numbered kids of a hydrated subtree, in document order, as
  '  nodes.  Non-numeric kids (a /kook subtree, say) are not part of
  '  the document.
  \  fat=axal[myth]
  ^  row[snode]
  =  kids  fat.kid_tap
  %    i=nat 0    out=row[snode] []
  ^  row[snode]
  ?  (ge i kids.len)
     out
  =  e  kids.at(i)
  ?  e.key
   > ($u n=nat)
     ?  (node_back e.val)
      > (./some nd=snode)  (_ i.inc out.snoc(nd))
      > .none  (_ i.inc out)
  (_ i.inc out)
+  node_back
  '  A namespace record back to a document node, when its ['kind]
  '  names one — the inverse of /node_myth .
  \  fat=axal[myth]
  ^  maybe[snode]
  ?  fat.fil
   > .none  .none
   > (./some t=myth)
     =  k  (myth/txt_at ['kind] t)
     =  as  (attrs_back t)
     ?  (eq k "prose")
        (./some (snode/prose (myth/txt_at ['text] t) as))
     ?  (eq k "lit")
        (./some (snode/lit (myth/txt_at ['lang] t) as (myth/txt_at ['body] t)))
     ?  (eq k "ref")
        =  rp=row[nat]
             ?  t.get(['ref])
              > (./some pl=pail)
                ?  pl
                 > pp=pails/p  (seg_texts pp.p)
                []
              > .none  []
        (./some (snode/ref rp as))
     ?  (eq k "item")
        (./some (snode/item (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "quote")
        (./some (snode/quote (myth/txt_at ['lead] t) as (kid_nodes fat)))
     ?  (eq k "sect")
        (./some (snode/sect (myth/txt_at ['title] t) as (kid_nodes fat)))
     ?  (eq k "doc")
        =  did=row[nat]
             ?  t.get(['id])
              > (./some pl2=pail)
                ?  pl2
                 > pp2=pails/p  (seg_texts pp2.p)
                []
              > .none  []
        (./some (snode/doc did as (kid_nodes fat)))
     .none
+  nodes_of
  '  A hydrated subtree as document nodes: a record that IS a node
  '  renders itself (deep targets), anything else renders its
  '  numbered kids — the inverse of /myths .
  \  fat=axal[myth]
  ^  row[snode]
  ?  (node_back fat)
   > (./some nd=snode)  [nd]
   > .none  (kid_nodes fat)
+  render_fat
  '  A hydrated subtree rendered with mount-relative paths that
  '  match the namespace: a record that IS a node renders itself AT
  '  the mount root (rel "."), anything else renders its numbered
  '  kids at their own numbers — so a w-edit rel path is exactly the
  '  edited record's path under the mount.
  \  fat=axal[myth]
  ^  row[weft/node]
  ?  (node_back fat)
   > (./some nd=snode)  [(render_node [] nd)]
   > .none  (render_nodes [] (kid_nodes fat))
+  view_page
  '  A hydrated subtree served as its page: parse nothing, render
  '  whatever is committed — the namespace is the document.
  \  fat=axal[myth]
  ^  nat
  (page (nodes_of fat))
+  remount
  '  A parsed forest as the hydrated subtree its /myths writes would
  '  build: every mount put at its numbered path, no root record —
  '  node_back's bench, and the raw material of an app's sync law.
  \  ns=row[snode]
  ^  axal[myth]
  (myths_kids [] ns).fold((axal/new[myth] .none) (\ acc m acc.put(m.p m.t)))
+  split_lines
  '  Every newline-separated run, empties KEPT — unlike /split_byte,
  '  which drops them: a literal body's blank lines must survive as
  '  0 entries.
  \ s=nat
  ^ row[nat]
  ? (eq s 0) []
  | cord/split_byte 10 s
+  joined_all
  '  Compatibility name for the shared balanced join.
  '  ?=  ((joined_all 32 ["a" "b"]) "a b")
  \ b=nat xs=row[nat]
  ^ nat
  | cord/join b xs
+  clean_text
  '  Inline text made line-safe: newline and carriage-return runs
  '  collapse to single spaces (parse joins paragraph lines with
  '  spaces anyway).  Rune-shaped text cannot be escaped — semidoc
  '  has no escape — so /unparse is normalizing, not injective.
  \  t=nat
  ^  nat
  (joined 32 (split_byte 13 (joined 32 (split_byte 10 t))))
+  tok_text
  '  One attribute value as source text: words as written, references
  '  as glued ;/paths — the inverse of /val_of .
  '  ?=  ((tok_text (sval/ref ["people" "liam"])) ";/people/liam")
  \  v=sval
  ^  nat
  ?  v
   > (./word t)  t
   > (./ref p)   (cord/cat ";" (pred_text p))
+  attr_line
  '  One attribute line at an indent: ;@ then the canonical
  '  predicate, then each value token.  A valueless attribute closes
  '  bare.
  \  ind=nat a=sattr
  ^  nat
  =  head=row[nat]  [(spaces ind) ";@ " (pred_text a.pred)]
  (cord/cat_all head.weld(a.vals.bind((\ v [" " (tok_text v)]))))
+  head_line
  '  A node's opening line at an indent: the rune, then the payload
  '  when there is one — empty payloads close the rune bare, exactly
  '  the forms /rune_of admits.  A ref glues its path; prose is its
  '  text alone.
  \  ind=nat nd=snode
  ^  nat
  =  pre  (spaces ind)
  ?  nd
   > (./doc id _ _)
     ?  (eq 0 id.len)
        (cord/cat pre ";.")
     (cord/cat_all [pre ";. " (pred_text id)])
   > (./sect title _ _)
     ?  (eq 0 (cord/len title))
        (cord/cat pre ";=")
     (cord/cat_all [pre ";= " (clean_text title)])
   > (./item lead _ _)
     ?  (eq 0 (cord/len lead))
        (cord/cat pre ";-")
     (cord/cat_all [pre ";- " (clean_text lead)])
   > (./quote lead _ _)
     ?  (eq 0 (cord/len lead))
        (cord/cat pre ";>")
     (cord/cat_all [pre ";> " (clean_text lead)])
   > (./lit lang _ _)
     ?  (eq 0 (cord/len lang))
        (cord/cat pre ";$")
     (cord/cat_all [pre ";$ " (clean_text lang)])
   > (./ref p _)
     (cord/cat_all [pre ";" (pred_text p)])
   > (./prose text _)
     (cord/cat pre (clean_text text))
+  lit_lines
  '  A literal payload re-indented under its opener: every body line
  '  shifted right to the kid indent, blank entries (0) as truly
  '  empty lines.  The exact inverse of /lit_body: parse takes every
  '  blank-or-deeper line, dedents non-blanks to their minimum
  '  indent — exactly the kid indent here, since a parse-produced
  '  body's own minimum indent is 0 — reads blanks back as 0, and
  '  trims trailing blanks, which this emit never produces.
  \  ind=nat body=nat
  ^  row[nat]
  ?  (eq 0 body)
     []
  (split_lines body).map((\ l (if (eq 0 (cord/len l)) 0 (cord/cat (spaces ind) l))))
+  attrs_of
  '  Every variant's decorating attributes.
  \  nd=snode
  ^  row[sattr]
  ?  nd
   > (./doc _ as _)    as
   > (./sect _ as _)   as
   > (./item _ as _)   as
   > (./quote _ as _)  as
   > (./lit _ as _)    as
   > (./ref _ as)      as
   > (./prose _ as)    as
+  emit_node
  '  One node as source lines at depth d: its attribute lines, its
  '  opening line, then its payload — a literal body re-indented
  '  under the opener, container kids one level deeper.
  \  d=nat nd=snode
  ^  row[nat]
  =  ind  (mul 2 d)
  =  base  (attrs_of nd).map((attr_line ind)).snoc((head_line ind nd))
  ?  nd
   > (./lit _ _ body)    base.weld((lit_lines (add ind 2) body))
   > (./doc _ _ kids)    base.weld((emit_kids d.inc kids))
   > (./sect _ _ kids)   base.weld((emit_kids d.inc kids))
   > (./item _ _ kids)   base.weld((emit_kids d.inc kids))
   > (./quote _ _ kids)  base.weld((emit_kids d.inc kids))
  base
+  emit_kids
  '  Sibling blocks one level deeper: each block's lines, one blank
  '  line before each — the seed sources' own layout.
  \  d=nat ns=row[snode]
  ^  row[nat]
  ns.bind((\ nd (emit_node d nd).cons(0)))
+  unparse
  '  A node row as canonical semidoc source — the inverse of /parse
  '  up to normalization: two-space indent steps, one blank line
  '  between sibling blocks, attribute lines glued above their node,
  '  no trailing newline.  Laws: (parse (unparse ns)) equals ns
  '  whenever ns is parse's own image (or node_back's over
  '  expand-written records), and unparse-of-reparse is a fixpoint
  '  from the first regeneration on.  Content the line grammar
  '  cannot carry — embedded newlines, rune-shaped prose, a
  '  leading-blank literal line — normalizes rather than escapes:
  '  semidoc has no escape.
  \  ns=row[snode]
  ^  nat
  ?  (eq 0 ns.len)
     0
  =  blocks  ns.map((emit_node 0))
  =  lines
       %    i=nat 1    out=row[nat] blocks.at(0)
       ^  row[nat]
       ?  (ge i blocks.len)
          out
       (_ i.inc out.snoc(0).weld(blocks.at(i)))
  (joined_all 10 lines)

' --- source_mount ---

' A source scan is retained even when its publication fails.
+ source_mount
  + failure
    : message=str cause=any
  + spec
    : name=str manifest=str
  + status
    : epoch=nat ready=bool message=str publication=nat
  + image
    : modules=any
  + ports
    : publish={\ path namespace}either[pail namespace]
  + slot
    \ name=iota
    ^ path
    | system_vocabulary/source_slot name
  + crash
    \ state=namespace message=str
    ^ namespace
    ; (error (pails/t message))
    state
  + record
    \ home=path state=namespace
    ^ myth
    | (sovereign_peek home state).fil.fall(myth/new)
  + write
    \ home=path record=myth state=namespace
    ^ namespace
    = request (helm/card/step home (writ/poke record))
    = [next reply]
        (helm/supervisor/handle request state)
    > (./ack ack) reply
      (source_mount/crash state "Invalid mount reply")
    ? (maybe/is_some ack)
      (source_mount/crash state "Mount record write rejected")
    next
  + images
    \ home=path state=namespace
    ^ maybe[any]
    . (source_mount/record home state)
      get((source_mount/slot 'image))
      then(source_mount/image/try_from_pail)
      run(source_mount/image/modules)
  + save_images
    \ home=path images=any state=namespace
    ^ namespace
    = value (source_mount/image images)
    = record (myth/sing (source_mount/slot 'image) value)
    | source_mount/write home record state
  + snapshot
    ' Missing files stay in history but never enter compiler input.
    \ home=path state=namespace
    ^ row[[str nat]]
    = record (source_mount/record home state)
    > (./some held) record.get(bond/res) []
    > report=fs/report held []
    = tree
        % idx=nat 0 out=axal[nat] (axal/new[nat] .none)
        ^ axal[nat]
        ? (eq idx report.known.len) out
        = name report.known.at(idx)
        ? (report.missing.has(name)) (_ idx.inc out)
        = path (report.target.snoc(($ta name)))
        = item (source_mount/record path state)
        | _ idx.inc out.put([($ta name)] item.nat_at(bond/content 0))
    | row/map[[path nat] [str nat]]
      (\ [key bytes] [(str/from_atom (quip_val key.at(0))) bytes])
      tree.tap
  + status_at
    \ home=path state=namespace
    ^ source_mount/status
    . (source_mount/record home state)
      get((source_mount/slot 'status))
      then(source_mount/status/try_from_pail)
      fall((source_mount/status 0 .false "Not scanned" 0))
  + status_record
    \ status=source_mount/status
    ^ myth
    . (myth/sing (source_mount/slot 'status) status)
      put((source_mount/slot 'epoch) (pails/n status.epoch))
      put((source_mount/slot 'ready) (pails/n (? status.ready 1 0)))
      put((source_mount/slot 'message) (pails/t status.message))
      put((source_mount/slot 'publication) (pails/n status.publication))
  + reconcile_one
    \ ports=source_mount/ports home=path state=namespace
    ^ namespace
    = record (source_mount/record home state)
    = prior (source_mount/status_at home state)
    > (./some held) record.get(bond/res) state
    ? held
     > failure=fs/failure
      ? !(gt failure.epoch prior.epoch) state
      = status (source_mount/status failure.epoch .false
          failure.reason prior.publication)
      | source_mount/write home
        (source_mount/status_record status) state
    > report=fs/report held state
    ? !(gt report.epoch prior.epoch) state
    = files (source_mount/snapshot home state)
    = fingerprint (pin files)
    = old (record.get((source_mount/slot 'snapshot)))
    = same
        > (./some held) old .false
        > saved=pails/code held .false
        | equal saved.v fingerprint
    = publish ports.publish
    = result=either[pail namespace]
        ? same (./ok state)
        < published (publish home state)
        ? (sovereign_reconcile state published 0 0)
         > (./ok next) (./ok next)
         > (./err why) (./err (pails/t (path_show [why])))
    = next
        ? result
         > (./ok updated) updated
         > (./err _) state
    = status
        ? result
         > (./ok _)
          (source_mount/status report.epoch .true "Published"
            (? same prior.publication next.local.top))
         > (./err why)
          (source_mount/status report.epoch .false
            "Publication failed; inspect diagnostic" prior.publication)
    = update (source_mount/status_record status)
    = update
        ? result
         > (./ok _)
          . update
            put((source_mount/slot 'snapshot) (pails/code fingerprint))
            put(mount_assets/slot (mount_assets/publish
              record.txt_at(grove_dev/metadata_slot) files))
            put((source_mount/slot 'diagnostic) (pails/t ""))
            put((source_mount/slot 'diagnostic_text) (pails/t ""))
         > (./err why)
          update.put((source_mount/slot 'diagnostic) why).put((source_mount/slot 'diagnostic_text)
            (pails/t (str/from_atom (show/pail why))))
    | source_mount/write home update next
  + reconcile
    \ ports=source_mount/ports homes=row[path] state=namespace
    ^ namespace
    | homes.fold state
      \ state=namespace home=path
      | source_mount/reconcile_one ports home state
  + handle
    \ ports=source_mount/ports homes=row[path]
      card=helm/card state=namespace
    ^ [namespace feet/task[unit]]
    = [next reply]
        (helm/supervisor/handle card state)
    = updated
        ? card
         > (./step _ _)
          (source_mount/reconcile ports homes next)
        next
    [updated reply]
  + access
    \ ports=source_mount/ports homes=row[path]
    ^ helm/supervisor/access[namespace]
    | helm/supervisor/access/set_handle[namespace]
      (source_mount/handle ports homes)
      helm/supervisor/local_access
  + rescan
    \ ignored=myth current=myth
    ^ myth
    . current
      put(bond/epoch (pails/n current.nat_at(bond/epoch 0).inc))
      put(bond/pending (pails/b .true))
  + mount_key
    ' Mount names may contain hyphens, which are bare text rather than symbols.
    \ name=str
    ^ iota
    > (./some parts) (path_parse (str/cat_all ["/" name])) ($ta name)
    ? (eq parts.len 1) parts.at(0)
    | $ta name
  + load
    \ reader={\ str}either[str row[fs_read/file]]
      name=str folder=str manifest=str state=namespace
    ^ namespace
    = home=path [state.self 'io 'fs (source_mount/mount_key name)]
    = target (home.snoc('source))
    = base (fs/cfg folder target (fs/extensions (mop/empty))
        [state.self 'kook 'fs])
    = spec (source_mount/spec name manifest)
    = cfg base.put((source_mount/slot 'spec) spec).put(grove_dev/metadata_slot (pails/t manifest))
    = request (helm/card/step home (writ/make cfg))
    = [ready reply]
        (helm/supervisor/handle request state)
    > (./ack ack) reply
      (source_mount/crash state "Invalid mount reply")
    ? (maybe/is_some ack)
      (source_mount/crash state "Mount installation rejected")
    = operation
        | myth/sing system_vocabulary/op
          (op 'rescan 'host [] 'scan "Request a fresh source scan" source_mount/rescan)
    = [ready reply]
        | helm/supervisor/handle
          (helm/card/step home.weld(['op 'rescan]) (writ/make operation))
          ready
    = pending (source_mount/write home
        (myth/sing bond/pending (pails/b .true)) ready)
    = current (source_mount/record home pending)
    = ;scan (reader folder)
    > (./ok files) scan
      (source_mount/crash state "Mount scan failed")
    = batch (fs/batch current.nat_at(bond/epoch 0) current files)
    | source_mount/write home (myth/sing bond/res batch) pending
  + reload
    ' A kept world's mount, scanned again from the checkout this process
    ' started from: the saved records stay, the files and the published
    ' code come from now.  The rescan op's step, done once before serving:
    ' bump the epoch and mark pending, scan, write the batch, reconcile.
    \ reader={\ str}either[str row[fs_read/file]] ports=source_mount/ports
      name=str folder=str state=namespace
    ^ namespace
    = home=path [state.self 'io 'fs (source_mount/mount_key name)]
    = current (source_mount/record home state)
    = asked
        . (myth/sing bond/epoch (pails/n current.nat_at(bond/epoch 0).inc))
          put(bond/pending (pails/b .true))
    = pending (source_mount/write home asked state)
    = bumped (source_mount/record home pending)
    = ;scan (reader folder)
    ? scan
     > (./err why)
      ; (Trace ["Mount scan failed on resume" name why] 0)
      | source_mount/crash state "Mount scan failed on resume; a changed mount descriptor needs a fresh world"
     > (./ok files)
      = batch (fs/batch bumped.nat_at(bond/epoch 0) bumped files)
      = loaded (source_mount/write home (myth/sing bond/res batch) pending)
      | source_mount/reconcile_one ports home loaded
  + require_ready
    \ homes=row[path] state=namespace
    ^ namespace
    ? (homes.all((\ home=path (source_mount/status_at home state).ready))) state
    | source_mount/crash state "Initial mount publication failed"

' --- tmpl ---

'  tmpl: semidoc documents as namespace templates.  A template is an
'  ordinary semidoc source read as a LAYOUT: a nested ;. node's id
'  is its mount path relative to the instantiation root (named
'  nodes), everything un-named numbers beneath its nearest named
'  ancestor as document content, ;@ /doc/kook <ref> puts behavior
'  refs on a node's record (templates reference existing form cards,
'  never mint forms), and "."-headed reference values (;/./w/home)
'  rebase against the root at mount (pact/rebase_rec) so instances
'  are self-contained.  Instantiate host-side by wrapping tmpl/mani
'  in pact/card and vine-making it anywhere, or in-kernel by yelling
'  a make of tmpl/card at any path inside the caller's subtree.
'
'  Scope note: an instance is records, not a synced document — the
'  lifted kook refs live at /sys/limb (hidden from attrs_back), and
'  named kids are invisible to a parent's numbered kid walk, so
'  nenex-style whole-document sync does not apply to an instance as
'  a unit.  Each named node is an independent namespace citizen;
'  one that rode a nenex doc kook participates in nenex's per-page
'  machinery for its own numbered subtree.
+  tmpl
  +  kook_pred
    '  ["doc" "kook"] — the template behavior predicate.
    ^  row[nat]
    ["doc" "kook"]

  +  ref_val
    '  A ref attribute value as a path; words name nothing.
    \  v=sval
    ^  maybe[path]
    ?  v
     > (./ref p)   (./some (seg_iotas p))
     > (./word _)  .none

  +  doc_attr
    ' Behavior attributes are lifted into the limb. Explicit machinery
    ' slots are filtered; the authority prefix alone is not a classifier.
    \ a=sattr
    ^ bool
    ? (eq_rowcord a.pred tmpl/kook_pred) .false
    | !(slot_presentation/machinery (seg_iotas a.pred))

  +  split_kook
    '  A node split for mounting: the limb refs its /doc/kook
    '  attribute names (absolute, or "."-relative for the mount to
    '  weld), and the node itself carrying only the attributes that
    '  survive onto records.
    \  nd=snode
    ^  [refs=row[path] out=snode]
    =  as  (attrs_of nd)
    =  refs
         %    i=nat 0    acc=row[path] []
         ^  row[path]
         ?  (ge i as.len)
            acc
         =  a  as.at(i)
         ?  !(eq_rowcord a.pred tmpl/kook_pred)
            (_ i.inc acc)
         (_ i.inc acc.weld(a.vals.sift(tmpl/ref_val)))
    =  keep  as.keep(tmpl/doc_attr)
    =  nd2
         ?  nd
          > (./doc id _ kids)    (snode/doc id keep kids)
          > (./sect ti _ kids)   (snode/sect ti keep kids)
          > (./item ld _ kids)   (snode/item ld keep kids)
          > (./quote ld _ kids)  (snode/quote ld keep kids)
          > (./lit lg _ body)    (snode/lit lg keep body)
          > (./ref p _)          (snode/ref p keep)
          > (./prose tx _)       (snode/prose tx keep)
    [refs nd2]

  +  node_rec
    '  One template node's record: node_myth of the split node —
    '  slot layout identical to semidoc's own projection — with the
    '  limb slot attached when the node declared kook refs.
    \  nd=snode
    ^  myth
    =  [refs nd2]  (tmpl/split_kook nd)
    =  t  (node_myth nd2)
    ?  (eq 0 refs.len)
       t
    t.put(limb_slot (kook refs))

  +  named_id
    '  The mount path a node claims: a doc node's non-empty id —
    '  RELATIVE TO THE INSTANTIATION ROOT regardless of nesting
    '  depth.  Everything else is un-named content.
    \  nd=snode
    ^  maybe[path]
    ?  nd
     > (./doc id _ _)
       ?  (eq 0 id.len)
          .none
       (./some (seg_iotas id))
    .none

  +  kids_of
    '  A node's kid row; leaves have none.
    \  nd=snode
    ^  row[snode]
    ?  nd
     > (./doc _ _ kids)    kids
     > (./sect _ _ kids)   kids
     > (./item _ _ kids)   kids
     > (./quote _ _ kids)  kids
    []

  +  walk
    '  A node row as seeds, parents before kids.  Named docs mount
    '  at their root-relative id and recurse with the id as base;
    '  un-named nodes number consecutively with ($u n) under base,
    '  skipping named siblings (no numbering holes).  Named ($ts)
    '  and numbered ($u) segments can never collide; two nodes
    '  claiming one id collide silently — last in document order
    '  wins (an error channel is v2).  A named node's ['id] rides
    '  "."-relative, so the mount absolutizes it: an instance's id
    '  is its real mounted path, exactly as if authored in place.
    \  base=path ns=row[snode]
    ^  row[[p=path t=myth]]
    %    i=nat 0    n=nat 0    out=row[[p=path t=myth]] []
    ^  row[[p=path t=myth]]
    ?  (ge i ns.len)
       out
    =  nd  ns.at(i)
    ?  (tmpl/named_id nd)
     > (./some id)
       =  sub  (tmpl/walk id (tmpl/kids_of nd))
          rec  (tmpl/node_rec nd).put(['id] (pails/p (pact/rel id)))
       (_ i.inc n out.snoc([id rec]).weld(sub))
     > .none
       =  at  base.snoc(($u n))
       =  sub  (tmpl/walk at (tmpl/kids_of nd))
       (_ i.inc n.inc out.snoc([at (tmpl/node_rec nd)]).weld(sub))

  +  parts
    '  A parsed template split for mounting: the instance root's
    '  record and the seed row.  A single top-level doc node IS the
    '  root — its record with kook refs DROPPED (the root's behavior
    '  belongs to the mounter's pact limb) and its id riding as
    '  ['id] data, kids walked at base [].  Anything else gets a
    '  bare doc record as root and the whole row as kids.
    \  ns=row[snode]
    ^  [root=myth seeds=row[[p=path t=myth]]]
    =  bare  [(myth/new).put(['kind] (pails/t "doc")) (tmpl/walk [] ns)]
    ?  (eq 1 ns.len)
       =  hd  ns.at(0)
       ?  hd
        > (./doc _ _ kids)
          =  [refs nd2]  (tmpl/split_kook hd)
          [(node_myth nd2) (tmpl/walk [] kids)]
       bare
    bare

  +  seeds
    '  Source to seeds directly: parts, with the root record riding
    '  as the seed at [] — pact/seeds melds it onto the mount root.
    \  src=nat
    ^  row[[p=path t=myth]]
    =  [root ss]  (tmpl/parts (parse src))
    ss.cons([[] root])

  +  mani
    '  Host-side entry: template source as a mountable manifest — no
    '  kooks minted (templates only reference existing form cards),
    '  every record a seed.  pact/card this and vine-make it at any
    '  root; an empty source mounts an empty instance root.
    \  name=iota doc=lore src=nat
    ^  mani
    (mani name doc [] (tmpl/seeds src) [])

  +  mani_spec
    '  A template mani judged by its yoke: the seeds mount already
    '  carrying the contracts the spec assigns them (yoke/adopt),
    '  the wants row rides along as the app's driver asks, the
    '  extras — slot values a document cannot spell — meld onto
    '  their seeds (mani/put_seed, extras winning collisions), and
    '  the kooks row carries whatever behaviors the spec minted.
    \  name=iota doc=lore src=nat y=yoke wants=row[grant]
       extras=row[[p=path t=myth]] kooks=row[kook/decl]
    ^  mani
    (mani name doc kooks
          (yoke/adopt y extras.fold((tmpl/seeds src) mani/put_seed))
          wants)

  +  card
    '  In-kernel entry: the instantiation card for a template
    '  source.  A kook yells [[P (writ/make (tmpl/card S))]] with P
    '  inside its own subtree (the ingest jail: at or below here)
    '  and the pact form expands the whole instance at P in the
    '  same epoch.
    \  src=nat
    ^  myth
    =  [root ss]  (tmpl/parts (parse src))
    (pact/vine_card 0 "" [] [] root ss)

  +  vine
    '  The instantiation as a top-level task (host or test driver).
    \  pax=path src=nat
    ^  task
    (./vine pax (writ/make (tmpl/card src)))

  +  help_kids
    '  Worker for /doc_kids : the help quote alone.
    \  l=lash
    ^  row[snode]
    ?  (eq 0 l.help)
       []
    [(snode/quote l.help [] [])]

  +  doc_kids
    '  A spec'd name's documentation as template content: the lede
    '  as a prose kid, the help as a quote lead.  Zero fields render
    '  nothing.
    \  l=lash
    ^  row[snode]
    ?  (eq 0 l.lede)
       (tmpl/help_kids l)
    (tmpl/help_kids l).cons((snode/prose l.lede []))

  +  fil_docs
    '  A spec node's own documentation kids, when it has a lash.
    \  s=soma
    ^  row[snode]
    >  (./some l) s.fil
        []
    (tmpl/doc_kids l)

  +  sub_kids
    '  A spec node's rendered kids: its docs, then its arms.
    \  base=path s=soma
    ^  row[snode]
    (tmpl/fil_docs s).weld(s.kids.map((tmpl/arm_node base)))

  +  arm_node
    '  One spec arm as a template node.  A text lit mounts NAMED at
    '  its root-relative path; any other lit renders un-named and
    '  mounts positionally; a var renders ONE exemplar un-named node
    '  standing for any number of matching kids.  A named lit under
    '  a var arm gets a base that skips the var level — a pattern
    '  the template grammar cannot say; the yoke stays authoritative.
    \  base=path a=soma/arm
    ^  snode
    ?  a.pat
     > (./lit i)
       =  at  base.snoc(i)
       ?  (is_text i)
          (snode/doc (seg_texts at) [] (tmpl/sub_kids at a.sub))
       (snode/doc [] [] (tmpl/sub_kids at a.sub))
     > (./var _)
       (snode/doc [] [] (tmpl/sub_kids base a.sub))

  +  dep_attrs
    '  Every dependency as a /doc/kook attribute line: a fief names
    '  no mount site, so all deps ride the root node.  "."-relative
    '  refs pass through — they rebase at mount (pact/rebase_rec).
    \  deps=axal[fief]
    ^  row[sattr]
    deps.tap.map((\ [p _] (sattr tmpl/kook_pred [(sval/ref (seg_texts p))])))

  +  render
    '  The template source for a yoke: a scaffold document, the
    '  spec-first inverse of authoring.  A spec carries typing, not
    '  content, so records render only docs and kook refs; every
    '  node is a doc node (a lash cannot pin the ['kind] VALUE); a
    '  var arm renders one exemplar.  The single top-level un-named
    '  doc IS the instance root (tmpl/parts) — note parts DROPS root
    '  kook refs at instantiation (the mounter's pact limb owns root
    '  behavior), so root deps are source documentation, not a
    '  mounted limb.
    \  y=yoke
    ^  nat
    =  kids  (tmpl/doc_kids y.self).weld(y.kids.map((tmpl/arm_node [])))
    (unparse [(snode/doc [] (tmpl/dep_attrs y.deps) kids)])

' --- goo_bounded ---

' Bounded, owner-free materialisation shared by surface preparation adapters.
+ goo_bounded
  + repetition
    : items=row[path] hidden=nat
  + traversal
    : items=row[path] stop=str
  + repeat
    \ items=row[path] maximum=nat
    ^ either[str goo_bounded/repetition]
    ? (gt maximum 256) (./err (str/cat_all ["max " (nat/show maximum) " exceeds 256; an unbounded list is a topos, not a repeat"]))
    ' PROVISIONAL: keep max and report hidden count to the renderer profile.
    | ./ok (goo_bounded/repetition items.take((? (lt items.len maximum) items.len maximum)) (sub items.len maximum))
  + chain
    \ start=path via=path depth=nat state=namespace
    ^ either[str goo_bounded/traversal]
    ? (gt depth 16) (./err (str/cat_all ["depth " (nat/show depth) " exceeds 16"]))
    ' PROVISIONAL: a cycle is a runtime cut with a visible stop reason.
    % next=path start items=row[path] []
    ^ either[str goo_bounded/traversal]
    ? (items.has(next)) (./ok (goo_bounded/traversal items "cycle"))
    ? (ge items.len depth) (./ok (goo_bounded/traversal items "depth"))
    > (./some card) (sovereign_care .x next state).fil (./ok (goo_bounded/traversal items "missing"))
    = items items.snoc(next)
    > (./some next) card.path_at(via) (./ok (goo_bounded/traversal items "missing"))
    | _ next items
  + owner_free
    \ nodes=list[goo/node]
    ^ bool
    | nodes.all
      \ node=goo/node
      = owners=row[str] ["pane" "_pane_instance" "selection" "list" "list_tree" "diagram_tree" "follow" "deck" "patch" "operation"]
      | and !(owners.has(node.constructor)) (goo_bounded/owner_free node.children)

' --- goo_context ---

' Navigation lives in one ordinary namespace myth. No client owns a second
' accepted-position store. These types are also the standard hand's contract.
+ goo_context
  + slot
    : name=path kind=str pail_type=str writers=row[path] history=str
      dependencies=row[path] route=bool
  + declarations
    : slots=row[goo_context/slot] bridge=path
  + stamp
    ' Constructed by the installed bridge from a published binding, never decoded
    ' from a rich-text descriptor or from a client's claimed port string.
    : port=path order=nat writes=myth
  + clear
    : port=path order=nat slots=row[path]
  + traversal
    : index=nat
  + guard
    : slots=row[path]
  + history
    : entries=row[myth] index=nat orders=mop[path nat lt_pith]
  + member
    : source=path source_life=nat key=path subject=path life=nat expected=nat axis=care
  + location
    ' Read-only physical namespace location: records and structural/tombstone nodes.
    : subject=path life=nat state=str expected=nat
  + capture_location
    \ target=path state=namespace
    ^ either[str goo_context/location]
    ? !(target.len) (./ok (goo_context/location [] 0 "unknown" 0))
    ? (physical_read/namespace_read (physical_read/request target .none 'children .none 1) state)
     > (./err why) (./err (str/cat_all ["Cannot inspect location: " (str/from_atom (iota_show why))]))
     > (./ok page)
      = status=str
          ? (physical_read/record page.own)
           > (./known _) "live"
           > .null "tombstone"
           > .unknown "unknown"
      | ./ok (goo_context/location target (goo_context/lifetime target state) status (state.case(.x target)).fall(0))
  + location_stale
    \ value=goo_context/location state=namespace
    ^ bool
    ? (goo_context/capture_location value.subject state)
     > (./err _) .true
     > (./ok now) !(and (eq now.life value.life) (eq now.state value.state))
  + range
    : document=path revision=nat start=nat end=nat quote=str
  + edge
    : relation=path identity=path revision=nat left=path left_life=nat right=path right_life=nat
  + cell
    : row=goo_context/member column=path write_target=maybe[path]
  + set
    : keys=row[path]
  + unavailable
    : value=pail reason=str
  + config_slot
    ^ path
    ['sys 'goo 'context_declarations]
  + history_slot
    ^ path
    ['sys 'goo 'context_history]
  + intent_slot
    ^ path
    ['sys 'goo 'context_intent]
  + guard_slot
    ^ path
    ['sys 'goo 'context_guard]
  + type_matches
    \ kind=str value=pail
    ^ bool
    ? (eq kind "location") ?=(v=goo_context/location value)
    ? (eq kind "member") ?=(v=goo_context/member value)
    ? (eq kind "range") ?=(v=goo_context/range value)
    ? (eq kind "edge") ?=(v=goo_context/edge value)
    ? (eq kind "cell") ?=(v=goo_context/cell value)
    ? (eq kind "key") ?=(v=pails/t value)
    ? (eq kind "set") ?=(v=goo_context/set value)
    .false
  + values
    \ declarations=goo_context/declarations record=myth
    ^ myth
    | declarations.slots.fold myth/new
      \ values=myth slot=goo_context/slot
      > (./some held) record.get(slot.name) values
      | values.put(slot.name held)
  + declare
    \ slots=row[goo_context/slot] bridge=path
    ^ either[str goo_context/declarations]
    % rest=row[goo_context/slot] slots seen=row[path] []
    ^ either[str goo_context/declarations]
    ? !(rest.len) (./ok (goo_context/declarations slots bridge))
    = slot rest.at(0)
      kinds=row[str] ["address" "selection" "filter" "scope" "recipe"]
      types=row[str] ["member" "location" "range" "edge" "cell" "key" "set"]
    ? (seen.has(slot.name)) (./err "Duplicate context slot.")
    ? !(and slot.name.len (and (kinds.has(slot.kind)) (types.has(slot.pail_type)))) (./err "Invalid context slot kind or pail type.")
    ? !((eq slot.history "push") || (eq slot.history "replace")) (./err "Context history must be push or replace.")
    ? !(slot.writers.len) (./err "Context slot requires writer ports.")
    ? !(slot.dependencies.all((\ dep=path (and !(equal dep slot.name) (slots.any((\ other=goo_context/slot (equal dep other.name))))))))
      | ./err "Invalid context dependency."
    | _ rest.drop(1) seen.snoc(slot.name)
  + affected
    ' Transitively clear dependent values in the same myth replacement.
    \ declarations=goo_context/declarations writes=myth
    ^ row[path]
    % count=nat 0 names=row[path] writes.tap.map((\ entry entry.key))
    ^ row[path]
    ? (ge count declarations.slots.len) names
    = next=row[path]
        | declarations.slots.fold names
          \ names=row[path] slot=goo_context/slot
          ? (names.has(slot.name)) names
          ? !(slot.dependencies.any((\ dep=path names.has(dep)))) names
          | names.snoc(slot.name)
    ? (eq next.len names.len) next
    | _ count.inc next
  + reduce
    \ source=path cur=myth intent=goo_context/stamp
    ^ either[str myth]
    | goo_context/apply source cur intent.port intent.order intent.writes []
  + reduce_clear
    \ source=path cur=myth intent=goo_context/clear
    ^ either[str myth]
    | goo_context/apply source cur intent.port intent.order myth/new intent.slots
  + apply
    \ source=path cur=myth port=path order=nat writes=myth clears=row[path]
    ^ either[str myth]
    > (./some held) cur.get(goo_context/config_slot) (./err "Context declarations are missing.")
    > declarations=goo_context/declarations held (./err "Invalid context declarations.")
    ? !(equal source declarations.bridge) (./err "Context write has no authenticated bridge stamp.")
    > (./some held) cur.get(goo_context/history_slot) (./err "Context history is missing.")
    > history=goo_context/history held (./err "Invalid context history.")
    ? !(writes.tap.len || clears.len) (./err "Empty context intent.")
    = touched (clears.fold(writes (\ record=myth slot=path record.put(slot (pails/t "clear")))))
      changed (goo_context/affected declarations touched)
      cleared=either[str unit]
        % rest=row[path] clears
        ^ either[str unit]
        ? !(rest.len) (./ok [])
        = name rest.at(0)
          matches (declarations.slots.keep((\ slot=goo_context/slot (equal slot.name name))))
        ? !(eq matches.len 1) (./err "Undeclared context slot.")
        = slot matches.at(0)
        ? !(slot.writers.has(port)) (./err "Port is not permitted to clear this context slot.")
        ? (le order history.orders.gut(name 0)) (./err "Context intent was superseded.")
        | _ rest.drop(1)
      guarded=row[path]
        > (./some held) cur.get(goo_context/guard_slot) []
        > guard=goo_context/guard held []
        guard.slots
    ? (changed.any((\ slot=path guarded.has(slot)))) (./err "Departure refused; owner has dirty or pending work.")
    = checked=either[str unit]
        % rest=row[mop/kv[path pail]] writes.tap
        ^ either[str unit]
        ? !(rest.len) (./ok [])
        = entry rest.at(0)
          matches (declarations.slots.keep((\ slot=goo_context/slot (equal slot.name entry.key))))
        ? !(eq matches.len 1) (./err "Undeclared context slot.")
        = slot matches.at(0)
        ? !(slot.writers.has(port)) (./err "Port is not permitted to write this context slot.")
        ? !(goo_context/type_matches slot.pail_type entry.val) (./err "Context pail type mismatch.")
        ? (le order history.orders.gut(slot.name 0)) (./err "Context intent was superseded.")
        | _ rest.drop(1)
    < cleared cleared
    < checked checked
    = values (goo_context/values declarations cur)
      values (changed.fold(values (\ state=myth slot=path state.del(slot)))).meld(writes)
      next (declarations.slots.fold(cur (\ state=myth slot=goo_context/slot state.del(slot.name)))).meld(values)
      push (declarations.slots.any((\ slot=goo_context/slot (and (maybe/is_some (touched.get(slot.name))) (eq slot.history "push")))))
      entries=row[myth]
        ? push history.entries.take(history.index.inc).snoc(values)
        | history.entries.take(history.index).snoc(values)
      orders (changed.fold(history.orders (\ orders=mop[path nat lt_pith] name=path orders.put(name order))))
    | ./ok next.put(goo_context/history_slot (goo_context/history entries entries.len.dec orders))
  + command
    \ source=path cur=myth value=pail
    ^ either[str myth]
    ? value
     > intent=goo_context/stamp (goo_context/reduce source cur intent)
     > intent=goo_context/clear (goo_context/reduce_clear source cur intent)
     > intent=goo_context/traversal (goo_context/travel source cur intent.index)
    | ./err "Unknown context command."
  + talk
    \ context=bowl cur=myth add=myth
    ^ yell
    > (./some held) add.get(goo_context/intent_slot) (yell [] cur)
    ? (goo_context/command context.src cur held)
     > (./ok next)
      ' Talk output is committed as a merge by namespace dispatch. An explicit
      ' self replacement is needed for cleared/dependent slots to actually vanish.
      | yell [[context.here (writ/make next)]] cur
     > (./err _) (yell [] cur)
  + record
    \ declarations=goo_context/declarations behavior=path initial=myth
    ^ myth
    = record initial.put(goo_context/config_slot declarations)
      record record.put(goo_context/history_slot (goo_context/history [initial] 0 mop/empty))
    | record.put(limb_slot (kook [behavior]))
  + lifetime
    \ target=path state=namespace
    ^ nat
    > (./some history) state.history(target) 0
    | (history.ever_at(target)).x.lock.shape
  + alive
    \ target=path life=nat state=namespace
    ^ bool
    | and (and (gt life 0) (eq life (goo_context/lifetime target state))) (maybe/is_some (sovereign_care .x target state).fil)
  + validate_member
    \ value=goo_context/member state=namespace
    ^ either[str unit]
    ? !(and (state.permitted(value.subject)) (pith_prefix [state.self 'app] value.subject))
      | ./err "Captured subject is outside application authority."
    ? !(and (goo_context/alive value.source value.source_life state) (goo_context/alive value.subject value.life state))
      | ./err "Captured membership was removed or replaced."
    ? !(eq value.expected (state.case(.x value.subject)).fall(0))
      | ./err "Captured subject changed before admission."
    ' Namespace adapter only: key==subject is not the general member contract.
    ? !(and (equal value.key value.subject) (and (eq value.subject.len value.source.len.inc) (pith_prefix value.source value.subject)))
      | ./err "Capture is not a member of its finite source."
    | ./ok []
  + boundary
    \ text=str offset=nat
    ^ bool
    ? (gt offset text.len) .false
    ? (eq offset text.len) .true
    = byte text.at(offset)
    | !(and (ge byte 128) (lt byte 192))
  + validate_pail
    \ value=pail state=namespace
    ^ either[str unit]
    ? value
     > location=goo_context/location
      < current (goo_context/capture_location location.subject state)
      ? !(equal location current) (./err "Namespace location changed before admission.")
      | ./ok []
     > member=goo_context/member (goo_context/validate_member member state)
     > range=goo_context/range
      > (./some card) (sovereign_care .x range.document state).fil (./err "Range document is unavailable.")
      ? !(eq range.revision (state.case(.x range.document)).fall(0)) (./err "Range revision changed.")
      > (./some held) card.get(system_vocabulary/content) (./err "Range document has no text.")
      > text=pails/t held (./err "Range document requires its text provider.")
      ? !(and (lt range.start range.end) (and (goo_context/boundary text.t range.start) (goo_context/boundary text.t range.end)))
        | ./err "Invalid UTF-8 range boundaries."
      ? !(eq range.quote text.t.slice(range.start (sub range.end range.start))) (./err "Range exact quote differs.")
      | ./ok []
     > edge=goo_context/edge
      ? !(and (pith_prefix edge.relation edge.identity) !(equal edge.relation edge.identity)) (./err "Edge is outside its relation.")
      > (./some card) (sovereign_care .x edge.identity state).fil (./err "Edge is unavailable.")
      ? !(eq edge.revision (state.case(.x edge.identity)).fall(0)) (./err "Edge revision changed.")
      ? !(and (goo_context/alive edge.left edge.left_life state) (goo_context/alive edge.right edge.right_life state)) (./err "Edge endpoint was replaced.")
      ? !(and (equal card.path_at(['from]) (maybe/some[path] edge.left)) (equal card.path_at(['to]) (maybe/some[path] edge.right))) (./err "Edge endpoints differ.")
      | ./ok []
     > cell=goo_context/cell
      < row (goo_context/validate_member cell.row state)
      > (./some target) cell.write_target (./err "Aggregate row has no declared editable subject.")
      ? !(and cell.column.len (equal target cell.row.subject)) (./err "Cell write target differs from its row subject.")
      | ./ok []
     > key=pails/t (./ok [])
     > set=goo_context/set (./ok [])
    | ./err "Unknown context pail."
  + validate_intent
    ' Called at the trusted binding boundary before it emits the stamped write.
    \ intent=goo_context/stamp state=namespace
    ^ either[str unit]
    % rest=row[mop/kv[path pail]] intent.writes.tap
    ^ either[str unit]
    ? !(rest.len) (./ok [])
    < checked (goo_context/validate_pail rest.at(0).val state)
    | _ rest.drop(1)
  + stale
    ' Staleness depends on incarnation, not ordinary subject edits.
    \ value=pail state=namespace
    ^ bool
    ? value
     > location=goo_context/location (goo_context/location_stale location state)
     > m=goo_context/member !(and (goo_context/alive m.source m.source_life state) (goo_context/alive m.subject m.life state))
     > r=goo_context/range !(eq r.revision (state.case(.x r.document)).fall(0))
     > e=goo_context/edge
      | !(and (eq e.revision (state.case(.x e.identity)).fall(0)) (and (goo_context/alive e.left e.left_life state) (goo_context/alive e.right e.right_life state)))
     > c=goo_context/cell (goo_context/stale c.row state)
    .false
  + refresh
    ' Commit unavailable into the namespace, never silently rebind a follower.
    \ home=path state=namespace
    ^ either[iota namespace]
    > (./some card) (sovereign_care .x home state).fil (./err 'missing_context)
    > (./some held) card.get(goo_context/config_slot) (./err 'missing_context_declarations)
    > declarations=goo_context/declarations held (./err 'invalid_context_declarations)
    = next=myth
        | declarations.slots.fold card
          \ record=myth slot=goo_context/slot
          > (./some held) record.get(slot.name) record
          ? !(goo_context/stale held state) record
          | record.put(slot.name (goo_context/unavailable held "Captured value was removed, replaced or revised."))
    ? (equal next card) (./ok state)
    | grove_install/change home (writ/make next) state
  + travel
    \ source=path cur=myth index=nat
    ^ either[str myth]
    > (./some held) cur.get(goo_context/config_slot) (./err "Context declarations are missing.")
    > declarations=goo_context/declarations held (./err "Invalid context declarations.")
    ? !(equal source declarations.bridge) (./err "History requires the authenticated context bridge.")
    > (./some held) cur.get(goo_context/history_slot) (./err "Context history is missing.")
    > history=goo_context/history held (./err "Invalid context history.")
    ? (ge index history.entries.len) (./err "History destination is unavailable.")
    = guarded=bool
        > (./some held) cur.get(goo_context/guard_slot) .false
        > guard=goo_context/guard held .false
        | gt guard.slots.len 0
    ? guarded (./err "Departure refused; owner has dirty or pending work.")
    = next (declarations.slots.fold(cur (\ record=myth slot=goo_context/slot record.del(slot.name)))).meld(history.entries.at(index))
      order (history.orders.tap.fold(0 (\ n=nat entry (? (gt n entry.val) n entry.val)))).inc
      orders (declarations.slots.fold(history.orders (\ orders=mop[path nat lt_pith] slot=goo_context/slot orders.put(slot.name order))))
    | ./ok next.put(goo_context/history_slot (history.set_index(index).set_orders(orders)))
  + remove_edge
    ' The relationship alone is the receiver; endpoint cases are untouched.
    \ edge=goo_context/edge state=namespace
    ^ either[str namespace]
    < valid (goo_context/validate_pail edge state)
    ? (grove_install/change edge.identity .cull state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))

