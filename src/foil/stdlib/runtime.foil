- vanes
- stdlib/base [at=json_source]

' --- compiler_api ---

'  Descriptions exported by the host compiler. Values and cache images
'  stay opaque. Foil owns namespace paths and installation policy.
+  compiler_lore
  : present=bool head=text body=row[text]
    tests=row[[src=text want=text]]
+  compiler_entry
  : name=path value=any kind=text source=text lowered=bool
    doc=compiler_lore signature=maybe[type] law=text line=nat
    calls=row[path] callers=row[path]
+  compiler_module
  : name=path source=text doc=compiler_lore
    entries=row[compiler_entry] visible=row[path] image=any
+  compiler_seed
  & compiler_seed/ready compiler_seed/failed
  +  ready
    : state=namespace
  +  failed
    : command=task reason=iota

' --- boot_mirror ---

'  The compiler describes modules; Foil builds their namespace records.
+  boot_mirror
  +  node
    \ mirror_root=path module=path name=path
    ^ path
    mirror_root.weld(module).snoc(($u name.len)).weld(name)
  +  entry
    \ item=compiler_entry
    ^ myth
    = doc item.doc
      card
        | mirror/entry item.value item.kind item.source
          item.lowered doc.present doc.head doc.body doc.tests
      card
        | mirror/extras item.signature item.law
          item.calls item.callers card
    | root/ensure_title item.name card.put(['defline] (pails/n item.line))
  +  parts
    \ mirror_root=path item=compiler_module
    ^ [node=path doc=compiler_lore card=myth
       entries=row[[name=path card=myth]]]
    = node=path mirror_root.weld(item.name)
      doc item.doc
      entries=row[[name=path card=myth]]
        | item.entries.map
        \ ent
        ^ [name=path card=myth]
        [ent.name.cons(($u ent.name.len)) (boot_mirror/entry ent)]
      paths | entries.map (\ [name card] node.weld(name))
      card
        | mirror/src item.source doc.present doc.head
          doc.body doc.tests
      card card.meld((mirror/index paths))
      card card.put(['visible] (pails/ps item.visible))
      card card.put(['sub] (pails/code item.image))
    [node doc (root/ensure_title item.name card) entries]
  +  pairs
    \ mirror_root=path modules=row[compiler_module]
    ^ row[[name=path card=myth]]
    | modules.bind
    \ item
    = [node doc card entries] | boot_mirror/parts mirror_root item
    = children
        | entries.map
        \ [name value]
        [node.weld(name) value]
    = header=row[[name=path card=myth]] [[node card]]
    header.weld(children)
  +  tasks
    \ mirror_root=path description=text modules=row[compiler_module]
    ^ row[task]
    = children
        | (boot_mirror/pairs mirror_root modules).map
        \ [name card]
        | task/vine name (writ/make card)
    = head=row[task]
        [(task/vine mirror_root (writ/make (mirror/doc description)))]
    head.weld(children)
  +  batches
    \ mirror_root=path description=text modules=row[compiler_module]
    ^ row[task]
    = registry=path [mirror_root.at(0) 'kook 'pact]
      root
        | (mirror/doc description).put limb_slot
        | kook [registry]
      children
        | modules.map
        \ item
        = [node doc card entries] | boot_mirror/parts mirror_root item
        | pact/vine node doc.present doc.head doc.body
          doc.tests card entries
    = head=row[task] [(task/vine mirror_root (writ/make root))]
    head.weld(children)
  +  references
    \ mirror_root=path modules=row[compiler_module]
    ^ task
    = seeds
        | modules.bind
        \ item
        = [node doc card entries] | boot_mirror/parts mirror_root item
        | entries.map
        \ [name card]
        [node.drop(mirror_root.len).weld(name) card]
    | task/vine mirror_root
    | writ/poke
    | myth/sing pact/slot
    | mani 'refs (lore "" [] []) [] seeds []
  +  hydrate
    \ mirror_root=path modules=row[path] state=namespace
    ^ row[any]
    | modules.bind
    \ name
    ^ row[any]
    ? (sovereign_peek mirror_root.weld(name) state).fil
     > (./some card)
       ? card.pail_at(['sub])
        > (pails/code image) [image]
       []
    []
  +  seed
    \ commands=row[task] state=namespace
    ^ compiler_seed
    % index=nat 0 state=namespace state
    ^ compiler_seed
    ? (eq index commands.len) (./ready state)
    = command commands.at(index)
    ? (sovereign_run_event command 0 0 0 state)
     > (./fail reason) (./failed command reason)
     > (./ripe next _ _ _) | _ index.inc next
  +  names
    \ mirror_root=path groups=row[[module=path names=row[path]]]
    ^ row[[root=iota entries=row[path]]]
    = entries=row[[root=iota node=path]]
        | groups.bind
        \ [module names]
        | names.keep((\ name name.len)).map
        \ name
        [name.at(0) (boot_mirror/node mirror_root module name)]
      roots=path
        | entries.fold []
        \ roots [root node]
        ? roots.has(root) roots
        roots.snoc(root)
    | roots.map
    \ root
    [root entries.keep((\ [key node] (eq_iota key root))).map(
      (\ [key node] node))]
  +  index_tasks
    \ mirror_root=path groups=row[[root=iota entries=row[path]]]
    ^ row[task]
    | groups.map
    \ [root entries]
    | task/vine mirror_root.snoc('ns).snoc(root)
    | writ/make | mirror/index entries
  +  index_batch
    \ mirror_root=path groups=row[[root=iota entries=row[path]]]
    ^ task
    = seeds
        | groups.map
        \ [root entries]
        [[root] (mirror/index entries)]
    | pact/vine mirror_root.snoc('ns) 0 "" [] []
      (mirror/doc
        "every mirrored entry grouped by its source namespace root.")
      seeds
  +  fail_tasks
    \ mirror_root=path failures=row[[module=path reason=text]]
    ^ row[task]
    | failures.map
    \ [module reason]
    | task/vine mirror_root.weld(module)
    | writ/make | mirror/fail reason
  +  fixture
    \ name=text
    ^ bool
    ? (equal (cord/slice 0 4 name) "env_") .true
    ? (eq (cord/slice 0 6 name) "tests/") .true
    ? (eq (cord/slice 0 14 name) "test_fixtures/") .true
    = app_test=bool
        ? !(eq (cord/slice 0 5 name) "apps/") .false
        | eq (cord/slice (sub (cord/len name) 6) 6 name) "/tests"
    ? app_test .true
    = fixtures=row[text]
        ["app_test_world" "helm_ref_caller" "helm_ref_target" "mapuser"
         "mapuser_rev" "mapx" "vecapp" "perfbench"]
    fixtures.has(name)
  +  roster
    \ names=row[text]
    ^ row[text]
    | names.keep (\ name !(boot_mirror/fixture name))
  +  segments
    \ name=text
    ^ row[text]
    | str/split_byte 47 name
  +  ref_axes
    \ edges=row[[src=path dst=path]]
    ^ [out=axal[row[path]] in=axal[row[path]]]
    = empty | axal/new[row[path]] .none
    | edges.fold [empty empty]
    \ [out back] [src dst]
    [out.put(src out.gut(src []).snoc(dst))
     back.put(dst back.gut(dst []).snoc(src))]
  +  refs_of
    \ axes=[out=axal[row[path]] in=axal[row[path]]] node=path
    ^ [out=row[path] in=row[path]]
    = [out back] axes
    [out.gut(node []) back.gut(node [])]
  +  description
    ^ text
    | str/from_atom
    | cord/cat_all
    ["the boot image: the system's own compiled code. "
     "each kid of the configured mirror root is a module; f holds its source text in [src]; "
     "f/n/[...name] holds the entry declared at /[...name] "
     "(n path segments) - its kind in [kind], its own source in "
     "[src], and its compiled value in [code] when lowering "
     "produced one. entries also carry their rendered type in [ty] "
     "and, when reference mirroring is on, [calls]/[called_by] rows "
     "of mirror paths. ns/[root] groups every entry by source "
     "namespace root. a module that failed to compile carries "
     "[status] failed and its diagnostic in [err]. "
     "the mirror and behavior registry belong to the configured publisher. "
     "behavior references are fully qualified and resolve through the namespace reader. "
     "the pinned /sys publication supplies system definitions; /h supplies "
     "authority-local history, and /o and /x supply derived views."]

' --- boot_doctest ---

'  Test selection and publication are namespace operations in Foil.
'  Host ports supply evaluation, time, and exception containment.
+  doctest_work
  : target=path count=nat evaluate={\ nat}row[[i=nat pass=nat got=nat]]
+  doctest_ports
  : now={\ nat}nat
    attempt={\ {\ nat}compiler_seed}maybe[compiler_seed]
    failed={\ task}nat
+  boot_doctest
  +  tasks
    \ ports=doctest_ports work=row[doctest_work] state=namespace
    ^ row[task]
    | work.bind
    \ item
    ^ row[task]
    ? !(item.count) []
    > (./some version) (namespace/case .x item.target state) []
    = ;results (item.evaluate 0)
    = ;now (ports.now 0)
    = target item.target.snoc('dt)
      card | doctest/card now version results
      write=writ
        ? (namespace/case .x target state)
         > (./some _) (./poke card)
        | ./make card
    [(task/vine target write)]
  +  seed
    \ ports=doctest_ports commands=row[task] state=namespace
    ^ namespace
    | commands.fold state
    \ ;current=namespace command=task
    = invoke ports.attempt
      attempt
        | invoke
        \ _=nat
        | boot_mirror/seed [command] current
    = next=maybe[namespace]
        ? attempt
         > .none .none
         > (./some result)
           ? result
            > (./ready state) (./some state)
            > (./failed _ _) .none
    ? next
     > (./some state) state
    ; (ports.failed command)
    current

' --- boot_tools ---

' --- slot_documentation ---

' BEGIN GENERATED slot_documentation
' Generated from slots/system.slots.json by x/slot_catalog.py; edit the catalog.
+ slot_documentation
  + entries
    ^ row[[path str str]]
    [['/sys/about "About" "Subject described by this record."]
     ['/sys/author "Author" "Asserted author; unsigned scaffolding, not authentication."]
     ['/sys/called_by "Called by" "Incoming definition references."]
     ['/sys/calls "Calls" "Outgoing definition references."]
     ['/sys/codex/command "Codex command" "Command submitted to the Codex bridge."]
     ['/sys/codex/done "Codex done" "Command completion flag."]
     ['/sys/codex/kind "Codex kind" "Request or response kind."]
     ['/sys/codex/method "Codex method" "Protocol method name."]
     ['/sys/codex/ok "Codex ok" "Request success flag."]
     ['/sys/codex/payload "Codex payload" "Request payload."]
     ['/sys/codex/port "Codex port" "Bridge listening port."]
     ['/sys/codex/reply_error "Codex reply error" "Protocol error reply."]
     ['/sys/codex/reply_result "Codex reply result" "Protocol result reply."]
     ['/sys/codex/request_id "Codex request ID" "Protocol request identifier."]
     ['/sys/codex/resolved "Codex resolved" "Resolved reference results."]
     ['/sys/codex/result "Codex result" "Command result."]
     ['/sys/codex/sequence "Codex sequence" "Command sequence number."]
     ['/sys/codex/token "Codex token" "Bridge authentication token."]
     ['/sys/codex/ui_error "Codex UI error" "UI error text."]
     ['/sys/codex/ui_notice "Codex UI notice" "UI notice text."]
     ['/sys/codex/ui_serial "Codex UI serial" "UI update serial."]
     ['/sys/codex/unresolved "Codex unresolved" "References that could not be resolved."]
     ['/sys/content "Content" "Primary value at a name."]
     ['/sys/crew "Dependencies" "Committed local dependency bindings to cared paths."]
     ['/sys/dt "Doctest results" "Doctest case, execution time and results."]
     ['/sys/entries "Definitions" "Definitions exposed by a compiler module mirror."]
     ['/sys/epoch "Epoch" "Counter triggering actions or synchronization."]
     ['/sys/face "Presentation binding" "Preferred presentation: a path to a Goo pane receiving this record, or a legacy component constructor and cared scope."]
     ['/sys/form "Behavior" "Behavior implementation called through the limb chain."]
     ['/sys/from "Source" "Source from which this record is derived."]
     ['/sys/fs/extensions "File extensions" "File extension to behavior references for scanned files."]
     ['/sys/fs/source/assets "Source assets" "Captured asset bytes for a source mount."]
     ['/sys/fs/source/diagnostic "Source diagnostic" "Typed publication failure, cleared with empty text on success."]
     ['/sys/fs/source/diagnostic_text "Source diagnostic text" "Display text for a source publication failure."]
     ['/sys/fs/source/epoch "Scan epoch" "Most recently processed scan epoch."]
     ['/sys/fs/source/image "Module images" "Compiled module images retained for imports."]
     ['/sys/fs/source/manifest "Mount manifest" "JSON mount descriptor."]
     ['/sys/fs/source/message "Publication message" "Current source publication status message."]
     ['/sys/fs/source/publication "Publication epoch" "Namespace epoch of the last successful publication."]
     ['/sys/fs/source/ready "Publication readiness" "Whether the last source publication succeeded."]
     ['/sys/fs/source/snapshot "Source snapshot" "Pinned file snapshot and fingerprint used as compiler input."]
     ['/sys/fs/source/spec "Source mount specification" "Source mount name and manifest."]
     ['/sys/fs/source/status "Source status" "Typed scan epoch, readiness, message and publication epoch."]
     ['/sys/fs/target "Scan destination" "Nested crew key binding the scan destination."]
     ['/sys/goo/catalog "Goo catalog" "Available renderer and view catalog."]
     ['/sys/goo/constants "View constants" "Constants captured while lowering a Grove view."]
     ['/sys/goo/documentation_origin "Source inspection provenance" "Provenance notice for artifact-derived source inspection."]
     ['/sys/goo/inspection/capture "Observed capture" "Capture identity, parent and provenance notice. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/encounter "Observed encounter" "Observed browser session, revisions, selection and editing state. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/preparation "Observed preparation" "Observed layout, dimensions, scale, direction and profile. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/recipe "Observed recipe" "Observed view, role, slot, publication and source location. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/subject "Observed subject" "Observed subject, receiver and displayed/expected versions. Browser observation, not authoritative live state."]
     ['/sys/goo/normalized_source "Normalized source" "Normalized source read from a pinned compiler artifact."]
     ['/sys/goo/receipts "Action receipts" "Receipts retained by the Goo action runtime."]
     ['/sys/grove/action "Action schema" "Receiver and argument schema for a declared action."]
     ['/sys/grove/action_handler "Action handler" "Compiled action implementation."]
     ['/sys/grove/draft "Draft registration" "Draft, job slot, preview/public source and target, and prelude registration."]
     ['/sys/grove/like "Source norm" "Source norm from which a declaration derives."]
     ['/sys/grove/module "Module bundle" "Version, identity, prefix, exports and artifact of a compiled module."]
     ['/sys/grove/norm "Tree norm" "Path segment patterns and item role for a tree."]
     ['/sys/grove/role "Record role" "Declared fields and presence groups for a record."]
     ['/sys/grove/role_contract "Role constraints" "Compiled constraints for a role."]
     ['/sys/grove/seed "Tree seed" "Seed path and optional rule."]
     ['/sys/grove/sewn "Sewn contract" "Source and target norms with pinned schemas."]
     ['/sys/grove/source "Template source" "Template source version pinned on an installed instance."]
     ['/sys/grove/stencil "Creation stencil" "Published child creation interface."]
     ['/sys/grove/stencil_handler "Creation handler" "Typed pure implementation of a child creation stencil."]
     ['/sys/grove/template "Template" "Version and relative seed records of a reusable template."]
     ['/sys/grove/view "Published view" "Published view, fields, contract and lowering result."]
     ['/sys/help "Help" "Extended documentation as plain text or structured lore, including examples and doctests."]
     ['/sys/if_case "Write precondition" "On a make or a poke: the x case the writer read; the kernel admits the event only while the record is still at that case, strips the slot, and refuses the whole event as stale_case otherwise. Never present in a committed record."]
     ['/sys/lash "Record constraints" "Read, write and presence constraints for a record."]
     ['/sys/lede "Title" "Short title or description."]
     ['/sys/limb "Behavior references" "Behavior implementation references governing a record."]
     ['/sys/menu/closed "Menu closed" "Whether this namespace menu context has finished and its popup should close."]
     ['/sys/menu/commit "Menu transaction" "A namespace continuation applied atomically after an accepted menu action."]
     ['/sys/mold "Type" "Canonical type description of a published definition."]
     ['/sys/now "Current time" "Current time supplied by the runtime."]
     ['/sys/op "Operation" "An operation interface."]
     ['/sys/pending "Pending work" "Application-specific marker for waiting work."]
     ['/sys/req "Request" "Request on a driver-minted node."]
     ['/sys/res "Response" "Response from the serving behavior; presence signals completion."]
     ['/sys/slot/context_menu "Context menu" "A Goo menu view address, or a provider that opens a menu for the clicked namespace subject."]
     ['/sys/spec "Subtree contract" "Subtree contract used by a warden to constrain children."]
     ['/sys/src "Source text" "Textual source."]
     ['/sys/tack "Component dependency" "Pinned cared data dependency of a component attachment."]
     ['/sys/unreads "Unread indicator" "Reserved unread indicator; no current executable reader or writer."]
     ['/sys/version/block "Assertion block" "Block height of the latest assertion."]
     ['/sys/version/first "First record epoch" "Epoch of the first x version."]
     ['/sys/version/now "Assertion time" "Time of the latest assertion."]
     ['/sys/version/state "Record state" "Live or tombstone state of the queried node."]
     ['/sys/version/top "Sovereign epoch" "Current sovereign epoch."]
     ['/sys/version/x_data "Record data revision" "Node data revision counter."]
     ['/sys/version/x_shape "Record shape revision" "Node live-domain shape revision counter."]
     ['/sys/version/y_data "Frontier data revision" "Nearest record-bearing frontier data revision counter."]
     ['/sys/version/y_shape "Frontier shape revision" "Nearest record-bearing frontier live-domain shape revision counter."]
     ['/sys/version/z_data "Subtree data revision" "Whole subtree data revision counter."]
     ['/sys/version/z_shape "Subtree shape revision" "Whole subtree live-domain shape revision counter."]
     ['/sys/view/amended "Notes applied" "In an amend cell's context: how many notes were laid over the answer; stale notes are reported under /sys/view/note."]
     ['/sys/view/asking "Asking" "In an ask cell's context: the cell waits on a model's answer; says why (no answer yet, input moved, prompt or model changed)."]
     ['/sys/view/cycle "View cycle" "On a walked record: the branch returned to an ancestor and stopped."]
     ['/sys/view/depth_limit "View depth limit" "On a walked record: the depth bound stopped the branch here."]
     ['/sys/view/fault "View fault" "In a cell's context: why the cell has no answer: a cycle, a culled or bad input, a live cell read at a pinned case, a bad expression."]
     ['/sys/view/missing "Missing parameter" "In a cell's context (/c/x): a parameter the formula asked for and did not get; the input passes through unchanged."]
     ['/sys/view/more "View more" "On a folder: how many members were not listed within the bound."]
     ['/sys/view/observations "View observations" "How many reads a woven cell made; each is a looks/<n> child of its context."]
     ['/sys/view/origin "View origin" "On a grafted record: the name the branch was taken from."]
     ['/sys/view/origins "View origins" "On a composed record: the names each world's contribution came from."]
     ['/sys/view/state "View state" "On a placement folder: whether its members are listed or opened."]
     ['/sys/view/status "View status" "Whether a woven cell's answer is ready, absent or unresolved (its context)."]
     ['/sys/view/steps "View steps" "Reads a woven cell made for its answer (its context)."]
     ['/sys/weft "Component constructor" "Component constructor used to render a record."]
     ['/sys/workbench/active "Active" "Namespace change workbench active."]
     ['/sys/workbench/adapter "Adapter" "Namespace change workbench adapter."]
     ['/sys/workbench/candidate "Candidate" "Namespace change workbench candidate."]
     ['/sys/workbench/command "Command" "Namespace change workbench command."]
     ['/sys/workbench/drafts "Draft revisions" "Protected source generations for the open change set."]
     ['/sys/workbench/expect "Expect" "Namespace change workbench expect."]
     ['/sys/workbench/fixture "Fixture" "Namespace change workbench fixture."]
     ['/sys/workbench/journal "Journal" "Namespace change workbench journal."]
     ['/sys/workbench/outputs "Outputs" "Namespace change workbench outputs."]
     ['/sys/workbench/owner "Owner" "Namespace change workbench owner."]
     ['/sys/workbench/policy "Policy" "Namespace change workbench policy."]
     ['/sys/workbench/registration "Registration" "Namespace change workbench registration."]
     ['/sys/workbench/review "Review" "Namespace change workbench review."]
     ['/sys/workbench/run "Run" "Namespace change workbench run."]
     ['/sys/workbench/source "Source" "Namespace change workbench source."]
     ['/sys/workbench/sources "Source units" "The independently owned source records in this target."]
     ['/sys/workbench/status "Status" "Namespace change workbench status."]
     ['/sys/workbench/targets "Targets" "Namespace change workbench targets."]
     ['/sys/workbench/tests "Tests" "Namespace change workbench tests."]
     ['/sys/workbench/time "Time" "Namespace change workbench time."]]
  + cards
    ^ axal[myth]
    = entries slot_documentation/entries
    | entries.fold (axal/new[myth] .none)
      \ out [name title summary]
      | out.put name ((myth/sing bond/lede (pails/t title)).put(bond/help (lore "" [summary] [])))
' END GENERATED slot_documentation

' --- compiler_publication ---

' Compiler products cross into the store only as a complete prepared batch.
+ compiler_publication
  + assign_system
    \ names=row[path]
    ^ pin[row[[path nat]]]
    = assigned
        | names.fold (axal/new[nat] .none)
          \ out name
          | out.put name 1
    | pin assigned.tap

  + publish
    \ slot=path who=iota
      defs=row[[name=path prior=nat mold=type image=pin[any] doc=row[[str row[str] row[[str str]]]]]]
      now=nat block=nat state=sov
    ^ either[iota sov]
    | compiler_publication/publish_with_docs slot who defs (axal/new[myth] .none) now block state

  + publish_with_docs
    \ slot=path who=iota
      defs=row[[name=path prior=nat mold=type image=pin[any] doc=row[[str row[str] row[[str str]]]]]]
      documentation=axal[myth] now=nat block=nat state=sov
    ^ either[iota sov]
    ? (eq slot.len 0) (./err 'invalid_artifact_slot)
    ? !(eq (aura_tag slot.at(0)) "x")
      | ./err 'invalid_artifact_slot
    ? (eq (quip_val slot.at(0)) 0)
      | ./err 'invalid_artifact_slot
    = names | defs.map (\ [name prior mold image doc] name)
    < batch (publication_batch/prepare who names state)
    = valid
        | defs.all
          \ [name prior mold image doc]
          > (./some current) batch.expected.get(name) .false
          | eq current prior
    ? !valid (./err 'stale_publication)
    = records
        | defs.fold (axal/new[myth] .none)
          \ out [name prior mold image doc]
          ? (documentation.dip(name)).fil
           > (./some seed) out.put(name (root/ensure_title name seed))
          = card | myth/sing system_vocabulary/mold (pails/ty mold)
          = card
              ? doc.len
                = [head body tests] doc.at(0)
                = body
                    ? body.len
                      ? (equal[str] body.at(0) head) body.drop(1)
                      body
                    body
                | card.put(system_vocabulary/lede (pails/t head)).put(system_vocabulary/help (lore "" body tests))
              card
          | out.put name (root/ensure_title name card.put(slot (pails/code image)))
    | publication_batch/publish_records records now block state batch

  + system
    ' System bootstrap uses the same complete assignment and commit path.
    ' No published artifact needs to contain the pin produced here.
    \ assigned=pin[row[[path nat]]] slot=path
      defs=row[[name=path prior=nat mold=type image=pin[any] doc=row[[str row[str] row[[str str]]]]]]
      now=nat block=nat
    ^ either[iota pin[system_publication]]
    < state
      | compiler_publication/publish_with_docs slot 'sys defs slot_documentation/cards now block sov/new
    ? !(equal assigned (system_publication/assigned state))
      | ./err 'system_definition_mismatch
    | ./ok (pin (system_publication state.top state assigned))

  + local
    ' Live definition publication participates in the namespace journal.
    ' The compiler retains the preassigned manifest, not a recursive pin
    ' of the publication containing its own artifacts. The journal keeps
    ' the complete trusted system publication pin.
    \ system=pin[row[[path nat]]] slot=path
      defs=row[[name=path prior=nat mold=type image=pin[any] doc=row[[str row[str] row[[str str]]]]]]
      now=nat block=nat state=namespace
    ^ either[iota namespace/committed]
    ? !(equal system (unpin state.system).definitions)
      | ./err 'system_publication_mismatch
    < checked
      | compiler_publication/publish slot state.self defs
          now block state.local
    = changes
        | defs.fold (axal/new[note] .none)
          \ out [name prior mold image doc]
          > (./known card) checked.x_latest(name) out
          | out.put name (note/make card)
    | namespace/step changes now block state

' --- grove_role_runtime ---

'  Stored, source-independent role shape. Codecs live in module exports.
+ grove_role_field
  : name=str slot=path optional=bool
+ grove_role_schema
  : fields=row[grove_role_field] need=row[row[path]]
+ grove_role_runtime
  + present
    \ need=row[row[path]] card=myth
    ^ bool
    | need.all
    \ group
    | group.any (\ slot card.has(slot))
  + spec
    \ fields=row[[path curb]] need=row[row[path]]
    ^ lash
    = types=curbs
        | fields.fold (mop/empty)
        \ out [slot type]
        | out.put slot type
    | lash types types need 0 0

+ grove_view_constants
  : values=myth

+ grove_action_handler
  : apply={\ myth myth}maybe[myth]

+ grove_action_schema
  : receiver=path arguments=grove_role_schema

' A stencil constructs a new record; its receiver is only the parent context.
' The admission boundary supplies Unix seconds, never the model arguments.
+ grove_stencil_handler
  : apply={\ nat myth myth}maybe[myth]
+ grove_stencil_schema
  : receiver=path result=path arguments=grove_role_schema

+ grove_norm_segment
  : name=str pattern=zeta
+ grove_norm_schema
  : segments=row[grove_norm_segment] item=grove_role_schema
+ grove_norm_runtime
  + prefix
    \ segments=row[grove_norm_segment] path=path
    ^ bool
    ? (gt path.len segments.len) .false
    | (row/range 0 path.len).all
    \ i
    ? segments.at(i).pattern
     > (zeta/lit value) (eq_iota value path.at(i))
     > (zeta/var aura) (eq aura (aura_tag path.at(i)))
  + validate
    '  Return the first invalid occupied path; .none means valid.
    \ segments=row[grove_norm_segment] item={\ myth}bool
      tree=axal[myth]
    ^ maybe[path]
    % rest=row[[path myth]] tree.tap
    ^ maybe[path]
    ? (eq rest.len 0) .none
    = [path card] rest.at(0)
    ? !(grove_norm_runtime/prefix segments path) (./some path)
    ? (eq path.len segments.len)
      ? !(item card) (./some path)
      | _ rest.drop(1)
    = content
        | row/fold[path myth] card
          (\ card slot card.del(slot))
          [system_vocabulary/spec system_vocabulary/grove/like system_vocabulary/limb
           system_vocabulary/lash system_vocabulary/crew]
    ? !(eq (mop/size[path pail lt_pith] content) 0) (./some path)
    | _ rest.drop(1)
  + spec
    \ segments=row[grove_norm_segment] item=lash
    ^ soma
    = wrap
        \ sub=soma segment=grove_norm_segment
        ^ soma
        | soma .none [(soma/arm segment.pattern sub)]
    | row/fold[grove_norm_segment soma] (soma (./some item) [])
      wrap (row/rev[grove_norm_segment] segments)

+ grove_sewn_schema
  ' Endpoint paths are provenance. The compiled schemas travel with the sewn
  ' value so consumers never combine pinned code with a newer norm declaration.
  : source=path target=path
    source_schema=grove_norm_schema target_schema=grove_norm_schema

+ grove_tree_rule
  : source=path validate={\ axal[myth]}maybe[path] spec=soma
+ grove_tree_seed
  : path=path rule=maybe[grove_tree_rule]

' Explicit instance-local references survive compilation without rebasing
' declaration paths, slot keys, or opaque user values by prefix matching.
+ grove_instance_ref
  : care=care path=path
+ grove_template
  : version=nat seeds=row[[path myth]]

' --- grove_template ---

+ grove_templates
  + version
    ^ nat
    3
  + slot
    ^ path
    system_vocabulary/grove/template
  + source_slot
    ^ path
    system_vocabulary/grove/source
  + resolved
    ' Every explicit instance marker must name a record or subtree that
    ' this template creates. This applies to publisher slots as well.
    \ template=grove_template
    ^ bool
    | template.seeds.all
      \ [relative card]
      | card.tap.all
        \ entry
        > link=grove_instance_ref entry.val .true
        = root=bool
            ? (eq link.path.len 0) (equal[care] link.care .x)
            .false
        ? root .true
        | template.seeds.any
          \ [target record]
          ? (equal[care] link.care .x) (equal[path] link.path target)
          | pith_prefix link.path target
  + records
    \ root=path template=grove_template
    ^ row[[path myth]]
    | template.seeds.map
    \ [relative card]
    = card
        | card.tap.fold card
        \ out entry
        ? entry.val
         > link=grove_instance_ref
          | out.put entry.key
              (safe 1 link.care root.weld(link.path))
        out
    [root.weld(relative) card]

' --- grove_install ---

' Mount a compiled publication batch through the namespace event loop.
' The caller supplies a state with Pact, ward, and fresh installed.
+ grove_install
  + instantiate
    \ source=path version=nat target=path state=namespace
    ^ either[iota namespace]
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    > (./known records)
      (namespace/page .x (./some version) source state)
      | ./err 'missing_grove_template
    > (./some record) records.fil
      | ./err 'missing_grove_template
    = card | unpin record.myth
    > (./some held) card.get(grove_templates/slot)
      | ./err 'missing_grove_template
    > template=grove_template held
      | ./err 'invalid_grove_template
    ? !(eq template.version grove_templates/version)
      | ./err 'grove_template_version
    ? !(grove_templates/resolved template)
      | ./err 'unresolved_instance_reference
    = records | grove_templates/records target template
      origin  | safe version .x source
      records=row[[path myth]]
        ? (records.any((\ [name card] (equal name target))))
          | records.map
            \ [name card]
            ? !(equal name target) [name card]
            [name card.put(grove_templates/source_slot origin)]
        | records.cons
          [target (myth/sing grove_templates/source_slot origin)]
    | grove_install/mount target records state

  + mount
    \ root=path records=row[[path myth]] state=namespace
    ^ either[iota namespace]
    ? !(state.permitted(root)) (./err 'write_outside_authority)
    ? (sovereign_peek root state).wyt
      | ./err 'installation_root_exists
    ? !(records.all((\ [name card] (pith_prefix root name))))
      | ./err 'publication_outside_root
    = valid
        | records.all
          \ [name card]
          | card.tap.all
            \ entry
            ? !((equal[path] entry.key bond/weft) ||
                (equal[path] entry.key bond/tack)) .true
            > link=safe entry.val .true
            ? (eq link.ver 0) .false
            = local
                | records.any
                  \ [target value]
                  ? (equal[care] link.care .x)
                    | equal[path] link.path target
                  | pith_prefix link.path target
            ? local (eq link.ver 1)
            > (./some history) state.history(link.path) .false
            | maybe/is_some
              (namespace/epoch link.care (./some link.ver)
                link.path history)
    ? !valid (./err 'missing_installation_target)
    = seeds | records.map (\ [name card] [name.drop(root.len) card])
      manifest
        | mani 'grove (lore/line "Grove installation.") [] seeds []
      registry=path [state.self 'kook 'pact]
      card
        | (pact/card manifest "grove" 0 0).put
          limb_slot (kook [registry])
      command | task/vine root (writ/make card)
    ? (sovereign_cycle command 0 128 0 0 state)
     > (./fail why) (./err why)
     > (./spun next effects rounds ack spill)
       ? spill
        > (./some why) (./err why)
       ? effects.len (./err 'unexpected_installation_effects)
       | ./ok next

  + change
    ' Work on an immutable candidate; callers publish only a successful result.
    \ target=path command=writ state=namespace
    ^ either[iota namespace]
    = result (sovereign_cycle (task/vine target command) 0 128 0 0 state)
    > (./spun next effects rounds ack spill) result (./err 'instance_change_failed)
    > .none spill (./err 'instance_reaction_failed)
    ? effects.len (./err 'unexpected_installation_effects)
    | ./ok next
  + validate_instance
    \ source=path target=path expected=maybe[nat] state=namespace
    ^ either[iota unit]
    ? !(and (pith_prefix [state.self 'app] target) (gt target.len 2))
      | ./err 'invalid_instance_root
    ? !(equal expected (state.case(.z target))) (./err 'stale_instance)
    = tree (sovereign_peek target state)
    ? (eq tree.wyt 0) (./ok [])
    > (./some root) tree.fil (./err 'unrelated_instance)
    > (./some held) root.get(grove_templates/source_slot) (./err 'unrelated_instance)
    > origin=safe held (./err 'unrelated_instance)
    ? !(equal origin.path source) (./err 'unrelated_instance)
    | ./ok []
  + replace
    \ source=path version=nat target=path expected=maybe[nat] state=namespace
    ^ either[iota namespace]
    < checked (grove_install/validate_instance source target expected state)
    ? !(equal (maybe/some[nat] version) (state.case(.x source))) (./err 'stale_template)
    < cleared (grove_install/change target .cull state)
    | grove_install/instantiate source version target cleared
  + remove
    \ source=path target=path expected=maybe[nat] state=namespace
    ^ either[iota namespace]
    < checked (grove_install/validate_instance source target expected state)
    | grove_install/change target .cull state

' --- grove ---

'  Grove v2 syntax. Embedded languages remain opaque surface Rex.
+ grove
  + error
    & grove/error/parser grove/error/syntax
    + parser
      : cause=any
    + syntax
      : span=rex/source_span message=str
  + name
    & grove/name/identifier grove/name/tree_path
    + identifier
      : text=str
    + tree_path
      : text=str
  + document
    : items=list[grove/item]
  + item
    & grove/import_decl grove/declaration grove/comment
  + import_decl
    : span=rex/source_span alias=str target=rex
  + declaration
    : span=rex/source_span name=grove/name
      body=list[grove/statement]
  + statement
    & grove/tag grove/property grove/directive grove/block
      grove/implementation grove/presentation grove/comment
  + comment
    : span=rex/source_span text=str
  + tag
    : span=rex/source_span kind=grove/tag_kind
  + property
    : span=rex/source_span slot=rex value=rex
  + directive
    : span=rex/source_span kind=grove/directive_kind target=rex
  + block
    : span=rex/source_span kind=grove/block_kind
      body=list[grove/statement]
  + implementation
    : span=rex/source_span code=row[rex]
  + presentation
    : span=rex/source_span code=row[rex]
  + tag_kind
    & #/type
      #/slot
      #/role
      #/action
      #/norm
      #/sewn
      #/tree
      #/view
      #/pane
      #/stencil
    + type
      :
    + slot
      :
    + role
      :
    + action
      :
    + norm
      :
    + sewn
      :
    + tree
      :
    + view
      :
    + pane
      :
    + stencil
      :
  + read_tag_kind
    \ text=str tree=rex
    ^ either[;/error ;/tag_kind]
    = err | ;/error/syntax tree.span "Unknown tag_kind."
    (;/tag_kind/read_str text).ok_or(err)
  + directive_kind
    & #/with
      #/on
      #/here
      #/from
      #/to
      #/like
      #/for
      #/port
    + with :
    + on :
    + here :
    + from :
    + to :
    + like :
    + for :
    + port :
  + read_directive_kind
    \ text=str tree=rex
    ^ either[;/error ;/directive_kind]
    = err | ;/error/syntax tree.span "Unknown directive_kind."
    (;/directive_kind/read_str text).ok_or(err)
  + block_kind
    & #/meta
      #/or
      #/opt
      #/get
      #/route
    + meta
      :
    + or
      :
    + opt
      :
    + get
      :
  + read_block_kind
    \ text=str tree=rex
    ^ either[;/error ;/block_kind]
    = err | ;/error/syntax tree.span "Unknown block_kind."
    (;/block_kind/read_str text).ok_or(err)
  + fail
    (@ a)
    \ tree=rex message=str
    ^ either[;/error a]
    | ./err | ;/error/syntax tree.span message
  + word
    ' gdi fuck get rid of whatever's going on with iota/aura split
    \ tree=rex
    ^ either[;/error str]
    = e | ;/fail[str] tree "Expected a word."
    > (./leaf span shape text) tree
     e
    ? | not | equal[maybe[str]] tree.leaf_kind | maybe/some[str] "word"
     e
    | ./ok text
  + hash_word
    \ tree=rex
    ^ either[;/error str]
    = e | ;/fail[str] tree "Expected #name."
    > (./pref span rune kid) tree
     e
    ? | ne rune "#"
     e
    | ;/word kid
  + read_name
    \ tree=rex
    ^ either[;/error ;/name]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "word"))
       | ./ok | ;/name/identifier text
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "cord"))
        | ./ok | ;/name/tree_path text
      | ;/fail[;/name] tree "Expected a name or cord path."
    | ;/fail[;/name] tree "Expected a name or cord path."
  + read_statement
    \ tree=rex
    ^ either[;/error ;/statement]
    = fail_with
        \ msg=str
        | ;/fail[;/statement] tree msg
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "slug"))
        | ./ok | ;/comment span text
      | fail_with "Expected a statement."
     > (./pref span rune kid)
      ? (eq rune "@")
        < text | ;/word kid
        < kind | ;/read_tag_kind text tree
        | ./ok | ;/tag span kind
      | fail_with "Expected a tag."
     > (./nest span color rune kids)
      ? | ne color "clear"
       | fail_with "Unexpected brackets."
      ? | ne kids.len 2
       | fail_with "Expected two operands."
      ? | eq rune ":"
       | ./ok | ;/property span kids.at(0) kids.at(1)
      ? | eq rune ";"
       < text | ;/hash_word kids.at(0)
       < kind | ;/read_directive_kind text tree
       | ./ok | ;/directive span kind kids.at(1)
      | fail_with "Unknown statement rune."
     > (./bloc span color rune head items)
      ? | ne color "clear"
       | fail_with "Unexpected brackets."
      ? | eq rune ";"
       < text | ;/hash_word head
       < kind | ;/read_block_kind text tree
       < body | ;/read_body items
       | ./ok | ;/block span kind body
      ? | eq rune ":"
       < text | ;/word head
       ? | ne text "get"
        | fail_with "Expected get block."
       < body | ;/read_body items
       | ./ok | ;/block span .get body
      | fail_with "Unknown block rune."
    | fail_with "Expected a Grove statement."
  + read_body
    \ trees=row[rex]
    ^ either[;/error list[;/statement]]
    ? | eq trees.len 0
     | ./ok .nil
    = tree trees.at(0)
      rest trees.drop(1)
    ? tree
     > (./heir span kids)
      | ;/read_body kids.weld(rest)
     > (./open span rune kids)
      ? | eq rune "!"
       ? | ne kids.len 1
        | ;/fail[list[;/statement]] tree "Expected ! foil."
       < lang | ;/word kids.at(0)
       ? | eq lang "goo"
        ? | eq rest.len 0
         | ;/fail[list[;/statement]] tree "Empty Goo body."
        | ./ok | list/one | ;/presentation span rest
       ? | ne lang "foil"
        | ;/fail[list[;/statement]] tree "Unknown language."
       ? | eq rest.len 0
        | ;/fail[list[;/statement]] tree "Empty Foil body."
       | ./ok | list/one | ;/implementation span rest
      | ;/fail[list[;/statement]] tree "Unexpected open rune."
    = next | ;/read_statement_tail tree rest
    > (./nest span color rune kids) tree
     next
    ? | and (eq color "clear") (eq rune "=>")
     | ./ok | list/one | ;/presentation span trees
    next
  + read_statement_tail
    \ tree=rex rest=row[rex]
    ^ either[;/error list[;/statement]]
    < stmt (;/read_statement tree)
    < tail (;/read_body rest)
    | ./ok tail.cons(stmt)
  + read_import
    \ tree=rex kids=row[rex]
    ^ either[;/error ;/item]
    ? | ne kids.len 2
     | ;/fail[;/item] tree "Expected #import alias=target."
    < mark | ;/hash_word kids.at(0)
    ? | ne mark "import"
     | ;/fail[;/item] tree "Expected #import."
    = e | ;/fail[;/item] tree "Expected alias=target."
    > (./tyte span rune pair) kids.at(1)
     e
    ? | ne rune "="
     e
    ? | ne pair.len 2
     e
    < name | ;/word pair.at(0)
    | ./ok | ;/import_decl tree.span name pair.at(1)
  + read_item
    \ tree=rex
    ^ either[;/error ;/item]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "slug"))
        | ./ok | ;/comment span text
      | ;/fail[;/item] tree "Expected a declaration."
     > (./expr span color kids)
      ? | eq color "clear"
       | ;/read_import tree kids
      | ;/fail[;/item] tree "Unexpected brackets."
     > (./bloc span color rune head items)
      ? | ne color "clear"
       | ;/fail[;/item] tree "Unexpected brackets."
      ? | ne rune "="
       | ;/fail[;/item] tree "Expected a declaration."
      < name | ;/read_name head
      < body | ;/read_body items
      | ./ok | ;/declaration span name body
    | ;/fail[;/item] tree "Stray top-level code."
  + read_items
    \ trees=row[rex]
    ^ either[;/error list[;/item]]
    ? | eq trees.len 0
     | ./ok .nil
    < item | ;/read_item trees.at(0)
    < tail | ;/read_items trees.drop(1)
    | ./ok tail.cons(item)
  + from_blocks
    \ trees=row[rex]
    ^ either[grove/error grove/document]
    < items (grove/read_items trees)
    | ./ok (grove/document items)
  + parse
    \ text=str
    ^ either[grove/error grove/document]
    ? (rex/parse_blocks text)
     > (./err cause) (./err (grove/error/parser cause))
     > (./ok trees) (grove/from_blocks trees)

' --- goo ---

' Goo surface nodes and lowered IR share the same tree shape. The frontend
' removes show and fills present.children; all argument expressions stay Rex.
+ goo
  + node
    : span=rex/source_span constructor=str arguments=list[rex]
      children=list[goo/node]
  + body
    : binding=str children=list[goo/node]
  + view
    : span=rex/source_span name=path role=path slot=path
      binding=str children=list[goo/node] is_pane=bool ports=list[path]
  + field
    : name=str slot=path type=path optional=bool
  + role
    : name=path fields=list[goo/field]
  + renderer
    : type=path constructor=str
  + html_types
    ' The caller supplies the canonical namespace of the value codecs.
    \ root=path
    ^ list[goo/renderer]
    ((((list/one (goo/renderer root.snoc('duration) "duration")).cons((goo/renderer root.snoc('time) "time"))).cons((goo/renderer root.snoc('path) "link"))).cons((goo/renderer root.snoc('text) "text")))
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove/error a]
    | ./err (grove/error/syntax span message)
  + curly
    \ tree=rex
    ^ maybe[row[rex]]
    ? tree
     > (./expr span color kids)
      ? (eq color "curly") (./some kids) .none
    .none
  + arguments
    \ tree=rex
    ^ either[grove/error list[rex]]
    ? tree
     > (./expr span color kids)
      ? (eq color "paren") (./ok kids.stream.map(rex/normalize))
      | goo/fail[list[rex]] span "Expected Goo call arguments."
     > (./nest span color rune kids)
      ? (eq color "paren")
        ? (eq rune ",") (./ok kids.stream.map(rex/normalize))
        | ./ok (list/one[rex] (rex/normalize (rex/nest span "clear" rune kids)))
      | goo/fail[list[rex]] span "Expected Goo call arguments."
    | goo/fail[list[rex]] tree.span "Expected Goo call arguments."
  + head
    \ tree=rex
    ^ either[grove/error goo/node]
    ? tree
     > (./leaf span shape text)
      < name (grove/word tree)
      | ./ok (goo/node span name .nil .nil)
     > (./juxt span kids)
      ? (eq kids.len 2)
        < name (grove/word kids.at(0))
        < args (goo/arguments kids.at(1))
        | ./ok (goo/node span name args .nil)
      | goo/fail[goo/node] span "Expected a Goo call."
    | goo/fail[goo/node] tree.span "Expected a Goo constructor or call."
  + nodes
    \ trees=row[rex]
    ^ either[grove/error list[goo/node]]
    | goo/nodes_list trees.stream
  + nodes_list
    \ trees=list[rex]
    ^ either[grove/error list[goo/node]]
    ? trees.is_nil (./ok .nil)
    = first trees.head
    ? (equal first.leaf_kind (maybe/some[str] "slug"))
      | goo/nodes_list trees.tail
    ' A spaced head and its child block may form an explicit clear expression.
    ? first
     > (./expr span color kids)
      ? (eq color "clear") (goo/nodes_list kids.stream.weld(trees.tail))
      | goo/nodes_head trees
    | goo/nodes_head trees
  + nodes_head
    \ trees=list[rex]
    ^ either[grove/error list[goo/node]]
    < node (goo/head trees.head)
    = rest trees.tail
    ? rest.len
      ? (goo/curly rest.head)
       > (./some kids)
        < children (goo/nodes kids)
        < tail (goo/nodes_list rest.tail)
        | ./ok tail.cons(node.set_children(children))
      < tail (goo/nodes_list rest)
      | ./ok tail.cons(node)
    | ./ok (list/one node)
  + rhs
    \ tree=rex
    ^ either[grove/error list[goo/node]]
    ? tree
     > (./expr span color kids)
      ? ((eq color "clear") || (eq color "curly")) (goo/nodes kids)
      | goo/nodes [tree]
    | goo/nodes [tree]
  + parse
    \ code=row[rex]
    ^ either[grove/error goo/body]
    ' After ! goo, Rex may represent the binding as a leaf followed by
    ' an Open => rather than a Nest =>. Both carry the same Goo expression.
    ? (eq code.len 2) (goo/open_binding code.at(0) code.at(1))
    ? !(eq code.len 1)
      | goo/fail[goo/body] rex/zero_span "Expected one Goo binding: name => body."
    = tree code.at(0)
    ? tree
     > (./nest span color rune kids)
      ? (and (eq color "clear") (and (eq rune "=>") (eq kids.len 2)))
        < binding (grove/word kids.at(0))
        < nodes (goo/rhs kids.at(1))
        | ./ok (goo/body binding nodes)
      | goo/fail[goo/body] span "Expected a Goo binding: name => body."
    | goo/fail[goo/body] tree.span "Expected a Goo binding: name => body."
  + open_binding
    \ binding=rex tree=rex
    ^ either[grove/error goo/body]
    > (./open span rune kids) tree
      | goo/fail[goo/body] tree.span "Expected => after Goo binding."
    ? !(eq rune "=>")
      | goo/fail[goo/body] span "Expected => after Goo binding."
    < binding (grove/word binding)
    = body (? (eq kids.len 1) kids.at(0) (rex/expr span "clear" kids))
    < nodes (goo/rhs body)
    | ./ok (goo/body binding nodes)
  + substitute
    ' Substitute a binding only in expression positions, never member names,
    ' namespace paths, enum names, or named-argument keys.
    \ binding=str value=rex tree=rex
    ^ rex
    ? tree
     > (./leaf span shape text)
      ? (and (eq text binding)
          (equal tree.leaf_kind (maybe/some[str] "word"))) value
      tree
     > (./nest span color rune kids)
      ? ((eq rune "/") || (eq rune ";/")) tree
      ? (eq rune ".")
        ? !(eq kids.len 2) tree
        | rex/nest span color rune
          [(goo/substitute binding value kids.at(0)) kids.at(1)]
      ? (and (eq rune "=") (eq kids.len 2))
        | rex/nest span color rune
          [kids.at(0) (goo/substitute binding value kids.at(1))]
      | tree.map_children((goo/substitute binding value))
    | tree.map_children((goo/substitute binding value))
  + bind_node
    \ binding=str value=rex node=goo/node
    ^ goo/node
    = node node.set_arguments(node.arguments.map((goo/substitute binding value)))
    | node.set_children(node.children.map((goo/bind_node binding value)))

' --- grove_bundle ---

' Stored compiler metadata shared by Grove linking and synthesis.
+ grove_backend
  + entry
    : key=path value=any signature=type kind=str
  + bundle
    : version=nat identity=path prefix=path
      exports=mop[path grove_backend/entry lt_pith] artifact=any
  + module_slot
    ^ path
    system_vocabulary/grove/module
  + version
    ^ nat
    3

' --- grove_roles ---

'  Role analysis and Rex generation. Native compiler state stays opaque.
+ grove_roles
  + field
    : span=rex/source_span name=str slot=path
      type=rex codec=rex optional=bool
  + shape
    : fields=list[grove_roles/field] need=list[list[path]]
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove/error a]
    | ./err (grove/error/syntax span message)
  + is_role
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/role))
    .false
  + parts
    \ tree=rex
    ^ either[grove/error path]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "word"))
        > (./some path) (path_parse (str/cat_all ["/" text]))
          | grove_roles/fail[path] span "Invalid path segment."
        | ./ok path
      ? (equal tree.leaf_kind (maybe/some[str] "cord"))
        = parts (str/split_byte 47 text)
        ? !(eq parts.at(0) "")
          | grove_roles/fail[path] span "Expected absolute slot path."
        > (./some path) (path_parse text)
          | grove_roles/fail[path] span "Invalid absolute slot path."
        | ./ok path
      | grove_roles/fail[path] span "Expected slot or type reference."
     > (./nest span color rune kids)
      ? !((eq rune "/") || (eq rune ";/"))
        | grove_roles/fail[path] span "Expected slot or type reference."
      % rest=row[rex] kids out=path []
      ^ either[grove/error path]
      ? (eq rest.len 0) (./ok out)
      < next (grove_roles/parts rest.at(0))
      | _ rest.drop(1) out.weld(next)
    | grove_roles/fail[path] tree.span
      "Expected slot or type reference."
  + imports
    \ doc=grove/document
    ^ list[grove/import_decl]
    | doc.items.bind
    \ item
    ? item
     > imp=grove/import_decl (list/one imp)
    .nil
  + local_slot
    \ tree=rex
    ^ bool
    ? tree
     > (./nest span color rune kids)
      ? (eq rune ";/") .true
      | row/any[rex] grove_roles/local_slot kids
    .false
  + import_location
    \ target=path lookup={\ path}maybe[myth]
    ^ path
    > (./some card) (lookup target) target
    > (./some held) card.get(grove_backend/module_slot) target
    > module=grove_backend/bundle held target
    | module.identity.weld(module.prefix)
  + slot
    \ root=path doc=grove/document lookup={\ path}maybe[myth] tree=rex
    ^ either[grove/error path]
    = norm (rex/normalize tree)
    < parts (grove_roles/parts norm)
    ? (eq parts.len 0)
      | grove_roles/fail[path] tree.span "Empty slot path."
    ? (grove_roles/local_slot norm) (./ok root.weld(parts))
    ? (equal tree.leaf_kind (maybe/some[str] "cord")) (./ok parts)
    % rest=list[grove/import_decl] (grove_roles/imports doc)
    ^ either[grove/error path]
    ? (eq rest.len 0) (./ok parts)
    = imp rest.at(0)
    ? (equal parts.at(0) ($ts imp.alias))
      < base (grove_roles/parts (rex/normalize imp.target))
      = canonical | grove_roles/import_location base lookup
      | ./ok canonical.weld(parts.drop(1))
    | _ rest.drop(1)
  + add_field
    \ field=grove_roles/field shape=grove_roles/shape
    ^ either[grove/error grove_roles/shape]
    ? (list/any[grove_roles/field]
        (\ old (equal old.slot field.slot)) shape.fields)
      | grove_roles/fail[grove_roles/shape] field.span
        "Duplicate or inherited role slot."
    ? (list/any[grove_roles/field]
        (\ old (eq old.name field.name)) shape.fields)
      | grove_roles/fail[grove_roles/shape] field.span
        "Role field names collide; use distinct slot names."
    = reserved=row[str]
        ["extra" "fields" "schema" "spec" "from_myth" "to_myth"
         "read" "write" "contract"]
    ? reserved.has(field.name)
      | grove_roles/fail[grove_roles/shape] field.span
        "Role field name conflicts with a generated member."
    | ./ok shape.set_fields(shape.fields.snoc(field))
  + member
    \ names=row[str] base=rex
    ^ rex
    | rex/rune "/" (row/weld[rex] names.map(rex/word) [base])
  + inherited
    \ base=rex schema=grove_role_schema span=rex/source_span
    ^ grove_roles/shape
    = fields
        | schema.fields.stream.map
        \ field
        = codec (grove_roles/member ["fields" field.name] base)
          type (grove_roles/member ["value_type"] codec)
        | grove_roles/field span field.name field.slot
          type codec field.optional
    | grove_roles/shape fields schema.need.stream.map(row/stream[path])
  + merge
    \ next=grove_roles/shape shape=grove_roles/shape
    ^ either[grove/error grove_roles/shape]
    % rest=list[grove_roles/field] next.fields
      out=grove_roles/shape shape
    ^ either[grove/error grove_roles/shape]
    ? (eq rest.len 0)
      | ./ok out.set_need(out.need.weld(next.need))
    < out (grove_roles/add_field rest.at(0) out)
    | _ rest.drop(1) out
  + parent
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      stack=row[str] tree=rex
    ^ either[grove/error grove_roles/shape]
    < parts (grove_roles/parts (rex/normalize tree))
    ? !(eq parts.len 1)
      | grove_roles/fail[grove_roles/shape] tree.span
        "#with requires a local role or imported role alias."
    = name (str/from_atom (quip_val parts.at(0)))
    % rest=list[grove/item] doc.items
    ^ either[grove/error grove_roles/shape]
    ? (eq rest.len 0)
      | grove_roles/fail[grove_roles/shape] tree.span "Unknown role."
    ? rest.at(0)
     > (grove/declaration span nam body)
      ? nam
       > (grove/name/identifier text)
        ? (eq text name)
          ? !(grove_roles/is_role body)
            | grove_roles/fail[grove_roles/shape] tree.span
              "#with target is not a role."
          ? stack.has(text)
            | grove_roles/fail[grove_roles/shape] tree.span
              "Cyclic role inheritance."
          < shape (grove_roles/analyze root doc lookup stack text body)
          = schema (grove_roles/schema shape)
          | ./ok
            (grove_roles/inherited (rex/word name) schema tree.span)
        | _ rest.drop(1)
      | _ rest.drop(1)
     > (grove/import_decl span alias target)
      ? !(eq name alias) (_ rest.drop(1))
      < path (grove_roles/parts (rex/normalize target))
      > (./some card) (lookup path)
        | grove_roles/fail[grove_roles/shape] span
          "Missing role import."
      > (./some value) card.get(system_vocabulary/grove/role)
        | grove_roles/fail[grove_roles/shape] span
          "Imported declaration has no role schema."
      > schema=grove_role_schema value
        | grove_roles/fail[grove_roles/shape] span
          "Invalid role schema."
      | ./ok (grove_roles/inherited (rex/word alias) schema tree.span)
    | _ rest.drop(1)
  + properties
    \ root=path doc=grove/document lookup={\ path}maybe[myth] optional=bool
      span=rex/source_span body=list[grove/statement]
      shape=grove_roles/shape
    ^ either[grove/error grove_roles/shape]
    ? (eq body.len 0) (./ok shape)
    ? body.at(0)
     > (grove/comment span text)
      | grove_roles/properties root doc lookup optional span body.drop(1) shape
     > (grove/property span slot type)
      < path (grove_roles/slot root doc lookup slot)
      = name (str/from_atom (quip_val path.at((dec path.len))))
        norm (rex/normalize type)
      < checked (grove_roles/parts norm)
      = field (grove_roles/field span name path norm norm optional)
      < next (grove_roles/add_field field shape)
      | grove_roles/properties root doc lookup optional span body.drop(1) next
    | grove_roles/fail[grove_roles/shape] span
      "Role groups contain only properties and comments."
  + analyze
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      stack=row[str] name=str body=list[grove/statement]
    ^ either[grove/error grove_roles/shape]
    ? stack.has(name)
      | grove_roles/fail[grove_roles/shape] rex/zero_span
        "Cyclic role inheritance."
    % rest=list[grove/statement] body
      shape=grove_roles/shape (grove_roles/shape .nil .nil)
    ^ either[grove/error grove_roles/shape]
    ? (eq rest.len 0) (./ok shape)
    ? rest.at(0)
     > (grove/tag span kind)
      ? ((equal kind (grove/tag_kind/role)) ||
         (equal kind (grove/tag_kind/slot)))
        | _ rest.drop(1) shape
      | grove_roles/fail[grove_roles/shape] span
        "Incompatible role tag."
     > (grove/comment span text) (_ rest.drop(1) shape)
     > (grove/property span slot type)
      < next (grove_roles/properties root doc lookup .false span
          (list/one rest.head) shape)
      = field next.fields.at((dec next.fields.len))
      | _ rest.drop(1) next.set_need(next.need.snoc((list/one field.slot)))
     > (grove/directive span kind target)
      ? !(equal kind (grove/directive_kind/with))
        | grove_roles/fail[grove_roles/shape] span
          "Only #with is supported on roles."
      < parent (grove_roles/parent root doc lookup
          stack.snoc(name) target)
      < next (grove_roles/merge parent shape)
      | _ rest.drop(1) next
     > (grove/block span kind kids)
      ? (equal kind (grove/block_kind/meta)) (_ rest.drop(1) shape)
      ? !((equal kind (grove/block_kind/or)) ||
          (equal kind (grove/block_kind/opt)))
        | grove_roles/fail[grove_roles/shape] span
          "Unsupported role block."
      < next (grove_roles/properties root doc lookup .true span kids shape)
      = added next.fields.drop(shape.fields.len)
      ? (eq added.len 0)
        | grove_roles/fail[grove_roles/shape] span "Empty role group."
      = need
          ? (equal kind (grove/block_kind/or))
            next.need.snoc(added.map((\ field field.slot)))
          next.need
      | _ rest.drop(1) next.set_need(need)
     > (grove/presentation at ignored)
      | grove_roles/fail[grove_roles/shape] at
        "Goo bodies require @view."
     > (grove/implementation span code)
      | grove_roles/fail[grove_roles/shape] span
        "Explicit implementations on roles are unsupported."
  + schema
    \ shape=grove_roles/shape
    ^ grove_role_schema
    = fields
        | shape.fields.map
        \ field
        | grove_role_field field.name field.slot field.optional
    | grove_role_schema fields.row shape.need.map(list/row[path]).row
  + template
    \ span=rex/source_span text=str pairs=row[[str rex]]
    ^ rex
    > (./ok tree) (rex/parse_normalized text)
      | rex/word "invalid_role_template"
    | tree.walk
    \ node
    = node node.with_span(span)
    > (./leaf at shape name) node
      node
    ? !(equal node.leaf_kind (maybe/some[str] "word")) node
    | pairs.fold node
    \ out [key value]
    ? (eq key name) value
    out
  + path_value
    \ path=path
    ^ rex
    | rex/brack
    | path.map
    \ part
    | rex/paren
      [(rex/rune "$" [(rex/word (str/from_atom (aura_tag part)))])
       (rex/word (nat/show (quip_val part)))]
  + need_value
    \ need=list[list[path]]
    ^ rex
    = rows
        | need.map
        \ group
        | rex/brack group.map(grove_roles/path_value).row
    | rex/brack rows.row
  + decl
    \ name=str value=rex
    ^ rex
    | rex/rune "+" [(rex/word name) value]
  + field_code
    \ field=grove_roles/field
    ^ rex
    = type field.type
      read (grove_roles/member ["read"] field.codec)
      write (grove_roles/member ["write"] field.codec)
      contract (grove_roles/member ["contract"] field.codec)
      slot (grove_roles/path_value field.slot)
      pairs=row[[str rex]] [["TYPE" type] ["READ" read]
        ["WRITE" write] ["SLOT" slot]]
      extract
        ? field.optional
          | grove_roles/template field.span
            (str/join (str/from_atom 10)
              [(str/join "" [(str/from_atom 92) " card=myth"])
               "^ maybe[maybe[TYPE]]"
               "? card.get(SLOT)"
               " > .none (./some .none)"
               " > (./some held)"
               "  < value (READ held)"
               "  | ./some (./some value)"]) pairs
        | grove_roles/template field.span
          (str/join (str/from_atom 10)
              [(str/join "" [(str/from_atom 92) " card=myth"])
               "^ maybe[TYPE]"
               "< held card.get(SLOT)"
               "| READ held"]) pairs
      put
        ? field.optional
          | grove_roles/template field.span
            (str/join (str/from_atom 10)
              [(str/join ""
                  [(str/from_atom 92) " value=maybe[TYPE] card=myth"])
               "^ myth"
               "? value"
               " > .none card.del(SLOT)"
               " > (./some val) card.put(SLOT (WRITE val))"]) pairs
        | grove_roles/template field.span
          (str/join (str/from_atom 10)
              [(str/join ""
                  [(str/from_atom 92) " value=TYPE card=myth"])
               "^ myth"
               "| card.put SLOT (WRITE value)"]) pairs
    | grove_roles/decl field.name
    | rex/group
      [(grove_roles/decl "value_type" type)
       (grove_roles/decl "read" read)
       (grove_roles/decl "write" write)
       (grove_roles/decl "contract" contract)
       (grove_roles/decl "extract" extract)
       (grove_roles/decl "put" put)]
  + schema_code
    \ shape=grove_roles/shape
    ^ rex
    = fields
        | shape.fields.map
        \ field
        | rex/rune "|" [(rex/word "grove_role_field")
          (rex/cord field.name) (grove_roles/path_value field.slot)
          (rex/word (? field.optional "1" "0"))]
    | rex/rune "|" [(rex/word "grove_role_schema")
      (rex/brack fields.row) (grove_roles/need_value shape.need)]
  + read_step
    \ role=rex next=rex field=grove_roles/field
    ^ rex
    = extract
        | grove_roles/member ["fields" field.name "extract"] role
      value (rex/rune "|" [extract (rex/word "card")])
    = guard (rex/rune "<" [(rex/word field.name) value])
    | rex/group [guard.with_span(field.span) next]
  + patch_step
    \ role=rex card=rex field=grove_roles/field
    ^ rex
    = put (grove_roles/member ["fields" field.name "put"] role)
      val (rex/dot (rex/word field.name) (rex/word "value"))
    | rex/rune "|" [put val card]
  + code
    \ span=rex/source_span name=str shape=grove_roles/shape
    ^ row[rex]
    | grove_roles/code_at span (rex/path [name]) shape
  + code_at
    \ span=rex/source_span role=rex shape=grove_roles/shape
    ^ row[rex]
    = fields
        | shape.fields.map
        \ field
        = type
            ? field.optional
              | grove_roles/template span "maybe[TYPE]"
                [["TYPE" field.type]]
            field.type
        | rex/rune "=" [(rex/word field.name) type]
      extra (rex/rune "=" [(rex/word "extra") (rex/word "myth")])
      record (rex/rune ":" fields.snoc(extra).row)
      names shape.fields.map((\ field (rex/word field.name)))
      construct (rex/rune "|" names.cons(role).snoc((rex/word "card")).row)
      finish
        | grove_roles/template span "| ./some VALUE"
          [["VALUE" construct]]
      reversed shape.fields.reverse
      chain=rex
        | list/fold[grove_roles/field rex] finish
          (grove_roles/read_step role) reversed
      need (grove_roles/need_value shape.need)
      from
        | grove_roles/template span
          (str/join (str/from_atom 10)
              [(str/join "" [(str/from_atom 92) " card=myth"])
               "^ maybe[ROLE]"
               "? !(grove_role_runtime/present NEED card) .none"
               "BODY"]) [["ROLE" role] ["NEED" need] ["BODY" chain]]
      patch=rex
        | list/fold[grove_roles/field rex]
          (rex/dot (rex/word "extra") (rex/word "value"))
          (grove_roles/patch_step role) shape.fields
      to
        | grove_roles/template span
          (str/join (str/from_atom 10)
              [(str/join "" [(str/from_atom 92) " value=ROLE"])
               "^ maybe[myth]"
               "= card PATCH"
               "? !(grove_role_runtime/present NEED card) .none"
               "| ./some card"])
          [["ROLE" role] ["PATCH" patch] ["NEED" need]]
      read
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " raw=pail"])
             "^ maybe[ROLE]"
             "> value=ROLE raw"
             "  .none"
             "| ./some value"]) [["ROLE" role]]
      write
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " raw=ROLE"])
             "^ pail" "raw"]) [["ROLE" role]]
      contract
        | grove_roles/template span "| curb/of_type (^ ROLE)"
          [["ROLE" role]]
      contracts
        | shape.fields.map
        \ field
        | rex/brack [(grove_roles/path_value field.slot)
          (grove_roles/member ["contract"] field.codec)]
      spec
        | rex/rune "|" [(rex/path ["grove_role_runtime" "spec"])
          (rex/brack contracts.row) need]
    [record (grove_roles/decl "fields"
        (rex/group shape.fields.map(grove_roles/field_code).row))
      (grove_roles/decl "schema" (grove_roles/schema_code shape))
      (grove_roles/decl "spec" spec)
      (grove_roles/decl "from_myth" from)
      (grove_roles/decl "to_myth" to)
      (grove_roles/decl "read" read)
      (grove_roles/decl "write" write)
      (grove_roles/decl "contract" contract)]
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out.reverse))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0))
    ? !(grove_roles/is_role body)
      | _ rest.drop(1) out.cons(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Roles need a name."
    < shape (grove_roles/analyze root doc lookup [] text body)
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/word text))
      prop=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/role)) schema
      contract=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/role_contract))
          (grove_roles/member ["spec"] (rex/word text))
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) ((list/one contract).cons(prop))
      code=grove/statement
        | grove/implementation span (grove_roles/code span text shape)
      decl=grove/item
        | grove/declaration span name kept.snoc(meta).snoc(code)
    | _ rest.drop(1) out.cons(decl)

' --- goo_vocabulary ---

' Surface v1 checks over the existing Rex AST, not a second authoring parser.
+ goo_vocabulary
  + family
    \ kind=str
    ^ str
    ? ((row/has[str] kind ["text" "show" "resource" "image" "number" "time" "duration" "boolean" "link" "path" "code" "avatar" "media"])) "content"
    ? ((row/has[str] kind ["row" "col" "flow" "stack" "group" "opt" "or" "repeat" "chain" "present"])) "composition"
    ? ((row/has[str] kind ["columns" "lines"])) "constraint"
    ? (eq kind "input") "control"
    ? ((row/has[str] kind ["action" "button"])) "affordance"
    ? ((row/has[str] kind ["progress" "status" "bar" "presence"])) "value"
    ? ((row/has[str] kind ["menu" "dialog" "tooltip"])) "scope"
    ? ((row/has[str] kind ["commentary" "reading_value" "reading_index" "reading_when" "anchored_columns" "reading_stream" "patch" "patch_node" "patch_port" "patch_connection" "patch_label" "patch_handle" "patch_operation" "pane" "_pane_instance" "selection" "list" "diagram_tree" "list_tree" "follow" "split" "deck" "pane_stack" "navigate" "operation" "operation_status"])) "workspace"
    "unknown"
  + named
    \ name=str node=goo/node
    ^ maybe[rex]
    % rest=list[rex] node.arguments
    ^ maybe[rex]
    ? rest.is_nil .none
    > (./nest _ _ rune kids) rest.head (_ rest.tail)
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
    ? !(eq kids.at(0).print name) (_ rest.tail)
    | ./some kids.at(1)
  + word
    \ value=rex
    ^ str
    ? value
     > (./leaf _ _ text) text
     > (./nest _ _ rune kids)
      ? (and (eq rune ".") (eq kids.len 1)) (goo_vocabulary/word kids.at(0))
      ""
    ""
  + track
    \ value=rex
    ^ either[str [str nat]]
    = word (goo_vocabulary/word value)
    ? (eq word "content") (./ok ["content" 0])
    = call=maybe[rex]
        > (./ok node) (goo/head value) .none
        ? !(and (eq node.constructor "fr") (eq node.arguments.len 1)) .none
        | ./some node.arguments.head
      fractional=bool call.is_some
      digits=str (? fractional call.fall(value).print word)
    > (./some number) (nat/parse digits) (./err "Track must be fixed pixels, .content, or fr(weight).")
    ? ((gt number (? fractional 256 10000)) || (and fractional !(number))) (./err "Track exceeds its bound.")
    | ./ok [(? fractional "fractional" "fixed") number]
  + attr
    \ name=str node=goo/node
    ^ str
    > (./some value) (goo_vocabulary/named name node) ""
    | goo_vocabulary/word value
  + defaults
    \ nodes=list[goo/node]
    ^ nat
    | nodes.fold 0
      \ count=nat node=goo/node
      | add count (add (? (eq (goo_vocabulary/attr "default" node) "1") 1 0) (goo_vocabulary/defaults node.children))
  + significant
    \ nodes=list[goo/node]
    ^ list[str]
    | nodes.bind
      \ node=goo/node
      = here=list[str] (? (eq (goo_vocabulary/attr "significance" node) "significant") (list/one (str/cat_all [node.constructor "@" (nat/show node.span.line) ":" (nat/show node.span.column)])) .nil)
      ? (maybe/is_some (goo_vocabulary/named "context" node)) here
      | here.weld((goo_vocabulary/significant node.children))
  + region
    \ nodes=list[goo/node] name=str span=rex/source_span
    ^ either[grove/error unit]
    = found (goo_vocabulary/significant nodes)
    ? (gt found.len 1)
      | goo/fail[unit] span (str/cat_all ["region has " (nat/show found.len) " significant nodes; at most 1 allowed: " (str/join ", " found.row) "; region " name])
    | ./ok []
  + check
    \ node=goo/node
    ^ either[grove/error unit]
    = kind node.constructor
      attr (goo_vocabulary/attr)
      has (\ key=str (maybe/is_some (goo_vocabulary/named key node)))
    ? ((has "current") || (has "selected"))
      | goo/fail[unit] node.span "Current state is derived from the accepted context pail; it cannot be authored."
    ? ((row/has[str] kind ["icon" "divider"]))
      | goo/fail[unit] node.span (str/cat_all [kind " is retired; use text/resource or group(treatment = rule)."])
    ? (and (has "context") !((row/has[str] kind ["row" "col" "group"])))
      | goo/fail[unit] node.span "context is allowed only on row, col and group"
    ? (and (has "context") !((row/has[str] (attr "context" node) ["compact" "regular" "reading"])))
      | goo/fail[unit] node.span "context must be compact, regular or reading"
    ? (and (has "significance") !((row/has[str] (attr "significance" node) ["quiet" "default" "strong" "significant"])))
      | goo/fail[unit] node.span "Unknown significance."
    ? (and (eq (attr "treatment" node) "button") !(row/has[str] kind ["action" "button"]))
      | goo/fail[unit] node.span "treatment button belongs to action; style cannot change a family"
    ? (and (eq kind "action") (and (has "invoke") (has "write")))
      | goo/fail[unit] node.span "action takes exactly one of invoke or write"
    ? (and (eq kind "action") (and (has "write") !(has "pail")))
      | goo/fail[unit] node.span "write requires pail"
    ? (and (eq kind "resource") !(has "alt"))
      | goo/fail[unit] node.span "resource requires alt; empty alt only with role = .decorative"
    ? (and (eq kind "resource") (and (has "kind") !(eq (attr "kind" node) "image")))
      | goo/fail[unit] node.span "resource supports images only"
    = bound (attr "max" node)
      depth (attr "depth" node)
    ' PROVISIONAL: truncate at max; runtime missing/depth/cycle cuts.
    ? (and (eq kind "repeat") (and bound.len (gt (nat/parse bound).fall(257) 256)))
      | goo/fail[unit] node.span (str/cat_all ["max " bound " exceeds 256; an unbounded list is a topos, not a repeat"])
    ? (and (eq kind "chain") (and depth.len (gt (nat/parse depth).fall(17) 16)))
      | goo/fail[unit] node.span (str/cat_all ["depth " depth " exceeds 16"])
    ? (and (eq kind "menu") !(node.children.all((\ child=goo/node (eq child.constructor "action")))))
      | goo/fail[unit] node.span "menu children must be actions"
    ? (and (eq kind "dialog") !(eq (goo_vocabulary/defaults node.children) 1))
      | goo/fail[unit] node.span "dialog needs one action marked default"
    = typed (and (eq kind "input") (has "kind"))
      input_kind (attr "kind" node)
    ? (and typed !(row/has[str] input_kind ["text" "rich" "scalar" "boolean" "choice" "colour" "path"]))
      | goo/fail[unit] node.span "Unknown input kind."
    ? (and typed (and (eq input_kind "scalar") !(and (has "min") (has "max"))))
      | goo/fail[unit] node.span "scalar requires min and max"
    ? (and typed (and (eq input_kind "choice") !(has "options")))
      | goo/fail[unit] node.span "choice requires options"
    ? (has "context") (goo_vocabulary/region node.children kind node.span)
    | ./ok []
  + literal
    \ value=rex
    ^ str
    > (./leaf _ _ text) value ""
    | text
  + row_label
    \ node=goo/node
    ^ str
    ? node.children.is_nil ""
    = first node.children.head
    ? !(and (eq first.constructor "text") (eq (goo_vocabulary/attr "role" first) "label")) ""
    ? first.arguments.is_nil ""
    | goo_vocabulary/literal first.arguments.head
  + tree
    \ nodes=list[goo/node] columns=nat borrowed=str
    ^ either[grove/error unit]
    % rest=list[goo/node] nodes
    ^ either[grove/error unit]
    ? rest.is_nil (./ok [])
    = node rest.head
      kind node.constructor
      typed (and (eq kind "input") (maybe/is_some (goo_vocabulary/named "kind" node)))
      label (goo_vocabulary/attr "label" node)
    ? (and typed (and !(label.len) !(borrowed.len)))
      | goo/fail[unit] node.span "input needs a label; it is not in a columns row that opens with label text"
    ? (and (eq kind "resource") (and !((goo_vocabulary/attr "alt" node).len) !(eq (goo_vocabulary/attr "role" node) "decorative")))
      | goo/fail[unit] node.span "resource requires alt; empty alt only with role = .decorative"
    ? (and (eq kind "row") (and columns !(eq node.children.len columns)))
      | goo/fail[unit] node.span (str/cat_all ["row has " (nat/show node.children.len) " child; tracks declare " (nat/show columns)])
    = tracks=nat
        ? !(eq kind "columns") 0
        > (./some value) (goo_vocabulary/named "tracks" node) 0
        | value.children.len
      next_label=str (? (and (eq kind "row") columns) (goo_vocabulary/row_label node) "")
    ? (and (eq kind "columns") !(tracks))
      | goo/fail[unit] node.span "columns requires tracks"
    ? (and (eq kind "columns") ((gt tracks 64) || !(node.children.all((\ row=goo/node (eq row.constructor "row"))))))
      | goo/fail[unit] node.span "columns requires rows and at most 64 tracks"
    = checked_tracks=either[grove/error unit]
        ? !(eq kind "columns") (./ok [])
        > (./some value) (goo_vocabulary/named "tracks" node) (./ok [])
        % rest=list[rex] value.children.stream
        ^ either[grove/error unit]
        ? rest.is_nil (./ok [])
        ? (goo_vocabulary/track rest.head)
         > (./err why) (goo/fail[unit] node.span why)
        | _ rest.tail
    < checked_tracks checked_tracks
    ? (and (eq kind "lines") (node.children.is_nil || !(node.children.all((\ row=goo/node (eq row.constructor "row"))))))
      | goo/fail[unit] node.span "lines requires explicit rows"
    ? (and (maybe/is_some (goo_vocabulary/named "indent" node)) (gt (nat/parse (goo_vocabulary/attr "indent" node)).fall(65) 64))
      | goo/fail[unit] node.span "Line indent exceeds 64"
    < checked (goo_vocabulary/tree node.children tracks next_label)
    | _ rest.tail

' --- grove_views ---

' A frontend target, independent of HTML rendering and namespace installation.
' Imported role field types and native constructors are explicit inputs; no
' reflection fallback or competing-view precedence is chosen here.
+ grove_views
  + context
    : root=path document=grove/document lookup={\ path}maybe[myth]
      roles=list[goo/role] renderers=list[goo/renderer] views=list[goo/view]
  + is_view
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/view))
    .false
  + is_pane
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/pane))
    .false
  + is_goo
    \ body=list[grove/statement]
    ^ bool
    ? (grove_views/is_view body) .true
    | grove_views/is_pane body
  + reference
    \ root=path doc=grove/document lookup={\ path}maybe[myth] tree=rex
    ^ either[grove/error path]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "quip"))
        ? !(eq (str/slice 0 2 text) "'/")
          | goo/fail[path] span "Expected an absolute path."
        > (./some value) (path_parse (str/slice 1 (dec text.len) text))
          | goo/fail[path] span "Invalid absolute path."
        | ./ok value
      | grove_roles/slot root doc lookup tree
    | grove_roles/slot root doc lookup tree
  + finish
    \ root=path span=rex/source_span name=str role=maybe[path]
      slot=maybe[path] code=maybe[goo/body]
    ^ either[grove/error goo/view]
    > (./some role) role
      | goo/fail[goo/view] span "View requires one #on role."
    > (./some slot) slot
      | goo/fail[goo/view] span "View requires one #for slot."
    > (./some code) code
      | goo/fail[goo/view] span "View requires a Goo body."
    | ./ok (goo/view span root.snoc(($ts name)) role slot code.binding code.children .false .nil)
  + is_presentation
    \ stmt=grove/statement
    ^ bool
    ? stmt
     > (grove/presentation at trees) .true
    .false
  + declaration
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span name=str body=list[grove/statement]
    ^ either[grove/error goo/view]
    ? (and (grove_views/is_view body) (grove_views/is_pane body))
      | goo/fail[goo/view] span "A declaration cannot be both @view and @pane."
    % rest=list[grove/statement] body role=maybe[path] .none
      slot=maybe[path] .none code=maybe[goo/body] .none ports=list[path] .nil
    ^ either[grove/error goo/view]
    ? (eq rest.len 0)
      < view (grove_views/finish root span name role slot code)
      | ./ok view.set_is_pane((grove_views/is_pane body)).set_ports(ports.reverse)
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) role slot code ports)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/view)) || (equal kind (grove/tag_kind/pane))) (_ rest.drop(1) role slot code ports)
      | goo/fail[goo/view] at "Incompatible view tag."
     > (grove/block at kind kids)
      ? (equal kind (grove/block_kind/meta)) (_ rest.drop(1) role slot code ports)
      ? (and (equal kind (grove/block_kind/route)) (grove_views/is_pane body)) (_ rest.drop(1) role slot code ports)
      | goo/fail[goo/view] at "Only panes can declare #route. Views accept #meta."
     > (grove/directive at kind target)
      < path (grove_views/reference root doc lookup target)
      ? (equal kind (grove/directive_kind/port))
        ? !(grove_views/is_pane body)
          | goo/fail[goo/view] at "Selection ports require @pane."
        ? (ports.has(path))
          | goo/fail[goo/view] at "Duplicate selection port."
        | _ rest.drop(1) role slot code ports.cons(path)
      ? (equal kind (grove/directive_kind/on))
        ? (maybe/is_some role)
          | goo/fail[goo/view] at "Duplicate #on on view."
        | _ rest.drop(1) (./some path) slot code ports
      ? (equal kind (grove/directive_kind/for))
        ? (maybe/is_some slot)
          | goo/fail[goo/view] at "Duplicate #for on view."
        | _ rest.drop(1) role (./some path) code ports
      | goo/fail[goo/view] at "Views support #on and #for only."
     > (grove/presentation at trees)
      ? (maybe/is_some code)
        | goo/fail[goo/view] at "Duplicate Goo body."
      < parsed (goo/parse trees)
      | _ rest.drop(1) role slot (./some parsed) ports
    | goo/fail[goo/view] span "Expected a Goo view declaration."
  + index
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error list[goo/view]]
    % items=list[grove/item] doc.items out=list[goo/view] .nil
    ^ either[grove/error list[goo/view]]
    ? (eq items.len 0) (./ok out.reverse)
    > (grove/declaration span name body) items.at(0)
      | _ items.drop(1) out
    ? !(grove_views/is_goo body)
      ? body.any(grove_views/is_presentation)
        | goo/fail[list[goo/view]] span "Goo bodies require @view or @pane."
      | _ items.drop(1) out
    > (grove/name/identifier name) name
      | goo/fail[list[goo/view]] span "Views require declaration names."
    < view (grove_views/declaration root doc lookup span name body)
    ? (out.any((\ old (equal old.name view.name))))
      | goo/fail[list[goo/view]] span "Duplicate view name."
    | _ items.drop(1) out.cons(view)
  + role_fields
    \ context=grove_views/context stack=list[path] role=path span=rex/source_span
    ^ either[grove/error list[goo/field]]
    ? stack.has(role)
      | goo/fail[list[goo/field]] span "Cyclic role inheritance."
    = external (context.roles.keep((\ schema (equal schema.name role))))
    ? (gt external.len 1)
      | goo/fail[list[goo/field]] span "Competing imported role schemas."
    ? external.len (./ok external.at(0).fields)
    % items=list[grove/item] context.document.items
    ^ either[grove/error list[goo/field]]
    ? (eq items.len 0)
      | goo/fail[list[goo/field]] span "Unknown role; imported roles require field type information."
    > (grove/declaration at name body) items.at(0)
      | _ items.drop(1)
    > (grove/name/identifier name) name
      | _ items.drop(1)
    ? !(equal context.root.snoc(($ts name)) role) (_ items.drop(1))
    ? !(grove_roles/is_role body)
      | goo/fail[list[goo/field]] at "View receiver is not a role."
    < fields (grove_views/fields context stack.snoc(role) .false body)
    % rest=list[goo/field] fields names=list[str] .nil slots=list[path] .nil
    ^ either[grove/error list[goo/field]]
    ? (eq rest.len 0) (./ok fields)
    = field rest.at(0)
    ? (names.has(field.name) || slots.has(field.slot))
      | goo/fail[list[goo/field]] at "Duplicate or inherited role field."
    | _ rest.drop(1) names.snoc(field.name) slots.snoc(field.slot)
  + fields
    \ context=grove_views/context stack=list[path] optional=bool
      body=list[grove/statement]
    ^ either[grove/error list[goo/field]]
    ? (eq body.len 0) (./ok .nil)
    < tail (grove_views/fields context stack optional body.drop(1))
    ? body.at(0)
     > (grove/property span slot type)
      < slot (grove_views/reference context.root context.document context.lookup slot)
      < type (grove_views/reference context.root context.document context.lookup type)
      ? (eq slot.len 0)
        | goo/fail[list[goo/field]] span "Empty role field path."
      = name (str/from_atom (quip_val slot.at((dec slot.len))))
      | ./ok tail.cons((goo/field name slot type optional))
     > (grove/block span kind kids)
      ? (equal kind (grove/block_kind/meta)) (./ok tail)
      ? !((equal kind (grove/block_kind/or)) || (equal kind (grove/block_kind/opt)))
        | goo/fail[list[goo/field]] span "Unsupported role block."
      < fields (grove_views/fields context stack .true kids)
      | ./ok fields.weld(tail)
     > (grove/directive span kind target)
      ? !(equal kind (grove/directive_kind/with))
        | goo/fail[list[goo/field]] span "Unsupported role directive."
      < role (grove_views/reference context.root context.document context.lookup
        (grove_views/local_role context.document target))
      < fields (grove_views/role_fields context stack role span)
      | ./ok fields.weld(tail)
     > (grove/tag span kind) (./ok tail)
     > (grove/comment span text) (./ok tail)
    | goo/fail[list[goo/field]] rex/zero_span "Invalid role body."
  + local_role
    ' #with historically permits bare local names as well as ;/name.
    \ doc=grove/document tree=rex
    ^ rex
    ? !(equal tree.leaf_kind (maybe/some[str] "word")) tree
    = name
        ? tree
         > (./leaf span shape text) text
        ""
    ? ((grove_roles/imports doc).any((\ imp (eq imp.alias name)))) tree
    | rex/rune ";/" [tree]
  + expression_type
    \ context=grove_views/context view=goo/view expression=rex
    ^ either[grove/error path]
    ? (equal expression.leaf_kind (maybe/some[str] "word"))
      ? expression
       > (./leaf span shape text)
        ? (eq text view.binding) (./ok view.role)
        | goo/fail[path] expression.span "Unbound Goo value."
      | goo/fail[path] expression.span "Unbound Goo value."
    ? expression
     > (./nest span color rune kids)
      ? (and (eq rune ".") (eq kids.len 2))
        < role (grove_views/expression_type context view kids.at(0))
        < name (grove/word kids.at(1))
        < fields (grove_views/role_fields context .nil role span)
        = matching (fields.keep((\ field (eq field.name name))))
        ? !(eq matching.len 1)
          | goo/fail[path] span "Unknown or ambiguous role field."
        | ./ok matching.at(0).type
      | goo/fail[path] expression.span "Cannot determine Goo expression type."
    | goo/fail[path] expression.span "Cannot determine Goo expression type."
  + renderer
    \ context=grove_views/context view=goo/view expression=rex
    ^ either[grove/error str]
    ? (equal expression.leaf_kind (maybe/some[str] "cord")) (./ok "text")
    ? (equal expression.leaf_kind (maybe/some[str] "quip"))
      < path (grove_views/reference context.root context.document context.lookup expression)
      | ./ok "link"
    < type (grove_views/expression_type context view expression)
    = matches (context.renderers.keep((\ renderer (equal renderer.type type))))
    ? (eq matches.len 0)
      | goo/fail[str] expression.span "No native UI constructor for this type."
    ? !(eq matches.len 1)
      | goo/fail[str] expression.span "Competing native UI constructors for this type."
    = constructor matches.at(0).constructor
    ? ((eq constructor "show") || ((eq constructor "present") || (eq constructor "")))
      | goo/fail[str] expression.span "Expected a native UI constructor."
    | ./ok constructor
  + select
    \ context=grove_views/context role=path slot=path span=rex/source_span
    ^ either[grove/error goo/view]
    = matches
        | context.views.keep (\ view (and !(view.is_pane) (and (equal view.role role) (equal view.slot slot))))
    ? (eq matches.len 0)
      | goo/fail[goo/view] span "Missing view for role and slot; reflection fallback is not implemented."
    ? !(eq matches.len 1)
      | goo/fail[goo/view] span "Competing views for role and slot; precedence is not defined."
    | ./ok matches.at(0)
  + interaction_reference
    \ context=grove_views/context expression=rex
    ^ rex
    ' Resolve whole paths before their children: ;/grade/again contains a
    ' nested ;/grade, which must not be replaced before resolving the case.
    = descend expression.map_children((grove_views/interaction_reference context))
    > (./nest _ _ rune _) expression descend
    ? !((eq rune ";/") || (eq rune "/")) descend
    > (./ok path) (grove_views/reference context.root context.document context.lookup expression) descend
    | rex/quip (str/cat_all ["'" (path_show path)])
  + local_named
    \ name=str node=goo/node
    ^ maybe[rex]
    % rest=list[rex] node.arguments
    ^ maybe[rex]
    ? rest.is_nil .none
    > (./nest _ _ rune kids) rest.head (_ rest.tail)
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
    ? !(eq kids.at(0).print name) (_ rest.tail)
    | ./some kids.at(1)
  + local_key
    \ value=rex
    ^ bool
    ? (equal value.leaf_kind (maybe/some[str] "quip")) .true
    | equal value.leaf_kind (maybe/some[str] "cord")
  + source_validate
    \ context=grove_views/context view=goo/view value=rex
    ^ either[grove/error unit]
    ? (grove_views/local_key value) (./ok [])
    < type (grove_views/expression_type context view value)
    ? !(context.renderers.any((\ renderer (and (equal renderer.type type) (eq renderer.constructor "link")))))
      | goo/fail[unit] value.span "Pane source must have path type."
    | ./ok []
  + topos
    \ kind=str
    ^ bool
    | ((eq kind "list") || (eq kind "diagram_tree") || (eq kind "list_tree"))
  + local_validate
    \ context=grove_views/context view=goo/view node=goo/node
    ^ either[grove/error unit]
    ? (eq node.constructor "commentary")
      ? !(and (eq node.arguments.len 1) (eq node.children.len 1)) (goo/fail[unit] node.span "commentary requires one bound library address and one composed body.")
      > (./nest _ _ rune kids) node.arguments.head (goo/fail[unit] node.span "commentary requires receiver.address.")
      ? !(and (eq rune ".") (eq kids.len 2)) (goo/fail[unit] node.span "commentary requires receiver.address.")
      < binding (grove/word kids.at(0))
      < field (grove/word kids.at(1))
      ? !(and (eq binding view.binding) (eq field "address")) (goo/fail[unit] node.span "commentary must use the bound library address.")
      | ./ok []
    = keyed=row[str] ["patch" "patch_node" "patch_port" "patch_connection" "patch_label" "patch_handle" "patch_operation" "pane" "selection" "list" "diagram_tree" "list_tree" "follow" "deck" "navigate" "operation" "operation_status"]
      leaf=row[str] ["list" "diagram_tree" "list_tree" "follow" "navigate" "operation" "operation_status"]
    ? !(keyed.has(node.constructor)) (./ok [])
    ? (eq node.arguments.len 0) (goo/fail[unit] node.span "Local declarations require a stable literal key.")
    ? !(grove_views/local_key node.arguments.head) (goo/fail[unit] node.span "Local keys must be path or text literals.")
    ? (and (leaf.has(node.constructor)) (gt node.children.len 0))
      | goo/fail[unit] node.span "list/follow use a slot-selected presentation; explicit bodies are not supported."
    ? (eq node.constructor "patch")
      > (./some scene) (grove_views/local_named "scene" node) (goo/fail[unit] node.span "patch requires a server-resolved scene field.")
      < type (grove_views/expression_type context view scene)
      ? !(context.renderers.any((\ renderer (and (equal renderer.type type) (eq renderer.constructor "text")))))
        | goo/fail[unit] node.span "patch scene must contain JSON text."
      | ./ok []
    ? (eq node.constructor "patch_operation")
      > (./some slot) (grove_views/local_named "slot" node) (goo/fail[unit] node.span "patch_operation requires its declared input slot.")
      < resolved (grove_views/reference context.root context.document context.lookup slot)
      | ./ok []
    ? (eq node.constructor "navigate")
      > (./some value) (grove_views/local_named "source" node) (goo/fail[unit] node.span "navigate requires a path source.")
      | grove_views/source_validate context view value
    ? ((eq node.constructor "operation") || (eq node.constructor "operation_status"))
      > (./some value) (grove_views/local_named "operation" node) (goo/fail[unit] node.span "Host controls require an operation key.")
      ? !(grove_views/local_key value) (goo/fail[unit] node.span "Operation keys must be literals.")
      | ./ok []
    = source=bool ((eq node.constructor "selection") || (grove_views/topos node.constructor))
    ? source
      > (./some value) (grove_views/local_named "source" node) (goo/fail[unit] node.span "selection/list require source = namespace path.")
      < valid (grove_views/source_validate context view value)
      ? (eq node.constructor "selection")
        = axis (grove_views/local_named "axis" node).fall((rex/cord "z"))
        ? !((eq axis.print (rex/cord "x").print) || ((eq axis.print (rex/cord "y").print) || (eq axis.print (rex/cord "z").print)))
          | goo/fail[unit] node.span "Selection axis must be x, y, or z."
        > (./some topology) (grove_views/local_named "topology" node) (./ok [])
        ? !((eq topology.print (rex/cord "tree").print) || (eq topology.print (rex/cord "children").print))
          | goo/fail[unit] node.span "Selection topology must be tree or children."
        | ./ok []
      > (./some port) (grove_views/local_named "selection" node) (goo/fail[unit] node.span "list requires a selection port.")
      ? !(grove_views/local_key port) (goo/fail[unit] node.span "Selection port must name a local key.")
      (./ok [])
    ? (eq node.constructor "follow")
      > (./some port) (grove_views/local_named "selection" node) (goo/fail[unit] node.span "follow requires a selection observation.")
      ? !(grove_views/local_key port) (goo/fail[unit] node.span "Selection observation must name a local key.")
      (./ok [])
    | ./ok []
  + make_validate
    \ context=grove_views/context view=goo/view node=goo/node
    ^ either[grove/error unit]
    ? !(eq node.constructor "group") (./ok [])
    = allocation (grove_views/local_named "allocation" node)
      destination (grove_views/local_named "make" node)
    ? (and (maybe/is_some allocation) (maybe/is_none destination))
      | goo/fail[unit] node.span "allocation requires make."
    > (./some target) destination (./ok [])
    = mode allocation.fall((rex/cord "child"))
    ? !(eq mode.print (rex/cord "child").print)
      | goo/fail[unit] node.span "allocation must be child."
    ? ((maybe/is_some (grove_views/local_named "on" node)) || (maybe/is_some (grove_views/local_named "action" node)))
      | goo/fail[unit] node.span "make cannot be combined with on or action."
    = destination_check=either[grove/error unit]
        ? (eq target.print view.binding) (./ok [])
        | grove_views/source_validate context view target
    < valid destination_check
    > (./some role) (grove_views/local_named "role" node) (goo/fail[unit] node.span "make requires a role.")
    < path (grove_views/reference context.root context.document context.lookup role)
    | ./ok []
  + capture_head
    \ expression=rex
    ^ bool
    ? expression
     > (./leaf _ _ text)
      | and (eq text "capture") (equal expression.leaf_kind (maybe/some[str] "word"))
     > (./juxt _ kids)
      ? (eq kids.len 0) .false
      | grove_views/capture_head kids.at(0)
    .false
  + captures
    \ expression=rex
    ^ bool
    = own=bool
        > (./nest _ _ rune kids) expression .false
        ? !(and (eq rune ".") (eq kids.len 1)) .false
        | grove_views/capture_head kids.at(0)
    ? own .true
    | expression.children.any(grove_views/captures)
  + scope_validate
    \ view=goo/view node=goo/node
    ^ either[grove/error unit]
    ? view.is_pane (./ok [])
    = exclusive=row[str] ["commentary" "reading_value" "reading_index" "reading_when" "anchored_columns" "reading_stream" "patch" "patch_node" "patch_port" "patch_connection" "patch_label" "patch_handle" "patch_operation" "pane" "_pane_instance" "selection" "list" "diagram_tree" "list_tree" "follow" "split" "deck" "pane_stack" "navigate" "operation" "operation_status"]
    ? (exclusive.has(node.constructor))
      | goo/fail[unit] node.span (str/cat_all ["Ownership requires @pane or an explicit attachment with declared ports. Declaration " (path_show view.name) "; nearest pane: none (declare @pane at this boundary)."])
    ? (node.arguments.any(grove_views/captures))
      | goo/fail[unit] node.span "Selection capture requires @pane."
    | ./ok []
  + lower_nodes
    \ context=grove_views/context stack=list[path] view=goo/view nodes=list[goo/node]
    ^ either[grove/error list[goo/node]]
    ? (eq nodes.len 0) (./ok .nil)
    < head (grove_views/lower_node context stack view nodes.at(0))
    < tail (grove_views/lower_nodes context stack view nodes.drop(1))
    | ./ok tail.cons(head)
  + lower_node
    \ context=grove_views/context stack=list[path] view=goo/view node=goo/node
    ^ either[grove/error goo/node]
    < vocabulary (goo_vocabulary/check node)
    < scope (grove_views/scope_validate view node)
    ? (eq node.constructor "_pane_instance") (./ok node.set_constructor("pane"))
    ? (eq node.constructor "pane")
      | goo/fail[goo/node] node.span "Use pane(declaration); inline pane bodies are not supported."
    ? (eq node.constructor "path")
      ? ((eq node.arguments.len 0) || (gt node.arguments.len 2) || (gt node.children.len 0))
        | goo/fail[goo/node] node.span "path requires a receiver or path value, an optional slot, and no children."
      = args (node.arguments.map((grove_views/interaction_reference context)))
        value args.head
        receiver=bool
          > (./leaf _ _ name) value .false
          | (and (equal value.leaf_kind (maybe/some[str] "word")) (eq name view.binding))
      ? !receiver
        < renderer (grove_views/renderer context view value)
        ? !(eq renderer "link")
          | goo/fail[goo/node] value.span "path requires a receiver or path-typed value."
        ? (eq args.len 2)
          < slot (grove_views/reference context.root context.document context.lookup args.at(1))
          | ./ok node.set_arguments(args)
        | ./ok node.set_arguments(args)
      ? (eq args.len 2)
        < slot (grove_views/reference context.root context.document context.lookup args.at(1))
        | ./ok node.set_arguments(args)
      | ./ok node.set_arguments(args)
    ? ((eq node.constructor "show") || (eq node.constructor "present"))
      ? !(and (eq node.arguments.len 2) (eq node.children.len 0))
        | goo/fail[goo/node] node.span "show/present require a value and slot, with no explicit children."
      = value node.arguments.at(0)
      < slot (grove_views/reference context.root context.document context.lookup node.arguments.at(1))
      ? (eq node.constructor "show")
        < constructor (grove_views/renderer context view value)
        | ./ok node.set_constructor(constructor)
      < role (grove_views/expression_type context view value)
      < target (grove_views/select context role slot node.span)
      ? stack.has(target.name)
        | goo/fail[goo/node] node.span "Cyclic view presentation; use chain(…, depth = n) to follow data"
      < children (grove_views/lower_nodes context stack.snoc(target.name) target target.children)
      | ./ok node.set_children(children.map((goo/bind_node target.binding value)))
    = constructors=row[str]
        ["group" "or" "action" "input" "text" "link" "number"
         "time" "duration" "boolean" "image" "icon" "divider"
         "commentary" "reading_value" "reading_index" "reading_when" "anchored_columns" "reading_stream" "patch" "patch_node" "patch_port" "patch_connection" "patch_label" "patch_handle" "patch_operation" "pane" "selection" "list" "diagram_tree" "list_tree" "follow" "split" "deck" "pane_stack" "navigate" "operation" "operation_status"
         "row" "col" "flow" "stack" "opt" "button" "code" "avatar" "presence" "media" "bar"
         "resource" "repeat" "chain" "columns" "lines" "progress" "status" "menu" "dialog" "tooltip"]
    ? !(constructors.has(node.constructor))
      | goo/fail[goo/node] node.span "Unknown Goo constructor."
    < creation (grove_views/make_validate context view node)
    < valid (grove_views/local_validate context view node)
    < children (grove_views/lower_nodes context stack view node.children)
    = resolved node.set_children(children).set_arguments(node.arguments.map((grove_views/interaction_reference context)))
    < checked (goo_vocabulary/check resolved)
    | ./ok resolved
  + compile
    ' Compile one entry view and its reachable presentations. Other views may
    ' be indexed without requiring their missing reflection-generated views.
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      imported_roles=list[goo/role] renderers=list[goo/renderer] name=str
    ^ either[grove/error goo/view]
    < views (grove_views/index root doc lookup)
    = context (grove_views/context root doc lookup imported_roles renderers views)
      matching (views.keep((\ view (equal view.name root.snoc(($ts name))))))
    ? !(eq matching.len 1)
      | goo/fail[goo/view] rex/zero_span "Unknown entry view."
    = view matching.at(0)
    < fields (grove_views/role_fields context .nil view.role view.span)
    | grove_views/lower_view context view

  + path_literal
    \ path=path
    ^ rex
    | rex/quip (str/cat_all ["'" (path_show path)])
  + port_lookup
    \ env=list[[path path]] key=path span=rex/source_span
    ^ either[grove/error path]
    ? env.is_nil (goo/fail[path] span "Unbound selection; declare #port and connect it explicitly.")
    = [local actual] env.head
    ? (equal local key) (./ok actual)
    | grove_views/port_lookup env.tail key span
  + local_path
    \ value=rex
    ^ either[grove/error path]
    > (./leaf _ _ text) value (goo/fail[path] value.span "Expected a local path key.")
    ? (equal value.leaf_kind (maybe/some[str] "quip"))
      > (./some path) (path_parse (str/slice 1 (dec text.len) text)) (goo/fail[path] value.span "Expected a local path key.")
      | ./ok path
    ? (equal value.leaf_kind (maybe/some[str] "cord"))
      | ./ok [($ts text)]
    | goo/fail[path] value.span "Expected a local path key."
  + capture_ports
    \ env=list[[path path]] expression=rex
    ^ either[grove/error rex]
    = operand=bool
        ? expression
         > (./juxt _ kids)
          ? (eq kids.len 0) .false
          | grove_views/captures kids.at(0)
        > (./nest _ _ rune kids) expression .false
        ? !(and (eq rune ".") (eq kids.len 1)) .false
        | grove_views/capture_head kids.at(0)
    ? operand
      < next (grove_views/capture_operand env expression)
      | ./ok next
    < children (grove_views/port_expressions env expression.children.stream)
    ' map_children retains shape; pair each child with its rewritten counterpart.
    = rewrite
        \ old=rex
        ^ rex
        % before=row[rex] expression.children after=list[rex] children
        ^ rex
        ? (eq before.len 0) old
        ? (equal old before.at(0)) after.head
        | _ before.drop(1) after.tail
    | ./ok expression.map_children(rewrite)
  + capture_operand
    \ env=list[[path path]] expression=rex
    ^ either[grove/error rex]
    ? ((equal expression.leaf_kind (maybe/some[str] "quip")) || (equal expression.leaf_kind (maybe/some[str] "cord")))
      < key (grove_views/local_path expression)
      < actual (grove_views/port_lookup env key expression.span)
      | ./ok (grove_views/path_literal actual)
    < children (grove_views/capture_operands env expression.children.stream)
    = rewrite
        \ old=rex
        ^ rex
        % before=row[rex] expression.children after=list[rex] children
        ^ rex
        ? (eq before.len 0) old
        ? (equal old before.at(0)) after.head
        | _ before.drop(1) after.tail
    | ./ok expression.map_children(rewrite)
  + capture_operands
    \ env=list[[path path]] expressions=list[rex]
    ^ either[grove/error list[rex]]
    ? expressions.is_nil (./ok .nil)
    < head (grove_views/capture_operand env expressions.head)
    < tail (grove_views/capture_operands env expressions.tail)
    | ./ok tail.cons(head)
  + port_expressions
    \ env=list[[path path]] expressions=list[rex]
    ^ either[grove/error list[rex]]
    ? expressions.is_nil (./ok .nil)
    < head (grove_views/capture_ports env expressions.head)
    < tail (grove_views/port_expressions env expressions.tail)
    | ./ok tail.cons(head)
  + port_bindings
    \ context=grove_views/context target=goo/view env=list[[path path]] node=goo/node
    ^ either[grove/error list[[path path]]]
    = supplied (grove_views/local_named "ports" node)
      fields=list[rex]
        > (./some value) supplied .nil
        > (./nest _ color rune kids) value (list/one value)
        ? !(eq color "curly") (list/one value)
        ? (eq rune "=") (list/one (rex/rune "=" kids))
        kids.stream
    % rest=list[rex] fields out=list[[path path]] .nil
    ^ either[grove/error list[[path path]]]
    ? rest.is_nil
      ? !(eq out.len target.ports.len)
        | goo/fail[list[[path path]]] node.span "Pane requires all declared selection ports."
      | ./ok out
    > (./nest _ _ rune kids) rest.head (goo/fail[list[[path path]]] node.span "Expected ports = { local = selection }.")
    ? !(and (eq rune "=") (eq kids.len 2))
      | goo/fail[list[[path path]]] node.span "Expected ports = { local = selection }."
    < local (grove_views/local_path kids.at(0))
    ? !(target.ports.has(local))
      | goo/fail[list[[path path]]] node.span "Unknown pane selection port."
    ? (out.any((\ [key value] (equal key local))))
      | goo/fail[list[[path path]]] node.span "Duplicate pane selection port binding."
    < key (grove_views/local_path kids.at(1))
    < actual (grove_views/port_lookup env key node.span)
    | _ rest.tail out.cons([local actual])
  + pane_arguments
    \ node=goo/node
    ^ either[grove/error unit]
    % rest=list[rex] node.arguments.tail seen=list[str] .nil
    ^ either[grove/error unit]
    ? rest.is_nil (./ok [])
    > (./nest _ _ rune kids) rest.head (goo/fail[unit] node.span "Expected named pane arguments: key, ports, on.")
    ? !(and (eq rune "=") (eq kids.len 2))
      | goo/fail[unit] node.span "Expected named pane arguments: key, ports, on."
    = name kids.at(0).print
    ? !((eq name "key") || (eq name "ports") || (eq name "on"))
      | goo/fail[unit] node.span "Unknown pane argument."
    ? seen.has(name) (goo/fail[unit] node.span "Duplicate pane argument.")
    | _ rest.tail seen.cons(name)
  + pane_children_keys
    \ nodes=list[goo/node]
    ^ list[rex]
    | nodes.bind
      \ node
      ? (eq node.constructor "pane") (list/one node.arguments.head)
      | grove_views/pane_children_keys node.children
  + pane_instance
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] key=path prefix=path
    ^ either[grove/error goo/node]
    < composed (grove_views/compose_nodes context stack view env prefix view.children)
    < children (grove_views/lower_nodes context stack view composed)
    = keys (grove_views/pane_children_keys children)
    ? (keys.any((\ key (gt (keys.keep((\ other (equal key other)))).len 1))))
      | goo/fail[goo/node] view.span "Repeated pane declaration requires distinct instance keys."
    | ./ok (goo/node view.span "_pane_instance" (list/one (grove_views/path_literal key)) children)
  + compose_nodes
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] prefix=path nodes=list[goo/node]
    ^ either[grove/error list[goo/node]]
    ? nodes.is_nil (./ok .nil)
    < head (grove_views/compose_node context stack view env prefix nodes.head)
    < tail (grove_views/compose_nodes context stack view env prefix nodes.tail)
    | ./ok tail.cons(head)
  + compose_node
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] prefix=path node=goo/node
    ^ either[grove/error goo/node]
    ? (eq node.constructor "_pane_instance")
      | goo/fail[goo/node] node.span "Reserved pane constructor."
    ? (eq node.constructor "pane")
      ? ((eq node.arguments.len 0) || (gt node.children.len 0))
        | goo/fail[goo/node] node.span "Use pane(declaration); inline pane bodies are not supported."
      < _ (grove_views/pane_arguments node)
      < name (grove_views/reference context.root context.document context.lookup node.arguments.head)
      = matches (context.views.keep((\ pane (and pane.is_pane (equal pane.name name)))))
      ? !(eq matches.len 1)
        | goo/fail[goo/node] node.span "pane requires an @pane declaration."
      = target matches.head
      ? stack.has(name) (goo/fail[goo/node] node.span "Cyclic pane composition.")
      = receiver (grove_views/local_named "on" node).fall((rex/word view.binding))
      ? !(eq receiver.print view.binding)
        | goo/fail[goo/node] node.span "Pane composition currently requires the current receiver."
      ? !(equal target.role view.role)
        | goo/fail[goo/node] node.span "Pane receiver role must match its declaration."
      < bindings (grove_views/port_bindings context target env node)
      = explicit (grove_views/local_named "key" node)
      = key=either[grove/error path]
          ? explicit
           > (./some value)
            < local (grove_views/local_path value)
            | ./ok name.snoc('instance).weld(local)
          | ./ok name
      < key key
      < pane (grove_views/pane_instance context stack.snoc(name) target bindings key prefix.snoc(($x key.len)).weld(key))
      | ./ok (goo/bind_node target.binding receiver pane)
    = nested=either[grove/error list[[path path]]]
        ? !(eq node.constructor "selection") (./ok env)
        ? (eq node.arguments.len 0) (goo/fail[list[[path path]]] node.span "Selection requires a local key.")
        < local (grove_views/local_path node.arguments.head)
        | ./ok env.cons([local prefix.snoc('selection).weld(local)])
    < nested nested
    < arguments (grove_views/port_expressions nested node.arguments)
    = mapped=either[grove/error list[rex]]
        ? (eq node.constructor "selection")
          < local (grove_views/local_path node.arguments.head)
          < actual (grove_views/port_lookup nested local node.span)
          | ./ok arguments.tail.cons((grove_views/path_literal actual))
        ? ((grove_views/topos node.constructor) || (eq node.constructor "follow"))
          > (./some port) (grove_views/local_named "selection" node) (goo/fail[list[rex]] node.span "list/follow require a selection port.")
          < local (grove_views/local_path port)
          < actual (grove_views/port_lookup env local node.span)
          = rewrite
              \ argument=rex
              ^ rex
              ? (maybe/is_some (grove_views/local_named "selection" node.set_arguments((list/one argument))))
                | rex/rune "=" [(rex/word "selection") (grove_views/path_literal actual)]
              argument
          | ./ok arguments.map(rewrite)
        | ./ok arguments
    < arguments mapped
    < children (grove_views/compose_nodes context stack view nested prefix node.children)
    | ./ok node.set_arguments(arguments).set_children(children)
  + lower_view
    \ context=grove_views/context view=goo/view
    ^ either[grove/error goo/view]
    < labels (goo_vocabulary/tree view.children 0 "")
    < emphasis (goo_vocabulary/region view.children (path_show view.name) view.span)
    ? !(view.is_pane)
      < children (grove_views/lower_nodes context (list/one view.name) view view.children)
      < emphasis (goo_vocabulary/region children (path_show view.name) view.span)
      | ./ok view.set_children(children)
    = ports (view.ports.map((\ port [port port])))
    < pane (grove_views/pane_instance context (list/one view.name) view ports view.name view.name)
    | ./ok view.set_children((list/one pane.set_constructor("pane")))

' --- grove_view_publication ---

+ goo
  + published
    : view=goo/view fields=list[goo/field] contract=lash
      result=either[grove/error goo/view]

+ goo
  + route
    : name=str arguments=row[[str path]] reveal=path
    + source
      \ spec=goo/route
      ^ path
      = [name slot] spec.arguments.at(0)
      slot
    + slot
      ^ path
      ['sys 'goo 'route]

+ grove_view_publication
  + route_name
    \ name=str
    ^ bool
    | and name.len ((row/range 0 name.len).all((\ i ((and (ge name.at(i) 97) (le name.at(i) 122)) || (and (ge name.at(i) 48) (le name.at(i) 57)) || (eq name.at(i) 95) || (eq name.at(i) 45)))))
  + route
    \ context=grove_views/context view=goo/view fields=list[goo/field] record=myth
    ^ either[grove/error myth]
    = blocks
        | context.document.items.bind
          \ item
          ^ list[grove/statement]
          > (grove/declaration _ id body) item .nil
          > (grove/name/identifier name) id .nil
          ? !(equal view.name context.root.snoc(($ts name))) .nil
          | body.keep
            \ stmt
            > (grove/block _ kind _) stmt .false
            | equal kind (grove/block_kind/route)
    ? blocks.is_nil (./ok record)
    ? !(eq blocks.len 1) (goo/fail[myth] view.span "Duplicate #route.")
    > (grove/block at _ properties) blocks.head (goo/fail[myth] view.span "Invalid route.")
    % rest=list[grove/statement] properties spec=goo/route (goo/route "" [] [])
    ^ either[grove/error myth]
    ? rest.is_nil
      ? !(and spec.name.len spec.arguments.len) (goo/fail[myth] at "Route requires a name and a path binding.")
      ? (fields.any((\ field (and !(field.optional) !(spec.arguments.any((\ [key slot] (equal slot field.slot))))))))
        | goo/fail[myth] at "Route leaves a required receiver slot unbound."
      | ./ok record.put(goo/route/slot spec)
    > (grove/property span key value) rest.head (goo/fail[myth] at "Expected a route property.")
    < key (grove/word key)
    ? (eq key "name")
      > (./leaf _ _ name) value (goo/fail[myth] span "Expected a route name.")
      ? !(and (grove_view_publication/route_name name) !(spec.name.len)) (goo/fail[myth] span "Invalid or duplicate route name.")
      | _ rest.tail spec.set_name(name)
    < slot (grove_views/reference context.root context.document context.lookup value)
    ? (eq key "reveal")
      ? spec.reveal.len (goo/fail[myth] span "Duplicate route reveal slot.")
      | _ rest.tail spec.set_reveal(slot)
    ? !(and (grove_view_publication/route_name key) !((eq key "at") || (eq key "format") || (eq key "route") || (eq key "path")))
      | goo/fail[myth] span "Invalid route parameter name."
    ? (spec.arguments.any((\ [name dest] ((eq key name) || (equal slot dest)))))
      | goo/fail[myth] span "Duplicate route argument or receiver slot."
    ? !(fields.any((\ field (and (equal field.slot slot) (context.renderers.any((\ r (and (equal field.type r.type) (eq r.constructor "link")))))))))
      | goo/fail[myth] span "Route argument requires a path slot on the pane receiver."
    | _ rest.tail spec.set_arguments(spec.arguments.snoc([key slot]))
  + constants_slot
    ^ path
    system_vocabulary/goo/constants
  + constant_value
    ' A case reference names a type in Foil. Construct through the owner's
    ' codec, where the relative case has its actual nominal expected type.
    \ expression=rex
    ^ rex
    > (./ok parts) (grove_roles/parts expression) expression
    ? (lt parts.len 2) expression
    = names (parts.map((\ part (str/from_atom (quip_val part)))))
      owner (rex/rune (? (grove_roles/local_slot expression) ";/" "/") names.take(names.len.dec).map(rex/word))
      codec (grove_roles/member ["write"] owner)
      variant (rex/rune "." [(rex/word names.at(names.len.dec))])
    | rex/rune "|" [codec variant]
  + constants
    ' Compile nominal button arguments in their original Foil scope. The
    ' browser never reconstructs branded values or supplies executable code.
    \ root=path doc=grove/document lookup={\ path}maybe[myth] nodes=list[goo/node]
    ^ list[[path rex]]
    | nodes.bind
      \ node
      = own=list[[path rex]]
          ? !(eq node.constructor "action") .nil
          | node.arguments.bind
            \ argument
            ^ list[[path rex]]
            > (./nest _ _ rune kids) argument .nil
            ? !(and (eq rune "=") (eq kids.len 2)) .nil
            ? (eq kids.at(0).print "become") .nil
            = value kids.at(1)
            > (./nest _ _ rune _) value .nil
            ? !((eq rune ";/") || (eq rune "/")) .nil
            > (./ok path) (grove_views/reference root doc lookup value) .nil
            (list/one [path value])
      | own.weld((grove_view_publication/constants root doc lookup node.children))
  + stubs
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < views (grove_views/index root doc lookup)
    = constants (grove_view_publication/constants root doc lookup (views.bind((\ view view.children))))
      value
        | constants.fold (rex/path ["myth" "new"])
          \ out [path value]
          | rex/rune "|" [(rex/path ["myth" "meld"])
            (rex/rune "|" [(rex/path ["myth" "sing"])
              (grove_roles/path_value path) (grove_view_publication/constant_value value)]) out]
    = rewrite
        \ item=grove/item
        ^ grove/item
        > (grove/declaration span name body) item item
        ? !(grove_views/is_goo body) item
        = prop (grove/property span (rex/cord "/sys/goo/constants")
            (rex/rune "|" [(rex/word "grove_view_constants") value]))
          metadata
            | body.keep
            \ stmt
            ? stmt
             > (grove/block at kind kids) (equal kind (grove/block_kind/meta))
            .false
          generated=grove/statement
            | grove/block span (grove/block_kind/meta) (list/one prop)
          code=grove/statement
            | grove/implementation span [(rex/word "0")]
        | grove/declaration span name metadata.snoc(generated).snoc(code)
    | ./ok doc.set_items(doc.items.map(rewrite))
  + ordinary
    \ item=grove/item
    ^ bool
    ? item
     > (grove/declaration span name body) !(grove_views/is_goo body)
    .true
  + renderers
    \ lookup={\ path}maybe[myth]
    ^ list[goo/renderer]
    | (goo/html_types ['lib 'grove 'types]).map
      \ renderer
      | renderer.set_type (grove_roles/import_location renderer.type lookup)
  + records
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error row[[path myth]]]
    < views (grove_views/index root doc lookup)
    = context (grove_views/context root doc lookup .nil
        (grove_view_publication/renderers lookup) views)
    % rest=list[goo/view] views out=row[[path myth]] []
    ^ either[grove/error row[[path myth]]]
    ? (eq rest.len 0) (./ok out)
    = view rest.at(0)
    < fields (grove_views/role_fields context .nil view.role view.span)
    > (./some role) (lookup view.role)
      | goo/fail[row[[path myth]]] view.span "View role is not published."
    > (./some held) role.get(system_vocabulary/grove/role_contract)
      | goo/fail[row[[path myth]]] view.span "View role has no contract."
    > contract=lash held
      | goo/fail[row[[path myth]]] view.span "Invalid role contract."
    = result=either[grove/error goo/view]
        | grove_views/lower_view context view
      record (myth/sing system_vocabulary/grove/view
        (goo/published view fields contract result))
    < routed (grove_view_publication/route context view fields record)
    | _ rest.drop(1) out.snoc([view.name routed])

' --- goo_value ---

' Slot edits use exact physical record versions and ordinary namespace writes.
+ goo_value
  + compiler
    : evaluate={\ path str namespace}either[str pail]
  + compiler_path
    \ self=iota
    ^ path
    [self 'weft 'goo_value_compiler]
  + artifact
    \ target=path state=namespace
    ^ maybe[any]
    > (./some card) (sovereign_peek target state).fil .none
    > (./some held) card.get([state.self 'compiler 'artifact]) .none
    > code=pails/code held .none
    ? (rep_pin code.v) (./some code.v) .none
  + install
    \ evaluate={\ path str namespace}either[str pail] state=namespace
    ^ either[iota namespace]
    | grove_install/change (goo_value/compiler_path state.self)
        (writ/make (myth/sing system_vocabulary/content (goo_value/compiler evaluate))) state
  + mode
    \ value=pail
    ^ str
    ? value
     > x=pails/t "text"
     > x=pails/n "number"
     > x=pails/b "boolean"
     > x=pails/p "path"
    "foil"
  + input
    \ value=pail
    ^ str
    ? value
     > x=pails/t x.t
     > x=pails/n (nat/show x.n)
     > x=pails/b (? x.b "true" "false")
     > x=pails/p (path_show x.p)
    ""
  + decode
    \ old=pail mode=str source=str context=path state=namespace
    ^ either[str pail]
    ? (eq mode "foil")
      > (./some record) (sovereign_peek (goo_value/compiler_path state.self) state).fil (./err "Foil compiler is unavailable.")
      > (./some held) record.get(system_vocabulary/content) (./err "Foil compiler is unavailable.")
      > compiler=goo_value/compiler held (./err "Foil compiler is unavailable.")
      = evaluate compiler.evaluate
      | evaluate context source state
    ? !(eq mode (goo_value/mode old)) (./err "Input type no longer matches this value.")
    ? (eq mode "text") (./ok (pails/t source))
    ? (eq mode "number")
      > (./some number) (nat/parse source) (./err "Enter a nonnegative integer.")
      | ./ok (pails/n number)
    ? (eq mode "boolean")
      ? (eq source "true") (./ok (pails/b .true))
      ? (eq source "false") (./ok (pails/b .false))
      | ./err "Enter true or false."
    ? (eq mode "path")
      > (./some path) (path_parse source) (./err "Enter a canonical absolute path.")
      | ./ok (pails/p path)
    | ./err "Use a Foil expression for this value."
  + edit
    \ target=path slot=path expected=nat mode=str source=str context=path state=namespace
    ^ either[str namespace]
    ? !(state.permitted(target)) (./err "This namespace record is read-only.")
    ? !(equal (state.case(.x target)) (maybe/some[nat] expected))
      | ./err "This record changed. Refresh Values before saving; your draft has been kept."
    > (./some card) (sovereign_peek target state).fil (./err "Record no longer exists.")
    > (./some old) card.get(slot) (./err "Slot no longer exists.")
    ? (gt source.len 65536) (./err "Value input exceeds 64 KiB.")
    < value (goo_value/decode old mode source context state)
    ? (grove_install/change target (writ/poke (myth/sing slot value)) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))

' --- value_read ---

' Exact, read-only physical slot bytes. No derived evaluation or subtree read.
+ value_read
  + request
    : pax=path slot=path epoch=nat offset=nat limit=nat
  + chunk
    : pax=path slot=path epoch=nat record_epoch=nat kind=str total=nat offset=nat next=maybe[nat] hex=str
  + physical
    \ pax=path
    ^ bool
    | !((is_h pax) || (is_o pax) || (is_xv pax) || (is_cx pax))
  + bytes
    \ held=pail
    ^ maybe[[kind=str bytes=nat]]
    ? held
     > t=pails/t (./some ["text" (str/to_atom t.t)])
     > n=pails/n (./some ["natural" n.n])
    .none
  + representation
    \ kind=str
    ^ str
    ? (equal[str] kind "text") "utf8-bytes"
    "natural-le-bytes"
  + hex_slice
    ' Visit only the requested window. Balanced byte-range recursion avoids
    ' a 65K-element intermediate row; each leaf packs at most 32 byte pairs.
    \ bytes=nat offset=nat count=nat
    ^ str
    ? (le count 32) (value_read/hex_block bytes offset count)
    = half (div count 2)
      left (_ bytes offset half)
      right (_ bytes (add offset half) (sub count half))
    | left.cat(right)
  + hex_block
    \ bytes=nat offset=nat count=nat
    ^ str
    % i=nat 0 packed=nat 0
    ? (eq i count) (str/from_atom packed)
    = byte (load8 (add offset i) bytes)
      pair (add (hex/digit (div byte 16)) (mul 256 (hex/digit (mod byte 16))))
    | _ i.inc (add packed (lsh pair (mul 16 i)))
  + read
    \ req=value_read/request state=sov
    ^ either[iota value_read/chunk]
    ? !((value_read/physical req.pax)) (./err 'derived_path)
    ? ((eq req.limit 0) || (gt req.limit 65536)) (./err 'invalid_limit)
    ? (gt req.epoch state.top) (./err 'future_epoch)
    = history=uon[ass] (sov/hist req.pax state)
      resolved=res[myth] (ass/res req.epoch history)
    ? resolved
     > .unknown (./err 'record_missing)
     > .null (./err 'record_deleted)
     > (./known record=myth)
      > (./some held) record.get(req.slot)
          (./err 'slot_missing)
      > (./some pair) (value_read/bytes held)
          (./err 'unsupported_type)
      = [kind bytes] pair
      | value_read/make req (value_read/record_epoch req.epoch history) kind bytes
  + namespace_safe_read
    ' Epochs belong to the addressed authority, not the local node by default.
    \ req=value_read/request state=namespace
    ^ either[iota value_read/chunk]
    ? !(value_read/physical req.pax) (./err 'derived_path)
    > (./some history) state.history(req.pax)
      | ./err 'unknown_authority
    | value_read/safe_read req history
  + record_epoch
    \ epoch=nat history=uon[ass]
    ^ nat
    > (./some entry) (uon/floor[ass] ($u epoch) history) 0
    = [key assertion] entry
    | (dig_of key).fall(0)
  + safe_read
    ' Force the selected bounded byte window inside the error boundary,
    ' so a malformed stored payload cannot strand the supervisor reply.
    \ req=value_read/request state=sov
    ^ either[iota value_read/chunk]
    ? (Try value_read/force_read [req state])
     > (./ok value) value
     > (./err _) (./err 'read_failed)
  + force_read
    \ input=[value_read/request sov]
    ^ either[iota value_read/chunk]
    = [query source] input
    ? (value_read/read query source)
     > (./err reason) (./err reason)
     > (./ok chunk)
       ; (str/len chunk.hex)
       | ./ok chunk
  + make
    \ req=value_read/request record_epoch=nat kind=str bytes=nat
    ^ either[iota value_read/chunk]
    = total (wid bytes)
    ? (gt req.offset total) (./err 'offset_out_of_range)
    = remaining (sub total req.offset)
      count (? (lt remaining req.limit) remaining req.limit)
      end (add req.offset count)
      next=maybe[nat] (? (lt end total) (./some end) .none)
    | ./ok (value_read/chunk req.pax req.slot req.epoch record_epoch kind total req.offset next
        (value_read/hex_slice bytes req.offset count))
  + json
    ' The payload is produced only by hex_slice: lowercase ASCII hex cannot
    ' contain JSON delimiters. Escape all external metadata normally, then
    ' copy those already encoded bytes once rather than rescan 128K chars.
    \ chunk=value_read/chunk
    ^ str
    = envelope | show (json/obj
      [(jkv "version" (json/num .false 1))
       (jkv "path" (json/str (path_show chunk.pax)))
       (jkv "slot" (json/str (path_show chunk.slot)))
       (jkv "epoch" (json/str (nat/show chunk.epoch)))
       (jkv "recordEpoch" (json/str (nat/show chunk.record_epoch)))
       (jkv "type" (json/str chunk.kind))
       (jkv "representation" (json/str (value_read/representation chunk.kind)))
       (jkv "encoding" (json/str "hex"))
       (jkv "total" (json/str (nat/show chunk.total)))
       (jkv "offset" (json/str (nat/show chunk.offset)))
       (jkv "next" (chunk.next.run((\ n (json/str (nat/show n)))).fall((json/nul 0))))
       (jkv "complete" (json/boo !(maybe/is_some chunk.next)))])
      quote (str/from_atom 34)
    | str/cat_all [envelope.slice(0 envelope.len.dec) "," (show_str "hex") ":" quote chunk.hex quote "}"]
  + error_json
    \ reason=iota
    ^ str
    | show (json/obj [(jkv "version" (json/num .false 1)) (jkv "error" (json/str (iota_show reason)))])
  + status
    \ reason=iota
    ^ nat
    ? (eq_iota reason 'future_epoch) 409
    ? (eq_iota reason 'unknown_authority) 404
    ? (eq_iota reason 'record_deleted) 410
    ? ((eq_iota reason 'record_missing) || (eq_iota reason 'slot_missing)) 404
    ? ((eq_iota reason 'derived_path) || (eq_iota reason 'unsupported_type)) 422
    ? (eq_iota reason 'offset_out_of_range) 416
    ? ((eq_iota reason 'invalid_query) || (eq_iota reason 'invalid_limit)) 400
    500
  + percent
    \ text=str
    ^ str
    = parts
        % i=nat 0 out=list[str] .nil
        ^ list[str]
        ? (eq i text.len) out
        = byte text.at(i)
          safe ((value_read/between byte 65 90) || (value_read/between byte 97 122) ||
            (value_read/between byte 48 57) || (eq byte 45) || (eq byte 46) || (eq byte 95) || (eq byte 126))
          part (? safe (str/snoc_byte byte "") (str/cat_all ["%" (hex/byte byte)]))
        | _ i.inc (list/cons[str] part out)
    | str/cat_all parts.row.rev
  + identifier
    \ text=str
    ^ bool
    ? !(value_read/text_bytes (str/to_atom text)) .false
    % i=nat 0
    ? (eq i text.len) .true
    = byte text.at(i)
    ? ((lt byte 32) || (eq byte 127)) .false
    | _ i.inc
  + url
    \ pax=path slot=path epoch=nat
    ^ str
    | str/cat_all ["/debug-read/value?path=" (value_read/percent (path_show pax))
       "&slot=" (value_read/percent (path_show slot)) "&epoch=" (nat/show epoch) "&offset=0&limit=65536"]
  + continuation
    \ byte=nat
    ^ bool
    | value_read/between byte 128 191
  + between
    \ n=nat lower=nat upper=nat
    ^ bool
    ? (lt n lower) .false
    | le n upper
  + text_bytes
    ' HTML normalizes CR and cannot preserve NUL/invalid UTF-8. Do not
    ' advertise those renderings as complete; the hex read remains exact.
    \ bytes=nat
    ^ bool
    = length (wid bytes)
    % i=nat 0
    ? (eq i length) .true
    = b (load8 i bytes)
    ? (lt b 128)
      ? !((eq b 9) || (eq b 10) || (ge b 32)) .false
      | _ i.inc
    = count
        ? (value_read/between b 194 223) 2
        ? (value_read/between b 224 239) 3
        ? (value_read/between b 240 244) 4
        0
    ? ((eq count 0) || (gt (add i count) length)) .false
    = second (load8 i.inc bytes)
    ? !(value_read/continuation second) .false
    ? (? (eq b 224) (lt second 160) .false) .false
    ? (? (eq b 237) (gt second 159) .false) .false
    ? (? (eq b 240) (lt second 144) .false) .false
    ? (? (eq b 244) (gt second 143) .false) .false
    ? (? (ge count 3) !(value_read/continuation (load8 (add i 2) bytes)) .false) .false
    ? (? (eq count 4) !(value_read/continuation (load8 (add i 3) bytes)) .false) .false
    | _ (add i count)
  + preview_count
    ' A bounded text preview ends before an incomplete UTF-8 sequence.
    \ limit=nat bytes=nat
    ^ nat
    ? (le (wid bytes) limit) (wid bytes)
    % end=nat limit
    ? (eq end 0) 0
    ? !(value_read/continuation (load8 end bytes)) end
    | _ end.dec

' --- physical_key ---

' Lossless structural identity for a physical path or opaque record slot.
' Display spellings are optional presentation, never continuation identities.
+ physical_key
  + max_bytes
    ^ nat
    8192
  + fits
    ' Count the encoded budget before formatting any payload. Every segment
    ' costs at least slash + one-byte tag + colon, even with a zero payload.
    \ key=path
    ^ bool
    ? (gt key.len 2730) .false
    % i=nat 0 size=nat 2
    ? (eq i key.len) .true
    = segment key.at(i)
      next (add size (add 2 (add (wid (aura_tag segment))
        (mul 2 (wid (quip_val segment))))))
    ? (gt next physical_key/max_bytes) .false
    | _ i.inc next
  + encode
    \ key=path
    ^ either[iota str]
    ? !(physical_key/fits key) (./err 'key_too_large)
    = parts
        | key.map
        \ segment=iota
        ^ str
        = payload (quip_val segment)
        | str/cat_all ["/" (str/from_atom (aura_tag segment)) ":"
            (value_read/hex_slice payload 0 (wid payload))]
    | ./ok (str/cat (str/cat_all parts) "v1")

  + nibble
    \ byte=nat
    ^ maybe[nat]
    ? !((lt byte 48) || (gt byte 57)) (./some (sub byte 48))
    ? !((lt byte 97) || (gt byte 102)) (./some (add 10 (sub byte 97)))
    .none
  + payload
    ' Empty hex is exactly zero. Nonzero atoms have no high zero byte;
    ' leading zero bytes are meaningful because the byte order is LE.
    \ text=str
    ^ maybe[nat]
    ? (gt text.len physical_key/max_bytes) .none
    ? !(eq (mod text.len 2) 0) .none
    ? (eq text.len 0) (./some 0)
    ? (equal[str] (text.slice((sub text.len 2) 2)) "00") .none
    % i=nat 0 value=nat 0
    ^ maybe[nat]
    ? (eq i text.len) (./some value)
    > (./some high) (physical_key/nibble text.at(i)) .none
    > (./some low) (physical_key/nibble text.at(i.inc)) .none
    = byte (add (mul high 16) low)
    | _ (add i 2) (add value (lsh byte (mul i 4)))
  + aura
    ' Construct the raw tagged atom without lexical or Unicode conversion.
    \ tag=str value=nat
    ^ maybe[iota]
    ? (equal[str] tag "dm") (maybe/some[iota] ($dm value))
    ? (equal[str] tag "dr") (maybe/some[iota] ($dr value))
    ? (equal[str] tag "ds") (maybe/some[iota] ($ds value))
    ? (equal[str] tag "f") (maybe/some[iota] ($f value))
    ? (equal[str] tag "r") (maybe/some[iota] ($r value))
    ? (equal[str] tag "rd") (maybe/some[iota] ($rd value))
    ? (equal[str] tag "rs") (maybe/some[iota] ($rs value))
    ? (equal[str] tag "s") (maybe/some[iota] ($s value))
    ? (equal[str] tag "ta") (maybe/some[iota] ($ta value))
    ? (equal[str] tag "ts") (maybe/some[iota] ($ts value))
    ? (equal[str] tag "tu") (maybe/some[iota] ($tu value))
    ? (equal[str] tag "u") (maybe/some[iota] ($u value))
    ? (equal[str] tag "w") (maybe/some[iota] ($w value))
    ? (equal[str] tag "x") (maybe/some[iota] ($x value))
    .none
  + segment
    \ text=str
    ^ maybe[iota]
    = parts text.split_byte(58)
    ? !(eq parts.len 2) .none
    > (./some bytes) (physical_key/payload parts.at(1)) .none
    | physical_key/aura parts.at(0) bytes
  + decode
    \ text=str
    ^ maybe[path]
    ? (gt text.len physical_key/max_bytes) .none
    ? (equal[str] text "v1") (maybe/some[path] [])
    ? !(equal[str] (text.slice(0 3)) "v1/") .none
    = tail text.slice(3 (sub text.len 3))
      parts tail.split_byte(47)
    % i=nat 0 out=list[iota] .nil
    ^ maybe[path]
    ? (eq i parts.len) (./some out.row.rev)
    > (./some segment) (physical_key/segment parts.at(i)) .none
    | _ i.inc (list/cons[iota] segment out)

  + display_fits
    ' Presentation may call the partial lexical codec only on tiny keys.
    ' This limit does not restrict the lossless identity codec.
    \ key=path
    ^ bool
    ? (gt key.len 32) .false
    % i=nat 0 bytes=nat 0
    ? (eq i key.len) .true
    = next (add bytes (wid (quip_val key.at(i))))
    ? (gt next 128) .false
    | _ i.inc next
  + display_checked
    \ key=path
    ^ maybe[str]
    = text (path_show key)
    ? (gt text.len 1024) .none
    ? !(value_read/identifier text) .none
    > (./some parsed) (path_parse text) .none
    ? !(eq_pith key parsed) .none
    | ./some text
  + display
    \ key=path
    ^ maybe[str]
    ? !(physical_key/display_fits key) .none
    ? (Try physical_key/display_checked key)
     > (./ok text) text
     > (./err _) .none

' --- goo_paths ---

' Shared data contract. Identity is physical; labels never grant authority.
+ goo_paths
  + policy
    : eligible={\ path bool namespace}bool check={\ goo_paths/hunts bool namespace}either[str unit]
  + hunts
    : items=row[hunt]
  + word
    \ c=care
    ^ str
    ? c
     > .x "x"
     > .y "y"
     > .z "z"
  + care
    \ text=str
    ^ maybe[care]
    ? (eq text "x") (./some .x)
    ? (eq text "y") (./some .y)
    ? (eq text "z") (./some .z)
    .none
  + field
    \ key=str value=json
    ^ json
    > (./obj fields) value jnull
    | fields.fold jnull (\ out entry (? (eq entry.k key) entry.v out))
  + text
    \ value=json
    ^ str
    > (./str text) value ""
    text
  + key
    \ target=path
    ^ str
    > (./ok key) (physical_key/encode target) ""
    key
  + wire
    \ values=goo_paths/hunts
    ^ json
    = items
        | values.items.map
        \ item=hunt
        ^ json
        = key (goo_paths/key item.p)
        | json/obj [(jkv "key" (json/str key)) (jkv "care" (json/str (goo_paths/word item.c)))]
    | json/obj [(jkv "version" (json/num .false 1)) (jkv "hunts" (json/arr items))]
  + decode
    \ source=str
    ^ either[str goo_paths/hunts]
    ? (gt source.len 16384) (./err "Path selections exceed 16 KiB.")
    > (./ok data _) (parse source) (./err "Invalid path selection JSON.")
    > (./obj fields) data (./err "Path input must be an object.")
    ? !(and (eq fields.len 2) (and (eq (fields.keep((\ f=jkv (eq f.k "version")))).len 1) (eq (fields.keep((\ f=jkv (eq f.k "hunts")))).len 1))) (./err "Unknown or duplicate path input fields.")
    ? !(equal (goo_paths/field "version" data) (json/num .false 1)) (./err "Unsupported path selection version.")
    > (./arr items) (goo_paths/field "hunts" data) (./err "Expected a typed hunt collection.")
    ? (gt items.len 64) (./err "Choose at most 64 paths.")
    % rest=row[json] items out=row[hunt] []
    ^ either[str goo_paths/hunts]
    ? !(rest.len) (./ok (goo_paths/hunts out))
    = item rest.at(0)
    > (./obj fields) item (./err "A hunt must be an object.")
    ? !(and (eq fields.len 2) (and (eq (fields.keep((\ f=jkv (eq f.k "key")))).len 1) (eq (fields.keep((\ f=jkv (eq f.k "care")))).len 1))) (./err "Unknown or duplicate hunt fields.")
    > (./some path) (physical_key/decode (goo_paths/text (goo_paths/field "key" item))) (./err "Invalid canonical physical path key.")
    > (./some care) (goo_paths/care (goo_paths/text (goo_paths/field "care" item))) (./err "Care must be File, Folder or Subtree.")
    ? (out.any((\ other=hunt (equal other.p path)))) (./err "Duplicate selected path.")
    | _ rest.drop(1) out.snoc((hunt care path))
  + covers
    ' Folder reaches through transparent paths, but stops at the first record.
    ' This also decides creation: an absent target is allowed only before a barrier.
    \ grant=hunt target=path state=namespace
    ^ bool
    ? !(pith_prefix grant.p target) .false
    ? (equal grant.p target) .true
    ? grant.c
     > .x .false
     > .z .true
    % depth=nat grant.p.len.inc
    ^ bool
    ? (ge depth target.len) .true
    ? (maybe/is_some (sovereign_care .x target.take(depth) state).fil) .false
    | _ depth.inc
  + exists
    \ target=path state=namespace
    ^ bool
    | gt (sovereign_care .y target state).wyt 0
  + validate
    \ values=goo_paths/hunts write=bool state=namespace
    ^ either[str unit]
    % rest=row[hunt] values.items
    ^ either[str unit]
    ? !(rest.len) (./ok [])
    = item rest.at(0) name (physical_key/display item.p).fall((goo_paths/key item.p))
    ? !(goo_paths/exists item.p state) (./err (str/cat_all [name ": path no longer exists."]))
    ? (and (equal item.c care/x) (maybe/is_none (sovereign_care .x item.p state).fil)) (./err (str/cat_all [name ": structural paths require Folder or Subtree."]))
    ? (and write !(state.permitted(item.p))) (./err (str/cat_all [name ": outside writable namespace authority."]))
    | _ rest.drop(1)

' --- goo_composition ---

' Data-only composition. Expansion is shared by painting and action admission.
' Repeated controls still act on the enclosing receiver; rows own no editors.
+ goo_composition
  + items
    : rows=row[myth]
  + named
    \ name=str arguments=list[rex]
    ^ maybe[rex]
    % rest=list[rex] arguments
    ^ maybe[rex]
    ? rest.is_nil .none
    > (./nest _ _ rune kids) rest.head (_ rest.tail)
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
    ? !(eq kids.at(0).print name) (_ rest.tail)
    | ./some kids.at(1)
  + value
    \ published=goo/published current=myth expression=rex
    ^ either[str pail]
    ? (equal expression.leaf_kind (maybe/some[str] "cord"))
      > (./leaf _ _ text) expression (./err "Invalid text literal")
      | ./ok (pails/t text)
    > (./nest _ _ rune kids) expression (./err "Composition requires a receiver field or text literal")
    ? !(and (eq rune ".") (eq kids.len 2)) (./err "Composition requires a receiver field")
    ? !(eq kids.at(0).print published.view.binding) (./err "Unbound composition receiver")
    = fields (published.fields.keep((\ field (eq field.name kids.at(1).print))))
    ? !(eq fields.len 1) (./err "Unknown composition field")
    > (./some value) current.get(fields.head.slot) (./err "Composition field is absent")
    | ./ok value
  + replace
    \ binding=str item=myth tree=rex
    ^ either[str rex]
    ? tree
     > (./nest _ _ rune kids)
      ? (and (eq rune ".") (and (eq kids.len 2) (eq kids.at(0).print binding)))
        > (./some value) item.get([($ts (str/to_atom kids.at(1).print))]) (./err "Missing repeated field")
        > value=pails/t value (./err "Repeated fields must be text literals")
        | ./ok (rex/cord value.t)
      | goo_composition/replace_children binding item tree
    | goo_composition/replace_children binding item tree
  + replace_children
    \ binding=str item=myth tree=rex
    ^ either[str rex]
    = replaced
        % rest=row[rex] tree.children out=row[rex] []
        ^ either[str row[rex]]
        ? !(rest.len) (./ok out)
        < child (goo_composition/replace binding item rest.at(0))
        | _ rest.drop(1) out.snoc(child)
    < kids replaced
    ? tree
     > (./leaf _ _ _) (./ok tree)
     > (./nest span color rune _) (./ok (rex/nest span color rune kids))
     > (./expr span color _) (./ok (rex/expr span color kids))
     > (./pref span rune _) (./ok (rex/pref span rune kids.at(0)))
     > (./tyte span rune _) (./ok (rex/tyte span rune kids))
     > (./bloc span color rune _ _) (./ok (rex/bloc span color rune kids.at(0) kids.drop(1)))
     > (./open span rune _) (./ok (rex/open span rune kids))
     > (./juxt span _) (./ok (rex/juxt span kids))
     > (./heir span _) (./ok (rex/heir span kids))
  + bind
    \ binding=str item=myth node=goo/node
    ^ either[str goo/node]
    = args
        % rest=list[rex] node.arguments out=list[rex] .nil
        ^ either[str list[rex]]
        ? rest.is_nil (./ok out)
        < arg (goo_composition/replace binding item rest.head)
        | _ rest.tail out.snoc(arg)
      children
        % rest=list[goo/node] node.children out=list[goo/node] .nil
        ^ either[str list[goo/node]]
        ? rest.is_nil (./ok out)
        < child (goo_composition/bind binding item rest.head)
        | _ rest.tail out.snoc(child)
    < args args
    < children children
    | ./ok node.set_arguments(args).set_children(children)
  + nodes
    \ published=goo/published current=myth nodes=list[goo/node] depth=nat
    ^ either[str list[goo/node]]
    ? !(goo_composition/dynamic nodes) (./ok nodes)
    ? (gt depth 24) (./err "Composition exceeds 24 levels")
    % rest=list[goo/node] nodes out=list[goo/node] .nil
    ^ either[str list[goo/node]]
    ? rest.is_nil (./ok out)
    < node (goo_composition/node published current rest.head depth)
    | _ rest.tail out.snoc(node)
  + dynamic
    \ nodes=list[goo/node]
    ^ bool
    | nodes.any
      \ node=goo/node
      | ((goo_composition/named "when" node.arguments).is_some || ((goo_composition/named "each" node.arguments).is_some || (goo_composition/dynamic node.children)))
  + node
    \ published=goo/published current=myth node=goo/node depth=nat
    ^ either[str goo/node]
    = when (goo_composition/named "when" node.arguments)
      each (goo_composition/named "each" node.arguments)
    ? (and (when.is_some || each.is_some) !(eq node.constructor "group")) (./err "when/each require a group")
    = visible=either[str bool]
        > (./some expression) when (./ok .true)
        < value (goo_composition/value published current expression)
        > value=pails/t value (./err "when requires text")
        > (./some expected) (goo_composition/named "is" node.arguments) (./err "when requires is")
        < expected (goo_composition/value published current expected)
        > expected=pails/t expected (./err "is requires text")
        | ./ok (eq value.t expected.t)
    < visible visible
    ? !visible (./ok node.set_children(.nil))
    = children=either[str list[goo/node]]
        > (./some expression) each (./ok node.children)
        < value (goo_composition/value published current expression)
        > value=goo_composition/items value (./err "each requires composition items")
        ? (gt value.rows.len 128) (./err "Composition exceeds 128 rows")
        > (./some binding) (goo_composition/named "as" node.arguments) (./err "each requires as")
        > (./leaf _ _ name) binding (./err "as requires a binding name")
        ? (eq name published.view.binding) (./err "Repeated binding shadows receiver")
        % rest=row[myth] value.rows out=list[goo/node] .nil
        ^ either[str list[goo/node]]
        ? !(rest.len) (./ok out)
        < group (goo_composition/bind name rest.at(0) (goo/node node.span "group" .nil node.children))
        | _ rest.drop(1) out.snoc(group)
    < children children
    < expanded (goo_composition/nodes published current children depth.inc)
    | ./ok node.set_children(expanded)

' --- goo_runtime ---

' Browser requests identify published controls. Only source-declared arguments
' can be supplied, and all writes pass through the namespace event loop.
+ goo_runtime
  + request
    : operation=str target=path subject=path view=path control=row[nat]
      expected=nat displayed=nat publication=nat inputs=row[[str str]] now=nat
  + scope
    : receiver=maybe[rex] action=maybe[rex] values=list[rex] make=maybe[rex] role=maybe[rex] allocation=maybe[rex]
  + read_path
    \ expression=rex
    ^ maybe[path]
    > (./leaf _ _ text) expression .none
    ? !(equal expression.leaf_kind (maybe/some[str] "quip")) .none
    | path_parse text.slice(1 text.len.dec)
  + named
    \ name=str arguments=list[rex]
    ^ maybe[rex]
    % rest=list[rex] arguments
    ^ maybe[rex]
    ? (eq rest.len 0) .none
    > (./nest _ _ rune kids) rest.at(0) (_ rest.drop(1))
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.drop(1))
    ? !(equal kids.at(0).print name) (_ rest.drop(1))
    | ./some kids.at(1)
  + chained_fields
    ' Rex joins newline-separated equals inside brackets into one chain:
    ' key0 = (value0 key1) = value1. Recover the pairs before dispatch.
    \ children=row[rex] original=rex
    ^ list[rex]
    ? (lt children.len 2) (list/one original)
    % key=rex children.at(0) rest=row[rex] children.drop(1) out=list[rex] .nil
    ^ list[rex]
    ? (eq rest.len 1) out.snoc((rex/rune "=" [key rest.at(0)]))
    > (./nest _ color rune kids) rest.at(0) (list/one original)
    ? !(eq color "clear") (list/one original)
    ? !(eq rune "") (list/one original)
    ? !(eq kids.len 2) (list/one original)
    | _ kids.at(1) rest.drop(1) out.snoc((rex/rune "=" [key kids.at(0)]))
  + fields
    \ expression=rex
    ^ list[rex]
    ? expression
     > (./expr _ color kids) (? (eq color "curly") kids.stream (list/one expression))
     > (./nest _ color rune kids)
      ? !(eq color "curly") (list/one expression)
      ? (eq rune "=") (goo_runtime/chained_fields kids expression)
      kids.stream
    (list/one expression)
  + mentions
    \ name=str expression=rex
    ^ bool
    ? expression
     > (./leaf _ _ text) (eq text name)
    | row/any[rex] (goo_runtime/mentions name) expression.children
  + enter
    \ scope=goo_runtime/scope node=goo/node
    ^ goo_runtime/scope
    ? !(eq node.constructor "group") scope
    = receiver (goo_runtime/named "on" node.arguments)
      action (goo_runtime/named "action" node.arguments)
      values (goo_runtime/named "myth" node.arguments)
      make (goo_runtime/named "make" node.arguments)
      role (goo_runtime/named "role" node.arguments)
      allocation (goo_runtime/named "allocation" node.arguments)
    | goo_runtime/scope
      (? (maybe/is_some receiver) receiver scope.receiver)
      (? (maybe/is_some action) action scope.action)
      scope.values.weld(values.run(goo_runtime/fields).fall((list/nil[rex])))
      (? (maybe/is_some make) make scope.make)
      (? (maybe/is_some role) role scope.role)
      (? (maybe/is_some allocation) allocation scope.allocation)
  + locate
    \ nodes=list[goo/node] indices=row[nat] scope=goo_runtime/scope
    ^ maybe[[goo/node goo_runtime/scope]]
    ? (eq indices.len 0) .none
    ? (ge indices.at(0) nodes.len) .none
    = node nodes.at(indices.at(0))
      next (goo_runtime/enter scope node)
    ? (eq indices.len 1) (./some [node next])
    | goo_runtime/locate node.children indices.drop(1) next
  + record
    \ care=care target=path state=namespace
    ^ maybe[myth]
    | (sovereign_care care target state).fil
  + target
    ' A sewn projection may point back through its declared tack and sys/from.
    ' Validate the projection against the concrete record; never write into /o.
    \ target=path state=namespace
    ^ maybe[path]
    ? (maybe/is_some (goo_runtime/record .x target state)) (./some target)
    < card (goo_runtime/record .y target state)
    < relative card.path_at(system_vocabulary/from)
    % length=nat target.len.dec
    ^ maybe[path]
    ? (lt length 3) .none
    = ancestor (goo_runtime/record .x target.take(length) state).fall(myth/new)
    > (./some held) ancestor.get(system_vocabulary/tack) (_ length.dec)
    > source=safe held .none
    = actual source.path.weld(relative)
    < current (goo_runtime/record .x actual state)
    ? !(equal card.del(system_vocabulary/from) current.del(system_vocabulary/from)) .none
    | ./some actual
  + publication
    \ state=namespace
    ^ nat
    | (state.case(.z [state.self 'gov])).fall(0)
  + lifetime
    ' x.shape changes on removal/recreation, never on an ordinary live edit.
    \ target=path state=namespace
    ^ nat
    > (./some history) state.history(target) 0
    | (history.ever_at(target)).x.lock.shape
  + member
    \ source=path target=path state=namespace
    ^ json
    | goo_runtime/member_status (maybe/is_some (goo_runtime/record .x target state)) source target state
  + member_status
    \ available=bool source=path target=path state=namespace
    ^ json
    = face (sovereign_peek target state).fil.fall(myth/new).path_at(system_vocabulary/face)
    | json/obj
      [(jkv "face" (json/str (face.run(path_show).fall(""))))
       (jkv "key" (json/str (path_show target)))
       (jkv "subject" (json/str (path_show target)))
       (jkv "source" (json/str (path_show source)))
       (jkv "sourceLife" (json/str (nat/show (goo_runtime/lifetime source state))))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime target state))))
       (jkv "type" (json/str "namespace-record"))
       (jkv "expected" (json/str (nat/show (state.case(.x target)).fall(state.local.top))))
       (jkv "status" (json/str (? available "available" "unavailable")))]
  + axis
    \ query=goo_runtime/request
    ^ str
    = values query.inputs.keep((\ [key value] (eq key "$axis")))
    ? (eq values.len 0) "z"
    = [key value] values.at(0)
    value
  + projection
    \ axis=str source=path state=namespace
    ^ axal[myth]
    | sovereign_care (? (eq axis "x") .x (? (eq axis "y") .y .z)) source state
  + projected_paths
    ' Walk the projection's tree directly; do not flatten and rebuild it.
    \ root=axal[myth] path=path
    ^ list[path]
    % pending=list[[path axal[myth]]] (list/one [path root]) out=list[path] .nil
    ^ list[path]
    ? (pending.is_nil || (ge out.len 65)) out.reverse
    = [path node] pending.head
      children (node.kid.range_after(.none (sub 65 out.len))).stream.map((\ entry [path.snoc(entry.key) (unpin entry.val.held)]))
    | _ children.weld(pending.tail) out.cons(path)
  + projected_source
    \ tree=bool query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/projected_source_value tree query state)

  + projected_source_value
    \ tree=bool query=goo_runtime/request state=namespace
    ^ json
    = source query.target
      axis (goo_runtime/axis query)
      projected (goo_runtime/projection axis source state)
      paths=list[path]
        ? !(projected.wyt) .nil
        ? tree (goo_runtime/projected_paths projected source)
        | projected.kid.range_after(.none 65).stream.map((\ entry source.snoc(entry.key)))
      members
        | paths.take(64).map
          \ path
          = member (goo_runtime/member_status (maybe/is_some projected.dip(path.drop(source.len)).fil) source path state)
          > (json/obj fields) member member
          = fields fields.snoc((jkv "axis" (json/str axis)))
          ? !tree (json/obj fields)
          | json/obj fields.snoc((jkv "topology" (json/str "tree"))).snoc((jkv "parent" (? (equal path source) jnull (json/str (path_show path.take(path.len.dec))))))
    | json/obj
      [(jkv "id" (json/str (path_show source)))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime source state))))
       (jkv "type" (json/str "namespace-record"))
       (jkv "axis" (json/str axis))
       (jkv "topology" (json/str (? tree "tree" "children")))
       (jkv "bounded" (json/boo (le paths.len 64)))
       (jkv "members" (json/arr members.row))]

  + source
    \ query=goo_runtime/request state=namespace
    ^ str
    | goo_runtime/projected_source .false query state
  + tree_source
    \ query=goo_runtime/request state=namespace
    ^ str
    | goo_runtime/projected_source .true query state
  + input_text
    \ key=str query=goo_runtime/request
    ^ str
    = values query.inputs.keep((\ [name value] (eq name key)))
    ? !(eq values.len 1) ""
    = [name value] values.at(0)
    value
  + printable_path
    \ path=path
    ^ bool
    ? (Try path_show path)
     > (./ok _) .true
     > (./err _) .false
  + tree_page
    \ query=goo_runtime/request state=namespace
    ^ either[str str]
    < value (goo_runtime/tree_page_value query state)
    | ./ok (show value)

  + tree_page_value
    ' Page only immediate children. Continuations are tied to one namespace epoch.
    \ query=goo_runtime/request state=namespace
    ^ either[str json]
    = source query.target axis (goo_runtime/axis query)
      parent_text (goo_runtime/input_text "$parent" query)
      after_text (goo_runtime/input_text "$after" query)
      epoch (nat/show state.local.rec.len)
      expected (goo_runtime/input_text "$epoch" query)
    > (./some parent) (path_parse (? parent_text.len parent_text (path_show source))) (./err "Invalid tree parent.")
    ? !(pith_prefix source parent) (./err "Tree parent is outside its source.")
    ? (and expected.len !(eq expected epoch)) (./err "Tree changed; refresh its children.")
    ? (and after_text.len !(expected.len)) (./err "Tree continuation requires its epoch.")
    = projected (goo_runtime/projection axis source state)
      subtree projected.dip(parent.drop(source.len))
      after=maybe[path]
        ? !(after_text.len) .none
        ? (path_parse after_text)
         > (./some path) (./some path)
        | physical_key/decode after_text
    ? (and after_text.len (maybe/is_none after)) (./err "Invalid tree cursor.")
    ? (after.run((\ path !(and (eq path.len parent.len.inc) (pith_prefix parent path)))).fall(.false))
      | ./err "Tree cursor is outside its parent."
    ? !(subtree.wyt) (./err "Tree parent is unavailable.")
    = selected subtree.kid.range_after(after.run((\ path path.at(parent.len))) 65)
      count (? (gt selected.len 64) 64 selected.len)
      visible (selected.take(count).keep((\ entry (goo_runtime/printable_path parent.snoc(entry.key)))))
      continuation=either[str json]
        ? !(gt selected.len 64) (./ok jnull)
        ? (physical_key/encode parent.snoc(selected.at(count.dec).key))
         > (./ok cursor) (./ok (json/str cursor))
        | ./err "Tree cursor exceeds its key budget; use the physical debugger for this branch."
    < next continuation
    =
      describe
        \ path=path node=axal[myth]
        ^ json
        = member (goo_runtime/member_status (maybe/is_some node.fil) source path state)
        > (json/obj fields) member member
        | json/obj fields.weld([(jkv "axis" (json/str axis)) (jkv "topology" (json/str "tree"))
            (jkv "parent" (? (equal path source) jnull (json/str (path_show path.take(path.len.dec)))))
            (jkv "hasChildren" (json/boo (gt node.kid.size 0)))])
      members (visible.map((\ entry (describe parent.snoc(entry.key) (unpin entry.val.held)))))
      members (? (and !(parent_text.len) !(after_text.len)) members.cons((describe source projected)) members)
    | ./ok (json/obj [(jkv "id" (json/str (path_show source)))
        (jkv "life" (json/str (nat/show (goo_runtime/lifetime source state))))
        (jkv "type" (json/str "namespace-record")) (jkv "axis" (json/str axis))
        (jkv "topology" (json/str "tree")) (jkv "incremental" (json/boo .true))
        (jkv "bounded" (json/boo .true)) (jkv "epoch" (json/str epoch))
        (jkv "omitted" (json/num .false (sub count visible.len)))
        (jkv "parent" (json/str (path_show parent))) (jkv "next" next)
        (jkv "members" (json/arr members))])

  + status
    \ query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/status_value query state)

  + status_value
    \ query=goo_runtime/request state=namespace
    ^ json
    = target (goo_runtime/target query.target state)
      expected=nat
        ? target
         > (./some target) (state.case(.x target)).fall(0)
        0
    | json/obj
      [(jkv "projectionSeq" (json/num .false state.local.rec.len))
       (jkv "coveredOperationIds" (json/arr ((goo_runtime/journal state).keep((\ entry (equal entry.request.target query.target))).map((\ entry (json/str entry.identity))).row)))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime query.target state))))
       (jkv "subject" (json/str (path_show query.target)))
       (jkv "target" (json/str (path_show target.fall([]))))
       (jkv "expected" (json/str (nat/show expected)))
       (jkv "displayed" (json/str (nat/show (state.case(.y query.target)).fall(0))))
       (jkv "recipePublication" (json/str (nat/show (? query.view.len (state.case(.x query.view)).fall(0) (goo_runtime/publication state)))))
       (jkv "publication" (json/str (nat/show (goo_runtime/publication state))))]

  + json_field
    \ key=str value=json
    ^ json
    > (json/obj entries) value jnull
    | entries.fold jnull (\ out entry (? (eq entry.k key) entry.v out))
  + json_text
    \ value=json
    ^ str
    > (json/str text) value ""
    text
  + capture_value
    \ input=row[[str str]] slot=path
    ^ either[str json]
    = matches (input.keep((\ [key value] (eq key (path_show slot)))))
    ? !(eq matches.len 1) (./err "Missing or duplicate selection capture.")
    = [key text] matches.at(0)
    > (jres/ok value rest) (json_source/parse text) (./err "Invalid selection capture.")
    | ./ok (goo_runtime/json_field "member" value)
  + operand_path
    \ expression=rex
    ^ maybe[path]
    ? (goo_runtime/read_path expression)
     > (./some path) (./some path)
    % rest=row[rex] expression.children
    ^ maybe[path]
    ? (eq rest.len 0) .none
    ? (goo_runtime/operand_path rest.at(0))
     > (./some path) (./some path)
    | _ rest.drop(1)
  + source_path
    \ published=goo/published card=myth expression=rex
    ^ maybe[path]
    ? (goo_runtime/read_path expression)
     > (./some path) (./some path)
    > (./nest _ _ rune kids) expression .none
    ? !(and (eq rune ".") (eq kids.len 2)) .none
    ? !(eq kids.at(0).print published.view.binding) .none
    = fields published.fields.keep((\ field (eq field.name kids.at(1).print)))
    ? !(eq fields.len 1) .none
    > (./some held) card.get(fields.at(0).slot) .none
    > value=pails/p held .none
    | ./some value.p
  + source_arguments
    \ published=goo/published card=myth node=goo/node
    ^ either[str list[rex]]
    ? !((eq node.constructor "selection") || (grove_views/topos node.constructor) || (eq node.constructor "navigate")) (./ok node.arguments)
    > (./some expression) (goo_runtime/named "source" node.arguments) (./err "Missing pane source.")
    > (./some path) (goo_runtime/source_path published card expression) (./err "Pane source has no path value.")
    = rewrite
        \ argument=rex
        ^ rex
        ? (maybe/is_some (goo_runtime/named "source" (list/one argument)))
          | rex/rune "=" [(rex/word "source") (rex/quip (str/cat_all ["'" (path_show path)]))]
        argument
    | ./ok node.arguments.map(rewrite)
  + bind_sources
    \ published=goo/published card=myth nodes=list[goo/node]
    ^ either[str list[goo/node]]
    ? nodes.is_nil (./ok .nil)
    = node nodes.head
    < children (goo_runtime/bind_sources published card node.children)
    < arguments (goo_runtime/source_arguments published card node)
    < tail (goo_runtime/bind_sources published card nodes.tail)
    | ./ok tail.cons(node.set_arguments(arguments).set_children(children))
  + selection_source
    \ key=path nodes=list[goo/node] route=row[nat] found=maybe[path]
    ^ maybe[path]
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) .none
    = node nodes.at(route.at(0))
      next=maybe[path]
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        > (./some source) (goo_runtime/named "source" node.arguments) .none
        | goo_runtime/read_path source
    | goo_runtime/selection_source key node.children route.drop(1) next
  + selection_tree
    \ key=path nodes=list[goo/node] route=row[nat] found=bool
    ^ bool
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) .false
    = node nodes.at(route.at(0))
      next=bool
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        | eq (goo_runtime/named "topology" node.arguments).fall((rex/cord "children")).print (rex/cord "tree").print
    | goo_runtime/selection_tree key node.children route.drop(1) next
  + selection_axis
    \ key=path nodes=list[goo/node] route=row[nat] found=str
    ^ str
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) ""
    = node nodes.at(route.at(0))
      next=str
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        = value (goo_runtime/named "axis" node.arguments).fall((rex/cord "z"))
        > (./leaf _ _ text) value ""
        text
    | goo_runtime/selection_axis key node.children route.drop(1) next
  + bound_captures
    \ nodes=list[goo/node] route=row[nat] fields=list[rex] input=row[[str str]]
    ^ either[str unit]
    ? fields.is_nil (./ok [])
    > (./nest _ _ rune kids) fields.head (goo_runtime/bound_captures nodes route fields.tail input)
    ? !(and (eq rune "=") (eq kids.len 2)) (goo_runtime/bound_captures nodes route fields.tail input)
    ? !(goo_runtime/mentions "capture" kids.at(1)) (goo_runtime/bound_captures nodes route fields.tail input)
    > (./some key) (goo_runtime/operand_path kids.at(1)) (./err "Capture must name a lexical selection.")
    > (./some source) (goo_runtime/selection_source key nodes route .none) (./err "Capture selection is not in scope.")
    > (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Invalid capture slot.")
    < member (goo_runtime/capture_value input slot)
    ? !(eq (path_show source) (goo_runtime/json_text (goo_runtime/json_field "source" member)))
      | ./err "Capture source does not match the published selection declaration."
    > (./some subject) (path_parse (goo_runtime/json_text (goo_runtime/json_field "subject" member))) (./err "Invalid capture subject.")
    = axis (goo_runtime/json_text (goo_runtime/json_field "axis" member))
    ? !(eq (goo_runtime/selection_axis key nodes route "z") (? axis.len axis "z"))
      | ./err "Capture axis does not match the published selection declaration."
    = tree (goo_runtime/selection_tree key nodes route .false)
    ? !(eq tree (eq (goo_runtime/json_text (goo_runtime/json_field "topology" member)) "tree"))
      | ./err "Capture topology does not match the published selection declaration."
    ? !(and (pith_prefix source subject) (tree || (eq subject.len source.len.inc)))
      | ./err "Capture is outside the declared source topology."
    | goo_runtime/bound_captures nodes route fields.tail input
  + validate_captures
    \ input=row[[str str]] fields=list[rex] state=namespace
    ^ either[str unit]
    ? fields.is_nil (./ok [])
    = field fields.head
    > (./nest _ _ rune kids) field (goo_runtime/validate_captures input fields.tail state)
    ? !(and (eq rune "=") (eq kids.len 2)) (goo_runtime/validate_captures input fields.tail state)
    ? !(goo_runtime/mentions "capture" kids.at(1)) (goo_runtime/validate_captures input fields.tail state)
    > (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Invalid capture argument slot.")
    < value (goo_runtime/capture_value input slot)
    = text (\ key=str (goo_runtime/json_text (goo_runtime/json_field key value)))
    > (./some source) (path_parse (text "source")) (./err "Invalid capture source.")
    > (./some subject) (path_parse (text "subject")) (./err "Invalid capture subject.")
    ? !(and (eq (text "type") "namespace-record") (eq (text "key") (path_show subject)))
      | ./err "Incompatible capture membership."
    = tree (eq (text "topology") "tree")
      axis_text=str (text "axis")
      axis=str (? (gt axis_text.len 0) axis_text "z")
      projected (goo_runtime/projection axis source state)
      belongs=bool
        ? !tree (and (and (eq subject.len source.len.inc) (pith_prefix source subject)) (maybe/is_some projected.dip(subject.drop(source.len)).fil))
        | and (pith_prefix source subject) (maybe/is_some projected.dip(subject.drop(source.len)).fil)
    ? !belongs
      | ./err "Capture is not a member of its finite source."
    ? !(and (state.permitted(subject)) (pith_prefix [state.self 'app] subject))
      | ./err "Captured subject is outside application authority."
    ? !(and (eq (text "life") (nat/show (goo_runtime/lifetime subject state)))
         (eq (text "sourceLife") (nat/show (goo_runtime/lifetime source state))))
      | ./err "Captured membership was removed or replaced."
    ? !(eq (text "expected") (nat/show (state.case(.x subject)).fall(0)))
      | ./err "Captured subject changed before admission."
    ? (maybe/is_none (goo_runtime/record .x subject state)) (./err "Captured subject is unavailable.")
    ? !(projected.wyt) (./err "Captured source is unavailable.")
    | goo_runtime/validate_captures input fields.tail state
  + argument
    \ published=myth input=row[[str str]] now=nat slot=path value=rex
    ^ either[str pail]
    ? (goo_runtime/mentions "capture" value)
      < member (goo_runtime/capture_value input slot)
      > (./some subject) (path_parse (goo_runtime/json_text (goo_runtime/json_field "subject" member)))
        | ./err "Invalid captured subject."
      | ./ok (pails/p subject)
    ? (goo_runtime/mentions "provider" value)
      ? !(equal[path] slot system_vocabulary/now) (./err "Unknown provider; only /sys/now is available.")
      | ./ok (pails/dm (add (quip_val '@1970.1.1..0.0.0) (mul now 1024)))
    ? (goo_runtime/mentions "input" value)
      = matches (input.keep((\ [key value] (equal[str] key (path_show slot)))))
      ? !(eq matches.len 1) (./err "Missing or duplicate input value.")
      = [key text] matches.at(0)
      | ./ok (pails/t text)
    ? (equal[maybe[str]] value.leaf_kind (maybe/some[str] "cord"))
      > (./leaf _ _ text) value (./err "Invalid text argument.")
      | ./ok (pails/t text)
    > (./some path) (goo_runtime/read_path value) (./err "Unsupported action argument.")
    > (./some held) published.get(grove_view_publication/constants_slot)
      | ./err "Missing compiled action constants."
    > constants=grove_view_constants held (./err "Invalid compiled action constants.")
    > (./some value) constants.values.get(path) (./err "Unknown compiled action constant.")
    | ./ok value
  + arguments
    \ published=myth input=row[[str str]] now=nat fields=list[rex]
    ^ either[str myth]
    % rest=list[rex] fields out=myth myth/new
    ^ either[str myth]
    ? (eq rest.len 0) (./ok out)
    > (./nest _ _ rune kids) rest.at(0) (./err "Invalid action binding.")
    ? !(and (eq rune "=") (eq kids.len 2)) (./err "Invalid action binding.")
    > (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Expected an argument slot path.")
    < value (goo_runtime/argument published input now slot kids.at(1))
    | _ rest.drop(1) out.put(slot value)
  + published
    \ record=myth
    ^ either[str goo/published]
    > (./some held) record.get(system_vocabulary/grove/view) (./err "Not a published view.")
    > view=goo/published held (./err "Invalid published view.")
    | ./ok view
  + matching_view
    \ published=goo/published current=myth
    ^ either[str goo/view]
    ? (maybe/is_some (fit_check current.put(system_vocabulary/lash published.contract))) (./err "Object no longer matches this view.")
    > (./ok lowered) published.result (./err "View has compiler errors.")
    < children (goo_composition/nodes published current lowered.children 0)
    | ./ok lowered.set_children(children)
  + bound_control
    \ binding=str found=[goo/node goo_runtime/scope]
    ^ either[str [goo/node goo_runtime/scope]]
    = [node scope] found
    ? !(eq node.constructor "action") (./err "Expected an action control.")
    ? (maybe/is_some (goo_runtime/named "write" node.arguments))
      | ./err "Context writes require the authenticated context bridge; this invoke adapter cannot execute them."
    ? (maybe/is_some scope.make)
      ? ((maybe/is_some scope.receiver) || (maybe/is_some scope.action)) (./err "make cannot be combined with on or action.")
      ? (maybe/is_none scope.role) (./err "make requires a role.")
      | ./ok found
    > (./some receiver) scope.receiver (./err "Action group requires on = receiver.")
    ? !(eq receiver.print binding) (./err "Only the current receiver is supported.")
    | ./ok found
  + control
    \ query=goo_runtime/request published=goo/published current=myth
    ^ either[str [goo/node goo_runtime/scope]]
    < lowered (goo_runtime/matching_view published current)
    = empty=goo_runtime/scope (goo_runtime/scope .none .none .nil .none .none .none)
    > (./some found) (goo_runtime/locate lowered.children query.control empty)
      | ./err "Unknown control."
    | goo_runtime/bound_control published.view.binding found
  + dispatch
    \ action=rex arguments=myth current=myth contract=lash state=namespace
    ^ either[str myth]
    ? (goo_runtime/mentions "poke" action)
      = next current.meld(arguments)
      ? (maybe/is_some (fit_check next.put(system_vocabulary/lash contract))) (./err "Edited fields violate the view's role.")
      | ./ok next
    > (./some path) (goo_runtime/read_path action) (./err "Invalid action reference.")
    > (./some declaration) (goo_runtime/record .x path state) (./err "Action no longer exists.")
    > (./some held) declaration.get(system_vocabulary/grove/action_handler) (./err "Action has no compiled handler.")
    > handler=grove_action_handler held (./err "Invalid compiled action handler.")
    = invoke handler.apply
    > (./ok result) (Try (invoke arguments) current) (./err "Action failed during execution; the object was not changed.")
    > (./some next) result (./err "Action rejected its arguments or receiver.")
    | ./ok next
  + argument_binding
    ' Surface metadata never becomes domain operation input.
    \ arg=rex
    ^ bool
    > (./nest _ _ rune kids) arg .true
    ? !(and (eq rune "=") (eq kids.len 2)) .true
    = keys=row[str] ["become" "invoke" "write" "pail" "role" "treatment" "significance" "label" "key" "default" "context"]
    | !(keys.has(kids.at(0).print))
  + path_input
    \ slot=path nodes=list[goo/node]
    ^ maybe[goo/node]
    % rest=list[goo/node] nodes
    ^ maybe[goo/node]
    ? rest.is_nil .none
    = node rest.head
    ? (and (eq node.constructor "input") (and node.arguments.len (equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] slot)))) (./some node)
    ? (goo_runtime/path_input slot node.children)
     > (./some found) (./some found)
    | _ rest.tail
  + typed_arguments
    \ nodes=list[goo/node] arguments=myth current=myth state=namespace
    ^ either[str myth]
    % rest=row[mop/kv[path pail]] arguments.tap out=myth arguments
    ^ either[str myth]
    ? !(rest.len) (./ok out)
    = entry rest.at(0)
    > (./some node) (goo_runtime/path_input entry.key nodes) (_ rest.drop(1) out)
    ? !(eq (goo_vocabulary/attr "kind" node) "path") (_ rest.drop(1) out)
    ? !(and (eq (goo_vocabulary/attr "many" node) "1") (and (eq (goo_vocabulary/attr "care" node) "choose") (row/has[str] (goo_vocabulary/attr "access" node) ["read" "write"]))) (./err "Unsupported path input capability.")
    > text=pails/t entry.val (./err "Expected a versioned path input payload.")
    < values (goo_paths/decode text.t)
    = write (eq (goo_vocabulary/attr "access" node) "write")
    < valid (goo_paths/validate values write state)
    = checked=either[str unit]
        > (./some held) current.get(['sys 'goo 'path_policy]) (./ok [])
        > policy=goo_paths/policy held (./err "Invalid path input policy.")
        = check policy.check
        | check values write state
    < checked checked
    | _ rest.drop(1) out.put(entry.key values)
  + prepared
    \ query=goo_runtime/request published=myth current=myth state=namespace
    ^ either[str myth]
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
      bindings=list[rex] (node.arguments.drop(1).keep(goo_runtime/argument_binding))
    < lowered (goo_runtime/matching_view view current)
    < nodes (goo_runtime/bind_sources view current lowered.children)
    < bound (goo_runtime/bound_captures nodes query.control scope.values.weld(bindings) query.inputs)
    < validated (goo_runtime/validate_captures query.inputs scope.values.weld(bindings) state)
    < arguments (goo_runtime/arguments published query.inputs query.now scope.values.weld(bindings))
    | goo_runtime/typed_arguments nodes arguments current state
  + updated
    \ query=goo_runtime/request published=myth current=myth state=namespace
    ^ either[str myth]
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
    = own_action (goo_runtime/named "invoke" node.arguments)
      operation (? (maybe/is_some own_action) own_action scope.action)
    > (./some action) operation (./err "Action group requires an action.")
    < arguments (goo_runtime/prepared query published current state)
    | goo_runtime/dispatch action arguments current view.contract state
  + child_identity
    ' A single bounded, canonical component; the client cannot supply a path.
    \ identity=str
    ^ bool
    ? ((eq identity.len 0) || (gt identity.len 96)) .false
    % i=nat 0
    ? (eq i identity.len) .true
    = c identity.at(i)
    ? !((eq c 45) || ((and (ge c 48) (le c 57)) || (and (ge c 97) (le c 122)))) .false
    | _ i.inc
  + child_key
    \ identity=str
    ^ iota
    = component=str
        % i=nat 0 out=list[str] .nil
        ? (eq i identity.len) (str/cat_all out.row)
        | _ i.inc out.snoc((? (eq identity.at(i) 45) "_" identity.slice(i 1)))
    | $ts (str/to_atom (str/cat_all ["entry_" component]))
  + creation_target
    \ query=goo_runtime/request base=path allocation=maybe[rex]
    ^ either[str path]
    > (./some mode) allocation (./ok base)
    ? !(eq mode.print (rex/cord "child").print) (./err "Unknown creation allocation.")
    ? !(equal base query.subject) (./err "Child creation must be anchored to the bound receiver.")
    = identities (query.inputs.keep((\ [key value] (eq key "$invocation"))))
    ? !(eq identities.len 1) (./err "Child creation requires one invocation identity.")
    = [key identity] identities.at(0)
    ? !(goo_runtime/child_identity identity) (./err "Invalid child creation identity.")
    | ./ok base.snoc((goo_runtime/child_key identity))
  + create
    \ query=goo_runtime/request published=myth current=myth state=namespace scope=goo_runtime/scope
    ^ either[str namespace]
    < view (goo_runtime/published published)
    > (./some expression) scope.make (./err "Missing creation destination.")
    = destination=maybe[path]
        ? (eq expression.print view.view.binding) (./some query.subject)
        | goo_runtime/source_path view current expression
    > (./some target) destination (./err "Creation destination must be the bound receiver or have a path value.")
    < target (goo_runtime/creation_target query target scope.allocation)
    ? !(and state.permitted(target) (pith_prefix [state.self 'app] target)) (./err "Creation destination is outside application authority.")
    ? (sovereign_peek target state).wyt (./err "Creation destination is occupied.")
    > (./some expression) scope.role (./err "Missing creation role.")
    > (./some role_path) (goo_runtime/read_path expression) (./err "Creation role must be a declaration path.")
    > (./some role) (goo_runtime/record .x role_path state) (./err "Creation role is unavailable.")
    > (./some held) role.get(system_vocabulary/grove/role_contract) (./err "Creation role has no contract.")
    > contract=lash held (./err "Invalid creation role contract.")
    < arguments (goo_runtime/prepared query published current state)
    = next arguments.put(system_vocabulary/lash contract)
    ? (maybe/is_some (fit_check next)) (./err "Initial fields violate the creation role.")
    ? (grove_install/change target (writ/make next) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))
  + commit_hook
    ' Trusted receiver continuation, inside admission and the exact-retry receipt.
    : apply={\ path namespace namespace}either[str namespace]
  + committed
    \ target=path current=myth original=namespace next=namespace
    ^ either[str namespace]
    > (./some held) current.get(['sys 'goo 'commit]) (./ok next)
    > hook=goo_runtime/commit_hook held (./err "Invalid receiver commit hook.")
    = apply hook.apply
    | apply target original next
  + apply
    \ query=goo_runtime/request state=namespace
    ^ either[str namespace]
    ? !(eq query.publication (goo_runtime/publication state)) (./err "Views changed; refresh before submitting.")
    ? !(eq query.displayed (state.case(.y query.target)).fall(0)) (./err "Object changed; refresh before submitting.")
    > (./some target) (goo_runtime/target query.target state) (./err "This presentation has no writable source object.")
    ? !(equal[path] target query.subject) (./err "The presentation now refers to a different object; refresh before submitting.")
    ? !(state.permitted(target)) (./err "Object is outside this namespace's authority.")
    ? !(pith_prefix [state.self 'app] target) (./err "Only application objects are writable here.")
    ? !(eq query.expected (state.case(.x target)).fall(0)) (./err "Object changed; refresh before submitting.")
    > (./some current) (goo_runtime/record .x target state) (./err "Object no longer exists.")
    > (./some published) (goo_runtime/record .x query.view state) (./err "View no longer exists.")
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
    ? (maybe/is_some scope.make) (goo_runtime/create query published current state scope)
    < next (goo_runtime/updated query published current state)
    ? (grove_install/change target (writ/make next) state)
     > (./ok next) (goo_runtime/committed target current state next)
     > (./err why) (./err (str/from_atom (iota_show why)))
  + receipt
    : identity=str request=goo_runtime/request body=str
  + receipts
    : entries=list[goo_runtime/receipt]
  + receipt_slot
    ^ path
    system_vocabulary/goo/receipts
  + journal
    \ state=namespace
    ^ list[goo_runtime/receipt]
    = record (goo_runtime/record .x [state.self 'weft 'goo_receipts] state).fall(myth/new)
    > (./some held) record.get(goo_runtime/receipt_slot) .nil
    > receipts=goo_runtime/receipts held .nil
    receipts.entries
  + operation_status
    \ query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/operation_status_value query state)

  + operation_status_value
    \ query=goo_runtime/request state=namespace
    ^ json
    = ids (query.inputs.keep((\ [key value] (eq key "$invocation"))))
      identity=str
        ? !(eq ids.len 1) ""
        = [key value] ids.at(0)
        value
      matches ((goo_runtime/journal state).keep((\ entry (and (eq entry.identity identity) (equal entry.request.target query.target)))))
    | json/obj [(jkv "operationId" (json/str identity))
        (jkv "outcome" (json/str (? matches.is_nil "unknown" "accepted")))]

  + act
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat str]
    = identities (query.inputs.keep((\ [key value] (eq key "$invocation"))))
      identity=str
        ? (eq identities.len 1)
          = [key value] identities.at(0)
          value
        ""
      home=path [state.self 'weft 'goo_receipts]
      journal (goo_runtime/record .x home state).fall(myth/new)
      entries=list[goo_runtime/receipt]
        > (./some held) journal.get(goo_runtime/receipt_slot) .nil
        > receipts=goo_runtime/receipts held .nil
        receipts.entries
      prior (entries.keep((\ entry (eq entry.identity identity))))
      request query.set_now(0)
    ? (and (gt identity.len 0) (gt prior.len 0))
      ? (equal request prior.head.request) [state 200 prior.head.body]
      [state 409 (show (json/obj [(jkv "error" (json/str "Invocation identity was reused with changed arguments."))]))]
    ? (and (gt identity.len 0) (ge entries.len 1024))
      [state 409 (show (json/obj [(jkv "error" (json/str "Development invocation journal is full; restart the namespace."))]))]
    ? (goo_runtime/apply query state)
     > (./ok next)
      = body (goo_runtime/status query next)
      ? (eq identity.len 0) [next 200 body]
      = record (journal.put(goo_runtime/receipt_slot
          (goo_runtime/receipts entries.snoc((goo_runtime/receipt identity request body)))))
      ? (grove_install/change home (writ/make record) next)
       > (./ok committed) [committed 200 body]
       > (./err _) [state 409 (show (json/obj [(jkv "error" (json/str "Unable to retain invocation receipt."))]))]
     > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
  + run
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat str]
    ? (eq query.operation "edit-value")
      > (./some slot) (path_parse (goo_runtime/input_text "slot" query))
        [state 400 (show (json/obj [(jkv "error" (json/str "Invalid slot path."))]))]
      = context (goo_runtime/input_text "context" query)
      > (./some scope) (? context.len (path_parse context) (maybe/some[path] []))
        [state 400 (show (json/obj [(jkv "error" (json/str "Invalid Foil context path."))]))]
      ? (goo_value/edit query.target slot query.expected (goo_runtime/input_text "kind" query)
          (goo_runtime/input_text "value" query) scope state)
       > (./ok next) [next 200 (goo_runtime/status query next)]
       > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
    ? (eq query.operation "operation-status") [state 200 (goo_runtime/operation_status query state)]
    ? (eq query.operation "status") [state 200 (goo_runtime/status query state)]
    ? (eq query.operation "tree-page")
      ? (goo_runtime/tree_page query state)
       > (./ok body) [state 200 body]
       > (./err why) [state 409 why]
    ? (eq query.operation "tree-source") [state 200 (goo_runtime/tree_source query state)]
    ? (eq query.operation "source") [state 200 (goo_runtime/source query state)]
    ? !(eq query.operation "act") [state 400 "{}"]
    | goo_runtime/act query state

  + run_value
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat json]
    ? (eq query.operation "source") [state 200 (goo_runtime/projected_source_value .false query state)]
    ? (eq query.operation "tree-source") [state 200 (goo_runtime/projected_source_value .true query state)]
    ? (eq query.operation "status") [state 200 (goo_runtime/status_value query state)]
    ? (eq query.operation "operation-status") [state 200 (goo_runtime/operation_status_value query state)]
    ? (eq query.operation "tree-page")
      ? (goo_runtime/tree_page_value query state)
       > (./ok value) [state 200 value]
       > (./err why) [state 409 (json/obj [(jkv "error" (json/str why))])]
    ' Action receipts retain their existing persisted representation and equality.
    = [next status body] (goo_runtime/run query state)
    ? (parse body)
     > (jres/ok value rest) [next status value]
    [next status (json/obj [(jkv "error" (json/str body))])]

' --- grove_dev ---

+ grove_dev
  + request
    : operation=str source=path target=path version=nat expected=maybe[nat] selected=path scan=nat
  + unit
    : source=path home=path name=str files=row[str]
  + metadata_slot
    ^ path
    system_vocabulary/fs/source/manifest
  + slot
    \ name=iota
    ^ path
    | system_vocabulary/source_slot name
  + field
    \ name=str value=json
    ^ json
    > (json/obj entries) value jnull
    | entries.fold jnull (\ out entry (? (equal name entry.k) entry.v out))
  + text
    \ value=json
    ^ str
    > (json/str text) value ""
    text
  + items
    \ value=json
    ^ row[json]
    > (json/arr values) value []
    values
  + record
    \ target=path state=namespace
    ^ myth
    | (sovereign_care .x target state).fil.fall(myth/new)
  + mount_units
    \ home=path record=myth self=iota
    ^ row[grove_dev/unit]
    > (jres/ok manifest rest) (json_source/parse (record.txt_at(grove_dev/metadata_slot))) []
    = name (grove_dev/text (grove_dev/field "name" manifest))
      entries (grove_dev/items (grove_dev/field "grove" manifest))
    | entries.map
      \ entry=json
      = root (grove_dev/items (grove_dev/field "root" entry))
        components=path
          | root.map
            \ part=json
            ^ iota
            | $ts (grove_dev/text part)
        source=path components.cons(self)
        files ((grove_dev/items (grove_dev/field "files" entry)).map(grove_dev/text))
      | grove_dev/unit source home name files
  + units
    \ state=namespace
    ^ row[grove_dev/unit]
    = tree (sovereign_care .y [state.self 'io 'fs] state)
    | tree.kid_tap.bind
      \ [key child]
      | grove_dev/mount_units [state.self 'io 'fs key] child.fil.fall(myth/new) state.self
  + origin
    \ record=myth
    ^ maybe[safe]
    > (./some held) record.get(grove_templates/source_slot) .none
    > source=safe held .none
    | ./some source
  + enclosing
    \ selected=path state=namespace
    ^ path
    % length=nat selected.len
    ? (lt length 3) []
    = root selected.take(length)
    ? (maybe/is_some (grove_dev/origin (grove_dev/record root state))) root
    | _ length.dec
  + number
    \ value=nat
    ^ json
    | json/str (nat/show value)
  + optional
    \ value=maybe[nat]
    ^ json
    | value.run(grove_dev/number).fall(jnull)
  + unit_json
    \ unit=grove_dev/unit state=namespace
    ^ json
    = mount (grove_dev/record unit.home state)
      record (grove_dev/record unit.source state)
      version (state.case(.x unit.source))
      present (record.has(grove_templates/slot))
    | json/obj
      [(jkv "source" (json/str (path_show unit.source)))
       (jkv "home" (json/str (path_show unit.home)))
       (jkv "mount" (json/str unit.name))
       (jkv "files" (json/arr (unit.files.map((\ file (json/str file))))))
       (jkv "version" (grove_dev/optional (? present version .none)))
       (jkv "requested" (grove_dev/number (mount.nat_at(bond/epoch 0))))
       (jkv "completed" (grove_dev/number (mount.nat_at((grove_dev/slot 'epoch) 0))))
       (jkv "ready" (json/boo !(eq (mount.nat_at((grove_dev/slot 'ready) 0)) 0)))
       (jkv "message" (json/str (mount.txt_at((grove_dev/slot 'message)))))
       (jkv "diagnostic" (json/str (mount.txt_at((grove_dev/slot 'diagnostic_text)))))]
  + status
    \ query=grove_dev/request state=namespace
    ^ str
    = located (grove_dev/enclosing query.selected state)
      target (? query.target.len query.target located)
      record (grove_dev/record target state)
      origin (grove_dev/origin record)
      source=path
        ? origin
         > (./some reference) reference.path
        query.source
      installed=maybe[nat]
        ? origin
         > (./some reference) (./some reference.ver)
        .none
    | show (json/obj
      [(jkv "units" (json/arr ((grove_dev/units state).map((\ unit (grove_dev/unit_json unit state))))))
       (jkv "source" (json/str (path_show source)))
       (jkv "root" (json/str (path_show target)))
       (jkv "installed" (grove_dev/optional installed))
       (jkv "expected" (grove_dev/optional (state.case(.z target))))
       (jkv "occupied" (json/boo (? target.len !(eq (sovereign_peek target state).wyt 0) .false)))
       (jkv "selected" (json/str (path_show (? (maybe/is_some (sovereign_care .x query.selected state).fil) query.selected target))))])
  + apply
    \ query=grove_dev/request state=namespace
    ^ either[iota namespace]
    = matches ((grove_dev/units state).keep((\ unit (equal unit.source query.source))))
    ? !(eq matches.len 1) (./err 'unknown_grove_source)
    = unit matches.at(0)
      mount (grove_dev/record unit.home state)
    ? (equal query.operation "rescan")
      ? !(eq query.scan (mount.nat_at(bond/epoch 0))) (./err 'stale_scan)
      | grove_install/change unit.home (writ/warp unit.home.weld(['op 'rescan]) myth/new) state
    ? (equal query.operation "delete")
      | grove_install/remove query.source query.target query.expected state
    ? !(equal (maybe/some[nat] query.version) (state.case(.x query.source))) (./err 'stale_template)
    ? !(eq query.scan (mount.nat_at((grove_dev/slot 'epoch) 0))) (./err 'stale_publication)
    ? !(eq query.scan (mount.nat_at(bond/epoch 0))) (./err 'publication_pending)
    ? (eq (mount.nat_at((grove_dev/slot 'ready) 0)) 0) (./err 'publication_failed)
    ? (equal query.operation "replace")
      | grove_install/replace query.source query.version query.target query.expected state
    ? (equal query.operation "install")
      < checked (grove_install/validate_instance query.source query.target query.expected state)
      | grove_install/instantiate query.source query.version query.target state
    | ./err 'unknown_development_operation
  + run
    \ query=grove_dev/request state=namespace
    ^ [namespace nat str]
    ? (equal query.operation "status") [state 200 (grove_dev/status query state)]
    ? (grove_dev/apply query state)
     > (./ok next) [next 200 (grove_dev/status query next)]
     > (./err why)
      [state 409 (show (json/obj [(jkv "error" (json/str (str/from_atom (iota_show why))))]))]

' --- physical_read ---

' Bounded physical selection, not a serialized debugger response. In
' particular a slot pail can be arbitrarily large, and an assertion holds
' a whole pinned record. Consumers must project bounded previews rather
' than show/serialize this internal page. Cold pin loading is not bounded
' by the number of selected entries. No x/y/z reinterpretation occurs.
+ physical_read
  + request
    : pax=path epoch=maybe[nat] collection=iota after=maybe[path] limit=nat
  + node
    ' Preserve unknown versus tombstone, and the actual assertion epoch.
    ' The count is physical keys, including transparent/history-only nodes.
    : assertion=maybe[ass] epoch=maybe[nat] children=nat
  + entry
    & physical_read/entry/child
      physical_read/entry/slot
    + child
      : key=iota node=physical_read/node
    + slot
      ' A path-shaped opaque slot key, never a relative namespace path.
      : key=path value=pail
  + page
    : pax=path epoch=nat collection=iota after=maybe[path] limit=nat total=nat
      next=maybe[path] own=physical_read/node entries=row[physical_read/entry]

  + lookup
    ' Unlike dip, retain the distinction between an absent physical key
    ' and an existing empty/transparent physical node. Never visit siblings.
    \ pax=path index=axal[tome]
    ^ maybe[axal[tome]]
    ? (eq pax.len 0) (./some index)
    > (./some child) index.kid_get(pax.at(0)) .none
    | _ pax.drop(1) child

  + describe
    ' One history floor lookup. Do not unpin the record, read its slots,
    ' enumerate care cases, evaluate metadata, or descend into children.
    \ epoch=nat source=axal[tome]
    ^ physical_read/node
    = history (tome/hist source.fil)
    > (./some entry) (ass/entry epoch history)
      | physical_read/node .none .none source.kid.size
    = [key assertion] entry
    | physical_read/node (./some assertion) (dig_of key) source.kid.size

  + record
    \ node=physical_read/node
    ^ res[pin[myth]]
    > (./some assertion) node.assertion .unknown
    ? assertion
     > (ass/ker version) (./known version.myth)
     > (ass/nul _) .null
     > (ass/past _) .unknown

  + children
    \ query=physical_read/request epoch=nat own=physical_read/node source=axal[tome]
    ^ physical_read/page
    = bound=maybe[iota] query.after.run((\ key=path key.at(0)))
      selected source.kid.range_after(bound query.limit.inc)
      count (? (lt selected.len query.limit) selected.len query.limit)
      next=maybe[path]
        ? (gt selected.len query.limit) (./some [selected.at(count.dec).key])
        .none
      entries
        % i=nat 0 out=row[physical_read/entry] []
        ? (eq i count) out
        = entry selected.at(i)
          node (physical_read/describe epoch (unpin entry.val.held))
        | _ i.inc out.snoc((physical_read/entry/child entry.key node))
    | physical_read/page query.pax epoch query.collection query.after query.limit
        source.kid.size next own entries

  + slots
    \ query=physical_read/request epoch=nat own=physical_read/node record=myth
    ^ physical_read/page
    = selected record.range_after(query.after query.limit.inc)
      count (? (lt selected.len query.limit) selected.len query.limit)
      next=maybe[path]
        ? (gt selected.len query.limit) (./some selected.at(count.dec).key)
        .none
      entries
        % i=nat 0 out=row[physical_read/entry] []
        ? (eq i count) out
        = entry selected.at(i)
        | _ i.inc out.snoc((physical_read/entry/slot entry.key entry.val))
    | physical_read/page query.pax epoch query.collection query.after query.limit
        record.size next own entries

  + read
    ' This first internal slice bounds traversal/selection only. HTTP
    ' transport, preview/key byte budgets, and operation registry paging
    ' are separate gates before the ordinary debugger can use this read.
    ' Continuations use the current index only at the exact captured epoch.
    ' Resolving old assertions from a newer index cannot recover old keys.
    \ query=physical_read/request state=sov
    ^ either[iota physical_read/page]
    ? ((eq query.limit 0) || (gt query.limit 40)) (./err 'invalid_limit)
    ? !((eq_iota query.collection 'children) || (eq_iota query.collection 'slots))
      | ./err 'invalid_collection
    ? !(value_read/physical query.pax) (./err 'derived_path)
    = after_valid=bool
        ? query.after
         > .none .true
         > (./some after)
           ? (eq_iota query.collection 'children) (eq after.len 1)
           .true
    ? !after_valid (./err 'invalid_cursor)
    = epoch_missing=bool
        ? (maybe/is_some query.after) (maybe/is_none query.epoch)
        .false
    ? epoch_missing (./err 'epoch_required)
    = epoch query.epoch.fall(state.top)
    ? !(eq epoch state.top) (./err 'epoch_conflict)
    > (./some source) (physical_read/lookup query.pax state.idx)
      | ./err 'path_missing
    = own (physical_read/describe epoch source)
    ? (eq_iota query.collection 'children)
      | ./ok (physical_read/children query epoch own source)
    ? (physical_read/record own)
     > .unknown (./err 'record_missing)
     > .null (./err 'record_deleted)
     > (./known held)
       | ./ok (physical_read/slots query epoch own (unpin held))
  + namespace_read
    ' The physical cursor is scoped to the selected authority's index.
    \ query=physical_read/request state=namespace
    ^ either[iota physical_read/page]
    ? (eq query.pax.len 0) (./err 'authority_required)
    ? !(value_read/physical query.pax) (./err 'derived_path)
    > (./some history) state.history(query.pax)
      | ./err 'unknown_authority
    | physical_read/read query history

' --- physical_projection ---

' Wire projection of physical reads, with bounded diagnostic code previews.
' No derived evaluation or descendant traversal.
+ physical_projection
  + max_bytes
    ^ nat
    131072
  + decimal
    ' Counters have a bounded canonical representation accepted by transport.
    \ value=nat
    ^ json
    ? (gt (wid value) 32) (json/str (str/from_atom (Throw 812)))
    | json/str (nat/show value)
  + optional_text
    \ text=maybe[str]
    ^ json
    | text.run((\ value=str (json/str value))).fall((json/nul 0))
  + bytes
    ' Raw scalar bytes are preserved even when not printable UTF-8. The
    ' frontend may decode only a valid prefix; completeness is explicit.
    \ kind=str value=nat
    ^ json
    = total (wid value)
      count (? (gt total 256) 256 total)
    | json/obj
      [(jkv "type" (json/str kind))
       (jkv "encoding" (json/str "hex"))
       (jkv "hex" (json/str (value_read/hex_slice value 0 count)))
       (jkv "total" (physical_projection/decimal total))
       (jkv "complete" (json/boo (eq count total)))]
  + opaque
    \ reason=str
    ^ json
    | json/obj [(jkv "type" (json/str "opaque")) (jkv "reason" (json/str reason))]
  + fallback
    \ reason=str held=pail
    ^ json
    > (./some preview) (value_preview/safe held) (physical_projection/opaque "preview_failed")
    | json/obj [(jkv "type" (json/str "opaque")) (jkv "reason" (json/str reason))
        (jkv "code" (json/str preview.text)) (jkv "truncated" (json/boo preview.clipped))]
  + value
    \ held=pail
    ^ json
    ? held
     > t=pails/t (physical_projection/bytes "text" (str/to_atom t.t))
     > n=pails/n (physical_projection/bytes "natural" n.n)
     > p=pails/p
       ? (physical_key/encode p.p)
        > (./err _) (physical_projection/fallback "key_too_large" held)
        > (./ok key)
          | json/obj
            [(jkv "type" (json/str "path"))
             (jkv "pathKey" (json/str key))
             (jkv "displayPath" (physical_projection/optional_text (physical_key/display p.p)))]
    ' A safe reference has care/version semantics; do not reduce it to path.
    | physical_projection/fallback "unsupported_type" held
  + kind
    \ record=myth
    ^ str
    ? (record.has(system_vocabulary/grove/role)) "role"
    ? (record.has(system_vocabulary/grove/action)) "action"
    ? (record.has(system_vocabulary/grove/norm)) "norm"
    ? (record.has(system_vocabulary/grove/sewn)) "sewn"
    ? (record.has(system_vocabulary/grove/template)) "template"
    = event=bool
        > (./some held) record.get(bond/content) .false
        > value=namespace_event held .false
        .true
    ? event "event"
    ? (record.has(['method])) "http"
    ? (record.has(bond/form)) "behavior"
    ? (record.has(system_vocabulary/grove/module)) "module"
    "record"
  + label
    \ record=myth
    ^ [value=json source=json]
    = lede=maybe[str]
        > (./some held) record.get(bond/lede) .none
        > text=pails/t held .none
        ? (eq text.t.len 0) .none
        | ./some text.t
    ? lede
     > (./some text)
       [(physical_projection/bytes "text" (str/to_atom text)) (json/str "lede")]
     > .none
       > (./some held) record.get(bond/help) [(json/nul 0) (json/nul 0)]
       > doc=lore held [(json/nul 0) (json/nul 0)]
       ? (eq doc.head.len 0) [(json/nul 0) (json/nul 0)]
       [(physical_projection/bytes "text" (str/to_atom doc.head)) (json/str "lore-head")]
  + help
    ' Select at most one line from the first four body entries. The line
    ' index makes this an authored excerpt, not a claim of full lore access.
    \ record=myth
    ^ [value=json source=json line=json]
    > (./some held) record.get(bond/help) [(json/nul 0) (json/nul 0) (json/nul 0)]
    ? held
     > text=pails/t
       [(physical_projection/bytes "text" (str/to_atom text.t)) (json/str "help-text") (json/nul 0)]
     > doc=lore
       = count (? (gt doc.body.len 4) 4 doc.body.len)
       % i=nat 0
       ^ [value=json source=json line=json]
       ? (eq i count)
         ? (eq doc.head.len 0) [(json/nul 0) (json/nul 0) (json/nul 0)]
         [(physical_projection/bytes "text" (str/to_atom doc.head)) (json/str "lore-head") (json/nul 0)]
       = line doc.body.at(i)
       ? (eq line.len 0) (_ i.inc)
       [(physical_projection/bytes "text" (str/to_atom line)) (json/str "lore-body") (json/num .false i)]
    [(json/nul 0) (json/nul 0) (json/nul 0)]
  + node
    \ node=physical_read/node
    ^ json
    = own (physical_read/record node)
      state=str
        ? own
         > .unknown "unknown"
         > .null "tombstone"
         > (./known _) "live"
      record=maybe[myth]
        ? own
         > (./known held) (./some (unpin held))
        .none
      label record.run(physical_projection/label).fall([(json/nul 0) (json/nul 0)])
      help record.run(physical_projection/help).fall([(json/nul 0) (json/nul 0) (json/nul 0)])
      [label_value label_source] label
      [help_value help_source help_line] help
    | json/obj
      [(jkv "state" (json/str state))
       (jkv "recordEpoch" (node.epoch.run(physical_projection/decimal).fall((json/nul 0))))
       (jkv "children" (physical_projection/decimal node.children))
       (jkv "fields" (record.run((\ card=myth (physical_projection/decimal card.size))).fall((json/nul 0))))
       (jkv "label" label_value)
       (jkv "labelSource" label_source)
       (jkv "help" help_value)
       (jkv "helpSource" help_source)
       (jkv "helpLine" help_line)
       (jkv "kind" (json/str (record.run(physical_projection/kind).fall("namespace"))))]
  + entry_key
    \ entry=physical_read/entry
    ^ path
    ? entry
     > (./child key _) [key]
     > (./slot key _) key
  + entry
    \ entry=physical_read/entry
    ^ either[iota [key=str body=str]]
    = path (physical_projection/entry_key entry)
    > (./ok key) (physical_key/encode path) (./err 'key_too_large)
    = detail
        ? entry
         > (./child _ node) (jkv "node" (physical_projection/node node))
         > (./slot _ value) (jkv "value" (physical_projection/value value))
      body (show (json/obj
        [(jkv "key" (json/str key))
         (jkv "displayKey" (physical_projection/optional_text (physical_key/display path)))
         detail]))
    | ./ok [key body]
  + selected
    : bodies=row[str] next=maybe[str]
  + select
    ' Reserve 32K for request/cursor identities and bounded own metadata.
    ' Stop at the last included entry, not the selector's later cursor.
    \ page=physical_read/page
    ^ either[iota physical_projection/selected]
    % i=nat 0 used=nat 0 bodies=row[str] [] last=maybe[str] .none
    ^ either[iota physical_projection/selected]
    ? (eq i page.entries.len)
      | ./ok (physical_projection/selected bodies (? (maybe/is_some page.next) last .none))
    > (./ok encoded) (physical_projection/entry page.entries.at(i)) (./err 'key_too_large)
    = [key body] encoded
      cost (add body.len 1)
    ? (gt (add used cost) 98304)
      ? (eq i 0) (./err 'response_too_large)
      | ./ok (physical_projection/selected bodies last)
    | _ i.inc (add used cost) bodies.snoc(body) (./some key)
  + json
    \ page=physical_read/page
    ^ either[iota str]
    > (./ok key) (physical_key/encode page.pax) (./err 'key_too_large)
    = after=either[iota maybe[str]]
        ? page.after
         > .none (./ok .none)
         > (./some cursor)
           > (./ok encoded) (physical_key/encode cursor) (./err 'key_too_large)
           | ./ok (./some encoded)
    > (./ok cursor) after (./err 'key_too_large)
    = selection (physical_projection/select page)
    > (./ok selected) selection
      ? selection
       > (./err reason) (./err reason)
       > (./ok _) (./err 'read_failed)
    = envelope (show (json/obj
        [(jkv "version" (json/num .false 1))
         (jkv "resolution" (json/str "physical"))
         (jkv "pathKey" (json/str key))
         (jkv "displayPath" (physical_projection/optional_text (physical_key/display page.pax)))
         (jkv "epoch" (physical_projection/decimal page.epoch))
         (jkv "collection" (json/str (? (eq_iota page.collection 'children) "children" "slots")))
         (jkv "after" (physical_projection/optional_text cursor))
         (jkv "next" (physical_projection/optional_text selected.next))
         (jkv "limit" (json/num .false page.limit))
         (jkv "total" (physical_projection/decimal page.total))
         (jkv "complete" (json/boo (maybe/is_none selected.next)))
         (jkv "own" (physical_projection/node page.own))]))
      body (str/cat_all [envelope.slice(0 envelope.len.dec) "," (show_str "entries")
        ":[" (str/join "," selected.bodies) "]}"])
    ? (gt body.len physical_projection/max_bytes) (./err 'response_too_large)
    | ./ok body
  + force_json
    \ input=[physical_read/request sov]
    ^ either[iota str]
    = [query state] input
    ? (physical_read/read query state)
     > (./err reason) (./err reason)
     > (./ok page)
       ? (physical_projection/json page)
        > (./err reason) (./err reason)
        > (./ok body)
          ; body.len
          | ./ok body
  + safe_json
    ' Force the complete encoded scalar before handing it to the actor.
    \ query=physical_read/request state=sov
    ^ either[iota str]
    ? (Try physical_projection/force_json [query state])
     > (./ok reply) reply
     > (./err _) (./err 'read_failed)
  + status
    \ reason=iota
    ^ nat
    ? (eq_iota reason 'epoch_conflict) 409
    ? (eq_iota reason 'record_deleted) 410
    ? (eq_iota reason 'unknown_authority) 404
    ? (eq_iota reason 'authority_required) 422
    ? ((eq_iota reason 'record_missing) || (eq_iota reason 'path_missing)) 404
    ? ((eq_iota reason 'derived_path) || (eq_iota reason 'key_too_large)) 422
    ? ((eq_iota reason 'invalid_query) || (eq_iota reason 'invalid_limit) ||
       (eq_iota reason 'invalid_collection) || (eq_iota reason 'invalid_cursor) ||
       (eq_iota reason 'epoch_required)) 400
    500
  + namespace_safe_json
    ' Global root is a composed browsing view, never a physical store.
    \ query=physical_read/request state=namespace
    ^ either[iota str]
    ? (Try physical_projection/namespace_force_json [query state])
     > (./ok reply) reply
     > (./err _) (./err 'read_failed)
  + namespace_force_json
    \ input=[physical_read/request namespace]
    ^ either[iota str]
    = [query state] input
    ? (physical_read/namespace_read query state)
     > (./err reason) (./err reason)
     > (./ok page)
       ? (physical_projection/json page)
        > (./err reason) (./err reason)
        > (./ok body)
          ; body.len
          | ./ok body

' --- inspect_read ---

' Namespace inspection is a read, never an HTTP request record in the ledger.
' Physical outlines select index children, not y frontiers or z subtrees.
+ inspect_read
  + request
    : pax=path epoch=maybe[nat] children=maybe[path] slots=maybe[path] tag=iota own_slots=bool versions=bool operations=bool metadata=row[path]
  + page
    : epoch=nat children=maybe[path] next_children=maybe[path] child_count=nat
      slots=maybe[path] next_slots=maybe[path] slot_count=nat
  + result
    : target=path view=axal[myth] versions=axal[myth] operations=row[[p=path o=op]]
      paging=inspect_read/page tag=iota writable=bool
  + metadata
    ' Fixed semantic slots stay available when traversing a slot page. No
    ' unrelated children or application face is evaluated to label a path.
    \ keys=row[path] record=myth
    ^ myth
    = metadata
        | keys.fold (myth/new)
        \ out key
        ? record.get(key)
         > (./some value) out.put(key value)
         > .none out
    ' Only journal events use content as a semantic discriminator. Ordinary
    ' application payloads remain excluded from compact child metadata.
    > (./some content) record.get(bond/content) metadata
    > event=namespace_event content metadata
    | metadata.put bond/content event
  + own
    \ epoch=nat node=axal[tome]
    ^ maybe[myth]
    ? (ass/res epoch (tome/hist node.fil))
     > (./known record) (./some record)
    .none
  + operations
    ' Only ancestor /op registries; never generic request crew hydration.
    \ target=path state=sov
    ^ row[[p=path o=op]]
    % depth=nat 1 out=row[[p=path o=op]] []
    ? ((gt depth target.len) || (ge out.len 64)) out
    = prefix=path target.take(depth)
      parent=path prefix.snoc('op)
      source state.idx.dip(parent)
      entries source.kid.range_after(.none (sub 64 out.len))
      next
        | entries.fold out
        \ found=row[[p=path o=op]] entry
        > (./some record) (inspect_read/own state.top (unpin entry.val.held)) found
        > (./some held) record.get(system_vocabulary/op) found
        > operation=op held found
        | found.snoc([parent.snoc(entry.key) operation])
    | _ depth.inc next
  + read
    \ query=inspect_read/request state=sov
    ^ either[iota inspect_read/result]
    | inspect_read/read_with query state
      (\ target=path (axal/snip[myth] (peek target state)))
      (\ target=path (h_ver target state))
  + read_with
    \ query=inspect_read/request state=sov resolve={\ path}axal[myth]
      version_of={\ path}axal[myth]
    ^ either[iota inspect_read/result]
    ? (gt query.metadata.len 32) (./err 'invalid_metadata)
    ? (gt query.pax.len 128) (./err 'invalid_path)
    ? query.children.run((\ key=path !(eq key.len 1))).fall(.false)
      | ./err 'invalid_cursor
    = epoch query.epoch.fall(state.top)
    ? !(eq epoch state.top) (./err 'epoch_conflict)
    = continuation ((maybe/is_some query.children) || (maybe/is_some query.slots))
    ? (? continuation (maybe/is_none query.epoch) .false) (./err 'epoch_required)
    = physical (value_read/physical query.pax)
      tree=axal[myth]
        ? physical
          (axal/new[myth] (inspect_read/own epoch state.idx.dip(query.pax)))
        ' Derived care/case semantics remain the responsibility of the
        ' resolver. Do not silently reinterpret historical z as physical y.
        | resolve query.pax
      child_source=[axal[myth] maybe[path] nat]
        ? physical
          = source state.idx.dip(query.pax)
            bound query.children.run((\ key=path key.at(0)))
            selected source.kid.range_after(bound 41)
            count (? (lt selected.len 40) selected.len 40)
            next=maybe[path]
              ? (gt selected.len count) (./some [selected.at(count.dec).key])
              .none
            view
              % i=nat 0 out=axal[myth] tree
              ? (eq i count) out
              = entry selected.at(i)
                child (axal/new[myth] (inspect_read/own epoch (unpin entry.val.held)).run((inspect_read/metadata query.metadata)))
              | _ i.inc out.set_kid(out.kid_put(entry.key child))
          [view next source.kid.size]
        = selected tree.kid.range_after(query.children.run((\ key=path key.at(0))) 41)
          count (? (lt selected.len 40) selected.len 40)
          next=maybe[path]
            ? (gt selected.len count) (./some [selected.at(count.dec).key])
            .none
          view
            % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
            ? (eq i count) out
            = entry selected.at(i)
              child (axal/new[myth] (unpin entry.val.held).fil.run((inspect_read/metadata query.metadata)))
            | _ i.inc out.set_kid(out.kid_put(entry.key child))
        [view next tree.kid.size]
      [children next_children child_count] child_source
      slots=[maybe[myth] maybe[path] nat]
        > (./some card) tree.fil [.none .none 0]
        ? !(query.own_slots) [(./some (inspect_read/metadata query.metadata card)) .none card.size]
        = selected card.range_after(query.slots 41)
          count (? (lt selected.len 40) selected.len 40)
          next=maybe[path]
            ? (gt selected.len count) (./some selected.at(count.dec).key)
            .none
          record
            % i=nat 0 out=myth (inspect_read/metadata query.metadata card)
            ? (eq i count) out
            = entry selected.at(i)
            | _ i.inc out.put(entry.key entry.val)
        [(./some record) next card.size]
      [own next_slots slot_count] slots
      versions
        ? !(query.versions) (axal/new[myth] .none)
        | version_of query.pax
      ops=row[[p=path o=op]]
        ? (!(query.operations) || !physical) []
        | inspect_read/operations query.pax state
    | ./ok (inspect_read/result query.pax children.set_fil(own) versions ops
        (inspect_read/page epoch query.children next_children child_count query.slots next_slots slot_count)
        query.tag .false)
  + safe_read
    \ query=inspect_read/request state=sov
    ^ either[iota inspect_read/result]
    ? (Try inspect_read/force_read [query state])
     > (./ok answer) answer
     > (./err _) (./err 'read_failed)
  + force_read
    ' Finish selecting the finite data before crossing actor mailboxes.
    ' Unevaluated selectors otherwise capture the sovereign in their closure.
    \ input=[inspect_read/request sov]
    ^ either[iota inspect_read/result]
    = [query state] input
      ;answer (inspect_read/read query state)
    ; (DeepSeq[nat] answer 0)
    answer
  + namespace_read
    \ query=inspect_read/request state=namespace
    ^ either[iota inspect_read/result]
    ? (gt query.metadata.len 32) (./err 'invalid_metadata)
    ? (eq query.pax.len 0)
      ' The composed root has no assertion or shared authority epoch. Its
      ' two fixed authority links never hydrate either authority's subtree.
      ? ((maybe/is_some query.children) || (maybe/is_some query.slots))
        | ./err 'invalid_cursor
      ? query.epoch.run((\ epoch=nat !(eq epoch 0))).fall(.false)
        | ./err 'epoch_conflict
      = authorities=row[path] [['sys] [state.self]]
        view
          | authorities.fold (axal/new[myth] .none)
            \ out=axal[myth] target=path
            > (./some history) state.history(target) out
            = record (inspect_read/own history.top history.idx.dip(target)).run((inspect_read/metadata query.metadata))
            | out.set_kid(out.kid_put(target.at(0) (axal/new[myth] record)))
      | ./ok (inspect_read/result [] view (axal/new[myth] .none) []
          (inspect_read/page 0 .none .none 2 .none .none 0) query.tag .false)
    ? !(value_read/physical query.pax)
      ' Derived evaluation uses both authorities at this committed namespace.
      ' This cursor is a render revision (local.top), NOT a source epoch.
      ' The selected system publication is immutable for the server lifetime.
      = resolve
          \ target=path
          ^ axal[myth]
          = structural (sovereign_history_prefix target)
          ? structural.wyt structural
          ? (sovereign_view .y 0 target state)
           > (./known view) view
          (axal/new[myth] .none)
        version_of
          \ target=path
          ^ axal[myth]
          ' Source assertion counters are not output history. /h is
          ' constant; /o and /x have their own case algebra. Until the
          ' resolver exposes derived version metadata, leave it unreported
          ' rather than minting case links or provenance for another path.
          | axal/new[myth] .none
      | inspect_read/read_with query state.local resolve version_of
    > (./some history) state.history(query.pax)
      | ./err 'unknown_authority
    ? (inspect_read/safe_read query history)
     > (./err reason) (./err reason)
     > (./ok answer) (./ok answer.set_writable(state.permitted(query.pax)))
  + namespace_force_read
    \ input=[inspect_read/request namespace]
    ^ either[iota inspect_read/result]
    = [query state] input
      ;answer (inspect_read/namespace_read query state)
    ; (DeepSeq[nat] answer 0)
    answer
  + namespace_safe_read
    \ query=inspect_read/request state=namespace
    ^ either[iota inspect_read/result]
    ? (Try inspect_read/namespace_force_read [query state])
     > (./ok answer) answer
     > (./err _) (./err 'read_failed)

' --- mount_assets ---

+ mount_assets
  + bundle
    : files=row[[str nat]]
  + slot
    ^ path
    system_vocabulary/fs/source/assets
  + bindings
    \ manifest=str
    ^ row[[str str]]
    > (jres/ok doc rest) (json_source/parse manifest) []
    > (json/obj entries) (grove_dev/field "assets" doc) []
    | entries.map (\ entry [entry.k (grove_dev/text entry.v)])
  + publish
    \ manifest=str files=row[[str nat]]
    ^ mount_assets/bundle
    = bindings (mount_assets/bindings manifest)
    | mount_assets/bundle
      | files.keep
        \ [name bytes]
        | bindings.any (\ [url filename] (equal filename name))
  + read
    ' Read one physical record, without materializing the mount source tree.
    \ home=path name=str state=namespace
    ^ maybe[nat]
    > (./some authority) state.history(home) .none
    > (./known record=myth) (ass/res authority.top (sov/hist home authority)) .none
    > (./some held) record.get(mount_assets/slot) .none
    > bundle=mount_assets/bundle held .none
    % idx=nat 0
    ^ maybe[nat]
    ? (eq idx bundle.files.len) .none
    = [filename bytes] bundle.files.at(idx)
    ? (equal filename name) (./some bytes)
    | _ idx.inc

' --- helm ---

+  helm
  +  journal_page
    '  One bounded physical /log snapshot at a captured sovereign epoch.
    '  view contains only the displayed child keys, including keys whose
    '  own record is absent or malformed. next is an exclusive epoch key.
    : epoch=nat before=maybe[nat] limit=nat total=nat next=maybe[nat] view=axal[saga] target=path

  +  card
    &  helm/card/snapshot
       helm/card/snapshot_bat
       helm/card/interact_bat
       helm/card/transact
       helm/card/interact
       helm/card/develop
       helm/card/install
       helm/card/peek
       helm/card/journal
       helm/card/value
       helm/card/physical
       helm/card/inspect
       helm/card/asset
       helm/card/step
       helm/card/steps
    + snapshot_bat
      : request=nat read={\ namespace}[nat any nat]
    + interact_bat
      : request=nat query=goo_runtime/request encode={\ json}any
    + snapshot
      ' Read-only mounted projections share a state with their version tokens.
      : request=nat read={\ namespace}[nat str]
    + transact
      ' Only trusted mounted code constructs this callback; never decoded from HTTP.
      : request=nat run={\ namespace}[namespace nat str]
    + interact
      : request=nat query=goo_runtime/request
    + develop
      : request=nat query=grove_dev/request
    + install
      : source=path version=nat target=path
    +  step
      : pax=path wit=writ
    +  steps
      '  Several writes as one event: admitted whole or refused whole.
      : writes=row[[pax=path wit=writ]]
    +  peek
      : car=care cas=maybe[nat] pax=path
    +  journal
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + asset
      : request=nat home=path name=str mime=nat
    + inspect
      : request=nat query=inspect_read/request

  +  supervisor
    '  Trusted bootstrap requests carry a transferred reply capability.
    '  Feet receive a dedicated endpoint bound to their registered path.
    '  Outbound moves and incomplete cascades are rejected atomically
    '  until outbound routing is installed. No persistence or actor discovery.
    +  request
      & helm/card/snapshot
       helm/card/snapshot_bat
       helm/card/interact_bat
        helm/card/transact
       helm/card/interact
        helm/card/develop
        helm/card/install
        helm/card/step
       helm/card/steps
        helm/card/peek
        helm/card/journal
        helm/card/value
        helm/card/physical
        helm/card/inspect
        helm/card/asset
        helm/supervisor/register
    +  register
      '  Explicit bootstrap registration; duplicate or absent paths fail.
      : pax=path entry={\ feet/task/init nat}nat
    +  member
      : pax=path actor=nat binding=axal[saga]

    +  rejection
      : reason=iota

    +  denied
      \ reason=iota
      ^ feet/task[unit]
      | feet/task/ack
      | ./some (helm/supervisor/rejection reason)

    + step
      \ target=path command=writ now=nat block=nat state=namespace
      ^ [state=namespace reply=feet/task[unit]]
      | helm/supervisor/run_task (task/vine target command) now block state
    + steps
      \ writes=row[[pax=path wit=writ]] now=nat block=nat state=namespace
      ^ [state=namespace reply=feet/task[unit]]
      | helm/supervisor/run_task (task/vines writes) now block state
    + run_task
      ' The candidate includes every reaction round and its journal entries.
      ' Unsupported transport or a failed cascade discards that candidate.
      \ command=task now=nat block=nat state=namespace
      ^ [state=namespace reply=feet/task[unit]]
      ? (sovereign_cycle command 0 8 now block state)
       > (./fail why) [state (helm/supervisor/denied why)]
       > (./spun next moves rounds ack spill)
         = problem=maybe[iota]
             ? spill
              > (./some why) (./some why)
             ? moves.len (./some 'outbound_not_supported)
             .none
         ? problem
          > (./some why) [state (helm/supervisor/denied why)]
          > .none [next (feet/task/ack .none)]

    + journal_key
      \ entry=bee/kv[axal/k[tome]]
      ^ bool
      | maybe/is_some (dig_of entry.key)
    + journal
      ' Store-level fixture entry point; production supplies its authority.
      \ before=maybe[nat] limit=nat state=sov
      ^ either[iota helm/journal_page]
      | helm/supervisor/journal_at ['log] before limit state
    + journal_at
      ' Read limit+1 index children only, never the event descendants.
      \ root=path before=maybe[nat] limit=nat state=sov
      ^ either[iota helm/journal_page]
      ? ((eq limit 0) || (gt limit 40)) (./err 'invalid_journal_limit)
      = epoch state.top
        source state.idx.dip(root)
        bound=maybe[iota] before.run(dig_show)
        selected source.kid.range_rev(bound limit.inc)
      ? !(selected.all(helm/supervisor/journal_key)) (./err 'invalid_journal_key)
      = count (? (lt selected.len limit) selected.len limit)
        next=maybe[nat]
          ? (gt selected.len limit) (dig_of selected.at(count.dec).key)
          .none
        root_version (ass/saga epoch (tome/hist source.fil))
        view
          % i=nat 0 out=axal[saga] (axal/new[saga] root_version)
          ? (eq i count) out
          = entry selected.at(i)
            child (unpin entry.val.held)
            version (ass/saga epoch (tome/hist child.fil))
            node (axal/new[saga] version)
          | _ i.inc out.set_kid(out.kid_put(entry.key node))
      | ./ok (helm/journal_page epoch before limit source.kid.size next view root)

    + handle
      \ card=helm/card state=namespace
      ^ [namespace feet/task[unit]]
      ? card
       > (./snapshot_bat request read)
         = answered=[nat any nat]
             ? (Try read state)
              > (./ok pair) pair
              > (./err _) [500 (wire_proto/failure "Snapshot read failed") "application/x-protobuf"]
           [status body mime] answered
         [state (feet/task/binary request status body mime)]
       > (./interact_bat request query encode)
         = [next status body] (goo_runtime/run_value query state)

         [next (feet/task/binary request status (encode body) "application/x-protobuf")]
       > (./snapshot request read)
         '  A mount's read runs here; an error in it answers that one
         '  request, not the supervisor.
         = answered=[nat str]
             ? (Try read state)
              > (./ok pair) pair
              > (./err _) [500 "Snapshot read failed"]
           [status body] answered
         [state (feet/task/develop request status body)]
       > (./transact request run)
         = result=[namespace nat str]
             ? (Try run state)
              > (./ok result) result
              > (./err _) [state 500 "Mount transaction failed"]
           [candidate status body] result
           next (? (and (ge status 200) (lt status 300)) candidate state)

         [next (feet/task/develop request status body)]
       > (./interact request query)
         = [next status body] (goo_runtime/run query state)
         [next (feet/task/develop request status body)]
       > (./develop request query)
         = [next status body] (grove_dev/run query state)
         [next (feet/task/develop request status body)]
       > (./install source version target)
         ? (grove_install/instantiate
             source version target state)
          > (./err why)
            [state (helm/supervisor/denied why)]
          > (./ok next)
            [next (feet/task/ack .none)]
       > (./peek car cas target)
         [state (feet/task/page target
           (namespace/page car cas target state))]
       > (./journal request before limit)
         [state (feet/task/journal request
           (helm/supervisor/journal_at [state.self 'log] before limit state.local))]
       > (./value request query)
         [state (feet/task/value request (value_read/namespace_safe_read query state))]
       > (./physical request query)
         [state (feet/task/physical request (physical_projection/namespace_safe_json query state))]
       > (./asset request home name mime)
         [state (feet/task/asset request mime (mount_assets/read home name state))]
       > (./inspect request query)
         [state (feet/task/inspect request (inspect_read/namespace_safe_read query state))]
       > (./step target command)
         | helm/supervisor/step
           target command 0 0 state
       > (./steps writes)
         | helm/supervisor/steps writes 0 0 state

    + access
      (@@ s)
      : page={\ care maybe[nat] path s}res[axal[saga]]
        handle={\ helm/card s}[s feet/task[unit]]
        version={\ s}nat
        permit={\ path s}bool

    + local_access
      ^ helm/supervisor/access[namespace]
      | helm/supervisor/access[namespace]
        namespace/page helm/supervisor/handle
        (\ state state.local.top)
        (\ target state (namespace/permitted target state))

    +  close_caps
      \ caps=row[nat]
      ^ nat
      | row/fold[nat nat] 0
        (\ ;ignored=nat handle=nat (CloseHandle handle)) caps

    +  start_foot
      '  Resolve the transferred endpoint in the foot's handle table.
      \ entry={\ feet/task/init nat}nat self=nat
      ^ nat
      = ;[initial caps] (Recv[feet/task/init] 0)
      | entry (feet/task/init initial.ax caps.at(0)) self

    +  endpoint
      '  The foot cannot supply or change its source path.
      '  Replies go directly to the registered foot, not a claimed sender.
      \ pax=path self=nat
      ^ nat
      = ;[initial caps] (Recv[nat] 0)
        server=nat caps.at(0)
        foot=nat caps.at(1)
      % ignored=nat 0
      = ;[gift extra] (Recv[feet/gift[unit]] 0)
      ; (helm/supervisor/close_caps extra)
      ? (feet/gift/normalize pax gift)
       > .none (_ 0)
       > (./some card)
        ; (SendCaps server card [foot])
        | _ 0

    +  notify_with
      (@ s)
      '  Compare committed %y snapshots. An absent binding is an empty tree.
      '  Preserve registry order and deliver updates before the write ack.
      \ access=helm/supervisor/access[s]
        state=s members=row[helm/supervisor/member]
      ^ row[helm/supervisor/member]
      = page access.page
      | members.fold []
      \ ;out=row[helm/supervisor/member] member=helm/supervisor/member
      ^ row[helm/supervisor/member]
      = binding=axal[saga]
          ? (page .y .none member.pax state)
           > (./known tree) tree
           > .null (axal/new[saga] .none)
           > .unknown (axal/new[saga] .none)
      ? (equal binding member.binding)
        out.snoc(member)
      ; (Send member.actor (feet/task/fact binding))
      | out.snoc member.set_binding(binding)

    +  enroll_with
      (@ s)
      '  Validate once, then spawn and transfer the bound endpoint.
      \ access=helm/supervisor/access[s]
        req=helm/supervisor/register state=s
        members=row[helm/supervisor/member]
      ^ [row[helm/supervisor/member] feet/task[unit]]
      = page access.page
        permit access.permit
      ? !(permit req.pax state)
        [members (helm/supervisor/denied 'foot_outside_authority)]
      ? members.any((\ mem (equal mem.pax req.pax)))
        [members (helm/supervisor/denied 'foot_already_registered)]
      > (./known binding)
          (page .y .none req.pax state)
        [members (helm/supervisor/denied 'foot_binding_absent)]
      = ;foot (Spawn (helm/supervisor/start_foot req.entry))
        ;port (Spawn (helm/supervisor/endpoint req.pax))
      ; (SendCaps port 0 [0 foot])
      ; (SendCaps foot (feet/task/init binding 0) [port])
      ; (CloseHandle port)
      = member (helm/supervisor/member req.pax foot binding)
      [members.snoc(member) (feet/task/ack .none)]

    +  advance_with
      (@ s)
      '  Deliver committed bindings before returning the reply.
      \ access=helm/supervisor/access[s]
        card=helm/card state=s
        members=row[helm/supervisor/member]
      ^ [s row[helm/supervisor/member] feet/task[unit]]
      = handle access.handle
        version access.version
      = ;[next answer]
          | handle card state
        ;updated
          ? (eq (version next) (version state)) members
          | helm/supervisor/notify_with[s] access next members
      [next updated answer]

    +  run_keeping
      (@ s)
      '  run_with, and keep sees every admitted state whose version
      '  changed, before the reply goes out.  A saved world is a world
      '  whose keep is Save (eden/keeper).
      \ access=helm/supervisor/access[s] keep={\ s}nat initial=s self=nat
      ^ nat
      = version access.version
      % state=s initial
        members=row[helm/supervisor/member] []
      = ;[message caps] (Recv[helm/supervisor/request] 0)
      ? (eq caps.len 0)
        | _ state members
      = ;[next joined answer]
          ? message
           > req=helm/supervisor/register
            = ;[roster ack] (helm/supervisor/enroll_with[s] access req state members)
            [state roster ack]
           > card=helm/card/snapshot_bat
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/interact_bat
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/snapshot
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/transact
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/interact
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/develop
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/install
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/step
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/steps
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/peek
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/journal
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/value
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/physical
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/asset
            | helm/supervisor/advance_with[s] access card state members
           > card=helm/card/inspect
            | helm/supervisor/advance_with[s] access card state members
      ; (? (eq (version next) (version state)) 0 (keep next))
      ; (Send caps.at(0) answer)
      ; (helm/supervisor/close_caps caps)
      | _ next joined
    +  run_with
      (@ s)
      '  Only bootstrap code receives this handle. Feet use endpoints.
      \ access=helm/supervisor/access[s] initial=s self=nat
      ^ nat
      = idle
          \ ignored=s
          ^ nat
          | 0
      | helm/supervisor/run_keeping[s] access idle initial self
    + run
      \ initial=namespace self=nat
      ^ nat
      ? (namespace/create initial.self initial.local initial.system)
       > (./err why) (error (helm/supervisor/rejection why))
       > (./ok checked)
         | helm/supervisor/run_with[namespace]
           helm/supervisor/local_access checked self

+  feet
  '  Foot mailbox and namespace requests. The foot owns its loop.
  '  t extends each protocol with application-specific messages.
  +  task
    '  Messages received by the foot through Recv.
    (@ t)
    & feet/task/init
      feet/task/fact
      feet/task/page
      feet/task/journal
      feet/task/value
      feet/task/physical
      feet/task/inspect
      feet/task/asset
      feet/task/develop
      feet/task/binary
      feet/task/ack
      t
    +  init
      '  Initial %y binding and recipient-local coordinator handle.
      '  The startup wrapper resolves parent through capability transfer.
      : ax=axal[saga] parent=nat
    +  fact
      '  An update to the foot's own %y binding.
      : ax=axal[saga]
    +  page
      '  Answer to gift/peek, including absent or unknown paths.
      : pax=path axe=res[axal[saga]]
    +  journal
      '  Correlated, read-only bounded journal response.
      : request=nat result=either[iota helm/journal_page]
    + value
      ' Correlated immutable physical slot bytes; no namespace work.
      : request=nat result=either[iota value_read/chunk]
    + physical
      ' Already projected JSON, never the raw physical page or its pins.
      : request=nat result=either[iota str]
    + asset
      : request=nat mime=nat bytes=maybe[nat]
    + inspect
      : request=nat result=either[iota inspect_read/result]
    + binary
      : request=nat status=nat body=any mime=nat
    + develop
      : request=nat status=nat body=str
    +  ack
      '  Write result: none on success, some error on rejection.
      : err=maybe[pail]
  +  gift
    '  Namespace requests sent to the parent supplied by task/init.
    (@ t)
    & feet/gift/transact
      feet/gift/interact
      feet/gift/develop
      feet/gift/install
      feet/gift/poke
      feet/gift/batch
      feet/gift/pass
      feet/gift/peek
      feet/gift/journal
      feet/gift/value
      feet/gift/physical
      feet/gift/inspect
      feet/gift/snapshot
      feet/gift/snapshot_bat
      feet/gift/interact_bat
      feet/gift/asset
      t
    +  normalize
      '  The endpoint supplies the registered location, never the foot.
      \ home=path gift=feet/gift[unit]
      ^ maybe[helm/card]
      ? gift
       > (./snapshot_bat request read)
        | ./some (helm/card/snapshot_bat request read)
       > (./interact_bat request query encode)
        | ./some (helm/card/interact_bat request query encode)
       > (./snapshot request read)
        | ./some (helm/card/snapshot request read)
       > (./transact request run)
        | ./some (helm/card/transact request run)
       > (./interact request query)
        | ./some (helm/card/interact request query)
       > (./develop request query)
        | ./some (helm/card/develop request query)
       > (./install source version target)
        | ./some (helm/card/install source version target)
       > (./poke pax wit) (./some (helm/card/step pax wit))
       > (./batch writes) (./some (helm/card/steps writes))
       > (./pass pax wit) (./some (helm/card/step home.weld(pax) wit))
       > (./peek pax) (./some (helm/card/peek .y .none pax))
       > (./journal request before limit)
        | ./some (helm/card/journal request before limit)
       > (./value request query)
        | ./some (helm/card/value request query)
       > (./physical request query)
        | ./some (helm/card/physical request query)
       > (./asset request home name mime)
        | ./some (helm/card/asset request home name mime)
       > (./inspect request query)
        | ./some (helm/card/inspect request query)
      .none
    + snapshot_bat
      : request=nat read={\ namespace}[nat any nat]
    + interact_bat
      : request=nat query=goo_runtime/request encode={\ json}any
    + snapshot
      : request=nat read={\ namespace}[nat str]
    + transact
      ' Only trusted mounted code constructs this callback; never decoded from HTTP.
      : request=nat run={\ namespace}[namespace nat str]
    + interact
      : request=nat query=goo_runtime/request
    + develop
      : request=nat query=grove_dev/request
    + install
      : source=path version=nat target=path
    +  batch
      '  Submit several writes as one event, admitted whole or refused whole.
      :  writes=row[[pax=path wit=writ]]
    +  poke
      '  Submit a write at an absolute namespace path.
      : pax=path wit=writ
    +  pass
      '  Submit a write relative to the foot's namespace location.
      : pax=path wit=writ
    +  peek
      '  Read an absolute namespace path; answered by task/page.
      : pax=path
    +  journal
      '  Read physical /log keys without creating namespace work.
      : request=nat before=maybe[nat] limit=nat
    + value
      : request=nat query=value_read/request
    + physical
      : request=nat query=physical_read/request
    + asset
      : request=nat home=path name=str mime=nat
    + inspect
      : request=nat query=inspect_read/request

' --- http_response ---

+ http_response
  : status=nat body=nat ctype=nat

+ http_driver
  +  response
    \ status=nat body=nat
    ^ http_response
    | http_response status body "text/plain; charset=utf-8"
  +  failure
    \ err=iota
    ^ http_response
    | http_driver/response 500 (| iota_show err)
  +  back
    \ loc=nat
    ^ http_response
    '  Escape the URL before placing it in either HTML attribute.
    = url | http_driver/escape loc
    | http_response 200
      (| cord/cat_all ["<!doctype html><html><head><meta http-equiv=" 34 "refresh" 34
        " content=" 34 "0;url=" url 34 "></head><body>committed; <a href=" 34 url 34
        ">back</a></body></html>"])
      "text/html; charset=utf-8"
  +  escape
    \ text=nat
    ^ nat
    = pieces
        % i=nat 0 out=row[nat] []
        ? (| eq i (| wid text)) out
        = c | load8 i text
          escaped=nat
            ? (| eq c 38) "&amp;"
            ? (| eq c 34) "&quot;"
            ? (| eq c 60) "&lt;"
            ? (| eq c 62) "&gt;"
            c
        | _ i.inc out.snoc(escaped)
    | cord/cat_all pieces
  +  result
    '  Ordinary HTTP records and compiler/chore records share the wait path.
    \ rec=res[myth]
    ^ maybe[http_response]
    > (./known t) rec .none
    = status t.nat_at(['res_status] 0)
    ? status
      | ./some
      | http_response status t.nat_at(['res_body] 0)
        t.nat_at(['res_ctype] "text/plain; charset=utf-8")
    ? !(| eq 1 t.nat_at(['res_done] 0)) .none
    = err t.txt_at(['err])
      report t.txt_at(['report])
      value t.txt_at(['value])
      ty t.txt_at(['ty])
      law t.txt_at(['law])
      body=nat
        ? err err
        ? report report
        ? value
          | cord/cat_all ["value: " value
            (? ty (| cord/cat_all [10 "type:  " ty]) "")
            (? law (| cord/cat_all [10 10 law]) "")]
        "chore failed"
      code=nat
        ? err 500
        ? (report || value) 200
        500
    | ./some | http_driver/response code body

' --- http_foot ---

+ http_foot
  + request
    : method=str target=str body=str
  + action
    & http_foot/action/snapshot
      http_foot/action/memo
      http_foot/action/snapshot_bat
      http_foot/action/interact_bat
      http_foot/action/transact
      http_foot/action/interact
      http_foot/action/develop
      http_foot/action/reply
      http_foot/action/bytes
      http_foot/action/bat
      http_foot/action/asset
      http_foot/action/install
      http_foot/action/write
      http_foot/action/commit
      http_foot/action/commit_many
      http_foot/action/batch
      http_foot/action/batch_told
      http_foot/action/told
      http_foot/action/stream
      http_foot/action/broadcast
      http_foot/action/join
      http_foot/action/after
      http_foot/action/wait
      http_foot/action/journal
      http_foot/action/value
      http_foot/action/physical
      http_foot/action/inspect
    + snapshot_bat
      : read={\ namespace}[nat any nat]
    + interact_bat
      : query=goo_runtime/request encode={\ json}any
    + bat
      : status=nat body=any ctype=nat
    + memo
      ' Trusted read-only projection with private per-foot cached data.
      : key=path read={\ maybe[pail] namespace}[pail nat str]
    + snapshot
      ' Trusted mount callback evaluated against one supervisor state.
      : read={\ namespace}[nat str]
    + transact
      : run={\ namespace}[namespace nat str]
    + interact
      : query=goo_runtime/request
    + develop
      : query=grove_dev/request
    + reply
      : response=http_response
    + asset
      : home=path name=str mime=nat
    + bytes
      : status=nat body=nat ctype=nat
    + install
      : source=path version=nat target=path back=str
    + write
      : pax=path wit=writ back=str
    + commit
      ' One write. The foot admits or rejects it, then calls done with
      ' the result (none, or the rejection) to build the response.
      : pax=path wit=writ done={\ maybe[pail]}http_response
    + commit_many
      ' Several writes admitted whole or refused whole as one event
      ' (one journal entry); answered like commit.
      : writes=row[[pax=path wit=writ]] done={\ maybe[pail]}http_response
    + batch
      ' One commit_many, then one snapshot on the admitted state: finish
      ' receives the event's outcome and that state.  The connection
      ' actor runs the pair; the foot sees one commit and a snapshot.
      : writes=row[[pax=path wit=writ]] finish={\ maybe[pail] namespace}[nat str]
    + batch_told
      ' A batch, plus one line for the open streams. After the commit,
      ' told runs on the new state and returns the line to send; an
      ' empty string sends nothing.
      : writes=row[[pax=path wit=writ]] finish={\ maybe[pail] namespace}[nat str] told={\ maybe[pail] namespace}str
    + told
      ' A read that also sends a fixed line to the open streams. Nothing
      ' is written to the journal.
      : read={\ namespace}[nat str] line=str
    + stream
      ' A GET that stays open. The connection sends the event-stream
      ' head, registers with the fan-out, and then writes each line it
      ' is given until the socket closes. Commits never wait for it.
      :
    + broadcast
      ' One line for every open stream, from a connection to the foot.
      : line=str
    + join
      ' A stream connection registering itself with the foot (its
      ' handle rides as the capability).
      :
    + after
      ' A snapshot whose answer decides the next action: a read that
      ' feeds a write, in one request.
      : read={\ namespace}[nat str] next={\ nat str}http_foot/action
    + wait
      : record=myth
    + journal
      : before=maybe[nat] limit=nat
    + value
      : query=value_read/request
    + physical
      : query=physical_read/request
    + inspect
      : query=inspect_read/request
  + cache_answer
    : key=path value=pail status=nat body=str
  + memo_read
    \ key=path previous=maybe[pail] read={\ maybe[pail] namespace}[pail nat str] state=namespace
    ^ [nat any nat]
    = result=[pail nat str]
        ? (Try (read previous) state)
         > (./ok result) result
         > (./err _) [previous.fall((pails/t "")) 500 "Cached snapshot read failed"]
      [cache status body] result
    [200 (http_foot/cache_answer key cache status body) "application/x-shrine-cache"]
  + task
    '  Supervisor messages and namespace actions from connections.
    & feet/task/init
      feet/task/fact
      feet/task/page
      feet/task/journal
      feet/task/value
      feet/task/physical
      feet/task/inspect
      feet/task/asset
      feet/task/ack
      feet/task/develop
      feet/task/binary
      http_foot/action/snapshot
      http_foot/action/memo
      http_foot/action/snapshot_bat
      http_foot/action/interact_bat
      http_foot/action/transact
      http_foot/action/interact
      http_foot/action/develop
      http_foot/action/install
      http_foot/action/write
      http_foot/action/commit
      http_foot/action/commit_many
      http_foot/action/batch
      http_foot/action/batch_told
      http_foot/action/told
      http_foot/action/stream
      http_foot/action/broadcast
      http_foot/action/join
      http_foot/action/after
      http_foot/action/wait
      http_foot/action/journal
      http_foot/action/value
      http_foot/action/physical
      http_foot/action/inspect
      http_foot/action/asset
  + answer
    & http_response http_foot/action/bytes http_foot/action/bat
  + pending
    ' Text r<serial> keys belong to ordinary HTTP namespace records.
    ' Numeric serial keys correlate read-only supervisor requests.
    : key=iota conn=nat
  + ack
    & http_foot/ack/request
      http_foot/ack/write
      http_foot/ack/commit
      http_foot/ack/install
      http_foot/ack/cleanup
    + request
      : key=iota
    + write
      : conn=nat back=str
    + commit
      : conn=nat done={\ maybe[pail]}http_response
    + install
      : conn=nat back=str
    + cleanup
      :
  + fault
    : reason=str
  + crlf
    ^ str
    | str/from_atom 2573
  + bar
    \ text=nat
    ^ nat
    | add text (bex (mul 8 (wid text)))
  + unbar
    \ bytes=nat
    ^ str
    | str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes)))))
  + body_text
    ' The text of a response built by a mount: its body is a plain
    ' atom, never barred, so no byte is stripped (unbar is for the
    ' marked request and asset bytes only).
    \ response=http_response
    ^ str
    | str/from_atom response.body
  + split
    \ separator=nat text=str
    ^ row[str]
    | str/split_byte separator text
  + ascii_lower
    \ text=str
    ^ str
    | str/ascii_lower text
  + trim
    \ text=str
    ^ str
    | str/trim_ascii text
  + find
    \ needle=str text=str
    ^ maybe[nat]
    | str/find needle text
  + hex
    \ c=nat
    ^ maybe[nat]
    = digit | hex/value c
    ? (eq digit 16) .none
    | ./some digit
  + decode
    \ plus=bool text=str
    ^ str
    % i=nat 0 out=str ""
    ? (eq i text.len) out
    = c text.at(i)
    ? (eq c 37)
      > (./some hi) (http_foot/hex text.at(i.inc))
          (error (http_foot/fault "Invalid percent escape"))
      > (./some lo) (http_foot/hex text.at((add i 2)))
          (error (http_foot/fault "Invalid percent escape"))
      = byte (add (mul 16 hi) lo)
      ? (eq byte 0) (error (http_foot/fault "NUL is not valid text"))
      | _ (add i 3) out.snoc_byte(byte)
    | _ i.inc out.snoc_byte((? plus (? (eq c 43) 32 c) c))
  + fields
    \ body=str
    ^ row[[key=str value=str]]
    | (http_foot/split 38 body).map
    \ field
    = split (http_foot/find "=" field)
    ? split
     > (./some at)
      [(http_foot/decode .true field.slice(0 at))
       (http_foot/decode .true field.slice(at.inc field.len))]
     > .none [(http_foot/decode .true field) ""]
  + field
    \ key=str fields=row[[key=str value=str]]
    ^ str
    % i=nat 0
    ? (eq i fields.len) ""
    = [name value] fields.at(i)
    ? (equal name key) value
    | _ i.inc
  + target
    \ raw=str
    ^ path
    = text (http_foot/decode .false raw)
    = absolute=str
        ? (eq text.len 0) "/"
        ? (eq text.at(0) 47) text
        | str/cat_all ["/" text]
    > (./some path) (path_parse absolute)
        ; (error (http_foot/fault "Invalid namespace path"))
        []
    path
  + route_is
    \ prefix=str target=str
    ^ bool
    ? (equal prefix "/") (eq target.at(0) 47)
    ? (equal prefix target) .true
    | equal[str] target.slice(0 prefix.len.inc) prefix.cat("/")
  + header_end
    ' The framing delimiter is fixed: compare its bytes without slicing
    ' the remaining large request atom at every candidate offset.
    \ text=str
    ^ maybe[nat]
    % i=nat 0
    ^ maybe[nat]
    ? (gt (add i 4) text.len) .none
    ? !(eq text.at(i) 13) (_ i.inc)
    ? !(eq text.at(i.inc) 10) (_ i.inc)
    ? !(eq text.at((add i 2)) 13) (_ i.inc)
    ? !(eq text.at((add i 3)) 10) (_ i.inc)
    | ./some (add i 4)
  + content_length
    \ headers=str
    ^ nat
    = lines (http_foot/split 10 headers)
    % i=nat 1 length=maybe[nat] .none
    ? (ge i lines.len)
      ? length
       > (./some n) n
       > .none 0
    = line (http_foot/trim lines.at(i))
    ? (eq line.len 0)
      | _ i.inc length
    > (./some colon) (http_foot/find ":" line)
        (error (http_foot/fault "Malformed header"))
    = name (http_foot/ascii_lower line.slice(0 colon))
      value (http_foot/trim line.slice(colon.inc line.len))
    ? (equal[str] name "transfer-encoding")
      | error (http_foot/fault "Transfer-Encoding is unsupported")
    ? !(equal[str] name "content-length")
      | _ i.inc length
    ? (maybe/is_some length)
      | error (http_foot/fault "Duplicate Content-Length")
    > (./some n) (nat/parse value)
        (error (http_foot/fault "Invalid Content-Length"))
    ? (gt n 1048576) (error (http_foot/fault "Request body too large"))
    | _ i.inc (./some n)
  + bad_request
    \ reason=str
    ^ http_foot/request
    ; (error (http_foot/fault reason))
    | http_foot/request "" "" ""
  + request_line_valid
    ' Validate before splitting/packing a target ending in NUL, which
    ' would otherwise lose that byte and alias a different request.
    \ line=str
    ^ bool
    % i=nat 0
    ? (eq i line.len) .true
    = byte line.at(i)
    ? ((lt byte 32) || (eq byte 127))
      ? (? (eq byte 13) (eq i.inc line.len) .false) .true
      .false
    | _ i.inc
  + request_chunk
    ' Read returns a length-preserving high sentinel. Removing it into a
    ' packed str would erase a terminal NUL before line validation. Reject
    ' that already-unrepresentable input at each socket chunk boundary.
    \ bytes=nat
    ^ str
    = length (wid bytes)
    ? (? (gt length 1) (eq (load8 (sub length 2) bytes) 0) .false)
      ; (error (http_foot/fault "NUL at request chunk boundary"))
      ""
    | http_foot/unbar bytes
  + read_request
    \ fd=nat
    ^ http_foot/request
    % input=str ""
    ^ http_foot/request
    = end (http_foot/header_end input)
    ? end
     > (./some at)
      ? (gt at 65536) (http_foot/bad_request "Headers too large")
      = length (http_foot/content_length input.slice(0 at))
      ? (ge input.len (add at length))
        = line (http_foot/split 10 input).at(0)
        ? !(http_foot/request_line_valid line) (http_foot/bad_request "Invalid request target bytes")
        = words (http_foot/split 32 (http_foot/trim line))
        ? !(eq words.len 3) (http_foot/bad_request "Malformed request line")
        ? !(equal[str] words.at(2) "HTTP/1.0")
          ? !(equal[str] words.at(2) "HTTP/1.1")
            (http_foot/bad_request "Unsupported HTTP version")
          | http_foot/request words.at(0) words.at(1) input.slice(at length)
        | http_foot/request words.at(0) words.at(1) input.slice(at length)
      = ;bytes (Read fd 16384)
      ? (eq bytes 0) (http_foot/bad_request "Incomplete request body")
      | _ input.cat((http_foot/request_chunk bytes))
     > .none
      ? (gt input.len 65536) (http_foot/bad_request "Headers too large")
      = ;bytes (Read fd 16384)
      ? (eq bytes 0) (http_foot/bad_request "Incomplete request headers")
      | _ input.cat((http_foot/request_chunk bytes))
  + encode
    \ response=http_response
    ^ nat
    | http_foot/bar
    | str/cat_all
      ["HTTP/1.0 " (nat/show response.status) " Response" http_foot/crlf
       "Content-Type: " (str/from_atom response.ctype) http_foot/crlf
       "Content-Length: " (nat/show (wid response.body)) http_foot/crlf
       "Connection: close" http_foot/crlf http_foot/crlf (str/from_atom response.body)]
  + encode_bat
    ' One flatten for header, shared body chunks and the socket bar sentinel.
    \ status=nat body=any ctype=nat
    ^ nat
    = header (str/cat_all
        ["HTTP/1.0 " (nat/show status) " Response" http_foot/crlf
         "Content-Type: " (str/from_atom ctype) http_foot/crlf
         "Content-Length: " (nat/show (bat_size body)) http_foot/crlf
         "Connection: close" http_foot/crlf http_foot/crlf])
    | bat_flatten (bat_concat [(bat_text (str/to_atom header)) body (bat_bytes 1 1)])
  + encode_bytes
    ' Body is a byte bar: its sentinel preserves trailing zero bytes.
    \ status=nat body=nat ctype=nat
    ^ nat
    = header=str
        | str/cat_all
          ["HTTP/1.0 " (nat/show status) " Response" http_foot/crlf
           "Content-Type: " (str/from_atom ctype) http_foot/crlf
           "Content-Length: " (nat/show (dec (wid body))) http_foot/crlf
           "Connection: close" http_foot/crlf http_foot/crlf]
    | add (str/to_atom header) (mul body (bex (mul 8 header.len)))
  + planned
    '  What the listener decided for one connection: an encoded reply it
    '  could finish locally, or an action the foot must answer.
    & http_foot/planned/done
      http_foot/planned/ask
    + done
      : encoded=nat
    + ask
      : action=http_foot/action
  + plan
    '  Read and route one request in the listener, which holds the
    '  routes.  Only the fd and this small result cross to the
    '  connection actor.  (A fresh actor per connection used to receive
    '  the whole route configuration, every closure with its environment,
    '  through the message copier on each request: that copy was the
    '  per-request floor, and it grew with the loaded mounts.  A pool of
    '  workers spawned once was tried and dropped: a worker waiting for
    '  the foot's answer shares its mailbox with incoming connections.)
    \ config=http_foot/config fd=nat
    ^ http_foot/planned
    ? (Try http_foot/read_request fd)
     > (./err _) (./done (http_foot/encode (http_driver/response 400 "Malformed HTTP request")))
     > (./ok parsed)
      = ;attempt
          | Try[http_foot/request http_foot/action]
            (\ r=http_foot/request
              | http_foot/dispatch config.routes r
                  (div (Now 0) 1000000000))
            parsed
      ? attempt
       > (./err _) (./done (http_foot/encode (http_driver/response 400 "Invalid request")))
       > (./ok action)
        ? action
         > (./reply ready) (./done (http_foot/encode ready))
         > (./bat status body ctype) (./done (http_foot/encode_bat status body ctype))
         > (./bytes status body ctype) (./done (http_foot/encode_bytes status body ctype))
        (./ask action)
  + connection
    '  Finish one connection: write a local reply, or ask the foot for
    '  namespace work and write its answer.
    \ fd=nat planned=http_foot/planned self=nat
    ^ nat
    = ;[root caps] (Recv[path] 0)
      foot caps.at(0)
    = streaming=bool
        ? planned
         > (./ask action)
          ? action
           > .stream .true
          .false
        .false
      joining=http_foot/action .join
    ? streaming
      ; (Try (\ wire=nat (Write fd wire)) (http_foot/bar http_foot/stream_head))
      ; (SendCaps foot joining [0])
      ; (CloseHandle foot)
      | http_foot/streaming fd
    = encoded=nat
        ? planned
         > (./done ready) ready
         > (./ask action) (http_foot/perform foot action)
    ; (Try (\ wire=nat (Write fd wire)) encoded)
    ; (CloseFd fd)
    | CloseHandle foot
  + stream_msg
    ' What a stream connection and the fan-out exchange.
    & http_foot/stream_msg/join
      http_foot/stream_msg/line
      http_foot/stream_msg/streamed
      http_foot/stream_msg/close
    + join
      :
    + line
      : text=str
    + streamed
      ' A stream acknowledging one written line; the fan-out counts
      ' lines outstanding per stream and lets go of one that stalls.
      :
    + close
      ' The fan-out letting a stream go: the connection closes its
      ' socket, so the tab learns the stream ended and opens another.
      :
  + stream_head
    ' The event-stream response head: no length, the body runs until
    ' the socket closes.
    ^ str
    | str/cat_all ["HTTP/1.0 200 Response" http_foot/crlf "Content-Type: text/event-stream" http_foot/crlf "Cache-Control: no-cache" http_foot/crlf "Connection: close" http_foot/crlf http_foot/crlf ": open" http_foot/crlf http_foot/crlf]
  + frame
    ' One server-sent event carrying the line.
    \ text=str
    ^ nat
    | http_foot/bar (str/cat_all ["data: " text http_foot/crlf http_foot/crlf])
  + streaming
    ' A stream connection after its head is written: receive lines from
    ' the fan-out, write each to the socket, acknowledge it; a failed
    ' write (the tab went away) ends the connection.
    \ fd=nat
    ^ nat
    % ignored=nat 0
    = ;[message caps] (Recv[http_foot/stream_msg] 0)
    ? message
     > (./line text)
      = ;wrote (Try (\ wire=nat (Write fd wire)) (http_foot/frame text))
      ? wrote
       > (./ok _)
        = acked=http_foot/stream_msg .streamed
        ; (? (gt caps.len 0) (Send caps.at(0) acked) 0)
        ; (helm/supervisor/close_caps caps)
        | _ 0
       > (./err _)
        ; (helm/supervisor/close_caps caps)
        ; (CloseFd fd)
        0
     > .close
      ; (helm/supervisor/close_caps caps)
      ; (CloseFd fd)
      0
    ; (helm/supervisor/close_caps caps)
    | _ 0
  + fanout
    ' The stream registry: every open stream's handle with the lines it
    ' has not yet acknowledged.  A line is sent to each with Try; a
    ' stream whose handle refuses, or that falls more than 512 lines
    ' behind (a burst of commits is normal; a reader that never catches
    ' up is not), is told to close and dropped, so its socket closes
    ' and the tab opens another instead of listening to silence.
    ' Nothing here blocks: a commit hands the line over and goes on.
    \ self=nat
    ^ nat
    % streams=row[[h=nat behind=nat]] []
    = ;[message caps] (Recv[http_foot/stream_msg] 0)
    ? message
     > .join
      ? (eq caps.len 0) (_ streams)
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ streams.snoc([caps.at(0) 0])
     > .streamed
      ? (eq caps.len 0) (_ streams)
      = from caps.at(0)
        eased
          | streams.map
            \ [h behind]
            | [h (? (and (eq h from) (gt behind 0)) behind.dec behind)]
      ; (helm/supervisor/close_caps caps)
      | _ eased
     > (./line text)
      ; (helm/supervisor/close_caps caps)
      = none=row[[h=nat behind=nat]] []
        ;kept
          | streams.fold none
          \ ;out=row[[h=nat behind=nat]] [h behind]
          ^ row[[h=nat behind=nat]]
          ? (gt behind 512)
            = closing=http_foot/stream_msg .close
            ; (Try (\ target=nat (Send target closing)) h)
            ; (CloseHandle h)
            out
          = ;sent (Try (\ target=nat (SendCaps target (http_foot/stream_msg/line text) [0])) h)
          ? sent
           > (./ok _) out.snoc([h behind.inc])
           > (./err _)
            ; (Try (\ target=nat (CloseHandle target)) h)
            out
      | _ kept
    | _ streams
  + outcome
    ' The commit answer a batch step reads: 200 admitted, or 409 with
    ' the kernel's reason as the body.
    \ err=maybe[pail]
    ^ http_response
    ? err
     > .none (http_driver/response 200 "admitted")
     > (./some why) (http_driver/response 409 (http_foot/reason why))
  + reason
    ' A rejection pail as text: the kernel names its reason as a symbol.
    \ why=pail
    ^ str
    ? why
     > q=pails/q (iota_show q.q)
     > t=pails/t t.t
     > n=pails/n (nat/show n.n)
    "refused"
  + ask
    \ foot=nat action=http_foot/action
    ^ http_foot/answer
    ; (SendCaps foot action [0])
    = ;[answer extra] (Recv[http_foot/answer] 0)
    answer
  + encode_answer
    \ answer=http_foot/answer
    ^ nat
    ? answer
     > response=http_response (http_foot/encode response)
     > (./bat status body ctype) (http_foot/encode_bat status body ctype)
     > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
  + perform
    ' Ask the foot and encode its answer.  A batch is one commit_many
    ' (one event for every record), then one snapshot; an after is a
    ' snapshot whose answer picks the next action.
    \ foot=nat action=http_foot/action
    ^ nat
    ? action
     > (./batch writes finish)
      = ;answer (http_foot/ask foot (http_foot/action/commit_many writes http_foot/outcome))
        outcome=maybe[pail]
          ? answer
           > response=http_response (? (eq response.status 200) .none (./some (pails/t (http_foot/body_text response))))
           > (./bat status body ctype) .none
           > (./bytes status body ctype) .none
      | http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace (finish outcome state))))
     > (./batch_told writes finish told)
      = ;answer (http_foot/ask foot (http_foot/action/commit_many writes http_foot/outcome))
        outcome=maybe[pail]
          ? answer
           > response=http_response (? (eq response.status 200) .none (./some (pails/t (http_foot/body_text response))))
           > (./bat status body ctype) .none
           > (./bytes status body ctype) .none
        ;ready (http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace (finish outcome state)))))
        ;line (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace [200 (told outcome state)])))
      ; (? line
          > response=http_response
            = text (http_foot/body_text response)
            ? (gt text.len 0) (Send foot (http_foot/action/broadcast text)) 0
          > (./bat status body ctype) 0
          > (./bytes status body ctype) 0)
      | ready
     > (./told read line)
      = ;ready (http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot read)))
      ; (? (gt line.len 0) (Send foot (http_foot/action/broadcast line)) 0)
      | ready
     > (./after read next)
      = ;answer (http_foot/ask foot (http_foot/action/snapshot read))
      ? answer
       > response=http_response (http_foot/perform foot (next response.status (http_foot/body_text response)))
       > (./bat status body ctype) (http_foot/encode_bat status body ctype)
       > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
     > (./reply response) (http_foot/encode response)
     > (./bat status body ctype) (http_foot/encode_bat status body ctype)
     > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
    | http_foot/encode_answer (http_foot/ask foot action)
  + listener
    \ config=http_foot/config fd=nat self=nat
    ^ nat
    = ;[root caps] (Recv[path] 0)
      foot caps.at(0)
    % ignored=nat 0
    = ;connection (Accept fd)
      ;planned (http_foot/plan config connection)
      ;actor (Spawn (http_foot/connection connection planned))
    ; (SendCaps actor root [foot])
    ; (CloseHandle actor)
    | _ 0
  + reply
    \ conn=nat response=http_response
    ^ nat
    ; (Send conn response)
    | CloseHandle conn
  + inspect_renderer
    ' One renderer retains the immutable Grove registry, not a fresh actor
    ' and transferred renderer closure per request. The foot/coordinator
    ' remains free to acknowledge writes and deliver bounded reads.
    \ render={\ either[iota inspect_read/result]}http_response self=nat
    ^ nat
    % ignored=nat 0
    = ;[result caps] (Recv[either[iota inspect_read/result]] 0)
      response
        ? (Try render result)
         > (./ok ready) ready
         > (./err _) (http_driver/response 500 "Inspection rendering failed")
    ; (http_foot/reply caps.at(0) response)
    | _ 0
  + value_error
    \ reason=iota status=nat
    ^ http_response
    | http_response status (str/to_atom (value_read/error_json reason)) "application/json; charset=utf-8"
  + value_response
    \ result=either[iota value_read/chunk]
    ^ http_response
    ? result
     > (./err reason) (http_foot/value_error reason (value_read/status reason))
     > (./ok chunk)
       = ;body (str/to_atom (value_read/json chunk))
       | http_response 200 body "application/json; charset=utf-8"
  + physical_response
    \ result=either[iota str]
    ^ http_response
    ? result
     > (./err reason) (http_foot/value_error reason (physical_projection/status reason))
     > (./ok body)
       | http_response 200 (str/to_atom body) "application/json; charset=utf-8"
  + finish
    \ parent=nat binding=axal[saga] pending=row[http_foot/pending] queue=row[http_foot/ack]
    ^ [pending=row[http_foot/pending] queue=row[http_foot/ack]]
    % i=nat 0 left=row[http_foot/pending] [] acks=row[http_foot/ack] queue
    ? (eq i pending.len) [left acks]
    = item pending.at(i)
    ? (maybe/is_some (dig_of item.key))
      | _ i.inc left.snoc(item) acks
    =
      response=maybe[http_response]
        ? binding.get([item.key])
         > (./some version) (http_driver/result (./known (unpin version.myth)))
         > .none .none
    ? response
     > .none (_ i.inc left.snoc(item) acks)
     > (./some ready)
      ; (http_foot/reply item.conn ready)
      ; (Send parent (feet/gift/pass [item.key] .cull))
      | _ i.inc left acks.snoc(.cleanup)
  + run
    \ initial=feet/task/init self=nat
    ^ nat
    | http_foot/run_with http_foot/empty initial self
  + run_with
    \ config=http_foot/config initial=feet/task/init self=nat
    ^ nat
    = root=path
        ? initial.ax.fil
         > (./some version)
          | (unpin version.myth).path_at(['namespace_root]).fall []
        []
      port=nat
        ? initial.ax.fil
         > (./some version) (unpin version.myth).nat_at(['port] 0)
        0
      ;fd (Listen port)
      ;pump (Spawn (http_foot/listener config fd))
      ;renderer (Spawn (http_foot/inspect_renderer config.inspect))
      ;streams (Spawn http_foot/fanout)
    ; (SendCaps pump root [0])
    ; (CloseHandle pump)
    ; (Trace "HTTP foot listening" 0)
    % serial=nat 0 pending=row[http_foot/pending] [] queue=row[http_foot/ack] [] cache=axal[pail] (axal/new[pail] .none)
    = ;[message caps] (Recv[http_foot/task] 0)
    ? message
     > (http_foot/action/asset home name mime)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/asset serial home name mime))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (feet/task/asset request mime bytes)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (? bytes
              > (./some body)
                ; (Send item.conn (http_foot/action/bytes 200 body mime))
                | CloseHandle item.conn
              > .none (http_foot/reply item.conn (http_driver/response 404 "Asset not published")))
          out
      | _ serial left queue cache
     > (http_foot/action/memo key read)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/snapshot_bat serial (http_foot/memo_read key cache.get(key) read)))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/snapshot_bat read)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/snapshot_bat serial read))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/interact_bat query encode)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/interact_bat serial query encode))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (feet/task/binary request status body mime)
      ? body
       > result=http_foot/cache_answer
        ; (helm/supervisor/close_caps caps)
        = empty=row[http_foot/pending] []
          ;left
            | pending.fold empty
            \ ;out=row[http_foot/pending] item=http_foot/pending
            ^ row[http_foot/pending]
            ? !(eq_iota item.key ($u request)) out.snoc(item)
            ; (http_foot/reply item.conn (http_driver/response result.status result.body))
            out
        | _ serial left queue cache.put(result.key result.value)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (Send item.conn (http_foot/action/bat status body mime))
          out
      | _ serial left queue cache
     > (http_foot/action/snapshot read)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/snapshot serial read))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/transact run)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/transact serial run))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/interact query)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/interact serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/develop query)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/develop serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (feet/task/develop request status body)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn (http_response status (str/to_atom body) "application/json; charset=utf-8"))
          out
      | _ serial left queue cache
     > (http_foot/action/install source version target back)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/install source version target))
      | _ serial.inc pending queue.snoc((http_foot/ack/install conn back)) cache
     > (http_foot/action/write pax wit back)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/poke pax wit))
      | _ serial.inc pending queue.snoc((http_foot/ack/write conn back)) cache
     > (http_foot/action/batch writes finish)
      ? (eq caps.len 0) (_ serial pending queue cache)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A batch is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue cache
     > (http_foot/action/batch_told writes finish told)
      ? (eq caps.len 0) (_ serial pending queue cache)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A batch is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue cache
     > (http_foot/action/told read line)
      ? (eq caps.len 0) (_ serial pending queue cache)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A told read is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue cache
     > .stream
      ? (eq caps.len 0) (_ serial pending queue cache)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A stream is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue cache
     > .join
      ' a stream connection joining: its handle goes to the fan-out
      ? (eq caps.len 0) (_ serial pending queue cache)
      = joined=http_foot/stream_msg .join
      ; (SendCaps streams joined [caps.at(0)])
      ; (helm/supervisor/close_caps caps)
      | _ serial pending queue cache
     > (http_foot/action/broadcast line)
      ; (helm/supervisor/close_caps caps)
      ; (Send streams (http_foot/stream_msg/line line))
      | _ serial pending queue cache
     > (http_foot/action/after read next)
      ? (eq caps.len 0) (_ serial pending queue cache)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "An after is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue cache
     > (http_foot/action/commit pax wit done)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/poke pax wit))
      | _ serial.inc pending queue.snoc((http_foot/ack/commit conn done)) cache
     > (http_foot/action/commit_many writes done)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/batch writes))
      | _ serial.inc pending queue.snoc((http_foot/ack/commit conn done)) cache
     > (http_foot/action/wait record)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
        key=iota ($ts (str/cat_all ["r" (nat/show serial)]))
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/pass [key] (writ/make record)))
      | _ serial.inc pending.snoc((http_foot/pending key conn)) queue.snoc((http_foot/ack/request key)) cache
     > (http_foot/action/journal before limit)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/journal serial before limit))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/value query)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/value serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/physical query)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/physical serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (http_foot/action/inspect query)
      ? (eq caps.len 0) (_ serial pending queue cache)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/inspect serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue cache
     > (feet/task/inspect request result)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (SendCaps renderer result [item.conn])
          ; (CloseHandle item.conn)
          out
      | _ serial left queue cache
     > (feet/task/physical request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try http_foot/physical_response result)
           > (./ok ready) ready
           > (./err _) (http_foot/value_error 'read_failed 500)
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue cache
     > (feet/task/value request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try http_foot/value_response result)
           > (./ok ready) ready
           > (./err _) (http_foot/value_error 'read_failed 500)
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue cache
     > (feet/task/journal request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try config.journal result)
           > (./ok ready) ready
           > (./err _) (http_driver/response 500 "Journal rendering failed")
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue cache
     > (./fact binding)
      = ;[left acks] (http_foot/finish initial.parent binding pending queue)
      | _ serial left acks cache
     > (./ack err)
      ? (eq queue.len 0) (_ serial pending queue cache)
      = head queue.at(0)
        tail queue.drop(1)
      ? head
       > (./install conn back)
        = response
            ? err
             > .none (http_driver/back back)
             > (./some cause)
              = reason=str
                  ? cause
                   > fault=helm/supervisor/rejection
                    | str/from_atom (iota_show fault.reason)
                  "installation_failed"
              | http_driver/response 409
                  (str/cat_all ["Installation rejected: " reason
                    ". Refresh the Grove template before retrying."])
        ; (http_foot/reply conn response)
        | _ serial pending tail cache
       > (./write conn back)
        = response
            ? err
             > .none (http_driver/back back)
             > (./some _) (http_driver/response 500 "Namespace write rejected")
        ; (http_foot/reply conn response)
        | _ serial pending tail cache
       > (./commit conn done)
        ; (http_foot/reply conn (done err))
        | _ serial pending tail cache
       > (./request key)
        ? err
         > .none (_ serial pending tail cache)
         > (./some _)
          = empty=row[http_foot/pending] []
            ;left
              | pending.fold empty
              \ ;out=row[http_foot/pending] item=http_foot/pending
              ^ row[http_foot/pending]
              ? !(equal item.key key) out.snoc(item)
              ; (http_foot/reply item.conn (http_driver/response 500 "Namespace request rejected"))
              out
          | _ serial left tail cache
       > .cleanup (_ serial pending tail cache)
    ; (helm/supervisor/close_caps caps)
    | _ serial pending queue cache

  + route
    : prefix=str plan={\ http_foot/request nat}http_foot/action
  + config
    : routes=row[http_foot/route]
      inspect={\ either[iota inspect_read/result]}http_response
      journal={\ either[iota helm/journal_page]}http_response
  + asset
    : url=str bytes=nat mime=str
  + asset_body
    \ url=str assets=row[http_foot/asset]
    ^ str
    % idx=nat 0
    ? (eq idx assets.len) ""
    = item assets.at(idx)
    ? (equal url item.url) (http_foot/unbar item.bytes)
    | _ idx.inc
  + empty
    ^ http_foot/config
    | http_foot/config []
      (\ ignored (http_driver/response 404 "Not found"))
      (\ ignored (http_driver/response 404 "Not found"))
  + matches
    \ prefix=str url=str
    ^ bool
    ? (equal prefix "/") .true
    | http_foot/route_is prefix url
  + dispatch
    \ routes=row[http_foot/route] request=http_foot/request now=nat
    ^ http_foot/action
    = url (http_foot/split 63 request.target).at(0)
    % idx=nat 0 best=maybe[http_foot/route] .none
    ^ http_foot/action
    ? (eq idx routes.len)
      > (./some hit) best
        | ./reply (http_driver/response 404 "Not found")
      = run hit.plan
      | run request now
    = item routes.at(idx)
      longer
        > (./some hit) best .true
        | gt item.prefix.len hit.prefix.len
      next=maybe[http_foot/route]
        ? (and longer (http_foot/matches item.prefix url))
          | ./some item
        best
    | _ idx.inc next
  + route_collision
    \ prefix=str routes=row[http_foot/route] count=nat
    ^ bool
    % idx=nat 0
    ? (eq idx count) .false
    = item routes.at(idx)
    ? (equal[str] prefix item.prefix) .true
    | _ idx.inc
  + add_routes
    \ extra=row[http_foot/route] config=http_foot/config
    ^ http_foot/config
    = routes=row[http_foot/route] config.routes.weld(extra)
    % idx=nat 0
    ^ http_foot/config
    ? (eq idx routes.len) config.set_routes(routes)
    = item routes.at(idx)
    ? (http_foot/route_collision item.prefix routes idx)
      | http_foot/invalid_routes config
    | _ idx.inc
  + invalid_routes
    \ config=http_foot/config
    ^ http_foot/config
    ; (error (http_foot/fault "Duplicate HTTP route"))
    config

  + live_plan
    \ home=path bindings=row[[str str]]
      plan={\ http_foot/request nat}http_foot/action
      request=http_foot/request now=nat
    ^ http_foot/action
    = original (plan request now)
    ? !(equal request.method "GET") original
    = mime=maybe[nat]
        ? original
         > (./bytes status body mime) (? (eq status 200) (./some mime) .none)
         > (./reply response) (? (eq response.status 200) (./some response.ctype) .none)
        .none
    > (./some mime) mime original
    = url (http_foot/split 63 request.target).at(0)
    % idx=nat 0
    ^ http_foot/action
    ? (eq idx bindings.len) original
    = [route name] bindings.at(idx)
    ? (equal route url) (./asset home name mime)
    | _ idx.inc
  + live_assets
    ' Only manifest-declared asset URLs use the published mount bundle.
    \ home=path manifest=str config=http_foot/config
    ^ http_foot/config
    = bindings (mount_assets/bindings manifest)
    | config.set_routes
      | config.routes.map
        \ route=http_foot/route
        | route.set_plan (http_foot/live_plan home bindings route.plan)

' --- fs_sync_foot ---

+ fs_foot
  + get_root
    \ ax=axal[saga]
    ^ myth
    > (./some rec) ax.fil
     myth/new
    | unpin rec.myth

  + get_pending
    \ mit=myth
    ^ bool
    = lot mit.get(bond/pending)
    lot.then(pails/b/try_from_pail).run(pails/b/b).fall(.false)

  + get_epoch
    \ mit=myth
    ^ nat
    | mit.nat_at bond/epoch 0

  + scan_requested
    \ reader={\ str}either[str row[fs_read/file]]
      parent=nat key=iota mit=myth
    ^ nat
    = root | mit.txt_at bond/from
      epoc | ;/get_epoch mit
    = ;scan | Try reader root
    ? scan
     > (./err why)
      | Send parent (feet/gift/pass [key]
          (writ/poke (myth/sing bond/res
            (fs/failure epoc mit "Filesystem scan threw"))))
     > (./ok result)
      ? result
       > (./err why)
        | Send parent (feet/gift/pass [key]
            (writ/poke (myth/sing bond/res
              (fs/failure epoc mit why))))
       > (./ok files)
        = done | fs/batch epoc mit files
          rec | myth/sing bond/res done
        | Send parent (feet/gift/pass [key] (writ/poke rec))

  + changed
    ' The parent binding is care-y: one record per sync child.
    \ reader={\ str}either[str row[fs_read/file]]
      parent=nat old=axal[saga] new=axal[saga]
    ^ nat
    = kids new.kid_tap
    % idx=nat 0
    ^ nat
    ? (eq idx kids.len) 0
    = [key tree] kids.at(idx)
      rec | ;/get_root tree
      needed
        > (./some saga) (old.get([key])) .true
        | gt (;/get_epoch rec) (;/get_epoch (unpin saga.myth))
    ? !(is_text key)
     | _ idx.inc
    ? (and (;/get_pending rec) needed)
     ; | ;/scan_requested reader parent key rec
     | _ idx.inc
    | _ idx.inc

  + run
    \ init=feet/task/init self=nat
    ^ nat
    | fs_foot/run_with fs_read/read init self
  + run_with
    \ reader={\ str}either[str row[fs_read/file]]
      init=feet/task/init self=nat
    ^ nat
    ; | ;/changed reader init.parent (axal/new[saga] .none) init.ax
    % old=axal[saga] init.ax
    = ;[msg caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? msg
     > (./ack ack)
      ? ack
       > .none (_ old)
       > (./some err)
        ; | Trace ["filesystem write rejected" err] 0
        | _ old
     > (./fact ax)
      ; | ;/changed reader init.parent old ax
      | _ ax
    ; | Trace ["unexpected filesystem message" msg] 0
    | _ old

' --- eden ---

'  Eden boots the namespace and core services; mounts supply applications.
'  Base installation runs through Lain before Eden starts actors.
'  Grove instances install later through the supervisor.
+  eden
  +  failed
    : stage=iota reason=iota

  +  manifest
    ^ mani
    = roots=row[[path myth]]
        [[['gov] (root/named "Published views" "Grove definitions and templates available to applications.")]
         [['app] (root/named "Applications" "Installed applications and their records.")]
         [['io] (root/named "Connections" "Live input and output services.")]
         [['boot] (root/named "Compiler" "Compiled module records; compiler mirroring is not installed yet.")]
         [['weft] (root/named "Components" "Registered components available to views.")]
         [['lib] (root/named "Code library" "Published modules and their definitions.")]
         [['kook] (root/named "Behaviors" "Registered behavior implementations.")]
         [['hello] ((root/named "Welcome" "A greeting from Eden.")).put(['message] (pails/t "Hello from Eden."))]]
    | mani 'eden (lore "Local workspace" ["Applications, published code and connections on this node."] [])
      [(kook/decl 'hserve http/serve_form (lore/line "HTTP request serving."))
       (kook/decl 'fs fs/form
         (lore/line "Filesystem scan requests."))
       (kook/decl 'ward ward/form (lore/line "Contract adoption."))
       (kook/decl 'fresh fresh/form (lore/line "Live references."))]
      roots.weld(weft_std/seeds).weld(graph/seeds)
      []

  + boot
    ' The caller supplies a node identity and a trusted system pin.
    ' Boot returns a namespace only after every local stage succeeds.
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ either[eden/failed namespace]
    ? ((eq port 0) || (gt port 65535))
      | ./err (eden/failed 'http 'invalid_port)
    > (./ok initial) (namespace/create self local system)
      | ./err (eden/failed 'namespace 'invalid_namespace)
    = root=path [self]
      registry=path [self 'kook 'pact]
      first
        | task/vine registry
          (writ/make (form/card pact/form
            (lore/line "Pact: application mounting.")))
      mounted
        | (pact/card eden/manifest "eden" 0 0).put
          limb_slot (kook [registry])
      mounted mounted.put(bond/lede (pails/t "Local workspace")).put(bond/help (pails/t "Applications, published code and connections on this node."))
      second | task/vine root (writ/make mounted)
      listener
        | http/cfg_port [self 'kook 'hserve]
          [self 'kook 'hserve] port
      listener listener.put(bond/lede (pails/t "HTTP server")).put(bond/help (pails/t "Serves mounted applications and namespace requests."))
      third
        | task/vine [self 'io 'http] (writ/make listener)
      filesystem | root/named "Source mounts" "Folders synchronized with the namespace."
      fourth
        | task/vine [self 'io 'fs] (writ/make filesystem)
      stages=row[[iota task]]
        [['pact first] ['namespace second]
         ['http third] ['fs fourth]]
    % idx=nat 0 state=namespace initial
    ^ either[eden/failed namespace]
    ? (eq idx stages.len) (./ok state)
    = [name command] stages.at(idx)
    ? (sovereign_run_event command 0 0 0 state)
     > (./fail why) (./err (eden/failed name why))
     > (./ripe next effects signs ack)
       ? effects.len
         | ./err (eden/failed name 'unexpected_boot_effect)
       | _ idx.inc next

  +  make
    '  Typed constructors for the browser route adapter.
    \ target=path record=myth
    ^ task
    | task/vine target (writ/make record)
  +  poke
    \ target=path record=myth
    ^ task
    | task/vine target (writ/poke record)
  +  cull
    \ target=path
    ^ task
    | task/vine target .cull
  +  warp
    \ target=path operation=path input=myth
    ^ task
    | task/vine target (writ/warp operation input)
  +  err
    : msg=str
  +  throw
    \ txt=str
    ^ nat
    | error | eden/err | txt
  + serve
    \ state=namespace
    ^ nat
    | eden/serve_with state http_foot/run
  + serve_with
    \ state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    | eden/serve_access helm/supervisor/local_access state entry
  + serve_access
    \ access=helm/supervisor/access[namespace]
      state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    | eden/serve_read access fs_read/read state entry
  + serve_read
    ' Serve the foot's reads: files from the reader, under the supervisor's access to the namespace, as one foot task.
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    ' Disposable worlds do not publish a saved program root, but their pins
    ' still need store residency. Otherwise every collection copies the
    ' entire growing index and its history. Ice stages immutable pins only.
    = held (pin state)
      handler (pin entry)
    ; (Ice held)
    ; (Ice handler)
    = stage
        \ next=namespace
        ^ nat
        | Ice (pin next)
    | eden/serve_keeping access reader (unpin held) (unpin handler) stage
  + serve_keeping
    '  serve_read, and keep sees every admitted state
    '  (helm/supervisor/run_keeping).
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
      keep={\ namespace}nat
    ^ nat
    = start
        \ self=nat
        ^ nat
        | helm/supervisor/run_keeping[namespace] access keep state self
    = ;server (Spawn start)
      registrations=row[helm/supervisor/register]
        [(helm/supervisor/register [state.self 'io 'fs] (fs_foot/run_with reader))
         (helm/supervisor/register [state.self 'io 'http]
           entry)]
    % idx=nat 0
    ^ nat
    ? (eq idx registrations.len) server
    ; (SendCaps server registrations.at(idx) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./ack err)
       ? err
        > .none (_ idx.inc)
        > (./some why) (error why)
    | eden/throw "Foot registration failed"

  + serve_saved
    '  Serve, and save the world as the store root after every event:
    '  running the snapshot again resumes it (eden/resume).  install
    '  installs the compiler; the runtime forgets it between processes.
    '  remount scans the mounts again from the checkout a resumed process
    '  started from and rebuilds the HTTP entry, so a kept world runs the
    '  mounts as they are now, over the records as they were saved.
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
      install={\ nat}nat
      remount={\ {\ str}either[str row[fs_read/file]] namespace}[namespace {\ feet/task/init nat}nat]
    ^ nat
    | eden/serve_keeping access reader state entry
      (eden/keeper access entry install remount)
  + keeper
    '  The keep that saves the world: the store root becomes the program
    '  that serves this state again.
    \ access=helm/supervisor/access[namespace]
      entry={\ feet/task/init nat}nat install={\ nat}nat
      remount={\ {\ str}either[str row[fs_read/file]] namespace}[namespace {\ feet/task/init nat}nat]
    ^ {\ namespace}nat
    \ state=namespace
    ^ nat
    | Save (pin (eden/resume access entry install remount state))
  + resume
    '  The program a saved world's store root holds.  The runtime applies
    '  it to its argument row, the scanner port and token (fs_read/remote,
    '  both optional): it installs the compiler, remounts the mounts from
    '  the checkout, prints EDEN-RESUMED and serves the state, saving
    '  after every event as before.
    \ access=helm/supervisor/access[namespace]
      entry={\ feet/task/init nat}nat install={\ nat}nat
      remount={\ {\ str}either[str row[fs_read/file]] namespace}[namespace {\ feet/task/init nat}nat]
      state=namespace
    ^ {\ row[str]}nat
    \ args=row[str]
    ^ nat
    = port (eden/arg_nat args 0)
      token (eden/arg_str args 1)
      reader
        \ root=str
        ^ either[str row[fs_read/file]]
        | fs_read/remote port token root
    ; (install 0)
    = [current fresh] (remount reader state)
    ; (Trace "EDEN-RESUMED" 0)
    = ;server (eden/serve_saved access reader current fresh install remount)
    '  The runtime ends every actor when the root program returns, and
    '  on a fresh boot it is the repl reading stdin that keeps the world
    '  alive.  Read stdin the same way: the launcher holds the pipe open,
    '  and closing it is the stop.  Whatever arrives is ignored.
    % served=nat server
    ^ nat
    = ;got (Input 65536)
    ? (le got 1) served
    | _ served
  + arg_nat
    ' A launcher argument as a number; 0 when absent or not a number.
    \ args=row[str] idx=nat
    ^ nat
    ? (le args.len idx) 0
    ? (nat/parse args.at(idx))
     > (./some n) n
    0
  + arg_str
    ' A launcher argument as text; empty when absent.
    \ args=row[str] idx=nat
    ^ str
    ? (le args.len idx) ""
    | args.at(idx)
  + main
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ nat
    ? (eden/boot self system local port)
     > (./err why) (error why)
     > (./ok state) (eden/serve state)

' --- grove_actions ---

' Actions decode arguments separately from the receiver record.
+ grove_actions
  + shape
    : receiver=rex fields=grove_roles/shape code=row[rex]
  + is_action
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind)
      | equal kind (grove/tag_kind/action)
    .false
  + finish
    \ span=rex/source_span receiver=maybe[rex]
      fields=grove_roles/shape code=maybe[row[rex]]
    ^ either[grove/error grove_actions/shape]
    > (./some target) receiver
      | grove_roles/fail[grove_actions/shape] span
        "Action requires one #on role."
    > (./some trees) code
      | grove_roles/fail[grove_actions/shape] span
        "Action requires an explicit Foil implementation."
    ? (eq trees.len 0)
      | grove_roles/fail[grove_actions/shape] span
        "Empty action implementation."
    | ./ok (grove_actions/shape target fields trees)
  + analyze
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span body=list[grove/statement]
    ^ either[grove/error grove_actions/shape]
    % rest=list[grove/statement] body receiver=maybe[rex] .none
      fields=grove_roles/shape (grove_roles/shape .nil .nil)
      code=maybe[row[rex]] .none
    ^ either[grove/error grove_actions/shape]
    ? (eq rest.len 0)
      | grove_actions/finish span receiver fields code
    ? rest.at(0)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/action)) ||
         (equal kind (grove/tag_kind/slot)))
        | _ rest.drop(1) receiver fields code
      | grove_roles/fail[grove_actions/shape] at
        "Incompatible action tag."
     > (grove/comment at text)
      | _ rest.drop(1) receiver fields code
     > (grove/block at kind kids)
      ? (equal kind (grove/block_kind/meta))
        | _ rest.drop(1) receiver fields code
      | grove_roles/fail[grove_actions/shape] at
        "Unsupported action block."
     > (grove/property at slot type)
      < next (grove_roles/properties root doc lookup .false at
          (list/one rest.head) fields)
      = field next.fields.at((dec next.fields.len))
      = reserved=row[str] ["card" "current" "receiver"]
      ? reserved.has(field.name)
        | grove_roles/fail[grove_actions/shape] at
          "Action argument name conflicts with a generated binding."
      = next next.set_need(next.need.snoc((list/one field.slot)))
      | _ rest.drop(1) receiver next code
     > (grove/directive at kind target)
      ? !(equal kind (grove/directive_kind/on))
        | grove_roles/fail[grove_actions/shape] at
          "Only #on is supported on actions."
      ? receiver
       > (./some old)
        | grove_roles/fail[grove_actions/shape] at
          "Duplicate action receiver."
       > .none
        < checked (grove_roles/parent root doc lookup [] target)
        | _ rest.drop(1) (./some (rex/normalize target)) fields code
     > (grove/presentation at ignored)
      | grove_roles/fail[grove_actions/shape] at
        "Goo bodies require @view."
     > (grove/implementation at trees)
      ? code
       > (./some old)
        | grove_roles/fail[grove_actions/shape] at
          "Duplicate action implementation."
       > .none
        | _ rest.drop(1) receiver fields (./some trees)
  + code
    \ root=path doc=grove/document lookup={\ path}maybe[myth] span=rex/source_span
      name=str shape=grove_actions/shape
    ^ either[grove/error row[rex]]
    = self (rex/path [name])
      role shape.receiver
      types shape.fields.fields.map((\ field field.type))
      labels
        | (row/range 0 types.len).map
        \ i
        | str/join "" ["ARG" (nat/show i)]
      pairs
        | (row/range 0 types.len).map
        \ i
        [labels.at(i) types.at(i)]
      params
        | (row/range 0 types.len).map
        \ i
        | str/join "" ["arg" (nat/show i) "=" labels.at(i)]
      args
        | (row/range 0 types.len).map
        \ i
        | rex/word (str/join "" ["arg" (nat/show i)])
      implementation (grove_roles/member ["implementation"] self)
      invoke_body
        | rex/rune "|"
          args.cons(implementation).snoc((rex/word "receiver"))
      run
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " "
                (str/join " " params.snoc("receiver=ROLE"))])
             "^ ROLE" "BODY"])
          pairs.snoc(["ROLE" role]).snoc(["BODY" invoke_body])
      names shape.fields.fields.map((\ field (rex/word field.name)))
      invoke (grove_roles/member ["run"] self)
      call
        | rex/rune "|" names.cons(invoke).snoc((rex/word "receiver")).row
      finish
        | rex/rune "|" [(grove_roles/member ["to_myth"] role) call]
      chain
        | list/fold[grove_roles/field rex] finish
          (grove_roles/read_step self)
          shape.fields.fields.reverse
      apply
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92)
                " card=myth current=myth"])
             "^ maybe[myth]"
             "< receiver (FROM current)"
             "BODY"])
          [["FROM" (grove_roles/member ["from_myth"] role)]
           ["BODY" chain]]
    < parts (grove_roles/parts role)
    = imported
        | (grove_roles/imports doc).any
        \ imp
        | equal parts.at(0) ($ts imp.alias)
    = reference
        | rex/path parts.map((\ part (str/from_atom (quip_val part))))
    < receiver (grove_roles/slot root doc lookup reference)
    = receiver (? imported receiver root.weld(parts))
    = args (grove_roles/schema_code shape.fields)
      schema
        | rex/rune "|" [(rex/word "grove_action_schema")
          (grove_roles/path_value receiver) args]
    | ./ok
      [(grove_roles/decl "implementation" (rex/group shape.code))
      (grove_roles/decl "run" run)
      (grove_roles/decl "fields"
        (rex/group shape.fields.fields.map(grove_roles/field_code).row))
      (grove_roles/decl "apply" apply)
      (grove_roles/decl "schema" schema)]
  + located
    \ span=rex/source_span tree=rex
    ^ rex
    | tree.walk
    \ node
    ? (equal node.span rex/zero_span) node.with_span(span)
    node
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out.reverse))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0))
    ? !(grove_actions/is_action body)
      | _ rest.drop(1) out.cons(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Actions need a name."
    < shape (grove_actions/analyze root doc lookup span body)
    < trees (grove_actions/code root doc lookup span text shape)
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/path [text]))
      prop=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/action)) schema
      handler=grove/statement
        | grove/property span (rex/cord "/sys/grove/action_handler")
          (rex/rune "|" [(rex/word "grove_action_handler")
            (grove_roles/member ["apply"] (rex/path [text]))])
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) ((list/one handler).cons(prop))
      code=grove/statement
        | grove/implementation span
          trees.map((grove_actions/located span))
      decl=grove/item
        | grove/declaration span name kept.snoc(meta).snoc(code)
    | _ rest.drop(1) out.cons(decl)
  + prepare_all
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < doc (grove_actions/prepare root doc lookup)
    | grove_roles/prepare root doc lookup

' --- show ---

'  Namespace value formatting, independent of pages and HTTP.
'  Weft supplies the node brands recognized by show/pail.
+  show
  '  Namespace values as text.

  +  iota
    '  An iota as its canonical path-segment spelling — the iota_show
    '  jet, the exact inverse of the segment parser, so explorer URLs
    '  round-trip: symbols bare, nats decimal, strings $-sigiled,
    '  times/durations @-sigiled, binary 0w/0x.
    \  i=iota
    ^  nat
    | iota_show i

  +  path
    '  A path as "/a/b"; the empty path as "/".
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/"
    =  parts
         %  idx=nat 0  out=row[nat] []
         ?  (eq idx p.len)
            out
         | _ idx.inc out.snoc((show/iota p.at(idx)))
    | cord/cat "/" (cord/join "/" parts)

  +  tail
    '  An exact definition name, or a structural discriminator as text.
    '  ?=  ((show/tail (brand_encode ['sys 'example] 2)) "/sys/example@x2")
    \  b=nat
    ^  nat
    ? (nominal_brand b) (tyshow/definition_name b)
    | tyshow/atom_text b

  +  textish
    '  Printable-with-whitespace prose (what pails/t carries): the
    '  degrade rule would render it as a decimal blob, quoting reads.
    \  v=nat
    ^  bool
    ?  (eq v 0)
       .false
    %  rest=nat v  seen=nat 0
    ?  (eq rest 0)
       seen
    =  c  (mod rest 256)
    ?  (eq c 10)
       | _ (div rest 256) seen
    ?  (lt c 32)
       .false
    ?  (gt c 126)
       .false
    ?  (eq c " ")
       | _ (div rest 256) 1
    | _ (div rest 256) seen

  +  clip
    '  The first n bytes, an ellipsis when clipped.
    \  n=nat s=nat
    ^  nat
    ?  (le (wid s) n)
       s
    | cord/cat (cord/slice 0 n s) "…"

  +  leaf
    '  Nullary constructors show their exact definition moment. Other
    '  atoms follow the prose or aura formatting rules.
    '  ?=  ((show/leaf (brand_encode ['sys 'example] 1)) "/sys/example@x1")
    '  ?=  ((eq (show/leaf "/boot/care/x") ".x") .false)
    '  ?=  ((show/leaf 41) "$)")
    \  v=nat
    ^  nat
    ?  (nominal_brand v)
       | tyshow/definition_name v
    ?  (show/textish v)
       | cord/cat_all [34 (show/clip 42 v) 34]
    | nat_show v

  +  lines
    '  Newline count + 1: how many lines a text renders as.
    \ s=nat
    ^ nat
    | inc (cord/count 10 s)
  +  aura_tag
    '  Is b one of the fourteen aura tag cords (an iota's head)?
    \  b=nat
    ^  bool
    ?  (eq b "dm") .true
    ?  (eq b "dr") .true
    ?  (eq b "ds") .true
    ?  (eq b "f")  .true
    ?  (eq b "r")  .true
    ?  (eq b "rd") .true
    ?  (eq b "rs") .true
    ?  (eq b "s")  .true
    ?  (eq b "ta") .true
    ?  (eq b "ts") .true
    ?  (eq b "tu") .true
    ?  (eq b "u")  .true
    ?  (eq b "w")  .true
    ?  (eq b "x")  .true
    .false

  +  reg
    '  The reflection registry: (^ T) of a nominal row reflects to a
    '  rec whose cstr IS the runtime brand and whose items carry the
    '  field faces — slot values with these brands render faced.
    ^  row[type]
    [(^ mani) (^ doctest/verdict) (^ kook/decl) (^ dep) (^ hunt) (^ safe) (^ lore)]

  +  nom_named
    '  Does a reflected reference name this type?  Descriptor paths
    '  may be unit-qualified ("~"-headed) — the last segment is the
    '  name that matters here.
    \  pth=row[nat] name=nat
    ^  bool
    ?  (eq 0 pth.len)
       .false
    | eq pth.at(pth.len.dec) name

  +  reg_of
    '  The registry rec for a brand, or .none.
    \  b=nat
    ^  maybe[type]
    =  rs  show/reg
    %  idx=nat 0
    ^  maybe[type]
    ?  (eq idx rs.len)
       .none
    ?  rs.at(idx)
     > (./rec cstr items)
       ?  (eq cstr b)
          (./some rs.at(idx))
       | _ idx.inc
    | _ idx.inc

  +  brand
    '  Read nominal identity from the compiler's reflected descriptor.
    \  t=type
    ^  nat
    ?  t
     > (./rec cstr items) cstr
     > (./ref identity args) identity
    0

  +  value
    '  Any runtime value as text, reflection-guided: pins are
    '  invisible, branded rows render name{face=..} through the
    '  registry (positionally without it), iotas by their spelling,
    '  rows in brackets, bare nats by /show/leaf .  Depth-capped.
    \  v=any depth=nat
    ^  nat
    ?  (rep_pin v)
       | show/value (rep_unpin v) depth
    ?  (rep_law v)
       "law"
    ?  !(rep_app v)
       | show/leaf v
    =  h  (rep_hd v)
    ?  (eq h 0)
       | show/items "[" "]" v depth
    ?  (show/aura_tag h)
       ?  (eq 1 (rep_sz v))
          | iota_show v
       | show/pos h v depth
    ?  (eq (show/brand (^ form)) h)
       "form"
    ?  (eq (show/brand (^ mop/node[nat nat lt])) h)
       | show/tree v depth
    ?  (eq (show/brand (^ uon/node[nat])) h)
       | show/tree v depth
    = identity | nominal_brand v
    ? identity (show/branded identity v depth)
    "law"

  +  tree
    '  An ordered-map node (mop/uon internals share the shape
    '  [sz key val l r]) as its entries: {k→v ..}, width-capped —
    '  the tree is an implementation detail, the map is the value.
    \  v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       "{..}"
    =  parts
         %  todo=row[any] [v]  out=row[nat] []
         ?  (eq 0 todo.len)
            out
         ?  (gt out.len 5)
            out.snoc("..")
         =  n  todo.at(0)
            rest  todo.drop(1)
         ?  !(rep_app n)
            | _ rest out
         ?  (eq 5 (rep_sz n))
            (_ rest.cons((rep_ix 3 n)).cons((rep_ix 4 n))
               out.snoc(
                 (cord/cat_all [(show/value (rep_ix 1 n) depth.inc) "→"
                            (show/value (rep_ix 2 n) depth.inc)])))
         | _ rest out
    | cord/cat_all ["{" (cord/join " " parts) "}"]

  +  items
    '  A row's elements, width-capped at eight.
    \  open=nat close=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       | cord/cat_all [open ".." close]
    =  n  (rep_sz v)
       cap
         ?  (lt n 9)
            n
         8
       parts
         %  idx=nat 0  out=row[nat] []
         ?  (eq idx cap)
            out
         | _ idx.inc out.snoc((show/value (rep_ix idx v) depth.inc))
       extra
         ?  (lt cap n)
            | cord/cat_all [" +" (str/to_atom (nat/show (sub n cap)))]
         ""
    | cord/cat_all [open (cord/join " " parts) extra close]

  +  branded
    '  A branded row: faced through the registry when its rec is
    '  known (path-typed fields as paths), positional otherwise.
    \  h=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       | cord/cat (show/tail h) "{..}"
    ?  (show/reg_of h)
     > .none  (show/pos h v depth)
     > (./some d)
       ?  d
        > (./rec cstr items)
          ?  !(eq items.len (rep_sz v))
             | show/pos h v depth
          =  parts
               %  idx=nat 0  out=row[nat] []
               ?  (eq idx items.len)
                  out
               =  [face item]  items.at(idx)
                  fv
                    '  descriptor-directed: paths as paths, empty
                    '  rows as [] (an empty row IS nat 0 — only the
                    '  type knows the difference)
                    ?  item
                     > (./nom pth args)
                       ?  (show/nom_named pth "path")
                          | show/path (rep_ix idx v)
                       ?  (show/nom_named pth "row")
                          ?  !(rep_app (rep_ix idx v))
                             "[]"
                          | show/value (rep_ix idx v) depth.inc
                       | show/value (rep_ix idx v) depth.inc
                     > (./arr item2)
                       ?  !(rep_app (rep_ix idx v))
                          "[]"
                       | show/value (rep_ix idx v) depth.inc
                    | show/value (rep_ix idx v) depth.inc
                  part
                    ?  (eq face idx)
                       fv
                    | cord/cat_all [(tyshow/atom_text face) "=" fv]
               | _ idx.inc out.snoc(part)
          | cord/cat_all [(show/tail h) "{" (cord/join " " parts) "}"]
       | show/pos h v depth

  +  pos
    '  A branded row without a registry rec: positional fields.
    \  h=nat v=any depth=nat
    ^  nat
    | cord/cat (show/tail h) (show/items "(" ")" v depth)

  +  pail
    '  A slot value as text: the payloads this layer knows bespoke,
    '  and the reflection-guided walker for the open remainder.
    \  held=pail
    ^  nat
    ?  held
     > x=pails/dm (str/to_atom (temporal/timestamp ($dm x.n)))
     > x=pails/ds (str/to_atom (temporal/timestamp ($ds x.n)))
     > x=pails/dr (str/to_atom (temporal/duration x.n))
     > x=pails/n   (str/to_atom (nat/show x.n))
     > x=pails/z   (str/to_atom (str/cat_all ["-" (nat/show x.n)]))
     > q=pails/q   (show/iota q.q)
     > p=pails/p   (show/path p.p)
     > k=kook
       =  parts
            %  idx=nat 0  out=row[nat] []
            ?  (eq idx k.refs.len)
               out
            | _ idx.inc out.snoc((show/path k.refs.at(idx)))
       | cord/cat "kook " (cord/join " " parts)
     > c=cpail
       =  entries  c.crew.tap
          parts
            %  idx=nat 0  out=row[nat] []
            ?  (eq idx entries.len)
               out
            =  e  entries.at(idx)
               cn
                 ?  e.val.c
                  > .x  "x"
                  > .y  "y"
                  > .z  "z"
            (_ idx.inc
               out.snoc((cord/cat_all [cn "→" (show/path e.val.p)])))
       | cord/cat "crew " (cord/join "  " parts)
     > ps=pails/ps
       =  parts
            %  idx=nat 0  out=row[nat] []
            ?  (eq idx ps.ps.len)
               out
            | _ idx.inc out.snoc((show/path ps.ps.at(idx)))
       | cord/join "  " parts
     > form         "form"
     > t=pails/t    t.t
     > d=pails/ty   (tyshow/show d.t)
     > pails/code   "code"
     > dyed           "dyed overlay"
     > knit           "knit overlay"
     > felt           "felt overlay"
     > sewn           "sewn overlay"
     > weft/node/tx   "html fragment"
     > weft/node/raw  "html fragment"
     > weft/node/el   "html fragment"
     > doc=lore
       ?  (eq 0 doc.tests.len)
          doc.head
       | cord/cat_all [doc.head "  [?= " (str/to_atom (nat/show doc.tests.len)) "]"]
    | show/value held 0

' --- grove_stencils ---

' Typed creation declarations, separate from receiver-updating actions.
+ grove_stencils
  + is_stencil
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/stencil))
    .false
  + reference
    \ root=path doc=grove/document lookup={\ path}maybe[myth] role=rex
    ^ either[grove/error path]
    < parts (grove_roles/parts role)
    = imported ((grove_roles/imports doc).any((\ imp (equal parts.at(0) ($ts imp.alias)))))
      reference (rex/path parts.map((\ part (str/from_atom (quip_val part)))))
    < resolved (grove_roles/slot root doc lookup reference)
    | ./ok (? imported resolved root.weld(parts))
  + analyze
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span body=list[grove/statement]
    ^ either[grove/error [grove_actions/shape rex]]
    ? (grove_actions/is_action body)
      | grove_roles/fail[[grove_actions/shape rex]] span "A declaration cannot be both an action and a stencil."
    = outputs
        | body.keep
        \ stmt
        ? stmt
         > (grove/directive at kind target) (equal kind (grove/directive_kind/for))
        .false
    ? !(eq outputs.len 1)
      | grove_roles/fail[[grove_actions/shape rex]] span "Stencil requires exactly one #for result role."
    > (grove/directive at kind result) outputs.head
      (grove_roles/fail[[grove_actions/shape rex]] span "Missing stencil result role.")
    < checked (grove_roles/parent root doc lookup [] result)
    = translated
        | body.keep((\ stmt !(outputs.has(stmt)))).map
        \ stmt
        ? stmt
         > (grove/tag at kind)
          ? (equal kind (grove/tag_kind/stencil)) (grove/tag at (grove/tag_kind/action))
          stmt
        stmt
    < shape (grove_actions/analyze root doc lookup span translated)
    ? (shape.fields.fields.any((\ field (eq field.name "created_at"))))
      | grove_roles/fail[[grove_actions/shape rex]] span "created_at is supplied by Shrine."
    | ./ok [shape (rex/normalize result)]
  + code
    \ root=path doc=grove/document lookup={\ path}maybe[myth] span=rex/source_span
      name=str shape=grove_actions/shape result=rex
    ^ either[grove/error row[rex]]
    = self (rex/path [name])
      role shape.receiver
      types shape.fields.fields.map((\ field field.type))
      labels
        | (row/range 0 types.len).map
        \ i
        | str/join "" ["ARG" (nat/show i)]
      pairs
        | (row/range 0 types.len).map
        \ i
        [labels.at(i) types.at(i)]
      params
        | (row/range 0 types.len).map
        \ i
        | str/join "" ["arg" (nat/show i) "=" labels.at(i)]
      args
        | (row/range 0 types.len).map
        \ i
        | rex/word (str/join "" ["arg" (nat/show i)])
      implementation (grove_roles/member ["implementation"] self)
      invoke_body
        | rex/rune "|"
          args.cons(implementation).snoc((rex/word "receiver")).snoc((rex/word "created_at"))
      run
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " "
                (str/join " " params.snoc("receiver=ROLE").snoc("created_at=nat"))])
             "^ RESULT" "BODY"])
          pairs.snoc(["RESULT" result]).snoc(["ROLE" role]).snoc(["BODY" invoke_body])
      names shape.fields.fields.map((\ field (rex/word field.name)))
      invoke (grove_roles/member ["run"] self)
      call
        | rex/rune "|" names.cons(invoke).snoc((rex/word "receiver")).snoc((rex/word "created_at")).row
      finish
        | rex/rune "|" [(grove_roles/member ["to_myth"] result) call]
      chain
        | list/fold[grove_roles/field rex] finish
          (grove_roles/read_step self)
          shape.fields.fields.reverse
      apply
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92)
                " created_at=nat card=myth current=myth"])
             "^ maybe[myth]"
             "< receiver (FROM current)"
             "BODY"])
          [["FROM" (grove_roles/member ["from_myth"] role)]
           ["BODY" chain]]
    < receiver (grove_stencils/reference root doc lookup role)
    < output (grove_stencils/reference root doc lookup result)
    = args (grove_roles/schema_code shape.fields)
      schema
        | rex/rune "|" [(rex/word "grove_stencil_schema")
          (grove_roles/path_value receiver) (grove_roles/path_value output) args]
    | ./ok
      [(grove_roles/decl "implementation" (rex/group shape.code))
      (grove_roles/decl "run" run)
      (grove_roles/decl "fields"
        (rex/group shape.fields.fields.map(grove_roles/field_code).row))
      (grove_roles/decl "apply" apply)
      (grove_roles/decl "schema" schema)]
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out.reverse))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0))
    ? !(grove_stencils/is_stencil body)
      | _ rest.drop(1) out.cons(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Stencils need a name."
    < analyzed (grove_stencils/analyze root doc lookup span body)
    = [shape result] analyzed
    < trees (grove_stencils/code root doc lookup span text shape result)
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/path [text]))
      prop=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/stencil)) schema
      handler=grove/statement
        | grove/property span (rex/cord "/sys/grove/stencil_handler")
          (rex/rune "|" [(rex/word "grove_stencil_handler")
            (grove_roles/member ["apply"] (rex/path [text]))])
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) ((list/one handler).cons(prop))
      code=grove/statement
        | grove/implementation span
          trees.map((grove_actions/located span))
      decl=grove/item
        | grove/declaration span name kept.snoc(meta).snoc(code)
    | _ rest.drop(1) out.cons(decl)
  + prepare_all
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < doc (grove_stencils/prepare root doc lookup)
    | grove_actions/prepare_all root doc lookup

' --- grove_norms ---

' A single path pattern and role constraints describe occupied records.
+ grove_norms
  + is_norm
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/norm))
    .false
  + segment
    \ span=rex/source_span text=str
    ^ either[grove/error grove_norm_segment]
    ? (eq (str/slice 0 1 text) "[")
      ? !(eq (str/slice (dec text.len) 1 text) "]")
        | grove_roles/fail[grove_norm_segment] span
          "Unclosed norm capture."
      = parts (str/split_byte 61 (str/slice 1 (sub text.len 2) text))
      ? !(eq parts.len 2)
        | grove_roles/fail[grove_norm_segment] span
          "Norm captures use [name=@aura]."
      | grove_norms/capture span parts.at(0) parts.at(1)
    > (./some parts) (path_parse (str/join "" ["/" text]))
      | grove_roles/fail[grove_norm_segment] span
        "Invalid literal norm path segment."
    ? !(eq parts.len 1)
      | grove_roles/fail[grove_norm_segment] span
        "Expected one literal norm path segment."
    | ./ok (grove_norm_segment "" (zeta/lit parts.at(0)))
  + capture
    \ span=rex/source_span label=str type=str
    ^ either[grove/error grove_norm_segment]
    > (./some name) (str/sym label)
      | grove_roles/fail[grove_norm_segment] span
        "Invalid norm capture name."
    ? !(eq (str/slice 0 1 type) "@")
      | grove_roles/fail[grove_norm_segment] span
        "Norm captures require an aura."
    = raw_aura (str/slice 1 (dec type.len) type)
    = aura=str (? (eq raw_aura "tas") "ts" raw_aura)
      allowed=row[str]
        ["dm" "dr" "ds" "f" "r" "rd" "rs" "s"
         "ta" "ts" "tu" "u" "w" "x"]
    ? !(allowed.has(aura))
      | grove_roles/fail[grove_norm_segment] span
        "Unknown norm capture aura."
    | ./ok
      (grove_norm_segment label (zeta/var (str/to_atom aura)))

  + pattern
    \ tree=rex
    ^ either[grove/error list[grove_norm_segment]]
    > (./leaf span shape text) tree
      | grove_roles/fail[list[grove_norm_segment]] tree.span
        "#here requires a quoted path pattern."
    = cord (equal tree.leaf_kind (maybe/some[str] "cord"))
      quip (equal tree.leaf_kind (maybe/some[str] "quip"))
    ? !(cord || quip)
      | grove_roles/fail[list[grove_norm_segment]] span
        "#here requires a quoted path pattern."
    = prefix=str (? cord "/" "'/")
    ? !(eq (str/slice 0 prefix.len text) prefix)
      | grove_roles/fail[list[grove_norm_segment]] span
        "Norm patterns require an absolute path."
    = source (str/slice prefix.len (sub text.len prefix.len) text)
    ? (eq source "") (./ok .nil)
    % rest=row[str] (str/split_byte 47 source)
      out=list[grove_norm_segment] .nil names=row[str] []
    ^ either[grove/error list[grove_norm_segment]]
    ? (eq rest.len 0) (./ok out)
    ? (eq rest.at(0) "")
      | grove_roles/fail[list[grove_norm_segment]] span
        "Empty norm path segment."
    < segment (grove_norms/segment span rest.at(0))
    ? !(eq segment.name "")
      ? names.has(segment.name)
        | grove_roles/fail[list[grove_norm_segment]] span
          "Duplicate norm capture name."
      | _ rest.drop(1) out.snoc(segment) names.snoc(segment.name)
    | _ rest.drop(1) out.snoc(segment) names
  + body
    \ span=rex/source_span body=list[grove/statement]
    ^ either[grove/error rex]
    % rest=list[grove/statement] body target=maybe[rex] .none
    ^ either[grove/error rex]
    ? (eq rest.len 0)
      ? target
       > (./some tree) (./ok tree)
       > .none
        | grove_roles/fail[rex] span "Norm requires one #here pattern."
    ? rest.at(0)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/norm)) ||
         (equal kind (grove/tag_kind/slot)))
        | _ rest.drop(1) target
      | grove_roles/fail[rex] at "Incompatible norm tag."
     > (grove/directive at kind tree)
      ? !(equal kind (grove/directive_kind/here))
        | _ rest.drop(1) target
      ? target
       > (./some old)
        | grove_roles/fail[rex] at "Duplicate norm path pattern."
       > .none (_ rest.drop(1) (./some tree))
    | _ rest.drop(1) target
  + role_body
    \ body=list[grove/statement]
    ^ list[grove/statement]
    | body.keep
    \ stmt
    ? stmt
     > (grove/tag span kind) .false
     > (grove/directive span kind target)
      | ! (equal kind (grove/directive_kind/here))
    .true
  + segment_code
    \ segment=grove_norm_segment
    ^ rex
    = pattern
        ? segment.pattern
         > (zeta/var aura)
          | rex/paren [(rex/path ["zeta" "var"])
            (rex/cord (str/from_atom aura))]
         > (zeta/lit value)
          = values (grove_roles/path_value [value])
          | rex/paren [(rex/path ["zeta" "lit"])
            values.children.at(0)]
    | rex/paren [(rex/word "grove_norm_segment")
      (rex/cord segment.name) pattern]
  + code
    \ span=rex/source_span name=str
      segments=list[grove_norm_segment] shape=grove_roles/shape
    ^ row[rex]
    = self (rex/path [name])
      item (grove_roles/member ["item"] self)
      schema_value
        | rex/paren [(rex/word "grove_norm_schema")
          (rex/brack segments.map(grove_norms/segment_code).row)
          (grove_roles/schema_code shape)]
      schema
        | grove_roles/template span
          (str/join (str/from_atom 10) ["^ grove_norm_schema" "| VALUE"])
          [["VALUE" schema_value]]
      pairs=row[[str rex]]
        [["SELF" self] ["ITEM" item]
         ["SEGMENTS"
          (rex/brack segments.map(grove_norms/segment_code).row)]]
      accepts
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " card=myth"])
             "^ bool" "| maybe/is_some (ITEM/from_myth card)"]) pairs
      validate
        | grove_roles/template span
          "(grove_norm_runtime/validate SEGMENTS SELF/accepts)" pairs
      check
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " tree=axal[myth]"])
             "^ maybe[axal[myth]]"
             "? (SELF/validate tree)"
             " > (./some path) .none"
             " > .none (./some tree)"]) pairs
      spec
        | grove_roles/template span
          "(grove_norm_runtime/spec SEGMENTS ITEM/spec)" pairs
    [(grove_roles/template span "axal[myth]" [])
     (grove_roles/decl "item"
       (rex/group (grove_roles/code_at span item shape)))
     (grove_roles/decl "schema" schema)
     (grove_roles/decl "accepts" accepts)
     (grove_roles/decl "validate" validate)
     (grove_roles/decl "check" check)
     (grove_roles/decl "spec" spec)]
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out.reverse))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0))
    ? !(grove_norms/is_norm body)
      | _ rest.drop(1) out.cons(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Norms need a name."
    < target (grove_norms/body span body)
    < segments (grove_norms/pattern target)
    < shape (grove_roles/analyze root doc lookup [] text
        (grove_norms/role_body body))
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/path [text]))
      prop=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/norm)) schema
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) (list/one prop)
      trees (grove_norms/code span text segments shape)
      code=grove/statement
        | grove/implementation span
          trees.map((grove_actions/located span))
    | _ rest.drop(1)
      out.cons((grove/declaration span name kept.snoc(meta).snoc(code)))
  + prepare_all
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < doc (grove_norms/prepare root doc lookup)
    | grove_stencils/prepare_all root doc lookup

' --- grove_sewn ---

' Tree transformations retain both norm boundaries in their module.
+ grove_sewn
  + endpoint
    : reference=rex path=path
  + shape
    : source=grove_sewn/endpoint target=grove_sewn/endpoint
      code=row[rex]
  + is_sewn
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/sewn))
    .false
  + resolve
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      tree=rex
    ^ either[grove/error grove_sewn/endpoint]
    < parts (grove_roles/parts (rex/normalize tree))
    ? !(eq parts.len 1)
      | grove_roles/fail[grove_sewn/endpoint] tree.span
        "Transformation endpoints require a norm name or import alias."
    = name (str/from_atom (quip_val parts.at(0)))
      reference (rex/path [name]).with_span(tree.span)
    % rest=list[grove/item] doc.items
    ^ either[grove/error grove_sewn/endpoint]
    ? (eq rest.len 0)
      | grove_roles/fail[grove_sewn/endpoint] tree.span "Unknown norm."
    ? rest.at(0)
     > (grove/declaration span nam body)
      ? nam
       > (grove/name/identifier text)
        ? !(eq text name) (_ rest.drop(1))
        ? !(grove_norms/is_norm body)
          | grove_roles/fail[grove_sewn/endpoint] tree.span
            "Transformation endpoint is not a norm."
        | ./ok (grove_sewn/endpoint reference root.weld(parts))
      | _ rest.drop(1)
     > (grove/import_decl span alias target)
      ? !(eq name alias) (_ rest.drop(1))
      < path (grove_roles/parts (rex/normalize target))
      > (./some card) (lookup path)
        | grove_roles/fail[grove_sewn/endpoint] span
          "Missing norm import."
      > (./some held) card.get(system_vocabulary/grove/norm)
        | grove_roles/fail[grove_sewn/endpoint] span
          "Imported declaration has no norm schema."
      > schema=grove_norm_schema held
        | grove_roles/fail[grove_sewn/endpoint] span
          "Invalid norm schema."
      | ./ok (grove_sewn/endpoint reference path)
    | _ rest.drop(1)
  + implementation
    \ span=rex/source_span body=list[grove/statement]
    ^ either[grove/error row[rex]]
    % rest=list[grove/statement] body code=maybe[row[rex]] .none
    ^ either[grove/error row[rex]]
    ? (eq rest.len 0)
      ? code
       > (./some trees) (./ok trees)
       > .none
        | grove_roles/fail[row[rex]] span
          "get requires an explicit Foil implementation."
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) code)
     > (grove/presentation at ignored)
      | grove_roles/fail[row[rex]] at
        "Goo bodies require @view."
     > (grove/implementation at trees)
      ? code
       > (./some old)
        | grove_roles/fail[row[rex]] at "Duplicate get implementation."
       > .none
        ? (eq trees.len 0)
          | grove_roles/fail[row[rex]] at "Empty get implementation."
        | _ rest.drop(1) (./some trees)
    | grove_roles/fail[row[rex]] span
      "get contains only comments and an explicit Foil implementation."
  + finish
    \ span=rex/source_span source=maybe[grove_sewn/endpoint]
      target=maybe[grove_sewn/endpoint] code=maybe[row[rex]]
    ^ either[grove/error grove_sewn/shape]
    > (./some from) source
      | grove_roles/fail[grove_sewn/shape] span "Missing #from norm."
    > (./some to) target
      | grove_roles/fail[grove_sewn/shape] span "Missing #to norm."
    > (./some trees) code
      | grove_roles/fail[grove_sewn/shape] span "Missing get body."
    | ./ok (grove_sewn/shape from to trees)
  + analyze
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span body=list[grove/statement]
    ^ either[grove/error grove_sewn/shape]
    % rest=list[grove/statement] body
      source=maybe[grove_sewn/endpoint] .none
      target=maybe[grove_sewn/endpoint] .none
      code=maybe[row[rex]] .none
    ^ either[grove/error grove_sewn/shape]
    ? (eq rest.len 0) (grove_sewn/finish span source target code)
    ? rest.at(0)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/sewn)) ||
         (equal kind (grove/tag_kind/slot)))
        | _ rest.drop(1) source target code
      | grove_roles/fail[grove_sewn/shape] at "Incompatible sewn tag."
     > (grove/comment at text) (_ rest.drop(1) source target code)
     > (grove/directive at kind tree)
      ? (equal kind (grove/directive_kind/from))
        ? source
         > (./some old)
          | grove_roles/fail[grove_sewn/shape] at "Duplicate #from."
         > .none
          < endpoint (grove_sewn/resolve root doc lookup tree)
          | _ rest.drop(1) (./some endpoint) target code
      ? (equal kind (grove/directive_kind/to))
        ? target
         > (./some old)
          | grove_roles/fail[grove_sewn/shape] at "Duplicate #to."
         > .none
          < endpoint (grove_sewn/resolve root doc lookup tree)
          | _ rest.drop(1) source (./some endpoint) code
      | grove_roles/fail[grove_sewn/shape] at
        "Only #from and #to are supported on sewn declarations."
     > (grove/block at kind kids)
      ? (equal kind (grove/block_kind/meta))
        | _ rest.drop(1) source target code
      ? !(equal kind (grove/block_kind/get))
        | grove_roles/fail[grove_sewn/shape] at
          "Unsupported sewn block."
      ? code
       > (./some old)
        | grove_roles/fail[grove_sewn/shape] at "Duplicate get body."
       > .none
        < trees (grove_sewn/implementation at kids)
        | _ rest.drop(1) source target (./some trees)
    | grove_roles/fail[grove_sewn/shape] span
      "Sewn declarations use #from, #to, metadata, and a get body."
  + code
    \ span=rex/source_span name=str shape=grove_sewn/shape
    ^ row[rex]
    = pairs=row[[str rex]]
        [["SELF" (rex/path [name])]
         ["FROM" shape.source.reference] ["TO" shape.target.reference]]
      run
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " tree=axal[myth]"])
             "^ axal[myth]" "| SELF/get tree"]) pairs
      apply
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " tree=axal[myth]"])
             "^ maybe[axal[myth]]" "< input (FROM/check tree)"
             "| TO/check (SELF/run input)"]) pairs
      view
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92)
                " args=myth tree=axal[myth]"])
             "^ axal[myth]" "? (SELF/apply tree)"
             " > (./some output) output"
             " > .none"
             "  ; (error (pails/p ['grove 'sewn_norm_failed]))"
             "  (axal/new[myth] .none)"]) pairs
      overlay
        | grove_roles/template span
          "(spun SELF/view .none)" pairs
      schema_value
        | rex/paren [(rex/word "grove_sewn_schema")
          (grove_roles/path_value shape.source.path)
          (grove_roles/path_value shape.target.path)
          (grove_roles/member ["schema"] shape.source.reference)
          (grove_roles/member ["schema"] shape.target.reference)]
      schema
        | grove_roles/template span
          (str/join (str/from_atom 10) ["^ grove_sewn_schema" "| VALUE"])
          [["VALUE" schema_value]]
    [(grove_roles/decl "get" (rex/group shape.code))
     (grove_roles/decl "run" run)
     (grove_roles/decl "apply" apply)
     (grove_roles/decl "schema" schema)
     (grove_roles/decl "view" view)
     (grove_roles/decl "overlay" overlay)]
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out.reverse))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0))
    ? !(grove_sewn/is_sewn body)
      | _ rest.drop(1) out.cons(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Sewn needs a name."
    < shape (grove_sewn/analyze root doc lookup span body)
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/path [text]))
      prop=grove/statement
        | grove/property span (rex/cord (path_show system_vocabulary/grove/sewn)) schema
      weft=grove/statement
        | grove/property span (rex/cord "/sys/weft")
          (grove_roles/member ["overlay"] (rex/path [text]))
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) ((list/one weft).cons(prop))
      trees (grove_sewn/code span text shape)
      code=grove/statement
        | grove/implementation span
          trees.map((grove_actions/located span))
    | _ rest.drop(1)
      out.cons((grove/declaration span name kept.snoc(meta).snoc(code)))
  + prepare_all
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < doc (grove_sewn/prepare root doc lookup)
    | grove_norms/prepare_all root doc lookup

' --- grove_trees ---

' Tree values share the declarations' compiler unit.
+ grove_trees
  + marker
    ^ path
    system_vocabulary/grove/seed
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove/error a]
    | grove_roles/fail[a] span message
  + parse_path
    \ span=rex/source_span text=str
    ^ either[grove/error path]
    ? (eq text "/") (./ok [])
    = parts (str/split_byte 47 text)
    ? ((lt parts.len 2) || !(eq parts.at(0) ""))
      | grove_trees/fail[path] span "Expected an absolute tree path."
    ? (row/any[str] (\ part=str (eq part "")) parts.drop(1))
      | grove_trees/fail[path] span "Empty tree path segment."
    = relative (\ part=str ((eq part ".") || (eq part "..")))
    ? (row/any[str] relative parts.drop(1))
      | grove_trees/fail[path] span
          "Relative tree segments are invalid."
    > (./some path) (path_parse text)
      | grove_trees/fail[path] span "Invalid tree path segment."
    | ./ok path
  + reference
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      tree=rex
    ^ either[grove/error path]
    < parts (grove_roles/parts (rex/normalize tree))
    ? !(eq parts.len 1)
      | grove_trees/fail[path] tree.span "Expected declaration name."
    = name (str/from_atom (quip_val parts.at(0)))
    % rest=list[grove/item] doc.items
    ^ either[grove/error path]
    ? (eq rest.len 0)
      | grove_trees/fail[path] tree.span "Unknown declaration."
    ? rest.at(0)
     > (grove/declaration span nam body)
      ? nam
       > (grove/name/identifier text)
        ? !(eq name text) (_ rest.drop(1))
        ? !(grove_sewn/is_sewn body)
          | grove_trees/fail[path] tree.span
            "weft requires a sewn declaration."
        | ./ok root.weld(parts)
      | _ rest.drop(1)
     > (grove/import_decl span alias target)
      ? !(eq alias name) (_ rest.drop(1))
      < path (grove_roles/parts (rex/normalize target))
      > (./some card) (lookup path)
        | grove_trees/fail[path] tree.span "Missing sewn import."
      > (./some held) card.get(system_vocabulary/grove/sewn)
        | grove_trees/fail[path] tree.span "Imported weft is not sewn."
      > schema=grove_sewn_schema held
        | grove_trees/fail[path] tree.span "Invalid sewn schema."
      | ./ok path
    | _ rest.drop(1)
  + value
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      slot=path value=rex
    ^ either[grove/error rex]
    ? (equal[path] slot system_vocabulary/weft)
      < target (grove_trees/reference root doc lookup value)
      | ./ok (rex/paren [(rex/word "safe") (rex/word "1")
          (rex/rune "." [(rex/word "x")])
          (grove_roles/path_value target)])
    ? (equal[path] slot system_vocabulary/tack)
      > (./leaf span shape text) value
        | grove_trees/fail[rex] value.span "Expected a y-care tack."
      = parts (str/split_byte 47 text)
      ? ((lt parts.len 3) || !(eq parts.at(0) "'@") ||
          !(eq parts.at(1) "y") || !(eq parts.at(2) "%"))
        | grove_trees/fail[rex] span "Expected '@/y/%/path tack."
      < relative
        | grove_trees/parse_path span
          (str/join "/" parts.drop(3).cons((str/from_atom 0)))
      | ./ok (rex/paren [(rex/word "grove_instance_ref")
          (rex/rune "." [(rex/word "y")])
          (grove_roles/path_value relative)])
    > (./leaf span shape text) value
      | ./ok value
    ? (equal value.leaf_kind (maybe/some[str] "quip"))
      > (./some parts) (path_parse (str/cat_all ["/" text.slice(1 (dec text.len))])) (./ok value)
      ? !(eq parts.len 1) (./ok value)
      = aura (str/from_atom (aura_tag parts.at(0)))
      ? !((equal aura "dm") || (equal aura "ds") || (equal aura "dr")) (./ok value)
      | ./ok (rex/paren [(rex/path ["pails" aura]) value])
    ? !(equal value.leaf_kind (maybe/some[str] "word"))
      | ./ok value
    ? (nat/parse text)
     > (./some number)
      | ./ok (rex/paren [(rex/path ["pails" "n"]) value])
     > .none (./ok value)
  + has_property
    \ name=str props=list[grove/statement]
    ^ bool
    | props.any
    \ stmt
    ? stmt
     > (grove/property span key value)
      ? key
       > (./leaf at shape text) (eq name text)
      .false
    .false
  + body
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span path=path body=list[grove/statement]
    ^ either[grove/error list[grove/statement]]
    % rest=list[grove/statement] body props=list[grove/statement] .nil
      rule=maybe[rex] .none tagged=bool .false
    ^ either[grove/error list[grove/statement]]
    ? (eq rest.len 0)
      ? !tagged
        | grove_trees/fail[list[grove/statement]] span
          "Tree paths require @tree."
      = weft (grove_trees/has_property "/sys/weft" props)
        tack (grove_trees/has_property "/sys/tack" props)
      ? !(eq weft tack)
        | grove_trees/fail[list[grove/statement]] span
          "A view needs both weft and tack."
      = norm
          ? rule
           > (./some value)
            | rex/paren [(rex/path ["maybe" "some"]) value]
           > .none (rex/rune "." [(rex/word "none")])
        seed
          | rex/paren [(rex/word "grove_tree_seed")
              (grove_roles/path_value path) norm]
        mark=grove/statement
          | grove/property span (rex/cord (path_show system_vocabulary/grove/seed)) seed
      | ./ok (list/one (grove/block span (grove/block_kind/meta)
          props.snoc(mark)))
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) props rule tagged)
     > (grove/tag at kind)
      ? !(equal kind (grove/tag_kind/tree))
        | grove_trees/fail[list[grove/statement]] at
          "Only @tree is valid on a tree path."
      | _ rest.drop(1) props rule .true
     > (grove/property at key val)
      < slot (grove_roles/slot root doc lookup key)
      ? ((equal[path] slot grove_trees/marker) ||
         (equal[path] slot system_vocabulary/grove/module) ||
         (equal[path] slot system_vocabulary/grove/like) ||
         (equal[path] slot system_vocabulary/grove/template) ||
         (equal[path] slot system_vocabulary/grove/source) ||
         (equal[path] slot system_vocabulary/spec) ||
         (equal[path] slot system_vocabulary/limb) ||
         (equal[path] slot system_vocabulary/lash))
        | grove_trees/fail[list[grove/statement]] at
          "Tree property collides with installation metadata."
      < value (grove_trees/value root doc lookup slot val)
      = prop=grove/statement
          | grove/property at (rex/cord (path_show slot))
              value.with_span(val.span)
      | _ rest.drop(1) props.snoc(prop) rule tagged
     > (grove/directive at kind target)
      ? !(equal kind (grove/directive_kind/like))
        | grove_trees/fail[list[grove/statement]] at
          "Only #like is valid on tree declarations."
      ? rule
       > (./some old)
        | grove_trees/fail[list[grove/statement]] at "Duplicate #like."
       > .none
        < norm (grove_sewn/resolve root doc lookup target)
        = value
            | rex/paren [(rex/word "grove_tree_rule")
              (grove_roles/path_value norm.path)
              (grove_roles/member ["validate"] norm.reference)
              (grove_roles/member ["spec"] norm.reference)]
        | _ rest.drop(1) props (./some value) tagged
    | grove_trees/fail[list[grove/statement]] span
      "Tree bodies contain properties, comments, and #like."
  + check_metadata
    \ root=path doc=grove/document lookup={\ path}maybe[myth] body=list[grove/statement]
    ^ either[grove/error unit]
    ? (eq body.len 0) (./ok [])
    ? body.at(0)
     > (grove/block span kind props)
      ? (equal kind (grove/block_kind/meta))
        < checked (grove_trees/check_properties root doc lookup props)
        | grove_trees/check_metadata root doc lookup body.drop(1)
      | grove_trees/check_metadata root doc lookup body.drop(1)
    | grove_trees/check_metadata root doc lookup body.drop(1)
  + check_properties
    \ root=path doc=grove/document lookup={\ path}maybe[myth] props=list[grove/statement]
    ^ either[grove/error unit]
    ? (eq props.len 0) (./ok [])
    ? props.at(0)
     > (grove/property span key value)
      < slot (grove_roles/slot root doc lookup key)
      ? (equal slot grove_trees/marker)
        | grove_trees/fail[unit] span
          "Metadata collides with the reserved tree marker."
      | grove_trees/check_properties root doc lookup props.drop(1)
    | grove_trees/check_properties root doc lookup props.drop(1)
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=list[grove/item] doc.items out=list[grove/item] .nil
      count=nat 0
    ^ either[grove/error grove/document]
    ? (eq rest.len 0)
      | grove_sewn/prepare_all root (grove/document out.reverse) lookup
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.cons(rest.at(0)) count
    < checked (grove_trees/check_metadata root doc lookup body)
    > (grove/name/tree_path text) name
      | _ rest.drop(1) out.cons(rest.at(0)) count
    < path (grove_trees/parse_path span text)
    < next (grove_trees/body root doc lookup span path body)
    = name (str/join "" ["grove_tree_" (nat/show count)])
    | _ rest.drop(1)
      out.cons((grove/declaration span
        (grove/name/identifier name) next)) count.inc

' --- grove_backend ---

'  Grove owns validation, linking names, and publication geography.
'  The host compiles a generated unit over native subject artifacts.
+ grove_backend
  + diagnostic
    : span=rex/source_span message=str cause=maybe[any]
  + dependency
    : span=rex/source_span alias=str module=grove_backend/bundle
  + request
    : identity=path tree=rex imports=row[grove_backend/dependency]
      metadata=row[path] records=row[path]
  + compiled
    : entries=mop[path grove_backend/entry lt_pith]
      metadata=row[pail] artifact=any
      definitions=row[[path nat type]]
  + ports
    : lookup={\ path}maybe[myth]
      compile={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
  + definition
    : span=rex/source_span name=str code=row[rex]
      metadata=list[grove/property]
  + index
    : definitions=list[grove_backend/definition]
      imports=list[grove/import_decl]
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove_backend/diagnostic a]
    | ./err (grove_backend/diagnostic span message .none)
  + name_ok
    \ name=str
    ^ bool
    ? (eq name "") .false
    ? (eq name "boot") .false
    ? (eq name "grove_metadata") .false
    | eq (str/split_byte 47 name).len 1
  + statement_span
    \ statement=grove/statement
    ^ rex/source_span
    ? statement
     > (grove/tag span kind) span
     > (grove/property span slot value) span
     > (grove/directive span kind target) span
     > (grove/block span kind body) span
     > (grove/implementation span code) span
     > (grove/presentation span code) span
     > (grove/comment span text) span
  + metadata
    \ body=list[grove/statement]
    ^ either[grove_backend/diagnostic list[grove/property]]
    ? (eq body.len 0) (./ok .nil)
    < tail (grove_backend/metadata body.drop(1))
    ? body.at(0)
     > (grove/property span slot value)
      | ./ok tail.cons((grove/property span slot value))
     > (grove/comment span text) (./ok tail)
    | grove_backend/fail[list[grove/property]]
      (grove_backend/statement_span body.at(0))
      "Metadata blocks contain properties and comments only."
  + body
    \ span=rex/source_span name=str body=list[grove/statement]
    ^ either[grove_backend/diagnostic grove_backend/definition]
    % rest=list[grove/statement] body code=row[rex] []
      props=list[grove/property] .nil
    ^ either[grove_backend/diagnostic grove_backend/definition]
    ? (eq rest.len 0)
      | ./ok (grove_backend/definition span name code props)
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) code props)
     > (grove/tag at kind)
      ? kind
       > .type (_ rest.drop(1) code props)
       > .slot (_ rest.drop(1) code props)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis tag."
     > (grove/presentation at trees)
      | grove_backend/fail[grove_backend/definition] at
        "Goo views must be compiled through grove_views."
     > (grove/implementation at trees)
      ? code.len
        | grove_backend/fail[grove_backend/definition] at
          "Duplicate implementation."
      | _ rest.drop(1) trees props
     > (grove/block at kind statements)
      ? kind
       > .meta
        < more (grove_backend/metadata statements)
        | _ rest.drop(1) code props.weld(more)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis block."
     > (grove/directive at kind target)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis directive."
     > (grove/property at slot value)
      | grove_backend/fail[grove_backend/definition] at
        "Properties must be inside #meta in this backend batch."
  + index_document
    \ doc=grove/document
    ^ either[grove_backend/diagnostic grove_backend/index]
    % rest=list[grove/item] doc.items names=list[str] .nil
      defs=list[grove_backend/definition] .nil
      imports=list[grove/import_decl] .nil
    ^ either[grove_backend/diagnostic grove_backend/index]
    ? (eq rest.len 0) (./ok (grove_backend/index defs.reverse imports.reverse))
    ? rest.at(0)
     > (grove/comment span text) (_ rest.drop(1) names defs imports)
     > (grove/import_decl span alias target)
      ? (names.has(alias))
        | grove_backend/fail[grove_backend/index] span
          "Duplicate or conflicting import alias."
      ? !(grove_backend/name_ok alias)
        | grove_backend/fail[grove_backend/index] span
          "Invalid import alias."
      | _ rest.drop(1) names.cons(alias) defs
        imports.cons((grove/import_decl span alias target))
     > (grove/declaration span name statements)
      > (grove/name/identifier text) name
        | grove_backend/fail[grove_backend/index] span
          "Tree installation synthesis is unsupported."
      ? (names.has(text))
        | grove_backend/fail[grove_backend/index] span
          "Duplicate or conflicting declaration name."
      ? !(grove_backend/name_ok text)
        | grove_backend/fail[grove_backend/index] span
          "Invalid declaration name."
      < def (grove_backend/body span text statements)
      | _ rest.drop(1) names.cons(text) defs.cons(def) imports
  + namespace_path
    \ tree=rex
    ^ either[grove_backend/diagnostic path]
    ? !(equal tree.leaf_kind (maybe/some[str] "cord"))
      | grove_backend/path_parts (rex/normalize tree)
    ? tree
     > (./leaf span shape text)
      ? !(equal tree.leaf_kind (maybe/some[str] "cord"))
        | grove_backend/fail[path] span
          "Expected an absolute namespace path cord."
      > (./some parts) (path_parse text)
        | grove_backend/fail[path] span
          "Invalid absolute namespace path."
      | ./ok parts
    | grove_backend/fail[path] tree.span
      "Expected an absolute namespace path cord."
  + path_parts
    \ tree=rex
    ^ either[grove_backend/diagnostic path]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "word"))
        > (./some parts) (path_parse (str/join "" ["/" text]))
          | grove_backend/fail[path] span "Invalid namespace segment."
        ? (eq parts.len 1) (./ok parts)
        | grove_backend/fail[path] span "Expected one namespace segment."
      | grove_backend/fail[path] span "Expected a namespace path."
     > (./nest span color rune kids)
      ? !(eq rune "/")
        | grove_backend/fail[path] span "Expected a namespace path."
      % rest=row[rex] kids parts=path []
      ^ either[grove_backend/diagnostic path]
      ? (eq rest.len 0)
        ? parts.len (./ok parts)
        | grove_backend/fail[path] span "Empty namespace path."
      < next (grove_backend/path_parts rest.at(0))
      | _ rest.drop(1) parts.weld(next)
    | grove_backend/fail[path] tree.span "Expected a namespace path."
  + resolve_slot
    \ lookup={\ path}maybe[myth] imports=list[grove/import_decl] tree=rex
    ^ either[grove_backend/diagnostic path]
    < path (grove_backend/namespace_path tree)
    ? (equal tree.leaf_kind (maybe/some[str] "cord")) (./ok path)
    % rest=list[grove/import_decl] imports
    ^ either[grove_backend/diagnostic path]
    ? (eq rest.len 0) (./ok path)
    = imp rest.at(0)
    ? (equal path.at(0) ($ts imp.alias))
      < target (grove_backend/namespace_path imp.target)
      | ./ok (grove_roles/import_location target lookup).weld(path.drop(1))
    | _ rest.drop(1)
  + imported_module
    \ span=rex/source_span target=path card=myth
    ^ either[grove_backend/diagnostic grove_backend/bundle]
    ' A namespace alias needs no compiler artifact. It exports no code.
    > (./some slot) card.get(grove_backend/module_slot)
      | ./ok (grove_backend/bundle grove_backend/version
          target [] (mop/empty) 0)
    > module=grove_backend/bundle slot
      | grove_backend/fail[grove_backend/bundle] span
        "Invalid Grove module bundle."
    ? !(eq module.version grove_backend/version)
      | grove_backend/fail[grove_backend/bundle] span
        "Incompatible Grove bundle; rebuild definitions."
    ? (equal[any] module.artifact 0)
      ? module.exports.size
        | grove_backend/fail[grove_backend/bundle] span
          "Code imports require a published compiler artifact; rebuild definitions."
      | ./ok module
    | ./ok module
  + resolve
    \ ports=grove_backend/ports imports=list[grove/import_decl]
    ^ either[grove_backend/diagnostic row[grove_backend/dependency]]
    ? (eq imports.len 0) (./ok [])
    = imp imports.at(0)
    < target (grove_backend/namespace_path imp.target)
    > (./some card) (ports.lookup target)
      | grove_backend/fail[row[grove_backend/dependency]] imp.span
        "Missing imported declaration."
    < module (grove_backend/imported_module imp.span target card)
    < tail (grove_backend/resolve ports imports.drop(1))
    | ./ok tail.cons(
        (grove_backend/dependency imp.span imp.alias module))
  + meta_key
    \ name=str index=nat
    ^ path
    = suffix (str/join "" ["v" (nat/show index)])
    [($ts "grove_metadata") ($ts name) ($ts suffix)]
  + rewrite
    '  Grove's ;/member resolves in this declaration; ;/decl/member
    '  resolves in the shared document. Ordinary Foil paths also work.
    \ names=row[str] current=str tree=rex
    ^ rex
    > (./nest span color rune kids) tree
      tree
    ? (eq rune "=;/")
      ? (lt kids.len 2) tree
      = target
          | grove_backend/rewrite names current
            (rex/rune ";/" kids.drop(1)).with_span(span)
      | rex/nest span color "=" [kids.at(0) target]
    ? (eq rune "/")
      = flat (row/bind[rex rex] grove_backend/path_children kids)
      | rex/nest span color "/" flat
    ? !(eq rune ";/") tree
    ? (eq kids.len 0) tree
    > (./leaf loc shape text) kids.at(0)
      tree
    ? names.has(text)
      ? (eq color "clear") (rex/group kids).with_span(span)
      | rex/nest span color "" kids
    | rex/nest span color "/" kids.cons((rex/word current))
  + path_children
    \ tree=rex
    ^ row[rex]
    ? tree
     > (./nest span color rune kids)
      ? (eq rune "/") kids
      [tree]
    [tree]
  + check_code
    '  Canonical compiler paths and native source imports bypass the
    '  export boundary. Grove code must use its declared aliases.
    \ tree=rex
    ^ either[grove_backend/diagnostic rex]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "word"))
        ? (eq text "boot")
          | grove_backend/fail[rex] span
            "Internal compiler paths are not Grove references."
        (./ok tree)
      (./ok tree)
     > (./nest span color rune kids)
      ? (eq rune "-")
        | grove_backend/fail[rex] span
          "Use Grove imports, not embedded Foil module imports."
      | grove_backend/check_children tree
    | grove_backend/check_children tree
  + check_children
    \ tree=rex
    ^ either[grove_backend/diagnostic rex]
    % rest=row[rex] tree.children
    ^ either[grove_backend/diagnostic rex]
    ? (eq rest.len 0) (./ok tree)
    < checked (grove_backend/check_code rest.at(0))
    | _ rest.drop(1)
  + metadata_value
    \ value=rex
    ^ rex
    ? (equal value.leaf_kind (maybe/some[str] "cord"))
      | rex/with_span value.span
        (rex/rune "|" [(rex/path ["pails" "t"]) value])
    | rex/with_span value.span
      (rex/rune "^" [(rex/word "pail") value])
  + declaration_tree
    \ span=rex/source_span path=path value=rex
    ^ rex
    ? (eq path.len 0) value
    = name (str/from_atom (quip_val path.at(0)))
      body (grove_backend/declaration_tree span path.drop(1) value)
    | rex/with_span span
      (rex/rune "+" [(rex/word name).with_span(span) body])
  + generate
    \ index=grove_backend/index
    ^ either[grove_backend/diagnostic rex]
    = locals index.definitions.map((\ def def.name))
      aliases index.imports.map((\ imp imp.alias))
      names locals.weld(aliases).row
    % rest=list[grove_backend/definition] index.definitions
      forms=row[rex] []
    ^ either[grove_backend/diagnostic rex]
    ? (eq rest.len 0)
      = span=rex/source_span
          ? index.definitions.len index.definitions.at(0).span
          rex/zero_span
      | ./ok (rex/group forms).with_span(span)
    = def rest.at(0)
      code (rex/normalize (rex/heir def.span def.code))
    < checked (grove_backend/check_code code)
    = rewrite={\ rex}rex
        \ node
        | grove_backend/rewrite names def.name node
      rewritten (rex/walk rewrite code)
      scope
        | rex/with_span def.span
          (rex/rune "+" [(rex/word def.name) rewritten])
      metas
        | (list/range 0 def.metadata.len).map
        \ i
        = prop def.metadata.at(i)
        = value | rex/normalize prop.value
        = body
            | grove_backend/metadata_value
              (rex/walk rewrite value)
        | grove_backend/declaration_tree prop.span
          (grove_backend/meta_key def.name i) body
      added=row[rex] (? def.code.len [scope] [])
    < checked_meta (grove_backend/check_code (rex/group metas.row))
    | _ rest.drop(1) forms.weld(added).weld(metas.row)
  + slots
    \ lookup={\ path}maybe[myth] imports=list[grove/import_decl]
      defs=list[grove_backend/definition]
    ^ either[grove_backend/diagnostic list[list[path]]]
    ? (eq defs.len 0) (./ok .nil)
    = def defs.at(0)
    < head (grove_backend/property_slots lookup imports def.metadata .nil)
    < tail (grove_backend/slots lookup imports defs.drop(1))
    | ./ok tail.cons(head)
  + property_slots
    \ lookup={\ path}maybe[myth] imports=list[grove/import_decl]
      props=list[grove/property] seen=list[path]
    ^ either[grove_backend/diagnostic list[path]]
    ? (eq props.len 0) (./ok seen)
    = prop props.at(0)
    < slot (grove_backend/resolve_slot lookup imports prop.slot)
    = reserved=row[path]
        [grove_backend/module_slot grove_templates/slot
         grove_templates/source_slot system_vocabulary/grove/view]
    ? (reserved.has(slot))
      | grove_backend/fail[list[path]] prop.span
        "Metadata collides with a reserved Grove slot."
    ? (seen.has(slot))
      | grove_backend/fail[list[path]] prop.span
        "Conflicting metadata assignments."
    | grove_backend/property_slots lookup imports props.drop(1) seen.snoc(slot)
  + export_index
    ' Build once per compiled unit; each declaration reads its own subtree.
    \ entries=mop[path grove_backend/entry lt_pith]
    ^ axal[grove_backend/entry]
    | entries.tap.fold (axal/new[grove_backend/entry] .none)
      \ out [key value]
      | out.put key value
  + exports_at
    ' Include the prefix itself as [], with descendant keys relative to it.
    \ index=axal[grove_backend/entry] prefix=path
    ^ mop[path grove_backend/entry lt_pith]
    | index.dip(prefix).tap.fold (mop/empty)
      \ out [key value]
      | out.put key value
  + publish
    \ root=path identity=path defs=list[grove_backend/definition]
      slots=list[list[path]] result=grove_backend/compiled
      export_index=axal[grove_backend/entry]
    ^ row[[path myth]]
    % rest=list[grove_backend/definition] defs position=nat 0
      offset=nat 0 output=row[[path myth]] []
    ^ row[[path myth]]
    ? (eq rest.len 0) output
    = def rest.at(0)
      prefix=path [($ts def.name)]
      exports (grove_backend/exports_at export_index prefix)
      module
        | grove_backend/bundle grove_backend/version
          identity prefix exports result.artifact
      keys slots.at(position)
      card=row[[path pail]]
        | (row/range 0 keys.len).map
        \ i
        [keys.at(i) result.metadata.at((add offset i))]
      myth=myth
        | card.fold (mop/empty)
        \ out [key value]
        | out.put key value
      myth myth.put(grove_backend/module_slot module)
    | _ rest.drop(1) position.inc (add offset keys.len)
      output.snoc([root.weld(prefix) myth])
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove_backend/diagnostic grove/document]
    ? (grove_trees/prepare root doc lookup)
     > (./ok doc) (./ok doc)
     > (./err cause)
      ? cause
       > (grove/error/syntax span message)
        | grove_backend/fail[grove/document] span message
       > (grove/error/parser cause)
        | ./err (grove_backend/diagnostic rex/zero_span
            "Grove synthesis failed." (./some cause))
  + view_names
    \ doc=grove/document
    ^ list[path]
    | doc.items.bind
    \ item
    ^ list[path]
    > (grove/declaration span name body) item .nil
    ? !(grove_views/is_goo body) .nil
    > (grove/name/identifier name) name .nil
    | list/one[path] [($ts name)]
  + prepare_views
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove_backend/diagnostic grove/document]
    ? (grove_view_publication/stubs root doc lookup)
     > (./ok doc) (./ok doc)
     > (./err cause)
      ? cause
       > (grove/error/syntax span message)
        | grove_backend/fail[grove/document] span message
       > (grove/error/parser cause)
        | ./err (grove_backend/diagnostic rex/zero_span
            "Invalid view interaction bindings." (./some cause))
  + compile
    \ root=path doc=grove/document ports=grove_backend/ports
    ^ either[grove_backend/diagnostic row[[path myth]]]
    = original doc
    < plain (grove_backend/prepare_views root doc ports.lookup)
    < doc (grove_backend/prepare root plain ports.lookup)
    < index (grove_backend/index_document doc)
    < slots (grove_backend/slots ports.lookup index.imports index.definitions)
    < imports (grove_backend/resolve ports index.imports)
    < tree (grove_backend/generate index)
    = identity root
      metas
        | index.definitions.bind
        \ def
        | (list/range 0 def.metadata.len).map
        \ i
        | grove_backend/meta_key def.name i
    = names=list[path]
        | index.definitions.map (\ def [($ts def.name)])
      request
        | grove_backend/request identity tree imports metas.row names.weld((grove_backend/view_names original)).cons([]).row
    < result (ports.compile request)
    ? !(eq result.metadata.len metas.len)
      | grove_backend/fail[row[[path myth]]] rex/zero_span
        "Compiler returned an invalid metadata count."
    = export_index (grove_backend/export_index result.entries)
      records (grove_backend/publish root identity
        index.definitions slots result export_index)
    < records (grove_backend/publication_records root index.definitions records)
    = records (grove_backend/definition_records root result export_index records)
      lookup
        \ name=path
        ^ maybe[myth]
        = matches (records.keep((\ [key value] (equal key name))))
        ? matches.len
          = [key value] matches.at(0)
          | ./some value
        = get ports.lookup
        | get name
    ? (grove_view_publication/records root original lookup)
     > (./ok views)
      = declared=list[path] index.definitions.map((\ def root.snoc(($ts def.name))))
        imported=list[path] index.imports.map((\ imp root.snoc(($ts imp.alias))))
        reserved=list[path] declared.keep((\ name !((grove_backend/view_names original).any((\ relative (equal name root.weld(relative))))))).weld(imported)
        view_names=list[path] views.stream.map((\ [name card] name))
      ? (view_names.any((\ name reserved.has(name))))
        | grove_backend/fail[row[[path myth]]] rex/zero_span "View name conflicts with a declaration."
      = published=row[[path myth]]
          | views.map
          \ [name card]
          = base (lookup name).fall(myth/new)
          [name base.meld(card)]
        ordinary=row[[path myth]] (records.keep((\ [name card] !(view_names.has(name)))))
      | ./ok ordinary.weld(published)
     > (./err cause)
      ? cause
       > (grove/error/syntax span message)
        | grove_backend/fail[row[[path myth]]] span message
       > (grove/error/parser cause)
        | ./err (grove_backend/diagnostic rex/zero_span "View publication failed." (./some cause))
  + compiled_from
    \ entries=row[[path grove_backend/entry]] metadata=row[pail]
      artifact=any definitions=row[[path nat type]]
    ^ grove_backend/compiled
    = table=mop[path grove_backend/entry lt_pith]
        | entries.fold (mop/empty)
        \ out [key value]
        | out.put key value
    | grove_backend/compiled table metadata artifact definitions
  + definition_records
    ' Every assigned definition, including nested nominal members, is
    ' navigable and carries its canonical descriptor and compiler artifact.
    \ root=path result=grove_backend/compiled
      export_index=axal[grove_backend/entry] records=row[[path myth]]
    ^ row[[path myth]]
    = table=axal[myth]
        | records.fold (axal/new[myth] .none)
          \ out [name card]
          | out.put name card
    = published
        | result.definitions.fold table
          \ out [relative prior description]
          = name | root.weld relative
            card
              ? out.dip(name).fil
               > (./some card) card
              myth/new
            exports (grove_backend/exports_at export_index relative)
            module
              | grove_backend/bundle grove_backend/version root
                  relative exports result.artifact
            card | card.put system_vocabulary/mold (pails/ty description)
          | out.put name card.put(grove_backend/module_slot module)
    | published.tap
  + bindings
    \ dep=grove_backend/dependency
    ^ row[[path path]]
    | dep.module.exports.tap.map
    \ [name entry]
    [name.cons(($ts dep.alias)) entry.key]

  + publication_records
    ' Publish declarations and one reusable template, never instance data.
    \ root=path defs=list[grove_backend/definition]
      records=row[[path myth]]
    ^ either[grove_backend/diagnostic row[[path myth]]]
    % i=nat 0 out=row[[path myth]] [] seeds=row[[path myth]] []
      rules=row[[rex/source_span path grove_tree_rule]] []
    ^ either[grove_backend/diagnostic row[[path myth]]]
    ? (eq i records.len)
      < checked (grove_backend/check_seeds seeds rules)
      ? (eq seeds.len 0) (./ok out)
      = template (grove_template grove_templates/version
          (grove_backend/armor root.at(0) seeds rules))
        card (myth/sing grove_templates/slot template)
      | ./ok out.snoc([root card])
    = [path card] records.at(i)
      span defs.at(i).span
    ? card.get(grove_trees/marker)
     > (./some held)
      > seed=grove_tree_seed held
        | grove_backend/fail[row[[path myth]]] span
          "Invalid tree template marker."
      = path seed.path
        card card.del(grove_trees/marker)
        card card.del(grove_backend/module_slot)
      ? (seeds.any((\ [key val] (equal key path))))
        | grove_backend/fail[row[[path myth]]] span
          "Conflicting instance paths."
      = next
          ? seed.rule
           > (./some rule) rules.snoc([span path rule])
           > .none rules
      | _ i.inc out seeds.snoc([path card]) next
     > .none
      ? (out.any((\ [key val] (equal key path))))
        | grove_backend/fail[row[[path myth]]] span
          "Conflicting publication paths."
      | _ i.inc out.snoc([path card]) seeds rules
  + overlap
    \ base=path entry=[rex/source_span path grove_tree_rule]
    ^ bool
    = [at other norm] entry
    ? (equal other.take(base.len) base) .true
    | equal base.take(other.len) other
  + check_seeds
    \ seeds=row[[path myth]]
      rules=row[[rex/source_span path grove_tree_rule]]
    ^ either[grove_backend/diagnostic unit]
    ? (eq rules.len 0) (./ok [])
    = [span base rule] rules.at(0)
      overlap
        | row/any[[rex/source_span path grove_tree_rule]]
          (grove_backend/overlap base) rules.drop(1)
    ? overlap
      | grove_backend/fail[unit] span
        "Overlapping #like installations require norm composition."
    = subtree=axal[myth]
        | seeds.fold (axal/new[myth] .none)
        \ tree [path card]
        ? (equal path.take(base.len) base)
          | tree.put path.drop(base.len) card
        tree
    ? (rule.validate subtree)
     > (./some bad)
      | grove_backend/fail[unit] span
        (str/join "" ["Tree seed violates #like at "
          (path_show base.weld(bad))])
     > .none (grove_backend/check_seeds seeds rules.drop(1))
  + with_behavior
    \ reference=path card=myth
    ^ myth
    = refs=row[path]
        > (./some held) card.get(limb_slot) []
        > existing=kook held []
        existing.refs
    ? refs.has(reference) card
    | card.put limb_slot (kook refs.snoc(reference))
  + armor
    \ publisher=iota records=row[[path myth]]
      rules=row[[rex/source_span path grove_tree_rule]]
    ^ row[[path myth]]
    | records.map
    \ [path card]
    = card
        | rules.fold card
        \ card [span base rule]
        ? !(equal path.take(base.len) base) card
        = relative path.drop(base.len)
        = card
            ? (soma/at relative rule.spec)
             > (./some contract)
              | card.put system_vocabulary/lash contract
             > .none card
        ? !(equal path base) card
        = spec (yoke lash/new rule.spec.kids
            (axal/new[fief] .none))
        = card card.put(system_vocabulary/spec spec)
        = card card.put(system_vocabulary/grove/like (pails/p rule.source))
        | grove_backend/with_behavior [publisher 'kook 'ward] card
    = card
        ? card.get(system_vocabulary/tack)
         > (./some held)
          ? held
           > link=grove_instance_ref
            | grove_backend/with_behavior [publisher 'kook 'fresh] card
          card
        card
    [path card]

  + artifact_of
    \ card=myth
    ^ maybe[any]
    > (./some value) card.get(grove_backend/module_slot) .none
    > bundle=grove_backend/bundle value .none
    | ./some bundle.artifact

  + commit
    \ system=pin[row[[path nat]]] expected=row[[path nat]]
      records=row[[path myth]] now=nat block=nat state=namespace
    ^ either[iota namespace/committed]
    = names | expected.map (\ [name prior] name)
    < batch
      | publication_batch/prepare state.self names state.local
    = valid
        | expected.all
          \ [name prior]
          > (./some actual) batch.expected.dip(name).fil .false
          | eq actual prior
    ? !valid (./err 'stale_publication)
    = table
        | records.fold (axal/new[myth] .none)
          \ out [name card]
          | out.put name card
    ? !(eq table.tap.len records.len) (./err 'duplicate_definition)
    | batch.publish_namespace system table now block state

' --- grove_ui_runtime ---

' Typed values and namespace formatting for Grove's rendering declarations.
' The input carrier contains data, not a browser document or an IO capability.
+ grove_html
  weft/node/el
  + read
    \ value=pail
    ^ maybe[grove_html]
    > node=weft/node/el value
      .none
    | ./some node
  + write
    \ value=grove_html
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ weft/node/el)

+ grove_fragment
  + result
    \ node=weft/node/el
    ^ axal[myth]
    | axal/new[myth] (./some ((myth/new).put(['html] node)))
  + render
    ' Call the actual published sewn value; no renderer-name switch/fallback.
    \ component=myth input=myth
    ^ maybe[weft/node/el]
    < held component.get(system_vocabulary/weft)
    > transform=spun held
      .none
    = output (transform.get (myth/new) (axal/new[myth] (./some input)))
    < record output.fil
    < html record.get(['html])
    | grove_html/read html

+ grove_record
  ' An explicit typed carrier, not reflection of a record's printed value.
  : data=myth
  + read
    \ value=pail
    ^ maybe[grove_record]
    > record=grove_record value
      .none
    | ./some record
  + write
    \ value=grove_record
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ grove_record)

' A finite, explicitly selected tree; this is not a namespace read capability.
+ grove_tree
  : data=axal[myth]

' --- grove_app ---

' A captured installed view, not an application-specific renderer registry.
' Capture follows its real weft/tack pins once. Rendering accepts a request-local
' record of named inputs and never writes it into the sovereign.
+ grove_app
  + binding
    : transform=spun input=axal[myth] fields=grove_role_schema declaration=myth authority=path
  + capture
    \ entry=path state=namespace
    ^ maybe[grove_app/binding]
    > (./known installed) (sovereign_view .x 0 entry state)
      .none
    < card installed.fil
    < held card.get(system_vocabulary/weft)
    > renderer=safe held
      .none
    ? !(equal[care] renderer.care .x) .none
    ? (eq renderer.ver 0) .none
    < held card.get(system_vocabulary/tack)
    > source=safe held
      .none
    ? !(equal[care] source.care .y) .none
    ? (eq source.ver 0) .none
    > (./known code) (sovereign_view renderer.care renderer.ver renderer.path state)
      .none
    < component code.fil
    < held component.get(system_vocabulary/weft)
    > transform=spun held
      .none
    < held component.get(system_vocabulary/grove/sewn)
    > boundary=grove_sewn_schema held
      .none
    ' Projection and validation must use the same compiled norm generation.
    ' A legacy sewn value without this metadata fails the cast above; never
    ' recover it by reading a mutable declaration at the endpoint path.
    = schema boundary.source_schema
    ' Named-record HTTP inputs require an own-record norm, not a subtree walk.
    ? schema.segments.len .none
    > (./known input) (sovereign_view source.care source.ver source.path state)
      .none
    = app (grove_app/binding transform input schema.item card [state.self])
    ; (DeepSeq[nat] app 0)
    | ./some app
  + project
    \ fields=grove_role_schema values=myth
    ^ myth
    | fields.fields.fold (myth/new)
    \ out field
    ? values.get([($ts field.name)])
     > (./some value) out.put(field.slot value)
     > .none out
  + render
    \ app=grove_app/binding values=myth
    ^ maybe[weft/node/el]
    = input (grove_app/project app.fields values)
      output (app.transform.get (myth/new) app.input.set_fil((./some input)))
    < record output.fil
    < html record.get(['html])
    | grove_html/read html
  + document
    ' The installed view declares its head assets and title. The HTTP adapter
    ' owns framing only; it does not choose application scripts or stylesheets.
    \ app=grove_app/binding body=weft/node/el
    ^ nat
    | grove_app/document_with_attributes [] app body
  + document_with_attributes
    \ attributes=row[weft/att] app=grove_app/binding body=weft/node/el
    ^ nat
    = title
        > (./some held) app.declaration.get(system_vocabulary/lede) "Application"
        > value=pails/t held
          "Application"
        | str/to_atom value.t
      assets
        > (./some held) app.declaration.get(['head]) []
        > head=weft/node/el held
          []
        head.kids
    | weft/page_with_body_attributes title assets attributes [body]

' --- change_workbench ---

' A target owns publication outputs, not a particular application or language.
' Candidates are immutable branch results. Only receipts under /weft are trusted.
+ change_workbench
  + unit
    : source=path root=path prelude=str
  + export
    : source=path target=path
  + registration
    : control=path units=row[change_workbench/unit] tests=path
      outputs=row[path] adapter=path policy=myth activation=str bootstrap=bool authority=row[path] exports=row[change_workbench/export]
  + activation_plan
    : kind=str outputs=row[path] requirements=row[str]
  + adapter
    : validate={\ change_workbench/registration namespace}either[str unit]
      test={\ change_workbench/registration myth namespace}either[str str]
      activation={\ change_workbench/registration row[path]}either[str change_workbench/activation_plan]
  + compiled
    : state=namespace names=row[path]
  + ports
    : build={\ path str str namespace}either[grove_backend/diagnostic change_workbench/compiled]
  + source
    : path=path version=nat text=str
  + drafts
    : items=row[change_workbench/source]
  + stamp
    : care=care path=path version=maybe[nat]
  + candidate
    : registration=change_workbench/registration sources=row[change_workbench/source] records=row[[path myth]] removed=row[path]
      expected=row[change_workbench/stamp] dependencies=row[change_workbench/stamp]
      system=pin[system_publication] branch=namespace review=str plan=change_workbench/activation_plan
  + run
    : candidate=path cases=maybe[nat] fixtures=row[change_workbench/stamp]
      passed=bool report=str
  + journal
    : sequence=nat candidate=path run=path active=row[path] revision=nat published=path
  + registry
    \ self=iota
    ^ path
    [self 'weft 'change_workbench]
  + key
    \ name=iota
    ^ path
    ['sys 'workbench name]
  + record
    \ path=path state=namespace
    ^ myth
    | (sovereign_care .x path state).fil.fall(myth/new)
  + put
    \ path=path card=myth state=namespace
    ^ namespace
    = command (? (maybe/is_some (sovereign_care .x path state).fil) (writ/poke card) (writ/make card))
    > (./ok next) (grove_install/change path command state) (Seq[namespace] (error (pails/t "Workbench record write failed.")) state)
    next
  + registrations
    \ state=namespace
    ^ row[[path change_workbench/registration]]
    = root (change_workbench/registry state.self)
    | (sovereign_care .y root state).kid_tap.fold []
      \ out=row[[path change_workbench/registration]] [key tree]
      > (./some card) tree.fil out
      > (./some held) card.get((change_workbench/key 'registration)) out
      > registration=change_workbench/registration held out
      | out.snoc [root.snoc(key) registration]
  + protected
    ' Agent admission uses trusted registrations, never a writable marker.
    \ path=path state=namespace
    ^ bool
    | (change_workbench/registrations state).any
      \ [home registration]
      | ((equal path registration.control) || (pith_prefix registration.control.snoc('results) path) || (registration.outputs.any((\ root (pith_prefix root path)))))
  + owner
    \ path=path state=namespace
    ^ maybe[path]
    = matches ((change_workbench/registrations state).keep((\ [home reg] ((equal path reg.control) || (reg.units.any((\ unit (equal path unit.source)))) || (pith_prefix reg.tests path)))))
    ? !(matches.len) .none
    = [home reg] matches.at(0)
    | ./some reg.control
  + stamp_at
    \ care=care path=path state=namespace
    ^ change_workbench/stamp
    | change_workbench/stamp care path (state.case(care path))
  + current
    \ stamps=row[change_workbench/stamp] state=namespace
    ^ bool
    | stamps.all((\ stamp (equal stamp.version (state.case(stamp.care stamp.path)))))
  + drafts_at
    \ home=path state=namespace
    ^ row[change_workbench/source]
    > (./some held) (change_workbench/record home state).get((change_workbench/key 'drafts)) []
    > drafts=change_workbench/drafts held []
    drafts.items
  + draft_revision
    \ path=path state=namespace
    ^ nat
    = entries ((change_workbench/registrations state).keep((\ [home reg] (reg.units.any((\ unit (equal unit.source path)))))))
    ? !(entries.len) 0
    = [home reg] entries.at(0)
      found ((change_workbench/drafts_at home state).keep((\ source (equal (change_workbench/source/path source) path))))
    ? found.len found.at(0).version 0
  + refresh_drafts
    \ home=path registration=change_workbench/registration state=namespace
    ^ namespace
    = previous (change_workbench/drafts_at home state)
      current=row[change_workbench/source]
        | registration.units.map
        \ unit
        = text (change_workbench/record unit.source state).txt_at(system_vocabulary/content)
          found (previous.keep((\ source (equal (change_workbench/source/path source) unit.source))))
        ? !(found.len) (change_workbench/source unit.source 1 text)
        = source found.at(0)
        ? (eq source.text text) source
        | change_workbench/source unit.source source.version.inc text
    ? (equal previous current) state
    | change_workbench/put home (myth/sing (change_workbench/key 'drafts) (change_workbench/drafts current)) state
  + sources_current
    \ candidate=change_workbench/candidate state=namespace
    ^ bool
    | candidate.sources.all
      \ source
      = path (change_workbench/source/path source)
      | and (eq source.version (change_workbench/draft_revision path state)) (eq source.text (change_workbench/record path state).txt_at(system_vocabulary/content))
  + journal_at
    \ home=path state=namespace
    ^ change_workbench/journal
    > (./some held) (change_workbench/record home state).get((change_workbench/key 'journal)) (change_workbench/journal 0 [] [] [] 0 [])
    > value=change_workbench/journal held (change_workbench/journal 0 [] [] [] 0 [])
    value
  + candidate_at
    \ path=path state=namespace
    ^ maybe[change_workbench/candidate]
    < held (change_workbench/record path state).get((change_workbench/key 'candidate))
    > candidate=change_workbench/candidate held .none
    | ./some candidate
  + run_at
    \ path=path state=namespace
    ^ maybe[change_workbench/run]
    < held (change_workbench/record path state).get((change_workbench/key 'run))
    > result=change_workbench/run held .none
    | ./some result
  + adapter_at
    \ registration=change_workbench/registration state=namespace
    ^ either[str change_workbench/adapter]
    > (./some held) (change_workbench/record registration.adapter state).get((change_workbench/key 'adapter)) (./err "Build adapter is unavailable.")
    > adapter=change_workbench/adapter held (./err "Invalid build adapter.")
    | ./ok adapter
  + status
    \ registration=change_workbench/registration text=str review=str state=namespace
    ^ namespace
    = card (myth/sing (change_workbench/key 'status) (pails/t text)).put((change_workbench/key 'review) (pails/t review))
    = next (change_workbench/put registration.control card state)
    | registration.units.fold next
      \ next=namespace unit
      | change_workbench/put unit.source card next
  + preview_path
    \ home=path candidate=path name=path
    ^ path
    | home.snoc('previews).weld(candidate.drop(home.len.inc)).weld(name.drop(2))
  + previews
    \ home=path candidate=path records=row[[path myth]] state=namespace
    ^ namespace
    | records.fold state
      \ next=namespace [name card]
      > (./some held) card.get(system_vocabulary/grove/view) next
      > view=goo/published held next
      = alias (change_workbench/preview_path home candidate name)
        original view.view
        result view.result
        result=either[grove/error goo/view]
          ? result
           > (./ok lowered) (./ok lowered.set_name(alias))
           > (./err why) (./err why)
      | change_workbench/put alias (myth/sing system_vocabulary/grove/view view.set_view(original.set_name(alias)).set_result(result)) next
  + bind_exports
    \ registration=change_workbench/registration initial=change_workbench/compiled
    ^ either[str change_workbench/compiled]
    % rest=row[change_workbench/export] registration.exports compiled=change_workbench/compiled initial
    ^ either[str change_workbench/compiled]
    ? !(rest.len) (./ok compiled)
    = export rest.at(0)
    ? !(compiled.names.has(export.source)) (./err "An exported declaration is absent from the compiled candidate.")
    ? (compiled.names.has(export.target)) (./err "An export overlaps another publication output.")
    ? !(registration.outputs.any((\ root (pith_prefix root export.target)))) (./err "An export lies outside the registered output boundaries.")
    = card (change_workbench/record export.source compiled.state)
      notes (axal/new[note] .none).put(export.target (note/make card))
    ? (namespace/step notes 0 0 compiled.state)
     > (./rejected _) (./err "Candidate export failed.")
     > (./accepted result)
      | _ rest.drop(1) (change_workbench/compiled result.state compiled.names.snoc(export.target))
  + build
    \ ports=change_workbench/ports home=path registration=change_workbench/registration state=namespace
    ^ either[str namespace]
    ? !(eq registration.activation "namespace") (./err "This target requires an unsupported activation strategy.")
    ? !(and registration.units.len registration.outputs.len) (./err "Target has no source units or output boundaries.")
    ? !(row/all[path] (\ path=path (and (ge path.len 2) (state.permitted(path)))) registration.outputs) (./err "Publication output boundaries require namespace authority.")
    ? !(row/all[path] (\ path=path (state.permitted(path))) registration.authority) (./err "Required target authority is unavailable.")
    = conflict
        | (change_workbench/registrations state).any
        \ [other_home other]
        ? (equal home other_home) .false
        = same_source (registration.units.any((\ unit (other.units.any((\ owned (equal unit.source owned.source)))))))
          overlapping (registration.outputs.any((\ root (other.outputs.any((\ owned ((pith_prefix root owned) || (pith_prefix owned root))))))))
        | (same_source || overlapping)
    ? conflict (./err "A source or output boundary is already owned by another target.")
    < adapter (change_workbench/adapter_at registration state)
    = sources=row[change_workbench/source] (registration.units.map((\ unit (change_workbench/source unit.source (change_workbench/draft_revision unit.source state) (change_workbench/record unit.source state).txt_at(system_vocabulary/content)))))
      before (change_workbench/journal_at home state)
      compile ports.build
      result
        % remaining=row[change_workbench/unit] registration.units branch=namespace state names=row[path] []
        ^ either[str change_workbench/compiled]
        ? !(remaining.len) (./ok (change_workbench/compiled branch names))
        = unit remaining.at(0)
        ? (compile unit.root (change_workbench/record unit.source state).txt_at(system_vocabulary/content) unit.prelude branch)
         > (./err diagnostic) (./err (str/cat_all ["Line " (nat/show diagnostic.span.line) ": " diagnostic.message]))
         > (./ok compiled)
          = outside=row[path] (compiled.names.keep((\ path !(registration.outputs.any((\ root (pith_prefix root path)))))))
          ? outside.len (./err (str/cat_all ["Build produced records outside the registered output boundaries: " (str/join ", " outside.map(path_show))]))
          ? (compiled.names.any((\ path (names.has(path))))) (./err "Source units produce overlapping definitions.")
          | _ remaining.drop(1) compiled.state names.weld(compiled.names)
    < compiled result
    < compiled (change_workbench/bind_exports registration compiled)
    = removed=row[path] (before.active.keep((\ path !(compiled.names.has(path)))))
      owned (row/all[path] (\ path=path (registration.outputs.any((\ root (pith_prefix root path))))) removed)
    ? !(owned) (./err "Output ownership changed; an explicit migration is required.")
    = changes=axal[note]
        | row/fold[path axal[note]] (axal/new[note] .none) (\ out path out.put(path .cull)) removed
      removal=either[str namespace]
        ? !(removed.len) (./ok compiled.state)
        ? (namespace/step changes 0 0 compiled.state)
         > (./rejected _) (./err "Candidate removal failed.")
         > (./accepted result) (./ok result.state)
      validate adapter.validate
    < branch removal
    < valid (validate registration branch)
    = activation adapter.activation
    < plan (activation registration compiled.names.weld(removed))
    ? !(and (eq plan.kind "namespace") !(plan.requirements.len)) (./err "Activation requires unsupported migration or service handover; active records were retained.")
    ? !(equal plan.outputs compiled.names.weld(removed)) (./err "Activation plan does not cover the exact candidate outputs.")
    = records=row[[path myth]] (compiled.names.map((\ path [path (change_workbench/record path branch)])))
      expected (compiled.names.weld(removed).map((\ path (change_workbench/stamp_at .x path state))))
      dependencies=row[change_workbench/stamp]
        [(change_workbench/stamp_at .z [state.self 'gov] state)
         (change_workbench/stamp_at .z [state.self 'lib] state)
         (change_workbench/stamp_at .x registration.adapter state)]
      review (str/join (str/from_atom 10) (sources.map((\ held=change_workbench/source (str/cat_all ["Source: " (path_show (change_workbench/source/path held)) (str/from_atom 10) (change_workbench/source/text held)]))).weld(records.map((\ [path card] (str/cat_all ["Publish " (path_show path)])))).weld(removed.map((\ path (str/cat_all ["Remove " (path_show path)]))))))
      candidate (change_workbench/candidate registration sources records removed expected dependencies state.system branch review plan)
      number before.sequence.inc
      location=path (row/snoc[iota] ($u number) home.snoc('candidates))
      held (myth/sing (change_workbench/key 'candidate) candidate).put(system_vocabulary/lede (pails/t (str/cat_all ["Candidate " (nat/show number)]))).put(system_vocabulary/content (pails/t review))
      next (change_workbench/put location held state)
      next (change_workbench/put registration.control (myth/sing (change_workbench/key 'candidate) (pails/p location)) next)
      next (change_workbench/previews home location records next)
      journal (change_workbench/journal number location [] before.active before.revision before.published)
      next (change_workbench/put home (myth/sing (change_workbench/key 'journal) journal) next)
    | ./ok (change_workbench/status registration "Built · run tests" review next)
  + fixtures
    \ cases=row[[path myth]] state=namespace
    ^ row[change_workbench/stamp]
    | cases.fold []
      \ out=row[change_workbench/stamp] [path card]
      > (./some fixture) card.path_at((change_workbench/key 'fixture)) out
      | out.snoc (change_workbench/stamp_at .x fixture state)
  + test
    \ home=path registration=change_workbench/registration state=namespace
    ^ either[str namespace]
    = journal (change_workbench/journal_at home state)
    > (./some candidate) (change_workbench/candidate_at journal.candidate state) (./err "Build a candidate first.")
    ? !(and (and (equal candidate.registration registration) (change_workbench/sources_current candidate state)) (and (change_workbench/current candidate.dependencies state) (equal candidate.system state.system))) (./err "Source or dependencies changed; rebuild before testing.")
    < adapter (change_workbench/adapter_at registration state)
    = cases=row[[path myth]] ((sovereign_care .z registration.tests state).tap.keep((\ [path card] card.has((change_workbench/key 'expect)))))
    ? !(and cases.len (le cases.len 64)) (./err "Provide between 1 and 64 test cases.")
    = overlays_output
        | cases.any
        \ [path card]
        > (./some fixture) card.path_at((change_workbench/key 'fixture)) .false
        | registration.outputs.any((\ root ((pith_prefix root fixture) || (pith_prefix fixture root))))
    ? overlays_output (./err "Fixtures must be separate from candidate output boundaries.")
    = fixture_notes=axal[note]
        | cases.fold (axal/new[note] .none)
          \ out=axal[note] [path card]
          > (./some fixture) card.path_at((change_workbench/key 'fixture)) out
          | out.put fixture (note/make (change_workbench/record fixture state))
      fixtures=either[str namespace]
        ? (namespace/step fixture_notes 0 0 candidate.branch)
         > (./rejected _) (./err "Fixture capture failed; no tests ran.")
         > (./accepted result) (./ok result.state)
      test adapter.test
    < branch fixtures
    = results=row[[nat str]]
        | cases.map
        \ [path card]
        = attempt (Try (test registration card) branch)
        ? attempt
         > (./err _) [0 "Test raised an exception."]
         > (./ok result)
          ? result
           > (./err why) [0 (str/cat_all [(path_show path) ": " why])]
           > (./ok text) [1 (str/cat_all [(path_show path) ": " text])]
      passed (results.all((\ [ok text] (eq ok 1))))
      report (str/join (str/from_atom 10) (results.map((\ [ok text] text))))
      run (change_workbench/run journal.candidate (state.case(.z registration.tests)) (change_workbench/fixtures cases state) passed report)
      number journal.sequence.inc
      location=path (row/snoc[iota] ($u number) home.snoc('runs))
      held (myth/sing (change_workbench/key 'run) run).put(system_vocabulary/lede (pails/t (str/cat_all ["Test run " (nat/show number)]))).put(system_vocabulary/content (pails/t report))
      next (change_workbench/put location held state)
      next (change_workbench/put registration.control (myth/sing (change_workbench/key 'run) (pails/p location)) next)
      next (change_workbench/put home (myth/sing (change_workbench/key 'journal) journal.set_sequence(number).set_run(location)) next)
    | ./ok (change_workbench/status registration (? passed "Tests passed · ready to publish" "Tests failed") (str/cat_all [report (str/from_atom 10) candidate.review]) next)
  + publish
    \ home=path registration=change_workbench/registration state=namespace
    ^ either[str namespace]
    ? !(eq registration.activation "namespace") (./err "Unsupported activation strategy.")
    = journal (change_workbench/journal_at home state)
    > (./some candidate) (change_workbench/candidate_at journal.candidate state) (./err "Build a candidate first.")
    > (./some run) (change_workbench/run_at journal.run state) (./err "Run tests before publishing.")
    ? !(and run.passed (equal run.candidate journal.candidate)) (./err "The current candidate has not passed its tests.")
    ? !(and (and (equal candidate.registration registration) (change_workbench/sources_current candidate state)) (and (change_workbench/current candidate.dependencies state) (equal candidate.system state.system))) (./err "Source or dependencies changed; rebuild and retest.")
    ? !(and (equal run.cases (state.case(.z registration.tests))) (change_workbench/current run.fixtures state)) (./err "Test cases or fixtures changed; rerun tests.")
    ? !(and (eq candidate.plan.kind "namespace") !(candidate.plan.requirements.len)) (./err "Unsupported activation requirements.")
    ? !(row/all[path] (\ path=path (state.permitted(path))) registration.authority) (./err "Required activation authority is unavailable.")
    ? !(change_workbench/current candidate.expected state) (./err "Publication changed; rebuild and retest.")
    = notes=axal[note]
        | row/fold[[path myth] axal[note]] (axal/new[note] .none) (\ out [path card] out.put(path (note/make card))) candidate.records
      notes (row/fold[path axal[note]] notes (\ out path out.put(path .cull)) candidate.removed)
    ? (namespace/step notes 0 0 state)
     > (./rejected _) (./err "Atomic publication rejected; active records were retained.")
     > (./accepted committed)
      = journal journal.set_active(candidate.records.map((\ [path card] path))).set_revision(journal.revision.inc).set_published(journal.candidate)
        next (change_workbench/put home (myth/sing (change_workbench/key 'journal) journal) committed.state)
        next (change_workbench/put registration.control (myth/sing (change_workbench/key 'active) (pails/t (nat/show journal.revision))) next)
      | ./ok (change_workbench/status registration "Published" (str/cat_all [run.report (str/from_atom 10) candidate.review]) next)
  + apply
    \ ports=change_workbench/ports home=path registration=change_workbench/registration command=str state=namespace
    ^ namespace
    = attempt=either[str namespace]
        ? (eq command "build") (change_workbench/build ports home registration state)
        ? (eq command "test") (change_workbench/test home registration state)
        ? (eq command "publish") (change_workbench/publish home registration state)
        | ./err "Unknown workbench operation."
      caught=either[any either[str namespace]] (Try (\ ignored=unit attempt) unit/unit)
    ? caught
     > (./err _) (change_workbench/status registration "Operation raised an exception; the active publication was retained." "" state)
     > (./ok result)
      ? result
       > (./ok next) next
       > (./err why) (change_workbench/status registration why "Active publication retained." state)
  + reconcile_one
    \ ports=change_workbench/ports entry=[path change_workbench/registration] state=namespace
    ^ namespace
    = [home registration] entry
      state (change_workbench/refresh_drafts home registration state)
      journal (change_workbench/journal_at home state)
    ? (and registration.bootstrap !(journal.sequence))
      = marked (change_workbench/put home (myth/sing (change_workbench/key 'journal) journal.set_sequence(1)) state)
        built (change_workbench/apply ports home registration "build" marked)
      ? (maybe/is_none (change_workbench/candidate_at (change_workbench/journal_at home built).candidate built)) built
      = tested (change_workbench/apply ports home registration "test" built)
      > (./some run) (change_workbench/run_at (change_workbench/journal_at home tested).run tested) tested
      ? !(run.passed) tested
      | change_workbench/apply ports home registration "publish" tested
    = controls=row[path] (registration.units.map((\ unit unit.source))).cons(registration.control)
    | controls.fold state
      \ current=namespace control=path
      = record (change_workbench/record control current)
        command record.txt_at((change_workbench/key 'command))
      ? !(command.len) current
      = cleared (change_workbench/put control (myth/sing (change_workbench/key 'command) (pails/t "")) current)
      ? (and (eq command "publish") !(equal control registration.control)) (change_workbench/status registration "Publish is available only from the human control record." "" cleared)
      | change_workbench/apply ports home registration command cleared
  + reconcile
    \ ports=change_workbench/ports state=namespace
    ^ namespace
    | row/fold[[path change_workbench/registration] namespace] state (\ current entry (change_workbench/reconcile_one ports entry current)) (change_workbench/registrations state)

' --- grove_draft ---

' Namespace source adapter. Registered hosts own destinations and compiler context.
' Draft records contain descriptions, never compiler capabilities.
+ grove_draft
  + job
    : source=str revision=nat attempted=nat ready=nat request=nat published=nat
      message=str line=nat
  + registration
    : draft=path job_slot=path preview_source=path preview_target=path
      public_source=path public_target=path prelude=str
  + ports
    : compile={\ path str str namespace}either[grove_backend/diagnostic namespace]
      build={\ path str str namespace}either[grove_backend/diagnostic change_workbench/compiled]
  + parse
    \ source=str
    ^ either[grove_backend/diagnostic grove/document]
    ? (grove/parse source)
     > (./ok document) (./ok document)
     > (./err why)
      ? why
       > (grove/error/syntax span message)
        | ./err (grove_backend/diagnostic span message .none)
       > (grove/error/parser cause)
        | ./err (grove_backend/diagnostic rex/zero_span "Invalid generated Grove source" (./some cause))
  + validate_views
    ' Normal publications may retain diagnostic views for inspection. A runnable
    ' draft preview requires every published recipe to have lowered successfully.
    \ records=row[[path myth]]
    ^ either[grove_backend/diagnostic row[[path myth]]]
    % rest=row[[path myth]] records
    ^ either[grove_backend/diagnostic row[[path myth]]]
    ? (eq rest.len 0) (./ok records)
    = [name card] rest.at(0)
    > (./some held) card.get(system_vocabulary/grove/view) (_ rest.drop(1))
    > published=goo/published held (./err (grove_backend/diagnostic rex/zero_span "Invalid draft view publication" .none))
    ? published.result
     > (./ok view) (_ rest.drop(1))
     > (./err why)
      ? why
       > (grove/error/syntax span message) (./err (grove_backend/diagnostic span message .none))
       > (grove/error/parser cause) (./err (grove_backend/diagnostic rex/zero_span "Invalid draft view" (./some cause)))
  + slot
    ^ path
    system_vocabulary/grove/draft
  + registry
    \ self=iota
    ^ path
    [self 'weft 'grove_drafts]
  + write
    \ target=path card=myth state=namespace
    ^ namespace
    = command (? (maybe/is_some (sovereign_peek target state).fil) (writ/poke card) (writ/make card))
      [next reply] (helm/supervisor/handle
        (helm/card/step target command) state)
    > (./ack failure) reply (Seq[namespace] (error (pails/t "Draft write returned no acknowledgement")) state)
    ? failure
     > (./some why) (Seq[namespace] (error why) state)
    next
  + install
    \ source=path target=path state=namespace
    ^ either[grove_backend/diagnostic namespace]
    = version (state.case(.x source)).fall(0)
      result (grove_install/replace source version target (state.case(.z target)) state)
    ? result
     > (./ok next) (./ok next)
     > (./err why) (./err (grove_backend/diagnostic rex/zero_span "Draft installation failed" (./some why)))
  + reconcile_one
    \ ports=grove_draft/ports registration=grove_draft/registration state=namespace
    ^ namespace
    = card (sovereign_peek registration.draft state).fil.fall(myth/new)
    > (./some held) card.get(registration.job_slot) state
    > job=grove_draft/job held state
    = publishing (and (eq job.request job.revision) (and (eq job.ready job.revision) (gt job.request job.published)))
      building (gt job.revision job.attempted)
    ? !(building || publishing) state
    = source (? building registration.preview_source registration.public_source)
      target (? building registration.preview_target registration.public_target)
      compile ports.compile
      result=either[grove_backend/diagnostic namespace]
        < next (compile source job.source registration.prelude state)
        | grove_draft/install source target next
    ? result
     > (./err why)
      = failed job.set_attempted(job.revision).set_request(0).set_message(why.message).set_line(why.span.line)
      | grove_draft/write registration.draft (myth/sing registration.job_slot failed) state
     > (./ok next)
      = done
          ? building job.set_attempted(job.revision).set_ready(job.revision).set_message("Preview ready").set_line(0)
          | job.set_published(job.revision).set_message("Published").set_line(0)
      | grove_draft/write registration.draft (myth/sing registration.job_slot done) next
  + reconcile
    \ ports=grove_draft/ports state=namespace
    ^ namespace
    = registrations (sovereign_care .y (grove_draft/registry state.self) state).kid_tap
    = next
        | registrations.fold state
        \ state [key node]
        > (./some held) node.fil.fall(myth/new).get(grove_draft/slot) state
        > registration=grove_draft/registration held state
        | grove_draft/reconcile_one ports registration state
    | change_workbench/reconcile (change_workbench/ports ports.build) next
  + handle
    \ ports=grove_draft/ports base=helm/supervisor/access[namespace] card=helm/card state=namespace
    ^ [namespace feet/task[unit]]
    = handle base.handle
      [next reply] (handle card state)
      changed (? (eq next.local.top state.local.top) next (grove_draft/reconcile ports next))
    [changed reply]
  + access
    \ ports=grove_draft/ports base=helm/supervisor/access[namespace]
    ^ helm/supervisor/access[namespace]
    | base.set_handle((grove_draft/handle ports base))

' --- lainapp ---

' Shared namespace task helpers.
' Runtime boot lives in Eden and requires an explicit sovereign namespace.
+  vine_make
  '  A make command as a task, tagged with its target path.
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/make t))
+  vine_poke
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/poke t))
+  vine_cull
  \  pax=path
  ^  task
  (./vine pax (writ/cull))
+  vine_warp
  '  A warp command as a task: apply the op at `op` to the record at
  '  pax with the transient input.
  \  pax=path op=path input=myth
  ^  task
  (./vine pax (writ/warp op input))
+  install_card
  '  The host install op card, registered under the publisher’s kook/install: warp it
  '  at any root to mount the app named by the input's ['app] text
  '  slot there — the fn returns the app's pact/card, and the warp
  '  arm expands it in place.  fn arrives from the host at boot: it
  '  closes over the boot-compiled manifests and the grant policy,
  '  so authority stays host-side (the mount is where grants are
  '  decided).  Built in foil because nominal rows (op, pact/card)
  '  cannot be minted across the FFI.
  \  fn={\ myth myth}myth
  ^  myth
  .  (myth/new)
     put(system_vocabulary/op (op 'install 'host [[['app] "t"]] 'app "op install: host > app t < app root card" fn))
     put(bond/lede (pails/t "op install: mount the app named by ['app] at this node"))

' --- overlay_cache ---

' Opt-in materialization of an existing /o application. The ordinary lens
' dependency machinery handles source care, pinned functions and nested lenses.
' Cache records live outside their input subtrees and are not authoritative data.
+ overlay_cache
  + source_slot
    ^ path
    system_vocabulary/from
  + result_slot
    ^ path
    system_vocabulary/content
  + result
    : tree=pin[axal[myth]]
  + value
    \ record=myth
    ^ axal[myth]
    > (./some held) record.get(overlay_cache/result_slot) (axal/new[myth] .none)
    > cached=overlay_cache/result held (axal/new[myth] .none)
    | unpin cached.tree
  + bind
    \ record=myth
    ^ myth
    = source (record.path_at(overlay_cache/source_slot)).fall([])
    | record.put crew_slot (cpail (crew/sing ['overlay] (dep .z source)))
  + schedule
    \ b=bowl record=myth
    ^ yell
    | yell [[b.here (writ/poke myth/new)]] (overlay_cache/bind record)
  + refresh
    \ b=bowl record=myth
    ^ yell
    = tree (b.crew.gut(['overlay] (axal/new[myth] .none)))
    | yell [] (record.put(overlay_cache/result_slot (overlay_cache/result (pin tree))))
  + talk
    \ b=bowl cur=myth add=myth
    ^ yell
    = next (overlay_cache/bind (cur.meld(add)))
    ? !(equal (cur.get(crew_slot)) (next.get(crew_slot)))
      | overlay_cache/schedule b next
    | overlay_cache/refresh b next
  + hear
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    | overlay_cache/refresh b cur
  + form
    ^ form
    | def_form.set_init(overlay_cache/schedule).set_talk(overlay_cache/talk).set_hear(overlay_cache/hear)
  + card
    \ behavior=path source=path
    ^ myth
    | overlay_cache/bind
      | (kooked [behavior]).put overlay_cache/source_slot (pails/p source)
  + path
    ' A complete, pinned /o application; input remains live.
    \ version=nat transform=path input=path
    ^ path
    = prefix=path ['o ($u version) ($u transform.len)]
    | prefix.weld(transform).snoc(($u input.len)).weld(input)
  + install
    ' Prime the cache in the same event that creates it. Subsequent source
    ' changes refresh it before the supervisor acknowledges the source write.
    \ target=path source=path state=namespace
    ^ either[iota namespace]
    ? (maybe/is_none (o_parse source)) (./err 'invalid_overlay_path)
    ? !(sovereign_observer target state) (./err 'invalid_cache_target)
    = triggers (o_trigger_reader source (sovereign_reader state))
    ? (triggers.any((\ dependency (pith_prefix dependency.p target))))
      | ./err 'cache_inside_source
    = behavior=path [state.self 'kook 'overlay_cache]
      [next reply]
        | helm/supervisor/handle
          (helm/card/step behavior
            (writ/make (form/card overlay_cache/form (lore/line "Cached overlay"))))
          state
    > (./ack failure) reply (./err 'cache_behavior_failed)
    ? (maybe/is_some failure) (./err 'cache_behavior_failed)
    = [next reply]
        | helm/supervisor/handle
          (helm/card/step target (writ/make (overlay_cache/card behavior source)))
          next
    > (./ack failure) reply (./err 'cache_install_failed)
    ? (maybe/is_some failure) (./err 'cache_install_failed)
    | ./ok next

' --- slot_presentation ---

' Shared content/presentation filtering policy, independent of slot documentation.
+ slot_presentation
  + machinery
    \ slot=path
    ^ bool
    = slots=row[path]
        [system_vocabulary/called_by
         system_vocabulary/calls
         system_vocabulary/crew
         system_vocabulary/dt
         system_vocabulary/entries
         system_vocabulary/face
         system_vocabulary/form
         system_vocabulary/grove/action
         system_vocabulary/grove/like
         system_vocabulary/grove/module
         system_vocabulary/grove/norm
         system_vocabulary/grove/role
         system_vocabulary/grove/role_contract
         system_vocabulary/grove/seed
         system_vocabulary/grove/sewn
         system_vocabulary/grove/source
         system_vocabulary/grove/template
         system_vocabulary/grove/view
         system_vocabulary/lash
         system_vocabulary/limb
         system_vocabulary/mold
         system_vocabulary/op
         system_vocabulary/req
         system_vocabulary/res
         system_vocabulary/spec
         system_vocabulary/tack
         system_vocabulary/unreads
         system_vocabulary/weft]
    | slots.any (\ key (eq_pith key slot))

' --- web_fragment ---

+  frag
  '  The fragment vocabulary: components are overlay ctors whose
  '  derived records carry markup (a weft/node at ['html]), applied
  '  through /o and served bare over the /frag route.  Containers
  '  mount them as w-get elements the /w.js runtime keeps fresh
  '  (weft/runtime documents the attribute set).

  +  url
    '  The fragment URL applying the component node at op to the
    '  data at dp: /frag/1/olen/...op/dlen/...dp.  The function pin
    '  is hardcoded to x case 1 per the write-once component
    '  convention (pact/weft_card): components mount once and never
    '  change in place, so their first mint is their only mint.
    \  op=path dp=path
    ^  nat
    | weft/cat ["/frag/1/" (weft/show_nat op.len) (show/path op) "/" (weft/show_nat dp.len) (show/path dp)]

  +  html
    '  A component result: markup at ['html].  The node rides the
    '  pail as its branded member row (sums do not inhabit pails),
    '  so a fragment's root is always an element.
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  myth
    (myth/new).put(['html] (weft/node/el tag as kids))

  +  mount
    '  A fragment mount: an empty element the runtime fills on page
    '  load and re-fetches every `every` seconds, swapping only when
    '  the markup actually changed — the server-side first paint is
    '  deliberately absent so component output is never duplicated
    '  into container code.
    \  id=nat op=path dp=path every=nat
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'div
          'id id
          'w-get (frag/url op dp)
          'w-trigger (weft/cat ["every " (weft/show_nat every) "s"])
    markup.at(0)

  +  edit
    '  w-edit: the text run edits in place, committing to the slot at
    '  the enclosing mount's data path plus rel.  rel rides as a real
    '  path — the "." spelling for the empty rel is derived here, so
    '  hand-spelled relative cords (and their silent-miss typos)
    '  never appear at call sites.
    \  rel=path slot=nat
    ^  weft/item
    =  spell
         ?  (eq 0 rel.len)
            "."
         =  parts
              %  idx=nat 0  out=row[nat] []
              ?  (eq idx rel.len)
                 out
              | _ idx.inc out.snoc((show/iota rel.at(idx)))
         | weft/join "/" parts
    | weft/item/at (weft/att "w-edit" (weft/cat [spell " " slot]))

  +  script
    '  The runtime include for container pages.
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'script
          'src "/w.js"
    markup.at(0)

  +  ver_nat
    '  A decimal counter off the request's ['ver] crew view (the
    '  target's /h/v record): system_vocabulary/version/top is the sovereign's current
    '  epoch, system_vocabulary/version/first the target's first — the scrubber's bounds.
    '  0 when the crew carries no version view.
    \  =bowl slot=path
    ^  nat
    =  vv  bowl.crew.gut(['ver] (axal/new[myth] .none))
    ?  vv.fil
     > .none  0
     > (./some t)
       ?  (dig_parse (myth/txt_at slot t))
        > (./some n)  n
        > .none  0

  +  scrubber
    '  The omni-scrubber: one slider that pins every fragment on the
    '  page to a shared sovereign epoch — drag left and the whole
    '  page rewinds through committed history, the right edge
    '  returns to now.  Bounds come from the request's ['ver] crew
    '  view (frag/ver_nat system_vocabulary/version/first and system_vocabulary/version/top); the /w.js runtime
    '  rewrites every mount's fetch through /h's epoch spelling
    '  while pinned, and polls idle because history is constant.
    \  first=nat top=nat
    ^  weft/node
    = lo
        ? first first
        1
      markup
        ~ weft/build
        ~| 'div.wscrub
          ~# 'input[type=range]
            'min (weft/show_nat lo)
            'max (weft/show_nat top)
            'value (weft/show_nat top)
            'w-scrub "1"
          ~. 'span.wscrub-lab "now"
    markup.at(0)

  +  shell_css
    '  The generic datum shell's minimal chrome.
    ^  nat
    "body{margin:1.5rem;font-family:system-ui,sans-serif} .wscrub{margin-bottom:1rem}"

  +  shell
    '  The generic datum-face page: a title, the omni-scrubber for
    '  live targets, and one EMPTY mount the /w.js runtime fills
    '  through /frag — mounts are deliberately empty, so the ctor's
    '  output is never duplicated server-side, first paint arrives
    '  via the runtime's immediate fetch, and scrubbing rides the
    '  runtime's /h pinurl rewriting unchanged.
    \  =bowl out=myth tgt=path ctor=path
    ^  yell
    | frag/shell_with weft/page bowl out tgt ctor

  + shell_with
    \ page={\ nat nat row[weft/node]}nat
      =bowl out=myth tgt=path ctor=path
    ^ yell
    =  first  (frag/ver_nat bowl system_vocabulary/version/first)
       top    (frag/ver_nat bowl system_vocabulary/version/top)
       scrub
         ^  row[weft/node]
         ?  top
            [(frag/scrubber first top)]
         []
       body  scrub.weld([(frag/mount "shell" ctor tgt 2) frag/script])
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (page (show/path tgt) frag/shell_css body)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

  +  as_node
    '  A pail as a weft/node, when it holds one: node values ride
    '  pails as their branded member rows (the ['html] slot of a
    '  component's derived record), so consumers rebuild the sum.
    '  Lives here rather than in weft — weft is import-free and
    '  knows neither pail nor maybe.
    \  held=pail
    ^  maybe[weft/node]
    ?  held
     > t=weft/node/tx   (./some (./tx t.s))
     > r=weft/node/raw  (./some (./raw r.s))
     > e=weft/node/el   (./some (./el e.tag e.as e.kids))
    .none

  +  talk
    '  The fragment responder: the hydrated derived record at the /o
    '  target, its ['html] node rendered bare — no shell, no chrome.
    '  Anything short of markup is a 404 with a terse reason.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ans
         ^  row[nat]
         ?  view.fil
          > .none  [404 "no fragment at this path"]
          > (./some t)
            ?  t.get(['html])
             > .none  [404 "no html slot"]
             > (./some held)
               ?  (frag/as_node held)
                > .none  [404 "html slot is not markup"]
                > (./some nd)  [200 (weft/render nd)]
       done
         .  out
            put(['res_status] (pd ans.at(0)))
            put(['res_body] (pd ans.at(1)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

' --- semidoc ---

'  semidoc: a minimal semantic documentation format (spec draft 0).
'  Seven block forms and nothing else: ;. document, ;= section,
'  ;- item, ;> quotation, ;$ literal, ;@ attribute, ;/ reference;
'  every other line is prose.  Layout is indentation: children sit
'  deeper than their parent, section depth is nesting, there are no
'  heading levels.  The parser assigns no meaning to any attribute —
'  predicates are namespace paths, and aliases (;@ /doc/alias d /doc)
'  are lexical only: compiled documents carry canonical paths.
'  Attributes decorate the FOLLOWING node, exactly as specified; a
'  container's trailing attributes (no following node) attach to the
'  container itself.  Literal payloads are opaque: dedented to their
'  own base indent, never parsed.  The tree has two projections,
'  both separate concerns from parsing: /page renders it as HTML
'  through weft (references link into the explorer), and /myths
'  emits it as namespace records — one myth per node, kids numbered
'  to preserve order, attribute predicates as slot keys — so a
'  compiled document mounts as ordinary namespace citizens.  The
'  renderer interprets one standard vocabulary (spec section 18):
'  a literal attributed /doc/interpret_as /formats/test renders
'  with a run form posting its body to the /chore/eval bridge —
'  examples execute against the live image (/doc/eval_with names
'  the module subject, default sept).  The PARSER still assigns no
'  meaning to any attribute.
+  sval
  '  One attribute value: a bare word, or a ;/namespace reference.
  &  sval/word
