  '  ?=  ((split_byte 47 "/a/b") ["a" "b"])
  '  ?=  ((split_byte 32 "one  two") ["one" "two"])
  '  ?=  ((split_byte 47 "") [])
  \ b=nat s=nat
  ^ row[nat]
  | cord/split_nonempty b s
+  spaces
  '  A cord of n spaces.
  '  ?=  ((spaces 0) 0)
  '  ?=  ((spaces 2) "  ")
