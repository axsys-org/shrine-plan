- http
- http_response
- show
- weft
+  frag
  '  The fragment vocabulary: components are overlay ctors whose
  '  derived records carry markup (a weft/node at ['html]), applied
  '  through /o and served bare over the /frag route.  Containers
  '  mount them as w-get elements the /w.js runtime keeps fresh
  '  (weft/runtime documents the attribute set).

  +  url
    '  The fragment URL applying the component node at op to the
    '  data at dp: /frag/1/olen/...op/dlen/...dp.  The function pin
    '  is hardcoded to x case 1 per the write-once component
    '  convention (pact/weft_card): components mount once and never
    '  change in place, so their first mint is their only mint.
    \  op=path dp=path
    ^  nat
    | weft/cat ["/frag/1/" (weft/show_nat op.len) (show/path op) "/" (weft/show_nat dp.len) (show/path dp)]

  +  html
    '  A component result: markup at ['html].  The node rides the
    '  pail as its branded member row (sums do not inhabit pails),
    '  so a fragment's root is always an element.
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  myth
    (myth/new).put(['html] (weft/node/el tag as kids))

  +  mount
    '  A fragment mount: an empty element the runtime fills on page
    '  load and re-fetches every `every` seconds, swapping only when
    '  the markup actually changed — the server-side first paint is
    '  deliberately absent so component output is never duplicated
    '  into container code.
    \  id=nat op=path dp=path every=nat
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'div
          'id id
          'w-get (frag/url op dp)
          'w-trigger (weft/cat ["every " (weft/show_nat every) "s"])
    markup.at(0)

  +  edit
    '  w-edit: the text run edits in place, committing to the slot at
    '  the enclosing mount's data path plus rel.  rel rides as a real
    '  path — the "." spelling for the empty rel is derived here, so
    '  hand-spelled relative cords (and their silent-miss typos)
    '  never appear at call sites.
    \  rel=path slot=nat
    ^  weft/item
    =  spell
         ?  (eq 0 rel.len)
            "."
         =  parts
              %  idx=nat 0  out=row[nat] []
              ?  (eq idx rel.len)
                 out
              | _ idx.inc out.snoc((show/iota rel.at(idx)))
         | weft/join "/" parts
    | weft/item/at (weft/att "w-edit" (weft/cat [spell " " slot]))

  +  script
    '  The runtime include for container pages.
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'script
          'src "/w.js"
    markup.at(0)

  +  ver_nat
    '  A decimal counter off the request's ['ver] crew view (the
    '  target's /h/v record): publisher_vocabulary/version/top is the sovereign's current
    '  epoch, publisher_vocabulary/version/first the target's first — the scrubber's bounds.
    '  0 when the crew carries no version view.
    \  =bowl slot=path
    ^  nat
    =  vv  bowl.crew.gut(['ver] (axal/new[myth] .none))
    ?  vv.fil
     > .none  0
     > (./some t)
       ?  (dig_parse (myth/txt_at slot t))
        > (./some n)  n
        > .none  0

  +  scrubber
    '  The omni-scrubber: one slider that pins every fragment on the
    '  page to a shared sovereign epoch — drag left and the whole
    '  page rewinds through committed history, the right edge
    '  returns to now.  Bounds come from the request's ['ver] crew
    '  view (frag/ver_nat publisher_vocabulary/version/first and publisher_vocabulary/version/top); the /w.js runtime
    '  rewrites every mount's fetch through /h's epoch spelling
    '  while pinned, and polls idle because history is constant.
    \  first=nat top=nat
    ^  weft/node
    = lo
        ? first first
        1
      markup
        ~ weft/build
        ~| 'div.wscrub
          ~# 'input[type=range]
            'min (weft/show_nat lo)
            'max (weft/show_nat top)
            'value (weft/show_nat top)
            'w-scrub "1"
          ~. 'span.wscrub-lab "now"
    markup.at(0)

  +  shell_css
    '  The generic datum shell's minimal chrome.
    ^  nat
    "body{margin:1.5rem;font-family:system-ui,sans-serif} .wscrub{margin-bottom:1rem}"

  +  shell
    '  The generic datum-face page: a title, the omni-scrubber for
    '  live targets, and one EMPTY mount the /w.js runtime fills
    '  through /frag — mounts are deliberately empty, so the ctor's
    '  output is never duplicated server-side, first paint arrives
    '  via the runtime's immediate fetch, and scrubbing rides the
    '  runtime's /h pinurl rewriting unchanged.
    \  =bowl out=myth tgt=path ctor=path
    ^  yell
    | frag/shell_with weft/page bowl out tgt ctor

  + shell_with
    \ page={\ nat nat row[weft/node]}nat
      =bowl out=myth tgt=path ctor=path
    ^ yell
    =  first  (frag/ver_nat bowl publisher_vocabulary/version/first)
       top    (frag/ver_nat bowl publisher_vocabulary/version/top)
       scrub
         ^  row[weft/node]
         ?  top
            [(frag/scrubber first top)]
         []
       body  scrub.weld([(frag/mount "shell" ctor tgt 2) frag/script])
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (page (show/path tgt) frag/shell_css body)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

  +  as_node
    '  A pail as a weft/node, when it holds one: node values ride
    '  pails as their branded member rows (the ['html] slot of a
    '  component's derived record), so consumers rebuild the sum.
    '  Lives here rather than in weft — weft is import-free and
    '  knows neither pail nor maybe.
    \  held=pail
    ^  maybe[weft/node]
    ?  held
     > t=weft/node/tx   (./some (./tx t.s))
     > r=weft/node/raw  (./some (./raw r.s))
     > e=weft/node/el   (./some (./el e.tag e.as e.kids))
    .none

  +  talk
    '  The fragment responder: the hydrated derived record at the /o
    '  target, its ['html] node rendered bare — no shell, no chrome.
    '  Anything short of markup is a 404 with a terse reason.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ans
         ^  row[nat]
         ?  view.fil
          > .none  [404 "no fragment at this path"]
          > (./some t)
            ?  t.get(['html])
             > .none  [404 "no html slot"]
             > (./some held)
               ?  (frag/as_node held)
                > .none  [404 "html slot is not markup"]
                > (./some nd)  [200 (weft/render nd)]
       done
         .  out
            put(['res_status] (pd ans.at(0)))
            put(['res_body] (pd ans.at(1)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
