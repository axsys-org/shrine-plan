-  sept
-  shrine_types
+  ass
  '  An assertion: a committed version (/saga, from shrine_types), or
  '  a tombstone.  Tombstones carry their versioning too — a removal
  '  is a version like any other.  Recursive cull ensures a dead node
  '  has no live descendants; revival continues its existing locks.
  &  ($ker saga)
     ($nul aeon)
+  res
  '  A resolution result.  $null is a tombstone answer; $unknown is
  '  the absence of any answer.  Never collapse the two: a shrug is
  '  not a tombstone.
  (@@ v)
  &  ($known v)
     $null
     $unknown
+  sign
  '  Per-care change grade for one path: 0 unchanged, 1 data moved,
  '  2 data and shape moved (a creation or removal; shape implies
  '  data within one commit).
  :  x=nat y=nat z=nat
+  verdict
  '  A namespace transition either commits one epoch or is rejected
  '  before any journal, assertion, case, or sign is created.
  (@@ v)
  &  ($accepted v)
     ($rejected quip)
+  nmax
  \  a=nat b=nat
  ^  nat
  ?  (lt a b)
     b
  a
+  hsag
  '  The live committed version at cur, if any.
  \  c=nat h=uon[ass]
  ^  maybe[saga]
  ?  h.floor(($u c))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($some g)
      > ($nul a=aeon)  $none
+  hyuga
  '  The versioning at cur, live or dead: every assertion carries an
  '  aeon, so the floor's yuga answers uniformly.
  \  c=nat h=uon[ass]
  ^  maybe[yuga]
  ?  h.floor(($u c))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($some g.aeon.yuga)
      > ($nul a=aeon)  ($some a.yuga)
+  hres
  '  Resolution within one path history: the record at cur, a
  '  tombstone, or unknown.
  \  c=nat h=uon[ass]
  ^  res[myth]
  ?  h.floor(($u c))
   > $none  $unknown
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($known g.myth)
      > ($nul a=aeon)  $null
+  res_equal
  '  Extensional equality of resolution states.  Unknown and
  '  tombstone remain distinct; live myths compare deeply.
  \  a=res[myth] b=res[myth]
  ^  nat
  ?  a
   > ($known x=myth)
     ?  b
      > ($known y=myth)  (equal x y)
     0
   > $null
     ?  b
      > $null  1
     0
   > $unknown
     ?  b
      > $unknown  1
     0
+  res_live
  \  a=res[myth]
  ^  nat
  ?  a
   > ($known x=myth)  1
  0
+  note_cull
  \  a=note
  ^  nat
  ?  a
   > note/cull  1
  0
+  note_live
  '  Make and poke always resolve to a live myth; cull does not.
  \  a=note
  ^  nat
  ?  a
   > note/cull  0
  1
+  maybe_note_cull
  \  a=maybe[note]
  ^  nat
  ?  a
   > $none  0
   > ($some n=note)  (note_cull n)
+  track0
  '  A never-minted care history.
  \  x=nat
  ^  track
  (track (lock 0 0) (uon/empty))
+  ever0
  '  A never-minted path history.
  \  x=nat
  ^  ever
  (ever (track0 0) (track0 0) (track0 0))
+  track_mint
  '  Advance one local care clock at sovereign epoch ep.  A shape
  '  grade advances both independent counters; every nonzero grade
  '  appends one dense data-case -> epoch entry.
  \  g=nat ep=nat old=track
  ^  track
  ?  (eq 0 g)
     old
  =  > nd old.lock.data.inc
  =  > ns
       ?  (eq 2 g)
          old.lock.shape.inc
       old.lock.shape
  (track (lock nd ns) old.epochs.put(($u nd) ep))
+  ever_mint
  \  gx=nat gy=nat gz=nat ep=nat old=ever
  ^  ever
  (ever (track_mint gx ep old.x)
        (track_mint gy ep old.y)
        (track_mint gz ep old.z))
+  yuga_of
  '  Copy the local clocks into one assertion's version header.
  \  ev=ever now=nat block=nat
  ^  yuga
  (yuga ev.x.lock ev.y.lock ev.z.lock now block)
+  track_case
  '  Resolve an exact local data case to its sovereign epoch.
  \  c=nat tr=track
  ^  maybe[nat]
  ?  (eq 0 c)
     $none
  tr.epochs.get(($u c))
+  spine_mint
  '  A version-only re-mint of a node whose subtree moved: the record
  '  (or tombstone) rides unchanged, the y and z locks advance.
  '  $none when the path was never asserted (nothing to adjust).
  \  yg=yuga ck=quip top=nat h=uon[ass]
  ^  maybe[uon[ass]]
  ?  h.floor(($u top))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker og=saga)
        ($some h.put(ck ($ker (saga (aeon yg (oath 0 0)) og.myth))))
      > ($nul oa=aeon)
        ($some h.put(ck ($nul (aeon yg (oath 0 0)))))
+  cull_cover
  '  Is a strict prefix of pax explicitly culled in raw?
  \  pax=path raw=axal[note]
  ^  nat
  |  > i=nat 0
  ?  (eq i pax.len)
     0
  ?  (maybe_note_cull raw.get(pax.take(i)))
     1
  (_ i.inc)
+  tomb_block
  '  A live-result write may pass a current tombstone only when
  '  this same effective event revives that exact prefix.
  \  pax=path eff=axal[note] top=nat idx=axal[uon[ass]]
  ^  nat
  |  > i=nat 0
  ?  (eq i pax.len)
     0
  =  > pre pax.take(i)
  =  > h idx.gut(pre (uon/empty))
  ?  (hres top h)
   > $null
     ?  eff.get(pre)
      > ($some a=note)
        ?  (note_live a)
           (_ i.inc)
        1
      > $none  1
  (_ i.inc)
+  prune_culls
  '  Remove every explicit note strictly below an explicit cull.
  \  raw=axal[note]
  ^  axal[note]
  =  > es raw.tap
  |  > i=nat 0  > acc=axal[note] (axal/new[note] $none)
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  ?  (cull_cover p raw)
     (_ i.inc acc)
  (_ i.inc acc.put(p q))
+  add_culled_subtree
  '  Add synthesized culls for every currently-live assertion below
  '  bp, including bp itself when it is currently live.
  \  bp=path acc=axal[note] top=nat idx=axal[uon[ass]]
  ^  axal[note]
  =  > es idx.dip(bp).tap
  |  > i=nat 0  > out=axal[note] acc
  ?  (eq i es.len)
     out
  =  > h es.at(i)
  =  > r (hres top q)
  ?  (res_live r)
     (_ i.inc out.put(bp.weld(p) (note/cull)))
  (_ i.inc out)
+  expand_culls
  '  Expand every surviving cull over the current live subtree.
  \  base=axal[note] top=nat idx=axal[uon[ass]]
  ^  axal[note]
  =  > es base.tap
  |  > i=nat 0  > acc=axal[note] base
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  ?  (note_cull q)
     (_ i.inc (add_culled_subtree p acc top idx))
  (_ i.inc acc)
+  writes_valid
  '  Are all effective live writes clear of unrevived tombstones?
  \  eff=axal[note] top=nat idx=axal[uon[ass]]
  ^  nat
  =  > es eff.tap
  |  > i=nat 0
  ?  (eq i es.len)
     1
  =  > h es.at(i)
  ?  (mul (note_live q) (tomb_block p eff top idx))
     0
  (_ i.inc)
+  prepare
  '  Cull dominates every explicit descendant write, then expands
  '  to every currently-live descendant.  The caller validates live
  '  writes and retains raw for audit.
  \  raw=axal[note] top=nat idx=axal[uon[ass]]
  ^  axal[note]
  =  > base (prune_culls raw)
  (expand_culls base top idx)
+  sov
  '  The versioned namespace of one czar.  rec and idx are keyed by
  '  the sovereign-wide commit epoch; top is the latest epoch and 0
  '  is reserved.  cases is a separate path-indexed ledger of local
  '  x/y/z clocks and their data-case -> epoch mappings.
  :  rec=uon[axal[note]] idx=axal[uon[ass]] top=nat cases=axal[ever]
  +  new
    '  The empty sovereign.  The argument is ignored.
    \  x=nat
    ^  sov
    (sov (uon/empty) (axal/new[uon[ass]] $none) 0
         (axal/new[ever] $none))
  +  hist
    '  The epoch-keyed assertion history recorded at a path.
    \  pax=path s=sov
    ^  uon[ass]
    s.idx.gut(pax (uon/empty))
  +  ever_at
    '  The local clocks at a path, zeroed when it owns no ledger.
    \  pax=path s=sov
    ^  ever
    s.cases.gut(pax (ever0 0))
  +  x_case
    '  The current path-local x data case, if one has minted.
    \  pax=path s=sov
    ^  maybe[nat]
    =  > c s.ever_at(pax).x.lock.data
    ?  (eq 0 c)
       $none
    ($some c)
  +  y_case
    '  The current path-local y data case, only for asserted paths.
    \  pax=path s=sov
    ^  maybe[nat]
    =  > c s.ever_at(pax).y.lock.data
    ?  (eq 0 c)
       $none
    ($some c)
  +  z_case
    '  The current path-local z data case, only for asserted paths.
    \  pax=path s=sov
    ^  maybe[nat]
    =  > c s.ever_at(pax).z.lock.data
    ?  (eq 0 c)
       $none
    ($some c)
  +  x_at
    '  Internal snapshot read by sovereign epoch.
    \  ep=nat pax=path s=sov
    ^  res[myth]
    ?  (gt ep s.top)
       $unknown
    (hres ep s.hist(pax))
  +  y_at
    '  Internal y snapshot by epoch: p's record at [] plus its
    '  frontier — each nearest descendant with a known record, at its
    '  full relative pith; transparent and tombstoned paths pass through.
    '  Unknown unless p is a node at ep.
    \  ep=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  s.x_at(ep pax)
     > $null  $unknown
     > $unknown  $unknown
     > ($known w=myth)
       =  > seed
            =  > ks s.idx.dip(pax).kid.tap
            |  > i=nat 0  > acc=row[[p=path q=axal[uon[ass]]]] []
            ?  (eq i ks.len)
               acc
            =  > h ks.at(i)
            (_ i.inc acc.snoc([[h.key] h.val]))
       |  > i=nat 0  > todo=row[[p=path q=axal[uon[ass]]]] seed  > epic=axal[myth] (axal/new[myth] ($some w))
       ^  res[axal[myth]]
       ?  (eq i todo.len)
          ($known epic)
       =  > h todo.at(i)
       =  > hp p
       =  > sub q
       =  > grown
            =  > ks sub.kid.tap
            |  > j=nat 0  > acc=row[[p=path q=axal[uon[ass]]]] todo
            ?  (eq j ks.len)
               acc
            =  > h2 ks.at(j)
            (_ j.inc acc.snoc([hp.snoc(h2.key) h2.val]))
       ?  (hres ep sub.fil.fall((uon/empty)))
        > ($known u=myth)
          (_ i.inc todo epic.put(hp u))
       (_ i.inc grown epic)
  +  z_at
    '  Internal z snapshot by epoch: every path in p's subtree
    '  with a known record, at its pith relative to p.  Unknown
    '  unless p is a node at ep.
    \  ep=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  s.x_at(ep pax)
     > $null  $unknown
     > $unknown  $unknown
     > ($known w=myth)
       =  > es s.idx.dip(pax).tap
       |  > i=nat 0  > epic=axal[myth] (axal/new[myth] $none)
       ^  res[axal[myth]]
       ?  (eq i es.len)
          ($known epic)
       =  > h es.at(i)
       ?  (hres ep q)
        > ($known u=myth)
          (_ i.inc epic.put(p u))
       (_ i.inc epic)
  +  x_query
    '  Resolve an exact path-local x data case.  Local cases are
    '  dense; zero or an unminted/future case is a shrug.
    \  c=nat pax=path s=sov
    ^  res[myth]
    ?  (track_case c s.ever_at(pax).x)
     > $none  $unknown
     > ($some ep=nat)  s.x_at(ep pax)
  +  y_query
    '  Resolve an exact path-local y data case.
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  (track_case c s.ever_at(pax).y)
     > $none  $unknown
     > ($some ep=nat)  s.y_at(ep pax)
  +  z_query
    '  Resolve an exact path-local z data case.
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  (track_case c s.ever_at(pax).z)
     > $none  $unknown
     > ($some ep=nat)  s.z_at(ep pax)
  +  x_latest
    \  pax=path s=sov
    ^  res[myth]
    s.x_at(s.top pax)
  +  y_latest
    \  pax=path s=sov
    ^  res[axal[myth]]
    s.y_at(s.top pax)
  +  z_latest
    \  pax=path s=sov
    ^  res[axal[myth]]
    s.z_at(s.top pax)
  +  apply
    '  Apply an already-normalized diff tree at the next epoch.  raw
    '  is journaled verbatim while diffs drives assertion changes.
    \  diffs=axal[note] raw=axal[note] now=nat block=nat s=sov
    ^  [state=sov signs=axal[sign]]
    =  > ep s.top.inc
    =  > ck ($u ep)
    =  > r
         |  > dif=axal[note] diffs
            > zin=axal/zip[uon[ass]] s.idx.zipper
            > pax=path []
            > cin=axal[ever] s.cases
         ^  [z=axal/zip[uon[ass]] n=axal[sign] yc=nat sub=nat cv=axal[ever]]
         =  > me (_)
         =  > kids dif.kid.tap
         =  > kr
              |  > i=nat 0
                 > zz=axal/zip[uon[ass]] zin
                 > kn=uon[axal[sign]] (uon/empty)
                 > ky=nat 0
                 > kz2=nat 0
                 > cc=axal[ever] cin
              ^  [rz=axal/zip[uon[ass]] rn=uon[axal[sign]] ry=nat rz2=nat rc=axal[ever]]
              ?  (eq i kids.len)
                 [zz kn ky kz2 cc]
              =  > h kids.at(i)
              =  > cw (me h.val zz.down(h.key) pax.snoc(h.key) cc)
              =  > kn2
                   ?  sub
                      kn.put(h.key n)
                   kn
              (_ i.inc z.up kn2 (nmax ky yc) (nmax kz2 sub) cv)
         ?  dif.fil
          > $none
            =  > oldh rz.focus.fil.fall((uon/empty))
            =  > oldr (hres s.top oldh)
            '  A transparent spine carries child grades upward but
            '  never acquires a ledger, assertion, timestamp, or sign.
            ?  (eq 0 oldh.size)
               [rz (axal[sign] $none rn) ry rz2 rc]
            =  > oldev rc.gut(pax (ever0 0))
            =  > nev (ever_mint 0 ry rz2 ep oldev)
            =  > cv2
                 ?  (add ry rz2)
                    rc.put(pax nev)
                 rc
            =  > nfil
                 ?  (add ry rz2)
                    ($some (sign 0 ry rz2))
                 $none
            =  > nax (axal[sign] nfil rn)
            =  > zed
                 ?  rz2
                    =  > yg (yuga_of nev now block)
                    ?  (spine_mint yg ck s.top oldh)
                     > $none  rz
                     > ($some nh=uon[ass])
                       rz.set_focus(rz.focus.set_fil(($some nh)))
                 rz
            =  > ycon
                 ?  oldr
                  > ($known w=myth)  0
                 ry
            [zed nax ycon rz2 cv2]
          > ($some a=note)
            =  > oldh rz.focus.fil.fall((uon/empty))
            =  > oldr (hres s.top oldh)
            =  > nr
                 ^  res[myth]
                 ?  a
                  > m=note/make  ($known m.myth)
                  > p=note/poke
                    ?  oldr
                     > ($known om=myth)  ($known om.meld(p.myth))
                    ($known p.myth)
                  > note/cull  $null
            =  > oldk (res_live oldr)
            =  > nk (res_live nr)
            =  > g0
                 ?  (res_equal oldr nr)
                    0
                 ?  (eq oldk nk)
                    1
                 2
            =  > ny (nmax g0 ry)
            =  > nz (nmax g0 rz2)
            =  > changed (add g0 (add ry rz2))
            =  > oldev rc.gut(pax (ever0 0))
            =  > nev (ever_mint g0 ny nz ep oldev)
            =  > cv2
                 ?  changed
                    rc.put(pax nev)
                 rc
            =  > yg (yuga_of nev now block)
            =  > zed
                 ?  changed
                    =  > na
                         ^  ass
                         ?  nr
                          > ($known m2=myth)
                            ($ker (saga (aeon yg (oath 0 0)) m2))
                          > $null  ($nul (aeon yg (oath 0 0)))
                         ($nul (aeon yg (oath 0 0)))
                    rz.set_focus(rz.focus.set_fil(($some oldh.put(ck na))))
                 rz
            =  > nfil
                 ?  changed
                    ($some (sign g0 ny nz))
                 $none
            =  > nax (axal[sign] nfil rn)
            =  > ycon
                 ?  nk
                    g0
                 (nmax g0 ry)
            [zed nax ycon nz cv2]
    =  > st (sov s.rec.put(ck raw) z.top ep cv)
    [st n]
  +  step
    '  Commit the next sovereign epoch from a tree of raw diffs: the new
    '  plus a tree of notifications grading each (care, path) whose
    '  local case moved (see /sign).  One lockstep walk over the diff
    '  tree carries both epoch-history and local-clock edits; signs build on the
    '  unwind — zipping up is the envelope propagation (an assertion
    '  moves its own x; descendant grades pass transparently through
    '  structural spines to asserted ancestors — y is a frontier care;
    '  every asserted ancestor's z moves; creations and removals grade
    '  2).  Transparent paths mint nothing.  Equal resolved writes are
    '  discarded before propagation.  Epochs remain global; every nonzero grade bumps
    '  exactly one path-local data counter, and grade 2 also bumps its
    '  independent shape counter.  now is apollo time and block the
    '  PKI blockheight, recorded only on real versions.
    \  diffs=axal[note] now=nat block=nat s=sov
    ^  verdict[[state=sov signs=axal[sign]]]
    =  > raw diffs
    =  > eff (prepare raw s.top s.idx)
    ?  (writes_valid eff s.top s.idx)
       ($accepted s.apply(eff raw now block))
    ($rejected 'tombstoned_ancestor)
