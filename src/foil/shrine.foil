-  sept
-  shrine_types
+  ass
  '  An assertion: a committed version (/saga, from shrine_types),
  '  or a tombstone.
  &  ($ker saga)
     $nul
+  res
  '  A resolution result.  $null is a tombstone answer; $unknown is
  '  the absence of any answer.  Never collapse the two: a shrug is
  '  not a tombstone.
  (@@ v)
  &  ($known v)
     $null
     $unknown
+  sign
  '  Per-care change grade for one path: 0 unchanged, 1 data moved,
  '  2 data and shape moved (a creation or removal; shape implies
  '  data within one commit).
  :  x=nat y=nat z=nat
+  nmax
  \  a=nat b=nat
  ^  nat
  ?  (lt a b)
     b
  a
+  mmax
  '  Max of two optional cases.
  \  b=maybe[nat] a=maybe[nat]
  ^  maybe[nat]
  ?  a
   > $none  b
   > ($some x=nat)
     ?  b
      > $none  a
      > ($some y=nat)
        ?  (lt x y)
           b
        a
+  hcase
  '  The greatest minted case at or below c in one history — data
  '  moves, version re-mints and tombstones alike.  Every mint means
  '  something moved in the node's subtree, so this is exactly one
  '  history's z contribution.
  \  c=nat h=uon[ass]
  ^  maybe[nat]
  ?  h.floor(($u c))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ($some (quip_val k))
+  hsag
  '  The live committed version at cur, if any.
  \  c=nat h=uon[ass]
  ^  maybe[saga]
  ?  h.floor(($u c))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($some g)
      > $nul  $none
+  hres
  '  Resolution within one path history: the record at cur, a
  '  tombstone, or unknown.
  \  c=nat h=uon[ass]
  ^  res[myth]
  ?  h.floor(($u c))
   > $none  $unknown
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($known g.myth)
      > $nul  $null
+  hx
  '  The case the node's own data last moved, at or below c: a live
  '  version carries it (the x data lock); a tombstone is its mint
  '  case.
  \  c=nat h=uon[ass]
  ^  maybe[nat]
  ?  h.floor(($u c))
   > $none  $none
   > ($some e=[k=quip val=ass])
     ?  val
      > ($ker g=saga)  ($some g.aeon.yuga.x.data)
      > $nul  ($some (quip_val k))
+  hy
  '  The cached y case at cur — live versions only (tombstones and
  '  absent floors fall back to the caller's scan).
  \  c=nat h=uon[ass]
  ^  maybe[nat]
  ?  (hsag c h)
   > ($some g=saga)  ($some g.aeon.yuga.y.data)
   > $none  $none
+  hz
  '  The cached z case at cur — live versions only.
  \  c=nat h=uon[ass]
  ^  maybe[nat]
  ?  (hsag c h)
   > ($some g=saga)  ($some g.aeon.yuga.z.data)
   > $none  $none
+  lock_mint
  '  Move a lock for one grade at case c: data moves on any grade,
  '  shape only on a shape move (grade 2).
  \  g=nat c=nat old=lock
  ^  lock
  ?  (eq 0 g)
     old
  ?  (eq 2 g)
     (lock c c)
  (lock c old.shape)
+  yuga0
  '  The versioning of a never-minted node; the argument is ignored.
  \  x=nat
  ^  yuga
  (yuga (lock 0 0) (lock 0 0) (lock 0 0) 0 0)
+  yuga_mint
  '  Adjust versioning for one mint: g0 grades the node's own move,
  '  ry the direct kids', rz the subtree's.
  \  g0=nat ry=nat rz=nat c=nat now=nat block=nat old=yuga
  ^  yuga
  =  > nx (lock_mint g0 c old.x)
  =  > ny (lock_mint (nmax g0 ry) c old.y)
  =  > nz (lock_mint (nmax g0 rz) c old.z)
  (yuga nx ny nz now block)
+  spine_mint
  '  A version-only re-mint of a live node whose subtree moved: the
  '  record rides unchanged, the y and z locks advance.  $none when
  '  the path is not a live node (nothing to adjust).
  \  ry=nat rz=nat ck=quip c=nat now=nat block=nat top=nat h=uon[ass]
  ^  maybe[uon[ass]]
  ?  (hsag top h)
   > $none  $none
   > ($some og=saga)
     =  > ng (yuga_mint 0 ry rz c now block og.aeon.yuga)
     ($some h.put(ck ($ker (saga (aeon ng (oath 0 0)) og.myth))))
+  sov
  '  The versioned namespace of one czar.  rec is the raw record:
  '  case -> the diffs minted at that case, verbatim.  idx is its
  '  transpose, the resolution index: path -> case history of
  '  committed versions.  top is the latest minted case; case 0 is
  '  reserved (nothing minted).  Cases are nats in this API and ride
  '  the uons as u-aura quips.
  :  rec=uon[axal[note]] idx=axal[uon[ass]] top=nat
  +  new
    '  The empty sovereign.  The argument is ignored.
    \  x=nat
    ^  sov
    (sov (uon/empty) (axal/new[uon[ass]] $none) 0)
  +  hist
    '  The case history recorded at a path (empty if never asserted).
    \  pax=path s=sov
    ^  uon[ass]
    s.idx.gut(pax (uon/empty))
  +  x_case
    '  cur(c, p): the case at or below c when the node's own data
    '  last moved.  A case beyond top is a shrug ($none), never a
    '  guess — answers at minted cases are eternal.
    \  c=nat pax=path s=sov
    ^  maybe[nat]
    ?  (gt c s.top)
       $none
    (hx c s.hist(pax))
  +  x_query
    '  The value at (c, p): the record at cur, a tombstone, or
    '  unknown if nothing was ever asserted at or below c — or if c
    '  is beyond top (the future is a shrug, so a given (case, path)
    '  answer never changes once given).
    \  c=nat pax=path s=sov
    ^  res[myth]
    ?  (gt c s.top)
       $unknown
    (hres c s.hist(pax))
  +  y_case
    '  The latest case at or below c moving p or a direct kid.
    '  Tombstones count: a nul at a kid moves the parent's y.  A
    '  live committed version answers from its y lock; otherwise
    '  the answer is recomputed from the kid histories.
    \  c=nat pax=path s=sov
    ^  maybe[nat]
    ?  (gt c s.top)
       $none
    ?  (hy c s.hist(pax))
     > ($some n=nat)  ($some n)
     > $none
       =  > kids s.idx.dip(pax).kid.tap
       |  > i=nat 0  > best=maybe[nat] (hx c s.hist(pax))
       ?  (eq i kids.len)
          best
       =  > h kids.at(i)
       (_ i.inc (mmax (hx c h.val.fil.fall((uon/empty))) best))
  +  y_query
    '  The epic at (c, p) one level deep: p's record at [] plus each
    '  direct kid with a known record at [kid].  Unknown unless p is
    '  a node at c; tombstoned and unknown kids are absent from the
    '  domain.
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  s.x_query(c pax)
     > $null  $unknown
     > $unknown  $unknown
     > ($known w=myth)
       =  > kids s.idx.dip(pax).kid.tap
       |  > i=nat 0  > epic=axal[myth] (axal/new[myth] ($some w))
       ^  res[axal[myth]]
       ?  (eq i kids.len)
          ($known epic)
       =  > h kids.at(i)
       ?  (hres c h.val.fil.fall((uon/empty)))
        > ($known u=myth)
          =  > kp [h.key]
          (_ i.inc epic.put(kp u))
       (_ i.inc epic)
  +  z_case
    '  The latest case at or below c moving anything in p's subtree.
    '  A live committed version answers from its z lock; otherwise
    '  the answer is recomputed from the subtree histories (mint
    '  cases are exactly subtree moves).
    \  c=nat pax=path s=sov
    ^  maybe[nat]
    ?  (gt c s.top)
       $none
    ?  (hz c s.hist(pax))
     > ($some n=nat)  ($some n)
     > $none
       =  > es s.idx.dip(pax).tap
       |  > i=nat 0  > best=maybe[nat] $none
       ?  (eq i es.len)
          best
       =  > h es.at(i)
       (_ i.inc (mmax (hcase c q) best))
  +  z_query
    '  The epic at (c, p) to full depth: every path in p's subtree
    '  with a known record, at its pith relative to p.  Unknown
    '  unless p is a node at c.
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    ?  s.x_query(c pax)
     > $null  $unknown
     > $unknown  $unknown
     > ($known w=myth)
       =  > es s.idx.dip(pax).tap
       |  > i=nat 0  > epic=axal[myth] (axal/new[myth] $none)
       ^  res[axal[myth]]
       ?  (eq i es.len)
          ($known epic)
       =  > h es.at(i)
       ?  (hres c q)
        > ($known u=myth)
          (_ i.inc epic.put(p u))
       (_ i.inc epic)
  +  step
    '  Mint the next case from a tree of diffs: the new sovereign,
    '  plus a tree of notifications grading each (care, path) whose
    '  case moved (see /sign).  One lockstep walk over the diff tree:
    '  a zipper carries the index edits, and the signs build on the
    '  unwind — zipping up is the envelope propagation (an assertion
    '  moves its own x, its own and its parent's y, and every
    '  ancestor's z; creations and removals grade 2).  The same walk
    '  adjusts the versioning: an asserted node's saga carries fresh
    '  locks, a poke melds into the committed record, and every live
    '  ancestor re-mints with its y and z locks advanced — so the
    '  case queries above are floor lookups.  now is apollo time and
    '  block the PKI blockheight, recorded on every version minted.
    \  diffs=axal[note] now=nat block=nat s=sov
    ^  [state=sov signs=axal[sign]]
    =  > c s.top.inc
    =  > ck ($u c)
    =  > r
         |  > dif=axal[note] diffs  > zin=axal/zip[uon[ass]] s.idx.zipper
         ^  [z=axal/zip[uon[ass]] n=axal[sign] own=nat sub=nat]
         =  > me (_)
         =  > kids dif.kid.tap
         =  > kr
              |  > i=nat 0  > zz=axal/zip[uon[ass]] zin  > kn=uon[axal[sign]] (uon/empty)  > ky=nat 0  > kz2=nat 0
              ^  [rz=axal/zip[uon[ass]] rn=uon[axal[sign]] ry=nat rz2=nat]
              ?  (eq i kids.len)
                 [zz kn ky kz2]
              =  > h kids.at(i)
              =  > cw (me h.val zz.down(h.key))
              =  > kn2
                   ?  sub
                      kn.put(h.key n)
                   kn
              (_ i.inc z.up kn2 (nmax ky own) (nmax kz2 sub))
         ?  dif.fil
          > $none
            =  > nfil
                 ?  (add ry rz2)
                    ($some (sign 0 ry rz2))
                 $none
            =  > nax (axal[sign] nfil rn)
            =  > oldh rz.focus.fil.fall((uon/empty))
            =  > zed
                 ?  rz2
                    ?  (spine_mint ry rz2 ck c now block s.top oldh)
                     > $none  rz
                     > ($some nh=uon[ass])
                       rz.set_focus(rz.focus.set_fil(($some nh)))
                 rz
            [zed nax 0 rz2]
          > ($some a=note)
            =  > oldh rz.focus.fil.fall((uon/empty))
            =  > og
                 ?  (hsag s.top oldh)
                  > ($some g=saga)  g
                 (saga (aeon (yuga0 0) (oath 0 0)) (myth/new 0))
            =  > oldk
                 ?  (hres s.top oldh)
                  > ($known w=myth)  1
                 0
            =  > slot
                 ^  [nm=maybe[myth] nk=nat]
                 ?  a
                  > m=note/make  [($some m.myth) 1]
                  > p=note/poke
                    =  > cm og.myth
                    =  > mm
                         ?  oldk
                            cm.meld(p.myth)
                         p.myth
                    [($some mm) 1]
                  > note/cull  [$none 0]
            =  > g0
                 ?  (eq oldk nk)
                    1
                 2
            =  > na
                 ^  ass
                 ?  nm
                  > ($some m2=myth)
                    =  > ng (yuga_mint g0 ry rz2 c now block og.aeon.yuga)
                    ($ker (saga (aeon ng (oath 0 0)) m2))
                  > $none  $nul
            =  > zed rz.set_focus(rz.focus.set_fil(($some oldh.put(ck na))))
            =  > ny (nmax g0 ry)
            =  > nz (nmax g0 rz2)
            =  > nax (axal[sign] ($some (sign g0 ny nz)) rn)
            [zed nax g0 nz]
    =  > st (sov s.rec.put(ck diffs) z.top c)
    [st n]
