-  sept [order=10]
-  shrine_types [order=20]
+  ass
  '  An assertion: a committed version (/saga, from shrine_types),
  '  or a tombstone.  Tombstones carry their versioning too: a
  '  removal is a version like any other.  Recursive cull ensures a
  '  dead node has no live descendants; revival continues its
  '  existing locks.
  &  ass/ker
     ass/nul

  +  ker
    :  saga=saga

  +  nul
    :  aeon=aeon

  +  at
    '  The assertion at cur, if any.
    \  cur=nat h=uon[ass]
    ^  maybe[ass]
    <  hit  h.floor(($u cur))
    =  [_ found]  hit
    |  ./some found

  +  saga
    '  The live committed version at cur, if any.
    \  cur=nat h=uon[ass]
    ^  maybe[saga]
    <  a  (ass/at cur h)
    ?  a
     > (./ker g)  (./some g)
    .none

  +  yuga
    '  The versioning at cur, live or dead: every assertion carries
    '  an aeon, so the floor's yuga answers uniformly.
    \  cur=nat h=uon[ass]
    ^  maybe[yuga]
    <  a  (ass/at cur h)
    ?  a
     > (./ker g)  (./some g.aeon.yuga)
     > (./nul e)  (./some e.yuga)

  +  held
    '  The record at cur as the history holds it: pinned, so a
    '  record that rides unchanged into a new version keeps its pin.
    \  cur=nat h=uon[ass]
    ^  res[pin[myth]]
    >  (./some a) (ass/at cur h)
       .unknown
    ?  a
     > (./ker g)  (./known g.myth)
     > (./nul _)  .null

  +  res
    '  Resolution within one path history: the record at cur, a
    '  tombstone, or unknown.
    \  cur=nat h=uon[ass]
    ^  res[myth]
    |  (ass/held cur h).run
    \  p (unpin p)

  +  next
    '  The assertion that carries a record into a new version: a
    '  live record under the header, a tombstone under it, nothing
    '  for an unknown.  The pin rides as given, so a version-only
    '  re-mint shares the old one verbatim.
    \  yg=yuga r=res[pin[myth]]
    ^  maybe[ass]
    ?  r
     > (./known p)  (./some (./ker (saga (aeon/unsigned yg) p)))
     > .null        (./some (./nul (aeon/unsigned yg)))
     > .unknown     .none

+  verdict
  '  A namespace transition either commits one epoch or is rejected
  '  before any journal, assertion, case, or sign is created.
  (@@ v)
  &  verdict/accepted[v]
     verdict/rejected

  +  accepted
    :  value=v

  +  rejected
    :  reason=iota

+  nmax
  \  a=nat b=nat
  ^  nat
  ?  (lt a b)  b
  a

+  graded
  '  Did any of three grades move?
  \  a=nat b=nat c=nat
  ^  bool
  |  gt (nmax a (nmax b c)) 0

+  track
  '  Members over one local care history (the type is shrine_types').

  +  new
    '  A never-minted care history.
    ^  track
    |  track (lock 0 0) (uon/empty)

  +  case
    '  The current data case, if one has minted.
    \  tr=track
    ^  maybe[nat]
    ?  (eq 0 tr.lock.data)  .none
    |  ./some tr.lock.data

  +  mint
    '  Advance one local care clock at sovereign epoch ep.  A shape
    '  grade advances both independent counters; every nonzero grade
    '  appends one dense data-case to epoch entry.
    \  g=nat ep=nat old=track
    ^  track
    ?  (eq 0 g)  old
    =  nd  old.lock.data.inc
       ns
         ?  (eq 2 g)  old.lock.shape.inc
         old.lock.shape
    |  track (lock nd ns) old.epochs.put(($u nd) ep)

  +  epoch
    '  Resolve an exact local data case to its sovereign epoch.
    \  c=nat tr=track
    ^  maybe[nat]
    ?  (eq 0 c)  .none
    tr.epochs.get(($u c))

+  ever
  '  Members over one path's three care histories.

  +  new
    '  A never-minted path history.
    ^  ever
    |  ever track/new track/new track/new

  +  mint
    \  gx=nat gy=nat gz=nat ep=nat old=ever
    ^  ever
    |  ever (track/mint gx ep old.x)
       (track/mint gy ep old.y)
       (track/mint gz ep old.z)

  +  yuga
    '  Copy the local clocks into one assertion's version header.
    \  ev=ever now=nat block=nat
    ^  yuga
    |  yuga ev.x.lock ev.y.lock ev.z.lock now block

+  aeon
  '  Members over one version header (the type is shrine_types').

  +  unsigned
    '  A header with the zeroed oath: validity lives a layer out.
    \  yg=yuga
    ^  aeon
    |  aeon yg (oath 0 0)

+  tome
  '  One path's assertion history behind a pin: snapshots
  '  re-serialize only paths the event touched, never the rest of
  '  the index.  Same named-row necessity as /chest — and declared
  '  before its first user: value references do not resolve forward.
  :  held=pin[uon[ass]]

  +  hist
    '  The history in an optional tome slot.
    \  m=maybe[tome]
    ^  uon[ass]
    >  (./some tm) m
       (uon/empty)
    |  unpin tm.held

  +  hold
    '  Store one history at a zipper's focus, behind a fresh pin.
    \  h=uon[ass] z=axal/zip[tome]
    ^  axal/zip[tome]
    |  z.set_focus z.focus.set_fil((./some (tome (pin h))))

+  urn
  '  One path's care clocks behind a pin — the cases ledger pays
  '  per touched path, not per known path, on every snapshot.
  :  held=pin[ever]

  +  ever
    '  The clocks in an optional urn slot.
    \  m=maybe[urn]
    ^  ever
    >  (./some u) m
       ever/new
    |  unpin u.held

+  cull
  '  Reading explicit culls out of a raw diff tree.

  +  note
    '  Is this floor entry an explicit cull?
    \  m=maybe[note]
    ^  bool
    >  (./some n) m
       .false
    ?=(.cull n)

  +  cover
    '  Is a strict prefix of pax explicitly culled in raw?
    \  pax=path raw=axal[note]
    ^  bool
    |  pax.unders.any
    \  pre (cull/note raw.get(pre))

+  note
  '  Members over one diff (the type is shrine_types').

  +  write
    '  The record this note leaves over the current one: make
    '  replaces, poke merges into a live record (or creates), cull
    '  tombstones.
    \  cur=res[pin[myth]] n=note
    ^  res[pin[myth]]
    ?  n
     > (./make m)  (./known (pin m))
     > (./poke m)
       ?>  (./known p) cur
           (./known (pin m))
       |  ./known (pin (unpin p).meld(m))
     > .cull  .null

+  gate
  '  The commit gate: normalize a raw diff tree and validate its
  '  live writes before anything mints.

  +  blocked
    '  A live-result write may pass a current tombstone only when
    '  this same effective event revives that exact prefix.
    \  pax=path eff=axal[note] top=nat idx=axal[tome]
    ^  bool
    |  pax.unders.any
    \  pre
    ?  !?=(.null (ass/res top (tome/hist idx.get(pre))))  .false
    >  (./some n) eff.get(pre)
       .true
    ?=(.cull n)

  +  prune
    '  Remove every explicit note strictly below an explicit cull.
    \  raw=axal[note]
    ^  axal[note]
    |  raw.tap.fold (axal/new[note] .none)
    \  acc [p q]
    ?  (cull/cover p raw)  acc
    acc.put(p q)

  +  bury
    '  Add synthesized culls for every currently-live assertion below
    '  bp, including bp itself when it is currently live.
    \  bp=path acc=axal[note] top=nat idx=axal[tome]
    ^  axal[note]
    |  idx.dip(bp).tap.fold acc
    \  out [p q]
    ?  ?=((./known _) (ass/res top (unpin q.held)))
       out.put(bp.weld(p) .cull)
    out

  +  expand
    '  Expand every surviving cull over the current live subtree.
    \  base=axal[note] top=nat idx=axal[tome]
    ^  axal[note]
    |  base.tap.fold base
    \  acc [p q]
    ?  ?=(.cull q)  (gate/bury p acc top idx)
    acc

  +  valid
    '  Are all effective live writes clear of unrevived tombstones?
    '  Culls are exempt: make and poke resolve live, cull does not.
    \  eff=axal[note] top=nat idx=axal[tome]
    ^  bool
    |  eff.tap.all
    \  [p q] (?=(.cull q) || !(gate/blocked p eff top idx))

  +  prepare
    '  Cull dominates every explicit descendant write, then expands
    '  to every currently-live descendant.  The caller validates live
    '  writes and retains raw for audit.
    \  raw=axal[note] top=nat idx=axal[tome]
    ^  axal[note]
    |  gate/expand (gate/prune raw) top idx

+  chest
  '  One epoch's journaled raw diffs behind a pin: immutable once
  '  written, one content-addressed unit forever.  A named row —
  '  recursive generics need path-shaped arguments, and neither a
  '  bare pin[...] spelling nor an alias to one is.
  :  held=pin[axal[note]]

+  lchunk
  '  256 sealed epochs of journal refs behind one pin.
  :  held=pin[row[chest]]

+  ledger
  '  The append-only epoch journal: sealed chunks plus the open
  '  tail.  Write-only in the kernel; epochs address by position
  '  (1-based, matching the epoch each put committed).
  :  sealed=row[lchunk] open=row[chest]

  +  put
    \  c=chest l=ledger
    ^  ledger
    =  grown  l.open.snoc(c)
    ?  (lt grown.len 256)  (ledger l.sealed grown)
    |  ledger l.sealed.snoc((lchunk (pin grown))) []

  +  len
    \  l=ledger
    ^  nat
    |  add (mul 256 l.sealed.len) l.open.len

  +  at
    \  ep=nat l=ledger
    ^  maybe[chest]
    ?  (eq 0 ep)  .none
    =  idx    ep.dec
       chunk  (div ep.dec 256)
    ?  (lt chunk l.sealed.len)
       (./some (unpin l.sealed.at(chunk).held).at((mod idx 256)))
    =  tail  (sub idx (mul 256 l.sealed.len))
    ?  (lt tail l.open.len)  (./some l.open.at(tail))
    .none

+  sov
  '  The versioned namespace of one czar.  rec and idx are keyed by
  '  the sovereign-wide commit epoch; top is the latest epoch and 0
  '  is reserved.  cases is a separate path-indexed ledger of local
  '  x/y/z clocks and their data-case to epoch mappings.
  '
  '  rec journals each epoch's raw diffs behind one pin: the entry
  '  is immutable once written, so snapshots re-serialize only the
  '  epoch spine, never past journals.
  '
  '  Grading, in one place.  An assertion moves its own x.  y is a
  '  frontier care: a live node absorbs its subtree's grades, a
  '  dead or transparent one lets them show through.  Every
  '  asserted ancestor's z moves.  Creations and removals grade 2;
  '  equal resolved writes are discarded before propagation.
  '  Epochs are global; every nonzero grade bumps exactly one
  '  path-local data counter, and grade 2 also bumps its
  '  independent shape counter.  Transparent paths mint nothing:
  '  no ledger, no assertion, no timestamp, no sign.
  :  rec=ledger idx=axal[tome] top=nat cases=axal[urn]

  +  new
    '  The empty sovereign.
    ^  sov
    |  sov (ledger [] []) (axal/new[tome] .none) 0
       (axal/new[urn] .none)

  +  kids
    '  Immediate children of a subtree as (extended path, subtree)
    '  pairs.
    \  at=path sub=axal[tome]
    ^  row[[p=path q=axal[tome]]]
    |  sub.kid_tap.fold []
    \  acc [k v] acc.snoc([at.snoc(k) v])

  +  mint
    '  Grade bookkeeping for one visited node: mint the local clocks,
    '  thread the case ledger, and cut a sign, once its own grade and
    '  its children's contributions are known.
    \  g=nat fy=nat fz=nat ep=nat now=nat block=nat
       pax=path cv=axal[urn]
    ^  [cv2=axal[urn] sg=maybe[sign] yg=yuga]
    =  ny    (nmax g fy)
       nz    (nmax g fz)
       nev   (ever/mint g ny nz ep (urn/ever cv.get(pax)))
    ?  (graded g fy fz)
       [cv.put(pax (urn (pin nev)))
        (./some (sign g ny nz))
        (ever/yuga nev now block)]
    [cv .none (ever/yuga nev now block)]

  +  hist
    '  The epoch-keyed assertion history recorded at a path.
    \  pax=path s=sov
    ^  uon[ass]
    |  tome/hist s.idx.get(pax)

  +  ever_at
    '  The local clocks at a path, zeroed when it owns no ledger.
    \  pax=path s=sov
    ^  ever
    |  urn/ever s.cases.get(pax)

  +  x_case
    \  pax=path s=sov
    ^  maybe[nat]
    |  track/case s.ever_at(pax).x

  +  y_case
    \  pax=path s=sov
    ^  maybe[nat]
    |  track/case s.ever_at(pax).y

  +  z_case
    \  pax=path s=sov
    ^  maybe[nat]
    |  track/case s.ever_at(pax).z

  +  x_at
    '  Internal snapshot read by sovereign epoch.
    \  ep=nat pax=path s=sov
    ^  res[myth]
    ?  (gt ep s.top)  .unknown
    |  ass/res ep s.hist(pax)

  +  y_at
    '  Internal y snapshot by epoch: p's record at [] plus its
    '  frontier: each nearest descendant with a known record, at
    '  its full relative pith; transparent and tombstoned paths
    '  pass through.  Unknown unless p is a node at ep.
    \  ep=nat pax=path s=sov
    ^  res[axal[myth]]

    >  (./known w) s.x_at(ep pax)
       .unknown

    %  todo=row[[p=path q=axal[tome]]] (sov/kids [] s.idx.dip(pax))
       epic=axal[myth] (axal/new[myth] (./some w))
    ^  res[axal[myth]]

    >  (./some hit) todo.pull
       (./known epic)

    =  [kid rest]  hit
       [at sub]    kid

    ?  (ass/res ep (tome/hist sub.fil))
     > (./known u)  (_ rest epic.put(at u))
    |  _ rest.weld((sov/kids at sub)) epic

  +  z_at
    '  Internal z snapshot by epoch: every path in p's subtree with
    '  a known record, at its pith relative to p.  Unknown unless p
    '  is a node at ep.
    \  ep=nat pax=path s=sov
    ^  res[axal[myth]]

    >  (./known w) s.x_at(ep pax)
       .unknown

    |  ./known
    |  s.idx.dip(pax).tap.fold (axal/new[myth] .none)
    \  acc [p q]
    >  (./known u) (ass/res ep (unpin q.held))
       acc
    acc.put(p u)

  +  x_query
    '  Resolve an exact path-local x data case.  Local cases are
    '  dense; zero or an unminted case is a shrug.
    \  c=nat pax=path s=sov
    ^  res[myth]
    >  (./some ep) (track/epoch c s.ever_at(pax).x)
       .unknown
    s.x_at(ep pax)

  +  y_query
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    >  (./some ep) (track/epoch c s.ever_at(pax).y)
       .unknown
    s.y_at(ep pax)

  +  z_query
    \  c=nat pax=path s=sov
    ^  res[axal[myth]]
    >  (./some ep) (track/epoch c s.ever_at(pax).z)
       .unknown
    s.z_at(ep pax)

  +  x_latest
    \  pax=path s=sov
    ^  res[myth]
    s.x_at(s.top pax)

  +  y_latest
    \  pax=path s=sov
    ^  res[axal[myth]]
    s.y_at(s.top pax)

  +  z_latest
    \  pax=path s=sov
    ^  res[axal[myth]]
    s.z_at(s.top pax)

  +  grade
    '  The change between the record a node holds and its next:
    '  0 unchanged, 1 data moved, 2 shape moved (a creation or a
    '  removal: live on one side only).
    \  was=res[pin[myth]] will=res[pin[myth]]
    ^  nat
    ?  (res/same was will)  0
    ?  (eq ?=((./known _) was) ?=((./known _) will))  1
    2

  +  lift
    '  A finished subtree, its sparse signs, the grades it passes
    '  to its parent, and the case ledger threaded through the walk.
    :  tree=axal[tome] signs=axal[sign] pass_y=nat pass_z=nat
       cases=axal[urn]

  +  brood
    '  The children folded into their parent, before its own change.
    '  tree starts with the old parent and keeps its untouched children;
    '  kids collects only the sign subtrees produced by this commit.
    :  tree=axal[tome] kids=bee[axal/k[sign]] child_y=nat child_z=nat
       cases=axal[urn]

    +  add
      '  Reattach one child and collect the grades it passes upward.
      '  A zero z grade means nothing moved anywhere in that subtree,
      '  so it contributes no signs.  Siblings combine by maximum.
      \ key=iota kid=sov/lift b=sov/brood
      ^ sov/brood
      = tree | b.tree.set_kid b.tree.kid_put(key kid.tree)
        kids
          ? | eq 0 kid.pass_z
           b.kids
          | b.kids.put key
          | axal/k[sign] | pin kid.signs
      | sov/brood tree kids
        (nmax b.child_y kid.pass_y)
        (nmax b.child_z kid.pass_z)
        kid.cases

  +  finish
    '  Apply one node's note after its children have settled.
    '  Their grades may advance this node's clocks even without a
    '  note of its own; a path with no history and no note stays silent.
    \  ep=nat now=nat block=nat pax=path change=maybe[note] b=sov/brood
    ^  sov/lift
    =  hist | tome/hist b.tree.fil

    '  A transparent path only relays its children's grades.
    =  transparent
         > .none change
           .false
         | eq 0 hist.size
    ?  transparent
      | sov/lift b.tree (axal[sign] .none b.kids)
        b.child_y
        b.child_z
        b.cases

    '  Resolve the local write against the previous epoch, then mint
    '  with both its own change and the contributions from below.
    =  was | ass/held ep.dec hist
       will
         > (./some note) change
           was
         note.write(was)
       own | sov/grade was will
       [cases sign header]
         | sov/mint own b.child_y b.child_z ep now block pax b.cases
       '  Store a fresh assertion only when minting produced a sign.
       tree
         > (./some _) sign
           b.tree
         > (./some next) (ass/next header will)
           b.tree
         | b.tree.set_fil
         | ./some
         | tome
         | pin
         hist.put(($u ep) next)

    '  Mint with the children's contributions, then absorb y at a
    '  live frontier.  Dead nodes pass y through; z always passes.
    =  pass_y
         ? ?=((./known _) will)
           own
         | nmax own b.child_y
    | sov/lift tree (axal[sign] sign b.kids)
      pass_y
      (nmax own b.child_z)
      cases

  +  walk
    '  Settle the changed children, then finish their parent.
    '  dif selects the branches to visit; tree supplies their history.
    '  Each child returns the case ledger for the next sibling to use,
    '  and the completed brood supplies the parent's incoming grades.
    \ ep=nat now=nat block=nat dif=axal[note]
      tree=axal[tome] pax=path cases=axal[urn]
    ^ sov/lift
    = me (_ ep now block)
      seed | sov/brood tree (bee/leaf[axal/k[sign]] []) 0 0 cases
    | sov/finish ep now block pax dif.fil
    | dif.kid_tap.fold seed
    \ b [key sub]
    | b.add key
    | me sub b.tree.kid_gut(key) pax.snoc(key) b.cases

  +  apply
    '  Apply normalized changes at the next epoch; journal raw verbatim.
    '  The walk rebuilds the index and local cases together.  Commit
    '  those alongside the raw journal, and return its sparse signs.
    \ diffs=axal[note] raw=axal[note] now=nat block=nat s=sov
    ^ [state=sov signs=axal[sign]]
    = ep s.top.inc
      done | sov/walk ep now block diffs s.idx [] s.cases
      state
        | sov s.rec.put((chest (pin raw))) done.tree ep done.cases
    [state done.signs]

  +  step
    ' Commit the next sovereign epoch from a tree of raw diffs:
    ' the new state plus a tree of notifications grading each
    ' (care, path) whose local case moved (see /sign, and the
    ' grading note on /sov).  now is apollo time and block the
    ' PKI blockheight, recorded only on real versions.
    \ diffs=axal[note] now=nat block=nat s=sov
    ^ verdict[[state=sov signs=axal[sign]]]
    = eff  | gate/prepare diffs s.top s.idx
    ? | gate/valid eff s.top s.idx
     | ./accepted s.apply(eff diffs now block)
    | ./rejected 'tombstoned_ancestor
