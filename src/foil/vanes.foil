- namespace

'  Services speak in records and writs. For example, fetch/take sees a
'  new request child and marks it fresh on the driver's record. The
'  mark lets a worker notice the request; updating the mark itself does
'  no network I/O. For the inbound path compare http here with
'  http_foot in stdlib/runtime.foil, which owns the socket.
'
'  For application installation start at mani, pact/card, and
'  pact/init. The card carries a manifest; init expands its seeds and
'  behaviors into writes beneath the mount root. A seed at the root
'  pokes the existing mount card so its manifest and behavior survive.

' --- chore ---

'  chore: the general async-task driver vocabulary.  A chore is a
'  computation run off the coordinator's event loop: a request record
'  MADE under a chore driver's /io name selects a boot-registered
'  family by iota; the host worker plans jobs, runs each in a leaf
'  actor, writes the family's results back through the cmd vocabulary
'  below, and pokes a completion record onto the request node.
+  chore
  +  req
    '  A chore request as a namespace record: just the family
    '  selector.  Families layer their own argument slots on top.
    \  fam=iota
    ^  myth
    =  t  myth/new
    t.put(['fam] (pails/q fam))
  +  cfg
    '  The record for a chore driver node: the shared driver inbox
    '  kook, plus the family requests default to when they carry no
    '  ['fam] of their own.
    \  fam=iota
    ^  myth
    =  t1  (kooked [(runtime_context/service ['kook 'dtake])])
    t1.put(['fam] (pails/q fam))
  +  fam_of
    '  A record's family: its own ['fam], else the default.
    \  dflt=iota t=myth
    ^  iota
    ?  t.quip_at(['fam])
     > (./some q=iota)  q
     > .none  dflt
  +  done_t
    '  The request node's completion record.
    \  passed=nat failed=nat
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['res_done] (pd 1))
    =  t3  t2.put(['passed] (pd passed))
    t3.put(['failed] (pd failed))
  +  fail_t
    '  The completion record for a request the driver could not run
    '  (unknown family, plan failure).
    \  e=iota
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['res_done] (pd 1))
    =  t3  t2.put(['res_ok] (pd 0))
    t3.put(['res_err] (pails/q e))
  +  clear_t
    '  The driver-record poke clearing a request kid's fresh marker.
    \  kid=iota
    ^  myth
    =  t  myth/new
    t.put(['fresh kid] (pd 0))
  +  cmd
    '  The write vocabulary a finished job returns: what the driver
    '  should write where.  mkp is a make retried as a poke when the
    '  node already exists — the verdict-child idiom.
    &  chore/cmd/mkp
       chore/cmd/make
       chore/cmd/poke

    +  mkp
      :  pax=path t=myth

    +  make
      :  pax=path t=myth

    +  poke
      :  pax=path t=myth

  +  mkp_t
    '  Constructor laws for hosts: a sum member's own entry is not
    '  callable across the FFI, so cmd values are minted here.
    \  pax=path t=myth
    ^  chore/cmd
    (./mkp pax t)
  +  make_t
    \  pax=path t=myth
    ^  chore/cmd
    (./make pax t)
  +  poke_t
    \  pax=path t=myth
    ^  chore/cmd
    (./poke pax t)
  +  cmd_parts
    '  A cmd's write, host-shaped: kind 0 mkp, 1 make, 2 poke — hosts
    '  read the anonymous row positionally instead of guessing at
    '  nominal reps.
    \  c=chore/cmd
    ^  [k=nat pax=path t=myth]
    ?  c
     > (./mkp pax t)  [0 pax t]
     > (./make pax2 t2)  [1 pax2 t2]
     > (./poke pax3 t3)  [2 pax3 t3]

' --- fetch ---

+  fetch
  '  The outbound-HTTP driver vocabulary: requests and their answers
  '  ride as records; the driver record's markers are the worker's
  '  notifications.

  +  take
    '  The driver inbox kook: when a request node appears underneath
    '  (an added direct kid in the gift), mark it fresh on the driver
    '  node itself — helm x-watches each /io name's own record, so
    '  the write IS the worker's notification.  A culled kid clears
    '  its marker (pokes cannot delete slots, so markers are
    '  overwritten to 0, never removed).
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    =  events  gift.tap
    %  idx=nat 0  tale=myth cur
    ?  (eq idx events.len)
       (yell [] tale)
    =  [at act]  events.at(idx)
    ?  (eq 1 at.len)
       ?  ?=(.add act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 1)))
       ?  ?=(.del act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 0)))
       (_ idx.inc tale)
    (_ idx.inc tale)

  +  form
    ^  form
    def_form.set_take(fetch/take)

  +  cfg
    '  The record for an outbound-HTTP driver node: just the fetch
    '  kook — requests carry their own config.
    ^  myth
    (kooked [(runtime_context/service ['kook 'hfetch])])

  +  req
    '  An outbound fetch request as a namespace record: method, url,
    '  body (0 = none) and deadline (ms, required nonzero) ride as
    '  data pails.  Optional slots the driver honors: ['connect]
    '  ['redirects] ['maxbody], plus one ['hdr <name>] per request
    '  header.  The driver answers by poking ['res_done] ['res_ok]
    '  and the res_* payload slots onto the node — the requester's
    '  own kook (or a crew dep on the node) consumes them.
    \  method=nat url=nat body=nat deadline=nat
    ^  myth
    .  (myth/new)
       put(['method] (pd method))
       put(['url] (pd url))
       put(['body] (pd body))
       put(['deadline] (pd deadline))

  +  fresh
    '  The pending request kids marked on a driver record: keys
    '  ['fresh <kid>] whose value is 1.
    \  tale=myth
    ^  path
    =  slots  tale.tap
    %  idx=nat 0  out=path []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
       live
         ?  (eq 2 slot.key.len)
            ?  (eq_iota slot.key.at(0) 'fresh)
               ?  slot.val
                > x=pails/n  x.n
               0
            0
         0
    ?  live
       (_ idx.inc out.snoc(slot.key.at(1)))
    (_ idx.inc out)

  +  hdrs
    '  Request headers from a record: one [name value] per
    '  ['hdr <name>] slot (names unique, order unspecified).
    \  tale=myth
    ^  row[[n=nat v=nat]]
    =  slots  tale.tap
    %  idx=nat 0  out=row[[n=nat v=nat]] []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
    ?  (eq 2 slot.key.len)
       ?  (eq_iota slot.key.at(0) 'hdr)
          =  val
               ?  slot.val
                > x=pails/n  x.n
               0
          (_ idx.inc out.snoc([(quip_val slot.key.at(1)) val]))
       (_ idx.inc out)
    (_ idx.inc out)

  +  res_ok
    '  The response myth the driver pokes onto a request node when
    '  the transfer completed: the final status/url/headers/body plus
    '  the ['res_done] completion marker.
    \  status=nat url=nat headers=nat body=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 1))
       put(['res_status] (pd status))
       put(['res_url] (pd url))
       put(['res_hdrs] (pd headers))
       put(['res_body] (pd body))

  +  res_err
    '  The response myth for a failed fetch: the driver's error code
    '  (0 bad-url, 1 dns, 2 connect, 3 tls, 4 deadline, 5 redirects,
    '  6 too-large, 7 protocol).
    \  code=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 0))
       put(['res_err] (pd code))

' --- fs_sync ---

+ fs
  '  A scan may finish after the user has changed its configuration.
  '  request records the pending work; finish and failed check which
  '  request the response belongs to before updating the record.
  '  fs_foot/scan_requested calls the reader and sends its result back.
  + extensions
    : hands=mop[iota row[path] lt_iota]
  + target_slot
    system_vocabulary/fs/target
  + extensions_slot
    system_vocabulary/fs/extensions
  + destination
    \ rec=myth
    ^ maybe[path]
    | (rec.crew_at(bond/crew)).get(fs/target_slot).run(dep/p)
  + rules
    \ rec=myth
    ^ fs/extensions
    . rec
     get(fs/extensions_slot)
     then(fs/extensions/try_from_pail)
     fall((fs/extensions (mop/empty)))
  + extension
    \ name=str
    ^ str
    = parts | str/split_byte 46 name
    ? (lt parts.len 2) ""
    | parts.at parts.len.dec
  + batch
    : epoch=nat config=myth files=row[fs_read/file]
  + failure
    : epoch=nat config=myth reason=str
  + report
    : epoch=nat target=path known=row[str] missing=row[str]
  + finish
    \ bol=bowl cur=myth scan=fs/batch
    ^ yell
    = epoc | cur.nat_at bond/epoch 0
      root | cur.txt_at bond/from
      pen
        . cur
         get(bond/pending)
         then(pails/b/try_from_pail)
         run(pails/b/b)
         fall(.false)
    ? !(and pen (eq epoc scan.epoch))
     | yell [] cur
    ? !(equal[str] root (scan.config.txt_at(bond/from)))
     | yell [] cur
    ? !(equal (fs/destination cur) (fs/destination scan.config))
     | yell [] cur
    ? !(equal (fs/rules cur) (fs/rules scan.config))
     | yell [] cur
    > (./some target) (fs/destination cur)
      (yell [] cur)
    = rules | fs/rules cur
    = names=row[str] | scan.files.map fs_read/file/name
      prev=row[str]
        > (./some held) (cur.get(bond/res)) []
        > (./some report) (fs/report/try_from_pail held) []
        ? !(equal[path] report.target target) []
        report.known
      lost
        | prev.keep
         \ name=str
         !(row/any[str] (\ item=str (equal[str] name item)) names)
      known | names.weld lost
      view | bol.crew_value(fs/target_slot)
      empty=row[[p=path q=writ]] []
      cards
        | scan.files.fold empty
         \ out=row[[p=path q=writ]] file=fs_read/file
         ^ row[[p=path q=writ]]
         = key=iota ($ta file.name)
           dest | target.snoc key
           hands | rules.hands.gut(($ta (fs/extension file.name)) [])
           rec
             | (kooked hands).put bond/content (pails/n file.bytes)
           old | view.get([key]).fall(myth/new)
         ? | and (equal old.get(bond/content) rec.get(bond/content))
             (equal old.get(bond/limb) rec.get(bond/limb))
          out
         | out.snoc [dest (writ/make rec)]
      out
        . cur
         put(bond/res (fs/report epoc target known lost))
         put(bond/pending (pails/b .false))
    | yell cards out
  + desk  str
  + cfg
    \ des=fs/desk target=path rules=fs/extensions hand=path
    ^ myth
    = out | kooked [hand]
    . out
     put(bond/from (pails/t des))
     put(bond/crew (crew/pail (crew/sing fs/target_slot (dep .y target))))
     put(fs/extensions_slot rules)
     put(bond/epoch (pails/n 0))
     put(bond/pending (pails/b .false))
  + failed
    \ cur=myth failure=fs/failure
    ^ yell
    = pending
        . cur
          get(bond/pending)
          then(pails/b/try_from_pail)
          run(pails/b/b)
          fall(.false)
    ? !pending (yell [] cur)
    = valid
        | and (eq cur.nat_at(bond/epoch 0) failure.epoch)
          (equal (fs/destination cur) (fs/destination failure.config))
    ? !valid (yell [] cur)
    ? !(equal[str] cur.txt_at(bond/from)
        failure.config.txt_at(bond/from)) (yell [] cur)
    ? !(equal (fs/rules cur) (fs/rules failure.config))
      (yell [] cur)
    | yell []
      | cur.put(bond/res failure).put bond/pending (pails/b .false)
  + talk
    \ bol=bowl cur=myth add=myth
    ^ yell
    ? add.get(bond/res)
     > (./some value)
      ? value
       > scan=fs/batch (;/finish bol cur scan)
       > failure=fs/failure (;/failed cur failure)
      (;/request bol cur add)
     > .none (;/request bol cur add)
  + request
    \ bol=bowl cur=myth add=myth
    ^ yell
    | yell []
    = pen
     . add
      get(bond/pending)
      then(pails/b/try_from_pail)
      run(pails/b/b)
      fall(.false)
    = poc
     . cur
      get(bond/epoch)
      then(pails/n/try_from_pail)
      run(pails/n/n)
      fall(0)
    = cur cur.meld(add)
    ? !pen
     cur
    cur.put(bond/epoch (pails/n poc.inc))
  + form
    ^ form
    def_form.set_talk(fs/talk)

' --- http ---

+  http
  '  The inbound-HTTP driver vocabulary: driver configs, request
  '  records, and the behaviors the serving kook installs.

  +  respond_talk
    '  The responder the serving kook installs on a request node: the
    '  installing poke's talk answers 200, echoing the request's body
    '  slot (or its url when there is no body).
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       pay=pail
         ?  out.get(['body])
          > (./some held=pail)  held
          > .none
            ?  out.get(['url])
             > (./some held=pail)  held
             > .none  (pd 0)
       done out.put(['res_status] (pd 200)).put(['res_body] pay)
    (yell [] done)

  +  respond_form
    ^  form
    def_form.set_talk(http/respond_talk)

  +  serve_take
    '  The serving kook for an HTTP driver node: when a request node
    '  appears underneath (an added direct kid in the gift), emit a
    '  poke installing the configured responder kook on it — the same
    '  poke's talk then writes the response, all within the event.
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    >  (./some responder=path) cur.path_at(['serve])
       (yell [] cur)
    =  events  gift.tap
    %  idx=nat 0  cards=row[[p=path q=writ]] []
    ?  (eq idx events.len)
       (yell cards cur)
    =  [at act]  events.at(idx)
    ?  ?=(.add act)
       ?  (eq 1 at.len)
          =  card  (kooked [responder])
          (_ idx.inc cards.snoc([bowl.here.weld(at) (writ/poke card)]))
       (_ idx.inc cards)
    (_ idx.inc cards)

  +  serve_form
    ^  form
    def_form.set_take(http/serve_take)

  + cfg
    ' Service and responder are fully qualified namespace references.
    \ service=path responder=path
    ^ myth
    = config | (kooked [service]).put ['serve] (pails/p responder)
    | config.put ['namespace_root] (pails/p service.take(1))

  + cfg_port
    \ service=path responder=path port=nat
    ^ myth
    | (http/cfg service responder).put ['port] (pd port)

' --- pact ---

'  pact: the application kit — the vocabulary an application uses to
'  describe itself to the namespace, and the mount form that expands
'  a manifest into an app subtree (doc/shrine-apps.md section 5).
+  text
  '  Rendered text: a packed UTF-8 cord.
  str
+  lore
  '  Structured documentation as a value: the one-line head, the body
  '  lines, and the doctests as source/expected pairs.
  :  head=text body=row[text] tests=row[[src=text want=text]]

  +  put
    '  Put lore when present (has truthy): the head at bond/lede as
    '  text, the full lore pail at bond/help.  Absent lore leaves
    '  the myth untouched.
    \  tale=myth has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    ?  has
       tale.put(bond/lede (pails/t head)).put(bond/help (lore head body tests))
    tale

  +  line
    '  One-line lore: the head is the whole body.
    \  head=text
    ^  lore
    | lore head [head] []
+  doctest
  +  verdict
    '  A doctest run's outcome, poked onto the documented node by the
    '  /io/doctest driver: host time, the node's own version at run
    '  time (the staleness anchor — a reader compares it against the
    '  node's current version), and per-test results index-aligned
    '  with the lore's tests.  got carries text only on failure.
    :  when=nat case=nat results=row[[i=nat pass=nat got=nat]]

  +  card
    '  The verdict poke's myth: just the system_vocabulary/dt slot.
    \  when=nat case=nat results=row[[i=nat pass=nat got=nat]]
    ^  myth
    (myth/new).put(system_vocabulary/dt (doctest/verdict when case results))
+  mirror
  '  The publisher's compiler mirror's cards: how the system's own compiled code
  '  appears to itself from inside the namespace.

  +  doc
    '  A documentation-only namespace record.
    \  doc=text
    ^  myth
    (myth/new).put(system_vocabulary/help (pails/t doc))

  +  src
    '  A module file record: the module's source text, plus the
    '  module header's lore when captured.
    \  src=text has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    =  tale  (myth/new).put(bond/src (pails/t src))
    | lore/put tale has head body tests

  +  entry
    '  An entry record: kind and source slice always; lore when
    '  captured; the compiled value only when lowering produced one
    '  (const-generic base members stay unlowered).
    \  code=any kind=text src=text lowered=bool
       has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    =  tale
         .  (myth/new)
            put(['kind] (pails/t kind))
            put(bond/src (pails/t src))
       tale  (lore/put tale has head body tests)
    ?  lowered
       tale.put(system_vocabulary/content (pails/code code))
    tale

  +  extras
    '  Extra mirror slots layered onto an entry record: the reflected
    '  type descriptor, the decompiled law text, and the reference
    '  rows — .none/0/empty means absent.
    \  sig=maybe[type] law=text calls=row[path] callers=row[path] tale=myth
    ^  myth
    =  tale
         ?  sig
          > (./some d)  tale.put(bond/mold (pails/ty d))
          > .none  tale
       tale
         ?  law
            tale.put(['law] (pails/t law))
         tale
       tale
         ?  calls.len
            tale.put(system_vocabulary/calls (pails/ps calls))
         tale
    ?  callers.len
       tale.put(system_vocabulary/called_by (pails/ps callers))
    tale

  +  fail
    '  The card at a module's mirror node when it failed to compile:
    '  [status] "failed" plus the pretty diagnostic text.
    \  err=text
    ^  myth
    .  (myth/new)
       put(['status] (pails/t "failed"))
       put(['err] (pails/t err))

  +  index
    '  A configured compiler namespace index record: the entry nodes grouped under
    '  one source namespace root.
    \  entries=row[path]
    ^  myth
    (myth/new).put(system_vocabulary/entries (pails/ps entries))
+  form
  +  card
    '  A registry record: the form riding in its system_vocabulary/form slot (forms
    '  are nominal rows, so they inhabit pails directly), documented
    '  at bond/lede + bond/help.
    \  =form =lore
    ^  myth
    .  (myth/new)
       put(system_vocabulary/form form)
       put(bond/lede (pails/t lore.head))
       put(bond/help lore)
+  weft_card
  '  A component node's record: an overlay ctor (dyed/knit/felt/sewn,
  '  a nominal row, so it inhabits pails directly) riding at
  '  /sys/weft, a demo data path the zoo renders it against (spell it
  '  app-relative with pact/rel — path pails rebase at mount), and
  '  lede + help lore.  Components are write-once namespace citizens:
  '  mount once, never poke in place — an upgrade mints a FRESH path —
  '  so x case 1 is always the correct function pin for /o and /frag
  '  URLs.
  \  ctor=pail demo=path =lore
  ^  myth
  .  (myth/new)
     put(bond/weft ctor)
     put(['demo] (pails/p demo))
     put(bond/lede (pails/t lore.head))
     put(bond/help lore)
+  kook
  +  decl
    '  One behavior the app provides: its id (one segment under the
    '  app's own kook subtree), its form, its lore.
    :  id=iota =form =lore

+  grant
  '  One driver capability an app asks for (doc/multifile-apps-io-
  '  grants.md part II).  The app ASKS; the host DECIDES; the
  '  decision — not the ask — is what the namespace enforces.  A
  '  manifest's wants row is the ask, the ['grants] slot the mount
  '  writes is the answer, and the helm's move gate reads the answer.
  +  gfetch
    '  Outbound HTTP through the fetch driver at /io/http_client.
    :
  +  gserve
    '  An HTTP listener on a real port of its own.
    :  port=nat
  &  grant/gfetch
     grant/gserve

  +  has_fetch
    '  1 when a wants/grants row carries outbound HTTP, else 0.  Nats,
    '  not bools, because both sides of this value are hosts: the
    '  card slot is a pd and the helm's gate reads it back with
    '  nat_at.
    '  ?=  ((grant/has_fetch []) 0)
    '  ?=  ((grant/has_fetch [.gfetch]) 1)
    \  gs=row[grant]
    ^  nat
    %  i=nat 0
    ?  (eq i gs.len)
       0
    ?  gs.at(i)
     > .gfetch  1
     > (./gserve port)  | _ i.inc

  +  serve_port
    '  The port a wants/grants row asks a listener on, or 0 for none.
    '  ?=  ((grant/serve_port [(./gserve 8099)]) 8099)
    '  ?=  ((grant/serve_port [.gfetch]) 0)
    \  gs=row[grant]
    ^  nat
    %  i=nat 0
    ?  (eq i gs.len)
       0
    ?  gs.at(i)
     > (./gserve port)  port
     > .gfetch  | _ i.inc
+  mani
  '  An application manifest: the app's name, its lore, the behaviors
  '  it provides, the records it seeds, and the driver capabilities
  '  it asks for (wants).  Seed MOUNT paths are app-relative — the
  '  mount form re-roots the whole tree at expansion.  Path VALUES
  '  inside seed records (kook refs, path pails) are absolute unless
  '  "."-headed: pact/rebase_rec welds the mount root onto exactly
  '  those (spell them with pact/rel).
  :  name=iota doc=lore kooks=row[kook/decl] seeds=row[[p=path t=myth]]
     wants=row[grant]

  +  ok
    '  Whether the pail is a mani — the host's mount gate: an app
    '  whose app entry is not a manifest does not mount.
    \  held=pail
    ^  bool
    ?=(m=mani held)

  +  put_seed
    '  One seed unioned into a seed row: a fresh path appends, a
    '  collision melds records with the incoming side winning slot
    '  collisions (myth/meld).
    \  acc=row[[p=path t=myth]] seed=[p=path t=myth]
    ^  row[[p=path t=myth]]
    =  [p t]  seed
    =  same
         \  e=[q=path u=myth]
         ^  bool
         =  [q u]  e
         | eq_pith q p
    ?  acc.any(same)
       =  upd
            \  e=[q=path u=myth]
            ^  [q=path u=myth]
            =  [q u]  e
            ?  (eq_pith q p)
               [q (myth/meld t u)]
            [q u]
       acc.map(upd)
    acc.snoc([p t])

  +  weld_spec
    '  A spec module's mani welded onto an app's code mani: the code
    '  side names the app and brings behavior (kooks); seeds union
    '  per path with spec structure first and code seeds winning
    '  slot collisions; EVERY seed is judged by the yoke
    '  (yoke/adopt), so code-side records adopt their contracts too;
    '  and the asks union (both sides' wants — the host still caps).
    \  y=yoke spec=mani code=mani
    ^  mani
    | mani code.name code.doc
      code.kooks.weld(spec.kooks)
      (yoke/adopt y code.seeds.fold(spec.seeds mani/put_seed))
      code.wants.weld(spec.wants)

  +  adopt_spec
    '  A typing-only spec (no template layer) applied to a code
    '  mani: the seeds adopt whatever the yoke assigns them.
    \  y=yoke code=mani
    ^  mani
    code.set_seeds((yoke/adopt y code.seeds))

+  ward
  '  The generic warden: a node carrying its sub-spec (a yoke at
  '  system_vocabulary/spec) and this behavior stamps every freshly arrived
  '  kid with the contract the spec assigns it — SYNCHRONOUSLY,
  '  because the take cascade runs inside the driving event: a kid
  '  is never observable without its contract.  Absent-only: a kid
  '  that already carries system_vocabulary/lash is never touched, so a
  '  deliberate contract change survives and the cascade drains
  '  (an identical re-poke could not, and does not, happen).

  +  take
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    >  (./some held) cur.get(system_vocabulary/spec)
        | yell [] cur
    ?   held
     >  y=yoke
        =  seg_of
             \  acc=row[iota] e=[p=path m=mode]
             ^  row[iota]
             =  [p m]  e
             ?  (eq 0 p.len)
                acc
             ?  acc.any((\ s (eq_iota s p.at(0))))
                acc
             acc.snoc(p.at(0))
        =  segs  g.tap.fold([] seg_of)
        =  stamp
             \  acc=row[[p=path q=writ]] seg=iota
             ^  row[[p=path q=writ]]
             >  (./some t) b.kids.dip([seg]).fil
                 acc
             ?   ?=((./some _) t.get(system_vocabulary/lash))
                 acc
             >  (./some l) (yoke/at [seg] y)
                 acc
             ?   (equal l lash/new)
                 acc
             acc.snoc([b.here.snoc(seg) (writ/poke (myth/sing system_vocabulary/lash l))])
        | yell segs.fold([] stamp) cur
    | yell [] cur

  +  form
    '  take-only: creation stamping is the whole job.
    ^  form
    def_form.set_take(ward/take)
+  fresh
  '  The live-link refresher: any TOP-LEVEL slot of a record whose
  '  pail is a safe is kept current.  Per safe slot k the crew
  '  carries ['fresh]+k, the target dep (fires when the target
  '  changes), and ['freshv]+k, the target's /h/v version view
  '  (hydrated every activation and independently live). Only a
  '  target notification refreshes the corresponding safe.
  '  hear rewrites a slot only when the target's per-care data case
  '  moved; the ≠-check, the kernel's deep-equal grade-0 discard,
  '  and the cascade fuel bound mutual-embed ping-pong.  Writes
  '  ride hear's own yell state, never a self-poke (the nenex
  '  channel discipline).  Append ['kook 'fresh] LAST in a limb:
  '  talks thread, and this one re-melds add over its cur.

  +  is_slot
    '  Is k one of the refresher's own crew slots?
    \  k=path
    ^  bool
    ((pith_prefix ['fresh] k) || (pith_prefix ['freshv] k))

  +  safe_of
    '  The (slot, safe) of one record entry, when it holds a safe.
    \  e=mop/kv[path pail]
    ^  maybe[[k=path s=safe]]
    ?  e.val
     > sf=safe  (./some [e.key sf])
    .none

  +  safes
    '  Every top-level safe slot of a record, in slot order.
    \  t=myth
    ^  row[[k=path s=safe]]
    t.tap.sift(fresh/safe_of)

  +  crew_at
    '  The record's crew, or empty.
    \ t=myth
    ^ crew
    | myth/crew_at crew_slot t
  +  add_one
    '  Crew-merge, add side: the two slots for one safe — the
    '  firing target dep and the readable version view.
    \  acc=crew e=[k=path s=safe]
    ^  crew
    =  [k s]  e
    =  fh=path  ['fresh]
       vh=path  ['freshv]
       vroot=path  ['h 'v ($u s.path.len)]
    =  a1  acc.put(fh.weld(k) (dep s.care s.path))
    a1.put(vh.weld(k) (dep .y vroot.weld(s.path)))

  +  scan
    '  (Re)write the crew for the record's safe slots, merging with
    '  the record's own deps: ['fresh*] slots are rebuilt from the
    '  safes, everything else survives.  A record with no safes and
    '  no leftover ['fresh*] slots rides untouched — no empty crews
    '  minted.
    \  t=myth
    ^  myth
    =  ss    (fresh/safes t)
       cur   (fresh/crew_at t)
       kept  cur.filter((\ key val !(fresh/is_slot key)))
    ?  (eq 0 ss.len)
       ?  (eq cur.tap.len kept.tap.len)
          t
       t.put(crew_slot (crew/pail kept))
    t.put(crew_slot (crew/pail ss.fold(kept fresh/add_one)))

  +  init
    \  b=bowl t=myth
    ^  yell
    | yell [] (fresh/scan t)

  +  talk
    \  b=bowl cur=myth add=myth
    ^  yell
    =  u  cur.meld(add)
    | yell [] (fresh/scan u)

  +  fired
    '  Did any fact name this exact path?
    \  r=row[dep] p=path
    ^  bool
    r.any((\ d (eq_pith d.p p)))

  +  case_slot
    '  The h_ver slot a care's data case rides in.
    \  c=care
    ^  path
    ?  c
     > .x  system_vocabulary/version/x_data
     > .y  system_vocabulary/version/y_data
     > .z  system_vocabulary/version/z_data

  +  hear
    '  Bump each fired safe slot to its target's current per-care
    '  data case, read off the matching ['freshv] version view.  An
    '  unmoved case, a missing view, or an unparseable counter all
    '  leave the slot alone.
    \  b=bowl cur=myth r=row[dep]
    ^  yell
    =  ss  (fresh/safes cur)
       vh=path  ['freshv]
    %  i=nat 0  acc=myth cur
    ^  yell
    ?  (eq i ss.len)
       | yell [] acc
    =  [k s]  ss.at(i)
    ?  !(fresh/fired r s.path)
       | _ i.inc acc
    =  vv  b.crew_value(vh.weld(k))
    ?  vv.fil
     > .none  | _ i.inc acc
     > (./some vt)
       ?  (dig_parse (myth/txt_at (fresh/case_slot s.care) vt))
        > .none  | _ i.inc acc
        > (./some nc)
          ?  (eq nc s.ver)
             | _ i.inc acc
          | _ i.inc acc.put(k (safe nc s.care s.path))

  +  form
    '  init/talk keep the crew aimed, hear does the bumping.
    ^  form
    def_form.set_init(fresh/init).set_talk(fresh/talk).set_hear(fresh/hear)
+  pact
  '  The mount form itself: the slot a mount card carries its
  '  manifest in, the card builders, and the expansion.

  +  slot
    '  The slot a mount card carries its manifest in.
    ^  path
    ['pact]

  +  rel_seg
    '  The instance-relative path marker: the "." segment.  A path
    '  value in a seed record whose head is this segment rebases
    '  against the mount root; every other path value is absolute.
    '  ("." is therefore reserved as a head segment in seed-record
    '  path VALUES — never in seed mount paths, which always weld.)
    ^  iota
    ($ts ".")

  +  rel
    '  An instance-relative path, for manifest authors: "." on the
    '  front, so the mount welds its root on.
    \  p=path
    ^  path
    p.cons(pact/rel_seg)

  +  rebase_path
    '  A "."-headed path absolutized against the mount root;
    '  anything else is absolute and stays put.
    \  here=path p=path
    ^  path
    ?  (eq 0 p.len)
       p
    ?  (eq_iota p.at(0) pact/rel_seg)
       here.weld(p.drop(1))
    p

  +  rebase_rec
    '  Every instance-relative slot of a seed record absolutized:
    '  kook limb refs, pails/p payloads, pails/ps rows, hunt paths,
    '  and safe paths — one rule, one mechanism, for behavior refs
    '  and data references alike.  Crew deps are untouched (apps
    '  build crews from the bowl at init).
    \  here=path tale=myth
    ^  myth
    =  rebase
         \  acc=myth e=mop/kv[path pail]
         ^  myth
         ?  e.val
          > kp=kook
            acc.put(e.key (kook kp.refs.map((pact/rebase_path here))))
          > pp=pails/p
            acc.put(e.key (pails/p (pact/rebase_path here pp.p)))
          > sp=pails/ps
            acc.put(e.key (pails/ps sp.ps.map((pact/rebase_path here))))
          > hp=hunt
            acc.put(e.key (hunt hp.c (pact/rebase_path here hp.p)))
          > sf=safe
            acc.put(e.key (safe sf.ver sf.care (pact/rebase_path here sf.path)))
         acc
    tale.tap.fold(tale rebase)

  +  kooks
    '  Cards installing a manifest's behaviors at here/kook/<id>:
    '  poke when the node is already in kids (upgrade), make
    '  otherwise — so the same expansion serves mount and remount.
    \  here=path kids=axal[myth] decls=row[kook/decl]
    ^  row[[p=path q=writ]]
    %  idx=nat 0  out=row[[p=path q=writ]] []
    ?  (eq idx decls.len)
       out
    =  one   decls.at(idx)
       rel=path   ['kook one.id]
       card  (form/card one.form one.lore)
       act=writ
         ?  kids.get(rel)
          > (./some old)  (./poke card)
          > .none  (./make card)
    | _ idx.inc out.snoc([here.weld(rel) act])

  +  seeds
    '  Cards for a manifest's seed records, re-rooted at here, with
    '  "."-headed path values absolutized (pact/rebase_rec).
    '  Poke-if-present, like pact/kooks.  A seed at path [] is legal
    '  and always POKES: the root node necessarily exists in-flight
    '  (it is the node this very mount is making), so the seed MELDS
    '  onto the mount card's record — the card's ['pact]/['module]/
    '  ['status]/limb survive because a document root never writes
    '  those.  (A make would replace the card and unmake the app.)
    '  A seed at one of THIS manifest's kook paths (krels) likewise
    '  always POKES: the kook card is made in this same expansion,
    '  and a later make would replace it (note_then), stripping the
    '  behavior — melding is how a manifest attaches data slots (a
    '  face's ['hunt] claim) to a behavior node it declares.
    \  here=path kids=axal[myth] seeds=row[[p=path t=myth]] krels=row[path]
    ^  row[[p=path q=writ]]
    %  idx=nat 0  out=row[[p=path q=writ]] []
    ?  (eq idx seeds.len)
       out
    =  [at rec]  seeds.at(idx)
       card  (pact/rebase_rec here rec)
       act=writ
         ?  (eq 0 at.len)
            (./poke card)
         ?  krels.any((\ r (eq_pith r at)))
            (./poke card)
         ?  kids.get(at)
          > (./some old)  (./poke card)
          > .none  (./make (root/ensure_title here.weld(at) card))
    | _ idx.inc out.snoc([here.weld(at) act])

  +  init
    '  The mount expansion (doc/shrine-apps.md 5.2): read the
    '  manifest the card carried at ['pact] and emit cards for the
    '  whole app subtree re-rooted at here; the app's lore lands on
    '  the root.  ingest keeps only cards under here in this
    '  transaction, so the expansion cannot install outside its
    '  root; a failure anywhere aborts the worm, so partial mounts
    '  cannot commit.  A card with no (or a non-mani) ['pact]
    '  installs nothing.
    \  =bowl tale=myth
    ^  yell
    >  (./some held) tale.get(pact/slot)
        | yell [] tale
    >  app=mani held
        | yell [] tale
    | pact/expand bowl tale app

  +  talk
    '  Upgrade: a fresh manifest re-expands against the in-flight
    '  subtree. Present nodes poke; new nodes make.
    \  =bowl cur=myth add=myth
    ^  yell
    =  tale  (def_talk bowl cur add).out
    >  (./some held) add.get(pact/slot)
        | yell [] tale
    >  app=mani held
        | yell [] tale
    | pact/expand bowl tale app

  +  expand
    '  Shared mount and upgrade expansion, after manifest validation.
    \  =bowl tale=myth app=mani
    ^  yell
    =  krel_of
         \  d=kook/decl
         ^  path
         ['kook d.id]
       krels  app.kooks.map(krel_of)
       kooks  (pact/kooks bowl.here bowl.kids app.kooks)
       seeds  (pact/seeds bowl.here bowl.kids app.seeds krels)
       tale
         ?  app.doc.head
            tale.put(bond/lede (pails/t app.doc.head)).put(bond/help app.doc)
         tale
    | yell kooks.weld(seeds) tale

  +  vine_card
    '  The one-event subtree card: root plus the seeds as a sub-mani
    '  at ['pact], the pact limb riding — pact/init expands the
    '  whole subtree wherever the card is made.  The lore args are
    '  the root's own lore (absent when has is 0); it rides the
    '  manifest and lands back at bond/help on the root.
    \  has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
       root=myth seeds=row[[p=path t=myth]]
    ^  myth
    =  doc
         ?  has
            | lore head body tests
         | lore "" [] []
       app   (mani 'sub doc [] seeds [])
    .  root
       put(pact/slot app)
       put(limb_slot (kook [(runtime_context/service ['kook 'pact])]))

  +  vine
    '  A whole subtree as one committed event: a make at pax whose
    '  card is pact/vine_card — the in-kernel pact expansion
    '  (pact/init) commits every seed in the same epoch, paying the
    '  commit machinery once per subtree instead of once per node.
    \  pax=path has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
       root=myth seeds=row[[p=path t=myth]]
    ^  task
    (./vine pax (writ/make (root/ensure_title pax (pact/vine_card has head body tests root seeds))))

  +  form
    '  The mount behavior: init expands a fresh mount, talk expands
    '  an upgrade.  Installed at /kook/pact with the kernel's own
    '  registrations during boot seeding, resolved like any behavior.
    ^  form
    def_form.set_init(pact/init).set_talk(pact/talk)

  +  card
    '  The mount card the host makes at an app's root: the manifest
    '  at ['pact], [module] and [status], the /sys/kook ref to the
    '  pact mount form, and the grant ledger.
    '  .
    '  ['wants ..] is what the manifest ASKED for, ['grants ..] what
    '  the host ALLOWED — the gap between the two is the readable
    '  "this app wanted more" signal, and ['grants 'fetch] is exactly
    '  what the helm's move gate reads back.  The decision arrives as
    '  nats to match this card builder's host-facing grant ledger
    '  interface (see grant/has_fetch).
    \  =mani module=text gfetch=nat gport=nat
    ^  myth
    .  (myth/new)
       put(pact/slot mani)
       put(['module] (pails/t module))
       put(['status] (pails/t "live"))
       put(['wants 'fetch] (pd (grant/has_fetch mani.wants)))
       put(['wants 'serve] (pd (grant/serve_port mani.wants)))
       put(['grants 'fetch] (pd gfetch))
       put(['grants 'serve] (pd gport))
       put(limb_slot (kook [(runtime_context/service ['kook 'pact])]))

  +  fail
    '  The card at the mount root when the app failed to compile or
    '  mount: [status] "failed", [err] the rendered error.  A broken
    '  app is a visible namespace citizen, not a host log line.
    \  err=text
    ^  myth
    .  (myth/new)
       put(['status] (pails/t "failed"))
       put(['err] (pails/t err))
+  root
  +  card
    '  A reserved-root card: just the convention's lore
    '  (shrine-apps.md section 7 — each writable root says what it
    '  is from inside the namespace).
    \  head=text
    ^  myth
    | lore/put myth/new 1 head [head] []

  + named
    \ title=str description=str
    ^ myth
    | (myth/sing bond/lede (pails/t title)).put(bond/help (pails/t description))
  + path_title
    ' A fallback for published identifiers, never an identity or routing key.
    \ path=path
    ^ str
    ? !(path.len) "Namespace"
    = last path.at(path.len.dec)
      source (str/from_atom (quip_val last))
      source (? (row/has[str] (str/from_atom (aura_tag last)) ["ts" "ta" "tu"]) source (str/from_atom (iota_show last)))
      words (str/join " " (str/split_nonempty 95 source))
      words (str/join " " (str/split_nonempty 45 words))
    ? !(words.len) "Record"
    = first words.at(0)
      first (? (and (ge first 97) (le first 122)) (sub first 32) first)
    | (str/from_atom first).cat(words.slice(1 words.len.dec))
  + ensure_title
    ' Keep authored text. Only unnamed bootstrap/publication records get a fallback.
    \ name=path card=myth
    ^ myth
    = title=maybe[str]
        > (./some held) card.get(bond/lede) .none
        > text=pails/t held .none
        ? !(text.t.len) .none
        | ./some text.t
    ? (maybe/is_some title) card
    | card.put(bond/lede (pails/t (root/path_title name)))

' --- schema_hand ---

' Copyright (c) 2026 Axiomatic Systems. SPDX-License-Identifier: MIT.
' Shared runtime for schema-generated API hands. Source-only; not compiled.
' The schema supplies fetch_for and resp_for. Request subscription, response
' delivery and crew cleanup are independent of every schema and operation.
+ schema_hand
  + seg_txt
    ' One path segment as text: text auras verbatim, the rest as decimal.
    \ i=iota
    ^ str
    ? (is_text i) (str/from_atom (quip_val i))
    (nat/show (quip_val i))

  + flat_seg
    ' Flatten the absolute request path so two hands cannot collide at /io.
    \ p=path
    ^ iota
    % i=nat 0 acc=str ""
    ? (eq i p.len) ($ts acc)
    ? (eq i 0) (_ 1 (schema_hand/seg_txt p.at(0)))
    (_ i.inc (#str/cat (#str/cat acc "_") (schema_hand/seg_txt p.at(i))))

  + base_of
    ' The server base url from the root record's ['base].
    \ cur=myth
    ^ str
    | myth/txt_at ['base] cur
  + qjoin
    ' Skip absent query fragments. Values remain verbatim, not percent encoded.
    \ ps=row[str]
    ^ str
    % i=nat 0 out=str "" some=bool .false
    ? (eq i ps.len) out
    = p ps.at(i)
    ? (eq p 0) (_ i.inc out some)
    ? some (_ i.inc (#str/cat (#str/cat out "&") p) .true)
    (_ i.inc (#str/cat "?" p) .true)

  + auth_of
    ' An absent injected credential is an unauthenticated call.
    \ cur=myth
    ^ str
    | myth/txt_at ['auth] cur
  + crew_of_rec
    \ t=myth
    ^ crew
    | myth/crew_at bond/crew t
  + http_of
    ' The injected http-client root from the crew slot ['http].
    \ cur=myth
    ^ maybe[path]
    ? (schema_hand/crew_of_rec cur).get(['http])
     > .none .none
     > (./some d=dep) (./some d.p)

  + crew_put
    \ cur=myth slot=path d=dep
    ^ myth
    cur.put(bond/crew (crew/pail (schema_hand/crew_of_rec cur).put(slot d)))

  + crew_del
    \ cur=myth slot=path
    ^ myth
    = kept | (schema_hand/crew_of_rec cur).del slot
    | cur.put bond/crew (crew/pail kept)
  + crew_slot_for
    ' The crew slot whose dep watches path p.
    \ cur=myth p=path
    ^ maybe[path]
    = es (schema_hand/crew_of_rec cur).tap
    % i=nat 0
    ^ maybe[path]
    ? (eq i es.len) .none
    = h es.at(i)
    ? (eq_pith h.val.p p) (./some h.key)
    (_ i.inc)

  + take
    ' Issue each unfinished request through the injected HTTP client.
    \ fetch_for={\ str str pail}row[myth] b=bowl cur=myth gift=axal[mode]
    ^ yell
    = entries gift.tap
    % i=nat 0 cards=row[[p=path q=writ]] [] out=myth cur
    ^ yell
    ? (eq i entries.len) (yell cards out)
    = ent entries.at(i)
      next i.inc
    = [gp=path gm=mode] ent
    ? gm
     > d0=mode/del (_ next cards out)
    ? b.kids.get(gp)
     > .none (_ next cards out)
     > (./some t=myth)
       ? t.get(bond/res)
        > (./some done=pail) (_ next cards out)
        > .none
          ? t.get(bond/req)
           > .none (_ next cards out)
           > (./some held=pail)
             = fr (fetch_for (schema_hand/base_of cur) (schema_hand/auth_of cur) held)
             ? (eq 0 fr.len) (_ next cards out)
             ? (schema_hand/http_of out)
              > .none (_ next cards out)
              > (./some hp=path)
                = dst hp.snoc((schema_hand/flat_seg b.here.weld(gp)))
                (_ next cards.snoc([dst (writ/make fr.at(0))])
                  (schema_hand/crew_put out gp (dep (care/x) dst)))

  + pd_of
    ' Any nominal record as a pail, unchanged.
    \ v=pail
    ^ pail
    v

  + res_body_nat
    \ fm=myth slot=path
    ^ nat
    ? fm.get(slot)
     > (./some bp=pail)
       ? bp
        > n=pails/n n.n
       0
    0

  + hear
    ' Parse completed fetches per originating operation, answer, unsubscribe.
    \ resp_for={\ pail nat str str}row[pail] b=bowl cur=myth changed=row[dep]
    ^ yell
    % i=nat 0 cards=row[[p=path q=writ]] [] out=myth cur
    ^ yell
    ? (eq i changed.len) (yell cards out)
    = d changed.at(i)
      next i.inc
    ? (schema_hand/crew_slot_for out d.p)
     > .none (_ next cards out)
     > (./some k=path)
       ? b.crew.get(k).run(saga/values)
        > .none (_ next cards out)
        > (./some ax)
          ? ax.fil
           > .none (_ next cards out)
           > (./some fm=myth)
             ? fm.get(['res_done])
              > .none (_ next cards out)
              > (./some dn=pail)
                = okf (schema_hand/res_body_nat fm ['res_ok])
                  body (str/from_atom (schema_hand/res_body_nat fm ['res_body]))
                ? b.kids.get(k)
                 > .none (_ next cards out)
                 > (./some t=myth)
                   ? t.get(bond/req)
                    > .none (_ next cards out)
                    > (./some held=pail)
                      = ecode (#str/cat "fetch-err-" (nat/show (schema_hand/res_body_nat fm ['res_err])))
                        resp (resp_for held okf body ecode)
                      ? (eq 0 resp.len) (_ next cards out)
                      (_ next
                        cards.snoc([b.here.weld(k)
                          (writ/poke (myth/sing bond/res resp.at(0)))])
                        (schema_hand/crew_del out k))
