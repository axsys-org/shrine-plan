-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  web [order=40]
-  foundry_corpus [order=50]
'  nenex_foundry_face: the read-only HTML view over Nenex's admitted Foundry
'  corpus.  This facade keeps the corpus compiler vocabulary out of the Nenex
'  app unit: the app supplies the already-expanded /nenex/w record tree and
'  receives ordinary Weft nodes.  Page paths remain provenance; semantic
'  identity remains the explicit /foundry/name carried by admitted records.
+  nenex_foundry_face
  +  path_links
    \  ps=row[path]
    ^  row[weft/node]
    ps.bind((\ p [(weft/tx " ")
      (weft/leaf "a" [(weft/href (show/path p))] (show/path p))]))

  +  backlink
    '  Derived impact for one definition.  Reverse references are a view over
    '  the admitted graph, never identity input or hub-maintained wiki state.
    \  target=path backlinks=row[foundry_corpus/backlink]
    ^  row[path]
    =  hits
         backlinks.keep((\ b (eq_pith target
           (foundry_corpus/backlink_target b))))
    ?  (eq 0 hits.len)
       []
    (foundry_corpus/backlink_sources hits.at(0))

  +  definition_row
    \  d=foundry_corpus/definition
       backlinks=row[foundry_corpus/backlink]
    ^  weft/node
    =  name  (foundry_corpus/definition_name d)
       source  (foundry_corpus/definition_source d)
       incoming  (nenex_foundry_face/backlink name backlinks)
       base=row[weft/node]
         [(weft/el "code" [] [(weft/tx (show/path name))])
          (weft/tx
            (weft/cat2 "  "
              (iota_show (foundry_corpus/definition_kind d))))
          (weft/tx "  authored at ")
          (weft/leaf "a" [(weft/href (show/path source))]
            (show/path source))]
       impact=row[weft/node]
         ?  (eq 0 incoming.len)
            []
         =  impact_head=row[weft/node]  [(weft/tx "  used by")]
         impact_head.weld((nenex_foundry_face/path_links incoming))
    (weft/el "div" [(weft/cls "item")] base.weld(impact))

  +  diagnostic_row
    \  d=foundry_corpus/diagnostic
    ^  weft/node
    =  source  (foundry_corpus/diagnostic_source d)
       subject  (foundry_corpus/diagnostic_subject d)
       field  (foundry_corpus/diagnostic_field d)
    (weft/el "div" [(weft/cls "item diagnostic")]
      [(weft/tx (iota_show (foundry_corpus/diagnostic_code d)))
       (weft/tx "  for ")
       (weft/el "code" [] [(weft/tx (show/path subject))])
       (weft/tx "  field ")
       (weft/el "code" [] [(weft/tx (show/path field))])
       (weft/tx "  at ")
       (weft/leaf "a" [(weft/href (show/path source))]
         (show/path source))])

  +  section
    '  Admit the already-expanded /nenex/w record tree directly.  All opted-in
    '  pages enter one admission, so forward references remain independent of
    '  page order.  No ['src] slot is reparsed at this boundary.
    \  wpath=path fat=axal[myth]
    ^  row[weft/node]
    =  admission  (foundry_corpus/admit_axal wpath fat)
       definitions  (foundry_corpus/admission_definitions admission)
       diagnostics  (foundry_corpus/admission_diagnostics admission)
    ?  (eq 0 (add definitions.len diagnostics.len))
       []
    =  backlinks  (foundry_corpus/admission_backlinks admission)
       rows
         definitions.map((\ d (nenex_foundry_face/definition_row d backlinks)))
       issues  diagnostics.map(nenex_foundry_face/diagnostic_row)
       head=row[weft/node]
          [(weft/leaf "h2" [] "Foundry semantic corpus")
           (weft/el "p" [(weft/cls "muted")]
             [(weft/tx "Explicit semantic definitions admitted from expanded page records with page provenance; used-by rows are derived impact only.")])
           (weft/el "p" [(weft/cls "muted")]
             [(weft/tx
                (weft/cat2 "definitions: "
                  (weft/show_nat definitions.len)))
              (weft/tx
                (weft/cat2 "  diagnostics: "
                  (weft/show_nat diagnostics.len)))])]
    [(weft/el "div" [(weft/cls "semantic")]
       head.weld(rows).weld(issues))]
