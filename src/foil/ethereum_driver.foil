- json

+ ethereum_driver
  ' Driver capabilities stay outside deterministic contract programs. The
  ' loopback host owns signing keys, nonce reservations and RPC credentials.
  + bar
    \ text=nat
    ^ nat
    | add text (bex (mul 8 (wid text)))
  + unbar
    \ bytes=nat
    ^ nat
    | mod bytes (bex (mul 8 (dec (wid bytes))))
  + exchange
    ' Raw transport port for a foot. The result is HTTP status and JSON text.
    \ port=nat token=nat payload=nat
    ^ either[nat row[nat]]
    = url | str/cat_all ["http://127.0.0.1:" (nat/show port) "/v0"]
      auth | str/cat_all ["Bearer " (str/from_atom token)]
      headers=row[[nat nat]]
        [[(ethereum_driver/bar (str/to_atom "Content-Type")) (ethereum_driver/bar (str/to_atom "application/json"))]
         [(ethereum_driver/bar (str/to_atom "Authorization")) (ethereum_driver/bar (str/to_atom auth))]]
    = ;result
        | Fetch
          [(ethereum_driver/bar (str/to_atom "POST")) (ethereum_driver/bar (str/to_atom url)) headers [(ethereum_driver/bar payload)]]
          [[3000] 30000 0 [1048576]]
    ? result
     > (./err code) (./err code)
     > (./ok response)
      = [status final_url headers body] response
      | ./ok [status (ethereum_driver/unbar body)]
  + request
    \ port=nat token=str message=json
    ^ either[str json]
    = ;response | ethereum_driver/exchange port (str/to_atom token) (str/to_atom (show message))
    ? response
     > (./err _) (./err "Ethereum driver transport failed")
     > (./ok fields)
      ? !(eq fields.at(0) 200) (./err "Ethereum driver refused request")
      = text | str/from_atom fields.at(1)
      ? (parse text)
       > (jres/ok value rest)
        ? !(eq (ws text rest) text.len) (./err "Trailing driver response data")
        | ./ok value
       > (jres/err reason _) (./err reason)
