- helm
- http_response
- http

+ http_foot
  + request
    : method=str target=str body=str
  + action
    & http_foot/action/snapshot
      http_foot/action/interact
      http_foot/action/develop
      http_foot/action/reply
      http_foot/action/bytes
      http_foot/action/asset
      http_foot/action/install
      http_foot/action/write
      http_foot/action/commit
      http_foot/action/commit_many
      http_foot/action/batch
      http_foot/action/batch_told
      http_foot/action/told
      http_foot/action/stream
      http_foot/action/broadcast
      http_foot/action/join
      http_foot/action/after
      http_foot/action/wait
      http_foot/action/journal
      http_foot/action/value
      http_foot/action/physical
      http_foot/action/inspect
    + snapshot
      ' Trusted mount callback evaluated against one supervisor state.
      : read={\ namespace}[nat str]
    + interact
      : query=goo_runtime/request
    + develop
      : query=grove_dev/request
    + reply
      : response=http_response
    + asset
      : home=path name=str mime=nat
    + bytes
      : status=nat body=nat ctype=nat
    + install
      : source=path version=nat target=path back=str
    + write
      : pax=path wit=writ back=str
    + commit
      ' One write. The foot admits or rejects it, then calls done with
      ' the result (none, or the rejection) to build the response.
      : pax=path wit=writ done={\ maybe[pail]}http_response
    + commit_many
      ' Several writes admitted whole or refused whole as one event
      ' (one journal entry); answered like commit.
      : writes=row[[pax=path wit=writ]] done={\ maybe[pail]}http_response
    + batch
      ' One commit_many, then one snapshot on the admitted state: finish
      ' receives the event's outcome and that state.  The connection
      ' actor runs the pair; the foot sees one commit and a snapshot.
      : writes=row[[pax=path wit=writ]] finish={\ maybe[pail] namespace}[nat str]
    + batch_told
      ' A batch, plus one line for the open streams. After the commit,
      ' told runs on the new state and returns the line to send; an
      ' empty string sends nothing.
      : writes=row[[pax=path wit=writ]] finish={\ maybe[pail] namespace}[nat str] told={\ maybe[pail] namespace}str
    + told
      ' A read that also sends a fixed line to the open streams. Nothing
      ' is written to the journal.
      : read={\ namespace}[nat str] line=str
    + stream
      ' A GET that stays open. The connection sends the event-stream
      ' head, registers with the fan-out, and then writes each line it
      ' is given until the socket closes. Commits never wait for it.
      :
    + broadcast
      ' One line for every open stream, from a connection to the foot.
      : line=str
    + join
      ' A stream connection registering itself with the foot (its
      ' handle rides as the capability).
      :
    + after
      ' A snapshot whose answer decides the next action: a read that
      ' feeds a write, in one request.
      : read={\ namespace}[nat str] next={\ nat str}http_foot/action
    + wait
      : record=myth
    + journal
      : before=maybe[nat] limit=nat
    + value
      : query=value_read/request
    + physical
      : query=physical_read/request
    + inspect
      : query=inspect_read/request
  + task
    '  Supervisor messages and namespace actions from connections.
    & feet/task/init
      feet/task/fact
      feet/task/page
      feet/task/journal
      feet/task/value
      feet/task/physical
      feet/task/inspect
      feet/task/asset
      feet/task/ack
      feet/task/develop
      http_foot/action/snapshot
      http_foot/action/interact
      http_foot/action/develop
      http_foot/action/install
      http_foot/action/write
      http_foot/action/commit
      http_foot/action/commit_many
      http_foot/action/batch
      http_foot/action/batch_told
      http_foot/action/told
      http_foot/action/stream
      http_foot/action/broadcast
      http_foot/action/join
      http_foot/action/after
      http_foot/action/wait
      http_foot/action/journal
      http_foot/action/value
      http_foot/action/physical
      http_foot/action/inspect
      http_foot/action/asset
  + answer
    & http_response http_foot/action/bytes
  + pending
    ' Text r<serial> keys belong to ordinary HTTP namespace records.
    ' Numeric serial keys correlate read-only supervisor requests.
    : key=iota conn=nat
  + ack
    & http_foot/ack/request
      http_foot/ack/write
      http_foot/ack/commit
      http_foot/ack/install
      http_foot/ack/cleanup
    + request
      : key=iota
    + write
      : conn=nat back=str
    + commit
      : conn=nat done={\ maybe[pail]}http_response
    + install
      : conn=nat back=str
    + cleanup
      :
  + fault
    : reason=str
  + crlf
    ^ str
    | str/from_atom 2573
  + bar
    \ text=nat
    ^ nat
    | add text (bex (mul 8 (wid text)))
  + unbar
    \ bytes=nat
    ^ str
    | str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes)))))
  + body_text
    ' The text of a response built by a mount: its body is a plain
    ' atom, never barred, so no byte is stripped (unbar is for the
    ' marked request and asset bytes only).
    \ response=http_response
    ^ str
    | str/from_atom response.body
  + split
    \ separator=nat text=str
    ^ row[str]
    | str/split_byte separator text
  + ascii_lower
    \ text=str
    ^ str
    | str/ascii_lower text
  + trim
    \ text=str
    ^ str
    | str/trim_ascii text
  + find
    \ needle=str text=str
    ^ maybe[nat]
    | str/find needle text
  + hex
    \ c=nat
    ^ maybe[nat]
    = digit | hex/value c
    ? (eq digit 16) .none
    | ./some digit
  + decode
    \ plus=bool text=str
    ^ str
    % i=nat 0 out=str ""
    ? (eq i text.len) out
    = c text.at(i)
    ? (eq c 37)
      ?> (./some hi) (http_foot/hex text.at(i.inc))
          (error (http_foot/fault "Invalid percent escape"))
      ?> (./some lo) (http_foot/hex text.at((add i 2)))
          (error (http_foot/fault "Invalid percent escape"))
      = byte (add (mul 16 hi) lo)
      ? (eq byte 0) (error (http_foot/fault "NUL is not valid text"))
      | _ (add i 3) out.snoc_byte(byte)
    | _ i.inc out.snoc_byte((? plus (? (eq c 43) 32 c) c))
  + fields
    \ body=str
    ^ row[[key=str value=str]]
    | (http_foot/split 38 body).map
    \ field
    = split (http_foot/find "=" field)
    ? split
     > (./some at)
      [(http_foot/decode .true field.slice(0 at))
       (http_foot/decode .true field.slice(at.inc field.len))]
     > .none [(http_foot/decode .true field) ""]
  + field
    \ key=str fields=row[[key=str value=str]]
    ^ str
    % i=nat 0
    ? (eq i fields.len) ""
    = [name value] fields.at(i)
    ? (equal name key) value
    | _ i.inc
  + target
    \ raw=str
    ^ path
    = text (http_foot/decode .false raw)
    = absolute=str
        ? (eq text.len 0) "/"
        ? (eq text.at(0) 47) text
        | str/cat_all ["/" text]
    ?> (./some path) (path_parse absolute)
        ; (error (http_foot/fault "Invalid namespace path"))
        []
    path
  + route_is
    \ prefix=str target=str
    ^ bool
    ? (equal prefix "/") (eq target.at(0) 47)
    ? (equal prefix target) .true
    | equal[str] target.slice(0 prefix.len.inc) prefix.cat("/")
  + header_end
    ' The framing delimiter is fixed: compare its bytes without slicing
    ' the remaining large request atom at every candidate offset.
    \ text=str
    ^ maybe[nat]
    % i=nat 0
    ^ maybe[nat]
    ? (gt (add i 4) text.len) .none
    ? !(eq text.at(i) 13) (_ i.inc)
    ? !(eq text.at(i.inc) 10) (_ i.inc)
    ? !(eq text.at((add i 2)) 13) (_ i.inc)
    ? !(eq text.at((add i 3)) 10) (_ i.inc)
    | ./some (add i 4)
  + content_length
    \ headers=str
    ^ nat
    = lines (http_foot/split 10 headers)
    % i=nat 1 length=maybe[nat] .none
    ? (ge i lines.len)
      ? length
       > (./some n) n
       > .none 0
    = line (http_foot/trim lines.at(i))
    ? (eq line.len 0)
      | _ i.inc length
    ?> (./some colon) (http_foot/find ":" line)
        (error (http_foot/fault "Malformed header"))
    = name (http_foot/ascii_lower line.slice(0 colon))
      value (http_foot/trim line.slice(colon.inc line.len))
    ? (equal[str] name "transfer-encoding")
      | error (http_foot/fault "Transfer-Encoding is unsupported")
    ? !(equal[str] name "content-length")
      | _ i.inc length
    ? (maybe/is_some length)
      | error (http_foot/fault "Duplicate Content-Length")
    ?> (./some n) (nat/parse value)
        (error (http_foot/fault "Invalid Content-Length"))
    ? (gt n 1048576) (error (http_foot/fault "Request body too large"))
    | _ i.inc (./some n)
  + bad_request
    \ reason=str
    ^ http_foot/request
    ; (error (http_foot/fault reason))
    | http_foot/request "" "" ""
  + request_line_valid
    ' Validate before splitting/packing a target ending in NUL, which
    ' would otherwise lose that byte and alias a different request.
    \ line=str
    ^ bool
    % i=nat 0
    ? (eq i line.len) .true
    = byte line.at(i)
    ? ((lt byte 32) || (eq byte 127))
      ? (? (eq byte 13) (eq i.inc line.len) .false) .true
      .false
    | _ i.inc
  + request_chunk
    ' Read returns a length-preserving high sentinel. Removing it into a
    ' packed str would erase a terminal NUL before line validation. Reject
    ' that already-unrepresentable input at each socket chunk boundary.
    \ bytes=nat
    ^ str
    = length (wid bytes)
    ? (? (gt length 1) (eq (load8 (sub length 2) bytes) 0) .false)
      ; (error (http_foot/fault "NUL at request chunk boundary"))
      ""
    | http_foot/unbar bytes
  + read_request
    \ fd=nat
    ^ http_foot/request
    % input=str ""
    ^ http_foot/request
    = end (http_foot/header_end input)
    ? end
     > (./some at)
      ? (gt at 65536) (http_foot/bad_request "Headers too large")
      = length (http_foot/content_length input.slice(0 at))
      ? (ge input.len (add at length))
        = line (http_foot/split 10 input).at(0)
        ? !(http_foot/request_line_valid line) (http_foot/bad_request "Invalid request target bytes")
        = words (http_foot/split 32 (http_foot/trim line))
        ? !(eq words.len 3) (http_foot/bad_request "Malformed request line")
        ? !(equal[str] words.at(2) "HTTP/1.0")
          ? !(equal[str] words.at(2) "HTTP/1.1")
            (http_foot/bad_request "Unsupported HTTP version")
          | http_foot/request words.at(0) words.at(1) input.slice(at length)
        | http_foot/request words.at(0) words.at(1) input.slice(at length)
      = ;bytes (Read fd 16384)
      ? (eq bytes 0) (http_foot/bad_request "Incomplete request body")
      | _ input.cat((http_foot/request_chunk bytes))
     > .none
      ? (gt input.len 65536) (http_foot/bad_request "Headers too large")
      = ;bytes (Read fd 16384)
      ? (eq bytes 0) (http_foot/bad_request "Incomplete request headers")
      | _ input.cat((http_foot/request_chunk bytes))
  + encode
    \ response=http_response
    ^ nat
    | http_foot/bar
    | str/cat_all
      ["HTTP/1.0 " (nat/show response.status) " Response" http_foot/crlf
       "Content-Type: " (str/from_atom response.ctype) http_foot/crlf
       "Content-Length: " (nat/show (wid response.body)) http_foot/crlf
       "Connection: close" http_foot/crlf http_foot/crlf (str/from_atom response.body)]
  + encode_bytes
    ' Body is a byte bar: its sentinel preserves trailing zero bytes.
    \ status=nat body=nat ctype=nat
    ^ nat
    = header=str
        | str/cat_all
          ["HTTP/1.0 " (nat/show status) " Response" http_foot/crlf
           "Content-Type: " (str/from_atom ctype) http_foot/crlf
           "Content-Length: " (nat/show (dec (wid body))) http_foot/crlf
           "Connection: close" http_foot/crlf http_foot/crlf]
    | add (str/to_atom header) (mul body (bex (mul 8 header.len)))
  + planned
    '  What the listener decided for one connection: an encoded reply it
    '  could finish locally, or an action the foot must answer.
    & http_foot/planned/done
      http_foot/planned/ask
    + done
      : encoded=nat
    + ask
      : action=http_foot/action
  + plan
    '  Read and route one request in the listener, which holds the
    '  routes.  Only the fd and this small result cross to the
    '  connection actor.  (A fresh actor per connection used to receive
    '  the whole route configuration, every closure with its environment,
    '  through the message copier on each request: that copy was the
    '  per-request floor, and it grew with the loaded mounts.  A pool of
    '  workers spawned once was tried and dropped: a worker waiting for
    '  the foot's answer shares its mailbox with incoming connections.)
    \ config=http_foot/config fd=nat
    ^ http_foot/planned
    ? (Try http_foot/read_request fd)
     > (./err _) (./done (http_foot/encode (http_driver/response 400 "Malformed HTTP request")))
     > (./ok parsed)
      = ;attempt
          | Try[http_foot/request http_foot/action]
            (\ r=http_foot/request
              | http_foot/dispatch config.routes r
                  (div (Now 0) 1000000000))
            parsed
      ? attempt
       > (./err _) (./done (http_foot/encode (http_driver/response 400 "Invalid request")))
       > (./ok action)
        ? action
         > (./reply ready) (./done (http_foot/encode ready))
         > (./bytes status body ctype) (./done (http_foot/encode_bytes status body ctype))
        (./ask action)
  + connection
    '  Finish one connection: write a local reply, or ask the foot for
    '  namespace work and write its answer.
    \ fd=nat planned=http_foot/planned self=nat
    ^ nat
    = ;[root caps] (Recv[path] 0)
      foot caps.at(0)
    = streaming=bool
        ? planned
         > (./ask action)
          ? action
           > .stream .true
          .false
        .false
      joining=http_foot/action .join
    ? streaming
      ; (Try (\ wire=nat (Write fd wire)) (http_foot/bar http_foot/stream_head))
      ; (SendCaps foot joining [0])
      ; (CloseHandle foot)
      | http_foot/streaming fd
    = encoded=nat
        ? planned
         > (./done ready) ready
         > (./ask action) (http_foot/perform foot action)
    ; (Try (\ wire=nat (Write fd wire)) encoded)
    ; (CloseFd fd)
    | CloseHandle foot
  + stream_msg
    ' What a stream connection and the fan-out exchange.
    & http_foot/stream_msg/join
      http_foot/stream_msg/line
      http_foot/stream_msg/streamed
    + join
      :
    + line
      : text=str
    + streamed
      ' A stream acknowledging one written line; the fan-out counts
      ' lines outstanding per stream and drops one that stalls.
      :
  + stream_head
    ' The event-stream response head: no length, the body runs until
    ' the socket closes.
    ^ str
    | str/cat_all ["HTTP/1.0 200 Response" http_foot/crlf "Content-Type: text/event-stream" http_foot/crlf "Cache-Control: no-cache" http_foot/crlf "Connection: close" http_foot/crlf http_foot/crlf ": open" http_foot/crlf http_foot/crlf]
  + frame
    ' One server-sent event carrying the line.
    \ text=str
    ^ nat
    | http_foot/bar (str/cat_all ["data: " text http_foot/crlf http_foot/crlf])
  + streaming
    ' A stream connection after its head is written: receive lines from
    ' the fan-out, write each to the socket, acknowledge it; a failed
    ' write (the tab went away) ends the connection.
    \ fd=nat
    ^ nat
    % ignored=nat 0
    = ;[message caps] (Recv[http_foot/stream_msg] 0)
    ? message
     > (./line text)
      = ;wrote (Try (\ wire=nat (Write fd wire)) (http_foot/frame text))
      ? wrote
       > (./ok _)
        = acked=http_foot/stream_msg .streamed
        ; (? (gt caps.len 0) (Send caps.at(0) acked) 0)
        ; (helm/supervisor/close_caps caps)
        | _ 0
       > (./err _)
        ; (helm/supervisor/close_caps caps)
        ; (CloseFd fd)
        0
    ; (helm/supervisor/close_caps caps)
    | _ 0
  + fanout
    ' The stream registry: every open stream's handle with the lines it
    ' has not yet acknowledged.  A line is sent to each with Try; a
    ' stream whose handle refuses, or that falls more than 64 lines
    ' behind, is dropped.  Nothing here blocks: a commit hands the line
    ' over and goes on.
    \ self=nat
    ^ nat
    % streams=row[[h=nat behind=nat]] []
    = ;[message caps] (Recv[http_foot/stream_msg] 0)
    ? message
     > .join
      ? (eq caps.len 0) (_ streams)
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ streams.snoc([caps.at(0) 0])
     > .streamed
      ? (eq caps.len 0) (_ streams)
      = from caps.at(0)
        eased
          | streams.map
            \ [h behind]
            | [h (? (and (eq h from) (gt behind 0)) behind.dec behind)]
      ; (helm/supervisor/close_caps caps)
      | _ eased
     > (./line text)
      ; (helm/supervisor/close_caps caps)
      = none=row[[h=nat behind=nat]] []
        ;kept
          | streams.fold none
          \ ;out=row[[h=nat behind=nat]] [h behind]
          ^ row[[h=nat behind=nat]]
          ? (gt behind 64)
            ; (CloseHandle h)
            out
          = ;sent (Try (\ target=nat (SendCaps target (http_foot/stream_msg/line text) [0])) h)
          ? sent
           > (./ok _) out.snoc([h behind.inc])
           > (./err _)
            ; (Try (\ target=nat (CloseHandle target)) h)
            out
      | _ kept
    | _ streams
  + outcome
    ' The commit answer a batch step reads: 200 admitted, or 409 with
    ' the kernel's reason as the body.
    \ err=maybe[pail]
    ^ http_response
    ? err
     > .none (http_driver/response 200 "admitted")
     > (./some why) (http_driver/response 409 (http_foot/reason why))
  + reason
    ' A rejection pail as text: the kernel names its reason as a symbol.
    \ why=pail
    ^ str
    ? why
     > q=pails/q (iota_show q.q)
     > r=helm/supervisor/rejection (iota_show r.reason)
     > t=pails/t t.t
     > n=pails/n (nat/show n.n)
    "refused"
  + ask
    \ foot=nat action=http_foot/action
    ^ http_foot/answer
    ; (SendCaps foot action [0])
    = ;[answer extra] (Recv[http_foot/answer] 0)
    answer
  + encode_answer
    \ answer=http_foot/answer
    ^ nat
    ? answer
     > response=http_response (http_foot/encode response)
     > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
  + perform
    ' Ask the foot and encode its answer.  A batch is one commit_many
    ' (one event for every record), then one snapshot; an after is a
    ' snapshot whose answer picks the next action.
    \ foot=nat action=http_foot/action
    ^ nat
    ? action
     > (./batch writes finish)
      = ;answer (http_foot/ask foot (http_foot/action/commit_many writes http_foot/outcome))
        outcome=maybe[pail]
          ? answer
           > response=http_response (? (eq response.status 200) .none (./some (pails/t (http_foot/body_text response))))
           > (./bytes status body ctype) .none
      | http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace (finish outcome state))))
     > (./batch_told writes finish told)
      = ;answer (http_foot/ask foot (http_foot/action/commit_many writes http_foot/outcome))
        outcome=maybe[pail]
          ? answer
           > response=http_response (? (eq response.status 200) .none (./some (pails/t (http_foot/body_text response))))
           > (./bytes status body ctype) .none
        ;ready (http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace (finish outcome state)))))
        ;line (http_foot/ask foot (http_foot/action/snapshot (\ state=namespace [200 (told outcome state)])))
      ; (? line
          > response=http_response
            = text (http_foot/body_text response)
            ? (gt text.len 0) (Send foot (http_foot/action/broadcast text)) 0
          > (./bytes status body ctype) 0)
      | ready
     > (./told read line)
      = ;ready (http_foot/encode_answer (http_foot/ask foot (http_foot/action/snapshot read)))
      ; (? (gt line.len 0) (Send foot (http_foot/action/broadcast line)) 0)
      | ready
     > (./after read next)
      = ;answer (http_foot/ask foot (http_foot/action/snapshot read))
      ? answer
       > response=http_response (http_foot/perform foot (next response.status (http_foot/body_text response)))
       > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
     > (./reply response) (http_foot/encode response)
     > (./bytes status body ctype) (http_foot/encode_bytes status body ctype)
    | http_foot/encode_answer (http_foot/ask foot action)
  + listener
    \ config=http_foot/config fd=nat self=nat
    ^ nat
    = ;[root caps] (Recv[path] 0)
      foot caps.at(0)
    % ignored=nat 0
    = ;connection (Accept fd)
      ;planned (http_foot/plan config connection)
      ;actor (Spawn (http_foot/connection connection planned))
    ; (SendCaps actor root [foot])
    ; (CloseHandle actor)
    | _ 0
  + reply
    \ conn=nat response=http_response
    ^ nat
    ; (Send conn response)
    | CloseHandle conn
  + inspect_renderer
    ' One renderer retains the immutable Grove registry, not a fresh actor
    ' and transferred renderer closure per request. The foot/coordinator
    ' remains free to acknowledge writes and deliver bounded reads.
    \ render={\ either[iota inspect_read/result]}http_response self=nat
    ^ nat
    % ignored=nat 0
    = ;[result caps] (Recv[either[iota inspect_read/result]] 0)
      response
        ? (Try render result)
         > (./ok ready) ready
         > (./err _) (http_driver/response 500 "Inspection rendering failed")
    ; (http_foot/reply caps.at(0) response)
    | _ 0
  + value_error
    \ reason=iota status=nat
    ^ http_response
    | http_response status (str/to_atom (value_read/error_json reason)) "application/json; charset=utf-8"
  + value_response
    \ result=either[iota value_read/chunk]
    ^ http_response
    ? result
     > (./err reason) (http_foot/value_error reason (value_read/status reason))
     > (./ok chunk)
       = ;body (str/to_atom (value_read/json chunk))
       | http_response 200 body "application/json; charset=utf-8"
  + physical_response
    \ result=either[iota str]
    ^ http_response
    ? result
     > (./err reason) (http_foot/value_error reason (physical_projection/status reason))
     > (./ok body)
       | http_response 200 (str/to_atom body) "application/json; charset=utf-8"
  + finish
    \ parent=nat binding=axal[saga] pending=row[http_foot/pending] queue=row[http_foot/ack]
    ^ [pending=row[http_foot/pending] queue=row[http_foot/ack]]
    % i=nat 0 left=row[http_foot/pending] [] acks=row[http_foot/ack] queue
    ? (eq i pending.len) [left acks]
    = item pending.at(i)
    ? (maybe/is_some (dig_of item.key))
      | _ i.inc left.snoc(item) acks
    =
      response=maybe[http_response]
        ? binding.get([item.key])
         > (./some version) (http_driver/result (./known (unpin version.myth)))
         > .none .none
    ? response
     > .none (_ i.inc left.snoc(item) acks)
     > (./some ready)
      ; (http_foot/reply item.conn ready)
      ; (Send parent (feet/gift/pass [item.key] .cull))
      | _ i.inc left acks.snoc(.cleanup)
  + run
    \ initial=feet/task/init self=nat
    ^ nat
    | http_foot/run_with http_foot/empty initial self
  + run_with
    \ config=http_foot/config initial=feet/task/init self=nat
    ^ nat
    = root=path
        ? initial.ax.fil
         > (./some version)
          | (unpin version.myth).path_at(['namespace_root]).fall []
        []
      port=nat
        ? initial.ax.fil
         > (./some version) (unpin version.myth).nat_at(['port] 0)
        0
      ;fd (Listen port)
      ;pump (Spawn (http_foot/listener config fd))
      ;renderer (Spawn (http_foot/inspect_renderer config.inspect))
      ;streams (Spawn http_foot/fanout)
    ; (SendCaps pump root [0])
    ; (CloseHandle pump)
    ; (Trace "HTTP foot listening" 0)
    % serial=nat 0 pending=row[http_foot/pending] [] queue=row[http_foot/ack] []
    = ;[message caps] (Recv[http_foot/task] 0)
    ? message
     > (http_foot/action/asset home name mime)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/asset serial home name mime))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (feet/task/asset request mime bytes)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (? bytes
              > (./some body)
                ; (Send item.conn (http_foot/action/bytes 200 body mime))
                | CloseHandle item.conn
              > .none (http_foot/reply item.conn (http_driver/response 404 "Asset not published")))
          out
      | _ serial left queue
     > (http_foot/action/snapshot read)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/snapshot serial read))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (http_foot/action/interact query)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/interact serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (http_foot/action/develop query)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/develop serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (feet/task/develop request status body)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn (http_response status (str/to_atom body) "application/json; charset=utf-8"))
          out
      | _ serial left queue
     > (http_foot/action/install source version target back)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/install source version target))
      | _ serial.inc pending
          queue.snoc((http_foot/ack/install conn back))
     > (http_foot/action/write pax wit back)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/poke pax wit))
      | _ serial.inc pending queue.snoc((http_foot/ack/write conn back))
     > (http_foot/action/batch writes finish)
      ? (eq caps.len 0) (_ serial pending queue)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A batch is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue
     > (http_foot/action/batch_told writes finish told)
      ? (eq caps.len 0) (_ serial pending queue)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A batch is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue
     > (http_foot/action/told read line)
      ? (eq caps.len 0) (_ serial pending queue)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A told read is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue
     > .stream
      ? (eq caps.len 0) (_ serial pending queue)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "A stream is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue
     > .join
      ' a stream connection joining: its handle goes to the fan-out
      ? (eq caps.len 0) (_ serial pending queue)
      = joined=http_foot/stream_msg .join
      ; (SendCaps streams joined [caps.at(0)])
      ; (helm/supervisor/close_caps caps)
      | _ serial pending queue
     > (http_foot/action/broadcast line)
      ; (helm/supervisor/close_caps caps)
      ; (Send streams (http_foot/stream_msg/line line))
      | _ serial pending queue
     > (http_foot/action/after read next)
      ? (eq caps.len 0) (_ serial pending queue)
      ; (http_foot/reply caps.at(0) (http_driver/response 500 "An after is run by the connection, not the foot"))
      ; (helm/supervisor/close_caps caps.drop(1))
      | _ serial pending queue
     > (http_foot/action/commit pax wit done)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/poke pax wit))
      | _ serial.inc pending queue.snoc((http_foot/ack/commit conn done))
     > (http_foot/action/commit_many writes done)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/batch writes))
      | _ serial.inc pending queue.snoc((http_foot/ack/commit conn done))
     > (http_foot/action/wait record)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
        key=iota ($ts (str/cat_all ["r" (nat/show serial)]))
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/pass [key] (writ/make record)))
      | _ serial.inc pending.snoc((http_foot/pending key conn))
        queue.snoc((http_foot/ack/request key))
     > (http_foot/action/journal before limit)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/journal serial before limit))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (http_foot/action/value query)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/value serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (http_foot/action/physical query)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/physical serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (http_foot/action/inspect query)
      ? (eq caps.len 0) (_ serial pending queue)
      = conn caps.at(0)
      ; (helm/supervisor/close_caps caps.drop(1))
      ; (Send initial.parent (feet/gift/inspect serial query))
      | _ serial.inc pending.snoc((http_foot/pending ($u serial) conn)) queue
     > (feet/task/inspect request result)
      ; (helm/supervisor/close_caps caps)
      = empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (SendCaps renderer result [item.conn])
          ; (CloseHandle item.conn)
          out
      | _ serial left queue
     > (feet/task/physical request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try http_foot/physical_response result)
           > (./ok ready) ready
           > (./err _) (http_foot/value_error 'read_failed 500)
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue
     > (feet/task/value request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try http_foot/value_response result)
           > (./ok ready) ready
           > (./err _) (http_foot/value_error 'read_failed 500)
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue
     > (feet/task/journal request result)
      ; (helm/supervisor/close_caps caps)
      = response
          ? (Try config.journal result)
           > (./ok ready) ready
           > (./err _) (http_driver/response 500 "Journal rendering failed")
        empty=row[http_foot/pending] []
        ;left
          | pending.fold empty
          \ ;out=row[http_foot/pending] item=http_foot/pending
          ^ row[http_foot/pending]
          ? !(eq_iota item.key ($u request)) out.snoc(item)
          ; (http_foot/reply item.conn response)
          out
      | _ serial left queue
     > (./fact binding)
      = ;[left acks] (http_foot/finish initial.parent binding pending queue)
      | _ serial left acks
     > (./ack err)
      ? (eq queue.len 0) (_ serial pending queue)
      = head queue.at(0)
        tail queue.drop(1)
      ? head
       > (./install conn back)
        = response
            ? err
             > .none (http_driver/back back)
             > (./some cause)
              = reason=str
                  ? cause
                   > fault=helm/supervisor/rejection
                    | str/from_atom (iota_show fault.reason)
                  "installation_failed"
              | http_driver/response 409
                  (str/cat_all ["Installation rejected: " reason
                    ". Refresh the Grove template before retrying."])
        ; (http_foot/reply conn response)
        | _ serial pending tail
       > (./write conn back)
        = response
            ? err
             > .none (http_driver/back back)
             > (./some _) (http_driver/response 500 "Namespace write rejected")
        ; (http_foot/reply conn response)
        | _ serial pending tail
       > (./commit conn done)
        ; (http_foot/reply conn (done err))
        | _ serial pending tail
       > (./request key)
        ? err
         > .none (_ serial pending tail)
         > (./some _)
          = empty=row[http_foot/pending] []
            ;left
              | pending.fold empty
              \ ;out=row[http_foot/pending] item=http_foot/pending
              ^ row[http_foot/pending]
              ? !(equal item.key key) out.snoc(item)
              ; (http_foot/reply item.conn (http_driver/response 500 "Namespace request rejected"))
              out
          | _ serial left tail
       > .cleanup (_ serial pending tail)
    ; (helm/supervisor/close_caps caps)
    | _ serial pending queue

  + route
    : prefix=str plan={\ http_foot/request nat}http_foot/action
  + config
    : routes=row[http_foot/route]
      inspect={\ either[iota inspect_read/result]}http_response
      journal={\ either[iota helm/journal_page]}http_response
  + asset
    : url=str bytes=nat mime=str
  + asset_body
    \ url=str assets=row[http_foot/asset]
    ^ str
    % idx=nat 0
    ? (eq idx assets.len) ""
    = item assets.at(idx)
    ? (equal url item.url) (http_foot/unbar item.bytes)
    | _ idx.inc
  + empty
    ^ http_foot/config
    | http_foot/config []
      (\ ignored (http_driver/response 404 "Not found"))
      (\ ignored (http_driver/response 404 "Not found"))
  + matches
    \ prefix=str url=str
    ^ bool
    ? (equal prefix "/") .true
    | http_foot/route_is prefix url
  + dispatch
    \ routes=row[http_foot/route] request=http_foot/request now=nat
    ^ http_foot/action
    = url (http_foot/split 63 request.target).at(0)
    % idx=nat 0 best=maybe[http_foot/route] .none
    ^ http_foot/action
    ? (eq idx routes.len)
      ?> (./some hit) best
        | ./reply (http_driver/response 404 "Not found")
      = run hit.plan
      | run request now
    = item routes.at(idx)
      longer
        ?> (./some hit) best .true
        | gt item.prefix.len hit.prefix.len
      next=maybe[http_foot/route]
        ? (and longer (http_foot/matches item.prefix url))
          | ./some item
        best
    | _ idx.inc next
  + route_collision
    \ prefix=str routes=row[http_foot/route] count=nat
    ^ bool
    % idx=nat 0
    ? (eq idx count) .false
    = item routes.at(idx)
    ? (equal[str] prefix item.prefix) .true
    | _ idx.inc
  + add_routes
    \ extra=row[http_foot/route] config=http_foot/config
    ^ http_foot/config
    = routes=row[http_foot/route] config.routes.weld(extra)
    % idx=nat 0
    ^ http_foot/config
    ? (eq idx routes.len) config.set_routes(routes)
    = item routes.at(idx)
    ? (http_foot/route_collision item.prefix routes idx)
      | http_foot/invalid_routes config
    | _ idx.inc
  + invalid_routes
    \ config=http_foot/config
    ^ http_foot/config
    ; (error (http_foot/fault "Duplicate HTTP route"))
    config

  + live_plan
    \ home=path bindings=row[[str str]]
      plan={\ http_foot/request nat}http_foot/action
      request=http_foot/request now=nat
    ^ http_foot/action
    = original (plan request now)
    ? !(equal request.method "GET") original
    = mime=maybe[nat]
        ? original
         > (./bytes status body mime) (? (eq status 200) (./some mime) .none)
         > (./reply response) (? (eq response.status 200) (./some response.ctype) .none)
        .none
    ?> (./some mime) mime original
    = url (http_foot/split 63 request.target).at(0)
    % idx=nat 0
    ^ http_foot/action
    ? (eq idx bindings.len) original
    = [route name] bindings.at(idx)
    ? (equal route url) (./asset home name mime)
    | _ idx.inc
  + live_assets
    ' Only manifest-declared asset URLs use the published mount bundle.
    \ home=path manifest=str config=http_foot/config
    ^ http_foot/config
    = bindings (mount_assets/bindings manifest)
    | config.set_routes
      | config.routes.map
        \ route=http_foot/route
        | route.set_plan (http_foot/live_plan home bindings route.plan)
