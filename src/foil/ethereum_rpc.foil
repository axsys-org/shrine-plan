- ethereum_transaction

+ ethereum_rpc
  + get
    \ key=str value=json
    ^ json
    ?> (json/obj fields) value jnull
    % i=nat 0
    ? (eq i fields.len) jnull
    = item fields.at(i)
    ? (equal item.k key) item.v
    | _ i.inc
  + text
    \ value=json
    ^ str
    ?> (json/str text) value
        | ethereum_bytes/fail_text "expected RPC string"
    text
  + number
    \ value=json
    ^ nat
    = text (ethereum_rpc/text value)
    ? (lt text.len 3) (error (pails/t "RPC quantity missing"))
    ? !(equal text.slice(0 2) "0x") (error (pails/t "RPC quantity prefix"))
    % i=nat 2 out=nat 0
    ? (eq i text.len) out
    | _ i.inc (add (mul out 16) (ethereum_bytes/nibble text.at(i)))
  + array
    \ value=json
    ^ row[json]
    ?> (json/arr values) value
        ; (error (pails/t "expected RPC array"))
        []
    values
  + bar
    \ bytes=nat
    ^ nat
    | add bytes (bex (mul 8 (wid bytes)))
  + post
    \ url=str headers=row[[nat nat]] body=json
    ^ json
    = ;response
        | Fetch [(ethereum_rpc/bar (str/to_atom "POST"))
            (ethereum_rpc/bar (str/to_atom url)) headers [(ethereum_rpc/bar (str/to_atom (show body)))]]
          [[5000] 30000 0 [2097152]]
    ?> (./ok fields) response
        ; (error (pails/t "RPC transport failed"))
        jnull
    = [status final_url response_headers body] fields
    ? !(eq status 200)
      ; (error (pails/t "RPC HTTP status"))
      jnull
    = text (str/from_atom (mod body (bex (mul 8 (dec (wid body))))))
    ?> (jres/ok value rest) (parse text)
        ; (error (pails/t "RPC JSON decode"))
        jnull
    value
  + request
    \ url=str method=str params=row[json]
    ^ json
    = body | json/obj [(jkv "jsonrpc" (json/str "2.0")) (jkv "id" (json/num .false 1))
        (jkv "method" (json/str method)) (jkv "params" (json/arr params))]
      headers=row[[nat nat]]
        [[(ethereum_rpc/bar (str/to_atom "Content-Type")) (ethereum_rpc/bar (str/to_atom "application/json"))]]
      ;reply (ethereum_rpc/post url headers body)
    ? !(equal (ethereum_rpc/get "error" reply) jnull)
      ; (error (pails/t "RPC error; retry the same wallet action"))
      jnull
    ? !(equal (ethereum_rpc/get "id" reply) (json/num .false 1))
      ; (error (pails/t "RPC response id mismatch"))
      jnull
    | ethereum_rpc/get "result" reply
  + block
    \ url=str number=nat
    ^ json
    | ethereum_rpc/request url "eth_getBlockByNumber"
      [(json/str (ethereum_transaction/quantity number)) (json/boo .false)]
