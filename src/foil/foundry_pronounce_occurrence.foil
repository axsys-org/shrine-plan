-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_view [order=40]
-  foundry_pronounce [order=50]
-  foundry_pronounce_hole [order=60]
'  Context lookup and construction of one pronounced occurrence.  Recursive
'  DAG traversal remains isolated in foundry_pronounce_walk.

+  foundry_pronounce_occurrence
  +  child_resolution_context
    '  projection_child stays a lightweight ordered edge view.  Resolve its
    '  optional cascade identity from the one canonical placement entry rather
    '  than copying or wrapping the DAG.
    \  child=projection_child view=projection_view
    ^  maybe[foundry_digest]
    ?  (foundry_delivery/live_placement child.placement view.dag.entries)
     > .none  .none
     > (./some placement=projection_placement)
       placement.resolution_context

  +  root_resolution_context
    '  A completed strict DAG has exactly one context scoped to every root.
    '  foundry_view/open proves that uniqueness before traversal reaches this
    '  lookup.  An empty table is the explicit legacy carrier and retains none.
    \  root=projection_address view=projection_view
    ^  maybe[foundry_digest]
    ?  (eq 0 view.dag.contexts.len)  .none
    ?  (foundry_delivery/resolution_context_at_scope
          root view.dag.contexts)
     > .none  .none
     > (./some context=projection_resolution_context)
       (./some context.digest)

  +  cursor_occurrence
    \  cursor=projection_cursor depth=nat
       parent=maybe[projection_address] context=maybe[projection_child]
       view=projection_view
    ^  projection_pronunciation_occurrence
    =  placement=maybe[projection_address]
         ?  context
          > .none  .none
          > (./some child=projection_child)  (./some child.placement)
       placement_role=maybe[path]
         ?  context
          > .none  .none
          > (./some child=projection_child)  (./some child.role)
       placement_parameters=row[projection_parameter]
         ?  context
          > .none  []
          > (./some child=projection_child)  child.parameters
       resolution_context=maybe[foundry_digest]
         ?  context
          > .none
            (foundry_pronounce_occurrence/root_resolution_context
              cursor.address view)
          > (./some child=projection_child)
            (foundry_pronounce_occurrence/child_resolution_context child view)
    (projection_pronunciation_occurrence (./some cursor.address) placement
      parent depth cursor.kind cursor.role cursor.parameters placement_role
      placement_parameters resolution_context
      (foundry_pronounce_hole/cursor_hole cursor))

  +  inline_hole_occurrence
    \  parent=projection_cursor child=projection_child hole=projection_hole
       depth=nat view=projection_view
    ^  projection_pronunciation_occurrence
    (projection_pronunciation_occurrence .none (./some child.placement)
      (./some parent.address) depth hole.kind hole.role hole.parameters
      (./some child.role) child.parameters
      (foundry_pronounce_occurrence/child_resolution_context child view)
      (./some (foundry_pronounce_hole/hole_of hole)))
