-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_web_policy_result [order=50]
-  chat_foundry_web_policy_scene_shell [order=60]
-  chat_foundry_web_policy_scene_after_shell [order=70]
'  Ordered dispatcher for quarantined compatibility policy covering the Chat
'  Scene, navigation, conversation, and content roles.
+  chat_foundry_web_policy_scene
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    =  shell
         (chat_foundry_web_policy_scene_shell/plan_policy occurrence children)
    ?  shell.matched  shell
    (chat_foundry_web_policy_scene_after_shell/plan_policy
      occurrence children)
