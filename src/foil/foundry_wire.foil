-  sept [order=10]
-  shrine_types [order=20]
-  json [order=30]
-  tyshow [order=40]
-  foundry_delivery [order=50]
-  foundry_fragment [order=60]
'  foundry_wire: the mechanical JSON pronunciation of the addressed Foundry
'  delivery protocol.  This module does not compile, select, admit, cache, or
'  render a projection.  It preserves the semantic packet exactly and keeps
'  optional terminal pronunciations in a separate envelope.

+  projection_wire_encoding
  &  projection_wire_encoding/admitted
     projection_wire_encoding/refused

  +  admitted
    :  body=nat
  +  refused
    :  code=iota at=path

+  projection_terminal_pronunciation
  '  Compatibility input for the original HTML wire surface.  Encoding first
  '  lifts it into a versioned projection_fragment; new handlers should emit
  '  that canonical envelope directly.
  :  semantic=projection_address
     target=nat
     media=nat
     body=nat
     cache_policy=iota

+  foundry_wire
  +  hex_digit
    \  n=nat
    ^  nat
    ?  (lt n 10)
       (add "0" n)
    (add "a" (sub n 10))

  +  byte_hex
    \  n=nat
    ^  nat
    (cat2 (foundry_wire/hex_digit (div n 16))
      (foundry_wire/hex_digit (mod n 16)))

  +  digest_text_unchecked
    \  digest=foundry_digest
    ^  nat
    |  > i=nat 0  > out=nat ""
    ?  (eq i digest.len)
       out
    (_ i.inc (cat2 out (foundry_wire/byte_hex digest.at(i))))

  +  digest_text
    '  A pin digest is exactly 32 bytes and always travels as 64 lowercase
    '  hexadecimal characters.  Invalid digests are refused, never truncated.
    \  digest=foundry_digest
    ^  projection_wire_encoding
    ?  (foundry_digest/valid digest)
       (projection_wire_encoding/admitted
         (foundry_wire/digest_text_unchecked digest))
    (projection_wire_encoding/refused 'invalid_digest ['wire 'digest])

  +  axis_text
    '  Axis iotas are serialized by their exact natural value, not by a route
    '  or display spelling.  Each structural constructor has its own prefix.
    \  axis=projection_axis
    ^  nat
    ?  axis
     > x=projection_axis/kid
       (cat2 "k:" (show_nat x.index))
     > x=projection_axis/slot
       (cat2 "s:"
         (cat2 (show_nat (aura_rank x.name))
           (cat2 ":" (show_nat (quip_val x.name)))))
     > x=projection_axis/arg
       (cat2 "a:" (show_nat x.index))
     > x=projection_axis/leg
       (cat2 "l:" (show_nat x.index))
     > x=projection_axis/branch
       (cat2 "b:"
         (cat2 (show_nat (aura_rank x.name))
           (cat2 ":" (show_nat (quip_val x.name)))))

  +  address_text_unchecked
    \  address=projection_address
    ^  nat
    |  > i=nat 0
       > out=nat (foundry_wire/digest_text_unchecked address.source)
    ?  (eq i address.axis.len)
       out
    (_ i.inc
      (cat2 out
        (cat2 "/" (foundry_wire/axis_text address.axis.at(i)))))

  +  address_text
    '  Canonical occurrence identity: immutable source-pin digest followed by
    '  an ordered, typed structural axis.  Namespace paths never enter it.
    \  address=projection_address
    ^  projection_wire_encoding
    ?  (foundry_delivery/address_valid address)
       (projection_wire_encoding/admitted
         (foundry_wire/address_text_unchecked address))
    (projection_wire_encoding/refused 'invalid_address ['wire 'address])

  +  atom_json
    \  atom=iota
    ^  json
    (json/str (tyshow/atom_text (quip_val atom)))

  +  path_json
    \  value=path
    ^  json
    (json/arr value.map(foundry_wire/atom_json))

  +  address_json_value
    \  address=projection_address
    ^  json
    (json/str (foundry_wire/address_text_unchecked address))

  +  addresses_json
    \  addresses=row[projection_address]
    ^  json
    (json/arr addresses.map(foundry_wire/address_json_value))

  +  digest_json_value
    \  digest=foundry_digest
    ^  json
    (json/str (foundry_wire/digest_text_unchecked digest))

  +  digests_json
    \  digests=row[foundry_digest]
    ^  json
    (json/arr digests.map(foundry_wire/digest_json_value))

  +  maybe_digest_json
    \  digest=maybe[foundry_digest]
    ^  json
    ?  digest
     > .none  jnull
     > (./some value=foundry_digest)
       (foundry_wire/digest_json_value value)

  +  maybe_address_json
    \  address=maybe[projection_address]
    ^  json
    ?  address
     > .none  jnull
     > (./some at=projection_address)
       (foundry_wire/address_json_value at)

  +  maybe_path_json
    \  value=maybe[path]
    ^  json
    ?  value
     > .none  jnull
     > (./some p=path)  (foundry_wire/path_json p)

  +  value_json
    \  value=projection_value
    ^  json
    ?  value
     > x=projection_value/flag
       (json/obj [(jkv "kind" (json/str "flag"))
                  (jkv "value" (json/boo x.value))])
     > x=projection_value/count
       (json/obj [(jkv "kind" (json/str "count"))
                  (jkv "value" (json/num .false x.value))])
     > x=projection_value/text
       (json/obj [(jkv "kind" (json/str "text"))
                  (jkv "value" (json/str x.value))])
     > x=projection_value/name
       (json/obj [(jkv "kind" (json/str "name"))
                  (jkv "value" (foundry_wire/atom_json x.value))])
     > x=projection_value/semantic_ref
       (json/obj [(jkv "kind" (json/str "semantic-ref"))
                  (jkv "value" (foundry_wire/path_json x.value))])
     > x=projection_value/ref
       (json/obj [(jkv "kind" (json/str "ref"))
                  (jkv "value" (foundry_wire/address_json_value x.value))])

  +  guard_provenance_json
    \  guard=projection_guard_provenance
    ^  json
    ?  guard
     > projection_guard_provenance/unguarded
       (json/obj [(jkv "kind" (json/str "unguarded"))])
     > x=projection_guard_provenance/guarded
       (json/obj
         [(jkv "kind" (json/str "guarded"))
          (jkv "policy" (foundry_wire/digest_json_value x.policy))
          (jkv "witness" (foundry_wire/digest_json_value x.witness))])

  +  resolution_delta_json
    \  delta=projection_resolution_delta
    ^  json
    (json/obj
      [(jkv "key" (foundry_wire/path_json delta.key))
       (jkv "value" (foundry_wire/value_json delta.value))
       (jkv "winner" (foundry_wire/digest_json_value delta.winner))
       (jkv "provenance"
         (foundry_wire/guard_provenance_json delta.guard))])

  +  resolution_context_json
    \  context=projection_resolution_context
    ^  json
    (json/obj
      [(jkv "digest" (foundry_wire/digest_json_value context.digest))
       (jkv "parent" (foundry_wire/maybe_digest_json context.parent))
       (jkv "scope" (foundry_wire/address_json_value context.scope))
       (jkv "localLayers"
         (foundry_wire/digests_json context.local_layers))
       (jkv "deltas"
         (json/arr context.deltas.map(
           foundry_wire/resolution_delta_json)))])

  +  resolution_contexts_json
    \  contexts=row[projection_resolution_context]
    ^  json
    (json/arr contexts.map(foundry_wire/resolution_context_json))

  +  parameter_json
    \  parameter=projection_parameter
    ^  json
    (json/obj
      [(jkv "key" (foundry_wire/path_json parameter.key))
       (jkv "value" (foundry_wire/value_json parameter.value))])

  +  parameters_json
    \  parameters=row[projection_parameter]
    ^  json
    (json/arr parameters.map(foundry_wire/parameter_json))

  +  hole_json
    \  hole=projection_hole
    ^  json
    (json/obj
      [(jkv "role" (foundry_wire/path_json hole.role))
       (jkv "kind" (foundry_wire/atom_json hole.kind))
       (jkv "fallback" (foundry_wire/maybe_address_json hole.fallback))
       (jkv "semanticFallback"
         (foundry_wire/maybe_path_json hole.semantic_fallback))
       (jkv "parameters"
         (foundry_wire/parameters_json hole.parameters))])

  +  syntax_json
    \  syntax=projection_syntax
    ^  json
    (json/obj
      [(jkv "kind" (foundry_wire/atom_json syntax.kind))
       (jkv "role" (foundry_wire/path_json syntax.role))
       (jkv "recipe"
         (json/str (foundry_wire/digest_text_unchecked syntax.recipe)))
       (jkv "parameters"
         (foundry_wire/parameters_json syntax.parameters))
       (jkv "placements"
         (foundry_wire/addresses_json syntax.placements))
       (jkv "dependencies"
         (foundry_wire/addresses_json syntax.dependencies))
       (jkv "fallback"
         (foundry_wire/maybe_address_json syntax.fallback))])

  +  node_json
    \  node=projection_node
    ^  json
    =  body
         ?  node.body
          > x=projection_node_body/semantic
            (json/obj
              [(jkv "kind" (json/str "semantic"))
               (jkv "syntax" (foundry_wire/syntax_json x.syntax))])
          > x=projection_node_body/hole
            (json/obj
              [(jkv "kind" (json/str "hole"))
               (jkv "hole" (foundry_wire/hole_json x.hole))])
    (json/obj
      [(jkv "address" (foundry_wire/address_json_value node.address))
       (jkv "body" body)])

  +  placement_target_json
    \  target=projection_placement_target
    ^  json
    ?  target
     > x=projection_placement_target/child
       (json/obj
         [(jkv "kind" (json/str "child"))
          (jkv "address" (foundry_wire/address_json_value x.address))])
     > x=projection_placement_target/hole
       (json/obj
         [(jkv "kind" (json/str "hole"))
          (jkv "hole" (foundry_wire/hole_json x.hole))])

  +  placement_json
    \  placement=projection_placement
    ^  json
    (json/obj
      [(jkv "address"
         (foundry_wire/address_json_value placement.address))
       (jkv "parent"
         (foundry_wire/address_json_value placement.parent))
       (jkv "role" (foundry_wire/path_json placement.role))
       (jkv "parameters"
         (foundry_wire/parameters_json placement.parameters))
       (jkv "resolutionContext"
         (foundry_wire/maybe_digest_json placement.resolution_context))
       (jkv "target"
         (foundry_wire/placement_target_json placement.target))])

  +  action_mount_json
    \  mount=projection_action_mount
    ^  json
    (json/obj
      [(jkv "action" (foundry_wire/path_json mount.action))
       (jkv "pin"
         (json/str (foundry_wire/digest_text_unchecked mount.pin)))
       (jkv "input" (foundry_wire/path_json mount.input))
       (jkv "admission"
         (json/str (foundry_wire/digest_text_unchecked mount.admission)))])

  +  destination_mount_json
    \  mount=projection_destination_mount
    ^  json
    (json/obj
      [(jkv "declaration" (foundry_wire/path_json mount.declaration))
       (jkv "target" (foundry_wire/address_json_value mount.target))])

  +  maybe_destination_mount_json
    \  mount=maybe[projection_destination_mount]
    ^  json
    ?  mount
     > .none  jnull
     > (./some value=projection_destination_mount)
       (foundry_wire/destination_mount_json value)

  +  interaction_json
    \  interaction=projection_interaction
    ^  json
    (json/obj
      [(jkv "address"
         (foundry_wire/address_json_value interaction.address))
       (jkv "owner" (foundry_wire/address_json_value interaction.owner))
       (jkv "actions"
         (json/arr interaction.actions.map(foundry_wire/action_mount_json)))
       (jkv "destination"
         (foundry_wire/maybe_destination_mount_json
           interaction.destination))])

  +  object_json
    \  object=projection_object
    ^  json
    ?  object
     > x=projection_object/node
       (json/obj
         [(jkv "kind" (json/str "node"))
          (jkv "node" (foundry_wire/node_json x.node))])
     > x=projection_object/placement
       (json/obj
         [(jkv "kind" (json/str "placement"))
          (jkv "placement" (foundry_wire/placement_json x.placement))])
     > x=projection_object/interaction
       (json/obj
         [(jkv "kind" (json/str "interaction"))
          (jkv "interaction"
            (foundry_wire/interaction_json x.interaction))])

  +  entry_json_value
    \  entry=projection_entry
    ^  json
    ?  entry
     > x=projection_entry/node
       (json/obj
         [(jkv "address" (foundry_wire/address_json_value x.node.address))
          (jkv "entryKind" (json/str "node"))
          (jkv "hole" (json/boo
            (foundry_delivery/entry_hole entry)))
          (jkv "object"
            (foundry_wire/object_json (projection_object/node x.node)))])
     > x=projection_entry/placement
       (json/obj
         [(jkv "address"
            (foundry_wire/address_json_value x.placement.address))
          (jkv "entryKind" (json/str "placement"))
          (jkv "hole" (json/boo
            (foundry_delivery/entry_hole entry)))
          (jkv "object"
            (foundry_wire/object_json
              (projection_object/placement x.placement)))])
     > x=projection_entry/interaction
       (json/obj
         [(jkv "address"
            (foundry_wire/address_json_value x.interaction.address))
          (jkv "entryKind" (json/str "interaction"))
          (jkv "hole" (json/boo .false))
          (jkv "object"
            (foundry_wire/object_json
              (projection_object/interaction x.interaction)))])
     > x=projection_entry/tombstone
       (json/obj
         [(jkv "address"
            (foundry_wire/address_json_value x.tombstone.address))
          (jkv "entryKind" (json/str "tombstone"))
          (jkv "hole" (json/boo .false))
          (jkv "object"
            (json/obj
              [(jkv "target" (foundry_wire/atom_json x.tombstone.target))]))])

  +  entry_valid
    \  entry=projection_entry
    ^  bool
    ?  entry
     > x=projection_entry/node
       (foundry_delivery/object_valid (projection_object/node x.node))
     > x=projection_entry/placement
       (foundry_delivery/object_valid
         (projection_object/placement x.placement))
     > x=projection_entry/interaction
       (foundry_delivery/object_valid
         (projection_object/interaction x.interaction))
     > x=projection_entry/tombstone
       ?  !(foundry_delivery/address_valid x.tombstone.address)
          .false
       (foundry_delivery/known_target x.tombstone.target)

  +  manifest_json_value
    \  manifest=projection_manifest
    ^  json
    (json/obj
      [(jkv "revision"
         (json/str
           (foundry_wire/digest_text_unchecked manifest.revision)))
       (jkv "roots" (foundry_wire/addresses_json manifest.roots))
       (jkv "retain" (foundry_wire/addresses_json manifest.retain))
       (jkv "frontier" (foundry_wire/addresses_json manifest.frontier))])

  +  manifest_json
    \  manifest=projection_manifest
    ^  projection_wire_encoding
    ?  (foundry_delivery/manifest_valid manifest)
       (projection_wire_encoding/admitted
         (show (foundry_wire/manifest_json_value manifest)))
    (projection_wire_encoding/refused
      'invalid_manifest ['wire 'manifest])

  +  entry_json
    \  entry=projection_entry
    ^  projection_wire_encoding
    ?  (foundry_wire/entry_valid entry)
       (projection_wire_encoding/admitted
         (show (foundry_wire/entry_json_value entry)))
    (projection_wire_encoding/refused 'invalid_entry ['wire 'entry])

  +  frame_valid
    \  frame=projection_frame
    ^  bool
    ?  frame
     > x=projection_frame/begin
       ?  !(foundry_delivery/manifest_valid x.manifest)  .false
       (foundry_delivery/resolution_contexts_intrinsic_valid x.contexts)
     > x=projection_frame/upsert
       ?  !(foundry_delivery/manifest_valid x.manifest)  .false
       (foundry_delivery/object_valid x.object)
     > x=projection_frame/resolve
       ?  !(foundry_delivery/manifest_valid x.manifest)  .false
       ?  !(foundry_delivery/address_valid x.address)  .false
       ?  !(foundry_delivery/object_valid x.object)  .false
       (equal x.address (foundry_delivery/object_address x.object))
     > x=projection_frame/withdraw
       ?  !(foundry_delivery/manifest_valid x.manifest)  .false
       ?  !(foundry_delivery/address_valid x.address)  .false
       (foundry_delivery/known_target x.target)
     > x=projection_frame/complete
       (foundry_delivery/manifest_valid x.manifest)
     > x=projection_frame/refuse
       (foundry_delivery/manifest_valid x.manifest)

  +  frame_manifest
    \  frame=projection_frame
    ^  projection_manifest
    ?  frame
     > x=projection_frame/begin     x.manifest
     > x=projection_frame/upsert    x.manifest
     > x=projection_frame/resolve   x.manifest
     > x=projection_frame/withdraw  x.manifest
     > x=projection_frame/complete  x.manifest
     > x=projection_frame/refuse    x.manifest

  +  frame_json_value
    \  packet=nat frame=projection_frame
    ^  json
    =  manifest (foundry_wire/frame_manifest frame)
       base
         [(jkv "packet" (json/str packet))
          (jkv "manifest" (foundry_wire/manifest_json_value manifest))]
    ?  frame
     > x=projection_frame/begin
       (json/obj
         base.weld(
           [(jkv "type" (json/str "begin"))
            (jkv "contexts"
              (foundry_wire/resolution_contexts_json x.contexts))
            (jkv "cachePolicy" (json/str "non-authoritative"))]))
     > x=projection_frame/upsert
       =  object x.object
          address (foundry_delivery/object_address object)
       (json/obj
         base.weld(
           [(jkv "type" (json/str "upsert"))
            (jkv "address" (foundry_wire/address_json_value address))
            (jkv "entryKind"
              (foundry_wire/atom_json
                (foundry_delivery/object_kind object)))
            (jkv "hole" (json/boo
              (foundry_delivery/object_hole object)))
            (jkv "object" (foundry_wire/object_json object))]))
     > x=projection_frame/resolve
       (json/obj
         base.weld(
           [(jkv "type" (json/str "resolve"))
            (jkv "address"
              (foundry_wire/address_json_value x.address))
            (jkv "entryKind"
              (foundry_wire/atom_json
                (foundry_delivery/object_kind x.object)))
            (jkv "hole" (json/boo
              (foundry_delivery/object_hole x.object)))
            (jkv "object" (foundry_wire/object_json x.object))]))
     > x=projection_frame/withdraw
       (json/obj
         base.weld(
           [(jkv "type" (json/str "withdraw"))
            (jkv "address"
              (foundry_wire/address_json_value x.address))
            (jkv "entryKind" (foundry_wire/atom_json x.target))]))
     > projection_frame/complete
       (json/obj base.weld([(jkv "type" (json/str "complete"))]))
     > x=projection_frame/refuse
       (json/obj
         base.weld(
           [(jkv "type" (json/str "refuse"))
            (jkv "code" (foundry_wire/atom_json x.code))]))

  +  frame_json
    \  packet=nat frame=projection_frame
    ^  projection_wire_encoding
    ?  (eq packet 0)
       (projection_wire_encoding/refused
         'empty_packet_id ['wire 'packet])
    ?  !(foundry_wire/frame_valid frame)
       (projection_wire_encoding/refused
         'invalid_frame ['wire 'frame])
    (projection_wire_encoding/admitted
      (show (foundry_wire/frame_json_value packet frame)))

  +  frames_valid
    \  frames=row[projection_frame]
    ^  bool
    frames.all(foundry_wire/frame_valid)

  +  frames_json
    '  One fetch may carry a complete frame batch or a progressive prefix.
    '  Sequence admission remains foundry_delivery's job; this is a codec.
    \  packet=nat frames=row[projection_frame]
    ^  projection_wire_encoding
    ?  (eq packet 0)
       (projection_wire_encoding/refused
         'empty_packet_id ['wire 'packet])
    ?  !(foundry_wire/frames_valid frames)
       (projection_wire_encoding/refused
         'invalid_frame ['wire 'frames])
    (projection_wire_encoding/admitted
      (show (json/obj
        [(jkv "packet" (json/str packet))
         (jkv "frames"
           (json/arr frames.map(
             (\ frame
               (foundry_wire/frame_json_value packet frame))))) ])))

  +  fragment_cache_json
    \  cache=projection_fragment_cache
    ^  json
    (json/obj
      [(jkv "policy" (json/str
         (foundry_wire/cache_policy_text cache.policy)))
       (jkv "key" (foundry_wire/maybe_digest_json cache.key))
       (jkv "authority" (json/str "none"))])

  +  fragment_provenance_json
    \  provenance=projection_fragment_provenance
    ^  json
    (json/obj
      [(jkv "handler" (foundry_wire/path_json provenance.handler))
       (jkv "evidence"
         (foundry_wire/maybe_digest_json provenance.evidence))])

  +  fragment_refusal_json
    \  refusal=maybe[projection_fragment_refusal]
    ^  json
    ?  refusal
     > .none  jnull
     > (./some value=projection_fragment_refusal)
       (json/obj
         [(jkv "code" (foundry_wire/atom_json value.code))
          (jkv "detail" (json/str value.detail))])

  +  fragment_json_value
    '  Canonical Fragment wire value.  Version 1 HTML payloads retain the
    '  historical `html`, `media`, `target`, and `cachePolicy` fields while
    '  also exposing the general codec/body/cache/provenance/refusal envelope.
    \  fragment=projection_fragment
    ^  json
    =  common
         [(jkv "version" (json/num .false fragment.version))
          (jkv "semanticAddress"
            (foundry_wire/address_json_value fragment.semantic))
          (jkv "target" (json/str fragment.target))
          (jkv "authority" (json/str "none"))
          (jkv "cachePolicy" (json/str
            (foundry_wire/cache_policy_text fragment.cache.policy)))
          (jkv "cache" (foundry_wire/fragment_cache_json fragment.cache))
          (jkv "provenance"
            (foundry_wire/fragment_provenance_json fragment.provenance))
          (jkv "refusal"
            (foundry_wire/fragment_refusal_json fragment.refusal))]
    ?  fragment.payload
     > .none
       (json/obj common.weld(
         [(jkv "codec" jnull) (jkv "media" jnull) (jkv "body" jnull)]))
     > (./some payload=projection_fragment_payload)
       =  fields
            common.weld(
              [(jkv "codec" (foundry_wire/atom_json payload.codec))
               (jkv "media" (json/str payload.media))
               (jkv "body" (json/str payload.body))])
       ?  (eq_iota payload.codec 'html)
          (json/obj fields.snoc((jkv "html" (json/str payload.body))))
       (json/obj fields)

  +  fragment_json
    \  fragment=projection_fragment
    ^  projection_wire_encoding
    ?  !(foundry_fragment/valid fragment)
       (projection_wire_encoding/refused
         'invalid_fragment ['wire 'fragment])
    (projection_wire_encoding/admitted
      (show (foundry_wire/fragment_json_value fragment)))

  +  terminal_fragment
    '  Lift the historical terminal pronunciation into Fragment version 1.
    '  Non-HTML legacy media uses the opaque codec; HTML retains its alias.
    \  pronunciation=projection_terminal_pronunciation
    ^  projection_fragment
    =  codec=iota
         ?  (eq pronunciation.media "text/html")
            'html
         'opaque
    (foundry_fragment/make pronunciation.semantic pronunciation.target codec
      pronunciation.media pronunciation.body pronunciation.cache_policy
      ['compat 'projection_terminal_pronunciation] .none)

  +  terminal_valid
    \  pronunciation=projection_terminal_pronunciation
    ^  bool
    (foundry_fragment/valid
      (foundry_wire/terminal_fragment pronunciation))

  +  cache_policy_text
    \  policy=iota
    ^  nat
    ?  (eq_iota policy 'non_authoritative)
       "non-authoritative"
    "none"

  +  terminal_json_value
    \  pronunciation=projection_terminal_pronunciation
    ^  json
    (foundry_wire/fragment_json_value
      (foundry_wire/terminal_fragment pronunciation))

  +  terminal_json
    '  Terminal data is deliberately not merged into frame.object.  A codec
    '  consumer may pair this replaceable pronunciation with the semantic
    '  occurrence named by semanticAddress.
    \  pronunciation=projection_terminal_pronunciation
    ^  projection_wire_encoding
    ?  !(foundry_wire/terminal_valid pronunciation)
       (projection_wire_encoding/refused
         'invalid_terminal_pronunciation ['wire 'terminal])
    (projection_wire_encoding/admitted
      (show (foundry_wire/terminal_json_value pronunciation)))

  +  frame_address
    '  Only object-bearing frames can carry a replaceable pronunciation.
    \  frame=projection_frame
    ^  maybe[projection_address]
    ?  frame
     > projection_frame/begin      .none
     > x=projection_frame/upsert
       (./some (foundry_delivery/object_address x.object))
     > x=projection_frame/resolve  (./some x.address)
     > projection_frame/withdraw   .none
     > projection_frame/complete   .none
     > projection_frame/refuse     .none

  +  terminal_frame_index
    '  The latest matching object frame owns the pronunciation.  Thus an
    '  Upsert(hole), Resolve(value) batch paints only the resolved value.
    \  semantic=projection_address frames=row[projection_frame]
    ^  maybe[nat]
    |  > i=nat 0  > hit=maybe[nat] .none
    ?  (eq i frames.len)
       hit
    ?  (foundry_wire/frame_address frames.at(i))
     > .none  (_ i.inc hit)
     > (./some at=projection_address)
       ?  (equal semantic at)
          (_ i.inc (./some i))
       (_ i.inc hit)

  +  duplicate_terminal
    \  index=nat terminals=row[projection_terminal_pronunciation]
    ^  bool
    |  > i=nat 0
    ?  (eq i index)
       .false
    ?  (equal terminals.at(index).semantic terminals.at(i).semantic)
       .true
    (_ i.inc)

  +  terminal_issue
    \  frames=row[projection_frame]
       terminals=row[projection_terminal_pronunciation]
    ^  maybe[iota]
    |  > i=nat 0
    ^  maybe[iota]
    ?  (eq i terminals.len)
       .none
    =  terminal terminals.at(i)
    ?  !(foundry_wire/terminal_valid terminal)
       (./some 'invalid_terminal_pronunciation)
    ?  (foundry_wire/duplicate_terminal i terminals)
       (./some 'duplicate_terminal_pronunciation)
    ?  (foundry_wire/terminal_frame_index terminal.semantic frames)
     > .none  (./some 'unmatched_terminal_pronunciation)
     > (./some _)  (_ i.inc)

  +  terminal_at_frame
    \  index=nat frames=row[projection_frame]
       terminals=row[projection_terminal_pronunciation]
    ^  maybe[projection_terminal_pronunciation]
    |  > i=nat 0
    ^  maybe[projection_terminal_pronunciation]
    ?  (eq i terminals.len)
       .none
    =  terminal terminals.at(i)
    ?  (foundry_wire/terminal_frame_index terminal.semantic frames)
     > .none  (_ i.inc)
     > (./some target=nat)
       ?  (eq target index)
          (./some terminal)
       (_ i.inc)

  +  duplicate_fragment
    \  index=nat fragments=row[projection_fragment]
    ^  bool
    |  > i=nat 0
    ?  (eq i index)
       .false
    ?  (equal fragments.at(index).semantic fragments.at(i).semantic)
       .true
    (_ i.inc)

  +  fragment_issue
    \  frames=row[projection_frame] fragments=row[projection_fragment]
    ^  maybe[iota]
    |  > i=nat 0
    ^  maybe[iota]
    ?  (eq i fragments.len)
       .none
    =  fragment fragments.at(i)
    ?  !(foundry_fragment/valid fragment)
       (./some 'invalid_fragment)
    ?  (foundry_wire/duplicate_fragment i fragments)
       (./some 'duplicate_fragment)
    ?  (foundry_wire/terminal_frame_index fragment.semantic frames)
     > .none  (./some 'unmatched_fragment)
     > (./some _)  (_ i.inc)

  +  fragment_at_frame
    \  index=nat frames=row[projection_frame]
       fragments=row[projection_fragment]
    ^  maybe[projection_fragment]
    |  > i=nat 0
    ^  maybe[projection_fragment]
    ?  (eq i fragments.len)
       .none
    =  fragment fragments.at(i)
    ?  (foundry_wire/terminal_frame_index fragment.semantic frames)
     > .none  (_ i.inc)
     > (./some target=nat)
       ?  (eq target index)
          (./some fragment)
       (_ i.inc)

  +  frame_json_with_fragment
    '  Fragment is a sibling of the semantic object and cannot change it.
    \  packet=nat frame=projection_frame fragment=maybe[projection_fragment]
    ^  json
    =  base (foundry_wire/frame_json_value packet frame)
    ?  fragment
     > .none  base
     > (./some value=projection_fragment)
       ?  base
        > object=json/obj
          (json/obj object.kvs.snoc(
            (jkv "fragment" (foundry_wire/fragment_json_value value))))
        > json/nul   base
        > json/boo   base
        > json/num   base
        > json/real  base
        > json/str   base
        > json/arr   base

  +  frames_with_fragments_json
    '  Pair versioned terminal Fragments with the latest exact Upsert/Resolve
    '  for their semantic occurrence.  Handlers remain non-authoritative:
    '  they can provide a payload or terminal refusal, never alter DAG state.
    \  packet=nat frames=row[projection_frame]
       fragments=row[projection_fragment]
    ^  projection_wire_encoding
    ?  (eq packet 0)
       (projection_wire_encoding/refused
         'empty_packet_id ['wire 'packet])
    ?  !(foundry_wire/frames_valid frames)
       (projection_wire_encoding/refused
         'invalid_frame ['wire 'frames])
    ?  (foundry_wire/fragment_issue frames fragments)
     > (./some code=iota)
       (projection_wire_encoding/refused code ['wire 'fragments])
     > .none
       =  values
            |  > i=nat 0  > out=row[json] []
            ^  row[json]
            ?  (eq i frames.len)
               out
            (_ i.inc out.snoc(
              (foundry_wire/frame_json_with_fragment packet frames.at(i)
                (foundry_wire/fragment_at_frame i frames fragments))))
       (projection_wire_encoding/admitted
         (show (json/obj
           [(jkv "packet" (json/str packet))
            (jkv "frames" (json/arr values))])))

  +  frame_json_with_terminal
    \  packet=nat frame=projection_frame
       terminal=maybe[projection_terminal_pronunciation]
    ^  json
    =  base (foundry_wire/frame_json_value packet frame)
    ?  terminal
     > .none  base
     > (./some pronunciation=projection_terminal_pronunciation)
       ?  base
        > object=json/obj
          (json/obj object.kvs.snoc(
            (jkv "pronunciation"
              (foundry_wire/terminal_json_value pronunciation))))
        > json/nul   base
        > json/boo   base
        > json/num   base
        > json/real  base
        > json/str   base
        > json/arr   base

  +  frames_with_terminals_json
    '  Pair replaceable renderer payloads with exact semantic Upsert/Resolve
    '  envelopes.  They remain siblings of object, never members of it.
    \  packet=nat frames=row[projection_frame]
       terminals=row[projection_terminal_pronunciation]
    ^  projection_wire_encoding
    ?  (eq packet 0)
       (projection_wire_encoding/refused
         'empty_packet_id ['wire 'packet])
    ?  !(foundry_wire/frames_valid frames)
       (projection_wire_encoding/refused
         'invalid_frame ['wire 'frames])
    ?  (foundry_wire/terminal_issue frames terminals)
     > (./some code=iota)
       (projection_wire_encoding/refused code ['wire 'terminals])
     > .none
       =  values
            |  > i=nat 0  > out=row[json] []
            ^  row[json]
            ?  (eq i frames.len)
               out
            (_ i.inc out.snoc(
              (foundry_wire/frame_json_with_terminal packet frames.at(i)
                (foundry_wire/terminal_at_frame i frames terminals))))
       (projection_wire_encoding/admitted
         (show (json/obj
           [(jkv "packet" (json/str packet))
            (jkv "frames" (json/arr values))])))

  +  encoding_admitted
    \  encoding=projection_wire_encoding
    ^  bool
    ?  encoding
     > projection_wire_encoding/admitted  .true
     > projection_wire_encoding/refused   .false

  +  encoding_body
    \  encoding=projection_wire_encoding
    ^  maybe[nat]
    ?  encoding
     > x=projection_wire_encoding/admitted  (./some x.body)
     > projection_wire_encoding/refused     .none

  +  encoding_code
    \  encoding=projection_wire_encoding
    ^  maybe[iota]
    ?  encoding
     > projection_wire_encoding/admitted    .none
     > x=projection_wire_encoding/refused   (./some x.code)

  +  encoding_at
    \  encoding=projection_wire_encoding
    ^  maybe[path]
    ?  encoding
     > projection_wire_encoding/admitted    .none
     > x=projection_wire_encoding/refused   (./some x.at)

  +  refusal_json
    '  Stable RFC-7807-like body for the mechanical HTTP adapter.
    \  code=iota at=path
    ^  nat
    (show (json/obj
      [(jkv "type" (json/str "about:blank"))
       (jkv "title" (json/str "Projection refused"))
       (jkv "code" (foundry_wire/atom_json code))
       (jkv "at" (foundry_wire/path_json at))]))
