- goo
- grove_roles

' A frontend target, independent of HTML rendering and namespace installation.
' Imported role field types and native constructors are explicit inputs; no
' reflection fallback or competing-view precedence is chosen here.
+ grove_views
  + context
    : root=path document=grove/document lookup={\ path}maybe[myth]
      roles=list[goo/role] renderers=list[goo/renderer] views=list[goo/view]
  + is_view
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/view))
    .false
  + is_pane
    \ body=list[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/pane))
    .false
  + is_goo
    \ body=list[grove/statement]
    ^ bool
    ? (grove_views/is_view body) .true
    | grove_views/is_pane body
  + reference
    \ root=path doc=grove/document lookup={\ path}maybe[myth] tree=rex
    ^ either[grove/error path]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "quip"))
        ? !(eq (str/slice 0 2 text) "'/")
          | goo/fail[path] span "Expected an absolute path."
        > (./some value) (path_parse (str/slice 1 (dec text.len) text))
          | goo/fail[path] span "Invalid absolute path."
        | ./ok value
      | grove_roles/slot root doc lookup tree
    | grove_roles/slot root doc lookup tree
  + finish
    \ root=path span=rex/source_span name=str role=maybe[path]
      slot=maybe[path] code=maybe[goo/body]
    ^ either[grove/error goo/view]
    > (./some role) role
      | goo/fail[goo/view] span "View requires one #on role."
    > (./some slot) slot
      | goo/fail[goo/view] span "View requires one #for slot."
    > (./some code) code
      | goo/fail[goo/view] span "View requires a Goo body."
    | ./ok (goo/view span root.snoc(($ts name)) role slot code.binding code.children .false .nil)
  + is_presentation
    \ stmt=grove/statement
    ^ bool
    ? stmt
     > (grove/presentation at trees) .true
    .false
  + declaration
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span name=str body=list[grove/statement]
    ^ either[grove/error goo/view]
    ? (and (grove_views/is_view body) (grove_views/is_pane body))
      | goo/fail[goo/view] span "A declaration cannot be both @view and @pane."
    % rest=list[grove/statement] body role=maybe[path] .none
      slot=maybe[path] .none code=maybe[goo/body] .none ports=list[path] .nil
    ^ either[grove/error goo/view]
    ? (eq rest.len 0)
      < view (grove_views/finish root span name role slot code)
      | ./ok view.set_is_pane((grove_views/is_pane body)).set_ports(ports.reverse)
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) role slot code ports)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/view)) || (equal kind (grove/tag_kind/pane))) (_ rest.drop(1) role slot code ports)
      | goo/fail[goo/view] at "Incompatible view tag."
     > (grove/block at kind kids)
      ? (equal kind (grove/block_kind/meta)) (_ rest.drop(1) role slot code ports)
      | goo/fail[goo/view] at "Only #meta blocks are allowed on views."
     > (grove/directive at kind target)
      < path (grove_views/reference root doc lookup target)
      ? (equal kind (grove/directive_kind/port))
        ? !(grove_views/is_pane body)
          | goo/fail[goo/view] at "Selection ports require @pane."
        ? (ports.has(path))
          | goo/fail[goo/view] at "Duplicate selection port."
        | _ rest.drop(1) role slot code ports.cons(path)
      ? (equal kind (grove/directive_kind/on))
        ? (maybe/is_some role)
          | goo/fail[goo/view] at "Duplicate #on on view."
        | _ rest.drop(1) (./some path) slot code ports
      ? (equal kind (grove/directive_kind/for))
        ? (maybe/is_some slot)
          | goo/fail[goo/view] at "Duplicate #for on view."
        | _ rest.drop(1) role (./some path) code ports
      | goo/fail[goo/view] at "Views support #on and #for only."
     > (grove/presentation at trees)
      ? (maybe/is_some code)
        | goo/fail[goo/view] at "Duplicate Goo body."
      < parsed (goo/parse trees)
      | _ rest.drop(1) role slot (./some parsed) ports
    | goo/fail[goo/view] span "Expected a Goo view declaration."
  + index
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error list[goo/view]]
    % items=list[grove/item] doc.items out=list[goo/view] .nil
    ^ either[grove/error list[goo/view]]
    ? (eq items.len 0) (./ok out.reverse)
    > (grove/declaration span name body) items.at(0)
      | _ items.drop(1) out
    ? !(grove_views/is_goo body)
      ? body.any(grove_views/is_presentation)
        | goo/fail[list[goo/view]] span "Goo bodies require @view or @pane."
      | _ items.drop(1) out
    > (grove/name/identifier name) name
      | goo/fail[list[goo/view]] span "Views require declaration names."
    < view (grove_views/declaration root doc lookup span name body)
    ? (out.any((\ old (equal old.name view.name))))
      | goo/fail[list[goo/view]] span "Duplicate view name."
    | _ items.drop(1) out.cons(view)
  + role_fields
    \ context=grove_views/context stack=list[path] role=path span=rex/source_span
    ^ either[grove/error list[goo/field]]
    ? stack.has(role)
      | goo/fail[list[goo/field]] span "Cyclic role inheritance."
    = external (context.roles.keep((\ schema (equal schema.name role))))
    ? (gt external.len 1)
      | goo/fail[list[goo/field]] span "Competing imported role schemas."
    ? external.len (./ok external.at(0).fields)
    % items=list[grove/item] context.document.items
    ^ either[grove/error list[goo/field]]
    ? (eq items.len 0)
      | goo/fail[list[goo/field]] span "Unknown role; imported roles require field type information."
    > (grove/declaration at name body) items.at(0)
      | _ items.drop(1)
    > (grove/name/identifier name) name
      | _ items.drop(1)
    ? !(equal context.root.snoc(($ts name)) role) (_ items.drop(1))
    ? !(grove_roles/is_role body)
      | goo/fail[list[goo/field]] at "View receiver is not a role."
    < fields (grove_views/fields context stack.snoc(role) .false body)
    % rest=list[goo/field] fields names=list[str] .nil slots=list[path] .nil
    ^ either[grove/error list[goo/field]]
    ? (eq rest.len 0) (./ok fields)
    = field rest.at(0)
    ? (names.has(field.name) || slots.has(field.slot))
      | goo/fail[list[goo/field]] at "Duplicate or inherited role field."
    | _ rest.drop(1) names.snoc(field.name) slots.snoc(field.slot)
  + fields
    \ context=grove_views/context stack=list[path] optional=bool
      body=list[grove/statement]
    ^ either[grove/error list[goo/field]]
    ? (eq body.len 0) (./ok .nil)
    < tail (grove_views/fields context stack optional body.drop(1))
    ? body.at(0)
     > (grove/property span slot type)
      < slot (grove_views/reference context.root context.document context.lookup slot)
      < type (grove_views/reference context.root context.document context.lookup type)
      ? (eq slot.len 0)
        | goo/fail[list[goo/field]] span "Empty role field path."
      = name (str/from_atom (quip_val slot.at((dec slot.len))))
      | ./ok tail.cons((goo/field name slot type optional))
     > (grove/block span kind kids)
      ? (equal kind (grove/block_kind/meta)) (./ok tail)
      ? !((equal kind (grove/block_kind/or)) || (equal kind (grove/block_kind/opt)))
        | goo/fail[list[goo/field]] span "Unsupported role block."
      < fields (grove_views/fields context stack .true kids)
      | ./ok fields.weld(tail)
     > (grove/directive span kind target)
      ? !(equal kind (grove/directive_kind/with))
        | goo/fail[list[goo/field]] span "Unsupported role directive."
      < role (grove_views/reference context.root context.document context.lookup
        (grove_views/local_role context.document target))
      < fields (grove_views/role_fields context stack role span)
      | ./ok fields.weld(tail)
     > (grove/tag span kind) (./ok tail)
     > (grove/comment span text) (./ok tail)
    | goo/fail[list[goo/field]] rex/zero_span "Invalid role body."
  + local_role
    ' #with historically permits bare local names as well as %/name.
    \ doc=grove/document tree=rex
    ^ rex
    ? !(equal tree.leaf_kind (maybe/some[str] "word")) tree
    = name
        ? tree
         > (./leaf span shape text) text
        ""
    ? ((grove_roles/imports doc).any((\ imp (eq imp.alias name)))) tree
    | rex/rune "%/" [tree]
  + expression_type
    \ context=grove_views/context view=goo/view expression=rex
    ^ either[grove/error path]
    ? (equal expression.leaf_kind (maybe/some[str] "word"))
      ? expression
       > (./leaf span shape text)
        ? (eq text view.binding) (./ok view.role)
        | goo/fail[path] expression.span "Unbound Goo value."
      | goo/fail[path] expression.span "Unbound Goo value."
    ? expression
     > (./nest span color rune kids)
      ? (and (eq rune ".") (eq kids.len 2))
        < role (grove_views/expression_type context view kids.at(0))
        < name (grove/word kids.at(1))
        < fields (grove_views/role_fields context .nil role span)
        = matching (fields.keep((\ field (eq field.name name))))
        ? !(eq matching.len 1)
          | goo/fail[path] span "Unknown or ambiguous role field."
        | ./ok matching.at(0).type
      | goo/fail[path] expression.span "Cannot determine Goo expression type."
    | goo/fail[path] expression.span "Cannot determine Goo expression type."
  + renderer
    \ context=grove_views/context view=goo/view expression=rex
    ^ either[grove/error str]
    ? (equal expression.leaf_kind (maybe/some[str] "cord")) (./ok "text")
    ? (equal expression.leaf_kind (maybe/some[str] "quip"))
      < path (grove_views/reference context.root context.document context.lookup expression)
      | ./ok "link"
    < type (grove_views/expression_type context view expression)
    = matches (context.renderers.keep((\ renderer (equal renderer.type type))))
    ? (eq matches.len 0)
      | goo/fail[str] expression.span "No native UI constructor for this type."
    ? !(eq matches.len 1)
      | goo/fail[str] expression.span "Competing native UI constructors for this type."
    = constructor matches.at(0).constructor
    ? ((eq constructor "show") || ((eq constructor "present") || (eq constructor "")))
      | goo/fail[str] expression.span "Expected a native UI constructor."
    | ./ok constructor
  + select
    \ context=grove_views/context role=path slot=path span=rex/source_span
    ^ either[grove/error goo/view]
    = matches
        | context.views.keep (\ view (and !(view.is_pane) (and (equal view.role role) (equal view.slot slot))))
    ? (eq matches.len 0)
      | goo/fail[goo/view] span "Missing view for role and slot; reflection fallback is not implemented."
    ? !(eq matches.len 1)
      | goo/fail[goo/view] span "Competing views for role and slot; precedence is not defined."
    | ./ok matches.at(0)
  + interaction_reference
    \ context=grove_views/context expression=rex
    ^ rex
    ' Resolve whole paths before their children: %/grade/again contains a
    ' nested %/grade, which must not be replaced before resolving the case.
    = descend expression.map_children((grove_views/interaction_reference context))
    ?> (./nest _ _ rune _) expression descend
    ? !((eq rune "%/") || (eq rune "/")) descend
    ?> (./ok path) (grove_views/reference context.root context.document context.lookup expression) descend
    | rex/quip (str/cat_all ["'" (path_show path)])
  + local_named
    \ name=str node=goo/node
    ^ maybe[rex]
    % rest=list[rex] node.arguments
    ^ maybe[rex]
    ? rest.is_nil .none
    ?> (./nest _ _ rune kids) rest.head (_ rest.tail)
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
    ? !(eq kids.at(0).print name) (_ rest.tail)
    | ./some kids.at(1)
  + local_key
    \ value=rex
    ^ bool
    ? (equal value.leaf_kind (maybe/some[str] "quip")) .true
    | equal value.leaf_kind (maybe/some[str] "cord")
  + source_validate
    \ context=grove_views/context view=goo/view value=rex
    ^ either[grove/error unit]
    ? (grove_views/local_key value) (./ok [])
    < type (grove_views/expression_type context view value)
    ? !(context.renderers.any((\ renderer (and (equal renderer.type type) (eq renderer.constructor "link")))))
      | goo/fail[unit] value.span "Pane source must have path type."
    | ./ok []
  + topos
    \ kind=str
    ^ bool
    | ((eq kind "list") || (eq kind "diagram_tree") || (eq kind "list_tree"))
  + local_validate
    \ context=grove_views/context view=goo/view node=goo/node
    ^ either[grove/error unit]
    = keyed=row[str] ["pane" "selection" "list" "diagram_tree" "list_tree" "follow" "deck" "navigate" "operation" "operation_status"]
      leaf=row[str] ["list" "diagram_tree" "list_tree" "follow" "navigate" "operation" "operation_status"]
    ? !(keyed.has(node.constructor)) (./ok [])
    ? (eq node.arguments.len 0) (goo/fail[unit] node.span "Local declarations require a stable literal key.")
    ? !(grove_views/local_key node.arguments.head) (goo/fail[unit] node.span "Local keys must be path or text literals.")
    ? (and (leaf.has(node.constructor)) (gt node.children.len 0))
      | goo/fail[unit] node.span "list/follow use a slot-selected presentation; explicit bodies are not supported."
    ? (eq node.constructor "navigate")
      ?> (./some value) (grove_views/local_named "source" node) (goo/fail[unit] node.span "navigate requires a path source.")
      | grove_views/source_validate context view value
    ? ((eq node.constructor "operation") || (eq node.constructor "operation_status"))
      ?> (./some value) (grove_views/local_named "operation" node) (goo/fail[unit] node.span "Host controls require an operation key.")
      ? !(grove_views/local_key value) (goo/fail[unit] node.span "Operation keys must be literals.")
      | ./ok []
    = source=bool ((eq node.constructor "selection") || (grove_views/topos node.constructor))
    ? source
      ?> (./some value) (grove_views/local_named "source" node) (goo/fail[unit] node.span "selection/list require source = namespace path.")
      < valid (grove_views/source_validate context view value)
      ? (eq node.constructor "selection")
        = axis (grove_views/local_named "axis" node).fall((rex/cord "z"))
        ? !((eq axis.print (rex/cord "x").print) || ((eq axis.print (rex/cord "y").print) || (eq axis.print (rex/cord "z").print)))
          | goo/fail[unit] node.span "Selection axis must be x, y, or z."
        ?> (./some topology) (grove_views/local_named "topology" node) (./ok [])
        ? !((eq topology.print (rex/cord "tree").print) || (eq topology.print (rex/cord "children").print))
          | goo/fail[unit] node.span "Selection topology must be tree or children."
        | ./ok []
      ?> (./some port) (grove_views/local_named "selection" node) (goo/fail[unit] node.span "list requires a selection port.")
      ? !(grove_views/local_key port) (goo/fail[unit] node.span "Selection port must name a local key.")
      (./ok [])
    ? (eq node.constructor "follow")
      ?> (./some port) (grove_views/local_named "selection" node) (goo/fail[unit] node.span "follow requires a selection observation.")
      ? !(grove_views/local_key port) (goo/fail[unit] node.span "Selection observation must name a local key.")
      (./ok [])
    | ./ok []
  + make_validate
    \ context=grove_views/context view=goo/view node=goo/node
    ^ either[grove/error unit]
    ? !(eq node.constructor "group") (./ok [])
    ?> (./some target) (grove_views/local_named "make" node) (./ok [])
    ? ((maybe/is_some (grove_views/local_named "on" node)) || (maybe/is_some (grove_views/local_named "action" node)))
      | goo/fail[unit] node.span "make cannot be combined with on or action."
    < valid (grove_views/source_validate context view target)
    ?> (./some role) (grove_views/local_named "role" node) (goo/fail[unit] node.span "make requires a role.")
    < path (grove_views/reference context.root context.document context.lookup role)
    | ./ok []
  + capture_head
    \ expression=rex
    ^ bool
    ? expression
     > (./leaf _ _ text)
      | and (eq text "capture") (equal expression.leaf_kind (maybe/some[str] "word"))
     > (./juxt _ kids)
      ? (eq kids.len 0) .false
      | grove_views/capture_head kids.at(0)
    .false
  + captures
    \ expression=rex
    ^ bool
    = own=bool
        ?> (./nest _ _ rune kids) expression .false
        ? !(and (eq rune ".") (eq kids.len 1)) .false
        | grove_views/capture_head kids.at(0)
    ? own .true
    | expression.children.any(grove_views/captures)
  + scope_validate
    \ view=goo/view node=goo/node
    ^ either[grove/error unit]
    ? view.is_pane (./ok [])
    = exclusive=row[str] ["pane" "_pane_instance" "selection" "list" "diagram_tree" "list_tree" "follow" "split" "deck" "pane_stack" "navigate" "operation" "operation_status"]
    ? (exclusive.has(node.constructor))
      | goo/fail[unit] node.span "Pane controls require @pane; @view is an object projection."
    ? (node.arguments.any(grove_views/captures))
      | goo/fail[unit] node.span "Selection capture requires @pane."
    | ./ok []
  + lower_nodes
    \ context=grove_views/context stack=list[path] view=goo/view nodes=list[goo/node]
    ^ either[grove/error list[goo/node]]
    ? (eq nodes.len 0) (./ok .nil)
    < head (grove_views/lower_node context stack view nodes.at(0))
    < tail (grove_views/lower_nodes context stack view nodes.drop(1))
    | ./ok tail.cons(head)
  + lower_node
    \ context=grove_views/context stack=list[path] view=goo/view node=goo/node
    ^ either[grove/error goo/node]
    < scope (grove_views/scope_validate view node)
    ? (eq node.constructor "_pane_instance") (./ok node.set_constructor("pane"))
    ? (eq node.constructor "pane")
      | goo/fail[goo/node] node.span "Use pane(declaration); inline pane bodies are not supported."
    ? ((eq node.constructor "show") || (eq node.constructor "present"))
      ? !(and (eq node.arguments.len 2) (eq node.children.len 0))
        | goo/fail[goo/node] node.span "show/present require a value and slot, with no explicit children."
      = value node.arguments.at(0)
      < slot (grove_views/reference context.root context.document context.lookup node.arguments.at(1))
      ? (eq node.constructor "show")
        < constructor (grove_views/renderer context view value)
        | ./ok node.set_constructor(constructor)
      < role (grove_views/expression_type context view value)
      < target (grove_views/select context role slot node.span)
      ? stack.has(target.name)
        | goo/fail[goo/node] node.span "Cyclic view presentation."
      < children (grove_views/lower_nodes context stack.snoc(target.name) target target.children)
      | ./ok node.set_children(children.map((goo/bind_node target.binding value)))
    = constructors=row[str]
        ["group" "or" "action" "input" "text" "link" "number"
         "time" "duration" "boolean" "image" "icon" "divider"
         "pane" "selection" "list" "diagram_tree" "list_tree" "follow" "split" "deck" "pane_stack" "navigate" "operation" "operation_status"
         "row" "col" "flow" "stack" "opt" "button" "code" "avatar" "presence" "media" "bar"]
    ? !(constructors.has(node.constructor))
      | goo/fail[goo/node] node.span "Unknown Goo constructor."
    < creation (grove_views/make_validate context view node)
    < valid (grove_views/local_validate context view node)
    < children (grove_views/lower_nodes context stack view node.children)
    | ./ok node.set_children(children).set_arguments(node.arguments.map((grove_views/interaction_reference context)))
  + compile
    ' Compile one entry view and its reachable presentations. Other views may
    ' be indexed without requiring their missing reflection-generated views.
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      imported_roles=list[goo/role] renderers=list[goo/renderer] name=str
    ^ either[grove/error goo/view]
    < views (grove_views/index root doc lookup)
    = context (grove_views/context root doc lookup imported_roles renderers views)
      matching (views.keep((\ view (equal view.name root.snoc(($ts name))))))
    ? !(eq matching.len 1)
      | goo/fail[goo/view] rex/zero_span "Unknown entry view."
    = view matching.at(0)
    < fields (grove_views/role_fields context .nil view.role view.span)
    | grove_views/lower_view context view

  + path_literal
    \ path=path
    ^ rex
    | rex/quip (str/cat_all ["'" (path_show path)])
  + port_lookup
    \ env=list[[path path]] key=path span=rex/source_span
    ^ either[grove/error path]
    ? env.is_nil (goo/fail[path] span "Unbound selection; declare #port and connect it explicitly.")
    = [local actual] env.head
    ? (equal local key) (./ok actual)
    | grove_views/port_lookup env.tail key span
  + local_path
    \ value=rex
    ^ either[grove/error path]
    ?> (./leaf _ _ text) value (goo/fail[path] value.span "Expected a local path key.")
    ? (equal value.leaf_kind (maybe/some[str] "quip"))
      ?> (./some path) (path_parse (str/slice 1 (dec text.len) text)) (goo/fail[path] value.span "Expected a local path key.")
      | ./ok path
    ? (equal value.leaf_kind (maybe/some[str] "cord"))
      | ./ok [($ts text)]
    | goo/fail[path] value.span "Expected a local path key."
  + capture_ports
    \ env=list[[path path]] expression=rex
    ^ either[grove/error rex]
    = operand=bool
        ? expression
         > (./juxt _ kids)
          ? (eq kids.len 0) .false
          | grove_views/captures kids.at(0)
        ?> (./nest _ _ rune kids) expression .false
        ? !(and (eq rune ".") (eq kids.len 1)) .false
        | grove_views/capture_head kids.at(0)
    ? operand
      < next (grove_views/capture_operand env expression)
      | ./ok next
    < children (grove_views/port_expressions env expression.children.stream)
    ' map_children retains shape; pair each child with its rewritten counterpart.
    = rewrite
        \ old=rex
        ^ rex
        % before=row[rex] expression.children after=list[rex] children
        ^ rex
        ? (eq before.len 0) old
        ? (equal old before.at(0)) after.head
        | _ before.drop(1) after.tail
    | ./ok expression.map_children(rewrite)
  + capture_operand
    \ env=list[[path path]] expression=rex
    ^ either[grove/error rex]
    ? ((equal expression.leaf_kind (maybe/some[str] "quip")) || (equal expression.leaf_kind (maybe/some[str] "cord")))
      < key (grove_views/local_path expression)
      < actual (grove_views/port_lookup env key expression.span)
      | ./ok (grove_views/path_literal actual)
    < children (grove_views/capture_operands env expression.children.stream)
    = rewrite
        \ old=rex
        ^ rex
        % before=row[rex] expression.children after=list[rex] children
        ^ rex
        ? (eq before.len 0) old
        ? (equal old before.at(0)) after.head
        | _ before.drop(1) after.tail
    | ./ok expression.map_children(rewrite)
  + capture_operands
    \ env=list[[path path]] expressions=list[rex]
    ^ either[grove/error list[rex]]
    ? expressions.is_nil (./ok .nil)
    < head (grove_views/capture_operand env expressions.head)
    < tail (grove_views/capture_operands env expressions.tail)
    | ./ok tail.cons(head)
  + port_expressions
    \ env=list[[path path]] expressions=list[rex]
    ^ either[grove/error list[rex]]
    ? expressions.is_nil (./ok .nil)
    < head (grove_views/capture_ports env expressions.head)
    < tail (grove_views/port_expressions env expressions.tail)
    | ./ok tail.cons(head)
  + port_bindings
    \ context=grove_views/context target=goo/view env=list[[path path]] node=goo/node
    ^ either[grove/error list[[path path]]]
    = supplied (grove_views/local_named "ports" node)
      fields=list[rex]
        ?> (./some value) supplied .nil
        ?> (./nest _ color rune kids) value (list/one value)
        ? !(eq color "curly") (list/one value)
        ? (eq rune "=") (list/one (rex/rune "=" kids))
        kids.stream
    % rest=list[rex] fields out=list[[path path]] .nil
    ^ either[grove/error list[[path path]]]
    ? rest.is_nil
      ? !(eq out.len target.ports.len)
        | goo/fail[list[[path path]]] node.span "Pane requires all declared selection ports."
      | ./ok out
    ?> (./nest _ _ rune kids) rest.head (goo/fail[list[[path path]]] node.span "Expected ports = { local = selection }.")
    ? !(and (eq rune "=") (eq kids.len 2))
      | goo/fail[list[[path path]]] node.span "Expected ports = { local = selection }."
    < local (grove_views/local_path kids.at(0))
    ? !(target.ports.has(local))
      | goo/fail[list[[path path]]] node.span "Unknown pane selection port."
    ? (out.any((\ [key value] (equal key local))))
      | goo/fail[list[[path path]]] node.span "Duplicate pane selection port binding."
    < key (grove_views/local_path kids.at(1))
    < actual (grove_views/port_lookup env key node.span)
    | _ rest.tail out.cons([local actual])
  + pane_arguments
    \ node=goo/node
    ^ either[grove/error unit]
    % rest=list[rex] node.arguments.tail seen=list[str] .nil
    ^ either[grove/error unit]
    ? rest.is_nil (./ok [])
    ?> (./nest _ _ rune kids) rest.head (goo/fail[unit] node.span "Expected named pane arguments: key, ports, on.")
    ? !(and (eq rune "=") (eq kids.len 2))
      | goo/fail[unit] node.span "Expected named pane arguments: key, ports, on."
    = name kids.at(0).print
    ? !((eq name "key") || (eq name "ports") || (eq name "on"))
      | goo/fail[unit] node.span "Unknown pane argument."
    ? seen.has(name) (goo/fail[unit] node.span "Duplicate pane argument.")
    | _ rest.tail seen.cons(name)
  + pane_children_keys
    \ nodes=list[goo/node]
    ^ list[rex]
    | nodes.bind
      \ node
      ? (eq node.constructor "pane") (list/one node.arguments.head)
      | grove_views/pane_children_keys node.children
  + pane_instance
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] key=path prefix=path
    ^ either[grove/error goo/node]
    < composed (grove_views/compose_nodes context stack view env prefix view.children)
    < children (grove_views/lower_nodes context stack view composed)
    = keys (grove_views/pane_children_keys children)
    ? (keys.any((\ key (gt (keys.keep((\ other (equal key other)))).len 1))))
      | goo/fail[goo/node] view.span "Repeated pane declaration requires distinct instance keys."
    | ./ok (goo/node view.span "_pane_instance" (list/one (grove_views/path_literal key)) children)
  + compose_nodes
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] prefix=path nodes=list[goo/node]
    ^ either[grove/error list[goo/node]]
    ? nodes.is_nil (./ok .nil)
    < head (grove_views/compose_node context stack view env prefix nodes.head)
    < tail (grove_views/compose_nodes context stack view env prefix nodes.tail)
    | ./ok tail.cons(head)
  + compose_node
    \ context=grove_views/context stack=list[path] view=goo/view env=list[[path path]] prefix=path node=goo/node
    ^ either[grove/error goo/node]
    ? (eq node.constructor "_pane_instance")
      | goo/fail[goo/node] node.span "Reserved pane constructor."
    ? (eq node.constructor "pane")
      ? ((eq node.arguments.len 0) || (gt node.children.len 0))
        | goo/fail[goo/node] node.span "Use pane(declaration); inline pane bodies are not supported."
      < _ (grove_views/pane_arguments node)
      < name (grove_views/reference context.root context.document context.lookup node.arguments.head)
      = matches (context.views.keep((\ pane (and pane.is_pane (equal pane.name name)))))
      ? !(eq matches.len 1)
        | goo/fail[goo/node] node.span "pane requires an @pane declaration."
      = target matches.head
      ? stack.has(name) (goo/fail[goo/node] node.span "Cyclic pane composition.")
      = receiver (grove_views/local_named "on" node).fall((rex/word view.binding))
      ? !(eq receiver.print view.binding)
        | goo/fail[goo/node] node.span "Pane composition currently requires the current receiver."
      ? !(equal target.role view.role)
        | goo/fail[goo/node] node.span "Pane receiver role must match its declaration."
      < bindings (grove_views/port_bindings context target env node)
      = explicit (grove_views/local_named "key" node)
      = key=either[grove/error path]
          ? explicit
           > (./some value)
            < local (grove_views/local_path value)
            | ./ok name.snoc('instance).weld(local)
          | ./ok name
      < key key
      < pane (grove_views/pane_instance context stack.snoc(name) target bindings key prefix.snoc(($x key.len)).weld(key))
      | ./ok (goo/bind_node target.binding receiver pane)
    = nested=either[grove/error list[[path path]]]
        ? !(eq node.constructor "selection") (./ok env)
        ? (eq node.arguments.len 0) (goo/fail[list[[path path]]] node.span "Selection requires a local key.")
        < local (grove_views/local_path node.arguments.head)
        | ./ok env.cons([local prefix.snoc('selection).weld(local)])
    < nested nested
    < arguments (grove_views/port_expressions nested node.arguments)
    = mapped=either[grove/error list[rex]]
        ? (eq node.constructor "selection")
          < local (grove_views/local_path node.arguments.head)
          < actual (grove_views/port_lookup nested local node.span)
          | ./ok arguments.tail.cons((grove_views/path_literal actual))
        ? ((grove_views/topos node.constructor) || (eq node.constructor "follow"))
          ?> (./some port) (grove_views/local_named "selection" node) (goo/fail[list[rex]] node.span "list/follow require a selection port.")
          < local (grove_views/local_path port)
          < actual (grove_views/port_lookup env local node.span)
          = rewrite
              \ argument=rex
              ^ rex
              ? (maybe/is_some (grove_views/local_named "selection" node.set_arguments((list/one argument))))
                | rex/rune "=" [(rex/word "selection") (grove_views/path_literal actual)]
              argument
          | ./ok arguments.map(rewrite)
        | ./ok arguments
    < arguments mapped
    < children (grove_views/compose_nodes context stack view nested prefix node.children)
    | ./ok node.set_arguments(arguments).set_children(children)
  + lower_view
    \ context=grove_views/context view=goo/view
    ^ either[grove/error goo/view]
    ? !(view.is_pane)
      < children (grove_views/lower_nodes context (list/one view.name) view view.children)
      | ./ok view.set_children(children)
    = ports (view.ports.map((\ port [port port])))
    < pane (grove_views/pane_instance context (list/one view.name) view ports view.name view.name)
    | ./ok view.set_children((list/one pane.set_constructor("pane")))
