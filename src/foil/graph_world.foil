- graph_views

' A thing as a world: its relations as folders, each holding the things it
' relates to, opened again beneath them, to a depth.  A reading, not a crawl:
' breadth first over the whole page, so a thing opens once, where it first
' appears, and is only listed after that; each thing once per node, in the
' first folder that names it, carrying every label it has; folders capped,
' with a count of the rest; folders pointing at a thing closed beyond the
' subject, as counts, until that thing is read as a world itself.  Every item
' says which world asserts it.  The tree is addressable: a folder is
' <direction>/<n>/<label...>, an item beneath it <n>/<name...>, and an
' item's own folders sit beneath the item.
+ graph_world
  + cap
    ' Items per folder at the subject.
    ^ nat
    24
  + deeper
    ' Items per folder beneath the subject.
    ^ nat
    6
  + nodes
    ' Things opened on one page.
    ^ nat
    150
  + world
    ' The world a name belongs to: /0x11/0x12/user/... is 0x12's, kept
    ' under 0x11; /0x11/user/... is 0x11's.
    \ name=path
    ^ str
    = cut=maybe[nat]
        % i=nat 0
        ^ maybe[nat]
        ? (eq i name.len) .none
        ? (eq_iota name.at(i) 'user) (./some i)
        | _ i.inc
    ?> (./some at) cut ""
    ? (eq at 0) ""
    = shown (path_show [name.at(at.dec)])
    | shown.slice 1 shown.len
  + skipped
    ' Labels that are provenance or machinery, not relations to show.
    \ label=path
    ^ bool
    ? (eq label.len 0) .false
    = head label.at(0)
    | ((graph_views/seg_is head 'source) || ((graph_views/seg_is head 'sources) || (graph_views/seg_is head 'claims)))
  + parts
    ' The things each member files beneath itself, by their folder.
    \ members=row[safe] next={\ row[graph_views/relation]}view_plan
    ^ view_plan
    % i=nat 0 found=row[graph_views/relation] []
    ^ view_plan
    ? (eq i members.len) (next found)
    = source members.at(i)
      resume (_ i.inc)
    | graph_views/frontier source
      \ tree=axal[myth]
      ^ view_plan
      = children tree.kid_tap
        source_name (view_walk/name source)
        computed ((is_xv source_name) || (is_o source_name))
      % j=nat 0 found=row[graph_views/relation] found
      ^ view_plan
      ? (eq j children.len) (resume found)
      = [key child] children.at(j)
        target (view_ops/at source [key] .x)
        name (view_walk/name target)
        advance (_ j.inc)
      ? ((graph_views/private_part [key]) || (graph_world/skipped [key])) (advance found)
      ? computed
        | advance found.snoc((graph_views/relation 'part ['beneath] target target source myth/new 'solid))
      | graph_views/frontier target
        \ child=axal[myth]
        ^ view_plan
        = record child.fil.fall(myth/new)
        ? ((graph_views/placement record) || (graph_views/assertion record)) (advance found)
        ? (graph_views/thing name child)
          | advance found.snoc((graph_views/relation 'part ['parts] target target source myth/new 'solid))
        = selected
            | child.kid_tap.fold found
              \ out [leaf subtree]
              = at (view_ops/at target [leaf] .x)
              ? !(graph_views/thing (view_walk/name at) subtree) out
              | out.snoc (graph_views/relation 'part [key] at at source myth/new 'solid)
        | advance selected
  + item
    ' One related thing in one folder, with every label it has there;
    ' tentative when every edge reaching it is a mention.
    : other=safe labels=row[path] by=row[str] direction=iota note=myth tentative=bool
  + folder
    : direction=iota label=path items=row[graph_world/item]
  + rank
    ' Folder order: what the thing asserts, then its parts, then what
    ' points at it.
    \ direction=iota
    ^ nat
    ? (eq_iota direction 'out) 0
    ? (eq_iota direction 'part) 1
    2
  + key
    : direction=iota label=path
  + folders
    ' The relations and parts of one thing as folders: one thing once,
    ' in the first folder naming it, by its identity; nothing on the
    ' trail (an ancestor on the page); labels that are provenance left
    ' out.  Folders come in rank order (asserted, parts, pointing here),
    ' then in the order their first edge appeared.
    \ relations=row[graph_views/relation] trail=row[path]
    ^ row[graph_world/folder]
    = kept
        | relations.filter
          \ edge=graph_views/relation
          ? (graph_world/skipped edge.label) .false
          | !(trail.any((\ seen=path (equal[path] seen (view_walk/name edge.other)))))
      outs (kept.filter((\ e=graph_views/relation (eq_iota e.direction 'out))))
      parts (kept.filter((\ e=graph_views/relation (eq_iota e.direction 'part))))
      ins (kept.filter((\ e=graph_views/relation (eq_iota e.direction 'in))))
      ordered outs.weld(parts).weld(ins)
    % i=nat 0 items=axal[graph_world/item] (axal/new[graph_world/item] .none) keys=row[graph_world/key] [] names=row[[graph_world/key path]] []
    ^ row[graph_world/folder]
    ? (eq i ordered.len) (graph_world/arrange keys names items)
    = edge ordered.at(i)
      name (view_walk/name edge.other)
      by (graph_world/world (view_walk/name edge.via))
      k (graph_world/key edge.direction edge.label)
    ? (items.get(name))
     > (./some it)
       ' Already placed: the label and the asserting world join its item.
       = labels (? (it.labels.any((\ l=path (equal[path] l edge.label)))) it.labels it.labels.snoc(edge.label))
         bys (? (it.by.any((\ w=str (equal[str] w by)))) it.by it.by.snoc(by))
         note (graph_world/noted it.note edge.note)
         tentative (and it.tentative (eq_iota edge.strength 'mention))
       | _ i.inc items.put(name it.set_labels(labels).set_by(bys).set_note(note).set_tentative(tentative)) keys names
    = fresh (graph_world/item edge.other [edge.label] [by] edge.direction edge.note (eq_iota edge.strength 'mention))
      known (keys.any((\ q=graph_world/key (and (eq_iota q.direction k.direction) (equal[path] q.label k.label)))))
    | _ i.inc items.put(name fresh) (? known keys keys.snoc(k)) names.snoc([k name])
  + noted
    \ base=myth more=myth
    ^ myth
    = pairs more.tap
    % i=nat 0 out=myth base
    ^ myth
    ? (eq i pairs.len) out
    = [slot held] pairs.at(i)
    | _ i.inc out.put(slot held)
  + arrange
    ' The folders, each with the items first placed in it, in order.
    \ keys=row[graph_world/key] names=row[[graph_world/key path]] items=axal[graph_world/item]
    ^ row[graph_world/folder]
    % i=nat 0 out=row[graph_world/folder] []
    ^ row[graph_world/folder]
    ? (eq i keys.len) out
    = k keys.at(i)
      mine=row[graph_world/item]
        % j=nat 0 found=row[graph_world/item] []
        ^ row[graph_world/item]
        ? (eq j names.len) found
        = [q name] names.at(j)
        ? !(and (eq_iota q.direction k.direction) (equal[path] q.label k.label)) (_ j.inc found)
        ? (items.get(name))
         > (./some it) (_ j.inc found.snoc(it))
        | _ j.inc found
    | _ i.inc out.snoc((graph_world/folder k.direction k.label mine))
  + folder_name
    \ f=graph_world/folder
    ^ path
    = prefix=path [f.direction ($u f.label.len)]
    | prefix.weld(f.label)
  + item_name
    \ it=graph_world/item
    ^ path
    = other (view_walk/name it.other)
      head=path [($u other.len)]
    | head.weld(other)
  + item_record
    \ it=graph_world/item title=str seen=bool
    ^ myth
    = worlds (str/join " " it.by)
      record
        . (myth/sing ['name] (pails/t title))
          put(['at] it.other)
          put(['world] (pails/t (graph_world/world (view_walk/name it.other))))
          put(['by] (pails/t worlds))
      record (? (gt it.labels.len 1) record.put(['also] (pails/t (str/join ", " it.labels.drop(1).map((\ l=path (path_show l)))))) record)
      record (? seen record.put(['seen] (pails/b .true)) record)
      record (? it.tentative record.put(['tentative] (pails/b .true)) record)
    | it.note.tap.fold record
      \ out=myth [slot held]
      ? (pith_prefix ['sys] slot) out
      ? held
       > ref=safe out
      | out.put slot.cons('note) held
  + mark
    \ names=row[path] opened=axal[nat]
    ^ axal[nat]
    % i=nat 0 out=axal[nat] opened
    ^ axal[nat]
    ? (eq i names.len) out
    | _ i.inc out.put(names.at(i) 1)
  + entry
    ' One thing waiting to be opened on the page: where its folders go,
    ' the thing, how deep it may still go, and the names above it.
    : at=path source=safe depth=nat trail=row[path]
  + get
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = depth (context.nat_at(['depth] 3))
    ? ((gt depth 8) || (eq depth 0)) (./fail "depth: 1 to 8")
    | graph_views/canonical source 16 []
      \ origin=safe
      ^ view_plan
      = root (axal/new[myth] (./some (myth/sing ['at] origin).put(['world] (pails/t (graph_world/world (view_walk/name origin))))))
      | graph_world/page [(graph_world/entry [] origin depth [])] (axal/new[nat] .none) root 0 cr relative select
  + frontier
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_world/get context.put(['depth] (pails/n 1)) cr relative select
  + page
    ' Breadth first: the subject opens whole; a thing beneath it opens
    ' once, where it first appears; later it is listed and marked seen.
    \ queue=row[graph_world/entry] opened=axal[nat] output=axal[myth] used=nat cr=care relative=path select=view_select
    ^ view_plan
    ? (eq queue.len 0) (graph_views/result output cr relative select)
    = here queue.at(0)
      rest queue.drop(1)
      whole (eq here.at.len 0)
    | graph_views/relations_for here.source
      \ members=row[safe] relations=row[graph_views/relation]
      ^ view_plan
      | graph_world/parts members
        \ parts=row[graph_views/relation]
        ^ view_plan
        = names (members.map((\ m=safe (view_walk/name m))))
          opened (graph_world/mark names opened)
          trail here.trail.weld(names)
          fs (graph_world/folders relations.weld(parts) trail)
          limit (? whole graph_world/cap graph_world/deeper)
          record (output.dip(here.at).fil.fall(myth/new)).put(['worlds] (pails/t (str/join " " (names.map((\ n=path (graph_world/world n)))))))
          output output.put(here.at record)
        | graph_world/place fs 0 limit whole here trail opened output used rest cr relative select
  + place
    ' Lay one node's folders into the page, then go on to the next thing.
    \ fs=row[graph_world/folder] i=nat limit=nat whole=bool here=graph_world/entry trail=row[path] opened=axal[nat] output=axal[myth] used=nat rest=row[graph_world/entry] cr=care relative=path select=view_select
    ^ view_plan
    ? (eq i fs.len) (graph_world/page rest opened output used cr relative select)
    = f fs.at(i)
      fname here.at.weld((graph_world/folder_name f))
      closed (and !whole (eq_iota f.direction 'in))
      shown (? closed 0 (? (lt f.items.len limit) f.items.len limit))
      head (myth/sing ['count] (pails/n f.items.len))
      head (? (gt f.items.len shown) head.put(['more] (pails/n (sub f.items.len shown))) head)
      head (? closed head.put(['closed] (pails/b .true)) head)
      output output.put(fname head)
    | graph_world/items f.items 0 shown fname here trail opened output used
      \ opened=axal[nat] output=axal[myth] used=nat queued=row[graph_world/entry]
      ^ view_plan
      | graph_world/place fs i.inc limit whole here trail opened output used rest.weld(queued) cr relative select
  + items
    ' The items of one folder, each named by a read of its record; a thing
    ' not yet opened on the page is queued to open beneath its item.
    \ items=row[graph_world/item] j=nat shown=nat fname=path here=graph_world/entry trail=row[path] opened=axal[nat] output=axal[myth] used=nat next={\ axal[nat] axal[myth] nat row[graph_world/entry]}view_plan
    ^ view_plan
    % j=nat j opened=axal[nat] opened output=axal[myth] output used=nat used queued=row[graph_world/entry] []
    ^ view_plan
    ? (eq j shown) (next opened output used queued)
    = it items.at(j)
      name (view_walk/name it.other)
      iname fname.weld((graph_world/item_name it))
      seen (maybe/is_some opened.get(name))
      resume (_ j.inc)
    | ./need (view_read (view_ops/at it.other [] .x) (view_select/slots [['name] ['heading] ['title]]))
      \ named=res[axal[myth]]
      ^ view_plan
      = title=str
          ?> (./known tree) named ""
          | graph_views/title tree.fil.fall(myth/new)
        output output.put(iname (graph_world/item_record it title seen))
      ? (((it.tentative || seen) || (eq here.depth 1)) || (ge used graph_world/nodes)) (resume opened output used queued)
      | resume opened.put(name 1) output used.inc queued.snoc((graph_world/entry iname it.other here.depth.dec trail))
