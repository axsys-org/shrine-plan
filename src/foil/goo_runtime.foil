' Publish rich-text values with the common runtime, before independent mounts.
- goo_text
- system_vocabulary
- grove_role_runtime
- grove_install
- grove_view_publication
- json
- goo_value
- physical_key
- namespace_command

' Browser requests identify published controls. Only source-declared arguments
' can be supplied, and all writes pass through the namespace event loop.
+ goo_runtime
  + request
    : operation=str target=path subject=path view=path control=row[nat]
      expected=nat displayed=nat publication=nat inputs=row[[str str]] now=nat
  + scope
    : receiver=maybe[rex] action=maybe[rex] values=list[rex] make=maybe[rex] role=maybe[rex]
  + read_path
    \ expression=rex
    ^ maybe[path]
    ?> (./leaf _ _ text) expression .none
    ? !(equal expression.leaf_kind (maybe/some[str] "quip")) .none
    | path_parse text.slice(1 text.len.dec)
  + named
    \ name=str arguments=list[rex]
    ^ maybe[rex]
    % rest=list[rex] arguments
    ^ maybe[rex]
    ? (eq rest.len 0) .none
    ?> (./nest _ _ rune kids) rest.at(0) (_ rest.drop(1))
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.drop(1))
    ? !(equal kids.at(0).print name) (_ rest.drop(1))
    | ./some kids.at(1)
  + chained_fields
    ' Rex joins newline-separated equals inside brackets into one chain:
    ' key0 = (value0 key1) = value1. Recover the pairs before dispatch.
    \ children=row[rex] original=rex
    ^ list[rex]
    ? (lt children.len 2) (list/one original)
    % key=rex children.at(0) rest=row[rex] children.drop(1) out=list[rex] .nil
    ^ list[rex]
    ? (eq rest.len 1) out.snoc((rex/rune "=" [key rest.at(0)]))
    ?> (./nest _ color rune kids) rest.at(0) (list/one original)
    ? !(eq color "clear") (list/one original)
    ? !(eq rune "") (list/one original)
    ? !(eq kids.len 2) (list/one original)
    | _ kids.at(1) rest.drop(1) out.snoc((rex/rune "=" [key kids.at(0)]))
  + fields
    \ expression=rex
    ^ list[rex]
    ? expression
     > (./expr _ color kids) (? (eq color "curly") kids.stream (list/one expression))
     > (./nest _ color rune kids)
      ? !(eq color "curly") (list/one expression)
      ? (eq rune "=") (goo_runtime/chained_fields kids expression)
      kids.stream
    (list/one expression)
  + mentions
    \ name=str expression=rex
    ^ bool
    ? expression
     > (./leaf _ _ text) (eq text name)
    | row/any[rex] (goo_runtime/mentions name) expression.children
  + enter
    \ scope=goo_runtime/scope node=goo/node
    ^ goo_runtime/scope
    ? !(eq node.constructor "group") scope
    = receiver (goo_runtime/named "on" node.arguments)
      action (goo_runtime/named "action" node.arguments)
      values (goo_runtime/named "myth" node.arguments)
      make (goo_runtime/named "make" node.arguments)
      role (goo_runtime/named "role" node.arguments)
    | goo_runtime/scope
      (? (maybe/is_some receiver) receiver scope.receiver)
      (? (maybe/is_some action) action scope.action)
      scope.values.weld(values.run(goo_runtime/fields).fall((list/nil[rex])))
      (? (maybe/is_some make) make scope.make)
      (? (maybe/is_some role) role scope.role)
  + locate
    \ nodes=list[goo/node] indices=row[nat] scope=goo_runtime/scope
    ^ maybe[[goo/node goo_runtime/scope]]
    ? (eq indices.len 0) .none
    ? (ge indices.at(0) nodes.len) .none
    = node nodes.at(indices.at(0))
      next (goo_runtime/enter scope node)
    ? (eq indices.len 1) (./some [node next])
    | goo_runtime/locate node.children indices.drop(1) next
  + record
    \ care=care target=path state=namespace
    ^ maybe[myth]
    | (sovereign_care care target state).fil
  + target
    ' A sewn projection may point back through its declared tack and sys/from.
    ' Validate the projection against the concrete record; never write into /o.
    \ target=path state=namespace
    ^ maybe[path]
    ? (maybe/is_some (goo_runtime/record .x target state)) (./some target)
    < card (goo_runtime/record .y target state)
    < relative card.path_at(system_vocabulary/from)
    % length=nat target.len.dec
    ^ maybe[path]
    ? (lt length 3) .none
    = ancestor (goo_runtime/record .x target.take(length) state).fall(myth/new)
    ?> (./some held) ancestor.get(system_vocabulary/tack) (_ length.dec)
    ?> source=safe held .none
    = actual source.path.weld(relative)
    < current (goo_runtime/record .x actual state)
    ? !(equal card.del(system_vocabulary/from) current.del(system_vocabulary/from)) .none
    | ./some actual
  + publication
    \ state=namespace
    ^ nat
    | (state.case(.z [state.self 'gov])).fall(0)
  + lifetime
    ' x.shape changes on removal/recreation, never on an ordinary live edit.
    \ target=path state=namespace
    ^ nat
    ?> (./some history) state.history(target) 0
    | (history.ever_at(target)).x.lock.shape
  + member
    \ source=path target=path state=namespace
    ^ json
    | goo_runtime/member_status (maybe/is_some (goo_runtime/record .x target state)) source target state
  + member_status
    \ available=bool source=path target=path state=namespace
    ^ json
    = face (sovereign_peek target state).fil.fall(myth/new).path_at(system_vocabulary/face)
    | json/obj
      [(jkv "face" (json/str (face.run(path_show).fall(""))))
       (jkv "key" (json/str (path_show target)))
       (jkv "subject" (json/str (path_show target)))
       (jkv "source" (json/str (path_show source)))
       (jkv "sourceLife" (json/str (nat/show (goo_runtime/lifetime source state))))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime target state))))
       (jkv "type" (json/str "namespace-record"))
       (jkv "expected" (json/str (nat/show (state.case(.x target)).fall(state.local.top))))
       (jkv "status" (json/str (? available "available" "unavailable")))]
  + axis
    \ query=goo_runtime/request
    ^ str
    = values query.inputs.keep((\ [key value] (eq key "$axis")))
    ? (eq values.len 0) "z"
    = [key value] values.at(0)
    value
  + projection
    \ axis=str source=path state=namespace
    ^ axal[myth]
    | sovereign_care (? (eq axis "x") .x (? (eq axis "y") .y .z)) source state
  + projected_paths
    ' Walk the projection's tree directly; do not flatten and rebuild it.
    \ root=axal[myth] path=path
    ^ list[path]
    % pending=list[[path axal[myth]]] (list/one [path root]) out=list[path] .nil
    ^ list[path]
    ? (pending.is_nil || (ge out.len 65)) out.reverse
    = [path node] pending.head
      children (node.kid.range_after(.none (sub 65 out.len))).stream.map((\ entry [path.snoc(entry.key) (unpin entry.val.held)]))
    | _ children.weld(pending.tail) out.cons(path)
  + projected_source
    \ tree=bool query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/projected_source_value tree query state)

  + projected_source_value
    \ tree=bool query=goo_runtime/request state=namespace
    ^ json
    = source query.target
      axis (goo_runtime/axis query)
      projected (goo_runtime/projection axis source state)
      paths=list[path]
        ? !(projected.wyt) .nil
        ? tree (goo_runtime/projected_paths projected source)
        | projected.kid.range_after(.none 65).stream.map((\ entry source.snoc(entry.key)))
      members
        | paths.take(64).map
          \ path
          = member (goo_runtime/member_status (maybe/is_some projected.dip(path.drop(source.len)).fil) source path state)
          ?> (json/obj fields) member member
          = fields fields.snoc((jkv "axis" (json/str axis)))
          ? !tree (json/obj fields)
          | json/obj fields.snoc((jkv "topology" (json/str "tree"))).snoc((jkv "parent" (? (equal path source) jnull (json/str (path_show path.take(path.len.dec))))))
    | json/obj
      [(jkv "id" (json/str (path_show source)))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime source state))))
       (jkv "type" (json/str "namespace-record"))
       (jkv "axis" (json/str axis))
       (jkv "topology" (json/str (? tree "tree" "children")))
       (jkv "bounded" (json/boo (le paths.len 64)))
       (jkv "members" (json/arr members.row))]

  + source
    \ query=goo_runtime/request state=namespace
    ^ str
    | goo_runtime/projected_source .false query state
  + tree_source
    \ query=goo_runtime/request state=namespace
    ^ str
    | goo_runtime/projected_source .true query state
  + input_text
    \ key=str query=goo_runtime/request
    ^ str
    = values query.inputs.keep((\ [name value] (eq name key)))
    ? !(eq values.len 1) ""
    = [name value] values.at(0)
    value
  + printable_path
    \ path=path
    ^ bool
    ? (Try path_show path)
     > (./ok _) .true
     > (./err _) .false
  + tree_page
    \ query=goo_runtime/request state=namespace
    ^ either[str str]
    < value (goo_runtime/tree_page_value query state)
    | ./ok (show value)

  + tree_page_value
    ' Page only immediate children. Continuations are tied to one namespace epoch.
    \ query=goo_runtime/request state=namespace
    ^ either[str json]
    = source query.target axis (goo_runtime/axis query)
      parent_text (goo_runtime/input_text "$parent" query)
      after_text (goo_runtime/input_text "$after" query)
      epoch (nat/show state.local.rec.len)
      expected (goo_runtime/input_text "$epoch" query)
    ?> (./some parent) (path_parse (? parent_text.len parent_text (path_show source))) (./err "Invalid tree parent.")
    ? !(pith_prefix source parent) (./err "Tree parent is outside its source.")
    ? (and expected.len !(eq expected epoch)) (./err "Tree changed; refresh its children.")
    ? (and after_text.len !(expected.len)) (./err "Tree continuation requires its epoch.")
    = projected (goo_runtime/projection axis source state)
      subtree projected.dip(parent.drop(source.len))
      after=maybe[path]
        ? !(after_text.len) .none
        ? (path_parse after_text)
         > (./some path) (./some path)
        | physical_key/decode after_text
    ? (and after_text.len (maybe/is_none after)) (./err "Invalid tree cursor.")
    ? (after.run((\ path !(and (eq path.len parent.len.inc) (pith_prefix parent path)))).fall(.false))
      | ./err "Tree cursor is outside its parent."
    ? !(subtree.wyt) (./err "Tree parent is unavailable.")
    = selected subtree.kid.range_after(after.run((\ path path.at(parent.len))) 65)
      count (? (gt selected.len 64) 64 selected.len)
      visible (selected.take(count).keep((\ entry (goo_runtime/printable_path parent.snoc(entry.key)))))
      continuation=either[str json]
        ? !(gt selected.len 64) (./ok jnull)
        ? (physical_key/encode parent.snoc(selected.at(count.dec).key))
         > (./ok cursor) (./ok (json/str cursor))
        | ./err "Tree cursor exceeds its key budget; use the physical debugger for this branch."
    < next continuation
    =
      describe
        \ path=path node=axal[myth]
        ^ json
        = member (goo_runtime/member_status (maybe/is_some node.fil) source path state)
        ?> (json/obj fields) member member
        | json/obj fields.weld([(jkv "axis" (json/str axis)) (jkv "topology" (json/str "tree"))
            (jkv "parent" (? (equal path source) jnull (json/str (path_show path.take(path.len.dec)))))
            (jkv "hasChildren" (json/boo (gt node.kid.size 0)))])
      members (visible.map((\ entry (describe parent.snoc(entry.key) (unpin entry.val.held)))))
      members (? (and !(parent_text.len) !(after_text.len)) members.cons((describe source projected)) members)
    | ./ok (json/obj [(jkv "id" (json/str (path_show source)))
        (jkv "life" (json/str (nat/show (goo_runtime/lifetime source state))))
        (jkv "type" (json/str "namespace-record")) (jkv "axis" (json/str axis))
        (jkv "topology" (json/str "tree")) (jkv "incremental" (json/boo .true))
        (jkv "bounded" (json/boo .true)) (jkv "epoch" (json/str epoch))
        (jkv "omitted" (json/num .false (sub count visible.len)))
        (jkv "parent" (json/str (path_show parent))) (jkv "next" next)
        (jkv "members" (json/arr members))])

  + status
    \ query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/status_value query state)

  + status_value
    \ query=goo_runtime/request state=namespace
    ^ json
    = target (goo_runtime/target query.target state)
      expected=nat
        ? target
         > (./some target) (state.case(.x target)).fall(0)
        0
    | json/obj
      [(jkv "projectionSeq" (json/num .false state.local.rec.len))
       (jkv "coveredOperationIds" (json/arr ((goo_runtime/journal state).keep((\ entry (equal entry.request.target query.target))).map((\ entry (json/str entry.identity))).row)))
       (jkv "life" (json/str (nat/show (goo_runtime/lifetime query.target state))))
       (jkv "subject" (json/str (path_show query.target)))
       (jkv "target" (json/str (path_show target.fall([]))))
       (jkv "expected" (json/str (nat/show expected)))
       (jkv "displayed" (json/str (nat/show (state.case(.y query.target)).fall(0))))
       (jkv "recipePublication" (json/str (nat/show (? query.view.len (state.case(.x query.view)).fall(0) (goo_runtime/publication state)))))
       (jkv "publication" (json/str (nat/show (goo_runtime/publication state))))]

  + json_field
    \ key=str value=json
    ^ json
    ?> (json/obj entries) value jnull
    | entries.fold jnull (\ out entry (? (eq entry.k key) entry.v out))
  + json_text
    \ value=json
    ^ str
    ?> (json/str text) value ""
    text
  + capture_value
    \ input=row[[str str]] slot=path
    ^ either[str json]
    = matches (input.keep((\ [key value] (eq key (path_show slot)))))
    ? !(eq matches.len 1) (./err "Missing or duplicate selection capture.")
    = [key text] matches.at(0)
    ?> (jres/ok value rest) (parse text) (./err "Invalid selection capture.")
    | ./ok (goo_runtime/json_field "member" value)
  + operand_path
    \ expression=rex
    ^ maybe[path]
    ? (goo_runtime/read_path expression)
     > (./some path) (./some path)
    % rest=row[rex] expression.children
    ^ maybe[path]
    ? (eq rest.len 0) .none
    ? (goo_runtime/operand_path rest.at(0))
     > (./some path) (./some path)
    | _ rest.drop(1)
  + source_path
    \ published=goo/published card=myth expression=rex
    ^ maybe[path]
    ? (goo_runtime/read_path expression)
     > (./some path) (./some path)
    ?> (./nest _ _ rune kids) expression .none
    ? !(and (eq rune ".") (eq kids.len 2)) .none
    ? !(eq kids.at(0).print published.view.binding) .none
    = fields published.fields.keep((\ field (eq field.name kids.at(1).print)))
    ? !(eq fields.len 1) .none
    ?> (./some held) card.get(fields.at(0).slot) .none
    ?> value=pails/p held .none
    | ./some value.p
  + source_arguments
    \ published=goo/published card=myth node=goo/node
    ^ either[str list[rex]]
    ? !((eq node.constructor "selection") || (grove_views/topos node.constructor) || (eq node.constructor "navigate")) (./ok node.arguments)
    ?> (./some expression) (goo_runtime/named "source" node.arguments) (./err "Missing pane source.")
    ?> (./some path) (goo_runtime/source_path published card expression) (./err "Pane source has no path value.")
    = rewrite
        \ argument=rex
        ^ rex
        ? (maybe/is_some (goo_runtime/named "source" (list/one argument)))
          | rex/rune "=" [(rex/word "source") (rex/quip (str/cat_all ["'" (path_show path)]))]
        argument
    | ./ok node.arguments.map(rewrite)
  + bind_sources
    \ published=goo/published card=myth nodes=list[goo/node]
    ^ either[str list[goo/node]]
    ? nodes.is_nil (./ok .nil)
    = node nodes.head
    < children (goo_runtime/bind_sources published card node.children)
    < arguments (goo_runtime/source_arguments published card node)
    < tail (goo_runtime/bind_sources published card nodes.tail)
    | ./ok tail.cons(node.set_arguments(arguments).set_children(children))
  + selection_source
    \ key=path nodes=list[goo/node] route=row[nat] found=maybe[path]
    ^ maybe[path]
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) .none
    = node nodes.at(route.at(0))
      next=maybe[path]
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        ?> (./some source) (goo_runtime/named "source" node.arguments) .none
        | goo_runtime/read_path source
    | goo_runtime/selection_source key node.children route.drop(1) next
  + selection_tree
    \ key=path nodes=list[goo/node] route=row[nat] found=bool
    ^ bool
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) .false
    = node nodes.at(route.at(0))
      next=bool
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        | eq (goo_runtime/named "topology" node.arguments).fall((rex/cord "children")).print (rex/cord "tree").print
    | goo_runtime/selection_tree key node.children route.drop(1) next
  + selection_axis
    \ key=path nodes=list[goo/node] route=row[nat] found=str
    ^ str
    ? (eq route.len 0) found
    ? (ge route.at(0) nodes.len) ""
    = node nodes.at(route.at(0))
      next=str
        ? !(eq node.constructor "selection") found
        ? (eq node.arguments.len 0) found
        ? !(equal (goo_runtime/read_path node.arguments.head) (maybe/some[path] key)) found
        = value (goo_runtime/named "axis" node.arguments).fall((rex/cord "z"))
        ?> (./leaf _ _ text) value ""
        text
    | goo_runtime/selection_axis key node.children route.drop(1) next
  + bound_captures
    \ nodes=list[goo/node] route=row[nat] fields=list[rex] input=row[[str str]]
    ^ either[str unit]
    ? fields.is_nil (./ok [])
    ?> (./nest _ _ rune kids) fields.head (goo_runtime/bound_captures nodes route fields.tail input)
    ? !(and (eq rune "=") (eq kids.len 2)) (goo_runtime/bound_captures nodes route fields.tail input)
    ? !(goo_runtime/mentions "capture" kids.at(1)) (goo_runtime/bound_captures nodes route fields.tail input)
    ?> (./some key) (goo_runtime/operand_path kids.at(1)) (./err "Capture must name a lexical selection.")
    ?> (./some source) (goo_runtime/selection_source key nodes route .none) (./err "Capture selection is not in scope.")
    ?> (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Invalid capture slot.")
    < member (goo_runtime/capture_value input slot)
    ? !(eq (path_show source) (goo_runtime/json_text (goo_runtime/json_field "source" member)))
      | ./err "Capture source does not match the published selection declaration."
    ?> (./some subject) (path_parse (goo_runtime/json_text (goo_runtime/json_field "subject" member))) (./err "Invalid capture subject.")
    = axis (goo_runtime/json_text (goo_runtime/json_field "axis" member))
    ? !(eq (goo_runtime/selection_axis key nodes route "z") (? axis.len axis "z"))
      | ./err "Capture axis does not match the published selection declaration."
    = tree (goo_runtime/selection_tree key nodes route .false)
    ? !(eq tree (eq (goo_runtime/json_text (goo_runtime/json_field "topology" member)) "tree"))
      | ./err "Capture topology does not match the published selection declaration."
    ? !(and (pith_prefix source subject) (tree || (eq subject.len source.len.inc)))
      | ./err "Capture is outside the declared source topology."
    | goo_runtime/bound_captures nodes route fields.tail input
  + validate_captures
    \ input=row[[str str]] fields=list[rex] state=namespace
    ^ either[str unit]
    ? fields.is_nil (./ok [])
    = field fields.head
    ?> (./nest _ _ rune kids) field (goo_runtime/validate_captures input fields.tail state)
    ? !(and (eq rune "=") (eq kids.len 2)) (goo_runtime/validate_captures input fields.tail state)
    ? !(goo_runtime/mentions "capture" kids.at(1)) (goo_runtime/validate_captures input fields.tail state)
    ?> (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Invalid capture argument slot.")
    < value (goo_runtime/capture_value input slot)
    = text (\ key=str (goo_runtime/json_text (goo_runtime/json_field key value)))
    ?> (./some source) (path_parse (text "source")) (./err "Invalid capture source.")
    ?> (./some subject) (path_parse (text "subject")) (./err "Invalid capture subject.")
    ? !(and (eq (text "type") "namespace-record") (eq (text "key") (path_show subject)))
      | ./err "Incompatible capture membership."
    = tree (eq (text "topology") "tree")
      axis_text=str (text "axis")
      axis=str (? (gt axis_text.len 0) axis_text "z")
      projected (goo_runtime/projection axis source state)
      belongs=bool
        ? !tree (and (and (eq subject.len source.len.inc) (pith_prefix source subject)) (maybe/is_some projected.dip(subject.drop(source.len)).fil))
        | and (pith_prefix source subject) (maybe/is_some projected.dip(subject.drop(source.len)).fil)
    ? !belongs
      | ./err "Capture is not a member of its finite source."
    ? !(and (state.permitted(subject)) (pith_prefix [state.self 'app] subject))
      | ./err "Captured subject is outside application authority."
    ? !(and (eq (text "life") (nat/show (goo_runtime/lifetime subject state)))
         (eq (text "sourceLife") (nat/show (goo_runtime/lifetime source state))))
      | ./err "Captured membership was removed or replaced."
    ? !(eq (text "expected") (nat/show (state.case(.x subject)).fall(0)))
      | ./err "Captured subject changed before admission."
    ? (maybe/is_none (goo_runtime/record .x subject state)) (./err "Captured subject is unavailable.")
    ? !(projected.wyt) (./err "Captured source is unavailable.")
    | goo_runtime/validate_captures input fields.tail state
  + argument
    \ published=myth input=row[[str str]] now=nat slot=path value=rex
    ^ either[str pail]
    ? (goo_runtime/mentions "capture" value)
      < member (goo_runtime/capture_value input slot)
      ?> (./some subject) (path_parse (goo_runtime/json_text (goo_runtime/json_field "subject" member)))
        | ./err "Invalid captured subject."
      | ./ok (pails/p subject)
    ? (goo_runtime/mentions "provider" value)
      ? !(equal[path] slot system_vocabulary/now) (./err "Unknown provider; only /sys/now is available.")
      | ./ok (pails/dm (add (quip_val '@1970.1.1..0.0.0) (mul now 1024)))
    ? (goo_runtime/mentions "input" value)
      = matches (input.keep((\ [key value] (equal[str] key (path_show slot)))))
      ? !(eq matches.len 1) (./err "Missing or duplicate input value.")
      = [key text] matches.at(0)
      | ./ok (pails/t text)
    ? (equal[maybe[str]] value.leaf_kind (maybe/some[str] "cord"))
      ?> (./leaf _ _ text) value (./err "Invalid text argument.")
      | ./ok (pails/t text)
    ?> (./some path) (goo_runtime/read_path value) (./err "Unsupported action argument.")
    ?> (./some held) published.get(grove_view_publication/constants_slot)
      | ./err "Missing compiled action constants."
    ?> constants=grove_view_constants held (./err "Invalid compiled action constants.")
    ?> (./some value) constants.values.get(path) (./err "Unknown compiled action constant.")
    | ./ok value
  + arguments
    \ published=myth input=row[[str str]] now=nat fields=list[rex]
    ^ either[str myth]
    % rest=list[rex] fields out=myth myth/new
    ^ either[str myth]
    ? (eq rest.len 0) (./ok out)
    ?> (./nest _ _ rune kids) rest.at(0) (./err "Invalid action binding.")
    ? !(and (eq rune "=") (eq kids.len 2)) (./err "Invalid action binding.")
    ?> (./some slot) (goo_runtime/read_path kids.at(0)) (./err "Expected an argument slot path.")
    < value (goo_runtime/argument published input now slot kids.at(1))
    | _ rest.drop(1) out.put(slot value)
  + published
    \ record=myth
    ^ either[str goo/published]
    ?> (./some held) record.get(system_vocabulary/grove/view) (./err "Not a published view.")
    ?> view=goo/published held (./err "Invalid published view.")
    | ./ok view
  + matching_view
    \ published=goo/published current=myth
    ^ either[str goo/view]
    ? (maybe/is_some (fit_check current.put(system_vocabulary/lash published.contract))) (./err "Object no longer matches this view.")
    ?> (./ok lowered) published.result (./err "View has compiler errors.")
    | ./ok lowered
  + bound_control
    \ binding=str found=[goo/node goo_runtime/scope]
    ^ either[str [goo/node goo_runtime/scope]]
    = [node scope] found
    ? !(eq node.constructor "action") (./err "Expected an action control.")
    ? (maybe/is_some scope.make)
      ? ((maybe/is_some scope.receiver) || (maybe/is_some scope.action)) (./err "make cannot be combined with on or action.")
      ? (maybe/is_none scope.role) (./err "make requires a role.")
      | ./ok found
    ?> (./some receiver) scope.receiver (./err "Action group requires on = receiver.")
    ? !(eq receiver.print binding) (./err "Only the current receiver is supported.")
    | ./ok found
  + control
    \ query=goo_runtime/request published=goo/published current=myth
    ^ either[str [goo/node goo_runtime/scope]]
    < lowered (goo_runtime/matching_view published current)
    = empty=goo_runtime/scope (goo_runtime/scope .none .none .nil .none .none)
    ?> (./some found) (goo_runtime/locate lowered.children query.control empty)
      | ./err "Unknown control."
    | goo_runtime/bound_control published.view.binding found
  + dispatch
    \ action=rex arguments=myth current=myth contract=lash state=namespace
    ^ either[str myth]
    ? (goo_runtime/mentions "poke" action)
      = next current.meld(arguments)
      ? (maybe/is_some (fit_check next.put(system_vocabulary/lash contract))) (./err "Edited fields violate the view's role.")
      | ./ok next
    ?> (./some path) (goo_runtime/read_path action) (./err "Invalid action reference.")
    ?> (./some declaration) (goo_runtime/record .x path state) (./err "Action no longer exists.")
    ?> (./some held) declaration.get(system_vocabulary/grove/action_handler) (./err "Action has no compiled handler.")
    ?> handler=grove_action_handler held (./err "Invalid compiled action handler.")
    = invoke handler.apply
    ?> (./ok result) (Try (invoke arguments) current) (./err "Action failed during execution; the object was not changed.")
    ?> (./some next) result (./err "Action rejected its arguments or receiver.")
    | ./ok next
  + prepared
    \ query=goo_runtime/request published=myth current=myth state=namespace
    ^ either[str myth]
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
      bindings=list[rex] (node.arguments.drop(1).keep((\ arg=rex (maybe/is_none (goo_runtime/named "become" (list/one arg))))))
    < lowered (goo_runtime/matching_view view current)
    < nodes (goo_runtime/bind_sources view current lowered.children)
    < bound (goo_runtime/bound_captures nodes query.control scope.values.weld(bindings) query.inputs)
    < validated (goo_runtime/validate_captures query.inputs scope.values.weld(bindings) state)
    | goo_runtime/arguments published query.inputs query.now scope.values.weld(bindings)
  + updated
    \ query=goo_runtime/request published=myth current=myth state=namespace
    ^ either[str myth]
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
    ?> (./some action) scope.action (./err "Action group requires an action.")
    < arguments (goo_runtime/prepared query published current state)
    | goo_runtime/dispatch action arguments current view.contract state
  + create
    \ query=goo_runtime/request published=myth current=myth state=namespace scope=goo_runtime/scope
    ^ either[str namespace]
    < view (goo_runtime/published published)
    ?> (./some expression) scope.make (./err "Missing creation destination.")
    ?> (./some target) (goo_runtime/source_path view current expression) (./err "Creation destination must have a path value.")
    ? !(and state.permitted(target) (pith_prefix [state.self 'app] target)) (./err "Creation destination is outside application authority.")
    ? (sovereign_peek target state).wyt (./err "Creation destination is occupied.")
    ?> (./some expression) scope.role (./err "Missing creation role.")
    ?> (./some role_path) (goo_runtime/read_path expression) (./err "Creation role must be a declaration path.")
    ?> (./some role) (goo_runtime/record .x role_path state) (./err "Creation role is unavailable.")
    ?> (./some held) role.get(system_vocabulary/grove/role_contract) (./err "Creation role has no contract.")
    ?> contract=lash held (./err "Invalid creation role contract.")
    < arguments (goo_runtime/prepared query published current state)
    = next arguments.put(system_vocabulary/lash contract)
    ? (maybe/is_some (fit_check next)) (./err "Initial fields violate the creation role.")
    ? (grove_install/change target (writ/make next) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))
  + apply
    \ query=goo_runtime/request state=namespace
    ^ either[str namespace]
    ? !(eq query.publication (goo_runtime/publication state)) (./err "Views changed; refresh before submitting.")
    ? !(eq query.displayed (state.case(.y query.target)).fall(0)) (./err "Object changed; refresh before submitting.")
    ?> (./some target) (goo_runtime/target query.target state) (./err "This presentation has no writable source object.")
    ? !(equal[path] target query.subject) (./err "The presentation now refers to a different object; refresh before submitting.")
    ? !(state.permitted(target)) (./err "Object is outside this namespace's authority.")
    ? !(pith_prefix [state.self 'app] target) (./err "Only application objects are writable here.")
    ? !(eq query.expected (state.case(.x target)).fall(0)) (./err "Object changed; refresh before submitting.")
    ?> (./some current) (goo_runtime/record .x target state) (./err "Object no longer exists.")
    ?> (./some published) (goo_runtime/record .x query.view state) (./err "View no longer exists.")
    < view (goo_runtime/published published)
    < found (goo_runtime/control query view current)
    = [node scope] found
    ? (maybe/is_some scope.make) (goo_runtime/create query published current state scope)
    ' A published namespace operation uses the same bound controls, captures,
    ' revisions and receipts, but may commit a domain transaction atomically.
    = operation=maybe[path]
        < expression scope.action
        < operation (goo_runtime/read_path expression)
        = declaration (goo_runtime/record .x operation state).fall(myth/new)
        ? !(declaration.has(system_vocabulary/op)) .none
        | ./some operation
    ? (maybe/is_some operation)
      < arguments (goo_runtime/prepared query published current state)
      ?> (./ok planned) (Try (namespace_command/plan target operation.fall([]) arguments) state)
        | ./err "Native action planning failed."
      ?> (./ok writes) planned (./err "Native action rejected the edit; refresh or review the draft.")
      ? (grove_install/changes writes state)
       > (./ok next) (./ok next)
       > (./err why) (./err (str/from_atom (iota_show why)))
    < next (goo_runtime/updated query published current state)
    ? (grove_install/change target (writ/make next) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))
  + receipt
    : identity=str request=goo_runtime/request body=str
  + receipts
    : entries=list[goo_runtime/receipt]
  + receipt_slot
    ^ path
    system_vocabulary/goo/receipts
  + journal
    \ state=namespace
    ^ list[goo_runtime/receipt]
    = record (goo_runtime/record .x [state.self 'weft 'goo_receipts] state).fall(myth/new)
    ?> (./some held) record.get(goo_runtime/receipt_slot) .nil
    ?> receipts=goo_runtime/receipts held .nil
    receipts.entries
  + operation_status
    \ query=goo_runtime/request state=namespace
    ^ str
    | show (goo_runtime/operation_status_value query state)

  + operation_status_value
    \ query=goo_runtime/request state=namespace
    ^ json
    = ids (query.inputs.keep((\ [key value] (eq key "$invocation"))))
      identity=str
        ? !(eq ids.len 1) ""
        = [key value] ids.at(0)
        value
      matches ((goo_runtime/journal state).keep((\ entry (and (eq entry.identity identity) (equal entry.request.target query.target)))))
    | json/obj [(jkv "operationId" (json/str identity))
        (jkv "outcome" (json/str (? matches.is_nil "unknown" "accepted")))]

  + act
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat str]
    = identities (query.inputs.keep((\ [key value] (eq key "$invocation"))))
      identity=str
        ? (eq identities.len 1)
          = [key value] identities.at(0)
          value
        ""
      home=path [state.self 'weft 'goo_receipts]
      journal (goo_runtime/record .x home state).fall(myth/new)
      entries=list[goo_runtime/receipt]
        ?> (./some held) journal.get(goo_runtime/receipt_slot) .nil
        ?> receipts=goo_runtime/receipts held .nil
        receipts.entries
      prior (entries.keep((\ entry (eq entry.identity identity))))
      request query.set_now(0)
    ? (and (gt identity.len 0) (gt prior.len 0))
      ? (equal request prior.head.request) [state 200 prior.head.body]
      [state 409 (show (json/obj [(jkv "error" (json/str "Invocation identity was reused with changed arguments."))]))]
    ? (and (gt identity.len 0) (ge entries.len 1024))
      [state 409 (show (json/obj [(jkv "error" (json/str "Development invocation journal is full; restart the namespace."))]))]
    ? (goo_runtime/apply query state)
     > (./ok next)
      = body (goo_runtime/status query next)
      ? (eq identity.len 0) [next 200 body]
      = record (journal.put(goo_runtime/receipt_slot
          (goo_runtime/receipts entries.snoc((goo_runtime/receipt identity request body)))))
      ? (grove_install/change home (writ/make record) next)
       > (./ok committed) [committed 200 body]
       > (./err _) [state 409 (show (json/obj [(jkv "error" (json/str "Unable to retain invocation receipt."))]))]
     > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
  + run
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat str]
    ? (eq query.operation "edit-value")
      ?> (./some slot) (path_parse (goo_runtime/input_text "slot" query))
        [state 400 (show (json/obj [(jkv "error" (json/str "Invalid slot path."))]))]
      = context (goo_runtime/input_text "context" query)
      ?> (./some scope) (? context.len (path_parse context) (maybe/some[path] []))
        [state 400 (show (json/obj [(jkv "error" (json/str "Invalid Foil context path."))]))]
      ? (goo_value/edit query.target slot query.expected (goo_runtime/input_text "kind" query)
          (goo_runtime/input_text "value" query) scope state)
       > (./ok next) [next 200 (goo_runtime/status query next)]
       > (./err why) [state 409 (show (json/obj [(jkv "error" (json/str why))]))]
    ? (eq query.operation "operation-status") [state 200 (goo_runtime/operation_status query state)]
    ? (eq query.operation "status") [state 200 (goo_runtime/status query state)]
    ? (eq query.operation "tree-page")
      ? (goo_runtime/tree_page query state)
       > (./ok body) [state 200 body]
       > (./err why) [state 409 why]
    ? (eq query.operation "tree-source") [state 200 (goo_runtime/tree_source query state)]
    ? (eq query.operation "source") [state 200 (goo_runtime/source query state)]
    ? !(eq query.operation "act") [state 400 "{}"]
    | goo_runtime/act query state

  + run_value
    \ query=goo_runtime/request state=namespace
    ^ [namespace nat json]
    ? (eq query.operation "source") [state 200 (goo_runtime/projected_source_value .false query state)]
    ? (eq query.operation "tree-source") [state 200 (goo_runtime/projected_source_value .true query state)]
    ? (eq query.operation "status") [state 200 (goo_runtime/status_value query state)]
    ? (eq query.operation "operation-status") [state 200 (goo_runtime/operation_status_value query state)]
    ? (eq query.operation "tree-page")
      ? (goo_runtime/tree_page_value query state)
       > (./ok value) [state 200 value]
       > (./err why) [state 409 (json/obj [(jkv "error" (json/str why))])]
    ' Action receipts retain their existing persisted representation and equality.
    = [next status body] (goo_runtime/run query state)
    ? (parse body)
     > (jres/ok value rest) [next status value]
    [next status (json/obj [(jkv "error" (json/str body))])]
