-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
- fs_read

+ fs
  + extensions
    : hands=mop[iota row[path] lt_iota]
  + target_slot
    | publisher_vocabulary/locate ['fs 'target]
  + extensions_slot
    | publisher_vocabulary/locate ['fs 'extensions]
  + destination
    \ rec=myth
    ^ maybe[path]
    | (rec.crew_at(bond/crew)).get(fs/target_slot).run(dep/p)
  + rules
    \ rec=myth
    ^ fs/extensions
    . rec
     get(fs/extensions_slot)
     then(fs/extensions/try_from_pail)
     fall((fs/extensions (mop/empty)))
  + extension
    \ name=str
    ^ str
    = parts | str/split_byte 46 name
    ? (lt parts.len 2) ""
    | parts.at parts.len.dec
  + batch
    : epoch=nat config=myth files=row[fs_read/file]
  + failure
    : epoch=nat config=myth reason=str
  + report
    : epoch=nat target=path known=row[str] missing=row[str]
  + finish
    \ bol=bowl cur=myth scan=fs/batch
    ^ yell
    = epoc | cur.nat_at bond/epoch 0
      root | cur.txt_at bond/from
      pen
        . cur
         get(bond/pending)
         then(pails/b/try_from_pail)
         run(pails/b/b)
         fall(.false)
    ? !(and pen (eq epoc scan.epoch))
     | yell [] cur
    ? !(equal[str] root (scan.config.txt_at(bond/from)))
     | yell [] cur
    ? !(equal (fs/destination cur) (fs/destination scan.config))
     | yell [] cur
    ? !(equal (fs/rules cur) (fs/rules scan.config))
     | yell [] cur
    ?> (./some target) (fs/destination cur)
      (yell [] cur)
    = rules | fs/rules cur
    = names=row[str] | scan.files.map fs_read/file/name
      prev=row[str]
        ?> (./some held) (cur.get(bond/res)) []
        ?> (./some report) (fs/report/try_from_pail held) []
        ? !(equal[path] report.target target) []
        report.known
      lost
        | prev.keep
         \ name=str
         !(row/any[str] (\ item=str (equal[str] name item)) names)
      known | names.weld lost
      view | bol.crew.gut(fs/target_slot (axal/new[myth] .none))
      empty=row[[p=path q=writ]] []
      cards
        | scan.files.fold empty
         \ out=row[[p=path q=writ]] file=fs_read/file
         ^ row[[p=path q=writ]]
         = key=iota ($ta file.name)
           dest | target.snoc key
           hands | rules.hands.gut(($ta (fs/extension file.name)) [])
           rec
             | (kooked hands).put bond/content (pails/n file.bytes)
           old | view.get([key]).fall(myth/new)
         ? | and (equal old.get(bond/content) rec.get(bond/content))
             (equal old.get(bond/limb) rec.get(bond/limb))
          out
         | out.snoc [dest (writ/make rec)]
      out
        . cur
         put(bond/res (fs/report epoc target known lost))
         put(bond/pending (pails/b .false))
    | yell cards out
  + desk  str
  + cfg
    \ des=fs/desk target=path rules=fs/extensions hand=path
    ^ myth
    = out | kooked [hand]
    . out
     put(bond/from (pails/t des))
     put(bond/crew (cpail (crew/sing fs/target_slot (dep .y target))))
     put(fs/extensions_slot rules)
     put(bond/epoch (pails/n 0))
     put(bond/pending (pails/b .false))
  + failed
    \ cur=myth failure=fs/failure
    ^ yell
    = pending
        . cur
          get(bond/pending)
          then(pails/b/try_from_pail)
          run(pails/b/b)
          fall(.false)
    ? !pending (yell [] cur)
    = valid
        | and (eq cur.nat_at(bond/epoch 0) failure.epoch)
          (equal (fs/destination cur) (fs/destination failure.config))
    ? !valid (yell [] cur)
    ? !(equal[str] cur.txt_at(bond/from)
        failure.config.txt_at(bond/from)) (yell [] cur)
    ? !(equal (fs/rules cur) (fs/rules failure.config))
      (yell [] cur)
    | yell []
      | cur.put(bond/res failure).put bond/pending (pails/b .false)
  + talk
    \ bol=bowl cur=myth add=myth
    ^ yell
    ? add.get(bond/res)
     > (./some value)
      ? value
       > scan=fs/batch (%/finish bol cur scan)
       > failure=fs/failure (%/failed cur failure)
      (%/request bol cur add)
     > .none (%/request bol cur add)
  + request
    \ bol=bowl cur=myth add=myth
    ^ yell
    | yell []
    = pen
     . add
      get(bond/pending)
      then(pails/b/try_from_pail)
      run(pails/b/b)
      fall(.false)
    = poc
     . cur
      get(bond/epoch)
      then(pails/n/try_from_pail)
      run(pails/n/n)
      fall(0)
    = cur cur.meld(add)
    ? !pen
     cur
    cur.put(bond/epoch (pails/n poc.inc))
  + form
    ^ form
    def_form.set_talk(fs/talk)
