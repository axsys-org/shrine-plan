- grove_install
- json

+ interaction_runtime
  ' Authenticated transports invoke an installed native endpoint. Endpoint
  ' code owns interpretation and guarded operations; the host only transports.
  + request
    : target=path principal=str operation=str expected=nat event=str body=str
  + endpoint
    : run={\ interaction_runtime/request namespace}[namespace nat str]
  + slot
    ^ path
    ['sys 'interaction 'endpoint]
  + indexed_endpoint
    ' Native owner contexts may retain their existing crew index. This is
    ' process state, not a second dependency graph owned by a presentation.
    : run={\ interaction_runtime/request namespace hive}[namespace hive nat str]
  + indexed_slot
    ^ path
    ['sys 'interaction 'indexed_endpoint]
  + run_indexed
    \ query=interaction_runtime/request state=namespace index=hive
    ^ [namespace hive nat str]
    = record (sovereign_care .x query.target state).fil.fall(myth/new)
    ? record.get(interaction_runtime/indexed_slot)
     > (./some held)
      ?> endpoint=interaction_runtime/indexed_endpoint held
        [state index 409 (show (json/obj [(jkv "error" (json/str "Invalid native indexed endpoint."))]))]
      = invoke endpoint.run
      ? (Try[unit [namespace hive nat str]] (\ ignored=unit (invoke query state index)) [])
       > (./ok reply) reply
       > (./err _) [state index 422 (show (json/obj [(jkv "error" (json/str "Native interaction failed; committed work is unchanged."))]))]
     > .none
      = [next status body] (interaction_runtime/run query state)
        next_index (? (eq next.local.top state.local.top) index (sovereign_hive next))
      [next next_index status body]
  + run
    \ query=interaction_runtime/request state=namespace
    ^ [namespace nat str]
    = record (sovereign_care .x query.target state).fil.fall(myth/new)
    ?> (./some held) record.get(interaction_runtime/slot)
      [state 404 (show (json/obj [(jkv "error" (json/str "No native interaction endpoint at this subject."))]))]
    ?> endpoint=interaction_runtime/endpoint held
      [state 409 (show (json/obj [(jkv "error" (json/str "Invalid native interaction endpoint."))]))]
    = invoke endpoint.run
    ? (Try[unit [namespace nat str]] (\ ignored=unit (invoke query state)) [])
     > (./ok reply) reply
     > (./err _) [state 422 (show (json/obj [(jkv "error" (json/str "Native interaction could not complete; installed state is unchanged."))]))]
