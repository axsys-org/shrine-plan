-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  semidoc [order=30]
-  foundry [order=35]
-  foundry_doc [order=40]
'  foundry_corpus: deterministic admission of explicitly named Foundry
'  documents authored in Semidoc pages.
'
'  A page locator is provenance, never semantic identity.  Identity comes
'  only from /foundry/name and addressed surface-node definitions.  Sources
'  may therefore be renamed, reordered, and collected from Nenex or another
'  authoring host without changing the semantic graph.  All sources compile
'  before typed references are checked, so forward references are ordinary.
'  Backlinks are a reverse impact view derived after admission; they do not
'  enter identity, closure, or validation.
+  foundry_corpus
  +  provenance
    '  locator names the authoring source.  witness optionally pins the exact
    '  source revision (/h path, pin-ref path, or another host-owned witness).
    :  locator=path witness=maybe[path]

  +  source
    :  provenance=foundry_corpus/provenance text=nat

  +  record_source
    '  A normalized, observation-free Foundry record packet.  records has the
    '  exact ordinary namespace shape emitted by foundry_doc/records: the
    '  document metadata record at [], followed by optional graph records.
    '  The packet carries data only; no form, kook, Hole, or native operation
    '  may ride this admission boundary.
    :  provenance=foundry_corpus/provenance
       records=row[[p=path t=myth]]

  +  page_source
    '  One already-expanded Nenex/Semidoc page.  tree is ordinary hydrated
    '  namespace data; semidoc/node_back supplies the inverse projection, so
    '  admission never consults or reparses an application ['src] slot.
    :  provenance=foundry_corpus/provenance tree=axal[myth]

  +  definition
    '  kind is layer, recipe, catalog, surface, or surface_node.  owner is the
    '  explicitly named document that contributed the symbol.  Only document
    '  symbols carry their compiled value.
    '  The contributing ordinary record is retained verbatim.  Typed
    '  interpretation ignores unknown safe fields, but they are not erased.
    :  name=path
       kind=iota
       owner=path
       provenance=foundry_corpus/provenance
       document=maybe[foundry_doc/document]
       record=maybe[myth]

  +  reference
    '  expected is the required target-definition kind.  relation and field
    '  retain why the edge exists without inventing an untyped generic link.
    :  from=path relation=iota field=path expected=iota target=path

  +  diagnostic
    :  provenance=foundry_corpus/provenance
       subject=path
       field=path
       code=iota
       message=nat

  +  backlink
    :  target=path sources=row[path]

  +  admission
    :  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
       backlinks=row[foundry_corpus/backlink]
       diagnostics=row[foundry_corpus/diagnostic]

  +  closure
    :  root=path
       definitions=row[foundry_corpus/definition]
       diagnostics=row[foundry_corpus/diagnostic]

  +  impact
    '  Source-facing derived data.  definitions are symbols owned by this
    '  source, incoming are symbols that refer to them, and diagnostics are
    '  source-attributed admission issues.  None of these fields is input.
    :  definitions=row[path]
       incoming=row[path]
       diagnostics=row[foundry_corpus/diagnostic]

  +  index_entry
    '  A deliberately inert corpus observation.  It contains identity,
    '  provenance, graph edges, and validation only -- never a compiled
    '  document value or anything executable.
    :  name=path
       kind=iota
       provenance=foundry_corpus/provenance
       forward=row[path]
       incoming=row[path]
       diagnostics=row[foundry_corpus/diagnostic]

  +  scan
    :  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
       diagnostics=row[foundry_corpus/diagnostic]

  +  visit
    :  definitions=row[foundry_corpus/definition] seen=row[path]

  +  source_candidate
    '  Ordinary Semidoc pages are not failed Foundry documents.  A source
    '  opts in by declaring any /foundry/... field on its top-level document;
    '  once opted in, the complete foundry_doc validator owns diagnostics.
    \  src=nat
    ^  bool
    =  ns  (parse src)
    ?  !(eq 1 ns.len)
       .false
    ?  ns.at(0)
     > (./doc _ as _)
       as.any(foundry_corpus/foundry_attr)
    .false

  +  foundry_attr
    \  a=sattr
    ^  bool
    ?  (eq 0 a.pred.len)  .false
    (eq a.pred.at(0) "foundry")

  +  provenance_lte
    \  a=foundry_corpus/provenance b=foundry_corpus/provenance
    ^  bool
    ?  !(eq_pith a.locator b.locator)
       (lte_pith a.locator b.locator)
    ?  a.witness
     > .none  .true
     > (./some ap)
       ?  b.witness
        > .none  .false
        > (./some bp)  (lte_pith ap bp)

  +  source_lte
    \  a=foundry_corpus/source b=foundry_corpus/source
    ^  bool
    (foundry_corpus/provenance_lte a.provenance b.provenance)

  +  source_insert
    \  x=foundry_corpus/source xs=row[foundry_corpus/source]
    ^  row[foundry_corpus/source]
    |  > i=nat 0
    ^  row[foundry_corpus/source]
    ?  (ge i xs.len)
       xs.snoc(x)
    ?  (foundry_corpus/source_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_sources
    \  xs=row[foundry_corpus/source]
    ^  row[foundry_corpus/source]
    xs.fold([] (\ out x (foundry_corpus/source_insert x out)))

  +  record_source_lte
    \  a=foundry_corpus/record_source b=foundry_corpus/record_source
    ^  bool
    (foundry_corpus/provenance_lte a.provenance b.provenance)

  +  record_source_insert
    \  x=foundry_corpus/record_source xs=row[foundry_corpus/record_source]
    ^  row[foundry_corpus/record_source]
    |  > i=nat 0
    ^  row[foundry_corpus/record_source]
    ?  (ge i xs.len)  xs.snoc(x)
    ?  (foundry_corpus/record_source_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_record_sources
    \  xs=row[foundry_corpus/record_source]
    ^  row[foundry_corpus/record_source]
    xs.fold([] (\ out x (foundry_corpus/record_source_insert x out)))

  +  page_source_lte
    \  a=foundry_corpus/page_source b=foundry_corpus/page_source
    ^  bool
    (foundry_corpus/provenance_lte a.provenance b.provenance)

  +  page_source_insert
    \  x=foundry_corpus/page_source xs=row[foundry_corpus/page_source]
    ^  row[foundry_corpus/page_source]
    |  > i=nat 0
    ^  row[foundry_corpus/page_source]
    ?  (ge i xs.len)  xs.snoc(x)
    ?  (foundry_corpus/page_source_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_page_sources
    \  xs=row[foundry_corpus/page_source]
    ^  row[foundry_corpus/page_source]
    xs.fold([] (\ out x (foundry_corpus/page_source_insert x out)))

  +  definition_lte
    \  a=foundry_corpus/definition b=foundry_corpus/definition
    ^  bool
    ?  !(eq_pith a.name b.name)
       (lte_pith a.name b.name)
    ?  !(eq_pith a.owner b.owner)
       (lte_pith a.owner b.owner)
    (foundry_corpus/provenance_lte a.provenance b.provenance)

  +  definition_insert
    \  x=foundry_corpus/definition xs=row[foundry_corpus/definition]
    ^  row[foundry_corpus/definition]
    |  > i=nat 0
    ^  row[foundry_corpus/definition]
    ?  (ge i xs.len)
       xs.snoc(x)
    ?  (foundry_corpus/definition_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_definitions
    \  xs=row[foundry_corpus/definition]
    ^  row[foundry_corpus/definition]
    xs.fold([] (\ out x (foundry_corpus/definition_insert x out)))

  +  reference_lte
    \  a=foundry_corpus/reference b=foundry_corpus/reference
    ^  bool
    ?  !(eq_pith a.from b.from)  (lte_pith a.from b.from)
    ?  !(eq_pith a.field b.field)  (lte_pith a.field b.field)
    ?  !(eq_pith a.target b.target)  (lte_pith a.target b.target)
    (lte_iota a.relation b.relation)

  +  reference_insert
    \  x=foundry_corpus/reference xs=row[foundry_corpus/reference]
    ^  row[foundry_corpus/reference]
    |  > i=nat 0
    ^  row[foundry_corpus/reference]
    ?  (ge i xs.len)  xs.snoc(x)
    ?  (foundry_corpus/reference_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_references
    \  xs=row[foundry_corpus/reference]
    ^  row[foundry_corpus/reference]
    xs.fold([] (\ out x (foundry_corpus/reference_insert x out)))

  +  diagnostic_lte
    \  a=foundry_corpus/diagnostic b=foundry_corpus/diagnostic
    ^  bool
    ?  !(eq_pith a.provenance.locator b.provenance.locator)
       (lte_pith a.provenance.locator b.provenance.locator)
    ?  !(eq_pith a.subject b.subject)  (lte_pith a.subject b.subject)
    ?  !(eq_pith a.field b.field)  (lte_pith a.field b.field)
    (lte_iota a.code b.code)

  +  diagnostic_insert
    \  x=foundry_corpus/diagnostic xs=row[foundry_corpus/diagnostic]
    ^  row[foundry_corpus/diagnostic]
    |  > i=nat 0
    ^  row[foundry_corpus/diagnostic]
    ?  (ge i xs.len)  xs.snoc(x)
    ?  (foundry_corpus/diagnostic_lte x xs.at(i))
       xs.take(i).snoc(x).weld(xs.drop(i))
    (_ i.inc)

  +  sort_diagnostics
    \  xs=row[foundry_corpus/diagnostic]
    ^  row[foundry_corpus/diagnostic]
    xs.fold([] (\ out x (foundry_corpus/diagnostic_insert x out)))

  +  issue
    \  provenance=foundry_corpus/provenance subject=path field=path
       code=iota message=nat
    ^  foundry_corpus/diagnostic
    (foundry_corpus/diagnostic provenance subject field code message)

  +  compiled_issues
    \  provenance=foundry_corpus/provenance ds=row[foundry_doc/diagnostic]
    ^  row[foundry_corpus/diagnostic]
    ds.map((\ d (foundry_corpus/issue provenance [] d.field d.code d.message)))

  +  pail_svals
    '  Re-express only Semidoc's inert word/reference value domain.  Other
    '  pails remain preserved in the original record but are not interpreted.
    \  pl=pail
    ^  row[sval]
    ?  pl
     > x=pails/t  [(sval/word x.t)]
     > x=pails/p  [(sval/ref (seg_texts x.p))]
     > x=pails/ps  x.ps.map((\ p (sval/ref (seg_texts p))))
    []

  +  record_attrs
    \  t=myth
    ^  row[sattr]
    =  es  t.tap
    |  > i=nat 0  > out=row[sattr] []
    ^  row[sattr]
    ?  (ge i es.len)  out
    =  e  es.at(i)
       vals  (foundry_corpus/pail_svals e.val)
    ?  (eq 0 vals.len)  (_ i.inc out)
    (_ i.inc out.snoc((sattr (seg_texts e.key) vals)))

  +  packet_roots
    \  records=row[[p=path t=myth]]
    ^  row[myth]
    |  > i=nat 0  > out=row[myth] []
    ^  row[myth]
    ?  (ge i records.len)  out
    =  [at rec]  records.at(i)
    ?  (eq 0 at.len)  (_ i.inc out.snoc(rec))
    (_ i.inc out)

  +  compile_record_packet
    '  Decode the older foundry_doc/records packet.  Its v1 layer metadata did
    '  not carry token values, so an embedded /foundry/source remains the
    '  migration fallback.  Primary Nenex /compile_page never takes this path.
    \  records=row[[p=path t=myth]]
    ^  foundry_doc/compilation
    =  roots  (foundry_corpus/packet_roots records)
    ?  (eq 0 roots.len)
       (foundry_doc/one_failed (foundry_doc/issue ['foundry 'record]
         'record_root_required "normalized packet needs one record at []"))
    ?  (gt roots.len 1)
       (foundry_doc/one_failed (foundry_doc/issue ['foundry 'record]
         'record_root_collision "normalized packet has more than one [] record"))
    =  root  roots.at(0)
       legacy_source  (myth/txt_at ['foundry 'source] root)
    ?  !(eq legacy_source 0)
       (foundry_doc/compile legacy_source)
    (foundry_doc/one_failed (foundry_doc/issue ['foundry 'source]
      'legacy_source_required
      "v1 foundry_doc record packets require their embedded source"))

  +  page_candidate
    \  tree=axal[myth]
    ^  bool
    ?  (foundry_corpus/page_document_record tree)
     > .none  .false
     > (./some raw=myth)
       (foundry_corpus/record_attrs raw).any(foundry_corpus/foundry_attr)

  +  child_document_record
    '  A mounted Semidoc page keeps application state at the page root and
    '  its top-level document below a numeric child.  Only that document
    '  record is semantic corpus input; /src, /sys/kook, and other wrapper
    '  machinery remain authoring-host state.
    \  e=uon/kv[axal[myth]]
    ^  maybe[myth]
    ?  e.key
     > ($u n)
       ?  (node_back e.val)
        > .none  .none
        > (./some nd=snode)
          ?  nd
           > (./doc _ _ _)  e.val.fil
          .none
     > ($ts name)  .none
    .none

  +  page_document_record
    '  Return the exact ordinary record for one top-level Semidoc document.
    '  Deep/direct inputs have the document at the subtree root.  Live Nenex
    '  inputs have a page wrapper at the root and the document at one numeric
    '  child.  More than one document record is ambiguous and refuses.
    \  tree=axal[myth]
    ^  maybe[myth]
    ?  (node_back tree)
     > (./some nd=snode)
       ?  nd
        > (./doc _ _ _)  tree.fil
       .none
     > .none
       =  roots  tree.kid_tap.sift(foundry_corpus/child_document_record)
       ?  (eq 1 roots.len)  (./some roots.at(0))
       .none

  +  compile_page
    '  Compile the inverse image of an expanded Semidoc page.  This is the
    '  primary Nenex cutover seam: no ['src] slot is read.
    \  tree=axal[myth]
    ^  foundry_doc/compilation
    =  ns  (nodes_of tree)
    ?  !(eq 1 ns.len)
       (foundry_doc/one_failed (foundry_doc/issue [] 'document_required
         "normalized page must contain exactly one top-level document"))
    ?  ns.at(0)
     > (./doc _ _ kids)
       ?  (foundry_corpus/page_document_record tree)
        > .none
          (foundry_doc/one_failed (foundry_doc/issue [] 'document_required
            "normalized page document record is missing or ambiguous"))
        > (./some raw=myth)
          (foundry_doc/compile_root raw (foundry_corpus/record_attrs raw) kids)
    (foundry_doc/one_failed (foundry_doc/issue [] 'document_required
      "normalized page root must be a Semidoc document record"))

  +  page_source_at
    \  root=path e=uon/kv[axal[myth]]
    ^  maybe[foundry_corpus/page_source]
    ?  e.key
     > ($ts name)
       (./some (foundry_corpus/page_source
         (foundry_corpus/provenance root.snoc(e.key) .none) e.val))
     > ($u n)  .none
    .none

  +  page_sources
    '  Turn an already-descended /nenex/w axal into inert page inputs.  Text
    '  page keys become provenance; numbered Semidoc children stay content.
    \  root=path pages=axal[myth]
    ^  row[foundry_corpus/page_source]
    pages.kid_tap.sift((foundry_corpus/page_source_at root))

  +  scan_compilation
    \  provenance=foundry_corpus/provenance raw=myth
       c=foundry_doc/compilation scan=foundry_corpus/scan
    ^  foundry_corpus/scan
    ?  c.value
     > .none
       (foundry_corpus/scan scan.definitions scan.references
         scan.diagnostics.weld((foundry_corpus/compiled_issues provenance
           c.diagnostics)))
     > (./some d)
       (foundry_corpus/scan
         scan.definitions.weld((foundry_corpus/document_definitions
           provenance d raw))
         scan.references.weld((foundry_corpus/document_references d))
         scan.diagnostics)

  +  scan_record_source
    \  source=foundry_corpus/record_source scan=foundry_corpus/scan
    ^  foundry_corpus/scan
    =  roots   (foundry_corpus/packet_roots source.records)
       raw=myth
         ?  (eq 1 roots.len)  roots.at(0)
         myth/new
       c  (foundry_corpus/compile_record_packet source.records)
    (foundry_corpus/scan_compilation source.provenance raw c scan)

  +  scan_page_source
    \  source=foundry_corpus/page_source scan=foundry_corpus/scan
    ^  foundry_corpus/scan
    ?  !(foundry_corpus/page_candidate source.tree)  scan
    =  raw=myth
         ?  (foundry_corpus/page_document_record source.tree)
          > (./some t)  t
          > .none  myth/new
       c  (foundry_corpus/compile_page source.tree)
    (foundry_corpus/scan_compilation source.provenance raw c scan)

  +  ref
    \  from=path relation=iota field=path expected=iota target=path
    ^  foundry_corpus/reference
    (foundry_corpus/reference from relation field expected target)

  +  maybe_ref
    \  from=path relation=iota field=path expected=iota target=maybe[path]
    ^  row[foundry_corpus/reference]
    ?  target
     > .none  []
     > (./some p)  [(foundry_corpus/ref from relation field expected p)]

  +  refs
    \  from=path relation=iota field=path expected=iota targets=row[path]
    ^  row[foundry_corpus/reference]
    targets.map((\ p (foundry_corpus/ref from relation field expected p)))

  +  surface_definitions
    \  owner=path provenance=foundry_corpus/provenance
       surface=foundry_doc/surface
    ^  row[foundry_corpus/definition]
    surface.nodes.map((\ n (foundry_corpus/definition n.address 'surface_node
      owner provenance .none (./some (foundry_doc/node_record n)))))

  +  surface_references
    \  owner=path surface=foundry_doc/surface
    ^  row[foundry_corpus/reference]
    =  root
         [(foundry_corpus/ref owner 'surface_root ['surface 'root]
            'surface_node surface.root)]
       edges  surface.edges.map((foundry_corpus/surface_edge_reference))
       templates  surface.nodes.bind((foundry_corpus/surface_template_reference))
       slot_fallbacks
         surface.nodes.bind((foundry_corpus/surface_slot_fallback_reference))
    root.weld(edges).weld(templates).weld(slot_fallbacks)

  +  surface_edge_reference
    \  e=foundry_doc/surface_edge
    ^  foundry_corpus/reference
    (foundry_corpus/ref e.parent 'surface_child ['surface 'child]
      'surface_node e.child)

  +  surface_template_reference
    \  n=foundry_doc/surface_node
    ^  row[foundry_corpus/reference]
    (foundry_corpus/maybe_ref n.address 'surface_template
      ['surface 'template] 'surface n.template)

  +  surface_slot_fallback_reference
    '  A Slot fallback is a recipe dependency in the same authored DAG.
    '  Slots without a contract or explicit fallback add no edge.
    \  n=foundry_doc/surface_node
    ^  row[foundry_corpus/reference]
    ?  n.contract
     > .none  []
     > (./some c=foundry_doc/slot_contract)
       (foundry_corpus/maybe_ref n.address 'slot_fallback
         ['slot 'fallback] 'recipe c.fallback)

  +  document_references
    \  d=foundry_doc/document
    ^  row[foundry_corpus/reference]
    =  name  (foundry_doc/document_name d)
    ?  d
     > x=foundry_doc/document/layer  []
     > x=foundry_doc/document/catalog
       (foundry_corpus/refs name 'catalog_recipe ['catalog 'recipes] 'recipe
         x.value.recipes).weld(
       (foundry_corpus/refs name 'catalog_layer ['catalog 'layers] 'layer
         x.value.layers))
     > x=foundry_doc/document/surface
       (foundry_corpus/surface_references name x.value)
     > x=foundry_doc/document/recipe
       =  r x.value
          direct
            (foundry_corpus/refs name 'recipe_fallback ['recipe 'fallbacks]
              'recipe r.fallbacks).weld(
            (foundry_corpus/maybe_ref name 'recipe_template ['recipe 'template]
              'surface r.template))
       ?  r.inline
        > .none  direct
        > (./some sf)  direct.weld((foundry_corpus/surface_references name sf))

  +  document_definitions
    \  provenance=foundry_corpus/provenance d=foundry_doc/document raw=myth
    ^  row[foundry_corpus/definition]
    =  name  (foundry_doc/document_name d)
       own
         [(foundry_corpus/definition name (foundry_doc/document_kind d) name
            provenance (./some d) (./some raw))]
    ?  (foundry_doc/document_surface d)
     > .none  own
     > (./some sf)  own.weld((foundry_corpus/surface_definitions name provenance sf))

  +  scan_source
    \  source=foundry_corpus/source scan=foundry_corpus/scan
    ^  foundry_corpus/scan
    ?  !(foundry_corpus/source_candidate source.text)
       scan
    =  c  (foundry_doc/compile source.text)
    ?  c.value
     > .none
       (foundry_corpus/scan scan.definitions scan.references
         scan.diagnostics.weld((foundry_corpus/compiled_issues
           source.provenance c.diagnostics)))
     > (./some d)
       =  raw  (foundry_doc/document_record source.text d)
       (foundry_corpus/scan
         scan.definitions.weld((foundry_corpus/document_definitions
           source.provenance d raw))
         scan.references.weld((foundry_corpus/document_references d))
         scan.diagnostics)

  +  definitions_at
    \  name=path definitions=row[foundry_corpus/definition]
    ^  row[foundry_corpus/definition]
    definitions.keep((\ d (eq_pith name d.name)))

  +  definition_exists
    \  name=path definitions=row[foundry_corpus/definition]
    ^  bool
    definitions.any((\ d (eq_pith name d.name)))

  +  definition_kind_exists
    \  name=path kind=iota definitions=row[foundry_corpus/definition]
    ^  bool
    definitions.any((\ d (if (eq_pith name d.name) (eq_iota kind d.kind) 0)))

  +  duplicate_diagnostics
    \  definitions=row[foundry_corpus/definition]
    ^  row[foundry_corpus/diagnostic]
    |  > i=nat 0  > out=row[foundry_corpus/diagnostic] []
    ^  row[foundry_corpus/diagnostic]
    ?  (ge i definitions.len)  out
    =  d definitions.at(i)
       first
         |  > j=nat 0
         ^  bool
         ?  (ge j i)  .true
         ?  (eq_pith definitions.at(j).name d.name)  .false
         (_ j.inc)
    ?  first
       =  hits  (foundry_corpus/definitions_at d.name definitions)
       ?  (gt hits.len 1)
          (_ i.inc out.snoc((foundry_corpus/issue d.provenance d.name
            ['foundry 'name] 'definition_collision
            "semantic definitions must have one owner")))
       (_ i.inc out)
    (_ i.inc out)

  +  reference_diagnostic
    \  definitions=row[foundry_corpus/definition]
       reference=foundry_corpus/reference
    ^  maybe[foundry_corpus/diagnostic]
    =  origins  (foundry_corpus/definitions_at reference.from definitions)
       provenance
         ?  (eq 0 origins.len)
            (foundry_corpus/provenance [] .none)
         origins.at(0).provenance
    ?  !(foundry_corpus/definition_exists reference.target definitions)
       (./some (foundry_corpus/issue provenance reference.from reference.field
         'reference_missing "semantic reference has no definition"))
    ?  !(foundry_corpus/definition_kind_exists reference.target
          reference.expected definitions)
       (./some (foundry_corpus/issue provenance reference.from reference.field
         'reference_ill_typed "semantic reference resolves to the wrong definition kind"))
    .none

  +  reference_diagnostics
    \  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
    ^  row[foundry_corpus/diagnostic]
    references.sift((foundry_corpus/reference_diagnostic definitions))

  +  path_in
    \  p=path ps=row[path]
    ^  bool
    ps.any((\ q (eq_pith p q)))

  +  reaches
    \  target=path current=path references=row[foundry_corpus/reference]
       seen=row[path]
    ^  bool
    ?  (eq_pith target current)  .true
    ?  (foundry_corpus/path_in current seen)  .false
    =  outgoing  references.keep((\ r (eq_pith current r.from)))
    |  > i=nat 0
    ^  bool
    ?  (ge i outgoing.len)  .false
    ?  (foundry_corpus/reaches target outgoing.at(i).target references
          seen.snoc(current))
       .true
    (_ i.inc)

  +  cycle_diagnostics
    \  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
    ^  row[foundry_corpus/diagnostic]
    references.sift((foundry_corpus/cycle_diagnostic definitions references))

  +  cycle_diagnostic
    \  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
       r=foundry_corpus/reference
    ^  maybe[foundry_corpus/diagnostic]
    ?  !(foundry_corpus/definition_kind_exists r.target r.expected definitions)
       .none
    ?  !(foundry_corpus/reaches r.from r.target references [])
       .none
    =  origins  (foundry_corpus/definitions_at r.from definitions)
       provenance
         ?  (eq 0 origins.len)
            (foundry_corpus/provenance [] .none)
         origins.at(0).provenance
    (./some (foundry_corpus/issue provenance r.from r.field
      'reference_cycle "semantic references must form a DAG"))

  +  backlinks
    '  Reverse references over existing definitions only.  This function is
    '  intentionally called after validation and never feeds it.
    \  definitions=row[foundry_corpus/definition]
       references=row[foundry_corpus/reference]
    ^  row[foundry_corpus/backlink]
    definitions.map((foundry_corpus/backlink_for references))

  +  backlink_for
    \  references=row[foundry_corpus/reference]
       d=foundry_corpus/definition
    ^  foundry_corpus/backlink
    =  sources
         (row/uniq[path]
           references.keep((\ r (eq_pith d.name r.target))).map((\ r r.from)))
    (foundry_corpus/backlink d.name sources)

  +  finish_admission
    \  scanned=foundry_corpus/scan
    ^  foundry_corpus/admission
    =  definitions  (foundry_corpus/sort_definitions scanned.definitions)
       references   (foundry_corpus/sort_references scanned.references)
       duplicates   (foundry_corpus/duplicate_diagnostics definitions)
       missing      (foundry_corpus/reference_diagnostics definitions references)
       cycles       (foundry_corpus/cycle_diagnostics definitions references)
       diagnostics
         (foundry_corpus/sort_diagnostics
           scanned.diagnostics.weld(duplicates).weld(missing).weld(cycles))
    (foundry_corpus/admission definitions references
      (foundry_corpus/backlinks definitions references) diagnostics)

  +  admit
    '  Migration source-text admission.  New Nenex consumers should use
    '  /admit_axal or /admit_pages so normalized records stay authoritative.
    \  sources=row[foundry_corpus/source]
    ^  foundry_corpus/admission
    =  sorted  (foundry_corpus/sort_sources sources)
       scanned
         sorted.fold((foundry_corpus/scan [] [] [])
           (\ out source (foundry_corpus/scan_source source out)))
    (foundry_corpus/finish_admission scanned)

  +  admit_records
    '  Compatibility admission for foundry_doc/records packets.
    \  sources=row[foundry_corpus/record_source]
    ^  foundry_corpus/admission
    =  sorted  (foundry_corpus/sort_record_sources sources)
       scanned
         sorted.fold((foundry_corpus/scan [] [] [])
           (\ out source (foundry_corpus/scan_record_source source out)))
    (foundry_corpus/finish_admission scanned)

  +  admit_pages
    '  Primary normalized Nenex admission.  This remains a pure observation
    '  over already-expanded records.
    \  sources=row[foundry_corpus/page_source]
    ^  foundry_corpus/admission
    =  sorted  (foundry_corpus/sort_page_sources sources)
       scanned
         sorted.fold((foundry_corpus/scan [] [] [])
           (\ out source (foundry_corpus/scan_page_source source out)))
    (foundry_corpus/finish_admission scanned)

  +  admit_axal
    '  Convenience boundary for a caller already holding /nenex/w.
    \  root=path pages=axal[myth]
    ^  foundry_corpus/admission
    (foundry_corpus/admit_pages (foundry_corpus/page_sources root pages))

  +  visit_definition
    \  name=path admission=foundry_corpus/admission visit=foundry_corpus/visit
    ^  foundry_corpus/visit
    ?  (foundry_corpus/path_in name visit.seen)  visit
    =  hits  (foundry_corpus/definitions_at name admission.definitions)
    ?  (eq 0 hits.len)  visit
    =  next_seen  visit.seen.snoc(name)
       outgoing
         admission.references.keep((\ r (eq_pith name r.from)))
       after
         (foundry_corpus/visit_references admission outgoing 0
           (foundry_corpus/visit visit.definitions next_seen))
    (foundry_corpus/visit after.definitions.snoc(hits.at(0)) after.seen)

  +  visit_references
    '  Explicit recursion keeps the closure accumulator fully typed; this is
    '  the dependency-order traversal formerly expressed as a polymorphic fold.
    \  admission=foundry_corpus/admission
       references=row[foundry_corpus/reference]
       i=nat
       visit=foundry_corpus/visit
    ^  foundry_corpus/visit
    ?  (ge i references.len)  visit
    =  after
         (foundry_corpus/visit_definition references.at(i).target admission visit)
    (_ admission references i.inc after)

  +  close
    '  Deterministic dependency-first closure rooted at an explicit symbol.
    '  Admission diagnostics ride through unchanged; the closure never repairs
    '  or shortens an invalid corpus.
    \  root=path admission=foundry_corpus/admission
    ^  foundry_corpus/closure
    =  root_issue=row[foundry_corpus/diagnostic]
         ?  (foundry_corpus/definition_exists root admission.definitions)
            []
         [(foundry_corpus/issue (foundry_corpus/provenance [] .none) root []
            'closure_root_missing "closure root has no semantic definition")]
       visit
         (foundry_corpus/visit_definition root admission
           (foundry_corpus/visit [] []))
    (foundry_corpus/closure root visit.definitions
      (foundry_corpus/sort_diagnostics admission.diagnostics.weld(root_issue)))

  +  source_impact
    \  locator=path admission=foundry_corpus/admission
    ^  foundry_corpus/impact
    =  defs
         admission.definitions.keep((\ d (eq_pith locator d.provenance.locator)))
       names  (row/uniq[path] defs.map((\ d d.name)))
       incoming
         (row/uniq[path]
           admission.references.keep((foundry_corpus/targets_any names)).map((\ r r.from)))
       diagnostics
         admission.diagnostics.keep((\ d (eq_pith locator d.provenance.locator)))
    (foundry_corpus/impact names incoming diagnostics)

  +  diagnostics_for_definition
    \  d=foundry_corpus/definition admission=foundry_corpus/admission
    ^  row[foundry_corpus/diagnostic]
    admission.diagnostics.keep((foundry_corpus/diagnostic_for d))

  +  diagnostic_for
    \  d=foundry_corpus/definition issue=foundry_corpus/diagnostic
    ^  bool
    ?  (eq_pith issue.subject d.name)  .true
    (eq_pith issue.provenance.locator d.provenance.locator)

  +  index_for
    \  admission=foundry_corpus/admission d=foundry_corpus/definition
    ^  foundry_corpus/index_entry
    =  forward
         (row/uniq[path]
           admission.references.keep((\ r (eq_pith r.from d.name))).map((\ r r.target)))
       incoming
         (row/uniq[path]
           admission.references.keep((\ r (eq_pith r.target d.name))).map((\ r r.from)))
    (foundry_corpus/index_entry d.name d.kind d.provenance forward incoming
      (foundry_corpus/diagnostics_for_definition d admission))

  +  index
    '  Observation only: no typed document values, recipes, forms, Holes, or
    '  pronunciation operations enter the result type.
    \  admission=foundry_corpus/admission
    ^  row[foundry_corpus/index_entry]
    =  docs  admission.definitions.keep(foundry_corpus/document_definition)
    docs.map((foundry_corpus/index_for admission))

  +  document_definition
    \  d=foundry_corpus/definition
    ^  bool
    !(eq_iota d.kind 'surface_node)

  +  admission_definition
    '  Executable consumers receive nothing from an invalid corpus or an
    '  ambiguous name.  The observational index remains available for repair.
    \  name=path admission=foundry_corpus/admission
    ^  maybe[foundry_corpus/definition]
    ?  (gt admission.diagnostics.len 0)  .none
    =  hits  (foundry_corpus/definitions_at name admission.definitions)
    ?  !(eq 1 hits.len)  .none
    (./some hits.at(0))

  +  admission_document
    \  name=path admission=foundry_corpus/admission
    ^  maybe[foundry_doc/document]
    ?  (foundry_corpus/admission_definition name admission)
     > .none  .none
     > (./some d)  d.document

  +  admission_surface_recipe
    '  Resolve a Recipe definition into an actually materializable Surface.
    '  A bare Recipe is not availability.  Inline authoring is already part
    '  of the admitted Recipe document; an external template must resolve to
    '  one unambiguous admitted Surface definition.
    \  name=path admission=foundry_corpus/admission
    ^  maybe[foundry_doc/surface_recipe]
    ?  (foundry_corpus/admission_document name admission)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  (foundry_doc/document_recipe doc)
        > .none  .none
        > (./some recipe=foundry_doc/recipe)
          ?  recipe.inline
           > (./some surface=foundry_doc/surface)
             (./some (foundry_doc/surface_recipe recipe surface))
           > .none
             ?  recipe.template
              > .none  .none
              > (./some template=path)
                ?  (foundry_corpus/admission_document template admission)
                 > .none  .none
                 > (./some template_doc=foundry_doc/document)
                   ?  (foundry_doc/document_surface template_doc)
                    > .none  .none
                    > (./some surface=foundry_doc/surface)
                      (./some (foundry_doc/surface_recipe recipe surface))

  +  node_fallback_recipe
    \  node=foundry_doc/surface_node
    ^  maybe[path]
    ?  node.contract
     > .none  .none
     > (./some contract=foundry_doc/slot_contract)  contract.fallback

  +  surface_fallback_names
    '  Stable first-occurrence list of the semantic fallback Recipes named by
    '  Slot contracts in one Surface template.
    \  surface=foundry_doc/surface
    ^  row[path]
    =  names  surface.nodes.sift(foundry_corpus/node_fallback_recipe)
    (row/uniq[path] names)

  +  admission_surface_recipes_at
    \  names=row[path] admission=foundry_corpus/admission
       index=nat out=row[foundry_doc/surface_recipe]
    ^  maybe[row[foundry_doc/surface_recipe]]
    ?  (ge index names.len)  (./some out)
    ?  (foundry_corpus/admission_surface_recipe names.at(index) admission)
     > .none  .none
     > (./some materialized=foundry_doc/surface_recipe)
       (_ names admission index.inc out.snoc(materialized))

  +  admission_fallback_recipes
    '  Materialize every distinct Slot fallback required by a template or
    '  refuse the whole set.  This never silently shortens an unavailable
    '  fallback list.
    \  surface=foundry_doc/surface admission=foundry_corpus/admission
    ^  maybe[row[foundry_doc/surface_recipe]]
    (foundry_corpus/admission_surface_recipes_at
      (foundry_corpus/surface_fallback_names surface) admission 0 [])

  +  admission_record
    \  name=path admission=foundry_corpus/admission
    ^  maybe[myth]
    ?  (foundry_corpus/admission_definition name admission)
     > .none  .none
     > (./some d)  d.record

  +  admission_layer
    \  name=path admission=foundry_corpus/admission
    ^  maybe[foundry/layer]
    ?  (foundry_corpus/admission_document name admission)
     > .none  .none
     > (./some d)
       ?  (foundry_doc/document_layer d)
        > .none  .none
        > (./some layer)  (./some (foundry_doc/layer_of layer))

  +  diagnostics_at
    \  name=path admission=foundry_corpus/admission
    ^  row[foundry_corpus/diagnostic]
    admission.diagnostics.keep((\ d (eq_pith d.subject name)))

  +  targets_any
    \  names=row[path] r=foundry_corpus/reference
    ^  bool
    names.any((\ name (eq_pith name r.target)))

  '  Stable public accessors for focused tests and mechanically thin hosts.
  +  admission_definitions
    \  x=foundry_corpus/admission
    ^  row[foundry_corpus/definition]
    x.definitions
  +  admission_references
    \  x=foundry_corpus/admission
    ^  row[foundry_corpus/reference]
    x.references
  +  admission_backlinks
    \  x=foundry_corpus/admission
    ^  row[foundry_corpus/backlink]
    x.backlinks
  +  admission_diagnostics
    \  x=foundry_corpus/admission
    ^  row[foundry_corpus/diagnostic]
    x.diagnostics
  +  definition_name
    \  x=foundry_corpus/definition
    ^  path
    x.name
  +  definition_kind
    \  x=foundry_corpus/definition
    ^  iota
    x.kind
  +  definition_source
    \  x=foundry_corpus/definition
    ^  path
    x.provenance.locator
  +  definition_provenance
    \  x=foundry_corpus/definition
    ^  foundry_corpus/provenance
    x.provenance
  +  definition_document
    \  x=foundry_corpus/definition
    ^  maybe[foundry_doc/document]
    x.document
  +  definition_record
    \  x=foundry_corpus/definition
    ^  maybe[myth]
    x.record
  +  reference_from
    \  x=foundry_corpus/reference
    ^  path
    x.from
  +  reference_target
    \  x=foundry_corpus/reference
    ^  path
    x.target
  +  reference_expected
    \  x=foundry_corpus/reference
    ^  iota
    x.expected
  +  diagnostic_source
    \  x=foundry_corpus/diagnostic
    ^  path
    x.provenance.locator
  +  diagnostic_subject
    \  x=foundry_corpus/diagnostic
    ^  path
    x.subject
  +  diagnostic_code
    \  x=foundry_corpus/diagnostic
    ^  iota
    x.code
  +  diagnostic_field
    \  x=foundry_corpus/diagnostic
    ^  path
    x.field
  +  backlink_target
    \  x=foundry_corpus/backlink
    ^  path
    x.target
  +  backlink_sources
    \  x=foundry_corpus/backlink
    ^  row[path]
    x.sources
  +  closure_definitions
    \  x=foundry_corpus/closure
    ^  row[foundry_corpus/definition]
    x.definitions
  +  closure_diagnostics
    \  x=foundry_corpus/closure
    ^  row[foundry_corpus/diagnostic]
    x.diagnostics
  +  impact_definitions
    \  x=foundry_corpus/impact
    ^  row[path]
    x.definitions
  +  impact_incoming
    \  x=foundry_corpus/impact
    ^  row[path]
    x.incoming
  +  impact_diagnostics
    \  x=foundry_corpus/impact
    ^  row[foundry_corpus/diagnostic]
    x.diagnostics
  +  index_entry_name
    \  x=foundry_corpus/index_entry
    ^  path
    x.name
  +  index_entry_kind
    \  x=foundry_corpus/index_entry
    ^  iota
    x.kind
  +  index_entry_forward
    \  x=foundry_corpus/index_entry
    ^  row[path]
    x.forward
  +  index_entry_incoming
    \  x=foundry_corpus/index_entry
    ^  row[path]
    x.incoming
  +  index_entry_diagnostics
    \  x=foundry_corpus/index_entry
    ^  row[foundry_corpus/diagnostic]
    x.diagnostics
