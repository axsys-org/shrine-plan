-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  web [order=50]
-  chat_foundry_occurrence [order=60]
-  chat_foundry_header [order=70]
-  chat_foundry_web_provider [order=80]
-  chat_foundry_web_policy [order=90]
'  Final Chat Web traversal.  This cone owns only ordered tree assembly and
'  terminal wrapping; occurrence meaning, provider lowering, and role policy
'  remain in their preceding modules.
+  chat_foundry_web_terminal
  +  plan_children
    \  occurrences=row[projection_pronunciation_occurrence]
       parent_depth=nat index=nat out=row[weft/node]
       header_style=chat_foundry_header/header_text_style
    ^  [nodes=row[weft/node] next=nat code=maybe[iota]]
    ?  (ge index occurrences.len)
       [out index .none]
    =  depth  occurrences.at(index).depth
    ?  !(gt depth parent_depth)
       [out index .none]
    ?  !(eq depth parent_depth.inc)
       [[] index (./some 'chat_pronunciation_depth_invalid)]
    =  [nodes next issue]
         (chat_foundry_web_terminal/plan_occurrence
           occurrences index header_style)
    ?  issue
     > (./some code=iota)  [[] next (./some code)]
     > .none
       (_ occurrences parent_depth next out.weld(nodes) header_style)

  +  plan_occurrence
    \  occurrences=row[projection_pronunciation_occurrence] index=nat
       header_style=chat_foundry_header/header_text_style
    ^  [nodes=row[weft/node] next=nat code=maybe[iota]]
    ?  (ge index occurrences.len)
       [[] index (./some 'chat_pronunciation_occurrence_missing)]
    =  occurrence  occurrences.at(index)
       [children next child_issue]
         (chat_foundry_web_terminal/plan_children occurrences occurrence.depth
           index.inc [] header_style)
    ?  child_issue
     > (./some code=iota)  [[] next (./some code)]
     > .none
       =  [nodes policy_issue]
            (chat_foundry_web_policy/plan_policy
              occurrence children header_style)
       [nodes next policy_issue]

  +  pronunciation_terminal
    '  Render one complete late plan.  No semantic structure is rediscovered
    '  here: recursion follows only plan depth/order, and policy follows role.
    \  pronunciation=projection_pronunciation
    ^  [body=maybe[nat] code=maybe[iota]]
    =  occurrences  pronunciation.occurrences
    ?  !(eq pronunciation.roots.len 1)
       [.none (./some 'chat_pronunciation_root_invalid)]
    ?  (eq occurrences.len 0)
       [.none (./some 'chat_pronunciation_empty)]
    ?  !(eq occurrences.at(0).depth 0)
       [.none (./some 'chat_pronunciation_depth_invalid)]
    =  header_style
         (chat_foundry_header/header_text_style_of occurrences.at(0))
       foundation_style
         (chat_foundry_web_provider/foundation_style_of occurrences.at(0))
       [nodes next issue]
         (chat_foundry_web_terminal/plan_occurrence
           occurrences 0 header_style)
    ?  issue
     > (./some code=iota)  [.none (./some code)]
     > .none
       ?  !(eq next occurrences.len)
          [.none (./some 'chat_pronunciation_disconnected)]
       ?  !(eq nodes.len 1)
          [.none (./some 'chat_pronunciation_root_invalid)]
       =  accent
            (chat_foundry_occurrence/occurrence_text
              ['foundry 'resolved 'token 'color 'accent] occurrences.at(0))
          cls
            ?  (if foundation_style.contrast .true
                  (eq accent "contrast"))
               "foundry-surface pronunciation-contrast"
            "foundry-surface pronunciation-default"
          base_attrs=row[weft/att]  [(weft/cls cls)]
          attrs
            base_attrs.weld(
              (chat_foundry_web_provider/foundation_style_attrs
                foundation_style))
          rendered
            (frag/render (frag/html "div" attrs nodes))
       ?  (eq rendered.at(0) 200)
          [(./some rendered.at(1)) .none]
       [.none (./some 'chat_pronunciation_render_failed)]
