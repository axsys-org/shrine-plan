- value_read

' Lossless structural identity for a physical path or opaque record slot.
' Display spellings are optional presentation, never continuation identities.
+ physical_key
  + max_bytes
    ^ nat
    8192
  + fits
    ' Count the encoded budget before formatting any payload. Every segment
    ' costs at least slash + one-byte tag + colon, even with a zero payload.
    \ key=path
    ^ bool
    ? (gt key.len 2730) .false
    % i=nat 0 size=nat 2
    ? (eq i key.len) .true
    = segment key.at(i)
      next (add size (add 2 (add (wid (aura_tag segment))
        (mul 2 (wid (quip_val segment))))))
    ? (gt next physical_key/max_bytes) .false
    | _ i.inc next
  + encode
    \ key=path
    ^ either[iota str]
    ? !(physical_key/fits key) (./err 'key_too_large)
    = parts
        | key.map
        \ segment=iota
        ^ str
        = payload (quip_val segment)
        | str/cat_all ["/" (str/from_atom (aura_tag segment)) ":"
            (value_read/hex_slice payload 0 (wid payload))]
    | ./ok (str/cat (str/cat_all parts) "v1")

  + nibble
    \ byte=nat
    ^ maybe[nat]
    ? !((lt byte 48) || (gt byte 57)) (./some (sub byte 48))
    ? !((lt byte 97) || (gt byte 102)) (./some (add 10 (sub byte 97)))
    .none
  + payload
    ' Empty hex is exactly zero. Nonzero atoms have no high zero byte;
    ' leading zero bytes are meaningful because the byte order is LE.
    \ text=str
    ^ maybe[nat]
    ? (gt text.len physical_key/max_bytes) .none
    ? !(eq (mod text.len 2) 0) .none
    ? (eq text.len 0) (./some 0)
    ? (equal[str] (text.slice((sub text.len 2) 2)) "00") .none
    % i=nat 0 value=nat 0
    ^ maybe[nat]
    ? (eq i text.len) (./some value)
    ?> (./some high) (physical_key/nibble text.at(i)) .none
    ?> (./some low) (physical_key/nibble text.at(i.inc)) .none
    = byte (add (mul high 16) low)
    | _ (add i 2) (add value (lsh byte (mul i 4)))
  + aura
    ' Construct the raw tagged atom without lexical or Unicode conversion.
    \ tag=str value=nat
    ^ maybe[iota]
    ? (equal[str] tag "dm") (maybe/some[iota] ($dm value))
    ? (equal[str] tag "dr") (maybe/some[iota] ($dr value))
    ? (equal[str] tag "ds") (maybe/some[iota] ($ds value))
    ? (equal[str] tag "f") (maybe/some[iota] ($f value))
    ? (equal[str] tag "r") (maybe/some[iota] ($r value))
    ? (equal[str] tag "rd") (maybe/some[iota] ($rd value))
    ? (equal[str] tag "rs") (maybe/some[iota] ($rs value))
    ? (equal[str] tag "s") (maybe/some[iota] ($s value))
    ? (equal[str] tag "ta") (maybe/some[iota] ($ta value))
    ? (equal[str] tag "ts") (maybe/some[iota] ($ts value))
    ? (equal[str] tag "tu") (maybe/some[iota] ($tu value))
    ? (equal[str] tag "u") (maybe/some[iota] ($u value))
    ? (equal[str] tag "w") (maybe/some[iota] ($w value))
    ? (equal[str] tag "x") (maybe/some[iota] ($x value))
    .none
  + segment
    \ text=str
    ^ maybe[iota]
    = parts text.split_byte(58)
    ? !(eq parts.len 2) .none
    ?> (./some bytes) (physical_key/payload parts.at(1)) .none
    | physical_key/aura parts.at(0) bytes
  + decode
    \ text=str
    ^ maybe[path]
    ? (gt text.len physical_key/max_bytes) .none
    ? (equal[str] text "v1") (maybe/some[path] [])
    ? !(equal[str] (text.slice(0 3)) "v1/") .none
    = tail text.slice(3 (sub text.len 3))
      parts tail.split_byte(47)
    % i=nat 0 out=list[iota] .nil
    ^ maybe[path]
    ? (eq i parts.len) (./some out.row.rev)
    ?> (./some segment) (physical_key/segment parts.at(i)) .none
    | _ i.inc (list/cons[iota] segment out)

  + display_fits
    ' Presentation may call the partial lexical codec only on tiny keys.
    ' This limit does not restrict the lossless identity codec.
    \ key=path
    ^ bool
    ? (gt key.len 32) .false
    % i=nat 0 bytes=nat 0
    ? (eq i key.len) .true
    = next (add bytes (wid (quip_val key.at(i))))
    ? (gt next 128) .false
    | _ i.inc next
  + display_checked
    \ key=path
    ^ maybe[str]
    = text (path_show key)
    ? (gt text.len 1024) .none
    ? !(value_read/identifier text) .none
    ?> (./some parsed) (path_parse text) .none
    ? !(eq_pith key parsed) .none
    | ./some text
  + display
    \ key=path
    ^ maybe[str]
    ? !(physical_key/display_fits key) .none
    ? (Try physical_key/display_checked key)
     > (./ok text) text
     > (./err _) .none
