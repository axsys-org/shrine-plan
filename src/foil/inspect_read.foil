- lain_peek
- physical_read
- physical_key

' Namespace inspection is a read, never an HTTP request record in the ledger.
' Physical outlines select index children, not y frontiers or z subtrees.
+ inspect_read
  + request
    : pax=path epoch=maybe[nat] children=maybe[path] slots=maybe[path] tag=iota own_slots=bool versions=bool operations=bool metadata=row[path]
  + page
    : epoch=nat children=maybe[path] next_children=maybe[path] child_count=nat
      slots=maybe[path] next_slots=maybe[path] slot_count=nat
  + result
    : target=path view=axal[myth] versions=axal[myth] operations=row[[p=path o=op]]
      paging=inspect_read/page tag=iota writable=bool
  + metadata
    ' Fixed semantic slots stay available when traversing a slot page. No
    ' unrelated children or application face is evaluated to label a path.
    \ keys=row[path] record=myth
    ^ myth
    = metadata
        | keys.fold (myth/new)
        \ out key
        ? record.get(key)
         > (./some value) out.put(key value)
         > .none out
    ' Only journal events use content as a semantic discriminator. Ordinary
    ' application payloads remain excluded from compact child metadata.
    ?> (./some content) record.get(bond/content) metadata
    ?> event=namespace_event content metadata
    | metadata.put bond/content event
  + own
    \ epoch=nat node=axal[tome]
    ^ maybe[myth]
    ? (ass/res epoch (tome/hist node.fil))
     > (./known record) (./some record)
    .none
  + operations
    ' Only ancestor /op registries; never generic request crew hydration.
    \ target=path state=sov
    ^ row[[p=path o=op]]
    % depth=nat 1 out=row[[p=path o=op]] []
    ? ((gt depth target.len) || (ge out.len 64)) out
    = prefix=path target.take(depth)
      parent=path prefix.snoc('op)
      source state.idx.dip(parent)
      entries source.kid.range_after(.none (sub 64 out.len))
      next
        | entries.fold out
        \ found=row[[p=path o=op]] entry
        ?> (./some record) (inspect_read/own state.top (unpin entry.val.held)) found
        ?> (./some held) record.get(['sys 'op]) found
        ?> operation=op held found
        | found.snoc([parent.snoc(entry.key) operation])
    | _ depth.inc next
  + read
    \ query=inspect_read/request state=sov
    ^ either[iota inspect_read/result]
    | inspect_read/read_with query state
      (\ target=path (axal/snip[myth] (peek target state)))
      (\ target=path (h_ver target state))
  + read_with
    \ query=inspect_read/request state=sov resolve={\ path}axal[myth]
      version_of={\ path}axal[myth]
    ^ either[iota inspect_read/result]
    ? (gt query.metadata.len 32) (./err 'invalid_metadata)
    ? (gt query.pax.len 128) (./err 'invalid_path)
    ? query.children.run((\ key=path !(eq key.len 1))).fall(.false)
      | ./err 'invalid_cursor
    = epoch query.epoch.fall(state.top)
    ? !(eq epoch state.top) (./err 'epoch_conflict)
    = continuation ((maybe/is_some query.children) || (maybe/is_some query.slots))
    ? (? continuation (maybe/is_none query.epoch) .false) (./err 'epoch_required)
    = physical (value_read/physical query.pax)
      tree=axal[myth]
        ? physical
          (axal/new[myth] (inspect_read/own epoch state.idx.dip(query.pax)))
        ' Derived care/case semantics remain the responsibility of the
        ' resolver. Do not silently reinterpret historical z as physical y.
        | resolve query.pax
      child_source=[axal[myth] maybe[path] nat]
        ? physical
          = source state.idx.dip(query.pax)
            bound query.children.run((\ key=path key.at(0)))
            selected source.kid.range_after(bound 41)
            count (? (lt selected.len 40) selected.len 40)
            next=maybe[path]
              ? (gt selected.len count) (./some [selected.at(count.dec).key])
              .none
            view
              % i=nat 0 out=axal[myth] tree
              ? (eq i count) out
              = entry selected.at(i)
                child (axal/new[myth] (inspect_read/own epoch (unpin entry.val.held)).run((inspect_read/metadata query.metadata)))
              | _ i.inc out.set_kid(out.kid_put(entry.key child))
          [view next source.kid.size]
        = selected tree.kid.range_after(query.children.run((\ key=path key.at(0))) 41)
          count (? (lt selected.len 40) selected.len 40)
          next=maybe[path]
            ? (gt selected.len count) (./some [selected.at(count.dec).key])
            .none
          view
            % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
            ? (eq i count) out
            = entry selected.at(i)
              child (axal/new[myth] (unpin entry.val.held).fil.run((inspect_read/metadata query.metadata)))
            | _ i.inc out.set_kid(out.kid_put(entry.key child))
        [view next tree.kid.size]
      [children next_children child_count] child_source
      slots=[maybe[myth] maybe[path] nat]
        ?> (./some card) tree.fil [.none .none 0]
        ? !(query.own_slots) [(./some (inspect_read/metadata query.metadata card)) .none card.size]
        = selected card.range_after(query.slots 41)
          count (? (lt selected.len 40) selected.len 40)
          next=maybe[path]
            ? (gt selected.len count) (./some selected.at(count.dec).key)
            .none
          record
            % i=nat 0 out=myth (inspect_read/metadata query.metadata card)
            ? (eq i count) out
            = entry selected.at(i)
            | _ i.inc out.put(entry.key entry.val)
        [(./some record) next card.size]
      [own next_slots slot_count] slots
      versions
        ? !(query.versions) (axal/new[myth] .none)
        | version_of query.pax
      ops=row[[p=path o=op]]
        ? (!(query.operations) || !physical) []
        | inspect_read/operations query.pax state
    | ./ok (inspect_read/result query.pax children.set_fil(own) versions ops
        (inspect_read/page epoch query.children next_children child_count query.slots next_slots slot_count)
        query.tag .false)
  + safe_read
    \ query=inspect_read/request state=sov
    ^ either[iota inspect_read/result]
    ? (Try inspect_read/force_read [query state])
     > (./ok answer) answer
     > (./err _) (./err 'read_failed)
  + force_read
    ' Finish selecting the finite data before crossing actor mailboxes.
    ' Unevaluated selectors otherwise capture the sovereign in their closure.
    \ input=[inspect_read/request sov]
    ^ either[iota inspect_read/result]
    = [query state] input
      ;answer (inspect_read/read query state)
    ; (DeepSeq[nat] answer 0)
    answer
  + namespace_read
    \ query=inspect_read/request state=namespace
    ^ either[iota inspect_read/result]
    ? (gt query.metadata.len 32) (./err 'invalid_metadata)
    ? (eq query.pax.len 0)
      ' The composed root has no assertion or shared authority epoch. Its
      ' two fixed authority links never hydrate either authority's subtree.
      ? ((maybe/is_some query.children) || (maybe/is_some query.slots))
        | ./err 'invalid_cursor
      ? query.epoch.run((\ epoch=nat !(eq epoch 0))).fall(.false)
        | ./err 'epoch_conflict
      = authorities=row[path] [['sys] [state.self]]
        view
          | authorities.fold (axal/new[myth] .none)
            \ out=axal[myth] target=path
            ?> (./some history) state.history(target) out
            = record (inspect_read/own history.top history.idx.dip(target)).run((inspect_read/metadata query.metadata))
            | out.set_kid(out.kid_put(target.at(0) (axal/new[myth] record)))
      | ./ok (inspect_read/result [] view (axal/new[myth] .none) []
          (inspect_read/page 0 .none .none 2 .none .none 0) query.tag .false)
    ? !(value_read/physical query.pax)
      ' Derived evaluation uses both authorities at this committed namespace.
      ' This cursor is a render revision (local.top), NOT a source epoch.
      ' The selected system publication is immutable for the server lifetime.
      = resolve
          \ target=path
          ^ axal[myth]
          = structural (sovereign_history_prefix target)
          ? structural.wyt structural
          ? (sovereign_view .y 0 target state)
           > (./known view) view
          (axal/new[myth] .none)
        version_of
          \ target=path
          ^ axal[myth]
          ' Source assertion counters are not output history. /h is
          ' constant; /o and /x have their own case algebra. Until the
          ' resolver exposes derived version metadata, leave it unreported
          ' rather than minting case links or provenance for another path.
          | axal/new[myth] .none
      | inspect_read/read_with query state.local resolve version_of
    ?> (./some history) state.history(query.pax)
      | ./err 'unknown_authority
    ? (inspect_read/safe_read query history)
     > (./err reason) (./err reason)
     > (./ok answer) (./ok answer.set_writable(state.permitted(query.pax)))
  + namespace_force_read
    \ input=[inspect_read/request namespace]
    ^ either[iota inspect_read/result]
    = [query state] input
      ;answer (inspect_read/namespace_read query state)
    ; (DeepSeq[nat] answer 0)
    answer
  + namespace_safe_read
    \ query=inspect_read/request state=namespace
    ^ either[iota inspect_read/result]
    ? (Try inspect_read/namespace_force_read [query state])
     > (./ok answer) answer
     > (./err _) (./err 'read_failed)
