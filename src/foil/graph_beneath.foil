- graph_views

' Stored structure is a separate perspective from relationship expansion.
' Limits are visible, and a directly requested child starts at that locality.
+ graph_beneath
  + node
    \ source=safe depth=nat width=nat cr=care select=view_select
    ^ view_plan
    ? ((equal[care] cr .x) || (eq depth 0)) (./graft (view_ops/at source [] .x))
    | graph_views/frontier source
      \ tree=axal[myth]
      ^ view_plan
      = children
          | tree.kid_tap.filter
            \ [key child]
            | !(graph_views/private_part [key])
        record tree.fil.fall(myth/new).put(['at] source)
        record (? (gt children.len width) record.put(['more] (pails/n (sub children.len width))) record)
        root (axal/new[myth] (./some record))
        ' take past the row's end faults; the width is a cap, not a count
        children (? (lt children.len width) children children.take(width))
      % i=nat 0 output=axal[myth] root
      ^ view_plan
      ? (eq i children.len) (./done output)
      = [key child] children.at(i)
        ref (view_ops/at source [key] .x)
        resume (_ i.inc)
      ? ((equal[care] cr .y) || (le depth 1))
        = record child.fil.fall(myth/new).put(['at] ref)
        | resume output.put([key] record)
      | view_walk/bind (graph_beneath/node ref depth.dec width .z select)
        \ child=axal[myth]
        ^ view_plan
        = merged
            | child.tap.fold output
              \ out [suffix record]
              | out.put suffix.cons(key) record
        | resume merged
  + get
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = depth context.nat_at(['depth] 3)
      width context.nat_at(['width] 40)
    ? ((gt depth 8) || ((eq width 0) || (gt width 100))) (./fail "structural view exceeds its limits")
    | graph_beneath/node (view_ops/at source relative .x) depth width cr select
