- pact

' Generated from slots/system.slots.json by x/slot_catalog.py; edit the catalog.
+ slot_documentation
  + entries
    ^ row[[path str str]]
    [['/sys/about "About" "Subject described by this record."]
     ['/sys/author "Author" "Asserted author; unsigned scaffolding, not authentication."]
     ['/sys/called_by "Called by" "Incoming definition references."]
     ['/sys/calls "Calls" "Outgoing definition references."]
     ['/sys/codex/command "Codex command" "Command submitted to the Codex bridge."]
     ['/sys/codex/done "Codex done" "Command completion flag."]
     ['/sys/codex/kind "Codex kind" "Request or response kind."]
     ['/sys/codex/method "Codex method" "Protocol method name."]
     ['/sys/codex/ok "Codex ok" "Request success flag."]
     ['/sys/codex/payload "Codex payload" "Request payload."]
     ['/sys/codex/port "Codex port" "Bridge listening port."]
     ['/sys/codex/reply_error "Codex reply error" "Protocol error reply."]
     ['/sys/codex/reply_result "Codex reply result" "Protocol result reply."]
     ['/sys/codex/request_id "Codex request ID" "Protocol request identifier."]
     ['/sys/codex/resolved "Codex resolved" "Resolved reference results."]
     ['/sys/codex/result "Codex result" "Command result."]
     ['/sys/codex/sequence "Codex sequence" "Command sequence number."]
     ['/sys/codex/token "Codex token" "Bridge authentication token."]
     ['/sys/codex/ui_error "Codex UI error" "UI error text."]
     ['/sys/codex/ui_notice "Codex UI notice" "UI notice text."]
     ['/sys/codex/ui_serial "Codex UI serial" "UI update serial."]
     ['/sys/codex/unresolved "Codex unresolved" "References that could not be resolved."]
     ['/sys/content "Content" "Primary value at a name."]
     ['/sys/crew "Dependencies" "Committed local dependency bindings to cared paths."]
     ['/sys/dt "Doctest results" "Doctest case, execution time and results."]
     ['/sys/entries "Definitions" "Definitions exposed by a compiler module mirror."]
     ['/sys/epoch "Epoch" "Counter triggering actions or synchronization."]
     ['/sys/face "Presentation binding" "Component constructor and cared scope used to present a datum."]
     ['/sys/form "Behavior" "Behavior implementation called through the limb chain."]
     ['/sys/from "Source" "Source from which this record is derived."]
     ['/sys/fs/extensions "File extensions" "File extension to behavior references for scanned files."]
     ['/sys/fs/source/assets "Source assets" "Captured asset bytes for a source mount."]
     ['/sys/fs/source/diagnostic "Source diagnostic" "Typed publication failure, cleared with empty text on success."]
     ['/sys/fs/source/diagnostic_text "Source diagnostic text" "Display text for a source publication failure."]
     ['/sys/fs/source/epoch "Scan epoch" "Most recently processed scan epoch."]
     ['/sys/fs/source/image "Module images" "Compiled module images retained for imports."]
     ['/sys/fs/source/manifest "Mount manifest" "JSON mount descriptor."]
     ['/sys/fs/source/message "Publication message" "Current source publication status message."]
     ['/sys/fs/source/publication "Publication epoch" "Namespace epoch of the last successful publication."]
     ['/sys/fs/source/ready "Publication readiness" "Whether the last source publication succeeded."]
     ['/sys/fs/source/snapshot "Source snapshot" "Pinned file snapshot and fingerprint used as compiler input."]
     ['/sys/fs/source/spec "Source mount specification" "Source mount name and manifest."]
     ['/sys/fs/source/status "Source status" "Typed scan epoch, readiness, message and publication epoch."]
     ['/sys/fs/target "Scan destination" "Nested crew key binding the scan destination."]
     ['/sys/goo/catalog "Goo catalog" "Available renderer and view catalog."]
     ['/sys/goo/constants "View constants" "Constants captured while lowering a Grove view."]
     ['/sys/goo/documentation_origin "Source inspection provenance" "Provenance notice for artifact-derived source inspection."]
     ['/sys/goo/inspection/capture "Observed capture" "Capture identity, parent and provenance notice. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/encounter "Observed encounter" "Observed browser session, revisions, selection and editing state. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/preparation "Observed preparation" "Observed layout, dimensions, scale, direction and profile. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/recipe "Observed recipe" "Observed view, role, slot, publication and source location. Browser observation, not authoritative live state."]
     ['/sys/goo/inspection/subject "Observed subject" "Observed subject, receiver and displayed/expected versions. Browser observation, not authoritative live state."]
     ['/sys/goo/normalized_source "Normalized source" "Normalized source read from a pinned compiler artifact."]
     ['/sys/goo/receipts "Action receipts" "Receipts retained by the Goo action runtime."]
     ['/sys/grove/action "Action schema" "Receiver and argument schema for a declared action."]
     ['/sys/grove/action_handler "Action handler" "Compiled action implementation."]
     ['/sys/grove/draft "Draft registration" "Draft, job slot, preview/public source and target, and prelude registration."]
     ['/sys/grove/like "Source norm" "Source norm from which a declaration derives."]
     ['/sys/grove/module "Module bundle" "Version, identity, prefix, exports and artifact of a compiled module."]
     ['/sys/grove/norm "Tree norm" "Path segment patterns and item role for a tree."]
     ['/sys/grove/role "Record role" "Declared fields and presence groups for a record."]
     ['/sys/grove/role_contract "Role constraints" "Compiled constraints for a role."]
     ['/sys/grove/seed "Tree seed" "Seed path and optional rule."]
     ['/sys/grove/sewn "Sewn contract" "Source and target norms with pinned schemas."]
     ['/sys/grove/source "Template source" "Template source version pinned on an installed instance."]
     ['/sys/grove/template "Template" "Version and relative seed records of a reusable template."]
     ['/sys/grove/view "Published view" "Published view, fields, contract and lowering result."]
     ['/sys/help "Help" "Extended documentation as plain text or structured lore, including examples and doctests."]
     ['/sys/lash "Record constraints" "Read, write and presence constraints for a record."]
     ['/sys/lede "Title" "Short title or description."]
     ['/sys/limb "Behavior references" "Behavior implementation references governing a record."]
     ['/sys/mold "Type" "Canonical type description of a published definition."]
     ['/sys/now "Current time" "Current time supplied by the runtime."]
     ['/sys/op "Operation" "An operation interface."]
     ['/sys/pending "Pending work" "Application-specific marker for waiting work."]
     ['/sys/req "Request" "Request on a driver-minted node."]
     ['/sys/res "Response" "Response from the serving behavior; presence signals completion."]
     ['/sys/spec "Subtree contract" "Subtree contract used by a warden to constrain children."]
     ['/sys/src "Source text" "Textual source."]
     ['/sys/tack "Component dependency" "Pinned cared data dependency of a component attachment."]
     ['/sys/unreads "Unread indicator" "Reserved unread indicator; no current executable reader or writer."]
     ['/sys/version/block "Assertion block" "Block height of the latest assertion."]
     ['/sys/version/first "First record epoch" "Epoch of the first x version."]
     ['/sys/version/now "Assertion time" "Time of the latest assertion."]
     ['/sys/version/state "Record state" "Live or tombstone state of the queried node."]
     ['/sys/version/top "Sovereign epoch" "Current sovereign epoch."]
     ['/sys/version/x_data "Record data revision" "Node data revision counter."]
     ['/sys/version/x_shape "Record shape revision" "Node live-domain shape revision counter."]
     ['/sys/version/y_data "Frontier data revision" "Nearest record-bearing frontier data revision counter."]
     ['/sys/version/y_shape "Frontier shape revision" "Nearest record-bearing frontier live-domain shape revision counter."]
     ['/sys/version/z_data "Subtree data revision" "Whole subtree data revision counter."]
     ['/sys/version/z_shape "Subtree shape revision" "Whole subtree live-domain shape revision counter."]
     ['/sys/weft "Component constructor" "Component constructor used to render a record."]]
  + cards
    ^ axal[myth]
    = entries slot_documentation/entries
    | entries.fold (axal/new[myth] .none)
      \ out [name title summary]
      | out.put name ((myth/sing bond/lede (pails/t title)).put(bond/help (lore "" [summary] [])))
