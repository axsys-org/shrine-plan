-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=60]
'  Descriptions exported by the host compiler. Values and cache images
'  stay opaque. Foil owns namespace paths and installation policy.
+  compiler_lore
  : present=bool head=text body=row[text]
    tests=row[[src=text want=text]]
+  compiler_entry
  : name=path value=any kind=text source=text lowered=bool
    doc=compiler_lore signature=maybe[type] law=text line=nat
    calls=row[path] callers=row[path]
+  compiler_module
  : name=path source=text doc=compiler_lore
    entries=row[compiler_entry] visible=row[path] image=any
+  compiler_seed
  & compiler_seed/ready compiler_seed/failed
  +  ready
    : state=sov
  +  failed
    : command=task reason=iota
