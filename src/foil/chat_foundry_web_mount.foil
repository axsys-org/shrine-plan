-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
-  weft [order=40]
-  foundry [order=50]
-  foundry_pronounce [order=60]
-  web [order=70]
'  Mechanical Web mounting for admitted pronunciation Holes.  Observation
'  source and semantic fallback are copied exactly from occurrence evidence.
+  chat_foundry_web_mount
  +  plan_mount
    \  id=nat report=path c=care fallback=path
    ^  weft/node
    =  ct  (frag/care_text c)
    (weft/el "div"
      [(weft/att "id" id)
       (weft/att "w-get" (frag/report_url report))
       (weft/att "w-watch" ct)
       (weft/att "w-observe" (frag/report_watch_template report c))
       (weft/att "data-semantic-fallback" (show/path fallback))]
      [])

  +  plan_hole_mount
    \  occurrence=projection_pronunciation_occurrence id=nat c=care
       ops=row[path]
    ^  [nodes=row[weft/node] code=maybe[iota]]
    ?  occurrence.hole
     > .none  [[] (./some 'chat_pronunciation_hole_missing)]
     > (./some hole=projection_pronunciation_hole)
       ?  hole.source
        > .none  [[] (./some 'chat_pronunciation_hole_source_missing)]
        > (./some source=path)
          ?  hole.semantic_fallback
           > .none  [[] (./some 'chat_pronunciation_fallback_missing)]
           > (./some fallback=path)
             =  report  (foundry/chain ops source)
             [[(chat_foundry_web_mount/plan_mount id report c fallback)] .none]
