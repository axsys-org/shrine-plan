-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_header [order=50]
-  chat_foundry_web_policy_result [order=60]
-  chat_foundry_web_policy_scene [order=70]
-  chat_foundry_web_policy_after_scene [order=80]
'  Ordered top-level continuation after the outer policy.
+  chat_foundry_web_policy_after_outer
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence
       children=row[weft/node] header_style=chat_foundry_header/header_text_style
    ^  [nodes=row[weft/node] code=maybe[iota]]
    =  scene
         (chat_foundry_web_policy_scene/plan_policy occurrence children)
    ?  scene.matched  [scene.nodes scene.code]
    (chat_foundry_web_policy_after_scene/plan_policy
      occurrence children header_style)
