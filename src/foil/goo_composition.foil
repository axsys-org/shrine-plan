- grove_view_publication

' Data-only composition. Expansion is shared by painting and action admission.
' Repeated controls still act on the enclosing receiver; rows own no editors.
+ goo_composition
  + items
    : rows=row[myth]
  + named
    \ name=str arguments=list[rex]
    ^ maybe[rex]
    % rest=list[rex] arguments
    ^ maybe[rex]
    ? rest.is_nil .none
    ?> (./nest _ _ rune kids) rest.head (_ rest.tail)
    ? !(and (eq rune "=") (eq kids.len 2)) (_ rest.tail)
    ? !(eq kids.at(0).print name) (_ rest.tail)
    | ./some kids.at(1)
  + value
    \ published=goo/published current=myth expression=rex
    ^ either[str pail]
    ? (equal expression.leaf_kind (maybe/some[str] "cord"))
      ?> (./leaf _ _ text) expression (./err "Invalid text literal")
      | ./ok (pails/t text)
    ?> (./nest _ _ rune kids) expression (./err "Composition requires a receiver field or text literal")
    ? !(and (eq rune ".") (eq kids.len 2)) (./err "Composition requires a receiver field")
    ? !(eq kids.at(0).print published.view.binding) (./err "Unbound composition receiver")
    = fields (published.fields.keep((\ field (eq field.name kids.at(1).print))))
    ? !(eq fields.len 1) (./err "Unknown composition field")
    ?> (./some value) current.get(fields.head.slot) (./err "Composition field is absent")
    | ./ok value
  + replace
    \ binding=str item=myth tree=rex
    ^ either[str rex]
    ? tree
     > (./nest _ _ rune kids)
      ? (and (eq rune ".") (and (eq kids.len 2) (eq kids.at(0).print binding)))
        ?> (./some value) item.get([($ts (str/to_atom kids.at(1).print))]) (./err "Missing repeated field")
        ?> value=pails/t value (./err "Repeated fields must be text literals")
        | ./ok (rex/cord value.t)
      | goo_composition/replace_children binding item tree
    | goo_composition/replace_children binding item tree
  + replace_children
    \ binding=str item=myth tree=rex
    ^ either[str rex]
    = replaced
        % rest=row[rex] tree.children out=row[rex] []
        ^ either[str row[rex]]
        ? !(rest.len) (./ok out)
        < child (goo_composition/replace binding item rest.at(0))
        | _ rest.drop(1) out.snoc(child)
    < kids replaced
    ? tree
     > (./leaf _ _ _) (./ok tree)
     > (./nest span color rune _) (./ok (rex/nest span color rune kids))
     > (./expr span color _) (./ok (rex/expr span color kids))
     > (./pref span rune _) (./ok (rex/pref span rune kids.at(0)))
     > (./tyte span rune _) (./ok (rex/tyte span rune kids))
     > (./bloc span color rune _ _) (./ok (rex/bloc span color rune kids.at(0) kids.drop(1)))
     > (./open span rune _) (./ok (rex/open span rune kids))
     > (./juxt span _) (./ok (rex/juxt span kids))
     > (./heir span _) (./ok (rex/heir span kids))
  + bind
    \ binding=str item=myth node=goo/node
    ^ either[str goo/node]
    = args
        % rest=list[rex] node.arguments out=list[rex] .nil
        ^ either[str list[rex]]
        ? rest.is_nil (./ok out)
        < arg (goo_composition/replace binding item rest.head)
        | _ rest.tail out.snoc(arg)
      children
        % rest=list[goo/node] node.children out=list[goo/node] .nil
        ^ either[str list[goo/node]]
        ? rest.is_nil (./ok out)
        < child (goo_composition/bind binding item rest.head)
        | _ rest.tail out.snoc(child)
    < args args
    < children children
    | ./ok node.set_arguments(args).set_children(children)
  + nodes
    \ published=goo/published current=myth nodes=list[goo/node] depth=nat
    ^ either[str list[goo/node]]
    ? !(goo_composition/dynamic nodes) (./ok nodes)
    ? (gt depth 24) (./err "Composition exceeds 24 levels")
    % rest=list[goo/node] nodes out=list[goo/node] .nil
    ^ either[str list[goo/node]]
    ? rest.is_nil (./ok out)
    < node (goo_composition/node published current rest.head depth)
    | _ rest.tail out.snoc(node)
  + dynamic
    \ nodes=list[goo/node]
    ^ bool
    | nodes.any
      \ node=goo/node
      | ((goo_composition/named "when" node.arguments).is_some || ((goo_composition/named "each" node.arguments).is_some || (goo_composition/dynamic node.children)))
  + node
    \ published=goo/published current=myth node=goo/node depth=nat
    ^ either[str goo/node]
    = when (goo_composition/named "when" node.arguments)
      each (goo_composition/named "each" node.arguments)
    ? (and (when.is_some || each.is_some) !(eq node.constructor "group")) (./err "when/each require a group")
    = visible=either[str bool]
        ?> (./some expression) when (./ok .true)
        < value (goo_composition/value published current expression)
        ?> value=pails/t value (./err "when requires text")
        ?> (./some expected) (goo_composition/named "is" node.arguments) (./err "when requires is")
        < expected (goo_composition/value published current expected)
        ?> expected=pails/t expected (./err "is requires text")
        | ./ok (eq value.t expected.t)
    < visible visible
    ? !visible (./ok node.set_children(.nil))
    = children=either[str list[goo/node]]
        ?> (./some expression) each (./ok node.children)
        < value (goo_composition/value published current expression)
        ?> value=goo_composition/items value (./err "each requires composition items")
        ? (gt value.rows.len 128) (./err "Composition exceeds 128 rows")
        ?> (./some binding) (goo_composition/named "as" node.arguments) (./err "each requires as")
        ?> (./leaf _ _ name) binding (./err "as requires a binding name")
        ? (eq name published.view.binding) (./err "Repeated binding shadows receiver")
        % rest=row[myth] value.rows out=list[goo/node] .nil
        ^ either[str list[goo/node]]
        ? !(rest.len) (./ok out)
        < group (goo_composition/bind name rest.at(0) (goo/node node.span "group" .nil node.children))
        | _ rest.drop(1) out.snoc(group)
    < children children
    < expanded (goo_composition/nodes published current children depth.inc)
    | ./ok node.set_children(expanded)
