- helm
- http
- fs_sync

' Persistence uses the runtime's native pinned continuation. The supervisor
' commits before publishing bindings or acknowledging a write.
+ eden_store
  + http_request_name
    \ name=iota
    ^ bool
    ?> ($ts raw=nat) name .false
    = text (str/from_atom raw)
    ? (lt text.len 2) .false
    | and (eq text.at(0) 114) (maybe/is_some (nat/parse text.slice(1 text.len)))
  + handle
    (@ s)
    \ access=helm/supervisor/access[s] commit={\ s}nat
      card=helm/card state=s index=hive
    ^ [s hive feet/task[unit]]
    = handle access.handle
      version access.version
      ;result (handle card state index)
      [next next_index answer] result
    ? (eq (version next) (version state)) result
    ; (commit next)
    result
  + access
    (@ s)
    \ base=helm/supervisor/access[s] commit={\ s}nat
    ^ helm/supervisor/access[s]
    | base.set_handle((eden_store/handle[s] base commit))
  + namespace_access
    \ base=helm/supervisor/access[namespace] commit={\ namespace}nat
    ^ helm/supervisor/access[namespace]
    | eden_store/access[namespace] base commit
  + reconnect
    ' File descriptors, actor handles and bridge credentials are process state.
    ' Watched data sources rescan for changes made while offline. Published
    ' program mounts retain their exact captured laws until an explicit rescan.
    \ port=nat state=namespace
    ^ namespace
    = root=path [state.self 'io 'fs]
      folders (sovereign_care .y root state).kid_tap
      http_root=path [state.self 'io 'http]
      configured=myth (sovereign_care .x http_root state).fil.fall(myth/new)
      responder=path configured.path_at(['serve]).fall([state.self 'kook 'hserve])
      listener (http/cfg_port [state.self 'kook 'hserve] responder port)
      abandoned (sovereign_care .y http_root state).kid_tap.keep((\ [name tree] (eden_store/http_request_name name)))
      cleanup=row[[p=path q=writ]] abandoned.map((\ [name tree] [http_root.snoc(name) .cull]))
    ' Pending connections belong to the old process. Retire only the driver's
    ' reserved request names; their historical cases remain in the namespace.
    % idx=nat 0 writes=row[[p=path q=writ]] cleanup.snoc([http_root (writ/poke listener)])
    ^ namespace
    ? (eq idx folders.len)
      ? (grove_install/changes writes state)
       > (./ok next) next
       > (./err why)
         ; (error (pails/q why))
         state
    = [name tree] folders.at(idx)
      record=myth tree.fil.fall(myth/new)
    ?> (./some destination) (fs/destination record) (_ idx.inc writes)
    = epoch=nat record.nat_at(bond/epoch 0)
      seconds=nat record.nat_at(['fs 'watch_seconds] 0)
      updated=myth (myth/sing bond/pending (pails/b .true)).put(bond/epoch (pails/n epoch.inc))
      target=path root.snoc(name)
    ? ((lt seconds 5) || (gt seconds 3600)) (_ idx.inc writes)
    | _ idx.inc writes.snoc([target (writ/poke updated)])
