- helm
- http
- fs_sync

' This module keeps a world between two runs of its process. Persistence
' uses the runtime's native pinned continuation. The module has two parts:
' - handle and access put a commit step into the supervisor. When an event
'   changes the version of the world, the supervisor saves the world before
'   it publishes bindings or acknowledges the write. Thus a process that
'   stops keeps each write that it acknowledged.
' - reconnect runs when a saved world starts again. Some records refer to
'   the process that stopped: the port of the HTTP listener, the names of
'   the HTTP requests that were pending, and the folders that the world
'   watches. reconnect writes these records again for the new process.
'
' The networking uses this module because a world that starts again must
' keep its mounts, its cards and its identity log. Without it, a restart
' gives a new world, and each peer must send all of its records again.
+ eden_store
  + http_request_name
    \ name=iota
    ^ bool
    ?> ($ts raw=nat) name .false
    = text (str/from_atom raw)
    ? (lt text.len 2) .false
    | and (eq text.at(0) 114) (maybe/is_some (nat/parse text.slice(1 text.len)))
  + handle
    (@ s)
    \ access=helm/supervisor/access[s] commit={\ s}s
      card=helm/card state=s index=hive
    ^ [s hive feet/task[unit]]
    = handle access.handle
      version access.version
      ;result (handle card state index)
      [next next_index answer] result
    ? (eq (version next) (version state)) result
    = stored (commit next)
    [stored next_index answer]
  + access
    (@ s)
    \ base=helm/supervisor/access[s] commit={\ s}s
    ^ helm/supervisor/access[s]
    | base.set_handle((eden_store/handle[s] base commit))
  + namespace_access
    \ base=helm/supervisor/access[namespace] commit={\ namespace}namespace
    ^ helm/supervisor/access[namespace]
    | eden_store/access[namespace] base commit
  + changes
    ' This function admits a batch of writes as one event, as the supervisor
    ' admits a batch from a foot (helm/supervisor/steps). It gives the world
    ' after the event, or the reason that the world did not accept it.
    \ writes=row[[p=path q=writ]] state=namespace
    ^ either[iota namespace]
    = [next index reply] (helm/supervisor/steps writes 0 0 state (sovereign_hive state))
      unknown=iota 'refused
    ? reply
     > (./ack err)
      ?> (./some why) err (./ok next)
      ?> (./some said) (pail/as[helm/supervisor/rejection] why) (./err unknown)
      | ./err said.reason
    | ./ok next
  + reconnect
    ' File descriptors, actor handles and bridge credentials are process
    ' state. Watched data sources rescan for changes made while the process
    ' was offline. Published program mounts keep their exact captured laws
    ' until an explicit rescan.
    \ port=nat state=namespace
    ^ namespace
    = root=path [state.self 'io 'fs]
      folders (sovereign_care .y root state).kid_tap
      http_root=path [state.self 'io 'http]
      configured=myth (sovereign_care .x http_root state).fil.fall(myth/new)
      responder=path configured.path_at(['serve]).fall([state.self 'kook 'hserve])
      listener (http/cfg_port [state.self 'kook 'hserve] responder port)
      abandoned (sovereign_care .y http_root state).kid_tap.keep((\ [name tree] (eden_store/http_request_name name)))
      cleanup=row[[p=path q=writ]] abandoned.map((\ [name tree] [http_root.snoc(name) .cull]))
    ' Pending connections belong to the old process. Remove only the reserved
    ' request names of the driver. Their historical cases stay in the
    ' namespace.
    % idx=nat 0 writes=row[[p=path q=writ]] cleanup.snoc([http_root (writ/poke listener)])
    ^ namespace
    ? (eq idx folders.len)
      ? (eden_store/changes writes state)
       > (./ok next) next
       > (./err why)
         ; (error (pails/q why))
         state
    = [name tree] folders.at(idx)
      record=myth tree.fil.fall(myth/new)
    ?> (./some destination) (fs/destination record) (_ idx.inc writes)
    = epoch=nat record.nat_at(bond/epoch 0)
      updated=myth (myth/sing bond/pending (pails/b .true)).put(bond/epoch (pails/n epoch.inc))
      target=path root.snoc(name)
    | _ idx.inc writes.snoc([target (writ/poke updated)])
