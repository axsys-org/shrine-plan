- grove_views
- grove_bundle
- grove_role_runtime

+ goo
  + published
    : view=goo/view fields=list[goo/field] contract=lash
      result=either[grove/error goo/view]

+ grove_view_publication
  + constants_slot
    ^ path
    ['sys 'goo 'constants]
  + constant_value
    ' A case reference names a type in Foil. Construct through the owner's
    ' codec, where the relative case has its actual nominal expected type.
    \ expression=rex
    ^ rex
    ?> (./ok parts) (grove_roles/parts expression) expression
    ? (lt parts.len 2) expression
    = names (parts.map((\ part (str/from_atom (quip_val part)))))
      owner (rex/rune (? (grove_roles/local_slot expression) "%/" "/") names.take(names.len.dec).map(rex/word))
      codec (grove_roles/member ["write"] owner)
      variant (rex/rune "." [(rex/word names.at(names.len.dec))])
    | rex/rune "|" [codec variant]
  + constants
    ' Compile nominal button arguments in their original Foil scope. The
    ' browser never reconstructs branded values or supplies executable code.
    \ root=path doc=grove/document lookup={\ path}maybe[myth] nodes=list[goo/node]
    ^ list[[path rex]]
    | nodes.bind
      \ node
      = own=list[[path rex]]
          ? !(eq node.constructor "action") .nil
          | node.arguments.bind
            \ argument
            ^ list[[path rex]]
            ?> (./nest _ _ rune kids) argument .nil
            ? !(and (eq rune "=") (eq kids.len 2)) .nil
            ? (eq kids.at(0).print "become") .nil
            = value kids.at(1)
            ?> (./nest _ _ rune _) value .nil
            ? !((eq rune "%/") || (eq rune "/")) .nil
            ?> (./ok path) (grove_views/reference root doc lookup value) .nil
            (list/one [path value])
      | own.weld((grove_view_publication/constants root doc lookup node.children))
  + stubs
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < views (grove_views/index root doc lookup)
    = constants (grove_view_publication/constants root doc lookup (views.bind((\ view view.children))))
      value
        | constants.fold (rex/path ["myth" "new"])
          \ out [path value]
          | rex/rune "|" [(rex/path ["myth" "meld"])
            (rex/rune "|" [(rex/path ["myth" "sing"])
              (grove_roles/path_value path) (grove_view_publication/constant_value value)]) out]
    = rewrite
        \ item=grove/item
        ^ grove/item
        ?> (grove/declaration span name body) item item
        ? !(grove_views/is_view body) item
        = prop (grove/property span (rex/cord "/sys/goo/constants")
            (rex/rune "|" [(rex/word "grove_view_constants") value]))
        | grove/declaration span name
          ((list/one[grove/statement] (grove/implementation span [(rex/word "0")])).cons((grove/block span (grove/block_kind/meta) (list/one prop))))
    | ./ok doc.set_items(doc.items.map(rewrite))
  + ordinary
    \ item=grove/item
    ^ bool
    ? item
     > (grove/declaration span name body) !(grove_views/is_view body)
    .true
  + renderers
    \ lookup={\ path}maybe[myth]
    ^ list[goo/renderer]
    | (goo/html_types ['lib 'grove 'types]).map
      \ renderer
      | renderer.set_type (grove_roles/import_location renderer.type lookup)
  + records
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error row[[path myth]]]
    < views (grove_views/index root doc lookup)
    = context (grove_views/context root doc lookup .nil
        (grove_view_publication/renderers lookup) views)
    % rest=list[goo/view] views out=row[[path myth]] []
    ^ either[grove/error row[[path myth]]]
    ? (eq rest.len 0) (./ok out)
    = view rest.at(0)
    < fields (grove_views/role_fields context .nil view.role view.span)
    > (./some role) (lookup view.role)
      | goo/fail[row[[path myth]]] view.span "View role is not published."
    > (./some held) role.get(publisher_vocabulary/grove/role_contract)
      | goo/fail[row[[path myth]]] view.span "View role has no contract."
    > contract=lash held
      | goo/fail[row[[path myth]]] view.span "Invalid role contract."
    = result=either[grove/error goo/view]
        < children (grove_views/lower_nodes context (list/one view.name) view view.children)
        | ./ok view.set_children(children)
      record (myth/sing publisher_vocabulary/grove/view
        (goo/published view fields contract result))
    | _ rest.drop(1) out.snoc([view.name record])
