'  perfbench: microbenchmark fixtures for call-path cost attribution.
'  Monomorphic chains vs const-generic instance chains — scratch
'  module for runtime profiling, no production consumers.
+  mono1
  \  x=nat
  ^  nat
  (add x 1)
+  mono2
  \  x=nat
  ^  nat
  (mono1 x)
+  mono3
  \  x=nat
  ^  nat
  (mono2 x)
+  subber
  \  x=nat
  ^  nat
  (sub x 1)
+  incer
  \  x=nat
  ^  nat
  x.inc
+  madder
  \  x=nat
  ^  nat
  x.add(1)
+  pairbox
  :  a=nat b=nat
+  mkpair
  \  x=nat
  ^  pairbox
  (pairbox x x)
+  box
  (@@ t)
  :  v=t
+  wrap
  (@@ t)
  \  x=t
  ^  box[t]
  (box[t] x)
+  wrap2
  (@@ t)
  \  x=t
  ^  box[t]
  (wrap[t] x)
+  usew
  \  x=nat
  ^  box[nat]
  (wrap2[nat] x)
