-  sept
'  perfbench: microbenchmark fixtures for call-path cost attribution
'  and foil-vs-reaver parity checks.  Scratch module for runtime
'  profiling, no production consumers.
+  mono1
  \  x=nat
  ^  nat
  (add x 1)
+  mono2
  \  x=nat
  ^  nat
  (mono1 x)
+  mono3
  \  x=nat
  ^  nat
  (mono2 x)
+  subber
  \  x=nat
  ^  nat
  (sub x 1)
+  incer
  \  x=nat
  ^  nat
  x.inc
+  madder
  \  x=nat
  ^  nat
  x.add(1)
+  pairbox
  :  a=nat b=nat
+  mkpair
  \  x=nat
  ^  pairbox
  (pairbox x x)
+  box
  (@@ t)
  :  v=t
+  wrap
  (@@ t)
  \  x=t
  ^  box[t]
  (box[t] x)
+  wrap2
  (@@ t)
  \  x=t
  ^  box[t]
  (wrap[t] x)
+  usew
  \  x=nat
  ^  box[nat]
  (wrap2[nat] x)
+  triangle
  '  Self-recursion: n adds + n calls per invocation.
  \  x=nat
  ^  nat
  ?  x
     (add x (_ (dec x)))
  0
+  pintrip
  '  One pin + one unpin.
  \  x=nat
  ^  nat
  (unpin (pin x))
+  sum_row
  '  Fold over a caller-supplied row.
  \  xs=row[nat]
  ^  nat
  xs.fold(0 (\ acc x (add acc x)))
+  map_row
  \  xs=row[nat]
  ^  row[nat]
  xs.map((\ x x.inc))
+  build_uon
  '  n ordered-map inserts (size-balanced BST, iota keys).
  \  n=nat
  ^  uon[nat]
  |  > i=nat 0  > acc=uon[nat] (uon/empty)
  ?  (eq i n)
     acc
  (_ i.inc acc.put(($u i) i))
+  quip_mk
  \  x=nat
  ^  iota
  ($u x)
+  qcmp
  '  One comparator call on adjacent numeric iotas.
  \  x=nat
  ^  nat
  (lte_iota ($u x) ($u x.inc))
+  uput1
  '  One insert into the empty map.
  \  x=nat
  ^  uon[nat]
  (uon/put[nat] ($u x) x (uon/empty))
