- grove_install
- json

' Slot edits use exact physical record versions and ordinary namespace writes.
+ goo_value
  + compiler
    : evaluate={\ path str namespace}either[str pail]
  + compiler_path
    \ self=iota
    ^ path
    [self 'weft 'goo_value_compiler]
  + artifact
    \ target=path state=namespace
    ^ maybe[any]
    ?> (./some card) (sovereign_peek target state).fil .none
    ?> (./some held) card.get([state.self 'compiler 'artifact]) .none
    ?> code=pails/code held .none
    ? (rep_pin code.v) (./some code.v) .none
  + install
    \ evaluate={\ path str namespace}either[str pail] state=namespace
    ^ either[iota namespace]
    | grove_install/change (goo_value/compiler_path state.self)
        (writ/make (myth/sing system_vocabulary/content (goo_value/compiler evaluate))) state
  + mode
    \ value=pail
    ^ str
    ? value
     > x=pails/t "text"
     > x=pails/n "number"
     > x=pails/b "boolean"
     > x=pails/p "path"
    "foil"
  + input
    \ value=pail
    ^ str
    ? value
     > x=pails/t x.t
     > x=pails/n (nat/show x.n)
     > x=pails/b (? x.b "true" "false")
     > x=pails/p (path_show x.p)
    ""
  + decode
    \ old=pail mode=str source=str context=path state=namespace
    ^ either[str pail]
    ? (eq mode "foil")
      ?> (./some record) (sovereign_peek (goo_value/compiler_path state.self) state).fil (./err "Foil compiler is unavailable.")
      ?> (./some held) record.get(system_vocabulary/content) (./err "Foil compiler is unavailable.")
      ?> compiler=goo_value/compiler held (./err "Foil compiler is unavailable.")
      = evaluate compiler.evaluate
      | evaluate context source state
    ? !(eq mode (goo_value/mode old)) (./err "Input type no longer matches this value.")
    ? (eq mode "text") (./ok (pails/t source))
    ? (eq mode "number")
      ?> (./some number) (nat/parse source) (./err "Enter a nonnegative integer.")
      | ./ok (pails/n number)
    ? (eq mode "boolean")
      ? (eq source "true") (./ok (pails/b .true))
      ? (eq source "false") (./ok (pails/b .false))
      | ./err "Enter true or false."
    ? (eq mode "path")
      ?> (./some path) (path_parse source) (./err "Enter a canonical absolute path.")
      | ./ok (pails/p path)
    | ./err "Use a Foil expression for this value."
  + edit
    \ target=path slot=path expected=nat mode=str source=str context=path state=namespace
    ^ either[str namespace]
    ? !(state.permitted(target)) (./err "This namespace record is read-only.")
    ? !(equal (state.case(.x target)) (maybe/some[nat] expected))
      | ./err "This record changed. Refresh Values before saving; your draft has been kept."
    ?> (./some card) (sovereign_peek target state).fil (./err "Record no longer exists.")
    ?> (./some old) card.get(slot) (./err "Slot no longer exists.")
    ? (gt source.len 65536) (./err "Value input exceeds 64 KiB.")
    < value (goo_value/decode old mode source context state)
    ? (grove_install/change target (writ/poke (myth/sing slot value)) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))
