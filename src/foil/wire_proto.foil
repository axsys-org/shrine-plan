- json

' Protobuf framing primitives. Domain messages live in goo_app/wire.
' All length-delimited fields share BAT chunks; lengths are cached, not scanned.
+ wire_proto
  + varint
    \ n=nat
    ^ any
    ? (lt n 128) (bat_bytes n 1)
    | bat_cat (bat_bytes (add 128 (mod n 128)) 1) (wire_proto/varint (div n 128))
  + number
    \ tag=nat value=nat
    ^ any
    | bat_cat (wire_proto/varint (mul tag 8)) (wire_proto/varint value)
  + message
    \ tag=nat body=any
    ^ any
    | bat_concat [(wire_proto/varint (add (mul tag 8) 2)) (wire_proto/varint (bat_size body)) body]
  + text
    \ tag=nat value=str
    ^ any
    | wire_proto/message tag (bat_text (str/to_atom value))
  + fixed64
    \ tag=nat bits=nat
    ^ any
    | bat_cat (wire_proto/varint (add (mul tag 8) 1)) (bat_bytes bits 8)
  + envelope
    \ tag=nat body=any
    ^ any
    | bat_cat (wire_proto/number 1 2) (wire_proto/message tag body)
  + failure
    \ why=str
    ^ any
    | wire_proto/envelope 7 (wire_proto/text 1 why)
