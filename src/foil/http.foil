-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
+  http
  '  The inbound-HTTP driver vocabulary: driver configs, request
  '  records, and the behaviors the serving kook installs.

  +  respond_talk
    '  The responder the serving kook installs on a request node: the
    '  installing poke's talk answers 200, echoing the request's body
    '  slot (or its url when there is no body).
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       pay=pail
         ?  out.get(['body])
          > (./some held=pail)  held
          > .none
            ?  out.get(['url])
             > (./some held=pail)  held
             > .none  (pd 0)
       done out.put(['res_status] (pd 200)).put(['res_body] pay)
    (yell [] done)

  +  respond_form
    ^  form
    def_form.set_talk(http/respond_talk)

  +  serve_take
    '  The serving kook for an HTTP driver node: when a request node
    '  appears underneath (an added direct kid in the gift), emit a
    '  poke installing the configured responder kook on it — the same
    '  poke's talk then writes the response, all within the event.
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    ?>  (./some responder=path) cur.path_at(['serve])
       (yell [] cur)
    =  events  gift.tap
    %  idx=nat 0  cards=row[[p=path q=writ]] []
    ?  (eq idx events.len)
       (yell cards cur)
    =  [at act]  events.at(idx)
    ?  ?=(.add act)
       ?  (eq 1 at.len)
          =  card  (kooked [responder])
          (_ idx.inc cards.snoc([bowl.here.weld(at) (writ/poke card)]))
       (_ idx.inc cards)
    (_ idx.inc cards)

  +  serve_form
    ^  form
    def_form.set_take(http/serve_take)

  + cfg
    ' Service and responder are fully qualified namespace references.
    \ service=path responder=path
    ^ myth
    = config | (kooked [service]).put ['serve] (pails/p responder)
    | config.put ['namespace_root] (pails/p service.take(1))

  + cfg_port
    \ service=path responder=path port=nat
    ^ myth
    | (http/cfg service responder).put ['port] (pd port)

  +  face_at
    '  The face-kook path at the target's depth-n prefix: an app
    '  mounted at /app/<name> keeps its face at depth two, an app
    '  mounted at a root of its own (/chat) at depth one, and a
    '  subtree anywhere may carry its own.  The probe is a crew dep,
    '  so a missing face node hydrates empty and costs nothing.
    '  none for shallow targets and the derived overlays.
    \  n=nat tgt=path
    ^  maybe[path]
    ?  (lt tgt.len n)
       .none
    ?  (is_h tgt)
       .none
    ?  (is_o tgt)
       .none
    ?  (is_xv tgt)
       .none
    =  root=path  tgt.take(n)
    (./some root.weld(['kook 'face]))

  +  face_of
    '  The form riding a hydrated face view, if any: the same
    '  ['sys 'form]-slot pail extraction resolve performs on kook refs.
    \  fv=axal[myth]
    ^  maybe[form]
    ?  fv.fil
     > .none  .none
     > (./some ft=myth)
       ?  ft.get(['sys 'form])
        > .none  .none
        > (./some fp=pail)
          ?  fp
           > f=form  (./some f)
          .none

  +  tgt_of
    '  The parsed request target riding at ['vpath], or the empty
    '  path when absent.
    \ o=myth
    ^ path
    | o.path_at(['vpath]).fall []
  +  face_hunt
    '  The hunt riding a hydrated face view at ['hunt]: the face's
    '  rendering claim as data on the face record — a slot like any
    '  other, so a poke retunes a face's reach live.  Absent (or
    '  non-hunt) claims the whole subtree, matching hunt-less faces.
    \  fv=axal[myth]
    ^  hunt
    ?  fv.fil
     > .none  (hunt .z [])
     > (./some ft=myth)
       ?  ft.get(['hunt])
        > .none  (hunt .z [])
        > (./some hp=pail)
          ?  hp
           > h=hunt  h
          (hunt .z [])

  +  datum_face
    '  The bond/face binding riding a hydrated ancestor record view,
    '  if any: a hunt whose care is the claim reach over the
    '  record's own subtree and whose path names the rendering
    '  component ctor.
    \  av=axal[myth]
    ^  maybe[hunt]
    ?  av.fil
     > .none  .none
     > (./some t=myth)
       ?  t.get(bond/face)
        > .none  .none
        > (./some hp=pail)
          ?  hp
           > h=hunt  (./some h)
          .none

  +  hunt_admits
    '  Whether the face mounted at root claims the target: the
    '  hunt's path is root-relative, so the claim is rooted at
    '  root.weld(h.p); the care sets the reach — .x that node alone,
    '  .y the node plus its direct kids, .z the whole subtree
    '  beneath it.
    '  ?=  ((http/hunt_admits (hunt .z []) ['a] ['a 'b 'c]) 1)
    '  ?=  ((http/hunt_admits (hunt .x []) ['a] ['a 'b]) 0)
    '  ?=  ((http/hunt_admits (hunt .y []) ['a] ['a 'b]) 1)
    \  h=hunt root=path tgt=path
    ^  bool
    =  base=path  root.weld(h.p)
    ?  (lt tgt.len base.len)
       .false
    ?  !(eq_pith base tgt.take(base.len))
       .false
    ?  h.c
     > .x  (eq tgt.len base.len)
     > .y  (le tgt.len base.len.inc)
     > .z  .true

  +  req
    '  An HTTP request as a namespace record: method, url and body
    '  ride as data pails, the parsed target as a pails/p, a z-care
    '  dep on non-root targets (y-care at the global root), and —
    '  for live targets — a y-care dep on the target's /h/v version
    '  view.  Live targets also dep the face node at EVERY ancestor
    '  depth (['face n]), each ancestor RECORD itself (['anc n],
    '  x-care — where a bond/face datum binding rides) so the
    '  responder can dispatch to the deepest claim on the target,
    '  and each ancestor's /op registry (['ops n], y-care — the op
    '  cards' records) so the explorer can offer the app's op
    '  vocabulary as forms.  No kook: the serving kook above
    '  installs one.
    \  method=nat url=nat body=nat tgt=path
    ^  myth
    =  base (myth/new).put(['method] (pd method)).put(['url] (pd url)).put(['body] (pd body)).put(['vpath] (pails/p tgt))
       watch=crew
         ' The global explorer has no assertion or face dispatch; only
         ' its nearest live roots are displayed.
         =  view_care=care ? (eq tgt.len 0) .y .z
            base_sight  (crew/sing ['view] (dep view_care tgt))
         =  sight
              %  n=nat 1  acc=crew base_sight
              ^  crew
              ?  (gt n tgt.len)
                 acc
              ?  (http/face_at n tgt)
               > (./some fp=path)  (_ n.inc acc.put(['face ($u n)] (dep .x fp)))
               > .none  (_ n.inc acc)
         ?  (is_h tgt)
            sight
         ?  (is_o tgt)
            sight
         ?  (is_xv tgt)
            sight
         ?  (eq 0 tgt.len)
            sight
         =  withanc
              %  n=nat 1  acc=crew sight
              ^  crew
              ?  (gt n tgt.len)
                 acc
              =  pre=path  tgt.take(n)
              =  a1  acc.put(['anc ($u n)] (dep .x pre))
              (_ n.inc a1.put(['ops ($u n)] (dep .y pre.weld(['op]))))
         =  vroot=path  ['h 'v (| dig_show tgt.len)]
         withanc.put(['ver] (dep .y vroot.weld(tgt)))
    base.put(crew_slot (cpail watch))
