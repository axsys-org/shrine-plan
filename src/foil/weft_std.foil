- shrine_types
- bond

' Standard cells.  A cell is a record whose /sys/weft is an x-care
' safe to one of these ctor records and whose /sys/tack is a y-care
' safe to its input (version 0: live, the cell follows the input).
' Each ctor is a cell: it reads its parameters from the context
' (the cell's own slots, secondary inputs at /views/<slot>), takes
' the input tree from the tack, and returns the context and the
' derived tree.  A missing or malformed parameter passes the input
' tree through and names the parameter at /sys/view/missing in context'.
+ weft_std
  + missing
    ' A parameter the ctor asked for and did not get: say so in the
    ' context' and pass the input tree through unchanged.
    \ context=myth tree=axal[myth] what=str
    ^ [myth axal[myth]]
    | [context.put(['sys 'view 'missing] (pails/t what)) tree]
  + root
    \ context=myth slot=path value=pail
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing slot value)))]
  + text
    ' A text parameter of the cell.
    \ record=myth key=path
    ^ maybe[str]
    ?> (./some held) record.get(key) .none
    ? held
     > t=pails/t (./some t.t)
    .none
  + slot
    ' A slot-path parameter of the cell, with a default when absent.
    \ record=myth key=path default=path
    ^ maybe[path]
    ?> (./some t) (weft_std/text record key) (./some default)
    | path_parse t
  + number
    ' A numeric parameter: a literal natural, a slot of the input root, or /views/<slot>/<path> of a secondary input.
    \ record=myth key=path tree=axal[myth]
    ^ maybe[nat]
    ?> (./some t) (weft_std/text record key) .none
    ? (nat/parse t)
     > (./some n) (./some n)
     > .none
      ?> (./some pax) (path_parse t) .none
      ' /views/<slot>/<path> reads a secondary input's root record.
      ? (and (gt pax.len 2) (eq_iota pax.at(0) 'views))
        ?> (./some held) record.get(pax.take(2)) .none
        ?> view=cell_view held .none
        = other (unpin view.tree)
        ?> (./some root) other.fil .none
        ?> (./some h) root.get(pax.drop(2)) .none
        ? h
         > n=pails/n (./some n.n)
        .none
      ?> (./some root) tree.fil .none
      ?> (./some held) root.get(pax) .none
      ? held
       > n=pails/n (./some n.n)
      .none
  + count
    ' The number of children of the input, at /count (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some into) (weft_std/slot record ['into] ['count]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/n tree.kid.size)
  + sum
    ' The sum of the natural at /slot over every record of the input, at /total (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot as a slot path")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] ['total]) (weft_std/missing record tree "Supply /into as a slot path")
    = total
        | tree.tap.fold 0
          \ acc [p q]
          ?> (./some held) q.get(slot) acc
          ? held
           > n=pails/n (add acc n.n)
          acc
    | weft_std/root record into (pails/n total)
  + where
    ' The children of the input whose /key slot equals /value, under the input root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = kept
        | tree.kid_tap.fold (axal/new[myth] tree.fil)
          \ out entry
          ?> (./some rec) entry.val.fil out
          ?> (./some held) rec.get(key) out
          ? held
           > t=pails/t (? (equal t.t value) out.rep([entry.key] entry.val) out)
          out
    | [record kept]
  + arith
    ' /left and /right are literal naturals or slots of the input root; the answer goes to /into (or /result).
    \ record=myth tree=axal[myth] op=str
    ^ [myth axal[myth]]
    ?> (./some left) (weft_std/number record ['left] tree) (weft_std/missing record tree "Supply /left: a number or a slot of the input")
    ?> (./some right) (weft_std/number record ['right] tree) (weft_std/missing record tree "Supply /right: a number or a slot of the input")
    ?> (./some into) (weft_std/slot record ['into] ['result]) (weft_std/missing record tree "Supply /into as a slot path")
    ? (equal op "add") (weft_std/root record into (pails/n (add left right)))
    ? (equal op "multiply") (weft_std/root record into (pails/n (mul left right)))
    ? (equal op "subtract")
      ? (lt left right) (weft_std/missing record tree "Left is smaller than right")
      | weft_std/root record into (pails/n (sub left right))
    ? (eq right 0) (weft_std/missing record tree "Division by zero")
    | weft_std/root record into (pails/n (div left right))
  + add
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "add"
  + subtract
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "subtract"
  + multiply
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "multiply"
  + divide
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "divide"
  + by_name
    ' The ctor a standard cell record names.  Records never hold the
    ' closure itself: a closure in the namespace is copied with every
    ' message and made each request forty times slower; a name is a
    ' pail, and travels.
    \ name=iota
    ^ maybe[cell]
    ? (eq_iota name 'count) (./some (cell weft_std/count))
    ? (eq_iota name 'sum) (./some (cell weft_std/sum))
    ? (eq_iota name 'where) (./some (cell weft_std/where))
    ? (eq_iota name 'add) (./some (cell weft_std/add))
    ? (eq_iota name 'subtract) (./some (cell weft_std/subtract))
    ? (eq_iota name 'multiply) (./some (cell weft_std/multiply))
    ? (eq_iota name 'divide) (./some (cell weft_std/divide))
    .none
  + record
    ' The record of one standard cell: the ctor's name and a title.
    \ name=iota title=str
    ^ myth
    | (myth/sing bond/weft (pails/q name)).put bond/lede (pails/t title)
  + seeds
    ' Boot seeds under /weft/stdlib.
    ^ row[[path myth]]
    [[['weft 'stdlib] (myth/sing bond/lede (pails/t "Standard cells"))]
     [['weft 'stdlib 'count] (weft_std/record 'count "Count the input's children")]
     [['weft 'stdlib 'sum] (weft_std/record 'sum "Sum a slot over the input")]
     [['weft 'stdlib 'where] (weft_std/record 'where "Keep the children whose slot equals a value")]
     [['weft 'stdlib 'add] (weft_std/record 'add "Add")]
     [['weft 'stdlib 'subtract] (weft_std/record 'subtract "Subtract")]
     [['weft 'stdlib 'multiply] (weft_std/record 'multiply "Multiply")]
     [['weft 'stdlib 'divide] (weft_std/record 'divide "Divide")]]
