- shrine_types
- bond

' Standard cells.  A cell is a record whose /sys/weft is an x-care
' safe to one of these ctor records and whose /sys/tack is a y-care
' safe to its input (version 0: live, the cell follows the input).
' Each ctor is a cell: it reads its parameters from the context
' (the cell's own slots, secondary inputs at /views/<slot>), takes
' the input tree from the tack, and returns the context and the
' derived tree.  A missing or malformed parameter passes the input
' tree through and names the parameter at /sys/view/missing in context'.
'
' Numbers.  A number slot holds a natural.  A record may carry /scale
' (a natural): every number slot in that record is an integer scaled
' by ten to that power, so 1250 with /scale 2 is 12.50; <slot>/scale
' sets the scale of one slot (amount/scale 2 leaves /when whole).
' Formulas read
' a number with its record's scale, align scales to the larger one,
' and write /scale on their output root.  A literal parameter may
' carry a point: "12.5" is 125 at scale 1.  Dates and durations are
' numbers too (pails/dm, pails/ds, pails/dr), compared in their own
' unit.  Nothing here calls, loops or branches on anything but data.
+ weft_std
  ' ---- answers
  + missing
    ' A parameter the ctor asked for and did not get: say so in the
    ' context' and pass the input tree through unchanged.
    \ context=myth tree=axal[myth] what=str
    ^ [myth axal[myth]]
    | [context.put(['sys 'view 'missing] (pails/t what)) tree]
  + root
    \ context=myth slot=path value=pail
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing slot value)))]
  + figure
    ' A root record holding one scaled number, signed.
    \ context=myth slot=path n=nat s=nat neg=bool
    ^ [myth axal[myth]]
    | [context (axal/new[myth] (./some (myth/sing slot (weft_std/num_pail n neg)).put(['scale] (pails/n s))))]
  + done
    \ context=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | [context tree]
  ' ---- parameters
  + text
    ' A text parameter of the cell.
    \ record=myth key=path
    ^ maybe[str]
    ?> (./some held) record.get(key) .none
    ? held
     > t=pails/t (./some t.t)
     > n=pails/n (./some (nat/show n.n))
    .none
  + text_or
    \ record=myth key=path default=str
    ^ str
    | (weft_std/text record key).fall(default)
  + slot
    ' A slot-path parameter of the cell, with a default when absent.
    \ record=myth key=path default=path
    ^ maybe[path]
    ?> (./some t) (weft_std/text record key) (./some default)
    | path_parse t
  + slots
    ' A space-separated list of slot paths.
    \ record=myth key=path
    ^ row[path]
    ?> (./some t) (weft_std/text record key) []
    | t.split_byte(32).fold []
      \ acc part
      ?> (./some pax) (path_parse part) acc
      acc.snoc(pax)
  + count_param
    \ record=myth key=path default=nat
    ^ nat
    ?> (./some t) (weft_std/text record key) default
    | (nat/parse t).fall(default)
  + view
    ' A secondary input by its slot name.
    \ record=myth name=iota
    ^ maybe[axal[myth]]
    ?> (./some held) record.get(['views name]) .none
    ?> v=cell_view held .none
    | ./some (unpin v.tree)
  ' ---- numbers
  + pow10
    \ k=nat
    ^ nat
    % i=nat 0 acc=nat 1
    ? (eq i k) acc
    | _ i.inc (mul acc 10)
  + scale_of
    ' The scale of a number slot: <slot>/scale when the record carries
    ' one for that slot, else the record's /scale, else 0.
    \ record=myth pax=path
    ^ nat
    = own=maybe[nat]
        ?> (./some held) record.get(pax.snoc('scale)) .none
        ? held
         > n=pails/n (./some n.n)
        .none
    ? own
     > (./some s) s
    ?> (./some held) record.get(['scale]) 0
    ? held
     > n=pails/n n.n
    0
  + nat_of
    ' The natural a pail holds: numbers, dates, durations.  A boolean
    ' is not a number (any and all read booleans through truthy).
    \ held=pail
    ^ maybe[nat]
    ? held
     > n=pails/n (./some n.n)
     > d=pails/dm (./some d.n)
     > d=pails/ds (./some d.n)
     > d=pails/dr (./some d.n)
    .none
  + sign_of
    ' A pail's number as magnitude and sign: a natural, a date or a
    ' duration is positive; z carries its sign.
    \ held=pail
    ^ maybe[[nat bool]]
    ? held
     > n=pails/n (./some [n.n .false])
     > z=pails/z (./some [z.n z.neg])
     > d=pails/dm (./some [d.n .false])
     > d=pails/ds (./some [d.n .false])
     > d=pails/dr (./some [d.n .false])
    .none
  + num_pail
    ' A magnitude with its sign as a pail: a natural, or z when negative.
    \ n=nat neg=bool
    ^ pail
    ? (and neg (gt n 0)) (pails/z .true n)
    | pails/n n
  + xor_sign
    ' The sign of a product or quotient: negative when exactly one side is, never for zero.
    \ a=bool b=bool n=nat
    ^ bool
    ? (eq n 0) .false
    ? a (? b .false .true)
    b
  + signed_add
    ' a + b on magnitudes with signs, at one scale.
    \ an=nat aneg=bool bn=nat bneg=bool
    ^ [nat bool]
    = same (? aneg bneg (? bneg .false .true))
    ? same [(add an bn) (and aneg (gt (add an bn) 0))]
    ? (lt an bn) [(sub bn an) bneg]
    ? (eq an bn) [0 .false]
    | [(sub an bn) aneg]
  + less
    ' Signed: is a below b?
    \ an=nat aneg=bool bn=nat bneg=bool
    ^ bool
    ? aneg (? bneg (gt an bn) .true)
    ? bneg .false
    | lt an bn
  + slot_figure
    ' A number slot of a record, with the record's scale and its sign.
    \ record=myth pax=path
    ^ maybe[[nat nat bool]]
    ?> (./some held) record.get(pax) .none
    ?> (./some sn) (weft_std/sign_of held) .none
    = [n neg] sn
    | ./some [n (weft_std/scale_of record pax) neg]
  + figure_at
    ' A number slot of a row through the name convention (a numeric
    ' child name counts), with its scale.
    \ rec=myth p=path slot=path
    ^ maybe[[nat nat bool]]
    ?> (./some held) (weft_std/at rec p slot) .none
    ?> (./some sn) (weft_std/sign_of held) .none
    = [n neg] sn
    ? !(rec.has(slot)) (./some [n 0 neg])
    | ./some [n (weft_std/scale_of rec slot) neg]
  + literal
    ' "125" is 125 at scale 0; "12.5" is 125 at scale 1; "-3" is 3, negative.
    \ t=str
    ^ maybe[[nat nat bool]]
    = neg (and (gt t.len 0) (eq t.at(0) 45))
      body (? neg t.slice(1 t.len) t)
      parts body.split_byte(46)
    ? (eq parts.len 1)
      ?> (./some n) (nat/parse body) .none
      | ./some [n 0 (and neg (gt n 0))]
    ? !(eq parts.len 2) .none
    = whole parts.at(0)
      frac parts.at(1)
    ?> (./some w) (nat/parse (? (eq whole.len 0) "0" whole)) .none
    ?> (./some f) (nat/parse frac) .none
    = n (add (mul w (weft_std/pow10 frac.len)) f)
    | ./some [n frac.len (and neg (gt n 0))]
  + figure_in
    ' A numeric parameter resolved against a record: a literal, a slot
    ' of that record, or /views/<slot>/<path> of a secondary input.
    \ context=myth key=path record=myth
    ^ maybe[[nat nat bool]]
    ?> (./some t) (weft_std/text context key) .none
    ? (weft_std/literal t)
     > (./some fig) (./some fig)
     > .none
      ?> (./some pax) (path_parse t) .none
      ? (and (gt pax.len 2) (eq_iota pax.at(0) 'views))
        ?> (./some other) (weft_std/view context pax.at(1)) .none
        ?> (./some orec) other.fil .none
        | weft_std/slot_figure orec pax.drop(2)
      | weft_std/slot_figure record pax
  + figure_of
    ' A numeric parameter against the input root.
    \ context=myth key=path tree=axal[myth]
    ^ maybe[[nat nat bool]]
    | weft_std/figure_in context key tree.fil.fall(myth/new)
  + rescale
    ' Move a number from one scale to another, rounding half up.
    \ n=nat from=nat to=nat
    ^ nat
    ? (eq from to) n
    ? (lt from to) (mul n (weft_std/pow10 (sub to from)))
    = d (weft_std/pow10 (sub from to))
    | div (add n (div d 2)) d
  + align
    ' Two figures at the larger of their scales, with their signs.
    \ a=[nat nat bool] b=[nat nat bool]
    ^ [nat nat nat bool bool]
    = [an as aneg] a
      [bn bs bneg] b
      s (? (lt as bs) bs as)
    | [(weft_std/rescale an as s) (weft_std/rescale bn bs s) s aneg bneg]
  + show_figure
    \ n=nat s=nat
    ^ str
    ? (eq s 0) (nat/show n)
    = d (weft_std/pow10 s)
      frac (nat/show (mod n d))
      pad
        % i=nat frac.len acc=str ""
        ? (eq i s) acc
        | _ i.inc acc.cat("0")
    | str/cat_all [(nat/show (div n d)) "." pad frac]
  + key_of
    ' A child key made from data: letters, digits and underscores kept,
    ' any other byte an underscore (2007-06-25 is 2007_06_25); digits
    ' alone are a number, a text starting with a letter or underscore a
    ' symbol, the rest a text atom, shown with a $ (a key that cannot
    ' print as a symbol breaks the supervisor's tracing).
    \ text=str
    ^ iota
    = clean (weft_std/sanitize text)
    ? (eq clean.len 0) ($ta "empty")
    ? (nat/parse clean)
     > (./some n) ($u n)
    ? (weft_std/symbolic clean) ($ts clean)
    ($ta clean)
  + sanitize
    \ text=str
    ^ str
    % i=nat 0 out=nat 0
    ? (eq i text.len) (str/from_atom out)
    = b text.at(i)
      ok ((and (ge b 48) (le b 57)) || ((and (ge b 65) (le b 90)) || ((and (ge b 97) (le b 122)) || (eq b 95))))
    | _ i.inc (add out (lsh (? ok b 95) (mul i 8)))
  + symbolic
    ' Does the text start with a letter?  A symbol must; one starting
    ' with an underscore or a digit cannot be printed as one.
    \ text=str
    ^ bool
    ? (eq text.len 0) .false
    = b text.at(0)
    | ((and (ge b 65) (le b 90)) || (and (ge b 97) (le b 122)))
  + show_pail
    ' The text a pail compares and groups by; a reference is its /h spelling, as a read shows it.
    \ held=pail
    ^ str
    ? held
     > t=pails/t t.t
     > n=pails/n (nat/show n.n)
     > z=pails/z (str/cat_all ["-" (nat/show z.n)])
     > b=pails/b (? b.b "true" "false")
     > q=pails/q (iota_show q.q)
     > p=pails/p (path_show p.p)
     > d=pails/dm (nat/show d.n)
     > d=pails/ds (nat/show d.n)
     > d=pails/dr (nat/show d.n)
     > s=safe (path_show s.spell)
    ""
  ' ---- rows
  + rows
    ' Every record below the root, at any depth, with its path: the
    ' direct children of a y input, the whole subtree of a z input.
    \ tree=axal[myth]
    ^ row[[path myth]]
    = none=row[[path myth]] []
    | tree.tap.fold none
      \ acc [p q]
      ? (eq p.len 0) acc
      acc.snoc([p q])
  + key_pail
    ' A row's key as a value: the name for a direct child (a number
    ' when the name is numeric), the path as text below.
    \ p=path
    ^ pail
    ? !(eq p.len 1) (pails/t (path_show p))
    ?> (./some n) (nat/parse (iota_show p.at(0))) (pails/q p.at(0))
    | pails/n n
  + dotted
    ' A path as one key segment: its names joined by underscores (the
    ' only joiner a segment admits).
    \ p=path
    ^ iota
    = none=row[str] []
      parts
        % i=nat 0 acc=row[str] none
        ^ row[str]
        ? (eq i p.len) acc
        | _ i.inc acc.snoc((iota_show p.at(i)))
    | weft_std/key_of (str/join "_" parts)
  + at
    ' A slot of a row.  The slot called name is the row's own key (its
    ' last path segment; a numeric key counts as a number) when the
    ' record carries no name slot, so a child's name is addressable in
    ' any setting.
    \ rec=myth p=path slot=path
    ^ maybe[pail]
    = named (and (eq slot.len 1) (and (eq_iota slot.at(0) 'name) (gt p.len 0)))
      none=maybe[pail] .none
      own=maybe[pail]
        ? !named none
        = last p.at(p.len.dec)
        ?> (./some n) (nat/parse (iota_show last)) (./some (pails/q last))
        | ./some (pails/n n)
    ?> (./some held) rec.get(slot) own
    | ./some held
  + same_path
    \ a=path b=path
    ^ bool
    | (and (eq a.len b.len) (pith_prefix a b))
  + child_record
    \ child=axal[myth]
    ^ myth
    | child.fil.fall(myth/new)
  + keyed
    ' Rows ranked by a slot: [number path record], at the rows' larger
    ' scale, skipping rows without the slot.
    \ tree=axal[myth] slot=path
    ^ [row[[nat bool path myth]] nat]
    = rows (weft_std/rows tree)
      s
        | rows.fold 0
          \ acc [p rec]
          = cs (weft_std/scale_of rec slot)
          | ? (lt acc cs) cs acc
      none=row[[nat bool path myth]] []
      items
        | rows.fold none
          \ acc [p rec]
          ?> (./some fig) (weft_std/figure_at rec p slot) acc
          = [n cs neg] fig
          | acc.snoc([(weft_std/rescale n cs s) neg p rec])
    | [items s]
  + ranked
    ' Insertion sort of ranked rows, ascending or descending by number.
    \ items=row[[nat bool path myth]] desc=bool
    ^ row[[nat bool path myth]]
    = none=row[[nat bool path myth]] []
    | items.fold none
      \ out item
      = [n ng key child] item
      % i=nat 0
      ^ row[[nat bool path myth]]
      ? (eq i out.len) out.snoc(item)
      = [m mg k2 c2] out.at(i)
      ? (? desc (weft_std/less m mg n ng) (weft_std/less n ng m mg)) out.take(i).snoc(item).weld(out.drop(i))
      | _ i.inc
  + numbered
    ' Rows re-keyed by rank, each keeping its original key at /key.
    \ root=maybe[myth] items=row[[nat bool path myth]]
    ^ axal[myth]
    % i=nat 0 out=axal[myth] (axal/new[myth] root)
    ^ axal[myth]
    ? (eq i items.len) out
    = [n ng p rec] items.at(i)
    | _ i.inc out.put([($u i.inc)] rec.put(['key] (weft_std/key_pail p)))
  + truthy
    \ record=myth slot=path
    ^ bool
    ?> (./some held) record.get(slot) .false
    ? held
     > b=pails/b b.b
     > n=pails/n (gt n.n 0)
     > z=pails/z (gt z.n 0)
     > t=pails/t (gt t.t.len 0)
    .false
  + compare
    ' Two figures aligned to the larger scale, by signed value: 0 below, 1 equal, 2 above.
    \ a=[nat nat bool] b=[nat nat bool]
    ^ nat
    = [m lm s aneg bneg] (weft_std/align a b)
    ? (weft_std/less m aneg lm bneg) 0
    ? (weft_std/less lm bneg m aneg) 2
    1
  + matches
    ' One comparison of a row's slot against a literal, by operator:
    ' equals, over, under, before, after, contains.  Numbers compare
    ' by value at their scale (136 at scale 2 is 1.36); anything else
    ' compares as text.  The slot called name is the row's key.
    \ op=str rec=myth p=path slot=path value=str
    ^ bool
    ?> (./some held) (weft_std/at rec p slot) .false
    = shown (weft_std/show_pail held)
      both=maybe[[[nat nat bool] [nat nat bool]]]
        ?> (./some f) (weft_std/figure_at rec p slot) .none
        ?> (./some l) (weft_std/literal value) .none
        | ./some [f l]
    ? (equal op "contains") (maybe/is_some (str/find value shown))
    ?> (./some pair) both (and (equal op "equals") (equal shown value))
    = [f l] pair
      c (weft_std/compare f l)
    ? (equal op "equals") (eq c 1)
    ? ((equal op "over") || (equal op "after")) (eq c 2)
    ? ((equal op "under") || (equal op "before")) (eq c 0)
    .false
  + reduce
    ' count, sum, min, max or avg of a slot over ranked rows at scale s, signed.
    \ op=str items=row[[nat bool path myth]] s=nat
    ^ [nat nat bool]
    ? (equal op "count") [items.len 0 .false]
    = zero=[nat bool] [0 .false]
      [tn tneg]
        | items.fold zero
          \ acc [n ng p rec]
          = [an aneg] acc
          | weft_std/signed_add an aneg n ng
    ? (equal op "sum") [tn s tneg]
    ? (eq items.len 0) [0 s .false]
    = [n0 g0 p0 r0] items.at(0)
      first=[nat bool] [n0 g0]
      [mn mg]
        | items.fold first
          \ acc [n ng p rec]
          = [an aneg] acc
          ? (weft_std/less n ng an aneg) [n ng]
          acc
      [xn xg]
        | items.fold first
          \ acc [n ng p rec]
          = [an aneg] acc
          ? (weft_std/less an aneg n ng) [n ng]
          acc
    ? (equal op "min") [mn s mg]
    ? (equal op "max") [xn s xg]
    | [(div (add tn (div items.len 2)) items.len) s tneg]
  ' ---- reduce a tree to a figure
  + count
    ' The number of children of the input, at /count (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some into) (weft_std/slot record ['into] ['count]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/n (weft_std/rows tree).len)
  + fold_slot
    \ record=myth tree=axal[myth] op=str default=path
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot as a slot path")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] default) (weft_std/missing record tree "Supply /into as a slot path")
    = [items s] (weft_std/keyed tree slot)
      [n rs ng] (weft_std/reduce op items s)
    | weft_std/figure record into n rs ng
  + sum
    ' The sum of /slot over the children, at /total (or /into).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "sum" ['total]
  + min
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "min" ['min]
  + max
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "max" ['max]
  + avg
    ' The mean of /slot over the children, rounded half up at the input's scale, at /avg.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/fold_slot record tree "avg" ['avg]
  + any
    ' Whether any child has a true (or non-zero, non-empty) /slot, at /any.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] ['any]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/b (weft_std/rows tree).any((\ [p rec] (weft_std/truthy rec slot))))
  + all
    ' Whether every child has a true /slot, at /all.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] ['all]) (weft_std/missing record tree "Supply /into as a slot path")
    | weft_std/root record into (pails/b (weft_std/rows tree).all((\ [p rec] (weft_std/truthy rec slot))))
  ' ---- keep or reshape rows
  + where
    ' The children whose /key slot matches /value under /op (equals, over, under, before, after, contains), under the input root; or whose /expr is true.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some src) (weft_std/text record ['expr]) (weft_std/where_settings record tree)
    ? (weft_std/expr_beside record [['key] ['value] ['op]]) (weft_std/fault record "expr: not beside /key, /value or /op")
    | weft_std/expr_rows "where" record tree src
  + where_settings
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = op (weft_std/text_or record ['op] "equals")
      kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          ? (weft_std/matches op rec p key value) out.put(p rec)
          out
    | weft_std/done record kept
  + sort
    ' The children ranked by /slot (ascending, or /order desc; a second slot breaks ties), re-keyed 1, 2, 3 with the old key at /key.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = slots (weft_std/slots record ['slot])
    ? (eq slots.len 0) (weft_std/missing record tree "Supply /slot")
    = desc (equal (weft_std/text_or record ['order] "asc") "desc")
      slot slots.at(0)
      [items s] (weft_std/keyed tree slot)
      ordered
        ? (lt slots.len 2) (weft_std/ranked items desc)
        | weft_std/ranked (weft_std/presorted items slot s slots.at(1) desc) desc
    | weft_std/done record (weft_std/numbered tree.fil ordered)
  + presorted
    ' Items in the order of a second slot (rows without it count as zero), with
    ' their first-slot figures: a stable rank by the first slot then breaks ties by the second.
    \ items=row[[nat bool path myth]] slot=path s=nat second=path desc=bool
    ^ row[[nat bool path myth]]
    = s2
        | items.fold 0
          \ acc [n ng p rec]
          = cs (weft_std/scale_of rec second)
          | ? (lt acc cs) cs acc
      none=row[[nat bool path myth]] []
      keyed2
        | items.fold none
          \ acc [n ng p rec]
          ?> (./some fig) (weft_std/figure_at rec p second) acc.snoc([0 .false p rec])
          = [m cs mg] fig
          | acc.snoc([(weft_std/rescale m cs s2) mg p rec])
      order2 (weft_std/ranked keyed2 desc)
    | order2.fold none
      \ acc [m mg p rec]
      ?> (./some fig) (weft_std/figure_at rec p slot) acc
      = [n cs ng] fig
      | acc.snoc([(weft_std/rescale n cs s) ng p rec])
  + top
    ' The /count (default 3) children with the largest /slot, ranked.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = n (weft_std/count_param record ['count] 3)
      [items s] (weft_std/keyed tree slot)
      sorted (weft_std/ranked items .true)
      kept (? (lt sorted.len n) sorted.len n)
    | weft_std/done record (weft_std/numbered tree.fil sorted.take(kept))
  + extreme
    \ record=myth tree=axal[myth] desc=bool
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = [items s] (weft_std/keyed tree slot)
      sorted (weft_std/ranked items desc)
    ? (eq sorted.len 0) (weft_std/done record (axal/new[myth] .none))
    = [n ng p rec] sorted.at(0)
    | weft_std/done record (axal/new[myth] (./some rec.put(['key] (weft_std/key_pail p))))
  + latest
    ' The child with the largest /slot (a date, usually), as the root, its key at /key.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/extreme record tree .true
  + earliest
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/extreme record tree .false
  + arith_op
    ' Signed arithmetic on two figures at their larger scale.
    \ op=str a=[nat nat bool] b=[nat nat bool]
    ^ either[str [nat nat bool]]
    = [an bn s aneg bneg] (weft_std/align a b)
    ? (equal op "add")
      = [n ng] (weft_std/signed_add an aneg bn bneg)
      | ./ok [n s ng]
    ? (equal op "subtract")
      = [n ng] (weft_std/signed_add an aneg bn (? bneg .false (gt bn 0)))
      | ./ok [n s ng]
    ? (equal op "multiply") (./ok [(weft_std/rescale (mul an bn) (mul s 2) s) s (weft_std/xor_sign aneg bneg (mul an bn))])
    ? (equal op "divide")
      ? (eq bn 0) (./err "Division by zero")
      | ./ok [(div (add (mul an (weft_std/pow10 s)) (div bn 2)) bn) s (weft_std/xor_sign aneg bneg an)]
    | ./err "Unknown /op: add, subtract, multiply or divide"
  + each
    ' A derived slot per child: /into = /left /op /right, where each side is a literal or a slot of the child; or /into = /expr.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some src) (weft_std/text record ['expr]) (weft_std/each_settings record tree)
    ? (weft_std/expr_beside record [['left] ['op] ['right]]) (weft_std/fault record "expr: not beside /left, /op or /right")
    ?> (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into as a slot path")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    | weft_std/expr_rows "each" record tree src
  + each_settings
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some lt) (weft_std/text record ['left]) (weft_std/missing record tree "Supply /left")
    ?> (./some rt) (weft_std/text record ['right]) (weft_std/missing record tree "Supply /right")
    ?> (./some op) (weft_std/text record ['op]) (weft_std/missing record tree "Supply /op (add, subtract, multiply, divide)")
    ?> (./some intotext) (weft_std/text record ['into]) (weft_std/missing record tree "Supply /into")
    ?> (./some into) (path_parse intotext) (weft_std/missing record tree "Supply /into as a slot path")
    = out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some a) (weft_std/figure_in record ['left] rec) acc.put(p rec)
          ?> (./some b) (weft_std/figure_in record ['right] rec) acc.put(p rec)
          ? (weft_std/arith_op op a b)
           > (./ok fig)
            = [n s ng] fig
            | acc.put(p rec.put(into (weft_std/num_pail n ng)).put(['scale] (pails/n s)))
           > (./err _) acc.put(p rec)
    | weft_std/done record out
  + lookup
    ' For each child, bring /take from the row of /views/<from> whose /match equals the child's /key, into /into.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key")
    ?> (./some take) (weft_std/slot record ['take] []) (weft_std/missing record tree "Supply /take")
    ? ((eq key.len 0) || (eq take.len 0)) (weft_std/missing record tree "Supply /key and /take as slot paths")
    ?> (./some match) (weft_std/slot record ['match] key) (weft_std/missing record tree "Supply /match as a slot path")
    ?> (./some into) (weft_std/slot record ['into] take) (weft_std/missing record tree "Supply /into as a slot path")
    = from ($ts (weft_std/text_or record ['from] "table"))
    ?> (./some table) (weft_std/view record from) (weft_std/missing record tree "Supply a reference to the table as a slot named by /from")
    = rows (weft_std/rows table)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p key) acc.put(p rec)
          = wanted (weft_std/show_pail held)
            nothing=maybe[pail] .none
            found
              | rows.fold nothing
                \ hit [rp rrec]
                ? (maybe/is_some hit) hit
                ?> (./some mh) (weft_std/at rrec rp match) hit
                ? !(equal (weft_std/show_pail mh) wanted) hit
                | weft_std/at rrec rp take
          ?> (./some value) found acc.put(p rec)
          | acc.put(p rec.put(into value))
    | weft_std/done record out
  + distinct
    ' The values /slot takes over the children, as rows keyed 1, 2, 3 with /value and /count; the root gains /count: how many.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = none=row[[str pail nat]] []
      groups
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p slot) acc
          = shown (weft_std/show_pail held)
          % i=nat 0
          ^ row[[str pail nat]]
          ? (eq i acc.len) acc.snoc([shown held 1])
          = [s2 h2 c2] acc.at(i)
          ? (equal s2 shown) acc.take(i).snoc([s2 h2 c2.inc]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] (./some tree.fil.fall(myth/new).put(['count] (pails/n groups.len))))
    ^ [myth axal[myth]]
    ? (eq i groups.len) (weft_std/done record out)
    = [shown held c] groups.at(i)
    | _ i.inc out.put([($u i.inc)] (myth/sing ['value] held).put(['count] (pails/n c)))
  + select
    ' Keep only the slots named in /slots (space separated) on the root and each child.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = wanted (weft_std/slots record ['slots])
    ? (eq wanted.len 0) (weft_std/missing record tree "Supply /slots: slot paths separated by spaces")
    = trim
        \ p=path rec=myth
        ^ myth
        | wanted.fold myth/new
          \ acc pax
          ?> (./some held) (weft_std/at rec p pax) acc
          acc.put(pax held)
      none=path []
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil.run((\ r=myth (trim none r))))
          \ acc [p rec]
          | acc.put(p (trim p rec))
    | weft_std/done record out
  ' ---- change the shape
  + group_value
    ' A row's group: the value of one key, or two keys' values joined by an underscore (both must be there).
    \ keys=row[path] rec=myth p=path
    ^ maybe[pail]
    ? (eq keys.len 1) (weft_std/at rec p keys.at(0))
    ?> (./some a) (weft_std/at rec p keys.at(0)) .none
    ?> (./some b) (weft_std/at rec p keys.at(1)) .none
    | ./some (pails/t (str/cat_all [(weft_std/show_pail a) "_" (weft_std/show_pail b)]))
  + by
    ' Group the rows by /key (a slot, two slots joined by an underscore, or the word depth for the row's depth), then /op (count, sum, min, max, avg) their /slot: rows keyed by group value with /value and /into.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some keytext) (weft_std/text record ['key]) (weft_std/missing record tree "Supply /key")
    = by_depth (equal keytext "depth")
      keys (? by_depth [] (weft_std/slots record ['key]))
    ? (and !by_depth (eq keys.len 0)) (weft_std/missing record tree "Supply /key as a slot path or the word depth")
    = key=path (? (eq keys.len 0) [] keys.at(0))
      op (weft_std/text_or record ['op] "count")
      slot (weft_std/slot record ['slot] key).fall(key)
    ?> (./some into) (weft_std/slot record ['into] [($ts op)]) (weft_std/missing record tree "Supply /into as a slot path")
    = none=row[[str pail axal[myth]]] []
      groups
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          = held=maybe[pail] (? by_depth (./some (pails/n p.len)) (weft_std/group_value keys rec p))
          ?> (./some h) held acc
          = shown (weft_std/show_pail h)
          % i=nat 0
          ^ row[[str pail axal[myth]]]
          ? (eq i acc.len) acc.snoc([shown h (axal/new[myth] .none).put(p rec)])
          = [s2 h2 sub] acc.at(i)
          ? (equal s2 shown) acc.take(i).snoc([s2 h2 sub.put(p rec)]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
    ^ [myth axal[myth]]
    ? (eq i groups.len) (weft_std/done record out)
    = [shown held sub] groups.at(i)
      [items s] (weft_std/keyed sub slot)
      [n rs ng] (? (equal op "count") [(weft_std/rows sub).len 0 .false] (weft_std/reduce op items s))
    | _ i.inc out.put([(weft_std/key_of shown)] (myth/sing ['value] held).put(into (weft_std/num_pail n ng)).put(['scale] (pails/n rs)))
  + grid
    ' Rows keyed by /row value, one slot per /col value, holding /op of /slot.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some rowk) (weft_std/slot record ['row] []) (weft_std/missing record tree "Supply /row")
    ?> (./some colk) (weft_std/slot record ['col] []) (weft_std/missing record tree "Supply /col")
    ? ((eq rowk.len 0) || (eq colk.len 0)) (weft_std/missing record tree "Supply /row and /col as slot paths")
    = op (weft_std/text_or record ['op] "count")
      slot (weft_std/slot record ['slot] rowk).fall(rowk)
      none=row[[str str axal[myth]]] []
      cells
        | (weft_std/rows tree).fold none
          \ acc [p rec]
          ?> (./some rh) (weft_std/at rec p rowk) acc
          ?> (./some ch) (weft_std/at rec p colk) acc
          = r (weft_std/show_pail rh)
            c (weft_std/show_pail ch)
          % i=nat 0
          ^ row[[str str axal[myth]]]
          ? (eq i acc.len) acc.snoc([r c (axal/new[myth] .none).put(p rec)])
          = [r2 c2 sub] acc.at(i)
          ? (and (equal r2 r) (equal c2 c)) acc.take(i).snoc([r2 c2 sub.put(p rec)]).weld(acc.drop(i.inc))
          | _ i.inc
    % i=nat 0 out=axal[myth] (axal/new[myth] tree.fil)
    ^ [myth axal[myth]]
    ? (eq i cells.len) (weft_std/done record out)
    = [r c sub] cells.at(i)
      [items s] (weft_std/keyed sub slot)
      [n rs ng] (? (equal op "count") [(weft_std/rows sub).len 0 .false] (weft_std/reduce op items s))
      rkey (weft_std/key_of r)
      rrec (out.get([rkey])).fall(myth/new)
    | _ i.inc out.put([rkey] rrec.put([(weft_std/key_of c)] (weft_std/num_pail n ng)))
  + flatten
    ' Every record below the root as a child keyed by its path.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | tree.tap.fold (axal/new[myth] tree.fil)
          \ acc [p q]
          ? (eq p.len 0) acc
          | acc.put([(weft_std/dotted p)] q)
    | weft_std/done record out
  ' ---- compare with another view of the same shape
  + other_rows
    ' The rows of the secondary input named by /from (default other).
    \ record=myth
    ^ maybe[row[[path myth]]]
    = from ($ts (weft_std/text_or record ['from] "other"))
    ?> (./some view) (weft_std/view record from) .none
    | ./some (weft_std/rows view)
  + row_key
    ' What identifies a row across two views: the value of /key when
    ' given, else the row's path.
    \ record=myth p=path rec=myth
    ^ maybe[str]
    ?> (./some key) (weft_std/slot record ['key] []) (./some (path_show p))
    ? (eq key.len 0) (./some (path_show p))
    ?> (./some held) (weft_std/at rec p key) .none
    | ./some (weft_std/show_pail held)
  + keys_of
    \ record=myth rows=row[[path myth]]
    ^ row[str]
    = none=row[str] []
    | rows.fold none
      \ acc [p rec]
      ?> (./some k) (weft_std/row_key record p rec) acc
      acc.snoc(k)
  + keep_rows
    ' The input's rows whose key is (present) or is not (absent) among
    ' the other view's rows, under the input root.
    \ record=myth tree=axal[myth] present=bool
    ^ [myth axal[myth]]
    ?> (./some others) (weft_std/other_rows record) (weft_std/missing record tree "Supply a reference to the other view as a slot named by /from (default other)")
    = theirs (weft_std/keys_of record others)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some k) (weft_std/row_key record p rec) (? present acc acc.put(p rec))
          = found (theirs.any((\ x=str (equal x k))))
          ? (eq found present) acc.put(p rec)
          acc
    | weft_std/done record out
  + except
    ' The input's rows that the other view does not have (by /key, else by path).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/keep_rows record tree .false
  + intersect
    ' The input's rows that the other view also has (by /key, else by path).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/keep_rows record tree .true
  + identified
    ' Rows with their identity (the value of /key, else the path as
    ' text); a row without one is left out.
    \ record=myth rows=row[[path myth]]
    ^ row[[str path myth]]
    = none=row[[str path myth]] []
    | rows.fold none
      \ acc [p rec]
      ?> (./some k) (weft_std/row_key record p rec) acc
      acc.snoc([k p rec])
  + find_ident
    ' The first row with that identity.
    \ rows=row[[str path myth]] k=str
    ^ maybe[myth]
    = none=maybe[myth] .none
    | rows.fold none
      \ hit [k2 p rec]
      ? (maybe/is_some hit) hit
      ? (equal k2 k) (./some rec)
      hit
  + slot_diff
    ' The slots that differ between two records of the same row:
    ' <slot>/from holds the other view's value, <slot>/to the input's.
    \ old=myth new=myth
    ^ myth
    = forward
        | new.tap.fold myth/new
          \ acc [slot held]
          ?> (./some was) old.get(slot) acc.put(slot.weld(['to]) held)
          ? (equal (weft_std/show_pail was) (weft_std/show_pail held)) acc
          | acc.put(slot.weld(['from]) was).put(slot.weld(['to]) held)
    | old.tap.fold forward
      \ acc [slot was]
      ? new.has(slot) acc
      acc.put(slot.weld(['from]) was)
  + other_root
    ' The root record of the secondary input named by /from (default
    ' other); an empty record when the view has none.
    \ record=myth
    ^ myth
    = from ($ts (weft_std/text_or record ['from] "other"))
    ?> (./some vt) (weft_std/view record from) myth/new
    | vt.fil.fall(myth/new)
  + diff
    ' The input against the view at /from (default other; a /h view of
    ' the same path works): /added/<row> and /removed/<row> hold the rows
    ' only one side has, /changed/<row> the slots that differ
    ' (<slot>/from, <slot>/to); the two roots' slots as /changed/root
    ' (the input's record against the other view's); the root counts
    ' them.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some others) (weft_std/other_rows record) (weft_std/missing record tree "Supply a reference to the other view as a slot named by /from (default other)")
    = mine (weft_std/identified record (weft_std/rows tree))
      theirs (weft_std/identified record others)
      added=path ['added]
      removed=path ['removed]
      changed=path ['changed]
      start=[nat nat nat axal[myth]] [0 0 0 (axal/new[myth] .none)]
      [a r c out]
        | mine.fold start
          \ acc [k p rec]
          = [a2 r2 c2 o2] acc
          ?> (./some old) (weft_std/find_ident theirs k) [a2.inc r2 c2 o2.put(added.weld(p) rec)]
          = ch (weft_std/slot_diff old rec)
          ? (eq ch.tap.len 0) acc
          | [a2 r2 c2.inc o2.put(changed.weld(p) ch)]
      [r3 out3]
        | theirs.fold [r out]
          \ acc [k p rec]
          = [r2 o2] acc
          ? (maybe/is_some (weft_std/find_ident mine k)) acc
          | [r2.inc o2.put(removed.weld(p) rec)]
      mine_root tree.fil.fall(myth/new)
      root_ch (weft_std/slot_diff (weft_std/other_root record) mine_root)
      [c4 out4]
        ? (eq root_ch.tap.len 0) [c out3]
        | [c.inc out3.put(changed.weld(['root]) root_ch)]
      root (myth/sing ['added] (pails/n a)).put(['removed] (pails/n r3)).put(['changed] (pails/n c4))
    | weft_std/done record (axal/new[myth] (./some root)).uni(out4)
  + merge
    ' The input's children plus every secondary input's children (a later view wins a shared key).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | record.tap.fold (axal/new[myth] tree.fil).uni(tree)
          \ acc [k v]
          ? !(and (gt k.len 1) (eq_iota k.at(0) 'views)) acc
          ?> view=cell_view v acc
          | (weft_std/rows (unpin view.tree)).fold acc
            \ acc2 [p rec]
            | acc2.put(p rec)
    | weft_std/done record out
  ' ---- text
  + text_param
    \ record=myth key=path default=str
    ^ str
    ?> (./some t) (weft_std/text record key) default
    t
  + pieces
    ' A text cut at every occurrence of a separator (a text, not a byte);
    ' an empty separator gives the whole text.
    \ sep=str text=str
    ^ row[str]
    ? (eq sep.len 0) [text]
    % rest=str text out=list[str] .nil
    ^ row[str]
    ? (str/find sep rest)
     > (./some i)
      | _ rest.slice((add i sep.len) (sub rest.len (add i sep.len))) (list/cons[str] rest.slice(0 i) out)
     > .none (list/cons[str] rest out).row.rev
  + join
    ' Each row gains /into: the texts of /slots (space separated) joined by /with (default a space).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = wanted (weft_std/slots record ['slots])
    ? (eq wanted.len 0) (weft_std/missing record tree "Supply /slots: slot paths separated by spaces")
    = sep (weft_std/text_param record ['with] " ")
      into (weft_std/slot record ['into] ['joined]).fall(['joined])
      none=row[str] []
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          = texts
              | wanted.fold none
                \ ts pax
                ?> (./some shown) (weft_std/shown_at rec p pax) ts
                | ts.snoc(shown)
          ? (eq texts.len 0) acc.put(p rec)
          | acc.put(p rec.put(into (pails/t (str/join sep texts))))
    | weft_std/done record out
  + match
    ' The rows whose /key text contains (default), starts with or ends with /value.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = op (weft_std/text_or record ['op] "contains")
      hit
        \ shown=str
        ^ bool
        ? (equal op "starts") (maybe/is_some (str/prefix_at value 0 shown))
        ? (equal op "ends") (and (ge shown.len value.len) (equal[str] shown.slice((sub shown.len value.len) value.len) value))
        | maybe/is_some (str/find value shown)
      kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          ?> (./some held) (weft_std/at rec p key) out
          ? (hit (weft_std/show_pail held)) out.put(p rec)
          out
    | weft_std/done record kept
  + split
    ' Each row gains /into/1, /into/2, ...: its /slot text cut at /with (default a space); /into defaults to the slot.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = sep (weft_std/text_param record ['with] " ")
      into (weft_std/slot record ['into] slot).fall(slot)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some shown) (weft_std/shown_at rec p slot) acc.put(p rec)
          = parts (weft_std/pieces sep shown)
            grown
              % i=nat 0 r=myth rec
              ^ myth
              ? (eq i parts.len) r
              | _ i.inc r.put(into.snoc(($u i.inc)) (pails/t parts.at(i)))
          | acc.put(p grown)
    | weft_std/done record out
  + date
    ' Each row gains /into (default /day): its /slot text date YYYY-MM-DD (anything after the day ignored) as the natural YYYYMMDD.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['day]).fall(['day])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p slot) acc.put(p rec)
          ?> (./some n) (weft_std/ymd (weft_std/show_pail held)) acc.put(p rec)
          | acc.put(p rec.put(into (pails/n n)))
    | weft_std/done record out
  + ymd
    ' "2026-10-16..." as 20261016; nothing when the first ten characters are not a date.
    \ t=str
    ^ maybe[nat]
    ? (lt t.len 10) .none
    = head t.slice(0 10)
      parts head.split_byte(45)
    ? !(eq parts.len 3) .none
    ? !(and (eq parts.at(0).len 4) (and (eq parts.at(1).len 2) (eq parts.at(2).len 2))) .none
    ?> (./some y) (nat/parse parts.at(0)) .none
    ?> (./some m) (nat/parse parts.at(1)) .none
    ?> (./some d) (nat/parse parts.at(2)) .none
    ? ((eq m 0) || ((gt m 12) || ((eq d 0) || (gt d 31)))) .none
    | ./some (add (mul y 10000) (add (mul m 100) d))
  + gather
    ' The input's tree with every secondary input nested under its slot
    ' name: /<slot>/... is that view, root and children.  The way to put
    ' several cells' answers in one tree, and to diff them at once.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = out
        | record.tap.fold tree
          \ acc [k v]
          ? !(and (gt k.len 1) (eq_iota k.at(0) 'views)) acc
          ?> view=cell_view v acc
          = name=path k.drop(1)
          | (unpin view.tree).tap.fold acc.put(name (unpin view.tree).fil.fall(myth/new))
            \ acc2 [p rec]
            | acc2.put(name.weld(p) rec)
    | weft_std/done record out
  ' ---- combine figures
  + arith
    \ record=myth tree=axal[myth] op=str
    ^ [myth axal[myth]]
    ?> (./some left) (weft_std/figure_of record ['left] tree) (weft_std/missing record tree "Supply /left: a number or a slot of the input")
    ?> (./some right) (weft_std/figure_of record ['right] tree) (weft_std/missing record tree "Supply /right: a number or a slot of the input")
    ?> (./some into) (weft_std/slot record ['into] ['result]) (weft_std/missing record tree "Supply /into as a slot path")
    ? (weft_std/arith_op op left right)
     > (./ok fig)
      = [n s ng] fig
      | weft_std/figure record into n s ng
     > (./err why) (weft_std/missing record tree why)
  + add
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "add"
  + subtract
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "subtract"
  + multiply
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "multiply"
  + divide
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/arith record tree "divide"
  + value_in
    ' Any slot: of the input root, or /views/<slot>/<path> of a secondary input.
    \ context=myth pax=path tree=axal[myth]
    ^ maybe[pail]
    ? (and (gt pax.len 2) (eq_iota pax.at(0) 'views))
      ?> (./some other) (weft_std/view context pax.at(1)) .none
      ?> (./some orec) other.fil .none
      | orec.get(pax.drop(2))
    ?> (./some root) tree.fil .none
    | root.get(pax)
  + pick
    ' Copy the slot at /from (of the input root, or /views/<slot>/<path>) to /into on the root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some from) (weft_std/slot record ['from] []) (weft_std/missing record tree "Supply /from")
    ? (eq from.len 0) (weft_std/missing record tree "Supply /from")
    ?> (./some into) (weft_std/slot record ['into] from.drop((? (eq_iota from.at(0) 'views) 2 0))) (weft_std/missing record tree "Supply /into")
    ?> (./some held) (weft_std/value_in record from tree) (weft_std/missing record tree "No value at /from")
    | weft_std/done record (axal/new[myth] (./some tree.fil.fall(myth/new).put(into held)))
  + put
    ' Set /into on the root to the literal /value (a number if it parses, else text).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = held=pail
        ? (nat/parse value)
         > (./some n) (pails/n n)
         > .none (pails/t value)
    | weft_std/done record (axal/new[myth] (./some tree.fil.fall(myth/new).put(into held)))
  + round
    ' Rescale the root's /slot to /places digits (half up), at /into (default: the same slot).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] slot) (weft_std/missing record tree "Supply /into")
    ?> (./some places_text) (weft_std/text record ['places]) (weft_std/missing record tree "Supply /places: how many digits after the point")
    ?> (./some places) (nat/parse places_text) (weft_std/missing record tree "Supply /places as a number")
    = root tree.fil.fall(myth/new)
    ?> (./some fig) (weft_std/slot_figure root slot) (weft_std/missing record tree "No number at /slot")
    = [n s ng] fig
    | weft_std/figure record into (weft_std/rescale n s places) places ng
  ' ---- time
  + since
    ' /slot minus /from (a date or number; a literal or a slot), at /since, in the slot's own unit.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some later) (weft_std/figure_of record ['slot] tree) (weft_std/missing record tree "Supply /slot: a date slot of the input")
    ?> (./some earlier) (weft_std/figure_of record ['from] tree) (weft_std/missing record tree "Supply /from: a date or a slot")
    ?> (./some into) (weft_std/slot record ['into] ['since]) (weft_std/missing record tree "Supply /into")
    = [ln en s lneg eneg] (weft_std/align later earlier)
      [n ng] (weft_std/signed_add ln lneg en (? eneg .false (gt en 0)))
    | weft_std/figure record into n s ng
  + between
    ' The children whose /slot lies within /from and /to (inclusive), under the input root.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some slot) (weft_std/slot record ['slot] []) (weft_std/missing record tree "Supply /slot")
    ? (eq slot.len 0) (weft_std/missing record tree "Supply /slot")
    ?> (./some from) (weft_std/text record ['from]) (weft_std/missing record tree "Supply /from")
    ?> (./some to) (weft_std/text record ['to]) (weft_std/missing record tree "Supply /to")
    = kept
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ out [p rec]
          ?> (./some fig) (weft_std/figure_at rec p slot) out
          ? (and !(weft_std/matches "under" rec p slot from) !(weft_std/matches "over" rec p slot to)) out.put(p rec)
          out
    | weft_std/done record kept
  ' ---- hand edits that survive recomputation
  + amend
    ' Lay the notes at /views/<notes> over the answer.  A note is a
    ' record with /slot, /value, and /case: the input's x case when it
    ' was written.  /slot is a slot of the answer's root ("/revenue"),
    ' or a path into the answer tree with the slot last ("/d1/amount"
    ' corrects one row): the record at that path must exist, or the
    ' note is reported as dangling and nothing is created.  A note whose
    ' case is behind the input's current case still applies, and the
    ' context' says so.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = name ($ts (weft_std/text_or record ['notes] "notes"))
    ?> (./some notes) (weft_std/view record name) (weft_std/missing record tree "Supply a reference to the notes folder as a slot named by /notes")
    = current
        ?> (./some held) record.get(['sys 'tack 'case]) 0
        | (weft_std/nat_of held).fall(0)
      start [record tree]
      laid
        | (weft_std/rows notes).fold start
          \ acc [np nrec]
          = [ctx out] acc
            key (? (eq np.len 1) np.at(0) ($ta (path_show np)))
          ?> (./some slot) (weft_std/slot nrec ['slot] []) acc
          ?> (./some value) nrec.get(['value]) acc
          ? (eq slot.len 0) acc
          = stamp
              ?> (./some held) nrec.get(['case]) 0
              | (weft_std/nat_of held).fall(0)
            ctx2
              ? (eq stamp current) ctx
              | ctx.put(['sys 'view 'note key] (pails/t (str/cat_all ["note at case " (nat/show stamp) ", input now at case " (nat/show current)])))
            at (? (eq slot.len 1) [] slot.take(slot.len.dec))
            leaf (? (eq slot.len 1) slot [slot.at(slot.len.dec)])
          ? (and (gt at.len 0) !(maybe/is_some (out.dip(at)).fil))
            | [ctx.put(['sys 'view 'note key] (pails/t (str/cat_all ["no record at " (path_show at) " in the answer"]))) out]
          = target (out.dip(at)).fil.fall(myth/new)
          | [ctx2 out.put(at target.put(leaf value))]
      [ctx out] laid
    | [ctx.put(['sys 'view 'amended] (pails/n (weft_std/rows notes).len)) out]
  ' ---- judgement: a model's answer, stamped
  + ask
    ' A question (/prompt) put to a model (/model, default the hand's;
    ' a cell without one takes whatever model answered as current)
    ' over the input.  The answer is the stored result record at
    ' /views/result, which the ask hand writes with /answer and the stamp
    ' /case, /model and /prompt, when the stamp matches the input's
    ' current case and this cell's model and prompt.  Otherwise /x is
    ' empty and the context' says the hand is re-asking, at
    ' /sys/view/asking.  Nothing here calls a model: the hand does, and
    ' writes what it computed from.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some prompt) (weft_std/text record ['prompt]) (weft_std/missing record tree "Supply /prompt")
    = model (weft_std/text_or record ['model] "default")
      current
        ?> (./some held) record.get(['sys 'tack 'case]) 0
        | (weft_std/nat_of held).fall(0)
      empty (axal/new[myth] .none)
    ?> (./some result) (weft_std/view record 'result) [record.put(['sys 'view 'asking] (pails/t "no answer yet: the ask hand writes /result")) empty]
    ?> (./some answer) result.fil [record.put(['sys 'view 'asking] (pails/t "no answer yet: the ask hand writes /result")) empty]
    = stamp
        ?> (./some held) answer.get(['case]) 0
        | (weft_std/nat_of held).fall(0)
      same_model ((equal model "default") || (equal (weft_std/text_or answer ['model] "") model))
      same_prompt (equal (weft_std/text_or answer ['prompt] "") prompt)
    ? (and (eq stamp current) (and same_model same_prompt)) [record (axal/new[myth] (./some answer))]
    | [record.put(['sys 'view 'asking] (pails/t (str/cat_all ["re-asking " model ": answer at case " (nat/show stamp) ", input now at case " (nat/show current) (? same_prompt "" ", prompt changed") (? same_model "" ", model changed")]))) empty]
  ' ---- derived numbers on rows
  + put_fig
    ' A figure onto a record at a slot with the slot's own scale, so
    ' the record's other numbers keep theirs; a whole number on a
    ' record that carries /scale says so with <slot>/scale 0.
    \ rec=myth into=path n=nat s=nat neg=bool
    ^ myth
    = scale_seg=iota 'scale
      grown rec.put(into (weft_std/num_pail n neg))
      own=nat
        ?> (./some held) rec.get(['scale]) 0
        | (weft_std/nat_of held).fall(0)
    ? (and (eq s 0) (eq own 0)) grown.del(into.snoc(scale_seg))
    | grown.put(into.snoc(scale_seg) (pails/n s))
  + row_scale
    ' The larger scale of /slot over the rows that carry it.
    \ tree=axal[myth] slot=path
    ^ nat
    | (weft_std/rows tree).fold 0
      \ acc [p rec]
      ?> (./some fig) (weft_std/figure_at rec p slot) acc
      = [n cs neg] fig
      | ? (lt acc cs) cs acc
  + row_slot
    ' A parameter naming a row slot, or the missing text.
    \ record=myth
    ^ either[str path]
    ?> (./some slot) (weft_std/slot record ['slot] []) (./err "Supply /slot")
    ? (eq slot.len 0) (./err "Supply /slot")
    | ./ok slot
  + literal_pail
    ' A literal setting as a value: a number when it parses, else text.
    \ value=str
    ^ pail
    ? (weft_std/literal value)
     > (./some fig)
      = [n s neg] fig
      ? (eq s 0) (weft_std/num_pail n neg)
      | pails/t value
     > .none (pails/t value)
  ' ---- conditional
  + when
    ' Each row gains /into: /then when its /key matches /value under /op
    ' (as where) or its /expr is true, else /else; a row with no /else and no match is left as it is.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some src) (weft_std/text record ['expr]) (weft_std/when_settings record tree)
    ? (weft_std/expr_beside record [['key] ['value] ['op]]) (weft_std/fault record "expr: not beside /key, /value or /op")
    ?> (./some then) (weft_std/text record ['then]) (weft_std/missing record tree "Supply /then")
    ?> (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into as a slot path")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    | weft_std/expr_rows "when" record tree src
  + when_settings
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    ?> (./some then) (weft_std/text record ['then]) (weft_std/missing record tree "Supply /then")
    ?> (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into as a slot path")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    = op (weft_std/text_or record ['op] "equals")
      other (weft_std/text record ['else])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ? (weft_std/matches op rec p key value) acc.put(p rec.put(into (weft_std/literal_pail then)))
          ?> (./some e) other acc.put(p rec)
          | acc.put(p rec.put(into (weft_std/literal_pail e)))
    | weft_std/done record out
  + coalesce
    ' Each row gains /into (default /slot): its /slot when present, else /value.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = into (weft_std/slot record ['into] slot).fall(slot)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p slot) acc.put(p rec.put(into (weft_std/literal_pail value)))
          ? (weft_std/same_path into slot) acc.put(p rec)
          | acc.put(p rec.put(into held))
    | weft_std/done record out
  ' ---- dates: a day is the natural YYYYMMDD
  + leap
    \ y=nat
    ^ bool
    | and (eq (mod y 4) 0) (!(eq (mod y 100) 0) || (eq (mod y 400) 0))
  + month_len
    \ y=nat m=nat
    ^ nat
    ? (eq m 2) (? (weft_std/leap y) 29 28)
    ? ((eq m 4) || ((eq m 6) || ((eq m 9) || (eq m 11)))) 30
    31
  + day_parts
    ' A day as year, month and day when the number spells a real date.
    \ n=nat
    ^ maybe[[nat nat nat]]
    = y (div n 10000)
      m (mod (div n 100) 100)
      d (mod n 100)
    ? ((eq y 0) || ((eq m 0) || ((gt m 12) || ((eq d 0) || (gt d (weft_std/month_len y m)))))) .none
    | ./some [y m d]
  + day_of
    ' A row's day: the number at /slot, or its text date.
    \ rec=myth p=path slot=path
    ^ maybe[[nat nat nat]]
    ?> (./some held) (weft_std/at rec p slot) .none
    ? held
     > n=pails/n (weft_std/day_parts n.n)
     > t=pails/t
      ?> (./some n) (weft_std/ymd t.t) .none
      | weft_std/day_parts n
    .none
  + day_number
    \ y=nat m=nat d=nat
    ^ nat
    | add (mul y 10000) (add (mul m 100) d)
  + days_from_civil
    ' Days since 0000-03-01 in the proleptic Gregorian calendar.
    \ y=nat m=nat d=nat
    ^ nat
    = yy (? (le m 2) y.dec y)
      era (div yy 400)
      yoe (sub yy (mul era 400))
      mp (mod (add m 9) 12)
      doy (add (div (add (mul 153 mp) 2) 5) d.dec)
      doe (sub (add (mul yoe 365) (add (div yoe 4) doy)) (div yoe 100))
    | add (mul era 146097) doe
  + civil_from_days
    \ z=nat
    ^ [nat nat nat]
    = era (div z 146097)
      doe (sub z (mul era 146097))
      yoe (div (sub (add doe (div doe 36524)) (add (div doe 1460) (div doe 146096))) 365)
      y (add yoe (mul era 400))
      doy (sub doe (sub (add (mul 365 yoe) (div yoe 4)) (div yoe 100)))
      mp (div (add (mul 5 doy) 2) 153)
      d (add (sub doy (div (add (mul 153 mp) 2) 5)) 1)
      m (? (lt mp 10) (add mp 3) (sub mp 9))
    | [(? (le m 2) y.inc y) m d]
  + year_day
    ' The day's position in its year, 1 to 366.
    \ y=nat m=nat d=nat
    ^ nat
    % i=nat 1 acc=nat d
    ^ nat
    ? (eq i m) acc
    | _ i.inc (add acc (weft_std/month_len y i))
  + part
    ' Each row gains /into (default /<unit>): a part of its /slot day
    ' by /unit: year, quarter, month, week (sevens from January 1st),
    ' weekday (1 Monday to 7 Sunday).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some unit) (weft_std/text record ['unit]) (weft_std/missing record tree "Supply /unit: year, quarter, month, week or weekday")
    = known ((equal unit "year") || ((equal unit "quarter") || ((equal unit "month") || ((equal unit "week") || (equal unit "weekday")))))
    ? !known (weft_std/missing record tree "Supply /unit: year, quarter, month, week or weekday")
    = into (weft_std/slot record ['into] [($ts unit)]).fall([($ts unit)])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some ymd) (weft_std/day_of rec p slot) acc.put(p rec)
          = [y m d] ymd
            value
              ? (equal unit "year") y
              ? (equal unit "quarter") (add (div m.dec 3) 1)
              ? (equal unit "month") m
              ? (equal unit "week") (add (div (weft_std/year_day y m d).dec 7) 1)
              | add (mod (add (weft_std/days_from_civil y m d) 2) 7) 1
          | acc.put(p rec.put(into (pails/n value)))
    | weft_std/done record out
  + shift
    ' Each row gains /into (default /slot): its /slot day moved by /by
    ' (signed) /unit (day, week, month, year; default day); a month or
    ' year move keeps the day, clamped to the month's length.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some bytext) (weft_std/text record ['by]) (weft_std/missing record tree "Supply /by: a whole number of units, signed")
    ?> (./some byfig) (weft_std/literal bytext) (weft_std/missing record tree "Supply /by as a whole number")
    = [by bs bneg] byfig
    ? !(eq bs 0) (weft_std/missing record tree "Supply /by as a whole number")
    = unit (weft_std/text_or record ['unit] "day")
      known ((equal unit "day") || ((equal unit "week") || ((equal unit "month") || (equal unit "year"))))
    ? !known (weft_std/missing record tree "Supply /unit: day, week, month or year")
    = into (weft_std/slot record ['into] slot).fall(slot)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some ymd) (weft_std/day_of rec p slot) acc.put(p rec)
          ?> (./some moved) (weft_std/move_day ymd unit by bneg) acc.put(p rec)
          = [y m d] moved
          | acc.put(p rec.put(into (pails/n (weft_std/day_number y m d))))
    | weft_std/done record out
  + move_day
    \ ymd=[nat nat nat] unit=str by=nat neg=bool
    ^ maybe[[nat nat nat]]
    = [y m d] ymd
    ? ((equal unit "day") || (equal unit "week"))
      = z (weft_std/days_from_civil y m d)
        step (? (equal unit "week") (mul by 7) by)
      ? (and neg (gt step z)) .none
      | ./some (weft_std/civil_from_days (? neg (sub z step) (add z step)))
    = months (? (equal unit "year") (mul by 12) by)
      total (add (mul y 12) m.dec)
    ? (and neg (gt months total)) .none
    = moved (? neg (sub total months) (add total months))
      y2 (div moved 12)
      m2 (add (mod moved 12) 1)
      cap (weft_std/month_len y2 m2)
    | ./some [y2 m2 (? (gt d cap) cap d)]
  ' ---- cross-row, in row order (sort first)
  + running
    ' Each row with /slot gains /into (default /running): the total so far.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['running]).fall(['running])
      s (weft_std/row_scale tree slot)
      start=[nat bool axal[myth]] [0 .false (axal/new[myth] tree.fil)]
      [tn tneg out]
        | (weft_std/rows tree).fold start
          \ acc [p rec]
          = [an aneg o] acc
          ?> (./some fig) (weft_std/figure_at rec p slot) [an aneg o.put(p rec)]
          = [n cs neg] fig
            [sn sneg] (weft_std/signed_add an aneg (weft_std/rescale n cs s) neg)
          | [sn sneg o.put(p (weft_std/put_fig rec into sn s sneg))]
    | weft_std/done record out
  + rank
    ' Each row gains /into (default /rank): its position, 1, 2, 3.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = into (weft_std/slot record ['into] ['rank]).fall(['rank])
      start=[nat axal[myth]] [0 (axal/new[myth] tree.fil)]
      [i out]
        | (weft_std/rows tree).fold start
          \ acc [p rec]
          = [k o] acc
          | [k.inc o.put(p rec.put(into (pails/n k.inc)))]
    | weft_std/done record out
  + change
    ' Each row with /slot gains /into (default /change): /slot minus the
    ' previous such row's; the first has none.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['change]).fall(['change])
      s (weft_std/row_scale tree slot)
      none=maybe[[nat bool]] .none
      start=[maybe[[nat bool]] axal[myth]] [none (axal/new[myth] tree.fil)]
      [last out]
        | (weft_std/rows tree).fold start
          \ acc [p rec]
          = [prev o] acc
          ?> (./some fig) (weft_std/figure_at rec p slot) [prev o.put(p rec)]
          = [n cs neg] fig
            here (weft_std/rescale n cs s)
          ?> (./some was) prev [(./some [here neg]) o.put(p rec)]
          = [pn pneg] was
            [dn dneg] (weft_std/signed_add here neg pn (? pneg .false (gt pn 0)))
          | [(./some [here neg]) o.put(p (weft_std/put_fig rec into dn s dneg))]
    | weft_std/done record out
  + moving
    ' Each row with /slot gains /into (default /moving): the mean of
    ' /slot over the last /window such rows (default 3), half up.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['moving]).fall(['moving])
      window (weft_std/count_param record ['window] 3)
    ? (eq window 0) (weft_std/missing record tree "Supply /window as a count above zero")
    = s (weft_std/row_scale tree slot)
      none=row[[nat bool]] []
      start=[row[[nat bool]] axal[myth]] [none (axal/new[myth] tree.fil)]
      [last out]
        | (weft_std/rows tree).fold start
          \ acc [p rec]
          = [recent o] acc
          ?> (./some fig) (weft_std/figure_at rec p slot) [recent o.put(p rec)]
          = [n cs neg] fig
            base=row[[nat bool]] (? (lt recent.len window) recent recent.drop(1))
            kept=row[[nat bool]] base.snoc([(weft_std/rescale n cs s) neg])
            zero=[nat bool] [0 .false]
            [tn tneg]
              | kept.fold zero
                \ sum [vn vneg]
                = [an aneg] sum
                | weft_std/signed_add an aneg vn vneg
            mean (div (add tn (div kept.len 2)) kept.len)
          | [kept o.put(p (weft_std/put_fig rec into mean s (and tneg (gt mean 0))))]
    | weft_std/done record out
  + percent
    ' Each row with /slot gains /into (default /percent): its share of
    ' the rows' total, in hundredths of one percent shown as 33.33.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['percent]).fall(['percent])
      [items s] (weft_std/keyed tree slot)
      [tn ts tneg] (weft_std/reduce "sum" items s)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ? (eq tn 0) acc.put(p rec)
          ?> (./some fig) (weft_std/figure_at rec p slot) acc.put(p rec)
          = [n cs neg] fig
            scaled (mul (weft_std/rescale n cs s) 10000)
            share (div (add scaled (div tn 2)) tn)
          | acc.put(p (weft_std/put_fig rec into share 2 (weft_std/xor_sign neg tneg share)))
    | weft_std/done record out
  ' ---- text on rows
  + shown_at
    ' The text of a row's slot as a read shows it: a number with its own
    ' <slot>/scale as its decimal (23.9, not 239); a record-level /scale
    ' shows raw, as a read does; anything else as it compares.
    \ rec=myth p=path slot=path
    ^ maybe[str]
    ?> (./some held) (weft_std/at rec p slot) .none
    = scale_seg=iota 'scale
      plain=maybe[str] (./some (weft_std/show_pail held))
    ?> (./some sc) rec.get(slot.snoc(scale_seg)) plain
    ?> (./some s) (weft_std/nat_of sc) plain
    ?> (./some sn) (weft_std/sign_of held) plain
    = [n neg] sn
    ? (eq s 0) plain
    | ./some (str/cat_all [(? neg "-" "") (weft_std/show_figure n s)])
  + text_rows
    ' Each row's /slot text through a function, at /into.
    \ record=myth tree=axal[myth] slot=path into=path f={\ str}str
    ^ [myth axal[myth]]
    = out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some shown) (weft_std/shown_at rec p slot) acc.put(p rec)
          | acc.put(p rec.put(into (pails/t (f shown))))
    | weft_std/done record out
  + ascii_upper
    \ text=str
    ^ str
    % i=nat 0 out=nat 0
    ? (eq i text.len) (str/from_atom out)
    = byte text.at(i)
      up (? (lt byte 97) byte (? (gt byte 122) byte (sub byte 32)))
    | _ i.inc (add out (lsh up (mul i 8)))
  + trim
    ' Each row gains /into (default /slot): its /slot text without surrounding whitespace.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] slot).fall(slot)
    | weft_std/text_rows record tree slot into str/trim_ascii
  + case
    ' Each row gains /into (default /slot): its /slot text in lower or upper case (/to).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some to) (weft_std/text record ['to]) (weft_std/missing record tree "Supply /to: lower or upper")
    ? !((equal to "lower") || (equal to "upper")) (weft_std/missing record tree "Supply /to: lower or upper")
    = into (weft_std/slot record ['into] slot).fall(slot)
    ? (equal to "lower") (weft_std/text_rows record tree slot into str/ascii_lower)
    | weft_std/text_rows record tree slot into weft_std/ascii_upper
  + replace
    ' Each row gains /into (default /slot): its /slot text with every /find replaced by /with (default nothing).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some find) (weft_std/text record ['find]) (weft_std/missing record tree "Supply /find")
    = with (weft_std/text_param record ['with] "")
      into (weft_std/slot record ['into] slot).fall(slot)
      swap
        \ t=str
        ^ str
        | str/join with (weft_std/pieces find t)
    | weft_std/text_rows record tree slot into swap
  + length
    ' Each row gains /into (default /length): the byte length of its /slot text.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = into (weft_std/slot record ['into] ['length]).fall(['length])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some shown) (weft_std/shown_at rec p slot) acc.put(p rec)
          | acc.put(p rec.put(into (pails/n shown.len)))
    | weft_std/done record out
  + affix
    \ record=myth tree=axal[myth] at_end=bool
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some value) (weft_std/text record ['value]) (weft_std/missing record tree "Supply /value")
    = default=path (? at_end ['ends] ['starts])
      into (weft_std/slot record ['into] default).fall(default)
      hit
        \ shown=str
        ^ bool
        ? at_end (and (ge shown.len value.len) (equal[str] shown.slice((sub shown.len value.len) value.len) value))
        | maybe/is_some (str/prefix_at value 0 shown)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some shown) (weft_std/shown_at rec p slot) acc.put(p rec)
          | acc.put(p rec.put(into (pails/b (hit shown))))
    | weft_std/done record out
  + starts
    ' Each row gains /into (default /starts): whether its /slot text starts with /value.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/affix record tree .false
  + ends
    ' Each row gains /into (default /ends): whether its /slot text ends with /value.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    | weft_std/affix record tree .true
  ' ---- references: pointers between records, resolved in a secondary input
  + view_root
    ' The absolute path a secondary input was cited at: the cell's own
    ' slot of that name holds the reference.
    \ record=myth name=iota
    ^ maybe[path]
    ?> (./some held) record.get([name]) .none
    ?> s=safe held .none
    | ./some s.path
  + view_names
    ' The secondary inputs' names, or the one /from names.
    \ record=myth
    ^ row[iota]
    = from (weft_std/text record ['from])
      none=row[iota] []
    | record.tap.fold none
      \ acc [k v]
      ? !(and (eq k.len 2) (eq_iota k.at(0) 'views)) acc
      ? from
       > (./some f) (? (eq_iota ($ts f) k.at(1)) acc.snoc(k.at(1)) acc)
       > .none acc.snoc(k.at(1))
  + pointed
    ' The record at an absolute path within one of the named views.
    \ record=myth names=row[iota] target=path
    ^ maybe[myth]
    = none=maybe[myth] .none
    | names.fold none
      \ hit name
      ? (maybe/is_some hit) hit
      ?> (./some root) (weft_std/view_root record name) hit
      ? !(pith_prefix root target) hit
      ?> (./some vt) (weft_std/view record name) hit
      | (vt.dip(target.drop(root.len))).fil
  + follow
    ' Each row whose /slot holds a reference gains, under /into (default
    ' the slot), the slots of the record it points at, found in the
    ' secondary input whose root the reference lies under (/from names
    ' one; else the first that fits), read at that view's case.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot: a slot holding a reference")
    = into (weft_std/slot record ['into] slot).fall(slot)
      names (weft_std/view_names record)
    ? (eq names.len 0) (weft_std/missing record tree "Supply a reference to the folder the rows point into, as a slot")
    = out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p slot) acc.put(p rec)
          ?> s=safe held acc.put(p rec)
          ?> (./some target) (weft_std/pointed record names s.path) acc.put(p rec)
          = grown
              | target.tap.fold rec
                \ r [k v]
                | r.put(into.weld(k) v)
          | acc.put(p grown)
    | weft_std/done record out
  + reference
    ' Each row gains /into: a live reference to the row of /views/<from>
    ' (default table) whose /match (default /key) equals its /key; the
    ' one-time step that makes imported keys pointers.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    ?> (./some match) (weft_std/slot record ['match] key) (weft_std/missing record tree "Supply /match as a slot path")
    ?> (./some into) (weft_std/slot record ['into] []) (weft_std/missing record tree "Supply /into as a slot path")
    ? (eq into.len 0) (weft_std/missing record tree "Supply /into")
    = from ($ts (weft_std/text_or record ['from] "table"))
    ?> (./some table) (weft_std/view record from) (weft_std/missing record tree "Supply a reference to the table as a slot named by /from")
    ?> (./some root) (weft_std/view_root record from) (weft_std/missing record tree "Supply a reference to the table as a slot named by /from")
    = rows (weft_std/rows table)
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p key) acc.put(p rec)
          = wanted (weft_std/show_pail held)
            nothing=maybe[path] .none
            found
              | rows.fold nothing
                \ hit [rp rrec]
                ? (maybe/is_some hit) hit
                ?> (./some mh) (weft_std/at rrec rp match) hit
                ? !(equal (weft_std/show_pail mh) wanted) hit
                | ./some rp
          ?> (./some rp) found acc.put(p rec)
          | acc.put(p rec.put(into (safe 0 .x root.weld(rp))))
    | weft_std/done record out
  ' ---- statistics, onto the root
  + stat_slot
    \ record=myth tree=axal[myth] default=path
    ^ either[str [path path row[[nat bool path myth]] nat]]
    ?> (./ok slot) (weft_std/row_slot record) (./err "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] default) (./err "Supply /into as a slot path")
    = [items s] (weft_std/keyed tree slot)
    | ./ok [slot into (weft_std/ranked items .false) s]
  + median
    ' The middle value of /slot over the rows (the mean of the two middles, half up), at /into (default /median).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok found) (weft_std/stat_slot record tree ['median]) (weft_std/missing record tree "Supply /slot")
    = [slot into sorted s] found
      n sorted.len
    ? (eq n 0) (weft_std/figure record into 0 s .false)
    = [an ag p1 r1] sorted.at((div n.dec 2))
      [bn bg p2 r2] sorted.at((div n 2))
      [mn mg] (weft_std/signed_add an ag bn bg)
      half (div (add mn 1) 2)
    | weft_std/figure record into half s (and mg (gt half 0))
  + percentile
    ' The value of /slot at the /at-th percentile (nearest rank), at /into (default /percentile).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = at (weft_std/count_param record ['at] 50)
    ? (gt at 100) (weft_std/missing record tree "Supply /at: 0 to 100")
    ?> (./ok found) (weft_std/stat_slot record tree ['percentile]) (weft_std/missing record tree "Supply /slot")
    = [slot into sorted s] found
      n sorted.len
    ? (eq n 0) (weft_std/figure record into 0 s .false)
    = k0 (div (add (mul at n) 99) 100)
      k (? (eq k0 0) 1 (? (gt k0 n) n k0))
      [vn vg p r] sorted.at(k.dec)
    | weft_std/figure record into vn s vg
  + spread
    ' The sum over the rows of (n times the value minus the total) squared, and n.
    \ items=row[[nat bool path myth]]
    ^ [nat nat]
    = n items.len
      zero=[nat bool] [0 .false]
      [sn sneg]
        | items.fold zero
          \ acc [vn vneg p rec]
          = [an aneg] acc
          | weft_std/signed_add an aneg vn vneg
      num
        | items.fold 0
          \ acc [vn vneg p rec]
          = [dn dneg] (weft_std/signed_add (mul n vn) vneg sn (? sneg .false (gt sn 0)))
          | add acc (mul dn dn)
    | [num n]
  + isqrt
    \ x=nat
    ^ nat
    ? (lt x 2) x
    % r=nat x
    ^ nat
    = next (div (add r (div x r)) 2)
    ? (ge next r) r
    | _ next
  + variance
    ' The population variance of /slot over the rows at the rows' scale, at /into (default /variance).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok found) (weft_std/stat_slot record tree ['variance]) (weft_std/missing record tree "Supply /slot")
    = [slot into sorted s] found
      [num n] (weft_std/spread sorted)
    ? (eq n 0) (weft_std/figure record into 0 s .false)
    = den (mul (mul n (mul n n)) (weft_std/pow10 s))
    | weft_std/figure record into (div (add num (div den 2)) den) s .false
  + stddev
    ' The population standard deviation of /slot over the rows, half up at the rows' scale, at /into (default /stddev).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok found) (weft_std/stat_slot record tree ['stddev]) (weft_std/missing record tree "Supply /slot")
    = [slot into sorted s] found
      [num n] (weft_std/spread sorted)
    ? (eq n 0) (weft_std/figure record into 0 s .false)
    = q (div (mul 4 num) (mul n (mul n n)))
    | weft_std/figure record into (div (add (weft_std/isqrt q) 1) 2) s .false
  + counted
    ' The values /slot takes over the rows, in first-appearance order, with counts.
    \ tree=axal[myth] slot=path
    ^ row[[str pail nat]]
    = none=row[[str pail nat]] []
    | (weft_std/rows tree).fold none
      \ acc [p rec]
      ?> (./some held) (weft_std/at rec p slot) acc
      = shown (weft_std/show_pail held)
      % i=nat 0
      ^ row[[str pail nat]]
      ? (eq i acc.len) acc.snoc([shown held 1])
      = [s2 h2 c2] acc.at(i)
      ? (equal s2 shown) acc.take(i).snoc([s2 h2 c2.inc]).weld(acc.drop(i.inc))
      | _ i.inc
  + mode
    ' The most frequent value of /slot over the rows (the first on a tie), at /into (default /mode).
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    ?> (./some into) (weft_std/slot record ['into] ['mode]) (weft_std/missing record tree "Supply /into as a slot path")
    = groups (weft_std/counted tree slot)
      nothing=maybe[pail] .none
      start=[maybe[pail] nat] [nothing 0]
      [best bestn]
        | groups.fold start
          \ acc [shown held c]
          = [b bn] acc
          ? (gt c bn) [(./some held) c]
          acc
    ?> (./some held) best [record (axal/new[myth] (./some myth/new))]
    | weft_std/root record into held
  ' ---- group and keep the rows
  + group
    ' One folder per value of /key, the rows under it at their own paths.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    = out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p key) acc
          | acc.put(p.cons((weft_std/key_of (weft_std/show_pail held))) rec)
    | weft_std/done record out
  ' ---- reshape slots
  + each_record
    ' A function over the root record and every row's.
    \ tree=axal[myth] f={\ myth}myth
    ^ axal[myth]
    | (weft_std/rows tree).fold (axal/new[myth] tree.fil.run(f))
      \ acc [p rec]
      | acc.put(p (f rec))
  + rename
    ' The slot /from called /to, on the root and every row, its scale with it.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some from) (weft_std/slot record ['from] []) (weft_std/missing record tree "Supply /from")
    ?> (./some to) (weft_std/slot record ['to] []) (weft_std/missing record tree "Supply /to")
    ? ((eq from.len 0) || (eq to.len 0)) (weft_std/missing record tree "Supply /from and /to as slot paths")
    = scale_seg=iota 'scale
      swap
        \ rec=myth
        ^ myth
        ?> (./some held) rec.get(from) rec
        = moved rec.del(from).put(to held)
        ?> (./some sc) rec.get(from.snoc(scale_seg)) moved
        | moved.del(from.snoc(scale_seg)).put(to.snoc(scale_seg) sc)
    | weft_std/done record (weft_std/each_record tree swap)
  + drop
    ' The root and every row without the slots named in /slots (space separated), their scales with them.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = wanted (weft_std/slots record ['slots])
    ? (eq wanted.len 0) (weft_std/missing record tree "Supply /slots: slot paths separated by spaces")
    = scale_seg=iota 'scale
      strip
        \ rec=myth
        ^ myth
        | wanted.fold rec
          \ r pax
          | r.del(pax).del(pax.snoc(scale_seg))
    | weft_std/done record (weft_std/each_record tree strip)
  + unflatten
    ' A child named with underscores lands at the path they spell: the inverse of flatten.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    = none=path []
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ? !(eq p.len 1) acc.put(p rec)
          = name (iota_show p.at(0))
            parts name.split_byte(95)
            deep
              | parts.fold none
                \ acc2 piece
                | acc2.snoc((weft_std/key_of piece))
          | acc.put(deep rec)
    | weft_std/done record out
  + explode
    ' One row per piece of its /slot text cut at /with (default a space): the pieces as rows 1, 2, 3 under the row's name, each the row with its piece at /slot.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./ok slot) (weft_std/row_slot record) (weft_std/missing record tree "Supply /slot")
    = sep (weft_std/text_param record ['with] " ")
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some shown) (weft_std/shown_at rec p slot) acc.put(p rec)
          = parts (weft_std/pieces sep shown)
          % i=nat 0 o=axal[myth] acc
          ^ axal[myth]
          ? (eq i parts.len) o
          | _ i.inc o.put(p.snoc(($u i.inc)) rec.put(slot (pails/t parts.at(i))))
    | weft_std/done record out
  ' ---- checks
  + validate
    ' The rows that break the rule /key /op /value (op as where, or
    ' present: the slot must be there) or whose /expr is false, each
    ' with /reason: /reason when given, else the rule in words.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some src) (weft_std/text record ['expr]) (weft_std/validate_settings record tree)
    ? (weft_std/expr_beside record [['key] ['value] ['op]]) (weft_std/fault record "expr: not beside /key, /value or /op")
    | weft_std/expr_rows "validate" record tree src
  + validate_settings
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    = op (weft_std/text_or record ['op] "equals")
      value (weft_std/text record ['value])
    ? (and !(equal op "present") !(maybe/is_some value)) (weft_std/missing record tree "Supply /value")
    = given value.fall("")
      reason (weft_std/text record ['reason])
      out
        | (weft_std/rows tree).fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          = has (maybe/is_some (weft_std/at rec p key))
            ok (? (equal op "present") has (and has (weft_std/matches op rec p key given)))
          ? ok acc
          = why
              ? reason
               > (./some r) r
               > .none
                ? !has (str/cat_all [(path_show key) " is absent"])
                | str/cat_all [(path_show key) " is not " op " " given]
          | acc.put(p rec.put(['reason] (pails/t why)))
    | weft_std/done record out
  + unique
    ' The rows whose /key value another row shares, each with /count: how many share it.
    \ record=myth tree=axal[myth]
    ^ [myth axal[myth]]
    ?> (./some key) (weft_std/slot record ['key] []) (weft_std/missing record tree "Supply /key as a slot path")
    ? (eq key.len 0) (weft_std/missing record tree "Supply /key")
    = rows (weft_std/rows tree)
      out
        | rows.fold (axal/new[myth] tree.fil)
          \ acc [p rec]
          ?> (./some held) (weft_std/at rec p key) acc
          = mine (weft_std/show_pail held)
            n
              | rows.fold 0
                \ c [p2 rec2]
                ?> (./some h2) (weft_std/at rec2 p2 key) c
                ? (equal (weft_std/show_pail h2) mine) c.inc
                c
          ? (lt n 2) acc
          | acc.put(p rec.put(['count] (pails/n n)))
    | weft_std/done record out
  ' ---- expressions: a rule a chain cannot say, in a slot, parsed once
  ' per read and evaluated per row with the row's slots as the only
  ' variables.  Slot names, scaled signed numbers, quoted text, + - * /,
  ' = != < <= > >=, and or not, in, parens, min max abs round len lower
  ' upper trim contains starts ends; usual precedence.  A slot the row
  ' lacks is a hole on that row; a bad expression is one fault with its
  ' position; division by zero and a number against a text in
  ' arithmetic fault; expr beside the old settings faults.
  + ex
    & weft_std/ex/num
      weft_std/ex/txt
      weft_std/ex/bit
      weft_std/ex/slot
      weft_std/ex/un
      weft_std/ex/bin
      weft_std/ex/call
    + num
      : n=nat s=nat neg=bool
    + txt
      : t=str
    + bit
      : b=bool
    + slot
      : name=iota
    + un
      : op=str a=weft_std/ex
    + bin
      : op=str a=weft_std/ex b=weft_std/ex
    + call
      : f=str args=row[weft_std/ex]
  + ev
    ' A value: a figure, a text, a boolean, or a hole (a slot the row lacks).
    & weft_std/ev/num
      weft_std/ev/txt
      weft_std/ev/bit
      weft_std/ev/hole
    + num
      : n=nat s=nat neg=bool
    + txt
      : t=str
    + bit
      : b=bool
    + hole
      : name=iota
  + tok
    ' The token at a byte offset: its kind (num, txt, id, op, end, bad),
    ' its text, and the offset after it.  Spaces are skipped.
    \ src=str i=nat
    ^ [str str nat]
    ? (ge i src.len) ["end" "" i]
    = b src.at(i)
    ? ((eq b 32) || ((eq b 9) || ((eq b 10) || (eq b 13)))) (weft_std/tok src i.inc)
    ? (weft_std/digit b) (weft_std/tok_num src i)
    ? ((eq b 34) || (eq b 39)) (weft_std/tok_txt src i b)
    ? (weft_std/letter b) (weft_std/tok_id src i)
    = two=str (? (lt i.inc src.len) src.slice(i 2) "")
    ? ((equal two "!=") || ((equal two "<=") || (equal two ">="))) ["op" two (add i 2)]
    = one src.slice(i 1)
    ? ((eq b 43) || ((eq b 45) || ((eq b 42) || ((eq b 47) || ((eq b 61) || ((eq b 60) || ((eq b 62) || ((eq b 40) || ((eq b 41) || (eq b 44)))))))))) ["op" one i.inc]
    ["bad" one i]
  + digit
    \ b=nat
    ^ bool
    | and (ge b 48) (le b 57)
  + letter
    \ b=nat
    ^ bool
    | ((and (ge b 65) (le b 90)) || ((and (ge b 97) (le b 122)) || (eq b 95)))
  + tok_num
    \ src=str i=nat
    ^ [str str nat]
    % j=nat i dotted=bool .false
    ^ [str str nat]
    ? (ge j src.len) ["num" src.slice(i (sub j i)) j]
    = b src.at(j)
    ? (weft_std/digit b) (_ j.inc dotted)
    ? (and (eq b 46) (and !dotted (and (lt j.inc src.len) (weft_std/digit src.at(j.inc))))) (_ j.inc .true)
    ["num" src.slice(i (sub j i)) j]
  + tok_txt
    \ src=str i=nat quote=nat
    ^ [str str nat]
    % j=nat i.inc
    ^ [str str nat]
    ? (ge j src.len) ["bad" "unterminated text" i]
    ? (eq src.at(j) quote) ["txt" src.slice(i.inc (sub j i.inc)) j.inc]
    | _ j.inc
  + tok_id
    \ src=str i=nat
    ^ [str str nat]
    % j=nat i
    ^ [str str nat]
    ? (and (lt j src.len) ((weft_std/letter src.at(j)) || (weft_std/digit src.at(j)))) (_ j.inc)
    ["id" src.slice(i (sub j i)) j]
  + bad_at
    \ what=str i=nat
    ^ either[str [weft_std/ex nat]]
    | ./err (str/cat_all ["expr: " what " at " (nat/show i)])
  + parse
    ' The whole text as one expression, or the fault with its position.
    \ src=str
    ^ either[str weft_std/ex]
    ? (weft_std/parse_or src 0)
     > (./err e) (./err e)
     > (./ok r)
      = [e j] r
        [kind text next] (weft_std/tok src j)
      ? (equal kind "end") (./ok e)
      | ./err (str/cat_all ["expr: unexpected " text " at " (nat/show j)])
  + parse_or
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_and src i)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | weft_std/chain_word src "or" a j
  + parse_and
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_not src i)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | weft_std/chain_word src "and" a j
  + chain_word
    ' a (word b)*, left to right, where word is and or or.
    \ src=str word=str a=weft_std/ex j=nat
    ^ either[str [weft_std/ex nat]]
    = [kind text next] (weft_std/tok src j)
    ? !(and (equal kind "id") (equal text word)) (./ok [a j])
    = below=either[str [weft_std/ex nat]] (? (equal word "or") (weft_std/parse_and src next) (weft_std/parse_not src next))
    ? below
     > (./err e) (./err e)
     > (./ok r)
      = [b k] r
      | weft_std/chain_word src word (./bin word a b) k
  + parse_not
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    = [kind text next] (weft_std/tok src i)
    ? !(and (equal kind "id") (equal text "not")) (weft_std/parse_cmp src i)
    ? (weft_std/parse_not src next)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | ./ok [(./un "not" a) j]
  + parse_cmp
    ' One optional comparison (= != < <= > >= in) between two sums.
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_add src i)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
        [kind text next] (weft_std/tok src j)
        cmp ((and (equal kind "op") ((equal text "=") || ((equal text "!=") || ((equal text "<") || ((equal text "<=") || ((equal text ">") || (equal text ">="))))))) || (and (equal kind "id") (equal text "in")))
      ? !cmp (./ok [a j])
      ? (weft_std/parse_add src next)
       > (./err e) (./err e)
       > (./ok r2)
        = [b k] r2
        | ./ok [(./bin text a b) k]
  + parse_add
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_mul src i)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | weft_std/chain_ops src "+-" a j
  + parse_mul
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_unary src i)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | weft_std/chain_ops src "*/" a j
  + chain_ops
    ' a (op b)*, left to right, for the two operators in ops.
    \ src=str ops=str a=weft_std/ex j=nat
    ^ either[str [weft_std/ex nat]]
    = [kind text next] (weft_std/tok src j)
    ? !(and (equal kind "op") (and (eq text.len 1) ((eq text.at(0) ops.at(0)) || (eq text.at(0) ops.at(1))))) (./ok [a j])
    = below=either[str [weft_std/ex nat]] (? (equal ops "+-") (weft_std/parse_mul src next) (weft_std/parse_unary src next))
    ? below
     > (./err e) (./err e)
     > (./ok r)
      = [b k] r
      | weft_std/chain_ops src ops (./bin text a b) k
  + parse_unary
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    = [kind text next] (weft_std/tok src i)
    ? !(and (equal kind "op") (equal text "-")) (weft_std/parse_primary src i)
    ? (weft_std/parse_unary src next)
     > (./err e) (./err e)
     > (./ok r)
      = [a j] r
      | ./ok [(./un "-" a) j]
  + parse_primary
    \ src=str i=nat
    ^ either[str [weft_std/ex nat]]
    = [kind text next] (weft_std/tok src i)
    ? (equal kind "num")
      ?> (./some fig) (weft_std/literal text) (weft_std/bad_at "a number" i)
      = [n s neg] fig
      | ./ok [(./num n s neg) next]
    ? (equal kind "txt") (./ok [(./txt text) next])
    ? (equal kind "id")
      ? (equal text "true") (./ok [(./bit .true) next])
      ? (equal text "false") (./ok [(./bit .false) next])
      = [k2 t2 n2] (weft_std/tok src next)
      ? (and (equal k2 "op") (equal t2 "(")) (weft_std/parse_call src text n2)
      | ./ok [(./slot ($ts text)) next]
    ? (and (equal kind "op") (equal text "("))
      ? (weft_std/parse_or src next)
       > (./err e) (./err e)
       > (./ok r)
        = [a j] r
          [k3 t3 n3] (weft_std/tok src j)
        ? (and (equal k3 "op") (equal t3 ")")) (./ok [a n3])
        | weft_std/bad_at "a closing paren" j
    ? (equal kind "end") (weft_std/bad_at "a value, not the end" i)
    | weft_std/bad_at (str/cat_all ["a value, not " text]) i
  + parse_call
    ' f( args ): the offset is just after the open paren.
    \ src=str f=str i=nat
    ^ either[str [weft_std/ex nat]]
    = none=row[weft_std/ex] []
      [k0 t0 n0] (weft_std/tok src i)
    ? (and (equal k0 "op") (equal t0 ")")) (./ok [(./call f none) n0])
    % j=nat i args=row[weft_std/ex] none
    ^ either[str [weft_std/ex nat]]
    ? (weft_std/parse_or src j)
     > (./err e) (./err e)
     > (./ok r)
      = [a k] r
        grown args.snoc(a)
        [kind text next] (weft_std/tok src k)
      ? (and (equal kind "op") (equal text ",")) (_ next grown)
      ? (and (equal kind "op") (equal text ")")) (./ok [(./call f grown) next])
      | weft_std/bad_at "a comma or a closing paren" k
  + ev_text
    ' A value as text: a figure as a read shows it, a boolean as true or false.
    \ v=weft_std/ev
    ^ str
    ? v
     > (./num n s neg) (str/cat_all [(? neg "-" "") (weft_std/show_figure n s)])
     > (./txt t) t
     > (./bit b) (? b "true" "false")
     > (./hole name) ""
  + ev_of
    ' A row's slot as a value: a number with its scale, a text, a
    ' boolean, a reference as its spelling, a hole when absent.
    \ rec=myth p=path name=iota
    ^ weft_std/ev
    ?> (./some held) (weft_std/at rec p [name]) (./hole name)
    ? (weft_std/figure_at rec p [name])
     > (./some fig)
      = [n s neg] fig
      | ./num n s neg
     > .none
      ? held
       > b=pails/b (./bit b.b)
      | ./txt (weft_std/show_pail held)
  + eval
    ' Evaluate at a row: a value, or the fault.  A hole anywhere is the
    ' value; a fault names the row.
    \ e=weft_std/ex rec=myth p=path
    ^ either[str weft_std/ev]
    ? e
     > (./num n s neg) (./ok (./num n s neg))
     > (./txt t) (./ok (./txt t))
     > (./bit b) (./ok (./bit b))
     > (./slot name) (./ok (weft_std/ev_of rec p name))
     > (./un op a)
      ? (weft_std/eval a rec p)
       > (./err m) (./err m)
       > (./ok v)
        ? v
         > (./hole name) (./ok v)
         > (./num n s neg) (? (equal op "-") (./ok (./num n s (and !neg (gt n 0)))) (./err "not needs a boolean"))
         > (./bit b) (? (equal op "not") (./ok (./bit !b)) (./err "a text or a boolean cannot be negated"))
         > (./txt t) (./err (? (equal op "-") "a text cannot be negated" "not needs a boolean"))
     > (./bin op a b)
      ? (weft_std/eval a rec p)
       > (./err m) (./err m)
       > (./ok va)
        ? (weft_std/eval b rec p)
         > (./err m) (./err m)
         > (./ok vb) (weft_std/apply_bin op va vb)
     > (./call f args)
      = none=row[weft_std/ev] []
        start=either[str row[weft_std/ev]] (./ok none)
        got
          | args.fold start
            \ acc arg
            ? acc
             > (./err m) (./err m)
             > (./ok vs)
              ? (weft_std/eval arg rec p)
               > (./err m) (./err m)
               > (./ok v) (./ok vs.snoc(v))
      ? got
       > (./err m) (./err m)
       > (./ok vs) (weft_std/apply_call f vs)
  + first_hole
    \ vs=row[weft_std/ev]
    ^ maybe[weft_std/ev]
    = none=maybe[weft_std/ev] .none
    | vs.fold none
      \ hit v
      ? (maybe/is_some hit) hit
      ? v
       > (./hole name) (./some v)
      hit
  + apply_bin
    \ op=str va=weft_std/ev vb=weft_std/ev
    ^ either[str weft_std/ev]
    ?> (./some h) (weft_std/first_hole [va vb]) (weft_std/apply_bin_values op va vb)
    | ./ok h
  + apply_bin_values
    \ op=str va=weft_std/ev vb=weft_std/ev
    ^ either[str weft_std/ev]
    = figs (weft_std/two_figs [va vb])
      arith ((equal op "+") || ((equal op "-") || ((equal op "*") || (equal op "/"))))
      order ((equal op "<") || ((equal op "<=") || ((equal op ">") || (equal op ">="))))
    ? arith (weft_std/bin_arith op figs)
    ? order (weft_std/bin_order op figs)
    ? ((equal op "=") || (equal op "!=")) (weft_std/bin_equal op va vb figs)
    ? ((equal op "and") || (equal op "or")) (weft_std/bin_bool op va vb)
    ? (equal op "in") (weft_std/within va vb)
    | ./err (str/cat_all ["unknown operator " op])
  + bin_arith
    \ op=str figs=maybe[[[nat nat bool] [nat nat bool]]]
    ^ either[str weft_std/ev]
    ?> (./some pair) figs (./err "arithmetic needs two numbers")
    = [fa fb] pair
      name=str (? (equal op "+") "add" (? (equal op "-") "subtract" (? (equal op "*") "multiply" "divide")))
    ? (weft_std/arith_op name fa fb)
     > (./ok fig)
      = [n s neg] fig
      | ./ok (./num n s neg)
     > (./err why) (./err (str/ascii_lower why))
  + bin_order
    \ op=str figs=maybe[[[nat nat bool] [nat nat bool]]]
    ^ either[str weft_std/ev]
    ?> (./some pair) figs (./err "only numbers can be ordered")
    = [fa fb] pair
      c (weft_std/compare fa fb)
      below (eq c 0)
      above (eq c 2)
      hit=bool (? (equal op "<") below (? (equal op "<=") !above (? (equal op ">") above !below)))
    | ./ok (./bit hit)
  + bin_equal
    \ op=str va=weft_std/ev vb=weft_std/ev figs=maybe[[[nat nat bool] [nat nat bool]]]
    ^ either[str weft_std/ev]
    = same=bool
        ? figs
         > (./some pair)
          = [fa fb] pair
          | eq (weft_std/compare fa fb) 1
         > .none (weft_std/same_value va vb)
    | ./ok (./bit (? (equal op "=") same !same))
  + bin_bool
    \ op=str va=weft_std/ev vb=weft_std/ev
    ^ either[str weft_std/ev]
    = why (str/cat_all [op " needs two booleans"])
    ? va
     > (./bit a)
      ? vb
       > (./bit b) (./ok (./bit (? (equal op "and") (and a b) (a || b))))
      | ./err why
    | ./err why
  + within
    ' Is the first value's text inside the second's?
    \ va=weft_std/ev vb=weft_std/ev
    ^ either[str weft_std/ev]
    = needle (weft_std/ev_text va)
      hay (weft_std/ev_text vb)
    | ./ok (./bit (maybe/is_some (str/find needle hay)))
  + same_value
    ' Equality of two values that are not both numbers: texts by their
    ' text, booleans by their truth, different kinds never.
    \ va=weft_std/ev vb=weft_std/ev
    ^ bool
    ? va
     > (./txt a)
      ? vb
       > (./txt b) (equal a b)
      .false
     > (./bit a)
      ? vb
       > (./bit b) (eq a b)
      .false
    .false
  + apply_call
    \ f=str vs=row[weft_std/ev]
    ^ either[str weft_std/ev]
    ?> (./some h) (weft_std/first_hole vs) (weft_std/apply_call_values f vs)
    | ./ok h
  + apply_call_values
    \ f=str vs=row[weft_std/ev]
    ^ either[str weft_std/ev]
    = n vs.len
      two ((equal f "min") || ((equal f "max") || ((equal f "contains") || ((equal f "starts") || ((equal f "ends") || (equal f "round"))))))
      one ((equal f "abs") || ((equal f "len") || ((equal f "lower") || ((equal f "upper") || (equal f "trim")))))
    ? !(two || one) (./err (str/cat_all ["unknown function " f]))
    ? !(eq n (? two 2 1)) (./err (str/cat_all [f " takes " (? two "two arguments" "one argument")]))
    ? ((equal f "min") || (equal f "max"))
      ? (weft_std/two_figs vs)
       > (./some pair)
        = [fa fb] pair
          c (weft_std/compare fa fb)
          [n1 s1 g1] fa
          [n2 s2 g2] fb
          low (? (eq c 2) fb fa)
          high (? (eq c 0) fb fa)
          [rn rs rg] (? (equal f "min") low high)
        | ./ok (./num rn rs rg)
       > .none (./err (str/cat_all [f " needs two numbers"]))
    ? (equal f "round")
      ? (weft_std/two_figs vs)
       > (./some pair)
        = [fa fb] pair
          [n s neg] fa
          [pn ps pneg] fb
        ? (!(eq ps 0) || pneg) (./err "round takes a whole number of places")
        | ./ok (./num (weft_std/rescale n s pn) pn (and neg (gt (weft_std/rescale n s pn) 0)))
       > .none (./err "round needs a number and the places")
    ? (equal f "abs")
      ? vs.at(0)
       > (./num n s neg) (./ok (./num n s .false))
      | ./err "abs needs a number"
    = a (weft_std/ev_text vs.at(0))
    ? (equal f "len") (./ok (./num a.len 0 .false))
    ? (equal f "lower") (./ok (./txt (str/ascii_lower a)))
    ? (equal f "upper") (./ok (./txt (weft_std/ascii_upper a)))
    ? (equal f "trim") (./ok (./txt (str/trim_ascii a)))
    = b (weft_std/ev_text vs.at(1))
    ? (equal f "contains") (./ok (./bit (maybe/is_some (str/find b a))))
    ? (equal f "starts") (./ok (./bit (maybe/is_some (str/prefix_at b 0 a))))
    | ./ok (./bit (and (ge a.len b.len) (equal[str] a.slice((sub a.len b.len) b.len) b)))
  + two_figs
    \ vs=row[weft_std/ev]
    ^ maybe[[[nat nat bool] [nat nat bool]]]
    ? vs.at(0)
     > (./num an as aneg)
      ? vs.at(1)
       > (./num bn bs bneg) (./some [[an as aneg] [bn bs bneg]])
      .none
    .none
  + fault
    ' A cell that cannot run reads unknown; the context says why.
    \ context=myth why=str
    ^ [myth axal[myth]]
    | [context.put(['sys 'view 'fault] (pails/t why)) (axal/new[myth] .none)]
  + expr_beside
    ' Is expr given beside any of the old settings?
    \ record=myth old=row[path]
    ^ bool
    | old.any((\ k=path (maybe/is_some record.get(k))))
  + expr_rows
    ' The four entries over an expression: each (/into = the value),
    ' where (keep when true), when (/into = /then or /else), validate
    ' (keep the rows where the rule fails, with /reason).  A hole on a
    ' row is noted at /sys/view/hole/<row>; where drops the row, each
    ' and when leave it, validate fails it.
    \ mode=str record=myth tree=axal[myth] src=str
    ^ [myth axal[myth]]
    ? (weft_std/parse src)
     > (./err why) (weft_std/fault record why)
     > (./ok e)
      = into (weft_std/slot record ['into] [($ts mode)]).fall([($ts mode)])
        then (weft_std/text record ['then])
        other (weft_std/text record ['else])
        reason (weft_std/text record ['reason])
        start=either[str [myth axal[myth]]] (./ok [record (axal/new[myth] tree.fil)])
        done
          | (weft_std/rows tree).fold start
            \ acc [p rec]
            ? acc
             > (./err why) (./err why)
             > (./ok pair)
              = [ctx out] pair
                key (weft_std/dotted p)
              ? (weft_std/eval e rec p)
               > (./err why) (./err (str/cat_all ["expr: " why " in row " (path_show p)]))
               > (./ok v)
                ? v
                 > (./hole name)
                  = noted ctx.put(['sys 'view 'hole key] (pails/t (str/cat_all [(iota_show name) " is absent"])))
                  ? (equal mode "where") (./ok [noted out])
                  ? (equal mode "validate") (./ok [noted out.put(p rec.put(['reason] (pails/t (str/cat_all [(iota_show name) " is absent"]))))])
                  | ./ok [noted out.put(p rec)]
                 > (./bit b)
                  ? (equal mode "where") (./ok [ctx (? b out.put(p rec) out)])
                  ? (equal mode "validate") (./ok [ctx (? b out out.put(p rec.put(['reason] (pails/t reason.fall(src)))))])
                  ? (equal mode "when")
                    ? b
                      ?> (./some t) then (./err "expr: when needs /then")
                      | ./ok [ctx out.put(p rec.put(into (weft_std/literal_pail t)))]
                    ?> (./some o) other (./ok [ctx out.put(p rec)])
                    | ./ok [ctx out.put(p rec.put(into (weft_std/literal_pail o)))]
                  | ./ok [ctx out.put(p rec.put(into (pails/b b)))]
                 > (./num n s neg)
                  ? (equal mode "each") (./ok [ctx out.put(p (weft_std/put_fig rec into n s neg))])
                  | ./err (str/cat_all ["expr: " mode " needs a boolean, not a number, in row " (path_show p)])
                 > (./txt t)
                  ? (equal mode "each") (./ok [ctx out.put(p rec.put(into (pails/t t)))])
                  | ./err (str/cat_all ["expr: " mode " needs a boolean, not a text, in row " (path_show p)])
      ? done
       > (./err why) (weft_std/fault record why)
       > (./ok pair)
        = [ctx out] pair
        | [ctx out]
  ' ---- the registry
  + by_name
    ' The ctor a standard cell record names.  Records never hold the
    ' closure itself: a closure in the namespace is copied with every
    ' message and made each request forty times slower; a name is a
    ' pail, and travels.
    \ name=iota
    ^ maybe[cell]
    ? (eq_iota name 'count) (./some (cell weft_std/count))
    ? (eq_iota name 'sum) (./some (cell weft_std/sum))
    ? (eq_iota name 'min) (./some (cell weft_std/min))
    ? (eq_iota name 'max) (./some (cell weft_std/max))
    ? (eq_iota name 'avg) (./some (cell weft_std/avg))
    ? (eq_iota name 'any) (./some (cell weft_std/any))
    ? (eq_iota name 'all) (./some (cell weft_std/all))
    ? (eq_iota name 'where) (./some (cell weft_std/where))
    ? (eq_iota name 'sort) (./some (cell weft_std/sort))
    ? (eq_iota name 'top) (./some (cell weft_std/top))
    ? (eq_iota name 'latest) (./some (cell weft_std/latest))
    ? (eq_iota name 'earliest) (./some (cell weft_std/earliest))
    ? (eq_iota name 'each) (./some (cell weft_std/each))
    ? (eq_iota name 'lookup) (./some (cell weft_std/lookup))
    ? (eq_iota name 'distinct) (./some (cell weft_std/distinct))
    ? (eq_iota name 'select) (./some (cell weft_std/select))
    ? (eq_iota name 'by) (./some (cell weft_std/by))
    ? (eq_iota name 'grid) (./some (cell weft_std/grid))
    ? (eq_iota name 'flatten) (./some (cell weft_std/flatten))
    ? (eq_iota name 'merge) (./some (cell weft_std/merge))
    ? (eq_iota name 'gather) (./some (cell weft_std/gather))
    ? (eq_iota name 'join) (./some (cell weft_std/join))
    ? (eq_iota name 'match) (./some (cell weft_std/match))
    ? (eq_iota name 'split) (./some (cell weft_std/split))
    ? (eq_iota name 'date) (./some (cell weft_std/date))
    ? (eq_iota name 'except) (./some (cell weft_std/except))
    ? (eq_iota name 'intersect) (./some (cell weft_std/intersect))
    ? (eq_iota name 'diff) (./some (cell weft_std/diff))
    ? (eq_iota name 'add) (./some (cell weft_std/add))
    ? (eq_iota name 'subtract) (./some (cell weft_std/subtract))
    ? (eq_iota name 'multiply) (./some (cell weft_std/multiply))
    ? (eq_iota name 'divide) (./some (cell weft_std/divide))
    ? (eq_iota name 'pick) (./some (cell weft_std/pick))
    ? (eq_iota name 'put) (./some (cell weft_std/put))
    ? (eq_iota name 'round) (./some (cell weft_std/round))
    ? (eq_iota name 'since) (./some (cell weft_std/since))
    ? (eq_iota name 'between) (./some (cell weft_std/between))
    ? (eq_iota name 'amend) (./some (cell weft_std/amend))
    ? (eq_iota name 'ask) (./some (cell weft_std/ask))
    ? (eq_iota name 'when) (./some (cell weft_std/when))
    ? (eq_iota name 'coalesce) (./some (cell weft_std/coalesce))
    ? (eq_iota name 'part) (./some (cell weft_std/part))
    ? (eq_iota name 'shift) (./some (cell weft_std/shift))
    ? (eq_iota name 'running) (./some (cell weft_std/running))
    ? (eq_iota name 'rank) (./some (cell weft_std/rank))
    ? (eq_iota name 'change) (./some (cell weft_std/change))
    ? (eq_iota name 'moving) (./some (cell weft_std/moving))
    ? (eq_iota name 'percent) (./some (cell weft_std/percent))
    ? (eq_iota name 'trim) (./some (cell weft_std/trim))
    ? (eq_iota name 'case) (./some (cell weft_std/case))
    ? (eq_iota name 'replace) (./some (cell weft_std/replace))
    ? (eq_iota name 'length) (./some (cell weft_std/length))
    ? (eq_iota name 'starts) (./some (cell weft_std/starts))
    ? (eq_iota name 'ends) (./some (cell weft_std/ends))
    ? (eq_iota name 'follow) (./some (cell weft_std/follow))
    ? (eq_iota name 'reference) (./some (cell weft_std/reference))
    ? (eq_iota name 'median) (./some (cell weft_std/median))
    ? (eq_iota name 'percentile) (./some (cell weft_std/percentile))
    ? (eq_iota name 'variance) (./some (cell weft_std/variance))
    ? (eq_iota name 'stddev) (./some (cell weft_std/stddev))
    ? (eq_iota name 'mode) (./some (cell weft_std/mode))
    ? (eq_iota name 'group) (./some (cell weft_std/group))
    ? (eq_iota name 'rename) (./some (cell weft_std/rename))
    ? (eq_iota name 'drop) (./some (cell weft_std/drop))
    ? (eq_iota name 'unflatten) (./some (cell weft_std/unflatten))
    ? (eq_iota name 'explode) (./some (cell weft_std/explode))
    ? (eq_iota name 'validate) (./some (cell weft_std/validate))
    ? (eq_iota name 'unique) (./some (cell weft_std/unique))
    .none
  + record
    ' The record of one standard cell: the ctor's name and a title.
    \ name=iota title=str
    ^ myth
    | (myth/sing bond/weft (pails/q name)).put bond/lede (pails/t title)
  + names
    ^ row[[iota str]]
    [['count "Count the input's children"] ['sum "Sum /slot over the children"] ['min "Smallest /slot"] ['max "Largest /slot"]
     ['avg "Mean of /slot"] ['any "Whether any child has /slot true"] ['all "Whether every child has /slot true"]
     ['where "Keep the children whose /key matches /value under /op"] ['sort "Rank the children by /slot"] ['top "The /count largest by /slot"]
     ['latest "The child with the largest /slot"] ['earliest "The child with the smallest /slot"] ['each "A derived slot per child: /left /op /right into /into"]
     ['lookup "Bring /take from the table row whose /match equals each child's /key"] ['distinct "The values /slot takes, with counts"]
     ['select "Keep only /slots"] ['by "Group by /key, then /op of /slot"] ['grid "Rows by /row, a slot per /col, /op of /slot"]
     ['flatten "Every record below the root as a child keyed by its path"] ['merge "The input's children plus every secondary input's"] ['gather "The input with every secondary input nested under its slot name"]
     ['join "Each row gains /into: its /slots joined by /with"] ['match "The rows whose /key text contains, starts with or ends with /value"]
     ['split "Each row gains /into/1, /into/2: its /slot cut at /with"] ['date "Each row gains /into: its /slot text date as the natural YYYYMMDD"]
     ['except "The rows the view at /from does not have"] ['intersect "The rows the view at /from also has"]
     ['diff "Added, removed and changed rows against the view at /from"]
     ['add "Add"] ['subtract "Subtract"] ['multiply "Multiply"] ['divide "Divide"] ['pick "Copy /from to /into on the root"]
     ['put "Set /into on the root to /value"] ['round "Rescale /slot to /places digits"] ['since "/slot minus /from"]
     ['between "Keep the children whose /slot lies within /from and /to"] ['amend "Lay the notes at /views/notes over the input, with case stamps"]
     ['ask "A model's answer to /prompt over the input, stamped with the input's case; the ask hand writes it"]
     ['when "Each row gains /into: /then when /key matches /value under /op, else /else"] ['coalesce "Each row gains /into: /slot when present, else /value"]
     ['part "Each row gains /into: the /unit (year, quarter, month, week, weekday) of its /slot day"] ['shift "Each row gains /into: its /slot day moved by /by /unit"]
     ['running "Each row gains /into: the total of /slot so far"] ['rank "Each row gains /into: its position"] ['change "Each row gains /into: /slot minus the previous row's"]
     ['moving "Each row gains /into: the mean of /slot over the last /window rows"] ['percent "Each row gains /into: its /slot as a share of the total"]
     ['trim "Each row's /slot text without surrounding whitespace"] ['case "Each row's /slot text in lower or upper case (/to)"]
     ['replace "Each row's /slot text with /find replaced by /with"] ['length "Each row gains /into: the length of its /slot text"]
     ['starts "Each row gains /into: whether its /slot text starts with /value"] ['ends "Each row gains /into: whether its /slot text ends with /value"]
     ['follow "Each row gains, under /into, the record its /slot reference points at, from a secondary input"]
     ['reference "Each row gains /into: a reference to the table row whose /match equals its /key"]
     ['median "The middle value of /slot"] ['percentile "The value of /slot at the /at-th percentile"]
     ['variance "The population variance of /slot"] ['stddev "The population standard deviation of /slot"] ['mode "The most frequent value of /slot"]
     ['group "One folder per value of /key, the rows under it"] ['rename "The slot /from called /to, on the root and every row"]
     ['drop "The root and every row without /slots"] ['unflatten "Children named with underscores at the paths they spell: the inverse of flatten"]
     ['explode "The pieces of /slot cut at /with as rows 1, 2, 3 under the row"] ['validate "The rows that break the rule /key /op /value, each with /reason"]
     ['unique "The rows whose /key value another row shares, each with /count"]]
  + seeds
    ' Boot seeds under /weft/stdlib.
    ^ row[[path myth]]
    = all weft_std/names
      first=row[[path myth]] [[['weft 'stdlib] (myth/sing bond/lede (pails/t "Standard cells"))]]
    | all.fold first
      \ acc [name title]
      | acc.snoc([['weft 'stdlib name] (weft_std/record name title)])
