    = at (row/cons[iota] ($u edge.slot.len) edge.slot).weld(edge.holder)
      card (myth/sing ['holder] (pails/p edge.holder))
      card card.put(['slot] (pails/p edge.slot)).put(['target] edge.target)
    | out.put at card
+  store_page
  \ cr=care c=nat pax=path s=sov
