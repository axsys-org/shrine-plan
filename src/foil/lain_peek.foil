+  r_parse
  ' /r/<target width>/<target...>/<relative edge...>. Lengths delimit names;
  ' no discovery or traversal occurs while parsing the address.
  \ requested=path
  ^ maybe[[target=path relative=path]]
  ? (lt requested.len 2) .none
  ?> (./some width) (dig_of requested.at(1)) .none
  ? ((eq width 0) || (lt requested.len (add width 2))) .none
  | ./some [requested.drop(2).take(width) requested.drop((add width 2))]
+  store_references
  ' The reader's current means this store boundary, including frozen stores.
  ' The result contains edge identities only; it never follows their targets.
  \ state=sov
  ^ {\ path}res[row[reference_edge]]
  \ target=path
  ^ res[row[reference_edge]]
  | reference_index/lookup target 0 state.top state.references
+  reverse_triggers
  \ requested=path
  ^ row[dep]
  ?> (./some address) (r_parse requested) []
  = [target relative] address
  | [(dep .z (r_spell target))]
+  reverse_view
  ' Holders and slots are names, not implicit reads. A target keeps the exact
  ' asserted safe. Content must be separately selected and captured by callers.
  \ target=path reader=namespace_reader
  ^ res[axal[myth]]
  = read_edges reader.references
  ?> (./known edges) (read_edges target) .unknown
  = root (myth/sing ['count] (pails/n edges.len))
  | ./known
  | edges.fold (axal/new[myth] (./some root))
