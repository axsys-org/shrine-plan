-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=31]
'  Namespace interpretation: committed and in-flight reads, historical
'  and derived views, their cases, and their dependency triggers.
'  Pending writes are interpreted here, never accumulated or committed.
+  dig_parse
  '  Compatibility name for the standard decimal codec.
  nat/parse

+  dig_of
  '  A case/len path segment as a nat.  Digit segments arrive as u
  '  u iotas now that URL segments run the aura codec, so only the u
  '  arm remains.
  \  i=iota
  ^  maybe[nat]
  ?  i
   > ($u x=nat)  (./some x)
  .none
+  dig_cord
  '  Compatibility name for the standard decimal codec.
  nat/show

+  dig_show
  '  A nat as a path segment: a u iota, which prints as bare decimal.
  '  (A decimal ts cord would no longer even print — symbols cannot
  '  start with a digit.)
  \  n=nat
  ^  iota
  ($u n)
+  h_care
  '  The care segment of an /h path.
  \  i=iota
  ^  maybe[care]
  ?  (eq_iota i 'x)
     (./some .x)
  ?  (eq_iota i 'y)
     (./some .y)
  ?  (eq_iota i 'z)
     (./some .z)
  .none
+  h_mark
  '  A marker record for structural /h nodes.
  \  d=str
  ^  myth
  =  t myth/new
  t.put(['doc] (pails/t d))
+  epoch_of
  '  An epoch pin is a text segment e<digits>, distinct from a local case.
  \ i=iota
  ^ maybe[nat]
  ? !(is_text i) .none
  = text
      ^ str
      | quip_val i
  ? (lt text.len 2) .none
  ? !(eq 101 text.at(0)) .none
  | nat/parse text.slice(1 text.len.dec)
+  h_parse_fin
  '  The shared tail of h_parse: the len segment, the target, and
  '  the trailing relative segments.
  \  cr=care c=nat ep=nat pax=path
  ^  maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  ?  (dig_of pax.at(3))
   > .none  .none
   > (./some ln=nat)
     =  p pax.drop(4)
     ?  (lt p.len ln)
        .none
     (./some [cr c ep p.take(ln) p.drop(ln)])
+  h_parse
  '  A fully-formed /h care path, split: the care, the case (or the
  '  pinned sovereign epoch — an e<digits> case segment), the
  '  target, and the trailing relative segments.  ep=0 means case
  '  mode; nonzero ep pins the shared epoch clock and c rides 1
  '  (epoch answers are constant like every /h answer: epochs past
  '  the sovereign's top refuse to resolve rather than float).
  '  .none while any level is structural or malformed.  (/h/v is the
  '  version view, not a care — h_peek owns it.)
  \  pax=path
  ^  maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  =  n pax.len
  ?  (lt n 4)
     .none
  ?  (h_care pax.at(1))
   > .none  .none
   > (./some cr=care)
     ?  (dig_of pax.at(2))
      > (./some c=nat)
        ?  (eq c 0)
           .none
        (h_parse_fin cr c 0 pax)
      > .none
        ?  (epoch_of pax.at(2))
         > .none  .none
         > (./some e=nat)
           ?  (eq e 0)
              .none
           (h_parse_fin cr 1 e pax)
+  h_ver
  '  The version view of a path, as of top: its independent local
  '  data and shape counters per care, plus the latest assertion's
  '  mint time and blockheight, as decimal pails/t entries.  Case links are
  '  target-relative and rendered separately by the explorer.
  '  Unlike the case overlays this view is LIVE: it advances as new
  '  cases mint (but never signs — /h is writeless).  ['first] is
  '  the target's first x epoch (0 if never minted) and ['top] the
  '  sovereign's current epoch — the epoch-pin spelling's bounds.
  \  tgt=path s=sov
  ^  axal[myth]
  =  none (axal/new[myth] .none)
  =  h s.hist(tgt)
  =  ev s.ever_at(tgt)
  =  used (add ev.x.lock.data (add ev.y.lock.data ev.z.lock.data))
  ?  (eq 0 used)
     none
  = state=str
      ? (ass/res s.top h)
       > (./known _) "live"
       > .null "tombstone"
       > .unknown "unknown"
    [now block]
      ? (ass/yuga s.top h)
       > (./some yg) [yg.now yg.block]
       > .none [0 0]
    first ev.x.epochs.get(($u 1)).fall(0)
    base myth/new
    record
      | base.gas
      [[['state] (pails/t state)]
       [['x_data] (pails/t ev.x.lock.data.show)]
       [['x_shape] (pails/t ev.x.lock.shape.show)]
       [['y_data] (pails/t ev.y.lock.data.show)]
       [['y_shape] (pails/t ev.y.lock.shape.show)]
       [['z_data] (pails/t ev.z.lock.data.show)]
       [['z_shape] (pails/t ev.z.lock.shape.show)]
       [['now] (pails/t now.show)]
       [['block] (pails/t block.show)]
       [['first] (pails/t first.show)]
       [['top] (pails/t s.top.show)]]
  | axal/new[myth] | ./some record
+  h_prefix
  '  A structural /h node above the target.  Local cases cannot be
  '  resolved until the complete target is known, so case-first
  '  paths deliberately do not enumerate historical children here.
  \  c=nat p=path s=sov
  ^  axal[myth]
  (axal/new[myth] (./some (h_mark "the target path continues below; cases are target-local, so incomplete targets have no historical child listing")))
+  o_parse
  '  A fully-formed /o path, split: the overlay-function case, the
  '  overlay path, the data path, and the trailing relative
  '  segments.  .none while any level is structural or malformed.
  \  pax=path
  ^  maybe[[c=nat op=path dp=path rel=path]]
  =  n pax.len
  ?  (lt n 4)
     .none
  ?  (dig_of pax.at(1))
   > .none  .none
   > (./some c=nat)
     ?  (eq c 0)
        .none
     ?  (dig_of pax.at(2))
      > .none  .none
      > (./some oln=nat)
        =  p pax.drop(3)
        ?  (lt p.len oln)
           .none
        =  q p.drop(oln)
        ?  (eq 0 q.len)
           .none
        ?  (dig_of q.at(0))
         > .none  .none
         > (./some dln=nat)
           =  r q.drop(1)
           ?  (lt r.len dln)
              .none
           (./some [c p.take(oln) r.take(dln) r.drop(dln)])
+  sorge
  '  Restrict a tree to a care: node only, node + direct kids, or all.
  (@ v)
  \  c=care fat=axal[v]
  ^  axal[v]
  ?  c
   > .x  (axal/new[v] fat.fil)
   > .y  (axal/snip[v] fat)
   > .z  fat
+  view
  '  THE derived-namespace resolver: the cr-shaped answer for pax at
  '  case c, where c=0 means latest.  Real paths answer from the
  '  sov's cased queries.  /h paths recurse on their target — so a
  '  target under /o resolves through the lens — and are constant:
  '  they answer only at c=0 or c=1.  /o paths resolve their overlay
  '  function at the pinned case (the opath may itself be derived),
  '  read their data at c through this same resolver — so data under
  '  /h or nested /o composes — apply get, and shape the result by
  '  cr. /x resolves input safe pins from the selected datum case;
  '  reference graphs must be acyclic. Structural markers
  '  live in the peeks, not here: an incomplete derived path is a
  '  shrug.
  \  cr=care c=nat pax=path s=sov
  ^  res[axal[myth]]

  ?  (is_h pax)
     ^ res[axal[myth]]
     >   (./some hp) (h_parse pax)
         .unknown
     ?  (gt c 1)
        .unknown
     =  [hcr hc hep tgt rel]  hp
     =  got=res[axal[myth]]
          ?  hep
             ?  hcr
              > .x
                ?  s.x_at(hep tgt)
                 > (./known t=myth)  (./known (axal/new[myth] (./some t)))
                 > .null  .null
                 > .unknown  .unknown
              > .y  s.y_at(hep tgt)
              > .z  s.z_at(hep tgt)
          (_ hcr hc tgt s)
     >   (./known fat) got
         .unknown
     =  sub  fat.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_o pax)
     ^ res[axal[myth]]
     >   (./some pr) (o_parse pax)
         .unknown
     =  [cpin op dp rel]  pr
     >   (./known wfat) (_ .x cpin op s)
         .unknown
     >   (./some wm) wfat.fil
         .unknown
     >   (./some wf) wm.get(bond/weft)
         .unknown
     =  built=res[axal[myth]]
          ?  wf
           > d=dyed
             >   (./known dt) (_ .x c dp s)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  d.get
             (./known (axal/new[myth] (./some (g t))))
           > k=knit
             >   (./known dt) (_ .x c dp s)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  k.get
             (./known (g t))
           > f=felt
             >   (./known dt) (_ .z c dp s)
                 .unknown
             =  g  f.get
             (./known (axal/new[myth] (./some (g dt))))
           > w=sewn
             >   (./known dt) (_ .z c dp s)
                 .unknown
             =  g  w.get
             (./known (g dt))
           .unknown
     >   (./known bt) built
         .unknown
     =  sub  bt.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_xv pax)
     ?  (lt pax.len 2)
        .unknown
     =  vp  pax.drop(1)
     >   (./known nfat) (_ .x c vp s)
         .unknown
     >   (./some nm) nfat.fil
         .unknown
     >   (./some held) nm.get(bond/weft)
         .unknown
     =  wf=maybe[pail]
          ?  held
           > pin=safe
             = xc=care .x
             ? ((eq 0 pin.ver) || !(equal pin.care xc))
                .none
             >   (./known ft) (_ .x pin.ver pin.path s)
                 .none
             >   (./some fm) ft.fil
                 .none
             fm.get(bond/weft)
           > sp=spun  (./some sp)
          .none
     >   (./some fn) wf
         .unknown
     > sp=spun fn
       .unknown
     >   (./some tk) nm.get(bond/tack)
         .unknown
     > pin=safe tk
       .unknown
     = yc=care .y
     ? ((eq 0 pin.ver) || !(equal pin.care yc))
        .unknown
     >   (./known dt) (_ .y pin.ver pin.path s)
         .unknown
     =  g  sp.get
     (./known (sorge[myth] cr (g nm dt)))

  ?  cr
   > .x
     =  r
          ?  (eq 0 c)
             s.x_latest(pax)
          s.x_query(c pax)
     ?  r
      > (./known t=myth)  (./known (axal/new[myth] (./some t)))
      > .null  .null
      > .unknown  .unknown
   > .y
     ?  (eq 0 c)
        s.y_latest(pax)
     s.y_query(c pax)
   > .z
     ?  (eq 0 c)
        s.z_latest(pax)
     s.z_query(c pax)
+  h_peek
  '  Time travel: /h/care/case/len/...path resolves (care, case)
  '  against the first len path segments via the sov's historical
  '  queries and dips the remainder into the answer.  Structural
  '  levels above the target carry non-enumerating markers because a
  '  local case has no meaning until the target is complete.
  '  Committed-only, and constant: nothing is ever
  '  written under /h, so a given /h path's answer never changes once
  '  known — subscriptions here are throwaway.
  \  pax=path s=sov
  ^  axal[myth]
  =  none (axal/new[myth] .none)
  =  n pax.len
  ?  (lt n 2)
     =  a0 (axal/new[myth] (./some (h_mark "time travel: /h/care/case/len/...path resolves (care, case) against the first len segments of the path and dips the rest into the answer. x is the record, y adds the nearest-live frontier, z the whole subtree. an e<epoch> case segment pins the shared sovereign epoch instead of a target-local case. /h/v/len/...path is the version view. read only.")))
     =  a1 a0.put(['x] (h_mark "x at a case: the record alone"))
     =  a2 a1.put(['y] (h_mark "y at a case: the record and its nearest-live frontier"))
     =  a3 a2.put(['z] (h_mark "z at a case: the whole subtree"))
     a3.put(['v] (h_mark "version info: path-local data and shape counters plus mint time"))
  ?  (eq_iota pax.at(1) 'v)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "below: /len/...path")))
     ?  (dig_of pax.at(2))
      > .none  none
      > (./some ln=nat)
        =  p pax.drop(3)
        ?  (lt p.len ln)
           (h_prefix s.top p s)
        =  tgt p.take(ln)
        =  rel
             =  r0 p.drop(ln)
             %  i=nat 0
                acc=path []
             ?  (eq i r0.len)
                acc
             =  k r0.at(i)
             ?  (dig_of k)
              > (./some cn=nat)  (_ i.inc acc.snoc(($u cn)))
              > .none  (_ i.inc acc.snoc(k))
        =  vt (h_ver tgt s)
        vt.dip(rel)
  ?  (h_care pax.at(1))
   > .none  none
   > (./some cr=care)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "cases are target-local: /h/care/case/len/...target. an e<epoch> case pins the shared sovereign epoch instead.")))
     ?  (dig_of pax.at(2))
      > .none
        ?  (epoch_of pax.at(2))
         > .none  none
         > (./some _)
           ?  (eq n 3)
              (axal/new[myth] (./some (h_mark "below: /len/...path")))
           ?  (view cr 1 pax s)
            > (./known fat=axal[myth])  fat
            > .null  none
            > .unknown  none
      > (./some c=nat)
        ?  (eq c 0)
           none
        ?  (eq n 3)
           (axal/new[myth] (./some (h_mark "below: /len/...path")))
        ?  (dig_of pax.at(3))
         > .none  none
         > (./some ln=nat)
           =  p pax.drop(4)
           ?  (lt p.len ln)
              (h_prefix c p s)
           =  tgt p.take(ln)
           =  rel p.drop(ln)
           ?  (view cr c tgt s)
            > (./known fat=axal[myth])  fat.dip(rel)
            > .null  none
            > .unknown  none
+  o_marks
  '  The structural and shrug answers for an /o path that does not
  '  parse as a complete overlay application: docs at the root,
  '  below-markers at the count levels, non-enumerating prefixes
  '  (exactly like /h), and the empty tree on malformed segments.
  \  pax=path s=sov
  ^  axal[myth]
  =  none (axal/new[myth] .none)
  =  n pax.len
  ?  (lt n 2)
     (axal/new[myth] (./some (h_mark "overlay lens: /o/case/olen/...opath/dlen/...dpath applies the overlay function minted at opath's x case (the /sys/weft slot) to the CURRENT data at dpath. result cases follow the ctor's case algebra: dyed and knit carry the data's x case, felt and sewn its z case. read only.")))
  ?  (dig_of pax.at(1))
   > .none  none
   > (./some c=nat)
     ?  (eq c 0)
        none
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "below: /olen/...opath/dlen/...dpath")))
     ?  (dig_of pax.at(2))
      > .none  none
      > (./some oln=nat)
        =  p pax.drop(3)
        ?  (lt p.len oln)
           (h_prefix c p s)
        =  q p.drop(oln)
        ?  (eq 0 q.len)
           (axal/new[myth] (./some (h_mark "below: /dlen/...dpath")))
        ?  (dig_of q.at(0))
         > .none  none
         > (./some dln=nat)
           =  r q.drop(1)
           ?  (lt r.len dln)
              (h_prefix c r s)
           none
+  o_peek
  '  Overlay lens: /o/case/olen/...opath/dlen/...dpath applies the
  '  overlay function minted at opath's x case `case` (its /sys/weft
  '  slot) to the data at dpath, and dips any remaining segments
  '  into the answer.  The function is pinned by case; the data is
  '  live — or itself derived: dpath may ride /h (pinning the data
  '  too) or another /o (lenses over lenses).  All resolution lives
  '  in /view; this wrapper only adds the browsing markers.
  '  Read-only: writes under /o fail the event.
  \  pax=path s=sov
  ^  axal[myth]
  >   (./some pr) (o_parse pax)
      (o_marks pax s)
  ?  (view .z 0 pax s)
   > (./known fat=axal[myth])  fat
   > .null  (axal/new[myth] .none)
   > .unknown  (axal/new[myth] .none)
+  o_case
  '  The case an overlaid result reports: the ctor's case algebra
  '  maps it back onto the data's own timeline — dyed and knit
  '  results carry dpath's x case, felt and sewn its z case (every
  '  node a knit builds or a sewn moves shares its source's case).
  '  Derived data composes: /h data is constant (case 1), a nested
  '  /o recurses into its own algebra.
  \  pax=path s=sov
  ^  maybe[nat]
  >   (./some pr) (o_parse pax)
      .none
  =  [c op dp rel]  pr
  >   (./known wfat) (view .x c op s)
      .none
  >   (./some wm) wfat.fil
      .none
  >   (./some wf) wm.get(bond/weft)
      .none
  ?  wf
   > d=dyed
     ?  (is_h dp)
        (./some 1)
     ?  (is_o dp)
        (_ dp s)
     s.x_case(dp)
   > k=knit
     ?  (is_h dp)
        (./some 1)
     ?  (is_o dp)
        (_ dp s)
     s.x_case(dp)
   > f=felt
     ?  (is_h dp)
        (./some 1)
     ?  (is_o dp)
        (_ dp s)
     s.z_case(dp)
   > w=sewn
     ?  (is_h dp)
        (./some 1)
     ?  (is_o dp)
        (_ dp s)
     s.z_case(dp)
  .none
+  o_trigger
  '  The real (care, path) deps that DRIVE a derived path's answer:
  '  the ctor's input care at the innermost real data path, plus the
  '  function's own roots when the overlay path is itself derived (a
  '  pinned case on a real path is immutable and needs no trigger;
  '  an unresolvable pin falls back to watching the overlay path's
  '  x, so the eye wakes when the pin mints).  /h legs are constant
  '  and contribute nothing.  Firing on these is conservative: a
  '  data move the overlay ignores still wakes the watcher — lazy
  '  reactivity re-arms by reading.
  \  pax=path s=sov
  ^  row[dep]
  ?  !(is_o pax)
     []
  >   (./some pr) (o_parse pax)
      []
  =  [cpin op dp rel]  pr
  =  me  (_)
     dtri
       \  tc=care
       ^  row[dep]
       ?  (is_h dp)
          []
       ?  (is_o dp)
          (me dp s)
       [(dep tc dp)]
     resolved=maybe[pail]
       ?  (view .x cpin op s)
        > (./known wfat=axal[myth])
          ?  wfat.fil
           > (./some wm=myth)  wm.get(bond/weft)
           > .none  .none
        > .null  .none
        > .unknown  .none
     ftri=row[dep]
       ?  (is_h op)
          []
       ?  (is_o op)
          (me op s)
       ?  ?=((./some _) resolved)
          []
       [(dep .x op)]
  >   (./some wf) resolved
      ftri
  =  dt=row[dep]
       ?  wf
        > d=dyed  (dtri .x)
        > k=knit  (dtri .x)
        > f=felt  (dtri .z)
        > w=sewn  (dtri .z)
       []
  ftri.weld(dt)
+  x_marks
  '  The structural answers for an incomplete /x path: the doc at
  '  the root, the empty tree otherwise (the node path is the whole
  '  tail — there is nothing to enumerate).
  \  pax=path s=sov
  ^  axal[myth]
  ?  (lt pax.len 2)
     (axal/new[myth] (./some (h_mark "view lens: /x/...path evaluates the defining datum's pinned weft and tack (y care). Its own x case identifies the result. Read only.")))
  (axal/new[myth] .none)
+  x_peek
  '  View lens: the derived tree for /x/...path.  All resolution
  '  lives in /view; this wrapper adds the root marker.  Read-only:
  '  writes under /x fail the event.
  \  pax=path s=sov
  ^  axal[myth]
  ?  (lt pax.len 2)
     (x_marks pax s)
  ?  (view .z 0 pax s)
   > (./known fat=axal[myth])  fat
   > .null  (axal/new[myth] .none)
   > .unknown  (axal/new[myth] .none)
+  xv_case
  '  The defining datum's own case is the derived result's case.
  '  Both input pins and the constant arguments belong to that datum.
  \  pax=path s=sov
  ^  maybe[nat]
  ?  !(is_xv pax)
     .none
  ?  (lt pax.len 2)
     .none
  =  vp  pax.drop(1)
  ?  (is_h vp)
     (./some 1)
  ?  (is_o vp)
     (o_case vp s)
  ?  (is_xv vp)
     (_ vp s)
  s.x_case(vp)
+  xv_trigger
  '  Only changes to the defining datum change the derived result.
  '  Updating an input pin is an ordinary write to that datum.
  \  pax=path s=sov
  ^  row[dep]
  ?  !(is_xv pax)
     []
  ?  (lt pax.len 2)
     []
  =  vp  pax.drop(1)
  ?  (is_h vp)
     []
  ?  (is_o vp)
     (o_trigger vp s)
  ?  (is_xv vp)
     (_ vp s)
  [(dep .x vp)]
+  peek
  '  The committed perspective: the subtree at pax as of s.top, piths
  '  relative to pax, no version metadata.  Reads the index directly
  '  (sov z_query is unknown unless pax itself is a node, which would
  '  blind in-flight reads under nodes made this event).
  '  /h and /o paths divert to their overlays.
  \  pax=path s=sov
  ^  axal[myth]
  ?  (is_h pax)
     (h_peek pax s)
  ?  (is_o pax)
     (o_peek pax s)
  ?  (is_xv pax)
     (x_peek pax s)
  =  c s.top
  =  ix s.idx
  =  sub ix.dip(pax)
  =  es sub.tap
  %  i=nat 0
     acc=axal[myth] (axal/new[myth] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  ?  (ass/res c (unpin q.held))
   > (./known t=myth)  (_ i.inc acc.put(p t))
   > .null  (_ i.inc acc)
   > .unknown  (_ i.inc acc)
+  muck
  '  Overlay a pending-note subtree onto a committed subtree (both
  '  relative): make replaces, poke melds (or stands alone), cull
  '  deletes the value.
  \  base=axal[myth] pend=axal[note]
  ^  axal[myth]
  =  es pend.tap
  %  i=nat 0
     acc=axal[myth] base
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  ?  q
   > (./make t=myth)  (_ i.inc acc.put(p t))
   > (./poke t=myth)
     ?  acc.get(p)
      > (./some cur=myth)
        =  m cur.meld(t)
        (_ i.inc acc.put(p m))
      > .none  (_ i.inc acc.put(p t))
   > .cull  (_ i.inc acc.del(p))
+  read
  '  The in-flight perspective: committed state overlaid with the
  '  transaction's pending writes, care-filtered, metadata-free.
  \  c=care pax=path wm=worm s=sov
  ^  axal[myth]
  =  com (peek pax s)
  =  tl wm.toil
  =  pend tl.dip(pax)
  =  wet (muck com pend)
  (sorge[myth] c wet)
+  crew_of
  '  Hydrate each named dependency from the in-flight state.  Missing
  '  records, missing crew slots, and foreign slot values have no crew.
  \ mt=maybe[myth] wm=worm s=sov
  ^ mop[path axal[myth] lt_pith]
  > (./some t) mt
    (mop/empty)
  > (./some held) t.get(crew_slot)
    (mop/empty)
  > deps=cpail held
    (mop/empty)
  | deps.crew.tap.fold (mop/empty)
  \ acc e
  | acc.put e.key
  | read e.val.c e.val.p wm s
+  read_x
  '  Exact-path in-flight read (the dispatch hot path). /h, /o and /x
  '  paths answer from their overlays (committed-only; nothing
  '  pends there).
  \  pax=path wm=worm s=sov
  ^  maybe[myth]
  ?  (is_h pax)
     =  hv (h_peek pax s)
     hv.fil
  ?  (is_o pax)
     =  ov (o_peek pax s)
     ov.fil
  ?  (is_xv pax)
     =  xv (x_peek pax s)
     xv.fil
  =  com=maybe[myth]
       ?  s.x_latest(pax)
        > (./known t=myth)  (./some t)
        > .null  .none
        > .unknown  .none
  =  tl wm.toil
  ?  tl.get(pax)
   > .none  com
   > (./some w=note)
     ?  w
      > (./make t=myth)  (./some t)
      > (./poke t=myth)
        ?  com
         > (./some cur=myth)
           =  m cur.meld(t)
           (./some m)
         > .none  (./some t)
      > .cull  .none
+  exists
  \  pax=path wm=worm s=sov
  ^  bool
  ?  (read_x pax wm s)
   > (./some t=myth)  .true
   > .none  .false
+  x_query_h
  '  Exact committed read, /h-aware: the overlay answers /h paths
  '  (the case rides in the path, so c is ignored there); the sov
  '  answers everything else.
  \  c=nat pax=path s=sov
  ^  res[myth]
  ?  (is_h pax)
     =  hv (h_peek pax s)
     ?  hv.fil
      > (./some t=myth)  (./known t)
      > .none  .unknown
  ?  (is_o pax)
     ?  (view .x c pax s)
      > (./known fat=axal[myth])
        ?  fat.fil
         > (./some t=myth)  (./known t)
         > .none  .unknown
      > .null  .null
      > .unknown  .unknown
  ?  (is_xv pax)
     ?  (view .x c pax s)
      > (./known fat=axal[myth])
        ?  fat.fil
         > (./some t=myth)  (./known t)
         > .none  .unknown
      > .null  .null
      > .unknown  .unknown
  s.x_at(c pax)
+  x_case_h
  '  Version query, /h-aware.  /h nodes are constant: case 1 whenever
  '  they resolve — nothing is ever written under /h, so subscriptions
  '  there never fire and prespecified-case deps are throwaway.
  \  c=nat pax=path s=sov
  ^  maybe[nat]
  ?  (is_h pax)
     =  hv (h_peek pax s)
     ?  hv.fil
      > (./some t=myth)  (./some 1)
      > .none  .none
  ?  (is_o pax)
     =  ov (o_peek pax s)
     ?  ov.fil
      > (./some t=myth)
        >   (./some oc=nat) (o_case pax s)
            (./some 1)
        (./some oc)
      > .none  .none
  ?  (is_xv pax)
     =  xv (x_peek pax s)
     ?  xv.fil
      > (./some t=myth)
        >   (./some xc=nat) (xv_case pax s)
            (./some 1)
        (./some xc)
      > .none  .none
  s.x_case(pax)
