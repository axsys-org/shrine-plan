-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=31]
-  namespace [order=32]
-  weft_std
- graph
'  Namespace interpretation: committed and in-flight reads, historical
'  and derived views, their cases, and their dependency triggers.
'  Pending writes are interpreted here, never accumulated or committed.
+  dig_parse
  '  Compatibility name for the standard decimal codec.
  nat/parse

+  dig_of
  '  A case/len path segment as a nat.  Digit segments arrive as u
  '  u iotas now that URL segments run the aura codec, so only the u
  '  arm remains.
  \  i=iota
  ^  maybe[nat]
  ?  i
   > ($u x=nat)  (./some x)
  .none
+  dig_cord
  '  Compatibility name for the standard decimal codec.
  nat/show

+  dig_show
  '  A nat as a path segment: a u iota, which prints as bare decimal.
  '  (A decimal ts cord would no longer even print — symbols cannot
  '  start with a digit.)
  \  n=nat
  ^  iota
  ($u n)
+  h_care
  '  The care segment of an /h path.
  \  i=iota
  ^  maybe[care]
  ?  (eq_iota i 'x)
     (./some .x)
  ?  (eq_iota i 'y)
     (./some .y)
  ?  (eq_iota i 'z)
     (./some .z)
  .none
+  h_mark
  '  A marker record for structural /h nodes.
  \  d=str
  ^  myth
  =  t myth/new
  t.put(system_vocabulary/help (pails/t d))
+  epoch_of
  '  An epoch pin is a text segment e<digits>, distinct from a local case.
  \ i=iota
  ^ maybe[nat]
  ? !(is_text i) .none
  = text
      ^ str
      | quip_val i
  ? (lt text.len 2) .none
  ? !(eq 101 text.at(0)) .none
  | nat/parse text.slice(1 text.len.dec)
+  h_parse_fin
  '  The shared tail of h_parse: the len segment, the target, and
  '  the trailing relative segments.
  \  cr=care c=nat ep=nat pax=path
  ^  maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  ?  (dig_of pax.at(3))
   > .none  .none
   > (./some ln=nat)
     =  p pax.drop(4)
     ?  (lt p.len ln)
        .none
     (./some [cr c ep p.take(ln) p.drop(ln)])
+  h_parse
  '  A fully-formed /h care path, split: the care, the case (or the
  '  pinned sovereign epoch — an e<digits> case segment), the
  '  target, and the trailing relative segments.  ep=0 means case
  '  mode; nonzero ep pins the shared epoch clock and c rides 1
  '  (epoch answers are constant like every /h answer: epochs past
  '  the sovereign's top refuse to resolve rather than float).
  '  .none while any level is structural or malformed.  (/h/v is the
  '  version view, not a care — h_peek owns it.)
  \  pax=path
  ^  maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  =  n pax.len
  ?  (lt n 4)
     .none
  ?  (h_care pax.at(1))
   > .none  .none
   > (./some cr=care)
     ?  (dig_of pax.at(2))
      > (./some c=nat)
        ?  (eq c 0)
           .none
        (h_parse_fin cr c 0 pax)
      > .none
        ?  (epoch_of pax.at(2))
         > .none  .none
         > (./some e=nat)
           ?  (eq e 0)
              .none
           (h_parse_fin cr 1 e pax)
+  h_ver
  '  The version view of a path, as of top: its independent local
  '  data and shape counters per care, plus the latest assertion's
  '  mint time and blockheight, as decimal pails/t entries.  Case links are
  '  target-relative and rendered separately by the explorer.
  '  Unlike the case overlays this view is LIVE: it advances as new
  '  cases mint (but never signs — /h is writeless).  system_vocabulary/version/first is
  '  the target's first x epoch (0 if never minted) and system_vocabulary/version/top the
  '  sovereign's current epoch — the epoch-pin spelling's bounds.
  \  tgt=path s=sov
  ^  axal[myth]
  =  none (axal/new[myth] .none)
  =  h s.hist(tgt)
  =  ev s.ever_at(tgt)
  =  header (ass/yuga s.top h)
     locks (header.fall((yuga (lock 0 0) (lock 0 0) (lock 0 0) 0 0)))
  =  used (add locks.x.data (add locks.y.data locks.z.data))
  ?  (eq 0 used)
     none
  = state=str
      ? (ass/res s.top h)
       > (./known _) "live"
       > .null "tombstone"
       > .unknown "unknown"
    [now block]
      ? (ass/yuga s.top h)
       > (./some yg) [yg.now yg.block]
       > .none [0 0]
    first (track/epoch 1 ev.x).fall(0)
    base myth/new
    record
      | base.gas
      [[system_vocabulary/version/state (pails/t state)]
       [system_vocabulary/version/x_data (pails/t locks.x.data.show)]
       [system_vocabulary/version/x_shape (pails/t locks.x.shape.show)]
       [system_vocabulary/version/y_data (pails/t locks.y.data.show)]
       [system_vocabulary/version/y_shape (pails/t locks.y.shape.show)]
       [system_vocabulary/version/z_data (pails/t locks.z.data.show)]
       [system_vocabulary/version/z_shape (pails/t locks.z.shape.show)]
       [system_vocabulary/version/now (pails/t now.show)]
       [system_vocabulary/version/block (pails/t block.show)]
       [system_vocabulary/version/first (pails/t first.show)]
       [system_vocabulary/version/top (pails/t s.top.show)]]
  | axal/new[myth] | ./some record
+  h_prefix
  '  A structural /h node above the target.  Local cases cannot be
  '  resolved until the complete target is known, so case-first
  '  paths deliberately do not enumerate historical children here.
  \  c=nat p=path s=sov
  ^  axal[myth]
  (axal/new[myth] (./some (h_mark "the target path continues below; cases are target-local, so incomplete targets have no historical child listing")))
+  o_parse
  '  A fully-formed /o path, split: the overlay-function case, the
  '  overlay path, the data path, and the trailing relative
  '  segments.  .none while any level is structural or malformed.
  \  pax=path
  ^  maybe[[c=nat op=path dp=path rel=path]]
  =  n pax.len
  ?  (lt n 4)
     .none
  ?  (dig_of pax.at(1))
   > .none  .none
   > (./some c=nat)
     ?  (eq c 0)
        .none
     ?  (dig_of pax.at(2))
      > .none  .none
      > (./some oln=nat)
        =  p pax.drop(3)
        ?  (lt p.len oln)
           .none
        =  q p.drop(oln)
        ?  (eq 0 q.len)
           .none
        ?  (dig_of q.at(0))
         > .none  .none
         > (./some dln=nat)
           =  r q.drop(1)
           ?  (lt r.len dln)
              .none
           (./some [c p.take(oln) r.take(dln) r.drop(dln)])
+  read_fuel
  '  Reads one derived read may make, nested cells included; running
  '  out answers unknown and says so.  The ceiling, not a budget: a
  '  well-connected thing as a world opens 150 records and reads each
  '  one's frontier, identities and incoming edges.  A cell declares a
  '  smaller budget of its own at /sys/view/fuel (woven_evaluate_select).
  ^  nat
  32768
+  r_parse
  '  Parse /r/<len>/<target...>/<relative...>: the target whose
  '  references are read, by its length, and the relative segments
  '  that pick one edge (<slot len>/<slot...>/<holder...>).  Length-
  '  prefixed only, like /h and /o: a target is never found by search.
  \  requested=path
  ^  maybe[[target=path relative=path]]
  ?  (lt requested.len 2) .none
  ?> (./some width) (dig_of requested.at(1)) .none
  ?  ((eq width 0) || (lt requested.len (add width 2))) .none
  |  ./some [requested.drop(2).take(width) requested.drop((add width 2))]
+  store_page
  \ cr=care c=nat pax=path s=sov
  ^ res[axal[myth]]
  ?  cr
   > .x
     =  r
          ?  (eq 0 c)
             s.x_latest(pax)
          s.x_query(c pax)
     ?  r
      > (./known t=myth)  (./known (axal/new[myth] (./some t)))
      > .null  .null
      > .unknown  .unknown
   > .y
     ?  (eq 0 c)
        s.y_latest(pax)
     s.y_query(c pax)
   > .z
     ?  (eq 0 c)
        s.z_latest(pax)
     s.z_query(c pax)
+  store_visible
  ' Transparent folders are navigable even without an assertion of their own.
  ' Project their frontier directly for y; do not scan the whole subtree.
  \ cr=care c=nat target=path state=sov
  ^ res[axal[myth]]
  = found (store_page cr c target state)
  ? ((gt c 0) || (equal[care] cr .x)) found
  ? found
   > .unknown
     = records
         ? cr
          > .y (namespace/frontier state.top target state)
         | namespace/records state.top target state
       tree (records.run((\ record (unpin record.myth))))
     ? (and !(maybe/is_some tree.fil) (eq tree.kid.size 0)) .unknown
     | ./known tree
  found
+  namespace_reader
  ' All callbacks receive a fully qualified target. An epoch belongs
  ' to that target's authority; there is no namespace-wide epoch.
  : page={\ care nat path}res[axal[myth]]
    version={\ path}res[axal[myth]] case={\ care path}maybe[nat]
    culled={\ path}bool references={\ nat path}res[row[reference_edge]]
    freeze={\ nat}maybe[namespace_reader] fuel=nat cut=nat trail=row[path]
+  sovereign_reader
  '  A reader over a namespace state: its pages, its references by epoch, its freezes, with the full fuel.
  \ state=namespace
  ^ namespace_reader
  = page
      \ cr=care c=nat target=path
      ^ res[axal[myth]]
      ? (eq target.len 0)
        ? (gt c 0) .unknown
        ? cr
         > .x .unknown
        = records | state.root cr
          values
            | records.run (\ record (unpin record.myth))
        | ./known values
      ?> (./some history) state.history(target) .unknown
      = paged (store_visible cr c target history)
      '  A y or z read of the latest case beneath a record-less prefix
      '  (a folder with children and no record of its own) is the
      '  committed subtree, as sovereign_peek already answers it.
      ? (and (eq c 0) !(?=(.x cr)))
        ? paged
         > .unknown
          = found (sovereign_care cr target state)
          '  An empty answer is a folder emptied (it has a y case) or a
          '  path that never existed (it has none).
          ? (and !(maybe/is_some found.fil) (eq found.kid.size 0))
            ? (maybe/is_some state.local.y_case(target)) (./known found)
            | .unknown
          | ./known found
        paged
      paged
    version
      \ target=path
      ^ res[axal[myth]]
      ? (eq target.len 0) .unknown
      ?> (./some history) state.history(target) .unknown
      | ./known (h_ver target history)
    case
      ' The current case of a path at a care, record or folder.
      \ cr=care target=path
      ^ maybe[nat]
      ?> (./some history) state.history(target) .none
      = read (store_case history)
      | read cr target
    references (store_references state.local)
    freeze
      \ epoch=nat
      ^ maybe[namespace_reader]
      ? ((eq epoch 0) || (gt epoch state.local.top)) .none
      = frozen state.set_local(state.local.set_top(epoch)).set_system((namespace/system_at epoch state))
      | ./some (sovereign_reader frozen).set_cut(epoch)
  | namespace_reader page version case (store_culled state.local) references freeze read_fuel 0 []

+ store_references
  '  The edges that name a target as of an epoch: the index's current edges at 0 or the top epoch, the snapshot at that epoch otherwise, unknown past the kept span or beyond the top.
  \ state=sov
  ^ {\ nat path}res[row[reference_edge]]
  \ epoch=nat target=path
  ^ res[row[reference_edge]]
  ? (gt epoch state.top) .unknown
  = kept state.references.past.tap
    first=nat
      ? (eq kept.len 0) 0
      ?> (./some n) (dig_of kept.at(0).key) 0
      n
  ? (and (gt epoch 0) (lt epoch first)) .unknown
  '  A live read takes the index's current edges; only a pinned epoch unpins
  '  a snapshot.  The snapshot at the top epoch is the current edges anyway,
  '  and unpinning it on every read cost seconds on a long history.
  | ./known (reference_index/beneath target (? ((eq epoch 0) || (ge epoch state.top)) 0 epoch) state.references)

+ reverse_triggers
  '  What a /r read depends on: the index at its target.
  \ requested=path
  ^ row[dep]
  ?> (./some address) (r_parse requested) []
  = [target relative] address
  | [(dep .z (r_spell target))]

+ woven_triggers
  '  What a run depends on: one dependency per observation it made.
  \ answer=view_evaluation
  ^ row[dep]
  | answer.observations.fold []
    \ out observed
    = ref observed.read.source
    ? (gt ref.ver 0) out
    ? (is_h ref.path) out.weld((h_version_triggers ref.path))
    ? (is_r ref.path) out.weld((reverse_triggers ref.path))
    | out.snoc (dep ref.care ref.path)

+ reverse_view
  ' Each edge has an unambiguous address made from its slot width, slot and
  ' holder. The complete target safe is data, so pinned and live links differ.
  \ epoch=nat target=path reader=namespace_reader
  ^ res[axal[myth]]
  = read_edges reader.references
  ?> (./known edges) (read_edges epoch target) .unknown
  = reader (? (eq epoch 0) reader reader.set_cut(epoch))
    root (myth/sing ['count] (pails/n edges.len))
  | ./known
  | edges.fold (axal/new[myth] (./some root))
    \ out edge
    = width=path [($u edge.slot.len)]
      at width.weld(edge.slot).weld(edge.holder)
      record
        | (myth/sing ['holder] (woven_origin (safe 0 .x edge.holder) reader)).put(['slot] (pails/p edge.slot)).put(['target] edge.target)
    | out.put at record
+  is_h_version
  \ target=path
  ^ bool
  ? !(is_h target) .false
  | eq_iota target.at(1) 'v
+  h_version_triggers
  ' Version views are live. Their top field follows the target authority.
  \ requested=path
  ^ row[dep]
  ? !(is_h_version requested) []
  ?> (./some width) (dig_of requested.at(2)) []
  ? ((eq width 0) || (lt requested.len (add width 3))) []
  = target | requested.drop(3).take(width)
  [(dep .z target) (dep .z target.take(1))]
+  resolve_view
  '  THE derived-namespace resolver: the cr-shaped answer for pax at
  '  case c, where c=0 means latest.  Real paths answer from the
  '  sov's cased queries.  /h paths recurse on their target — so a
  '  target under /o resolves through the lens — and are constant:
  '  they answer only at c=0 or c=1.  /o paths resolve their overlay
  '  function at the pinned case (the opath may itself be derived),
  '  read their data at c through this same resolver — so data under
  '  /h or nested /o composes — apply get, and shape the result by
  '  cr. /x resolves input safe pins from the selected datum case;
  '  reference graphs must be acyclic. Structural markers
  '  live in the peeks, not here: an incomplete derived path is a
  '  shrug.
  \  cr=care c=nat pax=path reader=namespace_reader
  ^  res[axal[myth]]
  ? (eq reader.fuel 0) .unknown
  = reader reader.set_fuel(reader.fuel.dec)

  ? (is_r pax)
     ?> (./some address) (r_parse pax) .unknown
     = [target relative] address
     ?> (./known tree) (reverse_view c target reader) .unknown
     = subtree tree.dip(relative)
     ? (and (gt relative.len 0) (and !(maybe/is_some subtree.fil) (eq subtree.kid.size 0))) .unknown
     | ./known (sorge[myth] cr subtree)

  ? (is_h_version pax)
     ^ res[axal[myth]]
     ? (gt c 0) .unknown
     ?> (./some width) (dig_of pax.at(2)) .unknown
     = tail | pax.drop 3
     ? ((eq width 0) || (lt tail.len width)) .unknown
     = target | tail.take width
       relative
         | (tail.drop(width)).map
           \ segment=iota
           ^ iota
           ? (dig_of segment)
            > (./some number) ($u number)
           segment
       read_version reader.version
     ?> (./known values) (read_version target) .unknown
     = selected | values.dip relative
     ? (eq selected.tap.len 0) .unknown
     | ./known (sorge[myth] cr selected)

  ?  (is_h pax)
     ^ res[axal[myth]]
     >   (./some hp) (h_parse pax)
         .unknown
     ?  (gt c 1)
        .unknown
     =  [hcr hc hep tgt rel]  hp
     =  got=res[axal[myth]]
          ? hep
            = freeze reader.freeze
            ?> (./some frozen) (freeze hep) .unknown
            | _ hcr 0 tgt frozen.set_fuel(reader.fuel)
          (_ hcr hc tgt reader)
     >   (./known fat) got
         .unknown
     =  sub  fat.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_o pax)
     ^ res[axal[myth]]
     >   (./some pr) (o_parse pax)
         .unknown
     =  [cpin op dp rel]  pr
     >   (./known wfat) (_ .x cpin op reader)
         .unknown
     >   (./some wm) wfat.fil
         .unknown
     >   (./some wf) wm.get(bond/weft)
         .unknown
     = context wm.put(bond/tack (safe c .z dp))
     ? (woven_start context cr rel reader)
      > (./some plan)
        | (woven_run plan reader).value
     =  built=res[axal[myth]]
          ?  wf
           > d=dyed
             >   (./known dt) (_ .x c dp reader)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  d.get
             (./known (axal/new[myth] (./some (g t))))
           > k=knit
             >   (./known dt) (_ .x c dp reader)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  k.get
             (./known (g t))
           > f=felt
             >   (./known dt) (_ .z c dp reader)
                 .unknown
             =  g  f.get
             (./known (axal/new[myth] (./some (g dt))))
           > w=sewn
             >   (./known dt) (_ .z c dp reader)
                 .unknown
             =  g  w.get
             (./known (g dt))
           > ck=cell (cell_over c op dp wm reader)
           > sp=spun (cell_over c op dp wm reader)
           > q=pails/q (cell_over c op dp wm reader)
           > ref=safe (cell_over c op dp wm reader)
           .unknown
     >   (./known bt) built
         .unknown
     =  sub  bt.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_xv pax)
     ?  (lt pax.len 2)
        .unknown
     ?> (./some address) (cell_address c pax.drop(1) reader) .unknown
     = [root relative] address
     ?> (./known definition) (resolve_view .x c root reader) .unknown
     ?> (./some record) definition.fil .unknown
     ? (woven_start record cr relative reader)
      > (./some plan)
        ? (and (gt c 0) (gt (live_references record).len 0)) .unknown
        | (woven_run plan reader).value
     ?  (cell_run c root reader)
      > (./known pair)
        =  [ctx tree]  pair
        ?  (maybe/is_some ctx.get(['sys 'view 'fault]))
           .unknown
        = subtree tree.dip(relative)
        ? (and (gt relative.len 0) (and !(maybe/is_some subtree.fil) (eq subtree.kid.size 0))) .unknown
        (./known (sorge[myth] cr subtree))
      > .null  .null
     .unknown

  ?  (is_cx pax)
     ?  (lt pax.len 3)
        .unknown
     ?> (./some address) (cell_address c pax.drop(2) reader) .unknown
     = [root relative] address
     ?> (./known definition) (resolve_view .x c root reader) .unknown
     ?> (./some record) definition.fil .unknown
     ? (woven_start record cr relative reader)
      > (./some plan)
        | ./known (sorge[myth] cr (woven_context c root relative record reader))
     ?  (cell_run c root reader)
      > (./known pair)
        =  [ctx tree]  pair
        (./known (sorge[myth] cr (axal/new[myth] (./some ctx))))
      > .null  .null
     .unknown

  = read_page reader.page
  | read_page cr c pax

+  woven_start
  '  Start a plan over the whole selection.
  \ record=myth cr=care relative=path reader=namespace_reader
  ^ maybe[view_plan]
  | woven_start_select record cr relative .all reader

+  woven_start_select
  ' Resolve only the function. Secondary references remain unevaluated until
  ' the computation asks for them; a hidden eager read is not a dependency.
  \ record=myth cr=care relative=path select=view_select reader=namespace_reader
  ^ maybe[view_plan]
  ?> (./some held) record.get(bond/weft) .none
  = function=maybe[pail]
      ? held
       > ref=safe
         ? ((eq ref.ver 0) || !(equal[care] ref.care .x)) .none
         ?> (./known tree) (resolve_view .x ref.ver ref.path reader) .none
         ?> (./some definition) tree.fil .none
         | definition.get bond/weft
      | ./some held
  ?> (./some fn) function .none
  = formula=maybe[woven]
      ? fn
       > w=woven (./some w)
       > q=pails/q (graph/by_name q.q)
      .none
  ?> (./some w) formula .none
  | ./some (w.get record cr relative select)

+  woven_read
  ' Flatten demand cells into observations of their actual inputs. A cached
  ' parent must not rerun its child formula merely to check whether it changed.
  \ request=view_read reader=namespace_reader
  ^ view_evaluation
  ? (eq reader.fuel 0) (view_evaluation .unknown [] 0 "computation read budget exhausted")
  = reader reader.set_fuel(reader.fuel.dec)
    ref request.source
    answer=maybe[view_evaluation]
      ? (is_xv ref.path)
        ?> (./some address) (cell_address ref.ver ref.path.drop(1) reader) .none
        = [root relative] address
        ?> (./known definition) (resolve_view .x ref.ver root reader) .none
        ?> (./some record) definition.fil .none
        ?> (./some plan) (woven_start_select record ref.care relative request.select reader) .none
        | ./some (woven_evaluate_select ref.ver root ref.care relative request.select reader)
      ? (is_o ref.path)
        ?> (./some address) (o_parse ref.path) .none
        = [version definition input relative] address
        ?> (./known tree) (resolve_view .x version definition reader) .none
        ?> (./some record) tree.fil .none
        = context record.put(bond/tack (safe ref.ver .z input))
        ?> (./some plan) (woven_start_select context ref.care relative request.select reader) .none
        ? (reader.trail.any((\ seen=path (equal[path] seen ref.path)))) (./some (view_evaluation .unknown [] 0 "cycle: a reference contains this cell"))
        = evaluated (woven_run_select plan request.select reader.set_trail(reader.trail.snoc(ref.path)))
          definition_read (view_read (safe version .x definition) .all)
          observed (view_observation definition_read (./known tree))
        | ./some evaluated.set_observations(evaluated.observations.cons(observed))
      .none
  ? answer
   > (./some evaluated)
     | evaluated.set_value((view_project request.select evaluated.value))
  = value (view_project request.select (resolve_view ref.care ref.ver ref.path reader))
  | view_evaluation value [(view_observation request value)] 1 (? (?=(.unknown value)) "named input unresolved" "")

+  woven_run
  '  Run a plan over the whole selection.
  \ plan=view_plan reader=namespace_reader
  ^ view_evaluation
  | woven_run_select plan .all reader

+  woven_run_select
  ' The interpreter is schema-independent. Both nested evaluation depth and
  ' the total number of inputs across nested demand cells are bounded.
  \ plan=view_plan select=view_select reader=namespace_reader
  ^ view_evaluation
