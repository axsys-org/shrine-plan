+  sovereign_reader
  '  A reader over a namespace state: its pages and freezes, at the selected history boundary.
  \ state=namespace
  ^ namespace_reader
  = page
      \ cr=care c=nat target=path
      ^ res[axal[myth]]
      ? (eq target.len 0)
        ? (gt c 0) .unknown
        ? cr
         > .x .unknown
        = records | state.root cr
          values
            | records.run (\ record (unpin record.myth))
        | ./known values
      ?> (./some history) state.history(target) .unknown
      | store_visible cr c target history
    epoch
      \ cr=care ep=nat target=path
      ^ res[axal[myth]]
      ?> (./some history) state.history(target) .unknown
      | store_epoch cr ep target history
    version
      \ target=path
      ^ res[axal[myth]]
      ? (eq target.len 0) .unknown
      ?> (./some history) state.history(target) .unknown
      | ./known (h_ver target history)
    case
      ' The current case of a path at a care, record or folder.
      \ cr=care target=path
      ^ maybe[nat]
      ?> (./some history) state.history(target) .none
      = read (store_case history)
      | read cr target
    freeze
      \ epoch=nat
      ^ maybe[namespace_reader]
      ? ((eq epoch 0) || (gt epoch state.local.top)) .none
      ?> (./some publication) (namespace/system_at epoch state) .none
      = frozen state.set_local(state.local.set_top(epoch)).set_system(publication)
