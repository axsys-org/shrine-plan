+  o_parse
  '  A fully-formed /o path, split: the overlay-function case, the
  '  overlay path, the data path, and the trailing relative
  '  segments.  .none while any level is structural or malformed.
  \  pax=path
  ^  maybe[[c=nat op=path dp=path rel=path]]
  =  n pax.len
  ?  (lt n 4)
     .none
  ?  (dig_of pax.at(1))
   > .none  .none
   > (./some c=nat)
     ?  (eq c 0)
        .none
     ?  (dig_of pax.at(2))
      > .none  .none
      > (./some oln=nat)
        =  p pax.drop(3)
        ?  (lt p.len oln)
           .none
        =  q p.drop(oln)
        ?  (eq 0 q.len)
           .none
        ?  (dig_of q.at(0))
         > .none  .none
         > (./some dln=nat)
           =  r q.drop(1)
           ?  (lt r.len dln)
              .none
