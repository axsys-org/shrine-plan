+  is_h_version
  \ target=path
  ^ bool
  ? !(is_h target) .false
  | eq_iota target.at(1) 'v
+  h_version_triggers
  ' Version views are live. Their top field follows the target authority.
  \ requested=path
  ^ row[dep]
  ? !(is_h_version requested) []
  ?> (./some width) (dig_of requested.at(2)) []
  ? ((eq width 0) || (lt requested.len (add width 3))) []
  = target | requested.drop(3).take(width)
  [(dep .z target) (dep .z target.take(1))]
+  resolve_view
  '  THE derived-namespace resolver: the cr-shaped answer for pax at
  '  case c, where c=0 means latest.  Real paths answer from the
  '  sov's cased queries.  /h paths recurse on their target — so a
  '  target under /o resolves through the lens — and are constant:
  '  they answer only at c=0 or c=1.  /o paths resolve their overlay
  '  function at the pinned case (the opath may itself be derived),
  '  read their data at c through this same resolver — so data under
  '  /h or nested /o composes — apply get, and shape the result by
  '  cr. /x resolves input safe pins from the selected datum case;
  '  reference graphs must be acyclic. Structural markers
  '  live in the peeks, not here: an incomplete derived path is a
  '  shrug.
  \  cr=care c=nat pax=path reader=namespace_reader
  ^  res[axal[myth]]

  ? (is_r pax)
     ? (gt c 0) .unknown
     ?> (./some address) (r_parse pax) .unknown
     = [target relative] address
     ?> (./known edges) (reverse_view target reader) .unknown
     = selected edges.dip(relative)
     ? (and !(maybe/is_some selected.fil) (eq selected.kid.size 0)) .unknown
     | ./known (sorge[myth] cr selected)

  ? (is_h_version pax)
     ^ res[axal[myth]]
     ? (gt c 0) .unknown
     ?> (./some width) (dig_of pax.at(2)) .unknown
     = tail | pax.drop 3
     ? ((eq width 0) || (lt tail.len width)) .unknown
     = target | tail.take width
       relative
         | (tail.drop(width)).map
           \ segment=iota
           ^ iota
           ? (dig_of segment)
            > (./some number) ($u number)
           segment
       read_version reader.version
     ?> (./known values) (read_version target) .unknown
     = selected | values.dip relative
     ? (eq selected.tap.len 0) .unknown
     | ./known (sorge[myth] cr selected)

  ?  (is_h pax)
     ^ res[axal[myth]]
     >   (./some hp) (h_parse pax)
         .unknown
     ?  (gt c 1)
        .unknown
     =  [hcr hc hep tgt rel]  hp
     =  got=res[axal[myth]]
          ? hep
            ' Stored history belongs to its target authority and does not
            ' require the publication used to interpret a computation.
            ? !((is_r tgt) || ((is_xv tgt) || ((is_o tgt) || ((is_h tgt) || (is_cx tgt)))))
              = read_epoch reader.epoch
              | read_epoch hcr hep tgt
            = freeze reader.freeze
            ?> (./some frozen) (freeze hep) .unknown
            | _ hcr 0 tgt frozen
          (_ hcr hc tgt reader)
     >   (./known fat) got
         .unknown
     =  sub  fat.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_o pax)
     ^ res[axal[myth]]
     >   (./some pr) (o_parse pax)
         .unknown
     =  [cpin op dp rel]  pr
     >   (./known wfat) (_ .x cpin op reader)
         .unknown
     >   (./some wm) wfat.fil
         .unknown
     >   (./some wf) wm.get(bond/weft)
         .unknown
     =  built=res[axal[myth]]
          ?  wf
           > d=dyed
             >   (./known dt) (_ .x c dp reader)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  d.get
             (./known (axal/new[myth] (./some (g t))))
           > k=knit
             >   (./known dt) (_ .x c dp reader)
                 .unknown
             >   (./some t) dt.fil
                 .unknown
             =  g  k.get
             (./known (g t))
           > f=felt
             >   (./known dt) (_ .z c dp reader)
                 .unknown
             =  g  f.get
             (./known (axal/new[myth] (./some (g dt))))
           > w=sewn
             >   (./known dt) (_ .z c dp reader)
                 .unknown
             =  g  w.get
             (./known (g dt))
           > ck=cell (cell_over c pax dp wm reader)
           > sp=spun (cell_over c pax dp wm reader)
           > q=pails/q (cell_over c pax dp wm reader)
           > ref=safe (cell_over c pax dp wm reader)
           .unknown
     >   (./known bt) built
         .unknown
     =  sub  bt.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_xv pax)
     ?  (lt pax.len 2)
        .unknown
     ?> (./some address) (cell_address c pax.drop(1) reader) .unknown
     = [root relative] address
     ?  (cell_run c root reader)
      > (./known pair)
        =  [ctx tree]  pair
        ?  (maybe/is_some ctx.get(['sys 'view 'fault]))
           .unknown
        = subtree tree.dip(relative)
        ? (and (gt relative.len 0) (and !(maybe/is_some subtree.fil) (eq subtree.kid.size 0))) .unknown
        (./known (sorge[myth] cr subtree))
      > .null  .null
     .unknown

  ?  (is_cx pax)
     ?  (lt pax.len 3)
        .unknown
     ?> (./some address) (cell_address c pax.drop(2) reader) .unknown
     = [root relative] address
     ?  (cell_run c root reader)
      > (./known pair)
        =  [ctx tree]  pair
        (./known (sorge[myth] cr (axal/new[myth] (./some ctx))))
      > .null  .null
     .unknown

  = read_page reader.page
  | read_page cr c pax

+  store_culled
  '  Whether a path is a tombstone now: it was written and then culled,
  '  and nothing has been written there since.  A path never written
  '  is not culled.
  \ s=sov
  ^ {\ path}bool
  \ target=path
  ^ bool
  = h s.hist(target)
  ? (ass/res s.top h)
   > .null .true
  .false
+  store_case
  '  The current case of a path at a care, record or folder.
  \ s=sov
  ^ {\ care path}maybe[nat]
  \ cr=care target=path
  ^ maybe[nat]
  = clocks s.ever_at(target)
    clock
      ? cr
       > .x clocks.x
       > .y clocks.y
      clocks.z
  | track_case_at s.top clock
+ track_case_at
  ' Case clocks are monotone in sovereign epochs. Binary search also works
  ' across sealed history leaves, without replaying or copying the store.
  \ epoch=nat clock=track
  ^ maybe[nat]
  ? (le (track/epoch clock.lock.data clock).fall(0) epoch) (track/case clock)
  % low=nat 0 high=nat clock.lock.data
  ^ maybe[nat]
  ? (eq low high) (? (eq low 0) .none (./some low))
  = middle (div (add (add low high) 1) 2)
    at (track/epoch middle clock).fall(0)
  ? (le at epoch) (_ middle high)
  | _ low middle.dec
+ store_freeze
  '  A reader pinned at an epoch the store still holds, or none.
  \ s=sov
  ^ {\ nat}maybe[namespace_reader]
  \ epoch=nat
  ^ maybe[namespace_reader]
  ? ((eq epoch 0) || (gt epoch s.top)) .none
  | ./some (store_reader s.set_top(epoch))
+  store_reader
  '  A reader over a store's current state.
  \ s=sov
  ^ namespace_reader
  = page
      \ car=care version=nat target=path
      | store_visible car version target s
    epoch
      \ car=care version=nat target=path
      | store_epoch car version target s
    version
      \ target=path
      ^ res[axal[myth]]
      ? (eq target.len 0) .unknown
      | ./known (h_ver target s)
  | namespace_reader page epoch version (store_case s) (store_culled s)
      (store_freeze s) (store_references s)
+  view
  '  Read a view at a care and case through a reader over the store.
  \ cr=care c=nat pax=path s=sov
  ^ res[axal[myth]]
  | resolve_view cr c pax (store_reader s)
+  sovereign_view
  \ cr=care c=nat pax=path state=namespace
  ^ res[axal[myth]]
  | resolve_view cr c pax (sovereign_reader state)
+  h_peek
