  '  (sov z_query is unknown unless pax itself is a node, which would
  '  blind in-flight reads under nodes made this event).
  '  /h and /o paths divert to their overlays.
  \  pax=path s=sov
  ^  axal[myth]
  ? (is_r pax)
     ?> (./known tree) (view .z 0 pax s) (axal/new[myth] .none)
     tree
  ?  (is_h pax)
     (h_peek pax s)
  ?  (is_o pax)
     (o_peek pax s)
  ?  ((is_xv pax) || (is_cx pax))
     (x_peek pax s)
  | s.idx.dip(pax).filter_map
    \ held
    < record (ass/saga s.top (unpin held.held))
    | ./some (unpin record.myth)
+  muck
  '  Overlay a pending-note subtree onto a committed subtree (both
  '  relative): make replaces, poke melds (or stands alone), cull
  '  deletes the value.
  \  base=axal[myth] pend=axal[note]
  ^  axal[myth]
  =  es pend.tap
  %  i=nat 0
     acc=axal[myth] base
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  ?  q
   > (./make t=myth)  (_ i.inc acc.put(p t))
   > (./poke t=myth)
     ?  acc.get(p)
      > (./some cur=myth)
        =  m cur.meld(t)
        (_ i.inc acc.put(p m))
      > .none  (_ i.inc acc.put(p t))
   > .cull  (_ i.inc acc.del(p))
+  read
  '  The in-flight perspective: committed state overlaid with the
  '  transaction's pending writes, care-filtered, metadata-free.
  \  c=care pax=path wm=worm s=sov
  ^  axal[myth]
  =  com (peek pax s)
  =  tl wm.toil
  =  pend tl.dip(pax)
  =  wet (muck com pend)
  (sorge[myth] c wet)
+  history_marker
  \ text=str
  ^ axal[myth]
  (axal/new[myth] (./some (h_mark text)))
+  sovereign_history_prefix
  ' Structural browsing has no assertion or global historical version.
  ' Once a target is complete, the namespace reader selects its authority.
  \ pax=path
  ^ axal[myth]
  = none (axal/new[myth] .none)
    n pax.len
  ? !(is_h pax) none
  ? (eq n 1)
    = root (history_marker "Historical reads use /h/care/case/len/<authority>/...; e<epoch> selects that authority's epoch. /h/v/len/<authority>/... shows current version metadata. Read only.")
      root root.put(['x] (h_mark "record at a target-local case"))
      root root.put(['y] (h_mark "record and nearest-live frontier at a target-local case"))
      root root.put(['z] (h_mark "subtree at a target-local case"))
    root.put(['v] (h_mark "current version metadata for a fully qualified target"))
  = version (eq_iota pax.at(1) 'v)
  ? !version
    ?> (./some _) (h_care pax.at(1)) none
    ? (eq n 2)
      (history_marker "below: /case/len/<authority>/...; e<epoch> selects the target authority's epoch")
    = valid
        ? (dig_of pax.at(2))
         > (./some number) (gt number 0)
        ? (epoch_of pax.at(2))
         > (./some number) (gt number 0)
        .false
    ? !valid none
    ? (eq n 3) (history_marker "below: /len/<authority>/...")
    ?> (./some width) (dig_of pax.at(3)) none
    ? ((eq width 0) || !(lt n (add 4 width))) none
    (history_marker "the fully qualified target continues below; an incomplete target has no historical child listing")
  ? (eq n 2) (history_marker "below: /len/<authority>/...")
  ?> (./some width) (dig_of pax.at(2)) none
  ? ((eq width 0) || !(lt n (add 3 width))) none
  (history_marker "the fully qualified target continues below; the global root has no version")
+  sovereign_peek
  ' Committed subtree access also works beneath unasserted prefixes.
  \ pax=path state=namespace
  ^ axal[myth]
  = structural | sovereign_history_prefix pax
  ? structural.wyt structural
  ? ((is_r pax) || ((is_h pax) || ((is_o pax) || ((is_xv pax) || (is_cx pax)))))
    ? (sovereign_view .z 0 pax state)
     > (./known records) records
    | axal/new[myth] .none
  ? (eq pax.len 0)
    = records | state.root .z
    | records.run (\ record (unpin record.myth))
  ?> (./some history) state.history(pax) (axal/new[myth] .none)
  | peek pax history
+  sovereign_care
  ' Read exact records directly and preserve care at the global root.
  ' Neither operation needs to materialize the discarded descendants.
  \ c=care pax=path state=namespace
  ^ axal[myth]
  ? (eq pax.len 0)
    = records | state.root c
    | records.run (\ record (unpin record.myth))
  ? ?=(.x c)
    ? state.history(pax)
     > (./some history)
       = record=maybe[myth]
           ? history.x_latest(pax)
            > (./known value) (./some value)
           .none
       | axal/new[myth] record
     > .none (sorge[myth] c (sovereign_peek pax state))
  | sorge[myth] c (sovereign_peek pax state)
+  sovereign_read
  ' Pending changes affect permitted local operands only. Derived reads
  ' and the composed root always use the committed namespace.
  \ c=care pax=path wm=worm state=namespace
  ^ axal[myth]
  ? !(state.permitted(pax))
    | sovereign_care c pax state
  ' Exact local reads need only this record's pending note. Descendant
  ' notes cannot change its value, even when its history advances.
  ? ?=(.x c)
    | axal/new[myth] (read_x pax wm state.local)
  = committed | sovereign_peek pax state
  = pending
      | wm.toil.dip(pax).tap.fold (axal/new[note] .none)
        \ out [relative change]
        ? !(state.permitted(pax.weld(relative))) out
        | out.put relative change
  | sorge[myth] c (muck committed pending)
+  sovereign_crew_of
  \ mt=maybe[myth] state=namespace
  ^ mop[path axal[myth] lt_pith]
  ?> (./some record) mt (mop/empty)
  ?> (./some held) record.get(crew_slot) (mop/empty)
  ?> dependencies=cpail held (mop/empty)
  | dependencies.crew.tap.fold (mop/empty)
    \ out entry
    | out.put entry.key
      (sovereign_care entry.val.c entry.val.p state)
+  crew_of
  '  Hydrate each named dependency from committed state.  Missing
  '  records, missing crew slots, and foreign slot values have no crew.
  \ mt=maybe[myth] wm=worm s=sov
  ^ mop[path axal[myth] lt_pith]
  > (./some t) mt
    (mop/empty)
  > (./some held) t.get(crew_slot)
    (mop/empty)
  > deps=cpail held
    (mop/empty)
  | deps.crew.tap.fold (mop/empty)
  \ acc e
  | acc.put e.key
  | sorge[myth] e.val.c (peek e.val.p s)
+  read_x
  '  Exact-path in-flight read (the dispatch hot path). /h, /o and /x
  '  paths answer from their overlays (committed-only; nothing
  '  pends there).
  \  pax=path wm=worm s=sov
  ^  maybe[myth]
  ? (is_r pax)
     ?> (./known tree) (view .x 0 pax s) .none
     tree.fil
  ?  (is_h pax)
     =  hv (h_peek pax s)
     hv.fil
  ?  (is_o pax)
     =  ov (o_peek pax s)
     ov.fil
  ?  ((is_xv pax) || (is_cx pax))
     =  xv (x_peek pax s)
     xv.fil
  =  com=maybe[myth]
       ?  s.x_latest(pax)
        > (./known t=myth)  (./some t)
        > .null  .none
        > .unknown  .none
  =  tl wm.toil
  ?  tl.get(pax)
   > .none  com
   > (./some w=note)
     ?  w
      > (./make t=myth)  (./some t)
      > (./poke t=myth)
        ?  com
         > (./some cur=myth)
           =  m cur.meld(t)
           (./some m)
         > .none  (./some t)
      > .cull  .none
+  exists
  \  pax=path wm=worm s=sov
  ^  bool
  ?  (read_x pax wm s)
   > (./some t=myth)  .true
   > .none  .false
+  x_query_h
  '  Exact committed read, /h-aware: the overlay answers /h paths
  '  (the case rides in the path, so c is ignored there); the sov
  '  answers everything else.
  \  c=nat pax=path s=sov
  ^  res[myth]
  ? (is_r pax)
     ?> (./known tree) (view .x c pax s) .unknown
     ?> (./some record) tree.fil .unknown
     | ./known record
  ?  (is_h pax)
     =  hv (h_peek pax s)
     ?  hv.fil
      > (./some t=myth)  (./known t)
      > .none  .unknown
  ?  (is_o pax)
     ?  (view .x c pax s)
      > (./known fat=axal[myth])
        ?  fat.fil
         > (./some t=myth)  (./known t)
         > .none  .unknown
      > .null  .null
      > .unknown  .unknown
  ?  ((is_xv pax) || (is_cx pax))
     ?  (view .x c pax s)
      > (./known fat=axal[myth])
        ?  fat.fil
         > (./some t=myth)  (./known t)
         > .none  .unknown
      > .null  .null
      > .unknown  .unknown
  s.x_at(c pax)
+  x_case_h
  '  Version query, /h-aware.  /h nodes are constant: case 1 whenever
  '  they resolve — nothing is ever written under /h, so subscriptions
  '  there never fire and prespecified-case deps are throwaway.
  \  c=nat pax=path s=sov
  ^  maybe[nat]
  ? (is_r pax) .none
  ?  (is_h pax)
     =  hv (h_peek pax s)
     ?  hv.fil
      > (./some t=myth)  (./some 1)
      > .none  .none
  ?  (is_o pax)
     =  ov (o_peek pax s)
     ?  ov.fil
      > (./some t=myth)
        >   (./some oc=nat) (o_case pax s)
            (./some 1)
        (./some oc)
      > .none  .none
  ?  ((is_xv pax) || (is_cx pax))
     =  xv (x_peek pax s)
     ?  xv.fil
      > (./some t=myth)
        >   (./some xc=nat) (xv_case pax s)
            (./some 1)
        (./some xc)
      > .none  .none
  s.x_case(pax)
