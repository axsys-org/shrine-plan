  '  against the first len path segments via the sov's historical
  '  queries and dips the remainder into the answer.  Structural
  '  levels above the target carry non-enumerating markers because a
  '  local case has no meaning until the target is complete.
  '  Committed-only, and constant: nothing is ever
  '  written under /h, so a given /h path's answer never changes once
  '  known — subscriptions here are throwaway.
  \  pax=path s=sov
  ^  axal[myth]
  =  none (axal/new[myth] .none)
  =  n pax.len
  ?  (lt n 2)
     =  a0 (axal/new[myth] (./some (h_mark "time travel: /h/care/case/len/...path resolves (care, case) against the first len segments of the path and dips the rest into the answer. x is the record, y adds the nearest-live frontier, z the whole subtree. an e<epoch> case segment pins the shared sovereign epoch instead of a target-local case. /h/v/len/...path is the version view. read only.")))
     =  a1 a0.put(['x] (h_mark "x at a case: the record alone"))
     =  a2 a1.put(['y] (h_mark "y at a case: the record and its nearest-live frontier"))
     =  a3 a2.put(['z] (h_mark "z at a case: the whole subtree"))
     a3.put(['v] (h_mark "version info: path-local data and shape counters plus mint time"))
  ?  (eq_iota pax.at(1) 'v)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "below: /len/...path")))
     ?  (dig_of pax.at(2))
      > .none  none
      > (./some ln=nat)
        =  p pax.drop(3)
        ?  (lt p.len ln)
           (h_prefix s.top p s)
        =  tgt p.take(ln)
        =  rel
             =  r0 p.drop(ln)
             %  i=nat 0
                acc=path []
             ?  (eq i r0.len)
                acc
             =  k r0.at(i)
             ?  (dig_of k)
              > (./some cn=nat)  (_ i.inc acc.snoc(($u cn)))
              > .none  (_ i.inc acc.snoc(k))
        =  vt (h_ver tgt s)
        vt.dip(rel)
  ?  (h_care pax.at(1))
   > .none  none
   > (./some cr=care)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "cases are target-local: /h/care/case/len/...target. an e<epoch> case pins the shared sovereign epoch instead.")))
     ?  (dig_of pax.at(2))
      > .none
        ?  (epoch_of pax.at(2))
         > .none  none
         > (./some _)
           ?  (eq n 3)
              (axal/new[myth] (./some (h_mark "below: /len/...path")))
           ?  (view cr 1 pax s)
            > (./known fat=axal[myth])  fat
            > .null  none
            > .unknown  none
      > (./some c=nat)
        ?  (eq c 0)
