- shrine_types

+ commitment
  ' A checker is retained from the approved basis, never supplied by the
  ' candidate being assessed. Its closure can retain exact demonstration data.
  + retained
    (@@ implementation)
    : key=path scope=path statement=str provenance=str approved_at=nat
      check={\ implementation}commitment/verdict

  + verdict
    & commitment/verdict/holding
      commitment/verdict/failed
      commitment/verdict/unknown
    + holding :
    + failed : reason=str
    + unknown : reason=str

  + finding
    : key=path scope=path statement=str provenance=str verdict=commitment/verdict

  + assess
    (@ implementation)
    \ retained=row[commitment/retained[implementation]] proposed=implementation
    ^ row[commitment/finding]
    | retained.map
      \ item=commitment/retained[implementation]
      = check item.check
        result=commitment/verdict
          ? (Try[implementation commitment/verdict] check proposed)
           > (./ok verdict) verdict
           > (./err _) (commitment/verdict/unknown "The retained checker could not complete.")
      | commitment/finding item.key item.scope item.statement item.provenance result

  + holds
    \ finding=commitment/finding
    ^ bool
    ? finding.verdict
     > .holding .true
    .false

  + admissible
    ' Complete means the declared affected domain was fully examined.
    ' Unknown, failed, thrown and resource-limited checks never authorize.
    \ complete=bool findings=row[commitment/finding]
    ^ bool
    | and complete (findings.all(commitment/holds))

  + unique
    (@ implementation)
    \ retained=row[commitment/retained[implementation]]
    ^ bool
    % i=nat 0
    ? (eq i retained.len) .true
    = key retained.at(i).key
    ? (row/any[commitment/retained[implementation]] (\ item=commitment/retained[implementation] (equal item.key key)) retained.drop(i.inc)) .false
    | _ i.inc
