-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_web_policy_result [order=60]
'  Quarantined compatibility policy for the remaining Shrine window content.
'  It stays a legacy terminal branch set rather than becoming Foundry IR.
+  chat_foundry_web_policy_outer_content
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'shrine 'title] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span" [(weft/cls "window-title")]
            [(weft/leaf "strong" []
               (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))
             (weft/leaf "small" [] "Scene Plate / Shrine root")])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'shrine 'scene_plate] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "div" [(weft/cls "window-content")] children)] .none)
    (chat_foundry_web_policy_result .false [] .none)
