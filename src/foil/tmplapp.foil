-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
-  semidoc [order=85]
-  tmpl [order=90]
'  tmplapp: foil-built fixtures for the template kit's test suite
'  (foil-tmpl-tests) — the values must be built here because
'  nominal-row constructors applied from rvr produce non-canonical
'  reps that no pail match sees (the demo/mani lesson).
+  slot_pail
  '  Committed read of a slot's pail at a path, .none when the node
  '  or slot is absent.
  \  pax=path slot=path s=sov
  ^  maybe[pail]
  ?  s.x_latest(pax)
   > (./known t=myth)  t.get(slot)
  .none
+  slot_txt
  '  Committed read of a text slot at a path, 0 when absent.
  \  pax=path slot=path s=sov
  ^  nat
  ?  s.x_latest(pax)
   > (./known t=myth)  (myth/txt_at slot t)
  0
+  wiki_src
  '  The mini-wiki template: a bare top doc, one un-named sect, two
  '  named pages — w/home riding the kernel demo behavior (an
  '  ABSOLUTE ref into /kook) and a "."-relative link to its
  '  sibling.  The ;@ lines sit directly above ;. w/home at its
  '  indent: attributes decorate the following node.
  ^  nat
  (joined 10
    [";."
     ""
     "  ;= The wiki template"
     ""
     "    A layout with two named pages."
     ""
     "  ;@ /doc/kook ;/kook/ma"
     "  ;@ /doc/link ;/./w/ideas"
     "  ;. w/home"
     ""
     "    ;= Home"
     ""
     "      Welcome."
     ""
     "  ;. w/ideas"
     ""
     "    ;= Ideas"
     ""
     "      ;- one"
     ""
     "      ;- two"])
+  wiki_parts
  '  The parsed template, split for mounting.
  ^  [root=myth seeds=row[[p=path t=myth]]]
  (tmpl/parts (parse wiki_src))
+  wiki_mani
  '  The template as a mountable manifest.
  ^  mani
  (tmpl/mani 'wiki (lore/line "A mini wiki layout.") wiki_src)
+  wiki_vine
  '  The template instantiation as a one-event task at pax.
  \  pax=path
  ^  task
  (tmpl/vine pax wiki_src)
+  collide_src
  '  Two nodes claiming one id: the collision fixture — last in
  '  document order wins.
  ^  nat
  (joined 10
    [";."
     ""
     "  ;@ /doc/mark one"
     "  ;. w/dup"
     ""
     "  ;@ /doc/mark two"
     "  ;. w/dup"])
+  empty_vine
  '  Instantiation of the empty template: the instance root exists
  '  and is empty.
  \  pax=path
  ^  task
  (tmpl/vine pax 0)
+  collide_vine
  '  Instantiation of the collision fixture.
  \  pax=path
  ^  task
  (tmpl/vine pax collide_src)
+  rel_ref_rec
  '  The rebase_rec unit fixture: a "."-relative path pail, an
  '  absolute one, a mixed row pail, and mixed limb refs.
  ^  myth
  .  (myth/new)
     put(['rp] (pails/p (pact/rel ['w 'ideas])))
     put(['ap] (pails/p ['boot 'x]))
     put(['rows] (pails/ps [(pact/rel ['a]) ['b]]))
     put(limb_slot (kook [(pact/rel ['kook 'doc]) ['kook 'ma]]))
