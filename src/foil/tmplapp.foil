-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
-  semidoc [order=85]
-  tmpl [order=90]
'  tmplapp: foil-built fixtures for the template kit's test suite
'  (foil-tmpl-tests) — the values must be built here because
'  nominal-row constructors applied from rvr produce non-canonical
'  reps that no pail match sees (the demo/mani lesson).
+  slot_pail
  '  Committed read of a slot's pail at a path, .none when the node
  '  or slot is absent.
  \  pax=path slot=path s=sov
  ^  maybe[pail]
  ?  s.x_latest(pax)
   > (./known t=myth)  t.get(slot)
  .none
+  slot_txt
  '  Committed read of a text slot at a path, 0 when absent.
  \  pax=path slot=path s=sov
  ^  nat
  ?  s.x_latest(pax)
   > (./known t=myth)  (myth/txt_at slot t)
  0
+  wiki_src
  '  The mini-wiki template: a bare top doc, one un-named sect, two
  '  named pages — w/home riding the kernel demo behavior (an
  '  ABSOLUTE ref into /kook) and a "."-relative link to its
  '  sibling.  The ;@ lines sit directly above ;. w/home at its
  '  indent: attributes decorate the following node.
  ^  nat
  (joined 10
    [";."
     ""
     "  ;= The wiki template"
     ""
     "    A layout with two named pages."
     ""
     "  ;@ /doc/kook ;/kook/ma"
     "  ;@ /doc/link ;/./w/ideas"
     "  ;. w/home"
     ""
     "    ;= Home"
     ""
     "      Welcome."
     ""
     "  ;. w/ideas"
     ""
     "    ;= Ideas"
     ""
     "      ;- one"
     ""
     "      ;- two"])
+  wiki_parts
  '  The parsed template, split for mounting.
  ^  [root=myth seeds=row[[p=path t=myth]]]
  (tmpl/parts (parse wiki_src))
+  wiki_mani
  '  The template as a mountable manifest.
  ^  mani
  (tmpl/mani 'wiki (lore/line "A mini wiki layout.") wiki_src)
+  wiki_vine
  '  The template instantiation as a one-event task at pax.
  \  pax=path
  ^  task
  (tmpl/vine pax wiki_src)
+  collide_src
  '  Two nodes claiming one id: the collision fixture — last in
  '  document order wins.
  ^  nat
  (joined 10
    [";."
     ""
     "  ;@ /doc/mark one"
     "  ;. w/dup"
     ""
     "  ;@ /doc/mark two"
     "  ;. w/dup"])
+  empty_vine
  '  Instantiation of the empty template: the instance root exists
  '  and is empty.
  \  pax=path
  ^  task
  (tmpl/vine pax 0)
+  collide_vine
  '  Instantiation of the collision fixture.
  \  pax=path
  ^  task
  (tmpl/vine pax collide_src)
+  spec_yoke
  '  A hand-built spec for the renderer: documented root, one named
  '  page with its own lede, a var arm for numbered content, and two
  '  deps — one "."-relative, one absolute.
  ^  yoke
  =  l0     lash/new
     self   l0.set_lede("A wiki spec.").set_help("Named pages plus numbered prose.")
     p0     lash/new
     page   (soma (./some p0.set_lede("The home page.")) [])
     entry  (soma/arm (zeta/lit ($ts "home")) page)
     each   (soma/arm (zeta/var "u") soma/new)
     f0     (fief (deed .true) .x soma/new)
     d0     (axal/new[fief] .none)
     deps   d0.put((pact/rel ['w 'form]) f0).put(['kook 'ma] f0)
  (yoke self [entry each] deps)
+  spec_src
  '  The rendered scaffold source for /spec_yoke .
  ^  nat
  (tmpl/render spec_yoke)
+  spec_parts
  '  The rendered scaffold parsed and split, exactly the wiki_parts
  '  path — proves the scaffold is a valid template.
  ^  [root=myth seeds=row[[p=path t=myth]]]
  (tmpl/parts (parse spec_src))
+  spec_refs
  '  The kook refs the scaffold's root declares in SOURCE — parts
  '  drops them at instantiation, split_kook shows them.
  ^  row[path]
  =  ns  (parse spec_src)
  ?  (eq 0 ns.len)
     []
  =  [refs nd2]  (tmpl/split_kook ns.at(0))
  refs
+  spec_vine
  '  Instantiation of the rendered scaffold.
  \  pax=path
  ^  task
  (tmpl/vine pax spec_src)
+  gate_yoke
  '  The adoption fixture: /home must carry a text ['status].
  ^  yoke
  =  arm  (soma/arm (zeta/lit ($ts "home"))
            (soma (./some (lash/texted ['status] "status: text required")) []))
  (yoke lash/new [arm] (axal/new[fief] .none))
+  gate_src
  '  One named page, no status yet — the adopting mount write is
  '  gate-exempt.
  ^  nat
  (joined 10 [";." "" "  ;. home"])
+  gate_mani
  '  The template mani with /gate_yoke adopted (tmpl/mani_spec).
  ^  mani
  (tmpl/mani_spec 'gated (lore/line "The adoption-gate fixture.") gate_src gate_yoke [] [])
+  weld_code
  '  The weld fixture's code side: a /home slot that must survive
  '  the meld, plus one un-spec'd extra node.
  ^  mani
  (mani 'gated
        (lore/line "The code side.")
        []
        [[['home] (myth/sing ['note] (pails/t "from code"))]
         [['extra] (myth/sing ['note] (pails/t "loose"))]]
        [])
+  weld_app
  '  /gate_mani welded under the code side, judged by /gate_yoke .
  ^  mani
  (mani/weld_spec gate_yoke gate_mani weld_code)
+  rel_ref_rec
  '  The rebase_rec unit fixture: a "."-relative path pail, an
  '  absolute one, a mixed row pail, and mixed limb refs.
  ^  myth
  .  (myth/new)
     put(['rp] (pails/p (pact/rel ['w 'ideas])))
     put(['ap] (pails/p ['boot 'x]))
     put(['rows] (pails/ps [(pact/rel ['a]) ['b]]))
     put(limb_slot (kook [(pact/rel ['kook 'doc]) ['kook 'ma]]))
