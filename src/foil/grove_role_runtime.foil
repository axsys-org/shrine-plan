- publisher_vocabulary
- lain_types
'  Stored, source-independent role shape. Codecs live in module exports.
+ grove_role_field
  : name=str slot=path optional=bool
+ grove_role_schema
  : fields=row[grove_role_field] need=row[row[path]]
+ grove_role_runtime
  + present
    \ need=row[row[path]] card=myth
    ^ bool
    | need.all
    \ group
    | group.any (\ slot card.has(slot))
  + spec
    \ fields=row[[path curb]] need=row[row[path]]
    ^ lash
    = types=curbs
        | fields.fold (mop/empty)
        \ out [slot type]
        | out.put slot type
    | lash types types need 0 0

+ grove_action_schema
  : receiver=path arguments=grove_role_schema

+ grove_norm_segment
  : name=str pattern=zeta
+ grove_norm_schema
  : segments=row[grove_norm_segment] item=grove_role_schema
+ grove_norm_runtime
  + prefix
    \ segments=row[grove_norm_segment] path=path
    ^ bool
    ? (gt path.len segments.len) .false
    | (row/range 0 path.len).all
    \ i
    ? segments.at(i).pattern
     > (zeta/lit value) (eq_iota value path.at(i))
     > (zeta/var aura) (eq aura (aura_tag path.at(i)))
  + validate
    '  Return the first invalid occupied path; .none means valid.
    \ segments=row[grove_norm_segment] item={\ myth}bool
      tree=axal[myth]
    ^ maybe[path]
    % rest=row[[path myth]] tree.tap
    ^ maybe[path]
    ? (eq rest.len 0) .none
    = [path card] rest.at(0)
    ? !(grove_norm_runtime/prefix segments path) (./some path)
    ? (eq path.len segments.len)
      ? !(item card) (./some path)
      | _ rest.drop(1)
    = content
        | row/fold[path myth] card
          (\ card slot card.del(slot))
          [publisher_vocabulary/spec publisher_vocabulary/grove/like ['sys 'limb]
           ['sys 'lash] ['sys 'crew]]
    ? !(eq (mop/size[path pail lt_pith] content) 0) (./some path)
    | _ rest.drop(1)
  + spec
    \ segments=row[grove_norm_segment] item=lash
    ^ soma
    = wrap
        \ sub=soma segment=grove_norm_segment
        ^ soma
        | soma .none [(soma/arm segment.pattern sub)]
    | row/fold[grove_norm_segment soma] (soma (./some item) [])
      wrap (row/rev[grove_norm_segment] segments)

+ grove_sewn_schema
  ' Endpoint paths are provenance. The compiled schemas travel with the sewn
  ' value so consumers never combine pinned code with a newer norm declaration.
  : source=path target=path
    source_schema=grove_norm_schema target_schema=grove_norm_schema

+ grove_tree_rule
  : source=path validate={\ axal[myth]}maybe[path] spec=soma
+ grove_tree_seed
  : path=path rule=maybe[grove_tree_rule]

' Explicit instance-local references survive compilation without rebasing
' declaration paths, slot keys, or opaque user values by prefix matching.
+ grove_instance_ref
  : care=care path=path
+ grove_template
  : version=nat seeds=row[[path myth]]
