-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  json [order=50]
-  shadow_forms [order=60]
-  shadow_io [order=70]
'  Headless native assembly. JSON is only a literal transport;
'  state, values, forms, crews and effects remain native.
+  shadow
  +  as_record
    \  value=myth
    ^  myth
    value
  +  sample_move
    ^  move
    (move [] [] .cull)
  +  sample_pail
    ^  pail
    (pails/n 0)
  +  literal
    :  value=json
  +  pack
    \  v=json
    ^  pail
    ?  v
     > (./str s)  (pails/t s)
     > (./num neg n)
       ?  neg  (shadow/literal v)
       (pails/n n)
    (shadow/literal v)
  +  exact
    \  p=path s=sov
    ^  maybe[myth]
    (peek p s).fil
  +  historical
    \  c=nat p=path s=sov
    ^  maybe[myth]
    ?  s.x_query(c p)
     > (./known t)  (./some t)
    .none
  +  rows
    \  p=path s=sov
    ^  row[[path myth]]
    (peek p s).tap.map((\ [rel t] [p.weld(rel) t]))
  +  case
    \  p=path s=sov
    ^  nat
    ?  s.x_case(p)
     > (./some n)  n
    0
  +  slots
    \  t=myth
    ^  row[[path pail]]
    t.tap.map((\ [k v] [k v]))
  +  put
    \  p=path v=pail t=myth
    ^  myth
    t.put(p v)
  +  get
    \  p=path t=myth
    ^  maybe[pail]
    t.get(p)
  +  result
    :  state=sov index=hive ok=bool error=nat ack=maybe[path] effects=row[move] changes=row[path]
  +  changed
    \  rounds=row[axal[sign]]
    ^  row[path]
    =  > all
         |  > i=nat 0  > out=axal[nat] (axal/new[nat] .none)
         ?  (eq i rounds.len)  out
         =  > next rounds.at(i).tap.fold(out ;
              \  a [p sg]
              ?  (eq sg.x 0)  a
              a.put(p 1))
         (_ i.inc next)
    all.tap.map((\ [p n] p))
  +  event_move
    '  Preserve the authored sender when an outward move re-enters NS.
    \  m=move s=sov
    ^  ovum
    ?  (grind [(flue m.src m.dst (job/vine m.w))] (./some m.dst) 0 s)
     > (./fail e)  (./fail e)
     > (./done f a)
       ?  (commit (task/vine m.dst m.w) a 1 f s)
        > (./rejected e)  (./fail e)
        > (./accepted r=[state=sov signs=axal[sign]])  (./ripe state f.effects signs a)
  +  cycle_move
    \  hv=hive m=move fuel=nat s=sov
    ^  [g=gyre hv2=hive]
    ?  (shadow/event_move m s)
     > (./fail e)  [(./fail e) hv]
     > (./ripe s1 fx1 sg1 a)
       |  > cur=sov s1  > moves=row[move] fx1  > rounds=row[axal[sign]] [sg1]  > sg=axal[sign] sg1  > gas=nat fuel  > hz=hive (hive_bump hv sg1 s1)
       ^  [g=gyre hv2=hive]
       =  [nws rest] (react sg (eyes_from hz))
       ?  ((eq nws.wyt 0) || (eq gas 0))  [(./spun cur moves rounds a .none) hz]
       ?  (run_event_log (task/hear nws) 0 cur)
        > (./fail e)  [(./spun cur moves rounds a (./some e)) hz]
        > (./ripe s2 fx2 sg2 a2)
          (_ s2 moves.weld(fx2) rounds.snoc(sg2) sg2 gas.dec (hive_bump hz sg2 s2))
  +  run
    '  Follow native outbound cards inside the namespace. /io cards
    '  are retained for physical dispatch. No host dependency matcher.
    \  op=nat p=path t=myth expected=maybe[nat] s=sov hv=hive
    ^  shadow/result
    =  > mismatch
         ?  expected
          > (./some c)
            ?  (eq c 0)
               ?  (shadow/exact p s)
                > (./some _)  .true
               .false
            !(eq c (shadow/case p s))
         .false
    ?  mismatch  (shadow/result s hv .false "stale_case" .none [] [])
    =  > w=writ
         ?  (eq op "make")  (./make t)
         ?  (eq op "poke")  (./poke t)
         .cull
    (shadow/drain [(move [] p w)] 0 s hv [] (axal/new[nat] .none) .none)
  +  drain
    \  todo=row[move] i=nat cur=sov index=hive effects=row[move] paths=axal[nat] ack=maybe[path]
    ^  shadow/result
    =  > changed paths.tap.map((\ [key n] key))
    ?  (eq i todo.len)  (shadow/result cur index .true "" ack effects changed)
    ?  (ge i 128)  (shadow/result cur index .false "native_effect_limit" ack effects changed)
    =  > m todo.at(i)
    ?  (is_io m.dst)
       (_ todo i.inc cur index effects.snoc(m) paths ack)
    =  [g next_index]  (shadow/cycle_move index m 16 cur)
    ?  g
     > (./fail e)
       (shadow/result cur index .false (quip_val e) ack effects changed)
     > (./spun next moves rounds a spill)
       =  > next_paths (shadow/add_changes rounds paths)
       =  > first_ack
            ?  (eq i 0)  a
            ack
       ?  spill
        > (./some e)
          (shadow/result next next_index .false (quip_val e) first_ack effects.weld(moves) next_paths.tap.map((\ [key n] key)))
       ?  (shadow/unfinished rounds next_index)
          (shadow/result next next_index .false "native_cascade_limit" first_ack effects.weld(moves) next_paths.tap.map((\ [key n] key)))
       (_ todo.weld(moves) i.inc next next_index effects next_paths first_ack)
  +  unfinished
    \  rounds=row[axal[sign]] hv=hive
    ^  bool
    ?  (eq rounds.len 0)  .false
    =  [nw rem] (react rounds.at(rounds.len.dec) (eyes_from hv))
    !(eq nw.wyt 0)
  +  add_changes
    \  rounds=row[axal[sign]] paths=axal[nat]
    ^  axal[nat]
    =  > rows (shadow/changed rounds)
    |  > j=nat 0  > out=axal[nat] paths
    ?  (eq j rows.len)  out
    (_ j.inc out.put(rows.at(j) 1))
  +  crew_rows
    \  t=myth
    ^  row[[path path nat]]
    ?  t.get(crew_slot)
     > (./some pl)
       ?  pl
        > c=cpail
          =  > entries c.crew.tap
          |  > j=nat 0  > out=row[[path path nat]] []
          ?  (eq j entries.len)  out
          =  [slot d] entries.at(j)
          =  > kind
               ?  d.c
                > .x  "x"
                > .y  "y"
                > .z  "z"
          (_ j.inc out.snoc([slot d.p kind]))
       []
    []
  +  behaviors
    \  t=myth
    ^  row[path]
    ?  t.get(limb_slot)
     > (./some pl)
       ?  pl
        > k=kook  k.refs
       []
    []
