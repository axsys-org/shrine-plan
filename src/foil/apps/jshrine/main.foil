-  lain
-  pact
-  lainapp
'  jshrine: the product-facing Space and Locus vocabulary.  The browser
'  projects these records; context and view transitions remain Lain behavior.
+  locus_context
  '  The reflected routing references that define one Locus context packet.
  '  Paths locate records; occurrence identity remains owned by Shrine.
  :  root=path space=path scene=path flow=path trace=path focus=path
+  locus_view
  '  The Locus projection state.  Surface, mode, and facet are semantic
  '  choices interpreted by the Locus behavior, not browser component state.
  :  open=nat surface=quip mode=quip facet=quip lens=path revision=nat
+  locus_action
  '  A context-sensitive action declaration.  Capability enforcement is not
  '  claimed here yet; required names the future capability reference.
  :  id=quip label=nat kind=quip required=path
+  qslot
  \  slot=path d=quip t=myth
  ^  quip
  ?  t.get(slot)
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=qpail  x.q
     d
+  pslot
  \  slot=path d=path t=myth
  ^  path
  ?  t.get(slot)
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=ppail  x.p
     d
+  context_of
  \  t=myth d=locus_context
  ^  locus_context
  ?  t.get(['context])
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=locus_context  x
     d
+  view_of
  \  t=myth d=locus_view
  ^  locus_view
  ?  t.get(['view])
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=locus_view  x
     d
+  locus_crew
  '  Named, cared references for the reflected context.  Focus is y-care so
  '  the action surface sees the selected node and its nearest live frontier;
  '  the structural roles need only their own records.
  \  c=locus_context
  ^  crew
  =  > m1 (mop/put[path dep lt_pith] ['root] (dep $x c.root) (mop/empty))
  =  > m2 (mop/put[path dep lt_pith] ['space] (dep $x c.space) m1)
  =  > m3 (mop/put[path dep lt_pith] ['scene] (dep $x c.scene) m2)
  =  > m4 (mop/put[path dep lt_pith] ['flow] (dep $x c.flow) m3)
  =  > m5 (mop/put[path dep lt_pith] ['trace] (dep $x c.trace) m4)
  (mop/put[path dep lt_pith] ['focus] (dep $y c.focus) m5)
+  locus_project
  '  Mirror semantic fields into ordinary pails so generic projection clients
  '  can navigate them without understanding the branded records.
  \  t=myth c=locus_context v=locus_view
  ^  myth
  =  > t1 t.put(['context] c)
  =  > t2 t1.put(['view] v)
  =  > t3 t2.put(['root] (ppail c.root))
  =  > t4 t3.put(['space] (ppail c.space))
  =  > t5 t4.put(['scene] (ppail c.scene))
  =  > t6 t5.put(['flow] (ppail c.flow))
  =  > t7 t6.put(['trace] (ppail c.trace))
  =  > t8 t7.put(['focus] (ppail c.focus))
  =  > t9 t8.put(['lens] (ppail v.lens))
  =  > t10 t9.put(['open] (pd v.open))
  =  > t11 t10.put(['surface] (qpail v.surface))
  =  > t12 t11.put(['mode] (qpail v.mode))
  =  > t13 t12.put(['facet] (qpail v.facet))
  =  > t14 t13.put(['revision] (pd v.revision))
  t14.put((crew_slot 0) (cpail (locus_crew c)))
+  locus_init
  '  Derive every app-local reference from the actual mount point so the same
  '  manifest remains rerootable.  Only the namespace root is intentionally
  '  absolute: it is the initial trace root being reflected.
  \  b=bowl t=myth
  ^  yell
  =  > app_root b.here.take(b.here.len.dec)
  =  > space app_root.snoc('space)
  =  > scene app_root.weld(['scenes 'namespace])
  =  > flow space.weld(['flows 'main])
  =  > trace flow.weld(['traces 'root])
  =  > c (locus_context [] space scene flow trace [])
  =  > v (locus_view 0 'compact 'context 'preview [] 0)
  (yell [] (locus_project t c v))
+  locus_talk
  '  Interpret generic intent pails as Locus transitions.  The transport only
  '  supplies an id and optional target; this behavior owns their meaning.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > c0 (context_of cur (locus_context [] [] [] [] [] []))
  =  > v0 (view_of cur (locus_view 0 'compact 'context 'preview c0.focus 0))
  =  > intent (qslot ['intent] 'none add)
  =  > target (pslot ['target] c0.focus add)
  =  > c1
       ?  (eq_iota intent 'focus)
          c0.set_focus(target)
       ?  (eq_iota intent 'open)
          c0.set_focus(target)
       ?  (eq_iota intent 'lens)
          c0.set_focus(target)
       c0
  =  > v1
       ?  (eq_iota intent 'open)
          (locus_view 1 'command 'context v0.facet target v0.revision.inc)
       ?  (eq_iota intent 'compact)
          (locus_view 1 'compact v0.mode v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'lens)
          (locus_view 1 'lens 'lens v0.facet target v0.revision.inc)
       ?  (eq_iota intent 'dismiss)
          (locus_view 0 'compact v0.mode v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'personal)
          (locus_view 1 'command 'personal v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'actions)
          (locus_view 1 'command 'actions v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'collections)
          (locus_view 1 'command 'collections v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'wizard)
          (locus_view 1 'command 'wizard v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'context)
          (locus_view 1 'command 'context v0.facet v0.lens v0.revision.inc)
       ?  (eq_iota intent 'data)
          v0.set_facet('data).set_revision(v0.revision.inc)
       ?  (eq_iota intent 'connections)
          v0.set_facet('connections).set_revision(v0.revision.inc)
       ?  (eq_iota intent 'io)
          v0.set_facet('io).set_revision(v0.revision.inc)
       ?  (eq_iota intent 'members)
          v0.set_facet('members).set_revision(v0.revision.inc)
       v0
  =  > base cur.meld(add)
  (yell [] (locus_project base c1 v1))
+  locus_hear
  '  A reflected dependency changed.  The context references stay stable while
  '  revision marks that the projection packet must be read again.
  \  b=bowl cur=myth changes=row[dep]
  ^  yell
  =  > c (context_of cur (locus_context [] [] [] [] [] []))
  =  > v (view_of cur (locus_view 0 'compact 'context 'preview c.focus 0))
  (yell [] (locus_project cur c v.set_revision(v.revision.inc)))
+  locus_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  =  > f1 f.set_init(locus_init)
  =  > f2 f1.set_talk(locus_talk)
  f2.set_hear(locus_hear)
+  locus_seed
  \  x=nat
  ^  myth
  (kooked [['kook 'locus]])
+  semantic_record
  \  kind=quip label=nat
  ^  myth
  =  > t (t0 0)
  =  > t1 t.put(['kind] (qpail kind))
  t1.put(['label] (tpail label))
+  action_record
  \  id=quip label=nat kind=quip required=path
  ^  myth
  =  > t (semantic_record 'action label)
  =  > t1 t.put(['id] (qpail id))
  =  > t2 t1.put(['effect] (qpail kind))
  t2.put(['action] (locus_action id label kind required))
+  product_scene
  \  x=nat
  ^  myth
  =  > t (semantic_record 'scene "Product schema")
  =  > t1 t.put(['scene] (qpail 'product_schema))
  =  > t2 t1.put(['ceiling] (qpail 'scene_plate))
  =  > t3 t2.put(['source] (tpail "Shrine namespace"))
  =  > t4 t3.put(['summary] (tpail "The product-facing Shrine schema, projected from namespace records."))
  =  > t5 t4.put(['thesis] (tpail "Shrine is one durable relational world whose occurrences can assume different interface roles under different contexts without being copied into separate object systems."))
  =  > t6 t5.put(['principles] (tpail "Roles interpret durable ground; they do not replace it|Context selects a root without creating global parenthood|People and agents walk the same Trace protocol|Mountedness changes residence, not agency|Observation and action are separate horizons|Presentation cascade never implies capability inheritance|Reprojection preserves identity|Hardening creates new ground with provenance|Unknown structure survives partial interpretation"))
  =  > t7 t6.put(['context_resolution] (tpail "Personal Web supplies private continuity, agent policy, preferences, and personal references|Space narrows cooperation through roles, capabilities, materialization, and shared policy|Flow restores the saved working arrangement, participating agents, and active Traces|Trace establishes the realized trajectory, cursor, branch, and inspectable receipts|Scene Route identifies the active projected instance|Selection identifies the occurrence or projection currently in focus|Admitted Sights establish the observation horizon|Effective cares and capabilities determine what can be observed, projected, or acted upon here"))
  =  > t8 t7.put(['horizons] (tpail "Observation horizon: which occurrences and relationships the current context may disclose|Action horizon: which contextual Actions the current capabilities admit|Projection horizon: which semantic roles and surfaces the current Foundry cascade can realize|Persistence horizon: which transient arrangements may be pinned or hardened as durable ground"))
  =  > t9 t8.put(['lifecycle] (tpail "Project: show an occurrence in a contextual role without changing its identity|Pin: preserve a projection in a Flow or Trace while it remains derived|Reproject: move the same occurrence into another role, surface, or composition|Distill: recognize reusable structure across lived Trace branches|Harden: commit distilled structure as a new durable Flow with provenance|Bake: partially evaluate a Flow for a declared context while preserving its source"))
  =  > t10 t9.put(['journey] (tpail "Open the Locus from the current Trace root|Resolve a deterministic harness packet from Personal Web, Space, Flow, Trace, Sights, and capabilities|Invoke or resume an agent at the current Trace cursor|Search across references admitted by the current context|Establish a Sight to the selected occurrence|Open the Sight through the Lense without gaining action authority|Project the occurrence as a Plate in the active Scene when human participation is useful|Resolve the applicable Foundry cascade and hydrate only the required realization|Invoke an admitted Action and append its result or refusal to the Trace|Continue headlessly or through the projected Scene|Distill useful Trace structure, Harden it as a Flow, and optionally Bake a specialization"))
  =  > t11 t10.put(['foundry_cascade] (tpail "Client baseline|Personal accessibility and privacy overlays|Personal Web Foundry|Space Foundry|Scene Foundry|Plate Foundry|Block Foundry|Projection-local fork"))
  =  > t12 t11.put(['hydration_negotiation] (tpail "Semantic role and source reference|Current Space, Scene, Plate, Block, and Slot context|Projection ceiling|Available renderers, assets, and device features|Accessibility requirements|Personal presentation and suppression policy|Density, motion, input, and performance preferences|Foundry versions and explicit fallback recipes"))
  =  > t13 t12.put(['hydration_packet] (tpail "Semantic reference|Admitted visible structure|Selected projection role|Resolved Foundry chain|Partially evaluated projection recipe|Unresolved client choices|Fallbacks, refusals, and provenance"))
  =  > t14 t13.put(['hydration_laws] (tpail "The nearest applicable recipe wins while unspecified parts fall outward|Foundry forks are copy-on-write overlays rather than duplicated systems|Accessibility is a protected client-owned realization layer|Client suppression can narrow presentation but never widen observation or action|A local fork cannot exceed its projection ceiling or style an ancestor|Missing realization falls back or refuses explicitly; it never invents semantics"))
  t14.put(['hydration_examples] (tpail "Locus: the occurrence becomes a compact contextual Block|Flow: the same occurrence becomes a pinned Plate|Scene: the same occurrence becomes a document or canvas Plate|Accessible client: contrast, motion, typography, and interaction are overridden|Minimal client: invariant recipe fragments arrive partially evaluated and resolve to available Glyphs"))
+  product_entity
  \  group=quip label=nat summary=nat boundary=nat purpose=nat owns=nat invariants=nat distinctions=nat model=nat relations=nat order=nat
  ^  myth
  =  > t (semantic_record 'product_entity label)
  =  > t1 t.put(['group] (qpail group))
  =  > t2 t1.put(['summary] (tpail summary))
  =  > t3 t2.put(['boundary] (tpail boundary))
  =  > t4 t3.put(['purpose] (tpail purpose))
  =  > t5 t4.put(['owns] (tpail owns))
  =  > t6 t5.put(['invariants] (tpail invariants))
  =  > t7 t6.put(['distinctions] (tpail distinctions))
  =  > t8 t7.put(['model] (tpail model))
  =  > t9 t8.put(['relations] (tpail relations))
  t9.put(['order] (pd order))
+  app
  \  x=nat
  ^  mani
  (mani 'jshrine
        (lore1 "jShrine Space composition and the context-reflecting Locus.")
        [(kdecl 'locus (locus_form 0) (lore1 "The Locus: reflected context, view state, and semantic intent transitions."))]
        [[['space] (space_state_t "{}")]
         [['space 'flows 'main] (semantic_record 'flow "Main flow")]
         [['space 'flows 'main 'traces 'root] (semantic_record 'trace "Namespace root trace")]
         [['scenes 'namespace] (semantic_record 'scene "Namespace")]
         [['docs] (product_scene 0)]
         [['docs 'entities] (semantic_record 'collection "Product schema entities")]
         [['docs 'entities 'web]
          (product_entity 'webs "Web"
                          "A durable relational and authority-bearing context that coordinates occurrences, relationships, participation, materialization, recovery, and projection."
                          "A Web is logical context rather than a host, database, folder tree, or visual interface. Materializers may serve it without becoming its owner."
                          "The Web gives durable meaning to references and cooperation while allowing routes, providers, devices, and interfaces to change."
                          "Occurrence identities and relationships|Participants, roles, and capability grants|Storage, materialization, and recovery declarations|Namespace and projection declarations"
                          "Routes locate occurrences but do not own identity|Mounting another Web preserves both boundaries|No renderer or provider becomes semantic authority"
                          "Not a website or server|Not identical to its namespace projection|Not a single mandatory Scene"
                          "durable occurrences and relations|authority and participation|materialization and recovery|namespace and interface projections"
                          "contains>occurrence|appears through>projection|specializes as>space" 0)]
         [['docs 'entities 'personal_web]
          (product_entity 'webs "Personal Web"
                          "The person-owned, durable Web that coordinates Spaces, resources, identity, trust, preferences, agents, providers, and recovery."
                          "A host may materialize the Personal Web, but it never becomes the logical owner. The Web survives host, device, provider, and Scene changes."
                          "It keeps the person's private continuity mounted across cooperative contexts and supplies the Agent Harness and personal references from which the Locus operates."
                          "Space relationships|Resources and reusable projections|Identity and trust policy|Mounted agents and harness policy|Recovery and rematerialization evidence"
                          "Not a dashboard, folder, or cloud account|Provider identity is not Web identity|Related Space Webs retain their own boundaries"
                          "Not visible merely because a Space is shared|Not absorbed by a mounted Space|Not owned by the active device"
                          "person-owned Web|private resources and policy|explicit Space relationships|persistent Agent Harness, Locus, and overlay context"
                          "is a>web|relates>space|opens>locus|supplies>agent-harness" 1)]
         [['docs 'entities 'agent_harness]
          (product_entity 'webs "Agent Harness"
                          "The Personal Web machinery that admits and coordinates agent participation through Flows, Traces, Sights, Actions, providers, and explicit capabilities."
                          "The Harness is not one model runtime, chat session, or visible panel. It can operate headlessly, while the Locus and other Scenes are contextual projections of its operations."
                          "It preserves agent continuity above replaceable providers and lets mounted or invoked agents participate through the same namespace-grounded protocol."
                          "Deterministic context packets|Provider and agent selection|Capability delegation and activation policy|Receipts, refusals, provenance, and continuity"
                          "Personal Web owns durable harness policy|Space narrows participation|Model sessions remain replaceable|Headless and projected execution share semantics"
                          "Not the Locus UI|Not a model provider|Not ambient authority|Not one permanently running process"
                          "Personal Web policy|Flow and Trace context|admitted Sights and Actions|agent activation|headless or projected participation"
                          "belongs to>personal-web|coordinates>agent|projects through>locus" 2)]
         [['docs 'entities 'agent]
          (product_entity 'webs "Agent"
                          "A capability-bounded participant that begins at a Trace cursor, observes through admitted Sights, invokes admitted Actions, and records inspectable consequences."
                          "An Agent may be invoked or mounted, headless or visibly projected. Mountedness changes residence and addressability, not the execution protocol or inherent authority."
                          "It lets local models, remote models, people, and durable services participate in the same Flow and Trace world without making provider session state the source of continuity."
                          "Current invocation or mounted occurrence|Delegated roles and capabilities|Admitted Sights|Action results, refusals, and receipts"
                          "Observation never implies action authority|Mounted agents retain durable configuration|Invoked agents may leave durable Trace evidence|Hidden chain-of-thought is not Trace ground"
                          "Not necessarily autonomous|Not necessarily visible|Not automatically mounted|Not equivalent to one model provider"
                          "context packet|Trace cursor|Sight resolution|capability-admitted Action|inspectable consequence"
                          "coordinated by>agent-harness|walks>trace|observes>sight|invokes>action" 3)]
         [['docs 'entities 'space]
          (product_entity 'webs "Space"
                          "A cooperative Web and participation boundary that declares how a shared context is stored, materialized, governed, and projected."
                          "Mounting relates two Webs; it does not turn a Space into a folder. Space chrome is an active Scene projection of the Space, not the Space itself."
                          "It establishes the shared rules under which participants, resources, Flows, and Scenes can cooperate without collapsing their Personal Webs together."
                          "Storage and synchronization declarations|Materializers and recovery providers|Participants, roles, and capability grants|Flows, Scenes, and active Foundries"
                          "Roles organize cooperation|Capabilities authorize concrete actions|Capabilities never cascade as ambient child authority"
                          "Not a folder inside a Personal Web|Not its root chrome|Not one host, room, or provider"
                          "cooperative Web boundary|roles and explicit capabilities|shared resources and trajectories|available root Scene projections"
                          "is a>web|hosts>flow|projects>scene" 4)]
         [['docs 'entities 'flow]
          (product_entity 'trajectory "Flow"
                          "A saved working configuration containing active Traces, participating agents, admitted Sights, pinned Plates, layout, selection, and presentation policy."
                          "A Flow is a tab-level unit. Creating one does not split the workspace, and ordinary namespace navigation does not create another Flow."
                          "It makes an ongoing line of work resumable and can be authored directly or hardened from AI-distilled Trace structure."
                          "One or more resumable Traces|Participating agents, Sights, and continuation policy|Flow-pinned Plate projections|Layout and selection|An active Trace reference"
                          "Flow is configuration; Trace is realized history|Flow pins survive Trace changes|Tiling is a projection choice|Baking specializes without replacing the source"
                          "Not browser history|Not a namespace route|Not inherently one window or tile"
                          "working intent and presentation policy|active and resumable Traces|agent and Sight participation|persistent Flow-scoped Plates|selection and Scene arrangement"
                          "contains>trace|pins>plate|runs in>space|specialized by>flow-baking" 5)]
         [['docs 'entities 'trace]
          (product_entity 'trajectory "Trace"
                          "The inspectable, stateful ground walked by people and agents: ordered namespace movement, actions, cursor, branches, occurrences, and trace-local context."
                          "A Trace is neither a tab nor hidden model reasoning. It records durable references, participants, selected Actions, outputs, refusals, receipts, and concise decision summaries."
                          "It preserves the realized line from a contextual root so work can be inspected, branched, resumed, distilled by AI, or hardened into a reusable Flow."
                          "Ordered path and occurrence steps|Cursor and resumable branches|Human and agent participation|Action results, refusals, and provenance|Trace-pinned Plates"
                          "Route changes do not erase occurrence history|Branching need not duplicate the Flow|Trace pins follow one trajectory|Model-local chain-of-thought is not durable Trace state"
                          "Not the Flow that contains it|Not merely browser navigation|Not a private reasoning transcript|Not a future possibility until a continuation is realized"
                          "contextual root|ordered occurrence and action steps|participants and receipts|current cursor and branches|trace-local projections and continuation state"
                          "belongs to>flow|visits>occurrence|pins>plate|walked by>agent|distilled by>hardening" 6)]
         [['docs 'entities 'stream]
          (product_entity 'trajectory "Stream"
                          "A live, ordered relationship that carries updates between cared sources and destinations while retaining producer and context."
                          "A Stream is not the data it carries, a polling loop, or a Trace. It describes a durable subscription composition rather than one realized history."
                          "It keeps evolving projections current without forcing Scenes to rediscover change by diffing private renderer state."
                          "Source Sights|Filters and transforms|Ordering and pressure policy|Projected destinations"
                          "Items retain producer occurrence and context|Subscription does not grant write authority|Stream configuration survives any renderer"
                          "Not a Trace through time|Not a Flow configuration|Not merely a scrolling UI list"
                          "cared sources|filters and transforms|ordered publication|projected consumers"
                          "observes>sight|updates>projection|may append>trace" 7)]
         [['docs 'entities 'locus]
          (product_entity 'trajectory "Locus"
                          "The contextual projected console of the Personal Web's Agent Harness for finding, bifurcating, inspecting, invoking, projecting, distilling, hardening, and acting."
                          "The Locus changes mode and extent as one surface and may also be invoked headlessly. It does not contain agents, invent authority, or flatten Spaces, Scenes, Actions, and children into one hierarchy."
                          "It resolves Web, Space, Flow, Trace cursor, Scene Route, selection, Sights, cares, capabilities, and provider policy into useful command, Lense, agent, and personal-overlay operations."
                          "Contextual search and bifurcation|Agent invocation, resumption, mounting, and inspection|Lense Plate and path inspection|Personal Web overlay access|Progressive Plate preview, distillation, hardening, and pinning"
                          "Context comes from namespace references|Opening is ephemeral while committed actions persist|Available actions are capability-valid|One surface morphs instead of nesting unrelated popovers|Visible UI is optional"
                          "Not only a command palette|Not the Agent Harness itself|Not owned by the selected occurrence|Not a source of semantic authority"
                          "deterministic context packet|search and bifurcation surface|agent control surface|Lense inspection surface|personal overlay and embeddable Plate staging"
                          "operates on>trace|opens>lense|offers>action|projects>agent-harness" 8)]
         [['docs 'entities 'lense]
          (product_entity 'trajectory "Lense"
                          "The Locus mode that inspects a selected occurrence, Sight, or Scene Route and stages contextual projections and actions."
                          "A Lense is an interface mode, not durable source identity or authority. Its minimized and expanded forms remain one surface."
                          "It turns selection into an intelligible path, properties, relationships, available actions, and Plate projections without mutating the selected source."
                          "Selected durable reference|Inspection tabs and path|Staged inspector Plates|Local presentation state"
                          "Source remains unchanged until an action commits|Detached inspectors remain referenced|Minimized and expanded forms preserve one context"
                          "Not the whole Locus|Not the Sight it inspects|Not a generic sidebar"
                          "reflected selection|route and Sight inspection|contextual tabs and actions|detachable Plate projections"
                          "is a mode of>locus|inspects>sight|targets>scene-route" 9)]
         [['docs 'entities 'sight]
          (product_entity 'trajectory "Sight"
                          "A durable line of observation from one contextual point to a target occurrence."
                          "A Sight is not a view, selector string, route, or permission. It preserves the distinction between observer, context, and target."
                          "It makes what is being observed inspectable, composable, pinnable, and resumable without collapsing the observer into the target."
                          "Contextual origin|Target occurrence reference|Observation depth|Preferred projection"
                          "Observation does not imply action authority|Target identity remains stable|A Sight may be ephemeral or persisted"
                          "Not a Lense interface|Not a Scene Route|Not a capability grant"
                          "contextual point|target reference|observation horizon|projected result"
                          "observed through>lense|may appear as>plate|traversed by>trace|supplies>agent" 10)]
         [['docs 'entities 'scene]
          (product_entity 'composition "Scene"
                          "A coherent renderable whole under a contextual root, composed from Plates and their contents."
                          "A Scene may fill a viewport or be reprojected inside a Plate. Visual prominence never makes it the durable owner of its Web or Space."
                          "It determines which Plates occupy a surface, how they compose, which overlays are active, and how interaction moves through that projected whole."
                          "Plate composition|Active overlays|Lifecycle and shell policy|A contextual render root"
                          "A scope, not a synonym for app or page|Can appear full-frame, tiled, or occluded|Space chrome is itself a Scene"
                          "Not the namespace content it renders|Not necessarily full-screen|Not the durable owner of its sources"
                          "contextual Scene root|Plate composition and overlays|local lifecycle and interaction policy|semantic routes to projected instances"
                          "composes>plate|projects within>space|addressed by>scene-route" 11)]
         [['docs 'entities 'scene_route]
          (product_entity 'composition "Scene Route"
                          "A stable semantic address from a contextual Scene root to one particular projected instance in that composition."
                          "A Scene Route identifies where something appears, not where its source lives. It traverses semantic Scene, Plate, Block, and Slot edges rather than DOM indices or coordinates."
                          "It lets selection, Lense, commands, drag operations, and Flow restoration target the right projection when one occurrence appears in several places."
                          "Contextual Scene root|Ordered semantic projection edges|Terminal projected instance|References needed to remap after reprojection"
                          "Layout movement does not change identity|Repeated projections have distinct Scene Routes|Route targeting does not grant authority"
                          "Not a namespace path|Not a CSS selector|Not a Trace through time"
                          "Scene root -> Plate -> Block -> Slot -> child projection|named roles instead of visual coordinates|endpoint linked to source occurrence"
                          "starts at>scene|crosses>slot|selects>projection" 12)]
         [['docs 'entities 'plate]
          (product_entity 'composition "Plate"
                          "A bounded semantic surface through which a Scene, occurrence, or Block composition is projected."
                          "A Plate can be a full Scene plate or an occluded preview while preserving source identity. A sidebar can hold real Plate projections."
                          "It gives content or a nested Scene a local surface contract: source, mode, selection, controls, occlusion, and attachment within the containing Scene."
                          "Blocks and local chrome|Projection mode|Local selection|A source Scene or occurrence"
                          "Not merely a rectangle|Occluded previews are real projections|Never projects above a Scene plate into Space or root chrome"
                          "Not interchangeable with its content|Not automatically a Scene root|Not allowed to impersonate Space authority"
                          "bounded surface contract|source occurrence or nested Scene|local Blocks, controls, and selection|full, compact, preview, or inspector mode"
                          "contains>block|attaches through>slot|belongs to>scene" 13)]
         [['docs 'entities 'block]
          (product_entity 'composition "Block"
                          "The normalized compositional unit for typed content, state, behavior, and named attachment points."
                          "Containers, shrubs, groups, rows, controls, and content can all normalize as Blocks. Grouping syntax may be sugar; structure remains real."
                          "It provides the homoiconic structure from which controls, content, containers, and larger interfaces can be inspected, edited, composed, and reprojected."
                          "Typed state and behavior|Named Slots|Projection metadata|Text and terminal Glyph children"
                          "Not only a leaf widget|Semantics survive layout changes|Can activate as a Plate at broader scope"
                          "Not merely a DOM element|Not necessarily visible|Not the Plate that bounds its projection"
                          "semantic role and typed state|behavior and properties|named Slots and child projections|Text and terminal Glyph resolution"
                          "fills>plate|declares>slot|contains>text|terminates in>glyph" 14)]
         [['docs 'entities 'slot]
          (product_entity 'composition "Slot"
                          "A named structural relationship declaring what can attach, how it participates, and which projection policy applies."
                          "A Slot is not a coordinate or incidental DOM placeholder. It remains meaningful when its host changes layout or projection scope."
                          "It preserves the meaning of attachment independently of layout, allowing compatible Blocks, Plates, or projections to move without losing their role."
                          "A semantic role|Compatibility constraints|A child or projection|Attachment policy"
                          "Survives responsive layout|Does not grant ambient authority|Can host a Plate projection"
                          "Not an array index|Not only empty space|Not an implicit capability grant"
                          "named attachment role|compatibility and cardinality|attached child or projection|projection and participation policy"
                          "declared by>block|accepts>projection|crossed by>scene-route" 15)]
         [['docs 'entities 'text]
          (product_entity 'composition "Text"
                          "A sugared Block composition of ordered semantic characters, including extensible format characters that can refer to richer inline content."
                          "Text is not an opaque renderer string. Its Block owns flow, ordering, selection, editing, language, and shaping while characters resolve through the Foundry."
                          "It lets typography, symbols, citations, resources, images, attachments, live values, and streamed agent output share one inspectable semantic sequence without embedding arbitrary UI components."
                          "Text-flow Block|Ordered character occurrences|Inline format-character references|Selection, editing, language, and shaping relationships"
                          "Characters are semantic input while Glyphs are terminal realization|Format characters preserve referenced occurrence identity|Foundry may choose visual, audible, haptic, compact Block, or refusal fallbacks"
                          "Not an opaque string|Not identical to rendered Glyphs|Not a way to bypass Slot contracts or projection ceilings"
                          "Text Block -> character Slot -> character occurrence -> Foundry realization -> Glyph or bounded inline projection"
                          "normalizes as>block|resolves through>foundry|terminates in>glyph|may reference>resource" 16)]
         [['docs 'entities 'glyph]
          (product_entity 'composition "Glyph"
                          "The terminal view of something: atomic observable content at the end of a surface projection."
                          "A Glyph has no children, Slots, or sub-manifest. Text characters and inline format references resolve through a Foundry into Glyphs or other bounded compatible fallbacks."
                          "It is the final resolved mark, sound, shape, sprite, haptic mark, or other atomic presentation through which meaning becomes observable."
                          "Atomic content or shape|Resolved presentation|A terminal semantic role|No child composition"
                          "Letters, icons, paths, sounds, haptics, and sprites can be Glyphs|Visual size does not make a Glyph a container|The Glyph is not the character, attachment, or durable source"
                          "Not the occurrence it depicts|Not a semantic character|Not a container|Not required to be visual or typographic"
                          "semantic terminal role|Foundry-selected representation|surface-specific output|no child scope"
                          "terminates>block|resolved by>foundry|views>occurrence" 17)]
         [['docs 'entities 'occurrence]
          (product_entity 'projection "Occurrence"
                          "The durable structural referent: pin reference plus occurrence axis, independent of route or host materialization."
                          "Paths locate occurrences; they do not own identity. Aliasing, rerouting, or reprojecting does not create a new thing."
                          "It gives Traces, resources, relationships, and projections a stable thing to refer to while routes and materializations evolve."
                          "Pin reference and occurrence axis|Structural identity|Complement evidence|Relationships to routes and projections"
                          "Not a path or filename|Can have several routes and views|Remains stable through projection changes"
                          "Not a copied value|Not its current URL|Not whichever host currently serves it"
                          "pin reference plus occurrence axis|durable structural referent|zero or more namespace routes|projection and provenance relationships"
                          "appears through>projection|carried by>resource|visited by>trace" 18)]
         [['docs 'entities 'projection]
          (product_entity 'projection "Projection"
                          "A contextual appearance of an occurrence on a particular surface, under a particular context and capability scope."
                          "A Projection is not a source copy. Detail, controls, material, and available actions may differ while identity remains shared."
                          "It relates a durable source to a surface, mode, Foundry, local selection, and effective actions without transferring ownership to the view."
                          "Source occurrence reference|Surface and mode|Local selection|Effective contextual actions"
                          "Can change without source mutation|Prominence does not create authority|Many views can share one occurrence"
                          "Not the source occurrence|Not necessarily visual|Not an authority boundary by itself"
                          "source reference|context and capability scope|surface and projection mode|Foundry recipe and local state"
                          "views>occurrence|occupies>slot|uses>foundry" 19)]
         [['docs 'entities 'resource]
          (product_entity 'projection "Resource"
                          "Namespace content with an explicit format and either inline bytes or an admitted external content reference."
                          "The namespace can preserve any format without already having an editor. Storage and presentation semantics remain separate."
                          "It carries format, provenance, integrity, and storage information so compatible projections can be selected without conflating a filesystem location with identity."
                          "Declared media type|Bytes or authorized reference|Provenance and integrity|Compatible projection choices"
                          "Filesystem paths are not identity|Unsupported formats remain storable|Incompatible renderers refuse explicitly"
                          "Not necessarily a file|Not its editor|Not invalid merely because the active Foundry cannot render it"
                          "durable occurrence reference|declared format and media type|inline bytes or admitted external reference|integrity and provenance"
                          "is an>occurrence|appears through>projection|may fill>plate|may appear in>text" 20)]
         [['docs 'entities 'foundry]
          (product_entity 'projection "Foundry"
                          "The semantic projection grammar that resolves Shrine structures into platform-appropriate layout, material, controls, interaction, accessibility, Text, format characters, and Glyphs."
                          "A Foundry changes realization without replacing content, becoming occurrence identity, or granting actions forbidden by the current capability context."
                          "It maps semantic roles and state to projection recipes that renderers such as React, SwiftUI, text, or WebGPU can execute consistently."
                          "Semantic tokens and materials|Plate, Block, Text, character, and control recipes|Layout, motion, and responsive policy|Accessibility, input, fallback, and Glyph resolution"
                          "Semantic roles precede component styling|Contextual overrides preserve source identity|Incompatible realization may fall back or refuse explicitly"
                          "Not merely a theme or component library|Not the renderer backend|Not the authority for namespace actions"
                          "semantic structure and state|forkable recipe fragments|renderer-independent realization rules|fallbacks into a Hydration Cascade"
                          "resolves>glyph|styles>projection|participates in>hydration-cascade" 21)]
         [['docs 'entities 'hydration_cascade]
          (product_entity 'projection "Hydration Cascade"
                          "The scoped negotiation that combines applicable Foundry fragments into the smallest sufficient realization for one live projection."
                          "The cascade governs presentation only. It cannot disclose hidden structure, grant actions, replace occurrence identity, exceed a projection ceiling, or style an ancestor outside its scope."
                          "It lets Foundries fork locally and fall back through Block, Plate, Scene, Space, Personal Web, and client layers while thin or headless clients receive only the semantic structure and residual recipes they need."
                          "Ordered Foundry ancestry|Semantic and device negotiation inputs|Partially evaluated hydration packet|Fallback, refusal, and provenance evidence"
                          "Nearest applicable recipe wins|Accessibility remains a protected client override|Forks are copy-on-write|Capability and semantic authority never cascade with styling"
                          "Not React hydration|Not CSS inheritance alone|Not capability attenuation|Not a license to cross projection ceilings"
                          "admitted semantic structure|projection role and ceiling|scoped Foundry overlays|partial evaluation|client realization and terminal Glyphs"
                          "hydrates>projection|resolves through>foundry|terminates at>glyph" 22)]
         [['docs 'entities 'action]
          (product_entity 'becoming "Action"
                          "A context-resolved possibility for meaningful change, exposed by the current terrain and admitted separately from observation."
                          "An Action is not a raw click, gesture, capability, or hardcoded callback. Interaction requests semantic behavior from a referenced target and context."
                          "It lets a person or agent invoke behavior that is intelligible, capability-checked, and able to produce either a committed result or an explicit refusal and receipt."
                          "Target reference|Intent and input shape|Contextual requirements|Expected result, refusal, and receipt policy"
                          "Availability is contextual|Execution requires authority|Accepted action advances realized history|Agent invocation never creates ambient authority"
                          "Not permission itself|Not a host effect|Not a Flow configuration"
                          "contextual offer|person or agent activation|authority check|committed change or refusal"
                          "surfaced by>locus|targets>occurrence|advances>trace|invoked by>agent" 23)]
         [['docs 'entities 'reprojection]
          (product_entity 'becoming "Reprojection"
                          "A change in how an existing occurrence participates in a context while preserving its durable identity."
                          "Reprojection is not cloning, format conversion, or source mutation. The same occurrence assumes another role, surface, or composition."
                          "It lets one thing move among Glyph, Block, Plate, and Scene roles or between layouts without splitting identity into renderer-owned copies."
                          "Source occurrence reference|Prior projection context|Next role and Foundry|Witness of the transition"
                          "Source occurrence remains stable|Capability never expands implicitly|Unknown structure is preserved"
                          "Not Hardening|Not duplication|Not visual restyling alone"
                          "existing occurrence|current context|selected role and Foundry|new contextual projection"
                          "preserves>occurrence|changes>projection|recomposes>scene" 24)]
         [['docs 'entities 'hardening]
          (product_entity 'becoming "Hardening"
                          "The deliberate act of committing useful structure distilled from an arrangement, projection, or human and agent Trace as new namespace ground."
                          "Hardening is not autosave, pinning alone, hidden model reasoning, or mutation of the source. It creates a new durable occurrence, often a Flow, with provenance."
                          "It lets AI recognize repeated trajectory, turn constants into Slots, observations into Sights, operations into Actions, and branch points into conditions before explicit policy admits commitment."
                          "Source Trace and derivation references|Distilled parameters, Sights, Actions, and conditions|New occurrence identity|Transitive provenance"
                          "Creates new ground|Source Trace remains unchanged|AI proposal does not imply authority|Provenance survives later reprojection and baking"
                          "Not Reprojection|Not persistence of ephemeral handles|Not retroactive Trace rewriting"
                          "lived Trace branches|AI or human distillation|explicit capability-admitted commitment|new reusable Flow or occurrence"
                          "creates>occurrence|stabilizes>projection|derived from>trace|may create>flow" 25)]
         [['docs 'entities 'flow_baking]
          (product_entity 'becoming "Flow Baking"
                          "The provenance-preserving partial evaluation of a durable Flow for a declared Space, capability envelope, provider, device, client, or projection target."
                          "Baking specializes an existing Flow without replacing its source, erasing residual choices, widening capabilities, or transferring semantic authority to a compiler or renderer."
                          "It lets headless and projected clients receive the smallest executable continuation while retaining the durable Flow, source Traces, unresolved decisions, fallbacks, and refusals."
                          "Source Flow reference|Specialization context|Resolved parameters and recipes|Residual agent or client choices|Provenance and invalidation evidence"
                          "Source Flow remains available|Capabilities can only stay equal or narrow|Stale specializations invalidate explicitly|Baking may target headless or projected execution"
                          "Not destructive compilation|Not Hardening|Not a model-specific prompt cache|Not permission amplification"
                          "durable Flow + declared context -> partial evaluation -> specialized Flow artifact + residual choices + provenance"
                          "specializes>flow|preserves>trace|may hydrate>projection|may execute through>agent-harness" 26)]
