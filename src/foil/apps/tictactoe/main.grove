-  code %/main
-  hand_stdlib  ?/y;~whoever/stdlib/hands

\  validate_game_state=path
   init_game_state=path
   render_game_state=path
   square_state=path  ') to role

' slots declaration
= square
 !  content  code#square ') x/o/nothing

') root node slots
: hand [code#validate_game_state code#init_game_state]
: face [code#render_game_state]
: current_turn code#square
: won  unit[square]

') child declarations
+ squares
  * ud
    ' /  squares /[ud]/[ud]
    *  ud square

/squares/[ud]/[ud]:
  content: x/o or nothing

init_game_state:
  set all /squares/[1..3][1..3] to content: nothing
  set current_turn: square+'x'

validate_game:
  for /squares/[ud]/[ud] changes
  assert that change == current_turn
  flip current_turn
  check_win

render_game_state:
  /squares -> html

