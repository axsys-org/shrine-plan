-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  watch: standing queries as a shrine app — the materialized-view
'  primitive, packaged.  A QUERY NODE is an ordinary record carrying
'  a spec (['q 'under] the subtree to watch, plus filters) and the
'  query kook; the kook's init derives a crew from the spec, and its
'  hear rescans on any committed change, writing ['results] and
'  ['n] back onto the node.  Results are namespace state like
'  everything else: browsable, embeddable in a wiki page through
'  /doc/embed, scrubbable through /h — a saved search whose history
'  is the history of its answers.
'
'  The seeded demo compounds with the shape contracts (lain's
'  ['sys 'lash] gate): q1 watches this app's own subtree in curb
'  mode, reporting every record that BREAKS its own adopted
'  contract.  The pen seed carries a numeric ['status] and no lash;
'  adopt one live —
'    poke /app/watch/pen with
'    (myth/sing ['sys 'lash] ((lash/texted ['status] "status: text required")))
'  — and q1's count goes to one (legacy data a later contract
'  disowns).  Fix the status with text and it drops back to zero;
'  try to poke a NUMBER into status now and the kernel refuses the
'  event outright ('curb_type).
+  path_at
  '  A path-valued slot, or the empty path.
  \ slot=path t=myth
  ^ path
  | (myth/path_at slot t).fall []
+  has_text
  '  Does cord s contain needle sub?  Byte scan, corpus-sized.
  '  ?=  ((has_text "urge" "live surgery works") 1)
  '  ?=  ((has_text "xyz" "abc") 0)
  '  ?=  ((has_text 0 "abc") 1)
  \ sub=nat s=nat
  ^ bool
  | cord/has sub s
+  rec_text
  '  Does any text slot of the record contain the needle?
  \  sub=nat t=myth
  ^  bool
  =  hit
       \  e=mop/kv[path pail]
       ^  bool
       ?  e.val
        > tp=pails/t  (has_text sub tp.t)
       .false
  t.tap.any(hit)
+  query_hit
  '  One record judged against the query spec.  Curb mode reports
  '  contract breaks (lain/fit_check); otherwise the filters conjoin
  '  — ['q 'slot] presence, ['q 'text] substring over text slots —
  '  and a spec with no filters matches nothing.
  \  spec=myth t=myth
  ^  bool
  ?  spec.nat_at(['q 'curb] 0)
     ?=((./some _) (fit_check t))
  =  tx  (myth/txt_at ['q 'text] spec)
     sl  (path_at ['q 'slot] spec)
  ?  sl.len
     ?  !(myth/has_at sl t)
        .false
     ?  (eq 0 tx)
        .true
     (rec_text tx t)
  ?  (eq 0 tx)
     .false
  (rec_text tx t)
+  query_init
  '  Aim the standing query: the crew watches the spec'd subtree at
  '  z care, so any committed change under it wakes the hear.  A
  '  spec with no ['q 'under] is inert.
  \  b=bowl t=myth
  ^  yell
  =  under  (path_at ['q 'under] t)
  ?  (eq 0 under.len)
     (yell [] t)
  (yell [] t.put(crew_slot (cpail (crew/sing ['view] (dep .z under)))))
+  query_hear
  '  The rescan: every record in the hydrated view through the
  '  spec, hits written back as ['results] (absolute paths) and
  '  ['n].  The recomputation is deterministic and pokes resolve by
  '  deep value equality, so the self-watch (a query watching its
  '  own subtree sees its own results land) reaches its fixpoint
  '  one round after any real change.
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  view   b.crew.gut(['view] (axal/new[myth] .none))
     under  (path_at ['q 'under] cur)
     self
       ?  (lt under.len b.here.len.inc)
          b.here.drop(under.len)
       []
  =  es  view.tap
  =  hits
       %    i=nat 0    out=row[path] []
       ?  (ge i es.len)
          out
       =  [p t]  es.at(i)
       ?  (equal p self)
          (_ i.inc out)
       ?  (query_hit cur t)
          (_ i.inc out.snoc(under.weld(p)))
       (_ i.inc out)
  =  c1  cur.put(['results] (pails/ps hits))
  (yell [] c1.put(['n] (pd hits.len)))
+  query_talk
  '  Default merge, then re-aim: a poked spec re-derives the crew so
  '  a query can be retargeted in place.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  d (def_talk b cur nu)
  =  t d.out
  =  under  (path_at ['q 'under] t)
  ?  (eq 0 under.len)
     (yell d.cards t)
  (yell d.cards t.put(crew_slot (cpail (crew/sing ['view] (dep .z under)))))
+  query_form
  '  The standing-query behavior: init aims, hear rescans, talk
  '  re-aims.
  ^  form
  def_form.set_init(query_init).set_talk(query_talk).set_hear(query_hear)
+  q_html
  '  The query component's projection: the count line and one link
  '  per hit — a pure function of the query node's record, so the
  '  view is live wherever it is mounted and scrubs with /h.
  \  t=myth
  ^  myth
  =  n  t.nat_at(['n] 0)
  =  link
       \  p=path
       ^  weft/node
       (weft/el "div" [(weft/cls "item")]
         [(weft/leaf "a" [(weft/href (weft/cat2 "/ns" (show/path p)))] (show/path p))])
  =  links
       ?  t.get(['results])
        > (./some held=pail)
          ?  held
           > ps=pails/ps  ps.ps.map(link)
          []
        > .none  []
  =  head  [(weft/el "div" [(weft/cls "muted")]
             [(weft/tx (weft/cat ["matches: " (weft/show_nat n)]))])]
  (frag/html "div" [] head.weld(links))
+  q_view
  '  The query component: a dyed over the query node's record
  '  (results and count are slots — x input).
  ^  pail
  (dyed q_html .none)
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  face_page
  '  The container: the demo query mounted live, plus the scrubber —
  '  a standing query's history is the history of its answers.
  \  root=path first=nat top=nat
  ^  nat
  =  scrub=row[weft/node]
       ?  top
          [(frag/scrubber first top)]
       []
  =  body
       [(weft/leaf "h1" [] "watch")
        (weft/el "div" [(weft/cls "muted")]
          [(weft/tx "standing queries: saved searches the namespace keeps answered. q1 watches this subtree for contract breaks.")])
        (frag/mount "q1" root.weld(['weft 'q]) root.weld(['q1]) 2)]
  (weft/page "watch" explorer/css body.weld(scrub).snoc(frag/script))
+  face_talk
  '  The app's HTTP face: the container page for the request
  '  target's mount root.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       | (myth/path_at ['vpath] out).fall []
     page  (face_page (root_of tgt) (frag/ver_nat b ['first]) (frag/ver_nat b ['top]))
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd page))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  pen_seed
  '  The legacy record: a numeric ['status] and no contract — the
  '  thing a later-adopted lash disowns and q1 then finds.
  ^  myth
  =  t  (myth/new).put(['status] (pd 7))
  t.put(['lede] (pails/t "a demo pen: status is a NUMBER. adopt a lash and watch q1 flag it."))
+  q1_seed
  '  The demo standing query: this app's own subtree, curb mode —
  '  every record that breaks its own adopted contract.
  ^  myth
  =  t  (kooked [(pact/rel ['kook 'query])])
  =  t2  t.put(['q 'under] (pails/p (pact/rel [])))
  t2.put(['q 'curb] (pd 1))
+  app
  '  The watch app: the standing-query kook, its demo query, the
  '  legacy pen, the query component, and the face.
  ^  mani
  (mani 'watch
        (lore "Standing queries: saved searches the namespace keeps answered."
              ["Standing queries: saved searches the namespace keeps answered."
               "A query node carries ['q 'under] (the subtree to watch) plus filters: ['q 'slot] presence, ['q 'text] substring, or ['q 'curb] contract breaks; the kook's hear rescans on any committed change and writes ['results] and ['n] back onto the node."
               "Results are records: browse them, embed them in a wiki page with /doc/embed, scrub their history with /h."]
              [])
        [(kook/decl 'query query_form (lore/line "The standing query: init aims the crew at ['q 'under], hear rescans and commits ['results]/['n], talk re-aims."))
         (kook/decl 'face face_form (lore/line "The HTML face: the demo query mounted live, with the scrubber."))]
        [[['pen] pen_seed]
         [['q1] q1_seed]
         [['weft 'q]
          (weft_card q_view (pact/rel ['q1])
            (lore "The query component: match count and hit links, a dyed over the query node's record."
                  ["The query component: match count and hit links, a dyed over the query node's record."
                   "Input: the x record of a standing-query node - ['n] as a nat, ['results] as a pails/ps row of paths."
                   "Output: a count line and one explorer link per hit."
                   "Point it at any node that keeps those two slots - any standing query, whatever its spec."]
                  []))]]
        [])
