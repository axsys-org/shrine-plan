-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
-  semidoc [order=90]
'  nenex: a personal wiki corpus on the namespace (v1 of the Nenex
'  proposal).  Documents are semidoc trees mounted as records under
'  /nenex/w/<name>, each carrying its own source and a doc kook:
'  init expands a fresh page from its source, talk re-expands the
'  delta on edit (poke present, make new, cull stale — one
'  transaction), so /h scrubs every revision of every page.  The w
'  container's hub kook watches its own subtree through a z-care
'  crew: its hear recomputes each page's ['links 'in] backlinks
'  (value-dedup makes the self-watch quiesce), and its talk answers
'  the index page's forms — ['post 'new] makes a page, ['post 'q]
'  scans the corpus and commits the query and its result paths as
'  ordinary slots, so searches are namespace objects with history.
'  Links between pages are written absolutely (;/nenex/w/<name>) —
'  that convention is what the backlink scan matches.  Page names
'  should stick to word characters (odd names will not URL-parse).
'  Future work, per the proposal: templates, transclusion, typed
'  relationship views, aliases beyond semidoc's lexical ones,
'  workspaces, imports, spellcheck, maintenance commands.
+  src_paths
  '  The node set a source expands to — the document's own record of
  '  what it wrote.  (bowl.kids is the care-y FRONTIER, one record
  '  deep, so the previous source is the diff's ground truth.)
  \  s=nat
  ^  row[path]
  ?  (eq 0 s)
     []
  =  [t kids]  (own_myth (parse s))
  (myths_kids [] kids).map((\ m m.p))
+  has_path
  '  Membership in a path row.
  \  p=path ps=row[path]
  ^  bool
  ps.any((eq_pith p))
+  sfound
  '  One search hit: the page, its score, and the explanation.
  :  p=path score=nat why=nat
+  found_insert
  '  Insert into a score-descending row (ties keep corpus order).
  \  f=sfound fs=row[sfound]
  ^  row[sfound]
  =  hi  fs.keep((\ e (ge e.score f.score)))
     lo  fs.keep((\ e (lt e.score f.score)))
  hi.snoc(f).weld(lo)
+  own_myth
  '  The doc node's own record for a parsed source: a single
  '  container node becomes the record itself; anything else gets a
  '  bare doc record with the whole tree as kids.
  \  tree=row[snode]
  ^  [t=myth kids=row[snode]]
  =  bare  [(myth/new).put(['kind] (pails/t "doc")) tree]
  ?  (eq 1 tree.len)
     =  nd  tree.at(0)
     ?  nd
      > (./doc _ _ kids)    [(node_myth nd) kids]
      > (./sect _ _ kids)   [(node_myth nd) kids]
      > (./item _ _ kids)   [(node_myth nd) kids]
      > (./quote _ _ kids)  [(node_myth nd) kids]
     bare
  bare
+  writ_at
  '  The upsert writ for one mount: poke what the old source wrote,
  '  make what it did not.
  \  here=path old=row[path] m=smount
  ^  [p=path q=writ]
  ?  (has_path m.p old)
     [here.weld(m.p) (writ/poke m.t)]
  [here.weld(m.p) (writ/make m.t)]
+  cull_at
  '  The cull writ for one stale path.
  \  here=path p=path
  ^  [p=path q=writ]
  [here.weld(p) (writ/cull)]
+  expand
  '  The document transaction: parse the source and re-expand this
  '  node's subtree against what the OLD source wrote — present
  '  nodes poke, new ones make, stale ones cull deepest-first — and
  '  the node's own record becomes the new document root, source and
  '  kook riding along.  One event, one epoch; /h keeps every prior
  '  revision addressable.
  \  b=bowl cur=myth src=nat oldsrc=nat
  ^  yell
  =  tree  (parse src)
  ?  (eq 0 tree.len)
     (yell [] cur.put(['err] (pails/t "empty document")))
  =  [ownt kids]  (own_myth tree)
  =  ms  (myths_kids [] kids)
  =  fresh  ms.map((\ m m.p))
  =  old  (src_paths oldsrc)
  =  upserts  ms.map((writ_at b.here old))
  =  stale  old.rev.keep((\ p !(has_path p fresh))).map((cull_at b.here))
  =  own  ownt.put(['src] (pails/t src))
  =  own2
       ?>  (./some kp) cur.get(limb_slot)
           own
       own.put(limb_slot kp)
  (yell stale.weld(upserts) own2)
+  doc_init
  '  A fresh page: the making card carries the source, init expands
  '  it — creation is one make.
  \  b=bowl t=myth
  ^  yell
  =  src  (myth/txt_at ['src] t)
  ?  (eq 0 src)
     (yell [] t)
  (expand b t src 0)
+  doc_talk
  '  An edit: posted source (the editor's /post field, or a direct
  '  ['src] poke) re-expands the delta.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  posted  (myth/txt_at ['post 'src] nu)
  =  src
       ?  posted
          posted
       (myth/txt_at ['src] nu)
  ?  (eq 0 src)
     (def_talk b cur nu)
  (expand b cur src (myth/txt_at ['src] cur))
+  doc_form
  '  The page behavior: init expands, talk re-expands.
  ^  form
  def_form.set_init(doc_init).set_talk(doc_talk)
+  sedge
  '  One outgoing edge: the predicate slot it rode (empty for a bare
  '  reference) and the path it targets.
  :  pred=path tgt=path
+  slot_edge
  '  The edge one slot declares, if any: path-valued slots outside
  '  ['id]; ['ref] rides untyped, anything else typed by its key.
  \  e=mop/kv[path pail]
  ^  maybe[sedge]
  ?  (eq 0 e.key.len)
     .none
  ?  (eq_pith e.key ['id])
     .none
  ?  e.val
   > pp=pails/p
     ?  (eq_pith e.key ['ref])
        (./some (sedge [] pp.p))
     (./some (sedge e.key pp.p))
  .none
+  myth_edges
  '  The edges on one record: every path-valued slot outside ['id],
  '  ['ref] rides untyped, anything else typed by its key.
  \  t=myth
  ^  row[sedge]
  t.tap.sift(slot_edge)
+  src_edges
  '  Every edge a page's SOURCE declares: parse and walk what it
  '  would mount.  The source is the diff's ground truth here for
  '  the same reason it is in /expand — pokes meld, so a withdrawn
  '  attribute lingers as a namespace slot, but a relation the
  '  source no longer declares must not survive as an edge.
  \  src=nat
  ^  row[sedge]
  ?  (eq 0 src)
     []
  =  [t kids]  (own_myth (parse src))
  (myth_edges t).weld((myths_kids [] kids).bind((\ m (myth_edges m.t))))
+  hub_init
  '  The corpus container: a z-care crew on its own subtree (built
  '  from the bowl, so any mount root works) and empty search slots.
  \  b=bowl t=myth
  ^  yell
  =  t2  t.put(crew_slot (cpail (crew/sing ['corpus] (dep .z b.here))))
  (yell [] t2.put(['q] (pails/t 0)).put(['results] (pails/ps [])))
+  score_hit
  '  Score one page against a query: body counts, title counts
  '  three-fold, plus a backlink bonus — none scoring means no hit.
  \  here=path q=nat e=uon/kv[axal[myth]]
  ^  maybe[sfound]
  >  ($ts _) e.key
      .none
  ?>  (./some t) e.val.fil
      .none
  =  body  (cord/count q (myth/txt_at ['src] t))
  =  title
       ?>  (./some head) e.val.get([($u 0)])
           0
       (cord/count q (myth/txt_at ['title] head))
  ?  (eq 0 (add body title))
     .none
  =  links
       ?>  (./some pl) t.get(['links 'in])
           0
       ?  pl
        > bp=pails/ps  bp.ps.len
       0
  =  why
       (weft/cat
         [(weft/show_nat body) " in body, "
          (weft/show_nat title) " in title, "
          (weft/show_nat links) " backlinks"])
  (./some (sfound here.snoc(e.key) (add body (add (mul 3 title) links)) why))
+  hub_talk
  '  The index page's verbs.  ['post 'new] makes a page whose making
  '  card carries a starter source and the doc kook (absolute — a
  '  runtime card is not rebased).  ['post 'q] scans every page's
  '  source and commits the query and its matches as slots: a search
  '  is a namespace object, and /h scrubs the query history.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  name  (myth/txt_at ['post 'new] nu)
  ?  name
     =  at  b.here.snoc(($ts name))
     =  starter
          (joined 10
            [(cord/cat ";. " (show/path at))
             ""
             (cord/cat "  ;= " name)
             ""
             "    A fresh page."])
     =  root=path  b.here.take(b.here.len.dec)
     =  kp  root.weld(['kook 'doc])
     (yell [[at (writ/make (kooked [kp]).put(['src] (pails/t starter)))]] cur)
  =  q  (myth/txt_at ['post 'q] nu)
  ?  (eq 0 q)
     (def_talk b cur nu)
  =  hits  b.crew.gut(['corpus] (axal/new[myth] .none)).kid_tap.sift((score_hit b.here q))
  =  found=row[sfound]  hits.fold([] (\ out f (found_insert f out)))
  (yell []
    cur.put(['q] (pails/t q)).put(['results] (pails/ps found.map((\ f f.p)))).put(['why] (pails/t (joined 10 found.map((\ f f.why))))))
+  cited_by
  '  The edges from page o into the subtree at tp, as incoming
  '  sedges — o itself (skip) casts no vote.
  \  here=path tp=path skip=iota o=uon/kv[axal[myth]]
  ^  row[sedge]
  ?  (eq_iota o.key skip)
     []
  ?>  ($ts _) o.key
      []
  =  src
       ?>  (./some om) o.val.fil
           0
       (myth/txt_at ['src] om)
  (src_edges src).keep((\ ed (pith_prefix tp ed.tgt))).map((\ ed (sedge ed.pred here.snoc(o.key))))
+  scard
  '  One relations card: the page and the poke that refreshes it.
  :  p=path q=writ
+  page_card
  '  One page's relations poke: ['links 'in] holds every citing
  '  page, ['links 'in <pred..>] the pages whose typed edges target
  '  it, and predicates the corpus no longer declares sweep to [].
  \  here=path ks=row[uon/kv[axal[myth]]] tgt=uon/kv[axal[myth]]
  ^  maybe[scard]
  ?>  ($ts _) tgt.key
      .none
  =  inb=path  ['links 'in]
  =  tp  here.snoc(tgt.key)
  =  incoming  ks.bind((cited_by here tp tgt.key))
  =  preds  (row/uniq[path] incoming.map((\ e e.pred)).keep((\ p p.len)))
  =  base  (myth/sing inb (pails/ps (row/uniq[path] incoming.map((\ e e.tgt)))))
  =  typed
       preds.fold(base ;
         \  acc pr
         =  srcs  (row/uniq[path] incoming.keep((\ e (eq_pith e.pred pr))).map((\ e e.tgt)))
         acc.put(inb.weld(pr) (pails/ps srcs)))
  =  swept
       ?>  (./some tm) tgt.val.fil
           typed
       tm.tap.fold(typed ;
         \  acc e
         ?  !(pith_prefix inb e.key)
            acc
         ?  (le e.key.len 2)
            acc
         ?  (has_path e.key.drop(2) preds)
            acc
         acc.put(e.key (pails/ps [])))
  (./some (scard tp (writ/poke swept)))
+  hub_hear
  '  The relations pass: any committed change under the corpus
  '  recomputes every page's incoming edges — ['links 'in] holds
  '  every citing page, and ['links 'in <pred..>] holds the pages
  '  whose typed edges (path-valued attribute slots) target it.
  '  Predicates that vanish re-poke as empty rows (pokes meld); the
  '  face skips empties.  Recomputation is deterministic and pokes
  '  resolve by deep value equality, so the self-watch reaches its
  '  fixpoint one round after any edit.
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  ks  b.crew.gut(['corpus] (axal/new[myth] .none)).kid_tap
  (yell ks.sift((page_card b.here ks)).map((\ c [c.p c.q])) cur)
+  hub_form
  '  The corpus behavior: init watches, talk answers the forms, hear
  '  maintains the backlinks.
  ^  form
  def_form.set_init(hub_init).set_talk(hub_talk).set_hear(hub_hear)
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  edit_form
  '  The wiki's pen: the committed source in a textarea, posting to
  '  the page's doc talk through /post.
  \  docp=path tgt=path src=nat
  ^  weft/node
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path docp)))
     (weft/cls "edit")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "back")
        (weft/att "value" (show/path tgt))] [])
     (weft/el "textarea"
       [(weft/att "name" "src") (weft/att "rows" "16")] [(weft/tx src)])
     (weft/leaf "button" [] "commit")])
+  hub_field_form
  '  A one-field form posting to the corpus container.
  \  wpath=path back=path field=nat label=nat
  ^  weft/node
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path wpath)))
     (weft/cls "hubform")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "back")
        (weft/att "value" (show/path back))] [])
     (weft/el "input"
       [(weft/att "type" "text") (weft/att "name" field)
        (weft/att "autocomplete" "off")] [])
     (weft/leaf "button" [] label)])
+  path_links
  '  A row of paths as links to their pages.
  \  ps=row[path]
  ^  row[weft/node]
  ps.bind((\ p [(weft/tx " ") (weft/leaf "a" [(weft/href (show/path p))] (show/path p))]))
+  spage
  '  One page's scan record: its name, key, source, and edges.
  :  name=nat key=iota src=nat edges=row[sedge]
+  page_scan
  '  One kid hydrated for a corpus pass, when it is a page.
  \  e=uon/kv[axal[myth]]
  ^  maybe[spage]
  ?>  ($ts name=nat) e.key
      .none
  =  src
       ?>  (./some t) e.val.fil
           0
       (myth/txt_at ['src] t)
  (./some (spage name e.key src (src_edges src)))
+  scan
  '  Every page hydrated for a corpus pass: name, key, source, edges.
  \  fat=axal[myth]
  ^  row[spage]
  fat.kid_tap.sift(page_scan)
+  mention_row
  '  The report line when o says t's name as a word without an edge.
  \  wpath=path t=spage o=spage
  ^  maybe[weft/node]
  ?  (eq_iota o.key t.key)
     .none
  ?  !(word_mention t.name o.src)
     .none
  =  tp=path  wpath.snoc(t.key)
  ?  o.edges.any((\ ed (pith_prefix tp ed.tgt)))
     .none
  =  op=path  wpath.snoc(o.key)
  (./some
    (weft/el "div" [(weft/cls "item")]
      [(weft/leaf "a" [(weft/href (show/path op))] (show/path op))
       (weft/tx "  mentions  ")
       (weft/leaf "a" [(weft/href (show/path tp))] t.name)
       (weft/tx "  without linking it")]))
+  mention_rows
  '  Unlinked mentions: page O's source says page T's name as a word
  '  but declares no edge to T — a connection that should probably
  '  exist.  Computed at render from the hydrated view: a bounded
  '  report, not kernel state.  Every page name is its own alias.
  \  wpath=path fat=axal[myth]
  ^  row[weft/node]
  =  pages  (scan fat)
  pages.bind((\ t pages.sift((mention_row wpath t))))
+  nenex_css
  ^  nat
  (weft/cat2 sd_css " .edit{display:flex;flex-direction:column;gap:.5em;margin-top:2em;border-top:1px solid #dde;padding-top:1em} textarea{font-family:monospace;font-size:.9em;padding:.5em} .edit button{align-self:flex-start} .hubform{display:flex;gap:.5em;margin:.6em 0} .query{margin:1em 0;padding:.5em;background:#f4f5f7;border-radius:6px} .backlinks{font-size:.85em;color:#667;margin:.6em 0}")
+  index_item
  '  One page's line on the index: its link and its title.
  \  wpath=path e=uon/kv[axal[myth]]
  ^  maybe[weft/node]
  ?>  ($ts name=nat) e.key
      .none
  =  title
       ?>  (./some head) e.val.get([($u 0)])
           0
       (myth/txt_at ['title] head)
  =  pp  wpath.snoc(e.key)
  (./some
    (weft/el "div" [(weft/cls "item")]
      [(weft/leaf "a" [(weft/href (show/path pp))] name)
       (weft/tx "  ")
       (weft/el "span" [(weft/cls "muted")] [(weft/tx title)])]))
+  hit_row
  '  One committed search hit: its link and its why line.
  \  pw=[path nat]
  ^  weft/node
  =  [pth why]  pw
  (weft/el "div" [(weft/cls "item")]
    [(weft/leaf "a" [(weft/href (show/path pth))] (show/path pth))
     (weft/tx "  ")
     (weft/el "span" [(weft/cls "muted")] [(weft/tx why)])])
+  index_page
  '  The corpus front page: every page listed with its title, the
  '  create and search forms, and the last committed query with its
  '  results.
  \  wpath=path tgt=path fat=axal[myth]
  ^  nat
  =  rows  fat.kid_tap.sift((index_item wpath))
  =  qrow=row[weft/node]
       ?>  (./some t) fat.fil
           []
       =  q  (myth/txt_at ['q] t)
       ?  (eq 0 q)
          []
       =  res=row[weft/node]
            ?>  (./some pl) t.get(['results])
                []
            ?>  ps=pails/ps pl
                []
            =  whys  (split_byte 10 (myth/txt_at ['why] t))
            (row/zip[path nat] ps.ps whys).map(hit_row)
       =  head=row[weft/node]
            [(weft/leaf "span" [(weft/cls "pred")] (weft/cat2 "last search: " q))]
       [(weft/el "div" [(weft/cls "query")] head.weld(res))]
  =  head=row[weft/node]
       [(weft/leaf "h1" [] "nenex")
        (weft/el "div" [(weft/cls "muted")] [(weft/tx "a personal wiki corpus; every page, edit, query, and backlink is namespace state")])]
  =  mentions  (mention_rows wpath fat)
  =  msec=row[weft/node]
       ?  (eq 0 mentions.len)
          []
       (mentions.cons((weft/leaf "h2" [] "unlinked mentions")))
  =  body
       head.weld(rows).weld(qrow).weld(msec).weld([(hub_field_form wpath tgt "new" "new page") (hub_field_form wpath tgt "q" "search")])
  (weft/page "nenex" nenex_css body)
+  back_row
  '  One incoming-edge row: the plain backlinks when the slot is
  '  ['links 'in], a predicate-labeled row beneath it, empties skipped.
  \  e=mop/kv[path pail]
  ^  maybe[weft/node]
  =  inb=path  ['links 'in]
  ?  !(pith_prefix inb e.key)
     .none
  ?>  ps=pails/ps e.val
      .none
  ?  (eq 0 ps.ps.len)
     .none
  =  label
       ?  (eq 2 e.key.len)
          "linked from:"
       (weft/cat2 (show/path e.key.drop(2)) ":")
  (./some
    (weft/el "div" [(weft/cls "backlinks")]
      (path_links ps.ps).cons((weft/tx label))))
+  in_rows
  '  The incoming-edge rows for a page: the plain backlinks and one
  '  row per typed predicate, empties skipped.
  \  t=myth
  ^  row[weft/node]
  t.tap.sift(back_row)
+  face_talk
  '  The corpus face: the container (or the app root) serves the
  '  index; anything deeper serves its document page with backlinks
  '  and the editor.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
  =  tgt=path
       ?>  (./some held) out.get(['vpath])
           []
       ?>  p=pails/p held
           []
       p.p
  =  view   b.crew.gut(['view] (axal/new[myth] .none))
     root   (root_of tgt)
     wpath  root.weld(['w])
  =  html
       ?  (le tgt.len wpath.len)
          =  fat
               ?  (eq tgt.len root.len)
                  view.dip(['w])
               view
          (index_page wpath tgt fat)
       =  docp=path  tgt.take(wpath.len.inc)
       =  bl
            ?>  (./some t) view.fil
                []
            (in_rows t)
       =  src
            ?>  (./some t) view.fil
                0
            (myth/txt_at ['src] t)
       =  body  (render_nodes (nodes_of view)).weld(bl).weld([(edit_form docp tgt src)])
       (weft/page "nenex" nenex_css body)
  (yell []
    out.put(['res_status] (pd 200)).put(['res_body] (pd html)).put(['res_ctype] (pd "text/html; charset=utf-8")))
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  home_src
  '  The seeded home page.
  ^  nat
  (joined 10
    [";. /nenex/w/home"
     ""
     "  ;= A programmable interior for thought"
     ""
     "    Every page here is a subtree of namespace records: edit"
     "    the source below and one transaction rebuilds the delta;"
     "    the /h overlay scrubs every revision of every page."
     ""
     "    ;- Pages link absolutely: see ;/nenex/w/ideas"
     ""
     "    ;- Searches commit their query and results as slots."
     ""
     "    ;@ /doc/interpret-as /formats/test"
     "    ;@ /doc/eval-with sept"
     ""
     "    ;$ foil"
     ""
     "      (eq 4 (add 2 2))"
     ""
     "    ;/nenex/w/ideas"])
+  ideas_src
  '  The seeded second page: a backlink target.
  ^  nat
  (joined 10
    [";. /nenex/w/ideas"
     ""
     "  ;= Ideas"
     ""
     "    ;@ /rel/supports ;/nenex/w/home"
     ""
     "    Somewhere for loose thoughts to accumulate structure."])
+  doc_seed
  '  A seeded page: source plus the doc kook (app-relative — the
  '  mount absolutizes it); the kook's init expands the content in
  '  the same mount transaction.
  \  src=nat
  ^  myth
  (kooked [['kook 'doc]]).put(['src] (pails/t src))
+  app
  '  The nenex app: the corpus container and its pages.
  ^  mani
  (mani 'nenex
        (lore "A personal wiki corpus: pages, edits, queries, and backlinks as namespace state."
              ["A personal wiki corpus: pages, edits, queries, and backlinks as namespace state."
               "Pages are semidoc trees at /nenex/w/<name>, each carrying its source and rebuilding its subtree from edits in one transaction; /h scrubs every revision."
               "The corpus container watches its own subtree: backlinks recompute reactively, and searches commit their query and result paths as ordinary slots."]
              [])
        [(kook/decl 'hub hub_form (lore/line "The corpus container: init watches the subtree, talk answers the create and search forms, hear maintains backlinks."))
         (kook/decl 'doc doc_form (lore/line "One page: init expands a fresh page from its source, talk re-expands the edit delta."))
         (kook/decl 'face face_form (lore/line "The HTML face: the index at the root, document pages with backlinks and the editor beneath."))]
        [[['w] (kooked [['kook 'hub]])]
         [['w 'home] (doc_seed home_src)]
         [['w 'ideas] (doc_seed ideas_src)]])
