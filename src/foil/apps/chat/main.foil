-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  surface [order=55]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  chat: a two-sided conversation as a shrine app with its own HTML
'  face.  Messages are numbered kids of the log node; the face's form
'  posts through the worker's /post endpoint, which pokes the log —
'  the log's talk arm appends the message kid in-kernel, so the
'  namespace write never leaves the kernel's authority.  The
'  conversation renders as a COMPONENT (a felt overlay at weft/log,
'  write-once) mounted into the container page as a /frag element the
'  /w.js runtime keeps fresh.  Mounted at the top-level /chat root
'  (helm-run's roots table), not under /app.
+  side_of
  '  The posting side, defaulting to a: only a and b exist.
  '  ?=  ((side_of "b") "b")
  '  ?=  ((side_of "x") "a")
  '  ?=  ((side_of 0) "a")
  \  s=nat
  ^  nat
  ?  (eq s "b")
     "b"
  "a"
+  log_talk
  '  A post poke appends one message: ['post 'who] and ['post 'text]
  '  become a numbered kid's ['who] and ['text], and the count
  '  advances.  The post slots themselves are never retained.  Pokes
  '  without a post payload meld as usual.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  text  (myth/txt_at ['post 'text] nu)
  ?  (eq 0 text)
     (def_talk b cur nu)
  =  who  (side_of (myth/txt_at ['post 'who] nu))
     n    cur.nat_at(['count] 0)
     msg
       .  (myth/new)
          put(['who] (pails/t who))
          put(['text] (pails/t text))
     card  [b.here.snoc(($u n)) (writ/make msg)]
  (yell [card] cur.put(['count] (pd n.inc)))
+  log_form
  '  The log behavior: talk appends.
  ^  form
  def_form.set_talk(log_talk)
+  log_seed
  '  The seeded log: empty, carrying the log kook (app-relative —
  '  the mount absolutizes it).
  ^  myth
  (kooked [(pact/rel ['kook 'log])]).put(['count] (pd 0))
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  chat_css
  ^  nat
  (weft/cat
    [surface/css
     ".plate-only-stage{display:grid;min-height:660px;place-items:center;padding:42px;background:linear-gradient(145deg,#e4e8eb,#f7f8f9)}.plate-only-stage>.chat-plate{width:min(700px,100%);height:560px}.scene-only-stage{height:660px;background:#d4d9de}.chat-plate{display:grid;height:100%;min-height:0;grid-template-rows:auto minmax(0,1fr) auto}.plate-state{color:var(--surface-green);font-size:9px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.chat-plate>#log{min-height:0;overflow:hidden}.message-thread{display:flex;height:100%;min-height:0;flex-direction:column;gap:9px;padding:16px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;background:linear-gradient(180deg,#f7f8f8,#fdfdfc)}.message{display:grid;max-width:min(76%,520px);grid-template-columns:28px minmax(0,1fr);align-items:end;gap:7px}.message.b{align-self:flex-end;grid-template-columns:minmax(0,1fr) 28px}.message-avatar{display:grid;width:28px;height:28px;place-items:center;border-radius:50%;background:#343b43;color:#fff;font-size:9px;font-weight:750;text-transform:uppercase}.message.b .message-avatar{grid-column:2}.message-body{min-width:0;padding:8px 10px;border:1px solid rgb(35 40 47/.08);border-radius:12px 12px 12px 4px;background:#e7edf5}.message.b .message-body{grid-column:1;grid-row:1;border-radius:12px 12px 4px 12px;background:#e1f2e8}.message-body .who{display:block;margin-bottom:2px;color:var(--surface-muted);font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.message-body p{margin:0;overflow-wrap:anywhere}.composer{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px;padding:10px;border-top:1px solid var(--surface-line);background:#fbfbfa}.side-picker{display:flex;gap:3px}.side-choice{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--surface-line);border-radius:7px;color:var(--surface-muted);font-size:9px;font-weight:750;text-transform:uppercase}.side-choice:has(input:checked){border-color:rgb(23 105 224/.42);background:#e8f0fd;color:var(--surface-blue)}.side-choice input{position:absolute;width:1px;height:1px;opacity:0}.composer input[type=text]{width:100%;min-width:0;padding:7px 9px;border:1px solid var(--surface-line-strong);border-radius:7px;background:#fff;color:var(--surface-ink)}.composer button{padding:7px 12px;border:0;border-radius:7px;background:#252a30;color:#fff;font-weight:650}.empty-thread{margin:auto;color:var(--surface-muted);font-size:11px}.scene-shell>.scene-workspace>.chat-plate{min-height:480px}@media(max-width:760px){.plate-only-stage{min-height:580px;padding:12px}.plate-only-stage>.chat-plate{height:540px}.scene-only-stage{height:580px}.message{max-width:90%}.composer{grid-template-columns:auto minmax(0,1fr)}.composer button{grid-column:1/-1}.scene-shell>.scene-workspace>.chat-plate{min-height:430px}}"])
+  msg_nodes
  '  The conversation, oldest first: the log's numbered kids in
  '  their natural order, each a bubble on its side.
  \  log=axal[myth]
  ^  row[weft/node]
  =  kids  log.kid_tap
  |  > i=nat 0  > out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  who  (side_of (myth/txt_at ['who] t))
     =  nd
          (weft/el "article" [(weft/cls (weft/cat2 "message msg " who))]
            [(weft/leaf "span" [(weft/cls "message-avatar")] who)
             (weft/el "div" [(weft/cls "message-body")]
               [(weft/leaf "strong" [(weft/cls "who")] who)
                (weft/leaf "p" [] t.txt_at(['text]))])])
     (_ i.inc out.snoc(nd))
+  side_input
  '  One side of the picker: a labeled radio button.
  \  v=nat checked=nat
  ^  weft/node
  =  as
       ?  checked
          [(weft/att "type" "radio") (weft/att "name" "who")
           (weft/att "value" v) (weft/att "checked" "checked")]
       [(weft/att "type" "radio") (weft/att "name" "who")
        (weft/att "value" v)]
  (weft/el "label" [(weft/cls "side-choice")]
    [(weft/el "input" as []) (weft/tx v)])
+  log_html
  '  The log component's projection: the conversation as bubbles,
  '  oldest first — a pure function of the log subtree, its markup
  '  riding the ['html] slot for the /frag responder.
  \  fat=axal[myth]
  ^  myth
  =  msgs  (msg_nodes fat)
     kids
       ?  (eq 0 msgs.len)
          [(weft/leaf "p" [(weft/cls "empty-thread")] "No messages yet. Send the first one.")]
       msgs
  (frag/html "div" [(weft/cls "message-thread")] kids)
+  log_view
  '  The log component: a felt over the log subtree (messages are
  '  kids, so the input is the z view).
  ^  pail
  (felt log_html .none)
+  specimen_seg
  '  Only the four admitted presentation layers are routeable.
  \  seg=iota
  ^  nat
  ?  (eq_iota seg 'plate)
     "plate"
  ?  (eq_iota seg 'shrine)
     "shrine"
  ?  (eq_iota seg 'desktop)
     "desktop"
  "scene"
+  specimen_of
  '  The selected presentation layer.  /chat and non-specimen chat
  '  paths retain the useful scene default.
  \  tgt=path
  ^  nat
  ?  (lt tgt.len 2)
     "scene"
  ?  (eq_iota tgt.at(0) 'app)
     ?  (lt tgt.len 3)
        "scene"
     (specimen_seg tgt.at(2))
  (specimen_seg tgt.at(1))
+  specimen_link
  \  root=path current=nat own=nat label=nat
  ^  weft/node
  =  href  (weft/cat [(show/path root) "/" own])
     as
       ?  (eq current own)
          [(weft/href href) (weft/att "aria-current" "page")]
       [(weft/href href)]
  (weft/leaf "a" as label)
+  specimen_nav
  \  root=path current=nat
  ^  weft/node
  (weft/el "nav" [(weft/cls "surface-nav") (weft/att "aria-label" "Chat projection layers")]
    [(specimen_link root current "plate" "Chat Plate")
     (specimen_link root current "scene" "Chat Scene")
     (specimen_link root current "shrine" "Shrine Scene")
     (specimen_link root current "desktop" "Desktop Stage")])
+  chat_form
  '  Existing /post and w-refresh protocol, shared by every shell.
  \  logp=path back=nat
  ^  weft/node
  (weft/el "form"
    [(weft/cls "composer")
     (weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path logp)))
     (weft/att "w-post" "1") (weft/att "w-refresh" "log")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "back")
        (weft/att "value" back)] [])
     (weft/el "span" [(weft/cls "side-picker")]
       [(side_input "a" 1) (side_input "b" 0)])
     (weft/el "input"
       [(weft/att "type" "text") (weft/att "name" "text")
        (weft/att "aria-label" "Message")
        (weft/att "placeholder" "Write a message")
        (weft/att "autocomplete" "off")] [])
     (weft/leaf "button" [] "Send")])
+  chat_plate
  '  One occurrence lifted into a renderer-local Plate.
  \  root=path back=nat
  ^  weft/node
  =  logp=path  root.weld(['log])
  (weft/el "article"
    [(weft/cls "plate chat-plate") (weft/att "data-active" "true")]
    [(weft/el "header" [(weft/cls "plate-header")]
       [(weft/leaf "span" [(weft/cls "plate-kind")] "C")
        (weft/el "span" [(weft/cls "plate-header-copy")]
          [(weft/leaf "strong" [] "General")
           (weft/leaf "code" [] (show/path logp))])
        (weft/leaf "span" [(weft/cls "plate-state")] "live")])
     (frag/mount "log" root.weld(['weft 'log]) logp .z)
     (chat_form logp back)])
+  chat_sidebar
  \  root=path
  ^  weft/node
  =  href  (weft/cat2 (show/path root) "/scene")
  (weft/el "aside" [(weft/cls "scene-sidebar") (weft/att "aria-label" "Conversations")]
    [(weft/leaf "h2" [(weft/cls "sidebar-heading")] "Conversations")
     (weft/el "a" [(weft/cls "sidebar-item active") (weft/href href)]
       [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "G")
        (weft/el "span" [(weft/cls "sidebar-copy")]
          [(weft/leaf "strong" [] "General")
           (weft/leaf "small" [] "The live conversation")])
        (weft/leaf "span" [(weft/cls "sidebar-badge")] "now")])
     (weft/el "a" [(weft/cls "sidebar-item") (weft/href href)]
       [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "F")
        (weft/el "span" [(weft/cls "sidebar-copy")]
          [(weft/leaf "strong" [] "Foundry")
           (weft/leaf "small" [] "Projection notes")])])
     (weft/el "a" [(weft/cls "sidebar-item") (weft/href href)]
       [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "R")
        (weft/el "span" [(weft/cls "sidebar-copy")]
          [(weft/leaf "strong" [] "Random")
           (weft/leaf "small" [] "Another occurrence")])])])
+  chat_scene
  '  The Plate composed with sibling navigation into a Scene.
  \  root=path back=nat
  ^  weft/node
  (weft/el "section" [(weft/cls "scene-shell")]
    [(weft/el "header" [(weft/cls "scene-chrome")]
       [(weft/el "span" [(weft/cls "scene-chrome-title")]
          [(weft/leaf "strong" [] "Chat")
           (weft/tx " / a projected conversation scene")])])
     (chat_sidebar root)
     (weft/el "main" [(weft/cls "scene-workspace")]
       [(chat_plate root back)])])
+  specimen_title
  \  kind=nat
  ^  nat
  ?  (eq kind "plate")
     "Chat Plate"
  ?  (eq kind "shrine")
     "Chat Scene Plate in Shrine"
  ?  (eq kind "desktop")
     "Shrine Scene Plate on a Desktop Stage"
  "Chat Scene"
+  specimen_note
  \  kind=nat
  ^  nat
  ?  (eq kind "plate")
     "occurrence -> Plate"
  ?  (eq kind "shrine")
     "Scene -> Scene Plate + serving chrome"
  ?  (eq kind "desktop")
     "Scene Plate -> resizable Stage window"
  "Plate + sibling navigation -> Scene"
+  specimen_body
  \  kind=nat root=path back=nat
  ^  weft/node
  ?  (eq kind "plate")
     (weft/el "section"
       [(weft/cls "plate-only-stage") (weft/att "data-plate-specimen" "true")]
       [(chat_plate root back)])
  ?  (eq kind "shrine")
     (weft/el "section"
       [(weft/cls "root-scene") (weft/att "data-shrine-specimen" "true")]
       [(weft/el "article" [(weft/cls "scene-plate-window")]
          [(surface/window_chrome "Chat" "Scene Plate / Shrine root")
           (weft/el "div" [(weft/cls "window-content")]
             [(chat_scene root back)])])])
  ?  (eq kind "desktop")
     (weft/el "section"
       [(weft/cls "desktop-stage") (weft/att "data-desktop-specimen" "true")]
       [(weft/el "article" [(weft/cls "stage-window secondary")]
          [(surface/window_chrome "Namespace" "Scene Plate / background")
           (weft/el "div" [(weft/cls "stage-note")]
             [(weft/el "span" []
               [(weft/leaf "strong" [] "Another Scene Plate")
                (weft/tx "A passive sibling establishes the Stage composition.")])])])
        (weft/el "article" [(weft/cls "stage-window primary")]
          [(surface/window_chrome "Chat" "Scene Plate / foreground")
           (weft/el "div" [(weft/cls "window-content")]
             [(chat_scene root back)])])])
  (weft/el "section"
    [(weft/cls "scene-only-stage") (weft/att "data-scene-specimen" "true")]
    [(chat_scene root back)])
+  chat_page
  '  Four nested, renderer-local views of the same chat occurrence.
  '  The only client code remains the existing fragment/post helper.
  \  root=path tgt=path
  ^  nat
  =  kind  (specimen_of tgt)
     back  (show/path tgt)
     body
       [(weft/el "div" [(weft/cls "surface-page") (weft/att "data-specimen" kind)]
          [(specimen_nav root kind)
           (weft/el "section" [(weft/cls "specimen-frame")]
             [(weft/el "header" [(weft/cls "specimen-caption")]
                [(weft/leaf "strong" [] (specimen_title kind))
                 (weft/leaf "span" [] (specimen_note kind))])
              (specimen_body kind root back)])])
        frag/script]
  (weft/page (specimen_title kind) chat_css body)
+  face_talk
  '  The app's HTTP face: the container page for the request target's
  '  mount root.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       ?  out.get(['vpath])
        > (./some held=pail)
          ?  held
           > p=pails/p  p.p
          []
        > .none  []
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd (chat_page (root_of tgt) tgt)))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  app
  '  The chat app: the log and its face.
  ^  mani
  (mani 'chat
        (lore "A two-sided chat, served as its own page."
              ["A two-sided chat, served as its own page."
               "Messages are numbered kids of the log node; the face's form posts through the /post endpoint, and the log's talk arm appends each message in-kernel."
               "Pick a side (a or b), type, send.  The page refreshes its log in place, so a conversation held in two windows converges by itself."]
              [])
        [(kook/decl 'log log_form (lore/line "The log: a post poke appends a numbered message kid and advances the count."))
         (kook/decl 'face face_form (lore/line "The HTML face: the container page — the log fragment plus the posting form."))]
        [[['log] log_seed]
         [['weft 'log]
          (weft_card log_view (pact/rel ['log])
            (lore "The log component: the conversation as bubbles, a felt over the log subtree."
                  ["The log component: the conversation as bubbles, a felt over the log subtree."
                   "Input: the z view of a log node - numbered kids each carrying ['who] and ['text]; the ['count] slot is ignored."
                   "Output: a div of .msg bubbles, oldest first, each tagged with its side (a left, b right)."
                   "Point it at any node whose kids look like messages - the log's shape is the whole contract."]
                  []))]])
