-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  chat: a two-sided conversation as a shrine app with its own HTML
'  face.  Messages are numbered kids of the log node; the face's form
'  posts through the worker's /post endpoint, which pokes the log —
'  the log's talk arm appends the message kid in-kernel, so the
'  namespace write never leaves the kernel's authority.  The page
'  refreshes its log in place each second.  Mounted at the top-level
'  /chat root (helm-run's roots table), not under /app.
+  side_of
  '  The posting side, defaulting to a: only a and b exist.
  '  ?=  ((side_of "b") "b")
  '  ?=  ((side_of "x") "a")
  '  ?=  ((side_of 0) "a")
  \  s=nat
  ^  nat
  ?  (eq s "b")
     "b"
  "a"
+  log_talk
  '  A post poke appends one message: ['post 'who] and ['post 'text]
  '  become a numbered kid's ['who] and ['text], and the count
  '  advances.  The post slots themselves are never retained.  Pokes
  '  without a post payload meld as usual.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  text  (myth/txt_at ['post 'text] nu)
  ?  (eq 0 text)
     (def_talk b cur nu)
  =  who  (side_of (myth/txt_at ['post 'who] nu))
     n    cur.nat_at(['count] 0)
     msg
       .  (myth/new)
          put(['who] (pails/t who))
          put(['text] (pails/t text))
     card  [b.here.snoc(($u n)) (writ/make msg)]
  (yell [card] cur.put(['count] (pd n.inc)))
+  log_form
  '  The log behavior: talk appends.
  ^  form
  def_form.set_talk(log_talk)
+  log_seed
  '  The seeded log: empty, carrying the log kook (app-relative —
  '  the mount absolutizes it).
  ^  myth
  (kooked [['kook 'log]]).put(['count] (pd 0))
+  log_of
  '  The log subtree in a hydrated target view: the target may be
  '  the app root (the log rides as the ['log] kid) or the log node
  '  itself (its record carries the count).
  \  view=axal[myth]
  ^  axal[myth]
  =  sub  view.dip(['log])
  ?  sub.fil
   > (./some t=myth)  sub
   > .none
     ?  view.fil
      > (./some t2=myth)
        ?  (myth/has_at ['count] t2)
           view
        sub
      > .none  sub
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  chat_css
  ^  nat
  "body{font-family:sans-serif;max-width:40em;margin:2em auto;padding:0 1em} h1{font-size:1.2em;color:#345} #log{display:flex;flex-direction:column;gap:.4em;margin:1em 0} .msg{padding:.5em .8em;border-radius:1em;max-width:70%} .a{background:#dde8ff;align-self:flex-start} .b{background:#d8f5d8;align-self:flex-end} .who{font-size:.7em;color:#667} form{display:flex;gap:.5em;align-items:center} input[type=text]{flex:1;padding:.4em}"
+  refresh_js
  '  Replace the log in place from a fresh render: a reload would
  '  wipe the form, so only the log node's markup is swapped.
  ^  nat
  "setInterval(function(){fetch(location.href).then(function(r){return r.text()}).then(function(t){var d=new DOMParser().parseFromString(t,'text/html');var n=d.getElementById('log');var o=document.getElementById('log');if(n&&o){o.innerHTML=n.innerHTML}})},1000)"
+  msg_nodes
  '  The conversation, oldest first: the log's numbered kids in
  '  their natural order, each a bubble on its side.
  \  log=axal[myth]
  ^  row[weft/node]
  =  kids  log.kid_tap
  |  > i=nat 0  > out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  who  (side_of (myth/txt_at ['who] t))
     =  nd
          (weft/el "div" [(weft/cls (weft/cat2 "msg " who))]
            [(weft/el "div" [(weft/cls "who")] [(weft/tx who)])
             (weft/tx t.txt_at(['text]))])
     (_ i.inc out.snoc(nd))
+  side_input
  '  One side of the picker: a labeled radio button.
  \  v=nat checked=nat
  ^  weft/node
  =  as
       ?  checked
          [(weft/att "type" "radio") (weft/att "name" "who")
           (weft/att "value" v) (weft/att "checked" "checked")]
       [(weft/att "type" "radio") (weft/att "name" "who")
        (weft/att "value" v)]
  (weft/el "label" [] [(weft/el "input" as []) (weft/tx v)])
+  chat_page
  '  The whole page: the conversation, the posting form (side picker,
  '  text, send), and the in-place refresh timer.
  \  root=path log=axal[myth]
  ^  nat
  =  logp=path  root.weld(['log])
  =  post_url  (weft/cat2 "/post" (show/path logp))
     back_url  (show/path root)
     body
       [(weft/leaf "h1" [] "chat")
        (weft/el "div" [(weft/att "id" "log")] (msg_nodes log))
        (weft/el "form"
          [(weft/att "method" "post") (weft/att "action" post_url)]
          [(weft/el "input"
             [(weft/att "type" "hidden") (weft/att "name" "back")
              (weft/att "value" back_url)] [])
           (side_input "a" 1)
           (side_input "b" 0)
           (weft/el "input"
             [(weft/att "type" "text") (weft/att "name" "text")
              (weft/att "autocomplete" "off")] [])
           (weft/leaf "button" [] "send")])
        (weft/el "script" [] [(weft/raw refresh_js)])]
  (weft/page "chat" chat_css body)
+  face_talk
  '  The app's HTTP face: render the conversation from the hydrated
  '  request target.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       ?  out.get(['vpath])
        > (./some held=pail)
          ?  held
           > p=pails/p  p.p
          []
        > .none  []
     view  b.crew.gut(['view] (axal/new[myth] .none))
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd (chat_page (root_of tgt) (log_of view))))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  app
  '  The chat app: the log and its face.
  ^  mani
  (mani 'chat
        (lore "A two-sided chat, served as its own page."
              ["A two-sided chat, served as its own page."
               "Messages are numbered kids of the log node; the face's form posts through the /post endpoint, and the log's talk arm appends each message in-kernel."
               "Pick a side (a or b), type, send.  The page refreshes its log in place, so a conversation held in two windows converges by itself."]
              [])
        [(kook/decl 'log log_form (lore/line "The log: a post poke appends a numbered message kid and advances the count."))
         (kook/decl 'face face_form (lore/line "The HTML face: renders the conversation and the posting form; the log refreshes in place."))]
        [[['log] log_seed]])
