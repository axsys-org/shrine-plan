-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  surface_tree [order=55]
-  foundry [order=60]
-  foundry_doc [order=65]
-  foundry_corpus [order=68]
-  foundry_delivery [order=70]
-  foundry_action [order=72]
-  foundry_pronounce [order=75]
-  foundry_pronounce_walk [order=76]
-  foundry_wire [order=80]
-  chat_foundry_projection [order=82]
-  chat_foundry_pronunciation [order=84]
-  chat_foundry_frames [order=86]
-  surface [order=90]
-  pact [order=100]
-  web [order=110]
-  lainapp [order=120]
'  chat: a two-sided conversation as a shrine app with its own HTML
'  face.  Messages are numbered kids of the log node; the face's form
'  posts through the worker's /post endpoint, which pokes the log —
'  the log's talk arm appends the message kid in-kernel, so the
'  namespace write never leaves the kernel's authority.  The
'  conversation renders as a COMPONENT (a felt overlay at weft/log,
'  write-once) mounted into the container page as a /frag element the
'  /w.js runtime keeps fresh.  Mounted at the top-level /chat root
'  (helm-run's roots table), not under /app.
+  side_of
  '  The posting side, defaulting to a: only a and b exist.
  '  ?=  ((side_of "b") "b")
  '  ?=  ((side_of "x") "a")
  '  ?=  ((side_of 0) "a")
  \  s=nat
  ^  nat
  ?  (eq s "b")
     "b"
  "a"
+  message_record
  '  One semantic source message record, useful to producers and tests.
  \  who=nat body=nat
  ^  myth
  .  (myth/new)
     put(['who] (pails/t (side_of who)))
     put(['text] (pails/t body))
+  log_talk
  '  A post poke appends one message: ['post 'who] and ['post 'text]
  '  become a numbered kid's ['who] and ['text], and the count
  '  advances.  The post slots themselves are never retained.  Pokes
  '  without a post payload meld as usual.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  text  (myth/txt_at ['post 'text] nu)
  ?  (eq 0 text)
     (def_talk b cur nu)
  =  who  (side_of (myth/txt_at ['post 'who] nu))
     n    cur.nat_at(['count] 0)
     msg
       .  (myth/new)
          put(['who] (pails/t who))
          put(['text] (pails/t text))
     card  [b.here.snoc(($u n)) (writ/make msg)]
  (yell [card] cur.put(['count] (pd n.inc)))
+  log_form
  '  The log behavior: talk appends.
  ^  form
  def_form.set_talk(log_talk)
+  log_seed
  '  The seeded log: empty, carrying the log kook (app-relative —
  '  the mount absolutizes it).
  ^  myth
  (kooked [(pact/rel ['kook 'log])]).put(['count] (pd 0))
+  source_seed
  '  Stable semantic source occurrence at /chat/source.  Its content
  '  pin owns projection identity; the mutable log remains a separate z-care
  '  branch, while the /chat root's app manifest remains mechanical.  Neither
  '  can churn the already-resolved outer shell.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'occurrence))
     put(['semantic 'role] (pails/p ['chat 'conversation]))
+  send_action_seed
  '  Source-owned semantic send declaration at /chat/actions/send.  It names
  '  the log as its stateful subject, but never names the log kook/form, a Web
  '  endpoint, or an admitted actor/capability witness.  Every path value is
  '  app-relative and is absolutized by pact when this app mounts.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'action))
     put(['action 'identity] (pails/p (pact/rel ['actions 'send])))
     put(['action 'subject] (pails/p (pact/rel ['log])))
     put(['action 'input] (pails/p (pact/rel ['contracts 'send_message])))
     put(['action 'requirements]
       (pails/ps [(pact/rel ['capabilities 'send_message])]))
     put(['action 'attenuation]
       (pails/ps [(pact/rel ['interaction 'send_message])]))
     put(['action 'result]
       (pails/p (pact/rel ['policies 'send_result])))
     put(['action 'refusal]
       (pails/p (pact/rel ['policies 'send_refusal])))
     put(['action 'receipt]
       (pails/p (pact/rel ['contracts 'action_receipt])))
+  send_message_contract_seed
  '  Typed input contract named by the Action mount.  These are semantic
  '  fields, not HTML form controls; a terminal may spell them differently.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'action_input_contract))
     put(['contract 'identity]
       (pails/p (pact/rel ['contracts 'send_message])))
     put(['contract 'required] (pails/ps [['who] ['text]]))
     put(['contract 'field 'who] (pails/q 'chat_side))
     put(['contract 'field 'text] (pails/q 'text))
+  send_capability_seed
  '  Capability DEFINITION required by send.  Its presence grants nothing;
  '  an actor/Space resolver must still place this identity in the effective
  '  capability intersection supplied to foundry_action/admit.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'capability))
     put(['capability 'identity]
       (pails/p (pact/rel ['capabilities 'send_message])))
     put(['capability 'action]
       (pails/p (pact/rel ['actions 'send])))
+  send_interaction_seed
  '  The target-declared narrowing contract which must survive every active
  '  Space/Scene/Plate/Block/Slot envelope.  It is a ceiling, not a grant.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'interaction_contract))
     put(['interaction 'identity]
       (pails/p (pact/rel ['interaction 'send_message])))
     put(['interaction 'action]
       (pails/p (pact/rel ['actions 'send])))
     put(['interaction 'law] (pails/q 'narrow_only))
+  send_result_seed
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'action_result_policy))
     put(['policy 'identity]
       (pails/p (pact/rel ['policies 'send_result])))
     put(['result 'kind] (pails/q 'message_appended))
     put(['result 'subject] (pails/p (pact/rel ['log])))
     put(['result 'trace] (pails/q 'committed))
+  send_refusal_seed
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'action_refusal_policy))
     put(['policy 'identity]
       (pails/p (pact/rel ['policies 'send_refusal])))
     put(['refusal 'kind] (pails/q 'explicit))
     put(['refusal 'receipt]
       (pails/p (pact/rel ['contracts 'action_receipt])))
+  action_receipt_seed
  '  Policy shape for the server-authored interaction receipt.  The Action
  '  declaration references it; no client or Surface fabricates the receipt.
  ^  myth
  .  (myth/new)
     put(['semantic 'kind] (pails/q 'action_receipt_contract))
     put(['contract 'identity]
       (pails/p (pact/rel ['contracts 'action_receipt])))
     put(['contract 'required]
       (pails/ps
         [['actor] ['target] ['action] ['input] ['context] ['outcome]]))
+  desktop_layout_apply
  '  Pure law behind the Desktop layout kook.  It is exposed separately so
  '  Get-Put and Put-Get can be checked without fabricating a kernel event.
  \  cur=myth nu=myth
  ^  myth
  =  width  nu.nat_at(['geometry 'width] 0)
     height nu.nat_at(['geometry 'height] 0)
  ?  (eq 0 width)
     cur
  ?  (eq 0 height)
     cur
  cur.meld(nu)
+  desktop_layout_talk
  '  The effectful backwards leg for the Desktop placement overlay.  Foundry
  '  addresses semantic edits to this existing kook; admitted geometry pokes
  '  update only projection-overlay state.  Scene and Plate structures remain
  '  ephemeral DAG occurrences and are never minted as namespace nodes.
  \  b=bowl cur=myth nu=myth
  ^  yell
  (yell [] (desktop_layout_apply cur nu))
+  desktop_layout_form
  ^  form
  def_form.set_talk(desktop_layout_talk)
+  desktop_layout_seed
  '  Mutable overlay state behind the layout kook.  This is not a Desktop,
  '  Scene, Plate, SurfaceTree, packet, or renderer object.
  ^  myth
  .  (kooked [(pact/rel ['kook 'desktop_layout])])
     put(['geometry 'x] (pd 80))
     put(['geometry 'y] (pd 56))
     put(['geometry 'width] (pd 920))
     put(['geometry 'height] (pd 680))
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  chat_css
  ^  nat
  (weft/cat
    [surface/css
     ".plate-only-stage{display:grid;min-height:660px;place-items:center;padding:42px;background:linear-gradient(145deg,#e4e8eb,#f7f8f9)}.plate-only-stage>.chat-plate{width:min(700px,100%);height:560px}.scene-only-stage{height:660px;background:#d4d9de}.chat-plate{display:grid;height:100%;min-height:0;grid-template-rows:auto minmax(0,1fr) auto}.plate-state{color:var(--surface-green);font-size:9px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.chat-plate>#log{min-height:0;overflow:hidden}.message-thread{display:flex;height:100%;min-height:0;flex-direction:column;gap:9px;padding:16px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;background:linear-gradient(180deg,#f7f8f8,#fdfdfc)}.message{display:grid;max-width:min(76%,520px);grid-template-columns:28px minmax(0,1fr);align-items:end;gap:7px}.message.b{align-self:flex-end;grid-template-columns:minmax(0,1fr) 28px}.message-avatar{display:grid;width:28px;height:28px;place-items:center;border-radius:50%;background:#343b43;color:#fff;font-size:9px;font-weight:750;text-transform:uppercase}.message.b .message-avatar{grid-column:2}.message-body{min-width:0;padding:8px 10px;border:1px solid rgb(35 40 47/.08);border-radius:12px 12px 12px 4px;background:#e7edf5}.message.b .message-body{grid-column:1;grid-row:1;border-radius:12px 12px 4px 12px;background:#e1f2e8}.message-body .who{display:block;margin-bottom:2px;color:var(--surface-muted);font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.message-body p{margin:0;overflow-wrap:anywhere}.composer{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px;padding:10px;border-top:1px solid var(--surface-line);background:#fbfbfa}.side-picker{display:flex;gap:3px}.side-choice{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--surface-line);border-radius:7px;color:var(--surface-muted);font-size:9px;font-weight:750;text-transform:uppercase}.side-choice:has(input:checked){border-color:rgb(23 105 224/.42);background:#e8f0fd;color:var(--surface-blue)}.side-choice input{position:absolute;width:1px;height:1px;opacity:0}.composer input[type=text]{width:100%;min-width:0;padding:7px 9px;border:1px solid var(--surface-line-strong);border-radius:7px;background:#fff;color:var(--surface-ink)}.composer button{padding:7px 12px;border:0;border-radius:7px;background:#252a30;color:#fff;font-weight:650}.empty-thread{margin:auto;color:var(--surface-muted);font-size:11px}.scene-shell>.scene-workspace>.chat-plate{min-height:480px}@media(max-width:760px){.plate-only-stage{min-height:580px;padding:12px}.plate-only-stage>.chat-plate{height:540px}.scene-only-stage{height:580px}.message{max-width:90%}.composer{grid-template-columns:auto minmax(0,1fr)}.composer button{grid-column:1/-1}.scene-shell>.scene-workspace>.chat-plate{min-height:430px}}"
     ".pronunciation-contrast{--surface-ink:#fff;--surface-muted:#d7d7d7;--surface-line:#fff;--surface-line-strong:#fff;--surface-blue:#ffea00;--surface-green:#00ff8c}.pronunciation-contrast .scene-shell,.pronunciation-contrast .chat-plate,.pronunciation-contrast .composer{background:#050505;color:#fff}.pronunciation-contrast .message-body{border-color:#fff;background:#18243a}.pronunciation-contrast .message.b .message-body{background:#17351f}.pronunciation-contrast a{color:#ffea00}@media(prefers-reduced-motion:reduce){.foundry-surface *{scroll-behavior:auto!important;transition:none!important}}"])
+  msg_nodes
  '  The conversation, oldest first: the log's numbered kids in
  '  their natural order, each a bubble on its side.
  \  log=axal[myth]
  ^  row[weft/node]
  =  kids  log.kid_tap
  |  > i=nat 0  > out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  who  (side_of (myth/txt_at ['who] t))
     =  nd
          (weft/el "article" [(weft/cls (weft/cat2 "message msg " who))]
            [(weft/leaf "span" [(weft/cls "message-avatar")] who)
             (weft/el "div" [(weft/cls "message-body")]
               [(weft/leaf "strong" [(weft/cls "who")] who)
                (weft/leaf "p" [] t.txt_at(['text]))])])
     (_ i.inc out.snoc(nd))
+  log_html
  '  The log component's projection: the conversation as bubbles,
  '  oldest first — a pure function of the log subtree, its markup
  '  riding the ['html] slot for the /frag responder.
  \  fat=axal[myth]
  ^  myth
  =  msgs  (msg_nodes fat)
     kids
       ?  (eq 0 msgs.len)
          [(weft/leaf "p" [(weft/cls "empty-thread")] "No messages yet. Send the first one.")]
       msgs
  (frag/html "div"
    [(weft/cls "message-thread") (weft/att "w-scroll-target" "1")]
    kids)
+  log_view
  '  The log component: a felt over the log subtree (messages are
  '  kids, so the input is the z view).
  ^  pail
  (felt log_html .none)
+  chat_foundry
  '  The first real Foundry vertical.  Durable chat state remains at
  '  /chat; these immutable recipes build a renderer-neutral
  '  SurfaceTree, wrap it through the requested inheritance ceiling,
  '  hydrate semantic tokens, and only then select a terminal
  '  pronunciation.  No Scene, Plate, Stage, request, or packet is a
  '  namespace object.

  '  Compatibility facade: tests and the mounted app keep the established
  '  chat_foundry/* source-entry paths while large elaboration bodies live in
  '  dependency-ordered modules.  These wrappers add no policy or identity.

  +  messages_op
    ^  path
    chat_foundry_projection/messages_op
  +  web_op
    ^  path
    chat_foundry_projection/web_op

  +  template_closure
    \  recipes=row[path] corpus=axal[myth]
    ^  [refs=row[path] code=maybe[iota]]
    (chat_foundry_projection/template_closure recipes corpus)

  +  catalog_template_closure
    \  catalog=myth corpus=axal[myth]
    ^  [refs=row[path] code=maybe[iota]]
    (chat_foundry_projection/catalog_template_closure catalog corpus)

  +  foundation_layers_from
    \  kind=nat authored=axal[myth]
    ^  row[foundry/layer]
    (chat_foundry_projection/foundation_layers_from kind authored)

  +  frame_packet_id
    \  root=path kind=nat
    ^  nat
    (chat_foundry_projection/frame_packet_id root kind)

  +  packet_product
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth]
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    (chat_foundry_projection/packet_product
      root kind corpus source_snapshot)

  +  packet_product_authored
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth] authored=axal[myth]
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    (chat_foundry_projection/packet_product_authored
      root kind corpus source_snapshot authored)

  +  packet_frames
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth]
    ^  row[projection_frame]
    (chat_foundry_projection/packet_frames
      root kind corpus source_snapshot)

  +  occurrence_text
    \  key=path occurrence=projection_pronunciation_occurrence
    ^  nat
    (chat_foundry_pronunciation/occurrence_text key occurrence)

  +  pronunciation_terminal
    \  pronunciation=projection_pronunciation
    ^  [body=maybe[nat] code=maybe[iota]]
    (chat_foundry_pronunciation/pronunciation_terminal pronunciation)

  +  chat_form
    \  logp=path back=nat
    ^  weft/node
    (chat_foundry_pronunciation/chat_form logp back)

  +  frame_record
    \  context=axal[myth]
    ^  myth
    (chat_foundry_frames/frame_record context)

  +  frame_context
    \  source=axal[myth] corpus=axal[myth]
    ^  axal[myth]
    (chat_foundry_frames/frame_context source corpus)

  +  frame_http_response
    \  out=myth source=axal[myth] corpus=axal[myth] authored=axal[myth]
       action=axal[myth]
    ^  myth
    (chat_foundry_frames/frame_http_response
      out source corpus authored action)

  +  frame_http_unavailable
    \  out=myth detail=nat
    ^  myth
    (chat_foundry_frames/frame_http_unavailable out detail)

  +  frames_url
    ^  nat
    chat_foundry_frames/frames_url

  +  frames_watch
    ^  nat
    chat_foundry_frames/frames_watch

  +  frames_authored_watch
    ^  nat
    chat_foundry_frames/frames_authored_watch

  +  frames_contract_watch
    ^  nat
    chat_foundry_frames/frames_contract_watch

  +  frames_foundation_watches
    ^  row[nat]
    chat_foundry_frames/frames_foundation_watches

  +  authored_packet_watcher
    \  packet=nat
    ^  weft/node
    (chat_foundry_frames/authored_packet_watcher packet)

  +  life_report
    '  The second vertical is independently composed and observed:
    '  /app/life/board -> neutral Life Plate -> felt:web.  Chat does
    '  not import Life code or own its occurrence.
    ^  path
    (foundry/chain
      [['app 'life 'weft 'foundry 'plate]
       ['app 'life 'weft 'foundry 'web]]
      ['app 'life 'board])

  +  messages_report
    '  A complete independently observable branch report: live log
    '  subtree -> semantic messages Block -> terminal web adapter.
    ^  path
    (foundry/chain [chat_foundry/messages_op chat_foundry/web_op]
      ['chat 'log])

  +  put_text
    \  at=path role=path body=nat tree=surface_tree
    ^  surface_tree
    (surface_tree/put at (surface_tree/text role body) tree)

  +  log_two
    '  A small ordered source-log fixture built inside typed Foil so
    '  untyped hosts never manipulate polymorphic axal internals.
    \  awho=nat abody=nat bwho=nat bbody=nat
    ^  axal[myth]
    =  t0  (axal/new[myth] .none)
       t1  t0.put([($u 0)] (message_record awho abody))
    t1.put([($u 1)] (message_record bwho bbody))

  +  messages_tree
    '  sewn: the live log subtree becomes a semantic messages Block.
    '  Message ordering is inherited from axal kid order; the numeric
    '  occurrence key is preserved as structural identity.
    \  log=axal[myth]
    ^  surface_tree
    =  root
         (surface_tree/with_source ['chat 'log]
           (surface_tree/block ['chat 'messages]))
       kids  log.kid_tap
    |  > i=nat 0  > out=surface_tree (surface_tree/one root)
    ?  (ge i kids.len)
       out
    =  e  kids.at(i)
    ?  e.val.fil
     > .none  (_ i.inc out)
     > (./some t=myth)
       =  who  (side_of (myth/txt_at ['who] t))
          at=path  [e.key]
          source_base=path  ['chat 'log]
          source=path  source_base.snoc(e.key)
          msg
            .  (surface_tree/with_source source
                 (surface_tree/block ['chat 'message]))
               put(['chat 'who] (pails/t who))
          out1  (surface_tree/put at msg out)
          out2  (chat_foundry/put_text at.snoc('body)
                  ['chat 'message 'body] (myth/txt_at ['text] t) out1)
       (_ i.inc out2)

  +  plate_tree
    '  knit: lift the stable /chat source occurrence record into a
    '  Plate.  The volatile log is a pending Slot with its own report;
    '  therefore later messages refresh only this branch, not every
    '  already-resolved ancestor shell.
    \  occ=myth
    ^  surface_tree
    =  root
         (surface_tree/with_source ['chat]
           (surface_tree/plate ['chat 'plate]))
       t0  (surface_tree/one root)
       t1  (surface_tree/put ['header]
             (surface_tree/slot_resolved 'header ['chat 'plate 'header]) t0)
       t2  (chat_foundry/put_text ['header 'title]
             ['chat 'title] "General" t1)
       t3  (chat_foundry/put_text ['header 'status]
             ['status 'live] "live" t2)
       hole
         (surface_tree/with_fallback ['chat 'fallback 'messages]
           (surface_tree/hole 'messages ['chat 'messages]
             chat_foundry/messages_report))
       t4  (surface_tree/put ['messages] hole t3)
       composer
         (surface_tree/with_action ['chat 'log]
           (surface_tree/block ['chat 'composer]))
    (surface_tree/put ['composer] composer t4)

  +  scene_tree
    '  sewn: a Plate gains semantic sibling navigation and becomes a
    '  Chat Scene.  The Plate is grafted, not rendered.
    \  plate=surface_tree
    ^  surface_tree
    =  root  (surface_tree/scene ['chat 'scene])
       t0    (surface_tree/one root)
       t1    (surface_tree/put ['sidebar]
               (surface_tree/slot_resolved 'sidebar ['chat 'navigation]) t0)
       t2    (chat_foundry/put_text ['sidebar 'general]
               ['chat 'conversation 'active] "General" t1)
       t3    (chat_foundry/put_text ['sidebar 'foundry]
               ['chat 'conversation] "Foundry" t2)
       t4    (chat_foundry/put_text ['sidebar 'random]
               ['chat 'conversation] "Random" t3)
       t5    (surface_tree/put ['content]
               (surface_tree/slot_resolved 'content ['chat 'scene 'content]) t4)
    t5.rep(['content 'value] plate)

  +  shrine_tree
    '  sewn: the Chat Scene becomes one Scene Plate in Shrine chrome.
    \  scene=surface_tree
    ^  surface_tree
    =  root  (surface_tree/scene ['shrine 'scene])
       t0    (surface_tree/one root)
       t1    (chat_foundry/put_text ['chrome]
               ['shrine 'chrome 'title] "Shrine" t0)
       t2    (surface_tree/put ['content]
               (surface_tree/slot_resolved 'content ['shrine 'scene 'content]) t1)
    t2.rep(['content 'value] scene)

  +  desktop_tree
    '  sewn: Stage Flow arrangement state realizes a root Scene containing
    '  movable Scene Plate occurrences.  Geometry is presentation state; the
    '  nested semantic Scene remains unchanged.  Stage is not a Surface kind.
    \  scene=surface_tree
    ^  surface_tree
    =  root  (surface_tree/scene ['stage_flow 'root_scene])
       t0    (surface_tree/one root)
       t1    (surface_tree/put ['windows]
               (surface_tree/slot_resolved 'windows ['desktop 'windows]) t0)
       life
         (surface_tree/with_fallback ['life 'fallback 'plate]
           (surface_tree/hole 'life ['life 'plate]
             chat_foundry/life_report))
       t2    (surface_tree/put ['windows 'life] life t1)
    t2.rep(['windows 'chat] scene)

  +  request
    \  pronunciation=path
    ^  foundry/request
    (foundry/request ['chat] ['stage_flow] 'full 'scene 'neutral
      pronunciation [])

  +  baseline_layer
    ^  foundry/layer
    =  vals
         .  (myth/new)
            put(['color 'accent] (pails/t "blue"))
            put(['color 'text 'primary] (pails/t "ink"))
            put(['type 'header 'family] (pails/t "semantic_sans"))
            put(['type 'header 'size] (pails/t "title"))
            put(['type 'header 'weight] (pails/t "semibold"))
            put(['type 'header 'line_height] (pails/t "tight"))
            put(['type 'header 'tracking] (pails/t "normal"))
            put(['material 'surface] (pails/t "paper"))
            put(['layout 'density] (pails/t "comfortable"))
            put(['motion 'change] (pails/t "settle"))
    (foundry/layer ['foundry 'baseline] vals .false)

  +  plate_layer
    ^  foundry/layer
    =  vals
         .  (myth/new)
            put(['color 'accent] (pails/t "green"))
            put(['material 'surface] (pails/t "glass"))
    (foundry/layer ['chat 'plate] vals .false)

  +  accessibility_layer
    ^  foundry/layer
    =  vals
         .  (myth/new)
            put(['color 'accent] (pails/t "contrast"))
            put(['motion 'change] (pails/t "none"))
    (foundry/layer ['client 'accessibility] vals .true)

  +  hydrated
    \  tree=surface_tree
    ^  surface_tree
    (foundry/packet_tree
      (foundry/hydrate
        (chat_foundry/request ['shrine 'default]) tree
        [chat_foundry/baseline_layer chat_foundry/plate_layer]))

  +  contrasted
    \  tree=surface_tree
    ^  surface_tree
    (foundry/packet_tree
      (foundry/hydrate
        (chat_foundry/request ['shrine 'high_contrast]) tree
        [chat_foundry/accessibility_layer chat_foundry/baseline_layer
         chat_foundry/plate_layer]))

  +  root_record
    \  tree=surface_tree
    ^  myth
    tree.fil.fall(myth/new)

  +  role_is
    \  role=path tree=surface_tree
    ^  bool
    ?  (surface_tree/role_of (chat_foundry/root_record tree))
     > .none  .false
     > (./some got=path)  (eq_pith role got)

  +  text_at
    \  at=path tree=surface_tree
    ^  nat
    ?  tree.get(at)
     > .none  0
     > (./some t=myth)
       ?  (surface_tree/text_of t)
        > .none  0
        > (./some body=nat)  body

  +  web_messages
    \  tree=surface_tree
    ^  weft/node
    =  kids  tree.kid_tap
       nodes
         |  > i=nat 0  > out=row[weft/node] []
         ?  (ge i kids.len)
            out
         =  sub  kids.at(i).val
            rec  (chat_foundry/root_record sub)
            who  (side_of (myth/txt_at ['chat 'who] rec))
            body (chat_foundry/text_at ['body] sub)
            nd
              (weft/el "article" [(weft/cls (weft/cat2 "message msg " who))]
                [(weft/leaf "span" [(weft/cls "message-avatar")] who)
                 (weft/el "div" [(weft/cls "message-body")]
                   [(weft/leaf "strong" [(weft/cls "who")] who)
                    (weft/leaf "p" [] body)])])
         (_ i.inc out.snoc(nd))
    (weft/el "div"
      [(weft/cls "message-thread") (weft/att "w-scroll-target" "1")]
      (?  (eq 0 nodes.len)
          [(weft/leaf "p" [(weft/cls "empty-thread")]
             "No messages yet. Send the first one.")]
       nodes))

  +  web_composer
    \  tree=surface_tree
    ^  weft/node
    =  rec  tree.gut(['composer] myth/new)
       target=path
         ?  (surface_tree/action_of rec)
          > .none
            =  p0=path  ['chat 'log]
            p0
          > (./some p=path)  p
    (chat_foundry/chat_form target "/chat")

  +  web_plate
    \  tree=surface_tree
    ^  weft/node
    =  hole  tree.gut(['messages] myth/new)
       report
         ?  (surface_tree/report_of hole)
          > .none  chat_foundry/messages_report
          > (./some p=path)  p
    (weft/el "article"
      [(weft/cls "plate chat-plate") (weft/att "data-active" "true")]
      [(weft/el "header" [(weft/cls "plate-header")]
         [(weft/leaf "span" [(weft/cls "plate-kind")] "C")
          (weft/el "span" [(weft/cls "plate-header-copy")]
            [(weft/leaf "strong" [] (chat_foundry/text_at ['header 'title] tree))
             (weft/leaf "code" [] "/chat")])
          (weft/leaf "span" [(weft/cls "plate-state")] "live")])
       (frag/mount_report "log" report .z)
       (chat_foundry/web_composer tree)])

  +  web_sidebar
    \  tree=surface_tree
    ^  weft/node
    (weft/el "aside" [(weft/cls "scene-sidebar")
                       (weft/att "aria-label" "Conversations")]
      [(weft/leaf "h2" [(weft/cls "sidebar-heading")] "Conversations")
       (weft/el "a" [(weft/cls "sidebar-item active")
                      (weft/href "/chat/scene")]
         [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "G")
          (weft/el "span" [(weft/cls "sidebar-copy")]
            [(weft/leaf "strong" [] (chat_foundry/text_at ['sidebar 'general] tree))
             (weft/leaf "small" [] "The live conversation")])
          (weft/leaf "span" [(weft/cls "sidebar-badge")] "now")])
       (weft/el "a" [(weft/cls "sidebar-item") (weft/href "/chat/scene")]
         [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "F")
          (weft/leaf "strong" [] (chat_foundry/text_at ['sidebar 'foundry] tree))])
       (weft/el "a" [(weft/cls "sidebar-item") (weft/href "/chat/scene")]
         [(weft/leaf "span" [(weft/cls "sidebar-glyph")] "R")
          (weft/leaf "strong" [] (chat_foundry/text_at ['sidebar 'random] tree))])])

  +  web_any
    \  tree=surface_tree
    ^  weft/node
    ?  (chat_foundry/role_is ['chat 'messages] tree)
       (chat_foundry/web_messages tree)
    ?  (chat_foundry/role_is ['chat 'plate] tree)
       (chat_foundry/web_plate tree)
    ?  (chat_foundry/role_is ['chat 'scene] tree)
       (weft/el "section" [(weft/cls "scene-shell")]
         [(weft/el "header" [(weft/cls "scene-chrome")]
            [(weft/el "span" [(weft/cls "scene-chrome-title")]
               [(weft/leaf "strong" [] "Chat")
                (weft/tx " / a projected conversation scene")])])
          (chat_foundry/web_sidebar tree)
          (weft/el "main" [(weft/cls "scene-workspace")]
            [(chat_foundry/web_any tree.dip(['content 'value]))])])
    ?  (chat_foundry/role_is ['shrine 'scene] tree)
       (weft/el "section" [(weft/cls "root-scene")]
         [(weft/el "article" [(weft/cls "scene-plate-window")]
            [(surface/window_chrome "Chat" "Scene Plate / Shrine root")
             (weft/el "div" [(weft/cls "window-content")]
               [(chat_foundry/web_any tree.dip(['content 'value]))])])])
    ?  (chat_foundry/role_is ['stage_flow 'root_scene] tree)
       =  life  tree.gut(['windows 'life] myth/new)
          life_report
            ?  (surface_tree/report_of life)
             > (./some p=path)  p
             > .none            chat_foundry/life_report
       (weft/el "section" [(weft/cls "desktop-stage")]
         [(weft/el "article" [(weft/cls "stage-window secondary")]
            [(surface/window_chrome "Life" "Scene Plate / background")
             (weft/el "div" [(weft/cls "window-content")]
               [(frag/mount_report "life" life_report .x)])])
          (weft/el "article" [(weft/cls "stage-window primary")]
            [(surface/window_chrome "Chat" "Scene Plate / foreground")
             (weft/el "div" [(weft/cls "window-content")]
               [(chat_foundry/web_any tree.dip(['windows 'chat]))])])])
    (weft/leaf "div" [(weft/cls "failpane")] "Unsupported semantic surface")

  +  web_record
    '  felt:web: the first terminal adapter.  Backend choice remains
    '  outside the SurfaceTree; resolved semantic tokens merely select
    '  its mechanical pronunciation.
    \  tree=surface_tree
    ^  myth
    =  root  (chat_foundry/root_record tree)
       accent  (myth/txt_at ['foundry 'resolved 'color 'accent] root)
       cls
         ?  (eq accent "contrast")
            "foundry-surface pronunciation-contrast"
         "foundry-surface pronunciation-default"
    =  body
         ?  (chat_foundry/role_is ['chat 'plate] tree)
            (weft/el "section" [(weft/cls "plate-only-stage")]
              [(chat_foundry/web_any tree)])
         ?  (chat_foundry/role_is ['chat 'scene] tree)
            (weft/el "section" [(weft/cls "scene-only-stage")]
              [(chat_foundry/web_any tree)])
         (chat_foundry/web_any tree)
    (frag/html "div" [(weft/cls cls)] [body])

  +  text_record
    '  felt:text: a non-HTML terminal pronunciation.  It emits every
    '  semantic Text node in structural order and explicitly names
    '  unresolved Slots rather than inventing their content.
    \  tree=surface_tree
    ^  myth
    =  empty=row[nat]  []
       lines
         tree.tap.fold(empty ;
           \  out [at t]
           ?  (surface_tree/text_of t)
            > (./some body=nat)  out.snoc(body)
            > .none
              ?  (surface_tree/state_of t)
               > (./some state=iota)
                 ?  (eq_iota state 'pending)
                    out.snoc((weft/cat ["[pending " (show/path at) "]"]))
                 out
               > .none  out)
    (myth/new).put(['text] (pails/t (weft/join 10 lines)))

  +  plate_view
    ^  pail
    (knit chat_foundry/plate_tree .none)
  +  messages_view
    ^  pail
    (sewn chat_foundry/messages_tree .none)
  +  scene_view
    ^  pail
    (sewn chat_foundry/scene_tree .none)
  +  shrine_view
    ^  pail
    (sewn chat_foundry/shrine_tree .none)
  +  desktop_view
    ^  pail
    (sewn chat_foundry/desktop_tree .none)
  +  hydrate_view
    ^  pail
    (sewn chat_foundry/hydrated .none)
  +  contrast_view
    ^  pail
    (sewn chat_foundry/contrasted .none)
  +  web_view
    ^  pail
    (felt chat_foundry/web_record .none)
  +  text_view
    ^  pail
    (felt chat_foundry/text_record .none)

  +  spec
    \  role=path input=nat output=nat ceiling=nat renderer=nat
       pronunciation=nat care=nat
    ^  weft_spec
    (weft_spec role input output "full" ceiling renderer pronunciation
      care [] [])
+  specimen_seg
  '  The four hierarchy specimens plus one guarded pronunciation.
  \  seg=iota
  ^  nat
  ?  (eq_iota seg 'plate)
     "plate"
  ?  (eq_iota seg 'shrine)
     "shrine"
  ?  (eq_iota seg 'desktop)
     "desktop"
  ?  (eq_iota seg 'contrast)
     "contrast"
  "scene"
+  specimen_of
  '  The selected presentation layer.  /chat and non-specimen chat
  '  paths retain the useful scene default.
  \  tgt=path
  ^  nat
  ?  (lt tgt.len 2)
     "scene"
  ?  (eq_iota tgt.at(0) 'app)
     ?  (lt tgt.len 3)
        "scene"
     (specimen_seg tgt.at(2))
  (specimen_seg tgt.at(1))
+  specimen_link
  \  root=path current=nat own=nat label=nat
  ^  weft/node
  =  href  (weft/cat [(show/path root) "/" own])
     as
       ?  (eq current own)
          [(weft/href href) (weft/att "aria-current" "page")]
       [(weft/href href)]
  (weft/leaf "a" as label)
+  specimen_nav
  \  root=path current=nat
  ^  weft/node
  (weft/el "nav" [(weft/cls "surface-nav") (weft/att "aria-label" "Chat projection layers")]
    [(specimen_link root current "plate" "Chat Plate")
     (specimen_link root current "scene" "Chat Scene")
     (specimen_link root current "shrine" "Shrine Scene")
     (specimen_link root current "desktop" "Stage Flow")
     (specimen_link root current "contrast" "High Contrast")])
+  specimen_title
  \  kind=nat
  ^  nat
  ?  (eq kind "plate")
     "Chat Plate"
  ?  (eq kind "shrine")
     "Chat Scene Plate in Shrine"
  ?  (eq kind "desktop")
     "Stage Flow as a Root Scene"
  ?  (eq kind "contrast")
     "Chat Scene / High Contrast Pronunciation"
  "Chat Scene"
+  specimen_note
  \  kind=nat
  ^  nat
  ?  (eq kind "plate")
     "occurrence -> Plate"
  ?  (eq kind "shrine")
     "Scene -> Scene Plate + serving chrome"
  ?  (eq kind "desktop")
     "arrangement state -> root Scene with movable Scene Plates"
  ?  (eq kind "contrast")
     "same semantic Scene -> guarded accessibility pronunciation"
  "Plate + sibling navigation -> Scene"
+  projected_terminal
  '  One synchronous server pronunciation of the same addressed packet used
  '  by progressive delivery.  Live Holes remain mounts in the returned HTML;
  '  this function only removes the old renderer-local SurfaceTree path from
  '  the Plate, Scene, Shrine, and contrast specimen routes.
  \  root=path kind=nat corpus=axal[myth] source=axal[myth]
     authored=axal[myth]
  ^  maybe[weft/node]
  ?  (eq source.tap.len 0)  .none
  =  [_ dag]
       (chat_foundry/packet_product_authored
         root kind corpus source authored)
  ?  dag
   > .none  .none
   > (./some admitted=projection_dag)
     ?  (foundry_pronounce_walk/pronounce admitted)
      > projection_pronunciation_result/refused  .none
      > x=projection_pronunciation_result/admitted
        =  [body issue]
             (chat_foundry/pronunciation_terminal x.pronunciation)
        ?  issue
         > (./some _)  .none
         > .none
           ?  body
            > .none  .none
            > (./some html=nat)  (./some (weft/raw html))
+  chat_page
  '  A thin server-rendered container around one compiled Foundry
  '  report.  The actual Plate/Scene/root-Scene hierarchy is now generated
  '  by immutable knit/sewn recipes and pronounced by felt:web.
  \  root=path tgt=path corpus=axal[myth] source=axal[myth]
     authored=axal[myth]
  ^  nat
  =  kind  (specimen_of tgt)
     terminal
       (projected_terminal root kind corpus source authored)
     projected=row[weft/node]
       ?  terminal
        > .none
          [(weft/el "div" [(weft/cls "failpane")]
             [(weft/leaf "strong" [] "Projection refused")
              (weft/leaf "p" []
                "No complete admitted semantic packet is available.")])]
        > (./some terminal_node=weft/node)
          ?  (eq kind "desktop")
             =  packet  (chat_foundry/frame_packet_id root kind)
             [(weft/packet_mount packet
                chat_foundry/frames_url
                chat_foundry/frames_watch
                "x"
                [(weft/packet_terminal "scene-root" [terminal_node])])
              (chat_foundry/authored_packet_watcher packet)]
          [terminal_node]
     caption
       (weft/el "header" [(weft/cls "specimen-caption")]
         [(weft/leaf "strong" [] (specimen_title kind))
          (weft/leaf "span" [] (specimen_note kind))])
     frame_children=row[weft/node]  [caption]
     body
       [(weft/el "div" [(weft/cls "surface-page") (weft/att "data-specimen" kind)]
          [(specimen_nav root kind)
           (weft/el "section" [(weft/cls "specimen-frame")]
             frame_children.weld(projected))])
        frag/script]
  (weft/page (specimen_title kind) chat_css body)
+  face_talk
  '  The app's HTTP face: the container page for the request target's
  '  mount root.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       ?  out.get(['vpath])
        > (./some held=pail)
          ?  held
           > p=pails/p  p.p
          []
        > .none  []
     corpus  b.crew.gut(['foundry] (axal/new[myth] .none))
     authored
       b.crew.gut(['foundry_authored] (axal/new[myth] .none))
     is_frames=bool
       ?  !(eq tgt.len 2)  .false
       (eq_iota tgt.at(1) 'frames)
     done
       ?  is_frames
          ?  b.crew.get(['foundry])
           > .none
             (chat_foundry/frame_http_unavailable out
               "projection producer missing Foundry corpus Sight")
           > (./some frame_corpus=axal[myth])
             ?  (eq frame_corpus.tap.len 0)
                (chat_foundry/frame_http_unavailable out
                  "projection producer received an empty Foundry corpus Sight")
             ?  b.crew.get(['face_source1])
              > .none
                (chat_foundry/frame_http_unavailable out
                  "projection producer missing source occurrence Sight")
              > (./some frame_source=axal[myth])
                ?  (eq frame_source.tap.len 0)
                   (chat_foundry/frame_http_unavailable out
                     "projection producer received an empty source occurrence Sight")
                ?  b.crew.get(['face_action])
                 > .none
                   (chat_foundry/frame_http_unavailable out
                     "projection producer missing Action declaration Sight")
                 > (./some frame_action=axal[myth])
                   ?  frame_action.fil
                    > .none
                      (chat_foundry/frame_http_unavailable out
                        "projection producer received an empty Action declaration Sight")
                    > (./some _)
                      (chat_foundry/frame_http_response
                        out frame_source frame_corpus authored frame_action)
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd
            (chat_page (root_of tgt) tgt corpus
              b.crew.gut(['face_source1] (axal/new[myth] .none)) authored)))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  app
  '  The chat app: the log and its face.
  ^  mani
  (mani 'chat
        (lore "A two-sided chat, served as its own page."
              ["A two-sided chat, served as its own page."
               "Messages are numbered kids of the log node; the face's form posts through the /post endpoint, and the log's talk arm appends each message in-kernel."
               "Pick a side (a or b), type, send.  The page refreshes its log in place, so a conversation held in two windows converges by itself."]
              [])
        [(kook/decl 'log log_form (lore/line "The log: a post poke appends a numbered message kid and advances the count."))
         (kook/decl 'desktop_layout desktop_layout_form
           (lore/line "The Desktop placement lens: admitted geometry pokes update overlay state."))
         (kook/decl 'face face_form (lore/line "The HTML face: the container page — the log fragment plus the posting form."))]
        [[['source] source_seed]
         [['actions 'send] send_action_seed]
         [['contracts 'send_message] send_message_contract_seed]
         [['contracts 'action_receipt] action_receipt_seed]
         [['capabilities 'send_message] send_capability_seed]
         [['interaction 'send_message] send_interaction_seed]
         [['policies 'send_result] send_result_seed]
         [['policies 'send_refusal] send_refusal_seed]
         [['log] log_seed]
         [['layout] desktop_layout_seed]
         [['weft 'log]
          (weft_card log_view (pact/rel ['log])
            (lore "The log component: the conversation as bubbles, a felt over the log subtree."
                  ["The log component: the conversation as bubbles, a felt over the log subtree."
                   "Input: the z view of a log node - numbered kids each carrying ['who] and ['text]; the ['count] slot is ignored."
                   "Output: a div of .msg bubbles, oldest first, each tagged with its side (a left, b right)."
                   "Point it at any node whose kids look like messages - the log's shape is the whole contract."]
                  []))]
         [['weft 'foundry 'plate]
          (weft_recipe chat_foundry/plate_view (pact/rel [])
            (lore/line "knit: lift the stable chat occurrence into a semantic Chat Plate with a live messages Hole.")
            (chat_foundry/spec ['projection 'chat 'plate]
              "record" "surface-tree" "plate" "neutral" "shrine" "x"))]
         [['weft 'foundry 'messages]
          (weft_recipe chat_foundry/messages_view (pact/rel ['log])
            (lore/line "sewn: normalize the live chat log subtree into semantic message Blocks and Text.")
            (chat_foundry/spec ['projection 'chat 'messages]
              "subtree" "surface-tree" "block" "neutral" "shrine" "z"))]
         [['weft 'foundry 'scene]
          (weft_recipe chat_foundry/scene_view (pact/rel [])
            (lore/line "sewn: wrap a Chat Plate with semantic sibling navigation as a Chat Scene.")
            (chat_foundry/spec ['projection 'chat 'scene]
              "surface-tree" "surface-tree" "scene" "neutral" "shrine" "z"))]
         [['weft 'foundry 'shrine]
          (weft_recipe chat_foundry/shrine_view (pact/rel [])
            (lore/line "sewn: admit a Chat Scene as one Scene Plate inside the Shrine Scene root.")
            (chat_foundry/spec ['projection 'shrine 'scene]
              "surface-tree" "surface-tree" "scene" "neutral" "shrine" "z"))]
         [['weft 'foundry 'desktop]
          (weft_recipe chat_foundry/desktop_view (pact/rel [])
            (lore/line "sewn: realize Stage Flow arrangement state as a root Scene of movable Scene Plates.")
            (chat_foundry/spec ['projection 'stage_flow 'root_scene]
              "surface-tree" "surface-tree" "scene" "neutral" "shrine" "z"))]
         [['weft 'foundry 'hydrate]
          (weft_recipe chat_foundry/hydrate_view (pact/rel [])
            (lore/line "sewn: resolve the default semantic token cascade and stamp provenance on the SurfaceTree.")
            (chat_foundry/spec ['projection 'hydrate]
              "surface-tree" "surface-tree" "scene" "neutral" "shrine" "z"))]
         [['weft 'foundry 'contrast]
          (weft_recipe chat_foundry/contrast_view (pact/rel [])
            (lore/line "sewn: resolve the guarded high-contrast and reduced-motion pronunciation layer.")
            (chat_foundry/spec ['projection 'hydrate]
              "surface-tree" "surface-tree" "scene" "neutral" "high-contrast" "z"))]
         [['weft 'foundry 'web]
          (weft_recipe chat_foundry/web_view (pact/rel [])
            (lore/line "felt:web: pronounce any admitted Chat SurfaceTree as escaped Weft HTML.")
            (chat_foundry/spec ['renderer 'web]
              "surface-tree" "record" "scene" "web" "shrine" "z"))]
         [['weft 'foundry 'text]
          (weft_recipe chat_foundry/text_view (pact/rel [])
            (lore/line "felt:text: pronounce semantic Text nodes and explicit pending Slots without HTML.")
            (chat_foundry/spec ['renderer 'text]
              "surface-tree" "record" "scene" "text" "plain" "z"))]
         ])
