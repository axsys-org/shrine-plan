-  sept [order=10]
-  json [order=15]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
-  open_router_api [order=90]
-  open_router_api_hand [order=100]
'  chat: a conversation with a language model, as a shrine app.
'  .
'  The whole round trip is namespace state.  A post pokes the conv
'  node; its talk appends the turn under ['msgs] AND makes a request
'  kid under ['api], whose behavior is the OpenRouter hand schemagen
'  generated from src/spec/openrouter.json.  The hand's take emits the
'  fetch card at /io/http_client — a card outside the app's own
'  subtree, which leaves the transaction as a MOVE and is applied only
'  because the app's card grants ['grants 'fetch] (helm/moves, and
'  doc/multifile-apps-io-grants.md part II).  When the answer lands the
'  hand pokes bond/res onto the request kid; the conv node hears that
'  through its own z-care crew and appends the assistant's turn.
'  .
'  So every message, every request, and every reply is an addressable
'  node with history: /h scrubs the whole conversation, and nothing
'  about the exchange lives in host memory.  The conversation renders
'  as a COMPONENT (a felt over the conv subtree at weft/log,
'  write-once) mounted into the container page as a /frag element the
'  /w.js runtime keeps fresh — so the model's reply appears in place,
'  turns are editable where they render (w-edit), and the
'  omni-scrubber replays the exchange.  Mounted at the top-level
'  /chat root when installed, not under /app.
+  conv_slot
  '  Where the conversation's turns live, under the conv node.
  ^  path
  ['msgs]
+  api_slot
  '  Where the request kids live: the hand node's own subtree.
  ^  path
  ['api]
+  fork_slot
  '  Where branch conversations live, under their parent conv — a
  '  fork's cards must stay inside the forker's own subtree, so the
  '  fork tree nests.
  ^  path
  ['fork]
+  chain_slot
  '  Where a branch's ancestor links ride, one numbered slot each.
  ^  path
  ['chain]
+  cat_slot
  '  Where a branch's fork cuts ride, numbered alongside the links.
  ^  path
  ['cat]
+  up_slot
  '  Where a branch's ancestor crew deps ride, numbered alongside.
  ^  path
  ['up]
+  chain_at
  '  The slot naming chain link i: an ancestor conversation's path.
  \  i=nat
  ^  path
  chain_slot.snoc(($u i))
+  cat_at
  '  The slot naming chain link i's cut: the ancestor's turn count
  '  at the fork.
  \  i=nat
  ^  path
  cat_slot.snoc(($u i))
+  up_at
  '  The crew slot watching chain link i's turns.
  \  i=nat
  ^  path
  up_slot.snoc(($u i))
+  txt_nat
  '  The leading decimal digits of a text as a nat; 0 when none.
  '  ?=  ((txt_nat "12") 12)
  '  ?=  ((txt_nat "x") 0)
  \  s=nat
  ^  nat
  =  w  (wid s)
  %    i=nat 0    out=nat 0
  ?  (eq i w)
     out
  =  c  (load8 i s)
  ?  !(digit_byte c)
     out
  (_ i.inc (add (mul out 10) (sub c "0")))
+  put_txt
  '  A text slot put, when the value is nonempty.
  \  s=path v=nat t=myth
  ^  myth
  ?  (eq 0 v)
     t
  t.put(s (pails/t (str/from_atom v)))
+  opt_txt
  '  A text as an optional request field: absent when empty.
  \  v=nat
  ^  maybe[str]
  ?  (eq 0 v)
     .none
  (./some (str/from_atom v))
+  pth_at
  '  The path held at a slot, or none.
  \ s=path t=myth
  ^ maybe[path]
  | myth/path_at s t
+  copy_slot
  '  A slot carried over from one record to another, when present.
  \ s=path src=myth t=myth
  ^ myth
  | myth/copy_slot s src t
+  tc_slot
  '  Where an assistant turn's tool calls ride, one numbered group
  '  each: ['tc <j> 'id], ['tc <j> 'name], ['tc <j> 'args].
  ^  path
  ['tc]
+  pc_slot
  '  Where the conversation's parked peeks ride: a peek cannot be
  '  answered in the round that asks it — the watch has to commit
  '  first — so each rides a numbered kid until the next hear.
  ^  path
  ['pc]
+  peek_slot
  '  The crew slots watching parked peeks' targets.
  ^  path
  ['peek]
+  notes_slot
  '  Where the model's notes to itself live.
  ^  path
  ['notes]
+  tc_at
  '  One tool-call slot: group j, member sub.
  \  j=nat sub=path
  ^  path
  tc_slot.snoc(($u j)).weld(sub)
+  peek_at
  '  The crew slot watching parked peek i.
  \  i=nat
  ^  path
  peek_slot.snoc(($u i))
+  jget
  '  A key's value in a JSON object, or none.
  \  k=nat v=json
  ^  maybe[json]
  ?  v
   > (./obj kvs)
     %    i=nat 0
     ^  maybe[json]
     ?  (eq i kvs.len)
        .none
     =  e  kvs.at(i)
     ?  (eq e.k k)
        (./some e.v)
     (_ i.inc)
  .none
+  jtxt
  '  A key's string value in a JSON object, or 0.
  \  k=nat v=json
  ^  nat
  ?  (jget k v)
   > .none  0
   > (./some jv)
     ?  jv
      > s=json/str  s.s
     0
+  jnat
  '  A key's non-negative integer value, or the default.
  \  k=nat dflt=nat v=json
  ^  nat
  ?  (jget k v)
   > .none  dflt
   > (./some jv)
     ?  jv
      > x=json/num
        ?  x.neg
           dflt
        x.n
     dflt
+  all_digits
  '  A nonempty run of decimal digits?
  \  s=nat
  ^  bool
  =  w  (wid s)
  ?  (eq w 0)
     .false
  %    i=nat 0
  ?  (eq i w)
     .true
  ?  !(digit_byte (load8 i s))
     .false
  (_ i.inc)
+  txt_path
  '  A path from its text: split on /, digit runs become numeric
  '  segments, empty segments are dropped.
  '  ?=  ((txt_path "/chat/conv").len 2)
  \  s=nat
  ^  path
  =  w  (wid s)
  %    i=nat 0    st=nat 0    out=path []
  ?  (if (lt i w) !(eq (load8 i s) "/") 0)
     (_ i.inc st out)
  =  sl  (cord/slice st (sub i st) s)
  =  o2
       ?  (eq 0 (wid sl))
          out
       ?  (all_digits sl)
          out.snoc(($u (txt_nat sl)))
       out.snoc(($ts sl))
  ?  (ge i w)
     o2
  (_ i.inc i.inc o2)
+  show_pail
  '  A slot value as text, by rep.
  \  pl=pail
  ^  nat
  ?  pl
   > x=pails/t  x.t
   > n=pails/n  (weft/show_nat n.n)
   > p=pails/p  (show/path p.p)
   > q=pails/q  (iota_show q.q)
  "(opaque)"
+  show_myth
  '  A record as lines of "slot = value".
  \  t=myth
  ^  nat
  =  es  t.tap
  %    i=nat 0    out=nat ""
  ?  (eq i es.len)
     out
  =  e  es.at(i)
  (_ i.inc (weft/cat [out (show/path e.key) " = " (show_pail e.val) 10]))
+  peek_text
  '  A peeked view as text: the node's slots, then its kid names.
  \  view=axal[myth]
  ^  nat
  ?  view.fil
   > .none  "nothing at that path"
   > (./some t=myth)
     =  kids  view.kid_tap
     =  kn
          %    i=nat 0    out=nat ""
          ?  (eq i kids.len)
             out
          (_ i.inc (weft/cat [out (iota_show kids.at(i).key) " "]))
     ?  (eq 0 kids.len)
        (show_myth t)
     (weft/cat [(show_myth t) "kids: " kn])
+  crew_of_conv
  '  The crew mop on a conversation record, or empty.
  \ t=myth
  ^ crew
  | myth/crew_at crew_slot t
+  crew_drop
  '  A crew without one slot.
  \ slot=path cw=crew
  ^ crew
  | cw.del slot
+  jprop
  '  One parameters property: name, JSON type, description.
  \  k=str ty=str d=str
  ^  jkv
  (jkv k (json/obj [(jkv "type" (json/str ty))
                    (jkv "description" (json/str d))]))
+  params_obj
  '  A function tool's parameters: a JSON schema object.
  \  props=row[jkv] req=row[json]
  ^  json
  (json/obj
    [(jkv "type" (json/str "object"))
     (jkv "properties" (json/obj props))
     (jkv "required" (json/arr req))])
+  tool_def
  '  One function tool the model may call.
  \  name=str desc=str params=json
  ^  chat_function_tool
  (./function
    (chat_function_tool_function .none
      (chat_function_tool_function_function (./some desc) name
        (./some params) .none)
      "function"))
+  tools_row
  '  The namespace tool surface, sent with every request: read
  '  anywhere (histories and overlays included), fork this
  '  conversation, adopt a branch, note to self.
  ^  row[chat_function_tool]
  [(tool_def "peek"
     "Read a node in the namespace you live in: its slots and kid names. Works on live paths (e.g. /chat/conv), history paths (/h/...), and overlay paths (/o/...)."
     (params_obj [(jprop "path" "string" "absolute namespace path")]
                 [(json/str "path")]))
   (tool_def "fork"
     "Fork this conversation into live branches that share its history and continue independently. Each branch answers on its own, and a branch can itself be forked."
     (params_obj [(jprop "count" "integer" "how many branches, 1-8, default 2")
                  (jprop "text" "string" "optional divergent user turn given to every branch")]
                 []))
   (tool_def "adopt"
     "Adopt one of this conversation's live branches: its turns are appended here and its live siblings are closed."
     (params_obj [(jprop "branch" "integer" "the branch number to adopt")]
                 [(json/str "branch")]))
   (tool_def "note"
     "Write a note to yourself on this conversation's own node. Notes persist in the namespace and are visible to anyone browsing it."
     (params_obj [(jprop "text" "string" "the note")]
                 [(json/str "text")]))]
+  dflt_model
  ^  nat
  "anthropic/claude-sonnet-4.5"
+  msg_rec
  '  One turn as a record: who said it and what they said.
  \  who=nat body=nat
  ^  myth
  .  (myth/new)
     put(['who] (pails/t (str/from_atom who)))
     put(['text] (pails/t (str/from_atom body)))
+  model_of
  '  The conversation's chosen model, or the default.
  \  cur=myth
  ^  nat
  =  m  (myth/txt_at ['model] cur)
  ?  (eq 0 m)
     dflt_model
  m
+  turn_msg
  '  One stored turn as a chat message.  A turn the model produced
  '  goes back as an assistant message so the exchange stays a
  '  conversation and not a series of unrelated questions.
  \  who=nat body=nat
  ^  chat_messages
  ?  (eq who "assistant")
     (./assistant
       (chat_assistant_message .none (./some (./str (str/from_atom body))) .none .none
         .none .none .none .none "assistant" .none))
  (./user (chat_user_message (./str (str/from_atom body)) .none "user"))
+  node_msg
  '  One stored turn node as a chat message: user and assistant text
  '  as before, an assistant's tool calls reconstructed from their
  '  ['tc] groups, and tool results as tool messages.
  \  t=myth
  ^  chat_messages
  =  who   (myth/txt_at ['who] t)
     body  (myth/txt_at ['text] t)
  ?  (eq who "tool")
     (./tool (chat_tool_message (./str body) "tool"
               (myth/txt_at ['tcid] t)))
  =  ntc  (myth/nat_at ['tcs] 0 t)
  ?  (if (eq who "assistant") (gt ntc 0) 0)
     =  calls
          %    j=nat 0    out=row[chat_tool_call] []
          ?  (eq j ntc)
             out
          =  cid  (myth/txt_at (tc_at j ['id]) t)
             cnm  (myth/txt_at (tc_at j ['name]) t)
             car  (myth/txt_at (tc_at j ['args]) t)
          (_ j.inc out.snoc((chat_tool_call
                              (chat_tool_call_function car cnm)
                              cid "function")))
     ?  (eq 0 body)
        (./assistant
          (chat_assistant_message .none .none .none .none .none .none
            .none .none "assistant" (./some calls)))
     (./assistant
       (chat_assistant_message .none (./some (./str (str/from_atom body))) .none .none
         .none .none .none .none "assistant" (./some calls)))
  (turn_msg who body)
+  history
  '  Every stored turn, oldest first, as chat messages.
  \  msgs=axal[myth]
  ^  row[chat_messages]
  =  kids  msgs.kid_tap
  %    i=nat 0    out=row[chat_messages] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     (_ i.inc out.snoc((node_msg t)))
+  history_upto
  '  Turns with keys below a cut, oldest first, as chat messages —
  '  an ancestor's history as it stood at the fork.
  \  msgs=axal[myth] at=nat
  ^  row[chat_messages]
  =  kids  msgs.kid_tap
  %    i=nat 0    out=row[chat_messages] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  !(lt (quip_val e.key) at)
     (_ i.inc out)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     (_ i.inc out.snoc((node_msg t)))
+  link_msgs
  '  The inherited prefix: each chain link's turns, cut at that
  '  link's fork position, oldest ancestor first.  The links ride
  '  ['up <i>] crew slots, so the prefix is LIVE — editing an
  '  ancestor's past edits every descendant's prompt.
  \  b=bowl cur=myth
  ^  row[chat_messages]
  =  m  cur.nat_at(['links] 0)
  %    i=nat 0    out=row[chat_messages] []
  ?  (eq i m)
     out
  =  up  b.crew.gut((up_at i) (axal/new[myth] .none))
  (_ i.inc out.weld((history_upto up cur.nat_at((cat_at i) 0))))
+  full_history
  '  The whole effective conversation: inherited prefix, then own
  '  turns.  For the trunk (no links) this is just history.
  \  b=bowl cur=myth fat=axal[myth]
  ^  row[chat_messages]
  (link_msgs b cur).weld((history fat.dip(conv_slot)))
+  chat_body
  '  The request body: the conversation so far, at the chosen model,
  '  optionally at a chosen temperature.  chat_request is 42 fields
  '  wide and positional — everything we do not set is explicitly
  '  absent, in the schema's own field order.  temp rides as decimal
  '  text (0 = absent): the schema's number fields are verbatim
  '  decimal lexemes, spliced unparsed into the body.
  \  msgs=row[chat_messages] model=nat temp=nat
  ^  chat_request
  (chat_request .none .none .none .none .none .none .none .none
    msgs .none .none .none (./some (str/from_atom model)) .none .none .none .none
    .none .none .none .none .none .none .none .none .none .none
    .none .none .none .none .none .none (opt_txt temp) .none
    (./some tools_row) .none .none .none .none .none .none)
+  req_rec
  '  A request kid: the bond/req the hand's take is waiting for.
  \  msgs=row[chat_messages] model=nat temp=nat
  ^  myth
  (myth/new).put(bond/req (req/send_chat_completion_request
                            (chat_body msgs model temp)))
+  msg_text
  '  An assistant message's words.  Content that came back as parts
  '  rather than a plain string reads as empty — the caller decides
  '  what to do about it.
  \  m=chat_assistant_message
  ^  nat
  ?  m.content
   > .none  ""
   > (./some c)
     ?  c
      > (./str s)  s
      > (./arr xs)  ""
      > (./unknown u)  ""
+  call_rec
  '  An assistant turn that calls tools: the content (possibly
  '  empty) plus one ['tc <j>] group per call.
  \  body=nat calls=row[chat_tool_call]
  ^  myth
  =  t0
       .  (myth/new)
          put(['who] (pails/t "assistant"))
          put(['text] (pails/t (str/from_atom body)))
          put(['tcs] (pd calls.len))
  %    j=nat 0    acc=myth t0
  ?  (eq j calls.len)
     acc
  =  c   calls.at(j)
  =  a1  acc.put((tc_at j ['id]) (pails/t (str/from_atom c.id)))
  =  a2  a1.put((tc_at j ['name]) (pails/t (str/from_atom c.function.name)))
  (_ j.inc a2.put((tc_at j ['args]) (pails/t (str/from_atom c.function.arguments))))
+  tool_rec
  '  One tool answer as a turn: who it answers rides ['tcid].
  \  cid=nat body=nat
  ^  myth
  .  (myth/new)
     put(['who] (pails/t "tool"))
     put(['text] (pails/t (str/from_atom body)))
     put(['tcid] (pails/t (str/from_atom cid)))
+  t_tool_call
  '  A tool call built in-world, for the suite's law tests — a host
  '  cannot construct nominal records (an extracted record entry is
  '  its TYPE and applies silently into garbage).
  \  args=nat name=nat cid=nat
  ^  chat_tool_call
  (chat_tool_call
    (chat_tool_call_function (str/from_atom args) (str/from_atom name))
    (str/from_atom cid) "function")
+  t_tool_round
  '  The suite's loop probe, built and driven in-world: a
  '  conversation with one answered request kid whose reply calls
  '  peek, heard twice.  The first hear appends the calling turn,
  '  takes the kid, and parks the peek; the second answers it from
  '  its (empty here) watch and asks again.  [round1 round2] cards.
  \  z=nat
  ^  [a=row[[p=path q=writ]] b=row[[p=path q=writ]]]
  =  args1  (show (json/obj [(jkv "path" (json/str "/x"))]))
  =  fake
       (myth/sing bond/res
         (chat_result_r/ok
           (chat_result
             [(chat_choice (./some (./tool_calls 0)) 0 .none
                (chat_assistant_message .none .none .none .none .none
                  .none .none .none "assistant"
                  (./some [(t_tool_call args1 "peek" "c9")])))]
             1 "x1" "m" "chat.completion" .none .none (./some "fp") .none)))
  =  cur0
       .  (myth/new)
          put(['count] (pd 1))
          put(['reqs] (pd 1))
  =  fat1
       .  (axal/new[myth] .none)
          put(conv_slot.snoc(($u 0)) (msg_rec "user" "hi"))
          put(api_slot.snoc(($u 0)) fake)
  =  b1
       (bowl ['u] ['chat 'conv] 0 0 (axal/new[myth] .none)
         (mop/sing[path axal[myth] lt_pith] ['self] fat1))
  =  y1  (conv_hear b1 cur0 [])
  =  crec
       (call_rec "" [(t_tool_call args1 "peek" "c9")])
  =  fat2
       .  (axal/new[myth] .none)
          put(conv_slot.snoc(($u 0)) (msg_rec "user" "hi"))
          put(conv_slot.snoc(($u 1)) crec)
          put(api_slot.snoc(($u 0)) fake.put(['taken] (pd 1)))
          put(pc_slot.snoc(($u 0))
              (myth/new).put(['id] (pails/t "c9")).put(['path] (pails/p ['x])))
  =  b2
       (bowl ['u] ['chat 'conv] 0 0 (axal/new[myth] .none)
         (mop/sing[path axal[myth] lt_pith] ['self] fat2))
  =  y2  (conv_hear b2 y1.out [])
  [y1.cards y2.cards]
+  conv_init
  '  The conversation container: a z-care crew on its own subtree, so
  '  a reply poked onto a request kid comes back as a hear here, and
  '  the counters both turns and requests are numbered by.  A branch
  '  is born with a chain of ancestor links in its make myth: each
  '  gets an ['up <i>] z-dep on that ancestor's turns, and counters
  '  carried by the myth are preserved rather than zeroed.
  \  b=bowl t=myth
  ^  yell
  =  m  t.nat_at(['links] 0)
  =  cw
       %    i=nat 0    acc=crew (crew/sing ['self] (dep .z b.here))
       ?  (eq i m)
          acc
       ?  (pth_at (chain_at i) t)
        > (./some p=path)
          (_ i.inc acc.put((up_at i) (dep .z p.weld(conv_slot))))
        > .none
          (_ i.inc acc)
  =  t2  t.put(crew_slot (cpail cw))
  =  t3
       .  t2
          put(['count] (pd t.nat_at(['count] 0)))
          put(['reqs] (pd t.nat_at(['reqs] 0)))
  (yell [] t3)
+  conv_talk
  '  A post: ['post 'model] switches models (an accompanying ['post
  '  'temp] rides along), ['post 'adopt] adopts a branch, ['post
  '  'fork] forks the conversation, ['post 'temp] alone sets the
  '  sampling temperature, and ['post 'text] takes a turn — the turn
  '  is appended AND a request kid is made in the same transaction,
  '  so the question and the asking of it commit together.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  mdl  (myth/txt_at ['post 'model] nu)
     tmp  (myth/txt_at ['post 'temp] nu)
  ?  !(eq 0 mdl)
     (yell [] (put_txt ['temp] tmp (put_txt ['model] mdl cur)))
  ?  !(eq 0 (myth/txt_at ['post 'adopt] nu))
     (conv_adopt b cur nu)
  ?  !(eq 0 (myth/txt_at ['post 'fork] nu))
     (conv_fork b cur nu)
  ?  !(eq 0 tmp)
     (yell [] cur.put(['temp] (pails/t (str/from_atom tmp))))
  =  body  (myth/txt_at ['post 'text] nu)
  ?  (eq 0 body)
     (def_talk b cur nu)
  =  n  cur.nat_at(['count] 0)
     k  cur.nat_at(['reqs] 0)
  =  fat   b.crew.gut(['self] (axal/new[myth] .none))
     past  (full_history b cur fat)
  =  msgs  past.snoc((turn_msg "user" body))
  =  cards
       [[b.here.weld(conv_slot.snoc(($u n)))
         (writ/make (msg_rec "user" body))]
        [b.here.weld(api_slot.snoc(($u k)))
         (writ/make (req_rec msgs (model_of cur) (myth/txt_at ['temp] cur)))]]
  =  out
       .  cur
          put(['count] (pd n.inc))
          put(['reqs] (pd k.inc))
  (yell cards out)
+  tool_answer
  '  One tool answer appended as a turn, and as a message for the
  '  follow-up request.
  \  b=bowl cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] cid=nat body=nat
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  n   out.nat_at(['count] 0)
  =  tr  (tool_rec cid body)
  [cards.snoc([b.here.weld(conv_slot.snoc(($u n))) (writ/make tr)])
   out.put(['count] (pd n.inc))
   extra.snoc((node_msg tr))]
+  run_peek
  '  Park a peek: the watch is installed now, the answer rides the
  '  next hear, after the watch has committed.
  \  b=bowl cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] cid=nat args=json
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  ptxt  (jtxt "path" args)
  ?  (eq 0 ptxt)
     (tool_answer b cards out extra cid "peek needs a path")
  =  pp    (txt_path ptxt)
  =  pcid  out.nat_at(['pcs] 0)
  =  o2
       .  out
          put(['pcs] (pd pcid.inc))
          put(crew_slot (cpail (crew_of_conv out).put((peek_at pcid) (dep .y pp))))
  =  c2  cards.snoc([b.here.weld(pc_slot.snoc(($u pcid)))
                     (writ/make (myth/new).put(['id] (pails/t (str/from_atom cid))).put(['path] (pails/p pp)))])
  [c2 o2 extra]
+  run_note
  '  A note to self: a kid under ['notes], answered immediately.
  \  b=bowl cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] cid=nat args=json
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  txt  (jtxt "text" args)
  ?  (eq 0 txt)
     (tool_answer b cards out extra cid "note needs text")
  =  m   out.nat_at(['ncs] 0)
  =  c2  cards.snoc([b.here.weld(notes_slot.snoc(($u m)))
                     (writ/make (myth/sing ['text] (pails/t (str/from_atom txt))))])
  (tool_answer b c2 out.put(['ncs] (pd m.inc)) extra cid "noted")
+  run_fork
  '  The model forks its own conversation: the branches share the
  '  history through this very round — the calling turn and this
  '  answer included — and continue on their own.
  \  b=bowl full=row[chat_messages] cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] cid=nat args=json
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  k     (fork_kn (jnat "count" 2 args))
  =  body  (jtxt "text" args)
  =  f0    out.nat_at(['forks] 0)
  =  fat   b.crew.gut(['self] (axal/new[myth] .none))
  =  rtxt
       (weft/cat ["forked " (weft/show_nat k) " branches: fork "
                  (weft/show_nat f0) " .. fork "
                  (weft/show_nat (sub (add f0 k) 1))])
  =  bmsgs  full.weld(extra).snoc((node_msg (tool_rec cid rtxt)))
  =  cut    (add out.nat_at(['count] 0) 1)
  =  bc  (fork_cards b out fat k body (myth/txt_at ['temp] out) bmsgs cut)
  ?  (eq 0 bc.len)
     (tool_answer b cards out extra cid "cannot fork here")
  =  r   (tool_answer b cards out extra cid rtxt)
  =  [c2 o2 e2]  r
  [c2.weld(bc) o2.put(['forks] (pd (add f0 k))) e2]
+  run_adopt
  '  The model adopts one of its own branches.
  \  b=bowl cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] cid=nat args=json
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  a    (jnat "branch" 1000000 args)
  =  fat  b.crew.gut(['self] (axal/new[myth] .none))
  =  n0   out.nat_at(['count] 0)
  =  r    (adopt_cards b fat a n0)
  =  [ac ts]  r
  ?  (eq 0 ts.len)
     (tool_answer b cards out extra cid "no live branch by that number")
  =  e2
       %    i=nat 0    acc=row[chat_messages] extra
       ?  (eq i ts.len)
          acc
       (_ i.inc acc.snoc((node_msg ts.at(i))))
  (tool_answer b cards.weld(ac)
    out.put(['count] (pd (add n0 ts.len))) e2 cid
    (weft/cat ["adopted: " (weft/show_nat ts.len) " turns appended"]))
+  run_call
  '  One tool call, by name.  Immediate tools answer in this round;
  '  peek parks and answers on the next hear.
  \  b=bowl full=row[chat_messages] cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] c=chat_tool_call
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  name  c.function.name
  =  args
       ?  (parse c.function.arguments)
        > (./ok v rest)  v
        > (./err why rest)  jnull
  ?  (eq name "peek")
     (run_peek b cards out extra c.id args)
  ?  (eq name "note")
     (run_note b cards out extra c.id args)
  ?  (eq name "fork")
     (run_fork b full cards out extra c.id args)
  ?  (eq name "adopt")
     (run_adopt b cards out extra c.id args)
  (tool_answer b cards out extra c.id
    (weft/cat2 "unknown tool: " name))
+  take_plain
  '  A plain assistant reply: appended and taken; empty is left open.
  \  b=bowl cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] kk=iota body=nat
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  ?  (eq 0 body)
     [cards out extra]
  =  n  out.nat_at(['count] 0)
  =  c2
       .  cards
          snoc([b.here.weld(conv_slot.snoc(($u n)))
                (writ/make (msg_rec "assistant" body))])
          snoc([b.here.weld(api_slot.snoc(kk))
                (writ/poke (myth/new).put(['taken] (pd 1)))])
  [c2 out.put(['count] (pd n.inc)) extra]
+  take_ok
  '  One answered request kid.  An empty result is left open (the
  '  thinking line stays honest); a plain reply is appended and the
  '  kid taken; a tool-calling reply appends the calling turn with
  '  its ['tc] groups, then runs each call in order.
  \  b=bowl full=row[chat_messages] cards=row[[p=path q=writ]] out=myth extra=row[chat_messages] kk=iota r=chat_result
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  ?  (eq 0 r.choices.len)
     [cards out extra]
  =  m     r.choices.at(0).message
  =  body  (msg_text m)
  =  calls
       ?  m.tool_calls
        > .none  []
        > (./some cs)  cs
  ?  (eq 0 calls.len)
     (take_plain b cards out extra kk body)
  =  n     out.nat_at(['count] 0)
  =  crec  (call_rec body calls)
  =  c2
       .  cards
          snoc([b.here.weld(conv_slot.snoc(($u n)))
                (writ/make crec)])
          snoc([b.here.weld(api_slot.snoc(kk))
                (writ/poke (myth/new).put(['taken] (pd 1)))])
  =  o2  out.put(['count] (pd n.inc))
  =  e2  extra.snoc((node_msg crec))
  %    j=nat 0    cc=row[[p=path q=writ]] c2    oo=myth o2    ee=row[chat_messages] e2
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  ?  (eq j calls.len)
     [cc oo ee]
  =  [c3 o3 e3]  (run_call b full cc oo ee calls.at(j))
  (_ j.inc c3 o3 e3)
+  answer_peeks
  '  Parked peeks answered from their watches: each appends its tool
  '  turn, marks its slot done, and drops the watch.
  \  b=bowl fat=axal[myth] cards=row[[p=path q=writ]] out=myth extra=row[chat_messages]
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  =  pcs  fat.dip(pc_slot).kid_tap
  %    i=nat 0    cc=row[[p=path q=writ]] cards    oo=myth out    ee=row[chat_messages] extra
  ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
  ?  (eq i pcs.len)
     [cc oo ee]
  =  e  pcs.at(i)
  ?  e.val.fil
   > .none  (_ i.inc cc oo ee)
   > (./some t=myth)
     ?  t.nat_at(['done] 0)
        (_ i.inc cc oo ee)
     =  cid   (myth/txt_at ['id] t)
     =  view  b.crew.gut(peek_slot.snoc(e.key) (axal/new[myth] .none))
     =  r  (tool_answer b cc oo ee cid (peek_text view))
     =  [c2 o2 e2]  r
     =  c3  c2.snoc([b.here.weld(pc_slot.snoc(e.key))
                     (writ/poke (myth/new).put(['done] (pd 1)))])
     =  o3  o2.put(crew_slot (cpail (crew_drop peek_slot.snoc(e.key) (crew_of_conv o2))))
     (_ i.inc c3 o3 e2)
+  ends_tool
  '  Does the round end on a tool answer the model has not seen?
  \  extra=row[chat_messages]
  ^  bool
  ?  (eq 0 extra.len)
     .false
  ?=((./tool _) extra.at((sub extra.len 1)))
+  ask_again
  '  The follow-up request after a fully answered tool round: the
  '  model speaks to its results.
  \  b=bowl full=row[chat_messages] cards=row[[p=path q=writ]] out=myth extra=row[chat_messages]
  ^  yell
  =  k   out.nat_at(['reqs] 0)
  =  c2  cards.snoc([b.here.weld(api_slot.snoc(($u k)))
                     (writ/make (req_rec full.weld(extra)
                                  (model_of out)
                                  (myth/txt_at ['temp] out)))])
  (yell c2 out.put(['reqs] (pd k.inc)))
+  conv_hear
  '  Something under the conversation changed.  Answered request kids
  '  append their turns: a plain reply is the assistant's turn as
  '  ever; a reply that CALLS TOOLS appends the calling turn, runs
  '  the immediate tools (fork, adopt, note), and parks its peeks.
  '  Parked peeks from an earlier round are answered here from their
  '  now-hydrated watches — and once every call of a round has its
  '  answer, one follow-up request is asked, so the model speaks to
  '  what it found.  ['taken] keeps every append idempotent (the crew
  '  fires on our own writes too).
  \  b=bowl cur=myth changed=row[dep]
  ^  yell
  =  fat   b.crew.gut(['self] (axal/new[myth] .none))
  =  kids  fat.dip(api_slot).kid_tap
  =  full  (full_history b cur fat)
  =  r1
       %    i=nat 0    cards=row[[p=path q=writ]] []    out=myth cur    extra=row[chat_messages] []
       ^  [c=row[[p=path q=writ]] o=myth e=row[chat_messages]]
       ?  (eq i kids.len)
          [cards out extra]
       =  e  kids.at(i)
       ?  e.val.fil
        > .none  (_ i.inc cards out extra)
        > (./some t=myth)
          ?  t.nat_at(['taken] 0)
             (_ i.inc cards out extra)
          ?  t.get(bond/res)
           > .none  (_ i.inc cards out extra)
           > (./some held=pail)
             ?  held
              > o=chat_result_r/ok
                =  [c2 o2 e2]  (take_ok b full cards out extra e.key o.v)
                (_ i.inc c2 o2 e2)
              > er=chat_result_r/err
                =  n  out.nat_at(['count] 0)
                =  c2
                     .  cards
                        snoc([b.here.weld(conv_slot.snoc(($u n)))
                              (writ/make (msg_rec "assistant"
                                           (weft/cat2 "error: " er.why)))])
                        snoc([b.here.weld(api_slot.snoc(e.key))
                              (writ/poke (myth/new).put(['taken] (pd 1)))])
                (_ i.inc c2 out.put(['count] (pd n.inc)) extra)
              (_ i.inc cards out extra)
  =  [cards1 out1 extra1]  r1
  =  r2  (answer_peeks b fat cards1 out1 extra1)
  =  [cards2 out2 extra2]  r2
  =  newp  (sub out2.nat_at(['pcs] 0) cur.nat_at(['pcs] 0))
  ?  (if (ends_tool extra2) (eq 0 newp) 0)
     (ask_again b full cards2 out2 extra2)
  (yell cards2 out2)
+  fork_kn
  '  Clamp a branch count: 1..8, 0 means the default 2.
  \  k=nat
  ^  nat
  ?  (eq k 0)
     2
  ?  (gt k 8)
     8
  k
+  fork_k
  '  How many branches a fork form asked for.
  \  fk=nat
  ^  nat
  (fork_kn (txt_nat fk))
+  branch_conv
  '  A branch conversation record at birth: the parent's own kook,
  '  the fork point, the grown chain (the parent's links plus the
  '  parent itself), counters per mode, and the model and temperature
  '  it inherits.
  \  cur=myth here=path n=nat lp=pail seeded=nat tprm=nat
  ^  myth
  =  m  cur.nat_at(['links] 0)
  =  t0
       .  (myth/new)
          put(limb_slot lp)
          put(['parent] (pails/p here))
          put(['at] (pd n))
          put(['status] (pails/t "live"))
          put(['links] (pd m.inc))
          put((chain_at m) (pails/p here))
          put((cat_at m) (pd n))
          put(['count] (pd seeded))
          put(['reqs] (pd 1))
  =  t1
       %    i=nat 0    acc=myth t0
       ?  (eq i m)
          acc
       =  a2  (copy_slot (chain_at i) cur acc)
       (_ i.inc (copy_slot (cat_at i) cur a2))
  =  t2  (copy_slot ['model] cur t1)
  ?  !(eq 0 tprm)
     t2.put(['temp] (pails/t (str/from_atom tprm)))
  (copy_slot ['temp] cur t2)
+  branch_api
  '  A branch's hand node at birth: the parent hand's kook, its base
  '  and credential carried over, and a fresh http crew slot — the
  '  same shape api_seed mounts, minus the host's provisioning step,
  '  which already happened to the parent.
  \  api_t=myth
  ^  myth
  =  t0
       .  (myth/new)
          put(crew_slot (cpail (crew/sing ['http] (dep .x (publisher_vocabulary/service ['io 'http_client])))))
  =  t1  (copy_slot ['base] api_t t0)
  =  t2  (copy_slot ['auth] api_t t1)
  (copy_slot limb_slot api_t t2)
+  fork_cards
  '  The cards minting k branches at the next fork indices: each
  '  branch conv (kook, chain grown to the given cut), its hand node
  '  (credential carried over), the optional divergent turn, and an
  '  immediate request kid built from the given prompt.  Empty when
  '  this conv has no hand or no kook to pass on.
  \  b=bowl cur=myth fat=axal[myth] k=nat body=nat tprm=nat base=row[chat_messages] cut=nat
  ^  row[[p=path q=writ]]
  ?>  (./some api_t) fat.dip(api_slot).fil
      []
  ?>  (./some lp) cur.get(limb_slot)
      []
  =  f0  cur.nat_at(['forks] 0)
  =  msgs
       ?  (eq 0 body)
          base
       base.snoc((turn_msg "user" body))
  =  temp
       ?  (eq 0 tprm)
          (myth/txt_at ['temp] cur)
       tprm
  =  seeded
       ?  (eq 0 body)
          0
       1
  %    j=nat 0    cards=row[[p=path q=writ]] []
  ^  row[[p=path q=writ]]
  ?  (eq j k)
     cards
  =  bp  b.here.weld(fork_slot.snoc(($u (add f0 j))))
  =  c1  cards.snoc([bp (writ/make (branch_conv cur b.here cut lp seeded tprm))])
  =  c2  c1.snoc([bp.weld(api_slot) (writ/make (branch_api api_t))])
  =  c3
       ?  (eq 0 body)
          c2
       c2.snoc([bp.weld(conv_slot.snoc(($u 0)))
                (writ/make (msg_rec "user" body))])
  =  c4  c3.snoc([bp.weld(api_slot.snoc(($u 0)))
                  (writ/make (req_rec msgs (model_of cur) temp))])
  (_ j.inc c4)
+  conv_fork
  '  A fork asked through the page: k branch conversations under
  '  ['fork], each sharing this history by reference and continuing
  '  on its own straight away.  With ['post 'text] each branch takes
  '  that turn first; without, the branches resample the
  '  conversation as it stands.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  k     (fork_k (myth/txt_at ['post 'fork] nu))
     body  (myth/txt_at ['post 'text] nu)
     tprm  (myth/txt_at ['post 'temp] nu)
  =  fat  b.crew.gut(['self] (axal/new[myth] .none))
  =  f0   cur.nat_at(['forks] 0)
  =  base  (full_history b cur fat)
  =  bc  (fork_cards b cur fat k body tprm base cur.nat_at(['count] 0))
  ?  (eq 0 bc.len)
     (yell [] cur)
  (yell bc cur.put(['forks] (pd (add f0 k))))
+  adopt_cards
  '  Adoption's cards: branch a's own turns copied verbatim (edits
  '  included) onto the trunk at n0.., and the status flips — the
  '  winner adopted, its live siblings killed.  [cards turns], turns
  '  empty when branch a is not live.
  \  b=bowl fat=axal[myth] a=nat n0=nat
  ^  [c=row[[p=path q=writ]] ts=row[myth]]
  =  bsub  fat.dip(fork_slot.snoc(($u a)))
  ?>  (./some bt) bsub.fil
      [[] []]
  ?  !(eq "live" (myth/txt_at ['status] bt))
     [[] []]
  =  kids  bsub.dip(conv_slot).kid_tap
  =  copied
       %    i=nat 0    cards=row[[p=path q=writ]] []    ts=row[myth] []
       ^  [c=row[[p=path q=writ]] ts=row[myth]]
       ?  (eq i kids.len)
          [cards ts]
       =  e  kids.at(i)
       ?  e.val.fil
        > .none  (_ i.inc cards ts)
        > (./some t=myth)
          (_ i.inc
             cards.snoc([b.here.weld(conv_slot.snoc(($u (add n0 ts.len))))
                         (writ/make t)])
             ts.snoc(t))
  =  [cards0 ts0]  copied
  =  forks  fat.dip(fork_slot).kid_tap
  =  cards1
       %    i=nat 0    acc=row[[p=path q=writ]] cards0
       ?  (eq i forks.len)
          acc
       =  e  forks.at(i)
       ?  e.val.fil
        > .none  (_ i.inc acc)
        > (./some t=myth)
          ?  !(eq "live" (myth/txt_at ['status] t))
             (_ i.inc acc)
          =  st
               ?  (eq (quip_val e.key) a)
                  "adopted"
               "killed"
          (_ i.inc acc.snoc([b.here.weld(fork_slot.snoc(e.key))
                             (writ/poke (myth/new).put(['status] (pails/t (str/from_atom st))))]))
  [cards1 ts0]
+  conv_adopt
  '  Adoption asked through the page: the winner's turns land here
  '  and the trunk continues as the live conversation.  The branch
  '  keeps its request kids and its history — nothing is unwritten.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  a    (txt_nat (myth/txt_at ['post 'adopt] nu))
  =  fat  b.crew.gut(['self] (axal/new[myth] .none))
  =  n0   cur.nat_at(['count] 0)
  =  r    (adopt_cards b fat a n0)
  =  [cards ts]  r
  ?  (eq 0 ts.len)
     (yell [] cur)
  (yell cards cur.put(['count] (pd (add n0 ts.len))))
+  conv_form
  '  The conversation behavior: init watches, talk asks, hear answers.
  ^  form
  def_form.set_init(conv_init).set_talk(conv_talk).set_hear(conv_hear)
+  conv_seed
  '  The seeded conversation: empty, carrying the conv kook
  '  (app-relative — the mount rebases pact/rel paths only).
  ^  myth
  (kooked [(pact/rel ['kook 'conv])])
+  api_seed
  '  The generated hand's node — seeded WITHOUT a behavior.
  '  .
  '  The hand's form closes over the whole compiled client (190 types
  '  and their serde), and a manifest is stored entire on the app card
  '  and re-expanded on every remount, so carrying it here would put
  '  that closure in the namespace twice and drag it through every
  '  mount.  The host registers the form once in the kernel registry
  '  and pokes this node's limb to point at it, exactly as it
  '  provisions any other driver-backed capability the app asked for.
  '  Until that lands the node is inert, which is the honest state of
  '  an app whose grant has not been provisioned.
  '  .
  '  ['base] is the server the schema named; ['auth] is poked in at
  '  boot (an unauthenticated client is a real case, so an absent key
  '  is not a mount failure); the ['http] crew slot is how the hand
  '  finds the fetch driver.
  '  .
  '  The seed carries the /kook/llm REF itself (a path, not the
  '  closure): a remount's presence check reads the card's .y bowl,
  '  which cannot see grandkids, so a depth-two seed re-MAKES and a
  '  make replaces — without the ref here, every remount would strip
  '  this node's behavior (and it did, once).  ['auth] remains
  '  host-poked and needs re-poking after a remount.
  ^  myth
  .  (kooked [(publisher_vocabulary/service ['kook 'llm])])
     put(['base] (pails/t "https://openrouter.ai/api/v1"))
     put(crew_slot (cpail (crew/sing ['http] (dep .x (publisher_vocabulary/service ['io 'http_client])))))
+  chat_css
  ^  nat
  "body{font-family:sans-serif;max-width:44em;margin:2em auto;padding:0 1em} h1{font-size:1.2em;color:#345} #log > div{display:flex;flex-direction:column;gap:.6em;margin:1em 0} .msg{padding:.5em .8em;border-radius:1em;max-width:80%;white-space:pre-wrap} .user{background:#dde8ff;align-self:flex-end} .assistant{background:#eee;align-self:flex-start} .who{font-size:.7em;color:#667;margin-bottom:.2em} .pending{color:#999;font-style:italic} .tool{background:#fff7e0;align-self:flex-start;font-size:.85em} .call{font-family:ui-monospace,monospace;font-size:.8em;color:#886;white-space:pre-wrap;overflow-wrap:anywhere} form{display:flex;gap:.5em;align-items:center;margin-top:1em} input[type=text]{flex:1;padding:.5em} .bar{display:flex;gap:.5em;align-items:center;font-size:.8em;color:#667}"
+  conv_path_of
  '  The governing conversation for a request target: the mount's
  '  conv node, extended by each ['fork <n>] pair the target descends
  '  through — /chat is the trunk, /chat/conv/fork/1/fork/0 is a
  '  grandchild, and a msgs or api target belongs to the conv above.
  \  root=path tgt=path
  ^  path
  %    p=path root.weld(['conv])
  ?  (lt tgt.len (add p.len 2))
     p
  ?  !(eq_pith tgt.take(p.len) p)
     p
  ?  !(eq_iota tgt.at(p.len) 'fork)
     p
  (_ p.weld(fork_slot.snoc(tgt.at(p.len.inc))))
+  conv_view_of
  '  The governing conv subtree as seen from a target-rooted view:
  '  the whole view at the conv node itself, a dip below the target,
  '  and empty when the target sits under the conv node — the frag
  '  still renders live either way.
  \  tgt=path convp=path view=axal[myth]
  ^  axal[myth]
  ?  (lt convp.len tgt.len)
     (axal/new[myth] .none)
  ?  !(eq_pith convp.take(tgt.len) tgt)
     (axal/new[myth] .none)
  view.dip(convp.drop(tgt.len))
+  root_of
  '  A request under /<publisher>/app/<instance>, or a direct publisher child.
  \ tgt=path
  ^ path
  ? (lt tgt.len 3) tgt
  ? (eq_iota tgt.at(1) 'app) tgt.take(3)
  tgt.take(2)
+  pending
  '  Whether any request kid is still waiting on an answer — what the
  '  component shows as the model thinking.
  \  conv=axal[myth]
  ^  nat
  =  kids  conv.dip(api_slot).kid_tap
  %    i=nat 0
  ?  (eq i kids.len)
     0
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc)
   > (./some t=myth)
     ?  t.nat_at(['taken] 0)
        (_ i.inc)
     1
+  msg_nodes
  '  The conversation, oldest first, each turn on its own side.  Every
  '  turn's text — the model's included — is a w-edit run: its
  '  mount-relative path is msgs/<n>, so editing rendered words pokes
  '  the turn's record, and /h keeps what was really said.
  \  conv=axal[myth]
  ^  row[weft/node]
  =  kids  conv.dip(conv_slot).kid_tap
  %    i=nat 0    out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  who  (myth/txt_at ['who] t)
     =  ed   (weft/cat ["msgs/" (weft/show_nat (quip_val e.key)) " text"])
     =  nd
          (weft/el "div" [(weft/cls (weft/cat2 "msg " who))]
            [(weft/el "div" [(weft/cls "who")] [(weft/tx who)])
             (weft/el "span" [(weft/att "w-edit" ed)]
               [(weft/tx t.txt_at(['text]))])])
     (_ i.inc out.snoc(nd))
+  log_nodes
  '  The rendered log, with a thinking line while a request is open.
  \  conv=axal[myth]
  ^  row[weft/node]
  =  ms  (msg_nodes conv)
  ?  (pending conv)
     ms.snoc((weft/el "div" [(weft/cls "msg assistant pending")]
               [(weft/tx "thinking...")]))
  ms
+  log_html
  '  The log component's projection: the conversation as turns plus
  '  the thinking line — a pure function of the conv subtree, its
  '  markup riding the ['html] slot for the /frag responder.  The
  '  model's reply lands as an ordinary committed turn, so the same
  '  poll that converges two humans' windows delivers the machine's.
  \  fat=axal[myth]
  ^  myth
  (frag/html "div" [] (log_nodes fat))
+  log_view
  '  The log component: a felt over the conv subtree (turns and
  '  request kids are kids, so the input is the z view).
  ^  pail
  (felt log_html .none)
+  call_nodes
  '  An assistant turn's tool calls, one line each.
  \  t=myth
  ^  row[weft/node]
  =  ntc  (myth/nat_at ['tcs] 0 t)
  %    j=nat 0    out=row[weft/node] []
  ?  (eq j ntc)
     out
  =  nm  (myth/txt_at (tc_at j ['name]) t)
     ar  (myth/txt_at (tc_at j ['args]) t)
  (_ j.inc out.snoc((weft/el "div" [(weft/cls "call")]
                      [(weft/tx (weft/cat [">> " nm " " ar]))])))
+  msg_nodes2
  '  The conversation with its tool traffic: user and assistant turns
  '  as ever (texts w-edit runs), an assistant's tool calls as lines
  '  in its bubble, and tool answers as their own quiet turns.
  \  conv=axal[myth]
  ^  row[weft/node]
  =  kids  conv.dip(conv_slot).kid_tap
  %    i=nat 0    out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  who  (myth/txt_at ['who] t)
     =  ed   (weft/cat ["msgs/" (weft/show_nat (quip_val e.key)) " text"])
     =  base
          [(weft/el "div" [(weft/cls "who")] [(weft/tx who)])
           (weft/el "span" [(weft/att "w-edit" ed)]
             [(weft/tx t.txt_at(['text]))])]
     =  nd
          (weft/el "div" [(weft/cls (weft/cat2 "msg " who))]
            base.weld((call_nodes t)))
     (_ i.inc out.snoc(nd))
+  log2_nodes
  '  The rendered log, with a thinking line while a request is open.
  \  conv=axal[myth]
  ^  row[weft/node]
  =  ms  (msg_nodes2 conv)
  ?  (pending conv)
     ms.snoc((weft/el "div" [(weft/cls "msg assistant pending")]
               [(weft/tx "thinking...")]))
  ms
+  log2_html
  '  The tool-aware log component's projection.
  \  fat=axal[myth]
  ^  myth
  (frag/html "div" [] (log2_nodes fat))
+  log2_view
  '  The tool-aware log component: a felt over the conv subtree.
  ^  pail
  (felt log2_html .none)
+  fork_head
  '  The branch banner: where this conversation forked from, or
  '  nothing for the trunk.
  \  conv=axal[myth]
  ^  row[weft/node]
  ?  conv.fil
   > .none  []
   > (./some t=myth)
     ?  (pth_at ['parent] t)
      > .none  []
      > (./some pp=path)
        [(weft/el "div" [(weft/cls "bar")]
           [(weft/tx "forked from ")
            (weft/el "a" [(weft/att "href" (show/path pp))]
              [(weft/tx (show/path pp))])
            (weft/tx (weft/cat [" at turn "
                                (weft/show_nat t.nat_at(['at] 0))
                                " - "
                                (myth/txt_at ['status] t)]))])]
+  branch_rows
  '  The branch deck: one line per fork — a link, its status and
  '  turn count, and an adopt button while it is live.
  \  convp=path conv=axal[myth] post_url=nat
  ^  row[weft/node]
  =  kids  conv.dip(fork_slot).kid_tap
  %    i=nat 0    out=row[weft/node] []
  ?  (eq i kids.len)
     out
  =  e  kids.at(i)
  ?  e.val.fil
   > .none  (_ i.inc out)
   > (./some t=myth)
     =  bn   (weft/show_nat (quip_val e.key))
        bpp  convp.weld(fork_slot.snoc(e.key))
        st   (myth/txt_at ['status] t)
        nm   e.val.dip(conv_slot).kid_tap.len
     =  lead
          [(weft/el "a" [(weft/att "href" (show/path bpp))]
             [(weft/tx (weft/cat2 "fork " bn))])
           (weft/tx (weft/cat [" - " st " - "]))
           (weft/tx (weft/cat2 (weft/show_nat nm) " turns"))]
     =  ns
          ?  (eq "live" st)
             lead.snoc((weft/el "form"
               [(weft/att "method" "post") (weft/att "action" post_url)
                (weft/att "w-post" "1") (weft/att "w-refresh" "log")]
               [(weft/el "input"
                  [(weft/att "type" "hidden") (weft/att "name" "adopt")
                   (weft/att "value" bn)] [])
                (weft/leaf "button" [] "adopt")]))
          lead
     (_ i.inc out.snoc((weft/el "div" [(weft/cls "bar")] ns)))
+  chat_page
  '  The container: the conversation fragment (kept fresh by the
  '  /w.js runtime), the ask box, the fork bar and the branch deck,
  '  and the model bar — w-post intercepts the submits, pokes
  '  through /post, then refreshes the log fragment, so the page
  '  never reloads out from under its author.  On a branch the page
  '  banners where it forked from.  The omni-scrubber replays the
  '  whole exchange — question, thinking, answer — from any epoch.
  \  root=path convp=path conv=axal[myth] first=nat top=nat
  ^  nat
  =  post_url  (weft/cat2 "/post" (show/path convp))
     model
       ?  conv.fil
        > (./some t=myth)  (model_of t)
        > .none  dflt_model
     temp
       ?  conv.fil
        > (./some t2=myth)  (myth/txt_at ['temp] t2)
        > .none  0
     scrub=row[weft/node]
       ?  top
          [(frag/scrubber first top)]
       []
  =  ask
       (weft/el "form"
         [(weft/att "method" "post") (weft/att "action" post_url)
          (weft/att "w-post" "1") (weft/att "w-refresh" "log")]
         [(weft/el "input"
            [(weft/att "type" "text") (weft/att "name" "text")
             (weft/att "autocomplete" "off")] [])
          (weft/leaf "button" [] "send")])
     forkbar
       (weft/el "form"
         [(weft/att "method" "post") (weft/att "action" post_url)
          (weft/att "w-post" "1") (weft/att "w-refresh" "log")
          (weft/cls "bar")]
         [(weft/leaf "span" [] "fork")
          (weft/el "input"
            [(weft/att "type" "text") (weft/att "name" "fork")
             (weft/att "value" "2") (weft/att "size" "2")] [])
          (weft/el "input"
            [(weft/att "type" "text") (weft/att "name" "text")
             (weft/att "autocomplete" "off")
             (weft/att "placeholder" "optional divergent turn")] [])
          (weft/leaf "button" [] "fork")])
     bar
       (weft/el "form"
         [(weft/att "method" "post") (weft/att "action" post_url)
          (weft/att "w-post" "1") (weft/cls "bar")]
         [(weft/leaf "span" [] "model")
          (weft/el "input"
            [(weft/att "type" "text") (weft/att "name" "model")
             (weft/att "value" model)] [])
          (weft/leaf "span" [] "temp")
          (weft/el "input"
            [(weft/att "type" "text") (weft/att "name" "temp")
             (weft/att "value" temp) (weft/att "size" "4")
             (weft/att "placeholder" "0.7")] [])
          (weft/leaf "button" [] "set")])
  =  body0  [(weft/leaf "h1" [] "chat")]
  =  body1  body0.weld((fork_head conv))
  =  body2
       .  body1
          snoc((frag/mount "log" root.weld(['weft 'log2]) convp 1))
          snoc(ask)
          snoc(forkbar)
  =  body3  body2.weld((branch_rows convp conv post_url))
  =  body   body3.snoc(bar)
  (weft/page "chat" chat_css body.weld(scrub).snoc(frag/script))
+  face_talk
  '  The app's HTTP face: the container page for the request
  '  target's governing conversation — trunk or branch, at any
  '  depth.  Same responder contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       | (myth/path_at ['vpath] out).fall []
  =  root   (root_of tgt)
  =  convp  (conv_path_of root tgt)
     view   b.crew.gut(['view] (axal/new[myth] .none))
  =  page  (chat_page root convp (conv_view_of tgt convp view)
             (frag/ver_nat b publisher_vocabulary/version/first) (frag/ver_nat b publisher_vocabulary/version/top))
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd page))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  weft_seed
  '  The log component seed — code-built: a template cannot carry a
  '  component ctor pail.  Superseded by log2 (components are
  '  write-once, so the tool-aware log mounts at a fresh path); kept
  '  so worlds that already carry /chat/weft/log keep rendering.
  ^  [p=path t=myth]
  [['weft 'log]
   (weft_card log_view (pact/rel ['conv])
     (lore "The log component: the conversation as turns, a felt over the conv subtree."
           ["The log component: the conversation as turns, a felt over the conv subtree."
            "Input: the z view of a conv node - ['msgs] kids each carrying ['who] and ['text], ['api] kids whose unanswered requests render as a thinking line."
            "Output: a column of .msg turns, oldest first, each side-tagged (user right, assistant left), every text a w-edit run."
            "Point it at any node whose kids look like a conversation - the shape is the whole contract."]
           []))]
+  weft_seed2
  '  The tool-aware log component seed, at its own fresh path.
  ^  [p=path t=myth]
  [['weft 'log2]
   (weft_card log2_view (pact/rel ['conv])
     (lore "The log component: the conversation as turns and tool traffic, a felt over the conv subtree."
           ["The log component: the conversation as turns and tool traffic, a felt over the conv subtree."
            "Input: the z view of a conv node - ['msgs] kids each carrying ['who] and ['text] (assistant kids may carry ['tc] call groups, tool kids ['tcid]), ['api] kids whose unanswered requests render as a thinking line."
            "Output: a column of .msg turns, oldest first, each side-tagged (user right, assistant left, tool answers quiet), calls as lines in their bubble, every text a w-edit run."
            "Point it at any node whose kids look like a conversation - the shape is the whole contract."]
           []))]
+  app
  '  The chat app: the conversation, the generated API hand, the log
  '  component, and the face.  The wants row is the ask that makes
  '  the whole thing possible — without a granted ['gfetch] the
  '  hand's fetch card is dropped as an ungoverned move and no
  '  request ever leaves.
  ^  mani
  (mani 'chat
        (lore "A conversation with a language model, held in the namespace."
              ["A conversation with a language model, held in the namespace."
               "A post appends the turn and makes a request kid under ['api]; the generated OpenRouter hand fetches, and its reply is heard back and appended as the assistant's turn."
               "Every message and every request is an addressable node, so /h scrubs the whole exchange, the scrubber replays it, and w-edit rewrites it in place."
               "Set the model with the second box; it is remembered as a slot on the conversation, as is an optional sampling temperature."
               "A conversation can fork: k branch conversations under ['fork] share its history by reference and each continues on its own request; adopting one copies its turns back up and kills its live siblings."
               "The model has namespace tools: peek reads any node (histories and overlays included, via a parked watch), fork and adopt drive the conversation's own branching, and note writes to its own subtree. Tool traffic is turns like any other."]
              [])
        [(kook/decl 'conv conv_form (lore/line "The conversation: talk takes a turn and asks, hear appends the answer."))
         (kook/decl 'face face_form (lore/line "The HTML face: the container page — the log fragment, the ask box, the model bar, the scrubber."))]
        [[['conv] conv_seed]
         [['conv 'api] api_seed]
         weft_seed2]
        [.gfetch])
