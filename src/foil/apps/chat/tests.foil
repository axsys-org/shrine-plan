-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  weft [order=80]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  helm [order=130]
-  testing [order=170]
-  json [order=180]
-  open_router_api [order=200]
-  test_chat_app [order=220]
-  app_test_world [order=230]
+  chat_tests
  +  seed
    ^ app_world
    = world
        | app_world/make ['kook 'llm]
          (form/card def_form (lore/line "No outbound driver."))
          app_world/seed
    | app_world/mount app "apps/chat/main" ['chat] world
  +  log
    \ target=path world=app_world
    ^ text
    = opath=path
        ['o ($u 1) ($u 3) 'chat 'weft 'log2 ($u target.len)]
    | app_world/page opath.weld(target) .true world
  +  tools
    \ _=unit
    ^ row[testing/check]
    = args
        | str/from_atom
        | cord/cat_all
          ["{" 34 "path" 34 ":" 34 "/h/care" 34 "}"]
    = call
        | call_rec "" [(t_tool_call args "peek" "call_9")]
    = tool
        | tool_rec "call_9" "the answer"
    = [first second]
        | t_tool_round 0
    = [p1 w1]
        first.at(0)
    = [p2 w2]
        second.at(0)
    = [pa0 wa0] first.at(1)
    = [pc0 wc0] first.at(2)
    = [pc1 wc1] second.at(1)
    = [pa1 wa1] second.at(2)
    = ct=myth
        ? w1
         > (./make record) record
        myth/new
    = tt=myth
        ? w2
         > (./make record) record
        myth/new
    = parsed=text
        ? (parse args)
         > (./ok object _) (str/from_atom (jtxt "path" object))
        "invalid JSON"
    [(testing/text "tool argument JSON" "/h/care" parsed)
     (testing/nat "tool path" 1
       (equal[path] ['h 'care] (txt_path "/h/care")))
     (testing/text "round call name" "peek"
       ct.txt_at(['tc ($u 0) 'name]))
     (testing/text "round call id" "c9"
       ct.txt_at(['tc ($u 0) 'id]))
     (testing/text "round answer role" "tool" tt.txt_at(['who]))
     (testing/text "round answer id" "c9" tt.txt_at(['tcid]))
     (testing/nat "take first API request" 1
       (equal[path] ['chat 'conv 'api ($u 0)] pa0))
     (testing/nat "park peek" 1
       (equal[path] ['chat 'conv 'pc ($u 0)] pc0))
     (testing/nat "close peek" 1 (equal[path] pc0 pc1))
     (testing/nat "follow-up API path" 1
       (equal[path] ['chat 'conv 'api ($u 1)] pa1))
     (testing/nat "follow-up request made" 1 ?=((./make _) wa1))
     (testing/nat "numeric path" 1
       (equal[path] ['chat 'conv 'fork ($u 0)]
         (txt_path "/chat/conv/fork/0")))
     (testing/nat "tool call stored" 1 call.nat_at(['tcs] 0))
     (testing/text "call name" "peek"
       call.txt_at(['tc ($u 0) 'name]))
     (testing/text "call id" "call_9"
       call.txt_at(['tc ($u 0) 'id]))
     (testing/text "arguments" args call.txt_at(['tc ($u 0) 'args]))
     (testing/text "tool role" "tool" tool.txt_at(['who]))
     (testing/text "tool id" "call_9" tool.txt_at(['tcid]))
     (testing/nat "assistant wire message" 1
       ?=((chat_messages/assistant _) (node_msg call)))
     (testing/nat "tool wire message" 1
       ?=((chat_messages/tool _) (node_msg tool)))
     (testing/nat "first round writes" 3 first.len)
     (testing/nat "second round writes" 3 second.len)
     (testing/nat "calling turn path" 1
       (equal[path] ['chat 'conv 'msgs ($u 1)] p1))
     (testing/nat "answer turn path" 1
       (equal[path] ['chat 'conv 'msgs ($u 2)] p2))]
  +  conversation
    \ _=unit
    ^ row[testing/check]
    = root=path
        ['chat 'conv]
    = base
        chat_tests/seed
    = empty
        | app_world/page ['chat] .false base
    = one
        | app_world/post root [['text "hello there"]] base
    = two
        | app_world/post root [['text "and again"]] one
    = model
        | app_world/post root [['model "openai/gpt-4o-mini"]] two
    = three
        | app_world/post root [['text "<script>boo"]] model
    = forked
        | app_world/post root
          [['fork "2"] ['text "try this"]] three
    = branch=path
        ['chat 'conv 'fork ($u 0)]
    = sibling=path
        ['chat 'conv 'fork ($u 1)]
    = born
        | app_world/get branch forked
    = answer
        | (myth/new).put ['who] (pails/t "assistant")
    = answer
        answer.put(['text] (pails/t "branch reply"))
    = replied
        | app_world/make branch.weld(['msgs ($u 1)])
          answer forked
    = replied
        | app_world/poke branch
          (myth/sing ['count] (pd 2)) replied
    = adopted
        | app_world/post root [['adopt "0"]] replied
    = settled
        | app_world/post root [['adopt "1"]] adopted
    = temp
        | app_world/post root [['temp "0.7"]] settled
    = sampled
        | app_world/post root [['fork "1"]] temp
    = b2=path
        ['chat 'conv 'fork ($u 2)]
    = trunk
        | app_world/get root sampled
    = last
        | app_world/get b2 sampled
    = card
        | app_world/get ['chat] base
    = checks=row[testing/check]
        [(app_world/okay sampled)
         (testing/nat "wants fetch" 1 card.nat_at(['wants 'fetch] 0))
         (testing/nat "denied fetch" 0
           card.nat_at(['grants 'fetch] 1))
         (testing/text "branch live" "live" born.txt_at(['status]))
         (testing/nat "shared prefix" 3 born.nat_at(['at] 0))
         (testing/nat "history reference" 1 born.nat_at(['links] 0))
         (testing/nat "divergent turn" 1 born.nat_at(['count] 0))
         (testing/nat "branch request" 1 born.nat_at(['reqs] 0))
         (testing/nat "adoption/no-op count" 5
           trunk.nat_at(['count] 0))
         (testing/text "winner" "adopted"
           (app_world/get branch sampled).txt_at(['status]))
         (testing/text "loser" "killed"
           (app_world/get sibling sampled).txt_at(['status]))
         (testing/nat "resample no turns" 0 last.nat_at(['count] 9))
         (testing/nat "resample prefix" 5 last.nat_at(['at] 0))
         (testing/text "inherited temperature" "0.7"
           last.txt_at(['temp]))
         (testing/nat "resample request exists" 1
           (app_world/exists b2.weld(['api ($u 0)]) sampled))]
    | checks.weld
    | (app_world/contains ["component zoo" "chat_weft_log"
        "/weft/chat_weft_log2" "/w.js"]
        (app_world/page ['weft] .false base)).weld
    | (app_world/contains ["felt" "/ns/boot/apps/chat/main"
        "the shape is the whole contract"
        "/frag/1/3/chat/weft/log2/2/chat/conv"]
        (app_world/page ['weft 'chat_weft_log2] .false base)).weld
    | (app_world/contains ["/frag/1/3/chat/weft/log2/2/chat/conv"]
        (app_world/page root .false base)).weld
    | (app_world/contains ["openai/gpt-4o-mini"]
        (app_world/page ['chat] .false model)).weld
    | (app_world/contains ["try this" "thinking"]
        (chat_tests/log branch forked)).weld
    | (app_world/contains
        ["/post/chat/conv" "w-post" "w-refresh" "/w.js"
         "/frag/1/3/chat/weft/log2/2/chat/conv"] empty).weld
    | (app_world/lacks ["thinking" "breadcrumb"] empty).weld
    | (app_world/contains ["hello there" "and again"
         "&lt;script&gt;boo" "thinking"]
         (chat_tests/log root three)).weld
    | (app_world/contains ["forked from" "/post/chat/conv/fork/0"
          "/frag/1/3/chat/weft/log2/4/chat/conv/fork/0"]
         (app_world/page branch .false forked)).weld
    | (app_world/contains ["fork 0" "fork 1" "adopt"
         "optional divergent turn"]
         (app_world/page ['chat] .false forked)).weld
    | app_world/contains ["try this" "branch reply"]
      (chat_tests/log root adopted)
+  tests
  ^ row[testing/case]
  [(testing/case "tool messages and rounds" chat_tests/tools)
   (testing/case "conversation, forks and adoption"
     chat_tests/conversation)]
