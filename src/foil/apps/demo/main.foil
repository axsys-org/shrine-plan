-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  demo: the counting behavior recast as a real application — mounted
'  through the pact pipeline at boot rather than baked into the
'  kernel image (doc/shrine-apps.md section 8, phase 6).
+  app
  '  The demo app: the counting behavior and one seeded face record.
  ^  mani
  =  t  myth/new
  (mani 'demo
        (lore/line "The demo app: a counter behavior and a seeded face record.")
        [(kook/decl 'count demo/count_form (lore/line "Counts: init makes a counting 'kid child."))]
        [[['face] t.add((limb/nat ['n] 41))]])
