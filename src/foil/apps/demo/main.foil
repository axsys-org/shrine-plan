-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  demo: the counting behavior recast as a real application. — mounted
'  through the pact pipeline at boot rather than baked into the
'  kernel image (doc/shrine-apps.md section 8, phase 6).
+  face_talk
  '  The root page: fixed text, so the hunt's reach is visible from
  '  a shell — this text at the claimed node, the explorer beyond.
  \  =bowl cur=myth add=myth
  ^  yell
  =  out  cur.meld(add)
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd "demo face: the .x hunt claims the root alone"))
          put(['res_ctype] (pd "text/plain; charset=utf-8"))
  (yell [] done)
+  face_form
  '  A depth-scoped face: the seeded .x hunt on its record claims
  '  the mount root alone, so kids stay on the raw explorer — the
  '  smallest demonstration of hunt-scoped dispatch.
  ^  form
  def_form.set_talk(face_talk)
+  bump_op
  '  The demo op card: add ['d] onto the record's ['n].  The input
  '  slot is DECLARED, so the explorer's ops pane renders a field
  '  for it.
  ^  myth
  =  f
       \  input=myth cur=myth
       ^  myth
       cur.put(['n] (pd (add (myth/nat_at ['n] 0 cur) (myth/nat_at ['d] 0 input))))
  (myth/new).put(['sys 'op] (op 'bump 'thing [[['d] "n"]] 'thing "op bump: thing > d n < thing" f))
+  card_get
  '  The demo card ctor: the datum's ['n] rendered as markup.
  \  t=myth
  ^  myth
  (frag/html "div" []
    [(weft/leaf "h2" [] "demo card")
     (weft/leaf "p" [] (weft/cat2 "n = " (weft/show_nat (myth/nat_at ['n] 0 t))))])
+  app
  '  The demo app: the counting behavior, a seeded face record that
  '  doubles as the datum-face proof (its bond/face binding renders
  '  it through the card component via the generic shell), and a
  '  live-link pair — ['link 'ref] is a safe onto ['tgt], kept
  '  current by the fresh kook.  The ['hunt] seed at the face's own
  '  kook path melds onto the kook card (pact/seeds pokes at this
  '  expansion's kook paths): the claim is data on the face record,
  '  pokeable live.
  ^  mani
  =  t  myth/new
  (mani 'demo
        (lore/line "The demo app: a counter behavior and a seeded face record.")
        [(kook/decl 'count demo/count_form (lore/line "Counts: init makes a counting 'kid child."))
         (kook/decl 'face face_form (lore/line "The root-only face: fixed text; its .x hunt leaves every kid to the explorer."))]
        [[['face] t.add((twig/nat ['n] 41)).put(bond/face (hunt .x (pact/rel ['weft 'card])))]
         [['kook 'face] (myth/sing ['hunt] (hunt .x []))]
         [['weft 'card] (weft_card (dyed card_get .none) (pact/rel ['face]) (lore/line "The demo card: a dyed ctor over a record's ['n]."))]
         [['tgt] (myth/sing ['m] (pd 1))]
         [['link] (kooked [['kook 'fresh]]).put(['ref] (safe 1 .x (pact/rel ['tgt])))]
         [['op 'bump] bump_op]]
        [])
