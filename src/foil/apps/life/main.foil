-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  life: Conway's Game of Life on an 8x8 torus, as a shrine app.
'  The board is one nat bitboard riding in a slot; a tick is one
'  poke, so a generation is one moment of the board's title and the
'  /h overlay is a generation scrubber for free.  The census kid
'  tallies the board through an ordinary x-care crew watch.
+  pow2
  '  Two to the i, by repeated doubling.
  '  ?=  ((pow2 6) 64)
  \  i=nat
  ^  nat
  |  > k=nat i  > acc=nat 1
  ?  (eq k 0)
     acc
  (_ k.dec acc.mul(2))
+  bit_at
  '  Bit i of a bitboard: cell x,y rides at bit x plus 8y.
  '  ?=  ((bit_at 5 2) 1)
  '  ?=  ((bit_at 5 1) 0)
  \  n=nat i=nat
  ^  nat
  (mod (div n (pow2 i)) 2)
+  put_cell
  '  Set one cell live; setting a live cell is a no-op.
  '  ?=  ((put_cell 0 1 0) 2)
  \  n=nat x=nat y=nat
  ^  nat
  =  > i (add x (mul y 8))
  ?  (bit_at n i)
     n
  (add n (pow2 i))
+  glider
  '  The classic glider in the northwest corner, gliding southeast.
  '  ?=  (glider 459778)
  ^  nat
  =  > a (put_cell 0 1 0)
  =  > b (put_cell a 2 1)
  =  > c (put_cell b 0 2)
  =  > d (put_cell c 1 2)
  (put_cell d 2 2)
+  blinker
  '  A vertical blinker: period two.
  '  ?=  (blinker 131586)
  ^  nat
  =  > a (put_cell 0 1 0)
  =  > b (put_cell a 1 1)
  (put_cell b 1 2)
+  pop_of
  '  The live-cell count: the board's binary digit sum.
  '  ?=  ((pop_of glider) 5)
  '  ?=  ((pop_of blinker) 3)
  \  n=nat
  ^  nat
  |  > v=nat n  > acc=nat 0
  ?  (eq v 0)
     acc
  (_ (div v 2) acc.add((mod v 2)))
+  offs
  '  The eight neighbor offsets, mod 8: 7 is minus one on the torus.
  ^  row[[ox=nat oy=nat]]
  [[7 7] [0 7] [1 7] [7 0] [1 0] [7 1] [0 1] [1 1]]
+  nbors
  '  Live neighbors of cell x,y, wrapping at the edges.
  '  ?=  ((nbors blinker 1 1) 2)
  '  ?=  ((nbors blinker 0 1) 3)
  \  cells=nat x=nat y=nat
  ^  nat
  =  > os offs
  |  > i=nat 0  > n=nat 0
  ?  (eq i os.len)
     n
  =  > h os.at(i)
  =  > nx (mod (add x ox) 8)
  =  > ny (mod (add y oy) 8)
  ?  (bit_at cells (add nx (mul ny 8)))
     (_ i.inc n.inc)
  (_ i.inc n)
+  step
  '  One generation of Conway's rule over the whole board: a live
  '  cell survives on 2 or 3 neighbors, a dead cell is born on 3.
  '  ?=  ((step blinker) 1792)
  '  ?=  ((step (step blinker)) 131586)
  '  ?=  ((step glider) 33948928)
  \  cells=nat
  ^  nat
  |  > i=nat 0  > out=nat 0
  ?  (eq i 64)
     out
  =  > n (nbors cells (mod i 8) (div i 8))
  =  > live
       ?  (eq n 3)
          1
       ?  (bit_at cells i)
          (eq n 2)
       0
  ?  live
     (_ i.inc out.add((pow2 i)))
  (_ i.inc out)
+  show_row
  '  One board row as eight bytes: live cells #, dead cells dot.
  \  cells=nat y=nat
  ^  nat
  |  > x=nat 7  > acc=nat 0
  =  > c
       ?  (bit_at cells (add x (mul y 8)))
          35
       46
  =  > a2 (add c (mul acc 256))
  ?  (eq x 0)
     a2
  (_ x.dec a2)
+  show_cells
  '  The whole board as eight newline-joined rows — the explorer
  '  renders text slots preformatted, so this IS the display.
  \  cells=nat
  ^  nat
  =  > rows
       |  > y=nat 0  > acc=row[nat] []
       ?  (eq y 8)
          acc
       (_ y.inc acc.snoc((show_row cells y)))
  (weft/join 10 rows)
+  board_put
  '  Recompute the board's derived slots from the cells: generation,
  '  population, and the pre-rendered view.
  \  t=myth cells=nat gen=nat
  ^  myth
  =  > t1 t.put(['cells] (pd cells))
  =  > t2 t1.put(['gen] (pd gen))
  =  > t3 t2.put(['pop] (pd (pop_of cells)))
  t3.put(['view] (pails/t (show_cells cells)))
+  census_t
  '  The census record: an x-care crew watch on the board plus the
  '  census kook — each committed generation's fact drives a tally.
  \  board=path root=path
  ^  myth
  =  > kp root.weld(['kook 'census])
  =  > t (kooked [kp])
  t.put(crew_slot (cpail (crew/sing ['board] (dep .x board))))
+  census_hear
  '  Tally the committed board from the hydrated crew view: its
  '  population, its generation, and the peak population ever seen.
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  > cw b.crew
  =  > fat cw.gut(['board] (axal/new[myth] .none))
  ?  fat.fil
   > .none  (yell [] cur)
   > (./some t=myth)
     =  > p t.nat_at(['pop] 0)
     =  > g t.nat_at(['gen] 0)
     =  > peak cur.nat_at(['peak] 0)
     =  > c1 cur.put(['pop] (pd p))
     =  > c2 c1.put(['gen] (pd g))
     =  > c3
          ?  (gt p peak)
             c2.put(['peak] (pd p))
          c2
     (yell [] c3)
+  census_form
  '  The census behavior: hear tallies.
  ^  form
  def_form.set_hear(census_hear)
+  life_init
  '  Render the seeded board and make the census kid watching this
  '  node — paths built from the bowl, so any mount root works.
  \  b=bowl t=myth
  ^  yell
  =  > here b.here
  =  > root here.take(here.len.dec)
  =  > t2 (board_put t t.nat_at(['cells] 0) t.nat_at(['gen] 0))
  =  > cen here.snoc('census)
  =  > ct (census_t here root)
  =  > cd [cen (writ/make ct)]
  (yell [cd] t2)
+  life_talk
  '  Default merge, then a ['tick] payload advances that many
  '  generations (still one moment — poke once per generation to
  '  give the title a moment per step).  Every poke recomputes the
  '  derived slots, so poking fresh ['cells] loads a pattern.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  > d (def_talk b cur nu)
  =  > t d.out
  =  > n nu.nat_at(['tick] 0)
  =  > c0 t.nat_at(['cells] 0)
  =  > g0 t.nat_at(['gen] 0)
  =  > c2
       |  > k=nat n  > acc=nat c0
       ?  (eq k 0)
          acc
       (_ k.dec (step acc))
  (yell [] (board_put t c2 g0.add(n)))
+  life_form
  '  The board behavior: init renders and spawns the census, talk
  '  ticks and re-renders.
  ^  form
  def_form.set_init(life_init).set_talk(life_talk)
+  tick_t
  '  A tick command: poke this at the board to advance n generations.
  \  n=nat
  ^  myth
  =  t  myth/new
  t.add((limb/nat ['tick] n))
+  board_seed
  '  The seeded board: a glider at generation zero, carrying the
  '  life kook (app-relative — the mount absolutizes it).
  ^  myth
  =  > t (kooked [['kook 'life]])
  =  > t2 t.put(['cells] (pd glider))
  t2.put(['gen] (pd 0))
+  app
  '  The life app: Conway's board plus its census.
  ^  mani
  (mani 'life
        (lore "Conway's Game of Life on an 8x8 torus."
              ["Conway's Game of Life on an 8x8 torus."
               "Poke ['tick] at the board to advance a generation; each generation is one moment of the board's title, so the /h overlay scrubs the whole history."
               "Poke fresh ['cells] to load a pattern.  The census kid watches the board through its crew and tallies pop, gen, and peak."]
              [])
        [(kook/decl 'life life_form (lore/line "The board: init renders and spawns the census, talk ticks and re-renders."))
         (kook/decl 'census census_form (lore/line "The census: an x-care watch on the board tallies pop, gen, and peak."))]
        [[['board] board_seed]])
