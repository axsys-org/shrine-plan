-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  surface_tree [order=45]
-  foundry [order=47]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  life: Conway's Game of Life on an 8x8 torus, as a shrine app.
'  The board is one nat bitboard riding in a slot; a tick is one
'  poke, so a generation is one moment of the board's title and the
'  /h overlay is a generation scrubber for free.  The census kid
'  tallies the board through an ordinary x-care crew watch.
+  pow2
  '  Two to the i, by repeated doubling.
  '  ?=  ((pow2 6) 64)
  \  i=nat
  ^  nat
  |  > k=nat i  > acc=nat 1
  ?  (eq k 0)
     acc
  (_ k.dec acc.mul(2))
+  bit_at
  '  Bit i of a bitboard: cell x,y rides at bit x plus 8y.
  '  ?=  ((bit_at 5 2) 1)
  '  ?=  ((bit_at 5 1) 0)
  \  n=nat i=nat
  ^  nat
  (mod (div n (pow2 i)) 2)
+  put_cell
  '  Set one cell live; setting a live cell is a no-op.
  '  ?=  ((put_cell 0 1 0) 2)
  \  n=nat x=nat y=nat
  ^  nat
  =  > i (add x (mul y 8))
  ?  (bit_at n i)
     n
  (add n (pow2 i))
+  glider
  '  The classic glider in the northwest corner, gliding southeast.
  '  ?=  (glider 459778)
  ^  nat
  =  > a (put_cell 0 1 0)
  =  > b (put_cell a 2 1)
  =  > c (put_cell b 0 2)
  =  > d (put_cell c 1 2)
  (put_cell d 2 2)
+  blinker
  '  A vertical blinker: period two.
  '  ?=  (blinker 131586)
  ^  nat
  =  > a (put_cell 0 1 0)
  =  > b (put_cell a 1 1)
  (put_cell b 1 2)
+  pop_of
  '  The live-cell count: the board's binary digit sum.
  '  ?=  ((pop_of glider) 5)
  '  ?=  ((pop_of blinker) 3)
  \  n=nat
  ^  nat
  |  > v=nat n  > acc=nat 0
  ?  (eq v 0)
     acc
  (_ (div v 2) acc.add((mod v 2)))
+  offs
  '  The eight neighbor offsets, mod 8: 7 is minus one on the torus.
  ^  row[[ox=nat oy=nat]]
  [[7 7] [0 7] [1 7] [7 0] [1 0] [7 1] [0 1] [1 1]]
+  nbors
  '  Live neighbors of cell x,y, wrapping at the edges.
  '  ?=  ((nbors blinker 1 1) 2)
  '  ?=  ((nbors blinker 0 1) 3)
  \  cells=nat x=nat y=nat
  ^  nat
  =  > os offs
  |  > i=nat 0  > n=nat 0
  ?  (eq i os.len)
     n
  =  > h os.at(i)
  =  > nx (mod (add x ox) 8)
  =  > ny (mod (add y oy) 8)
  ?  (bit_at cells (add nx (mul ny 8)))
     (_ i.inc n.inc)
  (_ i.inc n)
+  step
  '  One generation of Conway's rule over the whole board: a live
  '  cell survives on 2 or 3 neighbors, a dead cell is born on 3.
  '  ?=  ((step blinker) 1792)
  '  ?=  ((step (step blinker)) 131586)
  '  ?=  ((step glider) 33948928)
  \  cells=nat
  ^  nat
  |  > i=nat 0  > out=nat 0
  ?  (eq i 64)
     out
  =  > n (nbors cells (mod i 8) (div i 8))
  =  > live
       ?  (eq n 3)
          1
       ?  (bit_at cells i)
          (eq n 2)
       0
  ?  live
     (_ i.inc out.add((pow2 i)))
  (_ i.inc out)
+  show_row
  '  One board row as eight bytes: live cells #, dead cells dot.
  \  cells=nat y=nat
  ^  nat
  |  > x=nat 7  > acc=nat 0
  =  > c
       ?  (bit_at cells (add x (mul y 8)))
          35
       46
  =  > a2 (add c (mul acc 256))
  ?  (eq x 0)
     a2
  (_ x.dec a2)
+  show_cells
  '  The whole board as eight newline-joined rows — the explorer
  '  renders text slots preformatted, so this IS the display.
  \  cells=nat
  ^  nat
  =  > rows
       |  > y=nat 0  > acc=row[nat] []
       ?  (eq y 8)
          acc
       (_ y.inc acc.snoc((show_row cells y)))
  (weft/join 10 rows)
+  board_put
  '  Recompute the board's derived slots from the cells: generation,
  '  population, and the pre-rendered view.
  \  t=myth cells=nat gen=nat
  ^  myth
  =  > t1 t.put(['cells] (pd cells))
  =  > t2 t1.put(['gen] (pd gen))
  =  > t3 t2.put(['pop] (pd (pop_of cells)))
  t3.put(['view] (pails/t (show_cells cells)))
+  census_t
  '  The census record: an x-care crew watch on the board plus the
  '  census kook — each committed generation's fact drives a tally.
  \  board=path root=path
  ^  myth
  =  > kp root.weld(['kook 'census])
  =  > t (kooked [kp])
  t.put(crew_slot (cpail (crew/sing ['board] (dep .x board))))
+  census_hear
  '  Tally the committed board from the hydrated crew view: its
  '  population, its generation, and the peak population ever seen.
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  > cw b.crew
  =  > fat cw.gut(['board] (axal/new[myth] .none))
  ?  fat.fil
   > .none  (yell [] cur)
   > (./some t=myth)
     =  > p t.nat_at(['pop] 0)
     =  > g t.nat_at(['gen] 0)
     =  > peak cur.nat_at(['peak] 0)
     =  > c1 cur.put(['pop] (pd p))
     =  > c2 c1.put(['gen] (pd g))
     =  > c3
          ?  (gt p peak)
             c2.put(['peak] (pd p))
          c2
     (yell [] c3)
+  census_form
  '  The census behavior: hear tallies.
  ^  form
  def_form.set_hear(census_hear)
+  life_init
  '  Render the seeded board and make the census kid watching this
  '  node — paths built from the bowl, so any mount root works.
  \  b=bowl t=myth
  ^  yell
  =  > here b.here
  =  > root here.take(here.len.dec)
  =  > t2 (board_put t t.nat_at(['cells] 0) t.nat_at(['gen] 0))
  =  > cen here.snoc('census)
  =  > ct (census_t here root)
  =  > cd [cen (writ/make ct)]
  (yell [cd] t2)
+  life_talk
  '  Default merge, then a ['tick] payload advances that many
  '  generations (still one moment — poke once per generation to
  '  give the title a moment per step).  Every poke recomputes the
  '  derived slots, so poking fresh ['cells] loads a pattern.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  > d (def_talk b cur nu)
  =  > t d.out
  =  > n nu.nat_at(['tick] 0)
  =  > c0 t.nat_at(['cells] 0)
  =  > g0 t.nat_at(['gen] 0)
  =  > c2
       |  > k=nat n  > acc=nat c0
       ?  (eq k 0)
          acc
       (_ k.dec (step acc))
  (yell [] (board_put t c2 g0.add(n)))
+  life_form
  '  The board behavior: init renders and spawns the census, talk
  '  ticks and re-renders.
  ^  form
  def_form.set_init(life_init).set_talk(life_talk)
+  tick_t
  '  A tick command: poke this at the board to advance n generations.
  \  n=nat
  ^  myth
  =  t  myth/new
  t.add((twig/nat ['tick] n))
+  board_seed
  '  The seeded board: a glider at generation zero, carrying the
  '  life kook (app-relative — the mount absolutizes it).
  ^  myth
  =  > t (kooked [(pact/rel ['kook 'life])])
  =  > t2 t.put(['cells] (pd glider))
  t2.put(['gen] (pd 0))
+  board_html
  '  The board component's projection: generation and population up
  '  top, the pre-rendered ['view] text as the board — a pure
  '  function of the board record, its markup riding ['html].
  \  t=myth
  ^  myth
  =  stats
       (weft/cat
         ["gen " (weft/show_nat t.nat_at(['gen] 0))
          " · pop " (weft/show_nat t.nat_at(['pop] 0))])
  (frag/html "div" []
    [(weft/el "div" [(weft/cls "muted")] [(weft/tx stats)])
     (weft/leaf "pre" [] t.txt_at(['view]))])
+  board_view
  '  The board component: a dyed over the board record (slots only —
  '  x input).
  ^  pail
  (dyed board_html .none)
+  life_root_path
  '  The existing mounted Life occurrence.  These absolute helpers
  '  intentionally describe the current /app/life installation; the
  '  durable manifest itself remains rerootable.
  ^  path
  '/app/life
+  life_board_path
  ^  path
  life_root_path.snoc('board)
+  life_plate_recipe_path
  ^  path
  life_root_path.weld(['weft 'foundry 'plate])
+  life_web_recipe_path
  ^  path
  life_root_path.weld(['weft 'foundry 'web])
+  life_text_recipe_path
  ^  path
  life_root_path.weld(['weft 'foundry 'text])
+  life_plate_role
  ^  path
  '/life/plate
+  life_pronunciation_role
  ^  path
  '/life/plate/pronunciation
+  life_cells_role
  ^  path
  '/life/cells
+  life_population_role
  ^  path
  '/life/population
+  life_generation_role
  ^  path
  '/life/generation
+  life_tick_role
  ^  path
  '/life/action/tick
+  life_plate_request
  '  An ephemeral request for the current Life Plate.  Backend and
  '  pronunciation negotiate terminal realization but never enter the
  '  semantic SurfaceTree.
  \  backend=iota pronunciation=path
  ^  foundry/request
  (foundry/request life_board_path life_plate_role 'full 'plate
    backend pronunciation [])
+  life_plate_report_path
  '  The neutral record-to-SurfaceTree report.
  ^  path
  (foundry/chain [life_plate_recipe_path] life_board_path)
+  life_web_report_path
  '  Neutral Life Plate followed by its Weft pronunciation.
  ^  path
  (foundry/chain [life_plate_recipe_path life_web_recipe_path]
    life_board_path)
+  life_text_report_path
  '  Neutral Life Plate followed by its terminal-text pronunciation.
  ^  path
  (foundry/chain [life_plate_recipe_path life_text_recipe_path]
    life_board_path)
+  life_semantic_value
  '  One field Block: its role identifies meaning, its source points
  '  back to the durable board occurrence, and the value stays a nat.
  \  role=path n=nat
  ^  myth
  =  t  (surface_tree/with_source life_board_path
           (surface_tree/block role))
  t.put(['life 'value] (pd n))
+  life_semantic_action
  '  The admitted tick affordance.  The action target is the existing
  '  board occurrence; ['life 'command] identifies the poke slot, but
  '  the Foundry grants no authority to invoke it.
  ^  myth
  =  t  (surface_tree/with_action life_board_path
           (surface_tree/with_source life_board_path
             (surface_tree/block life_tick_role)))
  t.put(['life 'command] (pails/p ['tick]))
+  life_plate_tree
  '  Lift one board occurrence into a renderer-neutral Life Plate.
  '  Structural placement is ephemeral; every semantic reference
  '  points back to the existing source and vocabulary.  No HTML, CSS,
  '  backend handle, or renderer choice enters this tree.
  \  t=myth
  ^  surface_tree
  =  cells  t.nat_at(['cells] 0)
     gen    t.nat_at(['gen] 0)
     pop    t.nat_at(['pop] (pop_of cells))
     root0  (surface_tree/with_action life_board_path
              (surface_tree/with_source life_board_path
                (surface_tree/plate life_plate_role)))
     root1  root0.put(['life 'ref 'cells] (pails/p life_cells_role))
     root2  root1.put(['life 'ref 'population] (pails/p life_population_role))
     root3  root2.put(['life 'ref 'generation] (pails/p life_generation_role))
     root4  root3.put(['life 'ref 'action] (pails/p life_tick_role))
     tree0  (surface_tree/one root4)
     tree1  (surface_tree/put ['cells]
              (life_semantic_value life_cells_role cells) tree0)
     tree2  (surface_tree/put ['population]
              (life_semantic_value life_population_role pop) tree1)
     tree3  (surface_tree/put ['generation]
              (life_semantic_value life_generation_role gen) tree2)
  (surface_tree/put ['action] life_semantic_action tree3)
+  life_plate_view
  '  The neutral Zoo recipe: one record becomes one Life Plate tree.
  ^  pail
  (knit life_plate_tree .none)
+  life_tree_record
  '  A semantic node or an empty record when absent.  Terminal
  '  adapters use this helper rather than inspecting axal internals.
  \  at=path tree=surface_tree
  ^  myth
  ?  (surface_tree/record_at at tree)
   > (./some t=myth)  t
   > .none            myth/new
+  life_tree_value
  \  at=path tree=surface_tree
  ^  nat
  (life_tree_record at tree).nat_at(['life 'value] 0)
+  life_tree_stats
  \  tree=surface_tree
  ^  nat
  (weft/cat
    ["gen " (weft/show_nat (life_tree_value ['generation] tree))
     " · pop " (weft/show_nat (life_tree_value ['population] tree))])
+  life_plate_web
  '  The Weft pronunciation.  It reconstructs the existing board
  '  component from semantic values, preserving the current markup and
  '  behavior while keeping that markup terminal.
  \  tree=surface_tree
  ^  myth
  =  stats  (life_tree_stats tree)
     cells  (life_tree_value ['cells] tree)
  (frag/html "div" []
    [(weft/el "div" [(weft/cls "muted")] [(weft/tx stats)])
     (weft/leaf "pre" [] (show_cells cells))])
+  life_web_view
  '  SurfaceTree to Weft/HTML terminal adapter.
  ^  pail
  (felt life_plate_web .none)
+  life_plate_text
  '  The plain terminal pronunciation: the same stats and grid with a
  '  newline boundary, carried only at ['text].
  \  tree=surface_tree
  ^  myth
  =  body  (weft/cat
              [(life_tree_stats tree) 10
               (show_cells (life_tree_value ['cells] tree))])
  (myth/new).put(['text] (pails/t body))
+  life_text_view
  '  SurfaceTree to terminal-text adapter.
  ^  pail
  (felt life_plate_text .none)
+  life_plate_card
  '  Zoo registration for the neutral Plate recipe.
  ^  myth
  (weft_recipe life_plate_view (pact/rel ['board])
    (lore "Life Plate: board record to renderer-neutral SurfaceTree."
      ["Life Plate: board record to renderer-neutral SurfaceTree."
       "The tree retains the durable board source, semantic cells, population, generation, and tick-action references."
       "No renderer payload or backend choice is admitted into the tree."] [])
    (weft_spec life_plate_role "record" "surface-tree" "full" "plate"
      "neutral" "semantic" "x" [] []))
+  life_web_card
  '  Zoo registration for the web pronunciation.
  ^  myth
  (weft_recipe life_web_view life_plate_report_path
    (lore "Life Plate web pronunciation through Weft."
      ["Life Plate web pronunciation through Weft."
       "Consumes the neutral Life Plate and emits the existing live board fragment markup."] [])
    (weft_spec life_pronunciation_role "surface-tree" "record" "full" "plate"
      "web" "shrine" "z" [] []))
+  life_text_card
  '  Zoo registration for the plain terminal pronunciation.
  ^  myth
  (weft_recipe life_text_view life_plate_report_path
    (lore "Life Plate plain-text pronunciation."
      ["Life Plate plain-text pronunciation."
       "Consumes the same neutral Life Plate and emits stats plus the 8x8 grid as text."] [])
    (weft_spec life_pronunciation_role "surface-tree" "record" "full" "plate"
      "text" "plain" "z" [] []))
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  face_page
  '  The container: the board fragment kept fresh by the /w.js
  '  runtime — committed ticks appear without a page reload.
  \  root=path
  ^  nat
  =  body
       [(weft/leaf "h1" [] "life")
        (frag/mount "board" root.weld(['weft 'board]) root.weld(['board]) .x)
        frag/script]
  (weft/page "life" explorer/css body)
+  face_talk
  '  The app's HTTP face: the container page for the request target's
  '  mount root.  Same responder contract as the explorer — write the
  '  res_* slots onto the request record.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
     tgt=path
       ?  out.get(['vpath])
        > (./some held=pail)
          ?  held
           > p=pails/p  p.p
          []
        > .none  []
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd (face_page (root_of tgt))))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  app
  '  The life app: Conway's board plus its census.
  ^  mani
  (mani 'life
        (lore "Conway's Game of Life on an 8x8 torus."
              ["Conway's Game of Life on an 8x8 torus."
               "Poke ['tick] at the board to advance a generation; each generation is one moment of the board's title, so the /h overlay scrubs the whole history."
               "Poke fresh ['cells] to load a pattern.  The census kid watches the board through its crew and tallies pop, gen, and peak."]
              [])
        [(kook/decl 'life life_form (lore/line "The board: init renders and spawns the census, talk ticks and re-renders."))
         (kook/decl 'census census_form (lore/line "The census: an x-care watch on the board tallies pop, gen, and peak."))
         (kook/decl 'face face_form (lore/line "The HTML face: the container page — the board fragment kept fresh in place."))]
        [[['board] board_seed]
         [['weft 'board]
          (weft_card board_view (pact/rel ['board])
            (lore "The board component: stats and the rendered board, a dyed over the board record."
                  ["The board component: stats and the rendered board, a dyed over the board record."
                   "Input: the x record of a board node - ['gen] and ['pop] as nats, plus the pre-rendered ['view] text."
                   "Output: a stats line and the board as preformatted text."
                   "Works against any moment of the board - a demo may point at an /h case to freeze one generation."]
                  []))]
         [['weft 'foundry 'plate] life_plate_card]
         [['weft 'foundry 'web] life_web_card]
         [['weft 'foundry 'text] life_text_card]])
