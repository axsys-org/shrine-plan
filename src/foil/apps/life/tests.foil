-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=30]
-  shrine [order=40]
-  lain_types [order=50]
-  weft [order=80]
-  pact [order=100]
-  http [order=110]
-  web [order=120]
-  helm [order=130]
-  testing [order=170]
-  test_life_app [order=190]
-  app_test_world [order=200]

+  check
  \ n=nat yes=bool
  ^ testing/check
  | testing/nat (nat/show n) 1 yes

+  behavior
  \ _=unit
  ^ row[testing/check]
  = base app_world/seed
  = nl 10
  = g0_view (cord/cat_all [ ".#......" nl "..#....." nl "###....." nl
      "........" nl "........" nl "........" nl "........" nl "........"
      ])
  = tapp=iota 'app
  = tlife=iota 'life
  = board=path [tapp tlife 'board]
  = census=path [tapp tlife 'board 'census]
  = gslot=path ['gen]
  = pslot=path ['pop]
  = cslot=path ['cells]
  = vslot=path ['view]
  = xslot=path ['peak]
  = fslot=path ['form]
  = m1 (app_world/mount app "apps/life/main" ['app 'life] base)
  = s1 m1
  = bm1 (app_world/get board s1)
  = kf (app_world/get [tapp tlife 'kook 'life] s1)
  = g1 (app_world/poke board (tick_t 1) s1)
  = s2 g1
  = g2 (app_world/poke board (tick_t 1) s2)
  = g3 (app_world/poke board (tick_t 1) g2)
  = g4 (app_world/poke board (tick_t 1) g3)
  = s5 g4
  = p1 (app_world/poke board (myth/sing cslot (pd blinker)) s5)
  = s6 p1
  = p2 (app_world/poke board (tick_t 1) s6)
  = s7 p2
  [
    (check 1 (equal (pow2 6) 64))
    (check 2 (equal glider 459778))
    (check 3 (equal blinker 131586))
    (check 4 (equal (pop_of glider) 5))
    (check 5 (equal (pop_of blinker) 3))
    (check 6 (equal (step blinker) 1792))
    (check 7 (equal (step (step blinker)) blinker))
    (check 8 (equal (step glider) 33948928))
    (check 9 (equal (step (step (step (step glider)))) 235406336))
    (check 10 (equal (show_cells glider) g0_view))
    (check 11 m1.valid)
    (check 12 (equal (app_world/number board gslot 99 s1) 0))
    (check 13 (equal (app_world/number board cslot 99 s1) 459778))
    (check 14 (equal (app_world/number board pslot 99 s1) 5))
    (check 15 (app_world/exists board s1))
    (check 16 (equal (str/to_atom (myth/txt_at vslot bm1)) g0_view))
    (check 17 (app_world/exists [tapp tlife 'kook 'life] s1))
    (check 18 (equal (myth/has_at fslot kf) 1))
    (check 19 (app_world/exists census s1))
    (check 20 g1.valid)
    (check 21 (equal (app_world/number board gslot 99 s2) 1))
    (check 22 (equal (app_world/number board cslot 99 s2) 33948928))
    (check 23 (equal (app_world/number board pslot 99 s2) 5))
    (check 24 (equal (app_world/number census pslot 99 s2) 5))
    (check 25 (equal (app_world/number census gslot 99 s2) 1))
    (check 26 (equal (app_world/number census xslot 99 s2) 5))
    (check 27 (equal (app_world/number board gslot 99 s5) 4))
    (check 28 (equal (app_world/number board cslot 99 s5) 235406336))
    (check 29 (equal (app_world/number census pslot 99 s5) 5))
    (check 30 (equal (app_world/number census gslot 99 s5) 4))
    (check 31 p1.valid)
    (check 32 (equal (app_world/number board cslot 99 s6) 131586))
    (check 33 (equal (app_world/number board pslot 99 s6) 3))
    (check 34 (equal (app_world/number board gslot 99 s6) 4))
    (check 35 (equal (app_world/number census xslot 99 s6) 5))
    (check 36 (equal (app_world/number board cslot 99 s7) 1792))
    (check 37 (equal (app_world/number board gslot 99 s7) 5))
    (check 38 (equal (app_world/number census pslot 99 s7) 3))
  ]

+  tests
  ^ row[testing/case]
  [(testing/case "life behavior" behavior)]
