-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  json [order=50]
-  agent_crud [order=60]
-  weft [order=70]
'  The experimental agent's web face. Native Foil renders this page;
'  the Python sidecar serves its assets and runs the OpenRouter loop.
'  It is deliberately separate from the existing live helm mount.
+  agent_id
  \  id=nat
  ^  row[weft/att]
  [(weft/att "id" id)]
+  agent_page
  ^  nat
  (weft/page "Shrine / observation"
    "@import url('/assets/style.css');"
    [(weft/el "meta" [(weft/att "name" "viewport") (weft/att "content" "width=device-width, initial-scale=1")] [])
     (weft/el "header" [(weft/cls "topbar")]
       [(weft/el "div" [(weft/cls "brand")]
         [(weft/leaf "span" [(weft/cls "mark")] "S")
          (weft/leaf "strong" [] "shrine")
          (weft/leaf "span" [(weft/cls "slash")] "/")
          (weft/leaf "span" [] "observation")])
        (weft/el "div" [(weft/cls "runtime")]
          [(weft/leaf "span" [(weft/cls "dot")] "")
           (weft/leaf "span" (agent_id "connection") "Connecting to Shrine")])])
     (weft/el "main" []
       [(weft/el "section" [(weft/cls "intro")]
         [(weft/el "div" []
           [(weft/leaf "div" [(weft/cls "eyebrow")] "NAMESPACE LAB / 001")
            (weft/leaf "h1" [] "See what follows.")
            (weft/leaf "p" [] "A model acts. Shrine executes. The consequences become its next observation.")])
          (weft/el "div" [(weft/cls "intro-actions")]
           [(weft/leaf "button" [(weft/att "id" "new-goal")] "+ New goal")
            (weft/leaf "button" [(weft/att "id" "new-chat") (weft/cls "secondary")] "New chat")])])
        (weft/el "div" [(weft/cls "chat-bar")]
          [(weft/leaf "label" [(weft/att "for" "chat-select")] "Chats")
           (weft/el "select" [(weft/att "id" "chat-select") (weft/att "aria-label" "Saved chats")] [])
           (weft/leaf "span" [] "Each chat keeps its own namespace and goals.")])
        (weft/el "section" [(weft/cls "metrics") (weft/att "id" "metrics")] [])
        (weft/el "div" [(weft/cls "workspace")]
         [(weft/el "section" [(weft/cls "panel stream-panel")]
           [(weft/el "div" [(weft/cls "panel-head")]
             [(weft/leaf "h2" [] "Observation stream")
              (weft/leaf "span" (agent_id "event-count") "0 events")])
            (weft/el "div" [(weft/att "id" "stream") (weft/att "aria-live" "polite")]
             [(weft/el "div" [(weft/cls "empty")]
               [(weft/leaf "div" [(weft/cls "empty-symbol")] "+")
                (weft/leaf "h3" [] "A new conversation. A place to start.")
                (weft/leaf "p" [] "Give the model something to do. Each operation and its actual result will appear here.")])])
            (weft/el "form" (agent_id "composer")
             [(weft/el "textarea" [(weft/att "id" "prompt") (weft/att "rows" "3") (weft/att "aria-label" "Message to the agent") (weft/att "placeholder" "Add Ian and Josh under /users, then put their count in /summary/users...")] [])
              (weft/el "div" [(weft/cls "compose-bottom")]
               [(weft/leaf "span" (agent_id "model-label") "OpenRouter / real Shrine")
                (weft/leaf "button" [(weft/att "type" "submit") (weft/att "id" "send")] "Send request →")])])])
          (weft/el "aside" [(weft/cls "panel namespace-panel")]
           [(weft/el "div" [(weft/cls "panel-head")]
             [(weft/leaf "h2" [] "Namespace") (weft/leaf "span" [] "COMMITTED STATE")])
            (weft/el "div" (agent_id "namespace") [])
            (weft/el "div" [(weft/cls "ns-footer")]
             [(weft/leaf "span" [] "History is kept by Shrine.")
              (weft/leaf "span" [] "The full conversation stays in context.")])
            (weft/el "details" [(weft/cls "injector")]
             [(weft/leaf "summary" [] "Change the world yourself")
              (weft/leaf "p" [] "Apply a real operation. Matching dependency notes wake the model automatically.")
              (weft/el "textarea" [(weft/att "id" "injection") (weft/att "rows" "5") (weft/att "aria-label" "External namespace operation")] [])
              (weft/leaf "button" [(weft/att "id" "inject") (weft/cls "secondary")] "Apply change")])])])
        (weft/el "footer" []
         [(weft/leaf "span" [] "READ · MAKE · POKE · CULL")
          (weft/leaf "span" (agent_id "status") "Ready")
          (weft/el "a" [(weft/href "/api/export") (weft/att "download" "session.json")] [(weft/tx "Export transcript ↗")])])])
     (weft/el "dialog" [(weft/att "id" "goal-dialog") (weft/att "aria-labelledby" "goal-heading")]
       [(weft/el "form" (agent_id "goal-form")
         [(weft/leaf "h2" (agent_id "goal-heading") "New goal")
          (weft/leaf "p" [] "Describe what you want to achieve or keep true. Your goal is saved immediately; the agent defines its conditions and confirms them in chat.")
          (weft/leaf "label" [(weft/att "for" "goal-description")] "Goal description")
          (weft/el "textarea" [(weft/att "id" "goal-description") (weft/att "rows" "5") (weft/att "required" "required") (weft/att "placeholder" "Keep the release ready when tests pass and approval is granted...")] [])
          (weft/leaf "p" [(weft/att "id" "goal-error") (weft/att "role" "alert")] "")
          (weft/el "div" [(weft/cls "goal-actions")]
            [(weft/leaf "button" [(weft/att "id" "goal-cancel") (weft/att "type" "button") (weft/cls "quiet")] "Cancel")
             (weft/leaf "button" [(weft/att "id" "goal-submit") (weft/att "type" "submit")] "Create goal")])])])
     (weft/el "script" [(weft/att "src" "/assets/app.js") (weft/att "defer" "defer")] [])])
