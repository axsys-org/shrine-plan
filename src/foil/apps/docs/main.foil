-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
-  semidoc [order=90]
'  docs: semidoc documents served as their own pages — and edited as
'  them too.  The sample document below compiles at manifest build
'  and mounts as ordinary namespace records (semidoc/myths); the
'  face renders the committed subtree on every request — parse
'  nothing at serve time, the namespace IS the document.  The doc
'  node carries its own source and a compile kook: posting fresh
'  source (the face's textarea, through /post) re-parses in-kernel
'  and expands the DELTA against the in-flight subtree — present
'  nodes poke, new ones make, stale ones cull, one transaction —
'  the same expansion pattern pact uses for app upgrades.  Every
'  edit is one epoch, so /h scrubs the whole history: a wiki with
'  time travel.  (Pokes meld, so an edit that only REMOVES an
'  attribute leaves its slot behind — the node itself would need a
'  cull+make to shed it.)  Mounted at the top-level /docs root.
+  sample_src
  '  The seeded document, as semidoc source.
  ^  nat
  (joined 10
    [";@ /doc/alias d /doc"
     ";. /docs/about"
     ""
     "  ;= Documents as namespace citizens"
     ""
     "    ;@ d/status draft"
     ""
     "    This page is rendered from the namespace: every paragraph,"
     "    section, and literal below is a record under this app's"
     "    root, and the face renders whatever is committed there."
     ""
     "    ;- Poke a node's text slot and reload: the page follows."
     ""
     "    ;- The tree came from semidoc source at mount time."
     ""
     "    ;$ text"
     ""
     "      ;= runes stay opaque inside literals"
     ""
     "    ;@ d/interpret-as /formats/test"
     "    ;@ d/eval-with sept"
     ""
     "    ;$ foil"
     ""
     "      (eq 4 (add 2 2))"
     ""
     "    ;/docs/about"])
+  doc_tree
  '  The compiled sample.
  ^  row[snode]
  (parse sample_src)
+  doc_seeds
  '  The document as manifest seeds: app-relative paths, re-rooted
  '  by the mount like any seed.  The doc node itself also carries
  '  its source and the compile kook (app-relative — the mount
  '  absolutizes it), so it can rebuild itself from a poke.
  ^  row[[p=path t=myth]]
  =  ms  (myths [] doc_tree)
  |  > i=nat 0  > out=row[[p=path t=myth]] []
  ^  row[[p=path t=myth]]
  ?  (ge i ms.len)
     out
  =  m  ms.at(i)
  =  t2
       ?  (eq 0 i)
          m.t.put(['src] (pails/t sample_src)).put(limb_slot (kook [['kook 'compile]]))
       m.t
  (_ i.inc out.snoc([m.p t2]))
+  mount_paths
  '  The relative paths of a mount row, parents first.
  \  ms=row[smount]
  ^  row[path]
  |  > i=nat 0  > out=row[path] []
  ^  row[path]
  ?  (ge i ms.len)
     out
  =  m  ms.at(i)
  (_ i.inc out.snoc(m.p))
+  src_paths
  '  The node set a source expands to — the document's own record of
  '  what it wrote.  (bowl.kids is the care-y FRONTIER, one record
  '  deep, so the previous source is the diff's ground truth, not
  '  the in-flight view.)
  \  s=nat
  ^  row[path]
  ?  (eq 0 s)
     []
  =  [t0=myth kids0=row[snode]]  (own_myth (parse s))
  (mount_paths (myths_kids [] kids0))
+  has_path
  '  Membership in a path row.
  \  p=path ps=row[path]
  ^  bool
  |  > i=nat 0
  ^  bool
  ?  (ge i ps.len)
     .false
  ?  (eq_pith ps.at(i) p)
     .true
  (_ i.inc)
+  own_myth
  '  The doc node's own new record for a parsed source: a single
  '  container node becomes the record itself; anything else gets a
  '  bare doc record with the whole tree as kids.  -> [t kids]
  \  tree=row[snode]
  ^  [t=myth kids=row[snode]]
  ?  (eq 1 tree.len)
     =  nd  tree.at(0)
     ?  nd
      > (./doc id=row[nat] as=row[sattr] kids=row[snode])
        [(node_myth nd) kids]
      > (./sect title=nat as=row[sattr] kids=row[snode])
        [(node_myth nd) kids]
      > (./item lead=nat as=row[sattr] kids=row[snode])
        [(node_myth nd) kids]
      > (./quote lead=nat as=row[sattr] kids=row[snode])
        [(node_myth nd) kids]
      > (./lit lang=nat as=row[sattr] body=nat)
        [(myth/new).put(['kind] (pails/t "doc")) tree]
      > (./ref p=row[nat] as=row[sattr])
        [(myth/new).put(['kind] (pails/t "doc")) tree]
      > (./prose text=nat as=row[sattr])
        [(myth/new).put(['kind] (pails/t "doc")) tree]
  [(myth/new).put(['kind] (pails/t "doc")) tree]
+  compile_talk
  '  The edit transaction: fresh source (a /post field or a direct
  '  ['src] poke) re-parses and re-expands this node's subtree
  '  against the in-flight view — present nodes poke, new ones make,
  '  stale ones cull deepest-first — and the node's own record
  '  becomes the new document root, source riding along.  One poke,
  '  one epoch; /h keeps every prior edit addressable.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  posted  (myth/txt_at ['post 'src] nu)
  =  src
       ?  (eq 0 posted)
          (myth/txt_at ['src] nu)
       posted
  ?  (eq 0 src)
     (def_talk b cur nu)
  =  tree  (parse src)
  ?  (eq 0 tree.len)
     (yell [] cur.put(['err] (pails/t "empty document")))
  =  [ownt=myth ownkids=row[snode]]  (own_myth tree)
  =  ms  (myths_kids [] ownkids)
  =  newpaths  (mount_paths ms)
  =  oldpaths  (src_paths (myth/txt_at ['src] cur))
  =  upserts
       |  > i=nat 0  > out=row[[p=path q=writ]] []
       ^  row[[p=path q=writ]]
       ?  (ge i ms.len)
          out
       =  m  ms.at(i)
       =  act=writ
            ?  (has_path m.p oldpaths)
               (./poke m.t)
            (./make m.t)
       (_ i.inc out.snoc([b.here.weld(m.p) act]))
  =  stale
       |  > i=nat 0  > out=row[[p=path q=writ]] []  > olds=row[path] oldpaths.rev
       ^  row[[p=path q=writ]]
       ?  (ge i olds.len)
          out
       =  p  olds.at(i)
       ?  (has_path p newpaths)
          (_ i.inc out olds)
       (_ i.inc out.snoc([b.here.weld(p) (writ/cull)]) olds)
  =  own
       .  ownt
          put(['src] (pails/t src))
  =  own2
       ?  cur.get(limb_slot)
        > (./some kp=pail)  own.put(limb_slot kp)
        > .none  own
  (yell stale.weld(upserts) own2)
+  compile_form
  '  The document's behavior: talk rebuilds from source.
  ^  form
  def_form.set_talk(compile_talk)
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  src_of
  '  The document's committed source in a hydrated view: on the
  '  target itself (deep views of the doc node) or on its first
  '  numbered kid (the app root).
  \  view=axal[myth]
  ^  nat
  =  s0
       ?  view.fil
        > (./some rt=myth)  (myth/txt_at ['src] rt)
        > .none  0
  ?  (eq 0 s0)
     ?  view.get([($u 0)])
      > (./some kt=myth)  (myth/txt_at ['src] kt)
      > .none  0
  s0
+  edit_form
  '  The wiki's pen: the committed source in a textarea, posting to
  '  the doc node's compile talk through /post.
  \  docp=path tgt=path src=nat
  ^  weft/node
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path docp)))
     (weft/cls "edit")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "back")
        (weft/att "value" (show/path tgt))] [])
     (weft/el "textarea"
       [(weft/att "name" "src") (weft/att "rows" "16")] [(weft/tx src)])
     (weft/leaf "button" [] "commit")])
+  docs_css
  ^  nat
  (weft/cat2 sd_css " .edit{display:flex;flex-direction:column;gap:.5em;margin-top:2em;border-top:1px solid #dde;padding-top:1em} textarea{font-family:monospace;font-size:.9em;padding:.5em} .edit button{align-self:flex-start}")
+  face_talk
  '  The app's HTTP face: render the hydrated request target as its
  '  document page, with the source editor beneath.  Same responder
  '  contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out   cur.meld(nu)
     tgt=path
       ?  out.get(['vpath])
        > (./some held=pail)
          ?  held
           > p=pails/p  p.p
          []
        > .none  []
     view  b.crew.gut(['view] (axal/new[myth] .none))
     docp  (root_of tgt).weld([($u 0)])
     body
       (render_nodes (nodes_of view)).weld([(edit_form docp tgt (src_of view))])
     done
       .  out
          put(['res_status] (pd 200))
          put(['res_body] (pd (weft/page "docs" docs_css body)))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] done)
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
+  app
  '  The docs app: a mounted document and its face.
  ^  mani
  (mani 'docs
        (lore "Semidoc documents served as their own pages."
              ["Semidoc documents served as their own pages."
               "The document tree mounts as namespace records at mount time; the face renders the committed subtree on every request, so poking any node's slots changes the page."
               "Deep paths render the node they name; the app root renders the whole document."]
              [])
        [(kook/decl 'face face_form (lore/line "The HTML face: renders the committed document subtree, with the source editor beneath."))
         (kook/decl 'compile compile_form (lore/line "The document's behavior: posted source re-parses and expands the delta against the committed subtree in one transaction."))]
        doc_seeds)
