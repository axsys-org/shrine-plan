       %    i=nat 0    out=row[nat] []
       ^  row[nat]
       ?  (ge i es.len)
          out
       ?  es.at(i).key
        > ($u n=nat)  (_ i.inc out.weld((me d.inc es.at(i).val)))
       (_ i.inc out)
  ?  (is_void tag)
     [(cord/cat_all [ind "<" tag atts ">"])]
  ?  (eq 0 kids.len)
     [(cord/cat_all [ind "<" tag atts ">" (weft/esc txt) "</" tag ">"])]
  =  open  [(cord/cat_all [ind "<" tag atts ">"])]
  =  tline=row[nat]
       ?  txt
          [(weft/cat2 (spaces d.inc) (weft/esc txt))]
