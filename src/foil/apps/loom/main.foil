'  ==================================================================
'  IV.  The page kook: ops, the source transaction, the sync law
'  ==================================================================
+  rec_at
  '  The existing record at a path, if any.
  \  p=path existing=row[[p=path t=myth]]
  ^  maybe[myth]
  %    i=nat 0
  ^  maybe[myth]
  ?  (ge i existing.len)
     .none
  =  [ep et]  existing.at(i)
  ?  (eq_pith ep p)
     (./some et)
  (_ i.inc)
+  writ_up
  '  The upsert for one fresh mount: poke where a record already
  '  lives at the path — content slots the new record lacks swept to
  '  the empty text pail, so a withdrawn class= cannot linger and be
  '  written back into the author's source — and make where none
  '  does.  Foreign slots ride through untouched.
  \  here=path existing=row[[p=path t=myth]] mp=path mt=myth
  ^  [p=path q=writ]
  ?>  (./some old) (rec_at mp existing)
      [here.weld(mp) (writ/make mt)]
  =  swept
       content_slots.fold(mt ;
         \  acc s
         ?  !(myth/has_at s old)
            acc
         ?  (myth/has_at s acc)
            acc
         acc.put(s (pails/t "")))
  [here.weld(mp) (writ/poke swept)]
+  expand_src
  '  The source transaction: parse; a refusal commits ['err] and
  '  keeps records and old source untouched; a success re-expands
  '  the subtree against the LIVE records — fresh mounts poke with
  '  sweeps or make, numbered records the source no longer mounts
  '  cull deepest-first — and the root's text, the source as posted
  '  (the author's layout survives), and the swept error ride the
  '  node's own state.  One event, one epoch; /h keeps every prior
  '  revision addressable.
  \  b=bowl cur=myth src=nat
  ^  yell
  =  view  b.crew.gut(['self] (axal/new[myth] .none))
  ?  (parse_src src)
   > (./bad why=nat)
     (yell [] cur.put(['err] (pails/t (str/from_atom why))))
   > (./ok rtext=nat kids=row[lnode])
     =  ms  (lmounts [] kids)
     =  existing  (kid_recs [] view)
     =  fresh
          %    i=nat 0    out=row[path] []
          ^  row[path]
          ?  (ge i ms.len)
             out
          =  [mp mt]  ms.at(i)
          (_ i.inc out.snoc(mp))
     =  ups
          %    i=nat 0    out=row[[p=path q=writ]] []
          ^  row[[p=path q=writ]]
          ?  (ge i ms.len)
             out
          =  [mp mt]  ms.at(i)
          (_ i.inc out.snoc((writ_up b.here existing mp mt)))
     =  stale
          =  olds=row[[p=path t=myth]]  existing.rev
          %    i=nat 0    out=row[[p=path q=writ]] []
          ^  row[[p=path q=writ]]
          ?  (ge i olds.len)
             out
          =  [ep et]  olds.at(i)
          ?  (has_path ep fresh)
             (_ i.inc out)
          (_ i.inc out.snoc([b.here.weld(ep) (writ/cull)]))
