+  unparse_node
  '  One record subtree as canonical source lines at depth d.
  \  d=nat fat=axal[myth]
  ^  row[nat]
  =  me  (_)
  =  ind  (spaces d)
  =  t
       ?>  (./some t0) fat.fil
           (myth/new)
       t0
  =  part  (path_at ['part] t)
  ?  part.len
     =  data  (path_at ['data] t)
     =  dstr  (if data.len (att_src "data" (show/path data)) 0)
     [(cord/cat_all [ind "<part" (att_src "part" (show/path part)) dstr ">"])]
  =  tag0  (myth/txt_at ['tag] t)
  =  tag  (if tag0 tag0 "div")
