+  subtree_rows
  '  Every record of a subtree re-addressed under base: the node's
  '  own record, then its numbered descendants.
  \  base=path fat=axal[myth]
  ^  row[[p=path t=myth]]
  =  own=row[[p=path t=myth]]
       ?>  (./some t) fat.fil
           []
       [[base (doc_fil t)]]
  own.weld((kid_recs base fat))
+  rows_paths
  \  rs=row[[p=path t=myth]]
  ^  row[path]
  %    i=nat 0    out=row[path] []
  ^  row[path]
  ?  (ge i rs.len)
     out
  =  [p t]  rs.at(i)
  (_ i.inc out.snoc(p))
+  op_swap
  '  Exchange two sibling subtrees: every record of each re-made at
  '  the other's address (a make replaces), old paths neither covers
  '  culled deepest-first.  One transaction; /h keeps the before.
  \  b=bowl cur=myth view=axal[myth] at=nat wth=nat
  ^  yell
  ?>  (./some ra) (parse_rel at)
      (yell [] cur)
  ?>  (./some rb) (parse_rel wth)
      (yell [] cur)
  ?  (eq 0 ra.len)
     (yell [] cur)
  ?  (eq 0 rb.len)
     (yell [] cur)
  ?  (pith_prefix ra rb)
     (yell [] cur)
  ?  (pith_prefix rb ra)
     (yell [] cur)
  =  sa  view.dip(ra)
  =  sb  view.dip(rb)
  ?  !?=((./some _) sa.fil)
     (yell [] cur)
  ?  !?=((./some _) sb.fil)
     (yell [] cur)
  =  ma  (subtree_rows ra sb)
  =  mb  (subtree_rows rb sa)
  =  news  ma.weld(mb)
  =  newp  (rows_paths news)
  =  olda  (rows_paths (subtree_rows ra sa))
  =  oldb  (rows_paths (subtree_rows rb sb))
  =  makes
       %    i=nat 0    out=row[[p=path q=writ]] []
       ^  row[[p=path q=writ]]
       ?  (ge i news.len)
          out
       =  [p t]  news.at(i)
       (_ i.inc out.snoc([b.here.weld(p) (writ/make t)]))
  =  culls
       =  olds=row[path]  olda.weld(oldb).rev
       %    i=nat 0    out=row[[p=path q=writ]] []
       ^  row[[p=path q=writ]]
       ?  (ge i olds.len)
          out
       =  p  olds.at(i)
       ?  (has_path p newp)
          (_ i.inc out)
       (_ i.inc out.snoc([b.here.weld(p) (writ/cull)]))
