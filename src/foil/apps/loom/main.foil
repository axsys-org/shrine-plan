+  el_rec
  '  An element record.
  \  tag=nat text=nat
  ^  myth
  =  t  (myth/new).put(['tag] (pails/t (str/from_atom tag)))
  ?  text
     t.put(['text] (pails/t (str/from_atom text)))
  t
+  part_rec
  '  A transclusion record.
  \  part=path data=path
  ^  myth
  (myth/new).put(['part] (pails/p part)).put(['data] (pails/p data))
+  page_init
  '  A fresh page: the sync crew on its own subtree, a default tag,
  '  then the making card's ['src] expands — a page is BORN from
  '  source, kids mounted in the same epoch.  This is also how the
  '  seeds work: starter pages ship as loom-html text, and nothing
  '  ever waits on a later hear round to exist.
  \  b=bowl t=myth
  ^  yell
  =  t1  t.put(crew_slot (cpail (crew/sing ['self] (dep .z b.here))))
  =  t2
       ?  (myth/txt_at ['tag] t1)
          t1
       t1.put(['tag] (pails/t "div"))
  =  src  (myth/txt_at ['src] t2)
  ?  src
     (expand_src b t2 src)
  (yell [] t2)
+  op_add
  '  A new element at the next index under a parent.
  \  b=bowl cur=myth view=axal[myth] at=nat tag=nat text=nat
  ^  yell
  ?  !(tag_ok tag)
     (yell [] cur)
  ?>  (./some parent) (parse_rel at)
      (yell [] cur)
  =  idx  (next_idx view.dip(parent))
  =  p  b.here.weld(parent).snoc(($u idx))
  (yell [[p (writ/make (el_rec tag text))]] cur)
+  op_del
  '  Cull a subtree — from the current state only; /h keeps it.
  \  b=bowl cur=myth at=nat
  ^  yell
  ?>  (./some rel) (parse_rel at)
      (yell [] cur)
  ?  (eq 0 rel.len)
     (yell [] cur)
  (yell [[b.here.weld(rel) (writ/cull)]] cur)
+  op_tag
  '  Retag an element (pokes meld).
  \  b=bowl cur=myth at=nat tag=nat
  ^  yell
  ?  !(tag_ok tag)
     (yell [] cur)
  ?>  (./some rel) (parse_rel at)
      (yell [] cur)
  ?  (eq 0 rel.len)
     (yell [] cur.put(['tag] (pails/t (str/from_atom tag))))
