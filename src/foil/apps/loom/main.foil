-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  lainapp [order=80]
'  loom: a metacircular HTML editor — pages as namespace records.
'  There is no HTML text anywhere in shrine: markup exists only as
'  weft/node values inside compiled components.  Loom makes pages
'  first-class data instead: a page is a subtree of element records
'  (a tag, an optional text run, a few attribute slots, numbered
'  kids), rendered live by a felt component, edited four ways that
'  are all views of the same subtree —
'    click a sentence        w-edit pokes the record through /edit
'    the toolbar             structure ops through the page's talk
'    the source pane         loom-html text, bidirectionally synced
'    the scrubber            /h replays every committed revision
'  A ['part] record transcludes any zoo component into a page, the
'  page renderer is itself a zoo component, and the seeded home page
'  is the loom's own documentation — records edited by the editor
'  they document, which renders itself rendering them.
+  path_at
  '  A path-valued slot, or the empty path.
  \  slot=path t=myth
  ^  path
  ?  t.get(slot)
   > (./some held=pail)
     ?  held
      > pp=pails/p  pp.p
     []
   > .none  []
+  split_slash
  '  A cord split on slashes, empty segments dropped.
  '  ?=  ((split_slash "a/bb") ["a" "bb"])
  '  ?=  ((split_slash "/a/b/") ["a" "b"])
  \  s=nat
  ^  row[nat]
  =  n  (cord/len s)
  %    i=nat 0    start=nat 0    out=row[nat] []
  ^  row[nat]
  ?  (ge i n)
     ?  (gt i start)
        out.snoc((cord/slice start (sub i start) s))
     out
  ?  (eq 47 (cord/at s i))
     ?  (gt i start)
        (_ i.inc i.inc out.snoc((cord/slice start (sub i start) s)))
     (_ i.inc i.inc out)
  (_ i.inc start out)
+  parse_rel
  '  An element address as a toolbar form spells it: "." is the page
  '  root, "0/2" a numbered descent.  A non-digit segment is a
  '  refusal, never a guess.
  \  s=nat
  ^  maybe[path]
  ?  (eq s ".")
     (./some [])
  =  segs  (split_slash s)
  ?  (eq 0 segs.len)
     .none
  %    i=nat 0    out=path []
  ^  maybe[path]
  ?  (ge i segs.len)
     (./some out)
  ?  (dig_parse (str/from_atom segs.at(i)))
   > (./some n=nat)  (_ i.inc out.snoc(($u n)))
   > .none  .none
+  parse_abs
  '  A slash path as typed into a form field: digit segments read as
  '  numbers, $-sigiled ones as their text, anything else as a text
  '  segment — the same reading the host gives URL segments.
  \  s=nat
  ^  path
  =  segs  (split_slash s)
  %    i=nat 0    out=path []
  ^  path
  ?  (ge i segs.len)
     out
  =  seg  segs.at(i)
  ?  (dig_parse (str/from_atom seg))
   > (./some n=nat)  (_ i.inc out.snoc(($u n)))
   > .none
     ?  (eq 36 (cord/at seg 0))
        (_ i.inc out.snoc(($ts (cord/slice 1 (sub (cord/len seg) 1) seg))))
     (_ i.inc out.snoc(($ts seg)))
+  bjoin
  '  A row of cords joined by one byte.
  '  ?=  ((bjoin 47 ["a" "b"]) "a/b")
  \  b=nat xs=row[nat]
  ^  nat
  %    i=nat 0    acc=nat 0
  ?  (ge i xs.len)
     acc
  ?  (eq i 0)
     (_ 1 xs.at(0))
  (_ i.inc (cord/cat acc (cord/cat b xs.at(i))))
+  bjoin_all
  '  A row of cords joined by one byte, balanced — folding cat goes
  '  quadratic on page-sized output.
  \  b=nat xs=row[nat]
  ^  nat
  ?  (eq 0 xs.len)
     0
  =  rest
       %    i=nat 1    out=row[nat] []
       ^  row[nat]
       ?  (ge i xs.len)
          out
       (_ i.inc out.snoc(b).snoc(xs.at(i)))
  (cord/cat xs.at(0) (cord/cat_all rest))
+  seg_row
  '  A path's segments as their canonical text spellings.
  \  at=path
  ^  row[nat]
  %    i=nat 0    out=row[nat] []
  ^  row[nat]
  ?  (ge i at.len)
     out
  (_ i.inc out.snoc((show/iota at.at(i))))
+  rel_text
  '  The inverse address spelling: "." for the root, segments
  '  slashed.
  '  ?=  ((rel_text []) ".")
  \  at=path
  ^  nat
  ?  (eq 0 at.len)
     "."
  (bjoin 47 (seg_row at))
+  part_id
  '  A stable mount id for an embedded part: its relative path
  '  dashed.
  \  at=path
  ^  nat
  ?  (eq 0 at.len)
     "pt-root"
  (cord/cat "pt-" (bjoin 45 (seg_row at)))
+  next_idx
  '  One past the highest numbered kid.
  \  fat=axal[myth]
  ^  nat
  =  es  fat.kid_tap
  %    i=nat 0    acc=nat 0
  ^  nat
  ?  (ge i es.len)
     acc
  ?  es.at(i).key
   > ($u n=nat)
     ?  (ge n acc)
        (_ i.inc n.inc)
     (_ i.inc acc)
  (_ i.inc acc)
'  ==================================================================
'  I.  The renderer: records as markup
'  ==================================================================
'  An element record carries ['tag], an optional ['text] run
'  (rendered first, editable in place), and the attribute allowlist
'  ['cls] ['href] ['src] ['alt]; its kids are the numbered children
'  of its path.  A ['part] record renders as a live nested mount of
'  the component at ['part] over the data at ['data].  The tag
'  allowlist is the injection guard: records are data, and a tag the
'  renderer does not know becomes an inert chip, never markup — so a
'  poked "script" can never execute.
+  safe_tags
  '  What the renderer will emit as markup.
  ^  row[nat]
  ["div" "p" "h1" "h2" "h3" "span" "ul" "ol" "li" "a" "pre" "code"
   "em" "strong" "blockquote" "img" "hr" "br" "section" "article"]
+  tag_ok
  '  ?=  ((tag_ok "p") 1)
  '  ?=  ((tag_ok "script") 0)
  \  t=nat
  ^  bool
  safe_tags.any((eq t))
+  is_void
  '  The elements written without a close tag.
  '  ?=  ((is_void "br") 1)
  '  ?=  ((is_void "p") 0)
  \  t=nat
  ^  bool
  ?  (eq t "br")
     .true
  ?  (eq t "hr")
     .true
  ?  (eq t "img")
     .true
  (eq t "part")
+  safe_href
  '  Scheme guard for link-bearing attribute values: weft escapes
  '  bytes, not URL schemes, so a javascript: value renders as "#".
  '  ?=  ((safe_href "/app/loom") "/app/loom")
  '  ?=  ((safe_href "javascript:alert(1)") "#")
  \  v=nat
  ^  nat
  =  low
       %    i=nat 0    acc=nat 0
       ^  nat
       ?  (ge i 11)
          acc
       ?  (ge i (cord/len v))
          acc
       =  c  (cord/at v i)
       =  c2
            ?  (if (ge c 65) (le c 90) 0)
               (add c 32)
            c
       (_ i.inc (cord/cat acc c2))
  ?  (eq low "javascript:")
     "#"
  v
+  att_row
  '  The allowed attribute slots of an element record as markup
  '  attributes — cls spells class, link values scheme-guarded.
  \  t=myth
  ^  row[weft/att]
  =  cls  (myth/txt_at ['cls] t)
  =  href  (myth/txt_at ['href] t)
  =  srcv  (myth/txt_at ['src] t)
  =  alt  (myth/txt_at ['alt] t)
  =  r0=row[weft/att]  []
  =  r1  (if cls r0.snoc((weft/att "class" cls)) r0)
  =  r2  (if href r1.snoc((weft/att "href" (safe_href href))) r1)
  =  r3  (if srcv r2.snoc((weft/att "src" (safe_href srcv))) r2)
  (if alt r3.snoc((weft/att "alt" alt)) r3)
+  ed_run
  '  An editable text run: the /w.js w-edit affordance at this
  '  mount-relative path, slot text.
  \  at=path t=nat
  ^  weft/node
  (weft/el "span"
    [(weft/att "w-edit" (cord/cat_all [(rel_text at) " " "text"]))]
    [(weft/tx t)])
+  node_html
  '  One record subtree as markup, recursive: parts mount live,
  '  disallowed tags chip, text runs ride first and edit in place.
  '  The page ROOT's app slots are masked before the attribute read —
  '  ['src] on the root is the page's source, not an img src, and
  '  without the mask the whole source leaks into the markup as an
  '  attribute (caught live).
  \  at=path fat=axal[myth]
  ^  weft/node
  =  me  (_)
  =  t
       ?>  (./some t0) fat.fil
           (myth/new)
       t0
  =  part  (path_at ['part] t)
  ?  part.len
     =  data  (path_at ['data] t)
     ?  (eq 0 data.len)
        (weft/el "div" [(weft/cls "badpart")]
          [(weft/tx "part needs a data path")])
     (weft/el "div" [(weft/cls "part")]
       [(frag/mount (part_id at) part data 2)])
  =  tag0  (myth/txt_at ['tag] t)
  =  tag  (if tag0 tag0 "div")
  =  txt  (myth/txt_at ['text] t)
  =  ta
       ?  at.len
          t
       t.put(['src] (pails/t "")).put(['err] (pails/t ""))
  =  kids0=row[weft/node]
       ?  txt
          [(ed_run at txt)]
       []
  =  es  fat.kid_tap
  =  kids
       %    i=nat 0    out=row[weft/node] kids0
       ^  row[weft/node]
       ?  (ge i es.len)
          out
       ?  es.at(i).key
        > ($u n=nat)
          (_ i.inc out.snoc((me at.snoc(($u n)) es.at(i).val)))
       (_ i.inc out)
  ?  !(tag_ok tag)
     =  chip
          (weft/el "span" [(weft/cls "chip")]
            [(weft/tx (weft/cat2 "tag " tag))])
     (weft/el "div" [(weft/cls "badtag")] kids.cons(chip))
  (weft/el tag (att_row ta) kids)
+  page_html
  '  The page component's projection: the whole subtree as markup —
  '  a pure function of the records, so the view is live wherever it
  '  is mounted and scrubs with /h.
  \  fat=axal[myth]
  ^  myth
  =  nd  (node_html [] fat)
  ?  nd
   > (./el tag=nat as=row[weft/att] kids=row[weft/node])
     (frag/html tag as kids)
  (frag/html "div" [] [nd])
+  page_view
  '  The page component: a felt over the page subtree.
  ^  pail
  (felt page_html .none)
'  ==================================================================
'  II.  loom-html: the source grammar
'  ==================================================================
'  A page's ['src] is a disciplined HTML subset.  The source is the
'  root's CONTENT: an optional leading text run, then sibling
'  element blocks (the root's own tag stays op-editable, outside the
'  source).  Tags are lowercase words — any of them: the RENDERER is
'  the injection guard, so a parsed "script" still renders as a
'  chip, and refusing it here would break the round trip for records
'  the ops legally make.  Attributes are double-quoted and
'  allowlisted (class/href/src/alt, plus part/data on the part
'  element); entities are the four the unparser emits; each element
'  holds ONE text run, before its kids — text after a child is a
'  refusal, because silently reordering pasted prose would be worse.
'  img/hr/br/part are void.  A part is spelled
'  <part part="/app/life/weft/board" data="/app/life/board">.
'  Malformed source commits ['err] and touches nothing else: a bad
'  edit is a visible namespace fact, never a lost one.
+  latt
  '  One parsed attribute: name and decoded value.
  :  k=nat v=nat
+  lnode
  '  One parsed element: tag, leading text run, attributes, kids.
  :  tag=nat text=nat atts=row[latt] kids=row[lnode]
+  pres
  '  A whole-source parse: the root's text and kid elements, or the
  '  first refusal.
  &  pres/ok
     pres/bad

  +  ok
    :  rtext=nat kids=row[lnode]

  +  bad
    :  why=nat
+  ores
  '  One tag token: an open tag, a close tag, or a refusal.
  &  ores/otag
     ores/oclose
     ores/obad

  +  otag
    :  tag=nat atts=row[latt] sc=bool next=nat

  +  oclose
    :  tag=nat next=nat

  +  obad
    :  why=nat
+  nres
  '  A kid-sequence parse: text run, kids, resume index — or the
  '  refusal.
  &  nres/nok
     nres/nbad

  +  nok
    :  rtext=nat kids=row[lnode] next=nat

  +  nbad
    :  why=nat
+  ws_byte
  '  ?=  ((ws_byte 32) 1)
  \  c=nat
  ^  bool
  ?  (eq c 32)
     .true
  ?  (eq c 9)
     .true
  ?  (eq c 13)
     .true
  (eq c 10)
+  ws_end
  '  The first index at or after i that is not whitespace.
  \  s=nat i=nat
  ^  nat
  (cord/span_while ws_byte s i)
+  lower_byte
  \  c=nat
  ^  bool
  ?  (lt c 97)
     .false
  (le c 122)
+  name_byte
  '  A tag or attribute name byte: lowercase or digit.
  \  c=nat
  ^  bool
  ?  (lower_byte c)
     .true
  (digit_byte c)
+  name_end
  \  s=nat i=nat
  ^  nat
  (cord/span_while name_byte s i)
+  attv_byte
  '  A byte legal inside a quoted attribute value: anything but the
  '  closing quote or a raw <.
  \  c=nat
  ^  bool
  ?  (eq c 34)
     .false
  !(eq c 60)
+  text_byte
  '  A byte legal inside a text run: anything but a tag opener.
  \  c=nat
  ^  bool
  !(eq c 60)
+  solid_byte
  '  Not whitespace.
  \  c=nat
  ^  bool
  !(ws_byte c)
+  decode_ent
  '  Decode the four entities the unparser emits; any other & is
  '  literal.
  '  ?=  ((decode_ent "a&amp;b") "a&b")
  '  ?=  ((decode_ent "x&y") "x&y")
  \  s=nat
  ^  nat
  =  n  (cord/len s)
  =  parts
       %    i=nat 0    start=nat 0    out=row[nat] []
       ^  row[nat]
       ?  (ge i n)
          out.snoc((cord/slice start (sub i start) s))
       ?  !(eq 38 (cord/at s i))
          (_ i.inc start out)
       =  run  (cord/slice start (sub i start) s)
       ?  (eq "&amp;" (cord/slice i 5 s))
          (_ (add i 5) (add i 5) out.snoc(run).snoc("&"))
       ?  (eq "&lt;" (cord/slice i 4 s))
          (_ (add i 4) (add i 4) out.snoc(run).snoc("<"))
       ?  (eq "&gt;" (cord/slice i 4 s))
          (_ (add i 4) (add i 4) out.snoc(run).snoc(">"))
       ?  (eq "&quot;" (cord/slice i 6 s))
          (_ (add i 6) (add i 6) out.snoc(run).snoc(34))
       (_ i.inc start out)
  (cord/cat_all parts)
+  clean_run
  '  A raw text run, normalized: whitespace runs collapse to one
  '  space, ends trim, entities decode.  Normalizing, never
  '  escaping — so regeneration is quiescent, and a whitespace-only
  '  run reads as empty.
  '  ?=  ((clean_run "  a  b  ") "a b")
  \  s=nat
  ^  nat
  =  n  (cord/len s)
  =  parts
       %    i=nat 0    out=row[nat] []
       ^  row[nat]
       ?  (ge i n)
          out
       ?  (ws_byte (cord/at s i))
          =  e  (ws_end s i)
          ?  (eq 0 out.len)
             (_ e out)
          ?  (ge e n)
             (_ e out)
          (_ e out.snoc(" "))
       =  e2  (cord/span_while solid_byte s i)
       (_ e2 out.snoc((cord/slice i (sub e2 i) s)))
  (decode_ent (cord/cat_all parts))
+  take_text
  '  The text run from i to the next tag: cleaned, with the resume
  '  index.
  \  s=nat i=nat
  ^  [t=nat next=nat]
  =  e  (cord/span_while text_byte s i)
  [(clean_run (cord/slice i (sub e i) s)) e]
+  take_attr
  '  One name="value" attribute at i (whitespace already skipped):
  '  name, decoded value, resume index — or a refusal for anything
  '  but the double-quoted form.
  \  s=nat i=nat
  ^  maybe[[k=nat v=nat next=nat]]
  =  ne  (name_end s i)
  ?  (eq ne i)
     .none
  =  k  (cord/slice i (sub ne i) s)
  ?  !(eq 61 (cord/at s ne))
     .none
  ?  !(eq 34 (cord/at s ne.inc))
     .none
  =  vs  (add ne 2)
  =  ve  (cord/span_while attv_byte s vs)
  ?  !(eq 34 (cord/at s ve))
     .none
  (./some [k (decode_ent (cord/slice vs (sub ve vs) s)) ve.inc])
+  attr_ok
  '  The attribute allowlist: class/href/src/alt on any element,
  '  part/data on the part element only.
  \  tag=nat k=nat
  ^  bool
  ?  (eq k "class")
     .true
  ?  (eq k "href")
     .true
  ?  (eq k "src")
     .true
  ?  (eq k "alt")
     .true
  ?  (eq tag "part")
     ?  (eq k "part")
        .true
     (eq k "data")
  .false
+  take_open
  '  The tag token at i (the byte there is a <): an open tag with
  '  its attributes, a close tag, or the refusal.
  \  s=nat i=nat
  ^  ores
  =  j  i.inc
  ?  (eq 47 (cord/at s j))
     =  ne  (name_end s j.inc)
     ?  (eq ne j.inc)
        (ores/obad "empty close tag")
     ?  !(eq 62 (cord/at s ne))
        (ores/obad "unclosed close tag")
     (ores/oclose (cord/slice j.inc (sub ne j.inc) s) ne.inc)
  ?  !(lower_byte (cord/at s j))
     (ores/obad "a tag opens with a lowercase name")
  =  ne2  (name_end s j)
  =  tag  (cord/slice j (sub ne2 j) s)
  %    p=nat ne2    atts=row[latt] []
  ^  ores
  =  q  (ws_end s p)
  ?  (ge q (cord/len s))
     (ores/obad "unclosed tag")
  ?  (eq 62 (cord/at s q))
     (ores/otag tag atts .false q.inc)
  ?  (eq 47 (cord/at s q))
     ?  (eq 62 (cord/at s q.inc))
        (ores/otag tag atts .true (add q 2))
     (ores/obad "stray slash in a tag")
  ?>  (./some a) (take_attr s q)
      (ores/obad "malformed attribute")
  =  [k v nx]  a
  ?  !(attr_ok tag k)
     (ores/obad (weft/cat2 "unknown attribute " k))
  (_ nx atts.snoc((latt k v)))
+  parse_nodes
  '  Recursive descent over a kid sequence: the leading text run,
  '  then elements until the matching close (or the end, when close
  '  is 0).  Text after a child element is a refusal — the record
  '  model holds one run per element.
  \  s=nat i=nat close=nat
  ^  nres
  =  me  (_)
  =  [t0 j0]  (take_text s i)
  %    j=nat j0    kids=row[lnode] []
  ^  nres
  ?  (ge j (cord/len s))
     ?  (eq 0 close)
        (nres/nok t0 kids j)
     (nres/nbad (weft/cat2 "unclosed element " close))
  ?  (take_open s j)
   > (./oclose tag=nat next=nat)
     ?  (eq tag close)
        (nres/nok t0 kids next)
     (nres/nbad (weft/cat2 "mismatched close " tag))
   > (./obad why=nat)
     (nres/nbad why)
   > (./otag tag=nat atts=row[latt] sc=bool next=nat)
     ?  (if sc 1 (is_void tag))
        =  [t2 j2]  (take_text s next)
        ?  t2
           (nres/nbad "text after a child element")
        (_ j2 kids.snoc((lnode tag 0 atts [])))
     ?  (me s next tag)
      > (./nok rt=nat kk=row[lnode] nx=nat)
        =  [t3 j3]  (take_text s nx)
        ?  t3
           (nres/nbad "text after a child element")
        (_ j3 kids.snoc((lnode tag rt atts kk)))
      > (./nbad w2=nat)
        (nres/nbad w2)
+  parse_src
  '  A whole loom-html source, or the first refusal.
  \  s=nat
  ^  pres
  ?  (parse_nodes s 0 0)
   > (./nok rtext=nat kids=row[lnode] next=nat)
     (pres/ok rtext kids)
   > (./nbad why=nat)
     (pres/bad why)
+  att_val
  '  The value of a named parsed attribute, or 0.
  \  as=row[latt] k=nat
  ^  nat
  %    i=nat 0
  ^  nat
  ?  (ge i as.len)
     0
  ?  (eq as.at(i).k k)
     as.at(i).v
  (_ i.inc)
+  node_rec
  '  One parsed element as its namespace record.
  \  nd=lnode
  ^  myth
  ?  (eq nd.tag "part")
     =  pv  (att_val nd.atts "part")
     =  dv  (att_val nd.atts "data")
     =  t0  (myth/new).put(['part] (pails/p (parse_abs pv)))
     ?  dv
        t0.put(['data] (pails/p (parse_abs dv)))
     t0
  =  t1  (myth/new).put(['tag] (pails/t (str/from_atom nd.tag)))
  =  t2  (if nd.text t1.put(['text] (pails/t (str/from_atom nd.text))) t1)
  nd.atts.fold(t2 ;
    \  acc a
    ?  (eq a.k "class")
       acc.put(['cls] (pails/t (str/from_atom a.v)))
    acc.put([($ts a.k)] (pails/t (str/from_atom a.v))))
+  lmounts
  '  The records a parsed kid row mounts: preorder, numbered from 0
  '  under each parent — the shape the sync law compares and the
  '  expansion writes.
  \  base=path ns=row[lnode]
  ^  row[[p=path t=myth]]
  =  me  (_)
  %    i=nat 0    out=row[[p=path t=myth]] []
  ^  row[[p=path t=myth]]
  ?  (ge i ns.len)
     out
  =  nd  ns.at(i)
  =  p  base.snoc(($u i))
  =  here  out.snoc([p (node_rec nd)])
  (_ i.inc here.weld((me p nd.kids)))
'  ==================================================================
'  III.  The unparser and the two images
'  ==================================================================
'  Canonical source: two-space indent per depth, kid-less elements
'  inline, attributes in fixed order, no trailing newline.  The
'  sync law compares IMAGES, never text: rec_image reads the live
'  records ordinally (gap-insensitive, so a deletion's gap and its
'  renumbered re-expansion read the same), and the source's image is
'  its parse — that is why an author's layout survives every
'  normalization until the records themselves move.
+  att_src
  '  One attribute as source text.
  \  k=nat v=nat
  ^  nat
  (cord/cat_all [" " k "=" 34 (weft/esc v) 34])
+  rec_atts_src
  '  An element record's attributes back as source, fixed order.
  \  t=myth
  ^  nat
  =  cls  (myth/txt_at ['cls] t)
  =  href  (myth/txt_at ['href] t)
  =  srcv  (myth/txt_at ['src] t)
  =  alt  (myth/txt_at ['alt] t)
  =  a1  (if cls (att_src "class" cls) 0)
  =  a2  (if href (att_src "href" href) 0)
  =  a3  (if srcv (att_src "src" srcv) 0)
  =  a4  (if alt (att_src "alt" alt) 0)
  (cord/cat_all [a1 a2 a3 a4])
+  spaces
  '  2d indent spaces.
  \  d=nat
  ^  nat
  %    i=nat 0    acc=nat 0
  ?  (ge i d)
     acc
  (_ i.inc (cord/cat acc "  "))
+  sys_slot
  \  s=path
  ^  bool
  (pith_prefix ['sys] s)
+  doc_fil
  '  A record as content: /sys machinery stripped, swept (empty
  '  text) slots dropped — the sweep symmetry that makes a swept
  '  record compare equal to a fresh parse.
  \  t=myth
  ^  myth
  t.tap.fold((myth/new) ;
    \  acc e
    ?  (sys_slot e.key)
       acc
    ?  e.val
     > tp=pails/t
       ?  (eq 0 tp.t)
          acc
       acc.put(e.key e.val)
    acc.put(e.key e.val))
+  content_slots
  '  The loom vocabulary on an element record: what a source commit
  '  is authoritative over.  Foreign annotations survive an edit.
  ^  row[path]
  [['tag] ['text] ['cls] ['href] ['src] ['alt] ['part] ['data]]
+  has_path
  '  Membership in a path row.
  \  p=path ps=row[path]
  ^  bool
  ps.any((eq_pith p))
+  kid_recs
  '  The content records of a subtree: raw numbered paths, preorder,
  '  doc_fil'd — the expansion's ground truth for what exists.
  \  base=path fat=axal[myth]
  ^  row[[p=path t=myth]]
  =  me  (_)
  =  es  fat.kid_tap
  %    i=nat 0    out=row[[p=path t=myth]] []
  ^  row[[p=path t=myth]]
  ?  (ge i es.len)
     out
  ?  es.at(i).key
   > ($u n=nat)
     =  p  base.snoc(($u n))
     =  rec
          ?>  (./some t) es.at(i).val.fil
              (myth/new)
          (doc_fil t)
     =  here  out.snoc([p rec])
     (_ i.inc here.weld((me p es.at(i).val)))
  (_ i.inc out)
+  rec_rows
  '  The same records in ORDINAL numbering — the sync comparison's
  '  record side, gap-insensitive.
  \  base=path fat=axal[myth]
  ^  row[[p=path t=myth]]
  =  me  (_)
  =  es  fat.kid_tap
  %    i=nat 0    k=nat 0    out=row[[p=path t=myth]] []
  ^  row[[p=path t=myth]]
  ?  (ge i es.len)
     out
  ?  es.at(i).key
   > ($u n=nat)
     =  p  base.snoc(($u k))
     =  rec
          ?>  (./some t) es.at(i).val.fil
              (myth/new)
          (doc_fil t)
     =  here  out.snoc([p rec])
     (_ i.inc k.inc here.weld((me p es.at(i).val)))
  (_ i.inc k out)
+  tapped
  '  Mount rows with each record as its sorted slot row.  A mop's
  '  tree shape depends on insertion order, so deep equality on raw
  '  mops distinguishes same-content records — images compare TAPS.
  \  rs=row[[p=path t=myth]]
  ^  row[[p=path q=row[mop/kv[path pail]]]]
  %    i=nat 0    out=row[[p=path q=row[mop/kv[path pail]]]] []
  ^  row[[p=path q=row[mop/kv[path pail]]]]
  ?  (ge i rs.len)
     out
  =  [p t]  rs.at(i)
  (_ i.inc out.snoc([p t.tap]))
+  rec_image
  '  The record side of the sync comparison: the root's text run and
  '  every content record in ordinal order, tapped.
  \  fat=axal[myth]
  ^  [rt=nat rows=row[[p=path q=row[mop/kv[path pail]]]]]
  =  rt
       ?>  (./some t) fat.fil
           0
       (myth/txt_at ['text] t)
