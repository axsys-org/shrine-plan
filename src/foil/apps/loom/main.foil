+  page_talk
  '  The page's verbs, in precedence: a posted or poked ['src] is
  '  the source transaction; a ['post 'op] is a structure op; any
  '  other poke is the default meld — which is exactly what an /edit
  '  write-through or a foreign annotation should be.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  posted  (myth/txt_at ['post 'src] nu)
  =  src
       ?  posted
          posted
       (myth/txt_at ['src] nu)
  ?  src
     (expand_src b cur src)
  =  op  (myth/txt_at ['post 'op] nu)
  ?  (eq 0 op)
     (def_talk b cur nu)
  =  view  b.crew.gut(['self] (axal/new[myth] .none))
  =  at  (myth/txt_at ['post 'at] nu)
  ?  (eq op "add")
     (op_add b cur view at (myth/txt_at ['post 'tag] nu) (myth/txt_at ['post 'text] nu))
  ?  (eq op "del")
     (op_del b cur at)
  ?  (eq op "tag")
     (op_tag b cur at (myth/txt_at ['post 'tag] nu))
  ?  (eq op "part")
     (op_part b cur view at (myth/txt_at ['post 'part] nu) (myth/txt_at ['post 'data] nu))
  ?  (eq op "swap")
     (op_swap b cur view at (myth/txt_at ['post 'with] nu))
  (yell [] cur)
+  page_hear
  '  The record→source law: any committed change under the page
  '  recompares the records' content image against what the
  '  committed source parses to; a divergence — an /edit poke, a
  '  toolbar op, another app's write — regenerates ['src] as
  '  canonical unparse text.  The write rides hear's own yell state,
  '  never a self-poke, so talk cannot re-run on a regeneration; a
  '  deep-equal write raises no event, so quiescence is a fixpoint.
  '  An ordinary source edit compares equal on the first round
  '  (expand sweeps what it stopped writing), so the author's layout
  '  is never canonicalized under them.
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  view  b.crew.gut(['self] (axal/new[myth] .none))
  =  rec  (rec_image view)
  =  src  (myth/txt_at ['src] cur)
  =  same
       ?  (parse_src src)
        > (./ok rtext=nat kids=row[lnode])
          (equal rec [rtext (tapped (lmounts [] kids))])
        > (./bad _)
          .false
  ?  same
     (yell [] cur)
  =  nu  (unparse_page view)
  ?  (eq nu src)
     (yell [] cur)
  (yell [] cur.put(['src] (pails/t (str/from_atom nu))))
+  page_form
  '  The page behavior: init expands the starter source, talk applies ops and
  '  source commits, hear regenerates the source.
  ^  form
  def_form.set_init(page_init).set_talk(page_talk).set_hear(page_hear)
+  hub_talk
  '  ['post 'new] stamps a page: a make whose card carries the page
  '  kook (absolute — runtime cards are not rebased), a default tag,
  '  and the stamp name.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  name  (myth/txt_at ['post 'new] nu)
  ?  (eq 0 name)
     (def_talk b cur nu)
  =  stamp  (myth/txt_at ['post 'stamp] nu)
  =  starter
       ?  (eq stamp "note")
          (bjoin_all 10
            ["<h2>a note</h2>"
             "<p>click any text to edit it in place; the toolbar restructures; the source pane round-trips.</p>"])
       "<p>a fresh loom page - click this text to edit it</p>"
  =  root=path  b.here.take(b.here.len.dec)
  =  kp  root.weld(['kook 'page])
  =  t  (kooked [kp]).put(['tag] (pails/t "div")).put(['src] (pails/t (str/from_atom starter)))
  (yell [[b.here.snoc(($ts name)) (writ/make t)]] cur)
+  hub_form
  '  The container behavior: talk answers the new-page form.
  ^  form
  def_form.set_talk(hub_talk)
'  ==================================================================
'  V.  The face: index and editor chrome
'  ==================================================================
+  root_of
  '  The app's mount root for a request target: two segments under
  '  /app, one segment anywhere else.
  \  tgt=path
  ^  path
  ?  (lt tgt.len 2)
     tgt
  ?  (eq_iota tgt.at(0) 'app)
     tgt.take(2)
  tgt.take(1)
+  loom_css
  ^  nat
  "body{font-family:sans-serif;max-width:52em;margin:2em auto;padding:0 1em;line-height:1.5;color:#222} h1{font-size:1.3em} .muted{color:#667;font-size:.9em} .toolbar{display:flex;flex-wrap:wrap;gap:.6em;margin:1em 0;padding:.6em;background:#f4f5f7;border-radius:6px} .toolbar form{display:flex;gap:.3em;align-items:center} .toolbar input{width:8em} .toolbar button{white-space:nowrap} .srced{display:flex;flex-direction:column;gap:.5em;margin-top:1.5em;border-top:1px solid #dde;padding-top:1em} textarea{font-family:monospace;font-size:.9em;padding:.5em} .srced button{align-self:flex-start} .lpage{border:1px solid #dde;border-radius:6px;padding:1em;margin:.8em 0} .badtag{border:1px dashed #c99;padding:.3em} .chip{background:#fee;color:#933;font-family:monospace;font-size:.8em;padding:0 .4em;border-radius:4px;margin-right:.4em} .part{border:1px dashed #ccd;border-radius:6px;padding:.5em;margin:.4em 0} .badpart{color:#933;font-size:.85em} .item{margin:.2em 0} [w-edit]:hover{outline:1px dashed #9ab;cursor:text}"
+  fld
  '  One toolbar text input.
  \  name=nat ph=nat
  ^  weft/node
  (weft/el "input"
    [(weft/att "type" "text") (weft/att "name" name)
     (weft/att "placeholder" ph) (weft/att "autocomplete" "off")]
    [])
+  op_form
  '  One toolbar form: a hidden op, its fields, posting to the page
  '  and refreshing the mount.
  \  pagep=path op=nat fields=row[weft/node] label=nat
  ^  weft/node
  =  head
       [(weft/el "input"
          [(weft/att "type" "hidden") (weft/att "name" "op")
           (weft/att "value" op)]
          [])]
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path pagep)))
     (weft/att "w-post" "1")
     (weft/att "w-refresh" "page")]
    head.weld(fields).snoc((weft/leaf "button" [] label)))
+  toolbar
  '  The structure ops.
  \  pagep=path
  ^  weft/node
  (weft/el "div" [(weft/cls "toolbar")]
    [(op_form pagep "add" [(fld "at" "at (. or 0/2)") (fld "tag" "tag") (fld "text" "text")] "add")
     (op_form pagep "tag" [(fld "at" "at") (fld "tag" "tag")] "retag")
     (op_form pagep "del" [(fld "at" "at")] "delete")
     (op_form pagep "swap" [(fld "at" "at") (fld "with" "with")] "swap")
     (op_form pagep "part" [(fld "at" "at") (fld "part" "component path") (fld "data" "data path")] "embed")])
+  src_form
  '  The source pane: the committed canonical source, editable as a
  '  whole.  A plain POST, deliberately not w-post — the runtime
  '  clears textareas after a wired submit, and the reload
  '  repopulates the pane from the commit.
  \  pagep=path tgt=path src=nat
  ^  weft/node
  (weft/el "form"
    [(weft/att "method" "post")
     (weft/att "action" (weft/cat2 "/post" (show/path pagep)))
     (weft/cls "srced")]
    [(weft/el "input"
       [(weft/att "type" "hidden") (weft/att "name" "back")
        (weft/att "value" (show/path tgt))]
       [])
     (weft/el "textarea"
       [(weft/att "name" "src") (weft/att "rows" "14")]
       [(weft/tx src)])
     (weft/leaf "button" [] "commit source")])
+  src_of
  '  The committed source on a view's own record.
  \  fat=axal[myth]
  ^  nat
  ?>  (./some t) fat.fil
      0
  (myth/txt_at ['src] t)
+  err_of
  '  The last source refusal, if any.
  \  fat=axal[myth]
  ^  nat
  ?>  (./some t) fat.fil
      0
  (myth/txt_at ['err] t)
+  index_page
  '  The front page: every page listed, the new-page form, the zoo.
  \  root=path tgt=path fat=axal[myth] first=nat top=nat
  ^  nat
  =  hubp  root.weld(['p])
  =  es  fat.kid_tap
  =  rows
       %    i=nat 0    out=row[weft/node] []
       ^  row[weft/node]
       ?  (ge i es.len)
          out
       ?  es.at(i).key
        > ($ts n=nat)
          =  pp  hubp.snoc(es.at(i).key)
          (_ i.inc out.snoc((weft/el "div" [(weft/cls "item")]
            [(weft/leaf "a" [(weft/href (show/path pp))] n)])))
       (_ i.inc out)
  =  newf
       (weft/el "form"
         [(weft/att "method" "post")
          (weft/att "action" (weft/cat2 "/post" (show/path hubp)))]
         [(weft/el "input"
            [(weft/att "type" "hidden") (weft/att "name" "back")
             (weft/att "value" (show/path tgt))]
            [])
          (fld "new" "page name")
          (fld "stamp" "stamp: blank or note")
          (weft/leaf "button" [] "new page")])
  =  scrub=row[weft/node]
       ?  top
          [(frag/scrubber first top)]
       []
  =  head=row[weft/node]
       [(weft/leaf "h1" [] "loom")
        (weft/el "div" [(weft/cls "muted")]
          [(weft/tx "an HTML editor whose pages are namespace records: the rendered page, the toolbar, the source pane, and the scrubber are four views of one subtree")])
        (weft/el "div" [(weft/cls "muted")]
          [(weft/leaf "a" [(weft/href "/weft")] "the component zoo")])]
  =  body  head.weld(rows).snoc(newf).weld(scrub).snoc(frag/script)
  (weft/page "loom" loom_css body)
+  edit_page
  '  The editor chrome: the page mounted live (the same felt any
  '  transcluding page uses), the toolbar, the source pane, the
  '  scrubber.
  \  root=path pagep=path tgt=path src=nat err=nat first=nat top=nat
  ^  nat
  =  scrub=row[weft/node]
       ?  top
          [(frag/scrubber first top)]
       []
  =  name
       ?  pagep.len
          (show/iota pagep.at(pagep.len.dec))
       "page"
  =  errrow=row[weft/node]
       ?  err
          [(weft/el "div" [(weft/cls "badpart")]
             [(weft/tx (weft/cat2 "source refused: " err))])]
       []
  =  body
       [(weft/leaf "h1" [] (weft/cat2 "loom: " name))
        (weft/el "div" [(weft/cls "muted")]
          [(weft/leaf "a" [(weft/href (show/path root))] "index")
           (weft/tx "  -  click text to edit in place  -  addresses are numbered: . is the page, 0/1 the second kid of the first")])
        (weft/el "div" [(weft/cls "lpage")]
          [(frag/mount "page" root.weld(['weft 'page]) pagep 2)])
        (toolbar pagep)]
  (weft/page "loom" loom_css
    body.weld(errrow).snoc((src_form pagep tgt src)).weld(scrub).snoc(frag/script))
+  face_talk
  '  The editor face: the index at the app root or the container,
  '  the editor for anything at or under a page.  Same responder
  '  contract as the explorer.
  \  b=bowl cur=myth nu=myth
  ^  yell
  =  out  cur.meld(nu)
  =  tgt=path
       ?>  (./some held) out.get(['vpath])
           []
       ?>  p=pails/p held
           []
       p.p
  =  view  b.crew.gut(['view] (axal/new[myth] .none))
  =  root  (root_of tgt)
  =  hubp  root.weld(['p])
  =  first  (frag/ver_nat b ['first])
  =  top  (frag/ver_nat b ['top])
  =  html
       ?  (le tgt.len hubp.len)
          =  fat
               ?  (eq tgt.len root.len)
                  view.dip(['p])
               view
          (index_page root tgt fat first top)
       =  pagep=path  tgt.take(hubp.len.inc)
       =  src
            ?  (eq tgt.len pagep.len)
               (src_of view)
            0
       =  err
            ?  (eq tgt.len pagep.len)
               (err_of view)
            0
       (edit_page root pagep tgt src err first top)
  (yell []
    out.put(['res_status] (pd 200)).put(['res_body] (pd html)).put(['res_ctype] (pd "text/html; charset=utf-8")))
+  face_form
  '  The face behavior: talk renders.
  ^  form
  def_form.set_talk(face_talk)
'  ==================================================================
'  VI.  Seeds and the manifest
'  ==================================================================
'  The home page is the app's documentation AND its demo: loom-html
'  source in the manifest, expanded into records by page_init in the
'  mount epoch, rendered by loom's own component, edited by the
'  editor it documents.  Seed sources are written in CANONICAL form,
'  so unparse of the mounted records reproduces them byte-for-byte —
'  the fixpoint holds from the first epoch.  Paths inside source
'  text are absolute (text does not rebase — the nenex wiki-link
'  precedent), so the seeds assume the default /app/loom root.
+  page_seed
  '  A seeded page-root record: the page kook (app-relative), a tag,
  '  and the starter source page_init expands.
  \  tag=nat src=nat
  ^  myth
  (kooked [(pact/rel ['kook 'page])]).put(['tag] (pails/t (str/from_atom tag))).put(['src] (pails/t (str/from_atom src)))
+  home_src
  '  The metacircular home page, as loom-html.
  ^  nat
  (bjoin_all 10
    ["<h1>loom</h1>"
     "<p>this page is namespace records: every sentence a slot you can click and retype, every element a numbered child, every revision an epoch the scrubber below replays.</p>"
     "<p>the toolbar restructures: add makes an element, retag renames one, delete culls a subtree, swap exchanges two siblings, embed mounts a component from the zoo.</p>"
     "<p>the source pane below the page is the same records as html text - edit either side and the other follows: record edits regenerate the source, a source commit re-expands the records, one transaction each way.</p>"
     "<p>a live component, transcluded from another app - the running life board, not a picture of it:</p>"
     (weft/cat ["<part" (att_src "part" "/app/life/weft/board") (att_src "data" "/app/life/board") ">"])
     "<p>and the editor eating its own tail: the about page, transcluded through the loom's own page renderer.</p>"
     (weft/cat ["<part" (att_src "part" "/app/loom/weft/page") (att_src "data" "/app/loom/p/about") ">"])
     "<p>caveats: a page transcluding itself nests without bound, and the source pane rides one request - keep a page under ~15kb of markup.</p>"])
+  about_src
  '  A second page: the swap and delete demos' safe victim, and the
  '  home page's transclusion target.
  ^  nat
  (bjoin_all 10
    ["<h2>about</h2>"
     "<p>a second page: everything the home page says about itself is true of this page too.</p>"
     "<p>swap 0 with 1 on the toolbar, watch this paragraph trade places, then scrub it back.</p>"])
+  weft_seed
  '  The page component seed — code-built: a component ctor pail
  '  cannot ride a template, and here nothing does.
  ^  [p=path t=myth]
  [['weft 'page]
   (weft_card page_view (pact/rel ['p 'home])
     (lore "The page component: a loom page's whole rendered body, a felt over the page subtree."
           ["The page component: a loom page's whole rendered body, a felt over the page subtree."
            "Input: the z view of a loom page - ['tag]/['text]/['cls]/['href]/['src]/['alt] text slots and numbered kids; a ['part]+['data] record mounts that component live over that data."
            "Output: the rendered page - text runs editable in place through w-edit, parts mounted live, tags outside the allowlist rendered as inert chips."
            "Point it at any subtree whose records fit the shape; the tag allowlist guards the markup."]
           []))]
+  app
  '  The loom app, assembled.
  ^  mani
  =  seeds=row[[p=path t=myth]]
       [[['p] (kooked [(pact/rel ['kook 'hub])])]
        [['p 'home] (page_seed "article" home_src)]
        [['p 'about] (page_seed "article" about_src)]]
  =  s2  seeds.snoc(weft_seed)
  (mani 'loom
        (lore "A metacircular HTML editor: pages are element records - rendered, restructured, sourced, and scrubbed as four views of one subtree."
              ["A metacircular HTML editor: pages are element records - rendered, restructured, sourced, and scrubbed as four views of one subtree."
               "A page at /app/loom/p/<name> is a subtree of element records (tag, text run, attrs, numbered kids); a felt component renders it, w-edit pokes text in place, toolbar ops restructure, and a loom-html source pane syncs both ways: record edits regenerate ['src], a source commit re-expands the records."
               "A ['part]+['data] record transcludes any zoo component - including the loom page renderer itself, so pages nest in pages."
               "The seeded home page is the app's documentation, kept as loom records: the editor edits the thing that documents the editor."]
              [])
        [(kook/decl 'page page_form (lore/line "One page: init expands the making card's source, talk applies structure ops and source commits, hear regenerates the source from record edits."))
         (kook/decl 'hub hub_form (lore/line "The page container: post new (and an optional stamp) to make a fresh page carrying the page kook."))
         (kook/decl 'face face_form (lore/line "The editor face: the index, then per page the live mount, the toolbar, the source pane, and the scrubber."))]
        s2
        [])
