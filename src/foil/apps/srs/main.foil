-  web [order=70]
'  srs code: the grading op, the queue view, and the face.
'  Everything declarative — roles, the tree, the seeds, the op
'  vocabulary, the view and face wiring — lives in main.grove; this
'  file is behavior only.  Grading is a WARP: the caller pokes the
'  card with the finish_card op and a transient input record (grade
'  + when); the input never lands in the namespace.
+  sched
  '  The SM-2-ish step: (grade when interval ease) -> the next
  '  [due interval ease].  Grades: 0 again, 1 hard, 2 good, 3 easy.
  '  ease rides x1000 and floors at 1300; intervals ride days; due
  '  is when + interval days (an again is due immediately).
  '  ?=  ((sched 0 100 10 2500) [100 0 2300])
  '  ?=  ((sched 3 100 0 2500) [86500 1 2650])
  \  grade=nat when=nat int0=nat ease0=nat
  ^  [due=nat interval=nat ease=nat]
  =  ease1
       ?  (eq grade 0)
          ?  (gt ease0 1500)
             (sub ease0 200)
          1300
       ?  (eq grade 3)
          (add ease0 150)
       ease0
  =  int1
       ?  (eq grade 0)
          0
       =  scaled  (div (mul int0 ease1) 1000)
       ?  (gt scaled 1)
          scaled
       1
  [(add when (mul int1 86400)) int1 ease1]
+  finish_card
  '  The grading op, warp-shaped: (input, card) -> the card with its
  '  next schedule.  The input carries ['srs 'grade] (0 again,
  '  1 hard, 2 good, 3 easy) and ['when] (the review time — the /op
  '  route stamps it with the host clock on every op input); neither
  '  is ever written — the result record is the whole story, judged
  '  by the card's adopted contract at commit.
  \  input=myth cur=myth
  ^  myth
  =  next  (sched input.nat_at(['srs 'grade] 0)
             input.nat_at(['when] 0)
             cur.nat_at(['srs 'interval] 0)
             cur.nat_at(['srs 'ease] 2500))
  =  [due1 int1 ease1]  next
  .  cur
     put(['srs 'due] (pails/n due1))
     put(['srs 'interval] (pails/n int1))
     put(['srs 'ease] (pails/n ease1))
+  next
  '  The queue view (a spun — /x runs it against the cards subtree):
  '  the due cards as numbered kids sorted by due, at most ['limit]
  '  of them, each a record carrying the card's path and its due.
  '  The view node's own record is the args channel.
  \  nm=myth fat=axal[myth]
  ^  axal[myth]
  =  limit  nm.nat_at(['limit] 10)
  =  es  fat.tap
  =  cards
       |  > i=nat 0  > acc=row[[p=path due=nat]] []
       ^  row[[p=path due=nat]]
       ?  (ge i es.len)
          acc
       =  [p t]  es.at(i)
       ?  (eq 0 p.len)
          (_ i.inc acc)
       ?  !?=((./some _) t.get(['srs 'due]))
          (_ i.inc acc)
       (_ i.inc acc.snoc([p t.nat_at(['srs 'due] 0)]))
  =  sorted
       '  selection by ascending due, capped at limit (rows have no
       '  sort method; n stays queue-sized)
       |  > src=row[[p=path due=nat]] cards
          > out=row[[p=path due=nat]] []
       ^  row[[p=path due=nat]]
       ?  ((eq 0 src.len) || (eq out.len limit))
          out
       =  besti
            |  > i=nat 1  > bi=nat 0
            ^  nat
            ?  (ge i src.len)
               bi
            =  [pa da]  src.at(i)
            =  [pb db]  src.at(bi)
            ?  (lt da db)
               (_ i.inc i)
            (_ i.inc bi)
       =  rest
            |  > k=nat 0  > acc2=row[[p=path due=nat]] []
            ^  row[[p=path due=nat]]
            ?  (ge k src.len)
               acc2
            ?  (eq k besti)
               (_ k.inc acc2)
            (_ k.inc acc2.snoc(src.at(k)))
       (_ rest out.snoc(src.at(besti)))
  =  root  (myth/new).put(['n] (pails/n sorted.len))
  |  > i=nat 0  > acc=axal[myth] (axal/new[myth] (./some root))
  ^  axal[myth]
  ?  (ge i sorted.len)
     acc
  =  [p d]  sorted.at(i)
  =  rec  (myth/new).put(['card] (pails/p p)).put(['srs 'due] (pails/n d))
  (_ i.inc acc.put([($u i)] rec))
+  grade_btn
  '  One grade submit: name srs/grade, the value the sched knows.
  \  g=nat label=nat
  ^  weft/node
  (weft/el "button"
    [(weft/att "type" "submit")
     (weft/att "name" "srs/grade")
     (weft/att "value" (weft/show_nat g))]
    [(weft/node/tx label)])
+  grade_btns
  ^  row[weft/node]
  [(grade_btn 0 "again") (grade_btn 1 "hard") (grade_btn 2 "good") (grade_btn 3 "easy")]
+  hidden_in
  \  nm=nat v=nat
  ^  weft/node
  (weft/el "input"
    [(weft/att "type" "hidden") (weft/att "name" nm) (weft/att "value" v)]
    [])
+  due_row
  '  One queue entry: the card link (the datum face renders its
  '  page), the reveal, and the grade form aimed at the card with
  '  the finish_card op.
  \  home=path opp=path key=path t=myth
  ^  weft/node
  =  cpath  home.weld(key)
  =  gf
       (weft/el "form"
         [(weft/att "method" "post")
          (weft/att "action" (weft/cat2 "/op" (show/path cpath)))]
         [(hidden_in "op" (show/path opp))
          (hidden_in "back" (show/path home))
          (weft/el "span" [] grade_btns)])
  (weft/el "div" [(weft/cls "srs-card")]
    [(weft/el "h3" []
       [(weft/el "a" [(weft/att "href" (show/path cpath))]
          [(weft/node/tx (myth/txt_at ['front] t))])])
     (weft/el "details" []
       [(weft/leaf "summary" [] "reveal")
        (weft/leaf "p" [] (myth/txt_at ['back] t))])
     gf])
+  srs_queue
  '  The root page: every due card ascending, reveal + grade in
  '  place.  Paths derive from the root's ['op] anchor (the seeded
  '  ./op/finish_card pails/p, absolute post-mount): the op card is
  '  the anchor, the app home is two segments up.
  \  fat=axal[myth] root=myth
  ^  myth
  =  opp
       ?  root.get(['op])
        > (./some pl=pail)
          ?  pl
           > x=pails/p  x.p
          []
        > .none  []
  ?  (lt opp.len 2)
     (frag/html "div" [] [(weft/leaf "p" [] "srs: no op anchor on the root")])
  =  home  opp.take(opp.len.sub(2))
  =  es  fat.tap
  =  cards
       |  > i=nat 0  > acc=row[[p=path due=nat t=myth]] []
       ^  row[[p=path due=nat t=myth]]
       ?  (ge i es.len)
          acc
       =  [p t]  es.at(i)
       ?  !(eq 2 p.len)
          (_ i.inc acc)
       ?  !(eq_iota p.at(0) 'cards)
          (_ i.inc acc)
       ?  !?=((./some _) t.get(['srs 'due]))
          (_ i.inc acc)
       (_ i.inc acc.snoc([p (myth/nat_at ['srs 'due] 0 t) t]))
  =  sorted
       |  > src=row[[p=path due=nat t=myth]] cards
          > out=row[[p=path due=nat t=myth]] []
       ^  row[[p=path due=nat t=myth]]
       ?  (eq 0 src.len)
          out
       =  besti
            |  > i=nat 1  > bi=nat 0
            ^  nat
            ?  (ge i src.len)
               bi
            =  [pa da ta]  src.at(i)
            =  [pb db tb]  src.at(bi)
            ?  (lt da db)
               (_ i.inc i)
            (_ i.inc bi)
       =  rest
            |  > k=nat 0  > acc2=row[[p=path due=nat t=myth]] []
            ^  row[[p=path due=nat t=myth]]
            ?  (ge k src.len)
               acc2
            ?  (eq k besti)
               (_ k.inc acc2)
            (_ k.inc acc2.snoc(src.at(k)))
       (_ rest out.snoc(src.at(besti)))
  =  rows
       |  > i=nat 0  > acc=row[weft/node] []
       ^  row[weft/node]
       ?  (ge i sorted.len)
          acc
       =  [p d t]  sorted.at(i)
       (_ i.inc acc.snoc((due_row home opp p t)))
  =  head
       ?  sorted.len
          (weft/leaf "h2" [] "review queue")
       (weft/leaf "h2" [] "review queue: nothing due")
  (frag/html "div" [(weft/cls "srs")] rows.cons(head))
+  srs_card
  '  One card's page: front, the reveal, and a w-op grade form —
  '  the runtime aims it at the enclosing mount's data path, so the
  '  markup needs no absolute paths at all.
  \  t=myth
  ^  myth
  =  gf
       (weft/el "form"
         [(weft/att "method" "post")
          (weft/att "action" "#")
          (weft/att "w-op" "2 op/finish_card")]
         [(hidden_in "op" "")
          (hidden_in "back" "")
          (weft/el "span" [] grade_btns)])
  (frag/html "div" [(weft/cls "srs")]
    [(weft/leaf "h2" [] (myth/txt_at ['front] t))
     (weft/el "details" []
       [(weft/leaf "summary" [] "reveal")
        (weft/leaf "p" [] (myth/txt_at ['back] t))])
     gf])
+  srs_html
  '  The srs face as a felt over whatever subtree the mount names:
  '  the app root (a 'cards kid below) renders the due queue, a
  '  single card its reveal and grade form — one .z binding on the
  '  root covers both, because the mount's data path is always the
  '  requested node.
  \  fat=axal[myth]
  ^  myth
  ?  fat.dip(['cards]).wyt
     ?  fat.fil
      > (./some rt=myth)  (srs_queue fat rt)
      > .none  (frag/html "div" [] [(weft/leaf "p" [] "srs: rootless subtree")])
  ?  fat.fil
   > (./some t=myth)
     ?  ?=((./some _) t.get(['front]))
        (srs_card t)
     ?  ?=((./some _) t.get(['about]))
        (srs_card t)
     (frag/html "div" [] [(weft/leaf "p" [] "nothing to review here")])
   > .none  (frag/html "div" [] [(weft/leaf "p" [] "nothing here")])
