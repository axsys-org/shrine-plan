-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
'  srs code: the grading op and the queue view.  Everything
'  declarative — roles, the tree, the seeds, the op vocabulary, the
'  view wiring — lives in main.grove; this file is behavior only.
'  Grading is a WARP: the caller pokes the card with the finish_card
'  op and a transient input record (grade + when); the input never
'  lands in the namespace.
+  sched
  '  The SM-2-ish step: (grade when interval ease) -> the next
  '  [due interval ease].  Grades: 0 again, 1 hard, 2 good, 3 easy.
  '  ease rides x1000 and floors at 1300; intervals ride days; due
  '  is when + interval days (an again is due immediately).
  '  ?=  ((sched 0 100 10 2500) [100 0 2300])
  '  ?=  ((sched 3 100 0 2500) [86500 1 2650])
  \  grade=nat when=nat int0=nat ease0=nat
  ^  [due=nat interval=nat ease=nat]
  =  ease1
       ?  (eq grade 0)
          ?  (gt ease0 1500)
             (sub ease0 200)
          1300
       ?  (eq grade 3)
          (add ease0 150)
       ease0
  =  int1
       ?  (eq grade 0)
          0
       =  scaled  (div (mul int0 ease1) 1000)
       ?  (gt scaled 1)
          scaled
       1
  [(add when (mul int1 86400)) int1 ease1]
+  finish_card
  '  The grading op, warp-shaped: (input, card) -> the card with its
  '  next schedule.  The input carries ['srs 'grade] (0 again,
  '  1 hard, 2 good, 3 easy) and ['srs 'when] (the review time, an
  '  epoch nat); neither is ever written — the result record is the
  '  whole story, judged by the card's adopted contract at commit.
  \  input=myth cur=myth
  ^  myth
  =  next  (sched input.nat_at(['srs 'grade] 0)
             input.nat_at(['srs 'when] 0)
             cur.nat_at(['srs 'interval] 0)
             cur.nat_at(['srs 'ease] 2500))
  =  [due1 int1 ease1]  next
  .  cur
     put(['srs 'due] (pails/n due1))
     put(['srs 'interval] (pails/n int1))
     put(['srs 'ease] (pails/n ease1))
+  next
  '  The queue view (a spun — /x runs it against the cards subtree):
  '  the due cards as numbered kids sorted by due, at most ['limit]
  '  of them, each a record carrying the card's path and its due.
  '  The view node's own record is the args channel.
  \  nm=myth fat=axal[myth]
  ^  axal[myth]
  =  limit  nm.nat_at(['limit] 10)
  =  es  fat.tap
  =  cards
       |  > i=nat 0  > acc=row[[p=path due=nat]] []
       ^  row[[p=path due=nat]]
       ?  (ge i es.len)
          acc
       =  [p t]  es.at(i)
       ?  (eq 0 p.len)
          (_ i.inc acc)
       ?  !?=((./some _) t.get(['srs 'due]))
          (_ i.inc acc)
       (_ i.inc acc.snoc([p t.nat_at(['srs 'due] 0)]))
  =  sorted
       '  selection by ascending due, capped at limit (rows have no
       '  sort method; n stays queue-sized)
       |  > src=row[[p=path due=nat]] cards
          > out=row[[p=path due=nat]] []
       ^  row[[p=path due=nat]]
       ?  ((eq 0 src.len) || (eq out.len limit))
          out
       =  besti
            |  > i=nat 1  > bi=nat 0
            ^  nat
            ?  (ge i src.len)
               bi
            =  [pa da]  src.at(i)
            =  [pb db]  src.at(bi)
            ?  (lt da db)
               (_ i.inc i)
            (_ i.inc bi)
       =  rest
            |  > k=nat 0  > acc2=row[[p=path due=nat]] []
            ^  row[[p=path due=nat]]
            ?  (ge k src.len)
               acc2
            ?  (eq k besti)
               (_ k.inc acc2)
            (_ k.inc acc2.snoc(src.at(k)))
       (_ rest out.snoc(src.at(besti)))
  =  root  (myth/new).put(['n] (pails/n sorted.len))
  |  > i=nat 0  > acc=axal[myth] (axal/new[myth] (./some root))
  ^  axal[myth]
  ?  (ge i sorted.len)
     acc
  =  [p d]  sorted.at(i)
  =  rec  (myth/new).put(['card] (pails/p p)).put(['srs 'due] (pails/n d))
  (_ i.inc acc.put([($u i)] rec))
