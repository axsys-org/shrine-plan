- view_ops
- reference_index
- lain_types

' A bounded reference perspective. Paths encode slots and authoritative names,
' so two equal display labels can never overwrite each other. Interpretation
' of those slots (insurance, suppliers, founders...) belongs to named policies.
+ view_walk
  + bind
    \ plan=view_plan next={\ axal[myth]}view_plan
    ^ view_plan
    ? plan
     > (./done tree) (next tree)
     > (./fail reason) (./fail reason)
     > (./need read resume)
       | ./need read (\ value (view_walk/bind (resume value) next))
     > (./graft source)
       | ./need (view_read source .all)
         \ value
         ?> (./known tree) value (./fail "reference unavailable")
         | next tree
  + name
    ' The name a safe reads: its path, less an /h head (/h/<care>/<case>/<len>).
    \ source=safe
    ^ path
    ? (and (is_h source.path) (ge source.path.len 4)) source.path.drop(4)
    | source.path
  + same
    \ left=safe right=safe
    ^ bool
    | and (equal[path] (view_walk/name left) (view_walk/name right)) (eq left.ver right.ver)
  + edges
    \ source=safe record=myth reverse=axal[myth]
    ^ axal[safe]
    = outgoing
        | record.tap.fold (axal/new[safe] .none)
          \ out [slot held]
          ? (pith_prefix ['sys] slot) out
          ?> target=safe held out
          = prefix=path ['out ($u slot.len)]
          | out.put prefix.weld(slot) target
    | reverse.tap.fold outgoing
      \ out [at edge]
      ?> (./some held) edge.get(['target]) out
      ?> target=safe held out
      ? !(view_walk/same source target) out
      ?> (./some held) edge.get(['holder]) out
      ?> holder=safe held out
      ?> (./some held) edge.get(['slot]) out
      ?> slot=pails/p held out
      = prefix=path ['in ($u slot.p.len)]
        owner (view_walk/name holder)
        name prefix.weld(slot.p).snoc(($u owner.len)).weld(owner)
      | out.put name holder
  + node
    \ source=safe remaining=nat trail=row[safe] cr=care relative=path select=view_select
    ^ view_plan
    = cycle (trail.any((\ visited (view_walk/same visited source))))
      here (view_ops/at source [] .x)
      projection=view_select
        ? (and (eq relative.len 0) (equal[care] cr .x)) select
        .all
    | ./need (view_read here projection)
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (./fail "record unavailable")
      ?> (./some original) tree.fil (./fail "record unavailable")
      = record original.put(['sys 'view 'origin] here)
        record (? cycle record.put(['sys 'view 'cycle] (pails/b .true)) record)
        record (? (eq remaining 0) record.put(['sys 'view 'depth_limit] (pails/b .true)) record)
        leaf (axal/new[myth] (./some record))
      ? (and (eq relative.len 0) (equal[care] cr .x)) (./done leaf)
      ? ((eq remaining 0) || cycle)
        ? (eq relative.len 0) (./done leaf)
        | ./fail "traversal boundary"
      = name (view_walk/name source)
        reverse (safe 0 .z (r_spell name))
      | ./need (view_read reverse .all)
        \ incoming=res[axal[myth]]
        ^ view_plan
        ?> (./known incoming) incoming (./fail "reference index unavailable")
        = edges (view_walk/edges source original incoming)
          selected=maybe[[safe path]]
            % width=nat relative.len
            ^ maybe[[safe path]]
            ? (edges.get(relative.take(width)))
             > (./some target) (./some [target relative.drop(width)])
            ? (eq width 0) .none
            | _ width.dec
        ? selected
         > (./some found)
           = [target suffix] found
           | view_walk/node target remaining.dec trail.snoc(source) cr suffix select
        = branch edges.dip(relative)
          is_root (eq relative.len 0)
        ? (and !is_root (eq branch.kid.size 0)) (./fail "missing branch")
        = base (? is_root leaf (axal/new[myth] (./some myth/new)))
        ? (equal[care] cr .x) (./done base)
        ' At the root, y lists relationship folders. Opening a folder reads
        ' only that folder; z explicitly requests the bounded expansion.
        ? (and is_root (equal[care] cr .y))
          = folders
              | branch.kid_tap.fold base
                \ out [direction children]
                | out.put [direction] (myth/sing ['count] (pails/n children.tap.len))
          | ./done folders
        = members branch.tap
        % i=nat 0 output=axal[myth] base
        ^ view_plan
        ? (eq i members.len) (./done output)
        = [name target] members.at(i)
          child_care=care (? (equal[care] cr .y) .x .z)
          resume (_ i.inc)
        | view_walk/bind (view_walk/node target remaining.dec trail.snoc(source) child_care [] select)
          \ child=axal[myth]
          ^ view_plan
          = merged
              | child.tap.fold output
                \ out [suffix record]
                | out.put name.weld(suffix) record
          | resume merged
  + get
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = depth (context.nat_at(['depth] 5))
    ? (gt depth 16) (./fail "depth exceeds traversal budget")
    | view_walk/node source depth [] cr relative select
