- ethereum_bytes

' Keccak-256, Ethereum padding 0x01 (not SHA3's 0x06).
' Keccak-f[1600] follows https://keccak.team/keccak_specs_summary.html.
+ ethereum_keccak
  + xor
    \ a=nat b=nat
    ^ nat
    % x=nat a y=nat b bit=nat 1 out=nat 0
    ? (and (eq x 0) (eq y 0)) out
    = different !(eq (mod x 2) (mod y 2))
    | _ (div x 2) (div y 2) (mul bit 2) (add out (? different bit 0))
  + and_bits
    \ a=nat b=nat
    ^ nat
    % x=nat a y=nat b bit=nat 1 out=nat 0
    ? ((eq x 0) || (eq y 0)) out
    = both (and (mod x 2) (mod y 2))
    | _ (div x 2) (div y 2) (mul bit 2) (add out (? both bit 0))
  + rotate
    \ n=nat count=nat
    ^ nat
    | add (mod (lsh n count) (bex 64)) (rsh n (sub 64 count))
  + offsets
    ^ row[nat]
    [0 1 62 28 27 36 44 6 55 20 3 10 43 25 39 41 45 15 21 8 18 2 61 56 14]
  + round
    \ state=row[nat] constant=nat
    ^ row[nat]
    = columns
        | (ethereum_bytes/range 5).map
          \ x=nat
          | (ethereum_bytes/range 5).fold 0
            \ c=nat y=nat
            | ethereum_keccak/xor c state.at((add x (mul 5 y)))
      theta
        | (ethereum_bytes/range 25).map
          \ i=nat
          = x (mod i 5)
            d (ethereum_keccak/xor columns.at((mod (add x 4) 5))
                (ethereum_keccak/rotate columns.at((mod x.inc 5)) 1))
          | ethereum_keccak/xor state.at(i) d
      rotated
        | (ethereum_bytes/range 25).fold (ethereum_bytes/zeroes 25)
          \ out=row[nat] i=nat
          = x (mod i 5) y (div i 5)
            at (add y (mul 5 (mod (add (mul 2 x) (mul 3 y)) 5)))
          | ethereum_bytes/put at (ethereum_keccak/rotate theta.at(i) (ethereum_keccak/offsets).at(i)) out
      chi
        | (ethereum_bytes/range 25).map
          \ i=nat
          = x (mod i 5) y (mul 5 (div i 5))
            b rotated.at((add y (mod x.inc 5)))
            c rotated.at((add y (mod (add x 2) 5)))
          | ethereum_keccak/xor rotated.at(i) (ethereum_keccak/and_bits (sub (dec (bex 64)) b) c)
    | ethereum_bytes/put 0 (ethereum_keccak/xor chi.at(0) constant) chi
  + permutation
    \ state=row[nat]
    ^ row[nat]
    | row/fold[nat row[nat]] state ethereum_keccak/round ethereum_keccak/constants
  + digest
    \ input=row[nat]
    ^ row[nat]
    ? !(input.all((\ b=nat (lt b 256)))) (ethereum_bytes/fail "invalid Keccak byte")
    = padding (sub 136 (mod input.len 136))
      padded
        ? (eq padding 1) input.snoc(129)
        | input.snoc(1).weld((ethereum_bytes/zeroes (sub padding 2))).snoc(128)
      state
        % offset=nat 0 state=row[nat] (ethereum_bytes/zeroes 25)
        ? (eq offset padded.len) state
        = block
            | (ethereum_bytes/range 25).map
              \ i=nat
              ? (ge i 17) state.at(i)
              | ethereum_keccak/xor state.at(i)
                (ethereum_bytes/little padded.drop((add offset (mul 8 i))).take(8))
        | _ (add offset 136) (ethereum_keccak/permutation block)
    | row/fold[nat row[nat]] []
      (\ out=row[nat] lane=nat out.weld((ethereum_bytes/big 8 lane).rev)) state.take(4)
  + hex
    \ input=row[nat]
    ^ str
    | ethereum_bytes/hex (ethereum_keccak/digest input)
  + constants
    ^ row[nat]
    [1 32898 9223372036854808714 9223372039002292224 32907 2147483649 9223372039002292353 9223372036854808585 138 136 2147516425 2147483658 2147516555 9223372036854775947 9223372036854808713 9223372036854808579 9223372036854808578 9223372036854775936 32778 9223372039002259466 9223372039002292353 9223372036854808704 2147483649 9223372039002292232]
