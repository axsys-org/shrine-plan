- sept
'  Typed Rex trees share their representation with the native parser/compiler.
+ rex
  + make_span
    \ line=nat column=nat offset=nat length=nat
    ^ rex/source_span
    [line column offset length]
  + zero_span
    ^ rex/source_span
    [0 0 0 0]
  + source_span
    + line
      \ span=rex/source_span
      ^ nat
      = [line column offset length] span
      line
    + column
      \ span=rex/source_span
      ^ nat
      = [line column offset length] span
      column
    + offset
      \ span=rex/source_span
      ^ nat
      = [line column offset length] span
      offset
    + length
      \ span=rex/source_span
      ^ nat
      = [line column offset length] span
      length
  + leaf
    \ span=rex/source_span shape=any text=str
    ^ rex
    | ./leaf span shape text
  + nest
    \ span=rex/source_span color=str rune=str kids=row[rex]
    ^ rex
    | ./nest span color rune kids
  + expr
    \ span=rex/source_span color=str kids=row[rex]
    ^ rex
    | ./expr span color kids
  + pref
    \ span=rex/source_span rune=str kid=rex
    ^ rex
    | ./pref span rune kid
  + tyte
    \ span=rex/source_span rune=str kids=row[rex]
    ^ rex
    | ./tyte span rune kids
  + bloc
    \ span=rex/source_span color=str rune=str head=rex items=row[rex]
    ^ rex
    | ./bloc span color rune head items
  + open
    \ span=rex/source_span rune=str kids=row[rex]
    ^ rex
    | ./open span rune kids
  + juxt
    \ span=rex/source_span kids=row[rex]
    ^ rex
    | ./juxt span kids
  + heir
    \ span=rex/source_span kids=row[rex]
    ^ rex
    | ./heir span kids
  + parse_normalized
    \ text=str
    ^ either[any rex]
    < tree (rex/parse text)
    | ./ok (rex/normalize tree)
  + span
    \ tree=rex
    ^ rex/source_span
    ? tree
     > (./leaf span shape text) span
     > (./nest span color rune kids) span
     > (./expr span color kids) span
     > (./pref span rune kid) span
     > (./tyte span rune kids) span
     > (./bloc span color rune head items) span
     > (./open span rune kids) span
     > (./juxt span kids) span
     > (./heir span kids) span
  + with_span
    \ next=rex/source_span tree=rex
    ^ rex
    ? tree
     > (./leaf span shape text) (./leaf next shape text)
     > (./nest span color rune kids) (./nest next color rune kids)
     > (./expr span color kids) (./expr next color kids)
     > (./pref span rune kid) (./pref next rune kid)
     > (./tyte span rune kids) (./tyte next rune kids)
     > (./bloc span color rune head items) (./bloc next color rune head items)
     > (./open span rune kids) (./open next rune kids)
     > (./juxt span kids) (./juxt next kids)
     > (./heir span kids) (./heir next kids)
  + children
    \ tree=rex
    ^ row[rex]
    ? tree
     > (./leaf span shape text) []
     > (./nest span color rune kids) kids
     > (./expr span color kids) kids
     > (./pref span rune kid) [kid]
     > (./tyte span rune kids) kids
     > (./bloc span color rune head items) items.cons(head)
     > (./open span rune kids) kids
     > (./juxt span kids) kids
     > (./heir span kids) kids
  + map_children
    \ fun={\ rex}rex tree=rex
    ^ rex
    ? tree
     > (./leaf span shape text) (./leaf span shape text)
     > (./nest span color rune kids) (./nest span color rune kids.map(fun))
     > (./expr span color kids) (./expr span color kids.map(fun))
     > (./pref span rune kid) (./pref span rune (fun kid))
     > (./tyte span rune kids) (./tyte span rune kids.map(fun))
     > (./bloc span color rune head items) (./bloc span color rune (fun head) items.map(fun))
     > (./open span rune kids) (./open span rune kids.map(fun))
     > (./juxt span kids) (./juxt span kids.map(fun))
     > (./heir span kids) (./heir span kids.map(fun))
  + walk
    '  Bottom-up: rewrite each original node once, never descend into replacements.
    \ fun={\ rex}rex tree=rex
    ^ rex
    = step | _ fun
    | fun tree.map_children(step)
  + fold
    (@ value)
    \ fun={\ rex row[value]}value tree=rex
    ^ value
    = step | _ fun
    | fun tree tree.children.map(step)
  + strip_spans
    \ tree=rex
    ^ rex
    | tree.walk (rex/with_span rex/zero_span)
  + is_normalized
    \ tree=rex
    ^ bool
    ? tree
     > (./leaf span shape text) .true
     > (./nest span color rune kids) (eq 0 (row/any[rex] (\ kid (eq 0 (rex/is_normalized kid))) kids))
     > (./juxt span kids) (eq 0 (row/any[rex] (\ kid (eq 0 (rex/is_normalized kid))) kids))
    .false
  + leaf_kind
    '  The native leaf spelling category, absent for non-leaves or bad literals.
    \ tree=rex
    ^ maybe[str]
    > (./leaf span shape text) tree
      .none
    | rex/shape_kind shape
  + leaf_error
    '  Recoverable literal error, distinct from a fatal parse failure.
    \ tree=rex
    ^ maybe[str]
    > (./leaf span shape text) tree
      .none
    | rex/shape_error shape
  + word
    '  ?=  ((rex/print (rex/word "hello")) "hello")
    \ text=str
    ^ rex
    | rex/leaf rex/zero_span "word" text
  + cord
    \ text=str
    ^ rex
    | rex/leaf rex/zero_span "cord" text
  + quip
    \ text=str
    ^ rex
    | rex/leaf rex/zero_span "quip" text
  + slug
    \ text=str
    ^ rex
    | rex/leaf rex/zero_span "slug" text
  + rune
    \ mark=str kids=row[rex]
    ^ rex
    | rex/nest rex/zero_span "clear" mark kids
  + paren
    \ kids=row[rex]
    ^ rex
    | rex/nest rex/zero_span "paren" "" kids
  + brack
    \ kids=row[rex]
    ^ rex
    | rex/nest rex/zero_span "brack" "" kids
  + curly
    \ kids=row[rex]
    ^ rex
    | rex/nest rex/zero_span "curly" "" kids
  + juxtapose
    \ kids=row[rex]
    ^ rex
    | rex/juxt rex/zero_span kids
  + group
    \ kids=row[rex]
    ^ rex
    ? (eq kids.len 1) kids.at(0)
    | rex/rune "" kids
  + path
    \ parts=row[str]
    ^ rex
    | rex/rune "/" parts.map(rex/word)
  + dot
    '  ?=  ((rex/children (rex/dot (rex/word "b") (rex/word "a"))).len 2)
    '  Append one segment, flattening an existing clear dotted chain.
    \ next=rex tree=rex
    ^ rex
    ? tree
     > (./nest span color rune kids)
      ? (eq color "clear")
        ? (eq rune ".") (rex/rune "." kids.snoc(next))
        (rex/rune "." [tree next])
      (rex/rune "." [tree next])
    | rex/rune "." [tree next]
