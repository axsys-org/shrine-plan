  +  sing
    \ key=k val=v
    ^ mop[k v lt]
    | mop/n[k v lt] key val (mop/empty) (mop/empty)
  +  rot_l
    \ key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^ mop[k v lt]
    > n=mop/node[k v lt] r
     | mop/n[k v lt] key val l r
    | mop/n[k v lt] n.key n.val
     | mop/n[k v lt] key val l n.l
    n.r
  +  rot_r
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    > n=mop/node[k v lt] l
     | mop/n[k v lt] key val l r
    | mop/n[k v lt] n.key n.val n.l
    | mop/n[k v lt] key val n.r r
  +  rot_ll
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    > n=mop/node[k v lt] r
     | mop/n[k v lt] key val l r
    > m=mop/node[k v lt] n.l
     | mop/rot_l[k v lt] key val l r
    | mop/n[k v lt] m.key m.val
     | mop/n[k v lt] key val l m.l
    | mop/n[k v lt] n.key n.val m.r n.r
  +  rot_rr
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    > n=mop/node[k v lt] l
     | mop/n[k v lt] key val l r
    > m=mop/node[k v lt] n.r
     | mop/rot_r[k v lt] key val l r
    | mop/n[k v lt] m.key m.val
     | mop/n[k v lt] n.key n.val n.l m.l
    | mop/n[k v lt] key val m.r r
  +  rotate_l
    \ key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^ mop[k v lt]
    > n=mop/node[k v lt] r
     | mop/n[k v lt] key val l r
    ? n.l.size.lt(n.r.size.mul(2))
     | mop/rot_l[k v lt] key val l r
    | mop/rot_ll[k v lt] key val l r
  +  rotate_r
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    > n=mop/node[k v lt] l
     | mop/n[k v lt] key val l r
    ? n.r.size.lt(n.l.size.mul(2))
     | mop/rot_r[k v lt] key val l r
    | mop/rot_rr[k v lt] key val l r
  +  balance
    \ key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^ mop[k v lt]
    ? | le l.size.add(r.size) 1
     | mop/n[k v lt] key val l r
    ? | ge r.size (mul 4 l.size)
     | mop/rotate_l[k v lt] key val l r
    ? | ge l.size (mul 4 r.size)
     | mop/rotate_r[k v lt] key val l r
