  '  The ordering constant for path-keyed /mop instantiations.
  '  ?=  ((lt_pith ['a] ['a 'b]) 1)
  '  ?=  ((lt_pith ['a] ['a]) 0)
  '  ?=  ((lt_pith ['a 'b] ['a]) 0)
  \  a=path b=path
  ^  nat
  ?  (eq_pith a b)
     0
  (lte_pith a b)
