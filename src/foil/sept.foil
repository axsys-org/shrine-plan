   > ($dr x=nat)  "dr"
   > ($ds x=nat)  "ds"
   > ($f x=nat)   "f"
   > ($r x=nat)   "r"
   > ($rd x=nat)  "rd"
   > ($rs x=nat)  "rs"
   > ($s x=nat)   "s"
   > ($ta x=nat)  "ta"
   > ($ts x=nat)  "ts"
   > ($tu x=nat)  "tu"
   > ($u x=nat)   "u"
   > ($w x=nat)   "w"
   > ($x x=nat)   "x"
