    '  Insert entries in order; later values replace earlier equal keys.
    \ entries=row[[key=k value=v]] m=mop[k v lt]
    ^ mop[k v lt]
    | entries.fold m
    \ acc [key value] acc.put(key value)
  +  get
    '  The value at a key, or .none.
    \ key=k a=mop[k v lt]
    ^ maybe[v]
    > n=mop/node[k v lt] a
     .none
    ? | lt key n.key
     | _ key n.l
    ? | lt n.key key
     | _ key n.r
    | ./some n.val
  +  gut
    ' Lookup with a default.
    \ key=k def=v a=mop[k v lt]
    ^  v
    a.get(key).fall(def)
  +  has
    \ key=k a=mop[k v lt]
    ^ bool
    ?=((./some _) a.get(key))
  +  tap
    '  Every entry, in ascending key order.
    \ a=mop[k v lt]
    ^ row[mop/kv[k v]]
    > n=mop/node[k v lt] a
     []
    = lo  | _ n.l
      hi  | _ n.r
      kv  | mop/kv[k v] n.key n.val
    lo.weld(hi.cons(kv))
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \ meg={\ k v v}v b=mop[k v lt] a=mop[k v lt]
    ^ mop[k v lt]
    | b.tap.fold a
    \ acc [key new]
    | acc.put key
    > (./some old) acc.get(key)
     new
    | meg key old new
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=mop[k v lt] a=mop[k v lt]
    ^  mop[k v lt]
    a.uno(keep_new[k v] b)
  +  filter
    '  Keep entries selected by key and value; rebuild in key order.
    \ pred={\ k v}bool tree=mop[k v lt]
    ^ mop[k v lt]
    | tree.tap.fold (mop/empty)
    \ acc ent
