- sys/types
' Private ordered history storage; public foundations are defined in sys/types.
+  uon
  '  An ordered map from iota to v, using the strict /lt_iota order.
  '  Size-balanced binary-search-tree internals (the bst.foil scheme).
  (@@ v)
  & uon/empty
    uon/node[v]
  +  empty
    :
  +  node
    :  sz=nat key=iota val=v l=uon[v] r=uon[v]
  +  kv
    '  One entry, as /uon/tap returns them.
    :  key=iota val=v
  +  size
    '  Number of entries; reads the cached sz.
    '  ?=  ((uon/size[nat] (uon/empty)) 0)
    \ t=uon[v]
    ^ nat
    > n=uon/node[v] t
     0
    n.sz
  +  n
    '  Node builder: recomputes the size cache.
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    | uon/node[v] l.size.inc.add(r.size)
      key val l r
  +  from_keys
    '  Build an index with one shared value; repeated keys collapse.
    \  value=v keys=row[iota]
    ^  uon[v]
    |  keys.fold (uon/empty)
    \  acc key
    acc.put(key value)
  +  sing
    '  ?=  ((uon/size[nat] (uon/sing[nat] '1 10)) 1)
    \ key=iota val=v
    ^ uon[v]
    | uon/n[v] key val  ' key val'
     (uon/empty) (uon/empty) ' l r
  +  rot_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  r
     | uon/n[v] key val
       l r
    | uon/n[v] n.key n.val
     | uon/n[v] key val l n.l
     n.r
  +  rot_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  l
      | uon/n[v] key val
        l r
    | uon/n[v] n.key n.val
      n.l
      | uon/n[v] key val n.r r
  +  rot_ll
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v]  r
     (uon/n[v] key val l r)
    > m=uon/node[v]  n.l
     (uon/rot_l[v] key val l r)
    | uon/n[v] m.key m.val
      | uon/n[v] key val l m.l
      | uon/n[v] n.key n.val m.r n.r
  +  rot_rr
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    > m=uon/node[v] n.r
     | uon/rot_r[v] key val l r
    | uon/n[v] m.key m.val
     | uon/n[v] n.key n.val n.l m.l
    | uon/n[v] key val m.r r
  +  rotate_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] r
     | uon/n[v] key val l r
    ? | lt n.l.size n.r.size.mul(2)
     | uon/rot_l[v] key val l r
    | uon/rot_ll[v] key val l r
  +  rotate_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    ? | lt n.r.size n.l.size.mul(2)
     | uon/rot_r[v] key val l r
    | uon/rot_rr[v] key val l r
  +  balance
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    ? | le l.size.add(r.size) 1
     | uon/n[v] key val l r
    ? | ge r.size (mul 4 l.size)
     | uon/rotate_l[v] key val l r
    ? | ge l.size (mul 4 r.size)
     | uon/rotate_r[v] key val l r
    | uon/n[v] key val l r
  +  put
    '  Ordered insert, replacing an existing key.
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 10 (uon/empty))) 10)
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 99 (uon/put[nat] '1 10 (uon/empty)))) 99)
    \  key=iota val=v a=uon[v]
    ^  uon[v]
    > n=uon/node[v] a
     | uon/sing[v] key val
    ? | lt_iota key n.key
     | uon/balance[v] n.key n.val (_ key val n.l) n.r
    ? | lt_iota n.key key
     | uon/balance[v] n.key n.val n.l (_ key val n.r)
    | uon/n[v] key val n.l n.r
  +  get
    '  The value at a key, or .none.
    \  key=iota a=uon[v]
    ^  maybe[v]
    >  n=uon/node[v] a
     .none
    ?  (lt_iota key n.key)
     | _ key n.l
    ?  (lt_iota n.key key)
     | _ key n.r
    | ./some n.val
  +  gut
    '  Lookup with a default.
    '  ?=  ((uon/gut[nat] '9 42 (uon/empty)) 42)
    \  key=iota def=v a=uon[v]
    ^  v
    a.get(key).fall(def)
  +  has
    \ key=iota a=uon[v]
    ^ bool
    a.get(key).is_some
  +  gas
    '  Insert a row of entries.
    \ b=row[uon/kv[v]] a=uon[v]
    ^ uon[v]
    | b.fold a
    \ acc [key val]
    acc.put(key val)
  +  tap
    '  Every entry, in ascending key order.
    \  a=uon[v]
    ^  row[uon/kv[v]]
    > n=uon/node[v] a
     []
    = l  | _ n.l
      r  | _ n.r
      kv | uon/kv[v] n.key n.val
    l.weld(r.cons(kv))
  +  keys
    '  Ascending keys.
    \ a=uon[v]
    ^ path
    | a.tap.fold []
    \ acc [key _] acc.snoc(key)
  +  vals
    '  Values in ascending key order.
    \  a=uon[v]
    ^  row[v]
    | a.tap.fold []
    \ acc [_ val] acc.snoc(val)
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \ meg={\ iota v v}v b=uon[v] a=uon[v]
    ^ uon[v]
    | b.tap.fold a
    \ acc [key new]
    | acc.put key
    > (./some old) acc.get(key)
     new
    | meg key old new
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=uon[v] a=uon[v]
    ^  uon[v]
    a.uno(take_new[v] b)
  +  nip
    '  Merge two trees whose key ranges are disjoint.
    \  l=uon[v] r=uon[v]
    ^  uon[v]
    l.uni(r)
  +  del2
    '  Delete a key, returning just the remaining tree.
    \  key=iota a=uon[v]
    ^  uon[v]
    > n=uon/node[v] a
     | uon/empty
    ? | lt_iota key n.key
     | uon/balance[v] n.key n.val (_ key n.l) n.r
    ? | lt_iota n.key key
     | uon/balance[v] n.key n.val n.l | _ key n.r
    | uon/nip[v] n.l n.r
  +  floor
    '  The greatest entry at or below a key, if any.
    '  ?=  ((maybe/is_some (uon/floor[nat] '5 (uon/empty))) .false)
    \  key=iota a=uon[v]
    ^  maybe[[k=iota val=v]]
    > n=uon/node[v] a
     .none
    ? | lt_iota key n.key
     | _ key n.l
    > (./some e) | _ key n.r
     | ./some [n.key n.val]
    | ./some e
  +  del
    '  Delete a key: the deleted value (if any) and the remaining
    '  tree, as an anonymous row.
    \  key=iota a=uon[v]
    ^  [found=maybe[v] rest=uon[v]]
    [a.get(key) a.del2(key)]
  +  run
    '  Map a function over the values.
    (@ w)
    \  fun={\ v}w a=uon[v]
    ^  uon[w]
    > n=uon/node[v] a
     uon/empty
    | uon/node[w] n.sz n.key | fun n.val
     | _ fun n.l
    | _ fun n.r

  +  apt_in
    '  Order + size-cache invariant, with open bounds.
    \  lo=maybe[iota] hi=maybe[iota] a=uon[v]
    ^  bool
    > n=uon/node[v] a
     .true
    ?  !(lt_bound lo n.key)
     .false
    ?  !(gt_bound hi n.key)
     .false
    ?  !(eq n.sz n.l.size.inc.add(n.r.size))
     .false
    ?  !(_ lo (./some n.key) n.l)
     .false
    | _ | ./some n.key
      hi n.r
  +  apt
    '  The order and size-cache invariant check.
    '  ?=  ((uon/apt[nat] (uon/empty)) 1)
    \  a=uon[v]
    ^  bool
    a.apt_in(.none .none)
