    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 10 (uon/empty))) 10)
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 99 (uon/put[nat] '1 10 (uon/empty)))) 99)
