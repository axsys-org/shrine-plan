  '  ?=  ((lte_iota '1 '2) 1)
  '  ?=  ((lte_iota 'bar 'foo) 1)
  '  ?=  ((lte_iota 'foo '1) 1)
  '  ?=  ((lte_iota '1 'foo) 0)
  \  a=quip b=quip
  ^  nat
  (lte_dime a b)
+  lt_iota
  '  Strict version of /lte_iota .
  \  a=quip b=quip
  ^  nat
  ?  (eq_iota a b)
