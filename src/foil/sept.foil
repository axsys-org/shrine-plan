'  sept: the namespace data structures — an ordered map (/uon) and a
'  recursive path-tree (/axal).
'  .
'  An iota is one path segment: the builtin quip aura-sum.  A path
'  (pith) is a row of iotas: the /path alias.  /uon maps iotas to
'  values, ordered by /lte_iota (size-balanced binary search tree
'  internals, the bst.foil scheme); entries come back in key order.
'  /axal is a tree addressed by paths: each node holds an optional
'  value (fil) and an ordered map of children (kid) — the kid map is
'  /uon instantiated at the axal type itself.

+  maybe
  '  An optional value: .some or .none.
  (@@ v)
  &  maybe/some[v]
     maybe/none
  +  some
    :  u=v
  +  none
    :
  +  fall
    '  Unwrap, or the default when none.
    '  ?=  ((maybe/fall[nat] 7 .none) 7)
    '  ?=  ((maybe/fall[nat] 7 (./some 3)) 3)
    \  def=v m=maybe[v]
    ^  v
    ?  m
     > (./some x=v)  x
     > .none  def
  +  or
    '  The receiver if present, else the argument: p.or(q).
    \  q=maybe[v] p=maybe[v]
    ^  maybe[v]
    ?  p
     > (./some a)  p
     > .none  q
  +  run
    '  Map a function over an option.
    (@ w)
    \  fun={v; w} m=maybe[v]
    ^  maybe[w]
    ?  m
     > (./some x)  (./some (fun x))
     > .none  .none
+  row
  '  Combinators over the builtin row.  A member-only decl: the
  '  builtin type keeps its representation and method set; UFCS
  '  resolves .fold and friends here.
  +  fold
    '  Left fold.
    '  ?=  ((row/fold[nat nat] 0 add [1 2 3]) 6)
    (@ v w)
    \  z=w f={w; v; w} xs=row[v]
    ^  w
    |  > i=nat 0
       > acc=w z
    ?  (eq i xs.len)
       acc
    (_ i.inc (f acc xs.at(i)))
  +  any
    '  Does f hold somewhere?  Truthy, short-circuiting.
    '  ?=  ((row/any[nat] (lt 2) [1 3]) 1)
    (@ v)
    \  f={v; bool} xs=row[v]
    ^  bool
    |  > i=nat 0
    ?  (eq i xs.len)
       .false
    ?  (f xs.at(i))
       .true
    (_ i.inc)
  +  all
    '  Does f hold everywhere?  Truthy, short-circuiting.
    '  ?=  ((row/all[nat] (lt 0) [1 2]) 1)
    (@ v)
    \  f={v; bool} xs=row[v]
    ^  bool
    |  > i=nat 0
    ?  (eq i xs.len)
       .true
    ?  (f xs.at(i))
       (_ i.inc)
    .false
  +  pull
    '  The head and the rest, or none when empty.
    '  ?=  ((row/pull[nat] []) (maybe/none))
    (@ v)
    \  xs=row[v]
    ^  maybe[[h=v t=row[v]]]
    ?  (eq 0 xs.len)
       .none
    (./some [xs.at(0) xs.drop(1)])

+  path
  '  A path: a row of iotas addressing a namespace node.  A type
  '  alias — the runtime rep IS row[quip], and the full row method
  '  set (.size, .drop, .weld, ..) applies.
  row[quip]
  +  unders
    '  The strict prefixes, shortest first ([] included, pax not).
    \  pax=path
    ^  row[path]
    |  > i=nat 0
       > acc=row[path] []
    ?  (eq i pax.len)
       acc
    (_ i.inc acc.snoc(pax.take(i)))

+  take_new
  '  Merge gate that keeps the incoming value (right bias).
  (@ v)
  \  k=quip old=v new=v
  ^  v
  new

+  keep_new
  '  Merge gate that keeps the incoming value, for any key type.
  (@ k v)
  \  key=k old=v new=v
  ^  v
  new
+  aura_rank
  '  The eight quip auras ranked in byte-lexicographic order of their
  '  names — the aura half of /lte_dime .
  '  ?=  ((aura_rank 'foo) 3)
  '  ?=  ((aura_rank '5) 5)
  \  i=quip
  ^  nat
  ?  i
   > ($ds x=nat)  0
   > ($r x=nat)   1
   > ($ta x=nat)  2
   > ($ts x=nat)  3
   > ($tu x=nat)  4
   > ($u x=nat)   5
   > ($w x=nat)   6
   > ($x x=nat)   7
+  quip_val
  '  The payload atom of a quip, whatever its aura.
  \  i=quip
  ^  nat
  ?  i
   > ($ds x=nat)  x
   > ($r x=nat)   x
   > ($ta x=nat)  x
   > ($ts x=nat)  x
   > ($tu x=nat)  x
   > ($u x=nat)   x
   > ($w x=nat)   x
   > ($x x=nat)   x
+  is_text
  '  Text auras compare byte-lexicographically, not numerically.
  \  i=quip
  ^  bool
  ?  i
   > ($ta x=nat)  .true
   > ($ts x=nat)  .true
   > ($tu x=nat)  .true
  .false

+  lte_str
  '  Byte-lexicographic compare of two LE-packed strings.  Numeric
  '  compare is wrong here ("b" < "aa" as nats).
  '  ?=  ((lte_str 24929 98) 1)
  \  a=nat b=nat
  ^  bool
  ?  (eq a b)
     .true
  ?  (eq a 0)
     .true
  ?  (eq b 0)
     .false
  ?  (lt (mod a 256) (mod b 256))
     .true
  ?  (lt (mod b 256) (mod a 256))
     .false
  (_ (div a 256) (div b 256))
+  lte_dime
  '  Total order on quips: differing auras order by aura name (the
  '  rank), same aura by payload — text auras lexicographically, the
  '  rest numerically.
  \  a=quip b=quip
  ^  bool
  ?  (eq (aura_rank a) (aura_rank b))
     ?  (is_text a)
        (lte_str (quip_val a) (quip_val b))
     (le (quip_val a) (quip_val b))
  (le (aura_rank a) (aura_rank b))
+  eq_iota
  '  Deep quip equality.  The eq builtin is PLAN Eq, which is shallow
  '  on structured values — two quips with the same aura compare equal
  '  regardless of payload — so equality goes rank-then-payload.
  \  a=quip b=quip
  ^  bool
  ?  (eq (aura_rank a) (aura_rank b))
     (eq (quip_val a) (quip_val b))
  .false
+  lte_iota
  '  The key order of /uon : /lte_dime , which is 1 for a quip
  '  against itself.
  '  ?=  ((lte_iota '1 '2) 1)
  '  ?=  ((lte_iota 'bar 'foo) 1)
  '  ?=  ((lte_iota 'foo '1) 1)
  '  ?=  ((lte_iota '1 'foo) 0)
  \  a=quip b=quip
  ^  bool
  (lte_dime a b)
+  lt_iota
  '  Strict version of /lte_iota .
  \  a=quip b=quip
  ^  bool
  ?  (eq_iota a b)
     .false
  (lte_iota a b)
+  lt_bound
  '  Is the (optional) lower bound strictly below the key?
  \  b=maybe[quip] key=quip
  ^  bool
  ?  b
   > (./some x)  (lt_iota x key)
   > .none  .true
+  gt_bound
  '  Is the key strictly below the (optional) upper bound?
  \  b=maybe[quip] key=quip
  ^  bool
  ?  b
   > (./some x)  (lt_iota key x)
   > .none  .true
+  lte_pith
  '  Lexicographic order on piths: a prefix precedes its extensions;
  '  otherwise the first differing iota decides.  Note pre-order
  '  /axal/tap (parent first, kids ascending) emits piths in exactly
  '  this order.
  '  ?=  ((lte_pith ['a] ['a 'b]) 1)
  '  ?=  ((lte_pith ['a 'b] ['a]) 0)
  '  ?=  ((lte_pith ['a 'b] ['a 'c]) 1)
  '  ?=  ((lte_pith [] ['a]) 1)
  \  a=path b=path
  ^  bool
  |  > i=nat 0
  ?  (eq i a.len)
     .true
  ?  (eq i b.len)
     .false
  =  x a.at(i)
  =  y b.at(i)
  ?  (lt_iota x y)
     .true
  ?  (lt_iota y x)
     .false
  (_ i.inc)
+  eq_pith
  '  Deep pith equality.
  '  ?=  ((eq_pith ['a 'b] ['a 'b]) 1)
  '  ?=  ((eq_pith ['a] ['a 'b]) 0)
  \  a=path b=path
  ^  bool
  ?  !(eq a.len b.len)
     .false
  |  > i=nat 0
  ?  (eq i a.len)
     .true
  ?  (eq_iota a.at(i) b.at(i))
     (_ i.inc)
  .false
+  pith_prefix
  '  Is a a prefix of b?  Reflexive: a pith is its own prefix.
  '  ?=  ((pith_prefix ['a] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'b] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'c] ['a 'b 'd]) 0)
  \  a=path b=path
  ^  bool
  ?  (gt a.len b.len)
     .false
  |  > i=nat 0
  ?  (eq i a.len)
     .true
  ?  (eq_iota a.at(i) b.at(i))
     (_ i.inc)
  .false
+  lt_pith
  '  Strict lexicographic order on piths: /lte_pith and not equal.
  '  The ordering constant for path-keyed /mop instantiations.
  '  ?=  ((lt_pith ['a] ['a 'b]) 1)
  '  ?=  ((lt_pith ['a] ['a]) 0)
  '  ?=  ((lt_pith ['a 'b] ['a]) 0)
  \  a=path b=path
  ^  bool
  ?  (eq_pith a b)
     .false
  (lte_pith a b)
+  uon
  '  An ordered map from iota (quip) to v, ordered by /lte_iota .
  '  Size-balanced binary-search-tree internals (the bst.foil scheme).
  (@@ v)
  &  uon/empty
     uon/node[v]
  +  empty
    :
  +  node
    :  sz=nat key=quip val=v l=uon[v] r=uon[v]
  +  kv
    '  One entry, as /uon/tap returns them.
    :  key=quip val=v
  +  size
    '  Number of entries; reads the cached sz.
    '  ?=  ((uon/size[nat] (uon/empty)) 0)
    \  t=uon[v]
    ^  nat
    ?  t
     > uon/empty  0
     > n=uon/node[v] n.sz
  +  n
    '  Node builder: recomputes the size cache.
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    (uon/node[v] l.size.inc.add(r.size) key val l r)
  +  sing
    '  ?=  ((uon/size[nat] (uon/sing[nat] '1 10)) 1)
    \  key=quip val=v
    ^  uon[v]
    (uon/n[v] key val (uon/empty) (uon/empty))
  +  rot_l
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  r
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v] (uon/n[v] n.key n.val (uon/n[v] key val l n.l) n.r)
  +  rot_r
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  l
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v] (uon/n[v] n.key n.val n.l (uon/n[v] key val n.r r))
  +  rot_ll
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  r
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v]
       ?  n.l
        > uon/empty  (uon/rot_l[v] key val l r)
        > m=uon/node[v] (uon/n[v] m.key m.val (uon/n[v] key val l m.l) (uon/n[v] n.key n.val m.r n.r))
  +  rot_rr
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  l
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v]
       ?  n.r
        > uon/empty  (uon/rot_r[v] key val l r)
        > m=uon/node[v] (uon/n[v] m.key m.val (uon/n[v] n.key n.val n.l m.l) (uon/n[v] key val m.r r))
  +  rotate_l
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  r
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v]
       ?  (lt n.l.size n.r.size.mul(2))
          (uon/rot_l[v] key val l r)
       (uon/rot_ll[v] key val l r)
  +  rotate_r
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  l
     > uon/empty  (uon/n[v] key val l r)
     > n=uon/node[v]
       ?  (lt n.r.size n.l.size.mul(2))
          (uon/rot_r[v] key val l r)
       (uon/rot_rr[v] key val l r)
  +  balance
    \  key=quip val=v l=uon[v] r=uon[v]
    ^  uon[v]
    ?  (le l.size.add(r.size) 1)
       (uon/n[v] key val l r)
    ?  (ge r.size (mul 4 l.size))
       (uon/rotate_l[v] key val l r)
    ?  (ge l.size (mul 4 r.size))
       (uon/rotate_r[v] key val l r)
    (uon/n[v] key val l r)
  +  put
    '  Ordered insert, replacing an existing key.
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 10 (uon/empty))) 10)
    '  ?=  ((uon/gut[nat] '1 0 (uon/put[nat] '1 99 (uon/put[nat] '1 10 (uon/empty)))) 99)
    \  key=quip val=v a=uon[v]
    ^  uon[v]
    ?  a
     > uon/empty  (uon/sing[v] key val)
     > n=uon/node[v]
       ?  (lt_iota key n.key)
          (uon/balance[v] n.key n.val (_ key val n.l) n.r)
       ?  (lt_iota n.key key)
          (uon/balance[v] n.key n.val n.l (_ key val n.r))
       (uon/n[v] key val n.l n.r)
  +  get
    '  The value at a key, or .none.
    \  key=quip a=uon[v]
    ^  maybe[v]
    ?  a
     > uon/empty  .none
     > n=uon/node[v]
       ?  (lt_iota key n.key)
          (_ key n.l)
       ?  (lt_iota n.key key)
          (_ key n.r)
       (./some n.val)
  +  gut
    '  Lookup with a default.
    '  ?=  ((uon/gut[nat] '9 42 (uon/empty)) 42)
    \  key=quip def=v a=uon[v]
    ^  v
    a.get(key).fall(def)
  +  has
    \  key=quip a=uon[v]
    ^  bool
    ?=((./some _) a.get(key))
  +  gas
    '  Insert a row of entries.
    \  b=row[uon/kv[v]] a=uon[v]
    ^  uon[v]
    b.fold(a (\ acc [key val] acc.put(key val)))
  +  tap
    '  Every entry, in ascending key order.
    \  a=uon[v]
    ^  row[uon/kv[v]]
    ?  a
     > uon/empty  []
     > n=uon/node[v]
       =  lt  (_ n.l)
          rt  (_ n.r)
       lt.weld(rt.cons((uon/kv[v] n.key n.val)))
  +  keys
    '  Ascending keys.
    \  a=uon[v]
    ^  path
    a.tap.fold([] (\ acc [key _] acc.snoc(key)))
  +  vals
    '  Values in ascending key order.
    \  a=uon[v]
    ^  row[v]
    a.tap.fold([] (\ acc [_ val] acc.snoc(val)))
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \  meg={quip; v; v; v} b=uon[v] a=uon[v]
    ^  uon[v]
    b.tap.fold(a ;
      \  acc [key new]
      ?>  (./some old) acc.get(key)
          acc.put(key new)
      acc.put(key (meg key old new)))
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=uon[v] a=uon[v]
    ^  uon[v]
    a.uno(take_new[v] b)
  +  nip
    '  Merge two trees whose key ranges are disjoint.
    \  l=uon[v] r=uon[v]
    ^  uon[v]
    l.uni(r)
  +  del2
    '  Delete a key, returning just the remaining tree.
    \  key=quip a=uon[v]
    ^  uon[v]
    ?  a
     > uon/empty  (uon/empty)
     > n=uon/node[v]
       ?  (lt_iota key n.key)
          (uon/balance[v] n.key n.val (_ key n.l) n.r)
       ?  (lt_iota n.key key)
          (uon/balance[v] n.key n.val n.l (_ key n.r))
       (uon/nip[v] n.l n.r)
  +  floor
    '  The greatest entry at or below a key, if any.
    '  ?=  ((uon/floor[nat] '5 (uon/empty)) (maybe/none))
    \  key=quip a=uon[v]
    ^  maybe[[k=quip val=v]]
    ?  a
     > uon/empty  .none
     > n=uon/node[v]
       ?  (lt_iota key n.key)
          (_ key n.l)
       ?>  (./some e) (_ key n.r)
           (./some [n.key n.val])
       (./some e)
  +  del
    '  Delete a key: the deleted value (if any) and the remaining
    '  tree, as an anonymous row.
    \  key=quip a=uon[v]
    ^  [found=maybe[v] rest=uon[v]]
    [a.get(key) a.del2(key)]
  +  run
    '  Map a function over the values.
    (@ w)
    \  fun={v; w} a=uon[v]
    ^  uon[w]
    ?  a
     > uon/empty  (uon/empty)
     > n=uon/node[v]
       (uon/node[w] n.sz n.key (fun n.val) (_ fun n.l) (_ fun n.r))
  +  apt_in
    '  Order + size-cache invariant, with open bounds.
    \  lo=maybe[quip] hi=maybe[quip] a=uon[v]
    ^  bool
    ?  a
     > uon/empty  .true
     > n=uon/node[v]
       ?  !(lt_bound lo n.key)
          .false
       ?  !(gt_bound hi n.key)
          .false
       ?  !(eq n.sz n.l.size.inc.add(n.r.size))
          .false
       ?  !(_ lo (./some n.key) n.l)
          .false
       (_ (./some n.key) hi n.r)
  +  apt
    '  The order and size-cache invariant check.
    '  ?=  ((uon/apt[nat] (uon/empty)) 1)
    \  a=uon[v]
    ^  bool
    a.apt_in(.none .none)
+  mop
  '  An ordered map from any key type to any value type, ordered by a
  '  compile-time constant comparison: mop[k v lt] (the map.foil
  '  scheme).  The ordering is declared once and never passed at
  '  runtime.  Size-balanced binary-search-tree internals, exactly
  '  /uon with the key type and order generalized.
  (@@ k v lt={k; k; bool})
  &  mop/empty
     mop/node[k v lt]
  +  empty
    :
  +  node
    :  sz=nat key=k val=v l=mop[k v lt] r=mop[k v lt]
  +  kv
    '  One entry, as /mop/tap returns them.
    :  key=k val=v
  +  size
    '  Number of entries; reads the cached sz.
    \  t=mop[k v lt]
    ^  nat
    ?  t
     > mop/empty  0
     > n=mop/node[k v lt] n.sz
  +  n
    '  Node builder: recomputes the size cache.
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    (mop/node[k v lt] l.size.inc.add(r.size) key val l r)
  +  sing
    \  key=k val=v
    ^  mop[k v lt]
    (mop/n[k v lt] key val (mop/empty) (mop/empty))
  +  rot_l
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  r
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       (mop/n[k v lt] n.key n.val (mop/n[k v lt] key val l n.l) n.r)
  +  rot_r
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  l
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       (mop/n[k v lt] n.key n.val n.l (mop/n[k v lt] key val n.r r))
  +  rot_ll
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  r
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       ?  n.l
        > mop/empty  (mop/rot_l[k v lt] key val l r)
        > m=mop/node[k v lt]
          (mop/n[k v lt] m.key m.val (mop/n[k v lt] key val l m.l) (mop/n[k v lt] n.key n.val m.r n.r))
  +  rot_rr
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  l
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       ?  n.r
        > mop/empty  (mop/rot_r[k v lt] key val l r)
        > m=mop/node[k v lt]
         (mop/n[k v lt] m.key m.val (mop/n[k v lt] n.key n.val n.l m.l) (mop/n[k v lt] key val m.r r))

  +  rotate_l
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  r
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       ?  n.l.size.lt(n.r.size.mul(2))
         (mop/rot_l[k v lt] key val l r)
       (mop/rot_ll[k v lt] key val l r)

  +  rotate_r
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  l
     > mop/empty  (mop/n[k v lt] key val l r)
     > n=mop/node[k v lt]
       ?  n.r.size.lt(n.l.size.mul(2))
          (mop/rot_r[k v lt] key val l r)
       (mop/rot_rr[k v lt] key val l r)
  +  balance
    \  key=k val=v l=mop[k v lt] r=mop[k v lt]
    ^  mop[k v lt]
    ?  (le l.size.add(r.size) 1)
       (mop/n[k v lt] key val l r)
    ?  (ge r.size (mul 4 l.size))
       (mop/rotate_l[k v lt] key val l r)
    ?  (ge l.size (mul 4 r.size))
       (mop/rotate_r[k v lt] key val l r)
    (mop/n[k v lt] key val l r)
  +  put
    '  Ordered insert, replacing an existing key.
    \  key=k val=v a=mop[k v lt]
    ^  mop[k v lt]
    ?  a
     > mop/empty  (mop/sing[k v lt] key val)
     > n=mop/node[k v lt]
       ?  (lt key n.key)
          (mop/balance[k v lt] n.key n.val (_ key val n.l) n.r)
       ?  (lt n.key key)
          (mop/balance[k v lt] n.key n.val n.l (_ key val n.r))
       (mop/n[k v lt] key val n.l n.r)
  +  get
    '  The value at a key, or .none.
    \  key=k a=mop[k v lt]
    ^  maybe[v]
    ?  a
     > mop/empty  .none
     > n=mop/node[k v lt]
       ?  (lt key n.key)
          (_ key n.l)
       ?  (lt n.key key)
          (_ key n.r)
       (./some n.val)
  +  gut
    '  Lookup with a default.
    \  key=k def=v a=mop[k v lt]
    ^  v
    a.get(key).fall(def)
  +  has
    \  key=k a=mop[k v lt]
    ^  bool
    ?=((./some _) a.get(key))
  +  tap
    '  Every entry, in ascending key order.
    \  a=mop[k v lt]
    ^  row[mop/kv[k v]]
    ?  a
     > mop/empty  []
     > n=mop/node[k v lt]
       =  lo  (_ n.l)
          hi  (_ n.r)
       lo.weld(hi.cons((mop/kv[k v] n.key n.val)))
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \  meg={k; v; v; v} b=mop[k v lt] a=mop[k v lt]
    ^  mop[k v lt]
    b.tap.fold(a ;
      \  acc [key new]
      ?>  (./some old) acc.get(key)
          acc.put(key new)
      acc.put(key (meg key old new)))
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=mop[k v lt] a=mop[k v lt]
    ^  mop[k v lt]
    a.uno(keep_new[k v] b)
+  mop_use
  '  Exercises /mop at [nat nat lt]: put replaces, uni right-biases.
  '  ?=  ((mop_use) 99)
  ^  nat
  =  m0  (mop/empty)
     m1  (mop/put[nat nat lt] 1 10 m0)
     m2  m1.put(2 20)
     m3  m2.put(1 99)
     m4  (mop/put[nat nat lt] 1 0 m0)
     m5  m4.uni(m3)
  ?  (eq 2 m5.size)
     m5.gut(1 0)
  0
+  mop_use_pith
  '  Exercises /mop at [path nat lt_pith]: path keys order and fetch.
  '  ?=  ((mop_use_pith) 7)
  ^  nat
  =  m0  (mop/empty)
     m1  (mop/put[path nat lt_pith] ['a 'b] 7 m0)
     m2  m1.put(['a] 3)
  ?  (eq 2 m2.size)
     m2.gut(['a 'b] 0)
  0
+  axal
  '  A recursive path-tree: a value at this node (fil) plus an ordered
  '  map of children (kid), addressed by piths — path.  The kid
  '  map instantiates /uon at the axal type itself.
  (@@ v)
  :  fil=maybe[v] kid=uon[axal[v]]
  +  new
    '  A leaf: the given fil and no kids.  (axal/new[v] .none) is the
    '  empty tree.
    \  m=maybe[v]
    ^  axal[v]
    (axal[v] m (uon/empty))
  +  dip
    '  Descend to the subtree at this path (empty if absent).
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fat
    ?>  (./some sub) fat.kid.get(pax.at(0))
        (axal/new[v] .none)
    (_ pax.drop(1) sub)
  +  get
    '  The value at this path, or .none.
    \  pax=path fat=axal[v]
    ^  maybe[v]
    fat.dip(pax).fil
  +  gut
    '  Lookup at a path, with a default.
    \  pax=path def=v fat=axal[v]
    ^  v
    fat.get(pax).fall(def)
  +  has
    '  Is there a value at this path?
    \  pax=path fat=axal[v]
    ^  bool
    ?=((./some _) fat.get(pax))
  +  fit
    '  The value at the longest existing prefix of the path, plus the
    '  path suffix that was not consumed.  The result is an anonymous
    '  row; bind it and use the bare faces.
    \  pax=path fat=axal[v]
    ^  [rem=path fil=maybe[v]]
    ?  (eq 0 pax.len)
       [pax fat.fil]
    ?  fat.kid.get(pax.at(0))
     >  .none  [pax fat.fil]
     >  (./some sub)
       =  [rem got]  (_ pax.drop(1) sub)
       ?  got
        >  (./some _)  [rem got]
        >  .none      [pax fat.fil]
  +  put
    '  Set the value at a path, creating the spine.
    \  pax=path dat=v fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       (axal[v] (./some dat) fat.kid)
    =  key  pax.at(0)
       sub  fat.kid.gut(key (axal/new[v] .none))
    (axal[v] fat.fil fat.kid.put(key (_ pax.drop(1) dat sub)))
  +  gas
    '  Put a row of [pith value] entries.
    \  lit=row[[p=path q=v]] fat=axal[v]
    ^  axal[v]
    lit.fold(fat (\ acc [p q] acc.put(p q)))
  +  rep
    '  Replace the whole subtree at a path.
    \  pax=path fresh=axal[v] fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fresh
    =  key  pax.at(0)
       sub  fat.kid.gut(key (axal/new[v] .none))
    (axal[v] fat.fil fat.kid.put(key (_ pax.drop(1) fresh sub)))
  +  del
    '  Clear the value at a path, keeping descendants.
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       (axal[v] .none fat.kid)
    =  key  pax.at(0)
    ?  fat.kid.get(key)
     >  .none        fat
     >  (./some sub)  (axal[v] fat.fil fat.kid.put(key (_ pax.drop(1) sub)))
  +  lop
    '  Delete the whole subtree at a path.
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fat
    ?  (eq 1 pax.len)
       (axal[v] fat.fil fat.kid.del2(pax.at(0)))
    =  key  pax.at(0)
    ?  fat.kid.get(key)
     >  .none        fat
     >  (./some sub)
      (axal[v] fat.fil fat.kid.put(key (_ pax.drop(1) sub)))
  +  tap
    '  Every [pith value] entry in the tree — anonymous rows — parent
    '  before kids, kids in ascending key order.  One accumulator
    '  threads the whole walk without rebuilding prefixes.
    \  fat=axal[v]
    ^  row[[p=path q=v]]
    |  > here=path []
       > cur=axal[v] fat
       > acc=row[[p=path q=v]] []
    =  me  (_)
       out
         ?>  (./some x) cur.fil
             acc
         acc.snoc([here x])
    cur.kid.tap.fold(out ;
      \  next [key sub]
      (me here.snoc(key) sub next))
  +  keys
    '  Every pith holding a value, in tap order.
    \  fat=axal[v]
    ^  row[path]
    fat.tap.fold([] (\ acc [p _] acc.snoc(p)))
  +  vals
    '  Every value, in tap order.
    \  fat=axal[v]
    ^  row[v]
    fat.tap.fold([] (\ acc [_ q] acc.snoc(q)))
  +  wyt
    '  The number of values in the tree.
    \  fat=axal[v]
    ^  nat
    =  me  (_)
       sub  fat.kid.tap.fold(0 (\ acc [_ kid] acc.add((me kid))))
    ?  fat.fil
     > (./some _)  sub.inc
     > .none  sub
  +  run
    '  Map a function over every value.  The kid map is mapped with
    '  the partially-applied self as the gate.
    (@ w)
    \  fun={v; w} fat=axal[v]
    ^  axal[w]
    =  me  (_)
    (axal[w] fat.fil.run(fun) (uon/run[axal[v] axal[w]] (me fun) fat.kid))
  +  snip_cut
    '  Worker for /axal/snip : a valued kid becomes its leaf; a
    '  hollow one is transparent and passes through to the nearest
    '  valued descendants.  The loop's captured self rides as the
    '  descent gate.
    \  k=axal[v]
    ^  axal[v]
    |  > cur=axal[v] k
    =  me  (_)
    ?  cur.fil
     > (./some _)  (axal/new[v] cur.fil)
     > .none
       (axal[v] .none (uon/run[axal[v] axal[v]] me cur.kid))
  +  snip
    '  The care-y restriction of a tree: the root value plus its
    '  frontier — each nearest valued descendant at its full pith,
    '  hollow paths passing through.  Wholly valueless branches
    '  remain as empty structure, invisible to get/tap/keys.
    \  fat=axal[v]
    ^  axal[v]
    (axal[v] fat.fil (uon/run[axal[v] axal[v]] axal/snip_cut[v] fat.kid))
  +  uni
    '  Merge taf into fat; fat's values win at collisions.
    '  The loop is shaped to ride /uon/uno as its own meg gate (key,
    '  old-from-fat, new-from-taf) — the key parameter exists only so
    '  the captured self fits the gate, hence the dummy init.
    \  taf=axal[v] fat=axal[v]
    ^  axal[v]
    |  > k=quip '0
       > l=axal[v] fat
       > r=axal[v] taf
    ^  axal[v]
    =  me  (_)
    (axal[v] l.fil.or(r.fil) l.kid.uno(me r.kid))
  +  crumb
    '  One level of zipper context: the parent's fil, its other kids,
    '  and the key descended through.
    :  fil=maybe[v] sibs=uon[axal[v]] key=quip
  +  zip
    '  An axal with a cursor: the subtree under focus plus the spine
    '  of crumbs back to the root, innermost last.  Edits happen on
    '  focus through the generated accessors; /axal/zip/top reattaches
    '  everything.
    :  focus=axal[v] spine=row[axal/crumb[v]]
    +  down
      '  Descend into kid k; an absent kid becomes an empty axal, so
      '  edits at depth create their spine.
      \  k=quip z=axal/zip[v]
      ^  axal/zip[v]
      =  kid   z.focus.kid.gut(k (axal/new[v] .none))
         sibs  z.focus.kid.del2(k)
         cr    (axal/crumb[v] z.focus.fil sibs k)
      (axal/zip[v] kid z.spine.snoc(cr))
    +  up
      '  Reattach the focus one level up; at the root, a no-op.
      \  z=axal/zip[v]
      ^  axal/zip[v]
      ?  (eq 0 z.spine.len)
         z
      =  cr   z.spine.at(z.spine.len.dec)
         par  (axal[v] cr.fil cr.sibs.put(cr.key z.focus))
      (axal/zip[v] par z.spine.take(z.spine.len.dec))
    +  top
      '  Unwind fully and return the tree.
      \  z=axal/zip[v]
      ^  axal[v]
      ?  (eq 0 z.spine.len)
         z.focus
      (_ z.up)
  +  zipper
    '  A cursor at the root of this axal.
    \  fat=axal[v]
    ^  axal/zip[v]
    (axal/zip[v] fat [])
