  '  slices count bytes; callers choose codepoint boundaries.
  +  from_atom
    '  Interpret packed bytes as text without changing their representation.
    \ bytes=nat
    ^ str
    | add bytes 0
  +  to_atom
    '  The packed bytes, for APIs that still take a nat cord.
    \ text=str
    ^ nat
    | add text 0
  +  cat
    \ r=str l=str
    ^ str
    | add l | lsh r | mul 8 (wid l)
  +  slice
    \ start=nat len=nat s=str
    ^ str
    | loadvar start len s
  +  len
    \ s=str
    | wid s
  +  at
    \ idx=nat s=str
    | load8 idx s
