  '  ?=  ((pith_prefix ['a] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'b] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'c] ['a 'b 'd]) 0)
  \  a=path b=path
  ^  nat
  ?  (gt a.len b.len)
     0
  |  > i=nat 0
  ?  (eq i a.len)
     1
  ?  (eq_iota a.at(i) b.at(i))
     (_ i.inc)
  0
+  lt_pith
