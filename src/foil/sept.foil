   > ($r x=nat)   x
   > ($rd x=nat)  x
   > ($rs x=nat)  x
   > ($s x=nat)   x
   > ($ta x=nat)  x
   > ($ts x=nat)  x
   > ($tu x=nat)  x
   > ($u x=nat)   x
