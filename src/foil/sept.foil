  +  del
    '  Remove a key using the map comparator's equality. Rebuilds the map.
    \ key=k tree=mop[k v lt]
    ^ mop[k v lt]
    | tree.filter (\ cur val ((lt cur key) || (lt key cur)))
+  mop_use
  '  Exercises /mop at [nat nat lt]: put replaces, uni right-biases.
  '  ?=  ((mop_use) 99)
  ^  nat
  =  m0  (mop/empty)
     m1  (mop/put[nat nat lt] 1 10 m0)
     m2  m1.put(2 20)
     m3  m2.put(1 99)
     m4  (mop/put[nat nat lt] 1 0 m0)
     m5  m4.uni(m3)
  ?  (eq 2 m5.size)
     m5.gut(1 0)
  0
+  mop_use_pith
  '  Exercises /mop at [path nat lt_pith]: path keys order and fetch.
  '  ?=  ((mop_use_pith) 7)
  ^  nat
  =  m0  (mop/empty)
     m1  (mop/put[path nat lt_pith] ['a 'b] 7 m0)
     m2  m1.put(['a] 3)
  ?  (eq 2 m2.size)
     m2.gut(['a 'b] 0)
  0
+  bee
  '  An ordered map from iota (iota) to v by /lte_iota — B-tree
  '  internals, every child link behind a pin.  An insert rebuilds
  '  (and re-pins) only its root-to-leaf path, so snapshotting a
  '  tree that grew by one key re-serializes O(log fanout) small
  '  nodes at any fanout.  In-order tap is naturally sorted; no
  '  hashing, no boundary sorts.  Deletion is lazy: leaves may run
  '  under half-full (structure deletes are rare — /axal/lop).
  (@@ v)
  &  bee/leaf[v]
     bee/limb[v]

  +  leaf
    '  A run of sorted entries, at most /bee/max of them.  [] is
    '  the empty map.
    :  ents=row[uon/kv[v]]

  +  limb
    '  An interior node: kids.len = seps.len + 1; kid i covers keys
    '  below seps.at(i) (at-or-above routes right).  sz caches the
    '  total entry count.
    :  sz=nat seps=row[iota] kids=row[bee/k[v]]

  +  k
    '  A pinned child link — the hitchhiker pin boundary.
    :  held=pin[bee[v]]

  +  max
    ^  nat
    16

  +  ins
    '  One level's insert outcome: the rebuilt node (grew tells
    '  whether the key was new), or a split with its separator.
    &  bee/ins/fit[v]
       bee/ins/burst[v]

    +  fit
      :  t=bee[v] grew=nat

    +  burst
      :  l=bee/k[v] sep=iota r=bee/k[v]

  +  arm
    '  Count of separators at-or-below the probe: the child index a
    '  key routes to in a limb.
    \ key=iota ks=row[iota]
    ^ nat
    % i=nat 0
    ? | eq i ks.len
     i
    ?  !(lte_iota ks.at(i) key)
     i
    | _ i.inc
  +  size
    \  t=bee[v]
    ^  nat
    ?  t
     > lf=bee/leaf[v]  lf.ents.len
     > lm=bee/limb[v]  lm.sz
  +  get
    \ key=iota t=bee[v]
    ^ maybe[v]
    ? t
     > lef=bee/leaf[v]
       % i=nat 0
       ^ maybe[v]
       ? | eq i lef.ents.len
        .none
       = e lef.ents.at(i)
       ? | eq_iota e.key key
        | ./some e.val
       ? | lt_iota key e.key
        | .none
       | _ i.inc
     > lm=bee/limb[v]
       | _ key
       | unpin
       lm.kids.at((bee/arm key lm.seps)).held
  +  gut
    \ key=iota def=v t=bee[v]
    ^  v
    t.get(key).fall(def)
  +  tally
    '  Total entries across a kids row.
    \ ks=row[bee/k[v]]
    ^ nat
    | ks.fold 0
    \ acc w
    | add acc | bee/size[v] | unpin w.held
  +  put_in
    '  Insert one level down; the caller absorbs a burst.
    \ key=iota val=v t=bee[v]
    ^ bee/ins[v]
    ? t
     > lf=bee/leaf[v]
       = ents lf.ents
         i
           % j=nat 0
           ? | eq j ents.len
            j
           ? | lt_iota ents.at(j).key key
            | _ j.inc
           j
       = kv | uon/kv[v] key val
         hit
          ? | lt i ents.len
           | eq_iota ents.at(i).key key
          .false
         e2
          ? hit
           ents.put_at(i kv)
          ents.take(i).snoc(kv).weld(ents.drop(i))
         g
          ? hit 0 1
       ? | le e2.len bee/max
        | ./fit (bee/leaf[v] e2) g
       = m | div e2.len 2
       | ./burst
        | bee/k[v] | pin | bee/leaf[v] e2.take(m)
        e2.at(m).key
        | bee/k[v] | pin | bee/leaf[v] e2.drop(m)
     > lm=bee/limb[v]
       =  i   | bee/arm key lm.seps
          sub | unpin lm.kids.at(i).held
       ? | _ key val sub
        > (./fit t2 g)
         | ./fit
           | bee/limb[v] lm.sz.add(g) lm.seps
             lm.kids.put_at(i (bee/k[v] (pin t2)))
           g
        > (./burst l2 sep r2)
          = s2 lm.seps.take(i).snoc(sep).weld(lm.seps.drop(i))
            k2 lm.kids.take(i).snoc(l2).snoc(r2).weld(lm.kids.drop(i.inc))
          ? | le s2.len bee/max
           | ./fit (bee/limb[v] lm.sz.inc s2 k2) 1
          =  m     | div s2.len 2
             msep  s2.at(m)
             lk    k2.take(m.inc)
             rk    k2.drop(m.inc)
          | ./burst
            | bee/k[v] | pin | bee/limb[v] (bee/tally[v] lk) s2.take(m) lk
           msep
          | bee/k[v]
            | pin | bee/limb[v] (bee/tally[v] rk) s2.drop(m.inc) rk
  +  put
    \  key=iota val=v t=bee[v]
    ^  bee[v]
    ?  t.put_in(key val)
     > (./fit t2 _)  t2
     > (./burst l sep r)
       | bee/limb[v]
         | add (bee/size[v] (unpin l.held))
              | bee/size[v] (unpin r.held)
        [sep]
       [l r]
  +  has
    \  key=iota t=bee[v]
    ^  bool
    ?=((./some _) t.get(key))
  +  del2
    '  Remove a key; lazy — no merge or borrow, leaves may run
    '  under-full.  An absent key returns the tree untouched (no
    '  fresh pins minted over identical content).
    \  key=iota t=bee[v]
    ^  bee[v]
    ?  t
     > lf=bee/leaf[v]
       % i=nat 0
       ^  bee[v]
       ? | eq i lf.ents.len
        t
       ? | eq_iota lf.ents.at(i).key key
        | bee/leaf[v] lf.ents.take(i).weld(lf.ents.drop(i.inc))
       | _ i.inc
     > lm=bee/limb[v]
       =  i    | bee/arm key lm.seps
          sub  | unpin lm.kids.at(i).held
          d2   | _ key sub
       ?  | eq (bee/size[v] d2)
              | bee/size[v] sub
         t
       | bee/limb[v] lm.sz.dec lm.seps
         lm.kids.put_at(i (bee/k[v] (pin d2)))
  +  tap
    '  Every entry, ascending by key (in-order walk).
    \ t=bee[v]
    ^ row[uon/kv[v]]
    ? t
     > lf=bee/leaf[v]  lf.ents
     > lm=bee/limb[v]
       = me (_)
       | lm.kids.fold []
       \ acc w acc.weld((me (unpin w.held)))
  +  keys
    \ t=bee[v]
    ^ row[iota]
    | t.tap.fold []
    \ acc e acc.snoc(e.key)
  +  uno
    '  Merge b into a; meg resolves collisions (key, a's, b's).
    \ meg={\ iota v v}v b=bee[v] a=bee[v]
    ^ bee[v]
    | b.tap.fold a
    \ acc e
    | acc.put e.key
    > (./some old) acc.get(e.key)
     e.val
    | meg e.key old e.val
  +  uni
    '  Merge; a's values win collisions.
    \  b=bee[v] a=bee[v]
    ^  bee[v]
    | a.uno
     \ k2 old new old
    b
  +  run
    '  Map a function over every value, structure-preserving.
    (@ w)
    \  fun={\ v}w t=bee[v]
    ^  bee[w]
    ?  t
     > lf=bee/leaf[v]
       | bee/leaf[w]
       | lf.ents.fold []
       \ acc=row[uon/kv[w]] e=uon/kv[v]
       = nex | uon/kv[w] e.key | fun e.val
       acc.snoc(nex)
     > lm=bee/limb[v]
       =  me  (_ fun)
       | bee/limb[w] lm.sz lm.seps
       | lm.kids.fold []
       \ acc kw
       = nex | bee/k[w] | pin | me | unpin kw.held
       acc.snoc(nex)
+  axal
  '  A recursive path-tree: a value at this node (fil) plus an ordered
  '  map of children (kid), addressed by piths — path.  The kid
  '  map instantiates /bee at pinned links of the axal type itself:
  '  child subtrees cross /axal/k pins, so bee nodes hold refs.
  (@@ v)
  :  fil=maybe[v] kid=bee[axal/k[v]]
  +  k
    '  A pinned child subtree.
    :  held=pin[axal[v]]
  +  new
    '  A leaf: the given fil and no kids.  (axal/new[v] .none) is the
    '  empty tree.
    \  m=maybe[v]
    ^  axal[v]
    | axal[v] m | bee/leaf[axal/k[v]] []
  +  kid_get
    '  The child at a key, unpinned.
    \ key=iota fat=axal[v]
    ^ maybe[axal[v]]
    > (./some w) fat.kid.get(key)
     .none
    | ./some | unpin w.held
  +  kid_gut
    '  The child at a key, or the empty tree.
    \ key=iota fat=axal[v]
    ^ axal[v]
    > (./some sub) fat.kid_get(key)
     | axal/new[v] .none
    sub
  +  kid_put
    '  The kid map with sub pinned in at key.
    \ key=iota sub=axal[v] fat=axal[v]
    ^ bee[axal/k[v]]
    | fat.kid.put
     key
    | axal/k[v] | pin sub
  +  kid_tap
    '  Every (key, child) pair, ascending by key, unpinned.
    \  fat=axal[v]
    ^  row[uon/kv[axal[v]]]
    | fat.kid.tap.fold []
    \ acc e
    = kid | uon/kv[axal[v]] e.key | unpin e.val.held
    acc.snoc(kid)
  +  kid_keys
    \  fat=axal[v]
    ^  row[iota]
    fat.kid.tap.fold([] (\ acc e acc.snoc(e.key)))
  +  dip
    '  Descend to the subtree at this path (empty if absent).
    \ pax=path fat=axal[v]
    ^ axal[v]
    ? (eq 0 pax.len)
     fat
    > (./some sub) fat.kid_get(pax.at(0))
     | axal/new[v] .none
    | _ pax.drop(1) sub
  +  get
    '  The value at this path, or .none.
    \  pax=path fat=axal[v]
    ^  maybe[v]
    fat.dip(pax).fil
  +  gut
    '  Lookup at a path, with a default.
    \  pax=path def=v fat=axal[v]
    ^  v
    fat.get(pax).fall(def)
  +  has
    '  Is there a value at this path?
    \  pax=path fat=axal[v]
    ^  bool
    ?=((./some _) fat.get(pax))
  +  fit
    '  The value at the longest existing prefix of the path, plus the
    '  path suffix that was not consumed.  The result is an anonymous
    '  row; bind it and use the bare faces.
    \ pax=path fat=axal[v]
    ^ [rem=path fil=maybe[v]]
    ? (eq 0 pax.len)
      [pax fat.fil]
    ? fat.kid_get(pax.at(0))
     > .none  [pax fat.fil]
     > (./some sub)
       =  [rem got]  | _ pax.drop(1) sub
       ?  got
        >  (./some _)  [rem got]
        >  .none      [pax fat.fil]
  +  put
    '  Set the value at a path, creating the spine.
    \ pax=path dat=v fat=axal[v]
    ^ axal[v]
    ? (eq 0 pax.len)
      (axal[v] (./some dat) fat.kid)
    = key  pax.at(0)
      sub  fat.kid_gut(key)
      nex  | _ pax.drop(1) dat sub
    | axal[v] fat.fil fat.kid_put(key nex)
  +  gas
    '  Put a row of [pith value] entries.
    \ lit=row[[p=path q=v]] fat=axal[v]
    ^ axal[v]
    lit.fold(fat (\ acc [p q] acc.put(p q)))
  +  rep
    '  Replace the whole subtree at a path.
    \ pax=path fresh=axal[v] fat=axal[v]
    ^ axal[v]
    ? | eq 0 pax.len
     fresh
    = key  pax.at(0)
      sub  fat.kid_gut(key)
      nex  | _ pax.drop(1) fresh sub
    | axal[v] fat.fil
    fat.kid_put(key nex)
  +  del
    '  Clear the value at a path, keeping descendants.
    \ pax=path fat=axal[v]
    ^ axal[v]
    ? | eq 0 pax.len
     | axal[v] .none fat.kid
    = key  pax.at(0)
    > (./some sub) fat.kid_get(key)
     fat
    = nex | _ pax.drop(1) sub
    | axal[v] fat.fil fat.kid_put(key nex)
  +  lop
    '  Delete the whole subtree at a path.
    \ pax=path fat=axal[v]
    ^ axal[v]
    ? | eq 0 pax.len
     fat
    ? | eq 1 pax.len
     | axal[v] fat.fil fat.kid.del2(pax.at(0))
    = key  pax.at(0)
    > (./some sub) fat.kid_get(key)
     fat
    = nex | _ pax.drop(1) sub
    | axal[v] fat.fil fat.kid_put(key nex)
  +  tap
    '  Every [pith value] entry in the tree — anonymous rows — parent
    '  before kids, kids in ascending key order.  One accumulator
    '  threads the whole walk without rebuilding prefixes.
    \ fat=axal[v]
    ^ row[[p=path q=v]]
    % here=path []
      cur=axal[v] fat
      acc=row[[p=path q=v]] []
    = me  (_)
      out
       > (./some x) cur.fil
        acc
       acc.snoc([here x])
    | cur.kid_tap.fold out
    \ next [key sub]
    | me here.snoc(key) sub next
  +  keys
    '  Every pith holding a value, in tap order.
    \  fat=axal[v]
    ^  row[path]
    | fat.tap.fold []
    \ acc [p _] acc.snoc(p)
  +  vals
    '  Every value, in tap order.
    \  fat=axal[v]
    ^  row[v]
    | fat.tap.fold []
    \ acc [_ q] acc.snoc(q)
  +  wyt
    '  The number of values in the tree.
    \  fat=axal[v]
    ^  nat
    =  me  (_)
       sub | fat.kid_tap.fold 0
           \ acc [_ kid] acc.add((me kid))
    ?  fat.fil
     > (./some _)  sub.inc
     > .none  sub
  +  run
    '  Map a function over every value.  The kid map is mapped with
    '  the partially-applied self as the gate.
    (@ w)
    \  fun={\ v}w fat=axal[v]
    ^  axal[w]
    =  me  (_ fun)
    | axal[w] fat.fil.run(fun)
    | bee/run[axal/k[v] axal/k[w]]
     \ kw | axal/k[w] | pin | me | unpin kw.held
    fat.kid
  +  snip_cut
    '  Worker for /axal/snip : a valued kid becomes its leaf; a
    '  hollow one is transparent and passes through to the nearest
    '  valued descendants.  The loop's captured self rides as the
    '  descent gate.
    \  k=axal[v]
    ^  axal[v]
    %  cur=axal[v] k
    =  me  (_)
    ?  cur.fil
     > (./some _)  | axal/new[v] cur.fil
     > .none
       | axal[v] .none
       | bee/run[axal/k[v] axal/k[v]]
        \ kw | axal/k[v] | pin | me | unpin kw.held
       cur.kid
  +  snip
    '  The care-y restriction of a tree: the root value plus its
    '  frontier — each nearest valued descendant at its full pith,
    '  hollow paths passing through.  Wholly valueless branches
    '  remain as empty structure, invisible to get/tap/keys.
    \  fat=axal[v]
    ^  axal[v]
    | axal[v] fat.fil
    | bee/run[axal/k[v] axal/k[v]]
     \ kw | axal/k[v] | pin | axal/snip_cut[v] | unpin kw.held
    fat.kid
  +  uni
    '  Merge taf into fat; fat's values win at collisions.
    '  The loop is shaped to ride /uon/uno as its own meg gate (key,
    '  old-from-fat, new-from-taf) — the key parameter exists only so
    '  the captured self fits the gate, hence the dummy init.
    \  taf=axal[v] fat=axal[v]
    ^  axal[v]
    %  k=iota '0
       l=axal[v] fat
       r=axal[v] taf
    ^  axal[v]
    =  me  (_)
    | axal[v] l.fil.or(r.fil)
    | l.kid.uno
     \ k2 aw bw
     | axal/k[v] | pin | me k2 (unpin aw.held) | unpin bw.held
    r.kid
  +  crumb
    '  One level of zipper context: the parent's fil, its WHOLE kid
    '  map (pins untouched — up overwrites at key), and the key
    '  descended through.
    :  fil=maybe[v] sibs=bee[axal/k[v]] key=iota
  +  zip
    '  An axal with a cursor: the subtree under focus plus the spine
    '  of crumbs back to the root, innermost last.  Edits happen on
    '  focus through the generated accessors; /axal/zip/top reattaches
    '  everything.
    :  focus=axal[v] spine=row[axal/crumb[v]]
    +  down
      '  Descend into kid k; an absent kid becomes an empty axal, so
      '  edits at depth create their spine.
      \ k=iota z=axal/zip[v]
      ^ axal/zip[v]
      = kid   z.focus.kid_gut(k)
        cr    | axal/crumb[v] z.focus.fil z.focus.kid k
      | axal/zip[v] kid z.spine.snoc(cr)
    +  up
      '  Reattach the focus one level up; at the root, a no-op.
      \ z=axal/zip[v]
      ^ axal/zip[v]
      ? | eq 0 z.spine.len
       z
      = cr   z.spine.at(z.spine.len.dec)
        val  | axal/k[v] | pin z.focus
        par  | axal[v] cr.fil
             cr.sibs.put(cr.key val)
      | axal/zip[v] par z.spine.take(z.spine.len.dec)
    +  top
      '  Unwind fully and return the tree.
      \  z=axal/zip[v]
      ^  axal[v]
      ? | eq 0 z.spine.len
       z.focus
      | _ z.up
  +  zipper
    '  A cursor at the root of this axal.
    \  fat=axal[v]
    ^  axal/zip[v]
    | axal/zip[v] fat []
