  '  otherwise the first differing iota decides.  Note pre-order
  '  /axal/tap (parent first, kids ascending) emits piths in exactly
  '  this order.
  '  ?=  ((lte_pith ['a] ['a 'b]) 1)
  '  ?=  ((lte_pith ['a 'b] ['a]) 0)
  '  ?=  ((lte_pith ['a 'b] ['a 'c]) 1)
  '  ?=  ((lte_pith [] ['a]) 1)
  \  a=path b=path
  ^  nat
  |  > i=nat 0
  ?  (eq i a.len)
     1
  ?  (eq i b.len)
     0
  =  > x a.at(i)
  =  > y b.at(i)
  ?  (lt_iota x y)
     1
  ?  (lt_iota y x)
     0
