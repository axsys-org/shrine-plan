          (mop/balance[k v lt] n.key n.val (_ key val n.l) n.r)
       ?  (lt n.key key)
          (mop/balance[k v lt] n.key n.val n.l (_ key val n.r))
       (mop/n[k v lt] key val n.l n.r)
  +  get
    '  The value at a key, or $none.
    \  key=k a=mop[k v lt]
    ^  maybe[v]
    ?  a
     > mop/empty  $none
     > n=mop/node[k v lt]
       ?  (lt key n.key)
          (_ key n.l)
       ?  (lt n.key key)
          (_ key n.r)
       ($some n.val)
  +  gut
    '  Lookup with a default.
    \  key=k def=v a=mop[k v lt]
    ^  v
    a.get(key).fall(def)
  +  has
    \  key=k a=mop[k v lt]
    ^  nat
    ?  a.get(key)
     > ($some x=v)  1
     > $none  0
  +  tap
    '  Every entry, in ascending key order.
    \  a=mop[k v lt]
    ^  row[mop/kv[k v]]
    ?  a
     > mop/empty  []
     > n=mop/node[k v lt]
       =  > lo (_ n.l)
       =  > hi (_ n.r)
       lo.weld(hi.cons((mop/kv[k v] n.key n.val)))
  +  uno
    '  Merge b into a; meg arbitrates key collisions as
    '  (meg key old-from-a new-from-b).
    \  meg={k; v; v; v} b=mop[k v lt] a=mop[k v lt]
    ^  mop[k v lt]
    ?  b
     > mop/empty  a
     > n=mop/node[k v lt]
       =  > a1 (_ meg n.l a)
       =  > a2 (_ meg n.r a1)
       ?  a2.get(n.key)
        > ($some old=v)  a2.put(n.key (meg n.key old n.val))
        > $none  a2.put(n.key n.val)
  +  uni
    '  Right-biased union — colliding keys take b's value.
    \  b=mop[k v lt] a=mop[k v lt]
    ^  mop[k v lt]
    a.uno(keep_new[k v] b)
+  mop_use
  '  Exercises /mop at [nat nat lt]: put replaces, uni right-biases.
  '  ?=  ((mop_use) 99)
  ^  nat
  =  > m0 (mop/empty)
  =  > m1 (mop/put[nat nat lt] 1 10 m0)
  =  > m2 m1.put(2 20)
  =  > m3 m2.put(1 99)
  =  > m4 (mop/put[nat nat lt] 1 0 m0)
  =  > m5 m4.uni(m3)
  ?  (eq 2 m5.size)
     m5.gut(1 0)
  0
+  mop_use_pith
  '  Exercises /mop at [path nat lt_pith]: path keys order and fetch.
  '  ?=  ((mop_use_pith) 7)
  ^  nat
  =  > m0 (mop/empty)
  =  > m1 (mop/put[path nat lt_pith] ['a 'b] 7 m0)
  =  > m2 m1.put(['a] 3)
  ?  (eq 2 m2.size)
     m2.gut(['a 'b] 0)
  0
+  axal
  '  A recursive path-tree: a value at this node (fil) plus an ordered
  '  map of children (kid), addressed by piths — path.  The kid
  '  map instantiates /uon at the axal type itself.
  (@@ v)
  :  fil=maybe[v] kid=uon[axal[v]]
  +  new
    '  A leaf: the given fil and no kids.  (axal/new[v] $none) is the
    '  empty tree.
    \  m=maybe[v]
    ^  axal[v]
    (axal[v] m (uon/empty))
  +  dip
    '  Descend to the subtree at this path (empty if absent).
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fat
    ?  fat.kid.get(pax.at(0))
     > ($some k0=axal[v])  (_ pax.drop(1) k0)
     > $none  (axal/new[v] $none)
  +  get
    '  The value at this path, or $none.
    \  pax=path fat=axal[v]
    ^  maybe[v]
    =  > d fat.dip(pax)
    d.fil
  +  gut
    '  Lookup at a path, with a default.
    \  pax=path def=v fat=axal[v]
    ^  v
    fat.get(pax).fall(def)
  +  has
    '  Is there a value at this path?
    \  pax=path fat=axal[v]
    ^  nat
    ?  fat.get(pax)
     > ($some x=v)  1
     > $none  0
  +  fit
    '  The value at the longest existing prefix of the path, plus the
    '  path suffix that was not consumed.  The result is an anonymous
    '  row; bind it and use the bare faces.
    \  pax=path fat=axal[v]
    ^  [rem=path fil=maybe[v]]
    ?  (eq 0 pax.len)
       [pax fat.fil]
    ?  fat.kid.get(pax.at(0))
     > $none  [pax fat.fil]
     > ($some k0=axal[v])
       =  > low (_ pax.drop(1) k0)
       ?  fil
        > ($some x=v)  low
        > $none  [pax fat.fil]
  +  put
    '  Set the value at a path, creating the spine.
    \  pax=path dat=v fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       (axal[v] ($some dat) fat.kid)
    =  > k0 fat.kid.gut(pax.at(0) (axal/new[v] $none))
    (axal[v] fat.fil fat.kid.put(pax.at(0) (_ pax.drop(1) dat k0)))
  +  gas
    '  Put a row of [pith value] entries.
    \  lit=row[[p=path q=v]] fat=axal[v]
    ^  axal[v]
    |  > i=nat 0  > acc=axal[v] fat
    ?  (eq i lit.len)
       acc
    =  > h lit.at(i)
    (_ i.inc acc.put(p q))
  +  rep
    '  Replace the whole subtree at a path.
    \  pax=path fresh=axal[v] fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fresh
    =  > k0 fat.kid.gut(pax.at(0) (axal/new[v] $none))
    (axal[v] fat.fil fat.kid.put(pax.at(0) (_ pax.drop(1) fresh k0)))
  +  del
    '  Clear the value at a path, keeping descendants.
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       (axal[v] $none fat.kid)
    ?  fat.kid.get(pax.at(0))
     > $none  fat
     > ($some k0=axal[v])
       (axal[v] fat.fil fat.kid.put(pax.at(0) (_ pax.drop(1) k0)))
  +  lop
    '  Delete the whole subtree at a path.
    \  pax=path fat=axal[v]
    ^  axal[v]
    ?  (eq 0 pax.len)
       fat
    ?  (eq 1 pax.len)
       (axal[v] fat.fil fat.kid.del2(pax.at(0)))
    ?  fat.kid.get(pax.at(0))
     > $none  fat
     > ($some k0=axal[v])
       (axal[v] fat.fil fat.kid.put(pax.at(0) (_ pax.drop(1) k0)))
  +  tap
    '  Every [pith value] entry in the tree — anonymous rows — parent
    '  before kids, kids in ascending key order.  The outer loop is
    '  the tree recursion over (path, node, acc); one accumulator
    '  threads the whole walk (welding each child's sub-row onto the
    '  prefix copied the accumulated row once per edge — quadratic on
    '  wide or skewed trees).
    \  fat=axal[v]
    ^  row[[p=path q=v]]
    |  > here=path []  > cur=axal[v] fat  > acc=row[[p=path q=v]] []
    =  > me (_)
    =  > a1
         ?  cur.fil
          > ($some x=v)
            =  > e [here x]
            acc.snoc(e)
          > $none  acc
    =  > kids cur.kid.tap
    |  > i=nat 0  > a2=row[[p=path q=v]] a1
    ?  (eq i kids.len)
       a2
    =  > h kids.at(i)
    (_ i.inc (me here.snoc(h.key) h.val a2))
  +  keys
    '  Every pith holding a value, in tap order.
    \  fat=axal[v]
    ^  row[path]
    =  > es fat.tap
    |  > i=nat 0  > acc=row[path] []
    ?  (eq i es.len)
       acc
    =  > h es.at(i)
    (_ i.inc acc.snoc(p))
  +  vals
    '  Every value, in tap order.
    \  fat=axal[v]
    ^  row[v]
    =  > es fat.tap
    |  > i=nat 0  > acc=row[v] []
    ?  (eq i es.len)
       acc
    =  > h es.at(i)
    (_ i.inc acc.snoc(q))
  +  wyt
    '  The number of values in the tree.
    \  fat=axal[v]
    ^  nat
    =  > me (_)
    =  > kids fat.kid.tap
    =  > sub
         |  > i=nat 0  > acc=nat 0
         ?  (eq i kids.len)
            acc
         =  > h kids.at(i)
         (_ i.inc (add acc (me h.val)))
    ?  fat.fil
     > ($some x=v)  sub.inc
     > $none  sub
  +  run
    '  Map a function over every value.  The kid map is mapped with
    '  the partially-applied self as the gate.
    (@ w)
    \  fun={v; w} fat=axal[v]
    ^  axal[w]
    =  > me (_)
    (axal[w] fat.fil.run(fun) (uon/run[axal[v] axal[w]] (me fun) fat.kid))
  +  snip_cut
    '  Worker for /axal/snip : a valued kid becomes its leaf; a
    '  hollow one is transparent and passes through to the nearest
    '  valued descendants.  The loop's captured self rides as the
    '  descent gate.
    \  k=axal[v]
    ^  axal[v]
    |  > cur=axal[v] k
    =  > me (_)
    ?  cur.fil
     > ($some x=v)  (axal/new[v] cur.fil)
     > $none
       (axal[v] $none (uon/run[axal[v] axal[v]] me cur.kid))
  +  snip
    '  The care-y restriction of a tree: the root value plus its
    '  frontier — each nearest valued descendant at its full pith,
    '  hollow paths passing through.  Wholly valueless branches
    '  remain as empty structure, invisible to get/tap/keys.
    \  fat=axal[v]
    ^  axal[v]
    (axal[v] fat.fil (uon/run[axal[v] axal[v]] axal/snip_cut[v] fat.kid))
  +  uni
    '  Merge taf into fat; fat's values win at collisions.
    '  The loop is shaped to ride /uon/uno as its own meg gate (key,
    '  old-from-fat, new-from-taf) — the key parameter exists only so
    '  the captured self fits the gate, hence the dummy init.
    \  taf=axal[v] fat=axal[v]
    ^  axal[v]
    |  > k=quip '0  > l=axal[v] fat  > r=axal[v] taf
    ^  axal[v]
    =  > me (_)
    (axal[v] l.fil.or(r.fil) l.kid.uno(me r.kid))
  +  crumb
    '  One level of zipper context: the parent's fil, its other kids,
    '  and the key descended through.
    :  fil=maybe[v] sibs=uon[axal[v]] key=quip
  +  zip
    '  An axal with a cursor: the subtree under focus plus the spine
    '  of crumbs back to the root, innermost last.  Edits happen on
    '  focus through the generated accessors; /axal/zip/top reattaches
    '  everything.
    :  focus=axal[v] spine=row[axal/crumb[v]]
    +  down
      '  Descend into kid k; an absent kid becomes an empty axal, so
      '  edits at depth create their spine.
      \  k=quip z=axal/zip[v]
      ^  axal/zip[v]
      =  > kid z.focus.kid.gut(k (axal/new[v] $none))
      =  > sibs z.focus.kid.del2(k)
      =  > cr (axal/crumb[v] z.focus.fil sibs k)
      (axal/zip[v] kid z.spine.snoc(cr))
    +  up
      '  Reattach the focus one level up; at the root, a no-op.
      \  z=axal/zip[v]
      ^  axal/zip[v]
      ?  (eq 0 z.spine.len)
         z
      =  > cr z.spine.at(z.spine.len.dec)
      =  > par (axal[v] cr.fil cr.sibs.put(cr.key z.focus))
      (axal/zip[v] par z.spine.take(z.spine.len.dec))
    +  top
      '  Unwind fully and return the tree.
      \  z=axal/zip[v]
      ^  axal[v]
      ?  (eq 0 z.spine.len)
         z.focus
      (_ z.up)
  +  zipper
    '  A cursor at the root of this axal.
    \  fat=axal[v]
    ^  axal/zip[v]
    (axal/zip[v] fat [])
