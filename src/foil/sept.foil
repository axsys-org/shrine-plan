    | str/cat_all
    | xs.map str/from_atom
  +  join
    \ sep=nat xs=row[nat]
    ^ nat
    | str/to_atom (str/join (str/from_atom sep) xs.map(str/from_atom))
  +  split_byte
    \ sep=nat text=nat
    ^ row[nat]
    | (str/split_byte sep (str/from_atom text)).map str/to_atom
