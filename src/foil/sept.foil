   > ($f x=nat)   3
   > ($r x=nat)   4
   > ($rd x=nat)  5
   > ($rs x=nat)  6
   > ($s x=nat)   7
   > ($ta x=nat)  8
   > ($ts x=nat)  9
   > ($tu x=nat)  10
   > ($u x=nat)   11
   > ($w x=nat)   12
   > ($x x=nat)   13
