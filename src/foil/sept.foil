    | (str/split_nonempty sep (str/from_atom text)).map str/to_atom
+  lte_str
  '  Byte-lexicographic compare of two LE-packed strings.  Numeric
  '  compare is wrong here ("b" < "aa" as nats).
  '  ?=  ((lte_str 24929 98) 1)
  \  a=nat b=nat
  ^  bool
  ? | eq a b
   .true
  ?  | eq a 0
   .true
  ? | eq b 0
   .false
  ? | lt (mod a 256) (mod b 256)
   .true
  ? | lt (mod b 256) (mod a 256)
   .false
  |  _  | div a 256
  | div b 256
+  lte_dime
  '  Total order on iotas: differing auras order by aura name (the
  '  rank), same aura by payload — text auras lexicographically,
  '  signed (s) by zigzag-decoded value, floats (rs/rd) by the IEEE
  '  total-order key, the rest numerically.  Delegates to the
  '  iota_lte jet: the ordered maps compare on every tree level, and
  '  the interpreted match chains here cost ~20µs a call.  The
  '  reference definition:
  '  rank a = rank b ? (per-aura compare) on quip_val : le on ranks.
  \ a=iota b=iota
  ^ bool
  | iota_lte a b
+  eq_iota
  '  Deep iota equality.  The eq builtin is PLAN Eq, which is shallow
  '  on structured values — two iotas with the same aura compare equal
  '  regardless of payload — so equality goes rank-then-payload
  '  (the iota_eq jet).
  \ a=iota b=iota
  ^ bool
  | iota_eq a b
+  path
  +  starts
    '  Does a nonempty path begin with this segment?  Compare the aura
    '  and payload together, just as ordered path maps do.
    \ root=iota p=path
    ^ bool
    ? (eq p.len 0) .false
    | eq_iota root p.at(0)
+  lte_iota
  '  Non-strict iota ordering; unlike /lt_iota, equal keys pass.
  '  ?=  ((lte_iota '1 '2) 1)
  '  ?=  ((lte_iota 'bar 'foo) 1)
  '  ?=  ((lte_iota 'foo '1) 1)
  '  ?=  ((lte_iota '1 'foo) 0)
  \  a=iota b=iota
  ^  bool
  | lte_dime a b
+  lt_iota
  '  Strict version of /lte_iota .
  \  a=iota b=iota
  ^  bool
  | iota_lt a b
+  lt_bound
  '  Is the (optional) lower bound strictly below the key?
  \  b=maybe[iota] key=iota
  ^  bool
  |  maybe/fall  .true
  |  b.run
  \  x=iota | lt_iota x key
+  gt_bound
  '  Is the key strictly below the (optional) upper bound?
  \  b=maybe[iota] key=iota
  ^  bool
  b.run((\ x=iota (lt_iota key x))).fall(.true)
+  lte_pith
  '  Lexicographic order on piths: a prefix precedes its extensions;
  '  otherwise the first differing iota decides.  Note pre-order
  '  /axal/tap (parent first, kids ascending) emits piths in exactly
  '  this order.
  '  ?=  ((lte_pith ['a] ['a 'b]) 1)
  '  ?=  ((lte_pith ['a 'b] ['a]) 0)
  '  ?=  ((lte_pith ['a 'b] ['a 'c]) 1)
  '  ?=  ((lte_pith [] ['a]) 1)
  \ a=path b=path
  ^ bool
  % i=nat 0
  ? | eq i a.len
   .true
  ? | eq i b.len
   .false
  = x a.at(i)
  = y b.at(i)
  ? | lt_iota x y
   .true
  ? | lt_iota y x
   .false
  | _ i.inc
+  eq_pith
  '  Deep pith equality.
  '  ?=  ((eq_pith ['a 'b] ['a 'b]) 1)
  '  ?=  ((eq_pith ['a] ['a 'b]) 0)
  \ a=path b=path
  ^ bool
  ?  !(eq a.len b.len)
   .false
  % i=nat 0
  ? | eq i a.len
   .true
  ? | eq_iota a.at(i) b.at(i)
   | _ i.inc
  .false
+  pith_prefix
  '  Is a a prefix of b?  Reflexive: a pith is its own prefix.
  '  ?=  ((pith_prefix ['a] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'b] ['a 'b]) 1)
  '  ?=  ((pith_prefix ['a 'c] ['a 'b 'd]) 0)
  \ a=path b=path
  ^ bool
  ? | gt a.len b.len
   .false
  % i=nat 0
  ? | eq i a.len
   .true
  ? | eq_iota a.at(i) b.at(i)
   | _ i.inc
  .false
+  lt_pith
  '  Strict lexicographic order on piths: /lte_pith and not equal.
  '  The ordering constant for path-keyed /mop instantiations.
  '  ?=  ((lt_pith ['a] ['a 'b]) 1)
  '  ?=  ((lt_pith ['a] ['a]) 0)
  '  ?=  ((lt_pith ['a 'b] ['a]) 0)
  \ a=path b=path
  ^ bool
  ? | eq_pith a b
   .false
  | lte_pith a b
+  uon
  '  An ordered map from iota to v, using the strict /lt_iota order.
  '  Size-balanced binary-search-tree internals (the bst.foil scheme).
  (@@ v)
  & uon/empty
    uon/node[v]
  +  empty
    :
  +  node
    :  sz=nat key=iota val=v l=uon[v] r=uon[v]
  +  kv
    '  One entry, as /uon/tap returns them.
    :  key=iota val=v
  +  size
    '  Number of entries; reads the cached sz.
    '  ?=  ((uon/size[nat] (uon/empty)) 0)
    \ t=uon[v]
    ^ nat
    > n=uon/node[v] t
     0
    n.sz
  +  n
    '  Node builder: recomputes the size cache.
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    | uon/node[v] l.size.inc.add(r.size)
      key val l r
  +  from_keys
    '  Build an index with one shared value; repeated keys collapse.
    \  value=v keys=row[iota]
    ^  uon[v]
    |  keys.fold (uon/empty)
    \  acc key
    acc.put(key value)
  +  sing
    '  ?=  ((uon/size[nat] (uon/sing[nat] '1 10)) 1)
    \ key=iota val=v
    ^ uon[v]
    | uon/n[v] key val  ' key val'
     (uon/empty) (uon/empty) ' l r
  +  rot_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  r
     | uon/n[v] key val
       l r
    | uon/n[v] n.key n.val
     | uon/n[v] key val l n.l
     n.r
  +  rot_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v]  l
      | uon/n[v] key val
        l r
    | uon/n[v] n.key n.val
      n.l
      | uon/n[v] key val n.r r
  +  rot_ll
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v]  r
     (uon/n[v] key val l r)
    > m=uon/node[v]  n.l
     (uon/rot_l[v] key val l r)
    | uon/n[v] m.key m.val
      | uon/n[v] key val l m.l
      | uon/n[v] n.key n.val m.r n.r
  +  rot_rr
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    > m=uon/node[v] n.r
     | uon/rot_r[v] key val l r
    | uon/n[v] m.key m.val
     | uon/n[v] n.key n.val n.l m.l
    | uon/n[v] key val m.r r
  +  rotate_l
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] r
     | uon/n[v] key val l r
    ? | lt n.l.size n.r.size.mul(2)
     | uon/rot_l[v] key val l r
    | uon/rot_ll[v] key val l r
  +  rotate_r
    \  key=iota val=v l=uon[v] r=uon[v]
    ^  uon[v]
    > n=uon/node[v] l
     | uon/n[v] key val l r
    ? | lt n.r.size n.l.size.mul(2)
     | uon/rot_r[v] key val l r
    | uon/rot_rr[v] key val l r
  +  balance
    \ key=iota val=v l=uon[v] r=uon[v]
    ^ uon[v]
    ? | le l.size.add(r.size) 1
     | uon/n[v] key val l r
    ? | ge r.size (mul 4 l.size)
