-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_web_policy_result [order=50]
-  chat_foundry_web_policy_outer_window [order=60]
-  chat_foundry_web_policy_outer_after_window [order=70]
'  Ordered continuation after the outer Stage policy.  Keeping one leaf policy
'  at each continuation boundary bounds direct compiler fan-in without changing
'  legacy branch precedence.
+  chat_foundry_web_policy_outer_after_stage
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    =  window
         (chat_foundry_web_policy_outer_window/plan_policy occurrence children)
    ?  window.matched  window
    (chat_foundry_web_policy_outer_after_window/plan_policy
      occurrence children)
