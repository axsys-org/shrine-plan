- sept

+ ethereum_bytes
  + fail
    \ why=str
    ^ row[nat]
    ; (error (pails/t why))
    []
  + fail_text
    \ why=str
    ^ str
    ; (error (pails/t why))
    ""
  + range
    \ count=nat
    ^ row[nat]
    % i=nat 0 out=row[nat] []
    ? (eq i count) out
    | _ i.inc out.snoc(i)
  + zeroes
    \ count=nat
    ^ row[nat]
    | (ethereum_bytes/range count).map (\ i=nat 0)
  + put
    \ index=nat value=nat values=row[nat]
    ^ row[nat]
    | values.take(index).snoc(value).weld(values.drop(index.inc))
  + big
    \ width=nat value=nat
    ^ row[nat]
    ? (ge value (bex (mul 8 width))) (ethereum_bytes/fail "integer does not fit bytes")
    | (ethereum_bytes/range width).map
      \ i=nat
      | mod (rsh value (mul 8 (sub width i.inc))) 256
  + integer
    \ bytes=row[nat]
    ^ nat
    | row/fold[nat nat] 0 (\ out=nat byte=nat (add (mul out 256) byte)) bytes
  + little
    \ bytes=row[nat]
    ^ nat
    | ethereum_bytes/integer bytes.rev
  + ascii
    \ text=str
    ^ row[nat]
    | (ethereum_bytes/range text.len).map (\ i=nat text.at(i))
  + hex
    \ bytes=row[nat]
    ^ str
    % i=nat 0 out=str "0x"
    ? (eq i bytes.len) out
    = n bytes.at(i)
    ? (ge n 256) (ethereum_bytes/fail_text "invalid byte")
    = digits=str "0123456789abcdef"
    | _ i.inc out.snoc_byte(digits.at((div n 16))).snoc_byte(digits.at((mod n 16)))
  + nibble
    \ c=nat
    ^ nat
    ? (and (ge c 48) (le c 57)) (sub c 48)
    ? (and (ge c 97) (le c 102)) (sub c 87)
    ? (and (ge c 65) (le c 70)) (sub c 55)
    | error (pails/t "invalid hex digit")
  + unhex
    \ text=str
    ^ row[nat]
    ? ((lt text.len 2) || !(equal text.slice(0 2) "0x")) (ethereum_bytes/fail "hex needs 0x prefix")
    ? (mod text.len 2) (ethereum_bytes/fail "hex needs whole bytes")
    % i=nat 2 out=row[nat] []
    ? (eq i text.len) out
    = byte (add (mul 16 (ethereum_bytes/nibble text.at(i))) (ethereum_bytes/nibble text.at(i.inc)))
    | _ (add i 2) out.snoc(byte)
  + rlp_length
    \ short=nat size=nat
    ^ row[nat]
    ? (lt size 56) [(add short size)]
    = encoded (ethereum_bytes/big (wid size) size)
    | (ethereum_bytes/zeroes 0).snoc((add (add short 55) encoded.len)).weld(encoded)
  + rlp_bytes
    \ bytes=row[nat]
    ^ row[nat]
    ? (? (eq bytes.len 1) (lt bytes.at(0) 128) .false) bytes
    | (ethereum_bytes/rlp_length 128 bytes.len).weld(bytes)
  + rlp_nat
    \ n=nat
    ^ row[nat]
    | ethereum_bytes/rlp_bytes (ethereum_bytes/big (wid n) n)
  + rlp_list
    \ items=row[row[nat]]
    ^ row[nat]
    = bytes | row/fold[row[nat] row[nat]] (ethereum_bytes/zeroes 0) (\ out=row[nat] item=row[nat] out.weld(item)) items
    | (ethereum_bytes/rlp_length 192 bytes.len).weld(bytes)
