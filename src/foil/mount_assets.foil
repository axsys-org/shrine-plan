- grove_dev

+ mount_assets
  + bundle
    : files=row[[str nat]]
  + slot
    ^ path
    | publisher_vocabulary/locate ['fs 'source 'assets]
  + bindings
    \ manifest=str
    ^ row[[str str]]
    ?> (jres/ok doc rest) (parse manifest) []
    ?> (json/obj entries) (grove_dev/field "assets" doc) []
    | entries.map (\ entry [entry.k (grove_dev/text entry.v)])
  + publish
    \ manifest=str files=row[[str nat]]
    ^ mount_assets/bundle
    = bindings (mount_assets/bindings manifest)
    | mount_assets/bundle
      | files.keep
        \ [name bytes]
        | bindings.any (\ [url filename] (equal filename name))
  + read
    ' Read one physical record, without materializing the mount source tree.
    \ home=path name=str state=namespace
    ^ maybe[nat]
    ?> (./some authority) state.history(home) .none
    ?> (./known record=myth) (ass/res authority.top (sov/hist home authority)) .none
    ?> (./some held) record.get(mount_assets/slot) .none
    ?> bundle=mount_assets/bundle held .none
    % idx=nat 0
    ^ maybe[nat]
    ? (eq idx bundle.files.len) .none
    = [filename bytes] bundle.files.at(idx)
    ? (equal filename name) (./some bytes)
    | _ idx.inc
