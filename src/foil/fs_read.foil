- sept

+ fs_read
  ' A flat directory snapshot. Bytes retain the native bar sentinel.
  + file
    : name=str bytes=nat

  + entries
    \ root=str ents=row[[directory=nat name=str]]
    ^ either[str row[fs_read/file]]
    % idx=nat 0 out=row[fs_read/file] []
    ^ either[str row[fs_read/file]]
    ? (eq idx ents.len)
     | ./ok out
    = [kind leaf] ents.at(idx)
    ? kind
     | _ idx.inc out
    = name | str/cat_all [root "/" leaf]
    = ;data | ReadFile name
    ? (eq data 0)
     | ./err (str/cat_all ["Cannot read file: " name])
    | _ idx.inc out.snoc((fs_read/file leaf data))

  + read
    ' ReadFolder conflates empty directories with listing failures.
    ' Its directory flag follows symlinks; other file kinds are untyped.
    \ root=str
    ^ either[str row[fs_read/file]]
    ? (equal[str] root "")
     | ./err "Filesystem directory is unset"
    = ;ents | ReadFolder root
    | %/entries root ents
