- sept

+ fs_read
  ' A flat directory snapshot. Bytes retain the native bar sentinel.
  + file
    : name=str bytes=nat

  + entries
    \ root=str ents=row[[directory=nat name=str]]
    ^ either[str row[fs_read/file]]
    % idx=nat 0 out=row[fs_read/file] []
    ^ either[str row[fs_read/file]]
    ? (eq idx ents.len)
     | ./ok out
    = [kind leaf] ents.at(idx)
    ? kind
     | _ idx.inc out
    = name | str/cat_all [root "/" leaf]
    = ;data | ReadFile name
    ? (eq data 0)
     | ./err (str/cat_all ["Cannot read file: " name])
    | _ idx.inc out.snoc((fs_read/file leaf data))

  + read
    ' ReadFolder conflates empty directories with listing failures.
    ' Its directory flag follows symlinks; other file kinds are untyped.
    \ root=str
    ^ either[str row[fs_read/file]]
    ? (equal[str] root "")
     | ./err "Filesystem directory is unset"
    = ;ents | ReadFolder root
    | %/entries root ents

  + response
    \ fd=nat
    ^ str
    % chunks=row[str] [] size=nat 0
    ^ str
    = ;bytes (Read fd 4096)
    ? (le bytes 1) (str/cat_all chunks)
    = text (str/from_atom (mod bytes (bex (mul 8 (dec (wid bytes))))))
      size (add size text.len)
    ? (gt size 4096) "Scanner response too large"
    | _ chunks.snoc(text) size

  + remote
    ' Refresh one selected bag through the host scanner, then capture its bytes.
    \ port=nat token=str root=str
    ^ either[str row[fs_read/file]]
    ? (eq port 0) (fs_read/read root)
    = ;fd (Connect 0 "127.0.0.1" port)
      line (str/cat_all [token (str/from_atom 10) root (str/from_atom 10)])
      bytes (add (str/to_atom line) (bex (mul 8 line.len)))
    ; (Write fd bytes)
    = ;received (Try fs_read/response fd)
    ; (CloseFd fd)
    ?> (./ok text) received (./err "Scanner connection failed")
    ? !(equal[str] text "OK") (./err text)
    | fs_read/read root
