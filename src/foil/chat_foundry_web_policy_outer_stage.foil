-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  surface [order=50]
-  chat_foundry_occurrence [order=60]
-  chat_foundry_web_mount [order=70]
-  chat_foundry_web_policy_result [order=80]
'  Quarantined compatibility policy for the outer Stage prefix.  These legacy
'  branches remain an ordered terminal adapter; they are not Foundry IR.
+  chat_foundry_web_policy_outer_stage
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_template_is
          ['foundry 'system 'blocks 'plate_header] occurrence)
       (chat_foundry_web_policy_result .true
         [(surface/plate_header children)] .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'desktop 'workspace] occurrence)
       (chat_foundry_web_policy_result .true children .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'stage_flow 'root_scene] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "section" [(weft/cls "desktop-stage")] children)] .none)
    ?  (chat_foundry_occurrence/occurrence_role_is ['life 'plate] occurrence)
       =  [mounts issue]
            (chat_foundry_web_mount/plan_hole_mount occurrence "life" .x
              [['app 'life 'weft 'foundry 'plate]
               ['app 'life 'weft 'foundry 'web]])
       ?  issue
        > (./some code=iota)
          (chat_foundry_web_policy_result .true [] (./some code))
        > .none
          (chat_foundry_web_policy_result .true
            [(weft/el "article" [(weft/cls "stage-window secondary")]
               [(surface/window_chrome "Life" "Scene Plate / background")
                (weft/el "div" [(weft/cls "window-content")] mounts)])]
            .none)
    (chat_foundry_web_policy_result .false [] .none)
