-  sept [order=10]
-  shrine_types [order=20]
-  json [order=30]
-  tyshow [order=40]
-  foundry_delivery [order=50]
-  foundry_pronounce [order=60]
-  foundry_pronounce_walk [order=70]
'  foundry_codegen: deterministic source artifacts over one completed addressed
'  semantic DAG.  Runtime Fragments are a sibling felt target; generated text
'  becomes a Fragment only when a host explicitly installs it under a codec.

+  projection_generated_artifact
  '  Build material plus the minimum evidence needed to reproduce and audit it.
  '  digest covers body bytes only; revision and roots name the completed
  '  semantic input, while generator names the versioned mechanical producer.
  '  This record is not a runtime Fragment and carries no local target handle.
  :  target=iota
     media=nat
     body=nat
     revision=foundry_digest
     roots=row[projection_address]
     generator=path
     digest=foundry_digest
     evidence=row[projection_parameter]

+  projection_generation_refusal
  '  Refusal provenance is as inspectable as successful generation.  `at`
  '  retains the exact addressed occurrence when the completed DAG boundary
  '  can supply one; generator identifies the mechanical boundary that said no.
  :  code=iota at=maybe[projection_address] generator=path

+  projection_generation_result
  &  projection_generation_result/admitted
     projection_generation_result/refused

  +  admitted
    :  artifact=projection_generated_artifact
  +  refused
    :  refusal=projection_generation_refusal

+  foundry_codegen
  +  generator
    ^  path
    ['foundry 'codegen 'v1]

  +  path_text
    \  value=path separator=nat
    ^  nat
    |  > i=nat 0  > out=nat ""
    ?  (ge i value.len)
       out
    =  part  (tyshow/atom_text (quip_val value.at(i)))
       next
         ?  (eq i 0)
            part
         (cat2 out (cat2 separator part))
    (_ i.inc next)

  +  quoted_path
    \  value=path
    ^  nat
    (show_str (cat2 "/" (foundry_codegen/path_text value "/")))

  +  value_text
    '  Mechanical source spelling.  No case derives a new semantic role.
    \  value=projection_value
    ^  nat
    ?  value
     > x=projection_value/flag
       ?  x.value  "true"
       "false"
     > x=projection_value/count  (show_nat x.value)
     > x=projection_value/text   x.value
     > x=projection_value/name
       (tyshow/atom_text (quip_val x.value))
     > x=projection_value/semantic_ref
       (cat2 "/" (foundry_codegen/path_text x.value "/"))
     > projection_value/ref  "[addressed-occurrence]"

  +  path_prefix
    \  prefix=path value=path
    ^  bool
    ?  (gt prefix.len value.len)
       .false
    |  > i=nat 0
    ?  (ge i prefix.len)
       .true
    ?  !(eq_iota prefix.at(i) value.at(i))
       .false
    (_ i.inc)

  +  css_parameters
    \  parameters=row[projection_parameter] index=nat out=nat
    ^  nat
    ?  (ge index parameters.len)
       out
    =  parameter  parameters.at(index)
       prefix=path  ['foundry 'resolved 'token]
    ?  !(foundry_codegen/path_prefix prefix parameter.key)
       (_ parameters index.inc out)
    =  token  parameter.key.drop(prefix.len)
       name   (foundry_codegen/path_text token "-")
       value  (foundry_codegen/value_text parameter.value)
       line   (cat2 "  --foundry-" (cat2 name (cat2 ":" (cat2 value ";\n"))))
    (_ parameters index.inc (cat2 out line))

  +  css_occurrences
    \  occurrences=row[projection_pronunciation_occurrence]
       index=nat out=nat
    ^  nat
    ?  (ge index occurrences.len)
       out
    =  occurrence  occurrences.at(index)
       next  (foundry_codegen/css_parameters occurrence.parameters 0 out)
    (_ occurrences index.inc next)

  +  css_body
    \  pronunciation=projection_pronunciation
    ^  nat
    (cat2 "/* Generated by /foundry/codegen/v1; do not edit. */\n:root{\n"
      (cat2
        (foundry_codegen/css_occurrences pronunciation.occurrences 0 "")
        "}\n"))

  +  role_union
    \  occurrences=row[projection_pronunciation_occurrence]
       index=nat out=nat
    ^  nat
    ?  (ge index occurrences.len)
       out
    =  occurrence  occurrences.at(index)
       role  (foundry_codegen/quoted_path occurrence.role)
       next
         ?  (eq index 0)
            role
         (cat2 out (cat2 " | " role))
    (_ occurrences index.inc next)

  +  typescript_body
    \  pronunciation=projection_pronunciation
    ^  nat
    (cat2 "// Generated by /foundry/codegen/v1; do not edit.\nexport type FoundryRole = "
      (cat2
        (foundry_codegen/role_union pronunciation.occurrences 0 "never")
        ";\n"))

  +  docs_lines
    \  occurrences=row[projection_pronunciation_occurrence]
       index=nat out=nat
    ^  nat
    ?  (ge index occurrences.len)
       out
    =  occurrence  occurrences.at(index)
       kind  (tyshow/atom_text (quip_val occurrence.kind))
       role  (foundry_codegen/path_text occurrence.role "/")
       '  A one-byte escaped newline is not a valid Foil leaf literal; append
       '  its byte value directly.
       line  (cat2 kind (cat2 " /" (cat2 role 10)))
    (_ occurrences index.inc (cat2 out line))

  +  docs_body
    \  pronunciation=projection_pronunciation
    ^  nat
    (cat2 "# Foundry projection\n\nGenerated by `/foundry/codegen/v1`.\n\n"
      (foundry_codegen/docs_lines pronunciation.occurrences 0 ""))

  +  target_media
    \  target=iota
    ^  nat
    ?  (eq_iota target 'css)  "text/css"
    ?  (eq_iota target 'typescript)  "text/typescript"
    ?  (eq_iota target 'docs)  "text/plain"
    0

  +  target_body
    \  target=iota pronunciation=projection_pronunciation
    ^  nat
    ?  (eq_iota target 'css)
       (foundry_codegen/css_body pronunciation)
    ?  (eq_iota target 'typescript)
       (foundry_codegen/typescript_body pronunciation)
    ?  (eq_iota target 'docs)
       (foundry_codegen/docs_body pronunciation)
    0

  +  content_digest
    '  A content digest is deliberately independent of revision packaging.
    '  Equal output bytes have equal digests even when two admitted revisions
    '  happen to pronounce identically.
    \  body=nat
    ^  foundry_digest
    (pin_hash (pin_save (pin body)))

  +  fallback_parameter
    \  parameter=projection_parameter
    ^  bool
    ?  (foundry_codegen/path_prefix ['foundry 'fallback] parameter.key)
       .true
    ?  (foundry_codegen/path_prefix ['surface 'fallback] parameter.key)
       .true
    (foundry_codegen/path_prefix ['slot 'fallback] parameter.key)

  +  fallback_parameters
    \  parameters=row[projection_parameter] index=nat
       out=row[projection_parameter]
    ^  row[projection_parameter]
    ?  (ge index parameters.len)  out
    =  parameter  parameters.at(index)
    ?  (foundry_codegen/fallback_parameter parameter)
       (_ parameters index.inc out.snoc(parameter))
    (_ parameters index.inc out)

  +  fallback_evidence
    '  Preserve declared progressive fallback facts and exact selected Slot
    '  fallback class/Recipe facts in terminal occurrence order.
    \  occurrences=row[projection_pronunciation_occurrence] index=nat
       out=row[projection_parameter]
    ^  row[projection_parameter]
    ?  (ge index occurrences.len)  out
    =  occurrence  occurrences.at(index)
       with_node
         (foundry_codegen/fallback_parameters occurrence.parameters 0 out)
       with_placement
         (foundry_codegen/fallback_parameters occurrence.placement_parameters
           0 with_node)
    (_ occurrences index.inc with_placement)

  +  refuse
    \  code=iota at=maybe[projection_address]
    ^  projection_generation_result
    (projection_generation_result/refused
      (projection_generation_refusal code at foundry_codegen/generator))

  +  generate_pronunciation
    \  target=iota pronunciation=projection_pronunciation
    ^  projection_generation_result
    =  media  (foundry_codegen/target_media target)
    ?  (eq media 0)
       (foundry_codegen/refuse 'generator_target_unsupported .none)
    ?  !(foundry_digest/valid pronunciation.revision)
       (foundry_codegen/refuse 'generator_revision_invalid .none)
    ?  (eq pronunciation.roots.len 0)
       (foundry_codegen/refuse 'generator_root_missing .none)
    ?  !(foundry_delivery/addresses_valid pronunciation.roots)
       (foundry_codegen/refuse 'generator_root_invalid .none)
    ?  (eq pronunciation.occurrences.len 0)
       (foundry_codegen/refuse 'generator_occurrence_missing .none)
    =  body  (foundry_codegen/target_body target pronunciation)
       digest  (foundry_codegen/content_digest body)
       evidence
         (foundry_codegen/fallback_evidence pronunciation.occurrences 0 [])
    (projection_generation_result/admitted
      (projection_generated_artifact target media body pronunciation.revision
        pronunciation.roots foundry_codegen/generator digest evidence))

  +  generate
    '  The public boundary accepts only a DAG already admitted as complete by
    '  foundry_pronounce.  Incomplete and cyclic graphs remain refusals.
    \  target=iota dag=projection_dag
    ^  projection_generation_result
    ?  (foundry_pronounce_walk/pronounce dag)
     > x=projection_pronunciation_result/refused
       (foundry_codegen/refuse x.refusal.code x.refusal.at)
     > x=projection_pronunciation_result/admitted
       (foundry_codegen/generate_pronunciation target x.pronunciation)

  +  result_admitted
    \  result=projection_generation_result
    ^  bool
    ?  result
     > projection_generation_result/admitted  .true
     > projection_generation_result/refused   .false

  +  result_artifact
    \  result=projection_generation_result
    ^  maybe[projection_generated_artifact]
    ?  result
     > x=projection_generation_result/admitted  (./some x.artifact)
     > projection_generation_result/refused     .none

  +  result_code
    \  result=projection_generation_result
    ^  maybe[iota]
    ?  result
     > projection_generation_result/admitted  .none
     > x=projection_generation_result/refused
       (./some x.refusal.code)

  +  result_refusal
    \  result=projection_generation_result
    ^  maybe[projection_generation_refusal]
    ?  result
     > projection_generation_result/admitted  .none
     > x=projection_generation_result/refused  (./some x.refusal)

  +  artifact_body
    \  artifact=projection_generated_artifact
    ^  nat
    artifact.body

  +  artifact_digest_of
    \  artifact=projection_generated_artifact
    ^  foundry_digest
    artifact.digest

  +  artifact_revision
    \  artifact=projection_generated_artifact
    ^  foundry_digest
    artifact.revision

  +  artifact_roots
    \  artifact=projection_generated_artifact
    ^  row[projection_address]
    artifact.roots

  +  artifact_generator
    \  artifact=projection_generated_artifact
    ^  path
    artifact.generator

  +  artifact_target
    \  artifact=projection_generated_artifact
    ^  iota
    artifact.target

  +  artifact_media
    \  artifact=projection_generated_artifact
    ^  nat
    artifact.media

  +  artifact_evidence
    \  artifact=projection_generated_artifact
    ^  row[projection_parameter]
    artifact.evidence

  +  refusal_code
    \  refusal=projection_generation_refusal
    ^  iota
    refusal.code

  +  refusal_at
    \  refusal=projection_generation_refusal
    ^  maybe[projection_address]
    refusal.at

  +  refusal_generator
    \  refusal=projection_generation_refusal
    ^  path
    refusal.generator
