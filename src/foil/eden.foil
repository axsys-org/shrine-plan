-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  http [order=65]
-  web [order=70]
-  helm [order=80]
- http_response
-  http_foot
- fs_sync_foot
'  Eden's first boot milestone: Pact, a browsable namespace, and HTTP.
'  Base installation runs through Lain before Eden starts actors.
'  Grove instances install later through the supervisor.
+  eden
  +  failed
    : stage=iota reason=iota

  +  manifest
    ^ mani
    | mani 'eden (lore/line "Eden: the live namespace.")
      [(kook/decl 'hserve http/serve_form (lore/line "HTTP request serving."))
       (kook/decl 'fs fs/form
         (lore/line "Filesystem scan requests."))
       (kook/decl 'hex explorer/form (lore/line "The namespace explorer."))
       (kook/decl 'ward ward/form (lore/line "Contract adoption."))
       (kook/decl 'fresh fresh/form (lore/line "Live references."))]
      [[['gov] (root/card "Published Grove definitions and templates.")]
       [['app] (root/card "Applications.")]
       [['io] (root/card "Live I/O drivers.")]
       [['boot] (root/card "Compiled module records; compiler mirroring is not installed yet.")]
       [['weft] (root/card "Component registry.")]
       [['weft 'kook 'face] (form/card zoo/form (lore/line "Component zoo."))]
       [['hello] (myth/sing ['message] (pails/t "Hello from Eden."))]]
      []

  + boot
    ' The caller supplies a node identity and a trusted system pin.
    ' Boot returns a namespace only after every local stage succeeds.
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ either[eden/failed namespace]
    ? ((eq port 0) || (gt port 65535))
      | ./err (eden/failed 'http 'invalid_port)
    ?> (./ok initial) (namespace/create self local system)
      | ./err (eden/failed 'namespace 'invalid_namespace)
    = root=path [self]
      registry=path [self 'kook 'pact]
      first
        | task/vine registry
          (writ/make (form/card pact/form
            (lore/line "Pact: application mounting.")))
      mounted
        | (pact/card eden/manifest "eden" 0 0).put
          limb_slot (kook [registry])
      second | task/vine root (writ/make mounted)
      listener
        | http/cfg_port [self 'kook 'hserve]
          [self 'kook 'hex] port
      third
        | task/vine [self 'io 'http] (writ/make listener)
      filesystem | root/card "Filesystem sync instances."
      fourth
        | task/vine [self 'io 'fs] (writ/make filesystem)
      stages=row[[iota task]]
        [['pact first] ['namespace second]
         ['http third] ['fs fourth]]
    % idx=nat 0 state=namespace initial
    ^ either[eden/failed namespace]
    ? (eq idx stages.len) (./ok state)
    = [name command] stages.at(idx)
    ? (sovereign_run_event command 0 0 0 state)
     > (./fail why) (./err (eden/failed name why))
     > (./ripe next effects signs ack)
       ? effects.len
         | ./err (eden/failed name 'unexpected_boot_effect)
       | _ idx.inc next

  +  make
    '  Typed constructors for the browser route adapter.
    \ target=path record=myth
    ^ task
    | task/vine target (writ/make record)
  +  poke
    \ target=path record=myth
    ^ task
    | task/vine target (writ/poke record)
  +  cull
    \ target=path
    ^ task
    | task/vine target .cull
  +  warp
    \ target=path operation=path input=myth
    ^ task
    | task/vine target (writ/warp operation input)
  +  err
    : msg=str
  +  throw
    \ txt=str
    ^ nat
    | error | eden/err | txt
  + serve
    \ state=namespace
    ^ nat
    | eden/serve_with state http_foot/run
  + serve_with
    \ state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    = start
        \ self=nat
        ^ nat
        | helm/supervisor/run state self
    = ;server (Spawn start)
      registrations=row[helm/supervisor/register]
        [(helm/supervisor/register [state.self 'io 'fs] fs_foot/run)
         (helm/supervisor/register [state.self 'io 'http]
           entry)]
    % idx=nat 0
    ^ nat
    ? (eq idx registrations.len) server
    ; (SendCaps server registrations.at(idx) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./ack err)
       ? err
        > .none (_ idx.inc)
        > (./some why) (error why)
    | eden/throw "Foot registration failed"

  + main
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ nat
    ? (eden/boot self system local port)
     > (./err why) (error why)
     > (./ok state) (eden/serve state)
