-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  http [order=65]
-  web [order=70]
-  helm [order=80]
- http_response
-  http_foot
'  Eden's first boot milestone: Pact, a browsable namespace, and HTTP.
'  All installation runs through Lain before Eden starts any actors.
'  Compiler rebuilding and filesystem import are subsequent boot stages.
+  eden
  +  result
    & eden/ready eden/failed
  +  ready
    : state=sov
  +  failed
    : stage=iota reason=iota

  +  first
    '  Install the mount implementation before any manifest can use it.
    ^ task
    | task/vine ['pact]
      (writ/make (form/card pact/form (lore/line "Pact: application mounting.")))

  +  manifest
    ^ mani
    | mani 'eden (lore/line "Eden: the live namespace.")
      [(kook/decl 'hserve http/serve_form (lore/line "HTTP request serving."))
       (kook/decl 'hex explorer/form (lore/line "The namespace explorer."))
       (kook/decl 'ward ward/form (lore/line "Contract adoption."))
       (kook/decl 'fresh fresh/form (lore/line "Live references."))]
      [[['app] (root/card "Applications.")]
       [['io] (root/card "Live I/O drivers.")]
       [['boot] (root/card "Compiled module records; compiler mirroring is not installed yet.")]
       [['weft] (root/card "Component registry.")]
       [['weft 'kook 'face] (form/card zoo/form (lore/line "Component zoo."))]
       [['hello] (myth/sing ['message] (pails/t "Hello from Eden."))]]
      []

  +  second
    '  Mount at the root through /pact, preserving that bootstrap child.
    ^ task
    = card (pact/card eden/manifest "eden" 0 0)
      card card.put(limb_slot (kook [['pact]]))
    | task/vine [] (writ/make card)

  +  third
    '  The listener is installed last, after its forms and namespace exist.
    \ port=nat
    ^ task
    | task/vine ['io 'http] (writ/make (http/cfg_port 'hex port))

  +  install
    '  Required boot stages fail closed. No partial state reaches the host.
    \ stages=row[[name=iota command=task]]
    ^ eden/result
    % idx=nat 0 state=sov sov/new
    ^ eden/result
    ? (eq idx stages.len) (./ready state)
    = [name command] stages.at(idx)
    ? (run_event command 0 state)
     > (./fail reason) (./failed name reason)
     > (./ripe next effects signs ack)
       ? effects.len (./failed name 'unexpected_boot_effect)
       | _ idx.inc next

  +  boot
    \ port=nat
    ^ eden/result
    ? ((eq port 0) || (gt port 65535)) (./failed 'http 'invalid_port)
    | eden/install [['pact eden/first] ['namespace eden/second] ['http (eden/third port)]]

  +  make
    '  Typed constructors for the browser route adapter.
    \ target=path record=myth
    ^ task
    | task/vine target (writ/make record)
  +  poke
    \ target=path record=myth
    ^ task
    | task/vine target (writ/poke record)
  +  cull
    \ target=path
    ^ task
    | task/vine target .cull
  +  warp
    \ target=path operation=path input=myth
    ^ task
    | task/vine target (writ/warp operation input)
  +  err
    : msg=str
  +  throw
    \ txt=str
    | error | eden/err | txt
  +  main
    '  Boot the namespace, register its HTTP foot, and return the supervisor.
    '  ports is currently the HTTP port; config is reserved.
    \ ports=nat config=nat
    ^ nat
    ? (eden/boot ports)
     > (./failed stage reason)
      | error (eden/failed stage reason)
     > (./ready state)
      = ;server (Spawn (helm/supervisor/run state))
      ; (SendCaps server
          (helm/supervisor/register ['io 'http] http_foot/run) [0])
      = ;[reply caps] (Recv[feet/task[unit]] 0)
      ? reply
       > (./ack err)
        ? err
         > .none server
         > (./some reason) (error reason)
      | eden/throw "HTTP foot registration failed"
