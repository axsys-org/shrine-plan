-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  http [order=65]
-  helm [order=80]
- http_response
-  http_foot
- fs_sync_foot
- weft_std
'  Eden boots the namespace and core services; mounts supply applications.
'  Base installation runs through Lain before Eden starts actors.
'  Grove instances install later through the supervisor.
+  eden
  +  failed
    : stage=iota reason=iota

  +  manifest
    ^ mani
    = roots=row[[path myth]]
        [[['gov] (root/card "Published Grove definitions and templates.")]
         [['app] (root/card "Applications.")]
         [['io] (root/card "Live I/O drivers.")]
         [['boot] (root/card "Compiled module records; compiler mirroring is not installed yet.")]
         [['weft] (root/card "Component registry.")]
         [['hello] (myth/sing ['message] (pails/t "Hello from Eden."))]]
    | mani 'eden (lore/line "Eden: the live namespace.")
      [(kook/decl 'hserve http/serve_form (lore/line "HTTP request serving."))
       (kook/decl 'fs fs/form
         (lore/line "Filesystem scan requests."))
       (kook/decl 'ward ward/form (lore/line "Contract adoption."))
       (kook/decl 'fresh fresh/form (lore/line "Live references."))]
      roots.weld(weft_std/seeds)
      []

  + boot
    ' The caller supplies a node identity and a trusted system pin.
    ' Boot returns a namespace only after every local stage succeeds.
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ either[eden/failed namespace]
    ? ((eq port 0) || (gt port 65535))
      | ./err (eden/failed 'http 'invalid_port)
    ?> (./ok initial) (namespace/create self local system)
      | ./err (eden/failed 'namespace 'invalid_namespace)
    = root=path [self]
      registry=path [self 'kook 'pact]
      first
        | task/vine registry
          (writ/make (form/card pact/form
            (lore/line "Pact: application mounting.")))
      mounted
        | (pact/card eden/manifest "eden" 0 0).put
          limb_slot (kook [registry])
      second | task/vine root (writ/make mounted)
      listener
        | http/cfg_port [self 'kook 'hserve]
          [self 'kook 'hserve] port
      third
        | task/vine [self 'io 'http] (writ/make listener)
      filesystem | root/card "Filesystem sync instances."
      fourth
        | task/vine [self 'io 'fs] (writ/make filesystem)
      stages=row[[iota task]]
        [['pact first] ['namespace second]
         ['http third] ['fs fourth]]
    % idx=nat 0 state=namespace initial
    ^ either[eden/failed namespace]
    ? (eq idx stages.len) (./ok state)
    = [name command] stages.at(idx)
    ? (sovereign_run_event command 0 0 0 state)
     > (./fail why) (./err (eden/failed name why))
     > (./ripe next effects signs ack)
       ? effects.len
         | ./err (eden/failed name 'unexpected_boot_effect)
       | _ idx.inc next

  +  make
    '  Typed constructors for the browser route adapter.
    \ target=path record=myth
    ^ task
    | task/vine target (writ/make record)
  +  poke
    \ target=path record=myth
    ^ task
    | task/vine target (writ/poke record)
  +  cull
    \ target=path
    ^ task
    | task/vine target .cull
  +  warp
    \ target=path operation=path input=myth
    ^ task
    | task/vine target (writ/warp operation input)
  +  err
    : msg=str
  +  throw
    \ txt=str
    ^ nat
    | error | eden/err | txt
  + serve
    \ state=namespace
    ^ nat
    | eden/serve_with state http_foot/run
  + serve_with
    \ state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    | eden/serve_access helm/supervisor/local_access state entry
  + serve_access
    \ access=helm/supervisor/access[namespace]
      state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    | eden/serve_read access fs_read/read state entry
  + serve_read
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
    ^ nat
    = idle
        \ ignored=namespace
        ^ nat
        | 0
    | eden/serve_keeping access reader state entry idle
  + serve_keeping
    '  serve_read, and keep sees every admitted state
    '  (helm/supervisor/run_keeping).
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
      keep={\ namespace}nat
    ^ nat
    = start
        \ self=nat
        ^ nat
        | helm/supervisor/run_keeping[namespace] access keep state self
    = ;server (Spawn start)
      registrations=row[helm/supervisor/register]
        [(helm/supervisor/register [state.self 'io 'fs] (fs_foot/run_with reader))
         (helm/supervisor/register [state.self 'io 'http]
           entry)]
    % idx=nat 0
    ^ nat
    ? (eq idx registrations.len) server
    ; (SendCaps server registrations.at(idx) [0])
    = ;[reply caps] (Recv[feet/task[unit]] 0)
    ; (helm/supervisor/close_caps caps)
    ? reply
     > (./ack err)
       ? err
        > .none (_ idx.inc)
        > (./some why) (error why)
    | eden/throw "Foot registration failed"

  + serve_saved
    '  Serve, and save the world as the store root after every event:
    '  running the snapshot again resumes it (eden/resume).  install
    '  installs the compiler; the runtime forgets it between processes.
    \ access=helm/supervisor/access[namespace]
      reader={\ str}either[str row[fs_read/file]]
      state=namespace entry={\ feet/task/init nat}nat
      install={\ nat}nat
    ^ nat
    | eden/serve_keeping access reader state entry
      (eden/keeper access entry install)
  + keeper
    '  The keep that saves the world: the store root becomes the program
    '  that serves this state again.
    \ access=helm/supervisor/access[namespace]
      entry={\ feet/task/init nat}nat install={\ nat}nat
    ^ {\ namespace}nat
    \ state=namespace
    ^ nat
    | Save (pin (eden/resume access entry install state))
  + resume
    '  The program a saved world's store root holds.  The runtime applies
    '  it to its argument row, the scanner port and token (fs_read/remote,
    '  both optional): it installs the compiler, prints EDEN-RESUMED and
    '  serves the state, saving after every event as before.
    \ access=helm/supervisor/access[namespace]
      entry={\ feet/task/init nat}nat install={\ nat}nat
      state=namespace
    ^ {\ row[str]}nat
    \ args=row[str]
    ^ nat
    = port (eden/arg_nat args 0)
      token (eden/arg_str args 1)
      reader
        \ root=str
        ^ either[str row[fs_read/file]]
        | fs_read/remote port token root
    ; (install 0)
    ; (Trace "EDEN-RESUMED" 0)
    = ;server (eden/serve_saved access reader state entry install)
    '  The runtime ends every actor when the root program returns, and
    '  on a fresh boot it is the repl reading stdin that keeps the world
    '  alive.  Read stdin the same way: the launcher holds the pipe open,
    '  and closing it is the stop.  Whatever arrives is ignored.
    % served=nat server
    ^ nat
    = ;got (Input 65536)
    ? (le got 1) served
    | _ served
  + arg_nat
    \ args=row[str] idx=nat
    ^ nat
    ? (le args.len idx) 0
    ? (nat/parse args.at(idx))
     > (./some n) n
    0
  + arg_str
    \ args=row[str] idx=nat
    ^ str
    ? (le args.len idx) ""
    | args.at(idx)
  + main
    \ self=iota system=pin[system_publication] local=sov port=nat
    ^ nat
    ? (eden/boot self system local port)
     > (./err why) (error why)
     > (./ok state) (eden/serve state)
