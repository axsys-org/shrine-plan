- grove_backend
- grove_template
- weft
- show
- value_read
- pact
' Inspection-only presentation of the real hydrated namespace. This module
' never evaluates a compiled export, installs a template, or runs an action.
' row/take pads to its requested width: clamp preview counts to the real
' source length before mapping, so zero values never become invented rows.
+ debug_model
  + url
    \ p=path
    ^ nat
    ? (eq p.len 0) "/debug"
    | weft/cat2 "/debug" (show/path p)
  + link
    \ p=path
    ^ weft/node
    | weft/el "a"
      [(weft/href (debug_model/url p))
       (weft/att "data-reference" (show/path p))]
      [(weft/tx (show/path p))]
  + field
    \ key=nat value=nat
    ^ weft/node
    = markup
        ~ weft/build
        ~# 'div.debug-fact
          'data-debug-field ""
          'data-key key
          ~. 'span.debug-fact-label key
          ~. 'span.debug-fact-value (show/clip 768 value)
    markup.at(0)
  + ref
    \ key=nat p=path
    ^ weft/node
    = markup
        ~ weft/build
        ~# 'div.debug-fact
          'data-debug-field ""
          'data-key key
          'data-reference (show/path p)
          ~. 'span.debug-fact-label key
          [(debug_model/link p)]
    markup.at(0)
  + kind
    \ tgt=path view=axal[myth]
    ^ nat
    ? (eq_pith tgt ['log]) "journal"
    ?> (./some card) view.fil "namespace"
    ? (debug_model/mounted card) "application"
    ? (card.has(['sys 'grove 'role])) "role"
    ? (card.has(['sys 'grove 'action])) "action"
    ? (card.has(['sys 'grove 'norm])) "norm"
    ? (card.has(['sys 'grove 'sewn])) "sewn"
    ? (card.has(grove_templates/slot)) "template"
    ? (card.has(['ev])) "event"
    ? (card.has(['method])) "http"
    ? (card.has(['form])) "behavior"
    ? (card.has(grove_backend/module_slot)) "module"
    "record"
  + mounted
    \ card=myth
    ^ bool
    ?> (./some held) card.get(pact/slot) .false
    | mani/ok held
  + manifest
    ' Render the typed manifest, never parse its printed representation.
    ' Addresses are relative to THIS inspected mount, including history views.
    \ root=path app=mani card=myth
    ^ row[weft/node]
    ~ weft/build
    ~# 'section.wb-manifest
      'aria-label "Manifest"
      ~| 'header.wb-manifest-heading
        ~. 'ui-icon[name=object.layers][size=small][aria-hidden=true]
        ~. 'h2 (show/iota app.name)
        ~. 'ui-badge[tone=neutral] "Manifest"
      ? app.doc.head
        ~. 'p.wb-manifest-lede app.doc.head
      % line app.doc.body
        ? !((eq line 0) || (eq line app.doc.head))
          ~. 'p.lore-line line
      ~| 'ui-accordion[variant=quiet][size=compact][mode=multiple]
        ~| 'ui-accordion-item[value=kooks][title=Kooks][open][heading-level=3]
          ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
          ~. 'span[slot=suffix] (weft/show_nat app.kooks.len)
          % declaration app.kooks
            ~# 'sh-path-row
              'href (debug_model/url root.weld(['kook declaration.id]))
              'label (show/iota declaration.id)
              ~. 'ui-icon[slot=icon][name=action.play][size=small][aria-hidden=true]
              ~. 'span[slot=meta] declaration.lore.head
          ? (eq app.kooks.len 0)
            ~. 'p.wb-context-note "No declared kooks."
        ~| 'ui-accordion-item[value=seeds][title=Seeds][open][heading-level=3]
          ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
          ~. 'span[slot=suffix] (weft/show_nat app.seeds.len)
          % seed app.seeds
            = [relative record] seed
            ~# 'sh-path-row[previewable]
              'href (debug_model/url root.weld(relative))
              'label (show/path relative)
              'preview-label (weft/cat2 "Declared seed " (show/path relative))
              ~. 'ui-icon[slot=icon][name=object.document][size=small][aria-hidden=true]
              ~. 'span[slot=meta] (myth/txt_at bond/lede record)
              ~| 'sh-myth[slot=preview][variant=embedded][data-mash-size=compact]
                % entry record.tap
                  ~| 'sh-limb
                    ~# 'sh-slot[slot=label]
                      'title (show/path entry.key)
                    ~| 'sh-pail[slot=value]
                      | debug_model/value entry.key entry.val
          ? (eq app.seeds.len 0)
            ~. 'p.wb-context-note "No declared seeds."
        ~| 'ui-accordion-item[value=capabilities][title=Capabilities][heading-level=3]
          ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
          [(debug_model/field "Wants · fetch" (weft/show_nat (grant/has_fetch app.wants)))
           (debug_model/field "Wants · serve port" (weft/show_nat (grant/serve_port app.wants)))
           (debug_model/field "Granted · fetch" (show/pail card.get(['grants 'fetch]).fall((pails/t "Unreported"))))
           (debug_model/field "Granted · serve port" (show/pail card.get(['grants 'serve]).fall((pails/t "Unreported"))))]
          ? (eq app.wants.len 0)
            ~. 'p.wb-context-note "No driver capabilities requested."
  + label
    \ tgt=path view=axal[myth]
    ^ nat
    ?> (./some card) view.fil (show/path tgt)
    = lede (myth/txt_at bond/lede card)
    ? lede (show/clip 120 lede)
    ? card.get(bond/help)
     > (./some held)
       ? held
        > doc=lore
          ? doc.head (show/clip 120 doc.head)
          | show/path tgt
       | show/path tgt
     > .none (show/path tgt)
  + lore_description
    ' A short authored excerpt, not a type-derived explanation. Compiler
    ' lore often repeats the headline as its first body line; do not echo it.
    \ doc=lore
    ^ nat
    % idx=nat 0
    ? (ge idx doc.body.len) ""
    = line doc.body.at(idx)
    ? (eq line 0) (| _ idx.inc)
    ? (eq line doc.head) (| _ idx.inc)
    | show/clip 384 line
  + description
    \ tgt=path view=axal[myth]
    ^ nat
    ?> (./some card) view.fil ""
    ?> (./some held) card.get(bond/help) ""
    ? held
     > doc=lore (debug_model/lore_description doc)
     > (pails/t text)
       ? (eq text (myth/txt_at bond/lede card)) ""
       | show/clip 384 text
    ""
  + write_verb
    \ w=writ
    ^ nat
    ? w
     > (./make card) "Replace"
     > (./poke card) "Update"
     > .cull "Delete"
     > (./warp op input) "Run operation"
  + event_verb
    \ event=log_card
    ^ nat
    ? event.t
     > (./vine p w) (debug_model/write_verb w)
     > (./hear news) "Notify dependents"
  + event_target
    \ event=log_card
    ^ path
    ? event.t
     > (./vine p w) p
     > (./hear news) []
  + operation
    \ w=writ
    ^ row[weft/node]
    ? w
     > (./warp op input) [(debug_model/ref "Operation" op)]
     > (./make card) []
     > (./poke card) []
     > .cull []
  + role
    \ schema=grove_role_schema
    ^ row[weft/node]
    ~ weft/build
    ~| 'div.debug-role-fields
      % field schema.fields
        ~# 'div.debug-schema-field
          'data-debug-field ""
          'data-key field.name
          'data-reference (show/path field.slot)
          ~. 'strong field.name
          [(debug_model/link field.slot)]
          ~. 'span.muted (? field.optional "optional" "required")
      ? (eq schema.fields.len 0)
        ~. 'p.muted "No declared slots."
    ? schema.need.len
      ~| 'div.debug-requirements
        ~. 'h3 "Presence requirements"
        % group schema.need
          ~| 'div.debug-requirement
            ~. 'span.muted "At least one of"
            % slot group
              [(debug_model/link slot)]
  + norm
    \ schema=grove_norm_schema
    ^ row[weft/node]
    ~ weft/build
    ~| 'div.debug-norm-path
      ~. 'h3 "Path pattern"
      % segment schema.segments
        ~| 'div.debug-fact
          ~. 'span.debug-fact-label segment.name
          ? segment.pattern
           > (zeta/lit value)
             ~. 'code (show/iota value)
           > (zeta/var aura)
             ~. 'code (weft/cat2 "variable · " aura)
    ~. 'h3 "Record requirements"
    | debug_model/role schema.item
  + effect
    \ effect=move
    ^ weft/node
    | weft/el "div" [(weft/cls "debug-effect")]
      [(debug_model/field "Command" (debug_model/write_verb effect.w))
       (debug_model/ref "From" effect.src)
       (debug_model/ref "To" effect.dst)]
  + event_operation
    \ event=log_card
    ^ row[weft/node]
    ? event.t
     > (./vine p w) (debug_model/operation w)
     > (./hear news) []
  + acknowledgement
    \ ack=maybe[path]
    ^ weft/node
    ? ack
     > (./some path) (debug_model/ref "Acknowledgement" path)
     > .none (debug_model/field "Acknowledgement" "None")
  + event
    \ event=log_card
    ^ row[weft/node]
    = base=row[weft/node]
        [(debug_model/field "Task" (debug_model/event_verb event))
         (debug_model/ref "Target" (debug_model/event_target event))
         (debug_model/acknowledgement event.ack)
         (debug_model/field "Outbound effects" (weft/show_nat event.fx.len))]
      effect_count (? (lt event.fx.len 40) event.fx.len 40)
      effects (event.fx.take(effect_count).map(debug_model/effect))
    | base.weld((debug_model/event_operation event)).weld(effects)
  + journal
    ' The caller supplies a bounded physical page. Every selected key
    ' gets a row, even if its own record is absent or not a log_card.
    \ view=axal[myth]
    ^ row[weft/node]
    = entries (row/rev[uon/kv[axal[myth]]] view.kid_tap)
      events
        % i=nat 0 out=row[weft/node] []
        ^ row[weft/node]
        ? (ge i entries.len) out
        = entry entries.at(i)
          event=maybe[log_card]
            ?> (./some card) entry.val.fil .none
            ?> (./some held) card.get(['ev]) .none
            ?> event=log_card held .none
            | ./some event
          p=path ['log entry.key]
          line
            ~ weft/build
            ~# 'a.debug-event
              'href (debug_model/url p)
              'data-reference (show/path p)
              'data-event-valid (? (maybe/is_some event) "true" "false")
              ~. 'code.debug-event-id (show/iota entry.key)
              ? event
               > (./some log)
                 ~. 'strong (debug_model/event_verb log)
                 ~. 'code (show/path (debug_model/event_target log))
                 ~. 'span.muted (weft/cat2 (weft/show_nat log.fx.len) " effects")
               > .none
                 ~. 'strong "Inspect record"
                 ~. 'code (show/path p)
                 ~. 'span.muted "No event payload"
        | _ i.inc out.snoc(line.at(0))
    ~ weft/build
    ~| 'div.debug-events
      events
      ? (eq events.len 0)
        ~. 'p.muted "No journal events in this snapshot."
  + module
    \ bundle=grove_backend/bundle
    ^ row[weft/node]
    = entries bundle.exports.tap
      count (? (lt entries.len 80) entries.len 80)
      exports=row[mop/kv[path grove_backend/entry]] entries.take(count)
    ~ weft/build
    ~| 'ui-accordion[variant=quiet][size=compact]
      ~| 'ui-accordion-item.wb-implementation[value=implementation][title=Implementation][heading-level=2]
        ~. 'ui-icon[slot=disclosure][name=navigation.disclosure][size=small][aria-hidden=true]
        [(debug_model/field "Declaration" (show/path bundle.prefix))]
        [(debug_model/field "Exports" (weft/show_nat bundle.exports.tap.len))]
        ~| 'div.debug-exports
          % entry exports
            ~| 'div.debug-fact.debug-export
              ~. 'code.debug-fact-label (show/path entry.key)
              ~. 'span.muted entry.val.kind
  + semantic_value
    \ held=pail
    ^ row[weft/node]
    ? held
     > schema=grove_role_schema
       | debug_model/role schema
     > schema=grove_action_schema
       ~ weft/build
       [(debug_model/ref "Receiver role" schema.receiver)]
       ~. 'h3 "Arguments"
       | debug_model/role schema.arguments
     > schema=grove_norm_schema
       | debug_model/norm schema
     > schema=grove_sewn_schema
       [(debug_model/ref "Source norm" schema.source)
        (debug_model/ref "Target norm" schema.target)]
     > template=grove_template
       = count (? (lt template.seeds.len 80) template.seeds.len 80)
         seeds=row[[path myth]] template.seeds.take(count)
       ~ weft/build
       [(debug_model/field "Instance records" (weft/show_nat template.seeds.len))]
       ~| 'details
         ~. 'summary "Relative instance paths"
         % entry seeds
           = [relative record] entry
           ~. 'code.debug-seed (show/path relative)
     > event=log_card
       | debug_model/event event
     > form
       ~ weft/build
       [(debug_model/field "Handlers" "init · talk · take · hear · dead · goof")]
    []
  + semantics
    \ tgt=path view=axal[myth]
    ^ row[weft/node]
    ? (eq_pith tgt ['log]) (debug_model/journal view)
    ? (eq_pith tgt ['weft])
      = entries view.kid_tap
        components
          % i=nat 0 out=row[weft/node] []
          ^ row[weft/node]
          ? (ge i entries.len) out
          = entry entries.at(i)
          ?> (./some card) entry.val.fil (_ i.inc out)
          ?> (./some part) (myth/path_at ['part] card) (_ i.inc out)
          = item
              ~ weft/build
              ~| 'div.debug-fact
                [(debug_model/link ['weft entry.key])]
                [(debug_model/ref "Component" part)]
          | _ i.inc out.snoc(item.at(0))
      ~ weft/build
      [(debug_model/field "Registry" "Weft components and their rendered demonstrations")]
      [(debug_model/field "Registered components" (weft/show_nat components.len))]
      components
      ? (eq components.len 0)
        ~. 'p.muted "No components are registered in this namespace. The rendering behavior is available under /weft/kook."
        [(debug_model/link ['weft 'kook])]
    ?> (./some card) view.fil []
    = typed
        | card.tap.bind
        \ entry
        | debug_model/semantic_value entry.val
      manifest
        ?> (./some held) card.get(pact/slot) []
        ?> app=mani held []
        | debug_model/manifest tgt app card
      module
        ?> (./some held) card.get(grove_backend/module_slot) []
        ?> bundle=grove_backend/bundle held []
        | debug_model/module bundle
    | manifest.weld(typed).weld(module)
  + value_kind
    \ key=path held=pail
    ^ nat
    ? held
     > pails/p "reference"
     > pails/ps "references"
     > safe "reference"
     > cpail "dependencies"
     > kook "behaviors"
     > mani "manifest"
     > grove_role_schema "role"
     > grove_action_schema "action"
     > grove_norm_schema "norm"
     > grove_sewn_schema "sewn"
     > grove_template "template"
     > grove_backend/bundle "module"
     > log_card "event"
     > form "behavior"
     > pails/t "text"
    "value"
  + slot_group
    \ key=path held=pail semantic=bool
    ^ nat
    ? (eq_pith key ['sys 'lash]) "constraints"
    ? ((eq_pith key bond/lede) || (eq_pith key bond/help)) "source"
    ? semantic
      ? held
       > mani "source"
       > grove_role_schema "source"
       > grove_action_schema "source"
       > grove_norm_schema "source"
       > grove_sewn_schema "source"
       > grove_template "source"
       > grove_backend/bundle "source"
       > log_card "source"
       > form "source"
      "slots"
    "slots"
  + reference
    \ held=pail
    ^ nat
    ? held
     > p=pails/p (show/path p.p)
     > s=safe (show/path s.path)
    ""
  + text_cord
    \ key=path
    ^ bool
    ? (eq_pith key ['method]) .true
    ? (eq_pith key ['url]) .true
    ? (eq_pith key ['body]) .true
    ? (eq_pith key ['res_ctype]) .true
    ? (eq_pith key ['res_body]) .true
    .false
  + value
    \ key=path held=pail
    ^ row[weft/node]
    ? held
     > p=pails/p [(debug_model/link p.p)]
     > ps=pails/ps (ps.ps.map(debug_model/link))
     > c=cpail
       ~ weft/build
       % entry c.crew.tap
         [(debug_model/ref (show/path entry.key) entry.val.p)]
     > k=kook (k.refs.map(debug_model/link))
     > s=safe
       ~ weft/build
       [(debug_model/link s.path)]
       ~. 'span.muted (weft/cat2 " · case " (weft/show_nat s.ver))
     > schema=grove_role_schema
       [(weft/tx (weft/cat2 (weft/show_nat schema.fields.len) " declared slots"))]
     > grove_action_schema [(weft/tx "Compiled action schema")]
     > grove_norm_schema [(weft/tx "Namespace path and record constraints")]
     > schema=grove_sewn_schema
       [(debug_model/link schema.source) (weft/tx " → ") (debug_model/link schema.target)]
     > template=grove_template
       [(weft/tx (weft/cat2 (weft/show_nat template.seeds.len) " instance records"))]
     > module=grove_backend/bundle
       [(weft/tx (weft/cat2 (weft/show_nat module.exports.tap.len) " compiled exports"))]
     > event=log_card
       [(weft/tx (debug_model/event_verb event)) (weft/tx " ") (debug_model/link (debug_model/event_target event))]
     > form [(weft/tx "Runtime behavior · 6 handlers")]
     > n=pails/n
       ? (debug_model/text_cord key)
         [(weft/tx (debug_model/text_preview 1024 n.n))]
       ? (gt (wid n.n) 128)
         [(weft/tx (weft/cat2 (weft/show_nat (wid n.n)) " byte numeric value"))]
       [(weft/tx (weft/show_nat n.n))]
     > t=pails/t [(weft/tx (debug_model/text_preview 2048 (str/to_atom t.t)))]
    [(weft/tx (show/clip 768 (show/pail held)))]

  + fidelity
    : state=str reason=str total=maybe[nat] preview=maybe[nat] representation=str
  + text_fidelity
    \ limit=nat bytes=nat representation=str
    ^ debug_model/fidelity
    = total (wid bytes)
      count (value_read/preview_count limit bytes)
      prefix (mod bytes (bex (mul 8 count)))
    ? (!(eq (wid prefix) count) || !(value_read/text_bytes prefix))
      | debug_model/fidelity "preview" "non-text-bytes" (./some total) .none representation
    ? (gt total count)
      | debug_model/fidelity "preview" "byte-limit" (./some total) (./some count) representation
    | debug_model/fidelity "complete" "" (./some total) (./some total) representation
  + text_preview
    \ limit=nat bytes=nat
    ^ nat
    = info (debug_model/text_fidelity limit bytes "utf8-bytes")
    ? (equal[str] info.reason "non-text-bytes") "Byte sequence"
    = count info.preview.fall(0)
      prefix (mod bytes (bex (mul 8 count)))
    ? (gt (wid bytes) count) (weft/cat2 prefix "…")
    prefix
  + value_fidelity
    \ key=path held=pail
    ^ debug_model/fidelity
    ? held
     > t=pails/t (debug_model/text_fidelity 2048 (str/to_atom t.t) "utf8-bytes")
     > n=pails/n
       ? (debug_model/text_cord key) (debug_model/text_fidelity 1024 n.n "natural-le-bytes")
       ? (gt (wid n.n) 128)
         | debug_model/fidelity "preview" "numeric-summary" (./some (wid n.n)) .none "natural-le-bytes"
       | debug_model/fidelity "complete" "" (./some (wid n.n)) (./some (wid n.n)) "natural-le-bytes"
    | debug_model/fidelity "opaque" "semantic-summary" .none .none ""
  + number_text
    \ number=maybe[nat]
    ^ str
    | number.run(nat/show).fall("")
  + immutable_url
    \ tgt=path slot=path epoch=maybe[nat] held=pail
    ^ str
    ? !(value_read/physical tgt) ""
    ? ((gt (path_show tgt).len 4096) || (gt (path_show slot).len 4096)) ""
    ? (!(value_read/identifier (path_show tgt)) || !(value_read/identifier (path_show slot))) ""
    ? !(maybe/is_some (value_read/bytes held)) ""
    ?> (./some at) epoch ""
    | value_read/url tgt slot at
  + source_epoch
    \ ver=axal[myth]
    ^ maybe[nat]
    ?> (./some record) ver.fil .none
    ?> (./some held) record.get(['top]) .none
    ? held
     > t=pails/t (nat/parse t.t)
    .none
