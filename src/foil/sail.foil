- sept
'  HTML builder target. Builder forms expand to these ordinary functions.
+  sail
  +  attribute
    :  key=nat value=nat
  +  child
    &  sail/child/text
       sail/child/element
    +  text
      :  value=nat
    +  element
      :  tag=nat fields=row[sail/attribute] kids=row[sail/child]

  +  cat
    \ a=nat b=nat
    ^ nat
    | cord/cat a b
  +  join
    \ xs=row[nat]
    ^ nat
    | cord/cat_all xs
  +  text
    '  Text is a packed cord. Use nat_show for numeric values.
    \  value=nat
    ^  sail/child
    (./text value)
  +  texts
    '  An atomic group of text pieces contributes exactly one child.
    \  values=row[nat]
    ^  sail/child
    (sail/text (sail/join values))
  +  field
    \  key=nat value=nat
    ^  sail/attribute
    (sail/attribute key value)
  +  split
    \ sep=nat s=nat
    ^ row[nat]
    | cord/split_byte sep s
  +  class_join
    \ acc=nat x=nat
    ^  nat
    ?  (eq acc 0)
      x
    (sail/cat acc (sail/cat " " x))
  +  node
    '  A dotted head supplies CSS classes: div.card.selected.
    \  head=nat fields=row[sail/attribute] kids=row[sail/child]
    ^  sail/child
    =  parts (sail/split 46 head)
       classes (row/fold[nat nat] 0 sail/class_join parts.drop(1))
       attrs
         ?  (eq classes 0)
           fields
         (row/weld fields [(sail/field "class" classes)])
    (./element parts.at(0) attrs kids)
  +  bind
    (@ v)
    \  values=row[v] f={\ v}row[sail/child]
    ^  row[sail/child]
    values.fold([] (\ acc=row[sail/child] value=v acc.weld((f value))))
  +  escape
    \  s=nat
    ^  nat
    %  todo=nat s out=nat 0
    ?  (eq todo 0)
      out
    =  c (mod todo 256)
       piece
         ?  (eq c 38)
           "&amp;"
         ?  (eq c 60)
           "&lt;"
         ?  (eq c 62)
           "&gt;"
         ?  (eq c 34)
           "&quot;"
         c
    (_ (rsh todo 8) (sail/cat out piece))
  +  boolean_field
    \  key=nat
    ^  bool
    | row/has[nat] key
    ["checked" "disabled" "selected" "multiple" "required" "readonly"
     "autofocus" "hidden" "open" "controls" "loop" "muted" "autoplay"
     "novalidate" "formnovalidate" "reversed" "ismap" "defer" "async"
     "allowfullscreen" "inert"]
  +  render_field
    \  a=sail/attribute
    ^  nat
    ?  (sail/boolean_field a.key)
      ?  a.value
        (sail/cat " " (sail/escape a.key))
      0
    (sail/join [" " (sail/escape a.key) "=" 34 (sail/escape a.value) 34])
  +  void
    \  tag=nat
    ^  bool
    | row/has[nat] tag
    ["area" "base" "br" "col" "embed" "hr" "img" "input" "link"
     "meta" "param" "source" "track" "wbr"]
  +  render_child
    \  child=sail/child
    ^  nat
    ?  child
     > (./text value)
       (sail/escape value)
     > (./element tag fields kids)
       =  me (_)
          start (sail/join ["<" (sail/escape tag)
            (sail/join fields.map(sail/render_field)) ">"])
       ?  (sail/void tag)
         start
       (sail/join [start (sail/join kids.map(me)) "</" (sail/escape tag) ">"])
  +  render
    \  children=row[sail/child]
    ^  nat
    (sail/join children.map(sail/render_child))
