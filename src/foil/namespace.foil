  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  chg p
  =  acc2
       %  j=nat 0
          a2=axal[row[dep]] acc
       ?  (eq j q.len)
          a2
       =  e q.at(j)
       =  sub e.p
       =  cur a2.gut(sub [])
