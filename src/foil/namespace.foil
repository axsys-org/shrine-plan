        (_ (./ok (raid_access wm access)) gas.dec)
     =  tl wm.toil
     (./ok [(fate tl.tap wm.up) ack])
+ if_case_slot
  ' The precondition a make or a poke may carry: /sys/if_case, the x
  ' case the writer read.  The kernel checks it against the record's
  ' case now, in the same turn as the commit, strips it, and refuses
  ' the whole event as 'stale_case when any record moved; it never
  ' lands in a record.
  ^ path
  ['sys 'if_case]
+ precondition
  ' One write with its precondition judged and stripped, or why not.
  \ target=path change=writ state=namespace
  ^ either[iota writ]
  = key if_case_slot
    judged={\ myth}either[iota myth]
      \ m=myth
      ^ either[iota myth]
      > (./some held) m.get(key) (./ok m)
      ? held
       > n=pails/n
        = now (state.local.x_case(target)).fall(0)
        ? (eq now n.n) (./ok m.del(key))
        | ./err 'stale_case
       | ./err 'if_case_not_a_number
  ? change
   > (./make m)
    ? (judged m)
     > (./ok m2) (./ok (writ/make m2))
     > (./err why) (./err why)
   > (./poke m)
    ? (judged m)
     > (./ok m2) (./ok (writ/poke m2))
     > (./err why) (./err why)
   | ./ok change
+ preconditions
  ' Every write of a batch judged; the first stale one refuses them all.
  \ writes=row[[path writ]] state=namespace
  ^ either[iota row[[path writ]]]
  = none=row[[path writ]] []
  % i=nat 0 out=row[[path writ]] none
  ^ either[iota row[[path writ]]]
  ? (eq i writes.len) (./ok out)
  = [target change] writes.at(i)
  ? (precondition target change state)
   > (./err why) (./err why)
   > (./ok sure) (_ i.inc out.snoc([target sure]))
+ sovereign_kernel
  '  A sovereign's command against its namespace, admitted under its access and applied as one doom: the change, its signals, its index.
  \ command=task entropy=nat state=namespace
  ^ either[iota [fate=fate ack=maybe[path]]]
  = access | sovereign_access state
  ? command
   > (./vine target change)
     ? !(state.permitted(target)) (./err 'write_outside_authority)
     ? (precondition target change state)
      > (./err why) (./err why)
      > (./ok sure)
        | grind_with_access 4096 [(vine_flue target sure)]
            (./some target) entropy access
   > (./vines writes)
     ? (eq writes.len 0) (./err 'vines_empty)
     ? !(writes.all((\ [target change] state.permitted(target)))) (./err 'write_outside_authority)
     ? (preconditions writes state)
      > (./err why) (./err why)
      > (./ok sure)
        = [first change] sure.at(0)
        | grind_with_access 4096 sure.map((\ [target change] (vine_flue target change)))
            (./some first) entropy access
   > (./hear news)
     = subscribers | invert news
     ? (eq subscribers.wyt 0) (./err 'hear_no_subs)
     | grind_with_access 4096 (hear_flues subscribers) .none entropy access
+ sovereign_event
  & sovereign_event/ripe sovereign_event/fail
  + ripe
    : state=namespace effects=row[move] signs=axal[sign] ack=maybe[path]
  + fail
    : why=iota
+ sovereign_run_event
  ' Ownership gates dispatch and all final diffs. Failed events expose
  ' neither writes nor effects. The namespace commit journals its system pin.
  \ command=task entropy=nat now=nat block=nat state=namespace
  ^ sovereign_event
  ? (sovereign_kernel command entropy state)
   > (./err why) (./fail why)
   > (./ok outcome=[result=fate ack=maybe[path]])
     = [result ack] outcome
     = diffs | axal/gas[note] result.write (axal/new[note] .none)
     ? !(diffs.tap.all((\ [target change] state.permitted(target))))
       | ./fail 'write_outside_authority
     = effective | gate/prepare diffs state.local.top state.local.idx
     ? !(effective.tap.all((\ [target change] state.permitted(target))))
       | ./fail 'write_outside_authority
     ? (guard_diffs effective state.local)
      > (./some why) (./fail why)
      > .none
        ? (namespace/step diffs now block state)
         > (./err why) (./fail why)
         > (./ok committed)
           | ./ripe committed.state result.effects committed.signs ack
+  brand_of
  '  The runtime nominal brand as text.  Reflection is confined to
  '  this boundary; nullary values are their own brand atoms.
  \ held=any
  ^ str
  = brand
      ? (rep_app held) (rep_hd held)
      | add held 0
  ^ str brand
+  curb_ok
  ' A contract admits only the defining moment it names.
  \ cb=curb held=pail
  ^ bool
  | cb.any
    \ reference=definition_reference
    | reference.matches held
+  lash_of
  '  The node's own shape contract, when its record carries one at
  '  system_vocabulary/lash — enforcement is opt-in per node, and the contract
  '  is ordinary namespace state like everything else.
  \  t=myth
  ^  maybe[lash]
  ?  t.get(system_vocabulary/lash)
   > .none  .none
   > (./some held=pail)
     ?  held
      > l=lash  (./some l)
     .none
+  fit_check
  '  One record judged against its own contract as stored: every
  '  present slot through the write curbs, every need group against
  '  the record — the standing-query predicate for finding legacy
  '  data a later-adopted contract disowns.
  \  t=myth
  ^  maybe[iota]
  ?  (lash_of t)
   > .none  .none
   > (./some l=lash)
     =  ws t.tap
     =  tybad
          %  i=nat 0
          ^  bool
          ?  (ge i ws.len)
             .false
          =  e ws.at(i)
          ?  l.write.get(e.key)
           > .none  (_ i.inc)
           > (./some cb=curb)
             ?  (curb_ok cb e.val)
                (_ i.inc)
             .true
     ?  tybad
        (./some 'curb_type)
     =  gs l.need
     %  i=nat 0
     ^  maybe[iota]
     ?  (ge i gs.len)
        .none
     =  g gs.at(i)
     ?  g.any((\ sl (myth/has_at sl t)))
        (_ i.inc)
     (./some 'curb_need)
+  guard_diffs
  '  Check normalized effective notes. Unchanged records need no check.
  '  Changing the contract itself adopts it over legacy data; other
  '  live changes must satisfy the final record's stored contract.
  \  diffs=axal[note] s=sov
  ^  maybe[iota]
  =  es diffs.tap
  %  i=nat 0
  ^  maybe[iota]
  ?  (ge i es.len)
     .none
  =  [p q] es.at(i)
  ?  ?=(.cull q)
     (_ i.inc)
  =  before=res[pin[myth]]
       ?  s.x_latest(p)
        > (./known t=myth)  (./known (pin t))
        > .null  .null
        > .unknown  .unknown
  >   (./known held) (note/write before q)
      (_ i.inc)
  =  final (unpin held)
  =  cur=maybe[myth]
       ?  before
        > (./known old)  (./some (unpin old))
        > .null  .none
        > .unknown  .none
  =  unchanged
       ?  cur
        > .none  .false
        > (./some old)  (equal old final)
  ?  unchanged
     (_ i.inc)
  =  adopt
       ?  final.get(system_vocabulary/lash)
        > .none  .false
        > (./some nl=pail)
          >   (./some old) cur
              .true
          ?  old.get(system_vocabulary/lash)
           > .none  .true
           > (./some ol=pail)  !(equal nl ol)
  ?  adopt
     (_ i.inc)
  ?  (fit_check final)
   > .none  (_ i.inc)
   > (./some why=iota)  (./some why)
+ sovereign_gyre
  & sovereign_gyre/spun sovereign_gyre/fail
  + spun
    : state=namespace moves=row[move] rounds=row[axal[sign]] ack=maybe[path] spill=maybe[iota]
  + fail
    : why=iota
+ sovereign_cycle
  '  Run one event and its reaction rounds.  Each round's news comes from
  '  the kernel's dependency index, which the commit keeps current in the
  '  same epoch as the crews it files, so no watcher index is derived or
  '  carried between events.  A failed event commits nothing.
  \  t=task eny=nat fuel=nat now=nat block=nat s=namespace
  ^  sovereign_gyre
  ?  (sovereign_run_event t eny now block s)
   > (./fail e=iota)  (./fail e)
   > (./ripe s1=namespace fx1=row[move] sg1=axal[sign] a=maybe[path])
     %  cur=namespace s1
        prev=namespace s
        moves=row[move] fx1
        rounds=row[axal[sign]] [sg1]
        sg=axal[sign] sg1
        gas=nat fuel
     ^  sovereign_gyre
     =  news (sovereign_react sg cur)
     '  Lens deps translate against the pre-round namespace: the round's
     '  signs graded that state, and an /o answer's first change
     '  (an unminted pin minting) must wake its watcher.
     =  lt (react_lens sg (lens_from_reader (sovereign_derived cur) (sovereign_reader prev))).tap
     =  nws
          %  i2=nat 0
             acc=axal[row[dep]] news
          ?  (eq i2 lt.len)
             acc
          =  [p q] lt.at(i2)
          (_ i2.inc acc.put(p q))
     ?  (eq 0 nws.wyt)
        (./spun cur moves rounds a .none)
     ?  (eq 0 gas)
        (./spun cur moves rounds a (./some 'cycle_exhausted))
     ?  (sovereign_run_event (./hear nws) eny now block cur)
      > (./fail e2=iota)  (./spun cur moves rounds a (./some e2))
      > (./ripe s2=namespace fx2=row[move] sg2=axal[sign] a2=maybe[path])
        =  m2 moves.weld(fx2)
        =  r2 rounds.snoc(sg2)
        (_ s2 cur m2 r2 sg2 gas.dec)

+ sovereign_reconcile
  ' Source publication can commit several prepared batches outside dispatch.
  ' Catch watchers up once against the final state, using their real care
  ' clocks instead of replaying intermediate publications or scanning values.
  \ before=namespace after=namespace now=nat block=nat
  ^ either[iota namespace]
  ? (eq before.local.top after.local.top) (./ok after)
  = watchers (sovereign_watchers after)
    reader (sovereign_reader before)
    trigger_changed
      \ trigger=dep
      ^ bool
      ? (is_r trigger.p)
        > (./some address) (r_parse trigger.p) .false
        = [target relative] address
        | !(equal (reference_index/beneath target before.local.top before.local.references)
                  (reference_index/beneath target after.local.top after.local.references))
      | !(equal (before.case(trigger.c trigger.p)) (after.case(trigger.c trigger.p)))
    changed
      \ dependency=dep
      ^ bool
      = triggers=row[dep]
          ? (is_h_version dependency.p) (h_version_triggers dependency.p)
          ? (is_o dependency.p) (o_trigger_reader dependency.p reader)
          ? (is_xv dependency.p) (xv_trigger_reader dependency.p reader)
          ? (is_h dependency.p) []
          [dependency]
      | triggers.any trigger_changed
    news
      | watchers.tap.fold (axal/new[row[dep]] .none)
      \ out [watched subscribers]
      | subscribers.fold out
        \ out subscriber
        ? !(changed (dep subscriber.c watched)) out
        | out.put watched (out.gut(watched []).snoc(subscriber))
  ? (eq news.wyt 0) (./ok after)
  ? (sovereign_cycle (task/hear news) 0 128 now block after)
   > (./fail why) (./err why)
   > (./spun next moves rounds ack spill)
     > .none spill (./err 'publication_reaction_failed)
     ? moves.len (./err 'publication_outbound_not_supported)
     | ./ok next

' --- publication ---

' Preparation is pure. All records, including generated members, must be
' enumerated before the compiler uses these assignments.
+ publication_batch
  : authority=iota expected=axal[nat] assigned=axal[nat]

  + valid_authority
    \ authority=iota
    ^ bool
    ? (eq_iota authority 'sys) .true
    ? !(eq (aura_tag authority) "x") .false
    !(eq (quip_val authority) 0)

  + prepare
    \ authority=iota names=row[path] state=sov
    ^ either[iota publication_batch]
    ? !(publication_batch/valid_authority authority)
      (./err 'invalid_authority)
    ? !(namespace/confined [authority] state)
      (./err 'authority_mismatch)
    % pending=row[path] names
      expected=axal[nat] (axal/new[nat] .none)
      assigned=axal[nat] (axal/new[nat] .none)
    ^ either[iota publication_batch]
    ? (eq pending.len 0)
      | ./ok (publication_batch authority expected assigned)
    = name | pending.at 0
    ? !(pith_prefix [authority] name) (./err 'authority_mismatch)
    ? expected.dip(name).fil
     > (./some _) (./err 'duplicate_definition)
    = previous
        ? state.x_case(name)
         > (./some number) number
         > .none 0
    | _ pending.drop(1) expected.put(name previous)
        assigned.put(name (inc previous))

  + publish
    ' Compiler-definition records require their public /sys/mold descriptor.
    \ records=axal[myth] now=nat block=nat state=sov batch=publication_batch
    ^ either[iota sov]
    ? !(records.tap.all((\ [name record] record.has(system_vocabulary/mold))))
      | ./err 'invalid_definition_record
    | publication_batch/publish_records records now block state batch

  + publish_records
    ' Commit prepared records, including documentation-only system seeds.
    ' No part of the candidate store escapes until every
    ' expected predecessor and resulting data case has been checked.
    \ records=axal[myth] now=nat block=nat state=sov batch=publication_batch
    ^ either[iota sov]
    ? !(publication_batch/valid_authority batch.authority)
      (./err 'invalid_authority)
    ? !(namespace/confined [batch.authority] state)
      (./err 'authority_mismatch)
    ? !(eq batch.expected.tap.len batch.assigned.tap.len)
      (./err 'invalid_assignments)
    ? !(equal records.tap.len batch.assigned.tap.len)
      (./err 'incomplete_publication)
    = predecessors
        | batch.expected.tap.all
          \ [name expected]
          = actual
              ? state.x_case(name)
               > (./some number) number
               > .none 0
          | eq actual expected
    ? !predecessors (./err 'stale_publication)
    = valid
        | records.tap.all
          \ [name record]
          ? !(pith_prefix [batch.authority] name) .false
          > (./some assigned) (batch.assigned.dip(name).fil)
            .false
          > (./some expected) (batch.expected.dip(name).fil)
            .false
          ? !(eq assigned (inc expected)) .false
          .true
    ? !valid (./err 'invalid_definition_record)
    = diffs
        | records.tap.fold (axal/new[note] .none)
          \ out [name record]
          | out.put name (note/make record)
    ? (sov/step diffs now block state)
     > (./err reason) (./err reason)
     > (./ok result=[next=sov signs=axal[sign]])
       = [next signs] result
       = consistent
           | batch.assigned.tap.all
             \ [name assigned]
             ? next.x_case(name)
              > (./some actual) (eq assigned actual)
              > .none .false
       ? !consistent (./err 'inconsistent_publication)
       | ./ok next

  + publish_namespace
    ' Verify the prepared batch before journaling one local transaction.
    \ system=pin[row[[path nat]]] records=axal[myth]
      now=nat block=nat state=namespace batch=publication_batch
    ^ either[iota namespace/committed]
    ? !(equal system (unpin state.system).definitions)
      | ./err 'system_publication_mismatch
    ? !(eq_iota batch.authority state.self)
      | ./err 'write_outside_authority
    < checked
      | publication_batch/publish records now block state.local batch
    = changes
        | records.tap.fold (axal/new[note] .none)
          \ out [name card]
          | out.put name (note/make card)
    | namespace/step changes now block state
