          acc=axal[axal[mode]] (axal/new[axal[mode]] .none)
       ?  (eq i es.len)
          acc
       =  [p q] es.at(i)
       ?  (le p.len 1)
          (_ i.inc acc)
       =  par
            %  k=nat p.len.dec
            ^  maybe[path]
            ?  (eq k 0)
               .none
            =  pre p.take(k)
            ?  (maybe/is_some (exact pre wm))
               (./some pre)
            (_ k.dec)
       ?  par
        > .none  (_ i.inc acc)
        > (./some pp=path)
          =  g0 acc.gut(pp (axal/new[mode] .none))
          =  rel p.drop(pp.len)
          =  g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  gs gam.tap
  =  wm1
       %  i=nat 0
          acc=worm wm
       ?  (eq i gs.len)
          acc
       =  [p q] gs.at(i)
       =  dn acc.down
       (_ i.inc acc.set_down(dn.snoc((flue p p (./take q)))))
