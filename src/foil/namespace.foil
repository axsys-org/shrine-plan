- shrine

' A trusted publication is immutable for the lifetime of a namespace.
' Its pin is the publication identity; revision selects its own store's
' latest epoch. Authentication belongs to the supplying host.
+ system_publication
  : revision=nat state=sov definitions=pin[row[[path nat]]]

  + assigned
    ' This manifest can be prepared before compiling its artifacts.
    ' It contains definition moments, never those artifacts or their pin.
    \ state=sov
    ^ pin[row[[path nat]]]
    = empty=row[[path nat]] []
      definitions
        | state.idx.tap.fold empty
          \ out=row[[path nat]] [name history]
          ?> (./some version) state.x_case(name) out
          | out.snoc [name version]
    | pin definitions

+ namespace_event
  ' Local audit data. This is unsigned; the system pin records the exact
  ' trusted definition set selected for this transaction.
  : system=pin[system_publication] changes=pin[axal[note]] predecessor=nat now=nat block=nat

+ namespace
  : self=iota local=sov system=pin[system_publication]

  + confined
    \ root=path state=sov
    ^ bool
    = records
        | state.idx.tap.all
          \ [name history]
          | pith_prefix root name
      cases
        | state.cases.tap.all
          \ [name history]
          | pith_prefix root name
    ? !records .false
    ? !cases .false
    % epoch=nat 1
    ^ bool
    ? (gt epoch state.rec.len) .true
    ?> (./some entry) state.rec.at(epoch) .false
    = valid
        | (unpin entry.held).tap.all
          \ [name change]
          | pith_prefix root name
    ? !valid .false
    | _ epoch.inc

  + create
    \ self=iota local=sov system=pin[system_publication]
    ^ either[iota namespace]
    ? !(eq (aura_tag self) "x") (./err 'invalid_authority)
    ? (eq (quip_val self) 0) (./err 'invalid_authority)
    ? !(namespace/confined [self] local)
      (./err 'local_authority_mismatch)
    = publication | unpin system
    ? (eq publication.revision 0)
      (./err 'invalid_system_publication)
    ? !(eq publication.revision publication.state.top)
      (./err 'invalid_system_publication)
    ? !(namespace/confined ['sys] publication.state)
      (./err 'system_authority_mismatch)
    ? !(equal publication.definitions
          (system_publication/assigned publication.state))
      | ./err 'system_definition_mismatch
    | ./ok | namespace self local system

  + owns
    \ name=path state=namespace
    ^ bool
    | pith_prefix [state.self] name

  + history
    \ name=path state=namespace
    ^ maybe[sov]
    ? (name.starts('sys))
      | ./some (unpin state.system).state
    ? (state.owns(name)) (./some state.local)
    .none

  + case
    \ car=care name=path state=namespace
    ^ maybe[nat]
    < history (state.history(name))
    ? car
     > .x history.x_case(name)
     > .y history.y_case(name)
     > .z history.z_case(name)

  + epoch
    \ car=care version=maybe[nat] name=path history=sov
    ^ maybe[nat]
    ?> (./some number) version (./some history.top)
    = clocks | history.ever_at name
    ? car
     > .x (track/epoch number clocks.x)
     > .y (track/epoch number clocks.y)
     > .z (track/epoch number clocks.z)

  + records
    ' Internal projection. Structural prefixes do not need ledgers.
    \ epoch=nat name=path history=sov
    ^ axal[saga]
    | history.idx.dip(name).tap.fold (axal/new[saga] .none)
      \ out [relative held]
      ?> (./some record) (ass/saga epoch (unpin held.held))
        out
      | out.put relative record

  + frontier
    ' Project care-y directly: stop at each nearest live descendant instead
    ' of materializing the complete subtree and discarding it with snip.
    \ epoch=nat name=path history=sov
    ^ axal[saga]
    = subtree | history.idx.dip name
    % todo=row[[p=path q=axal[tome]]] (sov/kids [] subtree)
      out=axal[saga] (axal/new[saga] (ass/saga epoch (tome/hist subtree.fil)))
    ^ axal[saga]
    ?> (./some hit) todo.pull out
    = [kid rest] hit
      [at branch] kid
    ? (ass/saga epoch (tome/hist branch.fil))
     > (./some record) (_ rest out.put(at record))
     > .none (_ rest.weld((sov/kids at branch)) out)

  + root
    ' A composed browsing view, never a versioned assertion at [].
    \ car=care state=namespace
    ^ axal[saga]
    = project
        ? car
         > .y namespace/frontier
         > .z namespace/records
         > .x namespace/records
      system (unpin state.system).state
      shared (project system.top [] system)
      local (project state.local.top [] state.local)
      all
        | local.tap.fold shared
          \ out [name value]
          | out.put name value
    ? car
     > .x (axal/new[saga] .none)
     > .y all
     > .z all

  + page
    \ car=care version=maybe[nat] name=path state=namespace
    ^ res[axal[saga]]
    ? (eq name.len 0)
      ? version
       > (./some _) .unknown
      ? car
       > .x .unknown
      | ./known | state.root car
    ?> (./some history) state.history(name) .unknown
    ?> (./some epoch)
      (namespace/epoch car version name history)
      .unknown
    = present=res[bool]
        ? car
         > .x
           ? history.x_at(epoch name)
            > (./known record) (./known .true)
            > .null .null
            > .unknown .unknown
         > .y
           ? history.y_at(epoch name)
            > (./known records) (./known .true)
            > .null .null
            > .unknown .unknown
         > .z
           ? history.z_at(epoch name)
            > (./known records) (./known .true)
            > .null .null
            > .unknown .unknown
    ? present
     > .null .null
     > .unknown .unknown
     > (./known _)
       = records | namespace/records epoch name history
       ? car
        > .x (./known (axal/new[saga] records.fil))
        > .y (./known records.snip)
        > .z (./known records)

  + committed
    : state=namespace signs=axal[sign]

  + permitted
    ' The journal is written by commit, never by handler-produced diffs.
    \ name=path state=namespace
    ^ bool
    ? !(state.owns(name)) .false
    !(pith_prefix [state.self 'log] name)

  + step
    ' Check ownership before dispatch to the store and after cull expansion.
    ' The preliminary candidate is pure; only the final complete store returns.
    \ diffs=axal[note] now=nat block=nat state=namespace
    ^ verdict[namespace/committed]
    ? !(diffs.tap.all((\ [name change] state.permitted(name))))
      | ./rejected 'write_outside_authority
    = expanded | gate/prepare diffs state.local.top state.local.idx
    ? !(expanded.tap.all((\ [name change] state.permitted(name))))
      | ./rejected 'protected_journal
    ? (sov/step diffs now block state.local)
     > (./rejected why) (./rejected why)
     > (./accepted result=[next=sov changes=axal[sign]])
       = [next changes] result
       ' A no-op must not mint a journal record and wake version watchers.
       ? (eq changes.wyt 0)
         | ./accepted (namespace/committed state changes)
       = address=path [state.self 'log ($u next.top)]
         event | namespace_event state.system (pin diffs) state.local.top now block
         record | myth/sing ['sys 'content] event
         complete | diffs.put address (note/make record)
       ? (sov/step complete now block state.local)
        > (./rejected why) (./rejected why)
        > (./accepted result=[committed=sov signs=axal[sign]])
          = [committed signs] result
          | ./accepted (namespace/committed
              state.set_local(committed) signs)

  + replay
    \ event=namespace_event state=namespace
    ^ verdict[namespace/committed]
    ? !(equal[pin[system_publication]] event.system state.system)
      | ./rejected 'system_publication_mismatch
    ? !(eq event.predecessor state.local.top)
      | ./rejected 'journal_predecessor_mismatch
    ? (namespace/step (unpin event.changes) event.now event.block state)
     > (./rejected why) (./rejected why)
     > (./accepted result)
       ? (eq result.state.local.top state.local.top)
         | ./rejected 'empty_journal_event
       | ./accepted result

  + service
    \ relative=path state=namespace
    ^ path
    | row/weld relative [state.self]
