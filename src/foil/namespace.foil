'  Namespace: stores, views, transactions, and publication.
'
'  Contents, from primitives to orchestration:
'   1. store: assertions & clocks
'   2. store: sov
'   3. backward indexes (idx)
'   4. namespace
'   5. virtual addresses & markers
'   6. readers
'   7. views: history, reverse & resolver
'   8. views: woven evaluator
'   9. views: overlays & legacy cells
'  10. in-flight & sovereign reads
'  11. dispatch, validation & reactions
'  12. publication

- stdlib/base

'  --- store: assertions & clocks ---

+ ass
  + span
    '  Assertions an open tail holds before /tome/grow seals it: the
    '  bound on what a snapshot re-serializes for a touched path.
    ^ nat
    | 8

  + entry
    '  The entry at or below cur, through sealed pasts: its epoch key
    '  and its assertion, never a past link.
    \ cur=nat h=uon[ass]
    ^ maybe[[k=iota val=ass]]
    < hit h.floor(($u cur))
    = [key found] hit
    ? found
      > (./past p) (ass/entry cur (unpin p))
    | ./some [key found]

  + at
    '  The assertion at cur, if any.
    \ cur=nat h=uon[ass]
    ^ maybe[ass]
    < hit (ass/entry cur h)
    = [_ found] hit
    | ./some found

  + saga
    '  The live committed version at cur, if any.
    \ cur=nat h=uon[ass]
    ^ maybe[saga]
    < a (ass/at cur h)
    ? a
      > (./ker g) (./some g)
    .none

  + yuga
    '  The versioning at cur, live or dead: every assertion carries an
    '  aeon, so the floor's yuga answers uniformly.
    \ cur=nat h=uon[ass]
    ^ maybe[yuga]
    < a (ass/at cur h)
    ? a
      > (./ker g) (./some g.aeon.yuga)
      > (./nul e) (./some e.yuga)
      > (./past _) .none

  + held
    '  The record at cur as the history holds it: pinned, so a record
    '  that rides unchanged into a new version keeps its pin.
    \ cur=nat h=uon[ass]
    ^ res[pin[myth]]
    > (./some a) (ass/at cur h)
      .unknown
    ? a
      > (./ker g) (./known g.myth)
      > (./nul _) .null
      > (./past _) .unknown

  + read
    ' Retain the live assertion; null and unknown stay distinct.
    \ cur=nat h=uon[ass]
    ^ res[saga]
    > (./some a) (ass/at cur h) .unknown
    ? a
      > (./ker record) (./known record)
      > (./nul _) .null
      > (./past _) .unknown

  + res
    '  Resolution within one path history: the record at cur, a
    '  tombstone, or unknown.
    \ cur=nat h=uon[ass]
    ^ res[myth]
    | (ass/held cur h).run
    \ p (unpin p)

  + next
    '  The assertion that carries a record into a new version: a live
    '  record under the header, a tombstone under it, nothing for an
    '  unknown. The pin rides as given, so a version-only re-mint shares
    '  the old one verbatim.
    \ yg=yuga r=res[pin[myth]]
    ^ maybe[ass]
    ? r
      > (./known p) (./some (./ker (saga (aeon/unsigned yg) p)))
      > .null (./some (./nul (aeon/unsigned yg)))
      > .unknown .none

+ nmax
  \ a=nat b=nat
  ^ nat
  ? (lt a b) b
  a

+ graded
  '  Did any of three grades move?
  \ a=nat b=nat c=nat
  ^ bool
  | gt (nmax a (nmax b c)) 0

+ track
  '  Members over one local care history (the type is shrine_types').
  + span
    '  Data cases an open epochs tail holds before /mint seals it: the
    '  bound on what a snapshot re-serializes for a touched clock.
    ^ nat
    | 16

  + new
    '  A never-minted care history.
    ^ track
    | track (lock 0 0) (uon/empty) []

  + case
    '  The current data case, if one has minted.
    \ tr=track
    ^ maybe[nat]
    ? (eq 0 tr.lock.data) .none
    | ./some tr.lock.data

  + mint
    '  Advance one local care clock at sovereign epoch ep. A shape grade
    '  advances both independent counters; every nonzero grade appends
    '  one dense data-case to epoch entry. A tail holding /track/span
    '  cases is sealed behind a pin first, so a snapshot re-serializes
    '  at most span entries of a clock.
    \ g=nat ep=nat old=track
    ^ track
    ? (eq 0 g) old
    = nd old.lock.data.inc
      ns (? (eq 2 g) old.lock.shape.inc old.lock.shape)
    =   kept
      (
        ? (lt old.epochs.size track/span) [old.epochs old.past]
        [(uon/empty) old.past.snoc((track/leaf (pin old.epochs)))])
    = [tail past] kept
    | track (lock nd ns) tail.put(($u nd) ep) past

  + epoch
    '  Resolve an exact local data case to its sovereign epoch.
    \ c=nat tr=track
    ^ maybe[nat]
    ? (eq 0 c) .none
    ? (gt c (mul tr.past.len track/span)) tr.epochs.get(($u c))
    | (unpin tr.past.at((div c.dec track/span)).held).get(($u c))

+ track_case_at
  '  Case clocks are monotone in sovereign epochs. Binary search also
  '  works across sealed history leaves, without replaying or copying
  '  the store.
  \ epoch=nat clock=track
  ^ maybe[nat]
  ? (le (track/epoch clock.lock.data clock).fall(0) epoch)
    | track/case clock
  % low=nat 0 high=nat clock.lock.data
  ^ maybe[nat]
  ? (eq low high) (? (eq low 0) .none (./some low))
  = middle (div (add (add low high) 1) 2)
    at     (track/epoch middle clock).fall(0)
  ? (le at epoch) (_ middle high)
  | _ low middle.dec

+ ever
  '  Members over one path's three care histories.
  + new
    '  A never-minted path history.
    ^ ever
    | ever track/new track/new track/new

  + mint
    \ gx=nat gy=nat gz=nat ep=nat old=ever
    ^ ever
    | ever (track/mint gx ep old.x)
      | track/mint gy ep old.y
      | track/mint gz ep old.z

  + yuga
    '  Copy the local clocks into one assertion's version header.
    \ ev=ever now=nat block=nat
    ^ yuga
    | yuga ev.x.lock ev.y.lock ev.z.lock now block

+ aeon
  '  Members over one version header (the type is shrine_types').
  + unsigned
    '  A header with the zeroed oath: validity lives a layer out.
    \ yg=yuga
    ^ aeon
    | aeon yg (oath 0 0)

+ tome
  + hist
    '  The history in an optional tome slot.
    \ m=maybe[tome]
    ^ uon[ass]
    > (./some tm) m
      (uon/empty)
    | unpin tm.held

  + hold
    '  Store one history at a zipper's focus, behind a fresh pin.
    \ h=uon[ass] z=axal/zip[tome]
    ^ axal/zip[tome]
    | z.set_focus z.focus.set_fil((./some (tome (pin h))))

  + grow
    '  Append the assertion at ep. A tail holding /ass/span entries is
    '  sealed behind a pin first and linked from key 0 of the new tail,
    '  so a snapshot re-serializes at most span assertions of a touched
    '  path, never its whole history. Reads through /ass/entry follow
    '  the link; the sealed pin is written once.
    \ ep=nat next=ass h=uon[ass]
    ^ uon[ass]
    ? (lt h.size ass/span) h.put(($u ep) next)
    | (uon/sing[ass] ($u 0) (./past (pin h))).put(($u ep) next)

+ urn
  + ever
    '  The clocks in an optional urn slot.
    \ m=maybe[urn]
    ^ ever
    > (./some u) m
      ever/new
    | unpin u.held

+ cull
  '  Reading explicit culls out of a raw diff tree.
  + note
    '  Is this floor entry an explicit cull?
    \ m=maybe[note]
    ^ bool
    > (./some n) m
      .false
    ?=(.cull n)

  + cover
    '  Is a strict prefix of pax explicitly culled in raw?
    \ pax=path raw=axal[note]
    ^ bool
    | pax.unders.any
    \ pre (cull/note raw.get(pre))

+ note
  '  Members over one diff (the type is shrine_types').
  + write
    '  The record this note leaves over the current one: make replaces,
    '  poke merges into a live record (or creates), cull tombstones.
    \ cur=res[pin[myth]] n=note
    ^ res[pin[myth]]
    ? n
      > (./make m) (./known (pin m))
      > (./poke m)
        > (./known p) cur
          | ./known (pin m)
        | ./known (pin (unpin p).meld(m))
      > .cull .null

+ gate
  '  The commit gate: normalize a raw diff tree and validate its live
  '  writes before anything mints.
  + blocked
    '  A live-result write may pass a current tombstone only when this
    '  same effective event revives that exact prefix.
    \ pax=path eff=axal[note] top=nat idx=axal[tome]
    ^ bool
    | pax.unders.any
    \ pre
    ? !?=(.null (ass/res top (tome/hist idx.get(pre)))) .false
    > (./some n) eff.get(pre)
      .true
    ?=(.cull n)

  + prune
    '  Remove every explicit note strictly below an explicit cull.
    \ raw=axal[note]
    ^ axal[note]
    | raw.tap.fold (axal/new[note] .none)
    \ acc [p q]
    ? (cull/cover p raw) acc
    acc.put(p q)

  + bury
    '  Add synthesized culls for every currently-live assertion below
    '  bp, including bp itself when it is currently live.
    \ bp=path acc=axal[note] top=nat idx=axal[tome]
    ^ axal[note]
    | idx.dip(bp).tap.fold acc
    \ out [p q]
    ? ?=((./known _) (ass/res top (unpin q.held)))
      out.put(bp.weld(p) .cull)
    out

  + expand
    '  Expand every surviving cull over the current live subtree.
    \ base=axal[note] top=nat idx=axal[tome]
    ^ axal[note]
    | base.tap.fold base
    \ acc [p q]
    ? ?=(.cull q) (gate/bury p acc top idx)
    acc

  + valid
    '  Are all effective live writes clear of unrevived tombstones?
    '  Culls are exempt: make and poke resolve live, cull does not.
    \ eff=axal[note] top=nat idx=axal[tome]
    ^ bool
    | eff.tap.all
    \ [p q] (or ?=(.cull q) (not (gate/blocked p eff top idx)))

  + prepare
    '  Cull dominates every explicit descendant write, then expands to
    '  every currently-live descendant. The caller validates live writes
    '  and retains raw for audit.
    \ raw=axal[note] top=nat idx=axal[tome]
    ^ axal[note]
    | gate/expand (gate/prune raw) top idx

+ ledger
  + put
    \ c=chest l=ledger
    ^ ledger
    = grown l.open.snoc(c)
    ? (lt grown.len 256) (ledger l.sealed grown)
    | ledger l.sealed.snoc((lchunk (pin grown))) []

  + len
    \ l=ledger
    ^ nat
    | add (mul 256 l.sealed.len) l.open.len

  + at
    \ ep=nat l=ledger
    ^ maybe[chest]
    ? (eq 0 ep) .none
    = idx   ep.dec
      chunk (div ep.dec 256)
    ? (lt chunk l.sealed.len)
      | ./some (unpin l.sealed.at(chunk).held).at((mod idx 256))
    = tail (sub idx (mul 256 l.sealed.len))
    ? (lt tail l.open.len) (./some l.open.at(tail))
    .none

'  --- store: sov ---

+ sov
  + new
    '  The empty sovereign.
    ^ sov
    | sov (ledger [] []) (axal/new[tome] .none) 0
      (axal/new[urn] .none) reference_index/new

  + kids
    '  Immediate children of a subtree as (extended path, subtree)
    '  pairs.
    \ at=path sub=axal[tome]
    ^ row[[p=path q=axal[tome]]]
    | sub.kid_tap.fold []
    \ acc [k v] acc.snoc([at.snoc(k) v])

  + mint
    '  Grade bookkeeping for one visited node: mint the local clocks,
    '  thread the case ledger, and cut a sign, once its own grade and
    '  its children's contributions are known.
    \ g=nat fy=nat fz=nat ep=nat now=nat block=nat
      pax=path cv=axal[urn]
    ^ [cv2=axal[urn] sg=maybe[sign] yg=yuga]
    = ny  (nmax g fy)
      nz  (nmax g fz)
      nev (ever/mint g ny nz ep (urn/ever cv.get(pax)))
    ? (graded g fy fz)
      [
        cv.put(pax (urn (pin nev)))
        (./some (sign g ny nz))
        (ever/yuga nev now block)]
    [cv .none (ever/yuga nev now block)]

  + hist
    '  The epoch-keyed assertion history recorded at a path.
    \ pax=path s=sov
    ^ uon[ass]
    | tome/hist s.idx.get(pax)

  + ever_at
    '  The local clocks at a path, zeroed when it owns no ledger.
    \ pax=path s=sov
    ^ ever
    | urn/ever s.cases.get(pax)

  + x_case
    \ pax=path s=sov
    ^ maybe[nat]
    | track/case s.ever_at(pax).x

  + y_case
    \ pax=path s=sov
    ^ maybe[nat]
    | track/case s.ever_at(pax).y

  + z_case
    \ pax=path s=sov
    ^ maybe[nat]
    | track/case s.ever_at(pax).z

  + assertion_at
    '  Internal assertion read by sovereign epoch.
    \ ep=nat pax=path s=sov
    ^ res[saga]
    ? (gt ep s.top) .unknown
    | ass/read ep s.hist(pax)

  + assertion_query
    \ c=nat pax=path s=sov
    ^ res[saga]
    > (./some ep) (track/epoch c s.ever_at(pax).x) .unknown
    | s.assertion_at ep pax

  + x_at
    '  Plain-value projection for existing single-record consumers.
    \ ep=nat pax=path s=sov
    ^ res[myth]
    | s.assertion_at(ep pax).run saga/value

  + y_at
    '  Internal y snapshot by epoch: p's record at '/ plus its frontier:
    '  each nearest descendant with a known record, at its full relative
    '  pith; transparent and tombstoned paths pass through. Unknown
    '  unless p is a node at ep.
    \ ep=nat pax=path s=sov
    ^ res[axal[saga]]
    > (./known w) s.assertion_at(ep pax)
      .unknown
    % todo=list[[p=path q=axal[tome]]]
      (sov/kids ('/) s.idx.dip(pax)).stream
      epic=axal[saga] (axal/new[saga] (./some w))
    ^ res[axal[saga]]
    ? todo.is_nil (./known epic)
    = [at sub] todo.head
    ? (ass/read ep (tome/hist sub.fil))
      > (./known u) (_ todo.tail epic.put(at u))
    '  Share the pending tail instead of copying a shrinking row per
    '  node. DFS preserves the frontier: a live record still terminates
    '  its branch.
    | _ (sov/kids at sub).stream.weld(todo.tail) epic

  + z_at
    '  Internal z snapshot by epoch: every path in p's subtree with a
    '  known record, at its pith relative to p. Unknown unless p is a
    '  node at ep.
    \ ep=nat pax=path s=sov
    ^ res[axal[saga]]
    > (./known w) s.assertion_at(ep pax)
      .unknown
    | ./known
    | s.idx.dip(pax).tap.fold (axal/new[saga] .none)
    \ acc [p q]
    > (./known u) (ass/read ep (unpin q.held))
      acc
    acc.put(p u)

  + x_query
    '  Resolve an exact path-local x data case. Local cases are dense;
    '  zero or an unminted case is a shrug.
    \ c=nat pax=path s=sov
    ^ res[myth]
    > (./some ep) (track/epoch c s.ever_at(pax).x)
      .unknown
    s.x_at(ep pax)

  + y_query
    \ c=nat pax=path s=sov
    ^ res[axal[saga]]
    > (./some ep) (track/epoch c s.ever_at(pax).y)
      .unknown
    s.y_at(ep pax)

  + z_query
    \ c=nat pax=path s=sov
    ^ res[axal[saga]]
    > (./some ep) (track/epoch c s.ever_at(pax).z)
      .unknown
    s.z_at(ep pax)

  + x_latest
    \ pax=path s=sov
    ^ res[myth]
    s.x_at(s.top pax)

  + y_latest
    \ pax=path s=sov
    ^ res[axal[saga]]
    s.y_at(s.top pax)

  + z_latest
    \ pax=path s=sov
    ^ res[axal[saga]]
    s.z_at(s.top pax)

  + grade
    '  The change between the record a node holds and its next: 0
    '  unchanged, 1 data moved, 2 shape moved (a creation or a removal:
    '  live on one side only).
    \ was=res[pin[myth]] will=res[pin[myth]]
    ^ nat
    ? (res/same was will) 0
    ? (eq ?=((./known _) was) ?=((./known _) will)) 1
    2

  + lift
    '  A finished subtree, its sparse signs, the grades it passes to its
    '  parent, and the case ledger threaded through the walk.
    : tree=axal[tome] signs=axal[sign] pass_y=nat pass_z=nat
      cases=axal[urn]

  + brood
    '  The children folded into their parent, before its own change.
    '  tree starts with the old parent and keeps its untouched children;
    '  kids collects only the sign subtrees produced by this commit.
    : tree=axal[tome] kids=bee[axal/k[sign]] child_y=nat child_z=nat
      cases=axal[urn]
    + add
      '  Reattach one child and collect the grades it passes upward. A
      '  zero z grade means nothing moved anywhere in that subtree, so
      '  it contributes no signs. Siblings combine by maximum.
      \ key=iota kid=sov/lift b=sov/brood
      ^ sov/brood
      = tree | b.tree.set_kid b.tree.kid_put(key kid.tree)
      =   kids
        (
          ? (eq 0 kid.pass_z)
            b.kids
          | b.kids.put key
          | axal/k[sign] | pin kid.signs)
      | sov/brood tree kids
        | nmax b.child_y kid.pass_y
        | nmax b.child_z kid.pass_z
        kid.cases

  + finish_tree
    \ ep=nat sign=maybe[sign] header=yuga will=res[pin[myth]]
      tree=axal[tome] hist=uon[ass]
    ^ axal[tome]
    > (./some _) sign tree
    > (./some next) (ass/next header will) tree
    | tree.set_fil (./some (tome (pin (tome/grow ep next hist))))

  + finish
    '  Apply one node's note after its children have settled. Their
    '  grades may advance this node's clocks even without a note of its
    '  own; a path with no history and no note stays silent.
    \ ep=nat now=nat block=nat pax=path change=maybe[note] b=sov/brood
    ^ sov/lift
    = hist | tome/hist b.tree.fil
    '  A transparent path only relays its children's grades.
    =   transparent
      (
        > .none change
          .false
        | eq 0 hist.size)
    ? transparent
      | sov/lift b.tree (axal[sign] .none b.kids)
        b.child_y
        b.child_z
        b.cases
    '  Resolve the local write against the previous epoch, then mint
    '  with both its own change and the contributions from below. Store
    '  a fresh assertion only when minting produced a sign.
    = was | ass/held ep.dec hist
    =   will
      (
        > (./some note) change
          was
        note.write(was))
    = own | sov/grade was will
    =   [cases sign header]
      | sov/mint own b.child_y b.child_z ep now block pax b.cases
    = tree | sov/finish_tree ep sign header will b.tree hist
    '  Mint with the children's contributions, then absorb y at a live
    '  frontier. Dead nodes pass y through; z always passes.
    =   pass_y
      (
        ? ?=((./known _) will)
          own
        | nmax own b.child_y)
    | sov/lift tree (axal[sign] sign b.kids)
      pass_y
      | nmax own b.child_z
      cases

  + walk
    '  Settle the changed children, then finish their parent. dif
    '  selects the branches to visit; tree supplies their history. Each
    '  child returns the case ledger for the next sibling to use, and
    '  the completed brood supplies the parent's incoming grades.
    \ ep=nat now=nat block=nat dif=axal[note]
      tree=axal[tome] pax=path cases=axal[urn]
    ^ sov/lift
    = me   (_ ep now block)
      seed | sov/brood tree (bee/leaf[axal/k[sign]] []) 0 0 cases
    | sov/finish ep now block pax dif.fil
    | dif.kid_tap.fold seed
    \ b [key sub]
    | b.add key
    | me sub b.tree.kid_gut(key) pax.snoc(key) b.cases

  + apply
    '  Apply normalized changes at the next epoch; journal raw verbatim.
    '  The walk rebuilds the index and local cases together. Commit
    '  those alongside the raw journal, and return its sparse signs.
    \ diffs=axal[note] raw=axal[note] now=nat block=nat s=sov
    ^ [state=sov signs=axal[sign]]
    '  Each record whose own assertion moved: its references before and
    '  after, once, for the index and for the signs that wake /r
    '  readers.
    = ep   s.top.inc
      done | sov/walk ep now block diffs s.idx ('/) s.cases
    =   [into signs]
      | done.signs.tap.fold [s.references.into done.signs]
        \ [into signs] [holder change]
        ? (eq change.x 0) [into signs]
        =   before
          | (ass/saga s.top (tome/hist s.idx.get(holder))).run
            \ value (unpin value.myth)
        =   after
          | (ass/saga ep (tome/hist done.tree.get(holder))).run
            \ value (unpin value.myth)
        [
          (reference_index/replace holder before after into)
          (reference_index/signals before after signs)]
    =   state
      | sov s.rec.put((chest (pin raw))) done.tree ep done.cases
        | reference_index/commit ep into s.references
    [state signs]

  + reindex_references
    '  Offline upgrade of derived metadata from the existing
    '  journal/history. Keep the exact journal, record histories, epochs
    '  and case ledgers. A recursive cull visits its historical
    '  descendants, including descendants revived later; the
    '  before/after snapshots decide which edges existed.
    \ state=sov
    ^ sov
    % epoch=nat 1 index=reference_index reference_index/new
    ^ sov
    ? (gt epoch state.top) state.set_references(index)
    =   changes
      (
        ^ axal[note]
        > (./some entry) state.rec.at(epoch) (axal/new[note] .none)
        | unpin entry.held)
    =   touched
      | changes.tap.fold (axal/new[bool] .none)
        \ out [target change]
        ? change
          > .cull
            | state.idx.dip(target).tap.fold out
              \ out [relative history]
              | out.put target.weld(relative) .true
        | out.put target .true
    =   into
      | touched.tap.fold index.into
        \ out [holder ignored]
        = history | tome/hist state.idx.get(holder)
        =   before
          | (ass/saga epoch.dec history).run
            \ record (unpin record.myth)
        =   after
          (ass/saga epoch history).run((\ record (unpin record.myth)))
        | reference_index/replace holder before after out
    | _ epoch.inc (reference_index/commit epoch into index)

  + step
    '  Commit the next sovereign epoch from a tree of raw diffs: the new
    '  state plus a tree of notifications grading each (care, path)
    '  whose local case moved (see /sign, and the grading note on /sov).
    '  now is apollo time and block the PKI blockheight, recorded only
    '  on real versions.
    \ diffs=axal[note] now=nat block=nat s=sov
    ^ either[iota [state=sov signs=axal[sign]]]
    = eff | gate/prepare diffs s.top s.idx
    ? (gate/valid eff s.top s.idx)
      | ./ok s.apply(eff diffs now block)
    | ./err 'tombstoned_ancestor

'  --- backward indexes (idx) ---
'  Backward indexes. A record at /<owner>/idx/<name> carrying a wing at
'  '/sys/limb and a hunt at '/sys/tack declares an index: every live
'  record the hunt reaches (spelled relative to the owner) is filed
'  through the wing, and the index holds the transpose — one record
'  per key at /<owner>/idx/<name>/<len>/<key...>, one slot per source
'  path. Keys are length-prefixed so no key's record is another's
'  ancestor: a cull never buries a sibling key, and no key ever lands
'  beneath a tombstone.
'
'  The commit maintains it (namespace/step, between its trial step and
'  the journaled one), so content always matches its sources at the same
'  epoch and replay re-derives it from the raw diffs. Only the kernel
'  writes content. Only .x and .z hunts are maintained; a malformed
'  declaration is inert, and a wing that crashes files nothing.

+ idx
  + posting
    + key_before
      '  Same lt_pith order without walking a common prefix twice.
      \ a=path b=path
      ^ bool
      % i=nat 0
      ? (eq i a.len) (lt i b.len)
      ? (eq i b.len) .false
      = x a.at(i)
        y b.at(i)
      ? (eq_iota x y) (_ i.inc)
      | lt_iota x y

    + put_source
      '  Balanced insertion with the one-pass path comparator.
      \ source=path value=pail tree=mop[path pail lt_pith]
      ^ myth
      > node=mop/node[path pail lt_pith] tree (myth/sing source value)
      ? (idx/posting/key_before source node.key)
        | mop/balance[path pail lt_pith] node.key node.val
          | idx/posting/put_source source value node.l
          node.r
      ? (idx/posting/key_before node.key source)
        | mop/balance[path pail lt_pith] node.key node.val node.l
          | idx/posting/put_source source value node.r
      | mop/n[path pail lt_pith] source value node.l node.r

    + pop_first
      \ node=mop/node[path pail lt_pith]
      ^ [path pail myth]
      > child=mop/node[path pail lt_pith] node.l
        [node.key node.val node.r]
      = [key value left] (idx/posting/pop_first child)
      [key value
        (mop/balance[path pail lt_pith] node.key node.val left node.r)]

    + pop_last
      \ node=mop/node[path pail lt_pith]
      ^ [path pail myth]
      > child=mop/node[path pail lt_pith] node.r
        [node.key node.val node.l]
      = [key value right] (idx/posting/pop_last child)
      [key value
        (mop/balance[path pail lt_pith] node.key node.val node.l right)]

    + join_sources
      \ left=mop[path pail lt_pith] right=mop[path pail lt_pith]
      ^ myth
      > l=mop/node[path pail lt_pith] left right
      > r=mop/node[path pail lt_pith] right left
      ? (gt left.size right.size)
        = [key value rest] (idx/posting/pop_last l)
        | mop/balance[path pail lt_pith] key value rest right
      = [key value rest] (idx/posting/pop_first r)
      | mop/balance[path pail lt_pith] key value left rest

    + delete_source
      '  mop.del rebuilds all entries. A posting loses one source by
      '  descending its search path and rebalancing only the affected
      '  ancestors instead.
      \ source=path tree=mop[path pail lt_pith]
      ^ myth
      > node=mop/node[path pail lt_pith] tree tree
      ? (idx/posting/key_before source node.key)
        | mop/balance[path pail lt_pith] node.key node.val
          | idx/posting/delete_source source node.l
          node.r
      ? (idx/posting/key_before node.key source)
        | mop/balance[path pail lt_pith] node.key node.val node.l
          | idx/posting/delete_source source node.r
      | idx/posting/join_sources node.l node.r

    + append_source
      '  Rebuild walks sources in canonical order. Its next source is
      '  strictly greater than every source already filed in this group.
      '  This is ordinary mop.put's right branch and balancing, without
      '  repeated path comparisons.
      \ source=path value=pail tree=mop[path pail lt_pith]
      ^ myth
      > node=mop/node[path pail lt_pith] tree (myth/sing source value)
      | mop/balance[path pail lt_pith] node.key node.val node.l
        | idx/posting/append_source source value node.r

    + transpose
      '  One lookup/update walk per relative filing key. Keep the
      '  declaration prefix out of comparisons and force the posting
      '  before staging it.
      \ key=path source=path value=pail groups=mop[path myth lt_pith]
      ^ mop[path myth lt_pith]
      > node=mop/node[path myth lt_pith] groups
        | mop/sing[path myth lt_pith] key (myth/sing source value)
      ? (idx/posting/key_before key node.key)
        | mop/balance[path myth lt_pith] node.key node.val
          | idx/posting/transpose key source value node.l
          node.r
      ? (idx/posting/key_before node.key key)
        | mop/balance[path myth lt_pith] node.key node.val node.l
          | idx/posting/transpose key source value node.r
      = ;record (idx/posting/append_source source value node.val)
      | mop/n[path myth lt_pith] key record node.l node.r

  + put_source
    idx/posting/put_source

  + delete_source
    idx/posting/delete_source

  '  Declarations, incremental maintenance, and the kernel index.
  + claim
    '  What a declaration record asks for.
    : =wing =hunt

  + decl
    '  A live declaration met on the walk: where it sits, the owner its
    '  hunt is spelled against, and its claim.
    : at=path owner=path claim=idx/claim

  + redo
    '  A declaration this commit created, changed or retired: its
    '  content is recomputed whole. fresh marks one that was not
    '  declared before.
    : at=path claim=maybe[idx/claim] fresh=bool

  + pass
    '  The walk's accumulator: touched content records (full paths) and
    '  the declarations to rebuild.
    : work=mop[path myth lt_pith] redos=row[idx/redo]

  + scope
    '  The declarations in force at a node, and the rebuild queue.
    : decls=row[idx/decl] redos=row[idx/redo]

  + read
    \ record=myth
    ^ maybe[idx/claim]
    > (./some limb) record.get('/sys/limb) .none
    > w=wing limb .none
    > (./some tack) record.get('/sys/tack) .none
    > h=hunt tack .none
    ? ?=(.y h.c) .none
    | ./some (idx/claim w h)

  + record_at
    \ name=path state=sov
    ^ maybe[myth]
    ? state.x_latest(name)
      > (./known record) (./some record)
    .none

  + claim_at
    \ name=path state=sov
    ^ maybe[idx/claim]
    > (./some record) (idx/record_at name state) .none
    | idx/read record

  + owner
    '  The owner of a declaration at /<owner>/idx/<name>.
    \ at=path
    ^ path
    | at.take at.len.dec.dec

  + inside
    '  Is name strictly beneath a declaration in either state? Only
    '  paths with an idx segment pay more than a scan.
    \ name=path before=sov after=sov
    ^ bool
    % i=nat 0
    ^ bool
    ? (ge (add i 2) name.len) .false
    ? (not (eq_iota name.at(i) 'idx)) (_ i.inc)
    = at | name.take (add i 2)
    ? (maybe/is_some (idx/claim_at at before)) .true
    ? (maybe/is_some (idx/claim_at at after)) .true
    | _ i.inc

  + covers
    \ owner=path h=hunt name=path
    ^ bool
    ? (not (pith_prefix owner name)) .false
    = relative | name.drop owner.len
    ? h.c
      > .x (equal relative h.p)
      > .z (pith_prefix h.p relative)
      > .y .false

  + slot
    '  Where a key's record lives beneath its declaration.
    '  ?=  ((idx/slot '/a/b) '/2/a/b)
    \ key=path
    ^ path
    | row/weld key [($u key.len)]

  + force
    \ input=[wing path myth]
    ^ myth
    = [w name record] input
      run             w.file
      ;filed          (run name record)
    ; (DeepSeq[nat] filed 0)
    filed

  + file
    '  A wing's filing, made total: a crash files nothing, so a broken
    '  wing degrades its own index instead of rejecting every commit in
    '  its hunt. The filing is forced whole inside Try; a lazy fault
    '  would otherwise escape and resurface later in the commit.
    \ w=wing name=path record=myth
    ^ myth
    ? (Try idx/force [w name record])
      > (./ok filed) filed
      > (./err _) myth/new

  + filing
    \ w=wing name=path held=maybe[myth]
    ^ myth
    > (./some record) held myth/new
    | idx/file w name record

  + held
    '  The live record in an index slot as of top.
    \ slot=maybe[tome] top=nat
    ^ maybe[myth]
    < record (ass/saga top (tome/hist slot))
    | ./some (unpin record.myth)

  + live
    '  The live records beneath name, relative to it.
    \ name=path state=sov
    ^ axal[myth]
    | state.idx.dip(name).filter_map
      \ held
      < record (ass/saga state.top (unpin held.held))
      | ./some (unpin record.myth)

  + touch
    '  Set or clear one source's entry under one key, starting from the
    '  committed content record the first time the key is touched.
    \ at=path key=path name=path entry=maybe[pail] state=sov
      work=mop[path myth lt_pith]
    ^ mop[path myth lt_pith]
    = target | at.weld (idx/slot key)
    =   current
      (
        ^ myth
        ? work.get(target)
          > (./some record) record
        | (idx/record_at target state).fall myth/new)
    =   ;next=myth
      (
        ^ myth
        > (./some value) entry (idx/posting/delete_source name current)
        | idx/posting/put_source name value current)
    | work.put target next

  + refile
    '  One changed source against one unchanged declaration: file it
    '  before and after, and touch only the keys whose entry moved.
    \ d=idx/decl name=path was=maybe[myth] now=maybe[myth] after=sov
      work=mop[path myth lt_pith]
    ^ mop[path myth lt_pith]
    = w   d.claim.wing
      old | idx/filing w name was
      new | idx/filing w name now
    =   gone
      | old.tap.fold work
        \ out entry
        ? new.has(entry.key) out
        | idx/touch d.at entry.key name .none after out
    | new.tap.fold gone
      \ out entry
      =   same
        (
          ? old.get(entry.key)
            > (./some prior) (equal prior entry.val)
          .false)
      ? same out
      | idx/touch d.at entry.key name (./some entry.val) after out

  + scope_decl
    \ here=path signs=axal[sign] before=sov after=sov
      sc=idx/scope name=iota
    ^ idx/scope
    = target  | here.weld ['idx name]
      current | idx/claim_at target after
    =   moved
      (
        ? signs.dip(['idx name]).fil
          > (./some grade) (gt grade.x 0)
        .false)
    = prior | idx/claim_at target before
    =   keep
      (
        \ s=idx/scope
        ^ idx/scope
        > (./some found) current s
        | s.set_decls s.decls.snoc((idx/decl target here found)))
    ? (not moved) (keep sc)
    ? (equal prior current) (keep sc)
    | sc.set_redos
      sc.redos.snoc((idx/redo target current (maybe/is_none prior)))

  + refile_scope
    \ eligible=bool acc=idx/pass prior=axal[tome] tree=axal[tome]
      before=sov after=sov here=path scope=row[idx/decl]
    ^ mop[path myth lt_pith]
    ? (not eligible) acc.work
    = was (idx/held prior.fil before.top)
      now (idx/held tree.fil after.top)
    | scope.fold acc.work
      \ out d
      ? (not (idx/covers d.owner d.claim.hunt here)) out
      | idx/refile d here was now after out

  + walk
    '  Descend the commit's signs beside the index before and after,
    '  collecting the declarations met on the way down. Declarations
    '  whose claim moved are queued for rebuild; every other live one
    '  refiles the changed records its hunt covers, read in step from
    '  both trees rather than from the root.
    \ here=path signs=axal[sign] prior=axal[tome] tree=axal[tome]
      active=row[idx/decl]
      before=sov after=sov journal=path acc=idx/pass
    ^ idx/pass
    = me (_)
    =   names
      (
        ^ row[iota]
        ? tree.kid_get('idx)
          > (./some declared) declared.kid_keys
        [])
    =   seen
      | names.fold (idx/scope active acc.redos)
        | idx/scope_decl here signs before after
    = scope  seen.decls
      queued seen.redos
    =   changed
      (
        ? signs.fil
          > (./some grade) (gt grade.x 0)
        .false)
    =   eligible
      (
        ? (not changed) .false
        ? (eq here.len 0) .false
        ? (pith_prefix journal here) .false
        | not (idx/inside here before after))
    =   work
      | idx/refile_scope eligible acc prior tree before after here scope
    | signs.kid_tap.fold (idx/pass work queued)
      \ out [key sub]
      | me here.snoc(key) sub prior.kid_gut(key) tree.kid_gut(key) scope
        before
        after
        journal
        out

  + seal
    '  Turn touched content into notes: an emptied key culls, a changed
    '  one is replaced, an unchanged one writes nothing.
    \ work=mop[path myth lt_pith] state=sov
    ^ axal[note]
    | work.tap.fold (axal/new[note] .none)
      \ out [target record]
      = original (idx/record_at target state)
      ? (eq record.size 0)
        ? (maybe/is_some original) out.put(target .cull)
        out
      > (./some prior) original out.put(target (note/make record))
      ? (equal prior record) out
      | out.put target (note/make record)

  + desired
    \ r=idx/redo before=sov after=sov journal=path
    ^ mop[path myth lt_pith]
    > (./some wanted) r.claim (mop/empty)
    = root | idx/owner r.at
      base | root.weld wanted.hunt.p
    =   sources
      (
        ? ?=(.x wanted.hunt.c)
          | axal/new[myth] (idx/record_at base after)
        | idx/live base after)
    = empty=mop[path myth lt_pith] (mop/empty)
    | sources.tap.fold empty
      \ acc [relative record]
      = name | base.weld relative
      ? (pith_prefix journal name) acc
      ? (idx/inside name before after) acc
      | (idx/file wanted.wing name record).tap.fold acc
        \ acc2 entry
        | idx/posting/transpose entry.key name entry.val acc2

  + rebuild
    '  Recompute a declaration's whole content from the live records its
    '  hunt reaches, and diff it against the content already there. A
    '  fresh declaration may not claim a subtree that already holds
    '  data.
    \ r=idx/redo before=sov after=sov journal=path out=axal[note]
    ^ either[iota axal[note]]
    =   existing
      | (idx/live r.at after).tap.fold (axal/new[myth] .none)
        \ acc [relative record]
        ? (eq relative.len 0) acc
        | acc.put r.at.weld(relative) record
    ? (and r.fresh (gt existing.wyt 0)) (./err 'idx_occupied)
    '  Stage in an unpinned ordered map. axal.put pins every parent and
    '  would re-hash an increasingly large posting record on every
    '  source insertion. The final notes cross the axal pin boundary
    '  only once per posting key.
    = desired | idx/desired r before after journal
    =   made
      | desired.tap.fold out
        \ acc [key record]
        = target (r.at.weld((idx/slot key)))
        > (./some prior) existing.get(target)
          acc.put(target (note/make record))
        ? (equal prior record) acc
        | acc.put target (note/make record)
    | ./ok
    | existing.tap.fold made
      \ acc [target record]
      ? desired.has(target.drop(r.at.len.inc)) acc
      | acc.put target .cull

  + settle
    '  The index notes one commit owes, given its raw diffs, the trial
    '  commit's signs, and the store before and after the trial. Raw
    '  writes into index content are refused; everything else is the
    '  kernel's to derive.
    \ raw=axal[note] signs=axal[sign] before=sov after=sov journal=path
    ^ either[iota axal[note]]
    ? raw.keys.any((\ name (idx/inside name before after)))
      | ./err 'idx_reserved
    = start | idx/pass (mop/empty) []
    =   done
      | idx/walk ('/) signs before.idx after.idx [] before after journal
        start
    = sealed=either[iota axal[note]] | ./ok (idx/seal done.work after)
    | done.redos.fold sealed
      \ acc r
      < notes acc
      | idx/rebuild r before after journal notes

  + deps
    '  The kernel's own index: every crew entry filed under the path it
    '  watches, the entry being the watcher's sub-crew on that path
    '  (slot names and cares survive). The kernel declares it at
    '  /<self>/idx/deps over its whole authority and reads its reactions
    '  from it. Interface paths and journal targets are not watched,
    '  matching the reactive observer policy.
    + file
      \ name=path record=myth
      ^ myth
      ? (eq name.len 0) myth/new
      = interface=path [name.at(0) 'io]
        journal=path   [name.at(0) 'log]
      ? (pith_prefix interface name) myth/new
      > (./some held) record.get('/sys/crew) myth/new
      > watched=crew/pail held myth/new
      | watched.crew.tap.fold myth/new
        \ out entry
        = target entry.val.p
        ? (pith_prefix journal target) out
        =   prior
          (
            ^ crew
            > (./some old) out.get(target) (mop/empty)
            > sub=crew/pail old (mop/empty)
            sub.crew)
        | out.put target (crew/pail prior.put(entry.key entry.val))

    + law
      ^ wing
      | wing idx/deps/file

    + edition
      '  Bump whenever the kernel wing's filing changes: a namespace
      '  whose declaration carries another edition is re-declared, and
      '  so refiled whole, on its next commit. A stamp, because
      '  comparing the stored wing itself would deep-compare compiled
      '  code on every commit.
      ^ nat
      1

    + stamp
      ^ path
      '/sys/edition

    + declaration
      '  The canonical declaration record.
      ^ myth
      =   record
        | (myth/sing '/sys/limb idx/deps/law).put '/sys/tack
          | hunt .z ('/)
      | record.put idx/deps/stamp (pails/n idx/deps/edition)

    + home
      \ self=iota
      ^ path
      [self 'idx 'deps]

    + seed
      '  The note that brings the kernel's declaration up to date, if it
      '  is missing or of another edition. Only the kernel writes it.
      \ self=iota state=sov
      ^ maybe[note]
      = fresh=maybe[note] (./some (note/make idx/deps/declaration))
      > (./some record) (idx/record_at (idx/deps/home self) state) fresh
      > (./some held) record.get(idx/deps/stamp) fresh
      > stamp=pails/n held fresh
      ? (eq stamp.n idx/deps/edition) .none
      fresh

'  --- namespace ---

+ system_publication
  + assigned
    '  This manifest can be prepared before compiling its artifacts. It
    '  contains definition moments, never those artifacts or their pin.
    \ state=sov
    ^ pin[row[[path nat]]]
    = empty=row[[path nat]] []
    =   definitions
      | state.idx.tap.fold empty
        \ out=row[[path nat]] [name history]
        > (./some version) state.x_case(name) out
        | out.snoc [name version]
    | pin definitions

+ namespace
  + empty_tree
    (@ v)
    \ tree=axal[v]
    ^ bool
    ? tree.fil.is_some .false
    | tree.kid_tap.all((\ [key child] (namespace/empty_tree child)))

  + confined_tree
    '  Once the prefix has been reached, every descendant is within it.
    '  Do not enumerate records, cases or generated index contents
    '  there.
    (@ v)
    \ root=path tree=axal[v]
    ^ bool
    ? (not (root.len)) .true
    ? tree.fil.is_some .false
    | tree.kid_tap.all
      \ [key child]
      ? (eq_iota key root.at(0))
        | namespace/confined_tree root.drop(1) child
      | namespace/empty_tree child

  + confined
    \ root=path state=sov
    ^ bool
    = records (namespace/confined_tree root state.idx)
      cases   (namespace/confined_tree root state.cases)
    ? (not records) .false
    ? (not cases) .false
    % epoch=nat 1
    ^ bool
    ? (gt epoch state.rec.len) .true
    > (./some entry) state.rec.at(epoch) .false
    = valid (namespace/confined_tree root (unpin entry.held))
    ? (not valid) .false
    | _ epoch.inc

  + create
    \ self=iota local=sov system=pin[system_publication]
    ^ either[iota namespace]
    ? (not (eq (aura_tag self) "x")) (./err 'invalid_authority)
    ? (eq (quip_val self) 0) (./err 'invalid_authority)
    ? (not (namespace/confined [self] local))
      | ./err 'local_authority_mismatch
    = publication | unpin system
    ? (eq publication.revision 0)
      | ./err 'invalid_system_publication
    ? (not (eq publication.revision publication.state.top))
      | ./err 'invalid_system_publication
    ? (not (namespace/confined '/sys publication.state))
      | ./err 'system_authority_mismatch
    = assigned (system_publication/assigned publication.state)
    ? (not (equal publication.definitions assigned))
      | ./err 'system_definition_mismatch
    | ./ok | namespace self local system

  + owns
    \ name=path state=namespace
    ^ bool
    | pith_prefix [state.self] name

  + history
    \ name=path state=namespace
    ^ maybe[sov]
    ? (name.starts('sys))
      | ./some (unpin state.system).state
    ? (state.owns(name)) (./some state.local)
    .none

  + system_at
    '  Every admitted event records its selected system publication. A
    '  frozen computation must use that publication, including its
    '  historical types and definitions, rather than the one selected by
    '  the current process.
    \ epoch=nat state=namespace
    ^ pin[system_publication]
    = journal=path [state.self 'log ($u epoch)]
    > (./known record) (state.local.x_at(epoch journal)) state.system
    > (./some held) record.get(system_vocabulary/content) state.system
    > event=namespace_event held state.system
    event.system

  + case
    \ car=care name=path state=namespace
    ^ maybe[nat]
    < history (state.history(name))
    ? car
      > .x history.x_case(name)
      > .y history.y_case(name)
      > .z history.z_case(name)

  + epoch
    \ car=care version=maybe[nat] name=path history=sov
    ^ maybe[nat]
    > (./some number) version (./some history.top)
    = clocks | history.ever_at name
    ? car
      > .x (track/epoch number clocks.x)
      > .y (track/epoch number clocks.y)
      > .z (track/epoch number clocks.z)

  + records
    '  Internal projection. Structural prefixes do not need ledgers.
    \ epoch=nat name=path history=sov
    ^ axal[saga]
    | history.idx.dip(name).filter_map
      \ held
      | ass/saga epoch (unpin held.held)

  + frontier
    '  Project care-y directly: stop at each nearest live descendant
    '  instead of materializing the complete subtree and discarding it
    '  with snip.
    \ epoch=nat name=path history=sov
    ^ axal[saga]
    = subtree | history.idx.dip name
    % todo=row[[p=path q=axal[tome]]] (sov/kids ('/) subtree)
      out=axal[saga]
      | axal/new[saga] (ass/saga epoch (tome/hist subtree.fil))
    ^ axal[saga]
    > (./some hit) todo.pull out
    = [kid rest]  hit
      [at branch] kid
    > (./some record) (ass/saga epoch (tome/hist branch.fil))
      | _ rest.weld((sov/kids at branch)) out
    | _ rest out.put(at record)

  + root
    '  A composed browsing view, never a versioned assertion at
    '  the root (`'/`).
    \ car=care state=namespace
    ^ axal[saga]
    '  Authorities occupy disjoint root children; reuse their subtrees.
    =   project
      ? car
        > .y namespace/frontier
        > .z namespace/records
        > .x namespace/records
    = system (unpin state.system).state
      shared | project system.top ('/) system
      local  | project state.local.top ('/) state.local
      all    | axal[saga] .none (shared.kid.uni(local.kid))
    ? car
      > .x (axal/new[saga] .none)
      > .y all
      > .z all

  + page
    '  A safe names a data case for one path and care. To read it,
    '  history selects the local or system store; epoch translates that
    '  case using this path's clock. With no case, read the selected
    '  store at its current top. Project the result to the record (x),
    '  its frontier (y), or its subtree (z). Thus case 2 at /a need not
    '  have happened in the same epoch as case 2 at /b.
    '
    '  This is the stored page. Start at sovereign_peek for virtual
    '  paths such as /h and /x; their answers can depend on records at
    '  other paths. tests/namespace.foil exercises historical pages and
    '  replay against the system publication recorded in the journal.
    \ car=care version=maybe[nat] name=path state=namespace
    ^ res[axal[saga]]
    ? (eq name.len 0)
      ? version
        > (./some _) .unknown
      ? car
        > .x .unknown
      | ./known | state.root car
    > (./some history) state.history(name) .unknown
    > (./some epoch)
      | namespace/epoch car version name history
      .unknown
    ? history.x_at(epoch name)
      > .null
        ? car
          > .x .null
        .unknown
      > .unknown .unknown
      > (./known _)
        = records | namespace/records epoch name history
        ? car
          > .x (./known (axal/new[saga] records.fil))
          > .y (./known records.snip)
          > .z (./known records)

  + permitted
    '  The journal is written by commit, never by handler-produced
    '  diffs.
    \ name=path state=namespace
    ^ bool
    ? (not (state.owns(name))) .false
    | not (pith_prefix [state.self 'log] name)

  + trial
    '  The pure candidate commit. An event that changes anything also
    '  brings the kernel's dependency index declaration up to date, so
    '  every committed namespace carries it. Only the kernel writes that
    '  declaration: callers may neither change nor bury it.
    \ diffs=axal[note] now=nat block=nat state=namespace
    ^ either[iota [raw=axal[note] next=sov changes=axal[sign]]]
    = home (idx/deps/home state.self)
    ? (or diffs.has(home) (cull/cover home diffs))
      | ./err 'idx_kernel
    < result=[next=sov changes=axal[sign]]
      | sov/step diffs now block state.local
    = [next changes] result
    ? (eq changes.wyt 0) (./ok [diffs next changes])
    > (./some seed) (idx/deps/seed state.self next)
      | ./ok [diffs next changes]
    = raw | diffs.put home seed
    < again=[next=sov changes=axal[sign]]
      | sov/step raw now block state.local
    = [seeded grades] again
    | ./ok [raw seeded grades]

  + merge_notes
    '  Keep the potentially large index tree; derived notes retain
    '  precedence.
    \ raw=axal[note] derived=axal[note]
    ^ axal[note]
    | raw.tap.fold derived
    \ out [name change]
    ? derived.has(name) out
    | out.put name change

  + step
    '  Check ownership before dispatch to the store and after cull
    '  expansion. The preliminary candidate is pure; only the final
    '  complete store returns.
    \ diffs=axal[note] now=nat block=nat state=namespace
    ^ either[iota namespace/committed]
    ? (not (diffs.tap.all((\ [name change] state.permitted(name)))))
      | ./err 'write_outside_authority
    = expanded | gate/prepare diffs state.local.top state.local.idx
    ? (not (expanded.tap.all((\ [name change] state.permitted(name)))))
      | ./err 'protected_journal
    < staged (namespace/trial diffs now block state)
    = [raw next changes] staged
    '  A no-op must not mint a journal record and wake version
    '  watchers.
    ? (eq changes.wyt 0)
      | ./ok (namespace/committed state changes)
    '  Index content is derived here, in the same epoch as its
    '  sources. The journal keeps the caller's diffs; replay
    '  re-derives the rest.
    < derived
      | idx/settle raw changes state.local next [state.self 'log]
    '  Index creation can derive far more notes than the caller
    '  wrote. Keep that tree and add the small raw set, with derived
    '  precedence.
    = address=path [state.self 'log ($u next.top)]
    =   event
      | namespace_event state.system (pin diffs) state.local.top now
        block
    = record   | myth/sing system_vocabulary/content event
      merged   | namespace/merge_notes raw derived
      complete | merged.put address (note/make record)
    < result=[committed=sov signs=axal[sign]]
      | sov/step complete now block state.local
    = [committed signs] result
    | ./ok (namespace/committed state.set_local(committed) signs)

  + replay
    \ event=namespace_event state=namespace
    ^ either[iota namespace/committed]
    ? (not (equal[pin[system_publication]] event.system state.system))
      | ./err 'system_publication_mismatch
    ? (not (eq event.predecessor state.local.top))
      | ./err 'journal_predecessor_mismatch
    < result
      | namespace/step (unpin event.changes) event.now event.block state
    ? (eq result.state.local.top state.local.top)
      | ./err 'empty_journal_event
    | ./ok result

  + service
    \ relative=path state=namespace
    ^ path
    | row/weld relative [state.self]

'  --- virtual addresses & markers ---

+ dig_parse
  '  Compatibility name for the standard decimal codec.
  nat/parse

+ dig_of
  '  A case/len path segment as a nat. Digit segments arrive as u u
  '  iotas now that URL segments run the aura codec, so only the u arm
  '  remains.
  \ i=iota
  ^ maybe[nat]
  ? i
    > ($u x=nat) (./some x)
  .none

+ dig_cord
  '  Compatibility name for the standard decimal codec.
  nat/show

+ dig_show
  '  A nat as a path segment: a u iota, which prints as bare decimal. (A
  '  decimal ts cord would no longer even print — symbols cannot start
  '  with a digit.)
  \ n=nat
  ^ iota
  | $u n

+ h_care
  '  The care segment of an /h path.
  \ i=iota
  ^ maybe[care]
  ? (eq_iota i 'x)
    | ./some .x
  ? (eq_iota i 'y)
    | ./some .y
  ? (eq_iota i 'z)
    | ./some .z
  .none

+ epoch_of
  '  An epoch pin is a text segment e<digits>, distinct from a local
  '  case.
  \ i=iota
  ^ maybe[nat]
  ? (not (is_text i)) .none
  =   text
    (
      ^ str
      | quip_val i)
  ? (lt text.len 2) .none
  ? (not (eq 101 text.at(0))) .none
  | nat/parse text.slice(1 text.len.dec)

+ is_h_version
  \ target=path
  ^ bool
  ? (not (is_h target)) .false
  | eq_iota target.at(1) 'v

+ is_virtual
  \ pax=path
  ^ bool
  ? (is_r pax) .true
  ? (is_h pax) .true
  ? (is_o pax) .true
  ? (is_xv pax) .true
  | is_cx pax

+ reserved_virtual_err
  \ target=path
  ^ maybe[iota]
  ? (is_r target) (./some 'r_reserved)
  ? (is_h target) (./some 'h_reserved)
  ? (is_o target) (./some 'o_reserved)
  ? (is_xv target) (./some 'x_reserved)
  .none

+ is_pinned_history
  \ pax=path
  ^ bool
  | and (is_h pax) (not (is_h_version pax))

+ h_parse_fin
  '  The shared tail of h_parse: the len segment, the target, and the
  '  trailing relative segments.
  \ cr=care c=nat ep=nat pax=path
  ^ maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  < ln (dig_of pax.at(3))
  = p pax.drop(4)
  ? (lt p.len ln) .none
  | ./some [cr c ep p.take(ln) p.drop(ln)]

+ h_parse
  '  A fully-formed /h care path, split: the care, the case (or the
  '  pinned sovereign epoch — an e<digits> case segment), the target,
  '  and the trailing relative segments. ep=0 means case mode; nonzero
  '  ep pins the shared epoch clock and c rides 1 (epoch answers are
  '  constant like every /h answer: epochs past the sovereign's top
  '  refuse to resolve rather than float). .none while any level is
  '  structural or malformed. (/h/v is the version view, not a care —
  '  h_peek owns it.)
  \ pax=path
  ^ maybe[[cr=care c=nat ep=nat tgt=path rel=path]]
  ? (lt pax.len 4) .none
  < cr (h_care pax.at(1))
  ? (dig_of pax.at(2))
    > (./some c)
      ? (eq c 0) .none
      | h_parse_fin cr c 0 pax
  < epoch (epoch_of pax.at(2))
  ? (eq epoch 0) .none
  | h_parse_fin cr 1 epoch pax

+ o_parse
  '  A fully-formed /o path, split: the overlay-function case, the
  '  overlay path, the data path, and the trailing relative segments.
  '  .none while any level is structural or malformed.
  \ pax=path
  ^ maybe[[c=nat op=path dp=path rel=path]]
  ? (lt pax.len 4) .none
  < c (dig_of pax.at(1))
  ? (eq c 0) .none
  < oln (dig_of pax.at(2))
  = p pax.drop(3)
  ? (lt p.len oln) .none
  = q p.drop(oln)
  ? (eq q.len 0) .none
  < dln (dig_of q.at(0))
  = r q.drop(1)
  ? (lt r.len dln) .none
  | ./some [c p.take(oln) r.take(dln) r.drop(dln)]

+ r_parse
  '  Parse /r/<len>/<target...>/<relative...>: the target whose
  '  references are read, by its length, and the relative segments that
  '  pick one edge (<slot len>/<slot...>/<holder...>). Length- prefixed
  '  only, like /h and /o: a target is never found by search.
  \ requested=path
  ^ maybe[[target=path relative=path]]
  ? (lt requested.len 2) .none
  > (./some width) (dig_of requested.at(1)) .none
  ? (or (eq width 0) (lt requested.len (add width 2))) .none
  | ./some [requested.drop(2).take(width) requested.drop((add width 2))]

+ h_mark
  '  A marker record for structural /h nodes.
  \ d=str
  ^ myth
  = t myth/new
  t.put(system_vocabulary/help (pails/t d))

+ history_marker
  \ text=str
  ^ axal[myth]
  | axal/new[myth] (./some (h_mark text))

+ help
  + h_prefix
    ^ str
    | str/cat_all
      [
        "the target path continues below; cases are target-local, "
        "so incomplete targets have no historical child listing"]

  + h_root
    ^ str
    | str/cat_all
      [
        "time travel: /h/care/case/len/...path resolves (care, "
        "case) against the first len segments of the path and dips "
        "the rest into the answer. x is the record, y adds the "
        "nearest-live frontier, z the whole subtree. an e<epoch> "
        "case segment pins the shared sovereign epoch instead of a "
        "target-local case. /h/v/len/...path is the version view. "
        "read only."]

  + h_version
    ^ str
    | str/cat_all
      [
        "version info: path-local data and shape counters plus mint"
        " time"]

  + h_peek
    ^ str
    | str/cat_all
      [
        "cases are target-local: /h/care/case/len/...target. an "
        "e<epoch> case pins the shared sovereign epoch instead."]

  + history_root
    ^ str
    | str/cat_all
      [
        "Historical reads use /h/care/case/len/<authority>/...; "
        "e<epoch> selects that authority's epoch. "
        "/h/v/len/<authority>/... shows current version metadata. "
        "Read only."]

  + history_case
    ^ str
    | str/cat_all
      [
        "below: /case/len/<authority>/...; e<epoch> selects the "
        "target authority's epoch"]

  + history_target
    ^ str
    | str/cat_all
      [
        "the fully qualified target continues below; an incomplete "
        "target has no historical child listing"]

  + history_version
    ^ str
    | str/cat_all
      [
        "the fully qualified target continues below; the global "
        "root has no version"]

  + o_marks
    ^ str
    | str/cat_all
      [
        "overlay lens: /o/case/olen/...opath/dlen/...dpath applies "
        "the overlay function minted at opath's x case (the "
        "/sys/weft slot) to the CURRENT data at dpath. result cases"
        " follow the ctor's case algebra: dyed and knit carry the "
        "data's x case, felt and sewn its z case. read only."]

  + x_marks
    ^ str
    | str/cat_all
      [
        "view lens: /x/...path evaluates the defining datum's "
        "pinned weft and tack (y care). Its own x case identifies "
        "the result. Read only."]

+ h_prefix
  '  A structural /h node above the target. Local cases cannot be
  '  resolved until the complete target is known, so case-first paths
  '  deliberately do not enumerate historical children here.
  \ c=nat p=path s=sov
  ^ axal[myth]
  | history_marker help/h_prefix

+ h_root
  ^ axal[myth]
  = a0 | history_marker help/h_root
    a1 a0.put('/x (h_mark "x at a case: the record alone"))
  =   a2
    | a1.put '/y
      | h_mark "y at a case: the record and its nearest-live frontier"
  = a3 a2.put('/z (h_mark "z at a case: the whole subtree"))
  a3.put('/v (h_mark help/h_version))

+ sovereign_history_root
  ^ axal[myth]
  = root | history_marker help/history_root
    root root.put('/x (h_mark "record at a target-local case"))
  =   root
    | root.put '/y
      | h_mark "record and nearest-live frontier at a target-local case"
  = root root.put('/z (h_mark "subtree at a target-local case"))
  | root.put '/v
    | h_mark "current version metadata for a fully qualified target"

+ sovereign_history_prefix
  '  Structural browsing has no assertion or global historical version.
  '  Once a target is complete, the namespace reader selects its
  '  authority.
  \ pax=path
  ^ axal[myth]
  = none (axal/new[myth] .none)
    n    pax.len
  ? (not (is_h pax)) none
  ? (eq n 1) sovereign_history_root
  = version (eq_iota pax.at(1) 'v)
  ? (not version)
    > (./some _) (h_care pax.at(1)) none
    ? (eq n 2)
      | history_marker help/history_case
    =   valid
      (
        ? (dig_of pax.at(2))
          > (./some number) (gt number 0)
        ? (epoch_of pax.at(2))
          > (./some number) (gt number 0)
        .false)
    ? (not valid) none
    ? (eq n 3) (history_marker "below: /len/<authority>/...")
    > (./some width) (dig_of pax.at(3)) none
    ? (or (eq width 0) (not (lt n (add 4 width)))) none
    | history_marker help/history_target
  ? (eq n 2) (history_marker "below: /len/<authority>/...")
  > (./some width) (dig_of pax.at(2)) none
  ? (or (eq width 0) (not (lt n (add 3 width)))) none
  | history_marker help/history_version

+ o_marks
  '  The structural and shrug answers for an /o path that does not parse
  '  as a complete overlay application: docs at the root, below-markers
  '  at the count levels, non-enumerating prefixes (exactly like /h),
  '  and the empty tree on malformed segments.
  \ pax=path s=sov
  ^ axal[myth]
  = none (axal/new[myth] .none)
    n    pax.len
  ? (lt n 2)
    | history_marker help/o_marks
  > (./some c) (dig_of pax.at(1)) none
  ? (eq c 0) none
  ? (eq n 2)
    | history_marker "below: /olen/...opath/dlen/...dpath"
  > (./some oln) (dig_of pax.at(2)) none
  = p pax.drop(3)
  ? (lt p.len oln) (h_prefix c p s)
  = q p.drop(oln)
  ? (eq 0 q.len) (history_marker "below: /dlen/...dpath")
  > (./some dln) (dig_of q.at(0)) none
  = r q.drop(1)
  ? (lt r.len dln) (h_prefix c r s)
  none

+ x_marks
  '  The structural answers for an incomplete /x path: the doc at the
  '  root, the empty tree otherwise (the node path is the whole tail —
  '  there is nothing to enumerate).
  \ pax=path s=sov
  ^ axal[myth]
  ? (lt pax.len 2)
    | history_marker help/x_marks
  | axal/new[myth] .none

'  --- readers ---

+ read_fuel
  '  Reads one derived read may make, nested cells included; running out
  '  answers unknown and says so. The ceiling, not a budget: a
  '  well-connected thing as a world opens 150 records and reads each
  '  one's frontier, identities and incoming edges. A cell declares a
  '  smaller budget of its own at /sys/view/fuel
  '  (woven_evaluate_select).
  ^ nat
  32768

+ namespace_reader
  '  All callbacks receive a fully qualified target. An epoch belongs to
  '  that target's authority; there is no namespace-wide epoch.
  : page={\ care nat path}res[axal[saga]]
    version={\ path}res[axal[myth]] case={\ care path}maybe[nat]
    culled={\ path}bool references={\ nat path}res[row[reference_edge]]
    freeze={\ nat}maybe[namespace_reader]
    fuel=nat cut=nat trail=row[path] top=nat

+ axal_empty_node
  (@ v)
  \ tree=axal[v]
  ^ bool
  | and (not (maybe/is_some tree.fil)) (eq tree.kid.size 0)

+ res_root
  \ answer=res[axal[myth]]
  ^ res[myth]
  ? answer
    > (./known tree)
      > (./some record) tree.fil .unknown
      | ./known record
    > .null .null
    > .unknown .unknown

+ store_page
  \ cr=care c=nat pax=path s=sov
  ^ res[axal[saga]]
  ? cr
    > .x
      =   r
        (
          ? (eq 0 c)
            s.assertion_at(s.top pax)
          s.assertion_query(c pax))
      ? r
        > (./known t) (./known (axal/new[saga] (./some t)))
        > .null .null
        > .unknown .unknown
    > .y
      ? (eq 0 c)
        s.y_latest(pax)
      s.y_query(c pax)
    > .z
      ? (eq 0 c)
        s.z_latest(pax)
      s.z_query(c pax)

+ store_visible
  '  Transparent folders are navigable even without an assertion of
  '  their own. Project their frontier directly for y; do not scan the
  '  whole subtree.
  \ cr=care c=nat target=path state=sov
  ^ res[axal[saga]]
  = found (store_page cr c target state)
  ? (or (gt c 0) (equal[care] cr .x)) found
  ? found
    > .unknown
      =   records
        (
          ? cr
            > .y (namespace/frontier state.top target state)
          | namespace/records state.top target state)
      ? (axal_empty_node records) .unknown
      | ./known records
  found

+ store_references
  '  The edges that name a target as of an epoch: the index's current
  '  edges at 0 or the top epoch, the snapshot at that epoch otherwise,
  '  unknown past the kept span or beyond the top.
  \ state=sov
  ^ {\ nat path}res[row[reference_edge]]
  \ epoch=nat target=path
  ^ res[row[reference_edge]]
  ? (gt epoch state.top) .unknown
  = kept state.references.past.tap
  =   first
    (
      ^ nat
      ? (eq kept.len 0) 0
      > (./some n) (dig_of kept.at(0).key) 0
      n)
  ? (and (gt epoch 0) (lt epoch first)) .unknown
  '  A live read takes the index's current edges; only a pinned epoch
  '  unpins a snapshot. The snapshot at the top epoch is the current
  '  edges anyway, and unpinning it on every read cost seconds on a long
  '  history.
  | ./known
    | reference_index/beneath target
      (? (or (eq epoch 0) (ge epoch state.top)) 0 epoch)
      state.references

+ store_culled
  '  Whether a path is a tombstone now: it was written and then culled,
  '  and nothing has been written there since. A path never written is
  '  not culled.
  \ s=sov
  ^ {\ path}bool
  \ target=path
  ^ bool
  = h s.hist(target)
  ? (ass/res s.top h)
    > .null .true
  .false

+ store_case
  '  The current case of a path at a care, record or folder.
  \ s=sov
  ^ {\ care path}maybe[nat]
  \ cr=care target=path
  ^ maybe[nat]
  = clocks s.ever_at(target)
  =   clock
    (
      ? cr
        > .x clocks.x
        > .y clocks.y
      clocks.z)
  | track_case_at s.top clock

+ store_freeze
  '  A reader pinned at an epoch the store still holds, or none.
  \ s=sov
  ^ {\ nat}maybe[namespace_reader]
  \ epoch=nat
  ^ maybe[namespace_reader]
  ? (or (eq epoch 0) (gt epoch s.top)) .none
  | ./some (store_reader s.set_top(epoch)).set_cut(epoch)

+ store_reader
  '  A reader over a store's current state.
  \ s=sov
  ^ namespace_reader
  =   page
    (
      \ car=care version=nat target=path
      | store_visible car version target s)
  =   version
    (
      \ target=path
      ^ res[axal[myth]]
      ? (eq target.len 0) .unknown
      | ./known (h_ver target s))
  | namespace_reader page version (store_case s) (store_culled s)
    | store_references s
    | store_freeze s
    read_fuel
    0
    []
    s.top

+ store_page_reader
  '  Trigger discovery uses exact pages, including the root version.
  \ s=sov
  ^ namespace_reader
  | namespace_reader
    (\ car version target (store_page car version target s))
    (\ target=path (./known (h_ver target s)))
    (store_case s) (store_culled s) (store_references s)
    (store_freeze s) read_fuel 0 [] s.top

+ sovereign_page
  \ state=namespace cr=care c=nat target=path
  ^ res[axal[saga]]
  ? (eq target.len 0)
    ? (gt c 0) .unknown
    ? cr
      > .x .unknown
    | ./known (state.root(cr))
  > (./some history) state.history(target) .unknown
  = paged (store_visible cr c target history)
  '  A y or z read of the latest case beneath a record-less prefix (a
  '  folder with children and no record of its own) is the committed
  '  subtree, as sovereign_peek_value already answers it.
  ? (and (eq c 0) (not (?=(.x cr))))
    ? paged
      > .unknown
        = found (namespace/records history.top target history)
          found (sorge[saga] cr found)
        '  An empty answer is a folder emptied (it has a y case)
        '  or a path that never existed (it has none).
        ? (axal_empty_node found)
          ? (maybe/is_some state.local.y_case(target)) (./known found)
          | .unknown
        | ./known found
    paged
  paged

+ sovereign_reader
  '  A reader over a namespace state: its pages, its references by
  '  epoch, its freezes, with the full fuel.
  \ state=namespace
  ^ namespace_reader
  = page | sovereign_page state
  =   version
    (
      \ target=path
      ^ res[axal[myth]]
      ? (eq target.len 0) .unknown
      > (./some history) state.history(target) .unknown
      | ./known (h_ver target history))
  =   case
    (
      '  The current case of a path at a care, record or folder.
      \ cr=care target=path
      ^ maybe[nat]
      > (./some history) state.history(target) .none
      = read (store_case history)
      | read cr target)
  = references | store_references state.local
  =   freeze
    (
      \ epoch=nat
      ^ maybe[namespace_reader]
      ? (or (eq epoch 0) (gt epoch state.local.top)) .none
      =   frozen
        . state
          set_local(state.local.set_top(epoch))
          set_system((namespace/system_at epoch state))
      | ./some (sovereign_reader frozen).set_cut(epoch))
  | namespace_reader page version case (store_culled state.local)
    references
    freeze
    read_fuel
    0
    []
    state.local.top

+ view_value
  '  Read a view at a care and case through a reader over the store.
  \ cr=care c=nat pax=path s=sov
  ^ res[axal[myth]]
  | resolve_value cr c pax (store_reader s)

+ sovereign_value
  \ cr=care c=nat pax=path state=namespace
  ^ res[axal[myth]]
  | resolve_value cr c pax (sovereign_reader state)

'  --- views: history, reverse & resolver ---

+ h_ver
  '  The version view of a path, as of top: its independent local data
  '  and shape counters per care, plus the latest assertion's mint time
  '  and blockheight, as decimal pails/t entries. Case links are
  '  target-relative and rendered separately by the explorer. Unlike the
  '  case overlays this view is LIVE: it advances as new cases mint (but
  '  never signs — /h is writeless). system_vocabulary/version/first
  '  is the target's first x epoch (0 if never minted) and
  '  system_vocabulary/version/top the sovereign's current epoch — the
  '  epoch-pin spelling's bounds.
  \ tgt=path s=sov
  ^ axal[myth]
  = none (axal/new[myth] .none)
    h    s.hist(tgt)
    ev   s.ever_at(tgt)
  = header (ass/yuga s.top h)
    locks  (header.fall((yuga (lock 0 0) (lock 0 0) (lock 0 0) 0 0)))
  = used (add locks.x.data (add locks.y.data locks.z.data))
  ? (eq 0 used)
    none
  =   state=str
    ? (ass/res s.top h)
      > (./known _) "live"
      > .null "tombstone"
      > .unknown "unknown"
  = [now block] [locks.now locks.block]
    first       (track/epoch 1 ev.x).fall(0)
    base        myth/new
  =   record
    (
      | base.gas
      [
        [system_vocabulary/version/state (pails/t state)]
        [system_vocabulary/version/x_data (pails/t locks.x.data.show)]
        [system_vocabulary/version/x_shape (pails/t locks.x.shape.show)]
        [system_vocabulary/version/y_data (pails/t locks.y.data.show)]
        [system_vocabulary/version/y_shape (pails/t locks.y.shape.show)]
        [system_vocabulary/version/z_data (pails/t locks.z.data.show)]
        [system_vocabulary/version/z_shape (pails/t locks.z.shape.show)]
        [system_vocabulary/version/now (pails/t now.show)]
        [system_vocabulary/version/block (pails/t block.show)]
        [system_vocabulary/version/first (pails/t first.show)]
        [system_vocabulary/version/top (pails/t s.top.show)]])
  | axal/new[myth] | ./some record

+ h_version_triggers
  '  Version views are live. Their top field follows the target
  '  authority.
  \ requested=path
  ^ row[dep]
  ? (not (is_h_version requested)) []
  > (./some width) (dig_of requested.at(2)) []
  ? (or (eq width 0) (lt requested.len (add width 3))) []
  = target | requested.drop(3).take(width)
  [(dep .z target) (dep .z target.take(1))]

+ reverse_triggers
  '  What a /r read depends on: the index at its target.
  \ requested=path
  ^ row[dep]
  > (./some address) (r_parse requested) []
  = [target relative] address
  | [(dep .z (r_spell target))]

+ reverse_view
  '  Each edge has an unambiguous address made from its slot width, slot
  '  and holder. The complete target safe is data, so pinned and live
  '  links differ.
  \ epoch=nat target=path reader=namespace_reader
  ^ res[axal[myth]]
  = read_edges reader.references
  > (./known edges) (read_edges epoch target) .unknown
  = reader (? (eq epoch 0) reader reader.set_cut(epoch))
    root   (myth/sing '/count (pails/n edges.len))
  | ./known
  | edges.fold (axal/new[myth] (./some root))
    \ out edge
    = origin     (woven_origin (safe 0 .x edge.holder) reader)
      width=path [($u edge.slot.len)]
      at         width.weld(edge.slot).weld(edge.holder)
    =   record
      . (myth/sing '/holder origin)
        put('/slot (pails/p edge.slot))
        put('/target edge.target)
    | out.put at record

+ missing_relative
  \ relative=path subtree=axal[myth]
  ^ bool
  | and (gt relative.len 0) (axal_empty_node subtree)

+ resolve_r
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  > (./some address) (r_parse pax) .unknown
  = [target relative] address
  > (./known tree) (reverse_view c target reader) .unknown
  = subtree tree.dip(relative)
  ? (missing_relative relative subtree)
    .unknown
  | ./known (sorge[myth] cr subtree)

+ resolve_h_version
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  ? (gt c 0) .unknown
  > (./some width) (dig_of pax.at(2)) .unknown
  = tail | pax.drop 3
  ? (or (eq width 0) (lt tail.len width)) .unknown
  = target | tail.take width
  =   relative
    | (tail.drop(width)).map
      \ segment=iota
      ^ iota
      ? (dig_of segment)
        > (./some number) ($u number)
      segment
  = read_version reader.version
  > (./known values) (read_version target) .unknown
  = selected | values.dip relative
  ? (eq selected.tap.len 0) .unknown
  | ./known (sorge[myth] cr selected)

+ resolve_h
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  > (./some hp) (h_parse pax)
    .unknown
  ? (gt c 1)
    .unknown
  = [hcr hc hep tgt rel] hp
  =   got
    (
      ^ res[axal[myth]]
      ? hep
        = freeze reader.freeze
        > (./some frozen) (freeze hep) .unknown
        | resolve_value hcr 0 tgt frozen.set_fuel(reader.fuel)
      | resolve_value hcr hc tgt reader)
  > (./known fat) got
    .unknown
  = sub fat.dip(rel)
  ? (eq 0 sub.tap.len)
    .unknown
  | ./known (sorge[myth] cr sub)

+ resolve_o
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  > (./some pr) (o_parse pax)
    .unknown
  = [cpin op dp rel] pr
  > (./known wfat) (resolve_value .x cpin op reader)
    .unknown
  > (./some wm) wfat.fil
    .unknown
  > (./some wf) wm.get(bond/weft)
    .unknown
  = context wm.put(bond/tack (safe c .z dp))
  ? (woven_start context cr rel reader)
    > (./some plan)
      | (woven_run plan reader).value
  = built | overlay_value wf c op dp wm reader
  > (./known bt) built
    .unknown
  = sub bt.dip(rel)
  ? (eq 0 sub.tap.len)
    .unknown
  | ./known (sorge[myth] cr sub)

+ resolve_xv
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  ? (lt pax.len 2)
    .unknown
  > (./some address) (cell_address c pax.drop(1) reader) .unknown
  = [root relative] address
  > (./known definition) (resolve_value .x c root reader) .unknown
  > (./some record) definition.fil .unknown
  ? (woven_start record cr relative reader)
    > (./some plan)
      ? (and (gt c 0) (gt (live_references record).len 0)) .unknown
      | (woven_run plan reader).value
  ? (cell_run c root reader)
    > (./known pair)
      = [ctx tree] pair
      ? (maybe/is_some ctx.get('/sys/view/fault))
        .unknown
      = subtree tree.dip(relative)
      ? (missing_relative relative subtree)
        .unknown
      | ./known (sorge[myth] cr subtree)
    > .null .null
  .unknown

+ resolve_cx
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  ? (lt pax.len 3)
    .unknown
  > (./some address) (cell_address c pax.drop(2) reader) .unknown
  = [root relative] address
  > (./known definition) (resolve_value .x c root reader) .unknown
  > (./some record) definition.fil .unknown
  ? (woven_start record cr relative reader)
    > (./some plan)
      | ./known
        | sorge[myth] cr (woven_context c root relative record reader)
  ? (cell_run c root reader)
    > (./known pair)
      = [ctx tree] pair
      | ./known (sorge[myth] cr (axal/new[myth] (./some ctx)))
    > .null .null
  .unknown

+ resolve_value
  '  THE derived-namespace resolver: the cr-shaped answer for pax at
  '  case c, where c=0 means latest. Real paths answer from the sov's
  '  cased queries. /h paths recurse on their target — so a target
  '  under /o resolves through the lens — and are constant: they
  '  answer only at c=0 or c=1. /o paths resolve their overlay function
  '  at the pinned case (the opath may itself be derived), read their
  '  data at c through this same resolver — so data under /h or nested
  '  /o composes — apply get, and shape the result by cr. /x resolves
  '  input safe pins from the selected datum case; reference graphs must
  '  be acyclic. Structural markers live in the peeks, not here: an
  '  incomplete derived path is a shrug.
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[myth]]
  ? (eq reader.fuel 0) .unknown
  = reader reader.set_fuel(reader.fuel.dec)
  ? (is_r pax)
    | resolve_r cr c pax reader
  ? (is_h_version pax)
    | resolve_h_version cr c pax reader
  ? (is_h pax)
    | resolve_h cr c pax reader
  ? (is_o pax)
    | resolve_o cr c pax reader
  ? (is_xv pax)
    | resolve_xv cr c pax reader
  ? (is_cx pax)
    | resolve_cx cr c pax reader
  = read_page reader.page
  | (read_page cr c pax).run saga/values

+ computed_case
  ' The existing view case algebra, bounded like evaluation itself.
  \ c=nat pax=path reader=namespace_reader
  ^ nat
  ? (gt c 0) c
  ? (eq reader.fuel 0) 0
  = reader reader.set_fuel(reader.fuel.dec)
  ? (is_r pax) reader.top
  ? (is_h_version pax)
    > (./some width) (dig_of pax.at(2)) 0
    = target  pax.drop(3).take(width)
      version reader.version
    > (./known tree) (version target) 0
    > (./some record) tree.fil 0
    = text record.txt_at(system_vocabulary/version/top)
    | (nat/parse text).fall(0)
  ? (is_h pax) 1
  ? (is_o pax)
    > (./some address) (o_parse pax) 1
    = [pin definition input relative] address
    > (./known tree) (resolve_value .x pin definition reader) 0
    > (./some record) tree.fil 0
    > (./some fn) record.get(bond/weft) 0
    =   car
      (
        ^ care
        ? fn
          > _=dyed .x
          > _=knit .x
        .z)
    ? (is_virtual input) (computed_case 0 input reader)
    = case reader.case
    | (case car input).fall(0)
  ? (or (is_xv pax) (is_cx pax))
    = target (? (is_cx pax) pax.drop(2) pax.drop(1))
    ? (eq target.len 0) 1
    > (./some address) (cell_address 0 target reader) 0
    = [root relative] address
    ? (is_virtual root) (computed_case 0 root reader)
    = case reader.case
    | (case .x root).fall(0)
  1

+ resolve_view
  ' Every committed read returns assertions, including computed views.
  ' Historical physical reads keep the original aeon and content pin.
  \ cr=care c=nat pax=path reader=namespace_reader
  ^ res[axal[saga]]
  ? (eq reader.fuel 0) .unknown
  ? (and (is_h pax) (not (is_h_version pax)))
    > (./some hp) (h_parse pax) .unknown
    ? (gt c 1) .unknown
    = [hcr hc hep target relative] hp
    = next reader.set_fuel(reader.fuel.dec)
    =   got
      (
        ^ res[axal[saga]]
        ? hep
          = freeze reader.freeze
          > (./some frozen) (freeze hep) .unknown
          | resolve_view hcr 0 target frozen.set_fuel(next.fuel)
        | resolve_view hcr hc target next)
    > (./known tree) got .unknown
    = sub tree.dip(relative)
    ? (eq sub.wyt 0) .unknown
    | ./known (sorge[saga] cr sub)
  ? (is_virtual pax)
    | (resolve_value cr c pax reader).run
      \ tree (saga/computed (computed_case c pax reader) tree)
  = page reader.page
  | page cr c pax

+ view
  \ cr=care c=nat pax=path s=sov
  ^ res[axal[saga]]
  | resolve_view cr c pax (store_reader s)

+ sovereign_view
  \ cr=care c=nat pax=path state=namespace
  ^ res[axal[saga]]
  | resolve_view cr c pax (sovereign_reader state)

'  --- views: woven evaluator ---

+ woven_origin
  '  A reference out of a pinned virtual view retains that view's
  '  snapshot. Existing explicit cases remain explicit; a local epoch
  '  never labels peers.
  \ source=safe reader=namespace_reader
  ^ safe
  ? (or (eq reader.cut 0) (gt source.ver 0)) source
  = epoch=iota  ($ts (str/cat_all ["e" reader.cut.show]))
    prefix=path ['h (care/seg source.care) epoch ($u source.path.len)]
  | safe 0 source.care prefix.weld(source.path)

+ woven_slot_origin
  \ slot=path held=pail reader=namespace_reader
  ^ pail
  ? held
    > alternatives=view_alternatives
      | view_alternatives
        | alternatives.values.map
          \ contribution
          | contribution.set_source
            | woven_origin contribution.source reader
    > sources=view_origins
      | view_origins
        (sources.sources.map((\ source (woven_origin source reader))))
    > source=safe
      ? (not (equal[path] slot '/sys/view/origin)) held
      | woven_origin source reader
  held

+ woven_origins
  '  Mark each node of a result with the reference it came from, down to
  '  the reader's cut.
  \ tree=axal[myth] reader=namespace_reader
  ^ axal[myth]
  ? (eq reader.cut 0) tree
  | tree.run
    \ record=myth
    | record.tap.fold myth/new
      \ out [slot held]
      | out.put slot (woven_slot_origin slot held reader)

+ resolve_weft
  '  Follow a pinned x-care weft reference once.
  \ held=pail reader=namespace_reader
  ^ either[str pail]
  ? held
    > ref=safe
      ? (or (eq 0 ref.ver) (not (equal[care] ref.care .x)))
        | ./err "weft: the reference must be a pinned x-care safe"
      > (./known tree) (resolve_value .x ref.ver ref.path reader)
        | ./err "weft: the definition was not found"
      > (./some definition) tree.fil
        | ./err "weft: the definition was not found"
      > (./some inner) definition.get(bond/weft)
        | ./err "weft: the definition has no /sys/weft"
      | ./ok inner
  | ./ok held

+ woven_start_select
  '  Resolve only the function. Secondary references remain unevaluated
  '  until the computation asks for them; a hidden eager read is not a
  '  dependency.
  \ record=myth cr=care relative=path select=view_select
    reader=namespace_reader
  ^ maybe[view_plan]
  > (./some held) record.get(bond/weft) .none
  > (./ok fn) (resolve_weft held reader) .none
  ? fn
    > w=woven (./some (w.get record cr relative select))
    > q=pails/q
      < w (graph/by_name q.q)
      | ./some (w.get record cr relative select)
  .none

+ woven_start
  '  Start a plan over the whole selection.
  \ record=myth cr=care relative=path reader=namespace_reader
  ^ maybe[view_plan]
  | woven_start_select record cr relative .all reader

+ woven_remembered
  \ request=view_read memo=row[[view_read res[axal[myth]]]]
  ^ maybe[res[axal[myth]]]
  % i=nat 0
  ^ maybe[res[axal[myth]]]
  ? (eq i memo.len) .none
  = [prior value] memo.at(i)
  ? (equal[view_read] prior request) (./some value)
  | _ i.inc

+ woven_read_cell
  \ request=view_read reader=namespace_reader
  ^ maybe[view_evaluation]
  = ref request.source
  > (./some address) (cell_address ref.ver ref.path.drop(1) reader)
    .none
  = [root relative] address
  > (./known definition) (resolve_value .x ref.ver root reader) .none
  > (./some record) definition.fil .none
  > (./some plan)
    | woven_start_select record ref.care relative request.select
      reader
    .none
  | ./some
    | woven_evaluate_select ref.ver root ref.care relative
      request.select
      reader

+ woven_read_overlay
  \ request=view_read reader=namespace_reader
  ^ maybe[view_evaluation]
  = ref request.source
  > (./some address) (o_parse ref.path) .none
  = [version definition input relative] address
  > (./known tree) (resolve_value .x version definition reader) .none
  > (./some record) tree.fil .none
  = context record.put(bond/tack (safe ref.ver .z input))
  > (./some plan)
    | woven_start_select context ref.care relative request.select
      reader
    .none
  ? (reader.trail.any((\ seen=path (equal[path] seen ref.path))))
    | ./some
      | view_evaluation .unknown [] 0
        "cycle: a reference contains this cell"
  =   evaluated
    | woven_run_select plan request.select
      reader.set_trail(reader.trail.snoc(ref.path))
  = definition_read | view_read (safe version .x definition) .all
    observed        | view_observation definition_read (./known tree)
  | ./some
    evaluated.set_observations(evaluated.observations.cons(observed))

+ woven_read_derived
  \ request=view_read reader=namespace_reader
  ^ maybe[view_evaluation]
  ? (is_xv request.source.path)
    | woven_read_cell request reader
  ? (is_o request.source.path)
    | woven_read_overlay request reader
  .none

+ woven_read
  '  Flatten demand cells into observations of their actual inputs. A
  '  cached parent must not rerun its child formula merely to check
  '  whether it changed.
  \ request=view_read reader=namespace_reader
  ^ view_evaluation
  ? (eq reader.fuel 0)
    | view_evaluation .unknown [] 0 "computation read budget exhausted"
  = reader reader.set_fuel(reader.fuel.dec)
    ref    request.source
    answer (woven_read_derived request reader)
  ? answer
    > (./some evaluated)
      | evaluated.set_value
        | view_project request.select evaluated.value
  =   value
    | view_project request.select
      | resolve_value ref.care ref.ver ref.path reader
  | view_evaluation value [(view_observation request value)] 1
    (? (?=(.unknown value)) "named input unresolved" "")

+ woven_step_read
  \ request=view_read reader=namespace_reader steps=nat
    observations=row[view_observation]
  ^ either[view_evaluation [view_evaluation nat]]
  = answer | woven_read request reader.set_fuel((sub reader.fuel steps))
    used   | add 1 answer.steps
  ? (gt used (sub reader.fuel steps))
    | ./err
      | view_evaluation .unknown observations reader.fuel
        "computation read budget exhausted"
  | ./ok [answer used]

+ woven_graft
  \ ref=safe select=view_select reader=namespace_reader
    steps=nat observations=row[view_observation]
  ^ view_evaluation
  ? (woven_step_read (view_read ref select) reader steps observations)
    > (./err failure) failure
    > (./ok pair)
      = [answer used] pair
      =   result
        | answer.value.run
          \ tree=axal[myth]
          > (./some record) tree.fil tree
          | tree.put ('/)
            record.put('/sys/view/origin (woven_origin ref reader))
      | view_evaluation result observations.weld(answer.observations)
        | add steps used
        answer.fault

+ woven_run_select
  '  The interpreter is schema-independent. Both nested evaluation depth
  '  and the total number of inputs across nested demand cells are
  '  bounded.
  \ plan=view_plan select=view_select reader=namespace_reader
  ^ view_evaluation
  % current=view_plan plan steps=nat 0
    observations=row[view_observation]
    []
    memo=row[[view_read res[axal[myth]]]] []
  ^ view_evaluation
  ? (ge steps reader.fuel)
    | view_evaluation .unknown observations steps
      "computation read budget exhausted"
  ? current
    > (./fail reason)
      | view_evaluation .unknown observations steps reason
    > (./done tree)
      | view_evaluation
        | view_project select (./known (woven_origins tree reader))
        observations
        steps
        ""
    > (./need request next)
      = remembered (woven_remembered request memo)
      ? remembered
        > (./some value)
          | _ (next value) steps.inc observations memo
      ? (woven_step_read request reader steps observations)
        > (./err failure) failure
        > (./ok pair)
          = [answer used] pair
          | _ (next answer.value) (add steps used)
            observations.weld(answer.observations)
            memo.snoc([request answer.value])
    > (./graft ref)
      | woven_graft ref select reader steps observations

+ woven_run
  '  Run a plan over the whole selection.
  \ plan=view_plan reader=namespace_reader
  ^ view_evaluation
  | woven_run_select plan .all reader

+ woven_evaluate_select
  '  The defining record is part of the observation manifest. Pinned
  '  function references are immutable; dynamic inputs are discovered by
  '  interpreting it.
  \ c=nat root=path cr=care relative=path select=view_select
    reader=namespace_reader
  ^ view_evaluation
  = source     (safe c .x root)
    definition (resolve_value .x c root reader)
    own        (view_observation (view_read source .all) definition)
  > (./known tree) definition
    | view_evaluation .unknown [own] 0 "cell definition unavailable"
  > (./some record) tree.fil
    | view_evaluation .unknown [own] 0 "cell definition has no record"
  > (./some plan) (woven_start_select record cr relative select reader)
    | view_evaluation .unknown [own] 0 "cell function unavailable"
  ? (and (gt c 0) (gt (live_references record).len 0))
    | view_evaluation .unknown [own] 0
      "live inputs require an epoch pin"
  ? (reader.trail.any((\ seen=path (equal[path] seen root))))
    | view_evaluation .unknown [own] 0
      "cycle: a reference contains this cell"
  '  A cell may declare its own read budget at /sys/view/fuel; the
  '  reader's fuel (read_fuel, or what a nesting cell left) is the
  '  ceiling.
  = declared (record.nat_at('/sys/view/fuel reader.fuel))
  =   fuel
    (
      ? (or (eq declared 0) (gt declared reader.fuel)) reader.fuel
        declared)
  =   answer
    | woven_run_select plan select
      reader.set_trail(reader.trail.snoc(root)).set_fuel(fuel)
  | answer.set_observations(answer.observations.cons(own))

+ woven_evaluate
  '  Evaluate a cell over the whole selection.
  \ c=nat root=path cr=care relative=path reader=namespace_reader
  ^ view_evaluation
  | woven_evaluate_select c root cr relative .all reader

+ woven_observation_record
  \ observation=view_observation reader=namespace_reader
  ^ myth
  =   selection
    (
      ^ iota
      ? observation.read.select
        > .all 'all
        > .names 'names
      | 'slots)
  =   state
    (
      ^ iota
      ? observation.value
        > (./known _) 'known
        > .null 'absent
      | 'unresolved)
  =   cited
    (
      ^ safe
      = source  observation.read.source
        virtual (or (is_xv source.path) (is_o source.path))
      ? (or (gt source.ver 0) (or (is_h source.path) virtual))
        | woven_origin source reader
      > (./some seen) (reader.case source.care source.path)
        | woven_origin source reader
      | safe seen source.care source.path)
  =   item
    . (myth/sing '/source cited)
      put('/selection (pails/q selection))
      put('/state (pails/q state))
  =   item
    (
      > (view_select/slots keys) observation.read.select item
      | keys.fold item
        \ out slot
        | out.put slot.cons('slots) (pails/b .true))
  item

+ woven_observations
  \ observations=row[view_observation]
    reader=namespace_reader context=myth
  ^ axal[myth]
  =   seed=[index=nat tree=axal[myth]]
    [0 (axal/new[myth] (./some context))]
  =   [count result]
    | observations.fold seed
      \ [index tree] observation
      = item (woven_observation_record observation reader)
      [index.inc tree.put(['looks ($u index)] item)]
  result

+ woven_context
  '  Inspect the actual observations of this result without flattening
  '  their values into a second copy of the world. Each source remains a
  '  reference.
  \ c=nat root=path relative=path record=myth reader=namespace_reader
  ^ axal[myth]
  = answer | woven_evaluate c root .z relative reader
  =   status
    (
      ^ iota
      ? answer.value
        > (./known _) 'ready
        > .null 'absent
      | 'unresolved)
  =   context
    . record
      put('/sys/view/status (pails/q status))
      put('/sys/view/steps (pails/n answer.steps))
      put('/sys/view/observations (pails/n answer.observations.len))
  =   context
    (
      ? (eq answer.fault.len 0) context
        (context.put('/sys/view/fault (pails/t answer.fault))))
  '  The citation names the case the read saw, so the look can be
  '  repeated; the dependency itself stays live, so the cache can tell
  '  when it moved.
  | woven_observations answer.observations reader context

+ woven_triggers
  '  What a run depends on: one dependency per observation it made.
  \ answer=view_evaluation
  ^ row[dep]
  | answer.observations.fold []
    \ out observed
    = ref observed.read.source
    ? (gt ref.ver 0) out
    ? (is_h ref.path) out.weld((h_version_triggers ref.path))
    ? (is_r ref.path) out.weld((reverse_triggers ref.path))
    | out.snoc (dep ref.care ref.path)

+ woven_valid
  '  Compare exactly the observations. Missing values and reverse-edge
  '  sets participate too. This check does not invoke the cached
  '  computation.
  \ cached=view_evaluation reader=namespace_reader
  ^ bool
  ? (not (?=((./known _) cached.value))) .false
  | cached.observations.all
    \ observed=view_observation
    = ref    observed.read.source
      frozen (or (gt ref.ver 0) (is_pinned_history ref.path))
    ? (and (?=((./known _) observed.value)) frozen)
      .true
    =   current
      | view_project observed.read.select
        | resolve_value ref.care ref.ver ref.path reader
    | equal current observed.value

'  --- views: overlays & legacy cells ---

+ apply_cell_ctor
  \ fn=pail args=myth input=axal[myth]
  ^ either[str [myth axal[myth]]]
  ? fn
    > ck=cell (./ok (ck.get args input))
    > sp=spun (./ok [args (sp.get args input)])
    > q=pails/q
      > (./some ck) (weft_std/by_name q.q)
        | ./err "weft: not a standard cell"
      | ./ok (ck.get args input)
  | ./err "weft: the definition is not a cell ctor"

+ overlay_value
  \ wf=pail c=nat op=path dp=path wm=myth
    reader=namespace_reader
  ^ res[axal[myth]]
  ? wf
    > d=dyed
      > (./known dt) (resolve_value .x c dp reader)
        .unknown
      > (./some t) dt.fil
        .unknown
      = g d.get
      | ./known (axal/new[myth] (./some (g t)))
    > k=knit
      > (./known dt) (resolve_value .x c dp reader)
        .unknown
      > (./some t) dt.fil
        .unknown
      = g k.get
      | ./known (g t)
    > f=felt
      > (./known dt) (resolve_value .z c dp reader)
        .unknown
      = g f.get
      | ./known (axal/new[myth] (./some (g dt)))
    > w=sewn
      > (./known dt) (resolve_value .z c dp reader)
        .unknown
      = g w.get
      | ./known (g dt)
    > ck=cell (cell_over c op dp wm reader)
    > sp=spun (cell_over c op dp wm reader)
    > q=pails/q (cell_over c op dp wm reader)
    > ref=safe (cell_over c op dp wm reader)
    .unknown

+ view_fault
  '  A cell that cannot run still reads: an empty tree and a context
  '  carrying the reason at /fault.
  \ why=str
  ^ res[[myth axal[myth]]]
  | ./known
    [
      (myth/sing '/sys/view/fault (pails/t why))
      (axal/new[myth] .none)]

+ cell_weft
  '  Direct non-ctors fail before tack checks; a safe's resolved value
  '  is validated later, after the input has been read.
  \ held=pail reader=namespace_reader
  ^ either[str pail]
  ? held
    > pin=safe (resolve_weft held reader)
    > ck=cell (./ok held)
    > sp=spun (./ok held)
    > q=pails/q (./ok held)
  | ./err "weft: not a reference, a ctor, or a ctor's name"

+ cell_address
  '  A cell's virtual children belong to its result. Locate the defining
  '  record before resolving the relative address; a child is not a new
  '  cell. Exact definitions retain the existing behavior, including
  '  derived ones.
  \ c=nat requested=path reader=namespace_reader
  ^ maybe[[root=path relative=path]]
  % width=nat requested.len
  ^ maybe[[root=path relative=path]]
  ? (eq width 0) .none
  = candidate requested.take(width)
  =   found
    (
      ^ bool
      > (./known tree) (resolve_value .x c candidate reader) .false
      > (./some record) tree.fil .false
      | record.has bond/weft)
  ? found (./some [candidate requested.drop(width)])
  | _ width.dec

+ data_of
  '  The data path at the end of a tack chain, with the care of the tack
  '  that reaches it: a derived input is a cell, whose own tack leads
  '  on. Bounded like the cycle walk.
  \ target=path care=care reader=namespace_reader
  ^ [path care]
  % i=nat 0 at=path target c=care care
  ? (eq i 64) [at c]
  ? (not (is_xv at)) [at c]
  > (./some address) (cell_address 0 at.drop(1) reader) [at c]
  = [root relative] address
  > (./known fat) (resolve_value .x 0 root reader) [at c]
  > (./some record) fat.fil [at c]
  > (./some held) record.get(bond/tack) [at c]
  > pin=safe held [at c]
  | _ i.inc pin.path pin.care

+ live_references
  '  The live (version 0) reference slots of a cell record, the tack
  '  among them; the weft is the definition, not an input.
  \ record=myth
  ^ row[safe]
  | record.tap.fold []
    \ acc [slot held]
    ? (eq_pith slot bond/weft) acc
    > pin=safe held acc
    ? (not (eq 0 pin.ver)) acc
    acc.snoc(pin)

+ tack_cycle
  '  Does a live input at target contain the cell at vp, directly or
  '  through a chain of live references between cells? Bounded: a walk
  '  of more than 64 edges counts as a cycle.
  \ vp=path target=path reader=namespace_reader
  ^ bool
  % i=nat 0 work=row[path] [target]
  ? (eq i 64) .true
  ? (eq work.len 0) .false
  = at   work.at(0)
    rest work.drop(1)
  ? (is_o at)
    > (./some overlay) (o_parse at) (_ i.inc rest)
    = [version definition input relative] overlay
    | _ i.inc rest.snoc(input)
  '  A stored input that contains the cell is a cycle, as on main: the
  '  cell would read its own record.
  ? (not (is_xv at)) (? (pith_prefix at vp) .true (_ i.inc rest))
  > (./some address) (cell_address 0 at.drop(1) reader) (_ i.inc rest)
  = [cell relative] address
  ? (pith_prefix cell vp) .true
  > (./known fat) (resolve_value .x 0 cell reader) (_ i.inc rest)
  > (./some record) fat.fil (_ i.inc rest)
  | _ i.inc
    rest.weld((live_references record).map((\ pin=safe pin.path)))

+ view_cause
  '  Why a referenced cell has no answer: its context's /sys/view/fault,
  '  when the reference is a cell's /x. Nothing for a plain path.
  \ ref=path reader=namespace_reader
  ^ maybe[str]
  ? (not (is_xv ref)) .none
  = xs=iota 'x
    cs=iota 'c
    cx=path ref.drop(1).cons(xs).cons(cs)
  > (./known ctx) (resolve_value .x 0 cx reader) .none
  > (./some record) ctx.fil .none
  > (./some held) record.get('/sys/view/fault) .none
  > t=pails/t held .none
  | ./some t.t

+ cell_inputs
  '  Secondary inputs: every reference slot other than the weft and the
  '  tack is read at its case and handed to the ctor as a cell_view at
  '  /views/<slot>. Read-time only, bounded by the record's slots.
  \ vp=path c=nat nm=myth reader=namespace_reader
  ^ either[iota myth]
  = start=either[iota myth] (./ok nm)
  | nm.tap.fold start
    \ acc [slot held]
    > (./ok out) acc acc
    ? (eq_pith slot bond/weft) acc
    ? (eq_pith slot bond/tack) acc
    > ref=safe held acc
    ? (and (eq 0 ref.ver) (gt c 0)) (./err 'pinned)
    ? (and (eq 0 ref.ver) (tack_cycle vp ref.path reader))
      | ./err 'cycle
    '  A live reference that resolves to nothing (a folder emptied, a
    '  table not yet filled) is an empty view, said so in the context; a
    '  pinned reference names a case that must exist.
    ? (reader.culled ref.path)
      ? (eq 0 ref.ver)
        = tag=path '/sys/view/empty
        =   noted
          out.put(tag.weld(slot) (pails/t "the reference was culled"))
        | ./ok
          | noted.put slot.cons('views)
            | cell_view (pin (axal/new[myth] .none))
      | ./err 'missing
    ? (resolve_value ref.care ref.ver ref.path reader)
      > (./known t)
        | ./ok out.put(slot.cons('views) (cell_view (pin t)))
      > .null (./err 'missing)
      ? (eq 0 ref.ver)
        = tag=path '/sys/view/empty
        =   why
          (
            ^ str
            > (./some cause) (view_cause ref.path reader)
              "nothing at the live reference"
            | str/cat_all ["the referenced cell faulted: " cause])
        = noted out.put(tag.weld(slot) (pails/t why))
        | ./ok
          | noted.put slot.cons('views)
            | cell_view (pin (axal/new[myth] .none))
      | ./err 'missing

+ cell_apply
  \ fn=pail input=safe inputs=myth dt=axal[myth]
    reader=namespace_reader
  ^ res[[myth axal[myth]]]
  '  The input's current case rides in the context at /sys/tack/case, so
  '  a ctor can compare a stamp against it. The input of a cell of a
  '  cell is the data at the end of the tack chain, and its y case is
  '  what moves when that data changes.
  = [datum dcare] | data_of input.path input.care reader
    read_case     reader.case
  =   stamped
    (
      ^ myth
      > (./some n) (read_case dcare datum) inputs
      | inputs.put('/sys/tack/case (pails/n n)))
  = args stamped
  ? (apply_cell_ctor fn args dt)
    > (./err why) (view_fault why)
    > (./ok answer) (./known answer)

+ cell_run
  '  Evaluate the cell at vp at case c: its context (own slots plus
  '  secondary inputs) and the tree its ctor derives from the tack.
  '  Nothing is retained; /x reads the tree and /c/x the context.
  \ c=nat vp=path reader=namespace_reader
  ^ res[[myth axal[myth]]]
  > (./known nfat) (resolve_value .x c vp reader)
    .unknown
  > (./some nm) nfat.fil
    .unknown
  > (./some held) nm.get(bond/weft)
    .unknown
  '  A cell that cannot be evaluated reads unknown at /x; /c/x says why,
  '  at /sys/view/fault in its context'. A record without a weft is not
  '  a cell and reads unknown on both.
  = wf (cell_weft held reader)
  =   why
    (
      ^ str
      ? wf
        > (./err e) e
      "")
  > (./ok fn) wf
    | view_fault why
  > (./some tk) nm.get(bond/tack)
    | view_fault "tack: this cell has no /sys/tack"
  > pin=safe tk
    | view_fault "tack: must be a reference to the input"
  '  The input is whatever the tack's care says: x a record, y the
  '  record and its children, z the subtree. A live tack (version 0)
  '  reads its input's latest case, so the cell follows the input. Only
  '  the live cell is live: a pinned case of a live cell has no answer,
  '  and says so in its context. An input that contains this cell, or a
  '  chain of live references that leads back here, is a cycle.
  ? (and (eq 0 pin.ver) (gt c 0))
    | view_fault "live: a live input has no pinned case"
  ? (and (eq 0 pin.ver) (tack_cycle vp pin.path reader))
    | view_fault "cycle: the input contains this cell"
  ? (reader.culled pin.path)
    | view_fault "tack: the input was culled"
  > (./known dt) (resolve_value pin.care pin.ver pin.path reader)
    | view_fault "tack: the input was not found"
  ? (cell_inputs vp c nm reader)
    > (./err why)
      ? (eq_iota why 'pinned)
        | view_fault "live: a live input has no pinned case"
      ? (eq_iota why 'cycle)
        | view_fault "cycle: a reference contains this cell"
      | view_fault "reference: a required input was not found"
    > (./ok inputs)
      | cell_apply fn pin inputs dt reader

+ cell_over
  '  Apply the same cell contract at an /o name. The function's record
  '  supplies arguments and secondary inputs; the address supplies the
  '  tack. This makes an ordinary formula usable over another derived
  '  namespace.
  \ c=nat definition=path input=path record=myth reader=namespace_reader
  ^ res[axal[myth]]
  > (./some held) record.get(bond/weft) .unknown
  > (./ok fn) (resolve_weft held reader) .unknown
  > (./known tree) (resolve_value .z c input reader) .unknown
  = context record.put(bond/tack (safe c .z input))
  > (./ok arguments) (cell_inputs definition c context reader) .unknown
  > (./ok pair) (apply_cell_ctor fn arguments tree) .unknown
  = [context result] pair
  ? (context.has('/sys/view/fault)) .unknown
  | ./known result

+ h_version_peek
  \ pax=path s=sov
  ^ axal[myth]
  = n    pax.len
    none (axal/new[myth] .none)
  ? (eq n 2)
    | history_marker "below: /len/...path"
  > (./some ln) (dig_of pax.at(2)) none
  = p pax.drop(3)
  ? (lt p.len ln) (h_prefix s.top p s)
  =   rel
    | (p.drop(ln)).map
      \ segment=iota
      ^ iota
      > (./some number) (dig_of segment) segment
      | $u number
  | (h_ver p.take(ln) s).dip rel

+ h_case_peek
  \ cr=care c=nat pax=path s=sov
  ^ axal[myth]
  = n    pax.len
    none (axal/new[myth] .none)
  ? (eq c 0)
    none
  ? (eq n 3)
    | history_marker "below: /len/...path"
  > (./some ln=nat) (dig_of pax.at(3)) none
  = p pax.drop(4)
  ? (lt p.len ln)
    | h_prefix c p s
  = tgt p.take(ln)
    rel p.drop(ln)
  ? (view_value cr c tgt s)
    > (./known fat=axal[myth]) fat.dip(rel)
    > .null none
    > .unknown none

+ h_peek
  '  Time travel: /h/care/case/len/...path resolves (care, case) against
  '  the first len path segments via the sov's historical queries and
  '  dips the remainder into the answer. Structural levels above the
  '  target carry non-enumerating markers because a local case has no
  '  meaning until the target is complete. Committed-only, and constant:
  '  nothing is ever written under /h, so a given /h path's answer never
  '  changes once known — subscriptions here are throwaway.
  \ pax=path s=sov
  ^ axal[myth]
  = none (axal/new[myth] .none)
    n    pax.len
  ? (lt n 2) h_root
  ? (eq_iota pax.at(1) 'v) (h_version_peek pax s)
  > (./some cr) (h_care pax.at(1)) none
  ? (eq n 2) (history_marker help/h_peek)
  ? (dig_of pax.at(2))
    > (./some c) (h_case_peek cr c pax s)
  > (./some _) (epoch_of pax.at(2)) none
  ? (eq n 3) (history_marker "below: /len/...path")
  ? (view_value cr 1 pax s)
    > (./known fat) fat
  none

+ o_peek
  '  Overlay lens: /o/case/olen/...opath/dlen/...dpath applies the
  '  overlay function minted at opath's x case `case` (its /sys/weft
  '  slot) to the data at dpath, and dips any remaining segments into
  '  the answer. The function is pinned by case; the data is live — or
  '  itself derived: dpath may ride /h (pinning the data too) or another
  '  /o (lenses over lenses). All resolution lives in /view; this
  '  wrapper only adds the browsing markers. Read-only: writes under /o
  '  fail the event.
  \ pax=path s=sov
  ^ axal[myth]
  > (./some pr) (o_parse pax)
    | o_marks pax s
  ? (view_value .z 0 pax s)
    > (./known fat=axal[myth]) fat
    > .null (axal/new[myth] .none)
    > .unknown (axal/new[myth] .none)

+ x_peek
  '  View lens: the derived tree for /x/...path. All resolution lives in
  '  /view; this wrapper adds the root marker. Read-only: writes under
  '  /x fail the event.
  \ pax=path s=sov
  ^ axal[myth]
  ? (lt pax.len 2)
    | x_marks pax s
  ? (view_value .z 0 pax s)
    > (./known fat=axal[myth]) fat
    > .null (axal/new[myth] .none)
    > .unknown (axal/new[myth] .none)

+ o_case
  '  The case an overlaid result reports: the ctor's case algebra maps
  '  it back onto the data's own timeline — dyed and knit results
  '  carry dpath's x case, felt and sewn its z case (every node a knit
  '  builds or a sewn moves shares its source's case). Derived data
  '  composes: /h data is constant (case 1), a nested /o recurses into
  '  its own algebra.
  \ pax=path s=sov
  ^ maybe[nat]
  > (./some pr) (o_parse pax)
    .none
  = [c op dp rel] pr
  > (./known wfat) (view_value .x c op s)
    .none
  > (./some wm) wfat.fil
    .none
  > (./some wf) wm.get(bond/weft)
    .none
  ? wf
    > d=dyed (overlay_input_case .x .false dp s)
    > k=knit (overlay_input_case .x .false dp s)
    > f=felt (overlay_input_case .z .false dp s)
    > w=sewn (overlay_input_case .z .false dp s)
    > ck=cell (overlay_input_case .z .true dp s)
    > sp=spun (overlay_input_case .z .true dp s)
    > q=pails/q (overlay_input_case .z .true dp s)
    > ref=safe (overlay_input_case .z .true dp s)
  .none

+ overlay_input_case
  '  Legacy overlays do not follow an /x input's derived case.
  \ cr=care follow_xv=bool input=path s=sov
  ^ maybe[nat]
  ? (is_h input) (./some 1)
  ? (is_o input) (o_case input s)
  ? (and follow_xv (is_xv input)) (xv_case input s)
  ? cr
    > .x s.x_case(input)
    > .y s.y_case(input)
    > .z s.z_case(input)

+ xv_case
  '  The defining datum's own case is the derived result's case. Both
  '  input pins and the constant arguments belong to that datum.
  \ pax=path s=sov
  ^ maybe[nat]
  ? (is_cx pax)
    | _ pax.drop(1) s
  ? (not (is_xv pax))
    .none
  ? (lt pax.len 2)
    .none
  > (./some address) (cell_address 0 pax.drop(1) (store_reader s)) .none
  = [vp relative] address
  ? (is_h vp)
    | ./some 1
  ? (is_o vp)
    | o_case vp s
  ? (is_xv vp)
    | _ vp s
  s.x_case(vp)

+ overlay_data_triggers
  \ dp=path reader=namespace_reader tc=care
  ^ row[dep]
  ? (is_h dp) (h_version_triggers dp)
  ? (is_o dp) (o_trigger_reader dp reader)
  ? (is_xv dp) (xv_trigger_reader dp reader)
  [(dep tc dp)]

+ overlay_value_triggers
  \ wf=pail dp=path reader=namespace_reader
  ^ row[dep]
  ? wf
    > d=dyed (overlay_data_triggers dp reader .x)
    > k=knit (overlay_data_triggers dp reader .x)
    > f=felt (overlay_data_triggers dp reader .z)
    > w=sewn (overlay_data_triggers dp reader .z)
    > ck=cell (overlay_data_triggers dp reader .z)
    > sp=spun (overlay_data_triggers dp reader .z)
    > q=pails/q (overlay_data_triggers dp reader .z)
    > ref=safe (overlay_data_triggers dp reader .z)
  []

+ overlay_reference_triggers
  \ cpin=nat op=path reader=namespace_reader
  ^ row[dep]
  > (./known tree) (resolve_value .x cpin op reader) []
  > (./some record) tree.fil []
  | (live_references record).fold []
    \ out ref=safe
    ? (is_o ref.path) out.weld((o_trigger_reader ref.path reader))
    ? (is_xv ref.path) out.weld((xv_trigger_reader ref.path reader))
    ? (is_h ref.path) out
    | out.snoc (dep ref.care ref.path)

+ o_trigger_reader
  '  The real (care, path) deps that DRIVE a derived path's answer: the
  '  ctor's input care at the innermost real data path, plus the
  '  function's own roots when the overlay path is itself derived (a
  '  pinned case on a real path is immutable and needs no trigger; an
  '  unresolvable pin falls back to watching the overlay path's x, so
  '  the eye wakes when the pin mints). /h legs are constant and
  '  contribute nothing. Firing on these is conservative: a data move
  '  the overlay ignores still wakes the watcher — lazy reactivity
  '  re-arms by reading.
  \ pax=path reader=namespace_reader
  ^ row[dep]
  ? (not (is_o pax))
    []
  > (./some pr) (o_parse pax)
    []
  = [cpin op dp rel] pr
    me               (_)
  =   resolved=maybe[pail]
    ? (resolve_value .x cpin op reader)
      > (./known wfat=axal[myth])
        < wm=myth wfat.fil
        wm.get(bond/weft)
      > .null .none
      > .unknown .none
  =   ftri
    (
      ^ row[dep]
      ? (is_h op)
        | h_version_triggers op
      ? (is_o op)
        | me op reader
      ? ?=((./some _) resolved)
        []
      [(dep .x op)])
  > (./some wf) resolved
    ftri
  = dt    (overlay_value_triggers wf dp reader)
    extra (overlay_reference_triggers cpin op reader)
  | ftri.weld(dt).weld(extra)

+ o_trigger
  '  What an /o read depends on: its definition and the input it is
  '  applied to.
  \ pax=path s=sov
  ^ row[dep]
  | o_trigger_reader pax (store_page_reader s)

+ xv_trigger_reader
  '  Only changes to the defining datum change the derived result.
  '  Updating an input pin is an ordinary write to that datum.
  \ pax=path reader=namespace_reader
  ^ row[dep]
  ? (is_cx pax)
    | _ pax.drop(1) reader
  ? (not (is_xv pax))
    []
  ? (lt pax.len 2)
    []
  > (./some address) (cell_address 0 pax.drop(1) reader) []
  = [vp relative] address
  ? (is_h vp)
    | h_version_triggers vp
  ? (is_o vp)
    | o_trigger_reader vp reader
  ? (is_xv vp)
    | _ vp reader
  = own [(dep .x vp)]
  > (./known fat) (resolve_value .x 0 vp reader) own
  > (./some record) fat.fil own
  '  A woven cell's triggers are what it read: it is run here,
  '  fuel-bound, only for a cell a crew watches (the lens projects
  '  watched deps), so a watcher wakes when a reverse edge or a dynamic
  '  input moves.
  ? (woven_start record .z relative reader)
    > (./some plan)
      | woven_triggers (woven_evaluate 0 vp .z relative reader)
  | (live_references record).fold own
    \ acc pin=safe
    ? (tack_cycle vp pin.path reader) acc
    ? (is_xv pin.path) acc.weld((xv_trigger_reader pin.path reader))
    | acc.snoc((dep pin.care pin.path))

+ xv_trigger
  '  What an /x read depends on: the cell, its definition, and the
  '  inputs it observed.
  \ pax=path s=sov
  ^ row[dep]
  | xv_trigger_reader pax (store_page_reader s)

'  --- in-flight & sovereign reads ---
'  Committed and in-flight reads compose stored and virtual views.
'  Pending writes are interpreted here, never accumulated or committed.

+ peek
  ' Committed browsing keeps assertions even below transparent paths.
  \ pax=path s=sov
  ^ axal[saga]
  ? (is_h pax)
    > (./some _) (h_parse pax)
      | saga/computed (computed_case 0 pax (store_reader s))
        | h_peek pax s
    ? (view .z 0 pax s)
      > (./known tree) tree
    | axal/new[saga] .none
  ? (is_o pax)
    | saga/computed (computed_case 0 pax (store_reader s))
      | o_peek pax s
  ? (or (is_xv pax) (is_cx pax))
    | saga/computed (computed_case 0 pax (store_reader s))
      | x_peek pax s
  ? (is_r pax)
    ? (view .z 0 pax s)
      > (./known tree) tree
    | axal/new[saga] .none
  | namespace/records s.top pax s

+ peek_value
  '  The committed perspective: the subtree at pax as of s.top, piths
  '  relative to pax, no version metadata. Reads the index directly (sov
  '  z_query is unknown unless pax itself is a node, which would blind
  '  in-flight reads under nodes made this event). /h and /o paths
  '  divert to their overlays.
  \ pax=path s=sov
  ^ axal[myth]
  | saga/values (peek pax s)

+ muck
  '  Overlay a pending-note subtree onto a committed subtree (both
  '  relative): make replaces, poke melds (or stands alone), cull
  '  deletes the value.
  \ base=axal[myth] pend=axal[note]
  ^ axal[myth]
  | pend.tap.fold base
    \ acc [p q]
    ? q
      > (./make t) acc.put(p t)
      > (./poke t)
        > (./some cur) acc.get(p) acc.put(p t)
        | acc.put p cur.meld(t)
      > .cull acc.del(p)

+ read
  '  The in-flight perspective: committed state overlaid with the
  '  transaction's pending writes, care-filtered, metadata-free.
  \ c=care pax=path wm=worm s=sov
  ^ axal[myth]
  = com  (peek_value pax s)
    tl   wm.toil
    pend tl.dip(pax)
    wet  (muck com pend)
  | sorge[myth] c wet

+ sovereign_peek
  \ pax=path state=namespace
  ^ axal[saga]
  = structural (sovereign_history_prefix pax)
  ? structural.wyt (saga/computed 1 structural)
  ? (is_virtual pax)
    ? (sovereign_view .z 0 pax state)
      > (./known tree) tree
    | axal/new[saga] .none
  ? (eq pax.len 0) (state.root(.z))
  > (./some history) state.history(pax) (axal/new[saga] .none)
  | peek pax history

+ sovereign_care
  ' Exact physical reads avoid materializing discarded descendants.
  \ c=care pax=path state=namespace
  ^ axal[saga]
  ? (eq pax.len 0) (state.root(c))
  ? ?=(.x c)
    > (./some history) state.history(pax)
      | sorge[saga] c (sovereign_peek pax state)
    | axal/new[saga]
      | ass/saga history.top (history.hist(pax))
  | sorge[saga] c (sovereign_peek pax state)

+ sovereign_peek_value
  \ pax=path state=namespace
  ^ axal[myth]
  | saga/values (sovereign_peek pax state)

+ sovereign_care_value
  \ c=care pax=path state=namespace
  ^ axal[myth]
  | saga/values (sovereign_care c pax state)

+ sovereign_read
  '  Pending changes affect permitted local operands only. Derived reads
  '  and the composed root always use the committed namespace.
  \ c=care pax=path wm=worm state=namespace
  ^ axal[myth]
  ? (not (state.permitted(pax)))
    | sovereign_care_value c pax state
  '  Exact local reads need only this record's pending note. Descendant
  '  notes cannot change its value, even when its history advances.
  ? ?=(.x c)
    | axal/new[myth] (read_x pax wm state.local)
  = committed | sovereign_peek_value pax state
  =   pending
    | wm.toil.dip(pax).tap.fold (axal/new[note] .none)
      \ out [relative change]
      ? (not (state.permitted(pax.weld(relative)))) out
      | out.put relative change
  | sorge[myth] c (muck committed pending)

+ sovereign_crew_of
  \ mt=maybe[myth] state=namespace
  ^ mop[path axal[saga] lt_pith]
  > (./some record) mt (mop/empty)
  > (./some held) record.get(crew_slot) (mop/empty)
  > dependencies=crew/pail held (mop/empty)
  | dependencies.crew.tap.fold (mop/empty)
    \ out entry
    | out.put entry.key
      | sovereign_care entry.val.c entry.val.p state

+ crew_of
  '  Hydrate each named dependency from committed state. Missing
  '  records, missing crew slots, and foreign slot values have no crew.
  \ mt=maybe[myth] wm=worm s=sov
  ^ mop[path axal[saga] lt_pith]
  > (./some t) mt
    (mop/empty)
  > (./some held) t.get(crew_slot)
    (mop/empty)
  > deps=crew/pail held
    (mop/empty)
  | deps.crew.tap.fold (mop/empty)
  \ acc e
  | acc.put e.key
  | sorge[saga] e.val.c (peek e.val.p s)

+ read_x
  '  Exact-path in-flight read (the dispatch hot path). /h, /o and /x
  '  paths answer from their overlays (committed-only; nothing pends
  '  there).
  \ pax=path wm=worm s=sov
  ^ maybe[myth]
  ? (is_h pax)
    = hv (h_peek pax s)
    hv.fil
  ? (is_o pax)
    = ov (o_peek pax s)
    ov.fil
  ? (or (is_xv pax) (is_cx pax))
    = xv (x_peek pax s)
    xv.fil
  =   com=maybe[myth]
    ? s.x_latest(pax)
      > (./known t=myth) (./some t)
      > .null .none
      > .unknown .none
  = tl wm.toil
  > (./some w=note) tl.get(pax) com
  ? w
    > (./make t=myth) (./some t)
    > (./poke t=myth)
      > (./some cur=myth) com (./some t)
      = m cur.meld(t)
      | ./some m
    > .cull .none

+ exists
  \ pax=path wm=worm s=sov
  ^ bool
  > (./some t=myth) (read_x pax wm s) .false
  .true

+ x_query_h
  '  Exact committed read, /h-aware: the overlay answers /h paths (the
  '  case rides in the path, so c is ignored there); the sov answers
  '  everything else.
  \ c=nat pax=path s=sov
  ^ res[myth]
  ? (is_h pax)
    = hv (h_peek pax s)
    > (./some t=myth) hv.fil .unknown
    | ./known t
  ? (is_o pax) (res_root (view_value .x c pax s))
  ? (or (is_xv pax) (is_cx pax)) (res_root (view_value .x c pax s))
  s.x_at(c pax)

+ x_case_h
  '  Version query, /h-aware. /h nodes are constant: case 1 whenever
  '  they resolve — nothing is ever written under /h, so subscriptions
  '  there never fire and prespecified-case deps are throwaway.
  \ c=nat pax=path s=sov
  ^ maybe[nat]
  ? (is_h pax)
    = hv (h_peek pax s)
    < t=myth hv.fil
    | ./some 1
  ? (is_o pax)
    = ov (o_peek pax s)
    < t=myth ov.fil
    > (./some oc=nat) (o_case pax s)
      | ./some 1
    | ./some oc
  ? (or (is_xv pax) (is_cx pax))
    = xv (x_peek pax s)
    < t=myth xv.fil
    > (./some xc=nat) (xv_case pax s)
      | ./some 1
    | ./some xc
  s.x_case(pax)

'  --- dispatch, validation & reactions ---
'  Follow a local write from sovereign_run_event. A task/vine names a
'  target and a writ. sovereign_kernel checks the target and any case
'  precondition, then runs the forms until their work is exhausted or
'  fails. The resulting fate holds proposed notes and outbound moves.
'  guard_diffs checks the expanded changes against the local store.
'
'  namespace/step checks ownership and calls sov/step to find the
'  effective changes. A no-op returns the original state. For a change
'  it runs the step with the journal record included: the new state and
'  its audit entry share an epoch. A rejected event returns neither the
'  candidate state nor its effects. See tests/namespace_dispatch.foil.
'
'  Reactions have a different boundary. sovereign_cycle uses
'  committed signs to find subscribers and starts a hear event for the
'  next round. A later round can fail or run out of fuel; the returned
'  spill reports why the cycle stopped, alongside the state reached so
'  far.

+ note_mode
  \ w=note
  ^ mode
  ? w
    > (./make t=myth) .add
    > (./poke t=myth) .dif
    > .cull .del

+ mode_then
  '  Compose a later change kind onto an earlier one at the same path.
  \ old=maybe[mode] new=mode
  ^ mode
  > (./some m=mode) old new
  ? m
    > .add
      ? new
        > .del .del
        > .add .add
        > .dif .add
    > .del
      ? new
        > .add .add
        > .del .del
        > .dif .del
    > .dif new

+ note_then
  '  Compose a later note onto a pending one at the same path, so the
  '  transaction holds at most one note per path.
  \ old=maybe[note] new=note
  ^ note
  > (./some ow=note) old new
  ? new
    > (./make t=myth) new
    > .cull new
    > (./poke t=myth)
      ? ow
        > (./make ot=myth)
          = m ot.meld(t)
          | ./make m
        > (./poke ot=myth)
          = m ot.meld(t)
          | ./poke m
        > .cull (./make t)

+ dispatch_reader
  '  Transaction reads and write authority travel together through
  '  dispatch.
  : exact={\ path worm}maybe[myth]
    children={\ care path worm}axal[myth]
    hydrate={\ maybe[myth] worm}mop[path axal[saga] lt_pith]
    permit={\ path}bool

+ sovereign_access
  \ state=namespace
  ^ dispatch_reader
  | dispatch_reader
    (
      \ target transaction
        (sovereign_read .x target transaction state).fil)
    (
      \ car target transaction
        | sovereign_read car target transaction state)
    (\ record transaction (sovereign_crew_of record state))
    (\ target state.permitted(target))

+ resolve_access
  '  Resolve a myth's kook slot against the NAMESPACE: each ref is a
  '  path read directly — its node's system_vocabulary/form slot holds
  '  the form (forms are nominal rows, so they ride as pails). The
  '  registry is namespace state — making or poking a form node
  '  installs and upgrades behaviors live, at any path, and resolution
  '  sees this event's in-flight writes. The behavior list defaults when
  '  the kook slot is absent or empty; anything non-kook in the slot, or
  '  non-form at a ref, fails.
  \ t=myth wm=worm access=dispatch_reader
  ^ either[iota row[form]]
  = exact access.exact
  > (./some held) t.get(limb_slot) (./ok [def_form])
  '  A wing runs at commit; its declaration has ordinary behavior.
  ? held
    > declaration=wing (./ok [def_form])
  > k=kook held (./err 'kook_bad)
  = refs k.refs
  ? (eq refs.len 0) (./ok [def_form])
  % i=nat 0 acc=row[form] []
  ^ either[iota row[form]]
  ? (eq i refs.len) (./ok acc)
  > (./some kt) (exact refs.at(i) wm) (./err 'kook_unknown)
  > (./some fp) kt.get(system_vocabulary/form)
    | ./err 'kook_unknown
  > f=form fp (./err 'kook_bad)
  | _ i.inc acc.snoc(f)

+ record
  '  Compose a resolved note into the transaction: one note per path,
  '  prize the composed change kind.
  \ pax=path w=note wm=worm
  ^ worm
  = tl  wm.toil
    w2  (note_then tl.get(pax) w)
    pz  wm.prize
    m2  (mode_then pz.get(pax) (note_mode w))
    wm1 wm.set_toil(tl.put(pax w2))
  wm1.set_prize(pz.put(pax m2))

+ ingest
  '  Route one activation's cards from node src: same-authority targets
  '  join this transaction's queue; everything else leaves as an
  '  outbound move carrying the one command.
  \ src=path cs=row[[p=path q=writ]] wm=worm
  ^ worm
  | cs.fold wm
    \ acc [p q]
    =   local
      (
        ? (pith_prefix src p) .true
        ? (and (gt src.len 0) (gt p.len 0))
          | eq_iota src.at(0) p.at(0)
        .false)
    ? local
      | acc.set_down acc.down.snoc((flue src p (./vine q)))
    | acc.set_up acc.up.snoc((move src p q))

+ thread_forms
  '  Run a behavior chain in order. Each arm sees the preceding arm's
  '  state; cards retain the order in which the arms emitted them.
  \ fs=row[form] cur=myth apply={\ form myth}yell
  ^ [cards=row[[p=path q=writ]] out=myth]
  =   done
    (
      | fs.fold (yell [] cur)
      \ acc f
      = next | apply f acc.out
      | yell acc.cards.weld(next.cards) next.out)
  [done.cards done.out]

+ thread_init
  '  Initialize through the complete behavior chain.
  \ b=bowl fs=row[form] cur=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = init f.init
  | init b state

+ thread_talk
  '  The input stays fixed while the current record moves through talk.
  \ b=bowl fs=row[form] cur=myth add=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = talk f.talk
  | talk b state add

+ thread_take
  \ b=bowl fs=row[form] cur=myth gift=axal[mode]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = take f.take
  | take b state gift

+ thread_hear
  \ b=bowl fs=row[form] cur=myth rely=row[dep]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = hear f.hear
  | hear b state rely

+ initialize_access
  '  A make or resolved warp follows one initialization path. Resolve
  '  the replacement's behaviors, thread init, then record and ingest.
  \ b=bowl t=myth wm=worm access=dispatch_reader
  ^ either[iota worm]
  > (./some _) t.get(limb_slot) (./ok (record b.here (./make t) wm))
  < fs=row[form] (resolve_access t wm access)
  = [cards out] (thread_init b fs t)
    next        (record b.here (./make out) wm)
  | ./ok (ingest b.here cards next)

+ dispatch_take
  \ b=bowl dst=path wm1=worm access=dispatch_reader
    g=axal[mode]
  ^ either[iota worm]
  = exact access.exact
  > (./some cur) (exact dst wm1) (./err 'take_missing)
  '  An absent kook slot resolves to [def_form]; def_take emits no cards
  '  and keeps cur (the seeding/cascade hot path). A no-op take records
  '  an empty poke: melding nothing leaves local cases unchanged, just
  '  like a cur-verbatim poke, while the raw journal stores only the
  '  empty delta rather than the whole record.
  > (./some _) cur.get(limb_slot)
    | ./ok (record dst (./poke myth/new) wm1)
  < fs (resolve_access cur wm1 access)
  = [cards out] (thread_take b fs cur g)
  =   wm2
    (
      ? (equal out cur) (record dst (./poke myth/new) wm1)
      | record dst (./poke out) wm1)
  | ./ok (ingest dst cards wm2)

+ dispatch_hear
  \ b=bowl dst=path wm1=worm access=dispatch_reader
    rr=row[dep]
  ^ either[iota worm]
  = exact access.exact
  > (./some cur=myth) (exact dst wm1) (./err 'hear_missing)
  < fs=row[form] (resolve_access cur wm1 access)
  = [cards out] (thread_hear b fs cur rr)
    wm2         (record dst (./poke out) wm1)
  | ./ok (ingest dst cards wm2)

+ dispatch_warp
  \ b=bowl dst=path wm1=worm access=dispatch_reader
    op=path input=myth
  ^ either[iota worm]
  = exact access.exact
  '  poke-with-an-overlay: resolve the op card, apply (fn input cur) —
  '  a MISSING dst applies against the empty record
  '  (make-with-overlay-if-absent) — and process the result exactly
  '  like a make: a kook-less result records verbatim as a REPLACE;
  '  /initialize resolves a kooked result, threads init, and ingests its
  '  cards in this event. The input never lands in the namespace; the
  '  gate judges the final record like any write.
  = cur0 (exact dst wm1).fall(myth/new)
  > (./some definition) (exact op wm1) (./err 'warp_op_unknown)
  > (./some held) definition.get(system_vocabulary/op)
    | ./err 'warp_op_bad
  > overlay=op held (./err 'warp_op_bad)
  = apply overlay.fn
  | initialize_access b (apply input cur0) wm1 access

+ dispatch_poke
  \ b=bowl dst=path wm1=worm access=dispatch_reader
    t=myth
  ^ either[iota worm]
  = exact access.exact
  > (./some cur=myth) (exact dst wm1) (./err 'poke_missing)
  = u cur.meld(t)
  '  def_talk is the same meld: a kook-less poke records u without
  '  resolving or invoking behaviors.
  > (./some _) u.get(limb_slot) (./ok (record dst (./poke u) wm1))
  < fs=row[form] (resolve_access u wm1 access)
  = [cards out] (thread_talk b fs cur t)
    wm2         (record dst (./poke out) wm1)
  | ./ok (ingest dst cards wm2)

+ dispatch_access
  '  Run one work unit against the transaction. The /h and /o overlays
  '  are read-only, and /log is commit-owned: any write landing on any
  '  of them fails the whole event.
  \ f=flue wm=worm access=dispatch_reader
  ^ either[iota worm]
  = exact    access.exact
    children access.children
    hydrate  access.hydrate
  = permit access.permit
  ? (not (permit f.dst))
    | ./err 'write_outside_authority
  ? (reserved_virtual_err f.dst)
    > (./some why) (./err why)
  = wm1 wm.set_now(wm.now.inc)
    kk  (children .y f.dst wm1)
    cw  (hydrate (exact f.dst wm1) wm1)
    b   (bowl f.src f.dst wm1.now wm1.eny kk cw)
    dst f.dst
  ? f.job
    > (./take g=axal[mode])
      | dispatch_take b dst wm1 access g
    > (./hear rr=row[dep])
      | dispatch_hear b dst wm1 access rr
    > (./vine w=writ)
      ? w
        > .cull
          | ./ok (record dst .cull wm1)
        > (./warp op=path input=myth)
          | dispatch_warp b dst wm1 access op input
        > (./make t=myth)
          | initialize_access b t wm1 access
        > (./poke t=myth)
          | dispatch_poke b dst wm1 access t

+ gift_parent
  \ p=path wm=worm access=dispatch_reader
  ^ maybe[path]
  = exact access.exact
  % k=nat p.len.dec
  ^ maybe[path]
  ? (eq k 0)
    .none
  = pre p.take(k)
  ? (maybe/is_some (exact pre wm))
    | ./some pre
  | _ k.dec

+ raid_access
  '  The gift cascade. Each prized path is grouped under its nearest
  '  existing strict ancestor (existence is the in-flight view; the root
  '  contributes nothing), and one take per parent joins the queue,
  '  carrying the changed paths relative to that parent. Take results
  '  are poke writes, so the prize repopulates strictly upward until it
  '  drains at the top.
  \ wm=worm access=dispatch_reader
  ^ worm
  =   gam
    | wm.prize.tap.fold (axal/new[axal[mode]] .none)
      \ acc [p q]
      ? (le p.len 1) acc
      > (./some parent) (gift_parent p wm access) acc
      = gifts acc.gut(parent (axal/new[mode] .none))
      | acc.put parent gifts.put(p.drop(parent.len) q)
  =   down
    | gam.tap.fold wm.down
      \ queue [p q]
      | queue.snoc (flue p p (./take q))
  | wm.set_down(down).set_prize (axal/new[mode] .none)

+ vine_flue
  '  One command becomes one work unit rooted at /out.
  \ p=path w=writ
  ^ flue
  | flue '/out p (./vine w)

+ invert
  '  Turn news (changed path -> cared subscribers) into subscriber ->
  '  cared changed paths. Dispatch validates each subscriber's
  '  authority.
  \ news=axal[row[dep]]
  ^ axal[row[dep]]
  | news.tap.fold (axal/new[row[dep]] .none)
    \ acc [changed subscribers]
    | subscribers.fold acc
      \ out subscriber
      = prior out.gut(subscriber.p [])
      | out.put subscriber.p prior.snoc((dep subscriber.c changed))

+ hear_flues
  \ subs=axal[row[dep]]
  ^ row[flue]
  | subs.tap.map
    \ [p q]
    | flue p p (./hear q)

+ grind_with_access
  '  The worm loop: pop and dispatch until the queue drains; a nonempty
  '  prize then raids and the loop resumes; when both are empty the fate
  '  seals — writes in tap (lte_pith) order, effects as accumulated,
  '  the ack riding through. Vine events ack the command's path; hear
  '  events ack .none.
  \ fuel=nat dn=row[flue] ack=maybe[path] eny=nat access=dispatch_reader
  ^ either[iota [fate=fate ack=maybe[path]]]
  =   w0
    | worm (axal/new[note] .none) dn 0 [] (axal/new[mode] .none) 0 eny
  % st=either[iota worm] (./ok w0) gas=nat fuel
  ^ either[iota [fate=fate ack=maybe[path]]]
  < wm=worm st
  ? (lt wm.dcur wm.down.len)
    ? (eq 0 gas)
      | ./err 'grind_exhausted
    = f   wm.down.at(wm.dcur)
      wm1 wm.set_dcur(wm.dcur.inc)
    | _ (dispatch_access f wm1 access) gas.dec
  ? wm.prize.wyt
    ? (eq 0 gas)
      | ./err 'grind_exhausted
    | _ (./ok (raid_access wm access)) gas.dec
  = tl wm.toil
  | ./ok [(fate tl.tap wm.up) ack]

+ brand_of
  '  The runtime nominal brand as text. Reflection is confined to this
  '  boundary; nullary values are their own brand atoms.
  \ held=any
  ^ str
  =   brand
    (
      ? (rep_app held) (rep_hd held)
      | add held 0)
  ^ str brand

+ curb_ok
  '  A contract admits only the defining moment it names.
  \ cb=curb held=pail
  ^ bool
  | cb.any
    \ reference=flaw
    | reference.matches held

+ lash_of
  '  The node's own shape contract, when its record carries one at
  '  system_vocabulary/lash — enforcement is opt-in per node, and the
  '  contract is ordinary namespace state like everything else.
  \ t=myth
  ^ maybe[lash]
  < held t.get(system_vocabulary/lash)
  > contract=lash held .none
  | ./some contract

+ fit_check
  '  One record judged against its own contract as stored: every present
  '  slot through the write curbs, every need group against the record
  '  — the standing-query predicate for finding legacy data a
  '  later-adopted contract disowns.
  \ t=myth
  ^ maybe[iota]
  < contract (lash_of t)
  =   bad_type
    | t.tap.any
      \ entry
      > (./some curb) contract.write.get(entry.key) .false
      | not (curb_ok curb entry.val)
  ? bad_type (./some 'curb_type)
  =   complete
    | contract.need.all
      \ group
      | group.any (\ slot (myth/has_at slot t))
  ? complete .none
  | ./some 'curb_need

+ contract_adopted
  \ final=myth cur=maybe[myth]
  ^ bool
  > (./some nl=pail) final.get(system_vocabulary/lash) .false
  > (./some old) cur
    .true
  > (./some ol=pail) old.get(system_vocabulary/lash) .true
  | not (equal nl ol)

+ guard_diffs
  '  Check normalized effective notes. Unchanged records need no check.
  '  Changing the contract itself adopts it over legacy data; other live
  '  changes must satisfy the final record's stored contract.
  \ diffs=axal[note] s=sov
  ^ maybe[iota]
  = es diffs.tap
  % i=nat 0
  ^ maybe[iota]
  ? (ge i es.len)
    .none
  = [p q] es.at(i)
  ? ?=(.cull q)
    | _ i.inc
  =   before=res[pin[myth]]
    ? s.x_latest(p)
      > (./known t=myth) (./known (pin t))
      > .null .null
      > .unknown .unknown
  > (./known held) (note/write before q)
    | _ i.inc
  = final (unpin held)
  =   cur=maybe[myth]
    ? before
      > (./known old) (./some (unpin old))
      > .null .none
      > .unknown .none
  = unchanged (cur.run((\ old (equal old final)))).fall(.false)
  ? unchanged
    | _ i.inc
  = adopt (contract_adopted final cur)
  ? adopt
    | _ i.inc
  > (./some why=iota) (fit_check final) (_ i.inc)
  | ./some why

+ if_case_slot
  '  The precondition a make or a poke may carry: /sys/if_case, the x
  '  case the writer read. The kernel checks it against the record's
  '  case now, in the same turn as the commit, strips it, and refuses
  '  the whole event as 'stale_case when any record moved; it never
  '  lands in a record.
  ^ path
  '/sys/if_case

+ precondition
  '  One write with its precondition judged and stripped, or why not.
  \ target=path change=writ state=namespace
  ^ either[iota writ]
  = key if_case_slot
  =   judged
    (
      ^ {\ myth}either[iota myth]
      \ m=myth
      ^ either[iota myth]
      > (./some held) m.get(key) (./ok m)
      ? held
        > n=pails/n
          = now (state.local.x_case(target)).fall(0)
          ? (eq now n.n) (./ok m.del(key))
          | ./err 'stale_case
        | ./err 'if_case_not_a_number)
  ? change
    > (./make m)
      < m2 (judged m)
      | ./ok (writ/make m2)
    > (./poke m)
      < m2 (judged m)
      | ./ok (writ/poke m2)
    | ./ok change

+ preconditions
  '  Every write of a batch judged; the first stale one refuses them
  '  all.
  \ writes=row[[path writ]] state=namespace
  ^ either[iota row[[path writ]]]
  = none=row[[path writ]] []
  % i=nat 0 out=row[[path writ]] none
  ^ either[iota row[[path writ]]]
  ? (eq i writes.len) (./ok out)
  = [target change] writes.at(i)
  < sure (precondition target change state)
  | _ i.inc out.snoc([target sure])

+ sovereign_kernel
  '  Prepare the notes and moves for one event. A vine acknowledges its
  '  target, vines the first target, and hear has no acknowledgement.
  '  sovereign_run_event checks and commits the result.
  \ command=task entropy=nat state=namespace
  ^ either[iota [fate=fate ack=maybe[path]]]
  = access | sovereign_access state
  ? command
    > (./vine target change)
      ? (not (state.permitted(target))) (./err 'write_outside_authority)
      < sure (precondition target change state)
      | grind_with_access 4096 [(vine_flue target sure)]
        (./some target) entropy access
    > (./vines writes)
      ? (eq writes.len 0) (./err 'vines_empty)
      ? (not (writes.all((\ [target change] state.permitted(target)))))
        | ./err 'write_outside_authority
      < sure (preconditions writes state)
      = [first change] sure.at(0)
      | grind_with_access 4096
        sure.map((\ [target change] (vine_flue target change)))
        (./some first) entropy access
    > (./hear news)
      = subscribers | invert news
      ? (eq subscribers.wyt 0) (./err 'hear_no_subs)
      | grind_with_access 4096 (hear_flues subscribers) .none entropy
        access

+ sovereign_event
  & sovereign_event/ripe sovereign_event/fail
  + ripe
    : state=namespace effects=row[move] signs=axal[sign] ack=maybe[path]

  + fail
    : why=iota

+ sovereign_run_event
  '  Ownership gates dispatch and all final diffs. Failed events expose
  '  neither writes nor effects. The namespace commit journals its
  '  system pin.
  \ command=task entropy=nat now=nat block=nat state=namespace
  ^ sovereign_event
  ? (sovereign_kernel command entropy state)
    > (./err why) (./fail why)
    > (./ok outcome=[result=fate ack=maybe[path]])
      = [result ack] outcome
      = diffs | axal/gas[note] result.write (axal/new[note] .none)
      =   owned
        | diffs.tap.all (\ [target change] state.permitted(target))
      ? (not owned)
        | ./fail 'write_outside_authority
      = effective | gate/prepare diffs state.local.top state.local.idx
      =   permitted
        | effective.tap.all
          \ [target change] state.permitted(target)
      ? (not permitted)
        | ./fail 'write_outside_authority
      ? (guard_diffs effective state.local)
        > (./some why) (./fail why)
      ? (namespace/step diffs now block state)
        > (./err why) (./fail why)
        > (./ok committed)
          | ./ripe committed.state result.effects committed.signs ack

+ fires
  '  The grade a sign gives one care: nonzero means that care's
  '  perspective of the path moved.
  \ c=care g=sign
  ^ nat
  ? c
    > .x g.x
    > .y g.y
    > .z g.z

+ partition_watchers
  \ grade=sign watchers=row[dep]
  ^ [hot=row[dep] cool=row[dep]]
  = seed=[hot=row[dep] cool=row[dep]] [[] []]
  | watchers.fold seed
    \ [hot cool] watcher
    ? (fires watcher.c grade) [hot.snoc(watcher) cool]
    [hot cool.snoc(watcher)]

+ react
  '  The reactivity machine: match one event's change signs against the
  '  watcher index. A watcher fires when its care's grade at its watched
  '  path is nonzero; fired subscriptions are consumed (lazy reactivity:
  '  one notification, watchers re-arm by reading) and unfired ones
  '  survive. Returns the kernel's news — feed it back as a (./hear
  '  news) task — and the updated index. The driver's cycle is
  '  run_event -> react on the ripe signs -> hear.
  \ signs=axal[sign] ey=eyes
  ^ [news=axal[row[dep]] rest=eyes]
  =   seed=[news=axal[row[dep]] rest=eyes]
    [(axal/new[row[dep]] .none) (axal/new[row[dep]] .none)]
  | ey.tap.fold seed
    \ [news rest] [watched watchers]
    > (./some grade) signs.get(watched)
      [news rest.put(watched watchers)]
    = [hot cool] (partition_watchers grade watchers)
    [
      (? hot.len news.put(watched hot) news)
      (? cool.len rest.put(watched cool) rest)]

+ node_deps
  '  Dependencies declared by a record. Namespace policy filters the
  '  local journal and driver facilities when constructing its indexes.
  \ t=myth
  ^ row[dep]
  > (./some held) t.get(crew_slot) []
  > deps=crew/pail held []
  | deps.crew.tap.map
    \ entry entry.val

+ sovereign_observer
  \ target=path state=namespace
  ^ bool
  ? (not (state.permitted(target))) .false
  | not (pith_prefix [state.self 'io] target)

+ sovereign_dependencies
  \ record=myth state=namespace
  ^ row[dep]
  | (node_deps record).filter
    \ dependency
    | not (pith_prefix [state.self 'log] dependency.p)

+ sovereign_hive
  '  The crew index derived from every record: the reference the
  '  kernel's dependency index (/<self>/idx/deps) must transpose to.
  '  Reactions no longer use it; it walks the whole namespace.
  \ state=namespace
  ^ hive
  | (sovereign_peek_value [state.self] state).tap.fold
    | axal/new[row[dep]] .none
    \ index [relative record]
    = target | row/weld relative [state.self]
    ? (not (sovereign_observer target state)) index
    = dependencies | sovereign_dependencies record state
    ? (eq dependencies.len 0) index
    | index.put target dependencies

+ sovereign_watched
  '  The watchers filed under one watched path in the kernel's
  '  dependency index, each with the care it watches at, in watcher
  '  order.
  \ watched=path state=namespace
  ^ row[dep]
  = home (idx/deps/home state.self)
  > (./some record)
    | idx/record_at home.weld((idx/slot watched)) state.local
    []
  | record.tap.fold []
    \ out entry
    > sub=crew/pail entry.val out
    | sub.crew.tap.fold out
      \ acc held
      | acc.snoc (dep held.val.c entry.key)

+ sovereign_watchers
  '  The whole watcher index (watched path -> cared watchers), read from
  '  the kernel's dependency index rather than derived from every
  '  record.
  \ state=namespace
  ^ eyes
  = home (idx/deps/home state.self)
  = records (sovereign_peek_value home state)
  | records.tap.fold (axal/new[row[dep]] .none)
    \ out [relative record]
    ? (eq relative.len 0) out
    = watched | relative.drop 1
    | out.put watched (sovereign_watched watched state)

+ sovereign_react
  '  One round's news from the dependency index: each signed path's
  '  watchers whose care saw it move.
  \ signs=axal[sign] state=namespace
  ^ axal[row[dep]]
  | signs.tap.fold (axal/new[row[dep]] .none)
    \ out [watched grade]
    =   hot
      | (sovereign_watched watched state).filter
        \ watcher
        | gt (fires watcher.c grade) 0
    ? (eq hot.len 0) out
    | out.put watched hot

+ sovereign_derived
  '  The derived (/h, /o, /x) dependencies in the index, turned back
  '  into crew-index orientation (watcher -> deps) for lens translation.
  '  Only those three subtrees of each length group are read.
  \ state=namespace
  ^ hive
  = home       (idx/deps/home state.self)
    groups     | (state.local.idx.dip(home)).kid_keys
    roots=path '/h/o/x
  | groups.fold (axal/new[row[dep]] .none)
    \ out group
    | roots.fold out
      \ acc root
      = base=path [group root]
      | (sovereign_peek_value home.weld(base) state).tap.fold acc
        \ acc2 [relative record]
        = watched | row/weld relative [root]
        | (sovereign_watched watched state).fold acc2
          \ acc3 watcher
          | acc3.put watcher.p
            (acc3.gut(watcher.p []).snoc((dep watcher.c watched)))

+ eyes_from
  '  Turn the crew index around into the watcher index: each dep a node
  '  watches subscribes that node, as watcher, to the watched path.
  '  Subscribers arrive in tap order, so the rows come out in the same
  '  order the full derivation built them.
  \ hv=hive
  ^ eyes
  | hv.tap.fold (axal/new[row[dep]] .none)
    \ acc [subscriber dependencies]
    | dependencies.fold acc
      \ out dependency
      = prior out.gut(dependency.p [])
      | out.put dependency.p
        | prior.snoc (dep dependency.c subscriber)

+ derived_triggers
  '  Direct mode retains real subscriptions for clock reconciliation;
  '  lens mode expands reverse reads and leaves real paths to /eyes.
  \ d=dep reader=namespace_reader direct=bool
  ^ row[dep]
  ? (is_r d.p)
    ? direct [d]
    | reverse_triggers d.p
  ? (is_h_version d.p)
    | h_version_triggers d.p
  ? (is_o d.p)
    | o_trigger_reader d.p reader
  ? (is_xv d.p)
    | xv_trigger_reader d.p reader
  ? (and direct (not (is_h d.p))) [d]
  []

+ lens_from_reader
  '  Project the derived (/o) deps out of the crew index, translated
  '  down to their real triggers (/o_trigger). Real deps stay in /eyes;
  '  derived keys registered there never sign and stay cool forever.
  '  Re-projected per round like /eyes_from, so translations heal as
  '  overlays and pins evolve.
  \ hv=hive reader=namespace_reader
  ^ lens
  | hv.tap.fold (axal/new[row[[tc=care od=dep w=path]]] .none)
    \ acc [subscriber dependencies]
    | dependencies.fold acc
      \ out dependency
      | (derived_triggers dependency reader .false).fold out
        \ indexed trigger
        = prior indexed.gut(trigger.p [])
        | indexed.put trigger.p
          | prior.snoc [trigger.c dependency subscriber]

+ react_lens
  '  Match one round's signs against the derived-watcher index: a lens
  '  eye fires when its trigger care's grade at its trigger path moved.
  '  News comes out keyed by the DERIVED path with the subscriber's
  '  stated care; duplicate fires for one (dep, watcher) — a derived
  '  dep can own several triggers — collapse.
  \ signs=axal[sign] lz=lens
  ^ axal[row[dep]]
  | lz.tap.fold (axal/new[row[dep]] .none)
    \ news [watched subscribers]
    > (./some grade) signs.get(watched) news
    | subscribers.fold news
      \ out [care original watcher]
      ? (not (fires care grade)) out
      = prior out.gut(original.p [])
        next  (dep original.c watcher)
      ? prior.any((\ existing (equal existing next))) out
      | out.put original.p prior.snoc(next)

+ sovereign_gyre
  & sovereign_gyre/spun sovereign_gyre/fail
  + spun
    : state=namespace moves=row[move] rounds=row[axal[sign]]
      ack=maybe[path]
      spill=maybe[iota]

  + fail
    : why=iota

+ sovereign_cycle
  '  Run one event and its reaction rounds. Each round's news comes from
  '  the kernel's dependency index, which the commit keeps current in
  '  the same epoch as the crews it files, so no watcher index is
  '  derived or carried between events. A failed event commits nothing.
  \ t=task eny=nat fuel=nat now=nat block=nat s=namespace
  ^ sovereign_gyre
  ? (sovereign_run_event t eny now block s)
    > (./fail e=iota) (./fail e)
    > (./ripe s1=namespace fx1=row[move] sg1=axal[sign] a=maybe[path])
      % cur=namespace s1
        prev=namespace s
        moves=row[move] fx1
        rounds=row[axal[sign]] [sg1]
        sg=axal[sign] sg1
        gas=nat fuel
      ^ sovereign_gyre
      = news (sovereign_react sg cur)
      '  Lens deps translate against the pre-round namespace: its
      '  signs graded that state, and an /o answer's first change (an
      '  unminted pin minting) must wake its watcher.
      =   lens
        | lens_from_reader
          (sovereign_derived cur) (sovereign_reader prev)
      = lt (react_lens sg lens).tap
      =   nws
        | lt.fold news
          \ out [p q]
          | out.put p q
      ? (eq 0 nws.wyt)
        | ./spun cur moves rounds a .none
      ? (eq 0 gas)
        | ./spun cur moves rounds a (./some 'cycle_exhausted)
      ? (sovereign_run_event (./hear nws) eny now block cur)
        > (./fail e2=iota) (./spun cur moves rounds a (./some e2))
        > (./ripe s2 fx2 sg2 a2)
          = m2 moves.weld(fx2)
            r2 rounds.snoc(sg2)
          | _ s2 cur m2 r2 sg2 gas.dec

+ trigger_changed
  \ before=namespace after=namespace trigger=dep
  ^ bool
  ? (is_r trigger.p)
    > (./some address) (r_parse trigger.p) .false
    = [target relative] address
    =   prior
      | reference_index/beneath target before.local.top
        before.local.references
    =   next
      | reference_index/beneath target after.local.top
        after.local.references
    | not (equal prior next)
  = prior (before.case(trigger.c trigger.p))
    next  (after.case(trigger.c trigger.p))
  | not (equal prior next)

+ sovereign_reconcile
  '  Source publication can commit several prepared batches outside
  '  dispatch. Catch watchers up once against the final state, using
  '  their real care clocks instead of replaying intermediate
  '  publications or scanning values.
  \ before=namespace after=namespace now=nat block=nat
  ^ either[iota namespace]
  ? (eq before.local.top after.local.top) (./ok after)
  = watchers        | sovereign_watchers after
    reader          | sovereign_reader before
    changed_trigger | trigger_changed before after
  =   changed
    (
      \ dependency=dep
      ^ bool
      = triggers (derived_triggers dependency reader .true)
      | triggers.any changed_trigger)
  =   news
    (
      | watchers.tap.fold (axal/new[row[dep]] .none)
      \ out [watched subscribers]
      | subscribers.fold out
        \ out subscriber
        ? (not (changed (dep subscriber.c watched))) out
        | out.put watched (out.gut(watched []).snoc(subscriber)))
  ? (eq news.wyt 0) (./ok after)
  ? (sovereign_cycle (task/hear news) 0 128 now block after)
    > (./fail why) (./err why)
    > (./spun next moves rounds ack spill)
      > .none spill (./err 'publication_reaction_failed)
      ? moves.len (./err 'publication_outbound_not_supported)
      | ./ok next

'  --- publication ---
'  Preparation is pure. All records, including generated members, must
'  be enumerated before the compiler uses these assignments.

+ publication_batch
  : authority=iota expected=axal[nat] assigned=axal[nat]
  + valid_authority
    \ authority=iota
    ^ bool
    ? (eq_iota authority 'sys) .true
    ? (not (eq (aura_tag authority) "x")) .false
    | not (eq (quip_val authority) 0)

  + prepare
    \ authority=iota names=row[path] state=sov
    ^ either[iota publication_batch]
    ? (not (publication_batch/valid_authority authority))
      | ./err 'invalid_authority
    ? (not (namespace/confined [authority] state))
      | ./err 'authority_mismatch
    % i=nat 0
      expected=axal[nat] (axal/new[nat] .none)
      assigned=axal[nat] (axal/new[nat] .none)
    ^ either[iota publication_batch]
    ? (eq i names.len)
      | ./ok (publication_batch authority expected assigned)
    = name | names.at i
    ? (not (pith_prefix [authority] name)) (./err 'authority_mismatch)
    ? expected.dip(name).fil
      > (./some _) (./err 'duplicate_definition)
    = previous state.x_case(name).fall(0)
    | _ i.inc expected.put(name previous)
      assigned.put(name (inc previous))

  + valid_record
    \ batch=publication_batch entry=[path myth]
    ^ bool
    = [name record] entry
    ? (not (pith_prefix [batch.authority] name)) .false
    > (./some assigned) (batch.assigned.dip(name).fil)
      .false
    > (./some expected) (batch.expected.dip(name).fil)
      .false
    ? (not (eq assigned (inc expected))) .false
    .true

  + publish_records
    '  Commit prepared records, including documentation-only system
    '  seeds. No part of the candidate store escapes until every
    '  expected predecessor and resulting data case has been checked.
    \ records=axal[myth] now=nat block=nat state=sov
      batch=publication_batch
    ^ either[iota sov]
    ? (not (publication_batch/valid_authority batch.authority))
      | ./err 'invalid_authority
    ? (not (namespace/confined [batch.authority] state))
      | ./err 'authority_mismatch
    ? (not (eq batch.expected.tap.len batch.assigned.tap.len))
      | ./err 'invalid_assignments
    ? (not (equal records.tap.len batch.assigned.tap.len))
      | ./err 'incomplete_publication
    =   predecessors
      | batch.expected.tap.all
        \ [name expected]
        = actual state.x_case(name).fall(0)
        | eq actual expected
    ? (not predecessors) (./err 'stale_publication)
    = valid | records.tap.all (publication_batch/valid_record batch)
    ? (not valid) (./err 'invalid_definition_record)
    =   diffs
      | records.tap.fold (axal/new[note] .none)
        \ out [name record]
        | out.put name (note/make record)
    < result=[next=sov signs=axal[sign]]
      | sov/step diffs now block state
    = [next signs] result
    =   consistent
      | batch.assigned.tap.all
        \ [name assigned]
        > (./some actual) next.x_case(name) .false
        | eq assigned actual
    ? (not consistent) (./err 'inconsistent_publication)
    | ./ok next

  + publish
    '  Compiler-definition records require their public /sys/mold
    '  descriptor.
    \ records=axal[myth] now=nat block=nat state=sov
      batch=publication_batch
    ^ either[iota sov]
    =   valid
      | records.tap.all
        \ [name record] record.has(system_vocabulary/mold)
    ? (not valid)
      | ./err 'invalid_definition_record
    | publication_batch/publish_records records now block state batch

  + publish_namespace
    '  Verify the prepared batch before journaling one local
    '  transaction.
    \ system=pin[row[[path nat]]] records=axal[myth]
      now=nat block=nat state=namespace batch=publication_batch
    ^ either[iota namespace/committed]
    ? (not (equal system (unpin state.system).definitions))
      | ./err 'system_publication_mismatch
    ? (not (eq_iota batch.authority state.self))
      | ./err 'write_outside_authority
    < checked
      | publication_batch/publish records now block state.local batch
    =   changes
      | records.tap.fold (axal/new[note] .none)
        \ out [name card]
        | out.put name (note/make card)
    | namespace/step changes now block state
