- graph_views

' A union preserves assertions and their owners. Matching a slot is a way to
' compare claims, never permission to choose a winner or erase disagreement.
+ graph_union
  + fact
    : about=safe source=safe slot=path value=pail evidence=myth
  + literal
    \ slot=path held=pail
    ^ bool
    ? (pith_prefix ['sys] slot) .false
    ? ((equal[path] slot ['name]) || ((equal[path] slot ['description]) || ((equal[path] slot ['text]) || ((equal[path] slot ['said]) || (equal[path] slot ['quote]))))) .false
    ? held
     > ref=safe .false
    .true
  + claim_slot
    \ record=myth
    ^ maybe[path]
    ?> (./some held) record.get(['slot]) .none
    ? held
     > value=pails/p (./some value.p)
     > value=pails/t
       ? (eq value.t.len 0) .none
       | path_parse (? (eq value.t.at(0) 47) value.t (str/cat_all ["/" value.t]))
    .none
  + facts
    \ members=row[safe] next={\ row[graph_union/fact]}view_plan
    ^ view_plan
    % i=nat 0 found=row[graph_union/fact] []
    ^ view_plan
    ? (eq i members.len) (next found)
    = member members.at(i)
      resume (_ i.inc)
    | graph_views/record member
      \ record=myth
      ^ view_plan
      = found
          | record.tap.fold found
            \ out [slot value]
            ? !(graph_union/literal slot value) out
            | out.snoc (graph_union/fact member member slot value myth/new)
      | ./need (view_read (view_ops/at member ['claims] .z) .all)
        \ claims=res[axal[myth]]
        ^ view_plan
        ?> (./known tree) claims (resume found)
        = found
            | tree.tap.fold found
              \ out [relative assertion]
              ? (maybe/is_some assertion.get(['retracted])) out
              ?> (./some slot) (graph_union/claim_slot assertion) out
              ?> (./some value) assertion.get(['value]) out
              = source (view_ops/at member relative.cons('claims) .x)
              | out.snoc (graph_union/fact member source slot value assertion)
        | resume found
  + tree
    \ facts=row[graph_union/fact] conflicts=bool
    ^ axal[myth]
    = empty=mop[path row[graph_union/fact] lt_pith] (mop/empty)
      groups
        | facts.fold empty
          \ out fact
          | out.put fact.slot (out.get(fact.slot)).fall([]).snoc(fact)
      rows=row[mop/kv[path row[graph_union/fact]]] groups.tap
      initial=axal[myth] (axal/new[myth] (./some myth/new))
    | rows.fold initial
      \ out=axal[myth] pair=mop/kv[path row[graph_union/fact]]
      ^ axal[myth]
      = [slot claims] pair
        first claims.at(0).value
        differs !(claims.all((\ fact (equal[pail] first fact.value))))
      ? (and conflicts !differs) out
      = name=path slot.cons(($u slot.len))
        record (myth/sing ['slot] (pails/p slot)).put(['disagreement] (pails/b differs)).put(['assertions] (pails/n claims.len))
        out out.put(name record)
      | claims.fold out
        \ out=axal[myth] fact=graph_union/fact
        ^ axal[myth]
        = source=path (view_walk/name fact.source)
          suffix=path ['assertions ($u source.len)]
          at name.weld(suffix).weld(source)
          record
            . (myth/sing ['value] fact.value)
              put(['source] fact.source)
              put(['about] fact.about)
              put(['slot] (pails/p fact.slot))
          record
            | fact.evidence.tap.fold record
              \ out [slot held]
              | out.put slot.cons('evidence) held
        | out.put at record
  + get
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/canonical_view graph_union/get_at context cr relative select
  + members
    \ source=safe cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/identity [source] (axal/new[safe] .none)
      \ members=row[safe]
      ^ view_plan
      % i=nat 0 output=axal[myth] (axal/new[myth] (./some myth/new))
      ^ view_plan
      ? (eq i members.len) (graph_views/result output cr relative select)
      = member members.at(i)
        name (view_walk/name member)
        resume (_ i.inc)
      | ./need (view_read (view_ops/at member [] .x) (view_select/slots [['name]]))
        \ value=res[axal[myth]]
        ^ view_plan
        = record
            ?> (./known tree) value myth/new
            | tree.fil.fall(myth/new)
        | resume output.put(name.cons(($u name.len)) record.put(['source] member))
  + get_at
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    ? (gt relative.len 0)
      = first relative.at(0)
        tail relative.drop(1)
      ? (eq_iota first 'records) (graph_views/identities_at context cr tail select)
      ? (eq_iota first 'members) (graph_union/members source cr tail select)
      ? (eq_iota first 'relations) (graph_views/relations_at context cr tail select)
      ? !((eq_iota first 'facts) || (eq_iota first 'conflicts)) (./fail "missing union branch")
      | graph_views/identity [source] (axal/new[safe] .none)
        \ members=row[safe]
        ^ view_plan
        | graph_union/facts members
          \ facts=row[graph_union/fact]
          ^ view_plan
          | graph_views/result (graph_union/tree facts (eq_iota first 'conflicts)) cr tail select
    = root (myth/sing ['subject] source).put(['coverage] (pails/t "Explicit identity assertions and recorded facts; no claim of exhaustive knowledge."))
      leaf (axal/new[myth] (./some root))
    ? (equal[care] cr .x) (./done leaf)
    = keys=path ['records 'members 'facts 'conflicts 'relations]
    ? ((equal[care] cr .y) || (equal[view_select] select .names))
      = outline
          | keys.fold leaf
            \ out key
            | out.put [key] myth/new
      | ./done outline
    % i=nat 0 output=axal[myth] leaf
    ^ view_plan
    ? (eq i keys.len) (./done output)
    = key keys.at(i)
      resume (_ i.inc)
    | view_walk/bind (graph_union/get_at context .z [key] select)
      \ tree=axal[myth]
      ^ view_plan
      = merged
          | tree.tap.fold output
            \ out [name record]
            | out.put name.cons(key) record
      | resume merged
