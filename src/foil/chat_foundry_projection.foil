-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  weft [order=30]
-  foundry [order=40]
-  foundry_doc [order=50]
-  foundry_corpus [order=60]
-  foundry_delivery [order=70]
'  Chat-specific source/corpus projection compiler.  It produces the same
'  addressed, renderer-neutral DAG and byte-identical operation identities as
'  the former nested module; extraction only bounds Foil elaboration.
+  chat_foundry_projection
  +  plate_op
    ^  path
    ['chat 'weft 'foundry 'plate]
  +  messages_op
    ^  path
    ['chat 'weft 'foundry 'messages]
  +  scene_op
    ^  path
    ['chat 'weft 'foundry 'scene]
  +  shrine_op
    ^  path
    ['chat 'weft 'foundry 'shrine]
  +  desktop_op
    ^  path
    ['chat 'weft 'foundry 'desktop]
  +  hydrate_op
    ^  path
    ['chat 'weft 'foundry 'hydrate]
  +  contrast_op
    ^  path
    ['chat 'weft 'foundry 'contrast]
  +  web_op
    ^  path
    ['chat 'weft 'foundry 'web]
  +  text_op
    ^  path
    ['chat 'weft 'foundry 'text]

  +  projection_request
    '  Routes choose the semantic target and ceiling only.  The mounted
    '  Semidoc catalog owns every recipe, layer, and terminal choice.
    \  root=path kind=nat
    ^  foundry/request
    =  role=path
         ?  (eq kind "plate")
            ['chat 'plate]
         ?  (eq kind "shrine")
            ['shrine 'scene]
         ?  (eq kind "desktop")
            ['stage_flow]
         ?  (eq kind "contrast")
            ['chat 'scene 'high_contrast]
         ['chat 'scene]
       ceiling=iota
         ?  (eq kind "plate")
            'plate
         ?  (eq kind "desktop")
            'scene
         'scene
       pronunciation=path
         ?  (eq kind "contrast")
            ['shrine 'high_contrast]
         ['shrine 'default]
    (foundry/request root role 'full ceiling 'web pronunciation [])
  +  projection_for
    \  root=path kind=nat corpus=axal[myth]
    ^  foundry/projection
    (foundry/compile_catalog (chat_foundry_projection/projection_request root kind) corpus)

  +  path_in
    \  at=path refs=row[path]
    ^  bool
    refs.any((\ ref (eq_pith at ref)))

  +  compiled_document
    '  Temporary cache boundary: mounted Foundry records retain canonical
    '  Semidoc source text but not the complete typed surface value.  Until
    '  corpus mounting stores that typed value, reparse exactly that admitted
    '  source here.  Missing or invalid records are explicit absence.
    \  ref=path corpus=axal[myth]
    ^  maybe[foundry_doc/document]
    ?  (foundry/corpus_record ref corpus)
     > .none  .none
     > (./some rec=myth)
       =  src  (myth/txt_at ['foundry 'source] rec)
       ?  (eq src 0)
          .none
       (foundry_doc/compilation_value (foundry_doc/compile src))

  +  template_closure_refs
    '  Follow the selected catalog's ordered recipes to their optional typed
    '  template references.  Every recipe is compiled and name-checked, even
    '  when it has no template.  Every named template is likewise compiled and
    '  name-checked before stable first-occurrence deduplication.
    \  recipes=row[path] corpus=axal[myth] i=nat out=row[path]
    ^  [refs=row[path] code=maybe[iota]]
    ?  (ge i recipes.len)
       ?  (eq out.len 0)
          [out (./some 'template_evidence_missing)]
       [out .none]
    =  recipe_ref  recipes.at(i)
    ?  (foundry/corpus_record recipe_ref corpus)
     > .none  [out (./some 'recipe_evidence_missing)]
     > (./some recipe_record=myth)
       ?  (eq (myth/txt_at ['foundry 'source] recipe_record) 0)
          [out (./some 'recipe_evidence_invalid)]
       ?  (chat_foundry_projection/compiled_document recipe_ref corpus)
        > .none  [out (./some 'recipe_evidence_invalid)]
        > (./some recipe_doc=foundry_doc/document)
          ?  !(eq_pith (foundry_doc/document_name recipe_doc) recipe_ref)
             [out (./some 'recipe_evidence_invalid)]
          ?  (foundry_doc/document_recipe recipe_doc)
           > .none  [out (./some 'recipe_evidence_invalid)]
           > (./some recipe=foundry_doc/recipe)
             ?  (foundry_doc/recipe_template recipe)
              > .none  (_ recipes corpus i.inc out)
              > (./some template_ref=path)
                ?  (foundry/corpus_record template_ref corpus)
                 > .none  [out (./some 'template_evidence_missing)]
                 > (./some template_record=myth)
                   ?  (eq (myth/txt_at ['foundry 'source] template_record) 0)
                      [out (./some 'template_evidence_invalid)]
                   ?  (chat_foundry_projection/compiled_document template_ref corpus)
                    > .none  [out (./some 'template_evidence_invalid)]
                    > (./some template_doc=foundry_doc/document)
                      ?  !(eq_pith
                            (foundry_doc/document_name template_doc)
                            template_ref)
                         [out (./some 'template_evidence_invalid)]
                      ?  (foundry_doc/document_surface template_doc)
                       > .none  [out (./some 'template_evidence_invalid)]
                       > (./some template=foundry_doc/surface)
                         =  next=row[path]
                              ?  (chat_foundry_projection/path_in template_ref out)
                                 out
                              out.snoc(template_ref)
                         (_ recipes corpus i.inc next)

  +  template_closure
    '  Renderer-neutral structural closure selected only by authored catalog
    '  and recipe data.  Route/kind spellings never enumerate templates.
    \  recipes=row[path] corpus=axal[myth]
    ^  [refs=row[path] code=maybe[iota]]
    ?  (eq recipes.len 0)
       [[] (./some 'recipe_evidence_missing)]
    (chat_foundry_projection/template_closure_refs recipes corpus 0 [])

  +  catalog_template_closure
    '  The selected mounted catalog is the sole structural enumerator.
    \  catalog=myth corpus=axal[myth]
    ^  [refs=row[path] code=maybe[iota]]
    (chat_foundry_projection/template_closure
      (foundry/paths_at ['catalog 'recipes] catalog) corpus)

  +  surface_has_node
    \  at=path nodes=row[foundry_doc/surface_node]
    ^  bool
    nodes.any((\ n (eq_pith at n.address)))

  +  surface_node_add
    \  n=foundry_doc/surface_node nodes=row[foundry_doc/surface_node]
    ^  row[foundry_doc/surface_node]
    ?  (chat_foundry_projection/surface_has_node n.address nodes)
       nodes
    nodes.snoc(n)

  +  surface_edge_add
    \  e=foundry_doc/surface_edge edges=row[foundry_doc/surface_edge]
    ^  row[foundry_doc/surface_edge]
    ?  edges.any((\ old (chat_foundry_projection/surface_same_edge e old)))
       edges
    edges.snoc(e)

  +  surface_same_edge
    \  a=foundry_doc/surface_edge b=foundry_doc/surface_edge
    ^  bool
    ?  !(eq_pith a.parent b.parent)  .false
    ?  !(eq_pith a.placement b.placement)  .false
    (eq_pith a.child b.child)

  +  surface_union
    '  Close a template reference over earlier authored definitions.  Shared
    '  definitions stay single nodes; every contextual placement stays an
    '  edge, so the result remains a tree-shaped DAG rather than copied trees.
    \  base=foundry_doc/surface other=foundry_doc/surface
    ^  foundry_doc/surface
    =  nodes
         other.nodes.fold(base.nodes ;
           \ out n
           (chat_foundry_projection/surface_node_add n out))
       edges
         other.edges.fold(base.edges ;
           \ out e
           (chat_foundry_projection/surface_edge_add e out))
    (foundry_doc/surface other.name other.root nodes edges)

  +  authored_surface
    '  Compile and close every mounted Semidoc template required by this
    '  projection.  The returned root belongs to the requested outer ceiling.
    \  refs=row[path] corpus=axal[myth]
    ^  maybe[foundry_doc/surface]
    |  > i=nat 0  > out=maybe[foundry_doc/surface] .none
    ^  maybe[foundry_doc/surface]
    ?  (ge i refs.len)
       out
    ?  (chat_foundry_projection/compiled_document refs.at(i) corpus)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  (foundry_doc/document_surface doc)
        > .none  .none
        > (./some sf=foundry_doc/surface)
          ?  out
           > .none  (_ i.inc (./some sf))
           > (./some prior=foundry_doc/surface)
             (_ i.inc (./some (chat_foundry_projection/surface_union prior sf)))

  +  record_evidence_refs
    '  Collect exact mounted document records without shortening the ordered
    '  evidence list.  A record without canonical Semidoc source is not
    '  admissible evidence even if its projected fields happen to look valid.
    \  refs=row[path] corpus=axal[myth] i=nat out=axal[myth]
    ^  maybe[axal[myth]]
    ?  (ge i refs.len)
       (./some out)
    ?  (foundry/corpus_record refs.at(i) corpus)
     > .none  .none
     > (./some rec=myth)
       ?  (eq (myth/txt_at ['foundry 'source] rec) 0)
          .none
       (_ refs corpus i.inc out.put([($u i)] rec))

  +  record_evidence
    \  refs=row[path] corpus=axal[myth]
    ^  maybe[axal[myth]]
    ?  (eq refs.len 0)
       .none
    (chat_foundry_projection/record_evidence_refs refs corpus 0
      (axal/new[myth] .none))

  +  layer_values_refs
    '  Compile the selected catalog's ordered layer documents into the same
    '  typed Foundry layer values used by cascade.  The mounted record is
    '  evidence, never the resolver itself: source must compile as a layer and
    '  must name the exact selected reference.
    \  refs=row[path] corpus=axal[myth] i=nat out=row[foundry/layer]
    ^  maybe[row[foundry/layer]]
    ?  (ge i refs.len)
       (./some out)
    =  ref  refs.at(i)
    ?  (chat_foundry_projection/compiled_document ref corpus)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  !(eq_pith (foundry_doc/document_name doc) ref)
          .none
       ?  (foundry_doc/document_layer doc)
        > .none  .none
        > (./some layer=foundry_doc/layer)
          (_ refs corpus i.inc
            out.snoc((foundry_doc/layer_of layer)))

  +  layer_resolution
    \  refs=row[path] corpus=axal[myth]
    ^  maybe[foundry/hydration]
    (chat_foundry_projection/layer_resolution_with_system refs corpus [] .none)

  +  admitted_layer
    '  One normalized Nenex Layer contributes both the typed value used by
    '  cascade and its inert ordinary record used by revision evidence.
    :  layer=foundry/layer record=myth

  +  admitted_plate_header
    '  The shared structural contract and the exact ordinary authoring record
    '  that participates in immutable recipe/revision evidence.
    :  surface=foundry_doc/surface record=myth

  +  admitted_system
    '  One normalized Nenex admission is shared by all system-definition
    '  lookups.  Missing or invalid authored definitions remain ordinary
    '  absence so the mounted static corpus can serve as bounded fallback.
    :  header=maybe[chat_foundry_projection/admitted_layer]
       foundations=maybe[row[chat_foundry_projection/admitted_layer]]
       plate_header=maybe[chat_foundry_projection/admitted_plate_header]

  +  admitted_layer_in
    \  name=path admission=foundry_corpus/admission
    ^  maybe[chat_foundry_projection/admitted_layer]
    ?  (foundry_corpus/admission_layer name admission)
     > .none  .none
     > (./some layer=foundry/layer)
       ?  (foundry_corpus/admission_record name admission)
        > .none  .none
        > (./some record=myth)
          (./some (chat_foundry_projection/admitted_layer layer record))

  +  admitted_header_text_in
    \  admission=foundry_corpus/admission
    ^  maybe[chat_foundry_projection/admitted_layer]
    (chat_foundry_projection/admitted_layer_in
      ['foundry 'system 'styles 'header_text] admission)

  +  foundation_names
    '  Declaration order is cascade order: broad semantic roles, Web provider,
    '  then guarded accessibility policy.  Consumers may omit high contrast
    '  when the request does not select that guarded mode; the packet itself is
    '  admitted atomically.
    ^  row[path]
    [['foundry 'system 'layers 'chat_foundation]
     ['foundry 'system 'providers 'web_chat]
     ['foundry 'system 'guards 'high_contrast]
     ['foundry 'system 'guards 'reduced_motion]]

  +  admitted_layers_at
    \  names=row[path] admission=foundry_corpus/admission index=nat
       out=row[chat_foundry_projection/admitted_layer]
    ^  maybe[row[chat_foundry_projection/admitted_layer]]
    ?  (ge index names.len)  (./some out)
    ?  (chat_foundry_projection/admitted_layer_in names.at(index) admission)
     > .none  .none
     > (./some layer=chat_foundry_projection/admitted_layer)
       (_ names admission index.inc out.snoc(layer))

  +  admitted_foundations_in
    '  A partial authored foundation packet is not mixed into a projection.
    '  All four cohesive Layers must be admitted; otherwise the existing
    '  static Chat layers remain the bounded migration fallback.
    \  admission=foundry_corpus/admission
    ^  maybe[row[chat_foundry_projection/admitted_layer]]
    (chat_foundry_projection/admitted_layers_at
      chat_foundry_projection/foundation_names admission 0 [])

  +  admitted_plate_header_in
    \  admission=foundry_corpus/admission
    ^  maybe[chat_foundry_projection/admitted_plate_header]
    =  name=path  ['foundry 'system 'blocks 'plate_header]
    ?  (foundry_corpus/admission_document name admission)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  (foundry_doc/document_surface doc)
        > .none  .none
        > (./some sf=foundry_doc/surface)
          ?  (foundry_corpus/admission_record name admission)
           > .none  .none
           > (./some record=myth)
             (./some (chat_foundry_projection/admitted_plate_header sf record))

  +  admitted_system_from
    \  authored=axal[myth]
    ^  chat_foundry_projection/admitted_system
    ?  (eq authored.kid_tap.len 0)
       (chat_foundry_projection/admitted_system .none .none .none)
    =  admission  (foundry_corpus/admit_axal ['nenex 'w] authored)
    (chat_foundry_projection/admitted_system
      (chat_foundry_projection/admitted_header_text_in admission)
      (chat_foundry_projection/admitted_foundations_in admission)
      (chat_foundry_projection/admitted_plate_header_in admission))

  +  admitted_header_text_from
    '  Observe the already-descended /nenex/w Sight through record-oriented
    '  corpus admission.  No ['src] slot is read and no Nenex code is imported.
    '  Any corpus diagnostic, collision, missing definition, or wrong kind is
    '  absence here; callers retain their static admitted fallback.
    \  authored=axal[myth]
    ^  maybe[chat_foundry_projection/admitted_layer]
    =  system  (chat_foundry_projection/admitted_system_from authored)
    system.header

  +  static_plate_header
    '  Mounted .sd corpus is the explicit migration fallback for the same
    '  stable semantic identity.  It is selected only when normalized Nenex
    '  authoring is absent or refused.
    \  corpus=axal[myth]
    ^  maybe[chat_foundry_projection/admitted_plate_header]
    =  name=path  ['foundry 'system 'blocks 'plate_header]
    ?  (chat_foundry_projection/compiled_document name corpus)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  (foundry_doc/document_surface doc)
        > .none  .none
        > (./some sf=foundry_doc/surface)
          ?  (foundry/corpus_record name corpus)
           > .none  .none
           > (./some record=myth)
             (./some (chat_foundry_projection/admitted_plate_header sf record))

  +  selected_plate_header
    \  authored=maybe[chat_foundry_projection/admitted_plate_header]
       corpus=axal[myth]
    ^  maybe[chat_foundry_projection/admitted_plate_header]
    ?  authored
     > (./some plate=chat_foundry_projection/admitted_plate_header)  (./some plate)
     > .none  (chat_foundry_projection/static_plate_header corpus)

  +  foundation_layer_selected
    \  kind=nat layer=chat_foundry_projection/admitted_layer
    ^  bool
    =  high_contrast=path  ['foundry 'system 'guards 'high_contrast]
       name  (foundry/layer_name layer.layer)
    ?  (eq_pith name high_contrast)  (eq kind "contrast")
    .true

  +  selected_foundations
    \  kind=nat foundations=maybe[row[chat_foundry_projection/admitted_layer]]
    ^  row[chat_foundry_projection/admitted_layer]
    ?  foundations
     > .none  []
     > (./some layers=row[chat_foundry_projection/admitted_layer])
       layers.keep((chat_foundry_projection/foundation_layer_selected kind))

  +  admitted_layer_values
    \  layers=row[chat_foundry_projection/admitted_layer]
    ^  row[foundry/layer]
    layers.map((\ layer layer.layer))

  +  foundation_layers_from
    '  Inspectable pure boundary for the authored packet selected by one
    '  semantic request kind.  It returns no partial packet and performs no
    '  observation or rendering.
    \  kind=nat authored=axal[myth]
    ^  row[foundry/layer]
    =  system  (chat_foundry_projection/admitted_system_from authored)
       selected
         (chat_foundry_projection/selected_foundations kind system.foundations)
    (chat_foundry_projection/admitted_layer_values selected)

  +  layer_resolution_with_system
    '  Resolve broad-to-near plus guarded layers with Foundry's canonical
    '  cascade.  The result contains both final values and exact winning-layer
    '  provenance and is ready for the generic addressed-DAG bridge.  The
    '  authored system packet follows the catalog's migration layers; guarded
    '  values still replay last.  Header Text Style remains the nearest
    '  ordinary typography refinement.
    \  refs=row[path] corpus=axal[myth]
       foundations=row[chat_foundry_projection/admitted_layer]
       header=maybe[chat_foundry_projection/admitted_layer]
    ^  maybe[foundry/hydration]
    ?  (eq refs.len 0)
       .none
    ?  (chat_foundry_projection/layer_values_refs refs corpus 0 [])
     > .none  .none
     > (./some layers=row[foundry/layer])
       =  with_foundations
            layers.weld((chat_foundry_projection/admitted_layer_values foundations))
          selected
            ?  header
             > .none  with_foundations
             > (./some admitted=chat_foundry_projection/admitted_layer)
               with_foundations.snoc(admitted.layer)
       (./some (foundry/cascade selected))

  +  admitted_layer_records_at
    \  layers=row[chat_foundry_projection/admitted_layer] index=nat out=axal[myth]
    ^  axal[myth]
    ?  (ge index layers.len)  out
    (_ layers index.inc out.put([($u index)] layers.at(index).record))

  +  layer_evidence_with_system
    \  layers=axal[myth] foundations=row[chat_foundry_projection/admitted_layer]
       header=maybe[chat_foundry_projection/admitted_layer]
    ^  axal[myth]
    =  foundation_records
         (chat_foundry_projection/admitted_layer_records_at foundations 0
           (axal/new[myth] .none))
       with_foundations
         ?  (eq foundations.len 0)  layers
         layers.rep(['authored 'foundations] foundation_records)
    ?  header
     > .none  with_foundations
     > (./some admitted=chat_foundry_projection/admitted_layer)
       with_foundations.put(['authored 'header_text] admitted.record)

  +  surface_evidence_refs
    '  Surface identity covers both canonical Semidoc source and the mounted
    '  compiler projection below each document root.  Compilation and kind are
    '  checked before the subtree is admitted to the digest bundle.
    \  refs=row[path] corpus=axal[myth] i=nat out=axal[myth]
    ^  maybe[axal[myth]]
    ?  (ge i refs.len)
       (./some out)
    =  ref  refs.at(i)
    ?  (chat_foundry_projection/compiled_document ref corpus)
     > .none  .none
     > (./some doc=foundry_doc/document)
       ?  (foundry_doc/document_surface doc)
        > .none  .none
        > (./some sf=foundry_doc/surface)
          (_ refs corpus i.inc
            out.rep([($u i)] corpus.dip((foundry/corpus_path ref))))

  +  surface_evidence
    \  refs=row[path] corpus=axal[myth]
    ^  maybe[axal[myth]]
    ?  (eq refs.len 0)
       .none
    (chat_foundry_projection/surface_evidence_refs refs corpus 0
      (axal/new[myth] .none))

  +  evidence_bundle
    '  One closed identity input: selected catalog, every ordered recipe and
    '  layer record, and every exact compiled surface subtree used by the DAG.
    \  catalog=myth recipes=axal[myth] layers=axal[myth]
       surfaces=axal[myth] plate_header=myth
    ^  axal[myth]
    .  (axal/new[myth] (./some catalog))
       rep(['recipes] recipes)
       rep(['layers] layers)
       rep(['surfaces] surfaces)
       put(['contracts 'plate_header] plate_header)

  +  refusal_revision
    '  Failure revisions name the source, request, and refusal itself.  They do
    '  not pretend a shortened recipe or template evidence set was admitted.
    \  source_snapshot=axal[myth] request_rec=myth code=iota
    ^  foundry_digest
    =  failure  (myth/new).put(['code] (pails/q code))
       evidence
         .  (axal/new[myth] .none)
            rep(['source] source_snapshot)
            put(['request] request_rec)
            put(['failure] failure)
    (foundry_delivery/digest_tree evidence)

  +  refuse_request
    \  source_snapshot=axal[myth] request_rec=myth code=iota
    ^  row[projection_frame]
    (chat_foundry_projection/refusal_frames
      (chat_foundry_projection/refusal_revision source_snapshot request_rec code) code)

  +  packet_path_text
    '  Exact path spelling for the transport-only packet label.  Keep this
    '  local so the renderer-neutral producer does not import the Web server.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/"
    =  parts
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx p.len)
            out
         (_ idx.inc out.snoc((iota_show p.at(idx))))
    (weft/cat2 "/" (weft/join "/" parts))

  +  frame_packet_id
    '  Stable transport/cache label only.  This value never participates in
    '  semantic addressing; source pin plus occurrence axis owns identity.
    \  root=path kind=nat
    ^  nat
    (weft/cat
      ["chat-projection:" (chat_foundry_projection/packet_path_text root) ":" kind])

  +  dag_frames
    \  dag=projection_dag
    ^  row[projection_frame]
    =  manifest  (foundry_delivery/dag_manifest dag)
       contexts  (foundry_delivery/dag_contexts dag)
       entries   (foundry_delivery/dag_entries dag)
       seed=row[projection_frame]
         [(foundry_delivery/begin_with_contexts manifest contexts)]
       frames
         entries.fold(seed ;
           \ out entry
           ?  entry
            > x=projection_entry/node
              out.snoc((foundry_delivery/upsert manifest
                (projection_object/node x.node)))
            > x=projection_entry/placement
              out.snoc((foundry_delivery/upsert manifest
                (projection_object/placement x.placement)))
            > x=projection_entry/interaction
              out.snoc((foundry_delivery/upsert manifest
                (projection_object/interaction x.interaction)))
            > x=projection_entry/tombstone
              out.snoc((foundry_delivery/withdraw manifest
                x.tombstone.address x.tombstone.target)))
    frames.snoc((foundry_delivery/complete manifest))

  +  refusal_frames
    \  revision=foundry_digest code=iota
    ^  row[projection_frame]
    =  manifest  (foundry_delivery/make_manifest revision [] [] [])
    [(foundry_delivery/begin manifest)
     (foundry_delivery/refuse manifest code)]

  +  packet_refusal
    \  source_snapshot=axal[myth] request_rec=myth code=iota
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    [(chat_foundry_projection/refuse_request source_snapshot request_rec code) .none]

  +  packet_product_with_header
    '  Pure Chat projection producer.  The mounted catalog selects recipes;
    '  the mounted Semidoc templates close into one renderer-neutral authored
    '  DAG; its ordered layers resolve through Foundry cascade into typed value
    '  and winning-layer parameters.  Finalized source, recipe, and request
    '  evidence provide independent source/recipe/revision digests.  Begin and
    '  Complete bound one revision.
    '  No route, HTML, CSS, DOM state, or behavior authority enters the DAG.
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth]
       foundations=row[chat_foundry_projection/admitted_layer]
       header=maybe[chat_foundry_projection/admitted_layer]
       plate_header=maybe[chat_foundry_projection/admitted_plate_header]
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    =  projection  (chat_foundry_projection/projection_for root kind corpus)
       request_rec
         .  (myth/new)
            put(['target] (pails/p projection.plan.req.role))
            put(['ceiling] (pails/q projection.plan.req.ceiling))
            put(['pronunciation] (pails/p projection.plan.req.pronunciation))
    ?  (gt projection.plan.diagnostics.len 0)
       (chat_foundry_projection/packet_refusal source_snapshot request_rec
         projection.plan.diagnostics.at(0).code)
    ?  (foundry/corpus_record projection.catalog corpus)
     > .none
       (chat_foundry_projection/packet_refusal source_snapshot request_rec
         'catalog_evidence_missing)
     > (./some catalog=myth)
       ?  (eq (myth/txt_at ['foundry 'source] catalog) 0)
          (chat_foundry_projection/packet_refusal source_snapshot request_rec
            'catalog_evidence_missing)
       =  recipe_refs  (foundry/paths_at ['catalog 'recipes] catalog)
          layer_refs   (foundry/paths_at ['catalog 'layers] catalog)
       ?  (chat_foundry_projection/record_evidence recipe_refs corpus)
        > .none
          (chat_foundry_projection/packet_refusal source_snapshot request_rec
            'recipe_evidence_missing)
        > (./some recipes=axal[myth])
          =  [surface_refs surface_issue]
               (chat_foundry_projection/catalog_template_closure catalog corpus)
          ?  surface_issue
           > (./some code=iota)
             (chat_foundry_projection/packet_refusal source_snapshot request_rec code)
           > .none
             ?  (chat_foundry_projection/record_evidence layer_refs corpus)
              > .none
                (chat_foundry_projection/packet_refusal source_snapshot request_rec
                  'layer_evidence_missing)
              > (./some layers=axal[myth])
                =  layer_evidence
                     (chat_foundry_projection/layer_evidence_with_system layers
                       foundations header)
                ?  (chat_foundry_projection/layer_resolution_with_system
                      layer_refs corpus foundations header)
                 > .none
                   (chat_foundry_projection/packet_refusal source_snapshot request_rec
                     'layer_evidence_invalid)
                 > (./some hydration=foundry/hydration)
                   ?  (chat_foundry_projection/surface_evidence surface_refs corpus)
                    > .none
                      (chat_foundry_projection/packet_refusal source_snapshot request_rec
                        'template_evidence_invalid)
                    > (./some surfaces=axal[myth])
                      ?  (chat_foundry_projection/selected_plate_header
                            plate_header corpus)
                       > .none
                         (chat_foundry_projection/packet_refusal source_snapshot
                           request_rec 'slot_template_missing)
                       > (./some plate=chat_foundry_projection/admitted_plate_header)
                         =  evidence
                              (chat_foundry_projection/evidence_bundle catalog recipes
                                layer_evidence surfaces plate.record)
                            source
                              (foundry_delivery/digest_tree source_snapshot)
                            recipe  (foundry_delivery/digest_tree evidence)
                            revision_evidence
                              .  (axal/new[myth] .none)
                                 rep(['source] source_snapshot)
                                 rep(['projection] evidence)
                                 put(['request] request_rec)
                            revision
                              (foundry_delivery/digest_tree revision_evidence)
                            resolution
                              (foundry_delivery/make_resolution
                                (foundry/hydration_values hydration)
                                (foundry/hydration_provenance hydration))
                         ?  (chat_foundry_projection/authored_surface surface_refs corpus)
                          > .none
                            [(chat_foundry_projection/refusal_frames revision
                               'template_evidence_invalid) .none]
                          > (./some sf=foundry_doc/surface)
                            ?  (foundry_delivery/realize_surface_template sf
                                  plate.surface projection.plan.req.ceiling)
                             > x=surface_template_result/refused
                               [(chat_foundry_projection/refusal_frames revision x.code)
                                .none]
                             > x=surface_template_result/admitted
                               =  input
                                    (foundry_delivery/make_bound_bridge_input
                                      source recipe revision x.surface
                                      x.bindings (./some resolution))
                               ?  (foundry_delivery/authoring_surface_dag_input
                                     input)
                                > y=projection_bridge_result/refused
                                  [(chat_foundry_projection/refusal_frames revision y.code)
                                   .none]
                                > y=projection_bridge_result/admitted
                                  [(chat_foundry_projection/dag_frames y.dag)
                                   (./some y.dag)]

  +  packet_product
    '  Compatibility producer with the static admitted corpus only.
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth]
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    (chat_foundry_projection/packet_product_with_header
      root kind corpus source_snapshot [] .none .none)

  +  packet_product_authored
    '  Prefer one successfully admitted normalized Nenex system packet:
    '  foundations, Header Text Style, and Plate Header anatomy.  Invalid or
    '  absent authoring state falls back at each bounded migration seam.
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth] authored=axal[myth]
    ^  [frames=row[projection_frame] dag=maybe[projection_dag]]
    =  system  (chat_foundry_projection/admitted_system_from authored)
       foundations
         (chat_foundry_projection/selected_foundations kind system.foundations)
    (chat_foundry_projection/packet_product_with_header root kind corpus source_snapshot
      foundations system.header system.plate_header)

  +  packet_frames
    '  Compatibility projection-frame accessor over the richer internal
    '  product.  The admitted DAG remains available to late pronunciation.
    \  root=path kind=nat corpus=axal[myth]
       source_snapshot=axal[myth]
    ^  row[projection_frame]
    =  [frames dag]
         (chat_foundry_projection/packet_product root kind corpus source_snapshot)
    frames
