- grove_ui_runtime
- debug_read

' Debugger transport data; deliberately absent from the default Grove prelude.
' The debugger host opts in to this contract, while general UI uses grove_ui_runtime.
+ grove_debug_page
  ' Only presentation metadata crosses the UI boundary, not a supervisor page.
  : epoch=nat before=maybe[nat] limit=nat total=nat next=maybe[nat]

+ grove_debug_data
  : target=path view=axal[myth] versions=axal[myth]
    operations=row[[p=path o=op]] paging=maybe[grove_debug_page]
    writable=bool scope=iota slice=maybe[debug_read/page]
  + read
    \ value=pail
    ^ maybe[grove_debug_data]
    > data=grove_debug_data value
      .none
    | ./some data
  + write
    \ value=grove_debug_data
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ grove_debug_data)
