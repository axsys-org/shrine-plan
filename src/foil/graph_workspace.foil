- graph_views
- graph_world

' Several standings read as one picture: each standing is walked over its
' relations to a depth, breadth first, and every name is owned by the standing
' that reached it first.  Where a standing reaches a name another already
' owns, the two meet: that is a route between them, each hop attributed to
' the world asserting it and marked solid or mention.  Standings joined by
' routes form components; a standing in a component of its own is an island;
' standings in different components are gaps.  Mention hops reach a name but
' are never followed further, so a route through a text is drawn tentative,
' end to end, and counted apart.  Pure: nothing it draws is written back.
' Standings: the input (/sys/tack) and every standing/<key> slot, any care.
+ graph_workspace
  + nodes
    ' Things opened on one page, over all standings.
    ^ nat
    120
  + hop
    : label=path other=safe by=str strength=iota direction=iota note=myth
  + reached
    ' A name on the page: the standing that owns it, the hops that led there,
    ' how many of them were mentions.
    : standing=nat route=row[graph_workspace/hop] soft=nat
  + entry
    : standing=nat source=safe depth=nat route=row[graph_workspace/hop] soft=nat
  + meeting
    ' Two standings reaching one name: the route from each side.
    : from=nat to=nat at=path here=row[graph_workspace/hop] there=row[graph_workspace/hop] soft=nat
  + state
    : reach=axal[graph_workspace/reached] meetings=row[graph_workspace/meeting] used=nat
  + standings
    \ context=myth
    ^ row[[iota safe]]
    = base=row[[iota safe]]
        ?> (./some source) (view_ops/input context) []
        [['input source]]
    | context.tap.fold base
      \ out=row[[iota safe]] [slot held]
      ? !(eq slot.len 2) out
      ? !(graph_views/seg_is slot.at(0) 'standing) out
      ?> source=safe held out
      | out.snoc [slot.at(1) source]
  + paired
    \ from=nat to=nat meetings=row[graph_workspace/meeting]
    ^ bool
    | meetings.any
      \ m=graph_workspace/meeting
      | ((and (eq m.from from) (eq m.to to)) || (and (eq m.from to) (eq m.to from)))
  + walk
    ' Breadth first over every standing's queue at once, so the first route
    ' found between two standings is a shortest one.
    \ queue=row[graph_workspace/entry] st=graph_workspace/state next={\ graph_workspace/state}view_plan
    ^ view_plan
    ? ((eq queue.len 0) || (ge st.used graph_workspace/nodes)) (next st)
    = here queue.at(0)
      rest queue.drop(1)
    | graph_views/relations_for here.source
      \ members=row[safe] relations=row[graph_views/relation]
      ^ view_plan
      = kept (relations.filter((\ e=graph_views/relation !(graph_world/skipped e.label))))
        shown (? (lt kept.len graph_world/cap) kept kept.take(graph_world/cap))
      % i=nat 0 reach=axal[graph_workspace/reached] st.reach meetings=row[graph_workspace/meeting] st.meetings queued=row[graph_workspace/entry] rest
      ^ view_plan
      ? (eq i shown.len) (graph_workspace/walk queued (graph_workspace/state reach meetings st.used.inc) next)
      = edge shown.at(i)
        other (view_walk/name edge.other)
        tentative (eq_iota edge.strength 'mention)
        h (graph_workspace/hop edge.label edge.other (graph_world/world (view_walk/name edge.via)) edge.strength edge.direction edge.note)
        route here.route.snoc(h)
        soft (? tentative here.soft.inc here.soft)
      ? (reach.get(other))
       > (./some r)
         ? (eq r.standing here.standing) (_ i.inc reach meetings queued)
         ? (graph_workspace/paired r.standing here.standing meetings) (_ i.inc reach meetings queued)
         | _ i.inc reach meetings.snoc((graph_workspace/meeting here.standing r.standing other route r.route (add r.soft soft))) queued
      = reach reach.put(other (graph_workspace/reached here.standing route soft))
        queued
          ? (tentative || (eq here.depth 1)) queued
          | queued.snoc (graph_workspace/entry here.standing edge.other here.depth.dec route soft)
      | _ i.inc reach meetings queued
  + components
    ' A component label per standing: standings that meet over established
    ' hops share one.  A meeting through a text is drawn as a route but joins
    ' nothing: the island stays an island until the text is digested or judged.
    \ count=nat meetings=row[graph_workspace/meeting]
    ^ row[nat]
    = start=row[nat]
        % i=nat 0 out=row[nat] []
        ^ row[nat]
        ? (eq i count) out
        | _ i.inc out.snoc(i)
    | meetings.fold start
      \ labels=row[nat] m=graph_workspace/meeting
      ^ row[nat]
      ? (gt m.soft 0) labels
      = keep labels.at(m.from)
        drop labels.at(m.to)
      | labels.map (\ l=nat (? (eq l drop) keep l))
  + hops
    ' One side of a route, as records beneath <at>/<side>/<k>.
    \ at=path side=iota route=row[graph_workspace/hop] output=axal[myth]
    ^ axal[myth]
    % k=nat 0 out=axal[myth] output
    ^ axal[myth]
    ? (eq k route.len) out
    = h route.at(k)
      name=path at.weld([side ($u k)])
      record
        . (myth/sing ['label] (pails/p h.label))
          put(['other] h.other)
          put(['by] (pails/t h.by))
          put(['strength] (pails/q h.strength))
          put(['direction] (pails/q h.direction))
      ' The edge's own notes ride with the hop, as they do on an as-world item.
      noted
        | h.note.tap.fold record
          \ out=myth [slot held]
          ? (pith_prefix ['sys] slot) out
          ? held
           > ref=safe out
          | out.put slot.cons('note) held
    | _ k.inc out.put(name noted)
  + get
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    = standings (graph_workspace/standings context)
    ? (eq standings.len 0) (./fail "no standings: set /sys/tack or standing/<key> slots")
    ? (gt standings.len 12) (./fail "at most 12 standings")
    = depth (context.nat_at(['depth] 3))
    ? ((gt depth 6) || (eq depth 0)) (./fail "depth: 1 to 6")
    = seeded
        % i=nat 0 queue=row[graph_workspace/entry] [] reach=axal[graph_workspace/reached] (axal/new[graph_workspace/reached] .none)
        ^ [row[graph_workspace/entry] axal[graph_workspace/reached]]
        ? (eq i standings.len) [queue reach]
        = [key source] standings.at(i)
          empty=row[graph_workspace/hop] []
        | _ i.inc queue.snoc((graph_workspace/entry i source depth empty 0)) reach.put((view_walk/name source) (graph_workspace/reached i empty 0))
      [queue reach] seeded
    | graph_workspace/walk queue (graph_workspace/state reach [] 0)
      \ st=graph_workspace/state
      ^ view_plan
      = labels (graph_workspace/components standings.len st.meetings)
        none=row[nat] []
        distinct
          | labels.fold none
            \ out=row[nat] l=nat
            ? (out.any((\ seen=nat (eq seen l)))) out
            | out.snoc l
        islands
          | distinct.filter
            \ l=nat
            | eq (labels.filter((\ m=nat (eq m l)))).len 1
        solid
          | st.reach.tap.fold 0
            \ n=nat [name r]
            ^ nat
            ? (eq r.soft 0) n.inc
            n
        tentative (sub st.reach.tap.len solid)
        root
          . (myth/sing ['standings] (pails/n standings.len))
            put(['components] (pails/n distinct.len))
            put(['islands] (pails/n islands.len))
            put(['routes] (pails/n st.meetings.len))
            put(['reach] (pails/n solid))
            put(['tentative] (pails/n tentative))
            put(['opened] (pails/n st.used))
        output=axal[myth]
          % i=nat 0 out=axal[myth] (axal/new[myth] (./some root))
          ^ axal[myth]
          ? (eq i standings.len) out
          = [key source] standings.at(i)
            name (view_walk/name source)
            mine labels.at(i)
            island=bool
              % j=nat 0
              ^ bool
              ? (eq j islands.len) .false
              ? (eq islands.at(j) mine) .true
              | _ j.inc
            record
              . (myth/sing ['at] source)
                put(['key] (pails/q key))
                put(['world] (pails/t (graph_world/world name)))
                put(['component] (pails/n mine))
                put(['island] (pails/b island))
          | _ i.inc out.put(['standing ($u i)] record)
        output
          % n=nat 0 out=axal[myth] output
          ^ axal[myth]
          ? (eq n st.meetings.len) out
          = m st.meetings.at(n)
            at=path ['route ($u n)]
            record
              . (myth/sing ['from] (pails/n m.from))
                put(['to] (pails/n m.to))
                put(['at] (pails/p m.at))
                put(['hops] (pails/n (add m.here.len m.there.len)))
                put(['soft] (pails/n m.soft))
                put(['tentative] (pails/b (gt m.soft 0)))
            placed out.put(at record)
            placed (graph_workspace/hops at 'here m.here placed)
          | _ n.inc (graph_workspace/hops at 'there m.there placed)
        output
          % i=nat 0 g=nat 0 out=axal[myth] output
          ^ axal[myth]
          ? (eq i standings.len) out
          = pairs
              % j=nat i.inc g=nat g out=axal[myth] out
              ^ [nat axal[myth]]
              ? (eq j standings.len) [g out]
              ? (eq labels.at(i) labels.at(j)) (_ j.inc g out)
              = soft=nat
                  % n=nat 0 found=nat 0
                  ^ nat
                  ? (eq n st.meetings.len) found
                  = m st.meetings.at(n)
                  ? (graph_workspace/paired i j [m]) (_ n.inc found.inc)
                  | _ n.inc found
                record (myth/sing ['from] (pails/n i)).put(['to] (pails/n j)).put(['tentative] (pails/n soft))
              | _ j.inc g.inc out.put(['gap ($u g)] record)
            [g out] pairs
          | _ i.inc g out
      | graph_views/result output cr relative select
