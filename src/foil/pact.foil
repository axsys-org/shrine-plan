-  lain
'  pact: the application kit — the vocabulary an application uses to
'  describe itself to the namespace, and the mount form that expands
'  a manifest into an app subtree (doc/shrine-apps.md section 5).
+  lore
  '  Structured documentation as a value: the one-line head, the body
  '  lines, and the doctests as source/expected pairs.
  :  head=nat body=row[nat] tests=row[[src=nat want=nat]]
+  put_lore
  '  Put lore at ['lore] when present (lo truthy) — the components
  '  build the pail.  Absent lore leaves the myth untouched.
  \  t=myth lo=nat lh=nat lb=row[nat] lt=row[[src=nat want=nat]]
  ^  myth
  ?  lo
     t.put(['lore] (lore lh lb lt))
  t
+  lore1
  '  One-line lore: the head is the whole body.
  \  h=nat
  ^  lore
  (lore h [h] [])
+  dt_verdict
  '  A doctest run's outcome, poked onto the documented node by the
  '  /io/doctest driver: host time, the node's own version at run
  '  time (the staleness anchor - a reader compares it against the
  '  node's current version), and per-test results index-aligned
  '  with the lore's tests.  got carries text only on failure.
  :  when=nat case=nat results=row[[i=nat pass=nat got=nat]]
+  dt_card_t
  '  The verdict poke's myth: just the ['dt] slot.
  \  when=nat case=nat rs=row[[i=nat pass=nat got=nat]]
  ^  myth
  =  > t myth/new
  t.put(['dt] (dt_verdict when case rs))
+  help_doc_t
  '  A documentation-only namespace record.
  \  d=nat
  ^  myth
  =  > t myth/new
  t.put(['doc] (pails/t d))
+  boot_doc_t
  '  Compatibility name for /boot documentation records.
  \  d=nat
  ^  myth
  (help_doc_t d)
+  boot_src_t
  '  A /boot file record: the module's source text, plus the module
  '  header's lore when captured (lo truthy).
  \  s=nat lo=nat lh=nat lb=row[nat] lt=row[[src=nat want=nat]]
  ^  myth
  =  > t myth/new
  =  > t2 t.put(['src] (pails/t s))
  (put_lore t2 lo lh lb lt)
+  boot_ent_t
  '  A /boot entry record: kind and source slice always; lore when
  '  captured; the compiled value only when lowering produced one
  '  (const-generic base members stay unlowered).
  \  v=nat k=nat s=nat lowered=nat lo=nat lh=nat lb=row[nat] lt=row[[src=nat want=nat]]
  ^  myth
  =  > t myth/new
  =  > t2 t.put(['kind] (pails/t k))
  =  > t3 t2.put(['src] (pails/t s))
  =  > t4 (put_lore t3 lo lh lb lt)
  ?  lowered
     t4.put(['code] (pails/code v))
  t4
+  formed
  '  A registry record: the form riding in its ['form] slot (forms
  '  are nominal rows, so they inhabit pails directly), documented at
  '  ['lore].
  \  f=form d=lore
  ^  myth
  =  > t1 myth/new
  =  > t2 t1.put(['form] f)
  t2.put(['lore] d)
+  kdecl
  '  One behavior the app provides: its id (one segment under the
  '  app's own kook subtree), its form, its lore.
  :  id=quip f=form d=lore
+  mani
  '  An application manifest: the app's name, its lore, the behaviors
  '  it provides, and the records it seeds.  Every path is
  '  app-relative — the mount form re-roots the whole tree at
  '  expansion.
  :  name=quip doc=lore kooks=row[kdecl] seeds=row[[p=path t=myth]]
+  pact_slot
  '  The slot a mount card carries its manifest in.
  ^  path
  ['pact]
+  abs_kook
  '  Absolutize a seed myth's app-relative kook refs against the
  '  mount root: a seed's /sys/kook refs name form nodes inside the
  '  app's own subtree.
  \  here=path t=myth
  ^  myth
  ?  t.get(kook_slot)
   > .none  t
   > (./some pl=pail)
     ?  pl
      > k=kook
        =  > refs k.refs
        =  > acc2
             |  > i=nat 0  > acc=row[path] []
             ?  (eq i refs.len)
                acc
             (_ i.inc acc.snoc(here.weld(refs.at(i))))
        t.put(kook_slot (kook acc2))
     t
+  kook_cards
  '  Cards installing a manifest's behaviors at here/kook/<id>: poke
  '  when the node is already in kids (upgrade), make otherwise — so
  '  the same expansion serves mount and remount.
  \  here=path kids=axal[myth] ks=row[kdecl]
  ^  row[[p=path q=writ]]
  |  > i=nat 0  > acc=row[[p=path q=writ]] []
  ?  (eq i ks.len)
     acc
  =  > kd ks.at(i)
  =  > kr ['kook]
  =  > rel kr.snoc(kd.id)
  =  > t (formed kd.f kd.d)
  =  > q=writ
       ?  kids.get(rel)
        > (./some old=myth)  (./poke t)
        > .none  (./make t)
  (_ i.inc acc.snoc([here.weld(rel) q]))
+  seed_cards
  '  Cards for a manifest's seed records, re-rooted at here, with
  '  app-relative kook refs absolutized.  Poke-if-present, like
  '  kook_cards.
  \  here=path kids=axal[myth] seeds=row[[p=path t=myth]]
  ^  row[[p=path q=writ]]
  |  > i=nat 0  > acc=row[[p=path q=writ]] []
  ?  (eq i seeds.len)
     acc
  =  > sd seeds.at(i)
  =  > t2 (abs_kook here t)
  =  > q=writ
       ?  kids.get(p)
        > (./some old=myth)  (./poke t2)
        > .none  (./make t2)
  (_ i.inc acc.snoc([here.weld(p) q]))
+  pact_init
  '  The mount expansion (doc/shrine-apps.md 5.2): read the manifest
  '  the card carried at ['pact] and emit cards for the whole app
  '  subtree re-rooted at here; the app's lore lands on the root.
  '  ingest keeps only cards under here in this transaction, so the
  '  expansion cannot install outside its root; a failure anywhere
  '  aborts the worm, so partial mounts cannot commit.  A card with
  '  no (or a non-mani) ['pact] installs nothing.
  \  b=bowl t=myth
  ^  yell
  ?  t.get(pact_slot)
   > .none  (yell [] t)
   > (./some pl=pail)
     ?  pl
      > m=mani
        =  > here b.here
        =  > kc (kook_cards here b.kids m.kooks)
        =  > sc (seed_cards here b.kids m.seeds)
        (yell kc.weld(sc) t.put(['lore] m.doc))
     (yell [] t)
+  pact_talk
  '  Upgrade: a fresh ['pact] poked onto the root re-expands against
  '  the in-flight view of the subtree — present nodes poke, new ones
  '  make.  Removal is the unmount story and rides with it (a cull
  '  request expands the same way).
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > d (def_talk b cur add)
  =  > t2 d.out
  ?  add.get(pact_slot)
   > .none  (yell [] t2)
   > (./some pl=pail)
     ?  pl
      > m=mani
        =  > kc (kook_cards b.here b.kids m.kooks)
        =  > sc (seed_cards b.here b.kids m.seeds)
        (yell kc.weld(sc) t2.put(['lore] m.doc))
     (yell [] t2)
+  pact_form
  '  The mount behavior: init expands a fresh mount, talk expands an
  '  upgrade.  Installed at /kook/pact with the kernel's own
  '  registrations during boot seeding, resolved like any behavior.
  ^  form
  def_form.set_init(pact_init).set_talk(pact_talk)
+  mani_ok
  '  Whether the pail is a mani — the host's mount gate: an app whose
  '  app entry is not a manifest does not mount.
  \  pl=pail
  ^  nat
  ?  pl
   > m=mani  1
  0
+  app_card_t
  '  The mount card the host makes at an app's root: the manifest at
  '  ['pact], [module] and [status], and the /sys/kook ref to the
  '  pact mount form.
  \  m=mani modname=nat
  ^  myth
  =  > t myth/new
  =  > t1 t.put(pact_slot m)
  =  > t2 t1.put(['module] (pails/t modname))
  =  > t3 t2.put(['status] (pails/t "live"))
  t3.put(kook_slot (kook [['kook 'pact]]))
+  app_fail_t
  '  The card at the mount root when the app failed to compile or
  '  mount: [status] "failed", [err] the rendered error.  A broken
  '  app is a visible namespace citizen, not a host log line.
  \  e=nat
  ^  myth
  =  > t myth/new
  =  > t2 t.put(['status] (pails/t "failed"))
  t2.put(['err] (pails/t e))
+  root_doc_t
  '  A reserved-root card: just the convention's lore (shrine-apps.md
  '  section 7 — each writable root says what it is from inside the
  '  namespace).
  \  h=nat
  ^  myth
  (put_lore myth/new 1 h [h] [])
