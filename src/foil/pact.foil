-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
'  pact: the application kit — the vocabulary an application uses to
'  describe itself to the namespace, and the mount form that expands
'  a manifest into an app subtree (doc/shrine-apps.md section 5).
+  text
  '  Rendered text: a packed cord riding a nat.
  nat
+  lore
  '  Structured documentation as a value: the one-line head, the body
  '  lines, and the doctests as source/expected pairs.
  :  head=text body=row[text] tests=row[[src=text want=text]]

  +  put
    '  Put lore when present (has truthy): the head at bond/lede as
    '  text, the full lore pail at bond/help.  Absent lore leaves
    '  the myth untouched.
    \  tale=myth has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    ?  has
       tale.put(bond/lede (pails/t head)).put(bond/help (lore head body tests))
    tale

  +  line
    '  One-line lore: the head is the whole body.
    \  head=text
    ^  lore
    (lore head [head] [])
+  doctest
  +  verdict
    '  A doctest run's outcome, poked onto the documented node by the
    '  /io/doctest driver: host time, the node's own version at run
    '  time (the staleness anchor — a reader compares it against the
    '  node's current version), and per-test results index-aligned
    '  with the lore's tests.  got carries text only on failure.
    :  when=nat case=nat results=row[[i=nat pass=nat got=nat]]

  +  card
    '  The verdict poke's myth: just the ['dt] slot.
    \  when=nat case=nat results=row[[i=nat pass=nat got=nat]]
    ^  myth
    (myth/new).put(['dt] (doctest/verdict when case results))
+  mirror
  '  The /boot mirror's cards: how the system's own compiled code
  '  appears to itself from inside the namespace.

  +  doc
    '  A documentation-only namespace record.
    \  doc=text
    ^  myth
    (myth/new).put(['doc] (pails/t doc))

  +  src
    '  A module file record: the module's source text, plus the
    '  module header's lore when captured.
    \  src=text has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    =  tale  (myth/new).put(bond/src (pails/t src))
    (lore/put tale has head body tests)

  +  entry
    '  An entry record: kind and source slice always; lore when
    '  captured; the compiled value only when lowering produced one
    '  (const-generic base members stay unlowered).
    \  code=nat kind=text src=text lowered=bool
       has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
    ^  myth
    =  tale
         .  (myth/new)
            put(['kind] (pails/t kind))
            put(bond/src (pails/t src))
       tale  (lore/put tale has head body tests)
    ?  lowered
       tale.put(['code] (pails/code code))
    tale

  +  extras
    '  Extra mirror slots layered onto an entry record: the reflected
    '  type descriptor, the decompiled law text, and the reference
    '  rows — .none/0/empty means absent.
    \  sig=maybe[type] law=text calls=row[path] callers=row[path] tale=myth
    ^  myth
    =  tale
         ?  sig
          > (./some d)  tale.put(bond/mold (pails/ty d))
          > .none  tale
       tale
         ?  law
            tale.put(['law] (pails/t law))
         tale
       tale
         ?  calls.len
            tale.put(['calls] (pails/ps calls))
         tale
    ?  callers.len
       tale.put(['called_by] (pails/ps callers))
    tale

  +  fail
    '  The card at a module's mirror node when it failed to compile:
    '  [status] "failed" plus the pretty diagnostic text.
    \  err=text
    ^  myth
    .  (myth/new)
       put(['status] (pails/t "failed"))
       put(['err] (pails/t err))

  +  index
    '  A /boot/ns/<root> index record: the entry nodes grouped under
    '  one source namespace root.
    \  entries=row[path]
    ^  myth
    (myth/new).put(['entries] (pails/ps entries))
+  form
  +  card
    '  A registry record: the form riding in its ['form] slot (forms
    '  are nominal rows, so they inhabit pails directly), documented
    '  at bond/lede + bond/help.
    \  =form =lore
    ^  myth
    .  (myth/new)
       put(['form] form)
       put(bond/lede (pails/t lore.head))
       put(bond/help lore)
+  weft_card
  '  A component node's record: an overlay ctor (dyed/knit/felt/sewn,
  '  a nominal row, so it inhabits pails directly) riding at
  '  /sys/weft, a demo data path the zoo renders it against (spell it
  '  app-relative with pact/rel — path pails rebase at mount), and
  '  lede + help lore.  Components are write-once namespace citizens:
  '  mount once, never poke in place — an upgrade mints a FRESH path —
  '  so x case 1 is always the correct function pin for /o and /frag
  '  URLs.
  \  ctor=pail demo=path =lore
  ^  myth
  .  (myth/new)
     put(bond/weft ctor)
     put(['demo] (pails/p demo))
     put(bond/lede (pails/t lore.head))
     put(bond/help lore)
+  kook
  +  decl
    '  One behavior the app provides: its id (one segment under the
    '  app's own kook subtree), its form, its lore.
    :  id=iota =form =lore

+  grant
  '  One driver capability an app asks for (doc/multifile-apps-io-
  '  grants.md part II).  The app ASKS; the host DECIDES; the
  '  decision — not the ask — is what the namespace enforces.  A
  '  manifest's wants row is the ask, the ['grants] slot the mount
  '  writes is the answer, and the helm's move gate reads the answer.
  +  gfetch
    '  Outbound HTTP through the fetch driver at /io/http_client.
    :
  +  gserve
    '  An HTTP listener on a real port of its own.
    :  port=nat
  &  grant/gfetch
     grant/gserve

  +  has_fetch
    '  1 when a wants/grants row carries outbound HTTP, else 0.  Nats,
    '  not bools, because both sides of this value are hosts: the
    '  card slot is a pd and the helm's gate reads it back with
    '  nat_at.
    '  ?=  ((grant/has_fetch []) 0)
    '  ?=  ((grant/has_fetch [.gfetch]) 1)
    \  gs=row[grant]
    ^  nat
    |  > i=nat 0
    ?  (eq i gs.len)
       0
    ?  gs.at(i)
     > .gfetch  1
     > (./gserve port=nat)  (_ i.inc)

  +  serve_port
    '  The port a wants/grants row asks a listener on, or 0 for none.
    '  ?=  ((grant/serve_port [(./gserve 8099)]) 8099)
    '  ?=  ((grant/serve_port [.gfetch]) 0)
    \  gs=row[grant]
    ^  nat
    |  > i=nat 0
    ?  (eq i gs.len)
       0
    ?  gs.at(i)
     > (./gserve port=nat)  port
     > .gfetch  (_ i.inc)
+  mani
  '  An application manifest: the app's name, its lore, the behaviors
  '  it provides, the records it seeds, and the driver capabilities
  '  it asks for (wants).  Seed MOUNT paths are app-relative — the
  '  mount form re-roots the whole tree at expansion.  Path VALUES
  '  inside seed records (kook refs, path pails) are absolute unless
  '  "."-headed: pact/rebase_rec welds the mount root onto exactly
  '  those (spell them with pact/rel).
  :  name=iota doc=lore kooks=row[kook/decl] seeds=row[[p=path t=myth]]
     wants=row[grant]

  +  ok
    '  Whether the pail is a mani — the host's mount gate: an app
    '  whose app entry is not a manifest does not mount.
    \  held=pail
    ^  bool
    ?=(m=mani held)

  +  put_seed
    '  One seed unioned into a seed row: a fresh path appends, a
    '  collision melds records with the incoming side winning slot
    '  collisions (myth/meld).
    \  acc=row[[p=path t=myth]] seed=[p=path t=myth]
    ^  row[[p=path t=myth]]
    =  [p t]  seed
    =  same
         \  e=[q=path u=myth]
         ^  bool
         =  [q u]  e
         (eq_pith q p)
    ?  acc.any(same)
       =  upd
            \  e=[q=path u=myth]
            ^  [q=path u=myth]
            =  [q u]  e
            ?  (eq_pith q p)
               [q (myth/meld t u)]
            [q u]
       acc.map(upd)
    acc.snoc([p t])

  +  weld_spec
    '  A spec module's mani welded onto an app's code mani: the code
    '  side names the app and brings behavior (kooks); seeds union
    '  per path with spec structure first and code seeds winning
    '  slot collisions; EVERY seed is judged by the yoke
    '  (yoke/adopt), so code-side records adopt their contracts too;
    '  and the asks union (both sides' wants — the host still caps).
    \  y=yoke spec=mani code=mani
    ^  mani
    (mani code.name code.doc
          code.kooks.weld(spec.kooks)
          (yoke/adopt y code.seeds.fold(spec.seeds mani/put_seed))
          code.wants.weld(spec.wants))

  +  adopt_spec
    '  A typing-only spec (no template layer) applied to a code
    '  mani: the seeds adopt whatever the yoke assigns them.
    \  y=yoke code=mani
    ^  mani
    code.set_seeds((yoke/adopt y code.seeds))

+  ward
  '  The generic warden: a node carrying its sub-spec (a yoke at
  '  ['sys 'spec]) and this behavior stamps every freshly arrived
  '  kid with the contract the spec assigns it — SYNCHRONOUSLY,
  '  because the take cascade runs inside the driving event: a kid
  '  is never observable without its contract.  Absent-only: a kid
  '  that already carries ['sys 'lash] is never touched, so a
  '  deliberate contract change survives and the cascade drains
  '  (an identical re-poke could not, and does not, happen).

  +  take
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    ?>  (./some held) cur.get(['sys 'spec])
        (yell [] cur)
    ?   held
     >  y=yoke
        =  seg_of
             \  acc=row[iota] e=[p=path m=mode]
             ^  row[iota]
             =  [p m]  e
             ?  (eq 0 p.len)
                acc
             ?  acc.any((\ s (eq_iota s p.at(0))))
                acc
             acc.snoc(p.at(0))
        =  segs  g.tap.fold([] seg_of)
        =  stamp
             \  acc=row[[p=path q=writ]] seg=iota
             ^  row[[p=path q=writ]]
             ?>  (./some t) b.kids.dip([seg]).fil
                 acc
             ?   ?=((./some _) t.get(['sys 'lash]))
                 acc
             ?>  (./some l) (yoke/at [seg] y)
                 acc
             ?   (equal l lash/new)
                 acc
             acc.snoc([b.here.snoc(seg) (writ/poke (myth/sing ['sys 'lash] l))])
        (yell segs.fold([] stamp) cur)
    (yell [] cur)

  +  form
    '  take-only: creation stamping is the whole job.
    ^  form
    def_form.set_take(ward/take)
+  pact
  '  The mount form itself: the slot a mount card carries its
  '  manifest in, the card builders, and the expansion.

  +  slot
    '  The slot a mount card carries its manifest in.
    ^  path
    ['pact]

  +  rel_seg
    '  The instance-relative path marker: the "." segment.  A path
    '  value in a seed record whose head is this segment rebases
    '  against the mount root; every other path value is absolute.
    '  ("." is therefore reserved as a head segment in seed-record
    '  path VALUES — never in seed mount paths, which always weld.)
    ^  iota
    ($ts ".")

  +  rel
    '  An instance-relative path, for manifest authors: "." on the
    '  front, so the mount welds its root on.
    \  p=path
    ^  path
    p.cons(pact/rel_seg)

  +  rebase_path
    '  A "."-headed path absolutized against the mount root;
    '  anything else is absolute and stays put.
    \  here=path p=path
    ^  path
    ?  (eq 0 p.len)
       p
    ?  (eq_iota p.at(0) pact/rel_seg)
       here.weld(p.drop(1))
    p

  +  rebase_rec
    '  Every instance-relative slot of a seed record absolutized:
    '  kook limb refs, pails/p payloads, and pails/ps rows — one
    '  rule, one mechanism, for behavior refs and data references
    '  alike.  Crew deps are untouched (apps build crews from the
    '  bowl at init).
    \  here=path tale=myth
    ^  myth
    tale.tap.fold(tale ;
      \  acc e
      ?  e.val
       > kp=kook
         acc.put(e.key (kook kp.refs.map((pact/rebase_path here))))
       > pp=pails/p
         acc.put(e.key (pails/p (pact/rebase_path here pp.p)))
       > sp=pails/ps
         acc.put(e.key (pails/ps sp.ps.map((pact/rebase_path here))))
      acc)

  +  kooks
    '  Cards installing a manifest's behaviors at here/kook/<id>:
    '  poke when the node is already in kids (upgrade), make
    '  otherwise — so the same expansion serves mount and remount.
    \  here=path kids=axal[myth] decls=row[kook/decl]
    ^  row[[p=path q=writ]]
    |  > idx=nat 0  > out=row[[p=path q=writ]] []
    ?  (eq idx decls.len)
       out
    =  one   decls.at(idx)
       rel=path   ['kook one.id]
       card  (form/card one.form one.lore)
       act=writ
         ?  kids.get(rel)
          > (./some old=myth)  (./poke card)
          > .none  (./make card)
    (_ idx.inc out.snoc([here.weld(rel) act]))

  +  seeds
    '  Cards for a manifest's seed records, re-rooted at here, with
    '  "."-headed path values absolutized (pact/rebase_rec).
    '  Poke-if-present, like pact/kooks.  A seed at path [] is legal
    '  and always POKES: the root node necessarily exists in-flight
    '  (it is the node this very mount is making), so the seed MELDS
    '  onto the mount card's record — the card's ['pact]/['module]/
    '  ['status]/limb survive because a document root never writes
    '  those.  (A make would replace the card and unmake the app.)
    \  here=path kids=axal[myth] seeds=row[[p=path t=myth]]
    ^  row[[p=path q=writ]]
    |  > idx=nat 0  > out=row[[p=path q=writ]] []
    ?  (eq idx seeds.len)
       out
    =  [at=path rec=myth]  seeds.at(idx)
       card  (pact/rebase_rec here rec)
       act=writ
         ?  (eq 0 at.len)
            (./poke card)
         ?  kids.get(at)
          > (./some old=myth)  (./poke card)
          > .none  (./make card)
    (_ idx.inc out.snoc([here.weld(at) act]))

  +  init
    '  The mount expansion (doc/shrine-apps.md 5.2): read the
    '  manifest the card carried at ['pact] and emit cards for the
    '  whole app subtree re-rooted at here; the app's lore lands on
    '  the root.  ingest keeps only cards under here in this
    '  transaction, so the expansion cannot install outside its
    '  root; a failure anywhere aborts the worm, so partial mounts
    '  cannot commit.  A card with no (or a non-mani) ['pact]
    '  installs nothing.
    \  =bowl tale=myth
    ^  yell
    >  (./some held=pail) tale.get(pact/slot)
       (yell [] tale)
    >  app=mani held
       (yell [] tale)
    =  kooks  (pact/kooks bowl.here bowl.kids app.kooks)
       seeds  (pact/seeds bowl.here bowl.kids app.seeds)
       tale
         ?  app.doc.head
            tale.put(bond/lede (pails/t app.doc.head)).put(bond/help app.doc)
         tale
    (yell kooks.weld(seeds) tale)

  +  talk
    '  Upgrade: a fresh ['pact] poked onto the root re-expands
    '  against the in-flight view of the subtree — present nodes
    '  poke, new ones make.  Removal is the unmount story and rides
    '  with it (a cull request expands the same way).
    \  =bowl cur=myth add=myth
    ^  yell
    =  tale  (def_talk bowl cur add).out
    >  (./some held=pail) add.get(pact/slot)
       (yell [] tale)
    >  app=mani held
       (yell [] tale)
    =  kooks  (pact/kooks bowl.here bowl.kids app.kooks)
       seeds  (pact/seeds bowl.here bowl.kids app.seeds)
       tale
         ?  app.doc.head
            tale.put(bond/lede (pails/t app.doc.head)).put(bond/help app.doc)
         tale
    (yell kooks.weld(seeds) tale)

  +  vine_card
    '  The one-event subtree card: root plus the seeds as a sub-mani
    '  at ['pact], the pact limb riding — pact/init expands the
    '  whole subtree wherever the card is made.  The lore args are
    '  the root's own lore (absent when has is 0); it rides the
    '  manifest and lands back at bond/help on the root.
    \  has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
       root=myth seeds=row[[p=path t=myth]]
    ^  myth
    =  doc
         ?  has
            (lore head body tests)
         (lore 0 [] [])
       app   (mani 'sub doc [] seeds [])
    .  root
       put(pact/slot app)
       put(limb_slot (kook [['kook 'pact]]))

  +  vine
    '  A whole subtree as one committed event: a make at pax whose
    '  card is pact/vine_card — the in-kernel pact expansion
    '  (pact/init) commits every seed in the same epoch, paying the
    '  commit machinery once per subtree instead of once per node.
    \  pax=path has=bool head=text body=row[text]
       tests=row[[src=text want=text]]
       root=myth seeds=row[[p=path t=myth]]
    ^  task
    (./vine pax (writ/make (pact/vine_card has head body tests root seeds)))

  +  form
    '  The mount behavior: init expands a fresh mount, talk expands
    '  an upgrade.  Installed at /kook/pact with the kernel's own
    '  registrations during boot seeding, resolved like any behavior.
    ^  form
    def_form.set_init(pact/init).set_talk(pact/talk)

  +  card
    '  The mount card the host makes at an app's root: the manifest
    '  at ['pact], [module] and [status], the /sys/kook ref to the
    '  pact mount form, and the grant ledger.
    '  .
    '  ['wants ..] is what the manifest ASKED for, ['grants ..] what
    '  the host ALLOWED — the gap between the two is the readable
    '  "this app wanted more" signal, and ['grants 'fetch] is exactly
    '  what the helm's move gate reads back.  The decision arrives as
    '  nats because a host cannot mint nominal sum values across the
    '  FFI (see grant/has_fetch).
    \  =mani module=text gfetch=nat gport=nat
    ^  myth
    .  (myth/new)
       put(pact/slot mani)
       put(['module] (pails/t module))
       put(['status] (pails/t "live"))
       put(['wants 'fetch] (pd (grant/has_fetch mani.wants)))
       put(['wants 'serve] (pd (grant/serve_port mani.wants)))
       put(['grants 'fetch] (pd gfetch))
       put(['grants 'serve] (pd gport))
       put(limb_slot (kook [['kook 'pact]]))

  +  fail
    '  The card at the mount root when the app failed to compile or
    '  mount: [status] "failed", [err] the rendered error.  A broken
    '  app is a visible namespace citizen, not a host log line.
    \  err=text
    ^  myth
    .  (myth/new)
       put(['status] (pails/t "failed"))
       put(['err] (pails/t err))
+  root
  +  card
    '  A reserved-root card: just the convention's lore
    '  (shrine-apps.md section 7 — each writable root says what it
    '  is from inside the namespace).
    \  head=text
    ^  myth
    (lore/put myth/new 1 head [head] [])
