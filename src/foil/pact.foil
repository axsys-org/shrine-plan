-  lain
'  pact: the application kit — the vocabulary an application uses to
'  describe itself to the namespace (doc/shrine-apps.md section 5).
'  This phase carries only the lore pail; the manifest types (kdecl,
'  mani, pact_form) arrive with the mount pipeline.
+  lore
  '  Structured documentation as a value: the one-line head, the body
  '  lines, and the doctests as source/expected pairs.
  :  head=nat body=row[nat] tests=row[[src=nat want=nat]]
+  put_lore
  '  Put lore at ['lore] when present (lo truthy) — the components
  '  build the pail.  Absent lore leaves the myth untouched.
  \  t=myth lo=nat lh=nat lb=row[nat] lt=row[[src=nat want=nat]]
  ^  myth
  ?  lo
     t.put(['lore] (lore lh lb lt))
  t
