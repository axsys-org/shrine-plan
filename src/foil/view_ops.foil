- shrine_types
- reference_index
- bond
- lain_types

' Pure namespace operators. These define views in Foil; the evaluator knows
' only named reads, observations, and grafts, never relationship vocabulary.
+ view_ops
  + input
    \ context=myth
    ^ maybe[safe]
    ?> (./some value) context.get(bond/tack) .none
    ?> source=safe value .none
    | ./some source

  + at
    ' Appending to a pinned input must select within THAT care's snapshot,
    ' not reuse its local case number as a case of a different child.
    \ source=safe relative=path cr=care
    ^ safe
    ? (eq source.ver 0) (safe 0 cr source.path.weld(relative))
    = prefix=path ['h (care/seg source.care) ($u source.ver) ($u source.path.len)]
    | safe 0 cr prefix.weld(source.path).weld(relative)

  + children
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | ./graft (view_ops/at source relative cr)

  + outline
    ' Ask for names without evaluating a collection's placed records.
    ' These are navigation handles, not evidence that their contents were
    ' inspected or that the collection covers every possible result.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = requested (view_ops/at source relative cr)
    | ./need (view_read requested .names)
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (./fail "structure unavailable")
      = output
          | tree.tap.fold (axal/new[myth] .none)
            \ out [name ignored]
            | out.put name (myth/sing ['sys 'view 'origin]
              (view_ops/at source relative.weld(name) .x))
      | ./done output

  + follow
    ' /slot chooses a reference slot. Navigation then belongs to its target.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    = slot=path
        ?> (./some held) context.get(['slot]) []
        ?> value=pails/p held []
        value.p
    | ./need (view_read (view_ops/at source [] .x) (view_select/slots [slot]))
      \ answer=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) answer (./fail "input not found")
      ?> (./some record) tree.fil (./fail "input has no record")
      ?> (./some held) record.get(slot) (./fail "reference slot not found")
      ?> target=safe held (./fail "slot is not a reference")
      | ./graft (view_ops/at target relative cr)

  + referencing
    ' Reverse reads are ordinary addresses; an epoch-pinned reader supplies
    ' the matching historical edge index. The returned edges retain safes.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | ./graft (safe 0 cr (r_spell source.path).weld(relative))

  + collection
    ' Members are placements, not copies. A selected branch reads only its
    ' matching member. Labels may contain several path segments.
    \ members=axal[safe] cr=care relative=path select=view_select
    ^ view_plan
    = placement=maybe[[safe path]]
        % width=nat relative.len
        ^ maybe[[safe path]]
        ? (members.get(relative.take(width)))
         > (./some source) (./some [source relative.drop(width)])
        ? (eq width 0) .none
        | _ width.dec
    ? placement
     > (./some found)
       = [source tail] found
       | ./graft (view_ops/at source tail cr)
    = branch members.dip(relative)
      base (axal/new[myth] (./some myth/new))
    ? (and (eq branch.kid.size 0) !(maybe/is_some branch.fil)) (./fail "missing branch")
    ? (equal[care] cr .x) (./done base)
    = entries branch.tap
    ? (equal[view_select] select .names)
      | ./done
        | entries.fold base
          \ out [name source]
          | out.put name myth/new
    % i=nat 0 result=axal[myth] base
    ^ view_plan
    ? (eq i entries.len) (./done result)
    = [name source] entries.at(i)
      read_care=care
        ? (equal[care] cr .y) .x
        .z
      ref (view_ops/at source [] read_care)
      resume (_ i.inc)
    | ./need (view_read ref select)
      \ value=res[axal[myth]]
      ^ view_plan
      = unresolved
          | myth/sing ['sys 'view 'origin] ref
        status=iota
          ? value
           > .null 'absent
          | 'unresolved
        placeholder unresolved.put(['sys 'view 'state] (pails/q status))
      ?> (./known tree) value (resume result.put(name placeholder))
      = tree
          ?> (./some record) tree.fil tree
          | tree.put [] record.put(['sys 'view 'origin] ref)
        merged
          | tree.tap.fold result
            \ out [suffix record]
            | out.put name.weld(suffix) record
      | resume merged

  + gather
    ' Every user reference slot is a named placement. Function and tack are
    ' configuration, not members. No identity judgment is inferred here.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    = members
        | context.tap.fold (axal/new[safe] .none)
          \ out [slot held]
          ? ((equal[path] slot bond/weft) || (equal[path] slot bond/tack)) out
          ?> source=safe held out
          | out.put slot source
    | view_ops/collection members cr relative select

  + count
    ' Count the frontier without observing its literal slots.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ? (gt relative.len 0) (./fail "missing branch")
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | ./need (view_read (view_ops/at source [] .y) .names)
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (./fail "input not found")
      = number (sub tree.tap.len (maybe/is_some tree.fil))
      | ./done (axal/new[myth] (./some (myth/sing ['count] (pails/n number))))

  + compose
    ' Explicit /world/<key> bindings introduce local fixture roots today.
    ' Encountering a key in the requested path adds that root at the SAME
    ' locality. No identifier is interpreted as a network mount by the kernel.
    ' Union is structural. Equal names do not assert that entities are equal.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    = bindings=uon[safe]
        | context.tap.fold (uon/empty)
          \ out [slot held]
          ? !(eq slot.len 2) out
          ? !(eq_iota slot.at(0) 'world) out
          ?> source=safe held out
          | out.put slot.at(1) source
      initial=row[safe]
        ?> (./some source) (view_ops/input context) []
        [source]
      empty=path []
      parsed
        | relative.fold [initial empty]
          \ acc segment
          = [worlds locality] acc
          ? (bindings.get(segment))
           > (./some source)
             ? (worlds.any((\ other (equal[safe] other source)))) acc
             [worlds.snoc(source) locality]
          [worlds locality.snoc(segment)]
      [worlds locality] parsed
    ? (eq worlds.len 0) (./fail "no world selected")
    % i=nat 0 collected=axal[row[[safe myth]]] (axal/new[row[[safe myth]]] .none)
    ^ view_plan
    ? (eq i worlds.len)
      = output
          | collected.run
            \ rows=row[[safe myth]]
            ^ myth
            = origins (rows.map((\ [source record] source)))
              empty=mop[path row[view_contribution] lt_pith] (mop/empty)
              slots
                | rows.fold empty
                  \ out [source record]
                  | record.tap.fold out
                    \ out [slot value]
                    | out.put slot (out.get(slot)).fall([]).snoc((view_contribution source value))
              record
                | slots.tap.fold myth/new
                  \ out [slot values]
                  = first values.at(0).value
                    same (values.all((\ contribution (equal[pail] contribution.value first))))
                    held=pail
                      ? same first
                      (view_alternatives values)
                  | out.put slot held
            | record.put ['sys 'view 'origins] (view_origins origins)
      ? (eq output.tap.len 0) (./fail "matching locality is absent")
      | ./done output
    = root worlds.at(i)
      ref (view_ops/at root locality cr)
      resume (_ i.inc)
    | ./need (view_read ref select)
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (resume collected)
      = next
          | tree.tap.fold collected
            \ out [at record]
            = origin (view_ops/at root locality.weld(at) .x)
            | out.put at (out.get(at)).fall([]).snoc([origin record])
      | resume next
