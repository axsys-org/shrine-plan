+  map
  '  A search tree keyed by any k, ordered by a compile-time constant
  '  comparison function: map[k lt].  The ordering is declared once
  '  and never passed at runtime.
  (@@ k lt={k; k; nat})
  +  empty
    :
  +  node
    :  key=k val=nat l=map[k lt] r=map[k lt]
  &  map/empty
     map/node[k lt]
  +  insert
    \  key=k val=nat x=map[k lt]
    ^  map[k lt]
    ?  x
     > map/empty  (map/node[k lt] key val (map/empty) (map/empty))
     > n=map/node[k lt]
       ?  (lt key n.key)
          (map/node[k lt] n.key n.val (_ key val n.l) n.r)
       ?  (lt n.key key)
          (map/node[k lt] n.key n.val n.l (_ key val n.r))
       (map/node[k lt] key val n.l n.r)
  +  get
    \  key=k def=nat x=map[k lt]
    ^  nat
    ?  x
     > map/empty  def
     > n=map/node[k lt]
       ?  (lt key n.key)
          (_ key def n.l)
       ?  (lt n.key key)
          (_ key def n.r)
       n.val
+  mapuse
  '  ?=  ((mapuse) 20)
  ^  nat
  = > m0 (map/empty)
  = > m1 (map/insert[nat lt] 1 10 m0)
  = > m2 (map/insert[nat lt] 2 20 m1)
  (map/get[nat lt] 2 0 m2)
+  mapuse_gt
  ^  nat
  = > m0 (map/empty)
  = > m1 (map/insert[nat gt] 1 10 m0)
  = > m2 (map/insert[nat gt] 2 20 m1)
  (map/get[nat gt] 2 0 m2)
+  mapmeth
  ^  nat
  = > m0 (map/empty)
  = > m1 (map/insert[nat lt] 5 50 m0)
  = > m2 (m1.insert(6 60))
  (m2.get(6 0))
