  +  insert
    !  v
    \  k=iota val=v  tr=bet[v]
    ^  bet[v]
    ?
  +  got
  !  v
  \  want=iota  tr=bet[v]
  +  new
  \  a=nat b=nat
  ^  nat
  %  (if (eq a 0) b)
  (~ (dec a) (inc b))
+  point
  $  [x=nat y=nat]
  +  add
    \  l=point r=point
    (point (add l.x r.x) (add l.y r.y))
+  circle
  $  [center=point radius=nat]
  +  area
   \  c=circle
   ^  nat
   (mul 3 (mul c.radius c.radius))
+  geometry
  &  circle
     point
  +  area
   \  g=geometry
   ^  nat
   ?  g
    > point 0
    > c=circle c.area
+  fst
  (point 3 4)
+  snd
  (point 5 7)
+  geo
  ^  geometry
  fst
+  getx
  fst.x
+  same_as_getx
  (point/x fst)
+  maybe_nat
  &  ($some nat)
     $none
+  test_maybe_nat
  ^  maybe_nat
  ($some 3)
+  or_default
  \  default=nat x=maybe_nat
  ^  nat
  ?  x
   > ($some a=nat) a
   > $none  default
+  maybe_nat_map
  \  fun={nat; nat} x=maybe_nat
  ^  nat
  ?  x
   > ($some a=nat) a
   > $none         x
+  test_maybe_inc
  (maybe_nat_map inc test_maybe_nat)
