') axal.foil is ASPIRATIONAL: it exercises planned syntax (letrec |/=,
') UFCS update .%/idx!, per-declaration type variables !) that the
') elaborator does not implement yet.  See doc/foil-semantics.md,
') "Spec vs implementation".
+  t  10
+  bet
  !  v
  :  keys=row[iota] vals=row[v] kids=row[bet[v]] leaf=bool
  +  lower_bound
    !  v
    \  want=iota tr=bet[v]
    ^  nat
    |  lo=0 hi=tr.keys.len
    ?  (gte lo hi)
      lo
    = > mid (rsh (add lo hi) 1)
    ?  tr.keys.idx!(mid).lt(want)
      (~ mid.inc hi)
    (~ lo mid)
  +  get
    !  v
    \  want=iota  tr=bet[v]
    ^  unit[v]
    = > i  tr.lower_bound(want)
    ?  tr.keys.idx(i)
      > ($some want) @ i.lt(tr.keys.len)  tr.vals.idx(i)
    ?  tr.leaf
      $none
    (~ tr.idx!(i))
  +  split_child
    !  v
    \  i=nat par=bet[v]
    ^  bet[v]
    = > full       par.kids.idx!(i)
      > mid_key    full.keys.idx!(t.sub(1))
      > mid_val    full.vals.idx!(t.sub(1))
      > new_kids   ? full.leaf
                     0
                   full.kids.take(t)
      > new        %  bet[v]
                     full.keys.from(t)
                     full.vals.from(t)
                     new_kids
                     full.leaf
      > full_kids  ?  full.leaf
                     full.kids
                   full.kids.from(t)
      > full1      full.keys%((row/take t.dec))
                       .vals%((row/take t.dec))
                       .kids#(full_kids)
    par.keys%((row/snap i mid_key))
          .vals%((row/snap i mid_val))
          .kids%((row/snap i.inc new))
          .leaf#(false)

