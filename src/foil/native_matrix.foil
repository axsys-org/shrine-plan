- shrine_types

' Ordinary typed value operations. A position is inside a value, not a new NS
' record. Image, simulation and grid definitions can share this same library.
+ native_matrix
  + value
    (@@ element)
    : width=nat height=nat cells=row[element]
  + position
    : x=nat y=nat width=nat height=nat
  + valid
    (@ element)
    \ value=native_matrix/value[element]
    ^ bool
    | eq value.cells.len (mul value.width value.height)
  + contains
    (@ element)
    \ value=native_matrix/value[element] x=nat y=nat
    ^ bool
    | and (lt x value.width) (lt y value.height)
  + read
    (@ element)
    \ value=native_matrix/value[element] x=nat y=nat
    ^ maybe[element]
    ? !(native_matrix/valid value) .none
    ? !(native_matrix/contains value x y) .none
    | ./some value.cells.at((add (mul y value.width) x))
  + write
    (@ element)
    \ value=native_matrix/value[element] position=native_matrix/position replacement=element
    ^ either[str native_matrix/value[element]]
    ? !(native_matrix/valid value) (./err "Matrix shape is inconsistent.")
    ? !(and (eq value.width position.width) (eq value.height position.height)) (./err "The selected matrix shape changed.")
    ? !(native_matrix/contains value position.x position.y) (./err "Position is outside the matrix.")
    = i (add (mul position.y value.width) position.x)
    | ./ok value.set_cells(value.cells.take(i).snoc(replacement).weld(value.cells.drop(i.inc)))
  + region
    (@ element)
    \ value=native_matrix/value[element] x=nat y=nat width=nat height=nat
    ^ either[str native_matrix/value[element]]
    ? !(native_matrix/valid value) (./err "Matrix shape is inconsistent.")
    ? ((gt (add x width) value.width) || (gt (add y height) value.height)) (./err "Region is outside the matrix.")
    = cells
        | (row/range 0 height).bind
        \ row
        | value.cells.drop((add (mul (add y row) value.width) x)).take(width)
    | ./ok (native_matrix/value width height cells)
  + map
    (@ a b)
    \ transform={\ a}b value=native_matrix/value[a]
    ^ native_matrix/value[b]
    | native_matrix/value value.width value.height value.cells.map(transform)
  + generate
    (@ element)
    \ width=nat height=nat generator={\ nat nat}element
    ^ native_matrix/value[element]
    | native_matrix/value width height
      ((row/range 0 height).bind((\ y (row/range 0 width).map((\ x (generator x y))))))
  + transpose
    (@ element)
    \ value=native_matrix/value[element]
    ^ either[str native_matrix/value[element]]
    ? !(native_matrix/valid value) (./err "Matrix shape is inconsistent.")
    | ./ok (native_matrix/generate value.height value.width
      (\ x y (value.cells.at((add (mul x value.width) y)))))
  + segment
    \ start=[nat nat] end=[nat nat]
    ^ row[[nat nat]]
    = [x0 y0] start
      [x1 y1] end
      dx (? (gt x0 x1) (sub x0 x1) (sub x1 x0))
      dy (? (gt y0 y1) (sub y0 y1) (sub y1 y0))
      steps (? (gt dx dy) dx dy)
    ? (eq steps 0) [start]
    | (row/range 0 steps.inc).map
      \ i
      [(div (add (mul x0 (sub steps i)) (mul x1 i)) steps)
       (div (add (mul y0 (sub steps i)) (mul y1 i)) steps)]
  + paint
    (@ element)
    \ value=native_matrix/value[element] points=row[[nat nat]] ink=element
    ^ either[str native_matrix/value[element]]
    ? !(native_matrix/valid value) (./err "Matrix shape is inconsistent.")
    ? (eq points.len 0) (./err "No matrix positions were supplied.")
    ? !(points.all((\ [x y] (native_matrix/contains value x y)))) (./err "Stroke leaves the matrix.")
    = positions=mop[nat bool lt]
        | (row/range 0 points.len).fold (mop/empty)
        \ positions i
        = start points.at((? (eq i 0) 0 i.dec))
        | (native_matrix/segment start points.at(i)).fold positions
          \ positions [x y]
          | positions.put (add (mul y value.width) x) .true
    | ./ok (native_matrix/generate value.width value.height
      (\ x y (? positions.has((add (mul y value.width) x)) ink value.cells.at((add (mul y value.width) x)))))
