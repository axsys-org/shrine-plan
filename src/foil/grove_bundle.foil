- publisher_vocabulary
- sys/types

' Stored compiler metadata shared by Grove linking and synthesis.
+ grove_backend
  + entry
    : key=path value=any signature=type kind=str
  + bundle
    : version=nat identity=path prefix=path
      exports=mop[path grove_backend/entry lt_pith] artifact=any
  + module_slot
    ^ path
    publisher_vocabulary/grove/module
  + version
    ^ nat
    3
