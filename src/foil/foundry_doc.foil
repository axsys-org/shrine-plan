-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  semidoc [order=70]
-  tmpl [order=80]
-  foundry [order=90]
'  foundry_doc: pure Semidoc authoring for the Foundry corpus.
'
'  Documents describe durable authoring data, never an admitted projection.
'  The compiler recognizes four forms: token layers, Zoo recipes, catalogs,
'  and renderer-neutral Surface DAG templates.  Named Semidoc documents are
'  addressed node definitions; their contextual nesting becomes ordered
'  edges.  A Semidoc ;/reference child is an edge to an existing definition,
'  so sharing survives instead of being expanded into copied subtrees.
'
'  Native operations remain inert canonical references.  This module does
'  not execute them, mount anything, render HTML, or grant authority.
+  foundry_doc
  +  diagnostic
    :  field=path code=iota message=nat

  +  layer
    :  name=path values=myth guarded=bool

  +  slot_contract
    '  Authored participation contract for one Slot definition.  accepts
    '  names renderer-neutral Surface kinds; fallback is a semantic recipe
    '  reference, never renderer-local content or an escape hatch.
    :  accepts=row[iota]
       cardinality=iota
       required=bool
       fallback=maybe[path]
       participation=path

  +  surface_node
    '  One addressed definition in a surface template.  Slots, holes,
    '  fallbacks, sources, and external templates are typed references.
    :  address=path
       kind=iota
       role=path
       slot=maybe[path]
       hole=maybe[path]
       fallback=maybe[path]
       source=maybe[path]
       action=maybe[path]
       destination=maybe[path]
       template=maybe[path]
       text=maybe[nat]
       contract=maybe[foundry_doc/slot_contract]

  +  surface_edge
    '  Context belongs to the edge, not the shared node.  Placement is an
    '  explicit /surface/place reference or the child's ordinal path.
    :  parent=path placement=path child=path

  +  surface
    '  A semantic tree-shaped DAG.  root names the entry definition; nodes
    '  are unique definitions and edges preserve ordered contextual use.
    :  name=path
       root=path
       nodes=row[foundry_doc/surface_node]
       edges=row[foundry_doc/surface_edge]

  +  recipe
    '  Pure Zoo/Foundry selection metadata plus an optional inline template.
    '  native and template are references only; compilation executes neither.
    '  The optional lens fields pair the forward overlay with the stateful
    '  subject that receives an amendment.  The subject resolves its own kook;
    '  Foundry never names or invokes the behavior form directly.  Complement
    '  evidence, semantic amendment roles, and capabilities describe a lawful
    '  amendment surface without granting authority or making every terminal
    '  pronunciation reversible.
    :  name=path
       role=path
       input=iota
       output_role=maybe[path]
       output_kind=iota
       primitive=iota
       ceiling=iota
       fallbacks=row[path]
       fallback_class=maybe[iota]
       backend=iota
       pronunciation=path
       features=row[path]
       native=maybe[path]
       subject=maybe[path]
       complement=maybe[path]
       amends=row[path]
       capabilities=row[path]
       template=maybe[path]
       inline=maybe[foundry_doc/surface]

  +  surface_recipe
    '  One admitted Recipe paired with the renderer-neutral Surface it can
    '  actually materialize.  Existence of a recipe definition alone is not
    '  availability: corpus admission constructs this product only from an
    '  inline Surface or an admitted /recipe/template Surface.
    :  recipe=foundry_doc/recipe
       surface=foundry_doc/surface

  +  catalog
    '  A catalog can be selected from a ProjectionRequest without a route
    '  naming it.  Recipe and layer references retain declaration order.
    :  name=path
       source=maybe[path]
       source_role=path
       target_role=path
       ceiling=iota
       recipes=row[path]
       layers=row[path]
       terminal_role=maybe[path]

  +  document
    &  foundry_doc/document/layer
       foundry_doc/document/recipe
       foundry_doc/document/catalog
       foundry_doc/document/surface

    +  layer
      :  value=foundry_doc/layer
    +  recipe
      :  value=foundry_doc/recipe
    +  catalog
      :  value=foundry_doc/catalog
    +  surface
      :  value=foundry_doc/surface

  +  compilation
    '  Exactly one side is populated: one typed authoring document, or a
    '  stable diagnostic row.  Source location is deliberately absent.
    :  value=maybe[foundry_doc/document]
       diagnostics=row[foundry_doc/diagnostic]

  +  field
    :  found=bool vals=row[sval] diagnostics=row[foundry_doc/diagnostic]
  +  text_read
    :  value=maybe[nat] diagnostics=row[foundry_doc/diagnostic]
  +  kinds_read
    :  values=row[iota] diagnostics=row[foundry_doc/diagnostic]
  +  slot_read
    :  value=maybe[foundry_doc/slot_contract]
       diagnostics=row[foundry_doc/diagnostic]
  +  path_read
    :  value=maybe[path] diagnostics=row[foundry_doc/diagnostic]
  +  paths_read
    :  values=row[path] diagnostics=row[foundry_doc/diagnostic]
  +  value_scan
    :  values=myth diagnostics=row[foundry_doc/diagnostic]
  +  node_read
    :  value=maybe[foundry_doc/surface_node]
       placement=maybe[path]
       diagnostics=row[foundry_doc/diagnostic]
  +  surface_scan
    :  nodes=row[foundry_doc/surface_node]
       edges=row[foundry_doc/surface_edge]
       diagnostics=row[foundry_doc/diagnostic]
  +  surface_result
    :  value=maybe[foundry_doc/surface]
       diagnostics=row[foundry_doc/diagnostic]

  +  issue
    \  field=path code=iota message=nat
    ^  foundry_doc/diagnostic
    (foundry_doc/diagnostic field code message)

  +  failed
    \  ds=row[foundry_doc/diagnostic]
    ^  foundry_doc/compilation
    (foundry_doc/compilation .none ds)

  +  one_failed
    \  d=foundry_doc/diagnostic
    ^  foundry_doc/compilation
    (foundry_doc/failed [d])

  +  field_at
    '  Read one canonical predicate and reject duplicate declarations.
    \  pred=row[nat] as=row[sattr]
    ^  foundry_doc/field
    |  > i=nat 0  > hits=row[sattr] []
    ^  foundry_doc/field
    ?  (ge i as.len)
       ?  (eq 0 hits.len)
          (foundry_doc/field .false [] [])
       ?  (gt hits.len 1)
          (foundry_doc/field .true hits.at(0).vals
            [(foundry_doc/issue (seg_iotas pred) 'field_collision
               "a semantic field may be declared only once")])
       (foundry_doc/field .true hits.at(0).vals [])
    =  a  as.at(i)
    ?  (eq_rowcord pred a.pred)
       (_ i.inc hits.snoc(a))
    (_ i.inc hits)

  +  word_at
    \  pred=row[nat] required=bool as=row[sattr]
    ^  foundry_doc/text_read
    =  f  (foundry_doc/field_at pred as)
       at (seg_iotas pred)
    ?  (gt f.diagnostics.len 0)
       (foundry_doc/text_read .none f.diagnostics)
    ?  !(f.found)
       ?  required
          (foundry_doc/text_read .none
            [(foundry_doc/issue at 'field_required
               "required semantic word is missing")])
       (foundry_doc/text_read .none [])
    ?  !(eq 1 f.vals.len)
       (foundry_doc/text_read .none
         [(foundry_doc/issue at 'field_arity
            "semantic word fields take exactly one value")])
    ?  f.vals.at(0)
     > (./word t)  (foundry_doc/text_read (./some t) [])
     > (./ref _)
       (foundry_doc/text_read .none
         [(foundry_doc/issue at 'field_ill_typed
            "this field must be a Semidoc word")])

  +  ref_at
    \  pred=row[nat] required=bool as=row[sattr]
    ^  foundry_doc/path_read
    =  f  (foundry_doc/field_at pred as)
       at (seg_iotas pred)
    ?  (gt f.diagnostics.len 0)
       (foundry_doc/path_read .none f.diagnostics)
    ?  !(f.found)
       ?  required
          (foundry_doc/path_read .none
            [(foundry_doc/issue at 'field_required
               "required semantic reference is missing")])
       (foundry_doc/path_read .none [])
    ?  !(eq 1 f.vals.len)
       (foundry_doc/path_read .none
         [(foundry_doc/issue at 'field_arity
            "semantic reference fields take exactly one value")])
    ?  f.vals.at(0)
     > (./ref p)
       ?  (eq 0 p.len)
          (foundry_doc/path_read .none
            [(foundry_doc/issue at 'field_invalid
               "semantic references cannot be empty")])
       (foundry_doc/path_read (./some (seg_iotas p)) [])
     > (./word _)
       (foundry_doc/path_read .none
         [(foundry_doc/issue at 'field_ill_typed
            "this field must be a canonical ;/reference")])

  +  refs_at
    '  Preserve declaration order for features, fallbacks, recipes, layers.
    \  pred=row[nat] required=bool as=row[sattr]
    ^  foundry_doc/paths_read
    =  f  (foundry_doc/field_at pred as)
       at (seg_iotas pred)
    ?  (gt f.diagnostics.len 0)
       (foundry_doc/paths_read [] f.diagnostics)
    ?  !(f.found)
       ?  required
          (foundry_doc/paths_read []
            [(foundry_doc/issue at 'field_required
               "required semantic reference list is missing")])
       (foundry_doc/paths_read [] [])
    ?  (eq 0 f.vals.len)
       ?  required
          (foundry_doc/paths_read []
            [(foundry_doc/issue at 'field_required
               "semantic reference list cannot be empty")])
       (foundry_doc/paths_read [] [])
    |  > i=nat 0  > out=row[path] []  > ds=row[foundry_doc/diagnostic] []
    ^  foundry_doc/paths_read
    ?  (ge i f.vals.len)
       (foundry_doc/paths_read out ds)
    ?  f.vals.at(i)
     > (./ref p)
       ?  (eq 0 p.len)
          (_ i.inc out ds.snoc((foundry_doc/issue at 'field_invalid
             "semantic references cannot be empty")))
       (_ i.inc out.snoc((seg_iotas p)) ds)
     > (./word _)
       (_ i.inc out ds.snoc((foundry_doc/issue at 'field_ill_typed
          "every list member must be a canonical ;/reference")))

  +  required_path
    '  Open a validated required reference after diagnostics are checked.
    \  r=foundry_doc/path_read
    ^  path
    ?  r.value
     > (./some p)  p
     > .none  []

  +  required_word
    \  r=foundry_doc/text_read
    ^  nat
    ?  r.value
     > (./some t)  t
     > .none  0

  +  token_slot
    \  slot=path
    ^  bool
    ?  (lt slot.len 2)
       .false
    (eq_iota slot.at(0) 'token)

  +  values
    '  Collect /token/... pails without interpreting them.  A Semidoc
    '  reference remains a canonical pails/p value.
    \  t=myth
    ^  foundry_doc/value_scan
    =  es  t.tap
    |  > i=nat 0  > out=myth myth/new
       > ds=row[foundry_doc/diagnostic] []
    ^  foundry_doc/value_scan
    ?  (ge i es.len)
       (foundry_doc/value_scan out ds)
    =  e  es.at(i)
    ?  !(foundry_doc/token_slot e.key)
       (_ i.inc out ds)
    ?  e.val
     > x=pails/t
       ?  (eq 0 x.t)
          (_ i.inc out ds.snoc((foundry_doc/issue e.key
             'token_value_ill_typed "token words cannot be empty")))
       (_ i.inc out.put(e.key x) ds)
     > x=pails/p
       ?  (eq 0 x.p.len)
          (_ i.inc out ds.snoc((foundry_doc/issue e.key
             'token_value_ill_typed "token references cannot be empty")))
       (_ i.inc out.put(e.key x) ds)
    (_ i.inc out ds.snoc((foundry_doc/issue e.key
       'token_value_ill_typed
       "token values must be a Semidoc word or canonical ;/reference")))

  +  surface_kind
    \  t=nat
    ^  bool
    =  q  ($ts t)
       kinds=row[iota]  ['glyph 'block 'plate 'scene 'slot 'text]
    kinds.any((\ x (eq_iota q x)))

  +  slot_value_kind
    '  Slots accept realized Surface values, never another contract Slot.
    \  k=iota
    ^  bool
    =  kinds=row[iota]  ['glyph 'block 'plate 'scene 'text]
    kinds.any((\ x (eq_iota k x)))

  +  slot_attr
    \  a=sattr
    ^  bool
    (if (gt a.pred.len 0) (eq a.pred.at(0) "slot") .false)

  +  slot_field_known
    \  pred=row[nat]
    ^  bool
    ?  (eq_rowcord pred ["slot" "accepts"])  .true
    ?  (eq_rowcord pred ["slot" "cardinality"])  .true
    ?  (eq_rowcord pred ["slot" "required"])  .true
    ?  (eq_rowcord pred ["slot" "fallback"])  .true
    (eq_rowcord pred ["slot" "participation"])

  +  slot_unknowns
    \  as=row[sattr]
    ^  row[foundry_doc/diagnostic]
    |  > i=nat 0  > out=row[foundry_doc/diagnostic] []
    ^  row[foundry_doc/diagnostic]
    ?  (ge i as.len)  out
    =  a as.at(i)
    ?  (if (foundry_doc/slot_attr a)
          !(foundry_doc/slot_field_known a.pred)
          .false)
       (_ i.inc out.snoc((foundry_doc/issue (seg_iotas a.pred)
          'field_unknown "unknown Slot contract field")))
    (_ i.inc out)

  +  slot_accepts
    \  r=foundry_doc/paths_read
    ^  foundry_doc/kinds_read
    |  > i=nat 0  > out=row[iota] []
       > ds=row[foundry_doc/diagnostic] r.diagnostics
    ^  foundry_doc/kinds_read
    ?  (ge i r.values.len)
       (foundry_doc/kinds_read out ds)
    =  p r.values.at(i)
    ?  !(eq p.len 2)
       (_ i.inc out ds.snoc((foundry_doc/issue ['slot 'accepts]
          'slot_accepts_invalid
          "/slot/accepts members must be /surface/<kind> references")))
    ?  !(eq_iota p.at(0) 'surface)
       (_ i.inc out ds.snoc((foundry_doc/issue ['slot 'accepts]
          'slot_accepts_invalid
          "/slot/accepts members must be /surface/<kind> references")))
    =  k p.at(1)
    ?  !(foundry_doc/slot_value_kind k)
       (_ i.inc out ds.snoc((foundry_doc/issue ['slot 'accepts]
          'slot_accepts_invalid
          "Slots accept glyph, block, plate, scene, or text values")))
    ?  out.any((\ prior (eq_iota prior k)))
       (_ i.inc out ds.snoc((foundry_doc/issue ['slot 'accepts]
          'slot_accepts_duplicate
          "a Slot may name each accepted Surface kind once")))
    (_ i.inc out.snoc(k) ds)

  +  slot_contract_of
    \  kind=iota as=row[sattr]
    ^  foundry_doc/slot_read
    =  opted  as.any((\ a (foundry_doc/slot_attr a)))
    ?  !opted
       (foundry_doc/slot_read .none [])
    ?  !(eq_iota kind 'slot)
       (foundry_doc/slot_read .none
         [(foundry_doc/issue ['slot] 'slot_contract_non_slot
            "/slot fields are valid only on /surface/kind slot")])
    =  accepts  (foundry_doc/slot_accepts
                   (foundry_doc/refs_at ["slot" "accepts"] .true as))
       cardinality (foundry_doc/word_at ["slot" "cardinality"] .true as)
       required (foundry_doc/word_at ["slot" "required"] .true as)
       fallback (foundry_doc/ref_at ["slot" "fallback"] .false as)
       participation
         (foundry_doc/ref_at ["slot" "participation"] .true as)
       d0 accepts.diagnostics.weld(cardinality.diagnostics)
       d1 d0.weld(required.diagnostics)
       d2 d1.weld(fallback.diagnostics)
       d3 d2.weld(participation.diagnostics)
       ds d3.weld((foundry_doc/slot_unknowns as))
       card (foundry_doc/required_word cardinality)
       req  (foundry_doc/required_word required)
       ds2
         ?  (gt ds.len 0)  ds
         ?  (eq card "one")  ds
         ?  (eq card "many")  ds
         ds.snoc((foundry_doc/issue ['slot 'cardinality] 'field_invalid
           "/slot/cardinality must be one or many"))
       ds3
         ?  (gt ds2.len 0)  ds2
         ?  (eq req "true")  ds2
         ?  (eq req "false")  ds2
         ds2.snoc((foundry_doc/issue ['slot 'required] 'field_invalid
           "/slot/required must be true or false"))
    ?  (gt ds3.len 0)
       (foundry_doc/slot_read .none ds3)
    (foundry_doc/slot_read
      (./some (foundry_doc/slot_contract accepts.values ($ts card)
        (eq req "true") fallback.value
        (foundry_doc/required_path participation))) [])

  +  ceiling_kind
    \  t=nat
    ^  bool
    =  q  ($ts t)
       kinds=row[iota]  ['glyph 'block 'plate 'scene 'stage]
    kinds.any((\ x (eq_iota q x)))

  +  primitive_kind
    \  t=nat
    ^  bool
    =  q  ($ts t)
       kinds=row[iota]  ['dyed 'knit 'felt 'sewn]
    kinds.any((\ x (eq_iota q x)))

  +  action_diagnostics
    '  A Surface may name semantic interaction declarations, but cannot
    '  manufacture their subjects, capabilities, or terminal spellings.
    \  kind=iota binding=maybe[path]
    ^  row[foundry_doc/diagnostic]
    ?  binding
     > .none  []
     > (./some _)
       ?  (eq_iota kind 'block)  []
       [(foundry_doc/issue ['surface 'action]
         'action_reference_non_block
         "Action references are valid only on Blocks")]

  +  destination_diagnostics
    '  Navigation and mutation remain independent bindings and may coexist.
    \  kind=iota binding=maybe[path]
    ^  row[foundry_doc/diagnostic]
    ?  binding
     > .none  []
     > (./some _)
       ?  (eq_iota kind 'block)  []
       [(foundry_doc/issue ['surface 'destination]
         'destination_non_block
         "navigation destinations are valid only on Blocks")]

  +  node_of
    \  address=path as=row[sattr]
    ^  foundry_doc/node_read
    =  kind  (foundry_doc/word_at ["surface" "kind"] .true as)
       role  (foundry_doc/ref_at ["surface" "role"] .true as)
       slot  (foundry_doc/ref_at ["surface" "slot"] .false as)
       hole  (foundry_doc/ref_at ["surface" "hole"] .false as)
       fallback (foundry_doc/ref_at ["surface" "fallback"] .false as)
       source (foundry_doc/ref_at ["surface" "source"] .false as)
       action (foundry_doc/ref_at ["surface" "action"] .false as)
       destination (foundry_doc/ref_at ["surface" "destination"] .false as)
       template (foundry_doc/ref_at ["surface" "template"] .false as)
       text  (foundry_doc/word_at ["surface" "text"] .false as)
       place (foundry_doc/ref_at ["surface" "place"] .false as)
       contract (foundry_doc/slot_contract_of
                  ($ts (foundry_doc/required_word kind)) as)
       d0  kind.diagnostics.weld(role.diagnostics)
       d1  d0.weld(slot.diagnostics)
       d2  d1.weld(hole.diagnostics)
       d3  d2.weld(fallback.diagnostics)
       d4  d3.weld(source.diagnostics)
       d5  d4.weld(action.diagnostics)
       d6  d5.weld(destination.diagnostics)
       d7  d6.weld(template.diagnostics)
       d8  d7.weld(text.diagnostics)
       d9  d8.weld(place.diagnostics)
       d10 d9.weld(contract.diagnostics)
       kt  (foundry_doc/required_word kind)
       d11
         ?  (gt d10.len 0)  d10
         ?  (foundry_doc/surface_kind kt)  d10
         d10.snoc((foundry_doc/issue ['surface 'kind] 'field_invalid
           "/surface/kind must be glyph, block, plate, scene, slot, or text"))
       ds
         ?  (gt d11.len 0)  d11
         =  ads (foundry_doc/action_diagnostics ($ts kt) action.value)
            dds (foundry_doc/destination_diagnostics
                  ($ts kt) destination.value)
            d12 d11.weld(ads)
         d12.weld(dds)
    ?  (gt ds.len 0)
       (foundry_doc/node_read .none place.value ds)
    (foundry_doc/node_read
      (./some (foundry_doc/surface_node address ($ts kt)
        (foundry_doc/required_path role) slot.value hole.value fallback.value
        source.value action.value destination.value template.value text.value
        contract.value))
      place.value [])

  +  node_known
    \  address=path ns=row[foundry_doc/surface_node]
    ^  bool
    ns.any((\ n (eq_pith address n.address)))

  +  edge_place
    \  explicit=maybe[path] ordinal=nat
    ^  path
    ?  explicit
     > (./some p)  p
     > .none  [($u ordinal)]

  +  walk_surface
    '  Named docs define nodes; refs define sharing edges.  The parent is
    '  contextual, while each node address is stable across placements.
    \  parent=maybe[path] kids=row[snode] scan=foundry_doc/surface_scan
    ^  foundry_doc/surface_scan
    |  > i=nat 0  > out=foundry_doc/surface_scan scan
    ^  foundry_doc/surface_scan
    ?  (ge i kids.len)
       out
    =  nd  kids.at(i)
    ?  nd
     > (./doc id as sub)
       ?  (eq 0 id.len)
          (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
            out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
              'surface_address_required
              "surface node documents need a non-empty address"))))
       =  address  (seg_iotas id)
          nr       (foundry_doc/node_of address as)
          ds0      out.diagnostics.weld(nr.diagnostics)
          duplicate (foundry_doc/node_known address out.nodes)
          ds1
            ?  duplicate
               ds0.snoc((foundry_doc/issue address 'surface_address_collision
                 "two surface node definitions claim the same address"))
            ds0
          ns
            ?  duplicate  out.nodes
            ?  (gt nr.diagnostics.len 0)  out.nodes
            ?  nr.value
             > (./some n)  out.nodes.snoc(n)
             > .none  out.nodes
            out.nodes
          es
            ?  parent
             > (./some p)
               out.edges.snoc((foundry_doc/surface_edge p
                 (foundry_doc/edge_place nr.placement i) address))
             > .none  out.edges
          deeper (foundry_doc/walk_surface (./some address) sub
                   (foundry_doc/surface_scan ns es ds1))
       (_ i.inc deeper)
     > (./ref p as)
       ?  parent
        > .none
          (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
            out.diagnostics.snoc((foundry_doc/issue ['surface 'edges]
              'surface_parent_required
              "a shared surface reference must occur below a node"))))
        > (./some par)
          =  place (foundry_doc/ref_at ["surface" "place"] .false as)
             ds2 out.diagnostics.weld(place.diagnostics)
             edge (foundry_doc/surface_edge par
                    (foundry_doc/edge_place place.value i) (seg_iotas p))
          (_ i.inc (foundry_doc/surface_scan out.nodes out.edges.snoc(edge) ds2))
     > (./sect _ _ _)
       (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
         out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
           'surface_node_ill_typed
           "surface templates contain only named ;. nodes and ;/reference edges"))))
     > (./item _ _ _)
       (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
         out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
           'surface_node_ill_typed
           "surface templates contain only named ;. nodes and ;/reference edges"))))
     > (./quote _ _ _)
       (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
         out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
           'surface_node_ill_typed
           "surface templates contain only named ;. nodes and ;/reference edges"))))
     > (./lit _ _ _)
       (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
         out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
           'surface_node_ill_typed
           "surface templates contain only named ;. nodes and ;/reference edges"))))
     > (./prose _ _)
       (_ i.inc (foundry_doc/surface_scan out.nodes out.edges
         out.diagnostics.snoc((foundry_doc/issue ['surface 'nodes]
           'surface_node_ill_typed
           "surface templates contain only named ;. nodes and ;/reference edges"))))

  +  path_seen
    \  p=path ps=row[path]
    ^  bool
    ps.any((\ q (eq_pith p q)))

  +  reaches
    '  Follow local edges only.  External template references have no
    '  outgoing definition here and therefore cannot create a local cycle.
    \  target=path current=path edges=row[foundry_doc/surface_edge]
       seen=row[path]
    ^  bool
    ?  (eq_pith target current)
       .true
    ?  (foundry_doc/path_seen current seen)
       .false
    |  > i=nat 0  > next_seen=row[path] seen.snoc(current)
    ^  bool
    ?  (ge i edges.len)
       .false
    =  e  edges.at(i)
    ?  !(eq_pith e.parent current)
       (_ i.inc next_seen)
    ?  (foundry_doc/reaches target e.child edges next_seen)
       .true
    (_ i.inc next_seen)

  +  cyclic
    \  edges=row[foundry_doc/surface_edge]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i edges.len)
       .false
    =  e  edges.at(i)
    ?  (foundry_doc/reaches e.parent e.child edges [])
       .true
    (_ i.inc)

  +  surface_of
    \  name=path explicit=foundry_doc/path_read kids=row[snode]
    ^  foundry_doc/surface_result
    =  scan (foundry_doc/walk_surface .none kids
              (foundry_doc/surface_scan [] [] []))
       root
         ?  explicit.value
          > (./some p)  p
          > .none
            ?  (eq 0 scan.nodes.len)
               []
            scan.nodes.at(0).address
       ds0 explicit.diagnostics.weld(scan.diagnostics)
       ds1
         ?  (eq 0 root.len)
            ds0.snoc((foundry_doc/issue ['surface 'root]
              'surface_root_required
              "a surface template needs a root node or /surface/root"))
         ds0
       ds2
         ?  (eq 0 root.len)  ds1
         ?  (foundry_doc/node_known root scan.nodes)  ds1
         ds1.snoc((foundry_doc/issue ['surface 'root]
           'surface_root_missing
           "the surface root must name a local node definition"))
       ds3
         ?  (foundry_doc/cyclic scan.edges)
            ds2.snoc((foundry_doc/issue ['surface 'edges] 'surface_cycle
              "surface references must form a DAG"))
         ds2
    ?  (gt ds3.len 0)
       (foundry_doc/surface_result .none ds3)
    (foundry_doc/surface_result
      (./some (foundry_doc/surface name root scan.nodes scan.edges)) [])

  +  layer_doc
    \  docroot=myth as=row[sattr]
    ^  foundry_doc/compilation
    =  name (foundry_doc/ref_at ["foundry" "name"] .true as)
       guarded (foundry_doc/word_at ["foundry" "guarded"] .true as)
       vals (foundry_doc/values docroot)
       d0 name.diagnostics.weld(guarded.diagnostics)
       ds d0.weld(vals.diagnostics)
       guarded_text (foundry_doc/required_word guarded)
       ds2
         ?  (gt ds.len 0)  ds
         ?  (eq guarded_text "true")  ds
         ?  (eq guarded_text "false")  ds
         ds.snoc((foundry_doc/issue ['foundry 'guarded] 'field_invalid
           "/foundry/guarded must be true or false"))
       ds3
         ?  (gt ds2.len 0)  ds2
         ?  (gt vals.values.size 0)  ds2
         ds2.snoc((foundry_doc/issue ['token] 'token_required
           "a Foundry layer needs at least one /token/... attribute"))
    ?  (gt ds3.len 0)
       (foundry_doc/failed ds3)
    (foundry_doc/compilation
      (./some (foundry_doc/document/layer
        (foundry_doc/layer (foundry_doc/required_path name) vals.values
          (eq guarded_text "true")))) [])

  +  recipe_doc
    \  as=row[sattr] kids=row[snode]
    ^  foundry_doc/compilation
    =  name (foundry_doc/ref_at ["foundry" "name"] .true as)
       role (foundry_doc/ref_at ["recipe" "role"] .true as)
       input (foundry_doc/word_at ["recipe" "input"] .true as)
       output_role (foundry_doc/ref_at ["recipe" "output_role"] .false as)
       output_kind (foundry_doc/word_at ["recipe" "output_kind"] .true as)
       primitive (foundry_doc/word_at ["recipe" "primitive"] .true as)
       ceiling (foundry_doc/word_at ["recipe" "ceiling"] .true as)
       fallbacks (foundry_doc/refs_at ["recipe" "fallbacks"] .false as)
       fallback_class (foundry_doc/word_at ["recipe" "fallback_class"] .false as)
       backend (foundry_doc/word_at ["recipe" "backend"] .true as)
       pronunciation (foundry_doc/ref_at ["recipe" "pronunciation"] .true as)
       features (foundry_doc/refs_at ["recipe" "features"] .false as)
       native (foundry_doc/ref_at ["recipe" "native"] .false as)
       subject (foundry_doc/ref_at ["lens" "subject"] .false as)
       legacy_kook (foundry_doc/ref_at ["lens" "kook"] .false as)
       complement (foundry_doc/ref_at ["lens" "complement"] .false as)
       amends (foundry_doc/refs_at ["lens" "amends"] .false as)
       capabilities (foundry_doc/refs_at ["lens" "capabilities"] .false as)
       template (foundry_doc/ref_at ["recipe" "template"] .false as)
       surfroot (foundry_doc/ref_at ["surface" "root"] .false as)
       d0 name.diagnostics.weld(role.diagnostics)
       d1 d0.weld(input.diagnostics)
       d2 d1.weld(output_role.diagnostics)
       d3 d2.weld(output_kind.diagnostics)
       d4 d3.weld(primitive.diagnostics)
       d5 d4.weld(ceiling.diagnostics)
       d6 d5.weld(fallbacks.diagnostics)
       d6a d6.weld(fallback_class.diagnostics)
       d7 d6a.weld(backend.diagnostics)
       d8 d7.weld(pronunciation.diagnostics)
       d9 d8.weld(features.diagnostics)
       d10 d9.weld(native.diagnostics)
       d11a d10.weld(subject.diagnostics)
       d11b d11a.weld(legacy_kook.diagnostics)
       d11
         ?  legacy_kook.value
          > .none  d11b
          > (./some _)
            d11b.snoc((foundry_doc/issue ['lens 'kook] 'field_deprecated
              "use /lens/subject for the stateful amendment recipient"))
       d12 d11.weld(complement.diagnostics)
       d13 d12.weld(amends.diagnostics)
       d14 d13.weld(capabilities.diagnostics)
       ds d14.weld(template.diagnostics)
       okind (foundry_doc/required_word output_kind)
       prim (foundry_doc/required_word primitive)
       ceil (foundry_doc/required_word ceiling)
       fallback_kind=maybe[iota]
         ?  fallback_class.value
          > .none  .none
          > (./some body=nat)  (./some ($ts body))
       ds1
         ?  (gt output_kind.diagnostics.len 0)  ds
         ?  (foundry_doc/surface_kind okind)  ds
         ds.snoc((foundry_doc/issue ['recipe 'output_kind] 'field_invalid
           "recipe output kind is not a Surface kind"))
       ds2
         ?  (gt primitive.diagnostics.len 0)  ds1
         ?  (foundry_doc/primitive_kind prim)  ds1
         ds1.snoc((foundry_doc/issue ['recipe 'primitive] 'field_invalid
           "recipe primitive must be dyed, knit, felt, or sewn"))
       ds3
         ?  (gt ceiling.diagnostics.len 0)  ds2
         ?  (foundry_doc/ceiling_kind ceil)  ds2
         ds2.snoc((foundry_doc/issue ['recipe 'ceiling] 'field_invalid
           "recipe ceiling must be glyph, block, plate, scene, or stage"))
       ds3a
         ?  fallback_kind
          > .none  ds3
          > (./some class=iota)
            ?  (foundry/fallback_class class)  ds3
            ds3.snoc((foundry_doc/issue ['recipe 'fallback_class]
              'field_invalid
              "recipe fallback class must be semantic, structural, renderer, or progressive"))
       sf (foundry_doc/surface_of (foundry_doc/required_path name) surfroot kids)
       has_inline (gt kids.len 0)
       ds4
         ?  has_inline
            ds3a.weld(sf.diagnostics)
         ds3a
       ds5
         ?  has_inline
            ?  template.value
             > (./some _)
               ds4.snoc((foundry_doc/issue ['recipe 'template] 'template_collision
                 "a recipe chooses either an inline DAG or /recipe/template, not both"))
             > .none  ds4
         ds4
    ?  (gt ds5.len 0)
       (foundry_doc/failed ds5)
    =  inline=maybe[foundry_doc/surface]
         ?  has_inline  sf.value
         .none
    (foundry_doc/compilation
      (./some (foundry_doc/document/recipe
        (foundry_doc/recipe (foundry_doc/required_path name)
          (foundry_doc/required_path role) ($ts (foundry_doc/required_word input))
          output_role.value ($ts okind) ($ts prim) ($ts ceil) fallbacks.values
          fallback_kind
          ($ts (foundry_doc/required_word backend))
          (foundry_doc/required_path pronunciation) features.values native.value
          subject.value complement.value amends.values capabilities.values
          template.value inline))) [])

  +  catalog_doc
    \  as=row[sattr]
    ^  foundry_doc/compilation
    =  name (foundry_doc/ref_at ["foundry" "name"] .true as)
       source (foundry_doc/ref_at ["catalog" "source"] .false as)
       source_role (foundry_doc/ref_at ["catalog" "source_role"] .true as)
       target_role (foundry_doc/ref_at ["catalog" "target_role"] .true as)
       ceiling (foundry_doc/word_at ["catalog" "ceiling"] .true as)
       recipes (foundry_doc/refs_at ["catalog" "recipes"] .true as)
       layers (foundry_doc/refs_at ["catalog" "layers"] .false as)
       terminal (foundry_doc/ref_at ["catalog" "terminal_role"] .false as)
       d0 name.diagnostics.weld(source.diagnostics)
       d1 d0.weld(source_role.diagnostics)
       d2 d1.weld(target_role.diagnostics)
       d3 d2.weld(ceiling.diagnostics)
       d4 d3.weld(recipes.diagnostics)
       d5 d4.weld(layers.diagnostics)
       ds d5.weld(terminal.diagnostics)
       ceil (foundry_doc/required_word ceiling)
       ds2
         ?  (gt ceiling.diagnostics.len 0)  ds
         ?  (foundry_doc/ceiling_kind ceil)  ds
         ds.snoc((foundry_doc/issue ['catalog 'ceiling] 'field_invalid
           "catalog ceiling must be glyph, block, plate, scene, or stage"))
    ?  (gt ds2.len 0)
       (foundry_doc/failed ds2)
    (foundry_doc/compilation
      (./some (foundry_doc/document/catalog
        (foundry_doc/catalog (foundry_doc/required_path name) source.value
          (foundry_doc/required_path source_role)
          (foundry_doc/required_path target_role) ($ts ceil) recipes.values
          layers.values terminal.value))) [])

  +  surface_doc
    \  as=row[sattr] kids=row[snode]
    ^  foundry_doc/compilation
    =  name (foundry_doc/ref_at ["foundry" "name"] .true as)
       surfroot (foundry_doc/ref_at ["surface" "root"] .false as)
       sf (foundry_doc/surface_of (foundry_doc/required_path name) surfroot kids)
       ds name.diagnostics.weld(sf.diagnostics)
    ?  (gt ds.len 0)
       (foundry_doc/failed ds)
    =  value
         ?  sf.value
          > (./some x)  x
          > .none  (foundry_doc/surface [] [] [] [])
    (foundry_doc/compilation
      (./some (foundry_doc/document/surface value)) [])

  +  compile_root
    \  docroot=myth as=row[sattr] kids=row[snode]
    ^  foundry_doc/compilation
    =  kind (foundry_doc/word_at ["foundry" "kind"] .true as)
    ?  (gt kind.diagnostics.len 0)
       (foundry_doc/failed kind.diagnostics)
    =  t  (foundry_doc/required_word kind)
    ?  (eq t "layer")
       (foundry_doc/layer_doc docroot as)
    ?  (eq t "recipe")
       (foundry_doc/recipe_doc as kids)
    ?  (eq t "catalog")
       (foundry_doc/catalog_doc as)
    ?  (eq t "surface")
       (foundry_doc/surface_doc as kids)
    (foundry_doc/one_failed
      (foundry_doc/issue ['foundry 'kind] 'field_invalid
        "/foundry/kind must be layer, recipe, catalog, or surface"))

  +  compile
    '  Parse one immutable Semidoc source.  Tmpl supplies the canonical
    '  root record while the parsed node retains contextual DAG edges.
    \  src=nat
    ^  foundry_doc/compilation
    =  ns  (parse src)
    ?  !(eq 1 ns.len)
       (foundry_doc/one_failed
         (foundry_doc/issue [] 'document_required
           "source must contain exactly one top-level document"))
    =  nd  ns.at(0)
    ?  nd
     > (./doc _ as kids)
       =  [root _]  (tmpl/parts ns)
       (foundry_doc/compile_root root as kids)
    (foundry_doc/one_failed
      (foundry_doc/issue [] 'document_required
        "the top-level Semidoc node must be ;."))

  +  layer_of
    \  r=foundry_doc/layer
    ^  foundry/layer
    (foundry/layer r.name r.values r.guarded)

  +  compile_layer
    '  Backward-compatible typed handoff for layer documents only.
    \  src=nat
    ^  maybe[foundry/layer]
    =  out  (foundry_doc/compile src)
    ?  out.value
     > .none  .none
     > (./some d)
       ?  d
        > x=foundry_doc/document/layer
          (./some (foundry_doc/layer_of x.value))
        > foundry_doc/document/recipe  .none
        > foundry_doc/document/catalog  .none
        > foundry_doc/document/surface  .none

  +  maybe_path_put
    \  slot=path p=maybe[path] t=myth
    ^  myth
    ?  p
     > (./some x)  t.put(slot (pails/p x))
     > .none  t

  +  document_record
    '  One mountable metadata record for generic discovery.  Graph nodes and
    '  edges are projected separately by /records so structure is retained.
    \  src=nat d=foundry_doc/document
    ^  myth
    =  base  (myth/new).put(['foundry 'source] (pails/t src))
    ?  d
     > x=foundry_doc/document/layer
       .  base
          put(['foundry 'kind] (pails/t "layer"))
          put(['foundry 'name] (pails/p x.value.name))
          put(['foundry 'guarded] (pails/t (if x.value.guarded "true" "false")))
     > x=foundry_doc/document/recipe
       =  r x.value
          t0 . base
               put(['foundry 'kind] (pails/t "recipe"))
               put(['foundry 'name] (pails/p r.name))
               put(['recipe 'role] (pails/p r.role))
               put(['recipe 'input] (pails/t (iota_show r.input)))
               put(['recipe 'output_kind] (pails/t (iota_show r.output_kind)))
               put(['recipe 'primitive] (pails/t (iota_show r.primitive)))
               put(['recipe 'ceiling] (pails/t (iota_show r.ceiling)))
               put(['recipe 'fallbacks] (pails/ps r.fallbacks))
               put(['recipe 'backend] (pails/t (iota_show r.backend)))
               put(['recipe 'pronunciation] (pails/p r.pronunciation))
               put(['recipe 'features] (pails/ps r.features))
          t0a
            ?  r.fallback_class
             > .none  t0
             > (./some class=iota)
               t0.put(['recipe 'fallback_class] (pails/t (iota_show class)))
          t1 (foundry_doc/maybe_path_put ['recipe 'output_role] r.output_role t0a)
          t2 (foundry_doc/maybe_path_put ['recipe 'native] r.native t1)
          t3 (foundry_doc/maybe_path_put ['lens 'subject] r.subject t2)
          t4 (foundry_doc/maybe_path_put ['lens 'complement] r.complement t3)
          t5 . t4
               put(['lens 'amends] (pails/ps r.amends))
               put(['lens 'capabilities] (pails/ps r.capabilities))
       (foundry_doc/maybe_path_put ['recipe 'template] r.template t5)
     > x=foundry_doc/document/catalog
       =  c x.value
          t0 . base
               put(['foundry 'kind] (pails/t "catalog"))
               put(['foundry 'name] (pails/p c.name))
               put(['catalog 'source_role] (pails/p c.source_role))
               put(['catalog 'target_role] (pails/p c.target_role))
               put(['catalog 'ceiling] (pails/t (iota_show c.ceiling)))
               put(['catalog 'recipes] (pails/ps c.recipes))
               put(['catalog 'layers] (pails/ps c.layers))
          t1 (foundry_doc/maybe_path_put ['catalog 'source] c.source t0)
       (foundry_doc/maybe_path_put ['catalog 'terminal_role] c.terminal_role t1)
     > x=foundry_doc/document/surface
       .  base
          put(['foundry 'kind] (pails/t "surface"))
          put(['foundry 'name] (pails/p x.value.name))
          put(['surface 'root] (pails/p x.value.root))
          put(['surface 'node_count] (pails/n x.value.nodes.len))
          put(['surface 'edge_count] (pails/n x.value.edges.len))

  +  node_record
    \  n=foundry_doc/surface_node
    ^  myth
    =  t0 . (myth/new)
              put(['surface 'address] (pails/p n.address))
              put(['surface 'kind] (pails/t (iota_show n.kind)))
              put(['surface 'role] (pails/p n.role))
       t1 (foundry_doc/maybe_path_put ['surface 'slot] n.slot t0)
       t2 (foundry_doc/maybe_path_put ['surface 'hole] n.hole t1)
       t3 (foundry_doc/maybe_path_put ['surface 'fallback] n.fallback t2)
       t4 (foundry_doc/maybe_path_put ['surface 'source] n.source t3)
       t5 (foundry_doc/maybe_path_put ['surface 'action] n.action t4)
       t6 (foundry_doc/maybe_path_put
            ['surface 'destination] n.destination t5)
       t7 (foundry_doc/maybe_path_put ['surface 'template] n.template t6)
       t8
         ?  n.text
          > (./some body)  t7.put(['surface 'text] (pails/t body))
          > .none  t7
    ?  n.contract
     > .none  t8
     > (./some c=foundry_doc/slot_contract)
       =  accepts  c.accepts.map((\ k ['surface k]))
          t9 . t8
               put(['slot 'accepts] (pails/ps accepts))
               put(['slot 'cardinality]
                 (pails/t (iota_show c.cardinality)))
               put(['slot 'required]
                 (pails/t (if c.required "true" "false")))
               put(['slot 'participation] (pails/p c.participation))
       (foundry_doc/maybe_path_put ['slot 'fallback] c.fallback t9)

  +  edge_record
    \  e=foundry_doc/surface_edge
    ^  myth
    .  (myth/new)
       put(['surface 'parent] (pails/p e.parent))
       put(['surface 'place] (pails/p e.placement))
       put(['surface 'child] (pails/p e.child))

  +  document_surface
    \  d=foundry_doc/document
    ^  maybe[foundry_doc/surface]
    ?  d
     > x=foundry_doc/document/surface  (./some x.value)
     > x=foundry_doc/document/recipe  x.value.inline
     > foundry_doc/document/layer  .none
     > foundry_doc/document/catalog  .none

  +  records
    '  Mountable ordinary namespace data: [] is document metadata,
    '  graph/nodes/<address> are definitions, graph/edges/<ordinal> are
    '  contextual placements.  No constructor or authority rides here.
    \  src=nat d=foundry_doc/document
    ^  row[[p=path t=myth]]
    =  base  [[[] (foundry_doc/document_record src d)]]
    ?  (foundry_doc/document_surface d)
     > .none  base
     > (./some sf)
       =  ns
            |  > i=nat 0  > out=row[[p=path t=myth]] []
            ^  row[[p=path t=myth]]
            ?  (ge i sf.nodes.len)  out
            =  n sf.nodes.at(i)
               base=path  ['graph 'nodes]
            (_ i.inc out.snoc([base.weld(n.address)
              (foundry_doc/node_record n)]))
          es
            |  > i=nat 0  > out=row[[p=path t=myth]] []
            ^  row[[p=path t=myth]]
            ?  (ge i sf.edges.len)  out
            (_ i.inc out.snoc([[ 'graph 'edges ($u i)]
              (foundry_doc/edge_record sf.edges.at(i))]))
       base.weld(ns).weld(es)

  +  compile_records
    \  src=nat
    ^  maybe[row[[p=path t=myth]]]
    =  c (foundry_doc/compile src)
    ?  c.value
     > (./some d)  (./some (foundry_doc/records src d))
     > .none  .none

  +  compile_mount_records
    '  Host-facing absolute seeds.  The document's /foundry/name owns its
    '  durable corpus address; graph records remain ordinary descendants.
    '  The host performs no schema interpretation and grants no authority.
    \  src=nat
    ^  maybe[row[[p=path t=myth]]]
    =  c  (foundry_doc/compile src)
    ?  c.value
     > .none  .none
     > (./some d)
       =  base  (foundry_doc/document_name d)
          rs    (foundry_doc/records src d)
          out
            |  > i=nat 0  > acc=row[[p=path t=myth]] []
            ^  row[[p=path t=myth]]
            ?  (ge i rs.len)
               acc
            =  [at rec]  rs.at(i)
            (_ i.inc acc.snoc([base.weld(at) rec]))
       (./some out)

  '  Stable public accessors for untyped hosts and focused tests.
  +  compilation_value
    \  c=foundry_doc/compilation
    ^  maybe[foundry_doc/document]
    c.value
  +  compilation_diagnostics
    \  c=foundry_doc/compilation
    ^  row[foundry_doc/diagnostic]
    c.diagnostics
  +  document_kind
    \  d=foundry_doc/document
    ^  iota
    ?  d
     > x=foundry_doc/document/layer  'layer
     > x=foundry_doc/document/recipe  'recipe
     > x=foundry_doc/document/catalog  'catalog
     > x=foundry_doc/document/surface  'surface
  +  document_name
    \  d=foundry_doc/document
    ^  path
    ?  d
     > x=foundry_doc/document/layer  x.value.name
     > x=foundry_doc/document/recipe  x.value.name
     > x=foundry_doc/document/catalog  x.value.name
     > x=foundry_doc/document/surface  x.value.name
  +  compilation_kind
    \  c=foundry_doc/compilation
    ^  maybe[iota]
    ?  c.value
     > (./some d)  (./some (foundry_doc/document_kind d))
     > .none  .none
  +  compilation_name
    \  c=foundry_doc/compilation
    ^  maybe[path]
    ?  c.value
     > (./some d)  (./some (foundry_doc/document_name d))
     > .none  .none
  +  document_recipe
    \  d=foundry_doc/document
    ^  maybe[foundry_doc/recipe]
    ?  d
     > x=foundry_doc/document/recipe  (./some x.value)
     > x=foundry_doc/document/layer  .none
     > x=foundry_doc/document/catalog  .none
     > x=foundry_doc/document/surface  .none
  +  document_catalog
    \  d=foundry_doc/document
    ^  maybe[foundry_doc/catalog]
    ?  d
     > x=foundry_doc/document/catalog  (./some x.value)
     > x=foundry_doc/document/layer  .none
     > x=foundry_doc/document/recipe  .none
     > x=foundry_doc/document/surface  .none
  +  document_layer
    \  d=foundry_doc/document
    ^  maybe[foundry_doc/layer]
    ?  d
