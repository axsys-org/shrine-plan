-  sept [order=10]
-  semidoc [order=20]
'  Static Nenex Foundry semantic layers.  This dependency-light unit owns
'  authored source bytes only; admission and page mounting remain in Nenex.
+  nenex_foundry_layers
  +  header_text_style_src
    '  A semantic Header Text Style.  This is a Layer of cohesive text
    '  attributes, not a structural header component; text color remains a
    '  separate semantic role.  The local Semidoc document id deliberately
    '  differs from both its Nenex page path and its stable /foundry/name.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/styles/header_text"
       ";@ /foundry/guarded false"
       ";@ /token/type/header/family ;/token/type/family/interface"
       ";@ /token/type/header/size ;/token/type/scale/header"
       ";@ /token/type/header/weight ;/token/type/weight/semibold"
       ";@ /token/type/header/line_height ;/token/type/line_height/compact"
       ";@ /token/type/header/tracking ;/token/type/tracking/standard"
       ";@ /token/type/header/fallback ;/token/type/body"
       ";. /authoring/foundations/type/header"])
  +  chat_foundation_src
    '  The bounded renderer-neutral vocabulary required by the first Chat
    '  vertical.  Token keys name semantic purpose; values name foundation
    '  roles rather than CSS literals or platform APIs.  This is one cohesive
    '  versioned Layer, not one Nenex page per scalar.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/layers/chat_foundation"
       ";@ /foundry/guarded false"
       ";@ /token/color/text/primary ;/foundation/color/text/primary"
       ";@ /token/color/text/secondary ;/foundation/color/text/secondary"
       ";@ /token/color/text/tertiary ;/foundation/color/text/tertiary"
       ";@ /token/color/text/disabled ;/foundation/color/text/disabled"
       ";@ /token/color/surface/base ;/foundation/color/surface/base"
       ";@ /token/color/surface/raised ;/foundation/color/surface/raised"
       ";@ /token/color/surface/sunken ;/foundation/color/surface/sunken"
       ";@ /token/color/surface/overlay ;/foundation/color/surface/overlay"
       ";@ /token/color/surface/selected ;/foundation/color/surface/selected"
       ";@ /token/color/surface/destructive ;/foundation/color/surface/destructive"
       ";@ /token/color/fill/base ;/foundation/color/fill/base"
       ";@ /token/color/fill/secondary ;/foundation/color/fill/secondary"
       ";@ /token/color/fill/selected ;/foundation/color/fill/selected"
       ";@ /token/color/border/separator ;/foundation/color/border/separator"
       ";@ /token/color/border/strong ;/foundation/color/border/strong"
       ";@ /token/color/border/focus ;/foundation/color/border/focus"
       ";@ /token/color/action/accent ;/foundation/color/action/accent"
       ";@ /token/color/action/positive ;/foundation/color/action/positive"
       ";@ /token/color/action/warning ;/foundation/color/action/warning"
       ";@ /token/color/action/destructive ;/foundation/color/action/destructive"
       ";@ /token/type/body ;/foundation/type/body"
       ";@ /token/type/caption ;/foundation/type/caption"
       ";@ /token/type/label ;/foundation/type/label"
       ";@ /token/type/header ;/foundation/type/header"
       ";@ /token/type/code ;/foundation/type/code"
       ";@ /token/space/related ;/foundation/space/related"
       ";@ /token/space/grouped ;/foundation/space/grouped"
       ";@ /token/space/section ;/foundation/space/section"
       ";@ /token/space/plate ;/foundation/space/plate"
       ";@ /token/radius/small ;/foundation/radius/small"
       ";@ /token/radius/regular ;/foundation/radius/regular"
       ";@ /token/radius/plate ;/foundation/radius/plate"
       ";@ /token/radius/window ;/foundation/radius/window"
       ";@ /token/elevation/plate ;/foundation/elevation/plate"
       ";@ /token/elevation/window ;/foundation/elevation/window"
       ";@ /token/material/base ;/foundation/material/base"
       ";@ /token/material/raised ;/foundation/material/raised"
       ";@ /token/material/overlay ;/foundation/material/overlay"
       ";@ /token/material/window ;/foundation/material/window"
       ";@ /token/motion/change ;/foundation/motion/change"
       ";@ /token/motion/enter ;/foundation/motion/enter"
       ";@ /token/motion/exit ;/foundation/motion/exit"
       ";@ /token/density/interface ;/foundation/density/regular"
       ";@ /token/layout/sidebar/width ;/foundation/layout/sidebar/regular"
       ";@ /token/layout/message/measure ;/foundation/layout/message/readable"
       ";@ /token/layout/log/flow ;/foundation/layout/flow/vertical"
       ";@ /token/layout/plate/header ;/foundation/layout/header/compact"
       ";@ /token/layout/composer/flow ;/foundation/layout/composer/inline"
       ";@ /token/layout/window/chrome ;/foundation/layout/window/regular"
       ";@ /token/policy/focus ;/policy/focus/visible"
       ";@ /token/policy/contrast ;/policy/contrast/standard"
       ";@ /token/policy/motion ;/policy/motion/respect_preference"
       ";. /authoring/foundations/chat"])
  +  web_chat_provider_src
    '  Web pronunciation symbols for the complete bounded Chat vocabulary.
    '  These paths are provider-local material selected after semantic roles;
    '  literal CSS remains inside the mechanical Web pronunciation only.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/providers/web_chat"
       ";@ /foundry/guarded false"
       ";@ /token/color/text/primary ;/provider/web/color/text/primary"
       ";@ /token/color/text/secondary ;/provider/web/color/text/secondary"
       ";@ /token/color/text/tertiary ;/provider/web/color/text/tertiary"
       ";@ /token/color/text/disabled ;/provider/web/color/text/disabled"
       ";@ /token/color/surface/base ;/provider/web/color/surface/base"
       ";@ /token/color/surface/raised ;/provider/web/color/surface/raised"
       ";@ /token/color/surface/sunken ;/provider/web/color/surface/sunken"
       ";@ /token/color/surface/overlay ;/provider/web/color/surface/overlay"
       ";@ /token/color/surface/selected ;/provider/web/color/surface/selected"
       ";@ /token/color/surface/destructive ;/provider/web/color/surface/destructive"
       ";@ /token/color/fill/base ;/provider/web/color/fill/base"
       ";@ /token/color/fill/secondary ;/provider/web/color/fill/secondary"
       ";@ /token/color/fill/selected ;/provider/web/color/fill/selected"
       ";@ /token/color/border/separator ;/provider/web/color/border/separator"
       ";@ /token/color/border/strong ;/provider/web/color/border/strong"
       ";@ /token/color/border/focus ;/provider/web/color/border/focus"
       ";@ /token/color/action/accent ;/provider/web/color/action/accent"
       ";@ /token/color/action/positive ;/provider/web/color/action/positive"
       ";@ /token/color/action/warning ;/provider/web/color/action/warning"
       ";@ /token/color/action/destructive ;/provider/web/color/action/destructive"
       ";@ /token/type/body ;/provider/web/type/body"
       ";@ /token/type/caption ;/provider/web/type/caption"
       ";@ /token/type/label ;/provider/web/type/label"
       ";@ /token/type/header ;/provider/web/type/header"
       ";@ /token/type/code ;/provider/web/type/code"
       ";@ /token/space/related ;/provider/web/space/related"
       ";@ /token/space/grouped ;/provider/web/space/grouped"
       ";@ /token/space/section ;/provider/web/space/section"
       ";@ /token/space/plate ;/provider/web/space/plate"
       ";@ /token/radius/small ;/provider/web/radius/small"
       ";@ /token/radius/regular ;/provider/web/radius/regular"
       ";@ /token/radius/plate ;/provider/web/radius/plate"
       ";@ /token/radius/window ;/provider/web/radius/window"
       ";@ /token/elevation/plate ;/provider/web/elevation/plate"
       ";@ /token/elevation/window ;/provider/web/elevation/window"
       ";@ /token/material/base ;/provider/web/material/base"
       ";@ /token/material/raised ;/provider/web/material/raised"
       ";@ /token/material/overlay ;/provider/web/material/overlay"
       ";@ /token/material/window ;/provider/web/material/window"
       ";@ /token/motion/change ;/provider/web/motion/change"
       ";@ /token/motion/enter ;/provider/web/motion/enter"
       ";@ /token/motion/exit ;/provider/web/motion/exit"
       ";@ /token/density/interface ;/provider/web/density/regular"
       ";@ /token/layout/sidebar/width ;/provider/web/layout/sidebar/regular"
       ";@ /token/layout/message/measure ;/provider/web/layout/message/readable"
       ";@ /token/layout/log/flow ;/provider/web/layout/flow/vertical"
       ";@ /token/layout/plate/header ;/provider/web/layout/header/compact"
       ";@ /token/layout/composer/flow ;/provider/web/layout/composer/inline"
       ";@ /token/layout/window/chrome ;/provider/web/layout/window/regular"
       ";@ /token/policy/focus ;/policy/focus/visible"
       ";@ /token/policy/contrast ;/policy/contrast/standard"
       ";@ /token/policy/motion ;/policy/motion/respect_preference"
       ";. /authoring/providers/web/chat"])
  +  apple_chat_provider_src
    '  Apple provider symbols for the same bounded semantic vocabulary.  They
    '  remain inert corpus material until an Apple pronunciation is selected;
    '  no native handle, SwiftUI modifier, or platform authority enters Nenex.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/providers/apple_chat"
       ";@ /foundry/guarded false"
       ";@ /token/color/text/primary ;/provider/apple/color/label/primary"
       ";@ /token/color/text/secondary ;/provider/apple/color/label/secondary"
       ";@ /token/color/text/tertiary ;/provider/apple/color/label/tertiary"
       ";@ /token/color/text/disabled ;/provider/apple/color/label/quaternary"
       ";@ /token/color/surface/base ;/provider/apple/color/background/system"
       ";@ /token/color/surface/raised ;/provider/apple/color/background/secondary"
       ";@ /token/color/surface/sunken ;/provider/apple/color/background/grouped"
       ";@ /token/color/surface/overlay ;/provider/apple/material/regular"
       ";@ /token/color/surface/selected ;/provider/apple/color/fill/selected"
       ";@ /token/color/surface/destructive ;/provider/apple/color/background/destructive"
       ";@ /token/color/fill/base ;/provider/apple/color/fill/primary"
       ";@ /token/color/fill/secondary ;/provider/apple/color/fill/secondary"
       ";@ /token/color/fill/selected ;/provider/apple/color/fill/selected"
       ";@ /token/color/border/separator ;/provider/apple/color/separator/standard"
       ";@ /token/color/border/strong ;/provider/apple/color/separator/opaque"
       ";@ /token/color/border/focus ;/provider/apple/color/action/accent"
       ";@ /token/color/action/accent ;/provider/apple/color/action/accent"
       ";@ /token/color/action/positive ;/provider/apple/color/action/positive"
       ";@ /token/color/action/warning ;/provider/apple/color/action/warning"
       ";@ /token/color/action/destructive ;/provider/apple/color/action/destructive"
       ";@ /token/type/body ;/provider/apple/type/body"
       ";@ /token/type/caption ;/provider/apple/type/caption"
       ";@ /token/type/label ;/provider/apple/type/label"
       ";@ /token/type/header ;/provider/apple/type/headline"
       ";@ /token/type/code ;/provider/apple/type/monospaced"
       ";@ /token/space/related ;/provider/apple/space/related"
       ";@ /token/space/grouped ;/provider/apple/space/grouped"
       ";@ /token/space/section ;/provider/apple/space/section"
       ";@ /token/space/plate ;/provider/apple/space/plate"
       ";@ /token/radius/small ;/provider/apple/radius/small"
       ";@ /token/radius/regular ;/provider/apple/radius/regular"
       ";@ /token/radius/plate ;/provider/apple/radius/plate"
       ";@ /token/radius/window ;/provider/apple/radius/window"
       ";@ /token/elevation/plate ;/provider/apple/elevation/plate"
       ";@ /token/elevation/window ;/provider/apple/elevation/window"
       ";@ /token/material/base ;/provider/apple/material/base"
       ";@ /token/material/raised ;/provider/apple/material/thick"
       ";@ /token/material/overlay ;/provider/apple/material/regular"
       ";@ /token/material/window ;/provider/apple/material/window"
       ";@ /token/motion/change ;/provider/apple/motion/change"
       ";@ /token/motion/enter ;/provider/apple/motion/enter"
       ";@ /token/motion/exit ;/provider/apple/motion/exit"
       ";@ /token/density/interface ;/provider/apple/density/regular"
       ";@ /token/layout/sidebar/width ;/provider/apple/layout/sidebar/regular"
       ";@ /token/layout/message/measure ;/provider/apple/layout/message/readable"
       ";@ /token/layout/log/flow ;/provider/apple/layout/flow/vertical"
       ";@ /token/layout/plate/header ;/provider/apple/layout/header/compact"
       ";@ /token/layout/composer/flow ;/provider/apple/layout/composer/inline"
       ";@ /token/layout/window/chrome ;/provider/apple/layout/window/regular"
       ";@ /token/policy/focus ;/policy/focus/visible"
       ";@ /token/policy/contrast ;/policy/contrast/standard"
       ";@ /token/policy/motion ;/policy/motion/respect_preference"
       ";. /authoring/providers/apple/chat"])
  +  text_chat_provider_src
    '  Text-terminal provider symbols for the same semantic roles.  A future
    '  felt:text pronunciation may select them without changing the addressed
    '  graph or treating ANSI escapes as semantic values.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/providers/text_chat"
       ";@ /foundry/guarded false"
       ";@ /token/color/text/primary ;/provider/text/emphasis/strong"
       ";@ /token/color/text/secondary ;/provider/text/emphasis/normal"
       ";@ /token/color/text/tertiary ;/provider/text/emphasis/muted"
       ";@ /token/color/text/disabled ;/provider/text/emphasis/dim"
       ";@ /token/color/surface/base ;/provider/text/surface/plain"
       ";@ /token/color/surface/raised ;/provider/text/surface/raised"
       ";@ /token/color/surface/sunken ;/provider/text/surface/sunken"
       ";@ /token/color/surface/overlay ;/provider/text/surface/overlay"
       ";@ /token/color/surface/selected ;/provider/text/surface/selected"
       ";@ /token/color/surface/destructive ;/provider/text/surface/destructive"
       ";@ /token/color/fill/base ;/provider/text/fill/plain"
       ";@ /token/color/fill/secondary ;/provider/text/fill/secondary"
       ";@ /token/color/fill/selected ;/provider/text/fill/selected"
       ";@ /token/color/border/separator ;/provider/text/rule/standard"
       ";@ /token/color/border/strong ;/provider/text/rule/strong"
       ";@ /token/color/border/focus ;/provider/text/action/focus"
       ";@ /token/color/action/accent ;/provider/text/action/link"
       ";@ /token/color/action/positive ;/provider/text/action/success"
       ";@ /token/color/action/warning ;/provider/text/action/warning"
       ";@ /token/color/action/destructive ;/provider/text/action/error"
       ";@ /token/type/body ;/provider/text/type/body"
       ";@ /token/type/caption ;/provider/text/type/caption"
       ";@ /token/type/label ;/provider/text/type/label"
       ";@ /token/type/header ;/provider/text/type/heading"
       ";@ /token/type/code ;/provider/text/type/code"
       ";@ /token/space/related ;/provider/text/space/related"
       ";@ /token/space/grouped ;/provider/text/space/grouped"
       ";@ /token/space/section ;/provider/text/space/section"
       ";@ /token/space/plate ;/provider/text/space/plate"
       ";@ /token/radius/small ;/provider/text/radius/none"
       ";@ /token/radius/regular ;/provider/text/radius/none"
       ";@ /token/radius/plate ;/provider/text/radius/soft"
       ";@ /token/radius/window ;/provider/text/radius/soft"
       ";@ /token/elevation/plate ;/provider/text/elevation/outline"
       ";@ /token/elevation/window ;/provider/text/elevation/outline"
       ";@ /token/material/base ;/provider/text/material/plain"
       ";@ /token/material/raised ;/provider/text/material/panel"
       ";@ /token/material/overlay ;/provider/text/material/overlay"
       ";@ /token/material/window ;/provider/text/material/window"
       ";@ /token/motion/change ;/provider/text/motion/none"
       ";@ /token/motion/enter ;/provider/text/motion/none"
       ";@ /token/motion/exit ;/provider/text/motion/none"
       ";@ /token/density/interface ;/provider/text/density/compact"
       ";@ /token/layout/sidebar/width ;/provider/text/layout/sidebar/regular"
       ";@ /token/layout/message/measure ;/provider/text/layout/message/readable"
       ";@ /token/layout/log/flow ;/provider/text/layout/flow/vertical"
       ";@ /token/layout/plate/header ;/provider/text/layout/header/compact"
       ";@ /token/layout/composer/flow ;/provider/text/layout/composer/inline"
       ";@ /token/layout/window/chrome ;/provider/text/layout/window/regular"
       ";@ /token/policy/focus ;/policy/focus/visible"
       ";@ /token/policy/contrast ;/policy/contrast/standard"
       ";@ /token/policy/motion ;/policy/motion/none"
       ";. /authoring/providers/text/chat"])
  +  high_contrast_guard_src
    '  A guarded accessibility Layer.  It changes presentation roles only and
    '  therefore replays after every ordinary product-local cosmetic Layer.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/guards/high_contrast"
       ";@ /foundry/guarded true"
       ";@ /token/color/text/primary ;/provider/web/contrast/text/primary"
       ";@ /token/color/text/secondary ;/provider/web/contrast/text/secondary"
       ";@ /token/color/text/tertiary ;/provider/web/contrast/text/tertiary"
       ";@ /token/color/text/disabled ;/provider/web/contrast/text/disabled"
       ";@ /token/color/surface/base ;/provider/web/contrast/surface/base"
       ";@ /token/color/surface/raised ;/provider/web/contrast/surface/raised"
       ";@ /token/color/surface/sunken ;/provider/web/contrast/surface/sunken"
       ";@ /token/color/surface/overlay ;/provider/web/contrast/surface/overlay"
       ";@ /token/color/surface/selected ;/provider/web/contrast/surface/selected"
       ";@ /token/color/surface/destructive ;/provider/web/contrast/surface/destructive"
       ";@ /token/color/fill/base ;/provider/web/contrast/fill/base"
       ";@ /token/color/fill/secondary ;/provider/web/contrast/fill/secondary"
       ";@ /token/color/fill/selected ;/provider/web/contrast/fill/selected"
       ";@ /token/color/border/separator ;/provider/web/contrast/border/separator"
       ";@ /token/color/border/strong ;/provider/web/contrast/border/strong"
       ";@ /token/color/border/focus ;/provider/web/contrast/border/focus"
       ";@ /token/color/action/accent ;/provider/web/contrast/action/accent"
       ";@ /token/color/action/positive ;/provider/web/contrast/action/positive"
       ";@ /token/color/action/warning ;/provider/web/contrast/action/warning"
       ";@ /token/color/action/destructive ;/provider/web/contrast/action/destructive"
       ";@ /token/policy/contrast ;/policy/contrast/maximum"
       ";. /authoring/guards/high-contrast"])
  +  reduced_motion_guard_src
    '  The client-owned motion baseline is also guarded.  It requires every Web
    '  pronunciation to honor the local reduced-motion preference without
    '  claiming that motion is globally disabled for every consumer.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind layer"
       ";@ /foundry/name ;/foundry/system/guards/reduced_motion"
       ";@ /foundry/guarded true"
       ";@ /token/motion/change ;/provider/web/motion/respect_preference"
       ";@ /token/motion/enter ;/provider/web/motion/respect_preference"
       ";@ /token/motion/exit ;/provider/web/motion/respect_preference"
       ";@ /token/policy/motion ;/policy/motion/respect_preference"
       ";. /authoring/guards/reduced-motion"])
