- grove_install
- physical_read

' Navigation lives in one ordinary namespace myth. No client owns a second
' accepted-position store. These types are also the standard hand's contract.
+ goo_context
  + slot
    : name=path kind=str pail_type=str writers=row[path] history=str
      dependencies=row[path] route=bool
  + declarations
    : slots=row[goo_context/slot] bridge=path
  + stamp
    ' Constructed by the installed bridge from a published binding, never decoded
    ' from a rich-text descriptor or from a client's claimed port string.
    : port=path order=nat writes=myth
  + clear
    : port=path order=nat slots=row[path]
  + traversal
    : index=nat
  + guard
    : slots=row[path]
  + history
    : entries=row[myth] index=nat orders=mop[path nat lt_pith]
  + member
    : source=path source_life=nat key=path subject=path life=nat expected=nat axis=care
  + location
    ' Read-only physical namespace location: records and structural/tombstone nodes.
    : subject=path life=nat state=str expected=nat
  + capture_location
    \ target=path state=namespace
    ^ either[str goo_context/location]
    ? !(target.len) (./ok (goo_context/location [] 0 "unknown" 0))
    ? (physical_read/namespace_read (physical_read/request target .none 'children .none 1) state)
     > (./err why) (./err (str/cat_all ["Cannot inspect location: " (str/from_atom (iota_show why))]))
     > (./ok page)
      = status=str
          ? (physical_read/record page.own)
           > (./known _) "live"
           > .null "tombstone"
           > .unknown "unknown"
      | ./ok (goo_context/location target (goo_context/lifetime target state) status (state.case(.x target)).fall(0))
  + location_stale
    \ value=goo_context/location state=namespace
    ^ bool
    ? (goo_context/capture_location value.subject state)
     > (./err _) .true
     > (./ok now) !(and (eq now.life value.life) (eq now.state value.state))
  + range
    : document=path revision=nat start=nat end=nat quote=str
  + edge
    : relation=path identity=path revision=nat left=path left_life=nat right=path right_life=nat
  + cell
    : row=goo_context/member column=path write_target=maybe[path]
  + set
    : keys=row[path]
  + unavailable
    : value=pail reason=str
  + config_slot
    ^ path
    ['sys 'goo 'context_declarations]
  + history_slot
    ^ path
    ['sys 'goo 'context_history]
  + intent_slot
    ^ path
    ['sys 'goo 'context_intent]
  + guard_slot
    ^ path
    ['sys 'goo 'context_guard]
  + type_matches
    \ kind=str value=pail
    ^ bool
    ? (eq kind "location") ?=(v=goo_context/location value)
    ? (eq kind "member") ?=(v=goo_context/member value)
    ? (eq kind "range") ?=(v=goo_context/range value)
    ? (eq kind "edge") ?=(v=goo_context/edge value)
    ? (eq kind "cell") ?=(v=goo_context/cell value)
    ? (eq kind "key") ?=(v=pails/t value)
    ? (eq kind "set") ?=(v=goo_context/set value)
    .false
  + values
    \ declarations=goo_context/declarations record=myth
    ^ myth
    | declarations.slots.fold myth/new
      \ values=myth slot=goo_context/slot
      ?> (./some held) record.get(slot.name) values
      | values.put(slot.name held)
  + declare
    \ slots=row[goo_context/slot] bridge=path
    ^ either[str goo_context/declarations]
    % rest=row[goo_context/slot] slots seen=row[path] []
    ^ either[str goo_context/declarations]
    ? !(rest.len) (./ok (goo_context/declarations slots bridge))
    = slot rest.at(0)
      kinds=row[str] ["address" "selection" "filter" "scope" "recipe"]
      types=row[str] ["member" "location" "range" "edge" "cell" "key" "set"]
    ? (seen.has(slot.name)) (./err "Duplicate context slot.")
    ? !(and slot.name.len (and (kinds.has(slot.kind)) (types.has(slot.pail_type)))) (./err "Invalid context slot kind or pail type.")
    ? !((eq slot.history "push") || (eq slot.history "replace")) (./err "Context history must be push or replace.")
    ? !(slot.writers.len) (./err "Context slot requires writer ports.")
    ? !(slot.dependencies.all((\ dep=path (and !(equal dep slot.name) (slots.any((\ other=goo_context/slot (equal dep other.name))))))))
      | ./err "Invalid context dependency."
    | _ rest.drop(1) seen.snoc(slot.name)
  + affected
    ' Transitively clear dependent values in the same myth replacement.
    \ declarations=goo_context/declarations writes=myth
    ^ row[path]
    % count=nat 0 names=row[path] writes.tap.map((\ entry entry.key))
    ^ row[path]
    ? (ge count declarations.slots.len) names
    = next=row[path]
        | declarations.slots.fold names
          \ names=row[path] slot=goo_context/slot
          ? (names.has(slot.name)) names
          ? !(slot.dependencies.any((\ dep=path names.has(dep)))) names
          | names.snoc(slot.name)
    ? (eq next.len names.len) next
    | _ count.inc next
  + reduce
    \ source=path cur=myth intent=goo_context/stamp
    ^ either[str myth]
    | goo_context/apply source cur intent.port intent.order intent.writes []
  + reduce_clear
    \ source=path cur=myth intent=goo_context/clear
    ^ either[str myth]
    | goo_context/apply source cur intent.port intent.order myth/new intent.slots
  + apply
    \ source=path cur=myth port=path order=nat writes=myth clears=row[path]
    ^ either[str myth]
    ?> (./some held) cur.get(goo_context/config_slot) (./err "Context declarations are missing.")
    ?> declarations=goo_context/declarations held (./err "Invalid context declarations.")
    ? !(equal source declarations.bridge) (./err "Context write has no authenticated bridge stamp.")
    ?> (./some held) cur.get(goo_context/history_slot) (./err "Context history is missing.")
    ?> history=goo_context/history held (./err "Invalid context history.")
    ? !(writes.tap.len || clears.len) (./err "Empty context intent.")
    = touched (clears.fold(writes (\ record=myth slot=path record.put(slot (pails/t "clear")))))
      changed (goo_context/affected declarations touched)
      cleared=either[str unit]
        % rest=row[path] clears
        ^ either[str unit]
        ? !(rest.len) (./ok [])
        = name rest.at(0)
          matches (declarations.slots.keep((\ slot=goo_context/slot (equal slot.name name))))
        ? !(eq matches.len 1) (./err "Undeclared context slot.")
        = slot matches.at(0)
        ? !(slot.writers.has(port)) (./err "Port is not permitted to clear this context slot.")
        ? (le order history.orders.gut(name 0)) (./err "Context intent was superseded.")
        | _ rest.drop(1)
      guarded=row[path]
        ?> (./some held) cur.get(goo_context/guard_slot) []
        ?> guard=goo_context/guard held []
        guard.slots
    ? (changed.any((\ slot=path guarded.has(slot)))) (./err "Departure refused; owner has dirty or pending work.")
    = checked=either[str unit]
        % rest=row[mop/kv[path pail]] writes.tap
        ^ either[str unit]
        ? !(rest.len) (./ok [])
        = entry rest.at(0)
          matches (declarations.slots.keep((\ slot=goo_context/slot (equal slot.name entry.key))))
        ? !(eq matches.len 1) (./err "Undeclared context slot.")
        = slot matches.at(0)
        ? !(slot.writers.has(port)) (./err "Port is not permitted to write this context slot.")
        ? !(goo_context/type_matches slot.pail_type entry.val) (./err "Context pail type mismatch.")
        ? (le order history.orders.gut(slot.name 0)) (./err "Context intent was superseded.")
        | _ rest.drop(1)
    < cleared cleared
    < checked checked
    = values (goo_context/values declarations cur)
      values (changed.fold(values (\ state=myth slot=path state.del(slot)))).meld(writes)
      next (declarations.slots.fold(cur (\ state=myth slot=goo_context/slot state.del(slot.name)))).meld(values)
      push (declarations.slots.any((\ slot=goo_context/slot (and (maybe/is_some (touched.get(slot.name))) (eq slot.history "push")))))
      entries=row[myth]
        ? push history.entries.take(history.index.inc).snoc(values)
        | history.entries.take(history.index).snoc(values)
      orders (changed.fold(history.orders (\ orders=mop[path nat lt_pith] name=path orders.put(name order))))
    | ./ok next.put(goo_context/history_slot (goo_context/history entries entries.len.dec orders))
  + command
    \ source=path cur=myth value=pail
    ^ either[str myth]
    ? value
     > intent=goo_context/stamp (goo_context/reduce source cur intent)
     > intent=goo_context/clear (goo_context/reduce_clear source cur intent)
     > intent=goo_context/traversal (goo_context/travel source cur intent.index)
    | ./err "Unknown context command."
  + talk
    \ context=bowl cur=myth add=myth
    ^ yell
    ?> (./some held) add.get(goo_context/intent_slot) (yell [] cur)
    ? (goo_context/command context.src cur held)
     > (./ok next)
      ' Talk output is committed as a merge by namespace dispatch. An explicit
      ' self replacement is needed for cleared/dependent slots to actually vanish.
      | yell [[context.here (writ/make next)]] cur
     > (./err _) (yell [] cur)
  + record
    \ declarations=goo_context/declarations behavior=path initial=myth
    ^ myth
    = record initial.put(goo_context/config_slot declarations)
      record record.put(goo_context/history_slot (goo_context/history [initial] 0 mop/empty))
    | record.put(limb_slot (kook [behavior]))
  + lifetime
    \ target=path state=namespace
    ^ nat
    ?> (./some history) state.history(target) 0
    | (history.ever_at(target)).x.lock.shape
  + alive
    \ target=path life=nat state=namespace
    ^ bool
    | and (and (gt life 0) (eq life (goo_context/lifetime target state))) (maybe/is_some (sovereign_care .x target state).fil)
  + validate_member
    \ value=goo_context/member state=namespace
    ^ either[str unit]
    ? !(and (state.permitted(value.subject)) (pith_prefix [state.self 'app] value.subject))
      | ./err "Captured subject is outside application authority."
    ? !(and (goo_context/alive value.source value.source_life state) (goo_context/alive value.subject value.life state))
      | ./err "Captured membership was removed or replaced."
    ? !(eq value.expected (state.case(.x value.subject)).fall(0))
      | ./err "Captured subject changed before admission."
    ' Namespace adapter only: key==subject is not the general member contract.
    ? !(and (equal value.key value.subject) (and (eq value.subject.len value.source.len.inc) (pith_prefix value.source value.subject)))
      | ./err "Capture is not a member of its finite source."
    | ./ok []
  + boundary
    \ text=str offset=nat
    ^ bool
    ? (gt offset text.len) .false
    ? (eq offset text.len) .true
    = byte text.at(offset)
    | !(and (ge byte 128) (lt byte 192))
  + validate_pail
    \ value=pail state=namespace
    ^ either[str unit]
    ? value
     > location=goo_context/location
      < current (goo_context/capture_location location.subject state)
      ? !(equal location current) (./err "Namespace location changed before admission.")
      | ./ok []
     > member=goo_context/member (goo_context/validate_member member state)
     > range=goo_context/range
      ?> (./some card) (sovereign_care .x range.document state).fil (./err "Range document is unavailable.")
      ? !(eq range.revision (state.case(.x range.document)).fall(0)) (./err "Range revision changed.")
      ?> (./some held) card.get(system_vocabulary/content) (./err "Range document has no text.")
      ?> text=pails/t held (./err "Range document requires its text provider.")
      ? !(and (lt range.start range.end) (and (goo_context/boundary text.t range.start) (goo_context/boundary text.t range.end)))
        | ./err "Invalid UTF-8 range boundaries."
      ? !(eq range.quote text.t.slice(range.start (sub range.end range.start))) (./err "Range exact quote differs.")
      | ./ok []
     > edge=goo_context/edge
      ? !(and (pith_prefix edge.relation edge.identity) !(equal edge.relation edge.identity)) (./err "Edge is outside its relation.")
      ?> (./some card) (sovereign_care .x edge.identity state).fil (./err "Edge is unavailable.")
      ? !(eq edge.revision (state.case(.x edge.identity)).fall(0)) (./err "Edge revision changed.")
      ? !(and (goo_context/alive edge.left edge.left_life state) (goo_context/alive edge.right edge.right_life state)) (./err "Edge endpoint was replaced.")
      ? !(and (equal card.path_at(['from]) (maybe/some[path] edge.left)) (equal card.path_at(['to]) (maybe/some[path] edge.right))) (./err "Edge endpoints differ.")
      | ./ok []
     > cell=goo_context/cell
      < row (goo_context/validate_member cell.row state)
      ?> (./some target) cell.write_target (./err "Aggregate row has no declared editable subject.")
      ? !(and cell.column.len (equal target cell.row.subject)) (./err "Cell write target differs from its row subject.")
      | ./ok []
     > key=pails/t (./ok [])
     > set=goo_context/set (./ok [])
    | ./err "Unknown context pail."
  + validate_intent
    ' Called at the trusted binding boundary before it emits the stamped write.
    \ intent=goo_context/stamp state=namespace
    ^ either[str unit]
    % rest=row[mop/kv[path pail]] intent.writes.tap
    ^ either[str unit]
    ? !(rest.len) (./ok [])
    < checked (goo_context/validate_pail rest.at(0).val state)
    | _ rest.drop(1)
  + stale
    ' Staleness depends on incarnation, not ordinary subject edits.
    \ value=pail state=namespace
    ^ bool
    ? value
     > location=goo_context/location (goo_context/location_stale location state)
     > m=goo_context/member !(and (goo_context/alive m.source m.source_life state) (goo_context/alive m.subject m.life state))
     > r=goo_context/range !(eq r.revision (state.case(.x r.document)).fall(0))
     > e=goo_context/edge
      | !(and (eq e.revision (state.case(.x e.identity)).fall(0)) (and (goo_context/alive e.left e.left_life state) (goo_context/alive e.right e.right_life state)))
     > c=goo_context/cell (goo_context/stale c.row state)
    .false
  + refresh
    ' Commit unavailable into the namespace, never silently rebind a follower.
    \ home=path state=namespace
    ^ either[iota namespace]
    ?> (./some card) (sovereign_care .x home state).fil (./err 'missing_context)
    ?> (./some held) card.get(goo_context/config_slot) (./err 'missing_context_declarations)
    ?> declarations=goo_context/declarations held (./err 'invalid_context_declarations)
    = next=myth
        | declarations.slots.fold card
          \ record=myth slot=goo_context/slot
          ?> (./some held) record.get(slot.name) record
          ? !(goo_context/stale held state) record
          | record.put(slot.name (goo_context/unavailable held "Captured value was removed, replaced or revised."))
    ? (equal next card) (./ok state)
    | grove_install/change home (writ/make next) state
  + travel
    \ source=path cur=myth index=nat
    ^ either[str myth]
    ?> (./some held) cur.get(goo_context/config_slot) (./err "Context declarations are missing.")
    ?> declarations=goo_context/declarations held (./err "Invalid context declarations.")
    ? !(equal source declarations.bridge) (./err "History requires the authenticated context bridge.")
    ?> (./some held) cur.get(goo_context/history_slot) (./err "Context history is missing.")
    ?> history=goo_context/history held (./err "Invalid context history.")
    ? (ge index history.entries.len) (./err "History destination is unavailable.")
    = guarded=bool
        ?> (./some held) cur.get(goo_context/guard_slot) .false
        ?> guard=goo_context/guard held .false
        | gt guard.slots.len 0
    ? guarded (./err "Departure refused; owner has dirty or pending work.")
    = next (declarations.slots.fold(cur (\ record=myth slot=goo_context/slot record.del(slot.name)))).meld(history.entries.at(index))
      order (history.orders.tap.fold(0 (\ n=nat entry (? (gt n entry.val) n entry.val)))).inc
      orders (declarations.slots.fold(history.orders (\ orders=mop[path nat lt_pith] slot=goo_context/slot orders.put(slot.name order))))
    | ./ok next.put(goo_context/history_slot (history.set_index(index).set_orders(orders)))
  + remove_edge
    ' The relationship alone is the receiver; endpoint cases are untouched.
    \ edge=goo_context/edge state=namespace
    ^ either[str namespace]
    < valid (goo_context/validate_pail edge state)
    ? (grove_install/change edge.identity .cull state)
     > (./ok next) (./ok next)
     > (./err why) (./err (str/from_atom (iota_show why)))
