- sept
- shrine
- lain_types

+ http_response
  : status=nat body=nat ctype=nat

+ http_driver
  +  response
    \ status=nat body=nat
    ^ http_response
    | http_response status body "text/plain; charset=utf-8"
  +  failure
    \ err=iota
    ^ http_response
    | http_driver/response 500 (| iota_show err)
  +  back
    \ loc=nat
    ^ http_response
    '  Escape the URL before placing it in either HTML attribute.
    = url | http_driver/escape loc
    | http_response 200
      (| cord/cat_all ["<!doctype html><html><head><meta http-equiv=" 34 "refresh" 34
        " content=" 34 "0;url=" url 34 "></head><body>committed; <a href=" 34 url 34
        ">back</a></body></html>"])
      "text/html; charset=utf-8"
  +  escape
    \ text=nat
    ^ nat
    = pieces
        % i=nat 0 out=row[nat] []
        ? (| eq i (| wid text)) out
        = c | load8 i text
          escaped=nat
            ? (| eq c 38) "&amp;"
            ? (| eq c 34) "&quot;"
            ? (| eq c 60) "&lt;"
            ? (| eq c 62) "&gt;"
            c
        | _ i.inc out.snoc(escaped)
    | cord/cat_all pieces
  +  result
    '  Ordinary HTTP records and compiler/chore records share the wait path.
    \ rec=res[myth]
    ^ maybe[http_response]
    ?> (./known t) rec .none
    = status t.nat_at(['res_status] 0)
    ? status
      | ./some
      | http_response status t.nat_at(['res_body] 0)
        t.nat_at(['res_ctype] "text/plain; charset=utf-8")
    ? !(| eq 1 t.nat_at(['res_done] 0)) .none
    = err t.txt_at(['err])
      report t.txt_at(['report])
      value t.txt_at(['value])
      ty t.txt_at(['ty])
      law t.txt_at(['law])
      body=nat
        ? err err
        ? report report
        ? value
          | cord/cat_all ["value: " value
            (? ty (| cord/cat_all [10 "type:  " ty]) "")
            (? law (| cord/cat_all [10 10 law]) "")]
        "chore failed"
      code=nat
        ? err 500
        ? (report || value) 200
        500
    | ./some | http_driver/response code body
