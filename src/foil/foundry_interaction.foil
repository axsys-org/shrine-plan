-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_action [order=40]
'  foundry_interaction: pure occurrence-scoped interaction admission.
'
'  A caller supplies one structurally complete canonical projection DAG and
'  explicit trusted specs.  This pass never infers interaction from a role,
'  kind, source, route, renderer, or terminal operation.  It proves that the
'  exact Block occurrence's semantic definition explicitly declares the same
'  /surface/action, delegates authority narrowing to foundry_action/admit, and
'  appends typed projection_interaction sidecars to the same DAG.

+  foundry_interaction_spec
  '  destination is an already-resolved semantic occurrence target.  When it
  '  is present, the owner definition must also explicitly declare one
  '  /surface/destination; the declaration path is retained in the mount.
  :  owner=projection_address
     action=path
     record=myth
     context=foundry_action/context
     destination=maybe[projection_address]

+  foundry_interaction_revision_evidence
  '  Ordered admitted specs are exact compiler evidence.  Each interaction
  '  contains its independent address, exact occurrence owner, Action record
  '  pin, admission witness, and optional destination declaration + target.
  :  prior=foundry_digest interactions=row[projection_interaction]

+  foundry_interaction_refusal
  :  code=iota at=maybe[projection_address]

+  foundry_interaction_one_result
  &  foundry_interaction_one_result/admitted
     foundry_interaction_one_result/refused

  +  admitted
    :  interaction=projection_interaction
  +  refused
    :  refusal=foundry_interaction_refusal

+  foundry_interaction_build_result
  &  foundry_interaction_build_result/admitted
     foundry_interaction_build_result/refused

  +  admitted
    :  interactions=row[projection_interaction]
  +  refused
    :  refusal=foundry_interaction_refusal

+  foundry_interaction_destination_result
  &  foundry_interaction_destination_result/admitted
     foundry_interaction_destination_result/refused

  +  admitted
    :  destination=maybe[projection_destination_mount]
  +  refused
    :  refusal=foundry_interaction_refusal

+  foundry_interaction_result
  &  foundry_interaction_result/admitted
     foundry_interaction_result/refused

  +  admitted
    :  dag=projection_dag
  +  refused
    :  refusal=foundry_interaction_refusal

+  foundry_interaction
  +  refusal
    \  code=iota at=maybe[projection_address]
    ^  foundry_interaction_refusal
    (foundry_interaction_refusal code at)

  +  interaction_axis
    '  A named branch is the existing extensible occurrence-axis spelling for
    '  this compiler sidecar; no new durable identity scheme is introduced.
    ^  projection_axis
    (foundry_delivery/axis_branch 'interaction)

  +  interaction_address_for
    '  The interaction is one branch beneath the exact occurrence owner.  A
    '  shared definition placed twice therefore receives two independent
    '  addresses without copying or renaming the shared definition.
    \  owner=projection_address
    ^  projection_address
    (foundry_delivery/make_address owner.source
      owner.axis.snoc((foundry_interaction/interaction_axis)))

  +  owner_node
    '  Open only the node definition selected by an owner accepted by
    '  foundry_delivery/owner_block.  A non-root definition is not itself an
    '  occurrence owner; its placement must be named instead.
    \  owner=projection_address dag=projection_dag
    ^  maybe[projection_node]
    ?  (foundry_delivery/live_placement owner dag.entries)
     > (./some placement=projection_placement)
       ?  placement.target
        > projection_placement_target/hole  .none
        > x=projection_placement_target/child
          (foundry_delivery/live_node x.address dag.entries)
     > .none
       ?  !(foundry_delivery/address_in owner dag.manifest.roots)  .none
       (foundry_delivery/live_node owner dag.entries)

  +  node_parameters
    \  node=projection_node
    ^  row[projection_parameter]
    ?  node.body
     > projection_node_body/hole       []
     > x=projection_node_body/semantic  x.syntax.parameters

  +  parameter_count
    \  key=path parameters=row[projection_parameter]
    ^  nat
    parameters.fold(0 ;
      \  count=nat parameter=projection_parameter
      ?  (eq_pith key parameter.key)  count.inc
      count)

  +  semantic_reference_at
    \  key=path parameters=row[projection_parameter]
    ^  maybe[path]
    ?  (foundry_delivery/parameter_value key parameters)
     > .none  .none
     > (./some value=projection_value)
       (foundry_delivery/value_semantic_ref value)

  +  interaction_owner_in
    \  owner=projection_address interactions=row[projection_interaction]
    ^  bool
    interactions.any((\ interaction (equal owner interaction.owner)))

  +  interaction_address_in
    \  address=projection_address interactions=row[projection_interaction]
    ^  bool
    interactions.any((\ interaction (equal address interaction.address)))

  +  entry_owned_by
    \  owner=projection_address entry=projection_entry
    ^  bool
    ?  entry
     > x=projection_entry/interaction  (equal owner x.interaction.owner)
     > projection_entry/node           .false
     > projection_entry/placement      .false
     > projection_entry/tombstone      .false

  +  entry_owner_in
    \  owner=projection_address entries=row[projection_entry]
    ^  bool
    entries.any((foundry_interaction/entry_owned_by owner))

  +  entry_address_in
    \  address=projection_address entries=row[projection_entry]
    ^  bool
    ?  (foundry_delivery/find address entries)
     > .none       .false
     > (./some _)  .true

  +  semantic_destination
    '  A resolved destination is a semantic node/placement occurrence, or an
    '  explicit frontier reference.  Interaction sidecars and tombstones are
    '  not navigation targets merely because they also have DAG addresses.
    \  target=projection_address dag=projection_dag
    ^  bool
    ?  (foundry_delivery/find target dag.entries)
     > .none  (foundry_delivery/address_in target dag.manifest.frontier)
     > (./some entry=projection_entry)
       ?  entry
        > projection_entry/node         .true
        > projection_entry/placement    .true
        > projection_entry/interaction  .false
        > projection_entry/tombstone    .false

  +  destination_for
    \  spec=foundry_interaction_spec node=projection_node dag=projection_dag
    ^  foundry_interaction_destination_result
    ?  spec.destination
     > .none
       (foundry_interaction_destination_result/admitted .none)
     > (./some target=projection_address)
       =  parameters  (foundry_interaction/node_parameters node)
          key=path    ['surface 'destination]
          count       (foundry_interaction/parameter_count key parameters)
       ?  (eq count 0)
          (foundry_interaction_destination_result/refused
            (foundry_interaction/refusal
              'interaction_destination_declaration_missing
              (./some spec.owner)))
       ?  (gt count 1)
          (foundry_interaction_destination_result/refused
            (foundry_interaction/refusal
              'interaction_destination_declaration_ambiguous
              (./some spec.owner)))
       ?  (foundry_interaction/semantic_reference_at key parameters)
        > .none
          (foundry_interaction_destination_result/refused
            (foundry_interaction/refusal
              'interaction_destination_declaration_invalid
              (./some spec.owner)))
        > (./some declaration=path)
          ?  !(foundry_delivery/address_valid target)
             (foundry_interaction_destination_result/refused
               (foundry_interaction/refusal
                 'interaction_destination_invalid (./some target)))
          ?  !(foundry_interaction/semantic_destination target dag)
             (foundry_interaction_destination_result/refused
               (foundry_interaction/refusal
                 'interaction_destination_invalid (./some target)))
          (foundry_interaction_destination_result/admitted
            (./some (foundry_delivery/make_destination_mount
              declaration target)))

  +  admit_one
    \  spec=foundry_interaction_spec dag=projection_dag
       admitted=row[projection_interaction]
    ^  foundry_interaction_one_result
    ?  !(foundry_delivery/address_valid spec.owner)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_owner_invalid
           (./some spec.owner)))
    ?  (foundry_interaction/entry_owner_in spec.owner dag.entries)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_owner_duplicate
           (./some spec.owner)))
    ?  (foundry_interaction/interaction_owner_in spec.owner admitted)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_owner_duplicate
           (./some spec.owner)))
    =  address  (foundry_interaction/interaction_address_for spec.owner)
    ?  (foundry_interaction/entry_address_in address dag.entries)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_address_duplicate
           (./some address)))
    ?  (foundry_interaction/interaction_address_in address admitted)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_address_duplicate
           (./some address)))
    ?  !(foundry_delivery/owner_block spec.owner dag)
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_owner_mismatch
           (./some spec.owner)))
    ?  (foundry_interaction/owner_node spec.owner dag)
     > .none
       (foundry_interaction_one_result/refused
         (foundry_interaction/refusal 'interaction_owner_mismatch
           (./some spec.owner)))
     > (./some node=projection_node)
       =  parameters  (foundry_interaction/node_parameters node)
          action_key=path  ['surface 'action]
          count
            (foundry_interaction/parameter_count action_key parameters)
       ?  (eq count 0)
          (foundry_interaction_one_result/refused
            (foundry_interaction/refusal
              'interaction_action_declaration_missing
              (./some spec.owner)))
       ?  (gt count 1)
          (foundry_interaction_one_result/refused
            (foundry_interaction/refusal
              'interaction_action_declaration_ambiguous
              (./some spec.owner)))
       ?  (foundry_interaction/semantic_reference_at action_key parameters)
        > .none
          (foundry_interaction_one_result/refused
            (foundry_interaction/refusal
              'interaction_action_declaration_invalid
              (./some spec.owner)))
        > (./some declared=path)
          ?  !(eq_pith declared spec.action)
             (foundry_interaction_one_result/refused
               (foundry_interaction/refusal
                 'interaction_action_declaration_mismatch
                 (./some spec.owner)))
          ?  (foundry_action/admit spec.action spec.record spec.context)
           > x=foundry_action/admission/refused
             '  Preserve the Action authority diagnostic and add the exact
             '  occurrence address which foundry_action intentionally lacks.
             (foundry_interaction_one_result/refused
               (foundry_interaction/refusal x.diagnostic.code
                 (./some spec.owner)))
           > x=foundry_action/admission/admitted
             ?  (foundry_interaction/destination_for spec node dag)
              > y=foundry_interaction_destination_result/refused
                (foundry_interaction_one_result/refused y.refusal)
              > y=foundry_interaction_destination_result/admitted
                =  interaction
                     (projection_interaction address spec.owner [x.mount]
                       y.destination)
                ?  !(foundry_delivery/interaction_valid interaction)
                   (foundry_interaction_one_result/refused
                     (foundry_interaction/refusal
                       'interaction_evidence_invalid (./some spec.owner)))
                (foundry_interaction_one_result/admitted interaction)

  +  build_specs
    \  specs=row[foundry_interaction_spec] dag=projection_dag index=nat
       admitted=row[projection_interaction]
    ^  foundry_interaction_build_result
    ?  (ge index specs.len)
       (foundry_interaction_build_result/admitted admitted)
    ?  (foundry_interaction/admit_one specs.at(index) dag admitted)
     > x=foundry_interaction_one_result/refused
       (foundry_interaction_build_result/refused x.refusal)
     > x=foundry_interaction_one_result/admitted
       (foundry_interaction/build_specs specs dag index.inc
         admitted.snoc(x.interaction))

  +  revision_for
    \  prior=foundry_digest interactions=row[projection_interaction]
    ^  foundry_digest
    (pin_hash (pin_save (pin
      (foundry_interaction_revision_evidence prior interactions))))

  +  append_entries
    \  entries=row[projection_entry]
       interactions=row[projection_interaction]
    ^  row[projection_entry]
    interactions.fold(entries ;
      \  out=row[projection_entry] interaction=projection_interaction
      out.snoc((projection_entry/interaction interaction)))

  +  admit
    '  Total pure cut from one complete canonical DAG plus explicit trusted
    '  specs to the same DAG with independently addressed interaction
    '  sidecars.  Empty input is observationally identical to the prior DAG.
    \  dag=projection_dag specs=row[foundry_interaction_spec]
    ^  foundry_interaction_result
    ?  !(foundry_delivery/manifest_valid dag.manifest)
       (foundry_interaction_result/refused
         (foundry_interaction/refusal 'interaction_manifest_invalid .none))
    ?  !(foundry_delivery/completion_valid dag)
       (foundry_interaction_result/refused
         (foundry_interaction/refusal 'interaction_source_incomplete .none))
    ?  (eq specs.len 0)
       (foundry_interaction_result/admitted dag)
    ?  (foundry_interaction/build_specs specs dag 0 [])
     > x=foundry_interaction_build_result/refused
       (foundry_interaction_result/refused x.refusal)
     > x=foundry_interaction_build_result/admitted
       =  prior  dag.manifest
          revision
            (foundry_interaction/revision_for prior.revision x.interactions)
          manifest
            (projection_manifest revision prior.roots prior.retain
              prior.frontier)
          entries
            (foundry_interaction/append_entries dag.entries x.interactions)
          next  (projection_dag manifest dag.contexts entries)
       ?  !(foundry_delivery/completion_valid next)
          (foundry_interaction_result/refused
            (foundry_interaction/refusal
              'interaction_result_incomplete .none))
       (foundry_interaction_result/admitted next)

  '  Construction and inspection gates for focused hosts and tests.
  +  make_spec
    \  owner=projection_address action=path record=myth
       context=foundry_action/context
       destination=maybe[projection_address]
    ^  foundry_interaction_spec
    (foundry_interaction_spec owner action record context destination)

  +  result_admitted
    \  result=foundry_interaction_result
    ^  bool
    ?  result
     > foundry_interaction_result/admitted  .true
     > foundry_interaction_result/refused   .false

  +  result_dag
    \  result=foundry_interaction_result
    ^  maybe[projection_dag]
    ?  result
     > x=foundry_interaction_result/admitted  (./some x.dag)
     > foundry_interaction_result/refused     .none

  +  result_code
    \  result=foundry_interaction_result
    ^  maybe[iota]
    ?  result
     > foundry_interaction_result/admitted  .none
     > x=foundry_interaction_result/refused
       (./some x.refusal.code)

  +  result_at
    \  result=foundry_interaction_result
    ^  maybe[projection_address]
    ?  result
     > foundry_interaction_result/admitted  .none
     > x=foundry_interaction_result/refused  x.refusal.at
