-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
'  A native request is intent; a returned outcome is evidence.
+  shadow_io
  +  request
    \  driver=nat operation=nat arguments=pail origin=path episode=nat
    ^  myth
    =  > base myth/new
    base.put(['driver] (pails/t driver)).put(['operation] (pails/t operation)).put(['arguments] arguments).put(['origin] (pails/p origin)).put(['episode] (pails/t episode)).put(['status] (pails/t "PENDING"))
  +  issue
    '  Persist the request in ordinary NS before emitting a driver card.
    \  request_path=path request=myth b=bowl cur=myth
    ^  yell
    (yell [[request_path (writ/make request)] [['io 'dispatch] (writ/make (myth/sing ['request] (pails/p request_path)))]] cur)
  +  basis
    :  driver=nat operation=nat arguments=maybe[pail] episode=nat
  +  basis_of
    \  cur=myth
    ^  shadow_io/basis
    (shadow_io/basis cur.txt_at(['driver]) cur.txt_at(['operation]) cur.get(['arguments]) cur.txt_at(['episode]))
  +  coordinate
    '  Claim/report are factual driver messages. Neither means fulfillment.
    \  b=bowl cur=myth add=myth
    ^  yell
    ?  add.has(['claim])
       ?  !(eq cur.txt_at(['status]) "PENDING")  (yell [] cur)
       =  > next cur.put(['attempt] (pails/t add.txt_at(['claim]))).put(['status] (pails/t "IN_FLIGHT")).put(['attempts] (pails/n cur.nat_at(['attempts] 0).inc))
       =  > claimed next.put(['attempt_basis] (shadow_io/basis_of cur)).put(['claimed_at] (pails/t add.txt_at(['claimed_at])))
       (yell [] claimed)
    ?  add.has(['report_attempt])
       ?  !(eq cur.txt_at(['attempt]) add.txt_at(['report_attempt]))  (yell [] cur)
       ?  !(eq cur.txt_at(['status]) "IN_FLIGHT")  (yell [] cur)
       =  > next cur.meld(add).put(['status] (pails/t "REPORTED"))
       (yell [] next)
    =  > next cur.meld(add)
    ?  !(eq cur.txt_at(['status]) "IN_FLIGHT")  (yell [] next)
    ?  !(equal (shadow_io/basis_of cur) (shadow_io/basis_of next))
       (yell [] next.put(['status] (pails/t "NEEDS_REVIEW")))
    (yell [] next)
  +  form
    ^  form
    def_form.set_talk(shadow_io/coordinate)
  +  retry
    '  Explicitly authored retry budget; never invoked by the driver.
    \  max_attempts=nat cur=myth
    ^  myth
    ?  !(eq cur.txt_at(['status]) "REPORTED")  cur
    ?  !(eq cur.txt_at(['reported_outcome]) "failure")  cur
    ?  (ge cur.nat_at(['attempts] 0) max_attempts)  cur
    cur.put(['status] (pails/t "PENDING"))
