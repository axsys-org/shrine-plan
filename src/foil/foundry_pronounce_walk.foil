-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_view [order=40]
-  foundry_pronounce [order=50]
-  foundry_pronounce_occurrence [order=60]
'  Recursive, renderer-neutral pre-order walk over one complete addressed DAG.
'  The mutually recursive cursor/children pair intentionally remains together;
'  data carriers and leaf construction compile in earlier bounded modules.

+  foundry_pronounce_walk
  +  refusal
    \  code=iota at=maybe[projection_address]
    ^  projection_pronunciation_refusal
    (projection_pronunciation_refusal code at)

  +  address_in
    \  address=projection_address addresses=row[projection_address]
    ^  bool
    addresses.any((\ at (equal address at)))

  +  walk_cursor
    \  cursor=projection_cursor view=projection_view depth=nat
       parent=maybe[projection_address] context=maybe[projection_child]
       stack=row[projection_address]
    ^  projection_pronunciation_walk_result
    ?  (foundry_pronounce_walk/address_in cursor.address stack)
       (projection_pronunciation_walk_result/refused
         (foundry_pronounce_walk/refusal 'cyclic_projection
           (./some cursor.address)))
    =  occurrence
         (foundry_pronounce_occurrence/cursor_occurrence
           cursor depth parent context view)
    ?  (foundry_view/children cursor view)
     > x=projection_children_result/refused
       (projection_pronunciation_walk_result/refused
         (projection_pronunciation_refusal x.refusal.code x.refusal.at))
     > x=projection_children_result/admitted
       (foundry_pronounce_walk/walk_children cursor x.children view depth.inc
         stack.snoc(cursor.address) 0 [occurrence])

  +  walk_children
    \  parent=projection_cursor children=row[projection_child]
       view=projection_view depth=nat stack=row[projection_address]
       index=nat out=row[projection_pronunciation_occurrence]
    ^  projection_pronunciation_walk_result
    ?  (ge index children.len)
       (projection_pronunciation_walk_result/admitted out)
    =  child  children.at(index)
    ?  child.target
     > x=projection_placement_target/hole
       (foundry_pronounce_walk/walk_children parent children view depth stack
         index.inc out.snoc((foundry_pronounce_occurrence/inline_hole_occurrence
           parent child x.hole depth view)))
     > x=projection_placement_target/child
       ?  (foundry_view/cursor_at x.address view)
        > .none
          (projection_pronunciation_walk_result/refused
            (foundry_pronounce_walk/refusal 'child_missing
              (./some x.address)))
        > (./some cursor=projection_cursor)
          ?  (foundry_pronounce_walk/walk_cursor cursor view depth
                (./some parent.address) (./some child) stack)
           > y=projection_pronunciation_walk_result/refused
             (projection_pronunciation_walk_result/refused y.refusal)
           > y=projection_pronunciation_walk_result/admitted
             (foundry_pronounce_walk/walk_children parent children view depth
               stack index.inc out.weld(y.occurrences))

  +  walk_roots
    \  roots=row[projection_address] view=projection_view index=nat
       out=row[projection_pronunciation_occurrence]
    ^  projection_pronunciation_walk_result
    ?  (ge index roots.len)
       (projection_pronunciation_walk_result/admitted out)
    =  address  roots.at(index)
    ?  (foundry_view/cursor_at address view)
     > .none
       (projection_pronunciation_walk_result/refused
         (foundry_pronounce_walk/refusal 'root_missing (./some address)))
     > (./some cursor=projection_cursor)
       ?  (foundry_pronounce_walk/walk_cursor cursor view 0 .none .none [])
        > x=projection_pronunciation_walk_result/refused
          (projection_pronunciation_walk_result/refused x.refusal)
        > x=projection_pronunciation_walk_result/admitted
          (foundry_pronounce_walk/walk_roots roots view index.inc
            out.weld(x.occurrences))

  +  pronounce
    '  Open a complete DAG, then mechanically expand its visible occurrence
    '  tree.  No partial pronunciation is returned after any refusal.
    \  dag=projection_dag
    ^  projection_pronunciation_result
    ?  (foundry_view/open dag)
     > x=projection_view_result/refused
       (projection_pronunciation_result/refused
         (projection_pronunciation_refusal x.refusal.code x.refusal.at))
     > x=projection_view_result/admitted
       =  roots  dag.manifest.roots
       ?  (foundry_pronounce_walk/walk_roots roots x.view 0 [])
        > y=projection_pronunciation_walk_result/refused
          (projection_pronunciation_result/refused y.refusal)
        > y=projection_pronunciation_walk_result/admitted
          (projection_pronunciation_result/admitted
            (projection_pronunciation dag.manifest.revision roots
              y.occurrences))
