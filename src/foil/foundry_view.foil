-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
'  foundry_view: the minimal renderer boundary over one admitted addressed
'  projection DAG.  It opens a complete semantic graph as addressable cursors
'  and ordered contextual placements.  It emits no HTML, CSS, route, cache
'  key, terminal target, action authority, or renderer policy.
'
'  A terminal adapter must read semantic content through this view.  The DAG
'  remains the sole content source; local pronunciation mechanics stay beyond
'  this module and remain siblings of projection frames.

+  projection_view
  :  dag=projection_dag

+  projection_cursor
  '  One semantic node definition.  placements are the syntax-declared,
  '  ordered contextual occurrence addresses; a hole carries no placements.
  :  address=projection_address
     kind=iota
     role=path
     parameters=row[projection_parameter]
     hole=maybe[projection_hole]
     placements=row[projection_address]

+  projection_child
  '  One contextual edge in its parent's declared order.  target remains the
  '  renderer-neutral child-or-hole union from the canonical DAG.
  :  placement=projection_address
     role=path
     parameters=row[projection_parameter]
     target=projection_placement_target

+  projection_view_refusal
  :  code=iota at=maybe[projection_address]

+  projection_view_result
  &  projection_view_result/admitted
     projection_view_result/refused

  +  admitted
    :  view=projection_view
  +  refused
    :  refusal=projection_view_refusal

+  projection_children_result
  &  projection_children_result/admitted
     projection_children_result/refused

  +  admitted
    :  children=row[projection_child]
  +  refused
    :  refusal=projection_view_refusal

+  foundry_view
  +  refusal
    \  code=iota at=maybe[projection_address]
    ^  projection_view_refusal
    (projection_view_refusal code at)

  +  addresses_unique
    \  addresses=row[projection_address]
    ^  bool
    |  > i=nat 0  > j=nat 1
    ^  bool
    ?  (ge i addresses.len)
       .true
    ?  (ge j addresses.len)
       (_ i.inc i.inc.inc)
    ?  (equal addresses.at(i) addresses.at(j))
       .false
    (_ i j.inc)

  +  parameters_unique
    \  parameters=row[projection_parameter]
    ^  bool
    |  > i=nat 0  > j=nat 1
    ^  bool
    ?  (ge i parameters.len)
       .true
    ?  (ge j parameters.len)
       (_ i.inc i.inc.inc)
    ?  (eq_pith parameters.at(i).key parameters.at(j).key)
       .false
    (_ i j.inc)

  +  entry_valid
    \  entry=projection_entry
    ^  bool
    ?  entry
     > x=projection_entry/node
       ?  !(foundry_delivery/object_valid (projection_object/node x.node))
          .false
       ?  x.node.body
        > y=projection_node_body/hole
          (foundry_view/parameters_unique y.hole.parameters)
        > y=projection_node_body/semantic
          ?  !(foundry_view/parameters_unique y.syntax.parameters)
             .false
          (foundry_view/addresses_unique y.syntax.placements)
     > x=projection_entry/placement
       ?  !(foundry_delivery/object_valid
             (projection_object/placement x.placement))
          .false
       (foundry_view/parameters_unique x.placement.parameters)
     > x=projection_entry/interaction
       (foundry_delivery/object_valid
         (projection_object/interaction x.interaction))
     > x=projection_entry/tombstone
       ?  !(foundry_delivery/address_valid x.tombstone.address)
          .false
       (foundry_delivery/known_target x.tombstone.target)

  +  first_invalid_entry
    \  entries=row[projection_entry]
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i entries.len)
       .none
    ?  !(foundry_view/entry_valid entries.at(i))
       (./some (foundry_delivery/entry_address entries.at(i)))
    (_ i.inc)

  +  first_bad_placement
    '  Every live placement must point at a live parent that declares this
    '  exact occurrence address.  This rejects orphan and surplus edges even
    '  when their child happens to exist.
    \  entries=row[projection_entry]
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i entries.len)
       .none
    ?  entries.at(i)
     > projection_entry/node       (_ i.inc)
     > projection_entry/interaction  (_ i.inc)
     > projection_entry/tombstone  (_ i.inc)
     > x=projection_entry/placement
       ?  !(foundry_delivery/placement_listed x.placement entries)
          (./some x.placement.address)
       (_ i.inc)

  +  first_duplicate_address
    '  Duplicate objects are an incomplete DAG at the duplicated semantic
    '  address; do not discard that evidence behind a boolean validator.
    \  entries=row[projection_entry]
    ^  maybe[projection_address]
    |  > i=nat 0  > j=nat 1
    ^  maybe[projection_address]
    ?  (ge i entries.len)
       .none
    ?  (ge j entries.len)
       (_ i.inc i.inc.inc)
    =  left   (foundry_delivery/entry_address entries.at(i))
       right  (foundry_delivery/entry_address entries.at(j))
    ?  (equal left right)
       (./some left)
    (_ i j.inc)

  +  first_duplicate_interaction_owner
    \  entries=row[projection_entry]
    ^  maybe[projection_address]
    |  > i=nat 0  > j=nat 1
    ^  maybe[projection_address]
    ?  (ge i entries.len)  .none
    ?  (ge j entries.len)  (_ i.inc i.inc.inc)
    ?  entries.at(i)
     > x=projection_entry/interaction
       ?  entries.at(j)
        > y=projection_entry/interaction
          ?  (equal x.interaction.owner y.interaction.owner)
             (./some y.interaction.address)
          (_ i j.inc)
        > projection_entry/node       (_ i j.inc)
        > projection_entry/placement  (_ i j.inc)
        > projection_entry/tombstone  (_ i j.inc)
     > projection_entry/node       (_ i j.inc)
     > projection_entry/placement  (_ i j.inc)
     > projection_entry/tombstone  (_ i j.inc)

  +  first_missing_root
    \  roots=row[projection_address] entries=row[projection_entry]
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i roots.len)
       .none
    =  at  roots.at(i)
    ?  (foundry_delivery/live_node at entries)
     > .none       (./some at)
     > (./some _)  (_ i.inc)

  +  first_unknown_reference
    \  addresses=row[projection_address] dag=projection_dag
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i addresses.len)
       .none
    =  at  addresses.at(i)
    ?  (foundry_delivery/known_reference at dag)
       (_ i.inc)
    (./some at)

  +  first_missing_placement
    \  addresses=row[projection_address] parent=projection_address
       dag=projection_dag
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i addresses.len)
       .none
    =  at  addresses.at(i)
    ?  (foundry_delivery/live_placement at dag.entries)
     > .none
       (./some at)
     > (./some placement=projection_placement)
       ?  (equal placement.parent parent)
          (_ i.inc)
       (./some at)

  +  node_incomplete_at
    \  node=projection_node dag=projection_dag
    ^  maybe[projection_address]
    ?  node.body
     > x=projection_node_body/hole
       ?  x.hole.fallback
        > .none  .none
        > (./some at=projection_address)
          ?  (foundry_delivery/known_reference at dag)  .none
          (./some at)
     > x=projection_node_body/semantic
       ?  (foundry_view/first_missing_placement x.syntax.placements
             node.address dag)
        > (./some at=projection_address)  (./some at)
        > .none
          ?  (foundry_view/first_unknown_reference x.syntax.dependencies dag)
           > (./some at=projection_address)  (./some at)
           > .none
             ?  x.syntax.fallback
              > .none  .none
              > (./some at=projection_address)
                ?  (foundry_delivery/known_reference at dag)  .none
                (./some at)

  +  placement_incomplete_at
    \  placement=projection_placement dag=projection_dag
    ^  maybe[projection_address]
    ?  (foundry_delivery/live_node placement.parent dag.entries)
     > .none
       (./some placement.parent)
     > (./some _)
       ?  placement.target
        > x=projection_placement_target/child
          ?  (foundry_delivery/known_reference x.address dag)  .none
          (./some x.address)
        > x=projection_placement_target/hole
          ?  x.hole.fallback
           > .none  .none
           > (./some at=projection_address)
             ?  (foundry_delivery/known_reference at dag)  .none
             (./some at)

  +  interaction_incomplete_at
    \  interaction=projection_interaction dag=projection_dag
    ^  maybe[projection_address]
    ?  !(foundry_delivery/owner_block interaction.owner dag)
       (./some interaction.owner)
    ?  interaction.destination
     > .none  .none
     > (./some destination=projection_destination_mount)
       ?  (foundry_delivery/known_reference destination.target dag)  .none
       (./some destination.target)

  +  first_incomplete_entry
    \  entries=row[projection_entry] dag=projection_dag
    ^  maybe[projection_address]
    |  > i=nat 0
    ^  maybe[projection_address]
    ?  (ge i entries.len)
       .none
    ?  entries.at(i)
     > x=projection_entry/node
       ?  (foundry_view/node_incomplete_at x.node dag)
        > (./some at=projection_address)  (./some at)
        > .none           (_ i.inc)
     > x=projection_entry/placement
       ?  (foundry_view/placement_incomplete_at x.placement dag)
        > (./some at=projection_address)  (./some at)
        > .none           (_ i.inc)
     > x=projection_entry/interaction
       ?  (foundry_view/interaction_incomplete_at x.interaction dag)
        > (./some at=projection_address)  (./some at)
        > .none           (_ i.inc)
     > projection_entry/tombstone
       (_ i.inc)

  +  incomplete_at
    '  Locate the first failure using the same stable order as completion:
    '  duplicate entries, duplicate interaction owners, manifest roots, then
    '  entry-local requirements.
    \  dag=projection_dag
    ^  maybe[projection_address]
    ?  (foundry_view/first_duplicate_address dag.entries)
     > (./some at=projection_address)  (./some at)
     > .none
       ?  (foundry_view/first_duplicate_interaction_owner dag.entries)
        > (./some at=projection_address)  (./some at)
        > .none
          ?  (foundry_view/first_missing_root dag.manifest.roots dag.entries)
           > (./some at=projection_address)  (./some at)
           > .none
             (foundry_view/first_incomplete_entry dag.entries dag)

  +  open
    '  Admit only a structurally complete, renderer-neutral DAG view.  Invalid
    '  input is refusal data and the graph is not partially repaired.
    \  dag=projection_dag
    ^  projection_view_result
    ?  !(foundry_delivery/manifest_valid dag.manifest)
       (projection_view_result/refused
         (foundry_view/refusal 'invalid_manifest .none))
    ?  (foundry_view/first_invalid_entry dag.entries)
     > (./some at=projection_address)
       (projection_view_result/refused
         (foundry_view/refusal 'invalid_entry (./some at)))
     > .none
       ?  (foundry_view/first_bad_placement dag.entries)
        > (./some at=projection_address)
          (projection_view_result/refused
            (foundry_view/refusal 'invalid_parent (./some at)))
        > .none
          ?  !(foundry_delivery/completion_valid dag)
             (projection_view_result/refused
               (foundry_view/refusal 'incomplete_dag
                 (foundry_view/incomplete_at dag)))
          (projection_view_result/admitted (projection_view dag))

  +  cursor_of
    \  node=projection_node
    ^  projection_cursor
    ?  node.body
     > x=projection_node_body/semantic
       (projection_cursor node.address x.syntax.kind x.syntax.role
         x.syntax.parameters .none x.syntax.placements)
     > x=projection_node_body/hole
       (projection_cursor node.address x.hole.kind x.hole.role
         x.hole.parameters (./some x.hole) [])

  +  cursor_at
    \  address=projection_address view=projection_view
    ^  maybe[projection_cursor]
    ?  (foundry_delivery/find address view.dag.entries)
     > .none  .none
     > (./some entry=projection_entry)
       ?  entry
        > x=projection_entry/node
          (./some (foundry_view/cursor_of x.node))
        > projection_entry/placement  .none
        > projection_entry/interaction  .none
        > projection_entry/tombstone  .none

  +  root
    '  Select one root explicitly; multi-root manifests are not collapsed.
    \  index=nat view=projection_view
    ^  maybe[projection_cursor]
    ?  (ge index view.dag.manifest.roots.len)
       .none
    (foundry_view/cursor_at view.dag.manifest.roots.at(index) view)

  +  children_from
    \  parent=projection_cursor view=projection_view index=nat
       out=row[projection_child]
    ^  projection_children_result
    ?  (ge index parent.placements.len)
       (projection_children_result/admitted out)
    =  address parent.placements.at(index)
    ?  (foundry_delivery/find address view.dag.entries)
     > .none
       (projection_children_result/refused
         (foundry_view/refusal 'placement_missing (./some address)))
     > (./some entry=projection_entry)
       ?  entry
        > x=projection_entry/placement
          ?  !(equal x.placement.parent parent.address)
             (projection_children_result/refused
               (foundry_view/refusal 'invalid_parent (./some address)))
          (foundry_view/children_from parent view index.inc
            out.snoc((projection_child x.placement.address x.placement.role
              x.placement.parameters x.placement.target)))
        > projection_entry/node
          (projection_children_result/refused
            (foundry_view/refusal 'placement_kind_mismatch (./some address)))
        > projection_entry/interaction
          (projection_children_result/refused
            (foundry_view/refusal 'placement_kind_mismatch (./some address)))
        > projection_entry/tombstone
          (projection_children_result/refused
            (foundry_view/refusal 'placement_withdrawn (./some address)))

  +  children
    '  Open the parent's contextual edges in the exact syntax declaration
    '  order.  Shared child definitions remain shared addresses.
    \  parent=projection_cursor view=projection_view
    ^  projection_children_result
    (foundry_view/children_from parent view 0 [])

  +  parameter
    \  key=path cursor=projection_cursor
    ^  maybe[projection_value]
    |  > i=nat 0
    ^  maybe[projection_value]
    ?  (ge i cursor.parameters.len)
       .none
    ?  (eq_pith key cursor.parameters.at(i).key)
       (./some cursor.parameters.at(i).value)
    (_ i.inc)

  '  Small inspection gates for untyped hosts and focused Reaver tests.
  +  result_admitted
    \  result=projection_view_result
    ^  bool
    ?  result
     > projection_view_result/admitted  .true
     > projection_view_result/refused   .false
  +  result_view
    \  result=projection_view_result
    ^  maybe[projection_view]
    ?  result
     > x=projection_view_result/admitted  (./some x.view)
     > projection_view_result/refused     .none
  +  result_code
    \  result=projection_view_result
    ^  maybe[iota]
    ?  result
     > projection_view_result/admitted    .none
     > x=projection_view_result/refused   (./some x.refusal.code)
  +  children_admitted
    \  result=projection_children_result
    ^  bool
    ?  result
     > projection_children_result/admitted  .true
     > projection_children_result/refused   .false
  +  children_items
    \  result=projection_children_result
    ^  maybe[row[projection_child]]
    ?  result
     > x=projection_children_result/admitted  (./some x.children)
     > projection_children_result/refused     .none
  +  cursor_address
    \  cursor=projection_cursor
    ^  projection_address
    cursor.address
  +  cursor_kind
    \  cursor=projection_cursor
    ^  iota
    cursor.kind
  +  cursor_role
    \  cursor=projection_cursor
    ^  path
    cursor.role
  +  cursor_hole
    \  cursor=projection_cursor
    ^  maybe[projection_hole]
    cursor.hole
  +  cursor_placements
    \  cursor=projection_cursor
    ^  row[projection_address]
    cursor.placements
  +  child_placement
    \  child=projection_child
    ^  projection_address
    child.placement
  +  child_role
    \  child=projection_child
    ^  path
    child.role
  +  child_address
    \  child=projection_child
    ^  maybe[projection_address]
    ?  child.target
     > x=projection_placement_target/child  (./some x.address)
     > projection_placement_target/hole     .none
  +  value_text
    \  value=projection_value
    ^  maybe[nat]
    ?  value
     > x=projection_value/text  (./some x.value)
     > projection_value/flag          .none
     > projection_value/count         .none
     > projection_value/name          .none
     > projection_value/semantic_ref  .none
     > projection_value/ref           .none
  +  value_semantic_ref
    \  value=projection_value
    ^  maybe[path]
    ?  value
     > x=projection_value/semantic_ref  (./some x.value)
     > projection_value/flag   .none
     > projection_value/count  .none
     > projection_value/text   .none
     > projection_value/name   .none
     > projection_value/ref    .none
