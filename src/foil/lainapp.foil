+  kern_tasks
  '  The kernel's own behaviors: the HTTP drivers, the explorer, and
  '  the mount form — what a production boot seeds.  The argument is
  '  ignored.
  \  x=nat
  ^  row[task]
  [(vine_make ['kook 'hserve] (formed (http_serve_form 0) (lore1 "HTTP serving: installs the configured responder on request nodes.")))
   (vine_make ['kook 'hfetch] (formed (fetch_form 0) (lore1 "Outbound HTTP: fetch requests ride as records, answers poke back.")))
   (vine_make ['kook 'hrespond] (formed (http_respond_form 0) (lore1 "Default responder: 200, echoing the request body or url.")))
   (vine_make ['kook 'hex] (formed (http_explore_form 0) (lore1 "The namespace explorer over HTTP.")))
   (vine_make ['kook 'dtake] (formed (fetch_form 0) (lore1 "Driver inbox: marks freshly made request kids on the driver record.")))
   (vine_make ['kook 'pact] (formed (pact_form 0) (lore1 "The mount behavior: expands an app manifest into its subtree.")))]
+  demo_tasks
  '  The demo behaviors — registered by the seeded test fixture, not
  '  by production boots.  The argument is ignored.
  \  x=nat
  ^  row[task]
  [(vine_make ['kook 'count] (formed (count_form 0) (lore1 "Demo counter: init makes a counting 'kid child.")))
   (vine_make ['kook 'echo] (formed (echo_form 0) (lore1 "Demo echo behavior, used by the lain tests.")))
   (vine_make ['kook 'spawn] (formed (spawn_form 0) (lore1 "Demo spawner, used by the lain tests.")))
   (vine_make ['kook 'mark] (formed (mark_form 0) (lore1 "Demo marker, used by the lain and crew tests.")))
   (vine_make ['kook 'ma] (formed (ma_form 0) (lore1 "Demo composition behavior a, ordered before mb.")))
   (vine_make ['kook 'mb] (formed (mb_form 0) (lore1 "Demo composition behavior b, ordered after ma.")))
   (vine_make ['kook 'crew] (formed (crew_form 0) (lore1 "Crew demo: talk tracks the node's declared dependency views.")))]
+  reg_tasks
  '  Every behavior, kernel plus demo — the test fixtures' registry.
  '  The argument is ignored.
  \  x=nat
  ^  row[task]
  (kern_tasks 0).weld((demo_tasks 0))
+  root_tasks
  '  The reserved-root records, the record at / first — the namespace
  '  root holds a record before anything is put beneath it.  Each
  '  writable root states its convention (shrine-apps.md section 7).
  '  The argument is ignored.
  \  x=nat
  ^  row[task]
  =  > iodoc
       =  > iod (help_doc_t "I/O driver registry. Each live child names a Helm-managed driver; make, poke, and cull child records to start, reconfigure, or stop it.")
       iod.put(['lore] (lore1 "Driver boundary: each live child names a host-managed driver; skipped by crew subscriptions."))
  [(vine_make [] (root_doc_t "The namespace root.  Reserved kids: /boot the system's own compiled code, /kook the kernel's behavior registry, /app mounted applications, /io drivers, /out outbound commands, /xeno remote paths, /h time travel - each writable root carries its own lore."))
   (vine_make ['kook] (root_doc_t "The kernel's behavior registry, by convention: form nodes at /kook/<id>.  Kook refs are full paths and resolve anywhere."))
   (vine_make ['app] (root_doc_t "Mounted applications: one kid per app, each self-describing.  The default mount root - any root works."))
   (vine_make ['out] (root_doc_t "Outbound command root: cards aimed outside a transaction's subtree leave through here as moves."))
   (vine_make ['io] iodoc)]
+  seed_all
  '  Fold tasks into a fresh sovereign, swallowing failures.
  \  ts=row[task]
  ^  sov
  |  > i=nat 0  > acc=sov (sov/new 0)
  ?  (eq i ts.len)
     acc
  ?  (run_event ts.at(i) 0 acc)
   > ($ripe s2=sov fx=row[move] sg=axal[sign] a=maybe[path])  (_ i.inc s2)
   > ($fail e=quip)  (_ i.inc acc)
+  seeded
  '  The test fixture sovereign: reserved roots plus every behavior,
  '  demo included.  The argument is ignored.
  \  x=nat
  ^  sov
  (seed_all (root_tasks 0).weld((reg_tasks 0)))
+  seeded_kern
  '  A production boot's sovereign: reserved roots and the kernel
  '  behaviors only — the demo registry stays a test fixture.  The
  '  argument is ignored.
  \  x=nat
  ^  sov
  (seed_all (root_tasks 0).weld((kern_tasks 0)))
