- publisher_vocabulary
-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
-  fetch [order=71]
-  http [order=72]
' Shared task helpers and the demo application's counting behavior.
' Runtime boot lives in Eden and requires an explicit sovereign namespace.
+  vine_make
  '  A make command as a task, tagged with its target path.
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/make t))
+  vine_poke
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/poke t))
+  vine_cull
  \  pax=path
  ^  task
  (./vine pax (writ/cull))
+  vine_warp
  '  A warp command as a task: apply the op at `op` to the record at
  '  pax with the transient input.
  \  pax=path op=path input=myth
  ^  task
  (./vine pax (writ/warp op input))
+  install_card
  '  The host install op card, registered under the publisher’s kook/install: warp it
  '  at any root to mount the app named by the input's ['app] text
  '  slot there — the fn returns the app's pact/card, and the warp
  '  arm expands it in place.  fn arrives from the host at boot: it
  '  closes over the boot-compiled manifests and the grant policy,
  '  so authority stays host-side (the mount is where grants are
  '  decided).  Built in foil because nominal rows (op, pact/card)
  '  cannot be minted across the FFI.
  \  fn={\ myth myth}myth
  ^  myth
  .  (myth/new)
     put(['sys 'op] (op 'install 'host [[['app] "t"]] 'app "op install: host > app t < app root card" fn))
     put(bond/lede (pails/t "op install: mount the app named by ['app] at this node"))
+  demo
  '  The demo application's counting behavior.
  +  count_take
    '  Writes the number of children into ['n] whenever a kid
    '  changes.
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    =  kk  b.kids
    =  o   cur.put(['n] (pd kk.wyt.dec))
    (yell [] o)
  +  count_form
    ^  form
    def_form.set_take(demo/count_take)
