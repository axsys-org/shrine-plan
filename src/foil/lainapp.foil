-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  web [order=70]
'  lainapp: demo behaviors, scenario fixtures, and boot seeding for
'  the lain kernel.  App payloads are declared rows — their branded
'  heads are their pail tags (the simple wrappers live at /pails in
'  lain; slot creation goes through /twig and reads through the
'  /myth readers).  The HTTP drivers and the explorer live in web.
+  vine_make
  '  A make command as a task, tagged with its target path.
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/make t))
+  vine_poke
  \  pax=path t=myth
  ^  task
  (./vine pax (writ/poke t))
+  vine_cull
  \  pax=path
  ^  task
  (./vine pax (writ/cull))
+  demo
  '  The demo behaviors — one fixture per arm of the form
  '  vocabulary, registered by the seeded test fixture only.
  +  count_take
    '  Writes the number of children into ['n] whenever a kid
    '  changes.
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    =  kk  b.kids
    =  o   cur.put(['n] (pd kk.wyt.dec))
    (yell [] o)
  +  count_form
    ^  form
    def_form.set_take(demo/count_take)
  +  echo_talk
    '  Default union, plus the poke forwarded to /xeno/log — an
    '  outside-subtree card, so it must route up as an effect.
    \  b=bowl cur=myth add=myth
    ^  yell
    =  o   cur.meld(add)
    =  > cd=[p=path q=writ]  [['xeno 'log] (writ/poke add)]
    (yell [cd] o)
  +  echo_form
    ^  form
    def_form.set_talk(demo/echo_talk)
  +  spawn_init
    '  Makes a 'kid child on creation — an inside-subtree card, so it
    '  runs within the same event.
    \  b=bowl t=myth
    ^  yell
    =  here  b.here
    =  kid   here.snoc('kid)
    =  cd    [kid (writ/make (kooked [['kook 'count]]))]
    (yell [cd] t)
  +  spawn_form
    ^  form
    def_form.set_init(demo/spawn_init)
  +  mark_hear
    '  Writes how many dependency (care, path) pairs changed into
    '  ['heard].
    \  b=bowl cur=myth r=row[dep]
    ^  yell
    =  o  cur.put(['heard] (pd r.len))
    (yell [] o)
  +  mark_form
    ^  form
    def_form.set_hear(demo/mark_hear)
  +  ma_talk
    '  Appends digit 1 to ['ord] — composition-order fixture.  (The
    '  poke parameter shadows the add builtin, hence method
    '  arithmetic.)
    \  b=bowl cur=myth add=myth
    ^  yell
    =  old  cur.nat_at(['ord] 0)
    =  o    cur.put(['ord] (pd old.mul(10).add(1)))
    (yell [] o)
  +  mb_talk
    '  Appends digit 2 to ['ord].
    \  b=bowl cur=myth add=myth
    ^  yell
    =  old  cur.nat_at(['ord] 0)
    =  o    cur.put(['ord] (pd old.mul(10).add(2)))
    (yell [] o)
  +  ma_form
    ^  form
    def_form.set_talk(demo/ma_talk)
  +  mb_form
    ^  form
    def_form.set_talk(demo/mb_talk)
  +  crew_talk
    '  Dependency probe: writes the total entry count across the
    '  hydrated views into ['seen].
    \  b=bowl cur=myth add=myth
    ^  yell
    =  o   cur.meld(add)
    =  es  b.crew.tap
    =  total
         |  > i=nat 0  > acc=nat 0
         ?  (eq i es.len)
            acc
         =  > h es.at(i)
         =  > v h.val
         (_ i.inc acc.add(v.wyt))
    =  o2  o.put(['seen] (pd total))
    (yell [] o2)
  +  crew_form
    ^  form
    def_form.set_talk(demo/crew_talk)
  +  mani
    '  A manifest fixture for the mount tests: the counting behavior
    '  plus one seeded face record.  Built in foil because
    '  nominal-row constructors applied across the FFI produce
    '  non-canonical reps.
    ^  mani
    =  t  myth/new
    (mani 'demo
          (lore/line "The demo app: a counter behavior and a seeded face record.")
          [(kook/decl 'count demo/count_form (lore/line "Counts: init makes a counting 'kid child."))]
          [[['face] t.add((twig/nat ['n] 41))]])
  +  tasks
    '  Registrations for every demo behavior — the test fixtures'
    '  registry; production boots skip them.
    ^  row[task]
    [(vine_make ['kook 'count] (form/card demo/count_form (lore/line "Demo counter: init makes a counting 'kid child.")))
     (vine_make ['kook 'echo] (form/card demo/echo_form (lore/line "Demo echo behavior, used by the lain tests.")))
     (vine_make ['kook 'spawn] (form/card demo/spawn_form (lore/line "Demo spawner, used by the lain tests.")))
     (vine_make ['kook 'mark] (form/card demo/mark_form (lore/line "Demo marker, used by the lain and crew tests.")))
     (vine_make ['kook 'ma] (form/card demo/ma_form (lore/line "Demo composition behavior a, ordered before mb.")))
     (vine_make ['kook 'mb] (form/card demo/mb_form (lore/line "Demo composition behavior b, ordered after ma.")))
     (vine_make ['kook 'crew] (form/card demo/crew_form (lore/line "Crew demo: talk tracks the node's declared dependency views.")))]
+  kooked_bad
  '  A myth whose behavior slot holds a non-kook pail — resolution
  '  must fail with 'kook_bad .
  \  x=nat
  ^  myth
  =  t  myth/new
  t.put(limb_slot (pd x))
+  t_crew
  '  A record carrying one named z-care dependency plus a kook.
  \  slot=path tgt=path refs=row[path]
  ^  myth
  =  t1  (kooked refs)
  t1.put(crew_slot (cpail (crew/sing slot (dep .z tgt))))
+  slot_nat
  '  Committed read of a data slot at a path, with default.
  \  pax=path slot=path d=nat s=sov
  ^  nat
  ?  s.x_latest(pax)
   > (./known t=myth)  t.nat_at(slot d)
  d
+  mk_news
  '  Build a news tree from [pith cared-subscribers] entries.
  \  lit=row[[p=path q=row[dep]]]
  ^  axal[row[dep]]
  (axal/gas[row[dep]] lit (axal/new[row[dep]] .none))
+  kern_mani
  '  The kernel's own behaviors as one app manifest, mounted at the
  '  namespace root: boot seeds a single mount card instead of one
  '  event per form, and the root's lore rides the manifest.
  ^  mani
  (mani 'kern
        (lore/line "The namespace root.  Reserved kids: /boot the system's own compiled code, /kook the kernel's behavior registry, /app mounted applications, /io drivers, /out outbound commands, /xeno remote paths, /h time travel - each writable root carries its own lore.")
        [(kook/decl 'hserve http/serve_form (lore/line "HTTP serving: installs the configured responder on request nodes."))
         (kook/decl 'hfetch fetch/form (lore/line "Outbound HTTP: fetch requests ride as records, answers poke back."))
         (kook/decl 'hrespond http/respond_form (lore/line "Default responder: 200, echoing the request body or url."))
         (kook/decl 'hex explorer/form (lore/line "The namespace explorer over HTTP; /app targets route to the app's own face kook when it declares one."))
         (kook/decl 'dtake fetch/form (lore/line "Driver inbox: marks freshly made request kids on the driver record."))]
        [])
+  kern_tasks
  '  A production boot's behavior seeding, through the pact system:
  '  the mount form first (a mount must resolve it), then the kernel
  '  app mounted at the root — one event installs every kernel
  '  behavior and the root's own lore.
  ^  row[task]
  [(vine_make ['kook 'pact] (form/card pact/form (lore/line "The mount behavior: expands an app manifest into its subtree.")))
   (vine_make [] (pact/card kern_mani "lain"))]
+  root_tasks
  '  The reserved-root records — each writable root states its
  '  convention (shrine-apps.md section 7).  The root record itself
  '  rides the kernel mount (see kern_tasks).
  ^  row[task]
  =  iodoc
       =  > iod (mirror/doc "I/O driver registry. Each live child names a Helm-managed driver; make, poke, and cull child records to start, reconfigure, or stop it.")
       iod.put(bond/lede (pails/t "Driver boundary")).put(bond/help (lore/line "Driver boundary: each live child names a host-managed driver; skipped by crew subscriptions."))
  [(vine_make ['kook] (root/card "The kernel's behavior registry, by convention: form nodes at /kook/<id>.  Kook refs are full paths and resolve anywhere."))
   (vine_make ['app] (root/card "Mounted applications: one kid per app, each self-describing.  The default mount root - any root works."))
   (vine_make ['out] (root/card "Outbound command root: cards aimed outside a transaction's subtree leave through here as moves."))
   (vine_make ['io] iodoc)]
+  reg_tasks
  '  Every behavior, kernel plus demo — the test fixtures' registry.
  ^  row[task]
  kern_tasks.weld(demo/tasks)
+  seed_all
  '  Fold tasks into a fresh sovereign, swallowing failures.
  \  ts=row[task]
  ^  sov
  |  > i=nat 0  > acc=sov sov/new
  ?  (eq i ts.len)
     acc
  ?  (run_event ts.at(i) 0 acc)
   > (./ripe state fx sg a)  (_ i.inc state)
   > (./fail e)  (_ i.inc acc)
+  seeded
  '  The test fixture sovereign: reserved roots plus every behavior,
  '  demo included.
  ^  sov
  (seed_all root_tasks.weld(reg_tasks))
+  seeded_kern
  '  A production boot's sovereign: reserved roots and the kernel
  '  behaviors only — the demo registry stays a test fixture.
  ^  sov
  (seed_all root_tasks.weld(kern_tasks))
