-  lain
'  lainapp: demo behaviors and scenario helpers for the lain kernel.
'  App payloads are declared rows — their branded heads are their
'  pail tags.
+  npail
  '  The demo payload: one nat.
  :  n=nat
+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (npail x)
+  t0
  '  The empty myth; argument ignored.
  \  x=nat
  ^  myth
  (myth/new 0)
+  t_data
  '  A one-slot data myth.
  \  slot=path n=nat
  ^  myth
  =  > t (t0 0)
  t.put(slot (pd n))
+  kooked
  '  An empty myth carrying a kook id list.
  \  ids=path
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (kook ids))
+  kooked_bad
  '  A myth whose behavior slot holds a non-kook pail — resolution
  '  must fail with 'kook_bad .
  \  x=nat
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (pd x))
+  tslot
  '  Read a demo data slot from a myth, with default.
  \  slot=path d=nat t=myth
  ^  nat
  ?  t.get(slot)
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=npail  x.n
     d
+  slot_nat
  '  Committed read of a demo data slot at a path, with default.
  \  pax=path slot=path d=nat s=sov
  ^  nat
  ?  s.x_query(s.top pax)
   > ($known t=myth)  (tslot slot d t)
  d
+  count_take
  '  Writes the number of children into ['n] whenever a kid changes.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > kk b.kids
  =  > o cur.put(['n] (pd kk.wyt.dec))
  (yell [] o)
+  count_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(count_take)
+  echo_talk
  '  Default union, plus the poke forwarded to /xeno/log — an
  '  outside-subtree card, so it must route up as an effect.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > cd [['xeno 'log] ($poke add)]
  (yell [cd] o)
+  echo_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(echo_talk)
+  spawn_init
  '  Makes a 'kid child on creation — an inside-subtree card, so it
  '  runs within the same event.
  \  b=bowl t=myth
  ^  yell
  =  > here b.here
  =  > kid here.snoc('kid)
  =  > cd [kid ($make (kooked ['count]))]
  (yell [cd] t)
+  spawn_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_init(spawn_init)
+  mark_hear
  '  Writes how many dependency (care, path) pairs changed into
  '  ['heard].
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  > o cur.put(['heard] (pd r.len))
  (yell [] o)
+  mark_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_hear(mark_hear)
+  ma_talk
  '  Appends digit 1 to ['ord] — composition-order fixture.  (The
  '  poke parameter shadows the add builtin, hence method arithmetic.)
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(1)))
  (yell [] o)
+  mb_talk
  '  Appends digit 2 to ['ord].
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(2)))
  (yell [] o)
+  ma_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(ma_talk)
+  mb_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(mb_talk)
+  qpail
  '  A quip payload — behavior ids riding as slot values.
  :  q=quip
+  http_respond_talk
  '  The responder the serving kook installs on a request node: the
  '  installing poke's talk answers 200, echoing the request's body
  '  slot (or its url when there is no body).
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > pay
       ?  o.get(['body])
        > ($some pl=pail)  pl
        > $none
          ?  o.get(['url])
           > ($some u=pail)  u
           > $none  (pd 0)
  =  > o1 o.put(['res_status] (pd 200))
  =  > o2 o1.put(['res_body] pay)
  (yell [] o2)
+  http_respond_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(http_respond_talk)
+  http_serve_take
  '  The serving kook for an HTTP driver node: when a request node
  '  appears underneath (an added direct kid in the gift), emit a
  '  poke installing the configured responder kook on it — the same
  '  poke's talk then writes the response, all within the event.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > mrid
       ?  cur.get(['serve])
        > ($some pl=pail)
          ?  pl
           > x=qpail  ($some x.q)
          $none
        > $none  $none
  ?  mrid
   > $none  (yell [] cur)
   > ($some rid=quip)
     =  > here b.here
     =  > es g.tap
     |  > i=nat 0  > cs=row[[p=path q=writ]] []
     ?  (eq i es.len)
        (yell cs cur)
     =  > h es.at(i)
     =  > added
          ?  q
           > $add  (eq 1 p.len)
          0
     ?  added
        =  > tgt here.weld(p)
        =  > kt (kooked [rid])
        =  > cd [tgt ($poke kt)]
        (_ i.inc cs.snoc(cd))
     (_ i.inc cs)
+  http_serve_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(http_serve_take)
+  http_cfg
  '  The record for an HTTP driver node: the serving kook plus the
  '  responder id it installs on request nodes.
  \  rid=quip
  ^  myth
  =  > t1 (kooked ['hserve])
  t1.put(['serve] (qpail rid))
+  http_req
  '  An HTTP request as a namespace record: method, url and body ride
  '  as data pails.  No kook — the serving kook above installs one.
  \  m=nat u=nat bd=nat
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['method] (pd m))
  =  > t3 t2.put(['url] (pd u))
  t3.put(['body] (pd bd))
+  demo_reg
  '  All the demo behaviors, by id.
  \  x=nat
  ^  uon[form]
  =  > r0 (uon/sing[form] 'count (count_form 0))
  =  > r1 r0.put('echo (echo_form 0))
  =  > r2 r1.put('spawn (spawn_form 0))
  =  > r3 r2.put('mark (mark_form 0))
  =  > r4 r3.put('ma (ma_form 0))
  =  > r5 r4.put('mb (mb_form 0))
  =  > r6 r5.put('hserve (http_serve_form 0))
  r6.put('hrespond (http_respond_form 0))
+  sov0
  '  A fresh sovereign; argument ignored.
  \  x=nat
  ^  sov
  (sov/new 0)
+  mk_news
  '  Build a news tree from [pith cared-subscribers] entries.
  \  lit=row[[p=path q=row[dep]]]
  ^  axal[row[dep]]
  (axal/gas[row[dep]] lit (axal/new[row[dep]] $none))
+  vine_make
  '  A make command as a task, tagged with its target path.
  \  pax=path t=myth
  ^  task
  ($vine pax ($make t))
+  vine_poke
  \  pax=path t=myth
  ^  task
  ($vine pax ($poke t))
+  vine_cull
  \  pax=path
  ^  task
  ($vine pax $cull)
