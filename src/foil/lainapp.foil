-  lain
-  weft
-  pact
'  lainapp: demo behaviors and scenario helpers for the lain kernel.
'  App payloads are declared rows — their branded heads are their
'  pail tags.
+  npail
  '  The demo payload: one nat.
  :  n=nat
+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (npail x)
+  t_data
  '  A one-slot data myth.
  \  slot=path n=nat
  ^  myth
  =  > t (t0 0)
  t.put(slot (pd n))
+  pail_slot
  '  Read a slot's raw pail, or a zero npail when absent — host-side
  '  consumers unwrap by rep (the brand cord rides in the head).
  \  slot=path t=myth
  ^  pail
  ?  t.get(slot)
   > ($some pl=pail)  pl
   > $none  (pd 0)
+  txt_slot
  '  Read a text slot: the tpail cord at slot, or 0.
  \  slot=path t=myth
  ^  nat
  ?  t.get(slot)
   > $none  0
   > ($some pl=pail)
     ?  pl
      > t7=tpail  t7.t
     0
+  code_slot
  '  Read a compiled-value slot: the code pail's payload at slot, or 0.
  \  slot=path t=myth
  ^  nat
  ?  t.get(slot)
   > $none  0
   > ($some pl=pail)
     ?  pl
      > c7=code  c7.v
     0
+  has_slot
  '  Whether the myth has anything at slot.
  \  slot=path t=myth
  ^  nat
  t.has(slot)
+  kooked
  '  An empty myth carrying kook refs — full form-node paths.
  \  refs=row[path]
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (kook refs))
+  kooked_bad
  '  A myth whose behavior slot holds a non-kook pail — resolution
  '  must fail with 'kook_bad .
  \  x=nat
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (pd x))
+  tslot
  '  Read a demo data slot from a myth, with default.
  \  slot=path d=nat t=myth
  ^  nat
  ?  t.get(slot)
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=npail  x.n
     d
+  slot_nat
  '  Committed read of a demo data slot at a path, with default.
  \  pax=path slot=path d=nat s=sov
  ^  nat
  ?  s.x_latest(pax)
   > ($known t=myth)  (tslot slot d t)
  d
+  count_take
  '  Writes the number of children into ['n] whenever a kid changes.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > kk b.kids
  =  > o cur.put(['n] (pd kk.wyt.dec))
  (yell [] o)
+  count_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(count_take)
+  echo_talk
  '  Default union, plus the poke forwarded to /xeno/log — an
  '  outside-subtree card, so it must route up as an effect.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > cd [['xeno 'log] ($poke add)]
  (yell [cd] o)
+  echo_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(echo_talk)
+  spawn_init
  '  Makes a 'kid child on creation — an inside-subtree card, so it
  '  runs within the same event.
  \  b=bowl t=myth
  ^  yell
  =  > here b.here
  =  > kid here.snoc('kid)
  =  > cd [kid ($make (kooked [['kook 'count]]))]
  (yell [cd] t)
+  spawn_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_init(spawn_init)
+  mark_hear
  '  Writes how many dependency (care, path) pairs changed into
  '  ['heard].
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  > o cur.put(['heard] (pd r.len))
  (yell [] o)
+  mark_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_hear(mark_hear)
+  ma_talk
  '  Appends digit 1 to ['ord] — composition-order fixture.  (The
  '  poke parameter shadows the add builtin, hence method arithmetic.)
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(1)))
  (yell [] o)
+  mb_talk
  '  Appends digit 2 to ['ord].
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(2)))
  (yell [] o)
+  ma_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(ma_talk)
+  mb_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(mb_talk)
+  qpail
  '  A quip payload — behavior ids riding as slot values.
  :  q=quip
+  crew_one
  '  A crew of one: a single named dependency.
  \  slot=path d=dep
  ^  crew
  (mop/put[path dep lt_pith] slot d (mop/empty))
+  crew_talk
  '  Dependency probe: writes the total entry count across the
  '  hydrated views into ['seen].
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > cw b.crew
  =  > es cw.tap
  =  > total
       |  > i=nat 0  > acc=nat 0
       ?  (eq i es.len)
          acc
       =  > h es.at(i)
       =  > v h.val
       (_ i.inc acc.add(v.wyt))
  =  > o2 o.put(['seen] (pd total))
  (yell [] o2)
+  crew_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(crew_talk)
+  t_crew
  '  A record carrying one named z-care dependency plus a kook.
  \  slot=path tgt=path refs=row[path]
  ^  myth
  =  > t1 (kooked refs)
  t1.put((crew_slot 0) (cpail (crew_one slot (dep $z tgt))))
+  http_respond_talk
  '  The responder the serving kook installs on a request node: the
  '  installing poke's talk answers 200, echoing the request's body
  '  slot (or its url when there is no body).
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > pay
       ?  o.get(['body])
        > ($some pl=pail)  pl
        > $none
          ?  o.get(['url])
           > ($some u=pail)  u
           > $none  (pd 0)
  =  > o1 o.put(['res_status] (pd 200))
  =  > o2 o1.put(['res_body] pay)
  (yell [] o2)
+  http_respond_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(http_respond_talk)
+  http_serve_take
  '  The serving kook for an HTTP driver node: when a request node
  '  appears underneath (an added direct kid in the gift), emit a
  '  poke installing the configured responder kook on it — the same
  '  poke's talk then writes the response, all within the event.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > mrid
       ?  cur.get(['serve])
        > ($some pl=pail)
          ?  pl
           > x=qpail  ($some x.q)
          $none
        > $none  $none
  ?  mrid
   > $none  (yell [] cur)
   > ($some rid=quip)
     =  > here b.here
     =  > es g.tap
     |  > i=nat 0  > cs=row[[p=path q=writ]] []
     ?  (eq i es.len)
        (yell cs cur)
     =  > h es.at(i)
     =  > added
          ?  q
           > $add  (eq 1 p.len)
          0
     ?  added
        =  > tgt here.weld(p)
        =  > kt (kooked [(kook_root 0).snoc(rid)])
        =  > cd [tgt ($poke kt)]
        (_ i.inc cs.snoc(cd))
     (_ i.inc cs)
+  http_serve_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(http_serve_take)
+  ppail
  '  A path payload — request targets riding as slot values.
  :  p=path
+  show_iota
  '  A quip as text: text auras ride their cord, the rest render
  '  their payload as decimal.
  \  i=quip
  ^  nat
  ?  (is_text i)
     (quip_val i)
  (weft/show_nat (quip_val i))
+  show_path
  '  A path as "/a/b"; the empty path as "/".
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     "/"
  =  > parts
       |  > i=nat 0  > acc=row[nat] []
       ?  (eq i p.len)
          acc
       (_ i.inc acc.snoc((show_iota p.at(i))))
  (weft/cat2 "/" (weft/join "/" parts))
+  show_pail
  '  A slot value as text: the payloads this app knows, and a shrug
  '  for the open remainder.
  \  pl=pail
  ^  nat
  ?  pl
   > x=npail  (weft/show_nat x.n)
   > q2=qpail  (show_iota q2.q)
   > p2=ppail  (show_path p2.p)
   > k=kook
     =  > refs k.refs
     =  > parts
          |  > i=nat 0  > acc=row[nat] []
          ?  (eq i refs.len)
             acc
          (_ i.inc acc.snoc((show_path refs.at(i))))
     (weft/cat2 "kook " (weft/join " " parts))
   > c3=cpail
     =  > cm c3.crew
     (weft/cat2 "crew " (weft/show_nat cm.size))
   > f4=form  "form"
   > t5=tpail  t5.t
   > c5=code  "code"
   > l6=lore
     ?  (eq 0 l6.tests.len)
        l6.head
     (weft/cat2 l6.head (weft/cat2 "  [?= " (weft/cat2 (weft/show_nat l6.tests.len) "]")))
  "opaque"
+  ns_css
  '  The explorer stylesheet.  The argument is ignored.
  \  x=nat
  ^  nat
  "body{background:#101418;color:#cfd8dc;font-family:monospace;font-size:13px;margin:2em} a{color:#7fd4c1;text-decoration:none} h1{color:#f0b429;font-size:15px} h2{color:#f0b429;font-size:13px;margin-top:1.5em} .row{padding:4px 8px;border-bottom:1px solid #2a333b} .row:hover{background:#161c22} .key{color:#f0b429;margin-right:8px} .muted{color:#6b7680} pre{white-space:pre-wrap;margin:4px 0;color:#cfd8dc} .lore-head{color:#e8edf0;font-size:14px;margin:12px 0 2px} .lore-body{color:#8fa1ab;margin:2px 0 10px} .lore-line{padding:1px 0} .khead{margin-left:14px} .chip{padding:1px 7px;border-radius:9px;font-size:11px;margin-left:10px} .ok{background:#123f2a;color:#7fd4a1} .bad{background:#4a1520;color:#f08a9b} .mut{background:#242e36;color:#8fa1ab} .dtsrc{color:#cdd7dc}"
+  ns_url
  '  The explorer href for a path.
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     "/ns"
  (weft/cat2 "/ns" (show_path p))
+  ns_case_count
  '  Read one decimal counter from a version-view myth.
  \  key=path t=myth
  ^  nat
  ?  (dig_parse (txt_slot key t))
   > ($some n=nat)  n
   > $none  0
+  ns_case_links
  '  Links for one target-local care history, cases 1 through n.
  \  cr=quip n=nat tgt=path
  ^  row[weft/node]
  |  > i=nat 1  > acc=row[weft/node] []
  ?  (gt i n)
     acc
  =  > hp ['h cr ($u i) ($u tgt.len)]
  =  > lnk (weft/leaf "a" [(weft/href (ns_url hp.weld(tgt)))] (show_iota ($u i)))
  =  > a1 acc.snoc((weft/tx " "))
  (_ i.inc a1.snoc(lnk))
+  dt_chip
  '  One doctest's verdict chip: pass/got from the verdict's results,
  '  greyed when the verdict's case is behind the node's current x
  '  case (curx as decimal text; 0 = unknown, no staleness call).
  \  v=dt_verdict curx=nat j=nat
  ^  weft/node
  =  > stale
       ?  (eq 0 curx)
          0
       ?  (eq curx (weft/show_nat v.case))
          0
       1
  ?  (ge j v.results.len)
     (weft/leaf "span" [(weft/cls "chip mut")] "no result")
  ?  stale
     (weft/leaf "span" [(weft/cls "chip mut")] (weft/cat2 "stale v" (weft/show_nat v.case)))
  =  > re v.results.at(j)
  ?  pass
     (weft/leaf "span" [(weft/cls "chip ok")] "pass")
  (weft/leaf "span" [(weft/cls "chip bad")] (weft/cat2 "got " got))
+  dt_row1
  '  One rendered doctest row.
  \  src2=nat want2=nat chip=weft/node
  ^  weft/node
  (weft/el "div" [(weft/cls "row")]
    [(weft/tx "?=  ")
     (weft/leaf "span" [(weft/cls "dtsrc")] src2)
     (weft/tx "  ->  ")
     (weft/leaf "span" [(weft/cls "dtsrc")] want2)
     chip])
+  dt_rows
  '  A lore's doctests with verdict chips.
  \  l=lore v=dt_verdict curx=nat
  ^  row[weft/node]
  |  > j=nat 0  > acc=row[weft/node] []
  ?  (ge j l.tests.len)
     acc
  =  > te l.tests.at(j)
  (_ j.inc acc.snoc((dt_row1 src want (dt_chip v curx j))))
+  dt_rows_never
  '  A lore's doctests, never yet run.
  \  l=lore
  ^  row[weft/node]
  |  > j=nat 0  > acc=row[weft/node] []
  ?  (ge j l.tests.len)
     acc
  =  > te l.tests.at(j)
  (_ j.inc acc.snoc((dt_row1 src want (weft/leaf "span" [(weft/cls "chip mut")] "never run"))))
+  ns_page
  '  The node browser: breadcrumbs, the node's own lore (head, body,
  '  and doctests with verdict chips from the /dt kid), the record's
  '  slots (paths as links), kid links annotated with their lore
  '  heads — plus time travel: the node's version view with links
  '  into its history, and a live link back out of /h pages.
  \  tgt=path fat=axal[myth] ver=axal[myth]
  ^  nat
  =  > root (weft/leaf "a" [(weft/href "/ns")] "ns")
  =  > crumbs
       |  > i=nat 0  > acc=row[weft/node] [root]
       ?  (eq i tgt.len)
          acc
       =  > pre tgt.take(i.inc)
       =  > lnk (weft/leaf "a" [(weft/href (ns_url pre))] (show_iota tgt.at(i)))
       =  > a1 acc.snoc((weft/tx " / "))
       (_ i.inc a1.snoc(lnk))
  =  > nav
       =  > hlnk (weft/leaf "a" [(weft/href "/ns/h") (weft/cls "muted")] "time travel")
       ?  (is_h tgt)
          ?  (lt tgt.len 3)
             [hlnk]
          =  > shift
               ?  (eq_iota tgt.at(1) 'v)
                  3
               4
          ?  (lt tgt.len shift)
             [hlnk]
          =  > live tgt.drop(shift)
          =  > llnk (weft/leaf "a" [(weft/href (ns_url live))] "view live")
          [hlnk (weft/tx " | ") llnk]
       [hlnk]
  =  > curx
       ?  ver.fil
        > ($some vt=myth)  (txt_slot ['x_data] vt)
        > $none  0
  =  > docpane
       ?  fat.fil
        > $none  []
        > ($some t=myth)
          ?  t.get(['lore])
           > $none  []
           > ($some pl=pail)
             ?  pl
              > l=lore
                =  > brows
                     |  > j=nat 1  > acc=row[weft/node] []
                     ?  (ge j l.body.len)
                        acc
                     (_ j.inc acc.snoc((weft/leaf "div" [(weft/cls "lore-line")] l.body.at(j))))
                =  > trows
                     ?  fat.dip(['dt]).fil
                      > ($some dtm=myth)
                        ?  dtm.get(['dt])
                         > ($some pl2=pail)
                           ?  pl2
                            > v9=dt_verdict  (dt_rows l v9 curx)
                           (dt_rows_never l)
                         > $none  (dt_rows_never l)
                      > $none  (dt_rows_never l)
                =  > topr
                     [(weft/el "div" [(weft/cls "lore-head")] [(weft/tx l.head)])
                      (weft/el "div" [(weft/cls "lore-body")] brows)]
                topr.weld(trows)
             []
  =  > slots
       ?  fat.fil
        > $none  [(weft/leaf "div" [(weft/cls "muted")] "no record at this node")]
        > ($some t=myth)
          =  > es t.tap
          ?  (eq 0 es.len)
             [(weft/leaf "div" [(weft/cls "muted")] "empty record")]
          |  > i=nat 0  > acc=row[weft/node] []
          ?  (eq i es.len)
             acc
          =  > h es.at(i)
          ?  (eq_pith h.key ['lore])
             (_ i.inc acc)
          =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
          =  > vn
               ?  h.val
                > t6=tpail
                  ?  (eq_pith h.key ['module])
                     (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" t6.t))] t6.t)
                  (weft/leaf "pre" [] t6.t)
                > p9=ppail  (weft/leaf "a" [(weft/href (ns_url p9.p))] (show_path p9.p))
               (weft/tx (show_pail h.val))
          (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [kn vn])))
  =  > kids
       =  > ks fat.kid.tap
       ?  (eq 0 ks.len)
          [(weft/leaf "div" [(weft/cls "muted")] "no kids")]
       |  > i=nat 0  > acc=row[weft/node] []
       ?  (eq i ks.len)
          acc
       =  > h ks.at(i)
       =  > kp tgt.snoc(h.key)
       =  > lnk (weft/leaf "a" [(weft/href (ns_url kp))] (show_iota h.key))
       =  > khead
            ?  fat.kid.get(h.key)
             > ($some ka=axal[myth])
               ?  ka.fil
                > ($some kt=myth)
                  ?  kt.get(['lore])
                   > ($some kpl=pail)
                     ?  kpl
                      > kl=lore  (weft/leaf "span" [(weft/cls "muted khead")] kl.head)
                     (weft/tx "")
                   > $none  (weft/tx "")
                > $none  (weft/tx "")
             > $none  (weft/tx "")
       (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [lnk khead])))
  =  > vpane
       ?  ver.fil
        > $none  []
        > ($some vt=myth)
          =  > es vt.tap
          =  > vrows
               |  > i=nat 0  > acc=row[weft/node] []
               ?  (eq i es.len)
                  acc
               =  > h es.at(i)
               =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
               =  > vn (weft/tx (show_pail h.val))
               (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [kn vn])))
          =  > xc (ns_case_count ['x_data] vt)
          =  > yc (ns_case_count ['y_data] vt)
          =  > zc (ns_case_count ['z_data] vt)
          =  > xr (ns_case_links 'x xc tgt)
          =  > yr (ns_case_links 'y yc tgt)
          =  > zr (ns_case_links 'z zc tgt)
          =  > vh [(weft/leaf "h2" [] "version")]
          =  > v1 vh.weld(vrows)
          =  > hh
               [(weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "x cases") (weft/el "span" [] xr)])
                (weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "y cases") (weft/el "span" [] yr)])
                (weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "z cases") (weft/el "span" [] zr)])]
          v1.weld(hh)
  =  > head [(weft/el "h1" [] crumbs) (weft/el "div" [(weft/cls "muted")] nav)]
  =  > b0 head.weld(docpane)
  =  > b0r b0.snoc((weft/leaf "h2" [] "record"))
  =  > b1 b0r.weld(slots)
  =  > b2 b1.snoc((weft/leaf "h2" [] "kids"))
  =  > b3 b2.weld(kids)
  =  > body b3.weld(vpane)
  (weft/page (show_path tgt) (ns_css 0) body)
+  http_explore_talk
  '  The namespace explorer responder: render the request's hydrated
  '  target view as the node browser page.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > tgt
       ?  o.get(['vpath])
        > ($some pl=pail)
          ?  pl
           > x=ppail  x.p
          []
        > $none  []
  =  > cw b.crew
  =  > fat cw.gut(['view] (axal/new[myth] $none))
  =  > ver cw.gut(['ver] (axal/new[myth] $none))
  =  > html (ns_page tgt fat ver)
  =  > o1 o.put(['res_status] (pd 200))
  =  > o2 o1.put(['res_body] (pd html))
  =  > o3 o2.put(['res_ctype] (pd "text/html; charset=utf-8"))
  (yell [] o3)
+  http_explore_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(http_explore_talk)
+  http_cfg
  '  The record for an HTTP driver node: the serving kook plus the
  '  responder id it installs on request nodes.
  \  rid=quip
  ^  myth
  =  > t1 (kooked [['kook 'hserve]])
  t1.put(['serve] (qpail rid))
+  http_cfg_port
  '  A live driver config: serving kook, responder id, and the TCP
  '  port (the worker reads it at birth, so it must ride the make).
  \  rid=quip port=nat
  ^  myth
  =  > t1 (http_cfg rid)
  t1.put(['port] (pd port))
+  http_req
  '  An HTTP request as a namespace record: method, url and body ride
  '  as data pails, the parsed target as a ppail, a z-care dep on the
  '  target so responders get its hydrated view, and — for live
  '  targets — a y-care dep on the target's /h/v version view.  No
  '  kook: the serving kook above installs one.
  \  m=nat u=nat bd=nat tgt=path
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['method] (pd m))
  =  > t3 t2.put(['url] (pd u))
  =  > t4 t3.put(['body] (pd bd))
  =  > t5 t4.put(['vpath] (ppail tgt))
  =  > cw1 (crew_one ['view] (dep $z tgt))
  =  > cw
       ?  (is_h tgt)
          cw1
       ?  (eq 0 tgt.len)
          cw1
