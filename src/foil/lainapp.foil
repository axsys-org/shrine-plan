-  lain
-  weft
-  pact
-  file
-  nsassets
'  lainapp: demo behaviors and scenario helpers for the lain kernel.
'  App payloads are declared rows — their branded heads are their
'  pail tags.
+  npail
  '  The demo payload: one nat.
  :  n=nat
+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (npail x)
+  t_data
  '  A one-slot data myth.
  \  slot=path n=nat
  ^  myth
  =  > t (t0 0)
  t.put(slot (pd n))
+  space_state_t
  '  Browser-authored Space composition as an opaque transport payload.
  '  Flow, trace, and plate semantics stay above this storage record; Lain
  '  owns the live occurrence and its version history.
  \  state=nat
  ^  myth
  =  > t (t0 0)
  t.put(['state] (tpail state))
+  pail_slot
  '  Read a slot's raw pail, or a zero npail when absent — host-side
  '  consumers unwrap by rep (the brand cord rides in the head).
  \  slot=path t=myth
  ^  pail
  ?  t.get(slot)
   > ($some pl=pail)  pl
   > $none  (pd 0)
+  txt_slot
  '  Read a text slot: the tpail cord at slot, or 0.
  \  slot=path t=myth
  ^  nat
  ?  t.get(slot)
   > $none  0
   > ($some pl=pail)
     ?  pl
      > t7=tpail  t7.t
     0
+  code_slot
  '  Read a compiled-value slot: the code pail's payload at slot, or 0.
  \  slot=path t=myth
  ^  nat
  ?  t.get(slot)
   > $none  0
   > ($some pl=pail)
     ?  pl
      > c7=code  c7.v
     0
+  has_slot
  '  Whether the myth has anything at slot.
  \  slot=path t=myth
  ^  nat
  t.has(slot)
+  kooked
  '  An empty myth carrying kook refs — full form-node paths.
  \  refs=row[path]
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (kook refs))
+  kooked_bad
  '  A myth whose behavior slot holds a non-kook pail — resolution
  '  must fail with 'kook_bad .
  \  x=nat
  ^  myth
  =  > t (t0 0)
  t.put((kook_slot 0) (pd x))
+  tslot
  '  Read a demo data slot from a myth, with default.
  \  slot=path d=nat t=myth
  ^  nat
  ?  t.get(slot)
   > $none  d
   > ($some pl=pail)
     ?  pl
      > x=npail  x.n
     d
+  slot_nat
  '  Committed read of a demo data slot at a path, with default.
  \  pax=path slot=path d=nat s=sov
  ^  nat
  ?  s.x_latest(pax)
   > ($known t=myth)  (tslot slot d t)
  d
+  count_take
  '  Writes the number of children into ['n] whenever a kid changes.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > kk b.kids
  =  > o cur.put(['n] (pd kk.wyt.dec))
  (yell [] o)
+  count_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(count_take)
+  echo_talk
  '  Default union, plus the poke forwarded to /xeno/log — an
  '  outside-subtree card, so it must route up as an effect.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > cd [['xeno 'log] ($poke add)]
  (yell [cd] o)
+  echo_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(echo_talk)
+  spawn_init
  '  Makes a 'kid child on creation — an inside-subtree card, so it
  '  runs within the same event.
  \  b=bowl t=myth
  ^  yell
  =  > here b.here
  =  > kid here.snoc('kid)
  =  > cd [kid ($make (kooked [['kook 'count]]))]
  (yell [cd] t)
+  spawn_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_init(spawn_init)
+  mark_hear
  '  Writes how many dependency (care, path) pairs changed into
  '  ['heard].
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  =  > o cur.put(['heard] (pd r.len))
  (yell [] o)
+  mark_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_hear(mark_hear)
+  ma_talk
  '  Appends digit 1 to ['ord] — composition-order fixture.  (The
  '  poke parameter shadows the add builtin, hence method arithmetic.)
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(1)))
  (yell [] o)
+  mb_talk
  '  Appends digit 2 to ['ord].
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > old (tslot ['ord] 0 cur)
  =  > o cur.put(['ord] (pd old.mul(10).add(2)))
  (yell [] o)
+  ma_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(ma_talk)
+  mb_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(mb_talk)
+  qpail
  '  A quip payload — behavior ids riding as slot values.
  :  q=quip
+  crew_one
  '  A crew of one: a single named dependency.
  \  slot=path d=dep
  ^  crew
  (mop/put[path dep lt_pith] slot d (mop/empty))
+  crew_talk
  '  Dependency probe: writes the total entry count across the
  '  hydrated views into ['seen].
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > cw b.crew
  =  > es cw.tap
  =  > total
       |  > i=nat 0  > acc=nat 0
       ?  (eq i es.len)
          acc
       =  > h es.at(i)
       =  > v h.val
       (_ i.inc acc.add(v.wyt))
  =  > o2 o.put(['seen] (pd total))
  (yell [] o2)
+  crew_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(crew_talk)
+  t_crew
  '  A record carrying one named z-care dependency plus a kook.
  \  slot=path tgt=path refs=row[path]
  ^  myth
  =  > t1 (kooked refs)
  t1.put((crew_slot 0) (cpail (crew_one slot (dep $z tgt))))
+  http_respond_talk
  '  The responder the serving kook installs on a request node: the
  '  installing poke's talk answers 200, echoing the request's body
  '  slot (or its url when there is no body).
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > pay
       ?  o.get(['body])
        > ($some pl=pail)  pl
        > $none
          ?  o.get(['url])
           > ($some u=pail)  u
           > $none  (pd 0)
  =  > o1 o.put(['res_status] (pd 200))
  =  > o2 o1.put(['res_body] pay)
  (yell [] o2)
+  http_respond_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(http_respond_talk)
+  http_serve_take
  '  The serving kook for an HTTP driver node: when a request node
  '  appears underneath (an added direct kid in the gift), emit a
  '  poke installing the configured responder kook on it — the same
  '  poke's talk then writes the response, all within the event.
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > mrid
       ?  cur.get(['serve])
        > ($some pl=pail)
          ?  pl
           > x=qpail  ($some x.q)
          $none
        > $none  $none
  ?  mrid
   > $none  (yell [] cur)
   > ($some rid=quip)
     =  > here b.here
     =  > es g.tap
     |  > i=nat 0  > cs=row[[p=path q=writ]] []
     ?  (eq i es.len)
        (yell cs cur)
     =  > h es.at(i)
     =  > added
          ?  q
           > $add  (eq 1 p.len)
          0
     ?  added
        =  > tgt here.weld(p)
        =  > kt (kooked [(kook_root 0).snoc(rid)])
        =  > cd [tgt ($poke kt)]
        (_ i.inc cs.snoc(cd))
     (_ i.inc cs)
+  http_serve_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(http_serve_take)
+  ppail
  '  A path payload — request targets riding as slot values.
  :  p=path
+  intent_t
  '  A generic namespace intent.  Drivers may transport one of these,
  '  but only the receiving record's behavior assigns meaning to its id.
  '  The target is always present: the empty path is the namespace root,
  '  not an omitted value.  Behaviors that do not use a target ignore it.
  \  id=quip target=path
  ^  myth
  =  > t (t0 0)
  =  > t2 t.put(['intent] (qpail id))
  t2.put(['target] (ppail target))
+  show_iota
  '  A quip as text: text auras ride their cord, the rest render
  '  their payload as decimal.
  \  i=quip
  ^  nat
  ?  (is_text i)
     (quip_val i)
  (weft/show_nat (quip_val i))
+  show_path
  '  A path as "/a/b"; the empty path as "/".
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     "/"
  =  > parts
       |  > i=nat 0  > acc=row[nat] []
       ?  (eq i p.len)
          acc
       (_ i.inc acc.snoc((show_iota p.at(i))))
  (weft/cat2 "/" (weft/join "/" parts))
+  show_pail
  '  A slot value as text: the payloads this app knows, and a shrug
  '  for the open remainder.
  \  pl=pail
  ^  nat
  ?  pl
   > x=npail  (weft/show_nat x.n)
   > q2=qpail  (show_iota q2.q)
   > p2=ppail  (show_path p2.p)
   > k=kook
     =  > refs k.refs
     =  > parts
          |  > i=nat 0  > acc=row[nat] []
          ?  (eq i refs.len)
             acc
          (_ i.inc acc.snoc((show_path refs.at(i))))
     (weft/cat2 "kook " (weft/join " " parts))
   > c3=cpail
     =  > cm c3.crew
     (weft/cat2 "crew " (weft/show_nat cm.size))
   > f4=form  "form"
   > t5=tpail  t5.t
   > c5=code  "code"
   > ff=file_format  ff.media_type
   > fo=file_occurrence
     (weft/cat ["file " fo.format.media_type " " (weft/show_nat (wid fo.content)) " bytes"])
   > l6=lore
     ?  (eq 0 l6.tests.len)
        l6.head
     (weft/cat2 l6.head (weft/cat2 "  [?= " (weft/cat2 (weft/show_nat l6.tests.len) "]")))
  "opaque"
+  ns_css
  '  The explorer stylesheet.  The argument is ignored.
  \  x=nat
  ^  nat
  (weft/cat
    [":root{color-scheme:light;--font:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;--chrome:#171717;--chrome-raised:#252525;--surface:#f7f7f5;--panel:#fff;--panel-muted:#f3f3f1;--canvas:#fafaf8;--ink:#202123;--muted:#6f6f6f;--faint:#9b9b9b;--line:#e6e6e3;--line-strong:#d2d2cf;--accent:#2563eb;--accent-soft:#e8f0fe;--signal:#d99a25;--success:#1f9d6a;--danger:#d94f4f;--header:42px;--space-left:216px;--left:216px;--right:272px;--control:30px;--radius:6px}"
     "*{box-sizing:border-box}html,body{width:100%;height:100%}body{margin:0;overflow:hidden;background:var(--surface);color:var(--ink);font:13px/1.45 var(--font)}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}pre{min-width:0;margin:0;overflow-wrap:anywhere;white-space:pre-wrap;font:12px/1.5 var(--mono)}"
     ".ns-app{display:grid;grid-template-columns:var(--space-left) minmax(0,1fr);width:100%;height:100dvh;overflow:hidden;background:var(--surface)}.namespace-view{position:relative;display:grid;grid-template-rows:var(--header) minmax(0,1fr);min-width:0;min-height:0;overflow:hidden}"
     ".ns-chrome{z-index:20;display:grid;grid-template-columns:max-content minmax(0,1fr) max-content;align-items:center;gap:8px;height:var(--header);padding:5px 8px;border-bottom:1px solid #303030;background:var(--chrome);color:#f7f7f7}"
     ".crumbs{display:flex;align-items:center;min-width:0;height:30px;padding:0 8px;overflow:auto;scrollbar-width:none;white-space:nowrap}.crumbs a{color:var(--muted);font-size:12px}.crumbs a:last-child{color:var(--ink);font-weight:600}.crumb-sep{padding:0 7px;color:var(--faint)}"
     ".chrome-leading,.chrome-actions{display:flex;align-items:center;gap:4px}.chrome-actions{justify-content:flex-end}.chrome-link,.sidebar-toggle,.locus>summary,.plus-menu>summary{display:inline-flex;align-items:center;justify-content:center;min-height:30px;border-radius:var(--radius);color:#aaa;font-size:12px}.chrome-link{padding:0 10px}.chrome-link:hover,.sidebar-toggle:hover,.locus>summary:hover,.plus-menu>summary:hover{background:#2c2c2c;color:#fff}.live-link{color:#8db3ff}.sidebar-switch{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}.sidebar-toggle{width:30px;cursor:pointer;font-size:0}.sidebar-toggle:before{width:13px;height:13px;border:1px solid currentColor;border-radius:2px;box-shadow:inset 4px 0 0 #171717;content:''}.sidebar-switch:focus-visible~.ns-chrome .sidebar-toggle{outline:2px solid var(--accent);outline-offset:2px}"
     ".tab-strip{display:flex;align-items:center;align-self:stretch;min-width:0;overflow:visible}.tab-list{display:flex;align-items:center;min-width:0;overflow-x:auto;scrollbar-width:none}.view-tab{position:relative;display:flex;align-items:center;min-width:118px;max-width:220px;height:30px;margin:0 1px;border-radius:8px;color:#aaa}.view-tab+.view-tab:before{position:absolute;left:-2px;width:1px;height:16px;background:#343434;content:''}.view-tab[aria-current=page]{background:#303030;color:#f1f1f1}.view-tab[aria-current=page]:before,.view-tab[aria-current=page]+.view-tab:before{display:none}.view-tab-link{display:flex;align-items:center;gap:7px;min-width:0;height:100%;padding:0 24px 0 10px}.view-tab-link:before{width:12px;height:12px;flex:0 0 12px;border:1px solid currentColor;border-radius:3px;content:''}.view-tab-label{min-width:0;overflow:hidden;font-size:12px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.view-tab-close{position:absolute;right:5px;display:none;width:18px;height:18px;padding:0;border:0;border-radius:4px;background:transparent;color:#8c8c8c;cursor:pointer}.view-tab:hover .view-tab-close,.view-tab[aria-current=page] .view-tab-close{display:block}.view-tab-close:hover{background:#464646;color:#fff}.view-tab-close:before,.view-tab-close:after{position:absolute;top:5px;left:8px;width:1px;height:8px;background:currentColor;content:'';transform:rotate(45deg)}.view-tab-close:after{transform:rotate(-45deg)}"
     ".locus{position:relative}.locus>summary{width:30px;cursor:pointer;font-size:0;list-style:none}.locus>summary::-webkit-details-marker,.plus-menu>summary::-webkit-details-marker,.tree-summary::-webkit-details-marker{display:none}.locus>summary:before{width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:7px solid currentColor;content:'';transition:transform 120ms}.locus[open]>summary:before{transform:rotate(90deg)}.locus[open]>summary{background:#2c2c2c;color:#fff}.locus-popover{position:absolute;z-index:30;top:34px;left:0;width:340px;max-height:min(460px,70vh);padding:6px;overflow:auto;border:1px solid #3e3e3e;border-radius:8px;background:#242424;box-shadow:0 14px 38px rgb(0 0 0 / .28)}.locus-head{display:flex;align-items:center;justify-content:space-between;min-height:30px;padding:0 8px;color:#8f8f8f;font-size:10px;text-transform:uppercase}.locus-head:not(:first-child){margin-top:5px;border-top:1px solid #353535}.locus-row{display:flex;align-items:center;gap:9px;min-height:34px;padding:0 9px;border-radius:var(--radius);color:#ddd;font-size:12px}.locus-row:hover{background:#333;color:#fff}.locus-row:before{width:12px;height:12px;flex:0 0 12px;border:1px solid #777;border-radius:3px;content:''}.locus-row span{margin-left:auto;max-width:180px;overflow:hidden;color:#777;font:10px var(--mono);text-overflow:ellipsis;white-space:nowrap}.locus-current{background:#2d2d2d;color:#fff}.relation-row:before{border-radius:50%;box-shadow:inset 0 0 0 3px #242424;background:#777}.locus-empty{min-height:30px;padding:7px 9px;color:#666;font-size:11px}"
     ".plus-menu{position:relative;flex:0 0 auto;margin-left:4px}.plus-menu>summary{width:28px;min-height:28px;border:1px solid #3a3a3a;border-radius:50%;cursor:pointer;font-size:18px;line-height:1;list-style:none}.plus-menu[open]>summary{background:#303030;color:#fff}.plus-popover{position:absolute;top:32px;right:0;width:240px;max-height:min(420px,65vh);padding:6px;overflow:auto;border:1px solid #3e3e3e;border-radius:8px;background:#242424;box-shadow:0 14px 38px rgb(0 0 0 / .28)}.plus-popover a{display:flex;align-items:center;justify-content:space-between;min-height:34px;padding:0 9px;border-radius:var(--radius);color:#ddd;font-size:12px}.plus-popover a:hover{background:#333;color:#fff}.plus-popover span{max-width:120px;overflow:hidden;color:#777;font:10px var(--mono);text-overflow:ellipsis;white-space:nowrap}"
     ".explorer-shell{display:grid;grid-template-columns:var(--left) minmax(0,1fr) var(--right);min-width:0;min-height:0;overflow:hidden;background:var(--canvas)}"
     ".sidebar-switch:not(:checked)~.explorer-shell{grid-template-columns:0 minmax(0,1fr) var(--right)}.sidebar-switch:not(:checked)~.explorer-shell>.tree-panel{visibility:hidden;opacity:0;pointer-events:none}"
     ".space-rail,.tree-panel,.inspector-panel{min-width:0;min-height:0;overflow:auto;background:var(--panel)}.space-rail{z-index:22;border-right:1px solid var(--line-strong)}.tree-panel{border-right:1px solid var(--line)}.inspector-panel{border-left:1px solid var(--line)}.space-rail>.panel-head{min-height:var(--header);background:var(--chrome);color:#f7f7f7}.space-rail>.panel-head span{color:#777}"
     ".panel-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--panel)}.panel-head strong{font-size:13px}.panel-head span{color:var(--faint);font:10px var(--mono);text-transform:uppercase}.panel-section-head{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:0 12px;color:var(--muted);font-size:11px;font-weight:600;text-transform:uppercase}.panel-section-head span{color:var(--faint);font:10px var(--mono)}"
     ".tree-current{display:flex;align-items:center;gap:8px;margin:8px;padding:7px 8px;border-radius:var(--radius);background:var(--accent-soft);color:#174ea6;font-weight:600}.tree-current:before,.tree-row>a:before,.tree-summary>a:before,.tree-child:before{width:14px;height:14px;flex:0 0 14px;border:1px solid currentColor;border-radius:4px;content:''}.tree-list{padding:0 8px 10px}.tree-row,.tree-branch{border-radius:var(--radius)}.tree-row:hover,.tree-summary:hover,.tree-child:hover{background:var(--panel-muted)}.tree-row>a,.tree-summary>a,.tree-child{display:flex;align-items:center;gap:8px;min-height:34px;padding:0 8px;font-weight:500}.tree-row>a:before,.tree-summary>a:before,.tree-child:before{color:var(--faint)}.tree-row .khead,.tree-branch>.khead{display:block;margin:-5px 8px 7px 30px;overflow:hidden;color:var(--faint);font-size:10px;text-overflow:ellipsis;white-space:nowrap}.tree-summary{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 24px;align-items:center;cursor:pointer;list-style:none}.tree-summary:after{grid-column:2;grid-row:1;justify-self:center;width:6px;height:6px;border-right:1px solid var(--faint);border-bottom:1px solid var(--faint);content:'';transform:rotate(-45deg);transition:transform 120ms}.tree-branch[open]>.tree-summary:after{transform:rotate(45deg)}.tree-sublist{margin:0 0 4px 15px;padding-left:8px;border-left:1px solid var(--line)}.tree-child{min-height:30px;color:var(--muted);font-size:12px}.tree-child:before{width:10px;height:10px;flex-basis:10px;border-radius:3px}.empty{padding:10px 12px;color:var(--faint);font-size:12px}"
     ".document-panel{min-width:0;min-height:0;overflow:auto;background:var(--canvas)}.document-toolbar{position:sticky;top:0;z-index:3;display:flex;align-items:center;min-height:38px;padding:3px 8px;border-bottom:1px solid var(--line);background:rgb(250 250 248 / .94);backdrop-filter:blur(10px)}.document-toolbar .crumbs{width:100%}"
     ".document{width:min(100%,900px);min-height:100%;margin:0 auto;padding:44px clamp(28px,7vw,88px) 80px}.document-kicker{margin-bottom:14px;color:var(--accent);font-size:11px;font-weight:650;text-transform:uppercase}.document h1{margin:0 0 28px;font-size:clamp(30px,4vw,48px);font-weight:700;letter-spacing:0;line-height:1.05;overflow-wrap:anywhere}.section{margin-top:34px}.section-title{display:flex;align-items:center;justify-content:space-between;margin:0 0 9px;padding-bottom:8px;border-bottom:1px solid var(--line)}.section-title h2{margin:0;font-size:14px}.section-title span{color:var(--faint);font:10px var(--mono);text-transform:uppercase}"
     ".lore{margin:0 0 34px}.lore-head{max-width:720px;margin:0 0 12px;color:var(--ink);font-size:18px;font-weight:600}.lore-body{max-width:720px;color:var(--muted);font-size:14px;line-height:1.7}.lore-line{padding:2px 0}.record-list{border-top:1px solid var(--line)}.record-row{display:grid;grid-template-columns:minmax(120px,32%) minmax(0,1fr);gap:18px;align-items:start;min-height:38px;padding:9px 4px;border-bottom:1px solid var(--line)}.record-row:hover{background:#f4f4f2}.key{color:var(--muted);font:11px/1.5 var(--mono);overflow-wrap:anywhere}.record-row>a,.record-row>span:last-child{min-width:0;overflow-wrap:anywhere}.record-row>a{color:var(--accent)}"
     ".doctest-row{grid-template-columns:minmax(0,1fr) auto;font:11px/1.5 var(--mono)}.dtsrc{color:var(--ink)}.chip{align-self:center;margin-left:10px;padding:2px 7px;border-radius:999px;font:10px var(--font)}.ok{background:#e4f4ec;color:#14734c}.bad{background:#fae8e8;color:#a42f2f}.mut{background:#ececea;color:#737373}"
     ".inspector-path{padding:10px 12px;border-bottom:1px solid var(--line);color:var(--muted);font:11px/1.5 var(--mono);overflow-wrap:anywhere}.inspector-section{border-bottom:1px solid var(--line)}.inspector-row{display:grid;grid-template-columns:minmax(86px,38%) minmax(0,1fr);gap:10px;min-height:36px;padding:9px 12px;border-top:1px solid var(--line)}.inspector-row:first-of-type{border-top:0}.inspector-row:hover{background:var(--panel-muted)}.inspector-row .key{font-size:10px}.inspector-row>span:last-child{min-width:0;overflow-wrap:anywhere}.inspector-row a{display:inline-flex;min-width:20px;min-height:20px;align-items:center;justify-content:center;margin:0 2px;padding:0 4px;border:1px solid var(--line);border-radius:4px;color:var(--accent);font:10px var(--mono)}.projection-state{color:var(--muted);font:11px var(--mono)}.hand-link{overflow-wrap:anywhere}"
     ".muted{color:var(--faint)}"
     "@media(max-width:1100px){:root{--space-left:188px;--left:190px}}"
     "@media(max-width:900px){.ns-app{grid-template-columns:minmax(0,1fr)}.space-rail{display:none}.explorer-shell{grid-template-columns:var(--left) minmax(0,1fr)}.sidebar-switch:not(:checked)~.explorer-shell{grid-template-columns:0 minmax(0,1fr)}.inspector-panel{display:none}.document{padding-inline:clamp(24px,6vw,60px)}}"
     "@media(max-width:620px){.ns-chrome{grid-template-columns:max-content minmax(0,1fr) max-content}.view-tab{min-width:96px;max-width:150px}.chrome-link{display:none}.locus-popover{width:min(320px,calc(100vw - 16px))}.explorer-shell,.sidebar-switch:not(:checked)~.explorer-shell{grid-template-columns:minmax(0,1fr)}.tree-panel{display:none}.document{padding:32px 22px 64px}.document h1{font-size:30px}.record-row{grid-template-columns:1fr;gap:3px}}"])
+  ns_tabs_js
  '  Route-backed namespace tabs.  The URL selects the rendered node while
  '  local storage preserves the user's open view set across page loads.
  \  x=nat
  ^  nat
  (weft/cat
    ["(()=>{'use strict';"
     "const host=document.querySelector('[data-tabs]');if(!host)return;"
     "const list=host.querySelector('[data-tab-list]');"
     "const key='jshrine.namespace.tabs.v1';"
     "const currentHref=host.dataset.currentHref;"
     "const currentTitle=host.dataset.currentTitle||currentHref;"
     "const clean=(value)=>Array.isArray(value)?value.filter((tab)=>tab&&typeof tab.href==='string'&&typeof tab.title==='string'):[];"
     "let tabs=[];try{tabs=clean(JSON.parse(localStorage.getItem(key)||'[]'));}catch(_){tabs=[];}"
     "const ensure=(href,title)=>{if(!tabs.some((tab)=>tab.href===href))tabs.push({href:href,title:title||href});};"
     "const persist=()=>localStorage.setItem(key,JSON.stringify(tabs));"
     "const render=()=>{list.replaceChildren();tabs.forEach((tab,index)=>{"
     "const item=document.createElement('div');item.className='view-tab';item.setAttribute('role','presentation');"
     "if(tab.href===currentHref)item.setAttribute('aria-current','page');"
     "const link=document.createElement('a');link.className='view-tab-link';link.href=tab.href;link.setAttribute('role','tab');link.setAttribute('aria-selected',String(tab.href===currentHref));"
     "const label=document.createElement('span');label.className='view-tab-label';label.textContent=tab.title;link.append(label);"
     "const close=document.createElement('button');close.className='view-tab-close';close.type='button';close.setAttribute('aria-label','Close '+tab.title);"
     "close.addEventListener('click',()=>{const active=tab.href===currentHref;tabs.splice(index,1);if(!tabs.length)tabs=[{href:'/ns',title:'Namespace'}];persist();if(active){location.assign(tabs[Math.max(0,index-1)].href);}else{render();}});"
     "item.append(link,close);list.append(item);});};"
     "ensure(currentHref,currentTitle);persist();render();"
     "document.addEventListener('click',(event)=>{const opener=event.target.closest('[data-open-tab]');if(!opener)return;event.preventDefault();const href=opener.getAttribute('data-open-tab');ensure(href,opener.dataset.tabTitle||opener.textContent.trim());persist();location.assign(href);});"
     "window.addEventListener('storage',(event)=>{if(event.key!==key)return;try{tabs=clean(JSON.parse(event.newValue||'[]'));ensure(currentHref,currentTitle);render();}catch(_){}});"
     "})();"])
+  ns_url
  '  The explorer href for a path.
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     "/ns"
  (weft/cat2 "/ns" (show_path p))
+  cord_starts
  '  Whether a cord begins with prefix. Cords are little-endian byte atoms.
  \  s=nat prefix=nat
  ^  nat
  ?  (lt (wid s) (wid prefix))
     0
  (eq (mod s (weft/bex8 (wid prefix))) prefix)
+  json_esc
  '  Escape a text cord for a JSON string. Namespace text keys can contain
  '  arbitrary bytes, so quotes, slashes and common controls are explicit.
  \  s=nat
  ^  nat
  |  > x=nat s  > acc=nat 0
  ?  (eq x 0)
     acc
  =  > b (mod x 256)
  =  > r (div x 256)
  ?  (eq b 34)
     (_ r (weft/cat [acc 92 34]))
  ?  (eq b 92)
     (_ r (weft/cat [acc 92 92]))
  ?  (eq b 10)
     (_ r (weft/cat [acc 92 "n"]))
  ?  (eq b 13)
     (_ r (weft/cat [acc 92 "r"]))
  ?  (eq b 9)
     (_ r (weft/cat [acc 92 "t"]))
  ?  (lt b 32)
     (_ r acc)
  (_ r (weft/cat2 acc b))
+  json_text
  \  s=nat
  ^  nat
  (weft/cat [34 (json_esc s) 34])
+  ns_api_kid
  '  One direct child reference. Values remain in Lain; this endpoint only
  '  exports stable identities for projection clients.
  \  tgt=path key=quip
  ^  nat
  =  > name (show_iota key)
  =  > path (show_path tgt.snoc(key))
  (weft/cat ["{" 34 "name" 34 ":" (json_text name) "," 34 "path" 34 ":" (json_text path) "}"])
+  ns_api_kids
  \  tgt=path fat=axal[myth]
  ^  row[nat]
  =  > ks fat.kid.tap
  |  > i=nat 0  > acc=row[nat] []
  ?  (eq i ks.len)
     acc
  =  > h ks.at(i)
  (_ i.inc acc.snoc((ns_api_kid tgt h.key)))
+  ns_api_slot
  '  One projected record slot. The textual pail view is diagnostic;
  '  ppails additionally expose their navigable namespace target.
  \  key=path val=pail
  ^  nat
  =  > target
       ?  val
        > p9=ppail  (json_text (show_path p9.p))
       "null"
  (weft/cat
    ["{" 34 "path" 34 ":" (json_text (show_path key)) ","
     34 "value" 34 ":" (json_text (show_pail val)) ","
     34 "target" 34 ":" target "}"])
+  ns_api_slots
  \  fat=axal[myth]
  ^  row[nat]
  ?  fat.fil
   > $none  []
   > ($some t=myth)
     =  > es t.tap
     |  > i=nat 0  > acc=row[nat] []
     ?  (eq i es.len)
        acc
     =  > h es.at(i)
     (_ i.inc acc.snoc((ns_api_slot h.key h.val)))
+  ns_api_page
  '  Version-two read projection for one namespace node. Stable identities,
  '  children, and diagnostic slot values cross into presentation clients;
  '  Shrine retains the records and their semantics.
  \  tgt=path fat=axal[myth]
  ^  nat
  =  > present
       ?  fat.fil
        > $none  "false"
        > ($some t=myth)  "true"
  =  > kids (weft/join "," (ns_api_kids tgt fat))
  =  > slots (weft/join "," (ns_api_slots fat))
  (weft/cat
    ["{" 34 "version" 34 ":2,"
     34 "path" 34 ":" (json_text (show_path tgt)) ","
     34 "record" 34 ":" present ","
     34 "children" 34 ":[" kids "],"
     34 "slots" 34 ":[" slots "]}"])
+  ns_case_count
  '  Read one decimal counter from a version-view myth.
  \  key=path t=myth
  ^  nat
  ?  (dig_parse (txt_slot key t))
   > ($some n=nat)  n
   > $none  0
+  ns_case_links
  '  Links for one target-local care history, cases 1 through n.
  \  cr=quip n=nat tgt=path
  ^  row[weft/node]
  |  > i=nat 1  > acc=row[weft/node] []
  ?  (gt i n)
     acc
  =  > hp ['h cr ($u i) ($u tgt.len)]
  =  > lnk (weft/leaf "a" [(weft/href (ns_url hp.weld(tgt)))] (show_iota ($u i)))
  =  > a1 acc.snoc((weft/tx " "))
  (_ i.inc a1.snoc(lnk))
+  dt_chip
  '  One doctest's verdict chip: pass/got from the verdict's results,
  '  greyed when the verdict's case is behind the node's current x
  '  case (curx as decimal text; 0 = unknown, no staleness call).
  \  v=dt_verdict curx=nat j=nat
  ^  weft/node
  =  > stale
       ?  (eq 0 curx)
          0
       ?  (eq curx (weft/show_nat v.case))
          0
       1
  ?  (ge j v.results.len)
     (weft/leaf "span" [(weft/cls "chip mut")] "no result")
  ?  stale
     (weft/leaf "span" [(weft/cls "chip mut")] (weft/cat2 "stale v" (weft/show_nat v.case)))
  =  > re v.results.at(j)
  ?  pass
     (weft/leaf "span" [(weft/cls "chip ok")] "pass")
  (weft/leaf "span" [(weft/cls "chip bad")] (weft/cat2 "got " got))
+  dt_row1
  '  One rendered doctest row.
  \  src2=nat want2=nat chip=weft/node
  ^  weft/node
  (weft/el "div" [(weft/cls "record-row doctest-row")]
    [(weft/el "span" []
       [(weft/tx "?=  ")
        (weft/leaf "span" [(weft/cls "dtsrc")] src2)
        (weft/tx "  ->  ")
        (weft/leaf "span" [(weft/cls "dtsrc")] want2)])
     chip])
+  dt_rows
  '  A lore's doctests with verdict chips.
  \  l=lore v=dt_verdict curx=nat
  ^  row[weft/node]
  |  > j=nat 0  > acc=row[weft/node] []
  ?  (ge j l.tests.len)
     acc
  =  > te l.tests.at(j)
  (_ j.inc acc.snoc((dt_row1 src want (dt_chip v curx j))))
+  dt_rows_never
  '  A lore's doctests, never yet run.
  \  l=lore
  ^  row[weft/node]
  |  > j=nat 0  > acc=row[weft/node] []
  ?  (ge j l.tests.len)
     acc
  =  > te l.tests.at(j)
  (_ j.inc acc.snoc((dt_row1 src want (weft/leaf "span" [(weft/cls "chip mut")] "never run"))))
+  ns_page
  '  The node browser: breadcrumbs, the node's own lore (head, body,
  '  and doctests with verdict chips from the /dt kid), the record's
  '  slots (paths as links), kid links annotated with their lore
  '  heads — plus time travel: the node's version view with links
  '  into its history, and a live link back out of /h pages.
  \  tgt=path fat=axal[myth] ver=axal[myth]
  ^  nat
  =  > root (weft/leaf "a" [(weft/href "/ns")] "Namespace")
  =  > crumbs
       |  > i=nat 0  > acc=row[weft/node] [root]
       ?  (eq i tgt.len)
          acc
       =  > pre tgt.take(i.inc)
       =  > lnk (weft/leaf "a" [(weft/href (ns_url pre))] (show_iota tgt.at(i)))
       =  > a1 acc.snoc((weft/leaf "span" [(weft/cls "crumb-sep")] "/"))
       (_ i.inc a1.snoc(lnk))
  =  > nav
       =  > hlnk (weft/leaf "a" [(weft/href "/ns/h") (weft/cls "chrome-link")] "History")
       ?  (is_h tgt)
          ?  (lt tgt.len 3)
             [hlnk]
          =  > shift
               ?  (eq_iota tgt.at(1) 'v)
                  3
               4
          ?  (lt tgt.len shift)
             [hlnk]
          =  > live tgt.drop(shift)
          =  > llnk (weft/leaf "a" [(weft/href (ns_url live)) (weft/cls "chrome-link live-link")] "View live")
          [hlnk llnk]
       [hlnk]
  =  > curx
       ?  ver.fil
        > ($some vt=myth)  (txt_slot ['x_data] vt)
        > $none  0
  =  > docpane
       ?  fat.fil
        > $none  []
        > ($some t=myth)
          ?  t.get(['lore])
           > $none  []
           > ($some pl=pail)
             ?  pl
              > l=lore
                =  > brows
                     |  > j=nat 1  > acc=row[weft/node] []
                     ?  (ge j l.body.len)
                        acc
                     (_ j.inc acc.snoc((weft/leaf "div" [(weft/cls "lore-line")] l.body.at(j))))
                =  > trows
                     ?  fat.dip(['dt]).fil
                      > ($some dtm=myth)
                        ?  dtm.get(['dt])
                         > ($some pl2=pail)
                           ?  pl2
                            > v9=dt_verdict  (dt_rows l v9 curx)
                           (dt_rows_never l)
                         > $none  (dt_rows_never l)
                      > $none  (dt_rows_never l)
                =  > topr
                     [(weft/el "div" [(weft/cls "lore-head")] [(weft/tx l.head)])
                      (weft/el "div" [(weft/cls "lore-body")] brows)]
                topr.weld(trows)
             []
  =  > slots
       ?  fat.fil
        > $none  [(weft/leaf "div" [(weft/cls "empty")] "No record at this node")]
        > ($some t=myth)
          =  > es t.tap
          ?  (eq 0 es.len)
             [(weft/leaf "div" [(weft/cls "empty")] "Empty record")]
          |  > i=nat 0  > acc=row[weft/node] []
          ?  (eq i es.len)
             acc
          =  > h es.at(i)
          ?  (eq_pith h.key ['lore])
             (_ i.inc acc)
          =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
          =  > vn
               ?  h.val
                > t6=tpail
                  ?  (eq_pith h.key ['module])
                     (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" t6.t))] t6.t)
                  (weft/leaf "pre" [] t6.t)
                > p9=ppail  (weft/leaf "a" [(weft/href (ns_url p9.p))] (show_path p9.p))
               (weft/tx (show_pail h.val))
          (_ i.inc acc.snoc((weft/el "div" [(weft/cls "record-row")] [kn vn])))
  =  > kids
       =  > ks fat.kid.tap
       ?  (eq 0 ks.len)
          [(weft/leaf "div" [(weft/cls "empty")] "No child nodes")]
       |  > i=nat 0  > acc=row[weft/node] []
       ?  (eq i ks.len)
          acc
       =  > h ks.at(i)
       =  > kp tgt.snoc(h.key)
       =  > lnk (weft/leaf "a" [(weft/href (ns_url kp))] (show_iota h.key))
       =  > ka
            ?  fat.kid.get(h.key)
             > ($some found=axal[myth])  found
             > $none  (axal/new[myth] $none)
       =  > khead
            ?  ka.fil
             > ($some kt=myth)
               ?  kt.get(['lore])
                > ($some kpl=pail)
                  ?  kpl
                   > kl=lore  (weft/leaf "span" [(weft/cls "muted khead")] kl.head)
                  (weft/tx "")
                > $none  (weft/tx "")
             > $none  (weft/tx "")
       =  > subks ka.kid.tap
       =  > subnodes
            |  > j=nat 0  > subacc=row[weft/node] []
            ?  (eq j subks.len)
               subacc
            =  > sh subks.at(j)
            =  > sp kp.snoc(sh.key)
            =  > slink
                 (weft/leaf "a" [(weft/href (ns_url sp)) (weft/cls "tree-child")] (show_iota sh.key))
            (_ j.inc subacc.snoc(slink))
       =  > row
            ?  (eq 0 subks.len)
               (weft/el "div" [(weft/cls "tree-row")] [lnk khead])
            (weft/el "details" [(weft/cls "tree-branch")]
              [(weft/el "summary" [(weft/cls "tree-summary")] [lnk])
               khead
               (weft/el "div" [(weft/cls "tree-sublist")] subnodes)])
       (_ i.inc acc.snoc(row))
  =  > kidcount fat.kid.tap.len
  =  > locusitems
       =  > ks fat.kid.tap
       |  > i=nat 0  > acc=row[weft/node] []
       ?  (eq i ks.len)
          acc
       =  > h ks.at(i)
       =  > kp tgt.snoc(h.key)
       =  > item
            (weft/el "a" [(weft/href (ns_url kp)) (weft/cls "locus-row")]
              [(weft/tx (show_iota h.key))
               (weft/leaf "span" [] (show_path kp))])
       (_ i.inc acc.snoc(item))
  =  > relations=row[weft/node]
       ?  fat.fil
        > $none  []
        > ($some t=myth)
          =  > es t.tap
          |  > i=nat 0  > acc=row[weft/node] []
          ?  (eq i es.len)
             acc
          =  > h es.at(i)
          ?  (eq_pith h.key ['hand])
             (_ i.inc acc)
          ?  h.val
           > p9=ppail
             =  > href (ns_url p9.p)
             =  > item
                  (weft/el "a" [(weft/href href) (weft/cls "locus-row relation-row")]
                    [(weft/tx (show_path h.key))
                     (weft/leaf "span" [] (show_path p9.p))])
             (_ i.inc acc.snoc(item))
          (_ i.inc acc)
  =  > relationcount relations.len
  =  > pluschilditems
       =  > ks fat.kid.tap
       |  > i=nat 0  > acc=row[weft/node] []
       ?  (eq i ks.len)
          acc
       =  > h ks.at(i)
       =  > kp tgt.snoc(h.key)
       =  > href (ns_url kp)
       =  > item
            (weft/el "a"
              [(weft/href href)
               (weft/att "data-open-tab" href)
               (weft/att "data-tab-title" (show_iota h.key))]
              [(weft/tx (show_iota h.key))
               (weft/leaf "span" [] (show_path kp))])
       (_ i.inc acc.snoc(item))
  =  > vpane
       ?  ver.fil
        > $none  []
        > ($some vt=myth)
          =  > es vt.tap
          =  > vrows
               |  > i=nat 0  > acc=row[weft/node] []
               ?  (eq i es.len)
                  acc
               =  > h es.at(i)
               =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
               =  > vn (weft/tx (show_pail h.val))
               (_ i.inc acc.snoc((weft/el "div" [(weft/cls "inspector-row")] [kn vn])))
          =  > xc (ns_case_count ['x_data] vt)
          =  > yc (ns_case_count ['y_data] vt)
          =  > zc (ns_case_count ['z_data] vt)
          =  > xr (ns_case_links 'x xc tgt)
          =  > yr (ns_case_links 'y yc tgt)
          =  > zr (ns_case_links 'z zc tgt)
          =  > v1 vrows
          =  > hh
               [(weft/el "div" [(weft/cls "inspector-row")] [(weft/leaf "span" [(weft/cls "key")] "x cases") (weft/el "span" [] xr)])
                (weft/el "div" [(weft/cls "inspector-row")] [(weft/leaf "span" [(weft/cls "key")] "y cases") (weft/el "span" [] yr)])
                (weft/el "div" [(weft/cls "inspector-row")] [(weft/leaf "span" [(weft/cls "key")] "z cases") (weft/el "span" [] zr)])]
          v1.weld(hh)
  =  > recordstate
       ?  fat.fil
        > $none  "absent"
        > ($some t=myth)  "present"
  =  > handvalue
       ?  fat.fil
        > $none  (weft/leaf "span" [(weft/cls "projection-state")] "unassigned")
        > ($some t=myth)
          ?  t.get(['hand])
           > $none  (weft/leaf "span" [(weft/cls "projection-state")] "unassigned")
           > ($some pl=pail)
             ?  pl
              > p8=ppail
                (weft/leaf "a" [(weft/href (ns_url p8.p)) (weft/cls "hand-link")] (show_path p8.p))
             (weft/leaf "span" [(weft/cls "projection-state")] (show_pail pl))
  =  > projectionrows
       [(weft/el "div" [(weft/cls "inspector-row")]
          [(weft/leaf "span" [(weft/cls "key")] "name")
           (weft/leaf "a" [(weft/href (ns_url tgt))] (show_path tgt))])
        (weft/el "div" [(weft/cls "inspector-row")]
          [(weft/leaf "span" [(weft/cls "key")] "record")
           (weft/leaf "span" [(weft/cls "projection-state")] recordstate)])
        (weft/el "div" [(weft/cls "inspector-row")]
          [(weft/leaf "span" [(weft/cls "key")] "children")
           (weft/leaf "span" [(weft/cls "projection-state")] (weft/show_nat kidcount))])
        (weft/el "div" [(weft/cls "inspector-row")]
