+  ns_react_page
  '  The React projection shell. Generated bundle bytes are base64 atoms so
  '  the Wisp server can serve one self-contained application on /ns without
  '  becoming a filesystem or JavaScript asset authority.
  \  tgt=path
  ^  nat
  =  > root
       (weft/el "div"
         [(weft/att "id" "root")
          (weft/att "data-namespace-path" (show_path tgt))]
         [])
  =  > loader
       (weft/cat
         ["(()=>{'use strict';document.documentElement.lang='en';"
          "const meta=document.createElement('meta');meta.name='viewport';meta.content='width=device-width,initial-scale=1';document.head.append(meta);"
          "const style=document.createElement('style');style.textContent=atob('"
          (nsassets/stylesheet 0)
          "');document.head.append(style);"
          "const source=atob('" (nsassets/javascript 0) "');"
          "const url=URL.createObjectURL(new Blob([source],{type:'text/javascript'}));"
          "import(url).finally(()=>URL.revokeObjectURL(url));})();"])
  =  > script (weft/el "script" [(weft/att "type" "module")] [(weft/raw loader)])
  (weft/page (weft/cat2 "Shrine " (show_path tgt)) "" [root script])
+  http_explore_talk
  '  The namespace explorer responder: render the request's hydrated
  '  target view as the node browser page.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  =  > tgt
       ?  o.get(['vpath])
        > ($some pl=pail)
          ?  pl
           > x=ppail  x.p
          []
        > $none  []
  =  > cw b.crew
  =  > fat cw.gut(['view] (axal/new[myth] $none))
  =  > ver cw.gut(['ver] (axal/new[myth] $none))
  =  > projection (tslot ['projection] 0 o)
  =  > response
       ?  (eq projection 2)
          ?  (read_file fat)
           > $file_missing
             [404 "file not found" "text/plain; charset=utf-8"]
           > $file_malformed
             [422 "namespace record is not a file occurrence" "text/plain; charset=utf-8"]
           > ($file_found mime=nat content=nat)
             [200 content mime]
       ?  (eq projection 1)
          [200 (ns_api_page tgt fat) "application/json; charset=utf-8"]
       [200 (ns_react_page tgt) "text/html; charset=utf-8"]
  =  > o1 o.put(['res_status] (pd response.at(0)))
  =  > o2 o1.put(['res_body] (pd response.at(1)))
  =  > o3 o2.put(['res_ctype] (pd response.at(2)))
  (yell [] o3)
+  http_explore_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_talk(http_explore_talk)
+  http_cfg
  '  The record for an HTTP driver node: the serving kook plus the
  '  responder id it installs on request nodes.
  \  rid=quip
  ^  myth
  =  > t1 (kooked [['kook 'hserve]])
  t1.put(['serve] (qpail rid))
+  http_cfg_port
  '  A live driver config: serving kook, responder id, and the TCP
  '  port (the worker reads it at birth, so it must ride the make).
  \  rid=quip port=nat
  ^  myth
  =  > t1 (http_cfg rid)
  t1.put(['port] (pd port))
+  http_req
  '  An HTTP request as a namespace record: method, url and body ride
  '  as data pails, the parsed target as a ppail, a z-care dep on the
  '  target so responders get its hydrated view, and — for live
  '  targets — a y-care dep on the target's /h/v version view.  No
  '  kook: the serving kook above installs one.
  \  m=nat u=nat bd=nat tgt=path
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['method] (pd m))
  =  > t3 t2.put(['url] (pd u))
  =  > t4 t3.put(['body] (pd bd))
  =  > t5 t4.put(['vpath] (ppail tgt))
  =  > projection
       ?  (cord_starts u "/api/file")
          2
       ?  (cord_starts u "/api/ns")
          1
       0
  =  > t6 t5.put(['projection] (pd projection))
  =  > cw1 (crew_one ['view] (dep $z tgt))
  =  > cw
       ?  (is_h tgt)
          cw1
       ?  (eq 0 tgt.len)
          cw1
       =  > vp ['h 'v ($u tgt.len)]
       cw1.put(['ver] (dep $y vp.weld(tgt)))
  t6.put((crew_slot 0) (cpail cw))
+  fetch_take
  '  The outbound-HTTP driver kook: when a request node appears
  '  underneath (an added direct kid in the gift), mark it fresh on
  '  the driver node itself — helm x-watches each /io name's own
  '  record, so the write IS the worker's notification.  A culled kid
  '  clears its marker (pokes cannot delete slots, so markers are
  '  overwritten to 0, never removed).
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  =  > es g.tap
  |  > i=nat 0  > acc=myth cur
  ?  (eq i es.len)
     (yell [] acc)
  =  > h es.at(i)
  =  > isadd
       ?  q
        > $add  (eq 1 p.len)
       0
  =  > isdel
       ?  q
        > $del  (eq 1 p.len)
       0
  ?  isadd
     (_ i.inc acc.put(['fresh p.at(0)] (pd 1)))
  ?  isdel
     (_ i.inc acc.put(['fresh p.at(0)] (pd 0)))
  (_ i.inc acc)
+  fetch_form
  \  x=nat
  ^  form
  =  > f (def_form 0)
  f.set_take(fetch_take)
+  fetch_cfg
  '  The record for an outbound-HTTP driver node: just the fetch
  '  kook — requests carry their own config.
  \  x=nat
  ^  myth
  (kooked [['kook 'hfetch]])
+  fetch_req
  '  An outbound fetch request as a namespace record: method, url,
  '  body (0 = none) and deadline (ms, required nonzero) ride as data
  '  pails.  Optional slots the driver honors: ['connect]
  '  ['redirects] ['maxbody], plus one ['hdr <name>] per request
  '  header.  The driver answers by poking ['res_done] ['res_ok] and
  '  the res_* payload slots onto the node — the requester's own kook
  '  (or a crew dep on the node) consumes them.
  \  m=nat u=nat bd=nat dl=nat
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['method] (pd m))
  =  > t3 t2.put(['url] (pd u))
  =  > t4 t3.put(['body] (pd bd))
  t4.put(['deadline] (pd dl))
+  put_nat
  '  Chain a data slot onto a record — optional fetch slots, marker
  '  clears, and test fixtures build records without one ctor each.
  \  t=myth slot=path n=nat
  ^  myth
  t.put(slot (pd n))
+  dt_req
  '  A doctest request as a namespace record: the target's mirror
  '  path (an exact documented node, or a /boot prefix to sweep)
  '  rides as a ppail.  The driver answers by poking ['res_done]
  '  ['passed] ['failed] onto this node and the ['dt] verdicts onto
  '  the targets themselves.
  \  tgt=path
  ^  myth
  =  > t (myth/new 0)
  t.put(['target] (ppail tgt))
+  dtest_cfg
  '  The record for a doctest driver node: just the inbox kook —
  '  requests carry their target, verdicts land on the documented
  '  nodes.
  \  x=nat
  ^  myth
  (kooked [['kook 'dtake]])
+  fetch_fresh
  '  The pending request kids marked on a driver record: keys
  '  ['fresh <kid>] whose value is 1.
  \  t=myth
  ^  path
  =  > es t.tap
  |  > i=nat 0  > acc=path []
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  =  > k h.key
  =  > hit
       ?  (eq 2 k.len)
          ?  (eq_iota k.at(0) 'fresh)
             ?  h.val
              > x=npail  x.n
             0
          0
       0
  ?  hit
     (_ i.inc acc.snoc(k.at(1)))
  (_ i.inc acc)
+  fetch_hdrs
  '  Request headers from a record: one [name value] per
  '  ['hdr <name>] slot (names unique, order unspecified).
  \  t=myth
  ^  row[[n=nat v=nat]]
  =  > es t.tap
  |  > i=nat 0  > acc=row[[n=nat v=nat]] []
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  =  > k h.key
  =  > hit
       ?  (eq 2 k.len)
          (eq_iota k.at(0) 'hdr)
       0
  ?  hit
     =  > v
          ?  h.val
           > x=npail  x.n
          0
     (_ i.inc acc.snoc([(quip_val k.at(1)) v]))
  (_ i.inc acc)
+  fetch_res_ok
  '  The response myth the driver pokes onto a request node when the
  '  transfer completed: the final status/url/headers/body plus the
  '  ['res_done] completion marker.
  \  status=nat u=nat hdrs=nat body=nat
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['res_done] (pd 1))
  =  > t3 t2.put(['res_ok] (pd 1))
  =  > t4 t3.put(['res_status] (pd status))
  =  > t5 t4.put(['res_url] (pd u))
  =  > t6 t5.put(['res_hdrs] (pd hdrs))
  t6.put(['res_body] (pd body))
+  fetch_res_err
  '  The response myth for a failed fetch: the driver's error code
  '  (0 bad-url, 1 dns, 2 connect, 3 tls, 4 deadline, 5 redirects,
  '  6 too-large, 7 protocol).
  \  code=nat
  ^  myth
  =  > t1 (myth/new 0)
  =  > t2 t1.put(['res_done] (pd 1))
  =  > t3 t2.put(['res_ok] (pd 0))
  t3.put(['res_err] (pd code))
+  sov0
  '  A fresh sovereign; argument ignored.
  \  x=nat
  ^  sov
  (sov/new 0)
