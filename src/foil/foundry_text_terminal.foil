-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_pronounce [order=40]
-  foundry_terminal [order=50]
-  foundry_wire [order=60]
-  weft [order=70]
'  foundry_text_terminal: a plain-text sibling of the generic Web terminal.
'  It consumes one validated terminal_plan, follows only exact addressed child
'  edges, and emits no HTML, application path, route, callback, or invocation.

+  text_terminal_refusal
  :  code=iota at=maybe[projection_address] binding=maybe[path]

+  text_terminal_action_evidence
  '  Preserve the exact admitted mount beside plain text without converting it
  '  into behavior.  A text consumer may inspect this evidence but cannot
  '  invoke it through this terminal result.
  :  address=projection_address mount=projection_action_mount

+  text_terminal_result
  &  text_terminal_result/admitted
     text_terminal_result/refused

  +  admitted
    :  body=nat actions=row[text_terminal_action_evidence]
  +  refused
    :  refusal=text_terminal_refusal

+  text_terminal_lower_result
  &  text_terminal_lower_result/admitted
     text_terminal_lower_result/refused

  +  admitted
    :  body=nat actions=row[text_terminal_action_evidence]
  +  refused
    :  refusal=text_terminal_refusal

+  text_terminal_parts_result
  &  text_terminal_parts_result/admitted
     text_terminal_parts_result/refused

  +  admitted
    :  parts=row[nat] actions=row[text_terminal_action_evidence]
  +  refused
    :  refusal=text_terminal_refusal

+  text_terminal_material
  :  address=projection_address
     body=nat
     actions=row[text_terminal_action_evidence]

+  text_terminal_fold_result
  &  text_terminal_fold_result/admitted
     text_terminal_fold_result/refused

  +  admitted
    :  material=row[text_terminal_material]
  +  refused
    :  refusal=text_terminal_refusal

+  text_terminal_binding_result
  &  text_terminal_binding_result/absent
     text_terminal_binding_result/text
     text_terminal_binding_result/wrong

  +  absent
    :
  +  text
    :  value=nat
  +  wrong
    :

+  foundry_text_terminal
  +  content_key
    ^  path
    ['terminal 'text 'content]

  +  separator_key
    ^  path
    ['terminal 'text 'separator]

  +  refusal
    \  code=iota at=maybe[projection_address] binding=maybe[path]
    ^  text_terminal_refusal
    (text_terminal_refusal code at binding)

  +  entry_refusal
    \  code=iota address=projection_address binding=maybe[path]
    ^  text_terminal_lower_result
    (text_terminal_lower_result/refused
      (foundry_text_terminal/refusal code (./some address) binding))

  +  path_text
    '  Canonical namespace spelling used as inert Hole evidence, never a URL.
    \  value=path
    ^  nat
    ?  (eq value.len 0)  "/"
    |  > index=nat 0  > parts=row[nat] []
    ?  (ge index value.len)
       (weft/cat2 "/" (weft/join "/" parts))
    (_ index.inc parts.snoc((iota_show value.at(index))))

  +  binding_at
    \  key=path bindings=row[terminal_binding] index=nat
    ^  maybe[terminal_binding]
    ?  (ge index bindings.len)  .none
    ?  (equal key bindings.at(index).key)  (./some bindings.at(index))
    (_ key bindings index.inc)

  +  text_binding
    \  key=path bindings=row[terminal_binding]
    ^  text_terminal_binding_result
    ?  (foundry_text_terminal/binding_at key bindings 0)
     > .none  (text_terminal_binding_result/absent)
     > (./some binding=terminal_binding)
       ?  binding.value
        > x=projection_value/text
          (text_terminal_binding_result/text x.value)
        > projection_value/flag
          (text_terminal_binding_result/wrong)
        > projection_value/count
          (text_terminal_binding_result/wrong)
        > projection_value/name
          (text_terminal_binding_result/wrong)
        > projection_value/semantic_ref
          (text_terminal_binding_result/wrong)
        > projection_value/ref
          (text_terminal_binding_result/wrong)

  +  key_allowed
    \  operation=terminal_operation key=path
    ^  bool
    ?  operation
     > terminal_operation/pass       .false
     > terminal_operation/container
       (equal key foundry_text_terminal/separator_key)
     > terminal_operation/text
       (equal key foundry_text_terminal/content_key)
     > terminal_operation/glyph
       (equal key foundry_text_terminal/content_key)
     > terminal_operation/hole       .false
     > terminal_operation/action
       (equal key foundry_text_terminal/content_key)

  +  first_unknown_binding
    \  operation=terminal_operation bindings=row[terminal_binding] index=nat
    ^  maybe[path]
    ?  (ge index bindings.len)  .none
    ?  !(foundry_text_terminal/key_allowed operation bindings.at(index).key)
       (./some bindings.at(index).key)
    (_ operation bindings index.inc)

  +  evidence_of
    \  address=projection_address mounts=row[projection_action_mount]
       index=nat out=row[text_terminal_action_evidence]
    ^  row[text_terminal_action_evidence]
    ?  (ge index mounts.len)  out
    (_ address mounts index.inc
      out.snoc((text_terminal_action_evidence address mounts.at(index))))

  +  entry_evidence
    \  entry=terminal_plan_entry
    ^  row[text_terminal_action_evidence]
    (foundry_text_terminal/evidence_of entry.address
      (foundry_terminal/entry_actions entry) 0 [])

  +  required_content
    \  entry=terminal_plan_entry
    ^  text_terminal_lower_result
    ?  (foundry_text_terminal/text_binding foundry_text_terminal/content_key
          entry.bindings)
     > text_terminal_binding_result/absent
       (foundry_text_terminal/entry_refusal
         'text_terminal_binding_missing entry.address
         (./some foundry_text_terminal/content_key))
     > text_terminal_binding_result/wrong
       (foundry_text_terminal/entry_refusal
         'text_terminal_binding_type_mismatch entry.address
         (./some foundry_text_terminal/content_key))
     > x=text_terminal_binding_result/text
       (text_terminal_lower_result/admitted x.value [])

  +  hole_fallback_text
    \  entry=terminal_plan_entry hole=projection_pronunciation_hole
    ^  text_terminal_lower_result
    ?  hole.semantic_fallback
     > (./some fallback=path)
       (text_terminal_lower_result/admitted
         (foundry_text_terminal/path_text fallback) [])
     > .none
       ?  hole.fallback
        > .none
          (foundry_text_terminal/entry_refusal
            'text_terminal_hole_fallback_missing entry.address .none)
        > (./some fallback=projection_address)
          ?  (foundry_wire/address_text fallback)
           > projection_wire_encoding/refused
             (foundry_text_terminal/entry_refusal
               'text_terminal_hole_fallback_invalid entry.address .none)
           > x=projection_wire_encoding/admitted
             (text_terminal_lower_result/admitted
               (weft/cat2 "@" x.body) [])

  +  lower_hole
    '  Plain text has no live mount.  Preserve pending state and the exact
    '  canonical source/fallback as inert text instead of fabricating a fetch.
    \  entry=terminal_plan_entry
    ^  text_terminal_lower_result
    ?  entry.occurrence.hole
     > .none
       (foundry_text_terminal/entry_refusal
         'text_terminal_hole_evidence_missing entry.address .none)
     > (./some hole=projection_pronunciation_hole)
       ?  hole.source
        > .none
          (foundry_text_terminal/entry_refusal
            'text_terminal_hole_source_missing entry.address .none)
        > (./some source=path)
          ?  (foundry_text_terminal/hole_fallback_text entry hole)
           > x=text_terminal_lower_result/refused
             (text_terminal_lower_result/refused x.refusal)
           > x=text_terminal_lower_result/admitted
             (text_terminal_lower_result/admitted
               (weft/cat
                 ["[pending " (foundry_text_terminal/path_text source)
                  " -> " x.body "]"])
               (foundry_text_terminal/entry_evidence entry))

  +  lower_action
    '  Action content is inert authored text.  The exact admitted mount remains
    '  typed evidence in the result; no endpoint, verb, form, or invocation is
    '  derived from its identity or input contract.
    \  entry=terminal_plan_entry children=text_terminal_parts_result/admitted
    ^  text_terminal_lower_result
    =  mounts  (foundry_terminal/entry_actions entry)
    ?  (eq mounts.len 0)
       (foundry_text_terminal/entry_refusal
         'text_terminal_action_mount_missing entry.address .none)
    ?  (gt mounts.len 1)
       (foundry_text_terminal/entry_refusal
         'text_terminal_action_mount_ambiguous entry.address .none)
    ?  (foundry_text_terminal/required_content entry)
     > x=text_terminal_lower_result/refused
       (text_terminal_lower_result/refused x.refusal)
     > x=text_terminal_lower_result/admitted
       (text_terminal_lower_result/admitted
         (weft/cat2 x.body (weft/cat children.parts))
         (foundry_text_terminal/entry_evidence entry).weld(children.actions))

  +  lower_entry_known
    \  entry=terminal_plan_entry children=text_terminal_parts_result/admitted
    ^  text_terminal_lower_result
    =  current  (foundry_text_terminal/entry_evidence entry)
       inherited  children.actions
       all_actions  current.weld(inherited)
    ?  entry.operation
     > terminal_operation/pass
       (text_terminal_lower_result/admitted
         (weft/cat children.parts) all_actions)
     > terminal_operation/container
       ?  (foundry_text_terminal/text_binding
             foundry_text_terminal/separator_key entry.bindings)
        > text_terminal_binding_result/absent
          (text_terminal_lower_result/admitted
            (weft/cat children.parts) all_actions)
        > text_terminal_binding_result/wrong
          (foundry_text_terminal/entry_refusal
            'text_terminal_binding_type_mismatch entry.address
            (./some foundry_text_terminal/separator_key))
        > x=text_terminal_binding_result/text
          (text_terminal_lower_result/admitted
            (weft/join x.value children.parts) all_actions)
     > terminal_operation/text
       ?  (foundry_text_terminal/required_content entry)
        > x=text_terminal_lower_result/refused
          (text_terminal_lower_result/refused x.refusal)
        > x=text_terminal_lower_result/admitted
          (text_terminal_lower_result/admitted x.body all_actions)
     > terminal_operation/glyph
       ?  (foundry_text_terminal/required_content entry)
        > x=text_terminal_lower_result/refused
          (text_terminal_lower_result/refused x.refusal)
        > x=text_terminal_lower_result/admitted
          (text_terminal_lower_result/admitted x.body all_actions)
     > terminal_operation/hole
       (foundry_text_terminal/lower_hole entry)
     > terminal_operation/action
       (foundry_text_terminal/lower_action entry children)

  +  lower_entry
    \  entry=terminal_plan_entry children=text_terminal_parts_result/admitted
    ^  text_terminal_lower_result
    ?  (foundry_text_terminal/first_unknown_binding entry.operation
          entry.bindings 0)
     > (./some key=path)
       (foundry_text_terminal/entry_refusal
         'text_terminal_binding_unknown entry.address (./some key))
     > .none
       (foundry_text_terminal/lower_entry_known entry children)

  +  material_at
    \  address=projection_address material=row[text_terminal_material]
       index=nat
    ^  maybe[text_terminal_material]
    ?  (ge index material.len)  .none
    ?  (equal address material.at(index).address)
       (./some material.at(index))
    (_ address material index.inc)

  +  child_parts
    \  children=row[projection_address] material=row[text_terminal_material]
       index=nat out=row[nat] actions=row[text_terminal_action_evidence]
    ^  text_terminal_parts_result
    ?  (ge index children.len)
       (text_terminal_parts_result/admitted out actions)
    ?  (foundry_text_terminal/material_at children.at(index) material 0)
     > .none
       (text_terminal_parts_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_child_material_missing
           (./some children.at(index)) .none))
     > (./some child=text_terminal_material)
       (_ children material index.inc out.snoc(child.body)
         actions.weld(child.actions))

  +  fold_entries
    '  terminal_plan entries are pre-order.  Reverse folding guarantees exact
    '  addressed children are available before their parent without rebuilding
    '  a semantic tree or consulting depth-specific application policy.
    \  entries=row[terminal_plan_entry] index=nat
       material=row[text_terminal_material]
    ^  text_terminal_fold_result
    ?  (eq index 0)
       (text_terminal_fold_result/admitted material)
    =  entry  entries.at(index.dec)
    ?  (foundry_text_terminal/material_at entry.address material 0)
     > (./some _)
       (text_terminal_fold_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_occurrence_ambiguous (./some entry.address) .none))
     > .none
       ?  (foundry_text_terminal/child_parts entry.children material 0 [] [])
        > x=text_terminal_parts_result/refused
          (text_terminal_fold_result/refused x.refusal)
        > x=text_terminal_parts_result/admitted
          ?  (foundry_text_terminal/lower_entry entry x)
           > y=text_terminal_lower_result/refused
             (text_terminal_fold_result/refused y.refusal)
           > y=text_terminal_lower_result/admitted
             (_ entries index.dec
               material.snoc((text_terminal_material
                 entry.address y.body y.actions)))

  +  root_parts
    \  roots=row[projection_address] material=row[text_terminal_material]
       index=nat out=row[nat] actions=row[text_terminal_action_evidence]
    ^  text_terminal_parts_result
    ?  (ge index roots.len)
       (text_terminal_parts_result/admitted out actions)
    ?  (foundry_text_terminal/material_at roots.at(index) material 0)
     > .none
       (text_terminal_parts_result/refused
         (foundry_text_terminal/refusal 'text_terminal_root_material_missing
           (./some roots.at(index)) .none))
     > (./some root=text_terminal_material)
       (_ roots material index.inc out.snoc(root.body)
         actions.weld(root.actions))

  +  occurrence_entries_match
    \  plan=terminal_plan index=nat
    ^  bool
    ?  (ge index plan.entries.len)  .true
    ?  (foundry_terminal/occurrence_address
          plan.entries.at(index).occurrence)
     > .none  .false
     > (./some address=projection_address)
       ?  !(equal address plan.entries.at(index).address)  .false
       ?  !(equal plan.entries.at(index).occurrence
             plan.pronunciation.occurrences.at(index))  .false
       (_ plan index.inc)

  +  evaluate
    \  plan=terminal_plan
    ^  text_terminal_result
    ?  !(eq plan.schema 2)
       (text_terminal_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_schema_unsupported .none .none))
    ?  !(eq plan.operation_version 2)
       (text_terminal_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_operation_version_unsupported .none .none))
    ?  !(eq_iota plan.target.backend 'text)
       (text_terminal_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_backend_unsupported .none .none))
    ?  !(eq plan.entries.len plan.pronunciation.occurrences.len)
       (text_terminal_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_occurrence_count_mismatch .none .none))
    ?  !(foundry_text_terminal/occurrence_entries_match plan 0)
       (text_terminal_result/refused
         (foundry_text_terminal/refusal
           'text_terminal_occurrence_mismatch .none .none))
    ?  (foundry_text_terminal/fold_entries plan.entries plan.entries.len [])
     > x=text_terminal_fold_result/refused
       (text_terminal_result/refused x.refusal)
     > x=text_terminal_fold_result/admitted
       ?  (foundry_text_terminal/root_parts plan.pronunciation.roots
             x.material 0 [] [])
        > y=text_terminal_parts_result/refused
          (text_terminal_result/refused y.refusal)
        > y=text_terminal_parts_result/admitted
          (text_terminal_result/admitted (weft/cat y.parts) y.actions)

  +  result_admitted
    \  result=text_terminal_result
    ^  bool
    ?  result
     > text_terminal_result/admitted  .true
     > text_terminal_result/refused   .false

  +  result_body
    \  result=text_terminal_result
    ^  maybe[nat]
    ?  result
     > x=text_terminal_result/admitted  (./some x.body)
     > text_terminal_result/refused     .none

  +  result_actions
    \  result=text_terminal_result
    ^  row[text_terminal_action_evidence]
    ?  result
     > x=text_terminal_result/admitted  x.actions
     > text_terminal_result/refused     []

  +  result_code
    \  result=text_terminal_result
    ^  maybe[iota]
    ?  result
     > text_terminal_result/admitted  .none
     > x=text_terminal_result/refused  (./some x.refusal.code)

  +  result_at
    \  result=text_terminal_result
    ^  maybe[projection_address]
    ?  result
     > text_terminal_result/admitted  .none
     > x=text_terminal_result/refused  x.refusal.at

  +  result_binding
    \  result=text_terminal_result
    ^  maybe[path]
    ?  result
     > text_terminal_result/admitted  .none
     > x=text_terminal_result/refused  x.refusal.binding

  +  evidence_address
    \  evidence=text_terminal_action_evidence
    ^  projection_address
    evidence.address

  +  evidence_mount
    \  evidence=text_terminal_action_evidence
    ^  projection_action_mount
    evidence.mount
