- ethereum_wallet_console

' A saved wallet namespace. Caller supplies the ordinary Shrine namespace and
' host capabilities; private keys never enter this value.
+ ethereum_wallet_world
  + boot
    \ address=str
    ^ namespace
    = diff (axal/new[note] .none).put(['sys] (note/make myth/new))
    ?> (./accepted committed) (sov/step diff 0 0 sov/new)
        ; (error (pails/t "system seed failed"))
        | namespace ($x 17) sov/new (pin (system_publication 0 sov/new (pin [])))
    = [system signs] committed
      publication | pin (system_publication system.top system (system_publication/assigned system))
    ?> (./ok initial) (namespace/create ($x 17) sov/new publication)
        ; (error (pails/t "namespace boot failed"))
        | namespace ($x 17) sov/new publication
    | ethereum_wallet_app/install address initial
  + keep
    \ state=namespace
    ^ nat
    | Save (pin (ethereum_wallet_world/resume state))
  + resume
    \ state=namespace args=row[str]
    ^ nat
    | ethereum_wallet_console/serve state ethereum_wallet_world/keep
  + fresh
    \ address=nat
    ^ nat
    | ethereum_wallet_world/resume (ethereum_wallet_world/boot (str/from_atom address)) []
  + start
    \ state=namespace
    ^ nat
    | Spawn (helm/supervisor/run_keeping[namespace] ethereum_wallet_app/access ethereum_wallet_world/keep state)
  + attach
    \ config=ethereum_wallet_foot/config server=nat owner=iota
    ^ nat
    = ;foot (Spawn (ethereum_wallet_world/entry config [owner 'app 'ethereum]))
    ; (SendCaps foot 0 [server])
    foot
  + entry
    \ config=ethereum_wallet_foot/config home=path self=nat
    ^ nat
    = ;[message caps] (Recv[nat] 0)
    | ethereum_wallet_foot/run config caps.at(0) home self
