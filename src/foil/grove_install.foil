- pact
- grove_template

' Mount a compiled publication batch through the namespace event loop.
' The caller supplies a state with Pact, ward, and fresh installed.
+ grove_install
  + instantiate
    ' Read a published template; only explicit local references rebase.
    \ source=path version=nat target=path state=sov
    ^ either[iota sov]
    ?> (./some current) state.x_case(source)
      | ./err 'missing_grove_template
    ? !(eq current version) (./err 'stale_grove_template)
    ?> (./known card) state.x_latest(source)
      | ./err 'missing_grove_template
    ?> (./some held) card.get(grove_templates/slot)
      | ./err 'missing_grove_template
    ?> template=grove_template held
      | ./err 'invalid_grove_template
    ? !(eq template.version 1) (./err 'grove_template_version)
    = records (grove_templates/records target template)
      origin (safe version .x source)
      root_record
        | myth/sing grove_templates/source_slot origin
      records=row[[path myth]]
        ? (records.any((\ [path card] (equal path target))))
          | records.map
          \ [path card]
          ? !(equal path target) [path card]
          [path card.put(grove_templates/source_slot origin)]
        | records.cons [target root_record]
    | grove_install/mount target records state
  + mount
    \ root=path records=row[[path myth]] state=sov
    ^ either[iota sov]
    ? state.z_latest(root)
     > (./known tree) (./err 'installation_root_exists)
    = outside
        \ entry=[path myth]
        ^ bool
        = [path card] entry
        | ! (equal path.take(root.len) root)
    ? records.any(outside)
      | ./err 'publication_outside_root
    < records (grove_install/pins records state)
    = seeds
        | records.map
        \ [path card]
        [path.drop(root.len) card]
      manifest
        | mani 'grove (lore/line "Grove installation.") [] seeds []
      card (pact/card manifest "grove" 0 0)
      card card.put(limb_slot (kook [['pact]]))
      command (task/vine root (writ/make card))
    ? (cycle command 0 128 state)
     > (./fail reason) (./err reason)
     > (./spun next effects rounds ack spill)
      ? spill
       > (./some reason) (./err reason)
      ? effects.len (./err 'unexpected_installation_effects)
      | ./ok next

  + pins
    ' New local targets start at case one; external pins use live cases.
    \ records=row[[path myth]] state=sov
    ^ either[iota row[[path myth]]]
    % rest=row[[path myth]] records out=row[[path myth]] []
    ^ either[iota row[[path myth]]]
    ? (eq rest.len 0) (./ok out)
    = [path card] rest.at(0)
    < card (grove_install/pin_record records state card.tap card)
    | _ rest.drop(1) out.snoc([path card])
  + pin_record
    \ records=row[[path myth]] state=sov slots=row[mop/kv[path pail]]
      card=myth
    ^ either[iota myth]
    ? (eq slots.len 0) (./ok card)
    = [key held] slots.at(0)
    ? !((equal[path] key ['sys 'weft]) ||
        (equal[path] key ['sys 'tack]))
      | grove_install/pin_record records state slots.drop(1) card
    ?> pin=safe held
      | grove_install/pin_record records state slots.drop(1) card
    = local
        | records.any
        \ [path value]
        ? (equal pin.care (care/x)) (equal path pin.path)
        | equal path.take(pin.path.len) pin.path
      case=maybe[nat]
        ? local (./some 1)
        ? pin.care
         > .x state.x_case(pin.path)
         > .y state.y_case(pin.path)
         > .z state.z_case(pin.path)
    ?> (./some version) case
      | ./err 'missing_installation_target
    ? (eq version 0) (./err 'missing_installation_target)
    = card card.put(key (safe version pin.care pin.path))
    | grove_install/pin_record records state slots.drop(1) card
