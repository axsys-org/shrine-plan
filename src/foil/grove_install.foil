- pact
- grove_template

' Mount a compiled publication batch through the namespace event loop.
' The caller supplies a state with Pact, ward, and fresh installed.
+ grove_install
  + instantiate
    \ source=path version=nat target=path state=namespace
    ^ either[iota namespace]
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ?> (./known records)
      (namespace/page .x (./some version) source state)
      | ./err 'missing_grove_template
    ?> (./some record) records.fil
      | ./err 'missing_grove_template
    = card | unpin record.myth
    ?> (./some held) card.get(grove_templates/slot)
      | ./err 'missing_grove_template
    ?> template=grove_template held
      | ./err 'invalid_grove_template
    ? !(eq template.version grove_templates/version)
      | ./err 'grove_template_version
    ? !(grove_templates/resolved template)
      | ./err 'unresolved_instance_reference
    = records | grove_templates/records target template
      origin  | safe version .x source
      records=row[[path myth]]
        ? (records.any((\ [name card] (equal name target))))
          | records.map
            \ [name card]
            ? !(equal name target) [name card]
            [name card.put(grove_templates/source_slot origin)]
        | records.cons
          [target (myth/sing grove_templates/source_slot origin)]
    | grove_install/mount target records state

  + mount
    \ root=path records=row[[path myth]] state=namespace
    ^ either[iota namespace]
    ? !(state.permitted(root)) (./err 'write_outside_authority)
    ? (sovereign_peek root state).wyt
      | ./err 'installation_root_exists
    ? !(records.all((\ [name card] (pith_prefix root name))))
      | ./err 'publication_outside_root
    = valid
        | records.all
          \ [name card]
          | card.tap.all
            \ entry
            ? !((equal[path] entry.key bond/weft) ||
                (equal[path] entry.key bond/tack)) .true
            ?> link=safe entry.val .true
            ? (eq link.ver 0) .false
            = local
                | records.any
                  \ [target value]
                  ? (equal[care] link.care .x)
                    | equal[path] link.path target
                  | pith_prefix link.path target
            ? local (eq link.ver 1)
            ?> (./some history) state.history(link.path) .false
            | maybe/is_some
              (namespace/epoch link.care (./some link.ver)
                link.path history)
    ? !valid (./err 'missing_installation_target)
    = seeds | records.map (\ [name card] [name.drop(root.len) card])
      manifest
        | mani 'grove (lore/line "Grove installation.") [] seeds []
      registry=path [state.self 'kook 'pact]
      card
        | (pact/card manifest "grove" 0 0).put
          limb_slot (kook [registry])
      command | task/vine root (writ/make card)
      index   | sovereign_hive state
      [result next_index]
        | sovereign_cycle_with index command 0 128 0 0 state
    ? result
     > (./fail why) (./err why)
     > (./spun next effects rounds ack spill)
       ? spill
        > (./some why) (./err why)
       ? effects.len (./err 'unexpected_installation_effects)
       | ./ok next
