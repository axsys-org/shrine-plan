-  sept

+  testing
  '  Checks are data. The host forces each named case under Try.
  +  check
    : name=str pass=bool want=str got=str

  +  case
    : name=str run={\ unit}row[testing/check]

  +  same
    (@ v)
    \ name=str show={\ v}str want=v got=v
    ^ testing/check
    | testing/check name (equal want got)
      (show want) (show got)

  +  nat
    \ name=str want=nat got=nat
    ^ testing/check
    | testing/same[nat] name nat/show want got

  +  text
    \ name=str want=str got=str
    ^ testing/check
    | testing/check name (equal want got) want got

  +  table
    (@ v w)
    \ name=str show={\ w}str func={\ v}w
       rows=row[[input=v want=w]]
    ^ row[testing/check]
    | rows.map
     \ pair=[input=v want=w]
     ^ testing/check
     = [arg want] pair
     | testing/same[w] name show want (func arg)
