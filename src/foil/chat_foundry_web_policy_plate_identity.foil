-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_header [order=60]
-  chat_foundry_web_policy_result [order=70]
'  Quarantined compatibility policy for legacy Chat Plate identity and status.
'  It is bounded Web pronunciation and does not define new Foundry IR.
+  chat_foundry_web_policy_plate_identity
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence
       children=row[weft/node] header_style=chat_foundry_header/header_text_style
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'plate] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "article"
            [(weft/cls "plate chat-plate") (weft/att "data-active" "true")]
            children)] .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'kind] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/leaf "span" [(weft/cls "plate-kind")]
            (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'title] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span" [(weft/cls "plate-header-copy")]
            [(weft/leaf "strong"
               (chat_foundry_header/header_text_style_attrs header_style)
               (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))
             (weft/leaf "code" [] "/chat")])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is ['status 'live] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/leaf "span" [(weft/cls "plate-state")]
            (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))]
         .none)
    (chat_foundry_web_policy_result .false [] .none)
