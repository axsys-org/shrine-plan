-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=60]
-  compiler_api [order=61]
-  boot_mirror [order=62]
'  Test selection and publication are namespace operations in Foil.
'  Host ports supply evaluation, time, and exception containment.
+  doctest_work
  : target=path count=nat evaluate={\ nat}row[[i=nat pass=nat got=nat]]
+  doctest_ports
  : now={\ nat}nat
    attempt={\ {\ nat}compiler_seed}maybe[compiler_seed]
    failed={\ task}nat
+  boot_doctest
  +  tasks
    \ ports=doctest_ports work=row[doctest_work] state=namespace
    ^ row[task]
    | work.bind
    \ item
    ^ row[task]
    ? !(item.count) []
    ?> (./some version) (namespace/case .x item.target state) []
    = ;results (item.evaluate 0)
    = ;now (ports.now 0)
    = target item.target.snoc('dt)
      card | doctest/card now version results
      write=writ
        ? (namespace/case .x target state)
         > (./some _) (./poke card)
        | ./make card
    [(task/vine target write)]
  +  seed
    \ ports=doctest_ports commands=row[task] state=namespace
    ^ namespace
    | commands.fold state
    \ ;current=namespace command=task
    = invoke ports.attempt
      attempt
        | invoke
        \ _=nat
        | boot_mirror/seed [command] current
    = next=maybe[namespace]
        ? attempt
         > .none .none
         > (./some result)
           ? result
            > (./ready state) (./some state)
            > (./failed _ _) .none
    ? next
     > (./some state) state
    ; (ports.failed command)
    current
