-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  helm [order=80]
'  Inbound HTTP scheduling. The host owns sockets and connection capabilities;
'  ids below are local tickets. Browser routes prepare typed actions.
+  http_response
  :  status=nat body=nat ctype=nat
+  http_action
  &  http_action/reply
     http_action/write
     http_action/wait
  +  reply
    :  response=http_response
  +  write
    :  command=task target=path back=nat
  +  wait
    :  target=path record=myth
+  http_event
  &  http_event/request
     http_event/helm
     http_event/idle
  +  request
    :  id=nat action=http_action
  +  helm
    :  message=driver_in
  +  idle
    :
+  http_pending
  :  target=path id=nat
+  http_ack
  '  Every command, including crew publication, occupies one FIFO entry.
  &  http_ack/make
     http_ack/cull
     http_ack/write
     http_ack/watch
  +  make
    :  target=path
  +  cull
    :  target=path
  +  write
    :  id=nat target=path back=nat
  +  watch
    :
+  http_state
  :  pending=row[http_pending] queue=row[http_ack]
  +  empty
    ^ http_state
    | http_state [] []
+  http_effect
  &  http_effect/send
     http_effect/reply
     http_effect/listen
  +  send
    :  message=driver_out
  +  reply
    :  id=nat response=http_response
  +  listen
    :  port=nat
+  http_turn
  :  state=http_state effects=row[http_effect] stop=bool
+  http_driver
  +  unchanged
    \ s=http_state
    ^ http_turn
    | http_turn s [] .false
  +  response
    \ status=nat body=nat
    ^ http_response
    | http_response status body "text/plain; charset=utf-8"
  +  failure
    \ err=iota
    ^ http_response
    | http_driver/response 500 (| iota_show err)
  +  back
    \ loc=nat
    ^ http_response
    '  Escape the URL before placing it in either HTML attribute.
    = url | http_driver/escape loc
    | http_response 200
      (| cord/cat_all ["<!doctype html><html><head><meta http-equiv=" 34 "refresh" 34
        " content=" 34 "0;url=" url 34 "></head><body>committed; <a href=" 34 url 34
        ">back</a></body></html>"])
      "text/html; charset=utf-8"
  +  escape
    \ text=nat
    ^ nat
    = pieces
        % i=nat 0 out=row[nat] []
        ? (| eq i (| wid text)) out
        = c | load8 i text
          escaped=nat
            ? (| eq c 38) "&amp;"
            ? (| eq c 34) "&quot;"
            ? (| eq c 60) "&lt;"
            ? (| eq c 62) "&gt;"
            c
        | _ i.inc out.snoc(escaped)
    | cord/cat_all pieces
  +  without
    \ p=path pending=row[http_pending]
    ^ row[http_pending]
    | pending.keep
    \ entry
    !(| eq_pith p entry.target)
  +  send
    \ name=iota t=task
    ^ http_effect
    | http_effect/send | driver_out/cmd name t
  +  publish
    '  Changing the persistent crew hydrates already-completed requests.
    \ name=iota turn=http_turn
    ^ http_turn
    = s turn.state
      paths | s.pending.map (\ entry entry.target)
      effect | http_driver/send name (| helm/request_crew name paths)
    | http_turn s.set_queue(s.queue.snoc(http_ack/watch)) turn.effects.snoc(effect) turn.stop
  +  finish
    \ name=iota before=http_state turn=http_turn
    ^ http_turn
    ? (| equal before.pending turn.state.pending) turn
    | http_driver/publish name turn
  +  result
    '  Ordinary HTTP records and compiler/chore records share the wait path.
    \ rec=res[myth]
    ^ maybe[http_response]
    ?> (./known t) rec .none
    = status t.nat_at(['res_status] 0)
    ? status
      | ./some
      | http_response status t.nat_at(['res_body] 0)
        t.nat_at(['res_ctype] "text/plain; charset=utf-8")
    ? !(| eq 1 t.nat_at(['res_done] 0)) .none
    = err t.txt_at(['err])
      report t.txt_at(['report])
      value t.txt_at(['value])
      ty t.txt_at(['ty])
      law t.txt_at(['law])
      body=nat
        ? err err
        ? report report
        ? value
          | cord/cat_all ["value: " value
            (? ty (| cord/cat_all [10 "type:  " ty]) "")
            (? law (| cord/cat_all [10 10 law]) "")]
        "chore failed"
      code=nat
        ? err 500
        ? (report || value) 200
        500
    | ./some | http_driver/response code body
  +  request
    \ name=iota id=nat action=http_action s=http_state
    ^ http_turn
    ? action
     > (./reply response)
       | http_turn s [(| http_effect/reply id response)] .false
     > (./write command target back)
       | http_turn s.set_queue(s.queue.snoc((| http_ack/write id target back)))
         [(| http_driver/send name command)] .false
     > (./wait target record)
       = pending s.pending.snoc((| http_pending target id))
         queue s.queue.snoc((| http_ack/make target))
         command | task/vine target (| writ/make record)
       | http_turn (| http_state pending queue) [(| http_driver/send name command)] .false
  +  changed
    \ name=iota p=path rec=res[myth] s=http_state
    ^ http_turn
    = matches | s.pending.keep (\ entry (| eq_pith p entry.target))
    ? (| eq matches.len 0) (| http_driver/unchanged s)
    ?> (./some response) (| http_driver/result rec)
       | http_driver/unchanged s
    = next | http_state (| http_driver/without p s.pending) s.queue.snoc((| http_ack/cull p))
      cull | http_driver/send name (| task/vine p .cull)
      reply | http_effect/reply matches.at(0).id response
    | http_turn next [cull reply] .false
  +  ack
    \ r=rsvp s=http_state
    ^ http_turn
    ? (| eq s.queue.len 0) (| http_driver/unchanged s)
    = head s.queue.at(0)
      next s.set_queue(s.queue.drop(1))
    ? head
     > (./write id target back)
       = response
           ? r
            > (./ok _) | http_driver/back back
            > (./no err) | http_driver/failure err
       | http_turn next [(| http_effect/reply id response)] .false
     > (./make p)
       ?> (./no err) r (| http_driver/unchanged next)
       = replies
           | s.pending.keep((\ entry (| eq_pith p entry.target))).map
           \ entry
           | http_effect/reply entry.id (| http_driver/failure err)
       | http_turn next.set_pending((| http_driver/without p s.pending)) replies .false
     > (./cull _) | http_driver/unchanged next
     > .watch
       ?> (./no err) r (| http_driver/unchanged next)
       = replies | s.pending.map (\ entry (| http_effect/reply entry.id (| http_driver/failure err)))
       | http_turn next.set_pending([]) replies .false
  +  step
    \ name=iota s=http_state event=http_event
    ^ http_turn
    = turn
        ? event
         > .idle | http_driver/unchanged s
         > (./request id action) | http_driver/request name id action s
         > (./helm message)
           ? message
            > (./go rec)
              = port=nat
                  ? rec
                   > (./known t) t.nat_at(['port] 0)
                  0
                effects=row[http_effect]
                  ? port [(| http_effect/listen port)]
                  []
              | http_driver/publish name (| http_turn s effects .false)
            > (./change p rec) | http_driver/changed name p rec s
            > (./qres p rec) | http_driver/changed name p rec s
            > (./view _ _) | http_driver/unchanged s
            > (./ack r) | http_driver/ack r s
            > .die
              = response | http_driver/response 503 "HTTP driver stopped"
                waiting | s.pending.map (\ entry (| http_effect/reply entry.id response))
                writing=row[http_effect]
                  | s.queue.fold []
                  \ out item
                  ? item
                   > (./write id _ _) out.snoc((| http_effect/reply id response))
                  out
              | http_turn http_state/empty waiting.weld(writing) .true
    ? turn.stop turn
    | http_driver/finish name s turn
