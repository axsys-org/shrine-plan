+  bst_maybe
  (@ v)
  &  ($some v)
     $none
+  bst
  '  Size-balanced binary search tree over nat keys, polymorphic in
  '  the value type: bst[v].
  '  The workhorse fixture: see /bst/insert , /bst/get , /bst/size .
  (@ v)
  +  empty
    $  []
  +  node
    (@ v)
    $  [sz=nat key=nat val=v l=bst[v] r=bst[v]]
  &  bst/empty
     bst/node[v]
  +  size
    '  Number of nodes in a /bst .
    '  Reads the cached sz face of /bst/node - does not traverse.
    '  .
    '  ?=  ((bst/size[nat] (bst/empty)) 0)
    '  ?=  ((bst/size[nat] (bst/sing[nat] 1 2)) 1)
    '  ?=  ((bst/size[nat] (bst/duo[nat] 1 2 3 4)) 2)
    (@ v)
    \  t=bst[v]
    ^  nat
    ?  t
     > bst/empty  0
     > n=bst/node[v] n.sz
  +  n
    ' creates a bst from a key value and children
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    (bst/node[v] (add (inc l.size) r.size) key val l r)
  +  sing
    ' creates a single element bst
    ' ?=  ((bst/size[nat] (bst/sing[nat] 1 2)) 1)
    (@ v)
    \  key=nat val=v
    ^  bst[v]
    (bst/n[v] key val (bst/empty) (bst/empty))
  +  rot_l
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  r
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v] (bst/n[v] n.key n.val (bst/n[v] key val l n.l) n.r)
  +  rot_r
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  l
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v] (bst/n[v] n.key n.val n.l (bst/n[v] key val n.r r))
  +  rot_ll
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  r
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v]
       ?  n.l
        > bst/empty  (bst/rot_l[v] key val l r)
        > m=bst/node[v] (bst/n[v] m.key m.val (bst/n[v] key val l m.l) (bst/n[v] n.key n.val m.r n.r))
  +  rot_rr
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  l
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v]
       ?  n.r
        > bst/empty  (bst/rot_r[v] key val l r)
        > m=bst/node[v] (bst/n[v] m.key m.val (bst/n[v] n.key n.val n.l m.l) (bst/n[v] key val m.r r))
  +  rotate_l
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  r
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v]
       ?  (lt n.l.size n.r.size.mul(2))
          (bst/rot_l[v] key val l r)
       (bst/rot_ll[v] key val l r)
  +  rotate_r
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  l
     > bst/empty  (bst/n[v] key val l r)
     > n=bst/node[v]
       ?  (lt n.r.size n.l.size.mul(2))
          (bst/rot_r[v] key val l r)
       (bst/rot_rr[v] key val l r)
  +  balance
    (@ v)
    \  key=nat val=v l=bst[v] r=bst[v]
    ^  bst[v]
    ?  (le (add l.size r.size) 1)
       (bst/n[v] key val l r)
    ?  (ge r.size (mul 4 l.size))
       (bst/rotate_l[v] key val l r)
    ?  (ge l.size (mul 4 r.size))
       (bst/rotate_r[v] key val l r)
    (bst/n[v] key val l r)
  +  insert
    '  Insert key/val, replacing an existing key.
    '  Rebalances through /bst/balance on the way up.
    '
    '  ?=  ((bst/got[nat] 5 0 (bst/insert[nat] 5 50 (bst/empty))) 50)
    '  ?=  ((bst/got[nat] 5 0 (bst/insert[nat] 5 99 (bst/insert[nat] 5 50 (bst/empty)))) 99)
    '  ?=  ((bst/got[nat] 3 0 (bst/insert[nat] 3 99 (bst/insert[nat] 5 50 (bst/empty)))) 99)
    (@ v)
    \  key=nat val=v x=bst[v]
    ^  bst[v]
    ?  x
     > bst/empty  (bst/sing[v] key val)
     > n=bst/node[v]
       ?  (lt key n.key)
          (bst/balance[v] n.key n.val (~ key val n.l) n.r)
       ?  (lt n.key key)
          (bst/balance[v] n.key n.val n.l (~ key val n.r))
       (bst/n[v] key val n.l n.r)
  +  duo
    (@ v)
    \  key=nat val=v key1=nat val1=v
    ^  bst[v]
    = > one (bst/sing[v] key val)
    one.insert(key1 val1)
  +  get
    (@ v)
    \  key=nat tree=bst[v]
    ^  bst_maybe[v]
    ?  tree
     > bst/empty  $none
     > n=bst/node[v]
       ?  (lt key n.key)
          (~ key n.l)
       ?  (lt n.key key)
          (~ key n.r)
       ($some n.val)
  +  got
    '  Lookup with a caller-supplied default.
    '  Unwraps the /bst_maybe from /bst/get .
    '
    '  ?=  ((bst/got[nat] 2 0 (bst/duo[nat] 1 10 2 20)) 20)
    '  ?=  ((bst/got[nat] 9 0 (bst/duo[nat] 1 10 2 20)) 0)
    (@ v)
    \  key=nat def=v tree=bst[v]
    ^  v
    ?  (bst/get[v] key tree)
     > $none  def
     > ($some val=v)  val
  +  has
    (@ v)
    \  key=nat tree=bst[v]
    ^  nat
    ?  (bst/get[v] key tree)
     > $none  0
     > ($some val=v)  1
  +  map
    (@ v w)
    \  fun={v; w} t=bst[v]
    ^  bst[w]
    ?  t
     > bst/empty  (bst/empty)
     > n=bst/node[v] (bst/n[w] n.key (fun n.val) (~ fun n.l) (~ fun n.r))
+  saga
  $  [l=nat r=nat]