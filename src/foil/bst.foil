+  bst_maybe
  &  ($some nat)
     $none
+  bst
  '  Size-balanced binary search tree over nat keys.
  '  The workhorse fixture: see /bst/insert , /bst/get , /bst/size .
  +  empty
    $  []
  +  node
    $  [sz=nat key=nat val=nat l=bst r=bst]
  &  bst/empty
     bst/node
  +  size
    '  Number of nodes in a /bst .
    '  Reads the cached sz face of /bst/node - does not traverse.
    '
    '  ?=  ((bst/size (bst/empty)) 0)
    '  ?=  ((bst/size (bst/sing 1 2)) 1)
    '  ?=  ((bst/size (bst/duo 1 2 3 4)) 2)
    \  t=bst
    ^  nat
    ?  t
     > bst/empty  0
     > n=bst/node n.sz
  +  n
    \  key=nat val=nat l=bst r=bst
    ^  bst
    (bst/node (add (inc (bst/size l)) (bst/size r)) key val l r)
  +  sing
    \  key=nat val=nat
    ^  bst
    (bst/n key val (bst/empty) (bst/empty))
  +  rot_l
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  r
     > bst/empty  (bst/n key val l r)
     > n=bst/node (bst/n n.key n.val (bst/n key val l n.l) n.r)
  +  rot_r
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  l
     > bst/empty  (bst/n key val l r)
     > n=bst/node (bst/n n.key n.val n.l (bst/n key val n.r r))
  +  rot_ll
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  r
     > bst/empty  (bst/n key val l r)
     > n=bst/node
       ?  n.l
        > bst/empty  (bst/rot_l key val l r)
        > m=bst/node (bst/n m.key m.val (bst/n key val l m.l) (bst/n n.key n.val m.r n.r))
  +  rot_rr
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  l
     > bst/empty  (bst/n key val l r)
     > n=bst/node
       ?  n.r
        > bst/empty  (bst/rot_r key val l r)
        > m=bst/node (bst/n m.key m.val (bst/n n.key n.val n.l m.l) (bst/n key val m.r r))
  +  rotate_l
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  r
     > bst/empty  (bst/n key val l r)
     > n=bst/node
       ?  (lt (bst/size n.l) (mul 2 (bst/size n.r)))
          (bst/rot_l key val l r)
       (bst/rot_ll key val l r)
  +  rotate_r
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  l
     > bst/empty  (bst/n key val l r)
     > n=bst/node
       ?  (lt n.r.size n.l.size.mul(2))
          (bst/rot_r key val l r)
       (bst/rot_rr key val l r)
  +  balance
    \  key=nat val=nat l=bst r=bst
    ^  bst
    ?  (le (add l.size r.size) 1)
       (bst/n key val l r)
    ?  (ge r.size (mul 4 l.size))
       (bst/rotate_l key val l r)
    ?  (ge l.size (mul 4 r.size))
       (bst/rotate_r key val l r)
    (bst/n key val l r)
  +  insert
    '  Insert key/val, replacing an existing key.
    '  Rebalances through /bst/balance on the way up.
    '
    '  ?=  ((bst/got 5 (bst/insert 5 50 (bst/empty))) 50)
    '  ?=  ((bst/got 5 (bst/insert 5 99 (bst/insert 5 50 (bst/empty)))) 99)
    \  key=nat val=nat x=bst
    ^  bst
    ?  x
     > bst/empty  (bst/sing key val)
     > n=bst/node
       ?  (lt key n.key)
          (bst/balance n.key n.val (~ key val n.l) n.r)
       ?  (lt n.key key)
          (bst/balance n.key n.val n.l (~ key val n.r))
       (bst/n key val n.l n.r)
  +  duo
    \  key=nat val=nat key1=nat val1=nat
    ^  bst
    (bst/insert key1 val1 (bst/sing key val))
  +  get
    \  key=nat tree=bst
    ^  bst_maybe
    ?  tree
     > bst/empty  $none
     > n=bst/node
       ?  (lt key n.key)
          (~ key n.l)
       ?  (lt n.key key)
          (~ key n.r)
       ($some n.val)
  +  got
    '  Lookup with 0 as the missing-key default.
    '  Unwraps the /bst_maybe from /bst/get .
    '
    '  ?=  ((bst/got 2 (bst/duo 1 10 2 20)) 20)
    '  ?=  ((bst/got 9 (bst/duo 1 10 2 20)) 0)
    \  key=nat tree=bst
    ^  nat
    ?  (bst/get key tree)
     > $none  0
     > ($some val=nat)  val
  +  has
    \  key=nat tree=bst
    ^  nat
    ?  (bst/get key tree)
     > $none  0
     > ($some val=nat)  1
  +  map
    \  fun={nat; nat} t=bst
    ^  bst
    ?  t
     > bst/empty  (bst/empty)
     > n=bst/node (bst/n n.key (fun n.val) (~ fun n.l) (~ fun n.r
