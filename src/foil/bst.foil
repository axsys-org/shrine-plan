+  bst_
  $  k v
  :  sz=nat key=nat val=v l=(? 0 bst_) r=(? 0 bst_)
+  bst
  $  k v
  ?  0
     :  sz=nat key=nat val=v l=bst r=bst
  +  empty  0
  +  n
    $  k v
    \  key=nat val=v l=bst r=bst
    = > sz  l.sz.add(r.siz).inc
    %   seq  k
    %   seq  sz
    (bst sz key val l r)
  +  sing
    $  k v
    \  key=nat val=v
    (bst 1 key val 0 0)
  +  rot-l
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  r  > 0  (error "empty rotation")
    (bst:n r.key r.val (bst:n key val l r.r) r.l)
  +  rot-r
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  l  > 0  (error "empty rotation")
    (bst:n l.key l.val (bst:n key val) a)
  +  rot-ll
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  r      > 0  (error "empty rotation")
    ?  r.l  > 0  (error "empty rotation")
    %  bst:n
      r.l.key
      r.l.val
      (bst:n key val l r.l.r)
      (bst:n r.key r.val r.l.l r.l.r)
  +  rot-rr
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  l      > 0  (error "empty rotation")
    ?  l.r  > 0  (error "empty rotation")
    %  bst:n
      l.r.key
      l.r.val
      (bst:n l.key l.val l.r.l l.r.r)
      (bst:n key val l.r.r r)
  +  rotate-l
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  r  > 0 (error "empty rotation")
    ?  r.l.sz.lt(r.r.sz.mul(2))
      (rot-l k v l r)
    (rot-ll k v l r)
  +  rotate-r
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    ?  r  > 0 (error "empty rotation")
    ?  l.r.sz.lt(r.r.sz.mul(2))
      (rot-r k v l r)
    (rot-rr k v l r)
  +  balance
    $  v
    \  key=nat val=v l=bst[v] r=bst[v]
    = > top (N k v lr)
    ?  l.sz.add(r.sz).le(1) top
    ?  r.sz.ge(l.sz.mul(4)) (rotate-l k v l r)
    ?  l.sz.ge(r.sz.mul(4)) (rotate-r k v l r)
    top
  +  insert
    $  v
    \  key=nat val=v x=bst[v]
    ?  x  > 0 (bst:sing key val)
    ?  key.cmp(x.key)
      > ord:lt (balance x.key x.val x.l.insert(key val) x.r)
      > ord:eq (bst x.sz key val x.l x.r)
      > ord:gt (balance x.key x.val x.l x.r.insert(key val))
  +  duo
    $  v
    \  key=nat val=v key1=nat val1=v
    (bst:sing k v).insert(key1 val1)
  +  get
    $  v
    \  key=nat tree=bst[v]
    ^  unit[v]
    ?  tree > 0 0
    ?  key.cmp(k)
     > ord:lt  tree.l.get(k)
     > ord:eq  ($some tree.val)
     > ord:gt  tree.r.get(k)
  +  got
    $  v
    \  key=nat tree=bst[v]
    ^  v
    tree.get(key).need
  +  has
    $  v
    \  key=nat tree=bst[v]
    tree.get(key).some?
  +  map
    $  v v1
    \  fun={v; v1} t=bst[v]
    ?  t > 0 0
    (bst t.sz t.key (fun t.val) t.l.map(fun) t.r.map(fun))
  +  gas
    $  v





