-  sept [order=10]
-  shrine_types [order=20]
-  lain_types [order=28]
-  lain_peek [order=29]
-  lain_poke [order=30]
-  chore [order=40]
'  build: the request and result vocabulary for the build chore
'  families (helm-build.rvr) — evaluating expressions, recompiling a
'  module, and saving source, all as namespace records under the
'  chore driver's /io name.
+  build
  +  eval_req
    '  ?=  ((build/eval_req "sept" "1").txt_at(['mod]) "sept")
    '  Evaluate an expression against a module's own compiled
    '  subject; the answer pokes ['value]/['ty]/['law] (or ['err])
    '  back onto this node.
    \  mod=str expr=str
    ^  myth
    =  t1  (chore/req 'eval)
    =  t2  t1.put(['mod] (pails/t mod))
    t2.put(['expr] (pails/t expr))
  +  compile_req
    '  Recompile one module against the boot cache: the report and
    '  changeset poke back here, and the module's mirror records
    '  remount.
    \  mod=str
    ^  myth
    =  t1  (chore/req 'compile)
    t1.put(['mod] (pails/t mod))
  +  save_req
    '  Write a module's source, then recompile it.
    \  mod=str src=str
    ^  myth
    =  t1  (chore/req 'save)
    =  t2  t1.put(['mod] (pails/t mod))
    t2.put(['src] (pails/t src))
  +  val_t
    '  ?=  ((build/val_t "42" "nat" "").txt_at(['value]) "42")
    '  ?=  ((build/val_t "42" "" "").txt_at(['ty]) "")
    '  ?=  ((build/val_t "42" "" "law").txt_at(['law]) "law")
    '  An eval answer: rendered value text, type text, and — for
    '  law-like values — the decompiled law (empty text = absent).
    \  v=str ty2=str law=str
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['value] (pails/t v))
    =  t3
         ?  ty2.len
            t2.put(['ty] (pails/t ty2))
         t2
    ?  law.len
       t3.put(['law] (pails/t law))
    t3
  +  err_t
    '  A failed eval or compile: the pretty diagnostic text.
    \  e=str
    ^  myth
    =  t  myth/new
    t.put(['err] (pails/t e))
  +  report_t
    '  A resync's human-readable report.
    \  r=str
    ^  myth
    =  t  myth/new
    t.put(['report] (pails/t r))
  +  changeset_t
    '  A resync's structural changeset, as mirror paths.
    \  changed=row[path] added=row[path] removed=row[path]
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['changed] (pails/ps changed))
    =  t3  t2.put(['added] (pails/ps added))
    t3.put(['removed] (pails/ps removed))
