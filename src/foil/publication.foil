- namespace

' Preparation is pure. All records, including generated members, must be
' enumerated before the compiler uses these assignments.
+ publication_batch
  : authority=iota expected=axal[nat] assigned=axal[nat]

  + valid_authority
    \ authority=iota
    ^ bool
    ? (eq_iota authority 'sys) .true
    ? !(eq (aura_tag authority) "x") .false
    !(eq (quip_val authority) 0)

  + prepare
    \ authority=iota names=row[path] state=sov
    ^ either[iota publication_batch]
    ? !(publication_batch/valid_authority authority)
      (./err 'invalid_authority)
    ? !(namespace/confined [authority] state)
      (./err 'authority_mismatch)
    % pending=row[path] names
      expected=axal[nat] (axal/new[nat] .none)
      assigned=axal[nat] (axal/new[nat] .none)
    ^ either[iota publication_batch]
    ? (eq pending.len 0)
      | ./ok (publication_batch authority expected assigned)
    = name | pending.at 0
    ? !(pith_prefix [authority] name) (./err 'authority_mismatch)
    ? expected.dip(name).fil
     > (./some _) (./err 'duplicate_definition)
    = previous
        ? state.x_case(name)
         > (./some number) number
         > .none 0
    | _ pending.drop(1) expected.put(name previous)
        assigned.put(name (inc previous))

  + publish
    ' Records carry their public /sys/mold descriptor and any associated
    ' artifacts. No part of the candidate store escapes until every
    ' expected predecessor and resulting data case has been checked.
    \ records=axal[myth] now=nat block=nat state=sov batch=publication_batch
    ^ either[iota sov]
    ? !(publication_batch/valid_authority batch.authority)
      (./err 'invalid_authority)
    ? !(namespace/confined [batch.authority] state)
      (./err 'authority_mismatch)
    ? !(eq batch.expected.tap.len batch.assigned.tap.len)
      (./err 'invalid_assignments)
    ? !(equal records.tap.len batch.assigned.tap.len)
      (./err 'incomplete_publication)
    = predecessors
        | batch.expected.tap.all
          \ [name expected]
          = actual
              ? state.x_case(name)
               > (./some number) number
               > .none 0
          | eq actual expected
    ? !predecessors (./err 'stale_publication)
    = valid
        | records.tap.all
          \ [name record]
          ? !(pith_prefix [batch.authority] name) .false
          ?> (./some assigned) (batch.assigned.dip(name).fil)
            .false
          ?> (./some expected) (batch.expected.dip(name).fil)
            .false
          ? !(eq assigned (inc expected)) .false
          ? record.get(['sys 'mold])
           > (./some _) .true
           > .none .false
    ? !valid (./err 'invalid_definition_record)
    = diffs
        | records.tap.fold (axal/new[note] .none)
          \ out [name record]
          | out.put name (note/make record)
    ? (sov/step diffs now block state)
     > (./rejected reason) (./err reason)
     > (./accepted result=[next=sov signs=axal[sign]])
       = [next signs] result
       = consistent
           | batch.assigned.tap.all
             \ [name assigned]
             ? next.x_case(name)
              > (./some actual) (eq assigned actual)
              > .none .false
       ? !consistent (./err 'inconsistent_publication)
       | ./ok next

  + publish_namespace
    ' Verify the prepared batch before journaling one local transaction.
    \ system=pin[row[[path nat]]] records=axal[myth]
      now=nat block=nat state=namespace batch=publication_batch
    ^ either[iota namespace/committed]
    ? !(equal system (unpin state.system).definitions)
      | ./err 'system_publication_mismatch
    ? !(eq_iota batch.authority state.self)
      | ./err 'write_outside_authority
    < checked
      | publication_batch/publish records now block state.local batch
    = changes
        | records.tap.fold (axal/new[note] .none)
          \ out [name card]
          | out.put name (note/make card)
    ? (namespace/step changes now block state)
     > (./rejected why) (./err why)
     > (./accepted committed) (./ok committed)
