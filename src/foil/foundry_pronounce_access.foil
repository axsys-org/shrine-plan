-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_pronounce [order=40]
-  foundry_pronounce_walk [order=50]
'  Stable construction and inspection gates for untyped hosts and focused
'  tests.  These accessors intentionally carry no traversal or terminal policy.

+  foundry_pronounce_access
  +  make_occurrence
    \  semantic_address=maybe[projection_address]
       placement_address=maybe[projection_address]
       parent_address=maybe[projection_address]
       depth=nat kind=iota role=path parameters=row[projection_parameter]
       placement_role=maybe[path]
       placement_parameters=row[projection_parameter]
       resolution_context=maybe[foundry_digest]
       hole=maybe[projection_pronunciation_hole]
    ^  projection_pronunciation_occurrence
    (projection_pronunciation_occurrence semantic_address placement_address
      parent_address depth kind role parameters placement_role
      placement_parameters resolution_context hole)

  +  make_pronunciation
    \  revision=foundry_digest roots=row[projection_address]
       occurrences=row[projection_pronunciation_occurrence]
    ^  projection_pronunciation
    (projection_pronunciation revision roots occurrences)

  +  result_admitted
    \  result=projection_pronunciation_result
    ^  bool
    ?  result
     > projection_pronunciation_result/admitted  .true
     > projection_pronunciation_result/refused   .false
  +  result_pronunciation
    \  result=projection_pronunciation_result
    ^  maybe[projection_pronunciation]
    ?  result
     > x=projection_pronunciation_result/admitted  (./some x.pronunciation)
     > projection_pronunciation_result/refused     .none
  +  result_code
    \  result=projection_pronunciation_result
    ^  maybe[iota]
    ?  result
     > projection_pronunciation_result/admitted    .none
     > x=projection_pronunciation_result/refused   (./some x.refusal.code)
  +  occurrences
    \  pronunciation=projection_pronunciation
    ^  row[projection_pronunciation_occurrence]
    pronunciation.occurrences
  +  roots
    \  pronunciation=projection_pronunciation
    ^  row[projection_address]
    pronunciation.roots
  +  occurrence_semantic_address
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[projection_address]
    occurrence.semantic_address
  +  occurrence_placement_address
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[projection_address]
    occurrence.placement_address
  +  occurrence_depth
    \  occurrence=projection_pronunciation_occurrence
    ^  nat
    occurrence.depth
  +  occurrence_kind
    \  occurrence=projection_pronunciation_occurrence
    ^  iota
    occurrence.kind
  +  occurrence_role
    \  occurrence=projection_pronunciation_occurrence
    ^  path
    occurrence.role
  +  occurrence_placement_role
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[path]
    occurrence.placement_role
  +  occurrence_resolution_context
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[foundry_digest]
    occurrence.resolution_context
  +  occurrence_hole
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[projection_pronunciation_hole]
    occurrence.hole
  +  hole_subject
    \  hole=projection_pronunciation_hole
    ^  maybe[path]
    hole.subject
  +  hole_source
    \  hole=projection_pronunciation_hole
    ^  maybe[path]
    hole.source
  +  hole_semantic_fallback
    \  hole=projection_pronunciation_hole
    ^  maybe[path]
    hole.semantic_fallback
