-  sept [order=10]
-  semidoc [order=20]
'  Static Nenex Foundry surface anatomy.  These declarations carry authored
'  Semidoc bytes only and are independent of admission, projection, and Web.
+  nenex_foundry_surfaces
  +  plate_header_block_src
    '  The shared Plate Header Block anatomy.  Slots are addressed semantic
    '  contracts; they are not screen positions and carry no Chat behavior.
    '  Header Text Style is selected separately by the catalog below, so the
    '  same anatomy may be pronounced with another admitted style Layer.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/system/blocks/plate_header"
       ";@ /surface/root ;/foundry/system/blocks/plate_header/root"
       ";. /authoring/blocks/plate-header"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/system/blocks/plate_header"
       "  ;. /foundry/system/blocks/plate_header/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/leading"
       "    ;@ /surface/place ;/slot/leading"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/decoration"
       "    ;. /foundry/system/blocks/plate_header/leading"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/title"
       "    ;@ /surface/place ;/slot/title"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/label"
       "    ;. /foundry/system/blocks/plate_header/title"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/subtitle"
       "    ;@ /surface/place ;/slot/subtitle"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/system/blocks/plate_header/subtitle"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/status"
       "    ;@ /surface/place ;/slot/status"
       "    ;@ /slot/accepts ;/surface/block ;/surface/text ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/status"
       "    ;. /foundry/system/blocks/plate_header/status"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/trailing"
       "    ;@ /surface/place ;/slot/trailing"
       "    ;@ /slot/accepts ;/surface/block ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/system/blocks/plate_header/trailing"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/plate_header/content"
       "    ;@ /surface/place ;/slot/content"
       "    ;@ /slot/accepts ;/surface/block ;/surface/plate"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/content"
       "    ;. /foundry/system/blocks/plate_header/content"])
  +  title_bar_block_src
    '  Shared projected window chrome.  The title is the only required
    '  attachment; control groups and trailing actions are independently
    '  optional so Web, Apple, text, and compact pronunciations can preserve
    '  the same Slot names without inventing empty renderer content.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/system/blocks/title_bar"
       ";@ /surface/root ;/foundry/system/blocks/title_bar/root"
       ";. /authoring/blocks/title-bar"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/system/chrome/title_bar"
       "  ;. /foundry/system/blocks/title_bar/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/title_bar/controls"
       "    ;@ /surface/place ;/slot/controls"
       "    ;@ /slot/accepts ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/window_controls"
       "    ;. /foundry/system/blocks/title_bar/controls"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/title_bar/title"
       "    ;@ /surface/place ;/slot/title"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/window_label"
       "    ;. /foundry/system/blocks/title_bar/title"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/title_bar/subtitle"
       "    ;@ /surface/place ;/slot/subtitle"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/system/blocks/title_bar/subtitle"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/title_bar/trailing"
       "    ;@ /surface/place ;/slot/trailing"
       "    ;@ /slot/accepts ;/surface/block ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/system/blocks/title_bar/trailing"])
  +  window_controls_block_src
    '  A renderer-neutral group of projected window actions.  Each control is
    '  optional because the active provider and ceiling decide which projected
    '  controls exist.  These roles do not describe or replace trusted host
    '  controls, and their presence grants no action authority.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/system/blocks/window_controls"
       ";@ /surface/root ;/foundry/system/blocks/window_controls/root"
       ";. /authoring/blocks/window-controls"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/system/chrome/window_controls"
       "  ;. /foundry/system/blocks/window_controls/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/window_controls/close"
       "    ;@ /surface/place ;/slot/close"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/system/blocks/window_controls/close"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/window_controls/minimize"
       "    ;@ /surface/place ;/slot/minimize"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/system/blocks/window_controls/minimize"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/system/slots/window_controls/zoom"
       "    ;@ /surface/place ;/slot/zoom"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/system/blocks/window_controls/zoom"])
  +  chat_message_block_src
    '  Product-local Chat Message anatomy.  The body is the only invariant;
    '  author, avatar, metadata, and status may disappear without changing the
    '  body Slot.  Message records and speaker policy remain Chat-owned.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/chat/blocks/message"
       ";@ /surface/root ;/foundry/chat/blocks/message/root"
       ";. /authoring/chat/blocks/message"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/blocks/message"
       "  ;. /foundry/chat/blocks/message/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message/avatar"
       "    ;@ /surface/place ;/slot/avatar"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/decoration"
       "    ;. /foundry/chat/blocks/message/avatar"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message/author"
       "    ;@ /surface/place ;/slot/author"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/label"
       "    ;. /foundry/chat/blocks/message/author"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message/body"
       "    ;@ /surface/place ;/slot/body"
       "    ;@ /slot/accepts ;/surface/text ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/content"
       "    ;. /foundry/chat/blocks/message/body"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message/metadata"
       "    ;@ /surface/place ;/slot/metadata"
       "    ;@ /slot/accepts ;/surface/text ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/chat/blocks/message/metadata"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message/status"
       "    ;@ /surface/place ;/slot/status"
       "    ;@ /slot/accepts ;/surface/text ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/status"
       "    ;. /foundry/chat/blocks/message/status"])
  +  chat_message_log_block_src
    '  Product-local ordered Chat Message collection.  Empty logs are valid, so
    '  messages are many and optional; an explicit empty or status attachment
    '  is separate from the live Message Log Hole used by a projection.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/chat/blocks/message_log"
       ";@ /surface/root ;/foundry/chat/blocks/message_log/root"
       ";. /authoring/chat/blocks/message-log"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/blocks/message_log"
       "  ;. /foundry/chat/blocks/message_log/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message_log/messages"
       "    ;@ /surface/place ;/slot/messages"
       "    ;@ /slot/accepts ;/surface/block"
       "    ;@ /slot/cardinality many"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/content"
       "    ;. /foundry/chat/blocks/message_log/messages"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message_log/empty"
       "    ;@ /surface/place ;/slot/empty"
       "    ;@ /slot/accepts ;/surface/text ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/chat/blocks/message_log/empty"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/message_log/status"
       "    ;@ /surface/place ;/slot/status"
       "    ;@ /slot/accepts ;/surface/text ;/surface/block ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/status"
       "    ;. /foundry/chat/blocks/message_log/status"])
  +  chat_composer_block_src
    '  Product-local Chat Composer anatomy.  The input and send action are
    '  required attachments, but the Chat Flow remains responsible for source,
    '  action admission, side selection, and message submission.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/chat/blocks/composer"
       ";@ /surface/root ;/foundry/chat/blocks/composer/root"
       ";. /authoring/chat/blocks/composer"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/blocks/composer"
       "  ;. /foundry/chat/blocks/composer/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/composer/sender"
       "    ;@ /surface/place ;/slot/sender"
       "    ;@ /slot/accepts ;/surface/block ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/control"
       "    ;. /foundry/chat/blocks/composer/sender"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/composer/input"
       "    ;@ /surface/place ;/slot/input"
       "    ;@ /slot/accepts ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/input"
       "    ;. /foundry/chat/blocks/composer/input"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/composer/send"
       "    ;@ /surface/place ;/slot/send"
       "    ;@ /slot/accepts ;/surface/block ;/surface/glyph"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/chat/blocks/composer/send"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/composer/hint"
       "    ;@ /surface/place ;/slot/hint"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/chat/blocks/composer/hint"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/composer/status"
       "    ;@ /surface/place ;/slot/status"
       "    ;@ /slot/accepts ;/surface/text ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/status"
       "    ;. /foundry/chat/blocks/composer/status"])
  +  chat_conversation_item_block_src
    '  Product-local Chat navigation item anatomy.  Selection, routing, unread
    '  computation, and conversation source identity belong to Chat records;
    '  the reusable contract owns only stable attachment roles.
    ^  nat
    (joined_all 10
      [";@ /foundry/kind surface"
       ";@ /foundry/name ;/foundry/chat/blocks/conversation_item"
       ";@ /surface/root ;/foundry/chat/blocks/conversation_item/root"
       ";. /authoring/chat/blocks/conversation-item"
       "  ;@ /surface/kind block"
       "  ;@ /surface/role ;/foundry/chat/blocks/conversation_item"
       "  ;. /foundry/chat/blocks/conversation_item/root"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/conversation_item/leading"
       "    ;@ /surface/place ;/slot/leading"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/decoration"
       "    ;. /foundry/chat/blocks/conversation_item/leading"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/conversation_item/label"
       "    ;@ /surface/place ;/slot/label"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required true"
       "    ;@ /slot/participation ;/participation/label"
       "    ;. /foundry/chat/blocks/conversation_item/label"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/conversation_item/summary"
       "    ;@ /surface/place ;/slot/summary"
       "    ;@ /slot/accepts ;/surface/text"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/description"
       "    ;. /foundry/chat/blocks/conversation_item/summary"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/conversation_item/status"
       "    ;@ /surface/place ;/slot/status"
       "    ;@ /slot/accepts ;/surface/text ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/status"
       "    ;. /foundry/chat/blocks/conversation_item/status"
       "    ;@ /surface/kind slot"
       "    ;@ /surface/role ;/foundry/chat/slots/conversation_item/trailing"
       "    ;@ /surface/place ;/slot/trailing"
       "    ;@ /slot/accepts ;/surface/glyph ;/surface/block"
       "    ;@ /slot/cardinality one"
       "    ;@ /slot/required false"
       "    ;@ /slot/participation ;/participation/action"
       "    ;. /foundry/chat/blocks/conversation_item/trailing"])
