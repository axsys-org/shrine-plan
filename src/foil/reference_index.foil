- shrine_types
- sept

' This is the reverse index. It tells what refers to a name, and the store
' keeps it as the store commits.
'
' An edge is a slot of one record (its holder). The value of the slot is a
' reference (a safe) that names a target. Only typed references are edges: a
' reference is a reference. Text that contains a name becomes an edge only
' when a record holds the reference. The index does not scan prose.
'
' Each edge keeps the epoch when it appeared and the epoch when it stopped.
' Thus the edges at each epoch are exact for the full history, and no data is
' copied again. Each name keeps the epoch when an edge at or below it last
' changed. This epoch is the clock of the name. The clock is the case of the
' /r listing of the name, for live wakes and for catch-up equally.
'
' The index keeps each name as its publisher spells it. A world's mount of a
' different world's publication is at /<self>/her/<node>/... and is that
' world's /<node>/our/<self>/... path. (Below public, it is that world's
' /our/public/... path.) This is the pairwise identity /A/our/B = /B/her/A. A
' reference that is written in one form or in the other form is one edge to
' one name. The world that wrote the reference holds the edge.
+ r_spell
  ' This function gives the /r path that lists the references that name a
  ' target: /r/<len>/<path>. The path has a length prefix, as /h has. Thus a
  ' target is looked up and not searched for.
  \ target=path
  ^ path
  = head=path ['r ($u target.len)]
  | head.weld(target)

+ is_r
  ' This function tells if this path is under the reverse lens (/r).
  ' /r/<len>/<target...> lists the references that name the target. The lens
  ' is read only and derived, as /h is.
  \ p=path
  ^ bool
  p.starts('r)

+ r_address
  ' This is a parsed /r path. It gives the target that the length of the path
  ' names, and what is asked for below the listing.
  : target=path relative=path

+ r_parse
  ' This function gives a parsed /r path. It gives none when the path is not a
  ' complete /r address.
  \ requested=path
  ^ maybe[r_address]
  ? (lt requested.len 3) .none
  = width=nat
      ? requested.at(1)
       > ($u n=nat) n
      0
  ? ((eq width 0) || (lt requested.len (add 2 width))) .none
  | ./some (r_address requested.drop(2).take(width) requested.drop((add 2 width)))

+ held_reference
  ' This is a slot of a record and the reference that the slot holds.
  : slot=path target=safe

+ reference_edge
  ' This is one slot of one record that holds a reference to a target. The
  ' edge goes from the epoch when it appeared (since) to the epoch when it
  ' stopped (until). until is 0 while the edge is live.
  : holder=path slot=path target=safe since=nat until=nat

+ edge_sign
  ' This function gives the grade that a reverse listing gets when its edges
  ' change. The members of the listing moved, thus its record and its shape
  ' moved.
  ^ sign
  | sign 1 2 2

+ reference_index
  : by=axal[row[reference_edge]] clock=axal[nat]

  + new
    ' This function gives an index that has no edges and no clocks.
    ^ reference_index
    | reference_index (axal/new[row[reference_edge]] .none) (axal/new[nat] .none)

  + segment_is
    ' This function tells if two path segments spell the same word. It
    ' compares the segments as they are spelled, because the runtime faults
    ' when it compares a symbol with a numeric segment as iotas.
    \ a=iota b=iota
    ^ bool
    | equal[str] (path_show [a]) (path_show [b])

  + canonical
    ' This function gives a name as its publisher spells it. A mount path of
    ' world self becomes the /our name of the publisher. Each other name stays
    ' as it is.
    \ self=iota name=path
    ^ path
    ? (lt name.len 3) name
    ? !(reference_index/segment_is name.at(0) self) name
    ? !(reference_index/segment_is name.at(1) 'her) name
    = node name.at(2)
      rest name.drop(3)
      public=path [node 'our 'public]
      pairwise=path [node 'our self]
    ? (and (gt rest.len 0) (reference_index/segment_is rest.at(0) 'public))
      | public.weld(rest.drop(1))
    | pairwise.weld(rest)

  + mounted
    ' This function gives where world self holds a publisher's name: its /her
    ' mount path. It gives none when the publisher does not publish the name
    ' to self (pairwise or public).
    \ self=iota name=path
    ^ maybe[path]
    ? (lt name.len 3) .none
    ? (reference_index/segment_is name.at(0) self) .none
    ? !(reference_index/segment_is name.at(1) 'our) .none
    = node name.at(0)
      audience name.at(2)
      rest name.drop(3)
      pairwise=path [self 'her node]
      public=path [self 'her node 'public]
    ? (reference_index/segment_is audience self) (./some pairwise.weld(rest))
    ? (reference_index/segment_is audience 'public) (./some public.weld(rest))
    .none

  + slots
    ' This function gives each typed reference that a record holds, as [slot
    ' target]. The target is as its publisher spells it.
    \ self=iota record=maybe[myth]
    ^ row[held_reference]
    = none=row[held_reference] []
    ?> (./some held) record none
    | held.tap.fold none
      \ out [slot value]
      ? value
       > target=safe out.snoc((held_reference slot (safe target.ver target.care (reference_index/canonical self target.path))))
      out

  + written
    ' This function gives each reference that a record holds, as its writer
    ' spelled it: [slot target]. It is for a view that draws what a record is
    ' about (graph). A path that is written in a text is not one of these
    ' references. A reference is a value in a slot, here and also in the
    ' index.
    \ record=maybe[myth]
    ^ row[[slot=path target=safe]]
    ?> (./some record) record []
    | record.tap.fold []
      \ out [slot held]
      ? held
       > target=safe out.snoc([slot target])
      out
  + live
    ' This function tells if the edge is open at an epoch. Epoch 0 asks for
    ' the live edges.
    \ epoch=nat edge=reference_edge
    ^ bool
    ? (eq epoch 0) (eq edge.until 0)
    ? (gt edge.since epoch) .false
    | ((eq edge.until 0) || (lt epoch edge.until))

  + touch
    ' This function moves the clock of the target and of each name above it
    ' forward. It does this because a deep listing below any of these names
    ' has a member that moved.
    \ target=path epoch=nat clock=axal[nat]
    ^ axal[nat]
    % width=nat target.len out=axal[nat] clock
    ^ axal[nat]
    ? (eq width 0) out
    | _ width.dec out.put(target.take(width) epoch)

  + end
    ' This function closes the live edge from holder's slot to target at this
    ' epoch.
    \ holder=path slot=path target=safe epoch=nat by=axal[row[reference_edge]]
    ^ axal[row[reference_edge]]
    ?> (./some edges) by.get(target.path) by
    | by.put target.path
      | edges.map
        \ edge=reference_edge
        ^ reference_edge
        ? (and (eq edge.until 0) (and (equal[path] edge.holder holder) (and (equal[path] edge.slot slot) (equal[safe] edge.target target))))
          | reference_edge edge.holder edge.slot edge.target edge.since epoch
        edge

  + apply
    ' This function applies a change of one record's assertion at an epoch. It
    ' closes the edges that the record does not hold now, and opens the edges
    ' that the record now holds. It also moves the clocks of the names of
    ' these edges forward. If a change leaves the references of the record as
    ' they were, the function changes no part of the index.
    \ holder=path before=maybe[myth] after=maybe[myth] epoch=nat index=reference_index
    ^ reference_index
    ? (eq holder.len 0) index
    = self holder.at(0)
      name (reference_index/canonical self holder)
      old (reference_index/slots self before)
      fresh (reference_index/slots self after)
    ? (equal old fresh) index
    = held
        \ pairs=row[held_reference] pair=held_reference
        ^ bool
        | pairs.any
          \ other=held_reference
          ^ bool
          | and (equal[path] other.slot pair.slot) (equal[safe] other.target pair.target)
      ended
        | old.fold index
          \ out=reference_index pair=held_reference
          ^ reference_index
          ? (held fresh pair) out
          | reference_index (reference_index/end name pair.slot pair.target epoch out.by) (reference_index/touch pair.target.path epoch out.clock)
    | fresh.fold ended
      \ out=reference_index pair=held_reference
      ^ reference_index
      ? (held old pair) out
      = none=row[reference_edge] []
        edges (out.by.get(pair.target.path)).fall(none)
      | reference_index out.by.put(pair.target.path edges.snoc((reference_edge name pair.slot pair.target epoch 0))) (reference_index/touch pair.target.path epoch out.clock)

  + signs
    ' This function gives the signs that a commit adds for its reverse
    ' listings. It adds one sign for each name if the clock of the name moved
    ' forward in this epoch. The sign is at the /r address of the name.
    \ epoch=nat before=reference_index after=reference_index signs=axal[sign]
    ^ axal[sign]
    | after.clock.tap.fold signs
      \ out [name at]
      ? !(eq at epoch) out
      ? (eq ((before.clock.get(name)).fall(0)) at) out
      | out.put (r_spell name) edge_sign

  + beneath
    ' This function gives each edge that is open at an epoch, if the target of
    ' the edge is the name or is below the name.
    \ target=path epoch=nat index=reference_index
    ^ row[reference_edge]
    = none=row[reference_edge] []
    | (index.by.dip(target)).tap.fold none
      \ out [relative edges]
      | out.weld (edges.filter((\ edge=reference_edge (reference_index/live epoch edge))))

  + readers
    ' This function gives the holders of the references that are open at an
    ' epoch and that read a changed name:
    ' - a reference at care x reads the record of its target
    ' - a reference at care y reads the record and its children
    ' - a reference at care z reads all that is below the target
    '
    ' A culled name reaches each reference at or below it. The function looks
    ' up the references by target, for the name and its ancestors. It does not
    ' scan holders. It gives each holder one time.
    \ self=iota changed=row[[path bool]] epoch=nat index=reference_index
    ^ row[path]
    = none=row[path] []
      nothing=row[reference_edge] []
    | changed.fold none
      \ out [raw culled]
      = name (reference_index/canonical self raw)
        reach
          \ depth=nat edge=reference_edge
          ^ bool
          ? !(reference_index/live epoch edge) .false
          ? edge.target.care
           > .x (eq depth 0)
           > .y (le depth 1)
          .true
        above
          % width=nat name.len acc=row[path] out
          ^ row[path]
          ? (eq width 0) acc
          = edges (index.by.get(name.take(width))).fall(nothing)
            depth (sub name.len width)
          | _ width.dec (reference_index/holders (edges.filter((\ edge=reference_edge (reach depth edge)))) acc)
      ? !culled above
      | reference_index/holders (reference_index/beneath name epoch index) above

  + holders
    ' This function adds the holders of the edges to out. It adds each holder
    ' one time only.
    \ edges=row[reference_edge] out=row[path]
    ^ row[path]
    | edges.fold out
      \ acc=row[path] edge=reference_edge
      ^ row[path]
      ? (acc.any((\ p=path (equal[path] p edge.holder)))) acc
      | acc.snoc(edge.holder)

  + case
    ' This function gives the case of the listing of a name. The case is the
    ' epoch when an edge at or below the name last appeared or stopped. The
    ' function gives none while there was no reference to the name at any
    ' time.
    \ target=path index=reference_index
    ^ maybe[nat]
    | index.clock.get(target)
