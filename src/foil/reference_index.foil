- shrine_types
- sept

' Derived store metadata. Edges retain the complete safe, including care and
' version; the target trie is only a lookup key and never replaces that identity.
+ r_spell
  ' The /r path that reads the references naming a target: /r/<len>/<path>,
  ' length-prefixed like /h, so a target is never found by searching.
  \ target=path
  ^ path
  = head=path ['r ($u target.len)]
  | head.weld(target)

+ reference_edge
  : holder=path slot=path target=safe

+ reference_index
  ' The current edges by target, and the last `span` snapshots of them, one per epoch that changed an edge.
  : into=axal[row[reference_edge]] past=uon[pin[axal[row[reference_edge]]]]

  + span
    ' Snapshots kept; an epoch older than the oldest kept reads unknown.
    ^ nat
    64

  + new
    ' An empty index: no edges, no snapshots.
    ^ reference_index
    | reference_index (axal/new[row[reference_edge]] .none) (uon/empty)

  + slots
    ' Every reference a record holds: a slot whose value is a reference, and a
    ' reference inside prose, a path in brackets ([/0x11/user/orgs/verisk]),
    ' held by the slot the prose sits in.  One mechanism for sources,
    ' provenance and connection; nothing else is indexed, nothing else is named.
    \ record=maybe[myth]
    ^ row[[slot=path target=safe]]
    ?> (./some record) record []
    | record.tap.fold []
      \ out [slot held]
      ? held
       > target=safe out.snoc([slot target])
       > text=pails/t (reference_index/hold slot (reference_index/prose text.t) out)
      out

  + hold
    ' Every reference found in one prose slot, as [slot target] pairs.
    \ slot=path targets=row[safe] out=row[[slot=path target=safe]]
    ^ row[[slot=path target=safe]]
    % i=nat 0 out=row[[slot=path target=safe]] out
    ^ row[[slot=path target=safe]]
    ? (eq i targets.len) out
    | _ i.inc out.snoc([slot targets.at(i)])

  + prose
    ' The references inside a text: each [/path] that parses, in order.
    \ text=str
    ^ row[safe]
    = pieces=row[str] (str/split_byte 91 text)
    % i=nat 1 out=row[safe] []
    ^ row[safe]
    ? (ge i pieces.len) out
    = inner=row[str] (str/split_byte 93 pieces.at(i))
    ? (lt inner.len 2) (_ i.inc out)
    = span inner.at(0)
    ? !(eq (str/slice 0 1 span) "/") (_ i.inc out)
    ?> (./some target) (path_parse span) (_ i.inc out)
    | _ i.inc out.snoc((safe 0 .x target))

  + remove
    ' Drop one holder's edge to a target; a target with no edges left leaves the index.
    \ holder=path slot=path target=safe into=axal[row[reference_edge]]
    ^ axal[row[reference_edge]]
    ?> (./some edges) into.get(target.path) into
    = remaining
        | edges.filter
          \ edge
          | !(and (equal[path] edge.holder holder) (equal[path] edge.slot slot))
    ? (eq remaining.len 0) into.del(target.path)
    | into.put target.path remaining

  + replace
    ' Called only for records whose own assertion changed, after admission.
    ' Literal-only changes preserve the index value and its historical clock.
    \ holder=path before=maybe[myth] after=maybe[myth] into=axal[row[reference_edge]]
    ^ axal[row[reference_edge]]
    = old (reference_index/slots before)
      fresh (reference_index/slots after)
    ? (equal old fresh) into
    = removed
        | old.fold into
          \ out [slot target]
          | reference_index/remove holder slot target out
    | fresh.fold removed
      \ out [slot target]
      = edges (out.get(target.path)).fall([])
      | out.put target.path edges.snoc((reference_edge holder slot target))

  + commit
    ' Keep this epoch's edges as a snapshot when they changed, and drop the oldest past span.
    \ epoch=nat into=axal[row[reference_edge]] index=reference_index
    ^ reference_index
    ? (equal into index.into) index
    = past index.past.put(($u epoch) (pin into))
      entries past.tap
    ? (le entries.len reference_index/span) (reference_index into past)
    = [dropped kept] past.del(entries.at(0).key)
    | reference_index into kept

  + at
    ' The edges as of an epoch: the current ones at 0 or the top, the snapshot at or before the epoch otherwise, unknown past the span.
    \ epoch=nat index=reference_index
    ^ axal[row[reference_edge]]
    ? (eq epoch 0) index.into
    ?> (./some entry) index.past.floor(($u epoch))
      (axal/new[row[reference_edge]] .none)
    = [version held] entry
    | unpin held

  + beneath
    ' Every edge whose target is at or beneath a name, as of an epoch.
    \ target=path epoch=nat index=reference_index
    ^ row[reference_edge]
    | (index.at(epoch)).dip(target).tap.fold []
      \ out [relative edges]
      | out.weld edges

  + signals
    ' Reverse dependencies change only when reference slots change. Notify
    ' each indexed target prefix, including insertion of its first edge.
    \ before=maybe[myth] after=maybe[myth] signs=axal[sign]
    ^ axal[sign]
    = old (reference_index/slots before)
      fresh (reference_index/slots after)
    ? (equal old fresh) signs
    = edges=row[[slot=path target=safe]] old.weld(fresh)
    | edges.fold signs
      \ out=axal[sign] edge=[slot=path target=safe]
      ^ axal[sign]
      = [slot target] edge
      % width=nat target.path.len result=axal[sign] out
      ^ axal[sign]
      ? (eq width 0) result
      | _ width.dec result.put((r_spell target.path.take(width)) (sign 1 2 2))
