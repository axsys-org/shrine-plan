- eden_srs
- debugger_contract

' Debugger startup is independent of any demo app. The host supplies optional
' SRS source; no component is installed over an existing namespace.
+ eden_debug
  + compile
    \ slots=str types=str debugger=str srs=maybe[str]
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ either[eden_srs/failure row[eden_srs/batch]]
    < slots (eden_srs/compile_batch ['sys] slots [] compiler)
    < types (eden_srs/compile_batch ['sys 'types] types slots.records compiler)
    = dependencies (row/weld slots.records types.records)
    < components (eden_srs/compile_batch ['weft 'debug 'v1] debugger dependencies compiler)
    = batches=row[eden_srs/batch] [slots types components]
    ? srs
     > .none (./ok batches)
     > (./some source)
      < app (eden_srs/compile_batch ['gov 'srs] source dependencies compiler)
      | ./ok (row/weld batches [app])
  + publish
    \ batches=row[eden_srs/batch] state=sov
    ^ either[eden_srs/failure sov]
    % remaining=row[eden_srs/batch] batches state=sov state
    ^ either[eden_srs/failure sov]
    ? (eq remaining.len 0) (./ok state)
    < next (eden_srs/publish_batch remaining.at(0) state)
    | _ remaining.drop(1) next
  + main
    \ port=nat slots=str types=str debugger=str srs=maybe[str]
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ nat
    ? (eden_debug/compile slots types debugger srs compiler)
     > (./err failure) (error failure)
     > (./ok batches)
      ? (eden/boot port)
       > (./failed stage reason) (error (eden/failed stage reason))
       > (./ready initial)
        ? (eden_debug/publish batches initial)
         > (./err failure) (error failure)
         > (./ok state)
          > (./known registry) state.y_latest(['weft 'debug 'v1])
            | error (pails/t "Published debugger registry is not readable")
          > (./some page) registry.dip(['page]).fil
            | error (pails/t "Published debugger has no page component")
          | eden/serve_with state (http_foot/run_with (./some registry))
