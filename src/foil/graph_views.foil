- view_walk
- reference_index

' Explorer policy is a set of named computations over the namespace. Nothing
' here owns a second store. Canonical references and assertion records remain
' where their authors put them; these functions only arrange observations.
+ graph_views
  + reference
    \ slot=path record=myth
    ^ maybe[safe]
    ?> (./some held) record.get(slot) .none
    ?> ref=safe held .none
    | ./some ref
  + record
    \ source=safe next={\ myth}view_plan
    ^ view_plan
    | ./need (view_read (view_ops/at source [] .x) .all)
      \ value=res[axal[myth]]
      ^ view_plan
      ? value
       > (./known tree) (next (tree.fil.fall(myth/new)))
      | ./need (view_read (view_ops/at source [] .y) .names)
        \ shape=res[axal[myth]]
        ^ view_plan
        ' A name nothing was written at (null, or unknown: the store does
        ' not know a never-written name) is a fact to draw, not a failure.
        | next myth/new
  + canonical
    ' Only an explicit graft origin changes authority. A cell's input is not
    ' automatically its identity: an analysis is not the record it analyzes.
    \ source=safe remaining=nat trail=row[safe] next={\ safe}view_plan
    ^ view_plan
    ? (eq remaining 0) (./fail "reference origin limit")
    ? (trail.any((\ previous (view_walk/same previous source)))) (./fail "reference origin cycle")
    | ./need (view_read (view_ops/at source [] .x) (view_select/slots [['sys 'view 'origin]]))
      \ value=res[axal[myth]]
      ^ view_plan
      ?> (./known tree) value (next source)
      ?> (./some record) tree.fil (next source)
      ?> (./some origin) (graph_views/reference ['sys 'view 'origin] record) (next source)
      ? (view_walk/same source origin) (next source)
      | graph_views/canonical origin remaining.dec trail.snoc(source) next
  + canonical_view
    \ get={\ myth care path view_select}view_plan context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | graph_views/canonical source 16 []
      \ origin=safe
      ^ view_plan
      | get context.put(bond/tack origin) cr relative select
  + incoming
    \ source=safe next={\ axal[myth]}view_plan
    ^ view_plan
    = name (view_walk/name source)
    | ./need (view_read (safe 0 .z (r_spell name)) .all)
      \ value=res[axal[myth]]
      ^ view_plan
      ' A name nothing points at has no edges.
      = tree=axal[myth]
          ?> (./known found) value (axal/new[myth] .none)
          found
      = exact
          | tree.tap.fold (axal/new[myth] .none)
            \ out [at edge]
            ?> (./some target) (graph_views/reference ['target] edge) out
            ? !(equal[path] name (view_walk/name target)) out
            | out.put at edge
      | next exact
  + result
    \ tree=axal[myth] cr=care relative=path select=view_select
    ^ view_plan
    = tree tree.dip(relative)
    ? (and (eq tree.kid.size 0) !(maybe/is_some tree.fil)) (./fail "missing branch")
    = selected
        ? (equal[care] cr .x) (axal/new[myth] tree.fil)
        ? (equal[care] cr .y)
          | tree.kid_tap.fold (axal/new[myth] tree.fil)
            \ out [name child]
            | out.put [name] (child.fil.fall(myth/new))
        tree
    ?> (./known answer) (view_project select (./known selected)) (./fail "projection unavailable")
    | ./done answer
  + links
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/canonical_view graph_views/links_at context cr relative select
  + links_at
    ' Reference occurrences, including mentions, retain the actual source and
    ' slot. Merely mentioning something does not assert a domain relationship.
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | graph_views/incoming source
      \ edges=axal[myth]
      ^ view_plan
      = output
          | edges.tap.fold (axal/new[myth] (./some myth/new))
            \ out [at edge]
            ?> (./some holder) (graph_views/reference ['holder] edge) out
            ? (pith_prefix (view_walk/name source) (view_walk/name holder)) out
            | out.put at edge
      = focused (sorge[myth] cr output.dip(relative))
        entries focused.tap
      % i=nat 0 enriched=axal[myth] focused
      ^ view_plan
      ? (eq i entries.len) (graph_views/result enriched cr [] select)
      = [at edge] entries.at(i)
        resume (_ i.inc)
      ?> (./some holder) (graph_views/reference ['holder] edge) (resume enriched)
      | ./need (view_read holder (view_select/slots [bond/weft]))
        \ record=res[axal[myth]]
        ^ view_plan
        = cell
            ?> (./known tree) record .false
            ?> (./some value) tree.fil .false
            | maybe/is_some value.get(bond/weft)
          updated edge.put(['cell] (pails/b cell)).put(['hole] (pails/b .false))
        | resume enriched.put(at updated)
  + subject
    ' An explicit subject wins. The conventional same/<assertion> folder is
    ' an assertion about its parent, never a second copy of that parent.
    \ source=safe record=myth
    ^ safe
    ? (graph_views/reference ['subject] record)
     > (./some subject) subject
    = name (view_walk/name source)
      cut=maybe[nat]
        % i=nat 0
        ^ maybe[nat]
        ? (eq i name.len) .none
        ? (eq_iota name.at(i) 'same) (./some i)
        | _ i.inc
    ? cut
     > (./some width) (safe 0 .x name.take(width))
    source
  + placements
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/canonical_view graph_views/placements_at context cr relative select
  + placements_at
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | graph_views/incoming source
      \ incoming=axal[myth]
      ^ view_plan
      = edges incoming.tap
      % i=nat 0 output=axal[myth] (axal/new[myth] (./some myth/new))
      ^ view_plan
      ? (eq i edges.len) (graph_views/result output cr relative select)
      = [at edge] edges.at(i)
        resume (_ i.inc)
      ?> (./some slot) edge.path_at(['slot]) (resume output)
      ? !(equal[path] slot bond/tack) (resume output)
      ?> (./some holder) (graph_views/reference ['holder] edge) (resume output)
      = name (view_walk/name holder)
      ?> (./some local) (graph_views/user_relative name) (resume output)
      ? (graph_views/private_part local) (resume output)
      | graph_views/record holder
        \ record=myth
        ^ view_plan
        ? !(graph_views/placement record) (resume output)
        ? (maybe/is_some record.get(['moved_to])) (resume output)
        = placement (myth/sing ['source] holder)
          placement
            | record.tap.fold placement
              \ out [slot held]
              ? (pith_prefix ['sys] slot) out
              ? held
               > ref=safe out
              | out.put slot.cons('note) held
        | resume output.put(name.cons(($u name.len)) placement)
  + identity
    ' Closure over explicit same assertions only. Matching spellings or text
    ' candidates never establish identity. Missing evidence stays unavailable.
    \ pending=row[safe] members=axal[safe] next={\ row[safe]}view_plan
    ^ view_plan
    ? (eq pending.len 0) (next (members.tap.map((\ [name ref] ref))))
    = source pending.at(0)
      name (view_walk/name source)
      rest pending.drop(1)
    ? (maybe/is_some members.get(name)) (graph_views/identity rest members next)
    ? (ge members.tap.len 64) (./fail "identity expansion limit")
    = members members.put(name source)
    | graph_views/record source
      \ record=myth
      ^ view_plan
      = outgoing
          ? (graph_views/reference ['same] record)
           > (./some other) rest.snoc(other)
          rest
      | ./need (view_read (view_ops/at source ['same] .z) .all)
        \ asserted=res[axal[myth]]
        ^ view_plan
        = outgoing
            ?> (./known tree) asserted outgoing
            | tree.tap.fold outgoing
              \ found [at assertion]
              ?> (./some other) (graph_views/reference ['same] assertion) found
              | found.snoc other
        | graph_views/incoming source
          \ incoming=axal[myth]
          ^ view_plan
          = empty=row[safe] []
            candidates
              | incoming.tap.fold empty
                \ found [at edge]
                ?> (./some slot) edge.path_at(['slot]) found
                ? !((equal[path] slot ['same]) || (equal[path] slot ['subject])) found
                ?> (./some holder) (graph_views/reference ['holder] edge) found
                | found.snoc holder
          % i=nat 0 queue=row[safe] outgoing
          ^ view_plan
          ? (eq i candidates.len) (graph_views/identity queue members next)
          = holder candidates.at(i)
            resume (_ i.inc)
          | graph_views/record holder
            \ assertion=myth
            ^ view_plan
            ?> (./some other) (graph_views/reference ['same] assertion) (resume queue)
            = subject (graph_views/subject holder assertion)
            ? (equal[path] name (view_walk/name subject)) (resume queue.snoc(other))
            ? (equal[path] name (view_walk/name other)) (resume queue.snoc(subject))
            | resume queue
  + identities
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/canonical_view graph_views/identities_at context cr relative select
  + identities_at
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | graph_views/identity [source] (axal/new[safe] .none)
      \ members=row[safe]
      ^ view_plan
      = placements
          | members.fold (axal/new[safe] .none)
            \ out member
            = name (view_walk/name member)
            | out.put name.cons(($u name.len)) member
      | view_ops/collection placements cr relative select
  + parts
    ^ row[iota]
    ['talk 'turns 'mentions 'asks 'found 'status 'taken 'context 'views 'integrated 'syncs 'runs 'repairs 'identities]
  + user_relative
    \ name=path
    ^ maybe[path]
    % i=nat 0
    ^ maybe[path]
    ? (eq i name.len) .none
    ? (eq_iota name.at(i) 'user) (./some name.drop(i.inc))
    | _ i.inc
  + seg_is
    ' A path segment against a word: a numeric segment is simply not that
    ' word, where an iota comparison would fault.
    \ seg=iota word=iota
    ^ bool
    | equal[str] (path_show [seg]) (path_show [word])
  + private_part
    \ name=path
    ^ bool
    = parts graph_views/parts
    | name.any((\ part (parts.any((\ hidden (graph_views/seg_is part hidden))))))
  + placement
    \ record=myth
    ^ bool
    | and (maybe/is_some record.get(bond/weft)) (maybe/is_some (graph_views/reference bond/tack record))
  + assertion
    ' The assertion protocol is identified by its fields. A business record
    ' under /claims is still a thing and must be visible to the property view.
    \ record=myth
    ^ bool
    | and (maybe/is_some record.get(['slot])) (maybe/is_some record.get(['value]))
  + named
    \ record=myth
    ^ bool
    | gt (record.txt_at(['name])).len 0
  + thing
    \ name=path tree=axal[myth]
    ^ bool
    = record tree.fil.fall(myth/new)
    ? (graph_views/placement record) .false
    ? (maybe/is_some (graph_views/reference ['moved_to] record)) .false
    ?> (./some relative) (graph_views/user_relative name) .false
    ? ((lt relative.len 2) || (graph_views/private_part relative)) .false
    ? (graph_views/assertion record) .false
    ? (eq relative.len 2) ((gt record.tap.len 0) || (gt tree.kid.size 0))
    ? !(graph_views/named record) .false
    = own
        | record.tap.any
          \ [slot held]
          ? (pith_prefix ['sys] slot) .false
          | !((equal[path] slot ['name]) || ((equal[path] slot ['description]) || ((equal[path] slot ['source]) || (equal[path] slot ['sources]))))
    ? own .true
    ? (eq tree.kid.size 0) .true
    | tree.kid_tap.any
      \ [key child]
      = record child.fil.fall(myth/new)
      | and (graph_views/named record) !(graph_views/placement record)
  + frontier
    \ source=safe next={\ axal[myth]}view_plan
    ^ view_plan
    | ./need (view_read (view_ops/at source [] .y) .all)
      \ value=res[axal[myth]]
      ^ view_plan
      ' A name nothing was written at has an empty frontier (the store
      ' answers unknown for a never-written name).
      ?> (./known tree) value (next (axal/new[myth] .none))
      | next tree
  + holder
    \ source=safe original=path remaining=nat next={\ maybe[[safe path]]}view_plan
    ^ view_plan
    ? (eq remaining 0) (./fail "relation ownership limit")
    = name (view_walk/name source)
    ?> (./some relative) (graph_views/user_relative name) (next .none)
    ? (lt relative.len 2) (next .none)
    | graph_views/frontier source
      \ tree=axal[myth]
      ^ view_plan
      ? (graph_views/thing name tree)
        = label=path
            ? (equal[path] name original) []
            ? (eq original.len name.len.inc) original.drop(name.len)
            [original.at((sub original.len 2))]
        | next (./some [source label])
      = parent (safe 0 .x name.take(name.len.dec))
      | graph_views/holder parent original remaining.dec next
  + relation
    ' strength: 'solid for a reference slot or a judgement, 'mention for an edge
    ' that exists only because a stored text names the thing.
    : direction=iota label=path other=safe via=safe about=safe note=myth strength=iota
  + mention
    ' A text's mention record, under the web pages: /web/.../<text>/mentions.
    \ relative=path
    ^ bool
    ? (eq relative.len 0) .false
    | and (pith_prefix ['web] relative) (graph_views/seg_is relative.at(relative.len.dec) 'mentions)
  + refs
    \ record=myth
    ^ row[[path safe]]
    = empty=row[[path safe]] []
    | record.tap.fold empty
      \ out [slot held]
      ? (pith_prefix ['sys] slot) out
      ? ((equal[path] slot ['source]) || ((equal[path] slot ['sources]) || (equal[path] slot ['moved_to]))) out
      ?> target=safe held out
      ?> (./some relative) (graph_views/user_relative (view_walk/name target)) out.snoc([slot target])
      ? (pith_prefix ['web] relative) out
      | out.snoc [slot target]
  + primary
    \ source=safe folder=path refs=row[[path safe]]
    ^ maybe[path]
    ? (eq refs.len 1)
      = [slot target] refs.at(0)
      | ./some slot
    = name (view_walk/name source)
      slug name.at(name.len.dec)
      matching
        | refs.filter
          \ [slot target]
          = name (view_walk/name target)
          | and (gt name.len 0) (eq_iota slug name.at(name.len.dec))
    ? (eq matching.len 1)
      = [slot target] matching.at(0)
      | ./some slot
    = singular (graph_views/singular (path_show folder))
      matching (refs.filter((\ [slot target] (equal[str] (graph_views/singular (path_show slot)) singular))))
    ? (and (gt folder.len 0) (eq matching.len 1))
      = [slot target] matching.at(0)
      | ./some slot
    .none
  + singular
    \ text=str
    ^ str
    % size=nat text.len
    ^ str
    ? (eq size 0) ""
    ? !(eq text.at(size.dec) 115) text.slice(0 size)
    | _ size.dec
  + qualifiers
    \ record=myth keep=path
    ^ myth
    | record.tap.fold myth/new
      \ out [slot held]
      ? ((pith_prefix ['sys] slot) || (equal[path] slot keep)) out
      | out.put slot held
  + own_relations
    \ source=safe record=myth
    ^ row[graph_views/relation]
    = empty=row[graph_views/relation] []
    | record.tap.fold empty
      \ out [slot held]
      ? (pith_prefix ['sys] slot) out
      ? (equal[path] slot ['moved_to]) out
      ?> other=safe held out
      ?> (./some relative) (graph_views/user_relative (view_walk/name other)) out
      ? (pith_prefix ['web] relative) out
      | out.snoc (graph_views/relation 'out slot other source source myth/new 'solid)
  + branch_relations
    \ about=safe pending=row[[safe nat]] found=row[graph_views/relation] next={\ row[graph_views/relation]}view_plan
    ^ view_plan
    ? (eq pending.len 0) (next found)
    = [source depth] pending.at(0)
      rest pending.drop(1)
      name (view_walk/name source)
      relative name.drop((view_walk/name about).len)
    ? (graph_views/private_part relative) (graph_views/branch_relations about rest found next)
    | graph_views/frontier source
      \ tree=axal[myth]
      ^ view_plan
      = record tree.fil.fall(myth/new)
      ? ((graph_views/thing name tree) || ((graph_views/placement record) || (graph_views/assertion record)))
        | graph_views/branch_relations about rest found next
      = folder=path
          ? (eq relative.len 1) relative
          [relative.at((sub relative.len 2))]
        refs (graph_views/refs record)
        primary (graph_views/primary source folder refs)
        more
          | refs.fold found
            \ out [slot target]
            = included
                ?> (./some selected) primary .true
                | equal[path] selected slot
            ? !included out
            = label (? (maybe/is_some primary) folder folder.weld(slot))
            | out.snoc (graph_views/relation 'out label target source about (graph_views/qualifiers record slot) 'solid)
        rest
          ? (eq depth 0) rest
          | tree.kid_tap.fold rest
            \ out [key child]
            | out.snoc [(view_ops/at source [key] .x) depth.dec]
      | graph_views/branch_relations about rest more next
  + incoming_relations
    \ about=safe pending=row[myth] found=row[graph_views/relation] next={\ row[graph_views/relation]}view_plan
    ^ view_plan
    ? (eq pending.len 0) (next found)
    = edge pending.at(0)
      rest pending.drop(1)
      resume (graph_views/incoming_relations about rest)
    ?> (./some source) (graph_views/reference ['holder] edge) (resume found next)
    ?> (./some slot) edge.path_at(['slot]) (resume found next)
    = name (view_walk/name source)
    ?> (./some relative) (graph_views/user_relative name) (resume found next)
    ? (graph_views/mention relative)
      ' A stored text names this thing: a tentative edge to the text, drawn
      ' and attributed, never followed further.
      = text (safe 0 .x name.take(name.len.dec))
      | resume found.snoc((graph_views/relation 'in ['mentioned] text source about myth/new 'mention)) next
    ? ((graph_views/private_part relative) || ((pith_prefix ['web] relative) || (equal[path] slot ['moved_to]))) (resume found next)
    | graph_views/record source
      \ record=myth
      ^ view_plan
      ? (graph_views/assertion record) (resume found next)
      | graph_views/holder source name 16
        \ owner=maybe[[safe path]]
        ^ view_plan
        ?> (./some pair) owner (resume found next)
        = [holder folder] pair
        ? (view_walk/same holder about) (resume found next)
        ? ((eq folder.len 0) || ((equal[path] slot ['source]) || (equal[path] slot ['sources])))
          | resume found.snoc((graph_views/relation 'in slot holder source about myth/new 'solid)) next
        = refs (graph_views/refs record)
          primary (graph_views/primary source folder refs)
          is_primary
            ?> (./some selected) primary (eq refs.len 1)
            | equal[path] selected slot
          label (? is_primary folder slot)
          note (graph_views/qualifiers record slot)
          note (? is_primary note note.put(['within] (pails/p folder)))
        | resume found.snoc((graph_views/relation 'in label holder source about note 'solid)) next
  + relations_one
    \ source=safe next={\ row[graph_views/relation]}view_plan
    ^ view_plan
    | graph_views/frontier source
      \ tree=axal[myth]
      ^ view_plan
      = own (graph_views/own_relations source tree.fil.fall(myth/new))
        children=row[[safe nat]] (tree.kid_tap.map((\ [key child] [(view_ops/at source [key] .x) 2])))
      | graph_views/incoming source
        \ incoming=axal[myth]
        ^ view_plan
        | graph_views/incoming_relations source (incoming.tap.map((\ [name edge] edge))) own
          \ related=row[graph_views/relation]
          ^ view_plan
          | graph_views/branch_relations source children related next
  + relations_for
    \ source=safe next={\ row[safe] row[graph_views/relation]}view_plan
    ^ view_plan
    | graph_views/identity [source] (axal/new[safe] .none)
      \ members=row[safe]
      ^ view_plan
      % i=nat 0 found=row[graph_views/relation] []
      ^ view_plan
      ? (eq i members.len) (next members found)
      = resume (_ i.inc)
      | graph_views/relations_one members.at(i)
        \ related=row[graph_views/relation]
        ^ view_plan
        = retained
            | related.filter
              \ edge
              ? ((equal[path] edge.label ['same]) || ((equal[path] edge.label ['different]) || (equal[path] edge.label ['why]))) .false
              | !(members.any((\ member (equal[path] (view_walk/name member) (view_walk/name edge.other)))))
        | resume found.weld(retained)
  + edge_name
    \ edge=graph_views/relation
    ^ path
    = other (view_walk/name edge.other)
      prefix=path [edge.direction ($u edge.label.len)]
    | prefix.weld(edge.label).snoc(($u other.len)).weld(other)
  + relations
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    | graph_views/canonical_view graph_views/relations_at context cr relative select
  + relations_at
    \ context=myth cr=care relative=path select=view_select
    ^ view_plan
    ?> (./some source) (view_ops/input context) (./fail "missing input")
    | graph_views/relations_for source
      \ members=row[safe] edges=row[graph_views/relation]
      ^ view_plan
      = root (myth/sing ['subject] source).put(['identities] (view_origins members))
      % i=nat 0 output=axal[myth] (axal/new[myth] (./some root))
      ^ view_plan
      ? (eq i edges.len) (graph_views/result output cr relative select)
      = edge edges.at(i)
        name (graph_views/edge_name edge)
        resume (_ i.inc)
      | ./need (view_read (view_ops/at edge.other [] .x) (view_select/slots [['name]]))
        \ named=res[axal[myth]]
        ^ view_plan
        = title=str
            ?> (./known tree) named ""
            | tree.fil.fall(myth/new).txt_at(['name])
          record
            . (myth/sing ['direction] (pails/q edge.direction))
              put(['label] (pails/p edge.label))
              put(['other] edge.other)
              put(['name] (pails/t title))
              put(['via] edge.via)
              put(['about] edge.about)
              put(['strength] (pails/q edge.strength))
          record
            | edge.note.tap.fold record
              \ acc [slot held]
              | acc.put slot.cons('note) held
          previous (output.get(name)).fall(record)
          via (view_walk/name edge.via)
          suffix=path ['assertions ($u via.len)]
          assertion name.weld(suffix).weld(via)
        | resume output.put(name previous).put(assertion record)
