- sept [order=10]
- shrine_types [order=30]
- lain_types [order=38]
- lain_peek [order=39]
- lain_poke [order=40]
- bond [order=60]
- pact [order=70]
' Copyright (c) 2026 Axiomatic Systems. SPDX-License-Identifier: MIT.
' Shared runtime for schema-generated API hands. Source-only; not compiled.
' The schema supplies fetch_for and resp_for. Request subscription, response
' delivery and crew cleanup are independent of every schema and operation.
+ schema_hand
  + seg_txt
    ' One path segment as text: text auras verbatim, the rest as decimal.
    \ i=iota
    ^ str
    ? (is_text i) (^ str (quip_val i))
    (nat/show (^ str (quip_val i)))

  + flat_seg
    ' Flatten the absolute request path so two hands cannot collide at /io.
    \ p=path
    ^ iota
    % i=nat 0 acc=str ""
    ? (eq i p.len) ($ts acc)
    ? (eq i 0) (_ 1 (schema_hand/seg_txt p.at(0)))
    (_ i.inc (#str/cat (#str/cat acc "_") (schema_hand/seg_txt p.at(i))))

  + base_of
    ' The server base url from the root record's ['base].
    \ cur=myth
    ^ str
    ? cur.get(['base])
     > (./some held=pail)
       ? held
        > t=pails/t (^ str t.t)
       ""
    ""

  + qjoin
    ' Skip absent query fragments. Values remain verbatim, not percent encoded.
    \ ps=row[str]
    ^ str
    % i=nat 0 out=str "" some=bool .false
    ? (eq i ps.len) out
    = p ps.at(i)
    ? (eq p 0) (_ i.inc out some)
    ? some (_ i.inc (#str/cat (#str/cat out "&") p) .true)
    (_ i.inc (#str/cat "?" p) .true)

  + auth_of
    ' An absent injected credential is an unauthenticated call.
    \ cur=myth
    ^ str
    ? cur.get(['auth])
     > (./some held=pail)
       ? held
        > t=pails/t (^ str t.t)
       ""
    0

  + crew_of_rec
    \ cur=myth
    ^ crew
    ? cur.get(bond/crew)
     > (./some held=pail)
       ? held
        > c=cpail c.crew
       (mop/empty)
    (mop/empty)

  + http_of
    ' The injected http-client root from the crew slot ['http].
    \ cur=myth
    ^ maybe[path]
    ? (schema_hand/crew_of_rec cur).get(['http])
     > .none .none
     > (./some d=dep) (./some d.p)

  + crew_put
    \ cur=myth slot=path d=dep
    ^ myth
    cur.put(bond/crew (cpail (schema_hand/crew_of_rec cur).put(slot d)))

  + crew_del
    \ cur=myth slot=path
    ^ myth
    = es (schema_hand/crew_of_rec cur).tap
      c2
        % i=nat 0 acc=crew (mop/empty)
        ? (eq i es.len) acc
        = h es.at(i)
        ? (eq_pith h.key slot) (_ i.inc acc)
        (_ i.inc acc.put(h.key h.val))
    cur.put(bond/crew (cpail c2))

  + crew_slot_for
    ' The crew slot whose dep watches path p.
    \ cur=myth p=path
    ^ maybe[path]
    = es (schema_hand/crew_of_rec cur).tap
    % i=nat 0
    ^ maybe[path]
    ? (eq i es.len) .none
    = h es.at(i)
    ? (eq_pith h.val.p p) (./some h.key)
    (_ i.inc)

  + take
    ' Issue each unfinished request through the injected HTTP client.
    \ fetch_for={\ str str pail}row[myth] b=bowl cur=myth gift=axal[mode]
    ^ yell
    = entries gift.tap
    % i=nat 0 cards=row[[p=path q=writ]] [] out=myth cur
    ^ yell
    ? (eq i entries.len) (yell cards out)
    = ent entries.at(i)
      next i.inc
    = [gp=path gm=mode] ent
    ? gm
     > d0=mode/del (_ next cards out)
    ? b.kids.get(gp)
     > .none (_ next cards out)
     > (./some t=myth)
       ? t.get(bond/res)
        > (./some done=pail) (_ next cards out)
        > .none
          ? t.get(bond/req)
           > .none (_ next cards out)
           > (./some held=pail)
             = fr (fetch_for (schema_hand/base_of cur) (schema_hand/auth_of cur) held)
             ? (eq 0 fr.len) (_ next cards out)
             ? (schema_hand/http_of out)
              > .none (_ next cards out)
              > (./some hp=path)
                = dst hp.snoc((schema_hand/flat_seg b.here.weld(gp)))
                (_ next cards.snoc([dst (writ/make fr.at(0))])
                  (schema_hand/crew_put out gp (dep (care/x) dst)))

  + pd_of
    ' Any nominal record as a pail, unchanged.
    \ v=pail
    ^ pail
    v

  + res_body_nat
    \ fm=myth slot=path
    ^ nat
    ? fm.get(slot)
     > (./some bp=pail)
       ? bp
        > n=pails/n n.n
       0
    0

  + hear
    ' Parse completed fetches per originating operation, answer, unsubscribe.
    \ resp_for={\ pail nat str str}row[pail] b=bowl cur=myth changed=row[dep]
    ^ yell
    % i=nat 0 cards=row[[p=path q=writ]] [] out=myth cur
    ^ yell
    ? (eq i changed.len) (yell cards out)
    = d changed.at(i)
      next i.inc
    ? (schema_hand/crew_slot_for out d.p)
     > .none (_ next cards out)
     > (./some k=path)
       ? b.crew.get(k)
        > .none (_ next cards out)
        > (./some ax)
          ? ax.fil
           > .none (_ next cards out)
           > (./some fm=myth)
             ? fm.get(['res_done])
              > .none (_ next cards out)
              > (./some dn=pail)
                = okf (schema_hand/res_body_nat fm ['res_ok])
                  body (^ str (schema_hand/res_body_nat fm ['res_body]))
                ? b.kids.get(k)
                 > .none (_ next cards out)
                 > (./some t=myth)
                   ? t.get(bond/req)
                    > .none (_ next cards out)
                    > (./some held=pail)
                      = ecode (#str/cat "fetch-err-" (nat/show (schema_hand/res_body_nat fm ['res_err])))
                        resp (resp_for held okf body ecode)
                      ? (eq 0 resp.len) (_ next cards out)
                      (_ next
                        cards.snoc([b.here.weld(k)
                          (writ/poke (myth/sing bond/res resp.at(0)))])
                        (schema_hand/crew_del out k))
