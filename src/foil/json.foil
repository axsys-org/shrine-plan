-  sept
'  json: encode and decode JSON text (RFC 8259-ish).  Values are the
'  /json sum.  An integral number is /json/num , sign and magnitude,
'  exact; any other number is /json/real , which keeps the SOURCE
'  LEXEME rather than inventing a float.  Both round-trip exactly;
'  neither is arithmetic, and /json/real cannot be ordered.  The
'  lexeme scan is as lax as the integer one always was (it accepts
'  01.5 , and also 1.5.5 and 1e ): malformed literals survive as
'  themselves instead of being rejected.  Strings
'  are UTF-8 cords passed through verbatim; uXXXX escapes decode
'  (surrogate pairs included), but u0000 is rejected (a cord cannot
'  hold NUL).  Decode by /parse , encode by /show ; the
'  round-trip /rt is the doctest surface.
+  jres
  '  A decode outcome: the value with the INDEX just past it, or a
  '  failure naming why, at the index where it stopped.  Both carry
  '  an offset into the original text, never a copy of the tail —
  '  copying the tail per step is what made scanning quadratic.
  &  jres/ok
     jres/err
  +  ok
    :  v=json rest=nat
  +  err
    :  why=str rest=nat
+  json
  '  A JSON value.
  &  json/nul
     json/boo
     json/num
     json/real
     json/str
     json/arr
     json/obj
  +  nul
    '  Null.  Keep the inert field for the existing value representation.
    :  z=nat
  +  boo
    :  b=bool
  +  num
    '  An exact integer: sign and magnitude.
    :  neg=bool n=nat
  +  real
    '  Preserve the source lexeme without rounding through a float.
    '  This is text to round-trip, not an arithmetic value.
    :  lex=str
  +  str
    :  s=str
  +  arr
    :  xs=row[json]
  +  obj
    '  Ordered text keys and values; duplicates ride as written.
    :  kvs=row[jkv]
+  jkv
  '  One object member: key and value.
  :  k=str v=json
+  jnull
  '  The null value.
  ^  json
  (json/nul 0)
+  ws
  '  The first index at or after i that is not JSON whitespace.
  \  s=str i=nat
  ^  nat
  %  j=nat i
  ?  s.eof(j)
     j
  =  c  s.at(j)
  ?  (eq c " ")
     (_ j.inc)
  ?  (eq c 10)
     (_ j.inc)
  ?  (eq c 13)
     (_ j.inc)
  ?  (eq c 9)
     (_ j.inc)
  j
+  hex4
  '  A JSON Unicode escape has exactly four hex digits.
  \ s=str i=nat
  ^ maybe[[cp=nat rest=nat]]
  < cp (hex/read 4 i s)
  | ./some [cp i.add(4)]
+  esc2
  '  Append a two-byte escape: backslash then b.
  \  out=str b=nat
  ^  str
  out.snoc_byte(92).snoc_byte(b)
+  p_str
  '  A string, from its opening quote at i.  Plain bytes are not
  '  copied as they are scanned: run holds the start of the current
  '  unescaped stretch, which is spliced into out only when an escape
  '  or the closing quote ends it.
  \  s=str i=nat
  ^  jres
  =  i0  i.inc
  %  j=nat i0
     run=nat i0
     out=str ""
  ^  jres
  ?  s.eof(j)
     (jres/err "unterminated-string" j)
  =  c  s.at(j)
  ?  (eq c 34)
     (jres/ok (json/str out.cat_slice(s run j)) j.inc)
  ?  (lt c 32)
     (jres/err "control-in-string" j)
  ?  (eq c 92)
     =  e    s.at(j.inc)
     =  j2   (add j 2)
     =  out0 out.cat_slice(s run j)
     ?  (eq e 34)
        (_ j2 j2 out0.snoc_byte(34))
     ?  (eq e 92)
        (_ j2 j2 out0.snoc_byte(92))
     ?  (eq e "/")
        (_ j2 j2 out0.snoc_byte("/"))
     ?  (eq e "b")
        (_ j2 j2 out0.snoc_byte(8))
     ?  (eq e "f")
        (_ j2 j2 out0.snoc_byte(12))
     ?  (eq e "n")
        (_ j2 j2 out0.snoc_byte(10))
     ?  (eq e "r")
        (_ j2 j2 out0.snoc_byte(13))
     ?  (eq e "t")
        (_ j2 j2 out0.snoc_byte(9))
     ?  (eq e "u")
        ^ jres
        > (./some first) (hex4 s j2)
          | jres/err "bad-unicode-escape" j2
        = [cp j3] first
        ? (eq cp 0)
          | jres/err "nul-in-string" j2
        ? ((lt cp 55296) || (gt cp 57343))
          | _ j3 j3 out0.snoc_utf8(cp)
        ? (gt cp 56319)
          | jres/err "lone-low-surrogate" j2

        '  A high surrogate must be followed by a low surrogate escape.
        ? !(eq 92 s.at(j3))
          | jres/err "lone-high-surrogate" j3
        ? !(eq "u" s.at(j3.inc))
          | jres/err "lone-high-surrogate" j3
        > (./some second) (hex4 s j3.add(2))
          | jres/err "bad-unicode-escape" j3
        = [lo j5] second
        ? ((lt lo 56320) || (gt lo 57343))
          | jres/err "bad-surrogate-pair" j3
        = scalar | add 65536 (add (mul (sub cp 55296) 1024) (sub lo 56320))
        | _ j5 j5 out0.snoc_utf8(scalar)
     (jres/err "bad-escape" j)
  (_ j.inc run out)
+  exp_sign
  '  A + or - is part of the number only directly after e or E; a
  '  sign anywhere else ends the literal.
  \  prev=nat c=nat
  ^  bool
  ?  (eq prev "e")
     ?  (eq c "+")
        .true
     ?  (eq c "-")
        .true
     .false
  ?  (eq prev "E")
     ?  (eq c "+")
        .true
     ?  (eq c "-")
        .true
     .false
  .false
+  p_num
  '  A number from i.  The real lexeme is a verbatim source slice
  '  taken once at the end, so nothing is accumulated per byte.
  \  s=str i=nat
  ^  jres
  =  neg
       ?  (eq "-" s.at(i))
          .true
       .false
  =  i1
       ?  neg
          i.inc
       i
  ?  (digit_byte s.at(i1))
     %  j=nat i1
        n=nat 0
        real=bool .false
        prev=nat 0
     ^  jres
     =  c  s.at(j)
     ?  (digit_byte c)
        (_ j.inc (add (mul n 10) (sub c "0")) real c)
     ?  (eq c ".")
        (_ j.inc n .true c)
     ?  (eq c "e")
        (_ j.inc n .true c)
     ?  (eq c "E")
        (_ j.inc n .true c)
     ?  (exp_sign prev c)
        (_ j.inc n real c)
     ?  real
        (jres/ok (json/real s.slice(i (sub j i))) j)
     (jres/ok (json/num neg n) j)
  (jres/err "bad-number" i)
+  p_arr
  '  Array elements, from just past the opening bracket.  Gather on a
  '  list so each element costs one cons; materialize the row once.
  \ s=str i=nat
  ^ jres
  = start | ws s i
  ? (eq 93 s.at(start))
    | ./ok (json/arr []) start.inc
  % j=nat start
    xs=list[json] .nil
  ^ jres
  = result | p_val s j
  > (./ok value rest) result
    result
  = next | ws s rest
    byte s.at(next)
    items | list/cons value xs
  ? (eq byte 44)
    | _ (ws s next.inc) items
  ? (eq byte 93)
    | ./ok (json/arr items.row.rev) next.inc
  | ./err "expected-comma-or-bracket" next
+  p_obj
  '  Object members follow the same list discipline.  Preserve order
  '  and duplicate keys; only JSON's punctuation is checked here.
  \ s=str i=nat
  ^ jres
  = start | ws s i
  ? (eq 125 s.at(start))
    | ./ok (json/obj []) start.inc
  % j=nat start
    kvs=list[jkv] .nil
  ^ jres
  ? !(eq 34 s.at(j))
    | ./err "expected-key" j
  = key_result | p_str s j
  > (./ok key rest) key_result
    key_result
  > text=json/str key
    | ./err "expected-key" j
  = colon | ws s rest
  ? !(eq 58 s.at(colon))
    | ./err "expected-colon" colon
  = value_result | p_val s (ws s colon.inc)
  > (./ok value after) value_result
    value_result
  = next | ws s after
    byte s.at(next)
    members | list/cons (jkv text.s value) kvs
  ? (eq byte 44)
    | _ (ws s next.inc) members
  ? (eq byte 125)
    | ./ok (json/obj members.row.rev) next.inc
  | ./err "expected-comma-or-brace" next
+  p_val
  '  One value at i.  Leading whitespace is the CALLER's job.
  \  s=str i=nat
  ^  jres
  =  c  s.at(i)
  ?  (eq c "{")
     (p_obj s i.inc)
  ?  (eq c "[")
     (p_arr s i.inc)
  ?  (eq c 34)
     (p_str s i)
  ?  (eq c "t")
     ?  (str/prefix_at "true" i s)
      > (./some r1)  (jres/ok (json/boo .true) r1)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "f")
     ?  (str/prefix_at "false" i s)
      > (./some r2)  (jres/ok (json/boo .false) r2)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "n")
     ?  (str/prefix_at "null" i s)
      > (./some r3)  (jres/ok jnull r3)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "-")
     (p_num s i)
  ?  (digit_byte c)
     (p_num s i)
  (jres/err "unexpected-byte" i)
+  parse
  '  Decode one complete document: surrounding whitespace allowed,
  '  trailing garbage is an error.  A jres carries the INDEX it
  '  stopped at, not the unconsumed tail.
  \  s=str
  ^  jres
  ?  (p_val s (ws s 0))
   > (./err why rest)  (jres/err why rest)
   > (./ok v rest)
     ?  (str/eof (ws s rest) s)
        (jres/ok v 0)
     (jres/err "trailing-garbage" rest)
+  show_str
  '  Quote a string, copying unescaped runs only when they end.
  '  The ordinary-byte path neither slices nor rebuilds the output.
  \ s=str
  ^ str
  = body
      % j=nat 0
        run=nat 0
        out=str ""
      ^ str
      ? s.eof(j)
        out.cat_slice(s run j)
      = byte s.at(j)
      ? !((eq byte 34) || (eq byte 92) || (lt byte 32))
        | _ j.inc run out
      = prefix out.cat_slice(s run j)
        escaped
          ? (eq byte 34) (esc2 prefix 34)
          ? (eq byte 92) (esc2 prefix 92)
          ? (eq byte 10) (esc2 prefix "n")
          ? (eq byte 9)  (esc2 prefix "t")
          ? (eq byte 13) (esc2 prefix "r")
          (esc2 prefix "u").cat("00").cat((hex/byte byte))
      | _ j.inc j.inc escaped
    quote | str/snoc_byte 34 ""
  quote.cat(body).cat(quote)
+  show
  '  Encode compactly.  Containers render their members independently;
  '  the stdlib joins their text without a growing string accumulator.
  \ v=json
  ^ str
  = me (_)
  ? v
   > b=json/boo
     ? b.b "true"
     "false"
   > x=json/num
     = digits x.n.show
     ? x.neg
       | str/cat digits "-"
     digits
   > y=json/real y.lex
   > t=json/str (show_str t.s)
   > a=json/arr
     = body | str/join "," a.xs.map(me)
     | str/cat_all ["[" body "]"]
   > o=json/obj
     = parts
         | o.kvs.map
         \ e
         | str/cat_all [(show_str e.k) ":" (me e.v)]
       body | str/join "," parts
     | str/cat_all ["{" body "}"]
   "null"
+  rt
  '  Decode then re-encode: the canonical spelling, or the failure's
  '  why.  The doctest surface.
  '  ?=  ((rt "[1, 2, 3]") "[1,2,3]")
  '  ?=  ((rt " null ") "null")
  '  ?=  ((rt "[true, false, [-5], []]") "[true,false,[-5],[]]")
  '  ?=  ((rt "12") "12")
  '  ?=  ((rt "1.5") "1.5")
  '  ?=  ((rt "-0.125") "-0.125")
  '  ?=  ((rt "6.02e23") "6.02e23")
  '  ?=  ((rt "1e-5") "1e-5")
  '  ?=  ((rt "[1.5, 2, -3.25]") "[1.5,2,-3.25]")
  '  ?=  ((rt "[1") "expected-comma-or-bracket")
  \  s=str
  ^  str
  ?  (parse s)
   > (./ok v rest)  (show v)
   > (./err why rest)  why
