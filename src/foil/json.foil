-  sept
'  json: encode and decode JSON text (RFC 8259-ish).  Values are the
'  /json sum.  An integral number is /json/num , sign and magnitude,
'  exact; any other number is /json/real , which keeps the SOURCE
'  LEXEME rather than inventing a float.  Both round-trip exactly;
'  neither is arithmetic, and /json/real cannot be ordered.  The
'  lexeme scan is as lax as the integer one always was (it accepts
'  01.5 , and also 1.5.5 and 1e ): malformed literals survive as
'  themselves instead of being rejected.  Strings
'  are UTF-8 cords passed through verbatim; uXXXX escapes decode
'  (surrogate pairs included), but u0000 is rejected (a cord cannot
'  hold NUL).  Decode by /parse , encode by /show ; the
'  round-trip /rt is the doctest surface.
+  jres
  '  A decode outcome: the value with the INDEX just past it, or a
  '  failure naming why, at the index where it stopped.  Both carry
  '  an offset into the original text, never a copy of the tail —
  '  copying the tail per step is what made scanning quadratic.
  &  jres/ok
     jres/err
  +  ok
    :  v=json rest=nat
  +  err
    :  why=nat rest=nat
+  json
  '  A JSON value.
  &  json/nul
     json/boo
     json/num
     json/real
     json/str
     json/arr
     json/obj
  +  nul
    '  Null.  The field is inert (a nullary member cannot be
    '  constructed by relvar from its own module — give it a body).
    :  z=nat
  +  boo
    :  b=bool
  +  num
    '  An exact integer: sign and magnitude.
    :  neg=bool n=nat
  +  real
    '  A non-integral number, kept as its SOURCE LEXEME.  There is no
    '  honest float value here yet, and a client does not need one: it
    '  must round-trip what it receives and transmit what it is given,
    '  and the lexeme does both exactly.  Arithmetic is what you give
    '  up, and arithmetic is what an API client does not do.
    :  lex=nat
  +  str
    :  s=nat
  +  arr
    :  xs=row[json]
  +  obj
    '  Ordered key/value pairs; keys are cords.  Duplicates ride as
    '  written.
    :  kvs=row[jkv]
+  jkv
  '  One object member: key and value.
  :  k=nat v=json
+  jnull
  '  The null value.
  ^  json
  (json/nul 0)
+  cat2
  \  a=nat b=nat
  ^  nat
  (add a (lsh b (mul 8 (wid a))))
+  snoc8
  '  Append one byte.
  \  s=nat b=nat
  ^  nat
  (add s (lsh b (mul 8 (wid s))))
+  show_nat
  \  n=nat
  ^  nat
  ?  (eq n 0)
     "0"
  |  > rest=nat n  > out=nat 0
  ?  (eq rest 0)
     out
  (_ (div rest 10) (cat2 (add "0" (mod rest 10)) out))
+  ws
  '  The first index at or after i that is not JSON whitespace.
  \  s=nat i=nat
  ^  nat
  |  > j=nat i
  ?  (cord/eof s j)
     j
  =  c  (cord/at s j)
  ?  (eq c " ")
     (_ j.inc)
  ?  (eq c 10)
     (_ j.inc)
  ?  (eq c 13)
     (_ j.inc)
  ?  (eq c 9)
     (_ j.inc)
  j
+  lit
  '  Expect an exact prefix at i: the index just after it, or .none.
  \  pre=nat s=nat i=nat
  ^  maybe[nat]
  =  w  (wid pre)
  ?  (eq pre (cord/slice s i w))
     (./some (add i w))
  .none
+  run_cat
  '  Append the pending verbatim run [run,j) of s to out.  String
  '  bodies are copied a RUN at a time, not a byte at a time: an
  '  append rebuilds the accumulator, so per-byte appends make a
  '  string quadratic in its own length.
  \  s=nat out=nat run=nat j=nat
  ^  nat
  ?  (ge run j)
     out
  (cord/cat out (cord/slice s run (sub j run)))
+  digit
  \  c=nat
  ^  bool
  ?  (lt c "0")
     .false
  ?  (gt c "9")
     .false
  .true
+  hexv
  '  A hex digit's value, or 16 for a non-digit.
  \  c=nat
  ^  nat
  ?  (digit c)
     (sub c "0")
  ?  (lt c "A")
     16
  ?  (gt c "f")
     16
  ?  (gt c "F")
     ?  (lt c "a")
        16
     (sub c 87)
  (sub c 55)
+  hexd
  \  v=nat
  ^  nat
  ?  (lt v 10)
     (add "0" v)
  (add 87 v)
+  hex2
  '  A byte as two lowercase hex digits.
  \  b=nat
  ^  nat
  (cat2 (hexd (div b 16)) (hexd (mod b 16)))
+  utf8
  '  Append one codepoint, UTF-8 encoded.
  \  out=nat cp=nat
  ^  nat
  ?  (lt cp 128)
     (snoc8 out cp)
  ?  (lt cp 2048)
     (snoc8 (snoc8 out (add 192 (div cp 64))) (add 128 (mod cp 64)))
  ?  (lt cp 65536)
     (snoc8 (snoc8 (snoc8 out (add 224 (div cp 4096)))
       (add 128 (mod (div cp 64) 64))) (add 128 (mod cp 64)))
  (snoc8 (snoc8 (snoc8 (snoc8 out (add 240 (div cp 262144)))
    (add 128 (mod (div cp 4096) 64))) (add 128 (mod (div cp 64) 64)))
    (add 128 (mod cp 64)))
+  hex4
  '  Four hex digits from i: the codepoint and the index after, or
  '  .none.
  \  s=nat i=nat
  ^  maybe[[cp=nat rest=nat]]
  |  > k=nat 0  > j=nat i  > acc=nat 0
  ^  maybe[[cp=nat rest=nat]]
  ?  (eq k 4)
     (./some [acc j])
  ?  (cord/eof s j)
     .none
  =  v  (hexv (cord/at s j))
  ?  (eq v 16)
     .none
  (_ k.inc j.inc (add (mul acc 16) v))
+  esc2
  '  Append a two-byte escape: backslash then b.
  \  out=nat b=nat
  ^  nat
  (snoc8 (snoc8 out 92) b)
+  p_str
  '  A string, from its opening quote at i.  Plain bytes are not
  '  copied as they are scanned: run holds the start of the current
  '  unescaped stretch, which is spliced into out only when an escape
  '  or the closing quote ends it.
  \  s=nat i=nat
  ^  jres
  =  i0  i.inc
  |  > j=nat i0  > run=nat i0  > out=nat 0
  ^  jres
  ?  (cord/eof s j)
     (jres/err "unterminated-string" j)
  =  c  (cord/at s j)
  ?  (eq c 34)
     (jres/ok (json/str (run_cat s out run j)) j.inc)
  ?  (lt c 32)
     (jres/err "control-in-string" j)
  ?  (eq c 92)
     =  e    (cord/at s j.inc)
     =  j2   (add j 2)
     =  out0 (run_cat s out run j)
     ?  (eq e 34)
        (_ j2 j2 (snoc8 out0 34))
     ?  (eq e 92)
        (_ j2 j2 (snoc8 out0 92))
     ?  (eq e "/")
        (_ j2 j2 (snoc8 out0 "/"))
     ?  (eq e "b")
        (_ j2 j2 (snoc8 out0 8))
     ?  (eq e "f")
        (_ j2 j2 (snoc8 out0 12))
     ?  (eq e "n")
        (_ j2 j2 (snoc8 out0 10))
     ?  (eq e "r")
        (_ j2 j2 (snoc8 out0 13))
     ?  (eq e "t")
        (_ j2 j2 (snoc8 out0 9))
     ?  (eq e "u")
        ?  (hex4 s j2)
         > .none  (jres/err "bad-unicode-escape" j2)
         > (./some h1)
           =  [cp=nat j3=nat]  h1
           ?  (eq cp 0)
              (jres/err "nul-in-string" j2)
           ?  (lt cp 55296)
              (_ j3 j3 (utf8 out0 cp))
           ?  (gt cp 57343)
              (_ j3 j3 (utf8 out0 cp))
           ?  (gt cp 56319)
              (jres/err "lone-low-surrogate" j2)
           ?  (eq 92 (cord/at s j3))
              ?  (eq "u" (cord/at s j3.inc))
                 ?  (hex4 s (add j3 2))
                  > .none  (jres/err "bad-unicode-escape" j3)
                  > (./some h2)
                    =  [lo=nat j5=nat]  h2
                    ?  (lt lo 56320)
                       (jres/err "bad-surrogate-pair" j3)
                    ?  (gt lo 57343)
                       (jres/err "bad-surrogate-pair" j3)
                    (_ j5 j5 (utf8 out0
                      (add 65536 (add (mul (sub cp 55296) 1024) (sub lo 56320)))))
              (jres/err "lone-high-surrogate" j3)
           (jres/err "lone-high-surrogate" j3)
     (jres/err "bad-escape" j)
  (_ j.inc run out)
+  exp_sign
  '  A + or - is part of the number only directly after e or E; a
  '  sign anywhere else ends the literal.
  \  prev=nat c=nat
  ^  bool
  ?  (eq prev "e")
     ?  (eq c "+")
        .true
     ?  (eq c "-")
        .true
     .false
  ?  (eq prev "E")
     ?  (eq c "+")
        .true
     ?  (eq c "-")
        .true
     .false
  .false
+  p_num
  '  A number from i.  The real lexeme is a verbatim source slice
  '  taken once at the end, so nothing is accumulated per byte.
  \  s=nat i=nat
  ^  jres
  =  neg
       ?  (eq "-" (cord/at s i))
          .true
       .false
  =  i1
       ?  neg
          i.inc
       i
  ?  (digit (cord/at s i1))
     |  > j=nat i1  > n=nat 0  > real=bool .false  > prev=nat 0
     ^  jres
     =  c  (cord/at s j)
     ?  (digit c)
        (_ j.inc (add (mul n 10) (sub c "0")) real c)
     ?  (eq c ".")
        (_ j.inc n .true c)
     ?  (eq c "e")
        (_ j.inc n .true c)
     ?  (eq c "E")
        (_ j.inc n .true c)
     ?  (exp_sign prev c)
        (_ j.inc n real c)
     ?  real
        (jres/ok (json/real (cord/slice s i (sub j i))) j)
     (jres/ok (json/num neg n) j)
  (jres/err "bad-number" i)
+  p_arr
  '  Array elements, from just past the opening bracket at i.
  \  s=nat i=nat
  ^  jres
  =  i0  (ws s i)
  ?  (eq "]" (cord/at s i0))
     (jres/ok (json/arr []) i0.inc)
  |  > j=nat i0  > xs=list[json] nil[json]
  ^  jres
  ?  (p_val s j)
   > (./err why=nat rest=nat)  (jres/err why rest)
   > (./ok v=json rest=nat)
     =  j1  (ws s rest)
     =  c   (cord/at s j1)
     ?  (eq c ",")
        (_ (ws s j1.inc) (cons v xs))
     ?  (eq c "]")
        (jres/ok (json/arr (list_row (cons v xs)).rev) j1.inc)
     (jres/err "expected-comma-or-bracket" j1)
+  p_obj
  '  Object members, from just past the opening brace at i.
  \  s=nat i=nat
  ^  jres
  =  i0  (ws s i)
  ?  (eq "}" (cord/at s i0))
     (jres/ok (json/obj []) i0.inc)
  |  > j=nat i0  > kvs=list[jkv] nil[jkv]
  ^  jres
  ?  (eq 34 (cord/at s j))
     ?  (p_str s j)
      > (./err why=nat rest=nat)  (jres/err why rest)
      > (./ok kv=json rest=nat)
        =  key
             ?  kv
              > kt=json/str  kt.s
             0
        =  j1  (ws s rest)
        ?  (eq ":" (cord/at s j1))
           ?  (p_val s (ws s j1.inc))
            > (./err why2=nat rest2=nat)  (jres/err why2 rest2)
            > (./ok v=json rest2=nat)
              =  j2  (ws s rest2)
              =  c   (cord/at s j2)
              ?  (eq c ",")
                 (_ (ws s j2.inc) (cons (jkv key v) kvs))
              ?  (eq c "}")
                 (jres/ok
                   (json/obj (list_row (cons (jkv key v) kvs)).rev) j2.inc)
              (jres/err "expected-comma-or-brace" j2)
        (jres/err "expected-colon" j1)
  (jres/err "expected-key" j)
+  p_val
  '  One value at i.  Leading whitespace is the CALLER's job.
  \  s=nat i=nat
  ^  jres
  =  c  (cord/at s i)
  ?  (eq c "{")
     (p_obj s i.inc)
  ?  (eq c "[")
     (p_arr s i.inc)
  ?  (eq c 34)
     (p_str s i)
  ?  (eq c "t")
     ?  (lit "true" s i)
      > (./some r1)  (jres/ok (json/boo .true) r1)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "f")
     ?  (lit "false" s i)
      > (./some r2)  (jres/ok (json/boo .false) r2)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "n")
     ?  (lit "null" s i)
      > (./some r3)  (jres/ok jnull r3)
      > .none  (jres/err "bad-literal" i)
  ?  (eq c "-")
     (p_num s i)
  ?  (digit c)
     (p_num s i)
  (jres/err "unexpected-byte" i)
+  parse
  '  Decode one complete document: surrounding whitespace allowed,
  '  trailing garbage is an error.  A jres carries the INDEX it
  '  stopped at, not the unconsumed tail.
  \  s=nat
  ^  jres
  ?  (p_val s (ws s 0))
   > (./err why=nat rest=nat)  (jres/err why rest)
   > (./ok v=json rest=nat)
     ?  (cord/eof s (ws s rest))
        (jres/ok v 0)
     (jres/err "trailing-garbage" rest)
+  show_str
  '  A quoted, escaped string.  Scans by index and copies unescaped
  '  stretches a RUN at a time, the mirror of /p_str .
  \  s=nat
  ^  nat
  =  body
       |  > j=nat 0  > run=nat 0  > out=nat 0
       ?  (cord/eof s j)
          (run_cat s out run j)
       =  c     (cord/at s j)
       =  out0  (run_cat s out run j)
       ?  (eq c 34)
          (_ j.inc j.inc (esc2 out0 34))
       ?  (eq c 92)
          (_ j.inc j.inc (esc2 out0 92))
       ?  (lt c 32)
          ?  (eq c 10)
             (_ j.inc j.inc (esc2 out0 "n"))
          ?  (eq c 9)
             (_ j.inc j.inc (esc2 out0 "t"))
          ?  (eq c 13)
             (_ j.inc j.inc (esc2 out0 "r"))
          (_ j.inc j.inc
             (cord/cat (cord/cat (esc2 out0 "u") "00") (hex2 c)))
       (_ j.inc run out)
  (snoc8 (cat2 34 body) 34)
+  show
  '  Encode compactly.
  \  v=json
  ^  nat
  ?  v
   > b=json/boo
     ?  b.b
        "true"
     "false"
   > x=json/num
     ?  x.neg
        (cat2 "-" (show_nat x.n))
     (show_nat x.n)
   > y=json/real  y.lex
   > t=json/str  (show_str t.s)
   > a=json/arr
     '  Pieces are gathered on a list and merged once.  Appending each
     '  to a growing cord rebuilds it every step, and so does snoc-ing
     '  onto a growing row: either way a container costs the square of
     '  its own length.  cons is O(1) and the merge is one pass.
     =  parts
          |  > i=nat 0  > out=list[nat] (cons "[" nil[nat])
          ?  (eq i a.xs.len)
             out
          =  piece  (show a.xs.at(i))
          ?  (eq i 0)
             (_ i.inc (cons piece out))
          (_ i.inc (cons piece (cons "," out)))
     (cord/cat_all (list_row (cons "]" parts)).rev)
   > o=json/obj
     =  parts
          |  > i=nat 0  > out=list[nat] (cons "{" nil[nat])
          ?  (eq i o.kvs.len)
             out
          =  e      o.kvs.at(i)
          =  piece  (cord/cat_all [(show_str e.k) ":" (show e.v)])
          ?  (eq i 0)
             (_ i.inc (cons piece out))
          (_ i.inc (cons piece (cons "," out)))
     (cord/cat_all (list_row (cons "}" parts)).rev)
   "null"
+  rt
  '  Decode then re-encode: the canonical spelling, or the failure's
  '  why.  The doctest surface.
  '  ?=  ((rt "[1, 2, 3]") "[1,2,3]")
  '  ?=  ((rt " null ") "null")
  '  ?=  ((rt "[true, false, [-5], []]") "[true,false,[-5],[]]")
  '  ?=  ((rt "12") "12")
  '  ?=  ((rt "1.5") "1.5")
  '  ?=  ((rt "-0.125") "-0.125")
  '  ?=  ((rt "6.02e23") "6.02e23")
  '  ?=  ((rt "1e-5") "1e-5")
  '  ?=  ((rt "[1.5, 2, -3.25]") "[1.5,2,-3.25]")
  '  ?=  ((rt "[1") "expected-comma-or-bracket")
  \  s=nat
  ^  nat
  ?  (parse s)
   > (./ok v=json rest=nat)  (show v)
   > (./err why=nat rest=nat)  why
