- ethereum_keccak
- json

+ ethereum_transaction
  : chain=nat nonce=nat priority=nat fee=nat gas=nat to=str data=str
  + quantity
    \ n=nat
    ^ str
    ? (eq n 0) "0x0"
    = digits=str "0123456789abcdef"
      encoded
        % rest=nat n out=str ""
        ? (eq rest 0) out
        = digit | str/from_atom digits.at((mod rest 16))
        | _ (div rest 16) (str/cat_all [digit out])
    | str/cat_all ["0x" encoded]
  + fields
    \ tx=ethereum_transaction
    ^ row[row[nat]]
    [(ethereum_bytes/rlp_nat tx.chain) (ethereum_bytes/rlp_nat tx.nonce)
     (ethereum_bytes/rlp_nat tx.priority) (ethereum_bytes/rlp_nat tx.fee)
     (ethereum_bytes/rlp_nat tx.gas) (ethereum_bytes/rlp_bytes (ethereum_bytes/unhex tx.to))
     (ethereum_bytes/rlp_nat 0) (ethereum_bytes/rlp_bytes (ethereum_bytes/unhex tx.data))
     (ethereum_bytes/rlp_list [])]
  + digest
    \ tx=ethereum_transaction
    ^ str
    | ethereum_keccak/hex (ethereum_bytes/rlp_list (ethereum_transaction/fields tx)).cons(2)
  + signed
    \ tx=ethereum_transaction parity=nat r=nat s=nat
    ^ str
    = order=nat 115792089237316195423570985008687907852837564279074904382605163141518161494337
    ? ((gt parity 1) || (eq r 0) || (ge r order) || (eq s 0) || (gt s (div order 2)))
      | ethereum_bytes/fail_text "invalid secp256k1 signature scalars"
    = fields (ethereum_transaction/fields tx).snoc((ethereum_bytes/rlp_nat parity)).snoc((ethereum_bytes/rlp_nat r)).snoc((ethereum_bytes/rlp_nat s))
    | ethereum_bytes/hex (ethereum_bytes/rlp_list fields).cons(2)
  + rpc
    \ address=str tx=ethereum_transaction
    ^ json
    = fields=row[jkv]
        [(jkv "from" (json/str address)) (jkv "type" (json/str "0x2"))
         (jkv "chainId" (json/str (ethereum_transaction/quantity tx.chain)))
         (jkv "maxPriorityFeePerGas" (json/str (ethereum_transaction/quantity tx.priority)))
         (jkv "maxFeePerGas" (json/str (ethereum_transaction/quantity tx.fee)))
         (jkv "value" (json/str "0x0")) (jkv "data" (json/str tx.data))]
    | json/obj (? (equal tx.to "0x") fields fields.snoc((jkv "to" (json/str tx.to))))
