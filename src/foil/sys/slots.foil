- sys/types

' Generated from slots/system.slots.json by x/slot_catalog.py; edit the catalog.
+ about
  ' About
  ' Subject described by this record.
  ^ path
  '/sys/about
+ author
  ' Author
  ' Asserted author; unsigned scaffolding, not authentication.
  ^ path
  '/sys/author
+ called_by
  ' Called by
  ' Incoming definition references.
  ^ path
  '/sys/called_by
+ calls
  ' Calls
  ' Outgoing definition references.
  ^ path
  '/sys/calls
+ codex
  + command
    ' Codex command
    ' Command submitted to the Codex bridge.
    ^ path
    '/sys/codex/command
  + done
    ' Codex done
    ' Command completion flag.
    ^ path
    '/sys/codex/done
  + kind
    ' Codex kind
    ' Request or response kind.
    ^ path
    '/sys/codex/kind
  + method
    ' Codex method
    ' Protocol method name.
    ^ path
    '/sys/codex/method
  + ok
    ' Codex ok
    ' Request success flag.
    ^ path
    '/sys/codex/ok
  + payload
    ' Codex payload
    ' Request payload.
    ^ path
    '/sys/codex/payload
  + port
    ' Codex port
    ' Bridge listening port.
    ^ path
    '/sys/codex/port
  + reply_error
    ' Codex reply error
    ' Protocol error reply.
    ^ path
    '/sys/codex/reply_error
  + reply_result
    ' Codex reply result
    ' Protocol result reply.
    ^ path
    '/sys/codex/reply_result
  + request_id
    ' Codex request ID
    ' Protocol request identifier.
    ^ path
    '/sys/codex/request_id
  + resolved
    ' Codex resolved
    ' Resolved reference results.
    ^ path
    '/sys/codex/resolved
  + result
    ' Codex result
    ' Command result.
    ^ path
    '/sys/codex/result
  + sequence
    ' Codex sequence
    ' Command sequence number.
    ^ path
    '/sys/codex/sequence
  + token
    ' Codex token
    ' Bridge authentication token.
    ^ path
    '/sys/codex/token
  + ui_error
    ' Codex UI error
    ' UI error text.
    ^ path
    '/sys/codex/ui_error
  + ui_notice
    ' Codex UI notice
    ' UI notice text.
    ^ path
    '/sys/codex/ui_notice
  + ui_serial
    ' Codex UI serial
    ' UI update serial.
    ^ path
    '/sys/codex/ui_serial
  + unresolved
    ' Codex unresolved
    ' References that could not be resolved.
    ^ path
    '/sys/codex/unresolved
+ content
  ' Content
  ' Primary value at a name.
  ^ path
  '/sys/content
+ crew
  ' Dependencies
  ' Committed local dependency bindings to cared paths.
  ^ path
  '/sys/crew
+ dt
  ' Doctest results
  ' Doctest case, execution time and results.
  ^ path
  '/sys/dt
+ entries
  ' Definitions
  ' Definitions exposed by a compiler module mirror.
  ^ path
  '/sys/entries
+ epoch
  ' Epoch
  ' Counter triggering actions or synchronization.
  ^ path
  '/sys/epoch
+ face
  ' Presentation binding
  ' Component constructor and cared scope used to present a datum.
  ^ path
  '/sys/face
+ form
  ' Behavior
  ' Behavior implementation called through the limb chain.
  ^ path
  '/sys/form
+ from
  ' Source
  ' Source from which this record is derived.
  ^ path
  '/sys/from
+ fs
  + extensions
    ' File extensions
    ' File extension to behavior references for scanned files.
    ^ path
    '/sys/fs/extensions
  + source
    + assets
      ' Source assets
      ' Captured asset bytes for a source mount.
      ^ path
      '/sys/fs/source/assets
    + diagnostic
      ' Source diagnostic
      ' Typed publication failure, cleared with empty text on success.
      ^ path
      '/sys/fs/source/diagnostic
    + diagnostic_text
      ' Source diagnostic text
      ' Display text for a source publication failure.
      ^ path
      '/sys/fs/source/diagnostic_text
    + epoch
      ' Scan epoch
      ' Most recently processed scan epoch.
      ^ path
      '/sys/fs/source/epoch
    + image
      ' Module images
      ' Compiled module images retained for imports.
      ^ path
      '/sys/fs/source/image
    + manifest
      ' Mount manifest
      ' JSON mount descriptor.
      ^ path
      '/sys/fs/source/manifest
    + message
      ' Publication message
      ' Current source publication status message.
      ^ path
      '/sys/fs/source/message
    + publication
      ' Publication epoch
      ' Namespace epoch of the last successful publication.
      ^ path
      '/sys/fs/source/publication
    + ready
      ' Publication readiness
      ' Whether the last source publication succeeded.
      ^ path
      '/sys/fs/source/ready
    + snapshot
      ' Source snapshot
      ' Pinned file snapshot and fingerprint used as compiler input.
      ^ path
      '/sys/fs/source/snapshot
    + spec
      ' Source mount specification
      ' Source mount name and manifest.
      ^ path
      '/sys/fs/source/spec
    + status
      ' Source status
      ' Typed scan epoch, readiness, message and publication epoch.
      ^ path
      '/sys/fs/source/status
  + target
    ' Scan destination
    ' Nested crew key binding the scan destination.
    ^ path
    '/sys/fs/target
+ goo
  + catalog
    ' Goo catalog
    ' Available renderer and view catalog.
    ^ path
    '/sys/goo/catalog
  + constants
    ' View constants
    ' Constants captured while lowering a Grove view.
    ^ path
    '/sys/goo/constants
  + documentation_origin
    ' Source inspection provenance
    ' Provenance notice for artifact-derived source inspection.
    ^ path
    '/sys/goo/documentation_origin
  + inspection
    + capture
      ' Observed capture
      ' Capture identity, parent and provenance notice. Browser observation, not authoritative live state.
      ^ path
      '/sys/goo/inspection/capture
    + encounter
      ' Observed encounter
      ' Observed browser session, revisions, selection and editing state. Browser observation, not authoritative live state.
      ^ path
      '/sys/goo/inspection/encounter
    + preparation
      ' Observed preparation
      ' Observed layout, dimensions, scale, direction and profile. Browser observation, not authoritative live state.
      ^ path
      '/sys/goo/inspection/preparation
    + recipe
      ' Observed recipe
      ' Observed view, role, slot, publication and source location. Browser observation, not authoritative live state.
      ^ path
      '/sys/goo/inspection/recipe
    + subject
      ' Observed subject
      ' Observed subject, receiver and displayed/expected versions. Browser observation, not authoritative live state.
      ^ path
      '/sys/goo/inspection/subject
  + normalized_source
    ' Normalized source
    ' Normalized source read from a pinned compiler artifact.
    ^ path
    '/sys/goo/normalized_source
  + receipts
    ' Action receipts
    ' Receipts retained by the Goo action runtime.
    ^ path
    '/sys/goo/receipts
+ grove
  + action
    ' Action schema
    ' Receiver and argument schema for a declared action.
    ^ path
    '/sys/grove/action
  + action_handler
    ' Action handler
    ' Compiled action implementation.
    ^ path
    '/sys/grove/action_handler
  + draft
    ' Draft registration
    ' Draft, job slot, preview/public source and target, and prelude registration.
    ^ path
    '/sys/grove/draft
  + like
    ' Source norm
    ' Source norm from which a declaration derives.
    ^ path
    '/sys/grove/like
  + module
    ' Module bundle
    ' Version, identity, prefix, exports and artifact of a compiled module.
    ^ path
    '/sys/grove/module
  + norm
    ' Tree norm
    ' Path segment patterns and item role for a tree.
    ^ path
    '/sys/grove/norm
  + role
    ' Record role
    ' Declared fields and presence groups for a record.
    ^ path
    '/sys/grove/role
  + role_contract
    ' Role constraints
    ' Compiled constraints for a role.
    ^ path
    '/sys/grove/role_contract
  + seed
    ' Tree seed
    ' Seed path and optional rule.
    ^ path
    '/sys/grove/seed
  + sewn
    ' Sewn contract
    ' Source and target norms with pinned schemas.
    ^ path
    '/sys/grove/sewn
  + source
    ' Template source
    ' Template source version pinned on an installed instance.
    ^ path
    '/sys/grove/source
  + template
    ' Template
    ' Version and relative seed records of a reusable template.
    ^ path
    '/sys/grove/template
  + view
    ' Published view
    ' Published view, fields, contract and lowering result.
    ^ path
    '/sys/grove/view
+ help
  ' Help
  ' Extended documentation as plain text or structured lore, including examples and doctests.
  ^ path
  '/sys/help
+ lash
  ' Record constraints
  ' Read, write and presence constraints for a record.
  ^ path
  '/sys/lash
+ lede
  ' Title
  ' Short title or description.
  ^ path
  '/sys/lede
+ limb
  ' Behavior references
  ' Behavior implementation references governing a record.
  ^ path
  '/sys/limb
+ mold
  ' Type
  ' Canonical type description of a published definition.
  ^ path
  '/sys/mold
+ now
  ' Current time
  ' Current time supplied by the runtime.
  ^ path
  '/sys/now
+ op
  ' Operation
  ' An operation interface.
  ^ path
  '/sys/op
+ pending
  ' Pending work
  ' Application-specific marker for waiting work.
  ^ path
  '/sys/pending
+ req
  ' Request
  ' Request on a driver-minted node.
  ^ path
  '/sys/req
+ res
  ' Response
  ' Response from the serving behavior; presence signals completion.
  ^ path
  '/sys/res
+ spec
  ' Subtree contract
  ' Subtree contract used by a warden to constrain children.
  ^ path
  '/sys/spec
+ src
  ' Source text
  ' Textual source.
  ^ path
  '/sys/src
+ tack
  ' Component dependency
  ' Pinned cared data dependency of a component attachment.
  ^ path
  '/sys/tack
+ unreads
  ' Unread indicator
  ' Reserved unread indicator; no current executable reader or writer.
  ^ path
  '/sys/unreads
+ version
  + block
    ' Assertion block
    ' Block height of the latest assertion.
    ^ path
    '/sys/version/block
  + first
    ' First record epoch
    ' Epoch of the first x version.
    ^ path
    '/sys/version/first
  + now
    ' Assertion time
    ' Time of the latest assertion.
    ^ path
    '/sys/version/now
  + state
    ' Record state
    ' Live or tombstone state of the queried node.
    ^ path
    '/sys/version/state
  + top
    ' Sovereign epoch
    ' Current sovereign epoch.
    ^ path
    '/sys/version/top
  + x_data
    ' Record data revision
    ' Node data revision counter.
    ^ path
    '/sys/version/x_data
  + x_shape
    ' Record shape revision
    ' Node live-domain shape revision counter.
    ^ path
    '/sys/version/x_shape
  + y_data
    ' Frontier data revision
    ' Nearest record-bearing frontier data revision counter.
    ^ path
    '/sys/version/y_data
  + y_shape
    ' Frontier shape revision
    ' Nearest record-bearing frontier live-domain shape revision counter.
    ^ path
    '/sys/version/y_shape
  + z_data
    ' Subtree data revision
    ' Whole subtree data revision counter.
    ^ path
    '/sys/version/z_data
  + z_shape
    ' Subtree shape revision
    ' Whole subtree live-domain shape revision counter.
    ^ path
    '/sys/version/z_shape
+ weft
  ' Component constructor
  ' Component constructor used to render a record.
  ^ path
  '/sys/weft
