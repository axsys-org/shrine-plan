- sys/types

' Published at the direct /sys root by the system compiler context.
+ limb
  ' Behavior implementation references governing a record.
  ^ path
  '/sys/limb
+ form
  ' A behavior implementation.
  ^ path
  '/sys/form
+ crew
  ' Committed dependency bindings for behavior activation.
  ^ path
  '/sys/crew
+ lash
  ' Read, write and presence constraints for a record.
  ^ path
  '/sys/lash
+ op
  ' An operation interface.
  ^ path
  '/sys/op
+ weft
  ' A component definition reference.
  ^ path
  '/sys/weft
+ tack
  ' A component attachment reference.
  ^ path
  '/sys/tack
+ content
  ' The primary value at a name.
  ^ path
  '/sys/content
+ lede
  ' A short description.
  ^ path
  '/sys/lede
+ help
  ' Extended documentation.
  ^ path
  '/sys/help
+ about
  ' The subject described by this record.
  ^ path
  '/sys/about
+ from
  ' The source of this record.
  ^ path
  '/sys/from
+ src
  ' Textual source.
  ^ path
  '/sys/src
+ author
  ' An asserted author; unsigned scaffolding.
  ^ path
  '/sys/author
+ req
  ' A request record.
  ^ path
  '/sys/req
+ res
  ' A response record.
  ^ path
  '/sys/res
+ now
  ' The current time supplied by the runtime.
  ^ path
  '/sys/now
+ mold
  ' The canonical type description of a definition.
  ^ path
  '/sys/mold
+ epoch
  ' A counter used for the purposes of triggering actions or sync
  '/sys/epoch
+ pending
  ' Something waiting
  '/sys/pending

