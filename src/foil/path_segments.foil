- sys/shrine

' Canonical document path segments and explicit instance-relative markers.
+  invalid_segment
  \ ignored=unit
  ^ path
  ; (error (pails/t "Invalid namespace segment in document"))
  []
+  seg_iotas
  ' Canonical source segments preserve each aura. A leading dot is the
  ' explicit instance-relative marker, interpreted only by installation.
  ' ?= ((seg_iotas ["a" "b"]) [($ts "a") ($ts "b")])
  ' ?= ((seg_iotas ["0x0001" "a"]) [($x 256) ($ts "a")])
  \ segs=row[nat]
  ^ path
  % i=nat 0 out=path []
  ^ path
  ? (ge i segs.len) out
  = segment segs.at(i)
  ? (eq i 0)
    ? (eq segment ".") (_ i.inc out.snoc(($ts ".")))
    ?> (./some parsed) (path_parse (str/from_atom (cord/cat "/" segment)))
        (invalid_segment [])
    | _ i.inc out.weld(parsed)
  ?> (./some parsed) (path_parse (str/from_atom (cord/cat "/" segment)))
      (invalid_segment [])
  | _ i.inc out.weld(parsed)

+  seg_texts
  ' Canonical path spelling preserves segment auras in hydrated documents.
  ' ?= ((seg_texts ['a 'b]) ["a" "b"])
  ' ?= ((seg_texts [($x 256) 'a]) ["0x0001" "a"])
  \ p=path
  ^ row[nat]
  | p.map
  \ segment=iota
  ^ nat
  ? (eq_iota segment ($ts ".")) "."
  = printed | str/to_atom (path_show [segment])
  | cord/slice 1 (sub (cord/len printed) 1) printed
