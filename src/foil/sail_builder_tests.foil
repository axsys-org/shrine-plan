-  sail
+  builder_definition
  \  term=nat description=nat
  ~ sail
  ~|
    ~. 'dt term
    ~. 'dd description
+  builder_card
  \  enabled=bool names=row[nat]
  ~ sail
  ~# 'section.card
    'aria-label "A&B"
    ~. 'h2 "Hello " "world"
    ? enabled
      ~. 'p "Enabled"
    | ~. 'p "Disabled"
    ~| 'ul
      % name names
        ~# 'li
          'class "person"
          ~. name
    ~| 'dl
      builder_definition("status" "ready")
    ~# 'input
      'type 'checkbox
      'checked enabled
      'disabled 0
+  builder_local
  \  name=nat
  ~ sail
  ~|
    = greeting "Hi "
    ~. greeting name
+  builder_match
  \  value=maybe[nat]
  ~ sail
  ~| 'div
    ? value
     > .none
       ~. "none"
     > (./some n)
       ~|
         ~. 'b n
         ~. "!"
+  builder_multiline
  ~ sail
  ~. 'p
    "hello "
    "world"
+  builder_guard
  \  value=maybe[nat]
  ~ sail
  ~|
    ?> (./some n) value
       ~. "missing"
    ~. n
+  builder_optional
  \  enabled=bool
  ~ sail
  ~|
    ? enabled
      ~. "yes"
    ~. "tail"
+  counter_builder
  +  child
    nat
  +  text
    \  n=nat
    ^  nat
    n
  +  texts
    \  ns=row[nat]
    ^  nat
    ns.fold(add 0)
  +  field
    \  key=nat value=nat
    ^  nat
    value
  +  node
    \  head=nat fields=row[nat] children=row[nat]
    ^  nat
    (add 1 (add fields.fold(add 0) children.fold(add 0)))
  +  bind
    (@ v)
    \  values=row[v] f={\ v}row[nat]
    ^  row[nat]
    values.fold((\ acc=row[nat] v=v acc.weld((f v))) [])
+  builder_generic
  ~ counter_builder
  ~# 'root
    'weight 10
    ~. 2 3
    ~|
      ~. 7
      ~| 'leaf
+  builder_loop
  \  count=nat
  ~ sail
  ~|
    % i=nat count
    ? (eq i 0)
      ~. "done"
    | (_ (dec i))
+  builder_empty
  ~ sail
  ~|
+  builder_call
  ~ sail
  ~|
    | builder_definition "a" "b"
    ~. "end"
+  builder_scope
  \  text=nat node=nat field=nat bind=nat
  ~ sail
  ~. "safe"
+  builder_link
  \  name=str count=nat
  ~ sail
  ~# 'a.button.primary
    'href "/users/".cat(name)
    ~. "View " name " (" count.show ")"
