+ contract
  ' Embedded contract language. Construction runs in Foil; expression values
  ' lower to executable restricted PLAN before EVM emission.
  + expr
    & contract/expr/arg contract/expr/lit contract/expr/plus
      contract/expr/minus contract/expr/times contract/expr/quotient
      contract/expr/equals contract/expr/less contract/expr/choose
    + arg : index=nat
    + lit : value=nat
    + plus : left=contract/expr right=contract/expr
    + minus : left=contract/expr right=contract/expr
    + times : left=contract/expr right=contract/expr
    + quotient : left=contract/expr right=contract/expr
    + equals : left=contract/expr right=contract/expr
    + less : left=contract/expr right=contract/expr
    + choose : condition=contract/expr yes=contract/expr no=contract/expr
  + wire
    ' Private compiler interface; never a chain encoding or PLAN substitute.
    \ expression=contract/expr
    ^ any
    ? expression
     > (./arg index) [0 index]
     > (./lit value) [1 value]
     > (./plus a b) [2 (contract/wire a) (contract/wire b)]
     > (./minus a b) [3 (contract/wire a) (contract/wire b)]
     > (./times a b) [4 (contract/wire a) (contract/wire b)]
     > (./quotient a b) [5 (contract/wire a) (contract/wire b)]
     > (./equals a b) [6 (contract/wire a) (contract/wire b)]
     > (./less a b) [7 (contract/wire a) (contract/wire b)]
     > (./choose c y n) [8 (contract/wire c) (contract/wire y) (contract/wire n)]
  + export
    \ arguments=nat expression=contract/expr
    ^ any
    [arguments (contract/wire expression)]
