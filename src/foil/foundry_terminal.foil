-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_pronounce [order=40]
-  foundry_pronounce_walk [order=50]
'  foundry_terminal: an ephemeral, typed lowering plan between one completed
'  addressed semantic pronunciation and a target adapter.
'
'  These records are derived compiler material, not a fifth authored Foundry
'  document family.  They contain no product-local roles, target syntax,
'  transport protocol, callbacks, or host handles.  A terminal adapter may
'  encode the admitted operation row; it must not select recipes or reconstruct
'  semantic children.

+  terminal_operation
  '  The deliberately small adapter-facing operation algebra.  Every arm is
  '  structural; target spellings belong to a later codec.
  &  terminal_operation/pass
     terminal_operation/container
     terminal_operation/text
     terminal_operation/glyph
     terminal_operation/hole
     terminal_operation/action

  +  pass
    :
  +  container
    :
  +  text
    :
  +  glyph
    :
  +  hole
    :
  +  action
    :

+  terminal_binding
  '  A typed value selected by an admitted rule.  projection_value keeps this
  '  boundary renderer-neutral and excludes arbitrary executable payloads.
  :  key=path value=projection_value

+  terminal_provider_provenance
  '  Exact admitted provider mapping used by a selected rule.  identity is a
  '  semantic definition reference; pin is its immutable admitted revision.
  :  identity=path pin=foundry_digest binding=path

+  terminal_fallback_provenance
  '  One explicit fallback edge actually traversed during selection.
  :  class=iota recipe=path pin=foundry_digest

+  terminal_selected_recipe
  '  Identity and pin copied from one already-admitted felt Recipe selection.
  '  This record cannot admit a recipe; plan validation only rejects malformed
  '  evidence and preserves whether declared fallback selection was involved.
  '  The exact Zoo algebra travels as evidence so an arbitrary Recipe pin
  '  cannot be relabeled as a terminal cut after selection.
  :  identity=path
     pin=foundry_digest
     fallback=bool
     primitive=iota
     input=iota
     output=iota

+  terminal_target
  '  Ephemeral pronunciation axes.  Fidelity is typed by Foundry delivery and
  '  deliberately excluded from terminal_semantic_identity below.
  :  backend=iota
     family=path
     features=row[path]
     mode=iota
     ceiling=iota
     fidelity=projection_fidelity

+  terminal_selected_rule
  '  One explicit Zoo-selected rule for one exact occurrence address.  Child
  '  order is not accepted here; it is derived from projection_pronunciation.
  :  address=projection_address
     resolution_context=foundry_digest
     recipe=terminal_selected_recipe
     operation=terminal_operation
     bindings=row[terminal_binding]
     providers=row[terminal_provider_provenance]
     fallbacks=row[terminal_fallback_provenance]

+  terminal_plan_entry
  '  One occurrence lowered in canonical pronunciation pre-order.  children
  '  are the exact immediate addressed children in that same authored order.
  '  interaction is copied whole from the completed canonical DAG so its
  '  independent address, exact occurrence owner, Action admission evidence,
  '  and semantic destination cannot be reconstructed from a role or Recipe.
  :  occurrence=projection_pronunciation_occurrence
     address=projection_address
     resolution_context=foundry_digest
     recipe=terminal_selected_recipe
     operation=terminal_operation
     bindings=row[terminal_binding]
     children=row[projection_address]
     interaction=maybe[projection_interaction]
     providers=row[terminal_provider_provenance]
     fallbacks=row[terminal_fallback_provenance]

+  terminal_plan
  '  A disposable target plan over one immutable semantic input.  Resolution
  '  context remains per entry because one shared definition can be placed
  '  beneath several Plate or Block scopes.  Fidelity remains only in target.
  '  The two explicit versions make cached plans rejectable when either the
  '  envelope or closed terminal-operation algebra changes.
  :  schema=nat
     operation_version=nat
     pronunciation=projection_pronunciation
     target=terminal_target
     entries=row[terminal_plan_entry]

+  terminal_occurrence_context
  '  The exact contextual semantic identity of one occurrence.  This pair is
  '  ordered by canonical pronunciation occurrence order.
  :  address=projection_address digest=foundry_digest

+  terminal_semantic_identity
  '  Semantic identity is intentionally independent of backend, family,
  '  features, mode, ceiling, and especially fidelity.  Those axes can produce
  '  several terminal plans without rebuilding or renaming the addressed DAG.
  :  revision=foundry_digest
     roots=row[projection_address]
     contexts=row[terminal_occurrence_context]

+  terminal_plan_refusal
  :  code=iota at=maybe[projection_address]

+  terminal_plan_result
  &  terminal_plan_result/admitted
     terminal_plan_result/refused

  +  admitted
    :  plan=terminal_plan
  +  refused
    :  refusal=terminal_plan_refusal

+  terminal_entry_build_result
  &  terminal_entry_build_result/admitted
     terminal_entry_build_result/refused

  +  admitted
    :  entries=row[terminal_plan_entry]
  +  refused
    :  refusal=terminal_plan_refusal

+  foundry_terminal
  +  refusal
    \  code=iota at=maybe[projection_address]
    ^  terminal_plan_refusal
    (terminal_plan_refusal code at)

  +  path_valid
    \  value=path
    ^  bool
    (gt value.len 0)

  +  paths_valid
    \  values=row[path] index=nat
    ^  bool
    ?  (ge index values.len)  .true
    ?  !(foundry_terminal/path_valid values.at(index))  .false
    (_ values index.inc)

  +  path_in_prefix
    \  value=path values=row[path] end=nat
    ^  bool
    |  > i=nat 0
    ?  (ge i end)  .false
    ?  (equal value values.at(i))  .true
    (_ i.inc)

  +  paths_unique
    \  values=row[path] index=nat
    ^  bool
    ?  (ge index values.len)  .true
    ?  (foundry_terminal/path_in_prefix values.at(index) values index)
       .false
    (_ values index.inc)

  +  target_valid
    \  target=terminal_target
    ^  bool
    ?  !(foundry_terminal/path_valid target.family)  .false
    ?  !(foundry_terminal/paths_valid target.features 0)  .false
    (foundry_terminal/paths_unique target.features 0)

  +  recipe_valid
    \  recipe=terminal_selected_recipe
    ^  bool
    ?  !(foundry_terminal/path_valid recipe.identity)  .false
    ?  !(foundry_digest/valid recipe.pin)  .false
    ?  !(eq_iota recipe.primitive 'felt)  .false
    ?  !(eq_iota recipe.input 'subtree)  .false
    (eq_iota recipe.output 'record)

  +  binding_key_after
    \  key=path bindings=row[terminal_binding] index=nat
    ^  bool
    ?  (ge index bindings.len)  .false
    ?  (equal key bindings.at(index).key)  .true
    (_ key bindings index.inc)

  +  binding_keys_unique
    \  bindings=row[terminal_binding] index=nat
    ^  bool
    ?  (ge index bindings.len)  .true
    ?  (foundry_terminal/binding_key_after bindings.at(index).key bindings
         index.inc)
       .false
    (_ bindings index.inc)

  +  bindings_valid
    \  bindings=row[terminal_binding] index=nat
    ^  bool
    ?  (ge index bindings.len)
       (foundry_terminal/binding_keys_unique bindings 0)
    ?  !(foundry_terminal/path_valid bindings.at(index).key)  .false
    (_ bindings index.inc)

  +  providers_valid
    \  providers=row[terminal_provider_provenance] index=nat
    ^  bool
    ?  (ge index providers.len)  .true
    =  provider  providers.at(index)
    ?  !(foundry_terminal/path_valid provider.identity)  .false
    ?  !(foundry_terminal/path_valid provider.binding)  .false
    ?  !(foundry_digest/valid provider.pin)  .false
    (_ providers index.inc)

  +  fallbacks_valid
    \  fallbacks=row[terminal_fallback_provenance] index=nat
    ^  bool
    ?  (ge index fallbacks.len)  .true
    =  fallback  fallbacks.at(index)
    ?  !(foundry_terminal/path_valid fallback.recipe)  .false
    ?  !(foundry_digest/valid fallback.pin)  .false
    (_ fallbacks index.inc)

  +  occurrence_address
    '  Placement identity wins when present because it distinguishes repeated
    '  use of one semantic definition.  Roots and unplaced definitions retain
    '  their semantic address.  Inline Holes carry a placement address.
    \  occurrence=projection_pronunciation_occurrence
    ^  maybe[projection_address]
    ?  occurrence.placement_address
     > (./some address=projection_address)  (./some address)
     > .none  occurrence.semantic_address

  +  address_in
    \  address=projection_address addresses=row[projection_address]
    ^  bool
    addresses.any((\ at (equal address at)))

  +  matching_rules
    \  address=projection_address rules=row[terminal_selected_rule]
       index=nat out=row[terminal_selected_rule]
    ^  row[terminal_selected_rule]
    ?  (ge index rules.len)  out
    =  rule  rules.at(index)
    ?  (equal address rule.address)
       (_ address rules index.inc out.snoc(rule))
    (_ address rules index.inc out)

  +  first_unmatched_rule
    \  rules=row[terminal_selected_rule] seen=row[projection_address] index=nat
    ^  maybe[terminal_selected_rule]
    ?  (ge index rules.len)  .none
    =  rule  rules.at(index)
    ?  !(foundry_terminal/address_in rule.address seen)  (./some rule)
    (_ rules seen index.inc)

  +  pronunciation_shape_valid
    '  Validate the flat pre-order carrier before deriving child edges.  A new
    '  root may return to depth zero; no occurrence may jump over a parent.
    \  occurrences=row[projection_pronunciation_occurrence] index=nat
    ^  bool
    ?  (eq occurrences.len 0)  .false
    ?  (eq index 0)
       ?  !(eq occurrences.at(0).depth 0)  .false
       (_ occurrences 1)
    ?  (ge index occurrences.len)  .true
    ?  (gt occurrences.at(index).depth occurrences.at(index.dec).depth.inc)
       .false
    (_ occurrences index.inc)

  +  occurrence_addresses
    \  occurrences=row[projection_pronunciation_occurrence] index=nat
       out=row[projection_address]
    ^  maybe[row[projection_address]]
    ?  (ge index occurrences.len)  (./some out)
    ?  (foundry_terminal/occurrence_address occurrences.at(index))
     > .none  .none
     > (./some address=projection_address)
       ?  !(foundry_delivery/address_valid address)  .none
       ?  (foundry_terminal/address_in address out)  .none
       (_ occurrences index.inc out.snoc(address))

  +  root_addresses
    \  occurrences=row[projection_pronunciation_occurrence] index=nat
       out=row[projection_address]
    ^  row[projection_address]
    ?  (ge index occurrences.len)  out
    =  occurrence  occurrences.at(index)
    ?  !(eq occurrence.depth 0)
       (_ occurrences index.inc out)
    ?  (foundry_terminal/occurrence_address occurrence)
     > .none  (_ occurrences index.inc out)
     > (./some address=projection_address)
       (_ occurrences index.inc out.snoc(address))

  +  child_addresses
    '  Convert pre-order depth into exact immediate child order.  Deeper
    '  descendants are skipped here but remain entries in their own right.
    \  occurrences=row[projection_pronunciation_occurrence]
       parent_index=nat scan=nat out=row[projection_address]
    ^  row[projection_address]
    ?  (ge scan occurrences.len)  out
    =  parent_depth  occurrences.at(parent_index).depth
       child  occurrences.at(scan)
    ?  (ge parent_depth child.depth)  out
    ?  !(eq child.depth parent_depth.inc)
       (_ occurrences parent_index scan.inc out)
    ?  (foundry_terminal/occurrence_address child)
     > .none  (_ occurrences parent_index scan.inc out)
     > (./some address=projection_address)
       (_ occurrences parent_index scan.inc out.snoc(address))

  +  operation_is_hole
    \  operation=terminal_operation
    ^  bool
    ?  operation
     > terminal_operation/hole  .true
     > terminal_operation/pass  .false
     > terminal_operation/container  .false
     > terminal_operation/text  .false
     > terminal_operation/glyph  .false
     > terminal_operation/action  .false

  +  operation_is_leaf
    \  operation=terminal_operation
    ^  bool
    ?  operation
     > terminal_operation/text    .true
     > terminal_operation/glyph   .true
     > terminal_operation/hole    .true
     > terminal_operation/action  .false
     > terminal_operation/pass    .false
     > terminal_operation/container  .false

  +  hole_shape_valid
    \  operation=terminal_operation
       occurrence=projection_pronunciation_occurrence
    ^  bool
    ?  occurrence.hole
     > .none  !(foundry_terminal/operation_is_hole operation)
     > (./some _)  (foundry_terminal/operation_is_hole operation)

  +  leaf_shape_valid
    \  operation=terminal_operation children=row[projection_address]
    ^  bool
    ?  (foundry_terminal/operation_is_leaf operation)
       (eq children.len 0)
    .true

  +  operation_bindings_valid
    \  operation=terminal_operation bindings=row[terminal_binding]
    ^  bool
    ?  operation
     > terminal_operation/pass       (eq bindings.len 0)
     > terminal_operation/container  .true
     > terminal_operation/text       .true
     > terminal_operation/glyph      .true
     > terminal_operation/hole       .true
     > terminal_operation/action     .true

  +  operation_valid
    \  operation=terminal_operation
       occurrence=projection_pronunciation_occurrence
       bindings=row[terminal_binding] children=row[projection_address]
    ^  bool
    ?  !(foundry_terminal/hole_shape_valid operation occurrence)  .false
    ?  !(foundry_terminal/leaf_shape_valid operation children)  .false
    (foundry_terminal/operation_bindings_valid operation bindings)

  +  resolution_context_matches
    '  Only an explicitly legacy empty-table DAG may admit an occurrence with
    '  no context.  Strict roots and placements carry canonical table evidence,
    '  so terminal selection must preserve the exact digest and cannot supply
    '  a target-local substitute.
    \  dag=projection_dag occurrence=projection_pronunciation_occurrence
       selected=foundry_digest
    ^  bool
    ?  occurrence.resolution_context
     > .none  (eq 0 dag.contexts.len)
     > (./some expected=foundry_digest)  (equal expected selected)

  +  interaction_for_owner
    '  Completion rejects duplicate interaction owners.  The first match is
    '  therefore the one exact independently addressed sidecar for this
    '  occurrence, or none when no interaction was admitted.
    \  owner=projection_address entries=row[projection_entry]
       index=nat
    ^  maybe[projection_interaction]
    ?  (ge index entries.len)  .none
    ?  entries.at(index)
     > x=projection_entry/interaction
       ?  (equal owner x.interaction.owner)  (./some x.interaction)
       (_ owner entries index.inc)
     > projection_entry/node       (_ owner entries index.inc)
     > projection_entry/placement  (_ owner entries index.inc)
     > projection_entry/tombstone  (_ owner entries index.inc)

  +  action_operation_refusal
    \  operation=terminal_operation
       interaction=maybe[projection_interaction]
    ^  maybe[iota]
    ?  operation
     > terminal_operation/action
       ?  interaction
        > .none  (./some 'terminal_action_mount_missing)
        > (./some mounted=projection_interaction)
          '  v1 has no separate selected-Action field in a terminal rule, so
          '  accepting several mounts would leave the adapter to choose.
          ?  (eq mounted.actions.len 0)
             (./some 'terminal_action_mount_missing)
          ?  (gt mounted.actions.len 1)
             (./some 'terminal_action_mount_ambiguous)
          .none
     > terminal_operation/pass       .none
     > terminal_operation/container  .none
     > terminal_operation/text       .none
     > terminal_operation/glyph      .none
     > terminal_operation/hole       .none

  +  build_entries
    \  dag=projection_dag pronunciation=projection_pronunciation
       rules=row[terminal_selected_rule]
       index=nat seen=row[projection_address]
       out=row[terminal_plan_entry]
    ^  terminal_entry_build_result
    ?  (ge index pronunciation.occurrences.len)
       ?  (foundry_terminal/first_unmatched_rule rules seen 0)
        > .none  (terminal_entry_build_result/admitted out)
        > (./some rule=terminal_selected_rule)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_rule_unaddressed
              (./some rule.address)))
    =  occurrence  pronunciation.occurrences.at(index)
    ?  (foundry_terminal/occurrence_address occurrence)
     > .none
       (terminal_entry_build_result/refused
         (foundry_terminal/refusal 'terminal_occurrence_unaddressed .none))
     > (./some address=projection_address)
       ?  (foundry_terminal/address_in address seen)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_occurrence_ambiguous
              (./some address)))
       =  matches  (foundry_terminal/matching_rules address rules 0 [])
       ?  (eq matches.len 0)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_rule_missing
              (./some address)))
       ?  (gt matches.len 1)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_rule_ambiguous
              (./some address)))
       =  rule  matches.at(0)
          children
            (foundry_terminal/child_addresses pronunciation.occurrences index
              index.inc [])
          interaction
            (foundry_terminal/interaction_for_owner address dag.entries 0)
       ?  !(foundry_digest/valid rule.resolution_context)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_resolution_context_invalid
              (./some address)))
       ?  !(foundry_terminal/resolution_context_matches dag occurrence
             rule.resolution_context)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_resolution_context_mismatch
              (./some address)))
       ?  !(foundry_terminal/recipe_valid rule.recipe)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_recipe_invalid
              (./some address)))
       ?  !(foundry_terminal/bindings_valid rule.bindings 0)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_bindings_invalid
              (./some address)))
       ?  !(foundry_terminal/providers_valid rule.providers 0)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_provider_provenance_invalid
              (./some address)))
       ?  !(foundry_terminal/fallbacks_valid rule.fallbacks 0)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal 'terminal_fallback_provenance_invalid
              (./some address)))
       ?  (foundry_terminal/action_operation_refusal rule.operation
             interaction)
        > (./some code=iota)
          (terminal_entry_build_result/refused
            (foundry_terminal/refusal code (./some address)))
        > .none
          ?  !(foundry_terminal/operation_valid rule.operation occurrence
                 rule.bindings children)
             (terminal_entry_build_result/refused
               (foundry_terminal/refusal 'terminal_operation_invalid
                 (./some address)))
          =  entry
               (terminal_plan_entry occurrence address rule.resolution_context
                 rule.recipe rule.operation rule.bindings children interaction
                 rule.providers rule.fallbacks)
          (foundry_terminal/build_entries dag pronunciation rules index.inc
            seen.snoc(address) out.snoc(entry))

  +  pronunciation_canonical
    '  A pronunciation is disposable traversal material, never an authority
    '  input.  Rebuild it from the completed DAG and require byte-for-byte
    '  equality so a caller cannot forge occurrence order, role, parameters,
    '  context, or Hole state while retaining the same revision and roots.
    \  dag=projection_dag pronunciation=projection_pronunciation
    ^  bool
    ?  (foundry_pronounce_walk/pronounce dag)
     > projection_pronunciation_result/refused  .false
     > x=projection_pronunciation_result/admitted
       (equal x.pronunciation pronunciation)

  +  build
    '  Total lowering from one completed canonical DAG, its disposable
    '  pronunciation, and explicit selected rules.  Rule row order is
    '  irrelevant: output order comes exclusively from the admitted occurrence
    '  stream.  Any missing, duplicate, invalid, or unaddressed rule refuses
    '  the whole plan.  Interaction mounts are read only from dag.
    \  dag=projection_dag pronunciation=projection_pronunciation
       target=terminal_target
       rules=row[terminal_selected_rule]
    ^  terminal_plan_result
    ?  !(equal dag.manifest.revision pronunciation.revision)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_dag_revision_mismatch .none))
    ?  !(equal dag.manifest.roots pronunciation.roots)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_dag_roots_mismatch .none))
    ?  !(foundry_delivery/completion_valid dag)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_dag_incomplete .none))
    ?  !(foundry_terminal/pronunciation_canonical dag pronunciation)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_pronunciation_mismatch .none))
    ?  !(foundry_digest/valid pronunciation.revision)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_revision_invalid .none))
    ?  (eq pronunciation.roots.len 0)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_root_missing .none))
    ?  !(foundry_delivery/addresses_valid pronunciation.roots)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_root_invalid .none))
    ?  !(foundry_terminal/target_valid target)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_target_invalid .none))
    ?  !(foundry_terminal/pronunciation_shape_valid
           pronunciation.occurrences 0)
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_occurrence_shape_invalid .none))
    ?  (foundry_terminal/occurrence_addresses pronunciation.occurrences 0 [])
     > .none
       (terminal_plan_result/refused
         (foundry_terminal/refusal 'terminal_occurrence_address_invalid .none))
     > (./some addresses=row[projection_address])
       =  roots
            (foundry_terminal/root_addresses pronunciation.occurrences 0 [])
       ?  !(equal roots pronunciation.roots)
          (terminal_plan_result/refused
            (foundry_terminal/refusal 'terminal_root_occurrence_mismatch .none))
       ?  (foundry_terminal/build_entries dag pronunciation rules 0 [] [])
        > x=terminal_entry_build_result/refused
          (terminal_plan_result/refused x.refusal)
        > x=terminal_entry_build_result/admitted
          (terminal_plan_result/admitted
            (terminal_plan 2 2 pronunciation target x.entries))

  '  Construction gates for untyped hosts and focused tests.  They create
  '  inert typed evidence only; build performs all admission checks.
  +  make_target
    \  backend=iota family=path features=row[path] mode=iota ceiling=iota
       fidelity=projection_fidelity
    ^  terminal_target
    (terminal_target backend family features mode ceiling fidelity)

  +  make_recipe
    \  identity=path pin=foundry_digest fallback=bool
    ^  terminal_selected_recipe
    (terminal_selected_recipe identity pin fallback 'felt 'subtree 'record)

  +  make_recipe_evidence
    '  Explicit construction gate used by selection bridges and negative
    '  tests.  build still admits only the exact felt subtree -> record law.
    \  identity=path pin=foundry_digest fallback=bool
       primitive=iota input=iota output=iota
    ^  terminal_selected_recipe
    (terminal_selected_recipe identity pin fallback primitive input output)

  +  make_binding
    \  key=path value=projection_value
    ^  terminal_binding
    (terminal_binding key value)

  +  make_provider
    \  identity=path pin=foundry_digest binding=path
    ^  terminal_provider_provenance
    (terminal_provider_provenance identity pin binding)

  +  make_fallback
    \  class=iota recipe=path pin=foundry_digest
    ^  terminal_fallback_provenance
    (terminal_fallback_provenance class recipe pin)

  +  make_rule
    \  address=projection_address resolution_context=foundry_digest
       recipe=terminal_selected_recipe
       operation=terminal_operation bindings=row[terminal_binding]
       providers=row[terminal_provider_provenance]
       fallbacks=row[terminal_fallback_provenance]
    ^  terminal_selected_rule
    (terminal_selected_rule address resolution_context recipe operation
      bindings providers fallbacks)

  +  op_pass
    ^  terminal_operation
    (terminal_operation/pass)
  +  op_container
    ^  terminal_operation
    (terminal_operation/container)
  +  op_text
    ^  terminal_operation
    (terminal_operation/text)
  +  op_glyph
    ^  terminal_operation
    (terminal_operation/glyph)
  +  op_hole
    ^  terminal_operation
    (terminal_operation/hole)
  +  op_action
    ^  terminal_operation
    (terminal_operation/action)

  +  fidelity_latent
    ^  projection_fidelity
    (projection_fidelity/latent)
  +  fidelity_coarse
    ^  projection_fidelity
    (projection_fidelity/coarse)
  +  fidelity_normal
    ^  projection_fidelity
    (projection_fidelity/normal)
  +  fidelity_refined
    ^  projection_fidelity
    (projection_fidelity/refined)

  +  occurrence_contexts
    \  entries=row[terminal_plan_entry] index=nat
       out=row[terminal_occurrence_context]
    ^  row[terminal_occurrence_context]
    ?  (ge index entries.len)  out
    =  entry  entries.at(index)
    (_ entries index.inc
      out.snoc((terminal_occurrence_context entry.address
        entry.resolution_context)))

  +  semantic_identity
    \  plan=terminal_plan
    ^  terminal_semantic_identity
    (terminal_semantic_identity plan.pronunciation.revision
      plan.pronunciation.roots
      (foundry_terminal/occurrence_contexts plan.entries 0 []))

  +  result_admitted
    \  result=terminal_plan_result
    ^  bool
    ?  result
     > terminal_plan_result/admitted  .true
     > terminal_plan_result/refused   .false

  +  result_plan
    \  result=terminal_plan_result
    ^  maybe[terminal_plan]
    ?  result
     > x=terminal_plan_result/admitted  (./some x.plan)
     > terminal_plan_result/refused     .none

  +  result_code
    \  result=terminal_plan_result
    ^  maybe[iota]
    ?  result
     > terminal_plan_result/admitted  .none
     > x=terminal_plan_result/refused  (./some x.refusal.code)

  +  result_at
    \  result=terminal_plan_result
    ^  maybe[projection_address]
    ?  result
     > terminal_plan_result/admitted  .none
     > x=terminal_plan_result/refused  x.refusal.at

  +  plan_revision
    \  plan=terminal_plan
    ^  foundry_digest
    plan.pronunciation.revision

  +  plan_schema
    \  plan=terminal_plan
    ^  nat
    plan.schema

  +  plan_operation_version
    \  plan=terminal_plan
    ^  nat
    plan.operation_version

  +  plan_roots
    \  plan=terminal_plan
    ^  row[projection_address]
    plan.pronunciation.roots

  +  plan_entries
    \  plan=terminal_plan
    ^  row[terminal_plan_entry]
    plan.entries

  +  plan_target
    \  plan=terminal_plan
    ^  terminal_target
    plan.target

  +  target_fidelity
    \  target=terminal_target
    ^  projection_fidelity
    target.fidelity

  +  entry_address
    \  entry=terminal_plan_entry
    ^  projection_address
    entry.address

  +  entry_children
    \  entry=terminal_plan_entry
    ^  row[projection_address]
    entry.children

  +  entry_recipe
    \  entry=terminal_plan_entry
    ^  terminal_selected_recipe
    entry.recipe

  +  entry_interaction
    '  Exact canonical sidecar copied for this occurrence, including its own
    '  address and owner.  None means no interaction was admitted.
    \  entry=terminal_plan_entry
    ^  maybe[projection_interaction]
    entry.interaction

  +  entry_actions
    \  entry=terminal_plan_entry
    ^  row[projection_action_mount]
    ?  entry.interaction
     > .none  []
     > (./some interaction=projection_interaction)  interaction.actions

  +  entry_destination
    \  entry=terminal_plan_entry
    ^  maybe[projection_destination_mount]
    ?  entry.interaction
     > .none  .none
     > (./some interaction=projection_interaction)  interaction.destination
