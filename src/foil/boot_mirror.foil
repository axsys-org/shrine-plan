-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=60]
-  compiler_api [order=61]
'  The compiler describes modules; Foil builds their namespace records.
+  boot_mirror
  +  node
    \ mirror_root=path module=path name=path
    ^ path
    mirror_root.weld(module).snoc(($u name.len)).weld(name)
  +  entry
    \ item=compiler_entry
    ^ myth
    = doc item.doc
      card
        | mirror/entry item.value item.kind item.source
          item.lowered doc.present doc.head doc.body doc.tests
      card
        | mirror/extras item.signature item.law
          item.calls item.callers card
    | card.put ['defline] (pails/n item.line)
  +  parts
    \ mirror_root=path item=compiler_module
    ^ [node=path doc=compiler_lore card=myth
       entries=row[[name=path card=myth]]]
    = node=path mirror_root.weld(item.name)
      doc item.doc
      entries=row[[name=path card=myth]]
        | item.entries.map
        \ ent
        ^ [name=path card=myth]
        [ent.name.cons(($u ent.name.len)) (boot_mirror/entry ent)]
      paths | entries.map (\ [name card] node.weld(name))
      card
        | mirror/src item.source doc.present doc.head
          doc.body doc.tests
      card card.meld((mirror/index paths))
      card card.put(['visible] (pails/ps item.visible))
      card card.put(['sub] (pails/code item.image))
    [node doc card entries]
  +  pairs
    \ mirror_root=path modules=row[compiler_module]
    ^ row[[name=path card=myth]]
    | modules.bind
    \ item
    = [node doc card entries] | boot_mirror/parts mirror_root item
    = children
        | entries.map
        \ [name value]
        [node.weld(name) value]
    = header=row[[name=path card=myth]] [[node card]]
    header.weld(children)
  +  tasks
    \ mirror_root=path description=text modules=row[compiler_module]
    ^ row[task]
    = children
        | (boot_mirror/pairs mirror_root modules).map
        \ [name card]
        | task/vine name (writ/make card)
    = head=row[task]
        [(task/vine mirror_root (writ/make (mirror/doc description)))]
    head.weld(children)
  +  batches
    \ mirror_root=path description=text modules=row[compiler_module]
    ^ row[task]
    = registry=path [mirror_root.at(0) 'kook 'pact]
      root
        | (mirror/doc description).put limb_slot
        | kook [registry]
      children
        | modules.map
        \ item
        = [node doc card entries] | boot_mirror/parts mirror_root item
        | pact/vine node doc.present doc.head doc.body
          doc.tests card entries
    = head=row[task] [(task/vine mirror_root (writ/make root))]
    head.weld(children)
  +  references
    \ mirror_root=path modules=row[compiler_module]
    ^ task
    = seeds
        | modules.bind
        \ item
        = [node doc card entries] | boot_mirror/parts mirror_root item
        | entries.map
        \ [name card]
        [node.drop(mirror_root.len).weld(name) card]
    | task/vine mirror_root
    | writ/poke
    | myth/sing pact/slot
    | mani 'refs (lore "" [] []) [] seeds []
  +  hydrate
    \ mirror_root=path modules=row[path] state=namespace
    ^ row[any]
    | modules.bind
    \ name
    ^ row[any]
    ? (sovereign_peek mirror_root.weld(name) state).fil
     > (./some card)
       ? card.pail_at(['sub])
        > (pails/code image) [image]
       []
    []
  +  seed
    \ commands=row[task] state=namespace
    ^ compiler_seed
    % index=nat 0 state=namespace state
    ^ compiler_seed
    ? (eq index commands.len) (./ready state)
    = command commands.at(index)
    ? (sovereign_run_event command 0 0 0 state)
     > (./fail reason) (./failed command reason)
     > (./ripe next _ _ _) | _ index.inc next
  +  names
    \ mirror_root=path groups=row[[module=path names=row[path]]]
    ^ row[[root=iota entries=row[path]]]
    = entries=row[[root=iota node=path]]
        | groups.bind
        \ [module names]
        | names.keep((\ name name.len)).map
        \ name
        [name.at(0) (boot_mirror/node mirror_root module name)]
      roots=path
        | entries.fold []
        \ roots [root node]
        ? roots.has(root) roots
        roots.snoc(root)
    | roots.map
    \ root
    [root entries.keep((\ [key node] (eq_iota key root))).map(
      (\ [key node] node))]
  +  index_tasks
    \ mirror_root=path groups=row[[root=iota entries=row[path]]]
    ^ row[task]
    | groups.map
    \ [root entries]
    | task/vine mirror_root.snoc('ns).snoc(root)
    | writ/make | mirror/index entries
  +  index_batch
    \ mirror_root=path groups=row[[root=iota entries=row[path]]]
    ^ task
    = seeds
        | groups.map
        \ [root entries]
        [[root] (mirror/index entries)]
    | pact/vine mirror_root.snoc('ns) 0 "" [] []
      (mirror/doc
        "every mirrored entry grouped by its source namespace root.")
      seeds
  +  fail_tasks
    \ mirror_root=path failures=row[[module=path reason=text]]
    ^ row[task]
    | failures.map
    \ [module reason]
    | task/vine mirror_root.weld(module)
    | writ/make | mirror/fail reason
  +  fixture
    \ name=text
    ^ bool
    ? (equal (cord/slice 0 4 name) "env_") .true
    ? (eq (cord/slice 0 6 name) "tests/") .true
    ? (eq (cord/slice 0 14 name) "test_fixtures/") .true
    = app_test=bool
        ? !(eq (cord/slice 0 5 name) "apps/") .false
        | eq (cord/slice (sub (cord/len name) 6) 6 name) "/tests"
    ? app_test .true
    = fixtures=row[text]
        ["app_test_world" "helm_ref_caller" "helm_ref_target" "mapuser"
         "mapuser_rev" "mapx" "vecapp" "perfbench"]
    fixtures.has(name)
  +  roster
    \ names=row[text]
    ^ row[text]
    | names.keep (\ name !(boot_mirror/fixture name))
  +  segments
    \ name=text
    ^ row[text]
    | str/split_byte 47 name
  +  ref_axes
    \ edges=row[[src=path dst=path]]
    ^ [out=axal[row[path]] in=axal[row[path]]]
    = empty | axal/new[row[path]] .none
    | edges.fold [empty empty]
    \ [out back] [src dst]
    [out.put(src out.gut(src []).snoc(dst))
     back.put(dst back.gut(dst []).snoc(src))]
  +  refs_of
    \ axes=[out=axal[row[path]] in=axal[row[path]]] node=path
    ^ [out=row[path] in=row[path]]
    = [out back] axes
    [out.gut(node []) back.gut(node [])]
  +  description
    ^ text
    | str/from_atom
    | cord/cat_all
    ["the boot image: the system's own compiled code. "
     "each kid of the configured mirror root is a module; f holds its source text in [src]; "
     "f/n/[...name] holds the entry declared at /[...name] "
     "(n path segments) - its kind in [kind], its own source in "
     "[src], and its compiled value in [code] when lowering "
     "produced one. entries also carry their rendered type in [ty] "
     "and, when reference mirroring is on, [calls]/[called_by] rows "
     "of mirror paths. ns/[root] groups every entry by source "
     "namespace root. a module that failed to compile carries "
     "[status] failed and its diagnostic in [err]. "
     "the mirror and behavior registry belong to the configured publisher. "
     "behavior references are fully qualified and resolve through the namespace reader. "
     "the pinned /sys publication supplies system definitions; /h supplies "
     "authority-local history, and /o and /x supply derived views."]
