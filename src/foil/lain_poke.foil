-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=31]
-  lain_peek [order=32]
'  Namespace transitions: dispatch behaviors into a transaction, validate
'  and commit its writes, then schedule reactions from the resulting signs.
'  The sovereign is immutable until commit; rejected events leave it intact.
+  note_mode
  \  w=note
  ^  mode
  ?  w
   > (./make t=myth)  .add
   > (./poke t=myth)  .dif
   > .cull  .del
+  mode_then
  '  Compose a later change kind onto an earlier one at the same path.
  \  old=maybe[mode] new=mode
  ^  mode
  ?  old
   > .none  new
   > (./some m=mode)
     ?  m
      > .add
        ?  new
         > .del  .del
         > .add  .add
         > .dif  .add
      > .del
        ?  new
         > .add  .add
         > .del  .del
         > .dif  .del
      > .dif  new
+  note_then
  '  Compose a later note onto a pending one at the same path, so the
  '  transaction holds at most one note per path.
  \  old=maybe[note] new=note
  ^  note
  ?  old
   > .none  new
   > (./some ow=note)
     ?  new
      > (./make t=myth)  new
      > .cull  new
      > (./poke t=myth)
        ?  ow
         > (./make ot=myth)
           =  m ot.meld(t)
           (./make m)
         > (./poke ot=myth)
           =  m ot.meld(t)
           (./poke m)
         > .cull  (./make t)
+  resolve
  '  Resolve a myth's kook slot against the NAMESPACE: each ref is a
  '  path read directly — its node's ['form] slot holds the form
  '  (forms are nominal rows, so they ride as pails).  The registry
  '  is namespace state — making or poking a form node installs and
  '  upgrades behaviors live, at any path, and resolution sees this
  '  event's in-flight writes.  The behavior list defaults when the
  '  kook slot is absent or empty; anything non-kook in the slot, or
  '  non-form at a ref, fails.
  \  t=myth wm=worm s=sov
  ^  kres
  =  ks limb_slot
  ?  t.get(ks)
   > .none  (./kf [def_form])
   > (./some pl=pail)
     ?  pl
      > k=kook
        =  refs k.refs
        ?  (eq 0 refs.len)
           (./kf [def_form])
        %  i=nat 0
           acc=row[form] []
        ^  kres
        ?  (eq i refs.len)
           (./kf acc)
        ?  (read_x refs.at(i) wm s)
         > .none  (./ke 'kook_unknown)
         > (./some kt=myth)
           ?  kt.get(['form])
            > .none  (./ke 'kook_unknown)
            > (./some fp=pail)
              ?  fp
               > f=form  (_ i.inc acc.snoc(f))
              (./ke 'kook_bad)
     (./ke 'kook_bad)
+  record
  '  Compose a resolved note into the transaction: one note
  '  per path, prize the composed change kind.
  \  pax=path w=note wm=worm
  ^  worm
  =  tl wm.toil
  =  w2 (note_then tl.get(pax) w)
  =  pz wm.prize
  =  m2 (mode_then pz.get(pax) (note_mode w))
  =  wm1 wm.set_toil(tl.put(pax w2))
  wm1.set_prize(pz.put(pax m2))
+  ingest
  '  Route one activation's cards from node src: targets under src
  '  (reflexively) join this transaction's queue; everything else
  '  leaves as an outbound move carrying the one command.
  \  src=path cs=row[[p=path q=writ]] wm=worm
  ^  worm
  %  i=nat 0
     acc=worm wm
  ?  (eq i cs.len)
     acc
  =  [p q] cs.at(i)
  ?  (pith_prefix src p)
     =  dn acc.down
     (_ i.inc acc.set_down(dn.snoc((flue src p (./vine q)))))
  =  uu acc.up
  (_ i.inc acc.set_up(uu.snoc((move src p q))))
+  thread_forms
  '  Run a behavior chain in order.  Each arm sees the preceding
  '  arm's state; cards retain the order in which the arms emitted them.
  \ fs=row[form] cur=myth apply={\ form myth}yell
  ^ [cards=row[[p=path q=writ]] out=myth]
  = done
      | fs.fold (yell [] cur)
      \ acc f
      = next | apply f acc.out
      | yell acc.cards.weld(next.cards) next.out
  [done.cards done.out]
+  thread_init
  '  Initialize through the complete behavior chain.
  \ b=bowl fs=row[form] cur=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = init f.init
  | init b state
+  thread_talk
  '  The input stays fixed while the current record moves through talk.
  \ b=bowl fs=row[form] cur=myth add=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = talk f.talk
  | talk b state add
+  thread_take
  \ b=bowl fs=row[form] cur=myth gift=axal[mode]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = take f.take
  | take b state gift
+  thread_hear
  \ b=bowl fs=row[form] cur=myth rely=row[dep]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = hear f.hear
  | hear b state rely
+  initialize
  '  A make or resolved warp follows one initialization path. Resolve
  '  the replacement's behaviors, thread init, then record and ingest.
  \  b=bowl t=myth wm=worm s=sov
  ^  wend
  ?  t.get(limb_slot)
   > .none  (./go (record b.here (./make t) wm))
   > (./some _)
     ?  (resolve t wm s)
      > (./ke e=iota)  (./bad e)
      > (./kf fs=row[form])
        =  [cards out] (thread_init b fs t)
        =  next (record b.here (./make out) wm)
        (./go (ingest b.here cards next))
+  dispatch
  '  Run one work unit against the transaction.  The /h and /o
  '  overlays are read-only, and /log is commit-owned: any write
  '  landing on any of them fails the whole event.
  \  f=flue wm=worm s=sov
  ^  wend
  ?  (is_h f.dst)
     (./bad 'h_reserved)
  ?  (is_o f.dst)
     (./bad 'o_reserved)
  ?  (is_xv f.dst)
     (./bad 'x_reserved)
  ?  (is_log f.dst)
     (./bad 'log_reserved)
  =  wm1 wm.set_now(wm.now.inc)
  =  kk (read .y f.dst wm1 s)
  =  cw (crew_of (read_x f.dst wm1 s) wm1 s)
  =  b (bowl f.src f.dst wm1.now wm1.eny kk cw)
  =  dst f.dst
  ?  f.job
   > (./take g=axal[mode])
     ?  (read_x dst wm1 s)
      > .none  (./bad 'take_missing)
      > (./some cur=myth)
        '  An absent kook slot resolves to [def_form]; def_take emits no
        '  cards and keeps cur (the seeding/cascade hot path).
        '  A no-op take records an empty poke: melding
        '  nothing leaves local cases unchanged, just like a
        '  cur-verbatim poke, while the raw journal stores only
        '  the empty delta rather than the whole record.
        ?  cur.get(limb_slot)
         > .none  (./go (record dst (./poke myth/new) wm1))
         > (./some _)
           ?  (resolve cur wm1 s)
            > (./ke e=iota)  (./bad e)
            > (./kf fs=row[form])
              =  [cards out] (thread_take b fs cur g)
              =  wm2
                   ?  (equal out cur)
                      (record dst (./poke myth/new) wm1)
                   (record dst (./poke out) wm1)
              (./go (ingest dst cards wm2))
   > (./hear rr=row[dep])
     ?  (read_x dst wm1 s)
      > .none  (./bad 'hear_missing)
      > (./some cur=myth)
        ?  (resolve cur wm1 s)
         > (./ke e=iota)  (./bad e)
         > (./kf fs=row[form])
           =  [cards out] (thread_hear b fs cur rr)
           =  wm2 (record dst (./poke out) wm1)
           (./go (ingest dst cards wm2))
   > (./vine w=writ)
     ?  w
      > .cull
        (./go (record dst .cull wm1))
      > (./warp op=path input=myth)
        '  poke-with-an-overlay: resolve the op card, apply
        '  (fn input cur) — a MISSING dst applies against the empty
        '  record (make-with-overlay-if-absent) — and process the
        '  result exactly like a make: a kook-less result records
        '  verbatim as a REPLACE; /initialize resolves a kooked
        '  result, threads init, and ingests its cards in this event.
        '  The input never lands in the namespace; the gate judges
        '  the final record like any write.
        =  cur0
             ?  (read_x dst wm1 s)
              > .none  myth/new
              > (./some c=myth)  c
        ?  (read_x op wm1 s)
         > .none  (./bad 'warp_op_unknown)
         > (./some ot=myth)
           ?  ot.get(['sys 'op])
            > .none  (./bad 'warp_op_bad)
            > (./some held)
              ?  held
               > o=op
                 =  f  o.fn
                 =  t (f input cur0)
                 (initialize b t wm1 s)
              (./bad 'warp_op_bad)
      > (./make t=myth)
        (initialize b t wm1 s)
      > (./poke t=myth)
        ?  (read_x dst wm1 s)
         > .none  (./bad 'poke_missing)
         > (./some cur=myth)
           =  u cur.meld(t)
           '  def_talk is the same meld: a kook-less poke records u
           '  without resolving or invoking behaviors.
           ?  u.get(limb_slot)
            > .none  (./go (record dst (./poke u) wm1))
            > (./some _)
              ?  (resolve u wm1 s)
               > (./ke e=iota)  (./bad e)
               > (./kf fs=row[form])
                 =  [cards out] (thread_talk b fs cur t)
                 =  wm2 (record dst (./poke out) wm1)
                 (./go (ingest dst cards wm2))
+  raid
  '  The gift cascade.  Each prized path is grouped under its nearest
  '  existing strict ancestor (existence is the in-flight view; the
  '  root contributes nothing), and one take per parent joins the
  '  queue, carrying the changed paths relative to that parent.  Take
  '  results are poke writes, so the prize repopulates strictly
  '  upward until it drains at the top.
  \  wm=worm s=sov
  ^  worm
  =  pz wm.prize
  =  es pz.tap
  =  gam
       %  i=nat 0
          acc=axal[axal[mode]] (axal/new[axal[mode]] .none)
       ?  (eq i es.len)
          acc
       =  [p q] es.at(i)
       ?  (le p.len 1)
          (_ i.inc acc)
       =  par
            %  k=nat p.len.dec
            ^  maybe[path]
            ?  (eq k 0)
               .none
            =  pre p.take(k)
            ?  (exists pre wm s)
               (./some pre)
            (_ k.dec)
       ?  par
        > .none  (_ i.inc acc)
        > (./some pp=path)
          =  g0 acc.gut(pp (axal/new[mode] .none))
          =  rel p.drop(pp.len)
          =  g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  gs gam.tap
  =  wm1
       %  i=nat 0
          acc=worm wm
       ?  (eq i gs.len)
          acc
       =  [p q] gs.at(i)
       =  dn acc.down
       (_ i.inc acc.set_down(dn.snoc((flue p p (./take q)))))
  wm1.set_prize((axal/new[mode] .none))
+  vine_flue
  '  One command becomes one work unit rooted at /out.
  \  p=path w=writ
  ^  flue
  (flue ['out] p (./vine w))
+  invert
  '  Turn news (changed path -> cared subscribers) into subscriber ->
  '  cared changed paths, skipping remote (/xeno) subscribers.
  \  news=axal[row[dep]]
  ^  axal[row[dep]]
  =  es news.tap
  %  i=nat 0
     acc=axal[row[dep]] (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  chg p
  =  acc2
       %  j=nat 0
          a2=axal[row[dep]] acc
       ?  (eq j q.len)
          a2
       =  e q.at(j)
       =  sub e.p
       ?  (is_xeno sub)
          (_ j.inc a2)
       =  cur a2.gut(sub [])
       (_ j.inc a2.put(sub cur.snoc((dep e.c chg))))
  (_ i.inc acc2)
+  hear_flues
  \  subs=axal[row[dep]]
  ^  row[flue]
  =  es subs.tap
  %  i=nat 0
     acc=row[flue] []
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  (_ i.inc acc.snoc((flue p p (./hear q))))
+  fires
  '  The grade a sign gives one care: nonzero means that care's
  '  perspective of the path moved.
  \  c=care g=sign
  ^  nat
  ?  c
   > .x  g.x
   > .y  g.y
   > .z  g.z
+  react
  '  The reactivity machine: match one event's change signs against
  '  the watcher index.  A watcher fires when its care's grade at
  '  its watched path is nonzero; fired subscriptions are consumed
  '  (lazy reactivity: one notification, watchers re-arm by reading)
  '  and unfired ones survive.  Returns the kernel's news — feed it
  '  back as a (./hear news) task — and the updated index.  The
  '  driver's cycle is run_event -> react on the ripe signs -> hear.
  \  signs=axal[sign] ey=eyes
  ^  [news=axal[row[dep]] rest=eyes]
  =  es ey.tap
  %  i=nat 0
     nw=axal[row[dep]] (axal/new[row[dep]] .none)
     rs=eyes (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     [nw rs]
  =  [p q] es.at(i)
  =  wat p
  ?  signs.get(wat)
   > .none  (_ i.inc nw rs.put(wat q))
   > (./some g=sign)
     =  [hot cool]
          %  j=nat 0
             hot=row[dep] []
             cool=row[dep] []
          ^  [hot=row[dep] cool=row[dep]]
          ?  (eq j q.len)
             [hot cool]
          =  e q.at(j)
          ?  (fires e.c g)
             (_ j.inc hot.snoc(e) cool)
          (_ j.inc hot cool.snoc(e))
     =  nw2
          ?  (eq 0 hot.len)
             nw
          nw.put(wat hot)
     =  rs2
          ?  (eq 0 cool.len)
             rs
          rs.put(wat cool)
     (_ i.inc nw2 rs2)
+  node_deps
  '  What a node's record subscribes to: its crew's deps, journal
  '  paths dropped (nothing may watch /log — such an eye would fire
  '  on every commit and burn the cascade's fuel forever).  Empty
  '  when the node carries no crew.
  \  t=myth
  ^  row[dep]
  ?  t.get(crew_slot)
   > .none  []
   > (./some pl=pail)
     ?  pl
      > c2=cpail
        =  ds c2.crew.tap
        %  j=nat 0
           acc=row[dep] []
        ?  (eq j ds.len)
           acc
        =  e ds.at(j)
        =  d e.val
        ?  (is_log d.p)
           (_ j.inc acc)
        (_ j.inc acc.snoc(d))
     []
+  hive_of
  '  Derive the crew index from the whole namespace — one full walk,
  '  paid when a driver takes the helm and on resume; every round
  '  after that bumps the index instead.  /io and /log nodes are
  '  skipped (see /is_io): their reactivity belongs to the driver,
  '  and journal nodes subscribe to nothing.
  \  s=sov
  ^  hive
  =  fat (peek [] s)
  =  es fat.tap
  %  i=nat 0
     acc=hive (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  ?  ((is_io sub) || (is_log sub))
     (_ i.inc acc)
  =  t q
  =  ds (node_deps t)
  ?  (eq 0 ds.len)
     (_ i.inc acc)
  (_ i.inc acc.put(sub ds))
+  hive_bump
  '  Fold one round's signs into the crew index.  A signed node is
  '  re-read once: it enters the index if it now carries a crew,
  '  leaves if it does not, and takes its whole subtree with it when
  '  its record is gone — a cull is recursive, and signs walk parent
  '  before kids, so a path re-made under a culled ancestor still
  '  lands after the subtree drop.  Ancestors ride the signs for
  '  their y/z grades and re-read to the same answer.
  \  hv=hive sg=axal[sign] s=sov
  ^  hive
  =  ps sg.keys
  %  i=nat 0
     acc=hive hv
  ?  (eq i ps.len)
     acc
  =  pax ps.at(i)
  ?  ((is_io pax) || (is_log pax))
     (_ i.inc acc)
  ?  s.x_latest(pax)
   > (./known t=myth)
     =  ds (node_deps t)
     ?  (eq 0 ds.len)
        (_ i.inc acc.del(pax))
     (_ i.inc acc.put(pax ds))
   (_ i.inc acc.lop(pax))
+  eyes_from
  '  Turn the crew index around into the watcher index: each dep a
  '  node watches subscribes that node, as watcher, to the watched
  '  path.  Subscribers arrive in tap order, so the rows come out in
  '  the same order the full derivation built them.
  \  hv=hive
  ^  eyes
  =  es hv.tap
  %  i=nat 0
     acc=eyes (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  =  ds q
  =  acc2
       %  j=nat 0
          a2=eyes acc
       ?  (eq j ds.len)
          a2
       =  d ds.at(j)
       =  cur a2.gut(d.p [])
       (_ j.inc a2.put(d.p cur.snoc((dep d.c sub))))
  (_ i.inc acc2)
+  eyes_of
  '  Derive the namespace's subscriptions from every node's crew:
  '  each named dep subscribes its node (as watcher) to the watched
  '  path.  Persistent and declarative — the full derivation, kept
  '  as the reference semantics the incremental index reproduces.
  '  /io nodes are skipped (see /is_io), and so is /log on both
  '  sides: journal nodes subscribe to nothing and nothing may
  '  watch the journal (a /log eye would fire on every commit,
  '  burning the cascade's fuel forever).
  \  s=sov
  ^  eyes
  (eyes_from (hive_of s))
+  lens_from
  '  Project the derived (/o) deps out of the crew index, translated
  '  down to their real triggers (/o_trigger).  Real deps stay in
  '  /eyes; derived keys registered there never sign and stay cool
  '  forever.  Re-projected per round like /eyes_from, so
  '  translations heal as overlays and pins evolve.
  \  hv=hive s=sov
  ^  lens
  =  es hv.tap
  %  i=nat 0
     acc=lens (axal/new[row[[tc=care od=dep w=path]]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  =  ds q
  =  acc2
       %  j=nat 0
          a2=lens acc
       ?  (eq j ds.len)
          a2
       =  d ds.at(j)
       =  ts
            ?  (is_o d.p)
               (o_trigger d.p s)
            ?  (is_xv d.p)
               (xv_trigger d.p s)
            []
       ?  (eq 0 ts.len)
          (_ j.inc a2)
       =  a3
            %  k=nat 0
               a4=lens a2
            ?  (eq k ts.len)
               a4
            =  tg ts.at(k)
            =  cur a4.gut(tg.p [])
            (_ k.inc a4.put(tg.p cur.snoc([tg.c d sub])))
       (_ j.inc a3)
  (_ i.inc acc2)
+  react_lens
  '  Match one round's signs against the derived-watcher index: a
  '  lens eye fires when its trigger care's grade at its trigger
  '  path moved.  News comes out keyed by the DERIVED path with the
  '  subscriber's stated care; duplicate fires for one (dep, watcher)
  '  — a derived dep can own several triggers — collapse.
  \  signs=axal[sign] lz=lens
  ^  axal[row[dep]]
  =  es lz.tap
  %  i=nat 0
     nw=axal[row[dep]] (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     nw
  =  [p q] es.at(i)
  =  wat p
  ?  signs.get(wat)
   > .none  (_ i.inc nw)
   > (./some g=sign)
     =  nw2
          %  j=nat 0
             a2=axal[row[dep]] nw
          ?  (eq j q.len)
             a2
          =  e q.at(j)
          =  [tc od w]  e
          ?  !(fires tc g)
             (_ j.inc a2)
          =  cur a2.gut(od.p [])
          =  nd (dep od.c w)
          ?  cur.any((\ x (equal x nd)))
             (_ j.inc a2)
          (_ j.inc a2.put(od.p cur.snoc(nd)))
     (_ i.inc nw2)
+  grind_with
  '  The worm loop: pop and dispatch until the queue drains; a
  '  nonempty prize then raids and the loop resumes; when both are
  '  empty the fate seals — writes in tap (lte_pith) order, effects
  '  as accumulated, the ack riding through.
  \  fuel=nat dn=row[flue] ack=maybe[path] eny=nat s=sov
  ^  doom
  =  w0 (worm (axal/new[note] .none) dn 0 [] (axal/new[mode] .none) 0 eny)
  %  st=wend (./go w0) gas=nat fuel
  ^  doom
  ?  st
   > (./bad e=iota)  (./fail e)
   > (./go wm=worm)
     ?  (lt wm.dcur wm.down.len)
        ?  (eq 0 gas)
           (./fail 'grind_exhausted)
        =  f wm.down.at(wm.dcur)
        =  wm1 wm.set_dcur(wm.dcur.inc)
        (_ (dispatch f wm1 s) gas.dec)
     ?  wm.prize.wyt
        ?  (eq 0 gas)
           (./fail 'grind_exhausted)
        (_ (./go (raid wm s)) gas.dec)
     =  tl wm.toil
     (./done (fate tl.tap wm.up) ack)
+  grind
  '  Bound each event to 4096 dispatch/raid steps. Exhaustion rejects
  '  the whole event; no partial worm state reaches commit.
  \  dn=row[flue] ack=maybe[path] eny=nat s=sov
  ^  doom
  (grind_with 4096 dn ack eny s)
+  kernel
  '  One event against the committed state: a fate (acked with the
  '  command's path tag for vine events), or a failure.
  \  t=task eny=nat s=sov
  ^  doom
  ?  t
   > (./vine p=path w=writ)
     (grind [(vine_flue p w)] (./some p) eny s)
   > (./hear news=axal[row[dep]])
     =  subs (invert news)
     ?  (eq 0 subs.wyt)
        (./fail 'hear_no_subs)
     (grind (hear_flues subs) .none eny s)
+  brand_of
  '  The runtime nominal brand as text.  Reflection is confined to
  '  this boundary; nullary values are their own brand atoms.
  \ held=any
  ^ str
  = brand
      ? (rep_app held) (rep_hd held)
      | add held 0
  ^ str brand
+  curb_cord
  '  A type path in runtime brand spelling: /boot/pails/t.  This is
  '  a brand comparison, not the aura codec's external path spelling.
  \ p=path
  ^ str
  = parts
      | p.map
      \ segment
      ^ str
      ? (is_text segment)
        ^ str
        | quip_val segment
      | nat/show | quip_val segment
  ? (eq p.len 0) ""
  | str/cat (str/join "/" parts) "/"
+  curb_ok
  '  Does a slot value inhabit one of the curb's named types?  A
  '  curb is a union: any listed brand admits.
  \  cb=curb held=pail
  ^  bool
  =  b (brand_of held)
  cb.any((\ tp (eq b (curb_cord tp))))
+  lash_of
  '  The node's own shape contract, when its record carries one at
  '  ['sys 'lash] — enforcement is opt-in per node, and the contract
  '  is ordinary namespace state like everything else.
  \  t=myth
  ^  maybe[lash]
  ?  t.get(['sys 'lash])
   > .none  .none
   > (./some held=pail)
     ?  held
      > l=lash  (./some l)
     .none
+  fit_check
  '  One record judged against its own contract as stored: every
  '  present slot through the write curbs, every need group against
  '  the record — the standing-query predicate for finding legacy
  '  data a later-adopted contract disowns.
  \  t=myth
  ^  maybe[iota]
  ?  (lash_of t)
   > .none  .none
   > (./some l=lash)
     =  ws t.tap
     =  tybad
          %  i=nat 0
          ^  bool
          ?  (ge i ws.len)
             .false
          =  e ws.at(i)
          ?  l.write.get(e.key)
           > .none  (_ i.inc)
           > (./some cb=curb)
             ?  (curb_ok cb e.val)
                (_ i.inc)
             .true
     ?  tybad
        (./some 'curb_type)
     =  gs l.need
     %  i=nat 0
     ^  maybe[iota]
     ?  (ge i gs.len)
        .none
     =  g gs.at(i)
     ?  g.any((\ sl (myth/has_at sl t)))
        (_ i.inc)
     (./some 'curb_need)
+  guard_diffs
  '  Check normalized effective notes. Unchanged records need no check.
  '  Changing the contract itself adopts it over legacy data; other
  '  live changes must satisfy the final record's stored contract.
  \  diffs=axal[note] s=sov
  ^  maybe[iota]
  =  es diffs.tap
  %  i=nat 0
  ^  maybe[iota]
  ?  (ge i es.len)
     .none
  =  [p q] es.at(i)
  ?  ?=(.cull q)
     (_ i.inc)
  =  before=res[pin[myth]]
       ?  s.x_latest(p)
        > (./known t=myth)  (./known (pin t))
        > .null  .null
        > .unknown  .unknown
  >   (./known held) (note/write before q)
      (_ i.inc)
  =  final (unpin held)
  =  cur=maybe[myth]
       ?  before
        > (./known old)  (./some (unpin old))
        > .null  .none
        > .unknown  .none
  =  unchanged
       ?  cur
        > .none  .false
        > (./some old)  (equal old final)
  ?  unchanged
     (_ i.inc)
  =  adopt
       ?  final.get(['sys 'lash])
        > .none  .false
        > (./some nl=pail)
          >   (./some old) cur
              .true
          ?  old.get(['sys 'lash])
           > .none  .true
           > (./some ol=pail)  !(equal nl ol)
  ?  adopt
     (_ i.inc)
  ?  (fit_check final)
   > .none  (_ i.inc)
   > (./some why=iota)  (./some why)
+  commit
  '  Apply a fate's resolved notes to the sovereign. The
  '  namespace expands recursive culls, rejects live writes through
  '  unrevived tombstones, then melds and deduplicates resolved values.
  '  Shape contracts gate here too: a diff whose final record carries
  '  ['sys 'lash] must fit it after normalization, or the event rejects.
  '  The accepted event owns one internal epoch; every affected
  '  (path, care) mints at most one independent local case.  Apollo
  '  time and PKI blockheight are zeroed in this port — the runtime
  '  supplies them a layer out.
  '  When journal is set, a /log/<epoch> node carrying the driving
  '  task, its ack, and its effects rides the same diff set — the
  '  event and its journal entry are one epoch, indivisible.
  \  t=task a=maybe[path] journal=bool f=fate s=sov
  ^  verdict[[state=sov signs=axal[sign]]]
  =  raw (axal/gas[note] f.write (axal/new[note] .none))
  =  diffs
       ?  journal
          =  card (log_card t a f.effects)
          raw.put(['log (dig_show s.top.inc)]
                  (note/make (myth/sing ['ev] card)))
       raw
  =  eff (gate/prepare diffs s.top s.idx)
  ?  !(gate/valid eff s.top s.idx)
     (./rejected 'tombstoned_ancestor)
  ?  (guard_diffs eff s)
   > (./some why=iota)  (./rejected why)
   > .none  (./accepted s.apply(eff diffs 0 0))
+  run_event_with
  '  The full cycle: run the kernel and, on success, commit — the new
  '  sovereign, the outbound moves, and the step's change signs.  On
  '  failure the sovereign is untouched.  journal selects whether
  '  the commit also writes the /log entry.
  \  journal=bool t=task eny=nat s=sov
  ^  ovum
  ?  (kernel t eny s)
   > (./fail e=iota)  (./fail e)
   > (./done f=fate a=maybe[path])
     ?  (commit t a journal f s)
      > (./rejected e=iota)  (./fail e)
      > (./accepted r=[state=sov signs=axal[sign]])
        =  fx f.effects
        (./ripe state fx signs a)
+  run_event
  '  A journal-free event: seeding and probes — no /log entry.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with .false t eny s)
+  run_event_log
  '  A journaled event: the live loop — every accepted epoch leaves
  '  its /log node.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with .true t eny s)
+  cycle_with
  '  /cycle over a kept crew index: each round bumps the caller's
  '  index from its own signs instead of re-deriving it from the
  '  whole namespace, and the index rides back out for the next
  '  event.  A failed event returns the index untouched — nothing
  '  committed, so nothing moved.
  \  hv=hive t=task eny=nat fuel=nat s=sov
  ^  [g=gyre hv2=hive]
  ?  (run_event_log t eny s)
   > (./fail e=iota)  [(./fail e) hv]
   > (./ripe s1=sov fx1=row[move] sg1=axal[sign] a=maybe[path])
     %  cur=sov s1
        prev=sov s
        moves=row[move] fx1
        rounds=row[axal[sign]] [sg1]
        sg=axal[sign] sg1
        gas=nat fuel
        hz=hive (hive_bump hv sg1 s1)
     ^  [g=gyre hv2=hive]
     =  [news rest] (react sg (eyes_from hz))
     '  Lens deps translate against the PRE-round sov: the round's
     '  signs graded that state, and an /o answer's first change
     '  (an unminted pin minting) must wake its watcher.
     =  lt (react_lens sg (lens_from hz prev)).tap
     =  nws
          %  i2=nat 0
             acc=axal[row[dep]] news
          ?  (eq i2 lt.len)
             acc
          =  [p q] lt.at(i2)
          (_ i2.inc acc.put(p q))
     ?  (eq 0 nws.wyt)
        [(./spun cur moves rounds a .none) hz]
     ?  (eq 0 gas)
        [(./spun cur moves rounds a (./some 'cycle_exhausted)) hz]
     ?  (run_event_log (./hear nws) eny cur)
      > (./fail e2=iota)  [(./spun cur moves rounds a (./some e2)) hz]
      > (./ripe s2=sov fx2=row[move] sg2=axal[sign] a2=maybe[path])
        =  m2 moves.weld(fx2)
        =  r2 rounds.snoc(sg2)
        (_ s2 cur m2 r2 sg2 gas.dec (hive_bump hz sg2 s2))
+  cycle
  '  Run one external event, then let the namespace react to itself:
  '  derive the eyes from every crew, match the signs, and feed the
  '  news back as hear events until quiet — or until fuel runs out
  '  (apps may legally self-loop; the cap bounds them).  A failed
  '  hear round stops the cascade, keeping the rounds that committed.
  '  Every accepted round journals: one /log node per epoch.
  '  The index is derived here and dropped; a driver that runs many
  '  events keeps one across them with /cycle_with.
  \  t=task eny=nat fuel=nat s=sov
  ^  gyre
  =  [g=gyre hv2=hive]  (cycle_with (hive_of s) t eny fuel s)
  g
