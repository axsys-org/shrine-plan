-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=31]
-  lain_peek [order=32]
'  Namespace transitions: dispatch behaviors into a transaction, validate
'  and commit its writes, then schedule reactions from the resulting signs.
'  The sovereign is immutable until commit; rejected events leave it intact.
+  note_mode
  \  w=note
  ^  mode
  ?  w
   > (./make t=myth)  .add
   > (./poke t=myth)  .dif
   > .cull  .del
+  mode_then
  '  Compose a later change kind onto an earlier one at the same path.
  \  old=maybe[mode] new=mode
  ^  mode
  ?  old
   > .none  new
   > (./some m=mode)
     ?  m
      > .add
        ?  new
         > .del  .del
         > .add  .add
         > .dif  .add
      > .del
        ?  new
         > .add  .add
         > .del  .del
         > .dif  .del
      > .dif  new
+  note_then
  '  Compose a later note onto a pending one at the same path, so the
  '  transaction holds at most one note per path.
  \  old=maybe[note] new=note
  ^  note
  ?  old
   > .none  new
   > (./some ow=note)
     ?  new
      > (./make t=myth)  new
      > .cull  new
      > (./poke t=myth)
        ?  ow
         > (./make ot=myth)
           =  m ot.meld(t)
           (./make m)
         > (./poke ot=myth)
           =  m ot.meld(t)
           (./poke m)
         > .cull  (./make t)
+ dispatch_reader
  ' Transaction reads and write authority travel together through dispatch.
  : exact={\ path worm}maybe[myth]
    children={\ care path worm}axal[myth]
    hydrate={\ maybe[myth] worm}mop[path axal[myth] lt_pith]
    permit={\ path}bool
+ sovereign_access
  \ state=namespace
  ^ dispatch_reader
  | dispatch_reader
    (\ target transaction (sovereign_read .x target transaction state).fil)
    (\ car target transaction (sovereign_read car target transaction state))
    (\ record transaction (sovereign_crew_of record state))
    (\ target state.permitted(target))
+  resolve_access
  '  Resolve a myth's kook slot against the NAMESPACE: each ref is a
  '  path read directly — its node's ['sys 'form] slot holds the form
  '  (forms are nominal rows, so they ride as pails).  The registry
  '  is namespace state — making or poking a form node installs and
  '  upgrades behaviors live, at any path, and resolution sees this
  '  event's in-flight writes.  The behavior list defaults when the
  '  kook slot is absent or empty; anything non-kook in the slot, or
  '  non-form at a ref, fails.
  \  t=myth wm=worm access=dispatch_reader
  ^  kres
  = exact access.exact
  =  ks limb_slot
  ?  t.get(ks)
   > .none  (./kf [def_form])
   > (./some pl=pail)
     ?  pl
      > k=kook
        =  refs k.refs
        ?  (eq 0 refs.len)
           (./kf [def_form])
        %  i=nat 0
           acc=row[form] []
        ^  kres
        ?  (eq i refs.len)
           (./kf acc)
        ?  (exact refs.at(i) wm)
         > .none  (./ke 'kook_unknown)
         > (./some kt=myth)
           ?  kt.get(['sys 'form])
            > .none  (./ke 'kook_unknown)
            > (./some fp=pail)
              ?  fp
               > f=form  (_ i.inc acc.snoc(f))
              (./ke 'kook_bad)
     (./ke 'kook_bad)
+  record
  '  Compose a resolved note into the transaction: one note
  '  per path, prize the composed change kind.
  \  pax=path w=note wm=worm
  ^  worm
  =  tl wm.toil
  =  w2 (note_then tl.get(pax) w)
  =  pz wm.prize
  =  m2 (mode_then pz.get(pax) (note_mode w))
  =  wm1 wm.set_toil(tl.put(pax w2))
  wm1.set_prize(pz.put(pax m2))
+  ingest
  '  Route one activation's cards from node src: same-authority
  '  targets join this transaction's queue; everything else
  '  leaves as an outbound move carrying the one command.
  \  src=path cs=row[[p=path q=writ]] wm=worm
  ^  worm
  %  i=nat 0
     acc=worm wm
  ?  (eq i cs.len)
     acc
  =  [p q] cs.at(i)
  = local
      ? (pith_prefix src p) .true
      ? (and (gt src.len 0) (gt p.len 0))
        | eq_iota src.at(0) p.at(0)
      .false
  ?  local
     =  dn acc.down
     (_ i.inc acc.set_down(dn.snoc((flue src p (./vine q)))))
  =  uu acc.up
  (_ i.inc acc.set_up(uu.snoc((move src p q))))
+  thread_forms
  '  Run a behavior chain in order.  Each arm sees the preceding
  '  arm's state; cards retain the order in which the arms emitted them.
  \ fs=row[form] cur=myth apply={\ form myth}yell
  ^ [cards=row[[p=path q=writ]] out=myth]
  = done
      | fs.fold (yell [] cur)
      \ acc f
      = next | apply f acc.out
      | yell acc.cards.weld(next.cards) next.out
  [done.cards done.out]
+  thread_init
  '  Initialize through the complete behavior chain.
  \ b=bowl fs=row[form] cur=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = init f.init
  | init b state
+  thread_talk
  '  The input stays fixed while the current record moves through talk.
  \ b=bowl fs=row[form] cur=myth add=myth
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = talk f.talk
  | talk b state add
+  thread_take
  \ b=bowl fs=row[form] cur=myth gift=axal[mode]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = take f.take
  | take b state gift
+  thread_hear
  \ b=bowl fs=row[form] cur=myth rely=row[dep]
  ^ [cards=row[[p=path q=writ]] out=myth]
  | thread_forms fs cur
  \ f state
  = hear f.hear
  | hear b state rely
+  initialize_access
  '  A make or resolved warp follows one initialization path. Resolve
  '  the replacement's behaviors, thread init, then record and ingest.
  \  b=bowl t=myth wm=worm access=dispatch_reader
  ^  wend
  ?  t.get(limb_slot)
   > .none  (./go (record b.here (./make t) wm))
   > (./some _)
     ?  (resolve_access t wm access)
      > (./ke e=iota)  (./bad e)
      > (./kf fs=row[form])
        =  [cards out] (thread_init b fs t)
        =  next (record b.here (./make out) wm)
        (./go (ingest b.here cards next))
+  dispatch_access
  '  Run one work unit against the transaction.  The /h and /o
  '  overlays are read-only, and /log is commit-owned: any write
  '  landing on any of them fails the whole event.
  \  f=flue wm=worm access=dispatch_reader
  ^  wend
  = exact access.exact
    children access.children
    hydrate access.hydrate
  = permit access.permit
  ? !(permit f.dst)
    | ./bad 'write_outside_authority
  ?  (is_h f.dst)
     (./bad 'h_reserved)
  ?  (is_o f.dst)
     (./bad 'o_reserved)
  ?  (is_xv f.dst)
     (./bad 'x_reserved)
  =  wm1 wm.set_now(wm.now.inc)
  =  kk (children .y f.dst wm1)
  =  cw (hydrate (exact f.dst wm1) wm1)
  =  b (bowl f.src f.dst wm1.now wm1.eny kk cw)
  =  dst f.dst
  ?  f.job
   > (./take g=axal[mode])
     ?  (exact dst wm1)
      > .none  (./bad 'take_missing)
      > (./some cur=myth)
        '  An absent kook slot resolves to [def_form]; def_take emits no
        '  cards and keeps cur (the seeding/cascade hot path).
        '  A no-op take records an empty poke: melding
        '  nothing leaves local cases unchanged, just like a
        '  cur-verbatim poke, while the raw journal stores only
        '  the empty delta rather than the whole record.
        ?  cur.get(limb_slot)
         > .none  (./go (record dst (./poke myth/new) wm1))
         > (./some _)
           ?  (resolve_access cur wm1 access)
            > (./ke e=iota)  (./bad e)
            > (./kf fs=row[form])
              =  [cards out] (thread_take b fs cur g)
              =  wm2
                   ?  (equal out cur)
                      (record dst (./poke myth/new) wm1)
                   (record dst (./poke out) wm1)
              (./go (ingest dst cards wm2))
   > (./hear rr=row[dep])
     ?  (exact dst wm1)
      > .none  (./bad 'hear_missing)
      > (./some cur=myth)
        ?  (resolve_access cur wm1 access)
         > (./ke e=iota)  (./bad e)
         > (./kf fs=row[form])
           =  [cards out] (thread_hear b fs cur rr)
           =  wm2 (record dst (./poke out) wm1)
           (./go (ingest dst cards wm2))
   > (./vine w=writ)
     ?  w
      > .cull
        (./go (record dst .cull wm1))
      > (./warp op=path input=myth)
        '  poke-with-an-overlay: resolve the op card, apply
        '  (fn input cur) — a MISSING dst applies against the empty
        '  record (make-with-overlay-if-absent) — and process the
        '  result exactly like a make: a kook-less result records
        '  verbatim as a REPLACE; /initialize resolves a kooked
        '  result, threads init, and ingests its cards in this event.
        '  The input never lands in the namespace; the gate judges
        '  the final record like any write.
        =  cur0
             ?  (exact dst wm1)
              > .none  myth/new
              > (./some c=myth)  c
        ?  (exact op wm1)
         > .none  (./bad 'warp_op_unknown)
         > (./some ot=myth)
           ?  ot.get(['sys 'op])
            > .none  (./bad 'warp_op_bad)
            > (./some held)
              ?  held
               > o=op
                 =  f  o.fn
                 =  t (f input cur0)
                 (initialize_access b t wm1 access)
              (./bad 'warp_op_bad)
      > (./make t=myth)
        (initialize_access b t wm1 access)
      > (./poke t=myth)
        ?  (exact dst wm1)
         > .none  (./bad 'poke_missing)
         > (./some cur=myth)
           =  u cur.meld(t)
           '  def_talk is the same meld: a kook-less poke records u
           '  without resolving or invoking behaviors.
           ?  u.get(limb_slot)
            > .none  (./go (record dst (./poke u) wm1))
            > (./some _)
              ?  (resolve_access u wm1 access)
               > (./ke e=iota)  (./bad e)
               > (./kf fs=row[form])
                 =  [cards out] (thread_talk b fs cur t)
                 =  wm2 (record dst (./poke out) wm1)
                 (./go (ingest dst cards wm2))
+  raid_access
  '  The gift cascade.  Each prized path is grouped under its nearest
  '  existing strict ancestor (existence is the in-flight view; the
  '  root contributes nothing), and one take per parent joins the
  '  queue, carrying the changed paths relative to that parent.  Take
  '  results are poke writes, so the prize repopulates strictly
  '  upward until it drains at the top.
  \  wm=worm access=dispatch_reader
  ^  worm
  = exact access.exact
  =  pz wm.prize
  =  es pz.tap
  =  gam
       %  i=nat 0
          acc=axal[axal[mode]] (axal/new[axal[mode]] .none)
       ?  (eq i es.len)
          acc
       =  [p q] es.at(i)
       ?  (le p.len 1)
          (_ i.inc acc)
       =  par
            %  k=nat p.len.dec
            ^  maybe[path]
            ?  (eq k 0)
               .none
            =  pre p.take(k)
            ?  (maybe/is_some (exact pre wm))
               (./some pre)
            (_ k.dec)
       ?  par
        > .none  (_ i.inc acc)
        > (./some pp=path)
          =  g0 acc.gut(pp (axal/new[mode] .none))
          =  rel p.drop(pp.len)
          =  g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  gs gam.tap
  =  wm1
       %  i=nat 0
          acc=worm wm
       ?  (eq i gs.len)
          acc
       =  [p q] gs.at(i)
       =  dn acc.down
       (_ i.inc acc.set_down(dn.snoc((flue p p (./take q)))))
  wm1.set_prize((axal/new[mode] .none))
+  vine_flue
  '  One command becomes one work unit rooted at /out.
  \  p=path w=writ
  ^  flue
  (flue ['out] p (./vine w))
+  invert
  '  Turn news (changed path -> cared subscribers) into subscriber ->
  '  cared changed paths. Dispatch validates each subscriber's authority.
  \  news=axal[row[dep]]
  ^  axal[row[dep]]
  =  es news.tap
  %  i=nat 0
     acc=axal[row[dep]] (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  chg p
  =  acc2
       %  j=nat 0
          a2=axal[row[dep]] acc
       ?  (eq j q.len)
          a2
       =  e q.at(j)
       =  sub e.p
       =  cur a2.gut(sub [])
       (_ j.inc a2.put(sub cur.snoc((dep e.c chg))))
  (_ i.inc acc2)
+  hear_flues
  \  subs=axal[row[dep]]
  ^  row[flue]
  =  es subs.tap
  %  i=nat 0
     acc=row[flue] []
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  (_ i.inc acc.snoc((flue p p (./hear q))))
+  fires
  '  The grade a sign gives one care: nonzero means that care's
  '  perspective of the path moved.
  \  c=care g=sign
  ^  nat
  ?  c
   > .x  g.x
   > .y  g.y
   > .z  g.z
+  react
  '  The reactivity machine: match one event's change signs against
  '  the watcher index.  A watcher fires when its care's grade at
  '  its watched path is nonzero; fired subscriptions are consumed
  '  (lazy reactivity: one notification, watchers re-arm by reading)
  '  and unfired ones survive.  Returns the kernel's news — feed it
  '  back as a (./hear news) task — and the updated index.  The
  '  driver's cycle is run_event -> react on the ripe signs -> hear.
  \  signs=axal[sign] ey=eyes
  ^  [news=axal[row[dep]] rest=eyes]
  =  es ey.tap
  %  i=nat 0
     nw=axal[row[dep]] (axal/new[row[dep]] .none)
     rs=eyes (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     [nw rs]
  =  [p q] es.at(i)
  =  wat p
  ?  signs.get(wat)
   > .none  (_ i.inc nw rs.put(wat q))
   > (./some g=sign)
     =  [hot cool]
          %  j=nat 0
             hot=row[dep] []
             cool=row[dep] []
          ^  [hot=row[dep] cool=row[dep]]
          ?  (eq j q.len)
             [hot cool]
          =  e q.at(j)
          ?  (fires e.c g)
             (_ j.inc hot.snoc(e) cool)
          (_ j.inc hot cool.snoc(e))
     =  nw2
          ?  (eq 0 hot.len)
             nw
          nw.put(wat hot)
     =  rs2
          ?  (eq 0 cool.len)
             rs
          rs.put(wat cool)
     (_ i.inc nw2 rs2)
+  node_deps
  '  Dependencies declared by a record. Namespace policy filters the
  '  local journal and driver facilities when constructing its indexes.
  \  t=myth
  ^  row[dep]
  ?  t.get(crew_slot)
   > .none  []
   > (./some pl=pail)
     ?  pl
      > c2=cpail
        =  ds c2.crew.tap
        %  j=nat 0
           acc=row[dep] []
        ?  (eq j ds.len)
           acc
        =  e ds.at(j)
        =  d e.val
        (_ j.inc acc.snoc(d))
     []
+ sovereign_observer
  \ target=path state=namespace
  ^ bool
  ? !(state.permitted(target)) .false
  | !(pith_prefix [state.self 'io] target)
+ sovereign_dependencies
  \ record=myth state=namespace
  ^ row[dep]
  | (node_deps record).filter
    \ dependency
    | !(pith_prefix [state.self 'log] dependency.p)
+ sovereign_hive
  \ state=namespace
  ^ hive
  | (sovereign_peek [state.self] state).tap.fold
    (axal/new[row[dep]] .none)
    \ index [relative record]
    = target | row/weld relative [state.self]
    ? !(sovereign_observer target state) index
    = dependencies | sovereign_dependencies record state
    ? (eq dependencies.len 0) index
    | index.put target dependencies
+ sovereign_hive_bump
  \ index=hive signs=axal[sign] state=namespace
  ^ hive
  | signs.keys.fold index
    \ out target
    ? !(sovereign_observer target state) out
    = records | sovereign_care .x target state
    ?> (./some record) records.fil out.lop(target)
    = dependencies | sovereign_dependencies record state
    ? (eq dependencies.len 0) out.del(target)
    | out.put target dependencies
+  eyes_from
  '  Turn the crew index around into the watcher index: each dep a
  '  node watches subscribes that node, as watcher, to the watched
  '  path.  Subscribers arrive in tap order, so the rows come out in
  '  the same order the full derivation built them.
  \  hv=hive
  ^  eyes
  =  es hv.tap
  %  i=nat 0
     acc=eyes (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  =  ds q
  =  acc2
       %  j=nat 0
          a2=eyes acc
       ?  (eq j ds.len)
          a2
       =  d ds.at(j)
       =  cur a2.gut(d.p [])
       (_ j.inc a2.put(d.p cur.snoc((dep d.c sub))))
  (_ i.inc acc2)
+  lens_from_reader
  '  Project the derived (/o) deps out of the crew index, translated
  '  down to their real triggers (/o_trigger).  Real deps stay in
  '  /eyes; derived keys registered there never sign and stay cool
  '  forever.  Re-projected per round like /eyes_from, so
  '  translations heal as overlays and pins evolve.
  \  hv=hive reader=namespace_reader
  ^  lens
  =  es hv.tap
  %  i=nat 0
     acc=lens (axal/new[row[[tc=care od=dep w=path]]] .none)
  ?  (eq i es.len)
     acc
  =  [p q] es.at(i)
  =  sub p
  =  ds q
  =  acc2
       %  j=nat 0
          a2=lens acc
       ?  (eq j ds.len)
          a2
       =  d ds.at(j)
       =  ts
            ?  (is_h_version d.p)
               (h_version_triggers d.p)
            ?  (is_o d.p)
               (o_trigger_reader d.p reader)
            ?  (is_xv d.p)
               (xv_trigger_reader d.p reader)
            []
       ?  (eq 0 ts.len)
          (_ j.inc a2)
       =  a3
            %  k=nat 0
               a4=lens a2
            ?  (eq k ts.len)
               a4
            =  tg ts.at(k)
            =  cur a4.gut(tg.p [])
            (_ k.inc a4.put(tg.p cur.snoc([tg.c d sub])))
       (_ j.inc a3)
  (_ i.inc acc2)
+  react_lens
  '  Match one round's signs against the derived-watcher index: a
  '  lens eye fires when its trigger care's grade at its trigger
  '  path moved.  News comes out keyed by the DERIVED path with the
  '  subscriber's stated care; duplicate fires for one (dep, watcher)
  '  — a derived dep can own several triggers — collapse.
  \  signs=axal[sign] lz=lens
  ^  axal[row[dep]]
  =  es lz.tap
  %  i=nat 0
     nw=axal[row[dep]] (axal/new[row[dep]] .none)
  ?  (eq i es.len)
     nw
  =  [p q] es.at(i)
  =  wat p
  ?  signs.get(wat)
   > .none  (_ i.inc nw)
   > (./some g=sign)
     =  nw2
          %  j=nat 0
             a2=axal[row[dep]] nw
          ?  (eq j q.len)
             a2
          =  e q.at(j)
          =  [tc od w]  e
          ?  !(fires tc g)
             (_ j.inc a2)
          =  cur a2.gut(od.p [])
          =  nd (dep od.c w)
          ?  cur.any((\ x (equal x nd)))
             (_ j.inc a2)
          (_ j.inc a2.put(od.p cur.snoc(nd)))
     (_ i.inc nw2)
+  grind_with_access
  '  The worm loop: pop and dispatch until the queue drains; a
  '  nonempty prize then raids and the loop resumes; when both are
  '  empty the fate seals — writes in tap (lte_pith) order, effects
  '  as accumulated, the ack riding through.
  \  fuel=nat dn=row[flue] ack=maybe[path] eny=nat access=dispatch_reader
  ^  doom
  =  w0 (worm (axal/new[note] .none) dn 0 [] (axal/new[mode] .none) 0 eny)
  %  st=wend (./go w0) gas=nat fuel
  ^  doom
  ?  st
   > (./bad e=iota)  (./fail e)
   > (./go wm=worm)
     ?  (lt wm.dcur wm.down.len)
        ?  (eq 0 gas)
           (./fail 'grind_exhausted)
        =  f wm.down.at(wm.dcur)
        =  wm1 wm.set_dcur(wm.dcur.inc)
        (_ (dispatch_access f wm1 access) gas.dec)
     ?  wm.prize.wyt
        ?  (eq 0 gas)
           (./fail 'grind_exhausted)
        (_ (./go (raid_access wm access)) gas.dec)
     =  tl wm.toil
     (./done (fate tl.tap wm.up) ack)
+ sovereign_kernel
  \ command=task entropy=nat state=namespace
  ^ doom
  = access | sovereign_access state
  ? command
   > (./vine target change)
     ? !(state.permitted(target)) (./fail 'write_outside_authority)
     | grind_with_access 4096 [(vine_flue target change)]
         (./some target) entropy access
   > (./hear news)
     = subscribers | invert news
     ? (eq subscribers.wyt 0) (./fail 'hear_no_subs)
     | grind_with_access 4096 (hear_flues subscribers) .none entropy access
+ sovereign_event
  & sovereign_event/ripe sovereign_event/fail
  + ripe
    : state=namespace effects=row[move] signs=axal[sign] ack=maybe[path]
  + fail
    : why=iota
+ sovereign_run_event
  ' Ownership gates dispatch and all final diffs. Failed events expose
  ' neither writes nor effects. The namespace commit journals its system pin.
  \ command=task entropy=nat now=nat block=nat state=namespace
  ^ sovereign_event
  ? (sovereign_kernel command entropy state)
   > (./fail why) (./fail why)
   > (./done result ack)
     = diffs | axal/gas[note] result.write (axal/new[note] .none)
     ? !(diffs.tap.all((\ [target change] state.permitted(target))))
       | ./fail 'write_outside_authority
     = effective | gate/prepare diffs state.local.top state.local.idx
     ? !(effective.tap.all((\ [target change] state.permitted(target))))
       | ./fail 'write_outside_authority
     ? (guard_diffs effective state.local)
      > (./some why) (./fail why)
      > .none
        ? (namespace/step diffs now block state)
         > (./rejected why) (./fail why)
         > (./accepted committed)
           | ./ripe committed.state result.effects committed.signs ack
+  brand_of
  '  The runtime nominal brand as text.  Reflection is confined to
  '  this boundary; nullary values are their own brand atoms.
  \ held=any
  ^ str
  = brand
      ? (rep_app held) (rep_hd held)
      | add held 0
  ^ str brand
+  curb_ok
  ' A contract admits only the defining moment it names.
  \ cb=curb held=pail
  ^ bool
  | cb.any
    \ reference=definition_reference
    | reference.matches held
+  lash_of
  '  The node's own shape contract, when its record carries one at
  '  ['sys 'lash] — enforcement is opt-in per node, and the contract
  '  is ordinary namespace state like everything else.
  \  t=myth
  ^  maybe[lash]
  ?  t.get(['sys 'lash])
   > .none  .none
   > (./some held=pail)
     ?  held
      > l=lash  (./some l)
     .none
+  fit_check
  '  One record judged against its own contract as stored: every
  '  present slot through the write curbs, every need group against
  '  the record — the standing-query predicate for finding legacy
  '  data a later-adopted contract disowns.
  \  t=myth
  ^  maybe[iota]
  ?  (lash_of t)
   > .none  .none
   > (./some l=lash)
     =  ws t.tap
     =  tybad
          %  i=nat 0
          ^  bool
          ?  (ge i ws.len)
             .false
          =  e ws.at(i)
          ?  l.write.get(e.key)
           > .none  (_ i.inc)
           > (./some cb=curb)
             ?  (curb_ok cb e.val)
                (_ i.inc)
             .true
     ?  tybad
        (./some 'curb_type)
     =  gs l.need
     %  i=nat 0
     ^  maybe[iota]
     ?  (ge i gs.len)
        .none
     =  g gs.at(i)
     ?  g.any((\ sl (myth/has_at sl t)))
        (_ i.inc)
     (./some 'curb_need)
+  guard_diffs
  '  Check normalized effective notes. Unchanged records need no check.
  '  Changing the contract itself adopts it over legacy data; other
  '  live changes must satisfy the final record's stored contract.
  \  diffs=axal[note] s=sov
  ^  maybe[iota]
  =  es diffs.tap
  %  i=nat 0
  ^  maybe[iota]
  ?  (ge i es.len)
     .none
  =  [p q] es.at(i)
  ?  ?=(.cull q)
     (_ i.inc)
  =  before=res[pin[myth]]
       ?  s.x_latest(p)
        > (./known t=myth)  (./known (pin t))
        > .null  .null
        > .unknown  .unknown
  >   (./known held) (note/write before q)
      (_ i.inc)
  =  final (unpin held)
  =  cur=maybe[myth]
       ?  before
        > (./known old)  (./some (unpin old))
        > .null  .none
        > .unknown  .none
  =  unchanged
       ?  cur
        > .none  .false
        > (./some old)  (equal old final)
  ?  unchanged
     (_ i.inc)
  =  adopt
       ?  final.get(['sys 'lash])
        > .none  .false
        > (./some nl=pail)
          >   (./some old) cur
              .true
          ?  old.get(['sys 'lash])
           > .none  .true
           > (./some ol=pail)  !(equal nl ol)
  ?  adopt
     (_ i.inc)
  ?  (fit_check final)
   > .none  (_ i.inc)
   > (./some why=iota)  (./some why)
+ sovereign_gyre
  & sovereign_gyre/spun sovereign_gyre/fail
  + spun
    : state=namespace moves=row[move] rounds=row[axal[sign]] ack=maybe[path] spill=maybe[iota]
  + fail
    : why=iota
+ sovereign_cycle_with
  '  /cycle over a kept crew index: each round bumps the caller's
  '  index from its own signs instead of re-deriving it from the
  '  whole namespace, and the index rides back out for the next
  '  event.  A failed event returns the index untouched — nothing
  '  committed, so nothing moved.
  \  hv=hive t=task eny=nat fuel=nat now=nat block=nat s=namespace
  ^  [g=sovereign_gyre hv2=hive]
  ?  (sovereign_run_event t eny now block s)
   > (./fail e=iota)  [(./fail e) hv]
   > (./ripe s1=namespace fx1=row[move] sg1=axal[sign] a=maybe[path])
     %  cur=namespace s1
        prev=namespace s
        moves=row[move] fx1
        rounds=row[axal[sign]] [sg1]
        sg=axal[sign] sg1
        gas=nat fuel
        hz=hive (sovereign_hive_bump hv sg1 s1)
     ^  [g=sovereign_gyre hv2=hive]
     =  [news rest] (react sg (eyes_from hz))
     '  Lens deps translate against the pre-round namespace: the round's
     '  signs graded that state, and an /o answer's first change
     '  (an unminted pin minting) must wake its watcher.
     =  lt (react_lens sg (lens_from_reader hz (sovereign_reader prev))).tap
     =  nws
          %  i2=nat 0
             acc=axal[row[dep]] news
          ?  (eq i2 lt.len)
             acc
          =  [p q] lt.at(i2)
          (_ i2.inc acc.put(p q))
     ?  (eq 0 nws.wyt)
        [(./spun cur moves rounds a .none) hz]
     ?  (eq 0 gas)
        [(./spun cur moves rounds a (./some 'cycle_exhausted)) hz]
     ?  (sovereign_run_event (./hear nws) eny now block cur)
      > (./fail e2=iota)  [(./spun cur moves rounds a (./some e2)) hz]
      > (./ripe s2=namespace fx2=row[move] sg2=axal[sign] a2=maybe[path])
        =  m2 moves.weld(fx2)
        =  r2 rounds.snoc(sg2)
        (_ s2 cur m2 r2 sg2 gas.dec (sovereign_hive_bump hz sg2 s2))
