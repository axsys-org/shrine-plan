- grove_role_runtime
- weft
- show
- value_read
- grove_backend
- grove_template
' Typed values and namespace formatting for Grove's rendering declarations.
' The input carrier contains data, not a browser document or an IO capability.
+ grove_html
  weft/node/el
  + read
    \ value=pail
    ^ maybe[grove_html]
    > node=weft/node/el value
      .none
    | ./some node
  + write
    \ value=grove_html
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ weft/node/el)

+ grove_fragment
  + result
    \ node=weft/node/el
    ^ axal[myth]
    | axal/new[myth] (./some ((myth/new).put(['html] node)))
  + render
    ' Call the actual published sewn value; no renderer-name switch/fallback.
    \ component=myth input=myth
    ^ maybe[weft/node/el]
    < held component.get(['sys 'weft])
    > transform=spun held
      .none
    = output (transform.get (myth/new) (axal/new[myth] (./some input)))
    < record output.fil
    < html record.get(['html])
    | grove_html/read html

+ grove_record
  ' An explicit typed carrier, not reflection of a record's printed value.
  : data=myth
  + read
    \ value=pail
    ^ maybe[grove_record]
    > record=grove_record value
      .none
    | ./some record
  + write
    \ value=grove_record
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ grove_record)
