- grove_role_runtime
- weft
- show
- value_read
- grove_backend
- grove_template
' Typed values and namespace formatting for Grove's rendering declarations.
' The input carrier contains data, not a browser document or an IO capability.
+ grove_html
  weft/node/el
  + read
    \ value=pail
    ^ maybe[grove_html]
    > node=weft/node/el value
      .none
    | ./some node
  + write
    \ value=grove_html
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ weft/node/el)

+ grove_fragment
  + result
    \ node=weft/node/el
    ^ axal[myth]
    | axal/new[myth] (./some ((myth/new).put(['html] node)))
  + render
    ' Call the actual published sewn value; no renderer-name switch/fallback.
    \ component=myth input=myth
    ^ maybe[weft/node/el]
    < held component.get(['sys 'weft])
    > transform=spun held
      .none
    = output (transform.get (myth/new) (axal/new[myth] (./some input)))
    < record output.fil
    < html record.get(['html])
    | grove_html/read html

+ grove_record
  ' An explicit typed carrier, not reflection of a record's printed value.
  : data=myth
  + read
    \ value=pail
    ^ maybe[grove_record]
    > record=grove_record value
      .none
    | ./some record
  + write
    \ value=grove_record
    ^ pail
    value
  + contract
    ^ curb
    | curb/of_type (^ grove_record)

' A finite, explicitly selected tree; this is not a namespace read capability.
+ grove_tree
  : data=axal[myth]

' Fine correspondence is data emitted alongside a presentation. A selector is
' a nominal native value (coordinate, range, AST position, etc.), never browser
' code or an expression interpreted by the transport.
+ grove_focus
  : source=safe slot=path selector=maybe[pail]
+ grove_occurrence
  : key=path focus=grove_focus action=maybe[path] source=rex/source_span
    description=str
+ grove_observed
  : dependency=dep basis=maybe[nat] value=res[axal[myth]]
+ grove_surface_context
  : subject=path inputs=row[grove_observed] viewport=myth implementation=safe
    writes=row[grove_slot_scope]
+ grove_surface_output
  : html=grove_html occurrences=row[grove_occurrence] families=row[path]
+ grove_slot_scope
  ' Exact subject and exact writable slots. A presentation is not a grant.
  : target=path slots=row[path]
+ grove_record_edit
  : target=path before=maybe[myth] after=maybe[myth]
+ grove_change_plan
  : edits=row[grove_record_edit] checks=row[either[str unit]]
+ grove_surface_program
  ' Ordinary compiled Foil values. Repeated correspondence is resolved lazily
  ' against precisely the same explicit inputs as rendering and action prep.
  : render={\ grove_surface_context}either[str grove_surface_output]
    resolve={\ grove_surface_context path myth}either[str grove_occurrence]
    prepare={\ grove_surface_context grove_occurrence myth}either[str grove_change_plan]
+ grove_surface_binding
  ' Installed by the owner, outside model-supplied event arguments. Code edits
  ' cannot widen the instance's independent writable-slot policy.
  : implementation=safe reads=row[dep] writes=row[grove_slot_scope]

' Physical input samples. The browser reports positions; native code decides
' whether these mean painting, selecting, moving, or something else.
+ grove_pointer_sample
  : x=nat y=nat
+ grove_pointer_samples
  : values=row[grove_pointer_sample]
