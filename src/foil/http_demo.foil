-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  helm [order=80]
-  http [order=70]
-  helm_http [order=82]
'  A small browser interface for the current kernel and typed HTTP driver.
'  The counter lives in the namespace; connection actors own no app state.
+  http_demo
  +  counter
    ^ path
    ['data 'counter]
  +  req
    \ method=nat url=nat body=nat target=path
    ^ myth
    = deps | crew/sing ['counter] (| dep .x http_demo/counter)
    (myth/new).put(['method] (| pd method)).put(['url] (| pd url)).put(crew_slot (| cpail deps))
  +  page
    \ count=nat
    ^ nat
    | cord/cat_all ["<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>Foil / Counter</title><style>body{margin:0;background:#f5f3ed;color:#252a27;font:18px system-ui}main{max-width:640px;margin:12vh auto;padding:32px}small{letter-spacing:.12em;text-transform:uppercase;color:#58645a}h1{font-size:48px;letter-spacing:-.04em}output{display:block;font-size:100px;margin:24px 0}button{background:#234a39;color:white;border:0;border-radius:8px;padding:16px 24px;font:inherit;cursor:pointer}code{font-size:15px}p{line-height:1.6;color:#58645a}</style>"
      "<main><small>Foil / Helm / HTTP</small><h1>A little shared state.</h1><p>This value lives at <code>/data/counter</code>. The form submits a request through Helm and commits a namespace change.</p><output>"
      (| dig_cord count)
      "</output><form method='post' action='/increment'><button type='submit'>Increment counter</button></form><p><a href='/'>Read current state</a></p></main></html>"]
  +  respond
    \ b=bowl cur=myth add=myth
    ^ yell
    = t cur.meld(add)
      view b.crew.gut(['counter] (| axal/new[myth] .none))
      count=nat
        ? view.fil
         > (./some record) record.nat_at(['count] 0)
        0
      method t.nat_at(['method] 0)
      url t.nat_at(['url] 0)
      good=bool
        ? (| eq method "GET") (| eq url "/")
        .false
      status=nat
        ? good 200
        404
      body=nat
        ? good (| http_demo/page count)
        "Not found"
      done t.put(['res_status] (| pd status)).put(['res_body] (| pd body)).put(['res_ctype] (| pd "text/html; charset=utf-8"))
    | yell [] done
  +  responder
    ^ form
    def_form.set_talk(http_demo/respond)
  +  increment
    \ b=bowl cur=myth add=myth
    ^ yell
    | yell [] cur.put(['count] (| pd cur.nat_at(['count] 0).inc))
  +  counter_form
    ^ form
    def_form.set_talk(http_demo/increment)
  +  seed
    \ port=nat
    ^ row[[p=path t=myth]]
    [[['kook 'hserve] (| myth/sing ['form] http/serve_form)]
     [['kook 'demo] (| myth/sing ['form] http_demo/responder)]
     [['kook 'counter] (| myth/sing ['form] http_demo/counter_form)]
     [http_demo/counter (kooked [['kook 'counter]]).put(['count] (| pd 0))]
     [['io 'http] (| http/cfg_port 'demo port)]]
