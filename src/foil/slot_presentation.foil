- system_vocabulary

' Shared content/presentation filtering policy, independent of slot documentation.
+ slot_presentation
  + machinery
    \ slot=path
    ^ bool
    = slots=row[path]
        [system_vocabulary/called_by
         system_vocabulary/calls
         system_vocabulary/crew
         system_vocabulary/dt
         system_vocabulary/entries
         system_vocabulary/face
         system_vocabulary/form
         system_vocabulary/grove/action
         system_vocabulary/grove/like
         system_vocabulary/grove/module
         system_vocabulary/grove/norm
         system_vocabulary/grove/role
         system_vocabulary/grove/role_contract
         system_vocabulary/grove/seed
         system_vocabulary/grove/sewn
         system_vocabulary/grove/source
         system_vocabulary/grove/template
         system_vocabulary/grove/view
         system_vocabulary/lash
         system_vocabulary/limb
         system_vocabulary/mold
         system_vocabulary/op
         system_vocabulary/req
         system_vocabulary/res
         system_vocabulary/spec
         system_vocabulary/tack
         system_vocabulary/unreads
         system_vocabulary/weft]
    | slots.any (\ key (eq_pith key slot))
