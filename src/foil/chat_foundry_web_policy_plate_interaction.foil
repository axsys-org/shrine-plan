-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  web [order=45]
-  chat_foundry_projection [order=50]
-  chat_foundry_occurrence [order=60]
-  chat_foundry_web_form [order=70]
-  chat_foundry_web_mount [order=80]
-  chat_foundry_web_policy_result [order=90]
'  Quarantined compatibility policy for the legacy messages Hole and Composer.
'  These branches remain Web terminal mechanics and are not promoted into IR.
+  chat_foundry_web_policy_plate_interaction
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'messages] occurrence)
       =  [nodes code]
            (chat_foundry_web_mount/plan_hole_mount occurrence "log" .z
              [chat_foundry_projection/messages_op chat_foundry_projection/web_op])
       (chat_foundry_web_policy_result .true nodes code)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'composer] occurrence)
       ?  (chat_foundry_occurrence/occurrence_ref ['surface 'source] occurrence)
        > .none
          '  The authored Composer now exposes an Action declaration rather
          '  than its subject.  Until an authority resolver supplies a
          '  canonical mount and witness-bound Web mechanics, retain an inert
          '  structural fallback.  Never recover /chat/log from the role or
          '  Action identity and never manufacture a /post target here.
          ?  (chat_foundry_occurrence/occurrence_ref ['surface 'action] occurrence)
           > .none
             (chat_foundry_web_policy_result .true []
               (./some 'chat_pronunciation_composer_action_missing))
           > (./some action=path)
             (chat_foundry_web_policy_result .true
               [(weft/el "div"
                  [(weft/cls "composer composer-inert")
                   (weft/att "aria-disabled" "true")
                   (weft/att "data-foundry-action" (show/path action))]
                  children)]
               .none)
        > (./some source=path)
          (chat_foundry_web_policy_result .true
            [(chat_foundry_web_form/chat_form source "/chat")] .none)
    (chat_foundry_web_policy_result .false [] .none)
