-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
'  Header Text Style resolution and bounded Web attributes.  Text attributes
'  remain distinct from the structural Plate Header Block.
+  chat_foundry_header
  +  header_text_style
    '  Renderer-safe pronunciation of the admitted Header Text Style Layer.
    '  Values are normalized onto a deliberately small Web vocabulary; an
    '  absent, ill-typed, or unsupported semantic value selects the safe local
    '  fallback.
    :  family=nat
       size=nat
       weight=nat
       line_height=nat
       tracking=nat
       source=nat
       fallback=bool

  +  header_family
    \  occurrence=projection_pronunciation_occurrence
    ^  [value=nat fallback=bool]
    =  key=path  ['foundry 'resolved 'token 'type 'header 'family]
    ?  (chat_foundry_occurrence/occurrence_token_is key "semantic_sans"
          ['token 'type 'family 'interface] occurrence)
       ["interface" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "semantic_mono"
          ['token 'type 'family 'monospace] occurrence)
       ["monospace" .false]
    ["interface" .true]

  +  header_size
    \  occurrence=projection_pronunciation_occurrence
    ^  [value=nat fallback=bool]
    =  key=path  ['foundry 'resolved 'token 'type 'header 'size]
    ?  (chat_foundry_occurrence/occurrence_token_is key "title"
          ['token 'type 'scale 'header] occurrence)
       ["header" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "large_title"
          ['token 'type 'scale 'large_title] occurrence)
       ["large-title" .false]
    ["header" .true]

  +  header_weight
    \  occurrence=projection_pronunciation_occurrence
    ^  [value=nat fallback=bool]
    =  key=path  ['foundry 'resolved 'token 'type 'header 'weight]
    ?  (chat_foundry_occurrence/occurrence_token_is key "semibold"
          ['token 'type 'weight 'semibold] occurrence)
       ["semibold" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "bold"
          ['token 'type 'weight 'bold] occurrence)
       ["bold" .false]
    ["semibold" .true]

  +  header_line_height
    \  occurrence=projection_pronunciation_occurrence
    ^  [value=nat fallback=bool]
    =  key=path  ['foundry 'resolved 'token 'type 'header 'line_height]
    ?  (chat_foundry_occurrence/occurrence_token_is key "tight"
          ['token 'type 'line_height 'compact] occurrence)
       ["compact" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "normal"
          ['token 'type 'line_height 'standard] occurrence)
       ["standard" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "relaxed"
          ['token 'type 'line_height 'relaxed] occurrence)
       ["relaxed" .false]
    ["compact" .true]

  +  header_tracking
    \  occurrence=projection_pronunciation_occurrence
    ^  [value=nat fallback=bool]
    =  key=path  ['foundry 'resolved 'token 'type 'header 'tracking]
    ?  (chat_foundry_occurrence/occurrence_token_is key "normal"
          ['token 'type 'tracking 'standard] occurrence)
       ["standard" .false]
    ?  (chat_foundry_occurrence/occurrence_token_is key "wide"
          ['token 'type 'tracking 'wide] occurrence)
       ["wide" .false]
    ["standard" .true]

  +  header_text_style_of
    '  Resolution parameters are inherited from the admitted DAG root; role
    '  dispatch chooses the title occurrence but does not choose these values.
    \  occurrence=projection_pronunciation_occurrence
    ^  chat_foundry_header/header_text_style
    =  [family family_fallback]  (chat_foundry_header/header_family occurrence)
       [size size_fallback]      (chat_foundry_header/header_size occurrence)
       [weight weight_fallback]  (chat_foundry_header/header_weight occurrence)
       [line line_fallback]      (chat_foundry_header/header_line_height occurrence)
       [tracking tracking_fallback]
         (chat_foundry_header/header_tracking occurrence)
       fallback=bool
         ?  family_fallback  .true
         ?  size_fallback  .true
         ?  weight_fallback  .true
         ?  line_fallback  .true
         tracking_fallback
       source
         ?  fallback  "safe-fallback"
         ?  (chat_foundry_occurrence/occurrence_ref
               ['foundry 'provenance 'token 'type 'header 'family]
               occurrence)
          > .none  "safe-fallback"
          > (./some layer=path)
            ?  (eq_pith layer
                  ['foundry 'system 'styles 'header_text])
               "authored"
            "static-fallback"
    (chat_foundry_header/header_text_style
      family size weight line tracking source fallback)

  +  header_text_style_css
    '  Only normalized names reach this mechanical mapping, so authored text
    '  can never become an arbitrary style attribute.
    \  style=chat_foundry_header/header_text_style
    ^  nat
    =  family
         ?  (eq style.family "monospace")
            "ui-monospace,SFMono-Regular,Menlo,monospace"
         "var(--surface-font)"
       size
         ?  (eq style.size "large-title")  "15px"
         "12px"
       weight
         ?  (eq style.weight "bold")  "700"
         "600"
       line
         ?  (eq style.line_height "relaxed")  "1.4"
         ?  (eq style.line_height "standard")  "1.25"
         "1.15"
       tracking
         ?  (eq style.tracking "wide")  ".04em"
         "0"
    (weft/cat
      ["font-family:" family ";font-size:" size ";font-weight:" weight
       ";line-height:" line ";letter-spacing:" tracking])

  +  header_text_style_attrs
    \  style=chat_foundry_header/header_text_style
    ^  row[weft/att]
    [(weft/cls "foundry-header-text")
     (weft/att "data-foundry-header-style" style.source)
     (weft/att "data-header-family" style.family)
     (weft/att "data-header-size" style.size)
     (weft/att "data-header-weight" style.weight)
     (weft/att "data-header-line-height" style.line_height)
     (weft/att "data-header-tracking" style.tracking)
     (weft/att "style" (chat_foundry_header/header_text_style_css style))]
