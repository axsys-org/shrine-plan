- namespace
- lain_peek
- lain_poke

' A trusted published operation may validate a complete read-set and plan
' several writes against one namespace snapshot. The supervisor admits the
' plan without yielding to another request. Ordinary record ops stay valid.
+ namespace_op
  : plan={\ path myth namespace}either[iota row[[p=path q=writ]]]

+ namespace_command
  + reconcile
    \ before=namespace after=namespace now=nat block=nat
    ^ either[iota namespace]
    ? (eq before.local.top after.local.top) (./ok after)
    = index (sovereign_hive after)
      news (sovereign_reconcile_news before after index)
    ? !(news.wyt) (./ok after)
    < pair (namespace_command/run (task/hear news) now block after index)
    = [next ignored] pair
    | ./ok next
  + deferred
    \ held=pail
    ^ bool
    ?> command=namespace_op held .false
    .true
  + event
    \ command=task entropy=nat now=nat block=nat state=namespace
    ^ sovereign_event
    | sovereign_run_event_with (sovereign_access state).set_deferred(namespace_command/deferred)
        command entropy now block state
  + plan
    \ target=path operation=path input=myth state=namespace
    ^ either[iota row[[p=path q=writ]]]
    ? !(state.permitted(target)) (./err 'write_outside_authority)
    ?> (./some record) (sovereign_care .x operation state).fil
      | ./err 'warp_op_unknown
    ?> (./some held) record.get(system_vocabulary/op)
      | ./err 'warp_op_bad
    ? held
     > command=namespace_op
      = plan command.plan
      | plan target input state
     > ordinary=op
      | ./ok [[target (writ/warp operation input)]]
    | ./err 'warp_op_bad

  + run
    ' One submitted event may drive at most 128 reaction rounds. This is the
    ' shared admission budget for supervisor writes and installed operations;
    ' emitted commands share that bound with reaction rounds. It does not
    ' measure arbitrary computation performed inside a native hand.
    ' Hand-emitted namespace operations use the same admission, after the
    ' emitting cascade settles. Their existing moves are consumed in order.
    ' No candidate becomes visible until all commands and reactions succeed.
    \ command=task now=nat block=nat state=namespace index=hive
    ^ either[iota [namespace hive]]
    ' Keep execution exceptions inside the same boundary as explicit refusal.
    ' The original namespace and hive remain owned by the caller on failure.
    = execute
        \ current=namespace
        ^ either[iota [namespace hive]]
        % current=namespace current idx=hive index pending=row[move] [] next=maybe[task] (./some command) gas=nat 129
        ^ either[iota [namespace hive]]
        ? next
         > (./some task)
          ? !(gas) (./err 'cycle_exhausted)
          = [result after_index] (sovereign_cycle_via namespace_command/event idx task 0 gas.dec now block current)
          ? result
           > (./fail why) (./err why)
           > (./spun after moves rounds ack spill)
            ? spill
             > (./some why) (./err why)
            | _ after after_index pending.weld(moves) .none (sub gas rounds.len)
        ?> (./some pair) pending.pull (./ok [current idx])
        ? !(gas) (./err 'cycle_exhausted)
        = [move rest] pair
        ? !(and ((equal[path] move.src ['out]) || (current.permitted(move.src))) (current.permitted(move.dst))) (./err 'outbound_not_supported)
        ?> (./warp operation input) move.w (./err 'outbound_not_supported)
        = declaration (sovereign_care .x operation current).fil.fall(myth/new)
        ? !(namespace_command/deferred declaration.pail_at(system_vocabulary/op)) (./err 'warp_op_bad)
        < writes (namespace_command/plan move.dst operation input current)
        | _ current idx rest (? writes.len (./some (task/vines writes)) .none) gas.dec
    ?> (./ok completed) (Try execute state) (./err 'command_execution_failed)
    completed
  + admit
    ' Planning and reactions see one immutable candidate. Refusal publishes none.
    \ plan={\ namespace}either[iota row[[p=path q=writ]]] state=namespace index=hive
    ^ either[iota [namespace hive]]
    ?> (./ok planned) (Try plan state) (./err 'command_plan_failed)
    < writes planned
    ? !(writes.len) (./ok [state index])
    | namespace_command/run (task/vines writes) 0 0 state index
