- sys/types

' Formatting is deterministic UTC. Keep the literal's precision in stored pails.
+ temporal
  + pad
    \ width=nat text=str
    ^ str
    | str/cat_all [(str/repeat (sub width text.len) "0") text]
  + fraction
    \ ticks=nat bits=nat
    ^ str
    = remainder (mod ticks (bex bits))
    ? (eq remainder 0) ""
    = decimal
        % left=nat bits value=nat remainder
        ? (eq left 0) (temporal/pad bits (nat/show value))
        | _ left.dec (mul value 5)
    % length=nat decimal.len
    ? (eq decimal.at(length.dec) 48) (_ length.dec)
    | str/cat_all ["." decimal.slice(0 length)]
  + timestamp
    \ value=iota
    ^ str
    = bits (? (eq (aura_tag value) "ds") 50 10)
      prefix (? (eq bits 50) 2 1)
      printed (str/from_atom (iota_show value))
      parts (printed.slice(prefix (sub printed.len prefix)).split_byte(46))
      date (str/join "-" [(temporal/pad 4 parts.at(0)) (temporal/pad 2 parts.at(1)) (temporal/pad 2 parts.at(2))])
      time (str/join ":" [(temporal/pad 2 parts.at(4)) (temporal/pad 2 parts.at(5)) (temporal/pad 2 parts.at(6))])
    | str/cat_all [date " " time (temporal/fraction (quip_val value) bits) " UTC"]
  + duration
    \ value=nat
    ^ str
    = units=row[[nat str]] [[86400000 "d"] [3600000 "h"] [60000 "m"] [1000 "s"] [1 "ms"]]
    = result
        % rest=nat value index=nat 0 out=row[str] []
        ? (eq index units.len) out
        = [scale suffix] units.at(index)
          count (div rest scale)
        | _ (mod rest scale) index.inc (? count out.snoc((str/cat_all [(nat/show count) suffix])) out)
    ? (eq result.len 0) "0ms"
    | str/join " " result
