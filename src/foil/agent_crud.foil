-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
-  lain [order=40]
-  json [order=50]
'  A JSON transport around real Shrine transactions. No behavior DSL,
'  synthetic namespace or model-written code. The native crew slot
'  can attach a note that the tiny hear form forwards to the host.
+  crud
  +  member
    \  key=nat v=json
    ^  json
    ?  v
     > (./obj kvs)
       |  > i=nat 0
       ?  (eq i kvs.len)  jnull
       =  > kv kvs.at(i)
       ?  (eq key kv.k)  kv.v
       (_ i.inc)
    jnull
  +  care_of
    \  v=json
    ^  care
    ?  v
     > (./str s)
       ?  (eq s "z")  .z
       ?  (eq s "y")  .y
       .x
    .x
  +  care_text
    \  c=care
    ^  nat
    ?  c
     > .x  "x"
     > .y  "y"
     > .z  "z"
  +  crew_decode
    \  v=json
    ^  crew
    ?  v
     > (./obj kvs)
       |  > i=nat 0  > out=crew (mop/empty)
       ?  (eq i kvs.len)  out
       =  > kv kvs.at(i)
       =  > d (dep (crud/care_of (crud/member "care" kv.v)) (crud/path_of (crud/member "path" kv.v)))
       (_ i.inc out.put([($ts kv.k)] d))
    (mop/empty)
  +  crew_encode
    \  deps=crew
    ^  json
    =  > es deps.tap
    |  > i=nat 0  > out=row[jkv] []
    ?  (eq i es.len)  (json/obj out)
    =  [p d] es.at(i)
    =  > body (json/obj [(jkv "path" (json/str (crud/path_text d.p))) (jkv "care" (json/str (crud/care_text d.c)))])
    (_ i.inc out.snoc((jkv (quip_val p.at(0)) body)))
  +  value
    '  Structured JSON values retain their own nominal wrapper. Text
    '  and natural-number slots use the standard native pails below.
    :  v=json
  +  goal
    '  An app record payload. Completion belongs to the native form;
    '  the model supplies only individual condition assessments.
    :  conditions=json fulfilled=bool
  +  goal_slot
    ^  path
    ['app 'goal]
  +  bool_of
    \  v=json
    ^  bool
    ?  v
     > (./boo b)  b
    .false
  +  pack
    \  v=json
    ^  pail
    ?  v
     > (./str s)  (pails/t s)
     > (./num neg n)
       ?  neg  (crud/value v)
       (pd n)
    (crud/value v)
  +  unpack
    \  p=pail
    ^  json
    ?  p
     > t=pails/t  (json/str t.t)
     > n=pails/n  (json/num .false n.n)
     > v=crud/value  v.v
     > c=cpail  (crud/crew_encode c.crew)
     > g=crud/goal  (crud/goal_json g)
    (json/str "[native value outside CRUD transport]")
  +  fields
    \  v=json
    ^  myth
    ?  v
     > (./obj kvs)
       |  > i=nat 0  > out=myth myth/new
       ?  (eq i kvs.len)  out
       =  > kv kvs.at(i)
       ?  (eq kv.k "/app/goal")
          =  > g (crud/goal (crud/member "conditions" kv.v) .false)
          =  > next out.put(crud/goal_slot g)
          (_ i.inc next.put(limb_slot (kook [['boot 'agent_goal]])))
       ?  (eq kv.k "/sys/crew")
          =  > next out.put(crew_slot (cpail (crud/crew_decode kv.v)))
          (_ i.inc next.put(limb_slot (kook [['boot 'agent_probe]])))
       (_ i.inc out.put([($ts kv.k)] (crud/pack kv.v)))
    myth/new
  +  object
    \  t=myth
    ^  json
    =  > es t.tap
    |  > i=nat 0  > out=row[jkv] []
    ?  (eq i es.len)  (json/obj out)
    =  [p q] es.at(i)
    ?  (eq_pith p limb_slot)  (_ i.inc out)
    =  > key
         ?  (eq p.len 1)  (quip_val p.at(0))
         (crud/path_text p)
    (_ i.inc out.snoc((jkv key (crud/unpack q))))
  +  path_text
    \  p=path
    ^  nat
    |  > i=nat 0  > out=nat 0
    ?  (eq i p.len)
       ?  (eq out 0)  "/"
       out
    =  > segment p.at(i)
    =  > text
         ?  (is_text segment)  (quip_val segment)
         (cat2 "~u:" (show_nat (quip_val segment)))
    (_ i.inc (cat2 (cat2 out "/") text))
  +  path_of
    '  Only text-segment paths enter this adapter; Python validates
    '  the wire path before converting it to an array of strings.
    \  v=json
    ^  path
    ?  v
     > (./arr xs)
       |  > i=nat 0  > out=path []
       ?  (eq i xs.len)  out
       ?  xs.at(i)
        > (./str s)  (_ i.inc out.snoc(($ts s)))
       out
    []
  +  public
    \  p=path
    ^  bool
    ?  (eq p.len 0)  .false
    =  > first p.at(0)
    ?  (eq_iota first 'log)  .false
    ?  (eq_iota first 'agent)  .false
    ?  (eq_iota first 'boot)  .false
    .true
  +  at
    \  p=path s=sov
    ^  json
    ?  (peek p s).fil
     > .none  jnull
     > (./some t)  (crud/object t)
  +  case_at
    \  p=path s=sov
    ^  json
    ?  s.x_case(p)
     > .none  jnull
     > (./some n)  (json/num .false n)
  +  view
    \  p=path s=sov
    ^  json
    =  > es (peek p s).tap
    |  > i=nat 0  > out=row[json] []
    ?  (eq i es.len)  (json/arr out)
    =  [rel t] es.at(i)
    =  > abs p.weld(rel)
    ?  (eq p.len 0)
       ?  !(crud/public abs)  (_ i.inc out)
       (_ i.inc out.snoc((json/obj [(jkv "path" (json/str (crud/path_text abs))) (jkv "fields" (crud/object t)) (jkv "case" (crud/case_at abs s))])))
    (_ i.inc out.snoc((json/obj [(jkv "path" (json/str (crud/path_text abs))) (jkv "fields" (crud/object t)) (jkv "case" (crud/case_at abs s))])))
  +  changes
    '  Only paths with native x-change signs. No requested write is
    '  reported as an effect until the runtime actually commits it.
    \  rounds=row[axal[sign]] before=sov after=sov
    ^  json
    =  > changed
         |  > r=nat 0  > out=axal[sign] (axal/new[sign] .none)
         ?  (eq r rounds.len)  out
         =  > es rounds.at(r).tap
         =  > next
              |  > i=nat 0  > acc=axal[sign] out
              ?  (eq i es.len)  acc
              =  [p sg] es.at(i)
              ?  (eq sg.x 0)  (_ i.inc acc)
              ?  !(crud/public p)  (_ i.inc acc)
              (_ i.inc acc.put(p sg))
         (_ r.inc next)
    =  > es changed.tap
    |  > i=nat 0  > out=row[json] []
    ?  (eq i es.len)  (json/arr out)
    =  [p sg] es.at(i)
    (_ i.inc out.snoc((json/obj [(jkv "path" (json/str (crud/path_text p))) (jkv "before" (crud/at p before)) (jkv "after" (crud/at p after)) (jkv "case" (crud/case_at p after))])))
  +  apply
    '  JSON requests are decoded by the host; mutation semantics,
    '  tombstones, acknowledgements, and cases all belong to Shrine.
    \  op=nat p=path fields=json s=sov
    ^  [state=sov result=json]
    ?  (eq op "read")
       [s (json/obj [(jkv "ok" (json/boo .true)) (jkv "records" (crud/view p s))])]
    =  > incoming (crud/fields fields)
    =  > managed_crew
         ?  (eq op "poke")
            ?  (peek p s).fil
             > (./some cur)
               ?  cur.get(crud/goal_slot)
                > (./some g)
                  ?  incoming.get(crew_slot)
                   > (./some _)  .true
                  .false
               .false
            .false
         .false
    ?  managed_crew
       [s (json/obj [(jkv "ok" (json/boo .false)) (jkv "error" (json/str "goal_manages_crew: edit goal conditions instead")) (jkv "changes" (json/arr []))])]
    =  > w=writ
         ?  (eq op "make")  (./make incoming)
         ?  (eq op "poke")  (./poke incoming)
         .cull
    ?  (cycle (task/vine p w) 0 16 s)
     > (./fail e)
       [s (json/obj [(jkv "ok" (json/boo .false)) (jkv "error" (json/str (quip_val e))) (jkv "changes" (json/arr []))])]
     > (./spun next moves rounds ack spill)
       =  > a=json
            ?  ack
             > .none  jnull
             > (./some ap)  (json/str (crud/path_text ap))
       =  > err=json
            ?  spill
             > .none  jnull
             > (./some e)  (json/str (quip_val e))
       [next (json/obj [(jkv "ok" (json/boo .true)) (jkv "ack" a) (jkv "changes" (crud/changes rounds s next)) (jkv "notifications" (crud/notifications moves)) (jkv "cascade_error" err) (jkv "outbound_count" (json/num .false moves.len)) (jkv "rounds" (json/num .false rounds.len))])]
  +  tree_json
    \  base=path tree=axal[myth]
    ^  json
    =  > es tree.tap
    |  > i=nat 0  > out=row[json] []
    ?  (eq i es.len)  (json/arr out)
    =  [p t] es.at(i)
    (_ i.inc out.snoc((json/obj [(jkv "path" (json/str (crud/path_text base.weld(p)))) (jkv "fields" (crud/object t))])))
  +  probe
    '  A message emitted by the native hear arm, not a namespace write
    '  claimed as committed. The host accepts it into the observation log.
    :  body=json
  +  hear
    \  b=bowl cur=myth changed=row[dep]
    ^  yell
    =  > triggers
         |  > i=nat 0  > out=row[json] []
         ?  (eq i changed.len)  (json/arr out)
         =  > d changed.at(i)
         (_ i.inc out.snoc((json/obj [(jkv "path" (json/str (crud/path_text d.p))) (jkv "care" (json/str (crud/care_text d.c)))])))
    =  > deps=crew
         ?  cur.get(crew_slot)
          > .none  (mop/empty)
          > (./some pl)
            ?  pl
             > c=cpail  c.crew
            (mop/empty)
    =  > es deps.tap
    =  > views
         |  > i=nat 0  > out=row[jkv] []
         ?  (eq i es.len)  (json/obj out)
         =  [p d] es.at(i)
         =  > view b.crew.gut(p (axal/new[myth] .none))
         =  > body (json/obj [(jkv "path" (json/str (crud/path_text d.p))) (jkv "care" (json/str (crud/care_text d.c))) (jkv "records" (crud/tree_json d.p view))])
         (_ i.inc out.snoc((jkv (quip_val p.at(0)) body)))
    =  > body (json/obj [(jkv "watcher" (json/str (crud/path_text b.here))) (jkv "note" (json/str cur.txt_at(['note]))) (jkv "watcher_record" (crud/object cur)) (jkv "changed" triggers) (jkv "dependencies" views)])
    (yell [[['agent 'probe] (writ/make (myth/sing ['probe] (crud/probe body)))]] cur)
  +  probe_form
    ^  form
    def_form.set_hear(crud/hear)
  +  goal_json
    \  g=crud/goal
    ^  json
    =  > conditions
         ?  g.conditions
          > (./obj kvs)
            |  > i=nat 0  > out=row[jkv] []
            ?  (eq i kvs.len)  (json/obj out)
            =  > kv kvs.at(i)
            =  > body (json/obj [(jkv "path" (json/str (crud/path_text (crud/path_of (crud/member "path" kv.v))))) (jkv "care" (crud/member "care" kv.v)) (jkv "note" (crud/member "note" kv.v)) (jkv "met" (crud/member "met" kv.v))])
            (_ i.inc out.snoc((jkv kv.k body)))
         (json/obj [])
    (json/obj [(jkv "conditions" conditions) (jkv "fulfilled" (json/boo g.fulfilled))])
  +  goal_all
    \  conditions=json
    ^  bool
    ?  conditions
     > (./obj kvs)
       ?  (eq kvs.len 0)  .false
       |  > i=nat 0
       ?  (eq i kvs.len)  .true
       ?  !(crud/bool_of (crud/member "met" kvs.at(i).v))  .false
       (_ i.inc)
    .false
  +  goal_refresh
    \  t=myth
    ^  myth
    ?  t.get(crud/goal_slot)
     > (./some p)
       ?  p
        > g=crud/goal
          =  > next t.put(crud/goal_slot (crud/goal g.conditions (crud/goal_all g.conditions)))
          =  > wired next.put(crew_slot (cpail (crud/crew_decode g.conditions)))
          wired.put(limb_slot (kook [['boot 'agent_goal]]))
       t
    t
  +  goal_init
    \  b=bowl t=myth
    ^  yell
    (yell [] (crud/goal_refresh t))
  +  goal_talk
    \  b=bowl cur=myth add=myth
    ^  yell
    (yell [] (crud/goal_refresh cur.meld(add)))
  +  goal_affected
    \  condition=json changed=row[dep]
    ^  bool
    =  > p (crud/path_of (crud/member "path" condition))
    =  > c (crud/care_of (crud/member "care" condition))
    |  > i=nat 0
    ?  (eq i changed.len)  .false
    =  > d changed.at(i)
    ?  (eq_pith p d.p)
       ?  (eq (crud/care_text c) (crud/care_text d.c))  .true
       (_ i.inc)
    (_ i.inc)
  +  goal_hear
    \  b=bowl cur=myth changed=row[dep]
    ^  yell
    =  > next
         ?  cur.get(crud/goal_slot)
          > (./some p)
            ?  p
             > g=crud/goal
               =  > conditions
                    ?  g.conditions
                     > (./obj kvs)
                       |  > i=nat 0  > out=row[jkv] []
                       ?  (eq i kvs.len)  (json/obj out)
                       =  > kv kvs.at(i)
                       ?  !(crud/goal_affected kv.v changed)  (_ i.inc out.snoc(kv))
                       =  > body (json/obj [(jkv "path" (crud/member "path" kv.v)) (jkv "care" (crud/member "care" kv.v)) (jkv "note" (crud/member "note" kv.v)) (jkv "met" (json/boo .false))])
                       (_ i.inc out.snoc((jkv kv.k body)))
                    g.conditions
               (crud/goal_refresh cur.put(crud/goal_slot (crud/goal conditions .false)))
            cur
         cur
    (crud/hear b next changed)
  +  goal_form
    ^  form
    def_form.set_init(crud/goal_init).set_talk(crud/goal_talk).set_hear(crud/goal_hear)
  +  initial
    ^  sov
    =  > seeded
         ?  (run_event (task/vine ['boot 'agent_probe] (writ/make (myth/sing ['form] crud/probe_form))) 0 sov/new)
          > (./ripe s fx signs ack)  s
          > (./fail err)  sov/new
    ?  (run_event (task/vine ['boot 'agent_goal] (writ/make (myth/sing ['form] crud/goal_form))) 0 seeded)
     > (./ripe s fx signs ack)  s
     > (./fail err)  seeded
  +  notifications
    \  moves=row[move]
    ^  json
    |  > i=nat 0  > out=row[json] []
    ?  (eq i moves.len)  (json/arr out)
    =  > m moves.at(i)
    ?  !(eq_pith m.dst ['agent 'probe])  (_ i.inc out)
    ?  m.w
     > (./make t)
       ?  t.get(['probe])
        > .none  (_ i.inc out)
        > (./some pl)
          ?  pl
           > p=crud/probe  (_ i.inc out.snoc(p.body))
          (_ i.inc out)
    (_ i.inc out)
