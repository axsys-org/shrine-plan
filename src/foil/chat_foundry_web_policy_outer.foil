-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_web_policy_result [order=50]
-  chat_foundry_web_policy_outer_stage [order=60]
-  chat_foundry_web_policy_outer_after_stage [order=70]
'  Ordered dispatcher for quarantined compatibility policy at the outermost
'  desktop, Stage, window, and Shrine Scene boundary.
+  chat_foundry_web_policy_outer
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    =  stage
         (chat_foundry_web_policy_outer_stage/plan_policy occurrence children)
    ?  stage.matched  stage
    (chat_foundry_web_policy_outer_after_stage/plan_policy
      occurrence children)
