-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
'  Optional native patterns, never an expression interpreter.
+  shadow_forms
  +  publish
    \  slot=path value=pail cur=myth
    ^  myth
    ?  cur.get(slot)
     > (./some old)
       ?  (equal old value)  cur
       cur.put(slot value)
    cur.put(slot value)
  +  projected
    '  Supply an ordinary Foil function. It chooses its own views.
    \  project={bowl; myth; pail} slot=path b=bowl cur=myth changed=row[dep]
    ^  yell
    (yell [] (shadow_forms/publish slot (project b cur) cur))
  +  projected_init
    \  project={bowl; myth; pail} slot=path b=bowl cur=myth
    ^  yell
    (shadow_forms/projected project slot b cur [])
  +  projection
    \  project={bowl; myth; pail} slot=path
    ^  form
    def_form.set_init((shadow_forms/projected_init project slot)).set_hear((shadow_forms/projected project slot))
  +  notice_basis
    :  basis=mop[path axal[myth] lt_pith] changed=row[dep]
  +  notice
    '  Explicit opt-in. Notes are children of a dedicated notice root.
    \  root=path b=bowl cur=myth changed=row[dep]
    ^  yell
    =  > n0 myth/new
    =  > n1 n0.put(['subject] (pails/p b.here))
    =  > n2 n1.put(['statement] (pails/t cur.txt_at(['statement])))
    =  > n3 n2.put(['question] (pails/t cur.txt_at(['question])))
    =  > notice n3.put(['kind] (pails/t "notice")).put(['basis] (shadow_forms/notice_basis b.crew changed))
    (yell [[root.weld(b.here) (writ/make notice)]] cur)
  +  notice_form
    \  root=path
    ^  form
    def_form.set_hear((shadow_forms/notice root))
  +  assessment
    '  A scoped authored assessment, tied to this exact hydrated basis.
    :  basis=mop[path axal[myth] lt_pith] scope=nat evidence=row[path] supports=row[path]
  +  present
    \  names=row[path] b=bowl
    ^  bool
    |  > i=nat 0
    ?  (eq i names.len)  .true
    =  > view b.crew.gut(names.at(i) (axal/new[myth] .none))
    ?  view.fil
     > (./some _)  (_ i.inc)
    .false
  +  support_lineage
    :  ancestors=row[path]
  +  supported
    '  Cycles cannot bootstrap themselves from unestablished peers.
    \  names=row[path] b=bowl
    ^  bool
    |  > i=nat 0
    ?  (eq i names.len)  .true
    =  > view b.crew.gut(names.at(i) (axal/new[myth] .none))
    ?  view.fil
     > (./some t)
       ?  !(eq t.txt_at(['applicability]) "CURRENT")  .false
       ?  t.get(['support_lineage])
        > (./some pl)
          ?  pl
           > lineage=shadow_forms/support_lineage
             ?  lineage.ancestors.any((\ p (equal p b.here)))  .false
             (_ i.inc)
          .false
       .false
    .false
  +  establish
    '  Called by an authored form after its own investigation/check.
    '  The library does not infer what the evidence means.
    \  scope=nat evidence=row[path] supports=row[path] b=bowl cur=myth
    ^  myth
    ?  ((eq evidence.len 0) || !(shadow_forms/present evidence b) || !(shadow_forms/supported supports b))
       cur.put(['applicability] (pails/t "UNESTABLISHED"))
    =  > a (shadow_forms/assessment b.crew scope evidence supports)
    =  > ancestry
         |  > i=nat 0  > out=row[path] [b.here]
         ?  (eq i supports.len)  out
         =  > view b.crew.gut(supports.at(i) (axal/new[myth] .none))
         ?  view.fil
          > (./some t)
            ?  t.get(['support_lineage])
             > (./some pl)
               ?  pl
                > lineage=shadow_forms/support_lineage
                  (_ i.inc out.weld(lineage.ancestors))
               out
            out
         out
    cur.put(['support_lineage] (shadow_forms/support_lineage ancestry)).put(['assessment] a).put(['scope] (pails/t scope)).put(['applicability] (pails/t "CURRENT"))
  +  reconsider
    \  notices=path b=bowl cur=myth changed=row[dep]
    ^  yell
    ?  (eq cur.txt_at(['applicability]) "RETIRED")  (yell [] cur)
    ?  cur.get(['assessment])
     > (./some pl)
       ?  pl
        > a=shadow_forms/assessment
          ?  (equal a.basis b.crew)  (yell [] cur)
          ?  (eq cur.txt_at(['applicability]) "NEEDS_REVIEW")  (yell [] cur)
          =  > next cur.put(['applicability] (pails/t "NEEDS_REVIEW"))
          (shadow_forms/notice notices b next changed)
       (shadow_forms/notice notices b cur changed)
    (shadow_forms/notice notices b cur changed)
  +  statement_talk
    \  notices=path b=bowl cur=myth add=myth
    ^  yell
    =  > next cur.meld(add)
    ?  (equal next cur)  (yell [] cur)
    ?  (add.has(crew_slot) || add.has(['statement]) || add.has(['scope]) || add.has(['meaning_revision]))
       =  > revised next.put(['applicability] (pails/t "NEEDS_REVIEW"))
       (shadow_forms/notice notices b revised [])
    (yell [] next)
  +  statement_form
    \  notices=path
    ^  form
    def_form.set_talk((shadow_forms/statement_talk notices)).set_hear((shadow_forms/reconsider notices))
  +  retire
    \  cur=myth
    ^  myth
    cur.put(['applicability] (pails/t "RETIRED")).put(crew_slot (cpail (mop/empty)))
  +  publication
    '  An ordinary nominal value suitable for a separate projection node.
    :  meaning_revision=nat scope=nat applicability=nat result=nat
  +  published
    \  source=path b=bowl cur=myth
    ^  pail
    =  > view b.crew.gut(source (axal/new[myth] .none))
    ?  view.fil
     > (./some t)
       (shadow_forms/publication t.nat_at(['meaning_revision] 0) t.txt_at(['scope]) t.txt_at(['applicability]) t.txt_at(['result]))
    (shadow_forms/publication 0 "" "UNESTABLISHED" "UNKNOWN")
  +  publication_form
    \  source=path
    ^  form
    (shadow_forms/projection (shadow_forms/published source) ['publication])

  +  checked
    '  The supplied function is real Foil. Its result establishes only scope.
    \  predicate={bowl; myth; nat} scope=nat b=bowl cur=myth changed=row[dep]
    ^  yell
    =  > result (predicate b cur)
    =  > known ((eq result "HOLDS") || (eq result "FAILS"))
    =  > normalized
         ?  known  result
         "UNKNOWN"
    =  > applicability
         ?  (eq normalized "HOLDS")  "CURRENT"
         "NEEDS_REVIEW"
    =  > next cur.put(['result] (pails/t normalized)).put(['scope] (pails/t scope)).put(['applicability] (pails/t applicability))
    (yell [] next)
  +  checked_init
    \  predicate={bowl; myth; nat} scope=nat b=bowl cur=myth
    ^  yell
    (shadow_forms/checked predicate scope b cur [])
  +  check_form
    \  predicate={bowl; myth; nat} scope=nat
    ^  form
    def_form.set_init((shadow_forms/checked_init predicate scope)).set_hear((shadow_forms/checked predicate scope))
