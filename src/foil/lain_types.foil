-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
'  Publisher-owned dispatch intermediates and record helpers. Public
'  commands and behavior interfaces are defined by the system modules.
- sys/hand
+ pails
  +  code
    '  A compiled entry riding opaquely in the namespace: the publisher's compiler
    '  mirror stores each declaration's compiled value here.  The
    '  any type is the untyped carrier (the value may be a law, row, or pin) —
    '  read it back out, never do arithmetic on it.
    :  v=any
+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (pails/n x)
+  pt
  '  A text pail: pd's twin, for hosts that hold a cord rather than a
  '  number.  Both exist because pails/n and pails/t are nominal
  '  records — a host reaching for /pails/t through the subject gets
  '  the TYPE, not a constructor, and silently builds an unreadable
  '  slot (which is how the chat app's credential became an empty
  '  Bearer header).  Call these, not the record paths.
  \  x=str
  ^  pail
  (pails/t x)
+  lash
  +  texted
    '  The one-slot starter contract: the slot must be present and
    '  must carry text — the smallest lash that does anything, and
    '  the demo spelling for adopting a contract in one poke.
    \  slot=path lede=nat
    ^  lash
    |  lash (mop/empty)
       (mop/sing[path curb lt_pith] slot (curb/of_type (^ pails/t)))
       [[slot]]
       lede
       0
+  twig
  '  Limb constructors for the common wrappers: one idiom for every
  '  slot creation — t.add((twig/nat ['n] 7)).
  +  nat
    \  s=path n=nat
    ^  twig
    (twig s (pails/n n))
  +  txt
    \  s=path t=str
    ^  twig
    (twig s (pails/t t))
  +  iota
    \  s=path q=iota
    ^  twig
    (twig s (pails/q q))
  +  pat
    \  s=path p=path
    ^  twig
    (twig s (pails/p p))
+  myth
  '  Slot readers, unwrapping the common pails by rep.
  +  nat_at
    '  Read a data slot, with default.
    \  slot=path d=nat t=myth
    ^  nat
    ?  t.get(slot)
     > .none  d
     > (./some pl=pail)
       ?  pl
        > x=pails/n  x.n
       d
  +  txt_at
    '  Read a text slot, or the empty string when absent or foreign.
    \ slot=path t=myth
    ^ str
    > (./some held) t.get(slot)
      ""
    > text=pails/t held
      ""
    text.t
  +  path_at
    '  A path-valued slot, preserving the distinction between root and absence.
    \ slot=path t=myth
    ^ maybe[path]
    > (./some held) t.get(slot)
      .none
    > val=pails/p held
      .none
    | ./some val.p
  +  crew_at
    '  A crew-valued slot, or empty when absent or foreign.
    \ slot=path t=myth
    ^ crew
    > (./some held) t.get(slot)
      (mop/empty)
    > val=cpail held
      (mop/empty)
    val.crew
  +  copy_slot
    '  Copy a present slot, including a foreign pail; absence leaves t intact.
    \ slot=path src=myth t=myth
    ^ myth
    > (./some held) src.get(slot)
      t
    | t.put slot held
  +  code_at
    '  Read a compiled-value slot: the code pail's payload at slot,
    '  or 0.
    \  slot=path t=myth
    ^  any
    ?  t.get(slot)
     > .none  0
     > (./some pl=pail)
       ?  pl
        > x=pails/code  x.v
       0
  +  quip_at
    '  Read a iota slot: the pails/q payload at slot, if any.
    \  slot=path t=myth
    ^  maybe[iota]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/q  (./some x.q)
       .none
  +  pail_at
    '  Read a slot's raw pail, or a zero pails/n when absent —
    '  host-side consumers unwrap by rep (the brand cord rides in
    '  the head).
    \  slot=path t=myth
    ^  pail
    ?  t.get(slot)
     > (./some pl=pail)  pl
     > .none  (pd 0)
  +  has_at
    '  Whether the myth has anything at slot — a monomorphic wrapper
    '  over the mop method, so hosts can call it across the FFI.
    \  slot=path t=myth
    ^  bool
    t.has(slot)
+  move
  '  An outbound effect: one command, emitted at src, addressed
  '  outside the processed subtree.
  :  src=path dst=path w=writ
+  job
  '  What a dispatch sees: a command (the target is the flue's dst),
  '  a child-change gift, or a dependency-change notification of
  '  (care, path) pairs.
  &  job/vine
     job/take
     job/hear

  +  vine
    :  w=writ

  +  take
    :  gift=axal[mode]

  +  hear
    :  changed=row[dep]
+  flue
  '  A linearized work unit: who caused it, where it lands, what it is.
  :  src=path dst=path job=job
+  def_init
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_talk
  '  Default talk: union, the poke wins.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  o cur.meld(add)
  (yell [] o)
+  def_take
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  (yell [] cur)
+  def_hear
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  (yell [] cur)
+  def_dead
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_form
  '  The default behavior: init/talk as documented, take/hear keep
  '  state.
  ^  form
  (form def_init def_talk def_take def_hear def_dead def_dead)
+  kres
  '  Kook resolution: the behavior list, or a failure code.
  &  kres/kf
     kres/ke

  +  kf
    :  forms=row[form]

  +  ke
    :  err=iota
+  task
  '  One top-level event: a single path-tagged command, or change
  '  notifications (changed path -> its cared subscribers, as /dep
  '  pairs).
  &  task/vine
     task/hear

  +  vine
    :  p=path w=writ

  +  hear
    :  news=axal[row[dep]]
+  fate
  '  The kernel's answer: resolved notes in /lte_pith (tap) order
  '  and outbound commands. Warp can occur only in commands, not notes.
  :  write=row[[p=path q=note]] effects=row[move]
+  worm
  '  The per-event transaction.  down is a row+cursor queue (pop at
  '  dcur, push snoc).  prize records how each path changed, for the
  '  gift cascade.
  :  toil=axal[note] down=row[flue] dcur=nat up=row[move] prize=axal[mode] now=nat eny=nat
+  wend
  '  The loop accumulator: a live transaction or an aborted one.
  &  wend/go
     wend/bad

  +  go
    :  =worm

  +  bad
    :  err=iota
+  doom
  '  The kernel outcome for one event.  A successful vine event acks
  '  with the command's path tag; hear events ack .none.
  &  doom/done
     doom/fail

  +  done
    :  =fate ack=maybe[path]

  +  fail
    :  err=iota
+  limb_slot
  '  The well-known slot holding a node's behavior id list
  '  (bond/limb: the behavior chain).
  ^  path
  bond/limb
+  crew_slot
  '  The well-known slot holding a node's dependency map
  '  (bond/crew).
  ^  path
  bond/crew
+  is_h
  '  Is this path under the temporal-transposition overlay (/h)?
  '  Read-only and derived: writes here fail the event.
  \ p=path
  ^ bool
  p.starts('h)

+  is_o
  '  Is this path under the overlay lens (/o)?  Read-only and
  '  derived: writes here fail the event.
  \ p=path
  ^ bool
  p.starts('o)

+  is_xv
  '  Is this path under the view lens (/x)?  /x/...path runs the
  '  pinned weft and tack selected by the defining datum's case.  Read-only and derived, like /h and /o.
  \ p=path
  ^ bool
  p.starts('x)

+  kooked
  '  An empty myth carrying kook refs — full form-node paths.
  \  refs=row[path]
  ^  myth
  =  t  myth/new
  t.put(limb_slot (kook refs))
+  eyes
  '  The watcher index: watched path -> its cared watchers, in the
  '  same dep orientation as news (p is the watcher).
  axal[row[dep]]
+  hive
  '  The crew index: what each crew-bearing node WATCHES, keyed by
  '  that node's path — /eyes turned around.  The watcher index is a
  '  projection of it (/eyes_from), so keeping THIS across an event —
  '  bumping it from each round's signs (/hive_bump) rather than
  '  re-deriving it from the whole namespace — is what makes a
  '  reactive round cost the crews rather than the namespace.  It
  '  shares /eyes' representation deliberately: a fresh axal
  '  instantiation would be a fresh monomorphization to compile.
  axal[row[dep]]
+  lens
  '  The derived-watcher index: TRIGGER path -> lens eyes.  Each
  '  entry keeps the trigger care to test against a sign, and the
  '  watcher with its original derived dep, so the news speaks the
  '  subscriber's vocabulary (rely paths are the derived paths they
  '  named in their crew).
  axal[row[[tc=care od=dep w=path]]]
