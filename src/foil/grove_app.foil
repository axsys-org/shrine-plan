- grove_ui_runtime
- lain_peek

' A captured installed view, not an application-specific renderer registry.
' Capture follows its real weft/tack pins once. Rendering accepts a request-local
' record of named inputs and never writes it into the sovereign.
+ grove_app
  + binding
    : transform=spun input=axal[myth] fields=grove_role_schema declaration=myth authority=path
  + capture
    \ entry=path state=namespace
    ^ maybe[grove_app/binding]
    > (./known installed) (sovereign_view .x 0 entry state)
      .none
    < card installed.fil
    < held card.get(['sys 'weft])
    > renderer=safe held
      .none
    ? !(equal[care] renderer.care .x) .none
    ? (eq renderer.ver 0) .none
    < held card.get(['sys 'tack])
    > source=safe held
      .none
    ? !(equal[care] source.care .y) .none
    ? (eq source.ver 0) .none
    > (./known code) (sovereign_view renderer.care renderer.ver renderer.path state)
      .none
    < component code.fil
    < held component.get(['sys 'weft])
    > transform=spun held
      .none
    < held component.get(publisher_vocabulary/grove/sewn)
    > boundary=grove_sewn_schema held
      .none
    > (./known declaration) (sovereign_view .x 0 boundary.source state)
      .none
    < norm declaration.fil
    < held norm.get(publisher_vocabulary/grove/norm)
    > schema=grove_norm_schema held
      .none
    ' Named-record HTTP inputs require an own-record norm, not a subtree walk.
    ? schema.segments.len .none
    > (./known input) (sovereign_view source.care source.ver source.path state)
      .none
    = app (grove_app/binding transform input schema.item card [state.self])
    ; (DeepSeq[nat] app 0)
    | ./some app
  + project
    \ fields=grove_role_schema values=myth
    ^ myth
    | fields.fields.fold (myth/new)
    \ out field
    ? values.get([($ts field.name)])
     > (./some value) out.put(field.slot value)
     > .none out
  + render
    \ app=grove_app/binding values=myth
    ^ maybe[weft/node/el]
    = input (grove_app/project app.fields values)
      output (app.transform.get (myth/new) app.input.set_fil((./some input)))
    < record output.fil
    < html record.get(['html])
    | grove_html/read html
  + document
    ' The installed view declares its head assets and title. The HTTP adapter
    ' owns framing only; it does not choose application scripts or stylesheets.
    \ app=grove_app/binding body=weft/node/el
    ^ nat
    = title
        ?> (./some held) app.declaration.get(['sys 'lede]) "Application"
        > value=pails/t held
          "Application"
        | str/to_atom value.t
      assets
        ?> (./some held) app.declaration.get(['head]) []
        > head=weft/node/el held
          []
        head.kids
    | weft/page_with_assets title assets [body]
