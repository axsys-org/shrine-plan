-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  chore [order=70]
'  web: everything the namespace shows the outside world over HTTP —
'  the serving and fetching driver vocabularies (records in, records
'  out; the host workers only shuttle), the doctest driver's records,
'  and the namespace explorer rendered over weft.
+  show
  '  Namespace values as text.

  +  iota
    '  An iota as its canonical path-segment spelling — the iota_show
    '  jet, the exact inverse of the segment parser, so explorer URLs
    '  round-trip: symbols bare, nats decimal, strings $-sigiled,
    '  times/durations @-sigiled, binary 0w/0x.
    \  i=iota
    ^  nat
    (iota_show i)

  +  path
    '  A path as "/a/b"; the empty path as "/".
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/"
    =  parts
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx p.len)
            out
         (_ idx.inc out.snoc((show/iota p.at(idx))))
    (weft/cat2 "/" (weft/join "/" parts))

  +  tail
    '  The last segment of a brand cord: "/boot/doctest/verdict"
    '  becomes "verdict".
    '  ?=  ((show/tail "/boot/mani") "mani")
    \  b=nat
    ^  nat
    |  > rest=nat b  > cur=nat 0
    ?  (eq rest 0)
       cur
    =  c  (mod rest 256)
    ?  (eq c "/")
       (_ (div rest 256) 0)
    (_ (div rest 256) (add cur (lsh c (mul 8 (wid cur)))))

  +  textish
    '  Printable-with-whitespace prose (what pails/t carries): the
    '  degrade rule would render it as a decimal blob, quoting reads.
    \  v=nat
    ^  bool
    ?  (eq v 0)
       .false
    |  > rest=nat v  > seen=nat 0
    ?  (eq rest 0)
       seen
    =  c  (mod rest 256)
    ?  (eq c 10)
       (_ (div rest 256) seen)
    ?  (lt c 32)
       .false
    ?  (gt c 126)
       .false
    ?  (eq c " ")
       (_ (div rest 256) 1)
    (_ (div rest 256) seen)

  +  clip
    '  The first n bytes, an ellipsis when clipped.
    \  n=nat s=nat
    ^  nat
    ?  (le (wid s) n)
       s
    (weft/cat2 (mod s (weft/bex8 n)) "…")

  +  leaf
    '  A bare nat with no type in sight: brand-cord constants (the
    '  arity-0 nominals — care/x, mode/add, writ/cull) render as
    '  their relvar spelling, prose quotes and clips, everything
    '  else follows the aura degrade rule (nat_show).
    '  ?=  ((show/leaf "/boot/care/x") ".x")
    '  ?=  ((show/leaf 41) "41")
    \  v=nat
    ^  nat
    ?  (eq "/" (mod v 256))
       (weft/cat2 "." (show/tail v))
    ?  (show/textish v)
       (weft/cat [34 (show/clip 42 v) 34])
    (nat_show v)

  +  lines
    '  Newline count + 1: how many lines a text renders as.
    \  s=nat
    ^  nat
    |  > rest=nat s  > n=nat 1
    ?  (eq rest 0)
       n
    ?  (eq 10 (mod rest 256))
       (_ (div rest 256) n.inc)
    (_ (div rest 256) n)

  +  aura_tag
    '  Is b one of the fourteen aura tag cords (an iota's head)?
    \  b=nat
    ^  bool
    ?  (eq b "dm") .true
    ?  (eq b "dr") .true
    ?  (eq b "ds") .true
    ?  (eq b "f")  .true
    ?  (eq b "r")  .true
    ?  (eq b "rd") .true
    ?  (eq b "rs") .true
    ?  (eq b "s")  .true
    ?  (eq b "ta") .true
    ?  (eq b "ts") .true
    ?  (eq b "tu") .true
    ?  (eq b "u")  .true
    ?  (eq b "w")  .true
    ?  (eq b "x")  .true
    .false

  +  reg
    '  The reflection registry: (^ T) of a nominal row reflects to a
    '  rec whose cstr IS the runtime brand and whose items carry the
    '  field faces — slot values with these brands render faced.
    ^  row[type]
    [(^ mani) (^ doctest/verdict) (^ kook/decl) (^ dep) (^ lore)]

  +  nom_named
    '  Does a reflected reference name this type?  Descriptor paths
    '  may be unit-qualified ("~"-headed) — the last segment is the
    '  name that matters here.
    \  pth=row[nat] name=nat
    ^  bool
    ?  (eq 0 pth.len)
       .false
    (eq pth.at(pth.len.dec) name)

  +  reg_of
    '  The registry rec for a brand, or .none.
    \  b=nat
    ^  maybe[type]
    =  rs  show/reg
    |  > idx=nat 0
    ^  maybe[type]
    ?  (eq idx rs.len)
       .none
    ?  rs.at(idx)
     > (./rec cstr items)
       ?  (eq cstr b)
          (./some rs.at(idx))
       (_ idx.inc)
    (_ idx.inc)

  +  value
    '  Any runtime value as text, reflection-guided: pins are
    '  invisible, branded rows render name{face=..} through the
    '  registry (positionally without it), iotas by their spelling,
    '  rows in brackets, bare nats by /show/leaf .  Depth-capped.
    \  v=any depth=nat
    ^  nat
    ?  (rep_pin v)
       (show/value (rep_unpin v) depth)
    ?  (rep_law v)
       "law"
    ?  !(rep_app v)
       (show/leaf v)
    =  h  (rep_hd v)
    ?  (eq h 0)
       (show/items "[" "]" v depth)
    ?  (show/aura_tag h)
       ?  (eq 1 (rep_sz v))
          (iota_show v)
       (show/pos h v depth)
    ?  (eq "/boot/form" h)
       "form"
    ?  (eq "/boot/mop/node" h)
       (show/tree v depth)
    ?  (eq "/boot/uon/node" h)
       (show/tree v depth)
    ?  (eq "/" (mod h 256))
       (show/branded h v depth)
    "law"

  +  tree
    '  An ordered-map node (mop/uon internals share the shape
    '  [sz key val l r]) as its entries: {k→v ..}, width-capped —
    '  the tree is an implementation detail, the map is the value.
    \  v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       "{..}"
    =  parts
         |  > todo=row[any] [v]  > out=row[nat] []
         ?  (eq 0 todo.len)
            out
         ?  (gt out.len 5)
            out.snoc("..")
         =  n  todo.at(0)
            rest  todo.drop(1)
         ?  !(rep_app n)
            (_ rest out)
         ?  (eq 5 (rep_sz n))
            (_ rest.cons((rep_ix 3 n)).cons((rep_ix 4 n))
               out.snoc(
                 (weft/cat [(show/value (rep_ix 1 n) depth.inc) "→"
                            (show/value (rep_ix 2 n) depth.inc)])))
         (_ rest out)
    (weft/cat ["{" (weft/join " " parts) "}"])

  +  items
    '  A row's elements, width-capped at eight.
    \  open=nat close=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       (weft/cat [open ".." close])
    =  n  (rep_sz v)
       cap
         ?  (lt n 9)
            n
         8
       parts
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx cap)
            out
         (_ idx.inc out.snoc((show/value (rep_ix idx v) depth.inc)))
       extra
         ?  (lt cap n)
            (weft/cat [" +" (weft/show_nat (sub n cap))])
         ""
    (weft/cat [open (weft/join " " parts) extra close])

  +  branded
    '  A branded row: faced through the registry when its rec is
    '  known (path-typed fields as paths), positional otherwise.
    \  h=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       (weft/cat2 (show/tail h) "{..}")
    ?  (show/reg_of h)
     > .none  (show/pos h v depth)
     > (./some d)
       ?  d
        > (./rec cstr items)
          ?  !(eq items.len (rep_sz v))
             (show/pos h v depth)
          =  parts
               |  > idx=nat 0  > out=row[nat] []
               ?  (eq idx items.len)
                  out
               =  [face=nat item=type]  items.at(idx)
                  fv
                    '  descriptor-directed: paths as paths, empty
                    '  rows as [] (an empty row IS nat 0 — only the
                    '  type knows the difference)
                    ?  item
                     > (./nom pth args)
                       ?  (show/nom_named pth "path")
                          (show/path (rep_ix idx v))
                       ?  (show/nom_named pth "row")
                          ?  !(rep_app (rep_ix idx v))
                             "[]"
                          (show/value (rep_ix idx v) depth.inc)
                       (show/value (rep_ix idx v) depth.inc)
                     > (./arr item2)
                       ?  !(rep_app (rep_ix idx v))
                          "[]"
                       (show/value (rep_ix idx v) depth.inc)
                    (show/value (rep_ix idx v) depth.inc)
                  part
                    ?  (eq face idx)
                       fv
                    (weft/cat [(tyshow/atom_text face) "=" fv])
               (_ idx.inc out.snoc(part))
          (weft/cat [(show/tail h) "{" (weft/join " " parts) "}"])
       (show/pos h v depth)

  +  pos
    '  A branded row without a registry rec: positional fields.
    \  h=nat v=any depth=nat
    ^  nat
    (weft/cat2 (show/tail h) (show/items "(" ")" v depth))

  +  pail
    '  A slot value as text: the payloads this layer knows bespoke,
    '  and the reflection-guided walker for the open remainder.
    \  held=pail
    ^  nat
    ?  held
     > x=pails/n   (weft/show_nat x.n)
     > q=pails/q   (show/iota q.q)
     > p=pails/p   (show/path p.p)
     > k=kook
       =  parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx k.refs.len)
               out
            (_ idx.inc out.snoc((show/path k.refs.at(idx))))
       (weft/cat2 "kook " (weft/join " " parts))
     > c=cpail
       =  entries  c.crew.tap
          parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx entries.len)
               out
            =  e  entries.at(idx)
               cn
                 ?  e.val.c
                  > .x  "x"
                  > .y  "y"
                  > .z  "z"
            (_ idx.inc
               out.snoc((weft/cat [cn "→" (show/path e.val.p)])))
       (weft/cat2 "crew " (weft/join "  " parts))
     > ps=pails/ps
       =  parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx ps.ps.len)
               out
            (_ idx.inc out.snoc((show/path ps.ps.at(idx))))
       (weft/join "  " parts)
     > form         "form"
     > t=pails/t    t.t
     > d=pails/ty   (tyshow/show d.t)
     > pails/code   "code"
     > dyed           "dyed overlay"
     > knit           "knit overlay"
     > felt           "felt overlay"
     > sewn           "sewn overlay"
     > weft/node/tx   "html fragment"
     > weft/node/raw  "html fragment"
     > weft/node/el   "html fragment"
     > doc=lore
       ?  (eq 0 doc.tests.len)
          doc.head
       (weft/cat [doc.head "  [?= " (weft/show_nat doc.tests.len) "]"])
    (show/value held 0)
+  http
  '  The inbound-HTTP driver vocabulary: driver configs, request
  '  records, and the behaviors the serving kook installs.

  +  respond_talk
    '  The responder the serving kook installs on a request node: the
    '  installing poke's talk answers 200, echoing the request's body
    '  slot (or its url when there is no body).
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       pay=pail
         ?  out.get(['body])
          > (./some held=pail)  held
          > .none
            ?  out.get(['url])
             > (./some held=pail)  held
             > .none  (pd 0)
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] pay)
    (yell [] done)

  +  respond_form
    ^  form
    def_form.set_talk(http/respond_talk)

  +  serve_take
    '  The serving kook for an HTTP driver node: when a request node
    '  appears underneath (an added direct kid in the gift), emit a
    '  poke installing the configured responder kook on it — the same
    '  poke's talk then writes the response, all within the event.
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    >  (./some rid=iota) cur.quip_at(['serve])
       (yell [] cur)
    =  events  gift.tap
    |  > idx=nat 0  > cards=row[[p=path q=writ]] []
    ?  (eq idx events.len)
       (yell cards cur)
    =  [at act]  events.at(idx)
    ?  ?=(.add act)
       ?  (eq 1 at.len)
          =  card  (kooked [kook_root.snoc(rid)])
          (_ idx.inc cards.snoc([bowl.here.weld(at) (writ/poke card)]))
       (_ idx.inc cards)
    (_ idx.inc cards)

  +  serve_form
    ^  form
    def_form.set_take(http/serve_take)

  +  cfg
    '  The record for an HTTP driver node: the serving kook plus the
    '  responder id it installs on request nodes.
    \  rid=iota
    ^  myth
    (kooked [['kook 'hserve]]).put(['serve] (pails/q rid))

  +  cfg_port
    '  A live driver config: serving kook, responder id, and the TCP
    '  port (the worker reads it at birth, so it must ride the make).
    \  rid=iota port=nat
    ^  myth
    (http/cfg rid).put(['port] (pd port))

  +  face_at
    '  The face-kook path at the target's depth-n prefix: an app
    '  mounted at /app/<name> keeps its face at depth two, an app
    '  mounted at a root of its own (/chat) at depth one.  The probe
    '  is a crew dep, so a missing face node hydrates empty and costs
    '  nothing.  none for shallow targets and the derived overlays.
    \  n=nat tgt=path
    ^  maybe[path]
    ?  (lt tgt.len n)
       .none
    ?  (is_h tgt)
       .none
    ?  (is_o tgt)
       .none
    =  root=path  tgt.take(n)
    (./some root.weld(['kook 'face]))

  +  face_of
    '  The form riding a hydrated face view, if any: the same
    '  ['form]-slot pail extraction resolve performs on kook refs.
    \  fv=axal[myth]
    ^  maybe[form]
    ?  fv.fil
     > .none  .none
     > (./some ft=myth)
       ?  ft.get(['form])
        > .none  .none
        > (./some fp=pail)
          ?  fp
           > f=form  (./some f)
          .none

  +  req
    '  An HTTP request as a namespace record: method, url and body
    '  ride as data pails, the parsed target as a pails/p, a z-care
    '  dep on the target so responders get its hydrated view, and —
    '  for live targets — a y-care dep on the target's /h/v version
    '  view.  App-rooted targets also dep the app's face node so the
    '  responder can dispatch to it.  Every ordinary request receives
    '  read-only views of the Foundry corpus and Zoo registry, letting
    '  an app face compile a ProjectionRequest without owning either
    '  source.  Chat additionally receives the Nenex authoring corpus as
    '  a read-only deep Sight: the face may admit authored semantic records,
    '  but it cannot mutate the wiki or smuggle authoring state into another
    '  app.  Chat also receives the exact /chat/actions/send declaration as a
    '  separate read-only x Sight.  This observes source-owned Action evidence;
    '  it neither folds that identity into /chat/source nor grants it.  Candidate
    '  faces at depths one and two retain distinct
    '  source Sights: probing a missing deeper face must never overwrite the
    '  source paired with the shallower face that ultimately answers.
    '  Missing roots hydrate empty.  No kook: the serving kook above installs
    '  one.
    \  method=nat url=nat body=nat tgt=path
    ^  myth
    =  base
         .  (myth/new)
            put(['method] (pd method))
            put(['url] (pd url))
            put(['body] (pd body))
            put(['vpath] (pails/p tgt))
       watch=crew
         =  base_sight
              .  (crew/sing ['view] (dep .z tgt))
                 put(['foundry] (dep .z ['foundry]))
                 put(['zoo] (dep .z zoo/root))
         =  authored_sight
              ?  (eq 0 tgt.len)
                 base_sight
              ?  (eq_iota tgt.at(0) 'chat)
                 base_sight.put(['foundry_authored] (dep .z ['nenex 'w]))
              base_sight
         =  action_sight
              ?  (eq 0 tgt.len)
                 authored_sight
              ?  (eq_iota tgt.at(0) 'chat)
                 authored_sight.put(['face_action]
                   (dep .x ['chat 'actions 'send]))
              authored_sight
         =  sight1
              ?  (http/face_at 1 tgt)
               > (./some fp=path)
                 =  source1=path  fp.take((sub fp.len 2))
                 .  action_sight
                    put(['face1] (dep .x fp))
                    put(['face_source1]
                      (dep .x source1.snoc('source)))
               > .none  action_sight
         =  sight
              ?  (http/face_at 2 tgt)
               > (./some fp2=path)
                 =  source2=path  fp2.take((sub fp2.len 2))
                 .  sight1
                    put(['face2] (dep .x fp2))
                    put(['face_source2]
                      (dep .x source2.snoc('source)))
               > .none  sight1
         ?  (is_h tgt)
            sight
         ?  (is_o tgt)
            sight
         ?  (eq 0 tgt.len)
            sight
         =  vroot=path  ['h 'v ($u tgt.len)]
         sight.put(['ver] (dep .y vroot.weld(tgt)))
    base.put(crew_slot (cpail watch))
+  frag
  '  The fragment vocabulary: components are overlay ctors whose
  '  derived records carry markup (a weft/node at ['html]), applied
  '  through /o and served bare over the /frag route.  Containers
  '  mount them as w-get elements the /w.js runtime keeps fresh
  '  (weft/runtime documents the attribute set).

  +  url
    '  The fragment URL applying the component node at op to the
    '  data at dp: /frag/1/olen/...op/dlen/...dp.  The function pin
    '  is hardcoded to x case 1 per the write-once component
    '  convention (pact/weft_card): components mount once and never
    '  change in place, so their first mint is their only mint.
    \  op=path dp=path
    ^  nat
    (weft/cat ["/frag/1/" (weft/show_nat op.len) (show/path op) "/" (weft/show_nat dp.len) (show/path dp)])

  +  report_url
    '  Read an already-composed projection report.  Unlike url, this
    '  does not reconstruct one op+data pair: nested /o chains and
    '  other admitted report paths survive byte-for-byte.
    \  report=path
    ^  nat
    (weft/cat ["/project/" (weft/show_nat report.len) (show/path report)])

  +  care_text
    \  c=care
    ^  nat
    ?  c
     > .x  "x"
     > .y  "y"
     > .z  "z"

  +  report_watch_url
    '  One exact cared observation URL for a composed report and the
    '  case already held by the caller.
    \  report=path c=care after=nat
    ^  nat
    (weft/cat
      ["/observe/" (frag/care_text c) "/" (weft/show_nat after) "/"
       (weft/show_nat report.len) (show/path report)])

  +  report_watch_template
    '  The browser-runtime form of report_watch_url: $case is replaced
    '  after each successful one-shot wake.
    \  report=path c=care
    ^  nat
    (weft/cat
      ["/observe/" (frag/care_text c) "/$case/"
       (weft/show_nat report.len) (show/path report)])

  +  watch_template
    '  Compatibility observation URL for a legacy op+data mount.
    \  op=path dp=path c=care
    ^  nat
    (weft/cat
      ["/watch/" (frag/care_text c) "/$case/1/"
       (weft/show_nat op.len) (show/path op) "/"
       (weft/show_nat dp.len) (show/path dp)])

  +  html
    '  A component result: markup at ['html].  The node rides the
    '  pail as its branded member row (sums do not inhabit pails),
    '  so a fragment's root is always an element.
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  myth
    (myth/new).put(['html] (weft/node/el tag as kids))

  +  mount
    '  A fragment mount: an empty element the runtime fills from one
    '  read-only projection fetch, then keeps current through cared,
    '  one-shot observations.  The server-side first paint is absent
    '  so component output is never duplicated into container code.
    \  id=nat op=path dp=path c=care
    ^  weft/node
    =  > ct  (frag/care_text c)
    (weft/el "div"
      [(weft/att "id" id)
       (weft/att "w-get" (frag/url op dp))
       (weft/att "w-watch" ct)
       (weft/att "w-observe" (frag/watch_template op dp c))]
      [])

  +  mount_report
    '  Mount an arbitrary, already-composed report.  SurfaceTree Hole
    '  nodes use this boundary so resolving one hole neither rebuilds
    '  nor re-identifies the surrounding projection.
    \  id=nat report=path c=care
    ^  weft/node
    (weft/el "div"
      [(weft/att "id" id)
       (weft/att "w-get" (frag/report_url report))
       (weft/att "w-watch" (frag/care_text c))
       (weft/att "w-observe" (frag/report_watch_template report c))]
      [])

  +  script
    '  The runtime include for container pages.
    ^  weft/node
    (weft/el "script" [(weft/att "src" "/w.js")] [])

  +  as_node
    '  A pail as a weft/node, when it holds one: node values ride
    '  pails as their branded member rows (the ['html] slot of a
    '  component's derived record), so consumers rebuild the sum.
    '  Lives here rather than in weft — weft is import-free and
    '  knows neither pail nor maybe.
    \  held=pail
    ^  maybe[weft/node]
    ?  held
     > t=weft/node/tx   (./some (./tx t.s))
     > r=weft/node/raw  (./some (./raw r.s))
     > e=weft/node/el   (./some (./el e.tag e.as e.kids))
    .none

  +  render
    '  Render one hydrated fragment record without creating a
    '  request occurrence.  The host's /frag query bridge uses this
    '  pure boundary; talk below retains the namespace responder form.
    \  t=myth
    ^  row[nat]
    ?  t.get(['html])
     > .none  [404 "no html slot"]
     > (./some held=pail)
       ?  (frag/as_node held)
        > .none  [404 "html slot is not markup"]
        > (./some nd=weft/node)  [200 (weft/render nd)]

  +  talk
    '  The fragment responder: the hydrated derived record at the /o
    '  target, its ['html] node rendered bare — no shell, no chrome.
    '  Anything short of markup is a 404 with a terse reason.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ans
         ^  row[nat]
         ?  view.fil
          > .none  [404 "no fragment at this path"]
          > (./some t=myth)  (frag/render t)
       done
         .  out
            put(['res_status] (pd ans.at(0)))
            put(['res_body] (pd ans.at(1)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    (yell [] done)
+  fetch
  '  The outbound-HTTP driver vocabulary: requests and their answers
  '  ride as records; the driver record's markers are the worker's
  '  notifications.

  +  take
    '  The driver inbox kook: when a request node appears underneath
    '  (an added direct kid in the gift), mark it fresh on the driver
    '  node itself — helm x-watches each /io name's own record, so
    '  the write IS the worker's notification.  A culled kid clears
    '  its marker (pokes cannot delete slots, so markers are
    '  overwritten to 0, never removed).
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    =  events  gift.tap
    |  > idx=nat 0  > tale=myth cur
    ?  (eq idx events.len)
       (yell [] tale)
    =  [at act]  events.at(idx)
    ?  (eq 1 at.len)
       ?  ?=(.add act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 1)))
       ?  ?=(.del act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 0)))
       (_ idx.inc tale)
    (_ idx.inc tale)

  +  form
    ^  form
    def_form.set_take(fetch/take)

  +  cfg
    '  The record for an outbound-HTTP driver node: just the fetch
    '  kook — requests carry their own config.
    ^  myth
    (kooked [['kook 'hfetch]])

  +  req
    '  An outbound fetch request as a namespace record: method, url,
    '  body (0 = none) and deadline (ms, required nonzero) ride as
    '  data pails.  Optional slots the driver honors: ['connect]
    '  ['redirects] ['maxbody], plus one ['hdr <name>] per request
    '  header.  The driver answers by poking ['res_done] ['res_ok]
    '  and the res_* payload slots onto the node — the requester's
    '  own kook (or a crew dep on the node) consumes them.
    \  method=nat url=nat body=nat deadline=nat
    ^  myth
    .  (myth/new)
       put(['method] (pd method))
       put(['url] (pd url))
       put(['body] (pd body))
       put(['deadline] (pd deadline))

  +  fresh
    '  The pending request kids marked on a driver record: keys
    '  ['fresh <kid>] whose value is 1.
    \  tale=myth
    ^  path
    =  slots  tale.tap
    |  > idx=nat 0  > out=path []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
       live
         ?  (eq 2 slot.key.len)
            ?  (eq_iota slot.key.at(0) 'fresh)
               ?  slot.val
                > x=pails/n  x.n
               0
            0
         0
    ?  live
       (_ idx.inc out.snoc(slot.key.at(1)))
    (_ idx.inc out)

  +  hdrs
    '  Request headers from a record: one [name value] per
    '  ['hdr <name>] slot (names unique, order unspecified).
    \  tale=myth
    ^  row[[n=nat v=nat]]
    =  slots  tale.tap
    |  > idx=nat 0  > out=row[[n=nat v=nat]] []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
    ?  (eq 2 slot.key.len)
       ?  (eq_iota slot.key.at(0) 'hdr)
          =  val
               ?  slot.val
                > x=pails/n  x.n
               0
          (_ idx.inc out.snoc([(quip_val slot.key.at(1)) val]))
       (_ idx.inc out)
    (_ idx.inc out)

  +  res_ok
    '  The response myth the driver pokes onto a request node when
    '  the transfer completed: the final status/url/headers/body plus
    '  the ['res_done] completion marker.
    \  status=nat url=nat headers=nat body=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 1))
       put(['res_status] (pd status))
       put(['res_url] (pd url))
       put(['res_hdrs] (pd headers))
       put(['res_body] (pd body))

  +  res_err
    '  The response myth for a failed fetch: the driver's error code
    '  (0 bad-url, 1 dns, 2 connect, 3 tls, 4 deadline, 5 redirects,
    '  6 too-large, 7 protocol).
    \  code=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 0))
       put(['res_err] (pd code))
+  dt
  '  The doctest driver's records.

  +  req
    '  A doctest request as a namespace record: the target's mirror
    '  path (an exact documented node, or a /boot prefix to sweep)
    '  rides as a pails/p.  The driver answers by poking ['res_done]
    '  ['passed] ['failed] onto this node and the ['dt] verdicts onto
    '  the targets themselves.
    \  tgt=path
    ^  myth
    (myth/new).put(['target] (pails/p tgt))

  +  cfg
    '  The record for a doctest driver node: the shared chore driver
    '  config, defaulting requests to the doctest family — requests
    '  carry their target, verdicts land on the documented nodes.
    ^  myth
    (chore/cfg 'doctest)
+  explorer
  '  The namespace explorer: the /ns node browser served over HTTP.

  +  css
    '  The explorer stylesheet: dark, monospaced, panes as cards and
    '  slots on a two-column grid.
    ^  nat
    "body{background:#101418;color:#cfd8dc;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;margin:0;padding:1.6em 1.4em;line-height:1.45} main{max-width:72rem;margin:0 auto} a{color:#7fd4c1;text-decoration:none} a:hover{text-decoration:underline} h1{color:#f0b429;font-size:15px;margin:0;font-weight:600} .top{display:flex;justify-content:space-between;align-items:baseline;gap:1em;padding-bottom:10px;border-bottom:1px solid #2a333b} h2{color:#8fa1ab;font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;font-weight:600} .pane{border:1px solid #232d36;border-radius:8px;padding:12px 14px;margin:14px 0;background:#12171c} .slots{display:grid;grid-template-columns:minmax(9rem,16rem) 1fr;gap:3px 16px;align-items:baseline} .key{color:#f0b429;text-align:right;overflow-wrap:anywhere} .val{min-width:0} .row{padding:3px 8px;border-bottom:1px solid #1d252d;display:flex;gap:10px;align-items:baseline} .row:last-child{border-bottom:none} .row:hover{background:#161c22} pre{white-space:pre-wrap;margin:0;color:#cfd8dc;overflow-wrap:anywhere} .muted{color:#6b7680} .lore-head{color:#e8edf0;font-size:14px;margin:12px 0 2px} .lore-body{color:#8fa1ab;margin:2px 0 10px} .lore-line{padding:1px 0} .khead{margin-left:14px} .chip{padding:1px 7px;border-radius:9px;font-size:11px;margin-left:10px;white-space:nowrap} .ok{background:#123f2a;color:#7fd4a1} .bad{background:#4a1520;color:#f08a9b} .mut{background:#242e36;color:#8fa1ab} .dtsrc{color:#cdd7dc} .tysig{color:#9fc0dd;display:inline-block;vertical-align:top} .care{padding:0 6px;border-radius:8px;font-size:11px;margin-right:6px;background:#242e36} .care-x{color:#7fd4c1} .care-y{color:#f0b429} .care-z{color:#f08a9b} .case{padding:0 6px;border-radius:6px} .cur{background:#2a333b;color:#f0b429} .failpane{border-color:#5c1f28;background:#1a1114} .failpane h2{color:#f08a9b} details>summary{cursor:pointer;color:#8fa1ab;font-size:12px;margin-bottom:6px} input,textarea,button{background:#0c1014;color:#cfd8dc;border:1px solid #2a333b;border-radius:5px;font-family:inherit;font-size:12px;padding:4px 8px} button{cursor:pointer;color:#7fd4c1}"

  +  url
    '  The explorer href for a path.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/ns"
    (weft/cat2 "/ns" (show/path p))

  +  rows
    '  Weld a row of node rows into one page body.
    \  parts=row[row[weft/node]]
    ^  row[weft/node]
    |  > idx=nat 0  > out=row[weft/node] []
    ?  (eq idx parts.len)
       out
    (_ idx.inc out.weld(parts.at(idx)))

  +  forms
    '  The workspace forms on a /boot module page: evaluate an
    '  expression against the module's subject, or edit and save its
    '  source — both plain POSTs to the /chore bridge, answered as
    '  text by the build chore families.
    \  tgt=path src=nat
    ^  row[weft/node]
    =  modp  (show/path tgt.drop(1))
       evalf
         (weft/el "form" [(weft/att "method" "post") (weft/att "action" (weft/cat2 "/chore/eval" modp))]
           [(weft/el "input" [(weft/att "name" "expr") (weft/att "size" "80")] [])
            (weft/leaf "button" [] "eval")])
       savef
         (weft/el "form" [(weft/att "method" "post") (weft/att "action" (weft/cat2 "/chore/save" modp))]
           [(weft/el "textarea" [(weft/att "name" "src") (weft/att "rows" "24") (weft/att "cols" "100")] [(weft/tx src)])
            (weft/el "div" [] [(weft/leaf "button" [] "save & recompile")])])
    [(weft/leaf "h2" [] "workspace") evalf savef]

  +  act
    '  The write box: emit a make, poke, or cull at this node from
    '  the explorer.  The expression evaluates against the boot
    '  subject to the writ's myth (ignored for cull); the POST rides
    '  /vine/<path> and the http worker emits the task as an
    '  ordinary driver cmd.
    \  tgt=path
    ^  row[weft/node]
    [(weft/leaf "h2" [] "act")
     (weft/el "form"
       [(weft/att "method" "post")
        (weft/att "action" (weft/cat2 "/vine" (show/path tgt)))]
       [(weft/el "select" [(weft/att "name" "verb")]
          [(weft/leaf "option" [] "poke")
           (weft/leaf "option" [] "make")
           (weft/leaf "option" [] "cull")])
        (weft/tx " ")
        (weft/el "input"
          [(weft/att "name" "expr") (weft/att "size" "70")
           (weft/att "placeholder" "(myth/sing ['n] (pd 41))")] [])
        (weft/tx " ")
        (weft/leaf "button" [] "emit")])]

  +  case_count
    '  Read one decimal counter from a version-view myth.
    \  key=path tale=myth
    ^  nat
    >  (./some n=nat) (dig_parse tale.txt_at(key))
       0
    n

  +  case_links
    '  Links for one target-local care history, cases 1 through n —
    '  a compact scrubber with the current case highlighted.
    \  care=iota n=nat tgt=path
    ^  row[weft/node]
    |  > idx=nat 1  > out=row[weft/node] []
    ?  (gt idx n)
       out
    =  hist=path  ['h care ($u idx) ($u tgt.len)]
       cl
         ?  (eq idx n)
            "case cur"
         "case"
       link
         (weft/leaf "a"
           [(weft/href (explorer/url hist.weld(tgt))) (weft/cls cl)]
           (show/iota ($u idx)))
    (_ idx.inc out.snoc((weft/tx " ")).snoc(link))

  +  slot_val
    '  One slot value as HTML: linked paths and modules, long texts
    '  folded behind details, crew and kook structure, and the
    '  reflection walker for the open remainder.
    \  key=path held=pail
    ^  weft/node
    ?  held
     > t=pails/t
       ?  (eq_pith key ['module])
          (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" t.t))] t.t)
       ?  (gt (show/lines t.t) 15)
          (weft/el "details" []
            [(weft/leaf "summary" []
               (weft/cat2 (weft/show_nat (show/lines t.t)) " lines"))
             (weft/leaf "pre" [] t.t)])
       (weft/leaf "pre" [] t.t)
     > d=pails/ty
       (weft/leaf "pre" [(weft/cls "tysig")] (tyshow/pretty d.t))
     > p=pails/p
       (weft/leaf "a" [(weft/href (explorer/url p.p))] (show/path p.p))
     > ps=pails/ps
       =  links
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j ps.ps.len)
               out
            =  link
                 (weft/leaf "a" [(weft/href (explorer/url ps.ps.at(j)))]
                   (show/path ps.ps.at(j)))
            (_ j.inc out.snoc((weft/tx "  ")).snoc(link))
       (weft/el "span" [] links)
     > c=cpail
       =  entries  c.crew.tap
          crewrows
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j entries.len)
               out
            =  e  entries.at(j)
               cn
                 ?  e.val.c
                  > .x  "x"
                  > .y  "y"
                  > .z  "z"
            (_ j.inc
               out.snoc(
                 (weft/el "div" []
                   [(weft/leaf "span" [(weft/cls (weft/cat2 "care care-" cn))] cn)
                    (weft/leaf "a" [(weft/href (explorer/url e.val.p))]
                      (show/path e.val.p))
                    (weft/leaf "span" [(weft/cls "muted khead")]
                      (show/path e.key))])))
       (weft/el "div" [] crewrows)
     > k=kook
       =  links
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j k.refs.len)
               out
            =  link
                 (weft/leaf "a" [(weft/href (explorer/url k.refs.at(j)))]
                   (show/path k.refs.at(j)))
            (_ j.inc out.snoc((weft/tx "  ")).snoc(link))
       (weft/el "span" [] links)
    (weft/leaf "pre" [(weft/cls "val")] (show/pail held))

  +  dt_chip
    '  One doctest's verdict chip: pass/got from the verdict's
    '  results, greyed when the verdict's case is behind the node's
    '  current x case (curx as decimal text; 0 = unknown, no
    '  staleness call).
    \  verdict=doctest/verdict curx=nat j=nat
    ^  weft/node
    =  stale
         ?  (eq 0 curx)
            0
         !(eq curx (weft/show_nat verdict.case))
    ?  (ge j verdict.results.len)
       (weft/leaf "span" [(weft/cls "chip mut")] "no result")
    ?  stale
       (weft/leaf "span" [(weft/cls "chip mut")] (weft/cat2 "stale v" (weft/show_nat verdict.case)))
    =  [_ pass got]  verdict.results.at(j)
    ?  pass
       (weft/leaf "span" [(weft/cls "chip ok")] "pass")
    (weft/leaf "span" [(weft/cls "chip bad")] (weft/cat2 "got " got))

  +  dt_row1
    '  One rendered doctest row.
    \  src=nat want=nat chip=weft/node
    ^  weft/node
    (weft/el "div" [(weft/cls "row")]
      [(weft/tx "?=  ")
       (weft/leaf "span" [(weft/cls "dtsrc")] src)
       (weft/tx "  ->  ")
       (weft/leaf "span" [(weft/cls "dtsrc")] want)
       chip])

  +  dt_rows
    '  A lore's doctests with verdict chips.
    \  doc=lore verdict=doctest/verdict curx=nat
    ^  row[weft/node]
    |  > j=nat 0  > out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    (_ j.inc out.snoc((explorer/dt_row1 src want (explorer/dt_chip verdict curx j))))

  +  dt_rows_never
    '  A lore's doctests, never yet run.
    \  doc=lore
    ^  row[weft/node]
    |  > j=nat 0  > out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    (_ j.inc out.snoc((explorer/dt_row1 src want (weft/leaf "span" [(weft/cls "chip mut")] "never run"))))

  +  page
    '  The node browser: breadcrumbs, the node's own lore (head,
    '  body, and doctests with verdict chips from the /dt kid), the
    '  record's slots (paths as links), kid links annotated with
    '  their lore heads — plus time travel: the node's version view
    '  with links into its history, and a live link back out of /h
    '  pages.
    \  tgt=path view=axal[myth] ver=axal[myth]
    ^  nat
    =  root  (weft/leaf "a" [(weft/href "/ns")] "ns")
       crumbs
         |  > idx=nat 0  > out=row[weft/node] [root]
         ?  (eq idx tgt.len)
            out
         =  pre   tgt.take(idx.inc)
            link  (weft/leaf "a" [(weft/href (explorer/url pre))] (show/iota tgt.at(idx)))
         (_ idx.inc out.snoc((weft/tx " / ")).snoc(link))
       nav
         =  hlnk  (weft/leaf "a" [(weft/href "/ns/h") (weft/cls "muted")] "time travel")
         ?  (is_h tgt)
            ?  (lt tgt.len 3)
               [hlnk]
            =  shift
                 ?  (eq_iota tgt.at(1) 'v)
                    3
                 4
            ?  (lt tgt.len shift)
               [hlnk]
            =  live  tgt.drop(shift)
               llnk  (weft/leaf "a" [(weft/href (explorer/url live))] "view live")
            [hlnk (weft/tx " | ") llnk]
         [hlnk]
       curx
         ?  ver.fil
          > (./some tale=myth)  tale.txt_at(['x_data])
          > .none  0
       docpane
         ?  view.fil
          > .none  []
          > (./some tale=myth)
            ?  tale.get(bond/help)
             > .none  []
             > (./some held=pail)
               ?  held
                > doc=lore
                  =  bodyrows
                       |  > j=nat 1  > out=row[weft/node] []
                       ?  (ge j doc.body.len)
                          out
                       (_ j.inc out.snoc((weft/leaf "div" [(weft/cls "lore-line")] doc.body.at(j))))
                     bodynode
                       ?  (gt doc.body.len 7)
                          (weft/el "details" []
                            [(weft/leaf "summary" [] "more")
                             (weft/el "div" [] bodyrows)])
                       (weft/el "div" [] bodyrows)
                     testrows
                       ?  view.dip(['dt]).fil
                        > (./some dtale=myth)
                          ?  dtale.get(['dt])
                           > (./some held2=pail)
                             ?  held2
                              > verdict=doctest/verdict  (explorer/dt_rows doc verdict curx)
                             (explorer/dt_rows_never doc)
                           > .none  (explorer/dt_rows_never doc)
                        > .none  (explorer/dt_rows_never doc)
                     headrows
                       [(weft/el "div" [(weft/cls "lore-head")] [(weft/tx doc.head)])
                        (weft/el "div" [(weft/cls "lore-body")] [bodynode])]
                  headrows.weld(testrows)
               []
       slotcells
         '  [data-cells sys-cells]: each slot is a key cell and a
         '  value cell on the .slots grid; /sys slots split out into
         '  their own pane.
         ?  view.fil
          > .none  [[] []]
          > (./some tale=myth)
            =  entries  tale.tap
            |  > idx=nat 0  > dat=row[weft/node] []  > sys=row[weft/node] []
            ?  (eq idx entries.len)
               [dat sys]
            =  slot  entries.at(idx)
            ?  (eq_pith slot.key bond/help)
               (_ idx.inc dat sys)
            ?  (eq_pith slot.key bond/lede)
               (_ idx.inc dat sys)
            =  keyn  (weft/el "div" [(weft/cls "key")] [(weft/tx (show/path slot.key))])
               valn  (weft/el "div" [(weft/cls "val")] [(explorer/slot_val slot.key slot.val)])
            ?  (eq 0 slot.key.len)
               (_ idx.inc dat.snoc(keyn).snoc(valn) sys)
            ?  (eq_iota slot.key.at(0) 'sys)
               (_ idx.inc dat sys.snoc(keyn).snoc(valn))
            (_ idx.inc dat.snoc(keyn).snoc(valn) sys)
       [dcells scells]  slotcells
       failed
         '  a fail tombstone ([status]="failed" — broken apps and
         '  modules are visible namespace citizens) tints its record
         ?  view.fil
          > .none  .false
          > (./some ft=myth)
            ?  ft.get(['status])
             > (./some sp=pail)
               ?  sp
                > t=pails/t  (eq t.t "failed")
                .false
             > .none  .false
       reccls
         ?  failed
            "pane failpane"
         "pane"
       recbody
         ?  view.fil
          > .none  [(weft/leaf "div" [(weft/cls "muted")] "no record at this node")]
          > (./some tale2=myth)
            ?  (eq 0 dcells.len)
               [(weft/leaf "div" [(weft/cls "muted")] "empty record")]
            [(weft/el "div" [(weft/cls "slots")] dcells)]
       syspane
         ?  (eq 0 scells.len)
            []
         [(weft/el "div" [(weft/cls "pane")]
            [(weft/leaf "h2" [] "system")
             (weft/el "div" [(weft/cls "slots")] scells)])]
       kids
         =  entries  view.kid_tap
         ?  (eq 0 entries.len)
            [(weft/leaf "div" [(weft/cls "muted")] "no kids")]
         |  > idx=nat 0  > out=row[weft/node] []
         ?  (eq idx entries.len)
            out
         =  kid   entries.at(idx)
            link  (weft/leaf "a" [(weft/href (explorer/url tgt.snoc(kid.key)))] (show/iota kid.key))
            khead
              ?  view.kid_get(kid.key)
               > (./some kaxal=axal[myth])
                 ?  kaxal.fil
                  > (./some ktale=myth)
                    ?  ktale.get(bond/lede)
                     > (./some kheld=pail)
                       ?  kheld
                        > kt=pails/t  (weft/leaf "span" [(weft/cls "muted khead")] kt.t)
                       (weft/tx "")
                     > .none  (weft/tx "")
                  > .none  (weft/tx "")
               > .none  (weft/tx "")
         (_ idx.inc out.snoc((weft/el "div" [(weft/cls "row")] [link khead])))
       vpane
         ?  ver.fil
          > .none  []
          > (./some tale=myth)
            =  vcells
                 =  entries  tale.tap
                 |  > idx=nat 0  > out=row[weft/node] []
                 ?  (eq idx entries.len)
                    out
                 =  slot  entries.at(idx)
                    kc  (weft/el "div" [(weft/cls "key")] [(weft/tx (show/path slot.key))])
                    vc  (weft/el "div" [(weft/cls "val")] [(weft/tx (show/pail slot.val))])
                 (_ idx.inc out.snoc(kc).snoc(vc))
               caserow
                 \  label=nat links=row[weft/node]
                 [(weft/el "div" [(weft/cls "key")] [(weft/tx label)])
                  (weft/el "div" [(weft/cls "val")] links)]
               histcells
                 (explorer/rows
                   [(caserow "x cases" (explorer/case_links 'x (explorer/case_count ['x_data] tale) tgt))
                    (caserow "y cases" (explorer/case_links 'y (explorer/case_count ['y_data] tale) tgt))
                    (caserow "z cases" (explorer/case_links 'z (explorer/case_count ['z_data] tale) tgt))])
            [(weft/el "div" [(weft/cls "pane")]
               [(weft/leaf "h2" [] "version")
                (weft/el "div" [(weft/cls "slots")] vcells.weld(histcells))])]
       wpane
         '  a /boot module node (source, no entry kind) gets the
         '  workspace forms
         ?  view.fil
          > .none  []
          > (./some tale=myth)
            =  src  (myth/txt_at bond/src tale)
            ?  (eq 0 src)
               []
            ?  (myth/has_at ['kind] tale)
               []
            ?  (eq 0 tgt.len)
               []
            ?  (eq_iota tgt.at(0) 'boot)
               (explorer/forms tgt src)
            []
       wpane2
         ?  (eq 0 wpane.len)
            []
         [(weft/el "div" [(weft/cls "pane")] wpane)]
       actpane
         '  no writes into the read-only /h and /o overlays
         ?  (is_h tgt)
            []
         ?  (is_o tgt)
            []
         [(weft/el "div" [(weft/cls "pane")] (explorer/act tgt))]
       body
         [(weft/el "main" []
            (explorer/rows
              [[(weft/el "div" [(weft/cls "top")]
                  [(weft/el "h1" [] crumbs)
                   (weft/el "div" [(weft/cls "muted")] nav)])]
               docpane
               [(weft/el "div" [(weft/cls reccls)]
                  (explorer/rows [[(weft/leaf "h2" [] "record")] recbody]))]
               syspane
               [(weft/el "div" [(weft/cls "pane")]
                  (explorer/rows [[(weft/leaf "h2" [] "kids")] kids]))]
               actpane wpane2 vpane]))]
    (weft/page (show/path tgt) explorer/css body)

  +  talk
    '  The namespace explorer responder: render the request's
    '  hydrated target view as the node browser page.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       tgt=path
         ?  out.get(['vpath])
          > (./some held=pail)
            ?  held
             > p=pails/p  p.p
            []
          > .none  []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ver   bowl.crew.gut(['ver] (axal/new[myth] .none))
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (explorer/page tgt view ver)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    (yell [] done)

  +  route_talk
    '  The default responder with app-face dispatch: when the target
    '  sits inside a mounted app that declares a face kook, delegate
    '  to that form's talk — it receives the same bowl, so the
    '  hydrated ['view] crew rides along.  The deeper mount root wins
    '  (/app/<name> before a single-segment root); no app, no face,
    '  or a malformed face node all fall through to the explorer.
    '  Fragment requests (the ['frag] marker the /frag route stamps)
    '  answer bare component markup and skip dispatch entirely.
    \  =bowl cur=myth add=myth
    ^  yell
    ?  (myth/has_at ['frag] cur.meld(add))
       (frag/talk bowl cur add)
    ?  (http/face_of bowl.crew.gut(['face2] (axal/new[myth] .none)))
     > (./some f=form)
       =  g  f.talk
       (g bowl cur add)
     > .none
       ?  (http/face_of bowl.crew.gut(['face1] (axal/new[myth] .none)))
        > (./some f1=form)
          =  g1  f1.talk
          (g1 bowl cur add)
        > .none  (explorer/talk bowl cur add)

  +  form
    ^  form
    def_form.set_talk(explorer/route_talk)
+  zoo
  '  The global component registry at /weft, and its face — the zoo.
  '  Registration is denormalized: a face only sees its own hydrated
  '  subtree, so each registered component's kid under /weft carries
  '  everything the zoo needs — the part path, the demo data path,
  '  and the lede — copied from the app's weft card at mount time by
  '  the host (a mount expansion is jailed to its own subtree, so an
  '  app cannot register itself in-kernel).

  +  request
    '  A pure recipe query.  Empty text constraints are wildcards;
    '  renderer "neutral" recipes match every requested backend.
    '  Features are semantic paths advertised by the caller.
    :  role=path
       mode=nat
       ceiling=nat
       renderer=nat
       pronunciation=nat
       features=row[path]

  +  make_request
    '  Runtime construction gate for untyped registry clients.
    \  role=path mode=nat ceiling=nat renderer=nat pronunciation=nat
       features=row[path]
    ^  zoo/request
    (zoo/request role mode ceiling renderer pronunciation features)

  +  resolution
    '  Recipe selection is total and diagnostic.  Exact and fallback
    '  carry the chosen denormalized registry entry; every refusal
    '  carries the paths that explain it.  Zoo selection is policy-free:
    '  it neither admits actions nor installs observations.
    &  zoo/resolution/exact
       zoo/resolution/fallback
       zoo/resolution/missing
       zoo/resolution/ambiguous
       zoo/resolution/incompatible

    +  exact
      :  part=path entry=myth

    +  fallback
      :  part=path entry=myth via=path rank=nat

    +  missing
      :  role=path

    +  ambiguous
      :  parts=row[path]

    +  incompatible
      :  parts=row[path]

  +  resolution_part
    '  Selected part for exact/fallback outcomes, empty on refusal.
    \  r=zoo/resolution
    ^  path
    ?  r
     > x=zoo/resolution/exact       x.part
     > x=zoo/resolution/fallback    x.part
     > x=zoo/resolution/missing     []
     > x=zoo/resolution/ambiguous   []
     > x=zoo/resolution/incompatible []
  +  resolution_via
    \  r=zoo/resolution
    ^  path
    ?  r
     > x=zoo/resolution/fallback  x.via
     > x=zoo/resolution/exact     []
     > x=zoo/resolution/missing   []
     > x=zoo/resolution/ambiguous []
     > x=zoo/resolution/incompatible []
  +  resolution_rank
    \  r=zoo/resolution
    ^  nat
    ?  r
     > x=zoo/resolution/fallback  x.rank
     > x=zoo/resolution/exact     0
     > x=zoo/resolution/missing   0
     > x=zoo/resolution/ambiguous 0
     > x=zoo/resolution/incompatible 0
  +  resolution_paths
    '  Diagnostic role/parts in a uniform row.
    \  r=zoo/resolution
    ^  row[path]
    ?  r
     > x=zoo/resolution/missing       [x.role]
     > x=zoo/resolution/ambiguous     x.parts
     > x=zoo/resolution/incompatible  x.parts
     > x=zoo/resolution/exact         [x.part]
     > x=zoo/resolution/fallback      [x.part]

  +  root
    '  The registry root, by convention.
    ^  path
    ['weft]

  +  key
    '  A registry kid key for a component path: its segments joined
    '  with "_" as one symbol.
    '  ?=  ((zoo/key ['chat 'weft 'log]) 'chat_weft_log)
    \  p=path
    ^  iota
    =  parts
         |  > i=nat 0  > out=row[nat] []
         ?  (ge i p.len)
            out
         (_ i.inc out.snoc((show/iota p.at(i))))
    ($ts (weft/join "_" parts))

  +  path_at
    '  A path pail in a slot, or the empty path.
    \  at=path t=myth
    ^  path
    ?  t.get(at)
     > (./some held=pail)
       ?  held
        > p=pails/p  p.p
       []
     > .none  []

  +  paths_at
    '  A row-of-paths pail in a slot, or the empty row.
    \  at=path t=myth
    ^  row[path]
    ?  t.get(at)
     > (./some held=pail)
       ?  held
        > p=pails/ps  p.ps
       []
     > .none  []

  +  has_path
    '  Whether a path occurs in a row of paths.
    \  needle=path hay=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i hay.len)
       .false
    ?  (eq_pith needle hay.at(i))
       .true
    (_ i.inc)

  +  features_ok
    '  Every feature required by a recipe must be advertised.
    \  needs=row[path] have=row[path]
    ^  bool
    |  > i=nat 0
    ?  (ge i needs.len)
       .true
    ?  !(zoo/has_path needs.at(i) have)
       .false
    (_ i.inc)

  +  text_ok
    '  Exact text compatibility with an empty constraint on either side
    '  acting as a wildcard.  This keeps partially described recipes
    '  inspectable while explicit values stay deterministic.
    \  want=nat got=nat
    ^  bool
    ?  (eq 0 want)
       .true
    ?  (eq 0 got)
       .true
    (eq want got)

  +  renderer_ok
    '  A neutral recipe is backend-independent; every other renderer
    '  must equal the requested backend (unless either side is unset).
    \  want=nat got=nat
    ^  bool
    ?  (eq got "neutral")
       .true
    (zoo/text_ok want got)

  +  compatible
    '  Whether one registry entry satisfies the non-role query axes.
    '  Input/output and care document the recipe contract but do not
    '  participate in this first resolver packet.
    \  q=zoo/request t=myth
    ^  bool
    ?  q
     > request=zoo/request
       ?  !(zoo/text_ok request.mode (myth/txt_at ['recipe 'mode] t))
          .false
       ?  !(zoo/text_ok request.ceiling (myth/txt_at ['recipe 'ceiling] t))
          .false
       ?  !(zoo/renderer_ok request.renderer (myth/txt_at ['recipe 'renderer] t))
          .false
       ?  !(zoo/text_ok request.pronunciation (myth/txt_at ['recipe 'pronunciation] t))
          .false
       (zoo/features_ok (zoo/paths_at ['recipe 'requires] t) request.features)

  +  request_role
    '  Open the nominal query at the registry boundary.
    \  q=zoo/request
    ^  path
    ?  q
     > request=zoo/request  request.role

  +  role_of
    '  The semantic role on a normalized registry entry.
    \  t=myth
    ^  path
    (zoo/path_at ['recipe 'role] t)

  +  parts_of
    '  Registry part paths in row order, for deterministic diagnostics.
    \  ts=row[myth]
    ^  row[path]
    |  > i=nat 0  > out=row[path] []
    ?  (ge i ts.len)
       out
    (_ i.inc out.snoc((zoo/path_at ['part] ts.at(i))))

  +  at_part
    '  Compatible registry entries at one exact component path.
    \  q=zoo/request part=path entries=row[myth]
    ^  row[myth]
    |  > i=nat 0  > out=row[myth] []
    ?  (ge i entries.len)
       out
    =  t  entries.at(i)
    ?  !(eq_pith part (zoo/path_at ['part] t))
       (_ i.inc out)
    ?  !(zoo/compatible q t)
       (_ i.inc out)
    (_ i.inc out.snoc(t))

  +  fallback_for
    '  Try each declaring recipe and each of its fallback paths in
    '  declaration order.  The first compatible unique target wins;
    '  duplicate compatible entries at that exact path are ambiguous.
    '  Fallbacks are deliberately one hop in this first packet, so a
    '  malformed registry cannot create a resolution cycle.
    \  q=zoo/request primaries=row[myth] entries=row[myth]
    ^  maybe[zoo/resolution]
    |  > i=nat 0  > j=nat 0
    ^  maybe[zoo/resolution]
    ?  (ge i primaries.len)
       .none
    =  one  primaries.at(i)
       fs   (zoo/paths_at ['recipe 'fallbacks] one)
    ?  (ge j fs.len)
       (_ i.inc 0)
    =  fp    fs.at(j)
       hits  (zoo/at_part q fp entries)
    ?  (eq 0 hits.len)
       (_ i j.inc)
    ?  (eq 1 hits.len)
       (./some (zoo/resolution/fallback fp hits.at(0)
                 (zoo/path_at ['part] one) j))
    (./some (zoo/resolution/ambiguous (zoo/parts_of hits)))

  +  resolve
    '  Resolve one semantic request against denormalized Zoo entries.
    '  Exact compatible role matches precede ordered fallbacks.  Zero
    '  role matches is missing; multiple exact matches is ambiguous;
    '  a known role with no compatible exact or fallback is incompatible.
    \  q=zoo/request entries=row[myth]
    ^  zoo/resolution
    =  role  (zoo/request_role q)
    |  > i=nat 0  > roles=row[myth] []  > hits=row[myth] []
    ?  (ge i entries.len)
       ?  (eq 0 roles.len)
          (zoo/resolution/missing role)
       ?  (gt hits.len 1)
          (zoo/resolution/ambiguous (zoo/parts_of hits))
       ?  (eq 1 hits.len)
          =  one  hits.at(0)
          (zoo/resolution/exact (zoo/path_at ['part] one) one)
       ?  (zoo/fallback_for q roles entries)
        > (./some r=zoo/resolution)  r
        > .none  (zoo/resolution/incompatible (zoo/parts_of roles))
    =  t  entries.at(i)
    ?  !(eq_pith role (zoo/role_of t))
       (_ i.inc roles hits)
    =  roles2  roles.snoc(t)
    ?  (zoo/compatible q t)
       (_ i.inc roles2 hits.snoc(t))
    (_ i.inc roles2 hits)

  +  kind_of
    '  The ctor's family as text, for the kind chip.
    \  t=myth
    ^  nat
    ?  t.get(bond/weft)
     > .none  ""
     > (./some held=pail)
       ?  held
        > dyed  "dyed"
        > knit  "knit"
        > felt  "felt"
       > sewn  "sewn"
       ""

  +  care_of
    '  The output case that versions a component projection.  Record
    '  and subtree-producing overlays resolve at x; renderer payload
    '  and SurfaceTree transforms resolve at z.
    \  t=myth
    ^  care
    =  > named (myth/txt_at ['recipe 'care] t)
    ?  (eq named "x")
       .x
    ?  (eq named "y")
       .y
    ?  (eq named "z")
       .z
    =  > k (myth/txt_at ['kind] t)
    ?  (eq k "dyed")
       .x
    ?  (eq k "knit")
       .x
    .z

  +  input_of
    '  Legacy overlay input kind, derived from its constructor family.
    \  kind=nat
    ^  nat
    ?  (eq kind "dyed")
       "record"
    ?  (eq kind "knit")
       "record"
    "subtree"

  +  output_of
    '  Legacy overlay output kind, derived from its constructor family.
    \  kind=nat
    ^  nat
    ?  (eq kind "dyed")
       "record"
    ?  (eq kind "felt")
       "record"
    "subtree"

  +  care_name_of
    '  Legacy care as registry text.  This mirrors zoo/care_of.
    \  kind=nat
    ^  nat
    ?  (eq kind "dyed")
       "x"
    ?  (eq kind "knit")
       "x"
    "z"

  +  recipe_defaults
    '  Normalize a legacy weft_card into the same inspectable recipe
    '  contract as a metadata-bearing weft_recipe.  Defaults are only
    '  written when the slot is absent, so explicit metadata always wins.
    '  A legacy role is its absolute component path: this preserves old
    '  cards without pretending they already have a semantic role family.
    \  part=path kind=nat t=myth
    ^  myth
    =  t1
         ?  (myth/has_at ['recipe 'role] t)
            t
         t.put(['recipe 'role] (pails/p part))
       t2
         ?  (myth/has_at ['recipe 'input] t1)
            t1
         t1.put(['recipe 'input] (pails/t (zoo/input_of kind)))
       t3
         ?  (myth/has_at ['recipe 'output] t2)
            t2
         t2.put(['recipe 'output] (pails/t (zoo/output_of kind)))
       t4
         ?  (myth/has_at ['recipe 'mode] t3)
            t3
         t3.put(['recipe 'mode] (pails/t "full"))
       t5
         ?  (myth/has_at ['recipe 'ceiling] t4)
            t4
         t4.put(['recipe 'ceiling] (pails/t "component"))
       t6
         ?  (myth/has_at ['recipe 'renderer] t5)
            t5
         t5.put(['recipe 'renderer] (pails/t "web"))
       t7
         ?  (myth/has_at ['recipe 'pronunciation] t6)
            t6
         t6.put(['recipe 'pronunciation] (pails/t "legacy"))
       t8
         ?  (myth/has_at ['recipe 'care] t7)
            t7
         t7.put(['recipe 'care] (pails/t (zoo/care_name_of kind)))
       t9
         ?  (myth/has_at ['recipe 'requires] t8)
            t8
         t8.put(['recipe 'requires] (pails/ps []))
    ?  (myth/has_at ['recipe 'fallbacks] t9)
       t9
    t9.put(['recipe 'fallbacks] (pails/ps []))

  +  entry
    '  One weft seed as its registry record: the whole card COPIED —
    '  minus the ctor itself — with every path value rebased against
    '  the mount root (the seed is pre-expansion, so "."-relative
    '  values still carry the rel marker), plus the component's
    '  absolute part path, its ctor kind, and its module.  The lore
    '  rides through whole, so a registry kid documents its component
    '  without reaching outside /weft.
    \  root=path at=path mod=nat t=myth
    ^  myth
    =  part=path  root.weld(at)
       base
         =  slots  t.tap
         |  > i=nat 0  > out=myth myth/new
         ^  myth
         ?  (ge i slots.len)
            out
         =  s  slots.at(i)
         ?  (eq_pith s.key bond/weft)
            (_ i.inc out)
         (_ i.inc out.put(s.key s.val))
       based  (pact/rebase_rec root base)
       b2
         ?  (myth/has_at ['demo] based)
            based
         based.put(['demo] (pails/p part))
       kind  (zoo/kind_of t)
       b3
         .  b2
            put(['part] (pails/p part))
            put(['kind] (pails/t kind))
            put(['module] (pails/t mod))
    (zoo/recipe_defaults part kind b3)

  +  with_part
    '  Attach an absolute registry part without asking an untyped host
    '  to construct a path pail.
    \  part=path t=myth
    ^  myth
    t.put(['part] (pails/p part))

  +  tasks
    '  Registration tasks for an app's manifest: one make under /weft
    '  per seed carrying a /sys/weft ctor.  The host runs these after
    '  a successful mount; a failed registration is logged, never
    '  fatal.
    \  root=path mod=nat m=mani
    ^  row[task]
    =  seeds  m.seeds
    |  > i=nat 0  > out=row[task] []
    ^  row[task]
    ?  (ge i seeds.len)
       out
    =  [sp st]  seeds.at(i)
    ?  (myth/has_at bond/weft st)
       =  zr=path  zoo/root
          at=path  zr.snoc((zoo/key root.weld(sp)))
          tk
            ^  task
            (./vine at (writ/make (zoo/entry root sp mod st)))
       (_ i.inc out.snoc(tk))
    (_ i.inc out)

  +  previewable
    '  Only recipes that consume an ordinary source record/subtree and
    '  terminate in a renderer record may be mounted by themselves.
    '  SurfaceTree-producing compiler stages and terminal adapters whose
    '  input is already a SurfaceTree require composition; mounting either
    '  directly is a type lie and needlessly arms a live observation.
    \  t=myth
    ^  bool
    =  input  (myth/txt_at ['recipe 'input] t)
       output  (myth/txt_at ['recipe 'output] t)
       renderer  (myth/txt_at ['recipe 'renderer] t)
    ?  !(eq output "record")
       .false
    ?  (eq renderer "neutral")
       .false
    !(eq input "surface-tree")

  +  card1
    '  One zoo index pane: metadata and a link to the recipe page.  The
    '  index is deliberately observation-free; opening the catalog must
    '  not instantiate every recipe or consume live HTTP waiters.
    \  key=iota t=myth
    ^  weft/node
    =  part=path  (zoo/path_at ['part] t)
       demo=path  (zoo/path_at ['demo] t)
       idc  (show/iota key)
       role  (zoo/role_of t)
       rname
         ?  (eq 0 role.len)
            "untyped"
         (show/path role)
       links
         [(weft/leaf "span" [(weft/cls "chip mut")] (myth/txt_at ['kind] t))
          (weft/tx "  ")
          (weft/leaf "span" [(weft/cls "chip mut")] rname)
          (weft/tx "  ")
          (weft/tx (myth/txt_at bond/lede t))
          (weft/tx "  ")
          (weft/leaf "a" [(weft/href (explorer/url part))] (show/path part))
          (weft/tx " over ")
          (weft/leaf "a" [(weft/href (explorer/url demo))] (show/path demo))]
    (weft/el "div" [(weft/cls "pane")]
      [(weft/el "h2" []
         [(weft/leaf "a" [(weft/href (weft/cat2 "/weft/" idc))] idc)])
       (weft/el "div" [(weft/cls "muted")] links)
       (weft/leaf "div" [(weft/cls "muted")] "metadata only - open recipe for preview")])

  +  demo_mounts
    '  Every demo slot of a registry kid as a labeled pane with the
    '  component mounted live: ['demo] is the default state, each
    '  ['demo <name>] a named one.
    \  part=path t=myth
    ^  row[weft/node]
    ?  !(zoo/previewable t)
       [(weft/el "div" [(weft/cls "pane")]
          [(weft/leaf "h2" [] "preview")
           (weft/leaf "div" [(weft/cls "muted")]
             "composition required - this recipe is not a standalone terminal component")])]
    =  slots  t.tap
    |  > i=nat 0  > out=row[weft/node] []
    ^  row[weft/node]
    ?  (ge i slots.len)
       out
    =  s  slots.at(i)
    ?  (eq 0 s.key.len)
       (_ i.inc out)
    ?  !(eq_iota s.key.at(0) 'demo)
       (_ i.inc out)
    =  dp=path
         ?  s.val
          > p=pails/p  p.p
         []
    ?  (eq 0 dp.len)
       (_ i.inc out)
    =  label
         ?  (eq 1 s.key.len)
            "demo"
         (show/iota s.key.at(1))
       pane
         (weft/el "div" [(weft/cls "pane")]
           [(weft/el "h2" []
              [(weft/tx label)
               (weft/tx "  ")
               (weft/leaf "a" [(weft/href (explorer/url dp)) (weft/cls "muted")] (show/path dp))])
            (frag/mount (weft/cat2 "d" (weft/show_nat i)) part dp (zoo/care_of t))])
    (_ i.inc out.snoc(pane))

  +  page1
    '  A component's documentation page: kind, module, part, the full
    '  lore (head, body, and its doctests as written), and every demo
    '  state mounted live.
    \  key=iota t=myth
    ^  nat
    =  part=path  (zoo/path_at ['part] t)
       kind  (myth/txt_at ['kind] t)
       mod   (myth/txt_at ['module] t)
       role  (zoo/role_of t)
       recipe_rows
         [(weft/leaf "h2" [] "recipe")
          (weft/el "div" [(weft/cls "slots")]
            [(weft/leaf "div" [(weft/cls "key")] "role")
             (weft/leaf "div" [(weft/cls "val")] (show/path role))
             (weft/leaf "div" [(weft/cls "key")] "contract")
             (weft/leaf "div" [(weft/cls "val")]
               (weft/cat2 (myth/txt_at ['recipe 'input] t)
                 (weft/cat2 " -> " (myth/txt_at ['recipe 'output] t))))
             (weft/leaf "div" [(weft/cls "key")] "mode / ceiling")
             (weft/leaf "div" [(weft/cls "val")]
               (weft/cat2 (myth/txt_at ['recipe 'mode] t)
                 (weft/cat2 " / " (myth/txt_at ['recipe 'ceiling] t))))
             (weft/leaf "div" [(weft/cls "key")] "pronunciation")
             (weft/leaf "div" [(weft/cls "val")]
               (weft/cat2 (myth/txt_at ['recipe 'renderer] t)
                 (weft/cat2 " / " (myth/txt_at ['recipe 'pronunciation] t))))
             (weft/leaf "div" [(weft/cls "key")] "care")
             (weft/leaf "div" [(weft/cls "val")] (myth/txt_at ['recipe 'care] t))])]
       docrows
         ^  row[weft/node]
         ?  t.get(bond/help)
          > .none  []
          > (./some held=pail)
            ?  held
             > doc=lore
               =  bodyrows
                    |  > j=nat 1  > out=row[weft/node] []
                    ?  (ge j doc.body.len)
                       out
                    (_ j.inc out.snoc((weft/leaf "div" [(weft/cls "lore-line")] doc.body.at(j))))
               =  base
                    [(weft/el "div" [(weft/cls "lore-head")] [(weft/tx doc.head)])
                     (weft/el "div" [(weft/cls "lore-body")] bodyrows)]
               ?  (eq 0 doc.tests.len)
                  base
               base.weld((explorer/dt_rows_never doc))
            []
       header
         [(weft/el "div" [(weft/cls "top")]
            [(weft/el "h1" []
               [(weft/leaf "a" [(weft/href "/weft")] "zoo")
                (weft/tx " / ")
                (weft/tx (show/iota key))])
             (weft/el "div" [(weft/cls "muted")]
               [(weft/leaf "span" [(weft/cls "chip mut")] kind)
                (weft/tx "  ")
                (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" mod))] mod)
                (weft/tx "  ")
                (weft/leaf "a" [(weft/href (explorer/url part))] (show/path part))])])]
       docpane
         ^  row[weft/node]
         ?  (eq 0 docrows.len)
            [(weft/el "div" [(weft/cls "pane")] recipe_rows)]
         [(weft/el "div" [(weft/cls "pane")] recipe_rows.weld(docrows))]
       mounts  (zoo/demo_mounts part t)
       body
         [(weft/el "main" []
            header.weld(docpane).weld(mounts).snoc(frag/script))]
    (weft/page (show/iota key) explorer/css body)

  +  talk
    '  The zoo face: an observation-free recipe catalog at the root,
    '  and a component's documentation page when the target is a
    '  registry kid.  Only standalone terminal recipes receive a live
    '  preview on their detail page.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       tgt=path
         ?  out.get(['vpath])
          > (./some held=pail)
            ?  held
             > p=pails/p  p.p
            []
          > .none  []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       detail
         '  a registry kid target: its own hydrated record, provided
         '  it is an entry (the face card at /weft/kook has no part)
         ^  maybe[myth]
         ?  (lt tgt.len 2)
            .none
         ?  view.fil
          > .none  .none
          > (./some t=myth)
            ?  (eq 0 (zoo/path_at ['part] t).len)
               .none
            (./some t)
    ?  detail
     > (./some t=myth)
       =  done1
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (zoo/page1 tgt.at(1) t)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       (yell [] done1)
     > .none
       =  entries  view.kid_tap
          panes
            ?  (eq 0 entries.len)
               [(weft/leaf "div" [(weft/cls "muted")] "no components registered")]
            |  > i=nat 0  > ns=row[weft/node] []
            ^  row[weft/node]
            ?  (ge i entries.len)
               ns
            =  e  entries.at(i)
            ?  e.val.fil
             > .none  (_ i.inc ns)
             > (./some t=myth)
               '  only registry entries: /weft/kook (the face) is a
               '  kid of the same root and carries no ['part]
               ?  (eq 0 (zoo/path_at ['part] t).len)
                  (_ i.inc ns)
               (_ i.inc ns.snoc((zoo/card1 e.key t)))
          head  [(weft/leaf "h1" [] "component zoo")]
          body  [(weft/el "main" [] head.weld(panes))]
          done
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (weft/page "component zoo" explorer/css body)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       (yell [] done)

  +  form
    '  The zoo behavior: talk renders.  Seeded as the face card at
    '  /weft/kook/face by the root convention tasks.
    ^  form
    def_form.set_talk(zoo/talk)
