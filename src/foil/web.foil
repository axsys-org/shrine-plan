-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  chore [order=70]
'  web: everything the namespace shows the outside world over HTTP —
'  the serving and fetching driver vocabularies (records in, records
'  out; the host workers only shuttle), the doctest driver's records,
'  and the namespace explorer rendered over weft.
+  show
  '  Namespace values as text.

  +  iota
    '  An iota as its canonical path-segment spelling — the iota_show
    '  jet, the exact inverse of the segment parser, so explorer URLs
    '  round-trip: symbols bare, nats decimal, strings $-sigiled,
    '  times/durations @-sigiled, binary 0w/0x.
    \  i=iota
    ^  nat
    (iota_show i)

  +  path
    '  A path as "/a/b"; the empty path as "/".
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/"
    =  parts
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx p.len)
            out
         (_ idx.inc out.snoc((show/iota p.at(idx))))
    (weft/cat2 "/" (weft/join "/" parts))

  +  tail
    '  The last segment of a brand cord: "/boot/doctest/verdict"
    '  becomes "verdict".
    '  ?=  ((show/tail "/boot/mani") "mani")
    \  b=nat
    ^  nat
    |  > rest=nat b  > cur=nat 0
    ?  (eq rest 0)
       cur
    =  c  (mod rest 256)
    ?  (eq c "/")
       (_ (div rest 256) 0)
    (_ (div rest 256) (add cur (lsh c (mul 8 (wid cur)))))

  +  textish
    '  Printable-with-whitespace prose (what pails/t carries): the
    '  degrade rule would render it as a decimal blob, quoting reads.
    \  v=nat
    ^  bool
    ?  (eq v 0)
       .false
    |  > rest=nat v  > seen=nat 0
    ?  (eq rest 0)
       seen
    =  c  (mod rest 256)
    ?  (eq c 10)
       (_ (div rest 256) seen)
    ?  (lt c 32)
       .false
    ?  (gt c 126)
       .false
    ?  (eq c " ")
       (_ (div rest 256) 1)
    (_ (div rest 256) seen)

  +  clip
    '  The first n bytes, an ellipsis when clipped.
    \  n=nat s=nat
    ^  nat
    ?  (le (wid s) n)
       s
    (weft/cat2 (mod s (weft/bex8 n)) "…")

  +  leaf
    '  A bare nat with no type in sight: brand-cord constants (the
    '  arity-0 nominals — care/x, mode/add, writ/cull) render as
    '  their relvar spelling, prose quotes and clips, everything
    '  else follows the aura degrade rule (nat_show).
    '  ?=  ((show/leaf "/boot/care/x") ".x")
    '  ?=  ((show/leaf 41) "41")
    \  v=nat
    ^  nat
    ?  (eq "/" (mod v 256))
       (weft/cat2 "." (show/tail v))
    ?  (show/textish v)
       (weft/cat [34 (show/clip 42 v) 34])
    (nat_show v)

  +  lines
    '  Newline count + 1: how many lines a text renders as.
    \  s=nat
    ^  nat
    |  > rest=nat s  > n=nat 1
    ?  (eq rest 0)
       n
    ?  (eq 10 (mod rest 256))
       (_ (div rest 256) n.inc)
    (_ (div rest 256) n)

  +  aura_tag
    '  Is b one of the fourteen aura tag cords (an iota's head)?
    \  b=nat
    ^  bool
    ?  (eq b "dm") .true
    ?  (eq b "dr") .true
    ?  (eq b "ds") .true
    ?  (eq b "f")  .true
    ?  (eq b "r")  .true
    ?  (eq b "rd") .true
    ?  (eq b "rs") .true
    ?  (eq b "s")  .true
    ?  (eq b "ta") .true
    ?  (eq b "ts") .true
    ?  (eq b "tu") .true
    ?  (eq b "u")  .true
    ?  (eq b "w")  .true
    ?  (eq b "x")  .true
    .false

  +  reg
    '  The reflection registry: (^ T) of a nominal row reflects to a
    '  rec whose cstr IS the runtime brand and whose items carry the
    '  field faces — slot values with these brands render faced.
    ^  row[type]
    [(^ mani) (^ doctest/verdict) (^ kook/decl) (^ dep) (^ hunt) (^ lore)]

  +  nom_named
    '  Does a reflected reference name this type?  Descriptor paths
    '  may be unit-qualified ("~"-headed) — the last segment is the
    '  name that matters here.
    \  pth=row[nat] name=nat
    ^  bool
    ?  (eq 0 pth.len)
       .false
    (eq pth.at(pth.len.dec) name)

  +  reg_of
    '  The registry rec for a brand, or .none.
    \  b=nat
    ^  maybe[type]
    =  rs  show/reg
    |  > idx=nat 0
    ^  maybe[type]
    ?  (eq idx rs.len)
       .none
    ?  rs.at(idx)
     > (./rec cstr items)
       ?  (eq cstr b)
          (./some rs.at(idx))
       (_ idx.inc)
    (_ idx.inc)

  +  value
    '  Any runtime value as text, reflection-guided: pins are
    '  invisible, branded rows render name{face=..} through the
    '  registry (positionally without it), iotas by their spelling,
    '  rows in brackets, bare nats by /show/leaf .  Depth-capped.
    \  v=any depth=nat
    ^  nat
    ?  (rep_pin v)
       (show/value (rep_unpin v) depth)
    ?  (rep_law v)
       "law"
    ?  !(rep_app v)
       (show/leaf v)
    =  h  (rep_hd v)
    ?  (eq h 0)
       (show/items "[" "]" v depth)
    ?  (show/aura_tag h)
       ?  (eq 1 (rep_sz v))
          (iota_show v)
       (show/pos h v depth)
    ?  (eq "/boot/form" h)
       "form"
    ?  (eq "/boot/mop/node" h)
       (show/tree v depth)
    ?  (eq "/boot/uon/node" h)
       (show/tree v depth)
    ?  (eq "/" (mod h 256))
       (show/branded h v depth)
    "law"

  +  tree
    '  An ordered-map node (mop/uon internals share the shape
    '  [sz key val l r]) as its entries: {k→v ..}, width-capped —
    '  the tree is an implementation detail, the map is the value.
    \  v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       "{..}"
    =  parts
         |  > todo=row[any] [v]  > out=row[nat] []
         ?  (eq 0 todo.len)
            out
         ?  (gt out.len 5)
            out.snoc("..")
         =  n  todo.at(0)
            rest  todo.drop(1)
         ?  !(rep_app n)
            (_ rest out)
         ?  (eq 5 (rep_sz n))
            (_ rest.cons((rep_ix 3 n)).cons((rep_ix 4 n))
               out.snoc(
                 (weft/cat [(show/value (rep_ix 1 n) depth.inc) "→"
                            (show/value (rep_ix 2 n) depth.inc)])))
         (_ rest out)
    (weft/cat ["{" (weft/join " " parts) "}"])

  +  items
    '  A row's elements, width-capped at eight.
    \  open=nat close=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       (weft/cat [open ".." close])
    =  n  (rep_sz v)
       cap
         ?  (lt n 9)
            n
         8
       parts
         |  > idx=nat 0  > out=row[nat] []
         ?  (eq idx cap)
            out
         (_ idx.inc out.snoc((show/value (rep_ix idx v) depth.inc)))
       extra
         ?  (lt cap n)
            (weft/cat [" +" (weft/show_nat (sub n cap))])
         ""
    (weft/cat [open (weft/join " " parts) extra close])

  +  branded
    '  A branded row: faced through the registry when its rec is
    '  known (path-typed fields as paths), positional otherwise.
    \  h=nat v=any depth=nat
    ^  nat
    ?  (gt depth 3)
       (weft/cat2 (show/tail h) "{..}")
    ?  (show/reg_of h)
     > .none  (show/pos h v depth)
     > (./some d)
       ?  d
        > (./rec cstr items)
          ?  !(eq items.len (rep_sz v))
             (show/pos h v depth)
          =  parts
               |  > idx=nat 0  > out=row[nat] []
               ?  (eq idx items.len)
                  out
               =  [face=nat item=type]  items.at(idx)
                  fv
                    '  descriptor-directed: paths as paths, empty
                    '  rows as [] (an empty row IS nat 0 — only the
                    '  type knows the difference)
                    ?  item
                     > (./nom pth args)
                       ?  (show/nom_named pth "path")
                          (show/path (rep_ix idx v))
                       ?  (show/nom_named pth "row")
                          ?  !(rep_app (rep_ix idx v))
                             "[]"
                          (show/value (rep_ix idx v) depth.inc)
                       (show/value (rep_ix idx v) depth.inc)
                     > (./arr item2)
                       ?  !(rep_app (rep_ix idx v))
                          "[]"
                       (show/value (rep_ix idx v) depth.inc)
                    (show/value (rep_ix idx v) depth.inc)
                  part
                    ?  (eq face idx)
                       fv
                    (weft/cat [(tyshow/atom_text face) "=" fv])
               (_ idx.inc out.snoc(part))
          (weft/cat [(show/tail h) "{" (weft/join " " parts) "}"])
       (show/pos h v depth)

  +  pos
    '  A branded row without a registry rec: positional fields.
    \  h=nat v=any depth=nat
    ^  nat
    (weft/cat2 (show/tail h) (show/items "(" ")" v depth))

  +  pail
    '  A slot value as text: the payloads this layer knows bespoke,
    '  and the reflection-guided walker for the open remainder.
    \  held=pail
    ^  nat
    ?  held
     > x=pails/n   (weft/show_nat x.n)
     > q=pails/q   (show/iota q.q)
     > p=pails/p   (show/path p.p)
     > k=kook
       =  parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx k.refs.len)
               out
            (_ idx.inc out.snoc((show/path k.refs.at(idx))))
       (weft/cat2 "kook " (weft/join " " parts))
     > c=cpail
       =  entries  c.crew.tap
          parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx entries.len)
               out
            =  e  entries.at(idx)
               cn
                 ?  e.val.c
                  > .x  "x"
                  > .y  "y"
                  > .z  "z"
            (_ idx.inc
               out.snoc((weft/cat [cn "→" (show/path e.val.p)])))
       (weft/cat2 "crew " (weft/join "  " parts))
     > ps=pails/ps
       =  parts
            |  > idx=nat 0  > out=row[nat] []
            ?  (eq idx ps.ps.len)
               out
            (_ idx.inc out.snoc((show/path ps.ps.at(idx))))
       (weft/join "  " parts)
     > form         "form"
     > t=pails/t    t.t
     > d=pails/ty   (tyshow/show d.t)
     > pails/code   "code"
     > dyed           "dyed overlay"
     > knit           "knit overlay"
     > felt           "felt overlay"
     > sewn           "sewn overlay"
     > weft/node/tx   "html fragment"
     > weft/node/raw  "html fragment"
     > weft/node/el   "html fragment"
     > doc=lore
       ?  (eq 0 doc.tests.len)
          doc.head
       (weft/cat [doc.head "  [?= " (weft/show_nat doc.tests.len) "]"])
    (show/value held 0)
+  http
  '  The inbound-HTTP driver vocabulary: driver configs, request
  '  records, and the behaviors the serving kook installs.

  +  respond_talk
    '  The responder the serving kook installs on a request node: the
    '  installing poke's talk answers 200, echoing the request's body
    '  slot (or its url when there is no body).
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       pay=pail
         ?  out.get(['body])
          > (./some held=pail)  held
          > .none
            ?  out.get(['url])
             > (./some held=pail)  held
             > .none  (pd 0)
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] pay)
    (yell [] done)

  +  respond_form
    ^  form
    def_form.set_talk(http/respond_talk)

  +  serve_take
    '  The serving kook for an HTTP driver node: when a request node
    '  appears underneath (an added direct kid in the gift), emit a
    '  poke installing the configured responder kook on it — the same
    '  poke's talk then writes the response, all within the event.
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    >  (./some rid=iota) cur.quip_at(['serve])
       (yell [] cur)
    =  events  gift.tap
    |  > idx=nat 0  > cards=row[[p=path q=writ]] []
    ?  (eq idx events.len)
       (yell cards cur)
    =  [at act]  events.at(idx)
    ?  ?=(.add act)
       ?  (eq 1 at.len)
          =  card  (kooked [kook_root.snoc(rid)])
          (_ idx.inc cards.snoc([bowl.here.weld(at) (writ/poke card)]))
       (_ idx.inc cards)
    (_ idx.inc cards)

  +  serve_form
    ^  form
    def_form.set_take(http/serve_take)

  +  cfg
    '  The record for an HTTP driver node: the serving kook plus the
    '  responder id it installs on request nodes.
    \  rid=iota
    ^  myth
    (kooked [['kook 'hserve]]).put(['serve] (pails/q rid))

  +  cfg_port
    '  A live driver config: serving kook, responder id, and the TCP
    '  port (the worker reads it at birth, so it must ride the make).
    \  rid=iota port=nat
    ^  myth
    (http/cfg rid).put(['port] (pd port))

  +  face_at
    '  The face-kook path at the target's depth-n prefix: an app
    '  mounted at /app/<name> keeps its face at depth two, an app
    '  mounted at a root of its own (/chat) at depth one, and a
    '  subtree anywhere may carry its own.  The probe is a crew dep,
    '  so a missing face node hydrates empty and costs nothing.
    '  none for shallow targets and the derived overlays.
    \  n=nat tgt=path
    ^  maybe[path]
    ?  (lt tgt.len n)
       .none
    ?  (is_h tgt)
       .none
    ?  (is_o tgt)
       .none
    ?  (is_xv tgt)
       .none
    =  root=path  tgt.take(n)
    (./some root.weld(['kook 'face]))

  +  face_of
    '  The form riding a hydrated face view, if any: the same
    '  ['form]-slot pail extraction resolve performs on kook refs.
    \  fv=axal[myth]
    ^  maybe[form]
    ?  fv.fil
     > .none  .none
     > (./some ft=myth)
       ?  ft.get(['form])
        > .none  .none
        > (./some fp=pail)
          ?  fp
           > f=form  (./some f)
          .none

  +  tgt_of
    '  The parsed request target riding at ['vpath], or the empty
    '  path when absent.
    \  o=myth
    ^  path
    ?  o.get(['vpath])
     > (./some held=pail)
       ?  held
        > p=pails/p  p.p
       []
     > .none  []

  +  face_hunt
    '  The hunt riding a hydrated face view at ['hunt]: the face's
    '  rendering claim as data on the face record — a slot like any
    '  other, so a poke retunes a face's reach live.  Absent (or
    '  non-hunt) claims the whole subtree, matching hunt-less faces.
    \  fv=axal[myth]
    ^  hunt
    ?  fv.fil
     > .none  (hunt .z [])
     > (./some ft=myth)
       ?  ft.get(['hunt])
        > .none  (hunt .z [])
        > (./some hp=pail)
          ?  hp
           > h=hunt  h
          (hunt .z [])

  +  hunt_admits
    '  Whether the face mounted at root claims the target: the
    '  hunt's path is root-relative, so the claim is rooted at
    '  root.weld(h.p); the care sets the reach — .x that node alone,
    '  .y the node plus its direct kids, .z the whole subtree
    '  beneath it.
    '  ?=  ((http/hunt_admits (hunt care/z []) ['a] ['a 'b 'c]) 1)
    '  ?=  ((http/hunt_admits (hunt care/x []) ['a] ['a 'b]) 0)
    '  ?=  ((http/hunt_admits (hunt care/y []) ['a] ['a 'b]) 1)
    \  h=hunt root=path tgt=path
    ^  bool
    =  base=path  root.weld(h.p)
    ?  (lt tgt.len base.len)
       .false
    ?  !(eq_pith base tgt.take(base.len))
       .false
    ?  h.c
     > .x  (eq tgt.len base.len)
     > .y  (le tgt.len base.len.inc)
     > .z  .true

  +  req
    '  An HTTP request as a namespace record: method, url and body
    '  ride as data pails, the parsed target as a pails/p, a z-care
    '  dep on the target so responders get its hydrated view, and —
    '  for live targets — a y-care dep on the target's /h/v version
    '  view.  Live targets also dep the face node at EVERY ancestor
    '  depth (['face n]) so the responder can dispatch to the
    '  deepest face whose hunt claims the target.  No kook: the
    '  serving kook above installs one.
    \  method=nat url=nat body=nat tgt=path
    ^  myth
    =  base
         .  (myth/new)
            put(['method] (pd method))
            put(['url] (pd url))
            put(['body] (pd body))
            put(['vpath] (pails/p tgt))
       watch=crew
         =  base_sight  (crew/sing ['view] (dep .z tgt))
         =  sight
              |  > n=nat 1  > acc=crew base_sight
              ^  crew
              ?  (gt n tgt.len)
                 acc
              ?  (http/face_at n tgt)
               > (./some fp=path)  (_ n.inc acc.put(['face ($u n)] (dep .x fp)))
               > .none  (_ n.inc acc)
         ?  (is_h tgt)
            sight
         ?  (is_o tgt)
            sight
         ?  (is_xv tgt)
            sight
         ?  (eq 0 tgt.len)
            sight
         =  vroot=path  ['h 'v ($u tgt.len)]
         sight.put(['ver] (dep .y vroot.weld(tgt)))
    base.put(crew_slot (cpail watch))
+  frag
  '  The fragment vocabulary: components are overlay ctors whose
  '  derived records carry markup (a weft/node at ['html]), applied
  '  through /o and served bare over the /frag route.  Containers
  '  mount them as w-get elements the /w.js runtime keeps fresh
  '  (weft/runtime documents the attribute set).

  +  url
    '  The fragment URL applying the component node at op to the
    '  data at dp: /frag/1/olen/...op/dlen/...dp.  The function pin
    '  is hardcoded to x case 1 per the write-once component
    '  convention (pact/weft_card): components mount once and never
    '  change in place, so their first mint is their only mint.
    \  op=path dp=path
    ^  nat
    (weft/cat ["/frag/1/" (weft/show_nat op.len) (show/path op) "/" (weft/show_nat dp.len) (show/path dp)])

  +  html
    '  A component result: markup at ['html].  The node rides the
    '  pail as its branded member row (sums do not inhabit pails),
    '  so a fragment's root is always an element.
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  myth
    (myth/new).put(['html] (weft/node/el tag as kids))

  +  mount
    '  A fragment mount: an empty element the runtime fills on page
    '  load and re-fetches every `every` seconds, swapping only when
    '  the markup actually changed — the server-side first paint is
    '  deliberately absent so component output is never duplicated
    '  into container code.
    \  id=nat op=path dp=path every=nat
    ^  weft/node
    (weft/h "div" [(weft/a "id" id) (weft/wget (frag/url op dp)) (weft/wevery every)])

  +  edit
    '  w-edit: the text run edits in place, committing to the slot at
    '  the enclosing mount's data path plus rel.  rel rides as a real
    '  path — the "." spelling for the empty rel is derived here, so
    '  hand-spelled relative cords (and their silent-miss typos)
    '  never appear at call sites.
    \  rel=path slot=nat
    ^  weft/item
    =  spell
         ?  (eq 0 rel.len)
            "."
         =  parts
              |  > idx=nat 0  > out=row[nat] []
              ?  (eq idx rel.len)
                 out
              (_ idx.inc out.snoc((show/iota rel.at(idx))))
         (weft/join "/" parts)
    (weft/item/at (weft/att "w-edit" (weft/cat [spell " " slot])))

  +  script
    '  The runtime include for container pages.
    ^  weft/node
    (weft/el "script" [(weft/att "src" "/w.js")] [])

  +  ver_nat
    '  A decimal counter off the request's ['ver] crew view (the
    '  target's /h/v record): ['top] is the sovereign's current
    '  epoch, ['first] the target's first — the scrubber's bounds.
    '  0 when the crew carries no version view.
    \  =bowl slot=path
    ^  nat
    =  vv  bowl.crew.gut(['ver] (axal/new[myth] .none))
    ?  vv.fil
     > .none  0
     > (./some t=myth)
       ?  (dig_parse (myth/txt_at slot t))
        > (./some n=nat)  n
        > .none  0

  +  scrubber
    '  The omni-scrubber: one slider that pins every fragment on the
    '  page to a shared sovereign epoch — drag left and the whole
    '  page rewinds through committed history, the right edge
    '  returns to now.  Bounds come from the request's ['ver] crew
    '  view (frag/ver_nat ['first] and ['top]); the /w.js runtime
    '  rewrites every mount's fetch through /h's epoch spelling
    '  while pinned, and polls idle because history is constant.
    \  first=nat top=nat
    ^  weft/node
    =  lo
         ?  first
            first
         1
    (weft/h "div.wscrub"
      [(weft/k (weft/h "input[type=range]"
         [(weft/a "min" (weft/show_nat lo))
          (weft/a "max" (weft/show_nat top))
          (weft/a "value" (weft/show_nat top))
          weft/wscrub]))
       (weft/k (weft/h "span.wscrub-lab" [(weft/t "now")]))])

  +  as_node
    '  A pail as a weft/node, when it holds one: node values ride
    '  pails as their branded member rows (the ['html] slot of a
    '  component's derived record), so consumers rebuild the sum.
    '  Lives here rather than in weft — weft is import-free and
    '  knows neither pail nor maybe.
    \  held=pail
    ^  maybe[weft/node]
    ?  held
     > t=weft/node/tx   (./some (./tx t.s))
     > r=weft/node/raw  (./some (./raw r.s))
     > e=weft/node/el   (./some (./el e.tag e.as e.kids))
    .none

  +  talk
    '  The fragment responder: the hydrated derived record at the /o
    '  target, its ['html] node rendered bare — no shell, no chrome.
    '  Anything short of markup is a 404 with a terse reason.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ans
         ^  row[nat]
         ?  view.fil
          > .none  [404 "no fragment at this path"]
          > (./some t=myth)
            ?  t.get(['html])
             > .none  [404 "no html slot"]
             > (./some held=pail)
               ?  (frag/as_node held)
                > .none  [404 "html slot is not markup"]
                > (./some nd=weft/node)  [200 (weft/render nd)]
       done
         .  out
            put(['res_status] (pd ans.at(0)))
            put(['res_body] (pd ans.at(1)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    (yell [] done)
+  fetch
  '  The outbound-HTTP driver vocabulary: requests and their answers
  '  ride as records; the driver record's markers are the worker's
  '  notifications.

  +  take
    '  The driver inbox kook: when a request node appears underneath
    '  (an added direct kid in the gift), mark it fresh on the driver
    '  node itself — helm x-watches each /io name's own record, so
    '  the write IS the worker's notification.  A culled kid clears
    '  its marker (pokes cannot delete slots, so markers are
    '  overwritten to 0, never removed).
    \  =bowl cur=myth gift=axal[mode]
    ^  yell
    =  events  gift.tap
    |  > idx=nat 0  > tale=myth cur
    ?  (eq idx events.len)
       (yell [] tale)
    =  [at act]  events.at(idx)
    ?  (eq 1 at.len)
       ?  ?=(.add act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 1)))
       ?  ?=(.del act)
          (_ idx.inc tale.put(['fresh at.at(0)] (pd 0)))
       (_ idx.inc tale)
    (_ idx.inc tale)

  +  form
    ^  form
    def_form.set_take(fetch/take)

  +  cfg
    '  The record for an outbound-HTTP driver node: just the fetch
    '  kook — requests carry their own config.
    ^  myth
    (kooked [['kook 'hfetch]])

  +  req
    '  An outbound fetch request as a namespace record: method, url,
    '  body (0 = none) and deadline (ms, required nonzero) ride as
    '  data pails.  Optional slots the driver honors: ['connect]
    '  ['redirects] ['maxbody], plus one ['hdr <name>] per request
    '  header.  The driver answers by poking ['res_done] ['res_ok]
    '  and the res_* payload slots onto the node — the requester's
    '  own kook (or a crew dep on the node) consumes them.
    \  method=nat url=nat body=nat deadline=nat
    ^  myth
    .  (myth/new)
       put(['method] (pd method))
       put(['url] (pd url))
       put(['body] (pd body))
       put(['deadline] (pd deadline))

  +  fresh
    '  The pending request kids marked on a driver record: keys
    '  ['fresh <kid>] whose value is 1.
    \  tale=myth
    ^  path
    =  slots  tale.tap
    |  > idx=nat 0  > out=path []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
       live
         ?  (eq 2 slot.key.len)
            ?  (eq_iota slot.key.at(0) 'fresh)
               ?  slot.val
                > x=pails/n  x.n
               0
            0
         0
    ?  live
       (_ idx.inc out.snoc(slot.key.at(1)))
    (_ idx.inc out)

  +  hdrs
    '  Request headers from a record: one [name value] per
    '  ['hdr <name>] slot (names unique, order unspecified).
    \  tale=myth
    ^  row[[n=nat v=nat]]
    =  slots  tale.tap
    |  > idx=nat 0  > out=row[[n=nat v=nat]] []
    ?  (eq idx slots.len)
       out
    =  slot  slots.at(idx)
    ?  (eq 2 slot.key.len)
       ?  (eq_iota slot.key.at(0) 'hdr)
          =  val
               ?  slot.val
                > x=pails/n  x.n
               0
          (_ idx.inc out.snoc([(quip_val slot.key.at(1)) val]))
       (_ idx.inc out)
    (_ idx.inc out)

  +  res_ok
    '  The response myth the driver pokes onto a request node when
    '  the transfer completed: the final status/url/headers/body plus
    '  the ['res_done] completion marker.
    \  status=nat url=nat headers=nat body=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 1))
       put(['res_status] (pd status))
       put(['res_url] (pd url))
       put(['res_hdrs] (pd headers))
       put(['res_body] (pd body))

  +  res_err
    '  The response myth for a failed fetch: the driver's error code
    '  (0 bad-url, 1 dns, 2 connect, 3 tls, 4 deadline, 5 redirects,
    '  6 too-large, 7 protocol).
    \  code=nat
    ^  myth
    .  (myth/new)
       put(['res_done] (pd 1))
       put(['res_ok] (pd 0))
       put(['res_err] (pd code))
+  dt
  '  The doctest driver's records.

  +  req
    '  A doctest request as a namespace record: the target's mirror
    '  path (an exact documented node, or a /boot prefix to sweep)
    '  rides as a pails/p.  The driver answers by poking ['res_done]
    '  ['passed] ['failed] onto this node and the ['dt] verdicts onto
    '  the targets themselves.
    \  tgt=path
    ^  myth
    (myth/new).put(['target] (pails/p tgt))

  +  cfg
    '  The record for a doctest driver node: the shared chore driver
    '  config, defaulting requests to the doctest family — requests
    '  carry their target, verdicts land on the documented nodes.
    ^  myth
    (chore/cfg 'doctest)
+  explorer
  '  The namespace explorer: the /ns node browser served over HTTP.

  +  css
    '  The explorer stylesheet: glue over the mash design system.
    '  Colors, type, spacing, and radii all ride the mash tokens the
    '  IIFE injects (auto light/dark); the component recipe itself is
    '  the vendored catalogue served at /style.css .  The legacy
    '  utility classes (.pane .chip .muted ..) stay for the app faces
    '  that share this sheet, restyled onto the same tokens.
    ^  nat
    =  base   "body{margin:0;background:var(--color-canvas);color:var(--color-text);font-family:var(--type-body-font-family);font-size:var(--type-body-font-size);line-height:var(--type-body-line-height)} main{max-width:72rem;margin:0 auto;padding:var(--space-container-block) var(--space-container-inline)} a{color:var(--color-action);text-decoration:none} a:hover{text-decoration:underline} pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font-family:var(--type-code-font-family);font-size:var(--type-code-font-size);line-height:var(--type-code-line-height)}"
       heads  "h1{margin:0;font-family:var(--type-heading-font-family);font-size:var(--type-heading-font-size);font-weight:var(--type-heading-font-weight);line-height:var(--type-heading-line-height)} h2{margin:0 0 8px;font-family:var(--type-label-font-family);font-size:var(--type-label-small-font-size);font-weight:var(--type-label-font-weight);letter-spacing:.08em;text-transform:uppercase;color:var(--color-text-muted)} .top{display:flex;justify-content:space-between;align-items:baseline;gap:1em;padding-bottom:10px;border-bottom:var(--border-hairline) solid var(--color-border)}"
       pane   ".pane{background:var(--color-surface);border:var(--border-hairline) solid var(--color-border);border-radius:var(--radius-container);padding:var(--space-container-block) var(--space-container-inline);margin:var(--space-stack) 0} .failpane{border-color:var(--color-critical)} .failpane h2{color:var(--color-critical)} ui-card{margin:0 0 var(--space-stack)}"
       slots  ".slots{display:grid;grid-template-columns:minmax(9rem,16rem) 1fr;gap:3px 16px;align-items:baseline} .key{color:var(--color-text-muted);text-align:right;overflow-wrap:anywhere;font-family:var(--type-code-font-family);font-size:var(--type-code-font-size)} .val{min-width:0} .row{padding:3px 8px;border-bottom:var(--border-hairline) solid var(--color-border);display:flex;gap:10px;align-items:baseline} .row:last-child{border-bottom:none} .row:hover{background:var(--color-surface-sunken)}"
       chips  ".muted{color:var(--color-text-muted)} .khead{margin-left:14px} .chip{padding:1px 8px;border-radius:var(--radius-pill);font-size:var(--type-label-small-font-size);margin-left:10px;white-space:nowrap} .ok{background:var(--color-positive);color:var(--color-on-positive)} .bad{background:var(--color-critical);color:var(--color-on-critical)} .mut{background:var(--color-neutral);color:var(--color-on-neutral)}"
       lore   ".lore-head{font-family:var(--type-heading-font-family);font-weight:var(--type-heading-font-weight);margin:0 0 2px} .lore-body{color:var(--color-text-muted);margin:2px 0 10px} .lore-line{padding:1px 0} .dtsrc{font-family:var(--type-code-font-family);font-size:var(--type-code-font-size)} .tysig{color:var(--color-text-muted);display:inline-block;vertical-align:top}"
       care   ".care{padding:0 6px;border-radius:var(--radius-pill);font-size:var(--type-label-small-font-size);margin-right:6px;background:var(--color-surface-sunken)} .care-x{color:var(--color-action)} .care-y{color:var(--color-warning)} .care-z{color:var(--color-critical)} .case{padding:0 6px;border-radius:var(--radius-control)} .cur{background:var(--color-neutral);color:var(--color-on-neutral)}"
       forms_ "details>summary{cursor:pointer;color:var(--color-text-muted);font-size:var(--type-label-font-size);margin-bottom:6px} input,textarea,select,button{font-family:var(--type-body-font-family);font-size:var(--type-body-font-size);color:var(--color-text);background:var(--color-surface);border:var(--border-hairline) solid var(--color-border);border-radius:var(--radius-control);padding:var(--space-control-block-small) var(--space-control-inline-small)} button{cursor:pointer} textarea{width:100%;box-sizing:border-box;font-family:var(--type-code-font-family);font-size:var(--type-code-font-size)} form.wf{display:flex;gap:var(--space-control-gap);align-items:flex-end;flex-wrap:wrap} form.wf ui-input{flex:1;min-width:14rem}"
       scrub  ".wscrub{position:sticky;bottom:0;margin-top:1.5em;padding:.6em .8em;background:var(--color-surface);border-top:var(--border-hairline) solid var(--color-border);display:flex;gap:.8em;align-items:center;font-size:var(--type-label-font-size);color:var(--color-text-muted)} .wscrub input{flex:1}"
       trip   ".tside{padding:var(--space-container-block) var(--space-container-inline)} .tmain{padding:var(--space-container-block) var(--space-container-inline);max-width:64rem;margin:0 auto} .tinsp{padding:var(--space-container-block) var(--space-container-inline)} .locbar{display:flex;justify-content:space-between;align-items:center;gap:1em;width:100%;font-family:var(--type-code-font-family);font-size:var(--type-code-font-size)} .navcol{display:flex;flex-direction:column;gap:4px} .zoo{display:grid;grid-template-columns:repeat(auto-fill,minmax(24rem,1fr));gap:var(--space-container-gap)}"
    (weft/cat [base heads pane slots chips lore care forms_ scrub trip])

  +  url
    '  The explorer href for a path.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/ns"
    (weft/cat2 "/ns" (show/path p))

  +  rows
    '  Weld a row of node rows into one page body.
    \  parts=row[row[weft/node]]
    ^  row[weft/node]
    |  > idx=nat 0  > out=row[weft/node] []
    ?  (eq idx parts.len)
       out
    (_ idx.inc out.weld(parts.at(idx)))

  +  badge
    '  A mash badge — the design system's chip.
    \  tone=nat s=nat
    ^  weft/node
    (weft/h "ui-badge[size=small]" [(weft/a "tone" tone) (weft/t s)])

  +  card
    '  A mash card: a titled pane with content kids.
    \  title=nat kids=row[weft/node]
    ^  weft/node
    (weft/h "ui-card"
      [(weft/k (weft/h "span[slot=title]" [(weft/t title)]))
       (weft/k (weft/h "div[slot=content]" [(weft/ks kids)]))])

  +  table
    '  A mash table wrapping prebuilt ui-table-row nodes.
    \  label=nat rws=row[weft/node]
    ^  weft/node
    (weft/h "ui-table"
      [(weft/a "label" label)
       (weft/k (weft/h "ui-table-body" [(weft/ks rws)]))])

  +  js
    '  The explorer's page script: tree items are not anchors — the
    '  design system fires selection events instead — so selection
    '  navigates to the item's path under /ns.  Single-quote only:
    '  cord literals cannot hold a double-quote byte.
    ^  nat
    "document.addEventListener('ui-tree-item-select',function(e){var t=e.target;var p=t&&t.getAttribute?t.getAttribute('path'):null;if(p){location.href='/ns'+p}});"

  +  forms
    '  The workspace forms on a /boot module page: evaluate an
    '  expression against the module's subject, or edit and save its
    '  source — both plain POSTs to the /chore bridge, answered as
    '  text by the build chore families.
    \  tgt=path src=nat
    ^  row[weft/node]
    =  modp  (show/path tgt.drop(1))
       evalf
         (weft/h "form.wf[method=post]"
           [(weft/a "action" (weft/cat2 "/chore/eval" modp))
            (weft/k (weft/h "ui-input[name=expr][label=eval against the module subject][placeholder=(expr)]" []))
            (weft/k (weft/h "ui-button[type=submit][variant=secondary][size=small]"
              [(weft/t "eval")]))])
       savef
         (weft/h "form[method=post]"
           [(weft/a "action" (weft/cat2 "/chore/save" modp))
            (weft/k (weft/h "textarea[name=src][rows=24]" [(weft/t src)]))
            (weft/k (weft/h "div"
              [(weft/k (weft/h "ui-button[type=submit][variant=secondary][size=small]"
                 [(weft/t "save & recompile")]))]))])
    [evalf savef]

  +  act
    '  The write box: emit a make, poke, or cull at this node from
    '  the explorer.  The expression evaluates against the boot
    '  subject to the writ's myth (ignored for cull); the POST rides
    '  /vine/<path> and the http worker emits the task as an
    '  ordinary driver cmd.
    \  tgt=path
    ^  weft/node
    (weft/h "form.wf[method=post]"
      [(weft/a "action" (weft/cat2 "/vine" (show/path tgt)))
       (weft/k (weft/h "ui-select[name=verb][value=poke][label=verb]"
         [(weft/k (weft/h "ui-option[value=poke]" [(weft/t "poke")]))
          (weft/k (weft/h "ui-option[value=make]" [(weft/t "make")]))
          (weft/k (weft/h "ui-option[value=cull]" [(weft/t "cull")]))]))
       (weft/k (weft/h "ui-input[name=expr]"
         [(weft/a "placeholder" "(myth/sing ['n] (pd 41))")]))
       (weft/k (weft/h "ui-button[type=submit][variant=secondary][size=small]"
         [(weft/t "emit")]))])

  +  case_count
    '  Read one decimal counter from a version-view myth.
    \  key=path tale=myth
    ^  nat
    >  (./some n=nat) (dig_parse tale.txt_at(key))
       0
    n

  +  case_links
    '  Links for one target-local care history, cases 1 through n —
    '  a compact scrubber with the current case highlighted.
    \  care=iota n=nat tgt=path
    ^  row[weft/node]
    |  > idx=nat 1  > out=row[weft/node] []
    ?  (gt idx n)
       out
    =  hist=path  ['h care ($u idx) ($u tgt.len)]
       cl
         ?  (eq idx n)
            "case cur"
         "case"
       link
         (weft/leaf "a"
           [(weft/href (explorer/url hist.weld(tgt))) (weft/cls cl)]
           (show/iota ($u idx)))
    (_ idx.inc out.snoc((weft/tx " ")).snoc(link))

  +  slot_val
    '  One slot value as HTML: linked paths and modules, long texts
    '  folded behind details, crew and kook structure, and the
    '  reflection walker for the open remainder.
    \  key=path held=pail
    ^  weft/node
    ?  held
     > t=pails/t
       ?  (eq_pith key ['module])
          (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" t.t))] t.t)
       ?  (gt (show/lines t.t) 15)
          (weft/el "details" []
            [(weft/leaf "summary" []
               (weft/cat2 (weft/show_nat (show/lines t.t)) " lines"))
             (weft/leaf "pre" [] t.t)])
       (weft/leaf "pre" [] t.t)
     > d=pails/ty
       (weft/leaf "pre" [(weft/cls "tysig")] (tyshow/pretty d.t))
     > p=pails/p
       (weft/leaf "a" [(weft/href (explorer/url p.p))] (show/path p.p))
     > ps=pails/ps
       =  links
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j ps.ps.len)
               out
            =  link
                 (weft/leaf "a" [(weft/href (explorer/url ps.ps.at(j)))]
                   (show/path ps.ps.at(j)))
            (_ j.inc out.snoc((weft/tx "  ")).snoc(link))
       (weft/el "span" [] links)
     > c=cpail
       =  entries  c.crew.tap
          crewrows
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j entries.len)
               out
            =  e  entries.at(j)
               cn
                 ?  e.val.c
                  > .x  "x"
                  > .y  "y"
                  > .z  "z"
            (_ j.inc
               out.snoc(
                 (weft/el "div" []
                   [(weft/leaf "span" [(weft/cls (weft/cat2 "care care-" cn))] cn)
                    (weft/leaf "a" [(weft/href (explorer/url e.val.p))]
                      (show/path e.val.p))
                    (weft/leaf "span" [(weft/cls "muted khead")]
                      (show/path e.key))])))
       (weft/el "div" [] crewrows)
     > k=kook
       =  links
            |  > j=nat 0  > out=row[weft/node] []
            ?  (eq j k.refs.len)
               out
            =  link
                 (weft/leaf "a" [(weft/href (explorer/url k.refs.at(j)))]
                   (show/path k.refs.at(j)))
            (_ j.inc out.snoc((weft/tx "  ")).snoc(link))
       (weft/el "span" [] links)
    (weft/leaf "pre" [(weft/cls "val")] (show/pail held))

  +  dt_chip
    '  One doctest's verdict chip: pass/got from the verdict's
    '  results, greyed when the verdict's case is behind the node's
    '  current x case (curx as decimal text; 0 = unknown, no
    '  staleness call).
    \  verdict=doctest/verdict curx=nat j=nat
    ^  weft/node
    =  stale
         ?  (eq 0 curx)
            0
         !(eq curx (weft/show_nat verdict.case))
    ?  (ge j verdict.results.len)
       (explorer/badge "neutral" "no result")
    ?  stale
       (explorer/badge "neutral" (weft/cat2 "stale v" (weft/show_nat verdict.case)))
    =  [_ pass got]  verdict.results.at(j)
    ?  pass
       (explorer/badge "positive" "pass")
    (explorer/badge "critical" (weft/cat2 "got " got))

  +  dt_row1
    '  One rendered doctest row.
    \  src=nat want=nat chip=weft/node
    ^  weft/node
    (weft/h "div.row"
      [(weft/t "?=  ")
       (weft/k (weft/h "span.dtsrc" [(weft/t src)]))
       (weft/t "  ->  ")
       (weft/k (weft/h "span.dtsrc" [(weft/t want)]))
       (weft/k chip)])

  +  dt_rows
    '  A lore's doctests with verdict chips.
    \  doc=lore verdict=doctest/verdict curx=nat
    ^  row[weft/node]
    |  > j=nat 0  > out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    (_ j.inc out.snoc((explorer/dt_row1 src want (explorer/dt_chip verdict curx j))))

  +  dt_rows_never
    '  A lore's doctests, never yet run.
    \  doc=lore
    ^  row[weft/node]
    |  > j=nat 0  > out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    (_ j.inc out.snoc((explorer/dt_row1 src want (explorer/badge "neutral" "never run"))))
  +  page
    '  The node browser on the design-system shell: an sh-triptych
    '  with the kid tree in the sidebar, breadcrumbs in the locator
    '  strip, the node's lore/record/act/workspace as cards in the
    '  main pane, and version/system state in the inspector.  Tree
    '  selection navigates via explorer/js — the design system fires
    '  events, not anchors.
    \  tgt=path view=axal[myth] ver=axal[myth]
    ^  nat
    =  root  (weft/leaf "a" [(weft/href "/ns")] "ns")
       crumbs
         |  > idx=nat 0  > out=row[weft/node] [root]
         ?  (eq idx tgt.len)
            out
         =  pre   tgt.take(idx.inc)
            link  (weft/leaf "a" [(weft/href (explorer/url pre))] (show/iota tgt.at(idx)))
         (_ idx.inc out.snoc((weft/tx " / ")).snoc(link))
       nav
         =  hlnk  (weft/h "a.muted[href=/ns/h]" [(weft/t "time travel")])
         ?  (is_h tgt)
            ?  (lt tgt.len 3)
               [hlnk]
            =  shift
                 ?  (eq_iota tgt.at(1) 'v)
                    3
                 4
            ?  (lt tgt.len shift)
               [hlnk]
            =  live  tgt.drop(shift)
               llnk  (weft/lnk (explorer/url live) "view live")
            [hlnk (weft/tx " | ") llnk]
         [hlnk]
       curx
         ?  ver.fil
          > (./some tale=myth)  tale.txt_at(['x_data])
          > .none  0
       doccards
         ?  view.fil
          > .none  []
          > (./some tale=myth)
            ?  tale.get(bond/help)
             > .none  []
             > (./some held=pail)
               ?  held
                > doc=lore
                  =  bodyrows
                       |  > j=nat 1  > out=row[weft/node] []
                       ?  (ge j doc.body.len)
                          out
                       (_ j.inc out.snoc((weft/leaf "div" [(weft/cls "lore-line")] doc.body.at(j))))
                     bodynode
                       ?  (gt doc.body.len 7)
                          (weft/el "details" []
                            [(weft/leaf "summary" [] "more")
                             (weft/el "div" [] bodyrows)])
                       (weft/el "div" [] bodyrows)
                     testrows
                       ?  view.dip(['dt]).fil
                        > (./some dtale=myth)
                          ?  dtale.get(['dt])
                           > (./some held2=pail)
                             ?  held2
                              > verdict=doctest/verdict  (explorer/dt_rows doc verdict curx)
                             (explorer/dt_rows_never doc)
                           > .none  (explorer/dt_rows_never doc)
                        > .none  (explorer/dt_rows_never doc)
                     kbase  [(weft/el "div" [(weft/cls "lore-body")] [bodynode])]
                  [(explorer/card doc.head kbase.weld(testrows))]
               []
       slotrows
         '  [data-rows sys-rows]: each slot as a ui-table-row; /sys
         '  slots split out into the inspector's own table.
         ?  view.fil
          > .none  [[] []]
          > (./some tale=myth)
            =  entries  tale.tap
            |  > idx=nat 0  > dat=row[weft/node] []  > sys=row[weft/node] []
            ?  (eq idx entries.len)
               [dat sys]
            =  slot  entries.at(idx)
            ?  (eq_pith slot.key bond/help)
               (_ idx.inc dat sys)
            ?  (eq_pith slot.key bond/lede)
               (_ idx.inc dat sys)
            =  rw
                 (weft/el "ui-table-row" []
                   [(weft/el "ui-table-cell" [(weft/cls "key")] [(weft/tx (show/path slot.key))])
                    (weft/el "ui-table-cell" [(weft/cls "val")] [(explorer/slot_val slot.key slot.val)])])
            ?  (eq 0 slot.key.len)
               (_ idx.inc dat.snoc(rw) sys)
            ?  (eq_iota slot.key.at(0) 'sys)
               (_ idx.inc dat sys.snoc(rw))
            (_ idx.inc dat.snoc(rw) sys)
       [drows srows]  slotrows
       failed
         '  a fail tombstone ([status]="failed" — broken apps and
         '  modules are visible namespace citizens) badges its record
         ?  view.fil
          > .none  .false
          > (./some ft=myth)
            ?  ft.get(['status])
             > (./some sp=pail)
               ?  sp
                > t=pails/t  (eq t.t "failed")
                .false
             > .none  .false
       recbody
         ?  view.fil
          > .none  [(weft/leaf "div" [(weft/cls "muted")] "no record at this node")]
          > (./some tale2=myth)
            ?  (eq 0 drows.len)
               [(weft/leaf "div" [(weft/cls "muted")] "empty record")]
            [(explorer/table "record" drows)]
       recmeta
         ^  row[weft/node]
         ?  failed
            [(weft/el "ui-badge" [(weft/att "slot" "meta") (weft/att "tone" "critical") (weft/att "size" "small")] [(weft/tx "failed")])]
         []
       reccard
         =  rectitle  [(weft/el "span" [(weft/att "slot" "title")] [(weft/tx "record")])]
         =  kids3  rectitle.weld(recmeta).snoc((weft/el "div" [(weft/att "slot" "content")] recbody))
         [(weft/el "ui-card" [] kids3)]
       kidtree
         =  entries  view.kid_tap
         ?  (eq 0 entries.len)
            [(weft/leaf "div" [(weft/cls "muted")] "no kids")]
         =  items
              |  > idx=nat 0  > out=row[weft/node] []
              ?  (eq idx entries.len)
                 out
              =  kid   entries.at(idx)
                 meta
                   ^  row[weft/node]
                   ?  view.kid_get(kid.key)
                    > (./some kaxal=axal[myth])
                      ?  kaxal.fil
                       > (./some ktale=myth)
                         ?  ktale.get(bond/lede)
                          > (./some kheld=pail)
                            ?  kheld
                             > kt=pails/t  [(weft/leaf "span" [(weft/att "slot" "meta") (weft/cls "muted")] kt.t)]
                            []
                          > .none  []
                       > .none  []
                    > .none  []
                 item
                   (weft/h "ui-tree-item[level=1]"
                     [(weft/a "path" (show/path tgt.snoc(kid.key)))
                      (weft/a "title" (show/iota kid.key))
                      (weft/ks meta)])
              (_ idx.inc out.snoc(item))
         [(weft/el "ui-tree" [(weft/att "label" "kids")] items)]
       sidebar
         (weft/h "div.tside[slot=sidebar]"
           [(weft/k (weft/h "h2" [(weft/t "kids")]))
            (weft/ks kidtree)])
       navslot
         (weft/h "div.tside.navcol[slot=navigate]"
           [(weft/k (weft/lnk "/ns" "namespace"))
            (weft/k (weft/lnk "/weft" "zoo"))
            (weft/k (weft/lnk "/ns/h" "time travel"))])
       locator
         (weft/h "div.locbar[slot=locator]"
           [(weft/k (weft/h "div" [(weft/ks crumbs)]))
            (weft/k (weft/h "div.muted" [(weft/ks nav)]))])
       wpane
         '  a /boot module node (source, no entry kind) gets the
         '  workspace forms
         ?  view.fil
          > .none  []
          > (./some tale=myth)
            =  src  (myth/txt_at bond/src tale)
            ?  (eq 0 src)
               []
            ?  (myth/has_at ['kind] tale)
               []
            ?  (eq 0 tgt.len)
               []
            ?  (eq_iota tgt.at(0) 'boot)
               [(explorer/card "workspace" (explorer/forms tgt src))]
            []
       actpane
         '  no writes into the read-only /h, /o, and /x overlays
         ?  (is_h tgt)
            []
         ?  (is_o tgt)
            []
         ?  (is_xv tgt)
            []
         [(explorer/card "act" [(explorer/act tgt)])]
       vrows
         ^  row[weft/node]
         ?  ver.fil
          > .none  []
          > (./some tale=myth)
            =  vcells
                 =  entries  tale.tap
                 |  > idx=nat 0  > out=row[weft/node] []
                 ?  (eq idx entries.len)
                    out
                 =  slot  entries.at(idx)
                    rw
                      (weft/el "ui-table-row" []
                        [(weft/el "ui-table-cell" [(weft/cls "key")] [(weft/tx (show/path slot.key))])
                         (weft/el "ui-table-cell" [(weft/cls "val")] [(weft/tx (show/pail slot.val))])])
                 (_ idx.inc out.snoc(rw))
               caserow
                 \  label=nat links=row[weft/node]
                 (weft/el "ui-table-row" []
                   [(weft/el "ui-table-cell" [(weft/cls "key")] [(weft/tx label)])
                    (weft/el "ui-table-cell" [(weft/cls "val")] links)])
               hist
                 [(caserow "x cases" (explorer/case_links 'x (explorer/case_count ['x_data] tale) tgt))
                  (caserow "y cases" (explorer/case_links 'y (explorer/case_count ['y_data] tale) tgt))
                  (caserow "z cases" (explorer/case_links 'z (explorer/case_count ['z_data] tale) tgt))]
            [(weft/leaf "h2" [] "version")
             (explorer/table "version" vcells.weld(hist))]
       sysrows
         ^  row[weft/node]
         ?  (eq 0 srows.len)
            []
         [(weft/leaf "h2" [] "system")
          (explorer/table "system" srows)]
       insp
         =  ikids  vrows.weld(sysrows)
         =  ikids2
              ?  (eq 0 ikids.len)
                 [(weft/leaf "div" [(weft/cls "muted")] "no state")]
              ikids
         (weft/el "div" [(weft/att "slot" "inspector") (weft/cls "tinsp")] ikids2)
       mainc
         (weft/el "div" [(weft/cls "tmain")]
           (explorer/rows [doccards reccard actpane wpane]))
       body
         [(weft/el "sh-triptych" [] [sidebar navslot locator mainc insp])
          (weft/el "script" [] [(weft/raw explorer/js)])]
    (weft/page (show/path tgt) explorer/css body)

  +  talk
    '  The namespace explorer responder: render the request's
    '  hydrated target view as the node browser page.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       tgt=path
         ?  out.get(['vpath])
          > (./some held=pail)
            ?  held
             > p=pails/p  p.p
            []
          > .none  []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ver   bowl.crew.gut(['ver] (axal/new[myth] .none))
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (explorer/page tgt view ver)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    (yell [] done)

  +  route_talk
    '  The default responder with app-face dispatch: probe the face
    '  kook at every ancestor of the target, deepest first, and
    '  delegate to the first face whose ['hunt] slot claims the
    '  target (face_hunt: the claim is data on the face record; an
    '  absent slot claims the whole subtree) — the form's talk
    '  receives the same bowl, so the hydrated ['view] crew rides
    '  along.  A face whose hunt declines (a .x/.y hunt over a
    '  deeper target, or a claim rooted in a sibling subtree) falls
    '  through to the next ancestor's face; no app, no face, or a
    '  malformed face node all fall through to the explorer.
    '  Fragment requests (the ['frag] marker the /frag route stamps)
    '  answer bare component markup and skip dispatch entirely.
    \  =bowl cur=myth add=myth
    ^  yell
    =  o  cur.meld(add)
    ?  (myth/has_at ['frag] o)
       (frag/talk bowl cur add)
    =  tgt  (http/tgt_of o)
    |  > n=nat tgt.len
    ^  yell
    ?  (lt n 1)
       (explorer/talk bowl cur add)
    =  fv  bowl.crew.gut(['face ($u n)] (axal/new[myth] .none))
    ?  (http/face_of fv)
     > (./some f=form)
       ?  (http/hunt_admits (http/face_hunt fv) tgt.take(n) tgt)
          =  g  f.talk
          (g bowl cur add)
       (_ (dec n))
     > .none  (_ (dec n))

  +  form
    ^  form
    def_form.set_talk(explorer/route_talk)
+  zoo
  '  The global component registry at /weft, and its face — the zoo.
  '  Registration is denormalized: a face only sees its own hydrated
  '  subtree, so each registered component's kid under /weft carries
  '  everything the zoo needs — the part path, the demo data path,
  '  and the lede — copied from the app's weft card at mount time by
  '  the host (a mount expansion is jailed to its own subtree, so an
  '  app cannot register itself in-kernel).

  +  root
    '  The registry root, by convention.
    ^  path
    ['weft]

  +  key
    '  A registry kid key for a component path: its segments joined
    '  with "_" as one symbol.
    '  ?=  ((zoo/key ['chat 'weft 'log]) 'chat_weft_log)
    \  p=path
    ^  iota
    =  parts
         |  > i=nat 0  > out=row[nat] []
         ?  (ge i p.len)
            out
         (_ i.inc out.snoc((show/iota p.at(i))))
    ($ts (weft/join "_" parts))

  +  path_at
    '  A path pail in a slot, or the empty path.
    \  at=path t=myth
    ^  path
    ?  t.get(at)
     > (./some held=pail)
       ?  held
        > p=pails/p  p.p
       []
     > .none  []

  +  kind_of
    '  The ctor's family as text, for the kind chip.
    \  t=myth
    ^  nat
    ?  t.get(bond/weft)
     > .none  ""
     > (./some held=pail)
       ?  held
        > dyed  "dyed"
        > knit  "knit"
        > felt  "felt"
        > sewn  "sewn"
       ""

  +  entry
    '  One weft seed as its registry record: the whole card COPIED —
    '  minus the ctor itself — with every path value rebased against
    '  the mount root (the seed is pre-expansion, so "."-relative
    '  values still carry the rel marker), plus the component's
    '  absolute part path, its ctor kind, and its module.  The lore
    '  rides through whole, so a registry kid documents its component
    '  without reaching outside /weft.
    \  root=path at=path mod=nat t=myth
    ^  myth
    =  part=path  root.weld(at)
       base
         =  slots  t.tap
         |  > i=nat 0  > out=myth myth/new
         ^  myth
         ?  (ge i slots.len)
            out
         =  s  slots.at(i)
         ?  (eq_pith s.key bond/weft)
            (_ i.inc out)
         (_ i.inc out.put(s.key s.val))
       based  (pact/rebase_rec root base)
       b2
         ?  (myth/has_at ['demo] based)
            based
         based.put(['demo] (pails/p part))
    .  b2
       put(['part] (pails/p part))
       put(['kind] (pails/t (zoo/kind_of t)))
       put(['module] (pails/t mod))

  +  tasks
    '  Registration tasks for an app's manifest: one make under /weft
    '  per seed carrying a /sys/weft ctor.  The host runs these after
    '  a successful mount; a failed registration is logged, never
    '  fatal.
    \  root=path mod=nat m=mani
    ^  row[task]
    =  seeds  m.seeds
    |  > i=nat 0  > out=row[task] []
    ^  row[task]
    ?  (ge i seeds.len)
       out
    =  [sp st]  seeds.at(i)
    ?  (myth/has_at bond/weft st)
       =  zr=path  zoo/root
          at=path  zr.snoc((zoo/key root.weld(sp)))
          tk
            ^  task
            (./vine at (writ/make (zoo/entry root sp mod st)))
       (_ i.inc out.snoc(tk))
    (_ i.inc out)

  +  card1
    '  One zoo index pane: the component's lede, kind, and paths, the
    '  component itself mounted live against its default demo, and a
    '  link to its documentation page.
    \  key=iota t=myth
    ^  weft/node
    =  part=path  (zoo/path_at ['part] t)
       demo=path  (zoo/path_at ['demo] t)
       idc  (show/iota key)
    (weft/h "ui-card[elevation=raised]"
      [(weft/k (weft/h "span[slot=title]"
         [(weft/k (weft/lnk (weft/cat2 "/weft/" idc) idc))]))
       (weft/k (weft/h "span[slot=description]"
         [(weft/t (myth/txt_at bond/lede t))]))
       (weft/k (weft/h "ui-badge[slot=meta][tone=neutral][size=small]"
         [(weft/t (myth/txt_at ['kind] t))]))
       (weft/k (weft/h "div[slot=content]"
         [(weft/k (frag/mount idc part demo 2))]))
       (weft/k (weft/h "div.muted[slot=footer]"
         [(weft/k (weft/lnk (explorer/url part) (show/path part)))
          (weft/t " over ")
          (weft/k (weft/lnk (explorer/url demo) (show/path demo)))]))])

  +  demo_mounts
    '  Every demo slot of a registry kid as a labeled pane with the
    '  component mounted live: ['demo] is the default state, each
    '  ['demo <name>] a named one.
    \  part=path t=myth
    ^  row[weft/node]
    =  slots  t.tap
    |  > i=nat 0  > out=row[weft/node] []
    ^  row[weft/node]
    ?  (ge i slots.len)
       out
    =  s  slots.at(i)
    ?  (eq 0 s.key.len)
       (_ i.inc out)
    ?  !(eq_iota s.key.at(0) 'demo)
       (_ i.inc out)
    =  dp=path
         ?  s.val
          > p=pails/p  p.p
         []
    ?  (eq 0 dp.len)
       (_ i.inc out)
    =  label
         ?  (eq 1 s.key.len)
            "demo"
         (show/iota s.key.at(1))
       pane
         (weft/el "ui-card" []
           [(weft/el "span" [(weft/att "slot" "title")] [(weft/tx label)])
            (weft/el "span" [(weft/att "slot" "meta") (weft/cls "muted")]
              [(weft/leaf "a" [(weft/href (explorer/url dp))] (show/path dp))])
            (weft/el "div" [(weft/att "slot" "content")]
              [(frag/mount (weft/cat2 "d" (weft/show_nat i)) part dp 2)])])
    (_ i.inc out.snoc(pane))

  +  page1
    '  A component's documentation page: kind, module, part, the full
    '  lore (head, body, and its doctests as written), and every demo
    '  state mounted live.
    \  key=iota t=myth
    ^  nat
    =  part=path  (zoo/path_at ['part] t)
       kind  (myth/txt_at ['kind] t)
       mod   (myth/txt_at ['module] t)
       docrows
         ^  row[weft/node]
         ?  t.get(bond/help)
          > .none  []
          > (./some held=pail)
            ?  held
             > doc=lore
               =  base
                    [(weft/h "div.lore-head" [(weft/t doc.head)])
                     (weft/h "div.lore-body"
                       [(weft/each[nat] doc.body.drop(1)
                          (\ ln (weft/h "div.lore-line" [(weft/t ln)])))])]
               ?  (eq 0 doc.tests.len)
                  base
               base.weld((explorer/dt_rows_never doc))
            []
       header
         [(weft/h "div.top"
            [(weft/k (weft/h "h1"
               [(weft/k (weft/lnk "/weft" "zoo"))
                (weft/t " / ")
                (weft/t (show/iota key))]))
             (weft/k (weft/h "div.muted"
               [(weft/k (explorer/badge "neutral" kind))
                (weft/t "  ")
                (weft/k (weft/lnk (weft/cat2 "/ns/boot/" mod) mod))
                (weft/t "  ")
                (weft/k (weft/lnk (explorer/url part) (show/path part)))]))])]
       docpane
         ^  row[weft/node]
         ?  (eq 0 docrows.len)
            []
         [(explorer/card "lore" docrows)]
       mounts  (zoo/demo_mounts part t)
       body
         [(weft/el "main" []
            header.weld(docpane).weld(mounts).snoc(frag/script))]
    (weft/page (show/iota key) explorer/css body)

  +  talk
    '  The zoo face: the index (every registered component rendered
    '  live) at the root, a component's documentation page when the
    '  target is a registry kid.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       tgt=path
         ?  out.get(['vpath])
          > (./some held=pail)
            ?  held
             > p=pails/p  p.p
            []
          > .none  []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       detail
         '  a registry kid target: its own hydrated record, provided
         '  it is an entry (the face card at /weft/kook has no part)
         ^  maybe[myth]
         ?  (lt tgt.len 2)
            .none
         ?  view.fil
          > .none  .none
          > (./some t=myth)
            ?  (eq 0 (zoo/path_at ['part] t).len)
               .none
            (./some t)
    ?  detail
     > (./some t=myth)
       =  done1
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (zoo/page1 tgt.at(1) t)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       (yell [] done1)
     > .none
       =  entries  view.kid_tap
          panes
            ?  (eq 0 entries.len)
               [(weft/leaf "div" [(weft/cls "muted")] "no components registered")]
            |  > i=nat 0  > ns=row[weft/node] []
            ^  row[weft/node]
            ?  (ge i entries.len)
               ns
            =  e  entries.at(i)
            ?  e.val.fil
             > .none  (_ i.inc ns)
             > (./some t=myth)
               '  only registry entries: /weft/kook (the face) is a
               '  kid of the same root and carries no ['part]
               ?  (eq 0 (zoo/path_at ['part] t).len)
                  (_ i.inc ns)
               (_ i.inc ns.snoc((zoo/card1 e.key t)))
          head  [(weft/leaf "h1" [] "component zoo")]
          grid  [(weft/el "div" [(weft/cls "zoo")] panes)]
          body  [(weft/el "main" [] head.weld(grid).snoc(frag/script))]
          done
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (weft/page "component zoo" explorer/css body)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       (yell [] done)

  +  form
    '  The zoo behavior: talk renders.  Seeded as the face card at
    '  /weft/kook/face by the root convention tasks.
    ^  form
    def_form.set_talk(zoo/talk)
