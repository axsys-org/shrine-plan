-  lain
-  weft
-  pact
-  chore
'  web: everything the namespace shows the outside world over HTTP —
'  the serving and fetching driver vocabularies (records in, records
'  out; the host workers only shuttle), the doctest driver's records,
'  and the namespace explorer rendered over weft.
+  show_iota
  '  A quip as text: text auras ride their cord, the rest render
  '  their payload as decimal.
  \  i=quip
  ^  nat
  ?  (is_text i)
     (quip_val i)
  (weft/show_nat (quip_val i))
+  show_path
  '  A path as "/a/b"; the empty path as "/".
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     "/"
  =  parts
       |  > i=nat 0  > acc=row[nat] []
       ?  (eq i p.len)
          acc
       (_ i.inc acc.snoc((show_iota p.at(i))))
  (weft/cat2 "/" (weft/join "/" parts))
+  show_pail
  '  A slot value as text: the payloads this layer knows, and a shrug
  '  for the open remainder.
  \  pl=pail
  ^  nat
  ?  pl
   > x=pails/n  (weft/show_nat x.n)
   > q2=pails/q  (show_iota q2.q)
   > p2=pails/p  (show_path p2.p)
   > k=kook
     =  refs  k.refs
     =  parts
          |  > i=nat 0  > acc=row[nat] []
          ?  (eq i refs.len)
             acc
          (_ i.inc acc.snoc((show_path refs.at(i))))
     (weft/cat2 "kook " (weft/join " " parts))
   > c3=cpail
     =  cm  c3.crew
     (weft/cat2 "crew " (weft/show_nat cm.size))
   > pr=pails/ps
     =  rs  pr.ps
     =  parts2
          |  > i=nat 0  > acc=row[nat] []
          ?  (eq i rs.len)
             acc
          (_ i.inc acc.snoc((show_path rs.at(i))))
     (weft/join "  " parts2)
   > f4=form  "form"
   > t5=pails/t  t5.t
   > c5=pails/code  "code"
   > l6=lore
     ?  (eq 0 l6.tests.len)
        l6.head
     (weft/cat2 l6.head (weft/cat2 "  [?= " (weft/cat2 (weft/show_nat l6.tests.len) "]")))
  "opaque"
+  http
  '  The inbound-HTTP driver vocabulary: driver configs, request
  '  records, and the behaviors the serving kook installs.
  +  respond_talk
    '  The responder the serving kook installs on a request node: the
    '  installing poke's talk answers 200, echoing the request's body
    '  slot (or its url when there is no body).
    \  b=bowl cur=myth add=myth
    ^  yell
    =  o  cur.meld(add)
    =  > pay=pail
         ?  o.get(['body])
          > (./some pl=pail)  pl
          > .none
            ?  o.get(['url])
             > (./some u=pail)  u
             > .none  (pd 0)
    =  o1  o.put(['res_status] (pd 200))
    =  o2  o1.put(['res_body] pay)
    (yell [] o2)
  +  respond_form
    ^  form
    def_form.set_talk(http/respond_talk)
  +  serve_take
    '  The serving kook for an HTTP driver node: when a request node
    '  appears underneath (an added direct kid in the gift), emit a
    '  poke installing the configured responder kook on it — the same
    '  poke's talk then writes the response, all within the event.
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    ?  cur.quip_at(['serve])
     > .none  (yell [] cur)
     > (./some rid=quip)
       =  here  b.here
       =  es  g.tap
       |  > i=nat 0  > cs=row[[p=path q=writ]] []
       ?  (eq i es.len)
          (yell cs cur)
       =  > h es.at(i)
       =  > added
            ?  ?=(.add q)
               (eq 1 p.len)
            0
       ?  added
          =  > tgt here.weld(p)
          =  > kt (kooked [kook_root.snoc(rid)])
          =  > cd=[p2=path q2=writ] [tgt (writ/poke kt)]
          (_ i.inc cs.snoc(cd))
       (_ i.inc cs)
  +  serve_form
    ^  form
    def_form.set_take(http/serve_take)
  +  cfg
    '  The record for an HTTP driver node: the serving kook plus the
    '  responder id it installs on request nodes.
    \  rid=quip
    ^  myth
    =  t1  (kooked [['kook 'hserve]])
    t1.put(['serve] (pails/q rid))
  +  cfg_port
    '  A live driver config: serving kook, responder id, and the TCP
    '  port (the worker reads it at birth, so it must ride the make).
    \  rid=quip port=nat
    ^  myth
    =  t1  (http/cfg rid)
    t1.put(['port] (pd port))
  +  req
    '  An HTTP request as a namespace record: method, url and body
    '  ride as data pails, the parsed target as a pails/p, a z-care
    '  dep on the target so responders get its hydrated view, and —
    '  for live targets — a y-care dep on the target's /h/v version
    '  view.  No kook: the serving kook above installs one.
    \  m=nat u=nat bd=nat tgt=path
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['method] (pd m))
    =  t3  t2.put(['url] (pd u))
    =  t4  t3.put(['body] (pd bd))
    =  t5  t4.put(['vpath] (pails/p tgt))
    =  cw1  (crew/sing ['view] (dep .z tgt))
    =  > cw=crew
         ?  (is_h tgt)
            cw1
         ?  (eq 0 tgt.len)
            cw1
         =  > vp ['h 'v ($u tgt.len)]
         cw1.put(['ver] (dep .y vp.weld(tgt)))
    t5.put(crew_slot (cpail cw))
+  fetch
  '  The outbound-HTTP driver vocabulary: requests and their answers
  '  ride as records; the driver record's markers are the worker's
  '  notifications.
  +  take
    '  The driver inbox kook: when a request node appears underneath
    '  (an added direct kid in the gift), mark it fresh on the driver
    '  node itself — helm x-watches each /io name's own record, so
    '  the write IS the worker's notification.  A culled kid clears
    '  its marker (pokes cannot delete slots, so markers are
    '  overwritten to 0, never removed).
    \  b=bowl cur=myth g=axal[mode]
    ^  yell
    =  es  g.tap
    |  > i=nat 0  > acc=myth cur
    ?  (eq i es.len)
       (yell [] acc)
    =  > h es.at(i)
    =  > isadd
         ?  ?=(.add q)
            (eq 1 p.len)
         0
    =  > isdel
         ?  ?=(.del q)
            (eq 1 p.len)
         0
    ?  isadd
       (_ i.inc acc.put(['fresh p.at(0)] (pd 1)))
    ?  isdel
       (_ i.inc acc.put(['fresh p.at(0)] (pd 0)))
    (_ i.inc acc)
  +  form
    ^  form
    def_form.set_take(fetch/take)
  +  cfg
    '  The record for an outbound-HTTP driver node: just the fetch
    '  kook — requests carry their own config.
    ^  myth
    (kooked [['kook 'hfetch]])
  +  req
    '  An outbound fetch request as a namespace record: method, url,
    '  body (0 = none) and deadline (ms, required nonzero) ride as
    '  data pails.  Optional slots the driver honors: ['connect]
    '  ['redirects] ['maxbody], plus one ['hdr <name>] per request
    '  header.  The driver answers by poking ['res_done] ['res_ok]
    '  and the res_* payload slots onto the node — the requester's
    '  own kook (or a crew dep on the node) consumes them.
    \  m=nat u=nat bd=nat dl=nat
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['method] (pd m))
    =  t3  t2.put(['url] (pd u))
    =  t4  t3.put(['body] (pd bd))
    t4.put(['deadline] (pd dl))
  +  fresh
    '  The pending request kids marked on a driver record: keys
    '  ['fresh <kid>] whose value is 1.
    \  t=myth
    ^  path
    =  es  t.tap
    |  > i=nat 0  > acc=path []
    ?  (eq i es.len)
       acc
    =  > h es.at(i)
    =  > k h.key
    =  > hit
         ?  (eq 2 k.len)
            ?  (eq_iota k.at(0) 'fresh)
               ?  h.val
                > x=pails/n  x.n
               0
            0
         0
    ?  hit
       (_ i.inc acc.snoc(k.at(1)))
    (_ i.inc acc)
  +  hdrs
    '  Request headers from a record: one [name value] per
    '  ['hdr <name>] slot (names unique, order unspecified).
    \  t=myth
    ^  row[[n=nat v=nat]]
    =  es  t.tap
    |  > i=nat 0  > acc=row[[n=nat v=nat]] []
    ?  (eq i es.len)
       acc
    =  > h es.at(i)
    =  > k h.key
    =  > hit
         ?  (eq 2 k.len)
            (eq_iota k.at(0) 'hdr)
         0
    ?  hit
       =  > v
            ?  h.val
             > x=pails/n  x.n
            0
       (_ i.inc acc.snoc([(quip_val k.at(1)) v]))
    (_ i.inc acc)
  +  res_ok
    '  The response myth the driver pokes onto a request node when
    '  the transfer completed: the final status/url/headers/body plus
    '  the ['res_done] completion marker.
    \  status=nat u=nat hd=nat body=nat
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['res_done] (pd 1))
    =  t3  t2.put(['res_ok] (pd 1))
    =  t4  t3.put(['res_status] (pd status))
    =  t5  t4.put(['res_url] (pd u))
    =  t6  t5.put(['res_hdrs] (pd hd))
    t6.put(['res_body] (pd body))
  +  res_err
    '  The response myth for a failed fetch: the driver's error code
    '  (0 bad-url, 1 dns, 2 connect, 3 tls, 4 deadline, 5 redirects,
    '  6 too-large, 7 protocol).
    \  code=nat
    ^  myth
    =  t1  myth/new
    =  t2  t1.put(['res_done] (pd 1))
    =  t3  t2.put(['res_ok] (pd 0))
    t3.put(['res_err] (pd code))
+  dt
  '  The doctest driver's records.
  +  req
    '  A doctest request as a namespace record: the target's mirror
    '  path (an exact documented node, or a /boot prefix to sweep)
    '  rides as a pails/p.  The driver answers by poking ['res_done]
    '  ['passed] ['failed] onto this node and the ['dt] verdicts onto
    '  the targets themselves.
    \  tgt=path
    ^  myth
    =  t  myth/new
    t.put(['target] (pails/p tgt))
  +  cfg
    '  The record for a doctest driver node: the shared chore driver
    '  config, defaulting requests to the doctest family — requests
    '  carry their target, verdicts land on the documented nodes.
    ^  myth
    (chore/cfg 'doctest)
+  explorer
  '  The namespace explorer: the /ns node browser served over HTTP.
  +  css
    '  The explorer stylesheet.
    ^  nat
    "body{background:#101418;color:#cfd8dc;font-family:monospace;font-size:13px;margin:2em} a{color:#7fd4c1;text-decoration:none} h1{color:#f0b429;font-size:15px} h2{color:#f0b429;font-size:13px;margin-top:1.5em} .row{padding:4px 8px;border-bottom:1px solid #2a333b} .row:hover{background:#161c22} .key{color:#f0b429;margin-right:8px} .muted{color:#6b7680} pre{white-space:pre-wrap;margin:4px 0;color:#cfd8dc} .lore-head{color:#e8edf0;font-size:14px;margin:12px 0 2px} .lore-body{color:#8fa1ab;margin:2px 0 10px} .lore-line{padding:1px 0} .khead{margin-left:14px} .chip{padding:1px 7px;border-radius:9px;font-size:11px;margin-left:10px} .ok{background:#123f2a;color:#7fd4a1} .bad{background:#4a1520;color:#f08a9b} .mut{background:#242e36;color:#8fa1ab} .dtsrc{color:#cdd7dc}"
  +  url
    '  The explorer href for a path.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/ns"
    (weft/cat2 "/ns" (show_path p))
  +  forms
    '  The workspace forms on a /boot module page: evaluate an
    '  expression against the module's subject, or edit and save its
    '  source — both plain POSTs to the /chore bridge, answered as
    '  text by the build chore families.
    \  tgt=path src=nat
    ^  row[weft/node]
    =  modp  (show_path tgt.drop(1))
    =  evalf
         (weft/el "form" [(weft/att "method" "post") (weft/att "action" (weft/cat2 "/chore/eval" modp))]
           [(weft/el "input" [(weft/att "name" "expr") (weft/att "size" "80")] [])
            (weft/leaf "button" [] "eval")])
    =  savef
         (weft/el "form" [(weft/att "method" "post") (weft/att "action" (weft/cat2 "/chore/save" modp))]
           [(weft/el "textarea" [(weft/att "name" "src") (weft/att "rows" "24") (weft/att "cols" "100")] [(weft/tx src)])
            (weft/el "div" [] [(weft/leaf "button" [] "save & recompile")])])
    [(weft/leaf "h2" [] "workspace") evalf savef]
  +  case_count
    '  Read one decimal counter from a version-view myth.
    \  key=path t=myth
    ^  nat
    ?  (dig_parse t.txt_at(key))
     > (./some n=nat)  n
     > .none  0
  +  case_links
    '  Links for one target-local care history, cases 1 through n.
    \  cr=quip n=nat tgt=path
    ^  row[weft/node]
    |  > i=nat 1  > acc=row[weft/node] []
    ?  (gt i n)
       acc
    =  > hp ['h cr ($u i) ($u tgt.len)]
    =  > lnk (weft/leaf "a" [(weft/href (explorer/url hp.weld(tgt)))] (show_iota ($u i)))
    =  > a1 acc.snoc((weft/tx " "))
    (_ i.inc a1.snoc(lnk))
  +  dt_chip
    '  One doctest's verdict chip: pass/got from the verdict's
    '  results, greyed when the verdict's case is behind the node's
    '  current x case (curx as decimal text; 0 = unknown, no
    '  staleness call).
    \  v=dt_verdict curx=nat j=nat
    ^  weft/node
    =  > stale
         ?  (eq 0 curx)
            0
         ?  (eq curx (weft/show_nat v.case))
            0
         1
    ?  (ge j v.results.len)
       (weft/leaf "span" [(weft/cls "chip mut")] "no result")
    ?  stale
       (weft/leaf "span" [(weft/cls "chip mut")] (weft/cat2 "stale v" (weft/show_nat v.case)))
    =  > re v.results.at(j)
    ?  pass
       (weft/leaf "span" [(weft/cls "chip ok")] "pass")
    (weft/leaf "span" [(weft/cls "chip bad")] (weft/cat2 "got " got))
  +  dt_row1
    '  One rendered doctest row.
    \  src2=nat want2=nat chip=weft/node
    ^  weft/node
    (weft/el "div" [(weft/cls "row")]
      [(weft/tx "?=  ")
       (weft/leaf "span" [(weft/cls "dtsrc")] src2)
       (weft/tx "  ->  ")
       (weft/leaf "span" [(weft/cls "dtsrc")] want2)
       chip])
  +  dt_rows
    '  A lore's doctests with verdict chips.
    \  l=lore v=dt_verdict curx=nat
    ^  row[weft/node]
    |  > j=nat 0  > acc=row[weft/node] []
    ?  (ge j l.tests.len)
       acc
    =  > te l.tests.at(j)
    (_ j.inc acc.snoc((explorer/dt_row1 src want (explorer/dt_chip v curx j))))
  +  dt_rows_never
    '  A lore's doctests, never yet run.
    \  l=lore
    ^  row[weft/node]
    |  > j=nat 0  > acc=row[weft/node] []
    ?  (ge j l.tests.len)
       acc
    =  > te l.tests.at(j)
    (_ j.inc acc.snoc((explorer/dt_row1 src want (weft/leaf "span" [(weft/cls "chip mut")] "never run"))))
  +  page
    '  The node browser: breadcrumbs, the node's own lore (head,
    '  body, and doctests with verdict chips from the /dt kid), the
    '  record's slots (paths as links), kid links annotated with
    '  their lore heads — plus time travel: the node's version view
    '  with links into its history, and a live link back out of /h
    '  pages.
    \  tgt=path fat=axal[myth] ver=axal[myth]
    ^  nat
    =  > root (weft/leaf "a" [(weft/href "/ns")] "ns")
    =  > crumbs
         |  > i=nat 0  > acc=row[weft/node] [root]
         ?  (eq i tgt.len)
            acc
         =  > pre tgt.take(i.inc)
         =  > lnk (weft/leaf "a" [(weft/href (explorer/url pre))] (show_iota tgt.at(i)))
         =  > a1 acc.snoc((weft/tx " / "))
         (_ i.inc a1.snoc(lnk))
    =  > nav
         =  > hlnk (weft/leaf "a" [(weft/href "/ns/h") (weft/cls "muted")] "time travel")
         ?  (is_h tgt)
            ?  (lt tgt.len 3)
               [hlnk]
            =  > shift
                 ?  (eq_iota tgt.at(1) 'v)
                    3
                 4
            ?  (lt tgt.len shift)
               [hlnk]
            =  > live tgt.drop(shift)
            =  > llnk (weft/leaf "a" [(weft/href (explorer/url live))] "view live")
            [hlnk (weft/tx " | ") llnk]
         [hlnk]
    =  > curx
         ?  ver.fil
          > (./some vt=myth)  vt.txt_at(['x_data])
          > .none  0
    =  > docpane
         ?  fat.fil
          > .none  []
          > (./some t=myth)
            ?  t.get(['lore])
             > .none  []
             > (./some pl=pail)
               ?  pl
                > l=lore
                  =  > brows
                       |  > j=nat 1  > acc=row[weft/node] []
                       ?  (ge j l.body.len)
                          acc
                       (_ j.inc acc.snoc((weft/leaf "div" [(weft/cls "lore-line")] l.body.at(j))))
                  =  > trows
                       ?  fat.dip(['dt]).fil
                        > (./some dtm=myth)
                          ?  dtm.get(['dt])
                           > (./some pl2=pail)
                             ?  pl2
                              > v9=dt_verdict  (explorer/dt_rows l v9 curx)
                             (explorer/dt_rows_never l)
                           > .none  (explorer/dt_rows_never l)
                        > .none  (explorer/dt_rows_never l)
                  =  > topr
                       [(weft/el "div" [(weft/cls "lore-head")] [(weft/tx l.head)])
                        (weft/el "div" [(weft/cls "lore-body")] brows)]
                  topr.weld(trows)
               []
    =  > slots
         ?  fat.fil
          > .none  [(weft/leaf "div" [(weft/cls "muted")] "no record at this node")]
          > (./some t=myth)
            =  > es t.tap
            ?  (eq 0 es.len)
               [(weft/leaf "div" [(weft/cls "muted")] "empty record")]
            |  > i=nat 0  > acc=row[weft/node] []
            ?  (eq i es.len)
               acc
            =  > h es.at(i)
            ?  (eq_pith h.key ['lore])
               (_ i.inc acc)
            =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
            =  > vn
                 ?  h.val
                  > t6=pails/t
                    ?  (eq_pith h.key ['module])
                       (weft/leaf "a" [(weft/href (weft/cat2 "/ns/boot/" t6.t))] t6.t)
                    (weft/leaf "pre" [] t6.t)
                  > p9=pails/p  (weft/leaf "a" [(weft/href (explorer/url p9.p))] (show_path p9.p))
                  > pr9=pails/ps
                    =  > rs pr9.ps
                    =  > lnks
                         |  > j=nat 0  > acc=row[weft/node] []
                         ?  (eq j rs.len)
                            acc
                         =  > lk (weft/leaf "a" [(weft/href (explorer/url rs.at(j)))] (show_path rs.at(j)))
                         =  > a2 acc.snoc((weft/tx "  "))
                         (_ j.inc a2.snoc(lk))
                    (weft/el "span" [] lnks)
                 (weft/tx (show_pail h.val))
            (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [kn vn])))
    =  > kids
         =  > ks fat.kid_tap
         ?  (eq 0 ks.len)
            [(weft/leaf "div" [(weft/cls "muted")] "no kids")]
         |  > i=nat 0  > acc=row[weft/node] []
         ?  (eq i ks.len)
            acc
         =  > h ks.at(i)
         =  > kp tgt.snoc(h.key)
         =  > lnk (weft/leaf "a" [(weft/href (explorer/url kp))] (show_iota h.key))
         =  > khead
              ?  fat.kid_get(h.key)
               > (./some ka=axal[myth])
                 ?  ka.fil
                  > (./some kt=myth)
                    ?  kt.get(['lore])
                     > (./some kpl=pail)
                       ?  kpl
                        > kl=lore  (weft/leaf "span" [(weft/cls "muted khead")] kl.head)
                       (weft/tx "")
                     > .none  (weft/tx "")
                  > .none  (weft/tx "")
               > .none  (weft/tx "")
         (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [lnk khead])))
    =  > vpane
         ?  ver.fil
          > .none  []
          > (./some vt=myth)
            =  > es vt.tap
            =  > vrows
                 |  > i=nat 0  > acc=row[weft/node] []
                 ?  (eq i es.len)
                    acc
                 =  > h es.at(i)
                 =  > kn (weft/leaf "span" [(weft/cls "key")] (show_path h.key))
                 =  > vn (weft/tx (show_pail h.val))
                 (_ i.inc acc.snoc((weft/el "div" [(weft/cls "row")] [kn vn])))
            =  > xc (explorer/case_count ['x_data] vt)
            =  > yc (explorer/case_count ['y_data] vt)
            =  > zc (explorer/case_count ['z_data] vt)
            =  > xr (explorer/case_links 'x xc tgt)
            =  > yr (explorer/case_links 'y yc tgt)
            =  > zr (explorer/case_links 'z zc tgt)
            =  > vh [(weft/leaf "h2" [] "version")]
            =  > v1 vh.weld(vrows)
            =  > hh
                 [(weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "x cases") (weft/el "span" [] xr)])
                  (weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "y cases") (weft/el "span" [] yr)])
                  (weft/el "div" [(weft/cls "row")] [(weft/leaf "span" [(weft/cls "key")] "z cases") (weft/el "span" [] zr)])]
            v1.weld(hh)
    =  > wpane
         '  a /boot module node (source, no entry kind) gets the
         '  workspace forms
         ?  fat.fil
          > .none  []
          > (./some tw=myth)
            =  > srct (myth/txt_at ['src] tw)
            ?  (eq 0 srct)
               []
            ?  (myth/has_at ['kind] tw)
               []
            ?  (eq 0 tgt.len)
               []
            ?  (eq_iota tgt.at(0) 'boot)
               (explorer/forms tgt srct)
            []
    =  > head [(weft/el "h1" [] crumbs) (weft/el "div" [(weft/cls "muted")] nav)]
    =  > b0 head.weld(docpane)
    =  > b0r b0.snoc((weft/leaf "h2" [] "record"))
    =  > b1 b0r.weld(slots)
    =  > b2 b1.snoc((weft/leaf "h2" [] "kids"))
    =  > b3 b2.weld(kids)
    =  > b4 b3.weld(wpane)
    =  > body b4.weld(vpane)
    (weft/page (show_path tgt) explorer/css body)
  +  talk
    '  The namespace explorer responder: render the request's
    '  hydrated target view as the node browser page.
    \  b=bowl cur=myth add=myth
    ^  yell
    =  > o cur.meld(add)
    =  > tgt=path
         ?  o.get(['vpath])
          > (./some pl=pail)
            ?  pl
             > x=pails/p  x.p
            []
          > .none  []
    =  > cw b.crew
    =  > fat cw.gut(['view] (axal/new[myth] .none))
    =  > ver cw.gut(['ver] (axal/new[myth] .none))
    =  > html (explorer/page tgt fat ver)
    =  > o1 o.put(['res_status] (pd 200))
    =  > o2 o1.put(['res_body] (pd html))
    =  > o3 o2.put(['res_ctype] (pd "text/html; charset=utf-8"))
    (yell [] o3)
  +  form
    ^  form
    def_form.set_talk(explorer/talk)
