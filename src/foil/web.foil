-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  weft [order=50]
-  tyshow [order=55]
-  pact [order=60]
-  fetch [order=71]
-  http [order=72]
- show
- web_ui
- web_style
- web_lore
- web_grove
- debugger_contract
- helm
'  Fragments, explorer composition, face dispatch, and the zoo.
'  Shared rendering lives in show and the web_* modules.
+  frag
  '  The fragment vocabulary: components are overlay ctors whose
  '  derived records carry markup (a weft/node at ['html]), applied
  '  through /o and served bare over the /frag route.  Containers
  '  mount them as w-get elements the /w.js runtime keeps fresh
  '  (weft/runtime documents the attribute set).

  +  url
    '  The fragment URL applying the component node at op to the
    '  data at dp: /frag/1/olen/...op/dlen/...dp.  The function pin
    '  is hardcoded to x case 1 per the write-once component
    '  convention (pact/weft_card): components mount once and never
    '  change in place, so their first mint is their only mint.
    \  op=path dp=path
    ^  nat
    | weft/cat ["/frag/1/" (weft/show_nat op.len) (show/path op) "/" (weft/show_nat dp.len) (show/path dp)]

  +  html
    '  A component result: markup at ['html].  The node rides the
    '  pail as its branded member row (sums do not inhabit pails),
    '  so a fragment's root is always an element.
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  myth
    (myth/new).put(['html] (weft/node/el tag as kids))

  +  mount
    '  A fragment mount: an empty element the runtime fills on page
    '  load and re-fetches every `every` seconds, swapping only when
    '  the markup actually changed — the server-side first paint is
    '  deliberately absent so component output is never duplicated
    '  into container code.
    \  id=nat op=path dp=path every=nat
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'div
          'id id
          'w-get (frag/url op dp)
          'w-trigger (weft/cat ["every " (weft/show_nat every) "s"])
    markup.at(0)

  +  edit
    '  w-edit: the text run edits in place, committing to the slot at
    '  the enclosing mount's data path plus rel.  rel rides as a real
    '  path — the "." spelling for the empty rel is derived here, so
    '  hand-spelled relative cords (and their silent-miss typos)
    '  never appear at call sites.
    \  rel=path slot=nat
    ^  weft/item
    =  spell
         ?  (eq 0 rel.len)
            "."
         =  parts
              %  idx=nat 0  out=row[nat] []
              ?  (eq idx rel.len)
                 out
              | _ idx.inc out.snoc((show/iota rel.at(idx)))
         | weft/join "/" parts
    | weft/item/at (weft/att "w-edit" (weft/cat [spell " " slot]))

  +  script
    '  The runtime include for container pages.
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'script
          'src "/w.js"
    markup.at(0)

  +  ver_nat
    '  A decimal counter off the request's ['ver] crew view (the
    '  target's /h/v record): ['top] is the sovereign's current
    '  epoch, ['first] the target's first — the scrubber's bounds.
    '  0 when the crew carries no version view.
    \  =bowl slot=path
    ^  nat
    =  vv  bowl.crew.gut(['ver] (axal/new[myth] .none))
    ?  vv.fil
     > .none  0
     > (./some t)
       ?  (dig_parse (myth/txt_at slot t))
        > (./some n)  n
        > .none  0

  +  scrubber
    '  The omni-scrubber: one slider that pins every fragment on the
    '  page to a shared sovereign epoch — drag left and the whole
    '  page rewinds through committed history, the right edge
    '  returns to now.  Bounds come from the request's ['ver] crew
    '  view (frag/ver_nat ['first] and ['top]); the /w.js runtime
    '  rewrites every mount's fetch through /h's epoch spelling
    '  while pinned, and polls idle because history is constant.
    \  first=nat top=nat
    ^  weft/node
    = lo
        ? first first
        1
      markup
        ~ weft/build
        ~| 'div.wscrub
          ~# 'input[type=range]
            'min (weft/show_nat lo)
            'max (weft/show_nat top)
            'value (weft/show_nat top)
            'w-scrub "1"
          ~. 'span.wscrub-lab "now"
    markup.at(0)

  +  shell_css
    '  The generic datum shell's minimal chrome.
    ^  nat
    "body{margin:1.5rem;font-family:system-ui,sans-serif} .wscrub{margin-bottom:1rem}"

  +  shell
    '  The generic datum-face page: a title, the omni-scrubber for
    '  live targets, and one EMPTY mount the /w.js runtime fills
    '  through /frag — mounts are deliberately empty, so the ctor's
    '  output is never duplicated server-side, first paint arrives
    '  via the runtime's immediate fetch, and scrubbing rides the
    '  runtime's /h pinurl rewriting unchanged.
    \  =bowl out=myth tgt=path ctor=path
    ^  yell
    =  first  (frag/ver_nat bowl ['first])
       top    (frag/ver_nat bowl ['top])
       scrub
         ^  row[weft/node]
         ?  top
            [(frag/scrubber first top)]
         []
       body  scrub.weld([(frag/mount "shell" ctor tgt 2) frag/script])
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (weft/page (show/path tgt) frag/shell_css body)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

  +  as_node
    '  A pail as a weft/node, when it holds one: node values ride
    '  pails as their branded member rows (the ['html] slot of a
    '  component's derived record), so consumers rebuild the sum.
    '  Lives here rather than in weft — weft is import-free and
    '  knows neither pail nor maybe.
    \  held=pail
    ^  maybe[weft/node]
    ?  held
     > t=weft/node/tx   (./some (./tx t.s))
     > r=weft/node/raw  (./some (./raw r.s))
     > e=weft/node/el   (./some (./el e.tag e.as e.kids))
    .none

  +  talk
    '  The fragment responder: the hydrated derived record at the /o
    '  target, its ['html] node rendered bare — no shell, no chrome.
    '  Anything short of markup is a 404 with a terse reason.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ans
         ^  row[nat]
         ?  view.fil
          > .none  [404 "no fragment at this path"]
          > (./some t)
            ?  t.get(['html])
             > .none  [404 "no html slot"]
             > (./some held)
               ?  (frag/as_node held)
                > .none  [404 "html slot is not markup"]
                > (./some nd)  [200 (weft/render nd)]
       done
         .  out
            put(['res_status] (pd ans.at(0)))
            put(['res_body] (pd ans.at(1)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done
+  explorer
  '  The namespace explorer: the /ns node browser served over HTTP.
  '  Shared helper aliases preserve the existing explorer API;
  '  new callers should use web_ui, web_style, and web_lore.

  +  css
    web_style/css

  +  url
    '  The explorer href for a path.
    \  p=path
    ^  nat
    ?  (eq 0 p.len)
       "/ns"
    | weft/cat2 "/ns" (show/path p)

  +  rows
    web_ui/rows

  +  badge
    web_ui/badge

  +  card
    web_ui/card

  +  table
    web_ui/table

  +  js
    '  The explorer's page script: tree items are not anchors — the
    '  design system fires selection events instead — so selection
    '  navigates to the item's path under /ns.  Single-quote only:
    '  cord literals cannot hold a double-quote byte.
    ^  nat
    "document.addEventListener('ui-tree-item-select',function(e){var t=e.target;var p=t&&t.getAttribute?t.getAttribute('path'):null;if(p){location.href='/ns'+p}});"

  +  act
    '  Delete a live node through the HTTP foot's cull route.
    \  tgt=path
    ^  weft/node
    = markup
        ~ weft/build
        ~# 'form.wf[method=post]
          'action (weft/cat2 "/vine" (show/path tgt))
          ~| 'input[type=hidden][name=verb][value=cull]
          ~. 'ui-button[type=submit][tone=critical][size=small] "delete node"
    markup.at(0)

  +  ops_of
    '  The op vocabulary in scope at a target: every op card riding
    '  an ancestor's /op registry, shallowest first — read off the
    '  request's ['ops n] crew views (y-care on each ancestor's /op
    '  node, so the cards' records hydrate; a missing registry is an
    '  empty view and costs nothing).
    \  =bowl tgt=path
    ^  row[[p=path o=op]]
    %  n=nat 1  out=row[[p=path o=op]] []
    ?  (gt n tgt.len)
       out
    =  ov  bowl.crew.gut(['ops ($u n)] (axal/new[myth] .none))
    =  entries  ov.kid_tap
    =  out2
         %  j=nat 0  acc=row[[p=path o=op]] out
         ^  row[[p=path o=op]]
         ?  (ge j entries.len)
            acc
         =  kid  entries.at(j)
         ?>  (./some kaxal) ov.kid_get(kid.key)
             | _ j.inc acc
         ?>  (./some ktale) kaxal.fil
             | _ j.inc acc
         ?>  (./some held) ktale.get(['sys 'op])
             | _ j.inc acc
         =  rel=path  ['op kid.key]
         ?   held
          >  o=op
             | _ j.inc acc.snoc([tgt.take(n).weld(rel) o])
         | _ j.inc acc
    | _ n.inc out2

  +  op_form
    '  One op as an invokable form: hidden op path, a text input per
    '  declared input slot (the ['when] slot is skipped — the /op
    '  route stamps it with the host clock), the type spelling as
    '  the placeholder, the op's name on the submit.  POSTs to
    '  /op/<tgt> — a warp of this op at this node.
    \  tgt=path e=[p=path o=op]
    ^  weft/node
    = [p o] e
      markup
        ~ weft/build
        ~| 'div.opform
          ? o.lede
            ~. 'div.muted o.lede
          ~# 'form
            'method "post"
            'action (weft/cat2 "/op" (show/path tgt))
            'class "wf"
            % field o.inputs
              = [slot ty] field
              ? !(eq_pith slot ['when])
                = nm (weft/join "/" slot.map(show/iota))
                ~# 'ui-field
                  'label nm
                  ~# 'ui-input[slot=control][touch-target]
                    'name nm
                    'placeholder ty
            ~# 'input
              'type "hidden"
              'name "op"
              'value (show/path p)
            ~# 'ui-button[type=submit][size=small]
              'variant "secondary"
              ~. (show/iota o.name)
    markup.at(0)

  +  case_count
    '  Read one decimal counter from a version-view myth.
    \  key=path tale=myth
    ^  nat
    ?>  (./some n) (dig_parse tale.txt_at(key))
       0
    n

  +  case_links
    '  Links for one target-local care history, cases 1 through n —
    '  a compact scrubber with the current case highlighted.
    \  care=iota n=nat tgt=path
    ^  row[weft/node]
    %  idx=nat 1  out=row[weft/node] []
    ?  (gt idx n)
       out
    =  hist=path  ['h care ($u idx) ($u tgt.len)]
       cl
         ?  (eq idx n)
            "case cur"
         "case"
       link
         = markup
             ~ weft/build
             ~# 'a
               'href (explorer/url hist.weld(tgt))
               'class cl
               ~. (show/iota ($u idx))
         markup.at(0)
    | _ idx.inc out.snoc((weft/tx " ")).snoc(link)

  +  text_nodes
    '  Linked module text, folded long text, or a plain escaped pre.
    \ key=path text=nat
    ^ row[weft/node]
    ? (eq_pith key ['module])
      ~ weft/build
      ~# 'a
        'href (weft/cat2 "/ns/boot/" text)
        ~. text
    ? (gt (show/lines text) 15)
      ~ weft/build
      ~| 'details
        ~. 'summary (weft/cat2 (weft/show_nat (show/lines text)) " lines")
        ~. 'pre text
    ~ weft/build
    ~. 'pre text

  +  lore_lines
    web_lore/lore_lines

  +  slot_val
    '  One slot value as HTML: linked paths and modules, long texts
    '  folded behind details, crew and kook structure, and the
    '  reflection walker for the open remainder.
    \  key=path held=pail
    ^  weft/node
    ? (eq_pith key grove_templates/slot)
      = node
          ~ weft/build
          ~. 'span.muted "reusable Grove template"
      node.at(0)
    ? (eq_pith key ['sys 'grove 'module])
       = module
           ~ weft/build
           ~. 'span.muted "compiled Grove module"
       module.at(0)
    = markup
        ~ weft/build
        ? held
         > t=pails/t
           (explorer/text_nodes key t.t)
         > d=pails/ty
           ~. 'pre.tysig (tyshow/pretty d.t)
         > p=pails/p
           ~# 'a
             'href (explorer/url p.p)
             ~. (show/path p.p)
         > ps=pails/ps
           ~| 'span
             % p ps.ps
               ~. "  "
               ~# 'a
                 'href (explorer/url p)
                 ~. (show/path p)
         > c=cpail
           ~| 'div
             % e c.crew.tap
               = cn
                   ? e.val.c
                    > .x "x"
                    > .y "y"
                    > .z "z"
               ~| 'div
                 ~# 'span
                   'class (weft/cat2 "care care-" cn)
                   ~. cn
                 ~# 'a
                   'href (explorer/url e.val.p)
                   ~. (show/path e.val.p)
                 ~. 'span.muted.khead (show/path e.key)
         > k=kook
           ~| 'span
             % p k.refs
               ~. "  "
               ~# 'a
                 'href (explorer/url p)
                 ~. (show/path p)
        | ~. 'pre.val (show/pail held)
    markup.at(0)

  +  dt_chip
    web_lore/dt_chip

  +  dt_row1
    web_lore/dt_row1

  +  dt_rows
    web_lore/dt_rows

  +  dt_rows_never
    web_lore/dt_rows_never

  +  locator
    '  Mash owns breadcrumb overflow and ancestor links.
    \  tgt=path
    ^  row[weft/node]
    = hlnk | weft/lnk "/ns/h" "time travel"
    =  nav
         '  =  links
         '       ~ weft/build
         '       ~. 'a.muted[href=/ns/h] "time travel"
         '     hlnk links.at(0)
         ?  (is_h tgt)
            ?  (lt tgt.len 3)
               [hlnk]
            =  shift
                 ?  (eq_iota tgt.at(1) 'v)
                    3
                 4
            ?  (lt tgt.len shift)
               [hlnk]
            =  live  tgt.drop(shift)
               llnk  (weft/lnk (explorer/url live) "view live")
            [hlnk (weft/tx " | ") llnk]
         []
    ~ weft/build
    ~| 'div.locbar[slot=locator]
      ~# 'ui-path[variant=breadcrumb][aria-label=Namespace]
        'path (explorer/url tgt)
      ~| 'div.muted
        nav

  +  docs
    \  view=axal[myth] ver=axal[myth]
    ^  row[weft/node]
    =  curx
         ?  ver.fil
          > (./some tale)  tale.txt_at(['x_data])
          > .none  0
    =  doccards
         ?  view.fil
          > .none  []
          > (./some tale)
            ?  tale.get(bond/help)
             > .none  []
             > (./some held)
               ?  held
                > doc=lore
                  =  bodyrows
                       ' Hand-authored lore need not duplicate the head in
                       ' body[0]. Preserve that first paragraph when distinct.
                       % idx=nat 0 out=row[weft/node] []
                       ? (ge idx doc.body.len) out
                       = line doc.body.at(idx)
                       ? (? (eq idx 0) (eq line doc.head) .false)
                         | _ idx.inc out
                       = nodes
                           ~ weft/build
                           ~. 'div.lore-line line
                       | _ idx.inc out.weld(nodes)
                     bodynode
                       ?  (gt bodyrows.len 6)
                          = markup
                              ~ weft/build
                              ~| 'div
                                bodyrows.take(6)
                                ~| 'details
                                  ~. 'summary "More documentation"
                                  ~| 'div
                                    bodyrows.drop(6)
                          markup.at(0)
                       = markup
                           ~ weft/build
                           ~| 'div
                             bodyrows
                       markup.at(0)
                     testrows
                       ?  view.dip(['dt]).fil
                        > (./some dtale)
                          ?  dtale.get(['dt])
                           > (./some held2)
                             ?  held2
                              > verdict=doctest/verdict  (web_lore/dt_rows doc verdict curx)
                             | web_lore/dt_rows_never doc
                           > .none  (web_lore/dt_rows_never doc)
                        > .none  (web_lore/dt_rows_never doc)
                     kbase
                       ~ weft/build
                       ~| 'div.lore-body
                         [bodynode]
                  [(web_ui/card doc.head kbase.weld(testrows))]
                > (pails/t text)
                  ? (eq text 0) []
                  = lines
                      ~ weft/build
                      ~| 'div.lore-body
                        ~. 'div.lore-line text
                  [(web_ui/card (myth/txt_at bond/lede tale) lines)]
               []
    doccards

  +  slots
    \  view=axal[myth]
    ^  [row[weft/node] row[weft/node]]
    =  slotrows
         '  [data-rows sys-rows]: each slot as a ui-table-row; /sys
         '  slots split out into the inspector's own table.
         ?  view.fil
          > .none  [[] []]
          > (./some tale)
            =  entries  tale.tap
            %  idx=nat 0  dat=row[weft/node] []  sys=row[weft/node] []
            ?  (eq idx entries.len)
               [dat sys]
            =  slot  entries.at(idx)
            ?  (eq_pith slot.key bond/help)
               | _ idx.inc dat sys
            ?  (eq_pith slot.key bond/lede)
               | _ idx.inc dat sys
            =  rw
                 = markup
                     ~ weft/build
                     ~| 'ui-table-row
                       ~# 'ui-table-cell
                         'class "key"
                         ~. (show/path slot.key)
                       ~# 'ui-table-cell
                         'class "val"
                         [(explorer/slot_val slot.key slot.val)]
                 markup.at(0)
            ?  (eq 0 slot.key.len)
               | _ idx.inc dat.snoc(rw) sys
            ?  (eq_iota slot.key.at(0) 'sys)
               | _ idx.inc dat sys.snoc(rw)
            | _ idx.inc dat.snoc(rw) sys
    slotrows

  +  record
    \  tgt=path view=axal[myth] drows=row[weft/node]
    ^  row[weft/node]
    =  failed
         '  a fail tombstone ([status]="failed" — broken apps and
         '  modules are visible namespace citizens) badges its record
         ?  view.fil
          > .none  .false
          > (./some ft)
            ?  ft.get(['status])
             > (./some sp)
               ?  sp
                > t=pails/t  (eq t.t "failed")
                .false
             > .none  .false
    =  recbody
         ?  view.fil
          > .none
            ~ weft/build
            ~. 'div.muted "no record at this node"
          > (./some tale2)
            ?  (eq 0 drows.len)
               ~ weft/build
               ~# 'div
                 'class "muted"
                 ~. "empty record"
            [(web_ui/table "record" drows)]
    =  recmeta
         ^  row[weft/node]
         ?  failed
            ~ weft/build
            ~# 'ui-badge
              'slot "meta"
              'tone "critical"
              'size "small"
              ~. "failed"
         []
    =  reccard
         ~ weft/build
         ~| 'ui-card
           ~# 'span
             'slot "title"
             ~. "record"
           recmeta
           ~# 'div
             'slot "content"
             recbody
           ? (explorer/writable tgt)
             ~| 'div[slot=footer]
               [(explorer/act tgt)]
    reccard

  +  kids
    \  tgt=path view=axal[myth]
    ^  row[weft/node]
    =  kidtree
         =  entries  view.kid_tap
         ?  (eq 0 entries.len)
            ~ weft/build
            ~# 'div
              'class "muted"
              ~. "no kids"
         =  items
              %  idx=nat 0  out=row[weft/node] []
              ?  (eq idx entries.len)
                 out
              =  kid   entries.at(idx)
                 meta
                   ^  row[weft/node]
                   ?  view.kid_get(kid.key)
                    > (./some kaxal)
                      ?  kaxal.fil
                       > (./some ktale)
                         ?  ktale.get(bond/lede)
                          > (./some kheld)
                            ?  kheld
                             > kt=pails/t
                               ~ weft/build
                               ~# 'span
                                 'slot "meta"
                                 'class "muted"
                                 ~. kt.t
                            []
                          > .none  []
                       > .none  []
                    > .none  []
                 item
                   = markup
                       ~ weft/build
                       ~# 'ui-tree-item[level=1]
                         'path (show/path tgt.snoc(kid.key))
                         'title (show/iota kid.key)
                         meta
                   markup.at(0)
              | _ idx.inc out.snoc(item)
         ~ weft/build
         ~# 'ui-tree
           'label "kids"
           items
    kidtree

  +  writable
    '  Namespace overlays are read-only, including typed ops.
    \  tgt=path
    ^  bool
    ? (is_h tgt) .false
    ? (is_o tgt) .false
    ? (is_xv tgt) .false
    .true

  +  actions
    \  tgt=path ops=row[[p=path o=op]]
    ^  row[weft/node]
    ? !(explorer/writable tgt)
       []
    =  opspane
         '  the op vocabulary in scope, each as a form (empty for
         '  derived targets — their requests carry no ['ops] deps)
         ^  row[weft/node]
         ?  (eq 0 ops.len)
            []
         =  forms
              %  idx=nat 0  out=row[weft/node] []
              ?  (ge idx ops.len)
                 out
              | _ idx.inc out.snoc((explorer/op_form tgt ops.at(idx)))
         [(web_ui/card "ops" forms)]
    opspane

  +  inspector
    \  tgt=path ver=axal[myth] srows=row[weft/node]
    ^  weft/node
    =  vrows
         ^  row[weft/node]
         ?  ver.fil
          > .none  []
          > (./some tale)
            =  vcells
                 =  entries  tale.tap
                 %  idx=nat 0  out=row[weft/node] []
                 ?  (eq idx entries.len)
                    out
                 =  slot  entries.at(idx)
                    rw
                      = markup
                          ~ weft/build
                          ~| 'ui-table-row
                            ~# 'ui-table-cell
                              'class "key"
                              ~. (show/path slot.key)
                            ~# 'ui-table-cell
                              'class "val"
                              ~. (show/pail slot.val)
                      markup.at(0)
                 | _ idx.inc out.snoc(rw)
               caserow
                 \  label=nat links=row[weft/node]
                 = markup
                     ~ weft/build
                     ~| 'ui-table-row
                       ~# 'ui-table-cell
                         'class "key"
                         ~. label
                       ~# 'ui-table-cell
                         'class "val"
                         links
                 markup.at(0)
               hist
                 [(caserow "x cases" (explorer/case_links 'x (explorer/case_count ['x_data] tale) tgt))
                  (caserow "y cases" (explorer/case_links 'y (explorer/case_count ['y_data] tale) tgt))
                  (caserow "z cases" (explorer/case_links 'z (explorer/case_count ['z_data] tale) tgt))]
            ~ weft/build
            ~|
              ~. 'h2 "version"
              [(web_ui/table "version" vcells.weld(hist))]
    =  sysrows
         ^  row[weft/node]
         ?  (eq 0 srows.len)
            []
         ~ weft/build
         ~|
           ~. 'h2 "system"
           [(web_ui/table "system" srows)]
    =  insp
         =  ikids  vrows.weld(sysrows)
         =  ikids2
              ?  (eq 0 ikids.len)
                 ~ weft/build
                 ~# 'div
                   'class "muted"
                   ~. "no state"
              ikids
         = markup
             ~ weft/build
             ~# 'div
               'slot "inspector"
               'class "tinsp"
               ikids2
         markup.at(0)
    insp
  +  sidebar_new
    '  The demo.html sidebar, with its sample content and hooks.
    ^ row[weft/node]
    ~ weft/build
    ~# 'ui-sidebar
      'data-mash-size "default"
      'mobile-breakpoint "520"
      'persist "false"
      explorer/sidebar_new/header
      explorer/sidebar_new/navigation
      explorer/sidebar_new/footer
      ~# 'strong[slot=content-header]
        'data-title ""
        ~. "Release checklist"
      explorer/sidebar_new/content

    +  workspace
      ^ row[weft/node]
      ~ weft/build
      ~| 'ui-menu
        ~# 'ui-button.sidebar-account[slot=trigger]
          'dropdown-caret ""
          ~# 'ui-icon[slot=prefix]
            'name "object.folder"
            'label ""
          ~# 'span
            'data-workspace-name ""
            ~. "Acme workspace"
        ~. 'ui-menu-item[value=Studio] "Studio"
        ~. 'ui-menu-item[value=Research] "Research"
        ~. 'ui-menu-item[value=Personal] "Personal"

    +  header
      ^ row[weft/node]
      ~ weft/build
      ~| 'div.sidebar-header[slot=header]
        ~| 'div.sidebar-horizontal
          explorer/sidebar_new/workspace
          ~# 'ui-button[size=compact]
            'data-new ""
            'aria-label "New document"
            ~# 'ui-icon
              'name "action.add"
              'label ""
        ~# 'ui-input
          'data-search ""
          'label "Search navigation"
          'placeholder "Search documents…"

    +  document
      \ key=nat title=nat chosen=bool
      ^ row[weft/node]
      = base=row[weft/att]
         [
          (weft/att "slot" "children")
          (weft/att "kind" "file")
          (weft/att "title" title)
          (weft/att "value" key)
         ]
      = mark=row[weft/att]
          ? chosen
            [(weft/att "selected" "") (weft/att "current" "")]
          []
      = icon
          ~ weft/build
          ~# 'ui-icon[slot=icon]
            'name "object.document"
            'label ""
      = node | weft/el "ui-tree-item" base.weld(mark) icon
      [node]

    +  documents
      ^ row[weft/node]
      = titles
          ["Release checklist" "Navigation study"
           "Team notes" "Interaction details"
           "A longer document title that should remain readable"
           "Accessibility review"]
      ~ weft/build
      ~# 'ui-tree-item[kind=folder]
        'title "Workspace"
        'value "workspace"
        'expanded ""
        % idx (row/range 0 titles.len)
          = key | cord/cat "doc-" (weft/show_nat idx)
          | explorer/sidebar_new/document key
            titles.at(idx) (eq idx 0)

    +  shared
      ^ row[weft/node]
      ~ weft/build
      ~# 'ui-tree-item[kind=folder]
        'title "Shared"
        'value "shared"
        ~# 'ui-tree-item[slot=children][kind=folder]
          'title "Design system"
          'value "design"
          ~# 'ui-tree-item[slot=children][kind=file]
            'title "Tokens and materials"
            'value "tokens"
          ~# 'ui-tree-item[slot=children][kind=file]
            'title "Component inventory"
            'value "inventory"
        ~# 'ui-tree-item[slot=children][kind=file]
          'title "Planning notes"
          'value "planning"

    +  navigation
      ^ row[weft/node]
      ~ weft/build
      ~# 'nav.mash-sidebar-nav[slot=navigation]
        'aria-label "Workspace documents"
        ~# 'ui-tree
          'label "Workspace documents"
          explorer/sidebar_new/documents
          explorer/sidebar_new/shared
        ~# 'p.sidebar-empty
          'hidden ""
          ~. "No matching documents."

    +  account
      ^ row[weft/node]
      ~ weft/build
      ~| 'ui-menu
        ~# 'ui-button.sidebar-account[slot=trigger]
          'variant "ghost"
          'dropdown-caret ""
          ~# 'ui-avatar[slot=prefix][size=small]
            'alt "Alex Morgan"
          ~. "Alex Morgan"
        ~. 'ui-menu-item[value=profile] "Your profile"
        ~. 'ui-menu-item[value=preferences] "Preferences"

    +  footer
      ^ row[weft/node]
      ~ weft/build
      ~| 'div.sidebar-footer[slot=footer]
        ~# 'ui-alert[tone=neutral]
          'closable ""
          ~. 'strong[slot=title] "A little more room"
          ~. "Resize the edge to find your preferred width."
        ~| 'div.sidebar-horizontal
          explorer/sidebar_new/account
          ~# 'ui-button[size=compact][variant=ghost]
            'data-settings ""
            'aria-label "Workspace settings"
            ~# 'ui-icon
              'name "action.settings"
              'label ""

    +  preferences
      ^ row[weft/node]
      ~ weft/build
      ~# 'section.mash-stack
        'data-preferences ""
        'hidden ""
        ~. 'strong "Workspace preferences"
        ~# 'ui-input
          'label "Display name"
          'value "Alex Morgan"
        ~# 'ui-switch
          'label "Activity notifications"
          'checked ""

    +  editor
      ^ row[weft/node]
      = notes
          | cord/cat_all
            ["Keep the first release focused." 10 10
             "Make navigation clear, preserve drafts, "
             "and give every control room to breathe."]
      ~ weft/build
      ~# 'ui-input
        'data-document-title ""
        'label "Document title"
        'value "Release checklist"
      ~# 'ui-textarea
        'data-editor ""
        'label "Document notes"
        'value notes

    +  content
      ^ row[weft/node]
      ~ weft/build
      ~| 'div.sidebar-page
        ~| 'div.sidebar-row
          ~. 'span.sidebar-small "WORKSPACE / NOTES"
          ~. 'span.sidebar-small "Private draft"
        explorer/sidebar_new/editor
        explorer/sidebar_new/preferences
        ~# 'output
          'data-result ""
          'aria-live "polite"
          ~. "Your draft stays here when the sidebar closes."

  +  page_new
    \  tgt=path view=axal[myth] ver=axal[myth]
       ops=row[[p=path o=op]]
    ^ nat
    | weft/page (show/path tgt) web_style/css
      explorer/sidebar_new

  +  page
    '  Compose the namespace view into Mash's workspace regions.
    \  tgt=path view=axal[myth] ver=axal[myth]
       ops=row[[p=path o=op]]
    ^  nat
    = [data syst] (explorer/slots view)
    =   body
         ~ weft/build
         ~|
           ~| 'sh-triptych
             ~| 'div.tside[slot=sidebar]
               ~. 'h2 "kids"
               | explorer/kids tgt view
             ~| 'nav.tside.navcol[slot=navigate]
               [(weft/lnk "/ns" "namespace")]
               [(weft/lnk "/weft" "zoo")]
               [(weft/lnk "/ns/gov" "Groves")]
               [(weft/lnk "/ns/h" "time travel")]
             | explorer/locator tgt
             ~| 'div.tmain[slot=content]
               | explorer/docs view ver
               | web_grove/preview tgt view ver
               | explorer/record tgt view data
               | explorer/actions tgt ops
             [(explorer/inspector tgt ver syst)]
           ~| 'script
             [(weft/raw explorer/js)]
    | weft/page (show/path tgt) web_style/css body
  +  talk
    '  The namespace explorer responder: render the request's
    '  hydrated target view as the node browser page.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out  cur.meld(add)
       tgt=path
         | (myth/path_at ['vpath] out).fall []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       ver   bowl.crew.gut(['ver] (axal/new[myth] .none))
       ops   (explorer/ops_of bowl tgt)
       done
         .  out
            put(['res_status] (pd 200))
            put(['res_body] (pd (explorer/page tgt view ver ops)))
            put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

  +  route_talk
    '  The default responder with app-face dispatch: walk the
    '  target's ancestors deepest first, and at each depth prefer
    '  the DATUM binding (a bond/face hunt on the ancestor record
    '  itself — answer the generic frag/shell over its ctor) to the
    '  face kook (delegate to the form's talk, which receives the
    '  same bowl so the hydrated ['view] crew rides along; its
    '  ['hunt] slot scopes the claim, absent = the whole subtree).
    '  A claim that declines (a .x/.y reach over a deeper target,
    '  or a face hunt rooted in a sibling subtree) falls through to
    '  the next ancestor; no binding, no face, or malformed nodes
    '  all fall through to the explorer.  Fragment requests (the
    '  ['frag] marker the /frag route stamps) answer bare component
    '  markup and skip dispatch entirely.
    \  =bowl cur=myth add=myth
    ^  yell
    =  o  cur.meld(add)
    ?  (myth/has_at ['debug] o)
       | debugger/talk bowl cur add
    ?  (myth/has_at ['frag] o)
       | frag/talk bowl cur add
    =  tgt  (http/tgt_of o)
    %  n=nat tgt.len
    ^  yell
    ?  (lt n 1)
       | explorer/talk bowl cur add
    =  av  bowl.crew.gut(['anc ($u n)] (axal/new[myth] .none))
       dm=maybe[hunt]
         ?  (http/datum_face av)
          > (./some h)
            ?  (http/hunt_admits (hunt h.c []) tgt.take(n) tgt)
               (./some h)
            .none
          > .none  .none
    ?  dm
     > (./some h)
       | frag/shell bowl o tgt h.p
     > .none
       =  fv  bowl.crew.gut(['face ($u n)] (axal/new[myth] .none))
       ?  (http/face_of fv)
        > (./some f)
          ?  (http/hunt_admits (http/face_hunt fv) tgt.take(n) tgt)
             =  g  f.talk
             | g bowl cur add
          | _ (dec n)
        > .none  (_ (dec n))

  +  form
    ^  form
    def_form.set_talk(explorer/route_talk)
+  debugger
  '  A debug workspace over the same hydrated views as /ns. The
  '  explicit /debug route bypasses app faces, never the namespace
  '  reader or write verdicts. Browser enhancements live in debug.js.
  +  component_path
    ^ path
    ['weft 'debug 'v1 'page]

  +  request
    ' The renderer is hydrated independently of the inspected target. A
    ' historical target does not select a historical UI implementation.
    \ record=myth
    ^ myth
    = watch (myth/crew_at crew_slot record)
    | record.put crew_slot (cpail (watch.put(['debug_ui] (dep .y ['weft 'debug 'v1]))))

  +  declared_page
    ' The HTTP adapter supplies only typed namespace data and policy.
    ' All document markup is produced by the published Grove page component.
    \ components=axal[myth] tgt=path view=axal[myth] ver=axal[myth]
       ops=row[[p=path o=op]] paging=maybe[helm/journal_page]
    ^ nat
    > (./some component) components.dip(['page]).fil
      | error (pails/t "Missing Grove debugger page")
    = page_data (paging.run((\ page=helm/journal_page (grove_debug_page page.epoch page.before page.limit page.total page.next))))
      data (grove_debug_data tgt view ver ops page_data
        (? (is_log tgt) .false (explorer/writable tgt)) 'document .none)
    | debugger/render_declared components data
  + render_declared
    \ components=axal[myth] data=grove_debug_data
    ^ nat
    > (./some component) components.dip(['page]).fil
      | error (pails/t "Missing Grove debugger page")
    = tgt data.target
      input ((myth/new).put(['data] data))
    > (./some shell) (grove_fragment/render component input)
      | error (pails/t "Debugger page did not satisfy its response norm")
    ? !(eq_iota data.scope 'document) (weft/render shell)
    = assets
        ~ weft/build
        ~| 'link[rel=stylesheet][href=/debug-components.css]
        ~| 'link[rel=stylesheet][href=/debug.css]
        ~| 'script[src=/debug-mash.js][defer]
        ~| 'script[src=/debug.js][defer]
    | weft/page_with_assets (weft/cat2 "Shrine debug · " (show/path tgt)) assets [shell]
  +  talk
    \  =bowl cur=myth add=myth
    ^  yell
    = out cur.meld(add)
      tgt (http/tgt_of out)
      view bowl.crew.gut(['view] (axal/new[myth] .none))
      ver bowl.crew.gut(['ver] (axal/new[myth] .none))
      ops (explorer/ops_of bowl tgt)
      components (bowl.crew.gut(['debug_ui] (axal/new[myth] .none)))
      rendered
        ? components.dip(['page]).fil
         > (./some _) (debugger/declared_page components tgt view ver ops .none)
         > .none "Grove debugger unavailable: publish /weft/debug/v1/page. The legacy explorer remains at /ns."
      done
        . out
          put(['res_status] (pd (? (maybe/is_some components.dip(['page]).fil) 200 503)))
          put(['res_body] (pd rendered))
          put(['res_ctype] (pd "text/html; charset=utf-8"))
    | yell [] done

+  zoo
  '  The global component registry at /weft, and its face — the zoo.
  '  Registration is denormalized: a face only sees its own hydrated
  '  subtree, so each registered component's kid under /weft carries
  '  everything the zoo needs — the part path, the demo data path,
  '  and the lede — copied from the app's weft card at mount time by
  '  the host (a mount expansion is jailed to its own subtree, so an
  '  app cannot register itself in-kernel).

  +  root
    '  The registry root, by convention.
    ^  path
    ['weft]

  +  key
    '  A registry kid key for a component path: its segments joined
    '  with "_" as one symbol.
    '  ?=  ((zoo/key ['chat 'weft 'log]) ($ts "chat_weft_log"))
    \  p=path
    ^  iota
    =  parts
         %  i=nat 0  out=row[nat] []
         ?  (ge i p.len)
            out
         | _ i.inc out.snoc((show/iota p.at(i)))
    ($ts (weft/join "_" parts))

  +  path_at
    '  A path pail in a slot, or the empty path.
    \ slot=path t=myth
    ^ path
    | (myth/path_at slot t).fall []
  +  kind_of
    '  The ctor's family as text, for the kind chip.
    \  t=myth
    ^  str
    ?  t.get(bond/weft)
     > .none  ""
     > (./some held)
       ?  held
        > dyed  "dyed"
        > knit  "knit"
        > felt  "felt"
        > sewn  "sewn"
       ""

  +  entry
    '  One weft seed as its registry record: the whole card COPIED —
    '  minus the ctor itself — with every path value rebased against
    '  the mount root (the seed is pre-expansion, so "."-relative
    '  values still carry the rel marker), plus the component's
    '  absolute part path, its ctor kind, and its module.  The lore
    '  rides through whole, so a registry kid documents its component
    '  without reaching outside /weft.
    \  root=path at=path mod=str t=myth
    ^  myth
    =  part=path  root.weld(at)
       base
         =  slots  t.tap
         %  i=nat 0  out=myth myth/new
         ^  myth
         ?  (ge i slots.len)
            out
         =  s  slots.at(i)
         ?  (eq_pith s.key bond/weft)
            | _ i.inc out
         | _ i.inc out.put(s.key s.val)
       based  (pact/rebase_rec root base)
       b2
         ?  (myth/has_at ['demo] based)
            based
         based.put(['demo] (pails/p part))
    .  b2
       put(['part] (pails/p part))
       put(['kind] (pails/t (zoo/kind_of t)))
       put(['module] (pails/t mod))

  +  tasks
    '  Registration tasks for an app's manifest: one make under /weft
    '  per seed carrying a /sys/weft ctor.  The host runs these after
    '  a successful mount; a failed registration is logged, never
    '  fatal.
    \  root=path mod=str m=mani
    ^  row[task]
    =  seeds  m.seeds
    %  i=nat 0  out=row[task] []
    ^  row[task]
    ?  (ge i seeds.len)
       out
    =  [sp st]  seeds.at(i)
    ?  (myth/has_at bond/weft st)
       =  zr=path  zoo/root
          at=path  zr.snoc((zoo/key root.weld(sp)))
          tk
            ^  task
            (./vine at (writ/make (zoo/entry root sp mod st)))
       | _ i.inc out.snoc(tk)
    | _ i.inc out

  +  card1
    '  One zoo index pane: the component's lede, kind, and paths, the
    '  component itself mounted live against its default demo, and a
    '  link to its documentation page.
    \  key=iota t=myth
    ^  weft/node
    =  part=path  (zoo/path_at ['part] t)
       demo=path  (zoo/path_at ['demo] t)
       idc  (show/iota key)
    = markup
        ~ weft/build
        ~| 'ui-card[elevation=raised]
          ~| 'span[slot=title]
            [(weft/lnk (weft/cat2 "/weft/" idc) idc)]
          ~. 'span[slot=description] (myth/txt_at bond/lede t)
          ~. 'ui-badge[slot=meta][tone=neutral][size=small] (myth/txt_at ['kind] t)
          ~| 'div[slot=content]
            [(frag/mount idc part demo 2)]
          ~| 'div.muted[slot=footer]
            [(weft/lnk (explorer/url part) (show/path part))]
            ~. " over "
            [(weft/lnk (explorer/url demo) (show/path demo))]
    markup.at(0)

  +  demo_mounts
    '  Every demo slot of a registry kid as a labeled pane with the
    '  component mounted live: ['demo] is the default state, each
    '  ['demo <name>] a named one.
    \  part=path t=myth
    ^  row[weft/node]
    =  slots  t.tap
    %  i=nat 0  out=row[weft/node] []
    ^  row[weft/node]
    ?  (ge i slots.len)
       out
    =  s  slots.at(i)
    ?  (eq 0 s.key.len)
       | _ i.inc out
    ?  !(eq_iota s.key.at(0) 'demo)
       | _ i.inc out
    =  dp=path
         ?  s.val
          > p=pails/p  p.p
         []
    ?  (eq 0 dp.len)
       | _ i.inc out
    =  label
         ?  (eq 1 s.key.len)
            "demo"
         | show/iota s.key.at(1)
       pane
         = markup
             ~ weft/build
             ~| 'ui-card
               ~# 'span
                 'slot "title"
                 ~. label
               ~# 'span
                 'slot "meta"
                 'class "muted"
                 ~# 'a
                   'href (explorer/url dp)
                   ~. (show/path dp)
               ~# 'div
                 'slot "content"
                 [(frag/mount (weft/cat2 "d" (weft/show_nat i)) part dp 2)]
         markup.at(0)
    | _ i.inc out.snoc(pane)

  +  page1
    '  A component's documentation page: kind, module, part, the full
    '  lore (head, body, and its doctests as written), and every demo
    '  state mounted live.
    \  key=iota t=myth
    ^  nat
    =  part=path  (zoo/path_at ['part] t)
       kind  (myth/txt_at ['kind] t)
       mod   (myth/txt_at ['module] t)
       docrows
         ^  row[weft/node]
         ?  t.get(bond/help)
          > .none  []
          > (./some held)
            ?  held
             > doc=lore
               =  base
                    ~ weft/build
                    ~|
                      ~. 'div.lore-head doc.head
                      ~| 'div.lore-body
                        (web_lore/lore_lines doc)
               ?  (eq 0 doc.tests.len)
                  base
               base.weld((web_lore/dt_rows_never doc))
            []
       header
         ~ weft/build
         ~| 'div.top
           ~| 'h1
             [(weft/lnk "/weft" "zoo")]
             ~. " / "
             ~. (show/iota key)
           ~| 'div.muted
             [(web_ui/badge "neutral" kind)]
             ~. "  "
             [(weft/lnk (weft/cat2 "/ns/boot/" mod) mod)]
             ~. "  "
             [(weft/lnk (explorer/url part) (show/path part))]
       docpane
         ^  row[weft/node]
         ?  (eq 0 docrows.len)
            []
         [(web_ui/card "lore" docrows)]
       mounts  (zoo/demo_mounts part t)
       body
         ~ weft/build
         ~| 'main
           header.weld(docpane).weld(mounts).snoc(frag/script)
    | weft/page (show/iota key) web_style/css body

  +  talk
    '  The zoo face: the index (every registered component rendered
    '  live) at the root, a component's documentation page when the
    '  target is a registry kid.
    \  =bowl cur=myth add=myth
    ^  yell
    =  out   cur.meld(add)
       tgt=path
         | (myth/path_at ['vpath] out).fall []
       view  bowl.crew.gut(['view] (axal/new[myth] .none))
       detail
         '  a registry kid target: its own hydrated record, provided
         '  it is an entry (the face card at /weft/kook has no part)
         ^  maybe[myth]
         ?  (lt tgt.len 2)
            .none
         ?  view.fil
          > .none  .none
          > (./some t)
            ?  (eq 0 (zoo/path_at ['part] t).len)
               .none
            (./some t)
    ?  detail
     > (./some t)
       =  done1
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (zoo/page1 tgt.at(1) t)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       | yell [] done1
     > .none
       =  entries  view.kid_tap
          registered
            %  i=nat 0  ns=row[weft/node] []
            ^  row[weft/node]
            ?  (ge i entries.len)
               ns
            =  e  entries.at(i)
            ?  e.val.fil
             > .none  (_ i.inc ns)
             > (./some t)
               '  only registry entries: /weft/kook (the face) is a
               '  kid of the same root and carries no ['part]
               ?  (eq 0 (zoo/path_at ['part] t).len)
                  | _ i.inc ns
               | _ i.inc ns.snoc((zoo/card1 e.key t))
          panes
            ? (eq registered.len 0)
              ~ weft/build
              ~. 'p.muted "No components registered."
            registered
          body
            ~ weft/build
            ~| 'main
              ~. 'h1 "component zoo"
              ~| 'div.zoo
                panes
              [frag/script]
          done
            .  out
               put(['res_status] (pd 200))
               put(['res_body] (pd (weft/page "component zoo" web_style/css body)))
               put(['res_ctype] (pd "text/html; charset=utf-8"))
       | yell [] done

  +  form
    '  The zoo behavior: talk renders.  Seeded as the face card at
    '  /weft/kook/face by the root convention tasks.
    ^  form
    def_form.set_talk(zoo/talk)
