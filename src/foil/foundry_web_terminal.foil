-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
-  foundry_pronounce [order=40]
-  foundry_terminal [order=50]
-  weft [order=60]
'  foundry_web_terminal: a closed, mechanical interpreter from one validated
'  terminal_plan to the existing Web AST.  It consumes only terminal opcodes,
'  typed bindings, ordered child addresses, and canonical interaction/Hole
'  evidence already copied into the plan.  Semantic roles and application
'  routes are intentionally invisible here.

+  web_terminal_refusal
  '  binding identifies the exact missing, ill-typed, or unsupported terminal
  '  binding when one is responsible.  Entry-level refusals always retain the
  '  exact occurrence address; envelope refusals have no occurrence.
  :  code=iota at=maybe[projection_address] binding=maybe[path]

+  web_terminal_result
  &  web_terminal_result/admitted
     web_terminal_result/refused

  +  admitted
    :  roots=row[weft/node]
  +  refused
    :  refusal=web_terminal_refusal

+  web_terminal_nodes_result
  &  web_terminal_nodes_result/admitted
     web_terminal_nodes_result/refused

  +  admitted
    :  nodes=row[weft/node]
  +  refused
    :  refusal=web_terminal_refusal

+  web_terminal_material
  '  Disposable bottom-up material for one exact occurrence.  pass may expose
  '  several child nodes, so material is a row rather than a synthetic wrapper.
  :  address=projection_address nodes=row[weft/node]

+  web_terminal_fold_result
  &  web_terminal_fold_result/admitted
     web_terminal_fold_result/refused

  +  admitted
    :  material=row[web_terminal_material]
  +  refused
    :  refusal=web_terminal_refusal

+  web_terminal_attributes_result
  &  web_terminal_attributes_result/admitted
     web_terminal_attributes_result/refused

  +  admitted
    :  attributes=row[weft/att]
  +  refused
    :  refusal=web_terminal_refusal

+  web_terminal_text_binding_result
  &  web_terminal_text_binding_result/absent
     web_terminal_text_binding_result/text
     web_terminal_text_binding_result/wrong

  +  absent
    :
  +  text
    :  value=nat
  +  wrong
    :

+  foundry_web_terminal
  +  tag_key
    ^  path
    ['terminal 'web 'tag]

  +  class_key
    ^  path
    ['terminal 'web 'class]

  +  content_key
    ^  path
    ['terminal 'web 'content]

  +  action_mechanics_key
    '  This names the currently absent schema binding.  It is diagnostic only:
    '  the adapter never accepts an arbitrary endpoint under this path.
    ^  path
    ['terminal 'web 'action 'mechanics]

  +  refusal
    \  code=iota at=maybe[projection_address] binding=maybe[path]
    ^  web_terminal_refusal
    (web_terminal_refusal code at binding)

  +  entry_refusal
    \  code=iota address=projection_address binding=maybe[path]
    ^  web_terminal_nodes_result
    (web_terminal_nodes_result/refused
      (foundry_web_terminal/refusal code (./some address) binding))

  +  path_text
    '  Canonical namespace-path spelling used only as inert Hole metadata.  It
    '  is never prefixed, treated as a URL, or used to recover a route.
    \  value=path
    ^  nat
    ?  (eq value.len 0)  "/"
    |  > index=nat 0  > parts=row[nat] []
    ?  (ge index value.len)
       (weft/cat2 "/" (weft/join "/" parts))
    (_ index.inc parts.snoc((iota_show value.at(index))))

  +  binding_at
    \  key=path bindings=row[terminal_binding] index=nat
    ^  maybe[terminal_binding]
    ?  (ge index bindings.len)  .none
    ?  (equal key bindings.at(index).key)  (./some bindings.at(index))
    (_ key bindings index.inc)

  +  text_binding
    \  key=path bindings=row[terminal_binding]
    ^  web_terminal_text_binding_result
    ?  (foundry_web_terminal/binding_at key bindings 0)
     > .none  (web_terminal_text_binding_result/absent)
     > (./some binding=terminal_binding)
       ?  binding.value
        > x=projection_value/text
          (web_terminal_text_binding_result/text x.value)
        > projection_value/flag
          (web_terminal_text_binding_result/wrong)
        > projection_value/count
          (web_terminal_text_binding_result/wrong)
        > projection_value/name
          (web_terminal_text_binding_result/wrong)
        > projection_value/semantic_ref
          (web_terminal_text_binding_result/wrong)
        > projection_value/ref
          (web_terminal_text_binding_result/wrong)

  +  key_allowed
    '  The Web binding vocabulary is closed per opcode.  This keeps arbitrary
    '  provider data from silently becoming attributes, URLs, or raw markup.
    \  operation=terminal_operation key=path
    ^  bool
    ?  operation
     > terminal_operation/pass  .false
     > terminal_operation/container
       ?  (equal key foundry_web_terminal/tag_key)  .true
       (equal key foundry_web_terminal/class_key)
     > terminal_operation/text
       (equal key foundry_web_terminal/content_key)
     > terminal_operation/glyph
       (equal key foundry_web_terminal/content_key)
     > terminal_operation/hole
       ?  (equal key foundry_web_terminal/tag_key)  .true
       ?  (equal key foundry_web_terminal/class_key)  .true
       (equal key foundry_web_terminal/content_key)
     > terminal_operation/action  .false

  +  first_unknown_binding
    \  operation=terminal_operation bindings=row[terminal_binding] index=nat
    ^  maybe[path]
    ?  (ge index bindings.len)  .none
    ?  !(foundry_web_terminal/key_allowed operation bindings.at(index).key)
       (./some bindings.at(index).key)
    (_ operation bindings index.inc)

  +  tag_valid
    '  weft emits tag names as terminal syntax rather than escaped text.  Keep
    '  the admitted target vocabulary structural and script-free.
    \  tag=nat
    ^  bool
    ?  (eq tag "div")      .true
    ?  (eq tag "section")  .true
    ?  (eq tag "article")  .true
    ?  (eq tag "main")     .true
    ?  (eq tag "aside")    .true
    ?  (eq tag "header")   .true
    ?  (eq tag "footer")   .true
    ?  (eq tag "nav")      .true
    ?  (eq tag "p")        .true
    ?  (eq tag "span")     .true
    ?  (eq tag "ol")       .true
    ?  (eq tag "ul")       .true
    ?  (eq tag "li")       .true
    ?  (eq tag "pre")      .true
    ?  (eq tag "code")     .true
    ?  (eq tag "strong")   .true
    ?  (eq tag "em")       .true
    ?  (eq tag "small")    .true
    ?  (eq tag "h1")       .true
    ?  (eq tag "h2")       .true
    ?  (eq tag "h3")       .true
    ?  (eq tag "h4")       .true
    ?  (eq tag "h5")       .true
    (eq tag "h6")

  +  class_attributes
    \  entry=terminal_plan_entry
    ^  web_terminal_attributes_result
    ?  (foundry_web_terminal/text_binding foundry_web_terminal/class_key
          entry.bindings)
     > web_terminal_text_binding_result/absent
       (web_terminal_attributes_result/admitted [])
     > x=web_terminal_text_binding_result/text
       (web_terminal_attributes_result/admitted
         [(weft/att "class" x.value)])
     > web_terminal_text_binding_result/wrong
       (web_terminal_attributes_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_binding_type_mismatch (./some entry.address)
           (./some foundry_web_terminal/class_key)))

  +  lower_element
    \  entry=terminal_plan_entry children=row[weft/node]
    ^  web_terminal_nodes_result
    ?  (foundry_web_terminal/text_binding foundry_web_terminal/tag_key
          entry.bindings)
     > web_terminal_text_binding_result/absent
       (foundry_web_terminal/entry_refusal 'web_terminal_binding_missing
         entry.address (./some foundry_web_terminal/tag_key))
     > web_terminal_text_binding_result/wrong
       (foundry_web_terminal/entry_refusal
         'web_terminal_binding_type_mismatch entry.address
         (./some foundry_web_terminal/tag_key))
     > x=web_terminal_text_binding_result/text
       ?  !(foundry_web_terminal/tag_valid x.value)
          (foundry_web_terminal/entry_refusal 'web_terminal_tag_invalid
            entry.address (./some foundry_web_terminal/tag_key))
       ?  (foundry_web_terminal/class_attributes entry)
        > y=web_terminal_attributes_result/refused
          (web_terminal_nodes_result/refused y.refusal)
        > y=web_terminal_attributes_result/admitted
          (web_terminal_nodes_result/admitted
            [(weft/el x.value y.attributes children)])

  +  lower_text
    \  entry=terminal_plan_entry
    ^  web_terminal_nodes_result
    ?  (foundry_web_terminal/text_binding foundry_web_terminal/content_key
          entry.bindings)
     > web_terminal_text_binding_result/absent
       (foundry_web_terminal/entry_refusal 'web_terminal_binding_missing
         entry.address (./some foundry_web_terminal/content_key))
     > web_terminal_text_binding_result/wrong
       (foundry_web_terminal/entry_refusal
         'web_terminal_binding_type_mismatch entry.address
         (./some foundry_web_terminal/content_key))
     > x=web_terminal_text_binding_result/text
       (web_terminal_nodes_result/admitted [(weft/tx x.value)])

  +  hole_content
    \  entry=terminal_plan_entry
    ^  web_terminal_nodes_result
    ?  (foundry_web_terminal/text_binding foundry_web_terminal/content_key
          entry.bindings)
     > web_terminal_text_binding_result/absent
       (web_terminal_nodes_result/admitted [])
     > web_terminal_text_binding_result/wrong
       (foundry_web_terminal/entry_refusal
         'web_terminal_binding_type_mismatch entry.address
         (./some foundry_web_terminal/content_key))
     > x=web_terminal_text_binding_result/text
       (web_terminal_nodes_result/admitted [(weft/tx x.value)])

  +  lower_hole
    '  A Hole is an inert placeholder in this first Web terminal.  Its exact
    '  canonical source and semantic fallback are preserved as metadata; no
    '  fetch, observe, or namespace route is fabricated from either path.
    \  entry=terminal_plan_entry
    ^  web_terminal_nodes_result
    ?  entry.occurrence.hole
     > .none
       (foundry_web_terminal/entry_refusal
         'web_terminal_hole_evidence_missing entry.address .none)
     > (./some hole=projection_pronunciation_hole)
       ?  hole.source
        > .none
          (foundry_web_terminal/entry_refusal
            'web_terminal_hole_source_missing entry.address .none)
        > (./some source=path)
          ?  hole.semantic_fallback
           > .none
             ?  hole.fallback
              > (./some _)
                (foundry_web_terminal/entry_refusal
                  'web_terminal_hole_addressed_fallback_material_missing
                  entry.address .none)
              > .none
                (foundry_web_terminal/entry_refusal
                  'web_terminal_hole_fallback_missing entry.address .none)
           > (./some fallback=path)
             ?  (foundry_web_terminal/text_binding
                   foundry_web_terminal/tag_key entry.bindings)
              > web_terminal_text_binding_result/absent
                (foundry_web_terminal/entry_refusal
                  'web_terminal_binding_missing entry.address
                  (./some foundry_web_terminal/tag_key))
              > web_terminal_text_binding_result/wrong
                (foundry_web_terminal/entry_refusal
                  'web_terminal_binding_type_mismatch entry.address
                  (./some foundry_web_terminal/tag_key))
              > tag=web_terminal_text_binding_result/text
                ?  !(foundry_web_terminal/tag_valid tag.value)
                   (foundry_web_terminal/entry_refusal
                     'web_terminal_tag_invalid entry.address
                     (./some foundry_web_terminal/tag_key))
                ?  (foundry_web_terminal/class_attributes entry)
                 > cls=web_terminal_attributes_result/refused
                   (web_terminal_nodes_result/refused cls.refusal)
                 > cls=web_terminal_attributes_result/admitted
                   ?  (foundry_web_terminal/hole_content entry)
                    > content=web_terminal_nodes_result/refused
                      (web_terminal_nodes_result/refused content.refusal)
                    > content=web_terminal_nodes_result/admitted
                      =  metadata=row[weft/att]
                           [(weft/att "data-foundry-hole-source"
                              (foundry_web_terminal/path_text source))
                            (weft/att "data-foundry-hole-fallback"
                              (foundry_web_terminal/path_text fallback))]
                         attributes
                           cls.attributes.weld(metadata)
                      (web_terminal_nodes_result/admitted
                        [(weft/el tag.value attributes content.nodes)])

  +  lower_action
    '  An admitted Action mount proves semantic authority, not a Web endpoint.
    '  terminal_plan v2 exposes identity, pin, input contract, and admission
    '  witness, but no method, endpoint, or contract-to-field mapping bound to
    '  that witness.  Refuse until those mechanics are carried canonically.
    \  entry=terminal_plan_entry
    ^  web_terminal_nodes_result
    =  actions  (foundry_terminal/entry_actions entry)
    ?  (eq actions.len 0)
       (foundry_web_terminal/entry_refusal
         'web_terminal_action_mount_missing entry.address .none)
    ?  (gt actions.len 1)
       (foundry_web_terminal/entry_refusal
         'web_terminal_action_mount_ambiguous entry.address .none)
    (foundry_web_terminal/entry_refusal
      'web_terminal_action_mechanics_missing entry.address
      (./some foundry_web_terminal/action_mechanics_key))

  +  lower_entry
    \  entry=terminal_plan_entry children=row[weft/node]
    ^  web_terminal_nodes_result
    ?  entry.operation
     > terminal_operation/action
       (foundry_web_terminal/lower_action entry)
     > operation=terminal_operation/pass
       ?  (foundry_web_terminal/first_unknown_binding operation
             entry.bindings 0)
        > (./some key=path)
          (foundry_web_terminal/entry_refusal
            'web_terminal_binding_unknown entry.address (./some key))
        > .none  (web_terminal_nodes_result/admitted children)
     > operation=terminal_operation/container
       ?  (foundry_web_terminal/first_unknown_binding operation
             entry.bindings 0)
        > (./some key=path)
          (foundry_web_terminal/entry_refusal
            'web_terminal_binding_unknown entry.address (./some key))
        > .none  (foundry_web_terminal/lower_element entry children)
     > operation=terminal_operation/text
       ?  (foundry_web_terminal/first_unknown_binding operation
             entry.bindings 0)
        > (./some key=path)
          (foundry_web_terminal/entry_refusal
            'web_terminal_binding_unknown entry.address (./some key))
        > .none  (foundry_web_terminal/lower_text entry)
     > operation=terminal_operation/glyph
       ?  (foundry_web_terminal/first_unknown_binding operation
             entry.bindings 0)
        > (./some key=path)
          (foundry_web_terminal/entry_refusal
            'web_terminal_binding_unknown entry.address (./some key))
        > .none  (foundry_web_terminal/lower_text entry)
     > operation=terminal_operation/hole
       ?  (foundry_web_terminal/first_unknown_binding operation
             entry.bindings 0)
        > (./some key=path)
          (foundry_web_terminal/entry_refusal
            'web_terminal_binding_unknown entry.address (./some key))
        > .none  (foundry_web_terminal/lower_hole entry)

  +  material_at
    \  address=projection_address material=row[web_terminal_material]
       index=nat
    ^  maybe[web_terminal_material]
    ?  (ge index material.len)  .none
    ?  (equal address material.at(index).address)
       (./some material.at(index))
    (_ address material index.inc)

  +  children_nodes
    \  children=row[projection_address]
       material=row[web_terminal_material] index=nat out=row[weft/node]
    ^  web_terminal_nodes_result
    ?  (ge index children.len)
       (web_terminal_nodes_result/admitted out)
    ?  (foundry_web_terminal/material_at children.at(index) material 0)
     > .none
       (web_terminal_nodes_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_child_material_missing
           (./some children.at(index)) .none))
     > (./some child=web_terminal_material)
       (_ children material index.inc out.weld(child.nodes))

  +  fold_entries
    '  Entries are canonical pre-order.  Walking the row backward guarantees
    '  every exact addressed child has material before its parent is lowered.
    \  entries=row[terminal_plan_entry] index=nat
       material=row[web_terminal_material]
    ^  web_terminal_fold_result
    ?  (eq index 0)
       (web_terminal_fold_result/admitted material)
    =  entry  entries.at(index.dec)
    ?  (foundry_web_terminal/material_at entry.address material 0)
     > (./some _)
       (web_terminal_fold_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_occurrence_ambiguous (./some entry.address) .none))
     > .none
       ?  (foundry_web_terminal/children_nodes entry.children material 0 [])
        > x=web_terminal_nodes_result/refused
          (web_terminal_fold_result/refused x.refusal)
        > x=web_terminal_nodes_result/admitted
          ?  (foundry_web_terminal/lower_entry entry x.nodes)
           > y=web_terminal_nodes_result/refused
             (web_terminal_fold_result/refused y.refusal)
           > y=web_terminal_nodes_result/admitted
             (_ entries index.dec
               material.snoc((web_terminal_material entry.address y.nodes)))

  +  root_nodes
    \  roots=row[projection_address] material=row[web_terminal_material]
       index=nat out=row[weft/node]
    ^  web_terminal_nodes_result
    ?  (ge index roots.len)
       (web_terminal_nodes_result/admitted out)
    ?  (foundry_web_terminal/material_at roots.at(index) material 0)
     > .none
       (web_terminal_nodes_result/refused
         (foundry_web_terminal/refusal 'web_terminal_root_material_missing
           (./some roots.at(index)) .none))
     > (./some root=web_terminal_material)
       (_ roots material index.inc out.weld(root.nodes))

  +  occurrence_entries_match
    '  A raw nominal value is not a validation certificate.  Preserve the
    '  validated-plan boundary by checking its schema, version, and canonical
    '  occurrence/address pairing before interpreting any binding.
    \  plan=terminal_plan index=nat
    ^  bool
    ?  (ge index plan.entries.len)  .true
    ?  (foundry_terminal/occurrence_address
          plan.entries.at(index).occurrence)
     > .none  .false
     > (./some address=projection_address)
       ?  !(equal address plan.entries.at(index).address)  .false
       ?  !(equal plan.entries.at(index).occurrence
             plan.pronunciation.occurrences.at(index))  .false
       (_ plan index.inc)

  +  evaluate
    \  plan=terminal_plan
    ^  web_terminal_result
    ?  !(eq plan.schema 2)
       (web_terminal_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_schema_unsupported .none .none))
    ?  !(eq plan.operation_version 2)
       (web_terminal_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_operation_version_unsupported .none .none))
    ?  !(eq_iota plan.target.backend 'web)
       (web_terminal_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_backend_unsupported .none .none))
    ?  !(eq plan.entries.len plan.pronunciation.occurrences.len)
       (web_terminal_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_occurrence_count_mismatch .none .none))
    ?  !(foundry_web_terminal/occurrence_entries_match plan 0)
       (web_terminal_result/refused
         (foundry_web_terminal/refusal
           'web_terminal_occurrence_mismatch .none .none))
    ?  (foundry_web_terminal/fold_entries plan.entries plan.entries.len [])
     > x=web_terminal_fold_result/refused
       (web_terminal_result/refused x.refusal)
     > x=web_terminal_fold_result/admitted
       ?  (foundry_web_terminal/root_nodes plan.pronunciation.roots
             x.material 0 [])
        > y=web_terminal_nodes_result/refused
          (web_terminal_result/refused y.refusal)
        > y=web_terminal_nodes_result/admitted
          (web_terminal_result/admitted y.nodes)

  +  render_nodes
    \  nodes=row[weft/node] index=nat out=nat
    ^  nat
    ?  (ge index nodes.len)  out
    (_ nodes index.inc (weft/cat2 out (weft/render nodes.at(index))))

  +  result_admitted
    \  result=web_terminal_result
    ^  bool
    ?  result
     > web_terminal_result/admitted  .true
     > web_terminal_result/refused   .false

  +  result_nodes
    \  result=web_terminal_result
    ^  maybe[row[weft/node]]
    ?  result
     > x=web_terminal_result/admitted  (./some x.roots)
     > web_terminal_result/refused     .none

  +  result_rendered
    \  result=web_terminal_result
    ^  maybe[nat]
    ?  result
     > x=web_terminal_result/admitted
       (./some (foundry_web_terminal/render_nodes x.roots 0 ""))
     > web_terminal_result/refused  .none

  +  result_code
    \  result=web_terminal_result
    ^  maybe[iota]
    ?  result
     > web_terminal_result/admitted  .none
     > x=web_terminal_result/refused  (./some x.refusal.code)

  +  result_at
    \  result=web_terminal_result
    ^  maybe[projection_address]
    ?  result
     > web_terminal_result/admitted  .none
     > x=web_terminal_result/refused  x.refusal.at

  +  result_binding
    \  result=web_terminal_result
    ^  maybe[path]
    ?  result
     > web_terminal_result/admitted  .none
     > x=web_terminal_result/refused  x.refusal.binding
