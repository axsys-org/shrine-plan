- grove_bundle
- publication
- publisher_vocabulary
- grove
- grove_template
- lain_types
- grove_trees
'  Grove owns validation, linking names, and publication geography.
'  The host compiles a generated unit over native subject artifacts.
+ grove_backend
  + diagnostic
    : span=rex/source_span message=str cause=maybe[any]
  + dependency
    : span=rex/source_span alias=str module=grove_backend/bundle
  + request
    : identity=path tree=rex imports=row[grove_backend/dependency]
      metadata=row[path] records=row[path]
  + compiled
    : entries=mop[path grove_backend/entry lt_pith]
      metadata=row[pail] artifact=any
      definitions=row[[path nat type]]
  + ports
    : lookup={\ path}maybe[myth]
      compile={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
  + definition
    : span=rex/source_span name=str code=row[rex]
      metadata=row[grove/property]
  + index
    : definitions=row[grove_backend/definition]
      imports=row[grove/import_decl]
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove_backend/diagnostic a]
    | ./err (grove_backend/diagnostic span message .none)
  + name_ok
    \ name=str
    ^ bool
    ? (eq name "") .false
    ? (eq name "boot") .false
    ? (eq name "grove_metadata") .false
    | eq (str/split_byte 47 name).len 1
  + statement_span
    \ statement=grove/statement
    ^ rex/source_span
    ? statement
     > (grove/tag span kind) span
     > (grove/property span slot value) span
     > (grove/directive span kind target) span
     > (grove/block span kind body) span
     > (grove/implementation span code) span
     > (grove/comment span text) span
  + metadata
    \ body=row[grove/statement]
    ^ either[grove_backend/diagnostic row[grove/property]]
    ? (eq body.len 0) (./ok [])
    < tail (grove_backend/metadata body.drop(1))
    ? body.at(0)
     > (grove/property span slot value)
      | ./ok tail.cons((grove/property span slot value))
     > (grove/comment span text) (./ok tail)
    | grove_backend/fail[row[grove/property]]
      (grove_backend/statement_span body.at(0))
      "Metadata blocks contain properties and comments only."
  + body
    \ span=rex/source_span name=str body=row[grove/statement]
    ^ either[grove_backend/diagnostic grove_backend/definition]
    % rest=row[grove/statement] body code=row[rex] []
      props=row[grove/property] []
    ^ either[grove_backend/diagnostic grove_backend/definition]
    ? (eq rest.len 0)
      | ./ok (grove_backend/definition span name code props)
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) code props)
     > (grove/tag at kind)
      ? kind
       > .type (_ rest.drop(1) code props)
       > .slot (_ rest.drop(1) code props)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis tag."
     > (grove/implementation at trees)
      ? code.len
        | grove_backend/fail[grove_backend/definition] at
          "Duplicate implementation."
      | _ rest.drop(1) trees props
     > (grove/block at kind statements)
      ? kind
       > .meta
        < more (grove_backend/metadata statements)
        | _ rest.drop(1) code props.weld(more)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis block."
     > (grove/directive at kind target)
      | grove_backend/fail[grove_backend/definition] at
        "Unsupported Grove synthesis directive."
     > (grove/property at slot value)
      | grove_backend/fail[grove_backend/definition] at
        "Properties must be inside #meta in this backend batch."
  + index_document
    \ doc=grove/document
    ^ either[grove_backend/diagnostic grove_backend/index]
    % rest=row[grove/item] doc.items names=row[str] []
      defs=row[grove_backend/definition] []
      imports=row[grove/import_decl] []
    ^ either[grove_backend/diagnostic grove_backend/index]
    ? (eq rest.len 0) (./ok (grove_backend/index defs imports))
    ? rest.at(0)
     > (grove/comment span text) (_ rest.drop(1) names defs imports)
     > (grove/import_decl span alias target)
      ? (names.has(alias))
        | grove_backend/fail[grove_backend/index] span
          "Duplicate or conflicting import alias."
      ? !(grove_backend/name_ok alias)
        | grove_backend/fail[grove_backend/index] span
          "Invalid import alias."
      | _ rest.drop(1) names.snoc(alias) defs
        imports.snoc((grove/import_decl span alias target))
     > (grove/declaration span name statements)
      > (grove/name/identifier text) name
        | grove_backend/fail[grove_backend/index] span
          "Tree installation synthesis is unsupported."
      ? (names.has(text))
        | grove_backend/fail[grove_backend/index] span
          "Duplicate or conflicting declaration name."
      ? !(grove_backend/name_ok text)
        | grove_backend/fail[grove_backend/index] span
          "Invalid declaration name."
      < def (grove_backend/body span text statements)
      | _ rest.drop(1) names.snoc(text) defs.snoc(def) imports
  + namespace_path
    \ tree=rex
    ^ either[grove_backend/diagnostic path]
    ? !(equal tree.leaf_kind (maybe/some[str] "cord"))
      | grove_backend/path_parts (rex/normalize tree)
    ? tree
     > (./leaf span shape text)
      ? !(equal tree.leaf_kind (maybe/some[str] "cord"))
        | grove_backend/fail[path] span
          "Expected an absolute namespace path cord."
      ?> (./some parts) (path_parse text)
        | grove_backend/fail[path] span
          "Invalid absolute namespace path."
      | ./ok parts
    | grove_backend/fail[path] tree.span
      "Expected an absolute namespace path cord."
  + path_parts
    \ tree=rex
    ^ either[grove_backend/diagnostic path]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "word"))
        ?> (./some parts) (path_parse (str/join "" ["/" text]))
          | grove_backend/fail[path] span "Invalid namespace segment."
        ? (eq parts.len 1) (./ok parts)
        | grove_backend/fail[path] span "Expected one namespace segment."
      | grove_backend/fail[path] span "Expected a namespace path."
     > (./nest span color rune kids)
      ? !(eq rune "/")
        | grove_backend/fail[path] span "Expected a namespace path."
      % rest=row[rex] kids parts=path []
      ^ either[grove_backend/diagnostic path]
      ? (eq rest.len 0)
        ? parts.len (./ok parts)
        | grove_backend/fail[path] span "Empty namespace path."
      < next (grove_backend/path_parts rest.at(0))
      | _ rest.drop(1) parts.weld(next)
    | grove_backend/fail[path] tree.span "Expected a namespace path."
  + resolve_slot
    \ lookup={\ path}maybe[myth] imports=row[grove/import_decl] tree=rex
    ^ either[grove_backend/diagnostic path]
    < path (grove_backend/namespace_path tree)
    ? (equal tree.leaf_kind (maybe/some[str] "cord")) (./ok path)
    % rest=row[grove/import_decl] imports
    ^ either[grove_backend/diagnostic path]
    ? (eq rest.len 0) (./ok path)
    = imp rest.at(0)
    ? (equal path.at(0) ($ts imp.alias))
      < target (grove_backend/namespace_path imp.target)
      | ./ok (grove_roles/import_location target lookup).weld(path.drop(1))
    | _ rest.drop(1)
  + imported_module
    \ span=rex/source_span target=path card=myth
    ^ either[grove_backend/diagnostic grove_backend/bundle]
    ' A namespace alias needs no compiler artifact. It exports no code.
    ?> (./some slot) card.get(grove_backend/module_slot)
      | ./ok (grove_backend/bundle grove_backend/version
          target [] (mop/empty) 0)
    ?> module=grove_backend/bundle slot
      | grove_backend/fail[grove_backend/bundle] span
        "Invalid Grove module bundle."
    ? !(eq module.version grove_backend/version)
      | grove_backend/fail[grove_backend/bundle] span
        "Incompatible Grove bundle; rebuild definitions."
    ? (equal[any] module.artifact 0)
      ? module.exports.size
        | grove_backend/fail[grove_backend/bundle] span
          "Code imports require a published compiler artifact; rebuild definitions."
      | ./ok module
    | ./ok module
  + resolve
    \ ports=grove_backend/ports imports=row[grove/import_decl]
    ^ either[grove_backend/diagnostic row[grove_backend/dependency]]
    ? (eq imports.len 0) (./ok [])
    = imp imports.at(0)
    < target (grove_backend/namespace_path imp.target)
    > (./some card) (ports.lookup target)
      | grove_backend/fail[row[grove_backend/dependency]] imp.span
        "Missing imported declaration."
    < module (grove_backend/imported_module imp.span target card)
    < tail (grove_backend/resolve ports imports.drop(1))
    | ./ok tail.cons(
        (grove_backend/dependency imp.span imp.alias module))
  + meta_key
    \ name=str index=nat
    ^ path
    = suffix (str/join "" ["v" (nat/show index)])
    [($ts "grove_metadata") ($ts name) ($ts suffix)]
  + rewrite
    '  Grove's %/member resolves in this declaration; %/decl/member
    '  resolves in the shared document. Ordinary Foil paths also work.
    \ names=row[str] current=str tree=rex
    ^ rex
    > (./nest span color rune kids) tree
      tree
    ? (eq rune "=%/")
      ? (lt kids.len 2) tree
      = target
          | grove_backend/rewrite names current
            (rex/rune "%/" kids.drop(1)).with_span(span)
      | rex/nest span color "=" [kids.at(0) target]
    ? (eq rune "/")
      = flat (row/bind[rex rex] grove_backend/path_children kids)
      | rex/nest span color "/" flat
    ? !(eq rune "%/") tree
    ? (eq kids.len 0) tree
    > (./leaf loc shape text) kids.at(0)
      tree
    ? names.has(text)
      ? (eq color "clear") (rex/group kids).with_span(span)
      | rex/nest span color "" kids
    | rex/nest span color "/" kids.cons((rex/word current))
  + path_children
    \ tree=rex
    ^ row[rex]
    ? tree
     > (./nest span color rune kids)
      ? (eq rune "/") kids
      [tree]
    [tree]
  + check_code
    '  Canonical compiler paths and native source imports bypass the
    '  export boundary. Grove code must use its declared aliases.
    \ tree=rex
    ^ either[grove_backend/diagnostic rex]
    ? tree
     > (./leaf span shape text)
      ? (equal tree.leaf_kind (maybe/some[str] "word"))
        ? (eq text "boot")
          | grove_backend/fail[rex] span
            "Internal compiler paths are not Grove references."
        (./ok tree)
      (./ok tree)
     > (./nest span color rune kids)
      ? (eq rune "-")
        | grove_backend/fail[rex] span
          "Use Grove imports, not embedded Foil module imports."
      | grove_backend/check_children tree
    | grove_backend/check_children tree
  + check_children
    \ tree=rex
    ^ either[grove_backend/diagnostic rex]
    % rest=row[rex] tree.children
    ^ either[grove_backend/diagnostic rex]
    ? (eq rest.len 0) (./ok tree)
    < checked (grove_backend/check_code rest.at(0))
    | _ rest.drop(1)
  + metadata_value
    \ value=rex
    ^ rex
    ? (equal value.leaf_kind (maybe/some[str] "cord"))
      | rex/with_span value.span
        (rex/rune "|" [(rex/path ["pails" "t"]) value])
    | rex/with_span value.span
      (rex/rune "^" [(rex/word "pail") value])
  + declaration_tree
    \ span=rex/source_span path=path value=rex
    ^ rex
    ? (eq path.len 0) value
    = name (str/from_atom (quip_val path.at(0)))
      body (grove_backend/declaration_tree span path.drop(1) value)
    | rex/with_span span
      (rex/rune "+" [(rex/word name).with_span(span) body])
  + generate
    \ index=grove_backend/index
    ^ either[grove_backend/diagnostic rex]
    = locals index.definitions.map((\ def def.name))
      aliases index.imports.map((\ imp imp.alias))
      names locals.weld(aliases)
    % rest=row[grove_backend/definition] index.definitions
      forms=row[rex] []
    ^ either[grove_backend/diagnostic rex]
    ? (eq rest.len 0)
      = span=rex/source_span
          ? index.definitions.len index.definitions.at(0).span
          rex/zero_span
      | ./ok (rex/group forms).with_span(span)
    = def rest.at(0)
      code (rex/normalize (rex/heir def.span def.code))
    < checked (grove_backend/check_code code)
    = rewrite={\ rex}rex
        \ node
        | grove_backend/rewrite names def.name node
      rewritten (rex/walk rewrite code)
      scope
        | rex/with_span def.span
          (rex/rune "+" [(rex/word def.name) rewritten])
      metas
        | (row/range 0 def.metadata.len).map
        \ i
        = prop def.metadata.at(i)
        = value | rex/normalize prop.value
        = body
            | grove_backend/metadata_value
              (rex/walk rewrite value)
        | grove_backend/declaration_tree prop.span
          (grove_backend/meta_key def.name i) body
      added=row[rex] (? def.code.len [scope] [])
    < checked_meta (grove_backend/check_code (rex/group metas))
    | _ rest.drop(1) forms.weld(added).weld(metas)
  + slots
    \ lookup={\ path}maybe[myth] imports=row[grove/import_decl]
      defs=row[grove_backend/definition]
    ^ either[grove_backend/diagnostic row[row[path]]]
    ? (eq defs.len 0) (./ok [])
    = def defs.at(0)
    < head (grove_backend/property_slots lookup imports def.metadata [])
    < tail (grove_backend/slots lookup imports defs.drop(1))
    | ./ok tail.cons(head)
  + property_slots
    \ lookup={\ path}maybe[myth] imports=row[grove/import_decl]
      props=row[grove/property] seen=row[path]
    ^ either[grove_backend/diagnostic row[path]]
    ? (eq props.len 0) (./ok seen)
    = prop props.at(0)
    < slot (grove_backend/resolve_slot lookup imports prop.slot)
    = reserved=row[path]
        [grove_backend/module_slot grove_templates/slot
         grove_templates/source_slot]
    ? (reserved.has(slot))
      | grove_backend/fail[row[path]] prop.span
        "Metadata collides with a reserved Grove slot."
    ? (seen.has(slot))
      | grove_backend/fail[row[path]] prop.span
        "Conflicting metadata assignments."
    | grove_backend/property_slots lookup imports props.drop(1) seen.snoc(slot)
  + publish
    \ root=path identity=path defs=row[grove_backend/definition]
      slots=row[row[path]] result=grove_backend/compiled
    ^ row[[path myth]]
    % rest=row[grove_backend/definition] defs position=nat 0
      offset=nat 0 output=row[[path myth]] []
    ^ row[[path myth]]
    ? (eq rest.len 0) output
    = def rest.at(0)
      prefix=path [($ts def.name)]
      exports=mop[path grove_backend/entry lt_pith]
        | result.entries.tap.fold (mop/empty)
        \ out [key value]
        ? (equal key.take(1) prefix)
          | out.put key.drop(1) value
        out
      module
        | grove_backend/bundle grove_backend/version
          identity prefix exports result.artifact
      keys slots.at(position)
      card=row[[path pail]]
        | (row/range 0 keys.len).map
        \ i
        [keys.at(i) result.metadata.at((add offset i))]
      myth=myth
        | card.fold (mop/empty)
        \ out [key value]
        | out.put key value
      myth myth.put(grove_backend/module_slot module)
    | _ rest.drop(1) position.inc (add offset keys.len)
      output.snoc([root.weld(prefix) myth])
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove_backend/diagnostic grove/document]
    ? (grove_trees/prepare root doc lookup)
     > (./ok doc) (./ok doc)
     > (./err cause)
      ? cause
       > (grove/error/syntax span message)
        | grove_backend/fail[grove/document] span message
       > (grove/error/parser cause)
        | ./err (grove_backend/diagnostic rex/zero_span
            "Grove synthesis failed." (./some cause))
  + compile
    \ root=path doc=grove/document ports=grove_backend/ports
    ^ either[grove_backend/diagnostic row[[path myth]]]
    < doc (grove_backend/prepare root doc ports.lookup)
    < index (grove_backend/index_document doc)
    < slots (grove_backend/slots ports.lookup index.imports index.definitions)
    < imports (grove_backend/resolve ports index.imports)
    < tree (grove_backend/generate index)
    = identity root
      metas
        | index.definitions.bind
        \ def
        | (row/range 0 def.metadata.len).map
        \ i
        | grove_backend/meta_key def.name i
    = names=row[path]
        | index.definitions.map (\ def [($ts def.name)])
      request
        | grove_backend/request identity tree imports metas names.cons([])
    < result (ports.compile request)
    ? !(eq result.metadata.len metas.len)
      | grove_backend/fail[row[[path myth]]] rex/zero_span
        "Compiler returned an invalid metadata count."
    = records (grove_backend/publish root identity
        index.definitions slots result)
    < records (grove_backend/publication_records root index.definitions records)
    | ./ok (grove_backend/definition_records root result records)
  + compiled_from
    \ entries=row[[path grove_backend/entry]] metadata=row[pail]
      artifact=any definitions=row[[path nat type]]
    ^ grove_backend/compiled
    = table=mop[path grove_backend/entry lt_pith]
        | entries.fold (mop/empty)
        \ out [key value]
        | out.put key value
    | grove_backend/compiled table metadata artifact definitions
  + definition_records
    ' Every assigned definition, including nested nominal members, is
    ' navigable and carries its canonical descriptor and compiler artifact.
    \ root=path result=grove_backend/compiled records=row[[path myth]]
    ^ row[[path myth]]
    = table=axal[myth]
        | records.fold (axal/new[myth] .none)
          \ out [name card]
          | out.put name card
    = published
        | result.definitions.fold table
          \ out [relative prior description]
          = name | root.weld relative
            card
              ? out.dip(name).fil
               > (./some card) card
              myth/new
            exports=mop[path grove_backend/entry lt_pith]
              | result.entries.tap.fold (mop/empty)
                \ entries [key value]
                ? (pith_prefix relative key)
                  | entries.put key.drop(relative.len) value
                entries
            module
              | grove_backend/bundle grove_backend/version root
                  relative exports result.artifact
            card | card.put ['sys 'mold] (pails/ty description)
          | out.put name card.put(grove_backend/module_slot module)
    | published.tap
  + bindings
    \ dep=grove_backend/dependency
    ^ row[[path path]]
    | dep.module.exports.tap.map
    \ [name entry]
    [name.cons(($ts dep.alias)) entry.key]

  + publication_records
    ' Publish declarations and one reusable template, never instance data.
    \ root=path defs=row[grove_backend/definition]
      records=row[[path myth]]
    ^ either[grove_backend/diagnostic row[[path myth]]]
    % i=nat 0 out=row[[path myth]] [] seeds=row[[path myth]] []
      rules=row[[rex/source_span path grove_tree_rule]] []
    ^ either[grove_backend/diagnostic row[[path myth]]]
    ? (eq i records.len)
      < checked (grove_backend/check_seeds seeds rules)
      ? (eq seeds.len 0) (./ok out)
      = template (grove_template grove_templates/version
          (grove_backend/armor root.at(0) seeds rules))
        card (myth/sing grove_templates/slot template)
      | ./ok out.snoc([root card])
    = [path card] records.at(i)
      span defs.at(i).span
    ? card.get(grove_trees/marker)
     > (./some held)
      > seed=grove_tree_seed held
        | grove_backend/fail[row[[path myth]]] span
          "Invalid tree template marker."
      = path seed.path
        card card.del(grove_trees/marker)
        card card.del(grove_backend/module_slot)
      ? (seeds.any((\ [key val] (equal key path))))
        | grove_backend/fail[row[[path myth]]] span
          "Conflicting instance paths."
      = next
          ? seed.rule
           > (./some rule) rules.snoc([span path rule])
           > .none rules
      | _ i.inc out seeds.snoc([path card]) next
     > .none
      ? (out.any((\ [key val] (equal key path))))
        | grove_backend/fail[row[[path myth]]] span
          "Conflicting publication paths."
      | _ i.inc out.snoc([path card]) seeds rules
  + overlap
    \ base=path entry=[rex/source_span path grove_tree_rule]
    ^ bool
    = [at other norm] entry
    ? (equal other.take(base.len) base) .true
    | equal base.take(other.len) other
  + check_seeds
    \ seeds=row[[path myth]]
      rules=row[[rex/source_span path grove_tree_rule]]
    ^ either[grove_backend/diagnostic unit]
    ? (eq rules.len 0) (./ok [])
    = [span base rule] rules.at(0)
      overlap
        | row/any[[rex/source_span path grove_tree_rule]]
          (grove_backend/overlap base) rules.drop(1)
    ? overlap
      | grove_backend/fail[unit] span
        "Overlapping #like installations require norm composition."
    = subtree=axal[myth]
        | seeds.fold (axal/new[myth] .none)
        \ tree [path card]
        ? (equal path.take(base.len) base)
          | tree.put path.drop(base.len) card
        tree
    ? (rule.validate subtree)
     > (./some bad)
      | grove_backend/fail[unit] span
        (str/join "" ["Tree seed violates #like at "
          (path_show base.weld(bad))])
     > .none (grove_backend/check_seeds seeds rules.drop(1))
  + with_behavior
    \ reference=path card=myth
    ^ myth
    = refs=row[path]
        ?> (./some held) card.get(limb_slot) []
        ?> existing=kook held []
        existing.refs
    ? refs.has(reference) card
    | card.put limb_slot (kook refs.snoc(reference))
  + armor
    \ publisher=iota records=row[[path myth]]
      rules=row[[rex/source_span path grove_tree_rule]]
    ^ row[[path myth]]
    | records.map
    \ [path card]
    = card
        | rules.fold card
        \ card [span base rule]
        ? !(equal path.take(base.len) base) card
        = relative path.drop(base.len)
        = card
            ? (soma/at relative rule.spec)
             > (./some contract)
              | card.put ['sys 'lash] contract
             > .none card
        ? !(equal path base) card
        = spec (yoke lash/new rule.spec.kids
            (axal/new[fief] .none))
        = card card.put(publisher_vocabulary/spec spec)
        = card card.put(publisher_vocabulary/grove/like (pails/p rule.source))
        | grove_backend/with_behavior [publisher 'kook 'ward] card
    = card
        ? card.get(['sys 'tack])
         > (./some held)
          ? held
           > link=grove_instance_ref
            | grove_backend/with_behavior [publisher 'kook 'fresh] card
          card
        card
    [path card]

  + artifact_of
    \ card=myth
    ^ maybe[any]
    ?> (./some value) card.get(grove_backend/module_slot) .none
    ?> bundle=grove_backend/bundle value .none
    | ./some bundle.artifact

  + commit
    \ system=pin[row[[path nat]]] expected=row[[path nat]]
      records=row[[path myth]] now=nat block=nat state=namespace
    ^ either[iota namespace/committed]
    = names | expected.map (\ [name prior] name)
    < batch
      | publication_batch/prepare state.self names state.local
    = valid
        | expected.all
          \ [name prior]
          ?> (./some actual) batch.expected.dip(name).fil .false
          | eq actual prior
    ? !valid (./err 'stale_publication)
    = table
        | records.fold (axal/new[myth] .none)
          \ out [name card]
          | out.put name card
    ? !(eq table.tap.len records.len) (./err 'duplicate_definition)
    | batch.publish_namespace system table now block state
