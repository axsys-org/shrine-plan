-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_web_policy_result [order=60]
'  Quarantined compatibility policy for legacy window-control glyphs.  This is
'  bounded Web pronunciation, not semantic IR.
+  chat_foundry_web_policy_outer_controls
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'window 'control 'close] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span" [(weft/cls "traffic-light close")] [])] .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'window 'control 'minimize] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span" [(weft/cls "traffic-light minimize")] [])] .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'window 'control 'zoom] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "span" [(weft/cls "traffic-light maximize")] [])] .none)
    (chat_foundry_web_policy_result .false [] .none)
