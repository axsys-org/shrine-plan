- publisher_vocabulary
- grove_sewn

' Tree values share the declarations' compiler unit.
+ grove_trees
  + marker
    ^ path
    publisher_vocabulary/grove/seed
  + fail
    (@ a)
    \ span=rex/source_span message=str
    ^ either[grove/error a]
    | grove_roles/fail[a] span message
  + parse_path
    \ span=rex/source_span text=str
    ^ either[grove/error path]
    ? (eq text "/") (./ok [])
    = parts (str/split_byte 47 text)
    ? ((lt parts.len 2) || !(eq parts.at(0) ""))
      | grove_trees/fail[path] span "Expected an absolute tree path."
    ? (row/any[str] (\ part=str (eq part "")) parts.drop(1))
      | grove_trees/fail[path] span "Empty tree path segment."
    = relative (\ part=str ((eq part ".") || (eq part "..")))
    ? (row/any[str] relative parts.drop(1))
      | grove_trees/fail[path] span
          "Relative tree segments are invalid."
    ?> (./some path) (path_parse text)
      | grove_trees/fail[path] span "Invalid tree path segment."
    | ./ok path
  + reference
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      tree=rex
    ^ either[grove/error path]
    < parts (grove_roles/parts (rex/normalize tree))
    ? !(eq parts.len 1)
      | grove_trees/fail[path] tree.span "Expected declaration name."
    = name (str/from_atom (quip_val parts.at(0)))
    % rest=row[grove/item] doc.items
    ^ either[grove/error path]
    ? (eq rest.len 0)
      | grove_trees/fail[path] tree.span "Unknown declaration."
    ? rest.at(0)
     > (grove/declaration span nam body)
      ? nam
       > (grove/name/identifier text)
        ? !(eq name text) (_ rest.drop(1))
        ? !(grove_sewn/is_sewn body)
          | grove_trees/fail[path] tree.span
            "weft requires a sewn declaration."
        | ./ok root.weld(parts)
      | _ rest.drop(1)
     > (grove/import_decl span alias target)
      ? !(eq alias name) (_ rest.drop(1))
      < path (grove_roles/parts (rex/normalize target))
      ?> (./some card) (lookup path)
        | grove_trees/fail[path] tree.span "Missing sewn import."
      ?> (./some held) card.get(publisher_vocabulary/grove/sewn)
        | grove_trees/fail[path] tree.span "Imported weft is not sewn."
      ?> schema=grove_sewn_schema held
        | grove_trees/fail[path] tree.span "Invalid sewn schema."
      | ./ok path
    | _ rest.drop(1)
  + value
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      slot=path value=rex
    ^ either[grove/error rex]
    ? (equal[path] slot ['sys 'weft])
      < target (grove_trees/reference root doc lookup value)
      | ./ok (rex/paren [(rex/word "safe") (rex/word "1")
          (rex/rune "." [(rex/word "x")])
          (grove_roles/path_value target)])
    ? (equal[path] slot ['sys 'tack])
      ?> (./leaf span shape text) value
        | grove_trees/fail[rex] value.span "Expected a y-care tack."
      = parts (str/split_byte 47 text)
      ? ((lt parts.len 3) || !(eq parts.at(0) "'@") ||
          !(eq parts.at(1) "y") || !(eq parts.at(2) "%"))
        | grove_trees/fail[rex] span "Expected '@/y/%/path tack."
      < relative
        | grove_trees/parse_path span
          (str/join "/" parts.drop(3).cons((str/from_atom 0)))
      | ./ok (rex/paren [(rex/word "grove_instance_ref")
          (rex/rune "." [(rex/word "y")])
          (grove_roles/path_value relative)])
    ?> (./leaf span shape text) value
      | ./ok value
    ? !(equal value.leaf_kind (maybe/some[str] "word"))
      | ./ok value
    ? (nat/parse text)
     > (./some number)
      | ./ok (rex/paren [(rex/path ["pails" "n"]) value])
     > .none (./ok value)
  + has_property
    \ name=str props=row[grove/statement]
    ^ bool
    | props.any
    \ stmt
    ? stmt
     > (grove/property span key value)
      ? key
       > (./leaf at shape text) (eq name text)
      .false
    .false
  + body
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span path=path body=row[grove/statement]
    ^ either[grove/error row[grove/statement]]
    % rest=row[grove/statement] body props=row[grove/statement] []
      rule=maybe[rex] .none tagged=bool .false
    ^ either[grove/error row[grove/statement]]
    ? (eq rest.len 0)
      ? !tagged
        | grove_trees/fail[row[grove/statement]] span
          "Tree paths require @tree."
      = weft (grove_trees/has_property "/sys/weft" props)
        tack (grove_trees/has_property "/sys/tack" props)
      ? !(eq weft tack)
        | grove_trees/fail[row[grove/statement]] span
          "A view needs both weft and tack."
      = norm
          ? rule
           > (./some value)
            | rex/paren [(rex/path ["maybe" "some"]) value]
           > .none (rex/rune "." [(rex/word "none")])
        seed
          | rex/paren [(rex/word "grove_tree_seed")
              (grove_roles/path_value path) norm]
        mark=grove/statement
          | grove/property span (rex/cord (path_show publisher_vocabulary/grove/seed)) seed
      | ./ok [(grove/block span (grove/block_kind/meta)
          props.snoc(mark))]
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) props rule tagged)
     > (grove/tag at kind)
      ? !(equal kind (grove/tag_kind/tree))
        | grove_trees/fail[row[grove/statement]] at
          "Only @tree is valid on a tree path."
      | _ rest.drop(1) props rule .true
     > (grove/property at key val)
      < slot (grove_roles/slot root doc lookup key)
      ? ((equal[path] slot grove_trees/marker) ||
         (equal[path] slot publisher_vocabulary/grove/module) ||
         (equal[path] slot publisher_vocabulary/grove/like) ||
         (equal[path] slot publisher_vocabulary/grove/template) ||
         (equal[path] slot publisher_vocabulary/grove/source) ||
         (equal[path] slot publisher_vocabulary/spec) ||
         (equal[path] slot ['sys 'limb]) ||
         (equal[path] slot ['sys 'lash]))
        | grove_trees/fail[row[grove/statement]] at
          "Tree property collides with installation metadata."
      < value (grove_trees/value root doc lookup slot val)
      = prop=grove/statement
          | grove/property at (rex/cord (path_show slot))
              value.with_span(val.span)
      | _ rest.drop(1) props.snoc(prop) rule tagged
     > (grove/directive at kind target)
      ? !(equal kind (grove/directive_kind/like))
        | grove_trees/fail[row[grove/statement]] at
          "Only #like is valid on tree declarations."
      ? rule
       > (./some old)
        | grove_trees/fail[row[grove/statement]] at "Duplicate #like."
       > .none
        < norm (grove_sewn/resolve root doc lookup target)
        = value
            | rex/paren [(rex/word "grove_tree_rule")
              (grove_roles/path_value norm.path)
              (grove_roles/member ["validate"] norm.reference)
              (grove_roles/member ["spec"] norm.reference)]
        | _ rest.drop(1) props (./some value) tagged
    | grove_trees/fail[row[grove/statement]] span
      "Tree bodies contain properties, comments, and #like."
  + check_metadata
    \ root=path doc=grove/document lookup={\ path}maybe[myth] body=row[grove/statement]
    ^ either[grove/error unit]
    ? (eq body.len 0) (./ok [])
    ? body.at(0)
     > (grove/block span kind props)
      ? (equal kind (grove/block_kind/meta))
        < checked (grove_trees/check_properties root doc lookup props)
        | grove_trees/check_metadata root doc lookup body.drop(1)
      | grove_trees/check_metadata root doc lookup body.drop(1)
    | grove_trees/check_metadata root doc lookup body.drop(1)
  + check_properties
    \ root=path doc=grove/document lookup={\ path}maybe[myth] props=row[grove/statement]
    ^ either[grove/error unit]
    ? (eq props.len 0) (./ok [])
    ? props.at(0)
     > (grove/property span key value)
      < slot (grove_roles/slot root doc lookup key)
      ? (equal slot grove_trees/marker)
        | grove_trees/fail[unit] span
          "Metadata collides with the reserved tree marker."
      | grove_trees/check_properties root doc lookup props.drop(1)
    | grove_trees/check_properties root doc lookup props.drop(1)
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=row[grove/item] doc.items out=row[grove/item] []
      count=nat 0
    ^ either[grove/error grove/document]
    ? (eq rest.len 0)
      | grove_sewn/prepare_all root (grove/document out) lookup
    ?> (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.snoc(rest.at(0)) count
    < checked (grove_trees/check_metadata root doc lookup body)
    ?> (grove/name/tree_path text) name
      | _ rest.drop(1) out.snoc(rest.at(0)) count
    < path (grove_trees/parse_path span text)
    < next (grove_trees/body root doc lookup span path body)
    = name (str/join "" ["grove_tree_" (nat/show count)])
    | _ rest.drop(1)
      out.snoc((grove/declaration span
        (grove/name/identifier name) next)) count.inc
