- commitment

+ development
  + candidate
    (@@ implementation)
    : subject=path basis=nat revision=nat implementation=implementation
      intent=str examples=row[commitment/retained[implementation]]

  + installed
    (@@ implementation)
    : subject=path revision=nat implementation=implementation
      commitments=row[commitment/retained[implementation]]

  + assess
    (@ implementation)
    \ live=development/installed[implementation] candidate=development/candidate[implementation]
    ^ row[commitment/finding]
    ' Both existing promises and the proposed demonstrations must hold.
    | commitment/assess[implementation]
        live.commitments.weld(candidate.examples) candidate.implementation

  + publish
    (@ implementation)
    \ approved_revision=nat complete=bool
      live=development/installed[implementation] candidate=development/candidate[implementation]
    ^ either[str development/installed[implementation]]
    ? !(equal live.subject candidate.subject) (./err "Candidate belongs to another subject.")
    ? !(eq candidate.basis live.revision) (./err "The installed basis changed. Reassess this candidate.")
    ? !(eq approved_revision candidate.revision) (./err "Approve the exact candidate revision.")
    = retained live.commitments.weld(candidate.examples)
    ? !(commitment/unique[implementation] retained) (./err "Commitment identities must remain unique.")
    = findings (development/assess[implementation] live candidate)
    ? !(commitment/admissible complete findings) (./err "Required commitments are failed, unknown or incompletely evaluated.")
    | ./ok (development/installed[implementation] live.subject live.revision.inc
        candidate.implementation retained)
