-  sept [order=10]
-  weft [order=20]
'  surface: the renderer-local visual vocabulary shared by Foil/Weft
'  faces.  It owns CSS and passive shell ornaments only: no namespace
'  state, projection authority, action semantics, or client runtime.
+  surface
  +  css
    '  A compact light Shrine surface system adapted from the useful
    '  visual foundations in JShrine: neutral canvases, bounded plates,
    '  translucent chrome, semantic focus, and restrained elevation.
    '  Every rule is emitted inline by Weft; no asset or runtime import.
    ^  nat
    (weft/cat
      [":root{color-scheme:light;--surface-font:'SF Pro Text','SF Pro Display',-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;--surface-ink:#202124;--surface-muted:#74777c;--surface-faint:#a3a6aa;--surface-line:rgb(40 43 48/.12);--surface-line-strong:rgb(40 43 48/.2);--surface-panel:rgb(249 250 251/.82);--surface-raised:rgb(255 255 255/.78);--surface-canvas:#f4f5f6;--surface-workspace:#e8eaed;--surface-blue:#1769e0;--surface-green:#21a664;--surface-amber:#e3a525;--surface-red:#ef4054;--surface-sidebar:clamp(230px,22vw,330px)}"
       "*{box-sizing:border-box}html,body{min-height:100%}body{margin:0;background:var(--surface-workspace);color:var(--surface-ink);font:13px/1.45 var(--surface-font);font-synthesis:none}button,input{font:inherit}button{color:inherit}a{color:inherit}button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--surface-blue);outline-offset:2px}"
       ".surface-page{min-height:100vh;padding:12px;background:radial-gradient(circle at 18% 8%,rgb(255 255 255/.78),transparent 30rem),linear-gradient(145deg,#d8dee4,#eef0f2 52%,#d4dae0)}"
       ".surface-nav{position:relative;z-index:100;display:flex;max-width:1120px;align-items:center;gap:5px;margin:0 auto 10px;padding:4px;border:1px solid rgb(255 255 255/.72);border-radius:999px;background:rgb(249 250 251/.68);box-shadow:0 5px 18px rgb(35 40 47/.09);backdrop-filter:blur(18px) saturate(1.18);-webkit-backdrop-filter:blur(18px) saturate(1.18)}"
       ".surface-nav>a{padding:6px 11px;border-radius:999px;color:var(--surface-muted);font-size:11px;text-decoration:none}.surface-nav>a:hover{background:rgb(255 255 255/.7);color:var(--surface-ink)}.surface-nav>a[aria-current=page]{background:#fff;color:var(--surface-ink);box-shadow:0 2px 8px rgb(35 40 47/.08)}"
       ".specimen-frame{max-width:1120px;min-height:700px;margin:0 auto;overflow:hidden;border:1px solid rgb(255 255 255/.74);border-radius:18px;background:rgb(238 240 242/.72);box-shadow:0 24px 70px rgb(39 45 52/.18)}.specimen-caption{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:10px 14px;border-bottom:1px solid var(--surface-line);background:rgb(255 255 255/.52)}.specimen-caption strong{font-size:12px}.specimen-caption span{color:var(--surface-muted);font-size:10px}"
       ".scene-shell{display:grid;width:100%;height:100%;min-height:0;grid-template-columns:var(--surface-sidebar) minmax(0,1fr);grid-template-rows:34px minmax(0,1fr);gap:6px;padding:4px}.scene-chrome{grid-column:1/-1;display:flex;min-width:0;align-items:center;gap:8px}.scene-chrome-title{min-width:0;flex:1;padding:0 6px;color:var(--surface-muted);font-size:10px}.scene-chrome-title strong{color:var(--surface-ink);font-size:11px}.scene-sidebar{grid-column:1;grid-row:2;min-width:0;min-height:0;padding:10px;overflow:auto;border:1px solid rgb(255 255 255/.52);border-radius:24px;background:rgb(255 255 255/.28);box-shadow:0 7px 18px rgb(0 0 0/.1),inset 0 0 0 1px rgb(255 255 255/.08);backdrop-filter:blur(20px) saturate(1.12);-webkit-backdrop-filter:blur(20px) saturate(1.12)}.scene-workspace{grid-column:2;grid-row:2;min-width:0;min-height:0;padding:8px;overflow:auto}"
       ".sidebar-heading{margin:4px 6px 8px;color:var(--surface-muted);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.sidebar-item{display:grid;grid-template-columns:28px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;padding:7px;border-radius:10px;color:var(--surface-muted);text-decoration:none}.sidebar-item:hover{background:rgb(255 255 255/.45);color:var(--surface-ink)}.sidebar-item.active{background:rgb(255 255 255/.72);box-shadow:inset 0 0 0 1px rgb(35 40 47/.05);color:var(--surface-ink)}.sidebar-glyph{display:grid;width:28px;height:28px;place-items:center;border-radius:8px;background:#252a30;color:#fff;font-size:10px;font-weight:750}.sidebar-copy{display:grid;min-width:0}.sidebar-copy strong{font-size:11px}.sidebar-copy small{overflow:hidden;color:var(--surface-muted);font-size:9px;text-overflow:ellipsis;white-space:nowrap}.sidebar-badge{color:var(--surface-faint);font-size:9px}"
       ".plate{overflow:hidden;border:1px solid rgb(35 40 47/.16);border-radius:9px;background:#fbfbfa;box-shadow:0 8px 24px rgb(35 40 47/.08)}.plate[data-active=true]{border-color:rgb(23 105 224/.48);box-shadow:0 8px 24px rgb(35 40 47/.1),0 0 0 1px rgb(23 105 224/.12)}.plate-header{display:grid;min-width:0;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:8px;padding:9px 10px;border-bottom:1px solid var(--surface-line)}.plate-header-copy{display:grid;min-width:0;gap:1px}.plate-header strong{font-size:12px}.plate-header small,.plate-header code{overflow:hidden;color:var(--surface-muted);font-size:9px;text-overflow:ellipsis;white-space:nowrap}.plate-kind{display:grid;width:30px;height:30px;place-items:center;border:1px solid rgb(255 255 255/.8);border-radius:8px;background:rgb(255 255 255/.58);box-shadow:0 2px 8px rgb(35 43 52/.08);font-size:12px;font-weight:750}"
       ".traffic-lights{display:flex;width:79px;height:27px;flex:0 0 79px;align-items:center;gap:6px;padding:8px;border:1px solid rgb(255 255 255/.5);border-radius:16px;background:rgb(255 255 255/.2);box-shadow:0 3px 10px rgb(0 0 0/.1),inset 0 0 0 1px rgb(255 255 255/.08);backdrop-filter:blur(18px) saturate(1.16);-webkit-backdrop-filter:blur(18px) saturate(1.16)}.traffic-light{display:block;width:11px;height:11px;flex:0 0 11px;border-radius:50%}.traffic-light.close{background:#ff5f57}.traffic-light.minimize{background:#ffbd2e}.traffic-light.maximize{background:#28c840}.traffic-light.extra{background:rgb(48 55 62/.14)}"
       ".window-chrome{display:flex;height:38px;align-items:center;gap:10px;padding:5px 8px;border-bottom:1px solid var(--surface-line);background:rgb(249 250 251/.78)}.window-title{min-width:0;flex:1;text-align:center}.window-title strong{display:block;font-size:11px}.window-title small{display:block;overflow:hidden;color:var(--surface-muted);font-size:8px;text-overflow:ellipsis;white-space:nowrap}.window-spacer{width:79px;flex:0 0 79px}.scene-plate-window{width:min(980px,calc(100% - 32px));height:min(660px,calc(100% - 32px));min-height:480px;overflow:hidden;border:1px solid rgb(35 40 47/.17);border-radius:12px;background:rgb(249 250 250/.98);box-shadow:0 24px 64px rgb(0 0 0/.24)}.window-content{height:calc(100% - 38px);min-height:0;overflow:hidden}"
       ".root-scene{display:grid;min-height:700px;place-items:center;padding:26px;background:linear-gradient(180deg,rgb(255 255 255/.16),transparent 26%),#cfd5db}.desktop-stage{position:relative;min-height:700px;overflow:hidden;background:radial-gradient(circle at 30% 5%,#8292a2,transparent 42%),linear-gradient(145deg,#586877,#2e3943 68%,#222b33)}.stage-window{position:absolute;top:42px;left:6%;width:min(900px,76%);height:610px;overflow:hidden;border:1px solid rgb(255 255 255/.5);border-radius:12px;background:rgb(249 250 250/.98);box-shadow:0 28px 80px rgb(0 0 0/.36);resize:both}.stage-window.secondary{z-index:0;top:128px;right:4%;left:auto;width:34%;height:430px;opacity:.78}.stage-window.primary{z-index:2}.stage-note{display:grid;height:calc(100% - 38px);place-items:center;padding:24px;color:var(--surface-muted);text-align:center}.stage-note strong{display:block;margin-bottom:5px;color:var(--surface-ink)}"
       "@media(max-width:760px){.surface-page{padding:5px}.surface-nav{overflow-x:auto;border-radius:12px}.specimen-frame{min-height:620px;border-radius:12px}.scene-shell{grid-template-columns:1fr;grid-template-rows:34px auto minmax(0,1fr)}.scene-sidebar{grid-column:1;grid-row:2;display:flex;gap:4px;border-radius:12px}.sidebar-heading{display:none}.sidebar-item{min-width:150px}.scene-workspace{grid-column:1;grid-row:3}.scene-plate-window{width:calc(100% - 12px);height:calc(100% - 12px);min-height:500px}.root-scene,.desktop-stage{min-height:620px}.stage-window.primary{top:18px;left:2%;width:96%;height:580px}.stage-window.secondary{display:none}}"
       "@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}"])

  +  traffic_lights
    '  Passive traffic-light ornament.  Actions belong to the serving
    '  projection; this shared visual primitive deliberately emits no
    '  callbacks, URLs, or ambient window behavior.
    ^  weft/node
    (weft/el "span"
      [(weft/cls "traffic-lights") (weft/att "aria-hidden" "true")]
      [(weft/el "span" [(weft/cls "traffic-light close")] [])
       (weft/el "span" [(weft/cls "traffic-light minimize")] [])
       (weft/el "span" [(weft/cls "traffic-light maximize")] [])
       (weft/el "span" [(weft/cls "traffic-light extra")] [])])

  +  window_chrome
    '  Passive serving-environment chrome for a nested Scene Plate.
    '  The title is projection context, not source ownership.
    \  title=nat subtitle=nat
    ^  weft/node
    (weft/el "header" [(weft/cls "window-chrome")]
      [surface/traffic_lights
       (weft/el "span" [(weft/cls "window-title")]
         [(weft/leaf "strong" [] title)
          (weft/leaf "small" [] subtitle)])
       (weft/el "span" [(weft/cls "window-spacer")] [])])

  +  plate_header
    '  Passive Web pronunciation of the shared Plate Header Block.  Slot
    '  ordering and attachment admission have already been resolved by
    '  Foundry; this adapter only wraps the admitted children.
    \  children=row[weft/node]
    ^  weft/node
    (weft/el "header" [(weft/cls "plate-header")] children)
