- helm

' Opt-in materialization of an existing /o application. The ordinary lens
' dependency machinery handles source care, pinned functions and nested lenses.
' Cache records live outside their input subtrees and are not authoritative data.
+ overlay_cache
  + source_slot
    ^ path
    ['sys 'overlay_cache 'source]
  + result_slot
    ^ path
    ['sys 'overlay_cache 'result]
  + result
    : tree=pin[axal[myth]]
  + value
    \ record=myth
    ^ axal[myth]
    ?> (./some held) record.get(overlay_cache/result_slot) (axal/new[myth] .none)
    ?> cached=overlay_cache/result held (axal/new[myth] .none)
    | unpin cached.tree
  + bind
    \ record=myth
    ^ myth
    = source (record.path_at(overlay_cache/source_slot)).fall([])
    | record.put crew_slot (cpail (crew/sing ['overlay] (dep .z source)))
  + schedule
    \ b=bowl record=myth
    ^ yell
    | yell [[b.here (writ/poke myth/new)]] (overlay_cache/bind record)
  + refresh
    \ b=bowl record=myth
    ^ yell
    = tree (b.crew.gut(['overlay] (axal/new[myth] .none)))
    | yell [] (record.put(overlay_cache/result_slot (overlay_cache/result (pin tree))))
  + talk
    \ b=bowl cur=myth add=myth
    ^ yell
    = next (overlay_cache/bind (cur.meld(add)))
    ? !(equal (cur.get(crew_slot)) (next.get(crew_slot)))
      | overlay_cache/schedule b next
    | overlay_cache/refresh b next
  + hear
    \ b=bowl cur=myth changed=row[dep]
    ^ yell
    | overlay_cache/refresh b cur
  + form
    ^ form
    | def_form.set_init(overlay_cache/schedule).set_talk(overlay_cache/talk).set_hear(overlay_cache/hear)
  + card
    \ behavior=path source=path
    ^ myth
    | overlay_cache/bind
      | (kooked [behavior]).put overlay_cache/source_slot (pails/p source)
  + path
    ' A complete, pinned /o application; input remains live.
    \ version=nat transform=path input=path
    ^ path
    = prefix=path ['o ($u version) ($u transform.len)]
    | prefix.weld(transform).snoc(($u input.len)).weld(input)
  + install
    ' Prime the cache in the same event that creates it. Subsequent source
    ' changes refresh it before the supervisor acknowledges the source write.
    \ target=path source=path state=namespace
    ^ either[iota namespace]
    ? (maybe/is_none (o_parse source)) (./err 'invalid_overlay_path)
    ? !(sovereign_observer target state) (./err 'invalid_cache_target)
    = triggers (o_trigger_reader source (sovereign_reader state))
    ? (triggers.any((\ dependency (pith_prefix dependency.p target))))
      | ./err 'cache_inside_source
    = behavior=path [state.self 'kook 'overlay_cache]
      [next index reply]
        | helm/supervisor/handle
          (helm/card/step behavior
            (writ/make (form/card overlay_cache/form (lore/line "Cached overlay"))))
          state (sovereign_hive state)
    ?> (./ack failure) reply (./err 'cache_behavior_failed)
    ? (maybe/is_some failure) (./err 'cache_behavior_failed)
    = [next index reply]
        | helm/supervisor/handle
          (helm/card/step target (writ/make (overlay_cache/card behavior source)))
          next index
    ?> (./ack failure) reply (./err 'cache_install_failed)
    ? (maybe/is_some failure) (./err 'cache_install_failed)
    | ./ok next
