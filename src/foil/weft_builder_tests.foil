-  weft
'  Builder integration against Weft's existing node ABI and renderer.
+  weft_builder_card
  \ enabled=bool names=row[nat]
  ~ weft/build
  ~# 'section.card#main
    'aria-label "A&B"
    ~. 'h2 "Hello " "world"
    ? enabled
      ~. 'p "Enabled"
    | ~. 'p "Disabled"
    ~| 'ul
      % name names
        ~# 'li
          'data-name name
          ~. name
    [(weft/lnk "/a?x=1&y=2" "go <now>")]
    ~# 'input
      'disabled 0
+  weft_builder_fragment
  \ show=bool
  ~ weft/build
  ~|
    ? show
      ~. "visible"
    ~. "tail"
+  weft_builder_bad
  ~ weft/build
  ~| "p."
+  weft_builder_empty
  ~ weft/build
  ~|
