-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain_types [order=38]
-  lain_peek [order=39]
-  lain_poke [order=40]
-  pact [order=60]
'  Installation policy over a discovered, compiled app catalog.
'  authority and namespace records are decided here.
+  app_grant
  : name=text fetch=bool serve=bool
+  app_policy
  & app_policy/all app_policy/only
  +  all
    :
  +  only
    : grants=row[app_grant]
+  app_manifest
  & app_manifest/ready app_manifest/failed
  +  ready
    : manifest=mani
  +  failed
    : reason=text
+  app_catalog_entry
  : name=text result=app_manifest
+  app_install
  +  grants
    \ policy=app_policy name=text fetch=bool port=nat
    ^ [fetch=bool port=nat]
    ? policy
     > .all [fetch port]
     > (./only grants)
       % index=nat 0
       ^ [fetch=bool port=nat]
       ? (eq index grants.len) [0 0]
       = grant grants.at(index)
       ? !(equal name grant.name) (_ index.inc)
       [(? grant.fetch fetch 0) (? grant.serve port 0)]
  +  card
    \ catalog=row[app_catalog_entry] policy=app_policy input=myth
    ^ myth
    = name input.txt_at(['app])
    ? !(wid name) (pact/fail "install: missing ['app] name")
    = empty=maybe[app_manifest] .none
    = hit=maybe[app_manifest]
        | catalog.fold empty
        \ found entry
        ? found
         > (./some _) found
         > .none
           ? (equal entry.name name) (./some entry.result)
           .none
    ? hit
     > .none
       | pact/fail
       | str/from_atom
       | cord/cat_all ["install: unknown app " name
         " (apps are discovered at boot)"]
     > (./some result)
       ? result
        > (./failed reason) (pact/fail reason)
        > (./ready manifest)
          = [fetch port]
              | app_install/grants policy name
                (grant/has_fetch manifest.wants)
                (grant/serve_port manifest.wants)
          = module
              | str/from_atom
              | cord/cat_all ["apps/" name "/main"]
          | pact/card manifest module fetch port
  +  root
    \ roots=row[[name=text target=path]] name=text
    ^ path
    % index=nat 0
    ^ path
    ? (eq index roots.len) ['app ($ts name)]
    = [key target] roots.at(index)
    ? (equal key name) target
    | _ index.inc
+  app_compiled
  : cache=any manifest=maybe[mani] spec=maybe[yoke]
+  app_build
  : cache=any result=app_manifest
+  app_attempt
  & app_attempt/ready app_attempt/failed
  +  ready
    : value=app_build
  +  failed
    : reason=text
+  app_compile_ports
  : read={\ text}text
    code={\ any text}app_compiled
    grove={\ any text text}app_compiled
    attempt={\ {\ nat}app_build}app_attempt
+  app_compile
  +  assemble
    \ code=maybe[mani] spec=maybe[yoke] tree=maybe[mani]
    ^ app_manifest
    ? code
     > .none
       ? tree
        > .none (./failed "no-app-mani")
        > (./some manifest) (./ready manifest)
     > (./some manifest)
       ? tree
        > .none
          ? spec
           > (./some shape)
             | ./ready | mani/adopt_spec shape manifest
          | ./ready manifest
        > (./some other)
          ? spec
           > (./some shape)
             | ./ready | mani/weld_spec shape other manifest
          | ./failed "spec manifest has no yoke"
  +  build
    \ ports=app_compile_ports cache=any name=text
    ^ app_build
    = module | str/from_atom | cord/cat_all ["apps/" name "/main"]
      root | cord/cat_all ["foil/" module]
      gpath | str/from_atom | cord/cat_all [root ".grove"]
      fpath | str/from_atom | cord/cat_all [root ".foil"]
      gsrc (ports.read gpath)
      fsrc (ports.read fpath)
      base=app_compiled
        ? (wid fsrc) (ports.code cache module)
        | app_compiled cache .none .none
      spec=app_compiled
        ? (wid gsrc) (ports.grove base.cache name gsrc)
        | app_compiled base.cache .none .none
    | app_build spec.cache
    | app_compile/assemble base.manifest spec.spec spec.manifest
  +  one
    \ ports=app_compile_ports cache=any name=text
    ^ app_build
    = invoke ports.attempt
      result
        | invoke
        \ _=nat
        | app_compile/build ports cache name
    ? result
     > (./failed reason) (app_build cache (./failed reason))
     > (./ready built)
       ? built.result
        > (./failed reason) (app_build cache (./failed reason))
       built
  +  many
    \ ports=app_compile_ports cache=any names=row[text]
    ^ [cache=any catalog=row[app_catalog_entry]]
    | names.fold [cache []]
    \ [current catalog] name
    = built | app_compile/one ports current name
    [built.cache catalog.snoc((app_catalog_entry name built.result))]
