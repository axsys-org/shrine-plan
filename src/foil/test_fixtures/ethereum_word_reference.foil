- ethereum_word

+ ethereum_word_reference
  ' Test adapter only: compare the Foil helpers with restricted PLAN's result
  ' convention without changing either module's public representation.
  + encode
    \ result=either[ethereum_word/fault nat]
    ^ row[nat]
    ? result
     > (./ok n) [0 n]
     > (./err fault)
      ? fault
       > .range [1 1]
       > .overflow [1 2]
       > .underflow [1 3]
       > .zero_divisor [1 4]
  + plus
    \ a=nat b=nat
    ^ row[nat]
    | ethereum_word_reference/encode (ethereum_word/add_checked a b)
  + minus
    \ a=nat b=nat
    ^ row[nat]
    | ethereum_word_reference/encode (ethereum_word/sub_checked a b)
  + times
    \ a=nat b=nat
    ^ row[nat]
    | ethereum_word_reference/encode (ethereum_word/mul_checked a b)
  + quotient
    \ a=nat b=nat
    ^ row[nat]
    | ethereum_word_reference/encode (ethereum_word/div_checked a b)
