- rex
'  Executable counterpart of doc/foil-rex.md.
+ rex_example
  + rename
    \ tree=rex
    ^ rex
    ? tree
     > (./leaf span shape text)
      ? (eq text "old")
        ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "word"))
          | (rex/word "new").with_span span
        tree
      tree
    tree
  + generated
    ^ rex
    | rex/rune "+" [(rex/word "answer") (rex/word "42")]
  + rewrite_add
    \ source=str
    ^ either[any str]
    < tree (rex/parse source)
    = renamed | tree.walk rex_example/rename
      added | rex/open rex/zero_span "+" (rex/children rex_example/generated)
    | ./ok (rex/heir rex/zero_span [renamed added]).print

+ rex_ffi
  + parse
    \ text=str
    ^ either[any rex]
    | rex/parse text
  + parse_block
    \ text=str
    ^ either[any rex]
    | rex/parse_block text
  + normalize
    \ tree=rex
    ^ rex
    | rex/normalize tree
  + print
    \ tree=rex
    ^ str
    | rex/print tree
