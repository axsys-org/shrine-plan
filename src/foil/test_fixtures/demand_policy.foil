- sys/demand

' A published policy depends on the constructor contract, not the interpreter
' or a kernel registry. Its selected input and fallback are ordinary policy.
+ demand_policy
  + selected
    \ context=myth cr=care relative=path selection=view_select
    ^ view_plan
    ?> (./some held) context.get(['source]) (view_plan/fail "missing source")
    ?> source=safe held (view_plan/fail "invalid source")
    | view_plan/need (view_read source (view_select/slots [['value]]))
      \ observed=res[axal[myth]]
      ^ view_plan
      ? observed
       > (./known tree) (view_plan/done tree)
      | view_plan/done (axal/new[myth] (./some (myth/sing ['value] (pails/n 0))))
  + graft
    \ context=myth cr=care relative=path selection=view_select
    ^ view_plan
    ?> (./some held) context.get(['source]) (view_plan/fail "missing source")
    ?> source=safe held (view_plan/fail "invalid source")
    | view_plan/graft source
