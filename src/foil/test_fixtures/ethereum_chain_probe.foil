- ethereum_rpc
+ probe
  \ endpoint=nat contract=nat number=nat
  ^ row[nat]
  = rpc (str/from_atom endpoint)
    address (str/from_atom contract)
    ;chain (ethereum_rpc/number (ethereum_rpc/request rpc "eth_chainId" []))
    ;code (ethereum_rpc/text (ethereum_rpc/request rpc "eth_getCode" [(json/str address) (json/str "latest")]))
    ;header (ethereum_rpc/block rpc number)
    filter
      | json/obj [(jkv "address" (json/str address))
        (jkv "fromBlock" (json/str (ethereum_transaction/quantity number)))
        (jkv "toBlock" (json/str (ethereum_transaction/quantity number)))
        (jkv "topics" (json/arr [(json/str (ethereum_keccak/hex (ethereum_bytes/ascii "Result(uint256,uint256)")))]))]
    ;logs (ethereum_rpc/array (ethereum_rpc/request rpc "eth_getLogs" [filter]))
  [chain (str/to_atom (ethereum_keccak/hex (ethereum_bytes/unhex code)))
   (str/to_atom (ethereum_rpc/text (ethereum_rpc/get "hash" header)))
   (str/to_atom (show (json/arr logs)))]
