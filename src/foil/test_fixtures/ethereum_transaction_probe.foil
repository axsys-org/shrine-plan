- ethereum_transaction
+ probe
  \ nonce=nat payload=nat parity=nat r=nat s=nat
  ^ row[nat]
  = tx (ethereum_transaction 11155111 nonce 1000000000 3000000000 100000 "0x1111111111111111111111111111111111111111" (str/from_atom payload))
  [(str/to_atom (ethereum_transaction/digest tx)) (str/to_atom (ethereum_transaction/signed tx parity r s))]
