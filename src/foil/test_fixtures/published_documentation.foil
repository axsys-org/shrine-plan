- compiler_publication

+ documented
  ' A published heading.
  ' A published body with café and λ.
  ' ?= ((add 1 1) 2)
  ^ nat
  7
+ undocumented
  ^ nat
  9
+ publication_documentation_checks
  \ state=namespace
  ^ row[[str bool]]
  = record
      \ target=path
      ^ myth
      | (sovereign_peek target state).fil.fall(myth/new)
    about (record ['sys 'about])
    catalog slot_documentation/entries
    local=path [state.self 'lib ($ts "test_fixtures/published_documentation")]
    documented (record local.snoc('documented))
    undocumented (record local.snoc('undocumented))
    stored
      \ card=myth
      ^ lore
      ?> (./some held) card.get(bond/help) (lore "" [] [])
      ?> doc=lore held (lore "" [] [])
      doc
    sys_doc (stored about)
    local_doc (stored documented)
    catalog_valid
      | catalog.all
        \ [name title summary]
        = card (record name)
          doc (stored card)
        | (and (eq card.size 2)
            (and (equal[str] card.txt_at(bond/lede) title)
              (and (equal[str] doc.head "") (equal[row[str]] doc.body [summary]))))
    owner=iota state.self
    slot=path [state.self 'compiler 'artifact]
    name=path [state.self 'doc_revision]
    publish
      \ prior=nat doc=row[[str row[str] row[[str str]]]] state=sov
      ^ either[iota sov]
      | compiler_publication/publish slot owner [[name prior (^ nat) (pin[any] 0) doc]] 0 0 state
    unwrap
      \ result=either[iota sov]
      ^ sov
      ?> (./ok state) result sov/new
      state
    first (publish 0 [["First" ["First" "Body"] [["example" "result"]]]] sov/new)
    first (unwrap first)
    revised (publish 1 [["Revised" ["Revised"] []]] first)
    revised (unwrap revised)
    cleared (publish 2 [] revised)
    cleared (unwrap cleared)
    read
      \ state=sov
      ^ myth
      ?> (./known card) state.x_latest(name) myth/new
      card
    revised_card (read revised)
    cleared_card (read cleared)
  [["system lede is stored" (equal[str] about.txt_at(bond/lede) "About")]
   ["all catalog slots contain only their authored documentation" catalog_valid]
   ["slot records have no type descriptor" !(about.has(bond/mold))]
   ["slot records have no compiler artifact" !(about.has(slot))]
   ["system types retain compiler metadata" (record ['sys 'types 'nat]).has(bond/mold)]
   ["ordinary definitions retain compiler metadata" (and documented.has(bond/mold) documented.has(slot))]
   ["system help is stored lore" (equal[row[str]] sys_doc.body ["Subject described by this record."])]
   ["system help has no title" (equal[str] sys_doc.head "")]
   ["local lede is stored" (equal[str] documented.txt_at(bond/lede) "A published heading.")]
   ["local help preserves body" (equal[row[str]] local_doc.body ["A published body with café and λ."])]
   ["local help has no title" (equal[str] local_doc.head "")]
   ["local help preserves examples" (eq local_doc.tests.len 1)]
   ["undocumented definition has no synthetic prose" (and !(undocumented.has(bond/lede)) !(undocumented.has(bond/help)))]
   ["republishing changes stored prose" (equal[str] revised_card.txt_at(bond/lede) "Revised")]
   ["republishing replaces full lore" (eq (stored revised_card).tests.len 0)]
   ["title-only comments leave help body empty" (eq (stored revised_card).body.len 0)]
   ["removing comments removes stale prose" (and !(cleared_card.has(bond/lede)) !(cleared_card.has(bond/help)))]
   ["stale publication still rejected" (either/is_err (publish 0 [] first))]]
