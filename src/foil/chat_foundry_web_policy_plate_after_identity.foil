-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_web_policy_result [order=50]
-  chat_foundry_web_policy_plate_interaction [order=60]
'  Terminal continuation of the ordered Plate compatibility policy.  The heavy
'  interaction graph stays behind this narrow dispatcher boundary.
+  chat_foundry_web_policy_plate_after_identity
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    (chat_foundry_web_policy_plate_interaction/plan_policy occurrence children)
