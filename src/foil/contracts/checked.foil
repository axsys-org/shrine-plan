- contract

+ program
  ' A zero denominator selects zero without evaluating the division branch.
  ' Otherwise compute (a * b + 7) / denominator with checked intermediates.
  ^ any
  | contract/export 3
    (contract/expr/choose
      (contract/expr/equals (contract/expr/arg 2) (contract/expr/lit 0))
      (contract/expr/lit 0)
      (contract/expr/quotient
        (contract/expr/plus
          (contract/expr/times (contract/expr/arg 0) (contract/expr/arg 1))
          (contract/expr/lit 7))
        (contract/expr/arg 2)))
