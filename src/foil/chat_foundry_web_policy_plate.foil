-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_header [order=50]
-  chat_foundry_web_policy_result [order=60]
-  chat_foundry_web_policy_plate_identity [order=70]
-  chat_foundry_web_policy_plate_after_identity [order=80]
'  Ordered dispatcher for quarantined compatibility policy covering the Chat
'  Plate, title, status, messages, and Composer roles.
+  chat_foundry_web_policy_plate
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence
       children=row[weft/node] header_style=chat_foundry_header/header_text_style
    ^  chat_foundry_web_policy_result
    =  identity
         (chat_foundry_web_policy_plate_identity/plan_policy
           occurrence children header_style)
    ?  identity.matched  identity
    (chat_foundry_web_policy_plate_after_identity/plan_policy
      occurrence children)
