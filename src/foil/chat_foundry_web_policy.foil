-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_header [order=50]
-  chat_foundry_web_policy_result [order=60]
-  chat_foundry_web_policy_outer [order=70]
-  chat_foundry_web_policy_after_outer [order=80]
'  Top orchestrator for quarantined Chat-specific Web role and Hole
'  compatibility policy.  It consumes canonical occurrence evidence and
'  bounded Header attributes, but does not resolve foundations or traverse the
'  pronunciation tree.
+  chat_foundry_web_policy
  +  plan_policy
    '  Product content is keyed by semantic role.  Shared Block anatomy is
    '  keyed by its admitted template identity and pronounced by /surface;
    '  title Text consumes the separately resolved Header Text Style.
    \  occurrence=projection_pronunciation_occurrence
       children=row[weft/node] header_style=chat_foundry_header/header_text_style
    ^  [nodes=row[weft/node] code=maybe[iota]]
    =  outer
         (chat_foundry_web_policy_outer/plan_policy occurrence children)
    ?  outer.matched  [outer.nodes outer.code]
    (chat_foundry_web_policy_after_outer/plan_policy
      occurrence children header_style)
