-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
'  Closed Web-provider lowering for Chat foundations.  Semantic token refs and
'  provenance arrive from the admitted occurrence; this module only maps them
'  onto bounded terminal values and never chooses product structure.
+  chat_foundry_web_provider
  +  foundation_style
    '  One bounded mechanical Web pronunciation of resolved system roles.
    '  Every value is selected from a closed provider vocabulary below; raw
    '  authored text can never enter CSS.  `source` distinguishes admitted
    '  provider output, a safe local fallback, and the static migration path.
    :  css=nat density=nat material=nat motion=nat source=nat
       fallback=bool contrast=bool

  +  provider_value
    '  Provider symbols are replaceable terminal material.  This whitelist is
    '  deliberately mechanical: semantic authority remains in the resolved
    '  token key and its exact winning-layer provenance.
    \  ref=path
    ^  maybe[nat]
    ?  (eq_pith ref ['provider 'web 'color 'text 'primary])
       (./some "#202124")
    ?  (eq_pith ref ['provider 'web 'color 'text 'secondary])
       (./some "#74777c")
    ?  (eq_pith ref ['provider 'web 'color 'text 'tertiary])
       (./some "#a3a6aa")
    ?  (eq_pith ref ['provider 'web 'color 'surface 'base])
       (./some "#f4f5f6")
    ?  (eq_pith ref ['provider 'web 'color 'surface 'raised])
       (./some "rgb(249 250 251/.82)")
    ?  (eq_pith ref ['provider 'web 'color 'surface 'sunken])
       (./some "#e8eaed")
    ?  (eq_pith ref ['provider 'web 'color 'surface 'overlay])
       (./some "rgb(255 255 255/.78)")
    ?  (eq_pith ref ['provider 'web 'color 'border 'separator])
       (./some "rgb(40 43 48/.12)")
    ?  (eq_pith ref ['provider 'web 'color 'border 'strong])
       (./some "rgb(40 43 48/.2)")
    ?  (eq_pith ref ['provider 'web 'color 'action 'accent])
       (./some "#1769e0")
    ?  (eq_pith ref ['provider 'web 'color 'action 'positive])
       (./some "#21a664")
    ?  (eq_pith ref ['provider 'web 'color 'action 'warning])
       (./some "#e3a525")
    ?  (eq_pith ref ['provider 'web 'color 'action 'destructive])
       (./some "#ef4054")
    ?  (eq_pith ref ['provider 'web 'contrast 'text 'primary])
       (./some "#ffffff")
    ?  (eq_pith ref ['provider 'web 'contrast 'text 'secondary])
       (./some "#d7d7d7")
    ?  (eq_pith ref ['provider 'web 'contrast 'text 'tertiary])
       (./some "#b8b8b8")
    ?  (eq_pith ref ['provider 'web 'contrast 'surface 'base])
       (./some "#050505")
    ?  (eq_pith ref ['provider 'web 'contrast 'surface 'raised])
       (./some "#0b0b0b")
    ?  (eq_pith ref ['provider 'web 'contrast 'surface 'sunken])
       (./some "#000000")
    ?  (eq_pith ref ['provider 'web 'contrast 'surface 'overlay])
       (./some "#111111")
    ?  (eq_pith ref ['provider 'web 'contrast 'border 'separator])
       (./some "#ffffff")
    ?  (eq_pith ref ['provider 'web 'contrast 'border 'strong])
       (./some "#ffffff")
    ?  (eq_pith ref ['provider 'web 'contrast 'action 'accent])
       (./some "#ffea00")
    ?  (eq_pith ref ['provider 'web 'contrast 'action 'positive])
       (./some "#00ff8c")
    ?  (eq_pith ref ['provider 'web 'contrast 'action 'warning])
       (./some "#ffd54a")
    ?  (eq_pith ref ['provider 'web 'contrast 'action 'destructive])
       (./some "#ff5a68")
    ?  (eq_pith ref ['provider 'web 'type 'body])
       (./some "'SF Pro Text','SF Pro Display',-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif")
    ?  (eq_pith ref ['provider 'web 'layout 'sidebar 'regular])
       (./some "clamp(230px,22vw,330px)")
    ?  (eq_pith ref ['provider 'web 'density 'regular])
       (./some "regular")
    ?  (eq_pith ref ['provider 'web 'material 'overlay])
       (./some "glass")
    ?  (eq_pith ref ['provider 'web 'motion 'respect_preference])
       (./some "respect-preference")
    ?  (eq_pith ref ['policy 'contrast 'standard])
       (./some "standard")
    ?  (eq_pith ref ['policy 'contrast 'maximum])
       (./some "maximum")
    .none

  +  web_token_result
    :  value=nat fallback=bool

  +  web_token
    \  key=path fallback=nat occurrence=projection_pronunciation_occurrence
    ^  chat_foundry_web_provider/web_token_result
    ?  (chat_foundry_occurrence/occurrence_ref key occurrence)
     > .none
       (chat_foundry_web_provider/web_token_result fallback .true)
     > (./some ref=path)
       ?  (chat_foundry_web_provider/provider_value ref)
        > .none
          (chat_foundry_web_provider/web_token_result fallback .true)
        > (./some value=nat)
          (chat_foundry_web_provider/web_token_result value .false)

  +  foundation_provenance_authored
    \  occurrence=projection_pronunciation_occurrence
    ^  bool
    =  key=path
         ['foundry 'provenance 'token 'color 'text 'primary]
    ?  (chat_foundry_occurrence/occurrence_ref key occurrence)
     > .none  .false
     > (./some layer=path)
       ?  (eq_pith layer ['foundry 'system 'providers 'web_chat])  .true
       (eq_pith layer ['foundry 'system 'guards 'high_contrast])

  +  foundation_style_of
    \  occurrence=projection_pronunciation_occurrence
    ^  chat_foundry_web_provider/foundation_style
    =  font_token  (chat_foundry_web_provider/web_token
                      ['foundry 'resolved 'token 'type 'body]
                      "'SF Pro Text','SF Pro Display',-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif"
                      occurrence)
       ink_token  (chat_foundry_web_provider/web_token
                     ['foundry 'resolved 'token 'color 'text 'primary]
                     "#202124" occurrence)
       muted_token  (chat_foundry_web_provider/web_token
                       ['foundry 'resolved 'token 'color 'text 'secondary]
                       "#74777c" occurrence)
       faint_token  (chat_foundry_web_provider/web_token
                       ['foundry 'resolved 'token 'color 'text 'tertiary]
                       "#a3a6aa" occurrence)
       base_token  (chat_foundry_web_provider/web_token
                      ['foundry 'resolved 'token 'color 'surface 'base]
                      "#f4f5f6" occurrence)
       raised_token  (chat_foundry_web_provider/web_token
                        ['foundry 'resolved 'token 'color 'surface 'raised]
                        "rgb(249 250 251/.82)" occurrence)
       sunken_token  (chat_foundry_web_provider/web_token
                        ['foundry 'resolved 'token 'color 'surface 'sunken]
                        "#e8eaed" occurrence)
       overlay_token  (chat_foundry_web_provider/web_token
                         ['foundry 'resolved 'token 'color 'surface 'overlay]
                         "rgb(255 255 255/.78)" occurrence)
       line_token  (chat_foundry_web_provider/web_token
                      ['foundry 'resolved 'token 'color 'border 'separator]
                      "rgb(40 43 48/.12)" occurrence)
       strong_token  (chat_foundry_web_provider/web_token
                        ['foundry 'resolved 'token 'color 'border 'strong]
                        "rgb(40 43 48/.2)" occurrence)
       accent_token  (chat_foundry_web_provider/web_token
                        ['foundry 'resolved 'token 'color 'action 'accent]
                        "#1769e0" occurrence)
       positive_token  (chat_foundry_web_provider/web_token
                          ['foundry 'resolved 'token 'color 'action 'positive]
                          "#21a664" occurrence)
       warning_token  (chat_foundry_web_provider/web_token
                         ['foundry 'resolved 'token 'color 'action 'warning]
                         "#e3a525" occurrence)
       destructive_token  (chat_foundry_web_provider/web_token
                             ['foundry 'resolved 'token 'color 'action 'destructive]
                             "#ef4054" occurrence)
       sidebar_token  (chat_foundry_web_provider/web_token
                         ['foundry 'resolved 'token 'layout 'sidebar 'width]
                         "clamp(230px,22vw,330px)" occurrence)
       density_token  (chat_foundry_web_provider/web_token
                         ['foundry 'resolved 'token 'density 'interface]
                         "regular" occurrence)
       material_token  (chat_foundry_web_provider/web_token
                          ['foundry 'resolved 'token 'material 'overlay]
                          "glass" occurrence)
       motion_token  (chat_foundry_web_provider/web_token
                        ['foundry 'resolved 'token 'motion 'change]
                        "respect-preference" occurrence)
       contrast_token  (chat_foundry_web_provider/web_token
                          ['foundry 'resolved 'token 'policy 'contrast]
                          "standard" occurrence)
       fallback=bool
         ?  font_token.fallback         .true
         ?  ink_token.fallback          .true
         ?  muted_token.fallback        .true
         ?  faint_token.fallback        .true
         ?  base_token.fallback         .true
         ?  raised_token.fallback       .true
         ?  sunken_token.fallback       .true
         ?  overlay_token.fallback      .true
         ?  line_token.fallback         .true
         ?  strong_token.fallback       .true
         ?  accent_token.fallback       .true
         ?  positive_token.fallback     .true
         ?  warning_token.fallback      .true
         ?  destructive_token.fallback  .true
         ?  sidebar_token.fallback      .true
         ?  density_token.fallback      .true
         ?  material_token.fallback     .true
         ?  motion_token.fallback       .true
         contrast_token.fallback
       authored  (chat_foundry_web_provider/foundation_provenance_authored occurrence)
       source
         ?  !authored  "static-fallback"
         ?  fallback   "safe-fallback"
         "authored"
       css
         ?  !authored  ""
         (weft/cat
           ["--surface-font:" font_token.value ";--surface-ink:" ink_token.value
            ";--surface-muted:" muted_token.value ";--surface-faint:" faint_token.value
            ";--surface-line:" line_token.value ";--surface-line-strong:" strong_token.value
            ";--surface-panel:" raised_token.value ";--surface-raised:" overlay_token.value
            ";--surface-canvas:" base_token.value ";--surface-workspace:" sunken_token.value
            ";--surface-blue:" accent_token.value ";--surface-green:" positive_token.value
            ";--surface-amber:" warning_token.value ";--surface-red:" destructive_token.value
            ";--surface-sidebar:" sidebar_token.value])
    (chat_foundry_web_provider/foundation_style
      css density_token.value material_token.value motion_token.value source fallback
      (eq contrast_token.value "maximum"))

  +  foundation_style_attrs
    \  style=chat_foundry_web_provider/foundation_style
    ^  row[weft/att]
    =  base
         [(weft/att "data-foundry-foundations" style.source)
          (weft/att "data-foundry-density" style.density)
          (weft/att "data-foundry-material" style.material)
          (weft/att "data-foundry-motion" style.motion)]
    ?  (eq style.css "")  base
    base.snoc((weft/att "style" style.css))
