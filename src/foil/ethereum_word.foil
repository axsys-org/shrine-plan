+ ethereum_word
  ' Checked uint256 reference semantics over PLAN naturals. No host effects.
  ' These functions specify failures; they are not an EVM compiler backend.
  + fault
    & ethereum_word/fault/range
      ethereum_word/fault/overflow
      ethereum_word/fault/underflow
      ethereum_word/fault/zero_divisor
    + range :
    + overflow :
    + underflow :
    + zero_divisor :
  + limit
    ^ nat
    | bex 256
  + fits
    \ value=nat
    ^ bool
    | lt value ethereum_word/limit
  + check
    \ value=nat
    ^ either[ethereum_word/fault nat]
    ? !(ethereum_word/fits value) (./err .range)
    | ./ok value
  + add_checked
    \ a=nat b=nat
    ^ either[ethereum_word/fault nat]
    ? (!(ethereum_word/fits a) || !(ethereum_word/fits b)) (./err .range)
    = result (add a b)
    ? !(ethereum_word/fits result) (./err .overflow)
    | ./ok result
  + sub_checked
    \ a=nat b=nat
    ^ either[ethereum_word/fault nat]
    ? (!(ethereum_word/fits a) || !(ethereum_word/fits b)) (./err .range)
    ? (lt a b) (./err .underflow)
    | ./ok (sub a b)
  + mul_checked
    \ a=nat b=nat
    ^ either[ethereum_word/fault nat]
    ? (!(ethereum_word/fits a) || !(ethereum_word/fits b)) (./err .range)
    = result (mul a b)
    ? !(ethereum_word/fits result) (./err .overflow)
    | ./ok result
  + div_checked
    \ a=nat b=nat
    ^ either[ethereum_word/fault nat]
    ? (!(ethereum_word/fits a) || !(ethereum_word/fits b)) (./err .range)
    ? (eq b 0) (./err .zero_divisor)
    | ./ok (div a b)
  + mul_div
    ' Check the intermediate product before dividing, as Solidity does.
    \ a=nat b=nat denominator=nat
    ^ either[ethereum_word/fault nat]
    ? (ethereum_word/mul_checked a b)
     > (./err fault) (./err fault)
     > (./ok product) (ethereum_word/div_checked product denominator)
