-  sept [order=10]
-  shrine_types [order=20]
-  weft [order=30]
-  foundry_pronounce [order=40]
-  chat_foundry_occurrence [order=50]
-  chat_foundry_web_policy_result [order=60]
'  Quarantined compatibility policy for the legacy Chat Scene shell.  These
'  exact role branches are terminal pronunciation, not semantic IR.
+  chat_foundry_web_policy_scene_shell
  +  plan_policy
    \  occurrence=projection_pronunciation_occurrence children=row[weft/node]
    ^  chat_foundry_web_policy_result
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'scene 'header] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "header" [(weft/cls "scene-chrome")]
            [(weft/el "span" [(weft/cls "scene-chrome-title")] children)])]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'scene 'header 'title] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/leaf "strong" []
            (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'scene 'header 'subtitle] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/tx " / ")
          (weft/tx
            (chat_foundry_occurrence/occurrence_text ['surface 'text] occurrence))]
         .none)
    ?  (chat_foundry_occurrence/occurrence_role_is
          ['projection 'chat 'scene] occurrence)
       (chat_foundry_web_policy_result .true
         [(weft/el "section" [(weft/cls "scene-shell")] children)] .none)
    (chat_foundry_web_policy_result .false [] .none)
