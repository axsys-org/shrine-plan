-  sept [order=10]
-  shrine_types [order=20]
-  bond [order=25]
-  shrine [order=30]
-  lain [order=40]
-  weft [order=50]
-  pact [order=60]
-  semidoc [order=70]
'  tmpl: semidoc documents as namespace templates.  A template is an
'  ordinary semidoc source read as a LAYOUT: a nested ;. node's id
'  is its mount path relative to the instantiation root (named
'  nodes), everything un-named numbers beneath its nearest named
'  ancestor as document content, ;@ /doc/kook <ref> puts behavior
'  refs on a node's record (templates reference existing form cards,
'  never mint forms), and "."-headed reference values (;/./w/home)
'  rebase against the root at mount (pact/rebase_rec) so instances
'  are self-contained.  Instantiate host-side by wrapping tmpl/mani
'  in pact/card and vine-making it anywhere, or in-kernel by yelling
'  a make of tmpl/card at any path inside the caller's subtree.
'
'  Scope note: an instance is records, not a synced document — the
'  lifted kook refs live at /sys/limb (hidden from attrs_back), and
'  named kids are invisible to a parent's numbered kid walk, so
'  nenex-style whole-document sync does not apply to an instance as
'  a unit.  Each named node is an independent namespace citizen;
'  one that rode a nenex doc kook participates in nenex's per-page
'  machinery for its own numbered subtree.
+  tmpl
  +  kook_pred
    '  ["doc" "kook"] — the template behavior predicate.
    ^  row[nat]
    ["doc" "kook"]

  +  ref_val
    '  A ref attribute value as a path; words name nothing.
    \  v=sval
    ^  maybe[path]
    ?  v
     > (./ref p)   (./some (seg_iotas p))
     > (./word _)  .none

  +  doc_attr
    '  Whether an attribute survives onto an instance record: the
    '  kook predicate is lifted into the limb slot instead, and
    '  /sys-headed predicates are kernel vocabulary, dropped.
    \  a=sattr
    ^  bool
    ?  (eq_rowcord a.pred tmpl/kook_pred)
       .false
    ?  (eq 0 a.pred.len)
       .true
    !(eq "sys" a.pred.at(0))

  +  split_kook
    '  A node split for mounting: the limb refs its /doc/kook
    '  attribute names (absolute, or "."-relative for the mount to
    '  weld), and the node itself carrying only the attributes that
    '  survive onto records.
    \  nd=snode
    ^  [refs=row[path] out=snode]
    =  as  (attrs_of nd)
    =  refs
         |  > i=nat 0  > acc=row[path] []
         ^  row[path]
         ?  (ge i as.len)
            acc
         =  a  as.at(i)
         ?  !(eq_rowcord a.pred tmpl/kook_pred)
            (_ i.inc acc)
         (_ i.inc acc.weld(a.vals.sift(tmpl/ref_val)))
    =  keep  as.keep(tmpl/doc_attr)
    =  nd2
         ?  nd
          > (./doc id _ kids)    (snode/doc id keep kids)
          > (./sect ti _ kids)   (snode/sect ti keep kids)
          > (./item ld _ kids)   (snode/item ld keep kids)
          > (./quote ld _ kids)  (snode/quote ld keep kids)
          > (./lit lg _ body)    (snode/lit lg keep body)
          > (./ref p _)          (snode/ref p keep)
          > (./prose tx _)       (snode/prose tx keep)
    [refs nd2]

  +  node_rec
    '  One template node's record: node_myth of the split node —
    '  slot layout identical to semidoc's own projection — with the
    '  limb slot attached when the node declared kook refs.
    \  nd=snode
    ^  myth
    =  [refs nd2]  (tmpl/split_kook nd)
    =  t  (node_myth nd2)
    ?  (eq 0 refs.len)
       t
    t.put(limb_slot (kook refs))

  +  named_id
    '  The mount path a node claims: a doc node's non-empty id —
    '  RELATIVE TO THE INSTANTIATION ROOT regardless of nesting
    '  depth.  Everything else is un-named content.
    \  nd=snode
    ^  maybe[path]
    ?  nd
     > (./doc id _ _)
       ?  (eq 0 id.len)
          .none
       (./some (seg_iotas id))
    .none

  +  kids_of
    '  A node's kid row; leaves have none.
    \  nd=snode
    ^  row[snode]
    ?  nd
     > (./doc _ _ kids)    kids
     > (./sect _ _ kids)   kids
     > (./item _ _ kids)   kids
     > (./quote _ _ kids)  kids
    []

  +  walk
    '  A node row as seeds, parents before kids.  Named docs mount
    '  at their root-relative id and recurse with the id as base;
    '  un-named nodes number consecutively with ($u n) under base,
    '  skipping named siblings (no numbering holes).  Named ($ts)
    '  and numbered ($u) segments can never collide; two nodes
    '  claiming one id collide silently — last in document order
    '  wins (an error channel is v2).
    \  base=path ns=row[snode]
    ^  row[[p=path t=myth]]
    |  > i=nat 0  > n=nat 0  > out=row[[p=path t=myth]] []
    ^  row[[p=path t=myth]]
    ?  (ge i ns.len)
       out
    =  nd  ns.at(i)
    ?  (tmpl/named_id nd)
     > (./some id)
       =  sub  (tmpl/walk id (tmpl/kids_of nd))
       (_ i.inc n out.snoc([id (tmpl/node_rec nd)]).weld(sub))
     > .none
       =  at  base.snoc(($u n))
       =  sub  (tmpl/walk at (tmpl/kids_of nd))
       (_ i.inc n.inc out.snoc([at (tmpl/node_rec nd)]).weld(sub))

  +  parts
    '  A parsed template split for mounting: the instance root's
    '  record and the seed row.  A single top-level doc node IS the
    '  root — its record with kook refs DROPPED (the root's behavior
    '  belongs to the mounter's pact limb) and its id riding as
    '  ['id] data, kids walked at base [].  Anything else gets a
    '  bare doc record as root and the whole row as kids.
    \  ns=row[snode]
    ^  [root=myth seeds=row[[p=path t=myth]]]
    =  bare  [(myth/new).put(['kind] (pails/t "doc")) (tmpl/walk [] ns)]
    ?  (eq 1 ns.len)
       =  hd  ns.at(0)
       ?  hd
        > (./doc _ _ kids)
          =  [refs nd2]  (tmpl/split_kook hd)
          [(node_myth nd2) (tmpl/walk [] kids)]
       bare
    bare

  +  seeds
    '  Source to seeds directly: parts, with the root record riding
    '  as the seed at [] — pact/seeds melds it onto the mount root.
    \  src=nat
    ^  row[[p=path t=myth]]
    =  [root ss]  (tmpl/parts (parse src))
    ss.cons([[] root])

  +  mani
    '  Host-side entry: template source as a mountable manifest — no
    '  kooks minted (templates only reference existing form cards),
    '  every record a seed.  pact/card this and vine-make it at any
    '  root; an empty source mounts an empty instance root.
    \  name=iota doc=lore src=nat
    ^  mani
    (mani name doc [] (tmpl/seeds src))

  +  card
    '  In-kernel entry: the instantiation card for a template
    '  source.  A kook yells [[P (writ/make (tmpl/card S))]] with P
    '  inside its own subtree (the ingest jail: at or below here)
    '  and the pact form expands the whole instance at P in the
    '  same epoch.
    \  src=nat
    ^  myth
    =  [root ss]  (tmpl/parts (parse src))
    (pact/vine_card 0 0 [] [] root ss)

  +  vine
    '  The instantiation as a top-level task (host or test driver).
    \  pax=path src=nat
    ^  task
    (./vine pax (writ/make (tmpl/card src)))
