- ethereum_word
- sept

+ paramutuel_rules
  ' Pure arithmetic for a Shrine namespace application. Admission, roles,
  ' custody and one-shot claims belong to the future state reducer.
  + policy
    & paramutuel_rules/policy/single_winner
      paramutuel_rules/policy/any_of
      paramutuel_rules/policy/exact_set
      paramutuel_rules/policy/at_least_k
      paramutuel_rules/policy/weighted_overlap
    + single_winner :
    + any_of :
    + exact_set :
    + at_least_k :
    + weighted_overlap :
  + overlap_count
    ' Count common set bits without adding a new native primitive.
    ' Admitted ticket masks are uint256, so at most 256 rounds occur.
    \ ticket=nat winning=nat
    ^ nat
    % t=nat ticket w=nat winning count=nat 0
    ? ((eq t 0) || (eq w 0)) count
    = common (? (mod t 2) (mod w 2) 0)
    | _ (div t 2) (div w 2) (add count common)
  + weight
    ' Inputs have passed wager and ticket admission. A weight of zero loses.
    ' This reproduces _ticketWins plus the WEIGHTED_OVERLAP multiplier.
    \ policy=paramutuel_rules/policy k=nat ticket=nat winning=nat
    ^ nat
    = overlap (paramutuel_rules/overlap_count ticket winning)
    ? (eq overlap 0) 0
    ? policy
     > .single_winner
      ? !(eq ticket winning) 0
      ? (eq (paramutuel_rules/overlap_count ticket ticket) 1) 1
      0
     > .any_of 1
     > .exact_set (eq ticket winning)
     > .at_least_k (ge overlap k)
     > .weighted_overlap overlap
  + fees
    ' Fees apply to every terminal path, including retraction and expiry.
    \ gross=nat bps=nat
    ^ either[ethereum_word/fault nat]
    ? (gt bps 10000) (./err .range)
    | ethereum_word/mul_div gross bps 10000
  + net_pot
    \ gross=nat bps=nat
    ^ either[ethereum_word/fault nat]
    ? (paramutuel_rules/fees gross bps)
     > (./err fault) (./err fault)
     > (./ok fee) (ethereum_word/sub_checked gross fee)
  + refund
    ' Arithmetic only: the caller validates terminal state and claim authority.
    \ stake=nat gross=nat bps=nat
    ^ either[ethereum_word/fault nat]
    ? (gt stake gross) (./err .range)
    ? (paramutuel_rules/net_pot gross bps)
     > (./err fault) (./err fault)
     > (./ok net) (ethereum_word/mul_div stake net gross)
  + payout_lines
    ' Each line is one DISTINCT ticket mask, with repeated deposits aggregated.
    ' Floor each line, then sum. The caller authenticates the denominator and
    ' enforces the entry point's zero-payout and already-claimed rules.
    \ lines=row[[stake=nat weight=nat]] net=nat denominator=nat
    ^ either[ethereum_word/fault nat]
    ? (!(ethereum_word/fits net) || !(ethereum_word/fits denominator)) (./err .range)
    ? (eq denominator 0) (./err .zero_divisor)
    % i=nat 0 paid=nat 0
    ^ either[ethereum_word/fault nat]
    ? (eq i lines.len) (./ok paid)
    = [stake weight] lines.at(i)
    ? (ethereum_word/mul_checked stake weight)
     > (./err fault) (./err fault)
     > (./ok units)
      ? (ethereum_word/mul_div units net denominator)
       > (./err fault) (./err fault)
       > (./ok line)
        ? (ethereum_word/add_checked paid line)
         > (./err fault) (./err fault)
         > (./ok total) (_ i.inc total)
