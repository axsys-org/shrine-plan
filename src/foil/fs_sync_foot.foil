- fs_sync
- bond
- helm
- fs_read

+ fs_foot
  + get_root
    \ ax=axal[saga]
    ^ myth
    > (./some rec) ax.fil
     myth/new
    | unpin rec.myth

  + get_pending
    \ mit=myth
    ^ bool
    = lot mit.get(bond/pending)
    lot.then(pails/b/try_from_pail).run(pails/b/b).fall(.false)

  + get_epoch
    \ mit=myth
    ^ nat
    | mit.nat_at bond/epoch 0

  + scan_requested
    \ reader={\ str}either[str row[fs_read/file]]
      parent=nat key=iota mit=myth
    ^ nat
    = root | mit.txt_at bond/from
      epoc | %/get_epoch mit
    = ;scan | Try reader root
    ? scan
     > (./err why)
      | Send parent (feet/gift/pass [key]
          (writ/poke (myth/sing bond/res
            (fs/failure epoc mit "Filesystem scan threw"))))
     > (./ok result)
      ? result
       > (./err why)
        | Send parent (feet/gift/pass [key]
            (writ/poke (myth/sing bond/res
              (fs/failure epoc mit why))))
       > (./ok files)
        = done | fs/batch epoc mit files
          rec | myth/sing bond/res done
        | Send parent (feet/gift/pass [key] (writ/poke rec))

  + changed
    ' The parent binding is care-y: one record per sync child.
    \ reader={\ str}either[str row[fs_read/file]]
      parent=nat old=axal[saga] new=axal[saga]
    ^ nat
    = kids new.kid_tap
    % idx=nat 0
    ^ nat
    ? (eq idx kids.len) 0
    = [key tree] kids.at(idx)
      rec | %/get_root tree
      needed
        ?> (./some saga) (old.get([key])) .true
        | gt (%/get_epoch rec) (%/get_epoch (unpin saga.myth))
    ? !(is_text key)
     | _ idx.inc
    ? (and (%/get_pending rec) needed)
     ; | %/scan_requested reader parent key rec
     | _ idx.inc
    | _ idx.inc

  + run
    \ init=feet/task/init self=nat
    ^ nat
    | fs_foot/run_with fs_read/read init self
  + run_with
    \ reader={\ str}either[str row[fs_read/file]]
      init=feet/task/init self=nat
    ^ nat
    ; (fs_foot/watch_mounts reader init.parent init.ax)
    ; | %/changed reader init.parent (axal/new[saga] .none) init.ax
    % old=axal[saga] init.ax
    = ;[msg caps] | Recv[feet/task[unit]] 0
    ; | helm/supervisor/close_caps caps
    ? msg
     > (./ack ack)
      ? ack
       > .none (_ old)
       > (./some err)
        ; | Trace ["filesystem write rejected" err] 0
        | _ old
     > (./fact ax)
      ; | %/changed reader init.parent old ax
      | _ ax
    ; | Trace ["unexpected filesystem message" msg] 0
    | _ old
  + capture
    \ reader={\ str}either[str row[fs_read/file]] root=str
    ^ either[str row[fs_read/file]]
    ?> (./ok result) (Try reader root) (./err "Filesystem watch capture failed")
    result
  + watch
    ' Source I/O only. Unchanged bytes produce no namespace event. Domain
    ' work still runs exclusively in subscribed hands after the normal scan.
    \ reader={\ str}either[str row[fs_read/file]] key=iota root=str seconds=nat self=nat
    ^ nat
    = ;[ignored caps] (Recv[unit] 0)
      parent caps.at(0)
      ;first (fs_foot/capture reader root)
    % before=either[str row[fs_read/file]] first published=either[str row[fs_read/file]] first
    ; (Sleep seconds)
    = ;current (fs_foot/capture reader root)
    ? !(equal[either[str row[fs_read/file]]] before current) (_ current published)
    ? (equal[either[str row[fs_read/file]]] published current) (_ current published)
    ; (Send parent (feet/gift/pass [key] (writ/poke (myth/sing bond/pending (pails/b .true)))))
    | _ current current
  + watch_mounts
    ' Startup configuration, owned by the filesystem foot's lifetime. No
    ' model/work queue, dates or retry policy belongs in this adapter.
    \ reader={\ str}either[str row[fs_read/file]] parent=nat tree=axal[saga]
    ^ nat
    = kids tree.kid_tap
    % idx=nat 0
    ^ nat
    ? (eq idx kids.len) 0
    = [key child] kids.at(idx)
      record (fs_foot/get_root child)
      seconds record.nat_at(['fs 'watch_seconds] 0)
    ? ((lt seconds 5) || (gt seconds 3600)) (_ idx.inc)
    = ;watcher (Spawn (fs_foot/watch reader key record.txt_at(bond/from) seconds))
    ; (SendCaps watcher 0 [parent])
    ; (CloseHandle watcher)
    | _ idx.inc
