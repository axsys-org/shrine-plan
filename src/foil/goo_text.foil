- json
- sys/shrine

+ modifiers
  & modifiers/italic modifiers/bold modifiers/underline
  + italic
    :
  + bold
    :
  + underline
    :
+ pails
  + modifiers
    : values=list[modifiers]
+ weblink
  : href=str

' The run myth contains metadata; carrying it grants no action authority.
+ goo
  + lang
    & goo/lang/en
    + en
      : txt=str
    + txt
      \ value=goo/lang
      ^ str
      | goo/lang/en/txt value
  + runt
    : =myth lang=goo/lang
  + text
    row[goo/runt]
    + pail
      : value=goo/text
    + en
      \ txt=str
      ^ goo/text
      [(goo/runt myth/new (goo/lang/en txt))]
    + plain
      \ value=goo/text
      ^ str
      | str/cat_all value.map((\ run=goo/runt run.lang.txt))
    + slice
      ' Byte ranges; the current ASCII measurer supplies valid boundaries.
      ' Preserve descriptors and run order, including when cutting within a run.
      \ start=nat length=nat value=goo/text
      ^ goo/text
      % i=nat 0 offset=nat 0 out=list[goo/runt] .nil
      ? (eq i value.len) out.reverse.row
      = run value.at(i)
        txt run.lang.txt
        left (? (gt start offset) start offset)
        end (add start length)
        boundary (add offset txt.len)
        right (? (lt end boundary) end boundary)
        next (? (lt left right) out.cons((goo/runt run.myth (goo/lang/en txt.slice((sub left offset) (sub right left))))) out)
      | _ i.inc (add offset txt.len) next
    + supported
      \ value=goo/text
      ^ bool
      | row/all[goo/runt] (\ run (goo_text/descriptor_valid run.myth)) value

+ goo_text
  + field
    \ fields=row[jkv] key=str
    ^ maybe[json]
    % i=nat 0
    ^ maybe[json]
    ? (eq i fields.len) .none
    ? (eq fields.at(i).k key) (./some fields.at(i).v)
    | _ i.inc
  + unique
    \ fields=row[jkv]
    ^ bool
    % i=nat 0
    ? (eq i fields.len) .true
    ? (row/any[jkv] (\ entry (eq entry.k fields.at(i).k)) fields.drop(i.inc)) .false
    | _ i.inc
  + modifier_name
    \ value=modifiers
    ^ str
    ? value
     > ./italic "italic"
     > ./bold "bold"
     > ./underline "underline"
  + modifier_read
    \ value=json
    ^ maybe[modifiers]
    > (json/str value) value .none
    ? (eq value "italic") (./some (modifiers/italic))
    ? (eq value "bold") (./some (modifiers/bold))
    ? (eq value "underline") (./some (modifiers/underline))
    .none
  + modifier
    \ value=modifiers metadata=myth
    ^ bool
    ?> (./some held) metadata.get(['sys 'modifiers]) .false
    ?> held=pails/modifiers held .false
    | held.values.has(value)
  + linked
    \ metadata=myth
    ^ bool
    | metadata.get(['sys 'link]).is_some
  + descriptor_valid
    \ metadata=myth
    ^ bool
    | metadata.tap.all
      \ [slot held]
      ? (equal[path] slot ['sys 'font])
        ?> value=pails/p held .false
        .true
      ? (equal[path] slot ['sys 'modifiers])
        ?> value=pails/modifiers held .false
        ? (gt value.values.len 3) .false
        = names=row[str] value.values.map(goo_text/modifier_name).row
        % i=nat 0
        ? (eq i names.len) .true
        ? (row/any[str] (\ name (eq name names.at(i))) names.drop(i.inc)) .false
        | _ i.inc
      ? (equal[path] slot ['sys 'link])
        ? held
         > value=pails/p .true
         > value=weblink
          | goo_text/web_href value.href
        .false
      .false
  + web_href
    \ value=str
    ^ bool
    ? !((eq value.slice(0 8) "https://") || (eq value.slice(0 7) "http://")) .false
    % i=nat 0
    ? (eq i value.len) .true
    ? ((lt value.at(i) 33) || (eq value.at(i) 127)) .false
    | _ i.inc
  + encode_pail
    ' Explicit transport cases, not the run's underlying value type.
    ' Foreign brands remain diagnostic data and cannot be decoded as another type.
    \ value=pail
    ^ json
    = kind=str
        ? value
         > x=pails/n "nat"
         > x=pails/b "bool"
         > x=pails/t "text"
         > x=pails/p "path"
         > x=pails/modifiers "modifiers"
         > x=weblink "weblink"
        "unsupported"
      body=json
        ? value
         > x=pails/n (json/str (nat/show x.n))
         > x=pails/b (json/boo x.b)
         > x=pails/t (json/str x.t)
         > x=pails/p (json/str (path_show x.p))
         > x=pails/modifiers (json/arr x.values.map((\ v (json/str (goo_text/modifier_name v)))).row)
         > x=weblink (json/str x.href)
        | json/obj [(jkv "brand" (json/str (nat/show (rep_hd value))))]
    | json/obj [(jkv "kind" (json/str kind)) (jkv "value" body)]
  + decode_pail
    \ value=json
    ^ maybe[pail]
    ?> (json/obj fields) value .none
    ? !(and (eq fields.len 2) (goo_text/unique fields)) .none
    < kind (goo_text/field fields "kind")
    ?> (json/str kind) kind .none
    < body (goo_text/field fields "value")
    ? (eq kind "modifiers")
      ?> (json/arr values) body .none
      < values (values.stream.traverse_maybe(goo_text/modifier_read))
      | ./some (pails/modifiers values)
    ? (eq kind "bool")
      ?> (json/boo value) body .none
      | ./some (pails/b value)
    ?> (json/str value) body .none
    ? (eq kind "weblink") (./some (weblink value))
    ? (eq kind "text") (./some (pails/t value))
    ? (eq kind "nat")
      < n (nat/parse value)
      ? !(eq (nat/show n) value) .none
      | ./some (pails/n n)
    ? (eq kind "path")
      < p (path_parse value)
      ? !(eq (path_show p) value) .none
      | ./some (pails/p p)
    .none
  + encode_myth
    \ value=myth
    ^ json
    | json/obj (value.tap.map((\ [slot held] (jkv (path_show slot) (goo_text/encode_pail held)))))
  + decode_myth
    \ value=json
    ^ maybe[myth]
    > (json/obj fields) value .none
    ? !(goo_text/unique fields) .none
    % i=nat 0 out=myth myth/new
    ^ maybe[myth]
    ? (eq i fields.len) (./some out)
    = entry fields.at(i)
    < slot (path_parse entry.k)
    ? !(eq (path_show slot) entry.k) .none
    < held (goo_text/decode_pail entry.v)
    | _ i.inc out.put(slot held)
  + encode
    \ value=goo/text
    ^ json
    = runs
        | value.map
        \ run=goo/runt
        | json/obj [(jkv "myth" (goo_text/encode_myth run.myth)) (jkv "lang" (json/obj [(jkv "en" (json/obj [(jkv "txt" (json/str run.lang.txt))]))]))]
    | json/arr runs
  + decode_run
    \ value=json
    ^ maybe[goo/runt]
    > (json/obj fields) value .none
    ? !(and (eq fields.len 2) (goo_text/unique fields)) .none
    < metadata (goo_text/field fields "myth")
    < descriptor (goo_text/decode_myth metadata)
    < language (goo_text/field fields "lang")
    > (json/obj variants) language .none
    ? !(eq variants.len 1) .none
    < english (goo_text/field variants "en")
    > (json/obj contents) english .none
    ? !(eq contents.len 1) .none
    < text (goo_text/field contents "txt")
    > (json/str txt) text .none
    | ./some (goo/runt descriptor (goo/lang/en txt))
  + decode
    \ value=json
    ^ maybe[goo/text]
    > (json/arr runs) value .none
    < decoded (runs.stream.traverse_maybe(goo_text/decode_run))
    | ./some decoded.row
  + normalized
    ' CRLF recognition crosses run boundaries; profile supplies tab expansion.
    \ tab=str value=goo/text
    ^ goo/text
    % i=nat 0 previous_cr=bool .false out=list[goo/runt] .nil
    ? (eq i value.len) out.reverse.row
    = run value.at(i)
      txt run.lang.txt
      part
        % j=nat 0 cr=bool previous_cr result=str ""
        ^ goo_text/normalized_part
        ? (eq j txt.len) (goo_text/normalized_part result cr)
        = c txt.at(j)
        ? (eq c 13) (_ j.inc .true result.snoc_byte(10))
        ? (and (eq c 10) cr) (_ j.inc .false result)
        ? (eq c 9) (_ j.inc .false result.cat(tab))
        | _ j.inc .false result.snoc_byte(c)
    | _ i.inc part.cr out.cons((goo/runt run.myth (goo/lang/en part.txt)))
  + normalized_part
    : txt=str cr=bool
  + words
    ' Collapse label whitespace; retain contiguous word spans, not glyph runs.
    \ value=goo/text
    ^ goo/text
    = txt value.plain
    % i=nat 0 pending=maybe[goo/runt] .none out=list[goo/runt] .nil
    ^ goo/text
    ? (eq i txt.len) out.reverse.row
    = c txt.at(i)
    ? ((eq c 32) || (eq c 10))
      = owner (goo/text/slice i 1 value).at(0)
      | _ i.inc (? out.is_nil .none (? pending.is_some pending (./some (goo/runt owner.myth (goo/lang/en " "))))) out
    = end=nat
        % j=nat i
        ? (eq j txt.len) j
        ? ((eq txt.at(j) 32) || (eq txt.at(j) 10)) j
        | _ j.inc
      out
        ? pending
         > (./some space) out.cons(space)
        out
      word (goo/text/slice i (sub end i) value)
    | _ end .none word.stream.reverse.weld(out)
