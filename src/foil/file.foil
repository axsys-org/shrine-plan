-  lain
'  file: the first namespace-native file storage vocabulary.
'  .
'  A format definition and a file occurrence are different branded pails.
'  The occurrence carries its format value and inline bytes, so consumers do
'  not infer either from a path or ask the host to inspect filesystem state.
+  file_format
  '  A file-format identity for this first slice.  The branded pail says this
  '  value is a format definition; media_type is its explicit MIME type.
  :  media_type=nat
+  file_occurrence
  '  One stored file occurrence: a branded format definition and its inline
  '  byte atom.  The content-addressed external-blob extension is deliberately
  '  deferred; this value owns no host filesystem path.
  :  format=file_format content=nat
+  file_read
  '  Result of projecting a namespace node as stored file bytes.  A missing
  '  record differs from a present record without a valid file occurrence.
  &  $file_missing
     $file_malformed
     ($file_found nat nat)
+  format_record
  '  A namespace record defining one file format at ['format].
  \  f=file_format
  ^  myth
  =  > t (myth/new 0)
  t.put(['format] f)
+  file_record
  '  A namespace record representing one inline file occurrence at ['file].
  \  f=file_format content=nat
  ^  myth
  =  > t (myth/new 0)
  t.put(['file] (file_occurrence f content))
+  read_file
  '  Interpret the root record of a hydrated namespace view as a file.
  '  Only the exact branded pails are accepted; other records stay opaque.
  \  fat=axal[myth]
  ^  file_read
  ?  fat.fil
   > $none  $file_missing
   > ($some t=myth)
     ?  t.get(['file])
      > $none  $file_malformed
      > ($some pl=pail)
        ?  pl
         > f=file_occurrence
           ($file_found f.format.media_type f.content)
        $file_malformed
