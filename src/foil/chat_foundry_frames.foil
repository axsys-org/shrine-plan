-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  weft [order=30]
-  foundry_action [order=40]
-  foundry_delivery [order=50]
-  foundry_pronounce [order=60]
-  foundry_pronounce_walk [order=65]
-  foundry_wire [order=70]
-  web [order=80]
-  chat_foundry_projection [order=90]
-  chat_foundry_pronunciation [order=100]
'  Mechanical Chat projection-frame encoding, HTTP response, and authored
'  dependency watcher fan-in.  Semantic compilation and terminal pronunciation
'  remain owned by their preceding modules.
+  chat_foundry_frames
  +  frame_record
    '  Unary mechanical adapter over an explicit context tree.  A host builds
    '  that ephemeral tree with /source and /foundry subtrees from its admitted
    '  Sights; the adapter exposes a wire batch as data.  It does not fall back
    '  to an empty source or corpus, and it mints no namespace projection.
    \  context=axal[myth]
    ^  myth
    =  corpus    context.dip(['foundry])
       source    context.dip(['source])
       authored  context.dip(['foundry_authored])
    ?  (eq corpus.tap.len 0)
       (myth/new).put(['projection_frames_code]
         (pails/q 'corpus_evidence_missing))
    ?  (eq source.tap.len 0)
       (myth/new).put(['projection_frames_code]
         (pails/q 'source_evidence_missing))
    (chat_foundry_frames/frame_record_ready source corpus authored)

  +  frame_record_with_action
    '  The first Action-aware packet seam.  It validates the exact declaration
    '  Sight as ordinary source data, but deliberately does not fabricate an
    '  admission context: the current HTTP request has no actor, Space, Scene
    '  Route, effective Action horizon, or attenuation witness.  A later
    '  authority resolver may call foundry_action/admit and add the resulting
    '  mount; this read-only proof cannot do so by itself.
    \  context=axal[myth]
    ^  myth
    =  action  context.dip(['action])
    ?  action.fil
     > .none
       (myth/new).put(['projection_frames_code]
         (pails/q 'action_evidence_missing))
     > (./some action_record=myth)
       ?  (foundry_action/declaration_of action_record)
        > x=foundry_action/declaration_result/refused
          (myth/new).put(['projection_frames_code]
            (pails/q x.diagnostic.code))
        > foundry_action/declaration_result/admitted
          (chat_foundry_frames/frame_record context)

  +  frame_record_ready
    '  One admitted DAG feeds both progressive frames and the late occurrence
    '  plan.  No renderer-local SurfaceTree reconstruction exists on this path.
    \  source=axal[myth] corpus=axal[myth] authored=axal[myth]
    ^  myth
    =  root=path  ['chat]
       kind       "desktop"
       [frames dag]
         (chat_foundry_projection/packet_product_authored
           root kind corpus source authored)
       packet  (chat_foundry_projection/frame_packet_id root kind)
       t0  (myth/new).put(['projection 'packet] (pails/t packet))
    ?  dag
     > .none
       (chat_foundry_frames/frame_encoding_record packet frames [] t0)
     > (./some admitted=projection_dag)
       ?  (foundry_pronounce_walk/pronounce admitted)
        > x=projection_pronunciation_result/refused
          t0.put(['projection_frames_code] (pails/q x.refusal.code))
        > x=projection_pronunciation_result/admitted
          =  [terminal_body terminal_issue]
               (chat_foundry_pronunciation/pronunciation_terminal x.pronunciation)
          ?  terminal_issue
           > (./some code=iota)
             t0.put(['projection_frames_code] (pails/q code))
           > .none
             ?  terminal_body
              > .none
                t0.put(['projection_frames_code]
                  (pails/q 'chat_pronunciation_render_failed))
              > (./some body=nat)
                =  terminals=row[projection_terminal_pronunciation]
                     ?  (eq x.pronunciation.roots.len 1)
                        [(projection_terminal_pronunciation
                           x.pronunciation.roots.at(0) "scene-root" "text/html"
                           body 'non_authoritative)]
                     []
                (chat_foundry_frames/frame_encoding_record
                  packet frames terminals t0)

  +  frame_encoding_record
    \  packet=nat frames=row[projection_frame]
       terminals=row[projection_terminal_pronunciation] t0=myth
    ^  myth
    =  encoding
         (foundry_wire/frames_with_terminals_json packet frames terminals)
    ?  (foundry_wire/encoding_body encoding)
     > (./some body=nat)
       t0.put(['projection_frames] (pails/t body))
     > .none
       ?  (foundry_wire/encoding_code encoding)
        > (./some code=iota)
          t0.put(['projection_frames_code] (pails/q code))
        > .none
          t0.put(['projection_frames_code] (pails/q 'wire_refused))

  +  frame_context
    '  The only context constructor: the source occurrence and mounted
    '  Foundry corpus remain separately named evidence in an ephemeral value.
    \  source=axal[myth] corpus=axal[myth]
    ^  axal[myth]
    .  (axal/new[myth] .none)
       rep(['source] source)
       rep(['foundry] corpus)

  +  frame_context_authored
    '  An optional normalized authoring observation rides as separate evidence;
    '  the static Foundry corpus remains independently addressable fallback.
    \  source=axal[myth] corpus=axal[myth] authored=axal[myth]
    ^  axal[myth]
    .  (chat_foundry_frames/frame_context source corpus)
       rep(['foundry_authored] authored)

  +  frame_context_with_action
    '  Source occurrence, Foundry authorship, and Action declaration remain
    '  three separately addressed Sights in the ephemeral responder context.
    \  source=axal[myth] corpus=axal[myth] authored=axal[myth]
       action=axal[myth]
    ^  axal[myth]
    .  (chat_foundry_frames/frame_context_authored source corpus authored)
       rep(['action] action)

  +  frame_http_response
    '  Produce the packet only after the HTTP face has proved that both
    '  responder Sights exist.  Ordinary Chat pages never pay this work.
    \  out=myth source=axal[myth] corpus=axal[myth] authored=axal[myth]
       action=axal[myth]
    ^  myth
    =  frame_rec
         (chat_foundry_frames/frame_record_with_action
           (chat_foundry_frames/frame_context_with_action
             source corpus authored action))
       frame_body  (myth/txt_at ['projection_frames] frame_rec)
    .  out
       put(['res_status] (pd (if (eq frame_body 0) 501 200)))
       put(['res_body] (pd (if (eq frame_body 0)
         "projection producer refused wire encoding" frame_body)))
       put(['res_ctype] (pd
         "application/vnd.shrine.projection-frames+json; charset=utf-8"))

  +  frame_http_unavailable
    '  Missing source/corpus Sights cannot mint a meaningful manifest
    '  revision, so the mechanical face refuses before invoking the producer.
    \  out=myth detail=nat
    ^  myth
    .  out
       put(['res_status] (pd 503))
       put(['res_body] (pd detail))
       put(['res_ctype] (pd "text/plain; charset=utf-8"))

  +  frames_url
    '  Mechanical app-face location for the ephemeral two-Sight producer.
    '  It is transport spelling, never semantic identity.
    ^  nat
    "/chat/frames"

  +  frames_watch
    '  The inherited shell follows only x:/chat.  A second mount sharing this
    '  packet's transport identity observes authored definitions separately;
    '  the browser already shares packet state by packet id, so either wake
    '  reloads the one admitted packet without inventing multi-watch syntax.
    '  Volatile messages remain independently observed at z:/chat/log by the
    '  semantic Hole terminal.
    ^  nat
    (frag/report_watch_template ['chat] .x)

  +  frames_authored_watch
    '  Exact authoring dependency for this first packet producer.  A deep Sight
    '  at /nenex/w hydrates the corpus, but the generic observe bridge versions
    '  the report occurrence itself: editing a child page does not advance the
    '  parent report case.  Watch the admitted Header Text page occurrence until
    '  the dependency planner emits one watcher per admitted source pin.  This
    '  remains a mechanical observation location, never semantic identity.
    ^  nat
    (frag/report_watch_template ['nenex 'w 'header_text_style] .z)

  +  frames_contract_watch
    '  Plate Header anatomy is independently authored and therefore an exact
    '  dependency of the same packet revision as Header Text Style.
    ^  nat
    (frag/report_watch_template ['nenex 'w 'plate_header_block] .z)

  +  frames_foundation_watches
    '  Exact normalized Nenex occurrences that own the first cohesive system
    '  packet.  They share the packet transport id but retain independent
    '  observation cases and semantic revision evidence.
    ^  row[nat]
    [(frag/report_watch_template ['nenex 'w 'chat_foundation] .z)
     (frag/report_watch_template ['nenex 'w 'web_chat_provider] .z)
     (frag/report_watch_template ['nenex 'w 'high_contrast_guard] .z)
     (frag/report_watch_template ['nenex 'w 'reduced_motion_guard] .z)]

  +  foundation_packet_mounts_at
    \  watches=row[nat] packet=nat index=nat out=row[weft/node]
    ^  row[weft/node]
    ?  (ge index watches.len)  out
    (_ watches packet index.inc
      out.snoc((weft/packet_mount packet chat_foundry_frames/frames_url
        watches.at(index) "z" [])))

  +  foundation_packet_mounts
    \  packet=nat
    ^  row[weft/node]
    (chat_foundry_frames/foundation_packet_mounts_at
      chat_foundry_frames/frames_foundation_watches packet 0 [])

  +  authored_packet_watcher
    '  Hidden observers for the same progressive packet.  packet_mount is
    '  intentionally reused rather than extending Weft with an unproved
    '  multi-watch attribute.  Packet state is keyed by packet id, so any
    '  authored dependency reloads and paints the visible sibling atomically.
    \  packet=nat
    ^  weft/node
    =  fixed
         [(weft/packet_mount packet chat_foundry_frames/frames_url
            chat_foundry_frames/frames_authored_watch "z" [])
          (weft/packet_mount packet chat_foundry_frames/frames_url
            chat_foundry_frames/frames_contract_watch "z" [])]
    (weft/el "div"
      [(weft/att "hidden" "hidden") (weft/att "aria-hidden" "true")]
      fixed.weld((chat_foundry_frames/foundation_packet_mounts packet)))
