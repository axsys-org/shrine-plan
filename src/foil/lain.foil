  =  > pax ps.at(i)
  ?  ((is_io pax) || (is_log pax))
     (_ i.inc acc)
  ?  s.x_latest(pax)
   > (./known t=myth)
     =  > ds (node_deps t)
     ?  (eq 0 ds.len)
