                 =  > wm2 (record dst (./poke out) wm1)
                 (./go (ingest dst cards wm2))
+  raid
  '  The gift cascade.  Each prized path is grouped under its nearest
  '  existing strict ancestor (existence is the in-flight view; the
  '  root contributes nothing), and one take per parent joins the
  '  queue, carrying the changed paths relative to that parent.  Take
  '  results are poke writes, so the prize repopulates strictly
  '  upward until it drains at the top.
  \  wm=worm s=sov
  ^  worm
  =  > pz wm.prize
  =  > es pz.tap
  =  > gam
       |  > i=nat 0  > acc=axal[axal[mode]] (axal/new[axal[mode]] .none)
       ?  (eq i es.len)
          acc
       =  > h es.at(i)
       ?  (le p.len 1)
          (_ i.inc acc)
       =  > par
            |  > k=nat p.len.dec
            ^  maybe[path]
            ?  (eq k 0)
               .none
            =  > pre p.take(k)
            ?  (exists pre wm s)
               (./some pre)
            (_ k.dec)
       ?  par
        > .none  (_ i.inc acc)
        > (./some pp=path)
          =  > g0 acc.gut(pp (axal/new[mode] .none))
          =  > rel p.drop(pp.len)
          =  > g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  > gs gam.tap
  =  > wm1
       |  > i=nat 0  > acc=worm wm
       ?  (eq i gs.len)
          acc
       =  > h gs.at(i)
