-  sept
-  shrine
'  lain: the reactive application layer over the shrine namespace — a
'  pure port of the neo-lazy kernel's core loop.
'  .
'  Values in the namespace are pails: the open union of every nominal
'  row type, tagged by the branded head of the value itself — the
'  path in the head constructor IS the type tag.  Slots hold pails;
'  the kernel reads the slots it understands (the /kook behavior
'  list) by matching their heads, and everything else rides opaquely.
'  .
'  The kernel is a stateless transition function: it reads the
'  committed namespace through /sov queries, accumulates writes in a
'  per-event transaction (/worm), and returns a /fate — the ordered
'  write list plus outbound effects — or fails, discarding the whole
'  event (no partial writes can escape: writes exist only in the worm
'  until /commit).  /run_event closes the cycle by committing a fate
'  through /sov/step .
'  .
'  Scope notes: dependency hydration (crew/deps), overlay (%over)
'  redirects, and validation hooks are deferred; dead/goof are
'  vocabulary only.  The source's per-event read cache is skipped
'  (reads here are pure) and its vestigial sibling queue is omitted.
'  Commands arrive one at a time, each tagged with its target path —
'  the tag rides through to the /doom ack.  Behavior arms return flat
'  card rows (path-tagged writs); outbound moves carry one command
'  each.
+  care
  '  Read restriction: the node only ($x), node plus direct kids
  '  ($y), or the whole subtree ($z).
  &  $x
     $y
     $z
+  dep
  '  One cared path: a (care, path) pair.  News carries them as
  '  subscriptions (p is the subscriber); hear arms receive them as
  '  changes (p is the changed path).
  :  c=care p=path
+  kook
  '  The value of the well-known behavior slot: a list of behavior
  '  ids, resolved against the registry per event.
  :  ids=path
+  mode
  '  What kind of change happened at a path.
  &  $add
     $dif
     $del
+  writ
  '  A pending write: replace the myth, merge into it, or delete the
  '  node.
  &  ($make myth)
     ($poke myth)
     $cull
+  move
  '  An outbound effect: one command, emitted at src, addressed
  '  outside the processed subtree.
  :  src=path dst=path w=writ
+  job
  '  What a dispatch sees: a command (the target is the flue's dst),
  '  a child-change gift, or a dependency-change notification of
  '  (care, path) pairs.
  &  ($vine writ)
     ($take axal[mode])
     ($hear row[dep])
+  flue
  '  A linearized work unit: who caused it, where it lands, what it is.
  :  src=path dst=path job=job
+  bowl
  '  Per-activation context.  now is a logical clock, +1 per
  '  activation within the event; kids is the in-flight care-y view
  '  of the node's own subtree.  (deps deferred.)
  :  src=path here=path now=nat eny=nat kids=axal[myth]
+  yell
  '  What an arm returns: cards (path-tagged writs) to emit and the
  '  node's new state.
  :  cards=row[[p=path q=writ]] out=myth
+  form
  '  A behavior: six laws over (bowl, state, input).  dead and goof
  '  are vocabulary only in this port — never invoked.
  :  init={bowl; myth; yell}
     talk={bowl; myth; myth; yell}
     take={bowl; myth; axal[mode]; yell}
     hear={bowl; myth; row[dep]; yell}
     dead={bowl; myth; yell}
     goof={bowl; myth; yell}
+  def_init
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_talk
  '  Default talk: union, the poke wins.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  (yell [] o)
+  def_take
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  (yell [] cur)
+  def_hear
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  (yell [] cur)
+  def_dead
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_form
  '  The default behavior: init/talk as documented, take/hear keep
  '  state.  The argument is ignored.
  \  x=nat
  ^  form
  (form def_init def_talk def_take def_hear def_dead def_dead)
+  kres
  '  Kook resolution: the behavior list, or a failure code.
  &  ($kf row[form])
     ($ke quip)
+  task
  '  One top-level event: a single path-tagged command, or change
  '  notifications (changed path -> its cared subscribers, as /dep
  '  pairs).
  &  ($vine path writ)
     ($hear axal[row[dep]])
+  fate
  '  The kernel's answer: writes ordered by /lte_pith (tap order) and
  '  outbound effects.
  :  write=row[[p=path q=writ]] effects=row[move]
+  worm
  '  The per-event transaction.  down is a row+cursor queue (pop at
  '  dcur, push snoc).  prize records how each path changed, for the
  '  gift cascade.
  :  toil=axal[writ] down=row[flue] dcur=nat up=row[move] prize=axal[mode] now=nat eny=nat
+  wend
  '  The loop accumulator: a live transaction or an aborted one.
  &  ($go worm)
     ($bad quip)
+  doom
  '  The kernel outcome for one event.  A successful vine event acks
  '  with the command's path tag; hear events ack $none.
  &  ($done fate maybe[path])
     ($fail quip)
+  ovum
  '  The full-cycle outcome: new sovereign, outbound moves, the step's
  '  change signs, and the command's ack (its path tag; $none for hear
  '  events) — or a failure with the sovereign untouched.
  &  ($ripe sov row[move] axal[sign] maybe[path])
     ($fail quip)
+  kook_slot
  '  The well-known slot holding a node's behavior id list.  The
  '  argument is ignored.
  \  x=nat
  ^  path
  ['sys 'kook]
+  is_xeno
  '  Is this path remote (under /xeno)?
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     0
  (eq_iota p.at(0) 'xeno)
+  writ_mode
  \  w=writ
  ^  mode
  ?  w
   > ($make t=myth)  $add
   > ($poke t=myth)  $dif
   > $cull  $del
+  mode_then
  '  Compose a later change kind onto an earlier one at the same path.
  \  old=maybe[mode] new=mode
  ^  mode
  ?  old
   > $none  new
   > ($some m=mode)
     ?  m
      > $add
        ?  new
         > $del  $del
         > $add  $add
         > $dif  $add
      > $del
        ?  new
         > $add  $add
         > $del  $del
         > $dif  $del
      > $dif  new
+  writ_then
  '  Compose a later writ onto a pending one at the same path, so the
  '  transaction holds at most one writ per path.
  \  old=maybe[writ] new=writ
  ^  writ
  ?  old
   > $none  new
   > ($some ow=writ)
     ?  new
      > ($make t=myth)  new
      > $cull  new
      > ($poke t=myth)
        ?  ow
         > ($make ot=myth)
           =  > m ot.meld(t)
           ($make m)
         > ($poke ot=myth)
           =  > m ot.meld(t)
           ($poke m)
         > $cull  ($make t)
+  peek
  '  The committed perspective: the subtree at pax as of s.top, piths
  '  relative to pax, no version metadata.  Reads the index directly
  '  (sov z_query is unknown unless pax itself is a node, which would
  '  blind in-flight reads under nodes made this event).
  \  pax=path s=sov
  ^  axal[myth]
  =  > c s.top
  =  > ix s.idx
  =  > sub ix.dip(pax)
  =  > es sub.tap
  |  > i=nat 0  > acc=axal[myth] (axal/new[myth] $none)
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  ?  (hres c q)
   > ($known t=myth)  (_ i.inc acc.put(p t))
   > $null  (_ i.inc acc)
   > $unknown  (_ i.inc acc)
+  muck
  '  Overlay a pending-writ subtree onto a committed subtree (both
  '  relative): make replaces, poke melds (or stands alone), cull
  '  deletes the value.
  \  base=axal[myth] pend=axal[writ]
  ^  axal[myth]
  =  > es pend.tap
  |  > i=nat 0  > acc=axal[myth] base
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  ?  q
   > ($make t=myth)  (_ i.inc acc.put(p t))
   > ($poke t=myth)
     ?  acc.get(p)
      > ($some cur=myth)
        =  > m cur.meld(t)
        (_ i.inc acc.put(p m))
      > $none  (_ i.inc acc.put(p t))
   > $cull  (_ i.inc acc.del(p))
+  sorge
  '  Restrict a tree to a care: node only, node + direct kids, or all.
  (@ v)
  \  c=care fat=axal[v]
  ^  axal[v]
  ?  c
   > $x  (axal/new[v] fat.fil)
   > $y  (axal/snip[v] fat)
   > $z  fat
+  read
  '  The in-flight perspective: committed state overlaid with the
  '  transaction's pending writes, care-filtered, metadata-free.
  \  c=care pax=path wm=worm s=sov
  ^  axal[myth]
  =  > com (peek pax s)
  =  > tl wm.toil
  =  > pend tl.dip(pax)
  =  > wet (muck com pend)
  (sorge[myth] c wet)
+  read_x
  '  Exact-path in-flight read (the dispatch hot path).
  \  pax=path wm=worm s=sov
  ^  maybe[myth]
  =  > c s.top
  =  > com
       ?  s.x_query(c pax)
        > ($known t=myth)  ($some t)
        > $null  $none
        > $unknown  $none
  =  > tl wm.toil
  ?  tl.get(pax)
   > $none  com
   > ($some w=writ)
     ?  w
      > ($make t=myth)  ($some t)
      > ($poke t=myth)
        ?  com
         > ($some cur=myth)
           =  > m cur.meld(t)
           ($some m)
         > $none  ($some t)
      > $cull  $none
+  exists
  \  pax=path wm=worm s=sov
  ^  nat
  ?  (read_x pax wm s)
   > ($some t=myth)  1
   > $none  0
+  resolve
  '  Resolve a myth's kook slot against the registry: the behavior
  '  list (default when absent or empty), or a failure.  The slot
  '  holds a pail; only a /kook value counts — anything else in the
  '  slot is 'kook_bad (the open remainder of the pail universe).
  \  t=myth reg=uon[form]
  ^  kres
  =  > ks (kook_slot 0)
  ?  t.get(ks)
   > $none  ($kf [(def_form 0)])
   > ($some pl=pail)
     ?  pl
      > k=kook
        =  > ids k.ids
        ?  (eq 0 ids.len)
           ($kf [(def_form 0)])
        |  > i=nat 0  > acc=row[form] []
        ^  kres
        ?  (eq i ids.len)
           ($kf acc)
        =  > id ids.at(i)
        ?  reg.get(id)
         > $none  ($ke 'kook_unknown)
         > ($some f=form)  (_ i.inc acc.snoc(f))
     ($ke 'kook_bad)
+  record
  '  Compose a writ into the transaction: toil holds at most one writ
  '  per path, prize the composed change kind.
  \  pax=path w=writ wm=worm
  ^  worm
  =  > tl wm.toil
  =  > w2 (writ_then tl.get(pax) w)
  =  > pz wm.prize
  =  > m2 (mode_then pz.get(pax) (writ_mode w))
  =  > wm1 wm.set_toil(tl.put(pax w2))
  wm1.set_prize(pz.put(pax m2))
+  ingest
  '  Route one activation's cards from node src: targets under src
  '  (reflexively) join this transaction's queue; everything else
  '  leaves as an outbound move carrying the one command.
  \  src=path cs=row[[p=path q=writ]] wm=worm
  ^  worm
  |  > i=nat 0  > acc=worm wm
  ?  (eq i cs.len)
     acc
  =  > h cs.at(i)
  ?  (pith_prefix src p)
     =  > dn acc.down
     (_ i.inc acc.set_down(dn.snoc((flue src p ($vine q)))))
  =  > uu acc.up
  (_ i.inc acc.set_up(uu.snoc((move src p q))))
+  thread_init
  '  Thread a myth through each behavior's init, concatenating cards.
  \  b=bowl fs=row[form] t0=myth
  ^  [cards=row[[p=path q=writ]] out=myth]
  |  > i=nat 0  > cs=row[[p=path q=writ]] []  > acc=myth t0
  ?  (eq i fs.len)
     [cs acc]
  =  > f fs.at(i)
  =  > g f.init
  =  > y (g b acc)
  =  > yc y.cards
  (_ i.inc cs.weld(yc) y.out)
+  thread_talk
  '  Thread the current myth through each talk; the add-myth rides
  '  unchanged (each activation sees the pre-talk state).
  \  b=bowl fs=row[form] cur=myth add=myth
  ^  [cards=row[[p=path q=writ]] out=myth]
  |  > i=nat 0  > cs=row[[p=path q=writ]] []  > acc=myth cur
  ?  (eq i fs.len)
     [cs acc]
  =  > f fs.at(i)
  =  > g f.talk
  =  > y (g b acc add)
  =  > yc y.cards
  (_ i.inc cs.weld(yc) y.out)
+  thread_take
  \  b=bowl fs=row[form] cur=myth gift=axal[mode]
  ^  [cards=row[[p=path q=writ]] out=myth]
  |  > i=nat 0  > cs=row[[p=path q=writ]] []  > acc=myth cur
  ?  (eq i fs.len)
     [cs acc]
  =  > f fs.at(i)
  =  > g f.take
  =  > y (g b acc gift)
  =  > yc y.cards
  (_ i.inc cs.weld(yc) y.out)
+  thread_hear
  \  b=bowl fs=row[form] cur=myth rely=row[dep]
  ^  [cards=row[[p=path q=writ]] out=myth]
  |  > i=nat 0  > cs=row[[p=path q=writ]] []  > acc=myth cur
  ?  (eq i fs.len)
     [cs acc]
  =  > f fs.at(i)
  =  > g f.hear
  =  > y (g b acc rely)
  =  > yc y.cards
  (_ i.inc cs.weld(yc) y.out)
+  dispatch
  '  Run one work unit against the transaction.
  \  f=flue wm=worm s=sov reg=uon[form]
  ^  wend
  =  > wm1 wm.set_now(wm.now.inc)
  =  > kk (read $y f.dst wm1 s)
  =  > b (bowl f.src f.dst wm1.now wm1.eny kk)
  =  > dst f.dst
  ?  f.job
   > ($take g=axal[mode])
     ?  (read_x dst wm1 s)
      > $none  ($bad 'take_missing)
      > ($some cur=myth)
        ?  (resolve cur reg)
         > ($ke e=quip)  ($bad e)
         > ($kf fs=row[form])
           =  > r (thread_take b fs cur g)
           =  > wm2 (record dst ($poke out) wm1)
           ($go (ingest dst cards wm2))
   > ($hear rr=row[dep])
     ?  (read_x dst wm1 s)
      > $none  ($bad 'hear_missing)
      > ($some cur=myth)
        ?  (resolve cur reg)
         > ($ke e=quip)  ($bad e)
         > ($kf fs=row[form])
           =  > r (thread_hear b fs cur rr)
           =  > wm2 (record dst ($poke out) wm1)
           ($go (ingest dst cards wm2))
   > ($vine w=writ)
     ?  w
      > $cull
        ($go (record dst $cull wm1))
      > ($make t=myth)
        ?  (resolve t reg)
         > ($ke e=quip)  ($bad e)
         > ($kf fs=row[form])
           =  > r (thread_init b fs t)
           =  > wm2 (record dst ($make out) wm1)
           ($go (ingest dst cards wm2))
      > ($poke t=myth)
        ?  (read_x dst wm1 s)
         > $none  ($bad 'poke_missing)
         > ($some cur=myth)
           =  > u cur.meld(t)
           ?  (resolve u reg)
            > ($ke e=quip)  ($bad e)
            > ($kf fs=row[form])
              =  > r (thread_talk b fs cur t)
              =  > wm2 (record dst ($poke out) wm1)
              ($go (ingest dst cards wm2))
+  raid
  '  The gift cascade.  Each prized path is grouped under its nearest
  '  existing strict ancestor (existence is the in-flight view; the
  '  root contributes nothing), and one take per parent joins the
  '  queue, carrying the changed paths relative to that parent.  Take
  '  results are poke writes, so the prize repopulates strictly
  '  upward until it drains at the top.
  \  wm=worm s=sov
  ^  worm
  =  > pz wm.prize
  =  > es pz.tap
  =  > gam
       |  > i=nat 0  > acc=axal[axal[mode]] (axal/new[axal[mode]] $none)
       ?  (eq i es.len)
          acc
       =  > h es.at(i)
       ?  (le p.len 1)
          (_ i.inc acc)
       =  > par
            |  > k=nat p.len.dec
            ^  maybe[path]
            ?  (eq k 0)
               $none
            =  > pre p.take(k)
            ?  (exists pre wm s)
               ($some pre)
            (_ k.dec)
       ?  par
        > $none  (_ i.inc acc)
        > ($some pp=path)
          =  > g0 acc.gut(pp (axal/new[mode] $none))
          =  > rel p.drop(pp.len)
          =  > g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  > gs gam.tap
  =  > wm1
       |  > i=nat 0  > acc=worm wm
       ?  (eq i gs.len)
          acc
       =  > h gs.at(i)
       =  > dn acc.down
       (_ i.inc acc.set_down(dn.snoc((flue p p ($take q)))))
  wm1.set_prize((axal/new[mode] $none))
+  vine_flue
  '  One command becomes one work unit rooted at /out.
  \  p=path w=writ
  ^  flue
  (flue ['out] p ($vine w))
+  invert
  '  Turn news (changed path -> cared subscribers) into subscriber ->
  '  cared changed paths, skipping remote (/xeno) subscribers.
  \  news=axal[row[dep]]
  ^  axal[row[dep]]
  =  > es news.tap
  |  > i=nat 0  > acc=axal[row[dep]] (axal/new[row[dep]] $none)
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  =  > chg p
  =  > acc2
       |  > j=nat 0  > a2=axal[row[dep]] acc
       ?  (eq j q.len)
          a2
       =  > e q.at(j)
       =  > sub e.p
       ?  (is_xeno sub)
          (_ j.inc a2)
       =  > cur a2.gut(sub [])
       (_ j.inc a2.put(sub cur.snoc((dep e.c chg))))
  (_ i.inc acc2)
+  hear_flues
  \  subs=axal[row[dep]]
  ^  row[flue]
  =  > es subs.tap
  |  > i=nat 0  > acc=row[flue] []
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  (_ i.inc acc.snoc((flue p p ($hear q))))
+  eyes
  '  The watcher index: watched path -> its cared watchers, in the
  '  same dep orientation as news (p is the watcher).
  axal[row[dep]]
+  fires
  '  The grade a sign gives one care: nonzero means that care's
  '  perspective of the path moved.
  \  c=care g=sign
  ^  nat
  ?  c
   > $x  g.x
   > $y  g.y
   > $z  g.z
+  react
  '  The reactivity machine: match one event's change signs against
  '  the watcher index.  A watcher fires when its care's grade at
  '  its watched path is nonzero; fired subscriptions are consumed
  '  (lazy reactivity: one notification, watchers re-arm by reading)
  '  and unfired ones survive.  Returns the kernel's news — feed it
  '  back as a ($hear news) task — and the updated index.  The
  '  driver's cycle is run_event -> react on the ripe signs -> hear.
  \  signs=axal[sign] ey=eyes
  ^  [news=axal[row[dep]] rest=eyes]
  =  > es ey.tap
  |  > i=nat 0  > nw=axal[row[dep]] (axal/new[row[dep]] $none)  > rs=eyes (axal/new[row[dep]] $none)
  ?  (eq i es.len)
     [nw rs]
  =  > h es.at(i)
  =  > wat p
  ?  signs.get(wat)
   > $none  (_ i.inc nw rs.put(wat q))
   > ($some g=sign)
     =  > split
          |  > j=nat 0  > hot=row[dep] []  > cool=row[dep] []
          ^  [hot=row[dep] cool=row[dep]]
          ?  (eq j q.len)
             [hot cool]
          =  > e q.at(j)
          ?  (fires e.c g)
             (_ j.inc hot.snoc(e) cool)
          (_ j.inc hot cool.snoc(e))
     =  > nw2
          ?  (eq 0 hot.len)
             nw
          nw.put(wat hot)
     =  > rs2
          ?  (eq 0 cool.len)
             rs
          rs.put(wat cool)
     (_ i.inc nw2 rs2)
+  grind
  '  The worm loop: pop and dispatch until the queue drains; a
  '  nonempty prize then raids and the loop resumes; when both are
  '  empty the fate seals — writes in tap (lte_pith) order, effects
  '  as accumulated, the ack riding through.
  \  dn=row[flue] ack=maybe[path] reg=uon[form] eny=nat s=sov
  ^  doom
  =  > w0 (worm (axal/new[writ] $none) dn 0 [] (axal/new[mode] $none) 0 eny)
  |  > st=wend ($go w0)
  ?  st
   > ($bad e=quip)  ($fail e)
   > ($go wm=worm)
     ?  (lt wm.dcur wm.down.len)
        =  > f wm.down.at(wm.dcur)
        =  > wm1 wm.set_dcur(wm.dcur.inc)
        (_ (dispatch f wm1 s reg))
     ?  wm.prize.wyt
        (_ ($go (raid wm s)))
     =  > tl wm.toil
     ($done (fate tl.tap wm.up) ack)
+  kernel
  '  One event against the committed state: a fate (acked with the
  '  command's path tag for vine events), or a failure.
  \  t=task reg=uon[form] eny=nat s=sov
  ^  doom
  ?  t
   > ($vine p=path w=writ)
     (grind [(vine_flue p w)] ($some p) reg eny s)
   > ($hear news=axal[row[dep]])
     =  > subs (invert news)
     ?  (eq 0 subs.wyt)
        ($fail 'hear_no_subs)
     (grind (hear_flues subs) $none reg eny s)
+  commit
  '  Apply a fate to the sovereign: writs become step diffs verbatim
  '  (the namespace melds pokes and adjusts versioning), one case for
  '  the whole event.  Apollo time and PKI blockheight are zeroed in
  '  this port — the runtime supplies them a layer out.
  \  f=fate s=sov
  ^  [state=sov signs=axal[sign]]
  =  > ws f.write
  =  > diffs
       |  > i=nat 0  > acc=axal[note] (axal/new[note] $none)
       ?  (eq i ws.len)
          acc
       =  > h ws.at(i)
       ?  q
        > ($make t=myth)  (_ i.inc acc.put(p (note/make t)))
        > ($poke t=myth)  (_ i.inc acc.put(p (note/poke t)))
        > $cull  (_ i.inc acc.put(p (note/cull)))
  s.step(diffs 0 0)
+  run_event
  '  The full cycle: run the kernel and, on success, commit — the new
  '  sovereign, the outbound moves, and the step's change signs.  On
  '  failure the sovereign is untouched.
  \  t=task reg=uon[form] eny=nat s=sov
  ^  ovum
  ?  (kernel t reg eny s)
   > ($fail e=quip)  ($fail e)
   > ($done f=fate a=maybe[path])
     =  > r (commit f s)
     =  > fx f.effects
     ($ripe state fx signs a)
