-  sept [order=10]
-  shrine_types [order=20]
-  shrine [order=30]
'  lain: the reactive application layer over the shrine namespace — a
'  pure port of the neo-lazy kernel's core loop.
'  .
'  Values in the namespace are pails: the open union of every nominal
'  row type, tagged by the branded head of the value itself — the
'  path in the head constructor IS the type tag.  Slots hold pails;
'  the kernel reads the slots it understands (the /kook behavior
'  list) by matching their heads, and everything else rides opaquely.
'  .
'  The kernel is a stateless transition function: it reads the
'  committed namespace through /sov queries, accumulates writes in a
'  per-event transaction (/worm), and returns a /fate — the ordered
'  write list plus outbound effects — or fails, discarding the whole
'  event (no partial writes can escape: writes exist only in the worm
'  until /commit).  /run_event closes the cycle by committing a fate
'  through /sov/step .
'  .
'  Scope notes: overlay (%over) redirects and validation hooks are
'  deferred; dead/goof are vocabulary only.  Dependency hydration is
'  live: a record's /sys/crew slot maps indexical slot names to
'  (care, path) reads, and every dispatch hands their in-flight
'  views to the behavior as bowl crew, keyed by those same slots.
'  The source's per-event read cache is skipped
'  (reads here are pure) and its vestigial sibling queue is omitted.
'  Commands arrive one at a time, each tagged with its target path —
'  the tag rides through to the /doom ack.  Behavior arms return flat
'  card rows (path-tagged writs); outbound moves carry one command
'  each.
'  .
'  Time travel: /h/care/case/len/...path is a read-only overlay that
'  resolves (care, case) against the first len path segments through
'  the sov's historical queries and dips the rest into the answer
'  (/h_peek).  Writes under /h fail the event; /h answers at minted
'  cases never change, so subscriptions into /h are throwaway.
+  care
  '  Read restriction: the node only (.x), the node plus its frontier
  '  — the nearest record-bearing descendants, transparent paths passing
  '  through (.y) — or the whole subtree (.z).
  &  care/x
     care/y
     care/z

  +  x
    :

  +  y
    :

  +  z
    :
+  dep
  '  One cared path: a (care, path) pair.  News carries them as
  '  subscriptions (p is the subscriber); hear arms receive them as
  '  changes (p is the changed path).
  :  c=care p=path
+  kook
  '  The value of the well-known behavior slot: a list of form-node
  '  refs — namespace paths, each read directly at resolution.  Any
  '  node holding a form at ['form] is thereby a registry entry, so
  '  behaviors are rerootable; the kernel's own live under /kook by
  '  convention (kook_root).
  :  refs=row[path]
+  crew
  '  A node's dependencies: a map from SLOT to (care, path) dep.
  '  The key is purely indexical — a local name, exactly like a
  '  myth's slot keys — so behaviors find their views by name and
  '  the watched paths can move without them noticing.
  mop[path dep lt_pith]
  +  sing
    '  A crew of one: a single named dependency.
    \  slot=path d=dep
    ^  crew
    (mop/put[path dep lt_pith] slot d (mop/empty))
+  cpail
  '  The value of the well-known /sys/crew slot.
  :  =crew
+  pails
  '  The simple pail wrappers: one payload each, distinguished only
  '  by their brand — the brand IS the meaning, so hosts and the
  '  explorer unwrap by rep.
  +  n
    '  A nat payload, rendered as decimal.
    :  n=nat
  +  t
    '  A text cord.  The explorer renders it verbatim (a pails/n
    '  would print as decimal digits).  The /boot mirror uses it
    '  for source text, entry kinds, and documentation.
    :  t=nat
  +  q
    '  A iota payload — behavior ids riding as slot values.
    :  q=iota
  +  p
    '  A path payload — request targets riding as slot values.
    :  p=path
  +  code
    '  A compiled entry riding opaquely in the namespace: the /boot
    '  mirror stores each declaration's compiled value here.  The nat
    '  is the untyped carrier (the value may be a law, row, or pin) —
    '  read it back out, never do arithmetic on it.
    :  v=nat
  +  ps
    '  A row-of-paths payload — the /boot mirror's reference lists
    '  riding as slot values.
    :  ps=row[path]
+  pd
  '  A data pail.
  \  x=nat
  ^  pail
  (pails/n x)
+  limb
  '  Limb constructors for the common wrappers: one idiom for every
  '  slot creation — t.add((limb/nat ['n] 7)).
  +  nat
    \  s=path n=nat
    ^  limb
    (limb s (pails/n n))
  +  txt
    \  s=path t=nat
    ^  limb
    (limb s (pails/t t))
  +  iota
    \  s=path q=iota
    ^  limb
    (limb s (pails/q q))
  +  pat
    \  s=path p=path
    ^  limb
    (limb s (pails/p p))
+  myth
  '  Slot readers, unwrapping the common pails by rep.
  +  nat_at
    '  Read a data slot, with default.
    \  slot=path d=nat t=myth
    ^  nat
    ?  t.get(slot)
     > .none  d
     > (./some pl=pail)
       ?  pl
        > x=pails/n  x.n
       d
  +  txt_at
    '  Read a text slot: the pails/t cord at slot, or 0.
    \  slot=path t=myth
    ^  nat
    ?  t.get(slot)
     > .none  0
     > (./some pl=pail)
       ?  pl
        > x=pails/t  x.t
       0
  +  code_at
    '  Read a compiled-value slot: the code pail's payload at slot,
    '  or 0.
    \  slot=path t=myth
    ^  nat
    ?  t.get(slot)
     > .none  0
     > (./some pl=pail)
       ?  pl
        > x=pails/code  x.v
       0
  +  quip_at
    '  Read a iota slot: the pails/q payload at slot, if any.
    \  slot=path t=myth
    ^  maybe[iota]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/q  (./some x.q)
       .none
  +  pail_at
    '  Read a slot's raw pail, or a zero pails/n when absent —
    '  host-side consumers unwrap by rep (the brand cord rides in
    '  the head).
    \  slot=path t=myth
    ^  pail
    ?  t.get(slot)
     > (./some pl=pail)  pl
     > .none  (pd 0)
  +  has_at
    '  Whether the myth has anything at slot — a monomorphic wrapper
    '  over the mop method, so hosts can call it across the FFI.
    \  slot=path t=myth
    ^  nat
    t.has(slot)
+  mode
  '  What kind of change happened at a path.
  &  mode/add
     mode/dif
     mode/del

  +  add
    :

  +  dif
    :

  +  del
    :
+  writ
  '  A pending write: replace the myth, merge into it, or delete the
  '  node.
  &  writ/make
     writ/poke
     writ/cull

  +  make
    :  =myth

  +  poke
    :  =myth

  +  cull
    :
+  move
  '  An outbound effect: one command, emitted at src, addressed
  '  outside the processed subtree.
  :  src=path dst=path w=writ
+  job
  '  What a dispatch sees: a command (the target is the flue's dst),
  '  a child-change gift, or a dependency-change notification of
  '  (care, path) pairs.
  &  job/vine
     job/take
     job/hear

  +  vine
    :  w=writ

  +  take
    :  gift=axal[mode]

  +  hear
    :  changed=row[dep]
+  flue
  '  A linearized work unit: who caused it, where it lands, what it is.
  :  src=path dst=path job=job
+  bowl
  '  Per-activation context.  now is a logical clock, +1 per
  '  activation within the event; kids is the in-flight care-y view
  '  of the node's own subtree; crew holds the hydrated dependency
  '  views the node declared in its /sys/crew slot, keyed by their
  '  indexical slot names.
  :  src=path here=path now=nat eny=nat kids=axal[myth] crew=mop[path axal[myth] lt_pith]
+  yell
  '  What an arm returns: cards (path-tagged writs) to emit and the
  '  node's new state.
  :  cards=row[[p=path q=writ]] out=myth
+  form
  '  A behavior: six laws over (bowl, state, input).  dead and goof
  '  are vocabulary only in this port — never invoked.
  :  init={bowl; myth; yell}
     talk={bowl; myth; myth; yell}
     take={bowl; myth; axal[mode]; yell}
     hear={bowl; myth; row[dep]; yell}
     dead={bowl; myth; yell}
     goof={bowl; myth; yell}
+  def_init
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_talk
  '  Default talk: union, the poke wins.
  \  b=bowl cur=myth add=myth
  ^  yell
  =  > o cur.meld(add)
  (yell [] o)
+  def_take
  \  b=bowl cur=myth g=axal[mode]
  ^  yell
  (yell [] cur)
+  def_hear
  \  b=bowl cur=myth r=row[dep]
  ^  yell
  (yell [] cur)
+  def_dead
  \  b=bowl t=myth
  ^  yell
  (yell [] t)
+  def_form
  '  The default behavior: init/talk as documented, take/hear keep
  '  state.
  ^  form
  (form def_init def_talk def_take def_hear def_dead def_dead)
+  kres
  '  Kook resolution: the behavior list, or a failure code.
  &  kres/kf
     kres/ke

  +  kf
    :  forms=row[form]

  +  ke
    :  err=iota
+  task
  '  One top-level event: a single path-tagged command, or change
  '  notifications (changed path -> its cared subscribers, as /dep
  '  pairs).
  &  task/vine
     task/hear

  +  vine
    :  p=path w=writ

  +  hear
    :  news=axal[row[dep]]
+  fate
  '  The kernel's answer: writes ordered by /lte_pith (tap order) and
  '  outbound effects.
  :  write=row[[p=path q=writ]] effects=row[move]
+  worm
  '  The per-event transaction.  down is a row+cursor queue (pop at
  '  dcur, push snoc).  prize records how each path changed, for the
  '  gift cascade.
  :  toil=axal[writ] down=row[flue] dcur=nat up=row[move] prize=axal[mode] now=nat eny=nat
+  wend
  '  The loop accumulator: a live transaction or an aborted one.
  &  wend/go
     wend/bad

  +  go
    :  =worm

  +  bad
    :  err=iota
+  doom
  '  The kernel outcome for one event.  A successful vine event acks
  '  with the command's path tag; hear events ack .none.
  &  doom/done
     doom/fail

  +  done
    :  =fate ack=maybe[path]

  +  fail
    :  err=iota
+  ovum
  '  The full-cycle outcome: new sovereign, outbound moves, the step's
  '  change signs, and the command's ack (its path tag; .none for hear
  '  events) — or a failure with the sovereign untouched.
  &  ovum/ripe
     ovum/fail

  +  ripe
    :  state=sov effects=row[move] signs=axal[sign] ack=maybe[path]

  +  fail
    :  err=iota
+  kook_slot
  '  The well-known slot holding a node's behavior id list.
  ^  path
  ['sys 'kook]
+  crew_slot
  '  The well-known slot holding a node's dependency map.
  ^  path
  ['sys 'crew]
+  is_xeno
  '  Is this path remote (under /xeno)?
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     0
  (eq_iota p.at(0) 'xeno)
+  is_io
  '  Is this path under the driver boundary (/io)?  Crew-derived
  '  subscriptions skip such nodes: their reactivity belongs to the
  '  driver (tells and spies), not kernel hears.
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     0
  (eq_iota p.at(0) 'io)
+  is_h
  '  Is this path under the temporal-transposition overlay (/h)?
  '  Read-only and derived: writes here fail the event.
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     0
  (eq_iota p.at(0) 'h)
+  log_root
  '  The event journal: one node per accepted post-boot epoch,
  '  /log/<epoch>, holding the driving task, its ack, and its
  '  outbound effects.  Commit-owned — kernel writes here fail the
  '  event, and crew subscriptions to /log are skipped, so the
  '  journal never feeds back into reactivity.  Signs for /log
  '  paths still mint but are inert (no eyes ever match them).
  ^  path
  ['log]
+  is_log
  '  Is this path under the event journal (/log)?
  \  p=path
  ^  nat
  ?  (eq 0 p.len)
     0
  (eq_iota p.at(0) 'log)
+  log_card
  '  One journal entry: the input event verbatim, the ack it earned,
  '  and the outbound moves it produced.  Rides as the ['ev] slot of
  '  the /log/<epoch> node, committed in the event's own step.
  :  t=task ack=maybe[path] fx=row[move]
+  dig_parse
  '  A cord of decimal digits as a nat; .none if empty or non-digit.
  \  s=nat
  ^  maybe[nat]
  ?  (eq 0 s)
     .none
  |  > x=nat s  > acc=nat 0
  ^  maybe[nat]
  ?  (eq 0 x)
     (./some acc)
  =  > b (mod x 256)
  ?  (lt b 48)
     .none
  ?  (gt b 57)
     .none
  (_ (div x 256) (add (mul acc 10) (sub b 48)))
+  dig_of
  '  A case/len path segment as a nat.  Digit segments arrive as u
  '  u iotas now that URL segments run the aura codec, so only the u
  '  arm remains.
  \  i=iota
  ^  maybe[nat]
  ?  i
   > ($u x=nat)  (./some x)
  .none
+  dig_cord
  '  A nat as a decimal cord.
  \  n=nat
  ^  nat
  ?  (eq 0 n)
     "0"
  |  > x=nat n  > acc=nat 0
  ?  (eq 0 x)
     acc
  (_ (div x 10) (add (add 48 (mod x 10)) (mul acc 256)))
+  dig_show
  '  A nat as a path segment: a u iota, which prints as bare decimal.
  '  (A decimal ts cord would no longer even print — symbols cannot
  '  start with a digit.)
  \  n=nat
  ^  iota
  ($u n)
+  writ_mode
  \  w=writ
  ^  mode
  ?  w
   > (./make t=myth)  .add
   > (./poke t=myth)  .dif
   > .cull  .del
+  mode_then
  '  Compose a later change kind onto an earlier one at the same path.
  \  old=maybe[mode] new=mode
  ^  mode
  ?  old
   > .none  new
   > (./some m=mode)
     ?  m
      > .add
        ?  new
         > .del  .del
         > .add  .add
         > .dif  .add
      > .del
        ?  new
         > .add  .add
         > .del  .del
         > .dif  .del
      > .dif  new
+  writ_then
  '  Compose a later writ onto a pending one at the same path, so the
  '  transaction holds at most one writ per path.
  \  old=maybe[writ] new=writ
  ^  writ
  ?  old
   > .none  new
   > (./some ow=writ)
     ?  new
      > (./make t=myth)  new
      > .cull  new
      > (./poke t=myth)
        ?  ow
         > (./make ot=myth)
           =  > m ot.meld(t)
           (./make m)
         > (./poke ot=myth)
           =  > m ot.meld(t)
           (./poke m)
         > .cull  (./make t)
+  h_care
  '  The care segment of an /h path.
  \  i=iota
  ^  maybe[care]
  ?  (eq_iota i 'x)
     (./some .x)
  ?  (eq_iota i 'y)
     (./some .y)
  ?  (eq_iota i 'z)
     (./some .z)
  .none
+  h_mark
  '  A marker record for structural /h nodes.
  \  d=nat
  ^  myth
  =  > t myth/new
  t.put(['doc] (pails/t d))
+  h_epic
  '  The (care, case) resolution at the target, as a subtree: x is
  '  the lone record, y the record plus its nearest-live frontier, z the full
  '  snapshot.  Tombstones and shrugs are the empty tree.
  \  cr=care c=nat tgt=path s=sov
  ^  axal[myth]
  =  > none (axal/new[myth] .none)
  ?  cr
   > .x
     ?  s.x_query(c tgt)
      > (./known t=myth)  (axal/new[myth] (./some t))
      > .null  none
      > .unknown  none
   > .y
     ?  s.y_query(c tgt)
      > (./known fat=axal[myth])  fat
      > .null  none
      > .unknown  none
   > .z
     ?  s.z_query(c tgt)
      > (./known fat=axal[myth])  fat
      > .null  none
      > .unknown  none
+  h_ver
  '  The version view of a path, as of top: its independent local
  '  data and shape counters per care, plus the latest assertion's
  '  mint time and blockheight, as decimal pails/t entries.  Case links are
  '  target-relative and rendered separately by the explorer.
  '  Unlike the case overlays this view is LIVE: it advances as new
  '  cases mint (but never signs — /h is writeless).
  \  tgt=path s=sov
  ^  axal[myth]
  =  > none (axal/new[myth] .none)
  =  > h s.hist(tgt)
  =  > ev s.ever_at(tgt)
  =  > used (add ev.x.lock.data (add ev.y.lock.data ev.z.lock.data))
  ?  (eq 0 used)
     none
  =  > t0 myth/new
  =  > st
       ?  (hres s.top h)
        > (./known w=myth)  "live"
        > .null  "tombstone"
        > .unknown  "unknown"
  =  > tm
       ?  (hyuga s.top h)
        > (./some yg=yuga)  [yg.now yg.block]
        > .none  [0 0]
  =  > r1 t0.put(['state] (pails/t st))
  =  > r2 r1.put(['x_data] (pails/t (dig_cord ev.x.lock.data)))
  =  > r3 r2.put(['x_shape] (pails/t (dig_cord ev.x.lock.shape)))
  =  > r4 r3.put(['y_data] (pails/t (dig_cord ev.y.lock.data)))
  =  > r5 r4.put(['y_shape] (pails/t (dig_cord ev.y.lock.shape)))
  =  > r6 r5.put(['z_data] (pails/t (dig_cord ev.z.lock.data)))
  =  > r7 r6.put(['z_shape] (pails/t (dig_cord ev.z.lock.shape)))
  =  > r8 r7.put(['now] (pails/t (dig_cord tm.at(0))))
  =  > rec r8.put(['block] (pails/t (dig_cord tm.at(1))))
  (axal/new[myth] (./some rec))
+  h_prefix
  '  A structural /h node above the target.  Local cases cannot be
  '  resolved until the complete target is known, so case-first
  '  paths deliberately do not enumerate historical children here.
  \  c=nat p=path s=sov
  ^  axal[myth]
  (axal/new[myth] (./some (h_mark "the target path continues below; cases are target-local, so incomplete targets have no historical child listing")))
+  h_peek
  '  Time travel: /h/care/case/len/...path resolves (care, case)
  '  against the first len path segments via the sov's historical
  '  queries and dips the remainder into the answer.  Structural
  '  levels above the target carry non-enumerating markers because a
  '  local case has no meaning until the target is complete.
  '  Committed-only, and constant: nothing is ever
  '  written under /h, so a given /h path's answer never changes once
  '  known — subscriptions here are throwaway.
  \  pax=path s=sov
  ^  axal[myth]
  =  > none (axal/new[myth] .none)
  =  > n pax.len
  ?  (lt n 2)
     =  > a0 (axal/new[myth] (./some (h_mark "time travel: /h/care/case/len/...path resolves (care, case) against the first len segments of the path and dips the rest into the answer. x is the record, y adds the nearest-live frontier, z the whole subtree. /h/v/len/...path is the version view. read only.")))
     =  > a1 a0.put(['x] (h_mark "x at a case: the record alone"))
     =  > a2 a1.put(['y] (h_mark "y at a case: the record and its nearest-live frontier"))
     =  > a3 a2.put(['z] (h_mark "z at a case: the whole subtree"))
     a3.put(['v] (h_mark "version info: path-local data and shape counters plus mint time"))
  ?  (eq_iota pax.at(1) 'v)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "below: /len/...path")))
     ?  (dig_of pax.at(2))
      > .none  none
      > (./some ln=nat)
        =  > p pax.drop(3)
        ?  (lt p.len ln)
           (h_prefix s.top p s)
        =  > tgt p.take(ln)
        =  > rel
             =  > r0 p.drop(ln)
             |  > i=nat 0  > acc=path []
             ?  (eq i r0.len)
                acc
             =  > k r0.at(i)
             ?  (dig_of k)
              > (./some cn=nat)  (_ i.inc acc.snoc(($u cn)))
              > .none  (_ i.inc acc.snoc(k))
        =  > vt (h_ver tgt s)
        vt.dip(rel)
  ?  (h_care pax.at(1))
   > .none  none
   > (./some cr=care)
     ?  (eq n 2)
        (axal/new[myth] (./some (h_mark "cases are target-local; use /h/care/case/len/...target")))
     ?  (dig_of pax.at(2))
      > .none  none
      > (./some c=nat)
        ?  (eq c 0)
           none
        ?  (eq n 3)
           (axal/new[myth] (./some (h_mark "below: /len/...path")))
        ?  (dig_of pax.at(3))
         > .none  none
         > (./some ln=nat)
           =  > p pax.drop(4)
           ?  (lt p.len ln)
              (h_prefix c p s)
           =  > tgt p.take(ln)
           =  > rel p.drop(ln)
           =  > epic (h_epic cr c tgt s)
           epic.dip(rel)
+  peek
  '  The committed perspective: the subtree at pax as of s.top, piths
  '  relative to pax, no version metadata.  Reads the index directly
  '  (sov z_query is unknown unless pax itself is a node, which would
  '  blind in-flight reads under nodes made this event).
  '  /h paths divert to the temporal overlay.
  \  pax=path s=sov
  ^  axal[myth]
  ?  (is_h pax)
     (h_peek pax s)
  =  > c s.top
  =  > ix s.idx
  =  > sub ix.dip(pax)
  =  > es sub.tap
  |  > i=nat 0  > acc=axal[myth] (axal/new[myth] .none)
  ?  (eq i es.len)
     acc
  =  > h es.at(i)
  ?  (hres c (unpin q.held))
   > (./known t=myth)  (_ i.inc acc.put(p t))
   > .null  (_ i.inc acc)
   > .unknown  (_ i.inc acc)
+  muck
  '  Overlay a pending-writ subtree onto a committed subtree (both
  '  relative): make replaces, poke melds (or stands alone), cull
  '  deletes the value.
  \  base=axal[myth] pend=axal[writ]
