  ?  (eq 0 used)
     none
  =  > t0 myth/new
  =  > st
       ?  (ass/res s.top h)
        > (./known w=myth)  "live"
        > .null  "tombstone"
        > .unknown  "unknown"
  =  > tm
       ?  (ass/yuga s.top h)
