        > .none  (_ i.inc acc)
        > (./some pp=path)
          =  > g0 acc.gut(pp (axal/new[mode] .none))
          =  > rel p.drop(pp.len)
          =  > g1 g0.put(rel q)
          (_ i.inc acc.put(pp g1))
  =  > gs gam.tap
  =  > wm1
       |  > i=nat 0  > acc=worm wm
       ?  (eq i gs.len)
