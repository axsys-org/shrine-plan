   > (./some why=iota)
     (./rejected why)
   > .none
     =  > diffs2
          ?  journal
             =  > card  (log_card t a f.effects)
             diffs.put(['log (dig_show s.top.inc)]
                       (note/make (myth/sing ['ev] card)))
          diffs
     s.step(diffs2 0 0)
+  run_event_with
  '  The full cycle: run the kernel and, on success, commit — the new
  '  sovereign, the outbound moves, and the step's change signs.  On
  '  failure the sovereign is untouched.  journal selects whether
  '  the commit also writes the /log entry.
  \  journal=nat t=task eny=nat s=sov
  ^  ovum
  ?  (kernel t eny s)
   > (./fail e=iota)  (./fail e)
   > (./done f=fate a=maybe[path])
     ?  (commit t a journal f s)
      > (./rejected e=iota)  (./fail e)
      > (./accepted r=[state=sov signs=axal[sign]])
        =  > fx f.effects
        (./ripe state fx signs a)
+  run_event
  '  A journal-free event: seeding and probes — no /log entry.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with 0 t eny s)
+  fork
  '  Branching worlds.  /log is a complete causal tape — every
  '  accepted post-boot epoch stores its driving task verbatim — and
  '  the sovereign is a value, so a counterfactual is: rebuild the
  '  world as of epoch E, apply an intervention, and re-run the tape
  '  against it.  Replay is journal-free and DISCARDS effects, so a
  '  branch never reaches the network or the drivers: a recorded
  '  answer (an LLM reply, a fetch response) re-arrives as its own
  '  later tape entry, which makes replay deterministic by default.
  '  Refusals during replay are the findings — the writes the
  '  intervened world would not have accepted.

  +  miss
    '  One replay refusal: the trunk epoch whose task the branch
    '  refused, and the kernel's reason.
    :  ep=nat why=iota

  +  tree_at
    '  Every live record as of epoch ep, /log excluded — the branch
    '  reads the TRUNK's tape rather than carrying a copy.
    \  ep=nat s=sov
    ^  axal[myth]
    s.idx.tap.fold((axal/new[myth] .none) ;
      \  acc [p q]
      ?  (is_log p)
         acc
      ?  (ass/res ep (unpin q.held))
       > (./known t=myth)  acc.put(p t)
      acc)

  +  seed
    '  A fresh sovereign holding exactly this tree: one epoch, every
    '  record a make.  Records carrying their own ['sys 'lash] ride
    '  the adoption exemption, so a trunk with legacy contract debt
    '  still forks.
    \  fat=axal[myth]
    ^  maybe[sov]
    =  diffs
         fat.tap.fold((axal/new[note] .none) ;
           \  acc [p t]
           acc.put(p (note/make t)))
    =  s0  sov/new
    ?  s0.step(diffs 0 0)
     > (./accepted r=[state=sov signs=axal[sign]])  (./some state)
     > (./rejected e=iota)  .none

  +  at
    '  The world as of epoch ep, as its own sovereign.
    \  ep=nat s=sov
    ^  maybe[sov]
    (fork/seed (fork/tree_at ep s))

  +  card_at
    '  The trunk journal's entry at epoch ep, when one rides there
    '  (boot-era epochs are journal-free and read back as .none).
    \  ep=nat s=sov
    ^  maybe[log_card]
    ?  s.x_latest(log_root.snoc((dig_show ep)))
     > (./known t=myth)
       ?  t.get(['ev])
        > (./some held=pail)
          ?  held
           > c=log_card  (./some c)
          .none
        > .none  .none
     .none

  +  replay
    '  Fold the trunk tape from lo through hi into the branch: each
    '  entry's driving task re-runs as one journal-free event against
    '  the branch's own state.  The original reactive schedule rides
    '  along (hear tasks are tape entries too); effects are dropped.
    \  lo=nat hi=nat trunk=sov branch=sov
    ^  [b=sov played=nat missed=row[fork/miss]]
    |  > ep=nat lo  > b=sov branch  > n=nat 0  > ms=row[fork/miss] []
    ^  [b=sov played=nat missed=row[fork/miss]]
    ?  (gt ep hi)
       [b n ms]
    ?  (fork/card_at ep trunk)
     > .none  (_ ep.inc b n ms)
     > (./some c=log_card)
       ?  (run_event c.t 0 b)
        > (./ripe b2 fx sg a)  (_ ep.inc b2 n.inc ms)
        > (./fail e=iota)  (_ ep.inc b n ms.snoc((fork/miss ep e)))

  +  lines
    '  Refusal rows as one text block, capped — the verdict's
    '  human-readable evidence, each line a trunk epoch and a reason.
    \  ms=row[fork/miss]
    ^  nat
    =  cap
         ?  (gt ms.len 40)
            40
         ms.len
    =  body
         |  > i=nat 0  > acc=nat 0
         ?  (ge i cap)
            acc
         =  m  ms.at(i)
         =  ln  (cord/cat_all ["e" (dig_cord m.ep) " " (iota_show m.why)])
         ?  (eq i 0)
            (_ i.inc ln)
         (_ i.inc (cord/cat acc (cord/cat 10 ln)))
    ?  (gt ms.len cap)
       (cord/cat body (cord/cat 10 (cord/cat "+" (dig_cord (sub ms.len cap)))))
    body

  +  backtest
    '  The whole counterfactual, as one pure call: fork at `from`,
    '  poke `patch` at `at`, replay the tape from+1 through the
    '  trunk's top, and answer a verdict record — counts, bounds,
    '  and one line per refusal.  The trunk is untouched: the branch
    '  lives and dies inside this value, which is the point.
    \  from=nat at=path patch=myth s=sov
    ^  myth
    ?  (fork/at from s)
     > .none
       (myth/sing ['err] (pails/t "fork refused: the base tree would not seed"))
     > (./some b0=sov)
       ?  (run_event (./vine at (writ/poke patch)) 0 b0)
        > (./fail e=iota)
          (myth/sing ['err] (pails/t (cord/cat "the intervention was refused: " (iota_show e))))
        > (./ripe b1 fx sg a)
          =  [b2 n ms]  (fork/replay from.inc s.top s b1)
          .  (myth/new)
             put(['kind] (pails/t "backtest"))
             put(['from] (pd from))
             put(['to] (pd s.top))
             put(['at] (pails/p at))
             put(['played] (pd n))
             put(['refused] (pd ms.len))
             put(['note] (pails/t (fork/lines ms)))
+  run_event_log
  '  A journaled event: the live loop — every accepted epoch leaves
  '  its /log node.
  \  t=task eny=nat s=sov
  ^  ovum
  (run_event_with 1 t eny s)
+  gyre
  '  The reactive-cycle outcome: the final sovereign, all outbound
  '  moves, each round's signs (first = the driving event), and the
  '  driving event's ack — or a failure with the sovereign untouched.
  '  spill carries a cascaded hear round's failure when one stopped
  '  the cascade: the committed rounds stand, but the error is
  '  SURFACED, not swallowed — the driver decides how to report it.
  &  gyre/spun
     gyre/fail

  +  spun
    :  state=sov moves=row[move] rounds=row[axal[sign]] ack=maybe[path] spill=maybe[iota]

  +  fail
    :  err=iota
+  cycle_with
  '  /cycle over a kept crew index: each round bumps the caller's
  '  index from its own signs instead of re-deriving it from the
  '  whole namespace, and the index rides back out for the next
  '  event.  A failed event returns the index untouched — nothing
  '  committed, so nothing moved.
  \  hv=hive t=task eny=nat fuel=nat s=sov
  ^  [g=gyre hv2=hive]
  ?  (run_event_log t eny s)
   > (./fail e=iota)  [(./fail e) hv]
   > (./ripe s1=sov fx1=row[move] sg1=axal[sign] a=maybe[path])
     |  > cur=sov s1  > prev=sov s  > moves=row[move] fx1  > rounds=row[axal[sign]] [sg1]  > sg=axal[sign] sg1  > gas=nat fuel  > hz=hive (hive_bump hv sg1 s1)
     ^  [g=gyre hv2=hive]
     =  > rr (react sg (eyes_from hz))
     '  Lens deps translate against the PRE-round sov: the round's
     '  signs graded that state, and an /o answer's first change
     '  (an unminted pin minting) must wake its watcher.
     =  > lt (react_lens sg (lens_from hz prev)).tap
     =  > nws
          |  > i2=nat 0  > acc=axal[row[dep]] news
          ?  (eq i2 lt.len)
             acc
          =  > le lt.at(i2)
          (_ i2.inc acc.put(p q))
     ?  (eq 0 nws.wyt)
        [(./spun cur moves rounds a .none) hz]
     ?  (eq 0 gas)
        [(./spun cur moves rounds a .none) hz]
     ?  (run_event_log (./hear nws) eny cur)
      > (./fail e2=iota)  [(./spun cur moves rounds a (./some e2)) hz]
      > (./ripe s2=sov fx2=row[move] sg2=axal[sign] a2=maybe[path])
        =  > m2 moves.weld(fx2)
        =  > r2 rounds.snoc(sg2)
        (_ s2 cur m2 r2 sg2 gas.dec (hive_bump hz sg2 s2))
+  cycle
  '  Run one external event, then let the namespace react to itself:
  '  derive the eyes from every crew, match the signs, and feed the
  '  news back as hear events until quiet — or until fuel runs out
  '  (apps may legally self-loop; the cap bounds them).  A failed
  '  hear round stops the cascade, keeping the rounds that committed.
  '  Every accepted round journals: one /log node per epoch.
  '  The index is derived here and dropped; a driver that runs many
  '  events keeps one across them with /cycle_with.
  \  t=task eny=nat fuel=nat s=sov
  ^  gyre
  =  [g=gyre hv2=hive]  (cycle_with (hive_of s) t eny fuel s)
  g
