  '  THE derived-namespace resolver: the cr-shaped answer for pax at
  '  case c, where c=0 means latest.  Real paths answer from the
  '  sov's cased queries.  /h paths recurse on their target — so a
  '  target under /o resolves through the lens — and are constant:
  '  they answer only at c=0 or c=1.  /o paths resolve their overlay
  '  function at the pinned case (the opath may itself be derived),
  '  read their data at c through this same resolver — so data under
  '  /h or nested /o composes — apply get, and shape the result by
  '  cr.  Recursion terminates because every embedded path is
  '  strictly shorter than the path carrying it.  Structural markers
  '  live in the peeks, not here: an incomplete derived path is a
  '  shrug.
  \  cr=care c=nat pax=path s=sov
  ^  res[axal[myth]]

  ?  (is_h pax)
     ?>  (./some hp) (h_parse pax)
         .unknown
     ?  (gt c 1)
        .unknown
     =  [hcr hc hep tgt rel]  hp
     =  got=res[axal[myth]]
          ?  hep
             ?  hcr
              > .x
                ?  s.x_at(hep tgt)
                 > (./known t=myth)  (./known (axal/new[myth] (./some t)))
                 > .null  .null
                 > .unknown  .unknown
              > .y  s.y_at(hep tgt)
              > .z  s.z_at(hep tgt)
          (_ hcr hc tgt s)
     ?>  (./known fat) got
         .unknown
     =  sub  fat.dip(rel)
     ?  (eq 0 sub.tap.len)
        .unknown
     (./known (sorge[myth] cr sub))

  ?  (is_o pax)
     ?>  (./some pr) (o_parse pax)
         .unknown
     =  [cpin op dp rel]  pr
     ?>  (./known wfat) (_ .x cpin op s)
         .unknown
     ?>  (./some wm) wfat.fil
         .unknown
     ?>  (./some wf) wm.get(bond/weft)
         .unknown
     =  built=res[axal[myth]]
          ?  wf
           > d=dyed
             ?>  (./known dt) (_ .x c dp s)
                 .unknown
             ?>  (./some t) dt.fil
                 .unknown
             =  g  d.get
             (./known (axal/new[myth] (./some (g t))))
           > k=knit
             ?>  (./known dt) (_ .x c dp s)
                 .unknown
             ?>  (./some t) dt.fil
                 .unknown
             =  g  k.get
             (./known (g t))
           > f=felt
             ?>  (./known dt) (_ .z c dp s)
                 .unknown
             =  g  f.get
             (./known (axal/new[myth] (./some (g dt))))
           > w=sewn
             ?>  (./known dt) (_ .z c dp s)
                 .unknown
             =  g  w.get
             (./known (g dt))
           .unknown
