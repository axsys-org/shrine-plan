+  dispatch
  '  Run one work unit against the transaction.  The /h and /o
  '  overlays are read-only, and /log is commit-owned: any write
  '  landing on any of them fails the whole event.
  \  f=flue wm=worm s=sov
  ^  wend
  ?  (is_h f.dst)
     (./bad 'h_reserved)
  ?  (is_o f.dst)
     (./bad 'o_reserved)
  ?  (is_log f.dst)
     (./bad 'log_reserved)
  =  > wm1 wm.set_now(wm.now.inc)
  =  > kk (read .y f.dst wm1 s)
  =  > cw (crew_of (read_x f.dst wm1 s) wm1 s)
  =  > b (bowl f.src f.dst wm1.now wm1.eny kk cw)
  =  > dst f.dst
  ?  f.job
   > (./take g=axal[mode])
     ?  (read_x dst wm1 s)
      > .none  (./bad 'take_missing)
      > (./some cur=myth)
        '  No kook slot resolves to [def_form]; def_take emits no
        '  cards and keeps cur — record it directly, skipping the
        '  bowl and resolution walks (the seeding/cascade hot path).
        ?  cur.get(limb_slot)
         > .none  (./go (record dst (./poke cur) wm1))
         > (./some _)
           ?  (resolve cur wm1 s)
            > (./ke e=iota)  (./bad e)
            > (./kf fs=row[form])
              =  > r (thread_take b fs cur g)
              =  > wm2 (record dst (./poke out) wm1)
              (./go (ingest dst cards wm2))
   > (./hear rr=row[dep])
     ?  (read_x dst wm1 s)
      > .none  (./bad 'hear_missing)
      > (./some cur=myth)
        ?  (resolve cur wm1 s)
         > (./ke e=iota)  (./bad e)
         > (./kf fs=row[form])
           =  > r (thread_hear b fs cur rr)
           =  > wm2 (record dst (./poke out) wm1)
           (./go (ingest dst cards wm2))
   > (./vine w=writ)
     ?  w
      > .cull
        (./go (record dst .cull wm1))
