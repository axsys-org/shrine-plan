   > .x
     =  r
          ?  (eq 0 c)
             s.x_latest(pax)
          s.x_query(c pax)
     ?  r
      > (./known t=myth)  (./known (axal/new[myth] (./some t)))
      > .null  .null
      > .unknown  .unknown
