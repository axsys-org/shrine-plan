  ^  maybe[iota]
  ?  (lash_of t)
   > .none  .none
   > (./some l=lash)
     =  > ws t.tap
     =  > tybad
          |  > i=nat 0
          ^  bool
          ?  (ge i ws.len)
             .false
          =  > e ws.at(i)
          ?  l.write.get(e.key)
           > .none  (_ i.inc)
           > (./some cb=curb)
             ?  (curb_ok cb e.val)
