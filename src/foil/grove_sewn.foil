- publisher_vocabulary
- grove_norms

' Tree transformations retain both norm boundaries in their module.
+ grove_sewn
  + endpoint
    : reference=rex path=path
  + shape
    : source=grove_sewn/endpoint target=grove_sewn/endpoint
      code=row[rex]
  + is_sewn
    \ body=row[grove/statement]
    ^ bool
    | body.any
    \ stmt
    ? stmt
     > (grove/tag span kind) (equal kind (grove/tag_kind/sewn))
    .false
  + resolve
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      tree=rex
    ^ either[grove/error grove_sewn/endpoint]
    < parts (grove_roles/parts (rex/normalize tree))
    ? !(eq parts.len 1)
      | grove_roles/fail[grove_sewn/endpoint] tree.span
        "Transformation endpoints require a norm name or import alias."
    = name (str/from_atom (quip_val parts.at(0)))
      reference (rex/path [name]).with_span(tree.span)
    % rest=row[grove/item] doc.items
    ^ either[grove/error grove_sewn/endpoint]
    ? (eq rest.len 0)
      | grove_roles/fail[grove_sewn/endpoint] tree.span "Unknown norm."
    ? rest.at(0)
     > (grove/declaration span nam body)
      ? nam
       > (grove/name/identifier text)
        ? !(eq text name) (_ rest.drop(1))
        ? !(grove_norms/is_norm body)
          | grove_roles/fail[grove_sewn/endpoint] tree.span
            "Transformation endpoint is not a norm."
        | ./ok (grove_sewn/endpoint reference root.weld(parts))
      | _ rest.drop(1)
     > (grove/import_decl span alias target)
      ? !(eq name alias) (_ rest.drop(1))
      < path (grove_roles/parts (rex/normalize target))
      > (./some card) (lookup path)
        | grove_roles/fail[grove_sewn/endpoint] span
          "Missing norm import."
      > (./some held) card.get(publisher_vocabulary/grove/norm)
        | grove_roles/fail[grove_sewn/endpoint] span
          "Imported declaration has no norm schema."
      > schema=grove_norm_schema held
        | grove_roles/fail[grove_sewn/endpoint] span
          "Invalid norm schema."
      | ./ok (grove_sewn/endpoint reference path)
    | _ rest.drop(1)
  + implementation
    \ span=rex/source_span body=row[grove/statement]
    ^ either[grove/error row[rex]]
    % rest=row[grove/statement] body code=maybe[row[rex]] .none
    ^ either[grove/error row[rex]]
    ? (eq rest.len 0)
      ? code
       > (./some trees) (./ok trees)
       > .none
        | grove_roles/fail[row[rex]] span
          "get requires an explicit Foil implementation."
    ? rest.at(0)
     > (grove/comment at text) (_ rest.drop(1) code)
     > (grove/implementation at trees)
      ? code
       > (./some old)
        | grove_roles/fail[row[rex]] at "Duplicate get implementation."
       > .none
        ? (eq trees.len 0)
          | grove_roles/fail[row[rex]] at "Empty get implementation."
        | _ rest.drop(1) (./some trees)
    | grove_roles/fail[row[rex]] span
      "get contains only comments and an explicit Foil implementation."
  + finish
    \ span=rex/source_span source=maybe[grove_sewn/endpoint]
      target=maybe[grove_sewn/endpoint] code=maybe[row[rex]]
    ^ either[grove/error grove_sewn/shape]
    > (./some from) source
      | grove_roles/fail[grove_sewn/shape] span "Missing #from norm."
    > (./some to) target
      | grove_roles/fail[grove_sewn/shape] span "Missing #to norm."
    > (./some trees) code
      | grove_roles/fail[grove_sewn/shape] span "Missing get body."
    | ./ok (grove_sewn/shape from to trees)
  + analyze
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
      span=rex/source_span body=row[grove/statement]
    ^ either[grove/error grove_sewn/shape]
    % rest=row[grove/statement] body
      source=maybe[grove_sewn/endpoint] .none
      target=maybe[grove_sewn/endpoint] .none
      code=maybe[row[rex]] .none
    ^ either[grove/error grove_sewn/shape]
    ? (eq rest.len 0) (grove_sewn/finish span source target code)
    ? rest.at(0)
     > (grove/tag at kind)
      ? ((equal kind (grove/tag_kind/sewn)) ||
         (equal kind (grove/tag_kind/slot)))
        | _ rest.drop(1) source target code
      | grove_roles/fail[grove_sewn/shape] at "Incompatible sewn tag."
     > (grove/comment at text) (_ rest.drop(1) source target code)
     > (grove/directive at kind tree)
      ? (equal kind (grove/directive_kind/from))
        ? source
         > (./some old)
          | grove_roles/fail[grove_sewn/shape] at "Duplicate #from."
         > .none
          < endpoint (grove_sewn/resolve root doc lookup tree)
          | _ rest.drop(1) (./some endpoint) target code
      ? (equal kind (grove/directive_kind/to))
        ? target
         > (./some old)
          | grove_roles/fail[grove_sewn/shape] at "Duplicate #to."
         > .none
          < endpoint (grove_sewn/resolve root doc lookup tree)
          | _ rest.drop(1) source (./some endpoint) code
      | grove_roles/fail[grove_sewn/shape] at
        "Only #from and #to are supported on sewn declarations."
     > (grove/block at kind kids)
      ? (equal kind (grove/block_kind/meta))
        | _ rest.drop(1) source target code
      ? !(equal kind (grove/block_kind/get))
        | grove_roles/fail[grove_sewn/shape] at
          "Unsupported sewn block."
      ? code
       > (./some old)
        | grove_roles/fail[grove_sewn/shape] at "Duplicate get body."
       > .none
        < trees (grove_sewn/implementation at kids)
        | _ rest.drop(1) source target (./some trees)
    | grove_roles/fail[grove_sewn/shape] span
      "Sewn declarations use #from, #to, metadata, and a get body."
  + code
    \ span=rex/source_span name=str shape=grove_sewn/shape
    ^ row[rex]
    = pairs=row[[str rex]]
        [["SELF" (rex/path [name])]
         ["FROM" shape.source.reference] ["TO" shape.target.reference]]
      run
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " tree=axal[myth]"])
             "^ axal[myth]" "| SELF/get tree"]) pairs
      apply
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92) " tree=axal[myth]"])
             "^ maybe[axal[myth]]" "< input (FROM/check tree)"
             "| TO/check (SELF/run input)"]) pairs
      view
        | grove_roles/template span
          (str/join (str/from_atom 10)
            [(str/join "" [(str/from_atom 92)
                " args=myth tree=axal[myth]"])
             "^ axal[myth]" "? (SELF/apply tree)"
             " > (./some output) output"
             " > .none"
             "  ; (error (pails/p ['grove 'sewn_norm_failed]))"
             "  (axal/new[myth] .none)"]) pairs
      overlay
        | grove_roles/template span
          "(spun SELF/view .none)" pairs
      schema_value
        | rex/paren [(rex/word "grove_sewn_schema")
          (grove_roles/path_value shape.source.path)
          (grove_roles/path_value shape.target.path)
          (grove_roles/member ["schema"] shape.source.reference)
          (grove_roles/member ["schema"] shape.target.reference)]
      schema
        | grove_roles/template span
          (str/join (str/from_atom 10) ["^ grove_sewn_schema" "| VALUE"])
          [["VALUE" schema_value]]
    [(grove_roles/decl "get" (rex/group shape.code))
     (grove_roles/decl "run" run)
     (grove_roles/decl "apply" apply)
     (grove_roles/decl "schema" schema)
     (grove_roles/decl "view" view)
     (grove_roles/decl "overlay" overlay)]
  + prepare
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    % rest=row[grove/item] doc.items out=row[grove/item] []
    ^ either[grove/error grove/document]
    ? (eq rest.len 0) (./ok (grove/document out))
    > (grove/declaration span name body) rest.at(0)
      | _ rest.drop(1) out.snoc(rest.at(0))
    ? !(grove_sewn/is_sewn body)
      | _ rest.drop(1) out.snoc(rest.at(0))
    > (grove/name/identifier text) name
      | grove_roles/fail[grove/document] span "Sewn needs a name."
    < shape (grove_sewn/analyze root doc lookup span body)
    = kept
        | body.keep
        \ stmt
        ? stmt
         > (grove/comment at text) .true
         > (grove/block at kind kids)
          | equal kind (grove/block_kind/meta)
        .false
      schema (grove_roles/member ["schema"] (rex/path [text]))
      prop=grove/statement
        | grove/property span (rex/cord (path_show publisher_vocabulary/grove/sewn)) schema
      weft=grove/statement
        | grove/property span (rex/cord "/sys/weft")
          (grove_roles/member ["overlay"] (rex/path [text]))
      meta=grove/statement
        | grove/block span (grove/block_kind/meta) [prop weft]
      trees (grove_sewn/code span text shape)
      code=grove/statement
        | grove/implementation span
          trees.map((grove_actions/located span))
    | _ rest.drop(1)
      out.snoc((grove/declaration span name kept.snoc(meta).snoc(code)))
  + prepare_all
    \ root=path doc=grove/document lookup={\ path}maybe[myth]
    ^ either[grove/error grove/document]
    < doc (grove_sewn/prepare root doc lookup)
    | grove_norms/prepare_all root doc lookup
