- eden
- grove_install
- grove_backend

' Reaver supplies files and a compiler port; Foil owns boot ordering.
+ eden_srs
  + failure
    : stage=str cause=any
  + batch
    : root=path records=row[[path myth]]
  + build
    : slots=eden_srs/batch types=eden_srs/batch srs=eden_srs/batch
  + lookup
    \ records=row[[path myth]] key=path
    ^ maybe[myth]
    % rest=row[[path myth]] records
    ^ maybe[myth]
    ? (eq rest.len 0) .none
    = [name card] rest.at(0)
    ? (equal name key) (./some card)
    | _ rest.drop(1)
  + parse
    \ stage=str text=str
    ^ either[eden_srs/failure grove/document]
    ? (grove/parse text)
     > (./err cause) (./err (eden_srs/failure stage cause))
     > (./ok document) (./ok document)
  + compile_batch
    \ root=path text=str dependencies=row[[path myth]]
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ either[eden_srs/failure eden_srs/batch]
    = stage (path_show root)
    < document (eden_srs/parse stage text)
    = ports
        | grove_backend/ports (eden_srs/lookup dependencies) compiler
    ? (grove_backend/compile root document ports)
     > (./err cause) (./err (eden_srs/failure stage cause))
     > (./ok records) (./ok (eden_srs/batch root records))
  + compile
    \ slots=str types=str srs=str
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ either[eden_srs/failure eden_srs/build]
    < slots (eden_srs/compile_batch ['sys] slots [] compiler)
    < types
      | eden_srs/compile_batch ['sys 'types] types slots.records
          compiler
    < srs
      | eden_srs/compile_batch ['gov 'srs] srs
          (row/weld slots.records types.records) compiler
    | ./ok (eden_srs/build slots types srs)
  + publish_batch
    \ batch=eden_srs/batch state=sov
    ^ either[eden_srs/failure sov]
    ? (grove_install/mount batch.root batch.records state)
     > (./err reason)
      | ./err
          (eden_srs/failure (path_show batch.root) (pails/p [reason]))
     > (./ok next) (./ok next)
  + publish
    \ build=eden_srs/build state=sov
    ^ either[eden_srs/failure sov]
    < state (eden_srs/publish_batch build.slots state)
    < state (eden_srs/publish_batch build.types state)
    | eden_srs/publish_batch build.srs state
  + boot
    \ port=nat build=eden_srs/build
    ^ either[eden_srs/failure sov]
    ? (eden/boot port)
     > (./failed stage reason)
      | ./err (eden_srs/failure "eden" (eden/failed stage reason))
     > (./ready state) (eden_srs/publish build state)
  + main
    \ port=nat slots=str types=str srs=str
      compiler={\ grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
    ^ nat
    ? (eden_srs/compile slots types srs compiler)
     > (./err failure) (error failure)
     > (./ok build)
      ? (eden_srs/boot port build)
       > (./err failure) (error failure)
       > (./ok state) (eden/serve state)
