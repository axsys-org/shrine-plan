- eden
- grove_backend

' Both source batches publish into the supplied local sovereign.
' System slot imports read the pinned publication and never republish it.
+ eden_srs
  + failure
    : stage=str cause=any
  + ports
    : compile={\ namespace grove_backend/request}either[
        grove_backend/diagnostic grove_backend/compiled]
      publish={\ namespace row[[path myth]]}either[
        iota namespace/committed]
  + lookup
    \ types=path state=namespace requested=path
    ^ maybe[myth]
    = target
        ? (pith_prefix ['codecs] requested)
          | types.weld requested.drop(1)
        requested
    | (sovereign_peek target state).fil
  + compile_batch
    \ types=path root=path text=str state=namespace ports=eden_srs/ports
    ^ either[eden_srs/failure namespace]
    = stage | path_show root
    ?> (./ok document) (grove/parse text)
      | ./err (eden_srs/failure stage (pails/t "Invalid Grove source"))
    = adapter
        | grove_backend/ports (eden_srs/lookup types state)
            (ports.compile state)
    ? (grove_backend/compile root document adapter)
     > (./err cause) (./err (eden_srs/failure stage cause))
     > (./ok records)
      ? (ports.publish state records)
       > (./err cause) (./err (eden_srs/failure stage cause))
       > (./ok committed) (./ok committed.state)
  + boot
    \ self=iota system=pin[system_publication] local=sov port=nat
      types=str srs=str ports=eden_srs/ports
    ^ either[eden_srs/failure namespace]
    ?> (./ok state) (eden/boot self system local port)
      | ./err (eden_srs/failure "eden" (pails/t "Namespace boot failed"))
    = types_root=path [self 'lib 'grove 'types]
      source_root=path [self 'gov 'srs]
    < state (eden_srs/compile_batch types_root types_root types state ports)
    | eden_srs/compile_batch types_root source_root srs state ports
  + main
    \ self=iota system=pin[system_publication] local=sov port=nat
      types=str srs=str ports=eden_srs/ports
    ^ nat
    ? (eden_srs/boot self system local port types srs ports)
     > (./err failure) (error failure)
     > (./ok state) (eden/serve state)
