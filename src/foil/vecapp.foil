-  vec
+  main
  '  ?=  ((main 1 2 10 20) 11)
  \  ax=nat ay=nat bx=nat by=nat
  ^  nat
  = > a (vec ax ay)
  = > b (vec bx by)
  = > c (a.add(b))
  c.x
+  napp
  -  vec
  +  through
    '  A parameter typed through the mount accepts a canonical vec.
    \  v=napp/vec
    ^  nat
    v.y
+  cross
  '  ?=  ((cross 3 4) 4)
  \  x=nat y=nat
  ^  nat
  (napp/through (vec x y))
+  mounted_make
  '  ?=  ((mounted_make 7 9) 7)
  \  x=nat y=nat
  ^  nat
  = > v (napp/vec x y)
  v.x
