- grove_backend
- grove_install

' Compiler and effect-free execution supplied by the pinned native engine.
' A caller constructs a candidate namespace; the owner commits it only after
' the whole interaction succeeds. No host interpreter or source-file install.
+ grove_authoring
  + ports
    : compile={\ path str namespace}either[str namespace]
      pure={\ {\ unit}any}either[str any]
  + slot
    ^ path
    ['sys 'grove 'authoring]
  + get
    \ state=namespace
    ^ maybe[grove_authoring/ports]
    < record (sovereign_peek [state.self 'dev 'grove] state).fil
    < held record.get(grove_authoring/slot)
    ?> ports=grove_authoring/ports held .none
    | ./some ports
  + install
    \ ports=grove_authoring/ports state=namespace
    ^ either[pail namespace]
    ? (grove_install/change [state.self 'dev 'grove]
        (writ/make (myth/sing grove_authoring/slot ports)) state)
     > (./ok next) (./ok next)
     > (./err why) (./err (pails/t "Cannot install native authoring ports."))
