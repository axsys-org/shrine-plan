-  sept [order=10]
-  shrine_types [order=20]
-  foundry_delivery [order=30]
'  foundry_fragment: versioned, address-bound terminal results.  A Fragment is
'  a replaceable pronunciation of one admitted projection occurrence.  It is
'  not part of semantic identity, cannot grant authority, and may be dropped
'  or recomputed without changing the addressed DAG.

+  projection_fragment_payload
  '  Codec names the body convention; media names its external representation.
  :  codec=iota media=nat body=nat

+  projection_fragment_cache
  '  Handler-local reuse only.  A non-authoritative entry carries a canonical
  '  payload key; `none` carries no key.  No authoritative policy exists.
  :  policy=iota key=maybe[foundry_digest]

+  projection_fragment_provenance
  '  The mechanical handler that produced the Fragment plus optional immutable
  '  evidence.  Neither field is semantic occurrence identity or authority.
  :  handler=path evidence=maybe[foundry_digest]

+  projection_fragment_refusal
  '  Terminal refusal is scoped to this pronunciation.  It never withdraws or
  '  refuses the semantic projection revision itself.
  :  code=iota detail=nat

+  projection_fragment
  '  Exactly one of payload or refusal is present.  Every Fragment is bound to
  '  one source-pin + occurrence-axis address and schema version.
  :  version=nat
     semantic=projection_address
     target=nat
     payload=maybe[projection_fragment_payload]
     cache=projection_fragment_cache
     provenance=projection_fragment_provenance
     refusal=maybe[projection_fragment_refusal]

+  projection_fragment_cache_evidence
  '  Canonical input to the handler-local cache key.  Cache policy and key are
  '  excluded so they cannot recursively define themselves.
  :  version=nat
     semantic=projection_address
     target=nat
     payload=projection_fragment_payload
     provenance=projection_fragment_provenance

+  foundry_fragment
  +  version
    ^  nat
    1

  +  optional_digest_valid
    \  digest=maybe[foundry_digest]
    ^  bool
    ?  digest
     > .none  .true
     > (./some value=foundry_digest)  (foundry_digest/valid value)

  +  provenance_valid
    \  provenance=projection_fragment_provenance
    ^  bool
    ?  (eq 0 provenance.handler.len)
       .false
    (foundry_fragment/optional_digest_valid provenance.evidence)

  +  codec_media_valid
    '  The first version admits three interoperable textual codecs plus an
    '  opaque escape hatch whose media type remains mandatory.
    \  codec=iota media=nat
    ^  bool
    ?  (eq_iota codec 'html)
       (eq media "text/html")
    ?  (eq_iota codec 'text)
       (eq media "text/plain")
    ?  (eq_iota codec 'json)
       (eq media "application/json")
    ?  (eq_iota codec 'opaque)
       !(eq media 0)
    .false

  +  payload_valid
    \  payload=projection_fragment_payload
    ^  bool
    ?  !(foundry_fragment/codec_media_valid payload.codec payload.media)
       .false
    !(eq payload.body 0)

  +  cache_key
    \  version=nat semantic=projection_address target=nat
       payload=projection_fragment_payload
       provenance=projection_fragment_provenance
    ^  foundry_digest
    (pin_hash (pin_save
      (pin (projection_fragment_cache_evidence
        version semantic target payload provenance))))

  +  cache_for
    \  policy=iota version=nat semantic=projection_address target=nat
       payload=projection_fragment_payload
       provenance=projection_fragment_provenance
    ^  projection_fragment_cache
    ?  (eq_iota policy 'non_authoritative)
       (projection_fragment_cache policy
         (./some (foundry_fragment/cache_key
           version semantic target payload provenance)))
    (projection_fragment_cache policy .none)

  +  make
    '  Construct an admitted terminal Fragment.  Invalid codec/media or policy
    '  combinations remain representable only so the wire boundary can refuse
    '  them explicitly as data.
    \  semantic=projection_address target=nat codec=iota media=nat body=nat
       policy=iota handler=path evidence=maybe[foundry_digest]
    ^  projection_fragment
    =  payload (projection_fragment_payload codec media body)
       provenance (projection_fragment_provenance handler evidence)
       cache (foundry_fragment/cache_for policy foundry_fragment/version
               semantic target payload provenance)
    (projection_fragment foundry_fragment/version semantic target
      (./some payload) cache provenance .none)

  +  refuse
    '  Construct a terminal-only refusal.  It has no payload and is never
    '  cacheable, so a failed handler cannot poison a reusable semantic entry.
    \  semantic=projection_address target=nat code=iota detail=nat
       handler=path evidence=maybe[foundry_digest]
    ^  projection_fragment
    (projection_fragment foundry_fragment/version semantic target .none
      (projection_fragment_cache 'none .none)
      (projection_fragment_provenance handler evidence)
      (./some (projection_fragment_refusal code detail)))

  +  cache_valid
    \  fragment=projection_fragment payload=projection_fragment_payload
    ^  bool
    ?  (eq_iota fragment.cache.policy 'none)
       ?  fragment.cache.key
        > .none  .true
        > (./some _)  .false
    ?  !(eq_iota fragment.cache.policy 'non_authoritative)
       .false
    ?  fragment.cache.key
     > .none  .false
     > (./some key=foundry_digest)
       ?  !(foundry_digest/valid key)
          .false
       (equal key (foundry_fragment/cache_key fragment.version
         fragment.semantic fragment.target payload fragment.provenance))

  +  valid
    '  Admission law for a bounded terminal envelope.  It cannot express an
    '  authoritative cache or a simultaneous body and refusal.
    \  fragment=projection_fragment
    ^  bool
    ?  !(eq fragment.version foundry_fragment/version)
       .false
    ?  !(foundry_delivery/address_valid fragment.semantic)
       .false
    ?  (eq fragment.target 0)
       .false
    ?  !(foundry_fragment/provenance_valid fragment.provenance)
       .false
    ?  fragment.payload
     > (./some payload=projection_fragment_payload)
       ?  fragment.refusal
        > (./some _)  .false
        > .none
          ?  !(foundry_fragment/payload_valid payload)
             .false
          (foundry_fragment/cache_valid fragment payload)
     > .none
       ?  fragment.refusal
        > .none  .false
        > (./some refusal=projection_fragment_refusal)
          ?  (eq_iota refusal.code 'none)
             .false
          ?  !(eq_iota fragment.cache.policy 'none)
             .false
          ?  fragment.cache.key
           > .none  .true
           > (./some _)  .false

  +  semantic
    \  fragment=projection_fragment
    ^  projection_address
    fragment.semantic

  +  cache_key_of
    \  fragment=projection_fragment
    ^  maybe[foundry_digest]
    fragment.cache.key

  +  refused
    \  fragment=projection_fragment
    ^  bool
    ?  fragment.refusal
     > .none  .false
     > (./some _)  .true
