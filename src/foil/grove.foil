- rex
'  Grove v2 syntax. Embedded languages remain opaque surface Rex.
+ grove
  + error
    & grove/error/parser grove/error/syntax
    + parser
      : cause=any
    + syntax
      : span=rex/source_span message=str
  + name
    & grove/name/identifier grove/name/tree_path
    + identifier
      : text=str
    + tree_path
      : text=str
  + document
    : items=row[grove/item]
  + item
    & grove/import_decl grove/declaration grove/comment
  + import_decl
    : span=rex/source_span alias=str target=rex
  + declaration
    : span=rex/source_span name=grove/name
      body=row[grove/statement]
  + statement
    & grove/tag grove/property grove/directive grove/block
      grove/implementation grove/comment
  + comment
    : span=rex/source_span text=str
  + tag
    : span=rex/source_span kind=grove/tag_kind
  + property
    : span=rex/source_span slot=rex value=rex
  + directive
    : span=rex/source_span kind=grove/directive_kind target=rex
  + block
    : span=rex/source_span kind=grove/block_kind
      body=row[grove/statement]
  + implementation
    : span=rex/source_span code=row[rex]
  + tag_kind
    & grove/tag_kind/type
      grove/tag_kind/slot
      grove/tag_kind/role
      grove/tag_kind/action
      grove/tag_kind/norm
      grove/tag_kind/dyed
      grove/tag_kind/tree
    + type
      :
    + slot
      :
    + role
      :
    + action
      :
    + norm
      :
    + dyed
      :
    + tree
      :
  + read_tag_kind
    \ text=str tree=rex
    ^ either[grove/error grove/tag_kind]
    ? (eq text "type") (./ok (grove/tag_kind/type))
    ? (eq text "slot") (./ok (grove/tag_kind/slot))
    ? (eq text "role") (./ok (grove/tag_kind/role))
    ? (eq text "action") (./ok (grove/tag_kind/action))
    ? (eq text "norm") (./ok (grove/tag_kind/norm))
    ? (eq text "dyed") (./ok (grove/tag_kind/dyed))
    ? (eq text "tree") (./ok (grove/tag_kind/tree))
    | grove/fail[grove/tag_kind] tree "Unknown tag_kind."
  + directive_kind
    & grove/directive_kind/with
      grove/directive_kind/on
      grove/directive_kind/here
      grove/directive_kind/from
      grove/directive_kind/to
      grove/directive_kind/like
    + with
      :
    + on
      :
    + here
      :
    + from
      :
    + to
      :
    + like
      :
  + read_directive_kind
    \ text=str tree=rex
    ^ either[grove/error grove/directive_kind]
    ? (eq text "with") (./ok (grove/directive_kind/with))
    ? (eq text "on") (./ok (grove/directive_kind/on))
    ? (eq text "here") (./ok (grove/directive_kind/here))
    ? (eq text "from") (./ok (grove/directive_kind/from))
    ? (eq text "to") (./ok (grove/directive_kind/to))
    ? (eq text "like") (./ok (grove/directive_kind/like))
    | grove/fail[grove/directive_kind] tree "Unknown directive_kind."
  + block_kind
    & grove/block_kind/meta
      grove/block_kind/or
      grove/block_kind/opt
      grove/block_kind/get
    + meta
      :
    + or
      :
    + opt
      :
    + get
      :
  + read_block_kind
    \ text=str tree=rex
    ^ either[grove/error grove/block_kind]
    ? (eq text "meta") (./ok (grove/block_kind/meta))
    ? (eq text "or") (./ok (grove/block_kind/or))
    ? (eq text "opt") (./ok (grove/block_kind/opt))
    ? (eq text "get") (./ok (grove/block_kind/get))
    | grove/fail[grove/block_kind] tree "Unknown block_kind."
  + fail
    (@ a)
    \ tree=rex message=str
    ^ either[grove/error a]
    | ./err (grove/error/syntax tree.span message)
  + word
    \ tree=rex
    ^ either[grove/error str]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "word"))
        (./ok text)
      | grove/fail[str] tree "Expected a word."
    | grove/fail[str] tree "Expected a word."
  + hash_word
    \ tree=rex
    ^ either[grove/error str]
    ? tree
     > (./pref span rune kid)
      ? (eq rune "#") (grove/word kid)
      | grove/fail[str] tree "Expected #name."
    | grove/fail[str] tree "Expected #name."
  + read_name
    \ tree=rex
    ^ either[grove/error grove/name]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "word"))
        (./ok (grove/name/identifier text))
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "cord"))
        (./ok (grove/name/tree_path text))
      | grove/fail[grove/name] tree "Expected a name or cord path."
    | grove/fail[grove/name] tree "Expected a name or cord path."
  + read_statement
    \ tree=rex
    ^ either[grove/error grove/statement]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "slug"))
        (./ok (grove/comment span text))
      | grove/fail[grove/statement] tree "Expected a statement."
     > (./pref span rune kid)
      ? (eq rune "@")
        < text (grove/word kid)
        < kind (grove/read_tag_kind text tree)
        | ./ok (grove/tag span kind)
      | grove/fail[grove/statement] tree "Expected a tag."
     > (./nest span color rune kids)
      ? !(eq color "clear")
        | grove/fail[grove/statement] tree "Unexpected brackets."
      ? !(eq kids.len 2)
        | grove/fail[grove/statement] tree "Expected two operands."
      ? (eq rune ":")
        | ./ok (grove/property span kids.at(0) kids.at(1))
      ? (eq rune ";")
        < text (grove/hash_word kids.at(0))
        < kind (grove/read_directive_kind text tree)
        | ./ok (grove/directive span kind kids.at(1))
      | grove/fail[grove/statement] tree "Unknown statement rune."
     > (./bloc span color rune head items)
      ? !(eq color "clear")
        | grove/fail[grove/statement] tree "Unexpected brackets."
      ? (eq rune ";")
        < text (grove/hash_word head)
        < kind (grove/read_block_kind text tree)
        < body (grove/read_body items)
        | ./ok (grove/block span kind body)
      ? (eq rune ":")
        < text (grove/word head)
        ? !(eq text "get")
          | grove/fail[grove/statement] tree "Expected get block."
        < body (grove/read_body items)
        | ./ok (grove/block span (grove/block_kind/get) body)
      | grove/fail[grove/statement] tree "Unknown block rune."
    | grove/fail[grove/statement] tree "Expected a Grove statement."
  + read_body
    \ trees=row[rex]
    ^ either[grove/error row[grove/statement]]
    ? (eq trees.len 0) (./ok [])
    = tree trees.at(0)
      rest trees.drop(1)
    ? tree
     > (./heir span kids)
      | grove/read_body kids.weld(rest)
     > (./open span rune kids)
      ? (eq rune "!")
        ? !(eq kids.len 1)
          | grove/fail[row[grove/statement]] tree "Expected ! foil."
        < lang (grove/word kids.at(0))
        ? !(eq lang "foil")
          | grove/fail[row[grove/statement]] tree "Unknown language."
        ? (eq rest.len 0)
          | grove/fail[row[grove/statement]] tree "Empty Foil body."
        | ./ok [(grove/implementation span rest)]
      | grove/fail[row[grove/statement]] tree "Unexpected open rune."
    < stmt (grove/read_statement tree)
    < tail (grove/read_body rest)
    | ./ok (row/weld[grove/statement] tail [stmt])
  + read_import
    \ tree=rex kids=row[rex]
    ^ either[grove/error grove/item]
    ? !(eq kids.len 2)
      | grove/fail[grove/item] tree "Expected #import alias=target."
    < mark (grove/hash_word kids.at(0))
    ? !(eq mark "import")
      | grove/fail[grove/item] tree "Expected #import."
    ? kids.at(1)
     > (./tyte span rune pair)
      ? !(eq rune "=")
        | grove/fail[grove/item] tree "Expected alias=target."
      ? !(eq pair.len 2)
        | grove/fail[grove/item] tree "Expected alias=target."
      < name (grove/word pair.at(0))
      | ./ok (grove/import_decl tree.span name pair.at(1))
    | grove/fail[grove/item] tree "Expected alias=target."
  + read_item
    \ tree=rex
    ^ either[grove/error grove/item]
    ? tree
     > (./leaf span shape text)
      ? (equal[maybe[str]] tree.leaf_kind (maybe/some[str] "slug"))
        (./ok (grove/comment span text))
      | grove/fail[grove/item] tree "Expected a declaration."
     > (./expr span color kids)
      ? (eq color "clear") (grove/read_import tree kids)
      | grove/fail[grove/item] tree "Unexpected brackets."
     > (./bloc span color rune head items)
      ? !(eq color "clear")
        | grove/fail[grove/item] tree "Unexpected brackets."
      ? !(eq rune "=")
        | grove/fail[grove/item] tree "Expected a declaration."
      < name (grove/read_name head)
      < body (grove/read_body items)
      | ./ok (grove/declaration span name body)
    | grove/fail[grove/item] tree "Stray top-level code."
  + read_items
    \ trees=row[rex]
    ^ either[grove/error row[grove/item]]
    ? (eq trees.len 0) (./ok [])
    < item (grove/read_item trees.at(0))
    < tail (grove/read_items trees.drop(1))
    | ./ok (row/weld[grove/item] tail [item])
  + from_blocks
    \ trees=row[rex]
    ^ either[grove/error grove/document]
    < items (grove/read_items trees)
    | ./ok (grove/document items)
  + parse
    \ text=str
    ^ either[grove/error grove/document]
    ? (rex/parse_blocks text)
     > (./err cause) (./err (grove/error/parser cause))
     > (./ok trees) (grove/from_blocks trees)
