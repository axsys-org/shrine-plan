-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=25]
-  foundry [order=27]
-  foundry_doc [order=30]
'  foundry_delivery: the renderer-neutral, progressive semantic projection
'  DAG.  projection_dag is the sole structural delivery product of Foundry
'  compilation.  SurfaceTree and foundry_doc/surface are tree-shaped
'  authoring/compiler intermediates upstream of this boundary; they carry no
'  occurrence identity, revision, sharing, or completion state.  HTML, CSS,
'  DOM handles, routes, and action authority never enter this vocabulary.
+  foundry_digest
  '  Canonical digest bytes of an admitted immutable source pin.  This module
  '  validates the wire shape but does not mint identity from routes or names.
  row[nat]

  +  valid
    \  d=foundry_digest
    ^  bool
    ?  !(eq 32 d.len)
       .false
    |  > i=nat 0
    ?  (ge i d.len)
       .true
    ?  (ge d.at(i) 256)
       .false
    (_ i.inc)

+  projection_axis
  '  One structural occurrence step.  The complete occurrence identity is
  '  the source pin digest plus this ordered axis, never a namespace route.
  &  projection_axis/kid
     projection_axis/slot
     projection_axis/arg
     projection_axis/leg
     projection_axis/branch

  +  kid
    :  index=nat
  +  slot
    :  name=iota
  +  arg
    :  index=nat
  +  leg
    :  index=nat
  +  branch
    :  name=iota

+  projection_address
  '  Canonical semantic occurrence address.  Equal source pins can have many
  '  independently situated occurrences because axes remain explicit.
  :  source=foundry_digest axis=row[projection_axis]

+  projection_value
  '  Restricted renderer-neutral semantic parameters.
  &  projection_value/flag
     projection_value/count
     projection_value/text
     projection_value/name
     projection_value/semantic_ref
     projection_value/ref

  +  flag
    :  value=bool
  +  count
    :  value=nat
  +  text
    :  value=nat
  +  name
    :  value=iota
  +  semantic_ref
    '  A durable semantic reference awaiting ordinary Foundry/Zoo resolution.
    '  It is never interpreted as an occurrence identity.
    :  value=path
  +  ref
    :  value=projection_address

+  projection_parameter
  :  key=path value=projection_value

+  projection_hole
  '  A typed unresolved semantic choice.  Its fallback is another addressed
  '  occurrence, not terminal output.  Resolution may replace this hole only
  '  at the containing object's exact address.  Parameters preserve the same
  '  renderer-neutral semantic facts as resolved syntax: authored role,
  '  source/subject, slot, fallback, and any later resolved values remain
  '  inspectable while the occurrence is still a hole.
  :  role=path
     kind=iota
     fallback=maybe[projection_address]
     semantic_fallback=maybe[path]
     parameters=row[projection_parameter]

+  projection_syntax
  '  Immutable semantic node syntax.  Placements are independently addressed
  '  edges, preserving shared children without flattening them into a tree.
  :  kind=iota
     role=path
     recipe=foundry_digest
     parameters=row[projection_parameter]
     placements=row[projection_address]
     dependencies=row[projection_address]
     fallback=maybe[projection_address]

+  projection_node_body
  &  projection_node_body/semantic
     projection_node_body/hole

  +  semantic
    :  syntax=projection_syntax
  +  hole
    :  hole=projection_hole

+  projection_node
  :  address=projection_address body=projection_node_body

+  projection_placement_target
  '  An edge points to a shared child or remains a typed hole.  The placement
  '  itself owns an occurrence address, so it can progress independently.
  &  projection_placement_target/child
     projection_placement_target/hole

  +  child
    :  address=projection_address
  +  hole
    :  hole=projection_hole

+  projection_placement
  '  A placement is the contextual occurrence edge inside the projection
  '  tree.  Parameters belong here when they describe this occurrence rather
  '  than the shared semantic definition: window geometry, local density,
  '  ordering hints, and similar overlay-owned presentation facts.
  :  address=projection_address
     parent=projection_address
     role=path
     parameters=row[projection_parameter]
     resolution_context=maybe[foundry_digest]
     target=projection_placement_target

+  projection_action_mount
  '  An admitted semantic Action reference bound to its immutable definition,
  '  declared input, and admission evidence.  This is not a callback, kook,
  '  capability grant, route, or terminal event spelling.
  :  action=path
     pin=foundry_digest
     input=path
     admission=foundry_digest

+  projection_destination_mount
  '  An authored navigation declaration resolved to an addressed semantic
  '  target.  Terminal routes and link syntax remain downstream mechanics.
  :  declaration=path target=projection_address

+  projection_interaction
  '  Occurrence-scoped interaction evidence.  owner is the exact Block
  '  definition or contextual Block placement that exposes this interaction;
  '  shared Block syntax therefore does not collapse independent occurrences.
  :  address=projection_address
     owner=projection_address
     actions=row[projection_action_mount]
     destination=maybe[projection_destination_mount]

+  projection_object
  '  Live DAG objects accepted by Upsert and Resolve.
  &  projection_object/node
     projection_object/placement
     projection_object/interaction

  +  node
    :  node=projection_node
  +  placement
    :  placement=projection_placement
  +  interaction
    :  interaction=projection_interaction

+  projection_tombstone
  '  An explicit withdrawal.  Keeping this entry in the pending and committed
  '  slices prevents an older committed fallback from being resurrected.
  :  address=projection_address target=iota

+  projection_entry
  '  Stored DAG entries include live objects and explicit tombstones.
  &  projection_entry/node
     projection_entry/placement
     projection_entry/interaction
     projection_entry/tombstone

  +  node
    :  node=projection_node
  +  placement
    :  placement=projection_placement
  +  interaction
    :  interaction=projection_interaction
  +  tombstone
    :  tombstone=projection_tombstone

+  projection_resolution
  '  Renderer-neutral output of the layer cascade at the delivery boundary.
  '  Values remain ordinary Shrine pails until this bridge admits the small
  '  projection_value subset below.  Provenance is a parallel token ->
  '  winning-layer map and must contain one canonical path pail per value.
  :  values=myth provenance=myth

+  projection_guard_provenance
  '  Guarded winners carry their exact admitted policy and witness pins.
  '  There is no partially populated guarded arm: evidence is either
  '  explicitly absent or structurally present and content-addressed.
  &  projection_guard_provenance/unguarded
     projection_guard_provenance/guarded

  +  unguarded
    :
  +  guarded
    :  policy=foundry_digest witness=foundry_digest

+  projection_resolution_delta
  '  One semantic field refined at this scope.  The winning Layer pin and
  '  guard evidence travel with the value so provenance cannot be detached
  '  from a cached context delta.
  :  key=path
     value=projection_value
     winner=foundry_digest
     guard=projection_guard_provenance

+  projection_resolution_context_evidence
  '  Canonical semantic evidence for one cascaded context digest.  Row order
  '  is meaningful: local Layers are applied in admitted cascade order and
  '  deltas retain their canonical semantic-field order.
  :  parent=maybe[foundry_digest]
     scope=projection_address
     local_layers=row[foundry_digest]
     deltas=row[projection_resolution_delta]

+  projection_resolution_context
  '  A content-addressable, shareable cascade context.  parent references a
  '  previously admitted context digest; scope is the contextual occurrence
  '  refined here.  This companion record is disposable derivation evidence,
  '  never a second authority or namespace object.  Its digest must be bound
  '  into the enclosing projection revision before the context is delivered.
  :  digest=foundry_digest
     parent=maybe[foundry_digest]
     scope=projection_address
     local_layers=row[foundry_digest]
     deltas=row[projection_resolution_delta]

+  projection_manifest
  '  One bounded revision slice.  Roots name entry points; retain is the exact
  '  set of immutable committed objects reusable by Begin; frontier names
  '  referenced objects intentionally outside this packet.
  :  revision=foundry_digest
     roots=row[projection_address]
     retain=row[projection_address]
     frontier=row[projection_address]

+  projection_dag
  '  The canonical renderer-neutral delivery graph for one revision.  Only
  '  this addressed structure may enter projection frames, worker/browser
  '  delivery caches, or terminal codec selection.  contexts is companion
  '  semantic cascade evidence addressed by placement digests; it is not an
  '  authored authority graph.
  :  manifest=projection_manifest
     contexts=row[projection_resolution_context]
     entries=row[projection_entry]

+  projection_refusal
  :  revision=foundry_digest code=iota

+  projection_delivery
  '  Ephemeral, non-authoritative assembler state suitable for a worker or
  '  browser store.  Deleting it only loses reuse.  Complete is the sole arm
  '  that promotes pending into committed.
  :  committed=maybe[projection_dag]
     pending=maybe[projection_dag]
     refusal=maybe[projection_refusal]

+  projection_frame
  &  projection_frame/begin
     projection_frame/upsert
     projection_frame/resolve
     projection_frame/withdraw
     projection_frame/complete
     projection_frame/refuse

  +  begin
    :  manifest=projection_manifest
       contexts=row[projection_resolution_context]
  +  upsert
    :  manifest=projection_manifest object=projection_object
  +  resolve
    :  manifest=projection_manifest
       address=projection_address
       object=projection_object
  +  withdraw
    :  manifest=projection_manifest address=projection_address target=iota
  +  complete
    :  manifest=projection_manifest
  +  refuse
    :  manifest=projection_manifest code=iota

+  projection_delivery_result
  '  Protocol errors are refusals as data and retain the exact prior state.
  &  projection_delivery_result/accepted
     projection_delivery_result/refused

  +  accepted
    :  state=projection_delivery
  +  refused
    :  state=projection_delivery refusal=projection_refusal

+  projection_entry_resolution
  &  projection_entry_resolution/resolved
     projection_entry_resolution/missing
     projection_entry_resolution/not_hole
     projection_entry_resolution/kind_mismatch

  +  resolved
    :  entries=row[projection_entry]
  +  missing
    :
  +  not_hole
    :
  +  kind_mismatch
    :

+  projection_fidelity
  '  Terminal realization demand is deliberately outside semantic context
  '  identity.  Changing fidelity cannot mint a different semantic cascade.
  &  projection_fidelity/latent
     projection_fidelity/coarse
     projection_fidelity/normal
     projection_fidelity/refined

  +  latent
    :
  +  coarse
    :
  +  normal
    :
  +  refined
    :

+  projection_resolution_demand
  '  Ephemeral demand for realizing an already identified semantic context.
  '  fidelity is not included in projection_resolution_context_evidence.
  :  context=foundry_digest fidelity=projection_fidelity

+  surface_slot_binding
  '  The result of realizing one authored Slot edge.  The instance keeps its
  '  own child role; contextual participation belongs to the placement.
  '  fallback names the admitted Recipe only when this placement was
  '  materialized from an explicit Slot fallback.
  :  parent=path placement=path participation=path fallback=maybe[path]
     fallback_class=maybe[iota]

+  surface_slot_plan
  &  surface_slot_plan/admitted
     surface_slot_plan/refused

  +  admitted
    :  surface=foundry_doc/surface
       bindings=row[surface_slot_binding]
       fallbacks=row[path]
  +  refused
    :  code=iota at=path

+  surface_template_result
  '  A shared Surface template is compiled away into ordered instance edges
  '  and contextual bindings.  No Slot definition becomes runtime state and
  '  no renderer is allowed to invent missing attachment content.
  &  surface_template_result/admitted
     surface_template_result/refused

  +  admitted
    :  surface=foundry_doc/surface
       bindings=row[surface_slot_binding]
       fallbacks=row[path]
  +  refused
    :  code=iota at=path

+  projection_bridge_input
  '  Complete input to one authoring-surface bridge.  revision is the
  '  upstream immutable request/surface revision.  When a non-empty
  '  resolution is admitted, the delivered revision is derived from it and
  '  the canonical typed parameters; occurrence addresses remain source pin
  '  plus structural axis.
  :  source=foundry_digest
     recipe=foundry_digest
     revision=foundry_digest
     surface=foundry_doc/surface
     bindings=row[surface_slot_binding]
     resolution=maybe[projection_resolution]

+  projection_parameterization_result
  '  Internal admission result for the pail -> projection_value boundary.
  &  projection_parameterization_result/admitted
     projection_parameterization_result/refused

  +  admitted
    :  parameters=row[projection_parameter]
  +  refused
    :  code=iota at=path

+  projection_revision_evidence
  '  Canonical evidence used only to derive a hydration-sensitive revision.
  '  It is not an address and never enters the namespace.
  :  base=foundry_digest parameters=row[projection_parameter]

+  projection_binding_revision_evidence
  '  Contextual Slot realization evidence.  This includes participation and
  '  exact selected fallback Recipe identities, but never renderer output.
  :  base=foundry_digest bindings=row[surface_slot_binding]

+  projection_bridge_result
  '  Pure authoring-surface to canonical delivery-DAG compilation.  Refusals
  '  name authoring fields for inspection, never for identity or fallback
  '  addressing.
  &  projection_bridge_result/admitted
     projection_bridge_result/refused

  +  admitted
    :  dag=projection_dag
  +  refused
    :  code=iota at=path

+  foundry_delivery
  +  empty
    ^  projection_delivery
    (projection_delivery .none .none .none)

  +  digest_myth
    '  Content-address one admitted semantic record.  PinHash accepts only a
    '  finalized pin; PinSave persists this content artifact without
    '  publishing it as a namespace root.  No route participates in identity.
    \  value=myth
    ^  foundry_digest
    (pin_hash (pin_save (pin value)))
  +  digest_tree
    '  Content-address an admitted semantic axal snapshot before compiling
    '  its tree-shaped authoring form into an addressed projection DAG.
    \  value=axal[myth]
    ^  foundry_digest
    (pin_hash (pin_save (pin value)))

  +  make_resolution
    '  Construction gate for Foundry orchestration and focused tests.  The
    '  bridge still validates every value and provenance pail before use.
    \  values=myth provenance=myth
    ^  projection_resolution
    (projection_resolution values provenance)

  +  make_unguarded_resolution_delta
    \  key=path value=projection_value winner=foundry_digest
    ^  projection_resolution_delta
    (projection_resolution_delta key value winner
      (projection_guard_provenance/unguarded))

  +  make_guarded_resolution_delta
    \  key=path value=projection_value winner=foundry_digest
       policy=foundry_digest witness=foundry_digest
    ^  projection_resolution_delta
    (projection_resolution_delta key value winner
      (projection_guard_provenance/guarded policy witness))

  +  resolution_context_identity
    '  Deterministic semantic identity for a cascaded context.  Fidelity is
    '  intentionally not an argument and therefore cannot affect this pin.
    \  parent=maybe[foundry_digest] scope=projection_address
       local_layers=row[foundry_digest]
       deltas=row[projection_resolution_delta]
    ^  foundry_digest
    (pin_hash (pin_save (pin
      (projection_resolution_context_evidence
        parent scope local_layers deltas))))

  +  make_resolution_context
    '  Construct content-addressed companion evidence.  Admission still uses
    '  resolution_context_valid and orchestration must bind digest into the
    '  enclosing projection revision before delivery.
    \  parent=maybe[foundry_digest] scope=projection_address
       local_layers=row[foundry_digest]
       deltas=row[projection_resolution_delta]
    ^  projection_resolution_context
    =  digest  (foundry_delivery/resolution_context_identity
                  parent scope local_layers deltas)
    (projection_resolution_context
      digest parent scope local_layers deltas)

  +  fidelity_latent
    ^  projection_fidelity
    (projection_fidelity/latent)
  +  fidelity_coarse
    ^  projection_fidelity
    (projection_fidelity/coarse)
  +  fidelity_normal
    ^  projection_fidelity
    (projection_fidelity/normal)
  +  fidelity_refined
    ^  projection_fidelity
    (projection_fidelity/refined)

  +  make_resolution_demand
    \  context=foundry_digest fidelity=projection_fidelity
    ^  projection_resolution_demand
    (projection_resolution_demand context fidelity)

  +  make_bridge_input
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest surface=foundry_doc/surface
       resolution=maybe[projection_resolution]
    ^  projection_bridge_input
    (projection_bridge_input source recipe revision surface [] resolution)

  +  make_bound_bridge_input
    '  Construction gate used after shared-template realization.  Bindings are
    '  compiler evidence, not renderer hints or namespace objects.
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest surface=foundry_doc/surface
       bindings=row[surface_slot_binding]
       resolution=maybe[projection_resolution]
    ^  projection_bridge_input
    (projection_bridge_input source recipe revision surface bindings resolution)

  +  projection_value_from_pail
    '  Admit only terminal-independent scalar and semantic-reference values.
    '  Rows of paths, reflected types, executable code, host handles, and
    '  arbitrary records are deliberately unsupported at this boundary.
    \  value=pail
    ^  maybe[projection_value]
    ?  value
     > x=pails/n  (./some (projection_value/count x.n))
     > x=pails/t  (./some (projection_value/text x.t))
     > x=pails/q  (./some (projection_value/name x.q))
     > x=pails/p  (./some (projection_value/semantic_ref x.p))
    .none

  +  parameterize_resolution
    '  Convert the ordered resolution maps into canonical typed parameters.
    '  Authored surface parameters are not present here and are appended to,
    '  never replaced, by the bridge.  Ordered myths make insertion history
    '  irrelevant to parameter order and therefore to revision evidence.
    \  resolution=projection_resolution
    ^  projection_parameterization_result
    =  ves  resolution.values.tap
    |  > i=nat 0
       > resolved=row[projection_parameter] []
       > provenance=row[projection_parameter] []
    ^  projection_parameterization_result
    ?  (ge i ves.len)
       =  pes  resolution.provenance.tap
       |  > j=nat 0
       ^  projection_parameterization_result
       ?  (ge j pes.len)
          (projection_parameterization_result/admitted
            resolved.weld(provenance))
       =  pe  pes.at(j)
       ?  resolution.values.get(pe.key)
        > .none
          (projection_parameterization_result/refused
            'orphan_resolution_provenance pe.key)
        > (./some _)
          (_ j.inc)
    =  e  ves.at(i)
    ?  (eq 0 e.key.len)
       (projection_parameterization_result/refused
         'invalid_resolution_key e.key)
    ?  (foundry_delivery/projection_value_from_pail e.val)
     > .none
       (projection_parameterization_result/refused
         'unsupported_resolution_value e.key)
     > (./some value=projection_value)
       ?  resolution.provenance.get(e.key)
        > .none
          (projection_parameterization_result/refused
            'missing_resolution_provenance e.key)
        > (./some winner=pail)
          ?  winner
           > layer=pails/p
             ?  (eq 0 layer.p.len)
                (projection_parameterization_result/refused
                  'invalid_resolution_provenance e.key)
             =  resolved_prefix=path  ['foundry 'resolved]
                provenance_prefix=path  ['foundry 'provenance]
                resolved_key  resolved_prefix.weld(e.key)
                provenance_key provenance_prefix.weld(e.key)
                resolved_parameter
                  (projection_parameter resolved_key value)
                provenance_parameter
                  (projection_parameter provenance_key
                    (projection_value/semantic_ref layer.p))
             (_ i.inc resolved.snoc(resolved_parameter)
                provenance.snoc(provenance_parameter))
          (projection_parameterization_result/refused
            'unsupported_resolution_provenance e.key)

  +  hydrated_revision
    '  Empty resolution is observationally identical to no resolution.  Any
    '  admitted semantic parameter otherwise participates in the immutable
    '  delivery revision while source occurrence addresses remain stable.
    \  base=foundry_digest parameters=row[projection_parameter]
    ^  foundry_digest
