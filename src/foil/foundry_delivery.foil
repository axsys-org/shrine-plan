    ^  projection_object
    (projection_object/placement
      (projection_placement address parent role parameters .none
        (projection_placement_target/child child)))
  +  make_contextual_placement
    '  Bind one contextual occurrence to already-admitted resolution evidence.
    '  The digest does not change the placement address or copy its shared
    '  semantic child; it identifies the cascade result for this occurrence.
    \  address=projection_address parent=projection_address role=path
       parameters=row[projection_parameter] child=projection_address
       resolution_context=foundry_digest
    ^  projection_object
    (projection_object/placement
      (projection_placement address parent role parameters
        (./some resolution_context)
        (projection_placement_target/child child)))
  +  make_hole_placement
    \  address=projection_address parent=projection_address role=path
       hole=projection_hole
    ^  projection_object
    (projection_object/placement
      (projection_placement address parent role [] .none
        (projection_placement_target/hole hole)))
  +  make_action_mount
    '  Construct typed admission evidence without interpreting or invoking it.
    \  action=path pin=foundry_digest input=path admission=foundry_digest
    ^  projection_action_mount
    (projection_action_mount action pin input admission)
  +  make_destination_mount
    \  declaration=path target=projection_address
    ^  projection_destination_mount
    (projection_destination_mount declaration target)
  +  make_interaction
    \  address=projection_address owner=projection_address
       actions=row[projection_action_mount]
       destination=maybe[projection_destination_mount]
    ^  projection_object
    (projection_object/interaction
      (projection_interaction address owner actions destination))
  +  make_manifest
    \  revision=foundry_digest roots=row[projection_address]
       retain=row[projection_address] frontier=row[projection_address]
    ^  projection_manifest
    (projection_manifest revision roots retain frontier)
  +  make_dag
    '  Legacy construction gate.  Context-free producers remain explicit
    '  until they derive real semantic cascade evidence in the next phase.
    \  manifest=projection_manifest entries=row[projection_entry]
    ^  projection_dag
    (projection_dag manifest [] entries)
  +  make_contextual_dag
    \  manifest=projection_manifest
       contexts=row[projection_resolution_context]
       entries=row[projection_entry]
    ^  projection_dag
    (projection_dag manifest contexts entries)
  +  object_entry_public
    '  Runtime construction gate for focused hosts and tests.  It preserves
    '  the exact canonical object; it performs no admission or mutation.
    \  object=projection_object
    ^  projection_entry
    ?  object
     > x=projection_object/node       (projection_entry/node x.node)
     > x=projection_object/placement  (projection_entry/placement x.placement)
     > x=projection_object/interaction
       (projection_entry/interaction x.interaction)
  +  begin
    \  manifest=projection_manifest
    ^  projection_frame
    (projection_frame/begin manifest [])
  +  begin_with_contexts
    \  manifest=projection_manifest contexts=row[projection_resolution_context]
    ^  projection_frame
    (projection_frame/begin manifest contexts)
  +  upsert
    \  manifest=projection_manifest object=projection_object
    ^  projection_frame
    (projection_frame/upsert manifest object)
  +  resolve
    \  manifest=projection_manifest address=projection_address
       object=projection_object
    ^  projection_frame
    (projection_frame/resolve manifest address object)
  +  withdraw
    \  manifest=projection_manifest address=projection_address target=iota
    ^  projection_frame
    (projection_frame/withdraw manifest address target)
  +  complete
    \  manifest=projection_manifest
    ^  projection_frame
    (projection_frame/complete manifest)
  +  refuse
    \  manifest=projection_manifest code=iota
    ^  projection_frame
    (projection_frame/refuse manifest code)

  '  Semidoc semantic-DAG bridge ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  +  surface_edges_for
    \  parent=path edges=row[foundry_doc/surface_edge]
    ^  row[foundry_doc/surface_edge]
    edges.keep((\ e (eq_pith parent e.parent)))

  +  surface_edges_without
    \  parent=path edges=row[foundry_doc/surface_edge]
    ^  row[foundry_doc/surface_edge]
    edges.keep((\ e !(eq_pith parent e.parent)))

  +  surface_node_at
    \  address=path nodes=row[foundry_doc/surface_node]
    ^  maybe[foundry_doc/surface_node]
    |  > i=nat 0
    ^  maybe[foundry_doc/surface_node]
    ?  (ge i nodes.len)  .none
    ?  (eq_pith address nodes.at(i).address)  (./some nodes.at(i))
    (_ i.inc)

  +  optional_path_present
    \  value=maybe[path]
    ^  bool
    ?  value
     > .none  .false
     > (./some _)  .true

  +  edge_kinds
    \  edges=row[foundry_doc/surface_edge]
       nodes=row[foundry_doc/surface_node]
    ^  maybe[row[iota]]
    |  > i=nat 0  > out=row[iota] []
    ^  maybe[row[iota]]
    ?  (ge i edges.len)  (./some out)
    ?  (foundry_delivery/surface_node_at edges.at(i).child nodes)
     > .none  .none
     > (./some n=foundry_doc/surface_node)
       (_ i.inc out.snoc(n.kind))

  +  placement_known
    \  placement=path edges=row[foundry_doc/surface_edge]
    ^  bool
    edges.any((\ e (eq_pith placement e.placement)))

  +  unknown_attachment
    \  attachments=row[foundry_doc/surface_edge]
       template_edges=row[foundry_doc/surface_edge]
    ^  maybe[foundry_doc/surface_edge]
    |  > i=nat 0
    ^  maybe[foundry_doc/surface_edge]
    ?  (ge i attachments.len)  .none
    ?  !(foundry_delivery/placement_known
          attachments.at(i).placement template_edges)
       (./some attachments.at(i))
    (_ i.inc)

  +  duplicate_place_before
    \  index=nat edges=row[foundry_doc/surface_edge]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i index)  .false
    ?  (eq_pith edges.at(i).placement edges.at(index).placement)  .true
    (_ i.inc)

  +  path_snoc_unique
    \  value=path values=row[path]
    ^  row[path]
    ?  values.any((\ old (eq_pith value old)))  values
    values.snoc(value)

  +  path_fold_unique
    \  values=row[path] value=path
    ^  row[path]
    (foundry_delivery/path_snoc_unique value values)

  +  surface_node_conflict
    \  current=row[foundry_doc/surface_node]
       incoming=row[foundry_doc/surface_node]
    ^  maybe[path]
    |  > i=nat 0
    ^  maybe[path]
    ?  (ge i incoming.len)  .none
    =  node  incoming.at(i)
    ?  (foundry_delivery/surface_node_at node.address current)
     > .none  (_ i.inc)
     > (./some prior=foundry_doc/surface_node)
       ?  (equal prior node)  (_ i.inc)
       (./some node.address)

  +  surface_node_add
    \  node=foundry_doc/surface_node nodes=row[foundry_doc/surface_node]
    ^  row[foundry_doc/surface_node]
    ?  (foundry_delivery/surface_node_at node.address nodes)
     > .none  nodes.snoc(node)
     > (./some _)  nodes

  +  surface_same_edge
    \  a=foundry_doc/surface_edge b=foundry_doc/surface_edge
    ^  bool
    ?  !(eq_pith a.parent b.parent)  .false
    ?  !(eq_pith a.placement b.placement)  .false
    (eq_pith a.child b.child)

  +  surface_edge_add
    \  edge=foundry_doc/surface_edge edges=row[foundry_doc/surface_edge]
    ^  row[foundry_doc/surface_edge]
    ?  edges.any((foundry_delivery/surface_same_edge edge))  edges
    edges.snoc(edge)

  +  surface_merge_nodes
    \  incoming=row[foundry_doc/surface_node] index=nat
       out=row[foundry_doc/surface_node]
    ^  row[foundry_doc/surface_node]
    ?  (ge index incoming.len)  out
    (_ incoming index.inc
      (foundry_delivery/surface_node_add incoming.at(index) out))

  +  surface_merge_edges
    \  incoming=row[foundry_doc/surface_edge] index=nat
       out=row[foundry_doc/surface_edge]
    ^  row[foundry_doc/surface_edge]
    ?  (ge index incoming.len)  out
    (_ incoming index.inc
      (foundry_delivery/surface_edge_add incoming.at(index) out))

  +  surface_merge
    '  Merge shared semantic definitions without copying identity.  Callers
    '  must reject a conflicting definition before entering this function.
    \  current=foundry_doc/surface incoming=foundry_doc/surface
    ^  foundry_doc/surface
    (foundry_doc/surface current.name current.root
      (foundry_delivery/surface_merge_nodes incoming.nodes 0 current.nodes)
      (foundry_delivery/surface_merge_edges incoming.edges 0 current.edges))

  +  surface_recipes_named
    \  name=path recipes=row[foundry_doc/surface_recipe]
    ^  row[foundry_doc/surface_recipe]
    recipes.keep((\ x (eq_pith name x.recipe.name)))

  +  fallback_recipe_structural
    \  recipe=foundry_doc/recipe
    ^  bool
    ?  !(eq_iota recipe.backend 'neutral)  .false
    ?  (eq_iota recipe.primitive 'knit)    .true
    (eq_iota recipe.primitive 'sewn)

  +  fallback_recipe_surface_matches
    \  recipe=foundry_doc/recipe surface=foundry_doc/surface
    ^  bool
    ?  (foundry_doc/recipe_template recipe)
     > (./some template=path)  (eq_pith template surface.name)
     > .none
       ?  (foundry_doc/recipe_inline recipe)
        > .none  .false
        > (./some inline=foundry_doc/surface)  (equal inline surface)

  +  fallback_surface_root
    \  surface=foundry_doc/surface
    ^  maybe[foundry_doc/surface_node]
    (foundry_delivery/surface_node_at surface.root surface.nodes)

  +  materialize_fallback
    '  Realize one selected semantic fallback.  The Recipe must describe a
    '  renderer-neutral structural primitive and its admitted Surface must
    '  agree with the Recipe output.  The resulting placement carries the
    '  Recipe path as provenance; no renderer default is involved.
    \  parent=path placement=path slot_node=foundry_doc/surface_node
       contract=foundry_doc/slot_contract ceiling=iota
       current=foundry_doc/surface
       recipes=row[foundry_doc/surface_recipe]
       fallback=path
    ^  surface_slot_plan
    =  hits=row[foundry_doc/surface_recipe]
         (foundry_delivery/surface_recipes_named fallback recipes)
    ?  !(eq 1 hits.len)
       (surface_slot_plan/refused 'slot_fallback_unmaterialized fallback)
    =  materialized=foundry_doc/surface_recipe  hits.at(0)
       recipe=foundry_doc/recipe                materialized.recipe
       surface=foundry_doc/surface              materialized.surface
       fallback_kind=iota
         ?  recipe.fallback_class
          > (./some class=iota)  class
          > .none                 'undeclared
    ?  !(foundry/fallback_class fallback_kind)
       (surface_slot_plan/refused 'slot_fallback_class_required recipe.name)
    ?  !(foundry_delivery/fallback_recipe_structural recipe)
       (surface_slot_plan/refused 'slot_fallback_primitive_invalid recipe.name)
    ?  !(foundry_delivery/fallback_recipe_surface_matches recipe surface)
       (surface_slot_plan/refused 'slot_fallback_template_mismatch recipe.name)
    ?  (foundry_delivery/fallback_surface_root surface)
     > .none
       (surface_slot_plan/refused 'slot_fallback_root_missing surface.root)
     > (./some root=foundry_doc/surface_node)
       ?  !(eq_iota recipe.output_kind root.kind)
          (surface_slot_plan/refused 'slot_fallback_kind_mismatch recipe.name)
       ?  !(foundry/within recipe.output_kind recipe.ceiling)
          (surface_slot_plan/refused 'slot_fallback_recipe_ceiling_refused
            recipe.name)
       =  rule
            (foundry/fallback fallback_kind recipe.name recipe.output_kind
              recipe.output_kind)
          core
            (foundry/slot_contract slot_node.role contract.accepts
              contract.cardinality contract.required (./some rule)
              contract.participation)
       ?  (foundry/resolve_slot core [] ceiling .true)
        > x=foundry/slot_outcome/refused
          (surface_slot_plan/refused x.diagnostic.code x.diagnostic.at)
        > foundry/slot_outcome/omitted
          (surface_slot_plan/refused 'slot_fallback_unmaterialized recipe.name)
        > foundry/slot_outcome/resolved
          (surface_slot_plan/refused 'slot_fallback_resolution_invalid
            recipe.name)
        > foundry/slot_outcome/fallback
          ?  (foundry_delivery/surface_node_conflict
                current.nodes surface.nodes)
           > (./some collision=path)
             (surface_slot_plan/refused
               'slot_fallback_definition_collision collision)
           > .none
             =  merged  (foundry_delivery/surface_merge current surface)
                edge    (foundry_doc/surface_edge parent placement surface.root)
                next
                  (foundry_doc/surface merged.name merged.root merged.nodes
                    (foundry_delivery/surface_edge_add edge merged.edges))
                binding
                  (surface_slot_binding parent placement
                    contract.participation (./some recipe.name)
                    (./some fallback_kind))
             (surface_slot_plan/admitted next [binding] [recipe.name])

  +  slot_bindings
    \  parent=path placement=path participation=path
       edges=row[foundry_doc/surface_edge]
    ^  row[surface_slot_binding]
    edges.map((\ edge (surface_slot_binding parent placement participation
      .none .none)))

  +  realize_parent_slots
    \  parent=path template=foundry_doc/surface
       template_edges=row[foundry_doc/surface_edge]
       attachments=row[foundry_doc/surface_edge]
       ceiling=iota recipes=row[foundry_doc/surface_recipe]
       index=nat current=foundry_doc/surface
       bindings=row[surface_slot_binding]
       selected=row[path]
    ^  surface_slot_plan
    ?  (ge index template_edges.len)
       (surface_slot_plan/admitted current bindings selected)
    =  slot_edge  template_edges.at(index)
    ?  (foundry_delivery/duplicate_place_before index template_edges)
       (surface_slot_plan/refused 'template_slot_collision
         slot_edge.placement)
    ?  (foundry_delivery/surface_node_at slot_edge.child template.nodes)
     > .none
       (surface_slot_plan/refused 'template_slot_missing slot_edge.child)
     > (./some slot_node=foundry_doc/surface_node)
       ?  !(eq_iota slot_node.kind 'slot)
          (surface_slot_plan/refused 'template_child_not_slot
            slot_node.address)
       ?  slot_node.contract
        > .none
          (surface_slot_plan/refused 'template_slot_contract_missing
            slot_node.address)
        > (./some contract=foundry_doc/slot_contract)
          =  placed  attachments.keep((\ e (eq_pith
                         e.placement slot_edge.placement)))
          ?  (foundry_delivery/edge_kinds placed current.nodes)
           > .none
             (surface_slot_plan/refused 'surface_child_unaddressed
               slot_edge.placement)
           > (./some kinds=row[iota])
             ?  (eq 0 kinds.len)
                ?  contract.fallback
                 > (./some fallback=path)
                   ?  (foundry_delivery/materialize_fallback parent
                         slot_edge.placement slot_node contract ceiling
                         current recipes fallback)
                    > x=surface_slot_plan/refused  x
                    > x=surface_slot_plan/admitted
                      (_ parent template template_edges attachments ceiling
                        recipes index.inc x.surface
                        bindings.weld(x.bindings)
                        x.fallbacks.fold(selected
                          foundry_delivery/path_fold_unique))
                 > .none
                   =  core
                        (foundry/slot_contract slot_node.role contract.accepts
                          contract.cardinality contract.required .none
                          contract.participation)
                   ?  (foundry/resolve_slot core [] ceiling .false)
                    > foundry/slot_outcome/omitted
                      (_ parent template template_edges attachments ceiling
                        recipes index.inc current bindings selected)
                    > x=foundry/slot_outcome/refused
                      (surface_slot_plan/refused x.diagnostic.code
                        x.diagnostic.at)
                    > foundry/slot_outcome/fallback
                      (surface_slot_plan/refused
                        'slot_fallback_resolution_invalid slot_node.address)
                    > foundry/slot_outcome/resolved
                      (surface_slot_plan/refused
                        'slot_resolution_invalid slot_node.address)
             =  core
                  (foundry/slot_contract slot_node.role contract.accepts
                    contract.cardinality contract.required .none
                    contract.participation)
                outcome  (foundry/resolve_slot core kinds ceiling .false)
             ?  outcome
              > foundry/slot_outcome/omitted
                (_ parent template template_edges attachments ceiling recipes
                  index.inc current bindings selected)
              > foundry/slot_outcome/fallback
                (surface_slot_plan/refused 'slot_fallback_unmaterialized
                  slot_node.address)
              > x=foundry/slot_outcome/refused
                (surface_slot_plan/refused x.diagnostic.code
                  x.diagnostic.at)
              > foundry/slot_outcome/resolved
                =  next_bindings
                     bindings.weld((foundry_delivery/slot_bindings parent
                       slot_edge.placement contract.participation placed))
                   next
                     (foundry_doc/surface current.name current.root current.nodes
                       current.edges.weld(placed))
                (_ parent template template_edges attachments ceiling recipes
                  index.inc next next_bindings selected)

  +  realize_parent
    \  parent=path current=foundry_doc/surface
       template=foundry_doc/surface ceiling=iota
       recipes=row[foundry_doc/surface_recipe]
    ^  surface_slot_plan
    =  template_edges
         (foundry_delivery/surface_edges_for template.root template.edges)
       attachments
         (foundry_delivery/surface_edges_for parent current.edges)
       unknown
         (foundry_delivery/unknown_attachment attachments template_edges)
    ?  (eq 0 template_edges.len)
       (surface_slot_plan/refused 'template_slots_required template.root)
    ?  unknown
     > (./some e=foundry_doc/surface_edge)
       (surface_slot_plan/refused 'slot_placement_undeclared e.placement)
     > .none
       =  base
            (foundry_doc/surface current.name current.root current.nodes
              (foundry_delivery/surface_edges_without parent current.edges))
       (foundry_delivery/realize_parent_slots parent template template_edges
         attachments ceiling recipes 0 base [] [])

  +  node_uses_template
    \  template=path node=foundry_doc/surface_node
    ^  bool
    ?  node.template
     > .none  .false
     > (./some ref=path)  (eq_pith ref template)

  +  realize_template_nodes
    \  instance=foundry_doc/surface template=foundry_doc/surface
       ceiling=iota recipes=row[foundry_doc/surface_recipe]
       index=nat current=foundry_doc/surface
       bindings=row[surface_slot_binding]
       selected=row[path]
    ^  surface_template_result
    ?  (ge index instance.nodes.len)
       (surface_template_result/admitted current bindings selected)
    =  node  instance.nodes.at(index)
    ?  !(foundry_delivery/node_uses_template template.name node)
       (_ instance template ceiling recipes index.inc current bindings selected)
    ?  (foundry_delivery/surface_node_at template.root template.nodes)
     > .none
       (surface_template_result/refused 'template_root_missing template.root)
     > (./some template_root=foundry_doc/surface_node)
       ?  !(eq_iota node.kind template_root.kind)
          (surface_template_result/refused 'template_kind_mismatch
            node.address)
       ?  (foundry_delivery/realize_parent node.address current template ceiling
             recipes)
        > x=surface_slot_plan/refused
          (surface_template_result/refused x.code x.at)
        > x=surface_slot_plan/admitted
          =  next_selected
               x.fallbacks.fold(selected foundry_delivery/path_fold_unique)
          (_ instance template ceiling recipes index.inc x.surface
            bindings.weld(x.bindings) next_selected)

  +  realize_surface_template
    '  Apply one admitted shared template to every instance node that names
    '  it.  Slot order and participation come from the template; attachment
    '  content and child roles remain owned by the instance surface.
    \  instance=foundry_doc/surface template=foundry_doc/surface ceiling=iota
    ^  surface_template_result
    (foundry_delivery/realize_template_nodes instance template ceiling [] 0
      instance [] [])

  +  realize_surface_template_with_fallbacks
    '  Apply a shared template with a closed set of admitted Recipe + Surface
    '  materializations.  Unused candidates do nothing; a selected Slot
    '  fallback must resolve uniquely and is returned as exact evidence.
    \  instance=foundry_doc/surface template=foundry_doc/surface ceiling=iota
       recipes=row[foundry_doc/surface_recipe]
    ^  surface_template_result
    (foundry_delivery/realize_template_nodes instance template ceiling
      recipes 0 instance [] [])

  +  definition_axis
    '  A compiled node definition has one structural identity regardless of
    '  how many contextual edges place it.
    \  index=nat
    ^  row[projection_axis]
    [(projection_axis/branch 'definition) (projection_axis/kid index)]

  +  definition_address
    \  source=foundry_digest index=nat
    ^  projection_address
    (projection_address source (foundry_delivery/definition_axis index))

  +  placement_axis
    '  Placement identity is derived from the parent definition occurrence
    '  plus every step of the authored edge placement.  The authored node
    '  path is only a lookup label and never enters this address.
    \  parent=row[projection_axis] place=path
    ^  row[projection_axis]
    |  > i=nat 0
       > out=row[projection_axis]
         parent.snoc((projection_axis/branch 'placement))
    ^  row[projection_axis]
    ?  (ge i place.len)
       out
    (_ i.inc out.snoc((projection_axis/slot place.at(i))))

  +  placement_axis_at
    '  The first occurrence preserves the original stable address.  Further
    '  attachments to one `many` Slot append an explicit leg ordinal so two
    '  contextual edges can never alias.
    \  parent=row[projection_axis] place=path ordinal=nat
    ^  row[projection_axis]
    =  base  (foundry_delivery/placement_axis parent place)
    ?  (eq ordinal 0)  base
    base.snoc((projection_axis/leg ordinal))

  +  placement_address
    \  source=foundry_digest parent_index=nat place=path
    ^  projection_address
    (projection_address source
      (foundry_delivery/placement_axis_at
        (foundry_delivery/definition_axis parent_index) place 0))

  +  placement_address_at
    \  source=foundry_digest parent_index=nat place=path ordinal=nat
    ^  projection_address
    (projection_address source
      (foundry_delivery/placement_axis_at
        (foundry_delivery/definition_axis parent_index) place ordinal))

  +  edge_placement_ordinal
    \  index=nat edges=row[foundry_doc/surface_edge]
    ^  nat
    =  edge  edges.at(index)
    |  > i=nat 0  > count=nat 0
    ^  nat
    ?  (ge i index)  count
    =  old  edges.at(i)
    ?  (if (eq_pith edge.parent old.parent)
          (eq_pith edge.placement old.placement)
          .false)
       (_ i.inc count.inc)
    (_ i.inc count)

  +  surface_node_index
    '  Authored paths resolve references inside the already-compiled
    '  Semidoc DAG.  The resulting ordinal, not the path, owns identity.
    \  authored=path nodes=row[foundry_doc/surface_node]
    ^  maybe[nat]
    |  > i=nat 0
    ^  maybe[nat]
    ?  (ge i nodes.len)
       .none
    ?  (eq_pith authored nodes.at(i).address)
       (./some i)
    (_ i.inc)

  +  local_address
    \  authored=path source=foundry_digest
       nodes=row[foundry_doc/surface_node]
    ^  maybe[projection_address]
    ?  (foundry_delivery/surface_node_index authored nodes)
     > .none  .none
     > (./some i=nat)
       (./some (foundry_delivery/definition_address source i))

  +  optional_local_address
    \  authored=maybe[path] source=foundry_digest
       nodes=row[foundry_doc/surface_node]
    ^  maybe[projection_address]
    ?  authored
     > .none  .none
     > (./some p=path)
       (foundry_delivery/local_address p source nodes)

  +  semantic_parameter
    \  key=path value=path
    ^  projection_parameter
    (projection_parameter key (projection_value/semantic_ref value))

  +  add_semantic_parameter
    \  key=path value=maybe[path] params=row[projection_parameter]
    ^  row[projection_parameter]
    ?  value
     > .none  params
     > (./some p=path)
       params.snoc((foundry_delivery/semantic_parameter key p))

  +  slot_contract_parameters
    \  c=foundry_doc/slot_contract
       params=row[projection_parameter]
    ^  row[projection_parameter]
    =  p0
         c.accepts.fold(params ;
           \  out=row[projection_parameter] kind=iota
           out.snoc((projection_parameter ['slot 'accepts kind]
             (projection_value/flag .true))))
       p1 p0.snoc((projection_parameter ['slot 'cardinality]
            (projection_value/name c.cardinality)))
       p2 p1.snoc((projection_parameter ['slot 'required]
            (projection_value/flag c.required)))
       p3 p2.snoc((foundry_delivery/semantic_parameter
            ['slot 'participation] c.participation))
    (foundry_delivery/add_semantic_parameter
      ['slot 'fallback] c.fallback p3)

  +  node_parameters
    '  Preserve unresolved authoring references as semantic parameters.  A
    '  later Foundry/Zoo pass may resolve them; this bridge never converts a
    '  path into occurrence identity.
    \  n=foundry_doc/surface_node
    ^  row[projection_parameter]
    =  p0  (foundry_delivery/add_semantic_parameter
              ['surface 'slot] n.slot [])
       p1  (foundry_delivery/add_semantic_parameter
              ['surface 'hole] n.hole p0)
       p2  (foundry_delivery/add_semantic_parameter
              ['surface 'fallback] n.fallback p1)
       p3  (foundry_delivery/add_semantic_parameter
              ['surface 'source] n.source p2)
       p4  (foundry_delivery/add_semantic_parameter
              ['surface 'action] n.action p3)
       p5  (foundry_delivery/add_semantic_parameter
              ['surface 'destination] n.destination p4)
       p6  (foundry_delivery/add_semantic_parameter
              ['surface 'template] n.template p5)
       p7
         ?  n.text
          > .none  p6
          > (./some body=nat)
            p6.snoc((projection_parameter ['surface 'text]
              (projection_value/text body)))
    ?  n.contract
     > .none  p7
     > (./some c=foundry_doc/slot_contract)
       (foundry_delivery/slot_contract_parameters c p7)

  +  node_placement_addresses
    \  authored=path parent_index=nat source=foundry_digest
       edges=row[foundry_doc/surface_edge]
    ^  row[projection_address]
    |  > i=nat 0  > out=row[projection_address] []
    ^  row[projection_address]
    ?  (ge i edges.len)
       out
    =  e  edges.at(i)
    ?  !(eq_pith authored e.parent)
       (_ i.inc out)
    =  ordinal  (foundry_delivery/edge_placement_ordinal i edges)
    (_ i.inc out.snoc((foundry_delivery/placement_address_at
      source parent_index e.placement ordinal)))

  +  bridge_node
    \  source=foundry_digest recipe=foundry_digest
       sf=foundry_doc/surface index=nat root_index=nat
       resolved_parameters=row[projection_parameter]
    ^  projection_object
    =  n   sf.nodes.at(index)
       at  (foundry_delivery/definition_address source index)
       fallback
         (foundry_delivery/optional_local_address n.fallback source sf.nodes)
       authored  (foundry_delivery/node_parameters n)
       parameters
         ?  (eq index root_index)
            authored.weld(resolved_parameters)
         authored
    ?  n.hole
     > (./some _)
       (projection_object/node
         (projection_node at
           (projection_node_body/hole
             (projection_hole n.role n.kind fallback n.fallback
               parameters))))
     > .none
       =  places (foundry_delivery/node_placement_addresses
                    n.address index source sf.edges)
          syntax  (projection_syntax n.kind n.role recipe
                    parameters
                    places [] fallback)
       (projection_object/node
         (projection_node at (projection_node_body/semantic syntax)))

  +  slot_binding_at
    \  parent=path placement=path bindings=row[surface_slot_binding]
    ^  maybe[surface_slot_binding]
    |  > i=nat 0
    ^  maybe[surface_slot_binding]
    ?  (ge i bindings.len)  .none
    =  binding  bindings.at(i)
    ?  (if (eq_pith parent binding.parent)
           (eq_pith placement binding.placement)
           .false)
       (./some binding)
    (_ i.inc)

  +  slot_binding_parameters
    '  Exact fallback selection rides on the contextual placement as
    '  renderer-neutral provenance.  Ordinary attachments add no parameter.
    \  binding=maybe[surface_slot_binding]
    ^  row[projection_parameter]
    ?  binding
     > .none  []
     > (./some b=surface_slot_binding)
       ?  b.fallback
        > .none  []
        > (./some recipe=path)
          =  recipe_parameter
               (projection_parameter ['foundry 'fallback 'recipe]
                 (projection_value/semantic_ref recipe))
          ?  b.fallback_class
           > .none  [recipe_parameter]
           > (./some class=iota)
             [(projection_parameter ['foundry 'fallback 'class]
                (projection_value/name class))
              recipe_parameter]

  +  bridge_placement
    \  source=foundry_digest sf=foundry_doc/surface
       bindings=row[surface_slot_binding] edge_index=nat
    ^  maybe[projection_object]
    =  edge  sf.edges.at(edge_index)
    ?  (foundry_delivery/surface_node_index edge.parent sf.nodes)
     > .none  .none
     > (./some parent_index=nat)
       ?  (foundry_delivery/surface_node_index edge.child sf.nodes)
        > .none  .none
        > (./some child_index=nat)
          =  parent_at (foundry_delivery/definition_address source parent_index)
             child_at  (foundry_delivery/definition_address source child_index)
             ordinal   (foundry_delivery/edge_placement_ordinal
                         edge_index sf.edges)
             edge_at   (foundry_delivery/placement_address_at
                         source parent_index edge.placement ordinal)
             child     sf.nodes.at(child_index)
             binding
               (foundry_delivery/slot_binding_at
                 edge.parent edge.placement bindings)
             role
               ?  binding
                > .none  child.role
                > (./some b=surface_slot_binding)  b.participation
             parameters
               (foundry_delivery/slot_binding_parameters binding)
          (./some
            (projection_object/placement
              (projection_placement edge_at parent_at role parameters .none
                (projection_placement_target/child child_at))))

  +  duplicate_node_path
    \  i=nat nodes=row[foundry_doc/surface_node]
    ^  bool
    |  > j=nat 0
    ^  bool
    ?  (ge j i)
       .false
    ?  (eq_pith nodes.at(i).address nodes.at(j).address)
       .true
    (_ j.inc)

  +  bridge_issue
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest sf=foundry_doc/surface
    ^  maybe[projection_bridge_result]
    ?  !(foundry_digest/valid source)
       (./some (projection_bridge_result/refused
         'invalid_source_digest ['foundry 'source]))
    ?  !(foundry_digest/valid recipe)
       (./some (projection_bridge_result/refused
         'invalid_recipe_digest ['foundry 'recipe]))
    ?  !(foundry_digest/valid revision)
       (./some (projection_bridge_result/refused
         'invalid_revision ['foundry 'revision]))
    ?  (foundry_delivery/surface_node_index sf.root sf.nodes)
     > .none
       (./some (projection_bridge_result/refused
         'surface_root_missing sf.root))
     > (./some _)
       |  > i=nat 0
       ^  maybe[projection_bridge_result]
       ?  (ge i sf.nodes.len)
          |  > j=nat 0
          ^  maybe[projection_bridge_result]
          ?  (ge j sf.edges.len)
             .none
          =  e sf.edges.at(j)
          ?  (foundry_delivery/surface_node_index e.parent sf.nodes)
           > .none
             (./some (projection_bridge_result/refused
               'surface_parent_missing e.parent))
           > (./some _)
             ?  (foundry_delivery/surface_node_index e.child sf.nodes)
              > .none
                (./some (projection_bridge_result/refused
                  'surface_child_unaddressed e.child))
              > (./some _)
                (_ j.inc)
       ?  (foundry_delivery/duplicate_node_path i sf.nodes)
          (./some (projection_bridge_result/refused
            'surface_address_collision sf.nodes.at(i).address))
       (_ i.inc)

  +  bridge_entry
    '  Open a bridge-produced object without depending on the progressive
    '  delivery helpers declared later in this module.
    \  object=projection_object
    ^  projection_entry
    ?  object
     > x=projection_object/node       (projection_entry/node x.node)
     > x=projection_object/placement  (projection_entry/placement x.placement)
     > x=projection_object/interaction
       (projection_entry/interaction x.interaction)

  +  authoring_surface_dag_parameters
    '  Internal canonical builder after resolution parameter admission.
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest sf=foundry_doc/surface
       bindings=row[surface_slot_binding]
       resolved_parameters=row[projection_parameter]
    ^  projection_bridge_result
    ?  (foundry_delivery/bridge_issue source recipe revision sf)
     > (./some refused=projection_bridge_result)  refused
     > .none
       =  root_index
            ?  (foundry_delivery/surface_node_index sf.root sf.nodes)
             > (./some i=nat)  i
             > .none           0
          node_entries
            |  > i=nat 0  > out=row[projection_entry] []
            ^  row[projection_entry]
            ?  (ge i sf.nodes.len)
               out
            =  object (foundry_delivery/bridge_node source recipe sf i
                        root_index resolved_parameters)
            (_ i.inc out.snoc((foundry_delivery/bridge_entry object)))
          all_entries
            |  > i=nat 0  > out=row[projection_entry] node_entries
            ^  row[projection_entry]
            ?  (ge i sf.edges.len)
               out
            ?  (foundry_delivery/bridge_placement source sf bindings i)
             > .none  (_ i.inc out)
             > (./some object=projection_object)
               (_ i.inc out.snoc((foundry_delivery/bridge_entry object)))
          root (foundry_delivery/definition_address source root_index)
          manifest (projection_manifest revision [root] [] [])
       (projection_bridge_result/admitted
         (projection_dag manifest [] all_entries))

  +  authoring_surface_dag_input
    '  Cross the structural boundary from one complete generic input.  Layer
    '  resolution is admitted once, attached to the semantic root, and folded
    '  into the revision.  This bridge emits no renderer or transport data.
    \  input=projection_bridge_input
    ^  projection_bridge_result
    ?  (foundry_delivery/bridge_issue input.source input.recipe
         input.revision input.surface)
     > (./some refused=projection_bridge_result)  refused
     > .none
       =  bound_revision
            (foundry_delivery/bound_revision input.revision input.bindings)
       ?  input.resolution
        > .none
          (foundry_delivery/authoring_surface_dag_parameters
            input.source input.recipe bound_revision input.surface
            input.bindings [])
        > (./some resolution=projection_resolution)
          ?  (foundry_delivery/parameterize_resolution resolution)
           > refused=projection_parameterization_result/refused
             (projection_bridge_result/refused refused.code refused.at)
           > admitted=projection_parameterization_result/admitted
             =  revision  (foundry_delivery/hydrated_revision
                              bound_revision admitted.parameters)
             (foundry_delivery/authoring_surface_dag_parameters
               input.source input.recipe revision input.surface input.bindings
               admitted.parameters)

  +  authoring_surface_dag
    '  Compatibility gate for a bridge with no layer resolution.  Existing
    '  callers retain their exact revision and authored parameters.
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest sf=foundry_doc/surface
    ^  projection_bridge_result
    (foundry_delivery/authoring_surface_dag_input
      (projection_bridge_input source recipe revision sf [] .none))

  +  surface_dag
    '  Compatibility spelling for the first Foundry prototype.  New callers
    '  should use authoring_surface_dag so a tree-shaped compiler surface is
    '  not mistaken for the canonical delivery structure.
    \  source=foundry_digest recipe=foundry_digest
       revision=foundry_digest sf=foundry_doc/surface
    ^  projection_bridge_result
    (foundry_delivery/authoring_surface_dag source recipe revision sf)

  +  object_address
    \  object=projection_object
    ^  projection_address
    ?  object
     > x=projection_object/node       x.node.address
     > x=projection_object/placement  x.placement.address
     > x=projection_object/interaction  x.interaction.address

  +  object_kind
    \  object=projection_object
    ^  iota
    ?  object
     > x=projection_object/node       'node
     > x=projection_object/placement  'placement
     > x=projection_object/interaction  'interaction

  +  object_hole
    \  object=projection_object
    ^  bool
    ?  object
     > x=projection_object/node
       ?  x.node.body
        > y=projection_node_body/hole      .true
        > y=projection_node_body/semantic  .false
     > x=projection_object/placement
       ?  x.placement.target
        > y=projection_placement_target/hole   .true
        > y=projection_placement_target/child  .false
     > projection_object/interaction  .false

  +  hole_valid
    \  hole=projection_hole
    ^  bool
    ?  !(foundry_delivery/optional_address_valid hole.fallback)
       .false
    (foundry_delivery/parameters_valid hole.parameters)

  +  syntax_valid
    \  syntax=projection_syntax
    ^  bool
    ?  !(foundry_digest/valid syntax.recipe)
       .false
    ?  !(foundry_delivery/addresses_valid syntax.placements)
       .false
    ?  !(foundry_delivery/addresses_valid syntax.dependencies)
       .false
    (foundry_delivery/optional_address_valid syntax.fallback)

  +  value_valid
    \  value=projection_value
    ^  bool
    ?  value
     > x=projection_value/ref
       (foundry_delivery/address_valid x.value)
     > x=projection_value/flag          .true
     > x=projection_value/count         .true
     > x=projection_value/text          .true
     > x=projection_value/name          .true
     > x=projection_value/semantic_ref  .true

  +  parameters_valid
    \  parameters=row[projection_parameter]
    ^  bool
    parameters.all((\ p (foundry_delivery/value_valid p.value)))

  +  optional_digest_valid
    \  digest=maybe[foundry_digest]
    ^  bool
    ?  digest
     > .none  .true
     > (./some value=foundry_digest)  (foundry_digest/valid value)

  +  digest_before
    \  index=nat digests=row[foundry_digest]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i index)  .false
    ?  (equal digests.at(i) digests.at(index))  .true
    (_ i.inc)

  +  digests_valid_unique
    \  digests=row[foundry_digest]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i digests.len)  .true
    ?  !(foundry_digest/valid digests.at(i))  .false
    ?  (foundry_delivery/digest_before i digests)  .false
    (_ i.inc)

  +  guard_provenance_valid
    \  guard=projection_guard_provenance
    ^  bool
    ?  guard
     > projection_guard_provenance/unguarded  .true
     > x=projection_guard_provenance/guarded
       ?  !(foundry_digest/valid x.policy)  .false
       (foundry_digest/valid x.witness)

  +  delta_key_before
    \  index=nat deltas=row[projection_resolution_delta]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i index)  .false
    ?  (eq_pith deltas.at(i).key deltas.at(index).key)  .true
    (_ i.inc)

  +  resolution_deltas_valid
    \  deltas=row[projection_resolution_delta]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i deltas.len)  .true
    =  delta  deltas.at(i)
    ?  (eq 0 delta.key.len)  .false
    ?  !(foundry_delivery/value_valid delta.value)  .false
    ?  !(foundry_digest/valid delta.winner)  .false
    ?  !(foundry_delivery/guard_provenance_valid delta.guard)  .false
    ?  (foundry_delivery/delta_key_before i deltas)  .false
    (_ i.inc)

  +  resolution_context_valid
    '  Validate both the typed evidence and its claimed content identity.
    '  The enclosing projection revision binding is an orchestration law and
    '  deliberately remains outside this standalone companion check.
    \  context=projection_resolution_context
    ^  bool
    ?  !(foundry_digest/valid context.digest)  .false
    ?  !(foundry_delivery/optional_digest_valid context.parent)  .false
    ?  !(foundry_delivery/address_valid context.scope)  .false
    ?  !(foundry_delivery/digests_valid_unique context.local_layers)  .false
    ?  !(foundry_delivery/resolution_deltas_valid context.deltas)  .false
    =  expected  (foundry_delivery/resolution_context_identity
                    context.parent context.scope
                    context.local_layers context.deltas)
    (equal context.digest expected)

  +  action_mount_valid
    \  mount=projection_action_mount
    ^  bool
    ?  (eq 0 mount.action.len)  .false
    ?  !(foundry_digest/valid mount.pin)  .false
    ?  (eq 0 mount.input.len)  .false
    (foundry_digest/valid mount.admission)

  +  action_before
    \  index=nat actions=row[projection_action_mount]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i index)  .false
    ?  (eq_pith actions.at(i).action actions.at(index).action)  .true
    (_ i.inc)

  +  actions_valid_unique
    '  One interaction cannot mount the same semantic Action twice under
    '  different mechanical spellings or evidence rows.
    \  actions=row[projection_action_mount]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i actions.len)  .true
    ?  !(foundry_delivery/action_mount_valid actions.at(i))  .false
    ?  (foundry_delivery/action_before i actions)  .false
    (_ i.inc)

  +  destination_mount_valid
    \  mount=projection_destination_mount
    ^  bool
    ?  (eq 0 mount.declaration.len)  .false
    (foundry_delivery/address_valid mount.target)

  +  interaction_valid
    '  Intrinsic validation is intentionally authority-free.  Exact Block
    '  ownership and destination presence are checked against the complete
    '  DAG by interaction_complete below.
    \  interaction=projection_interaction
    ^  bool
    ?  !(foundry_delivery/address_valid interaction.address)  .false
    ?  !(foundry_delivery/address_valid interaction.owner)  .false
    ?  !(foundry_delivery/actions_valid_unique interaction.actions)  .false
    ?  interaction.destination
     > .none
       (gt interaction.actions.len 0)
     > (./some mount=projection_destination_mount)
       (foundry_delivery/destination_mount_valid mount)

  +  object_valid
    \  object=projection_object
    ^  bool
    ?  object
     > x=projection_object/node
       ?  !(foundry_delivery/address_valid x.node.address)
          .false
       ?  x.node.body
        > y=projection_node_body/hole
          (foundry_delivery/hole_valid y.hole)
        > y=projection_node_body/semantic
          (foundry_delivery/syntax_valid y.syntax)
     > x=projection_object/placement
       ?  !(foundry_delivery/address_valid x.placement.address)
          .false
       ?  !(foundry_delivery/address_valid x.placement.parent)
          .false
       ?  !(foundry_delivery/parameters_valid x.placement.parameters)
          .false
       ?  !(foundry_delivery/optional_digest_valid
             x.placement.resolution_context)
          .false
       ?  x.placement.target
        > y=projection_placement_target/child
          (foundry_delivery/address_valid y.address)
        > y=projection_placement_target/hole
          (foundry_delivery/hole_valid y.hole)
     > x=projection_object/interaction
       (foundry_delivery/interaction_valid x.interaction)

  +  known_target
    \  target=iota
    ^  bool
    ?  (eq_iota target 'node)
       .true
    ?  (eq_iota target 'placement)
       .true
    (eq_iota target 'interaction)

  +  object_entry
    \  object=projection_object
    ^  projection_entry
    ?  object
     > x=projection_object/node
       (projection_entry/node x.node)
     > x=projection_object/placement
       (projection_entry/placement x.placement)
     > x=projection_object/interaction
       (projection_entry/interaction x.interaction)

  +  entry_address
    \  entry=projection_entry
    ^  projection_address
    ?  entry
     > x=projection_entry/node       x.node.address
     > x=projection_entry/placement  x.placement.address
     > x=projection_entry/interaction  x.interaction.address
     > x=projection_entry/tombstone  x.tombstone.address

  +  entry_kind
    \  entry=projection_entry
    ^  iota
    ?  entry
     > x=projection_entry/node       'node
     > x=projection_entry/placement  'placement
     > x=projection_entry/interaction  'interaction
     > x=projection_entry/tombstone  x.tombstone.target

  +  entry_hole
    \  entry=projection_entry
    ^  bool
    ?  entry
     > x=projection_entry/node
       (foundry_delivery/object_hole (projection_object/node x.node))
     > x=projection_entry/placement
       (foundry_delivery/object_hole
         (projection_object/placement x.placement))
     > projection_entry/interaction  .false
     > x=projection_entry/tombstone  .false

  +  find
    \  address=projection_address entries=row[projection_entry]
    ^  maybe[projection_entry]
    |  > i=nat 0
    ^  maybe[projection_entry]
    ?  (ge i entries.len)
       .none
    ?  (equal address (foundry_delivery/entry_address entries.at(i)))
       (./some entries.at(i))
    (_ i.inc)

  +  has_address
    \  address=projection_address entries=row[projection_entry]
    ^  bool
    ?  (foundry_delivery/find address entries)
     > .none       .false
     > (./some _)  .true

  +  address_in
    \  address=projection_address addresses=row[projection_address]
    ^  bool
    addresses.any((\ at (equal address at)))

  '  Resolution-context table admission ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  +  resolution_context_at
    \  digest=foundry_digest
       contexts=row[projection_resolution_context]
    ^  maybe[projection_resolution_context]
    |  > i=nat 0
    ^  maybe[projection_resolution_context]
    ?  (ge i contexts.len)  .none
    ?  (equal digest contexts.at(i).digest)
       (./some contexts.at(i))
    (_ i.inc)

  +  resolution_context_digest_before
    \  index=nat contexts=row[projection_resolution_context]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i index)  .false
    ?  (equal contexts.at(i).digest contexts.at(index).digest)  .true
    (_ i.inc)

  +  resolution_context_parent_present
    \  context=projection_resolution_context
       contexts=row[projection_resolution_context]
    ^  bool
    ?  context.parent
     > .none  .true
     > (./some digest=foundry_digest)
       ?  (foundry_delivery/resolution_context_at digest contexts)
        > .none       .false
        > (./some _)  .true

  +  resolution_context_cycle_from
    '  Content identity already makes a valid cycle computationally
    '  infeasible; this explicit walk also rejects malformed/raw carriers.
    \  digest=foundry_digest contexts=row[projection_resolution_context]
       seen=row[foundry_digest]
    ^  bool
    ?  seen.any((\ item (equal digest item)))  .true
    ?  (foundry_delivery/resolution_context_at digest contexts)
     > .none  .false
     > (./some context=projection_resolution_context)
       ?  context.parent
        > .none  .false
        > (./some parent=foundry_digest)
          (foundry_delivery/resolution_context_cycle_from
            parent contexts seen.snoc(digest))

  +  resolution_contexts_intrinsic_valid
    '  This checks companion evidence only: canonical identity, unique keys,
    '  closed parent references, and acyclicity.  Scope is checked against the
    '  completed DAG separately because Begin may precede every object.
    \  contexts=row[projection_resolution_context]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i contexts.len)  .true
    =  context  contexts.at(i)
    ?  !(foundry_delivery/resolution_context_valid context)  .false
    ?  (foundry_delivery/resolution_context_digest_before i contexts)  .false
    ?  !(foundry_delivery/resolution_context_parent_present context contexts)
       .false
    ?  (foundry_delivery/resolution_context_cycle_from
          context.digest contexts [])
       .false
    (_ i.inc)

  +  resolution_context_scope_valid
    '  Context scopes identify semantic nodes, placement occurrences, or an
    '  explicit frontier reference.  Interactions and tombstones are evidence
    '  about semantic occurrences, not scopes that may define policy.
    \  context=projection_resolution_context dag=projection_dag
    ^  bool
    ?  (foundry_delivery/find context.scope dag.entries)
     > .none
       (foundry_delivery/address_in context.scope dag.manifest.frontier)
     > (./some entry=projection_entry)
       ?  entry
        > projection_entry/node         .true
        > projection_entry/placement    .true
        > projection_entry/interaction  .false
        > projection_entry/tombstone    .false

  +  resolution_context_scope_count
    \  scope=projection_address
       contexts=row[projection_resolution_context]
    ^  nat
    |  > i=nat 0  > count=nat 0
    ^  nat
    ?  (ge i contexts.len)  count
    ?  (equal scope contexts.at(i).scope)
       (_ i.inc count.inc)
    (_ i.inc count)

  +  resolution_context_at_scope
    \  scope=projection_address
       contexts=row[projection_resolution_context]
    ^  maybe[projection_resolution_context]
    |  > i=nat 0
    ^  maybe[projection_resolution_context]
    ?  (ge i contexts.len)  .none
    ?  (equal scope contexts.at(i).scope)  (./some contexts.at(i))
    (_ i.inc)

  +  placement_contexts_none
    \  entries=row[projection_entry]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i entries.len)  .true
    ?  entries.at(i)
     > x=projection_entry/placement
       ?  x.placement.resolution_context
        > .none       (_ i.inc)
        > (./some _)  .false
     > projection_entry/node         (_ i.inc)
     > projection_entry/interaction  (_ i.inc)
     > projection_entry/tombstone    (_ i.inc)

  +  placement_contexts_known
    \  entries=row[projection_entry]
       contexts=row[projection_resolution_context]
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i entries.len)  .true
    ?  entries.at(i)
     > x=projection_entry/placement
       ?  x.placement.resolution_context
        > .none  .false
        > (./some digest=foundry_digest)
          ?  (foundry_delivery/resolution_context_at digest contexts)
           > .none       .false
           > (./some _)  (_ i.inc)
     > projection_entry/node         (_ i.inc)
     > projection_entry/interaction  (_ i.inc)
     > projection_entry/tombstone    (_ i.inc)

  +  placement_context_compatible
    '  A placement reference and its table arrive atomically at Begin/Upsert.
    '  Legacy mode is exactly none + empty table; contextual mode is exactly
    '  some known digest + nonempty table.
    \  placement=projection_placement
       contexts=row[projection_resolution_context]
    ^  bool
    ?  (eq 0 contexts.len)
       ?  placement.resolution_context
        > .none       .true
        > (./some _)  .false
    ?  placement.resolution_context
     > .none  .false
     > (./some digest=foundry_digest)
       ?  (foundry_delivery/resolution_context_at digest contexts)
        > .none       .false
        > (./some _)  .true

  +  object_context_compatible
    \  object=projection_object
       contexts=row[projection_resolution_context]
    ^  bool
    ?  object
     > projection_object/node         .true
     > projection_object/interaction  .true
     > x=projection_object/placement
       (foundry_delivery/placement_context_compatible
         x.placement contexts)

  +  resolution_context_chain_contains
    '  True when target is seed itself or one of seed's admitted ancestors.
    '  Call only after intrinsic validation has proved this table acyclic.
    \  seed=foundry_digest target=foundry_digest
       contexts=row[projection_resolution_context]
    ^  bool
    ?  (equal seed target)  .true
    ?  (foundry_delivery/resolution_context_at seed contexts)
     > .none  .false
     > (./some context=projection_resolution_context)
       ?  context.parent
        > .none  .false
        > (./some parent=foundry_digest)
          (foundry_delivery/resolution_context_chain_contains
            parent target contexts)

  +  context_used_by_placement
    \  digest=foundry_digest dag=projection_dag
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i dag.entries.len)  .false
    ?  dag.entries.at(i)
     > x=projection_entry/placement
       ?  x.placement.resolution_context
        > .none  (_ i.inc)
        > (./some seed=foundry_digest)
          ?  (foundry_delivery/resolution_context_chain_contains
                seed digest dag.contexts)
             .true
          (_ i.inc)
     > projection_entry/node         (_ i.inc)
     > projection_entry/interaction  (_ i.inc)
     > projection_entry/tombstone    (_ i.inc)

  +  context_used_by_root
    \  digest=foundry_digest dag=projection_dag
    ^  bool
    |  > i=nat 0
    ^  bool
    ?  (ge i dag.manifest.roots.len)  .false
    =  root  dag.manifest.roots.at(i)
    ?  (foundry_delivery/resolution_context_at_scope root dag.contexts)
     > .none  (_ i.inc)
     > (./some seed=projection_resolution_context)
       ?  (foundry_delivery/resolution_context_chain_contains
             seed.digest digest dag.contexts)
          .true
       (_ i.inc)

  +  resolution_context_used
    \  context=projection_resolution_context dag=projection_dag
    ^  bool
    ?  (foundry_delivery/context_used_by_placement context.digest dag)  .true
    (foundry_delivery/context_used_by_root context.digest dag)

  +  resolution_context_completion_valid
    '  Context delivery has exactly two modes.  Legacy DAGs carry no table and
    '  no placement references.  Contextual DAGs carry a closed valid table,
    '  every placement names an entry, each root has exactly one scoped
    '  context, and every table row is directly used or an ancestor of a used
    '  row.  A context may refine a broader scope; its scope need not equal the
    '  placement that references it.
    \  dag=projection_dag
    ^  bool
    ?  (eq 0 dag.contexts.len)
       (foundry_delivery/placement_contexts_none dag.entries)
    ?  !(foundry_delivery/resolution_contexts_intrinsic_valid dag.contexts)
       .false
    ?  !(dag.contexts.all(
          \ context
          (foundry_delivery/resolution_context_scope_valid context dag)))
       .false
    ?  !(foundry_delivery/placement_contexts_known
          dag.entries dag.contexts)
       .false
    ?  !(dag.manifest.roots.all(
          \ root
          (eq 1 (foundry_delivery/resolution_context_scope_count
                  root dag.contexts))))
       .false
    dag.contexts.all(
      \ context
      (foundry_delivery/resolution_context_used context dag))

  +  retained
    '  Begin reuses only explicitly retained immutable objects from the last
    '  committed DAG.  Superseded pending work is never a reuse source.
    \  addresses=row[projection_address] state=projection_delivery
    ^  row[projection_entry]
    ?  state.committed
     > .none  []
     > (./some dag=projection_dag)
       |  > i=nat 0  > out=row[projection_entry] []
       ?  (ge i addresses.len)
          out
       ?  (foundry_delivery/find addresses.at(i) dag.entries)
        > .none  (_ i.inc out)
        > (./some entry=projection_entry)
          (_ i.inc out.snoc(entry))

  +  replace_resolved
    \  address=projection_address object=projection_object
       entries=row[projection_entry]
    ^  projection_entry_resolution
    ?  !(equal address (foundry_delivery/object_address object))
       projection_entry_resolution/kind_mismatch
    ?  (foundry_delivery/object_hole object)
       projection_entry_resolution/not_hole
    |  > i=nat 0  > out=row[projection_entry] []
    ?  (ge i entries.len)
       projection_entry_resolution/missing
    =  old  entries.at(i)
    ?  !(equal address (foundry_delivery/entry_address old))
       (_ i.inc out.snoc(old))
    ?  !(foundry_delivery/entry_hole old)
       projection_entry_resolution/not_hole
    ?  !(eq_iota (foundry_delivery/entry_kind old)
                 (foundry_delivery/object_kind object))
       projection_entry_resolution/kind_mismatch
    (projection_entry_resolution/resolved
      out.snoc((foundry_delivery/object_entry object)).weld(entries.drop(i.inc)))

  +  replace_tombstone
    \  address=projection_address target=iota
       entries=row[projection_entry]
    ^  maybe[row[projection_entry]]
    =  tomb  (projection_entry/tombstone
                (projection_tombstone address target))
    |  > i=nat 0  > out=row[projection_entry] []
    ^  maybe[row[projection_entry]]
    ?  (ge i entries.len)
       (./some out.snoc(tomb))
    =  old  entries.at(i)
    ?  !(equal address (foundry_delivery/entry_address old))
       (_ i.inc out.snoc(old))
    ?  !(eq_iota target (foundry_delivery/entry_kind old))
       .none
    (./some out.snoc(tomb).weld(entries.drop(i.inc)))

  +  rejected
    \  code=iota manifest=projection_manifest state=projection_delivery
    ^  projection_delivery_result
    (projection_delivery_result/refused state
      (projection_refusal manifest.revision code))

  +  same_pending
    \  manifest=projection_manifest state=projection_delivery
    ^  bool
    ?  state.pending
     > .none  .false
     > (./some dag=projection_dag)  (equal manifest dag.manifest)

  +  mismatch_code
    '  A frame for the completed manifest is stale; a frame naming some other
    '  frontier while work is pending is a revision mismatch.
    \  manifest=projection_manifest state=projection_delivery
    ^  iota
    ?  state.pending
     > (./some _)  'revision_mismatch
     > .none
       ?  state.committed
        > (./some dag=projection_dag)
          ?  (equal manifest dag.manifest)
             'stale_frame
          'revision_mismatch
        > .none  'frame_without_begin

  '  Completion invariant ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

  +  live_node
    \  address=projection_address entries=row[projection_entry]
    ^  maybe[projection_node]
    ?  (foundry_delivery/find address entries)
     > .none  .none
     > (./some entry=projection_entry)
       ?  entry
        > x=projection_entry/node       (./some x.node)
        > projection_entry/placement    .none
        > projection_entry/interaction  .none
        > projection_entry/tombstone    .none

  +  live_placement
    \  address=projection_address entries=row[projection_entry]
    ^  maybe[projection_placement]
    ?  (foundry_delivery/find address entries)
     > .none  .none
     > (./some entry=projection_entry)
       ?  entry
        > projection_entry/node       .none
        > x=projection_entry/placement  (./some x.placement)
        > projection_entry/interaction  .none
        > projection_entry/tombstone    .none

  +  semantic_block
    \  node=projection_node
    ^  bool
    ?  node.body
     > projection_node_body/hole  .false
     > x=projection_node_body/semantic  (eq_iota x.syntax.kind 'block)

  +  owner_block
    '  An interaction belongs to one exact Block occurrence: either a root
    '  Block (whose definition is itself the entry occurrence) or a placement
    '  whose child is a Block.  A non-root shared definition is deliberately
    '  insufficient because it may participate in many independent places.
    \  owner=projection_address dag=projection_dag
    ^  bool
    ?  (foundry_delivery/live_placement owner dag.entries)
     > (./some placement=projection_placement)
       ?  placement.target
        > projection_placement_target/hole  .false
        > x=projection_placement_target/child
          ?  (foundry_delivery/live_node x.address dag.entries)
           > .none  .false
           > (./some node=projection_node)
             (foundry_delivery/semantic_block node)
     > .none
       ?  !(foundry_delivery/address_in owner dag.manifest.roots)  .false
       ?  (foundry_delivery/live_node owner dag.entries)
        > .none  .false
        > (./some node=projection_node)
          (foundry_delivery/semantic_block node)

  +  known_reference
    \  address=projection_address dag=projection_dag
    ^  bool
    ?  (foundry_delivery/has_address address dag.entries)
       .true
    (foundry_delivery/address_in address dag.manifest.frontier)

  +  duplicate_entries
    \  entries=row[projection_entry]
    ^  bool
    |  > i=nat 0  > j=nat 1
    ^  bool
    ?  (ge i entries.len)
       .false
    ?  (ge j entries.len)
       (_ i.inc i.inc.inc)
    ?  (equal (foundry_delivery/entry_address entries.at(i))
              (foundry_delivery/entry_address entries.at(j)))
       .true
    (_ i j.inc)

  +  duplicate_interaction_owners
    '  projection_interaction is the complete interaction declaration for one
    '  occurrence.  Multiple Actions share its actions row; a second object
    '  for the same owner would make withdrawal and replacement ambiguous.
    \  entries=row[projection_entry]
    ^  bool
    |  > i=nat 0  > j=nat 1
    ^  bool
    ?  (ge i entries.len)  .false
    ?  (ge j entries.len)  (_ i.inc i.inc.inc)
    ?  entries.at(i)
     > x=projection_entry/interaction
       ?  entries.at(j)
        > y=projection_entry/interaction
          ?  (equal x.interaction.owner y.interaction.owner)  .true
          (_ i j.inc)
        > projection_entry/node       (_ i j.inc)
        > projection_entry/placement  (_ i j.inc)
        > projection_entry/tombstone  (_ i j.inc)
     > projection_entry/node       (_ i j.inc)
     > projection_entry/placement  (_ i j.inc)
     > projection_entry/tombstone  (_ i j.inc)

  +  placement_listed
    \  placement=projection_placement entries=row[projection_entry]
    ^  bool
    ?  (foundry_delivery/live_node placement.parent entries)
     > .none  .false
     > (./some parent=projection_node)
       ?  parent.body
        > projection_node_body/hole  .false
        > x=projection_node_body/semantic
          (foundry_delivery/address_in placement.address x.syntax.placements)

  +  node_complete
    \  node=projection_node dag=projection_dag
    ^  bool
    ?  node.body
     > x=projection_node_body/hole
       ?  x.hole.fallback
        > .none  .true
        > (./some at=projection_address)
          (foundry_delivery/known_reference at dag)
     > x=projection_node_body/semantic
       =  syntax x.syntax
       ?  !(syntax.placements.all(
             \  at
             ?  (foundry_delivery/live_placement at dag.entries)
              > .none  .false
              > (./some placement=projection_placement)
                (equal placement.parent node.address)))
          .false
       ?  !(syntax.dependencies.all(
             \  at
             (foundry_delivery/known_reference at dag)))
          .false
       ?  syntax.fallback
        > .none  .true
        > (./some at=projection_address)
          (foundry_delivery/known_reference at dag)

  +  placement_complete
    \  placement=projection_placement dag=projection_dag
    ^  bool
    ?  (foundry_delivery/live_node placement.parent dag.entries)
     > .none  .false
     > (./some _)
       ?  placement.target
        > x=projection_placement_target/child
          (foundry_delivery/known_reference x.address dag)
        > x=projection_placement_target/hole
          ?  x.hole.fallback
           > .none  .true
           > (./some at=projection_address)
             (foundry_delivery/known_reference at dag)

  +  interaction_complete
    '  Intrinsic mount validity is checked on Upsert.  Completion additionally
    '  proves the exact owner is a live Block occurrence and any destination
    '  is a known addressed semantic target (local or explicit frontier).
    \  interaction=projection_interaction dag=projection_dag
    ^  bool
    ?  !(foundry_delivery/owner_block interaction.owner dag)  .false
    ?  interaction.destination
     > .none  .true
     > (./some mount=projection_destination_mount)
       (foundry_delivery/known_reference mount.target dag)

  +  entry_complete
    \  entry=projection_entry dag=projection_dag
    ^  bool
    ?  entry
     > x=projection_entry/node
       (foundry_delivery/node_complete x.node dag)
     > x=projection_entry/placement
       (foundry_delivery/placement_complete x.placement dag)
     > x=projection_entry/interaction
       (foundry_delivery/interaction_complete x.interaction dag)
     > projection_entry/tombstone  .true

  +  completion_valid
    '  Pending slices may be partial.  At Complete, every root must be a live
    '  definition, every declared placement must exist under its exact parent,
    '  every interaction must own one exact Block occurrence, and every
    '  dependency/child/fallback/destination must be present or explicitly
    '  named by the frontier.  Shared definitions remain legal; duplicate
    '  addressed objects, duplicate interaction owners, and dangling edges do
    '  not.
    \  dag=projection_dag
    ^  bool
    ?  !(foundry_delivery/resolution_context_completion_valid dag)
       .false
    ?  (foundry_delivery/duplicate_entries dag.entries)
       .false
    ?  (foundry_delivery/duplicate_interaction_owners dag.entries)
       .false
    ?  !(dag.manifest.roots.all(
          \  at
          ?  (foundry_delivery/live_node at dag.entries)
           > .none       .false
           > (./some _)  .true))
       .false
    dag.entries.all((\ entry (foundry_delivery/entry_complete entry dag)))

  +  apply
    '  Fold one ordered progressive frame.  Begin supersedes pending work and
    '  seeds only the manifest's explicit retain set from committed.  Every
    '  other frame must match the exact pending manifest.  Complete alone
    '  promotes; mismatches are refusal data and never mutate either snapshot.
    \  frame=projection_frame state=projection_delivery
    ^  projection_delivery_result
    ?  frame
     > x=projection_frame/begin
       ?  !(foundry_delivery/manifest_valid x.manifest)
          (foundry_delivery/rejected 'invalid_manifest x.manifest state)
       ?  !(foundry_delivery/resolution_contexts_intrinsic_valid x.contexts)
          (foundry_delivery/rejected
            'invalid_resolution_contexts x.manifest state)
       =  entries (foundry_delivery/retained x.manifest.retain state)
       (projection_delivery_result/accepted
         (projection_delivery state.committed
           (./some (projection_dag x.manifest x.contexts entries)) .none))

     > x=projection_frame/upsert
       ?  !(foundry_delivery/same_pending x.manifest state)
          (foundry_delivery/rejected
            (foundry_delivery/mismatch_code x.manifest state)
            x.manifest state)
       ?  !(foundry_delivery/object_valid x.object)
          (foundry_delivery/rejected 'invalid_object x.manifest state)
       ?  state.pending
        > .none  (foundry_delivery/rejected 'upsert_without_begin x.manifest state)
        > (./some dag=projection_dag)
          =  address  (foundry_delivery/object_address x.object)
             incoming (foundry_delivery/object_entry x.object)
          ?  !(foundry_delivery/object_context_compatible
                x.object dag.contexts)
             (foundry_delivery/rejected
               'resolution_context_mismatch x.manifest state)
          ?  (foundry_delivery/find address dag.entries)
           > .none
             (projection_delivery_result/accepted
               (projection_delivery state.committed
                 (./some (projection_dag
                   dag.manifest dag.contexts dag.entries.snoc(incoming)))
                 state.refusal))
           > (./some old=projection_entry)
             ?  (equal old incoming)
                (projection_delivery_result/accepted state)
             (foundry_delivery/rejected
               'address_content_conflict x.manifest state)

     > x=projection_frame/resolve
       ?  !(foundry_delivery/same_pending x.manifest state)
          (foundry_delivery/rejected
            (foundry_delivery/mismatch_code x.manifest state)
            x.manifest state)
       ?  !(equal x.address (foundry_delivery/object_address x.object))
          (foundry_delivery/rejected 'resolve_address_mismatch x.manifest state)
       ?  !(foundry_delivery/object_valid x.object)
          (foundry_delivery/rejected 'invalid_object x.manifest state)
       ?  (foundry_delivery/object_hole x.object)
          (foundry_delivery/rejected 'resolve_remains_hole x.manifest state)
       ?  state.pending
        > .none  (foundry_delivery/rejected 'resolve_without_begin x.manifest state)
        > (./some dag=projection_dag)
          ?  !(foundry_delivery/object_context_compatible
                x.object dag.contexts)
             (foundry_delivery/rejected
               'resolution_context_mismatch x.manifest state)
          ?  (foundry_delivery/replace_resolved
               x.address x.object dag.entries)
           > y=projection_entry_resolution/missing
             (foundry_delivery/rejected
               'resolve_missing_hole x.manifest state)
           > y=projection_entry_resolution/not_hole
             (foundry_delivery/rejected
               'resolve_not_hole x.manifest state)
           > y=projection_entry_resolution/kind_mismatch
             (foundry_delivery/rejected
               'resolve_kind_mismatch x.manifest state)
           > y=projection_entry_resolution/resolved
             (projection_delivery_result/accepted
               (projection_delivery state.committed
                 (./some (projection_dag
                   dag.manifest dag.contexts y.entries)) state.refusal))

     > x=projection_frame/withdraw
       ?  !(foundry_delivery/same_pending x.manifest state)
          (foundry_delivery/rejected
            (foundry_delivery/mismatch_code x.manifest state)
            x.manifest state)
       ?  !(foundry_delivery/address_valid x.address)
          (foundry_delivery/rejected 'invalid_address x.manifest state)
       ?  !(foundry_delivery/known_target x.target)
          (foundry_delivery/rejected 'invalid_withdraw_target x.manifest state)
       ?  state.pending
        > .none  (foundry_delivery/rejected 'withdraw_without_begin x.manifest state)
        > (./some dag=projection_dag)
          ?  (foundry_delivery/replace_tombstone
               x.address x.target dag.entries)
           > .none
             (foundry_delivery/rejected
               'withdraw_kind_mismatch x.manifest state)
           > (./some entries=row[projection_entry])
             (projection_delivery_result/accepted
               (projection_delivery state.committed
                 (./some (projection_dag
                   dag.manifest dag.contexts entries)) state.refusal))

     > x=projection_frame/complete
       ?  !(foundry_delivery/same_pending x.manifest state)
          (foundry_delivery/rejected
            (foundry_delivery/mismatch_code x.manifest state)
            x.manifest state)
       ?  state.pending
        > .none  (foundry_delivery/rejected 'complete_without_begin x.manifest state)
        > (./some dag=projection_dag)
          ?  !(foundry_delivery/completion_valid dag)
             (foundry_delivery/rejected 'incomplete_dag x.manifest state)
          (projection_delivery_result/accepted
            (projection_delivery (./some dag) .none state.refusal))

     > x=projection_frame/refuse
       ?  !(foundry_delivery/same_pending x.manifest state)
          (foundry_delivery/rejected
            (foundry_delivery/mismatch_code x.manifest state)
            x.manifest state)
       =  no  (projection_refusal x.manifest.revision x.code)
       (projection_delivery_result/accepted
         (projection_delivery state.committed .none (./some no)))

  '  Inspection gates.  They deliberately reveal semantic state rather than
  '  compiler tuple layout or terminal payloads.
  +  result_state
    \  result=projection_delivery_result
    ^  projection_delivery
    ?  result
     > x=projection_delivery_result/accepted  x.state
     > x=projection_delivery_result/refused   x.state
  +  result_accepted
    \  result=projection_delivery_result
    ^  bool
    ?  result
     > x=projection_delivery_result/accepted  .true
     > x=projection_delivery_result/refused   .false
  +  result_code
    \  result=projection_delivery_result
    ^  maybe[iota]
    ?  result
     > x=projection_delivery_result/accepted  .none
     > x=projection_delivery_result/refused   (./some x.refusal.code)
  +  committed
    \  state=projection_delivery
    ^  maybe[projection_dag]
    state.committed
  +  pending
    \  state=projection_delivery
    ^  maybe[projection_dag]
    state.pending
  +  refusal
    \  state=projection_delivery
    ^  maybe[projection_refusal]
    state.refusal
  +  dag_manifest
    \  dag=projection_dag
    ^  projection_manifest
    dag.manifest
  +  manifest_revision
    \  manifest=projection_manifest
    ^  foundry_digest
    manifest.revision
  +  dag_entries
    \  dag=projection_dag
    ^  row[projection_entry]
    dag.entries
  +  dag_contexts
    \  dag=projection_dag
    ^  row[projection_resolution_context]
    dag.contexts
  +  resolution_context_digest
    \  context=projection_resolution_context
    ^  foundry_digest
    context.digest
  +  resolution_context_parent
    \  context=projection_resolution_context
    ^  maybe[foundry_digest]
    context.parent
  +  resolution_context_scope
    \  context=projection_resolution_context
    ^  projection_address
    context.scope
  +  resolution_context_local_layers
    \  context=projection_resolution_context
    ^  row[foundry_digest]
    context.local_layers
  +  resolution_context_deltas
    \  context=projection_resolution_context
    ^  row[projection_resolution_delta]
    context.deltas
  +  resolution_delta_winner
    \  delta=projection_resolution_delta
    ^  foundry_digest
    delta.winner
  +  resolution_delta_guarded
    \  delta=projection_resolution_delta
    ^  bool
    ?  delta.guard
     > projection_guard_provenance/unguarded  .false
     > projection_guard_provenance/guarded    .true
  +  resolution_delta_guard_policy
    \  delta=projection_resolution_delta
    ^  maybe[foundry_digest]
    ?  delta.guard
     > projection_guard_provenance/unguarded  .none
     > x=projection_guard_provenance/guarded  (./some x.policy)
  +  resolution_delta_guard_witness
    \  delta=projection_resolution_delta
    ^  maybe[foundry_digest]
    ?  delta.guard
     > projection_guard_provenance/unguarded  .none
     > x=projection_guard_provenance/guarded  (./some x.witness)
  +  resolution_demand_context
    \  demand=projection_resolution_demand
    ^  foundry_digest
    demand.context
  +  resolution_demand_fidelity
    \  demand=projection_resolution_demand
    ^  projection_fidelity
    demand.fidelity
  +  bridge_accepted
    \  result=projection_bridge_result
    ^  bool
    ?  result
     > x=projection_bridge_result/admitted  .true
     > x=projection_bridge_result/refused   .false
  +  bridge_dag
    \  result=projection_bridge_result
    ^  maybe[projection_dag]
    ?  result
     > x=projection_bridge_result/admitted  (./some x.dag)
     > x=projection_bridge_result/refused   .none
  +  bridge_code
    \  result=projection_bridge_result
    ^  maybe[iota]
    ?  result
     > x=projection_bridge_result/admitted  .none
     > x=projection_bridge_result/refused   (./some x.code)
  +  template_accepted
    \  result=surface_template_result
    ^  bool
    ?  result
     > surface_template_result/admitted  .true
     > surface_template_result/refused   .false
  +  template_surface
    \  result=surface_template_result
    ^  maybe[foundry_doc/surface]
    ?  result
     > x=surface_template_result/admitted  (./some x.surface)
     > surface_template_result/refused     .none
  +  template_bindings
    \  result=surface_template_result
    ^  row[surface_slot_binding]
    ?  result
     > x=surface_template_result/admitted  x.bindings
     > surface_template_result/refused     []
  +  template_fallbacks
    \  result=surface_template_result
    ^  row[path]
    ?  result
     > x=surface_template_result/admitted  x.fallbacks
     > surface_template_result/refused     []
  +  template_code
    \  result=surface_template_result
    ^  maybe[iota]
    ?  result
     > surface_template_result/admitted    .none
     > x=surface_template_result/refused   (./some x.code)
  +  binding_parent
    \  binding=surface_slot_binding
    ^  path
    binding.parent
  +  binding_placement
    \  binding=surface_slot_binding
    ^  path
    binding.placement
  +  binding_participation
    \  binding=surface_slot_binding
    ^  path
    binding.participation
  +  binding_fallback
    \  binding=surface_slot_binding
    ^  maybe[path]
    binding.fallback
  +  binding_fallback_class
    \  binding=surface_slot_binding
    ^  maybe[iota]
    binding.fallback_class
  +  entry_placement_role
    \  entry=projection_entry
    ^  maybe[path]
    ?  entry
     > x=projection_entry/placement  (./some x.placement.role)
     > projection_entry/node        .none
     > projection_entry/interaction .none
     > projection_entry/tombstone   .none
  +  entry_placement_resolution_context
    '  Resolution identity belongs to the occurrence edge, never the shared
    '  definition.  Nodes, tombstones, and legacy placements return none.
    \  entry=projection_entry
    ^  maybe[foundry_digest]
    ?  entry
     > x=projection_entry/placement  x.placement.resolution_context
     > projection_entry/node        .none
     > projection_entry/interaction .none
     > projection_entry/tombstone   .none
  +  entry_child
    '  The child target of a resolved placement; nodes and tombstones have no
    '  placement child.
    \  entry=projection_entry
    ^  maybe[projection_address]
    ?  entry
     > x=projection_entry/node       .none
     > x=projection_entry/interaction  .none
     > x=projection_entry/tombstone  .none
     > x=projection_entry/placement
       ?  x.placement.target
        > y=projection_placement_target/child  (./some y.address)
        > y=projection_placement_target/hole   .none
  +  entry_hole_parameters
    '  Inspection gate for authored hole metadata retained by the bridge.
    \  entry=projection_entry
    ^  maybe[row[projection_parameter]]
    ?  entry
     > x=projection_entry/node
       ?  x.node.body
        > y=projection_node_body/hole  (./some y.hole.parameters)
        > projection_node_body/semantic  .none
     > projection_entry/placement  .none
     > projection_entry/interaction  .none
     > projection_entry/tombstone  .none
  +  entry_parameters
    '  Semantic parameters on either a node definition or contextual
    '  placement.  Tombstones carry none.
    \  entry=projection_entry
    ^  maybe[row[projection_parameter]]
    ?  entry
     > x=projection_entry/node
       ?  x.node.body
        > y=projection_node_body/hole      (./some y.hole.parameters)
        > y=projection_node_body/semantic  (./some y.syntax.parameters)
     > x=projection_entry/placement
       (./some x.placement.parameters)
     > projection_entry/interaction  .none
     > projection_entry/tombstone  .none

  +  entry_interaction
    \  entry=projection_entry
    ^  maybe[projection_interaction]
    ?  entry
     > x=projection_entry/interaction  (./some x.interaction)
     > projection_entry/node         .none
     > projection_entry/placement    .none
     > projection_entry/tombstone    .none
  +  interaction_address
    \  interaction=projection_interaction
    ^  projection_address
    interaction.address
  +  interaction_owner
    \  interaction=projection_interaction
    ^  projection_address
    interaction.owner
  +  interaction_actions
    \  interaction=projection_interaction
    ^  row[projection_action_mount]
    interaction.actions
  +  interaction_destination
    \  interaction=projection_interaction
    ^  maybe[projection_destination_mount]
    interaction.destination
  +  action_mount_action
    \  mount=projection_action_mount
    ^  path
    mount.action
  +  action_mount_pin
    \  mount=projection_action_mount
    ^  foundry_digest
    mount.pin
  +  action_mount_input
    \  mount=projection_action_mount
    ^  path
    mount.input
  +  action_mount_admission
    \  mount=projection_action_mount
    ^  foundry_digest
    mount.admission
  +  destination_mount_declaration
    \  mount=projection_destination_mount
    ^  path
    mount.declaration
  +  destination_mount_target
    \  mount=projection_destination_mount
    ^  projection_address
    mount.target
  +  parameter_value
    \  key=path parameters=row[projection_parameter]
    ^  maybe[projection_value]
    |  > i=nat 0
    ^  maybe[projection_value]
    ?  (ge i parameters.len)
       .none
    ?  (eq_pith key parameters.at(i).key)
       (./some parameters.at(i).value)
    (_ i.inc)
  +  value_semantic_ref
    \  value=projection_value
    ^  maybe[path]
    ?  value
     > x=projection_value/semantic_ref  (./some x.value)
     > projection_value/flag   .none
     > projection_value/count  .none
     > projection_value/text   .none
     > projection_value/name   .none
     > projection_value/ref    .none
  +  value_text
    \  value=projection_value
    ^  maybe[nat]
    ?  value
     > x=projection_value/text  (./some x.value)
     > projection_value/flag          .none
     > projection_value/count         .none
     > projection_value/name          .none
     > projection_value/semantic_ref  .none
     > projection_value/ref           .none
  +  value_flag
    \  value=projection_value
    ^  maybe[bool]
    ?  value
     > x=projection_value/flag  (./some x.value)
     > projection_value/count         .none
     > projection_value/text          .none
     > projection_value/name          .none
     > projection_value/semantic_ref  .none
     > projection_value/ref           .none
  +  value_name
    \  value=projection_value
    ^  maybe[iota]
    ?  value
     > x=projection_value/name  (./some x.value)
     > projection_value/flag          .none
     > projection_value/count         .none
     > projection_value/text          .none
     > projection_value/semantic_ref  .none
     > projection_value/ref           .none
  +  visible
    '  Pending is the complete progressive view while it exists; retained
    '  objects were copied at Begin.  A tombstone is returned as an entry and
    '  therefore masks the formerly committed object at the same address.
    \  address=projection_address state=projection_delivery
    ^  maybe[projection_entry]
    ?  state.pending
     > (./some dag=projection_dag)
       (foundry_delivery/find address dag.entries)
     > .none
       ?  state.committed
        > (./some dag=projection_dag)
          (foundry_delivery/find address dag.entries)
        > .none  .none
  +  visible_kind
    \  address=projection_address state=projection_delivery
    ^  maybe[iota]
    ?  (foundry_delivery/visible address state)
     > .none  .none
     > (./some entry=projection_entry)
       ?  entry
        > x=projection_entry/tombstone  (./some 'tombstone)
        > x=projection_entry/node       (./some 'node)
        > x=projection_entry/placement  (./some 'placement)
        > x=projection_entry/interaction  (./some 'interaction)
