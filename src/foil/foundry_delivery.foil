    (projection_address source axis)
  +  axis_kid
    \  index=nat
    ^  projection_axis
    (projection_axis/kid index)
  +  axis_slot
    \  name=iota
    ^  projection_axis
    (projection_axis/slot name)
  +  axis_arg
    \  index=nat
    ^  projection_axis
    (projection_axis/arg index)
  +  axis_leg
    \  index=nat
    ^  projection_axis
    (projection_axis/leg index)
  +  axis_branch
    \  name=iota
    ^  projection_axis
    (projection_axis/branch name)
  +  make_parameter
    \  key=path value=projection_value
    ^  projection_parameter
    (projection_parameter key value)
  +  make_flag_value
    \  value=bool
    ^  projection_value
    (projection_value/flag value)
  +  make_count_value
    \  value=nat
    ^  projection_value
    (projection_value/count value)
  +  make_text_value
    \  value=nat
    ^  projection_value
    (projection_value/text value)
  +  make_name_value
    \  value=iota
    ^  projection_value
    (projection_value/name value)
  +  make_semantic_ref_value
    \  value=path
    ^  projection_value
    (projection_value/semantic_ref value)

  +  address_valid
    \  address=projection_address
    ^  bool
    (foundry_digest/valid address.source)
  +  addresses_valid
    \  addresses=row[projection_address]
    ^  bool
