    ?  !(foundry_delivery/addresses_valid manifest.roots)
       .false
    ?  !(foundry_delivery/addresses_valid manifest.retain)
       .false
    (foundry_delivery/addresses_valid manifest.frontier)
  +  make_hole
    \  role=path kind=iota fallback=maybe[projection_address]
    ^  projection_hole
    (projection_hole role kind fallback .none [])
  +  make_syntax
    \  kind=iota role=path recipe=foundry_digest
       placements=row[projection_address]
       dependencies=row[projection_address]
       fallback=maybe[projection_address]
    ^  projection_syntax
    (projection_syntax kind role recipe [] placements dependencies fallback)
  +  make_semantic_node
    \  address=projection_address syntax=projection_syntax
    ^  projection_object
    (projection_object/node
      (projection_node address (projection_node_body/semantic syntax)))
  +  make_hole_node
    \  address=projection_address hole=projection_hole
    ^  projection_object
    (projection_object/node
      (projection_node address (projection_node_body/hole hole)))
  +  make_placement
    \  address=projection_address parent=projection_address role=path
       child=projection_address
    ^  projection_object
    (projection_object/placement
