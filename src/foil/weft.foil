'  weft: an HTML templating library — node trees rendered to cords.
'  .
'  Cords are LE byte-packed nats.  The small cord utilities (cat2,
'  join, show_nat) are arithmetic: welding shifts by 256^len.  But
'  rendering never welds as it goes — that pays bignum work per
'  append, quadratic in the page.  Instead render assembles a
'  CordTree (str_text / str_slice / str_cat nodes, O(1) each) and
'  str_run flattens it in one native pass; esc slices whole runs of
'  safe bytes found by scan8 rather than dividing per byte.  Text
'  nodes escape at render time; raw nodes (style bodies) do not.
+  weft
  +  blen
    '  Byte length of a cord (the native width).
    '  ?=  ((weft/blen 0) 0)
    '  ?=  ((weft/blen "abc") 3)
    \  s=nat
    ^  nat
    (wid s)
  +  bex8
    '  256^n — the shift for welding above an n-byte cord.  A native
    '  shift: rebuilding it by repeated multiplication made every
    '  append quadratic in the accumulated length.
    \  n=nat
    ^  nat
    (lsh 1 (mul 8 n))
  +  cat2
    '  Weld two cords: b lands above a's bytes.
    '  ?=  ((weft/cat2 "ab" "cd") "abcd")
    '  ?=  ((weft/cat2 0 "x") "x")
    \  a=nat b=nat
    ^  nat
    (add a (lsh b (mul 8 (wid a))))
  +  cat
    '  Weld a row of cords in order.
    '  ?=  ((weft/cat ["a" "b" "c"]) "abc")
    \  xs=row[nat]
    ^  nat
    |  > i=nat 0  > acc=nat 0
    ?  (eq i xs.len)
       acc
    (_ i.inc (weft/cat2 acc xs.at(i)))
  +  join
    '  Weld with a separator between elements.
    '  ?=  ((weft/join "/" ["a" "b"]) "a/b")
    '  ?=  ((weft/join "/" []) 0)
    \  sep=nat xs=row[nat]
    ^  nat
    |  > i=nat 0  > acc=nat 0
    ?  (eq i xs.len)
       acc
    ?  (eq i 0)
       (_ 1 xs.at(0))
    (_ i.inc (weft/cat2 acc (weft/cat2 sep xs.at(i))))
  +  esc_class
    '  The scan8 byte-set of the four dangerous bytes (& < > quote).
    \  _z=nat
    ^  nat
    (add (bex 34) (add (bex 38) (add (bex 60) (bex 62))))
  +  ent
    '  The entity for a dangerous byte.
    '  ?=  ((weft/ent 38) "&amp;")
    '  ?=  ((weft/ent 60) "&lt;")
    \  b=nat
    ^  nat
    ?  (eq b 38)
       "&amp;"
    ?  (eq b 60)
       "&lt;"
    ?  (eq b 62)
       "&gt;"
    "&quot;"
  +  tcat
    '  Weld a row of CordTrees.
    \  xs=row[any]
    ^  any
    |  > i=nat 0  > acc=any (str_text 0)
    ^  any
    ?  (eq i xs.len)
       acc
    (_ i.inc (str_cat acc xs.at(i)))
  +  esc_tree
    '  HTML-escape s as a CordTree: each run of safe bytes rides as
    '  one slice of s (scan8 finds the run natively), so cost scales
    '  with the escape count, not the byte count.
    \  s=nat
    ^  any
    =  > n (wid s)
    =  > cls (weft/esc_class 0)
    |  > i=nat 0  > acc=any (str_text 0)
    ^  any
    ?  (ge i n)
       acc
    =  > e (scan8_end s i cls 0)
    =  > acc2 (str_cat acc (str_slice s i (sub e i)))
    ?  (ge e n)
       acc2
    (_ e.inc (str_cat acc2 (str_text (weft/ent (load8 e s)))))
  +  esc
    '  HTML-escape: the four dangerous bytes become entities.
    '  ?=  ((weft/esc "a<b") "a&lt;b")
    '  ?=  ((weft/esc "x&y") "x&amp;y")
    \  s=nat
    ^  nat
    (str_run (weft/esc_tree s))
  +  show_nat
    '  Decimal rendering of a nat.
    '  ?=  ((weft/show_nat 0) "0")
    '  ?=  ((weft/show_nat 407) "407")
    \  n=nat
    ^  nat
    ?  (eq 0 n)
       "0"
    |  > x=nat n  > acc=nat 0
    ?  (eq 0 x)
       acc
    (_ (div x 10) (weft/cat2 (add 48 (mod x 10)) acc))
  +  att
    '  One attribute.
    :  k=nat v=nat
  +  node
    '  An HTML node: text (escaped at render), raw text (style
    '  bodies), or an element.
    &  weft/node/tx
       weft/node/raw
       weft/node/el

    +  tx
      :  s=nat

    +  raw
      :  s=nat

    +  el
      :  tag=nat as=row[weft/att] kids=row[weft/node]
  +  cls
    \  v=nat
    ^  weft/att
    (weft/att "class" v)
  +  href
    \  v=nat
    ^  weft/att
    (weft/att "href" v)
  +  tx
    \  s=nat
    ^  weft/node
    (weft/node/tx s)
  +  raw
    \  s=nat
    ^  weft/node
    (weft/node/raw s)
  +  el
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  weft/node
    (weft/node/el tag as kids)
  +  leaf
    '  An element with one text kid.
    \  tag=nat as=row[weft/att] s=nat
    ^  weft/node
    (weft/node/el tag as [(weft/node/tx s)])
  +  packet_terminal
    '  One explicit terminal-pronunciation target inside a progressive
    '  packet mount.  target is a local pronunciation handle chosen by
    '  the server; it is not a source pin, occurrence axis, or route.
    '  The kids are the server-rendered fallback until a matching
    '  pronunciation arrives.
    \  target=nat kids=row[weft/node]
    ^  weft/node
    (weft/node/el "div" [(weft/att "w-terminal" target)] kids)
  +  packet_mount
    '  Mount one progressive addressed packet.  packet is an opaque
    '  transport/cache correlation key.  frame_get and observe are
    '  mechanical delivery locations, watch is the cared case axis,
    '  and terminals must be explicit packet_terminal nodes.
    '  .
    '  No semantic occurrence address is accepted or emitted here:
    '  source pin plus occurrence axis remain inside admitted frame
    '  entries, separate from packet/cache identity and terminal targets.
    \  packet=nat frame_get=nat observe=nat watch=nat terminals=row[weft/node]
    ^  weft/node
    (weft/node/el "div"
      [(weft/att "w-packet" packet)
       (weft/att "w-frame-get" frame_get)
       (weft/att "w-observe" observe)
       (weft/att "w-watch" watch)]
      terminals)
  +  render_tree
    '  A node tree as a CordTree: O(1) per piece, welded exactly once
    '  by the str_run in render.  Attribute values are quoted with
    '  byte 34 (cord literals cannot hold a double quote).
    \  nd0=weft/node
    ^  any
    |  > nd=weft/node nd0
    ^  any
    =  > me (_)
    ?  nd
     > (./tx s=nat)  (weft/esc_tree s)
     > (./raw s=nat)  (str_text s)
     > (./el tag=nat as=row[weft/att] kids=row[weft/node])
       =  > astr
            |  > i=nat 0  > acc=any (str_text 0)
            ^  any
            ?  (eq i as.len)
               acc
            =  > a as.at(i)
            (_ i.inc (weft/tcat [acc (str_text " ") (str_text a.k) (str_text "=") (str_text 34) (weft/esc_tree a.v) (str_text 34)]))
       =  > kstr
            |  > j=nat 0  > acc2=any (str_text 0)
            ^  any
            ?  (eq j kids.len)
               acc2
            (_ j.inc (str_cat acc2 (me kids.at(j))))
       (weft/tcat [(str_text "<") (str_text tag) astr (str_text ">") kstr (str_text "</") (str_text tag) (str_text ">")])
  +  render
    '  A node tree as an HTML cord — one native flatten of the
    '  CordTree built by render_tree.
    '  ?=  ((weft/render (weft/leaf "b" [] "hi")) "<b>hi</b>")
    '  ?=  ((weft/render (weft/tx "a<b")) "a&lt;b")
    \  nd0=weft/node
    ^  nat
    (str_run (weft/render_tree nd0))
  +  runtime
    '  The shared client runtime served at /w.js — the whole
    '  interactivity story for faces, as attributes:
    '  .
    '  w-get="/frag/..."      the element is a fragment mount; fetch
    '                         the URL and swap the markup in
    '  w-watch="x|y|z"       hold one cared observation after each
    '                         successful fragment fetch
    '  w-observe="...$case"  exact observe URL template; $case is
    '                         replaced by the last received case
    '  w-swap="inner|outer"   how the swap lands (default inner)
    '  w-post (on a form)     intercept submit, POST the fields,
    '                         then refresh the fragments named in
    '                         w-refresh and clear the text inputs
    '  w-refresh="id id.."    fragment element ids a w-post refreshes
    '  w-scroll="end"         after this form successfully refreshes,
    '                         scroll each refreshed w-scroll-target to its end
    '  w-packet="..."        an opaque transport/cache namespace
    '  w-frame-get="..."     load JSON revision frames for that packet
    '  w-terminal="..."      a server-supplied terminal-pronunciation target
    '  .
    '  Each fragment mount loads its current projection before arming
    '  observation.  The initial case token is not embedded in the shell,
    '  so observe-first would leave a case-0 mount blank until its first
    '  mutation.  Each mount owns a monotonically increasing load
    '  generation, so a late response cannot overwrite a newer one.
    '  Swaps are skipped when the fetched text is byte-identical to
    '  that mount's last applied text.  A successful observation is
    '  one-shot: fetch once, apply, then re-arm at the returned case.
    '  Network failures retry, but unchanged state emits no traffic.
    '  Each form also serializes its POSTs in submit order before
    '  refreshing named fragments.
    '  .
    '  Revision frames are a mechanical progressive-delivery protocol.
    '  Begin, Upsert, Resolve, Withdraw, Complete, and Refuse maintain
    '  separate pending and committed DAG snapshots.  Manifests, entries,
    '  roots, retained addresses, frontier entries, canonical addresses,
    '  pin digests, and occurrence axes are supplied by the server: this
    '  runtime never derives semantic identity or performs Foundry negotiation.
    '  Begin starts empty and may reuse only the committed semantic entries
    '  named by manifest.retain, matching foundry_delivery exactly.
    '  Optional terminal HTML pronunciations progressively paint only
    '  matching w-terminal targets.  Terminal targets and semantic occurrence
    '  addresses are separate wire fields and separate stores.  Only completed,
    '  scrubbed snapshots whose transport envelope explicitly says
    '  cachePolicy="non-authoritative" are persisted in IndexedDB; opaque HTML
    '  is never guessed safe.  Failure or absence of IndexedDB leaves the exact
    '  same protocol working in memory.
    '  Frame HTTP failures are classified before retry: transport failures and
    '  explicitly retryable problem responses may retry, while authoritative
    '  4xx/501 responses and malformed successful payloads stop.  Typed
    '  diagnostics remain inspectable through WeftProjection.read, packet-mount
    '  attributes, and a weft:projection-refusal DOM event.  A complete batch
    '  for the already committed manifest is a benign stale read, not an error.
    '  Cord literals cannot hold a double-quote byte, so the script
    '  is single-quote-only.
    ^  nat
    =  jopen  "(function(){var packets=Object.create(null),dbp=null;"
       jswap  "function swap(el,t){if(el._wLast===t){return}el._wLast=t;var root;if(el.getAttribute('w-swap')==='outer'){root=el.parentNode;el.outerHTML=t}else{el.innerHTML=t;root=el}if(root){armWithin(root)}}"
       jload  "function load(el){var n=(el._wLoad||0)+1;el._wLoad=n;return fetch(el.getAttribute('w-get')).then(function(r){return r.ok?r.text():null}).then(function(t){if(el._wLoad===n&&t!==null&&t!==undefined){swap(el,t);return 1}return 0})}"
       jscroll "function scrollAfter(f,els,ok){if(f.getAttribute('w-scroll')!=='end'){return}var i,t;for(i=0;i<els.length;i++){if(!ok[i]){continue}t=els[i].querySelector('[w-scroll-target]');if(t){t.scrollTop=t.scrollHeight}}}"
       jclean "function clean(v){if(v===null||typeof v!=='object'){return v}if(Array.isArray(v)){var a=[],i;for(i=0;i<v.length;i++){a.push(clean(v[i]))}return a}var o=Object.create(null),ks=Object.keys(v),j,k,n;for(j=0;j<ks.length;j++){k=ks[j];n=k.replace(/[-_]/g,'').toLowerCase();if(/^(authority|authorization|capability|capabilities|credential|credentials|actiontoken|authoritytoken|capabilitytoken|sendcaps)$/.test(n)){continue}o[k]=clean(v[k])}return o}"
       jcopy  "function copy(v){return v===undefined?undefined:JSON.parse(JSON.stringify(v))}"
       jmanifest "function manifestOf(f){var m=f&&f.manifest;if(!m||typeof m!=='object'){return null}if((typeof m.revision!=='string'&&typeof m.revision!=='number')||!Array.isArray(m.roots)||!Array.isArray(m.retain)||!Array.isArray(m.frontier)){return null}return{revision:String(m.revision),roots:clean(m.roots),retain:clean(m.retain),frontier:clean(m.frontier)}}"
       jmeq   "function sameManifest(a,b){return!!a&&!!b&&a.revision===b.revision&&JSON.stringify(a.roots)===JSON.stringify(b.roots)&&JSON.stringify(a.retain)===JSON.stringify(b.retain)&&JSON.stringify(a.frontier)===JSON.stringify(b.frontier)}"
       jempty "function empty(id,m){return{packet:id,manifest:m,entries:Object.create(null),withdrawn:Object.create(null)}}"
       jstate "function state(id){if(!packets[id]){packets[id]={id:id,committed:null,pending:null,committedTerminal:Object.create(null),pendingTerminal:null,pendingCache:0,refusal:null,problem:null,closed:Object.create(null),closedOrder:[],restored:0}}return packets[id]}"
       jmountstate "function mountState(el){var id=el&&el.getAttribute('w-packet');return id?state(id):null}"
       jproblem "function announceProblem(s,p){if(!s){return}var q=clean(p);s.problem=q;if(!q.retryable){s.refusal=q}eachMount(s.id,function(m){m.setAttribute('w-frame-status',String(q.status||0));m.setAttribute('w-frame-error',String(q.code||'projection_refused'));m.setAttribute('w-frame-retryable',q.retryable?'true':'false');if(typeof window.CustomEvent==='function'){m.dispatchEvent(new window.CustomEvent('weft:projection-refusal',{detail:copy(q)}))}})}function clearProblem(s){if(!s){return}if(s.refusal&&s.refusal.kind==='projection'){s.problem=s.refusal;return}s.problem=null;s.refusal=null;eachMount(s.id,function(m){m.removeAttribute('w-frame-status');m.removeAttribute('w-frame-error');m.removeAttribute('w-frame-retryable')})}"
       jhttpp "function httpProblem(r,x){var p=x&&typeof x==='object'?clean(x):Object.create(null),detail=typeof x==='string'?x:(typeof p.detail==='string'?p.detail:''),terminal=r.status===501||(r.status>=400&&r.status<500),retry=terminal?false:(typeof p.retryable==='boolean'?p.retryable:r.status>=500),code=typeof p.error==='string'?p.error:(typeof p.code==='string'?p.code:'http_'+String(r.status));if(detail.length>512){detail=detail.slice(0,512)}return{kind:'http',status:r.status,code:code,operation:typeof p.operation==='string'?p.operation:'frame',detail:detail,retryable:retry}}function transportProblem(e){return{kind:'transport',status:0,code:'transport_failure',operation:'frame',detail:e&&e.message?String(e.message):'network request failed',retryable:true}}function protocolProblem(code,detail){return{kind:'protocol',status:200,code:code,operation:'frame',detail:detail||'',retryable:false}}"
       jclose "function closeRevision(s,r){r=String(r);if(s.closed[r]){return}s.closed[r]=1;s.closedOrder.push(r);if(s.closedOrder.length>32){delete s.closed[s.closedOrder.shift()]}}"
       jown   "function own(o,k){return Object.prototype.hasOwnProperty.call(o,k)}"
       jwithdrawn "function rebuildWithdrawn(p){p.withdrawn=Object.create(null);var ks=Object.keys(p.entries||{}),i,e;for(i=0;i<ks.length;i++){e=p.entries[ks[i]];if(e&&e.kind==='tombstone'){p.withdrawn[ks[i]]=1}}return p}"
       jlive  "function live(p,a,k){var e=p&&p.entries&&p.entries[a];return!!e&&e.kind===k&&e.kind!=='tombstone'}"
       jknown "function known(p,a){return typeof a==='string'&&a.length&&(own(p.entries,a)||p.manifest.frontier.indexOf(a)>=0)}"
       jmaybe "function optionalKnown(p,a){return a===null||a===undefined||known(p,a)}"
       jcomplete "function completeDag(p){if(!p||!p.manifest||!p.entries){return false}var roots=p.manifest.roots,i,ks=Object.keys(p.entries),e,o,b,s,ps,j,t;if(!Array.isArray(roots)||!Array.isArray(p.manifest.frontier)){return false}for(i=0;i<roots.length;i++){if(!live(p,roots[i],'node')){return false}}for(i=0;i<ks.length;i++){e=p.entries[ks[i]];if(!e||e.address!==ks[i]){return false}if(e.kind==='tombstone'){if(e.target!=='node'&&e.target!=='placement'){return false}continue}o=e.object;if(!o||o.kind!==e.kind){return false}if(e.kind==='node'){if(!o.node||o.node.address!==e.address||!o.node.body){return false}b=o.node.body;if(b.kind==='hole'){if(!b.hole||!optionalKnown(p,b.hole.fallback)){return false}}else if(b.kind==='semantic'){s=b.syntax;if(!s||!Array.isArray(s.placements)||!Array.isArray(s.dependencies)||!optionalKnown(p,s.fallback)){return false}for(j=0;j<s.placements.length;j++){if(!live(p,s.placements[j],'placement')||p.entries[s.placements[j]].object.placement.parent!==e.address){return false}}for(j=0;j<s.dependencies.length;j++){if(!known(p,s.dependencies[j])){return false}}}else{return false}}else if(e.kind==='placement'){if(!o.placement||o.placement.address!==e.address||!live(p,o.placement.parent,'node')){return false}t=o.placement.target;if(!t){return false}if(t.kind==='child'){if(!known(p,t.address)){return false}}else if(t.kind==='hole'){if(!t.hole||!optionalKnown(p,t.hole.fallback)){return false}}else{return false}}else{return false}}return true}"
       jaddr  "function addr(f){var a=f&&f.address;return typeof a==='string'&&a.length?a:null}"
       jpron  "function pronunciation(f,a){var p=f&&f.pronunciation;if(!p||typeof p!=='object'||typeof p.target!=='string'||!p.target.length||typeof p.html!=='string'){return null}return{semanticAddress:a,target:p.target,media:typeof p.media==='string'?p.media:'text/html',html:p.html,cachePolicy:p.cachePolicy==='non-authoritative'?'non-authoritative':'none'}}"
       jentry "function entryOf(f){var a=addr(f),k=f&&f.entryKind;if(!a||typeof k!=='string'||!k.length||f.object===undefined||typeof f.hole!=='boolean'){return null}return{address:a,kind:k,hole:f.hole,object:clean(f.object)}}"
       jretain "function retained(s,m){var p=empty(s.id,m),t=Object.create(null),rs=m.retain,c=s.committed,ct=s.committedTerminal,i,j,a,e,ks,q;if(!rs.length){return{dag:p,terminal:t}}if(!c){return null}for(i=0;i<rs.length;i++){a=rs[i];if(typeof a!=='string'||!a.length){return null}if(own(c.entries,a)){e=clean(c.entries[a]);p.entries[a]=e;if(e.kind==='tombstone'){p.withdrawn[a]=1}}ks=Object.keys(ct);for(j=0;j<ks.length;j++){q=ct[ks[j]];if(q.semanticAddress===a){t[ks[j]]=clean(q)}}}return{dag:p,terminal:t}}"
       jputp  "function putPron(t,f,a){var q=pronunciation(f,a);if(!q){return null}t[q.target]=q;return q.target}"
       jdrop  "function dropSemantic(t,a){var ks=Object.keys(t||{}),i;for(i=0;i<ks.length;i++){if(t[ks[i]].semanticAddress===a){delete t[ks[i]]}}}"
       jmount "function eachMount(id,fn){var es=document.querySelectorAll('[w-packet]'),i;for(i=0;i<es.length;i++){if(es[i].getAttribute('w-packet')===id){fn(es[i])}}}"
       jeach  "function eachTerminal(root,a,fn){if(root.nodeType===1&&root.getAttribute('w-terminal')===a){fn(root)}var es=root.querySelectorAll('[w-terminal]'),i;for(i=0;i<es.length;i++){if(es[i].getAttribute('w-terminal')===a){fn(es[i])}}}"
       jpaint "function paintOne(s,target,clear){var p=s.pending,pt=s.pendingTerminal,c=s.committedTerminal,q=pt&&pt[target]?pt[target]:c&&c[target],gone=p&&q&&p.withdrawn[q.semanticAddress];eachMount(s.id,function(m){eachTerminal(m,target,function(el){if(gone||(clear&&!q)){swap(el,'')}else if(q&&q.media==='text/html'&&typeof q.html==='string'){swap(el,q.html)}})})}"
       jkeys  "function addKeys(x,seen){if(!x){return}var ks=Object.keys(x),i;for(i=0;i<ks.length;i++){seen[ks[i]]=1}}"
       jpall  "function paintAll(s,prior,clear){var seen=Object.create(null),ks,i;addKeys(s.committedTerminal,seen);addKeys(s.pendingTerminal,seen);addKeys(prior,seen);ks=Object.keys(seen);for(i=0;i<ks.length;i++){paintOne(s,ks[i],clear)}}"
       jpsem  "function paintSemantic(s,a){var seen=Object.create(null),sets=[s.committedTerminal,s.pendingTerminal],i,j,ks,q;for(i=0;i<sets.length;i++){if(!sets[i]){continue}ks=Object.keys(sets[i]);for(j=0;j<ks.length;j++){q=sets[i][ks[j]];if(q.semanticAddress===a){seen[ks[j]]=1}}}ks=Object.keys(seen);for(i=0;i<ks.length;i++){paintOne(s,ks[i],false)}}"
       jstamp "function stamp(s,name,r){eachMount(s.id,function(m){if(r===null){m.removeAttribute(name)}else{m.setAttribute(name,String(r))}})}"
       jdb    "function database(){if(dbp){return dbp}dbp=new Promise(function(done){if(!window.indexedDB){done(null);return}var q=window.indexedDB.open('weft-projection-cache',1);q.onupgradeneeded=function(){var d=q.result;if(!d.objectStoreNames.contains('packets')){d.createObjectStore('packets',{keyPath:'packet'})}};q.onsuccess=function(){done(q.result)};q.onerror=function(){done(null)};q.onblocked=function(){done(null)}});return dbp}"
       jsave  "function save(s,allowed){var c=clean(s.committed),t=clean(s.committedTerminal);if(!c||!allowed){return}delete c.withdrawn;var ks=Object.keys(t),i;for(i=0;i<ks.length;i++){if(t[ks[i]].cachePolicy!=='non-authoritative'){delete t[ks[i]]}}database().then(function(d){if(!d){return}try{d.transaction('packets','readwrite').objectStore('packets').put({packet:s.id,dag:c,terminal:t,cachePolicy:'non-authoritative'})}catch(e){}})}"
       jcache "function cachedDag(id,x){var m=x&&x.dag;if(!x||x.cachePolicy!=='non-authoritative'||!m||m.packet!==id||!m.manifest||typeof m.manifest.revision!=='string'){return null}m=rebuildWithdrawn(clean(m));return completeDag(m)?m:null}"
       jrest  "function restore(id){var s=state(id);if(s.restored){return}s.restored=1;database().then(function(d){if(!d){return}try{var q=d.transaction('packets','readonly').objectStore('packets').get(id);q.onsuccess=function(){var x=q.result,m=cachedDag(id,x);if(m&&!s.committed&&!s.pending){s.committed=m;s.committedTerminal=clean(x.terminal||{});stamp(s,'w-revision',m.manifest.revision);paintAll(s,null,false)}}}catch(e){}})}"
       jkind  "function frameKind(f){var k=String(f.type||f.op||f.kind||'').toLowerCase();if(k.indexOf('begin')===0){return'begin'}if(k.indexOf('upsert')===0){return'upsert'}if(k.indexOf('resolve')===0){return'resolve'}if(k.indexOf('withdraw')===0){return'withdraw'}if(k.indexOf('complete')===0){return'complete'}if(k.indexOf('refuse')===0){return'refuse'}return''}"
       japply "function applyFrame(f){if(!f||typeof f!=='object'){return false}var id=f.packet,m=manifestOf(f),k=frameKind(f);if(typeof id!=='string'||!id.length||!m||!k){return false}var r=m.revision,s=state(id),p=s.pending,a,e,old,kind,next,target,allowed;if(k==='begin'){if(s.closed[r]||(s.committed&&s.committed.manifest.revision===r)){return false}if(p&&sameManifest(p.manifest,m)){return true}next=retained(s,m);if(!next){return false}old=s.pendingTerminal;if(p){closeRevision(s,p.manifest.revision)}s.pending=next.dag;s.pendingTerminal=next.terminal;s.pendingCache=f.cachePolicy==='non-authoritative';s.refusal=null;clearProblem(s);stamp(s,'w-pending-revision',r);paintAll(s,old,true);return true}if(!p||!sameManifest(p.manifest,m)||s.closed[r]){return false}if(k==='upsert'){e=entryOf(f);if(!e){return false}a=e.address;if(own(p.entries,a)){if(JSON.stringify(p.entries[a])!==JSON.stringify(e)){return false}}else{p.entries[a]=e}target=putPron(s.pendingTerminal,f,a);if(target){paintOne(s,target,false)}return true}if(k==='resolve'){e=entryOf(f);a=addr(f);if(!e||e.hole||e.address!==a||!own(p.entries,a)){return false}old=p.entries[a];if(!old.hole||old.kind!==e.kind){return false}p.entries[a]=e;target=putPron(s.pendingTerminal,f,a);if(target){paintOne(s,target,false)}return true}if(k==='withdraw'){a=addr(f);kind=typeof f.entryKind==='string'?f.entryKind:f.target;if(!a||typeof kind!=='string'||!kind.length){return false}if(own(p.entries,a)){e=p.entries[a];if(e.kind==='tombstone'){if(e.target!==kind){return false}}else if(e.kind!==kind){return false}}p.entries[a]={address:a,kind:'tombstone',target:kind,hole:false};dropSemantic(s.pendingTerminal,a);p.withdrawn[a]=1;paintSemantic(s,a);return true}if(k==='complete'){if(!completeDag(p)){return false}old=s.committedTerminal;allowed=s.pendingCache;s.committed=p;s.committedTerminal=s.pendingTerminal;s.pending=null;s.pendingTerminal=null;s.pendingCache=0;closeRevision(s,r);clearProblem(s);stamp(s,'w-pending-revision',null);stamp(s,'w-revision',r);paintAll(s,old,true);save(s,allowed);return true}if(k==='refuse'){old=s.pendingTerminal;closeRevision(s,r);s.pending=null;s.pendingTerminal=null;s.pendingCache=0;announceProblem(s,{kind:'projection',status:200,code:clean(f.code),operation:'frame',detail:'',retryable:false,revision:r});stamp(s,'w-pending-revision',null);paintAll(s,old,true);return true}return false}"
       jfeeds "function applyAll(x){var fs=Array.isArray(x)?x:(x&&Array.isArray(x.frames)?x.frames:[x]),id=x&&!Array.isArray(x)&&x.packet,m=x&&!Array.isArray(x)&&x.manifest,i,f,ok=true;for(i=0;i<fs.length;i++){f=fs[i];if(f&&typeof f==='object'&&((f.packet===undefined&&id!==undefined)||(f.manifest===undefined&&m!==undefined))){f=clean(f);if(f.packet===undefined){f.packet=id}if(f.manifest===undefined){f.manifest=m}}if(!applyFrame(f)){ok=false}}return ok}"
       jbatch "function batchInfo(x){var fs=Array.isArray(x)?x:(x&&Array.isArray(x.frames)?x.frames:[x]),f=fs.length?fs[0]:null,id=f&&f.packet!==undefined?f.packet:(x&&x.packet),raw=f&&f.manifest!==undefined?f.manifest:(x&&x.manifest),m=manifestOf({manifest:raw});if(typeof id!=='string'||!id.length||!m){return null}return{packet:id,manifest:m}}function sameCommittedBatch(s,x){var b=batchInfo(x);return!!s&&!!b&&b.packet===s.id&&!!s.committed&&sameManifest(s.committed.manifest,b.manifest)}"
       jfload "function frameLoad(el){var n=(el._wFrameLoad||0)+1,s=mountState(el),phase='transport';el._wFrameLoad=n;return fetch(el.getAttribute('w-frame-get')).then(function(r){phase='body';return r.text().then(function(t){phase='apply';var x=null,b;try{x=t.length?JSON.parse(t):null}catch(e){}if(el._wFrameLoad!==n){return{ok:false,retry:false,stale:true}}if(!r.ok){var p=httpProblem(r,x===null?t:x);announceProblem(s,p);return{ok:false,retry:p.retryable,terminal:!p.retryable}}if(x===null){announceProblem(s,protocolProblem('invalid_frame_json','successful frame response was not JSON'));return{ok:false,retry:false,terminal:true}}b=batchInfo(x);if(!s||!b||b.packet!==s.id){announceProblem(s,protocolProblem('invalid_frame_envelope','frame packet did not match its mount'));return{ok:false,retry:false,terminal:true}}if(sameCommittedBatch(s,x)){clearProblem(s);return{ok:true,retry:false,same:true}}if(!applyAll(x)){announceProblem(s,protocolProblem('invalid_frame_batch','frame batch violated the delivery protocol'));return{ok:false,retry:false,terminal:true}}clearProblem(s);return{ok:true,retry:false}})}).catch(function(e){if(el._wFrameLoad!==n){return{ok:false,retry:false,stale:true}}if(phase==='apply'){announceProblem(s,protocolProblem('frame_processing_failed',e&&e.message?String(e.message):'frame processing failed'));return{ok:false,retry:false,terminal:true}}var p=transportProblem(e);announceProblem(s,p);return{ok:false,retry:true}})}"
       jretry "function retry(f){setTimeout(f,1000)}"
       jwurl  "function watchUrl(el,c){var u=el.getAttribute('w-observe')||'';return u.replace('$case',String(c))}"
       jwait  "function wait(el,c){if(!el.isConnected){return}fetch(watchUrl(el,c)).then(function(r){return r.ok?r.text():null}).then(function(t){if(t===null){retry(function(){wait(el,c)});return}var n=parseInt(t,10);if(!isFinite(n)){retry(function(){wait(el,c)});return}refresh(el,n)}).catch(function(){retry(function(){wait(el,c)})})}"
       jfresh "function refresh(el,c){load(el).then(function(ok){if(ok){wait(el,c)}else{retry(function(){refresh(el,c)})}}).catch(function(){retry(function(){refresh(el,c)})})}"
       jfwait "function frameWait(el,c){if(!el.isConnected){return}var s=mountState(el),phase='transport';fetch(watchUrl(el,c)).then(function(r){phase='body';return r.text().then(function(t){phase='apply';if(!r.ok){var x=null;try{x=t.length?JSON.parse(t):null}catch(e){}var p=httpProblem(r,x===null?t:x);announceProblem(s,p);if(p.retryable){retry(function(){frameWait(el,c)})}return}var n=parseInt(t,10);if(!isFinite(n)){announceProblem(s,protocolProblem('invalid_observe_case','observe response was not a case'));return}clearProblem(s);frameRefresh(el,n)})}).catch(function(e){if(phase==='apply'){announceProblem(s,protocolProblem('observe_processing_failed',e&&e.message?String(e.message):'observe processing failed'));return}announceProblem(s,transportProblem(e));retry(function(){frameWait(el,c)})})}"
       jfrsh  "function frameRefresh(el,c){if(!el.isConnected){return}frameLoad(el).then(function(x){if(x.stale){return}if(x.ok){frameWait(el,c);return}if(x.retry){retry(function(){frameRefresh(el,c)})}})}"
       jarm   "function arm(el){if(el._wArmed){return}el._wArmed=1;var o=el.getAttribute('w-observe')||'',c=el.getAttribute('w-watch')||'',fg=el.getAttribute('w-frame-get'),g=el.getAttribute('w-get'),id,s;if(el.hasAttribute('w-packet')){id=el.getAttribute('w-packet');s=state(id);restore(id);paintAll(s,null,false)}if(fg){if(o&&(c==='x'||c==='y'||c==='z')){frameRefresh(el,0)}else{frameLoad(el)}return}if(!g){return}if(o&&(c==='x'||c==='y'||c==='z')){refresh(el,0)}else{load(el)}}"
       jwire  "function wire(f){if(f._wWired){return}f._wWired=1;var queue=Promise.resolve();f.addEventListener('submit',function(e){e.preventDefault();var body=new URLSearchParams(new FormData(f));var ins=f.querySelectorAll('input[type=text],textarea');var j;for(j=0;j<ins.length;j++){ins[j].value=''}queue=queue.catch(function(){}).then(function(){return fetch(f.getAttribute('action'),{method:'POST',body:body})}).then(function(r){if(!r.ok){return}var ids=(f.getAttribute('w-refresh')||'').split(' ');var loads=[],targets=[];var i,el;for(i=0;i<ids.length;i++){el=document.getElementById(ids[i]);if(!el){continue}if(el.getAttribute('w-get')){targets.push(el);loads.push(load(el))}else if(el.getAttribute('w-frame-get')){targets.push(el);loads.push(frameLoad(el).then(function(x){return x.ok}))}}return Promise.all(loads).then(function(ok){scrollAfter(f,targets,ok)})})})}"
       jscan  "function armWithin(root){if(root.nodeType===1&&root.matches('[w-get],[w-frame-get],[w-packet]')){arm(root)}var els=root.querySelectorAll('[w-get]'),i;for(i=0;i<els.length;i++){arm(els[i])}els=root.querySelectorAll('[w-frame-get],[w-packet]');for(i=0;i<els.length;i++){arm(els[i])}if(root.nodeType===1&&root.matches('form[w-post]')){wire(root)}var fs=root.querySelectorAll('form[w-post]'),j;for(j=0;j<fs.length;j++){wire(fs[j])}}"
       jboot  "function boot(){armWithin(document)}"
       japi   "window.WeftProjection={apply:applyFrame,applyAll:applyAll,restore:restore,read:function(id){var s=packets[id];return s?copy({committed:s.committed,pending:s.pending,committedTerminal:s.committedTerminal,pendingTerminal:s.pendingTerminal,refusal:s.refusal,problem:s.problem}):null}};"
       jgo    "if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot)}else{boot()}})();"
    (weft/cat [jopen jswap jload jscroll jclean jcopy jmanifest jmeq jempty jstate jmountstate jproblem jhttpp jclose jown jwithdrawn jlive jknown jmaybe jcomplete jaddr jpron jentry jretain jputp jdrop jmount jeach jpaint jkeys jpall jpsem jstamp jdb jsave jcache jrest jkind japply jfeeds jbatch jfload jretry jwurl jwait jfresh jfwait jfrsh jarm jwire jscan jboot japi jgo])
  +  page
    '  A full document: title, a raw css block, body nodes.
    \  title=nat css=nat body=row[weft/node]
    ^  nat
    =  > hd (weft/el "head" [] [(weft/leaf "title" [] title) (weft/el "style" [] [(weft/raw css)])])
    =  > bd (weft/el "body" [] body)
    =  > doc (weft/el "html" [] [hd bd])
    (str_run (str_cat (str_text "<!doctype html>") (weft/render_tree doc)))
