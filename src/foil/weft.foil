'  weft: an HTML templating library — node trees rendered to cords.
'  .
'  Cords are LE byte-packed nats and the compiler exposes no byte
'  primitives, so everything here is arithmetic: welding shifts by
'  256^len, escaping and decimal rendering walk bytes with mod/div
'  256 (the /lte_str scheme).  Text nodes escape at render time; raw
'  nodes (style bodies) do not.
+  weft
  +  blen
    '  Byte length of a cord (the native width).
    '  ?=  ((weft/blen 0) 0)
    '  ?=  ((weft/blen "abc") 3)
    \  s=nat
    ^  nat
    (wid s)
  +  bex8
    '  256^n — the shift for welding above an n-byte cord.  A native
    '  shift: rebuilding it by repeated multiplication made every
    '  append quadratic in the accumulated length.
    \  n=nat
    ^  nat
    (lsh 1 (mul 8 n))
  +  cat2
    '  Weld two cords: b lands above a's bytes.
    '  ?=  ((weft/cat2 "ab" "cd") "abcd")
    '  ?=  ((weft/cat2 0 "x") "x")
    \  a=nat b=nat
    ^  nat
    (add a (lsh b (mul 8 (wid a))))
  +  cat
    '  Weld a row of cords in order.
    '  ?=  ((weft/cat ["a" "b" "c"]) "abc")
    \  xs=row[nat]
    ^  nat
    |  > i=nat 0  > acc=nat 0
    ?  (eq i xs.len)
       acc
    (_ i.inc (weft/cat2 acc xs.at(i)))
  +  join
    '  Weld with a separator between elements.
    '  ?=  ((weft/join "/" ["a" "b"]) "a/b")
    '  ?=  ((weft/join "/" []) 0)
    \  sep=nat xs=row[nat]
    ^  nat
    |  > i=nat 0  > acc=nat 0
    ?  (eq i xs.len)
       acc
    ?  (eq i 0)
       (_ 1 xs.at(0))
    (_ i.inc (weft/cat2 acc (weft/cat2 sep xs.at(i))))
  +  esc
    '  HTML-escape: the four dangerous bytes become entities.
    '  ?=  ((weft/esc "a<b") "a&lt;b")
    '  ?=  ((weft/esc "x&y") "x&amp;y")
    \  s=nat
    ^  nat
    |  > x=nat s  > acc=nat 0
    ?  (eq 0 x)
       acc
    =  > b (mod x 256)
    =  > r (div x 256)
    ?  (eq b 38)
       (_ r (weft/cat2 acc "&amp;"))
    ?  (eq b 60)
       (_ r (weft/cat2 acc "&lt;"))
    ?  (eq b 62)
       (_ r (weft/cat2 acc "&gt;"))
    ?  (eq b 34)
       (_ r (weft/cat2 acc "&quot;"))
    (_ r (weft/cat2 acc b))
  +  show_nat
    '  Decimal rendering of a nat.
    '  ?=  ((weft/show_nat 0) "0")
    '  ?=  ((weft/show_nat 407) "407")
    \  n=nat
    ^  nat
    ?  (eq 0 n)
       "0"
    |  > x=nat n  > acc=nat 0
    ?  (eq 0 x)
       acc
    (_ (div x 10) (weft/cat2 (add 48 (mod x 10)) acc))
  +  att
    '  One attribute.
    :  k=nat v=nat
  +  node
    '  An HTML node: text (escaped at render), raw text (style
    '  bodies), or an element.
    &  weft/node/tx
       weft/node/raw
       weft/node/el

    +  tx
      :  s=nat

    +  raw
      :  s=nat

    +  el
      :  tag=nat as=row[weft/att] kids=row[weft/node]
  +  cls
    \  v=nat
    ^  weft/att
    (weft/att "class" v)
  +  href
    \  v=nat
    ^  weft/att
    (weft/att "href" v)
  +  tx
    \  s=nat
    ^  weft/node
    (weft/node/tx s)
  +  raw
    \  s=nat
    ^  weft/node
    (weft/node/raw s)
  +  el
    \  tag=nat as=row[weft/att] kids=row[weft/node]
    ^  weft/node
    (weft/node/el tag as kids)
  +  leaf
    '  An element with one text kid.
    \  tag=nat as=row[weft/att] s=nat
    ^  weft/node
    (weft/node/el tag as [(weft/node/tx s)])
  +  render
    '  A node tree as an HTML cord.  Attribute values are quoted with
    '  byte 34 (cord literals cannot hold a double quote).
    '  ?=  ((weft/render (weft/leaf "b" [] "hi")) "<b>hi</b>")
    '  ?=  ((weft/render (weft/tx "a<b")) "a&lt;b")
    \  nd0=weft/node
    ^  nat
    |  > nd=weft/node nd0
    ^  nat
    =  > me (_)
    ?  nd
     > (./tx s=nat)  (weft/esc s)
     > (./raw s=nat)  s
     > (./el tag=nat as=row[weft/att] kids=row[weft/node])
       =  > astr
            |  > i=nat 0  > acc=nat 0
            ?  (eq i as.len)
               acc
            =  > a as.at(i)
            (_ i.inc (weft/cat [acc " " a.k "=" 34 (weft/esc a.v) 34]))
       =  > kstr
            |  > j=nat 0  > acc2=nat 0
            ?  (eq j kids.len)
               acc2
            (_ j.inc (weft/cat2 acc2 (me kids.at(j))))
       (weft/cat ["<" tag astr ">" kstr "</" tag ">"])
  +  page
    '  A full document: title, a raw css block, body nodes.
    \  title=nat css=nat body=row[weft/node]
    ^  nat
    =  > hd (weft/el "head" [] [(weft/leaf "title" [] title) (weft/el "style" [] [(weft/raw css)])])
    =  > bd (weft/el "body" [] body)
    =  > doc (weft/el "html" [] [hd bd])
    (weft/cat2 "<!doctype html>" (weft/render doc))
