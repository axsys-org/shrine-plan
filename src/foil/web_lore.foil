- sept
- pact
- weft
- web_ui
'  Lore and doctest presentation shared by explorer and zoo.
+  web_lore
  +  lore_lines
    '  The body after the headline, shared by explorer and zoo.
    \ doc=lore
    ^ row[weft/node]
    % idx=nat 1 out=row[weft/node] []
    ? (ge idx doc.body.len) out
    = line
        ~ weft/build
        ~. 'div.lore-line doc.body.at(idx)
    | _ idx.inc out.weld(line)

  +  dt_chip
    '  One doctest's verdict chip: pass/got from the verdict's
    '  results, greyed when the verdict's case is behind the node's
    '  current x case (curx as decimal text; 0 = unknown, no
    '  staleness call).
    \  verdict=doctest/verdict curx=nat j=nat
    ^  weft/node
    =  stale
         ?  (eq 0 curx)
            0
         !(eq curx (weft/show_nat verdict.case))
    ?  (ge j verdict.results.len)
       | web_ui/badge "neutral" "no result"
    ?  stale
       | web_ui/badge "neutral" (weft/cat2 "stale v" (weft/show_nat verdict.case))
    =  [_ pass got]  verdict.results.at(j)
    ?  pass
       | web_ui/badge "positive" "pass"
    | web_ui/badge "critical" (weft/cat2 "got " got)

  +  dt_row1
    '  One rendered doctest row.
    \  src=nat want=nat chip=weft/node
    ^  weft/node
    = markup
        ~ weft/build
        ~| 'div.row
          ~. "?=  "
          ~. 'span.dtsrc src
          ~. "  ->  "
          ~. 'span.dtsrc want
          [chip]
    markup.at(0)

  +  dt_rows
    '  A lore's doctests with verdict chips.
    \  doc=lore verdict=doctest/verdict curx=nat
    ^  row[weft/node]
    %  j=nat 0  out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    | _ j.inc out.snoc((web_lore/dt_row1 src want (web_lore/dt_chip verdict curx j)))

  +  dt_rows_never
    '  A lore's doctests, never yet run.
    \  doc=lore
    ^  row[weft/node]
    %  j=nat 0  out=row[weft/node] []
    ?  (ge j doc.tests.len)
       out
    =  [src want]  doc.tests.at(j)
    | _ j.inc out.snoc((web_lore/dt_row1 src want (web_ui/badge "neutral" "never run")))
