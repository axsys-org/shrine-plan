-  sept [order=10]
-  shrine_types [order=20]
-  lain [order=30]
'  surface_tree: a renderer-neutral, tree-shaped authoring/compiler
'  intermediate.  It is deliberately ordinary namespace-shaped data: an
'  axal[myth], with structural placement in the axal path and one semantic
'  record at every admitted node.  It has no source-pin occurrence addresses,
'  revision manifest, sharing, or completion boundary, so it is never the
'  Foundry delivery product.  Delivery begins after this intermediate is
'  compiled into foundry_delivery/projection_dag.
+  surface_issue
  '  One validation diagnostic.  `at` locates the semantic node,
  '  `code` is stable machine vocabulary, and `slot` identifies an
  '  offending record slot when there is one.
  :  at=path code=iota slot=path
+  surface_tree
  '  A semantic compiler SurfaceTree.  The alias keeps all axal operations
  '  available; helpers below only add the authoring vocabulary.  Tree paths
  '  express local compiler placement, not durable occurrence identity.
  axal[myth]

  '  Canonical semantic slots.  These names describe meaning and
  '  provenance, never a rendering backend.
  +  kind_slot
    ^  path
    '/surface/kind
  +  role_slot
    ^  path
    '/surface/role
  +  name_slot
    ^  path
    '/surface/name
  +  source_slot
    ^  path
    '/surface/source
  +  action_slot
    ^  path
    '/surface/action
  +  report_slot
    ^  path
    '/surface/report
  +  state_slot
    ^  path
    '/surface/state
  +  fallback_slot
    ^  path
    '/surface/fallback
  +  text_slot
    ^  path
    '/surface/text

  +  ref_at
    '  Read a path-valued semantic slot without collapsing an absent
    '  slot into the root path.
    \  slot=path t=myth
    ^  maybe[path]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/p  (./some x.p)
       .none
  +  iota_at
    '  Read an iota-valued semantic slot.
    \  slot=path t=myth
    ^  maybe[iota]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/q  (./some x.q)
       .none
  +  text_at
    '  Read a text-valued semantic slot.  Empty text remains present.
    \  slot=path t=myth
    ^  maybe[nat]
    ?  t.get(slot)
     > .none  .none
     > (./some pl=pail)
       ?  pl
        > x=pails/t  (./some x.t)
       .none

  +  kind_of
    \  t=myth
    ^  maybe[iota]
    (surface_tree/iota_at surface_tree/kind_slot t)
  +  role_of
    \  t=myth
    ^  maybe[path]
    (surface_tree/ref_at surface_tree/role_slot t)
  +  name_of
    \  t=myth
    ^  maybe[iota]
    (surface_tree/iota_at surface_tree/name_slot t)
  +  source_of
    \  t=myth
    ^  maybe[path]
    (surface_tree/ref_at surface_tree/source_slot t)
  +  action_of
    \  t=myth
    ^  maybe[path]
    (surface_tree/ref_at surface_tree/action_slot t)
  +  report_of
    \  t=myth
    ^  maybe[path]
    (surface_tree/ref_at surface_tree/report_slot t)
  +  state_of
    \  t=myth
    ^  maybe[iota]
    (surface_tree/iota_at surface_tree/state_slot t)
  +  fallback_of
    \  t=myth
    ^  maybe[path]
    (surface_tree/ref_at surface_tree/fallback_slot t)
  +  text_of
    \  t=myth
    ^  maybe[nat]
    (surface_tree/text_at surface_tree/text_slot t)

  +  base
    '  The common record constructor.  A role is a semantic namespace
    '  path, distinct from this occurrence's structural axal path.
    \  kind=iota role=path
    ^  myth
    =  t  (myth/new).put(surface_tree/kind_slot (pails/q kind))
    t.put(surface_tree/role_slot (pails/p role))
  +  scene
    \  role=path
    ^  myth
    (surface_tree/base 'scene role)
  +  plate
    \  role=path
    ^  myth
    (surface_tree/base 'plate role)
  +  block
    \  role=path
    ^  myth
    (surface_tree/base 'block role)
  +  slot
    '  A named semantic attachment point.  Its name must equal the
    '  last segment of the axal path at which it is attached.
    \  name=iota role=path state=iota
    ^  myth
    =  t  (surface_tree/base 'slot role)
    =  u  t.put(surface_tree/name_slot (pails/q name))
    u.put(surface_tree/state_slot (pails/q state))
  +  slot_resolved
    \  name=iota role=path
    ^  myth
    (surface_tree/slot name role 'resolved)
  +  slot_refused
    \  name=iota role=path
    ^  myth
    (surface_tree/slot name role 'refused)
  +  hole
    '  An unresolved live hole: a pending Slot whose report path may
    '  be observed independently of its already-resolved siblings.
    \  name=iota role=path report=path
    ^  myth
    (surface_tree/with_report report
      (surface_tree/slot name role 'pending))
  +  slot_fallback
    '  A Slot terminated by a compatible semantic fallback recipe.
    \  name=iota role=path fallback=path
    ^  myth
    (surface_tree/with_fallback fallback
      (surface_tree/slot name role 'fallback))
  +  text
    '  Terminal semantic text.  It is not HTML and is safe for every
    '  pronunciation to interpret or fall back to.
    \  role=path body=nat
    ^  myth
    (surface_tree/base 'text role).put(surface_tree/text_slot (pails/t body))
  +  glyph
    '  A terminal semantic realization reference.  A Glyph has no
    '  SurfaceTree children; its role is resolved by the backend.
    \  role=path
    ^  myth
    (surface_tree/base 'glyph role)

  +  with_source
    \  source=path t=myth
    ^  myth
    t.put(surface_tree/source_slot (pails/p source))
  +  with_action
    \  action=path t=myth
    ^  myth
    t.put(surface_tree/action_slot (pails/p action))
  +  with_report
    \  report=path t=myth
    ^  myth
    t.put(surface_tree/report_slot (pails/p report))
  +  with_state
    \  state=iota t=myth
    ^  myth
    t.put(surface_tree/state_slot (pails/q state))
  +  with_fallback
    \  fallback=path t=myth
    ^  myth
    t.put(surface_tree/fallback_slot (pails/p fallback))

  +  new
    ^  surface_tree
    (axal/new[myth] .none)
  +  one
    \  t=myth
    ^  surface_tree
    (axal/new[myth] (./some t))
  +  put
    \  at=path t=myth tree=surface_tree
    ^  surface_tree
    (axal/put[myth] at t tree)
  +  record_at
    \  at=path tree=surface_tree
    ^  maybe[myth]
    (axal/get[myth] at tree)

  +  known_kind
    \  kind=iota
    ^  bool
    =  kinds=row[iota]  ['scene 'plate 'block 'slot 'text 'glyph]
    kinds.any((\ q (eq_iota kind q)))
  +  known_state
    \  state=iota
    ^  bool
    =  states=row[iota]  ['resolved 'pending 'fallback 'refused]
    states.any((\ q (eq_iota state q)))
  +  is_kind
    \  want=iota t=myth
    ^  bool
    ?  (surface_tree/kind_of t)
     > .none  .false
     > (./some got=iota)  (eq_iota want got)
  +  renderer_name
    '  Names reserved for terminal pronunciation payloads.  They are
    '  invalid at any depth of a semantic slot path.
    \  q=iota
    ^  bool
    =  names=row[iota]
         ['html 'css 'renderer 'backend 'handle 'dom 'weft 'swiftui 'webgpu]
    names.any((\ name (eq_iota q name)))
  +  renderer_slot
    \  slot=path
    ^  bool
    slot.any((\ q (surface_tree/renderer_name q)))
  +  renderer_pail
    '  Compiled/opaque code is also a backend handle regardless of
    '  the slot chosen to hide it under.
    \  pl=pail
    ^  bool
    ?  pl
     > _=pails/code  .true
    .false
  +  issue
    \  at=path code=iota slot=path
    ^  surface_issue
    (surface_issue at code slot)
  +  node_issues
    '  Validate one valued axal node.  Unknown record slots are
    '  intentionally ignored unless their name or value is explicitly
    '  renderer-local; this is the forward-compatibility law.
    \  at=path sub=surface_tree t=myth
    ^  row[surface_issue]
    =  k  (surface_tree/kind_of t)
       out0=row[surface_issue]
         ?  k
          > .none
            [(surface_tree/issue at 'kind_required surface_tree/kind_slot)]
          > (./some q=iota)
            ?  (surface_tree/known_kind q)
               []
            [(surface_tree/issue at 'kind_invalid surface_tree/kind_slot)]
       out1
         ?  (surface_tree/role_of t)
          > (./some _)  out0
          > .none
            out0.snoc((surface_tree/issue at 'role_required surface_tree/role_slot))
       out2
         ?  (surface_tree/is_kind 'glyph t)
            ?  (eq 0 sub.kid_tap.len)
               out1
            out1.snoc((surface_tree/issue at 'glyph_has_children []))
         out1
       out3
         ?  (surface_tree/is_kind 'text t)
            ?  (surface_tree/text_of t)
             > (./some _)  out2
             > .none
               out2.snoc((surface_tree/issue at 'text_required surface_tree/text_slot))
         out2
       out4
         ?  (surface_tree/is_kind 'slot t)
            ?  (surface_tree/name_of t)
             > .none
               out3.snoc((surface_tree/issue at 'slot_name_required surface_tree/name_slot))
             > (./some name=iota)
               ?  (eq 0 at.len)
                  out3.snoc((surface_tree/issue at 'slot_at_root surface_tree/name_slot))
               ?  (eq_iota name at.at(at.len.dec))
                  out3
               out3.snoc((surface_tree/issue at 'slot_name_mismatch surface_tree/name_slot))
         out3
       out5
         ?  (surface_tree/is_kind 'slot t)
            ?  (surface_tree/state_of t)
             > .none
               out4.snoc((surface_tree/issue at 'slot_state_required surface_tree/state_slot))
             > (./some state=iota)
               ?  (surface_tree/known_state state)
                  out4
               out4.snoc((surface_tree/issue at 'slot_state_invalid surface_tree/state_slot))
         out4
       out6
         ?  (surface_tree/is_kind 'slot t)
            ?  (surface_tree/state_of t)
             > (./some state2=iota)
               ?  (eq_iota state2 'pending)
                  ?  (surface_tree/report_of t)
                   > (./some _)  out5
                   > .none
                     out5.snoc((surface_tree/issue at 'hole_report_required surface_tree/report_slot))
               ?  (eq_iota state2 'fallback)
                  ?  (surface_tree/fallback_of t)
                   > (./some _)  out5
                   > .none
                     out5.snoc((surface_tree/issue at 'fallback_required surface_tree/fallback_slot))
               out5
             > .none  out5
         out5
    t.tap.fold(out6 ;
      \  out e
      =  a
           ?  (surface_tree/renderer_slot e.key)
              out.snoc((surface_tree/issue at 'renderer_slot e.key))
           out
      ?  (surface_tree/renderer_pail e.val)
         a.snoc((surface_tree/issue at 'renderer_payload e.key))
      a)
  +  issues
    '  All validation diagnostics in stable axal/slot order.
    \  tree=surface_tree
    ^  row[surface_issue]
    tree.tap.fold([] ;
      \  out [at t]
      out.weld((surface_tree/node_issues at tree.dip(at) t)))
  +  valid
    '  The complete renderer-neutral compiler-intermediate law.  Passing this
    '  law does not admit or complete an addressed projection revision.
    \  tree=surface_tree
    ^  bool
    (eq 0 (surface_tree/issues tree).len)
