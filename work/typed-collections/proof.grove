' grove-collection/1 {"version": 1, "name": "Typed field proof", "fields": [{"name": "title", "type": "Text", "key": "f0", "choices": []}, {"name": "duration", "type": "Natural", "key": "f1", "choices": []}, {"name": "status", "type": "Choice", "key": "f2", "choices": ["Todo", "Doing", "Done"]}, {"name": "start", "type": "Date", "key": "f3", "choices": []}, {"name": "active", "type": "Boolean", "key": "f4", "choices": []}]}

#import lede=sys/lede
#import text=lib/grove/types/text


date_valid =
  ! foil
  \ value=str
  ^ bool
  ? !(eq value.len 10) .false
  ? !(and (eq value.at(4) 45) (eq value.at(7) 45)) .false
  ?> (./some year) (nat/parse value.slice(0 4)) .false
  ?> (./some month) (nat/parse value.slice(5 2)) .false
  ?> (./some day) (nat/parse value.slice(8 2)) .false
  ? ((eq year 0) || (eq month 0) || (gt month 12) || (eq day 0)) .false
  = leap (and (eq (mod year 4) 0) (or !(eq (mod year 100) 0) (eq (mod year 400) 0)))
    days=row[nat] [31 (? leap 29 28) 31 30 31 30 31 31 30 31 30 31]
  | le day days.at(month.dec)


type_f0 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[type_f0]
    ?> value=pails/t value .none
    | ./some value.t
  + write
    \ value=type_f0
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

input_f0 =
  @type
  ! foil
  maybe[%/type_f0]
  + read
    \ value=pail
    ^ maybe[input_f0]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some .none)
    | ./some (./some value.t)
  + write
    \ value=input_f0
    ^ pail
    | pails/t ""
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f0 =
  @slot

arg_f0 =
  @slot


type_f1 =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[type_f1]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=type_f1
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

input_f1 =
  @type
  ! foil
  maybe[%/type_f1]
  + read
    \ value=pail
    ^ maybe[input_f1]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some .none)
    < parsed (nat/parse value.t)
    | ./some (./some parsed)
  + write
    \ value=input_f1
    ^ pail
    | pails/t ""
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f1 =
  @slot

arg_f1 =
  @slot


type_f2 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[type_f2]
    ?> value=pails/t value .none
    ? !((row[str] ["Todo" "Doing" "Done"]).has(value.t)) .none
    | ./some value.t
  + write
    \ value=type_f2
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

input_f2 =
  @type
  ! foil
  maybe[%/type_f2]
  + read
    \ value=pail
    ^ maybe[input_f2]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some .none)
    ? !((row[str] ["Todo" "Doing" "Done"]).has(value.t)) .none
    | ./some (./some value.t)
  + write
    \ value=input_f2
    ^ pail
    | pails/t ""
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f2 =
  @slot

arg_f2 =
  @slot


type_f3 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[type_f3]
    ?> value=pails/t value .none
    ? !(date_valid value.t) .none
    | ./some value.t
  + write
    \ value=type_f3
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

input_f3 =
  @type
  ! foil
  maybe[%/type_f3]
  + read
    \ value=pail
    ^ maybe[input_f3]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some .none)
    ? !(date_valid value.t) .none
    | ./some (./some value.t)
  + write
    \ value=input_f3
    ^ pail
    | pails/t ""
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f3 =
  @slot

arg_f3 =
  @slot


type_f4 =
  @type
  ! foil
  bool
  + read
    \ value=pail
    ^ maybe[type_f4]
    ?> value=pails/b value .none
    | ./some value.b
  + write
    \ value=type_f4
    ^ pail
    | pails/b value
  + contract
    ^ curb
    | curb/of_type (^ pails/b)

input_f4 =
  @type
  ! foil
  maybe[%/type_f4]
  + read
    \ value=pail
    ^ maybe[input_f4]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some .none)
    ? (eq value.t "true") (./some (./some .true))
    ? (eq value.t "false") (./some (./some .false))
    .none
  + write
    \ value=input_f4
    ^ pail
    | pails/t ""
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f4 =
  @slot

arg_f4 =
  @slot


record =
  @role
  lede: text
  #opt ;
    %/f0: %/type_f0
    %/f1: %/type_f1
    %/f2: %/type_f2
    %/f3: %/type_f3
    %/f4: %/type_f4

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Typed field proof"))


save_f0 =
  @action
  #on ; %/record
  %/arg_f0: %/input_f0
  ! foil
  \ f0=%/input_f0 card=%/record
  ^ %/record
  | card.set_f0(f0)

save_f1 =
  @action
  #on ; %/record
  %/arg_f1: %/input_f1
  ! foil
  \ f1=%/input_f1 card=%/record
  ^ %/record
  | card.set_f1(f1)

save_f2 =
  @action
  #on ; %/record
  %/arg_f2: %/input_f2
  ! foil
  \ f2=%/input_f2 card=%/record
  ^ %/record
  | card.set_f2(f2)

save_f3 =
  @action
  #on ; %/record
  %/arg_f3: %/input_f3
  ! foil
  \ f3=%/input_f3 card=%/record
  ^ %/record
  | card.set_f3(f3)

save_f4 =
  @action
  #on ; %/record
  %/arg_f4: %/input_f4
  ! foil
  \ f4=%/input_f4 card=%/record
  ^ %/record
  | card.set_f4(f4)

save_all =
  @action
  #on ; %/record
  %/arg_f0: %/input_f0
  %/arg_f1: %/input_f1
  %/arg_f2: %/input_f2
  %/arg_f3: %/input_f3
  %/arg_f4: %/input_f4
  ! foil
  \ f0=%/input_f0 f1=%/input_f1 f2=%/input_f2 f3=%/input_f3 f4=%/input_f4 card=%/record
  ^ %/record
  | card.set_f0(f0).set_f1(f1).set_f2(f2).set_f3(f3).set_f4(f4)

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_f0, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f0 = .input(card.f0)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f0)
      action("save_f0")
    }
    group(on = card, action = %/save_f1, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f1 = .input(card.f1)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f1)
      action("save_f1")
    }
    group(on = card, action = %/save_f2, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f2 = .input(card.f2)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f2)
      action("save_f2")
    }
    group(on = card, action = %/save_f3, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f3 = .input(card.f3)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f3)
      action("save_f3")
    }
    group(on = card, action = %/save_f4, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f4 = .input(card.f4)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f4)
      action("save_f4")
    }
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f0 = .input(card.f0)
      '/0x11/gov/medium/typedfieldsproof/arg_f1 = .input(card.f1)
      '/0x11/gov/medium/typedfieldsproof/arg_f2 = .input(card.f2)
      '/0x11/gov/medium/typedfieldsproof/arg_f3 = .input(card.f3)
      '/0x11/gov/medium/typedfieldsproof/arg_f4 = .input(card.f4)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f0)
      input('/0x11/gov/medium/typedfieldsproof/arg_f1)
      input('/0x11/gov/medium/typedfieldsproof/arg_f2)
      input('/0x11/gov/medium/typedfieldsproof/arg_f3)
      input('/0x11/gov/medium/typedfieldsproof/arg_f4)
      action("save_all")
    }
  }
