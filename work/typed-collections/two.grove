' grove-collection/1 {"version": 1, "name": "Two fields", "fields": [{"name": "title", "type": "Text", "key": "f0", "choices": []}, {"name": "duration", "type": "Natural", "key": "f1", "choices": []}]}

#import lede=sys/lede
#import text=lib/grove/types/text


#import natural=gov/user/field_codecs_v1/natural

f0 =
  @slot

arg_f0 =
  @slot

f1 =
  @slot

arg_f1 =
  @slot

record =
  @role
  lede: text
  #opt ;
    %/f0: text
    %/f1: natural/type_value

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Two fields"))


save_all =
  @action
  #on ; %/record
  %/arg_f0: text
  %/arg_f1: natural/input_value
  ! foil
  \ f0=text f1=natural/input_value card=%/record
  ^ %/record
  | card.set_f0((? (eq f0 "") .none (./some f0))).set_f1((nat/parse f1))

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/twofieldsproof/arg_f0 = .input(card.f0)
      '/0x11/gov/medium/twofieldsproof/arg_f1 = .input(card.f1)
    }) {
      input('/0x11/gov/medium/twofieldsproof/arg_f0)
      input('/0x11/gov/medium/twofieldsproof/arg_f1)
      action("save_all")
    }
  }
