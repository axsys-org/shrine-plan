' grove-collection/1 {"version": 1, "name": "Rich values", "fields": [{"name": "title", "type": "Text", "key": "f0", "choices": [], "target": ""}, {"name": "price", "type": "Number", "key": "f1", "choices": [], "target": ""}, {"name": "samples", "type": "Sequence", "key": "f2", "choices": [], "target": ""}, {"name": "tags", "type": "List", "key": "f3", "choices": [], "target": ""}, {"name": "parent", "type": "Reference", "key": "f4", "choices": [], "target": ""}]}

#import lede=sys/lede
#import text=lib/grove/types/text


#import values=gov/user/collection_values_v1

#import reference=lib/grove/types/path

f0 =
  @slot

arg_f0 =
  @slot

f1 =
  @slot

arg_f1 =
  @slot

f2 =
  @slot

arg_f2 =
  @slot

f3 =
  @slot

arg_f3 =
  @slot

f4 =
  @slot

arg_f4 =
  @slot

record =
  @role
  #opt ;
    %/f0: text
    %/f1: values/number
    %/f2: values/sequence
    %/f3: values/list
    %/f4: reference

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Rich values"))


save_all =
  @slot
  #meta ;
    "/sys/grove/action_handler": (grove_action_handler save_all/apply)
  ! foil
  + apply
    \ arguments=myth current=myth
    ^ maybe[myth]
    < f0 arguments.get((path_parse "/0x11/gov/medium/richproof/arg_f0").fall([]))
    < f0 (text/read f0)
    < current (save_all/put_f0 current f0)
    < f1 arguments.get((path_parse "/0x11/gov/medium/richproof/arg_f1").fall([]))
    < f1 (text/read f1)
    < current (save_all/put_f1 current f1)
    < f2 arguments.get((path_parse "/0x11/gov/medium/richproof/arg_f2").fall([]))
    < f2 (text/read f2)
    < current (save_all/put_f2 current f2)
    < f3 arguments.get((path_parse "/0x11/gov/medium/richproof/arg_f3").fall([]))
    < f3 (text/read f3)
    < current (save_all/put_f3 current f3)
    < f4 arguments.get((path_parse "/0x11/gov/medium/richproof/arg_f4").fall([]))
    < f4 (text/read f4)
    < current (save_all/put_f4 current f4)
    | ./some current
  + put_f0
    \ current=myth f0=str
    ^ maybe[myth]
    ? (eq f0 "") (./some current.del((path_parse "/0x11/gov/medium/richproof/f0").fall([])).del((path_parse "/0x11/gov/medium/richproof/display_f0").fall([])))
    | ./some current.put((path_parse "/0x11/gov/medium/richproof/f0").fall([]) (pails/t f0))
  + put_f1
    \ current=myth f1=str
    ^ maybe[myth]
    ? (eq f1 "") (./some current.del((path_parse "/0x11/gov/medium/richproof/f1").fall([])).del((path_parse "/0x11/gov/medium/richproof/display_f1").fall([])))
    < value (values/number/parse f1)
    | ./some current.put((path_parse "/0x11/gov/medium/richproof/f1").fall([]) (values/number/write value)).put((path_parse "/0x11/gov/medium/richproof/display_f1").fall([]) (pails/t (values/number/format value)))
  + put_f2
    \ current=myth f2=str
    ^ maybe[myth]
    ? (eq f2 "") (./some current.del((path_parse "/0x11/gov/medium/richproof/f2").fall([])).del((path_parse "/0x11/gov/medium/richproof/display_f2").fall([])))
    < value (values/sequence/parse f2)
    | ./some current.put((path_parse "/0x11/gov/medium/richproof/f2").fall([]) (values/sequence/write value)).put((path_parse "/0x11/gov/medium/richproof/display_f2").fall([]) (pails/t (values/sequence/format value)))
  + put_f3
    \ current=myth f3=str
    ^ maybe[myth]
    ? (eq f3 "") (./some current.del((path_parse "/0x11/gov/medium/richproof/f3").fall([])).del((path_parse "/0x11/gov/medium/richproof/display_f3").fall([])))
    < value (values/list/parse f3)
    | ./some current.put((path_parse "/0x11/gov/medium/richproof/f3").fall([]) (values/list/write value)).put((path_parse "/0x11/gov/medium/richproof/display_f3").fall([]) (pails/t (values/list/format value)))
  + put_f4
    \ current=myth f4=str
    ^ maybe[myth]
    ? (eq f4 "") (./some current.del((path_parse "/0x11/gov/medium/richproof/f4").fall([])).del((path_parse "/0x11/gov/medium/richproof/display_f4").fall([])))
    < value (path_parse f4)
    ? (eq value.len 0) .none
    | ./some current.put((path_parse "/0x11/gov/medium/richproof/f4").fall([]) (pails/p value))

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/richproof/arg_f0 = .input(card.f0)
      '/0x11/gov/medium/richproof/arg_f1 = .input(card.f1)
      '/0x11/gov/medium/richproof/arg_f2 = .input(card.f2)
      '/0x11/gov/medium/richproof/arg_f3 = .input(card.f3)
      '/0x11/gov/medium/richproof/arg_f4 = .input(card.f4)
    }) {
      input('/0x11/gov/medium/richproof/arg_f0)
      input('/0x11/gov/medium/richproof/arg_f1)
      input('/0x11/gov/medium/richproof/arg_f2)
      input('/0x11/gov/medium/richproof/arg_f3)
      input('/0x11/gov/medium/richproof/arg_f4)
      action("save_all")
    }
  }
