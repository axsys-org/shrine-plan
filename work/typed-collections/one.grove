' grove-collection/1 {"version": 1, "name": "Typed field proof", "fields": [{"name": "duration", "type": "Natural", "key": "f0", "choices": []}]}

#import lede=sys/lede
#import text=lib/grove/types/text


type_f0 =
  @type
  ! foil
  nat
  + read
    \ value=pail
    ^ maybe[type_f0]
    ?> value=pails/n value .none
    | ./some value.n
  + write
    \ value=type_f0
    ^ pail
    | pails/n value
  + contract
    ^ curb
    | curb/of_type (^ pails/n)

input_f0 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[input_f0]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some value.t)
    ?> (./some parsed) (nat/parse value.t) .none
    | ./some value.t
  + write
    \ value=input_f0
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f0 =
  @slot

arg_f0 =
  @slot


record =
  @role
  lede: text
  #opt ;
    %/f0: %/type_f0

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Typed field proof"))


save_f0 =
  @action
  #on ; %/record
  %/arg_f0: %/input_f0
  ! foil
  \ f0=%/input_f0 card=%/record
  ^ %/record
  | card.set_f0((nat/parse f0))

save_all =
  @action
  #on ; %/record
  %/arg_f0: %/input_f0
  ! foil
  \ f0=%/input_f0 card=%/record
  ^ %/record
  | card.set_f0((nat/parse f0))

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_f0, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f0 = .input(card.f0)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f0)
      action("save_f0")
    }
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/typedfieldsproof/arg_f0 = .input(card.f0)
    }) {
      input('/0x11/gov/medium/typedfieldsproof/arg_f0)
      action("save_all")
    }
  }
