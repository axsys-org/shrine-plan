\ninput_f0 =\n  @type\n  ! foil\n  str\n  + read\n    \\ value=pail\n    ^ maybe[input_f0]\n    ?> value=pails/t value .none\n    ? (eq value.t \"\") (./some value.t)\n    ?> (./some parsed) (nat/parse value.t) .none\n    | ./some value.t\n  + write\n    \\ value=input_f0\n    ^ pail\n    | pails/t value\n  + contract\n    ^ curb\n    | curb/of_type (^ pails/t)\n\nf0 =\n  @slot\n\narg_f0 =\n  @slot\n\n\nrecord =\n  @role\n  lede: text\n  #opt ;\n    %/f0: %/type_f0\n\naccepts =\n  ! foil\n  | grove_binding_contract\n  \\ inputs=row[myth]\n  ^ either[str unit]\n  ? !(eq inputs.len 0) (./err \"This collection owns its fields.\")\n  | ./ok []\n\nrealize =\n  ! foil\n  | grove_realization\n  \\ inputs=row[myth] current=myth\n  ^ myth\n  | current.put(['sys 'lede] (pails/t \"Typed field proof\"))\n\n\nsave_all =\n  @action\n  #on ; %/record\n  %/arg_f0: %/input_f0\n  ! foil\n  \\ f0=%/input_f0 card=%/record\n  ^ %/record\n  | card.set_f0((nat/parse f0))\n\nsurface =\n  @view\n  #on ; %/record\n  #for ; /sys/slot/detail\n  card => {\n    group(on = card, action = %/save_all, myth = {\n      '/0x11/gov/medium/typedfieldsproof/arg_f0 = .input(card.f0)\n    }) {\n      input('/0x11/gov/medium/typedfieldsproof/arg_f0)\n      action(\"save_all\")\n    }\n  }\n", "pattern": "/0x11/gov/medium/typedfieldsproof", "code_root": "/0x11/gov/medium/typedfieldsproof", "typing": {"basis": {"address": "/0x11/app/medium/typedfieldsproof", "case": "4"}, "definition": {"address": "/0x11/gov/medium/typedfieldsproof", "case": "1"}, "role": {"reference": {"address": "/0x11/gov/medium/typedfieldsproof/record", "case": "1"}, "fields": [{"name": "lede", "slot": "/sys/lede", "type": {"address": "/0x11/lib/grove/types/text", "case": "1"}, "optional": false}, {"name": "f0", "slot": "/0x11/gov/medium/typedfieldsproof/f0", "type": {"address": "/0x11/gov/medium/typedfieldsproof/type_f0", "case": "1"}, "optional": true}], "values": [{"declaration": {"name": "lede", "slot": "/sys/lede", "type": {"address"