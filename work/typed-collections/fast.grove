' grove-collection/1 {"version": 1, "name": "Two fields", "fields": [{"name": "title", "type": "Text", "key": "f0", "choices": []}, {"name": "duration", "type": "Natural", "key": "f1", "choices": []}]}

#import lede=sys/lede
#import text=lib/grove/types/text


#import natural=gov/user/field_codecs_v1/natural

f0 =
  @slot

arg_f0 =
  @slot

f1 =
  @slot

arg_f1 =
  @slot

record =
  @role
  #opt ;
    %/f0: text
    %/f1: natural/type_value

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Two fields"))


save_all =
  @slot
  #meta ;
    "/sys/grove/action_handler": (grove_action_handler save_all/apply)
  ! foil
  + apply
    \ arguments=myth current=myth
    ^ maybe[myth]
    < f0 arguments.get([($x 17) 'gov 'medium 'fastproof 'arg_f0])
    < f0 (text/read f0)
    < f1 arguments.get([($x 17) 'gov 'medium 'fastproof 'arg_f1])
    < f1 (natural/input_value/read f1)
    = current (? (eq f0 "") current.del([($x 17) 'gov 'medium 'fastproof 'f0]) current.put([($x 17) 'gov 'medium 'fastproof 'f0] (pails/t f0)))
    = current
        ? (eq f1 "") current.del([($x 17) 'gov 'medium 'fastproof 'f1])
        | current.put([($x 17) 'gov 'medium 'fastproof 'f1] (pails/n (nat/parse f1).fall(0)))
    | ./some current

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/fastproof/arg_f0 = .input(card.f0)
      '/0x11/gov/medium/fastproof/arg_f1 = .input(card.f1)
    }) {
      input('/0x11/gov/medium/fastproof/arg_f0)
      input('/0x11/gov/medium/fastproof/arg_f1)
      action("save_all")
    }
  }
