' grove-collection/1 {"version": 1, "name": "Task fields", "fields": [{"name": "title", "type": "Text", "key": "f0", "choices": []}, {"name": "duration", "type": "Natural", "key": "f1", "choices": []}, {"name": "status", "type": "Choice", "key": "f2", "choices": ["Todo", "Doing", "Done"]}]}

#import lede=sys/lede
#import text=lib/grove/types/text


#import type_f0=lib/grove/types/text

#import input_f0=lib/grove/types/text

f0 =
  @slot

arg_f0 =
  @slot

#import type_f1=gov/user/field_codecs_v1/natural/type_value

#import input_f1=gov/user/field_codecs_v1/natural/input_value

f1 =
  @slot

arg_f1 =
  @slot

type_f2 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[type_f2]
    ?> value=pails/t value .none
    ? !((row[str] ["Todo" "Doing" "Done"]).has(value.t)) .none
    | ./some value.t
  + write
    \ value=type_f2
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

input_f2 =
  @type
  ! foil
  str
  + read
    \ value=pail
    ^ maybe[input_f2]
    ?> value=pails/t value .none
    ? (eq value.t "") (./some value.t)
    ? !((row[str] ["Todo" "Doing" "Done"]).has(value.t)) .none
    | ./some value.t
  + write
    \ value=input_f2
    ^ pail
    | pails/t value
  + contract
    ^ curb
    | curb/of_type (^ pails/t)

f2 =
  @slot

arg_f2 =
  @slot


record =
  @role
  lede: text
  #opt ;
    %/f0: type_f0
    %/f1: type_f1
    %/f2: type_f2

accepts =
  ! foil
  | grove_binding_contract
  \ inputs=row[myth]
  ^ either[str unit]
  ? !(eq inputs.len 0) (./err "This collection owns its fields.")
  | ./ok []

realize =
  ! foil
  | grove_realization
  \ inputs=row[myth] current=myth
  ^ myth
  | current.put(['sys 'lede] (pails/t "Task fields"))


save_all =
  @action
  #on ; %/record
  %/arg_f0: input_f0
  %/arg_f1: input_f1
  %/arg_f2: input_f2
  ! foil
  \ f0=input_f0 f1=input_f1 f2=input_f2 card=%/record
  ^ %/record
  | card.set_f0((? (eq f0 "") .none (./some f0))).set_f1((nat/parse f1)).set_f2((? (eq f2 "") .none (./some f2)))

surface =
  @view
  #on ; %/record
  #for ; /sys/slot/detail
  card => {
    group(on = card, action = %/save_all, myth = {
      '/0x11/gov/medium/taskfieldsproof/arg_f0 = .input(card.f0)
      '/0x11/gov/medium/taskfieldsproof/arg_f1 = .input(card.f1)
      '/0x11/gov/medium/taskfieldsproof/arg_f2 = .input(card.f2)
    }) {
      input('/0x11/gov/medium/taskfieldsproof/arg_f0)
      input('/0x11/gov/medium/taskfieldsproof/arg_f1)
      input('/0x11/gov/medium/taskfieldsproof/arg_f2)
      action("save_all")
    }
  }
